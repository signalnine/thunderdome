@@ -0,0 +1,58 @@
+/**
+ * Minimal JSON value helpers. Documents are plain JSON, so clone/compare only
+ * ever have to deal with null, boolean, number, string, array and object.
+ */
+
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | JsonObject;
+
+export interface JsonObject {
+  [key: string]: JsonValue;
+}
+
+/** True for `{}`-style values: not null, not an array. */
+export function isPlainObject(value: unknown): value is JsonObject {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+export function deepClone<T extends JsonValue | undefined>(value: T): T {
+  if (value === null || typeof value !== 'object') return value;
+  if (Array.isArray(value)) {
+    return value.map((item) => deepClone(item)) as T;
+  }
+  const out: JsonObject = {};
+  for (const key of Object.keys(value)) {
+    out[key] = deepClone((value as JsonObject)[key]);
+  }
+  return out as T;
+}
+
+export function deepEqual(
+  a: JsonValue | undefined,
+  b: JsonValue | undefined,
+): boolean {
+  if (a === b) return true;
+  if (a === null || b === null) return false;
+  if (a === undefined || b === undefined) return false;
+  if (typeof a !== 'object' || typeof b !== 'object') return false;
+
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b)) return false;
+    if (a.length !== b.length) return false;
+    return a.every((item, i) => deepEqual(item, b[i]));
+  }
+
+  const aKeys = Object.keys(a);
+  const bKeys = Object.keys(b);
+  if (aKeys.length !== bKeys.length) return false;
+  return aKeys.every(
+    (key) =>
+      Object.prototype.hasOwnProperty.call(b, key) &&
+      deepEqual((a as JsonObject)[key], (b as JsonObject)[key]),
+  );
+}
diff --git a/src/merge.ts b/src/merge.ts
