index 0000000..a5647a4
--- /dev/null
+++ b/src/merge.ts
@@ -0,0 +1,122 @@
+import {
+  deepClone,
+  deepEqual,
+  isPlainObject,
+  type JsonObject,
+  type JsonValue,
+} from './json.js';
+
+export interface Conflict {
+  documentId: string;
+  /** Dot-separated path to the conflicting field, `""` for the whole document. */
+  path: string;
+  base: unknown;
+  ours: unknown;
+  theirs: unknown;
+}
+
+/**
+ * `undefined` means "absent": the key/document does not exist on that side,
+ * either because it was never created or because it was deleted. JSON has no
+ * `undefined`, so it is unambiguous as a sentinel.
+ */
+type Maybe<T> = T | undefined;
+
+function joinPath(path: string, key: string): string {
+  return path === '' ? key : `${path}.${key}`;
+}
+
+/**
+ * Three-way merge of a single value. Returns the merged value, or `undefined`
+ * if the value should be absent from the result. Conflicts are appended to
+ * `conflicts` and resolved in favour of "ours".
+ */
+function mergeValue(
+  base: Maybe<JsonValue>,
+  ours: Maybe<JsonValue>,
+  theirs: Maybe<JsonValue>,
+  path: string,
+  documentId: string,
+  conflicts: Conflict[],
+): Maybe<JsonValue> {
+  // Both sides agree (including both having deleted the value).
+  if (deepEqual(ours, theirs)) return deepClone(ours);
+  // Only one side moved away from the base: take that side.
+  if (deepEqual(base, ours)) return deepClone(theirs);
+  if (deepEqual(base, theirs)) return deepClone(ours);
+
+  // Both sides changed the value in different ways. If both are still objects
+  // we can recurse and merge field by field; otherwise the value is atomic
+  // (scalar, array, or a type change) and this is a genuine conflict.
+  if (isPlainObject(ours) && isPlainObject(theirs)) {
+    const baseObject = isPlainObject(base) ? base : undefined;
+    const merged: JsonObject = {};
+    for (const key of unionKeys(baseObject, ours, theirs)) {
+      const value = mergeValue(
+        baseObject?.[key],
+        ours[key],
+        theirs[key],
+        joinPath(path, key),
+        documentId,
+        conflicts,
+      );
+      if (value !== undefined) merged[key] = value;
+    }
+    return merged;
+  }
+
+  conflicts.push({
+    documentId,
+    path,
+    base: deepClone(base),
+    ours: deepClone(ours),
+    theirs: deepClone(theirs),
+  });
+  return deepClone(ours);
+}
+
+function unionKeys(...objects: Maybe<JsonObject>[]): string[] {
+  const keys: string[] = [];
+  const seen = new Set<string>();
+  for (const object of objects) {
+    if (!object) continue;
+    for (const key of Object.keys(object)) {
+      if (seen.has(key)) continue;
+      seen.add(key);
+      keys.push(key);
+    }
+  }
+  return keys;
+}
+
+/**
+ * Three-way merge of one document. Any of the three sides may be `undefined`
+ * (absent/deleted); `undefined` is returned when the document is absent from
+ * the merge result.
+ */
+export function mergeDocument(
+  documentId: string,
+  base: Maybe<JsonObject>,
+  ours: Maybe<JsonObject>,
+  theirs: Maybe<JsonObject>,
+  conflicts: Conflict[],
+): Maybe<JsonObject> {
+  if (deepEqual(ours, theirs)) return deepClone(ours);
+  if (deepEqual(base, ours)) return deepClone(theirs);
+  if (deepEqual(base, theirs)) return deepClone(ours);
+
+  // One side deleted the document while the other edited it. There is no
+  // sensible field-level answer, so report it against the whole document.
+  if (ours === undefined || theirs === undefined) {
+    conflicts.push({
+      documentId,
+      path: '',
+      base: deepClone(base),
+      ours: deepClone(ours),
+      theirs: deepClone(theirs),
+    });
+    return deepClone(ours);
+  }
+
+  return mergeValue(base, ours, theirs, '', documentId, conflicts) as JsonObject;
+}
