+import { describe, expect, it } from 'vitest';
+import { DocumentStore } from '../src/index.js';
+
+describe('documents', () => {
+  it('creates, reads and updates', () => {
+    const store = new DocumentStore();
+    store.create('doc', { title: 'hello' });
+    expect(store.get('doc')).toEqual({ title: 'hello' });
+
+    store.update('doc', { title: 'bye' });
+    expect(store.get('doc')).toEqual({ title: 'bye' });
+  });
+
+  it('throws on duplicate create, missing get/update/delete', () => {
+    const store = new DocumentStore();
+    store.create('doc', {});
+    expect(() => store.create('doc', {})).toThrow();
+    expect(() => store.get('nope')).toThrow();
+    expect(() => store.update('nope', {})).toThrow();
+    expect(() => store.delete('nope')).toThrow();
+  });
+
+  it('throws on get after delete, and allows re-create', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
+    store.delete('doc');
+    expect(() => store.get('doc')).toThrow();
+    store.create('doc', { a: 2 });
+    expect(store.get('doc')).toEqual({ a: 2 });
+  });
+
+  it('deep clones on write and on read', () => {
+    const store = new DocumentStore();
+    const input = { nested: { list: [1, 2] } };
+    store.create('doc', input);
+
+    input.nested.list.push(3);
+    expect(store.get('doc')).toEqual({ nested: { list: [1, 2] } });
+
+    const read = store.get('doc') as { nested: { list: number[] } };
+    read.nested.list.push(4);
+    expect(store.get('doc')).toEqual({ nested: { list: [1, 2] } });
+  });
+});
+
+describe('version history', () => {
+  it('records a version per create and update, oldest first', () => {
+    const store = new DocumentStore();
+    store.create('doc', { n: 1 });
+    store.update('doc', { n: 2 });
+    store.update('doc', { n: 3 });
+
+    const history = store.getHistory('doc');
+    expect(history.map((v) => v.content)).toEqual([{ n: 1 }, { n: 2 }, { n: 3 }]);
+    expect(new Set(history.map((v) => v.id)).size).toBe(3);
+    for (const version of history) {
+      expect(typeof version.timestamp).toBe('number');
+    }
+  });
+
+  it('version ids are unique across documents', () => {
+    const store = new DocumentStore();
+    store.create('a', {});
+    store.create('b', {});
+    const ids = [...store.getHistory('a'), ...store.getHistory('b')].map((v) => v.id);
+    expect(new Set(ids).size).toBe(2);
+  });
+
+  it('reads content at a specific version', () => {
+    const store = new DocumentStore();
+    store.create('doc', { n: 1 });
+    store.update('doc', { n: 2 });
+    const [first] = store.getHistory('doc');
+    expect(store.getVersion('doc', first.id)).toEqual({ n: 1 });
+    expect(() => store.getVersion('doc', 'bogus')).toThrow();
+  });
+
+  it('history snapshots are immutable', () => {
+    const store = new DocumentStore();
+    store.create('doc', { n: 1 });
+    const history = store.getHistory('doc');
+    (history[0].content as { n: number }).n = 99;
+    expect(store.getHistory('doc')[0].content).toEqual({ n: 1 });
+  });
+});
+
+describe('branching', () => {
+  it('defaults to main and lists branches', () => {
+    const store = new DocumentStore();
+    expect(store.getBranch()).toBe('main');
+    store.createBranch('feature');
+    expect(store.listBranches()).toEqual(['main', 'feature']);
+  });
+
+  it('isolates changes between branches', () => {
+    const store = new DocumentStore();
+    store.create('doc', { n: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc', { n: 2 });
+    expect(store.get('doc')).toEqual({ n: 2 });
+
+    store.switchBranch('main');
+    expect(store.get('doc')).toEqual({ n: 1 });
+  });
+
+  it('branches from an explicit source branch', () => {
+    const store = new DocumentStore();
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.create('only-on-feature', { a: 1 });
+
+    store.switchBranch('main');
+    store.createBranch('copy', 'feature');
+    store.switchBranch('copy');
+    expect(store.get('only-on-feature')).toEqual({ a: 1 });
+  });
+
+  it('rejects unknown or duplicate branches', () => {
+    const store = new DocumentStore();
+    expect(() => store.createBranch('main')).toThrow();
+    expect(() => store.switchBranch('nope')).toThrow();
+    expect(() => store.createBranch('x', 'nope')).toThrow();
+    expect(() => store.merge('nope')).toThrow();
+  });
+});
+
+describe('merging', () => {
+  const diverged = () => {
+    const store = new DocumentStore();
