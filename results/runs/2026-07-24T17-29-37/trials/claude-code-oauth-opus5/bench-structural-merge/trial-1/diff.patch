+import {
+  deepClone,
+  deepEqual,
+  isPlainObject,
+  type JsonObject,
+} from './json.js';
+import { mergeDocument, type Conflict } from './merge.js';
+
+export type { JsonObject, JsonValue } from './json.js';
+export type { Conflict } from './merge.js';
+
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: JsonObject;
+}
+
+export interface MergeResult {
+  /** documentId -> content of that document after the merge. */
+  merged: Record<string, JsonObject>;
+  conflicts: Conflict[];
+  /** True when the merge was auto-applied to the current branch. */
+  applied: boolean;
+}
+
+export class DocumentStoreError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'DocumentStoreError';
+  }
+}
+
+/**
+ * Immutable snapshot of a document at one commit. Entries are shared between
+ * commits and never mutated in place, so snapshotting a commit is just a copy
+ * of the id -> entry map.
+ */
+interface DocEntry {
+  readonly content: JsonObject;
+  readonly history: readonly Version[];
+  /** Tombstone: the document was deleted but its history is retained. */
+  readonly deleted: boolean;
+}
+
+interface Commit {
+  readonly id: string;
+  readonly parents: readonly string[];
+  readonly docs: ReadonlyMap<string, DocEntry>;
+}
+
+const DEFAULT_BRANCH = 'main';
+
+export class DocumentStore {
+  private readonly commits = new Map<string, Commit>();
+  private readonly branches = new Map<string, string>();
+  /** Creation order of every version, used to order merged histories. */
+  private readonly versionSequence = new Map<string, number>();
+  private currentBranch = DEFAULT_BRANCH;
+  private nextCommitId = 0;
+  private nextVersionId = 0;
+  private lastTimestamp = 0;
+
+  constructor() {
+    const root = this.addCommit([], new Map());
+    this.branches.set(DEFAULT_BRANCH, root.id);
+  }
+
+  // ---------------------------------------------------------------- documents
+
+  create(id: string, content: object): void {
+    const docs = this.headDocs();
+    const existing = docs.get(id);
+    if (existing && !existing.deleted) {
+      throw new DocumentStoreError(
+        `Document "${id}" already exists on branch "${this.currentBranch}"`,
+      );
+    }
+    const stored = this.validateContent(content, 'create');
+    // Re-creating a deleted document continues its history rather than
+    // silently discarding the versions that came before the delete.
+    this.commitVersion(id, existing, stored);
+  }
+
+  get(id: string): JsonObject {
+    return deepClone(this.requireLiveEntry(id).content);
+  }
+
+  update(id: string, content: object): void {
+    const entry = this.requireLiveEntry(id);
+    const stored = this.validateContent(content, 'update');
+    this.commitVersion(id, entry, stored);
+  }
+
+  delete(id: string): void {
+    const entry = this.requireLiveEntry(id);
+    this.commitDocs(new Map([[id, { ...entry, deleted: true }]]));
+  }
+
+  // ------------------------------------------------------------------ history
+
+  getHistory(id: string): Version[] {
+    const entry = this.headDocs().get(id);
+    if (!entry) {
+      throw new DocumentStoreError(
+        `Document "${id}" does not exist on branch "${this.currentBranch}"`,
+      );
+    }
+    return entry.history.map((version) => this.cloneVersion(version));
+  }
+
+  getVersion(id: string, versionId: string): JsonObject {
+    const entry = this.headDocs().get(id);
+    if (!entry) {
+      throw new DocumentStoreError(
+        `Document "${id}" does not exist on branch "${this.currentBranch}"`,
+      );
+    }
+    const version = entry.history.find((candidate) => candidate.id === versionId);
+    if (!version) {
+      throw new DocumentStoreError(
+        `Version "${versionId}" does not exist for document "${id}"`,
+      );
+    }
+    return deepClone(version.content);
+  }
+
+  // ----------------------------------------------------------------- branches
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new DocumentStoreError(`Branch "${name}" already exists`);
+    }
+    const source = fromBranch ?? this.currentBranch;
+    this.branches.set(name, this.requireBranchHead(source));
+  }
+
+  switchBranch(name: string): void {
+    this.requireBranchHead(name);
+    this.currentBranch = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  // ------------------------------------------------------------------- merges
+
+  merge(sourceBranch: string): MergeResult {
+    const theirHead = this.requireBranchHead(sourceBranch);
+    const ourHead = this.requireBranchHead(this.currentBranch);
+    const ourDocs = this.commit(ourHead).docs;
+    const base = this.mergeBase(ourHead, theirHead);
+
+    // Already up to date: the source branch holds nothing we do not have.
+    if (base === theirHead) {
+      return { merged: liveContents(ourDocs), conflicts: [], applied: true };
+    }
+
+    const theirDocs = this.commit(theirHead).docs;
+    const baseDocs = this.commit(base).docs;
+
+    const conflicts: Conflict[] = [];
+    const merged: Record<string, JsonObject> = {};
+    const mergedDocs = new Map<string, DocEntry>();
+
+    for (const id of unionIds(baseDocs, ourDocs, theirDocs)) {
+      const ourEntry = ourDocs.get(id);
+      const theirEntry = theirDocs.get(id);
+      const content = mergeDocument(
+        id,
+        liveContent(baseDocs.get(id)),
+        liveContent(ourEntry),
+        liveContent(theirEntry),
+        conflicts,
+      );
+
+      if (content !== undefined) {
+        merged[id] = deepClone(content);
+      }
+      mergedDocs.set(id, this.mergedEntry(ourEntry, theirEntry, content));
+    }
+
+    if (conflicts.length > 0) {
+      return { merged, conflicts, applied: false };
+    }
+
+    this.branches.set(
+      this.currentBranch,
+      this.addCommit([ourHead, theirHead], mergedDocs).id,
+    );
+    return { merged, conflicts, applied: true };
+  }
+
+  // ------------------------------------------------------------------ helpers
+
+  /** Builds the post-merge entry for one document, versioning real changes. */
+  private mergedEntry(
+    ourEntry: DocEntry | undefined,
+    theirEntry: DocEntry | undefined,
+    content: JsonObject | undefined,
+  ): DocEntry {
+    const history = this.mergeHistories(ourEntry?.history, theirEntry?.history);
+
+    if (content === undefined) {
+      const last = history[history.length - 1];
+      return {
+        content: ourEntry?.content ?? theirEntry?.content ?? last?.content ?? {},
+        history,
+        deleted: true,
+      };
+    }
+    // The merge result is only a new version if neither side already recorded
+    // it: a fast-forward inherits the incoming version instead of copying it.
+    const latest = history[history.length - 1];
+    if (latest && deepEqual(latest.content, content)) {
+      return { content, history, deleted: false };
+    }
+    return {
+      content,
+      history: [...history, this.newVersion(content)],
+      deleted: false,
+    };
+  }
+
+  /** Union of two histories, ordered by the version creation sequence. */
+  private mergeHistories(
+    ours: readonly Version[] = [],
+    theirs: readonly Version[] = [],
+  ): Version[] {
+    const byId = new Map<string, Version>();
+    for (const version of [...ours, ...theirs]) {
+      if (!byId.has(version.id)) byId.set(version.id, version);
+    }
+    return [...byId.values()].sort(
+      (a, b) =>
+        (this.versionSequence.get(a.id) ?? 0) -
+        (this.versionSequence.get(b.id) ?? 0),
+    );
+  }
+
+  /**
+   * Lowest common ancestor of two commits: the common ancestor that is not
+   * itself an ancestor of any other common ancestor.
+   */
+  private mergeBase(a: string, b: string): string {
+    const ancestorsOfA = this.ancestors(a);
+    const candidates = [...this.ancestors(b)].filter((id) =>
+      ancestorsOfA.has(id),
+    );
+    const shadowed = new Set<string>();
+    for (const candidate of candidates) {
+      for (const other of this.ancestors(candidate)) {
+        if (other !== candidate) shadowed.add(other);
+      }
+    }
+    const best = candidates.filter((id) => !shadowed.has(id));
+    // Commit ids increase monotonically, so the newest survivor is the closest
+    // ancestor when a criss-cross history leaves more than one.
+    return best.sort((x, y) => commitOrder(y) - commitOrder(x))[0];
+  }
+
+  private ancestors(id: string): Set<string> {
+    const seen = new Set<string>();
+    const stack = [id];
+    while (stack.length > 0) {
+      const current = stack.pop() as string;
+      if (seen.has(current)) continue;
+      seen.add(current);
+      stack.push(...this.commit(current).parents);
+    }
+    return seen;
+  }
+
+  private addCommit(
+    parents: readonly string[],
+    docs: ReadonlyMap<string, DocEntry>,
+  ): Commit {
+    const commit: Commit = { id: `c${this.nextCommitId++}`, parents, docs };
+    this.commits.set(commit.id, commit);
+    return commit;
+  }
+
+  /** Commits `changes` on top of the current branch head. */
+  private commitDocs(changes: ReadonlyMap<string, DocEntry>): void {
+    const head = this.requireBranchHead(this.currentBranch);
+    const docs = new Map(this.commit(head).docs);
+    for (const [id, entry] of changes) docs.set(id, entry);
+    this.branches.set(this.currentBranch, this.addCommit([head], docs).id);
+  }
+
+  /** Commits `content` as a new version of `id` on the current branch. */
+  private commitVersion(
+    id: string,
+    entry: DocEntry | undefined,
+    content: JsonObject,
+  ): void {
+    const history = [...(entry?.history ?? []), this.newVersion(content)];
+    this.commitDocs(new Map([[id, { content, history, deleted: false }]]));
+  }
+
+  private newVersion(content: JsonObject): Version {
+    // Clocks can step backwards; keep timestamps non-decreasing so that
+    // chronological order and array order never disagree.
+    this.lastTimestamp = Math.max(Date.now(), this.lastTimestamp);
+    const version: Version = {
+      id: `v${this.nextVersionId++}`,
+      timestamp: this.lastTimestamp,
+      content,
+    };
+    this.versionSequence.set(version.id, this.versionSequence.size);
+    return version;
+  }
+
+  private cloneVersion(version: Version): Version {
+    return {
+      id: version.id,
+      timestamp: version.timestamp,
+      content: deepClone(version.content),
+    };
+  }
+
+  private headDocs(): ReadonlyMap<string, DocEntry> {
+    return this.commit(this.requireBranchHead(this.currentBranch)).docs;
+  }
+
+  private commit(id: string): Commit {
+    const commit = this.commits.get(id);
+    if (!commit) throw new DocumentStoreError(`Unknown commit "${id}"`);
+    return commit;
+  }
+
+  private requireBranchHead(name: string): string {
+    const head = this.branches.get(name);
+    if (head === undefined) {
+      throw new DocumentStoreError(`Branch "${name}" does not exist`);
+    }
+    return head;
+  }
+
+  private requireLiveEntry(id: string): DocEntry {
+    const entry = this.headDocs().get(id);
+    if (!entry || entry.deleted) {
+      throw new DocumentStoreError(
+        `Document "${id}" does not exist on branch "${this.currentBranch}"`,
+      );
+    }
+    return entry;
+  }
+
+  private validateContent(content: object, operation: string): JsonObject {
+    if (!isPlainObject(content)) {
+      throw new DocumentStoreError(
+        `Cannot ${operation} a document from a non-object value`,
+      );
+    }
+    return deepClone(content);
+  }
+}
+
+function liveContent(entry: DocEntry | undefined): JsonObject | undefined {
+  return !entry || entry.deleted ? undefined : entry.content;
+}
+
+function liveContents(
+  docs: ReadonlyMap<string, DocEntry>,
+): Record<string, JsonObject> {
+  const out: Record<string, JsonObject> = {};
+  for (const [id, entry] of docs) {
+    if (!entry.deleted) out[id] = deepClone(entry.content);
+  }
+  return out;
+}
+
+function unionIds(...maps: ReadonlyMap<string, DocEntry>[]): string[] {
+  const ids: string[] = [];
+  const seen = new Set<string>();
+  for (const map of maps) {
+    for (const id of map.keys()) {
+      if (seen.has(id)) continue;
+      seen.add(id);
+      ids.push(id);
+    }
+  }
+  return ids;
+}
+
+function commitOrder(id: string): number {
+  return Number(id.slice(1));
+}
+
+export default DocumentStore;
