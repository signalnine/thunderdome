+    store.switchBranch('main');
+    store.update('doc', { a: 1, b: 2, nested: { x: 10, y: 2 } });
+
+    const result = store.merge('feature');
+    expect(result.conflicts).toEqual([]);
+    expect(store.get('doc')).toEqual({ a: 1, b: 2, nested: { x: 10, y: 20 } });
