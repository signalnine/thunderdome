diff --git a/tests/counter.test.ts b/tests/counter.test.ts
new file mode 100644
index 0000000..5c03c97
--- /dev/null
+++ b/tests/counter.test.ts
@@ -0,0 +1,204 @@
+import { describe, expect, it } from 'vitest';
+import { solveCounter } from '../src/index.js';
+
+function apply(buttons: number[][], presses: number[], size: number, p: number): number[] {
+  const counters = new Array<number>(size).fill(0);
+  for (let j = 0; j < buttons.length; j++) {
+    for (const idx of buttons[j]) counters[idx] = (counters[idx] + presses[j]) % p;
+  }
+  return counters;
+}
+
+/** Reference solver: enumerate every press vector. Tiny instances only. */
+function brute(lights: number[], buttons: number[][], p: number): number[] | null {
+  const m = buttons.length;
+  const cur = new Array<number>(m).fill(0);
+  let best: number[] | null = null;
+  let bestSum = Infinity;
+  const total = p ** m;
+  for (let code = 0; code < total; code++) {
+    let rest = code;
+    let sum = 0;
+    for (let j = 0; j < m; j++) {
+      cur[j] = rest % p;
+      rest = Math.floor(rest / p);
+      sum += cur[j];
+    }
+    if (sum > bestSum) continue;
+    const got = apply(buttons, cur, lights.length, p);
+    if (!got.every((v, i) => v === ((lights[i] % p) + p) % p)) continue;
+    if (sum < bestSum) {
+      bestSum = sum;
+      best = cur.slice();
+      continue;
+    }
+    const prev = best as number[];
+    for (let j = 0; j < m; j++) {
+      if (cur[j] !== prev[j]) {
+        if (cur[j] < prev[j]) best = cur.slice();
+        break;
+      }
+    }
+  }
+  return best;
+}
+
+function mulberry(seed: number): () => number {
+  let a = seed;
+  return () => {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+describe('solveCounter', () => {
+  it('returns all zeros when every counter is already at its target', () => {
+    expect(solveCounter([0, 0], [[0], [1]], 5)).toEqual([0, 0]);
+  });
+
+  it('solves a one-button-per-counter machine', () => {
+    expect(solveCounter([3, 1], [[0], [1]], 5)).toEqual([3, 1]);
+  });
+
+  it('uses wraparound when that costs fewer presses', () => {
+    // Button 0 hits both counters, so 2 presses beat 4+4 separate presses.
+    expect(solveCounter([2, 2], [[0, 1], [0], [1]], 5)).toEqual([2, 0, 0]);
+  });
+
+  it('wraps a counter around the modulus', () => {
+    // The only route to counter 0 is button 0, which also drives counter 1.
+    expect(solveCounter([4, 4], [[0, 1]], 5)).toEqual([4]);
+  });
+
+  it('returns null when the system is inconsistent', () => {
+    expect(solveCounter([1, 2], [[0, 1]], 5)).toBeNull();
+  });
+
+  it('returns null when a counter cannot be reached', () => {
+    expect(solveCounter([0, 1], [[0]], 7)).toBeNull();
+  });
+
+  it('counts repeated indices within one button', () => {
+    // Button 0 adds 2 to counter 0 each press; 3 presses reach 6 % 5 = 1.
+    expect(solveCounter([1], [[0, 0]], 5)).toEqual([3]);
+  });
+
+  it('breaks ties on total presses lexicographically', () => {
+    // Buttons 0 and 1 are identical. A smaller result array means smaller
+    // early entries, so the presses land on the *later* button.
+    expect(solveCounter([2], [[0], [0]], 7)).toEqual([0, 2]);
+  });
+
+  it('handles a machine with no buttons', () => {
+    expect(solveCounter([], [], 7)).toEqual([]);
+    expect(solveCounter([0, 0], [], 7)).toEqual([]);
+    expect(solveCounter([0, 1], [], 7)).toBeNull();
+  });
+
+  it('solves a 40-button machine with only a few counters', () => {
+    const rand = mulberry(555);
+    const n = 3;
+    const m = 40;
+    const p = 97;
+    const buttons: number[][] = [];
+    for (let j = 0; j < m; j++) {
+      const set: number[] = [];
+      for (let i = 0; i < n; i++) if (rand() < 0.5) set.push(i);
+      buttons.push(set);
+    }
+    const lights = [61, 5, 90];
+    const start = Date.now();
+    const result = solveCounter(lights, buttons, p);
+    expect(Date.now() - start).toBeLessThan(5000);
+    const got = result as number[];
+    expect(got).not.toBeNull();
+    expect(got.every((v) => v >= 0 && v < p)).toBe(true);
+    expect(apply(buttons, got, n, p)).toEqual(lights);
+  });
+
+  it('matches brute force on random small machines', () => {
+    const rand = mulberry(31337);
+    const primes = [2, 3, 5, 7];
+    for (let trial = 0; trial < 200; trial++) {
+      const p = primes[Math.floor(rand() * primes.length)];
+      const n = 1 + Math.floor(rand() * 3);
+      const m = 1 + Math.floor(rand() * (p <= 3 ? 6 : 4));
+      const buttons: number[][] = [];
+      for (let j = 0; j < m; j++) {
+        const set: number[] = [];
+        for (let i = 0; i < n; i++) if (rand() < 0.5) set.push(i);
+        buttons.push(set);
+      }
+      const lights: number[] = [];
+      for (let i = 0; i < n; i++) lights.push(Math.floor(rand() * p));
+      const expected = brute(lights, buttons, p);
+      const label = JSON.stringify({ lights, buttons, p });
+      for (const strategy of ['auto', 'coset', 'states'] as const) {
+        const actual = solveCounter(lights, buttons, p, strategy);
+        expect(actual, `${strategy} ${label}`).toEqual(expected);
+        if (actual) expect(apply(buttons, actual, n, p)).toEqual(lights.map((v) => v % p));
+      }
+    }
+  });
+
+  it('matches brute force on random machines with a larger modulus', () => {
+    const rand = mulberry(4242);
+    const primes = [11, 13];
+    for (let trial = 0; trial < 60; trial++) {
+      const p = primes[Math.floor(rand() * primes.length)];
+      const n = 1 + Math.floor(rand() * 2);
+      const m = 1 + Math.floor(rand() * 3);
+      const buttons: number[][] = [];
+      for (let j = 0; j < m; j++) {
+        const set: number[] = [];
+        for (let i = 0; i < n; i++) if (rand() < 0.6) set.push(i);
+        buttons.push(set);
+      }
+      const lights: number[] = [];
+      for (let i = 0; i < n; i++) lights.push(Math.floor(rand() * p));
+      const expected = brute(lights, buttons, p);
+      const label = JSON.stringify({ lights, buttons, p });
+      for (const strategy of ['auto', 'coset', 'states'] as const) {
+        expect(solveCounter(lights, buttons, p, strategy), `${strategy} ${label}`).toEqual(expected);
+      }
+    }
+  });
+
+  it('solves a 40x40 machine mod 97 well under the time limit', () => {
+    const rand = mulberry(99);
+    const n = 40;
+    const m = 40;
+    const p = 97;
+    const buttons: number[][] = [];
+    for (let j = 0; j < m; j++) {
+      const set: number[] = [];
+      for (let i = 0; i < n; i++) if (rand() < 0.4) set.push(i);
+      buttons.push(set);
+    }
+    const presses = Array.from({ length: m }, () => Math.floor(rand() * p));
+    const lights = apply(buttons, presses, n, p);
+
+    const start = Date.now();
+    const result = solveCounter(lights, buttons, p);
+    expect(Date.now() - start).toBeLessThan(5000);
+    expect(result).not.toBeNull();
+    const got = result as number[];
+    expect(apply(buttons, got, n, p)).toEqual(lights);
+    expect(got.reduce((a, b) => a + b, 0)).toBeLessThanOrEqual(
+      presses.reduce((a, b) => a + b, 0),
+    );
+  });
+
+  it('handles many redundant buttons quickly', () => {
+    // 40 interchangeable buttons: two presses total, pushed as late as
+    // possible so the result array is lexicographically smallest.
+    const buttons = Array.from({ length: 40 }, () => [0]);
+    const start = Date.now();
+    const result = solveCounter([2], buttons, 97);
+    expect(Date.now() - start).toBeLessThan(5000);
+    expect(result).toEqual([...new Array<number>(39).fill(0), 2]);
+  });
+});
