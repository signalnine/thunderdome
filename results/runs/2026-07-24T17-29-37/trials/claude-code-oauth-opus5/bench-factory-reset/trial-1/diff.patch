+import type { Machine } from './types.js';
+
+/** Bits per word in the two-word (60 bit) button masks used below. */
+const WORD = 30;
+
+/** Largest null-space dimension we are willing to enumerate directly (2^k). */
+const MAX_ENUMERATE = 24;
+
+/** Largest button count the meet-in-the-middle fallback will accept. */
+const MAX_MITM_BUTTONS = 44;
+
+function popcount(x: number): number {
+  x = x - ((x >>> 1) & 0x55555555);
+  x = (x & 0x33333333) + ((x >>> 2) & 0x33333333);
+  x = (x + (x >>> 4)) & 0x0f0f0f0f;
+  x = x + (x >>> 8);
+  x = x + (x >>> 16);
+  return x & 0x3f;
+}
+
+function ctz(x: number): number {
+  return 31 - Math.clz32(x & -x);
+}
+
+/**
+ * Lexicographic order on *equal sized* index sets: the set owning the lowest
+ * index the two disagree on sorts first.
+ */
+function lexLess(aLo: number, aHi: number, bLo: number, bHi: number): boolean {
+  const dLo = aLo ^ bLo;
+  if (dLo !== 0) return (dLo & -dLo & aLo) !== 0;
+  const dHi = aHi ^ bHi;
+  if (dHi === 0) return false;
+  return (dHi & -dHi & aHi) !== 0;
+}
+
+/** Same comparison for masks that fit in a single word. */
+function lexLess1(a: number, b: number): boolean {
+  const d = a ^ b;
+  return d !== 0 && (d & -d & a) !== 0;
+}
+
+function maskToIndices(lo: number, hi: number): number[] {
+  const out: number[] = [];
+  for (let i = 0; i < WORD; i++) if ((lo >>> i) & 1) out.push(i);
+  for (let i = 0; i < WORD; i++) if ((hi >>> i) & 1) out.push(WORD + i);
+  return out;
+}
+
+/**
+ * Which search to run once the system is reduced. `auto` picks by null space
+ * size; the others exist so tests can exercise both paths on small inputs.
+ */
+export type ToggleStrategy = 'auto' | 'enumerate' | 'mitm';
+
+/**
+ * Minimum set of buttons whose toggles produce `target`.
+ *
+ * The lights form a linear system over GF(2): pressing a set of buttons XORs
+ * their light masks together, so we row-reduce and then search the solution
+ * coset for the lightest member.
+ */
+export function solveToggle(machine: Machine, strategy: ToggleStrategy = 'auto'): number[] | null {
+  const buttons = machine.buttons;
+  const M = buttons.length;
+  if (M > 2 * WORD) {
+    throw new RangeError(`solveToggle supports at most ${2 * WORD} buttons, got ${M}`);
+  }
+
+  // Buttons may name lights past the end of `target`; those lights simply have
+  // an "off" target.
+  let nLights = machine.target.length;
+  for (const b of buttons) for (const idx of b) if (idx + 1 > nLights) nLights = idx + 1;
+
+  // Row per light, one bit per button, plus the target bit.
+  const rowLo = new Int32Array(nLights);
+  const rowHi = new Int32Array(nLights);
+  const rhs = new Uint8Array(nLights);
+  for (let j = 0; j < M; j++) {
+    const bit = 1 << (j % WORD);
+    for (const idx of buttons[j]) {
+      if (idx < 0) throw new RangeError(`button ${j} references negative light index ${idx}`);
+      if (j < WORD) rowLo[idx] ^= bit;
+      else rowHi[idx] ^= bit;
+    }
+  }
+  for (let i = 0; i < machine.target.length; i++) rhs[i] = machine.target[i] ? 1 : 0;
+
+  // Reduced row echelon form, pivots taken left to right.
+  const pivotCol: number[] = [];
+  let rank = 0;
+  for (let c = 0; c < M && rank < nLights; c++) {
+    const useLo = c < WORD;
+    const bit = 1 << (c % WORD);
+    let sel = -1;
+    for (let i = rank; i < nLights; i++) {
+      if ((useLo ? rowLo[i] : rowHi[i]) & bit) {
+        sel = i;
+        break;
+      }
+    }
+    if (sel < 0) continue;
+    if (sel !== rank) {
+      let t = rowLo[sel];
+      rowLo[sel] = rowLo[rank];
+      rowLo[rank] = t;
+      t = rowHi[sel];
+      rowHi[sel] = rowHi[rank];
+      rowHi[rank] = t;
+      const tr = rhs[sel];
+      rhs[sel] = rhs[rank];
+      rhs[rank] = tr;
+    }
+    for (let i = 0; i < nLights; i++) {
+      if (i !== rank && (useLo ? rowLo[i] : rowHi[i]) & bit) {
+        rowLo[i] ^= rowLo[rank];
+        rowHi[i] ^= rowHi[rank];
+        rhs[i] ^= rhs[rank];
+      }
+    }
+    pivotCol.push(c);
+    rank++;
+  }
+
+  // Rows below the rank are all-zero; a nonzero target there is unsatisfiable.
+  for (let i = rank; i < nLights; i++) if (rhs[i]) return null;
+
+  const freeCols: number[] = [];
+  const isPivot = new Uint8Array(M);
+  for (const c of pivotCol) isPivot[c] = 1;
+  for (let c = 0; c < M; c++) if (!isPivot[c]) freeCols.push(c);
+  const k = freeCols.length;
+
+  if (strategy === 'enumerate' || (strategy === 'auto' && k <= MAX_ENUMERATE)) {
+    return enumerateCoset(rowLo, rowHi, rhs, rank, pivotCol, freeCols);
+  }
+  if (strategy === 'mitm' || M <= MAX_MITM_BUTTONS) {
+    return meetInTheMiddle(rowLo, rowHi, rhs, rank, M);
+  }
+  throw new RangeError(
+    `solveToggle: ${M} buttons with a null space of dimension ${k} is beyond the supported search size`,
+  );
+}
+
+/**
+ * Walk the whole solution coset (2^k members) in Gray-code order, keeping the
+ * lightest solution and breaking ties lexicographically.
+ */
+function enumerateCoset(
+  rowLo: Int32Array,
+  rowHi: Int32Array,
+  rhs: Uint8Array,
+  rank: number,
+  pivotCol: number[],
+  freeCols: number[],
+): number[] {
+  // Particular solution: free variables zero, pivots take their row's target.
+  let pLo = 0;
+  let pHi = 0;
+  for (let i = 0; i < rank; i++) {
+    if (!rhs[i]) continue;
+    const c = pivotCol[i];
+    if (c < WORD) pLo |= 1 << c;
+    else pHi |= 1 << (c - WORD);
+  }
+
+  const k = freeCols.length;
+  const basisLo = new Int32Array(k);
+  const basisHi = new Int32Array(k);
+  for (let f = 0; f < k; f++) {
+    const c = freeCols[f];
+    let lo = 0;
+    let hi = 0;
+    if (c < WORD) lo |= 1 << c;
+    else hi |= 1 << (c - WORD);
+    const useLo = c < WORD;
+    const bit = 1 << (c % WORD);
+    for (let i = 0; i < rank; i++) {
+      if ((useLo ? rowLo[i] : rowHi[i]) & bit) {
+        const pc = pivotCol[i];
+        if (pc < WORD) lo |= 1 << pc;
+        else hi |= 1 << (pc - WORD);
+      }
+    }
+    basisLo[f] = lo;
+    basisHi[f] = hi;
+  }
+
+  let bestLo = pLo;
+  let bestHi = pHi;
+  let bestPop = popcount(pLo) + popcount(pHi);
+  let curLo = pLo;
+  let curHi = pHi;
+  const total = 2 ** k;
+  for (let i = 1; i < total; i++) {
+    const j = ctz(i);
+    curLo ^= basisLo[j];
+    curHi ^= basisHi[j];
+    const pop = popcount(curLo) + popcount(curHi);
+    if (pop < bestPop || (pop === bestPop && lexLess(curLo, curHi, bestLo, bestHi))) {
+      bestPop = pop;
+      bestLo = curLo;
+      bestHi = curHi;
+    }
+  }
+  return maskToIndices(bestLo, bestHi);
+}
+
+/**
+ * Fallback for very large null spaces: split the buttons in half, tabulate the
+ * best subset of each half per reachable light pattern, then join the halves.
+ *
+ * Reaching here means the rank is small (the null space was too big to walk),
+ * so a direct-address table over the 2^rank patterns is cheap.
+ */
+function meetInTheMiddle(
+  rowLo: Int32Array,
+  rowHi: Int32Array,
+  rhs: Uint8Array,
+  rank: number,
+  M: number,
+): number[] | null {
+  if (rank > 26) {
+    // Only reachable when a caller forces this strategy: the lookup tables are
+    // indexed by light pattern, so the rank has to stay small.
+    throw new RangeError(`meet-in-the-middle needs a rank of at most 26, got ${rank}`);
+  }
+  // Column j of the reduced system, as a bitmask over the surviving rows.
+  const col = new Int32Array(M);
+  for (let i = 0; i < rank; i++) {
+    const lo = rowLo[i];
+    const hi = rowHi[i];
+    for (let j = 0; j < M; j++) {
+      const bit = j < WORD ? (lo >>> j) & 1 : (hi >>> (j - WORD)) & 1;
+      if (bit) col[j] |= 1 << i;
+    }
+  }
+  let want = 0;
+  for (let i = 0; i < rank; i++) if (rhs[i]) want |= 1 << i;
+
+  const hA = M >> 1;
+  const hB = M - hA;
+  const size = 1 << rank;
+  const bestA = tabulate(col, 0, hA, size);
+  const bestB = tabulate(col, hA, hB, size);
+
+  let bestPop = Infinity;
+  let bestMaskA = 0;
+  let bestMaskB = 0;
+  for (let v = 0; v < size; v++) {
+    const a = bestA[v];
+    if (a < 0) continue;
+    const b = bestB[v ^ want];
+    if (b < 0) continue;
+    const pop = popcount(a) + popcount(b);
+    if (pop > bestPop) continue;
+    if (
+      pop < bestPop ||
+      lexLess1(a, bestMaskA) ||
+      (a === bestMaskA && lexLess1(b, bestMaskB))
+    ) {
+      bestPop = pop;
+      bestMaskA = a;
+      bestMaskB = b;
+    }
+  }
+  if (bestPop === Infinity) return null;
+
+  const out: number[] = [];
+  for (let i = 0; i < hA; i++) if ((bestMaskA >>> i) & 1) out.push(i);
+  for (let i = 0; i < hB; i++) if ((bestMaskB >>> i) & 1) out.push(hA + i);
+  return out;
+}
+
+/**
+ * For every light pattern reachable by a subset of `count` buttons starting at
+ * `start`, record the lightest such subset (ties broken lexicographically).
+ */
+function tabulate(col: Int32Array, start: number, count: number, size: number): Int32Array {
+  const best = new Int32Array(size).fill(-1);
+  const value = new Int32Array(1 << count);
+  best[0] = 0;
+  for (let m = 1; m < 1 << count; m++) {
+    const j = ctz(m);
+    const v = value[m ^ (1 << j)] ^ col[start + j];
+    value[m] = v;
+    const cur = best[v];
+    if (cur < 0 || popcount(m) < popcount(cur) || (popcount(m) === popcount(cur) && lexLess1(m, cur))) {
+      best[v] = m;
+    }
+  }
+  return best;
+}
