+ p) % p;\n    return mat;\n  };\n\n  const naturalOrder = Array.from({ length: M }, (_, c) => c);\n  let mat = build();\n  let reduced = eliminate(mat, nC, M, p, naturalOrder);\n  if (reduced === null) return null;\n\n  const rank = reduced.rank;\n  const k = M - rank;\n\n  // Two exact searches are available. Walking the solution coset costs about\n  // p^k; walking the counter state space costs about M * p^rank. Prefer the\n  // coset while it is cheap, then fall back to states when they fit in memory.\n  const logp = Math.log(p);\n  const cosetIsCheap = k * logp <= Math.log(1e6);\n  const statesFit = p <= 255 && rank * logp <= Math.log(1e6);\n  if (strategy === 'states' || (strategy === 'auto' && !cosetIsCheap && statesFit)) {\n    return stateSearch(mat, rank, M, p);\n  }\n\n  if (k >= 2) {\n    // Re-reduce now that we know how many free columns to place.\n    mat = build();\n    reduced = eliminate(mat, nC, M, p, spreadOrder(M, k)) as Reduced;\n  }\n\n  const isPivot = new Uint8Array(M);\n  for (const c of reduced.pivotCol) isPivot[c] = 1;\n  const freeCols: number[] = [];\n  for (let c = 0; c < M; c++) if (!isPivot[c]) freeCols.push(c);\n\n  return searchCoset(mat, reduced, M, p, freeCols);\n}\n\n/**\n * Depth-first search over the free variables, assigning the last one first.\n * Each pivot's press count is forced once the free variables it depends on are\n * fixed, so the running total is a valid lower bound and prunes the search.\n */\nfunction searchCoset(\n  mat: Int32Array[],\n  reduced: Reduced,\n  M: number,\n  p: number,\n  freeCols: number[],\n): number[] | null {\n  const rank = reduced.rank;\n  const k = freeCols.length;\n\n  // A pivot row is determined once every free variable it references has been\n  // assigned; order the rows so that the ones determined earliest come last.\n  const closeLevel = new Int32Array(rank).fill(k);\n  for (let i = 0; i < rank; i++) {\n    for (let d = 0; d < k; d++) {\n      if (mat[i][freeCols[d]] !== 0) {\n      