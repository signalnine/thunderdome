[j] += p;\n      }\n    }\n    pivotCol.push(c);\n    rank++;\n  }\n  for (let i = rank; i < nRows; i++) if (mat[i][M] !== 0) return null;\n  return { rank, pivotCol };\n}\n\n/**\n * Column priority that leaves `k` free columns spread evenly across the\n * button range. The search assigns free variables from the last one backwards\n * and prices each pivot as soon as its free variables are all fixed, so\n * spreading them makes partial press totals — and therefore pruning — kick in\n * much earlier than if the free columns all sat at one end.\n */\nfunction spreadOrder(M: number, k: number): number[] {\n  const wanted = new Uint8Array(M);\n  for (let d = 0; d < k; d++) wanted[Math.floor(((d + 1) * M) / (k + 1))] = 1;\n  const order: number[] = [];\n  for (let c = 0; c < M; c++) if (!wanted[c]) order.push(c);\n  for (let c = 0; c < M; c++) if (wanted[c]) order.push(c);\n  return order;\n}\n\nconst INF = 1 << 29;\n\n/**\n * Search over counter states rather than over press vectors.\n *\n * After reduction the machine only ever occupies `p^rank` distinct states, so\n * when that space is small we can do an exact DP: walking the buttons from\n * last to first, `cost[s]` is the cheapest way to cover the remaining state\n * `s` with the remaining buttons. Pressing button `j` v times walks v steps\n * along the cycle `s, s - col_j, s - 2*col_j, ...`, which is why each button\n * costs only O(p^rank) instead of O(p^(rank+1)).\n *\n * This is the complement of `searchCoset`: it wins exactly when there are many\n * more buttons than independent counters.\n */\nfunction stateSearch(mat: Int32Array[], rank: number, M: number, p: number): number[] | null {\n  const pow = new Int32Array(rank + 1);\n  pow[0] = 1;\n  for (let i = 0; i < rank; i++) pow[i + 1] = pow[i] * p;\n  const total = pow[rank];\n\n  const gen = new Int32Array(M * rank);\n  for (let j = 0; j < M; j++) for (let i = 0; i < rank; i++) gen[j * rank + i] = mat[i][j];\n  let targetIdx = 0;\n  for (let i = 0; i < rank