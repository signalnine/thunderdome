n  p: number,\n  order: number[],\n): Reduced | null {\n  const pivotCol: number[] = [];\n  let rank = 0;\n  for (const c of order) {\n    if (rank >= nRows) break;\n    let sel = -1;\n    for (let i = rank; i < nRows; i++) {\n      if (mat[i][c] !== 0) {\n        sel = i;\n        break;\n      }\n    }\n    if (sel < 0) continue;\n    if (sel !== rank) {\n      const t = mat[sel];\n      mat[sel] = mat[rank];\n      mat[rank] = t;\n    }\n    const pivRow = mat[rank];\n    const inv = modInverse(pivRow[c], p);\n    if (inv !== 1) {\n      for (let j = 0; j <= M; j++) if (pivRow[j] !== 0) pivRow[j] = (pivRow[j] * inv) % p;\n    }\n    for (let i = 0; i < nRows; i++) {\n      if (i === rank) continue;\n      const row = mat[i];\n      const factor = row[c];\n      if (factor === 0) continue;\n      for (let j = 0; j <= M; j++) {\n        if (pivRow[j] === 0) continue;\n        row[j] = (row[j] - factor * pivRow[j]) % p;\n        if (row[j] < 0) row[j] += p;\n      }\n    }\n    pivotCol.push(c);\n    rank++;\n  }\n  for (let i = rank; i < nRows; i++) if (mat[i][M] !== 0) return null;\n  return { rank, pivotCol };\n}\n\n/**\n * Column priority that leaves `k` free columns spread evenly across the\n * button range. The search assigns free variables from the last one backwards\n * and prices each pivot as soon as its free variables are all fixed, so\n * spreading them makes partial press totals — and therefore pruning — kick in\n * much earlier than if the free columns all sat at one end.\n */\nfunction spreadOrder(M: number, k: number): number[] {\n  const wanted = new Uint8Array(M);\n  for (let d = 0; d < k; d++) wanted[Math.floor(((d + 1) * M) / (k + 1))] = 1;\n  const order: number[] = [];\n  for (let c = 0; c < M; c++) if (!wanted[c]) order.push(c);\n  for (let c = 0; c < M; c++) if (wanted[c]) order.push(c);\n  return order;\n}\n\nconst INF = 1 << 29;\n\n/**\n * Search over counter states rather than over press vectors.\n *\n * After reduction the machine only ever occupies `p^rank` distinct states, so\n * when that space is small we can do an exact DP: walking the buttons from\n * last to first, `cost[s]` is the cheapest way to cover the remaining state\n * `s` with the remaining buttons. Pressing button `j` v times walks v steps\n * along the cycle `s, s - col_j, s - 2*col_j, ...`, which is why each button\n * costs only O(p^rank) instead of O(p^(rank+1)).\n *\n * This is the complement of `searchCoset`: it wins exactly when there are many\n * more buttons than independent counters.\n */\nfunction stateSearch(mat: Int32Array[], rank: number, M: number, p: number): number[] | null {\n  const pow = new Int32Array(rank + 1);\n  pow[0] = 1;\n  for (let i = 0; i < rank; i++) pow[i + 1] = pow[i] * p;\n  const total = pow[rank];\n\n  const gen = new Int32Array(M * rank);\n  for (let j = 0; j < M; j++) for (let i = 0; i < rank; i++) gen[j * rank + i] = mat[i][j];\n  let targetIdx = 0;\n  for (let i = 0; i < rank; i++) targetIdx += mat[i][M] * pow[i];\n\n  let next = new Int32Array(total).fill(INF);\n  next[0] = 0;\n  let cur = new Int32Array(total);\n  const choices: Uint8Array[] = new Array(M);\n  const visited = new Uint8Array(total);\n  const cycle = new Int32Array(p);\n  const digits = new Int32Array(rank);\n\n  for (let j = M - 1; j >= 0; j--) {\n    const choice = new Uint8Array(total);\n    choices[j] = choice;\n    const base = j * rank;\n    let zero = true;\n    for (let i = 0; i < rank; i++) {\n      if (gen[base + i] !== 0) {\n        zero = false;\n        break;\n      }\n    }\n    if (zero) {\n      // Button changes nothing; never worth pressing.\n      cur.set(next);\n    } else {\n      visited.fill(0);\n      for (let start = 0; start < total; start++) {\n        if (visited[start]) continue;\n        let idx = start;\n        let rem = start;\n        for (let i = 0; i < rank; i++) {\n          digits[i] = rem % p;\n          rem = (rem - digits[i]) / p;\n        }\n        for (let m = 0; m < p; m++) {\n          cycle[m] = idx;\n          visited[idx] = 1;\n          for (let i = 0; i < rank; i++) {\n            const g = gen[base + i];\n            if (g === 0) continue;\n            let d = digits[i] - g;\n            if (d < 0) d += p;\n            idx += (d - digits[i]) * pow[i];\n            digits[i] = d;\n          }\n        }\n        // cost[cycle[m]] = min over v of v + next[cycle[m + v]]; two passes\n        // around the cycle cover the single wrap a v < p can make.\n        let running = INF;\n        let runChoice = 0;\n        for (let pass = 0; pass < 2; pass++) {\n          for (let m = p - 1; m >= 0; m--) {\n            const here = next[cycle[m]];\n            const stepped = running >= INF ? INF : running + 1;\n            if (here <= stepped) {\n              running = here;\n              runChoice = 0;\n            } else {\n              running = stepped;\n              runChoice++;\n            }\n            if (pass === 1) {\n              cur[cycle[m]] = running;\n              choice[cycle[m]] = runChoice;\n            }\n          }\n        }\n      }\n    }\n    const swap = next;\n    next = cur;\n    cur = swap;\n  }\n\n  if (next[targetIdx] >= INF) return null;\n\n  const x = new Array<number>(M).fill(0);\n  let s = targetIdx;\n  for (let j = 0; j < M; j++) {\n    const v = choices[j][s];\n    x[j] = v;\n    if (v === 0) continue;\n    let rem = s;\n    for (let i = 0; i < rank; i++) {\n      digits[i] = rem % p;\n      rem = (rem - digits[i]) / p;\n    }\n    const base = j * rank;\n    for (let i = 0; i < rank; i++) {\n      const g = gen[base + i];\n      if (g === 0) continue;\n      const d = (((digits[i] - g * v) % p) + p) % p;\n      s += (d - digits[i]) * pow[i];\n    }\n  }\n  return x;\n}\n\nexport function solveCounter(\n  lights: number[],\n  buttons: number[][],\n  modulus: number,\n): number[] | null {\n  const p = modulus;\n  if (!Number.isInteger(p) || p < 2) {\n    throw new RangeError(`modulus must be a prime >= 2