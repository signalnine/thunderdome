@@ -0,0 +1,163 @@
+import { describe, expect, it } from 'vitest';
+import { solveToggle } from '../src/index.js';
+import type { Machine } from '../src/index.js';
+
+function apply(machine: Machine, presses: number[]): boolean[] {
+  const lights = new Array<boolean>(machine.target.length).fill(false);
+  for (const b of presses) {
+    for (const idx of machine.buttons[b]) lights[idx] = !lights[idx];
+  }
+  return lights;
+}
+
+/** Reference solver: enumerate every subset. Only usable for tiny machines. */
+function brute(machine: Machine): number[] | null {
+  const M = machine.buttons.length;
+  let best: number[] | null = null;
+  for (let mask = 0; mask < 1 << M; mask++) {
+    const presses: number[] = [];
+    for (let j = 0; j < M; j++) if ((mask >> j) & 1) presses.push(j);
+    const lights = apply(machine, presses);
+    if (!lights.every((v, i) => v === machine.target[i])) continue;
+    if (best === null || presses.length < best.length) {
+      best = presses;
+      continue;
+    }
+    if (presses.length === best.length) {
+      for (let i = 0; i < presses.length; i++) {
+        if (presses[i] !== best[i]) {
+          if (presses[i] < best[i]) best = presses;
+          break;
+        }
+      }
+    }
+  }
+  return best;
+}
+
+function mulberry(seed: number): () => number {
+  let a = seed;
+  return () => {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+describe('solveToggle', () => {
+  it('returns an empty press list when the target is already met', () => {
+    expect(solveToggle({ target: [false, false], buttons: [[0], [1]] })).toEqual([]);
+  });
+
+  it('rejects the unsatisfiable machine from the task description', () => {
+    const machine: Machine = {
+      target: [true, true, false, true],
+      buttons: [
+        [0, 1],
+        [1, 2, 3],
+        [0, 3],
+      ],
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it('solves a machine with one button per light', () => {
+    const machine: Machine = {
+      target: [true, false, true],
+      buttons: [[0], [1], [2]],
+    };
+    expect(solveToggle(machine)).toEqual([0, 2]);
+  });
+
+  it('prefers the fewest presses over an easier-looking combination', () => {
+    // Button 2 alone matches the target; buttons 0 and 1 together also do.
+    const machine: Machine = {
+      target: [true, true, false],
+      buttons: [[0], [1], [0, 1]],
+    };
+    expect(solveToggle(machine)).toEqual([2]);
+  });
+
+  it('breaks ties on press count lexicographically', () => {
+    // Buttons 0 and 3 are interchangeable, as are 1 and 2.
+    const machine: Machine = {
+      target: [true, true],
+      buttons: [[0], [1], [1], [0]],
+    };
+    expect(solveToggle(machine)).toEqual([0, 1]);
+  });
+
+  it('handles a button that toggles nothing', () => {
+    const machine: Machine = { target: [true], buttons: [[], [0]] };
+    expect(solveToggle(machine)).toEqual([1]);
+  });
+
+  it('returns null when no button touches a lit target', () => {
+    expect(solveToggle({ target: [false, true], buttons: [[0]] })).toBeNull();
+  });
+
+  it('handles a machine with no buttons', () => {
+    expect(solveToggle({ target: [], buttons: [] })).toEqual([]);
+    expect(solveToggle({ target: [false, false], buttons: [] })).toEqual([]);
+    expect(solveToggle({ target: [false, true], buttons: [] })).toBeNull();
+  });
+
+  it('matches brute force on random small machines', () => {
+    const rand = mulberry(20260724);
+    for (let trial = 0; trial < 300; trial++) {
+      const n = 1 + Math.floor(rand() * 5);
+      const m = 1 + Math.floor(rand() * 10);
+      const buttons: number[][] = [];
+      for (let j = 0; j < m; j++) {
+        const set: number[] = [];
+        for (let i = 0; i < n; i++) if (rand() < 0.5) set.push(i);
+        buttons.push(set);
+      }
+      const target: boolean[] = [];
+      for (let i = 0; i < n; i++) target.push(rand() < 0.5);
+      const machine: Machine = { target, buttons };
+      const expected = brute(machine);
+      const label = JSON.stringify(machine);
+      for (const strategy of ['auto', 'enumerate', 'mitm'] as const) {
+        const actual = solveToggle(machine, strategy);
+        expect(actual, `${strategy} ${label}`).toEqual(expected);
+        if (actual) expect(apply(machine, actual)).toEqual(target);
+      }
+    }
+  });
+
+  it('solves a 40x40 machine well under the time limit', () => {
+    const rand = mulberry(7);
+    const n = 40;
+    const m = 40;
+    const buttons: number[][] = [];
+    for (let j = 0; j < m; j++) {
+      const set: number[] = [];
+      for (let i = 0; i < n; i++) if (rand() < 0.5) set.push(i);
+      buttons.push(set);
+    }
+    // Build a reachable target so the instance is guaranteed solvable.
+    const target = new Array<boolean>(n).fill(false);
+    const pressed = [3, 11, 12, 29, 37];
+    for (const b of pressed) for (const idx of buttons[b]) target[idx] = !target[idx];
+
+    const start = Date.now();
+    const result = solveToggle({ target, buttons });
+    expect(Date.now() - start).toBeLessThan(5000);
+    expect(result).not.toBeNull();
+    expect(apply({ target, buttons }, result as number[])).toEqual(target);
+    expect((result as number[]).length).toBeLessThanOrEqual(pressed.length);
+  });
+
+  it('handles a degenerate 40-button machine with a huge null space', () => {
+    // Every button toggles light 0, so any odd-sized subset works and the
+    // answer is the single smallest index.
+    const buttons = Array.from({ length: 40 }, () => [0]);
+    const start = Date.now();
+    expect(solveToggle({ target: [true], buttons })).toEqual([0]);
+    expect(solveToggle({ target: [false], buttons })).toEqual([]);
+    expect(Date.now() - start).toBeLessThan(5000);
+  });
+});
