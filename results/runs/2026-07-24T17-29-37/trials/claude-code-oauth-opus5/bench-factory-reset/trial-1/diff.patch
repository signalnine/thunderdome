et i = 0; i < presses.length; i++) {\n        if (presses[i] !== best[i]) {\n          if (presses[i] < best[i]) best = presses;\n          break;\n        }\n      }\n    }\n  }\n  return best;\n}\n\nfunction mulberry(seed: number): () => number {\n  let a = seed;\n  return () => {\n    a |= 0;\n    a = (a + 0x6d2b79f5) | 0;\n    let t = Math.imul(a ^ (a >>> 15), 1 | a);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\ndescribe('solveToggle', () => {\n  it('returns an empty press list when the target is already met', () => {\n    expect(solveToggle({ target: [false, false], buttons: [[0], [1]] })).toEqual([]);\n  });\n\n  it('rejects the unsatisfiable machine from the task description', () => {\n    const machine: Machine = {\n      target: [true, true, false, true],\n      buttons: [\n        [0, 1],\n        [1, 2, 3],\n        [0, 3],\n      ],\n    };\n    expect(solveToggle(machine)).toBeNull();\n  });\n\n  it('solves a machine with one button per light', () => {\n    const machine: Machine = {\n      target: [true, false, true],\n      buttons: [[0], [1], [2]],\n    };\n    expect(solveToggle(machine)).toEqual([0, 2]);\n  });\n\n  it('prefers the fewest presses over an easier-looking combination', () => {\n    // Button 2 alone matches the target; buttons 0 and 1 together also do.\n    const machine: Machine = {\n      target: [true, true, false],\n      buttons: [[0], [1], [0, 1]],\n    };\n    expect(solveToggle(machine)).toEqual([2]);\n  });\n\n  it('breaks ties on press count lexicographically', () => {\n    // Buttons 0 and 3 are interchangeable, as are 1 and 2.\n    const machine: Machine = {\n      target: [true, true],\n      buttons: [[0], [1], [1], [0]],\n    };\n    expect(solveToggle(machine)).toEqual([0, 1]);\n  });\n\n  it('handles a button that toggles nothing', () => {\n    const machine: Machine = { target: [true], buttons: [[], [0]] };\n    expect(solveToggle(machine)).toEqua