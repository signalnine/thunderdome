+/**
+ * Counter variant: buttons increment counters (mod a prime), and a button may
+ * be pressed 0..modulus-1 times. That is a linear system over the field Z_p,
+ * so we row-reduce and then search the solution coset for the assignment with
+ * the smallest total number of presses.
+ */
+
+function modInverse(a: number, p: number): number {
+  // Fermat's little theorem; p is prime.
+  let result = 1;
+  let base = a % p;
+  let exp = p - 2;
+  while (exp > 0) {
+    if (exp & 1) result = (result * base) % p;
+    base = (base * base) % p;
+    exp >>= 1;
+  }
+  return result;
+}
+
+interface Reduced {
+  rank: number;
+  pivotCol: number[];
+}
+
+/**
+ * Reduced row echelon form of `mat` (an n x (M+1) augmented matrix) mod p.
+ * Columns are considered as pivots in `order`, so the caller controls which
+ * columns end up free. Returns null if the system is inconsistent.
+ */
+function eliminate(
+  mat: Int32Array[],
+  nRows: number,
+  M: number,
+  p: number,
+  order: number[],
+): Reduced | null {
+  const pivotCol: number[] = [];
+  let rank = 0;
+  for (const c of order) {
+    if (rank >= nRows) break;
+    let sel = -1;
+    for (let i = rank; i < nRows; i++) {
+      if (mat[i][c] !== 0) {
+        sel = i;
+        break;
+      }
+    }
+    if (sel < 0) continue;
+    if (sel !== rank) {
+      const t = mat[sel];
+      mat[sel] = mat[rank];
+      mat[rank] = t;
+    }
+    const pivRow = mat[rank];
+    const inv = modInverse(pivRow[c], p);
+    if (inv !== 1) {
+      for (let j = 0; j <= M; j++) if (pivRow[j] !== 0) pivRow[j] = (pivRow[j] * inv) % p;
+    }
+    for (let i = 0; i < nRows; i++) {
+      if (i === rank) continue;
+      const row = mat[i];
+      const factor = row[c];
+      if (factor === 0) continue;
+      for (let j = 0; j <= M; j++) {
+        if (pivRow[j] === 0) continue;
+        row[j] = (row[j] - factor * pivRow[j]) % p;
+        if (row[j] < 0) row[j] += p;
+      }
+    }
+    pivotCol.push(c);
+    rank++;
+  }
+  for (let i = rank; i < nRows; i++) if (mat[i][M] !== 0) return null;
+  return { rank, pivotCol };
+}
+
+/**
+ * Column priority that leaves `k` free columns spread evenly across the
+ * button range. The search assigns free variables from the last one backwards
+ * and prices each pivot as soon as its free variables are all fixed, so
+ * spreading them makes partial press totals — and therefore pruning — kick in
+ * much earlier than if the free columns all sat at one end.
+ */
+function spreadOrder(M: number, k: number): number[] {
+  const wanted = new Uint8Array(M);
+  for (let d = 0; d < k; d++) wanted[Math.floor(((d + 1) * M) / (k + 1))] = 1;
+  const order: number[] = [];
+  for (let c = 0; c < M; c++) if (!wanted[c]) order.push(c);
+  for (let c = 0; c < M; c++) if (wanted[c]) order.push(c);
+  return order;
+}
+
+const INF = 1 << 29;
+
+/**
+ * Search over counter states rather than over press vectors.
+ *
+ * After reduction the machine only ever occupies `p^rank` distinct states, so
+ * when that space is small we can do an exact DP: walking the buttons from
+ * last to first, `cost[s]` is the cheapest way to cover the remaining state
+ * `s` with the remaining buttons. Pressing button `j` v times walks v steps
+ * along the cycle `s, s - col_j, s - 2*col_j, ...`, which is why each button
+ * costs only O(p^rank) instead of O(p^(rank+1)).
+ *
+ * This is the complement of `searchCoset`: it wins exactly when there are many
+ * more buttons than independent counters.
+ */
+function stateSearch(mat: Int32Array[], rank: number, M: number, p: number): number[] | null {
+  const pow = new Int32Array(rank + 1);
+  pow[0] = 1;
+  for (let i = 0; i < rank; i++) pow[i + 1] = pow[i] * p;
+  const total = pow[rank];
+
+  const gen = new Int32Array(M * rank);
+  for (let j = 0; j < M; j++) for (let i = 0; i < rank; i++) gen[j * rank + i] = mat[i][j];
+  let targetIdx = 0;
+  for (let i = 0; i < rank; i++) targetIdx += mat[i][M] * pow[i];
+
+  let next = new Int32Array(total).fill(INF);
+  next[0] = 0;
+  let cur = new Int32Array(total);
+  const choices: Uint8Array[] = new Array(M);
+  const visited = new Uint8Array(total);
+  const cycle = new Int32Array(p);
+  const digits = new Int32Array(rank);
+
+  for (let j = M - 1; j >= 0; j--) {
+    const choice = new Uint8Array(total);
+    choices[j] = choice;
+    const base = j * rank;
+    let zero = true;
+    for (let i = 0; i < rank; i++) {
+      if (gen[base + i] !== 0) {
+        zero = false;
+        break;
+      }
+    }
+    if (zero) {
+      // Button changes nothing; never worth pressing.
+      cur.set(next);
+    } else {
+      visited.fill(0);
+      for (let start = 0; start < total; start++) {
+        if (visited[start]) continue;
+        let idx = start;
+        let rem = start;
+        for (let i = 0; i < rank; i++) {
+          digits[i] = rem % p;
+          rem = (rem - digits[i]) / p;
+        }
+        for (let m = 0; m < p; m++) {
+          cycle[m] = idx;
+          visited[idx] = 1;
+          for (let i = 0; i < rank; i++) {
+            const g = gen[base + i];
+            if (g === 0) continue;
+            let d = digits[i] - g;
+            if (d < 0) d += p;
+            idx += (d - digits[i]) * pow[i];
+            digits[i] = d;
+          }
+        }
+        // cost[cycle[m]] = min over v of v + next[cycle[m + v]]; two passes
+        // around the cycle cover the single wrap a v < p can make.
+        let running = INF;
+        let runChoice = 0;
+        for (let pass = 0; pass < 2; pass++) {
+          for (let m = p - 1; m >= 0; m--) {
+            const here = next[cycle[m]];
+            const stepped = running >= INF ? INF : running + 1;
+            if (here <= stepped) {
+              running = here;
+              runChoice = 0;
+            } else {
+              running = stepped;
+              runChoice++;
+            }
+            if (pass === 1) {
+              cur[cycle[m]] = running;
+              choice[cycle[m]] = runChoice;
+            }
+          }
+        }
+      }
+    }
+    const swap = next;
+    next = cur;
+    cur = swap;
+  }
+
+  if (next[targetIdx] >= INF) return null;
+
+  const x = new Array<number>(M).fill(0);
+  let s = targetIdx;
+  for (let j = 0; j < M; j++) {
+    const v = choices[j][s];
+    x[j] = v;
+    if (v === 0) continue;
+    let rem = s;
+    for (let i = 0; i < rank; i++) {
+      digits[i] = rem % p;
+      rem = (rem - digits[i]) / p;
+    }
+    const base = j * rank;
+    for (let i = 0; i < rank; i++) {
+      const g = gen[base + i];
+      if (g === 0) continue;
+      const d = (((digits[i] - g * v) % p) + p) % p;
+      s += (d - digits[i]) * pow[i];
+    }
+  }
+  return x;
+}
+
+/**
+ * Which exact search to run. `auto` picks by problem shape; the others exist
+ * so tests can exercise both paths on inputs small enough to brute force.
+ */
+export type CounterStrategy = 'auto' | 'coset' | 'states';
+
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+  strategy: CounterStrategy = 'auto',
+): number[] | null {
+  const p = modulus;
+  if (!Number.isInteger(p) || p < 2) {
+    throw new RangeError(`modulus must be a prime >= 2, got ${modulus}`);
+  }
+  const M = buttons.length;
+
+  let nC = lights.length;
+  for (const b of buttons) for (const idx of b) if (idx + 1 > nC) nC = idx + 1;
+
+  // Buttons with the same effect are interchangeable, and moving a class's
+  // presses onto its last member never raises the total (a class total of p or
+  // more is always wasteful) while making the result array lexicographically
+  // smaller. So solve over one representative per class.
+  const lastOfClass = new Map<string, number>();
+  const columnKey: string[] = [];
+  for (let j = 0; j < M; j++) {
+    const counts = new Int32Array(nC);
+    for (const idx of buttons[j]) {
+      if (idx < 0) throw new RangeError(`button ${j} references negative counter index ${idx}`);
+      counts[idx] = (counts[idx] + 1) % p;
+    }
+    const key = counts.join(',');
+    columnKey.push(key);
+    lastOfClass.set(key, j);
+  }
+  if (lastOfClass.size < M) {
+    const kept: number[] = [];
+    for (let j = 0; j < M; j++) if (lastOfClass.get(columnKey[j]) === j) kept.push(j);
+    const sub = solveCounter(
+      lights,
+      kept.map((j) => buttons[j]),
+      p,
+      strategy,
+    );
+    if (sub === null) return null;
+    const full = new Array<number>(M).fill(0);
+    for (let i = 0; i < kept.length; i++) full[kept[i]] = sub[i];
+    return full;
+  }
+
+  const build = (): Int32Array[] => {
+    // Row per counter, column per button; entries count repeated increments.
+    const mat: Int32Array[] = [];
+    for (let i = 0; i < nC; i++) mat.push(new Int32Array(M + 1));
+    for (let j = 0; j < M; j++) {
+      for (const idx of buttons[j]) {
+        if (idx < 0) throw new RangeError(`button ${j} references negative counter index ${idx}`);
+        mat[idx][j] = (mat[idx][j] + 1) % p;
+      }
+    }
+    for (let i = 0; i < lights.length; i++) mat[i][M] = ((lights[i] % p) + p) % p;
+    return mat;
+  };
+
+  const naturalOrder = Array.from({ length: M }, (_, c) => c);
+  let mat = build();
+  let reduced = eliminate(mat, nC, M, p, naturalOrder);
+  if (reduced === null) return null;
+
+  const rank = reduced.rank;
+  const k = M - rank;
+
+  // Two exact searches are available. Walking the solution coset costs about
+  // p^k; walking the counter state space costs about M * p^rank. Prefer the
+  // coset while it is cheap, then fall back to states when they fit in memory.
+  const logp = Math.log(p);
+  const cosetIsCheap = k * logp <= Math.log(1e6);
+  const statesFit = p <= 255 && rank * logp <= Math.log(1e6);
+  if (strategy === 'states' || (strategy === 'auto' && !cosetIsCheap && statesFit)) {
+    return stateSearch(mat, rank, M, p);
+  }
+
+  if (k >= 2) {
+    // Re-reduce now that we know how many free columns to place.
+    mat = build();
+    reduced = eliminate(mat, nC, M, p, spreadOrder(M, k)) as Reduced;
+  }
+
+  const isPivot = new Uint8Array(M);
+  for (const c of reduced.pivotCol) isPivot[c] = 1;
+  const freeCols: number[] = [];
+  for (let c = 0; c < M; c++) if (!isPivot[c]) freeCols.push(c);
+
+  return searchCoset(mat, reduced, M, p, freeCols);
+}
+
+/**
+ * Depth-first search over the free variables, assigning the last one first.
+ * Each pivot's press count is forced once the free variables it depends on are
+ * fixed, so the running total is a valid lower bound and prunes the search.
+ */
+function searchCoset(
+  mat: Int32Array[],
+  reduced: Reduced,
+  M: number,
+  p: number,
+  freeCols: number[],
+): number[] | null {
+  const rank = reduced.rank;
+  const k = freeCols.length;
+
+  // A pivot row is determined once every free variable it references has been
+  // assigned; order the rows so that the ones determined earliest come last.
+  const closeLevel = new Int32Array(rank).fill(k);
+  for (let i = 0; i < rank; i++) {
+    for (let d = 0; d < k; d++) {
+      if (mat[i][freeCols[d]] !== 0) {
+        closeLevel[i] = d;
+        break;
+      }
+    }
+  }
+  const rows = Array.from({ length: rank }, (_, i) => i).sort(
+    (a, b) => closeLevel[a] - closeLevel[b] || reduced.pivotCol[a] - reduced.pivotCol[b],
+  );
+
+  const pivotOf = new Int32Array(rank);
+  const rhs = new Int32Array(rank);
+  const coef = new Int32Array(rank * k); // coef[i * k + d]: free var d in row i
+  for (let i = 0; i < rank; i++) {
+    const src = rows[i];
+    pivotOf[i] = reduced.pivotCol[src];
+    rhs[i] = mat[src][M];
+    for (let d = 0; d < k; d++) coef[i * k + d] = mat[src][freeCols[d]];
+  }
+
+  // hi[d] = number of rows determined at level d or earlier (a prefix, given
+  // the sort above), so level d updates rows [0, hi[d]) and closes
+  // [hi[d - 1], hi[d]).
+  const hi = new Int32Array(k + 1);
+  for (let i = 0; i < rank; i++) {
+    const lvl = closeLevel[rows[i]];
+    for (let d = lvl; d <= k; d++) hi[d]++;
+  }
+
+  const acc = new Int32Array((k + 1) * rank);
+  const pivVal = new Int32Array(rank);
+  const cur = new Int32Array(k);
+
+  // Rows that reference no free variable at all are fixed up front.
+  let baseSum = 0;
+  const topBase = k > 0 ? hi[k - 1] : 0;
+  for (let i = 0; i < rank; i++) acc[k * rank + i] = rhs[i];
+  for (let i = topBase; i < rank; i++) {
+    pivVal[i] = rhs[i];
+    baseSum += rhs[i];
+  }
+
+  let bestSum = Infinity;
+  let bestX: number[] | null = null;
+
+  const record = (sum: number): void => {
+    if (sum > bestSum) return;
+    const x = new Array<number>(M);
+    for (let d = 0; d < k; d++) x[freeCols[d]] = cur[d];
+    for (let i = 0; i < rank; i++) x[pivotOf[i]] = pivVal[i];
+    if (sum < bestSum) {
+      bestSum = sum;
+      bestX = x;
+      return;
+    }
+    const prev = bestX as number[];
+    for (let i = 0; i < M; i++) {
+      if (x[i] !== prev[i]) {
+        if (x[i] < prev[i]) bestX = x;
+        return;
+      }
+    }
+  };
+
+  if (k === 0) {
+    record(baseSum);
+    return bestX;
+  }
+
+  // Seed the incumbent with a greedy descent: at each level take the value
+  // that costs least right there. The result is usually close to optimal, and
+  // a tight bound up front is what makes the pruning below bite.
+  let greedySum = baseSum;
+  for (let d = k - 1; d >= 0; d--) {
+    const upper = acc.subarray((d + 1) * rank, (d + 2) * rank);
+    const lower = acc.subarray(d * rank, (d + 1) * rank);
+    const closeTo = hi[d];
+    const closeFrom = d > 0 ? hi[d - 1] : 0;
+    let bestV = 0;
+    let bestDelta = Infinity;
+    for (let v = 0; v < p; v++) {
+      let delta = v;
+      for (let i = closeFrom; i < closeTo; i++) {
+        let t = (upper[i] - coef[i * k + d] * v) % p;
+        if (t < 0) t += p;
+        delta += t;
+      }
+      if (delta < bestDelta) {
+        bestDelta = delta;
+        bestV = v;
+      }
+    }
+    cur[d] = bestV;
+    for (let i = 0; i < closeTo; i++) {
+      let t = (upper[i] - coef[i * k + d] * bestV) % p;
+      if (t < 0) t += p;
+      lower[i] = t;
+    }
+    for (let i = closeFrom; i < closeTo; i++) pivVal[i] = lower[i];
+    greedySum += bestDelta;
+  }
+  record(greedySum);
+
+  const sums = new Int32Array(p);
+
+  /** Assign free variable `d`, having accumulated `sum` from levels above. */
+  const descend = (d: number, sum: number): void => {
+    const upper = acc.subarray((d + 1) * rank, (d + 2) * rank);
+    const closeTo = hi[d];
+
+    if (d === 0) {
+      // Innermost level: every remaining row closes here, so total the press
+      // counts for all p values at once and only rebuild real contenders.
+      sums.fill(0);
+      for (let i = 0; i < closeTo; i++) {
+        const c = coef[i * k];
+        let x = upper[i];
+        for (let v = 0; v < p; v++) {
+          sums[v] += x;
+          x -= c;
+          if (x < 0) x += p;
+        }
+      }
+      for (let v = 0; v < p; v++) {
+        if (sum + v > bestSum) break;
+        const total = sum + v + sums[v];
+        if (total > bestSum) continue;
+        cur[0] = v;
+        for (let i = 0; i < closeTo; i++) {
+          let t = (upper[i] - coef[i * k] * v) % p;
+          if (t < 0) t += p;
+          pivVal[i] = t;
+        }
+        record(total);
+      }
+      return;
+    }
+
+    const lower = acc.subarray(d * rank, (d + 1) * rank);
+    const closeFrom = hi[d - 1];
+    for (let v = 0; v < p; v++) {
+      if (sum + v > bestSum) break;
+      cur[d] = v;
+      let next = sum + v;
+      if (v === 0) {
+        lower.set(upper.subarray(0, closeTo));
+      } else {
+        for (let i = 0; i < closeTo; i++) {
+          let t = (upper[i] - coef[i * k + d] * v) % p;
+          if (t < 0) t += p;
+          lower[i] = t;
+        }
+      }
+      for (let i = closeFrom; i < closeTo; i++) {
+        pivVal[i] = lower[i];
+        next += lower[i];
+      }
+      if (next > bestSum) continue;
+      descend(d - 1, next);
+    }
+  };
+
+  descend(k - 1, baseSum);
+  return bestX;
+}
