--- /dev/null
+++ b/src/search.ts
@@ -0,0 +1,139 @@
+import Database from 'better-sqlite3';
+import { SearchResult, SuggestResult } from './models.js';
+
+export const PER_PAGE = 20;
+export const SUGGEST_LIMIT = 5;
+
+// Title matches are weighted more heavily than body matches when ranking.
+const BM25_WEIGHTS = 'bm25(notes_fts, 10.0, 1.0)';
+const SNIPPET = `snippet(notes_fts, -1, '<mark>', '</mark>', '…', 32)`;
+
+/**
+ * Creates the FTS5 index over notes(title, body) and the triggers that keep it
+ * in sync with the notes table.
+ */
+export function createSearchIndex(db: Database.Database): void {
+  db.exec(`
+    CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts USING fts5(
+      title,
+      body,
+      content='notes',
+      content_rowid='id'
+    );
+
+    CREATE TRIGGER IF NOT EXISTS notes_ai AFTER INSERT ON notes BEGIN
+      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);
+    END;
+
+    CREATE TRIGGER IF NOT EXISTS notes_ad AFTER DELETE ON notes BEGIN
+      INSERT INTO notes_fts(notes_fts, rowid, title, body)
+      VALUES ('delete', old.id, old.title, old.body);
+    END;
+
+    CREATE TRIGGER IF NOT EXISTS notes_au AFTER UPDATE ON notes BEGIN
+      INSERT INTO notes_fts(notes_fts, rowid, title, body)
+      VALUES ('delete', old.id, old.title, old.body);
+      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);
+    END;
+  `);
+
+  // Pick up any rows that already existed (e.g. an on-disk database created
+  // before the index was introduced).
+  db.exec(`INSERT INTO notes_fts(notes_fts) VALUES ('rebuild')`);
+}
+
+/** Splits text into the same shape of tokens the default FTS5 tokenizer uses. */
+function words(text: string): string[] {
+  return text.toLowerCase().match(/[\p{L}\p{N}_]+/gu) ?? [];
+}
+
+/**
+ * Turns arbitrary user input into a safe FTS5 MATCH expression.
+ *
+ * Double-quoted runs become phrase queries; everything else becomes individual
+ * terms combined with AND. All terms are re-quoted so that punctuation and FTS5
+ * keywords (AND, OR, NOT, NEAR, *, ^, :) can never be interpreted as syntax.
+ * Returns an empty string when the input contains nothing searchable.
+ */
+export function buildMatchQuery(raw: string, prefixLast = false): string {
+  const phrases: string[] = [];
+  const bare: string[] = [];
+
+  let unquoted = '';
+  let cursor = 0;
+  const quoted = /"([^"]*)"/g;
+  let match: RegExpExecArray | null;
+  while ((match = quoted.exec(raw)) !== null) {
+    unquoted += raw.slice(cursor, match.index) + ' ';
+    cursor = quoted.lastIndex;
+    const phrase = words(match[1]);
+    if (phrase.length > 0) {
+      phrases.push(`"${phrase.join(' ')}"`);
+    }
+  }
+  unquoted += raw.slice(cursor);
+
+  for (const word of words(unquoted)) {
+    bare.push(`"${word}"`);
+  }
+
+  if (prefixLast && bare.length > 0) {
+    bare[bare.length - 1] += '*';
+  }
+
+  return [...phrases, ...bare].join(' AND ');
+}
+
+export interface SearchResponse {
+  results: SearchResult[];
+  total: number;
+  page: number;
+  perPage: number;
+}
+
+export function searchNotes(db: Database.Database, q: string, page: number): SearchResponse {
+  const match = buildMatchQuery(q);
+
+  if (match === '') {
+    return { results: [], total: 0, page, perPage: PER_PAGE };
+  }
+
+  const { total } = db
+    .prepare('SELECT COUNT(*) AS total FROM notes_fts WHERE notes_fts MATCH ?')
+    .get(match) as { total: number };
+
+  const results = db
+    .prepare(
+      `SELECT notes_fts.rowid AS id,
+              notes.title AS title,
+              ${SNIPPET} AS snippet,
+              ${BM25_WEIGHTS} AS rank
+         FROM notes_fts
+         JOIN notes ON notes.id = notes_fts.rowid
+        WHERE notes_fts MATCH ?
+        ORDER BY rank
+        LIMIT ? OFFSET ?`
+    )
+    .all(match, PER_PAGE, (page - 1) * PER_PAGE) as SearchResult[];
+
+  return { results, total, page, perPage: PER_PAGE };
+}
+
+export function suggestNotes(db: Database.Database, q: string): SuggestResult[] {
+  const match = buildMatchQuery(q, true);
+
+  if (match === '') {
+    return [];
+  }
+
+  return db
+    .prepare(
+      `SELECT notes_fts.rowid AS id, notes.title AS title
+         FROM notes_fts
+         JOIN notes ON notes.id = notes_fts.rowid
+        WHERE notes_fts MATCH ?
+        ORDER BY ${BM25_WEIGHTS}
+        LIMIT ?`
+    )
+    .all(match, SUGGEST_LIMIT) as SuggestResult[];
+}
