+/**
+ * Operational Transform for plain-text documents.
+ *
+ * Two operation kinds are supported:
+ *   { type: 'insert', position, text }
+ *   { type: 'delete', position, count }
+ *
+ * `transformOperation(op1, op2)` returns op1 rewritten so that it can be
+ * applied to a document that has *already* had op2 applied, where op1 and op2
+ * were both composed against the same original document.
+ */
+
+import type { DeleteOperation, InsertOperation, Operation } from './models.js';
+
+/** Apply an operation to `content`, returning the new content. */
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    const pos = clamp(op.position, 0, content.length);
+    return content.slice(0, pos) + op.text + content.slice(pos);
+  }
+  const pos = clamp(op.position, 0, content.length);
+  const count = clamp(op.count, 0, content.length - pos);
+  if (count === 0) return content;
+  return content.slice(0, pos) + content.slice(pos + count);
+}
+
+/**
+ * Describe why `op` is not a valid operation against a document of
+ * `contentLength` characters. Returns `null` when the operation is valid.
+ */
+export function operationError(op: unknown, contentLength: number): string | null {
+  if (op === null || typeof op !== 'object') {
+    return 'operation must be an object';
+  }
+  const candidate = op as Record<string, unknown>;
+  const type = candidate.type;
+  if (type !== 'insert' && type !== 'delete') {
+    return `unknown operation type: ${String(type)}`;
+  }
+  const position = candidate.position;
+  if (typeof position !== 'number' || !Number.isInteger(position)) {
+    return 'operation position must be an integer';
+  }
+  if (position < 0 || position > contentLength) {
+    return `position ${position} out of bounds (document length ${contentLength})`;
+  }
+  if (type === 'insert') {
+    if (typeof candidate.text !== 'string') {
+      return 'insert operation requires a text string';
+    }
+    return null;
+  }
+  const count = candidate.count;
+  if (typeof count !== 'number' || !Number.isInteger(count) || count < 0) {
+    return 'delete operation requires a non-negative integer count';
+  }
+  if (position + count > contentLength) {
+    return `delete range ${position}..${position + count} out of bounds (document length ${contentLength})`;
+  }
+  return null;
+}
+
+/** Type guard: is `op` a well-formed operation for a document of `contentLength`? */
+export function validateOperation(op: unknown, contentLength: number): op is Operation {
+  return operationError(op, contentLength) === null;
+}
+
+/**
+ * Transform `op1` against the concurrent, already-applied `op2`.
+ * Ties (two inserts at the same position) resolve in favour of `op2`, so the
+ * later-arriving operation lands after the one the server already committed.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    return transformInsertInsert(op1, op2);
+  }
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    return transformInsertDelete(op1, op2);
+  }
+  if (op1.type === 'delete' && op2.type === 'insert') {
+    return transformDeleteInsert(op1, op2);
+  }
+  return transformDeleteDelete(op1 as DeleteOperation, op2 as DeleteOperation);
+}
+
+function transformInsertInsert(op1: InsertOperation, op2: InsertOperation): InsertOperation {
+  if (op2.position <= op1.position) {
+    return { ...op1, position: op1.position + op2.text.length };
+  }
+  return { ...op1 };
+}
+
+function transformInsertDelete(op1: InsertOperation, op2: DeleteOperation): InsertOperation {
+  const end2 = op2.position + op2.count;
+  if (op1.position <= op2.position) {
+    return { ...op1 };
+  }
+  if (op1.position >= end2) {
+    return { ...op1, position: op1.position - op2.count };
+  }
+  // The insertion point was inside the deleted range; collapse to its start.
+  return { ...op1, position: op2.position };
+}
+
+function transformDeleteInsert(op1: DeleteOperation, op2: InsertOperation): DeleteOperation {
+  const end1 = op1.position + op1.count;
+  if (op2.position <= op1.position) {
+    return { ...op1, position: op1.position + op2.text.length };
+  }
+  if (op2.position >= end1) {
+    return { ...op1 };
+  }
+  // Text was inserted inside the range being deleted; widen the deletion.
+  return { ...op1, count: op1.count + op2.text.length };
+}
+
+function transformDeleteDelete(op1: DeleteOperation, op2: DeleteOperation): DeleteOperation {
+  const start1 = op1.position;
+  const end1 = start1 + op1.count;
+  const start2 = op2.position;
+  const end2 = start2 + op2.count;
+
+  if (end2 <= start1) {
+    return { ...op1, position: start1 - op2.count };
+  }
+  if (end1 <= start2) {
+    return { ...op1 };
+  }
+  // Ranges overlap: whatever op2 already removed must not be removed twice.
+  const overlap = Math.min(end1, end2) - Math.max(start1, start2);
+  const removedBefore = Math.max(0, Math.min(end2, start1) - start2);
+  return {
+    ...op1,
+    position: start1 - removedBefore,
+    count: Math.max(0, op1.count - overlap),
+  };
+}
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.min(Math.max(value, min), max);
+}
