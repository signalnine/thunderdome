+import { createServer, type Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import express, { type Express, type NextFunction, type Request, type Response } from 'express';
+import type { WebSocketServer } from 'ws';
+import { createDatabase, type DatabaseHandle } from './db.js';
+import { createRoutes } from './routes.js';
+import { createWebSocketServer } from './ws.js';
+
+export interface AppInstance {
+  app: Express;
+  server: Server;
+  wss: WebSocketServer;
+  db: DatabaseHandle;
+  /** Start listening. Pass 0 (the default) for an OS-assigned port. */
+  start(port?: number): Promise<number>;
+  /** Close every socket, the HTTP server and the database. */
+  stop(): Promise<void>;
+}
+
+export function createApp(dbPath = ':memory:'): AppInstance {
+  const db = createDatabase(dbPath);
+  const app = express();
+  const server = createServer(app);
+  const collab = createWebSocketServer(server, db);
+
+  app.use(express.json({ limit: '10mb' }));
+  app.use(createRoutes(db, { onDocumentChanged: (id) => collab.invalidate(id) }));
+
+  app.use((req: Request, res: Response) => {
+    res.status(404).json({ error: `Not found: ${req.method} ${req.path}` });
+  });
+
+  app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
+    res.status(400).json({ error: err.message });
+  });
+
+  let listening = false;
+  let stopped = false;
+
+  return {
+    app,
+    server,
+    wss: collab.wss,
+    db,
+
+    start(port = 0): Promise<number> {
+      return new Promise((resolve, reject) => {
+        if (listening) {
+          resolve((server.address() as AddressInfo).port);
+          return;
+        }
+        const onError = (err: Error) => reject(err);
+        server.once('error', onError);
+        server.listen(port, () => {
+          server.removeListener('error', onError);
+          listening = true;
+          resolve((server.address() as AddressInfo).port);
+        });
+      });
+    },
+
+    async stop(): Promise<void> {
+      if (stopped) return;
+      stopped = true;
+      await collab.close();
+      if (listening) {
+        await new Promise<void>((resolve) => server.close(() => resolve()));
+        listening = false;
+      }
+      db.close();
+    },
+  };
+}
+
+export default createApp;
diff --git a/src/ws.ts b/src/ws.ts
new file mode 100644
index 0000000..0bf9b0e
--- /dev/null
+++ b/src/ws.ts
@@ -0,0 +1,274 @@
+import { randomUUID } from 'node:crypto';
+import type { IncomingMessage, Server as HttpServer } from 'node:http';
+import { WebSocket, WebSocketServer } from 'ws';
+import type { DatabaseHandle } from './db.js';
+import type { Operation, ServerMessage, VersionRow } from './models.js';
+import { applyOperation, operationError, transformOperation } from './ot.js';
+
+interface Room {
+  documentId: string;
+  /** Current content, always equal to `documents.content` for this row. */
+  content: string;
+  /** Current version number; version 0 is the document as created. */
+  version: number;
+  /** version -> the operation that produced it. */
+  history: Map<number, Operation>;
+  /** version -> content immediately after that version. */
+  contents: Map<number, string>;
+  clients: Set<WebSocket>;
+}
+
+interface Connection {
+  id: string;
+  room: Room;
+}
+
+export interface CollabWebSocketServer {
+  wss: WebSocketServer;
+  /** Drop cached state for a document (after a REST update or delete). */
+  invalidate(documentId: string): void;
+  close(): Promise<void>;
+}
+
+export function createWebSocketServer(
+  server: HttpServer,
+  db: DatabaseHandle
+): CollabWebSocketServer {
+  const wss = new WebSocketServer({ server });
+  const rooms = new Map<string, Room>();
+  const connections = new Map<WebSocket, Connection>();
+  let closed = false;
+
+  const selectDoc = db.prepare('SELECT id, content FROM documents WHERE id = ?');
+  const selectVersions = db.prepare(
+    'SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC'
+  );
+  const updateDoc = db.prepare(
+    "UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?"
+  );
+  const insertVersion = db.prepare(
+    'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+  );
+  const insertConnection = db.prepare(
+    'INSERT INTO active_connections (id, document_id) VALUES (?, ?)'
+  );
+  const deleteConnection = db.prepare('DELETE FROM active_connections WHERE id = ?');
+
+  const commit = db.transaction(
+    (documentId: string, version: number, content: string, operation: string) => {
+      updateDoc.run(content, documentId);
+      insertVersion.run(documentId, version, content, operation);
+    }
+  );
+
+  /** (Re)read a room's content and history from the database. */
+  function hydrate(room: Room): boolean {
+    const doc = selectDoc.get(room.documentId) as { id: string; content: string } | undefined;
+    if (!doc) return false;
+
+    room.content = doc.content;
+    room.version = 0;
+    room.history.clear();
+    room.contents.clear();
+
+    for (const row of selectVersions.all(room.documentId) as VersionRow[]) {
+      room.contents.set(row.version, row.content);
+      if (row.operation) {
+        try {
+          room.history.set(row.version, JSON.parse(row.operation) as Operation);
+        } catch {
+          // A malformed history row must not stop the document from loading.
+        }
+      }
+      if (row.version > room.version) room.version = row.version;
+    }
+    room.contents.set(room.version, room.content);
+    return true;
+  }
+
+  function loadRoom(documentId: string): Room | null {
+    const existing = rooms.get(documentId);
+    if (existing) return existing;
+
+    const room: Room = {
+      documentId,
+      content: '',
+      version: 0,
+      history: new Map(),
+      contents: new Map(),
+      clients: new Set(),
+    };
+    if (!hydrate(room)) return null;
+
+    rooms.set(documentId, room);
+    return room;
+  }
+
+  function send(ws: WebSocket, message: ServerMessage): void {
+    if (ws.readyState !== WebSocket.OPEN) return;
+    ws.send(JSON.stringify(message));
+  }
+
+  function sendError(ws: WebSocket, message: string): void {
+    send(ws, { type: 'error', message });
+  }
+
+  function broadcast(room: Room, sender: WebSocket, message: ServerMessage): void {
+    const payload = JSON.stringify(message);
+    for (const client of room.clients) {
+      if (client === sender) continue;
+      if (client.readyState === WebSocket.OPEN) client.send(payload);
+    }
+  }
+
+  /** Keep an operation inside the bounds of the document it will be applied to. */
+  function normalize(op: Operation, length: number): Operation {
+    const position = Math.min(Math.max(op.position, 0), length);
+    if (op.type === 'insert') return { type: 'insert', position, text: op.text };
+    return {
+      type: 'delete',
+      position,
+      count: Math.min(Math.max(op.count, 0), length - position),
+    };
+  }
+
+  function handleOperation(ws: WebSocket, room: Room, payload: Record<string, unknown>): void {
+    const requested = payload.version;
+    let baseVersion = typeof requested === 'number' ? requested : room.version;
+    if (!Number.isInteger(baseVersion) || baseVersion < 0 || baseVersion > room.version) {
+      baseVersion = room.version;
+    }
+    const baseContent = room.contents.get(baseVersion) ?? room.content;
+
+    const raw = payload.operation;
+    const problem = operationError(raw, baseContent.length);
+    if (problem !== null) {
+      sendError(ws, problem);
+      return;
+    }
+
+    // Rebase the client's operation over everything committed since its base.
+    let op = raw as Operation;
+    for (let v = baseVersion + 1; v <= room.version; v++) {
+      const concurrent = room.history.get(v);
+      if (concurrent) op = transformOperation(op, concurrent);
+    }
+    op = normalize(op, room.content.length);
+
+    const content = applyOperation(room.content, op);
+    const version = room.version + 1;
+
+    try {
+      commit(room.documentId, version, content, JSON.stringify(op));
+    } catch (err) {
+      sendError(ws, `Failed to persist operation: ${(err as Error).message}`);
+      return;
+    }
+
+    room.content = content;
+    room.version = version;
+    room.history.set(version, op);
+    room.contents.set(version, content);
+
+    send(ws, { type: 'ack', version, operation: op });
+    broadcast(room, ws, {
+      type: 'operation',
+      documentId: room.documentId,
+      operation: op,
+      version,
+    });
+  }
+
+  wss.on('connection', (ws: WebSocket, req: IncomingMessage) => {
+    const path = (req.url ?? '/').split('?')[0];
+    let documentId: string;
+    try {
+      documentId = decodeURIComponent(path.replace(/^\/+/, ''));
+    } catch {
+      documentId = path.replace(/^\/+/, '');
+    }
+
+    const room = documentId ? loadRoom(documentId) : null;
+    if (!room) {
+      sendError(ws, `Document not found: ${documentId}`);
+      ws.close();
+      return;
+    }
+
+    const connectionId = randomUUID();
+    room.clients.add(ws);
+    connections.set(ws, { id: connectionId, room });
+    try {
+      insertConnection.run(connectionId, documentId);
+    } catch {
+      // Connection bookkeeping is best-effort; never drop the socket for it.
+    }
+
+    send(ws, {
+      type: 'sync',
+      documentId,
+      content: room.content,
+      version: room.version,
+    });
+
+    ws.on('message', (data) => {
+      let payload: Record<string, unknown>;
+      try {
+        const parsed: unknown = JSON.parse(data.toString());
+        if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
+          throw new Error('message must be a JSON object');
+        }
+        payload = parsed as Record<string, unknown>;
+      } catch (err) {
+        sendError(ws, `Invalid message: ${(err as Error).message}`);
+        return;
+      }
+
+      if (payload.type !== 'operation') {
+        sendError(ws, `Unknown message type: ${String(payload.type)}`);
+        return;
+      }
+
+      try {
+        handleOperation(ws, room, payload);
+      } catch (err) {
+        sendError(ws, `Failed to apply operation: ${(err as Error).message}`);
+      }
+    });
+
+    ws.on('error', () => {
+      // Socket-level errors surface as a close; nothing extra to do here.
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      connections.delete(ws);
+      if (closed) return;
+      try {
+        deleteConnection.run(connectionId);
+      } catch {
+        // The database may already be closing during shutdown.
+      }
+    });
+  });
+
+  return {
+    wss,
+    invalidate(documentId: string) {
+      const room = rooms.get(documentId);
+      if (!room) return;
+      // Keep the live room object so connected sockets stay attached; if the
+      // document is gone, drop the room entirely.
+      if (!hydrate(room)) rooms.delete(documentId);
+    },
+    close() {
+      closed = true;
+      for (const client of wss.clients) {
+        client.terminate();
+      }
+      connections.clear();
+      rooms.clear();
+      return new Promise<void>((resolve) => wss.close(() => resolve()));
+    },
+  };
+}
