+/**
+ * Shared domain types for the collaborative Markdown server.
+ */
+
+/** Insert `text` at `position` (0 <= position <= content.length). */
+export interface InsertOperation {
+  type: 'insert';
+  position: number;
+  text: string;
+}
+
+/** Remove `count` characters starting at `position`. */
+export interface DeleteOperation {
+  type: 'delete';
+  position: number;
+  count: number;
+}
+
+export type Operation = InsertOperation | DeleteOperation;
+
+/** A row of the `documents` table. */
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+/** A row of the `versions` table, with `operation` decoded. */
+export interface Version {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: Operation | null;
+  created_at: string;
+}
+
+/** Raw `versions` row as stored (operation still JSON-encoded). */
+export interface VersionRow {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+/** Messages a client may send over the WebSocket. */
+export interface ClientOperationMessage {
+  type: 'operation';
+  operation: Operation;
+  /** Document version the operation was composed against. */
+  version?: number;
+}
+
+/** Messages the server sends over the WebSocket. */
+export type ServerMessage =
+  | { type: 'sync'; documentId: string; content: string; version: number }
+  | { type: 'ack'; version: number; operation: Operation }
+  | { type: 'operation'; documentId: string; operation: Operation; version: number }
+  | { type: 'error'; message: string };
