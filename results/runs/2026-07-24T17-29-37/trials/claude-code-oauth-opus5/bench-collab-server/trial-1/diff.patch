+import { randomUUID } from 'node:crypto';
+import { Router, type Request, type Response } from 'express';
+import type { DatabaseHandle } from './db.js';
+import type { Document, Operation, Version, VersionRow } from './models.js';
+
+export interface RoutesOptions {
+  /** Called after REST mutations so live WebSocket rooms can re-read state. */
+  onDocumentChanged?: (documentId: string) => void;
+}
+
+function decodeVersion(row: VersionRow): Version {
+  let operation: Operation | null = null;
+  if (row.operation) {
+    try {
+      operation = JSON.parse(row.operation) as Operation;
+    } catch {
+      operation = null;
+    }
+  }
+  return { ...row, operation };
+}
+
+export function createRoutes(db: DatabaseHandle, options: RoutesOptions = {}): Router {
+  const router = Router();
+  const notify = options.onDocumentChanged ?? (() => undefined);
+
+  const insertDoc = db.prepare(
+    'INSERT INTO documents (id, title, content) VALUES (?, ?, ?)'
+  );
+  const insertVersion = db.prepare(
+    'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+  );
+  const selectDoc = db.prepare('SELECT * FROM documents WHERE id = ?');
+  const listDocs = db.prepare('SELECT * FROM documents ORDER BY created_at ASC, id ASC');
+  const deleteDoc = db.prepare('DELETE FROM documents WHERE id = ?');
+  const listVersions = db.prepare(
+    'SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC'
+  );
+  const selectVersion = db.prepare(
+    'SELECT * FROM versions WHERE document_id = ? AND version = ?'
+  );
+  const maxVersion = db.prepare(
+    'SELECT MAX(version) AS version FROM versions WHERE document_id = ?'
+  );
+
+  const createDocument = db.transaction((id: string, title: string, content: string) => {
+    insertDoc.run(id, title, content);
+    insertVersion.run(id, 0, content, null);
+  });
+
+  const updateDocument = db.transaction(
+    (id: string, title: string, content: string, nextVersion: number | null) => {
+      db.prepare(
+        "UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?"
+      ).run(title, content, id);
+      if (nextVersion !== null) {
+        insertVersion.run(id, nextVersion, content, null);
+      }
+    }
+  );
+
+  function getDocument(id: string): Document | undefined {
+    return selectDoc.get(id) as Document | undefined;
+  }
+
+  // POST /docs - create a document
+  router.post('/docs', (req: Request, res: Response) => {
+    const body = (req.body ?? {}) as Record<string, unknown>;
+    const title = typeof body.title === 'string' && body.title.length > 0 ? body.title : 'Untitled';
+    const content = typeof body.content === 'string' ? body.content : '';
+    const id = typeof body.id === 'string' && body.id.length > 0 ? body.id : randomUUID();
+
+    if (getDocument(id)) {
+      res.status(409).json({ error: `Document already exists: ${id}` });
+      return;
+    }
+
+    createDocument(id, title, content);
+    res.status(201).json(getDocument(id));
+  });
+
+  // GET /docs - list documents
+  router.get('/docs', (_req: Request, res: Response) => {
+    res.json(listDocs.all() as Document[]);
+  });
+
+  // GET /docs/:id - fetch one document
+  router.get('/docs/:id', (req: Request, res: Response) => {
+    const doc = getDocument(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: `Document not found: ${req.params.id}` });
+      return;
+    }
+    res.json(doc);
+  });
+
+  // PUT /docs/:id - update title and/or content
+  router.put('/docs/:id', (req: Request, res: Response) => {
+    const id = req.params.id;
+    const doc = getDocument(id);
+    if (!doc) {
+      res.status(404).json({ error: `Document not found: ${id}` });
+      return;
+    }
+
+    const body = (req.body ?? {}) as Record<string, unknown>;
+    const title = typeof body.title === 'string' ? body.title : doc.title;
+    const content = typeof body.content === 'string' ? body.content : doc.content;
+
+    // Replacing the content wholesale creates a new version; a rename does not.
+    let nextVersion: number | null = null;
+    if (content !== doc.content) {
+      const current = maxVersion.get(id) as { version: number | null };
+      nextVersion = (current.version ?? 0) + 1;
+    }
+
+    updateDocument(id, title, content, nextVersion);
+    notify(id);
+    res.json(getDocument(id));
+  });
+
+  // DELETE /docs/:id
+  router.delete('/docs/:id', (req: Request, res: Response) => {
+    const id = req.params.id;
+    if (!getDocument(id)) {
+      res.status(404).json({ error: `Document not found: ${id}` });
+      return;
+    }
+    deleteDoc.run(id);
+    notify(id);
+    res.status(204).end();
+  });
+
+  // GET /docs/:id/versions - full history, oldest first
+  router.get('/docs/:id/versions', (req: Request, res: Response) => {
+    const id = req.params.id;
+    if (!getDocument(id)) {
+      res.status(404).json({ error: `Document not found: ${id}` });
+      return;
+    }
+    res.json((listVersions.all(id) as VersionRow[]).map(decodeVersion));
+  });
+
+  // GET /docs/:id/versions/:version - a single point in history
+  router.get('/docs/:id/versions/:version', (req: Request, res: Response) => {
+    const id = req.params.id;
+    const version = Number(req.params.version);
+    if (!Number.isInteger(version) || version < 0) {
+      res.status(400).json({ error: `Invalid version: ${req.params.version}` });
+      return;
+    }
+    if (!getDocument(id)) {
+      res.status(404).json({ error: `Document not found: ${id}` });
+      return;
+    }
+    const row = selectVersion.get(id, version) as VersionRow | undefined;
+    if (!row) {
+      res.status(404).json({ error: `Version ${version} not found for document ${id}` });
+      return;
+    }
+    res.json(decodeVersion(row));
+  });
+
+  return router;
+}
