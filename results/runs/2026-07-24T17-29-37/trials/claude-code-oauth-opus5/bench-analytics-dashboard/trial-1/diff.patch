+++ b/src/users/repository.ts
@@ -0,0 +1,62 @@
+import { getDb } from '../db';
+import type { UserRole } from '../types';
+
+export interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: UserRole;
+  created_at: string;
+}
+
+/** The user representation returned by the API — never includes the hash. */
+export interface PublicUser {
+  id: string;
+  email: string;
+  tenant_id: string;
+  role: UserRole;
+  created_at: string;
+}
+
+export function toPublicUser(row: UserRow): PublicUser {
+  return {
+    id: row.id,
+    email: row.email,
+    tenant_id: row.tenant_id,
+    role: row.role,
+    created_at: row.created_at,
+  };
+}
+
+export function insertUser(row: UserRow): void {
+  getDb()
+    .prepare(
+      `INSERT INTO users (id, email, password_hash, tenant_id, role, created_at)
+       VALUES (?, ?, ?, ?, ?, ?)`
+    )
+    .run(row.id, row.email, row.password_hash, row.tenant_id, row.role, row.created_at);
+}
+
+export function findUserByEmail(email: string): UserRow | undefined {
+  return getDb().prepare('SELECT * FROM users WHERE email = ?').get(email) as
+    | UserRow
+    | undefined;
+}
+
+export function findUserById(id: string): UserRow | undefined {
+  return getDb().prepare('SELECT * FROM users WHERE id = ?').get(id) as
+    | UserRow
+    | undefined;
+}
+
+/** Scoped by tenant so admins can only ever touch their own tenant's users. */
+export function findUserInTenant(id: string, tenantId: string): UserRow | undefined {
+  return getDb()
+    .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')
+    .get(id, tenantId) as UserRow | undefined;
+}
+
+export function updateUserRole(id: string, role: UserRole): void {
+  getDb().prepare('UPDATE users SET role = ? WHERE id = ?').run(role, id);
+}
diff --git a/src/users/router.ts b/src/users/router.ts
new file mode 100644
index 0000000..0c7bf8d
--- /dev/null
+++ b/src/users/router.ts
@@ -0,0 +1,95 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getAuthUser, requireAuth, signToken } from '../auth';
+import { AuthError, ConflictError, ForbiddenError, NotFoundError, ValidationError } from '../errors';
+import { USER_ROLES } from '../types';
+import { asRecord, requireEnum, requireString } from '../validation';
+import { hashPassword, verifyPassword } from './passwords';
+import {
+  findUserByEmail,
+  findUserById,
+  findUserInTenant,
+  insertUser,
+  toPublicUser,
+  updateUserRole,
+} from './repository';
+
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+const router = Router();
+
+/**
+ * Registration is public. The role is always `viewer` — accepting a role from
+ * the request body would let anyone mint themselves an admin account.
+ */
+router.post('/', (req, res) => {
+  const body = asRecord(req.body);
+  const email = requireString(body, 'email').trim().toLowerCase();
+  const password = requireString(body, 'password');
+  const tenantId = requireString(body, 'tenant_id');
+
+  if (!EMAIL_PATTERN.test(email)) {
+    throw new ValidationError('"email" must be a valid email address');
+  }
+
+  if (findUserByEmail(email)) {
+    throw new ConflictError('A user with that email already exists');
+  }
+
+  const row = {
+    id: uuidv4(),
+    email,
+    password_hash: hashPassword(password),
+    tenant_id: tenantId,
+    role: 'viewer' as const,
+    created_at: new Date().toISOString(),
+  };
+
+  insertUser(row);
+  res.status(201).json(toPublicUser(row));
+});
+
+/** Public. Failures are deliberately indistinguishable to avoid leaking which emails exist. */
+router.post('/login', (req, res) => {
+  const body = asRecord(req.body);
+  const email = requireString(body, 'email').trim().toLowerCase();
+  const password = requireString(body, 'password');
+
+  const user = findUserByEmail(email);
+  if (!user || !verifyPassword(password, user.password_hash)) {
+    throw new AuthError('Invalid email or password');
+  }
+
+  const token = signToken({ id: user.id, tenantId: user.tenant_id });
+  res.json({ token, user: toPublicUser(user) });
+});
+
+router.get('/me', requireAuth, (req, res) => {
+  const auth = getAuthUser(req);
+  const user = findUserById(auth.id);
+  if (!user) {
+    throw new NotFoundError('User not found');
+  }
+  res.json(toPublicUser(user));
+});
+
+/** Admin-only, and only within the caller's own tenant. */
+router.patch('/:id/role', requireAuth, (req, res) => {
+  const auth = getAuthUser(req);
+  const role = requireEnum(asRecord(req.body), 'role', USER_ROLES);
+
+  const actor = findUserById(auth.id);
+  if (!actor || actor.role !== 'admin') {
+    throw new ForbiddenError('Only admins may change user roles');
+  }
+
+  const target = findUserInTenant(req.params.id, actor.tenant_id);
+  if (!target) {
+    throw new NotFoundError('User not found');
+  }
+
+  updateUserRole(target.id, role);
+  res.json(toPublicUser({ ...target, role }));
+});
+
+export default router;
diff --git a/src/validation.ts b/src/validation.ts
new file mode 100644
index 0000000..7282ac1
--- /dev/null
+++ b/src/validation.ts
@@ -0,0 +1,113 @@
+import { ValidationError } from './errors';
+
+/** Narrows an untrusted request body to a plain object. */
+export function asRecord(
+  value: unknown,
+  message = 'Request body must be a JSON object'
+): Record<string, unknown> {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    throw new ValidationError(message);
+  }
+  return value as Record<string, unknown>;
+}
+
+export function requireString(source: Record<string, unknown>, field: string): string {
+  const value = source[field];
+  if (typeof value !== 'string' || value.trim() === '') {
+    throw new ValidationError(`"${field}" is required and must be a non-empty string`);
+  }
+  return value;
+}
+
+export function optionalString(
+  source: Record<string, unknown>,
+  field: string
+): string | undefined {
+  const value = source[field];
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  if (typeof value !== 'string') {
+    throw new ValidationError(`"${field}" must be a string`);
+  }
+  return value;
+}
+
+export function optionalObject(
+  source: Record<string, unknown>,
+  field: string
+): Record<string, unknown> | undefined {
+  const value = source[field];
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  return asRecord(value, `"${field}" must be an object`);
+}
+
+export function optionalEnum<T extends string>(
+  source: Record<string, unknown>,
+  field: string,
+  allowed: readonly T[]
+): T | undefined {
+  const value = source[field];
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  if (typeof value !== 'string' || !allowed.includes(value as T)) {
+    throw new ValidationError(`"${field}" must be one of: ${allowed.join(', ')}`);
+  }
+  return value as T;
+}
+
+export function requireEnum<T extends string>(
+  source: Record<string, unknown>,
+  field: string,
+  allowed: readonly T[]
+): T {
+  const value = optionalEnum(source, field, allowed);
+  if (value === undefined) {
+    throw new ValidationError(`"${field}" must be one of: ${allowed.join(', ')}`);
+  }
+  return value;
+}
+
+export function optionalInteger(
+  source: Record<string, unknown>,
+  field: string
+): number | undefined {
+  const value = source[field];
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  if (typeof value !== 'number' || !Number.isInteger(value)) {
+    throw new ValidationError(`"${field}" must be an integer`);
+  }
+  return value;
+}
+
+/**
+ * Validates an ISO-8601-ish timestamp without rewriting it: ingestion echoes
+ * back exactly what the caller sent, and SQLite's `datetime()` normalises the
+ * value at query time.
+ */
+export function assertTimestamp(value: string, field: string): string {
+  if (Number.isNaN(new Date(value).getTime())) {
+    throw new ValidationError(`"${field}" must be a valid ISO-8601 timestamp`);
+  }
+  return value;
+}
+
+const PROPERTY_KEY_PATTERN = /^[A-Za-z0-9_][A-Za-z0-9_-]*$/;
+
+/**
+ * Property keys are interpolated into a JSON path, so restrict them to a safe
+ * character set rather than trusting caller input.
+ */
+export function assertPropertyKey(key: string): string {
+  if (!PROPERTY_KEY_PATTERN.test(key)) {
+    throw new ValidationError(
+      'Property keys may only contain letters, digits, underscores and hyphens'
+    );
+  }
+  return key;
+}
