index 0000000..1f91f7b
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,88 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import Database from 'better-sqlite3';
+
+/**
+ * Single shared connection. Tests swap in an in-memory database via `setDb`,
+ * so every module must go through `getDb()` rather than caching a handle.
+ */
+let connection: Database.Database | null = null;
+
+const SCHEMA_FILE = 'schema.sql';
+const MAX_LOOKUP_DEPTH = 6;
+
+/**
+ * `schema.sql` is the single source of truth for the table definitions. Look it
+ * up by walking upwards from the working directory (and from this module's
+ * directory when running as CommonJS) so it resolves both from `src/` under the
+ * test runner and from `dist/` after a build.
+ */
+function findSchemaFile(): string {
+  const roots = [process.cwd()];
+  if (typeof __dirname === 'string') {
+    roots.push(__dirname);
+  }
+
+  for (const root of roots) {
+    let dir = path.resolve(root);
+    for (let depth = 0; depth < MAX_LOOKUP_DEPTH; depth += 1) {
+      const candidate = path.join(dir, SCHEMA_FILE);
+      if (fs.existsSync(candidate)) {
+        return candidate;
+      }
+      const parent = path.dirname(dir);
+      if (parent === dir) {
+        break;
+      }
+      dir = parent;
+    }
+  }
+
+  throw new Error(`Could not locate ${SCHEMA_FILE} starting from ${process.cwd()}`);
+}
+
+let cachedSchema: string | null = null;
+
+function readSchema(): string {
+  if (cachedSchema === null) {
+    cachedSchema = fs.readFileSync(findSchemaFile(), 'utf8');
+  }
+  return cachedSchema;
+}
+
+/** Applies the schema to a database. Safe to call repeatedly (IF NOT EXISTS). */
+export function applySchema(target: Database.Database): void {
+  target.exec(readSchema());
+}
+
+function configure(target: Database.Database): Database.Database {
+  // Needed for the widgets -> dashboards ON DELETE CASCADE to fire.
+  target.pragma('foreign_keys = ON');
+  return target;
+}
+
+/** Fresh in-memory database with the schema applied — used by the tests. */
+export function createTestDb(): Database.Database {
+  const testDb = configure(new Database(':memory:'));
+  applySchema(testDb);
+  return testDb;
+}
+
+export function setDb(next: Database.Database): void {
+  connection = next;
+}
+
+export function getDb(): Database.Database {
+  if (connection === null) {
+    connection = configure(new Database(process.env.DB_PATH ?? 'analytics.db'));
+    applySchema(connection);
+  }
+  return connection;
+}
+
+export function closeDb(): void {
+  if (connection !== null) {
+    connection.close();
+    connection = null;
+  }
+}
