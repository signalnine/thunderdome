+import { Router } from 'express';
+import type { Request } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getAuthUser, requireAuth } from '../auth';
+import { NotFoundError, ValidationError } from '../errors';
+import { WIDGET_TYPES } from '../types';
+import {
+  asRecord,
+  optionalInteger,
+  optionalObject,
+  optionalString,
+  requireEnum,
+  requireString,
+} from '../validation';
+import {
+  deleteDashboard,
+  deleteWidget,
+  findDashboard,
+  findWidget,
+  insertDashboard,
+  insertWidget,
+  listDashboards,
+  listWidgets,
+  toApiDashboard,
+  toApiWidget,
+  updateDashboard,
+  updateWidget,
+  type DashboardRow,
+  type WidgetChanges,
+} from './repository';
+
+const router = Router();
+
+router.use(requireAuth);
+
+/** Resolves a dashboard within the caller's tenant or 404s. */
+function requireDashboard(req: Request, id: string): DashboardRow {
+  const auth = getAuthUser(req);
+  const dashboard = findDashboard(id, auth.tenantId);
+  if (!dashboard) {
+    throw new NotFoundError('Dashboard not found');
+  }
+  return dashboard;
+}
+
+router.post('/', (req, res) => {
+  const auth = getAuthUser(req);
+  const body = asRecord(req.body);
+  const now = new Date().toISOString();
+
+  const row: DashboardRow = {
+    id: uuidv4(),
+    tenant_id: auth.tenantId,
+    name: requireString(body, 'name'),
+    owner_id: auth.id,
+    config: JSON.stringify(optionalObject(body, 'config') ?? {}),
+    created_at: now,
+    updated_at: now,
+  };
+
+  insertDashboard(row);
+  res.status(201).json(toApiDashboard(row));
+});
+
+router.get('/', (req, res) => {
+  const auth = getAuthUser(req);
+  res.json(listDashboards(auth.tenantId).map(toApiDashboard));
+});
+
+router.get('/:id', (req, res) => {
+  const dashboard = requireDashboard(req, req.params.id);
+  res.json({
+    ...toApiDashboard(dashboard),
+    widgets: listWidgets(dashboard.id).map(toApiWidget),
+  });
+});
+
+router.patch('/:id', (req, res) => {
+  const dashboard = requireDashboard(req, req.params.id);
+  const body = asRecord(req.body);
+
+  const name = optionalString(body, 'name');
+  const config = optionalObject(body, 'config');
+  if (name === undefined && config === undefined) {
+    throw new ValidationError('Provide "name" and/or "config" to update');
+  }
+  if (name !== undefined && name.trim() === '') {
+    throw new ValidationError('"name" must be a non-empty string');
+  }
+
+  const updated: DashboardRow = {
+    ...dashboard,
+    name: name ?? dashboard.name,
+    config: config === undefined ? dashboard.config : JSON.stringify(config),
+    updated_at: new Date().toISOString(),
+  };
+
+  updateDashboard(dashboard.id, {
+    name,
+    config: config === undefined ? undefined : updated.config,
+    updated_at: updated.updated_at,
+  });
+
+  res.json(toApiDashboard(updated));
+});
+
+router.delete('/:id', (req, res) => {
+  const auth = getAuthUser(req);
+  if (!deleteDashboard(req.params.id, auth.tenantId)) {
+    throw new NotFoundError('Dashboard not found');
+  }
+  res.status(204).send();
+});
+
+// --- Widgets -------------------------------------------------------------
+
+router.get('/:id/widgets', (req, res) => {
+  const dashboard = requireDashboard(req, req.params.id);
+  res.json(listWidgets(dashboard.id).map(toApiWidget));
+});
+
+router.post('/:id/widgets', (req, res) => {
+  const dashboard = requireDashboard(req, req.params.id);
+  const body = asRecord(req.body);
+
+  const row = {
+    id: uuidv4(),
+    dashboard_id: dashboard.id,
+    type: requireEnum(body, 'type', WIDGET_TYPES),
+    config: JSON.stringify(optionalObject(body, 'config') ?? {}),
+    position_x: optionalInteger(body, 'position_x') ?? 0,
+    position_y: optionalInteger(body, 'position_y') ?? 0,
+    width: optionalInteger(body, 'width') ?? 1,
+    height: optionalInteger(body, 'height') ?? 1,
+  };
+
+  insertWidget(row);
+  res.status(201).json(toApiWidget(row));
+});
+
+router.patch('/:id/widgets/:widgetId', (req, res) => {
+  const dashboard = requireDashboard(req, req.params.id);
+  const widget = findWidget(req.params.widgetId, dashboard.id);
+  if (!widget) {
+    throw new NotFoundError('Widget not found');
+  }
+
+  const body = asRecord(req.body);
+  const config = optionalObject(body, 'config');
+  const changes: WidgetChanges = {
+    type: body.type === undefined ? undefined : requireEnum(body, 'type', WIDGET_TYPES),
+    config: config === undefined ? undefined : JSON.stringify(config),
+    position_x: optionalInteger(body, 'position_x'),
+    position_y: optionalInteger(body, 'position_y'),
+    width: optionalInteger(body, 'width'),
+    height: optionalInteger(body, 'height'),
+  };
+
+  updateWidget(widget.id, changes);
+
+  res.json(
+    toApiWidget({
+      ...widget,
+      type: changes.type ?? widget.type,
+      config: changes.config ?? widget.config,
+      position_x: changes.position_x ?? widget.position_x,
+      position_y: changes.position_y ?? widget.position_y,
+      width: changes.width ?? widget.width,
+      height: changes.height ?? widget.height,
+    })
+  );
+});
+
+router.delete('/:id/widgets/:widgetId', (req, res) => {
+  const dashboard = requireDashboard(req, req.params.id);
+  if (!deleteWidget(req.params.widgetId, dashboard.id)) {
+    throw new NotFoundError('Widget not found');
+  }
+  res.status(204).send();
+});
+
+export default router;
