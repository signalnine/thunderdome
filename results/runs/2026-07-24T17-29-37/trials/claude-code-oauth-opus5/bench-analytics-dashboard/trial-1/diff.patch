--- /dev/null
+++ b/src/export/router.ts
@@ -0,0 +1,102 @@
+import { Router } from 'express';
+import type { Request } from 'express';
+import { getAuthUser, requireAuth } from '../auth';
+import { NotFoundError, ValidationError } from '../errors';
+import { EVENT_COLUMNS, toApiEvent } from '../events';
+import {
+  findDashboard,
+  listWidgets,
+  toApiDashboard,
+  toApiWidget,
+} from '../dashboards/repository';
+import { assertTimestamp } from '../validation';
+import { toCsv } from './csv';
+import { selectEvents } from './repository';
+
+const EXPORT_FORMATS = ['json', 'csv'] as const;
+type ExportFormat = (typeof EXPORT_FORMATS)[number];
+
+const DEFAULT_LIMIT = 10000;
+const MAX_LIMIT = 100000;
+
+const router = Router();
+
+router.use(requireAuth);
+
+function queryParam(req: Request, name: string): string | undefined {
+  const value = req.query[name];
+  if (value === undefined) {
+    return undefined;
+  }
+  if (typeof value !== 'string') {
+    throw new ValidationError(`"${name}" must be a single value`);
+  }
+  return value;
+}
+
+function parseFormat(req: Request): ExportFormat {
+  const format = queryParam(req, 'format') ?? 'json';
+  if (!EXPORT_FORMATS.includes(format as ExportFormat)) {
+    throw new ValidationError(
+      `"format" must be one of: ${EXPORT_FORMATS.join(', ')}`
+    );
+  }
+  return format as ExportFormat;
+}
+
+function parseLimit(req: Request): number {
+  const raw = queryParam(req, 'limit');
+  if (raw === undefined) {
+    return DEFAULT_LIMIT;
+  }
+  const limit = Number.parseInt(raw, 10);
+  if (!Number.isInteger(limit) || limit < 1 || limit > MAX_LIMIT) {
+    throw new ValidationError(`"limit" must be an integer between 1 and ${MAX_LIMIT}`);
+  }
+  return limit;
+}
+
+function parseBound(req: Request, name: string): string | undefined {
+  const value = queryParam(req, name);
+  return value === undefined ? undefined : assertTimestamp(value, name);
+}
+
+router.get('/events', (req, res) => {
+  const auth = getAuthUser(req);
+  const format = parseFormat(req);
+
+  const rows = selectEvents(
+    {
+      tenantId: auth.tenantId,
+      eventName: queryParam(req, 'event_name'),
+      start: parseBound(req, 'start'),
+      end: parseBound(req, 'end'),
+    },
+    parseLimit(req)
+  );
+
+  if (format === 'csv') {
+    res.type('text/csv');
+    res.setHeader('Content-Disposition', 'attachment; filename="events.csv"');
+    res.send(toCsv(rows, EVENT_COLUMNS));
+    return;
+  }
+
+  res.json(rows.map(toApiEvent));
+});
+
+router.get('/dashboard/:id', (req, res) => {
+  const auth = getAuthUser(req);
+  const dashboard = findDashboard(req.params.id, auth.tenantId);
+  if (!dashboard) {
+    throw new NotFoundError('Dashboard not found');
+  }
+
+  res.json({
+    dashboard: toApiDashboard(dashboard),
+    widgets: listWidgets(dashboard.id).map(toApiWidget),
+    exported_at: new Date().toISOString(),
+  });
+});
+
+export default router;
diff --git a/src/ingest/repository.ts b/src/ingest/repository.ts
new file mode 100644
index 0000000..e380622
--- /dev/null
+++ b/src/ingest/repository.ts
@@ -0,0 +1,29 @@
+import { getDb } from '../db';
+import type { EventRow } from '../events';
+
+const INSERT_SQL = `
+  INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+  VALUES (?, ?, ?, ?, ?, ?, ?)
+`;
+
+/** Inserts every event atomically — a partial batch is never persisted. */
+export function insertEvents(rows: EventRow[]): void {
+  const db = getDb();
+  const statement = db.prepare(INSERT_SQL);
+
+  const insertAll = db.transaction((batch: EventRow[]) => {
+    for (const row of batch) {
+      statement.run(
+        row.id,
+        row.tenant_id,
+        row.name,
+        row.properties,
+        row.timestamp,
+        row.user_id,
+        row.session_id
+      );
+    }
+  });
+
+  insertAll(rows);
+}
diff --git a/src/ingest/router.ts b/src/ingest/router.ts
new file mode 100644
index 0000000..f9f40ab
--- /dev/null
+++ b/src/ingest/router.ts
@@ -0,0 +1,73 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getAuthUser, requireAuth } from '../auth';
+import { ValidationError } from '../errors';
+import { toApiEvent, type EventRow } from '../events';
+import type { AuthUser } from '../types';
+import { asRecord, assertTimestamp, optionalObject, optionalString } from '../validation';
+import { insertEvents } from './repository';
+
+const MAX_BATCH_SIZE = 1000;
+
+const router = Router();
+
+router.use(requireAuth);
+
+/**
+ * Builds a storable row from untrusted input. `tenant_id` always comes from the
+ * auth context, never from the payload, so a caller cannot write into another
+ * tenant. The timestamp is stored verbatim (queries normalise it with SQLite's
+ * `datetime()`) so exports round-trip exactly what was ingested.
+ */
+function parseEvent(input: unknown, auth: AuthUser): EventRow {
+  const body = asRecord(input, 'Each event must be a JSON object');
+  const name = requireEventName(body);
+  const properties = optionalObject(body, 'properties') ?? {};
+  const timestamp = optionalString(body, 'timestamp');
+
+  return {
+    id: uuidv4(),
+    tenant_id: auth.tenantId,
+    name,
+    properties: JSON.stringify(properties),
+    timestamp: timestamp
+      ? assertTimestamp(timestamp, 'timestamp')
+      : new Date().toISOString(),
+    user_id: optionalString(body, 'user_id') ?? auth.id,
+    session_id: optionalString(body, 'session_id') ?? null,
+  };
+}
+
+function requireEventName(body: Record<string, unknown>): string {
+  const name = body.name;
+  if (typeof name !== 'string' || name.trim() === '') {
+    throw new ValidationError('"name" is required and must be a non-empty string');
+  }
+  return name;
+}
+
+router.post('/', (req, res) => {
+  const event = parseEvent(req.body, getAuthUser(req));
+  insertEvents([event]);
+  res.status(201).json(toApiEvent(event));
+});
+
+router.post('/batch', (req, res) => {
+  const auth = getAuthUser(req);
+  const { events } = asRecord(req.body);
+
+  if (!Array.isArray(events) || events.length === 0) {
+    throw new ValidationError('"events" must be a non-empty array');
+  }
+  if (events.length > MAX_BATCH_SIZE) {
+    throw new ValidationError(`"events" may contain at most ${MAX_BATCH_SIZE} entries`);
+  }
+
+  // Validate the whole batch before writing anything.
+  const rows = events.map((event) => parseEvent(event, auth));
+  insertEvents(rows);
+
+  res.status(201).json({ inserted: rows.length, events: rows.map(toApiEvent) });
+});
+
+export default router;
