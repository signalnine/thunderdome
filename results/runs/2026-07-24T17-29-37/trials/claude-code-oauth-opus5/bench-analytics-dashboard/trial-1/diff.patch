;\n\n    const forbidden = await request(app)\n      .patch(`/users/${targetId}/role`).set('Authorization', `Bearer ${tokenA}`).send({ role: 'editor' });\n    expect(forbidden.status).toBe(403);\n    expect(forbidden.body.code).toBe('FORBIDDEN');\n\n    // Promote an admin in tenant t2, then try to touch a t1 user.\n    const tokenB = await login('admin@t.com', 't2');\n    db.prepare(\"UPDATE users SET role='admin' WHERE email='admin@t.com'\").run();\n    const crossTenant = await request(app)\n      .patch(`/users/${targetId}/role`).set('Authorization', `Bearer ${tokenB}`).send({ role: 'admin' });\n    expect(crossTenant.status).toBe(404);\n\n    // Invalid role value\n    const bad = await request(app)\n      .patch(`/users/${targetId}/role`).set('Authorization', `Bearer ${tokenB}`).send({ role: 'superuser' });\n    expect(bad.status).toBe(400);\n  });\n\n  it('cannot spoof tenant_id via the ingest payload', async () => {\n    const token = await login('spoof@t.com', 't1');\n    const res = await request(app).post('/events').set('Authorization', `Bearer ${token}`)\n      .send({ name: 'e', tenant_id: 'other-tenant' });\n    expect(res.body.tenant_id).toBe('t1');\n  });\n\n  it('rolls back the whole batch when one event is invalid', async () => {\n    const token = await login('batch@t.com', 't1');\n    const res = await request(app).post('/events/batch').set('Authorization', `Bearer ${token}`)\n      .send({ events: [{ name: 'ok' }, { properties: {} }] });\n    expect(res.status).toBe(400);\n    const count = db.prepare('SELECT COUNT(*) c FROM events').get() as { c: number };\n    expect(count.c).toBe(0);\n  });\n\n  it('orders funnel steps correctly and does not count out-of-order sessions', async () => {\n    const token = await login('fun@t.com', 't1');\n    const ins = db.prepare('INSERT INTO events (id, tenant_id, name, properties, timestamp, session_id) VALUES (?,?,?,?,?,?)');\n    // s1: correct order -> completes all 3\n    ins.run(uuidv4(), 't1', 'a', '{}', '2024-01-01T10:00:00Z', 's1');\n    ins.run(uuidv4(), 't1', 'b', '{}', '2024-01-01T10:01:00Z', 's1');\n    ins.run(uuidv4(), 't1', 'c', '{}', '2024-01-01T10:02:00Z', 's1');\n    // s2: c before b -> only reaches step 1... then b never after? b absent entirely\n    ins.run(uuidv4(), 't1', 'a', '{}', '2024-01-01T10:00:00Z', 's2');\n    ins.run(uuidv4(), 't1', 'c', '{}', '2024-01-01T10:01:00Z', 's2');\n    // s3: b then a -> reaches step 1 only (a comes second, b already passed)\n    ins.run(uuidv4(), 't1', 'b', '{}', '2024-01-01T10:00:00Z', 's3');\n    ins.run(uuidv4(), 't1', 'a', '{}', '2024-01-01T10:01:00Z', 's3');\n\n    const res = await request(app).post('/query/funnel').set('Authorization', `Bearer ${token}`)\n      .send({ steps: ['a', 'b', 'c'] });\n    expect(res.body.steps.map((s: { count: number }) => s.count)).toEqual([3, 1, 1]);\n    expect(res.body.steps[0].conversion_rate).toBe(1);\n  });\n\n  it('buckets timestamps written in either SQLite or ISO format', async () => {\n    const token = await login('ts@t.com', 't1');\n    const ins = db.prepare('INSERT INTO events (id, tenant_id, name, properties, timestamp) VALUES (?,?,?,?,?)');\n    ins.run(uuidv4(), 't1', 'v', '{}', '2024-03-05T08:15:00Z');      // ISO w/ Z\n    ins.run(uuidv4(), 't1', 'v', '{}', '2024-03-05 09:45:00');       // SQLite datetime()\n    ins.run(uuidv4(), 't1', 'v', '{}', '2024-03-06T01:00:00.000Z');  // ISO w/ millis\n\n    const day = await request(app).post('/query/timeseries').set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'v', bucket: 'day' });\n    expect(day.body.data).toEqual([\n      { bucket: '2024-03-05T00:00:00Z', count: 2 },\n      { bucket: '2024-03-06T00:00:00Z', count: 1 },\n    ]);\n\n    // Range filter must span both formats.\n    const counted = await request(app).post('/query/count').set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'v', start: '2024-03-05T00:00:00Z', end: '2024-03-05T23:59:59Z' });\n    expect(counted.body.count).toBe(2);\n\n    // Week buckets key on Monday (2024-03-04).\n    const week = await request(app).post('/query/timeseries').set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'v', bucket: 'week' });\n    expect(week.body.data).toEqual([{ bucket: '2024-03-04T00:00:00Z', count: 3 }]);\n  });\n\n  it('escapes CSV fields containing commas, quotes and newlines', async () => {\n    const token = await login('csv@t.com', 't1');\n    await request(app).post('/events').set('Authorization', `Bearer ${token}`)\n      .send({ name: 'weird', properties: { note: 'a,b \"quoted\"\\nnext' } });\n\n    const res = await request(app).get('/export/events?format=csv').set('Authorization', `Bearer ${token}`);\n    expect(res.status).toBe(200);\n    // The embedded newline must live inside a quoted field, not create a new record.\n    const quoted = res.text.match(/\"(?:[^\"]|\"\")*\"/);\n    expect(quoted).not.toBeNull();\n    expect(quoted![0]).toContain('\"\"quoted\"\"');\n    expect(quoted![0]).toContain('\\n');\n  });\n\n  it('applies property filters and breakdown limits', async () => {\n    const token = await login('filt@t.com', 't1');\n    await request(app).post('/events/batch').set('Authorization', `Bearer ${token}`).send({\n      events: [\n        { name: 'pv', properties: { page: '/a', ok: true } },\n        { name: 'pv', properties: { page: '/a', ok: false } },\n        { name: 'pv', properties: { page: '/b', ok: true } },\n      ],\n    });\n\n    const filtered = await request(app).post('/query/count').set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'pv', filters: { page: '/a' } });\n    expect(filtered.body.count).toBe(2);\n\n    const boolFiltered = await request(app).post('/query/count').set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'pv', filters: { ok: true } });\n    expect(boolFiltered.body.count).toBe(2);\n\n    const limited = await request(app).post('/query/breakdown').set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'pv', property_key: 'page', limit: 1 });\n    expect(limited.body.data).toEqual([{ property_value: '/a', count: 2 }]);\n\n    // JSON-path injection attempt must be rejected, not executed.\n    const bad = await request(app).post('/query/breakdown').set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'pv', property_key: 'page\"] OR 1=1 --' });\n    expect(bad.status).toBe(400);\n  });\n\n  it('cascades widget deletion and 404s unknown routes consistently', async () => {\n    const token = await login('cas@t.com', 't1');\n    const dash = await request(app).post('/dashboards').set('Authorization', `Bearer ${token}`).send({ name: 'd' });\n    await request(app).post(`/dashboards/${dash.body.id}/widgets`).set('Authorization', `Bearer ${token}`)\n      .send({ type: 'counter', config: {} });\n\n    await request(app).delete(`/dashboards/${dash.body.id}`).set('Authorization', `Bearer ${token}`);\n    const widgets = db.prepare('SELECT COUNT(*) c FROM widgets').get() as { c: number };\n    expect(widgets.c).toBe(0);\n\n    const unknown = await request(app).get('/nope').set('Authorization', `Bearer ${token}`);\n    expect(unknown.status).toBe(404);\n    expect(unknown.body).toHaveProperty('error');\n    expect(unknown.body).toHaveProperty('code');\n  });\n\n  it('rejects tampered and expired tokens', async () => {\n    const token = await login('tamper@t.com', 't1');\n    const parts = token.split('.');\n    const forged = `${parts[0]}.${Buffer.from(JSON.stringify({ sub: 'x', tid: 'other' })).toString('base64url')}.${parts[2]}`;\n\n    const res = await request(app).get('/users/me').set('Authorization', `Bearer ${forged}`);\n    expect(res.status).toBe(401);\n    expect(res.body.code).toBe('AUTH_ERROR');\n\n    const malformed = await request(app).get('/users/me').set('Authorization', token); // no scheme\n    expect(malformed.status).toBe(401);\n    expect(malformed.body.code).toBe('AUTH_ERROR');\n  });\n});\n","structured