@@ -0,0 +1,18 @@
+import { getDb } from '../db';
+import type { EventRow } from '../events';
+import { buildEventWhere, type EventFilter } from '../query/filters';
+
+/** Chronological event dump for a tenant, reusing the shared filter builder. */
+export function selectEvents(filter: EventFilter, limit: number): EventRow[] {
+  const { clause, params } = buildEventWhere(filter);
+
+  return getDb()
+    .prepare(
+      `SELECT id, tenant_id, name, properties, timestamp, user_id, session_id
+         FROM events
+        WHERE ${clause}
+     ORDER BY datetime(timestamp) ASC, rowid ASC
+        LIMIT ?`
+    )
+    .all(...params, limit) as EventRow[];
+}
