t decoded = jwt.decode(token) as Record<string, unknown>;\n55\t\n56\t    expect(decoded).toHaveProperty('sub');\n57\t    expect(decoded).toHaveProperty('tid');\n58\t    expect(decoded).toHaveProperty('iat');\n59\t    expect(decoded).toHaveProperty('exp');\n60\t    expect(decoded.tid).toBe(TENANT_A);\n61\t  });\n62\t\n63\t  // --- Auth Error Format Consistency (2 tests) ---\n64\t\n65\t  it('should return consistent error format for missing auth', async () => {\n66\t    const endpoints = [\n67\t      { method: 'get' as const, url: '/users/me' },\n68\t      { method: 'post' as const, url: '/events' },\n69\t      { method: 'post' as const, url: '/query/count' },\n70\t      { method: 'get' as const, url: '/dashboards' },\n71\t      { method: 'get' as const, url: '/export/events?format=json' },\n72\t    ];\n73\t\n74\t    for (const ep of endpoints) {\n75\t      const res = await request(app)[ep.method](ep.url);\n76\t      expect(res.status).toBe(401);\n77\t      expect(res.body).toHaveProperty('error');\n78\t      expect(res.body).toHaveProperty('code');\n79\t      expect(typeof res.body.error).toBe('string');\n80\t      expect(typeof res.body.code).toBe('string');\n81\t    }\n82\t  });\n83\t\n84\t  it('should return consistent error format for invalid token', async () => {\n85\t    const endpoints = [\n86\t      { method: 'get' as const, url: '/users/me' },\n87\t      { method: 'post' as const, url: '/events' },\n88\t      { method: 'get' as const, url: '/dashboards' },\n89\t    ];\n90\t\n91\t    for (const ep of endpoints) {\n92\t      const res = await request(app)\n93\t        [ep.method](ep.url)\n94\t        .set('Authorization', 'Bearer invalid-token-here');\n95\t\n96\t      expect(res.status).toBe(401);\n97\t      expect(res.body).toHaveProperty('error');\n98\t      expect(res.body).toHaveProperty('code');\n99\t      expect(res.body.code).toBe('AUTH_ERROR');\n100\t    }\n101\t  });\n102\t\n103\t  // --- Ingest with Real Auth (2 tests) ---\n104\t\n105\t  it('should ingest a single event with real JWT', async () => {\n106\t    const token = await registerAndLogin(app, 'ingest@test.com', 'pass', TENANT_A);\n107\t\n108\t    const res = await request(app)\n109\t      .post('/events')\n110\t      .set('Authorization', `Bearer ${token}`)\n111\t      .send({ name: 'page_view', properties: { page: '/home' } });\n112\t\n113\t    expect(res.status).toBe(201);\n114\t    expect(res.body.name).toBe('page_view');\n115\t    expect(res.body.tenant_id).toBe(TENANT_A);\n116\t  });\n117\t\n118\t  it('should ingest batch events with real JWT', async () => {\n119\t    const token = await registerAndLogin(app, 'batch@test.com', 'pass', TENANT_A);\n120\t\n121\t    const res = await request(app)\n122\t      .post('/events/batch')\n123\t      .set('Authorization', `Bearer ${token}`)\n124\t      .send({\n125\t        events: [\n126\t          { name: 'view', properties: { p: '1' } },\n127\t          { name: 'click', properties: { p: '2' } },\n128\t        ],\n129\t      });\n130\t\n131\t    expect(res.status).toBe(201);\n132\t    expect(res.body.inserted).toBe(2);\n133\t  });\n134\t\n135\t  // --- Query with Real Auth + Tenant Isolation (3 tests) ---\n136\t\n137\t  it('should query event count with real JWT', async () => {\n138\t    const token = await registerAndLogin(app, 'q@test.com', 'pass', TENANT_A);\n139\t\n140\t    // Ingest events\n141\t    await request(app)\n142\t      .post('/events/batch')\n143\t      .set('Authorization', `Bearer ${token}`)\n144\t      .send({\n145\t        events: [\n146\t          { name: 'page_view' },\n147\t          { name: 'page_view' },\n148\t          { name: 'click' },\n149\t        ],\n150\t      });\n151\t\n152\t    const res = await request(app)\n153\t      .post('/query/count')\n154\t      .set('Authorization', `Bearer ${token}`)\n155\t      .send({ event_name: 'page_view' });\n156\t\n157\t    expect(res.status).toBe(200);\n158\t    expect(res.body.count).toBe(2);\n159\t  });\n160\t\n161\t  it('should return 