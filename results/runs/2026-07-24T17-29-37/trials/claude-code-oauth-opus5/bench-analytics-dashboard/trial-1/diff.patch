+import { getDb } from '../db';
+import type { WidgetType } from '../types';
+
+export interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  /** JSON-encoded object as stored in SQLite. */
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: WidgetType;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+export type ApiDashboard = Omit<DashboardRow, 'config'> & {
+  config: Record<string, unknown>;
+};
+
+export type ApiWidget = Omit<WidgetRow, 'config'> & {
+  config: Record<string, unknown>;
+};
+
+function parseConfig(raw: string): Record<string, unknown> {
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    if (typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)) {
+      return parsed as Record<string, unknown>;
+    }
+  } catch {
+    // fall through
+  }
+  return {};
+}
+
+export function toApiDashboard(row: DashboardRow): ApiDashboard {
+  return { ...row, config: parseConfig(row.config) };
+}
+
+export function toApiWidget(row: WidgetRow): ApiWidget {
+  return { ...row, config: parseConfig(row.config) };
+}
+
+export function insertDashboard(row: DashboardRow): void {
+  getDb()
+    .prepare(
+      `INSERT INTO dashboards (id, tenant_id, name, owner_id, config, created_at, updated_at)
+       VALUES (?, ?, ?, ?, ?, ?, ?)`
+    )
+    .run(
+      row.id,
+      row.tenant_id,
+      row.name,
+      row.owner_id,
+      row.config,
+      row.created_at,
+      row.updated_at
+    );
+}
+
+export function listDashboards(tenantId: string): DashboardRow[] {
+  return getDb()
+    .prepare(
+      'SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC, rowid DESC'
+    )
+    .all(tenantId) as DashboardRow[];
+}
+
+/**
+ * Always tenant-scoped: a dashboard from another tenant is indistinguishable
+ * from one that does not exist.
+ */
+export function findDashboard(id: string, tenantId: string): DashboardRow | undefined {
+  return getDb()
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(id, tenantId) as DashboardRow | undefined;
+}
+
+export function updateDashboard(
+  id: string,
+  changes: { name?: string; config?: string; updated_at: string }
+): void {
+  const assignments = ['updated_at = ?'];
+  const params: string[] = [changes.updated_at];
+
+  if (changes.name !== undefined) {
+    assignments.push('name = ?');
+    params.push(changes.name);
+  }
+  if (changes.config !== undefined) {
+    assignments.push('config = ?');
+    params.push(changes.config);
+  }
+
+  getDb()
+    .prepare(`UPDATE dashboards SET ${assignments.join(', ')} WHERE id = ?`)
+    .run(...params, id);
+}
+
+export function deleteDashboard(id: string, tenantId: string): boolean {
+  const result = getDb()
+    .prepare('DELETE FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .run(id, tenantId);
+  return result.changes > 0;
+}
+
+export function listWidgets(dashboardId: string): WidgetRow[] {
+  return getDb()
+    .prepare(
+      `SELECT * FROM widgets WHERE dashboard_id = ?
+       ORDER BY position_y ASC, position_x ASC, rowid ASC`
+    )
+    .all(dashboardId) as WidgetRow[];
+}
+
+export function findWidget(id: string, dashboardId: string): WidgetRow | undefined {
+  return getDb()
+    .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')
+    .get(id, dashboardId) as WidgetRow | undefined;
+}
+
+export function insertWidget(row: WidgetRow): void {
+  getDb()
+    .prepare(
+      `INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
+    )
+    .run(
+      row.id,
+      row.dashboard_id,
+      row.type,
+      row.config,
+      row.position_x,
+      row.position_y,
+      row.width,
+      row.height
+    );
+}
+
+export type WidgetChanges = Partial<Omit<WidgetRow, 'id' | 'dashboard_id'>>;
+
+/** Only these columns are updatable; the list also keeps SQL identifiers fixed. */
+const UPDATABLE_WIDGET_COLUMNS = [
+  'type',
+  'config',
+  'position_x',
+  'position_y',
+  'width',
+  'height',
+] as const;
+
+export function updateWidget(id: string, changes: WidgetChanges): void {
+  const assignments: string[] = [];
+  const params: (string | number)[] = [];
+
+  for (const column of UPDATABLE_WIDGET_COLUMNS) {
+    const value = changes[column];
+    if (value === undefined) {
+      continue;
+    }
+    assignments.push(`${column} = ?`);
+    params.push(value);
+  }
+
+  if (assignments.length === 0) {
+    return;
+  }
+
+  getDb()
+    .prepare(`UPDATE widgets SET ${assignments.join(', ')} WHERE id = ?`)
+    .run(...params, id);
+}
+
+export function deleteWidget(id: string, dashboardId: string): boolean {
+  const result = getDb()
+    .prepare('DELETE FROM widgets WHERE id = ? AND dashboard_id = ?')
+    .run(id, dashboardId);
+  return result.changes > 0;
+}
