+++ b/src/query/filters.ts
@@ -0,0 +1,96 @@
+import { ValidationError } from '../errors';
+import { asRecord, assertPropertyKey, assertTimestamp, optionalObject, optionalString } from '../validation';
+
+/**
+ * Shared event-selection criteria used by the query engine and the exporter.
+ * `tenantId` is not optional — every read path must be tenant-scoped.
+ */
+export interface EventFilter {
+  tenantId: string;
+  eventName?: string;
+  start?: string;
+  end?: string;
+  properties?: Record<string, unknown>;
+}
+
+export interface SqlFragment {
+  clause: string;
+  params: (string | number)[];
+}
+
+/** SQLite only binds primitives; JSON booleans compare as 1/0. */
+function bindableValue(key: string, value: unknown): string | number {
+  if (typeof value === 'string' || typeof value === 'number') {
+    return value;
+  }
+  if (typeof value === 'boolean') {
+    return value ? 1 : 0;
+  }
+  throw new ValidationError(
+    `Filter "${key}" must be a string, number or boolean`
+  );
+}
+
+/**
+ * Builds the `WHERE` clause for an event scan.
+ *
+ * Timestamps are compared through `datetime()` so rows written with different
+ * ISO representations (`2024-01-15T10:00:00Z` vs `2024-01-15 10:00:00`) still
+ * compare correctly.
+ */
+export function buildEventWhere(filter: EventFilter): SqlFragment {
+  const conditions = ['tenant_id = ?'];
+  const params: (string | number)[] = [filter.tenantId];
+
+  if (filter.eventName !== undefined) {
+    conditions.push('name = ?');
+    params.push(filter.eventName);
+  }
+
+  if (filter.start !== undefined) {
+    conditions.push('datetime(timestamp) >= datetime(?)');
+    params.push(filter.start);
+  }
+
+  if (filter.end !== undefined) {
+    conditions.push('datetime(timestamp) <= datetime(?)');
+    params.push(filter.end);
+  }
+
+  for (const [key, value] of Object.entries(filter.properties ?? {})) {
+    assertPropertyKey(key);
+    conditions.push('json_extract(properties, ?) = ?');
+    params.push(`$.${key}`, bindableValue(key, value));
+  }
+
+  return { clause: conditions.join(' AND '), params };
+}
+
+export interface ParseFilterOptions {
+  /** Query endpoints demand an event name; exports treat it as optional. */
+  requireEventName?: boolean;
+}
+
+export function parseEventFilter(
+  body: unknown,
+  tenantId: string,
+  options: ParseFilterOptions = {}
+): EventFilter {
+  const source = asRecord(body);
+  const eventName = optionalString(source, 'event_name');
+
+  if (options.requireEventName && eventName === undefined) {
+    throw new ValidationError('"event_name" is required');
+  }
+
+  const start = optionalString(source, 'start');
+  const end = optionalString(source, 'end');
+
+  return {
+    tenantId,
+    eventName,
+    start: start === undefined ? undefined : assertTimestamp(start, 'start'),
+    end: end === undefined ? undefined : assertTimestamp(end, 'end'),
+    properties: optionalObject(source, 'filters'),
+  };
+}
diff --git a/src/query/funnel.ts b/src/query/funnel.ts
new file mode 100644
index 0000000..52bb84a
--- /dev/null
+++ b/src/query/funnel.ts
@@ -0,0 +1,65 @@
+import type { FunnelEventRow } from './repository';
+
+export interface FunnelStep {
+  step: number;
+  event_name: string;
+  count: number;
+  /** Share of step-1 entities that reached this step, 0–1. */
+  conversion_rate: number;
+}
+
+/**
+ * Counts how many entities completed each step *in order*.
+ *
+ * Entities are keyed by session, falling back to user; events belonging to
+ * neither are ignored. `rows` must already be sorted by occurrence, so a single
+ * forward pass per entity is enough: advance the step pointer on each match and
+ * credit every step up to how far it got. Counts are therefore monotonically
+ * non-increasing by construction.
+ */
+export function computeFunnel(rows: FunnelEventRow[], steps: string[]): FunnelStep[] {
+  const sequences = new Map<string, string[]>();
+
+  for (const row of rows) {
+    const key = row.session_id ?? row.user_id;
+    if (key === null) {
+      continue;
+    }
+    const existing = sequences.get(key);
+    if (existing) {
+      existing.push(row.name);
+    } else {
+      sequences.set(key, [row.name]);
+    }
+  }
+
+  const reached = new Array<number>(steps.length).fill(0);
+
+  for (const sequence of sequences.values()) {
+    let depth = 0;
+    for (const name of sequence) {
+      if (name === steps[depth]) {
+        depth += 1;
+        if (depth === steps.length) {
+          break;
+        }
+      }
+    }
+    for (let i = 0; i < depth; i += 1) {
+      reached[i] += 1;
+    }
+  }
+
+  const entered = reached[0] ?? 0;
+
+  return steps.map((event_name, index) => ({
+    step: index + 1,
+    event_name,
+    count: reached[index],
+    conversion_rate: entered === 0 ? 0 : round(reached[index] / entered),
+  }));
+}
+
+function round(value: number): number {
+  return Math.round(value * 10000) / 10000;
+}
