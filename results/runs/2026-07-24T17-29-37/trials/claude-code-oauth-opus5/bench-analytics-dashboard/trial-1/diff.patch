erty_key: propertyKey,\n    data: breakdownEvents(filter, propertyKey, limit),\n  });\n});\n\nrouter.post('/funnel', (req, res) => {\n  const auth = getAuthUser(req);\n  const body = asRecord(req.body);\n  const filter = parseEventFilter(body, auth.tenantId);\n  const steps = parseSteps(body.steps);\n\n  const results = computeFunnel(selectFunnelEvents(filter, steps), steps);\n\n  res.json({\n    steps: results,\n    entered: results[0]?.count ?? 0,\n    completed: results[results.length - 1]?.count ?? 0,\n  });\n});\n\nfunction clampLimit(limit: number | undefined): number {\n  if (limit === undefined) {\n    return DEFAULT_BREAKDOWN_LIMIT;\n  }\n  if (limit < 1 || limit > MAX_BREAKDOWN_LIMIT) {\n    throw new ValidationError(`\"limit\" must be between 1 and ${MAX_BREAKDOWN_LIMIT}`);\n  }\n  return limit;\n}\n\nfunction parseSteps(value: unknown): string[] {\n  if (!Array.isArray(value) || value.length < 2) {\n    throw new ValidationError('\"steps\" must be an array of at least two event names');\n  }\n  if (value.length > MAX_FUNNEL_STEPS) {\n    throw new ValidationError(`\"steps\" may contain at most ${MAX_FUNNEL_STEPS} entries`);\n  }\n\n  return value.map((step) => {\n    if (typeof step !== 'string' || step.trim() === '') {\n      throw new ValidationError('Each funnel step must be a non-empty event name');\n    }\n    return step;\n  });\n}\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1224,"cache_read_input_tokens":73912,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1224},"output_tokens":73,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9b733d1d-7d89-4619-b21e-2cee354beac5","uuid":"4fe4f57d-9508-4d2c-8705-6be2c17d5ebe","request_id":"req_011CdMHzmEWTsbtf5phwDj1X"}
