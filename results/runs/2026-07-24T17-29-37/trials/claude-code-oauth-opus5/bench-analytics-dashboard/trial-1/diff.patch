@@ -0,0 +1,52 @@
+/**
+ * Shared event model. Ingestion writes these rows; the query and export
+ * modules read them, so the row shape and the JSON representation live in one
+ * place.
+ */
+export interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  /** JSON-encoded object as stored in SQLite. */
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+export interface ApiEvent {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: Record<string, unknown>;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+export const EVENT_COLUMNS = [
+  'id',
+  'tenant_id',
+  'name',
+  'properties',
+  'timestamp',
+  'user_id',
+  'session_id',
+] as const;
+
+/** Tolerant of rows written outside the API that may hold invalid JSON. */
+export function parseProperties(raw: string): Record<string, unknown> {
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    if (typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)) {
+      return parsed as Record<string, unknown>;
+    }
+  } catch {
+    // fall through
+  }
+  return {};
+}
+
+export function toApiEvent(row: EventRow): ApiEvent {
+  return { ...row, properties: parseProperties(row.properties) };
+}
