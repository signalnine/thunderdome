index 0000000..fa98363
--- /dev/null
+++ b/src/query/repository.ts
@@ -0,0 +1,96 @@
+import { getDb } from '../db';
+import type { TimeBucket } from '../types';
+import { buildEventWhere, type EventFilter } from './filters';
+
+/**
+ * Bucket expressions normalise through `datetime()` first so mixed timestamp
+ * representations land in the same bucket. Weeks are keyed by their Monday.
+ */
+const BUCKET_EXPRESSIONS: Record<TimeBucket, string> = {
+  hour: "strftime('%Y-%m-%dT%H:00:00Z', datetime(timestamp))",
+  day: "strftime('%Y-%m-%dT00:00:00Z', datetime(timestamp))",
+  week: "strftime('%Y-%m-%dT00:00:00Z', datetime(timestamp, 'weekday 0', '-6 days'))",
+  month: "strftime('%Y-%m-01T00:00:00Z', datetime(timestamp))",
+};
+
+export interface BucketCount {
+  bucket: string;
+  count: number;
+}
+
+export interface PropertyCount {
+  property_value: string | number | null;
+  count: number;
+}
+
+export function countEvents(filter: EventFilter): number {
+  const { clause, params } = buildEventWhere(filter);
+  const row = getDb()
+    .prepare(`SELECT COUNT(*) AS count FROM events WHERE ${clause}`)
+    .get(...params) as { count: number };
+  return row.count;
+}
+
+export function bucketEvents(filter: EventFilter, bucket: TimeBucket): BucketCount[] {
+  const { clause, params } = buildEventWhere(filter);
+  const expression = BUCKET_EXPRESSIONS[bucket];
+
+  return getDb()
+    .prepare(
+      `SELECT ${expression} AS bucket, COUNT(*) AS count
+         FROM events
+        WHERE ${clause}
+     GROUP BY bucket
+     ORDER BY bucket ASC`
+    )
+    .all(...params) as BucketCount[];
+}
+
+export function breakdownEvents(
+  filter: EventFilter,
+  propertyKey: string,
+  limit: number
+): PropertyCount[] {
+  const { clause, params } = buildEventWhere(filter);
+  const path = `$.${propertyKey}`;
+
+  return getDb()
+    .prepare(
+      `SELECT json_extract(properties, ?) AS property_value, COUNT(*) AS count
+         FROM events
+        WHERE ${clause} AND json_extract(properties, ?) IS NOT NULL
+     GROUP BY property_value
+     ORDER BY count DESC, property_value ASC
+        LIMIT ?`
+    )
+    .all(path, ...params, path, limit) as PropertyCount[];
+}
+
+export interface FunnelEventRow {
+  name: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+/**
+ * Events for the funnel steps in occurrence order. `rowid` breaks ties so
+ * events ingested in one batch (which can share a millisecond) keep their
+ * submitted order.
+ */
+export function selectFunnelEvents(
+  filter: EventFilter,
+  stepNames: string[]
+): FunnelEventRow[] {
+  const unique = [...new Set(stepNames)];
+  const { clause, params } = buildEventWhere({ ...filter, eventName: undefined });
+  const placeholders = unique.map(() => '?').join(', ');
+
+  return getDb()
+    .prepare(
+      `SELECT name, user_id, session_id
+         FROM events
+        WHERE ${clause} AND name IN (${placeholders})
+     ORDER BY datetime(timestamp) ASC, rowid ASC`
+    )
+    .all(...params, ...unique) as FunnelEventRow[];
+}
diff --git a/src/query/router.ts b/src/query/router.ts
new file mode 100644
index 0000000..e6e4f8b
--- /dev/null
+++ b/src/query/router.ts
@@ -0,0 +1,97 @@
+import { Router } from 'express';
+import { getAuthUser, requireAuth } from '../auth';
+import { ValidationError } from '../errors';
+import { TIME_BUCKETS } from '../types';
+import { asRecord, assertPropertyKey, optionalEnum, optionalInteger, requireString } from '../validation';
+import { parseEventFilter } from './filters';
+import { computeFunnel } from './funnel';
+import { bucketEvents, breakdownEvents, countEvents, selectFunnelEvents } from './repository';
+
+const DEFAULT_BREAKDOWN_LIMIT = 50;
+const MAX_BREAKDOWN_LIMIT = 1000;
+const MAX_FUNNEL_STEPS = 10;
+
+const router = Router();
+
+router.use(requireAuth);
+
+router.post('/count', (req, res) => {
+  const auth = getAuthUser(req);
+  const filter = parseEventFilter(req.body, auth.tenantId, { requireEventName: true });
+
+  res.json({
+    event_name: filter.eventName,
+    start: filter.start ?? null,
+    end: filter.end ?? null,
+    count: countEvents(filter),
+  });
+});
+
+router.post('/timeseries', (req, res) => {
+  const auth = getAuthUser(req);
+  const filter = parseEventFilter(req.body, auth.tenantId, { requireEventName: true });
+  const bucket = optionalEnum(asRecord(req.body), 'bucket', TIME_BUCKETS) ?? 'day';
+
+  res.json({
+    event_name: filter.eventName,
+    bucket,
+    data: bucketEvents(filter, bucket),
+  });
+});
+
+router.post('/breakdown', (req, res) => {
+  const auth = getAuthUser(req);
+  const body = asRecord(req.body);
+  const filter = parseEventFilter(body, auth.tenantId, { requireEventName: true });
+  const propertyKey = assertPropertyKey(requireString(body, 'property_key'));
+  const limit = clampLimit(optionalInteger(body, 'limit'));
+
+  res.json({
+    event_name: filter.eventName,
+    property_key: propertyKey,
+    data: breakdownEvents(filter, propertyKey, limit),
+  });
+});
+
+router.post('/funnel', (req, res) => {
+  const auth = getAuthUser(req);
+  const body = asRecord(req.body);
+  const filter = parseEventFilter(body, auth.tenantId);
+  const steps = parseSteps(body.steps);
+
+  const results = computeFunnel(selectFunnelEvents(filter, steps), steps);
+
+  res.json({
+    steps: results,
+    entered: results[0]?.count ?? 0,
+    completed: results[results.length - 1]?.count ?? 0,
+  });
+});
+
+function clampLimit(limit: number | undefined): number {
+  if (limit === undefined) {
+    return DEFAULT_BREAKDOWN_LIMIT;
+  }
+  if (limit < 1 || limit > MAX_BREAKDOWN_LIMIT) {
+    throw new ValidationError(`"limit" must be between 1 and ${MAX_BREAKDOWN_LIMIT}`);
+  }
+  return limit;
+}
+
+function parseSteps(value: unknown): string[] {
+  if (!Array.isArray(value) || value.length < 2) {
+    throw new ValidationError('"steps" must be an array of at least two event names');
+  }
+  if (value.length > MAX_FUNNEL_STEPS) {
+    throw new ValidationError(`"steps" may contain at most ${MAX_FUNNEL_STEPS} entries`);
+  }
+
+  return value.map((step) => {
+    if (typeof step !== 'string' || step.trim() === '') {
+      throw new ValidationError('Each funnel step must be a non-empty event name');
+    }
+    return step;
+  });
+}
+
+export default router;
