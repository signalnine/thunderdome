+import type { NextFunction, Request, Response } from 'express';
+import jwt from 'jsonwebtoken';
+import { AuthError } from './errors';
+import type { AuthUser } from './types';
+
+/**
+ * Shared authentication for every feature module.
+ *
+ * `authenticate` only *populates* `req.user`; `requireAuth` is what rejects
+ * anonymous callers. Splitting the two lets `POST /users` and `POST
+ * /users/login` stay public while everything else is locked down, and lets the
+ * unit tests substitute their own middleware that sets `req.user` directly.
+ */
+const DEFAULT_SECRET = 'dev-secret-change-me';
+const TOKEN_TTL_SECONDS = 24 * 60 * 60;
+
+/** JWT payload shape: `{ sub, tid, iat, exp }`. */
+export interface TokenPayload {
+  sub: string;
+  tid: string;
+  iat: number;
+  exp: number;
+}
+
+function jwtSecret(): string {
+  return process.env.JWT_SECRET ?? DEFAULT_SECRET;
+}
+
+export function signToken(user: AuthUser): string {
+  return jwt.sign({ sub: user.id, tid: user.tenantId }, jwtSecret(), {
+    expiresIn: TOKEN_TTL_SECONDS,
+  });
+}
+
+export function verifyToken(token: string): TokenPayload {
+  let decoded: unknown;
+  try {
+    decoded = jwt.verify(token, jwtSecret());
+  } catch {
+    throw new AuthError('Invalid or expired token');
+  }
+
+  if (typeof decoded !== 'object' || decoded === null) {
+    throw new AuthError('Invalid or expired token');
+  }
+
+  const { sub, tid, iat, exp } = decoded as Record<string, unknown>;
+  if (typeof sub !== 'string' || typeof tid !== 'string') {
+    throw new AuthError('Invalid or expired token');
+  }
+
+  return {
+    sub,
+    tid,
+    iat: typeof iat === 'number' ? iat : 0,
+    exp: typeof exp === 'number' ? exp : 0,
+  };
+}
+
+/**
+ * Populates `req.user` from a bearer token. A missing header is left to
+ * `requireAuth`; a malformed or invalid one fails immediately so callers get a
+ * clear `AUTH_ERROR` instead of a generic "authentication required".
+ */
+export function authenticate(req: Request, _res: Response, next: NextFunction): void {
+  const header = req.headers.authorization;
+  if (header === undefined || header.trim() === '') {
+    next();
+    return;
+  }
+
+  const [scheme, token, ...rest] = header.trim().split(/\s+/);
+  if (scheme?.toLowerCase() !== 'bearer' || !token || rest.length > 0) {
+    throw new AuthError('Authorization header must be "Bearer <token>"');
+  }
+
+  const payload = verifyToken(token);
+  req.user = { id: payload.sub, tenantId: payload.tid };
+  next();
+}
+
+export function requireAuth(req: Request, _res: Response, next: NextFunction): void {
+  if (!req.user) {
+    throw new AuthError('Authentication required');
+  }
+  next();
+}
+
+/** Reads the authenticated identity, narrowing away `undefined`. */
+export function getAuthUser(req: Request): AuthUser {
+  if (!req.user) {
+    throw new AuthError('Authentication required');
+  }
+  return req.user;
+}
