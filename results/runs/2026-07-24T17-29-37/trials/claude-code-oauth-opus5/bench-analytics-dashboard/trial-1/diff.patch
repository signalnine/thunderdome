+import express from 'express';
+import { authenticate } from './auth';
+import { errorHandler, notFoundHandler } from './errors';
+import dashboardsRouter from './dashboards/router';
+import exportRouter from './export/router';
+import ingestRouter from './ingest/router';
+import queryRouter from './query/router';
+import usersRouter from './users/router';
+import './types';
+
+/**
+ * Wires the feature routers together.
+ *
+ * `authenticate` runs once for every request and only *populates* `req.user`;
+ * each router declares its own `requireAuth`. That keeps registration and login
+ * public while every other endpoint is protected, and it means the routers can
+ * be mounted standalone (as the unit tests do) with any middleware that
+ * supplies `req.user`.
+ */
+export function createApp(): express.Express {
+  const app = express();
+
+  app.use(express.json({ limit: '5mb' }));
+  app.use(authenticate);
+
+  app.get('/health', (_req, res) => {
+    res.json({ status: 'ok' });
+  });
+
+  app.use('/users', usersRouter);
+  app.use('/events', ingestRouter);
+  app.use('/query', queryRouter);
+  app.use('/dashboards', dashboardsRouter);
+  app.use('/export', exportRouter);
+
+  app.use(notFoundHandler);
+  app.use(errorHandler);
+
+  return app;
+}
+
+export default createApp;
