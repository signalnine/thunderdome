b))\n      .send({ title: 'from bob', content: 'hi' });\n    expect(created.status).toBe(201);\n    // Bob created it, so Bob owns it outright.\n    expect(created.body.role).toBe('owner');\n    expect((await request(app).delete(`/documents/${created.body.id}`).set(auth(bob))).status).toBe(204);\n  });\n});\n\ndescribe('activity log', () => {\n  it('records document lifecycle and sharing events', async () => {\n    const alice = await register('alice');\n    await register('bob');\n    const folder = await createFolder(alice, 'work');\n    const doc = await createDocument(alice, 'report', folder);\n\n    await request(app).patch(`/documents/${doc}`).set(auth(alice)).send({ content: 'v2' });\n    await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'viewer' });\n    await request(app).delete(`/documents/${doc}`).set(auth(alice));\n\n    const res = await request(app).get('/activity').set(auth(alice));\n    expect(res.status).toBe(200);\n    const actions = res.body.activity.map((entry: { action: string }) => entry.action);\n    expect(actions).toContain('document.created');\n    expect(actions).toContain('document.updated');\n    expect(actions).toContain('document.shared');\n    expect(actions).toContain('document.deleted');\n\n    const entry = res.body.activity.find(\n      (item: { action: string }) => item.action === 'document.created',\n    );\n    expect(entry.userId).toBeTruthy();\n    expect(entry.resourceId).toBe(doc);\n    expect(entry.resourceType).toBe('document');\n    expect(Number.isNaN(Date.parse(entry.timestamp))).toBe(false);\n  });\n\n  it('only shows entries the user is involved in', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const carol = await register('carol');\n    const doc = await createDocument(alice, 'report');\n\n    await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(alice))\n      .sen