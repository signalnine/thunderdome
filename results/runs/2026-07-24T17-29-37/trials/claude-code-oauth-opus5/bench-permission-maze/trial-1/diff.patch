: document.id,\n      details: { title: document.title },\n    });\n    return document;\n  };\n\n  router.put('/documents/:id', (req, res) => {\n    const document = update(req);\n    res.status(200).json(serializeDocument(store, document, currentUser(req).id));\n  });\n  router.patch('/documents/:id', (req, res) => {\n    const document = update(req);\n    res.status(200).json(serializeDocument(store, document, currentUser(req).id));\n  });\n\n  router.delete('/documents/:id', (req, res) => {\n    const user = currentUser(req);\n    const document = getDocumentOr404(store, req.params.id);\n    requireRole(store, user, 'document', document.id, 'owner');\n    store.documents.delete(document.id);\n    store.removeSharesForResource('document', document.id);\n    store.log({\n      action: 'document.deleted',\n      userId: user.id,\n      resourceType: 'document',\n      resourceId: document.id,\n      details: { title: document.title },\n    });\n    res.status(204).end();\n  });\n\n  router.post('/documents/:id/share', (req, res) => {\n    const user = currentUser(req);\n    const { share, created } = shareResource(store, user, 'document', req.params.id, req);\n    res.status(created ? 201 : 200).json(serializeShare(store, share));\n  });\n\n  for (const path of ['/documents/:id/permissions', '/documents/:id/shares']) {\n    router.get(path, (req, res) => {\n      const user = currentUser(req);\n      getDocumentOr404(store, req.params.id);\n      requireRole(store, user, 'document', req.params.id, 'viewer');\n      res.status(200).json(listPermissions(store, 'document', req.params.id));\n    });\n  }\n\n  for (const path of ['/documents/:id/share/:userId', '/documents/:id/shares/:userId']) {\n    router.delete(path, (req, res) => {\n      const user = currentUser(req);\n      getDocumentOr404(store, req.params.id);\n      requireRole(store, user, 'document', req.params.id, 'owner');\n      if (!store.removeShare('document', req.params.id, req.params.userId)) {\n        throw notFound('Share not found');\n      }\n      store.log({\n        action: 'document.unshared',\n        userId: user.id,\n        resourceType: 'document',\n        resourceId: req.params.id,\n        targetUserId: req.params.userId,\n      });\n      res.status(204).end();\n    });\n  }\n\n  return router;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
