xpect(read.body.role).toBe('viewer');\n\n    const write = await request(app)\n      .patch(`/documents/${doc}`)\n      .set(auth(bob))\n      .send({ content: 'nope' });\n    expect(write.status).toBe(403);\n\n    expect((await request(app).delete(`/documents/${doc}`).set(auth(bob))).status).toBe(403);\n\n    const reshare = await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(bob))\n      .send({ username: 'alice', role: 'viewer' });\n    expect(reshare.status).toBe(403);\n  });\n\n  it('lets editors modify and re-share but not delete or grant ownership', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const carol = await register('carol');\n    const doc = await createDocument(alice, 'report');\n\n    await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'editor' });\n\n    const edit = await request(app)\n      .patch(`/documents/${doc}`)\n      .set(auth(bob))\n      .send({ content: 'edited by bob' });\n    expect(edit.status).toBe(200);\n\n    const reshare = await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(bob))\n      .send({ username: 'carol', role: 'viewer' });\n    expect(reshare.status).toBe(201);\n    expect((await request(app).get(`/documents/${doc}`).set(auth(carol))).status).toBe(200);\n\n    const escalate = await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(bob))\n      .send({ username: 'carol', role: 'owner' });\n    expect(escalate.status).toBe(403);\n\n    expect((await request(app).delete(`/documents/${doc}`).set(auth(bob))).status).toBe(403);\n  });\n\n  it('gives co-owners full control', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const doc = await createDocument(alice, 'report');\n\n    await request(app)\n      .post('/share')\n      .set(auth(alice))\n      .send({ resourceType: 'document', resourceId: doc, username: 'bob', role: 'owner' });\n\n    expect((await request(app).delete(`/documents/${doc}`).set(auth(bob))).status).toBe(204);\n  });\n\n  it('inherits access from ancestor folders', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const root = await createFolder(alice, 'root');\n    const mid = await createFolder(alice, 'mid', root);\n    const leaf = await createFolder(alice, 'leaf', mid);\n    const doc = await createDocument(alice, 'deep', leaf);\n\n    await request(app)\n      .post(`/folders/${root}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'viewer' });\n\n    const read = await request(app).get(`/documents/${doc}`).set(auth(bob));\n    expect(read.status).toBe(200);\n    expect(read.body.role).toBe('viewer');\n    expect((await request(app).get(`/folders/${leaf}`).set(auth(bob))).status).toBe(200);\n    expect(\n      (await request(app).patch(`/documents/${doc}`).set(auth(bob)).send({ content: 'x' })).status,\n    ).toBe(403);\n  });\n\n  it('uses the most permissive role across overlapping grants', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const root = await createFolder(alice, 'root');\n    const child = await createFolder(alice, 'child', root);\n    const doc = await createDocument(alice, 'deep', child);\n\n    await request(app)\n      .post(`/folders/${root}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'viewer' });\n    await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'editor' });\n\n    const doc0 = await request(app).get(`/documents/${doc}`).set(auth(bob));\n    expect(doc0.body.role).toBe('editor');\n    expect(\n      (await request(app).patch(`/documents/${doc}`).set(auth(bob)).send({ content: 'ok' })).status,\n    ).toBe(200);\n\n    // A weaker direct share must not shrink the st