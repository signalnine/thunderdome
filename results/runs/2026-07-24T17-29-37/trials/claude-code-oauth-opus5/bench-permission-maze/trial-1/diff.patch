e, document, user.id));\n  });\n\n  router.get('/documents', (req, res) => {\n    const user = currentUser(req);\n    const folderId = typeof req.query.folderId === 'string' ? req.query.folderId : undefined;\n    const documents = readableDocuments(store, user.id)\n      .filter((doc) => folderId === undefined || doc.folderId === folderId)\n      .map((doc) => serializeDocument(store, doc, user.id));\n    res.status(200).json({ documents, items: documents, count: documents.length });\n  });\n\n  router.get('/documents/:id', (req, res) => {\n    const user = currentUser(req);\n    const document = getDocumentOr404(store, req.params.id);\n    requireRole(store, user, 'document', document.id, 'viewer');\n    res.status(200).json(serializeDocument(store, document, user.id));\n  });\n\n  const update = (req: Request): Document => {\n    const user = currentUser(req);\n    const document = getDocumentOr404(store, req.params.id);\n    requireRole(store, user, 'document', document.id, 'editor');\n\n    const title = optionalString(req, ['title', 'name']);\n    const content = optionalString(req, ['content', 'body', 'text']);\n    const folderId = optionalId(req, ['folderId', 'folder']);\n\n    if (title !== undefined) document.title = title;\n    if (content !== undefined) document.content = content;\n    if (folderId !== undefined) {\n      if (folderId !== null) {\n        if (!store.folders.has(folderId)) throw notFound('Folder not found');\n        requireRole(store, user, 'folder', folderId, 'editor');\n      }\n      document.folderId = folderId;\n    }\n    document.updatedAt = new Date().toISOString();\n    store.log({\n      action: 'document.updated',\n      userId: user.id,\n      resourceType: 'document',\n      resourceId: document.id,\n      details: { title: document.title },\n    });\n    return document;\n  };\n\n  router.put('/documents/:id', (req, res) => {\n    const document = update(req);\n    res.status(200).json(serializeDocument(store, document, currentUser(req).id));\n  });\n  router.patch('/documents/:id', (req, res) => {\n    const document = update(req);\n    res.status(200).json(serializeDocument(store, document, currentUser(req).id));\n  });\n\n  router.delete('/documents/:id', (req, res) => {\n    const user = currentUser(req);\n    const document = getDocumentOr404(store, req.params.id);\n    requireRole(store, user, 'document', document.id, 'owner');\n    store.documents.delete(document.id);\n    store.removeSharesForResource('document', document.id);\n    store.log({\n      action: 'document.deleted',\n      userId: user.id,\n      resourceType: 'document',\n      resourceId: document.id,\n      details: { title: document.title },\n    });\n    res.status(204).end();\n  });\n\n  router.post('/documents/:id/share', (req, res) => {\n    const user = currentUser(req);\n    const { share, created } = shareResource(store, user, 'document', req.params.id, req);\n    res.status(created ? 201 : 200).json(serializeShare(store, share));\n  });\n\n  for (const path of ['/documents/:id/permissions', '/documents/:id/shares']) {\n    router.get(path, (req, res) => {\n      const user = currentUser(req);\n      getDocumentOr404(store, req.params.id);\n      requireRole(store, user, 'document', req.params.id, 'viewer');\n      res.status(200).json(listPermissions(store, 'document', req.params.id));\n    });\n  }\n\n  for (const path of ['/documents/:id/share/:userId', '/documents/:id/shares/:userId']) {\n    router.delete(path, (req, res) => {\n      const user = currentUser(req);\n      getDocumentOr404(store, req.params.id);\n      requireRole(store, user, 'document', req.params.id, 'owner');\n      if (!store.removeShare('document', req.params.id, req.params.userId)) {\n        throw notFound('Share not found');\n      }\n      store.log({\n        action: 'document.unshared',\n        userId: user.id,\n        resourceType: 'document',\n        resourceId: req.params.id,\n        targetUserId: req.params.userId,\n      });\n      res.status(204).end();\n    });\n  }\n\n  return router;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1196,"cache_read_input_tokens":37714,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1196},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d21ad437-1159-4cef-bc4d-609a6e1da7e9","uuid":"396eb478-4dba-458a-a59b-7d0067599a40","request_id":"req_011CdMJhcrNFhQTRGv7Cxxpd"}
