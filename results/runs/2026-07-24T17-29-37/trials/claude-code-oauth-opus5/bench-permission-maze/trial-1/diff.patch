new file mode 100644
index 0000000..719e79e
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,196 @@
+import { randomBytes, randomUUID, scryptSync, timingSafeEqual } from 'node:crypto';
+import type {
+  ActivityEntry,
+  Document,
+  Folder,
+  PublicUser,
+  ResourceType,
+  Role,
+  Share,
+  User,
+} from './types.js';
+
+export interface ActivityInput {
+  action: string;
+  userId: string;
+  resourceType: ActivityEntry['resourceType'];
+  resourceId: string | null;
+  targetUserId?: string | null;
+  role?: Role | null;
+  details?: Record<string, unknown>;
+}
+
+function hashPassword(password: string, salt: string): string {
+  return scryptSync(password, salt, 64).toString('hex');
+}
+
+/**
+ * In-memory data store. A fresh instance is created per app, so state resets
+ * whenever the server restarts (or when a test builds a new app).
+ */
+export class Store {
+  readonly users = new Map<string, User>();
+  readonly usersByUsername = new Map<string, User>();
+  readonly folders = new Map<string, Folder>();
+  readonly documents = new Map<string, Document>();
+  readonly shares = new Map<string, Share>();
+  readonly tokens = new Map<string, string>();
+  readonly activity: ActivityEntry[] = [];
+
+  private now(): string {
+    return new Date().toISOString();
+  }
+
+  createUser(username: string, password: string): User {
+    const salt = randomBytes(16).toString('hex');
+    const user: User = {
+      id: randomUUID(),
+      username,
+      salt,
+      passwordHash: hashPassword(password, salt),
+      createdAt: this.now(),
+    };
+    this.users.set(user.id, user);
+    this.usersByUsername.set(username.toLowerCase(), user);
+    return user;
+  }
+
+  findUserByUsername(username: string): User | undefined {
+    return this.usersByUsername.get(username.toLowerCase());
+  }
+
+  verifyPassword(user: User, password: string): boolean {
+    const candidate = Buffer.from(hashPassword(password, user.salt), 'hex');
+    const expected = Buffer.from(user.passwordHash, 'hex');
+    return candidate.length === expected.length && timingSafeEqual(candidate, expected);
+  }
+
+  issueToken(user: User): string {
+    const token = randomBytes(32).toString('hex');
+    this.tokens.set(token, user.id);
+    return token;
+  }
+
+  userForToken(token: string): User | undefined {
+    const userId = this.tokens.get(token);
+    return userId ? this.users.get(userId) : undefined;
+  }
+
+  createFolder(name: string, parentId: string | null, ownerId: string): Folder {
+    const timestamp = this.now();
+    const folder: Folder = {
+      id: randomUUID(),
+      name,
+      parentId,
+      ownerId,
+      createdAt: timestamp,
+      updatedAt: timestamp,
+    };
+    this.folders.set(folder.id, folder);
+    return folder;
+  }
+
+  createDocument(
+    title: string,
+    content: string,
+    folderId: string | null,
+    ownerId: string,
+  ): Document {
+    const timestamp = this.now();
+    const document: Document = {
+      id: randomUUID(),
+      title,
+      content,
+      folderId,
+      ownerId,
+      createdAt: timestamp,
+      updatedAt: timestamp,
+    };
+    this.documents.set(document.id, document);
+    return document;
+  }
+
+  /** Direct (non-inherited) shares recorded against a single resource. */
+  sharesFor(resourceType: ResourceType, resourceId: string): Share[] {
+    return [...this.shares.values()].filter(
+      (share) => share.resourceType === resourceType && share.resourceId === resourceId,
+    );
+  }
+
+  findShare(
+    resourceType: ResourceType,
+    resourceId: string,
+    userId: string,
+  ): Share | undefined {
+    return [...this.shares.values()].find(
+      (share) =>
+        share.resourceType === resourceType &&
+        share.resourceId === resourceId &&
+        share.userId === userId,
+    );
+  }
+
+  upsertShare(
+    resourceType: ResourceType,
+    resourceId: string,
+    userId: string,
+    role: Role,
+    grantedBy: string,
+  ): Share {
+    const existing = this.findShare(resourceType, resourceId, userId);
+    if (existing) {
+      existing.role = role;
+      existing.grantedBy = grantedBy;
+      existing.updatedAt = this.now();
+      return existing;
+    }
+    const timestamp = this.now();
+    const share: Share = {
+      id: randomUUID(),
+      resourceType,
+      resourceId,
+      userId,
+      role,
+      grantedBy,
+      createdAt: timestamp,
+      updatedAt: timestamp,
+    };
+    this.shares.set(share.id, share);
+    return share;
+  }
+
+  removeShare(resourceType: ResourceType, resourceId: string, userId: string): boolean {
+    const share = this.findShare(resourceType, resourceId, userId);
+    if (!share) return false;
+    this.shares.delete(share.id);
+    return true;
+  }
+
+  removeSharesForResource(resourceType: ResourceType, resourceId: string): void {
+    for (const share of this.sharesFor(resourceType, resourceId)) {
+      this.shares.delete(share.id);
+    }
+  }
+
+  log(entry: ActivityInput): ActivityEntry {
+    const record: ActivityEntry = {
+      id: randomUUID(),
+      action: entry.action,
+      type: entry.action,
+      userId: entry.userId,
+      username: this.users.get(entry.userId)?.username ?? 'unknown',
+      resourceType: entry.resourceType,
+      resourceId: entry.resourceId,
+      targetUserId: entry.targetUserId ?? null,
+      role: entry.role ?? null,
+      timestamp: this.now(),
+      details: entry.details,
+    };
+    this.activity.push(record);
+    return record;
+  }
+}
+
+export function toPublicUser(user: User): PublicUser {
+  return { id: user.id, username: user.username, createdAt: user.createdAt };
+}
