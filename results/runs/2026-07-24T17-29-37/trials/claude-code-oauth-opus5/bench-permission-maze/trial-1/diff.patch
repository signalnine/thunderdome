rname).toBe('alice');\n    expect(res.body.id).toBeTruthy();\n    expect(res.body.token).toBeTruthy();\n    expect(JSON.stringify(res.body)).not.toContain('secret1');\n\n    const me = await request(app).get('/me').set(auth(res.body.token));\n    expect(me.status).toBe(200);\n    expect(me.body.username).toBe('alice');\n  });\n\n  it('rejects duplicate usernames and bad payloads', async () => {\n    await register('alice');\n    const dup = await request(app)\n      .post('/auth/register')\n      .send({ username: 'alice', password: 'other' });\n    expect(dup.status).toBe(409);\n\n    const missing = await request(app).post('/auth/register').send({ username: 'bob' });\n    expect(missing.status).toBe(400);\n  });\n\n  it('logs in with valid credentials only', async () => {\n    await register('alice', 'hunter2');\n\n    const ok = await request(app).post('/auth/login').send({ username: 'alice', password: 'hunter2' });\n    expect(ok.status).toBe(200);\n    expect(ok.body.token).toBeTruthy();\n\n    const bad = await request(app).post('/auth/login').send({ username: 'alice', password: 'nope' });\n    expect(bad.status).toBe(401);\n\n    const unknown = await request(app).post('/login').send({ username: 'ghost', password: 'x' });\n    expect(unknown.status).toBe(401);\n  });\n\n  it('requires a valid token for protected routes', async () => {\n    expect((await request(app).get('/folders')).status).toBe(401);\n    expect((await request(app).get('/folders').set(auth('garbage'))).status).toBe(401);\n    expect((await request(app).get('/documents')).status).toBe(401);\n    expect((await request(app).get('/activity')).status).toBe(401);\n  });\n});\n\ndescribe('folders', () => {\n  it('supports nesting and CRUD', async () => {\n    const token = await register('alice');\n    const root = await createFolder(token, 'root');\n    const child = await createFolder(token, 'child', root);\n\n    const res = await request(app).get(`/folders/${child}`).set(auth(token));\n    expect(res.status).toBe(200);\n    expect(res.body.name).toBe('child');\n    expect(res.body.parentId).toBe(root);\n\n    const rootRes = await request(app).get(`/folders/${root}`).set(auth(token));\n    expect(rootRes.body.children).toHaveLength(1);\n\n    const renamed = await request(app)\n      .patch(`/folders/${child}`)\n      .set(auth(token))\n      .send({ name: 'renamed' });\n    expect(renamed.status).toBe(200);\n    expect(renamed.body.name).toBe('renamed');\n\n    expect((await request(app).delete(`/folders/${child}`).set(auth(token))).status).toBe(204);\n    expect((await request(app).get(`/folders/${child}`).set(auth(token))).status).toBe(404);\n  });\n\n  it('deletes nested content along with the folder', async () => {\n    const token = await register('alice');\n    const root = await createFolder(token, 'root');\n    const child = await createFolder(token, 'child', root);\n    const doc = await createDocument(token, 'nested', child);\n\n    expect((await request(app).delete(`/folders/${root}`).set(auth(token))).status).toBe(204);\n    expect((await request(app).get(`/folders/${child}`).set(auth(token))).status).toBe(404);\n    expect((await request(app).get(`/documents/${doc}`).set(auth(token))).status).toBe(404);\n  });\n\n  it('refuses to move a folder into its own subtree', async () => {\n    const token = await register('alice');\n    const root = await createFolder(token, 'root');\n    const child = await createFolder(token, 'child', root);\n\n    const res = await request(app)\n      .patch(`/folders/${root}`)\n      .set(auth(token))\n      .send({ parentId: child });\n    expect(res.status).toBe(400);\n  });\n\n  it('404s on unknown folders and parents', async () => {\n    const token = await register('alice');\n    expect((await request(app).get('/folders/nope').set(auth(token))).status).toBe(404);\n    const res = await request(app).post('/folders').set(auth(token)).send({ name: 'x', parentId: 'nope' });\n    expect(res.status).toBe(404);\n  });\n});\n\ndescribe('documents', () => {\n  it('creates documents through both routes and reads them back', async () => {\n    const token = await register('alice');\n    const folder = await createFolder(token, 'work');\n\n    const viaBody = await request(app)\n      .post('/documents')\n      .set(auth(token))\n      .send({ title: 'spec', content: 'v1', folderId: folder });\n    expect(viaBody.status).toBe(201);\n    expect(viaBody.body.folderId).toBe(folder);\n    expect(viaBody.body.ownerId).toBeTruthy();\n\n    const viaFolder = await request(app)\n      .post(`/folders/${folder}/documents`)\n      .set(auth(token))\n      .send({ title: 'notes', content: 'x' });\n    expect(viaFolder.status).toBe(201);\n    expect(viaFolder.body.folderId).toBe(folder);\n\n    const listed = await request(app).get(`/folders/${folder}/documents`).set(auth(token));\n    expect(listed.status).toBe(200);\n    expect(listed.body.documents).toHaveLength(2);\n\n    const read = await request(app).get(`/documents/${viaBody.body.id}`).set(auth(token));\n    expect(read.body.title).toBe('spec');\n    expect(read.body.content).toBe('v1');\n  });\n\n  it('updates and deletes documents', async () => {\n    const token = await register('alice');\n    const doc = await createDocument(token, 'draft');\n\n    const updated = await request(app)\n      .patch(`/documents/${doc}`)\n      .set(auth(token))\n      .send({ content: 'updated body' });\n    expect(updated.status).toBe(200);\n    expect(updated.body.content).toBe('updated body');\n    expect(updated.body.title).toBe('draft');\n\n    expect((await request(app).delete(`/documents/${doc}`).set(auth(token))).status).toBe(204);\n    expect((await request(app).get(`/documents/${doc}`).set(auth(token))).status).toBe(404);\n  });\n\n  it('validates the payload', async () => {\n    const token = await register('alice');\n    const res = await request(app).post('/documents').set(auth(token)).send({ content: 'no title' });\n    expect(res.status).toBe(400);\n  });\n});\n\ndescribe('sharing and permissions', () => {\n  it('hides resources from unrelated users', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const folder = await createFolder(alice, 'private');\n    const doc = await createDocument(alice, 'secret', folder);\n\n    expect((await request(app).get(`/documents/${doc}`).set(auth(bob))).status).toBe(403);\n    expect((await request(app).get(`/folders/${folder}`).set(auth(bob))).status).toBe(403);\n\n    const list = await request(app).get('/documents').set(auth(bob));\n    expect(list.body.documents).toHaveLength(0);\n  });\n\n  it('grants read-only access to viewers', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const doc = await createDocument(alice, 'report');\n\n    const share = await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'viewer' });\n    expect(share.status).toBe(201);\n    expect(share.body.role).toBe('viewer');\n\n    const read = await request(app).get(`/documents/${doc}`).set(auth(bob));\n    expect(read.status).toBe(200);\n    expect(read.body.role).toBe('viewer');\n\n    const write = await request(app)\n      .patch(`/documents/${doc}`)\n      .set(auth(bob))\n      .send({ content: 'nope' });\n    expect(write.status).toBe(403);\n\n    expect((await request(app).delete(`/documents/${doc}`).set(auth(bob))).status).toBe(403);\n\n    const reshare = await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(bob))\n      .send({ username: 'alice', role: 'viewer' });\n    expect(reshare.status).toBe(403);\n  });\n\n  it('lets editors modify and re-share but not delete or grant ownership', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const carol = await register('carol');\n    const doc = await createDocument(alice, 'report');\n\n    await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'editor' });\n\n    const edit = await request(app)\n      .patch(`/documents/${doc}`)\n      .set(auth(bob))\n      .send({ content: 'edited by bob' });\n    expect(edit.status).toBe(200);\n\n    const reshare = await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(bob))\n      .send({ username: 'carol', role: 'viewer' });\n    expect(reshare.status).toBe(201);\n    expect((await request(app).get(`/documents/${doc}`).set(auth(carol))).status).toBe(200);\n\n    const escalate = await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(bob))\n      .send({ username: 'carol', role: 'owner' });\n    expect(escalate.status).toBe(403);\n\n    expect((await request(app).delete(`/documents/${doc}`).set(auth(bob))).status).toBe(403);\n  });\n\n  it('gives co-owners full control', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const doc = await createDocument(alice, 'report');\n\n    await request(app)\n      .post('/share')\n      .set(auth(alice))\n      .send({ resourceType: 'document', resourceId: doc, username: 'bob', role: 'owner' });\n\n    expect((await request(app).delete(`/documents/${doc}`).set(auth(bob))).status).toBe(204);\n  });\n\n  it('inherits access from ancestor folders', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const root = await createFolder(alice, 'root');\n    const mid = await createFolder(alice, 'mid', root);\n    const leaf = await createFolder(alice, 'leaf', mid);\n    const doc = await createDocument(alice, 'deep', leaf);\n\n    await request(app)\n      .post(`/folders/${root}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'viewer' });\n\n    const read = await request(app).get(`/documents/${doc}`).set(auth(bob));\n    expect(read.status).toBe(200);\n    expect(read.body.role).toBe('viewer');\n    expect((await request(app).get(`/folders/${leaf}`).set(auth(bob))).status).toBe(200);\n    expect(\n      (await request(app).patch(`/documents/${doc}`).set(auth(bob)).send({ content: 'x' })).status,\n    ).toBe(403);\n  });\n\n  it('uses the most permissive role across overlapping grants', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const root = await createFolder(alice, 'root');\n    const child = await createFolder(alice, 'child', root);\n    const doc = await createDocument(alice, 'deep', child);\n\n    await request(app)\n      .post(`/folders/${root}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'viewer' });\n    await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'editor' });\n\n    const doc0 = await request(app).get(`/documents/${doc}`).set(auth(bob));\n    expect(doc0.body.role).toBe('editor');\n    expect(\n      (await request(app).patch(`/documents/${doc}`).set(auth(bob)).send({ content: 'ok' })).status,\n    ).toBe(200);\n\n    // A weaker direct share must not shrink the stronger inherited one.\n    await request(app)\n      .post(`/folders/${child}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'owner' });\n    await request(app)\n      .post(`/documents/${doc}/share`)\n      .set(auth(alice))\n      .send({ username: 'bob', role: 'viewer' });\n\n    const doc1 = await request(app).get(`/documents/${doc}`).set(auth(bob));\n    expect(doc1.body.role).toBe('owner');\n    expect((await request(app).delete(`/documents/${doc}`).set(auth(bob))).status).toBe(204);\n  });\n\n  it('revokes shares and lists permissions', async () => {\n    const alice = await register('alice');\n    const bob = await register('bob');\n    const doc = await createDocument(alice, 'report');\n    const bobId = (await request(app).post('/auth/login