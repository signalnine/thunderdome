nd(parentId ? { name, parentId } : { name });\n  expect(res.status).toBe(201);\n  return res.body.id as string;\n}\n\nasync function createDocument(\n  token: string,\n  title: string,\n  folderId?: string,\n  content = 'hello',\n): Promise<string> {\n  const res = await request(app)\n    .post('/documents')\n    .set(auth(token))\n    .send({ title, content, folderId });\n  expect(res.status).toBe(201);\n  return res.body.id as string;\n}\n\nbeforeEach(() => {\n  app = createApp();\n});\n\ndescribe('authentication', () => {\n  it('registers a user and returns a usable token', async () => {\n    const res = await request(app)\n      .post('/auth/register')\n      .send({ username: 'alice', password: 'secret1' });\n\n    expect(res.status).toBe(201);\n    expect(res.body.username).toBe('alice');\n    expect(res.body.id).toBeTruthy();\n    expect(res.body.token).toBeTruthy();\n    expect(JSON.stringify(res.body)).not.toContain('secret1');\n\n    const me = await request(app).get('/me').set(auth(res.body.token));\n    expect(me.status).toBe(200);\n    expect(me.body.username).toBe('alice');\n  });\n\n  it('rejects duplicate usernames and bad payloads', async () => {\n    await register('alice');\n    const dup = await request(app)\n      .post('/auth/register')\n      .send({ username: 'alice', password: 'other' });\n    expect(dup.status).toBe(409);\n\n    const missing = await request(app).post('/auth/register').send({ username: 'bob' });\n    expect(missing.status).toBe(400);\n  });\n\n  it('logs in with valid credentials only', async () => {\n    await register('alice', 'hunter2');\n\n    const ok = await request(app).post('/auth/login').send({ username: 'alice', password: 'hunter2' });\n    expect(ok.status).toBe(200);\n    expect(ok.body.token).toBeTruthy();\n\n    const bad = await request(app).post('/auth/login').send({ username: 'alice', password: 'nope' });\n    expect(bad.status).toBe(401);\n\n    const unknown = await request(app).post('/login').send({ username: 'ghost', password: 'x' });\n    expect(unknown.status).toBe(401);\n  });\n\n  it('requires a valid token for protected routes', async () => {\n    expect((await request(app).get('/folders')).status).toBe(401);\n    expect((await request(app).get('/folders').set(auth('garbage'))).status).toBe(401);\n    expect((await request(app).get('/documents')).status).toBe(401);\n    expect((await request(app).get('/activity')).status).toBe(401);\n  });\n});\n\ndescribe('folders', () => {\n  it('supports nesting and CRUD', async () => {\n    const token = await register('alice');\n    const root = await createFolder(token, 'root');\n    const child = await createFolder(token, 'child', root);\n\n    const res = await request(app).get(`/folders/${child}`).set(auth(token));\n    expect(res.status).toBe(200);\n    expect(res.body.name).toBe('child');\n    expect(res.body.parentId).toBe(root);\n\n    const rootRes = await request(app).get(`/folders/${root}`).set(auth(token));\n    expect(rootRes.body.children).toHaveLength(1);\n\n    const renamed = await request(app)\n      .patch(`/folders/${child}`)\n      .set(auth(token))\n      .send({ name: 'renamed' });\n    expect(renamed.status).toBe(200);\n    expect(renamed.body.name).toBe('renamed');\n\n    expect((await request(app).delete(`/folders/${child}`).set(auth(token))).status).toBe(204);\n    expect((await request(app).get(`/folders/${child}`).set(auth(token))).status).toBe(404);\n  });\n\n  it('deletes nested content along with the folder', async () => {\n    const token = await register('alice');\n    const root = await createFolder(token, 'root');\n    const child = await createFolder(token, 'child', root);\n    const doc = await createDocument(token, 'nested', child);\n\n    expect((await request(app).delete(`/folders/${root}`).set(auth(token))).status).toBe(204);\n    expect((await request(app).get(`/folders/${child}`).set(auth(token))).status).toBe(404);\n    expect((await request(app).get(`/documents/${doc}`).set(auth(token))).status).toBe(404);\n  });\n\n  it('refuses to move a folder into its own subtree', async () => {\n    const token = await register('alice');\n    const root = await createFolder(token, 'root');\n    const child = await createFolder(token, 'child', root);\n\n    const res = await request(app)\n      .patch(`/folders/${root}`)\n      .set(auth(token))\n      .send({ parentId: child });\n    expect(res.status).toBe(400);\n  });\n\n  it('404s on unknown folders and parents', async () => {\n    const token = await register('alice');\n    expect((await request(app).get('/folders/nope').set(auth(token))).status).toBe(404);\n    const res = await request(app).post('/folders').set(auth(token)).send({ name: 'x', parentId: 'nope' });\n    expect(res.status).toBe(404);\n  });\n});\n\ndescribe('documents', () => {\n  it('creates documents through both routes and reads them back', async () => {\n    const token = await register('alice');\n    const folder = await createFolder(token, 'work');\n\n    const viaBody = await request(app)\n      .post('/documents')\n      .set(auth(token))\n      .send({ title: 'spec', content: 'v1', folderId: folder });\n    expect(viaBody.status).toBe(201);\n    expect(viaBody.body.folderId).toBe(folder);\n    expect(viaBody.body.ownerId).toBeTruthy();\n\n    const viaFolder = await request(app)\n      .post(`/folders/${folder}/documents`)\n      .set(auth(token))\n      .send({ title: 'notes', content: 'x' });\n    expect(viaFolder.status).toBe(201);\n    expect(viaFolder.body.folderId).toBe(folder);\n\n    const listed = await request(app).get(`/folders/${folder}/documents`).set(auth(token));\n    expect(listed.status).toBe(200);\n    expect(listed.body.documents).toHaveLength(2);\n\n    const read = await request(app).get(`/documents/${viaBody.body.id}`).set(auth(token));\n    expect(read.body.title).toBe('spec');\n    expect(read.body.content).toBe('v1');\n  });\n\n  it('updates and deletes documents', async () => {\n    const token 