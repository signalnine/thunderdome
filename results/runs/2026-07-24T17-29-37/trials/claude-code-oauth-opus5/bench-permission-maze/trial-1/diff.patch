+import { pathToFileURL } from 'node:url';
+import { createApp } from './app.js';
+
+export { createApp } from './app.js';
+export { Store } from './store.js';
+export * from './types.js';
+export * from './permissions.js';
+
+/** Starts the API on the given port; used by `npm start` / direct execution. */
+export function startServer(port = Number(process.env.PORT ?? 3000)) {
+  const app = createApp();
+  return app.listen(port, () => {
+    // eslint-disable-next-line no-console
+    console.log(`Document API listening on port ${port}`);
+  });
+}
+
+const entry = process.argv[1] ? pathToFileURL(process.argv[1]).href : '';
+if (entry === import.meta.url) {
+  startServer();
+}
+
+export default createApp;
diff --git a/src/permissions.ts b/src/permissions.ts
new file mode 100644
index 0000000..8b55bdc
--- /dev/null
+++ b/src/permissions.ts
@@ -0,0 +1,115 @@
+import type { Store } from './store.js';
+import type { ResourceType, Role } from './types.js';
+
+export const ROLE_RANK: Record<Role, number> = { viewer: 1, editor: 2, owner: 3 };
+
+export const ROLES: Role[] = ['viewer', 'editor', 'owner'];
+
+export function isRole(value: unknown): value is Role {
+  return typeof value === 'string' && (ROLES as string[]).includes(value);
+}
+
+export function maxRole(a: Role | null, b: Role | null): Role | null {
+  if (!a) return b;
+  if (!b) return a;
+  return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;
+}
+
+export function atLeast(role: Role | null, required: Role): boolean {
+  return role !== null && ROLE_RANK[role] >= ROLE_RANK[required];
+}
+
+/** Role granted straight on the resource, ignoring folder inheritance. */
+function directRole(
+  store: Store,
+  userId: string,
+  resourceType: ResourceType,
+  resourceId: string,
+): Role | null {
+  const resource =
+    resourceType === 'folder' ? store.folders.get(resourceId) : store.documents.get(resourceId);
+  if (!resource) return null;
+  const creatorRole: Role | null = resource.ownerId === userId ? 'owner' : null;
+  const share = store.findShare(resourceType, resourceId, userId);
+  return maxRole(creatorRole, share ? share.role : null);
+}
+
+/** Best role held anywhere along a folder's ancestor chain (inclusive). */
+function folderChainRole(store: Store, userId: string, folderId: string | null): Role | null {
+  let best: Role | null = null;
+  const seen = new Set<string>();
+  let current = folderId;
+  while (current && !seen.has(current)) {
+    seen.add(current);
+    const folder = store.folders.get(current);
+    if (!folder) break;
+    best = maxRole(best, directRole(store, userId, 'folder', current));
+    if (best === 'owner') break;
+    current = folder.parentId;
+  }
+  return best;
+}
+
+/**
+ * The most permissive role a user holds on a resource, combining direct shares,
+ * creator ownership, and every share inherited from ancestor folders.
+ */
+export function effectiveRole(
+  store: Store,
+  userId: string,
+  resourceType: ResourceType,
+  resourceId: string,
+): Role | null {
+  if (resourceType === 'folder') {
+    return store.folders.has(resourceId) ? folderChainRole(store, userId, resourceId) : null;
+  }
+  const document = store.documents.get(resourceId);
+  if (!document) return null;
+  return maxRole(
+    directRole(store, userId, 'document', resourceId),
+    folderChainRole(store, userId, document.folderId),
+  );
+}
+
+export function canRead(store: Store, userId: string, type: ResourceType, id: string): boolean {
+  return atLeast(effectiveRole(store, userId, type, id), 'viewer');
+}
+
+export function canWrite(store: Store, userId: string, type: ResourceType, id: string): boolean {
+  return atLeast(effectiveRole(store, userId, type, id), 'editor');
+}
+
+/** Editors and owners may share; only owners may hand out the owner role. */
+export function canShare(store: Store, userId: string, type: ResourceType, id: string): boolean {
+  return atLeast(effectiveRole(store, userId, type, id), 'editor');
+}
+
+export function canDelete(store: Store, userId: string, type: ResourceType, id: string): boolean {
+  return atLeast(effectiveRole(store, userId, type, id), 'owner');
+}
+
+/** All descendant folder ids of a folder, plus the folder itself. */
+export function folderSubtree(store: Store, folderId: string): string[] {
+  const collected: string[] = [];
+  const queue = [folderId];
+  const seen = new Set<string>();
+  while (queue.length > 0) {
+    const current = queue.shift() as string;
+    if (seen.has(current)) continue;
+    seen.add(current);
+    collected.push(current);
+    for (const folder of store.folders.values()) {
+      if (folder.parentId === current) queue.push(folder.id);
+    }
+  }
+  return collected;
+}
+
+/** True when `candidateParentId` sits inside the subtree rooted at `folderId`. */
+export function isDescendantOf(
+  store: Store,
+  candidateParentId: string,
+  folderId: string,
+): boolean {
+  return folderSubtree(store, folderId).includes(candidateParentId);
+}
