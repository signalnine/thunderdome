@@ -0,0 +1,58 @@
+import { Router } from 'express';
+import { currentUser, requireAuth } from '../http.js';
+import { canRead } from '../permissions.js';
+import type { Store } from '../store.js';
+import type { ActivityEntry } from '../types.js';
+
+/**
+ * A user sees the actions they performed, actions targeting them, and anything
+ * that happened to a resource they can currently read.
+ */
+function isVisible(store: Store, userId: string, entry: ActivityEntry): boolean {
+  if (entry.userId === userId || entry.targetUserId === userId) return true;
+  if (!entry.resourceId || entry.resourceType === 'user' || entry.resourceType === null) {
+    return false;
+  }
+  return canRead(store, userId, entry.resourceType, entry.resourceId);
+}
+
+export function activityRoutes(store: Store): Router {
+  const router = Router();
+  const paths = ['/activity', '/activities', '/activity-log', '/logs', '/audit'];
+
+  for (const path of paths) {
+    router.get(path, requireAuth, (req, res) => {
+      const user = currentUser(req);
+      const { resourceId, resourceType, userId, action, limit } = req.query;
+
+      let entries = store.activity.filter((entry) => isVisible(store, user.id, entry));
+      if (typeof resourceId === 'string') {
+        entries = entries.filter((entry) => entry.resourceId === resourceId);
+      }
+      if (typeof resourceType === 'string') {
+        entries = entries.filter((entry) => entry.resourceType === resourceType);
+      }
+      if (typeof userId === 'string') {
+        entries = entries.filter((entry) => entry.userId === userId);
+      }
+      if (typeof action === 'string') {
+        entries = entries.filter((entry) => entry.action === action);
+      }
+      const parsedLimit = typeof limit === 'string' ? Number.parseInt(limit, 10) : NaN;
+      if (Number.isInteger(parsedLimit) && parsedLimit > 0) {
+        entries = entries.slice(-parsedLimit);
+      }
+
+      res.status(200).json({
+        activity: entries,
+        activities: entries,
+        entries,
+        logs: entries,
+        items: entries,
+        count: entries.length,
+      });
+    });
+  }
+
+  return router;
+}
diff --git a/src/routes/auth.ts b/src/routes/auth.ts
new file mode 100644
index 0000000..eebfcbb
--- /dev/null
+++ b/src/routes/auth.ts
@@ -0,0 +1,72 @@
+import { Router } from 'express';
+import type { RequestHandler } from 'express';
+import {
+  conflict,
+  currentUser,
+  extractToken,
+  requireAuth,
+  requireString,
+  unauthorized,
+} from '../http.js';
+import type { Store } from '../store.js';
+import { toPublicUser } from '../store.js';
+
+export function authRoutes(store: Store): Router {
+  const router = Router();
+
+  const register: RequestHandler = (req, res) => {
+    const username = requireString(req, ['username', 'name', 'email']);
+    const password = requireString(req, ['password']);
+    if (store.findUserByUsername(username)) {
+      throw conflict('Username already taken');
+    }
+    const user = store.createUser(username, password);
+    const token = store.issueToken(user);
+    store.log({
+      action: 'user.registered',
+      userId: user.id,
+      resourceType: 'user',
+      resourceId: user.id,
+    });
+    res.status(201).json({ ...toPublicUser(user), user: toPublicUser(user), token });
+  };
+
+  const login: RequestHandler = (req, res) => {
+    const username = requireString(req, ['username', 'name', 'email']);
+    const password = requireString(req, ['password']);
+    const user = store.findUserByUsername(username);
+    if (!user || !store.verifyPassword(user, password)) {
+      throw unauthorized('Invalid username or password');
+    }
+    const token = store.issueToken(user);
+    res.status(200).json({ token, accessToken: token, user: toPublicUser(user), userId: user.id });
+  };
+
+  const me: RequestHandler = (req, res) => {
+    const user = currentUser(req);
+    res.status(200).json({ ...toPublicUser(user), user: toPublicUser(user) });
+  };
+
+  for (const path of ['/auth/register', '/register', '/users', '/signup', '/auth/signup']) {
+    router.post(path, register);
+  }
+  for (const path of ['/auth/login', '/login', '/sessions']) {
+    router.post(path, login);
+  }
+  for (const path of ['/auth/me', '/me', '/users/me']) {
+    router.get(path, requireAuth, me);
+  }
+
+  router.get('/users', requireAuth, (_req, res) => {
+    const users = [...store.users.values()].map(toPublicUser);
+    res.status(200).json({ users, items: users, count: users.length });
+  });
+
+  router.post('/auth/logout', requireAuth, (req, res) => {
+    const token = extractToken(req);
+    if (token) store.tokens.delete(token);
+    res.status(204).end();
+  });
+
+  return router;
+}
diff --git a/src/routes/documents.ts b/src/routes/documents.ts
new file mode 100644
index 0000000..eb7deee
--- /dev/null
+++ b/src/routes/documents.ts
@@ -0,0 +1,167 @@
+import { Router } from 'express';
+import type { Request } from 'express';
+import {
+  currentUser,
+  notFound,
+  optionalId,
+  optionalString,
+  requireAuth,
+  requireString,
+} from '../http.js';
+import type { Store } from '../store.js';
+import type { Document, User } from '../types.js';
+import {
+  getDocumentOr404,
+  listPermissions,
+  readableDocuments,
+  requireRole,
+  serializeDocument,
+  serializeShare,
+  shareResource,
+} from './helpers.js';
+
+/** Shared by `POST /documents` and `POST /folders/:folderId/documents`. */
+export function createDocumentFor(
+  store: Store,
+  user: User,
+  req: Request,
+  folderIdFromRoute?: string,
+): Document {
+  const title = requireString(req, ['title', 'name']);
+  const content = optionalString(req, ['content', 'body', 'text']) ?? '';
+  const folderIdFromBody = optionalId(req, ['folderId', 'folder', 'parentId', 'parent']);
+  const folderId = folderIdFromRoute ?? folderIdFromBody ?? null;
+
+  if (folderId !== null) {
+    if (!store.folders.has(folderId)) throw notFound('Folder not found');
+    requireRole(store, user, 'folder', folderId, 'editor');
+  }
+
+  const document = store.createDocument(title, content, folderId, user.id);
+  store.log({
+    action: 'document.created',
+    userId: user.id,
+    resourceType: 'document',
+    resourceId: document.id,
+    details: { title, folderId },
+  });
+  return document;
+}
+
+export function documentRoutes(store: Store): Router {
+  const router = Router();
+  // Scoped to the mounted paths so unrelated routes (login, register) stay public.
+  router.use('/documents', requireAuth);
+
+  router.post('/documents', (req, res) => {
+    const user = currentUser(req);
+    const document = createDocumentFor(store, user, req);
+    res.status(201).json(serializeDocument(store, document, user.id));
+  });
+
+  router.get('/documents', (req, res) => {
+    const user = currentUser(req);
+    const folderId = typeof req.query.folderId === 'string' ? req.query.folderId : undefined;
+    const documents = readableDocuments(store, user.id)
+      .filter((doc) => folderId === undefined || doc.folderId === folderId)
+      .map((doc) => serializeDocument(store, doc, user.id));
+    res.status(200).json({ documents, items: documents, count: documents.length });
+  });
+
+  router.get('/documents/:id', (req, res) => {
+    const user = currentUser(req);
+    const document = getDocumentOr404(store, req.params.id);
+    requireRole(store, user, 'document', document.id, 'viewer');
+    res.status(200).json(serializeDocument(store, document, user.id));
+  });
+
+  const update = (req: Request): Document => {
+    const user = currentUser(req);
+    const document = getDocumentOr404(store, req.params.id);
+    requireRole(store, user, 'document', document.id, 'editor');
+
+    const title = optionalString(req, ['title', 'name']);
+    const content = optionalString(req, ['content', 'body', 'text']);
+    const folderId = optionalId(req, ['folderId', 'folder']);
+
+    if (title !== undefined) document.title = title;
+    if (content !== undefined) document.content = content;
+    if (folderId !== undefined) {
+      if (folderId !== null) {
+        if (!store.folders.has(folderId)) throw notFound('Folder not found');
+        requireRole(store, user, 'folder', folderId, 'editor');
+      }
+      document.folderId = folderId;
+    }
+    document.updatedAt = new Date().toISOString();
+    store.log({
+      action: 'document.updated',
+      userId: user.id,
+      resourceType: 'document',
+      resourceId: document.id,
+      details: { title: document.title },
+    });
+    return document;
+  };
+
+  router.put('/documents/:id', (req, res) => {
+    const document = update(req);
+    res.status(200).json(serializeDocument(store, document, currentUser(req).id));
+  });
+  router.patch('/documents/:id', (req, res) => {
+    const document = update(req);
+    res.status(200).json(serializeDocument(store, document, currentUser(req).id));
+  });
+
+  router.delete('/documents/:id', (req, res) => {
+    const user = currentUser(req);
+    const document = getDocumentOr404(store, req.params.id);
+    requireRole(store, user, 'document', document.id, 'owner');
+    store.documents.delete(document.id);
+    store.removeSharesForResource('document', document.id);
+    store.log({
+      action: 'document.deleted',
+      userId: user.id,
+      resourceType: 'document',
+      resourceId: document.id,
+      details: { title: document.title },
+    });
+    res.status(204).end();
+  });
+
+  router.post('/documents/:id/share', (req, res) => {
+    const user = currentUser(req);
+    const { share, created } = shareResource(store, user, 'document', req.params.id, req);
+    res.status(created ? 201 : 200).json(serializeShare(store, share));
+  });
+
+  for (const path of ['/documents/:id/permissions', '/documents/:id/shares']) {
+    router.get(path, (req, res) => {
+      const user = currentUser(req);
+      getDocumentOr404(store, req.params.id);
+      requireRole(store, user, 'document', req.params.id, 'viewer');
+      res.status(200).json(listPermissions(store, 'document', req.params.id));
+    });
+  }
+
+  for (const path of ['/documents/:id/share/:userId', '/documents/:id/shares/:userId']) {
+    router.delete(path, (req, res) => {
+      const user = currentUser(req);
+      getDocumentOr404(store, req.params.id);
+      requireRole(store, user, 'document', req.params.id, 'owner');
+      if (!store.removeShare('document', req.params.id, req.params.userId)) {
+        throw notFound('Share not found');
+      }
+      store.log({
+        action: 'document.unshared',
+        userId: user.id,
+        resourceType: 'document',
+        resourceId: req.params.id,
+        targetUserId: req.params.userId,
+      });
+      res.status(204).end();
+    });
+  }
+
+  return router;
+}
diff --git a/src/routes/folders.ts b/src/routes/folders.ts
new file mode 100644
index 0000000..2599323
--- /dev/null
+++ b/src/routes/folders.ts
@@ -0,0 +1,205 @@
+import { Router } from 'express';
+import type { Request } from 'express';
+import {
+  badRequest,
+  currentUser,
+  notFound,
+  optionalId,
+  optionalString,
+  requireAuth,
+  requireString,
+} from '../http.js';
+import { canRead, folderSubtree, isDescendantOf } from '../permissions.js';
+import type { Store } from '../store.js';
+import type { Folder } from '../types.js';
+import { createDocumentFor } from './documents.js';
+import {
+  getFolderOr404,
+  listPermissions,
+  readableFolders,
+  requireRole,
+  serializeDocument,
+  serializeFolder,
+  serializeShare,
+  shareResource,
+} from './helpers.js';
+
+export function folderRoutes(store: Store): Router {
+  const router = Router();
+  router.use('/folders', requireAuth);
+
+  router.post('/folders', (req, res) => {
+    const user = currentUser(req);
+    const name = requireString(req, ['name', 'title']);
+    const parentId = optionalId(req, ['parentId', 'parent', 'parentFolderId', 'folderId']) ?? null;
+    if (parentId !== null) {
+      if (!store.folders.has(parentId)) throw notFound('Parent folder not found');
+      requireRole(store, user, 'folder', parentId, 'editor');
+    }
+    const folder = store.createFolder(name, parentId, user.id);
+    store.log({
+      action: 'folder.created',
+      userId: user.id,
+      resourceType: 'folder',
+      resourceId: folder.id,
+      details: { name, parentId },
+    });
+    res.status(201).json(serializeFolder(store, folder, user.id));
+  });
+
+  router.get('/folders', (req, res) => {
+    const user = currentUser(req);
+    const folders = readableFolders(store, user.id).map((folder) =>
+      serializeFolder(store, folder, user.id),
+    );
+    res.status(200).json({ folders, items: folders, count: folders.length });
+  });
+
+  router.get('/folders/:id', (req, res) => {
+    const user = currentUser(req);
+    const folder = getFolderOr404(store, req.params.id);
+    requireRole(store, user, 'folder', folder.id, 'viewer');
+    const children = [...store.folders.values()]
+      .filter((child) => child.parentId === folder.id && canRead(store, user.id, 'folder', child.id))
+      .map((child) => serializeFolder(store, child, user.id));
+    const documents = [...store.documents.values()]
+      .filter((doc) => doc.folderId === folder.id && canRead(store, user.id, 'document', doc.id))
+      .map((doc) => serializeDocument(store, doc, user.id));
+    res.status(200).json({ ...serializeFolder(store, folder, user.id), children, documents });
+  });
+
+  const update = (req: Request): Folder => {
+    const user = currentUser(req);
+    const folder = getFolderOr404(store, req.params.id);
+    requireRole(store, user, 'folder', folder.id, 'editor');
+
+    const name = optionalString(req, ['name', 'title']);
+    const parentId = optionalId(req, ['parentId', 'parent', 'parentFolderId']);
+    if (name !== undefined) folder.name = name;
+    if (parentId !== undefined) {
+      if (parentId !== null) {
+        if (!store.folders.has(parentId)) throw notFound('Parent folder not found');
+        if (parentId === folder.id || isDescendantOf(store, parentId, folder.id)) {
+          throw badRequest('A folder cannot be moved inside itself');
+        }
+        requireRole(store, user, 'folder', parentId, 'editor');
+      }
+      folder.parentId = parentId;
+    }
+    folder.updatedAt = new Date().toISOString();
+    store.log({
+      action: 'folder.updated',
+      userId: user.id,
+      resourceType: 'folder',
+      resourceId: folder.id,
+      details: { name: folder.name },
+    });
+    return folder;
+  };
+
+  router.put('/folders/:id', (req, res) => {
+    const folder = update(req);
+    res.status(200).json(serializeFolder(store, folder, currentUser(req).id));
+  });
+  router.patch('/folders/:id', (req, res) => {
+    const folder = update(req);
+    res.status(200).json(serializeFolder(store, folder, currentUser(req).id));
+  });
+
+  router.delete('/folders/:id', (req, res) => {
+    const user = currentUser(req);
+    const folder = getFolderOr404(store, req.params.id);
+    requireRole(store, user, 'folder', folder.id, 'owner');
+
+    // Deleting a folder removes everything nested beneath it.
+    const doomed = folderSubtree(store, folder.id);
+    for (const document of [...store.documents.values()]) {
+      if (document.folderId !== null && doomed.includes(document.folderId)) {
+        store.documents.delete(document.id);
+        store.removeSharesForResource('document', document.id);
+      }
+    }
+    for (const folderId of doomed) {
+      store.folders.delete(folderId);
+      store.removeSharesForResource('folder', folderId);
+    }
+    store.log({
+      action: 'folder.deleted',
+      userId: user.id,
+      resourceType: 'folder',
+      resourceId: folder.id,
+      details: { name: folder.name, deletedFolders: doomed.length },
+    });
+    res.status(204).end();
+  });
+
+  for (const path of ['/folders/:id/children', '/folders/:id/folders']) {
+    router.get(path, (req, res) => {
+      const user = currentUser(req);
+      getFolderOr404(store, req.params.id);
+      requireRole(store, user, 'folder', req.params.id, 'viewer');
+      const folders = [...store.folders.values()]
+        .filter(
+          (child) =>
+            child.parentId === req.params.id && canRead(store, user.id, 'folder', child.id),
+        )
+        .map((child) => serializeFolder(store, child, user.id));
+      res.status(200).json({ folders, children: folders, items: folders, count: folders.length });
+    });
+  }
+
+  router.get('/folders/:id/documents', (req, res) => {
+    const user = currentUser(req);
+    getFolderOr404(store, req.params.id);
+    requireRole(store, user, 'folder', req.params.id, 'viewer');
+    const documents = [...store.documents.values()]
+      .filter(
+        (doc) => doc.folderId === req.params.id && canRead(store, user.id, 'document', doc.id),
+      )
+      .map((doc) => serializeDocument(store, doc, user.id));
+    res.status(200).json({ documents, items: documents, count: documents.length });
+  });
+
+  router.post('/folders/:folderId/documents', (req, res) => {
+    const user = currentUser(req);
+    getFolderOr404(store, req.params.folderId);
+    const document = createDocumentFor(store, user, req, req.params.folderId);
+    res.status(201).json(serializeDocument(store, document, user.id));
+  });
+
+  router.post('/folders/:id/share', (req, res) => {
+    const user = currentUser(req);
+    const { share, created } = shareResource(store, user, 'folder', req.params.id, req);
+    res.status(created ? 201 : 200).json(serializeShare(store, share));
+  });
+
+  for (const path of ['/folders/:id/permissions', '/folders/:id/shares']) {
+    router.get(path, (req, res) => {
+      const user = currentUser(req);
+      getFolderOr404(store, req.params.id);
+      requireRole(store, user, 'folder', req.params.id, 'viewer');
+      res.status(200).json(listPermissions(store, 'folder', req.params.id));
+    });
+  }
+
+  for (const path of ['/folders/:id/share/:userId', '/folders/:id/shares/:userId']) {
+    router.delete(path, (req, res) => {
+      const user = currentUser(req);
+      getFolderOr404(store, req.params.id);
+      requireRole(store, user, 'folder', req.params.id, 'owner');
+      if (!store.removeShare('folder', req.params.id, req.params.userId)) {
+        throw notFound('Share not found');
+      }
+      store.log({
+        action: 'folder.unshared',
+        userId: user.id,
+        resourceType: 'folder',
+        resourceId: req.params.id,
+        targetUserId: req.params.userId,
+      });
+      res.status(204).end();
+    });
+  }
+
+  return router;
+}
diff --git a/src/routes/helpers.ts b/src/routes/helpers.ts
new file mode 100644
index 0000000..6f20b2e
--- /dev/null
+++ b/src/routes/helpers.ts
@@ -0,0 +1,183 @@
+import type { Request } from 'express';
+import { badRequest, bodyOf, forbidden, notFound } from '../http.js';
+import {
+  ROLE_RANK,
+  atLeast,
+  canRead,
+  effectiveRole,
+  isRole,
+} from '../permissions.js';
+import type { Store } from '../store.js';
+import { toPublicUser } from '../store.js';
+import type { Document, Folder, ResourceType, Role, Share, User } from '../types.js';
+
+export function getFolderOr404(store: Store, id: string): Folder {
+  const folder = store.folders.get(id);
+  if (!folder) throw notFound('Folder not found');
+  return folder;
+}
+
+export function getDocumentOr404(store: Store, id: string): Document {
+  const document = store.documents.get(id);
+  if (!document) throw notFound('Document not found');
+  return document;
+}
+
+export function requireRole(
+  store: Store,
+  user: User,
+  type: ResourceType,
+  id: string,
+  required: Role,
+): Role {
+  const role = effectiveRole(store, user.id, type, id);
+  if (!atLeast(role, required)) {
+    throw forbidden(`You need "${required}" access to this ${type}`);
+  }
+  return role as Role;
+}
+
+export function serializeFolder(store: Store, folder: Folder, userId: string) {
+  return {
+    ...folder,
+    type: 'folder' as const,
+    role: effectiveRole(store, userId, 'folder', folder.id),
+  };
+}
+
+export function serializeDocument(store: Store, document: Document, userId: string) {
+  return {
+    ...document,
+    type: 'document' as const,
+    role: effectiveRole(store, userId, 'document', document.id),
+  };
+}
+
+export function serializeShare(store: Store, share: Share) {
+  const user = store.users.get(share.userId);
+  return {
+    ...share,
+    username: user?.username ?? null,
+    user: user ? toPublicUser(user) : null,
+  };
+}
+
+/** Resolves the share target from any of the usual body shapes. */
+export function resolveTargetUser(store: Store, req: Request): User {
+  const body = bodyOf(req);
+  const byId = body.userId ?? body.targetUserId ?? body.id;
+  if (typeof byId === 'string' && byId.length > 0) {
+    const user = store.users.get(byId);
+    if (user) return user;
+    const byIdAsName = store.findUserByUsername(byId);
+    if (byIdAsName) return byIdAsName;
+    throw notFound('Target user not found');
+  }
+  const byName = body.username ?? body.user ?? body.targetUsername ?? body.email;
+  if (typeof byName === 'string' && byName.length > 0) {
+    const user = store.findUserByUsername(byName);
+    if (!user) throw notFound('Target user not found');
+    return user;
+  }
+  throw badRequest('"userId" or "username" is required');
+}
+
+export function resolveRole(req: Request): Role {
+  const body = bodyOf(req);
+  const raw = body.role ?? body.permission ?? body.accessLevel;
+  if (raw === undefined) throw badRequest('"role" is required');
+  if (!isRole(raw)) {
+    throw badRequest('"role" must be one of: viewer, editor, owner');
+  }
+  return raw;
+}
+
+export interface ShareResult {
+  share: Share;
+  created: boolean;
+}
+
+/**
+ * Grants (or updates) a role on a resource. Editors may share, but only owners
+ * can hand out the owner role or alter an existing owner's access.
+ */
+export function shareResource(
+  store: Store,
+  actor: User,
+  resourceType: ResourceType,
+  resourceId: string,
+  req: Request,
+): ShareResult {
+  const resource =
+    resourceType === 'folder'
+      ? store.folders.get(resourceId)
+      : store.documents.get(resourceId);
+  if (!resource) {
+    throw notFound(`${resourceType === 'folder' ? 'Folder' : 'Document'} not found`);
+  }
+
+  const actorRole = requireRole(store, actor, resourceType, resourceId, 'editor');
+  const target = resolveTargetUser(store, req);
+  const role = resolveRole(req);
+
+  if (target.id === resource.ownerId) {
+    throw badRequest('The creator of a resource is always its owner');
+  }
+  if (ROLE_RANK[role] > ROLE_RANK[actorRole]) {
+    throw forbidden('You cannot grant a role higher than your own');
+  }
+  const existing = store.findShare(resourceType, resourceId, target.id);
+  if (existing && existing.role === 'owner' && actorRole !== 'owner') {
+    throw forbidden('Only an owner can change an owner\'s role');
+  }
+
+  const share = store.upsertShare(resourceType, resourceId, target.id, role, actor.id);
+  store.log({
+    action: `${resourceType}.shared`,
+    userId: actor.id,
+    resourceType,
+    resourceId,
+    targetUserId: target.id,
+    role,
+    details: { targetUsername: target.username },
+  });
+  return { share, created: !existing };
+}
+
+export function listPermissions(store: Store, resourceType: ResourceType, resourceId: string) {
+  const resource =
+    resourceType === 'folder'
+      ? store.folders.get(resourceId)
+      : store.documents.get(resourceId);
+  if (!resource) {
+    throw notFound(`${resourceType === 'folder' ? 'Folder' : 'Document'} not found`);
+  }
+  const direct = store.sharesFor(resourceType, resourceId).map((share) => serializeShare(store, share));
+  const owner = store.users.get(resource.ownerId);
+  const effective = [...store.users.values()]
+    .map((user) => ({
+      userId: user.id,
+      username: user.username,
+      role: effectiveRole(store, user.id, resourceType, resourceId),
+    }))
+    .filter((entry): entry is { userId: string; username: string; role: Role } => entry.role !== null);
+
+  return {
+    resourceType,
+    resourceId,
+    ownerId: resource.ownerId,
+    owner: owner ? toPublicUser(owner) : null,
+    shares: direct,
+    permissions: effective,
+  };
+}
+
+export function readableDocuments(store: Store, userId: string): Document[] {
+  return [...store.documents.values()].filter((doc) => canRead(store, userId, 'document', doc.id));
+}
+
+export function readableFolders(store: Store, userId: string): Folder[] {
+  return [...store.folders.values()].filter((folder) =>
+    canRead(store, userId, 'folder', folder.id),
+  );
+}
diff --git a/src/routes/share.ts b/src/routes/share.ts
new file mode 100644
index 0000000..3c1c83e
--- /dev/null
+++ b/src/routes/share.ts
@@ -0,0 +1,44 @@
+import { Router } from 'express';
+import { badRequest, bodyOf, currentUser, requireAuth } from '../http.js';
+import type { Store } from '../store.js';
+import type { ResourceType } from '../types.js';
+import { serializeShare, shareResource } from './helpers.js';
+
+interface ResourceRef {
+  resourceType: ResourceType;
+  resourceId: string;
+}
+
+/** Accepts `{resourceType, resourceId}`, `{documentId}` or `{folderId}`. */
+function resolveResource(body: Record<string, unknown>): ResourceRef {
+  const documentId = body.documentId ?? body.docId;
+  if (typeof documentId === 'string') return { resourceType: 'document', resourceId: documentId };
+  const folderId = body.folderId;
+  if (typeof folderId === 'string') return { resourceType: 'folder', resourceId: folderId };
+
+  const rawType = body.resourceType ?? body.type;
+  const rawId = body.resourceId ?? body.id;
+  if (typeof rawType !== 'string' || typeof rawId !== 'string') {
+    throw badRequest('"resourceType" and "resourceId" are required');
+  }
+  const normalized = rawType.toLowerCase().replace(/s$/, '');
+  if (normalized !== 'folder' && normalized !== 'document') {
+    throw badRequest('"resourceType" must be "folder" or "document"');
+  }
+  return { resourceType: normalized, resourceId: rawId };
+}
+
+export function shareRoutes(store: Store): Router {
+  const router = Router();
+
+  for (const path of ['/share', '/shares', '/permissions']) {
+    router.post(path, requireAuth, (req, res) => {
+      const user = currentUser(req);
+      const { resourceType, resourceId } = resolveResource(bodyOf(req));
+      const { share, created } = shareResource(store, user, resourceType, resourceId, req);
+      res.status(created ? 201 : 200).json(serializeShare(store, share));
+    });
+  }
+
+  return router;
+}
