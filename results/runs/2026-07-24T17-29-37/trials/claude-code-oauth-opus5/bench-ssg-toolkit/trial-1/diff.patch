+import { BuildContext, Plugin } from '../core/types.js';
+import { ASSET_MANIFEST_KEY, AssetManifest } from './asset-pipeline.js';
+import { SEARCH_INDEX_PATH } from './search-index.js';
+
+export const DEV_SERVER_CONFIG_KEY = 'dev-server-config';
+const DEFAULT_PORT = 3000;
+
+/** How the dev server should serve a route. */
+export type RouteHandler = 'static' | 'asset' | 'search' | 'file';
+
+export interface DevServerRoute {
+  path: string;
+  handler: RouteHandler;
+}
+
+export interface DevServerConfig {
+  port: number;
+  routes: DevServerRoute[];
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+function handlerFor(outputPath: string): RouteHandler {
+  if (outputPath === SEARCH_INDEX_PATH) return 'search';
+  if (outputPath.endsWith('.html')) return 'static';
+  return 'file';
+}
+
+function readAssetPaths(ctx: BuildContext): string[] {
+  const manifest = ctx.data.get(ASSET_MANIFEST_KEY) as AssetManifest | undefined;
+  return Array.isArray(manifest?.assets) ? [...manifest.assets] : [];
+}
+
+/**
+ * Describes the routing table a dev server needs to serve this build: one route
+ * per output file, one per pipeline asset, and where the search index lives.
+ * Config only — starting a server is left to the caller.
+ */
+export function createDevServerPlugin(
+  options: { port?: number; assetPrefix?: string } = {}
+): Plugin {
+  const port = options.port ?? DEFAULT_PORT;
+  const assetPrefix = options.assetPrefix ?? '/assets';
+
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const assetPaths = readAssetPaths(ctx);
+
+        const routes: DevServerRoute[] = [
+          ...[...ctx.output.keys()].map(outputPath => ({
+            path: `/${outputPath}`,
+            handler: handlerFor(outputPath),
+          })),
+          ...assetPaths.map((asset): DevServerRoute => ({
+            path: `${assetPrefix}/${asset}`,
+            handler: 'asset',
+          })),
+        ];
+
+        const config: DevServerConfig = {
+          port,
+          routes,
+          assetPaths,
+          searchIndexPath: `/${SEARCH_INDEX_PATH}`,
+        };
+
+        ctx.data.set(DEV_SERVER_CONFIG_KEY, config);
+      },
+    },
+  };
+}
