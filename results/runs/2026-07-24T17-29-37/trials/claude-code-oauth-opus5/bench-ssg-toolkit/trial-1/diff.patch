+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { cdata, escapeXml, getDataMap, normalizeBaseUrl } from './shared.js';
+import { TAG_INDEX_KEY } from './taxonomy.js';
+
+/** Undated posts sort last rather than being dropped from the feed. */
+const NO_DATE = Number.NEGATIVE_INFINITY;
+
+function timestampOf(file: ContentFile): number {
+  if (!file.date) return NO_DATE;
+  const parsed = Date.parse(file.date);
+  return Number.isNaN(parsed) ? NO_DATE : parsed;
+}
+
+function toPubDate(file: ContentFile): string | null {
+  const timestamp = timestampOf(file);
+  return timestamp === NO_DATE ? null : new Date(timestamp).toUTCString();
+}
+
+/**
+ * Categories come from the taxonomy index when it is available — that is the
+ * normalized view of the site's tags — and fall back to the file's own tags.
+ */
+function categoriesOf(file: ContentFile, ctx: BuildContext): string[] {
+  const categories: string[] = [];
+  const add = (term: string) => {
+    if (term && !categories.includes(term)) categories.push(term);
+  };
+
+  const tagIndex = getDataMap<ContentFile[]>(ctx.data, TAG_INDEX_KEY);
+  if (tagIndex) {
+    for (const [tag, files] of tagIndex) {
+      if (files.some(tagged => tagged.slug === file.slug)) add(tag);
+    }
+  }
+
+  for (const tag of file.tags ?? []) {
+    add(tag.trim().toLowerCase());
+  }
+
+  return categories;
+}
+
+function renderItem(file: ContentFile, ctx: BuildContext, baseUrl: string): string {
+  const url = `${baseUrl}/${file.slug}.html`;
+  const parts = [
+    '    <item>',
+    `      <title>${escapeXml(file.title)}</title>`,
+    `      <link>${escapeXml(url)}</link>`,
+    `      <guid isPermaLink="true">${escapeXml(url)}</guid>`,
+  ];
+
+  const pubDate = toPubDate(file);
+  if (pubDate) {
+    parts.push(`      <pubDate>${pubDate}</pubDate>`);
+  }
+
+  for (const category of categoriesOf(file, ctx)) {
+    parts.push(`      <category>${escapeXml(category)}</category>`);
+  }
+
+  parts.push(`      <description>${cdata(file.content)}</description>`, '    </item>');
+  return parts.join('\n');
+}
+
+/**
+ * Emits an RSS 2.0 feed at `feed.xml`. Runs after markdown-ext so item bodies are
+ * rendered HTML, and after taxonomy so items can carry category tags.
+ */
+export function createRssFeedPlugin(options: { description?: string } = {}): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const baseUrl = normalizeBaseUrl(ctx.config.baseUrl);
+        const description = options.description ?? `Latest posts from ${ctx.config.title}`;
+
+        const items = [...ctx.files]
+          .sort((a, b) => {
+            const left = timestampOf(a);
+            const right = timestampOf(b);
+            return left === right ? 0 : right - left;
+          })
+          .map(file => renderItem(file, ctx, baseUrl));
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(ctx.config.title)}</title>
+    <link>${escapeXml(baseUrl)}</link>
+    <description>${escapeXml(description)}</description>
+${items.join('\n')}
+  </channel>
+</rss>
+`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
