--- /dev/null
+++ b/src/plugins/taxonomy.ts
@@ -0,0 +1,86 @@
+import { createListTemplate } from '../core/templates.js';
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { slugifyTerm } from './shared.js';
+
+export const TAG_INDEX_KEY = 'taxonomy-tags';
+export const CATEGORY_INDEX_KEY = 'taxonomy-categories';
+
+/** Terms are matched case-insensitively, so `JavaScript` and `JAVASCRIPT` are one tag. */
+function normalizeTerm(term: unknown): string | null {
+  if (typeof term !== 'string') return null;
+  const normalized = term.trim().toLowerCase();
+  return normalized || null;
+}
+
+function addTerm(index: Map<string, ContentFile[]>, term: string, file: ContentFile): void {
+  const files = index.get(term);
+  if (!files) {
+    index.set(term, [file]);
+  } else if (!files.includes(file)) {
+    files.push(file);
+  }
+}
+
+/** Categories come from `category` or `categories` in a file's metadata. */
+function categoriesOf(file: ContentFile): unknown[] {
+  const { category, categories } = file.metadata;
+  if (Array.isArray(categories)) return categories;
+  if (categories !== undefined) return [categories];
+  if (category !== undefined) return [category];
+  return [];
+}
+
+function buildIndex(
+  files: ContentFile[],
+  termsOf: (file: ContentFile) => unknown[]
+): Map<string, ContentFile[]> {
+  const index = new Map<string, ContentFile[]>();
+  for (const file of files) {
+    for (const raw of termsOf(file)) {
+      const term = normalizeTerm(raw);
+      if (term) addTerm(index, term, file);
+    }
+  }
+  return index;
+}
+
+function renderListing(files: ContentFile[]): string {
+  const items = files
+    .map(file => `<li><a href="/${file.slug}.html">${file.title}</a></li>`)
+    .join('\n');
+  return `<ul>\n${items}\n</ul>`;
+}
+
+/**
+ * Groups content by tag and category into indices on the shared data store, then
+ * emits a listing page per tag at `tags/<tag>.html`.
+ */
+export function createTaxonomyPlugin(): Plugin {
+  const template = createListTemplate();
+
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild: (ctx: BuildContext): void => {
+        ctx.data.set(TAG_INDEX_KEY, buildIndex(ctx.files, file => file.tags ?? []));
+        ctx.data.set(CATEGORY_INDEX_KEY, buildIndex(ctx.files, categoriesOf));
+      },
+
+      afterBuild: (ctx: BuildContext): void => {
+        const tags = ctx.data.get(TAG_INDEX_KEY);
+        if (!(tags instanceof Map)) return;
+
+        for (const [tag, files] of tags as Map<string, ContentFile[]>) {
+          const page = template.render(renderListing(files), {
+            title: `Tag: ${tag}`,
+            siteTitle: ctx.config.title,
+            baseUrl: ctx.config.baseUrl,
+          });
+          ctx.output.set(`tags/${slugifyTerm(tag)}.html`, page);
+        }
+      },
+    },
+  };
+}
