+import { ContentFile, Plugin } from '../core/types.js';
+
+// Only fenced blocks carry a language class, so this never touches inline <code>.
+const CODE_BLOCK_OPEN = /<pre([^>]*)><code([^>]*)\bclass=("|')([^"']*\blanguage-([\w+#-]+)\b[^"']*)\3([^>]*)>/g;
+
+/**
+ * Marks up fenced code blocks for a client-side highlighter: the language is
+ * surfaced as `data-language` on the <pre>, and the <code> class gains a
+ * `highlighted` marker. Blocks with no language and inline code are left alone.
+ */
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        const content = file.content.replace(
+          CODE_BLOCK_OPEN,
+          (
+            _match,
+            preAttrs: string,
+            codeBefore: string,
+            quote: string,
+            classValue: string,
+            language: string,
+            codeAfter: string
+          ) => {
+            const classes = classValue.split(/\s+/).filter(Boolean);
+            if (!classes.includes('highlighted')) {
+              classes.push('highlighted');
+            }
+
+            const pre = /\bdata-language=/.test(preAttrs)
+              ? `<pre${preAttrs}>`
+              : `<pre${preAttrs} data-language="${language}">`;
+
+            return `${pre}<code${codeBefore}class=${quote}${classes.join(' ')}${quote}${codeAfter}>`;
+          }
+        );
+
+        return { ...file, content };
+      },
+    },
+  };
+}
diff --git a/src/plugins/taxonomy.ts b/src/plugins/taxonomy.ts
