@@ -0,0 +1,79 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+export const ASSET_MANIFEST_KEY = 'asset-manifest';
+
+export interface AssetManifest {
+  assets: string[];
+}
+
+// Matches src="..." / href="..." with either quote style.
+const URL_ATTRIBUTE = /\b(src|href)=("|')([^"']*)\2/g;
+// Matches markdown images and links: ![alt](./a.png) or [text](./doc.pdf "Title").
+// asset-pipeline has no declared dependencies, so it may run either side of
+// markdown-ext; handling both syntaxes keeps it correct in either order.
+const MARKDOWN_LINK = /(!?\[[^\]]*\])\(([^)\s]+)((?:\s+"[^"]*")?)\)/g;
+// Explicitly relative references — the ones that point at files shipped alongside
+// the content. Bare paths like "about.html" are left alone so internal page links
+// survive, and anything with a scheme, protocol-relative, rooted, or fragment URL
+// is already resolvable as-is.
+const RELATIVE_REFERENCE = /^\.{1,2}\//;
+
+function resolveAssetPath(url: string): string {
+  return url.replace(/^(?:\.\/)+/, '').replace(/^(?:\.\.\/)+/, '');
+}
+
+function getManifest(ctx: BuildContext): AssetManifest {
+  const existing = ctx.data.get(ASSET_MANIFEST_KEY) as AssetManifest | undefined;
+  if (existing) return existing;
+
+  const manifest: AssetManifest = { assets: [] };
+  ctx.data.set(ASSET_MANIFEST_KEY, manifest);
+  return manifest;
+}
+
+/**
+ * Rewrites relative asset references to the `/assets/` output path and records
+ * every asset it finds in a manifest on the shared data store.
+ */
+export function createAssetPipelinePlugin(options: { assetPrefix?: string } = {}): Plugin {
+  const assetPrefix = options.assetPrefix ?? '/assets';
+
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext): ContentFile => {
+        const manifest = getManifest(ctx);
+
+        // Records the asset and returns its public URL, or null to leave the
+        // reference untouched.
+        const rewrite = (url: string): string | null => {
+          if (!RELATIVE_REFERENCE.test(url)) return null;
+
+          const assetPath = resolveAssetPath(url);
+          if (!assetPath) return null;
+
+          if (!manifest.assets.includes(assetPath)) {
+            manifest.assets.push(assetPath);
+          }
+          return `${assetPrefix}/${assetPath}`;
+        };
+
+        const content = file.content
+          .replace(URL_ATTRIBUTE, (match, attribute: string, quote: string, url: string) => {
+            const rewritten = rewrite(url);
+            return rewritten === null
+              ? match
+              : `${attribute}=${quote}${rewritten}${quote}`;
+          })
+          .replace(MARKDOWN_LINK, (match, label: string, url: string, title: string) => {
+            const rewritten = rewrite(url);
+            return rewritten === null ? match : `${label}(${rewritten}${title})`;
+          });
+
+        return { ...file, content };
+      },
+    },
+  };
+}
