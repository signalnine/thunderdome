+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+// `[^1]: the note text` on its own line defines a footnote.
+const FOOTNOTE_DEFINITION = /^\[\^([^\]\s]+)\]:[ \t]*(.*)$/;
+// `:::note` opens an admonition, a bare `:::` closes it.
+const ADMONITION_OPEN = /^:::[ \t]*([a-zA-Z][\w-]*)[ \t]*$/;
+const ADMONITION_CLOSE = /^:::[ \t]*$/;
+
+// Admonition bodies are rendered separately and swapped back in afterwards, so the
+// placeholder has to be something marked passes through untouched.
+const PLACEHOLDER = 'ADMONITIONPLACEHOLDER';
+
+interface Footnote {
+  id: string;
+  text: string;
+}
+
+interface Admonition {
+  kind: string;
+  body: string;
+}
+
+/** Pull footnote definitions out of the source, leaving the prose behind. */
+function extractFootnotes(lines: string[]): { lines: string[]; footnotes: Footnote[] } {
+  const footnotes: Footnote[] = [];
+  const remaining: string[] = [];
+
+  for (const line of lines) {
+    const match = FOOTNOTE_DEFINITION.exec(line);
+    if (match) {
+      footnotes.push({ id: match[1], text: match[2].trim() });
+    } else {
+      remaining.push(line);
+    }
+  }
+
+  return { lines: remaining, footnotes };
+}
+
+/** Replace `:::kind ... :::` blocks with placeholders, collecting their bodies. */
+function extractAdmonitions(lines: string[]): { lines: string[]; admonitions: Admonition[] } {
+  const admonitions: Admonition[] = [];
+  const remaining: string[] = [];
+  let open: Admonition | null = null;
+
+  for (const line of lines) {
+    if (!open) {
+      const match = ADMONITION_OPEN.exec(line);
+      if (match) {
+        open = { kind: match[1].toLowerCase(), body: '' };
+        continue;
+      }
+      remaining.push(line);
+      continue;
+    }
+
+    if (ADMONITION_CLOSE.test(line)) {
+      admonitions.push(open);
+      // Blank lines keep the placeholder a paragraph of its own.
+      remaining.push('', `${PLACEHOLDER}${admonitions.length - 1}`, '');
+      open = null;
+      continue;
+    }
+
+    open.body += open.body ? `\n${line}` : line;
+  }
+
+  // An unterminated block still renders rather than swallowing the rest of the page.
+  if (open) {
+    admonitions.push(open);
+    remaining.push('', `${PLACEHOLDER}${admonitions.length - 1}`, '');
+  }
+
+  return { lines: remaining, admonitions };
+}
+
+/** Turn `[^1]` references into superscript links, but only for footnotes that exist. */
+function linkFootnoteReferences(text: string, footnotes: Footnote[]): string {
+  let result = text;
+  for (const footnote of footnotes) {
+    const reference = new RegExp(`\\[\\^${escapeRegExp(footnote.id)}\\]`, 'g');
+    result = result.replace(
+      reference,
+      `<sup><a href="#fn-${footnote.id}">${footnote.id}</a></sup>`
+    );
+  }
+  return result;
+}
+
+function escapeRegExp(value: string): string {
+  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+}
+
+async function renderFootnoteSection(footnotes: Footnote[]): Promise<string> {
+  const items: string[] = [];
+  for (const footnote of footnotes) {
+    const text = await marked.parseInline(footnote.text);
+    items.push(`<li id="fn-${footnote.id}">${text}</li>`);
+  }
+  return `\n<section class="footnotes">\n<ol>\n${items.join('\n')}\n</ol>\n</section>\n`;
+}
+
+/**
+ * Markdown to HTML with two extensions beyond CommonMark: `[^n]` footnotes that
+ * collect into a section at the end of the document, and `:::kind` containers
+ * that become admonition divs.
+ */
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: async (file: ContentFile): Promise<ContentFile> => {
+        if (!file.content) {
+          return { ...file, content: '' };
+        }
+
+        const withoutFootnotes = extractFootnotes(file.content.split('\n'));
+        const withoutAdmonitions = extractAdmonitions(withoutFootnotes.lines);
+        const { footnotes } = withoutFootnotes;
+        const { admonitions } = withoutAdmonitions;
+
+        const body = linkFootnoteReferences(withoutAdmonitions.lines.join('\n'), footnotes);
+        let html = await marked.parse(body);
+
+        for (let i = 0; i < admonitions.length; i++) {
+          const { kind, body: inner } = admonitions[i];
+          const innerHtml = await marked.parse(linkFootnoteReferences(inner, footnotes));
+          const div = `<div class="admonition admonition-${kind}">\n${innerHtml}</div>\n`;
+          // marked wraps the lone placeholder in a paragraph; unwrap it if so.
+          html = html
+            .replace(`<p>${PLACEHOLDER}${i}</p>`, div)
+            .replace(`${PLACEHOLDER}${i}`, div);
+        }
+
+        if (footnotes.length > 0) {
+          html += await renderFootnoteSection(footnotes);
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
