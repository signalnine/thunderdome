+// Small helpers shared by several plugins.
+
+/** Escape the five XML predefined entities so a value is safe inside a text node. */
+export function escapeXml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+/** Wrap a value in CDATA, splitting any embedded terminator so the section stays well-formed. */
+export function cdata(value: string): string {
+  return `<![CDATA[${value.replace(/]]>/g, ']]]]><![CDATA[>')}]]>`;
+}
+
+/** Strip HTML tags and collapse whitespace, leaving plain readable text. */
+export function stripHtml(html: string): string {
+  return html.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
+}
+
+/** Drop trailing slashes so `${baseUrl}/${path}` never doubles up. */
+export function normalizeBaseUrl(baseUrl: string): string {
+  return baseUrl.replace(/\/+$/, '');
+}
+
+/** Turn a taxonomy term into a filename-safe slug. */
+export function slugifyTerm(term: string): string {
+  return term
+    .toLowerCase()
+    .trim()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
+
+/** Read a Map out of the shared data store, tolerating plugins that never ran. */
+export function getDataMap<V>(
+  data: Map<string, unknown>,
+  key: string
+): Map<string, V> | undefined {
+  const value = data.get(key);
+  return value instanceof Map ? (value as Map<string, V>) : undefined;
+}
