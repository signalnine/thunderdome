'second task');\n    expect(newEntry.taskName).toBe('second task');\n    const log = tracker.getLog();\n    const first = log.find(e => e.taskName === 'first task');\n    expect(first!.endTime).toBeTruthy();\n  });\n\n  // 21. Concurrent start calls don't corrupt data\n  it('rapid sequential start calls do not corrupt data', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('rapid 1');\n    tracker.start('rapid 2');\n    tracker.start('rapid 3');\n    const log = tracker.getLog();\n    expect(log).toHaveLength(3);\n    const active = log.filter(e => e.endTime === null);\n    expect(active).toHaveLength(1);\n    expect(active[0].taskName).toBe('rapid 3');\n  });\n\n  // 22. Summary with no entries returns empty object\n  it('getSummary() with no entries returns empty object', () => {\n    const tracker = new TimeTracker(filePath);\n    const summary = tracker.getSummary();\n    expect(summary).toEqual({});\n  });\n\n  // 23. Log with no entries returns empty array\n  it('getLog() with no entries returns empty array', () => {\n    const tracker = new TimeTracker(filePath);\n    const log = tracker.getLog();\n    expect(log).toEqual([]);\n  });\n\n  // 24. File is created if it doesn't exist\n  it('creates the data file if it does not exist', () => {\n    const newPath = join(tempDir, 'nonexistent.json');\n    expect(existsSync(newPath)).toBe(false);\n    const tracker = new TimeTracker(newPath);\n    tracker.start('creation test');\n    tracker.stop();\n    expect(existsSync(newPath)).toBe(true);\n  });\n\n  // 25. File path is configurable\n  it('file path is configurable', () => {\n    const customPath = join(tempDir, 'custom', 'path', 'data.json');\n    const tracker = new TimeTracker(customPath);\n    tracker.start('custom path task');\n    tracker.stop();\n    expect(existsSync(customPath)).toBe(true);\n\n    const tracker2 = new TimeTracker(customPath);\n    const log = tracker2.getLog();\n    expect(log).toHaveLength(1);\n    expect(log