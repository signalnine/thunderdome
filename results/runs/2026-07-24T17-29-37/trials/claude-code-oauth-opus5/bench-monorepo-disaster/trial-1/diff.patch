.get(user.name, user.email, user.role) as {\n    51\t    id: number;\n    52\t    name: string;\n    53\t    email: string;\n    54\t    role: string;\n    55\t    created_at: string;\n    56\t    updated_at: string;\n    57\t  };\n    58\t  return {\n    59\t    id: row.id,\n    60\t    name: row.name,\n    61\t    email: row.email,\n    62\t    role: row.role as User['role'],\n    63\t    createdAt: row.created_at,\n    64\t    updatedAt: row.updated_at,\n    65\t  };\n    66\t}\n    67\t\n    68\texport function findUserById(\n    69\t  conn: DatabaseConnection,\n    70\t  id: number\n    71\t): User | null {\n    72\t  const stmt = conn.db.prepare('SELECT * FROM users WHERE id = ?');\n    73\t  const row = stmt.get(id) as {\n    74\t    id: number;\n    75\t    name: string;\n    76\t    email: string;\n    77\t    role: string;\n    78\t    created_at: string;\n    79\t    updated_at: string;\n    80\t  } | undefined;\n    81\t  if (!row) return null;\n    82\t  return {\n    83\t    id: row.id,\n    84\t    name: row.name,\n    85\t    email: row.email,\n    86\t    role: row.role as User['role'],\n    87\t    createdAt: row.created_at,\n    88\t    updatedAt: row.updated_at,\n    89\t  };\n    90\t}\n    91\t\n    92\texport function findAllUsers(conn: DatabaseConnection): User[] {\n    93\t  const stmt = conn.db.prepare('SELECT * FROM users ORDER BY id');\n    94\t  const rows = stmt.all() as Array<{\n    95\t    id: number;\n    96\t    name: string;\n    97\t    email: string;\n    98\t    role: string;\n    99\t    created_at: string;\n   100\t    updated_at: string;\n   101\t  }>;\n   102\t  return rows.map((row) => ({\n   103\t    id: row.id,\n   104\t    name: row.name,\n   105\t    email: row.email,\n   106\t    role: row.role as User['role'],\n   107\t    createdAt: row.created_at,\n   108\t    updatedAt: row.updated_at,\n   109\t  }));\n   110\t}\n=== packages/core/src/index.ts ===\n     1\t/**\n     2\t * @monorepo/core - Shared business logic\n   