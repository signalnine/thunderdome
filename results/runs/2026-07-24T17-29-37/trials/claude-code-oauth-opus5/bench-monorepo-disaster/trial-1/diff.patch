ntication middleware using core permissions.\n     3\t */\n     4\t\n     5\timport type { Request, Response, NextFunction } from 'express';\n     6\timport { hasPermission, type Role, type Permission } from '@monorepo/core';\n     7\t\n     8\t/**\n     9\t * Basic auth middleware that checks for a token header.\n    10\t * In this benchmark, we use a simplified mock auth system.\n    11\t */\n    12\texport function authMiddleware(\n    13\t  req: Request,\n    14\t  res: Response,\n    15\t  next: NextFunction\n    16\t): void {\n    17\t  const token = req.headers['authorization']?.replace('Bearer ', '');\n    18\t\n    19\t  // Allow requests with valid mock tokens or role headers\n    20\t  if (token?.startsWith('mock-token-') || req.headers['x-user-role']) {\n    21\t    next();\n    22\t    return;\n    23\t  }\n    24\t\n    25\t  res.status(401).json({ error: 'Authentication required' });\n    26\t}\n    27\t\n    28\t/**\n    29\t * Middleware factory to require a specific permission.\n    30\t */\n    31\texport function requirePermissionMiddleware(permission: Permission) {\n    32\t  return (req: Request, res: Response, next: NextFunction): void => {\n    33\t    const role = (req.headers['x-user-role'] as Role) || 'viewer';\n    34\t\n    35\t    if (!hasPermission(role, permission)) {\n    36\t      res.status(403).json({\n    37\t        error: `Permission '${permission}' required`,\n    38\t      });\n    39\t      return;\n    40\t    }\n    41\t\n    42\t    next();\n    43\t  };\n    44\t}\n=== packages/worker/src/index.ts ===\n     1\t/**\n     2\t * Worker entry point.\n     3\t * Runs background jobs on a schedule.\n     4\t */\n     5\t\n     6\timport { Scheduler } from './scheduler.js';\n     7\timport { syncJob } from './jobs/sync.js';\n     8\timport { cleanupJob } from './jobs/cleanup.js';\n     9\t\n    10\texport function createWorker(): Scheduler {\n    11\t  const scheduler = new Scheduler();\n    12\t\n    13\t  // Register jobs\n  