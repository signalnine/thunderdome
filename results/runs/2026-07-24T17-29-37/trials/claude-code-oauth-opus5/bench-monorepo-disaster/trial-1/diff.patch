\texport const authRouter = Router();\n     9\t\n    10\t// Simple registration (public)\n    11\tauthRouter.post('/register', (req: Request, res: Response) => {\n    12\t  try {\n    13\t    const validation = validateCreateUser({\n    14\t      ...req.body,\n    15\t      role: 'user', // Force 'user' role for self-registration\n    16\t    });\n    17\t\n    18\t    if (!validation.success) {\n    19\t      res.status(400).json({ errors: validation.errors });\n    20\t      return;\n    21\t    }\n    22\t\n    23\t    const user = registerUser({\n    24\t      name: req.body.name,\n    25\t      email: req.body.email,\n    26\t      role: 'user' as Role,\n    27\t    });\n    28\t\n    29\t    res.status(201).json({\n    30\t      user,\n    31\t      token: `mock-token-${user.id}`, // Simplified for benchmark\n    32\t    });\n    33\t  } catch (err) {\n    34\t    if (err instanceof Error && err.message.includes('UNIQUE')) {\n    35\t      res.status(409).json({ error: 'Email already registered' });\n    36\t      return;\n    37\t    }\n    38\t    res.status(500).json({ error: 'Registration failed' });\n    39\t  }\n    40\t});\n    41\t\n    42\t// Simple login (mock)\n    43\tauthRouter.post('/login', (req: Request, res: Response) => {\n    44\t  try {\n    45\t    const { email } = req.body as { email?: string };\n    46\t    if (!email) {\n    47\t      res.status(400).json({ error: 'Email is required' });\n    48\t      return;\n    49\t    }\n    50\t\n    51\t    // In a real app, we'd verify credentials\n    52\t    res.json({\n    53\t      token: `mock-token-for-${email}`,\n    54\t      message: 'Login successful',\n    55\t    });\n    56\t  } catch (err) {\n    57\t    res.status(500).json({ error: 'Login failed' });\n    58\t  }\n    59\t});\n    60\t\n    61\t// Token validation (mock)\n    62\tauthRouter.get('/verify', (req: Request, res: Response) => {\n    63\t  const token = req.headers['authorization']?.replace('Bearer ', '');\n    64\t  if (!token) {\n    65\t    res.status(401).json({ error: 'No token provided' });\n    66\t    return;\n    67\t  }\n    68\t\n    69\t  // Simplified: any token with correct format is valid\n    70\t  if (token.startsWith('mock-token-')) {\n    71\t    res.json({ valid: true, token });\n    72\t  } else {\n    73\t    res.status(401).json({ valid: false, error: 'Invalid token' });\n    74\t  }\n    75\t});\n=== packages/api/src/routes/users.ts ===\n     1\t/**\n     2\t * User CRUD routes.\n     3\t */\n     4\t\n     5\timport { Router, type Request, type Response } from 'express';\n     6\timport {\n     7\t  createUser,\n     8\t  getUserById,\n     9\t  getAllUsers,\n    10\t  validateCreateUser,\n    11\t  validateUserId,\n    12\t  canManageUsers,\n    13\t  type Role,\n    14\t} from '@monorepo/core';\n    15\t\n    16\texport const usersRouter = Router();\n    17\t\n    18\t// List all users\n    19\tusersRouter.get('/', (_req: Request, res: Response) => {\n    20\t  try {\n    21\t    const users = getAllUsers();\n    22\t    res.json({ users });\n    23\t  } catch (err) {\n    24\t    res.status(500).json({ error: 'Failed to fetch users' });\n    25\t  }\n    26\t});\n    27\t\n    28\t// Get user by ID\n    29\tusersRouter.get('/:id', (req: Request, res: Response) => {\n    30\t  try {\n    31\t    const validation = validateUserId(req.params['id']!);\n    32\t    if (!validation.success) {\n    33\t      res.status(400).json({ errors: validation.errors });\n    34\t      return;\n    35\t    }\n    36\t\n    37\t    const user = getUserById(validation.data!);\n    38\t    if (!user) {\n    39\t      res.status(404).json({ error: 'User not found' });\n    40\t      return;\n    41\t    }\n    42\t    res.json({ user });\n    43\t  } catch (err) {\n    44\t    res.status(500).json({ error: 'Failed to fetch user' });\n    45\t  }\n    46\t});\n    47\t\n    48\t// Create a new user\n    49\tusersRouter.post('/', (req: Request, res: Response) => {\n    50\t 