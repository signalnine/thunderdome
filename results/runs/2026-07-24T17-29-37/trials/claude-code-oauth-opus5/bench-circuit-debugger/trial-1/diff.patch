       = partial XOR carry_in\n *   propagate = partial AND carry_in\n *   carry_out = generate OR propagate\n * Wherever an expected gate is missing, some wire name has been displaced. The\n * gates that *are* present pin down which wires those are: a bit's sum gate is\n * identified by producing z_i, and its carry-out gate by feeding the next bit.\n *\n * `flips` inverts the choices made at ambiguous repairs, so the caller can try\n * the other reading when the first one does not verify.\n */\nfunction traceAdder(source: Gate[], bits: number, flips = 0): WorkingCircuit {\n  const circuit = new WorkingCircuit(source);\n  const flipped = (): boolean => ((flips >> circuit.ambiguities++) & 1) === 1;\n\n  // Bit 0 is a half adder: no carry-in, and its carry-out is just x00 AND y00.\n  const halfSum = circuit.requireGate('XOR', bitWire('x', 0), bitWire('y', 0));\n  if (circuit.outputOf(halfSum) !== bitWire('z', 0)) {\n    circuit.swapOutputs(circuit.outputOf(halfSum), bitWire('z', 0));\n  }\n  const halfCarry = circuit.requireGate('AND', bitWire('x', 0), bitWire('y', 0));\n  let carry = circuit.outputOf(halfCarry);\n  const firstTarget = bits > 1 ? carryIntoBit(circuit, 1) : bitWire('z', bits);\n  if (firstTarget !== null && firstTarget !== carry) {\n    circuit.swapOutputs(carry, firstTarget);\n    carry = firstTarget;\n  }\n\n  for (let bit = 1; bit < bits; bit++) {\n    const x = bitWire('x', bit);\n    const y = bitWire('y', bit);\n    const z = bitWire('z', bit);\n\n    const partialGate = circuit.requireGate('XOR', x, y);\n    const generateGate = circuit.requireGate('AND', x, y);\n    let partial = circuit.outputOf(partialGate);\n    let generate = circuit.outputOf(generateGate);\n\n    // --- the sum gate: partial XOR carry -> z_bit ---\n    let sumGate = circuit.findGate('XOR', partial, carry);\n    if (sumGate < 0) {\n      // Score every XOR gate that touches one of the three wires this bit's sum\n      // gate should read. Producing z_bit is the strongest evidence, since only\n      // a second swap on the same bit could move it.\n      const candidates = new Set([\n        ...circuit.readers(partial, 'XOR'),\n        ...circuit.readers(generate, 'XOR'),\n        ...circuit.readers(carry, 'XOR'),\n      ]);\n      let best = -1;\n      let bestScore = -1;\n      for (const candidate of candidates) {\n        const score =\n          (circuit.outputOf(candidate) === z ? 4 : 0) +\n          (circuit.reads(candidate, carry) ? 2 : 0) +\n          (circuit.reads(candidate, partial) || circuit.reads(candidate, generate) ? 1 : 0);\n        if (score > bestScore) {\n          bestScore = score;\n          best = candidate;\n        }\n      }\n      if (best < 0) throw new TraceFailure(`no sum gate for bit ${bit}`);\n\n      if (circuit.reads(best, carry)) {\n        // The carry is right, so the gate's other input is where the partial sum\n        // should have gone.\n        const wanted = circuit.otherInput(best, carry);\n        circuit.swapOutputs(partial, wanted);\n      } else {\n        // The partial sum is right, so the gate's other input is the real carry.\n        if (circuit.reads(best, generate)) circuit.swapOutputs(partial, generate);\n        partial = circuit.outputOf(partialGate);\n        const actualCarry = circuit.otherInput(best, partial);\n        circuit.swapOutputs(carry, actualCarry);\n        carry = actualCarry;\n      }\n      partial = circuit.outputOf(partialGate);\n      generate = circuit.outputOf(generateGate);\n      sumGate = circuit.findGate('XOR', partial, carry);\n    }\n    if (sumGate < 0) throw new TraceFailure(`no sum gate for bit ${bit}`);\n\n    if (circuit.outputOf(sumGate) !== z) {\n      circuit.swapOutputs(circuit.outputOf(sumGate), z);\n      partial = circuit.outputOf(partialGate);\n      generate = circuit.outputOf(generateGate);\n    }\n\n    // --- the carry-out chain: (x AND y) OR (partial AND carry) ---\n    const propagateGate = circuit.requireGate('AND', partial, carry);\n    let propagate = circuit.outputOf(propagateGate);\n\n    // The carry out of this bit is whatever the next bit's sum gate reads; for\n    // the top bit it is the extra output bit.\n    const target = bit === bits - 1 ? bitWire('z', bits) : carryIntoBit(circuit, bit + 1);\n\n    let carryGate = circuit.findGate('OR', generate, propagate);\n    if (carryGate >= 0) {\n      if (target !== null && circuit.outputOf(carryGate) !== target) {\n        circuit.swapOutputs(circuit.outputOf(carryGate), target);\n      }\n    } else {\n      // One or both inputs of the carry gate are displaced; find it by its output.\n      if (target === null) throw new TraceFailure(`no carry gate for bit ${bit}`);\n      carryGate = circuit.driverOf(target);\n      if (carryGate < 0 || circuit.gates[carryGate].op !== 'OR') {\n        throw new TraceFailure(`carry gate for bit ${bit} is not an OR gate`);\n      }\n      if (circuit.reads(carryGate, generate)) {\n        circuit.swapOutputs(propagate, circuit.otherInput(carryGate, generate));\n      } else if (circuit.reads(carryGate, propagate)) {\n        circuit.swapOutputs(generate, circuit.otherInput(carryGate, propagate));\n      } else {\n        // Both inputs moved. The OR is symmetric, so either pairing repairs this\n        // gate, but only one leaves the rest of the circuit intact.\n        const first = circuit.gates[carryGate].in1;\n        const second = circuit.gates[carryGate].in2;\n        const [forGenerate, forPropagate] = flipped() ? [second, first] : [first, second];\n        circuit.swapOutputs(generate, forGenerate);\n        circuit.swapOutputs(propagate, forPropagate);\n      }\n      propagate = circuit.outputOf(propagateGate);\n      generate = circuit.outputOf(generateGate);\n      if (circuit.findGate('OR', generate, propagate) !== carryGate) {\n        throw new TraceFailure(`could not rebuild the carry gate for bit ${bit}`);\n      }\n    }\n\n    carry = circuit.outputOf(carryGate);\n  }\n\n  // The carry out of the top bit is the most significant output bit.\n  const topOutput = bitWire('z', bits);\n  if (carry !== topOutput) circuit.swapOutputs(carry, topOutput);\n\n  return circuit;\n}","originalFile":"import type { Gate } from './types.js';\nimport { bitWire } from './naming.js';\nimport {\n  correctThroughBit,\n  firstBadBit,\n  isCorrectAdder,\n  makeTestVectors,\n  type TestVector,\n} from './evaluator.js';\n\n/** Raised when the ripple-carry structure cannot be followed any further. */\nclass TraceFailure extends Error {}\n\nfunction signature(op: Gate['op'], a: string, b: string): string {\n  return a < b ? `${op} ${a} ${b}` : `${op} ${b} ${a}`;\n}\n\n/**\n * A mutable copy of the circuit with lookup indexes, tracking every output-wire\n * swap applied to it.\n */\nclass WorkingCircuit {\n  readonly gates: Gate[];\n  readonly swaps: string[] = [];\n  /** Number of coin flips taken where two repairs were equally plausible. */\n  ambiguities = 0;\n  private byOutput = new Map<string, number>();\n  private bySignature = new Map<string, number>();\n  private byInput = new Map<string, number[]>();\n\n  constructor(source: Gate[]) {\n    this.gates = source.map((gate) => ({ ...gate }));\n    this.reindex();\n  }\n\n  private reindex(): void {\n    this.byOutput = new Map();\n    this.bySignature = new Map();\n    this.byInput = new Map();\n    for (let i = 0; i < this.gates.length; i++) {\n      const gate = this.gates[i];\n      this.byOutput.set(gate.out, i);\n      this.bySignature.set(signature(gate.op, gate.in1, gate.in2), i);\n      for (const wire of gate.in1 === gate.in2 ? [gate.in1] : [gate.in1, gate.in2]) {\n        const list = this.byInput.get(wire);\n        if (list) list.push(i);\n        else this.byInput.set(wire, [i]);\n      }\n    }\n  }\n\n  /** Index of the gate with this operation and input pair, or -1. */\n  findGate(op: Gate['op'], a: string, b: string): number {\n    const index = this.bySignature.get(signature(op, a, b));\n    return index === undefined ? -1 : index;\n  }\n\n  requireGate(op: Gate['op'], a: string, b: string): number {\n    const index = this.findGate(op, a, b);\n    if (index < 0) throw new TraceFailure(`missing gate ${op} ${a} ${b}`);\n    return index;\n  }\n\n  outputOf(index: number): string {\n    return this.gates[index].out;\n  }\n\n  /** Index of the gate driving `wire`, or -1 if nothing drives it. */\n  driverOf(wire: string): number {\n    const index = this.byOutput.get(wire);\n    return index === undefined ? -1 : index;\n  }\n\n  reads(index: number, wire: string): boolean {\n    const gate = this.gates[index];\n    return gate.in1 === wire || gate.in2 === wire;\n  }\n\n  /** Gates of the given operation that read `wire`. */\n  readers(wire: string, op: Gate['op']): number[] {\n    return (this.byInput.get(wire) ?? []).filter((index) => this.gates[index].op === op);\n  }\n\n  /** The input of gate `index` that is not `wire`. */\n  otherInput(index: number, wire: string): string {\n    const gate = this.gates[index];\n    return gate.in1 === wire ? gate.in2 : gate.in1;\n  }\n\n  /** Exchange the output wires of the two gates driving `first` and `second`. */\n  swapOutputs(first: string, second: string): void {\n    if (first === second) throw new TraceFailure(`cannot swap ${first} with itself`);\n    const a = this.byOutput.get(first);\n    const b = this.byOutput.get(second);\n    if (a === undefined || b === undefined) {\n      throw new TraceFailure(`cannot swap undriven wire (${first}, ${second})`);\n    }\n    this.gates[a].out = second;\n    this.gates[b].out = first;\n    this.swaps.push(first, second);\n    this.reindex();\n  }\n}\n\n/**\n * Walk the adder one bit at a time, repairing the wiring wherever it deviates\n * from the ripple-carry pattern.\n *\n * For bit i the circuit should contain\n *   partial   = x_i XOR y_i\n *   generate  = x_i AND y_i\n *   z_i       = partial XOR carry_in\n *   propagate = partial AND carry_in\n *   carry_out = generate OR propagate\n * Each time a gate is missing, exactly one wire name has been displaced; the\n * gate that *is* there tells us which two wires to put back.\n */\nfunction traceAdder(source: Gate[], bits: number): WorkingCircuit {\n  const circuit = new WorkingCircuit(source);\n\n  // Bit 0 is a half adder: no carry-in, and its carry-out is just x00 AND y00.\n  const halfSum = circuit.requireGate('XOR', bitWire('x', 0), bitWire('y', 0));\n  if (circuit.outputOf(halfSum) !== bitWire('z', 0)) {\n    circuit.swapOutputs(circuit.outputOf(halfSum), bitWire('z', 0));\n  }\n  let carry = circuit.outputOf(circuit.requireGate('AND', bitWire('x', 0), bitWire('y', 0)));\n\n  for (let bit = 1; bit < bits; bit++) {\n    const x = bitWire('x', bit);\n    const y = bitWire('y', bit);\n    const z = bitWire('z', bit);\n\n    const partialGate = circuit.requireGate('XOR', x, y);\n    const generateGate = circuit.requireGate('AND', x, y);\n    let partial = circuit.outputOf(partialGate);\n    let generate = circuit.outputOf(generateGate);\n\n    // --- the sum gate: partial XOR carry -> z_bit ---\n    let sumGate = circuit.findGate('XOR', partial, carry);\n    if (sumGate < 0 && circuit.findGate('XOR', generate, carry) >= 0) {\n      // The half-adder pair for this bit swapped its own outputs.\n      circuit.swapOutputs(partial, generate);\n      partial = circuit.outputOf(partialGate);\n      generate = circuit.outputOf(generateGate);\n      sumGate = circuit.findGate('XOR', partial, carry);\n    }\n    if (sumGate < 0) {\n      // `partial` only ever feeds the sum gate and the propagate gate, so an XOR\n      // reading it must be the sum gate — its other input is the real carry wire.\n      const viaPartial = circuit.readers(partial, 'XOR');\n      const viaGenerate = circuit.readers(generate, 'XOR');\n      if (viaPartial.length === 1) {\n        const actualCarry = circuit.otherInput(viaPartial[0], partial);\n        circuit.swapOutputs(carry, actualCarry);\n        carry = actualCarry;\n      } else if (viaGenerate.length === 1) {\n        circuit.swapOutputs(partial, generate);\n        partial = circuit.outputOf(partialGate);\n        generate = circuit.outputOf(generateGate);\n        const actualCarry = circuit.otherInput(viaGenerate[0], partial);\n        if (actualCarry !== carry) {\n          circuit.swapOutputs(carry, actualCarry);\n          carry = actualCarry;\n        }\n      }\n      sumGate = circuit.findGate('XOR', partial, carry);\n    }\n    if (sumGate < 0) throw new TraceFailure(`no sum gate for bit ${bit}`);\n\n    if (circuit.outputOf(sumGate) !== z) {\n      circuit.swapOutputs(circuit.outputOf(sumGate), z);\n      partial = circuit.outputOf(partialGate);\n      generate = circuit.outputOf(generateGate);\n    }\n\n    // --- the carry-out chain: (x AND y) OR (partial AND carry) ---\n    const propagateGate = circuit.requireGate('AND', partial, carry);\n    let propagate = circuit.outputOf(propagateGate);\n\n    let carryGate = circuit.findGate('OR', generate, propagate);\n    if (carryGate < 0) {\n      const viaGenerate = circuit.readers(generate, 'OR');\n      const viaPropagate = circuit.readers(propagate, 'OR');\n      if (viaGenerate.length === 1) {\n        const actual = circuit.otherInput(viaGenerate[0], generate);\n        circuit.swapOutputs(propagate, actual);\n        propagate = actual;\n      } else if (viaPropagate.length === 1) {\n        const actual = circuit.otherInput(viaPropagate[0], propagate);\n        circuit.swapOutputs(generate, actual);\n        generate = actual;\n      }\n      carryGate = circuit.findGate('OR', generate, propagate);\n    }\n    if (carryGate < 0) throw new TraceFailure(`no carry gate for bit ${bit}`);\n\n    carry = circuit.outputOf(carryGate);\n  }\n\n  // The carry out of the top bit is the most significant output bit.\n  const topOutput = bitWire('z', bits);\n  if (carry !== topOutput) circuit.swapOutputs(carry, topOutput);\n\n  return circuit;\n}\n\n/** Every gate feeding the given wires, transitively. */\nfunction fanInGates(gates: Gate[], wires: string[]): number[] {\n  const driver = new Map<string, number>();\n  for (let i = 0; i < gates.length; i++) driver.set(gates[i].out, i);\n  const seen = new Set<number>();\n  const stack = [...wires];\n  while (stack.length > 0) {\n    const wire = stack.pop() as string;\n    const index = driver.get(wire);\n    if (index === undefined || seen.has(index)) continue;\n    seen.add(index);\n    stack.push(gates[index].in1, gates[index].in2);\n  }\n  return [...seen];\n}\n\n/**\n * Brute-force-ish repair used when the structural trace cannot make sense of the\n * circuit. It always attacks the lowest incorrect output bit, so the candidate\n * pairs stay confined to that bit's cone rather than the whole circuit.\n */\nfunction searchSwaps(\n  source: Gate[],\n  bits: number,\n  vectors: TestVector[],\n  deadline: number,\n): string[] | null {\n  const gates = source.map((gate) => ({ ...gate }));\n  const used = new Set<string>();\n  const found: string[] = [];\n\n  const step = (depth: number): string[] | null => {\n    const bad = firstBadBit(gates, bits, vectors);\n    if (bad === Infinity) return found.length === 8 ? [...found] : null;\n    if (depth === 0 || Date.now() > deadline) return null;\n\n    const cone = new Set(fanInGates(gates, [bitWire('z', bad), bitWire('z', Math.min(bad + 1, bits))]));\n    const scored: { a: number; b: number; score: number }[] = [];\n    for (const a of cone) {\n      if (used.has(gates[a].out)) continue;\n      for (let b = 0; b < gates.length; b++) {\n        if (b === a || used.has(gates[b].out)) continue;\n        if (cone.has(b) && b < a) continue; // each in-cone pair only once\n        const first = gates[a].out;\n        const second = gates[b].out;\n        gates[a].out = second;\n        gates[b].out = first;\n        // Cheap gate: the swap has to fix every bit up to the broken one.\n        if (correctThroughBit(gates, bits, vectors, bad)) {\n          scored.push({ a, b, score: firstBadBit(gates, bits, vectors) });\n        }\n        gates[a].out = first;\n        gates[b].out = second;\n      }\n      if (Date.now() > deadline) break;\n    }\n    scored.sort((l, r) => r.score - l.score);\n\n    for (const { a, b } of scored.slice(0, 8)) {\n      const first = gates[a].out;\n      const second = gates[b].out;\n      gates[a].out = second;\n      gates[b].out = first;\n      used.add(first);\n      used.add(second);\n      found.push(first, second);\n      const result = step(depth - 1);\n      if (result) return result;\n      found.length -= 2;\n      used.delete(first);\n      used.delete(second);\n      gates[a].out = first;\n      gates[b].out = second;\n    }\n    return null;\n  };\n\n  return step(4);\n}\n\nconst sortedWires = (wires: string[]): string[] => [...new Set(wires)].sort();\n\n/**\n * Find the eight output wires that were swapped in pairs, breaking the adder.\n */\nexport function repairAdder(gates: Gate[], bits: number): string[] {\n  const vectors = makeTestVectors(bits);\n\n  let traced: WorkingCircuit | null = null;\n  try {\n    traced = traceAdder(gates, bits);\n  } catch (error) {\n    if (!(error instanceof TraceFailure)) throw error;\n  }\n\n  const tracedWorks =\n    traced !== null && new Set(traced.swaps).size === traced.swaps.length && isCorrectAdder(traced.gates, bits, vectors);\n  if (tracedWorks && traced !== null && traced.swaps.length === 8) return sortedWires(traced.swaps);\n\n  const searched = searchSwaps(gates, bits, vectors, Date.now() + 3500);\n  if (searched) return sortedWires(searched);\n\n  // Nothing verified cleanly: the structural trace is still the best answer we\n  // have (a swap with no effect on the sum is invisible to both methods).\n  return traced ? sortedWires(traced.swaps) : [];\n}\n","structuredPatch":[{"oldStart":103,"oldLines":6,"newStart":103,"newLines":26,"lines":[" }"," "," /**","+ * The wire carrying the carry *into* `bit`, read off th