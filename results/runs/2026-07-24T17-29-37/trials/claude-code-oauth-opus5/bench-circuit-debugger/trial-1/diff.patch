+/** A single two-input logic gate. */
+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  /** input wire name */
+  in1: string;
+  /** input wire name */
+  in2: string;
+  /** output wire name */
+  out: string;
+}
+
+/** Map of wire name to its value (0 or 1). */
+export type WireValues = Record<string, number>;
diff --git a/tests/findSwappedWires.test.ts b/tests/findSwappedWires.test.ts
new file mode 100644
index 0000000..c0e75d8
--- /dev/null
+++ b/tests/findSwappedWires.test.ts
@@ -0,0 +1,128 @@
+import { describe, expect, it } from 'vitest';
+import { findSwappedWires } from '../src/index.js';
+import type { Gate } from '../src/types.js';
+import { addsCorrectly, applySwaps, buildAdder, makeCases, makeRandom, pickSwapPairs } from './helpers/adder.js';
+
+const correctFourBitAdder: Gate[] = [
+  { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+  { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+  { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },
+  { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },
+  { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },
+  { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },
+  { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },
+  { op: 'XOR', in1: 'x02', in2: 'y02', out: 't02' },
+  { op: 'XOR', in1: 't02', in2: 'c01', out: 'z02' },
+  { op: 'AND', in1: 'x02', in2: 'y02', out: 'a02' },
+  { op: 'AND', in1: 't02', in2: 'c01', out: 'b02' },
+  { op: 'OR', in1: 'a02', in2: 'b02', out: 'c02' },
+  { op: 'XOR', in1: 'x03', in2: 'y03', out: 't03' },
+  { op: 'XOR', in1: 't03', in2: 'c02', out: 'z03' },
+  { op: 'AND', in1: 'x03', in2: 'y03', out: 'a03' },
+  { op: 'AND', in1: 't03', in2: 'c02', out: 'b03' },
+  { op: 'OR', in1: 'a03', in2: 'b03', out: 'z04' },
+];
+
+describe('findSwappedWires', () => {
+  it('finds swaps in a hand-written 4-bit adder', () => {
+    const swapped = applySwaps(correctFourBitAdder, [
+      ['z01', 'a01'],
+      ['t02', 'a02'],
+      ['z03', 'c02'],
+      ['b01', 'c01'],
+    ]);
+    expect(findSwappedWires(swapped)).toEqual(['a01', 'a02', 'b01', 'c01', 'c02', 't02', 'z01', 'z03']);
+  });
+
+  it('finds swaps that all sit in the top bits', () => {
+    const random = makeRandom(4242);
+    const { gates, internal } = buildAdder(12, random);
+    const pairs: [string, string][] = [
+      [internal.partial[10], internal.generate[10]],
+      ['z11', internal.propagate[10]],
+      ['z12', internal.generate[9]],
+      [internal.carry[8], 'z09'],
+    ];
+    expect(findSwappedWires(applySwaps(gates, pairs))).toEqual([...pairs.flat()].sort());
+  });
+
+  it('finds swaps that all sit in the bottom bits', () => {
+    const random = makeRandom(31337);
+    const { gates, internal } = buildAdder(16, random);
+    const pairs: [string, string][] = [
+      ['z00', internal.carry[0]],
+      ['z01', internal.partial[0]],
+      [internal.generate[1], internal.propagate[2]],
+      [internal.carry[3], internal.partial[4]],
+    ];
+    expect(findSwappedWires(applySwaps(gates, pairs))).toEqual([...pairs.flat()].sort());
+  });
+
+  it('finds swaps between wires many bits apart', () => {
+    const random = makeRandom(90210);
+    const { gates, internal } = buildAdder(30, random);
+    const pairs: [string, string][] = [
+      [internal.partial[2], internal.partial[27]],
+      [internal.carry[5], internal.generate[24]],
+      ['z07', 'z22'],
+      [internal.propagate[10], internal.propagate[20]],
+    ];
+    expect(findSwappedWires(applySwaps(gates, pairs))).toEqual([...pairs.flat()].sort());
+  });
+
+  it('is not confused by the order the gates are listed in', () => {
+    const random = makeRandom(818);
+    const adder = buildAdder(20, random);
+    const pairs = pickSwapPairs(adder, random);
+    const swapped = applySwaps(adder.gates, pairs);
+    const expected = [...pairs.flat()].sort();
+    expect(findSwappedWires(swapped)).toEqual(expected);
+    expect(findSwappedWires([...swapped].reverse())).toEqual(expected);
+  });
+
+  it('returns wires that repair the circuit when un-swapped', () => {
+    const random = makeRandom(555);
+    const bits = 45;
+    const adder = buildAdder(bits, random);
+    const pairs = pickSwapPairs(adder, random);
+    const swapped = applySwaps(adder.gates, pairs);
+
+    const found = findSwappedWires(swapped);
+    expect(new Set(found)).toEqual(new Set(pairs.flat()));
+
+    const cases = makeCases(bits, makeRandom(6));
+    expect(addsCorrectly(swapped, bits, cases)).toBe(false);
+    expect(addsCorrectly(applySwaps(swapped, pairs), bits, cases)).toBe(true);
+  });
+
+  it('leaves the caller’s gates untouched', () => {
+    const random = makeRandom(1234);
+    const adder = buildAdder(14, random);
+    const pairs = pickSwapPairs(adder, random);
+    const swapped = applySwaps(adder.gates, pairs);
+    const before = JSON.stringify(swapped);
+    findSwappedWires(swapped);
+    expect(JSON.stringify(swapped)).toEqual(before);
+  });
+
+  it('reports nothing for a circuit that is already a working adder', () => {
+    expect(findSwappedWires(correctFourBitAdder)).toEqual([]);
+    const { gates } = buildAdder(18, makeRandom(64));
+    expect(findSwappedWires(gates)).toEqual([]);
+  });
+
+  it('handles a 45-bit circuit well under the time limit', () => {
+    const random = makeRandom(2024);
+    const adder = buildAdder(45, random);
+    const pairs = pickSwapPairs(adder, random);
+    const swapped = applySwaps(adder.gates, pairs);
+    expect(swapped.length).toBeGreaterThan(200);
+
+    const started = performance.now();
+    const found = findSwappedWires(swapped);
+    const elapsed = performance.now() - started;
+
+    expect(found).toEqual([...pairs.flat()].sort());
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
