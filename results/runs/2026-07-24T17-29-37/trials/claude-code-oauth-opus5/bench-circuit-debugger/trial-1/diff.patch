();\n\n  constructor(source: Gate[]) {\n    this.gates = source.map((gate) => ({ ...gate }));\n    this.reindex();\n  }\n\n  private reindex(): void {\n    this.byOutput = new Map();\n    this.bySignature = new Map();\n    this.byInput = new Map();\n    for (let i = 0; i < this.gates.length; i++) {\n      const gate = this.gates[i];\n      this.byOutput.set(gate.out, i);\n      this.bySignature.set(signature(gate.op, gate.in1, gate.in2), i);\n      for (const wire of gate.in1 === gate.in2 ? [gate.in1] : [gate.in1, gate.in2]) {\n        const list = this.byInput.get(wire);\n        if (list) list.push(i);\n        else this.byInput.set(wire, [i]);\n      }\n    }\n  }\n\n  /** Index of the gate with this operation and input pair, or -1. */\n  findGate(op: Gate['op'], a: string, b: string): number {\n    const index = this.bySignature.get(signature(op, a, b));\n    return index === undefined ? -1 : index;\n  }\n\n  /** Index of the gate driving `wire`, or -1 if nothing drives it. */\n  driverOf(wire: string): number {\n    const index = this.byOutput.get(wire);\n    return index === undefined ? -1 : index;\n  }\n\n  outputOf(index: number): string {\n    return this.gates[index].out;\n  }\n\n  reads(index: number, wire: string): boolean {\n    const gate = this.gates[index];\n    return gate.in1 === wire || gate.in2 === wire;\n  }\n\n  /** Gates of the given operation that read `wire`. */\n  readers(wire: string, op: Gate['op']): number[] {\n    return (this.byInput.get(wire) ?? []).filter((index) => this.gates[index].op === op);\n  }\n\n  /** The input of gate `index` that is not `wire`. */\n  otherInput(index: number, wire: string): string {\n    const gate = this.gates[index];\n    return gate.in1 === wire ? gate.in2 : gate.in1;\n  }\n\n  /**\n   * Exchange the gates driving the two wires. Fails (leaving the circuit alone)\n   * when either wire is undriven, already part of a swap, or when the swap\n   * budget is used up.\n   */\n  trySwapOutputs(first: string, second: string): boolean {\n    if (first === second) return true;\n    if (this.swaps.length >= SWAP_PAIRS * 2) return false;\n    if (this.swapped.has(first) || this.swapped.has(second)) return false;\n    const a = this.byOutput.get(first);\n    const b = this.byOutput.get(second);\n    if (a === undefined || b === undefined) return false;\n    this.gates[a].out = second;\n    this.gates[b].out = first;\n    this.swaps.push(first, second);\n    this.swapped.add(first).add(second);\n    this.reindex();\n    return true;\n  }\n\n  get depth(): number {\n    return this.swaps.length;\n  }\n\n  /** Undo every swap made after `depth`. */\n  rewind(depth: number): void {\n    while (this.swaps.length > depth) {\n      const second = this.swaps.pop() as string;\n      const first = this.swaps.pop() as string;\n      this.swapped.delete(first);\n      this.swapped.delete(second);\n      const a = this.byOutput.get(first) as number;\n      const b = this.byOutput.get(second) as number;\n      this.gates[a].out = second;\n      this.gates[b].out = first;\n      this.reindex();\n    }\n  }\n}\n\n/**\n * How the carry out of the bit below is produced: bit 0 hands over a single AND\n * gate, every other bit an OR gate identified by the two gates feeding it.\n */\ntype CarrySource =\n  | { kind: 'half'; gate: number }\n  | { kind: 'ripple'; generate: number; propagate: number };\n\ninterface Solution {\n  wires: string[];\n  complete: boolean;\n}\n\n/**\n * Reconstruct the adder by deciding, bit by bit, which gate plays which role.\n *\n * Gate inputs are untouched by the swaps, so the two half-adder gates of every\n * bit are known outright: they are the ones reading x_i and y_i. Everything else\n * follows from them. For bit i the circuit must contain\n *\n *   partial   = x_i XOR y_i          generate  = x_i AND y_i\n *   z_i       = partial XOR carry    propagate = partial AND carry\n *   carry_out = generate OR propagate\n *\n * so once we pick the XOR gate that plays `z_i`