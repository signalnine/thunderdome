+import type { Gate } from './types.js';
+import { bitWire } from './naming.js';
+
+const OP_CODE: Record<Gate['op'], number> = { AND: 0, OR: 1, XOR: 2 };
+
+/**
+ * A circuit compiled into flat typed arrays with the gates pre-sorted into
+ * dependency order, so that many input vectors can be evaluated cheaply.
+ */
+class CompiledAdder {
+  private readonly ops: Uint8Array;
+  private readonly in1: Int32Array;
+  private readonly in2: Int32Array;
+  private readonly out: Int32Array;
+  private readonly values: Int8Array;
+  private readonly xWires: Int32Array;
+  private readonly yWires: Int32Array;
+  private readonly zWires: Int32Array;
+
+  constructor(gates: Gate[], readonly bits: number) {
+    const wireIds = new Map<string, number>();
+    const idOf = (wire: string): number => {
+      let id = wireIds.get(wire);
+      if (id === undefined) {
+        id = wireIds.size;
+        wireIds.set(wire, id);
+      }
+      return id;
+    };
+    // Register the x/y/z wires first so they exist even if no gate mentions them.
+    this.xWires = new Int32Array(bits);
+    this.yWires = new Int32Array(bits);
+    this.zWires = new Int32Array(bits + 1);
+    for (let i = 0; i < bits; i++) {
+      this.xWires[i] = idOf(bitWire('x', i));
+      this.yWires[i] = idOf(bitWire('y', i));
+    }
+    for (let i = 0; i <= bits; i++) this.zWires[i] = idOf(bitWire('z', i));
+
+    const order = topologicalOrder(gates);
+    const count = order.length;
+    this.ops = new Uint8Array(count);
+    this.in1 = new Int32Array(count);
+    this.in2 = new Int32Array(count);
+    this.out = new Int32Array(count);
+    for (let i = 0; i < count; i++) {
+      const gate = gates[order[i]];
+      this.ops[i] = OP_CODE[gate.op];
+      this.in1[i] = idOf(gate.in1);
+      this.in2[i] = idOf(gate.in2);
+      this.out[i] = idOf(gate.out);
+    }
+    this.values = new Int8Array(wireIds.size);
+  }
+
+  /**
+   * Evaluate the circuit for one input vector and write the output bits into
+   * `result` (length `bits + 1`). Undriven outputs come out as -1.
+   */
+  evaluate(x: Uint8Array, y: Uint8Array, result: Int8Array): void {
+    const values = this.values;
+    values.fill(-1);
+    for (let i = 0; i < this.bits; i++) {
+      values[this.xWires[i]] = x[i];
+      values[this.yWires[i]] = y[i];
+    }
+    for (let i = 0; i < this.ops.length; i++) {
+      const a = values[this.in1[i]];
+      const b = values[this.in2[i]];
+      if (a < 0 || b < 0) continue;
+      const op = this.ops[i];
+      values[this.out[i]] = op === 0 ? a & b : op === 1 ? a | b : a ^ b;
+    }
+    for (let i = 0; i <= this.bits; i++) result[i] = values[this.zWires[i]];
+  }
+}
+
+/** Gate indices sorted so every gate comes after the gates driving its inputs. */
+function topologicalOrder(gates: Gate[]): number[] {
+  const driver = new Map<string, number>();
+  for (let i = 0; i < gates.length; i++) driver.set(gates[i].out, i);
+
+  const consumers = new Map<string, number[]>();
+  const pending = new Int32Array(gates.length);
+  for (let i = 0; i < gates.length; i++) {
+    const inputs = gates[i].in1 === gates[i].in2 ? [gates[i].in1] : [gates[i].in1, gates[i].in2];
+    for (const wire of inputs) {
+      if (!driver.has(wire)) continue;
+      pending[i]++;
+      const list = consumers.get(wire);
+      if (list) list.push(i);
+      else consumers.set(wire, [i]);
+    }
+  }
+
+  const order: number[] = [];
+  const ready: number[] = [];
+  for (let i = 0; i < gates.length; i++) if (pending[i] === 0) ready.push(i);
+  while (ready.length > 0) {
+    const index = ready.pop() as number;
+    order.push(index);
+    const dependents = consumers.get(gates[index].out);
+    if (!dependents) continue;
+    for (const dependent of dependents) {
+      if (--pending[dependent] === 0) ready.push(dependent);
+    }
+  }
+  // Gates left over are part of a cycle; dropping them leaves their outputs
+  // undefined, which shows up as a failed check rather than a hang.
+  return order;
+}
+
+export interface TestVector {
+  x: Uint8Array;
+  y: Uint8Array;
+  /** expected sum bits, length bits + 1 */
+  z: Int8Array;
+}
+
+function expectedSum(x: Uint8Array, y: Uint8Array): Int8Array {
+  const bits = x.length;
+  const z = new Int8Array(bits + 1);
+  let carry = 0;
+  for (let i = 0; i < bits; i++) {
+    const total = x[i] + y[i] + carry;
+    z[i] = total & 1;
+    carry = total > 1 ? 1 : 0;
+  }
+  z[bits] = carry;
+  return z;
+}
+
+/**
+ * Input vectors that exercise every bit position with and without a carry-in,
+ * plus a batch of pseudo-random ones. Enough to pin down which bit of an adder
+ * is misbehaving.
+ */
+export function makeTestVectors(bits: number): TestVector[] {
+  const vectors: TestVector[] = [];
+  const zero = () => new Uint8Array(bits);
+  const add = (x: Uint8Array, y: Uint8Array) => vectors.push({ x, y, z: expectedSum(x, y) });
+
+  const ones = () => new Uint8Array(bits).fill(1);
+  const one = () => {
+    const v = zero();
+    v[0] = 1;
+    return v;
+  };
+  add(zero(), zero());
+  add(ones(), zero());
+  add(zero(), ones());
+  add(ones(), ones());
+  add(ones(), one());
+
+  for (let i = 0; i < bits; i++) {
+    const bit = zero();
+    bit[i] = 1;
+    const below = zero();
+    for (let j = 0; j < i; j++) below[j] = 1;
+    add(bit, zero());
+    add(zero(), bit);
+    add(bit, bit.slice());
+    add(bit, below); // carry-in of 0 at bit i
+    add(below, one()); // ripple a carry all the way into bit i
+  }
+
+  // xorshift32 keeps the vectors deterministic across runs.
+  let seed = 0x2545f491;
+  const random = () => {
+    seed ^= seed << 13;
+    seed ^= seed >>> 17;
+    seed ^= seed << 5;
+    seed >>>= 0;
+    return seed;
+  };
+  for (let k = 0; k < 40; k++) {
+    const x = zero();
+    const y = zero();
+    for (let i = 0; i < bits; i++) {
+      x[i] = random() & 1;
+      y[i] = random() & 1;
+    }
+    add(x, y);
+  }
+  return vectors;
+}
+
+/** True when the circuit computes x + y = z for every test vector. */
+export function isCorrectAdder(gates: Gate[], bits: number, vectors: TestVector[]): boolean {
+  const compiled = new CompiledAdder(gates, bits);
+  const actual = new Int8Array(bits + 1);
+  for (const vector of vectors) {
+    compiled.evaluate(vector.x, vector.y, actual);
+    for (let i = 0; i <= bits; i++) {
+      if (actual[i] !== vector.z[i]) return false;
+    }
+  }
+  return true;
+}
