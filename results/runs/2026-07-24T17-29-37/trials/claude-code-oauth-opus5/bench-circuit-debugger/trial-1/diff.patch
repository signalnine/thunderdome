@@ -0,0 +1,67 @@
+import type { Gate, WireValues } from './types.js';
+
+export function applyOp(op: Gate['op'], a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+    default: {
+      const never: never = op;
+      throw new Error(`Unknown gate operation: ${String(never)}`);
+    }
+  }
+}
+
+/**
+ * Evaluate a combinational circuit.
+ *
+ * Gates fire as soon as both of their inputs have a value, so they may be given
+ * in any order. Gates whose inputs are never driven simply never fire and their
+ * output wire is absent from the result.
+ */
+export function simulate(gates: Gate[], inputs: WireValues): WireValues {
+  const values: WireValues = {};
+  for (const wire of Object.keys(inputs)) {
+    values[wire] = inputs[wire] ? 1 : 0;
+  }
+
+  // wire name -> indices of the gates reading it
+  const readers = new Map<string, number[]>();
+  const addReader = (wire: string, index: number) => {
+    const list = readers.get(wire);
+    if (list) list.push(index);
+    else readers.set(wire, [index]);
+  };
+  for (let i = 0; i < gates.length; i++) {
+    addReader(gates[i].in1, i);
+    if (gates[i].in2 !== gates[i].in1) addReader(gates[i].in2, i);
+  }
+
+  const fired = new Uint8Array(gates.length);
+  const queue: number[] = [];
+  const enqueueIfReady = (index: number) => {
+    if (fired[index]) return;
+    const gate = gates[index];
+    if (values[gate.in1] === undefined || values[gate.in2] === undefined) return;
+    queue.push(index);
+  };
+
+  for (let i = 0; i < gates.length; i++) enqueueIfReady(i);
+
+  while (queue.length > 0) {
+    const index = queue.pop() as number;
+    if (fired[index]) continue;
+    fired[index] = 1;
+    const gate = gates[index];
+    values[gate.out] = applyOp(gate.op, values[gate.in1], values[gate.in2]);
+    const dependents = readers.get(gate.out);
+    if (dependents) {
+      for (const dependent of dependents) enqueueIfReady(dependent);
+    }
+  }
+
+  return values;
+}
