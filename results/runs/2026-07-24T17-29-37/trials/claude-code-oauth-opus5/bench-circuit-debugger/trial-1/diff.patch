+import { describe, expect, it } from 'vitest';
+import { simulate } from '../src/index.js';
+import type { Gate } from '../src/types.js';
+import { applySwaps, buildAdder, makeRandom, referenceSum } from './helpers/adder.js';
+
+describe('simulate', () => {
+  it('applies each operation', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'and' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'or' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'xor' },
+    ];
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, and: 0, or: 1, xor: 1 });
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, and: 1, or: 1, xor: 0 });
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, and: 0, or: 0, xor: 0 });
+  });
+
+  it('resolves gates given out of dependency order', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'second', in2: 'x', out: 'third' },
+      { op: 'OR', in1: 'first', in2: 'y', out: 'second' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'first' },
+    ];
+    const values = simulate(gates, { a: 1, b: 0, x: 1, y: 0 });
+    expect(values.first).toBe(1);
+    expect(values.second).toBe(1);
+    expect(values.third).toBe(1);
+  });
+
+  it('handles a deep chain of gates', () => {
+    const gates: Gate[] = [];
+    for (let i = 0; i < 500; i++) {
+      gates.push({ op: 'XOR', in1: `w${i}`, in2: 'one', out: `w${i + 1}` });
+    }
+    gates.reverse();
+    const values = simulate(gates, { w0: 0, one: 1 });
+    expect(values.w500).toBe(0);
+    expect(values.w499).toBe(1);
+  });
+
+  it('leaves wires with undriven inputs out of the result', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'ok' },
+      { op: 'AND', in1: 'missing', in2: 'a', out: 'unreachable' },
+      { op: 'OR', in1: 'unreachable', in2: 'a', out: 'downstream' },
+    ];
+    const values = simulate(gates, { a: 1, b: 1 });
+    expect(values.ok).toBe(1);
+    expect(values.unreachable).toBeUndefined();
+    expect(values.downstream).toBeUndefined();
+  });
+
+  it('accepts a gate reading the same wire twice', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'a', out: 'z' }];
+    expect(simulate(gates, { a: 1 }).z).toBe(0);
+  });
+
+  it('returns the given input values unchanged', () => {
+    const values = simulate([], { a: 1, b: 0 });
+    expect(values).toEqual({ a: 1, b: 0 });
+  });
+
+  it('computes the example 4-bit adder', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+      { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },
+      { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },
+      { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },
+      { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },
+      { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },
+      { op: 'XOR', in1: 'x02', in2: 'y02', out: 't02' },
+      { op: 'XOR', in1: 't02', in2: 'c01', out: 'z02' },
+      { op: 'AND', in1: 'x02', in2: 'y02', out: 'a02' },
+      { op: 'AND', in1: 't02', in2: 'c01', out: 'b02' },
+      { op: 'OR', in1: 'a02', in2: 'b02', out: 'c02' },
+      { op: 'XOR', in1: 'x03', in2: 'y03', out: 't03' },
+      { op: 'XOR', in1: 't03', in2: 'c02', out: 'z03' },
+      { op: 'AND', in1: 'x03', in2: 'y03', out: 'a03' },
+      { op: 'AND', in1: 't03', in2: 'c02', out: 'b03' },
+      { op: 'OR', in1: 'a03', in2: 'b03', out: 'z04' },
+    ];
+    // 13 + 6 = 19
+    const inputs: Record<string, number> = {
+      x00: 1, x01: 0, x02: 1, x03: 1,
+      y00: 0, y01: 1, y02: 1, y03: 0,
+    };
+    const values = simulate(gates, inputs);
+    expect([values.z00, values.z01, values.z02, values.z03, values.z04]).toEqual([1, 1, 0, 0, 1]);
+  });
+
+  it('adds correctly across random generated adders', () => {
+    const random = makeRandom(99);
+    for (const bits of [1, 2, 8, 20]) {
+      const { gates } = buildAdder(bits, random);
+      for (let trial = 0; trial < 25; trial++) {
+        const x = Array.from({ length: bits }, () => (random() < 0.5 ? 0 : 1));
+        const y = Array.from({ length: bits }, () => (random() < 0.5 ? 0 : 1));
+        const inputs: Record<string, number> = {};
+        for (let i = 0; i < bits; i++) {
+          inputs[`x${String(i).padStart(2, '0')}`] = x[i];
+          inputs[`y${String(i).padStart(2, '0')}`] = y[i];
+        }
+        const values = simulate(gates, inputs);
+        const expectedBits = referenceSum(x, y);
+        const actual = expectedBits.map((_, i) => values[`z${String(i).padStart(2, '0')}`]);
+        expect(actual).toEqual(expectedBits);
+      }
+    }
+  });
+
+  it('is unaffected by the order gates are listed in', () => {
+    const random = makeRandom(7);
+    const { gates } = buildAdder(6, random);
+    const swapped = applySwaps(gates, []);
+    const inputs: Record<string, number> = {};
+    for (let i = 0; i < 6; i++) {
+      inputs[`x${String(i).padStart(2, '0')}`] = 1;
+      inputs[`y${String(i).padStart(2, '0')}`] = i % 2;
+    }
+    expect(simulate([...swapped].reverse(), inputs)).toEqual(simulate(swapped, inputs));
+  });
+});
