+import type { Gate } from './types.js';
+import { inputBitCount } from './naming.js';
+import { repairAdder } from './repair.js';
+
+export type { Gate, WireValues } from './types.js';
+export { simulate } from './simulate.js';
+
+/**
+ * The circuit is a binary adder computing x + y = z in which four pairs of gate
+ * output wires have been exchanged. Returns the eight wires involved, sorted.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  const bits = inputBitCount(gates);
+  if (bits === 0) return [];
+  return repairAdder(gates, bits);
+}
