s inputs is taken to be the partial sum. Ordered by how many swaps the\n   * choice forces, so the undisturbed reading is tried first.\n   */\n  private sumGateCandidates(\n    bit: number,\n    previous: CarrySource,\n    partialGate: number,\n  ): { gate: number; partial: string; carry: string }[] {\n    const circuit = this.circuit;\n    const partialName = circuit.outputOf(partialGate);\n    const z = bitWire('z', bit);\n\n    const gates = new Set<number>(circuit.readers(partialName, 'XOR'));\n    for (const carry of this.carryGateCandidates(previous)) {\n      for (const gate of circuit.readers(circuit.outputOf(carry), 'XOR')) gates.add(gate);\n    }\n    const zDriver = circuit.driverOf(z);\n    if (zDriver >= 0 && circuit.gates[zDriver].op === 'XOR') gates.add(zDriver);\n    if (this.exhaustive) {\n      for (let i = 0; i < circuit.gates.length; i++) if (circuit.gates[i].op === 'XOR') gates.add(i);\n    }\n\n    const candidates: { gate: number; partial: string; carry: string; cost: number }[] = [];\n    for (const gate of gates) {\n      const { in1, in2 } = circuit.gates[gate];\n      const orientations: [string, string][] = in1 === in2 ? [[in1, in2]] : [[in1, in2], [in2, in1]];\n      for (const [partial, carry] of orientations) {\n        // The carry has to come from a gate, and this bit needs its own AND gate\n        // on the very same pair of wires.\n        if (circuit.driverOf(carry) < 0) continue;\n        if (circuit.findGate('AND', partial, carry) < 0) continue;\n        const cost = (partial === partialName ? 0 : 1) + (circuit.outputOf(gate) === z ? 0 : 1);\n        candidates.push({ gate, partial, carry, cost });\n      }\n    }\n    candidates.sort((a, b) => a.cost - b.cost);\n    return candidates;\n  }\n\n  private trySumGate(\n    bit: number,\n    previous: CarrySource,\n    partialGate: number,\n    generateGate: number,\n    candidate: { gate: number; partial: string; carry: string },\n    z: string,\n  ): string[] | null {\n    const circuit = this.circuit;\n    // The sum gate reads the partial sum, so that is what the half adder's XOR\n    // gate must be called.\n    if (!circuit.trySwapOutputs(circuit.outputOf(partialGate), candidate.partial)) return null;\n    if (!circuit.trySwapOutputs(circuit.outputOf(candidate.gate), z)) return null;\n\n    const propagateGate = circuit.findGate('AND', candidate.partial, candidate.carry);\n    if (propagateGate < 0) return null;\n\n    // The bit below has to deliver its carry on the wire this bit reads.\n    return this.withCarryNamed(previous, candidate.carry, () =>\n      this.solveBit(bit + 1, { kind: 'ripple', generate: generateGate, propagate: propagateGate }),\n    );\n  }\n\n  /**\n   * Gates that could be the carry gate of the bit below: the OR gate wired to\n   * both of its feeders, and those wired to just one of them (the other feeder\n   * having been displaced).\n   */\n  private carryGateCandidates(source: CarrySource, wanted?: string): number[] {\n    const circuit = this.circuit;\n    if (source.kind === 'half') return [source.gate];\n    const generate = circuit.outputOf(source.generate);\n    const propagate = circuit.outputOf(source.propagate);\n    const candidates = new Set<number>([...circuit.readers(generate, 'OR'), ...circuit.readers(propagate, 'OR')]);\n    if (wanted !== undefined) {\n      const named = circuit.driverOf(wanted);\n      if (named >= 0 && circuit.gates[named].op === 'OR') candidates.add(named);\n    }\n    return [...candidates];\n  }\n\n  /**\n   * Run `next` for each way of making the carry gate below come out on `name`,\n   * undoing the swaps in between. Cheaper repairs are tried first.\n   */\n  private withCarryNamed(source: CarrySource, name: string, next: () => string[] | null): string[] | null {\n    this.steps++;\n    if (this.exhausted()) return null;\n    const circuit = this.circuit;\n    const depth = circuit.depth;\n\n    const attempt = (gate: number, apply: () => boolean): string[] | null => {\