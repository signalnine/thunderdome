@@ -0,0 +1,238 @@
+import type { Gate } from '../../src/types.js';
+import { simulate } from '../../src/index.js';
+
+/** Deterministic xorshift32 PRNG so failures are reproducible. */
+export function makeRandom(seed: number): () => number {
+  let state = seed >>> 0 || 1;
+  return () => {
+    state ^= state << 13;
+    state ^= state >>> 17;
+    state ^= state << 5;
+    state >>>= 0;
+    return state / 0x100000000;
+  };
+}
+
+const pad = (index: number) => String(index).padStart(2, '0');
+
+export interface GeneratedAdder {
+  gates: Gate[];
+  bits: number;
+  /** Names of the internal wires, grouped by role, for building swaps. */
+  internal: { partial: string[]; generate: string[]; propagate: string[]; carry: string[] };
+}
+
+/**
+ * Build a correct ripple-carry adder of `bits` input bits with randomly named
+ * internal wires and gates emitted in random order.
+ */
+export function buildAdder(bits: number, random: () => number): GeneratedAdder {
+  const usedNames = new Set<string>();
+  const letters = 'abcdefghijklmnopqrstuvwxyz';
+  const freshName = (): string => {
+    for (;;) {
+      let name = '';
+      for (let i = 0; i < 3; i++) name += letters[Math.floor(random() * letters.length)];
+      if (!usedNames.has(name)) {
+        usedNames.add(name);
+        return name;
+      }
+    }
+  };
+
+  const gates: Gate[] = [];
+  const internal = { partial: [] as string[], generate: [] as string[], propagate: [] as string[], carry: [] as string[] };
+
+  // Bit 0 is a half adder.
+  gates.push({ op: 'XOR', in1: `x00`, in2: `y00`, out: `z00` });
+  let carry = bits === 1 ? `z${pad(1)}` : freshName();
+  gates.push({ op: 'AND', in1: `x00`, in2: `y00`, out: carry });
+  if (bits > 1) internal.carry.push(carry);
+
+  for (let bit = 1; bit < bits; bit++) {
+    const x = `x${pad(bit)}`;
+    const y = `y${pad(bit)}`;
+    const partial = freshName();
+    const generate = freshName();
+    const propagate = freshName();
+    const carryOut = bit === bits - 1 ? `z${pad(bits)}` : freshName();
+    gates.push({ op: 'XOR', in1: x, in2: y, out: partial });
+    gates.push({ op: 'AND', in1: x, in2: y, out: generate });
+    gates.push({ op: 'XOR', in1: partial, in2: carry, out: `z${pad(bit)}` });
+    gates.push({ op: 'AND', in1: partial, in2: carry, out: propagate });
+    gates.push({ op: 'OR', in1: generate, in2: propagate, out: carryOut });
+    internal.partial.push(partial);
+    internal.generate.push(generate);
+    internal.propagate.push(propagate);
+    if (bit < bits - 1) internal.carry.push(carryOut);
+    carry = carryOut;
+  }
+
+  // Shuffle so no consumer can rely on gate ordering, and randomise input order.
+  for (const gate of gates) {
+    if (random() < 0.5) {
+      const swap = gate.in1;
+      gate.in1 = gate.in2;
+      gate.in2 = swap;
+    }
+  }
+  for (let i = gates.length - 1; i > 0; i--) {
+    const j = Math.floor(random() * (i + 1));
+    [gates[i], gates[j]] = [gates[j], gates[i]];
+  }
+
+  return { gates, bits, internal };
+}
+
+/**
+ * Exchange the output wires of the gates driving each pair.
+ * Returns a new gate list; the original is untouched.
+ */
+export function applySwaps(gates: Gate[], pairs: [string, string][]): Gate[] {
+  const swapped = gates.map((gate) => ({ ...gate }));
+  for (const [a, b] of pairs) {
+    const gateA = swapped.find((gate) => gate.out === a);
+    const gateB = swapped.find((gate) => gate.out === b);
+    if (!gateA || !gateB) throw new Error(`cannot swap ${a} with ${b}`);
+    gateA.out = b;
+    gateB.out = a;
+  }
+  return swapped;
+}
+
+/** True when every gate can be reached in dependency order. */
+export function isAcyclic(gates: Gate[]): boolean {
+  const driver = new Map(gates.map((gate, index) => [gate.out, index]));
+  const state = new Uint8Array(gates.length); // 0 unvisited, 1 in progress, 2 done
+  const visit = (index: number): boolean => {
+    if (state[index] === 1) return false;
+    if (state[index] === 2) return true;
+    state[index] = 1;
+    for (const wire of [gates[index].in1, gates[index].in2]) {
+      const next = driver.get(wire);
+      if (next !== undefined && !visit(next)) return false;
+    }
+    state[index] = 2;
+    return true;
+  };
+  return gates.every((_, index) => visit(index));
+}
+
+/**
+ * Pick four disjoint pairs of wires to swap.
+ *
+ * Two swaps are functionally invisible and therefore unanswerable, so they are
+ * excluded: exchanging the two inputs of the same OR gate (generate/propagate of
+ * one bit), and exchanging the partial-sum with the carry-in of the same bit,
+ * since those two wires feed the same symmetric pair of gates. Swap sets that
+ * make the circuit cyclic are rejected too — the puzzle promises acyclic input.
+ */
+export function pickSwapPairs(adder: GeneratedAdder, random: () => number): [string, string][] {
+  const { internal } = adder;
+  const all = [
+    ...internal.partial,
+    ...internal.generate,
+    ...internal.propagate,
+    ...internal.carry,
+    ...Array.from({ length: adder.bits + 1 }, (_, i) => `z${pad(i)}`),
+  ];
+  const ambiguous = new Set<string>();
+  for (let i = 0; i < internal.generate.length; i++) {
+    ambiguous.add(`${internal.generate[i]}|${internal.propagate[i]}`);
+    ambiguous.add(`${internal.propagate[i]}|${internal.generate[i]}`);
+    // partial of bit i+1 shares both consumers with the carry into bit i+1
+    ambiguous.add(`${internal.partial[i]}|${internal.carry[i]}`);
+    ambiguous.add(`${internal.carry[i]}|${internal.partial[i]}`);
+  }
+
+  for (let attempt = 0; attempt < 200; attempt++) {
+    const pool = [...all];
+    for (let i = pool.length - 1; i > 0; i--) {
+      const j = Math.floor(random() * (i + 1));
+      [pool[i], pool[j]] = [pool[j], pool[i]];
+    }
+    const pairs: [string, string][] = [];
+    for (let i = 0; i < 4; i++) {
+      pairs.push([pool[i * 2], pool[i * 2 + 1]]);
+    }
+    if (pairs.some(([a, b]) => ambiguous.has(`${a}|${b}`))) continue;
+    if (isAcyclic(applySwaps(adder.gates, pairs))) return pairs;
+  }
+  throw new Error('could not pick unambiguous swap pairs');
+}
+
+/** True when the circuit adds x + y = z for every one of the given cases. */
+export function addsCorrectly(gates: Gate[], bits: number, cases: [number[], number[]][]): boolean {
+  return cases.every(([x, y]) => {
+    const inputs: Record<string, number> = {};
+    for (let i = 0; i < bits; i++) {
+      inputs[`x${pad(i)}`] = x[i];
+      inputs[`y${pad(i)}`] = y[i];
+    }
+    const values = simulate(gates, inputs);
+    return referenceSum(x, y).every((bit, i) => values[`z${pad(i)}`] === bit);
+  });
+}
+
+/** Input pairs that exercise every bit position, plus random ones. */
+export function makeCases(bits: number, random: () => number, randomCount = 200): [number[], number[]][] {
+  const zeros = () => Array.from({ length: bits }, () => 0);
+  const cases: [number[], number[]][] = [[zeros(), zeros()], [zeros().fill(1), zeros().fill(1)]];
+  for (let i = 0; i < bits; i++) {
+    const bit = zeros();
+    bit[i] = 1;
+    const below = zeros();
+    for (let j = 0; j < i; j++) below[j] = 1;
+    const one = zeros();
+    one[0] = 1;
+    cases.push([bit, bit.slice()], [bit, zeros()], [below, one], [bit, below]);
+  }
+  for (let i = 0; i < randomCount; i++) {
+    cases.push([
+      Array.from({ length: bits }, () => (random() < 0.5 ? 0 : 1)),
+      Array.from({ length: bits }, () => (random() < 0.5 ? 0 : 1)),
+    ]);
+  }
+  return cases;
+}
+
+/**
+ * Whether some pairing of `wires` repairs the circuit.
+ *
+ * A handful of swap sets are not the only ones that explain a broken adder, so
+ * a different answer of the right shape can still be a correct one.
+ */
+export function isValidAnswer(gates: Gate[], bits: number, wires: string[], random: () => number): boolean {
+  if (wires.length !== 8) return false;
+  const cases = makeCases(bits, random);
+  const pairings: [string, string][][] = [];
+  const build = (rest: string[], acc: [string, string][]) => {
+    if (rest.length === 0) {
+      pairings.push(acc);
+      return;
+    }
+    const [head, ...tail] = rest;
+    tail.forEach((mate, i) => build(tail.filter((_, j) => j !== i), [...acc, [head, mate]]));
+  };
+  build(wires, []);
+  return pairings.some((pairing) => {
+    try {
+      return addsCorrectly(applySwaps(gates, pairing), bits, cases);
+    } catch {
+      return false;
+    }
+  });
+}
+
+/** Add two bit arrays, returning bits.length + 1 output bits. */
+export function referenceSum(x: number[], y: number[]): number[] {
+  const z: number[] = [];
+  let carry = 0;
+  for (let i = 0; i < x.length; i++) {
+    const total = x[i] + y[i] + carry;
+    z.push(total & 1);
+    carry = total > 1 ? 1 : 0;
+  }
+  z.push(carry);
+  return z;
+}
