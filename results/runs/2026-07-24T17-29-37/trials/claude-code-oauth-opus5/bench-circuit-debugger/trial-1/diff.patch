+import type { Gate } from './types.js';
+
+/** Wire name for bit `index` of a register, e.g. `bitWire('z', 5) === 'z05'`. */
+export function bitWire(register: 'x' | 'y' | 'z', index: number): string {
+  return register + String(index).padStart(2, '0');
+}
+
+/** Bit index of a register wire, or -1 if the name is not `<register><digits>`. */
+function bitIndex(wire: string, register: 'x' | 'y' | 'z'): number {
+  if (wire.length < 2 || wire[0] !== register) return -1;
+  const digits = wire.slice(1);
+  if (!/^\d+$/.test(digits)) return -1;
+  return Number(digits);
+}
+
+/**
+ * Number of input bits of the adder, i.e. the highest `xNN` index plus one.
+ * Outputs then run `z00..z<bits>` — one extra bit for the final carry.
+ */
+export function inputBitCount(gates: Gate[]): number {
+  let highest = -1;
+  for (const gate of gates) {
+    for (const wire of [gate.in1, gate.in2]) {
+      const index = bitIndex(wire, 'x');
+      if (index > highest) highest = index;
+    }
+  }
+  return highest + 1;
+}
