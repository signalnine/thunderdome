+import { describe, expect, it } from 'vitest';
+import { findSwappedWires } from '../src/index.js';
+import { applySwaps, buildAdder, isValidAnswer, makeRandom, pickSwapPairs } from './helpers/adder.js';
+
+/**
+ * Randomised sweep over adder sizes and swap placements. Wire names are picked
+ * at random from every internal and output wire, so swaps land in combinations
+ * no hand-written case would think of.
+ */
+describe('findSwappedWires under random scrambling', () => {
+  it('recovers the swapped wires across many random circuits', () => {
+    const random = makeRandom(20241224);
+    const trials = 150;
+    let slowest = 0;
+    let ambiguous = 0;
+
+    for (let trial = 0; trial < trials; trial++) {
+      const bits = 4 + Math.floor(random() * 42);
+      const adder = buildAdder(bits, random);
+      const pairs = pickSwapPairs(adder, random);
+      const swapped = applySwaps(adder.gates, pairs);
+      const expected = [...pairs.flat()].sort();
+
+      const started = performance.now();
+      const found = findSwappedWires(swapped);
+      slowest = Math.max(slowest, performance.now() - started);
+
+      const context = `bits=${bits} trial=${trial} pairs=${JSON.stringify(pairs)}`;
+      if (found.join() === expected.join()) continue;
+
+      // A few scrambles can be undone in more than one way. Any answer that
+      // repairs the circuit is a correct one.
+      expect(isValidAnswer(swapped, bits, found, makeRandom(trial + 1)), `${context} found=${found}`).toBe(true);
+      ambiguous++;
+    }
+
+    // Alternative repairs should stay the rare exception, not the rule.
+    expect(ambiguous).toBeLessThan(trials / 20);
+    expect(slowest).toBeLessThan(1000);
+  });
+
+  it('recovers swaps in circuits with only a couple of bits', () => {
+    const random = makeRandom(17);
+    for (const bits of [3, 4, 5]) {
+      for (let trial = 0; trial < 10; trial++) {
+        const adder = buildAdder(bits, random);
+        const pairs = pickSwapPairs(adder, random);
+        const swapped = applySwaps(adder.gates, pairs);
+        const found = findSwappedWires(swapped);
+        const context = `bits=${bits} trial=${trial} pairs=${JSON.stringify(pairs)}`;
+        if (found.join() === [...pairs.flat()].sort().join()) continue;
+        expect(isValidAnswer(swapped, bits, found, makeRandom(trial + 1)), context).toBe(true);
+      }
+    }
+  });
+});
