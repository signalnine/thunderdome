const { in1, in2 } = circuit.gates[candidate];\n        for (const [forGenerate, forPropagate] of [\n          [in1, in2],\n          [in2, in1],\n        ]) {\n          result = attempt(\n            () =>\n              circuit.trySwapOutputs(generate, forGenerate) &&\n              circuit.trySwapOutputs(propagate, forPropagate) &&\n              fixOutput(),\n          );\n          if (result) break;\n        }\n      }\n      if (result) return result;\n    }\n    return null;\n  }\n\n  /** How many swaps it would take to make `candidate` the carry gate. */\n  private carryRepairCost(candidate: number, generate: string, propagate: string, name: string): number {\n    const circuit = this.circuit;\n    return (\n      (circuit.reads(candidate, generate) ? 0 : 1) +\n      (circuit.reads(candidate, propagate) ? 0 : 1) +\n      (circuit.outputOf(candidate) === name ? 0 : 1)\n    );\n  }","originalFile":"import type { Gate } from './types.js';\nimport { bitWire } from './naming.js';\nimport { isCorrectAdder, makeTestVectors, type TestVector } from './evaluator.js';\n\nconst SWAP_PAIRS = 4;\n\nfunction signature(op: Gate['op'], a: string, b: string): string {\n  return a < b ? `${op} ${a} ${b}` : `${op} ${b} ${a}`;\n}\n\n/**\n * A mutable copy of the circuit that records the output-wire swaps applied to\n * it and can roll them back, so a search can try a repair and undo it.\n *\n * Only output wire names ever move: gate inputs are exactly as given. A wire may\n * take part in at most one swap, since the four swapped pairs are disjoint.\n */\nclass WorkingCircuit {\n  readonly gates: Gate[];\n  readonly swaps: string[] = [];\n  private readonly swapped = new Set<string>();\n  private byOutput = new Map<string, number>();\n  private bySignature = new Map<string, number>();\n  private byInput = new Map<string, number[]>();\n\n  constructor(source: Gate[]) {\n    this.gates = source.map((gate) => ({ ...gate }));\n    this.reindex();\n  }\n\n  private reindex(): void {\n    this.byOutput = new Map();\n    this.bySignature = new Map();\n    this.byInput = new Map();\n    for (let i = 0; i < this.gates.length; i++) {\n      const gate = this.gates[i];\n      this.byOutput.set(gate.out, i);\n      this.bySignature.set(signature(gate.op, gate.in1, gate.in2), i);\n      for (const wire of gate.in1 === gate.in2 ? [gate.in1] : [gate.in1, gate.in2]) {\n        const list = this.byInput.get(wire);\n        if (list) list.push(i);\n        else this.byInput.set(wire, [i]);\n      }\n    }\n  }\n\n  /** Index of the gate with this operation and input pair, or -1. */\n  findGate(op: Gate['op'], a: string, b: string): number {\n    const index = this.bySignature.get(signature(op, a, b));\n    return index === undefined ? -1 : index;\n  }\n\n  /** Index of the gate driving `wire`, or -1 if nothing drives it. */\n  driverOf(wire: string): number {\n    const index = this.byOutput.get(wire);\n    return index === undefined ? -1 : index;\n  }\n\n  outputOf(index: number): string {\n    return this.gates[index].out;\n  }\n\n  reads(index: number, wire: string): boolean {\n    const gate = this.gates[index];\n    return gate.in1 === wire || gate.in2 === wire;\n  }\n\n  /** Gates of the given operation that read `wire`. */\n  readers(wire: string, op: Gate['op']): number[] {\n    return (this.byInput.get(wire) ?? []).filter((index) => this.gates[index].op === op);\n  }\n\n  /** The input of gate `index` that is not `wire`. */\n  otherInput(index: number, wire: string): string {\n    const gate = this.gates[index];\n    return gate.in1 === wire ? gate.in2 : gate.in1;\n  }\n\n  /**\n   * Exchange the gates driving the two wires. Fails (leaving the circuit alone)\n   * when either wire is undriven, already part of a swap, or when the swap\n   * budget is used up.\n   */\n  trySwapOutputs(first: string, second: string): boolean {\n    if (first === second) return true;\n    if (this.swaps.length >= SWAP_PAIRS * 2) return false;\n    if (this.swapped.has(first) || this.swapped.has(second)) return false;\n    const a = this.byOutput.get(first);\n    const b = this.byOutput.get(second);\n    if (a === undefined || b === undefined) return false;\n    this.gates[a].out = second;\n    this.gates[b].out = first;\n    this.swaps.push(first, second);\n    this.swapped.add(first).add(second);\n    this.reindex();\n    return true;\n  }\n\n  get depth(): number {\n    return this.swaps.length;\n  }\n\n  /** Undo every swap made after `depth`. */\n  rewind(depth: number): void {\n    while (this.swaps.length > depth) {\n      const second = this.swaps.pop() as string;\n      const first = this.swaps.pop() as string;\n      this.swapped.delete(first);\n      this.swapped.delete(second);\n      const a = this.byOutput.get(first) as number;\n      const b = this.byOutput.get(second) as number;\n      this.gates[a].out = second;\n      this.gates[b].out = first;\n      this.reindex();\n    }\n  }\n}\n\n/**\n * How the carry out of the bit below is produced: bit 0 hands over a single AND\n * gate, every other bit an OR gate identified by the two gates feeding it.\n */\ntype CarrySource =\n  | { kind: 'half'; gate: number }\n  | { kind: 'ripple'; generate: number; propagate: number };\n\ninterface Solution {\n  wires: string[];\n  complete: boolean;\n}\n\n/**\n * Reconstruct the adder by deciding, bit by bit, which gate plays which role.\n *\n * Gate inputs are untouched by the swaps, so the two half-adder gates of every\n * bit are known outright: they are the ones reading x_i and y_i. Everything else\n * follows from them. For bit i the circuit must contain\n *\n *   partial   = x_i XOR y_i          generate  = x_i AND y_i\n *   z_i       = partial XOR carry    propagate = partial AND carry\n *   carry_out = generate OR propagate\n *\n * so once we pick the XOR gate that plays `z_i`, its two inputs name the wires\n * that `partial` and the incoming carry must be called — each mismatch is a\n * forced swap. Candidates that need more than the four available swaps, or that\n * would move a wire already involved in one, are cut immediately, which keeps\n * the search tiny even though it backtracks.\n */\nclass AdderSolver {\n  private readonly circuit: WorkingCircuit;\n  private readonly vectors: TestVector[];\n  /** A repair that adds correctly but moves fewer than eight wires. */\n  private partial: string[] | null = null;\n  private steps = 0;\n\n  constructor(\n    source: Gate[],\n    private readonly bits: number,\n    private readonly exhaustive: boolean,\n    private readonly deadline: number,\n  ) {\n    this.circuit = new WorkingCircuit(source);\n    this.vectors = makeTestVectors(bits);\n  }\n\n  solve(): Solution | null {\n    const circuit = this.circuit;\n    const halfSum = circuit.findGate('XOR', bitWire('x', 0), bitWire('y', 0));\n    const halfCarry = circuit.findGate('AND', bitWire('x', 0), bitWire('y', 0));\n    if (halfSum < 0 || halfCarry < 0) return null;\n\n    // Bit 0 has no carry-in, so its sum gate is simply z00.\n    if (circuit.outputOf(halfSum) !== bitWire('z', 0) && !circuit.trySwapOutputs(circuit.outputOf(halfSum), bitWire('z', 0))) {\n      return null;\n    }\n    const found = this.solveBit(1, { kind: 'half', gate: halfCarry });\n    if (found) return { wires: found, complete: true };\n    return this.partial ? { wires: this.partial, complete: false } : null;\n  }\n\n  /** True once the search has spent its time budget. */\n  private exhausted(): boolean {\n    return (this.steps & 0xff) === 0 && Date.now() > this.deadline;\n  }\n\n  private solveBit(bit: number, previous: CarrySource): string[] | null {\n    this.steps++;\n    if (this.exhausted()) return null;\n    const circuit = this.circuit;\n\n    if (bit === this.bits) {\n      // The carry out of the top bit is the extra output bit.\n      return this.withCarryNamed(previous, bitWire('z', this.bits), () => this.accept());\n    }\n\n    const x = bitWire('x', bit);\n    const y = bitWire('y', bit);\n    const z = bitWire('z', bit);\n    const partialGate = circuit.findGate('XOR', x, y);\n    const generateGate = circuit.findGate('AND', x, y);\n    if (partialGate < 0 || generateGate < 0) return null;\n\n    for (const candidate of this.sumGateCandidates(bit, previous, partialGate)) {\n      const depth = circuit.depth;\n      const result = this.trySumGate(bit, previous, partialGate, generateGate, candidate, z);\n      circuit.rewind(depth);\n      if (result) return result;\n    }\n    return null;\n  }\n\n  /**\n   * The XOR gates that could be this bit's sum gate, each paired with which of\n   * its inputs is taken to be the partial sum. Ordered by how many swaps the\n   * choice forces, so the undisturbed reading is tried first.\n   */\n  private sumGateCandidates(\n    bit: number,\n    previous: CarrySource,\n    partialGate: number,\n  ): { gate: number; partial: string; carry: string }[] {\n    const circuit = this.circuit;\n    const partialName = circuit.outputOf(partialGate);\n    const z = bitWire('z', bit);\n\n    const gates = new Set<number>(circuit.readers(partialName, 'XOR'));\n    for (const carry of this.carryGateCandidates(previous)) {\n      for (const gate of circuit.readers(circuit.outputOf(carry), 'XOR')) gates.add(gate);\n    }\n    const zDriver = circuit.driverOf(z);\n    if (zDriver >= 0 && circuit.gates[zDriver].op === 'XOR') gates.add(zDriver);\n    if (this.exhaustive) {\n      for (let i = 0; i < circuit.gates.length; i++) if (circuit.gates[i].op === 'XOR') gates.add(i);\n    }\n\n    const candidates: { gate: number; partial: string; carry: string; cost: number }[] = [];\n    for (const gate of gates) {\n      const { in1, in2 } = circuit.gates[gate];\n      const orientations: [string, string][] = in1 === in2 ? [[in1, in2]] : [[in1, in2], [in2, in1]];\n      for (const [partial, carry] of orientations) {\n        // The carry has to come from a gate, and this bit needs its own AND gate\n        // on the very same pair of wires.\n        if (circuit.driverOf(carry) < 0) continue;\n        if (circuit.findGate('AND', partial, carry) < 0) continue;\n        const cost = (partial === partialName ? 0 : 1) + (circuit.outputOf(gate) === z ? 0 : 1);\n        candidates.push({ gate, partial, carry, cost });\n      }\n    }\n    candidates.sort((a, b) => a.cost - b.cost);\n    return candidates;\n  }\n\n  private trySumGate(\n    bit: number,\n    previous: CarrySource,\n    partialGate: number,\n    generateGate: number,\n    candidate: { gate: number; partial: string; carry: string },\n    z: string,\n  ): string[] | null {\n    const circuit = this.circuit;\n    // The sum gate reads the partial sum, so that is what the half adder's XOR\n    // gate must be called.\n    if (!circuit.trySwapOutputs(circuit.outputOf(partialGate), candidate.partial)) return null;\n    if (!circuit.trySwapOutputs(circuit.outputOf(candidate.gate), z)) return null;\n\n    const propagateGate = circuit.findGate('AND', candidate.partial, candidate.carry);\n    if (propagateGate < 0) return null;\n\n    // The bit below has to deliver its carry on the wire this bit reads.\n    return this.withCarryNamed(previous, candidate.carry, () =>\n      this.solveBit(bit + 1, { kind: 'ripple', generate: generateGate, propagate: propagateGate }),\n    );\n  }\n\n  /** What the carry gate below is currently called, if it can be identified. */\n  private carryName(source: CarrySource): string | null {\n    const circuit = this.circuit;\n    if (source.kind === 'half') return circuit.outputOf(source.gate);\n    const gate = circuit.findGate('OR', circuit.outputOf(source.generate), circuit.outputOf(source.propagate));\n    return gate < 0 ? null : circuit.outputOf(gate);\n  }\n\n  /**\n   * Run `next` for each way of making the carry gate below come out on `name`,\n   * undoing the swaps in between.\n   */\n  private withCarryNamed(source: CarrySource, name: string, next: () => string[] | null): string[] | null {\n    const circuit = this.circuit;\n    const depth = circuit.depth;\n\n    const attempt = (apply: () => boolean): string[] | null => {\n      const result = apply() ? next() : null;\n      if (!result) circuit.rewind(depth);\n      return result;\n    };\n\n    if (source.kind === 'half') {\n      return attempt(() => circuit.trySwapOutputs(circuit.outputOf(source.gate), name));\n    }\n\n    const generate = circuit.outputOf(source.generate);\n    const propagate = circuit.outputOf(source.propagate);\n\n    // The carry gate is intact and only its output name may be off.\n    const direct = circuit.findGate('OR', generate, propagate);\n    if (direct >= 0) {\n      const result = attempt(() => circuit.trySwapOutputs(circuit.outputOf(direct), name));\n      if (result) return result;\n    }\n\n    // Or the gate already producing `name` is the carry gate, with an input\n    // coming in on the wrong wire.\n    const named = circuit.driverOf(name);\n    if (named < 0 || named === direct || circuit.gates[named].op !== 'OR') return null;\n\n    if (circuit.reads(named, generate)) {\n      return attempt(() => circuit.trySwapOutputs(propagate, circuit.otherInput(named, generate)));\n    }\n    if (circuit.reads(named, propagate)) {\n      return attempt(() => circuit.trySwapOutputs(generate, circuit.otherInput(named, propagate)));\n    }\n    // Both inputs are displaced. An OR is symmetric, so both pairings rebuild\n    // this gate, but they leave different wires elsewhere in the circuit.\n    const { in1, in2 } = circuit.gates[named];\n    for (const [forGenerate, forPropagate] of [\n      [in1, in2],\n      [in2, in1],\n    ]) {\n      const result = attempt(\n        () => circuit.trySwapOutputs(generate, forGenerate) && circuit.trySwapOutputs(propagate, forPropagate),\n      );\n      if (result) return result;\n    }\n    return null;\n  }\n\n  /** Every role is filled: check the rebuilt circuit really adds. */\n  private accept(): string[] | null {\n    const circuit = this.circuit;\n    if (new Set(circuit.swaps).size !== circuit.swaps.length) return null;\n    if (!isCorrectAdder(circuit.gates, this.bits, this.vectors)) return null;\n    if (circuit.swaps.length === SWAP_PAIRS * 2) return [...circuit.swaps];\n    // Fewer than four pairs moved, so one of the swaps has no effect on the sum\n    // and cannot be observed. Remember it, but keep looking for a full answer.\n    this.partial ??= [...circuit.swaps];\n    return null;\n  }\n}\n\nconst sortedWires = (wires: string[]): string[] => [...new Set(wires)].sort();\n\n/**\n * Find the eight output wires that were swapped in pairs, breaking the adder.\n */\nexport function repairAdder(gates: Gate[], bits: number): string[] {\n  const started = Date.now();\n  const quick = new AdderSolver(gates, bits, false, started + 2000).solve();\n  if (quick?.complete) return sortedWires(quick.wires);\n\n  // Nothing fit the usual pattern, so widen the search to every XOR gate as a\n  // possible sum gate. This costs more but is still bounded by the swap budget.\n  const thorough = new AdderSolver(gates, bits, true, started + 4000).solve();\n  if (thorough?.complete) return sortedWires(thorough.wires);\n\n  return sortedWires((thorough ?? quick)?.wires ?? []);\n}\n","structuredPatch":[{"oldStart":273,"oldLines":68,"newStart":273,"newLines":94,"lines":["     );","   }"," ","-  /** What the carry gate below is currently called, if it can be identified. */","-  private carryName(source: CarrySource): string | null {","+  /**","+   * Gates that could be the carry gate of the bit below: the OR gate wired to","+   * both of its feeders, and those wired to just one of them (the other feeder","+   * having been displaced).","+   */","+  private carryGateCandidates(source: CarrySource, wanted?: string): number[] {","     const circuit = this.circuit;","-    if (source.kind === 'half') return circuit.outputOf(source.gate);","-    const gate = circuit.findGate('OR', circuit.outputOf(source.generate), circuit.outputOf(