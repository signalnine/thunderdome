};\n  }\n\n  const seed = Number.isFinite(opts.seed as number) ? (opts.seed as number) : 0x9e3779b9;\n  const maxIterations = Number.isFinite(opts.maxIterations as number)\n    ? Math.max(0, opts.maxIterations as number)\n    : iterationBudget(problem.events.length);\n  const timeLimitMs = Number.isFinite(opts.timeLimitMs as number)\n    ? Math.max(0, opts.timeLimitMs as number)\n    : DEFAULT_TIME_LIMIT_MS;\n\n  const solution = new Solver(problem, seed, maxIterations, timeLimitMs).solve();\n\n  const assignments: Assignment[] = [];\n  const unscheduled: string[] = [];\n  for (const node of problem.events) {\n    const roomIndex = solution.room[node.index];\n    if (roomIndex < 0) {\n      unscheduled.push(node.id);\n      continue;\n    }\n    const startTime = solution.start[node.index];\n    assignments.push({\n      eventId: node.id,\n      roomId: problem.rooms[roomIndex].id,\n      startTime,\n      endTime: startTime + node.duration,\n    });\n  }\n\n  // Present the schedule in chronological order; ties break by room then id so\n  // the output is fully deterministic.\n  const orderOfEvent = new Map<string, number>();\n  problem.events.forEach((node, index) => {\n    if (!orderOfEvent.has(node.id)) orderOfEvent.set(node.id, index);\n  });\n  const roomOrder = new Map<string, number>();\n  problem.rooms.forEach((room, index) => {\n    if (!roomOrder.has(room.id)) roomOrder.set(room.id, index);\n  });\n  assignments.sort((a, b) => {\n    if (a.startTime !== b.startTime) return a.startTime - b.startTime;\n    const roomDelta = (roomOrder.get(a.roomId) ?? 0) - (roomOrder.get(b.roomId) ?? 0);\n    if (roomDelta !== 0) return roomDelta;\n    return (orderOfEvent.get(a.eventId) ?? 0) - (orderOfEvent.get(b.eventId) ?? 0);\n  });\n\n  return { assignments, unscheduled };\n}\n\n/**\n * Object wrapper around {@link schedule}. Rooms and options may be supplied up\n * front and overridden per call:\n *\n * ```ts\n * new Scheduler(rooms, { startTime: 540, endTime: 1020 }).schedule(events);\n * new Scheduler().schedule(events, rooms, options);\n * ```\n */\nexport class Scheduler {\n  private readonly rooms: readonly Room[];\n  private readonly options: Partial<ScheduleOptions>;\n\n  constructor(rooms: readonly Room[] = [], options: Partial<ScheduleOptions> = {}) {\n    this.rooms = rooms ?? [];\n    this.options = options ?? {};\n  }\n\n  schedule(\n    events: readonly Event[],\n    rooms?: readonly Room[],\n    options?: Partial<ScheduleOptions>,\n  ): ScheduleResult {\n    const mergedRooms = rooms && rooms.length > 0 ? rooms : this.rooms;\n    const mergedOptions = { ...this.options, ...(options ?? {}) } as ScheduleOptions;\n    return schedule(events, mergedRooms, mergedOptions);\n  }\n}\n\n/** Factory counterpart to {@link Scheduler}. */\nexport function createScheduler(\n  rooms: readonly Room[] = [],\n  options: Partial<ScheduleOptions> = {},\n): Scheduler {\n  return new Scheduler(rooms, options);\n}\n\nexport default schedule;\n","structuredPatch":[{"oldStart":4,"oldLines":9,"newStart":4,"newLines":13,"lines":[" "," const DEFAULT_TIME_LIMIT_MS = 2000;"," ","+/**","+ * Local-search effort. Scaled inversely with size so the wall-clock cost stays","+ * roughly flat; `timeLimitMs` is the backstop for the largest inputs.","+ */"," function iterationBudget(eventCount: number): number {","   if (eventCount <= 1) return 0;","-  return Math.max(200, Math.min(4000, Math.ceil(60000 / eventCount)));","+  return Math.max(500, Math.min(20000, Math.ceil(400000 / eventCount)));"," }"," "," /**"]}],"userModified":false,"replaceAll":false}}
