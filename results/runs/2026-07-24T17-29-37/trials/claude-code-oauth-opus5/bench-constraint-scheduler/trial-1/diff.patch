+describe('edge cases', () => {
+  it('handles an inverted window', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 30 }];
+    const result = schedule(events, ROOMS, { startTime: 600, endTime: 540 });
+    expect(result.unscheduled).toEqual(['a']);
+  });
+
+  it('handles zero-length events', () => {
+    const options = { startTime: 0, endTime: 0, gap: 0 };
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 0 }];
+    const result = schedule(events, ROOMS, options);
+    validate(events, ROOMS, options, result);
+    expect(result.unscheduled).toEqual([]);
+  });
+
+  it('reports unscheduled ids in input order', () => {
+    const events: Event[] = [
+      { id: 'z', name: 'Z', duration: 30, attendees: 999 },
+      { id: 'm', name: 'M', duration: 30 },
+      { id: 'a', name: 'A', duration: 30, attendees: 999 },
