+
+  it('returns assignments in chronological order', () => {
+    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30 },
+      { id: 'b', name: 'B', duration: 30 },
+      { id: 'c', name: 'C', duration: 30 },
