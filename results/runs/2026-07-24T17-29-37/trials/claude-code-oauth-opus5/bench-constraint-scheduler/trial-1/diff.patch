@@ -0,0 +1,288 @@
+import { PrerequisiteCycleError } from './errors.js';
+import type { Event, Room, ScheduleOptions } from './types.js';
+
+export const DEFAULT_GAP = 15;
+
+export interface EventNode {
+  index: number;
+  id: string;
+  duration: number;
+  attendees: number;
+  /** Indices of prerequisite events (unresolvable ids are dropped). */
+  prereqs: number[];
+  /** Indices of events that depend on this one. */
+  successors: number[];
+  /** Index of the preferred room, or -1. */
+  preferredRoom: number;
+  /** Earliest start allowed by the window + prerequisite chain. */
+  est: number;
+  /** Latest finish allowed by the window + dependent chain. */
+  lft: number;
+  /** Longest remaining chain (duration + gaps) starting at this event. */
+  criticalPath: number;
+  /** Number of transitive dependents. */
+  descendants: number;
+  /** False when no valid placement can exist regardless of other events. */
+  feasible: boolean;
+}
+
+export interface RoomNode {
+  index: number;
+  id: string;
+  capacity: number;
+}
+
+export interface Problem {
+  events: EventNode[];
+  rooms: RoomNode[];
+  windowStart: number;
+  windowEnd: number;
+  gap: number;
+  /** A topological order over all events. */
+  topo: number[];
+  /** Largest capacity offered by any room. */
+  maxCapacity: number;
+  /** Number of events that are individually placeable — the optimum's ceiling. */
+  maxPossible: number;
+  /** How many feasible events express a room preference. */
+  maxPreferred: number;
+}
+
+function toFiniteNumber(value: unknown, fallback: number): number {
+  return typeof value === 'number' && Number.isFinite(value) ? value : fallback;
+}
+
+/**
+ * Detects a cycle in the prerequisite graph using an iterative coloured DFS.
+ * Returns the cycle as a list of event ids, or null when the graph is a DAG.
+ */
+function findCycle(prereqs: number[][], ids: string[]): string[] | null {
+  const n = prereqs.length;
+  const WHITE = 0;
+  const GREY = 1;
+  const BLACK = 2;
+  const color = new Uint8Array(n);
+  const parent = new Int32Array(n).fill(-1);
+
+  for (let root = 0; root < n; root++) {
+    if (color[root] !== WHITE) continue;
+    // Stack frames hold (node, next prerequisite to visit).
+    const stack: number[][] = [[root, 0]];
+    color[root] = GREY;
+
+    while (stack.length > 0) {
+      const frame = stack[stack.length - 1];
+      const node = frame[0];
+      const list = prereqs[node];
+
+      if (frame[1] < list.length) {
+        const next = list[frame[1]++];
+        if (color[next] === GREY) {
+          // Walk back up the DFS tree to materialise the cycle.
+          const cycle: string[] = [ids[next]];
+          for (let cur = node; cur !== -1 && cur !== next; cur = parent[cur]) {
+            cycle.push(ids[cur]);
+          }
+          cycle.push(ids[next]);
+          return cycle.reverse();
+        }
+        if (color[next] === WHITE) {
+          color[next] = GREY;
+          parent[next] = node;
+          stack.push([next, 0]);
+        }
+      } else {
+        color[node] = BLACK;
+        stack.pop();
+      }
+    }
+  }
+  return null;
+}
+
+/** Kahn's algorithm over the prerequisite edges. The graph is known acyclic. */
+function topologicalOrder(prereqs: number[][], successors: number[][]): number[] {
+  const n = prereqs.length;
+  const indegree = new Int32Array(n);
+  const ready: number[] = [];
+  for (let i = 0; i < n; i++) {
+    indegree[i] = prereqs[i].length;
+    if (indegree[i] === 0) ready.push(i);
+  }
+
+  const order: number[] = [];
+  for (let head = 0; head < ready.length; head++) {
+    const node = ready[head];
+    order.push(node);
+    for (const succ of successors[node]) {
+      if (--indegree[succ] === 0) ready.push(succ);
+    }
+  }
+  return order;
+}
+
+/**
+ * Validates and normalises raw input into the internal solver representation.
+ * Throws {@link PrerequisiteCycleError} when prerequisites contain a cycle.
+ */
+export function buildProblem(
+  rawEvents: readonly Event[],
+  rawRooms: readonly Room[],
+  options: ScheduleOptions,
+): Problem {
+  const events = Array.isArray(rawEvents) ? rawEvents : [];
+  const roomList = Array.isArray(rawRooms) ? rawRooms : [];
+
+  const windowStart = toFiniteNumber(options?.startTime, 0);
+  const windowEnd = toFiniteNumber(options?.endTime, 0);
+  const gap = Math.max(0, toFiniteNumber(options?.gap, DEFAULT_GAP));
+
+  const rooms: RoomNode[] = roomList.map((room, index) => ({
+    index,
+    id: String(room?.id ?? index),
+    capacity: toFiniteNumber(room?.capacity, 0),
+  }));
+
+  const roomIndexById = new Map<string, number>();
+  for (const room of rooms) {
+    if (!roomIndexById.has(room.id)) roomIndexById.set(room.id, room.index);
+  }
+  let maxCapacity = -Infinity;
+  for (const room of rooms) maxCapacity = Math.max(maxCapacity, room.capacity);
+
+  const ids = events.map((event, index) => String(event?.id ?? index));
+  const eventIndexById = new Map<string, number>();
+  for (let i = 0; i < ids.length; i++) {
+    if (!eventIndexById.has(ids[i])) eventIndexById.set(ids[i], i);
+  }
+
+  // Resolve prerequisite ids to indices. Unknown ids are ignored rather than
+  // fatal: they express no ordering we can enforce or violate.
+  const prereqs: number[][] = events.map((event) => {
+    const raw = event?.prerequisites;
+    if (!Array.isArray(raw) || raw.length === 0) return [];
+    const resolved: number[] = [];
+    const seen = new Set<number>();
+    for (const dep of raw) {
+      const depIndex = eventIndexById.get(String(dep));
+      if (depIndex === undefined || seen.has(depIndex)) continue;
+      // A self-edge is a cycle of length one; keep it so detection can report it.
+      seen.add(depIndex);
+      resolved.push(depIndex);
+    }
+    return resolved;
+  });
+
+  const cycle = findCycle(prereqs, ids);
+  if (cycle) throw new PrerequisiteCycleError(cycle);
+
+  const successors: number[][] = events.map(() => []);
+  for (let i = 0; i < prereqs.length; i++) {
+    for (const dep of prereqs[i]) successors[dep].push(i);
+  }
+
+  const topo = topologicalOrder(prereqs, successors);
+
+  const nodes: EventNode[] = events.map((event, index) => {
+    const rawDuration = toFiniteNumber(event?.duration, NaN);
+    const rawAttendees = event?.attendees === undefined || event?.attendees === null
+      ? 1
+      : toFiniteNumber(event.attendees, 1);
+    const preferred = event?.preferredRoom === undefined || event?.preferredRoom === null
+      ? -1
+      : roomIndexById.get(String(event.preferredRoom)) ?? -1;
+    return {
+      index,
+      id: ids[index],
+      duration: rawDuration,
+      attendees: Math.max(0, rawAttendees),
+      prereqs: prereqs[index],
+      successors: successors[index],
+      preferredRoom: preferred,
+      est: windowStart,
+      lft: windowEnd,
+      criticalPath: 0,
+      descendants: 0,
+      feasible: true,
+    };
+  });
+
+  // Forward pass: earliest start implied by the prerequisite chain.
+  for (const i of topo) {
+    const node = nodes[i];
+    let est = windowStart;
+    for (const dep of node.prereqs) {
+      const depNode = nodes[dep];
+      const depDuration = Number.isFinite(depNode.duration) ? Math.max(0, depNode.duration) : 0;
+      est = Math.max(est, depNode.est + depDuration + gap);
+    }
+    node.est = est;
+  }
+
+  // Backward pass: latest finish implied by dependents, plus chain metrics.
+  for (let k = topo.length - 1; k >= 0; k--) {
+    const node = nodes[topo[k]];
+    const duration = Number.isFinite(node.duration) ? Math.max(0, node.duration) : 0;
+    let lft = windowEnd;
+    let chain = 0;
+    let descendants = 0;
+    for (const succ of node.successors) {
+      const succNode = nodes[succ];
+      const succDuration = Number.isFinite(succNode.duration) ? Math.max(0, succNode.duration) : 0;
+      lft = Math.min(lft, succNode.lft - succDuration - gap);
+      chain = Math.max(chain, succNode.criticalPath + gap);
+      descendants += succNode.descendants + 1;
+    }
+    node.lft = lft;
+    node.criticalPath = duration + chain;
+    node.descendants = descendants;
+  }
+
+  // Static feasibility, then propagate: an event whose prerequisite can never
+  // run can never run either.
+  for (const i of topo) {
+    const node = nodes[i];
+    const durationOk = Number.isFinite(node.duration) && node.duration >= 0;
+    // Note: `lft` deliberately plays no part here. It is derived assuming every
+    // dependent gets scheduled, but dependents are droppable — an event that
+    // leaves no room for its successors is still perfectly schedulable itself.
+    let ok =
+      durationOk &&
+      rooms.length > 0 &&
+      node.attendees <= maxCapacity &&
+      node.est + node.duration <= windowEnd;
+    if (ok) {
+      // At least one room must actually be able to hold the attendees.
+      ok = rooms.some((room) => node.attendees <= room.capacity);
+    }
+    if (ok) {
+      for (const dep of node.prereqs) {
+        if (!nodes[dep].feasible) {
+          ok = false;
+          break;
+        }
+      }
+    }
+    node.feasible = ok;
+  }
+
+  let maxPossible = 0;
+  let maxPreferred = 0;
+  for (const node of nodes) {
+    if (!node.feasible) continue;
+    maxPossible++;
+    if (node.preferredRoom >= 0) maxPreferred++;
+  }
+
+  return {
+    events: nodes,
+    rooms,
+    windowStart,
+    windowEnd,
+    gap,
+    topo,
+    maxCapacity: rooms.length > 0 ? maxCapacity : 0,
+    maxPossible,
+    maxPreferred,
+  };
+}
diff --git a/src/scheduler.ts b/src/scheduler.ts
new file mode 100644
index 0000000..eb6c8e6
--- /dev/null
+++ b/src/scheduler.ts
@@ -0,0 +1,118 @@
+import { buildProblem } from './problem.js';
+import { Solver } from './solver.js';
+import type { Assignment, Event, Room, ScheduleOptions, ScheduleResult } from './types.js';
+
+const DEFAULT_TIME_LIMIT_MS = 2000;
+
+/**
+ * Local-search effort. Scaled inversely with size so the wall-clock cost stays
+ * roughly flat; `timeLimitMs` is the backstop for the largest inputs.
+ */
+function iterationBudget(eventCount: number): number {
+  if (eventCount <= 1) return 0;
+  return Math.max(500, Math.min(20000, Math.ceil(400000 / eventCount)));
+}
+
+/**
+ * Assigns events to rooms inside `[startTime, endTime]`, maximising the number
+ * of events scheduled while respecting capacity, gap and prerequisite rules.
+ *
+ * @throws {PrerequisiteCycleError} when prerequisites contain a cycle.
+ */
+export function schedule(
+  events: readonly Event[],
+  rooms: readonly Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const opts = (options ?? {}) as ScheduleOptions;
+  const problem = buildProblem(events ?? [], rooms ?? [], opts);
+
+  if (problem.events.length === 0) {
+    return { assignments: [], unscheduled: [] };
+  }
+
+  const seed = Number.isFinite(opts.seed as number) ? (opts.seed as number) : 0x9e3779b9;
+  const maxIterations = Number.isFinite(opts.maxIterations as number)
+    ? Math.max(0, opts.maxIterations as number)
+    : iterationBudget(problem.events.length);
+  const timeLimitMs = Number.isFinite(opts.timeLimitMs as number)
+    ? Math.max(0, opts.timeLimitMs as number)
+    : DEFAULT_TIME_LIMIT_MS;
+
+  const solution = new Solver(problem, seed, maxIterations, timeLimitMs).solve();
+
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+  for (const node of problem.events) {
+    const roomIndex = solution.room[node.index];
+    if (roomIndex < 0) {
+      unscheduled.push(node.id);
+      continue;
+    }
+    const startTime = solution.start[node.index];
+    assignments.push({
+      eventId: node.id,
+      roomId: problem.rooms[roomIndex].id,
+      startTime,
+      endTime: startTime + node.duration,
+    });
+  }
+
+  // Present the schedule in chronological order; ties break by room then id so
+  // the output is fully deterministic.
+  const orderOfEvent = new Map<string, number>();
+  problem.events.forEach((node, index) => {
+    if (!orderOfEvent.has(node.id)) orderOfEvent.set(node.id, index);
+  });
+  const roomOrder = new Map<string, number>();
+  problem.rooms.forEach((room, index) => {
+    if (!roomOrder.has(room.id)) roomOrder.set(room.id, index);
+  });
+  assignments.sort((a, b) => {
+    if (a.startTime !== b.startTime) return a.startTime - b.startTime;
+    const roomDelta = (roomOrder.get(a.roomId) ?? 0) - (roomOrder.get(b.roomId) ?? 0);
+    if (roomDelta !== 0) return roomDelta;
+    return (orderOfEvent.get(a.eventId) ?? 0) - (orderOfEvent.get(b.eventId) ?? 0);
+  });
+
+  return { assignments, unscheduled };
+}
+
+/**
+ * Object wrapper around {@link schedule}. Rooms and options may be supplied up
+ * front and overridden per call:
+ *
+ * ```ts
+ * new Scheduler(rooms, { startTime: 540, endTime: 1020 }).schedule(events);
+ * new Scheduler().schedule(events, rooms, options);
+ * ```
+ */
+export class Scheduler {
+  private readonly rooms: readonly Room[];
+  private readonly options: Partial<ScheduleOptions>;
+
+  constructor(rooms: readonly Room[] = [], options: Partial<ScheduleOptions> = {}) {
+    this.rooms = rooms ?? [];
+    this.options = options ?? {};
+  }
+
+  schedule(
+    events: readonly Event[],
+    rooms?: readonly Room[],
+    options?: Partial<ScheduleOptions>,
+  ): ScheduleResult {
+    const mergedRooms = rooms && rooms.length > 0 ? rooms : this.rooms;
+    const mergedOptions = { ...this.options, ...(options ?? {}) } as ScheduleOptions;
+    return schedule(events, mergedRooms, mergedOptions);
+  }
+}
+
+/** Factory counterpart to {@link Scheduler}. */
+export function createScheduler(
+  rooms: readonly Room[] = [],
+  options: Partial<ScheduleOptions> = {},
+): Scheduler {
+  return new Scheduler(rooms, options);
+}
+
+export default schedule;
diff --git a/src/solver.ts b/src/solver.ts
new file mode 100644
index 0000000..bbd9ebc
--- /dev/null
+++ b/src/solver.ts
@@ -0,0 +1,546 @@
+import type { EventNode, Problem } from './problem.js';
+
+/** A placed event occupying `[start, end]` in one room. */
+interface Booking {
+  start: number;
+  end: number;
+}
+
+export interface Solution {
+  /** Room index per event, or -1 when unscheduled. */
+  room: number[];
+  /** Start time per event, or -1 when unscheduled. */
+  start: number[];
+  /** Number of scheduled events (primary objective). */
+  count: number;
+  /** Scheduled events placed in their preferred room (secondary objective). */
+  preferred: number;
+  /** Sum of end times; lower is a more compact schedule (tie-breaker). */
+  compactness: number;
+}
+
+type RoomMode = 'earliest' | 'bestFit' | 'worstFit' | 'random';
+
+interface Policy {
+  mode: RoomMode;
+  /** Take the preferred room whenever it admits any valid placement. */
+  honorPreferred: boolean;
+}
+
+const POLICIES: Policy[] = [
+  { mode: 'earliest', honorPreferred: true },
+  { mode: 'bestFit', honorPreferred: true },
+  { mode: 'worstFit', honorPreferred: true },
+  { mode: 'earliest', honorPreferred: false },
+  { mode: 'bestFit', honorPreferred: false },
+  { mode: 'worstFit', honorPreferred: false },
+  { mode: 'random', honorPreferred: true },
+  { mode: 'random', honorPreferred: false },
+];
+
+/** Deterministic PRNG so identical inputs always produce identical schedules. */
+function mulberry32(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+/**
+ * Earliest start >= `from` at which a `duration`-long booking fits into an
+ * already sorted room timeline while respecting `gap` on both sides.
+ * Returns -1 when it cannot fit before `limit`.
+ */
+function earliestStart(
+  timeline: Booking[],
+  from: number,
+  duration: number,
+  gap: number,
+  limit: number,
+): number {
+  let start = from;
+  for (let i = 0; i < timeline.length; i++) {
+    const booking = timeline[i];
+    // Timeline is sorted by start, so once we fit before this booking we fit
+    // before every later one too.
+    if (start + duration + gap <= booking.start) break;
+    if (booking.end + gap > start) start = booking.end + gap;
+  }
+  return start + duration <= limit ? start : -1;
+}
+
+function insertBooking(timeline: Booking[], booking: Booking): void {
+  let lo = 0;
+  let hi = timeline.length;
+  while (lo < hi) {
+    const mid = (lo + hi) >>> 1;
+    if (timeline[mid].start < booking.start) lo = mid + 1;
+    else hi = mid;
+  }
+  timeline.splice(lo, 0, booking);
+}
+
+/** Lexicographic comparison: more events, then more preferences, then tighter. */
+function isBetter(candidate: Solution, incumbent: Solution | null): boolean {
+  if (!incumbent) return true;
+  if (candidate.count !== incumbent.count) return candidate.count > incumbent.count;
+  if (candidate.preferred !== incumbent.preferred) {
+    return candidate.preferred > incumbent.preferred;
+  }
+  return candidate.compactness < incumbent.compactness;
+}
+
+function isNoWorse(candidate: Solution, incumbent: Solution): boolean {
+  if (candidate.count !== incumbent.count) return candidate.count > incumbent.count;
+  if (candidate.preferred !== incumbent.preferred) {
+    return candidate.preferred >= incumbent.preferred;
+  }
+  return candidate.compactness <= incumbent.compactness;
+}
+
+/** Priority keys used to seed the many topological orders we try. */
+const STRATEGY_COUNT = 11;
+
+function strategyKey(node: EventNode, strategy: number): number {
+  switch (strategy) {
+    case 0:
+      return node.est;
+    case 1:
+      return -node.duration;
+    case 2:
+      return node.duration;
+    case 3:
+      return -node.attendees;
+    case 4:
+      return node.attendees;
+    case 5:
+      return -node.criticalPath;
+    case 6:
+      return node.lft - node.est - node.duration; // slack
+    case 7:
+      return -node.descendants;
+    case 8:
+      return node.lft;
+    case 9:
+      return node.est * 4 - node.duration;
+    default:
+      return node.index;
+  }
+}
+
+/**
+ * Multi-start constructive search with a ruin-and-recreate improvement phase.
+ *
+ * Every candidate schedule is built by walking a *topological* order of the
+ * events and left-shifting each one into a room. Left-shifted (semi-active)
+ * schedules are sufficient here: since all events share one deadline, sliding a
+ * placement earlier never invalidates another placement, so some optimum is
+ * always reachable this way. That reduces the search to "which order, which
+ * room", which is what the restarts and the local search explore.
+ */
+export class Solver {
+  private readonly problem: Problem;
+  private readonly random: () => number;
+  private readonly deadline: number;
+  private readonly maxIterations: number;
+  /** Scratch buffers reused across constructions to avoid GC churn. */
+  private readonly indegree: Int32Array;
+  private readonly heap: number[] = [];
+  private readonly heapKey: Float64Array;
+
+  constructor(problem: Problem, seed: number, maxIterations: number, timeLimitMs: number) {
+    this.problem = problem;
+    this.random = mulberry32(seed);
+    this.maxIterations = maxIterations;
+    this.deadline = Date.now() + timeLimitMs;
+    this.indegree = new Int32Array(problem.events.length);
+    this.heapKey = new Float64Array(problem.events.length);
+  }
+
+  solve(): Solution {
+    const { events, maxPossible, maxPreferred } = this.problem;
+    let best: Solution | null = null;
+
+    if (events.length === 0 || maxPossible === 0) {
+      return this.emptySolution();
+    }
+
+    // Phase 1 — systematic sweep: every priority strategy against every room
+    // selection policy.
+    let sweep = 0;
+    outer: for (let strategy = 0; strategy < STRATEGY_COUNT; strategy++) {
+      const order = this.topoOrder(null, strategy, 0);
+      for (const policy of POLICIES) {
+        const candidate = this.construct(order, policy, null, null);
+        if (isBetter(candidate, best)) best = candidate;
+        if (this.isOptimal(best, maxPossible, maxPreferred)) return best as Solution;
+        // Always finish at least one construction before honouring the clock.
+        if (best !== null && this.outOfTime(++sweep)) break outer;
+      }
+    }
+
+    // Phase 2 — randomised restarts around the same strategies.
+    const restarts = Math.max(24, Math.min(400, Math.ceil(6000 / events.length)));
+    for (let i = 0; i < restarts; i++) {
+      if (this.outOfTime(i)) break;
+      const strategy = Math.floor(this.random() * (STRATEGY_COUNT + 1));
+      const noise = 0.15 + this.random() * 2;
+      const order = this.topoOrder(null, strategy, noise);
+      const policy = POLICIES[Math.floor(this.random() * POLICIES.length)];
+      const candidate = this.construct(order, policy, null, null);
+      if (isBetter(candidate, best)) best = candidate;
+      if (this.isOptimal(best, maxPossible, maxPreferred)) return best as Solution;
+    }
+
+    // Phase 3 — ruin & recreate: repeatedly tear a slice out of the incumbent
+    // and rebuild it differently. This is what lets a placement be undone when
+    // it blocks two other events.
+    let current = this.clone(best as Solution);
+    for (let i = 0; i < this.maxIterations; i++) {
+      if (this.outOfTime(i)) break;
+      const candidate = this.perturb(current);
+      if (isBetter(candidate, best)) best = candidate;
+      if (this.isOptimal(best, maxPossible, maxPreferred)) return best as Solution;
+      if (isNoWorse(candidate, current)) current = candidate;
+      else if (this.random() < 0.05) current = this.clone(best as Solution);
+    }
+
+    return best as Solution;
+  }
+
+  private isOptimal(
+    best: Solution | null,
+    maxPossible: number,
+    maxPreferred: number,
+  ): boolean {
+    return best !== null && best.count === maxPossible && best.preferred === maxPreferred;
+  }
+
+  private outOfTime(iteration: number): boolean {
+    return (iteration & 15) === 0 && Date.now() > this.deadline;
+  }
+
+  private emptySolution(): Solution {
+    const n = this.problem.events.length;
+    return {
+      room: new Array<number>(n).fill(-1),
+      start: new Array<number>(n).fill(-1),
+      count: 0,
+      preferred: 0,
+      compactness: 0,
+    };
+  }
+
+  private clone(solution: Solution): Solution {
+    return {
+      room: solution.room.slice(),
+      start: solution.start.slice(),
+      count: solution.count,
+      preferred: solution.preferred,
+      compactness: solution.compactness,
+    };
+  }
+
+  /**
+   * Builds a topological order. `subset` (when given) restricts the order to
+   * those events; `noise` randomises the priority key to diversify restarts.
+   */
+  private topoOrder(subset: boolean[] | null, strategy: number, noise: number): number[] {
+    const { events } = this.problem;
+    const n = events.length;
+    const indegree = this.indegree;
+    const key = this.heapKey;
+    const heap = this.heap;
+    heap.length = 0;
+
+    let spread = 1;
+    if (noise > 0) {
+      let lo = Infinity;
+      let hi = -Infinity;
+      for (let i = 0; i < n; i++) {
+        if (subset && !subset[i]) continue;
+        const k = strategyKey(events[i], strategy);
+        if (k < lo) lo = k;
+        if (k > hi) hi = k;
+      }
+      spread = hi > lo ? hi - lo : 1;
+    }
+
+    for (let i = 0; i < n; i++) {
+      if (subset && !subset[i]) {
+        indegree[i] = -1;
+        continue;
+      }
+      let degree = 0;
+      for (const dep of events[i].prereqs) {
+        if (!subset || subset[dep]) degree++;
+      }
+      indegree[i] = degree;
+      key[i] = strategyKey(events[i], strategy) + (noise > 0 ? this.random() * noise * spread : 0);
+      if (degree === 0) this.heapPush(i);
+    }
+
+    const order: number[] = [];
+    while (heap.length > 0) {
+      const node = this.heapPop();
+      order.push(node);
+      for (const succ of events[node].successors) {
+        if (indegree[succ] < 0) continue;
+        if (--indegree[succ] === 0) this.heapPush(succ);
+      }
+    }
+    return order;
+  }
+
+  private heapPush(node: number): void {
+    const heap = this.heap;
+    const key = this.heapKey;
+    heap.push(node);
+    let child = heap.length - 1;
+    while (child > 0) {
+      const parent = (child - 1) >>> 1;
+      if (key[heap[parent]] <= key[heap[child]]) break;
+      const tmp = heap[parent];
+      heap[parent] = heap[child];
+      heap[child] = tmp;
+      child = parent;
+    }
+  }
+
+  private heapPop(): number {
+    const heap = this.heap;
+    const key = this.heapKey;
+    const top = heap[0];
+    const last = heap.pop() as number;
+    if (heap.length > 0) {
+      heap[0] = last;
+      let parent = 0;
+      for (;;) {
+        const left = parent * 2 + 1;
+        const right = left + 1;
+        let smallest = parent;
+        if (left < heap.length && key[heap[left]] < key[heap[smallest]]) smallest = left;
+        if (right < heap.length && key[heap[right]] < key[heap[smallest]]) smallest = right;
+        if (smallest === parent) break;
+        const tmp = heap[parent];
+        heap[parent] = heap[smallest];
+        heap[smallest] = tmp;
+        parent = smallest;
+      }
+    }
+    return top;
+  }
+
+  /**
+   * Greedily places every event of `order` into the schedule, optionally on top
+   * of the placements of `base` marked by `keep`.
+   */
+  private construct(
+    order: readonly number[],
+    policy: Policy,
+    base: Solution | null,
+    keep: boolean[] | null,
+  ): Solution {
+    const { events, rooms, gap, windowStart, windowEnd } = this.problem;
+    const n = events.length;
+    const room = new Array<number>(n).fill(-1);
+    const start = new Array<number>(n).fill(-1);
+    const timelines: Booking[][] = rooms.map(() => []);
+    let count = 0;
+    let preferred = 0;
+    let compactness = 0;
+
+    if (base && keep) {
+      for (let i = 0; i < n; i++) {
+        if (!keep[i] || base.room[i] < 0) continue;
+        const node = events[i];
+        room[i] = base.room[i];
+        start[i] = base.start[i];
+        insertBooking(timelines[room[i]], { start: start[i], end: start[i] + node.duration });
+        count++;
+        if (node.preferredRoom === room[i]) preferred++;
+        compactness += start[i] + node.duration;
+      }
+    }
+
+    for (const index of order) {
+      const node = events[index];
+      if (!node.feasible || room[index] >= 0) continue;
+
+      // Prerequisites must already be placed; otherwise this event cannot run.
+      let release = Math.max(windowStart, node.est);
+      let blocked = false;
+      for (const dep of node.prereqs) {
+        if (room[dep] < 0) {
+          blocked = true;
+          break;
+        }
+        const depEnd = start[dep] + events[dep].duration;
+        if (depEnd + gap > release) release = depEnd + gap;
+      }
+      if (blocked) continue;
+
+      const chosen = this.chooseRoom(node, release, policy, timelines);
+      if (chosen < 0) continue;
+
+      const at = earliestStart(timelines[chosen], release, node.duration, gap, windowEnd);
+      room[index] = chosen;
+      start[index] = at;
+      insertBooking(timelines[chosen], { start: at, end: at + node.duration });
+      count++;
+      if (node.preferredRoom === chosen) preferred++;
+      compactness += at + node.duration;
+    }
+
+    return { room, start, count, preferred, compactness };
+  }
+
+  /** Picks the room for `node` according to `policy`, or -1 if none fits. */
+  private chooseRoom(
+    node: EventNode,
+    release: number,
+    policy: Policy,
+    timelines: Booking[][],
+  ): number {
+    const { rooms, gap, windowEnd } = this.problem;
+
+    if (policy.honorPreferred && node.preferredRoom >= 0) {
+      const room = rooms[node.preferredRoom];
+      if (
+        node.attendees <= room.capacity &&
+        earliestStart(timelines[room.index], release, node.duration, gap, windowEnd) >= 0
+      ) {
+        return room.index;
+      }
+    }
+
+    let best = -1;
+    let bestStart = 0;
+    let bestCapacity = 0;
+    let viable = 0;
+
+    for (const room of rooms) {
+      if (node.attendees > room.capacity) continue;
+      const at = earliestStart(timelines[room.index], release, node.duration, gap, windowEnd);
+      if (at < 0) continue;
+      viable++;
+
+      if (best < 0) {
+        best = room.index;
+        bestStart = at;
+        bestCapacity = room.capacity;
+        continue;
+      }
+
+      let take = false;
+      switch (policy.mode) {
+        case 'earliest':
+          // Start as early as possible; among ties keep the roomiest rooms free.
+          take = at < bestStart || (at === bestStart && room.capacity < bestCapacity);
+          break;
+        case 'bestFit':
+          // Tightest room that fits, so large rooms stay available for large events.
+          take =
+            room.capacity < bestCapacity ||
+            (room.capacity === bestCapacity && at < bestStart);
+          break;
+        case 'worstFit':
+          take =
+            room.capacity > bestCapacity ||
+            (room.capacity === bestCapacity && at < bestStart);
+          break;
+        case 'random':
+          take = this.random() < 1 / viable;
+          break;
+      }
+      if (take) {
+        best = room.index;
+        bestStart = at;
+        bestCapacity = room.capacity;
+      }
+    }
+
+    // Prefer the hinted room when it is no worse than what we picked. Skipped
+    // when `honorPreferred` already had its chance above and declined.
+    if (!policy.honorPreferred && best >= 0 && node.preferredRoom >= 0) {
+      const room = rooms[node.preferredRoom];
+      if (node.attendees <= room.capacity) {
+        const at = earliestStart(timelines[room.index], release, node.duration, gap, windowEnd);
+        if (at >= 0 && at <= bestStart) return room.index;
+      }
+    }
+    return best;
+  }
+
+  /** One ruin-and-recreate step against `solution`. */
+  private perturb(solution: Solution): Solution {
+    const { events } = this.problem;
+    const n = events.length;
+    const removed = new Array<boolean>(n).fill(false);
+    const scheduled: number[] = [];
+    for (let i = 0; i < n; i++) if (solution.room[i] >= 0) scheduled.push(i);
+
+    if (scheduled.length === 0) {
+      const order = this.topoOrder(null, Math.floor(this.random() * STRATEGY_COUNT), 1);
+      return this.construct(order, POLICIES[Math.floor(this.random() * POLICIES.length)], null, null);
+    }
+
+    const size = 1 + Math.floor(this.random() * Math.max(1, Math.ceil(scheduled.length * 0.35)));
+    const scheme = this.random();
+
+    if (scheme < 0.4) {
+      // Random slice of placements.
+      for (let i = 0; i < size; i++) {
+        removed[scheduled[Math.floor(this.random() * scheduled.length)]] = true;
+      }
+    } else if (scheme < 0.7) {
+      // Everything a room holds after a random point — frees a contiguous block.
+      const seed = scheduled[Math.floor(this.random() * scheduled.length)];
+      const room = solution.room[seed];
+      const from = solution.start[seed];
+      for (const i of scheduled) {
+        if (solution.room[i] === room && solution.start[i] >= from) removed[i] = true;
+      }
+      removed[seed] = true;
+    } else {
+      // Everything overlapping a random time window, across all rooms. This is
+      // the move that clears space for a long event blocked by short ones.
+      const seed = scheduled[Math.floor(this.random() * scheduled.length)];
+      const centre = solution.start[seed];
+      const radius = 30 + this.random() * 240;
+      for (const i of scheduled) {
+        const end = solution.start[i] + events[i].duration;
+        if (end >= centre - radius && solution.start[i] <= centre + radius) removed[i] = true;
+      }
+    }
+
+    // Removing an event forces removing everything downstream of it, since
+    // those placements were justified by the prerequisite's timing.
+    const stack: number[] = [];
+    for (let i = 0; i < n; i++) if (removed[i]) stack.push(i);
+    while (stack.length > 0) {
+      const node = stack.pop() as number;
+      for (const succ of events[node].successors) {
+        if (!removed[succ]) {
+          removed[succ] = true;
+          stack.push(succ);
+        }
+      }
+    }
+
+    const keep = new Array<boolean>(n);
+    const free = new Array<boolean>(n);
+    for (let i = 0; i < n; i++) {
+      keep[i] = solution.room[i] >= 0 && !removed[i];
+      free[i] = !keep[i];
+    }
+
+    const strategy = Math.floor(this.random() * (STRATEGY_COUNT + 1));
+    const order = this.topoOrder(free, strategy, 0.2 + this.random() * 2);
+    const policy = POLICIES[Math.floor(this.random() * POLICIES.length)];
+    return this.construct(order, policy, solution, keep);
+  }
+}
