@@ -0,0 +1,533 @@
+import { describe, expect, it } from 'vitest';
+import schedulerDefault, {
+  createScheduler,
+  schedule,
+  Scheduler,
+  type Event,
+  type Room,
+  type ScheduleOptions,
+} from '../src/index.js';
+import { bruteForceMax, rng, validate } from './helpers.js';
+
+const ROOMS: Room[] = [
+  { id: 'r1', name: 'Small', capacity: 5 },
+  { id: 'r2', name: 'Large', capacity: 50 },
+];
+
+const DAY: ScheduleOptions = { startTime: 540, endTime: 1020 };
+
+function ids(result: { assignments: { eventId: string }[] }): string[] {
+  return result.assignments.map((a) => a.eventId).sort();
+}
+
+describe('API surface', () => {
+  it('exposes a named export, a default export, a class and a factory', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 60 }];
+    const expected = schedule(events, ROOMS, DAY);
+
+    expect(schedulerDefault(events, ROOMS, DAY)).toEqual(expected);
+    expect(new Scheduler().schedule(events, ROOMS, DAY)).toEqual(expected);
+    expect(new Scheduler(ROOMS, DAY).schedule(events)).toEqual(expected);
+    expect(createScheduler(ROOMS, DAY).schedule(events)).toEqual(expected);
+  });
+
+  it('handles empty input', () => {
+    expect(schedule([], ROOMS, DAY)).toEqual({ assignments: [], unscheduled: [] });
+    expect(schedule([{ id: 'a', name: 'A', duration: 30 }], [], DAY)).toEqual({
+      assignments: [],
+      unscheduled: ['a'],
+    });
+  });
+
+  it('does not mutate its inputs', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60, prerequisites: [] },
+      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },
+    ];
+    const snapshot = JSON.parse(JSON.stringify(events));
+    const rooms = JSON.parse(JSON.stringify(ROOMS));
+    schedule(events, rooms, { ...DAY });
+    expect(events).toEqual(snapshot);
+    expect(rooms).toEqual(ROOMS);
+  });
+
+  it('is deterministic across runs', () => {
+    const events: Event[] = Array.from({ length: 12 }, (_, i) => ({
+      id: `e${i}`,
+      name: `E${i}`,
+      duration: 30 + (i % 4) * 30,
+      attendees: 1 + (i % 7),
+    }));
+    const first = schedule(events, ROOMS, DAY);
+    for (let i = 0; i < 3; i++) {
+      expect(schedule(events, ROOMS, DAY)).toEqual(first);
+    }
+  });
+});
+
+describe('basic placement', () => {
+  it('places a single event at the start of the window', () => {
+    const result = schedule([{ id: 'a', name: 'A', duration: 60 }], ROOMS, DAY);
+    expect(result.unscheduled).toEqual([]);
+    expect(result.assignments).toHaveLength(1);
+    expect(result.assignments[0].startTime).toBe(540);
+    expect(result.assignments[0].endTime).toBe(600);
+  });
+
+  it('keeps every event inside the time window', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 120 },
+      { id: 'b', name: 'B', duration: 120 },
+      { id: 'c', name: 'C', duration: 120 },
+    ];
+    const options = { startTime: 600, endTime: 780 };
+    const result = schedule(events, ROOMS, options);
+    validate(events, ROOMS, options, result);
+    for (const a of result.assignments) {
+      expect(a.startTime).toBeGreaterThanOrEqual(600);
+      expect(a.endTime).toBeLessThanOrEqual(780);
+    }
+  });
+
+  it('reports events longer than the window as unscheduled', () => {
+    const events: Event[] = [
+      { id: 'ok', name: 'OK', duration: 60 },
+      { id: 'huge', name: 'Huge', duration: 10_000 },
+    ];
+    const result = schedule(events, ROOMS, DAY);
+    expect(result.unscheduled).toEqual(['huge']);
+    expect(ids(result)).toEqual(['ok']);
+  });
+});
+
+describe('room capacity', () => {
+  it('never exceeds capacity', () => {
+    const events: Event[] = [
+      { id: 'big', name: 'Big', duration: 60, attendees: 40 },
+      { id: 'small', name: 'Small', duration: 60, attendees: 3 },
+    ];
+    const result = schedule(events, ROOMS, DAY);
+    validate(events, ROOMS, DAY, result);
+    expect(result.assignments.find((a) => a.eventId === 'big')?.roomId).toBe('r2');
+  });
+
+  it('marks events that fit no room as unscheduled', () => {
+    const events: Event[] = [{ id: 'crowd', name: 'Crowd', duration: 30, attendees: 500 }];
+    const result = schedule(events, ROOMS, DAY);
+    expect(result.assignments).toEqual([]);
+    expect(result.unscheduled).toEqual(['crowd']);
+  });
+
+  it('defaults attendees to 1', () => {
+    const rooms: Room[] = [{ id: 'tiny', name: 'Tiny', capacity: 1 }];
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 30 }];
+    const result = schedule(events, rooms, DAY);
+    expect(result.unscheduled).toEqual([]);
+  });
+
+  it('does not waste the only large room on small events', () => {
+    // r2 is the only room that can hold `big`; a naive scheduler that fills r2
+    // with the small events first would drop it.
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Small', capacity: 5 },
+      { id: 'r2', name: 'Large', capacity: 50 },
+    ];
+    const options = { startTime: 0, endTime: 120, gap: 0 };
+    const events: Event[] = [
+      { id: 's1', name: 'S1', duration: 60, attendees: 2 },
+      { id: 's2', name: 'S2', duration: 60, attendees: 2 },
+      { id: 'big', name: 'Big', duration: 120, attendees: 30 },
+    ];
+    const result = schedule(events, rooms, options);
+    validate(events, rooms, options, result);
+    expect(result.unscheduled).toEqual([]);
+  });
+});
+
+describe('gaps', () => {
+  it('applies the default 15 minute gap between events in a room', () => {
+    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60 },
+      { id: 'b', name: 'B', duration: 60 },
+    ];
+    const result = schedule(events, rooms, DAY);
+    validate(events, rooms, DAY, result);
+    const sorted = [...result.assignments].sort((x, y) => x.startTime - y.startTime);
+    expect(sorted[1].startTime - sorted[0].endTime).toBeGreaterThanOrEqual(15);
+  });
+
+  it('honours a custom gap', () => {
+    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];
+    const options = { startTime: 0, endTime: 300, gap: 45 };
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60 },
+      { id: 'b', name: 'B', duration: 60 },
+    ];
+    const result = schedule(events, rooms, options);
+    validate(events, rooms, options, result);
+    const sorted = [...result.assignments].sort((x, y) => x.startTime - y.startTime);
+    expect(sorted[1].startTime - sorted[0].endTime).toBeGreaterThanOrEqual(45);
+  });
+
+  it('supports a zero gap', () => {
+    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];
+    const options = { startTime: 0, endTime: 120, gap: 0 };
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60 },
+      { id: 'b', name: 'B', duration: 60 },
+    ];
+    const result = schedule(events, rooms, options);
+    validate(events, rooms, options, result);
+    expect(result.unscheduled).toEqual([]);
+  });
+
+  it('lets the gap limit how many events fit', () => {
+    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];
+    const options = { startTime: 0, endTime: 135, gap: 15 };
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60 },
+      { id: 'b', name: 'B', duration: 60 },
+      { id: 'c', name: 'C', duration: 60 },
+    ];
+    const result = schedule(events, rooms, options);
+    validate(events, rooms, options, result);
+    expect(result.assignments).toHaveLength(2);
+    expect(result.unscheduled).toHaveLength(1);
+  });
+});
+
+describe('prerequisites', () => {
+  it('orders events after their prerequisites, with the gap applied', () => {
+    const events: Event[] = [
+      { id: 'c', name: 'C', duration: 30, prerequisites: ['b'] },
+      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },
+      { id: 'a', name: 'A', duration: 30 },
+    ];
+    const result = schedule(events, ROOMS, DAY);
+    validate(events, ROOMS, DAY, result);
+    const at = (id: string) => result.assignments.find((x) => x.eventId === id);
+    expect(at('b')!.startTime).toBeGreaterThanOrEqual(at('a')!.endTime + 15);
+    expect(at('c')!.startTime).toBeGreaterThanOrEqual(at('b')!.endTime + 15);
+  });
+
+  it('applies the prerequisite gap across different rooms', () => {
+    const rooms: Room[] = [
+      { id: 'r1', name: 'One', capacity: 10 },
+      { id: 'r2', name: 'Two', capacity: 10 },
+    ];
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30, preferredRoom: 'r1' },
+      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'], preferredRoom: 'r2' },
+    ];
+    const result = schedule(events, rooms, DAY);
+    validate(events, rooms, DAY, result);
+    const a = result.assignments.find((x) => x.eventId === 'a')!;
+    const b = result.assignments.find((x) => x.eventId === 'b')!;
+    expect(b.startTime).toBeGreaterThanOrEqual(a.endTime + 15);
+  });
+
+  it('handles diamond dependencies', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30 },
+      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },
+      { id: 'c', name: 'C', duration: 30, prerequisites: ['a'] },
+      { id: 'd', name: 'D', duration: 30, prerequisites: ['b', 'c'] },
+    ];
+    const result = schedule(events, ROOMS, DAY);
+    validate(events, ROOMS, DAY, result);
+    expect(result.unscheduled).toEqual([]);
+  });
+
+  it('unschedules dependents when the prerequisite cannot be placed', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30, attendees: 999 },
+      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },
+    ];
+    const result = schedule(events, ROOMS, DAY);
+    validate(events, ROOMS, DAY, result);
+    expect(result.unscheduled.sort()).toEqual(['a', 'b']);
+  });
+
+  it('drops a chain that cannot fit in the window', () => {
+    const options = { startTime: 0, endTime: 100, gap: 15 };
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60 },
+      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },
+    ];
+    const result = schedule(events, ROOMS, options);
+    validate(events, ROOMS, options, result);
+    expect(result.assignments).toHaveLength(1);
+    expect(result.unscheduled).toEqual(['b']);
+  });
+
+  it('ignores prerequisite ids that do not exist', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 30, prerequisites: ['ghost'] }];
+    const result = schedule(events, ROOMS, DAY);
+    validate(events, ROOMS, DAY, result);
+    expect(result.unscheduled).toEqual([]);
+  });
+});
+
+describe('prerequisite cycles', () => {
+  it('throws on a self reference', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 30, prerequisites: ['a'] }];
+    expect(() => schedule(events, ROOMS, DAY)).toThrow(/cycl/i);
+  });
+
+  it('throws on a two node cycle', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30, prerequisites: ['b'] },
+      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },
+    ];
+    expect(() => schedule(events, ROOMS, DAY)).toThrow();
+  });
+
+  it('throws on a longer cycle buried among valid events', () => {
+    const events: Event[] = [
+      { id: 'root', name: 'Root', duration: 30 },
+      { id: 'a', name: 'A', duration: 30, prerequisites: ['c', 'root'] },
+      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },
+      { id: 'c', name: 'C', duration: 30, prerequisites: ['b'] },
+    ];
+    expect(() => schedule(events, ROOMS, DAY)).toThrow(/cycl/i);
+  });
+
+  it('does not throw on a diamond, which is not a cycle', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30 },
+      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },
+      { id: 'c', name: 'C', duration: 30, prerequisites: ['a'] },
+      { id: 'd', name: 'D', duration: 30, prerequisites: ['b', 'c'] },
+    ];
+    expect(() => schedule(events, ROOMS, DAY)).not.toThrow();
+  });
+});
+
+describe('preferred room', () => {
+  it('honours the preference when it is free', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 60, preferredRoom: 'r2' }];
+    const result = schedule(events, ROOMS, DAY);
+    expect(result.assignments[0].roomId).toBe('r2');
+  });
+
+  it('ignores a preference that would break capacity', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60, attendees: 40, preferredRoom: 'r1' },
+    ];
+    const result = schedule(events, ROOMS, DAY);
+    validate(events, ROOMS, DAY, result);
+    expect(result.assignments[0].roomId).toBe('r2');
+  });
+
+  it('treats the preference as a hint, not a hard constraint', () => {
+    // Both events want r1, but only one fits there in this window.
+    const rooms: Room[] = [
+      { id: 'r1', name: 'One', capacity: 10 },
+      { id: 'r2', name: 'Two', capacity: 10 },
+    ];
+    const options = { startTime: 0, endTime: 60, gap: 15 };
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60, preferredRoom: 'r1' },
+      { id: 'b', name: 'B', duration: 60, preferredRoom: 'r1' },
+    ];
+    const result = schedule(events, rooms, options);
+    validate(events, rooms, options, result);
+    expect(result.unscheduled).toEqual([]);
+    expect(new Set(result.assignments.map((a) => a.roomId)).size).toBe(2);
+  });
+
+  it('ignores an unknown preferred room', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 60, preferredRoom: 'nope' }];
+    const result = schedule(events, ROOMS, DAY);
+    validate(events, ROOMS, DAY, result);
+    expect(result.assignments).toHaveLength(1);
+  });
+
+  it('satisfies every preference when they do not collide', () => {
+    const rooms: Room[] = [
+      { id: 'r1', name: 'One', capacity: 10 },
+      { id: 'r2', name: 'Two', capacity: 10 },
+      { id: 'r3', name: 'Three', capacity: 10 },
+    ];
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60, preferredRoom: 'r3' },
+      { id: 'b', name: 'B', duration: 60, preferredRoom: 'r1' },
+      { id: 'c', name: 'C', duration: 60, preferredRoom: 'r2' },
+    ];
+    const result = schedule(events, rooms, DAY);
+    validate(events, rooms, DAY, result);
+    for (const a of result.assignments) {
+      const preferred = events.find((e) => e.id === a.eventId)!.preferredRoom;
+      expect(a.roomId).toBe(preferred);
+    }
+  });
+
+  it('drops a preference rather than losing a placement', () => {
+    // Everyone prefers r1; a scheduler that treats the hint as hard would leave
+    // r2 empty and drop two events.
+    const rooms: Room[] = [
+      { id: 'r1', name: 'One', capacity: 10 },
+      { id: 'r2', name: 'Two', capacity: 10 },
+    ];
+    const options = { startTime: 0, endTime: 120, gap: 0 };
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60, preferredRoom: 'r1' },
+      { id: 'b', name: 'B', duration: 60, preferredRoom: 'r1' },
+      { id: 'c', name: 'C', duration: 60, preferredRoom: 'r1' },
+      { id: 'd', name: 'D', duration: 60, preferredRoom: 'r1' },
+    ];
+    const result = schedule(events, rooms, options);
+    validate(events, rooms, options, result);
+    expect(result.unscheduled).toEqual([]);
+  });
+});
+
+describe('batch optimisation', () => {
+  it('beats first-come-first-served ordering', () => {
+    // Input order 90/60/60 into a 150 minute window with no gap: taking the 90
+    // first leaves room for only one 60. The optimum drops the 90 and keeps two.
+    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];
+    const options = { startTime: 0, endTime: 120, gap: 0 };
+    const events: Event[] = [
+      { id: 'long', name: 'Long', duration: 90 },
+      { id: 's1', name: 'S1', duration: 60 },
+      { id: 's2', name: 'S2', duration: 60 },
+    ];
+    const result = schedule(events, rooms, options);
+    validate(events, rooms, options, result);
+    expect(result.assignments).toHaveLength(2);
+    expect(result.unscheduled).toEqual(['long']);
+  });
+
+  it('fills two rooms completely', () => {
+    const rooms: Room[] = [
+      { id: 'r1', name: 'One', capacity: 10 },
+      { id: 'r2', name: 'Two', capacity: 10 },
+    ];
+    const options = { startTime: 540, endTime: 1020, gap: 15 };
+    const events: Event[] = Array.from({ length: 12 }, (_, i) => ({
+      id: `e${i}`,
+      name: `E${i}`,
+      duration: 60,
+    }));
+    const result = schedule(events, rooms, options);
+    validate(events, rooms, options, result);
+    // Each room fits 6 hours of work plus 5 gaps = 435 minutes <= 480.
+    expect(result.assignments).toHaveLength(12);
+  });
+
+  it('matches the exhaustive optimum on random instances', () => {
+    const random = rng(20260724);
+    for (let trial = 0; trial < 25; trial++) {
+      const roomCount = 1 + Math.floor(random() * 2);
+      const rooms: Room[] = Array.from({ length: roomCount }, (_, i) => ({
+        id: `r${i}`,
+        name: `R${i}`,
+        capacity: 2 + Math.floor(random() * 20),
+      }));
+      const eventCount = 3 + Math.floor(random() * 3);
+      const events: Event[] = Array.from({ length: eventCount }, (_, i) => ({
+        id: `e${i}`,
+        name: `E${i}`,
+        duration: 15 + Math.floor(random() * 6) * 15,
+        attendees: 1 + Math.floor(random() * 12),
+      }));
+      // Occasionally chain two events together.
+      if (random() < 0.5 && eventCount >= 2) {
+        events[1].prerequisites = [events[0].id];
+      }
+      const options: ScheduleOptions = {
+        startTime: 0,
+        endTime: 60 + Math.floor(random() * 5) * 30,
+        gap: [0, 10, 15][Math.floor(random() * 3)],
+      };
+
+      const result = schedule(events, rooms, options);
+      validate(events, rooms, options, result);
+      expect(result.assignments.length).toBe(bruteForceMax(events, rooms, options));
+    }
+  });
+
+  it('produces valid schedules on larger random instances', () => {
+    const random = rng(777);
+    for (let trial = 0; trial < 8; trial++) {
+      const rooms: Room[] = Array.from({ length: 4 }, (_, i) => ({
+        id: `r${i}`,
+        name: `R${i}`,
+        capacity: 5 + i * 15,
+      }));
+      const events: Event[] = Array.from({ length: 40 }, (_, i) => ({
+        id: `e${i}`,
+        name: `E${i}`,
+        duration: 30 + Math.floor(random() * 4) * 30,
+        attendees: 1 + Math.floor(random() * 45),
+        preferredRoom: random() < 0.4 ? `r${Math.floor(random() * 4)}` : undefined,
+      }));
+      for (let i = 5; i < events.length; i++) {
+        if (random() < 0.25) events[i].prerequisites = [`e${Math.floor(random() * i)}`];
+      }
+      const options: ScheduleOptions = { startTime: 540, endTime: 1140, gap: 15 };
+      const result = schedule(events, rooms, options);
+      validate(events, rooms, options, result);
+    }
+  });
+
+  it('stays fast on a large instance', () => {
+    const rooms: Room[] = Array.from({ length: 8 }, (_, i) => ({
+      id: `r${i}`,
+      name: `R${i}`,
+      capacity: 10 + i * 10,
+    }));
+    const events: Event[] = Array.from({ length: 300 }, (_, i) => ({
+      id: `e${i}`,
+      name: `E${i}`,
+      duration: 30 + (i % 4) * 15,
+      attendees: 1 + (i % 60),
+      prerequisites: i > 3 && i % 7 === 0 ? [`e${i - 4}`] : undefined,
+    }));
+    const options: ScheduleOptions = { startTime: 480, endTime: 1200, gap: 10 };
+    const started = Date.now();
+    const result = schedule(events, rooms, options);
+    expect(Date.now() - started).toBeLessThan(5000);
+    validate(events, rooms, options, result);
+  });
+});
