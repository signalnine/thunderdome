+/**
+ * Thrown when the prerequisite graph is not a DAG, including the degenerate
+ * self-reference case (`A` requiring `A`).
+ */
+export class PrerequisiteCycleError extends Error {
+  /** The offending cycle, e.g. `['a', 'b', 'a']`. */
+  readonly cycle: string[];
+
+  constructor(cycle: string[]) {
+    super(
+      `Cyclic prerequisite dependency detected (circular reference): ${cycle.join(' -> ')}`,
+    );
+    this.name = 'PrerequisiteCycleError';
+    this.cycle = cycle;
+  }
+}
