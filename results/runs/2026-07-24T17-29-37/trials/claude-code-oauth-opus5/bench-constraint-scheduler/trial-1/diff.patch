@@ -0,0 +1,55 @@
+/**
+ * Public data model for the constraint-based event scheduler.
+ */
+
+export interface Event {
+  id: string;
+  /** Human readable label. Unused by the solver, kept for round-tripping. */
+  name?: string;
+  /** Length of the event in minutes. */
+  duration: number;
+  /** Number of people attending. Defaults to 1. */
+  attendees?: number;
+  /** Ids of events that must finish (plus `gap`) before this one starts. */
+  prerequisites?: string[];
+  /** Soft hint: honored whenever it does not cost us a placement. */
+  preferredRoom?: string;
+}
+
+export interface Room {
+  id: string;
+  name?: string;
+  /** Maximum number of attendees the room can hold. */
+  capacity: number;
+}
+
+export interface ScheduleOptions {
+  /** Window start, in minutes from midnight (540 = 9:00 AM). */
+  startTime: number;
+  /** Window end, in minutes from midnight (1020 = 5:00 PM). */
+  endTime: number;
+  /** Minimum minutes between two events in the same room. Defaults to 15. */
+  gap?: number;
+  /**
+   * Optional search-effort knobs. These only affect how hard the solver looks
+   * for a better schedule, never whether a returned schedule is valid.
+   */
+  seed?: number;
+  maxIterations?: number;
+  timeLimitMs?: number;
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  /** Minutes from midnight. */
+  startTime: number;
+  /** Minutes from midnight. */
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  /** Ids of events that could not be placed, in input order. */
+  unscheduled: string[];
+}
diff --git a/tests/helpers.ts b/tests/helpers.ts
new file mode 100644
index 0000000..a41646e
--- /dev/null
+++ b/tests/helpers.ts
@@ -0,0 +1,175 @@
+import type { Event, Room, ScheduleOptions, ScheduleResult } from '../src/index.js';
+
+export const DEFAULT_GAP = 15;
+
+/**
+ * Asserts every hard constraint of the problem statement against a result.
+ * Throws with a descriptive message on the first violation.
+ */
+export function validate(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  result: ScheduleResult,
+): void {
+  const gap = options.gap ?? DEFAULT_GAP;
+  const eventById = new Map(events.map((e) => [e.id, e]));
+  const roomById = new Map(rooms.map((r) => [r.id, r]));
+
+  const seen = new Set<string>();
+  for (const a of result.assignments) {
+    if (seen.has(a.eventId)) throw new Error(`duplicate assignment for ${a.eventId}`);
+    seen.add(a.eventId);
+    const event = eventById.get(a.eventId);
+    if (!event) throw new Error(`assignment for unknown event ${a.eventId}`);
+    const room = roomById.get(a.roomId);
+    if (!room) throw new Error(`assignment to unknown room ${a.roomId}`);
+
+    if (a.endTime - a.startTime !== event.duration) {
+      throw new Error(`${a.eventId}: duration mismatch (${a.startTime}..${a.endTime})`);
+    }
+    if (a.startTime < options.startTime || a.endTime > options.endTime) {
+      throw new Error(`${a.eventId}: outside window (${a.startTime}..${a.endTime})`);
+    }
+    if ((event.attendees ?? 1) > room.capacity) {
+      throw new Error(`${a.eventId}: attendees exceed capacity of ${a.roomId}`);
+    }
+  }
+
+  for (const id of result.unscheduled) {
+    if (seen.has(id)) throw new Error(`${id} is both scheduled and unscheduled`);
+    if (!eventById.has(id)) throw new Error(`unknown unscheduled id ${id}`);
+  }
+  const total = result.assignments.length + result.unscheduled.length;
+  if (total !== events.length) {
+    throw new Error(`expected ${events.length} events, saw ${total}`);
+  }
+
+  // Room gap: no two events in the same room may be closer than `gap`.
+  for (let i = 0; i < result.assignments.length; i++) {
+    for (let j = i + 1; j < result.assignments.length; j++) {
+      const a = result.assignments[i];
+      const b = result.assignments[j];
+      if (a.roomId !== b.roomId) continue;
+      if (a.endTime + gap > b.startTime && b.endTime + gap > a.startTime) {
+        throw new Error(
+          `${a.eventId} and ${b.eventId} violate the ${gap}min gap in ${a.roomId}`,
+        );
+      }
+    }
+  }
+
+  // Prerequisites, including the gap and the "prereq must be scheduled" rule.
+  const byId = new Map(result.assignments.map((a) => [a.eventId, a]));
+  for (const a of result.assignments) {
+    const event = eventById.get(a.eventId) as Event;
+    for (const dep of event.prerequisites ?? []) {
+      if (!eventById.has(dep)) continue;
+      const depAssignment = byId.get(dep);
+      if (!depAssignment) {
+        throw new Error(`${a.eventId} scheduled but prerequisite ${dep} was not`);
+      }
+      if (depAssignment.endTime + gap > a.startTime) {
+        throw new Error(
+          `${a.eventId} starts at ${a.startTime} before prerequisite ${dep} ends at ` +
+            `${depAssignment.endTime} (+${gap} gap)`,
+        );
+      }
+    }
+  }
+}
+
+/**
+ * Exhaustive optimum for tiny instances: the best count over every ordering and
+ * every room assignment, each evaluated with left-shifted placement. Since all
+ * events share a single deadline, some optimal schedule is left-shifted, so
+ * this enumeration is exact.
+ */
+export function bruteForceMax(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): number {
+  const gap = options.gap ?? DEFAULT_GAP;
+  const n = events.length;
+  const indices = events.map((_, i) => i);
+  const idToIndex = new Map(events.map((e, i) => [e.id, i]));
+  let best = 0;
+
+  const permute = (prefix: number[], rest: number[]): void => {
+    if (rest.length === 0) {
+      best = Math.max(best, evaluateAllAssignments(prefix));
+      return;
+    }
+    for (let i = 0; i < rest.length; i++) {
+      permute([...prefix, rest[i]], [...rest.slice(0, i), ...rest.slice(i + 1)]);
+    }
+  };
+
+  const evaluateAllAssignments = (order: number[]): number => {
+    let localBest = 0;
+    const choice = new Array<number>(n).fill(0);
+    const combos = Math.pow(rooms.length, n);
+    for (let mask = 0; mask < combos; mask++) {
+      let m = mask;
+      for (let i = 0; i < n; i++) {
+        choice[i] = m % rooms.length;
+        m = Math.floor(m / rooms.length);
+      }
+      localBest = Math.max(localBest, evaluate(order, choice));
+      if (localBest === n) return n;
+    }
+    return localBest;
+  };
+
+  const evaluate = (order: number[], choice: number[]): number => {
+    const busy: { start: number; end: number }[][] = rooms.map(() => []);
+    const start = new Array<number>(n).fill(-1);
+    let count = 0;
+    for (const idx of order) {
+      const event = events[idx];
+      const roomIndex = choice[idx];
+      const room = rooms[roomIndex];
+      if ((event.attendees ?? 1) > room.capacity) continue;
+
+      let release = options.startTime;
+      let blocked = false;
+      for (const dep of event.prerequisites ?? []) {
+        const depIndex = idToIndex.get(dep);
+        if (depIndex === undefined) continue;
+        if (start[depIndex] < 0) {
+          blocked = true;
+          break;
+        }
+        release = Math.max(release, start[depIndex] + events[depIndex].duration + gap);
+      }
+      if (blocked) continue;
+
+      let at = release;
+      const timeline = [...busy[roomIndex]].sort((a, b) => a.start - b.start);
+      for (const b of timeline) {
+        if (at + event.duration + gap <= b.start) break;
+        if (b.end + gap > at) at = b.end + gap;
+      }
+      if (at + event.duration > options.endTime) continue;
+      busy[roomIndex].push({ start: at, end: at + event.duration });
+      start[idx] = at;
+      count++;
+    }
+    return count;
+  };
+
+  permute([], indices);
+  return best;
+}
+
+/** Small deterministic PRNG for reproducible random instances. */
+export function rng(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
