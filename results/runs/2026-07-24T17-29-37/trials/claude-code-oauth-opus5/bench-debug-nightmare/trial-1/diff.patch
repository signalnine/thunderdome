 it('rounds correctly for penny-edge amounts', () => {\n    47\t    // This specifically tests that we don't double-round\n    48\t    const result = calculateOrderTotal(\n    49\t      [{ productId: 'A', quantity: 1, unitPrice: 33.33 }],\n    50\t      5,\n    51\t      0.07\n    52\t    );\n    53\t    // subtotal = 33.33\n    54\t    // discount = 33.33 * 0.05 = 1.6665\n    55\t    // after discount = 31.6635\n    56\t    // tax = 31.6635 * 0.07 = 2.21644...\n    57\t    // total = 33.87994... -> 33.88\n    58\t    expect(result.total).toBe(33.88);\n    59\t  });\n    60\t});\n    61\t\n    62\tdescribe('BillingService', () => {\n    63\t  let bus: EventBus;\n    64\t  let notifications: NotificationService;\n    65\t  let billing: BillingService;\n    66\t\n    67\t  beforeEach(() => {\n    68\t    bus = new EventBus();\n    69\t    notifications = new NotificationService();\n    70\t    billing = new BillingService(bus, notifications);\n    71\t    billing.registerHandlers();\n    72\t  });\n    73\t\n    74\t  it('charges payment and records it', async () => {\n    75\t    const record = await billing.chargePayment(\n    76\t      'O1',\n    77\t      [{ productId: 'A', quantity: 1, unitPrice: 100 }],\n    78\t      0,\n    79\t      0.1,\n    80\t      'card'\n    81\t    );\n    82\t    expect(record.amount).toBe(110);\n    83\t    expect(record.status).toBe('charged');\n    84\t    expect(record.method).toBe('card');\n    85\t  });\n    86\t\n    87\t  it('sends confirmation notification on charge', async () => {\n    88\t    await billing.chargePayment(\n    89\t      'O1',\n    90\t      [{ productId: 'A', quantity: 1, unitPrice: 100 }],\n    91\t      0,\n    92\t      0.1,\n    93\t      'card'\n    94\t    );\n    95\t    const sent = notifications.getSentNotifications();\n    96\t    expect(sent).toHaveLength(1);\n    97\t    expect(sent[0].type).toBe('confirmation');\n    98\t    expect(sent[0].message).toContain('O1');\n    99\t  });\n   100\t\n   101\t  it('issues refund and updates payment status', async () => {\n   102\t    await billing.chargePayment(\n   103\t      'O1',\n   104\t      [{ productId: 'A', quantity: 1, unitPrice: 50 }],\n   105\t      0,\n   106\t      0,\n   107\t      'card'\n   108\t    );\n   109\t    const refund = await billing.issueRefund('O1', 50);\n   110\t    expect(refund?.status).toBe('refunded');\n   111\t  });\n   112\t\n   113\t  it('sends refund notification', async () => {\n   114\t    await billing.chargePayment(\n   115\t      'O1',\n   116\t      [{ productId: 'A', quantity: 1, unitPrice: 50 }],\n   117\t      0,\n   118\t      0,\n   119\t      'card'\n   120\t    );\n   121\t    await billing.issueRefund('O1', 50);\n   122\t    const sent = notifications.getSentNotifications();\n   123\t    const refundNotice = sent.find((n) => n.type === 'refund');\n   124\t    expect(refundNotice).toBeDefined();\n   125\t    expect(refundNotice!.message).toContain('50.00');\n   126\t  });\n   127\t});\n=== tests/events.test.ts ===\n     1\timport { describe, it, expect, beforeEach } from 'vitest';\n     2\timport { EventBus } from '../src/events/bus.js';\n     3\t\n     4\tdescribe('EventBus', () => {\n     5\t  let bus: EventBus;\n     6\t\n     7\t  beforeEach(() => {\n     8\t    bus = new EventBus();\n     9\t  });\n    10\t\n    11\t  it('emits events to registered handlers', async () => {\n    12\t    const received: unknown[] = [];\n    13\t    bus.on('test', (data) => { received.push(data); });\n    14\t    await bus.emit('test', { value: 1 });\n    15\t    expect(received).toEqual([{ value: 1 }]);\n    16\t  });\n    17\t\n    18\t  it('supports multiple handlers for same event', async () => {\n    19\t    let count = 0;\n    20\t    bus.on('test', () => { count++; });\n    21\t    bus.on('test', () => { count++; });\n    22\t    await bus.emit('test', {});\n    23\t    expect(count).toBe(2);\n    24\t  });\n    25\t\n    26\t  it('does not fire handlers for different events