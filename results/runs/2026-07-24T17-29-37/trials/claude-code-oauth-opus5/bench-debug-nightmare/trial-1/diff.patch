argePayment(\n    40\t    orderId: string,\n    41\t    items: OrderItem[],\n    42\t    discountPercent: number,\n    43\t    taxRate: number,\n    44\t    paymentMethod: string\n    45\t  ): Promise<PaymentRecord> {\n    46\t    const breakdown = calculateOrderTotal(items, discountPercent, taxRate);\n    47\t\n    48\t    const record: PaymentRecord = {\n    49\t      orderId,\n    50\t      amount: breakdown.total,\n    51\t      method: paymentMethod,\n    52\t      status: 'charged',\n    53\t      processedAt: Date.now(),\n    54\t    };\n    55\t\n    56\t    this.payments.set(orderId, record);\n    57\t    this.notificationService.sendConfirmation(orderId, breakdown.total);\n    58\t    return record;\n    59\t  }\n    60\t\n    61\t  private async handleRefund(data: unknown): Promise<void> {\n    62\t    const event = data as { orderId: string; amount: number };\n    63\t    const payment = this.payments.get(event.orderId);\n    64\t    if (payment) {\n    65\t      payment.status = 'refunded';\n    66\t      this.notificationService.sendRefundNotice(event.orderId, event.amount);\n    67\t    }\n    68\t  }\n    69\t\n    70\t  async issueRefund(orderId: string, amount: number): Promise<PaymentRecord | undefined> {\n    71\t    const payment = this.payments.get(orderId);\n    72\t    if (!payment) return undefined;\n    73\t\n    74\t    payment.status = 'refunded';\n    75\t\n    76\t    await this.eventBus.emit(ORDER_EVENTS.REFUNDED, {\n    77\t      orderId,\n    78\t      amount,\n    79\t      timestamp: Date.now(),\n    80\t    });\n    81\t\n    82\t    return { ...payment };\n    83\t  }\n    84\t\n    85\t  getPayment(orderId: string): PaymentRecord | undefined {\n    86\t    const p = this.payments.get(orderId);\n    87\t    return p ? { ...p } : undefined;\n    88\t  }\n    89\t\n    90\t  clear(): void {\n    91\t    this.payments.clear();\n    92\t  }\n    93\t}\n=== src/billing/calculator.ts ===\n     1\timport { OrderItem } from '../orders/repository.js';\n     2\t\n     3\texport interface PriceBreakdown {\n     4\t  subtotal: number;\n     5\t  discountAmount: number;\n     6\t  taxAmount: number;\n     7\t  total: number;\n     8\t}\n     9\t\n    10\texport function calculateOrderTotal(\n    11\t  items: OrderItem[],\n    12\t  discountPercent: number,\n    13\t  taxRate: number\n    14\t): PriceBreakdown {\n    15\t  const subtotal = items.reduce(\n    16\t    (sum, item) => sum + item.unitPrice * item.quantity,\n    17\t    0\n    18\t  );\n    19\t\n    20\t  const discountAmount = Math.round(subtotal * (discountPercent / 100) * 100) / 100;\n    21\t  const afterDiscount = Math.round((subtotal - discountAmount) * 100) / 100;\n    22\t  const taxAmount = Math.round(afterDiscount * taxRate * 100) / 100;\n    23\t  const total = afterDiscount + taxAmount;\n    24\t\n    25\t  return {\n    26\t    subtotal: Math.round(subtotal * 100) / 100,\n    27\t    discountAmount: Math.round(discountAmount * 100) / 100,\n    28\t    taxAmount: Math.round(taxAmount * 100) / 100,\n    29\t    total,\n    30\t  };\n    31\t}\n=== src/orders/service.ts ===\n     1\timport { EventBus } from '../events/bus.js';\n     2\timport { ORDER_EVENTS, OrderCreatedEvent } from '../events/types.js';\n     3\timport { OrderRepository, Order, OrderItem } from './repository.js';\n     4\timport { BillingService } from '../billing/service.js';\n     5\t\n     6\tconst REFUND_WINDOW_DAYS = 30;\n     7\t\n     8\texport class OrderService {\n     9\t  constructor(\n    10\t    private repo: OrderRepository,\n    11\t    private eventBus: EventBus,\n    12\t    private billingService: BillingService\n    13\t  ) {}\n    14\t\n    15\t  async createOrder(\n    16\t    id: string,\n    17\t    customerId: string,\n    18\t    items: OrderItem[],\n    19\t    discount: number = 0,\n    20\t    taxRate: number = 0.1\n    21\t  ): Promise<Order> {\n    22\t    this.repo.create({\n    23\t      id,\n    24\t      customerId,\n    25\t      items: [...items],\n    26\t      status: 'pending',\n    27\t      total: 0,\n    28\t      discount,\n    29\t      taxRate,\n    30\t      createdAt: Date.now(),\n    31\t      updatedAt: Date.now(),\n    32\t    });\n    33\t\n    34\t    const event: OrderCreatedEvent = {\n    35\t      orderId: id,\n    36\t      items: items.map((i) => ({\n    37\t        productId: i.productId,\n    38\t        quantity: i.quantity,\n    39\t        unitPrice: i.unitPrice,\n    40\t      })),\n    41\t      customerId,\n    42\t      timestamp: Date.now(),\n    43\t    };\n    44\t\n    45\t    await this.eventBus.emit(ORDER_EVENTS.CREATED, event);\n    46\t\n    47\t    // Charge payment and confirm\n    48\t    const payment = await this.billingService.chargePayment(\n    49\t      id,\n    50\t      items,\n    51\t      discount,\n    52\t      taxRate,\n    53\t      'card'\n    54\t    );\n    55\t\n    56\t    this.repo.update(id, {\n    57\t      status: 'confirmed',\n    58\t      total: payment.amount,\n    59\t    });\n    60\t\n    61\t    await this.eventBus.emit(ORDER_EVENTS.CONFIRMED, {\n    62\t      orderId: id,\n    63\t      timestamp: Date.now(),\n    64\t    });\n    65\t\n    66\t    return this.repo.findById(id)!;\n    67\t  }\n    68\t\n    69\t  async cancelOrder(id: string, reason: string): Promise<Order | undefined> {\n    70\t    const order = this.repo.findById(id);\n    71\t    if (!order) return undefined;\n    72\t    if (order.status !== 'confirmed') return undefined;\n    73\t\n    74\t    // Emit cancellation event, then update status\n    75\t    await this.eventBus.emit(ORDER_EVENTS.CANCELLED, {\n    76\t      orderId: id,\n    77\t      reason,\n    78\t      items: order.items.map((i) => ({\n    79\t        productId: i.productId,\n    80\t        quantity: i.quantity,\n    81\t      })),\n    82\t      timestamp: Date.now(),\n    83\t    });\n    84\t\n    85\t    this.repo.update(id, { status: 'cancelled' });\n    86\t\n    87\t    return this.repo.findById(id);\n    88\t  }\n    89\t\n    90\t  async refundOrder(id: string): Promise<Order | undefined> {\n    91\t    const order = this.repo.findById(id);\n    92\t    if (!order) return undefined;\n    93\t    if (order.status !== 'cancelled') return undefined;\n    94\t\n    95\t    const daysSinceCreation = Math.floor(\n    96\t      (Date.now() - order.createdAt) / (1000 * 60 * 60 * 24)\n    97\t    );\n    98\t\n    99\t    if (daysSinceCreation >= REFUND_WINDOW_DAYS) {\n   100\t      throw new Error(\n   101\t        `Refund window expired: ${daysSinceCreation} days since order (max ${REFUND_WINDOW_DAYS})`\n   102\t      );\n   103\t    }\n   104\t\n   105\t    await this.billingService.issueRefund(id, order.total);\n   106\t    this.repo.update(id, { status: 'refunded' });\n   107\t\n   108\t    return this.repo.findById(id);\n   109\t  }\n   110\t\n   111\t  getOrder(id: string): Order | undefined {\n   112\t    return this.repo.findById(id);\n   113\t  }\n   114\t\n   115\t  getOrdersByCustomer(customerId: string): Order[] {\n   116\t    return this.repo.findByCustomer(customerId);\n   117\t  }\n   118\t}\n=== src/orders/repository.ts ===\n     1\texport type OrderStatus = 'pending' | 'confirmed' | 'cancelled' | 'refunded';\n     2\t\n     3\texport interface OrderItem {\n     4\t  productId: string;\n     5\t  quantity: number;\n     6\t  unitPrice: number;\n     7\t}\n     8\t\n     9\texport interface Order {\n    10\t  id: string;\n    11\t  customerId: string;\n    12\t  items: OrderItem[];\n    13\t  status: OrderStatus;\n    14\t  total: number;\n    15\t  discount: number;\n    16\t  taxRate: number;\n    17\t  createdAt: number;\n    18\t  updatedAt: number;\n    19\t  notes?: string;\n    20\t}\n    21\t\n    22\texport class OrderRepository {\n    23\t  private store: Map<string, Order> = new Map();\n    24\t\n    25\t  create(order: Order): Order {\n    26\t    this.store.set(order.id, { ...order });\n    27\t    return { ...order };\n    28\t  }\n    29\t\n    30\t  findById(id: string): Order | undefined {\n    31\t    const order = this.store.get(id);\n    32\t    return order ? { ...order } : undefined;\n    33\t  }\n    34\t\n    35\t  update(id: string, updates: Partial<Order>): Order | undefined {\n    36\t    const existing = this.store.get(id);\n    37\t    if (!existing) return undefined;\n    38\t    const updated = { ...updates, id, updatedAt: Date.now() } as Order;\n    39\t    this.store.set(id, updated);\n    40\t    return { ...updated };\n    41\t  }\n    42\t\n    43\t  findByCustomer(customerId: string): Order[] {\n    44\t    return Array.from(this.store.values())\n    45\t      .filter((o) => o.customerId === customerId)\n    46\t      .map((o) => ({ ...o }));\n    47\t  }\n    48\t\n    49\t  findByStatus(status: OrderStatus): Order[] {\n    50\t    return Array.from(this.store.values())\n    51\t      .filter((o) => o.status === status)\n    52\t      .map((o) => ({ ...o }));\n    53\t  }\n    54\t\n    55\t  clear(): void {\n    56\t    this.store.clear();\n    57\t  }\n    58\t}\n=== src/notifications/service.ts ===\n     1\texport interface NotificationRecord {\n     2\t  type: string;\n     3\t  orderId: string;\n     4\t  message: string;\n     5\t  sentAt: number;\n     6\t}\n     7\t\n     8\texport class NotificationService {\n     9\t  private templates: Map<string, string>;\n    10\t  private sent: NotificationRecord[] = [];\n    11\t\n    12\t  constructor() {\n    13\t    this.templates = new Map([\n    14\t      ['order.confirmed', 'Your order {orderId} has been confirmed. Total: ${total}'],\n    15\t      ['order.cancelled', 'Your order {orderId} has been cancelled. Reason: {reason}'],\n    16\t      ['order.refunded', 'Your refund of ${amount} for order {orderId} has been processed.'],\n    17\t    ]);\n    18\t  }\n    19\t\n    20\t  sendConfirmation(orderId: string, total: number): NotificationRecord {\n    21\t    const template = this.templates.