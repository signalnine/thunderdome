@@ -0,0 +1,63 @@
+import { EventBus } from '../bus.js';
+import { CatalogService, Events, ProductCreatedEvent } from '../types.js';
+
+interface Product {
+  id: string;
+  name: string;
+  price: number;
+  category: string;
+}
+
+/**
+ * Product catalog. Owns the canonical product records and announces new
+ * products on the bus so downstream services (e.g. pricing) can track them.
+ */
+export function createCatalogService(bus: EventBus): CatalogService {
+  const products = new Map<string, Product>();
+  let nextId = 1;
+
+  const copy = (product: Product): Product => ({ ...product });
+
+  return {
+    createProduct(name, price, category) {
+      const id = `prod_${nextId++}`;
+      products.set(id, { id, name, price, category });
+
+      const event: ProductCreatedEvent = { productId: id, name, price, category };
+      void bus.emit(Events.PRODUCT_CREATED, event);
+
+      return id;
+    },
+
+    getProduct(productId) {
+      const product = products.get(productId);
+      return product ? copy(product) : null;
+    },
+
+    listProducts(category) {
+      const all = [...products.values()];
+      const matching = category === undefined ? all : all.filter(p => p.category === category);
+      return matching.map(copy);
+    },
+
+    searchProducts(query) {
+      const needle = query.toLowerCase();
+      return [...products.values()]
+        .filter(p => p.name.toLowerCase().includes(needle) || p.category.toLowerCase().includes(needle))
+        .map(copy);
+    },
+
+    updateProduct(productId, updates) {
+      const product = products.get(productId);
+      if (!product) return;
+
+      if (updates.name !== undefined) product.name = updates.name;
+      if (updates.price !== undefined) product.price = updates.price;
+      if (updates.category !== undefined) product.category = updates.category;
+    },
+
+    removeProduct(productId) {
+      return products.delete(productId);
+    },
+  };
+}
