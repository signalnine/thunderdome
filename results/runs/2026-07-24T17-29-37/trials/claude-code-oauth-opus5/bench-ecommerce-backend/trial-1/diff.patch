: cart.id, userId: cart.userId, items: cart.items.map(item => ({ ...item })) };\n    },\n\n    clearCart(cartId) {\n      const cart = carts.get(cartId);\n      if (!cart) return;\n\n      cart.items = [];\n      publish(cart);\n    },\n\n    updateQuantity(cartId, productId, quantity) {\n      const cart = carts.get(cartId);\n      if (!cart) return;\n\n      const index = cart.items.findIndex(item => item.productId === productId);\n      if (index === -1) return;\n\n      if (quantity <= 0) {\n        cart.items.splice(index, 1);\n      } else {\n        cart.items[index].quantity = quantity;\n      }\n      publish(cart);\n    },\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":389,"cache_read_input_tokens":49587,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":389},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"aa2048bf-d3f5-4057-b0e4-cfeaf31e36aa","uuid":"7122f3aa-a710-4e63-af3a-06554d642472","request_id":"req_011CdMHuxbyiUpTEnUZBreq7"}
