@@ -0,0 +1,99 @@
+import { EventBus } from '../bus.js';
+import {
+  AnalyticsEvent,
+  AnalyticsService,
+  CartUpdatedEvent,
+  Events,
+  OrderCreatedEvent,
+  PaymentProcessedEvent,
+  PaymentStatus,
+} from '../types.js';
+
+/** Every event the tracker counts. `analytics:event` is excluded to avoid feedback. */
+const TRACKED_EVENTS: readonly string[] = [
+  Events.PRODUCT_CREATED,
+  Events.INVENTORY_UPDATED,
+  Events.LOW_STOCK_ALERT,
+  Events.CART_UPDATED,
+  Events.PRICE_CALCULATED,
+  Events.ORDER_CREATED,
+  Events.ORDER_STATUS_CHANGED,
+  Events.PAYMENT_PROCESSED,
+  Events.NOTIFICATION_SENT,
+];
+
+function round2(value: number): number {
+  return Math.round(value * 100) / 100;
+}
+
+/**
+ * Read-only projection over the bus: event counts, revenue recognised on
+ * successful payments, cart-to-order conversion, and product popularity.
+ *
+ * Payment events carry no amount, so order totals are remembered from
+ * `order:created` and cart contents from `cart:updated`.
+ */
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const cartContents = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const orderTotals = new Map<string, number>();
+  const productCounts = new Map<string, number>();
+  let orderCount = 0;
+  let revenue = 0;
+
+  const record = (name: string, payload: unknown): void => {
+    eventCounts.set(name, (eventCounts.get(name) ?? 0) + 1);
+
+    if (name === Events.CART_UPDATED) {
+      const event = payload as CartUpdatedEvent;
+      cartContents.set(event.cartId, event.items.map(item => ({ ...item })));
+    } else if (name === Events.ORDER_CREATED) {
+      const event = payload as OrderCreatedEvent;
+      orderCount += 1;
+      orderTotals.set(event.orderId, event.total);
+
+      for (const item of cartContents.get(event.cartId) ?? []) {
+        productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+      }
+    } else if (name === Events.PAYMENT_PROCESSED) {
+      const event = payload as PaymentProcessedEvent;
+      if (event.status === PaymentStatus.SUCCESS) {
+        revenue = round2(revenue + (orderTotals.get(event.orderId) ?? 0));
+      }
+    }
+  };
+
+  for (const name of TRACKED_EVENTS) {
+    bus.on(name, payload => {
+      record(name, payload);
+
+      const event: AnalyticsEvent = {
+        event: name,
+        data: (payload ?? {}) as Record<string, unknown>,
+        timestamp: Date.now(),
+      };
+      void bus.emit(Events.ANALYTICS_EVENT, event);
+    });
+  }
+
+  return {
+    getEventCount(eventType) {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue() {
+      return revenue;
+    },
+
+    getConversionRate() {
+      return cartContents.size === 0 ? 0 : orderCount / cartContents.size;
+    },
+
+    getTopProducts(limit) {
+      return [...productCounts.entries()]
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count)
+        .slice(0, Math.max(0, limit));
+    },
+  };
+}
