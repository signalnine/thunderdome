+import { EventBus } from '../bus.js';
+import { Events, InventoryService, InventoryUpdatedEvent, LowStockAlertEvent } from '../types.js';
+
+/**
+ * Stock tracking. Every quantity change is published as `inventory:updated`,
+ * followed by an `inventory:low_stock` alert when the product has an explicit
+ * threshold and has fallen to or below it.
+ */
+export function createInventoryService(bus: EventBus): InventoryService {
+  const stock = new Map<string, number>();
+  const thresholds = new Map<string, number>();
+
+  const checkLowStock = (productId: string, quantity: number): void => {
+    const threshold = thresholds.get(productId);
+    if (threshold === undefined || quantity > threshold) return;
+
+    const alert: LowStockAlertEvent = { productId, currentQuantity: quantity, threshold };
+    void bus.emit(Events.LOW_STOCK_ALERT, alert);
+  };
+
+  const publish = (productId: string, quantity: number): void => {
+    const event: InventoryUpdatedEvent = { productId, quantity };
+    void bus.emit(Events.INVENTORY_UPDATED, event);
+    checkLowStock(productId, quantity);
+  };
+
+  return {
+    setStock(productId, quantity) {
+      const next = Math.max(0, quantity);
+      stock.set(productId, next);
+      publish(productId, next);
+    },
+
+    getStock(productId) {
+      return stock.get(productId) ?? 0;
+    },
+
+    reserve(productId, quantity) {
+      const current = stock.get(productId) ?? 0;
+      if (quantity <= 0 || current < quantity) return false;
+
+      const next = current - quantity;
+      stock.set(productId, next);
+      publish(productId, next);
+      return true;
+    },
+
+    release(productId, quantity) {
+      if (quantity <= 0) return;
+
+      const next = (stock.get(productId) ?? 0) + quantity;
+      stock.set(productId, next);
+      publish(productId, next);
+    },
+
+    setLowStockThreshold(productId, threshold) {
+      thresholds.set(productId, threshold);
+
+      const current = stock.get(productId);
+      if (current !== undefined) checkLowStock(productId, current);
+    },
+  };
+}
diff --git a/src/notifications/index.ts b/src/notifications/index.ts
new file mode 100644
index 0000000..cf51e49
--- /dev/null
+++ b/src/notifications/index.ts
@@ -0,0 +1,77 @@
+import { EventBus } from '../bus.js';
+import {
+  Events,
+  NotificationSentEvent,
+  NotificationService,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+  PaymentStatus,
+} from '../types.js';
+
+interface Notification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+/**
+ * User-facing notifications. Orders carry the only userId the bus ever
+ * publishes, so `order:created` is used to learn which user owns an order;
+ * later order and payment events are routed through that mapping.
+ */
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const inboxes = new Map<string, Notification[]>();
+  const orderOwners = new Map<string, string>();
+
+  const send = (userId: string, type: string, message: string): void => {
+    if (!subscribers.has(userId)) return;
+
+    const inbox = inboxes.get(userId);
+    if (inbox) {
+      inbox.push({ type, message, timestamp: Date.now() });
+    } else {
+      inboxes.set(userId, [{ type, message, timestamp: Date.now() }]);
+    }
+
+    const event: NotificationSentEvent = { userId, type, message };
+    void bus.emit(Events.NOTIFICATION_SENT, event);
+  };
+
+  bus.on(Events.ORDER_CREATED, payload => {
+    const event = payload as OrderCreatedEvent;
+    orderOwners.set(event.orderId, event.userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, payload => {
+    const event = payload as OrderStatusChangedEvent;
+    const userId = orderOwners.get(event.orderId);
+    if (userId === undefined) return;
+
+    send(userId, 'order_status', `Order ${event.orderId} is now ${event.status}`);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, payload => {
+    const event = payload as PaymentProcessedEvent;
+    const userId = orderOwners.get(event.orderId);
+    if (userId === undefined) return;
+
+    const message =
+      event.status === PaymentStatus.SUCCESS
+        ? `Payment for order ${event.orderId} was successful`
+        : `Payment for order ${event.orderId} did not go through (${event.status})`;
+    send(userId, 'payment', message);
+  });
+
+  return {
+    subscribe(userId) {
+      subscribers.add(userId);
+      if (!inboxes.has(userId)) inboxes.set(userId, []);
+    },
+
+    getNotifications(userId) {
+      return (inboxes.get(userId) ?? []).map(notification => ({ ...notification }));
+    },
+  };
+}
diff --git a/src/orders/index.ts b/src/orders/index.ts
new file mode 100644
index 0000000..39c3bbc
--- /dev/null
+++ b/src/orders/index.ts
@@ -0,0 +1,66 @@
+import { EventBus } from '../bus.js';
+import { Events, OrderCreatedEvent, OrderService, OrderStatus, OrderStatusChangedEvent } from '../types.js';
+
+interface Order {
+  id: string;
+  userId: string;
+  cartId: string;
+  status: OrderStatus;
+  total: number;
+}
+
+/** PENDING -> CONFIRMED -> SHIPPED -> DELIVERED, with CANCELLED reachable until shipped out. */
+const ALLOWED_TRANSITIONS: Record<OrderStatus, readonly OrderStatus[]> = {
+  [OrderStatus.PENDING]: [OrderStatus.CONFIRMED, OrderStatus.CANCELLED],
+  [OrderStatus.CONFIRMED]: [OrderStatus.SHIPPED, OrderStatus.CANCELLED],
+  [OrderStatus.SHIPPED]: [OrderStatus.DELIVERED, OrderStatus.CANCELLED],
+  [OrderStatus.DELIVERED]: [],
+  [OrderStatus.CANCELLED]: [],
+};
+
+/**
+ * Order lifecycle. Orders start PENDING; only transitions permitted by the
+ * state machine take effect, and each one is published as an event.
+ */
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, Order>();
+  let nextId = 1;
+
+  return {
+    createOrder(userId, cartId, total) {
+      const id = `order_${nextId++}`;
+      orders.set(id, { id, userId, cartId, status: OrderStatus.PENDING, total });
+
+      const event: OrderCreatedEvent = { orderId: id, userId, cartId, total };
+      void bus.emit(Events.ORDER_CREATED, event);
+
+      return id;
+    },
+
+    getOrder(orderId) {
+      const order = orders.get(orderId);
+      if (!order) return null;
+
+      return { id: order.id, userId: order.userId, status: order.status, total: order.total };
+    },
+
+    updateStatus(orderId, status) {
+      const order = orders.get(orderId);
+      if (!order) return;
+
+      const previousStatus = order.status;
+      if (!ALLOWED_TRANSITIONS[previousStatus].includes(status)) return;
+
+      order.status = status;
+
+      const event: OrderStatusChangedEvent = { orderId, status, previousStatus };
+      void bus.emit(Events.ORDER_STATUS_CHANGED, event);
+    },
+
+    listOrders(userId) {
+      return [...orders.values()]
+        .filter(order => order.userId === userId)
+        .map(order => ({ id: order.id, status: order.status, total: order.total }));
+    },
+  };
+}
diff --git a/src/payment/index.ts b/src/payment/index.ts
new file mode 100644
index 0000000..a17834d
--- /dev/null
+++ b/src/payment/index.ts
@@ -0,0 +1,70 @@
+import { EventBus } from '../bus.js';
+import { Events, PaymentProcessedEvent, PaymentService, PaymentStatus } from '../types.js';
+
+export interface PaymentServiceOptions {
+  /** Force every charge to be declined. */
+  simulateFailure?: boolean;
+  /** Force every charge to time out. Takes precedence over `simulateFailure`. */
+  simulateTimeout?: boolean;
+  /** Latency of the simulated gateway round-trip, in milliseconds. */
+  delayMs?: number;
+}
+
+interface Transaction {
+  transactionId: string;
+  orderId: string;
+  amount: number;
+  refunded: boolean;
+}
+
+type PaymentResult = { status: PaymentStatus; transactionId?: string; error?: string };
+
+const delay = (ms: number): Promise<void> =>
+  new Promise(resolve => {
+    setTimeout(resolve, ms);
+  });
+
+/**
+ * Payment gateway stand-in. The outcome is driven by `options` so callers can
+ * exercise the success, decline, and timeout paths deterministically.
+ */
+export function createPaymentService(bus: EventBus, options: PaymentServiceOptions = {}): PaymentService {
+  const { simulateFailure = false, simulateTimeout = false, delayMs = 0 } = options;
+  const transactions = new Map<string, Transaction>();
+  let nextId = 1;
+
+  const charge = (orderId: string, amount: number): PaymentResult => {
+    if (simulateTimeout) {
+      return { status: PaymentStatus.TIMEOUT, error: `Payment gateway timed out for order ${orderId}` };
+    }
+    if (simulateFailure) {
+      return { status: PaymentStatus.FAILED, error: `Payment declined for order ${orderId}` };
+    }
+
+    const transactionId = `txn_${nextId++}`;
+    transactions.set(transactionId, { transactionId, orderId, amount, refunded: false });
+    return { status: PaymentStatus.SUCCESS, transactionId };
+  };
+
+  return {
+    async processPayment(orderId, amount) {
+      await delay(delayMs);
+
+      const result = charge(orderId, amount);
+
+      const event: PaymentProcessedEvent = { orderId, ...result };
+      await bus.emit(Events.PAYMENT_PROCESSED, event);
+
+      return result;
+    },
+
+    async refund(transactionId) {
+      const transaction = transactions.get(transactionId);
+      if (!transaction || transaction.refunded) return false;
+
+      await delay(delayMs);
+      transaction.refunded = true;
+      return true;
+    },
+  };
+}
diff --git a/src/pricing/index.ts b/src/pricing/index.ts
new file mode 100644
index 0000000..8714b4e
--- /dev/null
+++ b/src/pricing/index.ts
@@ -0,0 +1,46 @@
+import { EventBus } from '../bus.js';
+import { Events, PricingService, ProductCreatedEvent } from '../types.js';
+
+const TAX_RATE = 0.1;
+
+/** Money is kept to cents; float noise from percentage maths is rounded away. */
+function round2(value: number): number {
+  return Math.round(value * 100) / 100;
+}
+
+/**
+ * Price calculation. Discounts apply to the subtotal, and tax is charged on
+ * the discounted amount. Product prices are learned from `product:created`.
+ */
+export function createPricingService(bus: EventBus): PricingService {
+  const prices = new Map<string, number>();
+  const discountCodes = new Map<string, number>();
+
+  bus.on(Events.PRODUCT_CREATED, payload => {
+    const event = payload as ProductCreatedEvent;
+    prices.set(event.productId, event.price);
+  });
+
+  return {
+    calculateTotal(items, discountCode) {
+      const subtotal = round2(items.reduce((sum, item) => sum + item.price * item.quantity, 0));
+
+      const percentage = discountCode === undefined ? undefined : discountCodes.get(discountCode.toUpperCase());
+      const discount = percentage === undefined ? 0 : round2(subtotal * (percentage / 100));
+
+      const taxable = round2(subtotal - discount);
+      const tax = round2(taxable * TAX_RATE);
+      const total = round2(taxable + tax);
+
+      return { subtotal, discount, tax, total };
+    },
+
+    addDiscountCode(code, percentage) {
+      discountCodes.set(code.toUpperCase(), percentage);
+    },
+
+    getPrice(productId) {
+      return prices.get(productId) ?? 0;
+    },
+  };
+}
