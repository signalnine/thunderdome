+/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ *
+ * Every beam advances exactly one row per step, so the space of beam states
+ * forms a layered DAG: a beam can never revisit a row and cycles are
+ * impossible. Both exported functions exploit that by sweeping the grid one
+ * row at a time instead of simulating beams individually.
+ */
+
+const SOURCE = 'S';
+const SPLITTER = '^';
+
+/** A direction is the column delta applied on each downward step. */
+const DIR_LEFT = -1;
+const DIR_DOWN = 0;
+const DIR_RIGHT = 1;
+
+/**
+ * A beam state within a row is `(col, dir)`, encoded as a single integer so it
+ * can key a Set/Map by primitive identity.
+ */
+const encode = (col: number, dir: number): number => col * 3 + dir + 1;
+const colOf = (code: number): number => Math.floor(code / 3);
+const dirOf = (code: number): number => (code % 3) - 1;
+
+interface Traversal {
+  /** Length of each row, so ragged grids stay in bounds. */
+  rowLens: number[];
+  /** `states[r]` holds every distinct beam state occupying row `r`. */
+  states: Set<number>[];
+  /** Where each source beam enters, as `{ row, code }`. */
+  sources: { row: number; code: number }[];
+}
+
+/**
+ * Sweeps top to bottom, propagating the set of distinct beam states into each
+ * successive row. Deduplicating by state is what keeps this linear in the grid
+ * size even when the number of distinct paths is astronomical.
+ */
+function traverse(grid: string[][]): Traversal {
+  const rows = grid.length;
+  const rowLens = grid.map((row) => (row ? row.length : 0));
+  const states: Set<number>[] = [];
+  for (let r = 0; r <= rows; r++) states.push(new Set<number>());
+  const sources: { row: number; code: number }[] = [];
+
+  for (let r = 0; r < rows; r++) {
+    const row = grid[r];
+    const layer = states[r];
+
+    // Sources emit straight down from wherever they sit.
+    for (let c = 0; c < rowLens[r]; c++) {
+      if (row[c] === SOURCE) {
+        const code = encode(c, DIR_DOWN);
+        layer.add(code);
+        sources.push({ row: r, code });
+      }
+    }
+
+    const next = states[r + 1];
+    const emit = (col: number, dir: number): void => {
+      // Beams leaving the grid are absorbed and simply drop out of the sweep.
+      if (r + 1 < rows && col >= 0 && col < rowLens[r + 1]) {
+        next.add(encode(col, dir));
+      }
+    };
+
+    for (const code of layer) {
+      const c = colOf(code);
+      if (row[c] === SPLITTER) {
+        // The splitter consumes the incoming beam regardless of its direction.
+        emit(c - 1, DIR_LEFT);
+        emit(c + 1, DIR_RIGHT);
+      } else {
+        const dir = dirOf(code);
+        emit(c + dir, dir);
+      }
+    }
+  }
+
+  return { rowLens, states, sources };
+}
+
+/**
+ * Counts distinct cells visited by any beam. A cell visited by several beams,
+ * or by one beam in several directions, still counts once.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const { states } = traverse(grid);
+  let total = 0;
+  for (const layer of states) {
+    // Collapse the (col, dir) states of a row down to distinct columns.
+    const cols = new Set<number>();
+    for (const code of layer) cols.add(colOf(code));
+    total += cols.size;
+  }
+  return total;
+}
+
+/**
+ * Counts distinct source-to-exit paths.
+ *
+ * Enumerating paths is infeasible (K splitters yield up to 2^K of them), so
+ * this instead counts them with a bottom-up DP over the layered DAG: the paths
+ * leaving a state are the sum of the paths leaving its successors, and a
+ * successor outside the grid terminates exactly one path.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const { rowLens, states, sources } = traverse(grid);
+  if (sources.length === 0) return 0n;
+
+  const rows = grid.length;
+  /** `paths[r].get(code)` = number of paths that exit, starting from that state. */
+  const paths: Map<number, bigint>[] = new Array(rows + 1);
+  paths[rows] = new Map<number, bigint>();
+
+  for (let r = rows - 1; r >= 0; r--) {
+    const row = grid[r];
+    const below = paths[r + 1];
+    const here = new Map<number, bigint>();
+
+    const pathsAfter = (col: number, dir: number): bigint => {
+      if (r + 1 >= rows || col < 0 || col >= rowLens[r + 1]) return 1n; // absorbed: one path ends
+      return below.get(encode(col, dir)) ?? 0n;
+    };
+
+    for (const code of states[r]) {
+      const c = colOf(code);
+      if (row[c] === SPLITTER) {
+        here.set(code, pathsAfter(c - 1, DIR_LEFT) + pathsAfter(c + 1, DIR_RIGHT));
+      } else {
+        const dir = dirOf(code);
+        here.set(code, pathsAfter(c + dir, dir));
+      }
+    }
+    paths[r] = here;
+  }
+
+  let total = 0n;
+  for (const { row, code } of sources) total += paths[row].get(code) ?? 0n;
+  return total;
+}
