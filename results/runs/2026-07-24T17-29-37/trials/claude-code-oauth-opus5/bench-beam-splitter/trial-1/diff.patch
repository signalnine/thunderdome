+import { describe, expect, it } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index.js';
+
+const g = (...rows: string[]): string[][] => rows.map((row) => row.split(''));
+
+describe('spec examples', () => {
+  const single = g('.S...', '.....', '.^...', '.....');
+  const double = g('.S...', '.^...', '^.^..', '.....');
+
+  it('counts cells for the single-splitter example', () => {
+    expect(countBeamCells(single)).toBe(5);
+  });
+
+  it('counts paths for the single-splitter example', () => {
+    expect(countBeamPaths(single)).toBe(2n);
+  });
+
+  it('merges cells shared by two beams', () => {
+    // Both beams land on (3,1), which must be counted once.
+    expect(countBeamCells(double)).toBe(6);
+  });
+
+  it('counts absorbed branches as completed paths', () => {
+    // The (3,-1) branch exits the left edge but is still a path.
+    expect(countBeamPaths(double)).toBe(4n);
+  });
+});
+
+describe('basic propagation', () => {
+  it('walks straight down with no splitters', () => {
+    const grid = g('.S.', '...', '...');
+    expect(countBeamCells(grid)).toBe(3);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('handles a source on the bottom row', () => {
+    expect(countBeamCells(g('S'))).toBe(1);
+    expect(countBeamPaths(g('S'))).toBe(1n);
+  });
+
+  it('splits immediately below the source', () => {
+    const grid = g('.S.', '.^.', '...');
+    expect(countBeamCells(grid)).toBe(4);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('absorbs both branches of a splitter in a one-column grid', () => {
+    const grid = g('S', '^', '.');
+    expect(countBeamCells(grid)).toBe(2);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('splits on a diagonal beam, not just a downward one', () => {
+    // (1,1) splits into (2,0) and (2,2); the down-right branch reaches the
+    // splitter at (2,2) and must split again, while (2,0) exits the left edge.
+    const grid = g('.S...', '.^...', '..^..', '.....');
+    expect(countBeamPaths(grid)).toBe(3n);
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('returns nothing for a grid with no source', () => {
+    expect(countBeamCells(g('...', '.^.'))).toBe(0);
+    expect(countBeamPaths(g('...', '.^.'))).toBe(0n);
+  });
+
+  it('handles empty grids', () => {
+    expect(countBeamCells([])).toBe(0);
+    expect(countBeamPaths([])).toBe(0n);
+  });
+});
+
+describe('path counting', () => {
+  it('adds one exit per splitter along a diagonal chain', () => {
+    // Splitters on a down-left diagonal: each one's left branch feeds the next
+    // splitter while its right branch escapes, so K splitters give K+1 paths.
+    const size = 20;
+    const chain = 7;
+    const rows: string[][] = [];
+    for (let r = 0; r < size; r++) rows.push(new Array<string>(size).fill('.'));
+    rows[0][10] = 'S';
+    for (let r = 1; r <= chain; r++) rows[r][11 - r] = '^';
+    expect(countBeamPaths(rows)).toBe(BigInt(chain + 1));
+  });
+
+  it('counts paths that reconverge on the same cell separately', () => {
+    // The (2,1) and (2,3) splitters both send a branch into (3,2): one cell,
+    // but two distinct paths.
+    const grid = g('..S..', '..^..', '.^.^.', '.....');
+    expect(countBeamPaths(grid)).toBe(4n);
+    expect(countBeamCells(grid)).toBe(7);
+  });
+});
+
+const SIZE = 200;
+
+/** A 200x200 grid of '.' with a source at the top of the middle column. */
+const blankGrid = (): string[][] => {
+  const rows: string[][] = [];
+  for (let r = 0; r < SIZE; r++) rows.push(new Array<string>(SIZE).fill('.'));
+  rows[0][100] = 'S';
+  return rows;
+};
+
+describe('performance', () => {
+  it('handles a 200x200 grid with ~50 splitters in under 5s', () => {
+    // A Pascal-triangle fan: every branch lands on the next row's splitter, so
+    // all 45 splitters are live rather than being missed by the beams.
+    const grid = blankGrid();
+    const depth = 9;
+    let splitters = 0;
+    for (let r = 1; r <= depth; r++) {
+      for (let k = -(r - 1); k <= r - 1; k += 2) {
+        grid[r][100 + k] = '^';
+        splitters++;
+      }
+    }
+    expect(splitters).toBe(45);
+
+    const start = performance.now();
+    const cells = countBeamCells(grid);
+    const paths = countBeamPaths(grid);
+    const elapsed = performance.now() - start;
+
+    // Each of the 9 splitter rows doubles every surviving branch.
+    expect(paths).toBe(2n ** BigInt(depth));
+    expect(cells).toBeGreaterThan(0);
+    expect(elapsed).toBeLessThan(5000);
+  });
+
+  it('stays fast when the path count is astronomically large', () => {
+    // Far past the spec's 50 splitters: a solid field of them, so the beam
+    // doubles on essentially every row. Any implementation that walked
+    // individual paths would never finish this.
+    const grid = blankGrid();
+    for (let r = 1; r < SIZE; r++) {
+      for (let c = 0; c < SIZE; c++) grid[r][c] = '^';
+    }
+
+    const start = performance.now();
+    const cells = countBeamCells(grid);
+    const paths = countBeamPaths(grid);
+    const elapsed = performance.now() - start;
+
+    expect(paths).toBeGreaterThan(10n ** 30n);
+    expect(cells).toBeGreaterThan(1000);
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
