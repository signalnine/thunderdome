string[][] => {\n    const size = 200;\n    const rows: string[][] = [];\n    for (let r = 0; r < size; r++) rows.push(new Array<string>(size).fill('.'));\n    rows[0][100] = 'S';\n    for (let i = 0; i < count; i++) {\n      const r = 1 + i * 3;\n      for (let c = 100 - i * 2; c <= 100 + i * 2; c += 2) {\n        if (c >= 0 && c < size) rows[r][c] = '^';\n      }\n    }\n    return rows;\n  };\n\n  it('handles a 200x200 grid with 50 splitter rows in under 5s', () => {\n    const grid = bigGrid(50);\n    const start = performance.now();\n    const cells = countBeamCells(grid);\n    const paths = countBeamPaths(grid);\n    const elapsed = performance.now() - start;\n\n    expect(cells).toBeGreaterThan(0);\n    // Far beyond what path enumeration could ever walk.\n    expect(paths).toBeGreaterThan(10n ** 15n);\n    expect(elapsed).toBeLessThan(5000);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
