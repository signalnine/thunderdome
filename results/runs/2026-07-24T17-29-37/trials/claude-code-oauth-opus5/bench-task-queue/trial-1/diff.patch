ping for one named queue. */\ninterface QueueRecord {\n  name: string;\n  /** Tasks waiting to be dequeued (may be delayed or blocked by dependencies). */\n  pending: Task[];\n  /** Ids of tasks currently in `processing` status. */\n  processing: Set<string>;\n  /** Tasks that exhausted their retries. */\n  dlq: Task[];\n  concurrency: number;\n  middleware: Middleware[];\n}\n\nexport class TaskQueue {\n  private queues = new Map<string, QueueRecord>();\n  /** Every task ever created, by id. */\n  private tasks = new Map<string, Task>();\n  /** Monotonic counter used as the FIFO tiebreaker. */\n  private sequence = 0;\n  private order = new Map<string, number>();\n\n  private progress = new Map<string, TaskProgress>();\n  private progressListeners = new Map<string, Set<ProgressCallback>>();\n\n  private schedules = new Map<string, Schedule>();\n\n  private shuttingDown = false;\n  private shutdownPromise: Promise<ShutdownSummary> | null = null;\n  private shutdownResolve: ((summary: ShutdownSummary) => void) | null = null;\n  private shutdownTimer: ReturnType<typeof setTimeout> | null = null;\n  private shutdownStartedAt = 0;\n  private shutdownSettled = false;\n  private shutdownCompleted = 0;\n  private shutdownCancelled = 0;\n  private shutdownCallbacks: ShutdownCallback[] = [];\n\n  // ---------------------------------------------------------------------\n  // Queue plumbing\n  // ---------------------------------------------------------------------\n\n  private getOrCreateQueue(name: string): QueueRecord {\n    let queue = this.queues.get(name);\n    if (!queue) {\n      queue = {\n        name,\n        pending: [],\n        processing: new Set<string>(),\n        dlq: [],\n        concurrency: Infinity,\n        middleware: [],\n      };\n      this.queues.set(name, queue);\n    }\n    return queue;\n  }\n\n  listQueues(): string[] {\n    return [...this.queues.keys()];\n  }\n\n  /** Pending tasks in a single queue, or across every queue when omitted. */\n  s