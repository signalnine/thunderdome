n      maxRetries: options.maxRetries ?? DEFAULT_MAX_RETRIES,\n      backoffMs: options.backoffMs ?? DEFAULT_BACKOFF_MS,\n      dependsOn,\n      failCount: 0,\n    };\n\n    this.tasks.set(task.id, task);\n    this.order.set(task.id, this.sequence++);\n    this.getOrCreateQueue(queueName).pending.push(task);\n    return task;\n  }\n\n  dequeue(queueName: string = DEFAULT_QUEUE): Task | null {\n    if (this.shuttingDown) return null;\n\n    const queue = this.queues.get(queueName);\n    if (!queue) return null;\n    if (queue.processing.size >= queue.concurrency) return null;\n\n    const now = Date.now();\n    let best: Task | null = null;\n    let bestIndex = -1;\n\n    for (let i = 0; i < queue.pending.length; i++) {\n      const task = queue.pending[i];\n      if (task.status !== 'pending') continue;\n      if (task.availableAt.getTime() > now) continue;\n      if (!this.dependenciesSatisfied(task)) continue;\n      if (best === null || this.compare(task, best) < 0) {\n        best = task;\n        bestIndex = i;\n      }\n    }\n\n    if (best === null) return null;\n\n    queue.pending.splice(bestIndex, 1);\n    best.status = 'processing';\n    best.attempts += 1;\n    queue.processing.add(best.id);\n    return best;\n  }\n\n  /**\n   * Dequeue ordering: priority first (1 = highest), then availability time so\n   * scheduled work runs in the order it becomes due, then FIFO by enqueue order.\n   */\n  private compare(a: Task, b: Task): number {\n    if (a.priority !== b.priority) return a.priority - b.priority;\n    const availA = a.availableAt.getTime();\n    const availB = b.availableAt.getTime();\n    if (availA !== availB) return availA - availB;\n    return (this.order.get(a.id) ?? 0) - (this.order.get(b.id) ?? 0);\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 7: dependencies\n  // ---------------------------------------------------------------------\n\n  private dependenciesSatisfied(task: Task): boolean {\n    for (const depId of task.dependsOn) {\n      const dep = this.tasks.get(depId);\n      if (!dep || dep.status !== 'completed') return false;\n    }\n    return true;\n  }\n\n  private validateDependencies(dependsOn: string[], newTaskId: string): void {\n    for (const depId of dependsOn) {\n      if (depId === newTaskId) throw new Error('Circular dependency detected');\n      if (!this.tasks.has(depId)) {\n        throw new Error(`Dependency not found: ${depId}`);\n      }\n    }\n\n    const visiting = new Set<string>();\n    const visited = new Set<string>();\n\n    const visit = (id: string): void => {\n      if (id === newTaskId || visiting.has(id)) {\n        throw new Error('Circular dependency detected');\n      }\n      if (visited.has(id)) return;\n      visiting.add(id);\n      const task = this.tasks.get(id);\n      if (task) for (const depId of task.dependsOn) visit(depId);\n      visiting.delete(id);\n      visited.add(id);\n    };\n\n    for (const depId of dependsOn) visit(depId);\n  }\n\n  getDependencies(taskId: string): DependencyInfo[] {\n    const task = this.tasks.get(taskId);\n    if (!task) return [];\n    return task.dependsOn.map((depId) => ({\n      taskId: depId,\n      status: this.tasks.get(depId)?.status ?? ('pending' as TaskStatus),\n    }));\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 5-6: completion, retry, dead letter queue\n  // ---------------------------------------------------------------------\n\n  complete(taskId: string): Task | null {\n    const task = this.tasks.get(taskId);\n    if (!task || task.status !== 'processing') return null;\n\n    const queue = this.getOrCreateQueue(task.queueName);\n    queue.processing.delete(task.id);\n    task.status = 'completed';\n\n    if (this.shuttingDown) {\n      this.shutdownCompleted += 1;\n      this.maybeFinishShutdown();\n    }\n    return task;\n  }\n\n  fail(taskId: string, error?: unknown): Task | null {\n    const task = this.tasks.get(taskId);\n    if (!task || task.status !== 'processing') return null;\n\n    const queue = this.getOrCreateQueue(task.queueName);\n    queue.processing.delete(task.id);\n    task.failCount += 1;\n    task.lastError = normalizeError(error);\n\n    if (task.attempts <= task.maxRetries) {\n      // Retries remain: re-enqueue behind an exponential backoff window.\n      const delay = task.backoffMs * Math.pow(2, Math.max(0, task.attempts - 1));\n      task.status = 'pending';\n      task.availableAt = new Date(Date.now() + delay);\n      queue.pending.push(task);\n    } else {\n      task.status = 'failed';\n      queue.dlq.push(task);\n    }\n\n    if (this.shuttingDown) this.maybeFinishShutdown();\n    return task;\n  }\n\n  getDLQ(queueName: string = DEFAULT_QUEUE): Task[] {\n    const queue = this.queues.get(queueName);\n    return queue ? [...queue.dlq] : [];\n  }\n\n  retryDLQ(taskId: string): Task | null {\n    for (const queue of this.queues.values()) {\n      const index = queue.dlq.findIndex((task) => task.id === taskId);\n      if (index === -1) continue;\n\n      const [task] = queue.dlq.splice(index, 1);\n      task.status = 'pending';\n      task.attempts = 0;\n      task.availableAt = new Date(Date.now());\n      queue.pending.push(task);\n      return task;\n    }\n    return null;\n  }\n\n  clearDLQ(queueName: string = DEFAULT_QUEUE): void {\n    const queue = this.queues.get(queueName);\n    if (queue) queue.dlq = [];\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 8: concurrency\n  // ---------------------------------------------------------------------\n\n  setConcurrency(queueName: string, limit: number): void {\n    if (typeof limit !== 'number' || Number.isNaN(limit) || limit < 0) {\n      throw new Error(`Invalid concurrency limit: ${limit}`);\n    }\n    // 0 means \"no limit\", matching getConcurrency's Infinity report.\n    this.getOrCreateQueue(queueName).concurrency = limit === 0 ? Infinity : limit;\n  }\n\n  getConcurrency(queueName: string): ConcurrencyInfo {\n    const queue = this.getOrCreateQueue(queueName);\n    return { current: queue.processing.size, max: queue.concurrency };\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 9: progress and cancellation\n  // ---------------------------------------------------------------------\n\n  updateProgress(taskId: string, percent: number, message?: string): TaskProgress {\n    if (typeof percent !== 'number' || Number.isNaN(percent) || percent < 0 || percent > 100) {\n      throw new Error(`Invalid progress ${percent}: must be between 0 and 100`);\n    }\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task not found: ${taskId}`);\n\n    const info: TaskProgress = { percent, updatedAt: new Date() };\n    if (message !== undefined) info.message = message;\n    this.progress.set(taskId, info);\n\n    const listeners = this.progressListeners.get(taskId);\n    if (listeners) for (const listener of [...listeners]) listener(info);\n    return info;\n  }\n\n  getProgress(taskId: string): TaskProgress | null {\n    return this.progress.get(taskId) ?? null;\n  }\n\n  onProgress(taskId: string, callback: ProgressCallback): () => void {\n    let listeners = this.progressListeners.get(taskId);\n    if (!listeners) {\n      listeners = new Set<ProgressCallback>();\n      this.progressListeners.set(taskId, listeners);\n    }\n    listeners.add(callback);\n    return () => {\n      listeners!.delete(callback);\n    };\n  }\n\n  cancel(taskId: string): Task | null {\n    const task = this.tasks.get(taskId);\n    if (!task) return null;\n    if (task.status !== 'pending' && task.status !== 'processing') return task;\n\n    const queue = this.getOrCreateQueue(task.queueName);\n    const index = queue.pending.indexOf(task);\n    if (index !== -1) queue.pending.splice(index, 1);\n    queue.processing.delete(task.id);\n    task.status = 'cance