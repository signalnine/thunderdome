+/**
+ * Next occurrence strictly after `from` for the supported cron subset:
+ * `*\/N * * * *` (every N minutes), `0 * * * *` (hourly), `0 0 * * *` (daily),
+ * plus fixed `M H * * *` times.
+ */
+function nextCronRun(expression: string, from: number): number {
+  const fields = expression.trim().split(/\s+/);
+  if (fields.length !== 5) {
+    throw new Error(`Unsupported cron expression: ${expression}`);
+  }
+
+  const [minute, hour] = fields;
+
+  if (minute.startsWith('*/')) {
+    const step = Number(minute.slice(2));
+    if (!Number.isFinite(step) || step <= 0) {
+      throw new Error(`Unsupported cron expression: ${expression}`);
+    }
+    const interval = step * MINUTE_MS;
+    return Math.floor(from / interval) * interval + interval;
+  }
+
+  if (minute === '*') return Math.floor(from / MINUTE_MS) * MINUTE_MS + MINUTE_MS;
+
+  const minuteValue = Number(minute);
+  if (!Number.isInteger(minuteValue) || minuteValue < 0 || minuteValue > 59) {
+    throw new Error(`Unsupported cron expression: ${expression}`);
+  }
+
+  if (hour === '*') {
+    const base = Math.floor(from / HOUR_MS) * HOUR_MS + minuteValue * MINUTE_MS;
+    return base > from ? base : base + HOUR_MS;
+  }
+
+  if (hour.startsWith('*/')) {
+    const step = Number(hour.slice(2));
+    if (!Number.isFinite(step) || step <= 0) {
+      throw new Error(`Unsupported cron expression: ${expression}`);
+    }
+    const interval = step * HOUR_MS;
+    const base = Math.floor(from / interval) * interval + minuteValue * MINUTE_MS;
+    return base > from ? base : base + interval;
+  }
+
+  const hourValue = Number(hour);
+  if (!Number.isInteger(hourValue) || hourValue < 0 || hourValue > 23) {
+    throw new Error(`Unsupported cron expression: ${expression}`);
+  }
+
+  const base = Math.floor(from / DAY_MS) * DAY_MS + hourValue * HOUR_MS + minuteValue * MINUTE_MS;
+  return base > from ? base : base + DAY_MS;
+}
