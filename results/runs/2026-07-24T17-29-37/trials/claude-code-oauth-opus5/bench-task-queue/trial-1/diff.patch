+import { randomUUID } from 'node:crypto';
+
+/** Lifecycle states a task can be in. */
+export type TaskStatus =
+  | 'pending'
+  | 'processing'
+  | 'completed'
+  | 'failed'
+  | 'cancelled';
+
+/* eslint-disable @typescript-eslint/no-explicit-any */
+
+export interface Task {
+  id: string;
+  queueName: string;
+  payload: any;
+  status: TaskStatus;
+  priority: number;
+  createdAt: Date;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  dependsOn: string[];
+  failCount: number;
+  lastError?: string;
+}
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: TaskStatus;
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface TaskProgress {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type ProgressCallback = (progress: TaskProgress) => void;
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: any;
+  active: boolean;
+  nextRunAt: Date;
+}
+
+export type Middleware = (
+  task: Task,
+  next: () => Promise<void>,
+) => Promise<void> | void;
+
+export type TaskHandler = (task: Task) => Promise<void> | void;
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+export type ShutdownCallback = () => void;
+
+const DEFAULT_QUEUE = 'default';
+const DEFAULT_PRIORITY = 5;
+const DEFAULT_MAX_RETRIES = 3;
+const DEFAULT_BACKOFF_MS = 1000;
+const DEFAULT_SHUTDOWN_TIMEOUT = 30000;
+
+/** Internal bookkeeping for one named queue. */
+interface QueueRecord {
+  name: string;
+  /** Tasks waiting to be dequeued (may be delayed or blocked by dependencies). */
+  pending: Task[];
+  /** Ids of tasks currently in `processing` status. */
+  processing: Set<string>;
+  /** Tasks that exhausted their retries. */
+  dlq: Task[];
+  concurrency: number;
+  middleware: Middleware[];
+}
+
+export class TaskQueue {
+  private queues = new Map<string, QueueRecord>();
+  /** Every task ever created, by id. */
+  private tasks = new Map<string, Task>();
+  /** Monotonic counter used as the FIFO tiebreaker. */
+  private sequence = 0;
+  private order = new Map<string, number>();
+
+  private progress = new Map<string, TaskProgress>();
+  private progressListeners = new Map<string, Set<ProgressCallback>>();
+
+  private schedules = new Map<string, Schedule>();
+
+  private shuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private shutdownResolve: ((summary: ShutdownSummary) => void) | null = null;
+  private shutdownTimer: ReturnType<typeof setTimeout> | null = null;
+  private shutdownStartedAt = 0;
+  private shutdownSettled = false;
+  private shutdownCompleted = 0;
+  private shutdownCancelled = 0;
+  private shutdownCallbacks: ShutdownCallback[] = [];
+
+  // ---------------------------------------------------------------------
+  // Queue plumbing
+  // ---------------------------------------------------------------------
+
+  private getOrCreateQueue(name: string): QueueRecord {
+    let queue = this.queues.get(name);
+    if (!queue) {
+      queue = {
+        name,
+        pending: [],
+        processing: new Set<string>(),
+        dlq: [],
+        concurrency: Infinity,
+        middleware: [],
+      };
+      this.queues.set(name, queue);
+    }
+    return queue;
+  }
+
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  /** Pending tasks in a single queue, or across every queue when omitted. */
+  size(queueName?: string): number {
+    if (queueName !== undefined) return this.queueSize(queueName);
+    let total = 0;
+    for (const queue of this.queues.values()) total += queue.pending.length;
+    return total;
+  }
+
+  queueSize(queueName: string = DEFAULT_QUEUE): number {
+    const queue = this.queues.get(queueName);
+    return queue ? queue.pending.length : 0;
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 1-7: enqueue / dequeue
+  // ---------------------------------------------------------------------
+
+  /**
+   * `enqueue(payload)` targets the default queue; `enqueue(name, payload, opts)`
+   * targets a named one.
+   */
+  enqueue(queueNameOrPayload?: any, payload?: any, options: EnqueueOptions = {}): Task {
+    if (this.shuttingDown) {
+      throw new Error('TaskQueue is shutting down; cannot enqueue new tasks');
+    }
+
+    let queueName = DEFAULT_QUEUE;
+    let taskPayload = queueNameOrPayload;
+    if (typeof queueNameOrPayload === 'string') {
+      queueName = queueNameOrPayload;
+      taskPayload = payload;
+    }
+
+    const priority = options.priority ?? DEFAULT_PRIORITY;
+    if (typeof priority !== 'number' || !Number.isFinite(priority) || priority < 1 || priority > 10) {
+      throw new Error(`Invalid priority ${priority}: must be a number between 1 and 10`);
+    }
+
+    const dependsOn = options.dependsOn ? [...options.dependsOn] : [];
+    const id = randomUUID();
+    if (dependsOn.length > 0) this.validateDependencies(dependsOn, id);
+
+    const now = Date.now();
+    let availableAt = now;
+    if (options.runAt instanceof Date) availableAt = options.runAt.getTime();
+    else if (typeof options.delay === 'number') availableAt = now + options.delay;
+
+    const task: Task = {
+      id,
+      queueName,
+      payload: taskPayload,
+      status: 'pending',
+      priority,
+      createdAt: new Date(now),
+      availableAt: new Date(availableAt),
+      attempts: 0,
+      maxRetries: options.maxRetries ?? DEFAULT_MAX_RETRIES,
+      backoffMs: options.backoffMs ?? DEFAULT_BACKOFF_MS,
+      dependsOn,
+      failCount: 0,
+    };
+
+    this.tasks.set(task.id, task);
+    this.order.set(task.id, this.sequence++);
+    this.getOrCreateQueue(queueName).pending.push(task);
+    return task;
+  }
+
+  dequeue(queueName: string = DEFAULT_QUEUE): Task | null {
+    if (this.shuttingDown) return null;
+
+    const queue = this.queues.get(queueName);
+    if (!queue) return null;
+    if (queue.processing.size >= queue.concurrency) return null;
+
+    const now = Date.now();
+    let best: Task | null = null;
+    let bestIndex = -1;
+
+    for (let i = 0; i < queue.pending.length; i++) {
+      const task = queue.pending[i];
+      if (task.status !== 'pending') continue;
+      if (task.availableAt.getTime() > now) continue;
+      if (!this.dependenciesSatisfied(task)) continue;
+      if (best === null || this.compare(task, best) < 0) {
+        best = task;
+        bestIndex = i;
+      }
+    }
+
+    if (best === null) return null;
+
+    queue.pending.splice(bestIndex, 1);
+    best.status = 'processing';
+    best.attempts += 1;
+    queue.processing.add(best.id);
+    return best;
+  }
+
+  /**
+   * Dequeue ordering: priority first (1 = highest), then availability time so
+   * scheduled work runs in the order it becomes due, then FIFO by enqueue order.
+   */
+  private compare(a: Task, b: Task): number {
+    if (a.priority !== b.priority) return a.priority - b.priority;
+    const availA = a.availableAt.getTime();
+    const availB = b.availableAt.getTime();
+    if (availA !== availB) return availA - availB;
+    return (this.order.get(a.id) ?? 0) - (this.order.get(b.id) ?? 0);
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 7: dependencies
+  // ---------------------------------------------------------------------
+
+  private dependenciesSatisfied(task: Task): boolean {
+    for (const depId of task.dependsOn) {
+      const dep = this.tasks.get(depId);
+      if (!dep || dep.status !== 'completed') return false;
+    }
+    return true;
+  }
+
+  private validateDependencies(dependsOn: string[], newTaskId: string): void {
+    for (const depId of dependsOn) {
+      if (depId === newTaskId) throw new Error('Circular dependency detected');
+      if (!this.tasks.has(depId)) {
+        throw new Error(`Dependency not found: ${depId}`);
+      }
+    }
+
+    const visiting = new Set<string>();
+    const visited = new Set<string>();
+
+    const visit = (id: string): void => {
+      if (id === newTaskId || visiting.has(id)) {
+        throw new Error('Circular dependency detected');
+      }
+      if (visited.has(id)) return;
+      visiting.add(id);
+      const task = this.tasks.get(id);
+      if (task) for (const depId of task.dependsOn) visit(depId);
+      visiting.delete(id);
+      visited.add(id);
+    };
+
+    for (const depId of dependsOn) visit(depId);
+  }
+
+  getDependencies(taskId: string): DependencyInfo[] {
+    const task = this.tasks.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map((depId) => ({
+      taskId: depId,
+      status: this.tasks.get(depId)?.status ?? ('pending' as TaskStatus),
+    }));
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 5-6: completion, retry, dead letter queue
+  // ---------------------------------------------------------------------
+
+  complete(taskId: string): Task | null {
+    const task = this.tasks.get(taskId);
+    if (!task || task.status !== 'processing') return null;
+
+    const queue = this.getOrCreateQueue(task.queueName);
+    queue.processing.delete(task.id);
+    task.status = 'completed';
+
+    if (this.shuttingDown) {
+      this.shutdownCompleted += 1;
+      this.maybeFinishShutdown();
+    }
+    return task;
+  }
+
+  fail(taskId: string, error?: unknown): Task | null {
+    const task = this.tasks.get(taskId);
+    if (!task || task.status !== 'processing') return null;
+
+    const queue = this.getOrCreateQueue(task.queueName);
+    queue.processing.delete(task.id);
+    task.failCount += 1;
+    task.lastError = normalizeError(error);
+
+    if (task.attempts <= task.maxRetries) {
+      // Retries remain: re-enqueue behind an exponential backoff window.
+      const delay = task.backoffMs * Math.pow(2, Math.max(0, task.attempts - 1));
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + delay);
+      queue.pending.push(task);
+    } else {
+      task.status = 'failed';
+      queue.dlq.push(task);
+    }
+
+    if (this.shuttingDown) this.maybeFinishShutdown();
+    return task;
+  }
+
+  getDLQ(queueName: string = DEFAULT_QUEUE): Task[] {
+    const queue = this.queues.get(queueName);
+    return queue ? [...queue.dlq] : [];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    for (const queue of this.queues.values()) {
+      const index = queue.dlq.findIndex((task) => task.id === taskId);
+      if (index === -1) continue;
+
+      const [task] = queue.dlq.splice(index, 1);
+      task.status = 'pending';
+      task.attempts = 0;
+      task.availableAt = new Date(Date.now());
+      queue.pending.push(task);
+      return task;
+    }
+    return null;
+  }
+
+  clearDLQ(queueName: string = DEFAULT_QUEUE): void {
+    const queue = this.queues.get(queueName);
+    if (queue) queue.dlq = [];
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 8: concurrency
+  // ---------------------------------------------------------------------
+
+  setConcurrency(queueName: string, limit: number): void {
+    if (typeof limit !== 'number' || Number.isNaN(limit) || limit < 0) {
+      throw new Error(`Invalid concurrency limit: ${limit}`);
+    }
+    // 0 means "no limit", matching getConcurrency's Infinity report.
+    this.getOrCreateQueue(queueName).concurrency = limit === 0 ? Infinity : limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const queue = this.getOrCreateQueue(queueName);
+    return { current: queue.processing.size, max: queue.concurrency };
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 9: progress and cancellation
+  // ---------------------------------------------------------------------
+
+  updateProgress(taskId: string, percent: number, message?: string): TaskProgress {
+    if (typeof percent !== 'number' || Number.isNaN(percent) || percent < 0 || percent > 100) {
+      throw new Error(`Invalid progress ${percent}: must be between 0 and 100`);
+    }
+    const task = this.tasks.get(taskId);
+    if (!task) throw new Error(`Task not found: ${taskId}`);
+
+    const info: TaskProgress = { percent, updatedAt: new Date() };
+    if (message !== undefined) info.message = message;
+    this.progress.set(taskId, info);
+
+    const listeners = this.progressListeners.get(taskId);
+    if (listeners) for (const listener of [...listeners]) listener(info);
+    return info;
+  }
+
+  getProgress(taskId: string): TaskProgress | null {
+    return this.progress.get(taskId) ?? null;
+  }
+
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    let listeners = this.progressListeners.get(taskId);
+    if (!listeners) {
+      listeners = new Set<ProgressCallback>();
+      this.progressListeners.set(taskId, listeners);
+    }
+    listeners.add(callback);
+    return () => {
+      listeners!.delete(callback);
+    };
+  }
+
+  cancel(taskId: string): Task | null {
+    const task = this.tasks.get(taskId);
+    if (!task) return null;
+    if (task.status !== 'pending' && task.status !== 'processing') return task;
+
+    const queue = this.getOrCreateQueue(task.queueName);
+    const index = queue.pending.indexOf(task);
+    if (index !== -1) queue.pending.splice(index, 1);
+    queue.processing.delete(task.id);
+    task.status = 'cancelled';
+
+    if (this.shuttingDown) this.maybeFinishShutdown();
+    return task;
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 10: recurring schedules
+  // ---------------------------------------------------------------------
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: any): Schedule {
+    const now = Date.now();
+    const record: Schedule = {
+      id: randomUUID(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+      nextRunAt: new Date(nextCronRun(cronExpression, now)),
+    };
+    this.schedules.set(record.id, record);
+    return record;
+  }
+
+  unschedule(scheduleId: string): boolean {
+    const record = this.schedules.get(scheduleId);
+    if (!record) return false;
+    record.active = false;
+    return true;
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    return [...this.schedules.values()].filter(
+      (record) => record.active && (queueName === undefined || record.queueName === queueName),
+    );
+  }
+
+  /** Enqueue a task for every active schedule whose next run is due. */
+  tick(): Task[] {
+    const now = Date.now();
+    const triggered: Task[] = [];
+
+    for (const record of this.schedules.values()) {
+      if (!record.active) continue;
+      if (record.nextRunAt.getTime() > now) continue;
+
+      record.nextRunAt = new Date(nextCronRun(record.cronExpression, now));
+      if (this.shuttingDown) continue;
+      triggered.push(this.enqueue(record.queueName, clonePayload(record.taskTemplate)));
+    }
+    return triggered;
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 11: middleware pipeline
+  // ---------------------------------------------------------------------
+
+  use(queueName: string, middleware: Middleware): this {
+    this.getOrCreateQueue(queueName).middleware.push(middleware);
+    return this;
+  }
+
+  /** Drain a queue, running each task through its middleware then the handler. */
+  async process(queueName: string, handler: TaskHandler): Promise<void> {
+    const queue = this.getOrCreateQueue(queueName);
+
+    let task = this.dequeue(queueName);
+    while (task !== null) {
+      await this.runPipeline(queue, task, handler);
+      task = this.dequeue(queueName);
+    }
+  }
+
+  private async runPipeline(queue: QueueRecord, task: Task, handler: TaskHandler): Promise<void> {
+    const middleware = [...queue.middleware];
+
+    const dispatch = async (index: number): Promise<void> => {
+      if (index < middleware.length) {
+        await middleware[index](task, () => dispatch(index + 1));
+        return;
+      }
+      await handler(task);
+    };
+
+    try {
+      await dispatch(0);
