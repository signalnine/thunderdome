t refError = (detail = 'invalid reference'): CellError =>\n  new CellError('#REF!', detail);\n\nexport const numError = (detail = 'invalid number'): CellError =>\n  new CellError('#NUM!', detail);\n\n/** Base class for problems that abort a `set()` call. */\nexport class SpreadsheetError extends Error {\n  constructor(message: string) {\n    super(message);\n    this.name = new.target.name;\n  }\n}\n\n/** Thrown when an edit would make a cell depend on itself. */\nexport class CircularReferenceError extends SpreadsheetError {\n  /** The dependency chain, starting and ending at the offending cell. */\n  readonly cycle: readonly string[];\n\n  constructor(cycle: readonly string[]) {\n    super(`Circular reference detected: ${cycle.join(' -> ')}`);\n    this.cycle = cycle;\n  }\n}\n\n/** Thrown when a formula cannot be parsed. */\nexport class FormulaSyntaxError extends SpreadsheetError {}\n\n/** Thrown when a cell address is not a valid reference such as `A1`. */\nexport class InvalidReferenceError extends SpreadsheetError {}\n","structuredPatch":[{"oldStart":39,"oldLines":9,"newStart":39,"newLines":6,"lines":[" export const nameError = (detail = 'unknown name'): CellError =>","   new CellError('#NAME?', detail);"," ","-export const refError = (detail = 'invalid reference'): CellError =>","-  new CellError('#REF!', detail);","-"," export const numError = (detail = 'invalid number'): CellError =>","   new CellError('#NUM!', detail);"," "]}],"userModified":false,"replaceAll":false}}
