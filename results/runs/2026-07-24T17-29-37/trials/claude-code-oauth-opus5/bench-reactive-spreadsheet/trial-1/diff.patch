--- /dev/null
+++ b/src/spreadsheet.ts
@@ -0,0 +1,244 @@
+import type { Node } from './ast.js';
+import { CircularReferenceError, isCellError } from './errors.js';
+import { evaluate, type EvalContext } from './evaluator.js';
+import { collectReferences, parseFormula } from './parser.js';
+import { normalizeReference } from './reference.js';
+import { formatValue, type CellValue, type EvalValue } from './values.js';
+
+/** Everything the engine tracks for one occupied cell. */
+interface Cell {
+  /** Exactly what was passed to `set`, so formulas can be read back. */
+  raw: string | number | boolean;
+  /** Parsed syntax tree, present only for formula cells. */
+  formula: Node | null;
+  /** Last computed value. */
+  value: EvalValue;
+  /** Cells this one reads (its precedents). */
+  precedents: Set<string>;
+}
+
+/**
+ * A reactive grid of cells.
+ *
+ * Values are recomputed eagerly on write: setting a cell recomputes it and
+ * every cell that transitively depends on it, in dependency order, so reads
+ * are always cheap and consistent.
+ */
+export class Spreadsheet {
+  private readonly cells = new Map<string, Cell>();
+
+  /** Reverse edges: for each cell, the cells whose formulas read it. */
+  private readonly dependents = new Map<string, Set<string>>();
+
+  private readonly context: EvalContext = {
+    getValue: (ref) => this.cells.get(ref)?.value ?? null,
+  };
+
+  /**
+   * Write a cell. A string beginning with `=` is stored as a formula; an empty
+   * string clears the cell.
+   *
+   * @throws {CircularReferenceError} if the edit would make a cell depend on
+   * itself, directly or through any chain of intermediates. The sheet is left
+   * unchanged when this happens.
+   * @throws {FormulaSyntaxError} if a formula cannot be parsed.
+   * @throws {InvalidReferenceError} if `cell` is not a valid address.
+   */
+  set(cell: string, value: string | number | boolean): void {
+    const ref = normalizeReference(cell);
+
+    if (value === '') {
+      this.clear(ref);
+      return;
+    }
+
+    const formula =
+      typeof value === 'string' && value.startsWith('=') ? parseFormula(value) : null;
+    const precedents = formula ? collectReferences(formula) : new Set<string>();
+
+    this.assertNoCycle(ref, precedents);
+
+    this.setPrecedents(ref, precedents);
+    this.cells.set(ref, { raw: value, formula, value: null, precedents });
+    this.recomputeFrom(ref);
+  }
+
+  /** Read a cell's computed value. Empty cells read as `null`. */
+  get(cell: string): CellValue {
+    const value = this.cells.get(normalizeReference(cell))?.value ?? null;
+    return isCellError(value) ? value.code : value;
+  }
+
+  /** Read a cell's computed value as the string a spreadsheet would show. */
+  getDisplay(cell: string): string {
+    const value = this.cells.get(normalizeReference(cell))?.value ?? null;
+    return formatValue(value);
+  }
+
+  /** Every non-empty cell, keyed by canonical address. */
+  getCells(): Map<string, CellValue> {
+    const snapshot = new Map<string, CellValue>();
+    for (const [ref, cell] of this.cells) {
+      snapshot.set(ref, isCellError(cell.value) ? cell.value.code : cell.value);
+    }
+    return snapshot;
+  }
+
+  /**
+   * The text originally written to a cell — the formula source for formula
+   * cells — or `null` if the cell is empty.
+   */
+  getFormula(cell: string): string | number | boolean | null {
+    return this.cells.get(normalizeReference(cell))?.raw ?? null;
+  }
+
+  /** Remove a cell's contents. Dependents recompute against an empty cell. */
+  clear(cell: string): void {
+    const ref = normalizeReference(cell);
+    if (!this.cells.has(ref)) return;
+
+    this.setPrecedents(ref, new Set());
+    this.cells.delete(ref);
+    this.recomputeFrom(ref);
+  }
+
+  /** Remove every cell. */
+  clearAll(): void {
+    this.cells.clear();
+    this.dependents.clear();
+  }
+
+  /** True if the cell holds a value or formula. */
+  has(cell: string): boolean {
+    return this.cells.has(normalizeReference(cell));
+  }
+
+  /**
+   * Walk the existing dependency edges backwards from the proposed precedents
+   * looking for `ref`. Runs before any mutation so a rejected edit leaves no
+   * trace.
+   */
+  private assertNoCycle(ref: string, precedents: Set<string>): void {
+    if (precedents.has(ref)) {
+      throw new CircularReferenceError([ref, ref]);
+    }
+
+    // Depth-first search carrying the path, so the error can name the cycle.
+    const visited = new Set<string>();
+    const stack: Array<{ node: string; path: string[] }> = [];
+    for (const precedent of precedents) {
+      stack.push({ node: precedent, path: [ref, precedent] });
+    }
+
+    while (stack.length > 0) {
+      const { node, path } = stack.pop() as { node: string; path: string[] };
+      if (visited.has(node)) continue;
+      visited.add(node);
+
+      const cell = this.cells.get(node);
+      if (!cell) continue;
+
+      for (const next of cell.precedents) {
+        if (next === ref) {
+          throw new CircularReferenceError([...path, ref]);
+        }
+        if (!visited.has(next)) {
+          stack.push({ node: next, path: [...path, next] });
+        }
+      }
+    }
+  }
+
+  /** Repoint `ref`'s outgoing edges at a new precedent set. */
+  private setPrecedents(ref: string, precedents: Set<string>): void {
+    const previous = this.cells.get(ref)?.precedents;
+    if (previous) {
+      for (const precedent of previous) {
+        const set = this.dependents.get(precedent);
+        if (!set) continue;
+        set.delete(ref);
+        if (set.size === 0) this.dependents.delete(precedent);
+      }
+    }
+
+    for (const precedent of precedents) {
+      let set = this.dependents.get(precedent);
+      if (!set) {
+        set = new Set();
+        this.dependents.set(precedent, set);
+      }
+      set.add(ref);
+    }
+  }
+
+  /**
+   * Recompute `origin` and everything downstream of it. The affected cells are
+   * sorted topologically first so each is evaluated only after the cells it
+   * reads are already up to date.
+   */
+  private recomputeFrom(origin: string): void {
+    const affected = this.collectAffected(origin);
+    for (const ref of this.topologicalOrder(affected)) {
+      this.evaluateCell(ref);
+    }
+  }
+
+  /** `origin` plus its transitive dependents. */
+  private collectAffected(origin: string): Set<string> {
+    const affected = new Set<string>();
+    const stack = [origin];
+
+    while (stack.length > 0) {
+      const ref = stack.pop() as string;
+      if (affected.has(ref)) continue;
+      affected.add(ref);
+      for (const dependent of this.dependents.get(ref) ?? []) {
+        if (!affected.has(dependent)) stack.push(dependent);
+      }
+    }
+
+    return affected;
+  }
+
+  /**
+   * Kahn's algorithm over the subgraph induced by `affected`. Cycles are
+   * prevented at write time, so every node is guaranteed to be emitted.
+   */
+  private topologicalOrder(affected: Set<string>): string[] {
+    const indegree = new Map<string, number>();
+    for (const ref of affected) {
+      let count = 0;
+      for (const precedent of this.cells.get(ref)?.precedents ?? []) {
+        if (affected.has(precedent)) count++;
+      }
+      indegree.set(ref, count);
+    }
+
+    const queue: string[] = [];
+    for (const [ref, count] of indegree) {
+      if (count === 0) queue.push(ref);
+    }
+
+    const order: string[] = [];
+    for (let head = 0; head < queue.length; head++) {
+      const ref = queue[head];
+      order.push(ref);
+      for (const dependent of this.dependents.get(ref) ?? []) {
+        if (!affected.has(dependent)) continue;
+        const remaining = (indegree.get(dependent) as number) - 1;
+        indegree.set(dependent, remaining);
+        if (remaining === 0) queue.push(dependent);
+      }
+    }
+
+    return order;
+  }
+
+  private evaluateCell(ref: string): void {
+    const cell = this.cells.get(ref);
+    if (!cell) return;
+    cell.value = cell.formula
+      ? evaluate(cell.formula, this.context)
+      : (cell.raw as CellValue);
+  }
+}
