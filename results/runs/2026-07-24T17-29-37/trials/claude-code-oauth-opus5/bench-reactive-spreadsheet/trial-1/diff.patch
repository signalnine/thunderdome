+export type BinaryOperator =
+  | '+'
+  | '-'
+  | '*'
+  | '/'
+  | '^'
+  | '='
+  | '<>'
+  | '>'
+  | '<'
+  | '>='
+  | '<=';
+
+export interface NumberNode {
+  kind: 'number';
+  value: number;
+}
+
+export interface StringNode {
+  kind: 'string';
+  value: string;
+}
+
+export interface BooleanNode {
+  kind: 'boolean';
+  value: boolean;
+}
+
+/** A single cell address, already normalised to canonical form. */
+export interface ReferenceNode {
+  kind: 'reference';
+  ref: string;
+}
+
+/** A rectangular block of cells. Only valid as a function argument. */
+export interface RangeNode {
+  kind: 'range';
+  start: string;
+  end: string;
+}
+
+export interface UnaryNode {
+  kind: 'unary';
+  operator: '+' | '-';
+  operand: Node;
+}
+
+export interface BinaryNode {
+  kind: 'binary';
+  operator: BinaryOperator;
+  left: Node;
+  right: Node;
+}
+
+export interface FunctionNode {
+  kind: 'function';
+  /** Upper-cased function name. */
+  name: string;
+  args: Node[];
+}
+
+export type Node =
+  | NumberNode
+  | StringNode
+  | BooleanNode
+  | ReferenceNode
+  | RangeNode
+  | UnaryNode
+  | BinaryNode
+  | FunctionNode;
