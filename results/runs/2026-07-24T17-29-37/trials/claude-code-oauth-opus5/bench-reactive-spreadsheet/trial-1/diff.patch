+import { describe, expect, it } from 'vitest';
+import { Spreadsheet } from './index.js';
+
+/**
+ * These exercise the recompute strategy rather than the formula language. A
+ * naive engine that re-evaluates a cell once per incoming edge would take
+ * exponential time on the fan-in cases below; topological ordering keeps every
+ * cell to a single evaluation per edit.
+ */
+describe('scale', () => {
+  it('propagates through a chain 1000 cells deep', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    for (let row = 2; row <= 1000; row++) {
+      sheet.set(`A${row}`, `=A${row - 1}+1`);
+    }
+    expect(sheet.get('A1000')).toBe(1000);
+
+    sheet.set('A1', 1001);
+    expect(sheet.get('A1000')).toBe(2000);
+  });
+
+  it('aggregates a range of 1000 cells and reacts to a single change', () => {
+    const sheet = new Spreadsheet();
+    for (let row = 1; row <= 1000; row++) {
+      sheet.set(`A${row}`, 1);
+    }
+    sheet.set('C1', '=SUM(A1:A1000)');
+    sheet.set('C2', '=AVERAGE(A1:A1000)');
+    sheet.set('C3', '=COUNT(A1:A1000)');
+
+    expect(sheet.get('C1')).toBe(1000);
+    expect(sheet.get('C2')).toBe(1);
+    expect(sheet.get('C3')).toBe(1000);
+
+    sheet.set('A500', 501);
+    expect(sheet.get('C1')).toBe(1500);
+  });
+
+  it('handles repeated diamond fan-in without exponential blowup', () => {
+    // C(n) = C(n-1) + C(n-2): each cell is reached by two distinct paths, so a
+    // recompute that follows edges naively would visit cells 2^n times.
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('A2', 1);
+    for (let row = 3; row <= 40; row++) {
+      sheet.set(`A${row}`, `=A${row - 1}+A${row - 2}`);
+    }
+    expect(sheet.get('A40')).toBe(102334155);
+
+    sheet.set('A1', 0);
+    // Shifting the seeds turns the sequence into Fibonacci offset by one.
+    expect(sheet.get('A40')).toBe(63245986);
+  });
+
+  it('keeps a wide fan-out consistent', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 2);
+    for (let row = 1; row <= 500; row++) {
+      sheet.set(`B${row}`, `=A1*${row}`);
+    }
+    expect(sheet.get('B500')).toBe(1000);
+
+    sheet.set('A1', 3);
+    expect(sheet.get('B1')).toBe(3);
+    expect(sheet.get('B500')).toBe(1500);
+  });
+
+  it('detects a cycle at the end of a long chain', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    for (let row = 2; row <= 500; row++) {
+      sheet.set(`A${row}`, `=A${row - 1}+1`);
+    }
+    expect(() => sheet.set('A1', '=A500')).toThrow();
+    expect(sheet.get('A1')).toBe(1);
+    expect(sheet.get('A500')).toBe(500);
+  });
+});
