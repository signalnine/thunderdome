+import { InvalidReferenceError } from './errors.js';
+
+/** A parsed cell address. Both coordinates are zero-based. */
+export interface CellCoord {
+  col: number;
+  row: number;
+}
+
+const REFERENCE_PATTERN = /^([A-Za-z]{1,7})([1-9][0-9]{0,6})$/;
+
+/**
+ * Upper bound on how many cells a single range may cover. Ranges are expanded
+ * into individual dependency edges, so an unbounded range would exhaust memory.
+ */
+export const MAX_RANGE_CELLS = 1_000_000;
+
+/** True if `text` looks like a cell address (`A1`, `bc12`, `AA100`). */
+export function isReference(text: string): boolean {
+  return REFERENCE_PATTERN.test(text);
+}
+
+/** Convert column letters to a zero-based index: `A` -> 0, `Z` -> 25, `AA` -> 26. */
+export function columnToIndex(letters: string): number {
+  let index = 0;
+  for (const char of letters.toUpperCase()) {
+    index = index * 26 + (char.charCodeAt(0) - 64);
+  }
+  return index - 1;
+}
+
+/** Inverse of {@link columnToIndex}: 0 -> `A`, 26 -> `AA`. */
+export function indexToColumn(index: number): string {
+  let remaining = index + 1;
+  let letters = '';
+  while (remaining > 0) {
+    const digit = (remaining - 1) % 26;
+    letters = String.fromCharCode(65 + digit) + letters;
+    remaining = Math.floor((remaining - 1) / 26);
+  }
+  return letters;
+}
+
+/** Parse `A1` into coordinates, throwing {@link InvalidReferenceError} if malformed. */
+export function parseReference(ref: string): CellCoord {
+  const match = REFERENCE_PATTERN.exec(ref.trim());
+  if (!match) {
+    throw new InvalidReferenceError(`Invalid cell reference: "${ref}"`);
+  }
+  return { col: columnToIndex(match[1]), row: Number(match[2]) - 1 };
+}
+
+/** Build a canonical `A1`-style address from coordinates. */
+export function formatReference(coord: CellCoord): string {
+  return `${indexToColumn(coord.col)}${coord.row + 1}`;
+}
+
+/** Canonicalise an address so `a1` and `A1` name the same cell. */
+export function normalizeReference(ref: string): string {
+  return formatReference(parseReference(ref));
+}
+
+/**
+ * Expand `start:end` into every address in the rectangle it spans. The corners
+ * may be given in any order, so `C3:A1` covers the same block as `A1:C3`.
+ */
+export function expandRange(start: string, end: string): string[] {
+  const a = parseReference(start);
+  const b = parseReference(end);
+
+  const minCol = Math.min(a.col, b.col);
+  const maxCol = Math.max(a.col, b.col);
+  const minRow = Math.min(a.row, b.row);
+  const maxRow = Math.max(a.row, b.row);
+
+  const total = (maxCol - minCol + 1) * (maxRow - minRow + 1);
+  if (total > MAX_RANGE_CELLS) {
+    throw new InvalidReferenceError(
+      `Range ${start}:${end} covers ${total} cells, exceeding the limit of ${MAX_RANGE_CELLS}`,
+    );
+  }
+
+  const cells: string[] = [];
+  for (let row = minRow; row <= maxRow; row++) {
+    for (let col = minCol; col <= maxCol; col++) {
+      cells.push(formatReference({ col, row }));
+    }
+  }
+  return cells;
+}
