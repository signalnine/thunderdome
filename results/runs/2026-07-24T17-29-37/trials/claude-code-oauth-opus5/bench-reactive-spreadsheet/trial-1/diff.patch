t.getDisplay('A3')).toBe('30');\n\n    sheet.set('A1', 50);\n    expect(sheet.get('A3')).toBe(70);\n\n    sheet.set('B1', '=SUM(A1:A2)');\n    expect(sheet.get('B1')).toBe(70);\n\n    sheet.set('C1', '=IF(A1>30, \"big\", \"small\")');\n    expect(sheet.get('C1')).toBe('big');\n  });\n});\n\ndescribe('invalid formulas', () => {\n  it('throws on syntax errors', () => {\n    const sheet = new Spreadsheet();\n    expect(() => sheet.set('A1', '=1+')).toThrow(FormulaSyntaxError);\n    expect(() => sheet.set('A1', '=(1+2')).toThrow(FormulaSyntaxError);\n    expect(() => sheet.set('A1', '=SUM(A1:A3')).toThrow(FormulaSyntaxError);\n    expect(() => sheet.set('A1', '=*3')).toThrow(FormulaSyntaxError);\n    expect(() => sheet.set('A1', '=')).toThrow(FormulaSyntaxError);\n    expect(() => sheet.set('A1', '=\"unterminated')).toThrow(FormulaSyntaxError);\n  });\n\n  it('leaves the cell untouched after a syntax error', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 5);\n    expect(() => sheet.set('A1', '=1+')).toThrow(FormulaSyntaxError);\n    expect(sheet.get('A1')).toBe(5);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
