('B1', '=IF(A1, \"y\", \"n\")');\n    expect(sheet.get('B1')).toBe('n');\n  });\n});\n\ndescribe('comparisons', () => {\n  const compare = (formula: string) => evaluate(formula);\n\n  it('orders numbers below text, and text below booleans', () => {\n    expect(compare('=1<\"a\"')).toBe(true);\n    expect(compare('=\"a\"<TRUE')).toBe(true);\n    expect(compare('=100>\"a\"')).toBe(false);\n  });\n\n  it('orders booleans with FALSE below TRUE', () => {\n    expect(compare('=TRUE>FALSE')).toBe(true);\n    expect(compare('=TRUE=TRUE')).toBe(true);\n  });\n\n  it('compares text case-sensitively', () => {\n    expect(compare('=\"a\"=\"A\"')).toBe(false);\n    expect(compare('=\"abc\"<\"abd\"')).toBe(true);\n  });\n\n  it('gives an empty cell the type of the other operand', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B1', '=A1=0');\n    sheet.set('B2', '=A1=\"\"');\n    sheet.set('B3', '=A1=FALSE');\n    expect(sheet.get('B1')).toBe(true);\n    expect(sheet.get('B2')).toBe(true);\n    expect(sheet.get('B3')).toBe(true);\n  });\n\n  it('exposes the same ordering through compareValues', () => {\n    expect(compareValues(1, 2)).toBe(-1);\n    expect(compareValues(2, 2)).toBe(0);\n    expect(compareValues(3, 2)).toBe(1);\n    expect(compareValues('a', 'b')).toBe(-1);\n    expect(compareValues(false, true)).toBe(-1);\n    expect(compareValues(null, null)).toBe(0);\n    expect(compareValues(5, 'a')).toBe(-1);\n  });\n});\n\ndescribe('formatting', () => {\n  it('renders integers and decimals plainly', () => {\n    expect(formatNumber(30)).toBe('30');\n    expect(formatNumber(-4)).toBe('-4');\n    expect(formatNumber(2.5)).toBe('2.5');\n  });\n\n  it('trims floating-point representation error', () => {\n    expect(formatNumber(0.1 + 0.2)).toBe('0.3');\n    expect(formatNumber(1 / 3)).toBe('0.333333333333333');\n  });\n\n  it('renders each value type', () => {\n    expect(formatValue(null)).toBe('');\n    expect(formatValue(true)).toBe('TRUE');\n    expect(formatValue(false)).toBe('FALSE');\n    expect(formatValue('text')).toBe('text');\n    expect(formatValue(7)).toBe('7');\n  });\n});\n\ndescribe('aggregate argument handling', () => {\n  it('rejects text passed directly to an aggregate', () => {\n    expect(evaluate('=SUM(1, \"abc\")')).toBe('#VALUE!');\n  });\n\n  it('skips a directly referenced empty cell', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 5);\n    sheet.set('B1', '=COUNT(A1, A2)');\n    expect(sheet.get('B1')).toBe(1);\n  });\n\n  it('requires at least one argument', () => {\n    expect(evaluate('=SUM()')).toBe('#VALUE!');\n  });\n\n  it('rejects the wrong number of IF arguments', () => {\n    expect(evaluate('=IF(TRUE)')).toBe('#VALUE!');\n    expect(evaluate('=IF(TRUE,1,2,3)')).toBe('#VALUE!');\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1176,"cache_read_input_tokens":79737,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1176},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"101102dd-cd71-4895-9a7a-8caad5f128ee","uuid":"9f529a4f-2aa4-41b2-aec2-f97736bdfa41","request_id":"req_011CdMKSDRAXDVaRMT8xFNiJ"}
