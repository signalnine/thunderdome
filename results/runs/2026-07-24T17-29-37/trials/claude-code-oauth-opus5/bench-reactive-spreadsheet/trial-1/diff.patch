new file mode 100644
index 0000000..2c7c414
--- /dev/null
+++ b/src/values.ts
@@ -0,0 +1,102 @@
+import { CellError, isCellError, valueError } from './errors.js';
+
+/** What a caller sees when reading a cell. */
+export type CellValue = number | string | boolean | null;
+
+/** What flows through formula evaluation — a cell value or an in-band error. */
+export type EvalValue = CellValue | CellError;
+
+/**
+ * Relative ordering of types when comparing across them, matching spreadsheet
+ * convention: every number sorts below every string, which sorts below every
+ * boolean.
+ */
+function typeRank(value: Exclude<CellValue, null>): number {
+  if (typeof value === 'number') return 0;
+  if (typeof value === 'string') return 1;
+  return 2;
+}
+
+/**
+ * Coerce a value for arithmetic. Empty cells count as zero, booleans as 1/0,
+ * and numeric strings are parsed; anything else yields `#VALUE!`.
+ */
+export function toNumber(value: EvalValue): number | CellError {
+  if (isCellError(value)) return value;
+  if (value === null) return 0;
+  if (typeof value === 'number') return value;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+
+  const trimmed = value.trim();
+  if (trimmed === '') return 0;
+  const parsed = Number(trimmed);
+  if (Number.isNaN(parsed)) {
+    return valueError(`"${value}" is not a number`);
+  }
+  return parsed;
+}
+
+/**
+ * Coerce a value for use as a condition. Numbers are truthy when non-zero and
+ * empty cells are false; strings have no truth value.
+ */
+export function toBoolean(value: EvalValue): boolean | CellError {
+  if (isCellError(value)) return value;
+  if (value === null) return false;
+  if (typeof value === 'boolean') return value;
+  if (typeof value === 'number') return value !== 0;
+  return valueError(`"${value}" is not a condition`);
+}
+
+/**
+ * Three-way comparison used by the relational operators. Values of the same
+ * type compare naturally; mixed types fall back to {@link typeRank}. String
+ * comparison is case-sensitive.
+ */
+export function compareValues(left: CellValue, right: CellValue): number {
+  // An empty cell takes on the type of whatever it is compared against.
+  const a = left === null ? emptyAs(right) : left;
+  const b = right === null ? emptyAs(left) : right;
+
+  if (typeof a === 'number' && typeof b === 'number') {
+    return a < b ? -1 : a > b ? 1 : 0;
+  }
+  if (typeof a === 'string' && typeof b === 'string') {
+    return a < b ? -1 : a > b ? 1 : 0;
+  }
+  if (typeof a === 'boolean' && typeof b === 'boolean') {
+    return a === b ? 0 : a ? 1 : -1;
+  }
+
+  const rankA = typeRank(a);
+  const rankB = typeRank(b);
+  return rankA < rankB ? -1 : rankA > rankB ? 1 : 0;
+}
+
+/** The zero value of the other operand's type, used when comparing empty cells. */
+function emptyAs(other: CellValue): Exclude<CellValue, null> {
+  if (typeof other === 'string') return '';
+  if (typeof other === 'boolean') return false;
+  return 0;
+}
+
+/**
+ * Render a computed value the way a spreadsheet cell would show it.
+ * Floating-point noise is trimmed, so `0.1 + 0.2` displays as `0.3`.
+ */
+export function formatValue(value: EvalValue): string {
+  if (isCellError(value)) return value.code;
+  if (value === null) return '';
+  if (typeof value === 'boolean') return value ? 'TRUE' : 'FALSE';
+  if (typeof value === 'number') return formatNumber(value);
+  return value;
+}
+
+export function formatNumber(value: number): string {
+  if (Number.isNaN(value)) return '#NUM!';
+  if (!Number.isFinite(value)) return value > 0 ? 'Infinity' : '-Infinity';
+  if (Number.isInteger(value)) return String(value);
+  // 15 significant digits is the widest precision that round-trips cleanly
+  // without exposing binary floating-point artefacts.
+  return String(Number(value.toPrecision(15)));
+}
