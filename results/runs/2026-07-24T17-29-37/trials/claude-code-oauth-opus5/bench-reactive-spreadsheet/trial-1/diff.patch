+  it('maps indices back to letters', () => {
+    expect(indexToColumn(0)).toBe('A');
+    expect(indexToColumn(25)).toBe('Z');
+    expect(indexToColumn(26)).toBe('AA');
+    expect(indexToColumn(701)).toBe('ZZ');
+    expect(indexToColumn(702)).toBe('AAA');
+  });
+
+  it('round-trips', () => {
+    for (let index = 0; index < 1000; index++) {
+      expect(columnToIndex(indexToColumn(index))).toBe(index);
+    }
+  });
+});
+
+describe('parsing addresses', () => {
+  it('splits an address into coordinates', () => {
+    expect(parseReference('A1')).toEqual({ col: 0, row: 0 });
+    expect(parseReference('B2')).toEqual({ col: 1, row: 1 });
+    expect(parseReference('Z100')).toEqual({ col: 25, row: 99 });
+    expect(parseReference('AA1')).toEqual({ col: 26, row: 0 });
+  });
+
+  it('is case-insensitive and tolerates surrounding space', () => {
+    expect(normalizeReference('aa10')).toBe('AA10');
+    expect(normalizeReference('  b2 ')).toBe('B2');
+  });
+
+  it('rebuilds an address from coordinates', () => {
+    expect(formatReference({ col: 0, row: 0 })).toBe('A1');
+    expect(formatReference({ col: 26, row: 99 })).toBe('AA100');
+  });
+
+  it('recognises well-formed addresses', () => {
+    expect(isReference('A1')).toBe(true);
+    expect(isReference('AA100')).toBe(true);
+    expect(isReference('A0')).toBe(false);
+    expect(isReference('1A')).toBe(false);
+    expect(isReference('A')).toBe(false);
+    expect(isReference('1')).toBe(false);
+    expect(isReference('SUM')).toBe(false);
+    expect(isReference('A1B')).toBe(false);
+  });
+
+  it('rejects malformed addresses', () => {
+    expect(() => parseReference('A0')).toThrow(InvalidReferenceError);
+    expect(() => parseReference('')).toThrow(InvalidReferenceError);
+    expect(() => parseReference('$A$1')).toThrow(InvalidReferenceError);
+  });
+});
+
+describe('expandRange', () => {
+  it('expands a column', () => {
+    expect(expandRange('A1', 'A3')).toEqual(['A1', 'A2', 'A3']);
+  });
+
+  it('expands a row', () => {
+    expect(expandRange('A1', 'C1')).toEqual(['A1', 'B1', 'C1']);
+  });
+
+  it('expands a block in reading order', () => {
+    expect(expandRange('A1', 'B2')).toEqual(['A1', 'B1', 'A2', 'B2']);
+  });
+
+  it('normalises reversed corners', () => {
+    expect(expandRange('C3', 'A1')).toEqual(expandRange('A1', 'C3'));
+    expect(expandRange('A1', 'C3')).toHaveLength(9);
+  });
+
+  it('refuses ranges beyond the size limit', () => {
+    expect(() => expandRange('A1', 'ZZZ9999999')).toThrow(InvalidReferenceError);
+  });
+});
