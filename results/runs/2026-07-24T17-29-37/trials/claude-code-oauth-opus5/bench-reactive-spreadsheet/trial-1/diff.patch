new file mode 100644
index 0000000..984c448
--- /dev/null
+++ b/src/parser.ts
@@ -0,0 +1,226 @@
+import type { BinaryOperator, Node } from './ast.js';
+import { FormulaSyntaxError } from './errors.js';
+import { expandRange, isReference, normalizeReference } from './reference.js';
+import { tokenize, type Token } from './tokenizer.js';
+
+/**
+ * Recursive-descent parser for formula bodies.
+ *
+ * Precedence, loosest first:
+ *   comparison  ( = <> > < >= <= )
+ *   additive    ( + - )
+ *   multiplicative ( * / )
+ *   unary       ( - + )
+ *   power       ( ^ , right-associative )
+ *   primary     ( literals, references, ranges, calls, parentheses )
+ */
+class Parser {
+  private readonly tokens: Token[];
+  private position = 0;
+
+  constructor(source: string) {
+    this.tokens = tokenize(source);
+  }
+
+  parse(): Node {
+    const node = this.parseComparison();
+    if (this.peek().type !== 'eof') {
+      throw new FormulaSyntaxError(
+        `Unexpected token "${this.peek().value}" at position ${this.peek().position}`,
+      );
+    }
+    return node;
+  }
+
+  /** A method rather than a getter: the token stream advances, so callers must
+   *  not have narrowing carried across `advance()`. */
+  private peek(): Token {
+    return this.tokens[this.position];
+  }
+
+  private advance(): Token {
+    return this.tokens[this.position++];
+  }
+
+  private matchOperator(...operators: string[]): boolean {
+    return (
+      this.peek().type === 'operator' && operators.includes(this.peek().value)
+    );
+  }
+
+  private parseComparison(): Node {
+    let left = this.parseAdditive();
+    while (this.matchOperator('=', '<>', '>', '<', '>=', '<=')) {
+      const operator = this.advance().value as BinaryOperator;
+      left = { kind: 'binary', operator, left, right: this.parseAdditive() };
+    }
+    return left;
+  }
+
+  private parseAdditive(): Node {
+    let left = this.parseMultiplicative();
+    while (this.matchOperator('+', '-')) {
+      const operator = this.advance().value as BinaryOperator;
+      left = { kind: 'binary', operator, left, right: this.parseMultiplicative() };
+    }
+    return left;
+  }
+
+  private parseMultiplicative(): Node {
+    let left = this.parseUnary();
+    while (this.matchOperator('*', '/')) {
+      const operator = this.advance().value as BinaryOperator;
+      left = { kind: 'binary', operator, left, right: this.parseUnary() };
+    }
+    return left;
+  }
+
+  private parseUnary(): Node {
+    if (this.matchOperator('-', '+')) {
+      const operator = this.advance().value as '+' | '-';
+      return { kind: 'unary', operator, operand: this.parseUnary() };
+    }
+    return this.parsePower();
+  }
+
+  private parsePower(): Node {
+    const base = this.parsePrimary();
+    if (this.matchOperator('^')) {
+      this.advance();
+      // Right-associative, and the exponent may itself be signed: 2^-1.
+      return { kind: 'binary', operator: '^', left: base, right: this.parseUnary() };
+    }
+    return base;
+  }
+
+  private parsePrimary(): Node {
+    const token = this.peek();
+
+    switch (token.type) {
+      case 'number':
+        this.advance();
+        return { kind: 'number', value: token.numberValue as number };
+
+      case 'string':
+        this.advance();
+        return { kind: 'string', value: token.value };
+
+      case 'lparen': {
+        this.advance();
+        const inner = this.parseComparison();
+        this.expect('rparen', ')');
+        return inner;
+      }
+
+      case 'identifier':
+        return this.parseIdentifier();
+
+      default:
+        throw new FormulaSyntaxError(
+          token.type === 'eof'
+            ? 'Unexpected end of formula'
+            : `Unexpected token "${token.value}" at position ${token.position}`,
+        );
+    }
+  }
+
+  /** An identifier is a function call, a boolean literal, or a cell reference. */
+  private parseIdentifier(): Node {
+    const token = this.advance();
+    const name = token.value;
+
+    if (this.peek().type === 'lparen') {
+      this.advance();
+      const args: Node[] = [];
+      if (this.peek().type !== 'rparen') {
+        args.push(this.parseArgument());
+        while (this.peek().type === 'comma') {
+          this.advance();
+          args.push(this.parseArgument());
+        }
+      }
+      this.expect('rparen', ')');
+      return { kind: 'function', name: name.toUpperCase(), args };
+    }
+
+    const upper = name.toUpperCase();
+    if (upper === 'TRUE') return { kind: 'boolean', value: true };
+    if (upper === 'FALSE') return { kind: 'boolean', value: false };
+
+    if (!isReference(name)) {
+      throw new FormulaSyntaxError(
+        `Unknown identifier "${name}" at position ${token.position}`,
+      );
+    }
+
+    const start = normalizeReference(name);
+    if (this.peek().type === 'colon') {
+      this.advance();
+      const endToken = this.peek();
+      if (endToken.type !== 'identifier' || !isReference(endToken.value)) {
+        throw new FormulaSyntaxError(
+          `Expected a cell reference after ":" at position ${endToken.position}`,
+        );
+      }
+      this.advance();
+      return { kind: 'range', start, end: normalizeReference(endToken.value) };
+    }
+
+    return { kind: 'reference', ref: start };
+  }
+
+  /** Function arguments are the only place a range is allowed. */
+  private parseArgument(): Node {
+    return this.parseComparison();
+  }
+
+  private expect(type: Token['type'], text: string): void {
+    if (this.peek().type !== type) {
+      throw new FormulaSyntaxError(
+        `Expected "${text}" at position ${this.peek().position}`,
+      );
+    }
+    this.advance();
+  }
+}
+
+/**
+ * Parse a formula. Accepts the text with or without its leading `=`.
+ *
+ * @throws {FormulaSyntaxError} if the formula is malformed.
+ */
+export function parseFormula(formula: string): Node {
+  const body = formula.startsWith('=') ? formula.slice(1) : formula;
+  if (body.trim() === '') {
+    throw new FormulaSyntaxError('Formula is empty');
+  }
+  return new Parser(body).parse();
+}
+
+/**
+ * Collect every cell address a formula reads, expanding ranges into the
+ * individual cells they cover. Used to build the dependency graph.
+ */
+export function collectReferences(node: Node, into = new Set<string>()): Set<string> {
+  switch (node.kind) {
+    case 'reference':
+      into.add(node.ref);
+      break;
+    case 'range':
+      for (const ref of expandRange(node.start, node.end)) into.add(ref);
+      break;
+    case 'unary':
+      collectReferences(node.operand, into);
+      break;
+    case 'binary':
+      collectReferences(node.left, into);
+      collectReferences(node.right, into);
+      break;
+    case 'function':
+      for (const arg of node.args) collectReferences(arg, into);
+      break;
+    default:
+      break;
+  }
+  return into;
+}
