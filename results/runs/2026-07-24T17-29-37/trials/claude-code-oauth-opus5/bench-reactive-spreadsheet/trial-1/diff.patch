--- /dev/null
+++ b/src/errors.ts
@@ -0,0 +1,68 @@
+/**
+ * Error handling comes in two flavours:
+ *
+ * 1. `CellError` — an in-band *value* that propagates through formulas the way
+ *    `#DIV/0!` does in a real spreadsheet. Reading a broken cell yields the
+ *    error code; it does not throw.
+ * 2. `SpreadsheetError` subclasses — out-of-band problems with the *edit*
+ *    itself (a circular reference, a malformed formula, a bad cell address).
+ *    These are thrown from `set()` and leave the sheet unchanged.
+ */
+
+export type ErrorCode = '#DIV/0!' | '#VALUE!' | '#NAME?' | '#NUM!';
+
+/** An error that behaves as a cell value and propagates through formulas. */
+export class CellError {
+  readonly code: ErrorCode;
+  readonly detail: string;
+
+  constructor(code: ErrorCode, detail = '') {
+    this.code = code;
+    this.detail = detail;
+  }
+
+  toString(): string {
+    return this.code;
+  }
+}
+
+export function isCellError(value: unknown): value is CellError {
+  return value instanceof CellError;
+}
+
+export const divideByZero = (detail = 'division by zero'): CellError =>
+  new CellError('#DIV/0!', detail);
+
+export const valueError = (detail = 'invalid value'): CellError =>
+  new CellError('#VALUE!', detail);
+
+export const nameError = (detail = 'unknown name'): CellError =>
+  new CellError('#NAME?', detail);
+
+export const numError = (detail = 'invalid number'): CellError =>
+  new CellError('#NUM!', detail);
+
+/** Base class for problems that abort a `set()` call. */
+export class SpreadsheetError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = new.target.name;
+  }
+}
+
+/** Thrown when an edit would make a cell depend on itself. */
+export class CircularReferenceError extends SpreadsheetError {
+  /** The dependency chain, starting and ending at the offending cell. */
+  readonly cycle: readonly string[];
+
+  constructor(cycle: readonly string[]) {
+    super(`Circular reference detected: ${cycle.join(' -> ')}`);
+    this.cycle = cycle;
+  }
+}
+
+/** Thrown when a formula cannot be parsed. */
+export class FormulaSyntaxError extends SpreadsheetError {}
+
+/** Thrown when a cell address is not a valid reference such as `A1`. */
+export class InvalidReferenceError extends SpreadsheetError {}
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..0883449
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,257 @@
+import type { BinaryOperator, Node } from './ast.js';
+import {
+  CellError,
+  divideByZero,
+  isCellError,
+  nameError,
+  numError,
+  valueError,
+} from './errors.js';
+import { expandRange } from './reference.js';
+import {
+  compareValues,
+  toBoolean,
+  toNumber,
+  type CellValue,
+  type EvalValue,
+} from './values.js';
+
+/** How the evaluator reads other cells. */
+export interface EvalContext {
+  getValue(ref: string): EvalValue;
+}
+
+/**
+ * Evaluate a parsed formula. Errors are returned as {@link CellError} values
+ * rather than thrown, so they propagate through enclosing expressions.
+ */
+export function evaluate(node: Node, context: EvalContext): EvalValue {
+  switch (node.kind) {
+    case 'number':
+      return node.value;
+    case 'string':
+      return node.value;
+    case 'boolean':
+      return node.value;
+    case 'reference':
+      return context.getValue(node.ref);
+    case 'range':
+      // A range only means something as a function argument.
+      return valueError(`Range ${node.start}:${node.end} is not a single value`);
+    case 'unary':
+      return evaluateUnary(node.operator, node.operand, context);
+    case 'binary':
+      return evaluateBinary(node.operator, node.left, node.right, context);
+    case 'function':
+      return evaluateFunction(node.name, node.args, context);
+  }
+}
+
+function evaluateUnary(
+  operator: '+' | '-',
+  operand: Node,
+  context: EvalContext,
+): EvalValue {
+  const value = toNumber(evaluate(operand, context));
+  if (isCellError(value)) return value;
+  return operator === '-' ? -value : value;
+}
+
+function evaluateBinary(
+  operator: BinaryOperator,
+  leftNode: Node,
+  rightNode: Node,
+  context: EvalContext,
+): EvalValue {
+  const left = evaluate(leftNode, context);
+  if (isCellError(left)) return left;
+  const right = evaluate(rightNode, context);
+  if (isCellError(right)) return right;
+
+  switch (operator) {
+    case '=':
+      return compareValues(left as CellValue, right as CellValue) === 0;
+    case '<>':
+      return compareValues(left as CellValue, right as CellValue) !== 0;
+    case '>':
+      return compareValues(left as CellValue, right as CellValue) > 0;
+    case '<':
+      return compareValues(left as CellValue, right as CellValue) < 0;
+    case '>=':
+      return compareValues(left as CellValue, right as CellValue) >= 0;
+    case '<=':
+      return compareValues(left as CellValue, right as CellValue) <= 0;
+    default:
+      return arithmetic(operator, left, right);
+  }
+}
+
+function arithmetic(
+  operator: '+' | '-' | '*' | '/' | '^',
+  leftValue: EvalValue,
+  rightValue: EvalValue,
+): EvalValue {
+  const left = toNumber(leftValue);
+  if (isCellError(left)) return left;
+  const right = toNumber(rightValue);
+  if (isCellError(right)) return right;
+
+  let result: number;
+  switch (operator) {
+    case '+':
+      result = left + right;
+      break;
+    case '-':
+      result = left - right;
+      break;
+    case '*':
+      result = left * right;
+      break;
+    case '/':
+      if (right === 0) return divideByZero();
+      result = left / right;
+      break;
+    case '^':
+      result = left ** right;
+      break;
+  }
+
+  if (Number.isNaN(result)) return numError('result is not a number');
+  if (!Number.isFinite(result)) return numError('result is out of range');
+  return result;
+}
+
+function evaluateFunction(
+  name: string,
+  args: Node[],
+  context: EvalContext,
+): EvalValue {
+  switch (name) {
+    case 'IF':
+      return evaluateIf(args, context);
+    case 'SUM':
+    case 'AVERAGE':
+    case 'MIN':
+    case 'MAX':
+    case 'COUNT':
+      return evaluateAggregate(name, args, context);
+    case 'NOT':
+      return evaluateNot(args, context);
+    case 'AND':
+    case 'OR':
+      return evaluateLogical(name, args, context);
+    default:
+      return nameError(`Unknown function ${name}`);
+  }
+}
+
+/** `IF` evaluates only the branch it takes, so the other may safely be broken. */
+function evaluateIf(args: Node[], context: EvalContext): EvalValue {
+  if (args.length < 2 || args.length > 3) {
+    return valueError('IF expects 2 or 3 arguments');
+  }
+
+  const condition = toBoolean(evaluate(args[0], context));
+  if (isCellError(condition)) return condition;
+
+  if (condition) return evaluate(args[1], context);
+  return args.length === 3 ? evaluate(args[2], context) : false;
+}
+
+function evaluateNot(args: Node[], context: EvalContext): EvalValue {
+  if (args.length !== 1) return valueError('NOT expects 1 argument');
+  const value = toBoolean(evaluate(args[0], context));
+  if (isCellError(value)) return value;
+  return !value;
+}
+
+function evaluateLogical(
+  name: 'AND' | 'OR',
+  args: Node[],
+  context: EvalContext,
+): EvalValue {
+  if (args.length === 0) return valueError(`${name} expects at least 1 argument`);
+
+  let result = name === 'AND';
+  for (const arg of args) {
+    for (const value of expandArgument(arg, context)) {
+      const flag = toBoolean(value);
+      if (isCellError(flag)) return flag;
+      result = name === 'AND' ? result && flag : result || flag;
+    }
+  }
+  return result;
+}
+
+type AggregateName = 'SUM' | 'AVERAGE' | 'MIN' | 'MAX' | 'COUNT';
+
+function evaluateAggregate(
+  name: AggregateName,
+  args: Node[],
+  context: EvalContext,
+): EvalValue {
+  if (args.length === 0) return valueError(`${name} expects at least 1 argument`);
+
+  const numbers = collectNumbers(args, context);
+  if (isCellError(numbers)) return numbers;
+
+  switch (name) {
+    case 'COUNT':
+      return numbers.length;
+    case 'SUM':
+      return numbers.reduce((total, value) => total + value, 0);
+    case 'AVERAGE':
+      if (numbers.length === 0) return divideByZero('AVERAGE of no numeric values');
+      return numbers.reduce((total, value) => total + value, 0) / numbers.length;
+    case 'MIN':
+    case 'MAX': {
+      // Excel reports 0 rather than an error for an empty selection. Folded
+      // rather than spread, so a large range cannot overflow the call stack.
+      if (numbers.length === 0) return 0;
+      const pick = name === 'MIN' ? Math.min : Math.max;
+      return numbers.reduce((best, value) => pick(best, value));
+    }
+  }
+}
+
+/**
+ * Gather the numeric values an aggregate should operate on.
+ *
+ * Cells drawn from a range contribute only if they hold numbers — text,
+ * booleans and blanks are skipped, as in Excel. A value written directly as an
+ * argument is coerced instead, so `SUM(A1:A3, "5", TRUE)` adds 5 and 1.
+ */
+function collectNumbers(args: Node[], context: EvalContext): number[] | CellError {
+  const numbers: number[] = [];
+
+  for (const arg of args) {
+    if (arg.kind === 'range') {
+      for (const ref of expandRange(arg.start, arg.end)) {
+        const value = context.getValue(ref);
+        if (isCellError(value)) return value;
+        if (typeof value === 'number') numbers.push(value);
+      }
+      continue;
+    }
+
+    const value = evaluate(arg, context);
+    if (isCellError(value)) return value;
+    // A blank cell referenced directly contributes nothing.
+    if (value === null) continue;
+    const numeric = toNumber(value);
+    if (isCellError(numeric)) return numeric;
+    numbers.push(numeric);
+  }
+
+  return numbers;
+}
+
+/** Yield each value an argument stands for, flattening ranges. */
+function expandArgument(node: Node, context: EvalContext): EvalValue[] {
+  if (node.kind === 'range') {
+    return expandRange(node.start, node.end)
+      .map((ref) => context.getValue(ref))
+      .filter((value) => value !== null);
+  }
+  return [evaluate(node, context)];
+}
