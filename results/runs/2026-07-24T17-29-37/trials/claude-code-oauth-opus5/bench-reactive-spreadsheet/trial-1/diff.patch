C1', 3);\n    sheet.set('A2', '=SUM(A1:C1)');\n    expect(sheet.get('A2')).toBe(6);\n  });\n\n  it('sums a rectangular block', () => {\n    for (let row = 1; row <= 3; row++) {\n      for (const col of ['A', 'B', 'C']) {\n        sheet.set(`${col}${row}`, 1);\n      }\n    }\n    sheet.set('E1', '=SUM(A1:C3)');\n    expect(sheet.get('E1')).toBe(9);\n  });\n\n  it('accepts corners given in either order', () => {\n    sheet.set('A1', 1);\n    sheet.set('C3', 2);\n    sheet.set('E1', '=SUM(C3:A1)');\n    expect(sheet.get('E1')).toBe(3);\n  });\n\n  it('treats a single-cell range as that cell', () => {\n    sheet.set('A1', 7);\n    sheet.set('B1', '=SUM(A1:A1)');\n    expect(sheet.get('B1')).toBe(7);\n  });\n\n  it('spans multi-letter columns', () => {\n    sheet.set('Y1', 1);\n    sheet.set('Z1', 2);\n    sheet.set('AA1', 3);\n    sheet.set('AB1', '=SUM(Y1:AA1)');\n    expect(sheet.get('AB1')).toBe(6);\n  });\n\n  it('rejects a range used where a single value is required', () => {\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1:A3+1');\n    expect(sheet.get('B1')).toBe('#VALUE!');\n  });\n});\n\ndescribe('SUM', () => {\n  it('ignores text, booleans and blanks inside a range', () => {\n    const sheet = sampleSheet();\n    sheet.set('C1', '=SUM(A1:B5)');\n    expect(sheet.get('C1')).toBe(15);\n  });\n\n  it('accepts several arguments, mixing ranges and scalars', () => {\n    const sheet = sampleSheet();\n    sheet.set('C1', '=SUM(A1:A3, 10, A5)');\n    expect(sheet.get('C1')).toBe(21);\n  });\n\n  it('is zero over an entirely empty range', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('C1', '=SUM(A1:A9)');\n    expect(sheet.get('C1')).toBe(0);\n  });\n});\n\ndescribe('AVERAGE', () => {\n  it('averages the numeric values in a range', () => {\n    const sheet = sampleSheet();\n    sheet.set('C1', '=AVERAGE(A1:A5)');\n    expect(sheet.get('C1')).toBe(3);\n  });\n\n  it('divides by the count of numbers, not the size of the range', () => {\n    const sheet = sampleSheet();\n    sheet.set('C1', '=AVERAGE(A1:B5)');\n    expect(sheet.get('C1')).toBe(3);\n  });\n\n  it('reports #DIV/0! when there is nothing to average', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('C1', '=AVERAGE(A1:A5)');\n    expect(sheet.get('C1')).toBe('#DIV/0!');\n  });\n});\n\ndescribe('MIN, MAX and COUNT', () => {\n  it('finds the extremes of a range', () => {\n    const sheet = sampleSheet();\n    sheet.set('C1', '=MIN(A1:A5)');\n    sheet.set('C2', '=MAX(A1:A5)');\n    expect(sheet.get('C1')).toBe(1);\n    expect(sheet.get('C2')).toBe(5);\n  });\n\n  it('handles negative values', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', -5);\n    sheet.set('A2', -1);\n    sheet.set('A3', -3);\n    sheet.set('B1', '=MIN(A1:A3)');\n    sheet.set('B2', '=MAX(A1:A3)');\n    expect(sheet.get('B1')).toBe(-5);\n    expect(sheet.get('B2')).toBe(-1);\n  });\n\n  it('counts only numeric cells', () => {\n    const sheet = sampleSheet();\n    sheet.set('C1', '=COUNT(A1:B5)');\n    expect(sheet.get('C1')).toBe(5);\n  });\n\n  it('returns zero for MIN, MAX and COUNT over an empty range', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('C1', '=MIN(A1:A5)');\n    sheet.set('C2', '=MAX(A1:A5)');\n    sheet.set('C3', '=COUNT(A1:A5)');\n    expect(sheet.get('C1')).toBe(0);\n    expect(sheet.get('C2')).toBe(0);\n    expect(sheet.get('C3')).toBe(0);\n  });\n});\n\ndescribe('IF', () => {\n  const evaluate = (formula: string, a1: string | number | boolean = 50) => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', a1);\n    sheet.set('B1', formula);\n    return sheet.get('B1');\n  };\n\n  it('selects a branch on a numeric comparison', () => {\n    expect(evaluate('=IF(A1>30, \"big\", \"small\")', 50)).toBe('big');\n    expect(evaluate('=IF(A1>30, \"big\", \"small\")', 10)).toBe('small');\n  });\n\n  it('supports every comparison operator', () => {\n    expect(evaluate('=IF(A1>=50, 1, 0)', 50)).toBe(1);\n    expect(evaluate('=IF(A1<=50, 1, 0)', 50)).toBe(1);\n    expect(evaluate('=IF(A1<50, 1, 0)', 50)).toBe(0);\n    expect(evaluate('=IF(A1=50, 1, 0)', 50)).toBe(1);\n    expect(evaluate('=IF(A1<>50, 1, 0)', 50)).toBe(0);\n  });\n\n  it('compares strings', () => {\n    expect(evaluate('=IF(A1=\"yes\", 1, 0)', 'yes')).toBe(1);\n    expect(evaluate('=IF(A1=\"yes\", 1, 0)', 'no')).toBe(0);\n  });\n\n  it('accepts a bare boolean condition', () => {\n    expect(evaluate('=IF(TRUE, \"y\", \"n\")')).toBe('y');\n    expect(evaluate('=IF(FALSE, \"y\", \"n\")')).toBe('n');\n    expect(evaluate('=IF(A1, \"y\", \"n\")', true)).toBe('y');\n  });\n\n  it('treats a non-zero number as true', () => {\n    expect(evaluate('=IF(1, \"y\", \"n\")')).toBe('y');\n    expect(evaluate('=IF(0, \"y\", \"n\")')).toBe('n');\n  });\n\n  it('returns computed branches, not just literals', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 3);\n    sheet.set('B1', '=IF(A1>A2, A1-A2, A2-A1)');\n    expect(sheet.get('B1')).toBe(7);\n  });\n\n  it('nests', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 85);\n    sheet.set('B1', '=IF(A1>=90, \"A\", IF(A1>=80, \"B\", \"C\"))');\n    expect(sheet.get('B1')).toBe('B');\n  });\n\n  it('evaluates only the branch it takes', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('A2', 0);\n    // The false branch would divide by zero, but it is never evaluated.\n    sheet.set('B1', '=IF(A1=1, \"safe\", 1/A2)');\n    expect(sheet.get('B1')).toBe('safe');\n  });\n\n  it('defaults the omitted false branch to FALSE', () => {\n    expect(evaluate('=IF(A1>100, \"big\")', 1)).toBe(false);\n  });\n\n  it('reacts to changes in the condition', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('B1', '=IF(A1>30, \"big\", \"small\")');\n    expect(sheet.get('B1')).toBe('small');\n\n    sheet.set('A1', 40);\n    expect(sheet.get('B1')).toBe('big');\n  });\n});\n\ndescribe('logical helpers', () => {\n  it('evaluates AND, OR and NOT', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', true);\n    sheet.set('A2', false);\n    sheet.set('B1', '=AND(A1, A1)');\n    sheet.set('B2', '=AND(A1, A2)');\n    sheet.set('B3', '=OR(A1, A2)');\n    sheet.set('B4', '=OR(A2, A2)');\n    sheet.set('B5', '=NOT(A1)');\n\n    expect(sheet.get('B1')).toBe(true);\n    expect(sheet.get('B2')).toBe(false);\n    expect(sheet.get('B3')).toBe(true);\n    expect(sheet.get('B4')).toBe(false);\n    expect(sheet.get('B5')).toBe(false);\n  });\n});\n\ndescribe('function names', () => {\n  it('are case-insensitive', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('A2', 2);\n    sheet.set('B1', '=sum(A1:A2)');\n    sheet.set('B2', '=Average(A1:A2)');\n    expect(sheet.get('B1')).toBe(3);\n    expect(sheet.get('B2')).toBe(1.5);\n  });\n\n  it('report #NAME? when unknown', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=BOGUS(1,2)');\n    expect(sheet.get('A1')).toBe('#NAME?');\n  });\n});\n\ndescribe('error values', () => {\n  it('reports division by zero', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=1/0');\n    expect(sheet.get('A1')).toBe('#DIV/0!');\n    expect(sheet.getDisplay('A1')).toBe('#DIV/0!');\n  });\n\n  it('reports #VALUE! for arithmetic on text', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 'hello');\n    sheet.set('B1', '=A1+1');\n    expect(sheet.get('B1')).toBe('#VALUE!');\n  });\n\n  it('coerces numeric text and booleans in arithmetic', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '5');\n    sheet.set('A2', true);\n    sheet.set('B1', '=A1+1');\n    sheet.set('B2', '=A2+1');\n    expect(sheet.get('B1')).toBe(6);\n    expect(sheet.get('B2')).toBe(2);\n  });\n\n  it('propagates an error through dependent formulas', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=1/0');\n    sheet.se