new file mode 100644
index 0000000..af4d9a6
--- /dev/null
+++ b/src/tokenizer.ts
@@ -0,0 +1,159 @@
+import { FormulaSyntaxError } from './errors.js';
+
+export type TokenType =
+  | 'number'
+  | 'string'
+  | 'identifier'
+  | 'operator'
+  | 'lparen'
+  | 'rparen'
+  | 'comma'
+  | 'colon'
+  | 'eof';
+
+export interface Token {
+  type: TokenType;
+  /** Raw text for most tokens; the decoded contents for string literals. */
+  value: string;
+  /** Numeric value, only present on `number` tokens. */
+  numberValue?: number;
+  /** Offset of the token within the formula body, for error messages. */
+  position: number;
+}
+
+/** Multi-character operators must be tried before their single-char prefixes. */
+const OPERATORS = ['<>', '>=', '<=', '+', '-', '*', '/', '^', '>', '<', '='];
+
+const isDigit = (char: string): boolean => char >= '0' && char <= '9';
+
+const isIdentifierStart = (char: string): boolean =>
+  (char >= 'A' && char <= 'Z') || (char >= 'a' && char <= 'z') || char === '_';
+
+const isIdentifierPart = (char: string): boolean =>
+  isIdentifierStart(char) || isDigit(char) || char === '.';
+
+/**
+ * Split a formula body (the text after the leading `=`) into tokens.
+ */
+export function tokenize(source: string): Token[] {
+  const tokens: Token[] = [];
+  let index = 0;
+
+  while (index < source.length) {
+    const char = source[index];
+
+    if (char === ' ' || char === '\t' || char === '\n' || char === '\r') {
+      index++;
+      continue;
+    }
+
+    if (isDigit(char) || (char === '.' && isDigit(source[index + 1] ?? ''))) {
+      const start = index;
+      while (isDigit(source[index] ?? '')) index++;
+      if (source[index] === '.') {
+        index++;
+        while (isDigit(source[index] ?? '')) index++;
+      }
+      // Exponent, but only when it is actually followed by digits so that
+      // `1E` degrades to a number plus an identifier rather than an error.
+      if (source[index] === 'e' || source[index] === 'E') {
+        let lookahead = index + 1;
+        if (source[lookahead] === '+' || source[lookahead] === '-') lookahead++;
+        if (isDigit(source[lookahead] ?? '')) {
+          index = lookahead;
+          while (isDigit(source[index] ?? '')) index++;
+        }
+      }
+      const text = source.slice(start, index);
+      tokens.push({
+        type: 'number',
+        value: text,
+        numberValue: Number(text),
+        position: start,
+      });
+      continue;
+    }
+
+    if (char === '"' || char === "'") {
+      const literal = readString(source, index, char);
+      tokens.push(literal.token);
+      index = literal.end;
+      continue;
+    }
+
+    if (isIdentifierStart(char)) {
+      const start = index;
+      while (index < source.length && isIdentifierPart(source[index])) index++;
+      tokens.push({
+        type: 'identifier',
+        value: source.slice(start, index),
+        position: start,
+      });
+      continue;
+    }
+
+    if (char === '(') {
+      tokens.push({ type: 'lparen', value: char, position: index++ });
+      continue;
+    }
+    if (char === ')') {
+      tokens.push({ type: 'rparen', value: char, position: index++ });
+      continue;
+    }
+    if (char === ',') {
+      tokens.push({ type: 'comma', value: char, position: index++ });
+      continue;
+    }
+    if (char === ':') {
+      tokens.push({ type: 'colon', value: char, position: index++ });
+      continue;
+    }
+
+    const operator = OPERATORS.find((op) => source.startsWith(op, index));
+    if (operator) {
+      tokens.push({ type: 'operator', value: operator, position: index });
+      index += operator.length;
+      continue;
+    }
+
+    throw new FormulaSyntaxError(
+      `Unexpected character "${char}" at position ${index}`,
+    );
+  }
+
+  tokens.push({ type: 'eof', value: '', position: source.length });
+  return tokens;
+}
+
+/**
+ * Read a quoted literal, returning the token and the offset just past the
+ * closing quote. A doubled quote character is an escaped quote, so
+ * `"say ""hi"""` decodes to `say "hi"`.
+ */
+function readString(
+  source: string,
+  start: number,
+  quote: string,
+): { token: Token; end: number } {
+  let index = start + 1;
+  let text = '';
+
+  while (index < source.length) {
+    const char = source[index];
+    if (char === quote) {
+      if (source[index + 1] === quote) {
+        text += quote;
+        index += 2;
+        continue;
+      }
+      return {
+        token: { type: 'string', value: text, position: start },
+        end: index + 1,
+      };
+    }
+    text += char;
+    index++;
+  }
+
+  throw new FormulaSyntaxError(`Unterminated string literal at position ${start}`);
+}
diff --git a/src/values.test.ts b/src/values.test.ts
new file mode 100644
index 0000000..e0f538f
--- /dev/null
+++ b/src/values.test.ts
@@ -0,0 +1,145 @@
+import { describe, expect, it } from 'vitest';
+import { Spreadsheet } from './index.js';
+import { compareValues, formatNumber, formatValue } from './values.js';
+
+/** Evaluate a formula in an otherwise empty sheet. */
+function evaluate(formula: string): unknown {
+  const sheet = new Spreadsheet();
+  sheet.set('Z1', formula);
+  return sheet.get('Z1');
+}
+
+describe('exponentiation', () => {
+  it('raises to a power', () => {
+    expect(evaluate('=2^3')).toBe(8);
+    expect(evaluate('=9^0.5')).toBe(3);
+  });
+
+  it('binds tighter than multiplication', () => {
+    expect(evaluate('=2*3^2')).toBe(18);
+  });
+
+  it('is right-associative', () => {
+    expect(evaluate('=2^3^2')).toBe(512);
+  });
+
+  it('accepts a signed exponent', () => {
+    expect(evaluate('=2^-1')).toBe(0.5);
+  });
+});
+
+describe('numeric limits', () => {
+  it('reports #NUM! when a result overflows', () => {
+    expect(evaluate('=1e308*10')).toBe('#NUM!');
+  });
+
+  it('reports #NUM! for an undefined result', () => {
+    expect(evaluate('=(-1)^0.5')).toBe('#NUM!');
+  });
+
+  it('renders a non-finite literal without crashing', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', Number.NaN);
+    sheet.set('A2', Number.POSITIVE_INFINITY);
+    expect(sheet.getDisplay('A1')).toBe('#NUM!');
+    expect(sheet.getDisplay('A2')).toBe('Infinity');
+  });
+});
+
+describe('conditions', () => {
+  it('rejects text used as a condition', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 'text');
+    sheet.set('B1', '=IF(A1, 1, 0)');
+    expect(sheet.get('B1')).toBe('#VALUE!');
+  });
+
+  it('treats an empty cell as false', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('B1', '=IF(A1, "y", "n")');
+    expect(sheet.get('B1')).toBe('n');
+  });
+});
+
+describe('comparisons', () => {
+  const compare = (formula: string) => evaluate(formula);
+
+  it('orders numbers below text, and text below booleans', () => {
+    expect(compare('=1<"a"')).toBe(true);
+    expect(compare('="a"<TRUE')).toBe(true);
+    expect(compare('=100>"a"')).toBe(false);
+  });
+
+  it('orders booleans with FALSE below TRUE', () => {
+    expect(compare('=TRUE>FALSE')).toBe(true);
+    expect(compare('=TRUE=TRUE')).toBe(true);
+  });
+
+  it('compares text case-sensitively', () => {
+    expect(compare('="a"="A"')).toBe(false);
+    expect(compare('="abc"<"abd"')).toBe(true);
+  });
+
+  it('gives an empty cell the type of the other operand', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('B1', '=A1=0');
+    sheet.set('B2', '=A1=""');
+    sheet.set('B3', '=A1=FALSE');
+    expect(sheet.get('B1')).toBe(true);
+    expect(sheet.get('B2')).toBe(true);
+    expect(sheet.get('B3')).toBe(true);
+  });
+
+  it('exposes the same ordering through compareValues', () => {
+    expect(compareValues(1, 2)).toBe(-1);
+    expect(compareValues(2, 2)).toBe(0);
+    expect(compareValues(3, 2)).toBe(1);
+    expect(compareValues('a', 'b')).toBe(-1);
+    expect(compareValues(false, true)).toBe(-1);
+    expect(compareValues(null, null)).toBe(0);
+    expect(compareValues(5, 'a')).toBe(-1);
+  });
+});
+
+describe('formatting', () => {
+  it('renders integers and decimals plainly', () => {
+    expect(formatNumber(30)).toBe('30');
+    expect(formatNumber(-4)).toBe('-4');
+    expect(formatNumber(2.5)).toBe('2.5');
+  });
+
+  it('trims floating-point representation error', () => {
+    expect(formatNumber(0.1 + 0.2)).toBe('0.3');
+    expect(formatNumber(1 / 3)).toBe('0.333333333333333');
+  });
+
+  it('renders each value type', () => {
+    expect(formatValue(null)).toBe('');
+    expect(formatValue(true)).toBe('TRUE');
+    expect(formatValue(false)).toBe('FALSE');
+    expect(formatValue('text')).toBe('text');
+    expect(formatValue(7)).toBe('7');
+  });
+});
+
+describe('aggregate argument handling', () => {
+  it('rejects text passed directly to an aggregate', () => {
+    expect(evaluate('=SUM(1, "abc")')).toBe('#VALUE!');
+  });
+
+  it('skips a directly referenced empty cell', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 5);
+    sheet.set('B1', '=COUNT(A1, A2)');
+    expect(sheet.get('B1')).toBe(1);
+  });
+
+  it('requires at least one argument', () => {
+    expect(evaluate('=SUM()')).toBe('#VALUE!');
+  });
+
+  it('rejects the wrong number of IF arguments', () => {
+    expect(evaluate('=IF(TRUE)')).toBe('#VALUE!');
+    expect(evaluate('=IF(TRUE,1,2,3)')).toBe('#VALUE!');
+  });
+});
