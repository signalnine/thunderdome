+import { describe, expect, it } from 'vitest';
+import { FormulaSyntaxError } from './errors.js';
+import { collectReferences, parseFormula } from './parser.js';
+import { tokenize } from './tokenizer.js';
+
+describe('tokenize', () => {
+  const types = (source: string) => tokenize(source).map((token) => token.type);
+
+  it('classifies the basic token kinds', () => {
+    expect(types('A1+1')).toEqual(['identifier', 'operator', 'number', 'eof']);
+    expect(types('SUM(A1:A2)')).toEqual([
+      'identifier',
+      'lparen',
+      'identifier',
+      'colon',
+      'identifier',
+      'rparen',
+      'eof',
+    ]);
+  });
+
+  it('reads multi-character operators as one token', () => {
+    expect(tokenize('1<>2')[1].value).toBe('<>');
+    expect(tokenize('1>=2')[1].value).toBe('>=');
+    expect(tokenize('1<=2')[1].value).toBe('<=');
+  });
+
+  it('decodes string literals, including escaped quotes', () => {
+    expect(tokenize('"hi"')[0].value).toBe('hi');
+    expect(tokenize('"say ""hi"""')[0].value).toBe('say "hi"');
+    expect(tokenize("'single'")[0].value).toBe('single');
+  });
+
+  it('continues correctly after a string literal', () => {
+    expect(types('"a"=1')).toEqual(['string', 'operator', 'number', 'eof']);
+    expect(tokenize('IF(1,"a","b")').filter((t) => t.type === 'string')).toHaveLength(
+      2,
+    );
+  });
+
+  it('reads exponent notation but does not swallow a trailing letter', () => {
+    expect(tokenize('1e3')[0].numberValue).toBe(1000);
+    expect(tokenize('1e-3')[0].numberValue).toBe(0.001);
+    expect(types('1E')).toEqual(['number', 'identifier', 'eof']);
+  });
+
+  it('rejects stray characters and unterminated strings', () => {
+    expect(() => tokenize('1 # 2')).toThrow(FormulaSyntaxError);
+    expect(() => tokenize('"oops')).toThrow(FormulaSyntaxError);
+  });
+});
+
+describe('parseFormula', () => {
+  it('accepts the formula with or without its leading =', () => {
+    expect(parseFormula('=1+2')).toEqual(parseFormula('1+2'));
+  });
+
+  it('builds a left-associative tree for equal precedence', () => {
+    expect(parseFormula('=1-2-3')).toEqual({
+      kind: 'binary',
+      operator: '-',
+      left: {
+        kind: 'binary',
+        operator: '-',
+        left: { kind: 'number', value: 1 },
+        right: { kind: 'number', value: 2 },
+      },
+      right: { kind: 'number', value: 3 },
+    });
+  });
+
+  it('binds * more tightly than +', () => {
+    const node = parseFormula('=1+2*3');
+    expect(node).toMatchObject({ kind: 'binary', operator: '+' });
+  });
+
+  it('binds comparison loosest', () => {
+    const node = parseFormula('=1+2>3');
+    expect(node).toMatchObject({ kind: 'binary', operator: '>' });
+  });
+
+  it('normalises references and function names', () => {
+    expect(parseFormula('=aa1')).toEqual({ kind: 'reference', ref: 'AA1' });
+    expect(parseFormula('=sum(a1:b2)')).toMatchObject({
+      kind: 'function',
+      name: 'SUM',
+      args: [{ kind: 'range', start: 'A1', end: 'B2' }],
+    });
+  });
+
+  it('parses boolean literals', () => {
+    expect(parseFormula('=TRUE')).toEqual({ kind: 'boolean', value: true });
+    expect(parseFormula('=false')).toEqual({ kind: 'boolean', value: false });
+  });
+
+  it('parses a call with no arguments', () => {
+    expect(parseFormula('=FOO()')).toMatchObject({ name: 'FOO', args: [] });
+  });
+
+  it('rejects malformed input', () => {
+    expect(() => parseFormula('=1+')).toThrow(FormulaSyntaxError);
+    expect(() => parseFormula('=(1')).toThrow(FormulaSyntaxError);
+    expect(() => parseFormula('=1 2')).toThrow(FormulaSyntaxError);
+    expect(() => parseFormula('=A1:')).toThrow(FormulaSyntaxError);
+    expect(() => parseFormula('=hello')).toThrow(FormulaSyntaxError);
+    expect(() => parseFormula('=')).toThrow(FormulaSyntaxError);
+  });
+});
+
+describe('collectReferences', () => {
+  const refs = (formula: string) => [...collectReferences(parseFormula(formula))];
+
+  it('finds plain references', () => {
+    expect(refs('=A1+B2').sort()).toEqual(['A1', 'B2']);
+  });
+
+  it('expands ranges into their member cells', () => {
+    expect(refs('=SUM(A1:A3)')).toEqual(['A1', 'A2', 'A3']);
+  });
+
+  it('descends into nested calls and both IF branches', () => {
+    expect(refs('=IF(A1>0, B1, SUM(C1:C2))').sort()).toEqual([
+      'A1',
+      'B1',
+      'C1',
+      'C2',
+    ]);
+  });
+
+  it('deduplicates repeated references', () => {
+    expect(refs('=A1+A1*A1')).toEqual(['A1']);
+  });
+
+  it('returns nothing for a constant formula', () => {
+    expect(refs('=1+2')).toEqual([]);
+  });
+});
