@@ -0,0 +1,107 @@
+import type { DependencyNode, DepsService, PluginManifest, RegistryService } from '../types.js';
+
+const MAX_DEPTH = 32;
+
+function dependencyNames(manifest: PluginManifest | null): string[] {
+  if (!manifest || !manifest.dependencies) return [];
+  return Object.keys(manifest.dependencies);
+}
+
+export function createDepsService(): DepsService {
+  /**
+   * Builds the dependency tree rooted at `name`. Nodes already present on the
+   * current path are not expanded again, so cyclic graphs terminate.
+   */
+  function buildTree(name: string, registry: RegistryService): DependencyNode {
+    const walk = (current: string, path: Set<string>, depth: number): DependencyNode => {
+      const manifest = registry.get(current);
+      const node: DependencyNode = {
+        name: current,
+        version: manifest ? manifest.version : '0.0.0',
+        dependencies: [],
+      };
+      if (path.has(current) || depth >= MAX_DEPTH) return node;
+
+      const nextPath = new Set(path);
+      nextPath.add(current);
+      for (const dep of dependencyNames(manifest)) {
+        node.dependencies.push(walk(dep, nextPath, depth + 1));
+      }
+      return node;
+    };
+
+    return walk(name, new Set<string>(), 0);
+  }
+
+  /** DFS cycle detection; returns every distinct cycle reachable from `name`. */
+  function detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const cycles: string[][] = [];
+    const seenCycles = new Set<string>();
+    const inProgress = new Set<string>();
+    const finished = new Set<string>();
+    const path: string[] = [];
+
+    const visit = (current: string): void => {
+      if (inProgress.has(current)) {
+        const start = path.indexOf(current);
+        const cycle = start >= 0 ? path.slice(start) : [current];
+        const key = [...cycle].sort().join('|');
+        if (!seenCycles.has(key)) {
+          seenCycles.add(key);
+          cycles.push(cycle);
+        }
+        return;
+      }
+      if (finished.has(current)) return;
+
+      inProgress.add(current);
+      path.push(current);
+      for (const dep of dependencyNames(registry.get(current))) {
+        visit(dep);
+      }
+      path.pop();
+      inProgress.delete(current);
+      finished.add(current);
+    };
+
+    visit(name);
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  /** Post-order DFS: every dependency appears before the plugin that needs it. */
+  function topologicalSort(name: string, registry: RegistryService): string[] {
+    const sorted: string[] = [];
+    const visited = new Set<string>();
+    const onPath = new Set<string>();
+
+    const visit = (current: string): void => {
+      if (visited.has(current) || onPath.has(current)) return;
+      onPath.add(current);
+      for (const dep of dependencyNames(registry.get(current))) {
+        visit(dep);
+      }
+      onPath.delete(current);
+      visited.add(current);
+      sorted.push(current);
+    };
+
+    visit(name);
+    return sorted;
+  }
+
+  function flattenDependencies(name: string, registry: RegistryService): string[] {
+    return topologicalSort(name, registry).filter(dep => dep !== name);
+  }
+
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return detectCycles(name, registry) !== null;
+    },
+  };
+}
+
+export default createDepsService;
