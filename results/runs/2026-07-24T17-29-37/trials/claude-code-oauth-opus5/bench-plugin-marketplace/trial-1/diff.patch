+import vm from 'node:vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+/** Globals that are safe (and useful) to expose inside the sandbox. */
+function baseSandbox(): Record<string, unknown> {
+  return {
+    Math,
+    JSON,
+    Date,
+    console: {
+      log: () => undefined,
+      warn: () => undefined,
+      error: () => undefined,
+    },
+  };
+}
+
+function heapUsed(): number {
+  return process.memoryUsage().heapUsed;
+}
+
+function run(
+  code: string,
+  timeoutMs: number,
+  context: Record<string, unknown>
+): SandboxResult {
+  const sandbox: Record<string, unknown> = { ...baseSandbox(), ...context };
+  const started = performance.now();
+  const memoryBefore = heapUsed();
+
+  try {
+    const script = new vm.Script(`(function () {\n${code}\n})();`);
+    const output: unknown = script.runInNewContext(sandbox, {
+      timeout: timeoutMs,
+      displayErrors: true,
+    });
+    return {
+      success: true,
+      output,
+      duration: Math.max(0, Math.round(performance.now() - started)),
+      memoryUsed: Math.max(0, heapUsed() - memoryBefore),
+    };
+  } catch (error) {
+    return {
+      success: false,
+      output: undefined,
+      duration: Math.max(1, Math.round(performance.now() - started)),
+      memoryUsed: Math.max(0, heapUsed() - memoryBefore),
+      error: error instanceof Error ? error.message : String(error),
+    };
+  }
+}
+
+export function createRunner(): RunnerService {
+  return {
+    async execute(code: string, context: Record<string, unknown> = {}): Promise<SandboxResult> {
+      return run(code, DEFAULT_TIMEOUT_MS, context);
+    },
+
+    async executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context: Record<string, unknown> = {}
+    ): Promise<SandboxResult> {
+      const limit = Number.isFinite(timeoutMs) && timeoutMs > 0 ? timeoutMs : DEFAULT_TIMEOUT_MS;
+      return run(code, limit, context);
+    },
+  };
+}
+
+export default createRunner;
