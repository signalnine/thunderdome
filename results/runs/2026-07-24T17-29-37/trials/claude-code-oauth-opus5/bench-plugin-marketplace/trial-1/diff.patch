+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  plugin_name: string;
+  plugin_version: string;
+  user_id: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  created_at: string;
+}
+
+const SCHEMA = `
+  CREATE TABLE IF NOT EXISTS reviews (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    plugin_name TEXT NOT NULL,
+    plugin_version TEXT NOT NULL,
+    user_id TEXT NOT NULL,
+    rating INTEGER NOT NULL,
+    comment TEXT NOT NULL DEFAULT '',
+    flagged INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT NOT NULL
+  );
+`;
+
+function toReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.plugin_name,
+    pluginVersion: row.plugin_version,
+    userId: row.user_id,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged !== 0,
+    createdAt: row.created_at,
+  };
+}
+
+export function createReviewSystem(dbPath = ':memory:'): ReviewService {
+  const db = new Database(dbPath);
+  db.pragma('journal_mode = MEMORY');
+  db.exec(SCHEMA);
+
+  const insertStmt = db.prepare(`
+    INSERT INTO reviews
+      (plugin_name, plugin_version, user_id, rating, comment, flagged, created_at)
+    VALUES
+      (@pluginName, @pluginVersion, @userId, @rating, @comment, 0, @createdAt)
+  `);
+  const byIdStmt = db.prepare('SELECT * FROM reviews WHERE id = ?');
+  const byPluginStmt = db.prepare('SELECT * FROM reviews WHERE plugin_name = ? ORDER BY id');
+  const byUserStmt = db.prepare('SELECT * FROM reviews WHERE user_id = ? ORDER BY id');
+  const flaggedStmt = db.prepare('SELECT * FROM reviews WHERE flagged = 1 ORDER BY id');
+  const flagStmt = db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');
+  const deleteStmt = db.prepare('DELETE FROM reviews WHERE id = ?');
+  const countStmt = db.prepare('SELECT COUNT(*) AS count FROM reviews WHERE plugin_name = ?');
+  const avgStmt = db.prepare(
+    'SELECT AVG(rating) AS average FROM reviews WHERE plugin_name = ? AND flagged = 0'
+  );
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      if (!review || typeof review.pluginName !== 'string' || review.pluginName.length === 0) {
+        throw new Error('Invalid review: pluginName is required');
+      }
+      if (!Number.isFinite(review.rating) || review.rating < 1 || review.rating > 5) {
+        throw new Error('Invalid review: rating must be between 1 and 5');
+      }
+      const createdAt = new Date().toISOString();
+      const info = insertStmt.run({
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment ?? '',
+        createdAt,
+      });
+      const row = byIdStmt.get(Number(info.lastInsertRowid)) as ReviewRow;
+      return toReview(row);
+    },
+
+    getReviews(pluginName: string): Review[] {
+      return (byPluginStmt.all(pluginName) as ReviewRow[]).map(toReview);
+    },
+
+    /** Average rating across all versions, excluding flagged reviews. */
+    getAverageRating(pluginName: string): number {
+      const row = avgStmt.get(pluginName) as { average: number | null } | undefined;
+      if (!row || row.average === null) return 0;
+      return Math.round(row.average * 100) / 100;
+    },
+
+    flagReview(reviewId: number): void {
+      const info = flagStmt.run(reviewId);
+      if (info.changes === 0) {
+        throw new Error(`Review not found: ${reviewId}`);
+      }
+    },
+
+    getFlaggedReviews(): Review[] {
+      return (flaggedStmt.all() as ReviewRow[]).map(toReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      return deleteStmt.run(reviewId).changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      return (byUserStmt.all(userId) as ReviewRow[]).map(toReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = countStmt.get(pluginName) as { count: number };
+      return row.count;
+    },
+  };
+}
+
+export default createReviewSystem;
