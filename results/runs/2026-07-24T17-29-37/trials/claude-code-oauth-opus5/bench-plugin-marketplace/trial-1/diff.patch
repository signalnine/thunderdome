+++ b/src/registry/index.ts
@@ -0,0 +1,165 @@
+import Database from 'better-sqlite3';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+interface PluginRow {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies: string;
+  entry_point: string;
+  permissions: string;
+}
+
+const SCHEMA = `
+  CREATE TABLE IF NOT EXISTS plugins (
+    name TEXT NOT NULL,
+    version TEXT NOT NULL,
+    description TEXT NOT NULL DEFAULT '',
+    author TEXT NOT NULL DEFAULT '',
+    dependencies TEXT NOT NULL DEFAULT '{}',
+    entry_point TEXT NOT NULL DEFAULT '',
+    permissions TEXT NOT NULL DEFAULT '[]',
+    PRIMARY KEY (name, version)
+  );
+`;
+
+function parseJson<T>(raw: string, fallback: T): T {
+  try {
+    return JSON.parse(raw) as T;
+  } catch {
+    return fallback;
+  }
+}
+
+function toManifest(row: PluginRow): PluginManifest {
+  return {
+    name: row.name,
+    version: row.version,
+    description: row.description,
+    author: row.author,
+    dependencies: parseJson<Record<string, string>>(row.dependencies, {}),
+    entryPoint: row.entry_point,
+    permissions: parseJson<string[]>(row.permissions, []),
+  };
+}
+
+/**
+ * Compares two version strings newest-first without depending on the resolver
+ * module. Falls back to lexicographic ordering for non-numeric versions.
+ */
+function compareVersionsDesc(a: string, b: string): number {
+  const partsA = a.split(/[.+-]/);
+  const partsB = b.split(/[.+-]/);
+  const len = Math.max(partsA.length, partsB.length);
+  for (let i = 0; i < len; i++) {
+    const rawA = partsA[i] ?? '';
+    const rawB = partsB[i] ?? '';
+    const numA = Number(rawA);
+    const numB = Number(rawB);
+    if (Number.isFinite(numA) && Number.isFinite(numB) && rawA !== '' && rawB !== '') {
+      if (numA !== numB) return numB - numA;
+      continue;
+    }
+    if (rawA !== rawB) return rawA < rawB ? 1 : -1;
+  }
+  return 0;
+}
+
+export function createRegistry(dbPath = ':memory:'): RegistryService {
+  const db = new Database(dbPath);
+  db.pragma('journal_mode = MEMORY');
+  db.exec(SCHEMA);
+
+  const insertStmt = db.prepare(`
+    INSERT OR REPLACE INTO plugins
+      (name, version, description, author, dependencies, entry_point, permissions)
+    VALUES
+      (@name, @version, @description, @author, @dependencies, @entryPoint, @permissions)
+  `);
+  const byNameStmt = db.prepare('SELECT * FROM plugins WHERE name = ?');
+  const byVersionStmt = db.prepare('SELECT * FROM plugins WHERE name = ? AND version = ?');
+  const allStmt = db.prepare('SELECT * FROM plugins');
+  const deleteStmt = db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?');
+  const versionsStmt = db.prepare('SELECT version FROM plugins WHERE name = ?');
+
+  function rowsFor(name: string): PluginRow[] {
+    return (byNameStmt.all(name) as PluginRow[]).sort((a, b) =>
+      compareVersionsDesc(a.version, b.version)
+    );
+  }
+
+  function write(manifest: PluginManifest): void {
+    insertStmt.run({
+      name: manifest.name,
+      version: manifest.version,
+      description: manifest.description ?? '',
+      author: manifest.author ?? '',
+      dependencies: JSON.stringify(manifest.dependencies ?? {}),
+      entryPoint: manifest.entryPoint ?? '',
+      permissions: JSON.stringify(manifest.permissions ?? []),
+    });
+  }
+
+  function getVersion(name: string, version: string): PluginManifest | null {
+    const row = byVersionStmt.get(name, version) as PluginRow | undefined;
+    return row ? toManifest(row) : null;
+  }
+
+  return {
+    register(manifest: PluginManifest): void {
+      if (!manifest || typeof manifest.name !== 'string' || manifest.name.length === 0) {
+        throw new Error('Invalid manifest: name is required');
+      }
+      if (typeof manifest.version !== 'string' || manifest.version.length === 0) {
+        throw new Error('Invalid manifest: version is required');
+      }
+      write(manifest);
+    },
+
+    /** Returns the highest registered version of a plugin, or null. */
+    get(name: string): PluginManifest | null {
+      const rows = rowsFor(name);
+      return rows.length > 0 ? toManifest(rows[0]) : null;
+    },
+
+    getVersion,
+
+    list(): PluginManifest[] {
+      return (allStmt.all() as PluginRow[]).map(toManifest);
+    },
+
+    search(query: string): PluginManifest[] {
+      const needle = (query ?? '').toLowerCase();
+      if (needle.length === 0) return [];
+      return (allStmt.all() as PluginRow[])
+        .filter(
+          row =>
+            row.name.toLowerCase().includes(needle) ||
+            row.description.toLowerCase().includes(needle)
+        )
+        .map(toManifest);
+    },
+
+    remove(name: string, version: string): boolean {
+      return deleteStmt.run(name, version).changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      return (versionsStmt.all(name) as Array<{ version: string }>)
+        .map(row => row.version)
+        .sort((a, b) => compareVersionsDesc(b, a));
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const existing = getVersion(name, version);
+      if (!existing) {
+        throw new Error(`Plugin not found: ${name}@${version}`);
+      }
+      const merged: PluginManifest = { ...existing, ...updates, name, version };
+      write(merged);
+    },
+  };
+}
+
+export default createRegistry;
