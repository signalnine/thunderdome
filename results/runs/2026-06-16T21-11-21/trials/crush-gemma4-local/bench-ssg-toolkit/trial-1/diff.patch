@@ -0,0 +1,32 @@
+import { Plugin, BuildContext, ContentFile } from '../core/types.js';
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      afterBuild: async (ctx: BuildContext): Promise<void> => {
+        const manifest: Record<string, string> = {};
+        for (const [path] of ctx.assets.entries()) {
+          const fileName = path.split('/').pop() || path;
+          manifest[fileName] = path;
+        }
+        ctx.data.set('asset-manifest', manifest);
+      },
+      transformContent: async (file: ContentFile, ctx: BuildContext): Promise<ContentFile> => {
+        let content = file.content;
+        const manifest = ctx.data.get('asset-manifest') as Record<string, string> | undefined;
+        
+        if (manifest) {
+          for (const [fileName, path] of Object.entries(manifest)) {
+            const regex = new RegExp(`(href|src)=["']${fileName}["']`, 'g');
+            content = content.replace(regex, `$1="${path}"`);
+          }
+        }
+        
+        return { ...file, content };
+      }
+    }
+  };
+}
diff --git a/src/plugins/markdown-ext.ts b/src/plugins/markdown-ext.ts
