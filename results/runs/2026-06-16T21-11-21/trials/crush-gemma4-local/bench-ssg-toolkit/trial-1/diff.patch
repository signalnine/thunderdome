@@ -0,0 +1,24 @@
+import { Plugin, BuildContext, ContentFile } from '../core/types.js';
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: async (file: ContentFile, ctx: BuildContext): Promise<ContentFile> => {
+        let content = file.content;
+        const codeBlockRegex = /<pre><code[^>]*>(.*?)<\/code><\/pre>/gs;
+        
+        content = content.replace(codeBlockRegex, (match) => {
+          if (!match.includes('class="language-')) {
+            return match.replace('<code', '<code class="language-unknown"');
+          }
+          return match;
+        });
+
+        return { ...file, content };
+      },
+    },
+  };
+}
