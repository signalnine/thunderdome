+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,59 @@
+import { Plugin, BuildContext, ContentFile } from '../core/types.js';
+import { marked } from 'marked';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: async (file: ContentFile, ctx: BuildContext): Promise<ContentFile> => {
+        let content = file.content;
+
+        // 1. Handle Admonitions :::type ... :::
+        const admonitionRegex = /:::(note|warning|tip)\n([\s\S]*?)\n:::/g;
+        content = content.replace(admonitionRegex, (_, type, text) => {
+          return `<div class="admonition admonition-${type}">${text.trim()}</div>`;
+        });
+
+        // 2. Handle Footnotes [^1] and [^1]: text
+        const footnotes: Record<string, string> = {};
+        const footnoteDefRegex = /^\[\^(\d+)\]:\s*(.*)$/gm;
+        let match;
+        while ((match = footnoteDefRegex.exec(content)) !== null) {
+          footnotes[match[1]] = match[2];
+        }
+
+        // Remove definitions from content
+        content = content.replace(/^\[\^(\d+)\]:\s*.*$/gm, '');
+
+        // Replace references [^1] with <sup><a href="#fn-1">1</a></sup>
+        const refRegex = /\[\^(\d+)\]/g;
+        content = content.replace(refRegex, (_, id) => {
+          return `<sup><a href="#fn-${id}">${id}</a></sup>`;
+        });
+
+        // Convert Markdown to HTML
+        const html = marked.parse(content) as string;
+
+        // Append footnotes section if any exist
+        if (Object.keys(footnotes).length > 0) {
+          let footnotesHtml = '<section class="footnotes"><ol>';
+          for (const [id, text] of Object.entries(footnotes)) {
+            footnotesHtml += `<li id="fn-${id}">${text}</li>`;
+          }
+          footnotesHtml += '</ol></section>';
+          return {
+            ...file,
+            content: html.trim() + '\n' + footnotesHtml,
+          };
+        }
+
+        return {
+          ...file,
+          content: html.trim(),
+        };
+      },
+    },
+  };
+}
