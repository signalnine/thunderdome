@@ -0,0 +1,33 @@
+import { Plugin, BuildContext, ContentFile } from '../core/types.js';
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      afterBuild: async (ctx: BuildContext): Promise<void> => {
+        const tagsIndex: Record<string, string[]> = {};
+        const categoriesIndex: Record<string, string[]> = {};
+
+        for (const file of ctx.files) {
+          if (file.tags) {
+            for (const tag of file.tags) {
+              if (!tagsIndex[tag]) tagsIndex[tag] = [];
+              tagsIndex[tag].push(file.slug);
+            }
+          }
+          
+          const category = file.metadata.category as string;
+          if (category) {
+            if (!categoriesIndex[category]) categoriesIndex[category] = [];
+            categoriesIndex[category].push(file.slug);
+          }
+        }
+
+        ctx.data.set('tags-index', tagsIndex);
+        ctx.data.set('categories-index', categoriesIndex);
+      },
+    },
+  };
+}
