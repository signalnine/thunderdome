@@ -0,0 +1,47 @@
+import { Plugin } from '../core/types.js';
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      afterBuild: async (ctx) => {
+        const tagsMap: Record<string, string[]> = {};
+        const categoriesMap: Record<string, string[]> = {};
+
+        for (const file of ctx.files) {
+          // Process tags
+          if (file.tags) {
+            for (const tag of file.tags) {
+              if (!tagsMap[tag]) tagsMap[tag] = [];
+              tagsMap[tag].push(`${file.slug}.html`);
+            }
+          }
+
+          // Process categories from metadata
+          const category = file.metadata.category as string;
+          if (category) {
+            if (!categoriesMap[category]) categoriesMap[category] = [];
+            categoriesMap[category].push(`${file.slug}.html`);
+          }
+        }
+
+        ctx.data.set('tags', tagsMap);
+        ctx.data.set('categories', categoriesMap);
+
+        // Generate tag pages
+        for (const [tag, files] of Object.entries(tagsMap)) {
+          const content = `<h1>Tag: ${tag}</h1><ul>${files.map(f => `<li><a href="${f}">${f}</a></li>`).join('')}</ul>`;
+          ctx.output.set(`tags/${tag}.html`, content);
+        }
+
+        // Generate category pages
+        for (const [category, files] of Object.entries(categoriesMap)) {
+          const content = `<h1>Category: ${category}</h1><ul>${files.map(f => `<li><a href="${f}">${f}</a></li>`).join('')}</ul>`;
+          ctx.output.set(`categories/${category}.html`, content);
+        }
+      },
+    },
+  };
+}
