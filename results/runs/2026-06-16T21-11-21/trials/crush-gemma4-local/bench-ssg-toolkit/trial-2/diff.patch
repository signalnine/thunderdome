+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,62 @@
+import { Plugin } from '../core/types.js';
+import { marked } from 'marked';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: async (file, ctx) => {
+        let content = file.content;
+
+        // Handle admonitions :::note, :::warning, :::tip
+        // Using a more robust regex to handle possible whitespace around :::
+        const admonitionRegex = /:::(note|warning|tip)\s*\n([\s\S]*?)\n\s*:::/g;
+        content = content.replace(admonitionRegex, (_, type, text) => {
+          return `<div class="admonition admonition-${type}">${text.trim()}</div>`;
+        });
+
+        // Handle footnotes [^1]
+        const footnoteRefRegex = /\[\^(\d+)\]/g;
+        content = content.replace(footnoteRefRegex, (_, num) => {
+          return `<sup><a href="#fn-${num}">${num}</a></sup>`;
+        });
+
+        const footnotes: Record<string, string> = {};
+        const footnoteDefRegex = /^\[\^(\d+)\]:\s*(.*)$/gm;
+        let match;
+        while ((match = footnoteDefRegex.exec(content)) !== null) {
+          footnotes[match[1]] = match[2].trim();
+        }
+
+        content = content.replace(/^\[\^(\d+)\]:.*$/gm, '');
+
+        const html = await new Promise<string>((resolve) => {
+          marked.parse(content, (err, tokens) => {
+            if (err) resolve('');
+            else resolve(tokens);
+          });
+        });
+
+        const footnoteKeys = Object.keys(footnotes).sort((a, b) => Number(a) - Number(b));
+        if (footnoteKeys.length > 0) {
+          let footnoteSection = '<section class="footnotes"><ol>';
+          for (const key of footnoteKeys) {
+            footnoteSection += `<li id="fn-${key}">${footnotes[key]}</li>`;
+          }
+          footnoteSection += '</ol></section>';
+          return {
+            ...file,
+            content: html + footnoteSection,
+          };
+        }
+
+        return {
+          ...file,
+          content: html,
+        };
+      },
+    },
+  };
+}
