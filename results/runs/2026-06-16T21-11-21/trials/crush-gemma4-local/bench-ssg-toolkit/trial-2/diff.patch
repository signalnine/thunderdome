@@ -0,0 +1,41 @@
+import { Plugin } from '../core/types.js';
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      afterBuild: async (ctx) => {
+        const manifest: Record<string, string> = {};
+        // A more generic asset regex for various formats
+        const assetRegex = /(href|src)=["'](.+?)["']/g;
+        
+        for (const [path, content] of ctx.output.entries()) {
+          let updatedContent = content;
+          let match;
+          // Reset regex index due to global flag
+          assetRegex.lastIndex = 0;
+          
+          while ((match = assetRegex.exec(content)) !== null) {
+            const attr = match[1];
+            const assetPath = match[2];
+            
+            // Skip absolute URLs or data URIs
+            if (assetPath.startsWith('http') || assetPath.startsWith('data:')) {
+              continue;
+            }
+
+            const newPath = `/assets/${assetPath}`;
+            manifest[assetPath] = newPath;
+            updatedContent = updatedContent.replace(`${attr}="${assetPath}"`, `${attr}="${newPath}"`);
+            updatedContent = updatedContent.replace(`${attr}='${assetPath}'`, `${attr}='${newPath}'`);
+          }
+          ctx.output.set(path, updatedContent);
+        }
+        
+        ctx.data.set('asset-manifest', manifest);
+      },
+    },
+  };
+}
diff --git a/src/plugins/markdown-ext.ts b/src/plugins/markdown-ext.ts
