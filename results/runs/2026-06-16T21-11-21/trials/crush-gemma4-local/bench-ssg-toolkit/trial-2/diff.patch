@@ -0,0 +1,31 @@
+import { Plugin } from '../core/types.js';
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: async (file, ctx) => {
+        // The regex should match both raw markdown-like code blocks (if any) 
+        // and HTML-style code blocks if they were already transformed.
+        // However, since transformContent happens BEFORE template rendering, 
+        // and markdown-ext happens BEFORE this (if ordered), we expect 
+        // markdown-ext to have already produced HTML code blocks.
+        
+        // Let's assume markdown-ext produces: <pre><code class="language-js">...</code></pre>
+        // We want to add 'highlight-js' class or similar.
+        
+        const codeBlockRegex = /<pre><code class="language-([\w-]+)">([\s\S]*?)<\/code><\/pre>/g;
+        const content = file.content.replace(codeBlockRegex, (_, lang, code) => {
+          return `<pre><code class="language-${lang} highlight-${lang}">${code}</code></pre>`;
+        });
+
+        return {
+          ...file,
+          content,
+        };
+      },
+    },
+  };
+}
