+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,54 @@
+import { Plugin, BuildContext, ContentFile } from '../core/types.js';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: async (file: ContentFile, ctx: BuildContext): Promise<ContentFile> => {
+        let content = file.content;
+
+        // 1. Admonitions: :::type\ncontent\n:::
+        content = content.replace(/:::(note|warning|tip)\n([\s\S]*?)\n:::/g, '<div class="admonition admonition-$1">$2</div>');
+
+        // 2. Footnote definitions: [^1]: content
+        const footnotes: string[] = [];
+        content = content.replace(/^\[\^(\d+)\]: (.*)$/gm, (match, id, text) => {
+          footnotes.push(`<li id="fn-${id}">${text} <a href="#ref-${id}">&#8617;</a></li>`);
+          return '';
+        });
+
+        // 3. Footnote references: [^1]
+        content = content.replace(/\[\^(\d+)\]/g, '<sup id="ref-$1"><a href="#fn-$1">$1</a></sup>');
+
+        // 4. Headers
+        content = content.replace(/^# (.*$)/gm, '<h1>$1</h1>');
+        content = content.replace(/^## (.*$)/gm, '<h2>$1</h2>');
+
+        // 5. Bold/Italic
+        content = content.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
+        content = content.replace(/\*(.*?)\*/g, '<em>$1</em>');
+
+        // 6. Paragraphs (split by double newline, wrap in <p> if not a block element)
+        const blocks = content.split(/\n\n+/);
+        const processedBlocks = blocks.map(block => {
+          const trimmed = block.trim();
+          if (!trimmed) return '';
+          if (/^<(h1|h2|div|li|section|ol|ul)/.test(trimmed)) {
+            return trimmed;
+          }
+          return `<p>${trimmed}</p>`;
+        });
+        content = processedBlocks.join('\n');
+
+        // 7. Append footnotes
+        if (footnotes.length > 0) {
+          content += '\n<section class="footnotes">\n<ol>\n' + footnotes.join('\n') + '\n</ol>\n</section>';
+        }
+
+        return { ...file, content };
+      }
+    }
+  };
+}
