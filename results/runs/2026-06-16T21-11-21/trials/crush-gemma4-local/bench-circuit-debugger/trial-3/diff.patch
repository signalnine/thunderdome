+import { expect, test } from 'vitest';
+import { simulate, findSwappedWires, Gate } from '../src/index';
+
+test('simulate: basic AND gate', () => {
+  const gates: Gate[] = [{ op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' }];
+  const inputs = { x00: 1, y00: 1 };
+  const result = simulate(gates, inputs);
+  expect(result.z00).toBe(1);
+});
+
+test('simulate: basic OR gate', () => {
+  const gates: Gate[] = [{ op: 'OR', in1: 'x00', in2: 'y00', out: 'z00' }];
+  const inputs = { x00: 1, y00: 0 };
+  const result = simulate(gates, inputs);
+  expect(result.z00).toBe(1);
+});
+
+test('simulate: basic XOR gate', () => {
+  const gates: Gate[] = [{ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' }];
+  const inputs = { x00: 1, y00: 1 };
+  const result = simulate(gates, inputs);
+  expect(result.z00).toBe(0);
+});
+
+test('simulate: multi-step circuit', () => {
+  const gates: Gate[] = [
+    { op: 'XOR', in1: 'x00', in2: 'y00', out: 'c00' },
+    { op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' },
+    { op: 'XOR', in1: 'x01', in2: 'c00', out: 'z01' },
+  ];
+  const inputs = { x00: 1, y00: 1, x01: 0 };
+  // x00 XOR y00 = 0 (c00)
+  // x00 AND y00 = 1 (z00)
+  // x01 XOR c00 = 0 XOR 0 = 0 (z01)
+  const result = simulate(gates, inputs);
+  expect(result.z00).toBe(1);
+  expect(result.c00).toBe(0);
+  expect(result.z01).toBe(0);
+});
+
+test('findSwappedWires: placeholder', () => {
+  const gates: Gate[] = [];
+  expect(() => findSwappedWires(gates)).toThrow();
+});
