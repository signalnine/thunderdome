+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;   // input wire name
+  in2: string;   // input wire name
+  out: string;   // output wire name
+}
+
+/**
+ * Simulates a logic gate circuit.
+ * 
+ * @param gates An array of gates in the circuit.
+ * @param inputs A record of initial wire values.
+ * @returns A record of final wire values.
+ */
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const wireValues: Record<string, number> = { ...inputs };
+  const gateStatus = new Array(gates.length).fill(false);
+  const pendingGates = new Set<number>();
+
+  for (let i = 0; i < gates.length; i++) {
+    pendingGates.add(i);
+  }
+
+  while (pendingGates.size > 0) {
+    let progress = false;
+    for (const gateIdx of pendingGates) {
+      const gate = gates[gateIdx];
+      const val1 = wireValues[gate.in1];
+      const val2 = wireValues[gate.in2];
+
+      if (val1 !== undefined && val2 !== undefined) {
+        let result: number;
+        if (gate.op === 'AND') {
+          result = val1 & val2;
+        } else if (gate.op === 'OR') {
+          result = val1 | val2;
+        } else if (gate.op === 'XOR') {
+          result = val1 ^ val2;
+        } else {
+          throw new Error(`Unknown gate operation: ${gate.op}`);
+        }
+
+        wireValues[gate.out] = result;
+        pendingGates.delete(gateIdx);
+        progress = true;
+      }
+    }
+
+    if (!progress && pendingGates.size > 0) {
+      throw new Error('Circuit contains cycles or missing inputs');
+    }
+  }
+
+  return wireValues;
+}
+
