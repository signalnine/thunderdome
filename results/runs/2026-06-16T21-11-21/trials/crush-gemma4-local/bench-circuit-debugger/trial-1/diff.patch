+import { describe, it, expect } from 'vitest';
+import { simulate, findSwappedWires, Gate } from '../src/index';
+
+function createCorrectAdder(bits: number): Gate[] {
+  const gates: Gate[] = [];
+  
+  // Bit 0: Half adder
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+
+  for (let i = 1; i < bits; i++) {
+    const x = `x${String(i).padStart(2, '0')}`;
+    const y = `y${String(i).padStart(2, '0')}`;
+    const z = `z${String(i).padStart(2, '0')}`;
+    const c_in = i === 1 ? 'c00' : `c${String(i - 1).padStart(2, '0')}`;
+    const t = `t${String(i).padStart(2, '0')}`;
+    const a = `a${String(i).padStart(2, '0')}`;
+    const b = `b${String(i).padStart(2, '0')}`;
+    const c_out = `c${String(i).padStart(2, '0')}`;
+
+    gates.push({ op: 'XOR', in1: x, in2: y, out: t });
+    gates.push({ op: 'XOR', in1: t, in2: c_in, out: z });
+    gates.push({ op: 'AND', in1: x, in2: y, out: a });
+    gates.push({ op: 'AND', in1: t, in2: c_in, out: b });
+    gates.push({ op: 'OR',  in1: a, in2: b, out: c_out });
+  }
+
+  // Final carry bit (z_{bits})
+  // If bits=4, c03 -> z04
+  const last_c = `c${String(bits - 1).padStart(2, '0')}`;
+  gates.push({ op: 'XOR', in1: last_c, in2: 'x99', out: `z${String(bits).padStart(2, '0')}` }); 
+  // Wait, the example says c03 -> z04. But our Gate requires two inputs.
+  // The example says: "c03 -> z04 (bit 4: final carry becomes MSB of output)"
+  // But our interface is: in1: string; in2: string;
+  // I will adjust the adder to match the interface by using a dummy input for the last carry.
+  // Actually, let's look at the example again. 
+  // "c03 -> z04" implies a single input gate or a gate with a dummy input.
+  // Given the interface, I'll use a dummy wire 'dummy' and XOR it with c03.
+  
+  return gates;
+}
+
+// Corrected Adder to fit the interface
+function createValidAdder(bits: number): Gate[] {
+  const gates: Gate[] = [];
+  
+  // Bit 0
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+
+  for (let i = 1; i < bits; i++) {
+    const x = `x${String(i).padStart(2, '0')}`;
+    const y = `y${String(i).padStart(2, '0')}`;
+    const z = `z${String(i).padStart(2, '0')}`;
+    const c_in = i === 1 ? 'c00' : `c${String(i - 1).padStart(2, '0')}`;
+    const t = `t${String(i).padStart(2, '0')}`;
+    const a = `a${String(i).padStart(2, '0')}`;
+    const b = `b${String(i).padStart(2, '0')}`;
+    const c_out = `c${String(i).padStart(2, '0')}`;
+
+    gates.push({ op: 'XOR', in1: x, in2: y, out: t });
+    gates.push({ op: 'XOR', in1: t, in2: c_in, out: z });
+    gates.push({ op: 'AND', in1: x, in2: y, out: a });
+    gates.push({ op: 'AND', in1: t, in2: c_in, out: b });
+    gates.push({ op: 'OR',  in1: a, in2: b, out: c_out });
+  }
+
+  // Last carry
+  const last_c = `c${String(bits - 1).padStart(2, '0')}`;
+  const last_z = `z${String(bits).padStart(2, '0')}`;
+  // To simulate "c03 -> z04" using the provided Gate interface (which requires 2 inputs),
+  // we'll use a dummy wire 'zero' that is always 0.
+  gates.push({ op: 'XOR', in1: last_c, in2: 'zero', out: last_z });
+
+  return gates;
+}
+
+function swapGateOutputs(gates: Gate[], idx1: number, idx2: number): Gate[] {
+  const newGates = gates.map(g => ({ ...g }));
+  const temp = newGates[idx1].out;
+  newGates[idx1].out = newGates[idx2].out;
+  newGates[idx2].out = temp;
+  return newGates;
+}
+
+describe('Circuit Debugger', () => {
+  describe('simulate', () => {
+    it('should simulate a simple AND gate', () => {
+      const gates: Gate[] = [
+        { op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' }
+      ];
+      const inputs = { x00: 1, y00: 1 };
+      const result = simulate(gates, inputs);
+      expect(result['z00']).toBe(1);
+    });
+
+    it('should simulate a simple OR gate', () => {
+      const gates: Gate[] = [
+        { op: 'OR', in1: 'x00', in2: 'y00', out: 'z00' }
+      ];
+      const inputs = { x00: 1, y00: 0 };
+      const result = simulate(gates, inputs);
+      expect(result['z00']).toBe(1);
+    });
+
+    it('should simulate a simple XOR gate', () => {
+      const gates: Gate[] = [
+        { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' }
+      ];
+      const inputs = { x00: 1, y00: 1 };
+      const result = simulate(gates, inputs);
+      expect(result['z00']).toBe(0);
+    });
+
+    it('should simulate a multi-gate circuit', () => {
+      const gates: Gate[] = [
+        { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+        { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },
+        { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' }
+      ];
+      const inputs = { x00: 1, y00: 1, x01: 1, y01: 0 };
+      const result = simulate(gates, inputs);
+      expect(result['c00']).toBe(1);
+      expect(result['t01']).toBe(1);
+      expect(result['z01']).toBe(0);
+    });
+  });
+
+  describe('findSwappedWires', () => {
+    it('should find swapped wires in a 4-bit adder', () => {
+      const correctGates = createValidAdder(4);
+      // We need to pick 4 pairs of gate indices to swap.
+      // Let's pick indices that don't overlap.
+      // 0,1 | 2,3 | 4,5 | 6,7
+      let swappedGates = correctGates;
+      swappedGates = swapGateOutputs(swappedGates, 0, 1);
+      swappedGates = swapGateOutputs(swappedGates, 2, 3);
+      swappedGates = swapGateOutputs(swappedGates, 4, 5);
+      swappedGates = swapGateOutputs(swappedGates, 6, 7);
+
+      const expectedWires = [
+        correctGates[0].out, correctGates[1].out,
+        correctGates[2].out, correctGates[3].out,
+        correctGates[4].out, correctGates[5].out,
+        correctGates[6].out, correctGates[7].out
+      ].sort();
+
+      expect(findSwappedWires(swappedGates)).toEqual(expectedWires);
+    });
+
+    it('should handle larger bit sizes (up to 45 bits)', () => {
+      const bits = 45;
+      const correctGates = createValidAdder(bits);
+      // Indices for 4 pairs: 10, 11 | 20, 21 | 30, 31 | 40, 41
+      let swappedGates = correctGates;
+      swappedGates = swapGateOutputs(swappedGates, 10, 11);
+      swappedGates = swapGateOutputs(swappedGates, 20, 21);
+      swappedGates = swapGateOutputs(swappedGates, 30, 31);
+      swappedGates = swapGateOutputs(swappedGates, 40, 41);
+
+      const expectedWires = [
+        correctGates[10].out, correctGates[11].out,
+        correctGates[20].out, correctGates[21].out,
+        correctGates[30].out, correctGates[31].out,
+        correctGates[40].out, correctGates[41].out
+      ].sort();
+
+      const start = Date.now();
+      const result = findSwappedWires(swappedGates);
+      const end = Date.now();
+      
+      expect(result).toEqual(expectedWires);
+      expect(end - start).toBeLessThan(5000);
+    });
+  });
+});
