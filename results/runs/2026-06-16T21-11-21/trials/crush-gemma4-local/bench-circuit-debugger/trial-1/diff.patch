+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;   // input wire name
+  in2: string;   // input wire name
+  out: string;   // output wire name
+}
+
+/**
+ * Simulates the circuit and returns the final value of every wire.
+ */
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const wires: Record<string, number> = { ...inputs };
+  const computed = new Array(gates.length).fill(false);
+
+  let changed = true;
+  while (changed) {
+    changed = false;
+    for (let i = 0; i < gates.length; i++) {
+      if (computed[i]) continue;
+
+      const gate = gates[i];
+      const v1 = wires[gate.in1];
+      const v2 = wires[gate.in2];
+
+      if (v1 !== undefined && v2 !== undefined) {
+        let res: number;
+        if (gate.op === 'AND') res = v1 & v2;
+        else if (gate.op === 'OR') res = v1 | v2;
+        else if (gate.op === 'XOR') res = v1 ^ v2;
+        else throw new Error(`Unknown op: ${gate.op}`);
+
+        wires[gate.out] = res;
+        computed[i] = true;
+        changed = true;
+      }
+    }
+  }
+
+  return wires;
+}
+
+/**
+ * Finds the 8 wires involved in the 4 swapped output pairs.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  throw new Error("Not implemented");
+}
