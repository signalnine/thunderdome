+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;   // input wire name
+  in2: string;   // input wire name
+  out: string;   // output wire name
+}
+
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const wireValues: Record<string, number> = { ...inputs };
+  const computedWires = new Set<string>(Object.keys(inputs));
+  const remainingGates = [...gates];
+
+  while (remainingGates.length > 0) {
+    const initialLength = remainingGates.length;
+
+    for (let i = 0; i < remainingGates.length; i++) {
+      const gate = remainingGates[i];
+      if (computedWires.has(gate.in1) && computedWires.has(gate.in2)) {
+        const v1 = wireValues[gate.in1];
+        const v2 = wireValues[gate.in2];
+        let res: number;
+
+        if (gate.op === 'AND') res = v1 & v2;
+        else if (gate.op === 'OR') res = v1 | v2;
+        else if (gate.op === 'XOR') res = v1 ^ v2;
+        else throw new Error(`Unknown op: ${gate.op}`);
+
+        wireValues[gate.out] = res;
+        computedWires.add(gate.out);
+        remainingGates.splice(i, 1);
+        i--;
+      }
+    }
+
+    if (remainingGates.length === initialLength) {
+      throw new Error("Circular dependency detected or missing inputs");
+    }
+  }
+
+  return wireValues;
+}
