+import Database from 'better-sqlite3';
+import fs from 'fs';
+import path from 'path';
+
+export function createDb(dbPath?: string): Database {
+  const actualDbPath = dbPath || ':memory:';
+  const db = new Database(actualDbPath);
+
+  const schemaPath = path.resolve('/workspace/schema.sql');
+  const schema = fs.readFileSync(schemaPath, 'utf8');
+  
+  db.exec(schema);
+
+  return db;
+}
