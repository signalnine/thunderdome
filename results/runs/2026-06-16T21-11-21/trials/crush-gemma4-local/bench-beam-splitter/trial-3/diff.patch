@@ -0,0 +1,66 @@
+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index';
+
+describe('Beam Splitter', () => {
+  it('should handle the first example correctly', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(5);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('should handle the second example correctly', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(6);
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('should return 1 for a single source with no splitters', () => {
+    const grid = [
+      ['.', 'S', '.'],
+      ['.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(2); // (0,1) and (1,1)
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('should handle a beam exiting via the side', () => {
+    const grid = [
+      ['S', '.', '.'],
+      ['^', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    // S at (0,0)
+    // moves down to (1,0) which is '^'
+    // splits to (2,-1) [exit] and (2,1) [inside]
+    // (2,1) moves to (3,1) [exit]
+    // Cells: (0,0), (1,0), (2,-1) is out, (2,1), (3,1) is out
+    // Wait, cells must be within grid.
+    // (0,0), (1,0), (2,1) are the visited cells.
+    // Wait, (2,-1) is not a cell in the grid.
+    // The rules say: "Count the number of distinct cells visited by any beam."
+    // "A beam is absorbed when it moves outside the grid boundaries"
+    // Let's re-read: "Count the number of distinct cells visited by any beam. A cell counts once even if multiple beams pass through it. The source cell 'S' counts as visited. Splitter cells hit by beams count as visited."
+    // Usually, "visited cells" implies cells within the grid.
+    const grid2 = [
+      ['S', '.', '.'],
+      ['^', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    // (0,0) 'S' -> (1,0) '^'
+    // (1,0) splits to (2,-1) [exit] and (2,1)
+    // (2,1) moves to (3,1) [exit]
+    // Visited: (0,0), (1,0), (2,1)
+    expect(countBeamCells(grid2)).toBe(3);
+    expect(countBeamPaths(grid2)).toBe(2n);
+  });
+});
