+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+
+  let startRow = -1;
+  let startCol = -1;
+
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      if (grid[r][c] === 'S') {
+        startRow = r;
+        startCol = c;
+        break;
+      }
+    }
+    if (startRow !== -1) break;
+  }
+
+  if (startRow === -1) return 0;
+
+  const visited = new Set<string>();
+  // Queue of [row, col, direction]
+  // direction: 0: down, 1: down-left, 2: down-right
+  const queue: [number, number, number][] = [[startRow, startCol, 0]];
+  visited.add(`${startRow},${startCol}`);
+
+  const processed = new Set<string>();
+
+  while (queue.length > 0) {
+    const [r, c, dir] = queue.shift()!;
+    const state = `${r},${c},${dir}`;
+    if (processed.has(state)) continue;
+    processed.add(state);
+
+    let nextR = r;
+    let nextC = c;
+    let nextDirs: number[] = [];
+
+    if (grid[r][c] === '^') {
+      nextDirs = [1, 2];
+    } else {
+      nextDirs = [dir];
+    }
+
+    for (const d of nextDirs) {
+      if (d === 0) {
+        nextR = r + 1;
+        nextC = c;
+      } else if (d === 1) {
+        nextR = r + 1;
+        nextC = c - 1;
+      } else if (d === 2) {
+        nextR = r + 1;
+        nextC = c + 1;
+      }
+
+      if (nextR >= 0 && nextR < rows && nextC >= 0 && nextC < cols) {
+        visited.add(`${nextR},${nextC}`);
+        queue.push([nextR, nextC, d]);
+      }
+    }
+  }
+
+  return visited.size;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+
+  let startRow = -1;
+  let startCol = -1;
+
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      if (grid[r][c] === 'S') {
+        startRow = r;
+        startCol = c;
+        break;
+      }
+    }
+    if (startRow !== -1) break;
+  }
+
+  if (startRow === -1) return 0n;
+
+  // memo[row][col][direction] = number of paths from this state to exit
+  const memo = new Map<string, bigint>();
+
+  function solve(r: number, c: number, dir: number): bigint {
+    if (r < 0 || r >= rows || c < 0 || c >= cols) {
+      return 1n;
+    }
+
+    const state = `${r},${c},${dir}`;
+    if (memo.has(state)) return memo.get(state)!;
+
+    let paths = 0n;
+
+    if (grid[r][c] === '^') {
+      // Split: down-left (1) and down-right (2)
+      paths = solve(r + 1, c - 1, 1) + solve(r + 1, c + 1, 2);
+    } else {
+      // Continue current direction
+      if (dir === 0) {
+        paths = solve(r + 1, c, 0);
+      } else if (dir === 1) {
+        paths = solve(r + 1, c - 1, 1);
+      } else {
+        paths = solve(r + 1, c + 1, 2);
+      }
+    }
+
+    memo.set(state, paths);
+    return paths;
+  }
+
+  // Initial beam from 'S' moves straight down
+  return solve(startRow, startCol, 0);
+}
