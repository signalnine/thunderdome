@@ -0,0 +1,35 @@
+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index';
+
+describe('Beam Splitter', () => {
+  it('should count cells correctly for the simple example', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(5);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('should count cells and paths correctly for the two-splitter example', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(6);
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('should return 1 for a single source with no splitters', () => {
+    const grid = [
+      ['.', 'S', '.'],
+      ['.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(2); // (0,1) and (1,1)
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+});
