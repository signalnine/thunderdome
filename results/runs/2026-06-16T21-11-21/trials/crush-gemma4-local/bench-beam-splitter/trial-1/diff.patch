+type Direction = 'down' | 'down-left' | 'down-right';
+
+type BeamState = {
+  r: number;
+  c: number;
+  dir: Direction;
+};
+
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+
+  let startR = -1;
+  let startC = -1;
+
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      if (grid[r][c] === 'S') {
+        startR = r;
+        startC = c;
+        break;
+      }
+    }
+    if (startR !== -1) break;
+  }
+
+  if (startR === -1) return 0;
+
+  const visited = new Set<string>();
+  const queue: BeamState[] = [{ r: startR, c: startC, dir: 'down' }];
+  
+  // To prevent infinite loops if there were cycles (though movement is always row+1)
+  // we use a set of (r, c, dir) to track seen beam states.
+  const seenStates = new Set<string>();
+
+  while (queue.length > 0) {
+    const { r, c, dir } = queue.shift()!;
+    const stateKey = `${r},${c},${dir}`;
+    if (seenStates.has(stateKey)) continue;
+    seenStates.add(stateKey);
+
+    visited.add(`${r},${c}`);
+
+    let nextR: number;
+    let nextC: number;
+    let nextDir: Direction;
+
+    if (grid[r][c] === '^') {
+      // Splitter
+      nextR = r + 1;
+      nextDir = 'down-left'; // This is just a placeholder, we need two entries
+      
+      // We need to handle the split by adding two different beams to the queue
+      // But we must be careful not to double-count the current cell.
+      // The rule says: "The original beam is consumed by the splitter"
+      // So we don't calculate nextR/nextC here, we just add the two new ones.
+      
+      // Down-left
+      const dlR = r + 1;
+      const dlC = c - 1;
+      if (dlR >= 0 && dlR < rows && dlC >= 0 && dlC < cols) {
+        queue.push({ r: dlR, c: dlC, dir: 'down-left' });
+      } else {
+        // Even if it exits, the cell (r,c) was visited.
+        // The path is absorbed, but we don't add more to visited.
+      }
+
+      // Down-right
+      const drR = r + 1;
+      const drC = c + 1;
+      if (drR >= 0 && drR < rows && drC >= 0 && drC < cols) {
+        queue.push({ r: drR, c: drC, dir: 'down-right' });
+      }
+      
+      continue; // Skip the default movement
+    } else {
+      // Normal movement
+      if (dir === 'down') {
+        nextR = r + 1;
+        nextC = c;
+        nextDir = 'down';
+      } else if (dir === 'down-left') {
+        nextR = r + 1;
+        nextC = c - 1;
+        nextDir = 'down-left';
+      } else { // down-right
+        nextR = r + 1;
+        nextC = c + 1;
+        nextDir = 'down-right';
+      }
+    }
+
+    if (nextR >= 0 && nextR < rows && nextC >= 0 && nextC < cols) {
+      queue.push({ r: nextR, c: nextC, dir: nextDir });
+    }
+  }
+
+  return visited.size;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+
+  let startR = -1;
+  let startC = -1;
+
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      if (grid[r][c] === 'S') {
+        startR = r;
+        startC = c;
+        break;
+      }
+    }
+    if (startR !== -1) break;
+  }
+
+  if (startR === -1) return 0n;
+
+  // Use memoization for DP: memo[r][c][dir]
+  // Since we always move to row+1, we can use DP.
+  // We need to handle directions.
+  const memo = new Map<string, bigint>();
+
+  function solve(r: number, c: number, dir: Direction): bigint {
+    // If out of bounds, this path has ended (it's one complete path)
+    if (r < 0 || r >= rows || c < 0 || c >= cols) {
+      return 1n;
+    }
+
+    const key = `${r},${c},${dir}`;
+    if (memo.has(key)) return memo.get(key)!;
+
+    let result: bigint;
+
+    if (grid[r][c] === '^') {
+      // Splitter: two new paths
+      result = solve(r + 1, c - 1, 'down-left') + solve(r + 1, c + 1, 'down-right');
+    } else {
+      // Continue in current direction
+      if (dir === 'down') {
+        result = solve(r + 1, c, 'down');
+      } else if (dir === 'down-left') {
+        result = solve(r + 1, c - 1, 'down-left');
+      } else { // down-right
+        result = solve(r + 1, c + 1, 'down-right');
+      }
+    }
+
+    memo.set(key, result);
+    return result;
+  }
+
+  // Initial beam from 'S' moves straight down
+  // The source 'S' itself is the first cell.
+  // The problem says "A beam from the source 'S' moves straight down (row+1, same column) each step."
+  // This means the first step is to (startR+1, startC) with direction 'down'.
+  // Wait, let's re-read: "The beam starts at (0,1) where 'S' is. It moves down: (1,1), (2,1) — hits splitter."
+  // This implies the beam is ALREADY at (0,1) and its first movement is to (1,1).
+  
+  // Actually, if 'S' is at (0,1), the beam is at (0,1) and its direction is 'down'.
+  // If (0,1) was a splitter (not possible by rules, but let's be safe), it would split.
+  // But 'S' is the source.
+  
+  // Let's trace the example:
+  // (0,1) is 'S'. 
+  // solve(0, 1, 'down')
+  //   grid[0][1] is 'S', not '^', so it continues 'down'
+  //   result = solve(1, 1, 'down')
+  //     grid[1][1] is '.', not '^', so it continues 'down'
+  //     result = solve(2, 1, 'down')
+  //       grid[2][1] is '^', so it splits
+  //       result = solve(3, 0, 'down-left') + solve(3, 2, 'down-right')
+  //         solve(3, 0, 'down-left') -> grid[3][0] is '.', result = solve(4, -1, 'down-left') = 1n
+  //         solve(3, 2, 'down-right') -> grid[3][2] is '.', result = solve(4, 3, 'down-right') = 1n
+  //       result = 1n + 1n = 2n
+  //     result = 2n
+  //   result = 2n
+  // return 2n. Matches example!
+
+  return solve(startR, startC, 'down');
+}
