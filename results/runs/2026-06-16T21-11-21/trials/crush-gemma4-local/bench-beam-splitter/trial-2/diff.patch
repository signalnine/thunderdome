+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+
+  let startRow = -1;
+  let startCol = -1;
+
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') {
+      startRow = 0;
+      startCol = c;
+      break;
+    }
+  }
+
+  if (startRow === -1) return 0;
+
+  const visited = new Set<string>();
+  // Queue of [row, col, direction]
+  // directions: 0: down, 1: down-left, 2: down-right
+  const queue: [number, number, number][] = [[startRow, startCol, 0]];
+  visited.add(`${startRow},${startCol}`);
+
+  // Since we need to count cells visited by ANY beam, and beams can 
+  // overlap, we can use a BFS/DFS approach.
+  // However, multiple beams can be at the same cell with DIFFERENT directions.
+  // A beam's future depends on its direction and the cell it's in.
+  // So state is (row, col, direction).
+  
+  const seenStates = new Set<string>();
+  seenStates.add(`${startRow},${startCol},0`);
+
+  let head = 0;
+  while (head < queue.length) {
+    const [r, c, dir] = queue[head++];
+
+    let nextR: number;
+    let nextC: number;
+    let nextDir: number;
+
+    if (grid[r][c] === '^') {
+      // Split!
+      // Down-left: row+1, col-1, dir=1
+      // Down-right: row+1, col+1, dir=2
+      const directions = [
+        { dr: 1, dc: -1, d: 1 },
+        { dr: 1, dc: 1, d: 2 }
+      ];
+
+      for (const { dr, dc, d } of directions) {
+        const nr = r + dr;
+        const nc = c + dc;
+        if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
+          visited.add(`${nr},${nc}`);
+          if (!seenStates.has(`${nr},${nc},${d}`)) {
+            seenStates.add(`${nr},${nc},${d}`);
+            queue.push([nr, nc, d]);
+          }
+        }
+      }
+      continue; // Original beam is consumed
+    } else {
+      // Continue in current direction
+      let nextR: number;
+      let nextC: number;
+      let nextDir: number;
+
+      if (dir === 0) { // down
+        nextR = r + 1;
+        nextC = c;
+        nextDir = 0;
+      } else if (dir === 1) { // down-left
+        nextR = r + 1;
+        nextC = c - 1;
+        nextDir = 1;
+      } else { // down-right
+        nextR = r + 1;
+        nextC = c + 1;
+        nextDir = 2;
+      }
+
+      if (nextR >= 0 && nextR < rows && nextC >= 0 && nextC < cols) {
+        visited.add(`${nextR},${nextC}`);
+        if (!seenStates.has(`${nextR},${nextC},${nextDir}`)) {
+          seenStates.add(`${nextR},${nextC},${nextDir}`);
+          queue.push([nextR, nextC, nextDir]);
+        }
+      }
+    }
+  }
+
+  return visited.size;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  throw new Error('Not implemented');
+}
