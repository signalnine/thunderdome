@@ -0,0 +1,101 @@
+import { countBeamCells, countBeamPaths } from '../src/index';
+
+describe('Beam Splitter', () => {
+  test('Example 1: Single splitter', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(5);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  test('Example 2: Two splitters', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(6);
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  test('No splitters', () => {
+    const grid = [
+      ['S'],
+      ['.'],
+      ['.'],
+    ];
+    expect(countBeamCells(grid)).toBe(3);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  test('Splitter at edge (absorption)', () => {
+    const grid = [
+      ['S', '.'],
+      ['^', '.'],
+      ['.', '.'],
+    ];
+    // S at (0,0) -> (1,0) hits splitter
+    // Splits to (2,-1) [absorbed] and (2,1) [path]
+    // Visited: (0,0), (1,0), (2,1)
+    // (2,-1) is out of bounds.
+    expect(countBeamCells(grid)).toBe(3);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  test('Complex grid with multiple paths', () => {
+    const grid = [
+        ['S', '.', '.', '.'],
+        ['.', '^', '.', '.'],
+        ['.', '.', '^', '.'],
+        ['.', '.', '.', '.'],
+    ];
+    // (0,0) S
+    // (1,0) .
+    // (1,1) ^ -> (2,0) and (2,2)
+    // (2,0) .
+    // (2,2) ^ -> (3,1) and (3,3)
+    // (3,1) .
+    // (3,3) .
+    // Paths:
+    // S -> (1,0) -> (1,1) -> (2,0) -> (3,0) [exit]
+    // S -> (1,0) -> (1,1) -> (2,2) -> (3,1) -> (4,1) [exit]
+    // S -> (1,0) -> (1,1) -> (2,2) -> (3,3) -> (4,3) [exit]
+    // Wait, let's trace carefully.
+    // S is (0,0)
+    // Step 1: (1,0) [.]
+    // Step 2: (1,1) [^]
+    // Step 3a: (2,0) [.]
+    // Step 3b: (2,2) [^]
+    // Step 4a: (3,0) [.]
+    // Step 4b: (3,1) [.]
+    // Step 4c: (3,3) [.]
+    // Step 5a: (4,0) [exit]
+    // Step 5b: (4,1) [exit]
+    // Step 5c: (4,3) [exit]
+    // Actually, let's re-verify the splitter rule.
+    // "^" splits into down-left (row+1, col-1) and down-right (row+1, col+1).
+    // (1,1) splitter -> (2,0) and (2,2). Correct.
+    // (2,2) splitter -> (3,1) and (3,3). Correct.
+    // Visited cells: (0,0), (1,0), (1,1), (2,0), (2,2), (3,1), (3,3)
+    // Let's count: (0,0), (1,0), (1,1), (2,0), (2,2), (3,1), (3,3) = 7 cells.
+    // Paths:
+    // Path 1: (0,0) -> (1,0) -> (1,1) -> (2,0) -> (3,0) -> exit
+    // Path 2: (0,0) -> (1,0) -> (1,1) -> (2,2) -> (3,1) -> exit
+    // Path 3: (0,0) -> (1,0) -> (1,1) -> (2,2) -> (3,3) -> exit
+    // Total paths: 3.
+    
+    const grid2 = [
+        ['S', '.', '.', '.'],
+        ['.', '^', '.', '.'],
+        ['.', '.', '^', '.'],
+        ['.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid2)).toBe(7);
+    expect(countBeamPaths(grid2)).toBe(3n);
+  });
+});
