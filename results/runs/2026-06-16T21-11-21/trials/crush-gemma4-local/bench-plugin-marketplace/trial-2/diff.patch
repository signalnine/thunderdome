@@ -0,0 +1,62 @@
+import vm from 'node:vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+export function createRunner(): RunnerService {
+  return {
+    async execute(code, context = {}): Promise<SandboxResult> {
+      const start = performance.now();
+      try {
+        const script = new vm.Script(`(function() { ${code} })()`);
+        const sandbox = { ...context };
+        const vmContext = vm.createContext(sandbox);
+        
+        const result = await script.runInContext(vmContext);
+        const end = performance.now();
+
+        return {
+          success: true,
+          output: result,
+          duration: end - start,
+          memoryUsed: 0, // Simplified for this implementation
+        };
+      } catch (error: any) {
+        const end = performance.now();
+        return {
+          success: false,
+          output: null,
+          duration: end - start,
+          memoryUsed: 0,
+          error: error.message,
+        };
+      }
+    },
+
+    async executeWithTimeout(code, timeoutMs, context = {}): Promise<SandboxResult> {
+      const start = performance.now();
+      try {
+        const script = new vm.Script(`(function() { ${code} })()`);
+        const sandbox = { ...context };
+        const vmContext = vm.createContext(sandbox);
+        
+        const result = await script.runInContext(vmContext, { timeout: timeoutMs });
+        const end = performance.now();
+
+        return {
+          success: true,
+          output: result,
+          duration: end - start,
+          memoryUsed: 0,
+        };
+      } catch (error: any) {
+        const end = performance.now();
+        return {
+          success: false,
+          output: null,
+          duration: end - start,
+          memoryUsed: 0,
+          error: error.message,
+        };
+      }
+    },
+  };
+}
