@@ -0,0 +1,98 @@
+import Database from 'better-sqlite3';
+import type { ReviewService, Review } from '../types.js';
+
+export function createReviewSystem(): ReviewService {
+  const db = new Database(':memory:');
+
+  db.exec(`
+    CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT,
+      flagged BOOLEAN DEFAULT 0,
+      createdAt TEXT NOT NULL
+    )
+  `);
+
+  return {
+    addReview(reviewData): Review {
+      const stmt = db.prepare(`
+        INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, createdAt)
+        VALUES (?, ?, ?, ?, ?, ?)
+      `);
+      const createdAt = new Date().toISOString();
+      const info = stmt.run(
+        reviewData.pluginName,
+        reviewData.pluginVersion,
+        reviewData.userId,
+        reviewData.rating,
+        reviewData.comment,
+        createdAt
+      );
+
+      return {
+        ...reviewData,
+        id: info.lastInsertRowid as number,
+        flagged: false,
+        createdAt
+      };
+    },
+
+    getReviews(pluginName: string): Review[] {
+      const stmt = db.prepare(`SELECT * FROM reviews WHERE pluginName = ?`);
+      const rows = stmt.all(pluginName) as any[];
+      return rows.map(row => ({
+        ...row,
+        flagged: Boolean(row.flagged)
+      }));
+    },
+
+    getAverageRating(pluginName: string): number {
+      const stmt = db.prepare(`
+        SELECT AVG(rating) as avgRating 
+        FROM reviews 
+        WHERE pluginName = ? AND flagged = 0
+      `);
+      const row = stmt.get(pluginName) as any;
+      return row?.avgRating || 0;
+    },
+
+    flagReview(reviewId: number): void {
+      const stmt = db.prepare(`UPDATE reviews SET flagged = 1 WHERE id = ?`);
+      stmt.run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      const stmt = db.prepare(`SELECT * FROM reviews WHERE flagged = 1`);
+      const rows = stmt.all() as any[];
+      return rows.map(row => ({
+        ...row,
+        flagged: Boolean(row.flagged)
+      }));
+    },
+
+    removeReview(reviewId: number): boolean {
+      const stmt = db.prepare(`DELETE FROM reviews WHERE id = ?`);
+      const info = stmt.run(reviewId);
+      return info.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      const stmt = db.prepare(`SELECT * FROM reviews WHERE userId = ?`);
+      const rows = stmt.all(userId) as any[];
+      return rows.map(row => ({
+        ...row,
+        flagged: Boolean(row.flagged)
+      }));
+    },
+
+    getReviewCount(pluginName: string): number {
+      const stmt = db.prepare(`SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?`);
+      const row = stmt.get(pluginName) as any;
+      return row?.count || 0;
+    }
+  };
+}
