@@ -0,0 +1,116 @@
+import type { DepsService, DependencyNode, RegistryService } from '../types.js';
+
+export function createDepsService(): DepsService {
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      const manifest = registry.get(name);
+      if (!manifest) {
+        throw new Error(`Plugin ${name} not found`);
+      }
+
+      const dependencies: DependencyNode[] = [];
+      for (const [depName, range] of Object.entries(manifest.dependencies)) {
+        // We need to find a version that satisfies the range to build the tree properly,
+        // but the interface buildTree only takes the registry.
+        // For a tree, we typically use the 'best' version available.
+        const depManifest = registry.get(depName);
+        if (depManifest) {
+          dependencies.push(this.buildTree(depName, registry));
+        }
+      }
+
+      return {
+        name: manifest.name,
+        version: manifest.version,
+        dependencies,
+      };
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const cycles: string[][] = [];
+      const visited = new Set<string>();
+      const stack: string[] = [];
+      const stackSet = new Set<string>();
+
+      const dfs = (curr: string, path: string[]) => {
+        if (stackSet.has(curr)) {
+          const cycleStartIndex = path.indexOf(curr);
+          cycles.push(path.slice(cycleStartIndex));
+          return;
+        }
+        if (visited.has(curr)) return;
+
+        visited.add(curr);
+        stackSet.add(curr);
+        stack.push(curr);
+
+        const manifest = registry.get(curr);
+        if (manifest) {
+          for (const depName of Object.keys(manifest.dependencies)) {
+            dfs(depName, [...path, curr]);
+          }
+        }
+
+        stackSet.delete(curr);
+        stack.pop();
+      };
+
+      dfs(name, []);
+
+      return cycles.length > 0 ? cycles : null;
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const result: string[] = [];
+      const visited = new Set<string>();
+      const tempStack = new Set<string>();
+
+      const visit = (curr: string) => {
+        if (tempStack.has(curr)) {
+          throw new Error('Cycle detected');
+        }
+        if (visited.has(curr)) return;
+
+        tempStack.add(curr);
+        const manifest = registry.get(curr);
+        if (manifest) {
+          for (const depName of Object.keys(manifest.dependencies)) {
+            visit(depName);
+          }
+        }
+
+        tempStack.delete(curr);
+        visited.add(curr);
+        result.push(curr);
+      };
+
+      visit(name);
+      return result;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const result = new Set<string>();
+      const manifest = registry.get(name);
+      if (!manifest) return [];
+
+      const walk = (currName: string) => {
+        const currManifest = registry.get(currName);
+        if (!currManifest) return;
+
+        for (const depName of Object.keys(currManifest.dependencies)) {
+          if (!result.has(depName)) {
+            result.add(depName);
+            walk(depName);
+          }
+        }
+      };
+
+      walk(name);
+      return Array.from(result);
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return this.detectCycles(name, registry) !== null;
+    },
+  };
+}
