@@ -0,0 +1,38 @@
+import semver from 'semver';
+import type { ResolverService, VersionConstraint, ResolvedVersion } from '../types.js';
+
+export function createResolver(): ResolverService {
+  return {
+    resolve(constraints, available): ResolvedVersion[] {
+      return constraints.map(constraint => {
+        const versions = available[constraint.name];
+        if (!versions) {
+          throw new Error(`No versions available for ${constraint.name}`);
+        }
+
+        const bestVersion = this.maxSatisfying(versions, constraint.range);
+        if (!bestVersion) {
+          throw new Error(`No version of ${constraint.name} satisfies ${constraint.range}`);
+        }
+
+        return {
+          name: constraint.name,
+          version: bestVersion,
+          satisfies: constraint.range,
+        };
+      });
+    },
+
+    satisfies(version, range): boolean {
+      return semver.satisfies(version, range);
+    },
+
+    maxSatisfying(versions, range): string | null {
+      return semver.maxSatisfying(versions, range);
+    },
+
+    validRange(range): boolean {
+      return semver.validRange(range) !== null;
+    },
+  };
+}
