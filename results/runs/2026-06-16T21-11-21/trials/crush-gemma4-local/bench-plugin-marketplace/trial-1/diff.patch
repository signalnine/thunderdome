+import Database from 'better-sqlite3';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+export function createRegistry(dbPath: string = ':memory:'): RegistryService {
+  return new RegistryServiceSqlite(dbPath);
+}
+
+export class RegistryServiceSqlite implements RegistryService {
+  private db: Database.Database;
+
+  constructor(dbPath: string) {
+    this.db = new Database(dbPath);
+    this.init();
+  }
+
+  private init(): void {
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS plugins (
+        name TEXT NOT NULL,
+        version TEXT NOT NULL,
+        description TEXT,
+        author TEXT,
+        entryPoint TEXT,
+        permissions TEXT,
+        dependencies TEXT,
+        PRIMARY KEY (name, version)
+      )
+    `);
+  }
+
+  register(manifest: PluginManifest): void {
+    const stmt = this.db.prepare(`
+      INSERT OR REPLACE INTO plugins (name, version, description, author, entryPoint, permissions, dependencies)
+      VALUES (?, ?, ?, ?, ?, ?, ?)
+    `);
+    stmt.run(
+      manifest.name,
+      manifest.version,
+      manifest.description,
+      manifest.author,
+      manifest.entryPoint,
+      JSON.stringify(manifest.permissions),
+      JSON.stringify(manifest.dependencies)
+    );
+  }
+
+  get(name: string): PluginManifest | null {
+    const stmt = this.db.prepare('SELECT * FROM plugins WHERE name = ? ORDER BY version DESC LIMIT 1');
+    const row = stmt.get(name) as any;
+    return row ? this.mapRow(row) : null;
+  }
+
+  getVersion(name: string, version: string): PluginManifest | null {
+    const stmt = this.db.prepare('SELECT * FROM plugins WHERE name = ? AND version = ?');
+    const row = stmt.get(name, version) as any;
+    return row ? this.mapRow(row) : null;
+  }
+
+  list(): PluginManifest[] {
+    const rows = this.db.prepare('SELECT * FROM plugins').all() as any[];
+    return rows.map(this.mapRow);
+  }
+
+  search(query: string): PluginManifest[] {
+    const stmt = this.db.prepare('SELECT * FROM plugins WHERE name LIKE ? OR description LIKE ?');
+    const rows = stmt.all(`%${query}%`, `%${query}%`) as any[];
+    return rows.map(this.mapRow);
+  }
+
+  remove(name: string, version: string): boolean {
+    const stmt = this.db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?');
+    const info = stmt.run(name, version);
+    return info.changes > 0;
+  }
+
+  listVersions(name: string): string[] {
+    const stmt = this.db.prepare('SELECT version FROM plugins WHERE name = ? ORDER BY version DESC');
+    return (stmt.all(name) as any[]).map(row => row.version);
+  }
+
+  update(name: string, version: string, updates: Partial<PluginManifest>): void {
+    const current = this.getVersion(name, version);
+    if (!current) throw new Error(`Plugin ${name}@${version} not found`);
+
+    const updated = { ...current, ...updates };
+    this.register(updated);
+  }
+
+  private mapRow(row: any): PluginManifest {
+    return {
+      name: row.name,
+      version: row.version,
+      description: row.description,
+      author: row.author,
+      entryPoint: row.entryPoint,
+      permissions: JSON.parse(row.permissions),
+      dependencies: JSON.parse(row.dependencies)
+    };
+  }
+}
