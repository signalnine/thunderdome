--- /dev/null
+++ b/src/errors.ts
@@ -0,0 +1,26 @@
+import express, { Request, Response, NextFunction } from 'express';
+
+export class AppError extends Error {
+  constructor(
+    public statusCode: number,
+    public message: string,
+    public code: string
+  ) {
+    super(message);
+  }
+}
+
+export function errorHandler(err: any, req: Request, res: Response, next: NextFunction) {
+  if (err instanceof AppError) {
+    return res.status(err.statusCode).json({
+      error: err.message,
+      code: err.code,
+    });
+  }
+
+  console.error(err);
+  return res.status(500).json({
+    error: 'Internal server error',
+    code: 'INTERNAL_ERROR',
+  });
+}
diff --git a/src/users/router.ts b/src/users/router.ts
new file mode 100644
index 0000000..419903f
--- /dev/null
+++ b/src/users/router.ts
@@ -0,0 +1,132 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import bcrypt from 'bcryptjs';
+import jwt from 'jsonwebtoken';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const router = Router();
+const JWT_SECRET = 'super-secret-key';
+
+interface User {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: string;
+  created_at: string;
+}
+
+router.post('/', async (req, res, next) => {
+  try {
+    const { email, password, tenant_id } = req.body;
+    if (!email || !password || !tenant_id) {
+      return next(new AppError('Missing required fields', 'MISSING_FIELDS', 400));
+    }
+
+    const db = getDb();
+    const existingUser = db.prepare('SELECT id FROM users WHERE email = ?').get(email) as User | undefined;
+    if (existingUser) {
+      return next(new AppError('User already exists', 'USER_EXISTS', 409));
+    }
+
+    const id = uuidv4();
+    const password_hash = await bcrypt.hash(password, 10);
+
+    db.prepare(`
+      INSERT INTO users (id, email, password_hash, tenant_id, role)
+      VALUES (?, ?, ?, ?, ?)
+    `).run(id, email, password_hash, tenant_id, 'viewer');
+
+    res.status(201).json({
+      id,
+      email,
+      tenant_id,
+      role: 'viewer'
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/login', async (req, res, next) => {
+  try {
+    const { email, password } = req.body;
+    if (!email || !password) {
+      return next(new AppError('Missing required fields', 'MISSING_FIELDS', 400));
+    }
+
+    const db = getDb();
+    const user = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as User | undefined;
+
+    if (!user || !(await bcrypt.compare(password, user.password_hash))) {
+      return next(new AppError('Invalid credentials', 'AUTH_ERROR', 401));
+    }
+
+    const token = jwt.sign(
+      { sub: user.id, tid: user.tenant_id },
+      JWT_SECRET,
+      { expiresIn: '1h' }
+    );
+
+    res.json({
+      token,
+      user: {
+        id: user.id,
+        email: user.email,
+        tenant_id: user.tenant_id,
+        role: user.role
+      }
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/me', (req, res, next) => {
+  const user = (req as any).user;
+  if (!user) {
+    return next(new AppError('Not authenticated', 'AUTH_ERROR', 401));
+  }
+  // In a real app, we'd fetch the full user from DB. 
+  // For simplicity in this test, we'll just return what's in the token/mock.
+  // But the test expects the email.
+  // Let's fetch it.
+  try {
+    const db = getDb();
+    const userFromDb = db.prepare('SELECT email, tenant_id, role FROM users WHERE id = ?').get(user.id) as any;
+    if (!userFromDb) {
+      return next(new AppError('User not found', 'USER_NOT_FOUND', 404));
+    }
+    res.json({
+      id: user.id,
+      email: userFromDb.email,
+      tenant_id: user.tenant_id,
+      role: userFromDb.role
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.patch('/:id/role', async (req, res, next) => {
+  try {
+    const targetUserId = req.params.id;
+    const { role } = req.body;
+    const currentUser = (req as any).user;
+
+    if (!currentUser || currentUser.role !== 'admin') {
+      return next(new AppError('Forbidden', 'FORBIDDEN', 403));
+    }
+
+    const db = getDb();
+    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, targetUserId);
+
+    const updatedUser = db.prepare('SELECT role FROM users WHERE id = ?').get(targetUserId) as any;
+    res.json({ role: updatedUser.role });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
