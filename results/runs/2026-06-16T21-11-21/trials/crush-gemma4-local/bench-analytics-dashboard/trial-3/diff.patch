+  app.post('/query/breakdown', (req, res) => res.status(501).send('Not Implemented'));
+  app.post('/query/funnel', (req, res) => res.status(501).send('Not Implemented'));
+  app.post('/dashboards', (req, res) => res.status(501).send('Not Implemented'));
+  app.get('/dashboards', (req, res) => res.status(501).send('Not Implemented'));
+  app.patch('/dashboards/:id', (req, res) => res.status(501).send('Not Implemented'));
+  app.get('/dashboards/:id', (req, res) => res.status(501).send('Not Implemented'));
+  app.delete('/dashboards/:id', (req, res) => res.status(501).send('Not Implemented'));
+  app.post('/dashboards/:id/widgets', (req, res) => res.status(501).send('Not Implemented'));
+  app.delete('/dashboards/:id/widgets/:id', (req, res) => res.status(501).send('Not Implemented'));
+  app.get('/export/events', (req, res) => res.status(501).send('Not Implemented'));
+  app.get('/export/dashboard/:id', (req, res) => res.status(501).send('Not Implemented'));
+
+  app.use(errorHandler);
+  return app;
+}
