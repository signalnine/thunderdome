@@ -0,0 +1,34 @@
+import { EventBus } from '../bus.js';
+import { PricingService, ProductCreatedEvent } from '../types.js';
+
+export function createPricingService(bus: EventBus): PricingService {
+  const prices = new Map<string, number>();
+  const discounts = new Map<string, number>();
+
+  bus.on('product:created', async (payload) => {
+    const event = payload as ProductCreatedEvent;
+    prices.set(event.productId, event.price);
+  });
+
+  return {
+    calculateTotal(items, discountCode) {
+      const subtotal = items.reduce((acc, item) => acc + (item.price * item.quantity), 0);
+      let discount = 0;
+      if (discountCode && discounts.has(discountCode)) {
+        discount = subtotal * (discounts.get(discountCode)! / 100);
+      }
+      const tax = (subtotal - discount) * 0.1;
+      const total = subtotal - discount + tax;
+
+      return { subtotal, discount, tax, total };
+    },
+
+    addDiscountCode(code, percentage) {
+      discounts.set(code, percentage);
+    },
+
+    getPrice(productId) {
+      return prices.get(productId) || 0;
+    }
+  };
+}
