@@ -0,0 +1,83 @@
+import { EventBus } from '../bus.js';
+import { InventoryService, InventoryUpdatedEvent, LowStockAlertEvent } from '../types.js';
+
+interface StockInfo {
+  quantity: number;
+  threshold: number;
+}
+
+export function createInventoryService(bus: EventBus): InventoryService {
+  const stock = new Map<string, StockInfo>();
+
+  return {
+    setStock(productId: string, quantity: number): void {
+      const current = stock.get(productId) || { quantity: 0, threshold: 0 };
+      stock.set(productId, { ...current, quantity });
+      
+      bus.emit('inventory:updated', {
+        productId,
+        quantity
+      } as InventoryUpdatedEvent);
+
+      if (quantity <= current.threshold && current.threshold !== 0) {
+        bus.emit('inventory:low_stock', {
+          productId,
+          currentQuantity: quantity,
+          threshold: current.threshold
+        } as LowStockAlertEvent);
+      }
+    },
+
+    getStock(productId: string): number {
+      return stock.get(productId)?.quantity || 0;
+    },
+
+    reserve(productId: string, quantity: number): boolean {
+      const info = stock.get(productId);
+      if (!info || info.quantity < quantity) {
+        return false;
+      }
+      const newQuantity = info.quantity - quantity;
+      stock.set(productId, { ...info, quantity: newQuantity });
+      
+      bus.emit('inventory:updated', {
+        productId,
+        quantity: newQuantity
+      } as InventoryUpdatedEvent);
+
+      if (newQuantity <= info.threshold && info.threshold !== 0) {
+        bus.emit('inventory:low_stock', {
+          productId,
+          currentQuantity: newQuantity,
+          threshold: info.threshold
+        } as LowStockAlertEvent);
+      }
+      return true;
+    },
+
+    release(productId: string, quantity: number): void {
+      const info = stock.get(productId);
+      if (!info) return;
+      const newQuantity = info.quantity + quantity;
+      stock.set(productId, { ...info, quantity: newQuantity });
+      
+      bus.emit('inventory:updated', {
+        productId,
+        quantity: newQuantity
+      } as InventoryUpdatedEvent);
+    },
+
+    setLowStockThreshold(productId: string, threshold: number): void {
+      const current = stock.get(productId) || { quantity: 0, threshold: 0 };
+      stock.set(productId, { ...current, threshold });
+      
+      if (current.quantity <= threshold) {
+        bus.emit('inventory:low_stock', {
+          productId,
+          currentQuantity: current.quantity,
+          threshold
+        } as LowStockAlertEvent);
+      }
+    }
+  };
+}
