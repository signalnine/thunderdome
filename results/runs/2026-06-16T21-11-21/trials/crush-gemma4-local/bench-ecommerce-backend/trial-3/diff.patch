--- /dev/null
+++ b/src/cart/index.ts
@@ -0,0 +1,78 @@
+import { EventBus } from '../bus.js';
+import { CartService, CartUpdatedEvent } from '../types.js';
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: Array<{ productId: string; quantity: number }>;
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  const emitUpdate = async (cart: Cart) => {
+    await bus.emit('cart:updated', {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: cart.items.map(item => ({ ...item }))
+    } as CartUpdatedEvent);
+  };
+
+  return {
+    createCart(userId: string): string {
+      const cartId = `cart_${userId}_${Date.now()}`;
+      const newCart: Cart = { id: cartId, userId, items: [] };
+      carts.set(cartId, newCart);
+      return cartId;
+    },
+
+    async addItem(cartId: string, productId: string, quantity: number): Promise<void> {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      const existingItem = cart.items.find(item => item.productId === productId);
+      if (existingItem) {
+        existingItem.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      await emitUpdate(cart);
+    },
+
+    async removeItem(cartId: string, productId: string): Promise<void> {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      cart.items = cart.items.filter(item => item.productId !== productId);
+      await emitUpdate(cart);
+    },
+
+    async updateQuantity(cartId: string, productId: string, quantity: number): Promise<void> {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      const existingItem = cart.items.find(item => item.productId === productId);
+      if (existingItem) {
+        if (quantity <= 0) {
+          cart.items = cart.items.filter(item => item.productId !== productId);
+        } else {
+          existingItem.quantity = quantity;
+        }
+        await emitUpdate(cart);
+      }
+    },
+
+    getCart(cartId: string) {
+      const cart = carts.get(cartId);
+      return cart ? { ...cart, items: cart.items.map(item => ({ ...item })) } : null;
+    },
+
+    async clearCart(cartId: string): Promise<void> {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      cart.items = [];
+      await emitUpdate(cart);
+    }
+  };
+}
