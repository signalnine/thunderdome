+import { EventBus } from '../bus.js';
+import { InventoryService, InventoryUpdatedEvent, LowStockAlertEvent } from '../types.js';
+import { Events } from '../types.js';
+
+export function createInventoryService(bus: EventBus): InventoryService {
+  interface StockInfo {
+    quantity: number;
+    threshold: number;
+  }
+
+  const stockMap = new Map<string, StockInfo>();
+
+  return {
+    setStock(productId, quantity) {
+      const info = stockMap.get(productId) || { quantity: 0, threshold: 0 };
+      info.quantity = quantity;
+      stockMap.set(productId, info);
+      
+      bus.emit(Events.INVENTORY_UPDATED, {
+        productId,
+        quantity
+      } as InventoryUpdatedEvent);
+
+      if (quantity <= info.threshold) {
+        bus.emit(Events.LOW_STOCK_ALERT, {
+          productId,
+          currentQuantity: quantity,
+          threshold: info.threshold
+        } as LowStockAlertEvent);
+      }
+    },
+
+    getStock(productId) {
+      return stockMap.get(productId)?.quantity ?? 0;
+    },
+
+    reserve(productId, quantity) {
+      const info = stockMap.get(productId);
+      if (!info || info.quantity < quantity) {
+        return false;
+      }
+
+      info.quantity -= quantity;
+      stockMap.set(productId, info);
+
+      bus.emit(Events.INVENTORY_UPDATED, {
+        productId,
+        quantity: info.quantity
+      } as InventoryUpdatedEvent);
+
+      if (info.quantity <= info.threshold) {
+        bus.emit(Events.LOW_STOCK_ALERT, {
+          productId,
+          currentQuantity: info.quantity,
+          threshold: info.threshold
+        } as LowStockAlertEvent);
+      }
+
+      return true;
+    },
+
+    release(productId, quantity) {
+      const info = stockMap.get(productId);
+      if (!info) return;
+
+      info.quantity += quantity;
+      stockMap.set(productId, info);
+
+      bus.emit(Events.INVENTORY_UPDATED, {
+        productId,
+        quantity: info.quantity
+      } as InventoryUpdatedEvent);
+    },
+
+    setLowStockThreshold(productId, threshold) {
+      const info = stockMap.get(productId) || { quantity: 0, threshold: 0 };
+      info.threshold = threshold;
+      stockMap.set(productId, info);
+
+      if (info.quantity <= threshold) {
+        bus.emit(Events.LOW_STOCK_ALERT, {
+          productId,
+          currentQuantity: info.quantity,
+          threshold
+        } as LowStockAlertEvent);
+      }
+    }
+  };
+}
