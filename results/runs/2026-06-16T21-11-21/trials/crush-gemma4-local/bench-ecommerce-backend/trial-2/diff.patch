+import { EventBus } from '../bus.js';
+import { OrderService, OrderStatus, OrderCreatedEvent, OrderStatusChangedEvent } from '../types.js';
+import { Events } from '../types.js';
+
+export function createOrderService(bus: EventBus): OrderService {
+  interface Order {
+    id: string;
+    userId: string;
+    cartId: string;
+    status: OrderStatus;
+    total: number;
+  }
+
+  const orders = new Map<string, Order>();
+
+  return {
+    createOrder(userId, cartId, total) {
+      const id = Math.random().toString(36).substring(2, 9);
+      const order: Order = {
+        id,
+        userId,
+        cartId,
+        status: OrderStatus.PENDING,
+        total
+      };
+      orders.set(id, order);
+      
+      bus.emit(Events.ORDER_CREATED, {
+        orderId: id,
+        userId,
+        cartId,
+        total
+      } as OrderCreatedEvent);
+
+      return id;
+    },
+
+    getOrder(orderId) {
+      const order = orders.get(orderId);
+      return order ? { ...order } : null;
+    },
+
+    updateStatus(orderId, status) {
+      const order = orders.get(orderId);
+      if (!order) return;
+
+      const previousStatus = order.status;
+      if (previousStatus === status) return;
+
+      // Simple state machine validation
+      const validTransitions: Record<OrderStatus, OrderStatus[]> = {
+        [OrderStatus.PENDING]: [OrderStatus.CONFIRMED, OrderStatus.CANCELLED],
+        [OrderStatus.CONFIRMED]: [OrderStatus.SHIPPED, OrderStatus.CANCELLED],
+        [OrderStatus.SHIPPED]: [OrderStatus.DELIVERED],
+        [OrderStatus.DELIVERED]: [],
+        [OrderStatus.CANCELLED]: []
+      };
+
+      if (validTransitions[previousStatus].includes(status)) {
+        order.status = status;
+        bus.emit(Events.ORDER_STATUS_CHANGED, {
+          orderId,
+          status,
+          previousStatus
+        } as OrderStatusChangedEvent);
+      }
+    },
+
+    listOrders(userId) {
+      return Array.from(orders.values())
+        .filter(o => o.userId === userId)
+        .map(o => ({
+          id: o.id,
+          status: o.status,
+          total: o.total
+        }));
+    }
+  };
+}
