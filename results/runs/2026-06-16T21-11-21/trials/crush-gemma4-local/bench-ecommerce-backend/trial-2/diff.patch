+import { EventBus } from '../bus.js';
+import { CartService, CartUpdatedEvent } from '../types.js';
+import { Events } from '../types.js';
+
+export function createCartService(bus: EventBus): CartService {
+  interface CartItem {
+    productId: string;
+    quantity: number;
+  }
+
+  interface Cart {
+    id: string;
+    userId: string;
+    items: CartItem[];
+  }
+
+  const carts = new Map<string, Cart>();
+
+  const emitUpdate = (cart: Cart) => {
+    bus.emit(Events.CART_UPDATED, {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: cart.items.map(item => ({ ...item }))
+    } as CartUpdatedEvent);
+  };
+
+  return {
+    createCart(userId) {
+      const id = Math.random().toString(36).substring(2, 9);
+      const cart: Cart = { id, userId, items: [] };
+      carts.set(id, cart);
+      return id;
+    },
+
+    addItem(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      const existingItem = cart.items.find(item => item.productId === productId);
+      if (existingItem) {
+        existingItem.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      emitUpdate(cart);
+    },
+
+    removeItem(cartId, productId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      cart.items = cart.items.filter(item => item.productId !== productId);
+      emitUpdate(cart);
+    },
+
+    getCart(cartId) {
+      const cart = carts.get(cartId);
+      return cart ? { ...cart, items: cart.items.map(item => ({ ...item })) } : null;
+    },
+
+    clearCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      cart.items = [];
+      emitUpdate(cart);
+    },
+
+    updateQuantity(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      if (quantity <= 0) {
+        cart.items = cart.items.filter(item => item.productId !== productId);
+      } else {
+        const item = cart.items.find(i => i.productId === productId);
+        if (item) {
+          item.quantity = quantity;
+        } else {
+          cart.items.push({ productId, quantity });
+        }
+      }
+      emitUpdate(cart);
+    }
+  };
+}
