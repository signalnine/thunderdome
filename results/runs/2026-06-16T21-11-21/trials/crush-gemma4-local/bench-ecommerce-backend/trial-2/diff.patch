+import { EventBus } from '../bus.js';
+import { CatalogService, ProductCreatedEvent } from '../types.js';
+import { Events } from '../types.js';
+
+export function createCatalogService(bus: EventBus): CatalogService {
+  interface Product {
+    id: string;
+    name: string;
+    price: number;
+    category: string;
+  }
+
+  const products = new Map<string, Product>();
+
+  return {
+    createProduct(name, price, category) {
+      const id = Math.random().toString(36).substring(2, 9);
+      const product: Product = { id, name, price, category };
+      products.set(id, product);
+      bus.emit(Events.PRODUCT_CREATED, {
+        productId: id,
+        name,
+        price,
+        category
+      } as ProductCreatedEvent);
+      return id;
+    },
+
+    getProduct(productId) {
+      const product = products.get(productId);
+      return product ? { ...product } : null;
+    },
+
+    listProducts(category) {
+      const all = Array.from(products.values());
+      if (category) {
+        return all
+          .filter(p => p.category === category)
+          .map(p => ({ ...p }));
+      }
+      return all.map(p => ({ ...p }));
+    },
+
+    searchProducts(query) {
+      const q = query.toLowerCase();
+      return Array.from(products.values())
+        .filter(p => p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q))
+        .map(p => ({ ...p }));
+    },
+
+    updateProduct(productId, updates) {
+      const product = products.get(productId);
+      if (product) {
+        const updatedProduct = { ...product, ...updates };
+        products.set(productId, updatedProduct);
+      }
+    },
+
+    removeProduct(productId) {
+      return products.delete(productId);
+    }
+  };
+}
