+import { EventBus } from '../bus.js';
+import { 
+  CartService, 
+  CartUpdatedEvent, 
+  Events,
+  CartItem
+} from '../types.js';
+import { v4 as uuidv4 } from 'uuid';
+
+export interface Cart {
+  id: string;
+  userId: string;
+  items: CartItem[];
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  const emitUpdate = (cart: Cart) => {
+    bus.emit(Events.CART_UPDATED, {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: cart.items,
+    } as CartUpdatedEvent);
+  };
+
+  return {
+    createCart(userId): string {
+      const id = uuidv4();
+      const cart: Cart = { id, userId, items: [] };
+      carts.set(id, cart);
+      emitUpdate(cart);
+      return id;
+    },
+
+    addItem(cartId, productId, quantity): void {
+      const cart = carts.get(cartId);
+      if (cart) {
+        const itemIndex = cart.items.findIndex(i => i.productId === productId);
+        if (itemIndex > -1) {
+          cart.items[itemIndex].quantity += quantity;
+        } else {
+          cart.items.push({ productId, quantity });
+        }
+        emitUpdate(cart);
+      }
+    },
+
+    removeItem(cartId, productId): void {
+      const cart = carts.get(cartId);
+      if (cart) {
+        cart.items = cart.items.filter(i => i.productId !== productId);
+        emitUpdate(cart);
+      }
+    },
+
+    getCart(cartId): Cart | null {
+      return carts.get(cartId) || null;
+    },
+
+    clearCart(cartId): void {
+      const cart = carts.get(cartId);
+      if (cart) {
+        cart.items = [];
+        emitUpdate(cart);
+      }
+    },
+
+    updateQuantity(cartId, productId, quantity): void {
+      const cart = carts.get(cartId);
+      if (cart) {
+        const itemIndex = cart.items.findIndex(i => i.productId === productId);
+        if (itemIndex > -1) {
+          if (quantity <= 0) {
+            cart.items.splice(itemIndex, 1);
+          } else {
+            cart.items[itemIndex].quantity = quantity;
+          }
+          emitUpdate(cart);
+        }
+      }
+    },
+  };
+}
