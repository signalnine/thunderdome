@@ -0,0 +1,82 @@
+import { EventBus } from '../bus.js';
+import { 
+  InventoryService, 
+  InventoryUpdatedEvent, 
+  LowStockAlertEvent 
+} from '../types.js';
+import { Events } from '../types.js';
+
+export interface StockItem {
+  productId: string;
+  quantity: number;
+  threshold: number;
+}
+
+export function createInventoryService(bus: EventBus): InventoryService {
+  const stock = new Map<string, StockItem>();
+  const reserved = new Map<string, number>(); // productId -> quantity
+
+  // Use a helper to get current available stock
+  const getAvailableStock = (productId: string): number => {
+    const item = stock.get(productId);
+    if (!item) return 0;
+    return item.quantity - (reserved.get(productId) || 0);
+  };
+
+  const service: InventoryService = {
+    setStock(productId, quantity): void {
+      const existing = stock.get(productId);
+      const threshold = existing ? existing.threshold : 0;
+      stock.set(productId, { productId, quantity, threshold });
+      
+      bus.emit(Events.INVENTORY_UPDATED, {
+        productId,
+        quantity,
+      } as InventoryUpdatedEvent);
+
+      if (quantity <= threshold) {
+        bus.emit(Events.LOW_STOCK_ALERT, {
+          productId,
+          currentQuantity: quantity,
+          threshold,
+        } as LowStockAlertEvent);
+      }
+    },
+
+    getStock(productId): number {
+      return getAvailableStock(productId);
+    },
+
+    reserve(productId, quantity): boolean {
+      if (getAvailableStock(productId) < quantity) {
+        return false;
+      }
+      reserved.set(productId, (reserved.get(productId) || 0) + quantity);
+      return true;
+    },
+
+    release(productId, quantity): void {
+      const currentReserved = reserved.get(productId) || 0;
+      const newReserved = Math.max(0, currentReserved - quantity);
+      reserved.set(productId, newReserved);
+    },
+
+    setLowStockThreshold(productId, threshold): void {
+      const item = stock.get(productId);
+      if (item) {
+        item.threshold = threshold;
+        stock.set(productId, item);
+        
+        if (item.quantity <= threshold) {
+          bus.emit(Events.LOW_STOCK_ALERT, {
+            productId,
+            currentQuantity: item.quantity,
+            threshold,
+          } as LowStockAlertEvent);
+        }
+      }
+    },
+  };
+
+  return service;
+}
