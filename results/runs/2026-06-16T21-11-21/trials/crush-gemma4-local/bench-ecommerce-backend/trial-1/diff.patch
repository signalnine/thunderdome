+import { EventBus } from '../bus.js';
+import { 
+  PricingService, 
+  PriceCalculatedEvent, 
+  Events,
+  ProductCreatedEvent
+} from '../types.js';
+
+export function createPricingService(bus: EventBus): PricingService {
+  const prices = new Map<string, number>();
+  const discounts = new Map<string, number>();
+
+  // Listen for product creation to initialize price
+  bus.on(Events.PRODUCT_CREATED, (payload: ProductCreatedEvent) => {
+    if (payload && payload.productId) {
+      prices.set(payload.productId, payload.price);
+    }
+  });
+
+  return {
+    calculateTotal(items, discountCode): { subtotal: number; discount: number; tax: number; total: number } {
+      let subtotal = 0;
+      for (const item of items) {
+        const price = prices.get(item.productId) || 0;
+        subtotal += price * item.quantity;
+      }
+
+      let discountPercentage = 0;
+      if (discountCode && discounts.has(discountCode)) {
+        discountPercentage = discounts.get(discountCode)!;
+      }
+
+      const discount = subtotal * (discountPercentage / 100);
+      const tax = (subtotal - discount) * 0.10;
+      const total = subtotal - discount + tax;
+
+      // The prompt mentions PriceCalculatedEvent but doesn't say to emit it from PricingService.
+      // However, the event flow diagram says "analytics --[analytics:event]--> (bus log)"
+      // and "pricing --[product:created]--> pricing (tracks prices)"
+      // It doesn't explicitly say PricingService emits PRICE_CALCULATED.
+      // Wait, the event names list has PRICE_CALCULATED.
+      // Let's check if any other service needs it.
+      // The requirements don't explicitly say PricingService MUST emit it, 
+      // but it's good practice if it's in the Events list.
+      // I'll stick to the requirements.
+
+      return { subtotal, discount, tax, total };
+    },
+
+    addDiscountCode(code, percentage): void {
+      discounts.set(code, percentage);
+    },
+
+    getPrice(productId): number {
+      return prices.get(productId) || 0;
+    },
+  };
+}
