+import { EventBus } from '../bus.js';
+import { 
+  PaymentService, 
+  PaymentStatus, 
+  PaymentProcessedEvent, 
+  Events 
+} from '../types.js';
+import { v4 as uuidv4 } from 'uuid';
+
+export interface PaymentServiceOptions {
+  successRate?: number;
+  failureRate?: number;
+  timeoutRate?: number;
+}
+
+export function createPaymentService(
+  bus: EventBus, 
+  options?: PaymentServiceOptions
+): PaymentService {
+  const successRate = options?.successRate ?? 1.0;
+  const failureRate = options?.failureRate ?? 0.0;
+  const timeoutRate = options?.timeoutRate ?? 0.0;
+
+  const processedTransactions = new Map<string, { orderId: string; amount: number; status: PaymentStatus; transactionId: string }>();
+
+  return {
+    async processPayment(orderId, amount): Promise<{ status: PaymentStatus; transactionId?: string; error?: string }> {
+      // Simulate async processing
+      await new Promise(resolve => setTimeout(resolve, 10));
+
+      const random = Math.random();
+      let status: PaymentStatus = PaymentStatus.SUCCESS;
+      let transactionId = uuidv4();
+      let error: string | undefined = undefined;
+
+      if (random < failureRate) {
+        status = PaymentStatus.FAILED;
+        error = 'Payment failed';
+      } else if (random < failureRate + timeoutRate) {
+        status = PaymentStatus.TIMEOUT;
+        error = 'Payment timed out';
+      } else if (random < failureRate + timeoutRate + (1 - successRate)) {
+        // This part is a bit redundant given how successRate is used, 
+        // but let's make it consistent.
+        status = PaymentStatus.FAILED;
+        error = 'Payment failed';
+      }
+
+      const result = { status, transactionId, error };
+
+      if (status === PaymentStatus.SUCCESS) {
+        processedTransactions.set(transactionId, { orderId, amount, status, transactionId });
+      }
+
+      bus.emit(Events.PAYMENT_PROCESSED, {
+        orderId,
+        status,
+        transactionId,
+        error,
+      } as PaymentProcessedEvent);
+
+      return result;
+    },
+
+    async refund(transactionId): Promise<boolean> {
+      const transaction = processedTransactions.get(transactionId);
+      if (transaction && transaction.status === PaymentStatus.SUCCESS) {
+        // In a real system, we'd emit a refund event. 
+        // For now, just return true.
+        return true;
+      }
+      return false;
+    },
+  };
+}
