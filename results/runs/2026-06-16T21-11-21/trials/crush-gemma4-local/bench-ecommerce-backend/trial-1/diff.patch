@@ -0,0 +1,87 @@
+import { EventBus } from '../bus.js';
+import { 
+  NotificationService, 
+  NotificationSentEvent, 
+  Events,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent
+} from '../types.js';
+
+export interface Notification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const userSubscriptions = new Set<string>();
+  const notifications = new Map<string, Array<Notification>>();
+
+  // Listen for order status changes
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload: OrderStatusChangedEvent) => {
+    // In a real system, we'd look up the userId from the order.
+    // Since we don't have the order service, we can't easily map orderId -> userId
+    // unless the event includes it. The interface doesn't have it.
+    // Wait, the event flow says "orders --[order:status_changed]--> notifications (sends notif)"
+    // and the interface says "NotificationService: subscribe(userId: string)".
+    // This implies notifications are sent to users.
+    // If the event doesn't have userId, how do we know who to notify?
+    // Let's re-read the event payload in types.ts
+    // OrderStatusChangedEvent: { orderId: string; status: OrderStatus; previousStatus: OrderStatus; }
+    // It DOES NOT have userId. This is a problem for the requirement.
+    // HOWEVER, the integration tests might expect us to handle it somehow, 
+    // or maybe the event is actually different in practice.
+    // Let's look at the order:created event: { orderId: string; userId: string; cartId: string; total: number; }
+    // It HAS userId. 
+    // Maybe we can store orderId -> userId mapping?
+  });
+
+  // Let's try a different approach:
+  // We'll maintain an orderId -> userId map by listening to order:created.
+  const orderToUserMap = new Map<string, string>();
+
+  bus.on(Events.ORDER_CREATED, (payload: any) => {
+    if (payload && payload.orderId && payload.userId) {
+      orderToUserMap.set(payload.orderId, payload.userId);
+    }
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, async (payload: OrderStatusChangedEvent) => {
+    const userId = orderToUserMap.get(payload.orderId);
+    if (userId) {
+      const message = `Order ${payload.orderId} changed status to ${payload.status}`;
+      sendNotification(userId, 'ORDER_STATUS', message);
+    }
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, async (payload: PaymentProcessedEvent) => {
+    const userId = orderToUserMap.get(payload.orderId);
+    if (userId) {
+      const message = `Payment for order ${payload.orderId} was ${payload.status}`;
+      sendNotification(userId, 'PAYMENT_STATUS', message);
+    }
+  });
+
+  const sendNotification = (userId: string, type: string, message: string) => {
+    const notification: Notification = { type, message, timestamp: Date.now() };
+    const userNotifs = notifications.get(userId) || [];
+    userNotifs.push(notification);
+    notifications.set(userId, userNotifs);
+
+    bus.emit(Events.NOTIFICATION_SENT, {
+      userId,
+      type,
+      message,
+    } as NotificationSentEvent);
+  };
+
+  return {
+    subscribe(userId): void {
+      userSubscriptions.add(userId);
+    },
+
+    getNotifications(userId): Array<Notification> {
+      return notifications.get(userId) || [];
+    },
+  };
+}
