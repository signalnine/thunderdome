+export type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed';
+
+export interface Task<T = any> {
+  id: string;
+  payload: T;
+  status: TaskStatus;
+  createdAt: Date;
+}
+
+export class TaskQueue<T = any> {
+  private queue: Task<T>[] = [];
+
+  enqueue(payload: T): Task<T> {
+    const task: Task<T> = {
+      id: Math.random().toString(36).substring(2, 15), // Simple UUID replacement
+      payload,
+      status: 'pending',
+      createdAt: new Date(),
+    };
+    this.queue.push(task);
+    return task;
+  }
+
+  dequeue(): Task<T> | null {
+    if (this.queue.length === 0) {
+      return null;
+    }
+    const task = this.queue.shift();
+    if (task) {
+      task.status = 'processing';
+      return task;
+    }
+    return null;
+  }
+
+  size(): number {
+    return this.queue.length;
+  }
+}
