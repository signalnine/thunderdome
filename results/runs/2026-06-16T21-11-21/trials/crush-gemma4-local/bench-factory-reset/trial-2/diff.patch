@@ -0,0 +1,156 @@
+import { describe, it, expect } from 'vitest';
+import { solveToggle, solveCounter } from '../src/index';
+
+describe('solveToggle', () => {
+  it('should return null when no solution exists (example from TASK.md)', () => {
+    const machine = {
+      target: [true, true, false, true],
+      buttons: [
+        [0, 1],
+        [1, 2, 3],
+        [0, 3],
+      ],
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it('should solve a simple toggle puzzle', () => {
+    const machine = {
+      target: [true, false, true],
+      buttons: [
+        [0],
+        [1],
+        [2],
+      ],
+    };
+    expect(solveToggle(machine)).toEqual([0, 2]);
+  });
+
+  it('should return the fewest button presses', () => {
+    const machine = {
+      target: [true, true],
+      buttons: [
+        [0, 1], // 1 press
+        [0],    // 2 presses if we use 0 and 1? No, button 1 is [0]
+        [1],    // 2 presses if we use 0 and 1? No, button 1 is [1]
+      ],
+    };
+    // buttons: 0:[0,1], 1:[0], 2:[1]
+    // target [T, T]
+    // options: {0} -> [T, T] (1 press)
+    //          {1, 2} -> [T, T] (2 presses)
+    // should return [0]
+    expect(solveToggle(machine)).toEqual([0]);
+  });
+
+  it('should return lexicographically smallest set when press counts are tied', () => {
+    const machine = {
+      target: [true],
+      buttons: [
+        [0],
+        [0],
+      ],
+    };
+    // Both [0] and [1] are 1 press. [0] is lexicographically smaller.
+    expect(solveToggle(machine)).toEqual([0]);
+  });
+
+  it('should handle a larger puzzle', () => {
+    const machine = {
+      target: [true, true, true, true, true],
+      buttons: [
+        [0, 1],
+        [1, 2],
+        [2, 3],
+        [3, 4],
+        [4, 0],
+      ],
+    };
+    // Target [T, T, T, T, T]
+    // Each light must be toggled odd number of times.
+    // If we press all:
+    // 0: 0,4
+    // 1: 0,1
+    // 2: 1,2
+    // 3: 2,3
+    // 4: 3,4
+    // Each light is toggled twice (even).
+    // If we press all 5:
+    // 0: toggled by 0 and 4 (2)
+    // 1: toggled by 0 and 1 (2)
+    // ... all even.
+    // Wait, if N=5, M=5, buttons are [i, i+1%5].
+    // To get [T, T, T, T, T]:
+    // b0 + b4 = 1 mod 2
+    // b0 + b1 = 1 mod 2
+    // b1 + b2 = 1 mod 2
+    // b2 + b3 = 1 mod 2
+    // b3 + b4 = 1 mod 2
+    // Summing all: 2(b0+b1+b2+b3+b4) = 5 mod 2 => 0 = 1 mod 2. Impossible.
+    expect(solveToggle(machine)).toBeNull();
+  });
+});
+
+describe('solveCounter', () => {
+  it('should solve a simple counter puzzle', () => {
+    const lights = [1, 2];
+    const buttons = [[0], [1]];
+    const modulus = 3;
+    // Button 0: increments light 0
+    // Button 1: increments light 1
+    // Target: [1, 2]
+    // Result: [1, 2]
+    expect(solveCounter(lights, buttons, modulus)).toEqual([1, 2]);
+  });
+
+  it('should solve with wrap around', () => {
+    const lights = [0];
+    const buttons = [[0]];
+    const modulus = 5;
+    // Target 0, but we press button 5 times? No, 0 to modulus-1.
+    // If target is 0, min presses is 0.
+    expect(solveCounter(lights, buttons, modulus)).toEqual([0]);
+    
+    // Target 4, modulus 5. Press 4 times.
+    expect(solveCounter([4], [[0]], 5)).toEqual([4]);
+  });
+
+  it('should return the minimum total presses', () => {
+    const lights = [1];
+    const buttons = [[0], [0]];
+    const modulus = 3;
+    // Target: [1]
+    // Option 1: Button 0 pressed 1 time. Total = 1.
+    // Option 2: Button 1 pressed 1 time. Total = 1.
+    // Option 3: Button 0 pressed 2, Button 1 pressed 2. 2+2=4 mod 3 = 1. Total = 4.
+    // Tie between [1, 0] and [0, 1] (lexicographically). 
+    // Wait, lexicographical order: [0, 1] is smaller than [1, 0]?
+    // [0, 1] means button 0 pressed 0 times, button 1 pressed 1 time.
+    // [1, 0] means button 0 pressed 1 time, button 1 pressed 0 times.
+    // [0, 1] is lexicographically smaller.
+    expect(solveCounter(lights, buttons, modulus)).toEqual([0, 1]);
+  });
+
+  it('should return null if no solution exists', () => {
+    const lights = [1];
+    const buttons = [[0], [0]];
+    const modulus = 2;
+    // Button 0 and 1 both increment light 0.
+    // Target 1:
+    // b0 + b1 = 1 mod 2
+    // (0,1) -> sum 1
+    // (1,0) -> sum 1
+    // (0,1) is smaller.
+    // Wait, if target is 1 and modulus is 2, 
+    // b0 + b1 = 1 mod 2. Solutions: [0,1] and [1,0].
+    // If target is 0 and modulus 2:
+    // b0 + b1 = 0 mod 2. Solutions: [0,0] and [1,1].
+    // [0,0] is smaller.
+    // What if no solution? 
+    // If lights = [1], buttons = [[0], [0]], modulus = 2, target [1].
+    // This is always solvable for prime modulus if buttons can cover the light.
+    // A case with no solution:
+    // lights = [1], buttons = [], modulus = 2.
+    expect(solveCounter([1], [], 2)).toBeNull();
+  });
+});
