+export interface Machine {
+  target: boolean[];     // desired state for each light (all start off)
+  buttons: number[][];   // buttons[i] = array of light indices toggled by button i
+}
+
+/**
+ * Solves the toggle puzzle.
+ * 
+ * @param machine The machine configuration.
+ * @returns An array of button indices to press, or null if no solution exists.
+ */
+export function solveToggle(machine: Machine): number[] | null {
+  const numLights = machine.target.length;
+  const numButtons = machine.buttons.length;
+
+  // A * x = b over GF(2)
+  // matrix[row][col]
+  const matrix: number[][] = Array.from({ length: numLights }, () => Array(numButtons + 1).fill(0));
+
+  for (let j = 0; j < numButtons; j++) {
+    for (const lightIdx of machine.buttons[j]) {
+      matrix[lightIdx][j] = 1;
+    }
+  }
+
+  for (let i = 0; i < numLights; i++) {
+    matrix[i][numButtons] = machine.target[i] ? 1 : 0;
+  }
+
+  // Gaussian elimination
+  let pivotRow = 0;
+  const pivotColToRow = new Array(numButtons).fill(-1);
+
+  for (let col = 0; col < numButtons && pivotRow < numLights; col++) {
+    let sel = pivotRow;
+    while (sel < numLights && matrix[sel][col] === 0) {
+      sel++;
+    }
+
+    if (sel === numLights) continue;
+
+    [matrix[sel], matrix[pivotRow]] = [matrix[pivotRow], matrix[sel]];
+    pivotColToRow[col] = pivotRow;
+
+    for (let i = 0; i < numLights; i++) {
+      if (i !== pivotRow && matrix[i][col] === 1) {
+        for (let j = col; j <= numButtons; j++) {
+          matrix[i][j] ^= matrix[pivotRow][j];
+        }
+      }
+    }
+    pivotRow++;
+  }
+
+  // Check for consistency
+  for (let i = pivotRow; i < numLights; i++) {
+    if (matrix[i][numButtons] === 1) {
+      return null;
+    }
+  }
+
+  const freeVars: number[] = [];
+  for (let j = 0; j < numButtons; j++) {
+    if (pivotColToRow[j] === -1) {
+      freeVars.push(j);
+    }
+  }
+
+  const particularSolution = new Array(numButtons).fill(0);
+  for (let col = 0; col < numButtons; col++) {
+    const row = pivotColToRow[col];
+    if (row !== -1) {
+      particularSolution[col] = matrix[row][numButtons];
+    }
+  }
+
+  const basis: number[][] = [];
+  for (const fv of freeVars) {
+    const vec = new Array(numButtons).fill(0);
+    vec[fv] = 1;
+    for (let col = 0; col < numButtons; col++) {
+      const row = pivotColToRow[col];
+      if (row !== -1 && matrix[row][fv] === 1) {
+        vec[col] = 1;
+      }
+    }
+    basis.push(vec);
+  }
+
+  let minWeight = Infinity;
+  let bestIndices: number[] | null = null;
+
+  function compareIndices(a: number[], b: number[]): number {
+    const len = Math.min(a.length, b.length);
+    for (let i = 0; i < len; i++) {
+      if (a[i] < b[i]) return -1;
+      if (a[i] > b[i]) return 1;
+    }
+    return a.length - b.length;
+  }
+
+  const numFree = freeVars.length;
+  // If numFree is large, we must use a different approach, but let's try up to 22.
+  const limit = Math.min(numFree, 22);
+
+  for (let i = 0; i < (1 << limit); i++) {
+    const currentSol = [...particularSolution];
+    for (let j = 0; j < limit; j++) {
+      if ((i >> j) & 1) {
+        for (let k = 0; k < numButtons; k++) {
+          currentSol[k] ^= basis[j][k];
+        }
+      }
+    }
+
+    const currentIndices: number[] = [];
+    for (let k = 0; k < numButtons; k++) {
+      if (currentSol[k] === 1) currentIndices.push(k);
+    }
+
+    const currentWeight = currentIndices.length;
+
+    if (currentWeight < minWeight) {
+      minWeight = currentWeight;
+      bestIndices = currentIndices;
+    } else if (currentWeight === minWeight) {
+      if (bestIndices === null || compareIndices(currentIndices, bestIndices) < 0) {
+        bestIndices = currentIndices;
+      }
+    }
+  }
+
+  return bestIndices;
+}
+
+/**
+ * Solves the counter puzzle.
+ * 
+ * @param lights The target counter values.
+ * @param buttons The button configurations.
+ * @param modulus The modulus for the counters (always prime).
+ * @returns An array of button press counts, or null if no solution exists.
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): number[] | null {
+  // A * x = b over GF(p)
+  // matrix[row][col]
+  const numCounters = lights.length;
+  const numButtons = buttons.length;
+
+  const matrix: number[][] = Array.from({ length: numCounters }, () => Array(numButtons + 1).fill(0));
+
+  for (let j = 0; j < numButtons; j++) {
+    for (const counterIdx of buttons[j]) {
+      matrix[counterIdx][j] = 1;
+    }
+  }
+
+  for (let i = 0; i < numCounters; i++) {
+    matrix[i][numButtons] = lights[i];
+  }
+
+  // Modular inverse helper
+  function modInverse(a: number, m: number): number {
+    for (let x = 1; x < m; x++) {
+      if ((a * x) % m === 1) return x;
+    }
+    return 1;
+  }
+
+  // Gaussian elimination over GF(p)
+  let pivotRow = 0;
+  const pivotColToRow = new Array(numButtons).fill(-1);
+
+  for (let col = 0; col < numButtons && pivotRow < numCounters; col++) {
+    let sel = pivotRow;
+    while (sel < numCounters && matrix[sel][col] % modulus === 0) {
+      sel++;
+    }
+
+    if (sel === numCounters) continue;
+
+    [matrix[sel], matrix[pivotRow]] = [matrix[pivotRow], matrix[sel]];
+    pivotColToRow[col] = pivotRow;
+
+    const inv = modInverse(matrix[pivotRow][col], modulus);
+    for (let j = col; j <= numButtons; j++) {
+      matrix[pivotRow][j] = (matrix[pivotRow][j] * inv) % modulus;
+    }
+
+    for (let i = 0; i < numCounters; i++) {
+      if (i !== pivotRow && matrix[i][col] % modulus !== 0) {
+        const factor = matrix[i][col];
+        for (let j = col; j <= numButtons; j++) {
+          matrix[i][j] = (matrix[i][j] - factor * matrix[pivotRow][j] % modulus + modulus) % modulus;
+        }
+      }
+    }
+    pivotRow++;
+  }
+
+  // Check for consistency
+  for (let i = pivotRow; i < numCounters; i++) {
+    if (matrix[i][numButtons] % modulus !== 0) {
+      return null;
+    }
+  }
+
+  const freeVars: number[] = [];
+  for (let j = 0; j < numButtons; j++) {
+    if (pivotColToRow[j] === -1) {
+      freeVars.push(j);
+    }
+  }
+
+  const particularSolution = new Array(numButtons).fill(0);
+  for (let col = 0; col < numButtons; col++) {
+    const row = pivotColToRow[col];
+    if (row !== -1) {
+      particularSolution[col] = matrix[row][numButtons];
+    }
+  }
+
+  const basis: number[][] = [];
+  for (const fv of freeVars) {
+    const vec = new Array(numButtons).fill(0);
+    vec[fv] = 1;
+    for (let col = 0; col < numButtons; col++) {
+      const row = pivotColToRow[col];
+      if (row !== -1) {
+        vec[col] = matrix[row][fv];
+      }
+    }
+    basis.push(vec);
+  }
+
+  let minTotalPresses = Infinity;
+  let bestResult: number[] | null = null;
+
+  function compareResults(a: number[], b: number[]): number {
+    for (let i = 0; i < a.length; i++) {
+      if (a[i] < b[i]) return -1;
+      if (a[i] > b[i]) return 1;
+    }
+    return 0;
+  }
+
+  // If freeVars is large, we can't brute force.
+  // But for numButtons=40, if freeVars is up to 20, it's fine.
+  const numFree = freeVars.length;
+  const limit = Math.min(numFree, 20);
+
+  // To find the absolute minimum, we might need a better approach than brute force if numFree is large.
+  // But let's try brute force for now.
+  for (let i = 0; i < (1 << limit); i++) {
+    const currentSol = [...particularSolution];
+    for (let j = 0; j < limit; j++) {
+      if ((i >> j) & 1) {
+        for (let k = 0; k < numButtons; k++) {
+          currentSol[k] = (currentSol[k] + basis[j][k]) % modulus;
+        }
+      }
+    }
+
+    const currentTotal = currentSol.reduce((a, b) => a + b, 0);
+
+    if (currentTotal < minTotalPresses) {
+      minTotalPresses = currentTotal;
+      bestResult = [...currentSol];
+    } else if (currentTotal === minTotalPresses) {
+      if (bestResult === null || compareResults(currentSol, bestResult) < 0) {
+        bestResult = [...currentSol];
+      }
+    }
+  }
+
+  return bestResult;
+}
