@@ -0,0 +1,103 @@
+import { Machine, solveToggle, solveCounter } from '../src/index';
+
+describe('solveToggle', () => {
+  it('should return null for the example provided in the task', () => {
+    const machine: Machine = {
+      target: [true, true, false, true],
+      buttons: [
+        [0, 1],
+        [1, 2, 3],
+        [0, 3]
+      ]
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it('should solve a simple toggle puzzle', () => {
+    const machine: Machine = {
+      target: [true, true, false, false],
+      buttons: [
+        [0, 1],
+        [1, 2],
+        [0, 2]
+      ]
+    };
+    // Button 0 toggles [0, 1]
+    // Button 1 toggles [1, 2]
+    // Button 2 toggles [0, 2]
+    // Target [T, T, F, F]
+    // b0 ^ b2 = 1 (light 0)
+    // b0 ^ b1 = 1 (light 1)
+    // b1 ^ b2 = 0 (light 2)
+    // If b2=0, b0=1, b1=1. Check light 2: 1 ^ 0 = 1 != 0.
+    // If b2=1, b0=0, b1=1. Check light 2: 1 ^ 1 = 0. Correct!
+    // Solution: [1, 2]
+    expect(solveToggle(machine)).toEqual([1, 2]);
+  });
+
+  it('should find the minimum set of buttons', () => {
+    const machine: Machine = {
+      target: [true, false, false, false],
+      buttons: [
+        [0],
+        [0],
+        [0]
+      ]
+    };
+    // Target [T, F, F, F]
+    // Button 0: [0]
+    // Button 1: [0]
+    // Button 2: [0]
+    // Any single button works. Min presses is 1.
+    // Lexicographically smallest: [0]
+    expect(solveToggle(machine)).toEqual([0]);
+  });
+});
+
+describe('solveCounter', () => {
+  it('should return null when no solution exists', () => {
+    const lights = [1];
+    const buttons = [[0]];
+    const modulus = 2;
+    // Target 1, Button 0 increments light 0.
+    // Button 0 can be pressed 0 or 1 times.
+    // If pressed 1 time, result is 1.
+    // Wait, this should have a solution.
+    expect(solveCounter(lights, buttons, modulus)).toEqual([1]);
+  });
+
+  it('should return null when no solution exists (modulus mismatch)', () => {
+    const lights = [1];
+    const buttons = [[0]];
+    const modulus = 3;
+    // Button 0 can be pressed 0, 1, 2 times.
+    // If pressed 1 time, result is 1.
+    expect(solveCounter(lights, buttons, modulus)).toEqual([1]);
+  });
+
+  it('should solve a simple counter puzzle', () => {
+    const lights = [1, 2];
+    const buttons = [[0], [1], [0, 1]];
+    const modulus = 3;
+    // b0 + b2 = 1 (mod 3)
+    // b1 + b2 = 2 (mod 3)
+    // Possible b2 values: 0, 1, 2
+    // if b2=0: b0=1, b1=2. Total = 3.
+    // if b2=1: b0=0, b1=1. Total = 2.
+    // if b2=2: b0=2, b1=0. Total = 2.
+    // Ties on total: [1, 1] vs [0, 2] (Wait, b2 is index 2)
+    // result array is [b0, b1, b2]
+    // b2=1: [0, 1, 1] -> Total 2.
+    // b2=2: [2, 0, 2] -> Total 4.
+    // Wait, b2=1 is [0, 1, 1]. Total 2.
+    // b2=2 is [2, 0, 2]. Total 4.
+    // Wait, let me re-calculate.
+    // b0+b2=1 mod 3
+    // b1+b2=2 mod 3
+    // b2=0 => b0=1, b1=2. [1, 2, 0]. Total 3.
+    // b2=1 => b0=0, b1=1. [0, 1, 1]. Total 2.
+    // b2=2 => b0=2, b1=0. [2, 0, 2]. Total 4.
+    // Min total is 2. Result [0, 1, 1].
+    expect(solveCounter(lights, buttons, modulus)).toEqual([0, 1, 1]);
+  });
+});
