+export interface Machine {
+  target: boolean[];     // desired state for each light (all start off)
+  buttons: number[][];   // buttons[i] = array of light indices toggled by button i
+}
+
+/**
+ * Solves the Toggle Puzzle using Gaussian elimination over GF(2).
+ * To find the minimum number of presses and lexicographically smallest,
+ * we use back-substitution and handle free variables.
+ * 
+ * Constraints: up to 40 buttons and 40 lights.
+ */
+export function solveToggle(machine: Machine): number[] | null {
+  const numLights = machine.target.length;
+  const numButtons = machine.buttons.length;
+
+  const matrix: bigint[][] = Array.from({ length: numLights }, () => new Array(numButtons + 1).fill(0n));
+
+  for (let i = 0; i < numLights; i++) {
+    for (let j = 0; j < numButtons; j++) {
+      if (machine.buttons[j].includes(i)) {
+        matrix[i][j] = 1n;
+      }
+    }
+    matrix[i][numButtons] = machine.target[i] ? 1n : 0n;
+  }
+
+  let pivotRow = 0;
+  for (let col = 0; col < numButtons && pivotRow < numLights; col++) {
+    let sel = pivotRow;
+    while (sel < numLights && matrix[sel][col] === 0n) {
+      sel++;
+    }
+    if (sel === numLights) continue;
+
+    [matrix[sel], matrix[pivotRow]] = [matrix[pivotRow], matrix[sel]];
+
+    for (let i = 0; i < numLights; i++) {
+      if (i !== pivotRow && matrix[i][col] === 1n) {
+        for (let j = col; j <= numButtons; j++) {
+          matrix[i][j] ^= matrix[pivotRow][j];
+        }
+      }
+    }
+    pivotRow++;
+  }
+
+  for (let i = pivotRow; i < numLights; i++) {
+    if (matrix[i][numButtons] === 1n) return null;
+  }
+
+  const isPivotCol = new Array(numButtons).fill(false);
+  const pivotToRow = new Array(numButtons).fill(-1);
+  for (let j = 0; j < numButtons; j++) {
+    for (let i = 0; i < numLights; i++) {
+      let firstIdx = -1;
+      for (let k = 0; k < numButtons; k++) {
+        if (matrix[i][k] === 1n) {
+          firstIdx = k;
+          break;
+        }
+      }
+      if (firstIdx === j) {
+        isPivotCol[j] = true;
+        pivotToRow[j] = i;
+        break;
+      }
+    }
+  }
+
+  const freeCols: number[] = [];
+  for (let j = 0; j < numButtons; j++) {
+    if (!isPivotCol[j]) freeCols.push(j);
+  }
+
+  let minWeight = Infinity;
+  let bestSolution: number[] | null = null;
+  const currentX = new Array(numButtons).fill(0);
+
+  function compareArrays(a: number[], b: number[]): number {
+    for (let i = 0; i < Math.min(a.length, b.length); i++) {
+      if (a[i] < b[i]) return -1;
+      if (a[i] > b[i]) return 1;
+    }
+    return a.length - b.length;
+  }
+
+  function backtrack(freeIdx: number) {
+    if (freeIdx === freeCols.length) {
+      const x = [...currentX];
+      let weight = 0;
+      for (let j = 0; j < numButtons; j++) {
+        if (isPivotCol[j]) {
+          const row = pivotToRow[j];
+          let val = Number(matrix[row][numButtons]);
+          for (let k = j + 1; k < numButtons; k++) {
+            if (matrix[row][k] === 1n) {
+              val ^= currentX[k];
+            }
+          }
+          x[j] = val;
+        }
+        if (x[j] === 1) weight++;
+      }
+
+      if (weight < minWeight) {
+        minWeight = weight;
+        bestSolution = x.map((val, idx) => val === 1 ? idx : -1).filter(idx => idx !== -1);
+      } else if (weight === minWeight) {
+        const currentIndices = x.map((val, idx) => val === 1 ? idx : -1).filter(idx => idx !== -1);
+        if (bestSolution === null || compareArrays(currentIndices, bestSolution) < 0) {
+          bestSolution = currentIndices;
+        }
+      }
+      return;
+    }
+
+    currentX[freeCols[freeIdx]] = 0;
+    backtrack(freeIdx + 1);
+    currentX[freeCols[freeIdx]] = 1;
+    backtrack(freeIdx + 1);
+  }
+
+  backtrack(0);
+  return bestSolution;
+}
+
+/**
+ * Solves the Counter Puzzle using Gaussian elimination over GF(p).
+ * 
+ * Constraints: up to 40 buttons, 40 counters, modulus up to 97 (prime).
+ * We need minimum total presses and lexicographically smallest result.
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): number[] | null {
+  const numCounters = lights.length;
+  const numButtons = buttons.length;
+
+  const matrix: number[][] = Array.from({ length: numCounters }, () => new Array(numButtons + 1).fill(0));
+
+  for (let i = 0; i < numCounters; i++) {
+    for (let j = 0; j < numButtons; j++) {
+      if (buttons[j].includes(i)) {
+        matrix[i][j] = 1;
+      }
+    }
+    matrix[i][numButtons] = lights[i];
+  }
+
+  let pivotRow = 0;
+  const pivotColToRow = new Array(numButtons).fill(-1);
+
+  for (let col = 0; col < numButtons && pivotRow < numCounters; col++) {
+    let sel = pivotRow;
+    while (sel < numCounters && matrix[sel][col] === 0) {
+      sel++;
+    }
+    if (sel === numCounters) continue;
+
+    [matrix[sel], matrix[pivotRow]] = [matrix[pivotRow], matrix[sel]];
+    pivotColToRow[col] = pivotRow;
+
+    const inv = modInverse(matrix[pivotRow][col], modulus);
+    for (let j = col; j <= numButtons; j++) {
+      matrix[pivotRow][j] = (matrix[pivotRow][j] * inv) % modulus;
+    }
+
+    for (let i = 0; i < numCounters; i++) {
+      if (i !== pivotRow && matrix[i][col] !== 0) {
+        const factor = matrix[i][col];
+        for (let j = col; j <= numButtons; j++) {
+          matrix[i][j] = (matrix[i][j] - factor * matrix[pivotRow][j] % modulus + modulus) % modulus;
+        }
+      }
+    }
+    pivotRow++;
+  }
+
+  for (let i = pivotRow; i < numCounters; i++) {
+    if (matrix[i][numButtons] !== 0) return null;
+  }
+
+  const isPivotCol = new Array(numButtons).fill(false);
+  for (let j = 0; j < numButtons; j++) {
+    if (pivotColToRow[j] !== -1) isPivotCol[j] = true;
+  }
+
+  const freeCols: number[] = [];
+  for (let j = 0; j < numButtons; j++) {
+    if (!isPivotCol[j]) freeCols.push(j);
+  }
+
+  let minTotalPresses = Infinity;
+  let bestResult: number[] | null = null;
+  const currentX = new Array(numButtons).fill(0);
+
+  function compareResults(a: number[], b: number[]): number {
+    for (let i = 0; i < a.length; i++) {
+      if (a[i] < b[i]) return -1;
+      if (a[i] > b[i]) return 1;
+    }
+    return 0;
+  }
+
+  function backtrack(freeIdx: number) {
+    if (freeIdx === freeCols.length) {
+      const x = [...currentX];
+      let totalPresses = 0;
+      for (let j = 0; j < numButtons; j++) {
+        if (isPivotCol[j]) {
+          const row = pivotColToRow[j];
+          let val = matrix[row][numButtons];
+          for (let k = j + 1; k < numButtons; k++) {
+            if (matrix[row][k] !== 0) {
+              val = (val - matrix[row][k] * x[k] % modulus + modulus) % modulus;
+            }
+          }
+          x[j] = val;
+        }
+        totalPresses += x[j];
+      }
+
+      if (totalPresses < minTotalPresses) {
+        minTotalPresses = totalPresses;
+        bestResult = [...x];
+      } else if (totalPresses === minTotalPresses) {
+        if (bestResult === null || compareResults(x, bestResult) < 0) {
+          bestResult = [...x];
+        }
+      }
+      return;
+    }
+
+    for (let v = 0; v < modulus; v++) {
+      currentX[freeCols[freeIdx]] = v;
+      backtrack(freeIdx + 1);
+    }
+  }
+
+  backtrack(0);
+  return bestResult;
+}
+
+function modInverse(a: number, m: number): number {
+  let m0 = m, t, q;
+  let x0 = 0, x1 = 1;
+  if (m === 1) return 0;
+  while (a > 1) {
+    q = Math.floor(a / m);
+    t = m;
+    m = a % m;
+    a = t;
+    t = x0;
+    x0 = x1 - q * x0;
+    x1 = t;
+  }
+  if (x1 < 0) x1 += m0;
+  return x1;
+}
