+import { describe, it, expect } from 'vitest';
+import { solveToggle, solveCounter, Machine } from '../src/index';
+
+describe('solveToggle', () => {
+  it('should return null when no solution exists (example from prompt)', () => {
+    const machine: Machine = {
+      target: [true, true, false, true],
+      buttons: [
+        [0, 1],
+        [1, 2, 3],
+        [0, 3],
+      ],
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it('should solve a simple case', () => {
+    const machine: Machine = {
+      target: [true, false, true],
+      buttons: [
+        [0],
+        [1],
+        [2],
+      ],
+    };
+    expect(solveToggle(machine)).toEqual([0, 2]);
+  });
+
+  it('should return the minimum set of buttons', () => {
+    const machine: Machine = {
+      target: [true],
+      buttons: [
+        [0],
+        [0],
+      ],
+    };
+    // Both [0] and [1] solve it. [0] is lexicographically smaller.
+    expect(solveToggle(machine)).toEqual([0]);
+  });
+
+  it('should return lexicographically smallest if tied on count', () => {
+    const machine: Machine = {
+      target: [true, true],
+      buttons: [
+        [0],
+        [1],
+        [0, 1],
+      ],
+    };
+    // [0, 1] toggles both. But [0] and [1] only toggle one.
+    // Wait, target is [T, T]. 
+    // Buttons: 0:[0], 1:[1], 2:[0, 1]
+    // Solutions: [2] (1 press) OR [0, 1] (2 presses).
+    // Min presses is [2].
+    expect(solveToggle(machine)).toEqual([2]);
+  });
+});
+
+describe('solveCounter', () => {
+  it('should solve a simple case', () => {
+    const lights = [1, 1, 1];
+    const buttons = [[0], [1], [2]];
+    const modulus = 5;
+    expect(solveCounter(lights, buttons, modulus)).toEqual([1, 1, 1]);
+  });
+
+  it('should return null if no solution exists', () => {
+    const lights = [1, 0];
+    const buttons = [[0, 1]];
+    const modulus = 5;
+    // Button 0: [1, 1], [2, 2], [3, 3], [4, 4], [0, 0]
+    // Cannot get [1, 0]
+    expect(solveCounter(lights, buttons, modulus)).toBeNull();
+  });
+
+  it('should handle multiple presses and modulus', () => {
+    const lights = [2, 3];
+    const buttons = [[0], [1]];
+    const modulus = 5;
+    expect(solveCounter(lights, buttons, modulus)).toEqual([2, 3]);
+  });
+
+  it('should return the solution with minimum total presses', () => {
+    const lights = [1];
+    const buttons = [[0], [0]];
+    const modulus = 5;
+    // Button 0: 1 press. Button 1: 1 press.
+    // Both have total presses = 1. Lexicographically smallest [0] < [1].
+    expect(solveCounter(lights, buttons, modulus)).toEqual([0]);
+  });
+
+  it('should handle complex interactions', () => {
+    const lights = [1, 1];
+    const buttons = [[0, 1], [0], [1]];
+    const modulus = 3;
+    // Solution 1: Button 0 once -> [1, 1]. Total = 1.
+    // Solution 2: Button 1 once, Button 2 once -> [1, 1]. Total = 2.
+    // Min total is 1.
+    expect(solveCounter(lights, buttons, modulus)).toEqual([0]);
+  });
+});
