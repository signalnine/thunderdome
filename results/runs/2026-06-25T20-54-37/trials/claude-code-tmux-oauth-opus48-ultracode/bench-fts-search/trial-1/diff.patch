+// Full-text search index over note titles and bodies.
+//
+// `notes_fts` is an FTS5 virtual table that uses `notes` as its external
+// content source (content='notes', content_rowid='id'), so the FTS index
+// stores only the search structure while the text is read back from `notes`.
+// Triggers mirror every INSERT/UPDATE/DELETE on `notes` into the index, which
+// keeps search results in sync without touching the CRUD handlers.
+function setupFts(db: Database.Database): void {
+  const ftsExisted =
+    db
+      .prepare("SELECT 1 FROM sqlite_master WHERE type='table' AND name='notes_fts'")
+      .get() !== undefined;
+
+  db.exec(`
+    CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts USING fts5(
+      title,
+      body,
+      content='notes',
+      content_rowid='id',
+      tokenize='unicode61'
+    );
+  `);
+
+  db.exec(`
+    CREATE TRIGGER IF NOT EXISTS notes_fts_ai AFTER INSERT ON notes BEGIN
+      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);
+    END;
+
+    CREATE TRIGGER IF NOT EXISTS notes_fts_ad AFTER DELETE ON notes BEGIN
+      INSERT INTO notes_fts(notes_fts, rowid, title, body)
+        VALUES ('delete', old.id, old.title, old.body);
+    END;
+
+    CREATE TRIGGER IF NOT EXISTS notes_fts_au AFTER UPDATE ON notes BEGIN
+      INSERT INTO notes_fts(notes_fts, rowid, title, body)
+        VALUES ('delete', old.id, old.title, old.body);
+      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);
+    END;
+  `);
+
+  // Backfill the index only when it was just created over an already-populated
+  // notes table (e.g. adding search to a pre-existing database file). When the
+  // index already existed, the triggers above have kept it in sync, so a full
+  // rebuild on every open would be wasted O(n) work. Fresh databases have no
+  // rows yet, so this is a no-op for the test suites.
+  if (!ftsExisted) {
+    const { count } = db.prepare('SELECT count(*) AS count FROM notes').get() as {
+      count: number;
+    };
+    if (count > 0) {
+      db.exec(`INSERT INTO notes_fts(notes_fts) VALUES ('rebuild');`);
+    }
+  }
+}
