+import { Router, Request, Response, NextFunction } from 'express';
+import Database from 'better-sqlite3';
+import { SearchResult, SuggestResult } from './models.js';
+import { ValidationError } from './errors.js';
+
+const PER_PAGE = 20;
+const SUGGEST_LIMIT = 5;
+const SNIPPET_TOKENS = 32;
+// Upper bound on `page` so the computed OFFSET always stays within SQLite's
+// signed-64-bit integer range. Without this, an absurdly large page value
+// (e.g. ?page=99999999999999999999) overflows int64, gets bound as a REAL, and
+// SQLite's OFFSET clause rejects it with SQLITE_MISMATCH -> an unhandled 500.
+const MAX_PAGE = 1_000_000;
+
+// Extract unicode word tokens (letters/numbers) from arbitrary text.
+function tokenize(text: string): string[] {
+  return text.match(/[\p{L}\p{N}]+/gu) ?? [];
+}
+
+// Build a safe FTS5 MATCH expression from arbitrary user input.
+//
+// Double-quoted spans become exact phrases; everything else becomes individual
+// terms (implicitly AND-ed by FTS5). Every token and phrase is wrapped in
+// double quotes, which makes the FTS5 query parser treat it as literal text —
+// so operators (AND/OR/NOT/NEAR), prefixes (*), columns (:) and punctuation in
+// untrusted input can never produce a syntax error. Returns '' when the input
+// contains no searchable tokens.
+function buildMatchQuery(raw: string): string {
+  const parts: string[] = [];
+
+  // Pull out quoted phrases first, replacing each with a space in the remainder.
+  const remainder = raw.replace(/"([^"]*)"/g, (_match, inner: string) => {
+    const toks = tokenize(inner);
+    if (toks.length > 0) {
+      parts.push(`"${toks.join(' ')}"`);
+    }
+    return ' ';
+  });
+
+  // Remaining loose words become single-term phrases.
+  for (const tok of tokenize(remainder)) {
+    parts.push(`"${tok}"`);
+  }
+
+  return parts.join(' ');
+}
+
+// Build a prefix MATCH expression for autocomplete: the final token matches as
+// a prefix (e.g. `learn` -> `"learn"*`) while earlier tokens match exactly.
+// Returns '' when the input contains no searchable tokens.
+function buildPrefixQuery(raw: string): string {
+  const toks = tokenize(raw);
+  if (toks.length === 0) return '';
+  return toks
+    .map((tok, i) => (i === toks.length - 1 ? `"${tok}"*` : `"${tok}"`))
+    .join(' ');
+}
+
+// Query params can be string | string[] | ParsedQs; normalise to a plain string.
+// A repeated param (e.g. ?q=a&q=b) arrives as an array — use its first value
+// rather than treating the (present) param as missing.
+function asString(value: unknown): string {
+  if (typeof value === 'string') return value;
+  if (Array.isArray(value) && typeof value[0] === 'string') return value[0];
+  return '';
+}
+
+export function createSearchRoutes(db: Database.Database): Router {
+  const router = Router();
+
+  const searchStmt = db.prepare(`
+    SELECT
+      rowid AS id,
+      title,
+      snippet(notes_fts, -1, '<mark>', '</mark>', '...', ${SNIPPET_TOKENS}) AS snippet,
+      bm25(notes_fts) AS rank
+    FROM notes_fts
+    WHERE notes_fts MATCH ?
+    ORDER BY rank
+    LIMIT ? OFFSET ?
+  `);
+
+  const countStmt = db.prepare(`
+    SELECT COUNT(*) AS total FROM notes_fts WHERE notes_fts MATCH ?
+  `);
+
+  const suggestStmt = db.prepare(`
+    SELECT rowid AS id, title
+    FROM notes_fts
+    WHERE notes_fts MATCH ?
+    ORDER BY rank
+    LIMIT ?
+  `);
+
+  // GET /notes/search?q=<query>&page=N
+  // Relevance-ranked (BM25) full-text search across note titles and bodies,
+  // with <mark>-highlighted snippets and 20-results-per-page pagination.
+  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {
+    try {
+      const q = asString(req.query.q);
+      if (q.trim() === '') {
+        throw new ValidationError('Query parameter "q" is required');
+      }
+
+      let page = parseInt(asString(req.query.page) || '1', 10);
+      if (!Number.isFinite(page) || page < 1) page = 1;
+      page = Math.min(page, MAX_PAGE);
+
+      const match = buildMatchQuery(q);
+      if (match === '') {
+        res.json({ results: [], total: 0, page, perPage: PER_PAGE });
+        return;
+      }
+
+      const offset = (page - 1) * PER_PAGE;
+      const results = searchStmt.all(match, PER_PAGE, offset) as SearchResult[];
+      const { total } = countStmt.get(match) as { total: number };
+
+      res.json({ results, total, page, perPage: PER_PAGE });
+    } catch (err) {
+      next(err);
+    }
+  });
+
+  // GET /notes/search/suggest?q=<prefix>
+  // Autocomplete returning up to 5 note titles whose content matches the prefix.
+  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {
+    try {
+      const q = asString(req.query.q);
+      if (q.trim() === '') {
+        throw new ValidationError('Query parameter "q" is required');
+      }
+
+      const match = buildPrefixQuery(q);
+      if (match === '') {
+        res.json({ results: [] });
+        return;
+      }
+
+      const results = suggestStmt.all(match, SUGGEST_LIMIT) as SuggestResult[];
+      res.json({ results });
+    } catch (err) {
+      next(err);
+    }
+  });
+
+  return router;
+}
