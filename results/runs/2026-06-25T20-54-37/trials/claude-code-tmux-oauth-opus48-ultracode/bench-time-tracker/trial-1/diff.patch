@@ -0,0 +1,147 @@
+import { mkdirSync, readFileSync, writeFileSync, existsSync } from 'node:fs';
+import { dirname } from 'node:path';
+
+/**
+ * A single tracked time entry.
+ */
+export interface Entry {
+  /** Name of the tracked task. */
+  taskName: string;
+  /** ISO 8601 timestamp marking when the task started. */
+  startTime: string;
+  /** ISO 8601 timestamp marking when the task stopped, or null if still running. */
+  endTime: string | null;
+}
+
+/**
+ * A command-line friendly time tracker that persists its entries to a JSON
+ * file. At most one task may be running at any given time; starting a new task
+ * while one is already running auto-stops the previous one.
+ */
+export class TimeTracker {
+  private readonly filePath: string;
+  private entries: Entry[];
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = this.load();
+  }
+
+  /**
+   * Starts tracking a new task and returns the created entry. If a task is
+   * already running it is auto-stopped (using the same timestamp) before the
+   * new one begins.
+   *
+   * @throws if `taskName` is empty.
+   */
+  start(taskName: string): Entry {
+    if (taskName.length === 0) {
+      throw new Error('taskName must not be empty');
+    }
+
+    const now = new Date().toISOString();
+
+    const active = this.findActive();
+    if (active) {
+      active.endTime = now;
+    }
+
+    const entry: Entry = {
+      taskName,
+      startTime: now,
+      endTime: null,
+    };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  /**
+   * Stops the currently running task and returns the stopped entry.
+   *
+   * @throws if no task is currently running.
+   */
+  stop(): Entry {
+    const active = this.findActive();
+    if (!active) {
+      throw new Error('no task is currently running');
+    }
+    active.endTime = new Date().toISOString();
+    this.save();
+    return active;
+  }
+
+  /**
+   * Returns the currently running entry, or null if nothing is active.
+   */
+  getActiveTask(): Entry | null {
+    return this.findActive() ?? null;
+  }
+
+  /**
+   * Returns all tracked entries in insertion order. When `options.since` is
+   * provided, only entries that started on or after that date, are still
+   * running, or ended on or after that date (spanning the boundary) are
+   * returned.
+   */
+  getLog(options?: { since?: Date }): Entry[] {
+    const since = options?.since;
+    if (!since) {
+      return this.entries.slice();
+    }
+
+    const sinceMs = since.getTime();
+    return this.entries.filter((entry) => {
+      if (entry.endTime === null) {
+        return true;
+      }
+      if (new Date(entry.startTime).getTime() >= sinceMs) {
+        return true;
+      }
+      return new Date(entry.endTime).getTime() >= sinceMs;
+    });
+  }
+
+  /**
+   * Returns total tracked duration in milliseconds, keyed by task name.
+   * Durations for entries sharing a task name are summed. Running tasks are
+   * measured up to the current time.
+   */
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+    const now = Date.now();
+
+    for (const entry of this.entries) {
+      const start = new Date(entry.startTime).getTime();
+      const end = entry.endTime === null ? now : new Date(entry.endTime).getTime();
+      const duration = end - start;
+      summary[entry.taskName] = (summary[entry.taskName] ?? 0) + duration;
+    }
+
+    return summary;
+  }
+
+  /** Returns the active (still running) entry, if any. */
+  private findActive(): Entry | undefined {
+    return this.entries.find((entry) => entry.endTime === null);
+  }
+
+  /** Loads entries from disk, returning an empty list when no file exists. */
+  private load(): Entry[] {
+    if (!existsSync(this.filePath)) {
+      return [];
+    }
+    const raw = readFileSync(this.filePath, 'utf8');
+    if (raw.trim().length === 0) {
+      return [];
+    }
+    const parsed: unknown = JSON.parse(raw);
+    return Array.isArray(parsed) ? (parsed as Entry[]) : [];
+  }
+
+  /** Persists entries to disk, creating parent directories as needed. */
+  private save(): void {
+    mkdirSync(dirname(this.filePath), { recursive: true });
+    writeFileSync(this.filePath, JSON.stringify(this.entries, null, 2), 'utf8');
+  }
+}
