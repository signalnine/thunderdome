@@ -0,0 +1,345 @@
+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+function apply(op: string, a: number, b: number): number {
+  switch (op) {
+    case 'AND': return a & b;
+    case 'OR':  return a | b;
+    case 'XOR': return a ^ b;
+    default: return 0;
+  }
+}
+
+export function simulate(
+  gates: Gate[],
+  inputs: Record<string, number>,
+): Record<string, number> {
+  const wires: Record<string, number> = { ...inputs };
+  const n = gates.length;
+
+  const unresolved: number[] = new Array(n);
+  for (let i = 0; i < n; i++) {
+    let count = 0;
+    if (!(gates[i].in1 in wires)) count++;
+    if (!(gates[i].in2 in wires)) count++;
+    unresolved[i] = count;
+  }
+
+  const dependents: Map<string, number[]> = new Map();
+  for (let i = 0; i < n; i++) {
+    for (const w of [gates[i].in1, gates[i].in2]) {
+      if (!dependents.has(w)) dependents.set(w, []);
+      dependents.get(w)!.push(i);
+    }
+  }
+
+  const queue: number[] = [];
+  for (let i = 0; i < n; i++) {
+    if (unresolved[i] === 0) queue.push(i);
+  }
+
+  const done = new Set<number>();
+  let head = 0;
+  while (head < queue.length) {
+    const i = queue[head++];
+    if (done.has(i)) continue;
+    done.add(i);
+
+    const g = gates[i];
+    wires[g.out] = apply(g.op, wires[g.in1], wires[g.in2]);
+
+    const deps = dependents.get(g.out);
+    if (deps) {
+      for (const j of deps) {
+        if (done.has(j)) continue;
+        unresolved[j]--;
+        if (unresolved[j] === 0) queue.push(j);
+      }
+    }
+  }
+
+  return wires;
+}
+
+function getBitWidth(gates: Gate[]): number {
+  let maxBit = -1;
+  for (const g of gates) {
+    for (const w of [g.in1, g.in2]) {
+      if (/^x(\d+)$/.test(w)) {
+        const bit = parseInt(w.slice(1), 10);
+        if (bit > maxBit) maxBit = bit;
+      }
+      if (/^y(\d+)$/.test(w)) {
+        const bit = parseInt(w.slice(1), 10);
+        if (bit > maxBit) maxBit = bit;
+      }
+    }
+  }
+  return maxBit + 1;
+}
+
+function randomInputs(bitWidth: number): Record<string, number> {
+  const r: Record<string, number> = {};
+  for (let i = 0; i < bitWidth; i++) {
+    r['x' + String(i).padStart(2, '0')] = Math.random() < 0.5 ? 0 : 1;
+    r['y' + String(i).padStart(2, '0')] = Math.random() < 0.5 ? 0 : 1;
+  }
+  return r;
+}
+
+function expectedZ(inputs: Record<string, number>, bitWidth: number): Record<string, number> {
+  let x = 0, y = 0;
+  for (let i = 0; i < bitWidth; i++) {
+    x |= inputs['x' + String(i).padStart(2, '0')] << i;
+    y |= inputs['y' + String(i).padStart(2, '0')] << i;
+  }
+  const sum = x + y;
+  const r: Record<string, number> = {};
+  for (let i = 0; i <= bitWidth; i++) {
+    r['z' + String(i).padStart(2, '0')] = (sum >> i) & 1;
+  }
+  return r;
+}
+
+function isCorrect(gates: Gate[], bitWidth: number): boolean {
+  for (let t = 0; t < 10; t++) {
+    const inputs = randomInputs(bitWidth);
+    const result = simulate(gates, inputs);
+    const expected = expectedZ(inputs, bitWidth);
+    for (let i = 0; i <= bitWidth; i++) {
+      const z = 'z' + String(i).padStart(2, '0');
+      if (result[z] !== expected[z]) return false;
+    }
+  }
+  return true;
+}
+
+// Build the correct adder circuit with standard wire names
+function buildCorrectAdder(bitWidth: number): Gate[] {
+  const gates: Gate[] = [];
+
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+
+  for (let bit = 1; bit < bitWidth; bit++) {
+    const xi = 'x' + String(bit).padStart(2, '0');
+    const yi = 'y' + String(bit).padStart(2, '0');
+    const ci_prev = 'c' + String(bit - 1).padStart(2, '0');
+    const ci = 'c' + String(bit).padStart(2, '0');
+    const ti = 't' + String(bit).padStart(2, '0');
+    const ai = 'a' + String(bit).padStart(2, '0');
+    const bi = 'b' + String(bit).padStart(2, '0');
+    const zi = 'z' + String(bit).padStart(2, '0');
+
+    gates.push({ op: 'XOR', in1: xi, in2: yi, out: ti });
+    gates.push({ op: 'XOR', in1: ti, in2: ci_prev, out: zi });
+    gates.push({ op: 'AND', in1: xi, in2: yi, out: ai });
+    gates.push({ op: 'AND', in1: ti, in2: ci_prev, out: bi });
+    gates.push({ op: 'OR', in1: ai, in2: bi, out: ci });
+  }
+
+  const lastCarry = 'c' + String(bitWidth - 1).padStart(2, '0');
+  const zN = 'z' + String(bitWidth).padStart(2, '0');
+  gates.push({ op: 'OR', in1: lastCarry, in2: lastCarry, out: zN });
+
+  return gates;
+}
+
+// Trace the adder structure from x/y inputs to identify gate roles.
+// Gate roles are determined by inputs, so the trace is correct even with swapped outputs.
+function traceAdder(gates: Gate[], bitWidth: number): {
+  bitXor: Map<number, number>;     // XOR(xi, yi) gate index
+  bitAnd: Map<number, number>;     // AND(xi, yi) gate index
+  sumXor: Map<number, number>;     // XOR(partial_i, carry_{i-1}) gate index
+  propAnd: Map<number, number>;    // AND(partial_i, carry_{i-1}) gate index
+  carryOr: Map<number, number>;    // OR(gen_i, prop_i) gate index
+  carryWire: Map<number, string>;  // carry wire name for each bit
+  complete: boolean;
+} {
+  const bitXor = new Map<number, number>();
+  const bitAnd = new Map<number, number>();
+  const sumXor = new Map<number, number>();
+  const propAnd = new Map<number, number>();
+  const carryOr = new Map<number, number>();
+  const carryWire = new Map<number, string>();
+
+  // Find first-level gates by x/y inputs
+  for (let bit = 0; bit < bitWidth; bit++) {
+    const xi = 'x' + String(bit).padStart(2, '0');
+    const yi = 'y' + String(bit).padStart(2, '0');
+    for (let gi = 0; gi < gates.length; gi++) {
+      const g = gates[gi];
+      if ((g.in1 === xi && g.in2 === yi) || (g.in1 === yi && g.in2 === xi)) {
+        if (g.op === 'XOR') bitXor.set(bit, gi);
+        if (g.op === 'AND') bitAnd.set(bit, gi);
+      }
+    }
+  }
+
+  // Carry wire for bit 0
+  if (bitAnd.has(0)) carryWire.set(0, gates[bitAnd.get(0)!].out);
+
+  // Trace through remaining bits
+  for (let bit = 1; bit < bitWidth; bit++) {
+    const partialWire = bitXor.has(bit) ? gates[bitXor.get(bit)!].out : null;
+    const genWire = bitAnd.has(bit) ? gates[bitAnd.get(bit)!].out : null;
+    const ci = carryWire.get(bit - 1);
+
+    if (!partialWire || !genWire || !ci) continue;
+
+    // Find XOR(partial, ci) and AND(partial, ci)
+    for (let gi = 0; gi < gates.length; gi++) {
+      const g = gates[gi];
+      if ((g.in1 === partialWire && g.in2 === ci) || (g.in1 === ci && g.in2 === partialWire)) {
+        if (g.op === 'XOR') sumXor.set(bit, gi);
+        if (g.op === 'AND') propAnd.set(bit, gi);
+      }
+    }
+
+    const propWire = propAnd.has(bit) ? gates[propAnd.get(bit)!].out : null;
+    if (propWire) {
+      for (let gi = 0; gi < gates.length; gi++) {
+        const g = gates[gi];
+        if (g.op === 'OR') {
+          if ((g.in1 === genWire && g.in2 === propWire) || (g.in1 === propWire && g.in2 === genWire)) {
+            carryOr.set(bit, gi);
+            carryWire.set(bit, g.out);
+          }
+        }
+      }
+    }
+  }
+
+  let complete = true;
+  for (let bit = 0; bit < bitWidth; bit++) {
+    if (!bitXor.has(bit) || !bitAnd.has(bit)) { complete = false; break; }
+  }
+  for (let bit = 1; bit < bitWidth; bit++) {
+    if (!sumXor.has(bit) || !propAnd.has(bit) || !carryOr.has(bit)) {
+      complete = false;
+      break;
+    }
+  }
+
+  return { bitXor, bitAnd, sumXor, propAnd, carryOr, carryWire, complete };
+}
+
+// For each gate, determine what wire it SHOULD output based on its structural role.
+// The correct adder uses standard wire names (z00, c00, t01, a01, b01, etc.).
+// If a gate's output doesn't match its expected wire, it's involved in a swap.
+function findExpectedOutputs(gates: Gate[], bitWidth: number): Map<number, string> {
+  const trace = traceAdder(gates, bitWidth);
+  const expected = new Map<number, string>();
+
+  // Build the correct adder to know expected wire names
+  const correct = buildCorrectAdder(bitWidth);
+  const _correctTrace = traceAdder(correct, bitWidth);
+
+  // HALF_XOR (bitXor[0]): XOR(x00, y00) -> z00
+  if (trace.bitXor.has(0)) {
+    expected.set(trace.bitXor.get(0)!, 'z00');
+  }
+
+  // HALF_AND (bitAnd[0]): AND(x00, y00) -> c00
+  if (trace.bitAnd.has(0)) {
+    expected.set(trace.bitAnd.get(0)!, 'c00');
+  }
+
+  for (let bit = 1; bit < bitWidth; bit++) {
+    const ti = 't' + String(bit).padStart(2, '0');
+    const ai = 'a' + String(bit).padStart(2, '0');
+    const bi = 'b' + String(bit).padStart(2, '0');
+    const zi = 'z' + String(bit).padStart(2, '0');
+    const ci = 'c' + String(bit).padStart(2, '0');
+
+    // PARTIAL_XOR: XOR(xi, yi) -> t_i
+    if (trace.bitXor.has(bit)) {
+      expected.set(trace.bitXor.get(bit)!, ti);
+    }
+
+    // GEN_AND: AND(xi, yi) -> a_i
+    if (trace.bitAnd.has(bit)) {
+      expected.set(trace.bitAnd.get(bit)!, ai);
+    }
+
+    // SUM_XOR: XOR(partial_i, carry_{i-1}) -> z_i
+    if (trace.sumXor.has(bit)) {
+      expected.set(trace.sumXor.get(bit)!, zi);
+    }
+
+    // PROP_AND: AND(partial_i, carry_{i-1}) -> b_i
+    if (trace.propAnd.has(bit)) {
+      expected.set(trace.propAnd.get(bit)!, bi);
+    }
+
+    // CARRY_OR: OR(gen_i, prop_i) -> c_i
+    if (trace.carryOr.has(bit)) {
+      expected.set(trace.carryOr.get(bit)!, ci);
+    }
+  }
+
+  // Final carry: OR(c_{N-1}, c_{N-1}) -> z_N
+  // This is a separate gate from CARRY_OR(N-1)
+  const lastCarryWire = trace.carryWire.get(bitWidth - 1);
+  if (lastCarryWire) {
+    const zN = 'z' + String(bitWidth).padStart(2, '0');
+    for (let gi = 0; gi < gates.length; gi++) {
+      const g = gates[gi];
+      if (g.op === 'OR' && g.in1 === lastCarryWire && g.in2 === lastCarryWire) {
+        expected.set(gi, zN);
+        break;
+      }
+    }
+  }
+
+  return expected;
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  const bitWidth = getBitWidth(gates);
+
+  if (isCorrect(gates, bitWidth)) return [];
+
+  // For each gate, determine its expected output wire based on structural role.
+  // If the gate's actual output differs from expected, it's involved in a swap.
+  const expectedOutputs = findExpectedOutputs(gates, bitWidth);
+
+  // Find gates whose output doesn't match expected
+  const wrongGates: number[] = [];
+  for (const [gi, expWire] of expectedOutputs) {
+    if (gates[gi].out !== expWire) {
+      wrongGates.push(gi);
+    }
+  }
+
+  if (wrongGates.length === 0) return [];
+
+  // Build wire -> gate map
+  const wireProducer = new Map<string, number>();
+  for (let gi = 0; gi < gates.length; gi++) {
+    wireProducer.set(gates[gi].out, gi);
+  }
+
+  // For each wrong gate, find which gate actually produces the expected wire
+  const swapped: Set<string> = new Set();
+
+  for (const gi of wrongGates) {
+    const expWire = expectedOutputs.get(gi)!;
+    const actualWire = gates[gi].out;
+
+    // Find which gate produces the expected wire
+    const expProducer = wireProducer.get(expWire);
+    if (expProducer !== undefined) {
+      // gi should output expWire, but expProducer actually does
+      // This means gi and expProducer swapped their outputs
+      swapped.add(actualWire);
+      swapped.add(expWire);
+    }
+  }
+
+  return [...swapped].sort();
+}
