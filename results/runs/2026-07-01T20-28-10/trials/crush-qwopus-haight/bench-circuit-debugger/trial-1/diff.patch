+import { describe, it, expect } from 'vitest';
+import { simulate, findSwappedWires, type Gate } from '../src/index';
+
+describe('simulate', () => {
+  it('simple AND gate', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, c: 1 });
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, c: 0 });
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, c: 0 });
+  });
+
+  it('simple OR gate', () => {
+    const gates: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, c: 1 });
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, c: 1 });
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, c: 0 });
+  });
+
+  it('simple XOR gate', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, c: 0 });
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, c: 1 });
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, c: 0 });
+  });
+
+  it('chained gates', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'c' },
+      { op: 'OR', in1: 'c', in2: 'd', out: 'e' },
+    ];
+    expect(simulate(gates, { a: 1, b: 1, d: 0 })).toEqual({ a: 1, b: 1, d: 0, c: 1, e: 1 });
+    expect(simulate(gates, { a: 0, b: 1, d: 0 })).toEqual({ a: 0, b: 1, d: 0, c: 0, e: 0 });
+  });
+});
+
+function buildAdder(bitWidth: number): Gate[] {
+  const gates: Gate[] = [];
+
+  // Bit 0: half adder
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+
+  for (let bit = 1; bit < bitWidth; bit++) {
+    const xi = 'x' + String(bit).padStart(2, '0');
+    const yi = 'y' + String(bit).padStart(2, '0');
+    const zi = 'z' + String(bit).padStart(2, '0');
+    const ci_prev = 'c' + String(bit - 1).padStart(2, '0');
+    const ci = 'c' + String(bit).padStart(2, '0');
+    const ti = 't' + String(bit).padStart(2, '0');
+    const ai = 'a' + String(bit).padStart(2, '0');
+    const bi = 'b' + String(bit).padStart(2, '0');
+
+    gates.push({ op: 'XOR', in1: xi, in2: yi, out: ti });
+    gates.push({ op: 'XOR', in1: ti, in2: ci_prev, out: zi });
+    gates.push({ op: 'AND', in1: xi, in2: yi, out: ai });
+    gates.push({ op: 'AND', in1: ti, in2: ci_prev, out: bi });
+    gates.push({ op: 'OR', in1: ai, in2: bi, out: ci });
+  }
+
+  // Final carry
+  const lastCarry = 'c' + String(bitWidth - 1).padStart(2, '0');
+  const zN = 'z' + String(bitWidth).padStart(2, '0');
+  gates.push({ op: 'OR', in1: lastCarry, in2: lastCarry, out: zN });
+
+  return gates;
+}
+
+describe('simulate with adder', () => {
+  it('4-bit adder: 3 + 5 = 8', () => {
+    const gates = buildAdder(4);
+    const inputs: Record<string, number> = {};
+    // X = 3 = 0011
+    inputs.x00 = 1; inputs.x01 = 1; inputs.x02 = 0; inputs.x03 = 0;
+    // Y = 5 = 0101
+    inputs.y00 = 1; inputs.y01 = 0; inputs.y02 = 1; inputs.y03 = 0;
+
+    const result = simulate(gates, inputs);
+    // Z = 8 = 1000
+    expect(result.z00).toBe(0);
+    expect(result.z01).toBe(0);
+    expect(result.z02).toBe(0);
+    expect(result.z03).toBe(1);
+    expect(result.z04).toBe(0);
+  });
+
+  it('4-bit adder: 15 + 1 = 16', () => {
+    const gates = buildAdder(4);
+    const inputs: Record<string, number> = {};
+    // X = 15 = 1111
+    for (let i = 0; i < 4; i++) inputs['x' + String(i).padStart(2, '0')] = 1;
+    // Y = 1 = 0001
+    inputs.y00 = 1;
+    for (let i = 1; i < 4; i++) inputs['y' + String(i).padStart(2, '0')] = 0;
+
+    const result = simulate(gates, inputs);
+    // Z = 16 = 10000
+    expect(result.z00).toBe(0);
+    expect(result.z01).toBe(0);
+    expect(result.z02).toBe(0);
+    expect(result.z03).toBe(0);
+    expect(result.z04).toBe(1);
+  });
+});
+
+describe('findSwappedWires', () => {
+  it('no swaps', () => {
+    const gates = buildAdder(4);
+    expect(findSwappedWires(gates)).toEqual([]);
+  });
+
+  it('swap two z-wire outputs', () => {
+    const gates = buildAdder(4);
+    // Swap z01 and z02 outputs
+    const g1 = gates.findIndex(g => g.out === 'z01');
+    const g2 = gates.findIndex(g => g.out === 'z02');
+    const temp = gates[g1].out;
+    gates[g1].out = gates[g2].out;
+    gates[g2].out = temp;
+
+    const result = findSwappedWires(gates);
+    expect(result.sort()).toEqual(['z01', 'z02']);
+  });
+
+  it('swap two pairs of z-wire outputs', () => {
+    const gates = buildAdder(4);
+    // Swap z01 <-> a01 and z02 <-> a02
+    const g1 = gates.findIndex(g => g.out === 'z01');
+    const g2 = gates.findIndex(g => g.out === 'a01');
+    let temp = gates[g1].out;
+    gates[g1].out = gates[g2].out;
+    gates[g2].out = temp;
+
+    const g3 = gates.findIndex(g => g.out === 'z02');
+    const g4 = gates.findIndex(g => g.out === 'a02');
+    temp = gates[g3].out;
+    gates[g3].out = gates[g4].out;
+    gates[g4].out = temp;
+
+    const result = findSwappedWires(gates);
+    expect(result.sort()).toEqual(['a01', 'a02', 'z01', 'z02']);
+  });
+
+  it('swap with internal wires', () => {
+    const gates = buildAdder(4);
+    // Swap z01 <-> t01 (z01 is final sum, t01 is partial sum)
+    const g1 = gates.findIndex(g => g.out === 'z01');
+    const g2 = gates.findIndex(g => g.out === 't01');
+    const temp = gates[g1].out;
+    gates[g1].out = gates[g2].out;
+    gates[g2].out = temp;
+
+    const result = findSwappedWires(gates);
+    expect(result.sort()).toEqual(['t01', 'z01']);
+  });
+});
