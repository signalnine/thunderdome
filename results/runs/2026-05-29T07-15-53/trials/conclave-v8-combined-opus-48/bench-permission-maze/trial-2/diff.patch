+import express, {
+  type Express,
+  type Request,
+  type Response,
+  type NextFunction,
+} from 'express';
+import { randomUUID } from 'node:crypto';
+
+// ---------------------------------------------------------------------------
+// Types
+// ---------------------------------------------------------------------------
+
+type Role = 'viewer' | 'editor' | 'owner';
+type ResourceType = 'folders' | 'documents';
+
+interface User {
+  id: string;
+  username: string;
+  password: string;
+}
+
+interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+}
+
+interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+}
+
+interface Share {
+  resourceType: ResourceType;
+  resourceId: string;
+  userId: string;
+  role: Role;
+}
+
+interface ActivityEntry {
+  id: string;
+  action: string;
+  userId: string;
+  resourceType: ResourceType | 'user';
+  resourceId: string;
+  timestamp: string;
+}
+
+interface AuthedRequest extends Request {
+  userId?: string;
+}
+
+// ---------------------------------------------------------------------------
+// Permission helpers
+// ---------------------------------------------------------------------------
+
+const ROLE_RANK: Record<Role, number> = { viewer: 1, editor: 2, owner: 3 };
+
+function isRole(value: unknown): value is Role {
+  return value === 'viewer' || value === 'editor' || value === 'owner';
+}
+
+function maxRole(a: Role | null, b: Role | null): Role | null {
+  if (a === null) return b;
+  if (b === null) return a;
+  return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;
+}
+
+// ---------------------------------------------------------------------------
+// App factory
+// ---------------------------------------------------------------------------
+
+export function createApp(): Express {
+  const app = express();
+  app.use(express.json());
+
+  // In-memory stores
+  const users = new Map<string, User>();
+  const usersByName = new Map<string, User>();
+  const tokens = new Map<string, string>(); // token -> userId
+  const folders = new Map<string, Folder>();
+  const documents = new Map<string, Document>();
+  const shares: Share[] = [];
+  const activity: ActivityEntry[] = [];
+
+  function log(
+    action: string,
+    userId: string,
+    resourceType: ActivityEntry['resourceType'],
+    resourceId: string,
+  ): void {
+    activity.push({
+      id: randomUUID(),
+      action,
+      userId,
+      resourceType,
+      resourceId,
+      timestamp: new Date().toISOString(),
+    });
+  }
+
+  // -- Permission resolution -------------------------------------------------
+
+  // Role granted directly on a resource (ownership + direct shares).
+  function directRole(userId: string, type: ResourceType, id: string): Role | null {
+    const resource = type === 'folders' ? folders.get(id) : documents.get(id);
+    if (!resource) return null;
+    let best: Role | null = resource.ownerId === userId ? 'owner' : null;
+    for (const share of shares) {
+      if (
+        share.resourceType === type &&
+        share.resourceId === id &&
+        share.userId === userId
+      ) {
+        best = maxRole(best, share.role);
+      }
+    }
+    return best;
+  }
+
+  // Effective role including inheritance from ancestor folders.
+  function effectiveRole(
+    userId: string,
+    type: ResourceType,
+    id: string,
+    visited: Set<string> = new Set(),
+  ): Role | null {
+    const key = `${type}:${id}`;
+    if (visited.has(key)) return null;
+    visited.add(key);
+
+    const resource = type === 'folders' ? folders.get(id) : documents.get(id);
+    if (!resource) return null;
+
+    let best = directRole(userId, type, id);
+
+    const parentFolderId =
+      type === 'documents'
+        ? (resource as Document).folderId
+        : (resource as Folder).parentId;
+    if (parentFolderId) {
+      best = maxRole(best, effectiveRole(userId, 'folders', parentFolderId, visited));
+    }
+    return best;
+  }
+
+  function hasAtLeast(
+    userId: string,
+    type: ResourceType,
+    id: string,
+    required: Role,
+  ): boolean {
+    const role = effectiveRole(userId, type, id);
+    return role !== null && ROLE_RANK[role] >= ROLE_RANK[required];
+  }
+
+  // -- Auth middleware -------------------------------------------------------
+
+  function auth(req: AuthedRequest, res: Response, next: NextFunction): void {
+    const header = req.headers.authorization;
+    if (!header || !header.startsWith('Bearer ')) {
+      res.status(401).json({ error: 'missing or malformed token' });
+      return;
+    }
+    const token = header.slice('Bearer '.length).trim();
+    const userId = tokens.get(token);
+    if (!userId || !users.has(userId)) {
+      res.status(401).json({ error: 'invalid token' });
+      return;
+    }
+    req.userId = userId;
+    next();
+  }
+
+  // -------------------------------------------------------------------------
+  // Auth routes
+  // -------------------------------------------------------------------------
+
+  app.post('/auth/register', (req: Request, res: Response) => {
