ot edit', async () => {\n    const owner = await register('owner');\n    const other = await register('other');\n    const f = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'p' });\n    const res = await request(app)\n      .post('/folders')\n      .set('Authorization', bearer(other))\n      .send({ name: 'child', parentId: f.body.id });\n    expect(res.status).toBe(403);\n  });\n\n  it('gets a folder as owner; 404 for missing; 403 for no access', async () => {\n    const owner = await register('owner');\n    const other = await register('other');\n    const f = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'p' });\n    expect((await request(app).get(`/folders/${f.body.id}`).set('Authorization', bearer(owner))).status).toBe(200);\n    expect((await request(app).get('/folders/missing').set('Authorization', bearer(owner))).status).toBe(404);\n    expect((await request(app).get(`/folders/${f.body.id}`).set('Authorization', bearer(other))).status).toBe(403);\n  });\n\n  it('updates as editor but not as viewer', async () => {\n    const owner = await register('owner');\n    const ed = await register('ed');\n    const vw = await register('vw');\n    const f = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'p' });\n    await request(app).post(`/folders/${f.body.id}/share`).set('Authorization', bearer(owner)).send({ username: 'ed', role: 'editor' });\n    await request(app).post(`/folders/${f.body.id}/share`).set('Authorization', bearer(owner)).send({ username: 'vw', role: 'viewer' });\n    expect((await request(app).put(`/folders/${f.body.id}`).set('Authorization', bearer(ed)).send({ name: 'renamed' })).status).toBe(200);\n    expect((await request(app).put(`/folders/${f.body.id}`).set('Authorization', bearer(vw)).send({ name: 'no' })).status).toBe(403);\n  });\n\n  it('deletes as owner, forbids editor, cascades contents', async () => {\n    const owner = await register('owner');\n    const ed = await register('ed');\n    const f = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'p' });\n    const child = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'c', parentId: f.body.id });\n    const doc = await request(app).post('/documents').set('Authorization', bearer(owner)).send({ title: 'd', content: 'x', folderId: f.body.id });\n    await request(app).post(`/folders/${f.body.id}/share`).set('Authorization', bearer(owner)).send({ username: 'ed', role: 'editor' });\n    expect((await request(app).delete(`/folders/${f.body.id}`).set('Authorization', bearer(ed))).status).toBe(403);\n    expect((await request(app).delete(`/folders/${f.body.id}`).set('Authorization', bearer(owner))).status).toBe(204);\n    expect((await request(app).get(`/folders/${child.body.id}`).set('Authorization', bearer(owner))).status).toBe(404);\n    expect((await request(app).get(`/documents/${doc.body.id}`).set('Authorization', bearer(owner))).status).toBe(404);\n  });\n\n  it('rejects folder cycle on update', async () => {\n    const t = await register('a');\n    const f1 = await request(app).post('/folders').set('Authorization', bearer(t)).send({ name: 'f1' });\n    const f2 = await request(app).post('/folders').set('Authorization', bearer(t)).send({ name: 'f2', parentId: f1.body.id });\n    const res = await request(app).put(`/folders/${f1.body.id}`).set('Authorization', bearer(t)).send({ parentId: f2.body.id });\n    expect(res.status).toBe(400);\n  });\n});\n\ndescribe('documents', () => {\n  it('creates a document with creator as owner', async () => {\n    const t = await register('a');\n    const f = await request(app).post('/folders').set('Authorization', bearer(t)).send({ name: 'p' });\n    const res = await request(app).post('/documents').set('Authorization', bearer(t)).send({ title: 'doc', content: 'hello', folderId: f.body.id });\n    expect(res.status).toBe(201);\n    expect(res.body.title).toBe('doc');\n    expect(res.body.ownerId).toBeDefined();\n  });\n\n  it('rejects missing title or folderId', async () => {\n    const t = await register('a');\n    const f = await request(app).post('/folders').set('Authorization', bearer(t)).send({ name: 'p' });\n    expect((await request(app).post('/documents').set('Authorization', bearer(t)).send({ content: 'x', folderId: f.body.id })).status).toBe(400);\n    expect((await request(app).post('/documents').set('Authorization', bearer(t)).send({ title: 'd', content: 'x' })).status).toBe(400);\n  });\n\n  it('rejects nonexistent folder', async () => {\n    const t = await register('a');\n    const res = await request(app).post('/documents').set('Authorization', bearer(t)).send({ title: 'd', folderId: 'nope' });\n    expect(res.status).toBe(404);\n  });\n\n  it('forbids create in folder without edit access', async () => {\n    const owner = await register('owner');\n    const other = await register('other');\n    const f = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'p' });\n    const res = await request(app).post('/documents').set('Authorization', bearer(other)).send({ title: 'd', folderId: f.body.id });\n    expect(res.status).toBe(403);\n  });\n\n  it('viewer can read but not modify; owner can delete', async () => {\n    const owner = await register('owner');\n    const vw = await register('vw');\n    const f = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'p' });\n    const doc = await request(app).post('/documents').set('Authorization', bearer(owner)).send({ title: 'd', content: 'x', folderId: f.body.id });\n    await request(app).post(`/documents/${doc.body.id}/share`).set('Authorization', bearer(owner)).send({ username: 'vw', role: 'viewer' });\n    expect((await request(app).get(`/documents/${doc.body.id}`).set('Authorization', bearer(vw))).status).toBe(200);\n    expect((await request(app).put(`/documents/${doc.body.id}`).set('Authorization', bearer(vw)).send({ content: 'no' })).status).toBe(403);\n    expect((await request(app).delete(`/documents/${doc.body.id}`).set('Authorization', bearer(vw))).status).toBe(403);\n    expect((await request(app).delete(`/documents/${doc.body.id}`).set('Authorization', bearer(owner))).status).toBe(204);\n  });\n\n  it('editor can modify', async () => {\n    const owner = await register('owner');\n    const ed = await register('ed');\n    const f = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'p' });\n    const doc = await request(app).post('/documents').set('Authorization', bearer(owner)).send({ title: 'd', content: 'x', folderId: f.body.id });\n    await request(app).post(`/documents/${doc.body.id}/share`).set('Authorization', bearer(owner)).send({ username: 'ed', role: 'editor' });\n    const res = await request(app).put(`/documents/${doc.body.id}`).set('Authorization', bearer(ed)).send({ content: 'updated' });\n    expect(res.status).toBe(200);\n    expect(res.body.content).toBe('updated');\n  });\n});\n\ndescribe('sharing & permissions', () => {\n  it('owner shares; editor shares non-owner; viewer cannot share', async () => {\n    const owner = await register('owner');\n    const ed = await register('ed');\n    const vw = await register('vw');\n    await register('target');\n    const f = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'p' });\n    await request(app).post(`/folders/${f.body.id}/share`).set('Authorization', bearer(owner)).send({ username: 'ed', role: 'editor' });\n    await request(app).post(`/folders/${f.body.id}/share`).set('Authorization', bearer(owner)).send({ username: 'vw', role: 'viewer' });\n    // editor can share as viewer/editor\n    expect((await request(app).post(`/folders/${f.body.id}/share`).set('Authorization', bearer(ed)).send({ username: 'target', role: 'viewer' })).status).toBe(201);\n    // editor cannot grant owner\