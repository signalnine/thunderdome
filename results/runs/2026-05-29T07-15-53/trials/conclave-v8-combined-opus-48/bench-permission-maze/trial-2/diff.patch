+      res.status(400).json({ error: 'username and password are required' });
+      return;
+    }
+    if (usersByName.has(username)) {
+      res.status(409).json({ error: 'username already taken' });
+      return;
+    }
+    const user: User = { id: randomUUID(), username, password };
+    users.set(user.id, user);
+    usersByName.set(username, user);
+    res.status(201).json({ id: user.id, username: user.username });
+  });
+
+  app.post('/auth/login', (req: Request, res: Response) => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || typeof password !== 'string') {
+      res.status(400).json({ error: 'username and password are required' });
+      return;
+    }
+    const user = usersByName.get(username);
+    if (!user || user.password !== password) {
+      res.status(401).json({ error: 'invalid credentials' });
+      return;
+    }
+    const token = randomUUID();
+    tokens.set(token, user.id);
+    res.status(200).json({ token });
+  });
+
+  // Everything below requires authentication.
+  app.use(auth);
+
+  // -------------------------------------------------------------------------
+  // Folder routes
+  // -------------------------------------------------------------------------
+
+  app.post('/folders', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const { name, parentId } = req.body ?? {};
+    if (typeof name !== 'string' || !name) {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+    let parent: string | null = null;
+    if (parentId !== undefined && parentId !== null) {
+      if (typeof parentId !== 'string' || !folders.has(parentId)) {
+        res.status(404).json({ error: 'parent folder not found' });
+        return;
+      }
+      if (!hasAtLeast(userId, 'folders', parentId, 'editor')) {
+        res.status(403).json({ error: 'no permission to create in parent folder' });
+        return;
+      }
+      parent = parentId;
+    }
+    const folder: Folder = { id: randomUUID(), name, parentId: parent, ownerId: userId };
+    folders.set(folder.id, folder);
+    log('folder.create', userId, 'folders', folder.id);
+    res.status(201).json(folder);
+  });
+
+  app.get('/folders/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const folder = folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!hasAtLeast(userId, 'folders', folder.id, 'viewer')) {
+      res.status(403).json({ error: 'no access' });
+      return;
+    }
+    res.status(200).json(folder);
+  });
+
+  app.put('/folders/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const folder = folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!hasAtLeast(userId, 'folders', folder.id, 'editor')) {
+      res.status(403).json({ error: 'no permission to edit' });
+      return;
+    }
+    const { name, parentId } = req.body ?? {};
+    if (name !== undefined) {
+      if (typeof name !== 'string' || !name) {
+        res.status(400).json({ error: 'invalid name' });
+        return;
+      }
+      folder.name = name;
+    }
+    if (parentId !== undefined) {
+      if (parentId === null) {
+        folder.parentId = null;
+      } else {
+        if (typeof parentId !== 'string' || !folders.has(parentId)) {
+          res.status(404).json({ error: 'parent folder not found' });
+          return;
+        }
+        if (parentId === folder.id || createsCycle(folder.id, parentId)) {
+          res.status(400).json({ error: 'cannot create folder cycle' });
+          return;
+        }
+        folder.parentId = parentId;
+      }
+    }
+    log('folder.update', userId, 'folders', folder.id);
+    res.status(200).json(folder);
+  });
+
+  app.delete('/folders/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const folder = folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!hasAtLeast(userId, 'folders', folder.id, 'owner')) {
+      res.status(403).json({ error: 'no permission to delete' });
+      return;
+    }
+    deleteFolderRecursive(folder.id);
+    log('folder.delete', userId, 'folders', folder.id);
+    res.status(204).end();
+  });
+
+  // Detect whether setting folder's parent to candidateParent would form a cycle.
+  function createsCycle(folderId: string, candidateParent: string): boolean {
+    let current: string | null = candidateParent;
+    const seen = new Set<string>();
+    while (current) {
+      if (current === folderId) return true;
+      if (seen.has(current)) break;
+      seen.add(current);
+      current = folders.get(current)?.parentId ?? null;
+    }
+    return false;
+  }
+
+  function deleteFolderRecursive(folderId: string): void {
+    for (const doc of [...documents.values()]) {
+      if (doc.folderId === folderId) {
+        documents.delete(doc.id);
+        removeSharesFor('documents', doc.id);
+      }
+    }
+    for (const child of [...folders.values()]) {
+      if (child.parentId === folderId) {
+        deleteFolderRecursive(child.id);
+      }
+    }
+    folders.delete(folderId);
+    removeSharesFor('folders', folderId);
+  }
+
+  function removeSharesFor(type: ResourceType, id: string): void {
+    for (let i = shares.length - 1; i >= 0; i--) {
+      if (shares[i].resourceType === type && shares[i].resourceId === id) {
+        shares.splice(i, 1);
+      }
+    }
+  }
+
+  // -------------------------------------------------------------------------
+  // Document routes
+  // -------------------------------------------------------------------------
+
+  app.post('/documents', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const { title, content, folderId } = req.body ?? {};
