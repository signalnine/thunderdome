ent via inheritance\n    expect((await request(app).get(`/documents/${doc.body.id}`).set('Authorization', bearer(u))).status).toBe(200);\n    expect((await request(app).put(`/documents/${doc.body.id}`).set('Authorization', bearer(u)).send({ content: 'edited' })).status).toBe(200);\n    // and the subfolder\n    expect((await request(app).get(`/folders/${sub.body.id}`).set('Authorization', bearer(u))).status).toBe(200);\n  });\n\n  it('most-permissive role wins across direct + inherited', async () => {\n    const owner = await register('owner');\n    const u = await register('u');\n    const root = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'root' });\n    const doc = await request(app).post('/documents').set('Authorization', bearer(owner)).send({ title: 'd', folderId: root.body.id });\n    // inherited viewer via folder, direct editor on doc → effective editor\n    await request(app).post(`/folders/${root.body.id}/share`).set('Authorization', bearer(owner)).send({ username: 'u', role: 'viewer' });\n    await request(app).post(`/documents/${doc.body.id}/share`).set('Authorization', bearer(owner)).send({ username: 'u', role: 'editor' });\n    expect((await request(app).put(`/documents/${doc.body.id}`).set('Authorization', bearer(u)).send({ content: 'x' })).status).toBe(200);\n    // owner inherited from folder ownership: owner can delete doc they created anyway; test inherited owner via folder owner deleting\n    expect((await request(app).delete(`/documents/${doc.body.id}`).set('Authorization', bearer(owner))).status).toBe(204);\n  });\n\n  it('owner role grant enables full control for grantee', async () => {\n    const owner = await register('owner');\n    const u = await register('u');\n    const f = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'p' });\n    const doc = await request(app).post('/documents').set('Authorization', bearer(owner)).send({ title: 'd', folderId: f.body.id });\