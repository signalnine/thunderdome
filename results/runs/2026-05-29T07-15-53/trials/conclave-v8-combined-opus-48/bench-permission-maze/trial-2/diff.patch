+    documents.set(doc.id, doc);
+    log('document.create', userId, 'documents', doc.id);
+    res.status(201).json(doc);
+  });
+
+  app.get('/documents/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
