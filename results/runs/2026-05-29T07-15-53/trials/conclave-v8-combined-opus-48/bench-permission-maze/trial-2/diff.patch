00);\n    const actions = res.body.map((e: { action: string }) => e.action);\n    expect(actions).toContain('document.create');\n    expect(actions).toContain('document.update');\n    expect(actions).toContain('share');\n    expect(actions).toContain('document.delete');\n    for (const e of res.body) {\n      expect(e.action).toBeDefined();\n      expect(e.userId).toBeDefined();\n      expect(e.resourceType).toBeDefined();\n      expect(e.resourceId).toBeDefined();\n      expect(e.timestamp).toBeDefined();\n    }\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
