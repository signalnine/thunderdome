+      }
+      if (!hasAtLeast(userId, 'folders', folderId, 'editor')) {
+        res.status(403).json({ error: 'no permission to move into folder' });
+        return;
+      }
+      doc.folderId = folderId;
+    }
+    log('document.update', userId, 'documents', doc.id);
+    res.status(200).json(doc);
+  });
+
+  app.delete('/documents/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const doc = documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    if (!hasAtLeast(userId, 'documents', doc.id, 'owner')) {
+      res.status(403).json({ error: 'no permission to delete' });
+      return;
+    }
+    documents.delete(doc.id);
+    removeSharesFor('documents', doc.id);
+    log('document.delete', userId, 'documents', doc.id);
+    res.status(204).end();
+  });
+
+  // -------------------------------------------------------------------------
+  // Sharing
+  // -------------------------------------------------------------------------
+
+  app.post('/:resourceType/:id/share', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const resourceType = req.params.resourceType;
+    if (resourceType !== 'folders' && resourceType !== 'documents') {
+      res.status(404).json({ error: 'unknown resource type' });
+      return;
+    }
+    const type = resourceType as ResourceType;
+    const id = req.params.id;
+    const exists = type === 'folders' ? folders.has(id) : documents.has(id);
+    if (!exists) {
+      res.status(404).json({ error: 'resource not found' });
+      return;
+    }
+
+    const { username, userId: targetUserId, role } = req.body ?? {};
+    if (!isRole(role)) {
+      res.status(400).json({ error: 'role must be viewer, editor, or owner' });
+      return;
+    }
+
+    // Sharing requires at least editor; granting 'owner' requires owner.
+    if (!hasAtLeast(userId, type, id, 'editor')) {
+      res.status(403).json({ error: 'no permission to share' });
+      return;
+    }
+    if (role === 'owner' && !hasAtLeast(userId, type, id, 'owner')) {
+      res.status(403).json({ error: 'only an owner can grant the owner role' });
+      return;
+    }
+
+    let target: User | undefined;
+    if (typeof username === 'string') {
+      target = usersByName.get(username);
+    } else if (typeof targetUserId === 'string') {
+      target = users.get(targetUserId);
+    }
+    if (!target) {
+      res.status(404).json({ error: 'target user not found' });
+      return;
+    }
+
+    // Replace any existing direct share for this (resource,user) pair.
+    const existing = shares.find(
+      (s) => s.resourceType === type && s.resourceId === id && s.userId === target!.id,
+    );
+    if (existing) {
+      existing.role = role;
+    } else {
+      shares.push({ resourceType: type, resourceId: id, userId: target.id, role });
+    }
+    log('share', userId, type, id);
+    res.status(201).json({ resourceType: type, resourceId: id, userId: target.id, role });
+  });
+
+  // -------------------------------------------------------------------------
+  // Activity log
+  // -------------------------------------------------------------------------
+
+  app.get('/activity', (req: AuthedRequest, res: Response) => {
+    res.status(200).json(activity);
+  });
+
+  // 404 fallback
+  app.use((_req: Request, res: Response) => {
+    res.status(404).json({ error: 'not found' });
+  });
+
+  return app;
+}
+
+export default createApp;
