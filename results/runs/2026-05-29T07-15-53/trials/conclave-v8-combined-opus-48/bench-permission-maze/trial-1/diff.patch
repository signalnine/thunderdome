+import express, { NextFunction, Request, Response } from 'express';
+import { Store } from './store.js';
+import { isRole, ResourceType, Role, ROLE_RANK, User } from './types.js';
+
+interface AuthedRequest extends Request {
+  user: User;
+}
+
+function authed(req: Request): User {
+  return (req as AuthedRequest).user;
+}
+
+function hasAtLeast(role: Role | undefined, required: Role): boolean {
+  return role !== undefined && ROLE_RANK[role] >= ROLE_RANK[required];
+}
+
+export function createApp(): express.Express {
+  const store = new Store();
+  const app = express();
+  app.use(express.json());
+
+  // ---- Auth middleware ----------------------------------------------------
+  const requireAuth = (req: Request, res: Response, next: NextFunction): void => {
+    const header = req.header('authorization') ?? '';
+    const match = /^Bearer\s+(.+)$/i.exec(header.trim());
+    if (!match) {
+      res.status(401).json({ error: 'Missing or malformed Authorization header' });
+      return;
+    }
+    const user = store.getUserByToken(match[1].trim());
+    if (!user) {
+      res.status(401).json({ error: 'Invalid token' });
+      return;
+    }
+    (req as AuthedRequest).user = user;
+    next();
+  };
+
+  const publicUser = (u: User): { id: string; username: string } => ({ id: u.id, username: u.username });
+
+  // ---- Auth routes --------------------------------------------------------
+  app.post('/auth/register', (req: Request, res: Response): void => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || !username || typeof password !== 'string' || !password) {
+      res.status(400).json({ error: 'username and password are required' });
+      return;
+    }
+    if (store.getUserByName(username)) {
+      res.status(409).json({ error: 'username already taken' });
+      return;
+    }
+    const user = store.createUser(username, password);
+    res.status(201).json(publicUser(user));
+  });
+
+  app.post('/auth/login', (req: Request, res: Response): void => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || typeof password !== 'string') {
+      res.status(400).json({ error: 'username and password are required' });
+      return;
+    }
+    const user = store.getUserByName(username);
+    if (!user || user.password !== password) {
+      res.status(401).json({ error: 'invalid credentials' });
+      return;
+    }
+    res.status(200).json({ token: user.token, user: publicUser(user) });
+  });
+
+  // ---- Folder routes ------------------------------------------------------
+  app.post('/folders', requireAuth, (req: Request, res: Response): void => {
+    const me = authed(req);
+    const { name, parentId } = req.body ?? {};
+    if (typeof name !== 'string' || !name) {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+    let parent: string | null = null;
+    if (parentId !== undefined && parentId !== null) {
+      if (typeof parentId !== 'string') {
+        res.status(400).json({ error: 'parentId must be a string' });
+        return;
+      }
+      const parentFolder = store.getFolder(parentId);
+      if (!parentFolder) {
+        res.status(404).json({ error: 'parent folder not found' });
+        return;
+      }
+      if (!hasAtLeast(store.effectiveFolderRole(parentFolder, me.id), 'editor')) {
+        res.status(403).json({ error: 'insufficient permission on parent folder' });
+        return;
+      }
+      parent = parentId;
+    }
+    const folder = store.createFolder(name, parent, me.id);
+    res.status(201).json(folder);
+  });
+
+  app.get('/folders/:id', requireAuth, (req: Request, res: Response): void => {
+    const me = authed(req);
+    const folder = store.getFolder(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    const role = store.effectiveFolderRole(folder, me.id);
+    if (!hasAtLeast(role, 'viewer')) {
+      res.status(403).json({ error: 'access denied' });
+      return;
+    }
+    res.status(200).json({ ...folder, role });
+  });
+
+  const updateFolderHandler = (req: Request, res: Response): void => {
+    const me = authed(req);
+    const folder = store.getFolder(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!hasAtLeast(store.effectiveFolderRole(folder, me.id), 'editor')) {
+      res.status(403).json({ error: 'access denied' });
+      return;
+    }
+    const { name, parentId } = req.body ?? {};
+    if (name !== undefined && (typeof name !== 'string' || !name)) {
+      res.status(400).json({ error: 'name must be a non-empty string' });
+      return;
+    }
+    let newParent: string | null | undefined;
+    if (parentId !== undefined) {
+      if (parentId === null) {
+        newParent = null;
+      } else if (typeof parentId !== 'string') {
+        res.status(400).json({ error: 'parentId must be a string or null' });
+        return;
+      } else {
+        if (parentId === folder.id) {
+          res.status(400).json({ error: 'folder cannot be its own parent' });
+          return;
+        }
+        const parentFolder = store.getFolder(parentId);
+        if (!parentFolder) {
+          res.status(404).json({ error: 'parent folder not found' });
+          return;
+        }
+        // Prevent cycles: new parent must not be a descendant of this folder.
+        if (isDescendant(parentFolder.id, folder.id)) {
+          res.status(400).json({ error: 'cannot move folder into its own descendant' });
+          return;
+        }
+        if (!hasAtLeast(store.effectiveFolderRole(parentFolder, me.id), 'editor')) {
+          res.status(403).json({ error: 'insufficient permission on target parent' });
+          return;
+        }
+        newParent = parentId;
+      }
+    }
+    const updated = store.updateFolder(folder, { name, parentId: newParent }, me.id);
+    res.status(200).json(updated);
+  };
+
+  const isDescendant = (candidateId: string, ancestorId: string): boolean => {
+    let current = store.getFolder(candidateId);
+    const seen = new Set<string>();
+    while (current && !seen.has(current.id)) {
+      if (current.id === ancestorId) return true;
+      seen.add(current.id);
+      current = current.parentId ? store.getFolder(current.parentId) : undefined;
+    }
+    return false;
+  };
+
+  app.put('/folders/:id', requireAuth, updateFolderHandler);
+  app.patch('/folders/:id', requireAuth, updateFolderHandler);
+
+  app.delete('/folders/:id', requireAuth, (req: Request, res: Response): void => {
+    const me = authed(req);
+    const folder = store.getFolder(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!hasAtLeast(store.effectiveFolderRole(folder, me.id), 'owner')) {
+      res.status(403).json({ error: 'only an owner can delete' });
+      return;
+    }
+    store.deleteFolder(folder, me.id);
+    res.status(204).end();
+  });
+
+  // ---- Document routes ----------------------------------------------------
+  const createDocumentHandler = (req: Request, res: Response): void => {
+    const me = authed(req);
+    const body = req.body ?? {};
+    const title = body.title;
+    const content = body.content ?? '';
+    const folderId: unknown = req.params.folderId ?? body.folderId;
+    if (typeof title !== 'string' || !title) {
+      res.status(400).json({ error: 'title is required' });
+      return;
+    }
+    if (typeof content !== 'string') {
+      res.status(400).json({ error: 'content must be a string' });
+      return;
+    }
+    if (typeof folderId !== 'string' || !folderId) {
+      res.status(400).json({ error: 'folderId is required' });
+      return;
+    }
+    const folder = store.getFolder(folderId);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!hasAtLeast(store.effectiveFolderRole(folder, me.id), 'editor')) {
+      res.status(403).json({ error: 'insufficient permission on folder' });
+      return;
+    }
+    const doc = store.createDocument(title, content, folderId, me.id);
+    res.status(201).json(doc);
+  };
+
+  app.post('/documents', requireAuth, createDocumentHandler);
+  app.post('/folders/:folderId/documents', requireAuth, createDocumentHandler);
+
+  app.get('/documents/:id', requireAuth, (req: Request, res: Response): void => {
+    const me = authed(req);
+    const doc = store.getDocument(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    const role = store.effectiveDocumentRole(doc, me.id);
+    if (!hasAtLeast(role, 'viewer')) {
+      res.status(403).json({ error: 'access denied' });
+      return;
+    }
+    res.status(200).json({ ...doc, role });
+  });
+
+  const updateDocumentHandler = (req: Request, res: Response): void => {
+    const me = authed(req);
+    const doc = store.getDocument(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    if (!hasAtLeast(store.effectiveDocumentRole(doc, me.id), 'editor')) {
+      res.status(403).json({ error: 'access denied' });
+      return;
+    }
+    const { title, content } = req.body ?? {};
+    if (title !== undefined && (typeof title !== 'string' || !title)) {
+      res.status(400).json({ error: 'title must be a non-empty string' });
+      return;
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      res.status(400).json({ error: 'content must be a string' });
+      return;
+    }
+    const updated = store.updateDocument(doc, { title, content }, me.id);
+    res.status(200).json(updated);
+  };
+
+  app.put('/documents/:id', requireAuth, updateDocumentHandler);
+  app.patch('/documents/:id', requireAuth, updateDocumentHandler);
+
+  app.delete('/documents/:id', requireAuth, (req: Request, res: Response): void => {
+    const me = authed(req);
+    const doc = store.getDocument(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    if (!hasAtLeast(store.effectiveDocumentRole(doc, me.id), 'owner')) {
+      res.status(403).json({ error: 'only an owner can delete' });
+      return;
+    }
+    store.deleteDocument(doc, me.id);
+    res.status(204).end();
+  });
+
+  // ---- Sharing ------------------------------------------------------------
+  const shareHandler = (type: ResourceType, resourceId: string, req: Request, res: Response): void => {
+    const me = authed(req);
+    const body = req.body ?? {};
+    const role: unknown = body.role;
+    if (!isRole(role)) {
+      res.status(400).json({ error: 'role must be one of viewer, editor, owner' });
+      return;
+    }
+
+    if (typeof body.userId !== 'string' && typeof body.username !== 'string') {
+      res.status(400).json({ error: 'userId or username is required' });
+      return;
+    }
+
+    // Resource must exist.
+    const exists = type === 'folder' ? store.getFolder(resourceId) : store.getDocument(resourceId);
+    if (!exists) {
+      res.status(404).json({ error: `${type} not found` });
+      return;
+    }
+
+    // Authorize the caller before revealing anything about the target user.
+    const myRole = store.effectiveRole(type, resourceId, me.id);
+    if (!hasAtLeast(myRole, 'editor')) {
+      res.status(403).json({ error: 'you must be an editor or owner to share' });
+      return;
+    }
+    // Only owners may grant the owner role (role management is owner-only).
+    if (role === 'owner' && !hasAtLeast(myRole, 'owner')) {
+      res.status(403).json({ error: 'only an owner can grant the owner role' });
+      return;
+    }
+
+    // Resolve the target user by id or username.
+    const target =
+      typeof body.userId === 'string' ? store.getUserById(body.userId) : store.getUserByName(body.username);
+    if (!target) {
+      res.status(404).json({ error: 'target user not found' });
+      return;
+    }
+
+    store.setShare(type, resourceId, target.id, role, me.id);
+    res.status(201).json({ resourceType: type, resourceId, userId: target.id, role });
+  };
+
+  app.post('/share', requireAuth, (req: Request, res: Response): void => {
+    const body = req.body ?? {};
+    const type: unknown = body.resourceType;
+    const resourceId: unknown = body.resourceId;
+    if (type !== 'folder' && type !== 'document') {
+      res.status(400).json({ error: 'resourceType must be folder or document' });
+      return;
+    }
+    if (typeof resourceId !== 'string' || !resourceId) {
+      res.status(400).json({ error: 'resourceId is required' });
+      return;
+    }
+    shareHandler(type, resourceId, req, res);
+  });
+
+  app.post('/folders/:id/share', requireAuth, (req: Request, res: Response): void => {
+    shareHandler('folder', req.params.id, req, res);
+  });
+  app.post('/documents/:id/share', requireAuth, (req: Request, res: Response): void => {
+    shareHandler('document', req.params.id, req, res);
+  });
+
+  // ---- Activity log -------------------------------------------------------
+  app.get('/activity', requireAuth, (_req: Request, res: Response): void => {
+    res.status(200).json(store.getActivity());
+  });
+
+  // ---- Fallbacks ----------------------------------------------------------
+  app.use((_req: Request, res: Response): void => {
+    res.status(404).json({ error: 'not found' });
+  });
+
+  // JSON parse / unexpected errors.
+  app.use((err: unknown, _req: Request, res: Response, _next: NextFunction): void => {
+    if (err instanceof SyntaxError) {
+      res.status(400).json({ error: 'invalid JSON body' });
+      return;
+    }
+    res.status(500).json({ error: 'internal server error' });
+  });
+
+  return app;
+}
+
+export default createApp;
