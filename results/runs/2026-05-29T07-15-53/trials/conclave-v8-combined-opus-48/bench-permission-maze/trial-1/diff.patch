'/auth/register').send({ username: 'bob', password: 'pw' });\n    const res = await request(app).post('/auth/register').send({ username: 'bob', password: 'other' });\n    expect(res.status).toBe(409);\n  });\n\n  it('logs in and returns a token', async () => {\n    await request(app).post('/auth/register').send({ username: 'carol', password: 'pw' });\n    const res = await request(app).post('/auth/login').send({ username: 'carol', password: 'pw' });\n    expect(res.status).toBe(200);\n    expect(typeof res.body.token).toBe('string');\n  });\n\n  it('rejects bad credentials', async () => {\n    await request(app).post('/auth/register').send({ username: 'dave', password: 'pw' });\n    expect((await request(app).post('/auth/login').send({ username: 'dave', password: 'wrong' })).status).toBe(401);\n    expect((await request(app).post('/auth/login').send({ username: 'nobody', password: 'pw' })).status).toBe(401);\n  });\n\n  it('rejects protected routes without / with bad token', async () => {\n    expect((await request(app).post('/folders').send({ name: 'x' })).status).toBe(401);\n    expect((await request(app).post('/folders').set('Authorization', 'Bearer nope').send({ name: 'x' })).status).toBe(401);\n    expect((await request(app).post('/folders').set('Authorization', 'Garbage').send({ name: 'x' })).status).toBe(401);\n  });\n});\n\ndescribe('folders', () => {\n  it('creates a root folder with creator as owner', async () => {\n    const t = await register('u1');\n    const res = await request(app).post('/folders').set('Authorization', bearer(t)).send({ name: 'Root' });\n    expect(res.status).toBe(201);\n    expect(res.body).toMatchObject({ name: 'Root', parentId: null });\n    // creator can read it (owner)\n    const get = await request(app).get(`/folders/${res.body.id}`).set('Authorization', bearer(t));\n    expect(get.status).toBe(200);\n    expect(get.body.role).toBe('owner');\n  });\n\n  it('creates nested folder when editor on parent', async () => {\n    const