est(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'R' });\n    await request(app)\n      .post('/share')\n      .set('Authorization', bearer(owner))\n      .send({ resourceType: 'folder', resourceId: f.body.id, username: 'e6', role: 'editor' });\n    await request(app)\n      .post('/share')\n      .set('Authorization', bearer(owner))\n      .send({ resourceType: 'folder', resourceId: f.body.id, username: 'v6', role: 'viewer' });\n    expect(\n      (await request(app).patch(`/folders/${f.body.id}`).set('Authorization', bearer(editor)).send({ name: 'New' })).status,\n    ).toBe(200);\n    expect(\n      (await request(app).patch(`/folders/${f.body.id}`).set('Authorization', bearer(viewer)).send({ name: 'Nope' })).status,\n    ).toBe(403);\n  });\n\n  it('owner deletes folder and cascades; editor cannot delete', async () => {\n    const owner = await register('o7');\n    const editor = await register('e7');\n    const root = await request(app).post('/folders').set('Authorization', bearer(owner)).send({ name: 'R' });\n    const child = await request(app)\n      .post('/folders')\n      .set('Authorization', bearer(owner))\n      .send({ name: 'C', parentId: root.body.id });\n    const doc = await request(app)\n      .post('/documents')\n      .set('Authorization', bearer(owner))\n      .send({ title: 'D', content: 'c', folderId: child.body.id });\n    await request(app)\n      .post('/share')\n      .set('Authorization', bearer(owner))\n      .send({ resourceType: 'folder', resourceId: root.body.id, username: 'e7', role: 'editor' });\n    // editor cannot delete\n    expect((await request(app).delete(`/folders/${root.body.id}`).set('Authorization', bearer(editor))).status).toBe(403);\n    // owner deletes -> cascades\n    expect((await request(app).delete(`/folders/${root.body.id}`).set('Authorization', bearer(owner))).status).toBe(204);\n    expect((await request(app).get(`/folders/${child.body.id}`).set('Authorization', bearer(owner))).status).toBe(404);\n    expect((await request(app).get(`/documents/${doc.body.id}`).set('Authorization', bearer(owner))).status).toBe(404);\n  });\n});\n\ndescribe('documents', () => {\n  async function setupFolder(token: string, name = 'F'): Promise<string> {\n    const res = await request(app).post('/folders').set('Authorization', bearer(token)).send({ name });\n    return res.body.id as string;\n  }\n\n  it('creates a document with creator as owner (both routes)', async () => {\n    const t = await register('d1');\n    const fid = await setupFolder(t);\n    const res = await request(app)\n      .post('/documents')\n      .set('Authorization', bearer(t))\n      .send({ title: 'Doc', content: 'hello', folderId: fid });\n    expect(res.status).toBe(201);\n    expect(res.body).toMatchObject({ title: 'Doc', content: 'hello', folderId: fid });\n\n    const res2 = await request(app)\n      .post(`/folders/${fid}/documents`)\n      .set('Authorization', bearer(t))\n      .send({ title: 'Doc2', content: 'x' });\n    expect(res2.status).toBe(201);\n    expect(res2.body.folderId).toBe(fid);\n  });\n\n  it('400 missing title or folderId', async () => {\n    const t = await register('d2');\n    const fid = await setupFolder(t);\n    expect((await request(app).post('/documents').set('Authorization', bearer(t)).send({ content: 'x', folderId: fid })).status).toBe(400);\n    expect((await request(app).post('/documents').set('Authorization', bearer(t)).send({ title: 'T', content: 'x' })).status).toBe(400);\n  });\n\n  it('404 folder missing, 403 no access', async () => {\n    const owner = await register('d3');\n    const other = await register('d3b');\n    const fid = await setupFolder(owner);\n    expect((await request(app).post('/documents').set('Authorization', bearer(owner)).send({ title: 'T', folderId: 'nope' })).status).toBe(404);\n    expect((await request(app).post('/documents').set('Authorization', bearer(other)).send({ title: 'T', folderId: fid })).status).toBe(403);\n  });\n\n  it('get/patch/delete permission gating', async () => {\n    const owner = await register('d4');\n    const editor = await register('e4');\n    const viewer = await register('v4');\n    const fid = await setupFolder(owner);\n    const doc = await request(app)\n      .post('/documents')\n      .set('Authorization', bearer(owner))\n      .send({ title: 'T', content: 'c', folderId: fid });\n    const id = doc.body.id;\n    await request(app).post('/share').set('Authorization', bearer(owner)).send({ resourceType: 'document', resourceId: id, username: 'e4', role: 'editor' });\n    await request(app).post('/share').set('Authorization', bearer(owner)).send({ resourceType: 'document', resourceId: id, username: 'v4', role: 'viewer' });\n\n    expect((await request(app).get(`/documents/${id}`).set('Authorization', bearer(viewer))).status).toBe(200);\n    const patchByEditor = await request(app).patch(`/documents/${id}`).set('Authorization', bearer(editor)).send({ content: 'updated' });\n    expect(patchByEditor.status).toBe(200);\n    expect(patchByEditor.body.content).toBe('updated');\n    expect(patchByEditor.body.updatedAt).not.toBe(patchByEditor.body.createdAt);\n\n    expect((await request(app).patch(`/documents/${id}`).set('Authorization', bearer(viewer)).send({ content: 'no' })).status).toBe(403);\n    // editor (not owner) cannot delete\n    expect((await request(app).delete(`/documents/${id}`).set('Authorization', bearer(editor))).status).toBe(403);\n    // owner can delete\n    expect((await request(app).delete(`/documents/${id}`).set('Authorization', bearer(owner))).status).toBe(204);\n    expect((await request(app).get(`/documents/${id}`).set('Authorization', bearer(owner))).status).toBe(404);\n  });\n\n  it('404 for missing doc, 403 for no access', async () => {\n    const owner = await register('d5');\n    const other = await register('o5b');\n    const fid = await setupFolder(owner);\n    const doc = await request(app).post('/documents').set('Authorization'