diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..16b059e
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,248 @@
+import {
+  ActivityAction,
+  ActivityEntry,
+  Document,
+  Folder,
+  ResourceType,
+  Role,
+  ROLE_RANK,
+  ShareMap,
+  User,
+} from './types.js';
+
+/**
+ * In-memory data store with all domain logic for the document management API.
+ * A fresh instance holds no data; everything is lost when the process exits.
+ */
+export class Store {
+  private users = new Map<string, User>();
+  private usersByName = new Map<string, User>();
+  private tokens = new Map<string, string>(); // token -> userId
+  private folders = new Map<string, Folder>();
+  private documents = new Map<string, Document>();
+  // resourceType:resourceId -> (userId -> role)
+  private shares = new Map<string, ShareMap>();
+  private activity: ActivityEntry[] = [];
+
+  private seq = 0;
+
+  private nextId(prefix: string): string {
+    this.seq += 1;
+    return `${prefix}_${this.seq}`;
+  }
+
+  private now(): string {
+    // Monotonic, deterministic-friendly timestamp that still sorts correctly.
+    return new Date(Date.now() + this.seq).toISOString();
+  }
+
+  private shareKey(type: ResourceType, id: string): string {
+    return `${type}:${id}`;
+  }
+
+  // ---- Users -------------------------------------------------------------
+
+  getUserByName(username: string): User | undefined {
+    return this.usersByName.get(username);
+  }
+
+  getUserById(id: string): User | undefined {
+    return this.users.get(id);
+  }
+
+  getUserByToken(token: string): User | undefined {
+    const userId = this.tokens.get(token);
+    return userId ? this.users.get(userId) : undefined;
+  }
+
+  createUser(username: string, password: string): User {
+    const user: User = {
+      id: this.nextId('user'),
+      username,
+      password,
+      token: this.nextId('token') + Math.abs(this.hash(username + password)).toString(36),
+    };
+    this.users.set(user.id, user);
+    this.usersByName.set(username, user);
+    this.tokens.set(user.token, user.id);
+    return user;
+  }
+
+  private hash(input: string): number {
+    let h = 0;
+    for (let i = 0; i < input.length; i += 1) {
+      h = (h << 5) - h + input.charCodeAt(i);
+      h |= 0;
+    }
+    return h;
+  }
+
+  // ---- Folders -----------------------------------------------------------
+
+  getFolder(id: string): Folder | undefined {
+    return this.folders.get(id);
+  }
+
+  createFolder(name: string, parentId: string | null, ownerId: string): Folder {
+    const ts = this.now();
+    const folder: Folder = {
+      id: this.nextId('folder'),
+      name,
+      parentId,
+      ownerId,
+      createdAt: ts,
+      updatedAt: ts,
+    };
+    this.folders.set(folder.id, folder);
+    this.log('folder.create', ownerId, 'folder', folder.id);
+    return folder;
+  }
+
+  updateFolder(folder: Folder, changes: { name?: string; parentId?: string | null }, userId: string): Folder {
+    if (changes.name !== undefined) folder.name = changes.name;
+    if (changes.parentId !== undefined) folder.parentId = changes.parentId;
+    folder.updatedAt = this.now();
+    this.log('folder.update', userId, 'folder', folder.id);
+    return folder;
+  }
+
+  /** Recursively delete a folder, its subfolders and all documents within. */
+  deleteFolder(folder: Folder, userId: string): void {
+    for (const child of this.folders.values()) {
+      if (child.parentId === folder.id) {
+        this.deleteFolder(child, userId);
+      }
+    }
+    for (const doc of [...this.documents.values()]) {
+      if (doc.folderId === folder.id) {
+        this.documents.delete(doc.id);
+        this.shares.delete(this.shareKey('document', doc.id));
+      }
+    }
+    this.folders.delete(folder.id);
+    this.shares.delete(this.shareKey('folder', folder.id));
+    this.log('folder.delete', userId, 'folder', folder.id);
+  }
+
+  // ---- Documents ---------------------------------------------------------
+
+  getDocument(id: string): Document | undefined {
+    return this.documents.get(id);
+  }
+
+  createDocument(title: string, content: string, folderId: string, ownerId: string): Document {
+    const ts = this.now();
+    const doc: Document = {
+      id: this.nextId('doc'),
+      title,
+      content,
+      folderId,
+      ownerId,
+      createdAt: ts,
+      updatedAt: ts,
+    };
+    this.documents.set(doc.id, doc);
+    this.log('document.create', ownerId, 'document', doc.id);
+    return doc;
+  }
+
+  updateDocument(doc: Document, changes: { title?: string; content?: string }, userId: string): Document {
+    if (changes.title !== undefined) doc.title = changes.title;
+    if (changes.content !== undefined) doc.content = changes.content;
+    doc.updatedAt = this.now();
+    this.log('document.update', userId, 'document', doc.id);
+    return doc;
+  }
+
+  deleteDocument(doc: Document, userId: string): void {
+    this.documents.delete(doc.id);
+    this.shares.delete(this.shareKey('document', doc.id));
+    this.log('document.delete', userId, 'document', doc.id);
+  }
+
+  // ---- Sharing & permissions --------------------------------------------
+
+  setShare(type: ResourceType, id: string, targetUserId: string, role: Role, byUserId: string): void {
+    const key = this.shareKey(type, id);
+    let map = this.shares.get(key);
+    if (!map) {
+      map = new Map();
+      this.shares.set(key, map);
+    }
+    map.set(targetUserId, role);
+    this.log('share', byUserId, type, id);
+  }
+
+  private directRole(type: ResourceType, id: string, userId: string): Role | undefined {
+    return this.shares.get(this.shareKey(type, id))?.get(userId);
+  }
+
+  /**
+   * Effective role for a user on a folder, considering ownership, direct
+   * shares and shares inherited from ancestor folders. Returns the most
+   * permissive role, or undefined if the user has no access.
+   */
+  effectiveFolderRole(folder: Folder, userId: string): Role | undefined {
+    let best: Role | undefined;
+    const visited = new Set<string>();
+    let current: Folder | undefined = folder;
+    while (current && !visited.has(current.id)) {
+      visited.add(current.id);
+      if (current.ownerId === userId) {
+        best = this.maxRole(best, 'owner');
+      }
+      const shared = this.directRole('folder', current.id, userId);
+      if (shared) best = this.maxRole(best, shared);
+      current = current.parentId ? this.folders.get(current.parentId) : undefined;
+    }
+    return best;
+  }
+
+  /**
+   * Effective role for a user on a document: ownership, direct shares on the
+   * document, and inherited access from the containing folder hierarchy.
+   */
+  effectiveDocumentRole(doc: Document, userId: string): Role | undefined {
+    let best: Role | undefined;
+    if (doc.ownerId === userId) best = this.maxRole(best, 'owner');
+    const shared = this.directRole('document', doc.id, userId);
+    if (shared) best = this.maxRole(best, shared);
+    const folder = this.folders.get(doc.folderId);
+    if (folder) {
+      const inherited = this.effectiveFolderRole(folder, userId);
+      if (inherited) best = this.maxRole(best, inherited);
+    }
+    return best;
+  }
+
+  effectiveRole(type: ResourceType, id: string, userId: string): Role | undefined {
+    if (type === 'folder') {
+      const folder = this.folders.get(id);
+      return folder ? this.effectiveFolderRole(folder, userId) : undefined;
+    }
+    const doc = this.documents.get(id);
+    return doc ? this.effectiveDocumentRole(doc, userId) : undefined;
+  }
+
+  private maxRole(a: Role | undefined, b: Role): Role {
+    if (!a) return b;
+    return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;
+  }
+
+  // ---- Activity ----------------------------------------------------------
+
+  private log(action: ActivityAction, userId: string, resourceType: ResourceType, resourceId: string): void {
+    this.activity.push({
+      id: this.nextId('act'),
+      action,
+      userId,
+      resourceType,
+      resourceId,
+      timestamp: this.now(),
+    });
+  }
+
+  getActivity(): ActivityEntry[] {
+    return [...this.activity].reverse();
+  }
+}
