T counts numeric values only', () => {\n    const s = seed();\n    s.set('B1', '=COUNT(A1:A5)');\n    expect(s.get('B1')).toBe(4);\n  });\n\n  it('accepts multiple/scalar arguments', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('B1', '=SUM(A1,A2,5)');\n    expect(s.get('B1')).toBe(8);\n  });\n\n  it('is case-insensitive on function names', () => {\n    const s = seed();\n    s.set('B1', '=sum(A1:A3)');\n    expect(s.get('B1')).toBe(60);\n  });\n\n  it('returns #NAME? for unknown functions', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=FOO(1,2)');\n    expect(s.get('A1')).toBe('#NAME?');\n  });\n\n  it('sums block and row ranges', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('B1', 2);\n    s.set('A2', 3);\n    s.set('B2', 4);\n    s.set('C1', '=SUM(A1:B2)');\n    expect(s.get('C1')).toBe(10);\n    s.set('C2', '=SUM(A1:B1)');\n    expect(s.get('C2')).toBe(3);\n  });\n\n  it('handles reversed ranges', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('A3', 3);\n    s.set('B1', '=SUM(A3:A1)');\n    expect(s.get('B1')).toBe(6);\n  });\n});\n\ndescribe('reactive updates', () => {\n  it('recomputes direct dependents', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe(6);\n    s.set('A1', 10);\n    expect(s.get('B1')).toBe(11);\n  });\n\n  it('propagates through a transitive chain', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('B1', '=A1*2');\n    s.set('C1', '=B1+3');\n    expect(s.get('C1')).toBe(5);\n    s.set('A1', 10);\n    expect(s.get('B1')).toBe(20);\n    expect(s.get('C1')).toBe(23);\n  });\n\n  it('updates aggregates when a member changes', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('B1', '=SUM(A1:A2)');\n    expect(s.get('B1')).toBe(3);\n    s.set('A2', 20);\n    expect(s.get('