nst c = this.cells.get(n);\n      if (c) {\n        for (const d of c.deps) {\n          if (affected.has(d)) visit(d);\n        }\n      }\n      order.push(n);\n    };\n    for (const n of affected) visit(n);\n\n    for (const n of order) this.evaluateCell(n);\n  }\n\n  private evaluateCell(ref: string): void {\n    const c = this.cells.get(ref);\n    if (!c) return;\n    if (!c.ast) {\n      c.value = c.input as CellValue;\n      return;\n    }\n    try {\n      c.value = this.evalNode(c.ast);\n    } catch (e) {\n      if (e instanceof EvalError) {\n        c.value = e.message;\n      } else {\n        c.value = ERR_GENERIC;\n      }\n    }\n  }\n\n  /** Read a cell's value for use inside a formula, propagating error cells. */\n  private readCell(ref: string): CellValue {\n    const c = this.cells.get(ref);\n    if (!c) return null;\n    if (typeof c.value === 'string' && ERROR_CODES.has(c.value)) {\n      throw new EvalError(c.value);\n    }\n    return c.value;\n  }\n\n  private evalNode(node: Node): CellValue {\n    switch (node.type) {\n      case 'num':\n        return node.value;\n      case 'str':\n        return node.value;\n      case 'bool':\n        return node.value;\n      case 'ref':\n        return this.readCell(node.ref);\n      case 'range':\n        // A bare range is not a valid scalar expression.\n        throw new EvalError(ERR_VALUE);\n      case 'unary': {\n        const v = toNumber(this.evalNode(node.operand));\n        return node.op === '-' ? -v : v;\n      }\n      case 'binary': {\n        const a = toNumber(this.evalNode(node.left));\n        const b = toNumber(this.evalNode(node.right));\n        switch (node.op) {\n          case '+':\n            return a + b;\n          case '-':\n            return a - b;\n          case '*':\n            return a * b;\n          case '/':\n            if (b === 0) throw new EvalError(ERR_DIV0);\n            return a / b;\n          default:\n            throw new EvalError(ERR_GENERIC);\n        }\n      }\n      case 'compare':\n        return compare(node.op, this.evalNode(node.left), this.evalNode(node.right));\n      case 'call':\n        return this.evalCall(node);\n      default:\n        throw new EvalError(ERR_GENERIC);\n    }\n  }\n\n  private evalCall(node: Extract<Node, { type: 'call' }>): CellValue {\n    const name = node.name;\n    if (name === 'IF') {\n      if (node.args.length < 2 || node.args.length > 3) throw new EvalError(ERR_GENERIC);\n      const cond = toBool(this.evalNode(node.args[0]));\n      if (cond) return this.evalNode(node.args[1]);\n      return node.args.length === 3 ? this.evalNode(node.args[2]) : false;\n    }\n\n    // Aggregate functions operate over the numeric values in their arguments.\n    const nums = this.collectNumbers(node.args);\n    switch (name) {\n      case 'SUM':\n        return nums.reduce((s, x) => s + x, 0);\n      case 'AVERAGE':\n        if (nums.length === 0) throw new EvalError(ERR_DIV0);\n        return nums.reduce((s, x) => s + x, 0) / nums.length;\n      case 'MIN':\n        return nums.length === 0 ? 0 : Math.min(...nums);\n      case 'MAX':\n        return nums.length === 0 ? 0 : Math.max(...nums);\n      case 'COUNT':\n        return nums.length;\n      default:\n        throw new EvalError(ERR_NAME);\n    }\n  }\n\n  /** Gather numeric values from function arguments (ranges + scalars). */\n  private collectNumbers(args: Node[]): number[] {\n    const nums: number[] = [];\n    for (const arg of args) {\n      if (arg.type === 'range') {\n        for (const ref of expandRange(arg.start, arg.end)) {\n          const v = this.readCell(ref); // throws if the cell is an error\n          if (typeof v === 'number') nums.push(v);\n        }\n      } else {\n        const v = this.evalNode(arg);\n        if (typeof v === 'number') nums.push(v);\n        else if (typeof v === 'boolean') nums.push(v ? 1 : 0);\n      }\n    }\n    return nums;\n  }\n}\n\n// ---------------------------------------------------------------------------\n// Coercion helpers\n// ---------------------------------------------------------------------------\n\nconst NUMERIC_STR_RE = /^[+-]?(\\d+(\\.\\d+)?|\\.\\d+)$/;\n\n/** Coerce a value to a number for arithmetic, throwing #VALUE! when impossible. */\nfunction toNumber(v: CellValue): number {\n  if (typeof v === 'number') return v;\n  if (typeof v === 'boolean') return v ? 1 : 0;\n  if (v === null) return 0; // empty cell behaves as 0\n  const s = v.trim();\n  if (NUMERIC_STR_RE.test(s)) return parseFloat(s);\n  throw new EvalError(ERR_VALUE);\n}\n\nfunction toBool(v: CellValue): boolean {\n  if (typeof v === 'boolean') return v;\n  if (typeof v === 'number') return v !== 0;\n  if (v === null) return false;\n  return v.length > 0;\n}\n\n/** Is a value numerically comparable (number, boolean, null, numeric string)? */\nfunction asNumberOrNull(v: CellValue): number | null {\n  if (typeof v === 'number') return v;\n  if (typeof v === 'boolean') return v ? 1 : 0;\n  if (v === null) return 0;\n  const s = v.trim();\n  return NUMERIC_STR_RE.test(s) ? parseFloat(s) : null;\n}\n\nfunction compare(op: string, left: CellValue, right: CellValue): boolean {\n  const ln = asNumberOrNull(left);\n  const rn = asNumberOrNull(right);\n  let a: number | string;\n  let b: number | string;\n  if (ln !== null && rn !== null) {\n    a = ln;\n    b = rn;\n  } else {\n    a = left === null ? '' : String(left);\n    b = right === null ? '' : String(right);\n  }\n  switch (op) {\n    case '>':\n      return a > b;\n    case '<':\n      return a < b;\n    case '>=':\n      return a >= b;\n    case '<=':\n      return a <= b;\n    case '=':\n      return a === b;\n    case '<>':\n      return a !== b;\n    default:\n      throw new EvalError(ERR_GENERIC);\n  }\n}\n\nexport default Spreadsheet;\n","structuredPatch":[],"originalFile":null,"userModified":false}}
