+import { describe, it, expect } from 'vitest';
+import {
+  colToNum,
+  numToCol,
+  parseCellRef,
+  tryParseCellRef,
+  formatCellRef,
+  normalizeCellRef,
+  expandRange,
+} from './cellRef.js';
+
+describe('colToNum / numToCol', () => {
+  it('maps single letters', () => {
+    expect(colToNum('A')).toBe(1);
+    expect(colToNum('Z')).toBe(26);
+  });
+
+  it('maps multi-letter columns', () => {
+    expect(colToNum('AA')).toBe(27);
+    expect(colToNum('AZ')).toBe(52);
+    expect(colToNum('BA')).toBe(53);
+    expect(colToNum('ZZ')).toBe(702);
+  });
+
+  it('is case-insensitive', () => {
+    expect(colToNum('aa')).toBe(27);
+  });
+
+  it('round-trips', () => {
+    for (const n of [1, 26, 27, 52, 53, 702, 703, 1000]) {
+      expect(colToNum(numToCol(n))).toBe(n);
+    }
+  });
+});
+
+describe('parseCellRef', () => {
+  it('parses simple refs', () => {
+    expect(parseCellRef('A1')).toEqual({ col: 1, row: 1 });
+    expect(parseCellRef('B2')).toEqual({ col: 2, row: 2 });
+    expect(parseCellRef('Z100')).toEqual({ col: 26, row: 100 });
+    expect(parseCellRef('AA1')).toEqual({ col: 27, row: 1 });
+  });
+
+  it('rejects malformed refs', () => {
+    for (const bad of ['foo', '1A', 'A0', '', 'A', '1', 'A1B', '$A$1', 'A 1']) {
+      expect(() => parseCellRef(bad)).toThrow();
+      expect(tryParseCellRef(bad)).toBeNull();
+    }
+  });
+});
+
+describe('formatCellRef / normalizeCellRef', () => {
+  it('formats coords', () => {
+    expect(formatCellRef({ col: 1, row: 1 })).toBe('A1');
+    expect(formatCellRef({ col: 27, row: 10 })).toBe('AA10');
+  });
+
+  it('normalizes to uppercase', () => {
+    expect(normalizeCellRef('a1')).toBe('A1');
+    expect(normalizeCellRef('aa10')).toBe('AA10');
+  });
+});
+
+describe('expandRange', () => {
+  it('expands column ranges', () => {
+    expect(expandRange({ col: 1, row: 1 }, { col: 1, row: 5 })).toEqual([
+      'A1', 'A2', 'A3', 'A4', 'A5',
+    ]);
+  });
+
+  it('expands row ranges', () => {
+    expect(expandRange({ col: 1, row: 1 }, { col: 3, row: 1 })).toEqual([
+      'A1', 'B1', 'C1',
+    ]);
+  });
+
+  it('expands block ranges', () => {
+    const cells = expandRange({ col: 1, row: 1 }, { col: 3, row: 3 });
+    expect(cells).toHaveLength(9);
+    expect(cells).toContain('A1');
+    expect(cells).toContain('C3');
+    expect(cells).toContain('B2');
+  });
+
+  it('handles reversed corners', () => {
+    expect(expandRange({ col: 1, row: 5 }, { col: 1, row: 1 })).toEqual([
+      'A1', 'A2', 'A3', 'A4', 'A5',
+    ]);
+  });
+});
diff --git a/src/cellRef.ts b/src/cellRef.ts
new file mode 100644
index 0000000..3f55d75
--- /dev/null
+++ b/src/cellRef.ts
@@ -0,0 +1,84 @@
+/**
+ * Utilities for parsing and formatting spreadsheet cell references such as
+ * `A1`, `B2`, `AA10`. Columns are 1-based (A = 1), rows are 1-based.
+ */
+
+export interface CellCoord {
+  col: number; // 1-based column index (A = 1)
+  row: number; // 1-based row index
+}
+
+const CELL_RE = /^([A-Za-z]+)([1-9][0-9]*)$/;
+
+/** Convert a column letter string (e.g. "A", "AA") to a 1-based number. */
+export function colToNum(letters: string): number {
+  let n = 0;
+  for (const ch of letters.toUpperCase()) {
+    const code = ch.charCodeAt(0);
+    if (code < 65 || code > 90) {
+      throw new Error(`Invalid column letter: ${letters}`);
+    }
+    n = n * 26 + (code - 64); // 'A' -> 1
+  }
+  return n;
+}
+
+/** Convert a 1-based column number to its letter representation. */
+export function numToCol(num: number): string {
+  if (!Number.isInteger(num) || num < 1) {
+    throw new Error(`Invalid column number: ${num}`);
+  }
+  let s = '';
+  let n = num;
+  while (n > 0) {
+    const rem = (n - 1) % 26;
+    s = String.fromCharCode(65 + rem) + s;
+    n = Math.floor((n - 1) / 26);
+  }
+  return s;
+}
+
+/** Parse a cell reference into coordinates, or return null if malformed. */
+export function tryParseCellRef(ref: string): CellCoord | null {
+  const m = CELL_RE.exec(ref.trim());
+  if (!m) return null;
+  return { col: colToNum(m[1]), row: parseInt(m[2], 10) };
+}
+
+/** Parse a cell reference, throwing on malformed input. */
+export function parseCellRef(ref: string): CellCoord {
+  const coord = tryParseCellRef(ref);
+  if (!coord) {
+    throw new Error(`Invalid cell reference: ${JSON.stringify(ref)}`);
+  }
+  return coord;
+}
+
+/** Format coordinates back into a canonical (uppercase) cell key. */
+export function formatCellRef(coord: CellCoord): string {
+  return numToCol(coord.col) + String(coord.row);
+}
+
+/** Normalize a cell reference to canonical uppercase form (e.g. "a1" -> "A1"). */
+export function normalizeCellRef(ref: string): string {
+  return formatCellRef(parseCellRef(ref));
+}
+
+/**
+ * Expand a range defined by two corner cells into the ordered list of cell
+ * keys it covers. Works for column, row, and 2D block ranges regardless of
+ * which corner is given first.
+ */
+export function expandRange(start: CellCoord, end: CellCoord): string[] {
+  const c1 = Math.min(start.col, end.col);
+  const c2 = Math.max(start.col, end.col);
+  const r1 = Math.min(start.row, end.row);
+  const r2 = Math.max(start.row, end.row);
+  const cells: string[] = [];
+  for (let r = r1; r <= r2; r++) {
+    for (let c = c1; c <= c2; c++) {
+      cells.push(formatCellRef({ col: c, row: r }));
+    }
+  }
+  return cells;
+}
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..0c84d29
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,178 @@
+import { Node } from './parser.js';
+import { expandRange, parseCellRef } from './cellRef.js';
+import {
+  CellValue,
+  FormulaError,
+  DIV_ZERO,
+  VALUE_ERR,
+  NAME_ERR,
+  GENERIC_ERR,
+  isError,
+} from './values.js';
+
+/** Lookup function: returns the current computed value of a cell, or null if empty. */
+export type CellLookup = (ref: string) => CellValue;
+
+const AGGREGATES = new Set(['SUM', 'AVERAGE', 'MIN', 'MAX', 'COUNT']);
+
+/**
+ * Coerce a scalar value to a number for arithmetic. Empty cells -> 0,
+ * booleans -> 1/0, numeric values pass through. Non-numeric strings and
+ * errors yield an error (propagated by callers).
+ */
+function toNumber(v: CellValue): number | FormulaError {
+  if (isError(v)) return v;
+  if (v === null) return 0;
+  if (typeof v === 'number') return v;
+  if (typeof v === 'boolean') return v ? 1 : 0;
+  // string
+  if (v.trim() === '') return 0;
+  const n = Number(v);
+  return Number.isNaN(n) ? VALUE_ERR : n;
+}
+
+function toBoolean(v: CellValue): boolean | FormulaError {
+  if (isError(v)) return v;
+  if (v === null) return false;
+  if (typeof v === 'boolean') return v;
+  if (typeof v === 'number') return v !== 0;
+  // string: non-empty is true
+  return v.length > 0;
+}
+
+/** Flatten a function argument into the scalar values it contributes. */
+function flattenArg(node: Node, lookup: CellLookup): CellValue[] {
+  if (node.kind === 'range') {
+    const start = parseCellRef(node.start);
+    const end = parseCellRef(node.end);
+    return expandRange(start, end).map((c) => lookup(c));
+  }
+  return [evaluate(node, lookup)];
+}
+
+/** Collect numeric values from function arguments, ignoring empty/text/bool. */
+function collectNumbers(args: Node[], lookup: CellLookup): number[] | FormulaError {
+  const nums: number[] = [];
+  for (const arg of args) {
+    for (const v of flattenArg(arg, lookup)) {
+      if (isError(v)) return v; // propagate errors
+      if (typeof v === 'number') {
+        nums.push(v);
+      }
+      // empty cells, strings and booleans are ignored by aggregates
+    }
+  }
+  return nums;
+}
+
+function evalAggregate(name: string, args: Node[], lookup: CellLookup): CellValue {
+  const nums = collectNumbers(args, lookup);
+  if (nums instanceof FormulaError) return nums;
+  switch (name) {
+    case 'SUM':
+      return nums.reduce((a, b) => a + b, 0);
+    case 'COUNT':
+      return nums.length;
+    case 'AVERAGE':
+      if (nums.length === 0) return DIV_ZERO;
+      return nums.reduce((a, b) => a + b, 0) / nums.length;
+    case 'MIN':
+      if (nums.length === 0) return 0;
+      return Math.min(...nums);
+    case 'MAX':
+      if (nums.length === 0) return 0;
+      return Math.max(...nums);
+    default:
+      return NAME_ERR;
+  }
+}
+
+function evalIf(args: Node[], lookup: CellLookup): CellValue {
+  if (args.length !== 3) return GENERIC_ERR;
+  const cond = toBoolean(evaluate(args[0], lookup));
+  if (isError(cond)) return cond;
+  return evaluate(cond ? args[1] : args[2], lookup);
+}
+
+function evalComparison(op: string, l: CellValue, r: CellValue): CellValue {
+  if (isError(l)) return l;
+  if (isError(r)) return r;
+  // Numeric comparison when both coerce to numbers (treat empty as 0).
+  const ln = l === null ? 0 : l;
+  const rn = r === null ? 0 : r;
+  let a: number | string | boolean;
+  let b: number | string | boolean;
+  if (typeof ln === 'string' || typeof rn === 'string') {
+    // If both are numeric-looking we still compare numerically; otherwise string compare.
+    if (typeof ln === 'number' && typeof rn === 'string' && rn.trim() !== '' && !Number.isNaN(Number(rn))) {
+      a = ln; b = Number(rn);
+    } else if (typeof rn === 'number' && typeof ln === 'string' && ln.trim() !== '' && !Number.isNaN(Number(ln))) {
+      a = Number(ln); b = rn;
+    } else {
+      a = String(ln); b = String(rn);
+    }
+  } else {
+    a = typeof ln === 'boolean' ? (ln ? 1 : 0) : ln;
+    b = typeof rn === 'boolean' ? (rn ? 1 : 0) : rn;
+  }
+  switch (op) {
+    case '>': return a > b;
+    case '<': return a < b;
+    case '>=': return a >= b;
+    case '<=': return a <= b;
+    case '=': return a === b;
+    case '<>': return a !== b;
+    default: return GENERIC_ERR;
+  }
+}
+
+function evalBinary(op: string, ln: Node, rn: Node, lookup: CellLookup): CellValue {
+  const left = evaluate(ln, lookup);
+  const right = evaluate(rn, lookup);
+  if (['>', '<', '>=', '<=', '=', '<>'].includes(op)) {
+    return evalComparison(op, left, right);
+  }
+  const a = toNumber(left);
+  if (isError(a)) return a;
+  const b = toNumber(right);
+  if (isError(b)) return b;
+  switch (op) {
+    case '+': return a + b;
+    case '-': return a - b;
+    case '*': return a * b;
+    case '/': return b === 0 ? DIV_ZERO : a / b;
+    default: return GENERIC_ERR;
+  }
+}
+
+/** Evaluate a formula AST node against the provided cell lookup. */
+export function evaluate(node: Node, lookup: CellLookup): CellValue {
+  switch (node.kind) {
+    case 'number':
+      return node.value;
+    case 'string':
+      return node.value;
+    case 'bool':
+      return node.value;
+    case 'cell':
+      return lookup(node.ref);
+    case 'range':
+      // A bare range used as a scalar is invalid.
+      return VALUE_ERR;
+    case 'unary': {
+      const v = toNumber(evaluate(node.operand, lookup));
+      if (isError(v)) return v;
+      return node.op === '-' ? -v : v;
+    }
+    case 'binary':
+      return evalBinary(node.op, node.left, node.right, lookup);
+    case 'call': {
+      const name = node.name.toUpperCase();
+      if (name === 'IF') return evalIf(node.args, lookup);
+      if (AGGREGATES.has(name)) return evalAggregate(name, node.args, lookup);
+      return NAME_ERR;
+    }
+    default:
+      return GENERIC_ERR;
+  }
+}
