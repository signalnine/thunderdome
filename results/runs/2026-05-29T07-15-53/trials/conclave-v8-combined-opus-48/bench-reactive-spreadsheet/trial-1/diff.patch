+++ b/src/spreadsheet.ts
@@ -0,0 +1,186 @@
+import { normalizeCellRef, parseCellRef, expandRange } from './cellRef.js';
+import { Node, parseFormula, collectDependencies } from './parser.js';
+import { evaluate } from './evaluator.js';
+import { CellValue, PublicValue, toPublic, displayOf } from './values.js';
+
+interface Cell {
+  /** Raw literal value, or undefined when the cell holds a formula. */
+  literal?: number | string | boolean;
+  /** Parsed formula AST, or undefined for literal cells. */
+  formula?: Node;
+  /** Original formula source (including leading '='), for round-tripping. */
+  source?: string;
+  /** Cells this cell directly depends on. */
+  deps: Set<string>;
+  /** Last computed value. */
+  value: CellValue;
+}
+
+function expandRangeKeys(start: string, end: string): string[] {
+  return expandRange(parseCellRef(start), parseCellRef(end));
+}
+
+export class Spreadsheet {
+  private cells = new Map<string, Cell>();
+  /** Reverse dependency edges: dependents.get(X) = cells whose formula references X. */
+  private dependents = new Map<string, Set<string>>();
+
+  /** Set a cell's value: a raw value, or a formula string starting with '='. */
+  set(cell: string, value: string | number | boolean): void {
+    const key = normalizeCellRef(cell);
+
+    let formula: Node | undefined;
+    let source: string | undefined;
+    let literal: number | string | boolean | undefined;
+    const newDeps = new Set<string>();
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      source = value;
+      formula = parseFormula(value.slice(1));
+      collectDependencies(formula, newDeps, expandRangeKeys);
+    } else {
+      literal = value;
+    }
+
+    // Circular reference detection (before mutating any state).
+    this.assertNoCycle(key, newDeps);
+
+    const existing = this.cells.get(key);
+    const oldDeps = existing?.deps ?? new Set<string>();
+
+    // Update reverse-dependency edges.
+    for (const d of oldDeps) {
+      if (!newDeps.has(d)) {
+        this.dependents.get(d)?.delete(key);
+      }
+    }
+    for (const d of newDeps) {
+      if (!oldDeps.has(d)) {
+        let set = this.dependents.get(d);
+        if (!set) {
+          set = new Set<string>();
+          this.dependents.set(d, set);
+        }
+        set.add(key);
+      }
+    }
+
+    const cellData: Cell = { literal, formula, source, deps: newDeps, value: null };
+    this.cells.set(key, cellData);
+
+    // Recompute this cell and everything that (transitively) depends on it.
+    this.recompute(key);
+  }
+
+  /** Get a cell's computed value, or null if empty. */
+  get(cell: string): PublicValue {
+    const key = normalizeCellRef(cell);
+    const c = this.cells.get(key);
+    if (!c) return null;
+    return toPublic(c.value);
+  }
+
+  /** Get the display string for a cell's computed value. */
+  getDisplay(cell: string): string {
+    const key = normalizeCellRef(cell);
+    const c = this.cells.get(key);
+    if (!c) return '';
+    return displayOf(c.value);
+  }
+
+  /** Get all non-empty cells as a Map from cell reference to computed value. */
+  getCells(): Map<string, PublicValue> {
+    const out = new Map<string, PublicValue>();
+    for (const [key, c] of this.cells) {
+      const pub = toPublic(c.value);
+      if (pub !== null) {
+        out.set(key, pub);
+      }
+    }
+    return out;
+  }
+
+  // --- internals ---
+
+  /** Resolve a cell's current computed value for the evaluator. */
+  private lookup = (ref: string): CellValue => {
+    const c = this.cells.get(ref);
+    return c ? c.value : null;
+  };
+
+  /** Compute the value of a single cell from its literal/formula. */
+  private computeCell(key: string): CellValue {
+    const c = this.cells.get(key);
+    if (!c) return null;
+    if (c.formula) {
+      return evaluate(c.formula, this.lookup);
+    }
+    return c.literal ?? null;
+  }
+
+  /**
+   * Recompute `key` and all of its transitive dependents in dependency order
+   * (each cell computed only after the cells it relies on).
+   */
+  private recompute(key: string): void {
+    // Gather the affected set: key plus everything that transitively depends on it.
+    const affected = new Set<string>();
+    const stack = [key];
+    while (stack.length) {
+      const cur = stack.pop()!;
+      if (affected.has(cur)) continue;
+      affected.add(cur);
+      const deps = this.dependents.get(cur);
+      if (deps) {
+        for (const d of deps) {
+          if (!affected.has(d)) stack.push(d);
+        }
+      }
+    }
+
+    // Topologically sort affected cells (dependencies before dependents).
+    const order: string[] = [];
+    const visited = new Set<string>();
+    const visit = (c: string): void => {
+      if (visited.has(c)) return;
+      visited.add(c);
+      const cell = this.cells.get(c);
+      if (cell) {
+        for (const dep of cell.deps) {
+          if (affected.has(dep)) visit(dep);
+        }
+      }
+      order.push(c);
+    };
+    for (const c of affected) visit(c);
+
+    for (const c of order) {
+      const cell = this.cells.get(c);
+      if (cell) cell.value = this.computeCell(c);
+    }
+  }
+
+  /**
+   * Throw if giving `key` the dependency set `newDeps` would introduce a cycle
+   * (direct, self, or indirect through any chain).
+   */
+  private assertNoCycle(key: string, newDeps: Set<string>): void {
+    const visited = new Set<string>();
+    const reachesKey = (node: string): boolean => {
+      if (node === key) return true;
+      if (visited.has(node)) return false;
+      visited.add(node);
+      const cell = this.cells.get(node);
+      if (!cell) return false;
+      for (const dep of cell.deps) {
+        if (reachesKey(dep)) return true;
+      }
+      return false;
+    };
+    for (const dep of newDeps) {
+      if (reachesKey(dep)) {
+        throw new Error(`Circular reference detected involving ${key}`);
+      }
+    }
+  }
+}
