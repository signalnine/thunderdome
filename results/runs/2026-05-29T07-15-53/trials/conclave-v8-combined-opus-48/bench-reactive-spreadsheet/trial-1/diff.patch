+/** A formula error value (e.g. division by zero). Behaves like Excel error codes. */
+export class FormulaError {
+  constructor(public readonly code: string) {}
+  toString(): string {
+    return this.code;
+  }
+}
+
+export const DIV_ZERO = new FormulaError('#DIV/0!');
+export const VALUE_ERR = new FormulaError('#VALUE!');
+export const NAME_ERR = new FormulaError('#NAME?');
+export const REF_ERR = new FormulaError('#REF!');
+export const GENERIC_ERR = new FormulaError('#ERROR!');
+
+/** Internal computed value of a cell. `null` represents an empty cell. */
+export type CellValue = number | string | boolean | null | FormulaError;
+
+/** Public value returned to API consumers (errors surfaced as their code string). */
+export type PublicValue = number | string | boolean | null;
+
+export function isError(v: CellValue): v is FormulaError {
+  return v instanceof FormulaError;
+}
+
+/** Convert an internal cell value to the public API value. */
+export function toPublic(v: CellValue): PublicValue {
+  return v instanceof FormulaError ? v.code : v;
+}
+
+/** Render a computed value as its display string. */
+export function displayOf(v: CellValue): string {
+  if (v === null) return '';
+  if (v instanceof FormulaError) return v.code;
+  if (typeof v === 'boolean') return v ? 'true' : 'false';
+  return String(v);
+}
