+/** Token types produced by the formula tokenizer. */
+export type TokenType =
+  | 'NUMBER'
+  | 'STRING'
+  | 'BOOL'
+  | 'CELL'
+  | 'IDENT'
+  | 'OP'
+  | 'LPAREN'
+  | 'RPAREN'
+  | 'COMMA'
+  | 'COLON';
+
+export interface Token {
+  type: TokenType;
+  value: string;
+  /** Parsed literal for NUMBER/STRING/BOOL tokens. */
+  literal?: number | string | boolean;
+  pos: number;
+}
+
+const COMPARE_TWO = new Set(['>=', '<=', '<>']);
+const ARITH = new Set(['+', '-', '*', '/']);
+const COMPARE_ONE = new Set(['>', '<', '=']);
+
+function isDigit(ch: string): boolean {
+  return ch >= '0' && ch <= '9';
+}
+
+function isLetter(ch: string): boolean {
+  return (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z');
+}
+
+/**
+ * Convert a formula body (without the leading `=`) into a token stream.
+ * Throws on illegal characters or unterminated strings.
+ */
+export function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+  const n = input.length;
+
+  while (i < n) {
+    const ch = input[i];
+
+    // Whitespace
+    if (ch === ' ' || ch === '\t' || ch === '\n' || ch === '\r') {
+      i++;
+      continue;
+    }
+
+    // String literal (double or single quoted)
+    if (ch === '"' || ch === "'") {
+      const quote = ch;
+      const start = i;
+      i++;
+      let str = '';
+      while (i < n && input[i] !== quote) {
+        if (input[i] === '\\' && i + 1 < n) {
+          // Allow escaped quote / backslash.
+          str += input[i + 1];
+          i += 2;
+        } else {
+          str += input[i];
+          i++;
+        }
+      }
+      if (i >= n) {
+        throw new Error(`Unterminated string in formula at position ${start}`);
+      }
+      i++; // closing quote
+      tokens.push({ type: 'STRING', value: str, literal: str, pos: start });
+      continue;
+    }
+
+    // Number literal (supports leading dot, e.g. .5)
+    if (isDigit(ch) || (ch === '.' && isDigit(input[i + 1] ?? ''))) {
+      const start = i;
+      while (i < n && isDigit(input[i])) i++;
+      if (input[i] === '.') {
+        i++;
+        while (i < n && isDigit(input[i])) i++;
+      }
+      // Scientific notation
+      if (input[i] === 'e' || input[i] === 'E') {
+        let j = i + 1;
+        if (input[j] === '+' || input[j] === '-') j++;
+        if (isDigit(input[j] ?? '')) {
+          i = j;
+          while (i < n && isDigit(input[i])) i++;
+        }
+      }
+      const raw = input.slice(start, i);
+      tokens.push({ type: 'NUMBER', value: raw, literal: parseFloat(raw), pos: start });
+      continue;
+    }
+
+    // Identifier, cell reference, or boolean keyword
+    if (isLetter(ch)) {
+      const start = i;
+      while (i < n && isLetter(input[i])) i++;
+      const letters = input.slice(start, i);
+      // If immediately followed by digits -> cell reference (e.g. A1, AA10)
+      if (i < n && isDigit(input[i])) {
+        while (i < n && isDigit(input[i])) i++;
+        const cellText = input.slice(start, i);
+        tokens.push({ type: 'CELL', value: cellText.toUpperCase(), pos: start });
+        continue;
+      }
+      const lower = letters.toLowerCase();
+      if (lower === 'true' || lower === 'false') {
+        tokens.push({ type: 'BOOL', value: letters, literal: lower === 'true', pos: start });
+        continue;
+      }
+      tokens.push({ type: 'IDENT', value: letters.toUpperCase(), pos: start });
+      continue;
+    }
+
+    // Two-character comparison operators
+    const two = input.slice(i, i + 2);
+    if (COMPARE_TWO.has(two)) {
+      tokens.push({ type: 'OP', value: two, pos: i });
+      i += 2;
+      continue;
+    }
+
+    // Single-character tokens
+    if (ARITH.has(ch) || COMPARE_ONE.has(ch)) {
+      tokens.push({ type: 'OP', value: ch, pos: i });
+      i++;
+      continue;
+    }
+    if (ch === '(') {
+      tokens.push({ type: 'LPAREN', value: ch, pos: i });
+      i++;
+      continue;
+    }
+    if (ch === ')') {
+      tokens.push({ type: 'RPAREN', value: ch, pos: i });
+      i++;
+      continue;
+    }
+    if (ch === ',') {
+      tokens.push({ type: 'COMMA', value: ch, pos: i });
+      i++;
+      continue;
+    }
+    if (ch === ':') {
+      tokens.push({ type: 'COLON', value: ch, pos: i });
+      i++;
+      continue;
+    }
+
+    throw new Error(`Unexpected character ${JSON.stringify(ch)} at position ${i}`);
+  }
+
+  return tokens;
+}
