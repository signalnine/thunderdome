+import { describe, it, expect, beforeEach } from 'vitest';
+import { Spreadsheet } from './index.js';
+
+let sheet: Spreadsheet;
+beforeEach(() => {
+  sheet = new Spreadsheet();
+});
+
+describe('raw values', () => {
+  it('stores numbers, floats, strings, booleans', () => {
+    sheet.set('A1', 42);
+    sheet.set('A2', 3.14);
+    sheet.set('A3', 'hello');
+    sheet.set('A4', true);
+    sheet.set('A5', false);
+    expect(sheet.get('A1')).toBe(42);
+    expect(sheet.get('A2')).toBe(3.14);
+    expect(sheet.get('A3')).toBe('hello');
