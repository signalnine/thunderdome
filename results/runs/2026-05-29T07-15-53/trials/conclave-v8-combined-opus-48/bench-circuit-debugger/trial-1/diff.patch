, in1: x(b), in2: y(b), out: gen });\n    gates.push({ op: 'AND', in1: partial, in2: carry, out: prop });\n    const nextCarry = b === n - 1 ? z(n) : fresh();\n    gates.push({ op: 'OR', in1: gen, in2: prop, out: nextCarry });\n    carry = nextCarry;\n  }\n  return gates;\n}\n\n/** True if the circuit topologically sorts (acyclic). */\nfunction isAcyclic(gates: Gate[]): boolean {\n  const produced = new Set(gates.map((g) => g.out));\n  const known = new Set<string>();\n  for (const g of gates) {\n    for (const w of [g.in1, g.in2]) {\n      if (!produced.has(w)) known.add(w);\n    }\n  }\n  let pending = gates.slice();\n  for (;;) {\n    const next: Gate[] = [];\n    let progressed = false;\n    for (const g of pending) {\n      if (known.has(g.in1) && known.has(g.in2)) {\n        known.add(g.out);\n        progressed = true;\n      } else {\n        next.push(g);\n      }\n    }\n    pending = next;\n    if (pending.length === 0) return true;\n    if (!progressed) return false;\n  }\n}\n\n/** Read the Z register from a simulation result. */\nfunction readZ(values: Record<string, number>, n: number): bigint {\n  let v = 0n;\n  for (let b = 0; b <= n; b++) {\n    if (values[z(b)]) v |= 1n << BigInt(b);\n  }\n  return v;\n}\n\nfunction setInputs(n: number, X: bigint, Y: bigint): Record<string, number> {\n  const inputs: Record<string, number> = {};\n  for (let b = 0; b < n; b++) {\n    inputs[x(b)] = Number((X >> BigInt(b)) & 1n);\n    inputs[y(b)] = Number((Y >> BigInt(b)) & 1n);\n  }\n  return inputs;\n}\n\nfunction applySwaps(gates: Gate[], pairs: Array<[string, string]>): Gate[] {\n  const map = new Map<string, string>();\n  for (const [a, b] of pairs) {\n    map.set(a, b);\n    map.set(b, a);\n  }\n  return gates.map((g) => {\n    const nw = map.get(g.out);\n    return nw === undefined ? g : { ...g, out: nw };\n  });\n}\n\n/**\n * Generate a broken adder: pick 4 disjoint output-wire swaps that keep the\n * circuit acyclic and genuinely break the arithmetic.\n */\