+function combinations<T>(arr: T[], k: number): T[][] {
+  const out: T[][] = [];
+  const pick = (start: number, acc: T[]): void => {
+    if (acc.length === k) {
+      out.push(acc.slice());
+      return;
+    }
+    for (let i = start; i < arr.length; i++) {
+      acc.push(arr[i]);
+      pick(i + 1, acc);
+      acc.pop();
+    }
+  };
+  pick(0, []);
+  return out;
+}
