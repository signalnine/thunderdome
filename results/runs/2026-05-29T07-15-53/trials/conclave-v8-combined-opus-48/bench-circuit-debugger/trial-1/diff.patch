+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+const z = (b: number): string => 'z' + String(b).padStart(2, '0');
+const x = (b: number): string => 'x' + String(b).padStart(2, '0');
+const y = (b: number): string => 'y' + String(b).padStart(2, '0');
+
+/** Deterministic PRNG so tests are reproducible. */
+function makeRng(seed: number): () => number {
+  let s = seed >>> 0;
+  return () => {
+    s = (s * 1664525 + 1013904223) >>> 0;
+    return s / 0x100000000;
+  };
+}
+
+/**
+ * Build a correct ripple-carry adder for `n` input bits with randomized
+ * internal wire names. Returns the gate list.
+ */
+function buildAdder(n: number, rng: () => number): Gate[] {
+  const names = new Set<string>();
+  const fresh = (): string => {
+    for (;;) {
+      let s = '';
+      for (let i = 0; i < 4; i++) {
+        s += String.fromCharCode(97 + Math.floor(rng() * 26));
+      }
+      if (!names.has(s) && !/^[xyz]/.test(s)) {
+        names.add(s);
+        return s;
+      }
+    }
+  };
+
+  const gates: Gate[] = [];
+  // bit 0: half adder
+  gates.push({ op: 'XOR', in1: x(0), in2: y(0), out: z(0) });
+  let carry = fresh();
+  gates.push({ op: 'AND', in1: x(0), in2: y(0), out: carry });
+
+  for (let b = 1; b < n; b++) {
+    const partial = fresh();
+    const gen = fresh();
+    const prop = fresh();
+    gates.push({ op: 'XOR', in1: x(b), in2: y(b), out: partial });
+    gates.push({ op: 'XOR', in1: partial, in2: carry, out: z(b) });
+    gates.push({ op: 'AND', in1: x(b), in2: y(b), out: gen });
+    gates.push({ op: 'AND', in1: partial, in2: carry, out: prop });
+    const nextCarry = b === n - 1 ? z(n) : fresh();
+    gates.push({ op: 'OR', in1: gen, in2: prop, out: nextCarry });
+    carry = nextCarry;
+  }
+  return gates;
+}
+
+/** True if the circuit topologically sorts (acyclic). */
+function isAcyclic(gates: Gate[]): boolean {
+  const produced = new Set(gates.map((g) => g.out));
+  const known = new Set<string>();
+  for (const g of gates) {
+    for (const w of [g.in1, g.in2]) {
+      if (!produced.has(w)) known.add(w);
+    }
+  }
+  let pending = gates.slice();
+  for (;;) {
+    const next: Gate[] = [];
+    let progressed = false;
+    for (const g of pending) {
+      if (known.has(g.in1) && known.has(g.in2)) {
+        known.add(g.out);
+        progressed = true;
+      } else {
+        next.push(g);
+      }
+    }
+    pending = next;
+    if (pending.length === 0) return true;
+    if (!progressed) return false;
+  }
+}
+
+/** Read the Z register from a simulation result. */
+function readZ(values: Record<string, number>, n: number): bigint {
+  let v = 0n;
+  for (let b = 0; b <= n; b++) {
+    if (values[z(b)]) v |= 1n << BigInt(b);
+  }
+  return v;
+}
+
+function setInputs(n: number, X: bigint, Y: bigint): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  for (let b = 0; b < n; b++) {
+    inputs[x(b)] = Number((X >> BigInt(b)) & 1n);
+    inputs[y(b)] = Number((Y >> BigInt(b)) & 1n);
+  }
+  return inputs;
+}
+
+function applySwaps(gates: Gate[], pairs: Array<[string, string]>): Gate[] {
+  const map = new Map<string, string>();
+  for (const [a, b] of pairs) {
+    map.set(a, b);
+    map.set(b, a);
+  }
+  return gates.map((g) => {
+    const nw = map.get(g.out);
+    return nw === undefined ? g : { ...g, out: nw };
+  });
+}
+
+/**
+ * Generate a broken adder: pick 4 disjoint output-wire swaps that keep the
+ * circuit acyclic and genuinely break the arithmetic.
+ */
+function makeBroken(
+  n: number,
+  rng: () => number,
+): { gates: Gate[]; swapped: string[] } {
+  const correct = buildAdder(n, rng);
+  const allOuts = correct.map((g) => g.out);
+
+  for (let attempt = 0; attempt < 500; attempt++) {
+    const pool = allOuts.slice();
+    // shuffle
+    for (let i = pool.length - 1; i > 0; i--) {
+      const j = Math.floor(rng() * (i + 1));
+      [pool[i], pool[j]] = [pool[j], pool[i]];
+    }
+    const pairs: Array<[string, string]> = [];
+    for (let i = 0; i < 4; i++) {
+      pairs.push([pool[2 * i], pool[2 * i + 1]]);
+    }
+    const broken = applySwaps(correct, pairs);
+    if (!isAcyclic(broken)) continue;
+
+    // Must actually be broken on at least one vector.
+    let broke = false;
+    for (let t = 0; t < 20 && !broke; t++) {
+      const X = BigInt(Math.floor(rng() * 2 ** 30));
+      const Y = BigInt(Math.floor(rng() * 2 ** 30));
+      const got = readZ(simulate(broken, setInputs(n, X, Y)), n);
+      if (got !== X + Y) broke = true;
+    }
+    if (!broke) continue;
+
+    const swapped = pairs.flat().sort();
+    return { gates: broken, swapped };
+  }
+  throw new Error('could not generate a broken adder');
+}
+
+// ---------------------------------------------------------------------------
+// simulate
+// ---------------------------------------------------------------------------
+
+describe('simulate', () => {
+  it('echoes input wires', () => {
+    const r = simulate([], { a: 1, b: 0 });
+    expect(r.a).toBe(1);
+    expect(r.b).toBe(0);
+  });
+
+  it('AND truth table', () => {
+    const g: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'o' }];
+    expect(simulate(g, { a: 0, b: 0 }).o).toBe(0);
+    expect(simulate(g, { a: 0, b: 1 }).o).toBe(0);
+    expect(simulate(g, { a: 1, b: 0 }).o).toBe(0);
+    expect(simulate(g, { a: 1, b: 1 }).o).toBe(1);
+  });
+
+  it('OR truth table', () => {
+    const g: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'o' }];
+    expect(simulate(g, { a: 0, b: 0 }).o).toBe(0);
+    expect(simulate(g, { a: 0, b: 1 }).o).toBe(1);
+    expect(simulate(g, { a: 1, b: 0 }).o).toBe(1);
+    expect(simulate(g, { a: 1, b: 1 }).o).toBe(1);
+  });
+
+  it('XOR truth table', () => {
+    const g: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'o' }];
+    expect(simulate(g, { a: 0, b: 0 }).o).toBe(0);
+    expect(simulate(g, { a: 0, b: 1 }).o).toBe(1);
+    expect(simulate(g, { a: 1, b: 0 }).o).toBe(1);
+    expect(simulate(g, { a: 1, b: 1 }).o).toBe(0);
+  });
+
+  it('resolves chained gates regardless of array order', () => {
+    // o = (a AND b) OR c
+    const gates: Gate[] = [
+      { op: 'OR', in1: 't', in2: 'c', out: 'o' },
+      { op: 'AND', in1: 'a', in2: 'b', out: 't' },
+    ];
+    expect(simulate(gates, { a: 1, b: 1, c: 0 }).o).toBe(1);
+    expect(simulate(gates, { a: 1, b: 0, c: 0 }).o).toBe(0);
+    expect(simulate(gates, { a: 0, b: 0, c: 1 }).o).toBe(1);
+  });
+
+  it('returns every wire in the circuit', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 't' },
+      { op: 'XOR', in1: 't', in2: 'c', out: 'o' },
+    ];
+    const r = simulate(gates, { a: 1, b: 1, c: 1 });
+    expect(Object.keys(r).sort()).toEqual(['a', 'b', 'c', 'o', 't']);
+  });
+
+  it('computes a 4-bit adder for many values', () => {
+    const rng = makeRng(1);
+    const gates = buildAdder(4, rng);
+    for (let X = 0; X < 16; X++) {
+      for (let Y = 0; Y < 16; Y++) {
+        const got = readZ(simulate(gates, setInputs(4, BigInt(X), BigInt(Y))), 4);
+        expect(got).toBe(BigInt(X + Y));
+      }
+    }
+  });
+
+  it('handles gates given in reverse (non-topological) order', () => {
+    const rng = makeRng(2);
+    const gates = buildAdder(6, rng).reverse();
+    const got = readZ(simulate(gates, setInputs(6, 45n, 18n)), 6);
+    expect(got).toBe(63n);
+  });
+});
+
+// ---------------------------------------------------------------------------
+// findSwappedWires
+// ---------------------------------------------------------------------------
+
+describe('findSwappedWires', () => {
+  it('finds a hand-built single swap-pair example (4-bit)', () => {
+    // Correct 4-bit adder from the spec, with z01 <-> a01 swapped, plus three
+    // more swaps to make exactly 4 pairs.
+    const rng = makeRng(7);
+    const correct = buildAdder(4, rng);
+    // pick two swaps among role-distinct wires that keep things acyclic
+    const { gates, swapped } = makeBroken(4, makeRng(99));
