+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string; // input wire name
+  in2: string; // input wire name
+  out: string; // output wire name
+}
+
+/**
+ * Simulate a combinational logic circuit.
+ *
+ * Gates are processed in dependency order: a gate fires only once both of its
+ * input wires have known values. The circuit is assumed acyclic. The returned
+ * map contains every wire that appears in the circuit (inputs, intermediates
+ * and outputs).
+ */
+export function simulate(
+  gates: Gate[],
+  inputs: Record<string, number>,
+): Record<string, number> {
+  const values: Record<string, number> = { ...inputs };
+
+  // For each gate, how many of its inputs are still unknown.
+  const remaining = new Array<number>(gates.length);
+  // wire name -> indices of gates that consume it as an input.
+  const consumers = new Map<string, number[]>();
+
+  const addConsumer = (wire: string, gateIdx: number): void => {
+    let list = consumers.get(wire);
+    if (list === undefined) {
+      list = [];
+      consumers.set(wire, list);
+    }
+    list.push(gateIdx);
+  };
+
+  const ready: number[] = [];
+
+  for (let i = 0; i < gates.length; i++) {
+    const g = gates[i];
+    let missing = 0;
+    if (!(g.in1 in values)) {
+      missing++;
+      addConsumer(g.in1, i);
+    }
+    if (!(g.in2 in values)) {
+      missing++;
+      addConsumer(g.in2, i);
+    }
+    remaining[i] = missing;
+    if (missing === 0) ready.push(i);
+  }
+
+  const apply = (op: Gate['op'], a: number, b: number): number => {
+    switch (op) {
+      case 'AND':
+        return a & b;
+      case 'OR':
+        return a | b;
+      case 'XOR':
+        return a ^ b;
+    }
+  };
+
+  while (ready.length > 0) {
+    const idx = ready.pop() as number;
+    const g = gates[idx];
+    const out = apply(g.op, values[g.in1], values[g.in2]);
+
+    if (!(g.out in values)) {
+      values[g.out] = out;
+      // Newly-known wire may unblock gates waiting on it.
+      const waiting = consumers.get(g.out);
+      if (waiting !== undefined) {
+        for (const w of waiting) {
+          remaining[w]--;
+          if (remaining[w] === 0) ready.push(w);
+        }
+      }
+    } else {
+      values[g.out] = out;
+    }
+  }
+
+  return values;
+}
+
+// ---------------------------------------------------------------------------
+// Wire-swap debugging
+// ---------------------------------------------------------------------------
+
+const isX = (w: string): boolean => /^x\d+$/.test(w);
+const isY = (w: string): boolean => /^y\d+$/.test(w);
+const isZ = (w: string): boolean => /^z\d+$/.test(w);
+const isInput = (w: string): boolean => isX(w) || isY(w);
+const bitOf = (w: string): number => parseInt(w.slice(1), 10);
+
+/**
+ * The gates form a ripple-carry binary adder (X + Y = Z) in which exactly four
+ * pairs of gate output wires have been swapped. Identify the eight wires that
+ * are involved in a swap and return them sorted.
+ *
+ * Approach:
+ *  1. Use the structural rules of a ripple-carry adder to flag suspicious gate
+ *     outputs (cheap, no enumeration).
+ *  2. Confirm the result by searching for a partition of the suspects into four
+ *     swap pairs that turns the circuit back into a correct adder, verified by
+ *     simulation on targeted + random test vectors. This guards against the
+ *     structural rules over- or under-firing.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  const topZ = highestZ(gates);
+
+  const suspects = structuralSuspects(gates, topZ);
+
+  // Try to validate a 4-swap solution drawn from the suspect pool.
+  const solution = findValidSwapSet(gates, suspects, topZ);
+  if (solution !== null) {
+    return solution.slice().sort();
+  }
+
+  // Fallback: structural rules alone (should already be the answer in
+  // practice). Return up to 8 sorted suspects.
+  return suspects.slice().sort();
+}
+
+function highestZ(gates: Gate[]): string {
+  let best = '';
+  let bestN = -1;
+  for (const g of gates) {
+    if (isZ(g.out)) {
+      const n = bitOf(g.out);
+      if (n > bestN) {
+        bestN = n;
+        best = g.out;
+      }
+    }
+  }
+  return best;
+}
+
+/**
+ * Flag gate outputs that violate ripple-carry adder structure.
+ * Only the gate *inputs* are trustworthy (only outputs were swapped), so rules
+ * keyed on input wires reliably classify each gate's intended role.
+ */
+function structuralSuspects(gates: Gate[], topZ: string): string[] {
+  // For each wire, the set of operations of gates that consume it as input.
+  const consumerOps = new Map<string, Set<Gate['op']>>();
+  for (const g of gates) {
+    for (const w of [g.in1, g.in2]) {
+      let s = consumerOps.get(w);
+      if (s === undefined) {
+        s = new Set();
+        consumerOps.set(w, s);
+      }
+      s.add(g.op);
+    }
+  }
