+  it('handles a 45-bit circuit under 5 seconds', () => {
+    const { gates, swapped } = makeBroken(45, makeRng(2024));
+    const start = Date.now();
+    const found = findSwappedWires(gates);
+    const elapsed = Date.now() - start;
+    expect(found).toEqual(swapped);
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
