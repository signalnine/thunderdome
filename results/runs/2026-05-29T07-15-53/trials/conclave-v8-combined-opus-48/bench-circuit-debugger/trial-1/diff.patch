+        // MSB is the final carry: must come from an OR.
+        if (op !== 'OR') wrong.add(out);
+      } else if (op !== 'XOR') {
+        // Every other z bit is a sum: must come from an XOR.
+        wrong.add(out);
+      }
+    }
