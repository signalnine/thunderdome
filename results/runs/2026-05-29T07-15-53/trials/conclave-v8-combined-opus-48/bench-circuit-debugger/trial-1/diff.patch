+  it('returns exactly 8 sorted wires', () => {
+    const { gates } = makeBroken(8, makeRng(3));
+    const found = findSwappedWires(gates);
+    expect(found.length).toBe(8);
+    expect(found).toEqual(found.slice().sort());
+  });
+
+  it('repaired circuit becomes a correct adder', () => {
+    const n = 12;
