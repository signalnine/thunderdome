+  it('recovers swaps across many random seeds', () => {
+    for (let seed = 1; seed <= 25; seed++) {
+      const n = 6 + (seed % 10);
+      const { gates, swapped } = makeBroken(n, makeRng(seed * 17 + 1));
+      const found = findSwappedWires(gates);
+      expect(found, `seed ${seed} (n=${n})`).toEqual(swapped);
+    }
+  });
