+
+/**
+ * Search the suspect pool for four output-wire swaps that repair the adder.
+ * Returns the eight involved wires, or null if none validates.
+ */
+function findValidSwapSet(
+  gates: Gate[],
+  suspects: string[],
+  topZ: string,
+): string[] | null {
+  const oracle = makeOracle(gates, topZ);
+
+  // Choose the eight wires (if more than eight suspects, try each 8-subset).
+  const pools: string[][] =
+    suspects.length === 8 ? [suspects] : combinations(suspects, 8);
+
+  for (const pool of pools) {
+    const result = matchPairs(gates, pool, [], oracle);
+    if (result !== null) return result;
+  }
+  return null;
+}
+
+/**
+ * Recursively partition `pool` (a list of wires) into swap pairs and test each
+ * complete partition with the oracle.
+ */
+function matchPairs(
+  gates: Gate[],
+  pool: string[],
+  chosen: Array<[string, string]>,
+  oracle: (gs: Gate[]) => boolean,
+): string[] | null {
+  if (pool.length === 0) {
+    if (oracle(applySwaps(gates, chosen))) {
+      return chosen.flat();
+    }
+    return null;
+  }
+  const [first, ...rest] = pool;
+  for (let i = 0; i < rest.length; i++) {
+    const partner = rest[i];
+    const remaining = rest.slice(0, i).concat(rest.slice(i + 1));
+    const res = matchPairs(
+      gates,
+      remaining,
+      [...chosen, [first, partner]],
+      oracle,
+    );
+    if (res !== null) return res;
+  }
+  return null;
+}
