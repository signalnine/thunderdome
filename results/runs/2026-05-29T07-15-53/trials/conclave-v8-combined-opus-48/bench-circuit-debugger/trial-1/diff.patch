+    if (op === 'XOR') {
+      if (inputsAreXY) {
+        // Half-adder / partial-sum XOR.
+        if (isBit0) {
+          // x00 XOR y00 must drive z00.
+          if (out !== 'z00') wrong.add(out);
+        } else {
+          // Partial sum must be internal and feed the next-stage XOR (and AND).
+          if (isZ(out)) wrong.add(out);
+          else if (!feeds(out, 'XOR')) wrong.add(out);
+        }
+      } else {
+        // Sum XOR (partial XOR carry-in): must drive a z bit.
+        if (!isZ(out)) wrong.add(out);
+      }
+    } else if (op === 'AND') {
+      if (!isBit0) {
+        // Generate / propagate AND: its output must feed an OR (carry merge).
+        if (!feeds(out, 'OR') && out !== topZ) wrong.add(out);
+        if (isZ(out)) wrong.add(out);
+      }
+    } else {
+      // OR: produces a carry. It either is the MSB output or feeds the next
+      // stage's sum XOR and propagate AND.
+      if (isZ(out) && out !== topZ) wrong.add(out);
+    }
+  }
