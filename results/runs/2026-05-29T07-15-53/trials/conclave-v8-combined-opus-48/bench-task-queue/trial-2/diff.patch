--- /dev/null
+++ b/src/task.ts
@@ -0,0 +1,61 @@
+import type { Task, TaskStatus } from './types.js';
+
+/**
+ * Internal task representation. Implements the public `Task` interface and adds
+ * bookkeeping fields used by the scheduler. Instances are handed back to callers
+ * typed as `Task`, so status changes are observable on the returned reference.
+ */
+export class InternalTask<T = unknown> implements Task<T> {
+  readonly id: string;
+  queue: string;
+  payload: T;
+  status: TaskStatus = 'pending';
+  priority: number;
+  readonly createdAt: number;
+  availableAt: number;
+  attempts = 0;
+  maxRetries: number;
+  backoffBase: number;
+  dependencies: string[];
+  progress = 0;
+  progressMessage?: string;
+  error?: string;
+  result?: unknown;
+
+  /** Monotonic sequence number for stable FIFO ordering. */
+  readonly seq: number;
+  /** Absolute time the task becomes available, or undefined if never delayed. */
+  delayUntil?: number;
+  /** Once cancelled the task must never be retried. */
+  cancelled = false;
+
+  constructor(params: {
+    id: string;
+    queue: string;
+    payload: T;
+    priority: number;
+    createdAt: number;
+    maxRetries: number;
+    backoffBase: number;
+    dependencies: string[];
+    seq: number;
+    delayUntil?: number;
+  }) {
+    this.id = params.id;
+    this.queue = params.queue;
+    this.payload = params.payload;
+    this.priority = params.priority;
+    this.createdAt = params.createdAt;
+    this.maxRetries = params.maxRetries;
+    this.backoffBase = params.backoffBase;
+    this.dependencies = params.dependencies;
+    this.seq = params.seq;
+    this.delayUntil = params.delayUntil;
+    this.availableAt = params.delayUntil ?? params.createdAt;
+  }
+
+  /** Sort key for availability: non-delayed tasks sort before delayed ones. */
+  get sortKey(): number {
+    return this.delayUntil ?? 0;
+  }
+}
