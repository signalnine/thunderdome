+++ b/tests/clock.ts
@@ -0,0 +1,13 @@
+/** A controllable clock for deterministic time-based tests. */
+export function makeClock(start = 1_000_000) {
+  let t = start;
+  return {
+    now: () => t,
+    advance: (ms: number) => {
+      t += ms;
+    },
+    set: (v: number) => {
+      t = v;
+    },
+  };
+}
