+import type { Handler, Middleware } from './types.js';
+import type { InternalTask } from './task.js';
+
+/**
+ * State for a single named queue: the waiting tasks, its dead-letter queue,
+ * concurrency configuration and the middleware/handler pipeline.
+ */
+export class NamedQueue {
+  readonly name: string;
+  /** Tasks waiting to be processed (pending / delayed / blocked). */
+  waiting: InternalTask[] = [];
+  /** Permanently failed tasks. */
+  deadLetters: InternalTask[] = [];
+  /** Max simultaneous processing tasks. `Infinity` means unlimited. */
+  concurrency = Infinity;
+  /** Middleware pipeline, run in registration order. */
+  middleware: Middleware[] = [];
+  /** Terminal handler invoked after all middleware. */
+  handler?: Handler;
+
+  constructor(name: string) {
+    this.name = name;
+  }
+}
diff --git a/src/task-queue.ts b/src/task-queue.ts
new file mode 100644
index 0000000..3998961
--- /dev/null
+++ b/src/task-queue.ts
@@ -0,0 +1,718 @@
+import { randomUUID } from 'node:crypto';
+import { InternalTask } from './task.js';
+import { NamedQueue } from './named-queue.js';
+import { nextOccurrence, validateCron } from './cron.js';
+import type {
+  AddOptions,
+  DependencyStatus,
+  Handler,
+  Middleware,
+  Next,
+  Progress,
+  ProgressListener,
+  Schedule,
+  ShutdownCallback,
+  ShutdownOptions,
+  ShutdownSummary,
+  Task,
+  TaskQueueOptions,
+} from './types.js';
+
+const DEFAULT_QUEUE = 'default';
+const DEFAULT_PRIORITY = 5;
+const DEFAULT_MAX_RETRIES = 3;
+const DEFAULT_BACKOFF_BASE = 1000;
+
+/**
+ * An entirely in-memory task queue system supporting named queues, priority,
+ * delays, retries with backoff, dead-letter queues, dependencies, concurrency
+ * limits, progress/cancellation, recurring schedules, middleware pipelines and
+ * graceful shutdown.
+ */
+export class TaskQueue {
+  private readonly queues = new Map<string, NamedQueue>();
+  private readonly tasks = new Map<string, InternalTask>();
+  private readonly schedules = new Map<string, Schedule>();
+  private readonly progressListeners = new Map<string, Set<ProgressListener>>();
+  private readonly shutdownCallbacks: ShutdownCallback[] = [];
+
+  private readonly clock: () => number;
+  private seqCounter = 0;
+
+  private shuttingDown = false;
+  private shutdownPromise?: Promise<ShutdownSummary>;
+
+  constructor(options: TaskQueueOptions = {}) {
+    this.clock = options.now ?? Date.now;
+  }
+
+  private now(): number {
+    return this.clock();
+  }
+
+  // ---------------------------------------------------------------------------
+  // Queue helpers
+  // ---------------------------------------------------------------------------
+
+  private getOrCreateQueue(name: string): NamedQueue {
+    let q = this.queues.get(name);
+    if (!q) {
+      q = new NamedQueue(name);
+      this.queues.set(name, q);
+    }
+    return q;
+  }
+
+  /** List the names of all queues that exist. */
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 1-7: adding tasks
+  // ---------------------------------------------------------------------------
+
+  /** Add a task with the given payload. Returns the created task. */
+  add<T = unknown>(payload: T, options: AddOptions = {}): Task<T> {
+    if (this.shuttingDown) {
+      throw new Error('Cannot add tasks: queue is shutting down');
+    }
+
+    const priority = options.priority ?? DEFAULT_PRIORITY;
+    if (!Number.isInteger(priority) || priority < 1 || priority > 10) {
+      throw new Error(`Invalid priority ${priority}: must be an integer 1-10`);
+    }
+
+    const maxRetries = options.maxRetries ?? DEFAULT_MAX_RETRIES;
+    if (!Number.isInteger(maxRetries) || maxRetries < 0) {
+      throw new Error(`Invalid maxRetries ${maxRetries}: must be a non-negative integer`);
+    }
+
+    const backoffBase = options.backoffBase ?? DEFAULT_BACKOFF_BASE;
+    if (!(backoffBase >= 0)) {
+      throw new Error(`Invalid backoffBase ${backoffBase}: must be >= 0`);
+    }
+
+    const queueName = options.queue ?? DEFAULT_QUEUE;
+    const createdAt = this.now();
+
+    const dependencies = options.dependencies ? [...options.dependencies] : [];
+    this.validateDependencies(dependencies);
+
+    const delayUntil = this.computeAvailability(createdAt, options);
+
+    const task = new InternalTask<T>({
+      id: randomUUID(),
+      queue: queueName,
+      payload,
+      priority,
+      createdAt,
+      maxRetries,
+      backoffBase,
+      dependencies,
+      seq: this.seqCounter++,
+      delayUntil,
+    });
+
+    // Detect cycles now that the task has an id.
+    if (this.wouldCreateCycle(task.id, dependencies)) {
+      throw new Error('Circular dependency detected');
+    }
+
+    this.tasks.set(task.id, task);
+    this.getOrCreateQueue(queueName).waiting.push(task);
+    this.refreshStatus(task);
+    return task;
+  }
+
+  private computeAvailability(createdAt: number, options: AddOptions): number | undefined {
+    if (options.delay !== undefined) {
+      if (!(options.delay >= 0)) {
+        throw new Error(`Invalid delay ${options.delay}: must be >= 0`);
+      }
+      return options.delay > 0 ? createdAt + options.delay : undefined;
+    }
+    if (options.runAt !== undefined) {
+      const at = options.runAt instanceof Date ? options.runAt.getTime() : options.runAt;
+      if (Number.isNaN(at)) {
+        throw new Error('Invalid runAt: not a valid time');
+      }
+      return at > createdAt ? at : undefined;
+    }
+    return undefined;
+  }
+
+  private validateDependencies(deps: string[]): void {
+    for (const dep of deps) {
+      if (!this.tasks.has(dep)) {
+        throw new Error(`Dependency "${dep}" does not exist`);
+      }
+    }
+  }
+
+  /**
+   * Detect whether the dependency graph reachable from `newId` (whose edges are
+   * `deps`) contains a cycle, direct or indirect. Uses DFS with a recursion
+   * stack to find back-edges.
+   */
+  private wouldCreateCycle(newId: string, deps: string[]): boolean {
+    const edges = (id: string): string[] =>
+      id === newId ? deps : this.tasks.get(id)?.dependencies ?? [];
+
+    const VISITING = 0;
+    const DONE = 1;
+    const state = new Map<string, number>();
+
+    const dfs = (id: string): boolean => {
+      state.set(id, VISITING);
+      for (const dep of edges(id)) {
+        const s = state.get(dep);
+        if (s === VISITING) {
+          return true; // back-edge: cycle
+        }
+        if (s === undefined && dfs(dep)) {
+          return true;
+        }
+      }
+      state.set(id, DONE);
+      return false;
+    };
+
+    return dfs(newId);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Status / readiness
+  // ---------------------------------------------------------------------------
+
+  private dependenciesSatisfied(task: InternalTask): boolean {
+    return task.dependencies.every((id) => this.tasks.get(id)?.status === 'completed');
+  }
+
+  /** Recompute the waiting-state status (pending / delayed / blocked). */
+  private refreshStatus(task: InternalTask): void {
+    if (
+      task.status === 'processing' ||
+      task.status === 'completed' ||
+      task.status === 'failed' ||
+      task.status === 'cancelled'
+    ) {
+      return;
+    }
+    if (!this.dependenciesSatisfied(task)) {
+      task.status = 'blocked';
+    } else if ((task.delayUntil ?? 0) > this.now()) {
+      task.status = 'delayed';
+    } else {
+      task.status = 'pending';
+    }
+  }
+
+  private isReady(task: InternalTask): boolean {
+    return (
+      (task.delayUntil ?? 0) <= this.now() && this.dependenciesSatisfied(task)
+    );
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 1-4, 8: retrieving tasks
+  // ---------------------------------------------------------------------------
+
+  /**
+   * Retrieve the next available task from a queue and move it to `processing`.
+   * Returns `null` if no task is available or the concurrency limit is reached.
+   */
+  getNext(queueName: string = DEFAULT_QUEUE): Task | null {
+    const q = this.queues.get(queueName);
+    if (!q) {
+      return null;
+    }
+
+    if (this.getActiveCount(queueName) >= q.concurrency) {
+      return null;
+    }
+
+    let best: InternalTask | undefined;
+    for (const task of q.waiting) {
+      this.refreshStatus(task);
+      if (!this.isReady(task)) {
+        continue;
+      }
+      if (best === undefined || this.compare(task, best) < 0) {
+        best = task;
+      }
+    }
+
+    if (!best) {
+      return null;
+    }
+
+    this.removeFromWaiting(q, best);
+    best.status = 'processing';
+    best.attempts += 1;
+    return best;
+  }
+
+  /** Ordering: availability time, then priority, then FIFO sequence. */
+  private compare(a: InternalTask, b: InternalTask): number {
+    if (a.sortKey !== b.sortKey) {
+      return a.sortKey - b.sortKey;
+    }
+    if (a.priority !== b.priority) {
+      return a.priority - b.priority;
+    }
+    return a.seq - b.seq;
+  }
+
+  private removeFromWaiting(q: NamedQueue, task: InternalTask): void {
+    const idx = q.waiting.indexOf(task);
+    if (idx !== -1) {
+      q.waiting.splice(idx, 1);
+    }
+  }
+
+  /** Number of tasks waiting in a queue (pending / delayed / blocked). */
+  size(queueName: string = DEFAULT_QUEUE): number {
+    return this.queues.get(queueName)?.waiting.length ?? 0;
+  }
+
+  /** Look up a task by id. */
+  getTask(id: string): Task | undefined {
+    return this.tasks.get(id);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 5-6: completion, failure, retry, dead-letter
+  // ---------------------------------------------------------------------------
+
+  /** Mark a processing task as completed. */
+  complete(id: string, result?: unknown): Task {
+    const task = this.requireTask(id);
+    if (task.status !== 'processing') {
+      throw new Error(`Task ${id} is not processing (status: ${task.status})`);
+    }
+    task.status = 'completed';
+    task.result = result;
+    task.progress = 100;
+    this.onTaskFinished(task);
+    return task;
+  }
+
+  /** Mark a processing task as failed; retries with backoff if any remain. */
+  fail(id: string, error?: unknown): Task {
+    const task = this.requireTask(id);
+
+    // Cancelled tasks are never retried, even if fail() arrives after cancel().
+    if (task.cancelled || task.status === 'cancelled') {
+      task.status = 'cancelled';
+      return task;
+    }
+
+    if (task.status !== 'processing') {
+      throw new Error(`Task ${id} is not processing (status: ${task.status})`);
+    }
+    task.error = this.toErrorMessage(error);
+
+    const retriesUsed = task.attempts - 1;
+    if (retriesUsed < task.maxRetries) {
+      const delay = task.backoffBase * Math.pow(2, task.attempts - 1);
+      task.delayUntil = this.now() + delay;
+      task.availableAt = task.delayUntil;
+      task.status = 'delayed';
+      this.getOrCreateQueue(task.queue).waiting.push(task);
+      this.refreshStatus(task);
+      return task;
+    }
+
+    // Retries exhausted: fail and move to the dead-letter queue.
+    task.status = 'failed';
+    this.getOrCreateQueue(task.queue).deadLetters.push(task);
+    this.onTaskFinished(task);
+    return task;
+  }
+
+  /** Hook run after a task leaves the processing state for good. */
+  private onTaskFinished(task: InternalTask): void {
+    if (task.status === 'completed') {
+      this.unblockDependents(task.id);
+    }
+  }
+
+  private unblockDependents(completedId: string): void {
+    for (const task of this.tasks.values()) {
+      if (
+        (task.status === 'blocked' || task.status === 'delayed' || task.status === 'pending') &&
+        task.dependencies.includes(completedId)
+      ) {
+        this.refreshStatus(task);
+      }
+    }
+  }
+
+  /** Dead-lettered tasks for a queue. */
+  getDeadLetters(queueName: string = DEFAULT_QUEUE): Task[] {
+    return [...(this.queues.get(queueName)?.deadLetters ?? [])];
+  }
+
+  /** Move a dead-lettered task back to its queue for a fresh round of retries. */
+  retryDeadLetter(id: string): Task {
+    const task = this.requireTask(id);
+    const q = this.queues.get(task.queue);
+    const idx = q?.deadLetters.indexOf(task) ?? -1;
+    if (!q || idx === -1) {
+      throw new Error(`Task ${id} is not in a dead-letter queue`);
+    }
+    q.deadLetters.splice(idx, 1);
+    task.attempts = 0;
+    task.error = undefined;
+    task.delayUntil = undefined;
+    task.availableAt = task.createdAt;
+    task.status = 'pending';
+    q.waiting.push(task);
+    this.refreshStatus(task);
+    return task;
+  }
+
+  /** Clear all dead-lettered tasks for a queue. */
+  clearDeadLetters(queueName: string = DEFAULT_QUEUE): void {
+    const q = this.queues.get(queueName);
+    if (q) {
+      q.deadLetters = [];
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 7: dependency inspection
+  // ---------------------------------------------------------------------------
+
+  /** Report the dependency status of a task. */
+  getDependencyStatus(id: string): DependencyStatus {
+    const task = this.requireTask(id);
+    const completed: string[] = [];
+    const pending: string[] = [];
+    for (const dep of task.dependencies) {
+      if (this.tasks.get(dep)?.status === 'completed') {
+        completed.push(dep);
+      } else {
+        pending.push(dep);
+      }
+    }
+    return {
+      dependencies: [...task.dependencies],
+      completed,
+      pending,
+      satisfied: pending.length === 0,
+    };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 8: concurrency
+  // ---------------------------------------------------------------------------
+
+  /** Set the max simultaneous processing tasks for a queue (Infinity = unlimited). */
+  setConcurrency(queueName: string, limit: number): void {
+    if (!(limit > 0)) {
+      throw new Error(`Invalid concurrency ${limit}: must be > 0`);
+    }
+    this.getOrCreateQueue(queueName).concurrency = limit;
+  }
+
+  /** Query the concurrency limit for a queue. */
+  getConcurrency(queueName: string = DEFAULT_QUEUE): number {
+    return this.queues.get(queueName)?.concurrency ?? Infinity;
+  }
+
+  /** Number of tasks currently processing in a queue. */
+  getActiveCount(queueName: string = DEFAULT_QUEUE): number {
+    let count = 0;
+    for (const task of this.tasks.values()) {
+      if (task.queue === queueName && task.status === 'processing') {
+        count++;
+      }
+    }
+    return count;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 9: progress & cancellation
+  // ---------------------------------------------------------------------------
+
+  /** Report progress (0-100) on a processing task. */
+  updateProgress(id: string, percent: number, message?: string): void {
+    const task = this.requireTask(id);
+    if (task.status !== 'processing') {
+      throw new Error(`Task ${id} is not processing (status: ${task.status})`);
+    }
+    if (!(percent >= 0 && percent <= 100)) {
+      throw new Error(`Invalid progress ${percent}: must be 0-100`);
+    }
+    task.progress = percent;
+    task.progressMessage = message;
+    const listeners = this.progressListeners.get(id);
+    if (listeners) {
+      const snapshot: Progress = { percent, message };
+      for (const listener of listeners) {
+        listener(snapshot, task);
+      }
+    }
+  }
+
+  /** Current progress of a task. */
+  getProgress(id: string): Progress {
+    const task = this.requireTask(id);
+    return { percent: task.progress, message: task.progressMessage };
+  }
+
+  /** Subscribe to progress updates for a task. Returns an unsubscribe function. */
+  onProgress(id: string, listener: ProgressListener): () => void {
+    let listeners = this.progressListeners.get(id);
+    if (!listeners) {
+      listeners = new Set();
+      this.progressListeners.set(id, listeners);
+    }
+    listeners.add(listener);
+    return () => {
+      listeners?.delete(listener);
+    };
+  }
+
+  /** Cancel a pending or processing task. */
+  cancel(id: string): Task {
+    const task = this.requireTask(id);
+    if (task.status === 'processing') {
+      task.cancelled = true;
+      task.status = 'cancelled';
+      return task;
+    }
+    if (task.status === 'pending' || task.status === 'delayed' || task.status === 'blocked') {
+      const q = this.queues.get(task.queue);
+      if (q) {
+        this.removeFromWaiting(q, task);
+      }
+      task.cancelled = true;
+      task.status = 'cancelled';
+      return task;
+    }
+    throw new Error(`Task ${id} cannot be cancelled (status: ${task.status})`);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 10: recurring schedules
+  // ---------------------------------------------------------------------------
+
+  /** Create a recurring schedule. Returns the schedule id. */
+  schedule(cron: string, queue: string, payload: unknown, options: AddOptions = {}): string {
+    validateCron(cron);
+    const id = randomUUID();
+    const schedule: Schedule = {
+      id,
+      cron,
+      queue,
+      payload,
+      options: { ...options, queue },
+      nextRun: nextOccurrence(cron, this.now()),
+    };
+    this.schedules.set(id, schedule);
+    return id;
+  }
+
+  /** Remove a schedule, stopping future occurrences. */
+  removeSchedule(id: string): boolean {
+    return this.schedules.delete(id);
+  }
+
+  /** List all active schedules. */
+  listSchedules(): Schedule[] {
+    return [...this.schedules.values()];
+  }
+
+  /** Evaluate all schedules and enqueue tasks for any that are due. */
+  tick(now: number = this.now()): Task[] {
+    const created: Task[] = [];
+    for (const schedule of this.schedules.values()) {
+      while (schedule.nextRun <= now) {
+        created.push(this.add(schedule.payload, { ...schedule.options }));
+        schedule.nextRun = nextOccurrence(schedule.cron, schedule.nextRun);
+      }
+    }
+    return created;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 11: middleware & handler
+  // ---------------------------------------------------------------------------
+
+  /** Register middleware for a queue (runs in registration order). */
+  use<T = unknown>(queueName: string, middleware: Middleware<T>): void {
+    this.getOrCreateQueue(queueName).middleware.push(middleware as Middleware);
+  }
+
+  /** Register the terminal handler for a queue. */
+  setHandler<T = unknown>(queueName: string, handler: Handler<T>): void {
+    this.getOrCreateQueue(queueName).handler = handler as Handler;
+  }
+
+  /**
+   * Retrieve the next task from a queue and run it through the middleware
+   * pipeline and handler. Completes the task on success, fails it on error.
+   * Returns the processed task, or `null` if no task was available.
+   */
+  async process(queueName: string = DEFAULT_QUEUE): Promise<Task | null> {
+    const task = this.getNext(queueName) as InternalTask | null;
+    if (!task) {
+      return null;
+    }
+    const q = this.getOrCreateQueue(queueName);
+
+    try {
+      let result: unknown;
+
+      const chain = [...q.middleware];
+      const invoke = async (index: number): Promise<void> => {
+        if (task.status !== 'processing') {
+          return; // cancelled mid-pipeline
+        }
+        if (index < chain.length) {
+          // If a middleware never calls next, the rest of the pipeline and the
+          // handler are simply never reached.
+          const next: Next = () => invoke(index + 1);
+          await chain[index](task, next);
+          return;
+        }
+        if (q.handler) {
+          result = await q.handler(task);
+        }
+      };
+
+      await invoke(0);
+
+      // If the task was cancelled during processing, honour that.
+      if (task.status !== 'processing') {
+        return task;
+      }
+      return this.complete(task.id, result);
+    } catch (err) {
+      if (task.status === 'processing') {
+        return this.fail(task.id, err);
+      }
+      return task;
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 12: graceful shutdown
+  // ---------------------------------------------------------------------------
+
+  /** Register a callback to run during shutdown. */
+  onShutdown(callback: ShutdownCallback): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  /** Whether the queue is shutting down or has shut down. */
+  get isShuttingDown(): boolean {
+    return this.shuttingDown;
+  }
+
+  /**
+   * Gracefully shut down: stop accepting tasks, run shutdown callbacks, wait for
+   * processing tasks to finish (up to `timeout` ms), then force-cancel the rest.
+   * Idempotent: repeated calls return the same summary.
+   */
+  shutdown(options: ShutdownOptions = {}): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) {
+      return this.shutdownPromise;
+    }
+    this.shuttingDown = true;
+    this.shutdownPromise = this.runShutdown(options.timeout ?? 30_000);
+    return this.shutdownPromise;
+  }
+
+  private async runShutdown(timeout: number): Promise<ShutdownSummary> {
+    const start = Date.now();
+
+    for (const cb of this.shutdownCallbacks) {
+      await cb();
+    }
+
+    const processingAtStart = this.allProcessingTasks();
+    const tracked = new Set(processingAtStart.map((t) => t.id));
+
+    // Wait for processing tasks to finish, polling until none remain or timeout.
+    if (tracked.size > 0) {
+      await this.waitForDrain(timeout);
+    }
+
+    // Force-cancel anything still processing.
+    let forceCancelled = 0;
+    for (const task of this.allProcessingTasks()) {
+      task.cancelled = true;
+      task.status = 'cancelled';
+      forceCancelled++;
+    }
+
+    // Of the tasks that were processing when shutdown began, count those that
+    // finished naturally (completed) versus those we had to force-cancel above.
+    let completed = 0;
+    for (const id of tracked) {
+      if (this.tasks.get(id)?.status === 'completed') {
+        completed++;
+      }
+    }
+
+    return {
+      completed,
+      forceCancelled,
+      durationMs: Date.now() - start,
+    };
+  }
+
+  private allProcessingTasks(): InternalTask[] {
+    const result: InternalTask[] = [];
+    for (const task of this.tasks.values()) {
+      if (task.status === 'processing') {
+        result.push(task);
+      }
+    }
+    return result;
+  }
+
+  private waitForDrain(timeout: number): Promise<void> {
+    return new Promise((resolve) => {
+      const start = Date.now();
+      const poll = () => {
+        if (this.allProcessingTasks().length === 0) {
+          resolve();
+          return;
+        }
+        if (Date.now() - start >= timeout) {
+          resolve();
+          return;
+        }
+        setTimeout(poll, 5);
+      };
+      poll();
+    });
+  }
+
+  // ---------------------------------------------------------------------------
+  // Internals
+  // ---------------------------------------------------------------------------
+
+  private requireTask(id: string): InternalTask {
+    const task = this.tasks.get(id);
+    if (!task) {
+      throw new Error(`Task ${id} not found`);
+    }
+    return task;
+  }
+
+  private toErrorMessage(error: unknown): string {
+    if (error === undefined) {
+      return 'Task failed';
+    }
+    if (error instanceof Error) {
+      return error.message;
+    }
+    return String(error);
+  }
+}
