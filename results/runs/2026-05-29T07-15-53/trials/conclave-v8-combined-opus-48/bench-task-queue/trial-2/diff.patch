+describe('Phase 12: graceful shutdown', () => {
+  it('rejects new tasks after shutdown', async () => {
+    const q = new TaskQueue();
+    await q.shutdown();
+    expect(() => q.add('x')).toThrow();
+  });
+
+  it('completes immediately with no processing tasks', async () => {
+    const q = new TaskQueue();
+    const summary = await q.shutdown({ timeout: 1000 });
+    expect(summary.forceCancelled).toBe(0);
+    expect(summary.completed).toBe(0);
+    expect(typeof summary.durationMs).toBe('number');
+  });
+
+  it('runs shutdown callbacks', async () => {
+    const q = new TaskQueue();
+    const cb = vi.fn();
+    q.onShutdown(cb);
+    await q.shutdown();
+    expect(cb).toHaveBeenCalledTimes(1);
+  });
+
+  it('waits for processing tasks then summarizes', async () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.getNext();
+    // complete shortly after shutdown begins
+    setTimeout(() => q.complete(t.id), 20);
+    const summary = await q.shutdown({ timeout: 1000 });
+    expect(summary.completed).toBe(1);
+    expect(summary.forceCancelled).toBe(0);
