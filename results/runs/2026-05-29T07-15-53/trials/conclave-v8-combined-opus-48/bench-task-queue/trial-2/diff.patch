es. Scans minute-by-minute (bounded by a day + 1 minute).\n */\nexport function nextOccurrence(expr: string, from: number): number {\n  const spec = parseCron(expr);\n  // Advance to the start of the next minute after `from`.\n  const start = new Date(from);\n  start.setSeconds(0, 0);\n  start.setMinutes(start.getMinutes() + 1);\n\n  const cursor = new Date(start);\n  // A daily schedule needs at most 24h*60m candidate minutes.\n  const maxMinutes = 24 * 60 + 1;\n  for (let i = 0; i < maxMinutes; i++) {\n    if (spec.matches(cursor)) {\n      return cursor.getTime();\n    }\n    cursor.setMinutes(cursor.getMinutes() + 1);\n  }\n  /* istanbul ignore next -- unreachable for supported expressions */\n  throw new Error(`No occurrence found for cron \"${expr}\"`);\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":902,"cache_read_input_tokens":48030,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":902},"output_tokens":68,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"851c8cdb-b578-4a4f-967d-cf0dd3a414da","uuid":"d5f15154-17da-4cc8-a869-e0357b428770","request_id":"req_011CbWUh51xbUcwossn1stKA"}
