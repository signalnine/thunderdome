+import { describe, it, expect, vi } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+import { makeClock } from './clock.js';
+
+describe('Phase 9: progress and cancellation', () => {
+  it('updates and queries progress', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.getNext();
+    q.updateProgress(t.id, 42, 'half-ish');
+    expect(q.getProgress(t.id)).toEqual({ percent: 42, message: 'half-ish' });
+  });
+
+  it('validates progress range', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.getNext();
+    expect(() => q.updateProgress(t.id, -1)).toThrow();
+    expect(() => q.updateProgress(t.id, 101)).toThrow();
+  });
+
+  it('notifies subscribers and supports unsubscribe', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.getNext();
+    const cb = vi.fn();
+    const unsub = q.onProgress(t.id, cb);
+    q.updateProgress(t.id, 10);
+    q.updateProgress(t.id, 20);
+    expect(cb).toHaveBeenCalledTimes(2);
+    expect(cb.mock.calls[1][0]).toEqual({ percent: 20, message: undefined });
+    unsub();
+    q.updateProgress(t.id, 30);
+    expect(cb).toHaveBeenCalledTimes(2);
+  });
+
+  it('cancels a pending task (removed from queue)', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.cancel(t.id);
+    expect(t.status).toBe('cancelled');
+    expect(q.getNext()).toBeNull();
+  });
+
+  it('cancels a processing task', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.getNext();
+    q.cancel(t.id);
+    expect(q.getTask(t.id)?.status).toBe('cancelled');
+  });
+
+  it('cancelled processing task is never retried', () => {
+    const q = new TaskQueue();
+    const t = q.add('x', { maxRetries: 5, backoffBase: 1 });
+    q.getNext();
+    q.cancel(t.id);
+    q.fail(t.id);
+    expect(q.getTask(t.id)?.status).toBe('cancelled');
+    expect(q.getNext()).toBeNull();
+  });
+});
+
+describe('Phase 10: recurring tasks', () => {
+  it('enqueues tasks for due schedules on tick', () => {
+    const clock = makeClock(0);
+    const q = new TaskQueue({ now: clock.now });
+    q.schedule('*/5 * * * *', 'jobs', { kind: 'cleanup' });
+    // nothing due yet (start is at minute 0; next is minute 5)
+    expect(q.tick()).toHaveLength(0);
+    clock.set(5 * 60 * 1000);
+    const created = q.tick();
+    expect(created).toHaveLength(1);
+    expect(created[0].queue).toBe('jobs');
+    expect(created[0].payload).toEqual({ kind: 'cleanup' });
+  });
+
+  it('lists and removes schedules', () => {
+    const clock = makeClock(0);
+    const q = new TaskQueue({ now: clock.now });
+    const id = q.schedule('0 * * * *', 'jobs', {});
+    expect(q.listSchedules()).toHaveLength(1);
+    expect(q.removeSchedule(id)).toBe(true);
+    expect(q.listSchedules()).toHaveLength(0);
+  });
+
+  it('removed schedule produces no occurrences', () => {
+    const clock = makeClock(0);
+    const q = new TaskQueue({ now: clock.now });
+    const id = q.schedule('*/1 * * * *', 'jobs', {});
+    q.removeSchedule(id);
+    clock.set(10 * 60 * 1000);
+    expect(q.tick()).toHaveLength(0);
+  });
+
+  it('enqueued recurring tasks behave like normal tasks', () => {
+    const clock = makeClock(0);
+    const q = new TaskQueue({ now: clock.now });
+    q.schedule('0 0 * * *', 'jobs', { daily: true });
+    clock.set(24 * 60 * 60 * 1000); // next midnight
+    q.tick();
+    expect(q.size('jobs')).toBe(1);
+    const t = q.getNext('jobs');
+    expect(t?.payload).toEqual({ daily: true });
+  });
+
+  it('rejects unsupported cron expressions', () => {
+    const q = new TaskQueue();
+    expect(() => q.schedule('bogus', 'jobs', {})).toThrow();
+  });
+});
+
+describe('Phase 11: middleware pipeline', () => {
+  it('runs middleware in order then handler', async () => {
+    const q = new TaskQueue();
+    const order: string[] = [];
+    q.use('a', async (_t, next) => {
+      order.push('mw1');
+      await next();
+    });
+    q.use('a', async (_t, next) => {
+      order.push('mw2');
+      await next();
+    });
+    q.setHandler('a', () => {
+      order.push('handler');
+      return 'done';
+    });
+    const t = q.add('x', { queue: 'a' });
+    const processed = await q.process('a');
+    expect(order).toEqual(['mw1', 'mw2', 'handler']);
+    expect(processed?.status).toBe('completed');
+    expect(q.getTask(t.id)?.result).toBe('done');
+  });
+
+  it('skips handler when next is not called', async () => {
+    const q = new TaskQueue();
+    const handler = vi.fn();
+    q.use('a', () => {
+      /* does not call next */
+    });
+    q.setHandler('a', handler);
+    q.add('x', { queue: 'a' });
+    await q.process('a');
+    expect(handler).not.toHaveBeenCalled();
+  });
+
+  it('middleware can mutate the task payload', async () => {
+    const q = new TaskQueue();
+    q.use('a', async (task, next) => {
+      (task.payload as Record<string, unknown>).touched = true;
+      await next();
+    });
+    let seen: unknown;
+    q.setHandler('a', (task) => {
+      seen = task.payload;
+    });
+    q.add({ touched: false }, { queue: 'a' });
+    await q.process('a');
+    expect(seen).toEqual({ touched: true });
+  });
+
+  it('middleware throw fails the task (with retry)', async () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    q.use('a', () => {
+      throw new Error('mw failure');
+    });
+    q.setHandler('a', () => undefined);
+    const t = q.add('x', { queue: 'a', backoffBase: 10 });
+    await q.process('a');
+    expect(q.getTask(t.id)?.error).toBe('mw failure');
+    // retried -> delayed
+    expect(q.getTask(t.id)?.status).toBe('delayed');
+  });
+
+  it('each queue has independent middleware', async () => {
+    const q = new TaskQueue();
+    const aSpy = vi.fn(async (_t: unknown, next: () => Promise<void>) => {
+      await next();
+    });
+    q.use('a', aSpy);
+    q.setHandler('a', () => undefined);
+    q.setHandler('b', () => undefined);
+    q.add('x', { queue: 'b' });
+    await q.process('b');
+    expect(aSpy).not.toHaveBeenCalled();
+  });
+});
