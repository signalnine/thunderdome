@@ -0,0 +1,192 @@
+import { describe, it, expect } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+import { makeClock } from './clock.js';
+
+describe('Phase 1: basic FIFO queue', () => {
+  it('add returns a task with id, pending status and createdAt', () => {
+    const q = new TaskQueue();
+    const t = q.add({ hello: 'world' });
+    expect(typeof t.id).toBe('string');
+    expect(t.status).toBe('pending');
+    expect(typeof t.createdAt).toBe('number');
+    expect(t.payload).toEqual({ hello: 'world' });
+  });
+
+  it('produces unique ids', () => {
+    const q = new TaskQueue();
+    const a = q.add(1);
+    const b = q.add(2);
+    expect(a.id).not.toBe(b.id);
+  });
+
+  it('getNext returns oldest pending task and marks it processing', () => {
+    const q = new TaskQueue();
+    const a = q.add('a');
+    q.add('b');
+    const next = q.getNext();
+    expect(next?.id).toBe(a.id);
+    expect(next?.status).toBe('processing');
+  });
+
+  it('getNext returns null when empty', () => {
+    const q = new TaskQueue();
+    expect(q.getNext()).toBeNull();
+  });
+
+  it('returns tasks in FIFO order', () => {
+    const q = new TaskQueue();
+    q.add('a');
+    q.add('b');
+    q.add('c');
+    expect(q.getNext()?.payload).toBe('a');
+    expect(q.getNext()?.payload).toBe('b');
+    expect(q.getNext()?.payload).toBe('c');
+    expect(q.getNext()).toBeNull();
+  });
+
+  it('size reports waiting count', () => {
+    const q = new TaskQueue();
+    expect(q.size()).toBe(0);
+    q.add('a');
+    q.add('b');
+    expect(q.size()).toBe(2);
+    q.getNext();
+    expect(q.size()).toBe(1);
+  });
+});
+
+describe('Phase 2: named queues', () => {
+  it('routes tasks to named queues, default when omitted', () => {
+    const q = new TaskQueue();
+    q.add('d');
+    q.add('x', { queue: 'emails' });
+    expect(q.size()).toBe(1);
+    expect(q.size('emails')).toBe(1);
+  });
+
+  it('queues are independent', () => {
+    const q = new TaskQueue();
+    q.add('1', { queue: 'a' });
+    q.add('2', { queue: 'a' });
+    q.add('3', { queue: 'b' });
+    expect(q.size('a')).toBe(2);
+    expect(q.size('b')).toBe(1);
+    q.getNext('a');
+    expect(q.size('a')).toBe(1);
+    expect(q.size('b')).toBe(1);
+  });
+
+  it('getNext pulls only from the named queue', () => {
+    const q = new TaskQueue();
+    q.add('a-task', { queue: 'a' });
+    expect(q.getNext('b')).toBeNull();
+    expect(q.getNext('a')?.payload).toBe('a-task');
+  });
+
+  it('listQueues lists existing queues', () => {
+    const q = new TaskQueue();
+    q.add('1', { queue: 'a' });
+    q.add('2', { queue: 'b' });
+    expect(q.listQueues().sort()).toEqual(['a', 'b']);
+  });
+
+  it('non-existent queue returns null', () => {
+    const q = new TaskQueue();
+    expect(q.getNext('nope')).toBeNull();
+  });
+});
+
+describe('Phase 3: priority', () => {
+  it('defaults to priority 5 and exposes it', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    expect(t.priority).toBe(5);
+  });
+
+  it('higher priority (lower number) returned first', () => {
+    const q = new TaskQueue();
+    q.add('low', { priority: 8 });
+    q.add('high', { priority: 1 });
+    q.add('mid', { priority: 5 });
+    expect(q.getNext()?.payload).toBe('high');
+    expect(q.getNext()?.payload).toBe('mid');
+    expect(q.getNext()?.payload).toBe('low');
+  });
+
+  it('equal priority preserves FIFO', () => {
+    const q = new TaskQueue();
+    q.add('first', { priority: 3 });
+    q.add('second', { priority: 3 });
+    expect(q.getNext()?.payload).toBe('first');
+    expect(q.getNext()?.payload).toBe('second');
+  });
+
+  it('rejects invalid priorities', () => {
+    const q = new TaskQueue();
+    expect(() => q.add('x', { priority: 0 })).toThrow();
+    expect(() => q.add('x', { priority: 11 })).toThrow();
+  });
+
+  it('priority is per-queue', () => {
+    const q = new TaskQueue();
+    q.add('a-low', { queue: 'a', priority: 9 });
+    q.add('b-high', { queue: 'b', priority: 1 });
+    expect(q.getNext('a')?.payload).toBe('a-low');
+  });
+});
+
+describe('Phase 4: delayed and scheduled tasks', () => {
+  it('delayed task is not returned before availability', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const t = q.add('later', { delay: 1000 });
+    expect(t.status).toBe('delayed');
+    expect(q.getNext()).toBeNull();
+    clock.advance(1000);
+    expect(q.getNext()?.payload).toBe('later');
+  });
+
+  it('runAt sets absolute availability', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    q.add('at', { runAt: clock.now() + 500 });
+    expect(q.getNext()).toBeNull();
+    clock.advance(500);
+    expect(q.getNext()?.payload).toBe('at');
+  });
+
+  it('non-delayed preferred over not-yet-available delayed', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    q.add('delayed', { delay: 1000, priority: 1 });
+    q.add('now', { priority: 5 });
+    expect(q.getNext()?.payload).toBe('now');
+  });
+
+  it('availableAt is exposed', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const t = q.add('x', { delay: 200 });
+    expect(t.availableAt).toBe(clock.now() + 200);
+  });
+
+  it('delayed tasks ordered by availableAt then priority then FIFO', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    q.add('second', { delay: 200, priority: 1 });
+    q.add('first', { delay: 100, priority: 9 });
+    clock.advance(1000);
+    // first becomes available earlier, so wins despite lower priority
+    expect(q.getNext()?.payload).toBe('first');
+    expect(q.getNext()?.payload).toBe('second');
+  });
+
+  it('delays work per named queue', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    q.add('x', { queue: 'a', delay: 100 });
+    expect(q.getNext('a')).toBeNull();
+    clock.advance(100);
+    expect(q.getNext('a')?.payload).toBe('x');
+  });
+});
diff --git a/tests/phase5-8.test.ts b/tests/phase5-8.test.ts
new file mode 100644
index 0000000..faa8add
--- /dev/null
+++ b/tests/phase5-8.test.ts
@@ -0,0 +1,252 @@
+import { describe, it, expect } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+import { makeClock } from './clock.js';
+
+describe('Phase 5: retry with backoff', () => {
+  it('complete marks a processing task completed', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.getNext();
+    q.complete(t.id);
+    expect(q.getTask(t.id)?.status).toBe('completed');
+  });
+
+  it('fail re-queues with exponential backoff delay', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const t = q.add('x', { backoffBase: 1000 });
+    q.getNext(); // attempt 1
+    q.fail(t.id);
+    // backoff = 1000 * 2^0 = 1000
+    expect(q.getNext()).toBeNull();
+    expect(q.getTask(t.id)?.status).toBe('delayed');
+    clock.advance(1000);
+    expect(q.getNext()?.id).toBe(t.id); // attempt 2
+    q.fail(t.id);
+    // backoff = 1000 * 2^1 = 2000
+    clock.advance(1999);
+    expect(q.getNext()).toBeNull();
+    clock.advance(1);
+    expect(q.getNext()?.id).toBe(t.id);
+  });
+
+  it('attempts increments each retrieval', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const t = q.add('x', { backoffBase: 10 });
+    q.getNext();
+    expect(q.getTask(t.id)?.attempts).toBe(1);
+    q.fail(t.id);
+    clock.advance(10);
+    q.getNext();
+    expect(q.getTask(t.id)?.attempts).toBe(2);
+  });
+
+  it('keeps queue and priority across retries', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const t = q.add('x', { queue: 'a', priority: 2, backoffBase: 10 });
+    q.getNext('a');
+    q.fail(t.id);
+    clock.advance(10);
+    const again = q.getNext('a');
+    expect(again?.queue).toBe('a');
+    expect(again?.priority).toBe(2);
+  });
+
+  it('ends failed after retries exhausted', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const t = q.add('x', { maxRetries: 2, backoffBase: 10 });
+    // attempt 1
+    q.getNext();
+    q.fail(t.id);
+    clock.advance(10);
+    // attempt 2
+    q.getNext();
+    q.fail(t.id);
+    clock.advance(20);
+    // attempt 3 (last)
+    q.getNext();
+    q.fail(t.id);
+    expect(q.getTask(t.id)?.status).toBe('failed');
+  });
+
+  it('default maxRetries is 3 (4 total attempts)', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const t = q.add('x', { backoffBase: 1 });
+    for (let i = 0; i < 4; i++) {
+      const got = q.getNext();
+      expect(got?.id).toBe(t.id);
+      q.fail(t.id);
+      clock.advance(100);
+    }
+    expect(q.getTask(t.id)?.status).toBe('failed');
+    expect(q.getTask(t.id)?.attempts).toBe(4);
+  });
+});
+
+describe('Phase 6: dead letter queue', () => {
+  function exhaust(
+    q: TaskQueue,
+    clock: ReturnType<typeof makeClock>,
+    id: string,
+    queue = 'default',
+  ) {
+    for (let i = 0; i < 4; i++) {
+      q.getNext(queue);
+      q.fail(id, new Error('boom'));
+      clock.advance(100000);
+    }
+  }
+
+  it('moves exhausted task to DLQ with error and attempts', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const t = q.add('x', { backoffBase: 1 });
+    exhaust(q, clock, t.id);
+    const dlq = q.getDeadLetters();
+    expect(dlq).toHaveLength(1);
+    expect(dlq[0].id).toBe(t.id);
+    expect(dlq[0].error).toBe('boom');
+    expect(dlq[0].attempts).toBe(4);
+  });
+
+  it('retryDeadLetter moves task back for fresh retries', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const t = q.add('x', { queue: 'a', backoffBase: 1 });
+    exhaust(q, clock, t.id, 'a');
+    q.retryDeadLetter(t.id);
+    expect(q.getDeadLetters('a')).toHaveLength(0);
+    expect(q.size('a')).toBe(1);
+    expect(q.getTask(t.id)?.attempts).toBe(0);
+    expect(q.getTask(t.id)?.status).toBe('pending');
+  });
+
+  it('clearDeadLetters empties the DLQ', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const t = q.add('x', { backoffBase: 1 });
+    exhaust(q, clock, t.id);
+    q.clearDeadLetters();
+    expect(q.getDeadLetters()).toHaveLength(0);
+  });
+
+  it('each queue has an independent DLQ', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const a = q.add('a', { queue: 'a', backoffBase: 1 });
+    exhaust(q, clock, a.id, 'a');
+    expect(q.getDeadLetters('a')).toHaveLength(1);
+    expect(q.getDeadLetters('b')).toHaveLength(0);
+  });
+});
+
+describe('Phase 7: dependencies', () => {
+  it('blocks a task until dependencies complete', () => {
+    const q = new TaskQueue();
+    const a = q.add('a');
+    const b = q.add('b', { dependencies: [a.id] });
+    expect(b.status).toBe('blocked');
+    // b should not be returned; a is
+    const first = q.getNext();
+    expect(first?.id).toBe(a.id);
+    expect(q.getNext()).toBeNull();
+    q.complete(a.id);
+    expect(q.getNext()?.id).toBe(b.id);
+  });
+
+  it('depending on non-existent task throws', () => {
+    const q = new TaskQueue();
+    expect(() => q.add('b', { dependencies: ['nope'] })).toThrow();
+  });
+
+  it('failed dependency leaves dependents blocked', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ now: clock.now });
+    const a = q.add('a', { maxRetries: 0 });
+    const b = q.add('b', { dependencies: [a.id] });
+    q.getNext();
+    q.fail(a.id);
+    expect(q.getTask(a.id)?.status).toBe('failed');
+    expect(q.getTask(b.id)?.status).toBe('blocked');
+    expect(q.getNext()).toBeNull();
+  });
+
+  it('getDependencyStatus reports satisfaction', () => {
+    const q = new TaskQueue();
+    const a = q.add('a');
+    const b = q.add('b');
+    const c = q.add('c', { dependencies: [a.id, b.id] });
+    let status = q.getDependencyStatus(c.id);
+    expect(status.satisfied).toBe(false);
+    expect(status.pending.sort()).toEqual([a.id, b.id].sort());
+    q.getNext();
+    q.complete(a.id);
+    status = q.getDependencyStatus(c.id);
+    expect(status.completed).toEqual([a.id]);
+    expect(status.satisfied).toBe(false);
+  });
+
+  it('detects circular dependencies', () => {
+    // Build a manual cycle by reaching into the same instance.
+    const q = new TaskQueue();
+    const a = q.add('a');
+    const b = q.add('b', { dependencies: [a.id] });
+    // make a depend on b, then a new task depending on a should detect cycle
+    (q.getTask(a.id) as { dependencies: string[] }).dependencies.push(b.id);
+    expect(() => q.add('c', { dependencies: [a.id] })).toThrow(/[Cc]ircular/);
+  });
+});
+
+describe('Phase 8: concurrency control', () => {
+  it('limits simultaneous processing', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('a', 1);
+    q.add('1', { queue: 'a' });
+    q.add('2', { queue: 'a' });
+    const first = q.getNext('a');
+    expect(first).not.toBeNull();
+    expect(q.getNext('a')).toBeNull(); // limit reached
+    q.complete(first!.id);
+    expect(q.getNext('a')).not.toBeNull(); // slot freed
+  });
+
+  it('default is unlimited', () => {
+    const q = new TaskQueue();
+    expect(q.getConcurrency('a')).toBe(Infinity);
+  });
+
+  it('exposes concurrency and active count', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('a', 2);
+    q.add('1', { queue: 'a' });
+    q.add('2', { queue: 'a' });
+    expect(q.getConcurrency('a')).toBe(2);
+    expect(q.getActiveCount('a')).toBe(0);
+    q.getNext('a');
+    q.getNext('a');
+    expect(q.getActiveCount('a')).toBe(2);
+  });
+
+  it('cancel frees a slot', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('a', 1);
+    q.add('1', { queue: 'a' });
+    q.add('2', { queue: 'a' });
+    const t = q.getNext('a');
+    expect(q.getNext('a')).toBeNull();
+    q.cancel(t!.id);
+    expect(q.getNext('a')).not.toBeNull();
+  });
+
+  it('respects priority subject to the limit', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('a', 1);
+    q.add('low', { queue: 'a', priority: 9 });
+    q.add('high', { queue: 'a', priority: 1 });
+    expect(q.getNext('a')?.payload).toBe('high');
+  });
+});
