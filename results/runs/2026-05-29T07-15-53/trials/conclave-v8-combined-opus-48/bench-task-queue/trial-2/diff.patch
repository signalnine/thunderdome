index 0000000..ed4f8cb
--- /dev/null
+++ b/src/cron.ts
@@ -0,0 +1,77 @@
+/**
+ * Minimal cron support for the subset required by the task queue:
+ *   - `(asterisk-slash)N * * * *`  every N minutes
+ *   - `0 * * * *`    every hour on the hour
+ *   - `0 0 * * *`    every day at midnight
+ *
+ * All matching is done at minute granularity.
+ */
+
+interface CronSpec {
+  matches(date: Date): boolean;
+}
+
+function parseCron(expr: string): CronSpec {
+  const parts = expr.trim().split(/\s+/);
+  if (parts.length !== 5) {
+    throw new Error(`Unsupported cron expression: "${expr}"`);
+  }
+  const [minute, hour, dom, month, dow] = parts;
+
+  if (dom !== '*' || month !== '*' || dow !== '*') {
+    throw new Error(`Unsupported cron expression: "${expr}"`);
+  }
+
+  // `*/N * * * *` — every N minutes.
+  const everyN = /^\*\/(\d+)$/.exec(minute);
+  if (everyN && hour === '*') {
+    const n = Number(everyN[1]);
+    if (!Number.isInteger(n) || n <= 0) {
+      throw new Error(`Unsupported cron expression: "${expr}"`);
+    }
+    return { matches: (d) => d.getSeconds() === 0 && d.getMinutes() % n === 0 };
+  }
+
+  // `0 * * * *` — top of every hour.
+  if (minute === '0' && hour === '*') {
+    return { matches: (d) => d.getSeconds() === 0 && d.getMinutes() === 0 };
+  }
+
+  // `0 0 * * *` — every day at midnight.
+  if (minute === '0' && hour === '0') {
+    return {
+      matches: (d) => d.getSeconds() === 0 && d.getMinutes() === 0 && d.getHours() === 0,
+    };
+  }
+
+  throw new Error(`Unsupported cron expression: "${expr}"`);
+}
+
+/** Validate a cron expression, throwing if unsupported. */
+export function validateCron(expr: string): void {
+  parseCron(expr);
+}
+
+/**
+ * Returns the next timestamp strictly greater than `from` at which the cron
+ * expression fires. Scans minute-by-minute (bounded by a day + 1 minute).
+ */
+export function nextOccurrence(expr: string, from: number): number {
+  const spec = parseCron(expr);
+  // Advance to the start of the next minute after `from`.
+  const start = new Date(from);
+  start.setSeconds(0, 0);
+  start.setMinutes(start.getMinutes() + 1);
+
+  const cursor = new Date(start);
+  // A daily schedule needs at most 24h*60m candidate minutes.
+  const maxMinutes = 24 * 60 + 1;
+  for (let i = 0; i < maxMinutes; i++) {
+    if (spec.matches(cursor)) {
+      return cursor.getTime();
+    }
+    cursor.setMinutes(cursor.getMinutes() + 1);
+  }
+  /* istanbul ignore next -- unreachable for supported expressions */
+  throw new Error(`No occurrence found for cron "${expr}"`);
+}
