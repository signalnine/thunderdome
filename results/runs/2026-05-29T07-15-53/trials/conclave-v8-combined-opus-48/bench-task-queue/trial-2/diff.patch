new file mode 100644
index 0000000..b5c433e
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,120 @@
+/** Lifecycle states a task can be in. */
+export type TaskStatus =
+  | 'pending' // waiting in queue, available now
+  | 'delayed' // waiting in queue, not yet available (time gated)
+  | 'blocked' // waiting in queue, dependencies unresolved
+  | 'processing' // currently being processed
+  | 'completed' // finished successfully
+  | 'failed' // finished unsuccessfully (retries exhausted)
+  | 'cancelled'; // cancelled by the user
+
+/** Public shape of a task. */
+export interface Task<T = unknown> {
+  /** Globally unique identifier. */
+  readonly id: string;
+  /** Name of the queue this task belongs to. */
+  queue: string;
+  /** Arbitrary user payload. */
+  payload: T;
+  /** Current lifecycle status. */
+  status: TaskStatus;
+  /** Priority 1 (highest) .. 10 (lowest). */
+  priority: number;
+  /** Creation timestamp (ms). */
+  readonly createdAt: number;
+  /** Timestamp (ms) at which the task becomes available for processing. */
+  availableAt: number;
+  /** Number of times the task has been retrieved for processing. */
+  attempts: number;
+  /** Maximum number of retries after the first attempt. */
+  maxRetries: number;
+  /** Base backoff delay (ms) used for exponential retry backoff. */
+  backoffBase: number;
+  /** Ids of tasks that must complete before this one becomes available. */
+  dependencies: string[];
+  /** Current progress percentage (0-100). */
+  progress: number;
+  /** Optional progress message. */
+  progressMessage?: string;
+  /** Last error message if the task failed. */
+  error?: string;
+  /** Result produced by the handler on completion. */
+  result?: unknown;
+}
+
+/** Options accepted when adding a task. */
+export interface AddOptions {
+  /** Target queue name. Defaults to `default`. */
+  queue?: string;
+  /** Priority 1 (highest) .. 10 (lowest). Defaults to 5. */
+  priority?: number;
+  /** Delay in milliseconds before the task becomes available. */
+  delay?: number;
+  /** Absolute time (ms timestamp or Date) at which the task becomes available. */
+  runAt?: number | Date;
+  /** Maximum retries after the first attempt. Defaults to 3. */
+  maxRetries?: number;
+  /** Base backoff delay in ms. Defaults to 1000. */
+  backoffBase?: number;
+  /** Ids of prerequisite tasks. */
+  dependencies?: string[];
+}
+
+/** Progress snapshot returned by `getProgress`. */
+export interface Progress {
+  percent: number;
+  message?: string;
+}
+
+/** A listener notified when a task's progress changes. */
+export type ProgressListener = (progress: Progress, task: Task) => void;
+
+/** Status of a task's dependencies. */
+export interface DependencyStatus {
+  dependencies: string[];
+  completed: string[];
+  pending: string[];
+  satisfied: boolean;
+}
+
+/** A registered recurring schedule. */
+export interface Schedule {
+  readonly id: string;
+  cron: string;
+  queue: string;
+  payload: unknown;
+  options: AddOptions;
+  /** Next time (ms) this schedule should fire. */
+  nextRun: number;
+}
+
+/** The `next` continuation passed to middleware. */
+export type Next = () => void | Promise<void>;
+
+/** A middleware function in a queue's pipeline. */
+export type Middleware<T = unknown> = (task: Task<T>, next: Next) => void | Promise<void>;
+
+/** The terminal handler invoked after all middleware. */
+export type Handler<T = unknown> = (task: Task<T>) => unknown | Promise<unknown>;
+
+/** A callback invoked during graceful shutdown. */
+export type ShutdownCallback = () => void | Promise<void>;
+
+/** Summary returned by `shutdown`. */
+export interface ShutdownSummary {
+  completed: number;
+  forceCancelled: number;
+  durationMs: number;
+}
+
+/** Options for constructing a TaskQueue. */
+export interface TaskQueueOptions {
+  /** Clock function (ms). Injectable for deterministic tests. */
+  now?: () => number;
+}
+
+/** Options for shutdown. */
+export interface ShutdownOptions {
+  /** Max time (ms) to wait for processing tasks before force-cancelling. */
+  timeout?: number;
+}
