@@ -0,0 +1,75 @@
+import { describe, expect, it } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+
+describe('cross-phase interactions', () => {
+  it('delayed + dependency: blocked takes precedence over delay, then becomes delayed', () => {
+    let now = 0;
+    const q = new TaskQueue({ now: () => now });
+    const dep = q.add('dep');
+    const t = q.add('t', { dependencies: [dep.id], delay: 100 });
+    expect(t.status).toBe('blocked');
+    q.next(); // pull dep
+    q.complete(dep.id);
+    // deps satisfied but still delayed
+    expect(t.status).toBe('delayed');
+    expect(q.next()).toBeNull();
+    now = 100;
+    expect(q.next()?.id).toBe(t.id);
+  });
+
+  it('priority still wins among ready tasks while others are delayed/blocked', () => {
+    let now = 0;
+    const q = new TaskQueue({ now: () => now });
+    const gate = q.add('gate');
+    q.add('blocked-high', { priority: 1, dependencies: [gate.id] });
+    q.add('delayed-high', { priority: 1, delay: 50 });
+    q.add('ready-low', { priority: 7 });
+    // only gate and ready-low are available now; gate added first
+    expect(q.next()?.payload).toBe('gate');
+    expect(q.next()?.payload).toBe('ready-low');
+  });
+
+  it('retry exhaustion lands in DLQ, then retryDeadLetter + middleware succeeds', async () => {
+    let now = 0;
+    const q = new TaskQueue({ now: () => now });
+    let attempts = 0;
+    q.setHandler('jobs', (task) => {
+      attempts++;
+      if (attempts < 4) throw new Error('flaky');
+      task.result = 'ok';
+    });
+
+    const t = q.add('payload', { queue: 'jobs', maxRetries: 2, baseDelay: 10 });
+    // initial + 2 retries = 3 failing attempts -> DLQ
+    for (let i = 0; i < 3; i++) {
+      now = q.getTask(t.id)?.availableAt ?? now;
+      await q.runNext('jobs');
+    }
+    expect(t.status).toBe('failed');
+    expect(q.getDeadLetter('jobs')).toHaveLength(1);
+
+    // resurrect from DLQ; 4th attempt succeeds
+    q.retryDeadLetter(t.id);
+    await q.runNext('jobs');
+    expect(t.status).toBe('completed');
+    expect(t.result).toBe('ok');
+    expect(q.getDeadLetter('jobs')).toHaveLength(0);
+  });
+
+  it('concurrency limit + priority across a worker loop', async () => {
+    const q = new TaskQueue();
+    q.setConcurrency('jobs', 1);
+    const done: string[] = [];
+    q.setHandler('jobs', (task) => {
+      done.push(task.payload as string);
+    });
+    q.add('low', { queue: 'jobs', priority: 9 });
+    q.add('high', { queue: 'jobs', priority: 1 });
+
+    // process serially honoring the limit
+    while ((await q.runNext('jobs')) !== null) {
+      /* drain */
+    }
+    expect(done).toEqual(['high', 'low']);
+  });
+});
