+++ b/src/task.ts
@@ -0,0 +1,71 @@
+import { randomUUID } from 'node:crypto';
+import type { ProgressInfo, TaskError, TaskStatus } from './types.js';
+
+/** A single unit of work tracked by the queue. */
+export class Task<T = unknown> {
+  readonly id: string;
+  readonly createdAt: number;
+  /** Monotonic sequence number used as the final FIFO tiebreak. */
+  readonly seq: number;
+
+  queue: string;
+  payload: T;
+  status: TaskStatus;
+  priority: number;
+  availableAt: number;
+  attempts: number;
+  maxRetries: number;
+  baseDelay: number;
+  dependencies: string[];
+  metadata: Record<string, unknown>;
+  progress: ProgressInfo;
+  error?: TaskError;
+  result?: unknown;
+  /** Set once the task has been cancelled; cancelled tasks are never retried. */
+  cancelled: boolean;
+
+  private readonly controller: AbortController;
+
+  constructor(init: {
+    seq: number;
+    now: number;
+    queue: string;
+    payload: T;
+    status: TaskStatus;
+    priority: number;
+    availableAt: number;
+    maxRetries: number;
+    baseDelay: number;
+    dependencies: string[];
+    metadata: Record<string, unknown>;
+  }) {
+    this.id = randomUUID();
+    this.seq = init.seq;
+    this.createdAt = init.now;
+    this.queue = init.queue;
+    this.payload = init.payload;
+    this.status = init.status;
+    this.priority = init.priority;
+    this.availableAt = init.availableAt;
+    this.maxRetries = init.maxRetries;
+    this.baseDelay = init.baseDelay;
+    this.dependencies = init.dependencies;
+    this.metadata = init.metadata;
+    this.attempts = 0;
+    this.progress = { percent: 0 };
+    this.cancelled = false;
+    this.controller = new AbortController();
+  }
+
+  /** An AbortSignal that fires when the task is cancelled. */
+  get signal(): AbortSignal {
+    return this.controller.signal;
+  }
+
+  /** Internal: triggers the abort signal. */
+  abort(): void {
+    if (!this.controller.signal.aborted) {
+      this.controller.abort();
+    }
+  }
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..7d4a67f
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,76 @@
+/** Lifecycle status of a task. */
+export type TaskStatus =
+  | 'pending' // in queue, available now
+  | 'delayed' // in queue, waiting for availableAt
+  | 'blocked' // in queue, waiting for dependencies
+  | 'processing' // retrieved and being worked on
+  | 'completed' // finished successfully
+  | 'failed' // permanently failed (retries exhausted)
+  | 'cancelled'; // cancelled before/while processing
+
+/** Error information captured when a task fails. */
+export interface TaskError {
+  message: string;
+  stack?: string;
+  /** Logical timestamp at which the failure was recorded. */
+  at: number;
+}
+
+/** Progress report for a running task. */
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+}
+
+/** Options accepted when adding a task. */
+export interface AddOptions {
+  /** Target queue name. Defaults to "default". */
+  queue?: string;
+  /** Priority 1 (highest) .. 10 (lowest). Defaults to 5. */
+  priority?: number;
+  /** Delay in milliseconds before the task becomes available. */
+  delay?: number;
+  /** Absolute logical timestamp at which the task becomes available. */
+  runAt?: number;
+  /** Maximum number of retries after the first attempt. Defaults to 3. */
+  maxRetries?: number;
+  /** Base backoff delay in milliseconds. Defaults to 1000. */
+  baseDelay?: number;
+  /** Task ids that must complete before this task becomes available. */
+  dependencies?: string[];
+  /** Arbitrary metadata, useful for middleware. */
+  metadata?: Record<string, unknown>;
+}
+
+/** Snapshot of a dependency's resolution state. */
+export interface DependencyState {
+  id: string;
+  status: TaskStatus | 'unknown';
+  satisfied: boolean;
+}
+
+/** Result of inspecting a task's dependencies. */
+export interface DependencyStatus {
+  dependencies: DependencyState[];
+  satisfied: boolean;
+  blocked: boolean;
+}
+
+/** Summary returned by shutdown(). */
+export interface ShutdownSummary {
+  completed: number;
+  forceCancelled: number;
+  durationMs: number;
+}
+
+/** Options for the TaskQueue constructor. */
+export interface TaskQueueOptions {
+  /** Logical clock used for delays, retries and schedules. Defaults to Date.now. */
+  now?: () => number;
+}
+
+/** Options for shutdown(). */
+export interface ShutdownOptions {
+  /** Milliseconds to wait for processing tasks before force-cancelling. Defaults to 30000. */
+  timeout?: number;
+}
