+import { describe, expect, it, vi } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+
+describe('Phase 9: progress tracking and cancellation', () => {
+  it('reports and queries progress', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.next();
+    q.reportProgress(t.id, 42, 'halfway');
+    expect(q.getProgress(t.id)).toEqual({ percent: 42, message: 'halfway' });
+  });
+
+  it('rejects out-of-range progress', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.next();
+    expect(() => q.reportProgress(t.id, -1)).toThrow();
+    expect(() => q.reportProgress(t.id, 101)).toThrow();
+  });
+
+  it('notifies subscribers and supports unsubscribe', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.next();
+    const listener = vi.fn();
+    const unsub = q.onProgress(t.id, listener);
+    q.reportProgress(t.id, 10);
+    q.reportProgress(t.id, 20, 'm');
+    expect(listener).toHaveBeenCalledTimes(2);
+    expect(listener).toHaveBeenLastCalledWith(20, 'm', t);
+    unsub();
+    q.reportProgress(t.id, 30);
+    expect(listener).toHaveBeenCalledTimes(2);
+  });
+
+  it('cancels a pending task and removes it from the queue', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    expect(q.cancel(t.id)).toBe(true);
+    expect(t.status).toBe('cancelled');
+    expect(q.size()).toBe(0);
+    expect(q.next()).toBeNull();
+  });
+
+  it('cancels a processing task and frees the slot', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('q', 1);
+    const t = q.add('x', { queue: 'q' });
+    q.next('q');
+    expect(q.getActiveCount('q')).toBe(1);
+    expect(t.signal.aborted).toBe(false);
+    q.cancel(t.id);
+    expect(t.status).toBe('cancelled');
+    expect(q.getActiveCount('q')).toBe(0);
+    expect(t.signal.aborted).toBe(true);
+  });
+
+  it('cancelled tasks are never retried', () => {
+    let now = 0;
+    const q = new TaskQueue({ now: () => now });
+    const t = q.add('x', { maxRetries: 5, baseDelay: 1 });
+    q.next();
+    q.cancel(t.id);
+    q.fail(t.id, new Error('boom'));
+    expect(t.status).toBe('cancelled');
+    expect(q.size()).toBe(0);
+    expect(q.getDeadLetter()).toHaveLength(0);
+  });
+});
