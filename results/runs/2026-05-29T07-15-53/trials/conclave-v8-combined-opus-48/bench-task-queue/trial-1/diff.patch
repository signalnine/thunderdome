+++ b/tests/phase10-recurring.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from 'vitest';
+import { TaskQueue, parseCron, nextOccurrence } from '../src/index.js';
+
+const MIN = 60_000;
+const HOUR = 60 * MIN;
+const DAY = 24 * HOUR;
+
+describe('Phase 10: recurring tasks', () => {
+  it('parses supported cron expressions and rejects others', () => {
+    expect(parseCron('*/5 * * * *')).toMatchObject({ type: 'everyNMinutes', n: 5 });
+    expect(parseCron('0 * * * *')).toMatchObject({ type: 'hourly' });
+    expect(parseCron('0 0 * * *')).toMatchObject({ type: 'daily' });
+    expect(() => parseCron('* * * * *')).toThrow();
+    expect(() => parseCron('15 3 * * 1')).toThrow();
+    expect(() => parseCron('bogus')).toThrow();
+  });
+
+  it('computes next occurrence (UTC)', () => {
+    // every 5 minutes from 0 -> 5 min
+    expect(nextOccurrence(parseCron('*/5 * * * *'), 0)).toBe(5 * MIN);
+    expect(nextOccurrence(parseCron('*/5 * * * *'), 5 * MIN)).toBe(10 * MIN);
+    // hourly
+    expect(nextOccurrence(parseCron('0 * * * *'), 30 * MIN)).toBe(HOUR);
+    // daily
+    expect(nextOccurrence(parseCron('0 0 * * *'), HOUR)).toBe(DAY);
+  });
+
+  it('create, list and remove schedules', () => {
+    const q = new TaskQueue({ now: () => 0 });
+    const s = q.schedule('*/1 * * * *', 'jobs', { kind: 'ping' });
+    expect(q.listSchedules()).toHaveLength(1);
+    expect(s.queue).toBe('jobs');
+    expect(q.unschedule(s.id)).toBe(true);
+    expect(q.listSchedules()).toHaveLength(0);
+  });
+
+  it('tick enqueues due tasks as normal tasks', () => {
+    let now = 0;
+    const q = new TaskQueue({ now: () => now });
+    q.schedule('*/1 * * * *', 'jobs', { kind: 'ping' }, { priority: 2 });
+    // nextRun is at 1 minute; nothing due yet
+    expect(q.tick(0)).toHaveLength(0);
+    now = MIN;
+    const created = q.tick(MIN);
+    expect(created).toHaveLength(1);
+    expect(created[0].queue).toBe('jobs');
+    expect(created[0].priority).toBe(2);
+    expect(q.size('jobs')).toBe(1);
+    // the created task behaves like any normal task
+    expect(q.next('jobs')?.payload).toEqual({ kind: 'ping' });
+  });
+
+  it('removing a schedule stops future occurrences', () => {
+    let now = 0;
+    const q = new TaskQueue({ now: () => now });
+    const s = q.schedule('*/1 * * * *', 'jobs', {});
+    now = MIN;
+    expect(q.tick(MIN)).toHaveLength(1);
+    q.unschedule(s.id);
+    now = 2 * MIN;
+    expect(q.tick(2 * MIN)).toHaveLength(0);
+  });
+});
diff --git a/tests/phase11-middleware.test.ts b/tests/phase11-middleware.test.ts
new file mode 100644
index 0000000..caa01d1
--- /dev/null
+++ b/tests/phase11-middleware.test.ts
@@ -0,0 +1,97 @@
+import { describe, expect, it, vi } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+
+describe('Phase 11: middleware pipeline', () => {
+  it('runs middleware in order then the handler', async () => {
+    const q = new TaskQueue();
+    const order: string[] = [];
+    q.use('jobs', async (_t, next) => {
+      order.push('mw1-before');
+      await next();
+      order.push('mw1-after');
+    });
+    q.use('jobs', async (_t, next) => {
+      order.push('mw2-before');
+      await next();
+      order.push('mw2-after');
+    });
+    q.setHandler('jobs', () => {
+      order.push('handler');
+    });
+    const t = q.add('x', { queue: 'jobs' });
+    const result = await q.runNext('jobs');
+    expect(result?.id).toBe(t.id);
+    expect(order).toEqual(['mw1-before', 'mw2-before', 'handler', 'mw2-after', 'mw1-after']);
+    expect(t.status).toBe('completed');
+  });
+
+  it('middleware that does not call next skips the handler', async () => {
+    const q = new TaskQueue();
+    const handler = vi.fn();
+    q.use('jobs', () => {
+      /* no next() */
+    });
+    q.setHandler('jobs', handler);
+    const t = q.add('x', { queue: 'jobs' });
+    await q.runNext('jobs');
+    expect(handler).not.toHaveBeenCalled();
+    expect(t.status).toBe('completed');
+  });
+
+  it('middleware can modify the task', async () => {
+    const q = new TaskQueue();
+    q.use('jobs', async (task, next) => {
+      task.metadata.tag = 'tagged';
+      (task.payload as { n: number }).n *= 2;
+      await next();
+    });
+    q.setHandler('jobs', () => undefined);
+    const t = q.add({ n: 5 }, { queue: 'jobs' });
+    await q.runNext('jobs');
+    expect(t.metadata.tag).toBe('tagged');
+    expect((t.payload as { n: number }).n).toBe(10);
+  });
+
+  it('a throwing middleware fails the task', async () => {
+    let now = 0;
+    const q = new TaskQueue({ now: () => now });
+    q.use('jobs', () => {
+      throw new Error('mw boom');
+    });
+    q.setHandler('jobs', () => undefined);
+    const t = q.add('x', { queue: 'jobs', maxRetries: 0 });
+    await q.runNext('jobs');
+    expect(t.status).toBe('failed');
+    expect(t.error?.message).toBe('mw boom');
+    expect(q.getDeadLetter('jobs')).toHaveLength(1);
+  });
+
+  it('a throwing handler fails the task', async () => {
+    const q = new TaskQueue();
+    q.setHandler('jobs', () => {
+      throw new Error('handler boom');
+    });
+    const t = q.add('x', { queue: 'jobs', maxRetries: 0 });
+    await q.runNext('jobs');
+    expect(t.status).toBe('failed');
+    expect(t.error?.message).toBe('handler boom');
+  });
+
+  it('each queue has an independent stack', async () => {
+    const q = new TaskQueue();
+    const aRan = vi.fn();
+    const bRan = vi.fn();
+    q.use('a', async (_t, next) => {
+      aRan();
+      await next();
+    });
+    q.setHandler('a', () => undefined);
+    q.setHandler('b', bRan);
+    q.add('x', { queue: 'a' });
+    q.add('y', { queue: 'b' });
+    await q.runNext('a');
+    await q.runNext('b');
+    expect(aRan).toHaveBeenCalledTimes(1);
+    expect(bRan).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/tests/phase12-shutdown.test.ts b/tests/phase12-shutdown.test.ts
new file mode 100644
index 0000000..0e76c8d
--- /dev/null
+++ b/tests/phase12-shutdown.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it, vi } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+
+describe('Phase 12: graceful shutdown', () => {
+  it('completes immediately when nothing is processing', async () => {
+    const q = new TaskQueue();
+    q.add('x');
+    const summary = await q.shutdown({ timeout: 1000 });
+    expect(summary.completed).toBe(0);
+    expect(summary.forceCancelled).toBe(0);
+    expect(summary.durationMs).toBeLessThan(500);
+  });
+
+  it('stops accepting new tasks after shutdown', async () => {
+    const q = new TaskQueue();
+    expect(q.isShuttingDown()).toBe(false);
+    const p = q.shutdown({ timeout: 100 });
+    expect(q.isShuttingDown()).toBe(true);
+    expect(() => q.add('x')).toThrow();
+    await p;
+  });
+
+  it('waits for processing tasks that finish in time', async () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.next();
+    setTimeout(() => q.complete(t.id), 20);
+    const summary = await q.shutdown({ timeout: 1000 });
+    expect(summary.completed).toBe(1);
+    expect(summary.forceCancelled).toBe(0);
+  });
+
+  it('force-cancels tasks that exceed the timeout', async () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.next();
+    const summary = await q.shutdown({ timeout: 30 });
+    expect(summary.completed).toBe(0);
+    expect(summary.forceCancelled).toBe(1);
+    expect(t.status).toBe('cancelled');
+  });
+
+  it('runs shutdown callbacks', async () => {
+    const q = new TaskQueue();
+    const cb = vi.fn();
+    q.onShutdown(cb);
+    await q.shutdown({ timeout: 50 });
+    expect(cb).toHaveBeenCalledTimes(1);
+  });
+
+  it('is idempotent and returns the same result', async () => {
+    const q = new TaskQueue();
+    const p1 = q.shutdown({ timeout: 50 });
+    const p2 = q.shutdown({ timeout: 50 });
+    expect(p1).toBe(p2);
+    expect(await p1).toBe(await p2);
+  });
+});
