+import { describe, expect, it } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+
+describe('Phase 8: concurrency control', () => {
+  it('default unlimited concurrency', () => {
+    const q = new TaskQueue();
+    expect(q.getConcurrency()).toBeNull();
+    q.add('a');
+    q.add('b');
+    q.add('c');
+    expect(q.next()).not.toBeNull();
+    expect(q.next()).not.toBeNull();
+    expect(q.next()).not.toBeNull();
+  });
+
+  it('limit blocks retrieval beyond the cap', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('jobs', 2);
+    q.add('a', { queue: 'jobs' });
+    q.add('b', { queue: 'jobs' });
+    q.add('c', { queue: 'jobs' });
+    expect(q.next('jobs')).not.toBeNull();
+    expect(q.next('jobs')).not.toBeNull();
+    expect(q.getActiveCount('jobs')).toBe(2);
+    expect(q.next('jobs')).toBeNull(); // limit reached
+  });
+
+  it('completing or failing frees a slot', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('jobs', 1);
+    const a = q.add('a', { queue: 'jobs' });
+    q.add('b', { queue: 'jobs' });
+    const first = q.next('jobs');
+    expect(first?.id).toBe(a.id);
+    expect(q.next('jobs')).toBeNull();
+    q.complete(a.id);
+    expect(q.getActiveCount('jobs')).toBe(0);
+    expect(q.next('jobs')).not.toBeNull();
+  });
+
+  it('respects priority subject to limit', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('jobs', 1);
+    q.add('low', { queue: 'jobs', priority: 9 });
+    q.add('high', { queue: 'jobs', priority: 1 });
+    expect(q.next('jobs')?.payload).toBe('high');
+    expect(q.next('jobs')).toBeNull();
+  });
+
+  it('setConcurrency validates and getConcurrency reports', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('q', 5);
+    expect(q.getConcurrency('q')).toBe(5);
+    q.setConcurrency('q', null);
+    expect(q.getConcurrency('q')).toBeNull();
+    expect(() => q.setConcurrency('q', 0)).toThrow();
+  });
+});
