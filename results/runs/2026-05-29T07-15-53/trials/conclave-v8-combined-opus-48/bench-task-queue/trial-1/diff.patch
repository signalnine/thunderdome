+++ b/tests/phase07-deps.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from 'vitest';
+import { TaskQueue, hasCycle } from '../src/index.js';
+
+describe('Phase 7: task dependencies', () => {
+  it('blocked until prerequisites complete', () => {
+    const q = new TaskQueue();
+    const a = q.add('a');
+    const b = q.add('b', { dependencies: [a.id] });
+    expect(b.status).toBe('blocked');
+    // b not returned while blocked; a comes first
+    expect(q.next()?.id).toBe(a.id);
+    expect(q.next()).toBeNull();
+    q.complete(a.id);
+    expect(b.status).toBe('pending');
+    expect(q.next()?.id).toBe(b.id);
+  });
+
+  it('completing a dependency unblocks dependents', () => {
+    const q = new TaskQueue();
+    const a = q.add('a');
+    const b = q.add('b');
+    const c = q.add('c', { dependencies: [a.id, b.id] });
+    q.next();
+    q.complete(a.id);
+    expect(c.status).toBe('blocked');
+    q.next();
+    q.complete(b.id);
+    expect(c.status).toBe('pending');
+  });
+
+  it('depending on a non-existent task throws', () => {
+    const q = new TaskQueue();
+    expect(() => q.add('x', { dependencies: ['nope'] })).toThrow();
+  });
+
+  it('failed dependency keeps dependents blocked', () => {
+    const q = new TaskQueue();
+    const a = q.add('a', { maxRetries: 0 });
+    const b = q.add('b', { dependencies: [a.id] });
+    q.next();
+    q.fail(a.id);
+    expect(a.status).toBe('failed');
+    expect(b.status).toBe('blocked');
+    expect(q.next()).toBeNull();
+  });
+
+  it('getDependencyStatus reports state', () => {
+    const q = new TaskQueue();
+    const a = q.add('a');
+    const b = q.add('b', { dependencies: [a.id] });
+    let st = q.getDependencyStatus(b.id);
+    expect(st.blocked).toBe(true);
+    expect(st.satisfied).toBe(false);
+    expect(st.dependencies[0]).toMatchObject({ id: a.id, satisfied: false });
+    q.next();
+    q.complete(a.id);
+    st = q.getDependencyStatus(b.id);
+    expect(st.satisfied).toBe(true);
+    expect(st.blocked).toBe(false);
+  });
+
+  it('cycle detection (pure)', () => {
+    const acyclic = new Map<string, string[]>([
+      ['a', ['b']],
+      ['b', ['c']],
+      ['c', []],
+    ]);
+    expect(hasCycle('a', acyclic)).toBe(false);
+
+    const cyclic = new Map<string, string[]>([
+      ['a', ['b']],
+      ['b', ['c']],
+      ['c', ['a']],
+    ]);
+    expect(hasCycle('a', cyclic)).toBe(true);
+  });
+});
