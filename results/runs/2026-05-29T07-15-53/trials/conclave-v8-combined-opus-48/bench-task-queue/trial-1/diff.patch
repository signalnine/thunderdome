@@ -0,0 +1,31 @@
+/**
+ * Pure dependency-graph helpers.
+ *
+ * Edges point from a task to the tasks it depends on. A cycle means a task
+ * (transitively) depends on itself.
+ */
+
+/**
+ * Returns true if the directed graph described by `edges` contains a cycle
+ * reachable from `start`. `edges` maps a node id to the list of nodes it
+ * depends on.
+ */
+export function hasCycle(start: string, edges: Map<string, string[]>): boolean {
+  const VISITING = 1;
+  const DONE = 2;
+  const state = new Map<string, number>();
+
+  const visit = (node: string): boolean => {
+    const s = state.get(node);
+    if (s === VISITING) return true; // back-edge => cycle
+    if (s === DONE) return false;
+    state.set(node, VISITING);
+    for (const next of edges.get(node) ?? []) {
+      if (visit(next)) return true;
+    }
+    state.set(node, DONE);
+    return false;
+  };
+
+  return visit(start);
+}
