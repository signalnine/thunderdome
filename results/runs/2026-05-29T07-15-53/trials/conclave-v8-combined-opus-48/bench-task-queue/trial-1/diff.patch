diff --git a/tests/phase05-retry.test.ts b/tests/phase05-retry.test.ts
new file mode 100644
index 0000000..a6620c3
--- /dev/null
+++ b/tests/phase05-retry.test.ts
@@ -0,0 +1,69 @@
+import { describe, expect, it } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+
+describe('Phase 5: retry with backoff', () => {
+  it('complete finalizes a processing task', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.next();
+    q.complete(t.id, 'result');
+    expect(t.status).toBe('completed');
+    expect(t.result).toBe('result');
+  });
+
+  it('failed task with retries is re-enqueued with exponential backoff', () => {
+    let now = 0;
+    const q = new TaskQueue({ now: () => now });
+    const t = q.add('x', { baseDelay: 1000 });
+    q.next();
+    q.fail(t.id, new Error('boom'));
+    // attempt 1 failed => delay 1000 * 2^0 = 1000
+    expect(t.availableAt).toBe(1000);
+    expect(t.status).toBe('delayed');
+    expect(t.attempts).toBe(1);
+    expect(q.size()).toBe(1);
+
+    now = 1000;
+    q.next();
+    q.fail(t.id);
+    // attempt 2 failed => delay 1000 * 2^1 = 2000 => availableAt 3000
+    expect(t.attempts).toBe(2);
+    expect(t.availableAt).toBe(3000);
+  });
+
+  it('configurable maxRetries and baseDelay; exhaustion => failed', () => {
+    let now = 0;
+    const q = new TaskQueue({ now: () => now });
+    const t = q.add('x', { maxRetries: 2, baseDelay: 10 });
+    for (let i = 0; i < 3; i++) {
+      now = t.availableAt;
+      const got = q.next();
+      expect(got?.id).toBe(t.id);
+      q.fail(t.id, new Error('e'));
+    }
+    // 1 initial + 2 retries = 3 attempts, then failed
+    expect(t.attempts).toBe(3);
+    expect(t.status).toBe('failed');
+    expect(q.size()).toBe(0);
+  });
+
+  it('retried task keeps queue and priority', () => {
+    let now = 0;
+    const q = new TaskQueue({ now: () => now });
+    const t = q.add('x', { queue: 'jobs', priority: 2, baseDelay: 5 });
+    q.next('jobs');
+    q.fail(t.id);
+    expect(t.queue).toBe('jobs');
+    expect(t.priority).toBe(2);
+    now = t.availableAt;
+    expect(q.next('jobs')?.id).toBe(t.id);
+  });
+
+  it('maxRetries 0 fails immediately', () => {
+    const q = new TaskQueue();
+    const t = q.add('x', { maxRetries: 0 });
+    q.next();
+    q.fail(t.id);
+    expect(t.status).toBe('failed');
+  });
+});
diff --git a/tests/phase06-dlq.test.ts b/tests/phase06-dlq.test.ts
new file mode 100644
index 0000000..3e25e1d
--- /dev/null
+++ b/tests/phase06-dlq.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, it } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+
+function exhaust(q: TaskQueue, id: string, queue: string, attempts: number, clock: { t: number }) {
+  for (let i = 0; i < attempts; i++) {
+    const task = q.getTask(id);
+    clock.t = task ? task.availableAt : clock.t;
+    q.next(queue);
+    q.fail(id, new Error(`fail ${i}`));
+  }
+}
+
+describe('Phase 6: dead letter queue', () => {
+  it('exhausted task moves to DLQ and retains error + count', () => {
+    const clock = { t: 0 };
+    const q = new TaskQueue({ now: () => clock.t });
+    const t = q.add('x', { queue: 'jobs', maxRetries: 1, baseDelay: 1 });
+    exhaust(q, t.id, 'jobs', 2, clock);
+    const dlq = q.getDeadLetter('jobs');
+    expect(dlq).toHaveLength(1);
+    expect(dlq[0].id).toBe(t.id);
+    expect(dlq[0].error?.message).toBe('fail 1');
+    expect(dlq[0].attempts).toBe(2);
+  });
+
+  it('retryDeadLetter moves task back with reset attempts', () => {
+    const clock = { t: 0 };
+    const q = new TaskQueue({ now: () => clock.t });
+    const t = q.add('x', { queue: 'jobs', maxRetries: 0 });
+    q.next('jobs');
+    q.fail(t.id);
+    expect(q.getDeadLetter('jobs')).toHaveLength(1);
+
+    q.retryDeadLetter(t.id);
+    expect(q.getDeadLetter('jobs')).toHaveLength(0);
+    expect(t.attempts).toBe(0);
+    expect(t.error).toBeUndefined();
+    expect(q.next('jobs')?.id).toBe(t.id);
+  });
+
+  it('clearDeadLetter empties the DLQ', () => {
+    const q = new TaskQueue();
+    const t = q.add('x', { maxRetries: 0 });
+    q.next();
+    q.fail(t.id);
+    expect(q.getDeadLetter()).toHaveLength(1);
+    q.clearDeadLetter();
+    expect(q.getDeadLetter()).toHaveLength(0);
+  });
+
+  it('DLQ is per-queue', () => {
+    const q = new TaskQueue();
+    const a = q.add('a', { queue: 'a', maxRetries: 0 });
+    const b = q.add('b', { queue: 'b', maxRetries: 0 });
+    q.next('a');
+    q.fail(a.id);
+    q.next('b');
+    q.fail(b.id);
+    expect(q.getDeadLetter('a').map((t) => t.id)).toEqual([a.id]);
+    expect(q.getDeadLetter('b').map((t) => t.id)).toEqual([b.id]);
+  });
+
+  it('retryDeadLetter throws for unknown task', () => {
+    const q = new TaskQueue();
+    expect(() => q.retryDeadLetter('nope')).toThrow();
+  });
+});
