+import { describe, expect, it } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+
+describe('Phase 1: basic FIFO queue', () => {
+  it('add returns a task with unique id, status and createdAt', () => {
+    const q = new TaskQueue({ now: () => 1000 });
+    const a = q.add({ x: 1 });
+    const b = q.add({ x: 2 });
+    expect(a.id).toBeTypeOf('string');
+    expect(a.id).not.toBe(b.id);
+    expect(a.status).toBe('pending');
+    expect(a.createdAt).toBe(1000);
+    expect(a.payload).toEqual({ x: 1 });
+  });
+
+  it('new tasks start pending', () => {
+    const q = new TaskQueue();
+    expect(q.add('p').status).toBe('pending');
+  });
+
+  it('next returns oldest pending and transitions to processing', () => {
+    const q = new TaskQueue();
+    const a = q.add('a');
+    const b = q.add('b');
+    const first = q.next();
+    expect(first?.id).toBe(a.id);
+    expect(first?.status).toBe('processing');
+    const second = q.next();
+    expect(second?.id).toBe(b.id);
+  });
+
+  it('next returns null when empty', () => {
+    const q = new TaskQueue();
+    expect(q.next()).toBeNull();
+    q.add('x');
+    q.next();
+    expect(q.next()).toBeNull();
+  });
