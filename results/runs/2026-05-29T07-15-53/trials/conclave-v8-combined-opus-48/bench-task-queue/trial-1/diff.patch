@@ -0,0 +1,83 @@
+/**
+ * Minimal cron support for recurring tasks. Only a small, well-defined subset
+ * of expressions is supported:
+ *   - `* /N * * * *` (every N minutes)
+ *   - `0 * * * *`    (every hour on the hour)
+ *   - `0 0 * * *`    (every day at midnight, UTC)
+ *
+ * All times are interpreted in UTC for determinism.
+ */
+
+export type CronType = 'everyNMinutes' | 'hourly' | 'daily';
+
+export interface ParsedCron {
+  type: CronType;
+  /** Interval for the every-N-minutes form. */
+  n?: number;
+  raw: string;
+}
+
+const MINUTE = 60_000;
+
+/** Parses a supported cron expression, throwing on anything unsupported. */
+export function parseCron(expr: string): ParsedCron {
+  const raw = expr.trim();
+  const fields = raw.split(/\s+/);
+  if (fields.length !== 5) {
+    throw new Error(`Unsupported cron expression: "${expr}" (expected 5 fields)`);
+  }
+  const [minute, hour, dom, month, dow] = fields;
+  const restWild = hour === '*' && dom === '*' && month === '*' && dow === '*';
+
+  // */N * * * *
+  const everyN = /^\*\/(\d+)$/.exec(minute);
+  if (everyN && restWild) {
+    const n = Number(everyN[1]);
+    if (!Number.isInteger(n) || n < 1 || n > 59) {
+      throw new Error(`Unsupported cron expression: "${expr}" (interval out of range)`);
+    }
+    return { type: 'everyNMinutes', n, raw };
+  }
+
+  // 0 * * * *
+  if (minute === '0' && restWild) {
+    return { type: 'hourly', raw };
+  }
+
+  // 0 0 * * *
+  if (minute === '0' && hour === '0' && dom === '*' && month === '*' && dow === '*') {
+    return { type: 'daily', raw };
+  }
+
+  throw new Error(`Unsupported cron expression: "${expr}"`);
+}
+
+/**
+ * Returns the smallest timestamp strictly greater than `after` that matches
+ * the parsed cron expression.
+ */
+export function nextOccurrence(parsed: ParsedCron, after: number): number {
+  switch (parsed.type) {
+    case 'everyNMinutes': {
+      const n = parsed.n as number;
+      let candidate = Math.floor(after / MINUTE) * MINUTE;
+      if (candidate <= after) candidate += MINUTE;
+      while (new Date(candidate).getUTCMinutes() % n !== 0) {
+        candidate += MINUTE;
+      }
+      return candidate;
+    }
+    case 'hourly': {
+      const HOUR = 60 * MINUTE;
+      let candidate = Math.floor(after / HOUR) * HOUR;
+      if (candidate <= after) candidate += HOUR;
+      return candidate;
+    }
+    case 'daily': {
+      const DAY = 24 * 60 * MINUTE;
+      let candidate = Math.floor(after / DAY) * DAY;
+      if (candidate <= after) candidate += DAY;
+      return candidate;
+    }
+  }
+}
