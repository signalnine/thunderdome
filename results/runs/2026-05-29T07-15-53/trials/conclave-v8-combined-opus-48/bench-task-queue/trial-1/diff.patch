.toBe(false);\n    q.cancel(t.id);\n    expect(t.status).toBe('cancelled');\n    expect(q.getActiveCount('q')).toBe(0);\n    expect(t.signal.aborted).toBe(true);\n  });\n\n  it('cancelled tasks are never retried', () => {\n    let now = 0;\n    const q = new TaskQueue({ now: () => now });\n    const t = q.add('x', { maxRetries: 5, baseDelay: 1 });\n    q.next();\n    q.cancel(t.id);\n    q.fail(t.id, new Error('boom'));\n    expect(t.status).toBe('cancelled');\n    expect(q.size()).toBe(0);\n    expect(q.getDeadLetter()).toHaveLength(0);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1158,"cache_read_input_tokens":73408,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1158},"output_tokens":67,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cd455c70-e640-4147-a202-ee2b67f1e755","uuid":"7980e5ce-6325-49b3-b533-07480a07c7e7","request_id":"req_011CbWUyxpcoxMxgiAm6s77e"}
