+describe('Phase 4: delayed and scheduled tasks', () => {
+  it('delay defers availability', () => {
+    let t = 1000;
+    const q = new TaskQueue({ now: () => t });
+    const task = q.add('later', { delay: 500 });
+    expect(task.availableAt).toBe(1500);
+    expect(task.status).toBe('delayed');
+    expect(q.next()).toBeNull();
+    t = 1500;
+    expect(q.next()?.id).toBe(task.id);
+  });
+
+  it('runAt sets absolute availability', () => {
+    let t = 1000;
+    const q = new TaskQueue({ now: () => t });
+    const task = q.add('at', { runAt: 5000 });
+    expect(task.availableAt).toBe(5000);
+    expect(q.next()).toBeNull();
+    t = 5000;
+    expect(q.next()?.id).toBe(task.id);
+  });
+
+  it('non-delayed preferred over not-yet-available delayed', () => {
+    let t = 1000;
+    const q = new TaskQueue({ now: () => t });
+    q.add('delayed', { delay: 1000, priority: 1 });
+    q.add('now', { priority: 9 });
+    expect(q.next()?.payload).toBe('now');
+  });
+
+  it('available delayed tasks ordered by availableAt, then priority, then FIFO', () => {
+    let t = 0;
