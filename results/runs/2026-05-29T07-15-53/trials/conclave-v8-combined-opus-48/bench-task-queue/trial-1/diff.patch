s\n * the parsed cron expression.\n */\nexport function nextOccurrence(parsed: ParsedCron, after: number): number {\n  switch (parsed.type) {\n    case 'everyNMinutes': {\n      const n = parsed.n as number;\n      let candidate = Math.floor(after / MINUTE) * MINUTE;\n      if (candidate <= after) candidate += MINUTE;\n      while (new Date(candidate).getUTCMinutes() % n !== 0) {\n        candidate += MINUTE;\n      }\n      return candidate;\n    }\n    case 'hourly': {\n      const HOUR = 60 * MINUTE;\n      let candidate = Math.floor(after / HOUR) * HOUR;\n      if (candidate <= after) candidate += HOUR;\n      return candidate;\n    }\n    case 'daily': {\n      const DAY = 24 * 60 * MINUTE;\n      let candidate = Math.floor(after / DAY) * DAY;\n      if (candidate <= after) candidate += DAY;\n      return candidate;\n    }\n  }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":459,"cache_read_input_tokens":55006,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":459},"output_tokens":67,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cd455c70-e640-4147-a202-ee2b67f1e755","uuid":"fc2a27c9-9100-4325-841f-e1dc2bad2373","request_id":"req_011CbWUjzdNLLYWaXGMphAhp"}
