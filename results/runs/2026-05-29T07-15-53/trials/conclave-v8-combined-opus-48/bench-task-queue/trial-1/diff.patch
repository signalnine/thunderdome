--- /dev/null
+++ b/src/queue.ts
@@ -0,0 +1,626 @@
+import { hasCycle } from './graph.js';
+import { nextOccurrence, parseCron, type ParsedCron } from './cron.js';
+import { Task } from './task.js';
+import type {
+  AddOptions,
+  DependencyStatus,
+  ShutdownOptions,
+  ShutdownSummary,
+  TaskQueueOptions,
+} from './types.js';
+
+const DEFAULT_QUEUE = 'default';
+const DEFAULT_PRIORITY = 5;
+const DEFAULT_MAX_RETRIES = 3;
+const DEFAULT_BASE_DELAY = 1000;
+const DEFAULT_SHUTDOWN_TIMEOUT = 30_000;
+
+/** A middleware function in a queue's processing pipeline. */
+export type Middleware = (task: Task, next: () => Promise<void>) => void | Promise<void>;
+
+/** The terminal handler invoked after all middleware have run. */
+export type Handler = (task: Task) => void | Promise<void>;
+
+/** A progress listener. */
+export type ProgressListener = (percent: number, message: string | undefined, task: Task) => void;
+
+/** A registered recurring schedule. */
+export interface Schedule {
+  id: string;
+  cron: ParsedCron;
+  queue: string;
+  template: unknown;
+  options: AddOptions;
+  nextRun: number;
+}
+
+interface QueueState {
+  name: string;
+  /** Tasks that have not yet been retrieved (pending/delayed/blocked). */
+  tasks: Task[];
+  /** Ids of tasks currently in the processing state. */
+  processing: Set<string>;
+  /** Dead-lettered tasks for this queue. */
+  dlq: Task[];
+  /** Maximum simultaneous processing tasks, or null for unlimited. */
+  concurrency: number | null;
+  middleware: Middleware[];
+  handler?: Handler;
+}
+
+let scheduleCounter = 0;
+
+/**
+ * In-memory task queue manager. Manages multiple independent named queues, with
+ * support for priorities, delays, retries, dead-lettering, dependencies,
+ * concurrency limits, progress/cancellation, recurring schedules, middleware
+ * pipelines and graceful shutdown.
+ */
+export class TaskQueue {
+  private readonly queues = new Map<string, QueueState>();
+  private readonly tasksById = new Map<string, Task>();
+  private readonly schedules = new Map<string, Schedule>();
+  private readonly progressListeners = new Map<string, Set<ProgressListener>>();
+  private readonly shutdownCallbacks: Array<() => void | Promise<void>> = [];
+  private readonly now: () => number;
+
+  private seqCounter = 0;
+  private shuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+
+  constructor(options: TaskQueueOptions = {}) {
+    this.now = options.now ?? Date.now;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Queue bookkeeping
+  // ---------------------------------------------------------------------------
+
+  private getOrCreateQueue(name: string): QueueState {
+    let q = this.queues.get(name);
+    if (!q) {
+      q = {
+        name,
+        tasks: [],
+        processing: new Set(),
+        dlq: [],
+        concurrency: null,
+        middleware: [],
+      };
+      this.queues.set(name, q);
+    }
+    return q;
+  }
+
+  /** Lists the names of all queues that currently exist. */
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 1-7: adding tasks
+  // ---------------------------------------------------------------------------
+
+  /** Adds a task and returns it. Throws after shutdown has been initiated. */
+  add<T = unknown>(payload: T, options: AddOptions = {}): Task<T> {
+    if (this.shuttingDown) {
+      throw new Error('Cannot add tasks: the queue is shutting down');
+    }
+
+    const queueName = options.queue ?? DEFAULT_QUEUE;
+    const priority = options.priority ?? DEFAULT_PRIORITY;
+    if (!Number.isInteger(priority) || priority < 1 || priority > 10) {
+      throw new RangeError(`Invalid priority ${priority}: must be an integer 1-10`);
+    }
+
+    const maxRetries = options.maxRetries ?? DEFAULT_MAX_RETRIES;
+    if (!Number.isInteger(maxRetries) || maxRetries < 0) {
+      throw new RangeError(`Invalid maxRetries ${maxRetries}: must be a non-negative integer`);
+    }
+
+    const baseDelay = options.baseDelay ?? DEFAULT_BASE_DELAY;
+    if (!Number.isFinite(baseDelay) || baseDelay < 0) {
+      throw new RangeError(`Invalid baseDelay ${baseDelay}: must be a non-negative number`);
+    }
+
+    const now = this.now();
+    let availableAt = now;
+    if (options.runAt !== undefined) {
+      availableAt = options.runAt;
+    } else if (options.delay !== undefined) {
+      if (!Number.isFinite(options.delay) || options.delay < 0) {
+        throw new RangeError(`Invalid delay ${options.delay}: must be a non-negative number`);
+      }
+      availableAt = now + options.delay;
+    }
+
+    const dependencies = options.dependencies ? [...options.dependencies] : [];
+    this.validateDependencies(dependencies);
+
+    const queue = this.getOrCreateQueue(queueName);
+    const task = new Task<T>({
+      seq: this.seqCounter++,
+      now,
+      queue: queueName,
+      payload,
+      status: 'pending',
+      priority,
+      availableAt,
+      maxRetries,
+      baseDelay,
+      dependencies,
+      metadata: options.metadata ? { ...options.metadata } : {},
+    });
+    task.status = this.computeWaitingStatus(task, now);
+
+    queue.tasks.push(task);
+    this.tasksById.set(task.id, task);
+    return task;
+  }
+
+  private validateDependencies(dependencies: string[]): void {
+    for (const depId of dependencies) {
+      if (!this.tasksById.has(depId)) {
+        throw new Error(`Cannot depend on non-existent task "${depId}"`);
+      }
+    }
+    if (dependencies.length === 0) return;
+
+    // Build the full dependency graph plus a synthetic node for the new task and
+    // check for cycles reachable from it.
+    const NEW = '__new__';
+    const edges = new Map<string, string[]>();
+    for (const [id, task] of this.tasksById) {
+      edges.set(id, task.dependencies);
+    }
+    edges.set(NEW, dependencies);
+    if (hasCycle(NEW, edges)) {
+      throw new Error('Circular dependency detected');
+    }
+  }
+
+  /** Computes whether a not-yet-processed task is blocked, delayed or pending. */
+  private computeWaitingStatus(task: Task, now: number): 'pending' | 'delayed' | 'blocked' {
+    if (!this.dependenciesSatisfied(task)) return 'blocked';
+    if (task.availableAt > now) return 'delayed';
+    return 'pending';
+  }
+
+  private dependenciesSatisfied(task: Task): boolean {
+    return task.dependencies.every((id) => this.tasksById.get(id)?.status === 'completed');
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 1-4, 8: retrieving tasks
+  // ---------------------------------------------------------------------------
+
+  /**
+   * Retrieves the next available task from `queueName`, transitioning it to
+   * `processing`. Returns null if nothing is available or the concurrency limit
+   * has been reached.
+   */
+  next(queueName: string = DEFAULT_QUEUE): Task | null {
+    const queue = this.queues.get(queueName);
+    if (!queue) return null;
+
+    if (queue.concurrency !== null && queue.processing.size >= queue.concurrency) {
+      return null;
+    }
+
+    const now = this.now();
+    let best: Task | null = null;
+    let bestIndex = -1;
+    for (let i = 0; i < queue.tasks.length; i++) {
+      const task = queue.tasks[i];
+      if (!this.isReady(task, now)) continue;
+      if (best === null || this.compare(task, best) < 0) {
+        best = task;
+        bestIndex = i;
+      }
+    }
+    if (best === null) return null;
+
+    queue.tasks.splice(bestIndex, 1);
+    best.status = 'processing';
+    best.attempts++;
+    queue.processing.add(best.id);
+    return best;
+  }
+
+  private isReady(task: Task, now: number): boolean {
+    if (task.availableAt > now) return false;
+    return this.dependenciesSatisfied(task);
+  }
+
+  /** Comparator: lower is "first". (priority, availableAt, seq). */
+  private compare(a: Task, b: Task): number {
+    if (a.priority !== b.priority) return a.priority - b.priority;
+    if (a.availableAt !== b.availableAt) return a.availableAt - b.availableAt;
+    return a.seq - b.seq;
+  }
+
+  /** Number of tasks waiting (not yet retrieved) in a queue. */
+  size(queueName: string = DEFAULT_QUEUE): number {
+    return this.queues.get(queueName)?.tasks.length ?? 0;
+  }
+
+  /** Look up a task by id. */
+  getTask(taskId: string): Task | undefined {
+    return this.tasksById.get(taskId);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 5-6: completion, failure, retry, dead-letter
+  // ---------------------------------------------------------------------------
+
+  /** Marks a processing task as completed. */
+  complete(taskId: string, result?: unknown): Task {
+    const task = this.requireTask(taskId);
+    const queue = this.getOrCreateQueue(task.queue);
+    queue.processing.delete(task.id);
+
+    if (task.cancelled) {
+      return task; // already cancelled; do not resurrect
+    }
+
+    task.status = 'completed';
+    task.result = result;
+    this.onTaskCompleted(task);
+    return task;
+  }
+
+  /** Marks a processing task as failed, retrying or dead-lettering as needed. */
+  fail(taskId: string, error?: unknown): Task {
+    const task = this.requireTask(taskId);
+    const queue = this.getOrCreateQueue(task.queue);
+    queue.processing.delete(task.id);
+
+    task.error = this.toTaskError(error);
+
+    if (task.cancelled) {
+      return task; // cancelled tasks are never retried
+    }
+
+    // attempts has already been incremented at retrieval time. A task is
+    // allowed `maxRetries` retries after its first attempt.
+    if (task.attempts <= task.maxRetries) {
+      const backoff = task.baseDelay * Math.pow(2, task.attempts - 1);
+      task.availableAt = this.now() + backoff;
+      task.status = this.computeWaitingStatus(task, this.now());
+      queue.tasks.push(task);
+      return task;
+    }
+
+    // Retries exhausted: terminal failure + dead-letter.
+    task.status = 'failed';
+    queue.dlq.push(task);
+    return task;
+  }
+
+  private onTaskCompleted(completed: Task): void {
+    // Unblock any tasks whose dependencies are now all satisfied.
+    for (const task of this.tasksById.values()) {
+      if (task.status !== 'blocked') continue;
+      if (!task.dependencies.includes(completed.id)) continue;
+      if (this.dependenciesSatisfied(task)) {
+        task.status = this.computeWaitingStatus(task, this.now());
+      }
+    }
+  }
+
+  private toTaskError(error: unknown): { message: string; stack?: string; at: number } {
+    const at = this.now();
+    if (error instanceof Error) {
+      return { message: error.message, stack: error.stack, at };
+    }
+    if (error === undefined) {
+      return { message: 'Task failed', at };
+    }
+    return { message: String(error), at };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 6: dead letter queue management
+  // ---------------------------------------------------------------------------
+
+  /** Returns the dead-lettered tasks for a queue. */
+  getDeadLetter(queueName: string = DEFAULT_QUEUE): Task[] {
+    return [...(this.queues.get(queueName)?.dlq ?? [])];
+  }
+
+  /** Moves a dead-lettered task back to its original queue for fresh retries. */
+  retryDeadLetter(taskId: string): Task {
+    for (const queue of this.queues.values()) {
+      const index = queue.dlq.findIndex((t) => t.id === taskId);
+      if (index === -1) continue;
+      const [task] = queue.dlq.splice(index, 1);
+      task.attempts = 0;
+      task.error = undefined;
+      task.availableAt = this.now();
+      task.status = this.computeWaitingStatus(task, this.now());
+      queue.tasks.push(task);
+      return task;
+    }
+    throw new Error(`Task "${taskId}" is not in any dead letter queue`);
+  }
+
+  /** Clears all dead-lettered tasks for a queue. */
+  clearDeadLetter(queueName: string = DEFAULT_QUEUE): void {
+    const queue = this.queues.get(queueName);
+    if (queue) queue.dlq = [];
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 7: dependency inspection
+  // ---------------------------------------------------------------------------
+
+  /** Inspects the dependency resolution state of a task. */
+  getDependencyStatus(taskId: string): DependencyStatus {
+    const task = this.requireTask(taskId);
+    const dependencies = task.dependencies.map((id) => {
+      const dep = this.tasksById.get(id);
+      return {
+        id,
+        status: dep ? dep.status : ('unknown' as const),
+        satisfied: dep?.status === 'completed',
+      };
+    });
+    const satisfied = dependencies.every((d) => d.satisfied);
+    return { dependencies, satisfied, blocked: task.status === 'blocked' };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 8: concurrency control
+  // ---------------------------------------------------------------------------
+
+  /** Sets the concurrency limit for a queue (null/undefined => unlimited). */
+  setConcurrency(queueName: string, limit: number | null): void {
+    if (limit !== null && (!Number.isInteger(limit) || limit < 1)) {
+      throw new RangeError(`Invalid concurrency ${limit}: must be a positive integer or null`);
+    }
+    this.getOrCreateQueue(queueName).concurrency = limit;
+  }
+
+  /** Returns the concurrency limit for a queue (null => unlimited). */
+  getConcurrency(queueName: string = DEFAULT_QUEUE): number | null {
+    return this.queues.get(queueName)?.concurrency ?? null;
+  }
+
+  /** Returns how many tasks are currently processing in a queue. */
+  getActiveCount(queueName: string = DEFAULT_QUEUE): number {
+    return this.queues.get(queueName)?.processing.size ?? 0;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 9: progress + cancellation
+  // ---------------------------------------------------------------------------
+
+  /** Reports progress (0-100) for a task and notifies any listeners. */
+  reportProgress(taskId: string, percent: number, message?: string): void {
+    if (!Number.isFinite(percent) || percent < 0 || percent > 100) {
+      throw new RangeError(`Invalid progress ${percent}: must be between 0 and 100`);
+    }
+    const task = this.requireTask(taskId);
+    task.progress = { percent, message };
+    const listeners = this.progressListeners.get(taskId);
+    if (listeners) {
+      for (const listener of listeners) listener(percent, message, task);
+    }
+  }
+
+  /** Returns the current progress for a task. */
+  getProgress(taskId: string): { percent: number; message?: string } {
+    return { ...this.requireTask(taskId).progress };
+  }
+
+  /** Subscribes to progress updates for a task. Returns an unsubscribe function. */
+  onProgress(taskId: string, listener: ProgressListener): () => void {
+    let set = this.progressListeners.get(taskId);
+    if (!set) {
+      set = new Set();
+      this.progressListeners.set(taskId, set);
+    }
+    set.add(listener);
+    return () => {
+      set?.delete(listener);
+    };
+  }
+
+  /**
+   * Cancels a pending or processing task. Returns true if the task was
+   * cancelled, false if it was already in a terminal state.
+   */
+  cancel(taskId: string): boolean {
+    const task = this.requireTask(taskId);
+    const queue = this.queues.get(task.queue);
+
+    if (task.status === 'pending' || task.status === 'delayed' || task.status === 'blocked') {
+      if (queue) {
+        const index = queue.tasks.findIndex((t) => t.id === task.id);
+        if (index !== -1) queue.tasks.splice(index, 1);
+      }
+      task.cancelled = true;
+      task.status = 'cancelled';
+      task.abort();
+      return true;
+    }
+
+    if (task.status === 'processing') {
+      if (queue) queue.processing.delete(task.id);
+      task.cancelled = true;
+      task.status = 'cancelled';
+      task.abort();
+      return true;
+    }
+
+    return false; // already completed/failed/cancelled
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 10: recurring schedules
+  // ---------------------------------------------------------------------------
+
+  /** Registers a recurring schedule and returns it. */
+  schedule(cron: string, queueName: string, template: unknown, options: AddOptions = {}): Schedule {
+    const parsed = parseCron(cron);
+    const id = `schedule-${scheduleCounter++}`;
+    const schedule: Schedule = {
+      id,
+      cron: parsed,
+      queue: queueName,
+      template,
+      options: { ...options, queue: queueName },
+      nextRun: nextOccurrence(parsed, this.now()),
+    };
+    this.schedules.set(id, schedule);
+    return schedule;
+  }
+
+  /** Removes a schedule, stopping future occurrences. Returns true if removed. */
+  unschedule(scheduleId: string): boolean {
+    return this.schedules.delete(scheduleId);
+  }
+
+  /** Lists all active schedules. */
+  listSchedules(): Schedule[] {
+    return [...this.schedules.values()];
+  }
+
+  /**
+   * Evaluates all schedules and enqueues tasks for any that are due at `now`.
+   * Returns the tasks that were created.
+   */
+  tick(now: number = this.now()): Task[] {
+    if (this.shuttingDown) return [];
+    const created: Task[] = [];
+    for (const schedule of this.schedules.values()) {
+      if (schedule.nextRun <= now) {
+        created.push(this.add(schedule.template, schedule.options));
+        schedule.nextRun = nextOccurrence(schedule.cron, now);
+      }
+    }
+    return created;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 11: middleware pipeline
+  // ---------------------------------------------------------------------------
+
+  /** Registers a middleware on a queue's processing pipeline. */
+  use(queueName: string, middleware: Middleware): void {
+    this.getOrCreateQueue(queueName).middleware.push(middleware);
+  }
+
+  /** Registers the terminal handler for a queue. */
+  setHandler(queueName: string, handler: Handler): void {
+    this.getOrCreateQueue(queueName).handler = handler;
+  }
+
+  /**
+   * Retrieves the next available task and runs it through the queue's middleware
+   * pipeline and handler, finalizing the task (complete/fail) automatically.
+   * Returns the processed task, or null if nothing was available.
+   */
+  async runNext(queueName: string = DEFAULT_QUEUE): Promise<Task | null> {
+    const task = this.next(queueName);
+    if (!task) return null;
+    const queue = this.getOrCreateQueue(queueName);
+
+    const dispatch = async (i: number): Promise<void> => {
+      const mw = queue.middleware[i];
+      if (mw) {
+        await mw(task, () => dispatch(i + 1));
+      } else if (queue.handler) {
+        await queue.handler(task);
+      }
+    };
+
+    try {
+      await dispatch(0);
+    } catch (err) {
+      this.fail(task.id, err);
+      return task;
+    }
+
+    if (task.cancelled) return task;
+    this.complete(task.id, task.result);
+    return task;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 12: graceful shutdown
+  // ---------------------------------------------------------------------------
+
+  /** Registers a callback to run during shutdown. */
+  onShutdown(callback: () => void | Promise<void>): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  /** Returns whether shutdown has been initiated. */
+  isShuttingDown(): boolean {
+    return this.shuttingDown;
+  }
+
+  /**
+   * Initiates an orderly shutdown: stops accepting new tasks, runs shutdown
+   * callbacks, waits for processing tasks (up to `timeout` ms), force-cancels
+   * any stragglers, and returns a summary. Idempotent.
+   */
+  shutdown(options: ShutdownOptions = {}): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+    this.shuttingDown = true;
+    this.shutdownPromise = this.doShutdown(options.timeout ?? DEFAULT_SHUTDOWN_TIMEOUT);
+    return this.shutdownPromise;
+  }
+
+  private async doShutdown(timeout: number): Promise<ShutdownSummary> {
+    const start = Date.now();
+
+    for (const cb of this.shutdownCallbacks) {
+      await cb();
+    }
+
+    const initial: Task[] = [];
+    for (const queue of this.queues.values()) {
+      for (const id of queue.processing) {
+        const task = this.tasksById.get(id);
+        if (task) initial.push(task);
+      }
+    }
+
+    while (this.totalProcessing() > 0 && Date.now() - start < timeout) {
+      await sleep(5);
+    }
+
+    let completed = 0;
+    let forceCancelled = 0;
+    for (const task of initial) {
+      if (task.status === 'processing') {
+        this.cancel(task.id);
+        forceCancelled++;
+      } else {
+        completed++;
+      }
+    }
+
+    return { completed, forceCancelled, durationMs: Date.now() - start };
+  }
+
+  private totalProcessing(): number {
+    let total = 0;
+    for (const queue of this.queues.values()) total += queue.processing.size;
+    return total;
+  }
+
+  // ---------------------------------------------------------------------------
+
+  private requireTask(taskId: string): Task {
+    const task = this.tasksById.get(taskId);
+    if (!task) throw new Error(`Unknown task "${taskId}"`);
+    return task;
+  }
+}
+
+function sleep(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
