diff --git a/src/analytics/index.ts b/src/analytics/index.ts
new file mode 100644
index 0000000..9b779c0
--- /dev/null
+++ b/src/analytics/index.ts
@@ -0,0 +1,77 @@
+import { EventBus } from '../bus.js';
+import {
+  AnalyticsService,
+  PaymentStatus,
+  Events,
+  CartUpdatedEvent,
+  OrderCreatedEvent,
+  PaymentProcessedEvent,
+} from '../types.js';
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const uniqueCarts = new Set<string>();
+  const cartItems = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const orderTotals = new Map<string, number>();
+  const productCounts = new Map<string, number>();
+  let revenue = 0;
+  let orderCount = 0;
+
+  // Domain reactions keyed by event. The EventBus awaits each handler in turn,
+  // so only the first-registered handler for an event runs synchronously during
+  // emit(). Registering a single combined handler per event (count + domain
+  // logic) keeps analytics state consistent with synchronous queries whenever
+  // analytics is the first subscriber for that event.
+  const domain: Record<string, (payload: unknown) => void> = {
+    [Events.CART_UPDATED]: (payload) => {
+      const e = payload as CartUpdatedEvent;
+      uniqueCarts.add(e.cartId);
+      cartItems.set(e.cartId, e.items.map((i) => ({ ...i })));
+    },
+    [Events.ORDER_CREATED]: (payload) => {
+      const e = payload as OrderCreatedEvent;
+      orderCount += 1;
+      orderTotals.set(e.orderId, e.total);
+      const items = cartItems.get(e.cartId) ?? [];
+      for (const item of items) {
+        productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+      }
+    },
+    [Events.PAYMENT_PROCESSED]: (payload) => {
+      const e = payload as PaymentProcessedEvent;
+      if (e.status === PaymentStatus.SUCCESS) {
+        revenue += orderTotals.get(e.orderId) ?? 0;
+      }
+    },
+  };
+
+  for (const eventName of Object.values(Events)) {
+    const react = domain[eventName];
+    bus.on(eventName, (payload) => {
+      eventCounts.set(eventName, (eventCounts.get(eventName) ?? 0) + 1);
+      if (react) react(payload);
+    });
+  }
+
+  return {
+    getEventCount(eventType: string): number {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue(): number {
+      return revenue;
+    },
+
+    getConversionRate(): number {
+      if (uniqueCarts.size === 0) return 0;
+      return orderCount / uniqueCarts.size;
+    },
+
+    getTopProducts(limit: number) {
+      return [...productCounts.entries()]
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count)
+        .slice(0, limit);
+    },
+  };
+}
