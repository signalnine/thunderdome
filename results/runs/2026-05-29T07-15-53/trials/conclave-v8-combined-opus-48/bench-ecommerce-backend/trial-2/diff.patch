diff --git a/tests/services.test.ts b/tests/services.test.ts
new file mode 100644
index 0000000..9deac20
--- /dev/null
+++ b/tests/services.test.ts
@@ -0,0 +1,287 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import { EventBus } from '../src/bus.js';
+import {
+  createCatalogService,
+  createInventoryService,
+  createCartService,
+  createPricingService,
+  createOrderService,
+  createPaymentService,
+  createNotificationService,
+  createAnalyticsService,
+} from '../src/index.js';
+import { OrderStatus, PaymentStatus, Events } from '../src/types.js';
+
+let bus: EventBus;
+beforeEach(() => {
+  bus = new EventBus();
+});
+
+describe('Catalog', () => {
+  it('creates, retrieves, lists, searches, updates, removes', () => {
+    const c = createCatalogService(bus);
+    const id = c.createProduct('Red Shoe', 50, 'footwear');
+    expect(c.getProduct(id)).toEqual({ id, name: 'Red Shoe', price: 50, category: 'footwear' });
+    expect(c.getProduct('nope')).toBeNull();
+
+    const id2 = c.createProduct('Blue Hat', 20, 'headwear');
+    expect(c.listProducts()).toHaveLength(2);
+    expect(c.listProducts('footwear')).toEqual([{ id, name: 'Red Shoe', price: 50, category: 'footwear' }]);
+
+    expect(c.searchProducts('shoe').map((p) => p.id)).toEqual([id]);
+    expect(c.searchProducts('HEADWEAR').map((p) => p.id)).toEqual([id2]);
+
+    c.updateProduct(id, { price: 45 });
+    expect(c.getProduct(id)!.price).toBe(45);
+    c.updateProduct('nope', { price: 1 }); // no-op
+
+    expect(c.removeProduct(id)).toBe(true);
+    expect(c.removeProduct(id)).toBe(false);
+    expect(c.getProduct(id)).toBeNull();
+  });
+
+  it('emits PRODUCT_CREATED', async () => {
+    const c = createCatalogService(bus);
+    const seen: unknown[] = [];
+    bus.on(Events.PRODUCT_CREATED, (p) => seen.push(p));
+    const id = c.createProduct('X', 10, 'cat');
+    expect(seen).toEqual([{ productId: id, name: 'X', price: 10, category: 'cat' }]);
+  });
+});
+
+describe('Inventory', () => {
+  it('sets, gets, reserves, releases', () => {
+    const inv = createInventoryService(bus);
+    expect(inv.getStock('p')).toBe(0);
+    inv.setStock('p', 10);
+    expect(inv.getStock('p')).toBe(10);
+    expect(inv.reserve('p', 4)).toBe(true);
+    expect(inv.getStock('p')).toBe(6);
+    expect(inv.reserve('p', 100)).toBe(false);
+    expect(inv.getStock('p')).toBe(6);
+    inv.release('p', 4);
+    expect(inv.getStock('p')).toBe(10);
+  });
+
+  it('emits INVENTORY_UPDATED', async () => {
+    const inv = createInventoryService(bus);
+    const seen: unknown[] = [];
+    bus.on(Events.INVENTORY_UPDATED, (p) => seen.push(p));
+    inv.setStock('p', 5);
+    expect(seen).toEqual([{ productId: 'p', quantity: 5 }]);
+  });
+
+  it('alerts low stock below threshold only when set', () => {
+    const inv = createInventoryService(bus);
+    const alerts: unknown[] = [];
+    bus.on(Events.LOW_STOCK_ALERT, (p) => alerts.push(p));
+    inv.setStock('p', 3);
+    expect(alerts).toHaveLength(0); // no threshold
+    inv.setLowStockThreshold('p', 5);
+    expect(alerts).toEqual([{ productId: 'p', currentQuantity: 3, threshold: 5 }]);
+    inv.reserve('p', 1); // now 2, below 5
+    expect(alerts).toHaveLength(2);
+  });
+});
+
+describe('Cart', () => {
+  it('consolidates, removes, updates, clears, emits', () => {
+    const cart = createCartService(bus);
+    const seen: unknown[] = [];
+    bus.on(Events.CART_UPDATED, (p) => seen.push(p));
+    const id = cart.createCart('u1');
+    expect(cart.getCart(id)).toEqual({ id, userId: 'u1', items: [] });
+    expect(cart.getCart('nope')).toBeNull();
+
+    cart.addItem(id, 'p1', 2);
+    cart.addItem(id, 'p1', 3); // consolidate -> 5
+    expect(cart.getCart(id)!.items).toEqual([{ productId: 'p1', quantity: 5 }]);
+
+    cart.addItem(id, 'p2', 1);
+    cart.updateQuantity(id, 'p1', 1);
+    expect(cart.getCart(id)!.items).toContainEqual({ productId: 'p1', quantity: 1 });
+    cart.updateQuantity(id, 'p2', 0); // removes
+    expect(cart.getCart(id)!.items).toEqual([{ productId: 'p1', quantity: 1 }]);
+    cart.updateQuantity(id, 'p3', 4); // adds
+    expect(cart.getCart(id)!.items).toContainEqual({ productId: 'p3', quantity: 4 });
+
+    cart.removeItem(id, 'p1');
+    expect(cart.getCart(id)!.items.find((i) => i.productId === 'p1')).toBeUndefined();
+
+    cart.clearCart(id);
+    expect(cart.getCart(id)!.items).toEqual([]);
+    expect(seen.length).toBeGreaterThan(0);
+  });
+});
+
+describe('Pricing', () => {
+  it('calculates subtotal, tax, total', () => {
+    const pr = createPricingService(bus);
+    const r = pr.calculateTotal([{ productId: 'p', quantity: 2, price: 50 }]);
+    expect(r).toEqual({ subtotal: 100, discount: 0, tax: 10, total: 110 });
+  });
+
+  it('applies discount before tax', () => {
+    const pr = createPricingService(bus);
+    pr.addDiscountCode('SAVE10', 10);
+    const r = pr.calculateTotal([{ productId: 'p', quantity: 1, price: 100 }], 'SAVE10');
+    expect(r).toEqual({ subtotal: 100, discount: 10, tax: 9, total: 99 });
+  });
+
+  it('unknown discount code => 0 discount', () => {
+    const pr = createPricingService(bus);
+    const r = pr.calculateTotal([{ productId: 'p', quantity: 1, price: 100 }], 'NOPE');
+    expect(r.discount).toBe(0);
+  });
+
+  it('tracks prices from PRODUCT_CREATED', async () => {
+    const pr = createPricingService(bus);
+    expect(pr.getPrice('p')).toBe(0);
+    await bus.emit(Events.PRODUCT_CREATED, { productId: 'p', name: 'X', price: 42, category: 'c' });
+    expect(pr.getPrice('p')).toBe(42);
+  });
+});
+
+describe('Orders', () => {
+  it('creates pending order and emits ORDER_CREATED', async () => {
+    const o = createOrderService(bus);
+    const seen: unknown[] = [];
+    bus.on(Events.ORDER_CREATED, (p) => seen.push(p));
+    const id = o.createOrder('u1', 'cart_1', 110);
+    expect(o.getOrder(id)).toEqual({ id, userId: 'u1', status: OrderStatus.PENDING, total: 110 });
+    expect(seen).toEqual([{ orderId: id, userId: 'u1', cartId: 'cart_1', total: 110 }]);
+    expect(o.getOrder('nope')).toBeNull();
+  });
+
+  it('progresses through lifecycle and emits previousStatus', async () => {
+    const o = createOrderService(bus);
+    const seen: any[] = [];
+    bus.on(Events.ORDER_STATUS_CHANGED, (p) => seen.push(p));
+    const id = o.createOrder('u1', 'c', 10);
+    o.updateStatus(id, OrderStatus.CONFIRMED);
+    o.updateStatus(id, OrderStatus.SHIPPED);
+    o.updateStatus(id, OrderStatus.DELIVERED);
+    expect(seen.map((e) => e.status)).toEqual([OrderStatus.CONFIRMED, OrderStatus.SHIPPED, OrderStatus.DELIVERED]);
+    expect(seen[0].previousStatus).toBe(OrderStatus.PENDING);
+    expect(seen[2].previousStatus).toBe(OrderStatus.SHIPPED);
+  });
+
+  it('rejects invalid transition and missing order', () => {
+    const o = createOrderService(bus);
+    const id = o.createOrder('u1', 'c', 10);
+    expect(() => o.updateStatus(id, OrderStatus.DELIVERED)).toThrow();
+    expect(() => o.updateStatus('nope', OrderStatus.CONFIRMED)).toThrow();
+  });
+
+  it('can cancel from pending; lists by user', () => {
+    const o = createOrderService(bus);
+    const id = o.createOrder('u1', 'c', 10);
+    o.createOrder('u2', 'c', 20);
+    o.updateStatus(id, OrderStatus.CANCELLED);
+    expect(o.getOrder(id)!.status).toBe(OrderStatus.CANCELLED);
+    expect(o.listOrders('u1')).toHaveLength(1);
+  });
+});
+
+describe('Payment', () => {
+  it('succeeds by default with transactionId and emits', async () => {
+    const pay = createPaymentService(bus);
+    const seen: unknown[] = [];
+    bus.on(Events.PAYMENT_PROCESSED, (p) => seen.push(p));
+    const r = await pay.processPayment('order_1', 100);
+    expect(r.status).toBe(PaymentStatus.SUCCESS);
