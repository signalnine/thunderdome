@@ -0,0 +1,56 @@
+import { EventBus } from '../bus.js';
+import { OrderService, OrderStatus, Events, OrderCreatedEvent, OrderStatusChangedEvent } from '../types.js';
+
+interface Order {
+  id: string;
+  userId: string;
+  cartId: string;
+  status: OrderStatus;
+  total: number;
+}
+
+const VALID_TRANSITIONS: Record<OrderStatus, OrderStatus[]> = {
+  [OrderStatus.PENDING]: [OrderStatus.CONFIRMED, OrderStatus.CANCELLED],
+  [OrderStatus.CONFIRMED]: [OrderStatus.SHIPPED, OrderStatus.CANCELLED],
+  [OrderStatus.SHIPPED]: [OrderStatus.DELIVERED, OrderStatus.CANCELLED],
+  [OrderStatus.DELIVERED]: [],
+  [OrderStatus.CANCELLED]: [],
+};
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, Order>();
+  let counter = 0;
+
+  return {
+    createOrder(userId: string, cartId: string, total: number): string {
+      const id = `order_${++counter}`;
+      orders.set(id, { id, userId, cartId, status: OrderStatus.PENDING, total });
+      const payload: OrderCreatedEvent = { orderId: id, userId, cartId, total };
+      void bus.emit(Events.ORDER_CREATED, payload);
+      return id;
+    },
+
+    getOrder(orderId: string) {
+      const o = orders.get(orderId);
+      return o ? { id: o.id, userId: o.userId, status: o.status, total: o.total } : null;
+    },
+
+    updateStatus(orderId: string, status: OrderStatus): void {
+      const o = orders.get(orderId);
+      if (!o) throw new Error(`Order not found: ${orderId}`);
+      const previousStatus = o.status;
+      if (!VALID_TRANSITIONS[previousStatus].includes(status)) {
+        throw new Error(`Invalid status transition: ${previousStatus} -> ${status}`);
+      }
+      o.status = status;
+      const payload: OrderStatusChangedEvent = { orderId, status, previousStatus };
+      void bus.emit(Events.ORDER_STATUS_CHANGED, payload);
+    },
+
+    listOrders(userId: string) {
+      return [...orders.values()]
+        .filter((o) => o.userId === userId)
+        .map((o) => ({ id: o.id, status: o.status, total: o.total }));
+    },
+  };
+}
diff --git a/src/payment/index.ts b/src/payment/index.ts
new file mode 100644
index 0000000..5c73bc2
--- /dev/null
+++ b/src/payment/index.ts
@@ -0,0 +1,65 @@
+import { EventBus } from '../bus.js';
+import { PaymentService, PaymentStatus, Events, PaymentProcessedEvent } from '../types.js';
+
+export interface PaymentOptions {
+  /** Forces the outcome of every processPayment call. Defaults to 'success'. */
+  mode?: 'success' | 'failure' | 'timeout';
+  /** Simulated processing delay in milliseconds. Defaults to 0. */
+  delay?: number;
+}
+
+interface Transaction {
+  transactionId: string;
+  orderId: string;
+  amount: number;
+  status: PaymentStatus;
+  refunded: boolean;
+}
+
+function wait(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentOptions = {}): PaymentService {
+  const mode = options.mode ?? 'success';
+  const delay = options.delay ?? 0;
+  const transactions = new Map<string, Transaction>();
+  let counter = 0;
+
+  return {
+    async processPayment(orderId: string, amount: number) {
+      if (delay > 0) await wait(delay);
+
+      let result: { status: PaymentStatus; transactionId?: string; error?: string };
+
+      if (mode === 'failure') {
+        result = { status: PaymentStatus.FAILED, error: 'Payment failed' };
+      } else if (mode === 'timeout') {
+        result = { status: PaymentStatus.TIMEOUT, error: 'Payment timed out' };
+      } else {
+        const transactionId = `txn_${++counter}`;
+        transactions.set(transactionId, {
+          transactionId,
+          orderId,
+          amount,
+          status: PaymentStatus.SUCCESS,
+          refunded: false,
+        });
+        result = { status: PaymentStatus.SUCCESS, transactionId };
+      }
+
+      const payload: PaymentProcessedEvent = { orderId, ...result };
+      await bus.emit(Events.PAYMENT_PROCESSED, payload);
+      return result;
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      const txn = transactions.get(transactionId);
+      if (!txn || txn.status !== PaymentStatus.SUCCESS || txn.refunded) {
+        return false;
+      }
+      txn.refunded = true;
+      return true;
+    },
+  };
+}
