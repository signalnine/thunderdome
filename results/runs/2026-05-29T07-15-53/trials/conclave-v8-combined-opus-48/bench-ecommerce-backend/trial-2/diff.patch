+++ b/src/pricing/index.ts
@@ -0,0 +1,46 @@
+import { EventBus } from '../bus.js';
+import { PricingService, Events, ProductCreatedEvent } from '../types.js';
+
+const TAX_RATE = 0.1;
+
+export function createPricingService(bus: EventBus): PricingService {
+  const discounts = new Map<string, number>();
+  const prices = new Map<string, number>();
+
+  bus.on(Events.PRODUCT_CREATED, (payload) => {
+    const e = payload as ProductCreatedEvent;
+    prices.set(e.productId, e.price);
+  });
+
+  function round(n: number): number {
+    return Math.round(n * 100) / 100;
+  }
+
+  return {
+    calculateTotal(items, discountCode?) {
+      const subtotal = items.reduce((sum, i) => sum + i.price * i.quantity, 0);
+      let discount = 0;
+      if (discountCode !== undefined && discounts.has(discountCode)) {
+        const pct = discounts.get(discountCode)!;
+        discount = subtotal * (pct / 100);
+      }
+      const taxable = subtotal - discount;
+      const tax = taxable * TAX_RATE;
+      const total = taxable + tax;
+      return {
+        subtotal: round(subtotal),
+        discount: round(discount),
+        tax: round(tax),
+        total: round(total),
+      };
+    },
+
+    addDiscountCode(code: string, percentage: number): void {
+      discounts.set(code, percentage);
+    },
+
+    getPrice(productId: string): number {
+      return prices.get(productId) ?? 0;
+    },
+  };
+}
