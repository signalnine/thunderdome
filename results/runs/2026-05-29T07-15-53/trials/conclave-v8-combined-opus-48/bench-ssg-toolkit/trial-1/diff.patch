+import { BuildContext, Plugin } from '../core/types.js';
+import { AssetManifest } from './asset-pipeline.js';
+
+export interface DevServerRoute {
+  path: string;
+  handler: 'static' | 'asset';
+}
+
+export interface DevServerConfig {
+  port: number;
+  routes: DevServerRoute[];
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+const DEFAULT_PORT = 3000;
+
+/**
+ * Dev server plugin.
+ *
+ * Synthesises a development-server configuration (routes, asset paths and the
+ * search index location) from the build output and the asset manifest.
+ */
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const manifest = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+        const assetPaths = manifest ? [...manifest.assets] : [];
+
+        const routes: DevServerRoute[] = [];
+        for (const key of ctx.output.keys()) {
+          if (key.endsWith('.html')) {
+            routes.push({ path: `/${key}`, handler: 'static' });
+          }
+        }
+        for (const asset of assetPaths) {
+          routes.push({ path: `/assets/${asset}`, handler: 'asset' });
+        }
+
+        const config: DevServerConfig = {
+          port: DEFAULT_PORT,
+          routes,
+          assetPaths,
+          searchIndexPath: ctx.output.has('search-index.json') ? '/search-index.json' : '',
+        };
+
+        ctx.data.set('dev-server-config', config);
+      },
+    },
+  };
+}
