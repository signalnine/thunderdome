@@ -0,0 +1,28 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+const CODE_BLOCK_RE = /<pre>(\s*)<code class="language-([^"]+)">/g;
+
+/**
+ * Syntax highlight plugin.
+ *
+ * Annotates fenced code blocks that declare a `language-*` class: the `<pre>`
+ * gains a `data-language` attribute and the `<code>` gains a `highlighted`
+ * class. Inline code and unlabelled blocks are left untouched.
+ */
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        const content = file.content.replace(
+          CODE_BLOCK_RE,
+          (_match, gap: string, lang: string) =>
+            `<pre data-language="${lang}">${gap}<code class="language-${lang} highlighted">`
+        );
+        return { ...file, content };
+      },
+    },
+  };
+}
diff --git a/src/plugins/taxonomy.ts b/src/plugins/taxonomy.ts
new file mode 100644
index 0000000..26a4e51
--- /dev/null
+++ b/src/plugins/taxonomy.ts
@@ -0,0 +1,73 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;');
+}
+
+function buildIndex(files: ContentFile[], pick: (f: ContentFile) => string[]): Map<string, ContentFile[]> {
+  const map = new Map<string, ContentFile[]>();
+  for (const file of files) {
+    for (const raw of pick(file)) {
+      const key = raw.toLowerCase();
+      const bucket = map.get(key);
+      if (bucket) {
+        bucket.push(file);
+      } else {
+        map.set(key, [file]);
+      }
+    }
+  }
+  return map;
+}
+
+/**
+ * Taxonomy plugin.
+ *
+ * Builds tag and category indices from file front-matter and emits a listing
+ * page for every tag. Indices are exposed via `ctx.data` for downstream
+ * plugins (rss-feed, sitemap).
+ */
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild: (ctx: BuildContext): void => {
+        const tags = buildIndex(ctx.files, (f) => f.tags ?? []);
+        const categories = buildIndex(ctx.files, (f) => {
+          const c = f.metadata.category;
+          return typeof c === 'string' ? [c] : [];
+        });
+        ctx.data.set('taxonomy-tags', tags);
+        ctx.data.set('taxonomy-categories', categories);
+      },
+      afterBuild: (ctx: BuildContext): void => {
+        const tags = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+        if (!tags) return;
+        for (const [tag, files] of tags) {
+          const items = files
+            .map((f) => `    <li><a href="/${f.slug}.html">${escapeHtml(f.title)}</a></li>`)
+            .join('\n');
+          const html = `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>Tag: ${escapeHtml(tag)} | ${escapeHtml(ctx.config.title)}</title>
+</head>
+<body>
+  <h1>Tag: ${escapeHtml(tag)}</h1>
+  <ul>
+${items}
+  </ul>
+</body>
+</html>`;
+          ctx.output.set(`tags/${tag}.html`, html);
+        }
+      },
+    },
+  };
+}
