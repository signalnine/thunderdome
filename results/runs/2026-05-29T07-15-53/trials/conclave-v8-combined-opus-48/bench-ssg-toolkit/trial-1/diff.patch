+const ATTR_RE = /\b(src|href)="([^"]*)"/g;
+
+function isAbsolute(url: string): boolean {
+  return /^([a-z][a-z0-9+.-]*:)?\/\//i.test(url) || url.startsWith('/');
+}
+
+/**
+ * Asset pipeline plugin.
+ *
+ * Rewrites relative asset URLs (e.g. `./img.png`) to a canonical `/assets/`
+ * path and records every discovered asset in a shared manifest.
+ */
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext): ContentFile => {
+        const manifest =
+          (ctx.data.get('asset-manifest') as AssetManifest | undefined) ?? { assets: [] };
+
+        const content = file.content.replace(ATTR_RE, (match, attr: string, url: string) => {
+          if (isAbsolute(url)) {
+            return match; // absolute URLs and already-rooted paths are left as-is
+          }
+          const name = url.replace(/^\.\//, '');
+          if (!manifest.assets.includes(name)) {
+            manifest.assets.push(name);
+          }
+          return `${attr}="/assets/${name}"`;
+        });
+
+        ctx.data.set('asset-manifest', manifest);
+        return { ...file, content };
+      },
+    },
+  };
+}
