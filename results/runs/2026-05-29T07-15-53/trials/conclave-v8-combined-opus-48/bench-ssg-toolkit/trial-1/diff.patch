+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,66 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+interface Footnote {
+  id: string;
+  text: string;
+}
+
+const ADMONITION_RE = /^:::(\w+)[ \t]*\r?\n([\s\S]*?)\r?\n:::[ \t]*$/gm;
+const FOOTNOTE_DEF_RE = /^\[\^([^\]]+)\]:[ \t]*(.*)$/gm;
+const FOOTNOTE_REF_RE = /\[\^([^\]]+)\]/g;
+
+function renderMarkdown(src: string): string {
+  return marked.parse(src) as string;
+}
+
+/**
+ * Markdown extension plugin.
+ *
+ * Adds footnote support (`[^id]` references plus `[^id]: text` definitions)
+ * and admonition containers (`:::note ... :::`) on top of standard markdown.
+ */
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        let text = file.content;
+
+        // 1. Convert admonition blocks first so their inner markdown is
+        // rendered independently and the resulting <div> passes through marked.
+        text = text.replace(ADMONITION_RE, (_match, type: string, body: string) => {
+          const inner = renderMarkdown(body.trim());
+          return `<div class="admonition admonition-${type}">\n${inner}\n</div>`;
+        });
+
+        // 2. Extract footnote definitions (in document order) and strip them.
+        const footnotes: Footnote[] = [];
+        text = text.replace(FOOTNOTE_DEF_RE, (_match, id: string, body: string) => {
+          footnotes.push({ id, text: body.trim() });
+          return '';
+        });
+
+        // 3. Replace inline footnote references with linked superscripts.
+        text = text.replace(FOOTNOTE_REF_RE, (_match, id: string) => {
+          return `<sup><a href="#fn-${id}">${id}</a></sup>`;
+        });
+
+        // 4. Render the remaining markdown.
+        let html = renderMarkdown(text);
+
+        // 5. Append the footnote section, if any.
+        if (footnotes.length > 0) {
+          const items = footnotes
+            .map((fn) => `<li id="fn-${fn.id}">${fn.text}</li>`)
+            .join('\n');
+          html += `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
new file mode 100644
index 0000000..7a523ca
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,59 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(s: string): string {
+  return s
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
+
+function sortByDateDesc(files: ContentFile[]): ContentFile[] {
+  return [...files].sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
+}
+
+/**
+ * RSS feed plugin.
+ *
+ * Emits an RSS 2.0 `feed.xml` from the built content. Item bodies carry the
+ * already-rendered HTML (from markdown-ext) wrapped in CDATA, and per-item
+ * categories are drawn from the taxonomy tags.
+ */
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const { baseUrl, title } = ctx.config;
+        const items = sortByDateDesc(ctx.files)
+          .map((file) => {
+            const link = `${baseUrl}/${file.slug}.html`;
+            const pubDate = file.date ? `\n      <pubDate>${escapeXml(file.date)}</pubDate>` : '';
+            const categories = (file.tags ?? [])
+              .map((t) => `\n      <category>${escapeXml(t.toLowerCase())}</category>`)
+              .join('');
+            return `    <item>
+      <title>${escapeXml(file.title)}</title>
+      <link>${link}</link>${pubDate}${categories}
+      <description><![CDATA[${file.content}]]></description>
+    </item>`;
+          })
+          .join('\n');
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(title)}</title>
+    <link>${baseUrl}</link>
+    <description>${escapeXml(title)}</description>
+${items}
+  </channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
