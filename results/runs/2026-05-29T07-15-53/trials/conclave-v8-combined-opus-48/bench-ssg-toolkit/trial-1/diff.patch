@@ -0,0 +1,46 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+export interface SearchIndexEntry {
+  title: string;
+  slug: string;
+  content: string;
+  tags?: string[];
+}
+
+function stripHtml(html: string): string {
+  return html
+    .replace(/<[^>]*>/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+/**
+ * Search index plugin.
+ *
+ * Emits `search-index.json`, an array of plain-text records (one per content
+ * file) suitable for client-side search. Code-block text is preserved while
+ * markup is stripped.
+ */
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const index: SearchIndexEntry[] = ctx.files.map((file: ContentFile) => {
+          const entry: SearchIndexEntry = {
+            title: file.title,
+            slug: file.slug,
+            content: stripHtml(file.content),
+          };
+          if (file.tags && file.tags.length > 0) {
+            entry.tags = file.tags;
+          }
+          return entry;
+        });
+        ctx.output.set('search-index.json', JSON.stringify(index, null, 2));
+      },
+    },
+  };
+}
