+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface SearchEntry {
+  title: string;
+  slug: string;
+  content: string;
+  tags?: string[];
+}
+
+function decodeEntities(text: string): string {
+  return text
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;/g, "'")
+    .replace(/&apos;/g, "'")
+    .replace(/&amp;/g, '&');
+}
+
+function toPlainText(html: string): string {
+  const stripped = html.replace(/<[^>]*>/g, '');
+  return decodeEntities(stripped).trim();
+}
+
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild: (ctx: BuildContext) => {
+        const index: SearchEntry[] = ctx.files.map((file: ContentFile) => {
+          const entry: SearchEntry = {
+            title: file.title,
+            slug: file.slug,
+            content: toPlainText(file.content),
+          };
+          if (file.tags) {
+            entry.tags = file.tags;
+          }
+          return entry;
+        });
+
+        ctx.output.set('search-index.json', JSON.stringify(index));
+      },
+    },
+  };
+}
