@@ -0,0 +1,37 @@
+import { BuildContext, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+// Matches src="./..." or href="./..." (relative references only).
+const RELATIVE_ASSET = /(src|href)="\.\/([^"]+)"/g;
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file, ctx: BuildContext) => {
+        let manifest = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+        if (!manifest) {
+          manifest = { assets: [] };
+          ctx.data.set('asset-manifest', manifest);
+        }
+
+        const content = file.content.replace(
+          RELATIVE_ASSET,
+          (_m, attr: string, path: string) => {
+            if (!manifest!.assets.includes(path)) {
+              manifest!.assets.push(path);
+            }
+            return `${attr}="/assets/${path}"`;
+          },
+        );
+
+        return { ...file, content };
+      },
+    },
+  };
+}
