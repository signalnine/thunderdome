+import { marked } from 'marked';
+import { Plugin } from '../core/types.js';
+
+interface Footnote {
+  id: string;
+  text: string;
+}
+
+function renderMarkdown(raw: string): string {
+  if (!raw || !raw.trim()) {
+    return '';
+  }
+
+  let text = raw;
+
+  // 1. Extract footnote definitions: `[^id]: body` (one per line) and remove them.
+  const footnotes: Footnote[] = [];
+  text = text.replace(/^\[\^([^\]]+)\]:[ \t]*(.+)$/gm, (_m, id: string, body: string) => {
+    footnotes.push({ id, text: body.trim() });
+    return '';
+  });
+
+  // 2. Replace footnote references `[^id]` with linked superscripts.
+  text = text.replace(
+    /\[\^([^\]]+)\]/g,
+    (_m, id: string) => `<sup><a href="#fn-${id}">${id}</a></sup>`,
+  );
+
+  // 3. Replace admonition containers `:::type ... :::` with placeholders so the
+  //    main markdown pass does not mangle the generated HTML.
+  const placeholders: string[] = [];
+  text = text.replace(
+    /^:::(\w+)[ \t]*\n([\s\S]*?)\n:::[ \t]*$/gm,
+    (_m, type: string, body: string) => {
+      const inner = (marked.parse(body.trim()) as string).trim();
+      const html = `<div class="admonition admonition-${type}">\n${inner}\n</div>`;
+      placeholders.push(html);
+      return `xADMONITIONx${placeholders.length - 1}x`;
+    },
+  );
+
+  // 4. Render the remaining markdown.
+  let out = marked.parse(text) as string;
+
+  // 5. Restore admonition blocks (unwrapping any stray <p> marked added).
+  out = out.replace(
+    /<p>\s*xADMONITIONx(\d+)x\s*<\/p>/g,
+    (_m, i: string) => placeholders[Number(i)],
+  );
+  out = out.replace(/xADMONITIONx(\d+)x/g, (_m, i: string) => placeholders[Number(i)]);
+
+  // 6. Append the footnote section.
+  if (footnotes.length > 0) {
+    const items = footnotes.map((f) => `<li id="fn-${f.id}">${f.text}</li>`).join('\n');
+    out += `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+  }
+
+  return out;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file) => ({
+        ...file,
+        content: renderMarkdown(file.content),
+      }),
+    },
+  };
+}
