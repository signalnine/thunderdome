+import { Plugin } from '../core/types.js';
+
+// Matches a fenced code block: <pre><code class="language-X">.
+const CODE_BLOCK = /<pre>(\s*)<code class="language-([^"]+)">/g;
+
+function highlight(content: string): string {
+  return content.replace(
+    CODE_BLOCK,
+    (_m, gap: string, lang: string) =>
+      `<pre data-language="${lang}">${gap}<code class="language-${lang} highlighted">`,
+  );
+}
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file) => ({
+        ...file,
+        content: highlight(file.content),
+      }),
+    },
+  };
