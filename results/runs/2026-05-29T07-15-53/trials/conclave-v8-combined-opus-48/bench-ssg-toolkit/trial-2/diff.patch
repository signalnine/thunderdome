@@ -0,0 +1,63 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+function dateValue(file: ContentFile): number {
+  if (!file.date) {
+    return Number.NEGATIVE_INFINITY;
+  }
+  const ts = Date.parse(file.date);
+  return Number.isNaN(ts) ? Number.NEGATIVE_INFINITY : ts;
+}
+
+function renderItem(file: ContentFile, baseUrl: string): string {
+  const parts: string[] = [];
+  parts.push(`    <title>${escapeXml(file.title)}</title>`);
+  parts.push(`    <link>${baseUrl}/${file.slug}.html</link>`);
+  parts.push(`    <guid>${baseUrl}/${file.slug}.html</guid>`);
+  if (file.date) {
+    const ts = Date.parse(file.date);
+    if (!Number.isNaN(ts)) {
+      parts.push(`    <pubDate>${new Date(ts).toUTCString()}</pubDate>`);
+    }
+  }
+  for (const tag of file.tags ?? []) {
+    parts.push(`    <category>${escapeXml(tag)}</category>`);
+  }
+  parts.push(`    <description><![CDATA[${file.content}]]></description>`);
+  return `  <item>\n${parts.join('\n')}\n  </item>`;
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext) => {
+        const { baseUrl, title } = ctx.config;
+        const ordered = [...ctx.files].sort((a, b) => dateValue(b) - dateValue(a));
+        const items = ordered.map((f) => renderItem(f, baseUrl)).join('\n');
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+<channel>
+  <title>${escapeXml(title)}</title>
+  <link>${baseUrl}</link>
+  <description>${escapeXml(title)}</description>
+${items}
+</channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
