+++ b/src/tracker.ts
@@ -0,0 +1,98 @@
+import { JsonStorage } from './storage.js';
+import type { Summary, TimeEntry, TimeTrackerOptions } from './types.js';
+
+/**
+ * Tracks how time is spent across named tasks.
+ *
+ * At most one timer runs at a time. Starting a new timer while another is
+ * running automatically stops the previous one. All mutations are persisted
+ * synchronously to the configured JSON file.
+ */
+export class TimeTracker {
+  private readonly storage: JsonStorage;
+  private readonly now: () => number;
+  private entries: TimeEntry[];
+
+  constructor(options: TimeTrackerOptions) {
+    this.storage = new JsonStorage(options.filePath);
+    this.now = options.now ?? Date.now;
+    this.entries = this.storage.load();
+  }
+
+  /**
+   * Start a timer for `name`. If another timer is running it is stopped first
+   * (at the same instant the new one starts).
+   *
+   * @throws if `name` is empty or contains only whitespace.
+   */
+  start(name: string): TimeEntry {
+    if (name.trim() === '') {
+      throw new Error('Timer name must not be empty');
+    }
+    const timestamp = this.now();
+    const running = this.findRunning();
+    if (running) {
+      running.end = timestamp;
+    }
+    const entry: TimeEntry = { name, start: timestamp, end: null };
+    this.entries.push(entry);
+    this.storage.save(this.entries);
+    return { ...entry };
+  }
+
+  /**
+   * Stop the currently running timer.
+   *
+   * @throws if no timer is running.
+   */
+  stop(): TimeEntry {
+    const running = this.findRunning();
+    if (!running) {
+      throw new Error('No timer is currently running');
+    }
+    running.end = this.now();
+    this.storage.save(this.entries);
+    return { ...running };
+  }
+
+  /** The currently running entry, or `undefined` if none is running. */
+  getRunning(): TimeEntry | undefined {
+    const running = this.findRunning();
+    return running ? { ...running } : undefined;
+  }
+
+  /** Return a copy of all recorded entries, in insertion order. */
+  getEntries(): TimeEntry[] {
+    return this.entries.map((entry) => ({ ...entry }));
+  }
+
+  /**
+   * Return entries whose start time falls within `[from, to]` inclusive.
+   * Bounds are `Date` objects.
+   */
+  getEntriesInRange(from: Date, to: Date): TimeEntry[] {
+    const fromMs = from.getTime();
+    const toMs = to.getTime();
+    return this.entries
+      .filter((entry) => entry.start >= fromMs && entry.start <= toMs)
+      .map((entry) => ({ ...entry }));
+  }
+
+  /**
+   * Total milliseconds spent per task name. Entries sharing a name are summed.
+   * Running entries are measured up to the current time.
+   */
+  summary(): Summary {
+    const result: Summary = {};
+    for (const entry of this.entries) {
+      const end = entry.end ?? this.now();
+      const duration = Math.max(0, end - entry.start);
+      result[entry.name] = (result[entry.name] ?? 0) + duration;
+    }
+    return result;
+  }
+
+  private findRunning(): TimeEntry | undefined {
+    return this.entries.find((entry) => entry.end === null);
+  }
+}
