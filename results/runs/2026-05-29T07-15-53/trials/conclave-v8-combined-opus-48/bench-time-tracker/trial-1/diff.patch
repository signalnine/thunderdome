ing entry, or `undefined` if none is running. */\n  getRunning(): TimeEntry | undefined {\n    const running = this.findRunning();\n    return running ? { ...running } : undefined;\n  }\n\n  /** Return a copy of all recorded entries, in insertion order. */\n  getEntries(): TimeEntry[] {\n    return this.entries.map((entry) => ({ ...entry }));\n  }\n\n  /**\n   * Return entries whose start time falls within `[from, to]` inclusive.\n   * Bounds are `Date` objects.\n   */\n  getEntriesInRange(from: Date, to: Date): TimeEntry[] {\n    const fromMs = from.getTime();\n    const toMs = to.getTime();\n    return this.entries\n      .filter((entry) => entry.start >= fromMs && entry.start <= toMs)\n      .map((entry) => ({ ...entry }));\n  }\n\n  /**\n   * Total milliseconds spent per task name. Entries sharing a name are summed.\n   * Running entries are measured up to the current time.\n   */\n  summary(): Summary {\n    const result: Summary = {};\n    for (const entry of this.entries) {\n      const end = entry.end ?? this.now();\n      const duration = Math.max(0, end - entry.start);\n      result[entry.name] = (result[entry.name] ?? 0) + duration;\n    }\n    return result;\n  }\n\n  private findRunning(): TimeEntry | undefined {\n    return this.entries.find((entry) => entry.end === null);\n  }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":884,"cache_read_input_tokens":26787,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":884},"output_tokens":73,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"325a6431-c772-4e0a-a2d6-fd4f6f1997cd","uuid":"c8ba3263-73db-4ad2-8014-e6fb6087d8ac","request_id":"req_011CbWT5Y9jgzmmHAE7AVfBG"}
