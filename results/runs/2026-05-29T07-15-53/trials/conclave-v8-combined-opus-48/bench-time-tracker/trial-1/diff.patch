+ * the first write. Reading a non-existent file yields an empty list rather
+ * than throwing.
+ */
+export class JsonStorage {
+  constructor(private readonly filePath: string) {}
+
+  /** Load all entries from disk. Returns `[]` if the file does not exist. */
+  load(): TimeEntry[] {
+    if (!existsSync(this.filePath)) {
+      return [];
+    }
+    const raw = readFileSync(this.filePath, 'utf8').trim();
+    if (raw === '') {
+      return [];
+    }
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) {
+      throw new Error(`Corrupt time-tracker file: expected a JSON array in ${this.filePath}`);
+    }
+    return parsed.map((item) => normalizeEntry(item, this.filePath));
+  }
+
+  /** Persist all entries to disk, creating parent directories as needed. */
+  save(entries: TimeEntry[]): void {
+    mkdirSync(dirname(this.filePath), { recursive: true });
+    writeFileSync(this.filePath, JSON.stringify(entries, null, 2), 'utf8');
+  }
+}
+
+function normalizeEntry(item: unknown, filePath: string): TimeEntry {
+  if (typeof item !== 'object' || item === null) {
+    throw new Error(`Corrupt time-tracker file: invalid entry in ${filePath}`);
+  }
+  const record = item as Record<string, unknown>;
+  const { name, start, end } = record;
+  if (typeof name !== 'string' || typeof start !== 'number') {
+    throw new Error(`Corrupt time-tracker file: invalid entry in ${filePath}`);
+  }
+  if (end !== null && typeof end !== 'number') {
+    throw new Error(`Corrupt time-tracker file: invalid entry in ${filePath}`);
+  }
+  return { name, start, end };
+}
