@@ -0,0 +1,28 @@
+/**
+ * A single recorded interval of time spent on a named task.
+ *
+ * Timestamps are stored as epoch milliseconds, which keeps them JSON-safe
+ * and trivial to sum when computing durations.
+ */
+export interface TimeEntry {
+  /** The task name. May contain unicode characters and emoji. */
+  name: string;
+  /** When the timer started, in epoch milliseconds. */
+  start: number;
+  /** When the timer stopped, in epoch milliseconds, or `null` if still running. */
+  end: number | null;
+}
+
+/** Options for constructing a {@link TimeTracker}. */
+export interface TimeTrackerOptions {
+  /** Path to the JSON file used for persistence. */
+  filePath: string;
+  /**
+   * Clock function returning the current time in epoch milliseconds.
+   * Defaults to {@link Date.now}. Override for deterministic tests.
+   */
+  now?: () => number;
+}
+
+/** A summary mapping each task name to total milliseconds spent on it. */
+export type Summary = Record<string, number>;
