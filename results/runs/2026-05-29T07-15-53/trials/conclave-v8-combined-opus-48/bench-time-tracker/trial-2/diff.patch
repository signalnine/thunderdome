+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import type { Summary, TimeEntry, TimeTrackerOptions } from './types.js';
+
+/**
+ * Tracks how time is spent across named tasks.
+ *
+ * Entries are persisted to a JSON file (see {@link TimeTrackerOptions.filePath})
+ * after every mutation, and loaded from that file when a tracker is created, so
+ * data survives between sessions.
+ */
+export class TimeTracker {
+  private readonly filePath: string;
+  private readonly now: () => number;
+  private entries: TimeEntry[] = [];
+
+  constructor(options: TimeTrackerOptions) {
+    if (!options || typeof options.filePath !== 'string' || options.filePath.length === 0) {
+      throw new Error('A non-empty filePath is required.');
+    }
+    this.filePath = options.filePath;
+    this.now = options.now ?? Date.now;
+    this.load();
+  }
+
+  /**
+   * Starts a new timer for `task`. If a timer is already running it is stopped
+   * automatically before the new one starts.
+   *
+   * @throws if `task` is empty or contains only whitespace.
+   * @returns the newly created running entry.
+   */
+  start(task: string): TimeEntry {
+    if (typeof task !== 'string' || task.trim().length === 0) {
+      throw new Error('Task name must be a non-empty string.');
+    }
+
+    const running = this.running();
+    if (running) {
+      running.stop = this.now();
+    }
+
+    const entry: TimeEntry = {
+      id: randomUUID(),
+      task,
+      start: this.now(),
+    };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  /**
+   * Stops the currently running timer.
+   *
+   * @throws if no timer is running.
+   * @returns the stopped entry.
+   */
+  stop(): TimeEntry {
+    const running = this.running();
+    if (!running) {
+      throw new Error('No timer is currently running.');
+    }
+    running.stop = this.now();
+    this.save();
+    return running;
+  }
+
+  /**
+   * Returns the currently running entry, or `undefined` if nothing is running.
+   */
+  current(): TimeEntry | undefined {
+    return this.running();
+  }
+
+  /**
+   * Returns a copy of all recorded entries, in the order they were started.
+   */
+  getEntries(): TimeEntry[] {
+    return this.entries.map((entry) => ({ ...entry }));
+  }
+
+  /**
+   * Returns entries whose start time falls within the inclusive range
+   * `[from, to]`. Accepts `Date` objects or epoch-millisecond numbers.
+   */
+  getEntriesByDateRange(from: Date | number, to: Date | number): TimeEntry[] {
+    const fromMs = from instanceof Date ? from.getTime() : from;
+    const toMs = to instanceof Date ? to.getTime() : to;
+    const lo = Math.min(fromMs, toMs);
+    const hi = Math.max(fromMs, toMs);
+    return this.entries
+      .filter((entry) => entry.start >= lo && entry.start <= hi)
+      .map((entry) => ({ ...entry }));
+  }
+
+  /**
+   * Returns total milliseconds spent per task name. Entries sharing a name are
+   * summed together. A running entry contributes its elapsed time up to the
+   * current time.
+   */
+  getSummary(): Summary {
+    const summary: Summary = {};
+    const now = this.now();
+    for (const entry of this.entries) {
+      const end = entry.stop ?? now;
+      const duration = Math.max(0, end - entry.start);
+      summary[entry.task] = (summary[entry.task] ?? 0) + duration;
+    }
+    return summary;
+  }
+
+  private running(): TimeEntry | undefined {
+    return this.entries.find((entry) => entry.stop === undefined);
+  }
+
+  private load(): void {
+    if (!existsSync(this.filePath)) {
+      this.entries = [];
+      return;
+    }
+    const raw = readFileSync(this.filePath, 'utf8');
+    if (raw.trim().length === 0) {
+      this.entries = [];
+      return;
+    }
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) {
+      throw new Error(`Persisted data at ${this.filePath} is not a valid entry array.`);
+    }
+    this.entries = parsed.map((item) => this.normalize(item));
+  }
+
+  private normalize(item: unknown): TimeEntry {
+    if (typeof item !== 'object' || item === null) {
+      throw new Error('Encountered a malformed time entry.');
+    }
+    const record = item as Record<string, unknown>;
+    if (
+      typeof record.id !== 'string' ||
+      typeof record.task !== 'string' ||
+      typeof record.start !== 'number' ||
+      (record.stop !== undefined && typeof record.stop !== 'number')
+    ) {
+      throw new Error('Encountered a malformed time entry.');
+    }
+    const entry: TimeEntry = {
+      id: record.id,
+      task: record.task,
+      start: record.start,
+    };
+    if (typeof record.stop === 'number') {
+      entry.stop = record.stop;
+    }
+    return entry;
+  }
+
+  private save(): void {
+    mkdirSync(dirname(this.filePath), { recursive: true });
+    writeFileSync(this.filePath, JSON.stringify(this.entries, null, 2), 'utf8');
+  }
+}
