+/**
+ * A single recorded time entry.
+ *
+ * Timestamps are epoch milliseconds (the value returned by `Date.now()`).
+ * `stop` is `undefined` while the entry's timer is still running.
+ */
+export interface TimeEntry {
+  /** Unique identifier for the entry. */
+  id: string;
+  /** The task name. May contain any unicode characters, including emoji. */
+  task: string;
+  /** When the timer started, in epoch milliseconds. */
+  start: number;
+  /** When the timer stopped, in epoch milliseconds, or `undefined` if running. */
+  stop?: number;
+}
+
+/**
+ * Configuration for a {@link TimeTracker}.
+ */
+export interface TimeTrackerOptions {
+  /** Path to the JSON file used for persistence. */
+  filePath: string;
+  /**
+   * Clock function returning the current time in epoch milliseconds.
+   * Defaults to `Date.now`. Primarily useful for deterministic tests.
+   */
+  now?: () => number;
+}
+
+/**
+ * A summary mapping each task name to the total milliseconds spent on it.
+ */
+export type Summary = Record<string, number>;
