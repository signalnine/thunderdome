 schedule(events, rooms, WINDOW)).toThrow();\n  });\n\n  it('throws on longer cycle', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, prerequisites: ['c'] },\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 60, prerequisites: ['b'] },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];\n    expect(() => schedule(events, rooms, WINDOW)).toThrow();\n  });\n\n  it('does not throw on acyclic graph', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 60, prerequisites: ['a', 'b'] },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];\n    expect(() => schedule(events, rooms, { startTime: 540, endTime: 1200 })).not.toThrow();\n  });\n});\n\ndescribe('batch optimization', () => {\n  it('finds an assignment that fits all events when a naive order would strand one', () => {\n    // Two rooms; capacities force a specific assignment. A small room and a big room.\n    // big1 (needs big room) and big2 (needs big room) both need the big room serially.\n    // small1 needs small room. A naive approach placing small1 in big room first could\n    // strand a big event. Window only fits two 60-min events per room with 15 gap (need 135).\n    const events: Event[] = [\n      { id: 'big1', name: 'Big1', duration: 60, attendees: 40 },\n      { id: 'big2', name: 'Big2', duration: 60, attendees: 40 },\n      { id: 'small1', name: 'Small1', duration: 60, attendees: 3 },\n    ];\n    const rooms: Room[] = [\n      { id: 'small', name: 'S', capacity: 5 },\n      { id: 'big', name: 'B', capacity: 50 },\n    ];\n    // window fits only ~2 events per room\n    const opts = { startTime: 540, endTime: 540 + 135, gap: 15 };\n    const res = schedule(events, rooms, opts);\n    assertValid(events, rooms, opts, res);\n    expect(res.unscheduled).toEqual([]);\n  });\n\n  it('does not let a small event hog the only large room (best fit)', () => {\n    const events: Event[] = [\n      { id: 'small', name: 'Small', duration: 400, attendees: 2 },\n      { id: 'large', name: 'Large', duration: 400, attendees: 40 },\n    ];\n    const rooms: Room[] = [\n      { id: 'tiny', name: 'T', capacity: 5 },\n      { id: 'huge', name: 'H', capacity: 50 },\n    ];\n    // Each room only fits one 400-min event in the 480-min window.\n    const res = schedule(events, rooms, WINDOW);\n    assertValid(events, rooms, WINDOW, res);\n    expect(res.unscheduled).toEqual([]);\n  });\n\n  it('lists genuinely unplaceable events in unscheduled without throwing', () => {\n    const events: Event[] = Array.from({ length: 10 }, (_, i) => ({\n      id: `e${i}`,\n      name: `E${i}`,\n      duration: 120,\n    }));\n    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];\n    // 480 min window, 120 min events + 15 gap => 135 each => only 3 fit (135*3=405<=480, 4th=540>480)\n    const res = schedule(events, rooms, WINDOW);\n    assertValid(events, rooms, WINDOW, res);\n    expect(res.assignments.length).toBe(3);\n    expect(res.unscheduled.length).toBe(7);\n  });\n});\n\ndescribe('robustness', () => {\n  it('empty events', () => {\n    expect(schedule([], [{ id: 'r1', name: 'R1', capacity: 1 }], WINDOW)).toEqual({\n      assignments: [],\n      unscheduled: [],\n    });\n  });\n\n  it('empty rooms means all unscheduled', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60 },\n    ];\n    const res = schedule(events, [], WINDOW);\n    expect(res.assignments).toEqual([]);\n    expect(new Set(res.unscheduled)).toEqual(new Set(['a', 'b']));\n  });\n\n  it('is deterministic', () => {\n    const events: Event[] = Array.from({ length: 8 }, (_, i) => ({\n      id: `e${i}`,\n      name: `E${i}`,\n      duration: 50,\n      attendees: (i % 3) + 1,\n      prerequisites: i > 0 ? [`e${i - 1}`] : undefined,\n    }));\n    const rooms: Room[] = [\n      { id: 'r1', name: 'R1', capacity: 5 },\n      { id: 'r2', name: 'R2', capacity: 5 },\n    ];\n    const opts = { startTime: 540, endTime: 1020 };\n    const a = schedule(events, rooms, opts);\n    const b = schedule(events, rooms, opts);\n    expect(a).toEqual(b);\n  });\n\n  it('does not mutate inputs', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 60, prerequisites: ['x'] }];\n    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];\n    const snapshot = JSON.stringify({ events, rooms });\n    schedule(events, rooms, WINDOW);\n    expect(JSON.stringify({ events, rooms })).toBe(snapshot);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":264,"cache_creation_input_tokens":6807,"cache_read_input_tokens":26167,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6807},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"66a03b1b-28ed-4449-a853-a4ec1c26571b","uuid":"6e41d0a2-cb1f-432b-923d-a45a830a6c41","request_id":"req_011CbWXg1SE7jczXv7aeYXfY"}
