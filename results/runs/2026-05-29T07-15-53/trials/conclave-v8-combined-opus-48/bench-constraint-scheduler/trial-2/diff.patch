+/**
+ * Constraint-based event scheduler.
+ *
+ * Assigns events to rooms within a time window while respecting:
+ *  - room capacity        (attendees <= room capacity)
+ *  - the time window       (startTime <= start, end <= endTime)
+ *  - inter-event room gaps (>= gap minutes between events in the same room)
+ *  - prerequisite ordering (A.end + gap <= B.start when B requires A)
+ *  - preferred room hints  (honored when feasible, never a hard constraint)
+ *
+ * The objective is to maximize the number of events scheduled. A branch-and-bound
+ * search over room assignments (with greedy, best-fit ordering tried first) is used
+ * so that the placement of one event accounts for its effect on the others. The
+ * search is bounded by a node budget; if exhausted, the best solution found so far
+ * (always at least as good as the greedy baseline) is returned.
+ */
+
+export interface Event {
+  id: string;
+  name: string;
+  duration: number;
+  attendees?: number;
+  prerequisites?: string[];
+  preferredRoom?: string;
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number;
+}
+
+export interface ScheduleOptions {
+  startTime: number;
+  endTime: number;
+  gap?: number;
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[];
+}
+
+const DEFAULT_GAP = 15;
+/** Upper bound on search nodes to keep the optimizer tractable on large inputs. */
+const MAX_NODES = 200_000;
+
+/** A placement under construction during the search. */
+interface Placement {
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+/**
+ * Detects a cycle (including self-references) in the prerequisite graph.
+ * Edges to non-existent event ids are ignored for cycle purposes — they simply
+ * make the dependent unschedulable later on. Throws on the first cycle found.
+ */
+function assertNoCycles(events: Event[], eventIds: Set<string>): void {
+  // 0 = unvisited, 1 = in current DFS stack, 2 = fully explored
+  const state = new Map<string, number>();
+  const adjacency = new Map<string, string[]>();
+  for (const e of events) {
+    const deps = (e.prerequisites ?? []).filter((p) => eventIds.has(p));
+    adjacency.set(e.id, deps);
+  }
+
+  const stack: string[] = [];
+  const visit = (id: string): void => {
+    state.set(id, 1);
+    stack.push(id);
+    for (const next of adjacency.get(id) ?? []) {
+      const s = state.get(next) ?? 0;
+      if (s === 1) {
+        const from = stack.indexOf(next);
+        const cycle = stack.slice(from).concat(next).join(' -> ');
+        throw new Error(`Prerequisite cycle detected: ${cycle}`);
+      }
+      if (s === 0) visit(next);
+    }
+    stack.pop();
+    state.set(id, 2);
+  };
+
+  for (const e of events) {
+    if ((state.get(e.id) ?? 0) === 0) visit(e.id);
+  }
+}
+
+/**
+ * Returns events ordered so that every event appears after all of its
+ * (existing) prerequisites. Within those constraints the original input order
+ * is preserved (Kahn's algorithm seeded in input order) for determinism.
+ *
+ * Precondition: the graph is acyclic (validated by assertNoCycles).
+ */
+function topologicalOrder(events: Event[], eventIds: Set<string>): Event[] {
+  const indegree = new Map<string, number>();
+  const dependents = new Map<string, string[]>();
+  const eventById = new Map(events.map((e) => [e.id, e]));
+
+  for (const e of events) {
+    indegree.set(e.id, 0);
+    dependents.set(e.id, []);
+  }
+  for (const e of events) {
+    for (const p of e.prerequisites ?? []) {
+      if (!eventIds.has(p)) continue;
+      indegree.set(e.id, (indegree.get(e.id) ?? 0) + 1);
+      dependents.get(p)!.push(e.id);
+    }
+  }
+
+  // Seed the queue in input order to keep the result deterministic.
+  const queue: string[] = events.filter((e) => indegree.get(e.id) === 0).map((e) => e.id);
+  const order: Event[] = [];
+  while (queue.length > 0) {
+    const id = queue.shift()!;
+    order.push(eventById.get(id)!);
+    for (const dep of dependents.get(id) ?? []) {
+      const d = (indegree.get(dep) ?? 0) - 1;
+      indegree.set(dep, d);
+      if (d === 0) queue.push(dep);
+    }
+  }
+  // With an acyclic graph every node is emitted.
+  return order;
+}
+
+/**
+ * Finds the earliest feasible start time for an event of the given duration in
+ * a room, at or after `earliest`, such that the event keeps `gap` minutes from
+ * every already-placed event in that room and ends within the window.
+ * Returns null when no feasible slot exists.
+ */
+function earliestStartInRoom(
+  duration: number,
+  earliest: number,
+  windowEnd: number,
+  gap: number,
+  occupied: Placement[],
+): number | null {
+  // Candidate starts: the earliest allowed time, and just-after each existing
+  // event (its end + gap). The optimal left-shifted start is always one of these.
+  const candidates: number[] = [earliest];
+  for (const o of occupied) {
+    const after = o.endTime + gap;
+    if (after >= earliest) candidates.push(after);
+  }
+  candidates.sort((a, b) => a - b);
+
+  for (const start of candidates) {
+    if (start < earliest) continue;
+    const end = start + duration;
+    if (end > windowEnd) break; // later candidates are only larger
+    let ok = true;
+    for (const o of occupied) {
+      // Conflict unless this event is fully before or fully after `o`, gap-respecting.
+      const before = end + gap <= o.startTime;
+      const afterIt = start >= o.endTime + gap;
+      if (!before && !afterIt) {
+        ok = false;
+        break;
+      }
+    }
+    if (ok) return start;
+  }
+  return null;
+}
+
+interface RoomOption {
+  roomId: string;
+  startTime: number;
+  capacity: number; // room capacity, used for best-fit ordering
+}
+
+/**
+ * Computes every feasible room placement for an event given the current partial
+ * schedule, ordered by preference: the preferred room first, then by best-fit
+ * (smallest sufficient capacity) so large rooms stay free for large events, with
+ * earliest start and room id as deterministic tie-breakers.
+ */
+function feasibleRoomOptions(
+  event: Event,
+  rooms: Room[],
+  attendees: number,
+  earliest: number,
+  windowEnd: number,
+  gap: number,
+  roomOccupancy: Map<string, Placement[]>,
+): RoomOption[] {
+  const options: RoomOption[] = [];
+  for (const room of rooms) {
+    if (room.capacity < attendees) continue;
+    const start = earliestStartInRoom(
+      event.duration,
+      earliest,
+      windowEnd,
+      gap,
+      roomOccupancy.get(room.id) ?? [],
+    );
+    if (start === null) continue;
+    options.push({ roomId: room.id, startTime: start, capacity: room.capacity });
+  }
+
+  options.sort((a, b) => {
+    const aPref = a.roomId === event.preferredRoom ? 0 : 1;
+    const bPref = b.roomId === event.preferredRoom ? 0 : 1;
+    if (aPref !== bPref) return aPref - bPref;
+    if (a.capacity !== b.capacity) return a.capacity - b.capacity; // best fit
+    if (a.startTime !== b.startTime) return a.startTime - b.startTime;
+    return a.roomId < b.roomId ? -1 : a.roomId > b.roomId ? 1 : 0;
+  });
+  return options;
+}
+
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const gap = options.gap ?? DEFAULT_GAP;
+  const { startTime: windowStart, endTime: windowEnd } = options;
+  const eventIds = new Set(events.map((e) => e.id));
+
+  // Rule 6: prerequisite cycles (incl. self-references) are hard errors.
+  assertNoCycles(events, eventIds);
+
+  if (events.length === 0) return { assignments: [], unscheduled: [] };
+
+  const ordered = topologicalOrder(events, eventIds);
+  const n = ordered.length;
+
+  // Best solution found so far during the search.
+  let bestPlacements: Map<string, Placement> | null = null;
+  let bestCount = -1;
+  let nodes = 0;
+
+  // Working state mutated during DFS.
+  const placed = new Map<string, Placement>();
+  const roomOccupancy = new Map<string, Placement[]>();
+  for (const r of rooms) roomOccupancy.set(r.id, []);
+
+  /** Records the current solution if it schedules more events than the best so far. */
+  const record = (count: number): void => {
+    if (count > bestCount) {
+      bestCount = count;
+      bestPlacements = new Map(placed);
+    }
+  };
+
+  const dfs = (index: number, count: number): void => {
+    if (nodes >= MAX_NODES) return;
+    nodes++;
+
+    if (index === n) {
+      record(count);
+      return;
+    }
+
+    // Branch-and-bound: even if every remaining event is scheduled we cannot beat
+    // an already-found solution of equal-or-greater size, so prune.
+    if (count + (n - index) <= bestCount) return;
+
+    const event = ordered[index];
+    const attendees = event.attendees ?? 1;
+
+    // An event is placeable only if all its prerequisites are already placed.
+    const prereqs = event.prerequisites ?? [];
+    let prereqEarliest = windowStart;
+    let prereqsSatisfied = true;
+    for (const p of prereqs) {
+      const pp = placed.get(p);
+      if (!pp) {
+        prereqsSatisfied = false;
+        break;
+      }
+      prereqEarliest = Math.max(prereqEarliest, pp.endTime + gap);
+    }
+
+    if (prereqsSatisfied) {
+      const opts = feasibleRoomOptions(
+        event,
+        rooms,
+        attendees,
+        prereqEarliest,
+        windowEnd,
+        gap,
+        roomOccupancy,
+      );
+      for (const opt of opts) {
+        const placement: Placement = {
+          roomId: opt.roomId,
+          startTime: opt.startTime,
+          endTime: opt.startTime + event.duration,
+        };
+        placed.set(event.id, placement);
+        const occ = roomOccupancy.get(opt.roomId)!;
+        occ.push(placement);
+        dfs(index + 1, count + 1);
+        occ.pop();
+        placed.delete(event.id);
+        if (nodes >= MAX_NODES) return;
+      }
+    }
+
+    // Branch: leave this event unscheduled.
+    dfs(index + 1, count);
+  };
+
+  dfs(0, 0);
+
+  const finalPlacements = bestPlacements ?? new Map<string, Placement>();
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+  // Emit in the original input order for stable, predictable output.
+  for (const e of events) {
+    const p = finalPlacements.get(e.id);
+    if (p) {
+      assignments.push({
+        eventId: e.id,
+        roomId: p.roomId,
+        startTime: p.startTime,
+        endTime: p.endTime,
+      });
+    } else {
+      unscheduled.push(e.id);
+    }
+  }
+
+  return { assignments, unscheduled };
+}
+
+/** Class wrapper around {@link schedule} for callers who prefer an OO surface. */
+export class Scheduler {
+  schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {
+    return schedule(events, rooms, options);
+  }
+}
+
+/** Factory returning a {@link Scheduler} instance. */
+export function createScheduler(): Scheduler {
+  return new Scheduler();
+}
+
+export default schedule;
