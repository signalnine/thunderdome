+// Constraint-based event scheduler.
+//
+// Assigns events to rooms within a time window while respecting capacity,
+// the time window, per-room gaps, prerequisite ordering and (soft) room
+// preferences. Schedules a batch at once and maximises the number of events
+// placed via a branch-and-bound search that falls back to the best solution
+// found within a node/time budget.
+
+export interface Event {
+  id: string;
+  name: string;
+  duration: number; // minutes
+  attendees?: number; // people attending (default: 1)
+  prerequisites?: string[]; // event ids that must finish before this starts
+  preferredRoom?: string; // room id preference (hint, not hard constraint)
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number; // max attendees
+}
+
+export interface ScheduleOptions {
+  startTime: number; // minutes from midnight
+  endTime: number; // minutes from midnight
+  gap?: number; // minimum gap between events in same room (default: 15)
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[];
+}
+
+const DEFAULT_GAP = 15;
+const DEFAULT_ATTENDEES = 1;
+const NODE_BUDGET = 200_000;
+const TIME_BUDGET_MS = 4000;
+
+interface Booking {
+  start: number;
+  end: number;
+}
+
+/**
+ * Detect a cycle (including self references) in the prerequisite graph.
+ * Throws an Error if one is found. Edges to unknown event ids are ignored
+ * here (they cannot form a cycle) but are handled during scheduling.
+ */
+function assertNoCycles(events: Event[], byId: Map<string, Event>): void {
+  // 0 = unvisited, 1 = in current stack, 2 = done
+  const state = new Map<string, number>();
+
+  const visit = (id: string, stack: string[]): void => {
+    const s = state.get(id) ?? 0;
+    if (s === 2) return;
+    if (s === 1) {
+      const cycleStart = stack.indexOf(id);
+      const path = stack.slice(cycleStart).concat(id).join(' -> ');
+      throw new Error(`Prerequisite cycle detected: ${path}`);
+    }
+    state.set(id, 1);
+    stack.push(id);
+    const ev = byId.get(id);
+    if (ev) {
+      for (const p of ev.prerequisites ?? []) {
+        // Only follow edges to known events; an unknown prerequisite cannot
+        // participate in a cycle.
+        if (byId.has(p)) visit(p, stack);
+      }
+    }
+    stack.pop();
+    state.set(id, 2);
+  };
+
+  for (const e of events) {
+    if ((state.get(e.id) ?? 0) === 0) visit(e.id, []);
+  }
+}
+
+/**
+ * Topological order of events so prerequisites are processed before the
+ * events that depend on them. Assumes the graph is acyclic (checked earlier).
+ * Only known-event edges constrain the order.
+ */
+function topoOrder(events: Event[], byId: Map<string, Event>): Event[] {
+  const visited = new Set<string>();
+  const order: Event[] = [];
+
+  const visit = (e: Event): void => {
+    if (visited.has(e.id)) return;
+    visited.add(e.id);
+    for (const p of e.prerequisites ?? []) {
+      const pe = byId.get(p);
+      if (pe) visit(pe);
+    }
+    order.push(e);
+  };
+
+  for (const e of events) visit(e);
+  return order;
+}
+
+/**
+ * Earliest start time (>= est) at which an event of the given duration can be
+ * left-packed into a room's existing bookings without violating the gap or the
+ * window. Returns null if it cannot fit.
+ */
+function earliestSlot(
+  bookings: Booking[],
+  est: number,
+  duration: number,
+  windowStart: number,
+  windowEnd: number,
+  gap: number,
+): number | null {
+  const lower = Math.max(est, windowStart);
+
+  // Candidate start positions: the earliest allowed time, plus right after
+  // each existing booking (+ gap). Left-packing only ever needs these points.
+  const candidates: number[] = [lower];
+  for (const b of bookings) {
+    const after = b.end + gap;
+    if (after > lower) candidates.push(after);
+  }
+  candidates.sort((a, b) => a - b);
+
+  for (const start of candidates) {
+    const end = start + duration;
+    if (end > windowEnd) continue;
+    let ok = true;
+    for (const b of bookings) {
+      // Compatible if fully before (with gap) or fully after (with gap).
+      if (end + gap <= b.start || b.end + gap <= start) continue;
+      ok = false;
+      break;
+    }
+    if (ok) return start;
+  }
+  return null;
+}
+
+interface Placement {
+  roomId: string;
+  start: number;
+  end: number;
+  preferred: boolean;
+}
+
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const gap = options.gap ?? DEFAULT_GAP;
+  const windowStart = options.startTime;
+  const windowEnd = options.endTime;
+
+  const byId = new Map<string, Event>();
+  for (const e of events) byId.set(e.id, e);
+
+  // Rule 6: cycles (including self references) must throw.
+  assertNoCycles(events, byId);
+
+  if (events.length === 0) {
+    return { assignments: [], unscheduled: [] };
+  }
+
+  const roomById = new Map<string, Room>();
+  for (const r of rooms) roomById.set(r.id, r);
+
+  const order = topoOrder(events, byId);
+
+  // Mutable search state, restored on backtrack.
+  const bookingsByRoom = new Map<string, Booking[]>();
+  for (const r of rooms) bookingsByRoom.set(r.id, []);
+  const placed = new Map<string, Assignment>();
+
+  // Best solution found so far.
+  let bestCount = -1;
+  let bestPreferred = -1;
+  let bestPlaced: Map<string, Assignment> | null = null;
+
+  let nodes = 0;
+  const startWall = Date.now();
+  let aborted = false;
+
+  const attendeesOf = (e: Event): number => e.attendees ?? DEFAULT_ATTENDEES;
+
+  const feasiblePlacements = (e: Event): Placement[] => {
+    const attendees = attendeesOf(e);
+    let est = windowStart;
+    for (const p of e.prerequisites ?? []) {
+      const pa = placed.get(p);
+      // A prerequisite that is not placed makes the event infeasible.
+      if (!pa) return [];
+      est = Math.max(est, pa.endTime + gap);
+    }
+
+    const result: Placement[] = [];
+    for (const room of rooms) {
+      if (room.capacity < attendees) continue;
+      const start = earliestSlot(
+        bookingsByRoom.get(room.id)!,
+        est,
+        e.duration,
+        windowStart,
+        windowEnd,
+        gap,
+      );
+      if (start === null) continue;
+      result.push({
+        roomId: room.id,
+        start,
+        end: start + e.duration,
+        preferred: e.preferredRoom === room.id,
+      });
+    }
+
+    // Try the preferred room first (so it is honoured when feasible), then the
+    // placement that ends earliest (leaves the most room for later events).
+    result.sort((a, b) => {
+      if (a.preferred !== b.preferred) return a.preferred ? -1 : 1;
+      return a.end - b.end;
+    });
+    return result;
+  };
+
+  const record = (count: number, preferred: number): void => {
+    if (count > bestCount || (count === bestCount && preferred > bestPreferred)) {
+      bestCount = count;
+      bestPreferred = preferred;
+      bestPlaced = new Map(placed);
+    }
+  };
+
+  const recurse = (i: number, count: number, preferred: number): void => {
+    if (aborted) return;
+
+    // Branch-and-bound: even placing every remaining event cannot beat best.
+    if (count + (order.length - i) < bestCount) return;
+
+    if (i === order.length) {
+      record(count, preferred);
+      return;
+    }
+
+    nodes++;
+    if (nodes > NODE_BUDGET || Date.now() - startWall > TIME_BUDGET_MS) {
+      // Budget exhausted: greedily finish the current partial schedule so the
+      // recorded solution is complete, then stop searching.
+      let c = count;
+      let pf = preferred;
+      for (let j = i; j < order.length; j++) {
+        const opts = feasiblePlacements(order[j]);
+        if (opts.length === 0) continue;
+        const opt = opts[0];
+        placed.set(order[j].id, {
+          eventId: order[j].id,
+          roomId: opt.roomId,
+          startTime: opt.start,
+          endTime: opt.end,
+        });
+        bookingsByRoom.get(opt.roomId)!.push({ start: opt.start, end: opt.end });
+        c++;
+        if (opt.preferred) pf++;
+      }
+      record(c, pf);
+      // Undo the greedy fill.
+      for (let j = order.length - 1; j >= i; j--) {
+        const a = placed.get(order[j].id);
+        if (!a) continue;
+        const list = bookingsByRoom.get(a.roomId)!;
+        list.pop();
+        placed.delete(order[j].id);
+      }
+      aborted = true;
+      return;
+    }
+
+    const e = order[i];
+    const options = feasiblePlacements(e);
+
+    for (const opt of options) {
+      const assignment: Assignment = {
+        eventId: e.id,
+        roomId: opt.roomId,
+        startTime: opt.start,
+        endTime: opt.end,
+      };
+      placed.set(e.id, assignment);
+      const list = bookingsByRoom.get(opt.roomId)!;
+      list.push({ start: opt.start, end: opt.end });
+
+      recurse(i + 1, count + 1, preferred + (opt.preferred ? 1 : 0));
+
+      list.pop();
+      placed.delete(e.id);
+      if (aborted) return;
+    }
+
+    // Skip this event (leave it unscheduled) and continue.
+    recurse(i + 1, count, preferred);
+  };
+
+  recurse(0, 0, 0);
+
+  const finalPlaced = bestPlaced ?? new Map<string, Assignment>();
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+  for (const e of events) {
+    const a = finalPlaced.get(e.id);
+    if (a) assignments.push(a);
+    else unscheduled.push(e.id);
+  }
+
+  return { assignments, unscheduled };
+}
+
+export class Scheduler {
+  schedule(
+    events: Event[],
+    rooms: Room[],
+    options: ScheduleOptions,
+  ): ScheduleResult {
+    return schedule(events, rooms, options);
+  }
+}
+
+export function createScheduler(): Scheduler {
+  return new Scheduler();
+}
+
+export default schedule;
