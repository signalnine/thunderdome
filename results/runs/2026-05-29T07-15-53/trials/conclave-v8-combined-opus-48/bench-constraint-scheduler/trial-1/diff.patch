+/** Verify every constraint holds for a returned result. Returns list of violations. */
+function validate(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  result: ScheduleResult,
+): string[] {
+  const errors: string[] = [];
+  const gap = options.gap ?? 15;
+  const eventById = new Map(events.map((e) => [e.id, e]));
+  const roomById = new Map(rooms.map((r) => [r.id, r]));
+  const assignById = new Map(result.assignments.map((a) => [a.eventId, a]));
+
+  // Partition: each event exactly once across assignments + unscheduled.
+  const seen = new Set<string>();
+  for (const a of result.assignments) {
+    if (seen.has(a.eventId)) errors.push(`duplicate assignment for ${a.eventId}`);
+    seen.add(a.eventId);
+  }
+  for (const id of result.unscheduled) {
+    if (seen.has(id)) errors.push(`${id} in both assignments and unscheduled`);
+    seen.add(id);
+  }
+  for (const e of events) {
+    if (!seen.has(e.id)) errors.push(`${e.id} missing from result`);
+  }
+  for (const id of seen) {
+    if (!eventById.has(id)) errors.push(`unknown event id ${id} in result`);
+  }
+
+  for (const a of result.assignments) {
+    const e = eventById.get(a.eventId)!;
+    const room = roomById.get(a.roomId);
+    if (!room) {
+      errors.push(`assignment ${a.eventId} uses unknown room ${a.roomId}`);
+      continue;
+    }
+    const attendees = e.attendees ?? 1;
+    // capacity
+    if (attendees > room.capacity)
+      errors.push(`${a.eventId} attendees ${attendees} > capacity ${room.capacity}`);
+    // duration
+    if (a.endTime - a.startTime !== e.duration)
+      errors.push(`${a.eventId} duration mismatch`);
+    // window
+    if (a.startTime < options.startTime)
+      errors.push(`${a.eventId} starts before window`);
+    if (a.endTime > options.endTime) errors.push(`${a.eventId} ends after window`);
+    // prerequisites
+    for (const p of e.prerequisites ?? []) {
+      const pa = assignById.get(p);
+      if (!pa) {
+        errors.push(`${a.eventId} scheduled but prerequisite ${p} not scheduled`);
+        continue;
+      }
+      if (pa.endTime + gap > a.startTime)
+        errors.push(`${a.eventId} starts before prerequisite ${p} + gap`);
+    }
+  }
+
+  // Room gap: no two events in same room closer than gap.
+  const byRoom = new Map<string, typeof result.assignments>();
+  for (const a of result.assignments) {
+    if (!byRoom.has(a.roomId)) byRoom.set(a.roomId, []);
+    byRoom.get(a.roomId)!.push(a);
+  }
+  for (const [roomId, list] of byRoom) {
+    const sorted = [...list].sort((x, y) => x.startTime - y.startTime);
+    for (let i = 1; i < sorted.length; i++) {
+      if (sorted[i].startTime - sorted[i - 1].endTime < gap)
+        errors.push(`gap violated in room ${roomId} between consecutive events`);
+    }
+  }
+
+  return errors;
+}
