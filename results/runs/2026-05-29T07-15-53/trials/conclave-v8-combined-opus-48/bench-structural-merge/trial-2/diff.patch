+{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_016GfoMXwwcHWLPdnBdT85xu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JgUkoiLnSzHtzSbELbts1h","name":"Write","input":{"file_path":"/workspace/src/index.ts","content":"/**\n * In-memory versioned document store with branching and three-way structural merge.\n * \"Git for JSON documents.\"\n */\n\nexport interface Version {\n  id: string;\n  timestamp: number;\n  content: object;\n}\n\nexport interface Conflict {\n  documentId: string;\n  path: string;\n  base: unknown;\n  ours: unknown;\n  theirs: unknown;\n}\n\nexport interface MergeResult {\n  merged: Record<string, object>;\n  conflicts: Conflict[];\n  applied: boolean;\n}\n\n/** A node in the global immutable version DAG. */\ninterface VersionNode {\n  id: string;\n  docId: string;\n  timestamp: number;\n  seq: number;\n  /** Cloned content, or null for a tombstone (deletion). */\n  content: Record<string, unknown> | null;\n  parents: string[];\n}\n\ntype Branch = Map<string, string>; // docId -> head version id\n\n// ---------------------------------------------------------------------------\n// Utilities\n// ---------------------------------------------------------------------------\n\nfunction clone<T>(value: T): T {\n  return structuredClone(value);\n}\n\nfunction isPlainObject(value: unknown): value is Record<string, unknown> {\n  return (\n    typeof value === 'object' &&\n    value !== null &&\n    !Array.isArray(value)\n  );\n}\n\nfunction deepEqual(a: unknown, b: unknown): boolean {\n  if (a === b) return true;\n  if (typeof a !== typeof b) return false;\n  if (a === null || b === null) return a === b;\n\n  if (Array.isArray(a) || Array.isArray(b)) {\n    if (!Array.isArray(a) || !Array.isArray(b)) return false;\n    if (a.length !== b.length) return false;\n    for (let i = 0; i < a.length; i++) {\n      if (!deepEqual(a[i], b[i])) return false;\n    }\n    return true;\n  }\n\n  if (typeof a === 'object' && typeof b === 'object') {\n    const ao = a as Record<string, unknown>;\n    const bo = b as Record<string, unknown>;\n    const aKeys = Object.keys(ao);\n    const bKeys = Object.keys(bo);\n    if (aKeys.length !== bKeys.length) return false;\n    for (const k of aKeys) {\n      if (!Object.prototype.hasOwnProperty.call(bo, k)) return false;\n      if (!deepEqual(ao[k], bo[k])) return false;\n    }\n    return true;\n  }\n\n  return false;\n}\n\n// ---------------------------------------------------------------------------\n// DocumentStore\n// ---------------------------------------------------------------------------\n\nexport class DocumentStore {\n  private versions = new Map<string, VersionNode>();\n  private branches = new Map<string, Branch>();\n  private current = 'main';\n  private seqCounter = 0;\n  private idCounter = 0;\n\n  constructor() {\n    this.branches.set('main', new Map());\n  }\n\n  // --- internal helpers ----------------------------------------------------\n\n  private nextVersionId(): string {\n    return `v${++this.idCounter}`;\n  }\n\n  private newVersion(\n    docId: string,\n    content: Record<string, unknown> | null,\n    parents: string[],\n  ): VersionNode {\n    const node: VersionNode = {\n      id: this.nextVersionId(),\n      docId,\n      timestamp: Date.now(),\n      seq: ++this.seqCounter,\n      content: content === null ? null : clone(content),\n      parents,\n    };\n    this.versions.set(node.id, node);\n    return node;\n  }\n\n  private branchMap(name: string): Branch {\n    const b = this.branches.get(name);\n    if (!b) throw new Error(`Branch \"${name}\" does not exist`);\n    return b;\n  }\n\n  private headNode(branch: Branch, docId: string): VersionNode | undefined {\n    const hid = branch.get(docId);\n    return hid ? this.versions.get(hid) : undefined;\n  }\n\n  /** Live content of a doc on a branch: object if present, null if absent/deleted. */\n  private liveContent(branch: Branch, docId: string): Record<string, unknown> | null {\n    const node = this.headNode(branch, docId);\n    if (!node || node.content === null) return null;\n    return node.content;\n  }\n\n  // --- CRUD ----------------------------------------------------------------\n\n  create(id: string, content: object): void {\n    const branch = this.branchMap(this.current);\n    if (this.liveContent(branch, id) !== null) {\n      throw new Error(`Document \"${id}\" already exists`);\n    }\n    const prevHead = branch.get(id); // may exist as a tombstone\n    const parents = prevHead ? [prevHead] : [];\n    const node = this.newVersion(id, content as Record<string, unknown>, parents);\n    branch.set(id, node.id);\n  }\n\n  get(id: string): object {\n    const branch = this.branchMap(this.current);\n    const content = this.liveContent(branch, id);\n    if (content === null) {\n      throw new Error(`Document \"${id}\" does not exist`);\n    }\n    return clone(content);\n  }\n\n  update(id: string, content: object): void {\n    const branch = this.branchMap(this.current);\n    const head = branch.get(id);\n    if (this.liveContent(branch, id) === null) {\n      throw new Error(`Document \"${id}\" does not exist`);\n    }\n    const node = this.newVersion(id, content as Record<string, unknown>, head ? [head] : []);\n    branch.set(id, node.id);\n  }\n\n  delete(id: string): void {\n    const branch = this.branchMap(this.current);\n    const head = branch.get(id);\n    if (this.liveContent(branch, id) === null) {\n      throw new Error(`Document \"${id}\" does not exist`);\n    }\n    const node = this.newVersion(id, null, head ? [head] : []);\n    branch.set(id, node.id);\n  }\n\n  // --- Version history -----------------------------------------------------\n\n  getHistory(id: string): Version[] {\n    const branch = this.branchMap(this.current);\n    const head = branch.get(id);\n    if (!head) {\n      throw new Error(`Document \"${id}\" does not exist`);\n    }\n    const nodes = this.ancestors(