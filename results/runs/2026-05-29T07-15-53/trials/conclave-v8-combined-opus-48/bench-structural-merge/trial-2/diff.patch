@@ -0,0 +1,463 @@
+/**
+ * In-memory versioned document store with branching and three-way structural merge.
+ * "Git for JSON documents."
+ */
+
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+export interface Conflict {
+  documentId: string;
+  path: string;
+  base: unknown;
+  ours: unknown;
+  theirs: unknown;
+}
+
+export interface MergeResult {
+  merged: Record<string, object>;
+  conflicts: Conflict[];
+  applied: boolean;
+}
+
+/** A node in the global immutable version DAG. */
+interface VersionNode {
+  id: string;
+  docId: string;
+  timestamp: number;
+  seq: number;
+  /** Cloned content, or null for a tombstone (deletion). */
+  content: Record<string, unknown> | null;
+  parents: string[];
+}
+
+type Branch = Map<string, string>; // docId -> head version id
+
+// ---------------------------------------------------------------------------
+// Utilities
+// ---------------------------------------------------------------------------
+
+function clone<T>(value: T): T {
+  return structuredClone(value);
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    !Array.isArray(value)
+  );
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (typeof a !== typeof b) return false;
+  if (a === null || b === null) return a === b;
+
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b)) return false;
+    if (a.length !== b.length) return false;
+    for (let i = 0; i < a.length; i++) {
+      if (!deepEqual(a[i], b[i])) return false;
+    }
+    return true;
+  }
+
+  if (typeof a === 'object' && typeof b === 'object') {
+    const ao = a as Record<string, unknown>;
+    const bo = b as Record<string, unknown>;
+    const aKeys = Object.keys(ao);
+    const bKeys = Object.keys(bo);
+    if (aKeys.length !== bKeys.length) return false;
+    for (const k of aKeys) {
+      if (!Object.prototype.hasOwnProperty.call(bo, k)) return false;
+      if (!deepEqual(ao[k], bo[k])) return false;
+    }
+    return true;
+  }
+
+  return false;
+}
+
+// ---------------------------------------------------------------------------
+// DocumentStore
+// ---------------------------------------------------------------------------
+
+export class DocumentStore {
+  private versions = new Map<string, VersionNode>();
+  private branches = new Map<string, Branch>();
+  private current = 'main';
+  private seqCounter = 0;
+  private idCounter = 0;
+
+  constructor() {
+    this.branches.set('main', new Map());
+  }
+
+  // --- internal helpers ----------------------------------------------------
+
+  private nextVersionId(): string {
+    return `v${++this.idCounter}`;
+  }
+
+  private newVersion(
+    docId: string,
+    content: Record<string, unknown> | null,
+    parents: string[],
+  ): VersionNode {
+    const node: VersionNode = {
+      id: this.nextVersionId(),
+      docId,
+      timestamp: Date.now(),
+      seq: ++this.seqCounter,
+      content: content === null ? null : clone(content),
+      parents,
+    };
+    this.versions.set(node.id, node);
+    return node;
+  }
+
+  private branchMap(name: string): Branch {
+    const b = this.branches.get(name);
+    if (!b) throw new Error(`Branch "${name}" does not exist`);
+    return b;
+  }
+
+  private headNode(branch: Branch, docId: string): VersionNode | undefined {
+    const hid = branch.get(docId);
+    return hid ? this.versions.get(hid) : undefined;
+  }
+
+  /** Live content of a doc on a branch: object if present, null if absent/deleted. */
+  private liveContent(branch: Branch, docId: string): Record<string, unknown> | null {
+    const node = this.headNode(branch, docId);
+    if (!node || node.content === null) return null;
+    return node.content;
+  }
+
+  // --- CRUD ----------------------------------------------------------------
+
+  create(id: string, content: object): void {
+    const branch = this.branchMap(this.current);
+    if (this.liveContent(branch, id) !== null) {
+      throw new Error(`Document "${id}" already exists`);
+    }
+    const prevHead = branch.get(id); // may exist as a tombstone
+    const parents = prevHead ? [prevHead] : [];
+    const node = this.newVersion(id, content as Record<string, unknown>, parents);
+    branch.set(id, node.id);
+  }
+
+  get(id: string): object {
+    const branch = this.branchMap(this.current);
+    const content = this.liveContent(branch, id);
+    if (content === null) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    return clone(content);
+  }
+
+  update(id: string, content: object): void {
+    const branch = this.branchMap(this.current);
+    const head = branch.get(id);
+    if (this.liveContent(branch, id) === null) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    const node = this.newVersion(id, content as Record<string, unknown>, head ? [head] : []);
+    branch.set(id, node.id);
+  }
+
+  delete(id: string): void {
+    const branch = this.branchMap(this.current);
+    const head = branch.get(id);
+    if (this.liveContent(branch, id) === null) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    const node = this.newVersion(id, null, head ? [head] : []);
+    branch.set(id, node.id);
+  }
+
+  // --- Version history -----------------------------------------------------
+
+  getHistory(id: string): Version[] {
+    const branch = this.branchMap(this.current);
+    const head = branch.get(id);
+    if (!head) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    const nodes = this.ancestors(head); // includes head
+    const versions = [...nodes]
+      .map((vid) => this.versions.get(vid)!)
+      .filter((n) => n.content !== null)
+      .sort((a, b) => a.seq - b.seq);
+    return versions.map((n) => ({
+      id: n.id,
+      timestamp: n.timestamp,
+      content: clone(n.content as Record<string, unknown>),
+    }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const node = this.versions.get(versionId);
+    if (!node || node.docId !== id || node.content === null) {
+      throw new Error(`Version "${versionId}" of document "${id}" not found`);
+    }
+    return clone(node.content);
+  }
+
+  // --- Branching -----------------------------------------------------------
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const source = this.branchMap(fromBranch ?? this.current);
+    this.branches.set(name, new Map(source)); // copy head pointers
+  }
+
+  switchBranch(name: string): void {
+    this.branchMap(name); // throws if missing
+    this.current = name;
+  }
+
+  getBranch(): string {
+    return this.current;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  // --- DAG helpers ---------------------------------------------------------
+
+  /** All ancestor version ids reachable from `start`, including `start`. */
+  private ancestors(start: string): Set<string> {
+    const seen = new Set<string>();
+    const stack = [start];
+    while (stack.length) {
+      const id = stack.pop()!;
+      if (seen.has(id)) continue;
+      seen.add(id);
+      const node = this.versions.get(id);
+      if (node) stack.push(...node.parents);
+    }
+    return seen;
+  }
+
+  /** Most recent common ancestor version id of two heads, or undefined. */
+  private lca(a: string | undefined, b: string | undefined): string | undefined {
+    if (!a || !b) return undefined;
+    const ancA = this.ancestors(a);
+    const ancB = this.ancestors(b);
+    let best: VersionNode | undefined;
+    for (const id of ancA) {
+      if (!ancB.has(id)) continue;
+      const node = this.versions.get(id)!;
+      if (!best || node.seq > best.seq) best = node;
+    }
+    return best?.id;
+  }
+
+  // --- Merging -------------------------------------------------------------
+
+  merge(sourceBranch: string): MergeResult {
+    const ours = this.branchMap(this.current);
+    const theirs = this.branchMap(sourceBranch);
+
+    const docIds = new Set<string>([...ours.keys(), ...theirs.keys()]);
+    const conflicts: Conflict[] = [];
+    const merged: Record<string, object> = {};
+    // Pending writes to apply if there are no conflicts.
+    const writes: { docId: string; content: Record<string, unknown> | null }[] = [];
+
+    for (const docId of docIds) {
+      const oursHead = ours.get(docId);
+      const theirsHead = theirs.get(docId);
+      const baseHead = this.lca(oursHead, theirsHead);
+
+      const ourC = this.liveContent(ours, docId);
+      const theirC = this.liveContent(theirs, docId);
+      const baseC =
+        baseHead && this.versions.get(baseHead)!.content !== null
+          ? (this.versions.get(baseHead)!.content as Record<string, unknown>)
+          : null;
+
+      const docConflicts: Conflict[] = [];
+      const result = this.mergeDocument(docId, baseC, ourC, theirC, docConflicts);
+
+      conflicts.push(...docConflicts);
+
+      if (result !== null) {
+        merged[docId] = result;
+      }
+
+      // Record what would change on our branch if applied.
+      if (!deepEqual(result, ourC)) {
+        writes.push({ docId, content: result });
+      }
+    }
+
+    const applied = conflicts.length === 0;
+
+    if (applied) {
+      for (const w of writes) {
+        const oursHead = ours.get(w.docId);
+        const theirsHead = theirs.get(w.docId);
+        const parents = [oursHead, theirsHead].filter((p): p is string => !!p);
+        const node = this.newVersion(w.docId, w.content, parents);
+        ours.set(w.docId, node.id);
+      }
+    }
+
+    return { merged, conflicts, applied };
+  }
+
+  /**
+   * Three-way merge of a single document.
+   * Returns the merged content (object) or null if the document should not exist.
+   * Pushes any conflicts into `conflicts`. The returned content always resolves
+   * conflicts in favour of "ours".
+   */
+  private mergeDocument(
+    docId: string,
+    base: Record<string, unknown> | null,
+    ours: Record<string, unknown> | null,
+    theirs: Record<string, unknown> | null,
+    conflicts: Conflict[],
+  ): Record<string, unknown> | null {
+    // No difference between branches -> nothing to merge.
+    if (deepEqual(ours, theirs)) {
+      return ours === null ? null : clone(ours);
+    }
+
+    const oursChanged = !deepEqual(base, ours);
+    const theirsChanged = !deepEqual(base, theirs);
+
+    if (!oursChanged) {
+      // Only the source changed -> take theirs.
+      return theirs === null ? null : clone(theirs);
+    }
+    if (!theirsChanged) {
+      // Only we changed -> keep ours.
+      return ours === null ? null : clone(ours);
+    }
+
+    // Both sides changed. If either side is a non-object (deleted), this is a
+    // whole-document delete/modify conflict.
+    if (ours === null || theirs === null) {
+      conflicts.push({
+        documentId: docId,
+        path: '',
+        base: base === null ? undefined : clone(base),
+        ours: ours === null ? undefined : clone(ours),
+        theirs: theirs === null ? undefined : clone(theirs),
+      });
+      return ours === null ? null : clone(ours);
+    }
+
+    // Both are objects -> structural field-level merge.
+    const baseObj = base ?? {};
+    return this.mergeObject(docId, '', baseObj, ours, theirs, conflicts);
+  }
+
+  /** Recursively merge two objects against a base. */
+  private mergeObject(
+    docId: string,
+    pathPrefix: string,
+    base: Record<string, unknown>,
+    ours: Record<string, unknown>,
+    theirs: Record<string, unknown>,
+    conflicts: Conflict[],
+  ): Record<string, unknown> {
+    const result: Record<string, unknown> = {};
+    const keys = new Set<string>([
+      ...Object.keys(base),
+      ...Object.keys(ours),
+      ...Object.keys(theirs),
+    ]);
+
+    for (const key of keys) {
+      const path = pathPrefix ? `${pathPrefix}.${key}` : key;
+      const bHas = Object.prototype.hasOwnProperty.call(base, key);
+      const oHas = Object.prototype.hasOwnProperty.call(ours, key);
+      const tHas = Object.prototype.hasOwnProperty.call(theirs, key);
+      const bVal = base[key];
+      const oVal = ours[key];
+      const tVal = theirs[key];
+
+      const value = this.mergeValue(
+        docId,
+        path,
+        bHas,
+        oHas,
+        tHas,
+        bVal,
+        oVal,
+        tVal,
+        conflicts,
+      );
+
+      if (value.present) {
+        result[key] = value.value;
+      }
+    }
+
+    return result;
+  }
+
+  /**
+   * Merge a single keyed value. Returns whether the key should be present in
+   * the result and, if so, its value.
+   */
+  private mergeValue(
+    docId: string,
+    path: string,
+    bHas: boolean,
+    oHas: boolean,
+    tHas: boolean,
+    bVal: unknown,
+    oVal: unknown,
+    tVal: unknown,
+    conflicts: Conflict[],
+  ): { present: boolean; value?: unknown } {
+    const oursEqTheirs = oHas === tHas && deepEqual(oVal, tVal);
+    if (oursEqTheirs) {
+      // Both sides agree (including both-absent).
+      return oHas ? { present: true, value: clone(oVal) } : { present: false };
+    }
+
+    const oursChanged = !(bHas === oHas && deepEqual(bVal, oVal));
+    const theirsChanged = !(bHas === tHas && deepEqual(bVal, tVal));
+
+    if (!oursChanged) {
+      // Only theirs changed -> take theirs.
+      return tHas ? { present: true, value: clone(tVal) } : { present: false };
+    }
+    if (!theirsChanged) {
+      // Only ours changed -> keep ours.
+      return oHas ? { present: true, value: clone(oVal) } : { present: false };
+    }
+
+    // Both changed. Recurse if both are plain objects; otherwise leaf conflict.
+    if (oHas && tHas && isPlainObject(oVal) && isPlainObject(tVal)) {
+      const baseObj = isPlainObject(bVal) ? bVal : {};
+      const merged = this.mergeObject(docId, path, baseObj, oVal, tVal, conflicts);
+      return { present: true, value: merged };
+    }
+
+    // Leaf conflict (or object-vs-scalar): resolve in favour of ours.
+    conflicts.push({
+      documentId: docId,
+      path,
+      base: bHas ? clone(bVal) : undefined,
+      ours: oHas ? clone(oVal) : undefined,
+      theirs: tHas ? clone(tVal) : undefined,
+    });
+    return oHas ? { present: true, value: clone(oVal) } : { present: false };
+  }
+}
+
+export default DocumentStore;
