new file mode 100644
index 0000000..2d679cb
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,440 @@
+/**
+ * Versioned Document Store with Structural Merge — "Git for JSON documents".
+ *
+ * In-memory, synchronous. Supports CRUD, per-document version history, branching,
+ * and three-way structural merge between branches.
+ */
+
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+export interface Conflict {
+  documentId: string;
+  /** dot-separated JSON path; "" denotes a whole-document (e.g. delete/modify) conflict. */
+  path: string;
+  base: unknown;
+  ours: unknown;
+  theirs: unknown;
+}
+
+export interface MergeResult {
+  /** documentId -> merged content (deleted documents are omitted) */
+  merged: Record<string, object>;
+  conflicts: Conflict[];
+  /** true if the merge had no conflicts and was auto-applied to the current branch */
+  applied: boolean;
+}
+
+/** A node in the per-document version DAG. */
+interface VersionNode {
+  id: string;
+  docId: string;
+  timestamp: number;
+  content: object;
+  parents: string[];
+}
+
+/** Per-branch state of a single document. `head` is always retained for ancestry. */
+interface DocState {
+  head: string;
+  deleted: boolean;
+}
+
+interface Branch {
+  name: string;
+  docs: Map<string, DocState>;
+}
+
+// ---------------------------------------------------------------------------
+// Pure helpers
+// ---------------------------------------------------------------------------
+
+function isPlainObject(v: unknown): v is Record<string, unknown> {
+  return typeof v === 'object' && v !== null && !Array.isArray(v);
+}
+
+function deepClone<T>(v: T): T {
+  return structuredClone(v);
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (typeof a !== typeof b) return false;
+  if (a === null || b === null) return a === b;
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b)) return false;
+    if (a.length !== b.length) return false;
+    return a.every((v, i) => deepEqual(v, b[i]));
+  }
+  if (typeof a === 'object' && typeof b === 'object') {
+    const ka = Object.keys(a as object);
+    const kb = Object.keys(b as object);
+    if (ka.length !== kb.length) return false;
+    return ka.every(
+      (k) =>
+        Object.prototype.hasOwnProperty.call(b, k) &&
+        deepEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]),
+    );
+  }
+  return false;
+}
+
+/** Sentinel-free absence: JSON values are never `undefined`, so we use it to mean "key absent". */
+const ABSENT = undefined;
+
+/**
+ * Three-way merge of a single value. Returns the merged value, or `undefined` to
+ * signal the key/document should be absent (deleted). Pushes any conflicts found.
+ */
+function mergeValue(
+  base: unknown,
+  ours: unknown,
+  theirs: unknown,
+  path: string,
+  docId: string,
+  conflicts: Conflict[],
+): unknown {
+  if (deepEqual(ours, theirs)) return ours; // both identical (incl. both absent)
+  if (deepEqual(ours, base)) return theirs; // ours unchanged -> take theirs (may delete)
+  if (deepEqual(theirs, base)) return ours; // theirs unchanged -> keep ours (may delete)
+
+  // Both sides changed differently.
+  if (isPlainObject(ours) && isPlainObject(theirs)) {
+    // Recurse for structural merge of nested objects.
+    return mergeObject(base, ours, theirs, path, docId, conflicts);
+  }
+
+  // Genuine conflict on this value.
+  conflicts.push({
+    documentId: docId,
+    path,
+    base: deepClone(base),
+    ours: deepClone(ours),
+    theirs: deepClone(theirs),
+  });
+  return ours; // merged view resolves in favour of ours
+}
+
+/** Three-way merge of object key-sets. base may be a non-object (treated as {}). */
+function mergeObject(
+  base: unknown,
+  ours: unknown,
+  theirs: unknown,
+  path: string,
+  docId: string,
+  conflicts: Conflict[],
+): Record<string, unknown> {
+  const b = isPlainObject(base) ? base : {};
+  const o = isPlainObject(ours) ? ours : {};
+  const t = isPlainObject(theirs) ? theirs : {};
+  const keys = new Set([...Object.keys(b), ...Object.keys(o), ...Object.keys(t)]);
+
+  const result: Record<string, unknown> = {};
+  for (const key of keys) {
+    const childPath = path ? `${path}.${key}` : key;
+    const merged = mergeValue(b[key], o[key], t[key], childPath, docId, conflicts);
+    if (merged !== ABSENT) result[key] = merged;
+  }
+  return result;
+}
+
+// ---------------------------------------------------------------------------
+// DocumentStore
+// ---------------------------------------------------------------------------
+
+const DEFAULT_BRANCH = 'main';
+
+export class DocumentStore {
+  private branches = new Map<string, Branch>();
+  private versions = new Map<string, VersionNode>();
+  private current: string = DEFAULT_BRANCH;
+  private versionCounter = 0;
+  private clock = 0;
+
+  constructor() {
+    this.branches.set(DEFAULT_BRANCH, { name: DEFAULT_BRANCH, docs: new Map() });
+  }
+
+  // --- internal utilities --------------------------------------------------
+
+  private branch(name: string): Branch {
+    const b = this.branches.get(name);
+    if (!b) throw new Error(`Branch "${name}" does not exist`);
+    return b;
+  }
+
+  private currentBranch(): Branch {
+    return this.branch(this.current);
+  }
+
+  /** Strictly-increasing timestamp so version ordering is always deterministic. */
+  private now(): number {
+    this.clock = Math.max(this.clock + 1, Date.now());
+    return this.clock;
+  }
+
+  private nextVersionId(): string {
+    this.versionCounter += 1;
+    return `v${this.versionCounter}`;
+  }
+
+  private newVersion(docId: string, content: object, parents: string[]): VersionNode {
+    const node: VersionNode = {
+      id: this.nextVersionId(),
+      docId,
+      timestamp: this.now(),
+      content: deepClone(content),
+      parents,
+    };
+    this.versions.set(node.id, node);
+    return node;
+  }
+
+  private version(id: string): VersionNode {
+    const v = this.versions.get(id);
+    if (!v) throw new Error(`Version "${id}" does not exist`);
+    return v;
+  }
+
+  /** Live content of a document on a branch, or undefined if absent/deleted. */
+  private liveContent(branch: Branch, id: string): object | undefined {
+    const state = branch.docs.get(id);
+    if (!state || state.deleted) return undefined;
+    return this.version(state.head).content;
+  }
+
+  // --- CRUD ----------------------------------------------------------------
+
+  create(id: string, content: object): void {
+    if (!isPlainObject(content)) {
+      throw new TypeError('Document content must be a plain object');
+    }
+    const branch = this.currentBranch();
+    const existing = branch.docs.get(id);
+    if (existing && !existing.deleted) {
+      throw new Error(`Document "${id}" already exists`);
+    }
+    const parents = existing ? [existing.head] : [];
+    const node = this.newVersion(id, content, parents);
+    branch.docs.set(id, { head: node.id, deleted: false });
+  }
+
+  get(id: string): object {
+    const branch = this.currentBranch();
+    const state = branch.docs.get(id);
+    if (!state || state.deleted) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    return deepClone(this.version(state.head).content);
+  }
+
+  update(id: string, content: object): void {
+    if (!isPlainObject(content)) {
+      throw new TypeError('Document content must be a plain object');
+    }
+    const branch = this.currentBranch();
+    const state = branch.docs.get(id);
+    if (!state || state.deleted) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    const node = this.newVersion(id, content, [state.head]);
+    state.head = node.id;
+  }
+
+  delete(id: string): void {
+    const branch = this.currentBranch();
+    const state = branch.docs.get(id);
+    if (!state || state.deleted) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    state.deleted = true;
+  }
+
+  // --- Version history -----------------------------------------------------
+
+  getHistory(id: string): Version[] {
+    const branch = this.currentBranch();
+    const state = branch.docs.get(id);
+    if (!state || state.deleted) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    const nodes = this.collectAncestors(state.head).map((vid) => this.version(vid));
+    nodes.sort((a, b) => a.timestamp - b.timestamp);
+    return nodes.map((n) => ({
+      id: n.id,
+      timestamp: n.timestamp,
+      content: deepClone(n.content),
+    }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const node = this.versions.get(versionId);
+    if (!node || node.docId !== id) {
+      throw new Error(`Version "${versionId}" does not exist for document "${id}"`);
+    }
+    return deepClone(node.content);
+  }
+
+  // --- Branching -----------------------------------------------------------
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const source = this.branch(fromBranch ?? this.current);
+    const docs = new Map<string, DocState>();
+    for (const [docId, state] of source.docs) {
+      docs.set(docId, { head: state.head, deleted: state.deleted });
+    }
+    this.branches.set(name, { name, docs });
+  }
+
+  switchBranch(name: string): void {
+    this.branch(name); // throws if unknown
+    this.current = name;
+  }
+
+  getBranch(): string {
+    return this.current;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  // --- Merging -------------------------------------------------------------
+
+  merge(sourceBranch: string): MergeResult {
+    const source = this.branch(sourceBranch);
+    const target = this.currentBranch();
+
+    const conflicts: Conflict[] = [];
+    const merged: Record<string, object> = {};
+    // Pending writes to apply only if the whole merge is conflict-free.
+    const writes: Array<{ docId: string; content?: object; parents: string[] }> = [];
+
+    const docIds = new Set<string>([...target.docs.keys(), ...source.docs.keys()]);
+    for (const docId of docIds) {
+      const ours = this.liveContent(target, docId);
+      const theirs = this.liveContent(source, docId);
+      const oursHead = target.docs.get(docId)?.head;
+      const theirsHead = source.docs.get(docId)?.head;
+
+      const baseHead =
+        oursHead && theirsHead ? this.lca(oursHead, theirsHead) : undefined;
+      const base = baseHead ? this.version(baseHead).content : undefined;
+
+      const before = conflicts.length;
+      const result = this.mergeDocument(base, ours, theirs, docId, conflicts);
+      const docHadConflict = conflicts.length > before;
+
+      if (result !== ABSENT) merged[docId] = deepClone(result);
+
+      // Only schedule a write when the source actually contributed a change
+      // (theirs differs from base) — otherwise the target already holds the result.
+      const theirsChanged = !deepEqual(theirs, base);
+      if (!docHadConflict && theirsChanged) {
+        const parents = [oursHead, theirsHead].filter((p): p is string => !!p);
+        writes.push({ docId, content: result, parents });
+      }
+    }
+
+    if (conflicts.length > 0) {
+      return { merged, conflicts, applied: false };
+    }
+
+    // Auto-apply: conflict-free.
+    for (const w of writes) {
+      const state = target.docs.get(w.docId);
+      if (w.content === ABSENT) {
+        // Deletion brought over from source.
+        if (state && !state.deleted) state.deleted = true;
+        continue;
+      }
+      const node = this.newVersion(w.docId, w.content, w.parents);
+      target.docs.set(w.docId, { head: node.id, deleted: false });
+    }
+
+    return { merged, conflicts, applied: true };
+  }
+
+  /**
+   * Three-way merge for one document. Returns merged content, or undefined if the
+   * document should be absent (deleted) in the result.
+   */
+  private mergeDocument(
+    base: object | undefined,
+    ours: object | undefined,
+    theirs: object | undefined,
+    docId: string,
+    conflicts: Conflict[],
+  ): object | undefined {
+    if (deepEqual(ours, theirs)) return ours; // identical (incl. both deleted)
+
+    const oursChanged = !deepEqual(ours, base);
+    const theirsChanged = !deepEqual(theirs, base);
+
+    if (!theirsChanged) return ours; // source unchanged -> keep ours
+    if (!oursChanged) return theirs; // we unchanged -> take theirs (incl. deletion)
+
+    // Both sides changed. A whole-document delete vs modify is a conflict.
+    if (ours === ABSENT || theirs === ABSENT) {
+      conflicts.push({
+        documentId: docId,
+        path: '',
+        base: deepClone(base),
+        ours: deepClone(ours),
+        theirs: deepClone(theirs),
+      });
+      return ours;
+    }
+
+    // Both present -> structural field-level merge.
+    return mergeObject(base, ours, theirs, '', docId, conflicts) as object;
+  }
+
+  /** All ancestor version ids of `id` (inclusive). */
+  private collectAncestors(id: string): string[] {
+    const seen = new Set<string>();
+    const stack = [id];
+    while (stack.length) {
+      const cur = stack.pop()!;
+      if (seen.has(cur)) continue;
+      seen.add(cur);
+      const node = this.versions.get(cur);
+      if (node) stack.push(...node.parents);
+    }
+    return [...seen];
+  }
+
+  /** Most-recent common ancestor of two versions, or undefined if none. */
+  private lca(a: string, b: string): string | undefined {
+    const ancestorsA = new Set(this.collectAncestors(a));
+    let best: string | undefined;
+    let bestTs = -Infinity;
+    const seen = new Set<string>();
+    const stack = [b];
+    while (stack.length) {
+      const cur = stack.pop()!;
+      if (seen.has(cur)) continue;
+      seen.add(cur);
+      const node = this.versions.get(cur);
+      if (!node) continue;
+      if (ancestorsA.has(cur)) {
+        if (node.timestamp > bestTs) {
+          bestTs = node.timestamp;
+          best = cur;
+        }
+        // A common ancestor's own ancestors are older; no need to expand.
+        continue;
+      }
+      stack.push(...node.parents);
+    }
+    return best;
+  }
+}
+
+export default DocumentStore;
