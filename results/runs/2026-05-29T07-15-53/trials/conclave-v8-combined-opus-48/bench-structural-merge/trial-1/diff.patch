{ x: { y: 1 } });\n  });\n\n  it('update replaces content', () => {\n    store.create('a', { x: 1 });\n    store.update('a', { x: 2, z: 3 });\n    expect(store.get('a')).toEqual({ x: 2, z: 3 });\n  });\n\n  it('update throws for missing/deleted document', () => {\n    expect(() => store.update('a', { x: 1 })).toThrow();\n    store.create('a', { x: 1 });\n    store.delete('a');\n    expect(() => store.update('a', { x: 2 })).toThrow();\n  });\n\n  it('delete removes document', () => {\n    store.create('a', { x: 1 });\n    store.delete('a');\n    expect(() => store.get('a')).toThrow();\n  });\n\n  it('delete throws for missing/double delete', () => {\n    expect(() => store.delete('a')).toThrow();\n    store.create('a', { x: 1 });\n    store.delete('a');\n    expect(() => store.delete('a')).toThrow();\n  });\n});\n\ndescribe('Version history', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('create + updates generate versions', () => {\n    store.create('a', { x: 1 });\n    store.update('a', { x: 2 });\n    store.update('a', { x: 3 });\n    const h = store.getHistory('a');\n    expect(h.length).toBe(3);\n  });\n\n  it('versions have unique ids, numeric timestamps, full content', () => {\n    store.create('a', { x: 1 });\n    store.update('a', { x: 2 });\n    const h = store.getHistory('a');\n    const ids = new Set(h.map((v) => v.id));\n    expect(ids.size).toBe(h.length);\n    for (const v of h) {\n      expect(typeof v.timestamp).toBe('number');\n      expect(typeof v.content).toBe('object');\n    }\n  });\n\n  it('getHistory returns chronological order (oldest first)', () => {\n    store.create('a', { n: 1 });\n    store.update('a', { n: 2 });\n    store.update('a', { n: 3 });\n    const h = store.getHistory('a');\n    expect(h.map((v) => (v.content as { n: number }).n)).toEqual([1, 2, 3]);\n    for (let i = 1; i < h.length; i++) {\n      expect(h[i].timestamp).toBeGreaterThanOrEqual(h[i - 1].timestamp);\n    }\n  });\n\n  it('getHistory throws for missing doc', () => {\n    expect(() => store.getHistory('nope')).toThrow();\n  });\n\n  it('getVersion returns content at version (clone)', () => {\n    store.create('a', { n: 1 });\n    store.update('a', { n: 2 });\n    const h = store.getHistory('a');\n    expect(store.getVersion('a', h[0].id)).toEqual({ n: 1 });\n    expect(store.getVersion('a', h[1].id)).toEqual({ n: 2 });\n    const got = store.getVersion('a', h[0].id) as { n: number };\n    got.n = 999;\n    expect(store.getVersion('a', h[0].id)).toEqual({ n: 1 });\n  });\n\n  it('getVersion throws for unknown version or wrong doc', () => {\n    store.create('a', { n: 1 });\n    store.create('b', { n: 1 });\n    const hb = store.getHistory('b');\n    expect(() => store.getVersion('a', 'bogus')).toThrow();\n    expect(() => store.getVersion('a', hb[0].id)).toThrow();\n  });\n});\n\ndescribe('Branching', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('default branch is main', () => {\n    expect(store.getBranch()).toBe('main');\n  });\n\n  it('createBranch branches from current state', () => {\n    store.create('a', { x: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    expect(store.get('a')).toEqual({ x: 1 });\n  });\n\n  it('createBranch with fromBranch', () => {\n    store.create('a', { x: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('a', { x: 2 });\n    // new branch from main (not current feature)\n    store.createBranch('other', 'main');\n    store.switchBranch('other');\n    expect(store.get('a')).toEqual({ x: 1 });\n  });\n\n  it('createBranch throws if name exists', () => {\n    store.createBranch('feature');\n    expect(() => store.createBranch('feature')).toThrow();\n    expect(() => store.createBranch('main')).toThrow();\n  });\n\n  it('switchBranch throws for unknown branch', () => {\n    expect(() => store.switchBranch('nope')).toThrow();\n  });\n\n  it('changes isolated per branch', () => {\n    store.create('a', { x: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('a', { x: 2 });\n    store.create('b', { y: 1 });\n    store.switchBranch('main');\n    expect(store.get('a')).toEqual({ x: 1 });\n    expect(() => store.get('b')).toThrow();\n  });\n\n  it('listBranches returns all names', () => {\n    store.createBranch('feature');\n    store.createBranch('hotfix');\n    expect(store.listBranches().sort()).toEqual(['feature', 'hotfix', 'main']);\n  });\n});\n\ndescribe('Merging', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('one-sided field change taken, no conflict', () => {\n    store.create('a', { x: 1, y: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('a', { x: 1, y: 2 }); // change y on feature\n    store.switchBranch('main');\n    const res = store.merge('feature');\n    expect(res.conflicts).toEqual([]);\n    expect(res.applied).toBe(true);\n    expect(store.get('a')).toEqual({ x: 1, y: 2 });\n  });\n\n  it('both change same field to same value -> no conflict', () => {\n    store.create('a', { x: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('a', { x: 5 });\n    store.switchBranch('main');\n    store.update('a', { x: 5 });\n    const res = store.merge('feature');\n    expect(res.conflicts).toEqual([]);\n    expect(res.applied).toBe(true);\n    expect(store.get('a')).toEqual({ x: 5 });\n  });\n\n  it('both change same field to different value -> conflict, not applied', () => {\n    store.create('a', { x: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('a', { x: 2 });\n    store.switchBranch('main');\n    store.update('a', { x: 3 });\n    const res = store.merge('feature');\n    expect(res.applied).toBe(false);\n    e