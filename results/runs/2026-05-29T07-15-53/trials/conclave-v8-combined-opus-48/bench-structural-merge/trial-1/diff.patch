+    expect(res.merged['a']).toBeUndefined();
+  });
+
+  it('delete on source, modified on target -> conflict', () => {
+    store.create('a', { x: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.delete('a');
+    store.switchBranch('main');
+    store.update('a', { x: 2 });
