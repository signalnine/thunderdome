+  });
+
+  it('both change same field to same value -> no conflict', () => {
+    store.create('a', { x: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('a', { x: 5 });
+    store.switchBranch('main');
+    store.update('a', { x: 5 });
+    const res = store.merge('feature');
+    expect(res.conflicts).toEqual([]);
+    expect(res.applied).toBe(true);
+    expect(store.get('a')).toEqual({ x: 5 });
