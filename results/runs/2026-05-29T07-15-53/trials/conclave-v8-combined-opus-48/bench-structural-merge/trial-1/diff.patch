+import { describe, it, expect, beforeEach } from 'vitest';
+import { DocumentStore } from './index.js';
+
+describe('CRUD', () => {
+  let store: DocumentStore;
+  beforeEach(() => {
+    store = new DocumentStore();
+  });
+
+  it('create stores a document retrievable via get', () => {
+    store.create('a', { x: 1 });
+    expect(store.get('a')).toEqual({ x: 1 });
+  });
+
+  it('create throws if id already exists', () => {
+    store.create('a', { x: 1 });
+    expect(() => store.create('a', { x: 2 })).toThrow();
+  });
+
+  it('create allowed after delete', () => {
+    store.create('a', { x: 1 });
+    store.delete('a');
+    expect(() => store.create('a', { x: 9 })).not.toThrow();
+    expect(store.get('a')).toEqual({ x: 9 });
+  });
+
+  it('create throws on non-plain-object content', () => {
+    expect(() => store.create('a', [] as unknown as object)).toThrow();
+    expect(() => store.create('b', 5 as unknown as object)).toThrow();
+    expect(() => store.create('c', null as unknown as object)).toThrow();
+  });
+
+  it('get throws for missing document', () => {
+    expect(() => store.get('nope')).toThrow();
+  });
+
+  it('get throws for deleted document', () => {
+    store.create('a', { x: 1 });
+    store.delete('a');
+    expect(() => store.get('a')).toThrow();
+  });
+
+  it('get returns a deep clone (no external mutation)', () => {
+    store.create('a', { x: { y: 1 } });
+    const got = store.get('a') as { x: { y: number } };
+    got.x.y = 999;
+    expect(store.get('a')).toEqual({ x: { y: 1 } });
+  });
+
+  it('create deep-clones the input', () => {
+    const input = { x: { y: 1 } };
+    store.create('a', input);
+    input.x.y = 999;
+    expect(store.get('a')).toEqual({ x: { y: 1 } });
+  });
+
+  it('update replaces content', () => {
+    store.create('a', { x: 1 });
+    store.update('a', { x: 2, z: 3 });
+    expect(store.get('a')).toEqual({ x: 2, z: 3 });
+  });
+
+  it('update throws for missing/deleted document', () => {
+    expect(() => store.update('a', { x: 1 })).toThrow();
+    store.create('a', { x: 1 });
+    store.delete('a');
+    expect(() => store.update('a', { x: 2 })).toThrow();
+  });
+
+  it('delete removes document', () => {
+    store.create('a', { x: 1 });
+    store.delete('a');
+    expect(() => store.get('a')).toThrow();
+  });
+
+  it('delete throws for missing/double delete', () => {
+    expect(() => store.delete('a')).toThrow();
+    store.create('a', { x: 1 });
+    store.delete('a');
+    expect(() => store.delete('a')).toThrow();
+  });
+});
+
+describe('Version history', () => {
+  let store: DocumentStore;
+  beforeEach(() => {
+    store = new DocumentStore();
+  });
+
+  it('create + updates generate versions', () => {
+    store.create('a', { x: 1 });
+    store.update('a', { x: 2 });
+    store.update('a', { x: 3 });
+    const h = store.getHistory('a');
+    expect(h.length).toBe(3);
+  });
+
+  it('versions have unique ids, numeric timestamps, full content', () => {
+    store.create('a', { x: 1 });
+    store.update('a', { x: 2 });
+    const h = store.getHistory('a');
+    const ids = new Set(h.map((v) => v.id));
+    expect(ids.size).toBe(h.length);
+    for (const v of h) {
+      expect(typeof v.timestamp).toBe('number');
+      expect(typeof v.content).toBe('object');
+    }
+  });
+
+  it('getHistory returns chronological order (oldest first)', () => {
+    store.create('a', { n: 1 });
+    store.update('a', { n: 2 });
+    store.update('a', { n: 3 });
+    const h = store.getHistory('a');
+    expect(h.map((v) => (v.content as { n: number }).n)).toEqual([1, 2, 3]);
+    for (let i = 1; i < h.length; i++) {
+      expect(h[i].timestamp).toBeGreaterThanOrEqual(h[i - 1].timestamp);
+    }
+  });
+
+  it('getHistory throws for missing doc', () => {
+    expect(() => store.getHistory('nope')).toThrow();
+  });
+
+  it('getVersion returns content at version (clone)', () => {
+    store.create('a', { n: 1 });
