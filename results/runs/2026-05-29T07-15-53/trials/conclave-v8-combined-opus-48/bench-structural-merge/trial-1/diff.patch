+    store.createBranch('other', 'main');
+    store.switchBranch('other');
+    expect(store.get('a')).toEqual({ x: 1 });
+  });
+
+  it('createBranch throws if name exists', () => {
+    store.createBranch('feature');
+    expect(() => store.createBranch('feature')).toThrow();
+    expect(() => store.createBranch('main')).toThrow();
+  });
+
+  it('switchBranch throws for unknown branch', () => {
+    expect(() => store.switchBranch('nope')).toThrow();
+  });
+
+  it('changes isolated per branch', () => {
+    store.create('a', { x: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('a', { x: 2 });
+    store.create('b', { y: 1 });
+    store.switchBranch('main');
+    expect(store.get('a')).toEqual({ x: 1 });
+    expect(() => store.get('b')).toThrow();
