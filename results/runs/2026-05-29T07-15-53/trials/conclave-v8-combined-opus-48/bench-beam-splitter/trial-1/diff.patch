+/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ *
+ * Grid cells:
+ *   'S' — beam source on the top row, emits a beam straight down.
+ *   '^' — splitter: an arriving beam splits into down-left and down-right.
+ *   '.' — empty cell, beams pass through.
+ *
+ * Beams always advance one row downward per step, so the state space is a DAG
+ * (row strictly increases) — no cycles, and memoization terminates.
+ */
+
+// Direction encoding: column delta applied on each downward step.
+const DOWN = 0; // (row+1, col)
+const DOWN_LEFT = 1; // (row+1, col-1)
+const DOWN_RIGHT = 2; // (row+1, col+1)
+
+const COL_DELTA = [0, -1, 1];
+
+type Dir = typeof DOWN | typeof DOWN_LEFT | typeof DOWN_RIGHT;
+
+interface Dims {
+  rows: number;
+  cols: number;
+}
+
+function dims(grid: string[][]): Dims {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  return { rows, cols };
+}
+
+function sourceColumns(grid: string[][], cols: number): number[] {
+  // Sources live on the top row and emit straight down.
+  const sources: number[] = [];
+  if (grid.length === 0) return sources;
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') sources.push(c);
+  }
+  return sources;
+}
+
+/**
+ * Count the number of distinct cells visited by any beam.
+ *
+ * Traverses every reachable beam state (row, col, direction) once, deduping
+ * states so overlapping beams don't cause exponential work, and collects the
+ * set of cells touched.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const { rows, cols } = dims(grid);
+  if (rows === 0 || cols === 0) return 0;
+
+  const seenState = new Uint8Array(rows * cols * 3);
+  const visitedCell = new Uint8Array(rows * cols);
+  let cellCount = 0;
+
+  // Explicit stack of in-bounds beam arrivals: (row, col, dir).
+  const stack: number[] = [];
+
+  for (const c of sourceColumns(grid, cols)) {
+    stack.push(0, c, DOWN);
+  }
+
+  while (stack.length > 0) {
+    const dir = stack.pop() as Dir;
+    const col = stack.pop() as number;
+    const row = stack.pop() as number;
+
+    const stateKey = (row * cols + col) * 3 + dir;
+    if (seenState[stateKey]) continue;
+    seenState[stateKey] = 1;
+
+    const cellKey = row * cols + col;
+    if (!visitedCell[cellKey]) {
+      visitedCell[cellKey] = 1;
+      cellCount++;
+    }
+
+    const cell = grid[row][col];
+    if (cell === '^') {
+      pushIfInBounds(stack, row + 1, col - 1, DOWN_LEFT, rows, cols);
+      pushIfInBounds(stack, row + 1, col + 1, DOWN_RIGHT, rows, cols);
+    } else {
+      pushIfInBounds(stack, row + 1, col + COL_DELTA[dir], dir, rows, cols);
+    }
+  }
+
+  return cellCount;
+}
+
+function pushIfInBounds(
+  stack: number[],
+  row: number,
+  col: number,
+  dir: Dir,
+  rows: number,
+  cols: number,
+): void {
+  if (row < 0 || row >= rows || col < 0 || col >= cols) return;
+  stack.push(row, col, dir);
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths.
+ *
+ * Uses memoized DP over beam states: f(row, col, dir) = number of exit paths
+ * from this in-bounds arrival. A child stepping out of bounds is one completed
+ * (absorbed) path. The state count is bounded by rows*cols*3, so deep splitter
+ * chains that would yield 2^K paths are still computed in polynomial time.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const { rows, cols } = dims(grid);
+  if (rows === 0 || cols === 0) return 0n;
+
+  const memo = new Array<bigint | undefined>(rows * cols * 3);
+
+  // Iterative DP filling rows bottom-up so each state only reads lower rows.
+  // f(row,col,dir) depends solely on row+1 states, so processing rows in
+  // decreasing order avoids recursion depth limits on tall grids.
+  for (let row = rows - 1; row >= 0; row--) {
+    for (let col = 0; col < cols; col++) {
+      const cell = grid[row][col];
+      for (let dir = 0 as Dir; dir <= 2; dir = (dir + 1) as Dir) {
+        let total: bigint;
+        if (cell === '^') {
+          total =
+            exitPaths(memo, row + 1, col - 1, DOWN_LEFT, rows, cols) +
+            exitPaths(memo, row + 1, col + 1, DOWN_RIGHT, rows, cols);
+        } else {
+          total = exitPaths(memo, row + 1, col + COL_DELTA[dir], dir, rows, cols);
+        }
+        memo[(row * cols + col) * 3 + dir] = total;
+      }
+    }
+  }
+
+  let total = 0n;
+  for (const c of sourceColumns(grid, cols)) {
+    total += memo[(0 * cols + c) * 3 + DOWN] as bigint;
+  }
+  return total;
+}
+
+function exitPaths(
+  memo: Array<bigint | undefined>,
+  row: number,
+  col: number,
+  dir: Dir,
+  rows: number,
+  cols: number,
+): bigint {
+  // Out of bounds = one completed (absorbed) path.
+  if (row < 0 || row >= rows || col < 0 || col >= cols) return 1n;
+  return memo[(row * cols + col) * 3 + dir] as bigint;
+}
