+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from './index.js';
+
+function toGrid(rows: string[]): string[][] {
+  return rows.map((r) => r.split(/\s+/).filter((c) => c.length > 0));
+}
+
+const EXAMPLE_1 = toGrid([
+  '. S . . .',
+  '. . . . .',
+  '. ^ . . .',
+  '. . . . .',
+]);
+
+const EXAMPLE_2 = toGrid([
+  '. S . . .',
+  '. ^ . . .',
+  '^ . ^ . .',
+  '. . . . .',
+]);
+
+describe('countBeamCells', () => {
+  it('counts a lone source as 1', () => {
+    expect(countBeamCells([['S']])).toBe(1);
+  });
+
+  it('counts a straight vertical beam', () => {
+    const grid = toGrid(['S', '.', '.', '.']);
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('matches example 1 → 5', () => {
+    expect(countBeamCells(EXAMPLE_1)).toBe(5);
+  });
+
+  it('matches example 2 → 6 (overlapping cell counted once)', () => {
+    expect(countBeamCells(EXAMPLE_2)).toBe(6);
+  });
+
+  it('returns 0 for a grid with no source', () => {
+    expect(countBeamCells(toGrid(['. . .', '. ^ .', '. . .']))).toBe(0);
+  });
+
+  it('handles beams that exit the side boundary', () => {
+    // S at col 0, splitter immediately below -> down-left exits (col -1), down-right stays
+    const grid = toGrid(['S .', '^ .']);
+    // visited: (0,0)S, (1,0)splitter, down-right (2,1) is out of bounds (rows=2), down-left (2,-1) oob
+    expect(countBeamCells(grid)).toBe(2);
+  });
+
+  it('unions multiple sources on the top row', () => {
+    const grid = toGrid(['S . S', '. . .']);
+    // beams: (0,0),(1,0) and (0,2),(1,2) => 4 cells
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('splitter splits a diagonal incoming beam too', () => {
+    // S -> splitter -> down-right diagonal hits another splitter
+    const grid = toGrid([
+      '. S . . .',
+      '. ^ . . .',
+      '. . ^ . .',
+      '. . . . .',
+    ]);
+    // (0,1),(1,1)split -> (2,0)DL and (2,2)DR splitter
+    // (2,2) splits -> (3,1) and (3,3)
+    // (2,0): '.' DL -> (3,-1) oob
+    // cells: (0,1),(1,1),(2,0),(2,2),(3,1),(3,3) = 6
+    expect(countBeamCells(grid)).toBe(6);
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('returns 1n for a straight beam with no splitter', () => {
+    expect(countBeamPaths(toGrid(['S', '.', '.']))).toBe(1n);
+  });
+
+  it('matches example 1 → 2n', () => {
+    expect(countBeamPaths(EXAMPLE_1)).toBe(2n);
+  });
+
+  it('matches example 2 → 4n', () => {
+    expect(countBeamPaths(EXAMPLE_2)).toBe(4n);
+  });
+
+  it('returns 0n for no source', () => {
+    expect(countBeamPaths(toGrid(['. . .', '. ^ .']))).toBe(0n);
+  });
+
+  it('counts absorbed (side-exit) beams as completed paths', () => {
+    const grid = toGrid(['S .', '^ .']);
+    // splitter at (1,0): down-left to (2,-1) oob = exit, down-right to (2,1) oob = exit
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('returns a bigint type', () => {
+    expect(typeof countBeamPaths(EXAMPLE_1)).toBe('bigint');
+  });
+
+  it('sums paths across multiple sources', () => {
+    const grid = toGrid([
+      'S . . . S',
+      '. . . . .',
+      '. . . . .',
+    ]);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('produces 2^K for a chain of splitters down the middle', () => {
+    // Build a tall grid wide enough that diagonals never collide with the
+    // splitter column again; place a splitter directly in the beam's straight path.
+    // A single source feeding a vertical line of splitters: each split's
+    // children move diagonally away and never return, so only the central
+    // straight beam keeps hitting splitters... that gives K+1 exits, not 2^K.
+    // Instead test a known small fan: splitters arranged so K splitters are
+    // hit along one path.
+    const grid = toGrid([
+      '. . . S . . .',
+      '. . . ^ . . .',
+      '. . ^ . ^ . .',
+      '. ^ . ^ . ^ .',
+    ]);
+    // Row1 splitter -> 2 branches. Each branch row2 hits splitter -> 4.
+    // Each of those row3 hits splitter -> 8.
+    expect(countBeamPaths(grid)).toBe(8n);
+  });
+});
+
+describe('performance', () => {
+  it('handles a 200x200 grid with 50 splitters under 5s', () => {
+    const rows = 200;
+    const cols = 200;
+    const grid: string[][] = Array.from({ length: rows }, () =>
+      Array.from({ length: cols }, () => '.'),
+    );
+    grid[0][100] = 'S';
+    // Scatter 50 splitters
+    let placed = 0;
+    for (let r = 1; r < rows && placed < 50; r += 4) {
+      const c = (r * 7) % cols;
+      grid[r][c] = '^';
+      placed++;
+    }
+    const start = Date.now();
+    const cells = countBeamCells(grid);
+    const paths = countBeamPaths(grid);
+    const elapsed = Date.now() - start;
+    expect(cells).toBeGreaterThan(0);
+    expect(paths).toBeGreaterThan(0n);
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
