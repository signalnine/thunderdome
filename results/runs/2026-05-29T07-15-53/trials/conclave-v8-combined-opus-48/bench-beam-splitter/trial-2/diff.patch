+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index.js';
+
+const toGrid = (rows: string[]): string[][] => rows.map((r) => r.split(''));
+
+const EXAMPLE1 = toGrid(['.S...', '.....', '.^...', '.....']);
+
+// row0: . S . . .
+// row1: . ^ . . .
+// row2: ^ . ^ . .
+// row3: . . . . .
+const EXAMPLE2 = toGrid(['.S...', '.^...', '^.^..', '.....']);
+
+describe('countBeamCells', () => {
+  it('B1 example 1 → 5', () => {
+    expect(countBeamCells(EXAMPLE1)).toBe(5);
+  });
+
+  it('B3 example 2 → 6', () => {
+    expect(countBeamCells(EXAMPLE2)).toBe(6);
+  });
+
+  it('B5 straight shot down a single column', () => {
+    const grid = toGrid(['S', '.', '.', '.']);
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('B6 single-row grid', () => {
+    expect(countBeamCells(toGrid(['S....']))).toBe(1);
+  });
+
+  it('B8 multiple sources → union of cells', () => {
+    // two independent straight beams in separate columns
+    const grid = toGrid(['S.S', '...', '...']);
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('B8b overlapping beams count a shared cell once', () => {
+    // both sources funnel through splitters onto shared cells
+    const grid = toGrid(['.S...', '.^...', '^.^..', '.....']);
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('B9 no source → 0', () => {
+    expect(countBeamCells(toGrid(['.....', '..^..']))).toBe(0);
+  });
+
+  it('B16 empty grid → 0', () => {
+    expect(countBeamCells([])).toBe(0);
+    expect(countBeamCells([[]])).toBe(0);
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('B2 example 1 → 2n', () => {
+    expect(countBeamPaths(EXAMPLE1)).toBe(2n);
+  });
+
+  it('B4 example 2 → 4n', () => {
+    expect(countBeamPaths(EXAMPLE2)).toBe(4n);
+  });
+
+  it('B5 straight shot → 1n', () => {
+    expect(countBeamPaths(toGrid(['S', '.', '.', '.']))).toBe(1n);
+  });
+
+  it('B6 single-row grid → 1n', () => {
+    expect(countBeamPaths(toGrid(['S....']))).toBe(1n);
+  });
+
+  it('B7 splitter at left edge: both branches still exit', () => {
+    // S at (0,0); splitter directly below at (1,0).
+    // DL → (2,-1) absorbed (1 path), DR → (2,1) exits bottom (1 path)
+    const grid = toGrid(['S.', '^.', '..']);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('B8 multiple sources → sum of paths', () => {
+    const grid = toGrid(['S.S', '...', '...']);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('B9 no source → 0n', () => {
+    expect(countBeamPaths(toGrid(['.....', '..^..']))).toBe(0n);
+  });
+
+  it('B14 returns a bigint', () => {
+    expect(typeof countBeamPaths(EXAMPLE1)).toBe('bigint');
+  });
+
+  it('B16 empty grid → 0n', () => {
+    expect(countBeamPaths([])).toBe(0n);
+    expect(countBeamPaths([[]])).toBe(0n);
+  });
+
+  it('B17 chain of K aligned splitters → 2^K', () => {
+    // Build a grid where the beam re-hits a splitter on each row down the center.
+    // Center column c: place S on top, then splitters every row so the down-left and
+    // down-right branches keep landing on splitters in a triangle.
+    // Use a fully-splitter-filled triangle: every reachable cell below S is '^'.
+    const K = 20;
+    const cols = 2 * K + 3;
+    const center = K + 1;
+    const rows: string[][] = [];
+    // top row with S
+    const top = new Array(cols).fill('.');
+    top[center] = 'S';
+    rows.push(top);
+    // next K rows: fill everything with splitters so every beam splits each row
+    for (let r = 1; r <= K; r++) {
+      rows.push(new Array(cols).fill('^'));
+    }
+    // bottom empty row to let beams exit
+    rows.push(new Array(cols).fill('.'));
+    // Beam hits a splitter on rows 1..K → K splits along every path → 2^K paths.
+    expect(countBeamPaths(rows)).toBe(2n ** BigInt(K));
+  });
+});
+
+describe('B15 performance', () => {
+  it('200x200 grid with 50 splitters under 5s', () => {
+    const N = 200;
+    const grid: string[][] = Array.from({ length: N }, () => new Array(N).fill('.'));
+    grid[0][100] = 'S';
+    // scatter 50 splitters deterministically
+    let placed = 0;
+    for (let r = 1; r < N && placed < 50; r += 4) {
+      const c = (r * 7 + 13) % N;
+      grid[r][c] = '^';
+      placed++;
+    }
+    const start = Date.now();
+    const cells = countBeamCells(grid);
+    const paths = countBeamPaths(grid);
+    const elapsed = Date.now() - start;
+    expect(cells).toBeGreaterThan(0);
+    expect(typeof paths).toBe('bigint');
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
