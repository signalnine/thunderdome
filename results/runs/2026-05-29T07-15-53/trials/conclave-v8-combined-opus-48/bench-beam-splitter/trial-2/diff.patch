+/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ *
+ * A beam's behaviour is fully determined by its state `(row, col, dir)`:
+ *   - On a splitter `'^'` the beam is consumed and emits two diagonal beams
+ *     (down-left and down-right), regardless of its incoming direction.
+ *   - On any other cell the beam continues in its current direction.
+ *   - Moving outside the grid absorbs the beam (the path exits).
+ *
+ * Because every step increases `row` by exactly 1, the state graph is acyclic,
+ * so both queries terminate and can be memoised over `(row, col, dir)`. This
+ * keeps the work polynomial (≤ rows · cols · 3 states) even when the number of
+ * distinct source-to-exit paths is exponential.
+ */
+
+const enum Dir {
+  Down = 0,
+  DownLeft = 1,
+  DownRight = 2,
+}
+
+const DC: Record<Dir, number> = {
+  [Dir.Down]: 0,
+  [Dir.DownLeft]: -1,
+  [Dir.DownRight]: 1,
+};
+
+const SOURCE = 'S';
+const SPLITTER = '^';
+
+interface Dims {
+  rows: number;
+  cols: number;
+}
+
+function dims(grid: string[][]): Dims {
+  const rows = grid.length;
+  let cols = 0;
+  for (const row of grid) {
+    if (row.length > cols) cols = row.length;
+  }
+  return { rows, cols };
+}
+
+function inBounds(r: number, c: number, d: Dims): boolean {
+  return r >= 0 && r < d.rows && c >= 0 && c < d.cols;
+}
+
+function cellAt(grid: string[][], r: number, c: number): string {
+  const row = grid[r];
+  // Treat ragged-row gaps as empty cells.
+  return row !== undefined && c < row.length ? row[c] : '.';
+}
+
+/** Columns of all `'S'` cells on the top row (sources emit straight down). */
+function sourceColumns(grid: string[][]): number[] {
+  const cols: number[] = [];
+  const top = grid[0];
+  if (top === undefined) return cols;
+  for (let c = 0; c < top.length; c++) {
+    if (top[c] === SOURCE) cols.push(c);
+  }
+  return cols;
+}
+
+/**
+ * Count the distinct cells visited by any beam. Each cell counts once even if
+ * multiple beams pass through it.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const d = dims(grid);
+  if (d.rows === 0 || d.cols === 0) return 0;
+
+  const visitedCells = new Set<number>();
+  const seenState = new Set<number>(); // r*cols*3 + c*3 + dir
+  // Stack of beams entering a valid in-grid cell.
+  const stack: number[] = []; // encoded as r*cols*3 + c*3 + dir
+
+  for (const c of sourceColumns(grid)) {
+    stack.push((0 * d.cols + c) * 3 + Dir.Down);
+  }
+
+  while (stack.length > 0) {
+    const state = stack.pop() as number;
+    if (seenState.has(state)) continue;
+    seenState.add(state);
+
+    const dir = (state % 3) as Dir;
+    const rc = (state - dir) / 3;
+    const c = rc % d.cols;
+    const r = (rc - c) / d.cols;
+
+    visitedCells.add(r * d.cols + c);
+
+    if (cellAt(grid, r, c) === SPLITTER) {
+      // Emit both diagonal branches.
+      pushIfInside(stack, r + 1, c - 1, Dir.DownLeft, d);
+      pushIfInside(stack, r + 1, c + 1, Dir.DownRight, d);
+    } else {
+      // Continue in the current direction.
+      pushIfInside(stack, r + 1, c + DC[dir], dir, d);
+    }
+  }
+
+  return visitedCells.size;
+}
+
+function pushIfInside(stack: number[], r: number, c: number, dir: Dir, d: Dims): void {
+  if (inBounds(r, c, d)) {
+    stack.push((r * d.cols + c) * 3 + dir);
+  }
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths. Each split creates
+ * two separate paths; a path ends when its beam exits the grid. The count can
+ * be astronomically large, so it is returned as a `bigint`.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const d = dims(grid);
+  if (d.rows === 0 || d.cols === 0) return 0n;
+
+  // memo[r*cols*3 + c*3 + dir] = number of exiting paths from that beam state.
+  const memo = new Map<number, bigint>();
+
+  // Iterative post-order over the acyclic state graph to avoid recursion limits
+  // on tall grids. Each frame: a beam entering valid cell (r,c) with dir.
+  const paths = (startR: number, startC: number, startDir: Dir): bigint => {
+    const startKey = (startR * d.cols + startC) * 3 + startDir;
+    const stack: number[] = [startKey];
+
+    while (stack.length > 0) {
+      const key = stack[stack.length - 1];
+      if (memo.has(key)) {
+        stack.pop();
+        continue;
+      }
+
+      const dir = (key % 3) as Dir;
+      const rc = (key - dir) / 3;
+      const c = rc % d.cols;
+      const r = (rc - c) / d.cols;
+
+      // Determine the child beam states (in-grid moves) and the number of
+      // branches that exit immediately off-grid.
+      let exits = 0n;
+      const children: number[] = [];
+      const addBranch = (nr: number, nc: number, nd: Dir): void => {
+        if (!inBounds(nr, nc, d)) {
+          exits += 1n;
+        } else {
+          children.push((nr * d.cols + nc) * 3 + nd);
+        }
+      };
+
+      if (cellAt(grid, r, c) === SPLITTER) {
+        addBranch(r + 1, c - 1, Dir.DownLeft);
+        addBranch(r + 1, c + 1, Dir.DownRight);
+      } else {
+        addBranch(r + 1, c + DC[dir], dir);
+      }
+
+      let ready = true;
+      for (const child of children) {
+        if (!memo.has(child)) {
+          stack.push(child);
+          ready = false;
+        }
+      }
+      if (!ready) continue;
+
+      let total = exits;
+      for (const child of children) {
+        total += memo.get(child) as bigint;
+      }
+      memo.set(key, total);
+      stack.pop();
+    }
+
+    return memo.get(startKey) as bigint;
+  };
+
+  let total = 0n;
+  for (const c of sourceColumns(grid)) {
+    total += paths(0, c, Dir.Down);
+  }
+  return total;
+}
