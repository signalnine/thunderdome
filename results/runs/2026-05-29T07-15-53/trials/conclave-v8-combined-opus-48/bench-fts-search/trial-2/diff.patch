+{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01U7Gru5XRN4CBwLK4vVoB4f","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RRgfg1pzS8ZZCNwUk8iFPJ","name":"Write","input":{"file_path":"/workspace/src/search.ts","content":"import Database from 'better-sqlite3';\nimport { SearchResult, SuggestResult } from './models.js';\n\nexport const PER_PAGE = 20;\nconst SUGGEST_LIMIT = 5;\n\n/**\n * Build a safe FTS5 MATCH expression from raw user input.\n *\n * FTS5's MATCH grammar treats many characters (quotes, parentheses, `*`, `+`,\n * `-`, `:`, `/`, etc.) as syntax. Passing raw user text straight to MATCH can\n * therefore throw a syntax error. To stay robust we:\n *   - preserve explicit `\"...\"` quoted phrases as FTS phrase queries,\n *   - split everything else into alphanumeric tokens and quote each one,\n *   - join terms with spaces (implicit AND).\n *\n * `prefix` appends `*` to bareword tokens so the final token matches as a\n * prefix (used by the autocomplete/suggest endpoint).\n *\n * Returns an empty string when the input contains no searchable tokens, in\n * which case callers should short-circuit to an empty result set rather than\n * running a MATCH against an empty expression (which FTS5 rejects).\n */\nexport function buildMatchExpression(raw: string, prefix = false): string {\n  const terms: string[] = [];\n  let remaining = raw;\n\n  // Extract quoted phrases first.\n  remaining = remaining.replace(/\"([^\"]*)\"/g, (_full, phrase: string) => {\n    const tokens = phrase.match(/[\\p{L}\\p{N}]+/gu);\n    if (tokens && tokens.length > 0) {\n      terms.push(`\"${tokens.join(' ')}\"`);\n    }\n    return ' ';\n  });\n\n  // Remaining bareword tokens.\n  const tokens = remaining.match(/[\\p{L}\\p{N}]+/gu) ?? [];\n  tokens.forEach((token, idx) => {\n    const isLast = idx === tokens.length - 1;\n    if (prefix && isLast) {\n      terms.push(`\"${token}\"*`);\n    } else {\n      terms.push(`\"${token}\"`);\n    }\n  });\n\n  return terms.join(' ');\n}\n\nexport interface SearchResponse {\n  results: SearchResult[];\n  total: number;\n  page: number;\n  perPage: number;\n}\n\nexport function searchNotes(db: Database.Database, rawQuery: string, page: number): SearchResponse {\n  const safePage = Number.isInteger(page) && page > 0 ? page : 1;\n  const match = buildMatchExpression(rawQuery);\n\n  if (match === '') {\n    return { results: [], total: 0, page: safePage, perPage: PER_PAGE };\n  }\n\n  const total = (\n    db.prepare('SELECT COUNT(*) AS count FROM notes_fts WHERE notes_fts MATCH ?').get(match) as {\n      count: number;\n    }\n  ).count;\n\n  const rows = db\n    .prepare(\n      `SELECT\n         notes_fts.rowid AS id,\n         n.title AS title,\n         snippet(notes_fts, -1, '<mark>', '</mark>', '…', 20) AS snippet,\n         bm25(notes_fts) AS rank\n       FROM notes_fts\n       JOIN notes n ON n.id = notes_fts.rowid\n       WHERE notes_fts MATCH @match\n       ORDER BY rank\n       LIMIT @limit OFFSET @offset`\n    )\n    .all({ match, limit: PER_PAGE, offset: (safePage - 1) * PER_PAGE }) as SearchResult[];\n\n  return { results: rows, total, page: safePage, perPage: PER_PAGE };\n}\n\nexport function suggestNotes(db: Database.Database, rawQuery: string): SuggestResult[] {\n  const match = buildMatchExpression(rawQuery, true);\n\n  if (match === '') {\n    return [];\n  }\n\n  return db\n    .prepare(\n      `SELECT notes_fts.rowid AS id, n.title AS title\n       FROM notes_fts\n       JOIN notes n ON n.id = notes_fts.rowid\n       WHERE notes_fts MATCH @match\n       ORDER BY rank\n       LIMIT @limit`\n    )\n    .all({ match, limit: SUGGEST_LIMIT }) as SuggestResult[];\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1108,"cache_read_input_tokens":49927,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1108},"output_tokens":3,