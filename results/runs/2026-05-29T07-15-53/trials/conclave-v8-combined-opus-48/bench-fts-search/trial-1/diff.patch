+/**
+ * Helpers for translating user-supplied search input into safe FTS5 MATCH
+ * expressions. User input may contain characters that are significant to the
+ * FTS5 query grammar (e.g. `"`, `*`, `:`, `(`, `^`, `-`), so we never pass it
+ * through verbatim. Instead we extract alphanumeric tokens (and quoted
+ * phrases) and rebuild a query out of double-quoted string literals, which
+ * FTS5 treats as plain text.
+ */
+
+/** Double-quote an FTS5 string token, escaping embedded quotes by doubling. */
+function quote(token: string): string {
+  return '"' + token.replace(/"/g, '""') + '"';
+}
+
+/**
+ * Build an FTS5 MATCH expression for the full search endpoint.
+ *
+ * - A double-quoted segment in the input becomes a single phrase query.
+ * - Unquoted runs become individual term queries (implicitly AND-ed).
+ * - All other characters are discarded so malicious/garbage input cannot
+ *   produce a syntax error or unintended query operators.
+ *
+ * Returns an empty string when the input contains no usable tokens; callers
+ * should treat that as "no results" rather than running the query.
+ */
+export function buildMatchQuery(raw: string): string {
+  const parts: string[] = [];
+  const segment = /"([^"]*)"|(\S+)/g;
+  let match: RegExpExecArray | null;
+
+  while ((match = segment.exec(raw)) !== null) {
+    const isPhrase = match[1] !== undefined;
+    const text = isPhrase ? match[1] : match[2];
+    const words = text.match(/[A-Za-z0-9]+/g);
+    if (!words || words.length === 0) {
+      continue;
+    }
+    if (isPhrase) {
+      // Preserve word order as a single phrase query.
+      parts.push(quote(words.join(' ')));
+    } else {
+      // A single unquoted run may itself contain punctuation that split it
+      // into multiple words (e.g. "foo+bar"); treat each as its own term.
+      for (const word of words) {
+        parts.push(quote(word));
+      }
+    }
+  }
+
+  return parts.join(' ');
+}
+
+/**
+ * Build an FTS5 MATCH expression for the autocomplete/suggest endpoint.
+ *
+ * The final token becomes a prefix query (`token*`) so partial words match,
+ * while any preceding tokens are required in full.
+ */
+export function buildPrefixQuery(raw: string): string {
+  const words = raw.match(/[A-Za-z0-9]+/g);
+  if (!words || words.length === 0) {
+    return '';
+  }
+  return words
+    .map((word, i) => (i === words.length - 1 ? quote(word) + '*' : quote(word)))
+    .join(' ');
+}
