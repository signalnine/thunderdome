+  // GET /notes/search - Full-text search across titles and bodies.
+  // NOTE: must be registered before '/notes/:id' so "search" is not treated
+  // as a note id.
+  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {
+    try {
+      const q = req.query.q;
+      if (typeof q !== 'string' || q.trim() === '') {
+        throw new ValidationError('Query parameter "q" is required');
+      }
+
+      const page = Math.max(1, parseInt(req.query.page as string) || 1);
+      const offset = (page - 1) * PER_PAGE;
+
+      const matchQuery = buildMatchQuery(q);
+
+      // No usable tokens (e.g. punctuation-only query): no matches.
+      if (matchQuery === '') {
+        res.json({ results: [], total: 0, page, perPage: PER_PAGE });
+        return;
+      }
+
+      const total = (
+        db
+          .prepare('SELECT COUNT(*) AS count FROM notes_fts WHERE notes_fts MATCH ?')
+          .get(matchQuery) as { count: number }
+      ).count;
+
+      const rows = db
+        .prepare(
+          `SELECT
+             notes.id AS id,
+             notes.title AS title,
+             snippet(notes_fts, -1, '<mark>', '</mark>', '...', 32) AS snippet,
+             bm25(notes_fts) AS rank
+           FROM notes_fts
+           JOIN notes ON notes.id = notes_fts.rowid
+           WHERE notes_fts MATCH ?
+           ORDER BY bm25(notes_fts)
+           LIMIT ? OFFSET ?`
+        )
+        .all(matchQuery, PER_PAGE, offset) as SearchResult[];
+
+      res.json({ results: rows, total, page, perPage: PER_PAGE });
+    } catch (err) {
+      next(err);
+    }
+  });
+
