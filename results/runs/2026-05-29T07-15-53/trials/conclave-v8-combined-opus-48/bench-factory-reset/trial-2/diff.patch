+import { describe, it, expect } from 'vitest';
+import { solveToggle, type Machine } from '../src/index.js';
+
+// ---- Reference brute-force solver (only for small M) ----
+function bruteToggle(machine: Machine): number[] | null {
+  const N = machine.target.length;
+  const M = machine.buttons.length;
+  let best: number[] | null = null;
+  for (let mask = 0; mask < 1 << M; mask++) {
+    const lights = new Array<boolean>(N).fill(false);
+    const chosen: number[] = [];
+    for (let i = 0; i < M; i++) {
+      if ((mask >> i) & 1) {
+        chosen.push(i);
+        for (const l of machine.buttons[i]) lights[l] = !lights[l];
+      }
+    }
+    let ok = true;
+    for (let l = 0; l < N; l++) if (lights[l] !== machine.target[l]) { ok = false; break; }
+    if (!ok) continue;
+    if (best === null || better(chosen, best)) best = chosen;
+  }
+  return best;
+}
+
+// returns true if a is preferred over b: fewer elements, then lex-smaller
+function better(a: number[], b: number[]): boolean {
+  if (a.length !== b.length) return a.length < b.length;
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] !== b[i]) return a[i] < b[i];
+  }
+  return false;
+}
+
+function applyToggle(buttons: number[][], picks: number[], N: number): boolean[] {
+  const lights = new Array<boolean>(N).fill(false);
+  for (const i of picks) for (const l of buttons[i]) lights[l] = !lights[l];
+  return lights;
+}
+
+function isSorted(a: number[]): boolean {
+  for (let i = 1; i < a.length; i++) if (a[i] <= a[i - 1]) return false;
+  return true;
+}
+
+// Seedable PRNG for reproducible random tests
+function makeRng(seed: number) {
+  let s = seed >>> 0;
+  return () => {
+    s = (s * 1664525 + 1013904223) >>> 0;
+    return s / 0x100000000;
+  };
+}
