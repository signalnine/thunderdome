3333) + ((x >>> 2) & 0x33333333);\n  x = (x + (x >>> 4)) & 0x0f0f0f0f;\n  return (Math.imul(x, 0x01010101) >>> 24) & 0xff;\n}\n\n// count trailing zeros of a positive 32-bit integer\nfunction ctz32(x: number): number {\n  return 31 - Math.clz32(x & -x);\n}\n\nconst POW2_32 = 4294967296; // 2^32\n\n// ---------------------------------------------------------------------------\n// Part 1: solveToggle — GF(2), each button pressed 0/1 times, minimise count.\n// ---------------------------------------------------------------------------\n\ninterface Vec2 {\n  lo: number; // bits 0..31\n  hi: number; // bits 32..39\n}\n\nfunction buttonVec(indices: number[], n: number): Vec2 {\n  let lo = 0;\n  let hi = 0;\n  for (const idx of indices) {\n    if (idx < 0 || idx >= n) continue; // ignore out-of-range light indices\n    if (idx < 32) lo ^= 1 << idx;\n    else hi ^= 1 << (idx - 32);\n  }\n  return { lo: lo >>> 0, hi: hi >>> 0 };\n}\n\n// lex comparison of two index SETS encoded as bit masks: returns true if set\n// `a` is lexicographically smaller than set `b` (smaller element at the first\n// position where the sorted-ascending sequences differ). The deciding index is\n// the smallest bit on which the masks disagree; whoever owns it is smaller.\nfunction lexSmallerMask(aLo: number, aHi: number, bLo: number, bHi: number): boolean {\n  const xLo = (aLo ^ bLo) >>> 0;\n  if (xLo !== 0) {\n    const lsb = xLo & -xLo;\n    return (aLo & lsb) !== 0;\n  }\n  const xHi = (aHi ^ bHi) >>> 0;\n  if (xHi === 0) return false; // equal\n  const lsb = xHi & -xHi;\n  return (aHi & lsb) !== 0;\n}\n\ninterface LeftEntry {\n  size: number;\n  maskLo: number; // pressed-button mask over left half (bits 0..h1-1)\n  maskHi: number;\n}\n\n/**\n * Enumerate all subsets of `count` buttons starting at `offset` via Gray code,\n * invoking cb with the XOR vector (lo/hi), the pressed mask (lo/hi over the\n * full button index space) and the subset size.\n */\nfunction enumerateSubsets(\n  vecs: Vec2[],\n  offset: number,\n  count: number,\n  cb: (vlo: number, vhi: number, mlo: number, mhi: number, size: number) => void,\n): void {\n  let vlo = 0;\n  let vhi = 0;\n  let mlo = 0;\n  let mhi = 0;\n  let size = 0;\n  cb(vlo, vhi, mlo, mhi, size); // empty subset\n  if (count === 0) return;\n  const total = 1 << count;\n  for (let g = 1; g < total; g++) {\n    const bit = ctz32(g); // local index within this half\n    const v = vecs[offset + bit];\n    vlo = (vlo ^ v.lo) >>> 0;\n    vhi = (vhi ^ v.hi) >>> 0;\n    const globalBit = offset + bit;\n    let bitMaskLo = 0;\n    let bitMaskHi = 0;\n    if (globalBit < 32) bitMaskLo = 1 << globalBit;\n    else bitMaskHi = 1 << (globalBit - 32);\n    const wasSet = globalBit < 32 ? (mlo & bitMaskLo) !== 0 : (mhi & bitMaskHi) !== 0;\n    mlo = (mlo ^ bitMaskLo) >>> 0;\n    mhi = (mhi ^ bitMaskHi) >>> 0;\n    size += wasSet ? -1 : 1;\n    cb(vlo, vhi, mlo, mhi, size);\n  }\n}\n\nexport function solveToggle(machine: Machine): number[] | null {\n  const n = machine.target.length;\n  const m = machine.buttons.length;\n  const vecs = machine.buttons.map((b) => buttonVec(b, n));\n\n  // target vector\n  let bLo = 0;\n  let bHi = 0;\n  for (let i = 0; i < n; i++) {\n    if (machine.target[i]) {\n      if (i < 32) bLo ^= 1 << i;\n      else bHi ^= 1 << (i - 32);\n    }\n  }\n  bLo >>>= 0;\n  bHi >>>= 0;\n\n  // Split buttons into two halves; store the smaller (left) half in a map.\n  const h1 = Math.floor(m / 2); // left half size, <= 20\n  const h2 = m - h1; // right half size\n\n  const map = new Map<number, LeftEntry>();\n  enumerateSubsets(vecs, 0, h1, (vlo, vhi, mlo, mhi, size) => {\n    const key = vhi * POW2_32 + vlo;\n    const e = map.get(key);\n    if (\n      e === undefined ||\n      size < e.size ||\n      (size === e.size && lexSmallerMask(mlo, mhi, e.maskLo, e.maskHi))\n    ) {\n      map.set(key, { size, maskLo: mlo, maskHi: mhi });\n    }\n  });\n\n  let bestSize = Infinity;\n  let bestLo = 0;\n  let bestHi = 0;\n  let found = false;\n\n  enumerateSubsets(vecs, h1, h2, (vlo, vhi, rmlo, rmhi, rsize) => {\n    const needLo = (bLo ^ vlo) >>> 0;\n    const needHi = (bHi ^ vhi) >>> 0;\n    const key = needHi * POW2_32 + needLo;\n    const e = map.get(key);\n    if (e === undefined) return;\n    const total = e.size + rsize;\n    if (total > bestSize) return;\n    // combined pressed mask = left mask (bits 0..h1-1) | right mask\n    const cLo = (e.maskLo | rmlo) >>> 0;\n    const cHi = (e.maskHi | rmhi) >>> 0;\n    if (\n      !found ||\n      total < bestSize ||\n      (total === bestSize && lexSmallerMask(cLo, cHi, bestLo, bestHi))\n    ) {\n      found = true;\n      bestSize = total;\n      bestLo = cLo;\n      bestHi = cHi;\n    }\n  });\n\n  if (!found) return null;\n\n  const result: number[] = [];\n  for (let i = 0; i < m; i++) {\n    if (i < 32) {\n      if ((bestLo >>> i) & 1) result.push(i);\n    } else if ((bestHi >>> (i - 32)) & 1) result.push(i);\n  }\n  return result;\n}\n\n// ---------------------------------------------------------------------------\n// Part 2: solveCounter — GF(p), button pressed 0..p-1 times, minimise sum.\n// ---------------------------------------------------------------------------\n\nfunction modPow(base: number, exp: number, mod: number): number {\n  let result = 1;\n  let b = base % mod;\n  let e = exp;\n  while (e > 0) {\n    if (e & 1) result = (result * b) % mod;\n    b = (b * b) % mod;\n    e = Math.floor(e / 2);\n  }\n  return result;\n}\n\n// modular inverse for prime modulus via Fermat's little theorem\nfunction modInv(a: number, p: number): number {\n  return modPow(((a % p) + p) % p, p - 2, p);\n}\n\ninterface Reduced {\n  rank: number;\n  freeCols: number[]; // columns without a pivot\n  // For each pivot row r (0..rank-1): pivotCol[r], rhs[r], and the coefficient\n  // on each free column (coefByFree[r][f] corresponds to freeCols[f]).\n  pivotCol: number[];\n  rhs: number[];\n  coefByFree: number[][];\n  consistent: boolean;\n  m: number;\n}\n\nfunction gaussianGFp(lights: number[], buttons: number[][], p: number): Reduced {\n  const n = lights.length;\n  const m = buttons.length;\n  // augmented matrix: n rows, m+1 columns (last is rhs)\n  const a: number[][] = [];\n  for (let c = 0; c < n; c++) {\n    a.push(new Array<number>(m + 1).fill(0));\n    a[c][m] = (((lights[c] % p) + p) % p) | 0;\n  }\n  for (let i = 0; i < m; i++) {\n    for (const c of buttons[i]) {\n      if (c >= 0 && c < n) a[c][i] = (a[c][i] + 1) % p;\n    }\n  }\n\n  const where = new Array<number>(m).fill(-1); // pivot row for each column\n  let row = 0;\n  for (let col = 0; col < m && row < n; col++) {\n    let sel = -1;\n    for (let i = row; i < n; i++) {\n      if (a[i][col] % p !== 0) {\n        sel = i;\n        break;\n      }\n    }\n    if (sel === -1) continue;\n    const tmp = a[sel];\n    a[sel] = a[row];\n    a[row] = tmp;\n    const inv = modInv(a[row][col], p);\n    for (let j = col; j <= m; j++) a[row][j] = (a[row][j] * inv) % p;\n    for (let i = 0; i < n; i++) {\n      if (i !== row && a[i][col] % p !== 0) {\n        const f = a[i][col];\n        for (let j = col; j <= m; j++) {\n          a[i][j] = ((a[i][j] - f * a[row][j]) % p + p) % p;\n        }\n      }\n    }\n    where[col] = row;\n    row++;\n  }\n  const rank = row;\n\n  let consistent = true;\n  for (let i = rank; i < n; i++) {\n    if (a[i][m] % p !== 0) {\n      consistent = false;\n      break;\n    }\n  }\n\n  const freeCols: number[] = [];\n  for (let col = 0; col < m; col++) if (where[col] === -1) freeCols.push(col);\n\n  const pivotCol: number[] = [];\n  const rhs: number[] = [];\n  const coefByFree: number[][] = [];\n  // pivot row index increases with column in RREF, so collect by column order\n  for (let col = 0; col < m; col++) {\n    const r = where[col];\n    if (r === -1) continue;\n    pivotCol.push(col);\n    rhs.push(a[r][m]);\n    const coefs: number[] = [];\n    for (const fc of freeCols) coefs.push(a[r][fc]);\n    coefByFree.push(coefs);\n  }\n\n  return { rank, freeCols, pivotCol, rhs, coefByFree, consistent, m };\n}\n\n// Enumerate all assignments of free variables in [0,p)^k, compute the full\n// solution, and keep the (min sum, then lexicographically smallest) one.\nfunction solveByEnumeration(red: Reduced, p: number): number[] {\n  const { freeCols, pivotCol, rhs, coefByFree, m } = red;\n  const k = freeCols.length;\n  const numPivots = pivotCol.length;\n\n  const freeVals = new Array<number>(k).fill(0);\n  const x = new Array<number>(m).fill(0);\n  let best: number[] | null = null;\n  let bestSum = Infinity;\n\n  // odometer over p^k assignments\n  for (;;) {\n    // compute solution for current freeVals\n    for (let f = 0; f < k; f++) x[freeCols[f]] = freeVals[f];\n    let s = 0;\n    for (let f = 0; f < k; f++) s += freeVals[f];\n    for (let pi = 0; pi < numPivots; pi++) {\n      let val = rhs[pi];\n      const coefs = coefByFree[pi];\n      for (let f = 0; f < k; f++) {\n        if (freeVals[f] !== 0 && coefs[f] !== 0) {\n          val -= coefs[f] * freeVals[f];\n        }\n      }\n      val = ((val % p) + p) % p;\n      x[pivotCol[pi]] = val;\n      s += val;\n    }\n    if (s < bestSum || (s === bestSum && best !== null && arrayLexSmaller(x, best))) {\n      if (s < bestSum || best === null || arrayLexSmaller(x, best)) {\n        bestSum = s;\n        best = x.slice();\n      }\n    } else if (best === null) {\n      bestSum = s;\n      best = x.slice();\n    }\n\n    // increment odometer\n    let idx = 0;\n    while (idx < k) {\n      freeVals[idx]++;\n      if (freeVals[idx] < p) break;\n      freeVals[idx] = 0;\n      idx++;\n    }\n    if (idx === k) break; // wrapped around fully\n  }\n\n  return best!;\n}\n\nfunction arrayLexSmaller(a: number[], b: number[]): boolean {\n  for (let i = 0; i < a.length; i++) {\n    if (a[i] !== b[i]) return a[i] < b[i];\n  }\n  return false;\n}\n\n/**\n * Syndrome DP for the small-rank case. We have an equivalent system C x = d\n * (mod p) where C is the rank x m matrix of RREF pivot-row coefficients. State\n * space is GF(p)^rank (p^rank states). Backward DP gives min presses to\n * complete from each (button, syndrome); greedy forward reconstruction picks\n * the smallest press count at each button (lexicographically smallest).\n */\nfunction solveByDP(red: Reduced, buttons: number[][], p: number): number[] {\n  const { rank, freeCols, pivotCol, rhs, coefByFree, m } = red;\n  const r = rank;\n\n  // Build C (r x m) and d (length r) from RREF.\n  // Row i: 1 at pivotCol[i], coefByFree[i][f] at freeCols[f], rhs[i] target.\n  const cols: number[][] = []; // cols[i] = coefficient column for button i, length r\n  for (let i = 0; i < m; i++) cols.push(new Array<number>(r).fill(0));\n  for (let i = 0; i < r; i++) {\n    cols[pivotCol[i]][i] = 1;\n    for (let f = 0; f < freeCols.length; f++) {\n      cols[freeCols[f]][i] = coefByFree[i][f] % p;\n    }\n  }\n  const d = rhs.slice();\n\n  // base-p encoding of an r-dim vector\n  const pPow: number[] = [1];\n  for (let i = 1; i <= r; i++) pPow.push(pPow[i - 1] * p);\n  const numStates = pPow[r];\n\n  const encode = (vec: number[]): number => {\n    let e = 0;\n    for (let i = 0; i < r; i++) e += vec[i] * pPow[i];\n    return e;\n  };\n\n  // Precompute, for each button, the state delta produced by one press\n  // (as the encoded value of its column). Adding c presses moves syndrome by\n  // c*col. We work in \"needed remaining\" space during reconstruction.\n  const colState: number[] = cols.map((c) => encode(c));\n\n  // Backward DP: minCost[i][s] = min presses using buttons i..m-1 to add up to\n  // syndrome s. We store m+1 layers.\n  const INF = Infinity;\n  const layers: Float64Array[] = [];\n  for (let i = 0; i <= m; i++) {\n    const layer = new Float64Array(numStates);\n    layer.fill(INF);\n    layers.push(layer);\n  }\n  layers[m][0] = 0; // no buttons left, only the zero syndrome is reachable at cost 0\n\n  // Precompute decode of states into digit arrays lazily via arithmetic.\n  // For transition we need s + c*col (mod p componentwise) encoded. We can step\n  // by repeatedly adding the column's encoded delta with per-digit mod, but\n  // base-p carries make direct addition wrong. Instead precompute, for each\n  // button, the encoded result of adding c*col to a given state by stepping c\n  // from 0 and adding the column once per step using a digitwise adder.\n  const colDigits: number[][] = cols; // already digit arrays length r\n\n  // digitwise add of a column (length r) to encoded state -> encoded state\n  const addCol = (state: number, col: number[]): number => {\n    let res = 0;\n    let rem = state;\n    for (let i = 0; i < r; i++) {\n      const digit = rem % p;\n      rem = Math.floor(rem / p);\n      let nd = digit + col[i];\n      if (nd >= p) nd -= p;\n      res += nd * pPow[i];\n    }\n    return res;\n  };\n\n  for (let i = m - 1; i >= 0; i--) {\n    const cur = layers[i];\n    const next = layers[i + 1];\n    const col = colDigits[i];\n    for (let s = 0; s < numStates; s++) {\n      // c = 0\n      let best = next[s];\n      // c = 1..p-1: target syndrome s achieved by adding c*col to (s - c*col).\n      // Equivalent: minCost[i][s] = min_c c + next[s - c*col].\n      // Step backwards: t_c = s - c*col; we generate by subtracting col.\n      let t = s;\n      for (let c = 1; c < p; c++) {\n        t = subCol(t, col, p, pPow, r);\n        const cand = c + next[t];\n        if (cand < best) best = cand;\n      }\n      cur[s] = best;\n    }\n  }\n\n  // Greedy forward reconstruction.\n  const result = new Array<number>(m).fill(0);\n  let remaining = encode(d); // we must add exactly d in total\n  for (let i = 0; i < m; i++) {\n    const col = colDigits[i];\n    const target = layers[i][remaining];\n    // find smallest c with c + layers[i+1][remaining - c*col] == target\n    let chosen = 0;\n    let t = remaining;\n    for (let c = 0; c < p; c++) {\n      if (c > 0) t = subCol(t, col, p