n  if (enumCost <= ENUM_BUDGET && enumCost <= dpCost) {\n    return solveByEnumeration(red, p);\n  }\n  if (dpCost <= DP_BUDGET) {\n    return solveByDP(red, buttons, p);\n  }\n  if (enumCost <= ENUM_BUDGET) {\n    return solveByEnumeration(red, p);\n  }\n  // Both heavy: pick the cheaper exact method and run it anyway.\n  if (enumCost <= dpCost) return solveByEnumeration(red, p);\n  return solveByDP(red, buttons, p);\n}\n","structuredPatch":[{"oldStart":436,"oldLines":10,"newStart":436,"newLines":6,"lines":["     result[i] = chosen;","   }"," ","-  // mark addCol as used (kept for clarity / potential reuse)","-  void addCol;","-  void colState;","-","   return result;"," }"," "]}],"userModified":false,"replaceAll":false}}
