+++ b/tests/counter.test.ts
@@ -0,0 +1,267 @@
+import { describe, it, expect } from 'vitest';
+import { solveCounter } from '../src/index.js';
+
+// ---- Reference brute-force (small M, small p) ----
+function bruteCounter(lights: number[], buttons: number[][], p: number): number[] | null {
+  const N = lights.length;
+  const M = buttons.length;
+  const x = new Array<number>(M).fill(0);
+  let best: number[] | null = null;
+  const total = Math.pow(p, M);
+  for (let code = 0; code < total; code++) {
+    let c = code;
+    for (let i = 0; i < M; i++) { x[i] = c % p; c = Math.floor(c / p); }
+    const counters = new Array<number>(N).fill(0);
+    for (let i = 0; i < M; i++) {
+      if (x[i] === 0) continue;
+      for (const ctr of buttons[i]) counters[ctr] = (counters[ctr] + x[i]) % p;
+    }
+    let ok = true;
+    for (let ctr = 0; ctr < N; ctr++) if (counters[ctr] !== ((lights[ctr] % p) + p) % p) { ok = false; break; }
+    if (!ok) continue;
+    if (best === null || betterCounter(x, best)) best = x.slice();
+  }
+  return best;
+}
+
+function sum(a: number[]): number { return a.reduce((s, v) => s + v, 0); }
+
+// a preferred over b: smaller total sum, then lexicographically smaller array
+function betterCounter(a: number[], b: number[]): boolean {
+  const sa = sum(a), sb = sum(b);
+  if (sa !== sb) return sa < sb;
+  for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return a[i] < b[i];
+  return false;
+}
+
+function applyCounter(buttons: number[][], x: number[], N: number, p: number): number[] {
+  const counters = new Array<number>(N).fill(0);
+  for (let i = 0; i < x.length; i++) {
+    for (const ctr of buttons[i]) counters[ctr] = (counters[ctr] + x[i]) % p;
+  }
+  return counters;
+}
+
+function makeRng(seed: number) {
+  let s = seed >>> 0;
+  return () => {
+    s = (s * 1664525 + 1013904223) >>> 0;
+    return s / 0x100000000;
+  };
+}
+
+describe('solveCounter - basic', () => {
+  it('all-zero target returns all zeros', () => {
+    const r = solveCounter([0, 0, 0], [[0], [1], [2]], 5)!;
+    expect(r).toEqual([0, 0, 0]);
+  });
+
+  it('single counter, single button mod 5', () => {
+    // counter 0 target 3, button 0 increments counter 0 -> press 3 times
+    expect(solveCounter([3], [[0]], 5)).toEqual([3]);
+  });
+
+  it('result entries are within [0, modulus)', () => {
+    const r = solveCounter([4, 1], [[0], [1], [0, 1]], 5)!;
+    for (const v of r) { expect(v).toBeGreaterThanOrEqual(0); expect(v).toBeLessThan(5); }
+  });
+
+  it('unsatisfiable returns null', () => {
+    // counter 1 can never be changed (no button touches it) but target nonzero
+    expect(solveCounter([0, 2], [[0]], 5)).toBeNull();
+  });
+
+  it('minimum total presses preferred', () => {
+    // target counter0 = 1 (mod 5). Both buttons hit counter 0. Min sum = 1.
+    // Lex-min RESULT ARRAY prefers 0 at the front => [0, 1].
+    const r = solveCounter([1], [[0], [0]], 5)!;
