+/**
+ * Factory Reset — button-toggle puzzle solvers.
+ *
+ * Part 1 (solveToggle): lights toggle over GF(2). Find the minimum-weight subset
+ *   of buttons whose combined toggles produce the target. Solved with a
+ *   meet-in-the-middle search over button subsets (2^(M/2)), so it scales to
+ *   M = 40 buttons well under the 5s budget where brute force (2^40) cannot.
+ *
+ * Part 2 (solveCounter): counters increment over GF(p) for prime p. Find the
+ *   button-press vector (each in 0..p-1) minimizing total presses. Solved with
+ *   Gaussian elimination over GF(p) to characterise the solution space, then an
+ *   exact enumeration over free variables (incremental, mixed-radix). For p = 2
+ *   with a large solution space we reuse the GF(2) meet-in-the-middle solver.
+ */
+
+export interface Machine {
+  target: boolean[]; // desired state for each light (all start off)
+  buttons: number[][]; // buttons[i] = array of light indices toggled by button i
+}
+
+/* ============================ shared bit helpers ============================ */
+
+function popcount32(n: number): number {
+  n = n >>> 0;
+  n = n - ((n >>> 1) & 0x55555555);
+  n = (n & 0x33333333) + ((n >>> 2) & 0x33333333);
+  return (((n + (n >>> 4)) & 0x0f0f0f0f) * 0x01010101) >>> 24;
+}
+
+// Index of the lowest set bit of g (g > 0).
+function lowbitIndex(g: number): number {
+  return 31 - Math.clz32(g & -g);
+}
+
+// Compare two masks interpreted as ascending index SETS, lexicographically.
+// e.g. {0,3} (mask 0b1001) < {1,2} (mask 0b0110) because 0 < 1.
+function cmpSetLex(a: number, b: number): number {
+  a = a >>> 0;
+  b = b >>> 0;
+  while (a !== 0 || b !== 0) {
+    if (a === 0) return -1; // a is a proper prefix -> smaller
+    if (b === 0) return 1;
+    const la = a & -a;
+    const lb = b & -b;
+    if (la !== lb) return la < lb ? -1 : 1; // lower bit position -> smaller index
+    a ^= la;
+    b ^= lb;
+  }
+  return 0;
+}
+
+// Compare two masks interpreted as 0/1 membership ARRAYS (index 0 == lowest bit),
+// lexicographically. The solution that omits the lowest differing index is smaller.
+function cmpArrayMask(a: number, b: number): number {
+  const d = (a ^ b) >>> 0;
+  if (d === 0) return 0;
+  const low = d & -d;
+  return a & low ? 1 : -1;
+}
+
+// Compare two FULL solutions, each split as (left mask over buttons 0..mid-1,
+// right mask over buttons mid..M-1), interpreted as ascending index SETS.
+// All left indices are < mid <= all right indices, so the merged ascending set is
+// the left indices followed by the right indices. Comparing the halves
+// independently is INVALID (an empty left half must not auto-win against a left
+// half that contains an index smaller than the other solution's right indices),
+// so we compare the genuinely merged sequences.
+function cmpCombinedSet(lA: number, rA: number, lB: number, rB: number, mid: number): number {
+  // First compare the left portions as sets; if they tie, the right portions
+  // decide. But unlike a naive split, a *proper-prefix* left set is only smaller
+  // when the OTHER solution still has an element at that position in its left set.
+  // cmpSetLex already returns -1/1 only on a genuine element difference and 0
+  // when one is a prefix of the other... so handle the prefix case explicitly.
+  let a = lA >>> 0;
+  let b = lB >>> 0;
+  while (a !== 0 && b !== 0) {
+    const la = a & -a;
+    const lb = b & -b;
+    if (la !== lb) return la < lb ? -1 : 1;
+    a ^= la;
+    b ^= lb;
+  }
+  // One (or both) left sets exhausted. Remaining elements: leftover left bits
+  // (small indices) then the right bits (offset by mid). Compare the remaining
+  // merged sequences of A vs B.
+  return cmpRemainder(a, rA, b, rB, mid);
+}
+
+// Compare the remaining ascending index sequences for two solutions, where each
+// is (leftover left mask) followed by (right mask offset by mid).
+function cmpRemainder(aL: number, aR: number, bL: number, bR: number, mid: number): number {
+  let nextA = nextIndex(aL, aR, mid);
+  let nextB = nextIndex(bL, bR, mid);
+  for (;;) {
+    if (nextA.idx === -1 && nextB.idx === -1) return 0;
+    if (nextA.idx === -1) return -1; // A exhausted first -> A is the prefix -> smaller
+    if (nextB.idx === -1) return 1;
+    if (nextA.idx !== nextB.idx) return nextA.idx < nextB.idx ? -1 : 1;
+    nextA = nextIndex(nextA.l, nextA.r, mid);
+    nextB = nextIndex(nextB.l, nextB.r, mid);
+  }
+}
+
+// Pop the lowest remaining index from (left mask, right mask offset by mid).
+function nextIndex(l: number, r: number, mid: number): { idx: number; l: number; r: number } {
+  if (l !== 0) {
+    const low = l & -l;
+    return { idx: lowbitIndex(l), l: (l ^ low) >>> 0, r };
+  }
+  if (r !== 0) {
+    const low = r & -r;
+    return { idx: mid + lowbitIndex(r), l, r: (r ^ low) >>> 0 };
+  }
+  return { idx: -1, l, r };
+}
+
+// Compare two FULL solutions interpreted as 0/1 press ARRAYS over all M buttons.
+// Position i (< mid) comes from the left mask; position mid+i from the right mask.
+// Array lexicographic order is positional and left positions precede right ones,
+// so compare left arrays first, then right arrays.
+function cmpCombinedArray(lA: number, rA: number, lB: number, rB: number): number {
+  const cl = cmpArrayMask(lA, lB);
+  if (cl !== 0) return cl;
+  return cmpArrayMask(rA, rB);
+}
+
+/* ===================== meet-in-the-middle (GF(2)) ===================== */
+
+interface MitmResult {
+  left: number;
+  right: number;
+  mid: number;
+  kL: number;
+  kR: number;
+}
+
+/**
+ * Find the minimum-weight subset of buttons whose toggle vectors XOR to the
+ * target (bLo/bHi). Light states are held as two 32-bit halves so 40-bit XORs
+ * stay in fast integer ops and map keys stay primitive (< 2^53).
+ *
+ * `tie` selects the secondary objective among equal-weight solutions:
+ *   'set'   -> lexicographically smallest sorted index set   (Part 1)
+ *   'array' -> lexicographically smallest 0/1 press array     (Part 2, p = 2)
+ */
+function mitmMinWeight(
+  M: number,
+  colLo: number[],
+  colHi: number[],
+  bLo: number,
+  bHi: number,
+  tie: 'set' | 'array',
+): MitmResult | null {
+  const cmpMask = tie === 'set' ? cmpSetLex : cmpArrayMask;
+  const mid = Math.ceil(M / 2);
+  const kL = mid;
+  const kR = M - mid;
+
+  // Left half: map each reachable XOR value -> best left-button mask.
+  const leftMap = new Map<number, number>();
+  const recordLeft = (key: number, mask: number): void => {
+    const ex = leftMap.get(key);
+    if (ex === undefined) {
+      leftMap.set(key, mask);
+      return;
+    }
+    const pe = popcount32(ex);
+    const pm = popcount32(mask);
+    if (pm < pe || (pm === pe && cmpMask(mask, ex) < 0)) leftMap.set(key, mask);
+  };
+
+  let curLo = 0;
+  let curHi = 0;
+  recordLeft(curHi * 4294967296 + (curLo >>> 0), 0); // empty subset
+  const sizeL = 1 << kL;
+  for (let g = 1; g < sizeL; g++) {
+    const bit = lowbitIndex(g); // left button index toggled this Gray step
+    curLo = (curLo ^ colLo[bit]) >>> 0;
+    curHi = (curHi ^ colHi[bit]) >>> 0;
+    const mask = g ^ (g >>> 1); // current subset as a bit mask
+    recordLeft(curHi * 4294967296 + curLo, mask);
+  }
+
+  // Right half: for each right subset, look up the complementary left subset.
+  let bestW = Infinity;
+  let bestL = -1;
+  let bestR = -1;
+  const consider = (rMask: number, rLo: number, rHi: number): void => {
+    const needLo = (bLo ^ rLo) >>> 0;
+    const needHi = (bHi ^ rHi) >>> 0;
+    const key = needHi * 4294967296 + needLo;
+    const lm = leftMap.get(key);
+    if (lm === undefined) return;
+    const w = popcount32(lm) + popcount32(rMask);
+    if (w < bestW) {
+      bestW = w;
+      bestL = lm;
+      bestR = rMask;
+      return;
+    }
+    if (w === bestW) {
+      const c =
+        tie === 'set'
+          ? cmpCombinedSet(lm, rMask, bestL, bestR, mid)
+          : cmpCombinedArray(lm, rMask, bestL, bestR);
+      if (c < 0) {
+        bestL = lm;
+        bestR = rMask;
+      }
+    }
+  };
+
+  let rLo = 0;
+  let rHi = 0;
+  consider(0, 0, 0); // empty subset
+  const sizeR = 1 << kR;
+  for (let g = 1; g < sizeR; g++) {
+    const bit = lowbitIndex(g);
+    rLo = (rLo ^ colLo[mid + bit]) >>> 0;
+    rHi = (rHi ^ colHi[mid + bit]) >>> 0;
+    const mask = g ^ (g >>> 1);
+    consider(mask, rLo, rHi);
+  }
+
+  if (bestW === Infinity) return null;
+  return { left: bestL, right: bestR, mid, kL, kR };
+}
+
+/* ================================ Part 1 ================================ */
+
+export function solveToggle(machine: Machine): number[] | null {
+  const M = machine.buttons.length;
+  const colLo = new Array<number>(M).fill(0);
+  const colHi = new Array<number>(M).fill(0);
+  for (let i = 0; i < M; i++) {
+    let lo = 0;
+    let hi = 0;
+    for (const l of machine.buttons[i]) {
+      if (l < 32) lo ^= 1 << l;
+      else hi ^= 1 << (l - 32);
+    }
+    colLo[i] = lo >>> 0;
+    colHi[i] = hi >>> 0;
+  }
+  let bLo = 0;
+  let bHi = 0;
+  const t = machine.target;
+  for (let l = 0; l < t.length; l++) {
+    if (t[l]) {
+      if (l < 32) bLo ^= 1 << l;
+      else bHi ^= 1 << (l - 32);
+    }
+  }
+
+  const r = mitmMinWeight(M, colLo, colHi, bLo >>> 0, bHi >>> 0, 'set');
+  if (!r) return null;
+
+  const res: number[] = [];
+  for (let i = 0; i < r.kL; i++) if (r.left & (1 << i)) res.push(i);
+  for (let i = 0; i < r.kR; i++) if (r.right & (1 << i)) res.push(r.mid + i);
+  res.sort((a, b) => a - b);
+  return res;
+}
+
+/* ============================ modular helpers ============================ */
+
+function modpow(a: number, e: number, p: number): number {
+  a %= p;
+  if (a < 0) a += p;
+  let r = 1;
+  while (e > 0) {
+    if (e & 1) r = (r * a) % p;
+    a = (a * a) % p;
+    e >>>= 1;
+  }
+  return r;
+}
+
+function modinv(a: number, p: number): number {
+  return modpow(a, p - 2, p); // p is prime (Fermat)
+}
+
+/* ================================ Part 2 ================================ */
+
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const p = modulus;
+  const M = buttons.length;
+  const N = lights.length;
+
+  // No counters: the cheapest valid vector is all-zero.
+  if (N === 0) return new Array<number>(M).fill(0);
+
+  // Build augmented matrix [A | b] over GF(p). A[j][i] = times button i hits counter j.
+  const mat: number[][] = [];
+  for (let j = 0; j < N; j++) {
+    const row = new Array<number>(M + 1).fill(0);
+    row[M] = (((lights[j] % p) + p) % p) | 0;
+    mat.push(row);
+  }
+  for (let i = 0; i < M; i++) {
+    for (const j of buttons[i]) {
+      if (j >= 0 && j < N) mat[j][i] = (mat[j][i] + 1) % p;
+    }
+  }
+
+  // Gaussian elimination to reduced row echelon form.
+  const where = new Array<number>(M).fill(-1); // pivot column -> row
+  const pivotCols: number[] = [];
+  let pivotRow = 0;
+  for (let col = 0; col < M && pivotRow < N; col++) {
+    let sel = -1;
+    for (let r = pivotRow; r < N; r++) {
+      if (mat[r][col] !== 0) {
+        sel = r;
+        break;
+      }
+    }
+    if (sel === -1) continue;
+    const tmp = mat[pivotRow];
+    mat[pivotRow] = mat[sel];
+    mat[sel] = tmp;
+    const inv = modinv(mat[pivotRow][col], p);
+    for (let c = col; c <= M; c++) mat[pivotRow][c] = (mat[pivotRow][c] * inv) % p;
+    for (let r = 0; r < N; r++) {
+      if (r !== pivotRow && mat[r][col] !== 0) {
+        const fac = mat[r][col];
+        for (let c = col; c <= M; c++) {
+          mat[r][c] = ((mat[r][c] - fac * mat[pivotRow][c]) % p + p) % p;
+        }
+      }
+    }
+    where[col] = pivotRow;
+    pivotCols.push(col);
+    pivotRow++;
+  }
+
+  // Consistency: a row with all-zero coefficients but nonzero rhs is unsatisfiable.
+  for (let r = 0; r < N; r++) {
+    let allZero = true;
+    for (let c = 0; c < M; c++) {
+      if (mat[r][c] !== 0) {
+        allZero = false;
+        break;
+      }
+    }
+    if (allZero && mat[r][M] !== 0) return null;
+  }
+
+  const freeCols: number[] = [];
+  for (let c = 0; c < M; c++) if (where[c] === -1) freeCols.push(c);
+  const f = freeCols.length;
+
+  // Decide whether the full solution space (p^f) fits an exact enumeration.
+  const BUDGET = 4_000_000;
+  let total = 1;
+  let tooLarge = false;
+  for (let i = 0; i < f; i++) {
+    total *= p;
+    if (total > BUDGET) {
+      tooLarge = true;
+      break;
+    }
+  }
+
+  // p = 2 reduces to min-weight GF(2): use meet-in-the-middle for huge spaces.
+  if (tooLarge && p === 2) {
+    return solveCounterGF2(buttons, lights, M, N);
+  }
+
+  // Precompute, for each free variable, which pivot variables it influences.
+  const deps: { pc: number; coeff: number }[][] = [];
+  for (let i = 0; i < f; i++) {
+    const c = freeCols[i];
+    const d: { pc: number; coeff: number }[] = [];
+    for (const pc of pivotCols) {
+      const coeff = mat[where[pc]][c];
+      if (coeff !== 0) d.push({ pc, coeff });
+    }
+    deps.push(d);
+  }
+
+  // Current solution vector x and its press total, starting with all free vars 0.
+  const x = new Array<number>(M).fill(0);
+  for (const pc of pivotCols) x[pc] = mat[where[pc]][M];
+  let sum = 0;
+  for (let i = 0; i < M; i++) sum += x[i];
+
+  let best = x.slice();
+  let bestSum = sum;
+  const consider = (): void => {
+    if (sum < bestSum) {
+      bestSum = sum;
+      best = x.slice();
+      return;
+    }
+    if (sum === bestSum) {
+      for (let i = 0; i < M; i++) {
+        if (x[i] !== best[i]) {
+          if (x[i] < best[i]) best = x.slice();
+          return;
+        }
+      }
+    }
+  };
+  consider();
+
+  if (f > 0) {
+    const t = new Array<number>(f).fill(0);
+    const apply = (i: number, c: number, oldVal: number, newVal: number): void => {
+      sum += newVal - oldVal; // free variable's own rep change
+      x[c] = newVal;
+      t[i] = newVal;
+      const dmod = (((newVal - oldVal) % p) + p) % p;
+      if (dmod !== 0) {
+        const d = deps[i];
+        for (let k = 0; k < d.length; k++) {
+          const pc = d[k].pc;
+          const old = x[pc];
+          const sub = (d[k].coeff * dmod) % p;
+          let nv = old - sub;
+          if (nv < 0) nv += p;
+          sum += nv - old;
+          x[pc] = nv;
+        }
+      }
+    };
+
+    let count = 1;
+    for (;;) {
+      // mixed-radix increment over the free variables
+      let i = 0;
+      while (i < f) {
+        const c = freeCols[i];
+        const ov = t[i];
+        if (ov + 1 < p) {
+          apply(i, c, ov, ov + 1);
+          break;
+        }
+        apply(i, c, ov, 0);
+        i++;
+      }
+      if (i === f) break; // wrapped past the last digit -> exhausted
+      consider();
+      count++;
+      if (count >= BUDGET) break; // best-effort cap (only reachable when tooLarge && p>2)
+    }
+  }
+
+  return best;
+}
+
+// GF(2) fast path for solveCounter when the solution space is too large to enumerate.
+function solveCounterGF2(
+  buttons: number[][],
+  lights: number[],
+  M: number,
+  N: number,
+): number[] | null {
+  const colLo = new Array<number>(M).fill(0);
+  const colHi = new Array<number>(M).fill(0);
+  for (let i = 0; i < M; i++) {
+    let lo = 0;
+    let hi = 0;
+    for (const j of buttons[i]) {
+      if (j >= 0 && j < N) {
+        if (j < 32) lo ^= 1 << j;
+        else hi ^= 1 << (j - 32);
+      }
+    }
+    colLo[i] = lo >>> 0;
+    colHi[i] = hi >>> 0;
+  }
+  let bLo = 0;
+  let bHi = 0;
+  for (let j = 0; j < N; j++) {
+    if (((lights[j] % 2) + 2) % 2 === 1) {
+      if (j < 32) bLo ^= 1 << j;
+      else bHi ^= 1 << (j - 32);
+    }
+  }
+
+  const r = mitmMinWeight(M, colLo, colHi, bLo >>> 0, bHi >>> 0, 'array');
+  if (!r) return null;
+
+  const res = new Array<number>(M).fill(0);
+  for (let i = 0; i < r.kL; i++) if (r.left & (1 << i)) res[i] = 1;
+  for (let i = 0; i < r.kR; i++) if (r.right & (1 << i)) res[r.mid + i] = 1;
+  return res;
+}
