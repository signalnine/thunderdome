(mask 0b1001) < {1,2} (mask 0b0110) because 0 < 1.\nfunction cmpSetLex(a: number, b: number): number {\n  a = a >>> 0;\n  b = b >>> 0;\n  while (a !== 0 || b !== 0) {\n    if (a === 0) return -1; // a is a proper prefix -> smaller\n    if (b === 0) return 1;\n    const la = a & -a;\n    const lb = b & -b;\n    if (la !== lb) return la < lb ? -1 : 1; // lower bit position -> smaller index\n    a ^= la;\n    b ^= lb;\n  }\n  return 0;\n}\n\n// Compare two masks interpreted as 0/1 membership ARRAYS (index 0 == lowest bit),\n// lexicographically. The solution that omits the lowest differing index is smaller.\nfunction cmpArrayMask(a: number, b: number): number {\n  const d = (a ^ b) >>> 0;\n  if (d === 0) return 0;\n  const low = d & -d;\n  return a & low ? 1 : -1;\n}\n\n/* ===================== meet-in-the-middle (GF(2)) ===================== */\n\ninterface MitmResult {\n  left: number;\n  right: number;\n  mid: number;\n  kL: number;\n  kR: number;\n}\n\n/**\n * Find the minimum-weight subset of buttons whose toggle vectors XOR to the\n * target (bLo/bHi). Light states are held as two 32-bit halves so 40-bit XORs\n * stay in fast integer ops and map keys stay primitive (< 2^53).\n *\n * `tie` selects the secondary objective among equal-weight solutions:\n *   'set'   -> lexicographically smallest sorted index set   (Part 1)\n *   'array' -> lexicographically smallest 0/1 press array     (Part 2, p = 2)\n */\nfunction mitmMinWeight(\n  M: number,\n  colLo: number[],\n  colHi: number[],\n  bLo: number,\n  bHi: number,\n  tie: 'set' | 'array',\n): MitmResult | null {\n  const cmpMask = tie === 'set' ? cmpSetLex : cmpArrayMask;\n  const mid = Math.ceil(M / 2);\n  const kL = mid;\n  const kR = M - mid;\n\n  // Left half: map each reachable XOR value -> best left-button mask.\n  const leftMap = new Map<number, number>();\n  const recordLeft = (key: number, mask: number): void => {\n    const ex = leftMap.get(key);\n    if (ex === undefined) {\n      leftMap.set(key, mask);