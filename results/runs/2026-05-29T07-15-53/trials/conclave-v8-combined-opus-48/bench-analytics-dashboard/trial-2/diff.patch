('/api/dashboards', authenticate, (req: Request, res: Response) => {\n    const rows = db\n      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC')\n      .all(req.user!.tenantId);\n    res.json(rows);\n  });\n\n  function getTenantDashboard(id: string, tenantId: string): DashboardRow | undefined {\n    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as\n      | DashboardRow\n      | undefined;\n    if (!row || row.tenant_id !== tenantId) return undefined;\n    return row;\n  }\n\n  app.get('/api/dashboards/:id', authenticate, (req: Request, res: Response) => {\n    const row = getTenantDashboard(req.params.id, req.user!.tenantId);\n    if (!row) {\n      res.status(404).json({ error: 'dashboard not found' });\n      return;\n    }\n    res.json(row);\n  });\n\n  app.put('/api/dashboards/:id', authenticate, (req: Request, res: Response) => {\n    const row = getTenantDashboard(req.params.id, req.user!.tenantId);\n    if (!row) {\n      res.status(404).json({ error: 'dashboard not found' });\n      return;\n    }\n    const name = typeof req.body?.name === 'string' ? req.body.name : row.name;\n    const config =\n      req.body?.config !== undefined ? JSON.stringify(req.body.config) : row.config;\n    db.prepare(\n      \"UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?\",\n    ).run(name, config, row.id);\n    const updated = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(row.id);\n    res.json(updated);\n  });\n\n  app.delete('/api/dashboards/:id', authenticate, (req: Request, res: Response) => {\n    const row = getTenantDashboard(req.params.id, req.user!.tenantId);\n    if (!row) {\n      res.status(404).json({ error: 'dashboard not found' });\n      return;\n    }\n    db.prepare('DELETE FROM dashboards WHERE id = ?').run(row.id);\n    res.status(204).end();\n  });\n\n  // ===================== Export =====================\n\n  app.get('/api/export/events', authenticate, (req: Request, res: Response) => {\n    const format = (req.query.format as string) ?? 'json';\n    const rows = db\n      .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp ASC')\n      .all(req.user!.tenantId) as Record<string, unknown>[];\n    if (format === 'csv') {\n      res.type('text/csv').attachment('events.csv').send(toCsv(rows));\n      return;\n    }\n    res.json(rows);\n  });\n\n  app.get('/api/export/dashboards/:id', authenticate, (req: Request, res: Response) => {\n    const row = getTenantDashboard(req.params.id, req.user!.tenantId);\n    if (!row) {\n      res.status(404).json({ error: 'dashboard not found' });\n      return;\n    }\n    const widgets = db\n      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')\n      .all(row.id) as Record<string, unknown>[];\n    const format = (req.query.format as string) ?? 'json';\n    if (format === 'csv') {\n      const flat = [{ ...row, widget_count: widgets.length }] as Record<string, unknown>[];\n      res.type('text/csv').attachment('dashboard.csv').send(toCsv(flat));\n      return;\n    }\n    res.json({ ...row, widgets });\n  });\n\n  return app;\n}\n\nexport default createApp;\n","structuredPatch":[],"originalFile":null,"userModified":false}}
