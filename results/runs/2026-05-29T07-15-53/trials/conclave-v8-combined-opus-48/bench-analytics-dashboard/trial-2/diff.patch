nd({ email: 'c@x.com', password: 'pw123456' });\n    expect(ok.status).toBe(200);\n    expect(ok.body.token).toBeTruthy();\n    const bad = await request(app)\n      .post('/api/auth/login')\n      .send({ email: 'c@x.com', password: 'wrong' });\n    expect(bad.status).toBe(401);\n  });\n\n  it('returns own profile, 401 without token', async () => {\n    const { token } = await register('d@x.com', 't1');\n    const me = await request(app).get('/api/me').set('Authorization', `Bearer ${token}`);\n    expect(me.status).toBe(200);\n    expect(me.body.email).toBe('d@x.com');\n    const no = await request(app).get('/api/me');\n    expect(no.status).toBe(401);\n  });\n\n  it('admin changes role within tenant; rules enforced', async () => {\n    const admin = await register('adm@x.com', 't1', 'admin');\n    const viewer = await register('vw@x.com', 't1', 'viewer');\n    const other = await register('ot@x.com', 't2', 'viewer');\n\n    const ok = await request(app)\n      .patch(`/api/users/${viewer.id}/role`)\n      .set('Authorization', `Bearer ${admin.token}`)\n      .send({ role: 'editor' });\n    expect(ok.status).toBe(200);\n    expect(ok.body.role).toBe('editor');\n\n    const invalid = await request(app)\n      .patch(`/api/users/${viewer.id}/role`)\n      .set('Authorization', `Bearer ${admin.token}`)\n      .send({ role: 'superuser' });\n    expect(invalid.status).toBe(400);\n\n    const crossTenant = await request(app)\n      .patch(`/api/users/${other.id}/role`)\n      .set('Authorization', `Bearer ${admin.token}`)\n      .send({ role: 'editor' });\n    expect(crossTenant.status).toBe(404);\n\n    const nonAdmin = await request(app)\n      .patch(`/api/users/${admin.id}/role`)\n      .set('Authorization', `Bearer ${viewer.token}`)\n      .send({ role: 'viewer' });\n    expect(nonAdmin.status).toBe(403);\n  });\n});\n\ndescribe('ingestion', () => {\n  it('ingests single events and rejects missing name', async () => {\n    const { token } = await register('e@x.com', 't1');\n    const ok = await request(app)\n      .post('/api/events')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'page_view', properties: { url: '/home' } });\n    expect(ok.status).toBe(201);\n    expect(ok.body.event.name).toBe('page_view');\n    expect(ok.body.event.tenant_id).toBe('t1');\n\n    const bad = await request(app)\n      .post('/api/events')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ properties: {} });\n    expect(bad.status).toBe(400);\n  });\n\n  it('ingests batches and rejects non-array', async () => {\n    const { token } = await register('f@x.com', 't1');\n    const ok = await request(app)\n      .post('/api/events/batch')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ events: [{ name: 'a' }, { name: 'b' }, { bad: true }] });\n    expect(ok.status).toBe(201);\n    expect(ok.body.count).toBe(2);\n\n    const bad = await request(app)\n      .post('/api/events/batch')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ events: [] });\n    expect(bad.status).toBe(400);\n  });\n\n  it('requires auth (401)', async () => {\n    const res = await request(app).post('/api/events').send({ name: 'x' });\n    expect(res.status).toBe(401);\n  });\n});\n\ndescribe('query engine & tenant isolation', () => {\n  async function seed(token: string) {\n    await request(app)\n      .post('/api/events/batch')\n      .set('Authorization', `Bearer ${token}`)\n      .send({\n        events: [\n          { name: 'page_view', properties: { url: '/a' }, timestamp: '2024-01-01 10:00:00' },\n          { name: 'page_view', properties: { url: '/a' }, timestamp: '2024-01-01 11:00:00' },\n          { name: 'page_view', properties: { url: '/b' }, timestamp: '2024-01-02 10:00:00' },\n          { name: 'click', properties: { url: '/a' }, timestamp: '2024-01-02 10:00:00' },\n        ],\n      });\n  }\n\n  it('counts with filters', async () => {\n    const { token } = await register('g@x.com', 't1');\n    await seed(token);\n    const all = await request(app)\n      .post('/api/query/count')\n      .set('Authorization', `Bearer ${token}`)\n      .send({});\n    expect(all.body.count).toBe(4);\n    const pv = await request(app)\n      .post('/api/query/count')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'page_view' });\n    expect(pv.body.count).toBe(3);\n    const filtered = await request(app)\n      .post('/api/query/count')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'page_view', filters: { url: '/a' } });\n    expect(filtered.body.count).toBe(2);\n  });\n\n  it('timeseries buckets by day', async () => {\n    const { token } = await register('h@x.com', 't1');\n    await seed(token);\n    const res = await request(app)\n      .post('/api/query/timeseries')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'page_view', interval: 'day' });\n    expect(res.body.buckets).toEqual([\n      { bucket: '2024-01-01', count: 2 },\n      { bucket: '2024-01-02', count: 1 },\n    ]);\n  });\n\n  it('breakdown by property', async () => {\n    const { token } = await register('i@x.com', 't1');\n    await seed(token);\n    const res = await request(app)\n      .post('/api/query/breakdown')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'page_view', property: 'url' });\n    expect(res.body.breakdown).toContainEqual({ value: '/a', count: 2 });\n    expect(res.body.breakdown).toContainEqual({ value: '/b', count: 1 });\n\n    const bad = await request(app)\n      .post('/api/query/breakdown')\n      .set('Authorization', `Bearer ${token}`)\n      .send({});\n    expect(bad.status).toBe(400);\n  });\n\n  it('isolates tenants', async () => {\n    const t1 = await register('j@x.com', 't1');\n    const t2 = await register('k@x.com', 't2');\n    await seed(t1.token);\n    const c2 = await request(app)\n      .post('/api/query/count')\n      .set('Authorization', `Bearer ${t2.token}`)\n      .send({});\n    expect(c2.body.count).toBe(0);\n  });\n});\n\ndescribe('dashboards', () => {\n  it('CRUD with tenant scoping', async () => {\n    const t1 = await register('l@x.com', 't1');\n    const t2 = await register('m@x.com', 't2');\n\n    const create = await request(app)\n      .post('/api/dashboards')\n      .set('Authorization', `Bearer ${t1.token}`)\n      .send({ name: 'Main', config: { theme: 'dark' } });\n    expect(create.status).toBe(201);\n    const id = create.body.id;\n\n    const list = await request(app)\n      .get('/api/dashboards')\n      .set('Authorization', `Bearer ${t1.token}`);\n    expect(list.body).toHaveLength(1);\n\n    const get = await request(app)\n      .get(`/api/dashboards/${id}`)\n      .set('Authorization', `Bearer ${t1.token}`);\n    expect(get.status).toBe(200);\n\n    const crossTenant = await request(app)\n      .get(`/api/dashboards/${id}`)\n      .set('Authorization', `Bearer ${t2.token}`);\n    expect(crossTenant.status).toBe(404);\n\n    const upd = await request(app)\n      .put(`/api/dashboards/${id}`)\n      .set('Authorization', `Bearer ${t1.token}`)\n      .send({ name: 'Renamed' });\n    expect(upd.status).toBe(200);\n    expect(upd.body.name).toBe('Renamed');\n\n    const del = await request(app)\n      .delete(`/api/dashboards/${id}`)\n      .set('Authorization', `Bearer ${t1.token}`);\n    expect(del.status).toBe(204);\n\n    const gone = await request(app)\n      .get(`/api/dashboards/${id}`)\n      .set('Authorization', `Bearer ${t1.token}`);\n    expect(gone.status).toBe(404);\n  });\n\n  it('requires auth', async () => {\n    const res = await request(app).get('/api/dashboards');\n    expect(res.status).toBe(401);\n  });\n});\n\ndescribe('export', () => {\n  it('exports events as json and csv, tenant-bounded', async () => {\n    const { token } = await register('n@x.com', 't1');\n    await request(app)\n      .post('/api/events')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'page_view', properties: { url: '/x' } });\n\n    const json = await request(app)\n      .get('/api/export/events?format=json')\n      .set('Authorization', `Bearer ${token}`);\n    expect(json.status).toBe(200);\n    expect(Array.isArray(json.body)).toBe(true);\n    expect(json.body).toHaveLength(1);\n\n    const csv = await request(app)\n      .get('/api/export/events?format=csv')\n      .set('Authorization', `Bearer ${token}`);\n    expect(csv.status).toBe(200);\n    expect(csv.headers['content-type']).toContain('text/csv');\n    expect(csv.text.split('\\n')[0]).toContain('name');\n  });\n\n  it('exports dashboards, tenant-bounded', async () => {\n    const t1 = await register('o@x.com', 't1');\n    const t2 = await register('p@x.com', 't2');\n    const create = await request(app)\n      .post('/api/dashboards')\n      .set('Authorization', `Bearer ${t1.token}`)\n      .send({ name: 'D' });\n    const id = create.body.id;\n\n    const json = await request(app)\n      .get(`/api/export/dashboards/${id}?format=json`)\n      .set('Authorization', `Bearer ${t1.token}`);\n    expect(json.status).toBe(200);\n    expect(json.body.name).toBe('D');\n\n    const csv = await request(app)\n      .get(`/api/export/dashboards/${id}?format=csv`)\n      .set('Authorization', `Bearer ${t1.token}`);\n    expect(csv.status).toBe(200);\n    expect(csv.headers['content-type']).toContain('text/csv');\n\n    const cross = await request(app)\n      .get(`/api/export/dashboards/${id}?format=json`)\n      .set('Authorization', `Bearer ${t2.token}`);\n    expect(cross.status).toBe(404);\n  });\n\n  it('requires auth', async () => {\n    const res = await request(app).get('/api/export/events');\n    expect(res.status).toBe(401);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":323,"cache_read_input_tokens":39059,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":323},"output_tok