+import Database from 'better-sqlite3';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+export type DB = Database.Database;
+
+/**
+ * Create and initialize a database instance from schema.sql.
+ * Pass ':memory:' (the default) for an ephemeral DB, or a file path for persistence.
+ */
+export function createDb(filename = ':memory:'): DB {
+  const db = new Database(filename);
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+
+  // schema.sql lives at the project root (one level above src/ and dist/)
+  const schemaPath = join(__dirname, '..', 'schema.sql');
+  const schema = readFileSync(schemaPath, 'utf-8');
+  db.exec(schema);
+
+  return db;
+}
