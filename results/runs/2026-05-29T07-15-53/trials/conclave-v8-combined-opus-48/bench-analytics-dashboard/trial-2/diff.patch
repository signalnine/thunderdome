+import type { DB } from './db.js';
+
+export type Interval = 'minute' | 'hour' | 'day' | 'week' | 'month';
+
+export interface QueryFilters {
+  /** Match against the event name. */
+  name?: string;
+  /** Match against JSON properties: { url: '/home' } => json_extract(properties,'$.url') = '/home'. */
+  filters?: Record<string, string | number | boolean>;
+  /** Inclusive lower/upper time bounds (ISO or 'YYYY-MM-DD HH:MM:SS'). */
+  from?: string;
+  to?: string;
+}
+
+interface WhereClause {
+  sql: string;
+  params: unknown[];
+}
+
+const STRFTIME_FORMAT: Record<Interval, string> = {
+  minute: '%Y-%m-%d %H:%M',
+  hour: '%Y-%m-%d %H:00',
+  day: '%Y-%m-%d',
+  week: '%Y-%W',
+  month: '%Y-%m',
+};
+
+/** Build a tenant-scoped WHERE clause from query filters. tenantId is always enforced. */
+function buildWhere(tenantId: string, q: QueryFilters): WhereClause {
+  const clauses: string[] = ['tenant_id = ?'];
+  const params: unknown[] = [tenantId];
+
+  if (q.name !== undefined) {
+    clauses.push('name = ?');
+    params.push(q.name);
+  }
+  if (q.from !== undefined) {
+    clauses.push('timestamp >= ?');
+    params.push(q.from);
+  }
+  if (q.to !== undefined) {
+    clauses.push('timestamp <= ?');
+    params.push(q.to);
+  }
+  if (q.filters && typeof q.filters === 'object') {
+    for (const [key, value] of Object.entries(q.filters)) {
+      clauses.push('json_extract(properties, ?) = ?');
+      params.push(`$.${key}`, value as unknown);
+    }
+  }
+
+  return { sql: clauses.join(' AND '), params };
+}
+
+/** Count events matching the filter within a tenant. */
+export function count(db: DB, tenantId: string, q: QueryFilters): number {
+  const where = buildWhere(tenantId, q);
+  const row = db
+    .prepare(`SELECT COUNT(*) AS c FROM events WHERE ${where.sql}`)
+    .get(...where.params) as { c: number };
+  return row.c;
+}
+
+export interface TimeseriesBucket {
+  bucket: string;
+  count: number;
+}
+
+/** Bucket event counts over time at the given interval (default: day). */
+export function timeseries(
+  db: DB,
+  tenantId: string,
+  q: QueryFilters,
+  interval: Interval = 'day',
+): TimeseriesBucket[] {
+  const fmt = STRFTIME_FORMAT[interval] ?? STRFTIME_FORMAT.day;
+  const where = buildWhere(tenantId, q);
+  const rows = db
+    .prepare(
+      `SELECT strftime('${fmt}', timestamp) AS bucket, COUNT(*) AS count
+       FROM events WHERE ${where.sql}
+       GROUP BY bucket ORDER BY bucket ASC`,
+    )
+    .all(...where.params) as TimeseriesBucket[];
+  return rows;
+}
+
+export interface BreakdownRow {
+  value: string | null;
+  count: number;
+}
+
+/** Group event counts by a property value within a tenant. */
+export function breakdown(
+  db: DB,
+  tenantId: string,
+  property: string,
+  q: QueryFilters,
+): BreakdownRow[] {
+  const where = buildWhere(tenantId, q);
+  const rows = db
+    .prepare(
+      `SELECT json_extract(properties, ?) AS value, COUNT(*) AS count
+       FROM events WHERE ${where.sql}
+       GROUP BY value ORDER BY count DESC`,
+    )
+    .all(`$.${property}`, ...where.params) as BreakdownRow[];
+  return rows;
+}
