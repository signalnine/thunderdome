--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,360 @@
+import express, { type Express, type Request, type Response } from 'express';
+import { v4 as uuid } from 'uuid';
+import { createDb, type DB } from './db.js';
+import {
+  authenticate,
+  hashPassword,
+  verifyPassword,
+  signToken,
+  requireRole,
+  type Role,
+} from './auth.js';
+import { count, timeseries, breakdown, type Interval, type QueryFilters } from './query.js';
+
+const VALID_ROLES: Role[] = ['admin', 'editor', 'viewer'];
+
+interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: Role;
+  created_at: string;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+function publicUser(u: UserRow) {
+  return {
+    id: u.id,
+    email: u.email,
+    tenantId: u.tenant_id,
+    role: u.role,
+    createdAt: u.created_at,
+  };
+}
+
+function toCsv(rows: Record<string, unknown>[]): string {
+  if (rows.length === 0) return '';
+  const headers = Object.keys(rows[0]);
+  const escape = (v: unknown): string => {
+    const s = v === null || v === undefined ? '' : String(v);
+    if (/[",\n\r]/.test(s)) return `"${s.replace(/"/g, '""')}"`;
+    return s;
+  };
+  const lines = [headers.join(',')];
+  for (const row of rows) {
+    lines.push(headers.map((h) => escape(row[h])).join(','));
+  }
+  return lines.join('\n');
+}
+
+export function createApp(db: DB = createDb()): Express {
+  const app = express();
+  app.use(express.json({ limit: '10mb' }));
+
+  // ---- Health ----
+  app.get('/health', (_req: Request, res: Response) => {
+    res.json({ status: 'ok' });
+  });
+
+  // ===================== Auth / Users =====================
+
+  app.post('/api/auth/register', (req: Request, res: Response) => {
+    const { email, password, tenantId, role } = req.body ?? {};
+    if (!email || !password || !tenantId) {
+      res.status(400).json({ error: 'email, password and tenantId are required' });
+      return;
+    }
+    if (role !== undefined && !VALID_ROLES.includes(role)) {
+      res.status(400).json({ error: 'invalid role' });
+      return;
+    }
+    const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(email);
+    if (existing) {
+      res.status(409).json({ error: 'email already registered' });
+      return;
+    }
+    const id = uuid();
+    const finalRole: Role = (role as Role) ?? 'viewer';
+    db.prepare(
+      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)',
+    ).run(id, email, hashPassword(password), tenantId, finalRole);
+    const user = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow;
+    const token = signToken({ id, email, tenantId, role: finalRole });
+    res.status(201).json({ token, user: publicUser(user) });
+  });
+
+  app.post('/api/auth/login', (req: Request, res: Response) => {
+    const { email, password } = req.body ?? {};
+    if (!email || !password) {
+      res.status(400).json({ error: 'email and password are required' });
+      return;
+    }
+    const user = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as
+      | UserRow
+      | undefined;
+    if (!user || !verifyPassword(password, user.password_hash)) {
+      res.status(401).json({ error: 'invalid credentials' });
+      return;
+    }
+    const token = signToken({
+      id: user.id,
+      email: user.email,
+      tenantId: user.tenant_id,
+      role: user.role,
+    });
+    res.json({ token, user: publicUser(user) });
+  });
+
+  app.get('/api/me', authenticate, (req: Request, res: Response) => {
+    const user = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as
+      | UserRow
+      | undefined;
+    if (!user) {
+      res.status(404).json({ error: 'user not found' });
+      return;
+    }
+    res.json(publicUser(user));
+  });
+
+  // List users in the caller's tenant (admin only).
+  app.get('/api/users', authenticate, requireRole('admin'), (req: Request, res: Response) => {
+    const rows = db
+      .prepare('SELECT * FROM users WHERE tenant_id = ? ORDER BY created_at ASC')
+      .all(req.user!.tenantId) as UserRow[];
+    res.json(rows.map(publicUser));
+  });
+
+  // Admin changes another user's role within the same tenant.
+  app.patch(
+    '/api/users/:id/role',
+    authenticate,
+    requireRole('admin'),
+    (req: Request, res: Response) => {
+      const { role } = req.body ?? {};
+      if (!role || !VALID_ROLES.includes(role)) {
+        res.status(400).json({ error: 'valid role is required' });
+        return;
+      }
+      const target = db.prepare('SELECT * FROM users WHERE id = ?').get(req.params.id) as
+        | UserRow
+        | undefined;
+      if (!target || target.tenant_id !== req.user!.tenantId) {
+        res.status(404).json({ error: 'user not found in tenant' });
+        return;
+      }
+      db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);
+      const updated = db.prepare('SELECT * FROM users WHERE id = ?').get(target.id) as UserRow;
+      res.json(publicUser(updated));
+    },
+  );
+
+  // ===================== Ingestion =====================
+
+  interface EventInput {
+    name?: unknown;
+    properties?: unknown;
+    timestamp?: unknown;
+    sessionId?: unknown;
+  }
+
+  function insertEvent(tenantId: string, userId: string, input: EventInput): {
+    ok: boolean;
+    id?: string;
+  } {
+    if (!input || typeof input.name !== 'string' || input.name.length === 0) {
+      return { ok: false };
+    }
+    const id = uuid();
+    const properties =
+      input.properties !== undefined && input.properties !== null
+        ? JSON.stringify(input.properties)
+        : '{}';
+    const timestamp =
+      typeof input.timestamp === 'string' && input.timestamp.length > 0
+        ? input.timestamp
+        : new Date().toISOString();
+    const sessionId = typeof input.sessionId === 'string' ? input.sessionId : null;
+    db.prepare(
+      `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+       VALUES (?, ?, ?, ?, ?, ?, ?)`,
+    ).run(id, tenantId, input.name, properties, timestamp, userId, sessionId);
+    return { ok: true, id };
+  }
+
+  app.post('/api/events', authenticate, (req: Request, res: Response) => {
+    const result = insertEvent(req.user!.tenantId, req.user!.id, req.body ?? {});
+    if (!result.ok) {
+      res.status(400).json({ error: 'event name is required' });
+      return;
+    }
+    const event = db.prepare('SELECT * FROM events WHERE id = ?').get(result.id);
+    res.status(201).json({ event });
+  });
+
+  app.post('/api/events/batch', authenticate, (req: Request, res: Response) => {
+    const events = req.body?.events;
+    if (!Array.isArray(events) || events.length === 0) {
+      res.status(400).json({ error: 'events must be a non-empty array' });
+      return;
+    }
+    const tenantId = req.user!.tenantId;
+    const userId = req.user!.id;
+    let inserted = 0;
+    const insertMany = db.transaction((items: EventInput[]) => {
+      for (const item of items) {
+        const r = insertEvent(tenantId, userId, item);
+        if (r.ok) inserted += 1;
+      }
+    });
+    insertMany(events as EventInput[]);
+    res.status(201).json({ count: inserted });
+  });
+
+  // ===================== Query Engine =====================
+
+  function readFilters(body: Record<string, unknown> | undefined): QueryFilters {
+    const b = body ?? {};
+    return {
+      name: typeof b.name === 'string' ? b.name : undefined,
+      filters:
+        b.filters && typeof b.filters === 'object'
+          ? (b.filters as Record<string, string | number | boolean>)
+          : undefined,
+      from: typeof b.from === 'string' ? b.from : undefined,
+      to: typeof b.to === 'string' ? b.to : undefined,
+    };
+  }
+
+  app.post('/api/query/count', authenticate, (req: Request, res: Response) => {
+    const c = count(db, req.user!.tenantId, readFilters(req.body));
+    res.json({ count: c });
+  });
+
+  app.post('/api/query/timeseries', authenticate, (req: Request, res: Response) => {
+    const interval = (req.body?.interval as Interval) ?? 'day';
+    const buckets = timeseries(db, req.user!.tenantId, readFilters(req.body), interval);
+    res.json({ interval, buckets });
+  });
+
+  app.post('/api/query/breakdown', authenticate, (req: Request, res: Response) => {
+    const property = req.body?.property;
+    if (typeof property !== 'string' || property.length === 0) {
+      res.status(400).json({ error: 'property is required' });
+      return;
+    }
+    const rows = breakdown(db, req.user!.tenantId, property, readFilters(req.body));
+    res.json({ property, breakdown: rows });
+  });
+
+  // ===================== Dashboards =====================
+
+  app.post('/api/dashboards', authenticate, (req: Request, res: Response) => {
+    const { name, config } = req.body ?? {};
+    if (!name || typeof name !== 'string') {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+    const id = uuid();
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)',
+    ).run(id, req.user!.tenantId, name, req.user!.id, JSON.stringify(config ?? {}));
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+    res.status(201).json(row);
+  });
+
+  app.get('/api/dashboards', authenticate, (req: Request, res: Response) => {
+    const rows = db
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC')
+      .all(req.user!.tenantId);
+    res.json(rows);
+  });
+
+  function getTenantDashboard(id: string, tenantId: string): DashboardRow | undefined {
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as
+      | DashboardRow
+      | undefined;
+    if (!row || row.tenant_id !== tenantId) return undefined;
+    return row;
+  }
+
+  app.get('/api/dashboards/:id', authenticate, (req: Request, res: Response) => {
+    const row = getTenantDashboard(req.params.id, req.user!.tenantId);
+    if (!row) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    res.json(row);
+  });
+
+  app.put('/api/dashboards/:id', authenticate, (req: Request, res: Response) => {
+    const row = getTenantDashboard(req.params.id, req.user!.tenantId);
+    if (!row) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    const name = typeof req.body?.name === 'string' ? req.body.name : row.name;
+    const config =
+      req.body?.config !== undefined ? JSON.stringify(req.body.config) : row.config;
+    db.prepare(
+      "UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?",
+    ).run(name, config, row.id);
+    const updated = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(row.id);
+    res.json(updated);
+  });
+
+  app.delete('/api/dashboards/:id', authenticate, (req: Request, res: Response) => {
+    const row = getTenantDashboard(req.params.id, req.user!.tenantId);
+    if (!row) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(row.id);
+    res.status(204).end();
+  });
+
+  // ===================== Export =====================
+
+  app.get('/api/export/events', authenticate, (req: Request, res: Response) => {
+    const format = (req.query.format as string) ?? 'json';
+    const rows = db
+      .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp ASC')
+      .all(req.user!.tenantId) as Record<string, unknown>[];
+    if (format === 'csv') {
+      res.type('text/csv').attachment('events.csv').send(toCsv(rows));
+      return;
+    }
+    res.json(rows);
+  });
+
+  app.get('/api/export/dashboards/:id', authenticate, (req: Request, res: Response) => {
+    const row = getTenantDashboard(req.params.id, req.user!.tenantId);
+    if (!row) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    const widgets = db
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+      .all(row.id) as Record<string, unknown>[];
+    const format = (req.query.format as string) ?? 'json';
+    if (format === 'csv') {
+      const flat = [{ ...row, widget_count: widgets.length }] as Record<string, unknown>[];
+      res.type('text/csv').attachment('dashboard.csv').send(toCsv(flat));
+      return;
+    }
+    res.json({ ...row, widgets });
+  });
+
+  return app;
+}
+
+export default createApp;
