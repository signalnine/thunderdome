--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,366 @@
+import express from 'express';
+import type { Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { createDb, type DB } from './db.js';
+import {
+  hashPassword,
+  verifyPassword,
+  signToken,
+  authMiddleware,
+  type AuthRequest,
+} from './auth.js';
+import {
+  countEvents,
+  timeseries,
+  breakdown,
+  type QueryFilters,
+} from './queries.js';
+
+const VALID_ROLES = ['admin', 'editor', 'viewer'] as const;
+
+interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: string;
+  created_at: string;
+}
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+function publicUser(row: UserRow): Omit<UserRow, 'password_hash'> {
+  const { password_hash: _ph, ...rest } = row;
+  return rest;
+}
+
+export interface AppOptions {
+  db?: DB;
+  dbFile?: string;
+}
+
+export function createApp(options: AppOptions = {}): express.Express {
+  const db = options.db ?? createDb(options.dbFile);
+  const app = express();
+  app.use(express.json({ limit: '5mb' }));
+
+  // ---------------------------------------------------------------- Auth
+  app.post('/auth/register', (req, res) => {
+    const { email, password, tenantId, role } = req.body ?? {};
+    if (typeof email !== 'string' || typeof password !== 'string' || !email || !password) {
+      res.status(400).json({ error: 'email and password are required' });
+      return;
+    }
+    const existing = db
+      .prepare('SELECT id FROM users WHERE email = ?')
+      .get(email);
+    if (existing) {
+      res.status(409).json({ error: 'email already registered' });
+      return;
+    }
+    const finalRole =
+      typeof role === 'string' && (VALID_ROLES as readonly string[]).includes(role)
+        ? role
+        : 'admin';
+    const id = uuidv4();
+    const tenant = typeof tenantId === 'string' && tenantId ? tenantId : uuidv4();
+    db.prepare(
+      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)',
+    ).run(id, email, hashPassword(password), tenant, finalRole);
+    const user = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow;
+    const token = signToken({ userId: id, tenantId: tenant, role: finalRole });
+    res.status(201).json({ token, user: publicUser(user) });
+  });
+
+  app.post('/auth/login', (req, res) => {
+    const { email, password } = req.body ?? {};
+    if (typeof email !== 'string' || typeof password !== 'string') {
+      res.status(400).json({ error: 'email and password are required' });
+      return;
+    }
+    const user = db
+      .prepare('SELECT * FROM users WHERE email = ?')
+      .get(email) as UserRow | undefined;
+    if (!user || !verifyPassword(password, user.password_hash)) {
+      res.status(401).json({ error: 'invalid credentials' });
+      return;
+    }
+    const token = signToken({
+      userId: user.id,
+      tenantId: user.tenant_id,
+      role: user.role,
+    });
+    res.json({ token, user: publicUser(user) });
+  });
+
+  // All routes below require authentication.
+  app.use(authMiddleware);
+
+  app.get('/me', (req: AuthRequest, res) => {
+    const user = db
+      .prepare('SELECT * FROM users WHERE id = ?')
+      .get(req.auth!.userId) as UserRow | undefined;
+    if (!user) {
+      res.status(404).json({ error: 'user not found' });
+      return;
+    }
+    res.json({ user: publicUser(user) });
+  });
+
+  app.get('/users', (req: AuthRequest, res) => {
+    const rows = db
+      .prepare('SELECT * FROM users WHERE tenant_id = ? ORDER BY created_at ASC')
+      .all(req.auth!.tenantId) as UserRow[];
+    res.json({ users: rows.map(publicUser) });
+  });
+
+  app.patch('/users/:id/role', (req: AuthRequest, res) => {
+    if (req.auth!.role !== 'admin') {
+      res.status(403).json({ error: 'admin role required' });
+      return;
+    }
+    const { role } = req.body ?? {};
+    if (typeof role !== 'string' || !(VALID_ROLES as readonly string[]).includes(role)) {
+      res.status(400).json({ error: 'invalid role' });
+      return;
+    }
+    const target = db
+      .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.auth!.tenantId) as UserRow | undefined;
+    if (!target) {
+      res.status(404).json({ error: 'user not found' });
+      return;
+    }
+    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);
+    const updated = db
+      .prepare('SELECT * FROM users WHERE id = ?')
+      .get(target.id) as UserRow;
+    res.json({ user: publicUser(updated) });
+  });
+
+  // ---------------------------------------------------------- Ingestion
+  function insertEvent(
+    tenantId: string,
+    userId: string,
+    body: Record<string, unknown>,
+  ): EventRow | null {
+    const name = body.name;
+    if (typeof name !== 'string' || !name) {
+      return null;
+    }
+    const id = uuidv4();
+    const properties = JSON.stringify(body.properties ?? {});
+    const timestamp =
+      typeof body.timestamp === 'string' && body.timestamp
+        ? body.timestamp
+        : new Date().toISOString();
+    const sessionId =
+      typeof body.session_id === 'string' ? body.session_id : null;
+    db.prepare(
+      `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+       VALUES (?, ?, ?, ?, ?, ?, ?)`,
+    ).run(id, tenantId, name, properties, timestamp, userId, sessionId);
+    return {
+      id,
+      tenant_id: tenantId,
+      name,
+      properties,
+      timestamp,
+      user_id: userId,
+      session_id: sessionId,
+    };
+  }
+
+  app.post('/events', (req: AuthRequest, res) => {
+    const event = insertEvent(req.auth!.tenantId, req.auth!.userId, req.body ?? {});
+    if (!event) {
+      res.status(400).json({ error: 'event name is required' });
+      return;
+    }
+    res.status(201).json({ event });
+  });
+
+  app.post('/events/batch', (req: AuthRequest, res) => {
+    const events = (req.body ?? {}).events ?? req.body;
+    if (!Array.isArray(events) || events.length === 0) {
+      res.status(400).json({ error: 'events array is required' });
+      return;
+    }
+    for (const e of events) {
+      if (!e || typeof e !== 'object' || typeof e.name !== 'string' || !e.name) {
+        res.status(400).json({ error: 'every event must have a name' });
+        return;
+      }
+    }
+    const insertMany = db.transaction((items: Record<string, unknown>[]) => {
+      let n = 0;
+      for (const item of items) {
+        if (insertEvent(req.auth!.tenantId, req.auth!.userId, item)) {
+          n += 1;
+        }
+      }
+      return n;
+    });
+    const inserted = insertMany(events as Record<string, unknown>[]);
+    res.status(201).json({ inserted });
+  });
+
+  // -------------------------------------------------------- Query engine
+  app.post('/query/count', (req: AuthRequest, res) => {
+    const count = countEvents(db, req.auth!.tenantId, (req.body ?? {}) as QueryFilters);
+    res.json({ count });
+  });
+
+  app.post('/query/timeseries', (req: AuthRequest, res) => {
+    const body = (req.body ?? {}) as QueryFilters & { interval?: string };
+    res.json({ series: timeseries(db, req.auth!.tenantId, body) });
+  });
+
+  app.post('/query/breakdown', (req: AuthRequest, res) => {
+    const body = (req.body ?? {}) as QueryFilters & { property?: string };
+    if (typeof body.property !== 'string' || !body.property) {
+      res.status(400).json({ error: 'property is required' });
+      return;
+    }
+    res.json({
+      breakdown: breakdown(db, req.auth!.tenantId, { ...body, property: body.property }),
+    });
+  });
+
+  // --------------------------------------------------------- Dashboards
+  app.post('/dashboards', (req: AuthRequest, res) => {
+    const { name, config } = req.body ?? {};
+    if (typeof name !== 'string' || !name) {
+      res.status(400).json({ error: 'dashboard name is required' });
+      return;
+    }
+    const id = uuidv4();
+    const cfg = JSON.stringify(config ?? {});
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)',
+    ).run(id, req.auth!.tenantId, name, req.auth!.userId, cfg);
+    const dash = db
+      .prepare('SELECT * FROM dashboards WHERE id = ?')
+      .get(id) as DashboardRow;
+    res.status(201).json({ dashboard: dash });
+  });
+
+  app.get('/dashboards', (req: AuthRequest, res) => {
+    const rows = db
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at ASC')
+      .all(req.auth!.tenantId) as DashboardRow[];
+    res.json({ dashboards: rows });
+  });
+
+  function getDashboard(tenantId: string, id: string): DashboardRow | undefined {
+    return db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(id, tenantId) as DashboardRow | undefined;
+  }
+
+  app.get('/dashboards/:id', (req: AuthRequest, res) => {
+    const dash = getDashboard(req.auth!.tenantId, req.params.id);
+    if (!dash) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    res.json({ dashboard: dash });
+  });
+
+  app.put('/dashboards/:id', (req: AuthRequest, res) => {
+    const dash = getDashboard(req.auth!.tenantId, req.params.id);
+    if (!dash) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    const { name, config } = req.body ?? {};
+    const newName = typeof name === 'string' && name ? name : dash.name;
+    const newConfig =
+      config !== undefined ? JSON.stringify(config) : dash.config;
+    db.prepare(
+      "UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?",
+    ).run(newName, newConfig, dash.id);
+    const updated = db
+      .prepare('SELECT * FROM dashboards WHERE id = ?')
+      .get(dash.id) as DashboardRow;
+    res.json({ dashboard: updated });
+  });
+
+  app.delete('/dashboards/:id', (req: AuthRequest, res) => {
+    const dash = getDashboard(req.auth!.tenantId, req.params.id);
+    if (!dash) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(dash.id);
+    res.status(204).send();
+  });
+
+  // ------------------------------------------------------------- Export
+  function sendCsv(res: Response, rows: EventRow[]): void {
+    const header = ['id', 'name', 'timestamp', 'user_id', 'session_id', 'properties'];
+    const lines = [header.join(',')];
+    for (const r of rows) {
+      lines.push(
+        [r.id, r.name, r.timestamp, r.user_id ?? '', r.session_id ?? '', r.properties]
+          .map(csvCell)
+          .join(','),
+      );
+    }
+    res.type('text/csv').send(lines.join('\n'));
+  }
+
+  app.get('/export/events', (req: AuthRequest, res) => {
+    const rows = db
+      .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp ASC')
+      .all(req.auth!.tenantId) as EventRow[];
+    if (req.query.format === 'csv') {
+      sendCsv(res, rows);
+      return;
+    }
+    res.json({ events: rows });
+  });
+
+  app.get('/export/dashboards/:id', (req: AuthRequest, res) => {
+    const dash = getDashboard(req.auth!.tenantId, req.params.id);
+    if (!dash) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    if (req.query.format === 'csv') {
+      const header = ['id', 'name', 'owner_id', 'created_at', 'updated_at', 'config'];
+      const row = [dash.id, dash.name, dash.owner_id, dash.created_at, dash.updated_at, dash.config];
+      res.type('text/csv').send([header.join(','), row.map(csvCell).join(',')].join('\n'));
+      return;
+    }
+    res.json({ dashboard: dash });
+  });
+
+  return app;
+}
+
+function csvCell(value: string): string {
+  const s = String(value);
+  if (s.includes(',') || s.includes('"') || s.includes('\n')) {
+    return `"${s.replace(/"/g, '""')}"`;
+  }
+  return s;
+}
