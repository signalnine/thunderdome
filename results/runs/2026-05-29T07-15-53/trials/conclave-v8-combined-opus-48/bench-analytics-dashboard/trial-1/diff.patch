nantId: string,\n  q: QueryFilters & { interval?: string },\n): TimeseriesBucket[] {\n  const where = buildWhere(tenantId, q);\n  const fmt = q.interval === 'hour' ? '%Y-%m-%dT%H:00' : '%Y-%m-%d';\n  const rows = db\n    .prepare(\n      `SELECT strftime('${fmt}', timestamp) AS bucket, COUNT(*) AS count\n       FROM events WHERE ${where.sql}\n       GROUP BY bucket ORDER BY bucket ASC`,\n    )\n    .all(...where.params) as TimeseriesBucket[];\n  return rows;\n}\n\nexport interface BreakdownRow {\n  value: string | null;\n  count: number;\n}\n\nexport function breakdown(\n  db: DB,\n  tenantId: string,\n  q: QueryFilters & { property: string },\n): BreakdownRow[] {\n  const where = buildWhere(tenantId, q);\n  const rows = db\n    .prepare(\n      `SELECT json_extract(properties, ?) AS value, COUNT(*) AS count\n       FROM events WHERE ${where.sql}\n       GROUP BY value ORDER BY count DESC`,\n    )\n    .all(`$.${q.property}`, ...where.params) as BreakdownRow[];\n  return rows;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
