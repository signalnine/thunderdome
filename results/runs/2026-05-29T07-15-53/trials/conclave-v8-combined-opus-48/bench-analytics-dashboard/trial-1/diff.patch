+++ b/tests/api.test.ts
@@ -0,0 +1,420 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import request from 'supertest';
+import type { Express } from 'express';
+import { createApp } from '../src/app.js';
+
+function makeApp(): Express {
+  return createApp({ db: undefined, dbFile: ':memory:' });
+}
+
+async function register(
+  app: Express,
+  email: string,
+  password = 'pw123456',
+  extra: Record<string, unknown> = {},
+): Promise<{ token: string; user: any }> {
+  const res = await request(app)
+    .post('/auth/register')
+    .send({ email, password, ...extra });
+  expect(res.status).toBe(201);
+  return res.body;
+}
+
+const auth = (t: string): [string, string] => ['Authorization', `Bearer ${t}`];
+
+describe('auth / user management', () => {
+  let app: Express;
+  beforeEach(() => {
+    app = makeApp();
+  });
+
+  it('registers a user and returns a token', async () => {
+    const res = await request(app)
+      .post('/auth/register')
+      .send({ email: 'a@x.com', password: 'pw123456' });
+    expect(res.status).toBe(201);
+    expect(res.body.token).toBeTypeOf('string');
+    expect(res.body.user.email).toBe('a@x.com');
+    expect(res.body.user.password_hash).toBeUndefined();
+    expect(res.body.user.tenant_id).toBeTypeOf('string');
+  });
+
+  it('rejects duplicate email with 409', async () => {
+    await register(app, 'dup@x.com');
+    const res = await request(app)
+      .post('/auth/register')
+      .send({ email: 'dup@x.com', password: 'pw123456' });
+    expect(res.status).toBe(409);
+  });
+
+  it('rejects missing fields with 400', async () => {
+    const res = await request(app).post('/auth/register').send({ email: 'x@x.com' });
+    expect(res.status).toBe(400);
+  });
+
+  it('logs in with valid credentials', async () => {
+    await register(app, 'login@x.com', 'secret99');
+    const res = await request(app)
+      .post('/auth/login')
+      .send({ email: 'login@x.com', password: 'secret99' });
+    expect(res.status).toBe(200);
+    expect(res.body.token).toBeTypeOf('string');
+  });
+
+  it('rejects wrong password with 401', async () => {
+    await register(app, 'wp@x.com', 'secret99');
+    const res = await request(app)
+      .post('/auth/login')
+      .send({ email: 'wp@x.com', password: 'nope' });
+    expect(res.status).toBe(401);
+  });
+
+  it('rejects unknown email with 401', async () => {
+    const res = await request(app)
+      .post('/auth/login')
+      .send({ email: 'ghost@x.com', password: 'secret99' });
+    expect(res.status).toBe(401);
+  });
+
+  it('GET /me requires auth', async () => {
+    const res = await request(app).get('/me');
+    expect(res.status).toBe(401);
+  });
+
+  it('GET /me returns own profile', async () => {
+    const { token } = await register(app, 'me@x.com');
+    const res = await request(app).get('/me').set(...auth(token));
+    expect(res.status).toBe(200);
+    expect(res.body.user.email).toBe('me@x.com');
+    expect(res.body.user.password_hash).toBeUndefined();
+  });
+
+  it('rejects malformed JWT with 401', async () => {
+    const res = await request(app).get('/me').set('Authorization', 'Bearer garbage');
+    expect(res.status).toBe(401);
+  });
+
+  it('admin can change role of user in same tenant', async () => {
+    const admin = await register(app, 'admin@x.com', 'pw123456', { tenantId: 'T1', role: 'admin' });
+    const viewer = await register(app, 'viewer@x.com', 'pw123456', { tenantId: 'T1', role: 'viewer' });
+    const res = await request(app)
+      .patch(`/users/${viewer.user.id}/role`)
+      .set(...auth(admin.token))
+      .send({ role: 'editor' });
+    expect(res.status).toBe(200);
+    expect(res.body.user.role).toBe('editor');
+  });
+
+  it('non-admin cannot change roles (403)', async () => {
+    const viewer = await register(app, 'v1@x.com', 'pw123456', { tenantId: 'T1', role: 'viewer' });
+    const other = await register(app, 'v2@x.com', 'pw123456', { tenantId: 'T1', role: 'viewer' });
+    const res = await request(app)
+      .patch(`/users/${other.user.id}/role`)
+      .set(...auth(viewer.token))
+      .send({ role: 'admin' });
+    expect(res.status).toBe(403);
+  });
+
+  it('admin cannot change role of user in another tenant (404)', async () => {
+    const admin = await register(app, 'a1@x.com', 'pw123456', { tenantId: 'T1', role: 'admin' });
+    const other = await register(app, 'o1@x.com', 'pw123456', { tenantId: 'T2', role: 'viewer' });
+    const res = await request(app)
+      .patch(`/users/${other.user.id}/role`)
+      .set(...auth(admin.token))
+      .send({ role: 'editor' });
+    expect(res.status).toBe(404);
+  });
+
