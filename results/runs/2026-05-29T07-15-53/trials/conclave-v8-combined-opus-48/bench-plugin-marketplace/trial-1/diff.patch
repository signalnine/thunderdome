@@ -0,0 +1,79 @@
+import vm from 'node:vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+function isThenable(value: unknown): value is Promise<unknown> {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    typeof (value as { then?: unknown }).then === 'function'
+  );
+}
+
+function raceTimeout<T>(promise: Promise<T>, ms: number): Promise<T> {
+  return new Promise<T>((resolve, reject) => {
+    const timer = setTimeout(() => {
+      reject(new Error(`Execution timed out after ${ms}ms`));
+    }, ms);
+    promise.then(
+      (value) => {
+        clearTimeout(timer);
+        resolve(value);
+      },
+      (err) => {
+        clearTimeout(timer);
+        reject(err);
+      },
+    );
+  });
+}
+
+/**
+ * Executes untrusted plugin code in a Node.js vm context. Supports passing
+ * context variables, enforces both synchronous (vm timeout) and asynchronous
+ * (Promise race) timeouts, and reports structured results.
+ */
+export function createRunner(): RunnerService {
+  async function executeWithTimeout(
+    code: string,
+    timeoutMs: number,
+    context: Record<string, unknown> = {},
+  ): Promise<SandboxResult> {
+    const start = Date.now();
+    const memBefore = process.memoryUsage().heapUsed;
+    const sandbox: Record<string, unknown> = { ...context };
+    const vmContext = vm.createContext(sandbox);
+
+    try {
+      const script = new vm.Script(code);
+      let output: unknown = script.runInContext(vmContext, { timeout: timeoutMs });
+      if (isThenable(output)) {
+        output = await raceTimeout(output, timeoutMs);
+      }
+      return {
+        success: true,
+        output,
+        duration: Date.now() - start,
+        memoryUsed: Math.max(0, process.memoryUsage().heapUsed - memBefore),
+      };
+    } catch (err) {
+      return {
+        success: false,
+        output: undefined,
+        duration: Date.now() - start,
+        memoryUsed: Math.max(0, process.memoryUsage().heapUsed - memBefore),
+        error: err instanceof Error ? err.message : String(err),
+      };
+    }
+  }
+
+  function execute(
+    code: string,
+    context?: Record<string, unknown>,
+  ): Promise<SandboxResult> {
+    return executeWithTimeout(code, DEFAULT_TIMEOUT_MS, context);
+  }
+
+  return { execute, executeWithTimeout };
+}
