index 0000000..d711685
--- /dev/null
+++ b/src/registry/index.ts
@@ -0,0 +1,83 @@
+import semver from 'semver';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+/**
+ * In-memory catalog of plugin manifests keyed by name then version.
+ * A single plugin name may hold many concurrently-registered versions.
+ */
+export function createRegistry(): RegistryService {
+  const store = new Map<string, Map<string, PluginManifest>>();
+
+  function register(manifest: PluginManifest): void {
+    if (!manifest.name || !manifest.version) {
+      throw new Error('Manifest must have a name and version');
+    }
+    let versions = store.get(manifest.name);
+    if (!versions) {
+      versions = new Map<string, PluginManifest>();
+      store.set(manifest.name, versions);
+    }
+    versions.set(manifest.version, { ...manifest });
+  }
+
+  function getVersion(name: string, version: string): PluginManifest | null {
+    return store.get(name)?.get(version) ?? null;
+  }
+
+  function listVersions(name: string): string[] {
+    const versions = store.get(name);
+    if (!versions) return [];
+    return [...versions.keys()].sort((a, b) => {
+      const va = semver.valid(semver.coerce(a));
+      const vb = semver.valid(semver.coerce(b));
+      if (va && vb) return semver.compare(va, vb);
+      return a.localeCompare(b);
+    });
+  }
+
+  function get(name: string): PluginManifest | null {
+    const versions = listVersions(name);
+    if (versions.length === 0) return null;
+    return getVersion(name, versions[versions.length - 1]);
+  }
+
+  function list(): PluginManifest[] {
+    const all: PluginManifest[] = [];
+    for (const versions of store.values()) {
+      for (const manifest of versions.values()) {
+        all.push(manifest);
+      }
+    }
+    return all;
+  }
+
+  function search(query: string): PluginManifest[] {
+    const q = query.toLowerCase();
+    return list().filter(
+      (m) =>
+        m.name.toLowerCase().includes(q) ||
+        m.description.toLowerCase().includes(q) ||
+        m.author.toLowerCase().includes(q),
+    );
+  }
+
+  function remove(name: string, version: string): boolean {
+    const versions = store.get(name);
+    if (!versions || !versions.has(version)) return false;
+    versions.delete(version);
+    if (versions.size === 0) store.delete(name);
+    return true;
+  }
+
+  function update(name: string, version: string, updates: Partial<PluginManifest>): void {
+    const existing = getVersion(name, version);
+    if (!existing) {
+      throw new Error(`Plugin ${name}@${version} is not registered`);
+    }
+    // name/version remain the identity key and cannot be mutated here.
+    const merged: PluginManifest = { ...existing, ...updates, name, version };
+    store.get(name)!.set(version, merged);
+  }
+
+  return { register, get, getVersion, list, search, remove, listVersions, update };
+}
