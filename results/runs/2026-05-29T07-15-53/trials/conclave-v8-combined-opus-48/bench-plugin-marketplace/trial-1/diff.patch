index 0000000..33672a4
--- /dev/null
+++ b/src/resolver/index.ts
@@ -0,0 +1,37 @@
+import semver from 'semver';
+import type { ResolvedVersion, ResolverService, VersionConstraint } from '../types.js';
+
+/**
+ * Semver-backed constraint resolution. Picks the highest available version
+ * that satisfies each requested range.
+ */
+export function createResolver(): ResolverService {
+  function satisfies(version: string, range: string): boolean {
+    return semver.satisfies(version, range);
+  }
+
+  function maxSatisfying(versions: string[], range: string): string | null {
+    return semver.maxSatisfying(versions, range);
+  }
+
+  function validRange(range: string): boolean {
+    return semver.validRange(range) !== null;
+  }
+
+  function resolve(
+    constraints: VersionConstraint[],
+    available: Record<string, string[]>,
+  ): ResolvedVersion[] {
+    const resolved: ResolvedVersion[] = [];
+    for (const constraint of constraints) {
+      const versions = available[constraint.name] ?? [];
+      const best = semver.maxSatisfying(versions, constraint.range);
+      if (best !== null) {
+        resolved.push({ name: constraint.name, version: best, satisfies: constraint.range });
+      }
+    }
+    return resolved;
+  }
+
+  return { resolve, satisfies, maxSatisfying, validRange };
+}
diff --git a/src/reviews/index.ts b/src/reviews/index.ts
new file mode 100644
index 0000000..e6d501e
--- /dev/null
+++ b/src/reviews/index.ts
@@ -0,0 +1,136 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+function rowToReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged !== 0,
+    createdAt: row.createdAt,
+  };
+}
+
+/**
+ * Review store backed by better-sqlite3 (in-memory by default). Flagged
+ * reviews are excluded from average-rating computations.
+ */
+export function createReviewSystem(dbPath = ':memory:'): ReviewService {
+  const db = new Database(dbPath);
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT NOT NULL,
+      flagged INTEGER NOT NULL DEFAULT 0,
+      createdAt TEXT NOT NULL
+    )
+  `);
+
+  function addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+    if (!Number.isInteger(review.rating) || review.rating < 1 || review.rating > 5) {
+      throw new Error('rating must be an integer between 1 and 5');
+    }
+    const createdAt = new Date().toISOString();
+    const info = db
+      .prepare(
+        `INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+         VALUES (?, ?, ?, ?, ?, 0, ?)`,
+      )
+      .run(
+        review.pluginName,
+        review.pluginVersion,
+        review.userId,
+        review.rating,
+        review.comment,
+        createdAt,
+      );
+    return {
+      id: Number(info.lastInsertRowid),
+      pluginName: review.pluginName,
+      pluginVersion: review.pluginVersion,
+      userId: review.userId,
+      rating: review.rating,
+      comment: review.comment,
+      flagged: false,
+      createdAt,
+    };
+  }
+
+  function getReviews(pluginName: string): Review[] {
+    const rows = db
+      .prepare(`SELECT * FROM reviews WHERE pluginName = ? ORDER BY id`)
+      .all(pluginName) as ReviewRow[];
+    return rows.map(rowToReview);
+  }
+
+  function getAverageRating(pluginName: string): number {
+    const row = db
+      .prepare(
+        `SELECT AVG(rating) AS avg FROM reviews WHERE pluginName = ? AND flagged = 0`,
+      )
+      .get(pluginName) as { avg: number | null };
+    return row.avg ?? 0;
+  }
+
+  function flagReview(reviewId: number): void {
+    const info = db.prepare(`UPDATE reviews SET flagged = 1 WHERE id = ?`).run(reviewId);
+    if (info.changes === 0) {
+      throw new Error(`Review ${reviewId} not found`);
+    }
+  }
+
+  function getFlaggedReviews(): Review[] {
+    const rows = db
+      .prepare(`SELECT * FROM reviews WHERE flagged = 1 ORDER BY id`)
+      .all() as ReviewRow[];
+    return rows.map(rowToReview);
+  }
+
+  function removeReview(reviewId: number): boolean {
+    const info = db.prepare(`DELETE FROM reviews WHERE id = ?`).run(reviewId);
+    return info.changes > 0;
+  }
+
+  function getReviewsByUser(userId: string): Review[] {
+    const rows = db
+      .prepare(`SELECT * FROM reviews WHERE userId = ? ORDER BY id`)
+      .all(userId) as ReviewRow[];
+    return rows.map(rowToReview);
+  }
+
+  function getReviewCount(pluginName: string): number {
+    const row = db
+      .prepare(`SELECT COUNT(*) AS count FROM reviews WHERE pluginName = ?`)
+      .get(pluginName) as { count: number };
+    return row.count;
+  }
+
+  return {
+    addReview,
+    getReviews,
+    getAverageRating,
+    flagReview,
+    getFlaggedReviews,
+    removeReview,
+    getReviewsByUser,
+    getReviewCount,
+  };
+}
