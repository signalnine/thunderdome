);\n    expect(r.search('log').map((m) => m.name).sort()).toEqual(['alpha', 'beta']);\n    expect(r.search('ALPHA')).toHaveLength(1);\n    expect(r.search('zzz')).toHaveLength(0);\n  });\n\n  it('removes a specific version', () => {\n    const r = createRegistry();\n    r.register(manifest({ version: '1.0.0' }));\n    r.register(manifest({ version: '2.0.0' }));\n    expect(r.remove('plugin-a', '1.0.0')).toBe(true);\n    expect(r.remove('plugin-a', '1.0.0')).toBe(false);\n    expect(r.listVersions('plugin-a')).toEqual(['2.0.0']);\n  });\n\n  it('updates fields without changing identity', () => {\n    const r = createRegistry();\n    r.register(manifest());\n    r.update('plugin-a', '1.0.0', { description: 'updated' });\n    expect(r.getVersion('plugin-a', '1.0.0')?.description).toBe('updated');\n    expect(() => r.update('nope', '1.0.0', {})).toThrow();\n  });\n});\n\ndescribe('resolver', () => {\n  const resolver = createResolver();\n\n  it('satisfies / maxSatisfying / validRange', () => {\n    expect(resolver.satisfies('1.2.3', '^1.0.0')).toBe(true);\n    expect(resolver.satisfies('2.0.0', '^1.0.0')).toBe(false);\n    expect(resolver.maxSatisfying(['1.0.0', '1.4.0', '2.0.0'], '^1.0.0')).toBe('1.4.0');\n    expect(resolver.maxSatisfying(['2.0.0'], '^1.0.0')).toBeNull();\n    expect(resolver.validRange('^1.0.0')).toBe(true);\n    expect(resolver.validRange('not-a-range')).toBe(false);\n  });\n\n  it('resolves constraints against available versions', () => {\n    const resolved = resolver.resolve(\n      [\n        { name: 'dep-a', range: '^1.0.0' },\n        { name: 'dep-b', range: '>=2.0.0' },\n        { name: 'dep-c', range: '^5.0.0' },\n      ],\n      {\n        'dep-a': ['1.0.0', '1.2.0'],\n        'dep-b': ['2.1.0', '3.0.0'],\n        'dep-c': ['1.0.0'],\n      },\n    );\n    expect(resolved).toEqual([\n      { name: 'dep-a', version: '1.2.0', satisfies: '^1.0.0' },\n      { name: 'dep-b', version: '3.0.0', satisfies: '>=2.0.0' },\n    ]);\n  });\n});\n\ndescribe('runner', () => {\n  const runner = createRunner();\n\n  it('executes code and returns output', async () => {\n    const result = await runner.execute('40 + 2');\n    expect(result.success).toBe(true);\n    expect(result.output).toBe(42);\n    expect(typeof result.duration).toBe('number');\n    expect(typeof result.memoryUsed).toBe('number');\n  });\n\n  it('exposes context variables', async () => {\n    const result = await runner.execute('x * y', { x: 6, y: 7 });\n    expect(result.output).toBe(42);\n  });\n\n  it('captures thrown errors', async () => {\n    const result = await runner.execute('throw new Error(\"boom\")');\n    expect(result.success).toBe(false);\n    expect(result.error).toContain('boom');\n  });\n\n  it('enforces a timeout on runaway sync code', async () => {\n    const result = await runner.executeWithTimeout('while (true) {}', 50);\n    expect(result.success).toBe(false);\n    expect(result.error).toBeDefined();\n  });\n\n  it('cannot access host globals like process', async () => {\n    const result = await runner.execute('typeof process');\n    expect(result.output).toBe('undefined');\n  });\n});\n\ndescribe('reviews', () => {\n  it('adds, queries, averages excluding flagged', () => {\n    const reviews = createReviewSystem();\n    const a = reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'great' });\n    reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u2', rating: 1, comment: 'spam' });\n    reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u1', rating: 3, comment: 'ok' });\n\n    expect(a.id).toBeGreaterThan(0);\n    expect(a.flagged).toBe(false);\n    expect(a.createdAt).toBeTruthy();\n    expect(reviews.getReviews('p')).toHaveLength(3);\n    expect(reviews.getReviewsByUser('u1')).toHaveLength(2);\n    expect(reviews.getReviewCount('p')).toBe(3);\n    expect(reviews.getAverageRating('p')).toBeCloseTo(3);\n\n    // flag the 1-star spam review (id 2)\n    reviews.flagReview(2);\n    expect(reviews.getFlaggedReviews()).toHaveLength(1);\n    expect(reviews.getAverageRating('p')).toBeCloseTo(4); // (5 + 3) / 2\n  });\n\n  it('removes reviews and rejects invalid ratings', () => {\n    const reviews = createReviewSystem();\n    const r = reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u', rating: 4, comment: 'x' });\n    expect(reviews.removeReview(r.id)).toBe(true);\n    expect(reviews.removeReview(r.id)).toBe(false);\n    expect(reviews.getAverageRating('p')).toBe(0);\n    expect(() => reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u', rating: 6, comment: 'x' })).toThrow();\n  });\n});\n\ndescribe('deps', () => {\n  function setup() {\n    const r = createRegistry();\n    r.register(manifest({ name: 'app', dependencies: { lib: '^1.0.0', util: '^1.0.0' } }));\n    r.register(manifest({ name: 'lib', dependencies: { util: '^1.0.0' } }));\n    r.register(manifest({ name: 'util', dependencies: {} }));\n    return r;\n  }\n\n  it('builds a dependency tree', () => {\n    const deps = createDepsService();\n    const tree = deps.buildTree('app', setup());\n    expect(tree.name).toBe('app');\n    expect(tree.dependencies.map((d) => d.name).sort()).toEqual(['lib', 'util']);\n  });\n\n  it('flattens transitive deps uniquely', () => {\n    const deps = createDepsService();\n    expect(deps.flattenDependencies('app', setup()).sort()).toEqual(['lib', 'util']);\n  });\n\n  it('topological sort places deps before dependents', () => {\n    const deps = createDepsService();\n    const order = deps.topologicalSort('app', setup());\n    expect(order.indexOf('util')).toBeLessThan(order.indexOf('lib'));\n    expect(order.indexOf('lib')).toBeLessThan(order.indexOf('app'));\n    expect(order[order.length - 1]).toBe('app');\n  });\n\n  it('detects circular dependencies', () => {\n    const r = createRegistry();\n    r.register(manifest({ name: 'a', dependencies: { b: '^1.0.0' } }));\n    r.register(manifest({ name: 'b', dependencies: { a: '^1.0.0' } }));\n    const deps = createDepsService();\n    expect(deps.hasCircularDependency('a', r)).toBe(true);\n    expect(deps.detectCycles('a', r)).not.toBeNull();\n    expect(deps.hasCircularDependency('a', setup())).toBe(false);\n    expect(deps.detectCycles('app', setup())).toBeNull();\n  });\n});\n\ndescribe('marketplace integration', () => {\n  it('installs a plugin and returns resolved deps + execution', async () => {\n    const m = createMarketplace();\n    m.registry.register(manifest({ name: 'dep', version: '1.4.0' }));\n    const result = await m.installPlugin(\n      manifest({\n        name: 'app',\n        version: '1.0.0',\n        entryPoint: 'ctx.value + 1',\n        dependencies: { dep: '^1.0.0' },\n      }),\n      { ctx: { value: 41 } },\n    );\n    expect(result.execution.success).toBe(true);\n    expect(result.execution.output).toBe(42);\n    expect(result.resolved).toEqual([{ name: 'dep', version: '1.4.0', satisfies: '^1.0.0' }]);\n    expect(m.registry.get('app')?.version).toBe('1.0.0');\n  });\n\n  it('rejects invalid manifests', async () => {\n    const m = createMarketplace();\n    await expect(\n      m.installPlugin({ ...manifest(), entryPoint: '' }),\n    ).rejects.toThrow(/entryPoint/);\n  });\n\n  it('rejects circular dependencies', async () => {\n    const m = createMarketplace();\n    m.registry.register(manifest({ name: 'b', dependencies: { a: '^1.0.0' } }));\n    await expect(\n      m.installPlugin(manifest({ name: 'a', dependencies: { b: '^1.0.0' } })),\n    ).rejects.toThrow(/[Cc]ircular/);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":1246,"cache_read_input_tokens":40739,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1246},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_manage