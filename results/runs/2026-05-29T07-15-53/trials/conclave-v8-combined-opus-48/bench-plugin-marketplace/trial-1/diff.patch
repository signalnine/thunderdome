index 0000000..7a3664c
--- /dev/null
+++ b/src/deps/index.ts
@@ -0,0 +1,116 @@
+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+/**
+ * Dependency-graph analysis built on top of a registry. Resolves each
+ * dependency name to its latest registered version via registry.get().
+ */
+export function createDepsService(): DepsService {
+  function buildTree(
+    name: string,
+    registry: RegistryService,
+    path: Set<string> = new Set(),
+  ): DependencyNode {
+    const manifest = registry.get(name);
+    const node: DependencyNode = {
+      name,
+      version: manifest?.version ?? '',
+      dependencies: [],
+    };
+    // Stop descending if the manifest is unknown or we are revisiting a node
+    // already on the current path (cycle guard).
+    if (!manifest || path.has(name)) {
+      return node;
+    }
+    const nextPath = new Set(path);
+    nextPath.add(name);
+    for (const depName of Object.keys(manifest.dependencies)) {
+      node.dependencies.push(buildTree(depName, registry, nextPath));
+    }
+    return node;
+  }
+
+  function detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const cycles: string[][] = [];
+    const visited = new Set<string>();
+    const stack: string[] = [];
+    const inStack = new Set<string>();
+
+    function dfs(n: string): void {
+      if (inStack.has(n)) {
+        const idx = stack.indexOf(n);
+        cycles.push([...stack.slice(idx), n]);
+        return;
+      }
+      if (visited.has(n)) return;
+      visited.add(n);
+      inStack.add(n);
+      stack.push(n);
+      const manifest = registry.get(n);
+      if (manifest) {
+        for (const depName of Object.keys(manifest.dependencies)) {
+          dfs(depName);
+        }
+      }
+      stack.pop();
+      inStack.delete(n);
+    }
+
+    dfs(name);
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  function hasCircularDependency(name: string, registry: RegistryService): boolean {
+    return detectCycles(name, registry) !== null;
+  }
+
+  function topologicalSort(name: string, registry: RegistryService): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>();
+    const inStack = new Set<string>();
+
+    function dfs(n: string): void {
+      if (visited.has(n) || inStack.has(n)) return;
+      inStack.add(n);
+      const manifest = registry.get(n);
+      if (manifest) {
+        for (const depName of Object.keys(manifest.dependencies)) {
+          dfs(depName);
+        }
+      }
+      inStack.delete(n);
+      visited.add(n);
+      result.push(n);
+    }
+
+    dfs(name);
+    return result;
+  }
+
+  function flattenDependencies(name: string, registry: RegistryService): string[] {
+    const result: string[] = [];
+    const seen = new Set<string>();
+
+    function dfs(n: string): void {
+      const manifest = registry.get(n);
+      if (!manifest) return;
+      for (const depName of Object.keys(manifest.dependencies)) {
+        if (!seen.has(depName)) {
+          seen.add(depName);
+          result.push(depName);
+          dfs(depName);
+        }
+      }
+    }
+
+    dfs(name);
+    return result;
+  }
+
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency,
+  };
+}
diff --git a/src/index.ts b/src/index.ts
