index 0000000..6a3cbe9
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,93 @@
+import { createRegistry } from './registry/index.js';
+import { createResolver } from './resolver/index.js';
+import { createRunner } from './runner/index.js';
+import { createReviewSystem } from './reviews/index.js';
+import { createDepsService } from './deps/index.js';
+import type {
+  DepsService,
+  PluginManifest,
+  RegistryService,
+  ResolvedVersion,
+  ResolverService,
+  ReviewService,
+  RunnerService,
+  SandboxResult,
+} from './types.js';
+
+export { createRegistry } from './registry/index.js';
+export { createResolver } from './resolver/index.js';
+export { createRunner } from './runner/index.js';
+export { createReviewSystem } from './reviews/index.js';
+export { createDepsService } from './deps/index.js';
+
+export interface MarketplaceOptions {
+  /** Path for the review database; defaults to an in-memory database. */
+  dbPath?: string;
+}
+
+export interface InstallResult {
+  manifest: PluginManifest;
+  resolved: ResolvedVersion[];
+  execution: SandboxResult;
+}
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(
+    manifest: PluginManifest,
+    context?: Record<string, unknown>,
+  ): Promise<InstallResult>;
+}
+
+/**
+ * Composes the five marketplace capabilities and exposes a high-level
+ * installation workflow.
+ */
+export function createMarketplace(options: MarketplaceOptions = {}): Marketplace {
+  const registry = createRegistry();
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviewSystem(options.dbPath);
+  const deps = createDepsService();
+
+  async function installPlugin(
+    manifest: PluginManifest,
+    context: Record<string, unknown> = {},
+  ): Promise<InstallResult> {
+    // 1. Validate required fields.
+    if (!manifest || !manifest.name || !manifest.version || !manifest.entryPoint) {
+      throw new Error(
+        'Invalid manifest: name, version, and entryPoint are required',
+      );
+    }
+
+    // 2. Register the plugin in the catalog.
+    registry.register(manifest);
+
+    // 3. Resolve dependency versions against what is available in the registry.
+    const constraints = Object.entries(manifest.dependencies ?? {}).map(
+      ([name, range]) => ({ name, range }),
+    );
+    const available: Record<string, string[]> = {};
+    for (const constraint of constraints) {
+      available[constraint.name] = registry.listVersions(constraint.name);
+    }
+    const resolved = resolver.resolve(constraints, available);
+
+    // 4. Reject circular dependency graphs.
+    if (deps.hasCircularDependency(manifest.name, registry)) {
+      throw new Error(`Circular dependency detected for ${manifest.name}`);
+    }
+
+    // 5. Execute the plugin's entry point in the sandbox.
+    const execution = await runner.execute(manifest.entryPoint, context);
+
+    return { manifest, resolved, execution };
+  }
+
+  return { registry, resolver, runner, reviews, deps, installPlugin };
+}
