der.indexOf('app'));\n    expect(order[order.length - 1]).toBe('app');\n  });\n\n  it('detects circular dependencies', () => {\n    const r = createRegistry();\n    r.register(manifest({ name: 'a', dependencies: { b: '^1.0.0' } }));\n    r.register(manifest({ name: 'b', dependencies: { a: '^1.0.0' } }));\n    const deps = createDepsService();\n    expect(deps.hasCircularDependency('a', r)).toBe(true);\n    expect(deps.detectCycles('a', r)).not.toBeNull();\n    expect(deps.hasCircularDependency('a', setup())).toBe(false);\n    expect(deps.detectCycles('app', setup())).toBeNull();\n  });\n});\n\ndescribe('marketplace integration', () => {\n  it('installs a plugin and returns resolved deps + execution', async () => {\n    const m = createMarketplace();\n    m.registry.register(manifest({ name: 'dep', version: '1.4.0' }));\n    const result = await m.installPlugin(\n      manifest({\n        name: 'app',\n        version: '1.0.0',\n        entryPoint: 'ctx.value + 1',\n        dependencies: { dep: '^1.0.0' },\n      }),\n      { ctx: { value: 41 } },\n    );\n    expect(result.execution.success).toBe(true);\n    expect(result.execution.output).toBe(42);\n    expect(result.resolved).toEqual([{ name: 'dep', version: '1.4.0', satisfies: '^1.0.0' }]);\n    expect(m.registry.get('app')?.version).toBe('1.0.0');\n  });\n\n  it('rejects invalid manifests', async () => {\n    const m = createMarketplace();\n    await expect(\n      m.installPlugin({ ...manifest(), entryPoint: '' }),\n    ).rejects.toThrow(/entryPoint/);\n  });\n\n  it('rejects circular dependencies', async () => {\n    const m = createMarketplace();\n    m.registry.register(manifest({ name: 'b', dependencies: { a: '^1.0.0' } }));\n    await expect(\n      m.installPlugin(manifest({ name: 'a', dependencies: { b: '^1.0.0' } })),\n    ).rejects.toThrow(/[Cc]ircular/);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
