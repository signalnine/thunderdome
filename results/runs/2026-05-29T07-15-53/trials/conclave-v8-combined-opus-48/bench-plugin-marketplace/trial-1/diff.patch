 it('lists and searches', () => {\n    const r = createRegistry();\n    r.register(manifest({ name: 'alpha', description: 'logging tool' }));\n    r.register(manifest({ name: 'beta', author: 'logwriter' }));\n    expect(r.list()).toHaveLength(2);\n    expect(r.search('log').map((m) => m.name).sort()).toEqual(['alpha', 'beta']);\n    expect(r.search('ALPHA')).toHaveLength(1);\n    expect(r.search('zzz')).toHaveLength(0);\n  });\n\n  it('removes a specific version', () => {\n    const r = createRegistry();\n    r.register(manifest({ version: '1.0.0' }));\n    r.register(manifest({ version: '2.0.0' }));\n    expect(r.remove('plugin-a', '1.0.0')).toBe(true);\n    expect(r.remove('plugin-a', '1.0.0')).toBe(false);\n    expect(r.listVersions('plugin-a')).toEqual(['2.0.0']);\n  });\n\n  it('updates fields without changing identity', () => {\n    const r = createRegistry();\n    r.register(manifest());\n    r.update('plugin-a', '1.0.0', { description: 'updated' });\n    expect(r.getVersion('plugin-a', '1.0.0')?.description).toBe('updated');\n    expect(() => r.update('nope', '1.0.0', {})).toThrow();\n  });\n});\n\ndescribe('resolver', () => {\n  const resolver = createResolver();\n\n  it('satisfies / maxSatisfying / validRange', () => {\n    expect(resolver.satisfies('1.2.3', '^1.0.0')).toBe(true);\n    expect(resolver.satisfies('2.0.0', '^1.0.0')).toBe(false);\n    expect(resolver.maxSatisfying(['1.0.0', '1.4.0', '2.0.0'], '^1.0.0')).toBe('1.4.0');\n    expect(resolver.maxSatisfying(['2.0.0'], '^1.0.0')).toBeNull();\n    expect(resolver.validRange('^1.0.0')).toBe(true);\n    expect(resolver.validRange('not-a-range')).toBe(false);\n  });\n\n  it('resolves constraints against available versions', () => {\n    const resolved = resolver.resolve(\n      [\n        { name: 'dep-a', range: '^1.0.0' },\n        { name: 'dep-b', range: '>=2.0.0' },\n        { name: 'dep-c', range: '^5.0.0' },\n      ],\n      {\n        'dep-a': ['1.0.0', '1.2.0'],\n        'dep-b': ['2.1.0', '3.0.