t;\n  }\n\n  return {\n    addReview,\n    getReviews,\n    getAverageRating,\n    flagReview,\n    getFlaggedReviews,\n    removeReview,\n    getReviewsByUser,\n    getReviewCount,\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":461,"cache_read_input_tokens":26572,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":461},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8d23fdb8-0940-40df-87f1-37c049210cd3","uuid":"3eb1b47d-7140-4d47-9428-e703a756be8f","request_id":"req_011CbWVVoRA21Wjka9yoWcEp"}
