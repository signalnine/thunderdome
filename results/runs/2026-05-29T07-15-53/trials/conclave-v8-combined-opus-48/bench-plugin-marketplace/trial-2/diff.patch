+
+  it('replaces an existing (name,version)', () => {
+    const r = new Registry();
+    r.register(manifest({ version: '1.0.0', description: 'old' }));
+    r.register(manifest({ version: '1.0.0', description: 'new' }));
+    expect(r.listVersions('a')).toEqual(['1.0.0']);
+    expect(r.getVersion('a', '1.0.0')?.description).toBe('new');
+  });
+
+  it('get returns the latest semver version', () => {
+    const r = new Registry();
+    r.register(manifest({ version: '1.0.0' }));
+    r.register(manifest({ version: '1.5.0' }));
+    r.register(manifest({ version: '1.2.0' }));
+    expect(r.get('a')?.version).toBe('1.5.0');
+  });
+
+  it('get returns null when absent', () => {
+    expect(new Registry().get('nope')).toBeNull();
+  });
+
+  it('getVersion returns exact or null', () => {
+    const r = new Registry();
+    r.register(manifest({ version: '1.0.0' }));
+    expect(r.getVersion('a', '1.0.0')?.version).toBe('1.0.0');
+    expect(r.getVersion('a', '9.9.9')).toBeNull();
+  });
+
+  it('list returns all manifests', () => {
+    const r = new Registry();
+    r.register(manifest({ name: 'a', version: '1.0.0' }));
+    r.register(manifest({ name: 'b', version: '1.0.0' }));
+    expect(r.list()).toHaveLength(2);
+  });
+
+  it('search matches name, description, author case-insensitively', () => {
+    const r = new Registry();
+    r.register(manifest({ name: 'cool-plugin', description: 'd', author: 'bob' }));
+    r.register(manifest({ name: 'other', version: '2.0.0', description: 'COOL stuff', author: 'x' }));
+    expect(r.search('cool')).toHaveLength(2);
+    expect(r.search('BOB')).toHaveLength(1);
+    expect(r.search('zzz')).toHaveLength(0);
+  });
+
+  it('remove deletes a version and drops the name when empty', () => {
+    const r = new Registry();
+    r.register(manifest({ version: '1.0.0' }));
