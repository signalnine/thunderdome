@@ -0,0 +1,80 @@
+import { Registry } from './registry/index.js';
+import { Resolver } from './resolver/index.js';
+import { Runner } from './runner/index.js';
+import { Reviews } from './reviews/index.js';
+import { Deps } from './deps/index.js';
+import type {
+  DepsService,
+  PluginManifest,
+  RegistryService,
+  ResolvedVersion,
+  ResolverService,
+  ReviewService,
+  RunnerService,
+  SandboxResult,
+} from './types.js';
+
+export { Registry } from './registry/index.js';
+export { Resolver } from './resolver/index.js';
+export { Runner } from './runner/index.js';
+export { Reviews } from './reviews/index.js';
+export { Deps } from './deps/index.js';
+export type * from './types.js';
+
+export interface InstallResult {
+  resolved: ResolvedVersion[];
+  result: SandboxResult;
+}
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest): Promise<InstallResult>;
+}
+
+/**
+ * Composes the five marketplace capabilities and exposes a high-level
+ * installPlugin() workflow on top of them.
+ */
+export function createMarketplace(dbFile = ':memory:'): Marketplace {
+  const registry = new Registry();
+  const resolver = new Resolver();
+  const runner = new Runner();
+  const reviews = new Reviews(dbFile);
+  const deps = new Deps();
+
+  async function installPlugin(manifest: PluginManifest): Promise<InstallResult> {
+    // 1. Validate required fields.
+    if (!manifest || !manifest.name || !manifest.version || !manifest.entryPoint) {
+      throw new Error('Invalid manifest: name, version and entryPoint are required');
+    }
+
+    // 2. Register in the catalog.
+    registry.register(manifest);
+
+    // 3. Resolve dependency versions against what the registry has available.
+    const constraints = Object.entries(manifest.dependencies ?? {}).map(
+      ([name, range]) => ({ name, range }),
+    );
+    const available: Record<string, string[]> = {};
+    for (const constraint of constraints) {
+      available[constraint.name] = registry.listVersions(constraint.name);
+    }
+    const resolved = resolver.resolve(constraints, available);
+
+    // 4. Reject installs that introduce a circular dependency.
+    if (deps.hasCircularDependency(manifest.name, registry)) {
+      throw new Error(`Circular dependency detected for plugin "${manifest.name}"`);
+    }
+
+    // 5. Execute the plugin entry point in the sandbox.
+    const result = await runner.execute(manifest.entryPoint);
+
+    return { resolved, result };
+  }
+
+  return { registry, resolver, runner, reviews, deps, installPlugin };
+}
