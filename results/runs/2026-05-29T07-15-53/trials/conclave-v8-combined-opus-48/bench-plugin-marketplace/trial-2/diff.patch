+
+describe('Resolver', () => {
+  const r = new Resolver();
+
+  it('satisfies wraps semver', () => {
+    expect(r.satisfies('1.2.0', '^1.0.0')).toBe(true);
+    expect(r.satisfies('2.0.0', '^1.0.0')).toBe(false);
+  });
+
+  it('maxSatisfying returns best match or null', () => {
+    expect(r.maxSatisfying(['1.0.0', '1.5.0', '2.0.0'], '^1.0.0')).toBe('1.5.0');
+    expect(r.maxSatisfying(['2.0.0'], '^1.0.0')).toBeNull();
+  });
+
+  it('maxSatisfying returns null for invalid range', () => {
+    expect(r.maxSatisfying(['1.0.0'], 'not-a-range')).toBeNull();
+  });
+
+  it('validRange', () => {
+    expect(r.validRange('^1.0.0')).toBe(true);
+    expect(r.validRange('>=1.0.0 <2.0.0')).toBe(true);
+    expect(r.validRange('garbage!!')).toBe(false);
+  });
+
+  it('resolve returns a ResolvedVersion per satisfiable constraint', () => {
+    const resolved = r.resolve(
+      [
+        { name: 'a', range: '^1.0.0' },
+        { name: 'b', range: '~2.1.0' },
+      ],
+      {
+        a: ['1.0.0', '1.4.0', '2.0.0'],
+        b: ['2.1.0', '2.1.5', '2.2.0'],
+      },
+    );
+    expect(resolved).toEqual([
+      { name: 'a', version: '1.4.0', satisfies: '^1.0.0' },
+      { name: 'b', version: '2.1.5', satisfies: '~2.1.0' },
+    ]);
+  });
+
+  it('resolve skips unsatisfiable constraints', () => {
+    const resolved = r.resolve(
+      [
+        { name: 'a', range: '^9.0.0' },
+        { name: 'b', range: '^1.0.0' },
+      ],
+      { a: ['1.0.0'], b: ['1.2.0'] },
+    );
+    expect(resolved).toEqual([{ name: 'b', version: '1.2.0', satisfies: '^1.0.0' }]);
+  });
+
+  it('resolve handles missing availability', () => {
+    expect(r.resolve([{ name: 'x', range: '^1.0.0' }], {})).toEqual([]);
+  });
+});
