+  it('stores multiple versions of the same plugin', () => {
+    const r = new Registry();
+    r.register(manifest({ version: '1.0.0' }));
+    r.register(manifest({ version: '2.0.0' }));
+    expect(r.listVersions('a')).toEqual(['1.0.0', '2.0.0']);
