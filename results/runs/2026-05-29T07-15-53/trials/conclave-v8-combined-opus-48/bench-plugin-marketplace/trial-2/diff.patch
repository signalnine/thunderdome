+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+/**
+ * Persists user reviews in a better-sqlite3 database (in-memory by default).
+ * Flagged reviews are retained but excluded from average-rating calculations.
+ */
+export class Reviews implements ReviewService {
+  private readonly db: Database.Database;
+
+  constructor(filename = ':memory:') {
+    this.db = new Database(filename);
+    this.db.pragma('journal_mode = WAL');
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS reviews (
+        id INTEGER PRIMARY KEY AUTOINCREMENT,
+        pluginName TEXT NOT NULL,
+        pluginVersion TEXT NOT NULL,
+        userId TEXT NOT NULL,
+        rating INTEGER NOT NULL,
+        comment TEXT NOT NULL,
+        flagged INTEGER NOT NULL DEFAULT 0,
+        createdAt TEXT NOT NULL
+      )
+    `);
+  }
+
+  addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+    if (!Number.isInteger(review.rating) || review.rating < 1 || review.rating > 5) {
+      throw new Error('Rating must be an integer between 1 and 5');
+    }
+    const createdAt = new Date().toISOString();
+    const result = this.db
+      .prepare(
+        `INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+         VALUES (?, ?, ?, ?, ?, 0, ?)`,
+      )
+      .run(
+        review.pluginName,
+        review.pluginVersion,
+        review.userId,
+        review.rating,
+        review.comment,
+        createdAt,
+      );
+    return {
+      id: Number(result.lastInsertRowid),
+      pluginName: review.pluginName,
+      pluginVersion: review.pluginVersion,
+      userId: review.userId,
+      rating: review.rating,
+      comment: review.comment,
+      flagged: false,
+      createdAt,
+    };
+  }
+
+  getReviews(pluginName: string): Review[] {
+    const rows = this.db
+      .prepare('SELECT * FROM reviews WHERE pluginName = ? ORDER BY id')
+      .all(pluginName) as ReviewRow[];
+    return rows.map(toReview);
+  }
+
+  getAverageRating(pluginName: string): number {
+    const row = this.db
+      .prepare(
+        `SELECT AVG(rating) AS avg FROM reviews WHERE pluginName = ? AND flagged = 0`,
+      )
+      .get(pluginName) as { avg: number | null };
+    return row.avg ?? 0;
+  }
+
+  flagReview(reviewId: number): void {
+    this.db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?').run(reviewId);
+  }
+
+  getFlaggedReviews(): Review[] {
+    const rows = this.db
+      .prepare('SELECT * FROM reviews WHERE flagged = 1 ORDER BY id')
+      .all() as ReviewRow[];
+    return rows.map(toReview);
+  }
+
+  removeReview(reviewId: number): boolean {
+    const result = this.db.prepare('DELETE FROM reviews WHERE id = ?').run(reviewId);
+    return result.changes > 0;
+  }
+
+  getReviewsByUser(userId: string): Review[] {
+    const rows = this.db
+      .prepare('SELECT * FROM reviews WHERE userId = ? ORDER BY id')
+      .all(userId) as ReviewRow[];
+    return rows.map(toReview);
+  }
+
+  getReviewCount(pluginName: string): number {
+    const row = this.db
+      .prepare('SELECT COUNT(*) AS count FROM reviews WHERE pluginName = ?')
+      .get(pluginName) as { count: number };
+    return row.count;
+  }
+
+  close(): void {
+    this.db.close();
+  }
+}
+
+function toReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged === 1,
+    createdAt: row.createdAt,
+  };
+}
