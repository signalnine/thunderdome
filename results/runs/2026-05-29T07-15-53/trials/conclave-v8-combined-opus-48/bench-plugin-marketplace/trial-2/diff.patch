diff --git a/src/runner/index.ts b/src/runner/index.ts
new file mode 100644
index 0000000..d669a31
--- /dev/null
+++ b/src/runner/index.ts
@@ -0,0 +1,53 @@
+import vm from 'node:vm';
+import { performance } from 'node:perf_hooks';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+/**
+ * Executes arbitrary plugin code strings inside an isolated Node.js `vm`
+ * context. The sandbox only sees the context variables explicitly passed in,
+ * never the host's globals (process, require, etc.).
+ */
+export class Runner implements RunnerService {
+  execute(code: string, context: Record<string, unknown> = {}): Promise<SandboxResult> {
+    return this.executeWithTimeout(code, DEFAULT_TIMEOUT_MS, context);
+  }
+
+  executeWithTimeout(
+    code: string,
+    timeoutMs: number,
+    context: Record<string, unknown> = {},
+  ): Promise<SandboxResult> {
+    const start = performance.now();
+    const memBefore = process.memoryUsage().heapUsed;
+
+    // A fresh object becomes the sandbox global scope. Nothing from the host
+    // closure leaks in besides what the caller provides.
+    const sandbox: Record<string, unknown> = { ...context };
+    const ctx = vm.createContext(sandbox);
+
+    try {
+      const script = new vm.Script(code);
+      const output = script.runInContext(ctx, { timeout: Math.max(1, timeoutMs) });
+      return Promise.resolve({
+        success: true,
+        output,
+        duration: performance.now() - start,
+        memoryUsed: this.memoryDelta(memBefore),
+      });
+    } catch (err) {
+      return Promise.resolve({
+        success: false,
+        output: undefined,
+        duration: performance.now() - start,
+        memoryUsed: this.memoryDelta(memBefore),
+        error: err instanceof Error ? err.message : String(err),
+      });
+    }
+  }
+
+  private memoryDelta(before: number): number {
+    return Math.max(0, process.memoryUsage().heapUsed - before);
+  }
+}
