--- /dev/null
+++ b/src/runner/runner.test.ts
@@ -0,0 +1,47 @@
+import { describe, it, expect } from 'vitest';
+import { Runner } from './index.js';
+
+describe('Runner', () => {
+  const runner = new Runner();
+
+  it('executes code and returns output', async () => {
+    const res = await runner.execute('1 + 2');
+    expect(res.success).toBe(true);
+    expect(res.output).toBe(3);
+    expect(res.duration).toBeGreaterThanOrEqual(0);
+    expect(res.memoryUsed).toBeGreaterThanOrEqual(0);
+    expect(res.error).toBeUndefined();
+  });
+
+  it('passes context variables into the sandbox', async () => {
+    const res = await runner.execute('x * y', { x: 6, y: 7 });
+    expect(res.success).toBe(true);
+    expect(res.output).toBe(42);
+  });
+
+  it('returns failure on throwing code', async () => {
+    const res = await runner.execute('throw new Error("boom")');
+    expect(res.success).toBe(false);
+    expect(res.error).toContain('boom');
+    expect(res.output).toBeUndefined();
+  });
+
+  it('enforces a timeout on runaway code without hanging', async () => {
+    const res = await runner.executeWithTimeout('while (true) {}', 50);
+    expect(res.success).toBe(false);
+    expect(res.error?.toLowerCase()).toContain('timed out');
+  });
+
+  it('isolates the sandbox from host globals', async () => {
+    const proc = await runner.execute('typeof process');
+    expect(proc.output).toBe('undefined');
+    const req = await runner.execute('typeof require');
+    expect(req.output).toBe('undefined');
+  });
+
+  it('does not leak between executions', async () => {
+    await runner.execute('var leaked = 123');
+    const res = await runner.execute('typeof leaked');
+    expect(res.output).toBe('undefined');
+  });
+});
