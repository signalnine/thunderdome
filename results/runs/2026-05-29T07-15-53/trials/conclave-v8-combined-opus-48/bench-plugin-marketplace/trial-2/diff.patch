@@ -0,0 +1,109 @@
+import semver from 'semver';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+/**
+ * In-memory catalog of plugin manifests. A single plugin name may have many
+ * registered versions, stored as name -> (version -> manifest).
+ */
+export class Registry implements RegistryService {
+  private readonly store = new Map<string, Map<string, PluginManifest>>();
+
+  register(manifest: PluginManifest): void {
+    if (!manifest.name || !manifest.version) {
+      throw new Error('Cannot register manifest without a name and version');
+    }
+    let versions = this.store.get(manifest.name);
+    if (!versions) {
+      versions = new Map<string, PluginManifest>();
+      this.store.set(manifest.name, versions);
+    }
+    // Re-registering the same version replaces it.
+    versions.set(manifest.version, { ...manifest });
+  }
+
+  get(name: string): PluginManifest | null {
+    const versions = this.store.get(name);
+    if (!versions || versions.size === 0) {
+      return null;
+    }
+    // Return the highest semver version available.
+    const latest = this.latestVersion([...versions.keys()]);
+    const manifest = latest ? versions.get(latest) : undefined;
+    return manifest ? { ...manifest } : null;
+  }
+
+  getVersion(name: string, version: string): PluginManifest | null {
+    const manifest = this.store.get(name)?.get(version);
+    return manifest ? { ...manifest } : null;
+  }
+
+  list(): PluginManifest[] {
+    const result: PluginManifest[] = [];
+    for (const versions of this.store.values()) {
+      for (const manifest of versions.values()) {
+        result.push({ ...manifest });
+      }
+    }
+    return result;
+  }
+
+  search(query: string): PluginManifest[] {
+    const needle = query.toLowerCase();
+    return this.list().filter((m) =>
+      m.name.toLowerCase().includes(needle) ||
+      m.description.toLowerCase().includes(needle) ||
+      m.author.toLowerCase().includes(needle),
+    );
+  }
+
+  remove(name: string, version: string): boolean {
+    const versions = this.store.get(name);
+    if (!versions || !versions.has(version)) {
+      return false;
+    }
+    versions.delete(version);
+    // Drop the name entirely once its last version is gone.
+    if (versions.size === 0) {
+      this.store.delete(name);
+    }
+    return true;
+  }
+
+  listVersions(name: string): string[] {
+    const versions = this.store.get(name);
+    if (!versions) {
+      return [];
+    }
+    return [...versions.keys()].sort((a, b) => {
+      const cmp = semver.compare(this.coerce(a), this.coerce(b));
+      return cmp;
+    });
+  }
+
+  update(name: string, version: string, updates: Partial<PluginManifest>): void {
+    const versions = this.store.get(name);
+    const existing = versions?.get(version);
+    if (!versions || !existing) {
+      return;
+    }
+    const merged: PluginManifest = { ...existing, ...updates };
+    // Keep the identity stable: name/version are not relocated by update.
+    merged.name = existing.name;
+    merged.version = existing.version;
+    versions.set(version, merged);
+  }
+
+  private latestVersion(versions: string[]): string | null {
+    let latest: string | null = null;
+    for (const v of versions) {
+      if (latest === null || semver.gt(this.coerce(v), this.coerce(latest))) {
+        latest = v;
+      }
+    }
+    return latest;
+  }
+
+  private coerce(version: string): string {
+    return semver.valid(version) ?? semver.coerce(version)?.version ?? '0.0.0';
+  }
+}
