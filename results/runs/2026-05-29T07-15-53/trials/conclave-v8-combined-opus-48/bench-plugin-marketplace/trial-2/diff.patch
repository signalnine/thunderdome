toHaveLength(1);\n    expect(flagged[0].flagged).toBe(true);\n  });\n\n  it('removeReview returns true/false', () => {\n    const r = new Reviews();\n    const rev = r.addReview(review());\n    expect(r.removeReview(rev.id)).toBe(true);\n    expect(r.removeReview(rev.id)).toBe(false);\n  });\n\n  it('getReviewsByUser filters by user', () => {\n    const r = new Reviews();\n    r.addReview(review({ userId: 'u1' }));\n    r.addReview(review({ userId: 'u2' }));\n    expect(r.getReviewsByUser('u1')).toHaveLength(1);\n  });\n\n  it('getReviewCount counts reviews for plugin', () => {\n    const r = new Reviews();\n    r.addReview(review({ pluginName: 'a' }));\n    r.addReview(review({ pluginName: 'a' }));\n    expect(r.getReviewCount('a')).toBe(2);\n    expect(r.getReviewCount('b')).toBe(0);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":232,"cache_read_input_tokens":40865,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":232},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ae5bc8fd-a180-46c6-951b-84197a84dbff","uuid":"36977ea1-4870-4cf6-afee-042423ba31d2","request_id":"req_011CbWVhvqDzN3oP6wdPFFFA"}
