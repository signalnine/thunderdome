luginManifest[] {\n    const needle = query.toLowerCase();\n    return this.list().filter((m) =>\n      m.name.toLowerCase().includes(needle) ||\n      m.description.toLowerCase().includes(needle) ||\n      m.author.toLowerCase().includes(needle),\n    );\n  }\n\n  remove(name: string, version: string): boolean {\n    const versions = this.store.get(name);\n    if (!versions || !versions.has(version)) {\n      return false;\n    }\n    versions.delete(version);\n    // Drop the name entirely once its last version is gone.\n    if (versions.size === 0) {\n      this.store.delete(name);\n    }\n    return true;\n  }\n\n  listVersions(name: string): string[] {\n    const versions = this.store.get(name);\n    if (!versions) {\n      return [];\n    }\n    return [...versions.keys()].sort((a, b) => {\n      const cmp = semver.compare(this.coerce(a), this.coerce(b));\n      return cmp;\n    });\n  }\n\n  update(name: string, version: string, updates: Partial<PluginManifest>): void {\n    const versions = this.store.get(name);\n    const existing = versions?.get(version);\n    if (!versions || !existing) {\n      return;\n    }\n    const merged: PluginManifest = { ...existing, ...updates };\n    // Keep the identity stable: name/version are not relocated by update.\n    merged.name = existing.name;\n    merged.version = existing.version;\n    versions.set(version, merged);\n  }\n\n  private latestVersion(versions: string[]): string | null {\n    let latest: string | null = null;\n    for (const v of versions) {\n      if (latest === null || semver.gt(this.coerce(v), this.coerce(latest))) {\n        latest = v;\n      }\n    }\n    return latest;\n  }\n\n  private coerce(version: string): string {\n    return semver.valid(version) ?? semver.coerce(version)?.version ?? '0.0.0';\n  }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":392,"cache_creation_input_tokens":4741,"cache_read_input_tokens":28031,"ca