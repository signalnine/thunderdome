index 0000000..ed1e378
--- /dev/null
+++ b/src/deps/deps.test.ts
@@ -0,0 +1,89 @@
+import { describe, it, expect } from 'vitest';
+import { Deps } from './index.js';
+import { Registry } from '../registry/index.js';
+import type { PluginManifest } from '../types.js';
+
+function m(name: string, deps: Record<string, string>, version = '1.0.0'): PluginManifest {
+  return {
+    name,
+    version,
+    description: '',
+    author: '',
+    dependencies: deps,
+    entryPoint: '1',
+    permissions: [],
+  };
+}
+
+function acyclicRegistry(): Registry {
+  const r = new Registry();
+  // a -> b, c ; b -> d ; c -> d ; d -> (none)
+  r.register(m('a', { b: '^1.0.0', c: '^1.0.0' }));
+  r.register(m('b', { d: '^1.0.0' }));
+  r.register(m('c', { d: '^1.0.0' }));
+  r.register(m('d', {}));
+  return r;
+}
+
+describe('Deps', () => {
+  const deps = new Deps();
+
+  it('buildTree builds a nested tree', () => {
+    const tree = deps.buildTree('a', acyclicRegistry());
+    expect(tree.name).toBe('a');
+    expect(tree.version).toBe('1.0.0');
+    expect(tree.dependencies.map((d) => d.name).sort()).toEqual(['b', 'c']);
+    const b = tree.dependencies.find((d) => d.name === 'b')!;
+    expect(b.dependencies[0].name).toBe('d');
+  });
+
+  it('detectCycles returns null for acyclic graph', () => {
+    expect(deps.detectCycles('a', acyclicRegistry())).toBeNull();
+    expect(deps.hasCircularDependency('a', acyclicRegistry())).toBe(false);
+  });
+
+  it('detectCycles finds a cycle', () => {
+    const r = new Registry();
+    r.register(m('a', { b: '^1.0.0' }));
+    r.register(m('b', { c: '^1.0.0' }));
+    r.register(m('c', { a: '^1.0.0' }));
+    expect(deps.hasCircularDependency('a', r)).toBe(true);
+    const cycles = deps.detectCycles('a', r);
+    expect(cycles).not.toBeNull();
+    expect(cycles!.length).toBeGreaterThanOrEqual(1);
+  });
+
+  it('buildTree terminates on cycles', () => {
+    const r = new Registry();
+    r.register(m('a', { b: '^1.0.0' }));
+    r.register(m('b', { a: '^1.0.0' }));
+    const tree = deps.buildTree('a', r);
+    expect(tree.name).toBe('a');
+    // a -> b -> a(leaf)
+    expect(tree.dependencies[0].name).toBe('b');
+    expect(tree.dependencies[0].dependencies[0].name).toBe('a');
+    expect(tree.dependencies[0].dependencies[0].dependencies).toEqual([]);
+  });
+
+  it('topologicalSort orders dependencies before dependents', () => {
+    const order = deps.topologicalSort('a', acyclicRegistry());
+    const idx = (n: string) => order.indexOf(n);
+    expect(idx('d')).toBeLessThan(idx('b'));
+    expect(idx('d')).toBeLessThan(idx('c'));
+    expect(idx('b')).toBeLessThan(idx('a'));
+    expect(idx('c')).toBeLessThan(idx('a'));
+    expect(order[order.length - 1]).toBe('a');
+  });
+
+  it('flattenDependencies returns unique transitive deps without self', () => {
+    const flat = deps.flattenDependencies('a', acyclicRegistry()).sort();
+    expect(flat).toEqual(['b', 'c', 'd']);
+  });
+
+  it('flatten handles cycles without infinite loop', () => {
+    const r = new Registry();
+    r.register(m('a', { b: '^1.0.0' }));
+    r.register(m('b', { a: '^1.0.0' }));
+    expect(deps.flattenDependencies('a', r)).toEqual(['b']);
+  });
+});
