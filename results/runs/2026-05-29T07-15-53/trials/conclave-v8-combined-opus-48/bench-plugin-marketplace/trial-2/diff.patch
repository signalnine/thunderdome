+++ b/src/deps/index.ts
@@ -0,0 +1,161 @@
+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+/**
+ * Analyzes plugin dependency relationships using a registry as the source of
+ * truth for each plugin's declared dependencies. Plugins are identified by
+ * name; the latest registered version of each name is used.
+ */
+export class Deps implements DepsService {
+  buildTree(name: string, registry: RegistryService): DependencyNode {
+    return this.buildNode(name, registry, new Set<string>());
+  }
+
+  detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const cycles: string[][] = [];
+    const seen = new Set<string>();
+
+    const visit = (current: string, stack: string[], onStack: Set<string>): void => {
+      const manifest = registry.get(current);
+      const deps = manifest ? Object.keys(manifest.dependencies) : [];
+      for (const dep of deps) {
+        if (onStack.has(dep)) {
+          // Found a back-edge: extract the cycle from the stack.
+          const start = stack.indexOf(dep);
+          const cycle = [...stack.slice(start), dep];
+          if (!alreadyRecorded(cycles, cycle)) {
+            cycles.push(cycle);
+          }
+          continue;
+        }
+        const key = `${current}->${dep}`;
+        if (seen.has(key)) {
+          continue;
+        }
+        seen.add(key);
+        stack.push(dep);
+        onStack.add(dep);
+        visit(dep, stack, onStack);
+        stack.pop();
+        onStack.delete(dep);
+      }
+    };
+
+    visit(name, [name], new Set<string>([name]));
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  hasCircularDependency(name: string, registry: RegistryService): boolean {
+    return this.detectCycles(name, registry) !== null;
+  }
+
+  topologicalSort(name: string, registry: RegistryService): string[] {
+    const order: string[] = [];
+    const visited = new Set<string>();
+    const onStack = new Set<string>();
+
+    const visit = (current: string): void => {
+      if (visited.has(current)) {
+        return;
+      }
+      // Guard against cycles so we never recurse forever.
+      if (onStack.has(current)) {
+        return;
+      }
+      onStack.add(current);
+      const manifest = registry.get(current);
+      const deps = manifest ? Object.keys(manifest.dependencies) : [];
+      for (const dep of deps) {
+        visit(dep);
+      }
+      onStack.delete(current);
+      visited.add(current);
+      // Post-order: dependencies are appended before their dependents.
+      order.push(current);
+    };
+
+    visit(name);
+    return order;
+  }
+
+  flattenDependencies(name: string, registry: RegistryService): string[] {
+    const result = new Set<string>();
+    const onStack = new Set<string>([name]);
+
+    const visit = (current: string): void => {
+      const manifest = registry.get(current);
+      const deps = manifest ? Object.keys(manifest.dependencies) : [];
+      for (const dep of deps) {
+        if (onStack.has(dep)) {
+          // cycle edge — record but do not recurse again.
+          result.add(dep);
+          continue;
+        }
+        onStack.add(dep);
+        if (!result.has(dep)) {
+          result.add(dep);
+          visit(dep);
+        }
+        onStack.delete(dep);
+      }
+    };
+
+    visit(name);
+    result.delete(name);
+    return [...result];
+  }
+
+  private buildNode(
+    name: string,
+    registry: RegistryService,
+    path: Set<string>,
+  ): DependencyNode {
+    const manifest = registry.get(name);
+    const node: DependencyNode = {
+      name,
+      version: manifest?.version ?? '',
+      dependencies: [],
+    };
+    if (!manifest) {
+      return node;
+    }
+    // Prevent infinite recursion on circular graphs.
+    const nextPath = new Set(path);
+    nextPath.add(name);
+    for (const depName of Object.keys(manifest.dependencies)) {
+      if (nextPath.has(depName)) {
+        // Cycle: include a leaf node for the back-edge without recursing.
+        const depManifest = registry.get(depName);
+        node.dependencies.push({
+          name: depName,
+          version: depManifest?.version ?? '',
+          dependencies: [],
+        });
+        continue;
+      }
+      node.dependencies.push(this.buildNode(depName, registry, nextPath));
+    }
+    return node;
+  }
+}
+
+function alreadyRecorded(cycles: string[][], candidate: string[]): boolean {
+  const key = normalizeCycle(candidate);
+  return cycles.some((c) => normalizeCycle(c) === key);
+}
+
+/** Normalize a cycle to a rotation-independent canonical string for dedup. */
+function normalizeCycle(cycle: string[]): string {
+  // Drop the duplicated closing node, then rotate to start at the smallest.
+  const nodes = cycle.slice(0, -1);
+  if (nodes.length === 0) {
+    return '';
+  }
+  let minIdx = 0;
+  for (let i = 1; i < nodes.length; i++) {
+    if (nodes[i] < nodes[minIdx]) {
+      minIdx = i;
+    }
+  }
+  const rotated = [...nodes.slice(minIdx), ...nodes.slice(0, minIdx)];
+  return rotated.join('->');
+}
