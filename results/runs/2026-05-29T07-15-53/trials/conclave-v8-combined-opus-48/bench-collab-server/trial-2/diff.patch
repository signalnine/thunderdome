+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { rmSync } from 'node:fs';
+import { WebSocket } from 'ws';
+import { createApp, type CollabApp } from './server.js';
+import { apply, type Op } from './ot.js';
+
+let server: CollabApp;
+let port: number;
+let base: string;
+
+beforeEach(async () => {
+  server = createApp(':memory:');
+  port = await server.start(0);
+  base = `http://127.0.0.1:${port}`;
+});
+
+afterEach(async () => {
+  await server.stop();
+});
+
+async function createDoc(title: string, content = ''): Promise<string> {
+  const res = await fetch(`${base}/api/documents`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ title, content }),
+  });
+  expect(res.status).toBe(201);
+  return (await res.json()).id;
+}
+
+// Minimal WS client that mirrors the server's op stream (pure mirror model).
+class Client {
+  ws: WebSocket;
+  content = '';
+  version = 0;
+  ready: Promise<void>;
+  errors: string[] = [];
+
+  constructor(docId: string) {
+    this.ws = new WebSocket(`ws://127.0.0.1:${port}/ws/documents/${docId}`);
+    this.ready = new Promise((resolve, reject) => {
+      this.ws.on('error', reject);
+      this.ws.on('message', (raw) => {
+        const msg = JSON.parse(raw.toString());
+        if (msg.type === 'sync') {
+          this.content = msg.content;
+          this.version = msg.version;
+          resolve();
+        } else if (msg.type === 'op') {
+          this.content = apply(this.content, msg.op as Op);
+          this.version = msg.version;
+        } else if (msg.type === 'error') {
+          this.errors.push(msg.message);
+        }
+      });
+    });
+  }
+
+  sendOp(op: Op, baseVersion: number): void {
+    this.ws.send(JSON.stringify({ type: 'op', op, baseVersion }));
+  }
+
+  raw(data: string): void {
+    this.ws.send(data);
+  }
+
+  close(): void {
+    this.ws.close();
+  }
+}
+
+function waitFor(fn: () => boolean, timeout = 4000): Promise<void> {
+  return new Promise((resolve, reject) => {
+    const started = Date.now();
+    const tick = () => {
+      if (fn()) return resolve();
+      if (Date.now() - started > timeout) return reject(new Error('timeout'));
+      setTimeout(tick, 10);
+    };
+    tick();
+  });
+}
+
+describe('REST API', () => {
+  it('creates a document (201) and rejects missing title (400)', async () => {
+    const ok = await fetch(`${base}/api/documents`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ title: 'Doc', content: 'hi' }),
+    });
+    expect(ok.status).toBe(201);
+    const body = await ok.json();
+    expect(body).toMatchObject({ title: 'Doc', content: 'hi', version: 0 });
+    expect(body.id).toBeTruthy();
+
+    const bad = await fetch(`${base}/api/documents`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ content: 'no title' }),
+    });
+    expect(bad.status).toBe(400);
+  });
+
+  it('lists documents', async () => {
+    await createDoc('A');
+    await createDoc('B');
+    const res = await fetch(`${base}/api/documents`);
+    expect(res.status).toBe(200);
+    const list = await res.json();
+    expect(list.length).toBe(2);
+  });
+
+  it('gets a document, 404 for unknown', async () => {
+    const id = await createDoc('X', 'body');
+    const ok = await fetch(`${base}/api/documents/${id}`);
+    expect(ok.status).toBe(200);
+    expect((await ok.json()).content).toBe('body');
+    const miss = await fetch(`${base}/api/documents/${randomUUID()}`);
+    expect(miss.status).toBe(404);
+  });
+
+  it('updates a document and bumps version; 404 for unknown', async () => {
+    const id = await createDoc('X', 'old');
+    const res = await fetch(`${base}/api/documents/${id}`, {
+      method: 'PUT',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ title: 'Y', content: 'new' }),
