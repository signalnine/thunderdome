@@ -0,0 +1,299 @@
+import express, { type Express, type Request, type Response } from 'express';
+import { createServer, type Server } from 'node:http';
+import { WebSocketServer, WebSocket } from 'ws';
+import { Store } from './db.js';
+import {
+  apply,
+  isValidOp,
+  transform,
+  transformAgainst,
+  type Op,
+} from './ot.js';
+
+export interface CollabApp {
+  app: Express;
+  start(port?: number): Promise<number>;
+  stop(): Promise<void>;
+}
+
+const WS_PATH = /^\/ws\/documents\/([^/?]+)/;
+
+interface ClientMsg {
+  type?: string;
+  baseVersion?: number;
+  op?: unknown;
+}
+
+export function createApp(dbPath = ':memory:'): CollabApp {
+  const store = new Store(dbPath);
+  const app = express();
+  app.use(express.json({ limit: '5mb' }));
+
+  // --- REST API ---------------------------------------------------------
+  app.post('/api/documents', (req: Request, res: Response) => {
+    const { title, content } = req.body ?? {};
+    if (typeof title !== 'string' || title.length === 0) {
+      return res.status(400).json({ error: 'title is required' });
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    const doc = store.createDocument(title, content ?? '');
+    return res.status(201).json({ ...doc, version: store.currentVersion(doc.id) });
+  });
+
+  app.get('/api/documents', (_req: Request, res: Response) => {
+    const docs = store.listDocuments();
+    res.json(docs.map((d) => ({ ...d, version: store.currentVersion(d.id) })));
+  });
+
+  app.get('/api/documents/:id', (req: Request, res: Response) => {
+    const doc = store.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'not found' });
+    return res.json({ ...doc, version: store.currentVersion(doc.id) });
+  });
+
+  app.get('/api/documents/:id/versions', (req: Request, res: Response) => {
+    const doc = store.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'not found' });
+    return res.json(store.listVersions(req.params.id));
+  });
+
+  app.put('/api/documents/:id', (req: Request, res: Response) => {
+    const { title, content } = req.body ?? {};
+    if (title !== undefined && typeof title !== 'string') {
+      return res.status(400).json({ error: 'title must be a string' });
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    const updated = store.updateDocument(req.params.id, { title, content });
+    if (!updated) return res.status(404).json({ error: 'not found' });
+    // Push the new state to any connected collaborators.
+    if (content !== undefined) {
+      broadcastSync(req.params.id);
+    }
+    return res.json({ ...updated, version: store.currentVersion(updated.id) });
+  });
+
+  app.delete('/api/documents/:id', (req: Request, res: Response) => {
+    const ok = store.deleteDocument(req.params.id);
+    if (!ok) return res.status(404).json({ error: 'not found' });
+    // Drop any live connections for the deleted document.
+    const set = rooms.get(req.params.id);
+    if (set) {
+      for (const ws of set) ws.close(1000, 'document deleted');
+      rooms.delete(req.params.id);
+    }
+    return res.status(204).end();
+  });
+
+  // --- WebSocket collaboration -----------------------------------------
+  const httpServer: Server = createServer(app);
+  const wss = new WebSocketServer({ noServer: true });
+  const rooms = new Map<string, Set<WebSocket>>();
+
+  function send(ws: WebSocket, msg: unknown): void {
+    if (ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify(msg));
+  }
+
+  function broadcast(docId: string, msg: unknown): void {
+    const set = rooms.get(docId);
+    if (!set) return;
+    const data = JSON.stringify(msg);
+    for (const ws of set) {
+      if (ws.readyState === WebSocket.OPEN) ws.send(data);
+    }
+  }
+
+  function broadcastSync(docId: string): void {
+    const doc = store.getDocument(docId);
+    if (!doc) return;
+    broadcast(docId, {
+      type: 'sync',
+      documentId: docId,
+      content: doc.content,
+      version: store.currentVersion(docId),
+    });
+  }
+
+  function handleOp(docId: string, ws: WebSocket, msg: ClientMsg): void {
+    const op = msg.op;
+    if (!isValidOp(op)) {
+      send(ws, { type: 'error', message: 'invalid operation' });
+      return;
+    }
+    const cur = store.currentVersion(docId);
+    let base = msg.baseVersion;
+    if (base === undefined) base = cur;
+    if (typeof base !== 'number' || !Number.isInteger(base) || base < 0 || base > cur) {
+      send(ws, { type: 'error', message: 'invalid baseVersion' });
+      return;
+    }
+
+    // We can only transform across op-versions. If a REST snapshot landed in
+    // the (base, cur] range there is no op log to transform against, so ask
+    // the client to resync rather than risk divergence.
+    const opsSince = store.opsSince(docId, base);
+    if (opsSince.length !== cur - base) {
+      send(ws, { type: 'error', message: 'state changed; please resync' });
+      broadcastSync(docId);
+      return;
+    }
+
+    // Validate the op applies to the document state at its base version.
+    const baseRow = store
+      .listVersions(docId)
+      .find((v) => v.version === base);
+    if (baseRow) {
+      try {
+        apply(baseRow.content, op as Op);
+      } catch {
+        send(ws, { type: 'error', message: 'operation out of bounds' });
+        return;
+      }
+    }
+
+    // Transform against everything committed since the base version.
+    let pending = transformAgainst(op as Op, opsSince, false);
+    let content = store.getDocument(docId)!.content;
+    let version = cur;
+    const committed: { op: Op; version: number }[] = [];
+    try {
+      while (pending.length > 0) {
+        const [head, ...rest] = pending;
+        content = apply(content, head);
+        version += 1;
+        store.commitOp(docId, version, content, head);
+        committed.push({ op: head, version });
+        pending = rest.flatMap((p) => transform(p, head, false));
+      }
+    } catch {
+      send(ws, { type: 'error', message: 'operation out of bounds' });
+      return;
+    }
+
+    for (const c of committed) {
+      broadcast(docId, {
+        type: 'op',
+        documentId: docId,
+        op: c.op,
+        version: c.version,
+      });
+    }
+  }
+
+  wss.on('connection', (ws: WebSocket, docId: string) => {
+    const doc = store.getDocument(docId);
+    if (!doc) {
+      send(ws, { type: 'error', message: 'document not found' });
+      ws.close(1008, 'document not found');
+      return;
+    }
+    let set = rooms.get(docId);
+    if (!set) {
+      set = new Set();
+      rooms.set(docId, set);
+    }
+    set.add(ws);
+
+    send(ws, {
+      type: 'sync',
+      documentId: docId,
+      content: doc.content,
+      version: store.currentVersion(docId),
+    });
+
+    ws.on('message', (raw) => {
+      let msg: ClientMsg;
+      try {
+        msg = JSON.parse(raw.toString());
+      } catch {
+        send(ws, { type: 'error', message: 'malformed message (invalid JSON)' });
+        return;
+      }
+      if (typeof msg !== 'object' || msg === null) {
+        send(ws, { type: 'error', message: 'malformed message' });
+        return;
+      }
+      if (msg.type === 'op') {
+        try {
+          handleOp(docId, ws, msg);
+        } catch {
+          // Last-resort guard: never let one bad op crash the server.
+          send(ws, { type: 'error', message: 'failed to process operation' });
+        }
+      } else if (msg.type === 'ping') {
+        send(ws, { type: 'pong' });
+      } else {
+        send(ws, { type: 'error', message: `unknown message type: ${msg.type}` });
+      }
+    });
+
+    ws.on('close', () => {
+      const s = rooms.get(docId);
+      if (s) {
+        s.delete(ws);
+        if (s.size === 0) rooms.delete(docId);
+      }
+    });
+
+    ws.on('error', () => {
+      /* swallow socket errors; close handler cleans up */
+    });
+  });
+
+  httpServer.on('upgrade', (req, socket, head) => {
+    const url = req.url ?? '';
+    const match = WS_PATH.exec(url);
+    if (!match) {
+      socket.destroy();
+      return;
+    }
+    const docId = decodeURIComponent(match[1]);
+    wss.handleUpgrade(req, socket, head, (ws) => {
+      wss.emit('connection', ws, docId);
+    });
+  });
+
+  return {
+    app,
+    start(port = 0): Promise<number> {
+      return new Promise((resolve) => {
+        httpServer.listen(port, () => {
+          const addr = httpServer.address();
+          const actual = typeof addr === 'object' && addr ? addr.port : port;
+          resolve(actual);
+        });
+      });
+    },
+    stop(): Promise<void> {
+      return new Promise((resolve) => {
+        for (const set of rooms.values()) {
+          for (const ws of set) ws.terminate();
+        }
+        rooms.clear();
+        wss.close(() => {
+          httpServer.close(() => {
+            store.close();
+            resolve();
+          });
+        });
+      });
+    },
+  };
+}
+
+// Allow running directly: `node dist/server.js`
+const isMain = process.argv[1] && import.meta.url === `file://${process.argv[1]}`;
+if (isMain) {
+  const dbFile = process.env.DB_PATH ?? 'collab.db';
+  const server = createApp(dbFile);
+  server.start(Number(process.env.PORT ?? 3000)).then((port) => {
+    // eslint-disable-next-line no-console
+    console.log(`collab server listening on :${port} (db=${dbFile})`);
+  });
+  const shutdown = () => server.stop().then(() => process.exit(0));
+  process.on('SIGINT', shutdown);
+  process.on('SIGTERM', shutdown);
+}
