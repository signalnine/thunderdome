diff --git a/src/db.ts b/src/db.ts
new file mode 100644
index 0000000..21f461a
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,152 @@
+import Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+import type { Op } from './ot.js';
+
+export interface DocumentRow {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface VersionRow {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS documents (
+  id TEXT PRIMARY KEY,
+  title TEXT NOT NULL,
+  content TEXT NOT NULL DEFAULT '',
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  updated_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+CREATE TABLE IF NOT EXISTS versions (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  version INTEGER NOT NULL,
+  content TEXT NOT NULL,
+  operation TEXT,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  UNIQUE(document_id, version)
+);
+CREATE INDEX IF NOT EXISTS idx_versions_doc ON versions(document_id, version);
+`;
+
+export class Store {
+  private db: Database.Database;
+
+  constructor(path = ':memory:') {
+    this.db = new Database(path);
+    this.db.pragma('journal_mode = WAL');
+    this.db.pragma('foreign_keys = ON');
+    this.db.exec(SCHEMA);
+  }
+
+  createDocument(title: string, content = ''): DocumentRow {
+    const id = randomUUID();
+    const insertDoc = this.db.prepare(
+      'INSERT INTO documents (id, title, content) VALUES (?, ?, ?)',
+    );
+    const insertVer = this.db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)',
+    );
+    const tx = this.db.transaction(() => {
+      insertDoc.run(id, title, content);
+      insertVer.run(id, content);
+    });
+    tx();
+    return this.getDocument(id)!;
+  }
+
+  getDocument(id: string): DocumentRow | undefined {
+    return this.db
+      .prepare('SELECT * FROM documents WHERE id = ?')
+      .get(id) as DocumentRow | undefined;
+  }
+
+  listDocuments(): DocumentRow[] {
+    return this.db
+      .prepare('SELECT * FROM documents ORDER BY created_at DESC, id')
+      .all() as DocumentRow[];
+  }
+
+  /** Current version number = highest version row for the document. */
+  currentVersion(id: string): number {
+    const row = this.db
+      .prepare('SELECT MAX(version) AS v FROM versions WHERE document_id = ?')
+      .get(id) as { v: number | null };
+    return row.v ?? 0;
+  }
+
+  listVersions(id: string): VersionRow[] {
+    return this.db
+      .prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version')
+      .all(id) as VersionRow[];
+  }
+
+  /** All ops committed strictly after `baseVersion`, in commit order. */
+  opsSince(id: string, baseVersion: number): Op[] {
+    const rows = this.db
+      .prepare(
+        'SELECT operation FROM versions WHERE document_id = ? AND version > ? AND operation IS NOT NULL ORDER BY version',
+      )
+      .all(id, baseVersion) as { operation: string }[];
+    return rows.map((r) => JSON.parse(r.operation) as Op);
+  }
+
+  /** Persist a single committed op as the next version, updating the doc. */
+  commitOp(id: string, version: number, content: string, op: Op): void {
+    const updateDoc = this.db.prepare(
+      "UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?",
+    );
+    const insertVer = this.db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)',
+    );
+    const tx = this.db.transaction(() => {
+      updateDoc.run(content, id);
+      insertVer.run(id, version, content, JSON.stringify(op));
+    });
+    tx();
+  }
+
+  /** REST-level update: replace title/content and snapshot a new version. */
+  updateDocument(
+    id: string,
+    fields: { title?: string; content?: string },
+  ): DocumentRow | undefined {
+    const existing = this.getDocument(id);
+    if (!existing) return undefined;
+    const title = fields.title ?? existing.title;
+    const content = fields.content ?? existing.content;
+    const contentChanged = fields.content !== undefined && fields.content !== existing.content;
+    const nextVersion = this.currentVersion(id) + 1;
+    const updateDoc = this.db.prepare(
+      "UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?",
+    );
+    const insertVer = this.db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, NULL)',
+    );
+    const tx = this.db.transaction(() => {
+      updateDoc.run(title, content, id);
+      if (contentChanged) insertVer.run(id, nextVersion, content);
+    });
+    tx();
+    return this.getDocument(id);
+  }
+
+  deleteDocument(id: string): boolean {
+    const info = this.db.prepare('DELETE FROM documents WHERE id = ?').run(id);
+    return info.changes > 0;
+  }
+
+  close(): void {
+    this.db.close();
+  }
+}
diff --git a/src/ot.test.ts b/src/ot.test.ts
new file mode 100644
index 0000000..815a656
--- /dev/null
+++ b/src/ot.test.ts
@@ -0,0 +1,149 @@
+import { describe, it, expect } from 'vitest';
+import { apply, transform, isValidOp, type Op } from './ot.js';
+
+// Apply a list of disjoint transformed ops (all relative to the same base
+// state) by committing one at a time and transforming the rest against each
+// applied op — mirrors the server's commit loop.
+function applyOps(content: string, ops: Op[], aWins: boolean): string {
+  let c = content;
+  let pending = ops.slice();
+  while (pending.length) {
+    const [head, ...rest] = pending;
+    c = apply(c, head);
+    pending = rest.flatMap((p) => transform(p, head, aWins));
+  }
+  return c;
+}
+
+function converges(c: string, a: Op, b: Op): boolean {
+  // a wins ties on the left order; b must lose ties on the symmetric order.
+  const left = applyOps(apply(c, a), transform(b, a, false), false);
+  const right = applyOps(apply(c, b), transform(a, b, true), true);
+  return left === right;
+}
+
+describe('apply', () => {
+  it('inserts text at a position', () => {
+    expect(apply('hello', { type: 'insert', pos: 2, text: 'XY' })).toBe('heXYllo');
+  });
+  it('inserts at the end', () => {
+    expect(apply('hi', { type: 'insert', pos: 2, text: '!' })).toBe('hi!');
+  });
+  it('deletes a slice', () => {
+    expect(apply('hello', { type: 'delete', pos: 1, length: 3 })).toBe('ho');
+  });
+  it('throws on insert out of bounds', () => {
+    expect(() => apply('hi', { type: 'insert', pos: 5, text: 'x' })).toThrow();
+  });
+  it('throws on delete out of bounds', () => {
+    expect(() => apply('hi', { type: 'delete', pos: 1, length: 5 })).toThrow();
+  });
+});
+
+describe('isValidOp', () => {
+  it('accepts valid insert', () => {
+    expect(isValidOp({ type: 'insert', pos: 0, text: 'a' })).toBe(true);
+  });
+  it('accepts valid delete', () => {
+    expect(isValidOp({ type: 'delete', pos: 0, length: 2 })).toBe(true);
+  });
+  it('rejects empty insert text', () => {
+    expect(isValidOp({ type: 'insert', pos: 0, text: '' })).toBe(false);
+  });
+  it('rejects zero-length delete', () => {
+    expect(isValidOp({ type: 'delete', pos: 0, length: 0 })).toBe(false);
+  });
+  it('rejects negative pos', () => {
+    expect(isValidOp({ type: 'insert', pos: -1, text: 'a' })).toBe(false);
+  });
+  it('rejects unknown type / non-objects', () => {
+    expect(isValidOp({ type: 'replace' })).toBe(false);
+    expect(isValidOp(null)).toBe(false);
+    expect(isValidOp('insert')).toBe(false);
+  });
+});
+
+describe('transform — insert/insert', () => {
+  it('preserves both inserts at different positions', () => {
+    const c = 'abcdef';
+    const a: Op = { type: 'insert', pos: 1, text: 'X' };
+    const b: Op = { type: 'insert', pos: 4, text: 'Y' };
+    expect(converges(c, a, b)).toBe(true);
+  });
+  it('preserves BOTH inserts at the same position (nothing dropped)', () => {
+    const c = 'abc';
+    const a: Op = { type: 'insert', pos: 1, text: 'X' };
+    const b: Op = { type: 'insert', pos: 1, text: 'Y' };
+    const result = applyOps(apply(c, a), transform(b, a, false), false);
+    expect(result).toContain('X');
+    expect(result).toContain('Y');
+    expect(converges(c, a, b)).toBe(true);
+  });
+});
+
+describe('transform — insert/delete and delete/insert', () => {
+  it('converges when insert is before delete', () => {
+    expect(converges('abcdef', { type: 'insert', pos: 0, text: 'Z' }, { type: 'delete', pos: 3, length: 2 })).toBe(true);
+  });
+  it('converges when insert is after delete', () => {
+    expect(converges('abcdef', { type: 'insert', pos: 5, text: 'Z' }, { type: 'delete', pos: 1, length: 2 })).toBe(true);
+  });
+  it('preserves insert that lands inside a concurrent delete range', () => {
+    const c = 'abcdef';
+    const a: Op = { type: 'insert', pos: 3, text: 'ZZ' };
+    const b: Op = { type: 'delete', pos: 1, length: 4 };
+    const result = applyOps(apply(c, b), transform(a, b, false), false);
+    expect(result).toContain('ZZ');
+    expect(converges(c, a, b)).toBe(true);
+  });
+});
+
+describe('transform — delete/delete', () => {
+  it('converges for disjoint deletes', () => {
+    expect(converges('abcdefgh', { type: 'delete', pos: 0, length: 2 }, { type: 'delete', pos: 5, length: 2 })).toBe(true);
+  });
+  it('converges for overlapping deletes (no double-delete / no crash)', () => {
+    expect(converges('abcdefgh', { type: 'delete', pos: 1, length: 4 }, { type: 'delete', pos: 3, length: 4 })).toBe(true);
+  });
+  it('converges for identical deletes', () => {
+    expect(converges('abcdefgh', { type: 'delete', pos: 2, length: 3 }, { type: 'delete', pos: 2, length: 3 })).toBe(true);
+  });
+});
+
+describe('randomized convergence property', () => {
+  it('converges for many random concurrent op pairs', () => {
+    // Deterministic PRNG so failures are reproducible.
+    let seed = 123456789;
+    const rnd = () => {
+      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+      return seed / 0x7fffffff;
+    };
+    const randInt = (n: number) => Math.floor(rnd() * n);
+    const alpha = 'abcdefghij';
+    const randOp = (len: number): Op => {
+      if (len === 0 || rnd() < 0.5) {
+        return { type: 'insert', pos: randInt(len + 1), text: alpha[randInt(alpha.length)] + (rnd() < 0.5 ? alpha[randInt(alpha.length)] : '') };
+      }
+      const pos = randInt(len);
+      const maxLen = len - pos;
+      return { type: 'delete', pos, length: 1 + randInt(maxLen) };
+    };
+
+    let failures = 0;
+    for (let i = 0; i < 1000; i++) {
+      const slen = 1 + randInt(12);
+      let s = '';
+      for (let j = 0; j < slen; j++) s += alpha[randInt(alpha.length)];
+      const a = randOp(s.length);
+      const b = randOp(s.length);
+      if (!converges(s, a, b)) {
+        failures++;
+        if (failures <= 3) {
+          // eslint-disable-next-line no-console
+          console.error('DIVERGENCE', JSON.stringify({ s, a, b }));
+        }
+      }
+    }
+    expect(failures).toBe(0);
+  });
+});
diff --git a/src/ot.ts b/src/ot.ts
new file mode 100644
index 0000000..9204f75
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,161 @@
+// Operational Transform core for a single-text collaborative document.
+//
+// Operations are character-based inserts and deletes. The server keeps an
+// authoritative, totally-ordered log of applied operations. Incoming client
+// operations carry the base version they were composed against; the server
+// transforms them against every operation applied since that base version so
+// that all clients converge to the same document state.
+
+export type InsertOp = { type: 'insert'; pos: number; text: string };
+export type DeleteOp = { type: 'delete'; pos: number; length: number };
+export type Op = InsertOp | DeleteOp;
+
+/** Validate that a value is a structurally well-formed operation. */
+export function isValidOp(op: unknown): op is Op {
+  if (typeof op !== 'object' || op === null) return false;
+  const o = op as Record<string, unknown>;
+  if (o.type === 'insert') {
+    return (
+      typeof o.pos === 'number' &&
+      Number.isInteger(o.pos) &&
+      o.pos >= 0 &&
+      typeof o.text === 'string' &&
+      o.text.length > 0
+    );
+  }
+  if (o.type === 'delete') {
+    return (
+      typeof o.pos === 'number' &&
+      Number.isInteger(o.pos) &&
+      o.pos >= 0 &&
+      typeof o.length === 'number' &&
+      Number.isInteger(o.length) &&
+      o.length > 0
+    );
+  }
+  return false;
+}
+
+/** Apply an operation to content. Throws on out-of-bounds operations. */
+export function apply(content: string, op: Op): string {
+  if (op.type === 'insert') {
+    if (op.pos < 0 || op.pos > content.length) {
+      throw new RangeError(
+        `insert pos ${op.pos} out of bounds for length ${content.length}`,
+      );
+    }
+    return content.slice(0, op.pos) + op.text + content.slice(op.pos);
+  }
+  // delete
+  if (op.pos < 0 || op.pos + op.length > content.length) {
+    throw new RangeError(
+      `delete [${op.pos}, ${op.pos + op.length}) out of bounds for length ${content.length}`,
+    );
+  }
+  return content.slice(0, op.pos) + content.slice(op.pos + op.length);
+}
+
+/**
+ * Transform operation `a` so it can be applied AFTER operation `b`, given both
+ * were composed against the same document state.
+ *
+ * Returns an array of ops (usually one, occasionally zero or two) such that:
+ *   apply(apply(c, b), transform(a, b, ...)) === apply(apply(c, a), transform(b, a, ...))
+ *
+ * `aWins` breaks ties for inserts at the same position (it must be the inverse
+ * for the symmetric call so the two sides agree on ordering).
+ */
+export function transform(a: Op, b: Op, aWins: boolean): Op[] {
+  if (a.type === 'insert' && b.type === 'insert') {
+    return transformInsertInsert(a, b, aWins);
+  }
+  if (a.type === 'insert' && b.type === 'delete') {
+    return transformInsertDelete(a, b);
+  }
+  if (a.type === 'delete' && b.type === 'insert') {
+    return transformDeleteInsert(a, b);
+  }
+  return transformDeleteDelete(a as DeleteOp, b as DeleteOp);
+}
+
+function transformInsertInsert(a: InsertOp, b: InsertOp, aWins: boolean): Op[] {
+  if (a.pos < b.pos || (a.pos === b.pos && aWins)) {
+    return [{ type: 'insert', pos: a.pos, text: a.text }];
+  }
+  return [{ type: 'insert', pos: a.pos + b.text.length, text: a.text }];
+}
+
+function transformInsertDelete(a: InsertOp, b: DeleteOp): Op[] {
+  if (a.pos <= b.pos) {
+    return [{ type: 'insert', pos: a.pos, text: a.text }];
+  }
+  if (a.pos >= b.pos + b.length) {
+    return [{ type: 'insert', pos: a.pos - b.length, text: a.text }];
+  }
+  // Insert fell inside the deleted range; clamp to the deletion start so the
+  // inserted text is preserved (never silently dropped).
+  return [{ type: 'insert', pos: b.pos, text: a.text }];
+}
+
+function transformDeleteInsert(a: DeleteOp, b: InsertOp): Op[] {
+  if (b.pos >= a.pos + a.length) {
+    // Insert is entirely after the deleted range.
+    return [{ type: 'delete', pos: a.pos, length: a.length }];
+  }
+  if (b.pos <= a.pos) {
+    // Insert is before the deleted range; shift the delete right.
+    return [{ type: 'delete', pos: a.pos + b.text.length, length: a.length }];
+  }
+  // Insert lands strictly inside the deleted range. Split the delete around the
+  // inserted text so the insertion survives.
+  const before = b.pos - a.pos;
+  const after = a.length - before;
+  const ops: Op[] = [];
+  if (before > 0) ops.push({ type: 'delete', pos: a.pos, length: before });
+  if (after > 0) {
+    ops.push({ type: 'delete', pos: b.pos + b.text.length, length: after });
+  }
+  return ops;
+}
+
+function transformDeleteDelete(a: DeleteOp, b: DeleteOp): Op[] {
+  const aEnd = a.pos + a.length;
+  const bEnd = b.pos + b.length;
+  if (a.pos >= bEnd) {
+    // a entirely after b.
+    return [{ type: 'delete', pos: a.pos - b.length, length: a.length }];
+  }
+  if (aEnd <= b.pos) {
+    // a entirely before b.
+    return [{ type: 'delete', pos: a.pos, length: a.length }];
+  }
+  // Ranges overlap. Delete only the part of a's range that b did not remove.
+  const overlapStart = Math.max(a.pos, b.pos);
+  const overlapEnd = Math.min(aEnd, bEnd);
+  const overlap = overlapEnd - overlapStart;
+  const remaining = a.length - overlap;
+  if (remaining <= 0) return [];
+  // New start: characters of b before a's start have already shifted things
+  // left; the surviving deletion begins at min(a.pos, b.pos).
+  const newPos = Math.min(a.pos, b.pos);
+  return [{ type: 'delete', pos: newPos, length: remaining }];
+}
+
+/**
+ * Transform a single op `a` against a sequence of already-applied ops `bs`
+ * (in application order). Returns the resulting list of ops to apply on top of
+ * the current state. `aWins` controls insert tie-breaking against the log
+ * (server-side ops are treated as already committed, so client ops lose ties
+ * to keep ordering stable — pass aWins=false for incoming client ops).
+ */
+export function transformAgainst(a: Op, bs: Op[], aWins: boolean): Op[] {
+  let pending: Op[] = [a];
+  for (const b of bs) {
+    const next: Op[] = [];
+    for (const p of pending) {
+      next.push(...transform(p, b, aWins));
+    }
+    pending = next;
+  }
+  return pending;
+}
