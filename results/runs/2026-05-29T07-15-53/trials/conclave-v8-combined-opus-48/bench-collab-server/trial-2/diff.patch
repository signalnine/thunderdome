+    expect(res.status).toBe(200);
+    const body = await res.json();
+    expect(body.title).toBe('Y');
+    expect(body.content).toBe('new');
+    expect(body.version).toBe(1);
+    const miss = await fetch(`${base}/api/documents/${randomUUID()}`, {
+      method: 'PUT',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ content: 'x' }),
+    });
+    expect(miss.status).toBe(404);
+  });
+
+  it('deletes a document (204) and 404 for unknown', async () => {
+    const id = await createDoc('X');
+    const del = await fetch(`${base}/api/documents/${id}`, { method: 'DELETE' });
+    expect(del.status).toBe(204);
+    expect((await fetch(`${base}/api/documents/${id}`)).status).toBe(404);
+    const miss = await fetch(`${base}/api/documents/${randomUUID()}`, { method: 'DELETE' });
+    expect(miss.status).toBe(404);
+  });
+
+  it('returns version history ordered by version', async () => {
+    const id = await createDoc('X', 'v0');
+    await fetch(`${base}/api/documents/${id}`, {
+      method: 'PUT',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ content: 'v1' }),
+    });
+    const res = await fetch(`${base}/api/documents/${id}/versions`);
+    expect(res.status).toBe(200);
+    const versions = await res.json();
+    expect(versions.map((v: { version: number }) => v.version)).toEqual([0, 1]);
+    expect(versions[0].content).toBe('v0');
+    expect(versions[1].content).toBe('v1');
+  });
+});
+
+describe('WebSocket collaboration', () => {
+  it('sends a sync message on connect', async () => {
+    const id = await createDoc('Doc', 'hello');
+    const c = new Client(id);
+    await c.ready;
+    expect(c.content).toBe('hello');
+    expect(c.version).toBe(0);
+    c.close();
+  });
+
+  it('errors when connecting to an unknown document', async () => {
+    const c = new Client(randomUUID());
+    await waitFor(() => c.errors.length > 0 || c.ws.readyState === WebSocket.CLOSED);
+    expect(c.errors).toContain('document not found');
+    c.close();
+  });
+
+  it('broadcasts an op to all connected clients', async () => {
+    const id = await createDoc('Doc', 'abc');
+    const a = new Client(id);
+    const b = new Client(id);
+    await Promise.all([a.ready, b.ready]);
+    a.sendOp({ type: 'insert', pos: 3, text: 'XYZ' }, 0);
+    await waitFor(() => a.content === 'abcXYZ' && b.content === 'abcXYZ');
+    expect(a.content).toBe('abcXYZ');
+    expect(b.content).toBe('abcXYZ');
+    a.close();
+    b.close();
+  });
+
+  it('preserves both concurrent inserts at the same position', async () => {
+    const id = await createDoc('Doc', 'abc');
+    const a = new Client(id);
+    const b = new Client(id);
+    await Promise.all([a.ready, b.ready]);
+    // Both base on version 0.
+    a.sendOp({ type: 'insert', pos: 0, text: 'A' }, 0);
+    b.sendOp({ type: 'insert', pos: 0, text: 'B' }, 0);
+    await waitFor(() => a.version === 2 && b.version === 2);
+    expect(a.content).toBe(b.content);
+    expect(a.content).toContain('A');
+    expect(a.content).toContain('B');
+    // Confirm REST view converges to the same content.
+    const doc = await (await fetch(`${base}/api/documents/${id}`)).json();
+    expect(doc.content).toBe(a.content);
+    a.close();
+    b.close();
+  });
+
+  it('rejects malformed ops without crashing and keeps serving', async () => {
+    const id = await createDoc('Doc', 'abc');
+    const c = new Client(id);
+    await c.ready;
+    c.raw('not json at all');
+    c.raw(JSON.stringify({ type: 'op', op: { type: 'frobnicate' }, baseVersion: 0 }));
+    c.raw(JSON.stringify({ type: 'op', op: { type: 'delete', pos: 100, length: 5 }, baseVersion: 0 }));
+    c.raw(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 0, text: 'OK' }, baseVersion: 0 }));
+    await waitFor(() => c.content === 'OKabc');
+    expect(c.errors.length).toBeGreaterThanOrEqual(3);
+    expect(c.content).toBe('OKabc');
+    c.close();
+  });
+});
+
+describe('concurrency & convergence', () => {
+  it('10 concurrent clients converge to identical content', async () => {
+    const id = await createDoc('Stress', 'start');
+    const clients: Client[] = [];
+    for (let i = 0; i < 10; i++) clients.push(new Client(id));
+    await Promise.all(clients.map((c) => c.ready));
+
+    // Each client fires several inserts based on the version it currently sees.
+    let total = 0;
+    for (let round = 0; round < 5; round++) {
+      for (let i = 0; i < clients.length; i++) {
+        const c = clients[i];
+        c.sendOp({ type: 'insert', pos: 0, text: `${i}` }, c.version);
+        total++;
+      }
+    }
+
+    const expectedVersion = total; // started at version 0
+    await waitFor(
+      () => clients.every((c) => c.version === expectedVersion),
+      8000,
+    );
+    const first = clients[0].content;
+    for (const c of clients) expect(c.content).toBe(first);
+    // No characters dropped: original 'start' (5) plus 50 single-char inserts.
+    expect(first.length).toBe(5 + total);
+
+    const doc = await (await fetch(`${base}/api/documents/${id}`)).json();
+    expect(doc.content).toBe(first);
+    for (const c of clients) c.close();
+  });
+});
+
+describe('persistence across restart', () => {
+  const file = join(tmpdir(), `collab-test-${randomUUID()}.db`);
+  afterEach(() => {
+    for (const ext of ['', '-wal', '-shm']) {
+      try {
+        rmSync(file + ext);
+      } catch {
+        /* ignore */
+      }
+    }
+  });
+
+  it('documents and versions survive a restart', async () => {
+    const s1 = createApp(file);
+    const p1 = await s1.start(0);
+    const b1 = `http://127.0.0.1:${p1}`;
+    const created = await (
+      await fetch(`${b1}/api/documents`, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ title: 'Persist', content: 'hello' }),
+      })
+    ).json();
+    const id = created.id;
+
+    // Apply an op over WS so a version row is written.
+    const ws = new WebSocket(`ws://127.0.0.1:${p1}/ws/documents/${id}`);
+    await new Promise<void>((resolve) => ws.on('open', () => resolve()));
+    await new Promise((r) => setTimeout(r, 50));
+    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 5, text: '!' }, baseVersion: 0 }));
+    await new Promise((r) => setTimeout(r, 150));
+    ws.close();
+    await s1.stop();
+
+    // Reopen the same file.
+    const s2 = createApp(file);
+    const p2 = await s2.start(0);
+    const b2 = `http://127.0.0.1:${p2}`;
+    const doc = await (await fetch(`${b2}/api/documents/${id}`)).json();
+    expect(doc.content).toBe('hello!');
+    expect(doc.version).toBe(1);
