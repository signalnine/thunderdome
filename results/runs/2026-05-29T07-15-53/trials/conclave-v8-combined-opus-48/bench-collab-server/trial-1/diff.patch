@@ -0,0 +1,272 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import request from 'supertest';
+import WebSocket from 'ws';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { rmSync } from 'node:fs';
+import { createApp, type CollabApp } from '../src/server.js';
+
+function nextMessage(ws: WebSocket): Promise<any> {
+  return new Promise((resolve, reject) => {
+    const onMsg = (data: WebSocket.RawData) => {
+      cleanup();
+      resolve(JSON.parse(data.toString()));
+    };
+    const onErr = (e: Error) => {
+      cleanup();
+      reject(e);
+    };
+    function cleanup() {
+      ws.off('message', onMsg);
+      ws.off('error', onErr);
+    }
+    ws.on('message', onMsg);
+    ws.on('error', onErr);
+  });
+}
+
+function open(port: number, docId: string): Promise<WebSocket> {
+  return new Promise((resolve, reject) => {
+    const ws = new WebSocket(`ws://127.0.0.1:${port}/ws/${docId}`);
+    ws.once('open', () => resolve(ws));
+    ws.once('error', reject);
+  });
+}
+
+async function createDoc(collab: CollabApp, content = ''): Promise<string> {
+  const res = await request(collab.app).post('/documents').send({ title: 'T', content });
+  return res.body.id;
+}
+
+describe('WebSocket collaboration', () => {
+  let collab: CollabApp;
+  let port: number;
+
+  beforeEach(async () => {
+    collab = createApp(':memory:');
+    port = await collab.start(0);
+  });
+  afterEach(async () => {
+    await collab.stop();
+  });
+
+  it('sends a sync message on connect', async () => {
+    const id = await createDoc(collab, 'hello');
+    const ws = await open(port, id);
+    const msg = await nextMessage(ws);
+    expect(msg).toMatchObject({ type: 'sync', content: 'hello', version: 0 });
+    ws.close();
+  });
+
+  it('errors and closes for unknown document', async () => {
+    const ws = await open(port, 'does-not-exist');
+    const msg = await nextMessage(ws);
+    expect(msg.type).toBe('error');
+    await new Promise((r) => ws.once('close', r));
+  });
+
+  it('applies an insert and broadcasts to all clients', async () => {
+    const id = await createDoc(collab, 'AC');
+    const a = await open(port, id);
+    const b = await open(port, id);
+    await nextMessage(a); // sync
+    await nextMessage(b); // sync
+
+    a.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 1, content: 'B' }, baseVersion: 0 }));
+
+    const fromB = await nextMessage(b);
+    expect(fromB.type).toBe('op');
+    expect(fromB.ops).toEqual([{ type: 'insert', position: 1, content: 'B' }]);
+    expect(fromB.version).toBe(1);
+
+    const doc = await request(collab.app).get(`/documents/${id}`);
+    expect(doc.body.content).toBe('ABC');
+    a.close();
+    b.close();
+  });
+
+  it('applies a delete op', async () => {
+    const id = await createDoc(collab, 'hello world');
+    const a = await open(port, id);
+    await nextMessage(a);
+    a.send(JSON.stringify({ type: 'op', op: { type: 'delete', position: 5, length: 6 }, baseVersion: 0 }));
+    await nextMessage(a);
+    const doc = await request(collab.app).get(`/documents/${id}`);
+    expect(doc.body.content).toBe('hello');
+    a.close();
+  });
+
+  it('rejects malformed ops without crashing', async () => {
+    const id = await createDoc(collab, 'abc');
+    const a = await open(port, id);
+    await nextMessage(a);
+
+    a.send(JSON.stringify({ type: 'op', op: { type: 'bogus' }, baseVersion: 0 }));
+    expect((await nextMessage(a)).type).toBe('error');
+
+    a.send('not json at all');
+    expect((await nextMessage(a)).type).toBe('error');
+
+    a.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: -1, content: 'x' }, baseVersion: 0 }));
+    expect((await nextMessage(a)).type).toBe('error');
+
+    // Server still works afterwards.
+    a.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, content: 'Z' }, baseVersion: 0 }));
+    const ok = await nextMessage(a);
+    expect(ok.type).toBe('op');
+    const doc = await request(collab.app).get(`/documents/${id}`);
+    expect(doc.body.content).toBe('Zabc');
+    a.close();
+  });
+
+  it('preserves both concurrent inserts at the same baseVersion', async () => {
+    const id = await createDoc(collab, '');
+    const a = await open(port, id);
+    const b = await open(port, id);
+    await nextMessage(a);
+    await nextMessage(b);
+
+    // Both target position 0 based on version 0.
+    a.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, content: 'AAA' }, baseVersion: 0 }));
+    await nextMessage(a); // wait for a's broadcast to land first
+    await nextMessage(b);
+    b.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, content: 'BBB' }, baseVersion: 0 }));
+    await nextMessage(b);
+    await nextMessage(a);
+
+    const doc = await request(collab.app).get(`/documents/${id}`);
+    // Both inserts preserved; nothing dropped.
+    expect(doc.body.content).toContain('AAA');
+    expect(doc.body.content).toContain('BBB');
+    expect(doc.body.content.length).toBe(6);
+    a.close();
+    b.close();
+  });
+
+  it('handles 10 concurrent clients without corruption', async () => {
+    const id = await createDoc(collab, '');
+    const N = 10;
+    const opsPer = 8;
+    const clients = await Promise.all(Array.from({ length: N }, () => open(port, id)));
+    // Drain sync messages.
+    await Promise.all(clients.map((c) => nextMessage(c)));
+
+    // Each client inserts a unique marker char repeatedly at position 0,
+    // always based on version 0 (maximally concurrent). Count broadcasts.
+    const expectedBroadcasts = N * opsPer;
+    let received = 0;
+    const done = new Promise<void>((resolve) => {
+      for (const c of clients) {
+        c.on('message', (data) => {
+          const m = JSON.parse(data.toString());
+          if (m.type === 'op') {
+            received += m.ops.length === 0 ? 1 : 1;
+            if (received >= expectedBroadcasts) resolve();
+          }
+        });
+      }
+    });
+
+    const markers = 'abcdefghij';
+    for (let i = 0; i < N; i++) {
+      const ch = markers[i];
+      for (let j = 0; j < opsPer; j++) {
+        clients[i].send(
+          JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, content: ch }, baseVersion: 0 }),
+        );
+      }
+    }
+
+    await done;
+    const doc = await request(collab.app).get(`/documents/${id}`);
+    // Total length == every char inserted; no insertion dropped.
+    expect(doc.body.content.length).toBe(N * opsPer);
+    for (let i = 0; i < N; i++) {
+      const count = doc.body.content.split(markers[i]).length - 1;
+      expect(count).toBe(opsPer);
+    }
+    await Promise.all(clients.map((c) => c.close()));
+  });
+
+  it('all connected clients converge to the same content via broadcasts', async () => {
+    const id = await createDoc(collab, 'start');
+    const clients = await Promise.all(Array.from({ length: 5 }, () => open(port, id)));
+    // Each client tracks its own view starting from the sync content.
+    const views = await Promise.all(
+      clients.map(async (c) => {
+        const sync = await nextMessage(c);
+        return { content: sync.content as string };
+      }),
+    );
+
+    const applyOp = (content: string, op: any): string =>
+      op.type === 'insert'
+        ? content.slice(0, op.position) + op.content + content.slice(op.position)
+        : content.slice(0, op.position) + content.slice(op.position + op.length);
+
+    let totalApplied = 0;
+    const target = clients.length * 4;
+    const settled = new Promise<void>((resolve) => {
+      clients.forEach((c, idx) => {
+        c.on('message', (data) => {
+          const m = JSON.parse(data.toString());
+          if (m.type === 'op') {
+            for (const op of m.ops) views[idx].content = applyOp(views[idx].content, op);
+            totalApplied++;
+            // Each broadcast goes to all 5 clients.
+            if (totalApplied >= target * clients.length) resolve();
+          }
+        });
+      });
+    });
+
+    for (let i = 0; i < clients.length; i++) {
+      for (let j = 0; j < 4; j++) {
+        clients[i].send(
+          JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, content: String(i) }, baseVersion: 0 }),
+        );
+      }
+    }
+
+    await settled;
+    const server = await request(collab.app).get(`/documents/${id}`);
+    for (const v of views) {
+      expect(v.content).toBe(server.body.content);
+    }
+    await Promise.all(clients.map((c) => c.close()));
+  });
+});
+
+describe('persistence across restarts', () => {
+  it('survives a stop + reopen on the same file', async () => {
+    const file = join(tmpdir(), `collab-${randomUUID()}.db`);
+    try {
+      const first = createApp(file);
+      const port = await first.start(0);
+      const id = await createDoc(first, 'persist me');
+      const ws = await open(port, id);
+      await nextMessage(ws);
+      ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, content: '>>' }, baseVersion: 0 }));
+      await nextMessage(ws);
+      ws.close();
+      await first.stop();
+
+      const second = createApp(file);
+      const doc = await request(second.app).get(`/documents/${id}`);
+      expect(doc.status).toBe(200);
+      expect(doc.body.content).toBe('>>persist me');
+      const history = await request(second.app).get(`/documents/${id}/history`);
+      expect(history.body.length).toBeGreaterThanOrEqual(1);
+      await second.stop();
+    } finally {
+      for (const suffix of ['', '-wal', '-shm']) {
+        try {
+          rmSync(file + suffix);
+        } catch {
+          /* ignore */
+        }
+      }
+    }
+  });
+});
