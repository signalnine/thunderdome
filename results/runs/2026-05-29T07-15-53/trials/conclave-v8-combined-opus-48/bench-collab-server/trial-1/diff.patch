+import Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+import type { Operation } from './ot.js';
+
+export interface DocumentRow {
+  id: string;
+  title: string;
+  content: string;
+  version: number;
+  createdAt: number;
+  updatedAt: number;
+}
+
+export interface OperationRow {
+  id: number;
+  docId: string;
+  version: number;
+  type: string;
+  position: number;
+  content: string | null;
+  length: number | null;
+  clientId: string | null;
+  createdAt: number;
+}
+
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS documents (
+  id TEXT PRIMARY KEY,
+  title TEXT NOT NULL,
+  content TEXT NOT NULL DEFAULT '',
+  version INTEGER NOT NULL DEFAULT 0,
+  created_at INTEGER NOT NULL,
+  updated_at INTEGER NOT NULL
+);
+CREATE TABLE IF NOT EXISTS operations (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  doc_id TEXT NOT NULL,
+  version INTEGER NOT NULL,
+  type TEXT NOT NULL,
+  position INTEGER NOT NULL,
+  content TEXT,
+  length INTEGER,
+  client_id TEXT,
+  created_at INTEGER NOT NULL,
+  FOREIGN KEY (doc_id) REFERENCES documents(id)
+);
+CREATE INDEX IF NOT EXISTS idx_ops_doc_version ON operations(doc_id, version);
+`;
+
+export class Store {
+  private db: Database.Database;
+
+  constructor(dbPath = ':memory:') {
+    this.db = new Database(dbPath);
+    this.db.pragma('journal_mode = WAL');
+    this.db.exec(SCHEMA);
+  }
+
+  createDocument(title: string, content = ''): DocumentRow {
+    const now = Date.now();
+    const id = randomUUID();
+    this.db
+      .prepare(
+        `INSERT INTO documents (id, title, content, version, created_at, updated_at)
+         VALUES (?, ?, ?, 0, ?, ?)`,
+      )
+      .run(id, title, content, now, now);
+    return this.getDocument(id)!;
+  }
+
+  getDocument(id: string): DocumentRow | undefined {
+    const row = this.db
+      .prepare(`SELECT * FROM documents WHERE id = ?`)
+      .get(id) as Record<string, unknown> | undefined;
+    return row ? mapDoc(row) : undefined;
+  }
+
+  listDocuments(): DocumentRow[] {
+    const rows = this.db
+      .prepare(`SELECT * FROM documents ORDER BY created_at ASC`)
+      .all() as Record<string, unknown>[];
+    return rows.map(mapDoc);
+  }
+
+  deleteDocument(id: string): boolean {
+    this.db.prepare(`DELETE FROM operations WHERE doc_id = ?`).run(id);
+    const info = this.db.prepare(`DELETE FROM documents WHERE id = ?`).run(id);
+    return info.changes > 0;
+  }
+
+  /** Wholesale update via REST. Bumps version and records a snapshot op. */
+  updateDocument(
+    id: string,
+    fields: { title?: string; content?: string },
+  ): DocumentRow | undefined {
+    const doc = this.getDocument(id);
+    if (!doc) return undefined;
+    const now = Date.now();
+    const title = fields.title ?? doc.title;
+    const content = fields.content ?? doc.content;
+    const newVersion = doc.version + 1;
+    const txn = this.db.transaction(() => {
+      this.db
+        .prepare(
+          `UPDATE documents SET title = ?, content = ?, version = ?, updated_at = ? WHERE id = ?`,
+        )
+        .run(title, content, newVersion, now, id);
+      if (fields.content !== undefined && fields.content !== doc.content) {
+        this.db
+          .prepare(
+            `INSERT INTO operations (doc_id, version, type, position, content, length, client_id, created_at)
+             VALUES (?, ?, 'replace', 0, ?, ?, NULL, ?)`,
+          )
+          .run(id, newVersion, content, content.length, now);
+      }
+    });
+    txn();
+    return this.getDocument(id);
+  }
+
+  /**
+   * Apply an already-transformed operation to a document, persisting the op and
+   * the new content atomically. Returns the new document state.
+   */
+  applyOperation(
+    id: string,
+    op: Operation,
+    newContent: string,
+    clientId: string | null,
+  ): DocumentRow {
+    const now = Date.now();
+    const doc = this.getDocument(id)!;
+    const newVersion = doc.version + 1;
+    const txn = this.db.transaction(() => {
+      this.db
+        .prepare(
+          `INSERT INTO operations (doc_id, version, type, position, content, length, client_id, created_at)
+           VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
+        )
+        .run(
+          id,
+          newVersion,
+          op.type,
+          op.position,
+          op.type === 'insert' ? op.content : null,
+          op.type === 'delete' ? op.length : null,
+          clientId,
+          now,
+        );
+      this.db
+        .prepare(`UPDATE documents SET content = ?, version = ?, updated_at = ? WHERE id = ?`)
+        .run(newContent, newVersion, now, id);
+    });
+    txn();
+    return this.getDocument(id)!;
+  }
+
+  /** Operations with version strictly greater than `sinceVersion`, in order. */
+  operationsSince(id: string, sinceVersion: number): OperationRow[] {
+    const rows = this.db
+      .prepare(
+        `SELECT * FROM operations WHERE doc_id = ? AND version > ? ORDER BY version ASC, id ASC`,
+      )
+      .all(id, sinceVersion) as Record<string, unknown>[];
+    return rows.map(mapOp);
+  }
+
+  history(id: string): OperationRow[] {
+    const rows = this.db
+      .prepare(`SELECT * FROM operations WHERE doc_id = ? ORDER BY version ASC, id ASC`)
+      .all(id) as Record<string, unknown>[];
+    return rows.map(mapOp);
+  }
+
+  close(): void {
+    this.db.close();
+  }
+}
+
+function mapDoc(row: Record<string, unknown>): DocumentRow {
+  return {
+    id: row.id as string,
+    title: row.title as string,
+    content: row.content as string,
+    version: row.version as number,
+    createdAt: row.created_at as number,
+    updatedAt: row.updated_at as number,
+  };
+}
+
+function mapOp(row: Record<string, unknown>): OperationRow {
+  return {
+    id: row.id as number,
+    docId: row.doc_id as string,
+    version: row.version as number,
+    type: row.type as string,
+    position: row.position as number,
+    content: (row.content as string | null) ?? null,
+    length: (row.length as number | null) ?? null,
+    clientId: (row.client_id as string | null) ?? null,
+    createdAt: row.created_at as number,
+  };
+}
+
+/** Reconstruct an Operation from a stored row (for transforming history). */
+export function rowToOperation(row: OperationRow): Operation | null {
+  if (row.type === 'insert') {
+    return { type: 'insert', position: row.position, content: row.content ?? '' };
+  }
+  if (row.type === 'delete') {
+    return { type: 'delete', position: row.position, length: row.length ?? 0 };
+  }
+  return null;
+}
