n();\n    return this.getDocument(id);\n  }\n\n  /**\n   * Apply an already-transformed operation to a document, persisting the op and\n   * the new content atomically. Returns the new document state.\n   */\n  applyOperation(\n    id: string,\n    op: Operation,\n    newContent: string,\n    clientId: string | null,\n  ): DocumentRow {\n    const now = Date.now();\n    const doc = this.getDocument(id)!;\n    const newVersion = doc.version + 1;\n    const txn = this.db.transaction(() => {\n      this.db\n        .prepare(\n          `INSERT INTO operations (doc_id, version, type, position, content, length, client_id, created_at)\n           VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,\n        )\n        .run(\n          id,\n          newVersion,\n          op.type,\n          op.position,\n          op.type === 'insert' ? op.content : null,\n          op.type === 'delete' ? op.length : null,\n          clientId,\n          now,\n        );\n      this.db\n        .prepare(`UPDATE documents SET content = ?, version = ?, updated_at = ? WHERE id = ?`)\n        .run(newContent, newVersion, now, id);\n    });\n    txn();\n    return this.getDocument(id)!;\n  }\n\n  /** Operations with version strictly greater than `sinceVersion`, in order. */\n  operationsSince(id: string, sinceVersion: number): OperationRow[] {\n    const rows = this.db\n      .prepare(\n        `SELECT * FROM operations WHERE doc_id = ? AND version > ? ORDER BY version ASC, id ASC`,\n      )\n      .all(id, sinceVersion) as Record<string, unknown>[];\n    return rows.map(mapOp);\n  }\n\n  history(id: string): OperationRow[] {\n    const rows = this.db\n      .prepare(`SELECT * FROM operations WHERE doc_id = ? ORDER BY version ASC, id ASC`)\n      .all(id) as Record<string, unknown>[];\n    return rows.map(mapOp);\n  }\n\n  close(): void {\n    this.db.close();\n  }\n}\n\nfunction mapDoc(row: Record<string, unknown>): DocumentRow {\n  return {\n    id: row.id as string,\n    title: row.title as string,\n    cont