+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import request from 'supertest';
+import { createApp, type CollabApp } from '../src/server.js';
+
+describe('REST API', () => {
+  let collab: CollabApp;
+
+  beforeEach(() => {
+    collab = createApp(':memory:');
+  });
+  afterEach(async () => {
+    await collab.stop();
+  });
+
+  it('creates a document', async () => {
+    const res = await request(collab.app)
+      .post('/documents')
+      .send({ title: 'Doc', content: 'hello' });
+    expect(res.status).toBe(201);
+    expect(res.body).toMatchObject({ title: 'Doc', content: 'hello', version: 0 });
+    expect(res.body.id).toBeTruthy();
+  });
+
+  it('rejects creation without title', async () => {
+    const res = await request(collab.app).post('/documents').send({ content: 'x' });
+    expect(res.status).toBe(400);
+  });
+
+  it('defaults content to empty string', async () => {
+    const res = await request(collab.app).post('/documents').send({ title: 'T' });
+    expect(res.status).toBe(201);
+    expect(res.body.content).toBe('');
+  });
+
+  it('lists documents', async () => {
+    await request(collab.app).post('/documents').send({ title: 'A' });
+    await request(collab.app).post('/documents').send({ title: 'B' });
+    const res = await request(collab.app).get('/documents');
+    expect(res.status).toBe(200);
+    expect(res.body).toHaveLength(2);
+  });
+
+  it('gets a document and 404s for unknown', async () => {
+    const created = await request(collab.app).post('/documents').send({ title: 'A' });
+    const ok = await request(collab.app).get(`/documents/${created.body.id}`);
+    expect(ok.status).toBe(200);
+    const missing = await request(collab.app).get('/documents/nope');
+    expect(missing.status).toBe(404);
+  });
+
+  it('updates a document and bumps version', async () => {
+    const created = await request(collab.app).post('/documents').send({ title: 'A', content: 'x' });
+    const res = await request(collab.app)
+      .put(`/documents/${created.body.id}`)
+      .send({ title: 'B', content: 'y' });
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ title: 'B', content: 'y', version: 1 });
+    const missing = await request(collab.app).put('/documents/nope').send({ title: 'B' });
+    expect(missing.status).toBe(404);
+  });
+
+  it('deletes a document', async () => {
+    const created = await request(collab.app).post('/documents').send({ title: 'A' });
+    const del = await request(collab.app).delete(`/documents/${created.body.id}`);
+    expect(del.status).toBe(204);
+    const after = await request(collab.app).get(`/documents/${created.body.id}`);
+    expect(after.status).toBe(404);
+    const missing = await request(collab.app).delete('/documents/nope');
+    expect(missing.status).toBe(404);
+  });
+
+  it('returns version history', async () => {
+    const created = await request(collab.app).post('/documents').send({ title: 'A', content: 'x' });
+    await request(collab.app).put(`/documents/${created.body.id}`).send({ content: 'xy' });
+    const res = await request(collab.app).get(`/documents/${created.body.id}/history`);
+    expect(res.status).toBe(200);
+    expect(Array.isArray(res.body)).toBe(true);
+    expect(res.body.length).toBeGreaterThanOrEqual(1);
+    const missing = await request(collab.app).get('/documents/nope/history');
+    expect(missing.status).toBe(404);
+  });
+});
