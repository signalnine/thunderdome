n  app.get('/documents/:id', (req: Request, res: Response) => {\n    const doc = store.getDocument(req.params.id);\n    if (!doc) return res.status(404).json({ error: 'not found' });\n    res.json(serializeDoc(doc));\n  });\n\n  app.put('/documents/:id', (req: Request, res: Response) => {\n    const { title, content } = req.body ?? {};\n    if (title !== undefined && typeof title !== 'string') {\n      return res.status(400).json({ error: 'title must be a string' });\n    }\n    if (content !== undefined && typeof content !== 'string') {\n      return res.status(400).json({ error: 'content must be a string' });\n    }\n    const doc = store.updateDocument(req.params.id, { title, content });\n    if (!doc) return res.status(404).json({ error: 'not found' });\n    // Re-sync any connected clients to the new authoritative state.\n    broadcastSync(doc);\n    res.json(serializeDoc(doc));\n  });\n\n  app.delete('/documents/:id', (req: Request, res: Response) => {\n    const existed = store.deleteDocument(req.params.id);\n    if (!existed) return res.status(404).json({ error: 'not found' });\n    closeRoom(req.params.id);\n    res.status(204).end();\n  });\n\n  app.get('/documents/:id/history', (req: Request, res: Response) => {\n    const doc = store.getDocument(req.params.id);\n    if (!doc) return res.status(404).json({ error: 'not found' });\n    res.json(store.history(req.params.id));\n  });\n\n  // ---- WebSocket ---------------------------------------------------------\n  const httpServer: Server = createServer(app);\n  const wss = new WebSocketServer({ noServer: true });\n  // docId -> set of sockets currently collaborating on it.\n  const rooms = new Map<string, Set<WebSocket>>();\n  const socketDoc = new WeakMap<WebSocket, string>();\n\n  function broadcast(docId: string, payload: unknown): void {\n    const room = rooms.get(docId);\n    if (!room) return;\n    const data = JSON.stringify(payload);\n    for (const ws of room) {\n      if (ws.readyState === WebSocket.OPEN) ws.send(data);\n    }\n  }\n\n  function broadcastSync(doc: DocumentRow): void {\n    broadcast(doc.id, { type: 'sync', docId: doc.id, content: doc.content, version: doc.version });\n  }\n\n  function closeRoom(docId: string): void {\n    const room = rooms.get(docId);\n    if (!room) return;\n    for (const ws of room) {\n      try {\n        ws.send(JSON.stringify({ type: 'error', message: 'document deleted' }));\n      } catch {\n        /* ignore */\n      }\n      ws.close();\n    }\n    rooms.delete(docId);\n  }\n\n  httpServer.on('upgrade', (request, socket, head) => {\n    const url = new URL(request.url ?? '', 'http://localhost');\n    const match = url.pathname.match(/^\\/ws\\/([^/]+)\\/?$/);\n    if (!match) {\n      socket.destroy();\n      return;\n    }\n    const docId = decodeURIComponent(match[1]);\n    wss.handleUpgrade(request, socket, head, (ws) => {\n      wss.emit('connection', ws, request, docId);\n    });\n  });\n\n  wss.on('connection', (ws: WebSocket, _request, docId: string) => {\n    const doc = store.getDocument(docId);\n    if (!doc) {\n      ws.send(JSON.stringify({ type: 'error', message: 'unknown document' }));\n      ws.close();\n      return;\n    }\n    let room = rooms.get(docId);\n    if (!room) {\n      room = new Set();\n      rooms.set(docId, room);\n    }\n    room.add(ws);\n    socketDoc.set(ws, docId);\n\n    // Initial sync with current authoritative state.\n    ws.send(\n      JSON.stringify({ type: 'sync', docId, content: doc.content, version: doc.version }),\n    );\n\n    ws.on('message', (raw) => {\n      handleMessage(ws, docId, raw.toString());\n    });\n\n    ws.on('close', () => {\n      const r = rooms.get(docId);\n      if (r) {\n        r.delete(ws);\n        if (r.size === 0) rooms.delete(docId);\n      }\n    });\n\n    ws.on('error', () => {\n      /* swallow socket-level errors so they never crash the server */\n    });\n  });\n\n  function handleMessage(ws: WebSocket, docId: string, raw: string): void {\n    let msg: ClientMessage;\n    try {\n      msg = JSON.parse(raw) as ClientMessage;\n    } catch {\n      return sendError(ws, 'invalid JSON');\n    }\n    if (msg.type !== 'op') {\n      return sendError(ws, `unknown message type: ${String(msg.type)}`);\n    }\n\n    const doc = store.getDocument(docId);\n    if (!doc) return sendError(ws, 'document no longer exists');\n\n    const baseVersion =\n      typeof msg.baseVersion === 'number' && Number.isInteger(msg.baseVersion)\n        ? msg.baseVersion\n        : doc.version;\n    if (baseVersion < 0 || baseVersion > doc.version) {\n      return sendError(ws, 'invalid baseVersion');\n    }\n    const clientId = typeof msg.clientId === 'string' ? msg.clientId : null;\n\n    // Validate against the document length AT the client's base version is hard;\n    // validate shape first (loose), then transform, then re-validate bounds.\n    let incoming: Operation;\n    try {\n      incoming = validateShape(msg.op);\n    } catch (err) {\n      return sendError(ws, (err as Error).message);\n    }\n\n    // Transform against everything applied since the client's base version.\n    const baseOps = store\n      .operationsSince(docId, baseVersion)\n      .map(rowToOperation)\n      .filter((o): o is Operation => o !== null);\n    const transformed = transformAgainstSequence(incoming, baseOps);\n\n    // Apply each resulting op sequentially against the live document.\n    const applied: Operation[] = [];\n    let current = store.getDocument(docId)!;\n    for (const op of transformed) {\n      try {\n        // Final bounds check against the up-to-date content.\n        validateOperation(op, current.content.length);\n      } catch {\n        // A transformed op that no longer fits (e.g. fully-deleted range) is\n        // simply skipped rather than corrupting the document.\n        continue;\n      }\n      const newContent = apply(current.content, op);\n      current = store.applyOperation(docId, op, newContent, clientId);\n      applied.push(op);\n    }\n\n    if (applied.length === 0) {\n      // Still acknowledge so the client can advance its base version.\n      ws.send(JSON.stringify({ type: 'ack', docId, version: current.version }));\n      return;\n    }\n\n    broadcast(docId, {\n      type: 'op',\n      docId,\n      ops: applied,\n      version: current.version,\n      clientId,\n    });\n  }\n\n  function sendError(ws: WebSocket, message: string): void {\n    if (ws.readyState === WebSocket.OPEN) {\n      ws.send(JSON.stringify({ type: 'error', message }));\n    }\n  }\n\n  // Loose shape validation independent of document length (bounds are checked\n  // again after transform against the current content).\n  function validateShape(op: unknown): Operation {\n    if (op === null || typeof op !== 'object') {\n      throw new InvalidOperationError('operation must be an object');\n    }\n    const o = op as Record<string, unknown>;\n    if (o.type === 'insert') {\n      if (typeof o.position !== 'number' || !Number.isInteger(o.position) || o.position < 0) {\n        throw new InvalidOperationError('insert.position must be a non-negative integer');\n      }\n      if (typeof o.content !== 'string') {\n        throw new InvalidOperationError('insert.content must be a string');\n      }\n      return { type: 'insert', position: o.position, content: o.content };\n    }\n    if (o.type === 'delete') {\n      if (typeof o.position !== 'number' || !Number.isInteger(o.position) || o.position < 0) {\n        throw new InvalidOperationError('delete.position must be a non-negative integer');\n      }\n      if (typeof o.length !== 'number' || !Number.isInteger(o.length) || o.length <= 0) {\n        throw new InvalidOperationError('delete.length must be a positive integer');\n      }\n      return { type: 'delete', position: o.position, length: o.length };\n    }\n    throw new InvalidOperationError('unknown operation type');\n  }\n\n  // ---- lifecycle ------------------------------