index 0000000..1cc6532
--- /dev/null
+++ b/tests/ot.test.ts
@@ -0,0 +1,130 @@
+import { describe, it, expect } from 'vitest';
+import {
+  apply,
+  transform,
+  transformAgainstSequence,
+  validateOperation,
+  InvalidOperationError,
+  type Operation,
+} from '../src/ot.js';
+
+describe('apply', () => {
+  it('inserts text at a position', () => {
+    expect(apply('hello', { type: 'insert', position: 5, content: ' world' })).toBe('hello world');
+    expect(apply('hello', { type: 'insert', position: 0, content: 'X' })).toBe('Xhello');
+  });
+  it('deletes a range', () => {
+    expect(apply('hello world', { type: 'delete', position: 5, length: 6 })).toBe('hello');
+  });
+});
+
+describe('transform insert vs insert', () => {
+  it('shifts later insert right', () => {
+    const a: Operation = { type: 'insert', position: 5, content: 'A' };
+    const b: Operation = { type: 'insert', position: 2, content: 'BB' };
+    expect(transform(a, b)).toEqual([{ type: 'insert', position: 7, content: 'A' }]);
+  });
+  it('leaves earlier insert unchanged', () => {
+    const a: Operation = { type: 'insert', position: 1, content: 'A' };
+    const b: Operation = { type: 'insert', position: 5, content: 'BB' };
+    expect(transform(a, b)).toEqual([{ type: 'insert', position: 1, content: 'A' }]);
+  });
+  it('on equal position, b wins left, a shifts right (both preserved)', () => {
+    const a: Operation = { type: 'insert', position: 3, content: 'A' };
+    const b: Operation = { type: 'insert', position: 3, content: 'B' };
+    // apply b then transformed a
+    let doc = 'xxxyyy';
+    doc = apply(doc, b);
+    doc = apply(doc, transform(a, b)[0]);
+    expect(doc).toBe('xxxBAyyy');
+  });
+});
+
+describe('transform insert vs delete', () => {
+  it('insert before delete unchanged', () => {
+    const a: Operation = { type: 'insert', position: 1, content: 'A' };
+    const b: Operation = { type: 'delete', position: 3, length: 2 };
+    expect(transform(a, b)).toEqual([a]);
+  });
+  it('insert after delete shifts left', () => {
+    const a: Operation = { type: 'insert', position: 6, content: 'A' };
+    const b: Operation = { type: 'delete', position: 1, length: 2 };
+    expect(transform(a, b)).toEqual([{ type: 'insert', position: 4, content: 'A' }]);
+  });
+  it('insert inside delete collapses to delete start', () => {
+    const a: Operation = { type: 'insert', position: 3, content: 'A' };
+    const b: Operation = { type: 'delete', position: 1, length: 4 };
+    expect(transform(a, b)).toEqual([{ type: 'insert', position: 1, content: 'A' }]);
+  });
+});
+
+describe('transform delete vs insert (split)', () => {
+  it('splits the delete when insert lands inside, preserving the insert', () => {
+    // doc = "abcdef"; delete [1,4) => removes "bcd"; concurrent insert "XY" at 2
+    let doc = 'abcdef';
+    const del: Operation = { type: 'delete', position: 1, length: 3 };
+    const ins: Operation = { type: 'insert', position: 2, content: 'XY' };
+    doc = apply(doc, ins); // "abXYcdef"
+    const parts = transform(del, ins);
+    for (const p of parts) doc = apply(doc, p);
+    // "bcd" removed, "XY" preserved => "aXYef"
+    expect(doc).toBe('aXYef');
+  });
+  it('delete after insert shifts right; before insert unchanged', () => {
+    const del: Operation = { type: 'delete', position: 5, length: 2 };
+    const ins: Operation = { type: 'insert', position: 1, content: 'ZZ' };
+    expect(transform(del, ins)).toEqual([{ type: 'delete', position: 7, length: 2 }]);
+    const del2: Operation = { type: 'delete', position: 1, length: 2 };
+    const ins2: Operation = { type: 'insert', position: 5, content: 'ZZ' };
+    expect(transform(del2, ins2)).toEqual([del2]);
+  });
+});
+
+describe('transform delete vs delete', () => {
+  it('non-overlapping later delete shifts left', () => {
+    const a: Operation = { type: 'delete', position: 6, length: 2 };
+    const b: Operation = { type: 'delete', position: 1, length: 2 };
+    expect(transform(a, b)).toEqual([{ type: 'delete', position: 4, length: 2 }]);
+  });
+  it('fully overlapping delete becomes a no-op', () => {
+    const a: Operation = { type: 'delete', position: 2, length: 2 };
+    const b: Operation = { type: 'delete', position: 1, length: 4 };
+    expect(transform(a, b)).toEqual([]);
+  });
+  it('partial overlap removes only the surviving portion', () => {
+    // doc "abcdef"; b deletes [1,3)="bc" -> "adef"; a deletes [2,5)="cde"
+    let doc = 'abcdef';
+    const b: Operation = { type: 'delete', position: 1, length: 2 };
+    const a: Operation = { type: 'delete', position: 2, length: 3 };
+    doc = apply(doc, b); // "adef"
+    for (const p of transform(a, b)) doc = apply(doc, p);
+    // union of deletes [1,5) removes "bcde" => "af"
+    expect(doc).toBe('af');
+  });
+});
+
+describe('transformAgainstSequence', () => {
+  it('threads through multiple base ops', () => {
+    const a: Operation = { type: 'insert', position: 5, content: 'A' };
+    const bs: Operation[] = [
+      { type: 'insert', position: 0, content: 'XX' },
+      { type: 'delete', position: 0, length: 1 },
+    ];
+    // +2 then -1 => net +1 => position 6
+    expect(transformAgainstSequence(a, bs)).toEqual([{ type: 'insert', position: 6, content: 'A' }]);
+  });
+});
+
+describe('validateOperation', () => {
+  it('accepts valid ops', () => {
+    expect(validateOperation({ type: 'insert', position: 0, content: 'a' }, 0)).toBeTruthy();
+    expect(validateOperation({ type: 'delete', position: 0, length: 1 }, 3)).toBeTruthy();
+  });
+  it('rejects out-of-range and malformed ops', () => {
+    expect(() => validateOperation({ type: 'insert', position: 5, content: 'a' }, 2)).toThrow(InvalidOperationError);
+    expect(() => validateOperation({ type: 'delete', position: 0, length: 5 }, 2)).toThrow(InvalidOperationError);
+    expect(() => validateOperation({ type: 'bogus' }, 2)).toThrow(InvalidOperationError);
+    expect(() => validateOperation(null, 2)).toThrow(InvalidOperationError);
+    expect(() => validateOperation({ type: 'insert', position: 1.5, content: 'a' }, 5)).toThrow();
+  });
+});
