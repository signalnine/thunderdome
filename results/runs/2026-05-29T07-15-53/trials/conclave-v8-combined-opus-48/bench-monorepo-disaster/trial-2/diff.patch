}\n\n  // In a real app, we'd sync to an external service here\n  console.log(`Synced user ${user.name} (${user.email})`);\n  return true;\n}\n\n===== packages/worker/src/jobs/cleanup.ts =====\n/**\n * Cleanup job.\n * Removes stale data and performs maintenance tasks.\n */\n\nimport { getAllUsers } from '@monorepo/core';\n\nexport interface CleanupResult {\n  staleRecords: number;\n  cleanedUp: number;\n  duration: number;\n}\n\nexport async function cleanupJob(): Promise<CleanupResult> {\n  const startTime = Date.now();\n\n  // Get all users to check for stale records\n  const users = getAllUsers();\n\n  let staleRecords = 0;\n  let cleanedUp = 0;\n\n  for (const user of users) {\n    const createdDate = new Date(user.createdAt);\n    const now = new Date();\n    const daysSinceCreation =\n      (now.getTime() - createdDate.getTime()) / (1000 * 60 * 60 * 24);\n\n    // Mark records older than 365 days as stale (simulation)\n    if (daysSinceCreation > 365) {\n      staleRecords++;\n      // In a real app, we'd archive or delete\n      cleanedUp++;\n    }\n  }\n\n  const duration = Date.now() - startTime;\n\n  console.log(\n    `Cleanup complete: ${staleRecords} stale, ${cleanedUp} cleaned in ${duration}ms`\n  );\n\n  return { staleRecords, cleanedUp, duration };\n}\n\nexport function getCleanupThresholdDays(): number {\n  return 365;\n}\n\n===== packages/worker/tests/sync.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { syncJob, syncSingleUser } from '../src/jobs/sync.js';\nimport {\n  registerUser,\n  getAllUsers,\n  resetDefaultConnection,\n} from '@monorepo/core';\n\ndescribe('Sync Job', () => {\n  beforeEach(() => {\n    resetDefaultConnection();\n  });\n\n  it('syncs external users into the database', async () => {\n    await syncJob();\n    const users = getAllUsers();\n    expect(users.length).toBeGreaterThan(0);\n  });\n\n  it('skips already existing users on re-run', async () => {\n    await syncJob();\n    const countAfterFirst = getAllUsers().length;\n    await syncJob();\n    const countAfterSecond = getAllUsers().length;\n    expect(countAfterSecond).toBe(countAfterFirst);\n  });\n\n  it('syncs a single user by id', async () => {\n    const user = registerUser({\n      name: 'Sync Test',\n      email: 'sync@test.com',\n      role: 'user',\n    });\n    const result = await syncSingleUser(user.id);\n    expect(result).toBe(true);\n  });\n\n  it('returns false for nonexistent user sync', async () => {\n    const result = await syncSingleUser(999);\n    expect(result).toBe(false);\n  });\n});\n\n===== packages/worker/tests/scheduler.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { Scheduler } from '../src/scheduler.js';\n\ndescribe('Scheduler', () => {\n  let scheduler: Scheduler;\n\n  beforeEach(() => {\n    scheduler = new Scheduler();\n  });\n\n  it('registers a job', () => {\n    scheduler.register('test', () => {}, 1000);\n    const status = scheduler.getStatus();\n    expect(status).toHaveLength(1);\n    expect(status[0].name).toBe('test');\n  });\n\n  it('runs a job once', async () => {\n    let ran = false;\n    scheduler.register('test', () => { ran = true; }, 1000);\n    await scheduler.runOnce('test');\n    expect(ran).toBe(true);\n  });\n\n  it('tracks run count', async () => {\n    scheduler.register('test', () => {}, 1000);\n    await scheduler.runOnce('test');\n    await scheduler.runOnce('test');\n    const status = scheduler.getStatus();\n    expect(status[0].runCount).toBe(2);\n  });\n\n  it('throws for unknown job', async () => {\n    await expect(scheduler.runOnce('nonexistent')).rejects.toThrow(\n      \"Job 'nonexistent' not found\"\n    );\n  });\n\n  it('starts and stops', () => {\n    scheduler.register('test', () => {}, 60000);\n    scheduler.start();\n    expect(scheduler.isRunning()).toBe(true);\n    scheduler.stop();\n    expect(scheduler.isRunning()).toBe(false);\n  });\n});\n\n===== packages/worker/tests/cleanup.tes