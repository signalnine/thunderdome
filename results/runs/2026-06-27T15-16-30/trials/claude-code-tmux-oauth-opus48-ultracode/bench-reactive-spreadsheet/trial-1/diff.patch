+[48;5;237m                                                                                                                                                                                                                            [49m
+[48;5;237m  [38;5;231m## Circular Reference Detection[39m                                                                                                                                                                                           [49m
+[48;5;237m                                                                                                                                                                                                                            [49m
+[48;5;237m  [38;5;231mIf setting a cell would create a circular dependency (e.g., `A1=B1` and `B1=A1`), the engine must detect this and throw an error. This includes indirect cycles through any number of intermediate cells.[39m                 [49m
+[48;5;237m                                                                                                                                                                                                                            [49m
+[48;5;237m  [38;5;231m## API[39m                                                                                                                                                                                                                    [49m
+[48;5;237m                                                                                                                                                                                                                            [49m
+[48;5;237m  [38;5;231mExport a `Spreadsheet` class (or equivalent) from `src/index.ts` with the following interface:[39m                                                                                                                            [49m
+[48;5;237m                                                                                                                                                                                                                            [49m
+[48;5;237m  [38;5;231m```typescript[39m                                                                                                                                                                                                             [49m
+[48;5;237m  [38;5;231mclass Spreadsheet {[39m                                                                                                                                                                                                       [49m
+[48;5;237m  [38;5;231m  // Set a cell's value. Can be a raw value or a formula string starting with '='[39m                                                                                                                                         [49m
+[48;5;237m  [38;5;231m  set(cell: string, value: string | number | boolean): void;[39m                                                                                                                                                              [49m
+[48;5;237m                                                                                                                                                                                                                            [49m
+[48;5;237m  [38;5;231m  // Get a cell's computed value. Returns null for empty cells.[39m                                                                                                                                                           [49m
+[48;5;237m  [38;5;231m  get(cell: string): string | number | boolean | null;[39m                                                                                                                                                                    [49m
+[48;5;237m                                                                                                                                                                                                                            [49m
+[48;5;237m  [38;5;231m  // Get the display string for a cell's computed value.[39m                                                                                                                                                                  [49m
+[48;5;237m  [38;5;231m  getDisplay(cell: string): string;[39m                                                                                                                                                                                       [49m
+[48;5;237m                                                                                                                                                                                                                            [49m
+[48;5;237m  [38;5;231m  // Get all non-empty cells as a Map from cell reference to computed value.[39m                                                                                                                                              [49m
+[48;5;237m  [38;5;231m  getCells(): Map<string, any>;[39m                                                                                                                                                                                           [49m
+[48;5;237m  [38;5;231m}[39m                                                                                                                                                                                                                         [49m
+[48;5;237m  [38;5;231m```[39m                                                                                                                                                                                                                       [49m
+[48;5;237m                                                                                                                                                                                                                            [49m
