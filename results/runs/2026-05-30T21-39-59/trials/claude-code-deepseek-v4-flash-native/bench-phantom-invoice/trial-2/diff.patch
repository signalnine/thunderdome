from './models/invoice.js';\n\nexport function createApp(dbPath: string = ':memory:'): { app: Express; db: Database.Database } {\n  const app = express();\n  const db = createDatabase(dbPath);\n\n  app.use(express.json());\n\n  // List invoices by date range\n  app.get('/invoices', (req: Request, res: Response) => {\n    const { start, end } = req.query;\n    if (!start || !end) {\n      res.status(400).json({ error: 'start and end query parameters required' });\n      return;\n    }\n    const invoices = getInvoicesByDateRange(db, start as string, end as string);\n    res.json(invoices);\n  });\n\n  // Get invoice by ID\n  app.get('/invoices/:id', (req: Request, res: Response) => {\n    const id = parseInt(req.params.id, 10);\n    if (isNaN(id)) {\n      res.status(400).json({ error: 'Invalid invoice ID' });\n      return;\n    }\n    const invoice = getInvoiceById(db, id);\n    if (!invoice) {\n      res.status(404).json({ error: 'Invoice not found' });\n      return;\n    }\n    res.json(invoice);\n  });\n\n  // Create invoice\n  app.post('/invoices', (req: Request, res: Response) => {\n    const input = req.body as InvoiceCreateInput;\n    if (!input.customer_id || !input.date || !input.line_items?.length) {\n      res.status(400).json({ error: 'customer_id, date, and line_items required' });\n      return;\n    }\n    const id = generateInvoice(db, input);\n    const invoice = getInvoiceById(db, id);\n    res.status(201).json(invoice);\n  });\n\n  // Monthly report\n  app.get('/reports/monthly', (req: Request, res: Response) => {\n    const year = parseInt(req.query.year as string, 10);\n    if (isNaN(year)) {\n      res.status(400).json({ error: 'year query parameter required' });\n      return;\n    }\n    const report = getMonthlyReport(db, year);\n    res.json(report);\n  });\n\n  // Customer report\n  app.get('/reports/customer/:id', (req: Request, res: Response) => {\n    const customerId = req.params.id;\n    const report = getCustomerReport(db, customerId);\n    res.json(report);\n  });\n\n  return { app, db };\n}\n\n// Start server if run directly\nconst isMain = process.argv[1]?.endsWith('server.js') || process.argv[1]?.endsWith('server.ts');\nif (isMain) {\n  const { app } = createApp();\n  const port = process.env.PORT || 3000;\n  app.listen(port, () => {\n    console.log(`Invoice service running on port ${port}`);\n  });\n}\n","numLines":84,"startLine":1,"totalLines":84}}}
