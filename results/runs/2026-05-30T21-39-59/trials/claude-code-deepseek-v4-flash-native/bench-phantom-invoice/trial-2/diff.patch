nit_price: 1000 },\n      ],\n    });\n    const invoice = getInvoiceById(db, id);\n    // 1000 * 1.0 * 1.08 = 1080\n    expect(invoice!.total).toBe(1080);\n  });\n\n  it('generates invoice with multiple line items and discount', () => {\n    const id = generateInvoice(db, {\n      customer_id: 'cust-2',\n      date: '2024-07-20',\n      discount_rate: 0.15,\n      tax_rate: 0,\n      line_items: [\n        { description: 'Product A', quantity: 10, unit_price: 50 },\n        { description: 'Product B', quantity: 5, unit_price: 100 },\n      ],\n    });\n    const invoice = getInvoiceById(db, id);\n    // subtotal = 500 + 500 = 1000\n    // discounted = 1000 * 0.85 = 850\n    // total = 850 * 1.0 = 850\n    expect(invoice!.total).toBe(850);\n  });\n});\n\n// ─── Date Range Queries (7 tests) ──────────────────────────────────\n\ndescribe('Date Range Queries', () => {\n  beforeEach(() => {\n    // Seed some invoices across different dates\n    const dates = [\n      '2024-01-15', '2024-01-31', '2024-02-01',\n      '2024-02-28', '2024-03-01', '2024-03-31',\n      '2024-06-30',\n    ];\n    dates.forEach((date, i) => {\n      createInvoice(db, {\n        customer_id: `cust-${i}`,\n        date,\n        subtotal: (i + 1) * 100,\n        discount_rate: 0,\n        tax_rate: 0,\n        total: (i + 1) * 100,\n        status: 'paid',\n      });\n    });\n  });\n\n  it('returns invoices within a date range', () => {\n    const invoices = getInvoicesByDateRange(db, '2024-02-01', '2024-03-15');\n    expect(invoices).toHaveLength(3);\n  });\n\n  it('returns empty array when no invoices match', () => {\n    const invoices = getInvoicesByDateRange(db, '2025-01-01', '2025-12-31');\n    expect(invoices).toHaveLength(0);\n  });\n\n  it('includes invoices on start date boundary', () => {\n    const invoices = getInvoicesByDateRange(db, '2024-01-15', '2024-01-20');\n    expect(invoices).toHaveLength(1);\n    expect(invoices[0].date).toBe('2024-01-15');\n  });\n\n  it('includes invoice