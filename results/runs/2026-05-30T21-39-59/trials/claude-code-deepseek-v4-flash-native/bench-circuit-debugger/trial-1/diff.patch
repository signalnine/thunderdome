tes: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'c' }];\n    const result = simulate(gates, { a: 0, b: 0 });\n    expect(result.c).toBe(0);\n  });\n\n  it('should simulate a single XOR gate', () => {\n    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'c' }];\n    const result = simulate(gates, { a: 1, b: 1 });\n    expect(result.c).toBe(0);\n  });\n\n  it('should handle chained gates', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'a', in2: 'b', out: 'c' },\n      { op: 'OR', in1: 'c', in2: 'd', out: 'e' },\n    ];\n    const result = simulate(gates, { a: 1, b: 1, d: 0 });\n    expect(result.c).toBe(1);\n    expect(result.e).toBe(1);\n  });\n\n  it('should handle a 2-bit adder', () => {\n    // 2-bit adder: x1x0 + y1y0 = z2z1z0\n    const gates: Gate[] = [\n      // Bit 0 (half adder)\n      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },\n      { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },\n      // Bit 1 (full adder)\n      { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },\n      { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },\n      { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },\n      { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },\n      { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },\n      // Bit 2 (carry out)\n      { op: 'OR', in1: 'a01', in2: 'b01', out: 'z02' },\n    ];\n\n    // Test: x=1 (01), y=1 (01) → z=2 (010)\n    const r1 = simulate(gates, { x00: 1, x01: 0, y00: 1, y01: 0 });\n    expect(r1.z00).toBe(0);\n    expect(r1.z01).toBe(1);\n    expect(r1.z02).toBe(0);\n\n    // Test: x=3 (11), y=0 (00) → z=3 (011)\n    const r2 = simulate(gates, { x00: 1, x01: 1, y00: 0, y01: 0 });\n    expect(r2.z00).toBe(1);\n    expect(r2.z01).toBe(1);\n    expect(r2.z02).toBe(0);\n\n    // Test: x=3 (11), y=3 (11) → z=6 (110)\n    const r3 = simulate(gates, { x00: 1, x01: 1, y00: 1, y01: 1 });\n    expect(r3.z00).toBe(0);\n    expect(r3.z01).toBe(1);\n    expect(r3.z02).toBe(1);\n  });\n});\n\ndescribe('findSwappedWires', () => {\n  function build2BitAdder(): Gate[] {\n    return [\n      // Bit 0 (half adder)\n      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },\n      { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },\n      // Bit 1 (full adder)\n      { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },\n      { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },\n      { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },\n      { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },\n      { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },\n      // Bit 2 (carry out)\n      { op: 'OR', in1: 'a01', in2: 'b01', out: 'z02' },\n    ];\n  }\n\n  it('should find no swapped wires in a correct circuit', () => {\n    const gates = build2BitAdder();\n    const result = findSwappedWires(gates);\n    expect(result).toEqual([]);\n  });\n\n  it('should detect a swap between z01 and a01 (z-wire with generate)', () => {\n    const gates = build2BitAdder();\n    // Swap z01 and a01\n    const swapped = gates.map(g => {\n      if (g.out === 'z01') return { ...g, out: 'a01' };\n      if (g.out === 'a01') return { ...g, out: 'z01' };\n      return { ...g };\n    });\n\n    const result = findSwappedWires(swapped);\n    expect(result).toContain('z01');\n    expect(result).toContain('a01');\n    expect(result.length).toBe(2);\n  });\n\n  it('should detect a swap between t01 and b01 (intermediate with propagate)', () => {\n    const gates = build2BitAdder();\n    // Swap t01 and b01\n    const swapped = gates.map(g => {\n      if (g.out === 't01') return { ...g, out: 'b01' };\n      if (g.out === 'b01') return { ...g, out: 't01' };\n      return { ...g };\n    });\n\n    const result = findSwappedWires(swapped);\n    expect(result).toContain('t01');\n    expect(result).toContain('b01');\n    expect(result.length).toBe(2);\n  });\n\n  it('should detect a swap between z00 and a01 (z-wire with generate)', () => {\n    const gates = build2BitAdder();\n    // Swap z00 and a01\n    const swapped = gates.m