meBit && isZ(g.out) && !bit0) {\n        // AND with x/y inputs (same bit, i>0) → should not produce z\n        badWires.add(g.out);\n      }\n      // Also if AND with x/y of bit 0 produces z00 (that's wrong, z00 is XOR)\n      if (bit0 && g.out === 'z00') {\n        badWires.add(g.out);\n      }\n    }\n\n    if (g.op === 'XOR') {\n      if (sameBit && isZ(g.out) && !bit0) {\n        // XOR with x/y (i>0) → should not produce z\n        badWires.add(g.out);\n      }\n      if (sameBit && bit0) {\n        // x00 XOR y00 → must output z00\n        if (g.out !== 'z00') {\n          badWires.add(g.out);\n        }\n      }\n      // XOR with non-x/y inputs and non-z output → WRONG\n      if (!in1isXY && !in2isXY && !isZ(g.out)) {\n        badWires.add(g.out);\n      }\n    }\n\n    if (g.op === 'OR') {\n      if (isZ(g.out)) {\n        const bit = getBit(g.out);\n        if (bit < maxZ) {\n          badWires.add(g.out);\n        }\n      }\n    }\n  }\n\n  // RULE 6 (Consumption checks):\n  // For each XOR gate with x/y inputs (same bit, i>0):\n  //   output should be consumed by XOR and AND gates, not OR\n  // For each AND gate (any, except half-adder carry for bit 0):\n  //   output should be consumed by OR gate, not XOR\n  for (const g of gates) {\n    if (g.op === 'XOR' && isXY(g.in1) && isXY(g.in2) && getBit(g.in1) === getBit(g.in2) && getBit(g.in1) > 0) {\n      // XOR output consumed by OR → WRONG\n      const consumers = consumersOf.get(g.out) || [];\n      for (const c of consumers) {\n        if (c.op === 'OR') {\n          badWires.add(g.out);\n        }\n      }\n    }\n\n    // Check ALL AND gates for feeding into XOR (except x00 AND y00 which is the carry and correctly feeds XOR)\n    const isBit0Carry = g.op === 'AND' &&\n      ((g.in1 === 'x00' && g.in2 === 'y00') || (g.in1 === 'y00' && g.in2 === 'x00'));\n    if (g.op === 'AND' && !isBit0Carry) {\n      const consumers = consumersOf.get(g.out) || [];\n      for (const c of consumers) {\n        if (c.op === 'XOR') {\n          badWires.add(g.out);\n        }\n      }\n    }\n  }\n\n  // RULE 7: Check z_i producers for i > 0\n  // An XOR producing z_i should take one input from an XOR (of x/y) and one from a carry chain.\n  // If a z_i-producer XOR takes an x/y input directly → WRONG\n  for (const g of gates) {\n    if (g.op === 'XOR' && isZ(g.out)) {\n      const bit = getBit(g.out);\n      if (bit > 0 && bit < maxZ) {\n        if (isXY(g.in1) || isXY(g.in2)) {\n          badWires.add(g.out);\n        }\n      }\n    }\n  }\n\n  // RULE 8: Trace-back check for z_i producers.\n  // The XOR producing z_i (0 < i < maxZ) should take an intermediate from xi XOR yi.\n  // Check each input of z_i's producer: if it comes from an XOR with x/y inputs,\n  // the bit index must match z_i's bit. This catches z-z swaps without false positives.\n  for (const g of gates) {\n    if (g.op === 'XOR' && isZ(g.out)) {\n      const zBit = getBit(g.out);\n      if (zBit > 0 && zBit < maxZ) {\n        for (const inp of [g.in1, g.in2]) {\n          const producer = outputOf.get(inp);\n          if (\n            producer &&\n            producer.op === 'XOR' &&\n            isXY(producer.in1) &&\n            isXY(producer.in2) &&\n            getBit(producer.in1) === getBit(producer.in2)\n          ) {\n            // This input traces back to x_j XOR y_j for some j\n            const xorBit = getBit(producer.in1);\n            if (xorBit !== zBit) {\n              badWires.add(g.out);\n            }\n          }\n        }\n      }\n    }\n  }\n\n  return [...badWires].sort();\n}\n","structuredPatch":[{"oldStart":94,"oldLines":12,"newStart":94,"newLines":14,"lines":[" ","   // ─── Structural Rules ────────────────────────────────────────────"," ","-  // RULE Z0: The highest z-wire (final carry) must come from an OR gate","-  // but handle the case where the carry IS the wire (no producer gate)","-  const zMaxWire = `z${maxZ.toString().padStart(2, '0')}`;","-  const zMaxGate = outputOf.get(zMaxWire);","-  if (zMaxGate && zMaxGate.op !== 'OR') {","-    badWires.add(zMaxWire);","+  // RULE Z0: The highest z-wire (final carry, maxZ > 0) must come from an OR gate","+  // (z00 is the sum bit from XOR, not a carry)","+  if (maxZ > 0) {","+    const zMaxWire = `z${maxZ.toString().padStart(2, '0')}`;","+    const zMaxGate = outputOf.get(zMaxWire);","+    if (zMaxGate && zMaxGate.op !== 'OR') {","+      badWires.add(zMaxWire);","+    }","   }"," ","   // RULE C0: The carry from bit 0 (x00 AND y00) must be consumed by at least one XOR gate."]}],"userModified":false,"replaceAll":false}}
