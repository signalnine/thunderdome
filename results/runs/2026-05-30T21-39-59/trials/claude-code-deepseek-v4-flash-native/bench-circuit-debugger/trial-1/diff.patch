+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+/**
+ * Simulate a circuit of logic gates given initial wire values.
+ * Processes gates in topological order and returns all wire values.
+ */
+export function simulate(
+  gates: Gate[],
+  inputs: Record<string, number>,
+): Record<string, number> {
+  const values: Record<string, number> = { ...inputs };
+  const remaining = new Set(gates);
+  let changed = true;
+
+  while (changed && remaining.size > 0) {
+    changed = false;
+    for (const gate of remaining) {
+      const v1 = values[gate.in1];
+      const v2 = values[gate.in2];
+      if (v1 !== undefined && v2 !== undefined) {
+        let result: number;
+        switch (gate.op) {
+          case 'AND':
+            result = v1 & v2;
+            break;
+          case 'OR':
+            result = v1 | v2;
+            break;
+          case 'XOR':
+            result = v1 ^ v2;
+            break;
+        }
+        values[gate.out] = result;
+        remaining.delete(gate);
+        changed = true;
+        break; // break to avoid concurrent modification of Set while iterating
+      }
+    }
+  }
+
+  return values;
+}
+
+/**
+ * Find all 8 wires involved in the 4 pairs of swapped output wires.
+ *
+ * Uses structural analysis of the ripple-carry adder pattern to identify
+ * wires that violate the expected structure.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  const badWires = new Set<string>();
+
+  // Build: which gate produces each wire
+  const outputOf = new Map<string, Gate>();
+  for (const g of gates) {
+    outputOf.set(g.out, g);
+  }
+
+  // Build: which gates consume each wire
+  const consumersOf = new Map<string, Gate[]>();
+  for (const g of gates) {
+    for (const inp of [g.in1, g.in2]) {
+      if (!consumersOf.has(inp)) consumersOf.set(inp, []);
+      consumersOf.get(inp)!.push(g);
+    }
+  }
+
+  // Find all bit indices from x, y, z wires
+  const zBits = new Set<number>();
+  const xBits = new Set<number>();
+  const yBits = new Set<number>();
+  for (const g of gates) {
+    for (const w of [g.in1, g.in2, g.out]) {
+      const m = w.match(/^z(\d+)$/);
+      if (m) zBits.add(parseInt(m[1]));
+      const mx = w.match(/^x(\d+)$/);
+      if (mx) xBits.add(parseInt(mx[1]));
+      const my = w.match(/^y(\d+)$/);
+      if (my) yBits.add(parseInt(my[1]));
+    }
+  }
+
+  const maxZ = Math.max(...zBits);
+
+  // Helper: check if wire starts with a given prefix
+  const isXY = (w: string) => /^[xy]\d+$/.test(w);
+  const isZ = (w: string) => /^z\d+$/.test(w);
+  const getBit = (w: string) => parseInt(w.slice(1));
+
+  // ─── Structural Rules ────────────────────────────────────────────
+
+  // RULE Z0: The highest z-wire (final carry, maxZ > 0) must come from an OR gate
+  // (z00 is the sum bit from XOR, not a carry)
+  if (maxZ > 0) {
+    const zMaxWire = `z${maxZ.toString().padStart(2, '0')}`;
+    const zMaxGate = outputOf.get(zMaxWire);
+    if (zMaxGate && zMaxGate.op !== 'OR') {
+      badWires.add(zMaxWire);
+    }
+  }
+
+  // RULE C0: The carry from bit 0 (x00 AND y00) must be consumed by at least one XOR gate.
+  // In the correct circuit it feeds XOR and AND at bit 1. If it's swapped to only feed
+  // OR (or other gates), the carry from bit 0 is misrouted.
+  const bit0And = gates.find(
+    (g) =>
+      g.op === 'AND' &&
+      ((g.in1 === 'x00' && g.in2 === 'y00') || (g.in1 === 'y00' && g.in2 === 'x00')),
+  );
+  if (bit0And) {
+    const consumers = consumersOf.get(bit0And.out) || [];
+    const hasXorConsumer = consumers.some((c) => c.op === 'XOR');
+    if (!hasXorConsumer) {
+      badWires.add(bit0And.out);
+    }
+  }
+
+  // RULE Z1: z_i (i > 0) must be produced by XOR
+  for (const g of gates) {
+    if (isZ(g.out)) {
+      const bit = getBit(g.out);
+      if (bit > 0 && bit < maxZ && g.op !== 'XOR') {
+        badWires.add(g.out);
+      }
+    }
+  }
+
+  // RULE 2: z00 must come from x00 XOR y00
+  const z00gate = outputOf.get('z00');
+  if (z00gate) {
+    if (
+      z00gate.op !== 'XOR' ||
+      !((z00gate.in1 === 'x00' && z00gate.in2 === 'y00') ||
+        (z00gate.in1 === 'y00' && z00gate.in2 === 'x00'))
+    ) {
+      badWires.add('z00');
+    }
+  }
+
+  // RULE 3: AND with x/y inputs (same bit) should NOT output z (except handling for final carry)
+  // RULE 4: XOR with x/y inputs (i > 0) should NOT output z
+  // RULE 5: XOR with non-x/y inputs and non-z output → WRONG (should be z)
+  for (const g of gates) {
+    const in1isXY = isXY(g.in1);
+    const in2isXY = isXY(g.in2);
+    const sameBit =
+      in1isXY && in2isXY && getBit(g.in1) === getBit(g.in2);
+    const bit0 = in1isXY && in2isXY && getBit(g.in1) === 0;
+
+    if (g.op === 'AND') {
+      if (sameBit && isZ(g.out) && !bit0) {
+        // AND with x/y inputs (same bit, i>0) → should not produce z
+        badWires.add(g.out);
+      }
+      // Also if AND with x/y of bit 0 produces z00 (that's wrong, z00 is XOR)
+      if (bit0 && g.out === 'z00') {
+        badWires.add(g.out);
+      }
+    }
+
+    if (g.op === 'XOR') {
+      if (sameBit && isZ(g.out) && !bit0) {
+        // XOR with x/y (i>0) → should not produce z
+        badWires.add(g.out);
+      }
+      if (sameBit && bit0) {
+        // x00 XOR y00 → must output z00
+        if (g.out !== 'z00') {
+          badWires.add(g.out);
+        }
+      }
+      // XOR with non-x/y inputs and non-z output → WRONG
+      if (!in1isXY && !in2isXY && !isZ(g.out)) {
+        badWires.add(g.out);
+      }
+    }
+
+    if (g.op === 'OR') {
+      if (isZ(g.out)) {
+        const bit = getBit(g.out);
+        if (bit < maxZ) {
+          badWires.add(g.out);
+        }
+      }
+    }
+  }
+
+  // RULE 6 (Consumption checks):
+  // For each XOR gate with x/y inputs (same bit, i>0):
+  //   output should be consumed by XOR and AND gates, not OR
+  // For each AND gate (any, except half-adder carry for bit 0):
+  //   output should be consumed by OR gate, not XOR
+  for (const g of gates) {
+    if (g.op === 'XOR' && isXY(g.in1) && isXY(g.in2) && getBit(g.in1) === getBit(g.in2) && getBit(g.in1) > 0) {
+      // XOR output consumed by OR → WRONG
+      const consumers = consumersOf.get(g.out) || [];
+      for (const c of consumers) {
+        if (c.op === 'OR') {
+          badWires.add(g.out);
+        }
+      }
+    }
+
+    // Check ALL AND gates for feeding into XOR (except x00 AND y00 which is the carry and correctly feeds XOR)
+    const isBit0Carry = g.op === 'AND' &&
+      ((g.in1 === 'x00' && g.in2 === 'y00') || (g.in1 === 'y00' && g.in2 === 'x00'));
+    if (g.op === 'AND' && !isBit0Carry) {
+      const consumers = consumersOf.get(g.out) || [];
+      for (const c of consumers) {
+        if (c.op === 'XOR') {
+          badWires.add(g.out);
+        }
+      }
+    }
+  }
+
+  // RULE 7: Check z_i producers for i > 0
+  // An XOR producing z_i should take one input from an XOR (of x/y) and one from a carry chain.
+  // If a z_i-producer XOR takes an x/y input directly → WRONG
+  for (const g of gates) {
+    if (g.op === 'XOR' && isZ(g.out)) {
+      const bit = getBit(g.out);
+      if (bit > 0 && bit < maxZ) {
+        if (isXY(g.in1) || isXY(g.in2)) {
+          badWires.add(g.out);
+        }
+      }
+    }
+  }
+
+  // RULE 8: Trace-back check for z_i producers.
+  // The XOR producing z_i (0 < i < maxZ) should take an intermediate from xi XOR yi.
+  // Check each input of z_i's producer: if it comes from an XOR with x/y inputs,
+  // the bit index must match z_i's bit. This catches z-z swaps without false positives.
+  for (const g of gates) {
+    if (g.op === 'XOR' && isZ(g.out)) {
+      const zBit = getBit(g.out);
+      if (zBit > 0 && zBit < maxZ) {
+        for (const inp of [g.in1, g.in2]) {
+          const producer = outputOf.get(inp);
+          if (
+            producer &&
+            producer.op === 'XOR' &&
+            isXY(producer.in1) &&
+            isXY(producer.in2) &&
+            getBit(producer.in1) === getBit(producer.in2)
+          ) {
+            // This input traces back to x_j XOR y_j for some j
+            const xorBit = getBit(producer.in1);
+            if (xorBit !== zBit) {
+              badWires.add(g.out);
+            }
+          }
+        }
+      }
+    }
+  }
+
+  return [...badWires].sort();
+}
