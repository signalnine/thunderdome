ME bit → WRONG.)\n  // Let me skip this as it's hard to get right without bit index comparison on non-z wires.\n\n  return [...badWires].sort();\n}\n","structuredPatch":[{"oldStart":221,"oldLines":11,"newStart":221,"newLines":30,"lines":["     }","   }"," ","-  // RULE 8: OR output consumed by XOR → WRONG (OR generates carry, should not feed XOR)","-  // (Actually carry FEEDS XOR in the next bit, so this is delicate.","-  // An OR output consumed by an XOR in the NEXT bit (same bit index) IS correct.","-  // An OR output consumed by an XOR in the SAME bit → WRONG.)","-  // Let me skip this as it's hard to get right without bit index comparison on non-z wires.","+  // RULE 8: Trace-back check for z_i producers","+  // The XOR producing z_i (0 < i < maxZ) should take the output of xi XOR yi as one input.","+  // This catches swaps where z-wires exchange positions (z_i ↔ z_j).","+  for (const g of gates) {","+    if (g.op === 'XOR' && isZ(g.out)) {","+      const bit = getBit(g.out);","+      if (bit > 0 && bit < maxZ) {","+        const xi = `x${bit.toString().padStart(2, '0')}`;","+        const yi = `y${bit.toString().padStart(2, '0')}`;","+        const xorXYGate = findGate(xi, yi, 'XOR');","+        if (xorXYGate) {","+          const intermediate = xorXYGate.out;","+          if (g.in1 !== intermediate && g.in2 !== intermediate) {","+            badWires.add(g.out);","+            // Also flag the intermediate wire — it's part of this problem","+            // But only if the intermediate is a z-wire (swapped with a z)","+            if (isZ(intermediate)) {","+              badWires.add(intermediate);","+            }","+          }","+        }","+      }","+    }","+  }"," ","   return [...badWires].sort();"," }"]}],"userModified":false,"replaceAll":false}}
