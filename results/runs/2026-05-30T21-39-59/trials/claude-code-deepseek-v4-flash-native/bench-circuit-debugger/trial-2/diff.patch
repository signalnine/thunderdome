const values: Record<string, number> = { ...inputs };\n\n  // For each wire, list of gates that consume it\n  const consumers = new Map<string, Gate[]>();\n  // Count of unready input operands for each gate (starts at 2)\n  const needs = new Map<Gate, number>();\n\n  for (const g of gates) {\n    needs.set(g, 2);\n    for (const w of [g.in1, g.in2]) {\n      if (!consumers.has(w)) consumers.set(w, []);\n      consumers.get(w)!.push(g);\n    }\n  }\n\n  // Seed queue with gates whose inputs are all already available\n  const queue: Gate[] = [];\n  for (const g of gates) {\n    if (g.in1 in values && g.in2 in values) {\n      queue.push(g);\n    }\n  }\n\n  while (queue.length > 0) {\n    const g = queue.shift()!;\n    const v1 = values[g.in1];\n    const v2 = values[g.in2];\n\n    switch (g.op) {\n      case 'AND':\n        values[g.out] = v1 & v2;\n        break;\n      case 'OR':\n        values[g.out] = v1 | v2;\n        break;\n      case 'XOR':\n        values[g.out] = v1 ^ v2;\n        break;\n    }\n\n    // Decrement dependency count for each consumer\n    const deps = consumers.get(g.out);\n    if (deps) {\n      for (const dep of deps) {\n        const remaining = needs.get(dep)! - 1;\n        needs.set(dep, remaining);\n        if (remaining === 0) {\n          queue.push(dep);\n        }\n      }\n    }\n  }\n\n  return values;\n}\n\n/**\n * Find the 8 wires involved in 4 swaps in a ripple-carry adder circuit.\n *\n * Strategy: validate each z-wire's structural position and trace the\n * carry chain, collecting any wire that appears in a role it shouldn't.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  // ---- Build data structures ----\n  const wireToGate = new Map<string, Gate>(); // wire -> gate that outputs to it\n\n  for (const g of gates) {\n    wireToGate.set(g.out, g);\n  }\n\n  // ---- Determine bit count from x/y wires ----\n  const allWires = new Set<string>();\n  for (const g of gates) {\n    allWires.add(g.in1);\n    all