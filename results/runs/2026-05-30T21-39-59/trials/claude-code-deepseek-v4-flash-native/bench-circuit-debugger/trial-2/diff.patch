ut(g.in2);\n    \n    if (isXorHalfAdder) {\n      // XOR with xNN/yNN inputs: should output z00 (for N=0) or internal (for N>0)\n      const bit = parseInt(g.in1.match(/\\d+/)![0]);\n      if (bit === 0) {\n        if (g.out !== 'z00') {\n          swaps.add(g.out);\n          swaps.add('z00');\n        }\n      } else {\n        if (isZ(g.out)) {\n          swaps.add(g.out);\n        }\n      }\n    } else if (isAndHalfAdder) {\n      // AND with xNN/yNN inputs: should output internal wire\n      if (isZ(g.out)) {\n        swaps.add(g.out);\n      }\n    } else if (g.op === 'XOR') {\n      // XOR with non-half-adder inputs: should output z-wire\n      if (!isZ(g.out)) {\n        swaps.add(g.out);\n      }\n    } else if (g.op === 'AND') {\n      // AND with non-half-adder inputs: should output internal wire\n      if (isZ(g.out)) {\n        swaps.add(g.out);\n      }\n    } else if (g.op === 'OR') {\n      // OR: should output internal wire (or final carry z{maxBit+1})\n      if (isZ(g.out) && g.out !== zName(maxBit + 1)) {\n        swaps.add(g.out);\n      }\n    }\n  }\n  \n  // Phase 2: Trace carry chain to find swapped internal wires\n  // For bit 0\n  let carryWire = gen[0]; // carry[0] = AND(x00, y00)\n  \n  for (let n = 1; n <= maxBit; n++) {\n    const zWire = zName(n);\n    const psumWire = psum[n];\n    const genWire = gen[n];\n    \n    if (!psumWire || !genWire || !carryWire) continue;\n    \n    // Find XOR(psumWire, carryWire) \n    let xorGate: Gate | null = null;\n    for (const g of gates) {\n      if (g.op === 'XOR') {\n        if ((g.in1 === psumWire && g.in2 === carryWire) || \n            (g.in1 === carryWire && g.in2 === psumWire)) {\n          xorGate = g;\n          break;\n        }\n      }\n    }\n    \n    if (xorGate) {\n      // XOR gate found. Its output should be zNN.\n      if (xorGate.out !== zWire) {\n        swaps.add(xorGate.out);\n        swaps.add(zWire);\n      }\n    } else {\n      // XOR gate not found with expected inputs.\n      // zWire must come from some gate - check it.\n      const zGate = wireToGate.get(zWire);\n      if (zGate) {\n        swaps.add(zWire);\n        // At least one of zGate's inputs or its output is swapped\n        if (zGate.op !== 'XOR') {\n          // zWire should come from an XOR, so something is definitely wrong\n          if (!swaps.has(zWire)) swaps.add(zWire);\n        } else {\n          // zGate is XOR but with wrong inputs\n          // One of its inputs should be psumWire or carryWire\n          if (zGate.in1 !== psumWire && zGate.in1 !== carryWire) {\n            swaps.add(zGate.in1);\n          }\n          if (zGate.in2 !== psumWire && zGate.in2 !== carryWire) {\n            swaps.add(zGate.in2);\n          }\n        }\n      }\n    }\n    \n    // Update carryWire: find OR(genWire, prop) where prop = AND(psumWire, carryWire)\n    // First find AND(psumWire, carryWire)\n    let propWire: string | null = null;\n    for (const g of gates) {\n      if (g.op === 'AND') {\n        if ((g.in1 === psumWire && g.in2 === carryWire) || \n            (g.in1 === carryWire && g.in2 === psumWire)) {\n          propWire = g.out;\n          if (isZ(g.out)) swaps.add(g.out);\n          break;\n        }\n      }\n    }\n    \n    if (propWire) {\n      // Find OR(genWire, propWire)\n      let orGate: Gate | null = null;\n      for (const g of gates) {\n        if (g.op === 'OR') {\n          if ((g.in1 === genWire && g.in2 === propWire) || \n              (g.in1 === propWire && g.in2 === genWire)) {\n            orGate = g;\n            break;\n          }\n        }\n      }\n      \n      if (orGate) {\n        carryWire = orGate.out;\n        if (isZ(orGate.out) && orGate.out !== zName(maxBit + 1)) {\n          swaps.add(orGate.out);\n        }\n      } else {\n        // Can't find the OR gate - the carry chain is broken\n        // genWire or propWire might be swapped\n        // Check which wires are actually used in OR gates\n        let genUsed = fal