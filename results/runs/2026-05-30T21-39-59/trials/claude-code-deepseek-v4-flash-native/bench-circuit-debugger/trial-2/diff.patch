     if (!consumers.has(w)) consumers.set(w, []);\n      consumers.get(w)!.push(g);\n    }\n  }\n\n  while (queue.length > 0) {\n    const g = queue.shift()!;\n    const v1 = values[g.in1];\n    const v2 = values[g.in2];\n\n    switch (g.op) {\n      case 'AND':\n        values[g.out] = v1 & v2;\n        break;\n      case 'OR':\n        values[g.out] = v1 | v2;\n        break;\n      case 'XOR':\n        values[g.out] = v1 ^ v2;\n        break;\n    }\n\n    // Decrement dependency count for each consumer\n    const deps = consumers.get(g.out);\n    if (deps) {\n      for (const dep of deps) {\n        const remaining = needs.get(dep)! - 1;\n        needs.set(dep, remaining);\n        if (remaining === 0) {\n          queue.push(dep);\n        }\n      }\n    }\n  }\n\n  return values;\n}\n\n/**\n * Find the 8 wires involved in 4 swaps in a ripple-carry adder circuit.\n *\n * Strategy:\n *   Phase 1 – Rule-based: check each gate against expected adder gate-type rules\n *   Phase 2 – Carry-chain trace: validate each z-wire's XOR gate and follow\n *             AND→OR carry generation, collecting any wire in a wrong role.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  // ---- Build data structures ----\n  const wireToGate = new Map<string, Gate>(); // wire → gate that outputs to it\n  for (const g of gates) {\n    wireToGate.set(g.out, g);\n  }\n\n  // ---- Determine max bit from x/y input wires ----\n  const allWires = new Set<string>();\n  for (const g of gates) {\n    allWires.add(g.in1);\n    allWires.add(g.in2);\n    allWires.add(g.out);\n  }\n\n  let maxBit = -1;\n  for (const w of allWires) {\n    const m = w.match(/^x(\\d+)$/);\n    if (m) maxBit = Math.max(maxBit, parseInt(m[1]));\n    const m2 = w.match(/^y(\\d+)$/);\n    if (m2) maxBit = Math.max(maxBit, parseInt(m2[1]));\n  }\n\n  // ---- Find half-adder gates (XOR(xN,yN) and AND(xN,yN)) ----\n  const psum: (string | null)[] = new Array(maxBit + 1).fill(null);\n  const gen: (string |