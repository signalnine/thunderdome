+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+/**
+ * Simulate a circuit given gates and initial wire values.
+ * Processes gates in topological order (acyclic circuits only).
+ */
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values: Record<string, number> = { ...inputs };
+
+  const consumers = new Map<string, Gate[]>();
+  const needs = new Map<Gate, number>();
+  const queue: Gate[] = [];
+
+  for (const g of gates) {
+    let n = 0;
+    if (!(g.in1 in values)) n++;
+    if (!(g.in2 in values)) n++;
+    needs.set(g, n);
+    if (n === 0) queue.push(g);
+
+    for (const w of [g.in1, g.in2]) {
+      if (!consumers.has(w)) consumers.set(w, []);
+      consumers.get(w)!.push(g);
+    }
+  }
+
+  while (queue.length > 0) {
+    const g = queue.shift()!;
+    const v1 = values[g.in1];
+    const v2 = values[g.in2];
+
+    switch (g.op) {
+      case 'AND': values[g.out] = v1 & v2; break;
+      case 'OR':  values[g.out] = v1 | v2; break;
+      case 'XOR': values[g.out] = v1 ^ v2; break;
+    }
+
+    const deps = consumers.get(g.out);
+    if (deps) {
+      for (const dep of deps) {
+        const remaining = needs.get(dep)! - 1;
+        needs.set(dep, remaining);
+        if (remaining === 0) queue.push(dep);
+      }
+    }
+  }
+
+  return values;
+}
+
