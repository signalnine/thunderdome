+});
+
+// ---- Helper: build a correct N-bit adder ----
+
+function buildCorrectAdder(bits: number): Gate[] {
+  const gates: Gate[] = [];
+
+  // Bit 0 (half adder)
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+
+  // Bits 1..bits-1 (full adders)
+  for (let n = 1; n < bits; n++) {
+    const ns = n.toString().padStart(2, '0');
+    const prev = (n - 1).toString().padStart(2, '0');
+    const tn = `t${ns}`;
+    const an = `a${ns}`;
+    const bn = `b${ns}`;
+    const cn = `c${ns}`;
+    const cPrev = n === 1 ? 'c00' : `c${prev}`;
+
+    gates.push({ op: 'XOR', in1: `x${ns}`, in2: `y${ns}`, out: tn });
+    gates.push({ op: 'XOR', in1: tn, in2: cPrev, out: `z${ns}` });
+    gates.push({ op: 'AND', in1: `x${ns}`, in2: `y${ns}`, out: an });
+    gates.push({ op: 'AND', in1: tn, in2: cPrev, out: bn });
+    gates.push({ op: 'OR', in1: an, in2: bn, out: cn });
+  }
+
+  // Final carry -> z{bits}
+  const lastCarry = `c${(bits - 1).toString().padStart(2, '0')}`;
+  gates.push({ op: 'OR', in1: lastCarry, in2: lastCarry, out: `z${bits.toString().padStart(2, '0')}` });
+
+  return gates;
+}
+
+function applySwap(gates: Gate[], wireA: string, wireB: string): Gate[] {
+  return gates.map(g => {
+    if (g.out === wireA) return { ...g, out: wireB };
+    if (g.out === wireB) return { ...g, out: wireA };
+    return g;
+  });
+}
+
+// ---- Test findSwappedWires ----
+
+describe('findSwappedWires', () => {
+  it('should find no swaps in a correct 4-bit adder', () => {
+    const gates = buildCorrectAdder(4);
+    const result = findSwappedWires(gates);
+    expect(result).toEqual([]);
+  });
+
+  it('should find swapped z-wire with internal wire in 4-bit adder', () => {
+    // Swap z01 ↔ a01
+    const gates = applySwap(buildCorrectAdder(4), 'z01', 'a01');
+    const result = findSwappedWires(gates);
+    expect(result).toContain('z01');
+    expect(result).toContain('a01');
+  });
+
+  it('should find swapped internal wires in the carry chain', () => {
+    // Swap t01 ↔ a01 (partial sum ↔ generate) for bit 1
+    const gates = applySwap(buildCorrectAdder(4), 't01', 'a01');
+    const result = findSwappedWires(gates);
+    expect(result).toContain('t01');
+    expect(result).toContain('a01');
+  });
+
+  it('should find swapped carry wire with internal wire', () => {
+    // Swap c00 ↔ b01 (carry from bit 0 with propagate of bit 1)
+    const gates = applySwap(buildCorrectAdder(4), 'c00', 'b01');
+    const result = findSwappedWires(gates);
+    expect(result).toContain('c00');
+    expect(result).toContain('b01');
+  });
+
+  it('should find all 4 swap pairs', () => {
+    // Apply 4 swaps to a 10-bit adder
+    const correct = buildCorrectAdder(10);
+    let gates = applySwap(correct, 'z01', 'a01');
+    gates = applySwap(gates, 'z02', 'b02');
+    gates = applySwap(gates, 'c01', 't03');
+    gates = applySwap(gates, 'z04', 'a04');
+
+    const result = findSwappedWires(gates);
+    expect(result).toContain('z01');
+    expect(result).toContain('a01');
+    expect(result).toContain('z02');
+    expect(result).toContain('b02');
+    expect(result).toContain('c01');
+    expect(result).toContain('t03');
+    expect(result).toContain('z04');
+    expect(result).toContain('a04');
+    expect(result.length).toBe(8);
+  });
+
+  it('should handle a 45-bit adder circuit efficiently', () => {
+    const correct = buildCorrectAdder(45);
+    // Apply 4 swaps across the circuit
+    let gates = applySwap(correct, 'z05', 'a05');
+    gates = applySwap(gates, 'z12', 't13');
+    gates = applySwap(gates, 'z25', 'b25');
+    gates = applySwap(gates, 'c30', 'b31');
+
+    const start = Date.now();
+    const result = findSwappedWires(gates);
+    const elapsed = Date.now() - start;
+
+    expect(elapsed).toBeLessThan(5000);
+    expect(result).toContain('z05');
+    expect(result).toContain('a05');
+    expect(result).toContain('z12');
+    expect(result).toContain('t13');
+    expect(result).toContain('z25');
+    expect(result).toContain('b25');
+    expect(result).toContain('c30');
+    expect(result).toContain('b31');
+    expect(result.length).toBe(8);
+  });
+});
