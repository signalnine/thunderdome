inputs are unrelated (already flagged by Phase 1)\n          // Only flag psumWire — don't flag the \"other\" input as it may be\n          // a correct carry (or HA XOR inputs) for a different bit.\n          swaps.add(psumWire);\n        }\n      }\n    }\n\n    // --- Step B: compute carry-out via AND(psum, carryIn) → OR(gen, prop) ---\n    if (psumWire && carryIn) {\n      let propWire: string | null = null;\n      for (const g of gates) {\n        if (g.op === 'AND' &&\n            ((g.in1 === psumWire && g.in2 === carryIn) ||\n             (g.in1 === carryIn && g.in2 === psumWire))) {\n          propWire = g.out;\n          if (isZ(g.out)) swaps.add(g.out);\n          break;\n        }\n      }\n\n      if (propWire && genWire) {\n        let newCarry: string | null = null;\n        for (const g of gates) {\n          if (g.op === 'OR' &&\n              ((g.in1 === genWire && g.in2 === propWire) ||\n               (g.in1 === propWire && g.in2 === genWire))) {\n            newCarry = g.out;\n            if (isZ(g.out) && g.out !== zName(maxBit + 1)) swaps.add(g.out);\n            break;\n          }\n        }\n\n        if (newCarry) {\n          carryIn = newCarry;\n          chainOk = true; // chain restored\n        } else {\n          // OR with expected (gen, prop) not found — gen or prop swapped\n          let genUsed = false, propUsed = false;\n          for (const g of gates) {\n            if (g.op === 'OR') {\n              if (g.in1 === genWire || g.in2 === genWire) genUsed = true;\n              if (g.in1 === propWire || g.in2 === propWire) propUsed = true;\n            }\n          }\n          if (!genUsed) swaps.add(genWire);\n          if (!propUsed) swaps.add(propWire);\n          chainOk = false;\n\n          // best-effort carry: find any OR using gen or prop\n          for (const g of gates) {\n            if (g.op === 'OR' &&\n                (g.in1 === genWire || g.in2 === genWire ||\n                 g.in1 === propWire || g.in2 === propWire)) {\n              carryIn = g.out; break;\n            }\n          }\n        }\n      } else if (!propWire) {\n        // AND(psum, carry) not found — chain broken\n        let psumUsed = false, carryUsed = false;\n        for (const g of gates) {\n          if (g.op === 'AND') {\n            if (g.in1 === psumWire || g.in2 === psumWire) psumUsed = true;\n            if (carryIn && (g.in1 === carryIn || g.in2 === carryIn)) carryUsed = true;\n          }\n        }\n        if (!psumUsed) swaps.add(psumWire);\n        if (carryIn && !carryUsed) swaps.add(carryIn);\n        chainOk = false;\n      }\n    }\n  }\n\n  // =====================================================\n  // Phase 3 — Final carry\n  // =====================================================\n  const finalZ = zName(maxBit + 1);\n  if (carryIn && carryIn !== finalZ) {\n    const fGate = wireToGate.get(finalZ);\n    if (fGate && fGate.in1 === carryIn && fGate.in2 === carryIn) {\n      // buffer gate — OK\n    } else if (fGate) {\n      swaps.add(carryIn);\n      swaps.add(finalZ);\n    } else {\n      swaps.add(finalZ);\n    }\n  }\n\n  return [...swaps].sort();\n}\n","structuredPatch":[{"oldStart":192,"oldLines":13,"newStart":192,"newLines":13,"lines":["             carryIn = actualCarryIn; // follow the actual wiring from here","           }","         } else {","-          // psum is NOT connected to zGate's XOR","-          // This could mean:","-          //   a) psum was swapped (flag psumWire and the actual wire instead)","-          //   b) both inputs are unrelated (already flagged by Phase 1)","-          // Only flag psumWire — don't flag the \"other\" input as it may be","-          // a correct carry (or HA XOR inputs) for a different bit.","+          // psum is NOT connected to zGate's XOR — psum is swapped.","+          // The other input (not carryIn) is the wire that replaced it.","           swaps.add(psumWire);","+          if (carryIn !== null && (a === carryIn || b === carry