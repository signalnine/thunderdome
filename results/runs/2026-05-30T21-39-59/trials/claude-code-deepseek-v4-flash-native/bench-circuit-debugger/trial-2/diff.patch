+      { op: 'OR', in1: 'a', in2: 'z', out: 'b' },
+    ];
+    const result = simulate(gates, { x: 1, y: 1, z: 0 });
+    expect(result.a).toBe(1);
+    expect(result.b).toBe(1);
+  });
+
+  it('should handle deeper dependency chains', () => {
