+{"type":"assistant","message":{"id":"6f18b0f1-bc71-4e55-b23e-1165ef27956d","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{"type":"tool_use","id":"call_00_43Ng7fLXr3yrShu3ePYU7097","name":"Write","input":{"file_path":"/workspace/src/index.ts","content":"export interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string;\n  in2: string;\n  out: string;\n}\n\n/**\n * Simulate a circuit given gates and initial wire values.\n * Processes gates in dependency order (topological sort).\n */\nexport function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {\n  const values: Record<string, number> = { ...inputs };\n\n  // For each wire, list of gates that consume it\n  const consumers = new Map<string, Gate[]>();\n  // Count of unready input operands for each gate (starts at 2)\n  const needs = new Map<Gate, number>();\n\n  for (const g of gates) {\n    needs.set(g, 2);\n    for (const w of [g.in1, g.in2]) {\n      if (!consumers.has(w)) consumers.set(w, []);\n      consumers.get(w)!.push(g);\n    }\n  }\n\n  // Seed queue with gates whose inputs are all already available\n  const queue: Gate[] = [];\n  for (const g of gates) {\n    if (g.in1 in values && g.in2 in values) {\n      queue.push(g);\n    }\n  }\n\n  while (queue.length > 0) {\n    const g = queue.shift()!;\n    const v1 = values[g.in1];\n    const v2 = values[g.in2];\n\n    switch (g.op) {\n      case 'AND':\n        values[g.out] = v1 & v2;\n        break;\n      case 'OR':\n        values[g.out] = v1 | v2;\n        break;\n      case 'XOR':\n        values[g.out] = v1 ^ v2;\n        break;\n    }\n\n    // Decrement dependency count for each consumer\n    const deps = consumers.get(g.out);\n    if (deps) {\n      for (const dep of deps) {\n        const remaining = needs.get(dep)! - 1;\n        needs.set(dep, remaining);\n        if (remaining === 0) {\n          queue.push(dep);\n        }\n      }\n    }\n  }\n\n  return values;\n}\n\n/**\n * Find