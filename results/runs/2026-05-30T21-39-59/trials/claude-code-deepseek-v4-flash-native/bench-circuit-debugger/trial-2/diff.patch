+ *             (e.g. z-wire from AND gate, non-z output from sum-XOR).
+ *   Phase 2 – Carry-chain trace: walk bits 1..maxBit, validate each z-wire's
+ *             XOR gate and the AND(psum,carry)→OR(gen,prop) carry chain.
+ *             Uses a `chainOk` flag to suppress false positives downstream of a break.
+ *   Phase 3 – Final carry validation.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  // ---- Data structures ----
+  const wireToGate = new Map<string, Gate>();
+  for (const g of gates) wireToGate.set(g.out, g);
+
+  const allWires = new Set<string>();
+  for (const g of gates) {
+    allWires.add(g.in1); allWires.add(g.in2); allWires.add(g.out);
+  }
+
+  let maxBit = -1;
+  for (const w of allWires) {
+    const m = w.match(/^x(\d+)$/);
+    if (m) maxBit = Math.max(maxBit, parseInt(m[1]));
+    const m2 = w.match(/^y(\d+)$/);
+    if (m2) maxBit = Math.max(maxBit, parseInt(m2[1]));
+  }
+
+  // ---- Half-adder gates: psum[N] = XOR(xN,yN), gen[N] = AND(xN,yN) ----
+  const psum: (string | null)[] = new Array(maxBit + 1).fill(null);
+  const gen: (string | null)[] = new Array(maxBit + 1).fill(null);
+
+  for (const g of gates) {
+    const m1 = g.in1.match(/^x(\d+)$/);
+    const m2 = g.in2.match(/^y(\d+)$/);
+    const m3 = g.in1.match(/^y(\d+)$/);
+    const m4 = g.in2.match(/^x(\d+)$/);
+
+    if (m1 && m2 && m1[1] === m2[1]) {
+      const bit = parseInt(m1[1]);
+      if (g.op === 'XOR') psum[bit] = g.out;
+      else if (g.op === 'AND') gen[bit] = g.out;
+    } else if (m3 && m4 && m3[1] === m4[1]) {
+      const bit = parseInt(m3[1]);
+      if (g.op === 'XOR') psum[bit] = g.out;
+      else if (g.op === 'AND') gen[bit] = g.out;
+    }
+  }
+
+  const swaps = new Set<string>();
+  const isZ = (w: string) => /^z\d+$/.test(w);
+  const zName = (n: number) => `z${n.toString().padStart(2, '0')}`;
+
+  // =====================================================
+  // Phase 1 — Type-rule violations
+  // =====================================================
+  for (const g of gates) {
+    const xBit = (w: string) => { const m = w.match(/^x(\d+)$/); return m ? parseInt(m[1]) : -1; };
+    const yBit = (w: string) => { const m = w.match(/^y(\d+)$/); return m ? parseInt(m[1]) : -1; };
+
+    const b1 = xBit(g.in1), b2 = yBit(g.in2);
+    const b3 = yBit(g.in1), b4 = xBit(g.in2);
+    const isHA = ((b1 >= 0 && b2 >= 0 && b1 === b2) || (b3 >= 0 && b4 >= 0 && b3 === b4));
+
+    if (g.op === 'XOR' && isHA) {
+      const bit = b1 >= 0 ? b1 : b3;
+      if (bit === 0 && g.out !== 'z00') {
+        swaps.add(g.out); swaps.add('z00');
+      } else if (bit > 0 && isZ(g.out)) {
+        swaps.add(g.out);
+      }
+    } else if (g.op === 'AND' && isHA) {
+      if (isZ(g.out)) swaps.add(g.out);
+    } else if (g.op === 'XOR' && !isHA) {
+      if (!isZ(g.out)) swaps.add(g.out);
+    } else if (g.op === 'AND' && !isHA) {
+      if (isZ(g.out)) swaps.add(g.out);
+    } else if (g.op === 'OR') {
+      if (isZ(g.out) && g.out !== zName(maxBit + 1)) {
+        swaps.add(g.out);
+      }
+    }
+  }
+
+  // =====================================================
+  // Phase 2 — Carry-chain trace
+  // =====================================================
+  let carryIn: string | null = gen[0]; // carry into bit 1
+  let chainOk = true; // false once the carry chain breaks (suppress downstream FPs)
+
+  for (let n = 1; n <= maxBit; n++) {
+    const zWire = zName(n);
+    const psumWire = psum[n];
+    const genWire = gen[n];
+    if (!psumWire || !genWire) continue;
+
+    const zGate = wireToGate.get(zWire);
+
+    if (!zGate) {
+      swaps.add(zWire);
+      continue;
+    }
+
+    // --- Step A: validate z-wire's gate ---
+    if (zGate.op !== 'XOR') {
+      swaps.add(zWire);
+      // Try to recover the carry-in from zGate's inputs so the carry
+      // chain can continue after a swap.
+      if (zGate.in1 === psumWire) carryIn = zGate.in2;
+      else if (zGate.in2 === psumWire) carryIn = zGate.in1;
+    } else {
+      const a = zGate.in1;
+      const b = zGate.in2;
+
+      // Skip half-adder XORs — Phase 1 already flagged them if
+      // they output to a z-wire, and their inputs (xNN/yNN) are
+      // unrelated to this bit's psum/carry.
+      const isX = (w: string) => /^x\d+$/.test(w);
+      const isY = (w: string) => /^y\d+$/.test(w);
+      const isHA = (isX(a) && isY(b) && a.slice(1) === b.slice(1)) ||
+                   (isY(a) && isX(b) && a.slice(1) === b.slice(1));
+      if (!isHA) {
+        const hasPsum = a === psumWire || b === psumWire;
+
+        if (hasPsum) {
+          // psum is connected — the other input is the actual carry into this bit
+          const actualCarryIn = a === psumWire ? b : a;
+          if (carryIn !== null && actualCarryIn !== carryIn) {
+            // The carry wire expected by the pattern doesn't match what's wired.
+            // If the chain was still healthy, this is a swap involving the carry.
+            // If the chain is already broken, this is a downstream effect — don't flag.
+            if (chainOk) {
+              swaps.add(carryIn);
+              swaps.add(actualCarryIn);
+            }
+            carryIn = actualCarryIn; // follow the actual wiring from here
+          }
+        } else {
+          // psum is NOT connected to zGate's XOR — psum is swapped.
+          // The other input (not carryIn) is the wire that replaced it.
+          swaps.add(psumWire);
+          if (carryIn !== null && (a === carryIn || b === carryIn)) {
+            const other = a === carryIn ? b : a;
+            if (other !== psumWire) swaps.add(other);
+          }
+        }
+      }
+    }
+
+    // --- Step B: compute carry-out via AND(psum, carryIn) → OR(gen, prop) ---
+    if (psumWire && carryIn) {
+      let propWire: string | null = null;
+      for (const g of gates) {
+        if (g.op === 'AND' &&
+            ((g.in1 === psumWire && g.in2 === carryIn) ||
+             (g.in1 === carryIn && g.in2 === psumWire))) {
+          propWire = g.out;
+          if (isZ(g.out)) swaps.add(g.out);
+          break;
+        }
+      }
+
+      if (propWire && genWire) {
+        let newCarry: string | null = null;
+        for (const g of gates) {
+          if (g.op === 'OR' &&
+              ((g.in1 === genWire && g.in2 === propWire) ||
+               (g.in1 === propWire && g.in2 === genWire))) {
+            newCarry = g.out;
+            if (isZ(g.out) && g.out !== zName(maxBit + 1)) swaps.add(g.out);
+            break;
+          }
+        }
+
+        if (newCarry) {
+          carryIn = newCarry;
+          chainOk = true; // chain restored
+        } else {
+          // OR with expected (gen, prop) not found — gen or prop swapped
+          let genUsed = false, propUsed = false;
+          for (const g of gates) {
+            if (g.op === 'OR') {
+              if (g.in1 === genWire || g.in2 === genWire) genUsed = true;
+              if (g.in1 === propWire || g.in2 === propWire) propUsed = true;
+            }
+          }
+          if (!genUsed) swaps.add(genWire);
+          if (!propUsed) swaps.add(propWire);
+          chainOk = false;
+
+          // best-effort carry: find any OR using gen or prop
+          for (const g of gates) {
+            if (g.op === 'OR' &&
+                (g.in1 === genWire || g.in2 === genWire ||
+                 g.in1 === propWire || g.in2 === propWire)) {
+              carryIn = g.out; break;
+            }
+          }
+        }
+      } else if (!propWire) {
+        // AND(psum, carry) not found — chain broken
+        let psumUsed = false, carryUsed = false;
+        for (const g of gates) {
+          if (g.op === 'AND') {
+            if (g.in1 === psumWire || g.in2 === psumWire) psumUsed = true;
+            if (carryIn && (g.in1 === carryIn || g.in2 === carryIn)) carryUsed = true;
+          }
+        }
+        if (!psumUsed) swaps.add(psumWire);
+        if (carryIn && !carryUsed) swaps.add(carryIn);
+        chainOk = false;
+      }
+    }
+  }
+
+  // =====================================================
+  // Phase 3 — Final carry
+  // =====================================================
+  const finalZ = zName(maxBit + 1);
+  if (carryIn && carryIn !== finalZ) {
+    const fGate = wireToGate.get(finalZ);
+    if (fGate && fGate.in1 === carryIn && fGate.in2 === carryIn) {
+      // buffer gate — OK
+    } else if (fGate) {
+      swaps.add(carryIn);
+      swaps.add(finalZ);
+    } else {
+      swaps.add(finalZ);
+    }
+  }
+
+  return [...swaps].sort();
+}
