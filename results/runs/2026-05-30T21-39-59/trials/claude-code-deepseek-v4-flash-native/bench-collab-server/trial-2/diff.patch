ateDocument(req.params.id!, title.trim());\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n\n    res.json({ document: doc });\n  });\n\n  // ---- Delete document ----\n\n  router.delete('/api/documents/:id', (req: Request, res: Response) => {\n    const deleted = db.deleteDocument(req.params.id!);\n    if (!deleted) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n    res.status(204).send();\n  });\n\n  // ---- Get version history ----\n\n  router.get('/api/documents/:id/versions', (req: Request, res: Response) => {\n    const doc = db.getDocument(req.params.id!);\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n\n    const versions = db.getVersions(req.params.id!);\n    res.json({ versions });\n  });\n\n  return router;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":150,"cache_creation_input_tokens":0,"cache_read_input_tokens":41984,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"782310fc-3819-4b54-9851-be0afa47ae6c","uuid":"f7cee093-4e12-4add-8c4c-370e571997d1"}
