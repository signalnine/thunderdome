OT EXISTS documents (\n        id TEXT PRIMARY KEY,\n        title TEXT NOT NULL,\n        content TEXT NOT NULL DEFAULT '',\n        created_at TEXT NOT NULL DEFAULT (datetime('now')),\n        updated_at TEXT NOT NULL DEFAULT (datetime('now')),\n        version INTEGER NOT NULL DEFAULT 1\n      );\n\n      CREATE TABLE IF NOT EXISTS versions (\n        id INTEGER PRIMARY KEY AUTOINCREMENT,\n        document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,\n        version INTEGER NOT NULL,\n        content TEXT NOT NULL,\n        operation TEXT,\n        created_at TEXT NOT NULL DEFAULT (datetime('now')),\n        UNIQUE(document_id, version)\n      );\n\n      CREATE TABLE IF NOT EXISTS active_connections (\n        id TEXT PRIMARY KEY,\n        document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,\n        connected_at TEXT NOT NULL DEFAULT (datetime('now'))\n      );\n    `);\n  }\n\n  private prepareStatements(): void {\n    this.insertDocStmt = this.db.prepare(\n      `INSERT INTO documents (id, title, content, version)\n       VALUES (@id, @title, @content, @version)`,\n    );\n\n    this.getDocStmt = this.db.prepare(\n      `SELECT id, title, content, created_at, updated_at, version\n       FROM documents WHERE id = @id`,\n    );\n\n    this.updateDocStmt = this.db.prepare(\n      `UPDATE documents\n       SET title = @title, updated_at = datetime('now')\n       WHERE id = @id`,\n    );\n\n    this.updateDocContentStmt = this.db.prepare(\n      `UPDATE documents\n       SET content = @content, version = @version, updated_at = datetime('now')\n       WHERE id = @id`,\n    );\n\n    this.deleteDocStmt = this.db.prepare(\n      `DELETE FROM documents WHERE id = @id`,\n    );\n\n    this.listDocsStmt = this.db.prepare(\n      `SELECT id, title, content, created_at, updated_at, version\n       FROM documents ORDER BY updated_at DESC`,\n    );\n\n    this.insertVersionStmt = this.db.prepare(\n      `INSERT INTO versions (document_id, version, content, operation)\n       VALUES (@document_id, @version, @content, @operation)`,\n    );\n\n    this.getVersionsStmt = this.db.prepare(\n      `SELECT id, document_id, version, content, operation, created_at\n       FROM versions\n       WHERE document_id = @document_id\n       ORDER BY version ASC`,\n    );\n\n    this.getLatestVersionStmt = this.db.prepare(\n      `SELECT MAX(version) as max_version FROM versions WHERE document_id = @document_id`,\n    );\n\n    this.insertConnectionStmt = this.db.prepare(\n      `INSERT INTO active_connections (id, document_id)\n       VALUES (@id, @document_id)`,\n    );\n\n    this.deleteConnectionStmt = this.db.prepare(\n      `DELETE FROM active_connections WHERE id = @id`,\n    );\n\n    this.getConnectionsStmt = this.db.prepare(\n      `SELECT id, document_id, connected_at\n       FROM active_connections WHERE document_id = @document_id`,\n    );\n\n    this.initDocVersionStmt = this.db.prepare(\n      `INSERT INTO versions (document_id, version, content, operation)\n       VALUES (@document_id, 1, @content, NULL)`,\n    );\n  }\n\n  // ---- Document CRUD ----\n\n  createDocument(id: string, title: string, content = ''): Document {\n    const insertVersion = this.db.transaction(() => {\n      this.insertDocStmt.run({ id, title, content, version: 1 });\n      this.initDocVersionStmt.run({ document_id: id, content });\n    });\n    insertVersion();\n    return this.getDocStmt.get({ id }) as Document;\n  }\n\n  getDocument(id: string): Document | undefined {\n    return this.getDocStmt.get({ id }) as Document | undefined;\n  }\n\n  updateDocument(id: string, title: string): Document | undefined {\n    const result = this.updateDocStmt.run({ id, title });\n    if (result.changes === 0) return undefined;\n    return this.getDocStmt.get({ id }) as Document | undefined;\n  }\n\n  deleteDocument(id: string): boolean {\n    const result = this.deleteDocStmt.run({ id });\n    return result.changes > 0;\n  }\n\n  listDocume