B inserts \"Y\" at 5\n51\t    const original = 'hello';\n52\t    const a: Operation = { type: 'insert', pos: 0, text: 'X' };\n53\t    const b: Operation = { type: 'insert', pos: 5, text: 'Y' };\n54\t    const [aPrime, bPrime] = transform(a, b);\n55\t    // A first, then B (shifted by A): \"Xhello\" + Y at 6\n56\t    expect(applyOp(applyOp(original, a), bPrime)).toBe('XhelloY');\n57\t    // B first, then A (shifted by B): \"helloY\" + X at 0\n58\t    expect(applyOp(applyOp(original, b), aPrime)).toBe('XhelloY');\n59\t  });\n60\t\n61\t  it('concurrent inserts at the same position', () => {\n62\t    const original = 'hello';\n63\t    const a: Operation = { type: 'insert', pos: 2, text: 'A' };\n64\t    const b: Operation = { type: 'insert', pos: 2, text: 'B' };\n65\t    const [aPrime, bPrime] = transform(a, b);\n66\t    // A goes first (tiebreaker), B shifts by 1\n67\t    const viaA = applyOp(applyOp(original, a), bPrime);\n68\t    const viaB = applyOp(applyOp(original, b), aPrime);\n69\t    expect(viaA).toBe(viaB);\n70\t    expect(viaA).toBe('heABllo');\n71\t  });\n72\t\n73\t  it('multiple concurrent inserts converge', () => {\n74\t    const original = '';\n75\t    const a: Operation = { type: 'insert', pos: 0, text: 'A' };\n76\t    const b: Operation = { type: 'insert', pos: 0, text: 'B' };\n77\t    const c: Operation = { type: 'insert', pos: 0, text: 'C' };\n78\t    const [aPrime, bPrime] = transform(a, b);\n79\t    const [aDoublePrime, cPrime] = transform(aPrime, c);\n80\t    const [bDoublePrime, _cPrime] = transform(bPrime, c);\n81\t    // All orders should converge\n82\t    const order1 = applyOp(applyOp(applyOp(original, a), bPrime), cPrime);\n83\t    const order2 = applyOp(applyOp(applyOp(original, b), aPrime), cPrime);\n84\t    expect(order1).toBe(order2);\n85\t  });\n86\t});\n87\t\n88\t// ---- Transform: insert vs delete ----\n89\t\n90\tdescribe('transform insert vs delete', () => {\n91\t  it('insert before delete', () => {\n92\t    // Original: \"hello world\