   if (operation.type === 'insert' && (typeof operation.text !== 'string' || operation.text.length === 0)) {\n      this.sendError(ws, 'insert operation requires non-empty text');\n      return;\n    }\n\n    if (operation.type === 'delete' && (typeof operation.length !== 'number' || operation.length <= 0)) {\n      this.sendError(ws, 'delete operation requires length > 0');\n      return;\n    }\n\n    // Check for concurrent edits\n    let op = operation as unknown as Operation;\n\n    if (version < room.version) {\n      // Transform this operation against intervening operations\n      const offset = Math.max(0, version - room.baseVersion);\n      const intervening = room.ops.slice(offset);\n      try {\n        op = transformAgainst(op, intervening);\n      } catch (err) {\n        this.sendError(ws, `Operation transformation failed: ${(err as Error).message}`);\n        return;\n      }\n    }\n\n    // Validate the (possibly transformed) operation against current state\n    try {\n      applyOp(room.content, op);\n    } catch (err) {\n      this.sendError(ws, `Operation invalid: ${(err as Error).message}`);\n      return;\n    }\n\n    // Apply the operation\n    const newContent = applyOp(room.content, op);\n    const newVersion = room.version + 1;\n\n    // Record in room state\n    room.ops.push(op);\n    room.content = newContent;\n    room.version = newVersion;\n\n    // Persist to database\n    this.db.applyOperation(docId, newContent, op, newVersion);\n\n    // Send ack to the originator\n    this.send(ws, { type: 'ack', version: newVersion, docId });\n\n    // Broadcast to all OTHER clients in the room\n    for (const [cId, client] of room.clients) {\n      if (cId !== clientId && client.readyState === WebSocket.OPEN) {\n        this.send(client, {\n          type: 'operation',\n          docId,\n          operation: op,\n          content: newContent,\n          version: newVersion,\n          clientId,\n        });\n      }\n    }\n  }\n\n  /**\n   * Get or create a room for a document.\n   * Loads state from the database on first access.\n   */\n  private getOrCreateRoom(doc: { id: string; content: string; version: number }): Room {\n    let room = this.rooms.get(doc.id);\n    if (!room) {\n      room = {\n        ops: [],\n        version: doc.version,\n        baseVersion: doc.version,\n        content: doc.content,\n        clients: new Map(),\n      };\n      this.rooms.set(doc.id, room);\n    }\n    return room;\n  }\n\n  private send(ws: WebSocket, data: Record<string, unknown>): void {\n    if (ws.readyState === WebSocket.OPEN) {\n      ws.send(JSON.stringify(data));\n    }\n  }\n\n  private sendError(ws: WebSocket, message: string): void {\n    this.send(ws, { type: 'error', message });\n  }\n\n  /**\n   * Gracefully close all connections and shut down the WebSocket server.\n   */\n  close(): void {\n    for (const client of this.wss.clients) {\n      client.close(1001, 'Server shutting down');\n    }\n    this.wss.close();\n  }\n}\n","structuredPatch":[{"oldStart":49,"oldLines":6,"newStart":49,"newLines":18,"lines":["     this.db = db;","     this.wss = new WebSocketServer({ noServer: true });"," ","+    // Handle upgrade requests — only accept /ws/<docId> paths","+    server.on('upgrade', (request, socket, head) => {","+      const url = new URL(request.url ?? '/', `http://${request.headers.host ?? 'localhost'}`);","+      if (url.pathname.startsWith('/ws/')) {","+        this.wss.handleUpgrade(request, socket, head, (ws) => {","+          this.wss.emit('connection', ws, request);","+        });","+      } else {","+        socket.destroy();","+      }","+    });","+","     this.wss.on('connection', (ws: WebSocket, req: IncomingMessage) => {","       this.handleConnection(ws, req);","     });"]}],"userModified":false,"replaceAll":false}}
