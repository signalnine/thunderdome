ecome insert(0,\"C\")\n    // because C is the first insert at position 0 (tiebreaker wins).\n    const newOp: Operation = { type: 'insert', pos: 0, text: 'C' };\n    const transformed = transformAgainst(newOp, prior);\n    expect(transformed.type).toBe('insert');\n    if (transformed.type === 'insert') {\n      expect(transformed.pos).toBe(0);\n      expect(transformed.text).toBe('C');\n    }\n    // After applying the transformed op to state \"BA\": \"CBA\"\n    expect(applyOp('BA', transformed)).toBe('CBA');\n  });\n\n  it('handles zero prior operations', () => {\n    const result = transformAgainst(\n      { type: 'insert', pos: 0, text: 'A' },\n      [],\n    );\n    expect(result).toEqual({ type: 'insert', pos: 0, text: 'A' });\n  });\n\n  it('transforms delete through prior insert', () => {\n    // State: \"hello\", prior op: insert(2, \"X\") → \"heXllo\"\n    // New op: delete(1, 2) → after prior, should be shifted\n    const prior: Operation[] = [\n      { type: 'insert', pos: 2, text: 'X' },\n    ];\n    const newOp: Operation = { type: 'delete', pos: 1, length: 2 };\n    const transformed = transformAgainst(newOp, prior);\n    // After insert, original chars at [1,3) = \"el\" now at positions 1 and 3.\n    // Single-range best approximation: expanded\n    expect(transformed.type).toBe('delete');\n    expect(applyOp('heXllo', transformed)).toBeDefined();\n  });\n});\n\n// ---- invertOp ----\n\ndescribe('invertOp', () => {\n  it('inverts an insert', () => {\n    const result = invertOp({ type: 'insert', pos: 3, text: 'HELLO' }, '');\n    expect(result).toEqual({ type: 'delete', pos: 3, length: 5 });\n  });\n\n  it('inverts a delete', () => {\n    const result = invertOp({ type: 'delete', pos: 2, length: 3 }, 'abXYZde');\n    expect(result).toEqual({ type: 'insert', pos: 2, text: 'XYZ' });\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":3036,"cache_creation_input_tokens":0,"cache_read_input_tokens":98944,"output_tokens":0,"s