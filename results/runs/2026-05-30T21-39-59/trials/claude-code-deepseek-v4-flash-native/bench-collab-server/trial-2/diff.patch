(viaA).toBe(viaB);\n    expect(viaA).toBe('worldX');\n  });\n\n  it('insert inside deleted range', () => {\n    // Original: \"hello\"\n    // A inserts \"X\" at 2, B deletes [1, 4)\n    const original = 'hello';\n    const a: Operation = { type: 'insert', pos: 2, text: 'X' };\n    const b: Operation = { type: 'delete', pos: 1, length: 3 };\n    const [aPrime, bPrime] = transform(a, b);\n\n    const viaA = applyOp(applyOp(original, a), bPrime);\n    const viaB = applyOp(applyOp(original, b), aPrime);\n    expect(viaA).toBe(viaB);\n    // Insert survives at the deletion start: \"hXo\"\n    expect(viaA).toBe('hXo');\n  });\n});\n\n// ---- Transform: delete vs delete ----\n\ndescribe('transform delete vs delete', () => {\n  it('non-overlapping deletions, A before B', () => {\n    const original = 'abcde';\n    const a: Operation = { type: 'delete', pos: 0, length: 2 };\n    const b: Operation = { type: 'delete', pos: 3, length: 2 };\n    const [aPrime, bPrime] = transform(a, b);\n\n    const viaA = applyOp(applyOp(original, a), bPrime);\n    const viaB = applyOp(applyOp(original, b), aPrime);\n    expect(viaA).toBe(viaB);\n    expect(viaA).toBe('c');\n  });\n\n  it('non-overlapping deletions, B before A', () => {\n    const original = 'abcde';\n    const a: Operation = { type: 'delete', pos: 3, length: 2 };\n    const b: Operation = { type: 'delete', pos: 0, length: 2 };\n    const [aPrime, bPrime] = transform(a, b);\n\n    const viaA = applyOp(applyOp(original, a), bPrime);\n    const viaB = applyOp(applyOp(original, b), aPrime);\n    expect(viaA).toBe(viaB);\n    expect(viaA).toBe('c');\n  });\n\n  it('overlapping deletions', () => {\n    const original = 'abcde';\n    const a: Operation = { type: 'delete', pos: 1, length: 3 }; // delete \"bcd\"\n    const b: Operation = { type: 'delete', pos: 2, length: 3 }; // delete \"cde\"\n    const [aPrime, bPrime] = transform(a, b);\n\n    const viaA = applyOp(applyOp(original, a), bPrime);\n    const viaB = applyOp(applyOp(original, b), aPrime);\n    expect(viaA).toBe(viaB);\n    // Union of deletions: positions 1,2,3,4 → only \"a\" remains\n    expect(viaA).toBe('a');\n  });\n\n  it('one deletion fully contains the other', () => {\n    const original = 'abcdefgh';\n    const a: Operation = { type: 'delete', pos: 2, length: 4 }; // delete \"cdef\"\n    const b: Operation = { type: 'delete', pos: 3, length: 2 }; // delete \"de\"\n    const [aPrime, bPrime] = transform(a, b);\n\n    const viaA = applyOp(applyOp(original, a), bPrime);\n    const viaB = applyOp(applyOp(original, b), aPrime);\n    expect(viaA).toBe(viaB);\n    expect(viaA).toBe('abgh');\n  });\n});\n\n// ---- transformAgainst ----\n\ndescribe('transformAgainst', () => {\n  it('transforms through multiple prior operations', () => {\n    // Original: \"\"\n    // Prior ops: insert \"A\" at 0, insert \"B\" at 0 → \"BA\"\n    // New op: insert \"C\" at 0 with version 0 → should be transformed past both\n    const prior: Operation[] = [\n      { type: 'insert', pos: 0, text: 'A' },\n      { type: 'insert', pos: 0, text: 'B' },\n    ];\n    const newOp: Operation = { type: 'insert', pos: 0, text: 'C' };\n    const transformed = transformAgainst(newOp, prior);\n    expect(transformed.type).toBe('insert');\n    // After applying prior, string is \"BA\". C at 0 gives \"CBA\"\n    if (transformed.type === 'insert') {\n      expect(transformed.pos).toBe(0);\n    }\n  });\n});\n\n// ---- invertOp ----\n\ndescribe('invertOp', () => {\n  it('inverts an insert', () => {\n    const result = invertOp({ type: 'insert', pos: 3, text: 'HELLO' }, '');\n    expect(result).toEqual({ type: 'delete', pos: 3, length: 5 });\n  });\n\n  it('inverts a delete', () => {\n    const result = invertOp({ type: 'delete', pos: 2, length: 3 }, 'abXYZde');\n    expect(result).toEqual({ type: 'insert', pos: 2, text: 'XYZ' });\n  });\n});\n","numLines":219,"startLine":1,"totalLines":219}}}
