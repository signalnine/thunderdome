new file mode 100644
index 0000000..5d55d7f
--- /dev/null
+++ b/src/operational-transform.ts
@@ -0,0 +1,283 @@
+/**
+ * Operational Transform (OT) module for collaborative text editing.
+ *
+ * Supports two operation types:
+ *  - insert: Insert text at a given position
+ *  - delete: Delete a range of characters at a given position
+ *
+ * The core transform function takes two concurrent operations (both defined
+ * on the same original document state) and returns a pair [opA', opB'] such
+ * that applying opA then opB' yields the same result as applying opB then opA'.
+ *
+ * This is a server-authoritative OT system: clients send operations with
+ * their last-known version, and the server transforms them against any
+ * intervening operations before applying and broadcasting.
+ */
+
+// ---- Types ----
+
+export interface InsertOp {
+  type: 'insert';
+  pos: number;
+  text: string;
+}
+
+export interface DeleteOp {
+  type: 'delete';
+  pos: number;
+  length: number;
+}
+
+export type Operation = InsertOp | DeleteOp;
+
+// ---- Helpers ----
+
+function isNoOp(op: Operation): boolean {
+  return (op.type === 'insert' && op.text.length === 0) ||
+         (op.type === 'delete' && op.length <= 0);
+}
+
+// ---- Apply ----
+
+/**
+ * Apply an operation to a plain text string.
+ * Throws if the operation references positions outside the string.
+ */
+export function applyOp(str: string, op: Operation): string {
+  if (op.type === 'insert') {
+    if (op.pos < 0 || op.pos > str.length) {
+      throw new Error(`Insert position ${op.pos} out of range [0, ${str.length}]`);
+    }
+    return str.slice(0, op.pos) + op.text + str.slice(op.pos);
+  }
+
+  // delete
+  if (op.pos < 0 || op.pos + op.length > str.length) {
+    throw new Error(
+      `Delete [${op.pos}, ${op.pos + op.length}) out of range [0, ${str.length}]`,
+    );
+  }
+  return str.slice(0, op.pos) + str.slice(op.pos + op.length);
+}
+
+// ---- Core Transform ----
+
+/**
+ * Transform opA against opB. Both are defined on the same original state.
+ * Returns [opA', opB'] such that:
+ *   applyOp(applyOp(original, opA), opB') ===
+ *   applyOp(applyOp(original, opB), opA')
+ */
+export function transform(opA: Operation, opB: Operation): [Operation, Operation] {
+  if (isNoOp(opA)) return [opA, opB];
+  if (isNoOp(opB)) return [opA, opB];
+
+  if (opA.type === 'insert' && opB.type === 'insert') {
+    return transformInsertInsert(opA, opB);
+  }
+  if (opA.type === 'delete' && opB.type === 'delete') {
+    return transformDeleteDelete(opA, opB);
+  }
+  if (opA.type === 'insert' && opB.type === 'delete') {
+    return transformInsertDelete(opA, opB);
+  }
+  // delete vs insert — symmetric, swap
+  const [bPrime, aPrime] = transformInsertDelete(
+    { type: 'insert', pos: opB.pos, text: (opB as InsertOp).text },
+    { type: 'delete', pos: opA.pos, length: (opA as DeleteOp).length },
+  );
+  return [aPrime as DeleteOp, bPrime as InsertOp];
+}
+
+// ---- Individual transform pairs ----
+
+/**
+ * Both insert — the one with the smaller position (or same position but smaller
+ * clientId) goes first. Since we don't pass clientId here, equal positions use
+ * a stable tiebreaker: opA goes first.
+ */
+function transformInsertInsert(opA: InsertOp, opB: InsertOp): [InsertOp, InsertOp] {
+  // On tie, A goes first (stable tiebreaker by argument order)
+  if (opA.pos <= opB.pos) {
+    // A before or at same position as B
+    return [
+      { type: 'insert', pos: opA.pos, text: opA.text },
+      { type: 'insert', pos: opB.pos + opA.text.length, text: opB.text },
+    ];
+  }
+  // B before A
+  return [
+    { type: 'insert', pos: opA.pos + opB.text.length, text: opA.text },
+    { type: 'insert', pos: opB.pos, text: opB.text },
+  ];
+}
+
+/**
+ * Insert vs delete.
+ */
+function transformInsertDelete(
+  opA: InsertOp,
+  opB: DeleteOp,
+): [InsertOp, DeleteOp] {
+  const pos = opA.pos;
+  const dpos = opB.pos;
+  const dlen = opB.length;
+
+  // The OT literature convention: insert takes priority.
+  // If the insert lands inside the deleted range, the inserted text survives
+  // and gets placed at the deletion start.
+  if (pos <= dpos) {
+    // Insert before (or at) deletion start
+    return [
+      { type: 'insert', pos, text: opA.text },
+      { type: 'delete', pos: dpos + opA.text.length, length: dlen },
+    ];
+  }
+  if (pos >= dpos + dlen) {
+    // Insert after deletion range
+    return [
+      { type: 'insert', pos: pos - dlen, text: opA.text },
+      { type: 'delete', pos: dpos, length: dlen },
+    ];
+  }
+  // Insert is inside the deleted range — insert survives at dpos
+  return [
+    { type: 'insert', pos: dpos, text: opA.text },
+    { type: 'delete', pos: dpos, length: dlen + opA.text.length },
+  ];
+}
+
+/**
+ * Both delete. Returns the transformed pair, handling overlap.
+ * When deletions overlap, the union of deleted characters is preserved,
+ * and the resulting ops are adjusted to commute correctly.
+ */
+function transformDeleteDelete(
+  opA: DeleteOp,
+  opB: DeleteOp,
+): [DeleteOp, DeleteOp] {
+  const aStart = opA.pos;
+  const aEnd = opA.pos + opA.length;
+  const bStart = opB.pos;
+  const bEnd = opB.pos + opB.length;
+
+  // Determine overlap
+  const oStart = Math.max(aStart, bStart);
+  const oEnd = Math.min(aEnd, bEnd);
+  const overlap = Math.max(0, oEnd - oStart);
+
+  if (overlap === 0) {
+    // No overlap — just shift positions
+    if (aEnd <= bStart) {
+      // A entirely before B
+      return [
+        { type: 'delete', pos: aStart, length: opA.length },
+        { type: 'delete', pos: bStart - opA.length, length: opB.length },
+      ];
+    }
+    // B entirely before A
+    return [
+      { type: 'delete', pos: aStart - opB.length, length: opA.length },
+      { type: 'delete', pos: bStart, length: opB.length },
+    ];
+  }
+
+  // ---- Overlap exists ----
+  // Compute what A deletes after B has been applied.
+  // Characters in [aStart, aEnd) that were NOT in [bStart, bEnd) survive.
+  // (Characters in the overlap were already removed by B.)
+
+  // A after B:
+  // Part before overlap (if any): [aStart, oStart) — no shift
+  // Part after overlap (if any): [oEnd, aEnd) — shifted left by opB.length
+  const aParts: { pos: number; len: number }[] = [];
+
+  if (aStart < oStart) {
+    aParts.push({ pos: aStart, len: oStart - aStart });
+  }
+  if (aEnd > oEnd) {
+    aParts.push({ pos: oEnd - opB.length, len: aEnd - oEnd });
+  }
+
+  // B after A:
+  const bParts: { pos: number; len: number }[] = [];
+
+  if (bStart < oStart) {
+    bParts.push({ pos: bStart, len: oStart - bStart });
+  }
+  if (bEnd > oEnd) {
+    bParts.push({ pos: oEnd - opA.length, len: bEnd - oEnd });
+  }
+
+  // Merge parts into a single range if possible, otherwise combine them
+  const aPrime = mergeDeleteParts(aParts);
+  const bPrime = mergeDeleteParts(bParts);
+
+  return [aPrime, bPrime];
+}
+
+/**
+ * Merge zero, one, or two delete parts into a single DeleteOp.
+ * If all characters were overlap-deleted, returns a no-op.
+ */
+function mergeDeleteParts(parts: { pos: number; len: number }[]): DeleteOp {
+  if (parts.length === 0) {
+    return { type: 'delete', pos: 0, length: 0 };
+  }
+  if (parts.length === 1) {
+    return { type: 'delete', pos: parts[0].pos, length: parts[0].len };
+  }
+
+  // Two parts with a gap between them — merge the gap too
+  const first = parts[0]!;
+  const second = parts[1]!;
+  const gap = second.pos - (first.pos + first.len);
+  return {
+    type: 'delete',
+    pos: first.pos,
+    length: first.len + gap + second.len,
+  };
+}
+
+// ---- Batch transform ----
+
+/**
+ * Transform a single new operation against a list of prior (already-applied)
+ * operations in sequence. Returns the transformed operation suitable for
+ * applying to the current document state.
+ *
+ * This is used when a client's operation arrives at version V but the server
+ * has already applied operations V+1 … N.
+ */
+export function transformAgainst(
+  op: Operation,
+  prior: Operation[],
+): Operation {
+  let result: Operation = op;
+  for (const p of prior) {
+    const [transformed] = transform(result, p);
+    result = transformed;
+    if (isNoOp(result)) return result;
+  }
+  return result;
+}
+
+/**
+ * Compute the inverse of an operation, useful for undo or for establishing
+ * the identity: applyOp(applyOp(str, op), invertOp(op)) === str.
+ */
+export function invertOp(op: Operation, contextStr: string): Operation {
+  if (op.type === 'insert') {
+    return {
+      type: 'delete',
+      pos: op.pos,
+      length: op.text.length,
+    };
+  }
+  // delete — the deleted text is at contextStr[op.pos .. op.pos+op.length)
+  return {
+    type: 'insert',
+    pos: op.pos,
+    text: contextStr.slice(op.pos, op.pos + op.length),
+  };
+}
