+++ b/src/websocket.ts
@@ -0,0 +1,263 @@
+/**
+ * WebSocket handler for real-time collaborative editing.
+ *
+ * Each connected client joins a document room. Operations are transformed
+ * using OT before being applied and broadcast to other clients in the room.
+ *
+ * Protocol (JSON over WebSocket):
+ *   Server -> Client:
+ *     { type: "sync",     docId, content, version }
+ *     { type: "ack",      version }
+ *     { type: "operation", docId, operation, content, version, clientId }
+ *     { type: "error",    message }
+ *
+ *   Client -> Server:
+ *     { type: "operation", operation, version }
+ */
+
+import { type IncomingMessage } from 'http';
+import { WebSocketServer, WebSocket } from 'ws';
+import type { Server } from 'http';
+import type { DatabaseManager } from './database.js';
+import { applyOp, transformAgainst, type Operation } from './operational-transform.js';
+import crypto from 'crypto';
+
+// ---- Per-document room state ----
+
+interface Room {
+  /** Sorted list of applied operations from oldest to newest. */
+  ops: Operation[];
+  /** Current version number. */
+  version: number;
+  /** The version number when ops[0] was applied (base of the ops array). */
+  baseVersion: number;
+  /** Current document content. */
+  content: string;
+  /** Connected clients for this document. */
+  clients: Map<string, WebSocket>;
+}
+
+// ---- WebSocket Manager ----
+
+export class WsManager {
+  private wss: WebSocketServer;
+  private db: DatabaseManager;
+  /** Map of document ID -> room state. */
+  private rooms = new Map<string, Room>();
+
+  constructor(server: Server, db: DatabaseManager) {
+    this.db = db;
+    this.wss = new WebSocketServer({ noServer: true });
+
+    // Handle upgrade requests — only accept /ws/<docId> paths
+    server.on('upgrade', (request, socket, head) => {
+      const url = new URL(request.url ?? '/', `http://${request.headers.host ?? 'localhost'}`);
+      if (url.pathname.startsWith('/ws/')) {
+        this.wss.handleUpgrade(request, socket, head, (ws) => {
+          this.wss.emit('connection', ws, request);
+        });
+      } else {
+        socket.destroy();
+      }
+    });
+
+    this.wss.on('connection', (ws: WebSocket, req: IncomingMessage) => {
+      this.handleConnection(ws, req);
+    });
+  }
+
+  private handleConnection(ws: WebSocket, req: IncomingMessage): void {
+    // Extract document ID from URL path: /ws/<docId>
+    const url = new URL(req.url ?? '/', `http://${req.headers.host ?? 'localhost'}`);
+    const docId = url.pathname.replace('/ws/', '');
+
+    if (!docId) {
+      this.sendError(ws, 'WebSocket path must include document ID: /ws/<docId>');
+      ws.close();
+      return;
+    }
+
+    // Load document from database
+    const doc = this.db.getDocument(docId);
+    if (!doc) {
+      this.sendError(ws, `Document "${docId}" not found`);
+      ws.close();
+      return;
+    }
+
+    const clientId = crypto.randomUUID();
+    const room = this.getOrCreateRoom(doc);
+
+    // Register the client
+    room.clients.set(clientId, ws);
+    this.db.addConnection(clientId, docId);
+
+    // Send the current document state
+    this.send(ws, {
+      type: 'sync',
+      docId,
+      content: room.content,
+      version: room.version,
+      clientId,
+    });
+
+    // Handle incoming messages
+    ws.on('message', (raw: Buffer) => {
+      try {
+        const msg = JSON.parse(raw.toString('utf-8')) as Record<string, unknown>;
+        this.handleMessage(ws, clientId, docId, room, msg);
+      } catch {
+        this.sendError(ws, 'Invalid JSON message');
+      }
+    });
+
+    // Handle disconnect
+    ws.on('close', () => {
+      room.clients.delete(clientId);
+      try { this.db.removeConnection(clientId); } catch { /* server shutting down */ }
+      // Clean up empty rooms
+      if (room.clients.size === 0) {
+        this.rooms.delete(docId);
+      }
+    });
+
+    // Handle errors (don't crash)
+    ws.on('error', () => {
+      room.clients.delete(clientId);
+      try { this.db.removeConnection(clientId); } catch { /* server shutting down */ }
+    });
+  }
+
+  private handleMessage(
+    ws: WebSocket,
+    clientId: string,
+    docId: string,
+    room: Room,
+    msg: Record<string, unknown>,
+  ): void {
+    if (msg.type !== 'operation') {
+      this.sendError(ws, `Unknown message type: ${String(msg.type)}`);
+      return;
+    }
+
+    const operation = msg.operation as Record<string, unknown> | undefined;
+    const version = msg.version as number | undefined;
+
+    if (!operation || typeof version !== 'number') {
+      this.sendError(ws, 'operation and version are required');
+      return;
+    }
+
+    // Validate operation shape
+    if (operation.type !== 'insert' && operation.type !== 'delete') {
+      this.sendError(ws, 'operation.type must be "insert" or "delete"');
+      return;
+    }
+
+    if (typeof operation.pos !== 'number' || operation.pos < 0) {
+      this.sendError(ws, 'operation.pos is required and must be >= 0');
+      return;
+    }
+
+    if (operation.type === 'insert' && (typeof operation.text !== 'string' || operation.text.length === 0)) {
+      this.sendError(ws, 'insert operation requires non-empty text');
+      return;
+    }
+
+    if (operation.type === 'delete' && (typeof operation.length !== 'number' || operation.length <= 0)) {
+      this.sendError(ws, 'delete operation requires length > 0');
+      return;
+    }
+
+    // Check for concurrent edits
+    let op = operation as unknown as Operation;
+
+    if (version < room.version) {
+      // Transform this operation against intervening operations
+      const offset = Math.max(0, version - room.baseVersion);
+      const intervening = room.ops.slice(offset);
+      try {
+        op = transformAgainst(op, intervening);
+      } catch (err) {
+        this.sendError(ws, `Operation transformation failed: ${(err as Error).message}`);
+        return;
+      }
+    }
+
+    // Validate the (possibly transformed) operation against current state
+    try {
+      applyOp(room.content, op);
+    } catch (err) {
+      this.sendError(ws, `Operation invalid: ${(err as Error).message}`);
+      return;
+    }
+
+    // Apply the operation
+    const newContent = applyOp(room.content, op);
+    const newVersion = room.version + 1;
+
+    // Record in room state
+    room.ops.push(op);
+    room.content = newContent;
+    room.version = newVersion;
+
+    // Persist to database
+    this.db.applyOperation(docId, newContent, op, newVersion);
+
+    // Send ack to the originator
+    this.send(ws, { type: 'ack', version: newVersion, docId });
+
+    // Broadcast to all OTHER clients in the room
+    for (const [cId, client] of room.clients) {
+      if (cId !== clientId && client.readyState === WebSocket.OPEN) {
+        this.send(client, {
+          type: 'operation',
+          docId,
+          operation: op,
+          content: newContent,
+          version: newVersion,
+          clientId,
+        });
+      }
+    }
+  }
+
+  /**
+   * Get or create a room for a document.
+   * Loads state from the database on first access.
+   */
+  private getOrCreateRoom(doc: { id: string; content: string; version: number }): Room {
+    let room = this.rooms.get(doc.id);
+    if (!room) {
+      room = {
+        ops: [],
+        version: doc.version,
+        baseVersion: doc.version,
+        content: doc.content,
+        clients: new Map(),
+      };
+      this.rooms.set(doc.id, room);
+    }
+    return room;
+  }
+
+  private send(ws: WebSocket, data: Record<string, unknown>): void {
+    if (ws.readyState === WebSocket.OPEN) {
+      ws.send(JSON.stringify(data));
+    }
+  }
+
+  private sendError(ws: WebSocket, message: string): void {
+    this.send(ws, { type: 'error', message });
+  }
+
+  /**
+   * Gracefully close all connections and shut down the WebSocket server.
+   */
+  close(): void {
+    for (const client of this.wss.clients) {
+      client.close(1001, 'Server shutting down');
+    }
+    this.wss.close();
+  }
+}
