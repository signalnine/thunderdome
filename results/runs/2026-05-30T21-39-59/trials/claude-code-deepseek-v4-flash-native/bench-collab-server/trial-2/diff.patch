ts[1]!;\n  const gap = second.pos - (first.pos + first.len);\n  return {\n    type: 'delete',\n    pos: first.pos,\n    length: first.len + gap + second.len,\n  };\n}\n\n// ---- Batch transform ----\n\n/**\n * Transform a single new operation against a list of prior (already-applied)\n * operations in sequence. Returns the transformed operation suitable for\n * applying to the current document state.\n *\n * This is used when a client's operation arrives at version V but the server\n * has already applied operations V+1 … N.\n */\nexport function transformAgainst(\n  op: Operation,\n  prior: Operation[],\n): Operation {\n  let result: Operation = op;\n  for (const p of prior) {\n    const [transformed, _] = transform(result, p);\n    result = transformed;\n    if (isNoOp(result)) return result;\n  }\n  return result;\n}\n\n/**\n * Compute the inverse of an operation, useful for undo or for establishing\n * the identity: applyOp(applyOp(str, op), invertOp(op)) === str.\n */\nexport function invertOp(op: Operation, contextStr: string): Operation {\n  if (op.type === 'insert') {\n    return {\n      type: 'delete',\n      pos: op.pos,\n      length: op.text.length,\n    };\n  }\n  // delete — the deleted text is at contextStr[op.pos .. op.pos+op.length)\n  return {\n    type: 'insert',\n    pos: op.pos,\n    text: contextStr.slice(op.pos, op.pos + op.length),\n  };\n}\n","structuredPatch":[{"oldStart":254,"oldLines":7,"newStart":254,"newLines":7,"lines":[" ): Operation {","   let result: Operation = op;","   for (const p of prior) {","-    const [transformed, _] = transform(result, p);","+    const [transformed] = transform(result, p);","     result = transformed;","     if (isNoOp(result)) return result;","   }"]}],"userModified":false,"replaceAll":false}}
