 'abXYZde');\n    expect(result).toEqual({ type: 'insert', pos: 2, text: 'XYZ' });\n  });\n});\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":8,"lines":[" /**","  * Tests for the Operational Transform module.","+ *","+ * Covers: applyOp, transform (both directions), transformAgainst (one-way,","+ * server-side), and invertOp.","  */"," "," import { describe, it, expect } from 'vitest';"]},{"oldStart":69,"oldLines":20,"newStart":72,"newLines":6,"lines":["     expect(viaA).toBe(viaB);","     expect(viaA).toBe('heABllo');","   });","-","-  it('multiple concurrent inserts converge', () => {","-    const original = '';","-    const a: Operation = { type: 'insert', pos: 0, text: 'A' };","-    const b: Operation = { type: 'insert', pos: 0, text: 'B' };","-    const c: Operation = { type: 'insert', pos: 0, text: 'C' };","-    const [aPrime, bPrime] = transform(a, b);","-    const [aDoublePrime, cPrime] = transform(aPrime, c);","-    const [bDoublePrime, _cPrime] = transform(bPrime, c);","-    // All orders should converge","-    const order1 = applyOp(applyOp(applyOp(original, a), bPrime), cPrime);","-    const order2 = applyOp(applyOp(applyOp(original, b), aPrime), cPrime);","-    expect(order1).toBe(order2);","-  });"," });"," "," // ---- Transform: insert vs delete ----"]},{"oldStart":101,"oldLines":7,"newStart":90,"newLines":7,"lines":["   });"," ","   it('insert after delete', () => {","-    // A inserts \"X\" at 8, B deletes \"hello \" from 0","+    // A inserts \"X\" at 8 (original: 'r'), B deletes \"hello \" from 0","     const original = 'hello world';","     const a: Operation = { type: 'insert', pos: 8, text: 'X' };","     const b: Operation = { type: 'delete', pos: 0, length: 6 };"]},{"oldStart":110,"oldLines":22,"newStart":99,"newLines":31,"lines":["     const viaA = applyOp(applyOp(original, a), bPrime);","     const viaB = applyOp(applyOp(original, b), aPrime);","     expect(viaA).toBe(viaB);","-    expect(viaA).toBe('worldX');","+  