ions ----\n\n  addConnection(connectionId: string, documentId: string): void {\n    this.insertConnectionStmt.run({ id: connectionId, document_id: documentId });\n  }\n\n  removeConnection(connectionId: string): void {\n    this.deleteConnectionStmt.run({ id: connectionId });\n  }\n\n  getConnections(documentId: string): ConnectionRecord[] {\n    return this.getConnectionsStmt.all({ document_id: documentId }) as ConnectionRecord[];\n  }\n\n  // ---- Cleanup ----\n\n  close(): void {\n    this.db.close();\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":0,"cache_read_input_tokens":39808,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"782310fc-3819-4b54-9851-be0afa47ae6c","uuid":"ec2075c1-485e-4114-ad29-7e714f851acf"}
