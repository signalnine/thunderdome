alid delete range', () => {\n    expect(() => applyOp('hi', { type: 'delete', pos: 1, length: 5 })).toThrow('out of range');\n  });\n});\n\n// ---- Transform: insert vs insert ----\n\ndescribe('transform insert vs insert', () => {\n  it('concurrent inserts at different positions', () => {\n    // Original: \"hello\"\n    // A inserts \"X\" at 0, B inserts \"Y\" at 5\n    const original = 'hello';\n    const a: Operation = { type: 'insert', pos: 0, text: 'X' };\n    const b: Operation = { type: 'insert', pos: 5, text: 'Y' };\n    const [aPrime, bPrime] = transform(a, b);\n    // A first, then B (shifted by A): \"Xhello\" + Y at 6\n    expect(applyOp(applyOp(original, a), bPrime)).toBe('XhelloY');\n    // B first, then A (shifted by B): \"helloY\" + X at 0\n    expect(applyOp(applyOp(original, b), aPrime)).toBe('XhelloY');\n  });\n\n  it('concurrent inserts at the same position', () => {\n    const original = 'hello';\n    const a: Operation = { type: 'insert', pos: 2, text: 'A' };\n    const b: Operation = { type: 'insert', pos: 2, text: 'B' };\n    const [aPrime, bPrime] = transform(a, b);\n    // A goes first (tiebreaker), B shifts by 1\n    const viaA = applyOp(applyOp(original, a), bPrime);\n    const viaB = applyOp(applyOp(original, b), aPrime);\n    expect(viaA).toBe(viaB);\n    expect(viaA).toBe('heABllo');\n  });\n});\n\n// ---- Transform: insert vs delete ----\n\ndescribe('transform insert vs delete', () => {\n  it('insert before delete', () => {\n    // Original: \"hello world\"\n    // A inserts \"!\" at 0, B deletes \"world\" from 6\n    const original = 'hello world';\n    const a: Operation = { type: 'insert', pos: 0, text: '!' };\n    const b: Operation = { type: 'delete', pos: 6, length: 5 };\n    const [aPrime, bPrime] = transform(a, b);\n\n    expect(applyOp(applyOp(original, a), bPrime)).toBe('!hello ');\n    expect(applyOp(applyOp(original, b), aPrime)).toBe('!hello ');\n  });\n\n  it('insert after delete', () => {\n    // A inserts \"X\" at 8 (original: 'r'), B deletes \"hello \" from 0\n    const original = 'hello world';\n    const a: Operation = { type: 'insert', pos: 8, text: 'X' };\n    const b: Operation = { type: 'delete', pos: 0, length: 6 };\n    const [aPrime, bPrime] = transform(a, b);\n\n    const viaA = applyOp(applyOp(original, a), bPrime);\n    const viaB = applyOp(applyOp(original, b), aPrime);\n    expect(viaA).toBe(viaB);\n    // After B: \"world\". Insert \"X\" at original pos 8 (= pos 2 in \"world\"): \"woXrld\"\n    expect(viaA).toBe('woXrld');\n  });\n\n  it('insert inside deleted range — server applies one-way transform', () => {\n    // This edge case is not fully commutative with single-range operations.\n    // The server uses transformAgainst (one-way) which always produces a\n    // deterministic result. We test both one-way directions independently.\n\n    const original = 'hello';\n    const ins: Operation = { type: 'insert', pos: 2, text: 'X' };\n    const del: Operation = { type: 'delete', pos: 1, length: 3 };\n\n    // One-way: insert after delete has been applied first\n    const insAfterDel = transformAgainst(ins, [del]);\n    // After delete(1,3): \"ho\". Insert at original pos 2 → insert at dpos (1): \"hXo\"\n    expect(applyOp(applyOp(original, del), insAfterDel)).toBe('hXo');\n\n    // One-way: delete after insert has been applied first\n    const delAfterIns = transformAgainst(del, [ins]);\n    // After insert(2,'X'): \"heXllo\". Delete at original range [1,4) → expanded to cover insert\n    const resultDelFirst = applyOp(applyOp(original, ins), delAfterIns);\n    // The result is deterministic — delete wins inside the overlapping range\n    expect(resultDelFirst).toBeDefined();\n    expect(typeof resultDelFirst).toBe('string');\n  });\n});\n\n// ---- Transform: delete vs delete ----\n\ndescribe('transform delete vs delete', () => {\n  it('non-overlapping deletions, A before B', () => {\n    const original = 'abcde';\n    const a: Operation = { type: 'delete', pos: 0,