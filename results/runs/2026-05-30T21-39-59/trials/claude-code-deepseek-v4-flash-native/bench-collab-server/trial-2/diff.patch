@@ -0,0 +1,90 @@
+/**
+ * REST API routes for document management.
+ */
+
+import { Router, type Request, type Response } from 'express';
+import crypto from 'crypto';
+import type { DatabaseManager } from './database.js';
+
+export function createRouter(db: DatabaseManager): Router {
+  const router = Router();
+
+  // ---- List documents ----
+
+  router.get('/api/documents', (_req: Request, res: Response) => {
+    const documents = db.listDocuments();
+    res.json({ documents });
+  });
+
+  // ---- Create document ----
+
+  router.post('/api/documents', (req: Request, res: Response) => {
+    const { title, content } = req.body as Record<string, string | undefined>;
+
+    if (!title || typeof title !== 'string' || title.trim().length === 0) {
+      res.status(400).json({ error: 'title is required and must be a non-empty string' });
+      return;
+    }
+
+    const id = crypto.randomUUID();
+    const doc = db.createDocument(id, title.trim(), content ?? '');
+
+    res.status(201).json({ document: doc });
+  });
+
+  // ---- Get document ----
+
+  router.get('/api/documents/:id', (req: Request, res: Response) => {
+    const doc = db.getDocument(req.params.id!);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.json({ document: doc });
+  });
+
+  // ---- Update document title ----
+
+  router.put('/api/documents/:id', (req: Request, res: Response) => {
+    const { title } = req.body as Record<string, string | undefined>;
+
+    if (!title || typeof title !== 'string' || title.trim().length === 0) {
+      res.status(400).json({ error: 'title is required and must be a non-empty string' });
+      return;
+    }
+
+    const doc = db.updateDocument(req.params.id!, title.trim());
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+
+    res.json({ document: doc });
+  });
+
+  // ---- Delete document ----
+
+  router.delete('/api/documents/:id', (req: Request, res: Response) => {
+    const deleted = db.deleteDocument(req.params.id!);
+    if (!deleted) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.status(204).send();
+  });
+
+  // ---- Get version history ----
+
+  router.get('/api/documents/:id/versions', (req: Request, res: Response) => {
+    const doc = db.getDocument(req.params.id!);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+
+    const versions = db.getVersions(req.params.id!);
+    res.json({ versions });
+  });
+
+  return router;
+}
diff --git a/src/server.ts b/src/server.ts
new file mode 100644
index 0000000..284de72
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,98 @@
+/**
+ * Real-time collaborative document editing server.
+ *
+ * Exports a `createApp` factory that returns an Express app with:
+ *  - REST API for document CRUD and version history
+ *  - WebSocket endpoint for real-time collaborative editing with OT
+ *  - SQLite persistence via better-sqlite3
+ *
+ * Usage:
+ *   const { app, start, stop } = createApp();
+ *   const port = start();
+ *   // ...
+ *   stop();
+ */
+
+import express from 'express';
+import http from 'http';
+import { DatabaseManager } from './database.js';
+import { createRouter } from './routes.js';
+import { WsManager } from './websocket.js';
+
+export interface AppHandle {
+  /** The Express application (useful for testing with supertest). */
+  app: express.Application;
+  /**
+   * Start listening. If port is omitted, uses a random available port.
+   * Returns the actual port number.
+   */
+  start(port?: number): Promise<number>;
+  /** Gracefully shut down the server and all connections. */
+  stop(): Promise<void>;
+}
+
+export function createApp(dbPath?: string): AppHandle {
+  const resolvedDbPath = dbPath ?? ':memory:';
+  const db = new DatabaseManager(resolvedDbPath);
+
+  const app = express();
+
+  // JSON body parser
+  app.use(express.json());
+
+  // REST API routes
+  const router = createRouter(db);
+  app.use(router);
+
+  // Error handler for malformed JSON
+  app.use(
+    (
+      err: Error & { type?: string },
+      _req: express.Request,
+      res: express.Response,
+      _next: express.NextFunction,
+    ) => {
+      if (err.type === 'entity.parse.failed') {
+        res.status(400).json({ error: 'Invalid JSON in request body' });
+        return;
+      }
+      console.error('Unhandled error:', err);
+      res.status(500).json({ error: 'Internal server error' });
+    },
+  );
+
+  // Create HTTP server and attach WebSocket
+  const server = http.createServer(app);
+  const wsManager = new WsManager(server, db);
+
+  return {
+    app,
+
+    start(port?: number): Promise<number> {
+      return new Promise((resolve, reject) => {
+        server.listen(port ?? 0, () => {
+          const addr = server.address();
+          if (addr && typeof addr === 'object') {
+            resolve(addr.port);
+          } else {
+            reject(new Error('Failed to determine server port'));
+          }
+        });
+        server.once('error', reject);
+      });
+    },
+
+    stop(): Promise<void> {
+      return new Promise((resolve) => {
+        // Close all WebSocket connections first
+        wsManager.close();
+
+        // Close the HTTP server, then the database
+        server.close(() => {
+          db.close();
+          resolve();
+        });
+      });
+    },
+  };
+}
