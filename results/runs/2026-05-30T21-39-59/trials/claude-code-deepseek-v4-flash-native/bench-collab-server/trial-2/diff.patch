new file mode 100644
index 0000000..98d81ed
--- /dev/null
+++ b/src/database.ts
@@ -0,0 +1,277 @@
+/**
+ * SQLite-backed persistence layer for documents, version history, and
+ * active WebSocket connections.
+ */
+
+import Database from 'better-sqlite3';
+import type { Operation } from './operational-transform.js';
+
+// ---- Types ----
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+  version: number;
+}
+
+export interface VersionRecord {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+export interface ConnectionRecord {
+  id: string;
+  document_id: string;
+  connected_at: string;
+}
+
+// ---- Database class ----
+
+export class DatabaseManager {
+  private db: Database.Database;
+  private insertDocStmt!: Database.Statement;
+  private getDocStmt!: Database.Statement;
+  private updateDocStmt!: Database.Statement;
+  private updateDocContentStmt!: Database.Statement;
+  private deleteDocStmt!: Database.Statement;
+  private listDocsStmt!: Database.Statement;
+  private insertVersionStmt!: Database.Statement;
+  private getVersionsStmt!: Database.Statement;
+  private getLatestVersionStmt!: Database.Statement;
+  private insertConnectionStmt!: Database.Statement;
+  private deleteConnectionStmt!: Database.Statement;
+  private getConnectionsStmt!: Database.Statement;
+  private initDocVersionStmt!: Database.Statement;
+
+  constructor(dbPath: string) {
+    this.db = new Database(dbPath);
+    this.db.pragma('journal_mode = WAL');
+    this.db.pragma('foreign_keys = ON');
+    this.initializeSchema();
+    this.prepareStatements();
+  }
+
+  private initializeSchema(): void {
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS documents (
+        id TEXT PRIMARY KEY,
+        title TEXT NOT NULL,
+        content TEXT NOT NULL DEFAULT '',
+        created_at TEXT NOT NULL DEFAULT (datetime('now')),
+        updated_at TEXT NOT NULL DEFAULT (datetime('now')),
+        version INTEGER NOT NULL DEFAULT 1
+      );
+
+      CREATE TABLE IF NOT EXISTS versions (
+        id INTEGER PRIMARY KEY AUTOINCREMENT,
+        document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+        version INTEGER NOT NULL,
+        content TEXT NOT NULL,
+        operation TEXT,
+        created_at TEXT NOT NULL DEFAULT (datetime('now')),
+        UNIQUE(document_id, version)
+      );
+
+      CREATE TABLE IF NOT EXISTS active_connections (
+        id TEXT PRIMARY KEY,
+        document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+        connected_at TEXT NOT NULL DEFAULT (datetime('now'))
+      );
+    `);
+  }
+
+  private prepareStatements(): void {
+    this.insertDocStmt = this.db.prepare(
+      `INSERT INTO documents (id, title, content, version)
+       VALUES (@id, @title, @content, @version)`,
+    );
+
+    this.getDocStmt = this.db.prepare(
+      `SELECT id, title, content, created_at, updated_at, version
+       FROM documents WHERE id = @id`,
+    );
+
+    this.updateDocStmt = this.db.prepare(
+      `UPDATE documents
+       SET title = @title, updated_at = datetime('now')
+       WHERE id = @id`,
+    );
+
+    this.updateDocContentStmt = this.db.prepare(
+      `UPDATE documents
+       SET content = @content, version = @version, updated_at = datetime('now')
+       WHERE id = @id`,
+    );
+
+    this.deleteDocStmt = this.db.prepare(
+      `DELETE FROM documents WHERE id = @id`,
+    );
+
+    this.listDocsStmt = this.db.prepare(
+      `SELECT id, title, content, created_at, updated_at, version
+       FROM documents ORDER BY updated_at DESC`,
+    );
+
+    this.insertVersionStmt = this.db.prepare(
+      `INSERT INTO versions (document_id, version, content, operation)
+       VALUES (@document_id, @version, @content, @operation)`,
+    );
+
+    this.getVersionsStmt = this.db.prepare(
+      `SELECT id, document_id, version, content, operation, created_at
+       FROM versions
+       WHERE document_id = @document_id
+       ORDER BY version ASC`,
+    );
+
+    this.getLatestVersionStmt = this.db.prepare(
+      `SELECT MAX(version) as max_version FROM versions WHERE document_id = @document_id`,
+    );
+
+    this.insertConnectionStmt = this.db.prepare(
+      `INSERT INTO active_connections (id, document_id)
+       VALUES (@id, @document_id)`,
+    );
+
+    this.deleteConnectionStmt = this.db.prepare(
+      `DELETE FROM active_connections WHERE id = @id`,
+    );
+
+    this.getConnectionsStmt = this.db.prepare(
+      `SELECT id, document_id, connected_at
+       FROM active_connections WHERE document_id = @document_id`,
+    );
+
+    this.initDocVersionStmt = this.db.prepare(
+      `INSERT INTO versions (document_id, version, content, operation)
+       VALUES (@document_id, 1, @content, NULL)`,
+    );
+  }
+
+  // ---- Document CRUD ----
+
+  createDocument(id: string, title: string, content = ''): Document {
+    const insertVersion = this.db.transaction(() => {
+      this.insertDocStmt.run({ id, title, content, version: 1 });
+      this.initDocVersionStmt.run({ document_id: id, content });
+    });
+    insertVersion();
+    return this.getDocStmt.get({ id }) as Document;
+  }
+
+  getDocument(id: string): Document | undefined {
+    return this.getDocStmt.get({ id }) as Document | undefined;
+  }
+
+  updateDocument(id: string, title: string): Document | undefined {
+    const result = this.updateDocStmt.run({ id, title });
+    if (result.changes === 0) return undefined;
+    return this.getDocStmt.get({ id }) as Document | undefined;
+  }
+
+  deleteDocument(id: string): boolean {
+    const result = this.deleteDocStmt.run({ id });
+    return result.changes > 0;
+  }
+
+  listDocuments(): Document[] {
+    return this.listDocsStmt.all() as Document[];
+  }
+
+  // ---- Content updates with version tracking ----
+
+  /**
+   * Apply an operation to the document content and record the new version.
+   * Returns the updated document, or undefined if the document doesn't exist.
+   */
+  applyOperation(
+    docId: string,
+    newContent: string,
+    operation: Operation,
+    newVersion: number,
+  ): Document | undefined {
+    const apply = this.db.transaction(() => {
+      const result = this.updateDocContentStmt.run({
+        id: docId,
+        content: newContent,
+        version: newVersion,
+      });
+      if (result.changes === 0) return undefined;
+
+      this.insertVersionStmt.run({
+        document_id: docId,
+        version: newVersion,
+        content: newContent,
+        operation: JSON.stringify(operation),
+      });
+
+      return this.getDocStmt.get({ id: docId }) as Document;
+    });
+    return apply();
+  }
+
+  setDocumentContent(
+    docId: string,
+    content: string,
+    version: number,
+  ): Document | undefined {
+    const update = this.db.transaction(() => {
+      const result = this.updateDocContentStmt.run({
+        id: docId,
+        content,
+        version,
+      });
+      if (result.changes === 0) return undefined;
+
+      this.insertVersionStmt.run({
+        document_id: docId,
+        version,
+        content,
+        operation: null,
+      });
+
+      return this.getDocStmt.get({ id: docId }) as Document;
+    });
+    return update();
+  }
+
+  // ---- Version history ----
+
+  getVersions(documentId: string): VersionRecord[] {
+    return this.getVersionsStmt.all({ document_id: documentId }) as VersionRecord[];
+  }
+
+  getLatestVersionNumber(documentId: string): number {
+    const row = this.getLatestVersionStmt.get({ document_id: documentId }) as
+      | { max_version: number | null }
+      | undefined;
+    return row?.max_version ?? 0;
+  }
+
+  // ---- Active connections ----
+
+  addConnection(connectionId: string, documentId: string): void {
+    this.insertConnectionStmt.run({ id: connectionId, document_id: documentId });
+  }
+
+  removeConnection(connectionId: string): void {
+    this.deleteConnectionStmt.run({ id: connectionId });
+  }
+
+  getConnections(documentId: string): ConnectionRecord[] {
+    return this.getConnectionsStmt.all({ document_id: documentId }) as ConnectionRecord[];
+  }
+
+  // ---- Cleanup ----
+
+  close(): void {
+    this.db.close();
+  }
+}
