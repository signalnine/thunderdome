AppHandle {\n  const resolvedDbPath = dbPath ?? ':memory:';\n  const db = new DatabaseManager(resolvedDbPath);\n\n  const app = express();\n\n  // JSON body parser\n  app.use(express.json());\n\n  // REST API routes\n  const router = createRouter(db);\n  app.use(router);\n\n  // Error handler for malformed JSON\n  app.use(\n    (\n      err: Error,\n      _req: express.Request,\n      res: express.Response,\n      _next: express.NextFunction,\n    ) => {\n      if (err.type === 'entity.parse.failed') {\n        res.status(400).json({ error: 'Invalid JSON in request body' });\n        return;\n      }\n      console.error('Unhandled error:', err);\n      res.status(500).json({ error: 'Internal server error' });\n    },\n  );\n\n  // Create HTTP server and attach WebSocket\n  const server = http.createServer(app);\n  const wsManager = new WsManager(server, db);\n\n  return {\n    app,\n\n    start(port?: number): Promise<number> {\n      return new Promise((resolve, reject) => {\n        server.listen(port ?? 0, () => {\n          const addr = server.address();\n          if (addr && typeof addr === 'object') {\n            resolve(addr.port);\n          } else {\n            reject(new Error('Failed to determine server port'));\n          }\n        });\n        server.once('error', reject);\n      });\n    },\n\n    stop(): Promise<void> {\n      return new Promise((resolve) => {\n        wsManager.close();\n        server.close(() => {\n          db.close();\n          resolve();\n        });\n      });\n    },\n  };\n}\n","structuredPatch":[{"oldStart":47,"oldLines":7,"newStart":47,"newLines":7,"lines":["   // Error handler for malformed JSON","   app.use(","     (","-      err: Error,","+      err: Error & { type?: string },","       _req: express.Request,","       res: express.Response,","       _next: express.NextFunction,"]}],"userModified":false,"replaceAll":false}}
