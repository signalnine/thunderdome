ument/${docId}`);\n\n    const init1 = await c1.waitForInit() as { version: number };\n    await c2.waitForInit();\n\n    // Both send operations at the same version\n    c1.ws.send(JSON.stringify({\n      type: 'operation',\n      operation: { type: 'insert', pos: 0, text: '1-' },\n      version: init1.version,\n    }));\n    c2.ws.send(JSON.stringify({\n      type: 'operation',\n      operation: { type: 'insert', pos: 3, text: '-2-' },\n      version: init1.version,\n    }));\n\n    // Read all 4 messages (ack + broadcast for each client)\n    const msgs1 = await Promise.all([c1.read(3000), c1.read(3000)]);\n    const msgs2 = await Promise.all([c2.read(3000), c2.read(3000)]);\n\n    const allMsgs = [...msgs1, ...msgs2];\n    expect(allMsgs.filter(m => (m as { type: string }).type === 'ack')).toHaveLength(2);\n    expect(allMsgs.filter(m => (m as { type: string }).type === 'operation')).toHaveLength(2);\n\n    // Both should converge to the same content via REST\n    const docAfter = await fetch(`${url}/api/documents/${docId}`);\n    const doc = await docAfter.json();\n    const content = doc.content;\n\n    // Both inserts should be preserved\n    expect(content).toContain('1-');\n    expect(content).toContain('-2-');\n\n    c1.ws.close();\n    c2.ws.close();\n  });","originalFile":"/**\n * Tests for the Real-Time Collaborative Document Editor.\n *\n * Covers:\n *  1. OT engine correctness (apply, transform, compose)\n *  2. Server REST API (CRUD + version history)\n *  3. WebSocket collaboration / convergence\n */\n\nimport { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport { randomUUID } from 'crypto';\nimport WebSocket from 'ws';\nimport { apply, transform, compose } from '../src/ot.js';\nimport { createApp, type AppHandle } from '../src/server.js';\n\n// ── Helper ───────────────────────────────────────────────────────\n\nconst TEST_DB = `test-${randomUUID()}.db`;\n\n/** Start the server on a random port and return the URL. */\nasync function startServer(): Promise<{ handle: AppHandle; port: number; url: string }> {\n  const handle = createApp(TEST_DB);\n  const port = await handle.start(0);\n  const url = `http://localhost:${port}`;\n  return { handle, port, url };\n}\n\n/** Wait for a WebSocket to open AND read its first message, avoiding race conditions. */\nfunction wsConnectAndRead(url: string, timeout = 5000): Promise<{ ws: WebSocket; msg: unknown }> {\n  return new Promise((resolve, reject) => {\n    const ws = new WebSocket(url);\n    let resolved = false;\n    const timer = setTimeout(() => {\n      if (!resolved) reject(new Error('WebSocket connect/read timeout'));\n    }, timeout);\n\n    ws.on('open', () => {\n      ws.once('message', (data) => {\n        resolved = true;\n        clearTimeout(timer);\n        try {\n          resolve({ ws, msg: JSON.parse(data.toString()) });\n        } catch (e) {\n          reject(e);\n        }\n      });\n    });\n\n    ws.on('error', (err) => {\n      resolved = true;\n      clearTimeout(timer);\n      reject(err);\n    });\n  });\n}\n\n/**\n * Collects all WebSocket messages into a buffer and provides\n * a `read()` function to dequeue them one at a time.\n * This avoids race conditions when messages arrive back-to-back.\n */\nfunction wsWithBuffer(url: string, timeout = 5000): Promise<{ ws: WebSocket; read: (t?: number) => Promise<unknown>; waitForInit: () => Promise<unknown> }> {\n  return new Promise((resolve, reject) => {\n    const ws = new WebSocket(url);\n    const buf: unknown[] = [];\n    const pending: Array<{ resolve: (v: unknown) => void; reject: (e: Error) => void; timer: ReturnType<typeof setTimeout> }> = [];\n    let initResolve: ((v: unknown) => void) | null = null;\n    let initReject: ((e: Error) => void) | null = null;\n\n    let timer = setTimeout(() => {\n      reject(new Error('WebSocket connection timeout'));\n    }, timeout);\n\n    ws.on('open', () => {\n      clearTimeout(timer);\n      // Attach a persistent message handler that buffers everything\n      ws.on('message', (data) => {\n        let parsed: unknown;\n        try { parsed = JSON.parse(data.toString()); } catch { return; }\n\n        // If someone is waiting via read(), resolve them\n        if (pending.length > 0) {\n          const p = pending.shift()!;\n          clearTimeout(p.timer);\n          p.resolve(parsed);\n          return;\n        }\n\n        // Otherwise buffer it\n        buf.push(parsed);\n\n        // First message resolves the init promise\n        if (initResolve) {\n          initResolve(parsed);\n          initResolve = null;\n          initReject = null;\n        }\n      });\n    });\n\n    ws.on('error', (err) => {\n      clearTimeout(timer);\n      if (initReject) initReject(err);\n      reject(err);\n    });\n\n    function read(readTimeout = 5000): Promise<unknown> {\n      return new Promise((resolve, reject) => {\n        if (buf.length > 0) {\n          resolve(buf.shift()!);\n          return;\n        }\n        const rtimer = setTimeout(() => reject(new Error('WebSocket read timeout')), readTimeout);\n        pending.push({ resolve, reject: (e) => { clearTimeout(rtimer); reject(e); }, timer: rtimer });\n      });\n    }\n\n    function waitForInit(): Promise<unknown> {\n      return new Promise((resolve, reject) => {\n        if (buf.length > 0) {\n          resolve(buf.shift()!);\n          return;\n        }\n        initResolve = resolve;\n        initReject = reject;\n      });\n    }\n\n    // Resolve the outer promise once open + message listener are attached\n    ws.on('open', () => {\n      resolve({ ws, read, waitForInit });\n    });\n  });\n}\n\n/** Read a JSON message from a WebSocket (with timeout). */\nfunction wsRead(ws: WebSocket, timeout = 3000): Promise<unknown> {\n  return new Promise((resolve, reject) => {\n    const timer = setTimeout(() => reject(new Error('WebSocket read timeout')), timeout);\n    ws.once('message', (data) => {\n      clearTimeout(timer);\n      try {\n        resolve(JSON.parse(data.toString()));\n      } catch (e) {\n        reject(e);\n      }\n    });\n    ws.once('error', (err) => {\n      clearTimeout(timer);\n      reject(err);\n    });\n  });\n}\n\n/** Send JSON over a WebSocket. */\nfunction wsSend(ws: WebSocket, msg: unknown): void {\n  ws.send(JSON.stringify(msg));\n}\n\n// Clean up test db\nasync function cleanup(path: string): Promise<void> {\n  try {\n    const { unlink } = await import('fs/promises');\n    await unlink(path).catch(() => {});\n    await unlink(path + '-wal').catch(() => {});\n    await unlink(path + '-shm').catch(() => {});\n  } catch { /* ignore */ }\n}\n\n// ── OT Unit Tests ────────────────────────────────────────────────\n\ndescribe('OT Engine', () => {\n  describe('apply', () => {\n    it('inserts text at position 0', () => {\n      expect(apply('world', { type: 'insert', pos: 0, text: 'hello ' })).toBe('hello world');\n    });\n\n    it('inserts text at end', () => {\n      expect(apply('hello', { type: 'insert', pos: 5, text: ' world' })).toBe('hello world');\n    });\n\n    it('inserts text in the middle', () => {\n      expect(apply('hello world', { type: 'insert', pos: 5, text: ' cruel' })).toBe('hello cruel world');\n    });\n\n    it('deletes text from start', () => {\n      expect(apply('hello world', { type: 'delete', pos: 0, length: 6 })).toBe('world');\n    });\n\n    it('deletes text from end', () => {\n      expect(apply('hello world', { type: 'delete', pos: 5, length: 6 })).toBe('hello');\n    });\n\n    it('deletes text in the middle', () => {\n      expect(apply('hello world', { type: 'delete', pos: 5, length: 1 })).toBe('helloworld');\n    });\n  });\n\n  describe('transform – insert vs insert', () => {\n    it('shifts second insert when positions are equal', () => {\n      const op1 = { type: 'insert' as const, pos: 3, text: 'A' };\n      const op2 = { type: 'insert' as const, pos: 3, text: 'B' };\n      // op1 was applied first, transform op2 against op1\n      const t2 = transform(op2, op1)!;\n      expect(t2).toEqual({ type: 'insert', pos: 4, text: 'B' });\n      expect(apply(apply('hello', op1), t2)).toBe('helABlo');\n    });\n\n    it('does not shift earlier insert', () => {\n      const op1 = { type: 'insert' as const, pos: 5, text: 'A' };\n      const op2 = { type: 'insert' as const, pos: 3, text: 'B' };\n      const t2 = transform(op2, op1)!;\n      expect(t2).toEqual({ type: 'insert', pos: 3, text: 'B' }); // unchanged, before op1\n    });\n\n    it('converges regardless of order', () => {\n      const S = 'abcd';\n      const a = { type: 'insert' as const, pos: 1, text: 'X' };\n      const b = { type: 'insert' as const, pos: 3, text: 'Y' };\n      const aT = transform(a, b);\n      const bT = transform(b, a);\n      expect(apply(apply(S, a), bT!)).toBe(apply(apply(S, b), aT!));\n    });\n  });\n\n  describe('transform – insert vs delete', () => {\n    it('insert before delete – unchanged', () => {\n      const ins = { type: 'insert' as const, pos: 2, text: 'XX' };\n      const del = { type: 'delete' as const, pos: 5, length: 3 };\n      const t = transform(ins, del);\n      expect(t).toEqual(ins);\n    });\n\n    it('insert after delete – shifts left', () => {\n      const ins = { type: 'insert' as const, pos: 10, text: 'XX' };\n      const del = { type: 'delete' as const, pos: 5, length: 3 };\n      const t = transform(ins, del);\n      expect(t).toEqual({ type: 'insert', pos: 7, text: 'XX' });\n    });\n\n    it('insert inside deleted range – moves to start', () => {\n      const ins = { type: 'insert' as const, pos: 6, text: 'XX' };\n      const del = { type: 'delete' as const, pos: 5, length: 3 };\n      const t = transform(ins, del);\n      expect(t).toEqual({ type: 'insert', pos: 5, text: 'XX' });\n    });\n\n    it('converges delete then insert', () => {\n      const S = 'hello world';\n      const del = { type: 'delete' as const, pos: 5, length: 6 }; // deletes \" world\"\n      const ins = { type: 'insert' as const, pos: 5, text: ' beautiful' };\n      const delT = transform(del, ins);\n      const insT = transform(ins, del);\n      expect(apply(apply(S, del), insT!)).toBe(apply(apply(S, ins), delT!));\n    });\n  });\n\n  describe('transform – delete vs delete', () => {\n    it('non-overlapping – before', () => {\n      const a = { type: 'delete' as const, pos: 0, length: 2 };\n      const b = { type: 'delete' as const, pos: 4, length: 2 };\n      const aT = transform(a, b);\n      const bT = transform(b, a);\n      // Should converge\n      const S = 'hello world';\n      expect(apply(apply(S, a), bT!)).toBe(apply(apply(S, b), aT!));\n    });\n\n    it('non-overlapping – after, shifts left', () => {\n      const a = { type: 'delete' as const, pos: 4, length: 2 };\n      const b = { type: 'delete' as const, pos: 0, length: 2 };\n      const aT = transform(a, b);\n      expect(aT).toEqual({ type: 'delete', pos: 2, length: 2 });\n    });\n\n    it('overlapping – a starts before b', () => {\n      const a = { type: 'delete' as const, pos: 0, length: 4 };\n      const b = { type: 'delete' as const, pos: 2, length: 3 };\n      const S = 'hello world';\n      const aT = transform(a, b);\n      const bT = transform(b, a);\n      expect(apply(apply(S, a), bT!)).toBe(apply(apply(S, b), aT!));\n    });\n\n    it('identical deletions – second becomes no-op', () => {\n      const a = { type: 'delete' as const, pos: 2, length: 3 };\n      const b = { type: 'delete' as const, pos: 2, length: 3 };\n      const bT = transform(b, a);\n      expect(bT).toBeNull();\n    });\n  });\n\n  describe('compose', () => {\n    it('composes two inserts', () => {\n      const a = { type: 'insert' as const, pos: 0, text: 'A' };\n      const b = { type: 'insert' as const, pos: 1, text: 'B' };\n      const c = compose(a, b);\n      expect(c).toBeDefined();\n      if (c) {\n        expect(apply(apply('', a), b)).toBe(apply('', c));\n      }\n    });\n  });\n});\n\n// ── Server Integration Tests ─────────────────────────────────────\n\ndescribe('Server REST API', () => {\n  let handle: AppHandle;\n  let url: string;\n  let port: number;\n\n  beforeEach(async () => {\n    const s = await startServer();\n    handle = s.handle;\n    port = s.port;\n    url = s.url;\n  });\n\n  afterEach(async () => {\n    await handle.stop();\n    await cleanup(TEST_DB);\n  });\n\n  it('creates a document', async () => {\n    const res = await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'Test Doc', content: 'Hello!' }),\n    });\n    expect(res.status).toBe(201);\n    const doc = await res.json();\n    expect(doc.title).toBe('Test Doc');\n    expect(doc.content).toBe('Hello!');\n    expect(doc.id).toBeDefined();\n  });\n\n  it('rejects document creation without title', async () => {\n    const res = await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ content: 'no title' }),\n    });\n    expect(res.status).toBe(400);\n  });\n\n  it('lists documents', async () => {\n    await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'A' }),\n    });\n    await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'B' }),\n    });\n    const res = await fetch(`${url}/api/documents`);\n    const docs = await res.json();\n    expect(docs.length).toBeGreaterThanOrEqual(2);\n  });\n\n  it('gets a single document', async () => {\n    const create = await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'My Doc' }),\n    });\n    const created = await create.json();\n    const res = await fetch(`${url}/api/documents/${created.id}`);\n    const doc = await res.json();\n    expect(doc.id).toBe(created.id);\n    expect(doc.title).toBe('My Doc');\n  });\n\n  it('returns 404 for unknown document', async () => {\n    const res = await fetch(`${url}/api/documents/nonexistent`);\n    expect(res.status).toBe(404);\n  });\n\n  it('updates a document', async () => {\n    const create = await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'Original', content: 'Old content' }),\n    });\n    const created = await create.json();\n    const res = await fetch(`${url}/api/documents/${created.id}`, {\n      method: 'PUT',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'Updated', content: 'New content' }),\n    });\n    const doc = await res.json();\n    expect(doc.title).toBe('Updated');\n    expect(doc.content).toBe('New content');\n  });\n\n  it('deletes a document', async () => {\n    const create = await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'To Delete' }),\n    });\n    const created = await create.json();\n    const del = await fetch(`${url}/api/documents/${created.id}`, { method: 'DELETE' });\n    expect(del.status).toBe(204);\n    const get = await fetch(`${url}/api/documents/${created.id}`);\n    expect(get.status).toBe(404);\n  });\n\n  it('returns version history', async () => {\n    const create = await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'Versions', content: 'Initial' }),\n    });\n    const created = await create.json();\n    const res = await fetch(`${url}/api/documents/${created.id}/versions`);\n    const versions = await res.json();\n    expect(versions.length).toBeGreaterThanOrEqual(1);\n    expect(versions[0].content).toBe('Initial');\n  });\n});\n\n// ── WebSocket Collaboration Tests ────────────────────────────────\n\ndescribe('WebSocket Collaboration', () => {\n  let handle: AppHandle;\n  let url: string;\n  let port: number;\n  let docId: string;\n\n  beforeEach(async () => {\n    const s = await startServer();\n    handle = s.handle;\n    port = s.port;\n    url = s.url;\n\n    // Create a document\n    const res = await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'Collab', content: 'Hello world' }),\n    });\n    const doc = await res.json();\n    docId = doc.id;\n  });\n\n  afterEach(async () => {\n    await handle.stop();\n    await cleanup(TEST_DB);\n  });\n\n  it('receives init when connecting', async () => {\n    const { ws, msg } = await wsConnectAndRead(`ws://localhost:${port}/document/${docId}`);\n    const init = msg as { type: string; content: string; version: number };\n    expect(init.type).toBe('init');\n    expect(init.content).toBe('Hello world');\n    expect(init.version).toBeGreaterThanOrEqual(0);\n    ws.close();\n  });\n\n  it('sends an operation and receives ack', async () => {\n    const { ws, msg } = await wsConnectAndRead(`ws://localhost:${port}/document/${docId}`);\n    const init = msg as { version: number };\n\n    wsSend(ws, {\n      type: 'operation',\n      operation: { type: 'insert', pos: 11, text: '!' },\n      version: init.version,\n    });\n\n    const ack = await wsRead(ws) as { type: string; version: number };\n    expect(ack.type).toBe('ack');\n    expect(ack.version).toBe(init.version + 1);\n\n    // Verify via REST\n    const res = await fetch(`${url}/api/documents/${docId}`);\n    const doc = await res.json();\n    expect(doc.content).toBe('Hello world!');\n    ws.close();\n  });\n\n  it('broadcasts operations to other clients', async () => {\n    const { ws: ws1 } = await wsConnectAndRead(`ws://localhost:${port}/document/${docId}`);\n    const { ws: ws2, msg: init2 } = await wsConnectAndRead(`ws://localhost:${port}/document/${docId}`);\n\n    const initMsg = init2 as { version: number };\n\n    // Client 1 sends an operation\n    wsSend(ws1, {\n      type: 'operation',\n      operation: { type: 'insert', pos: 0, text: 'Hi! ' },\n      version: initMsg.version,\n    });\n\n    // ws1 gets ack\n    await wsRead(ws1);\n\n    // ws2 should receive the broadcast\n    const broadcast = await wsRead(ws2) as { type: string; operation: unknown };\n    expect(broadcast.type).toBe('operation');\n    expect(broadcast.operation).toEqual({ type: 'insert', pos: 0, text: 'Hi! ' });\n\n    // Verify final content\n    const res = await fetch(`${url}/api/documents/${docId}`);\n    const doc = await res.json();\n    expect(doc.content).toBe('Hi! Hello world');\n    ws1.close();\n    ws2.close();\n  });\n});\n\n// ── Convergence Tests ────────────────────────────────────────────\n\ndescribe('Convergence', () => {\n  let handle: AppHandle;\n  let url: string;\n  let port: number;\n  let docId: string;\n\n  beforeEach(async () => {\n    const s = await startServer();\n    handle = s.handle;\n    port = s.port;\n    url = s.url;\n\n    const res = await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'Convergence', content: 'abc' }),\n    });\n    const doc = await res.json();\n    docId = doc.id;\n  });\n\n  afterEach(async () => {\n    await handle.stop();\n    await cleanup(TEST_DB);\n  });\n\n  it('two clients converge after concurrent inserts at different positions', async () => {\n    const { ws: ws1, msg: init1 } = await wsConnectAndRead(`ws://localhost:${port}/document/${docId}`);\n    const { ws: ws2 } = await wsConnectAndRead(`ws://localhost:${port}/document/${docId}`);\n\n    const initMsg = init1 as { version: number };\n\n    // Both send operations at the same version\n    wsSend(ws1, {\n      type: 'operation',\n      operation: { type: 'insert', pos: 0, text: '1-' },\n      version: initMsg.version,\n    });\n    wsSend(ws2, {\n      type: 'operation',\n      operation: { type: 'insert', pos: 3, text: '-2-' },\n      version: initMsg.version,\n    });\n\n    // Collect all messages\n    for (let i = 0; i < 4; i++) {\n      if (i < 2) {\n        await wsRead(ws1, 3000);\n      } else {\n        await wsRead(ws2, 3000);\n      }\n    }\n\n    // Both should converge to the same content via REST\n    const docAfter = await fetch(`${url}/api/documents/${docId}`);\n    const doc = await docAfter.json();\n    const content = doc.content;\n\n    // Both inserts should be preserved\n    expect(content).toContain('1-');\n    expect(content).toContain('-2-');\n\n    ws1.close();\n    ws2.close();\n  });\n\n  it('concurrent insert and delete converge', async () => {\n    const { ws: ws1, msg: init1 } = await wsConnectAndRead(`ws://localhost:${port}/document/${docId}`);\n    const { ws: ws2 } = await wsConnectAndRead(`ws://localhost:${port}/document/${docId}`);\n\n    const initMsg = init1 as { version: number };\n\n    // ws1: insert \"XX\" at position 1 => \"aXXbc\"\n    // ws2: delete position 2, length 1 => delete \"b\" from \"abc\" => \"ac\"\n    // Both from \"abc\" at version 0\n\n    wsSend(ws1, {\n      type: 'operation',\n      operation: { type: 'insert', pos: 1, text: 'XX' },\n      version: initMsg.version,\n    });\n\n    wsSend(ws2, {\n      type: 'operation',\n      operation: { type: 'delete', pos: 2, length: 1 },\n      version: initMsg.version,\n    });\n\n    // Wait for messages (2 acks + 2 broadcasts = 4 total)\n    for (let i = 0; i < 4; i++) {\n      await wsRead(i < 2 ? ws1 : ws2, 3000);\n    }\n\n    // Check via REST\n    const docAfter = await fetch(`${url}/api/documents/${docId}`);\n    const doc = await docAfter.json();\n    const content = doc.content;\n\n    // Both edits should have an effect: \"XX\" should be present, 'b' should be gone\n    expect(content).toContain('XX');\n    expect(content.includes('b')).toBe(false);\n\n    ws1.close();\n    ws2.close();\n  });\n\n  it('multiple concurrent inserts on the same document', async () => {\n    const NUM_CLIENTS = 5;\n    const wss: WebSocket[] = [];\n    const versions: number[] = [];\n\n    for (let i = 0; i < NUM_CLIENTS; i++) {\n      const { ws, msg } = await wsConnectAndRead(`ws://localhost:${port}/document/${docId}`);\n      wss.push(ws);\n      versions.push((msg as { version: number }).version);\n    }\n\n    // Each client inserts its index\n    for (let i = 0; i < NUM_CLIENTS; i++) {\n      wsSend(wss[i], {\n        type: 'operation',\n        operation: {\n          type: 'insert',\n          pos: 0,\n          text: `${i}`,\n        },\n        version: versions[i],\n      });\n    }\n\n    // Collect all messages (acks + broadcasts)\n    for (let i = 0; i < NUM_CLIENTS; i++) {\n      // Each client gets 1 ack + (NUM_CLIENTS-1) broadcasts = NUM_CLIENTS messages\n      for (let j = 0; j < NUM_CLIENTS; j++) {\n        await wsRead(wss[i], 3000);\n      }\n    }\n\n    // Verify final content via REST\n    const res = await fetch(`${url}/api/documents/${docId}`);\n    const doc = await res.json();\n\n    // All digits should be present\n    for (let i = 0; i < NUM_CLIENTS; i++) {\n      expect(doc.content).toContain(`${i}`);\n    }\n\n    // Original content should remain\n    expect(doc.content).toContain('abc');\n\n    for (const ws of wss) {\n      ws.close();\n    }\n  });\n\n  it('persists across server restart', async () => {\n    // Make an edit via WS\n    const { ws, msg } = await wsConnectAndRead(`ws://localhost:${port}/document/${docId}`);\n    const initMsg = msg as { version: number };\n\n    wsSend(ws, {\n      type: 'operation',\n      operation: { type: 'insert', pos: 0, text: 'PERSISTED ' },\n      version: initMsg.version,\n    });\n    await wsRead(ws); // ack\n    ws.close();\n\n    // Stop server\n    await ha