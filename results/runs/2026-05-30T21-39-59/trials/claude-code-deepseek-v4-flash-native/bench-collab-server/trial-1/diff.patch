diff --git a/src/db.ts b/src/db.ts
new file mode 100644
index 0000000..3b5e3e1
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,154 @@
+/**
+ * Database layer for the collaborative document editor.
+ *
+ * Uses better-sqlite3 for synchronous SQLite access.
+ */
+
+import Database from 'better-sqlite3';
+import { randomUUID } from 'crypto';
+import type { Document, Version, Operation } from './types.js';
+
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS documents (
+  id TEXT PRIMARY KEY,
+  title TEXT NOT NULL,
+  content TEXT NOT NULL DEFAULT '',
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  updated_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+
+CREATE TABLE IF NOT EXISTS versions (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  version INTEGER NOT NULL,
+  content TEXT NOT NULL,
+  operation TEXT,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  UNIQUE(document_id, version)
+);
+
+CREATE TABLE IF NOT EXISTS active_connections (
+  id TEXT PRIMARY KEY,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  connected_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+`;
+
+export class DocStore {
+  private db: Database.Database;
+
+  constructor(dbPath: string) {
+    this.db = new Database(dbPath);
+    this.db.pragma('journal_mode = WAL');
+    this.db.pragma('foreign_keys = ON');
+    this.db.exec(SCHEMA);
+  }
+
+  /** Create a new document. Returns the created document. */
+  createDocument(title: string, content = ''): Document {
+    const id = randomUUID();
+    const stmt = this.db.prepare(
+      'INSERT INTO documents (id, title, content) VALUES (?, ?, ?)',
+    );
+    stmt.run(id, title, content);
+
+    // Save initial version (version 0)
+    this.saveVersion(id, 0, content, null);
+
+    return this.getDocument(id)!;
+  }
+
+  /** Get a document by ID, or null if not found. */
+  getDocument(id: string): Document | null {
+    const row = this.db
+      .prepare('SELECT * FROM documents WHERE id = ?')
+      .get(id) as Document | undefined;
+    return row ?? null;
+  }
+
+  /** List all documents. */
+  listDocuments(): Document[] {
+    return this.db
+      .prepare('SELECT * FROM documents ORDER BY updated_at DESC')
+      .all() as Document[];
+  }
+
+  /** Update a document's title and/or content (REST-style). */
+  updateDocument(
+    id: string,
+    fields: { title?: string; content?: string },
+  ): Document | null {
+    const doc = this.getDocument(id);
+    if (!doc) return null;
+
+    const title = fields.title ?? doc.title;
+    const content = fields.content ?? doc.content;
+
+    this.db
+      .prepare(
+        'UPDATE documents SET title = ?, content = ?, updated_at = datetime(\'now\') WHERE id = ?',
+      )
+      .run(title, content, id);
+
+    return this.getDocument(id);
+  }
+
+  /** Delete a document by ID. Returns true if a row was deleted. */
+  deleteDocument(id: string): boolean {
+    const result = this.db.prepare('DELETE FROM documents WHERE id = ?').run(id);
+    return result.changes > 0;
+  }
+
+  /** Get the current version number for a document (max version, or -1 if none). */
+  getCurrentVersion(docId: string): number {
+    const row = this.db
+      .prepare(
+        'SELECT COALESCE(MAX(version), -1) AS v FROM versions WHERE document_id = ?',
+      )
+      .get(docId) as { v: number };
+    return row.v;
+  }
+
+  /** Get document content at the latest version. */
+  getCurrentContent(docId: string): string | null {
+    const doc = this.getDocument(docId);
+    return doc ? doc.content : null;
+  }
+
+  /** Save a version snapshot. */
+  saveVersion(
+    docId: string,
+    version: number,
+    content: string,
+    operation: Operation | null,
+  ): void {
+    this.db
+      .prepare(
+        'INSERT OR IGNORE INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)',
+      )
+      .run(docId, version, content, operation ? JSON.stringify(operation) : null);
+  }
+
+  /** Update the document's content and updated_at in the documents table. */
+  updateDocumentContent(docId: string, content: string): void {
+    this.db
+      .prepare(
+        'UPDATE documents SET content = ?, updated_at = datetime(\'now\') WHERE id = ?',
+      )
+      .run(content, docId);
+  }
+
+  /** Get version history for a document. */
+  getVersions(docId: string): Version[] {
+    return this.db
+      .prepare(
+        'SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC',
+      )
+      .all(docId) as Version[];
+  }
+
+  /** Close the database connection. */
+  close(): void {
+    this.db.close();
+  }
+}
