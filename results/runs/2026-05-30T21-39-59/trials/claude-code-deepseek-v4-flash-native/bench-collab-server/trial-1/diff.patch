        reject(e);\n        }\n      });\n    });\n\n    ws.on('error', (err) => {\n      resolved = true;\n      clearTimeout(timer);\n      reject(err);\n    });\n  });\n}\n\n/** Read a JSON message from a WebSocket (with timeout). */\nfunction wsRead(ws: WebSocket, timeout = 3000): Promise<unknown> {\n  return new Promise((resolve, reject) => {\n    const timer = setTimeout(() => reject(new Error('WebSocket read timeout')), timeout);\n    ws.once('message', (data) => {\n      clearTimeout(timer);\n      try {\n        resolve(JSON.parse(data.toString()));\n      } catch (e) {\n        reject(e);\n      }\n    });\n    ws.once('error', (err) => {\n      clearTimeout(timer);\n      reject(err);\n    });\n  });\n}","originalFile":"/**\n * Tests for the Real-Time Collaborative Document Editor.\n *\n * Covers:\n *  1. OT engine correctness (apply, transform, compose)\n *  2. Server REST API (CRUD + version history)\n *  3. WebSocket collaboration / convergence\n */\n\nimport { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport { randomUUID } from 'crypto';\nimport WebSocket from 'ws';\nimport { apply, transform, compose } from '../src/ot.js';\nimport { createApp, type AppHandle } from '../src/server.js';\n\n// ── Helper ───────────────────────────────────────────────────────\n\nconst TEST_DB = `test-${randomUUID()}.db`;\n\n/** Start the server on a random port and return the URL. */\nasync function startServer(): Promise<{ handle: AppHandle; port: number; url: string }> {\n  const handle = createApp(TEST_DB);\n  const port = await handle.start(0);\n  const url = `http://localhost:${port}`;\n  return { handle, port, url };\n}\n\n/** Wait for a WebSocket to open. */\nfunction wsConnect(url: string): Promise<WebSocket> {\n  return new Promise((resolve, reject) => {\n    const ws = new WebSocket(url);\n    ws.on('open', () => resolve(ws));\n    ws.on('error', reject);\n  });\n}\n\n/** Read a JSON message from a WebSocket (with timeout). */\nfunction wsRead(ws: WebSocket, timeout = 2000): Promise<unknown> {\n  return new Promise((resolve, reject) => {\n    const timer = setTimeout(() => reject(new Error('WebSocket read timeout')), timeout);\n    ws.once('message', (data) => {\n      clearTimeout(timer);\n      try {\n        resolve(JSON.parse(data.toString()));\n      } catch (e) {\n        reject(e);\n      }\n    });\n    ws.once('error', reject);\n  });\n}\n\n/** Send JSON over a WebSocket. */\nfunction wsSend(ws: WebSocket, msg: unknown): void {\n  ws.send(JSON.stringify(msg));\n}\n\n// Clean up test db\nasync function cleanup(path: string): Promise<void> {\n  try {\n    const { unlink } = await import('fs/promises');\n    await unlink(path).catch(() => {});\n    await unlink(path + '-wal').catch(() => {});\n    await unlink(path + '-shm').catch(() => {});\n  } catch { /* ignore */ }\n}\n\n// ── OT Unit Tests ────────────────────────────────────────────────\n\ndescribe('OT Engine', () => {\n  describe('apply', () => {\n    it('inserts text at position 0', () => {\n      expect(apply('world', { type: 'insert', pos: 0, text: 'hello ' })).toBe('hello world');\n    });\n\n    it('inserts text at end', () => {\n      expect(apply('hello', { type: 'insert', pos: 5, text: ' world' })).toBe('hello world');\n    });\n\n    it('inserts text in the middle', () => {\n      expect(apply('hello world', { type: 'insert', pos: 5, text: ' cruel' })).toBe('hello cruel world');\n    });\n\n    it('deletes text from start', () => {\n      expect(apply('hello world', { type: 'delete', pos: 0, length: 6 })).toBe('world');\n    });\n\n    it('deletes text from end', () => {\n      expect(apply('hello world', { type: 'delete', pos: 5, length: 6 })).toBe('hello');\n    });\n\n    it('deletes text in the middle', () => {\n      expect(apply('hello world', { type: 'delete', pos: 5, length: 1 })).toBe('helloworld');\n    });\n  });\n\n  describe('transform – insert vs insert', () => {\n    it('shifts second insert when positions are equal', () => {\n      const op1 = { type: 'insert' as const, pos: 3, text: 'A' };\n      const op2 = { type: 'insert' as const, pos: 3, text: 'B' };\n      // op1 was applied first, transform op2 against op1\n      const t2 = transform(op2, op1)!;\n      expect(t2).toEqual({ type: 'insert', pos: 4, text: 'B' });\n      expect(apply(apply('hello', op1), t2)).toBe('helABlo');\n    });\n\n    it('does not shift earlier insert', () => {\n      const op1 = { type: 'insert' as const, pos: 5, text: 'A' };\n      const op2 = { type: 'insert' as const, pos: 3, text: 'B' };\n      const t2 = transform(op2, op1)!;\n      expect(t2).toEqual({ type: 'insert', pos: 3, text: 'B' }); // unchanged, before op1\n    });\n\n    it('converges regardless of order', () => {\n      const S = 'abcd';\n      const a = { type: 'insert' as const, pos: 1, text: 'X' };\n      const b = { type: 'insert' as const, pos: 3, text: 'Y' };\n      const aT = transform(a, b);\n      const bT = transform(b, a);\n      expect(apply(apply(S, a), bT!)).toBe(apply(apply(S, b), aT!));\n    });\n  });\n\n  describe('transform – insert vs delete', () => {\n    it('insert before delete – unchanged', () => {\n      const ins = { type: 'insert' as const, pos: 2, text: 'XX' };\n      const del = { type: 'delete' as const, pos: 5, length: 3 };\n      const t = transform(ins, del);\n      expect(t).toEqual(ins);\n    });\n\n    it('insert after delete – shifts left', () => {\n      const ins = { type: 'insert' as const, pos: 10, text: 'XX' };\n      const del = { type: 'delete' as const, pos: 5, length: 3 };\n      const t = transform(ins, del);\n      expect(t).toEqual({ type: 'insert', pos: 7, text: 'XX' });\n    });\n\n    it('insert inside deleted range – moves to start', () => {\n      const ins = { type: 'insert' as const, pos: 6, text: 'XX' };\n      const del = { type: 'delete' as const, pos: 5, length: 3 };\n      const t = transform(ins, del);\n      expect(t).toEqual({ type: 'insert', pos: 5, text: 'XX' });\n    });\n\n    it('converges delete then insert', () => {\n      const S = 'hello world';\n      const del = { type: 'delete' as const, pos: 5, length: 6 }; // deletes \" world\"\n      const ins = { type: 'insert' as const, pos: 5, text: ' beautiful' };\n      const delT = transform(del, ins);\n      const insT = transform(ins, del);\n      expect(apply(apply(S, del), insT!)).toBe(apply(apply(S, ins), delT!));\n    });\n  });\n\n  describe('transform – delete vs delete', () => {\n    it('non-overlapping – before', () => {\n      const a = { type: 'delete' as const, pos: 0, length: 2 };\n      const b = { type: 'delete' as const, pos: 4, length: 2 };\n      const aT = transform(a, b);\n      const bT = transform(b, a);\n      // Should converge\n      const S = 'hello world';\n      expect(apply(apply(S, a), bT!)).toBe(apply(apply(S, b), aT!));\n    });\n\n    it('non-overlapping – after, shifts left', () => {\n      const a = { type: 'delete' as const, pos: 4, length: 2 };\n      const b = { type: 'delete' as const, pos: 0, length: 2 };\n      const aT = transform(a, b);\n      expect(aT).toEqual({ type: 'delete', pos: 2, length: 2 });\n    });\n\n    it('overlapping – a starts before b', () => {\n      const a = { type: 'delete' as const, pos: 0, length: 4 };\n      const b = { type: 'delete' as const, pos: 2, length: 3 };\n      const S = 'hello world';\n      const aT = transform(a, b);\n      const bT = transform(b, a);\n      expect(apply(apply(S, a), bT!)).toBe(apply(apply(S, b), aT!));\n    });\n\n    it('identical deletions – second becomes no-op', () => {\n      const a = { type: 'delete' as const, pos: 2, length: 3 };\n      const b = { type: 'delete' as const, pos: 2, length: 3 };\n      const bT = transform(b, a);\n      expect(bT).toBeNull();\n    });\n  });\n\n  describe('compose', () => {\n    it('composes two inserts', () => {\n      const a = { type: 'insert' as const, pos: 0, text: 'A' };\n      const b = { type: 'insert' as const, pos: 1, text: 'B' };\n      const c = compose(a, b);\n      expect(c).toBeDefined();\n      if (c) {\n        expect(apply(apply('', a), b)).toBe(apply('', c));\n      }\n    });\n  });\n});\n\n// ── Server Integration Tests ─────────────────────────────────────\n\ndescribe('Server REST API', () => {\n  let handle: AppHandle;\n  let url: string;\n  let port: number;\n\n  beforeEach(async () => {\n    const s = await startServer();\n    handle = s.handle;\n    port = s.port;\n    url = s.url;\n  });\n\n  afterEach(async () => {\n    await handle.stop();\n    await cleanup(TEST_DB);\n  });\n\n  it('creates a document', async () => {\n    const res = await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'Test Doc', content: 'Hello!' }),\n    });\n    expect(res.status).toBe(201);\n    const doc = await res.json();\n    expect(doc.title).toBe('Test Doc');\n    expect(doc.content).toBe('Hello!');\n    expect(doc.id).toBeDefined();\n  });\n\n  it('rejects document creation without title', async () => {\n    const res = await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ content: 'no title' }),\n    });\n    expect(res.status).toBe(400);\n  });\n\n  it('lists documents', async () => {\n    await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'A' }),\n    });\n    await fetch(`${url}/api/documents`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'B' }),\n    });\n    const res = await fetch(`${url}/api/documents`);\n    const docs = await res.json();\n    expect(docs.length).toBeGreaterThanOrEqual(2);\n  });\n\n  it('gets a single document', async () => {\n    const create = await fetch(`${url}/api/documents`, {\n      method: 'PO