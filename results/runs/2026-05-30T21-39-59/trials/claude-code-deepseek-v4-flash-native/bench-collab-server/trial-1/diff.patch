@@ -0,0 +1,89 @@
+/**
+ * Shared types for the collaborative document editor.
+ */
+
+/** A persisted document */
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+/** A document version snapshot */
+export interface Version {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+/** An insert operation */
+export interface OpInsert {
+  type: 'insert';
+  pos: number;
+  text: string;
+}
+
+/** A delete operation */
+export interface OpDelete {
+  type: 'delete';
+  pos: number;
+  length: number;
+}
+
+export type Operation = OpInsert | OpDelete;
+
+// ── WebSocket message types ──────────────────────────────────────
+
+/** Sent server→client on initial connection */
+export interface WsInit {
+  type: 'init';
+  content: string;
+  version: number;
+}
+
+/** Sent client→server: an edit operation */
+export interface WsClientOperation {
+  type: 'operation';
+  operation: Operation;
+  version: number;
+}
+
+/** Sent server→client: an operation broadcast from another client */
+export interface WsServerOperation {
+  type: 'operation';
+  operation: Operation;
+  version: number;
+  clientId: string;
+}
+
+/** Sent server→client: acknowledgement that an operation was applied */
+export interface WsAck {
+  type: 'ack';
+  version: number;
+}
+
+/** Sent server→client: an error */
+export interface WsError {
+  type: 'error';
+  message: string;
+}
+
+export type WsServerMessage = WsInit | WsServerOperation | WsAck | WsError;
+export type WsClientMessage = WsClientOperation;
+
+/** Create document request body */
+export interface CreateDocBody {
+  title: string;
+  content?: string;
+}
+
+/** Update document request body */
+export interface UpdateDocBody {
+  title?: string;
+  content?: string;
+}
