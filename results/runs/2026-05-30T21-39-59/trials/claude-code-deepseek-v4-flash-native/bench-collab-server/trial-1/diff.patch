new file mode 100644
index 0000000..3cd1668
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,216 @@
+/**
+ * Operational Transform (OT) engine for collaborative text editing.
+ *
+ * Supports insert and delete operations. The transform function guarantees
+ * that all clients converge to the same document state when operations are
+ * applied in different orders.
+ */
+
+import type { Operation, OpInsert, OpDelete } from './types.js';
+
+// ── Apply ────────────────────────────────────────────────────────
+
+/**
+ * Apply an operation to a string and return the new string.
+ */
+export function apply(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    const pos = Math.min(op.pos, content.length);
+    return content.slice(0, pos) + op.text + content.slice(pos);
+  }
+
+  // delete
+  const pos = Math.min(op.pos, content.length);
+  const end = Math.min(pos + op.length, content.length);
+  return content.slice(0, pos) + content.slice(end);
+}
+
+// ── Transform ────────────────────────────────────────────────────
+
+/**
+ * Transform `op` so it can be applied *after* `against` has been applied.
+ *
+ * This satisfies the OT property:
+ *   apply(apply(S, against), transform(op, against))
+ *   = apply(apply(S, op), transform(against, op))
+ *   (when both start from the same state S)
+ *
+ * Returns null if the operation becomes a no-op (e.g. deleting text that
+ * was already deleted).
+ */
+export function transform(op: Operation, against: Operation): Operation | null {
+  // Insert vs Insert
+  if (op.type === 'insert' && against.type === 'insert') {
+    return transformInsertInsert(op, against);
+  }
+
+  // Insert vs Delete
+  if (op.type === 'insert' && against.type === 'delete') {
+    return transformInsertDelete(op, against);
+  }
+
+  // Delete vs Insert
+  if (op.type === 'delete' && against.type === 'insert') {
+    return transformDeleteInsert(op, against);
+  }
+
+  // Delete vs Delete – assert so TS narrows correctly
+  return transformDeleteDelete(op as OpDelete, against as OpDelete);
+}
+
+function transformInsertInsert(op: OpInsert, against: OpInsert): OpInsert {
+  // If the insert is at or after the already-applied insert, shift right
+  if (op.pos < against.pos) {
+    return op;
+  }
+  return { type: 'insert', pos: op.pos + against.text.length, text: op.text };
+}
+
+function transformInsertDelete(op: OpInsert, against: OpDelete): OpInsert {
+  const delEnd = against.pos + against.length;
+
+  if (op.pos <= against.pos) {
+    // Insert before the deleted range – unchanged
+    return op;
+  }
+
+  if (op.pos < delEnd) {
+    // Insert inside the deleted range – move to the start of the deleted range
+    return { type: 'insert', pos: against.pos, text: op.text };
+  }
+
+  // Insert after the deleted range – shift left by the deleted length
+  return { type: 'insert', pos: op.pos - against.length, text: op.text };
+}
+
+function transformDeleteInsert(op: OpDelete, against: OpInsert): OpDelete {
+  const insEnd = against.pos + against.text.length;
+
+  if (op.pos >= insEnd) {
+    // Delete range is entirely after the insert – shift right by insert length
+    return { type: 'delete', pos: op.pos + against.text.length, length: op.length };
+  }
+
+  if (op.pos + op.length <= against.pos) {
+    // Delete range is entirely before the insert – unchanged
+    return op;
+  }
+
+  // The delete range overlaps with the insert range.
+  if (op.pos >= against.pos) {
+    // Delete starts at or after the insert – shift the delete start
+    return { type: 'delete', pos: op.pos + against.text.length, length: op.length };
+  }
+
+  // Delete range covers the insert point – expand the delete to absorb the inserted text
+  return { type: 'delete', pos: op.pos, length: op.length + against.text.length };
+}
+
+function transformDeleteDelete(op: OpDelete, against: OpDelete): OpDelete | null {
+  const aStart = op.pos;
+  const aEnd = op.pos + op.length;
+  const bStart = against.pos;
+  const bEnd = against.pos + against.length;
+
+  // a entirely before b – unchanged
+  if (aEnd <= bStart) {
+    return op;
+  }
+
+  // a entirely after b – shift left
+  if (aStart >= bEnd) {
+    return { type: 'delete', pos: op.pos - against.length, length: op.length };
+  }
+
+  // Overlapping deletions.
+  // Compute how much of `a` was already deleted by `b`.
+  const overlapStart = Math.max(aStart, bStart);
+  const overlapEnd = Math.min(aEnd, bEnd);
+  const overlapLen = Math.max(0, overlapEnd - overlapStart);
+
+  if (overlapLen >= op.length) {
+    // `a` was entirely subsumed by `b`
+    return null;
+  }
+
+  if (aStart < bStart) {
+    // `a` extends to the left of `b` – keep only the left portion
+    return { type: 'delete', pos: aStart, length: bStart - aStart };
+  }
+
+  // `a` starts at or after `b` and extends beyond – keep the right portion
+  return { type: 'delete', pos: bStart, length: aEnd - bEnd };
+}
+
+// ── Compose ──────────────────────────────────────────────────────
+
+/**
+ * Compose two sequential operations into a single operation.
+ *   apply(apply(S, a), b) === apply(S, compose(a, b))
+ */
+export function compose(a: Operation, b: Operation): Operation | null {
+  // Insert then Insert
+  if (a.type === 'insert' && b.type === 'insert') {
+    // Two inserts: if b is at or after a's position, shift b by a's length
+    if (b.pos <= a.pos) {
+      return { type: 'insert', pos: b.pos, text: b.text + a.text };
+    }
+    return { type: 'insert', pos: a.pos, text: a.text + b.text };
+  }
+
+  // Insert then Delete
+  if (a.type === 'insert' && b.type === 'delete') {
+    const insEnd = a.pos + a.text.length;
+
+    if (b.pos >= insEnd) {
+      // Delete entirely after insert – shift delete back by insert length
+      return { type: 'insert', pos: a.pos, text: a.text.slice(0, b.pos - insEnd) + a.text.slice(b.pos - insEnd + b.length) };
+    }
+
+    if (b.pos + b.length <= a.pos) {
+      // Delete entirely before insert – unchanged
+      return { type: 'insert', pos: a.pos + b.length - b.pos, text: a.text };
+    }
+
+    // Overlapping – build the resulting text
+    const beforeDel = a.text.slice(0, Math.max(0, b.pos - a.pos));
+    const afterDel = a.text.slice(Math.max(0, b.pos + b.length - a.pos));
+    return { type: 'insert', pos: Math.min(a.pos, b.pos), text: beforeDel + afterDel };
+  }
+
+  // Delete then Insert
+  if (a.type === 'delete' && b.type === 'insert') {
+    if (b.pos <= a.pos) {
+      // Insert before or at delete start
+      return { type: 'delete', pos: b.pos + b.text.length, length: a.length };
+    }
+    if (b.pos >= a.pos + a.length) {
+      // Insert after delete – shift insert back
+      return { type: 'delete', pos: a.pos, length: a.length };
+    }
+    // Insert inside deleted range
+    return { type: 'delete', pos: a.pos, length: a.length + b.text.length };
+  }
+
+  // Delete then Delete
+  if (a.type === 'delete' && b.type === 'delete') {
+    // Compose two deletions: effectively delete the union of both ranges
+    const aEnd = a.pos + a.length;
+    const bEnd = b.pos + b.length;
+
+    // Shift b's range by a's deletion (characters after a shift left)
+    const shiftedBStart = b.pos >= a.pos ? b.pos - a.length : b.pos;
+    const shiftedBEnd = bEnd >= a.pos ? bEnd - a.length : bEnd;
+
+    const resultStart = Math.min(a.pos, shiftedBStart);
+    const resultEnd = Math.max(aEnd, shiftedBEnd);
+
+    return {
+      type: 'delete',
+      pos: resultStart,
+      length: resultEnd - resultStart,
+    };
+  }
+
+  return null;
+}
