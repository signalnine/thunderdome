romise<void>;\n}\n\nexport function createApp(dbPath?: string): AppHandle {\n  // ── Dependencies ──────────────────────────────────────────────\n  const store = new DocStore(dbPath ?? 'documents.db');\n\n  // ── In-memory state ───────────────────────────────────────────\n  const docStates = new Map<string, DocumentState>(); // docId → state\n  const docClients = new Map<string, Map<string, ClientState>>(); // docId → clientId → ClientState\n\n  // ── Express + HTTP ────────────────────────────────────────────\n  const app = express();\n  app.use(express.json());\n  const server = http.createServer(app);\n\n  // ── WebSocket ─────────────────────────────────────────────────\n  const wss = new WebSocketServer({ server });\n\n  // ── Helpers ───────────────────────────────────────────────────\n\n  /** Lazily initialise in-memory state from the DB for a document. */\n  function ensureDocState(docId: string): DocumentState | null {\n    const doc = store.getDocument(docId);\n    if (!doc) return null;\n\n    if (!docStates.has(docId)) {\n      const version = store.getCurrentVersion(docId);\n      const ops: Operation[] = [];\n\n      // Load ops from version history\n      const versions = store.getVersions(docId);\n      for (const v of versions) {\n        if (v.operation) {\n          try {\n            ops.push(JSON.parse(v.operation) as Operation);\n          } catch {\n            // skip unparseable operations\n          }\n        }\n      }\n\n      docStates.set(docId, { version: Math.max(0, version), ops });\n    }\n\n    return docStates.get(docId)!;\n  }\n\n  /** Get or create the client map for a document. */\n  function getDocClients(docId: string): Map<string, ClientState> {\n    if (!docClients.has(docId)) {\n      docClients.set(docId, new Map());\n    }\n    return docClients.get(docId)!;\n  }\n\n  /** Broadcast a message to all connected clients of a document, optionally excluding one. */\n  function broadcast(\n    docId: string,\n    message: WsServerMessage,\n    excludeClientId?: string,\n  ): void {\n    const clients = docClients.get(docId);\n    if (!clients) return;\n\n    const raw = JSON.stringify(message);\n    for (const [clientId, cs] of clients) {\n      if (clientId === excludeClientId) continue;\n      if (cs.ws.readyState === WebSocket.OPEN) {\n        cs.ws.send(raw);\n      }\n    }\n  }\n\n  /** Send a JSON message to a single WebSocket. */\n  function send(ws: WebSocket, message: WsServerMessage): void {\n    if (ws.readyState === WebSocket.OPEN) {\n      ws.send(JSON.stringify(message));\n    }\n  }\n\n  /** Validate that an operation is well-formed. */\n  function validateOperation(op: unknown, docLength: number): op is Operation {\n    if (!op || typeof op !== 'object') return false;\n    const o = op as Record<string, unknown>;\n\n    if (o.type === 'insert') {\n      return (\n        typeof o.pos === 'number' &&\n        o.pos >= 0 &&\n        o.pos <= docLength + 1 &&\n        typeof o.text === 'string' &&\n        o.text.length > 0\n      );\n    }\n\n    if (o.type === 'delete') {\n      return (\n        typeof o.pos === 'number' &&\n        o.pos >= 0 &&\n        o.pos < docLength &&\n        typeof o.length === 'number' &&\n        o.length > 0 &&\n        o.pos + o.length <= docLength\n      );\n    }\n\n    return false;\n  }\n\n  // ── REST API ──────────────────────────────────────────────────\n\n  /** POST /api/documents – Create a new document. */\n  app.post('/api/documents', (req: Request, res: Response) => {\n    const { title, content } = req.body ?? {};\n    if (!title || typeof title !== 'string' || title.trim().length === 0) {\n      res.status(400).json({ error: 'Title is required' });\n      return;\n    }\n    const doc = store.createDocument(title.trim(), content ?? '');\n    res.status(201).json(doc);\n  });\n\n  /** GET /api/documents – List all documents. */\n  app.get('/api/documents', (_req: Request, res: Response) => {\n    const docs = store.listDocuments();\n    res.json(docs);\n  });\n\n  /** GET /api/documents/:id – Get a single document. */\n  app.get('/api/documents/:id', (req: Request, res: Response) => {\n    const doc = store.getDocument(req.params.id);\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n    res.json(doc);\n  });\n\n  /** PUT /api/documents/:id – Update a document (title and/or content). */\n  app.put('/api/documents/:id', (req: Request, res: Response) => {\n    const doc = store.getDocument(req.params.id);\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n    const { title, content } = req.body ?? {};\n    const updated = store.updateDocument(req.params.id, {\n      title: typeof title === 'string' ? title : undefined,\n      content: typeof content === 'string' ? content : undefined,\n    });\n    res.json(updated);\n  });\n\n  /** DELETE /api/documents/:id – Delete a document. */\n  app.delete('/api/documents/:id', (req: Request, res: Response) => {\n    const deleted = store.deleteDocument(req.params.id);\n    if (!deleted) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n    // Clean up in-memory state\n    docStates.delete(req.params.id);\n    docClients.delete(req.params.id);\n    res.status(204).send();\n  });\n\n  /** GET /api/documents/:id/versions – Get version history. */\n  app.get('/api/documents/:id/versions', (req: Request, res: Response) => {\n    const doc = store.getDocument(req.params.id);\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n    const versions = store.getVersions(req.params.id);\n    res.json(versions);\n  });\n\n  // ── WebSocket Handling ────────────────────────────────────────\n\n  wss.on('connection', (ws: WebSocket, req) => {\n    // Parse the document ID from the URL path: /document/:docId\n    const url = new URL(req.url ?? '/', `http://${req.headers.host ?? 'localhost'}`);\n    const pathParts = url.pathname.split('/').filter(Boolean);\n    const docId = pathParts[pathParts.length - 1] ?? '';\n\n    if (!docId) {\n      send(ws, { type: 'error', message: 'Document ID is required in the path' });\n      ws.close();\n      return;\n    }\n\n    // Ensure document exists\n    const state = ensureDocState(docId);\n    if (!state) {\n      send(ws, { type: 'error', message: `Document \"${docId}\" not found` });\n      ws.close();\n      return;\n    }\n\n    const content = store.getCurrentContent(docId) ?? '';\n    const clientId = randomUUID();\n    const clients = getDocClients(docId);\n    clients.set(clientId, { ws, docId, clientId });\n\n    // Send initial state\n    send(ws, { type: 'init', content, version: state.version });\n\n    // ── Message handler ─────────────────────────────────────────\n    ws.on('message', (data) => {\n      let msg: WsClientMessage;\n      try {\n        msg = JSON.parse(data.toString()) as WsClientMessage;\n      } catch {\n        send(ws, { type: 'error', message: 'Invalid JSON' });\n        return;\n      }\n\n      if (msg.type !== 'operation') {\n        send(ws, { type: 'error', message: 'Unknown message type' });\n        return;\n      }\n\n      const clientVersion = msg.version;\n      const op = msg.operation;\n\n      // Validate the operation against the MOST RECENT version's content.\n      // We fetch the current content from the DB for validation.\n      const currentContent = store.getCurrentContent(docId);\n      if (currentContent === null) {\n        send(ws, { type: 'error', message: 'Document not found' });\n        return;\n      }\n\n      if (!validateOperation(op, currentContent.length)) {\n        send(ws, { type: 'error', message: 'Invalid operation' });\n        return;\n      }\n\n      // Version check\n      if (clientVersion > state.version) {\n        send(ws, { type: 'error', message: 'Operation version is in the future' });\n        return;\n      }\n\n      // ── Operational Transform ─────────────────────────────────\n      let transformedOp: Operation | null = op;\n\n      // Transform against all operations that happened since the client's version\n      if (clientVersion < state.version) {\n        for (let v = clientVersion; v < state.version; v++) {\n          const against = state.ops[v];\n          if (against) {\n            transformedOp = transform(transformedOp, against);\n            if (transformedOp === null) break; // became a no-op\n          }\n        }\n      }\n\n      if (transformedOp === null) {\n        // Operation was entirely consumed by concurrent ops – just ack\n        send(ws, { type: 'ack', version: state.version });\n        return;\n      }\n\n      // Apply the transformed operation to the current content\n      const newContent = apply(currentContent, transformedOp);\n\n      // Update state\n      state.ops.push(transformedOp);\n      state.version++;\n\n      // Persist\n      store.updateDocumentContent(docId, newContent);\n      store.saveVersion(docId, state.version, newContent, transformedOp);\n\n      // Ack the sender\n      send(ws, { type: 'ack', version: state.version });\n\n      // Broadcast to other clients\n      broadcast(\n        docId,\n        {\n          type: 'operation',\n          operation: transformedOp,\n          version: state.version,\n          clientId,\n        },\n        clientId,\n      );\n    });\n\n    // ── Close handler ───────────────────────────────────────────\n    ws.on('close', () => {\n      clients.delete(clientId);\n      if (clients.size === 0) {\n        docClients.delete(docId);\n      }\n    });\n\n    ws.on('error', () => {\n      clients.delete(clientId);\n      if (clients.size === 0) {\n        docClients.delete(docId);\n      }\n    });\n  });\n\n  // ── Start / Stop ──────────────────────────────────────────────\n\n  async function start(port?: number): Promise<number> {\n    return new Promise((resolve) => {\n      server.listen(port ?? DEFAULT_PORT, () => {\n        const addr = server.address();\n        const actualPort = typeof addr === 'object' && addr ? addr.port : 0;\n        resolve(actualPort);\n      });\n    });\n  }\n\n  async function stop(): Promise<void> {\n    // Close all WebSocket connections\n    for (const clients of docClients.values()) {\n      for (const cs of clients.values()) {\n        try {\n          cs.ws.close();\n        } catch {\n          // ignore close errors\n        }\n      }\n    }\n    wss.close();\n\n    // Close HTTP server\n    return new Promise((resolve) => {\n      server.close(() => {\n        store.close();\n        resolve();\n      });\n    });\n  }\n\n  return { app, start, stop };\n}\n\n// ── Standalone runner ────────────────────────────────────────────\n\nconst PORT = parseInt(process.env.PORT ?? '3001', 10);\nconst DB_PATH = process.env.DB_PATH ?? 'documents.db';\n\nconst handle = createApp(DB_PATH);\nhandle.start(PORT).then((port) => {\n  console.log(`Server listening on port ${port}`);\n});\n","structuredPatch":[{"oldStart":9,"oldLines":7,"newStart":9,"newLines":7,"lines":[" "," import express, { type Express, type Request, type Response } from 'express';"," import http from 'http';","-import { WebSocketServer, type WebSocket } from 'ws';","+import { WebSocketServer, WebSocket } from 'ws';"," import { randomUUID } from 'crypto';"," import { DocStore } from './db.js';"," import { apply, transform } from './ot.js';"]}],"userModified":false,"replaceAll":false}}
