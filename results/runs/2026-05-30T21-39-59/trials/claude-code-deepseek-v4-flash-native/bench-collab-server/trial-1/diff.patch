ite3\n  ot.ts        - Operational Transform\n  server.ts    - Main server with createApp factory\n```\n\nLet me think about the database layer:\n\n```typescript\nimport Database from 'better-sqlite3';\nimport fs from 'fs';\nimport path from 'path';\n\nexport class DocStore {\n  private db: Database.Database;\n  \n  constructor(dbPath: string) {\n    this.db = new Database(dbPath);\n    this.db.pragma('journal_mode = WAL');\n    this.db.pragma('foreign_keys = ON');\n    \n    // Run schema\n    const schema = fs.readFileSync(path.join(__dirname, '../schema.sql'), 'utf-8');\n    this.db.exec(schema);\n  }\n  \n  createDocument(title: string, content?: string): Document { ... }\n  getDocument(id: string): Document | null { ... }\n  updateDocument(id: string, title?: string, content?: string): Document { ... }\n  deleteDocument(id: string): boolean { ... }\n  listDocuments(): Document[] { ... }\n  saveVersion(docId: string, version: number, content: string, operation: Operation): void { ... }\n  getVersions(docId: string): Version[] { ... }\n}\n```\n\nAnd for the server:\n\n```typescript\nimport express from 'express';\nimport http from 'http';\nimport { WebSocketServer, WebSocket } from 'ws';\nimport { DocStore } from './db.js';\nimport { transform, apply } from './ot.js';\n\ninterface ClientState {\n  ws: WebSocket;\n  docId: string;\n  lastVersion: number;\n  clientId: string;\n}\n\nexport function createApp(dbPath?: string) {\n  const app = express();\n  const server = http.createServer(app);\n  const wss = new WebSocketServer({ server });\n  const store = new DocStore(dbPath || 'documents.db');\n  \n  // Track connected clients per document\n  const docClients = new Map<string, Map<string, ClientState>>();\n  // Track pending operations per document (for transformation)\n  const docOps = new Map<string, Operation[]>();\n  // Track doc versions per document\n  const docVersions = new Map<string, number>();\n  \n  // REST API\n  app.use(express.json());\n  \n  app.post('/api/documents', (req, res) => { ... });\n  app.get('/api/documents', (req, res) => { ... });\n  app.get('/api/documents/:id', (req, res) => { ... });\n  app.put('/api/documents/:id', (req, res) => { ... });\n  app.delete('/api/documents/:id', (req, res) => { ... });\n  app.get('/api/documents/:id/versions', (req, res) => { ... });\n  \n  // WebSocket\n  wss.on('connection', (ws, req) => {\n    // Extract docId from URL\n    const url = new URL(req.url!, 'http://localhost');\n    const docId = url.pathname.split('/').pop();\n    // ... handle messages\n  });\n  \n  // ... start/stop\n  \n  return { app, start, stop };\n}\n```\n\nWait, the URL handling with `ws` needs to be careful. The `ws` WebSocket Server's `address()` returns the server info. The upgrade request URL will be like `/document/docId` (from the client's perspective).\n\nLet me finalize the protocol:\n\nConnection URL: `ws://host:port/document/:docId`\n\nMessages (JSON):\n\n**Server -> Client (on connect):**\n```json\n{ \"type\": \"init\", \"content\": \"doc content\", \"version\": 5 }\n```\n\n**Client -> Server (edits):**\n```json\n{ \"type\": \"operation\", \"operation\": { \"type\": \"insert\", \"pos\": 3, \"text\": \"hello\" }, \"version\": 5 }\n```\n\n**Server -> Client (ack):**\n```json\n{ \"type\": \"ack\", \"version\": 6 }\n```\n\n**Server -> Client (broadcast):**\n```json\n{ \"type\": \"operation\", \"operation\": { \"type\": \"insert\", \"pos\": 3, \"text\": \"hello\" }, \"version\": 6, \"clientId\": \"abc\" }\n```\n\n**Server -> Client (error):**\n```json\n{ \"type\": \"error\", \"message\": \"Invalid operation\" }\n```\n\nNow let me implement. Let me also consider: what happens when a client reconnects? They should get the latest document state and version.\n\nLet me also think about the in-memory state management:\n\n- `docOps[docId]`: Array of operations that have been applied, in version order\n- `docVersions[docId]`: Current version number\n- `docClients[docId]`: Map of clientId ->