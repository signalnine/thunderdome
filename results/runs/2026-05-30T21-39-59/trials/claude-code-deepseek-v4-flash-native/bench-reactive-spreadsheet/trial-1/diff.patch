+/**
+ * Reactive Spreadsheet Engine.
+ *
+ * Manages a grid of cells with values and formulas, automatic reactive
+ * updates when dependencies change, and circular reference detection.
+ */
+
+import { tokenize, Parser, evaluate, extractCellRefs } from './formula.js';
+import type { EvalContext, Expr } from './formula.js';
+
+export class Spreadsheet {
+  /** Raw formula strings (only for formula cells). */
+  private formulas = new Map<string, string>();
+
+  /** Parsed ASTs for formula cells. */
+  private parsedFormulas = new Map<string, Expr>();
+
+  /** Computed values for all non-empty cells. */
+  private values = new Map<string, unknown>();
+
+  /**
+   * Dependency graph: for each cell, the set of cells it depends on.
+   * edge direction: cell → dependency (cell references dependency)
+   */
+  private depGraph = new Map<string, Set<string>>();
+
+  /**
+   * Reverse dependency graph: for each cell, the set of cells that depend on it.
+   * edge direction: cell → dependent (cells that use this cell in their formula)
+   */
+  private dependents = new Map<string, Set<string>>();
+
+  // ----------------------------------------------------------------
+  // Public API
+  // ----------------------------------------------------------------
+
+  /**
+   * Set a cell's value. Can be a raw value (number, string, boolean) or
+   * a formula string starting with '='.
+   *
+   * Throws if the formula is syntactically invalid or would create a
+   * circular dependency.
+   */
+  set(cell: string, value: string | number | boolean): void {
+    const key = cell.toUpperCase();
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      this.setFormula(key, value);
+    } else {
+      this.setRawValue(key, value);
+    }
+  }
+
+  /**
+   * Get a cell's computed value. Returns null for empty cells.
+   */
+  get(cell: string): string | number | boolean | null {
+    const key = cell.toUpperCase();
+    if (!this.values.has(key)) return null;
+    const val = this.values.get(key);
+    return val !== undefined ? (val as string | number | boolean | null) : null;
+  }
+
+  /**
+   * Get the display string for a cell's computed value.
+   * Returns empty string for empty cells.
+   */
+  getDisplay(cell: string): string {
+    const val = this.get(cell);
+    if (val === null) return '';
+    return String(val);
+  }
+
+  /**
+   * Get all non-empty cells as a Map from cell reference to computed value.
+   */
+  getCells(): Map<string, string | number | boolean | null> {
+    const result = new Map<string, string | number | boolean | null>();
+    for (const [key, val] of this.values) {
+      result.set(key, val as string | number | boolean);
+    }
+    return result;
+  }
+
+  // ----------------------------------------------------------------
+  // Internal: Setting Values
+  // ----------------------------------------------------------------
+
+  private setRawValue(key: string, value: string | number | boolean): void {
+    this.values.set(key, value);
+    this.formulas.delete(key);
+    this.parsedFormulas.delete(key);
+
+    // Remove all outgoing dependency edges from this cell
+    this.setDependencies(key, new Set());
+
+    // Recompute all transitive dependents
+    this.recomputeFrom(key);
+  }
+
+  private setFormula(key: string, formula: string): void {
+    // Parse the formula expression
+    const formulaBody = formula.substring(1);
+    let tokens;
+    let ast: Expr;
+    try {
+      tokens = tokenize(formulaBody);
+      const parser = new Parser(tokens);
+      ast = parser.parse();
+    } catch (e: unknown) {
+      throw new Error(
+        `Invalid formula in ${key}: ${e instanceof Error ? e.message : String(e)}`,
+      );
+    }
+
+    // Extract cell references from the AST
+    const deps = extractCellRefs(ast);
+
+    // Check for circular dependency before making any changes
+    if (this.wouldCreateCycle(key, deps)) {
+      throw new Error(`Circular reference detected: ${key} would create a cycle`);
+    }
+
+    // Store formula data
+    this.formulas.set(key, formula);
+    this.parsedFormulas.set(key, ast);
+
+    // Update dependency graph
+    this.setDependencies(key, deps);
+
+    // Evaluate the formula
+    const ctx = this.createContext();
+    try {
+      const result = evaluate(ast, ctx);
+      this.values.set(key, result);
+    } catch {
+      this.values.set(key, null);
+    }
+
+    // Recompute all transitive dependents
+    this.recomputeFrom(key);
+  }
+
+  // ----------------------------------------------------------------
+  // Dependency Graph Management
+  // ----------------------------------------------------------------
+
+  /**
+   * Replace the dependency edges for a cell.
+   * Removes old edges and creates new ones.
+   */
+  private setDependencies(cell: string, deps: Set<string>): void {
+    // Remove old edges
+    const oldDeps = this.depGraph.get(cell);
+    if (oldDeps) {
+      for (const dep of oldDeps) {
+        this.dependents.get(dep)?.delete(cell);
+      }
+    }
+
+    // Set new edges
+    this.depGraph.set(cell, new Set(deps));
+    for (const dep of deps) {
+      let depSet = this.dependents.get(dep);
+      if (!depSet) {
+        depSet = new Set();
+        this.dependents.set(dep, depSet);
+      }
+      depSet.add(cell);
+    }
+  }
+
+  /**
+   * Check if adding a dependency edge from `cell` to each of `deps` would
+   * create a cycle. Does this by checking if there's an existing path from
+   * any dep back to cell in the current dependency graph.
+   */
+  private wouldCreateCycle(cell: string, deps: Set<string>): boolean {
+    // BFS/DFS from each dep following dependency edges
+    const visited = new Set<string>();
+    const queue = [...deps];
+
+    while (queue.length > 0) {
+      const current = queue.shift()!;
+      if (current === cell) return true;
+      if (visited.has(current)) continue;
+      visited.add(current);
+
+      const nextDeps = this.depGraph.get(current);
+      if (nextDeps) {
+        for (const d of nextDeps) {
+          if (!visited.has(d)) {
+            queue.push(d);
+          }
+        }
+      }
+    }
+
+    return false;
+  }
+
+  // ----------------------------------------------------------------
+  // Reactive Recalculation
+  // ----------------------------------------------------------------
+
+  /**
+   * Recompute all cells that (transitively) depend on `changedCell`.
+   * Uses topological sort to ensure correct evaluation order.
+   */
+  private recomputeFrom(changedCell: string): void {
+    // Collect all transitive dependents via BFS
+    const affected = new Set<string>();
+    const queue = [...(this.dependents.get(changedCell) ?? [])];
+
+    while (queue.length > 0) {
+      const cell = queue.shift()!;
+      if (affected.has(cell)) continue;
+      affected.add(cell);
+
+      const deps = this.dependents.get(cell);
+      if (deps) {
+        for (const d of deps) {
+          if (!affected.has(d)) {
+            queue.push(d);
+          }
+        }
+      }
+    }
+
+    if (affected.size === 0) return;
+
+    // Topological sort: dependencies before dependents
+    const sorted = this.topologicalSort(affected);
+
+    // Recompute in order
+    const ctx = this.createContext();
+    for (const cell of sorted) {
+      const ast = this.parsedFormulas.get(cell);
+      if (ast) {
+        try {
+          this.values.set(cell, evaluate(ast, ctx));
+        } catch {
+          this.values.set(cell, null);
+        }
+      }
+    }
+  }
+
+  /**
+   * Topological sort (Kahn's algorithm) of the subgraph induced by `cells`.
+   * Restricts edges to those within the set so that external dependencies
+   * (which are stable) don't interfere with ordering.
+   */
+  private topologicalSort(cells: Set<string>): string[] {
+    const inDegree = new Map<string, number>();
+    const adjacency = new Map<string, Set<string>>();
+
+    // Initialize
+    for (const cell of cells) {
+      inDegree.set(cell, 0);
+      adjacency.set(cell, new Set());
+    }
+
+    // Build edges within the affected set: dep → dependent
+    for (const cell of cells) {
+      const deps = this.depGraph.get(cell);
+      if (!deps) continue;
+      for (const dep of deps) {
+        if (cells.has(dep)) {
+          // dep must be computed before cell
+          adjacency.get(dep)!.add(cell);
+          inDegree.set(cell, (inDegree.get(cell) ?? 0) + 1);
+        }
+      }
+    }
+
+    // Start with cells that have no remaining internal dependencies
+    const queue: string[] = [];
+    for (const [cell, deg] of inDegree) {
+      if (deg === 0) queue.push(cell);
+    }
+
+    const result: string[] = [];
+    while (queue.length > 0) {
+      const cell = queue.shift()!;
+      result.push(cell);
+
+      for (const neighbor of adjacency.get(cell) ?? []) {
+        const deg = (inDegree.get(neighbor) ?? 0) - 1;
+        inDegree.set(neighbor, deg);
+        if (deg === 0) queue.push(neighbor);
+      }
+    }
+
+    return result;
+  }
+
+  // ----------------------------------------------------------------
+  // Evaluation Context
+  // ----------------------------------------------------------------
+
+  private createContext(): EvalContext {
+    const values = this.values;
+    return {
+      getCellValue(ref: string): unknown {
+        return values.has(ref) ? values.get(ref) : null;
+      },
+    };
+  }
+}
