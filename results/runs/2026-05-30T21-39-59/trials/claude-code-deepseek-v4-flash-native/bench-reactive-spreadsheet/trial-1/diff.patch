onst s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('A3', '=A1+A2');\n    expect(s.get('A3')).toBe(30);\n  });\n\n  it('evaluates subtraction', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 3);\n    s.set('A3', '=A1-A2');\n    expect(s.get('A3')).toBe(7);\n  });\n\n  it('evaluates multiplication', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 4);\n    s.set('A2', 5);\n    s.set('A3', '=A1*A2');\n    expect(s.get('A3')).toBe(20);\n  });\n\n  it('evaluates division', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 2);\n    s.set('A3', '=A1/A2');\n    expect(s.get('A3')).toBe(5);\n  });\n\n  it('respects operator precedence (multiplication before addition)', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 2);\n    s.set('A2', 3);\n    s.set('A3', 4);\n    s.set('B1', '=A1+A2*A3'); // 2 + 3*4 = 14\n    expect(s.get('B1')).toBe(14);\n  });\n\n  it('respects parentheses for grouping', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 2);\n    s.set('A2', 3);\n    s.set('A3', 4);\n    s.set('B1', '=(A1+A2)*A3'); // (2+3)*4 = 20\n    expect(s.get('B1')).toBe(20);\n  });\n\n  it('returns null for empty cell references in formulas', () => {\n    const s = new Spreadsheet();\n    s.set('A2', '=A1');\n    expect(s.get('A2')).toBeNull();\n  });\n\n  it('handles chained cell references', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=A1');\n    s.set('C1', '=B1');\n    expect(s.get('C1')).toBe(5);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Reactive updates\n// ---------------------------------------------------------------------------\n\ndescribe('Spreadsheet — reactive updates', () => {\n  it('updates a dependent cell when its dependency changes', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('A3', '=A1+A2');\n    expect(s.get('A3')).toBe(30);\n\n    s.set('A1', 50);\n    expect(s.get('A3')).toBe(70);\n  });\n\n  it('transitively updates through multiple levels', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 2);\n    s.set('B1', '=A1*3');   // 6\n    s.set('C1', '=B1+4');   // 10\n    expect(s.get('C1')).toBe(10);\n\n    s.set('A1', 10);\n    expect(s.get('B1')).toBe(30);\n    expect(s.get('C1')).toBe(34);\n  });\n\n  it('updates when an intermediate formula cell changes', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('B1', '=A1+1');   // 2\n    s.set('C1', '=B1+1');   // 3\n    s.set('B1', 100);       // B1 becomes raw value, cutting formula chain\n    expect(s.get('C1')).toBe(101);\n  });\n\n  it('handles a diamond dependency (two paths to the same cell)', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B1', '=A1+1');   // 11\n    s.set('C1', '=A1+2');   // 12\n    s.set('D1', '=B1+C1');  // 23\n    expect(s.get('D1')).toBe(23);\n\n    s.set('A1', 20);\n    expect(s.get('D1')).toBe(43); // (20+1)+(20+2) = 43\n  });\n\n  it('does not recompute cells unaffected by the change', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', '=A1+1');\n    s.set('B1', 99);\n\n    const spy = { count: 0 };\n    const origSet = s.set.bind(s);\n    // Just verify B1 stays at 99 after A1 changes\n    s.set('A1', 10);\n    expect(s.get('B1')).toBe(99);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Built-in functions\n// ---------------------------------------------------------------------------\n\ndescribe('Spreadsheet — built-in functions', () => {\n  it('SUM over a column range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('A3', 30);\n    s.set('B1', '=SUM(A1:A3)');\n    expect(s.get('B1')).toBe(60);\n  });\n\n  it('SUM over a row range', () => {\n    const s = new Spreadsheet();\n    s.set