      i++;\n        while (i < input.length && /\\d/.test(input[i])) {\n          num += input[i];\n          i++;\n        }\n      }\n      add('NUMBER', parseFloat(num));\n      continue;\n    }\n\n    // Identifiers, cell references, booleans\n    if (/[A-Za-z_]/.test(input[i])) {\n      let word = '';\n      while (i < input.length && /[A-Za-z0-9_]/.test(input[i])) {\n        word += input[i];\n        i++;\n      }\n      const upper = word.toUpperCase();\n      if (upper === 'TRUE') {\n        add('BOOLEAN', true);\n      } else if (upper === 'FALSE') {\n        add('BOOLEAN', false);\n      } else if (/^[A-Z]+\\d+$/.test(upper)) {\n        add('CELL_REF', upper);\n      } else {\n        add('IDENTIFIER', upper);\n      }\n      continue;\n    }\n\n    throw new Error(`Unexpected character: '${input[i]}'`);\n  }\n\n  add('EOF');\n  return tokens;\n}\n\n// ===== Parser (Recursive Descent) =====\n\nexport class Parser {\n  private tokens: Token[];\n  private current = 0;\n\n  constructor(tokens: Token[]) {\n    this.tokens = tokens;\n  }\n\n  parse(): Expr {\n    const expr = this.expression();\n    if (!this.check('EOF')) {\n      throw new Error(`Unexpected token: ${this.peek().type}`);\n    }\n    return expr;\n  }\n\n  // expression → equality\n  private expression(): Expr {\n    return this.equality();\n  }\n\n  // equality → comparison ((\"=\" | \"<>\") comparison)*\n  private equality(): Expr {\n    let left = this.comparison();\n    while (this.match('EQUAL', 'NOT_EQUAL')) {\n      const op = this.previous().type === 'EQUAL' ? '=' : '<>';\n      const right = this.comparison();\n      left = { type: 'binary', op, left, right };\n    }\n    return left;\n  }\n\n  // comparison → addition ((\">\" | \">=\" | \"<\" | \"<=\") addition)*\n  private comparison(): Expr {\n    let left = this.addition();\n    while (this.match('GREATER', 'GREATER_EQUAL', 'LESS', 'LESS_EQUAL')) {\n      const t = this.previous().type;\n      const op = t === 'GREATER' ? '>' : t === 'GREATER_EQUAL' ? '>=' : t === 'LESS' ? '<' : '<=';\n      const right = this.addition();\n      left = { type: 'binary', op, left, right };\n    }\n    return left;\n  }\n\n  // addition → multiplication ((\"+\" | \"-\") multiplication)*\n  private addition(): Expr {\n    let left = this.multiplication();\n    while (this.match('PLUS', 'MINUS')) {\n      const op = this.previous().type === 'PLUS' ? '+' : '-';\n      const right = this.multiplication();\n      left = { type: 'binary', op, left, right };\n    }\n    return left;\n  }\n\n  // multiplication → unary ((\"*\" | \"/\") unary)*\n  private multiplication(): Expr {\n    let left = this.unary();\n    while (this.match('STAR', 'SLASH')) {\n      const op = this.previous().type === 'STAR' ? '*' : '/';\n      const right = this.unary();\n      left = { type: 'binary', op, left, right };\n    }\n    return left;\n  }\n\n  // unary → (\"-\") unary | primary\n  private unary(): Expr {\n    if (this.match('MINUS')) {\n      return { type: 'unary', op: '-', operand: this.unary() };\n    }\n    return this.primary();\n  }\n\n  // primary → NUMBER | STRING | BOOLEAN\n  //          | \"(\" expression \")\"\n  //          | CELL_REF (\":\" CELL_REF)?\n  //          | IDENTIFIER \"(\" (expression (\",\" expression)*)? \")\"\n  private primary(): Expr {\n    if (this.match('NUMBER')) return { type: 'number', value: this.previous().value as number };\n    if (this.match('STRING')) return { type: 'string', value: this.previous().value as string };\n    if (this.match('BOOLEAN')) return { type: 'boolean', value: this.previous().value as boolean };\n\n    if (this.match('LEFT_PAREN')) {\n      const expr = this.expression();\n      this.consume('RIGHT_PAREN', \"Expect ')' after expression.\");\n      return expr;\n    }\n\n    if (this.match('CELL_REF')) {\n      const ref = this.previous().value as string;\n      if (this.match('COLON')) {\n        const end = this.consume('CELL_REF', \"Expect cell reference after ':'.\").value as string;\n        return { type: 'range', start: ref, end };\n      }\n      return { type: 'cellRef', ref };\n    }\n\n    if (this.match('IDENTIFIER')) {\n      const name = this.previous().value as string;\n      this.consume('LEFT_PAREN', `Expect '(' after function name '${name}'.`);\n      const args: Expr[] = [];\n      if (!this.check('RIGHT_PAREN')) {\n        do {\n          args.push(this.expression());\n        } while (this.match('COMMA'));\n      }\n      this.consume('RIGHT_PAREN', \"Expect ')' after arguments.\");\n      return { type: 'call', name, args };\n    }\n\n    throw new Error(`Unexpected token: ${this.peek().type}`);\n  }\n\n  private match(...types: TokenType[]): boolean {\n    for (const type of types) {\n      if (this.check(type)) {\n        this.current++;\n        return true;\n      }\n    }\n    return false;\n  }\n\n  private check(type: TokenType): boolean {\n    if (this.current >= this.tokens.length) return false;\n    return this.tokens[this.current].type === type;\n  }\n\n  private consume(type: TokenType, message: string): Token {\n    if (this.check(type)) return this.tokens[this.current++];\n    throw new Error(message);\n  }\n\n  private previous(): Token {\n    return this.tokens[this.current - 1];\n  }\n\n  private peek(): Token {\n    return this.tokens[this.current];\n  }\n}\n\n// ===== Value Helpers =====\n\nfunction toNumber(val: unknown): number {\n  if (val === null || val === undefined) return 0;\n  if (typeof val === 'number') return val;\n  if (typeof val === 'boolean') return val ? 1 : 0;\n  if (typeof val === 'string') {\n    const n = parseFloat(val);\n    return isNaN(n) ? 0 : n;\n  }\n  return 0;\n}\n\nfunction flattenArgs(args: unknown[]): unknown[] {\n  return args.flat(Infinity) as unknown[];\n}\n\n// ===== Built-in Functions =====\n\nconst functions: Record<string, (args: unknown[]) => unknown> = {\n  SUM(args: unknown[]): number {\n    const flat = flattenArgs(args);\n    const nums = flat.filter((v): v is number => typeof v === 'number');\n    return nums.reduce((a, b) => a + b, 0);\n  },\n\n  AVERAGE(args: unknown[]): number {\n    const flat = flattenArgs(args);\n    const nums = flat.filter((v): v is number => typeof v === 'number');\n    if (nums.length === 0) return 0;\n    return nums.reduce((a, b) => a + b, 0) / nums.length;\n  },\n\n  MIN(args: unknown[]): number {\n    const flat = flattenArgs(args);\n    const nums = flat.filter((v): v is number => typeof v === 'number');\n    if (nums.length === 0) return 0;\n    return Math.min(...nums);\n  },\n\n  MAX(args: unknown[]): number {\n    const flat = flattenArgs(args);\n    const nums = flat.filter((v): v is number => typeof v === 'number');\n    if (nums.length === 0) return 0;\n    return Math.max(...nums);\n  },\n\n  COUNT(args: unknown[]): number {\n    const flat = flattenArgs(args);\n    return flat.filter((v): v is number => typeof v === 'number').length;\n  },\n};\n\n// ===== Evaluator =====\n\nexport function evaluate(expr: Expr, context: EvalContext): unknown {\n  switch (expr.type) {\n    case 'number':\n    case 'string':\n    case 'boolean':\n      return expr.value;\n\n    case 'cellRef':\n      return context.getCellValue(expr.ref);\n\n    case 'range': {\n      const cells = expandRange(`${expr.start}:${expr.end}`);\n      return cells.map((cell) => context.getCellValue(cell));\n    }\n\n    case 'unary': {\n      const val = evaluate(expr.operand, context);\n      if (expr.op === '-') return -toNumber(val);\n      return val;\n    }\n\n    case 'binary': {\n      const left = evaluate(expr.left, context);\n      const right = evaluate(expr.right, context);\n\n      switch (expr.op) {\n        case '+':\n          return toNumber(left) + toNumber(right);\n        case '-':\n          return toNumber(left) - toNumber(right);\n        case '*':\n          return toNumber(left) * toNumber(right);\n        case '/':\n          return toNumber(left) / toNumber(right);\n        case '=