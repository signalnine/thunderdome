+/**
+ * Cell reference and range utilities for the spreadsheet engine.
+ */
+
+export interface CellRef {
+  col: string;
+  row: number;
+  colIndex: number;
+}
+
+/**
+ * Convert column letters to a zero-based index.
+ * A=0, B=1, ..., Z=25, AA=26, AB=27, ...
+ */
+export function colToIndex(col: string): number {
+  let index = 0;
+  for (let i = 0; i < col.length; i++) {
+    index = index * 26 + (col.charCodeAt(i) - 64);
+  }
+  return index - 1;
+}
+
+/**
+ * Convert a zero-based column index to column letters.
+ * 0=A, 1=B, ..., 25=Z, 26=AA, 27=AB, ...
+ */
+export function indexToCol(index: number): string {
+  let col = '';
+  let n = index + 1;
+  while (n > 0) {
+    const rem = (n - 1) % 26;
+    col = String.fromCharCode(65 + rem) + col;
+    n = Math.floor((n - 1) / 26);
+  }
+  return col;
+}
+
+/**
+ * Parse a cell reference string like "A1", "Z100", "AA1".
+ * Returns null if the reference is invalid.
+ */
+export function parseCellRef(ref: string): CellRef | null {
+  const match = ref.match(/^([A-Za-z]+)(\d+)$/);
+  if (!match) return null;
+  const col = match[1].toUpperCase();
+  return {
+    col,
+    row: parseInt(match[2], 10),
+    colIndex: colToIndex(col),
+  };
+}
+
+/**
+ * Parse a range string like "A1:C3" into start and end cell references.
+ * Returns null if the range is invalid.
+ */
+export function parseRange(range: string): { start: CellRef; end: CellRef } | null {
+  const parts = range.split(':');
+  if (parts.length !== 2) return null;
+  const start = parseCellRef(parts[0]);
+  const end = parseCellRef(parts[1]);
+  if (!start || !end) return null;
+  return { start, end };
+}
+
+/**
+ * Expand a range string into an array of individual cell references.
+ * Supports column ranges (A1:A5), row ranges (A1:C1), and block ranges (A1:C3).
+ */
+export function expandRange(range: string): string[] {
+  const parsed = parseRange(range);
+  if (!parsed) return [];
+
+  const cells: string[] = [];
+  const { start, end } = parsed;
+  const startCol = colToIndex(start.col);
+  const endCol = colToIndex(end.col);
+  const minRow = Math.min(start.row, end.row);
+  const maxRow = Math.max(start.row, end.row);
+  const minCol = Math.min(startCol, endCol);
+  const maxCol = Math.max(startCol, endCol);
+
+  for (let c = minCol; c <= maxCol; c++) {
+    const colStr = indexToCol(c);
+    for (let r = minRow; r <= maxRow; r++) {
+      cells.push(`${colStr}${r}`);
+    }
+  }
+
+  return cells;
+}
