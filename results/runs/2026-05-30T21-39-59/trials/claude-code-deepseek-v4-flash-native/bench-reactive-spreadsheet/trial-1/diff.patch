e(`${expr.start}:${expr.end}`);\n  return cells.map(cell => context.getCellValue(cell));\n}\n```\n\nThis returns an array of values. When wrapped in the function call handler, args becomes a mix of scalars and arrays. Functions like SUM/AVERAGE need to handle both.\n\nFor SUM:\n```typescript\nfunction sum(args: any[]): number {\n  const flat = args.flat(Infinity);\n  const numbers = flat.filter(v => typeof v === 'number');\n  return numbers.reduce((a, b) => a + b, 0);\n}\n```\n\nWait, but what about strings in ranges? In real spreadsheets, SUM ignores text. So if A1 = 10, A2 = \"hello\", then SUM(A1:A2) = 10. My filter already handles this.\n\nBut what about booleans? In Excel, SUM treats TRUE as 1 and FALSE as 0. Hmm, but the spec says booleans are values. Let me keep it simple and only sum numbers.\n\nOK, let me also handle the COUNT function:\n```typescript\nfunction count(args: any[]): number {\n  const flat = args.flat(Infinity);\n  return flat.filter(v => typeof v === 'number').length;\n}\n```\n\nAVERAGE:\n```typescript\nfunction average(args: any[]): number {\n  const flat = args.flat(Infinity);\n  const numbers = flat.filter(v => typeof v === 'number');\n  if (numbers.length === 0) return 0;\n  return numbers.reduce((a, b) => a + b, 0) / numbers.length;\n}\n```\n\nMIN:\n```typescript\nfunction min(args: any[]): number {\n  const flat = args.flat(Infinity);\n  const numbers = flat.filter(v => typeof v === 'number');\n  if (numbers.length === 0) return 0;\n  return Math.min(...numbers);\n}\n```\n\nMAX:\n```typescript\nfunction max(args: any[]): number {\n  const flat = args.flat(Infinity);\n  const numbers = flat.filter(v => typeof v === 'number');\n  if (numbers.length === 0) return 0;\n  return Math.max(...numbers);\n}\n```\n\nOK, I think I have everything. Let me now write the actual TypeScript code.\n\nWait, let me also think about error handling. The spec says:\n- Circular reference: throw error\n- Invalid formula: should throw error during parsing/evalua