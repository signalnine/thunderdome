('C1')).toBe(7);\n  });\n\n  it('allows overwriting a cell with a non-circular formula after a circular one was rejected', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B1', '=A1+1');\n    // This would be circular, so it throws:\n    expect(() => s.set('A1', '=B1')).toThrow(/circular/i);\n    // A1 should still have its old value:\n    expect(s.get('A1')).toBe(10);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Display values\n// ---------------------------------------------------------------------------\n\ndescribe('Spreadsheet — getDisplay', () => {\n  it('returns string representation of a number', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 42);\n    expect(s.getDisplay('A1')).toBe('42');\n  });\n\n  it('returns string representation of a boolean', () => {\n    const s = new Spreadsheet();\n    s.set('A1', true);\n    expect(s.getDisplay('A1')).toBe('true');\n  });\n\n  it('returns the string value itself', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 'hello');\n    expect(s.getDisplay('A1')).toBe('hello');\n  });\n\n  it('returns empty string for empty cell', () => {\n    const s = new Spreadsheet();\n    expect(s.getDisplay('A1')).toBe('');\n  });\n\n  it('returns the computed result for a formula', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('A3', '=A1+A2');\n    expect(s.getDisplay('A3')).toBe('30');\n  });\n\n  it('returns the string for a formula producing a string', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 40);\n    s.set('C1', '=IF(A1>30, \"big\", \"small\")');\n    expect(s.getDisplay('C1')).toBe('big');\n  });\n});\n\n// ---------------------------------------------------------------------------\n// getCells\n// ---------------------------------------------------------------------------\n\ndescribe('Spreadsheet — getCells', () => {\n  it('returns all non-empty cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B2', 'hello');\n    const cells = s.getCells();\n    expect(cells.get('A1')).toBe(10);\n    expect(cells.get('B2')).toBe('hello');\n    expect(cells.has('C3')).toBe(false);\n  });\n\n  it('returns computed values for formula cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('A3', '=A1+A2');\n    const cells = s.getCells();\n    expect(cells.get('A3')).toBe(30);\n  });\n\n  it('does not include empty cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('C1', 3);\n    const cells = s.getCells();\n    expect(cells.size).toBe(2);\n    expect(cells.has('B1')).toBe(false);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Edge cases\n// ---------------------------------------------------------------------------\n\ndescribe('Spreadsheet — edge cases', () => {\n  it('evaluates a formula with no cell references', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=2+3');\n    expect(s.get('A1')).toBe(5);\n  });\n\n  it('handles division by zero gracefully', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 0);\n    s.set('A3', '=A1/A2');\n    const val = s.get('A3');\n    expect(typeof val).toBe('number');\n    expect(isFinite(val as number)).toBe(false);\n  });\n\n  it('rejects an invalid formula', () => {\n    const s = new Spreadsheet();\n    expect(() => s.set('A1', '=+')).toThrow();\n  });\n\n  it('handles a formula with extra whitespace', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('A3', '= A1 + A2');\n    expect(s.get('A3')).toBe(30);\n  });\n\n  it('evaluates nested function calls', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('A3', 3);\n    s.set('A4', 4);\n    s.set('A5', 5);\n    s.set('B1', '=SUM(A1:A5)');\n    s.set('C1', '