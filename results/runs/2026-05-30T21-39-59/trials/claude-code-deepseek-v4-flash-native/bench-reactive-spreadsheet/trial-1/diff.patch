Ref } | null {\n  const parts = range.split(':');\n  if (parts.length !== 2) return null;\n  const start = parseCellRef(parts[0]);\n  const end = parseCellRef(parts[1]);\n  if (!start || !end) return null;\n  return { start, end };\n}\n\nexport function expandRange(range: string): string[] {\n  const parsed = parseRange(range);\n  if (!parsed) return [];\n  const cells: string[] = [];\n  const { start, end } = parsed;\n  const startCol = colToIndex(start.col);\n  const endCol = colToIndex(end.col);\n  for (let c = Math.min(startCol, endCol); c <= Math.max(startCol, endCol); c++) {\n    for (let r = Math.min(start.row, end.row); r <= Math.max(start.row, end.row); r++) {\n      cells.push(`${indexToCol(c)}${r}`);\n    }\n  }\n  return cells;\n}\n```\n\n### src/formula.ts\n\nThis will include types, tokenizer, parser, and evaluator.\n\n```typescript\nimport { expandRange } from './reference';\n\n// ===== Types =====\n\nexport type TokenType =\n  | 'NUMBER' | 'STRING' | 'BOOLEAN' | 'CELL_REF' | 'IDENTIFIER'\n  | 'PLUS' | 'MINUS' | 'STAR' | 'SLASH'\n  | 'EQUAL' | 'NOT_EQUAL' | 'GREATER' | 'GREATER_EQUAL' | 'LESS' | 'LESS_EQUAL'\n  | 'LEFT_PAREN' | 'RIGHT_PAREN' | 'COLON' | 'COMMA'\n  | 'EOF';\n\nexport interface Token {\n  type: TokenType;\n  value?: any;\n}\n\nexport type Expr =\n  | { type: 'number'; value: number }\n  | { type: 'string'; value: string }\n  | { type: 'boolean'; value: boolean }\n  | { type: 'cellRef'; ref: string }\n  | { type: 'range'; start: string; end: string }\n  | { type: 'binary'; op: string; left: Expr; right: Expr }\n  | { type: 'unary'; op: string; operand: Expr }\n  | { type: 'call'; name: string; args: Expr[] };\n\nexport interface EvalContext {\n  getCellValue(ref: string): any;\n}\n\n// ===== Tokenizer =====\n\nexport function tokenize(input: string): Token[] {\n  const tokens: Token[] = [];\n  let i = 0;\n  \n  const add = (type: TokenType, value?: any) => tokens.push({ type, value });\n  \n  while (i < input.length) {\n    // Whitespace\n    if (/\\s/.test(input[i])) { i++; continue; }\n    \n    // Two-char operators\n    if (input[i] === '>' && input[i+1] === '=') { add('GREATER_EQUAL'); i += 2; continue; }\n    if (input[i] === '<' && input[i+1] === '=') { add('LESS_EQUAL'); i += 2; continue; }\n    if (input[i] === '<' && input[i+1] === '>') { add('NOT_EQUAL'); i += 2; continue; }\n    \n    // Single-char tokens\n    switch (input[i]) {\n      case '+': add('PLUS'); i++; continue;\n      case '-': add('MINUS'); i++; continue;\n      case '*': add('STAR'); i++; continue;\n      case '/': add('SLASH'); i++; continue;\n      case '=': add('EQUAL'); i++; continue;\n      case '>': add('GREATER'); i++; continue;\n      case '<': add('LESS'); i++; continue;\n      case '(': add('LEFT_PAREN'); i++; continue;\n      case ')': add('RIGHT_PAREN'); i++; continue;\n      case ':': add('COLON'); i++; continue;\n      case ',': add('COMMA'); i++; continue;\n    }\n    \n    // String\n    if (input[i] === '\"') {\n      let s = '';\n      i++;\n      while (i < input.length && input[i] !== '\"') {\n        if (input[i] === '\\\\' && i + 1 < input.length) {\n          i++;\n          switch (input[i]) {\n            case 'n': s += '\\n'; break;\n            case 't': s += '\\t'; break;\n            case '\"': s += '\"'; break;\n            case '\\\\': s += '\\\\'; break;\n            default: s += input[i]; break;\n          }\n        } else {\n          s += input[i];\n        }\n        i++;\n      }\n      i++; // skip closing \"\n      add('STRING', s);\n      continue;\n    }\n    \n    // Number\n    if (/\\d/.test(input[i])) {\n      let num = '';\n      while (i < input.length && /\\d/.test(input[i])) { num += input[i]; i++; }\n      if (input[i] === '.' && i + 1 < input.length && /\\d/.test(input[i + 1])) {\n        num += '.';\n        i++;\n        while (i < input.length && /\\d/.test(input[i])) { num += input[i]; i++; }\n      }\n      add('NUMBER', parseFloat(num));\n      continue;\n    }\n    \n    // Identifier, cell reference, or boolean\n    if (/[A-Za-z_]/.test(input[i])) {\n      let word = '';\n      while (i < input.length && /[A-Za-z0-9_]/.test(input[i])) { word += input[i]; i++; }\n      const upper = word.toUpperCase();\n      if (upper === 'TRUE') add('BOOLEAN', true);\n      else if (upper === 'FALSE') add('BOOLEAN', false);\n      else if (/^[A-Z]+\\d+$/.test(upper)) add('CELL_REF', upper);\n      else add('IDENTIFIER', upper);\n      continue;\n    }\n    \n    throw new Error(`Unexpected character: '${input[i]}'`);\n  }\n  \n  add('EOF');\n  return tokens;\n}\n\n// ===== Parser =====\n\nexport class Parser {\n  private tokens: Token[];\n  private current = 0;\n  \n  constructor(tokens: Token[]) {\n    this.tokens = tokens;\n  }\n  \n  parse(): Expr {\n    const expr = this.expression();\n    if (!this.check('EOF')) {\n      throw new Error(`Unexpected token: ${this.peek().type}`);\n    }\n    return expr;\n  }\n  \n  private expression(): Expr {\n    return this.equality();\n  }\n  \n  private equality(): Expr {\n    let left = this.comparison();\n    while (this.match('EQUAL', 'NOT_EQUAL')) {\n      const op = this.previous().type === 'EQUAL' ? '=' : '<>';\n      const right = this.comparison();\n      left = { type: 'binary', op, left, right };\n    }\n    return left;\n  }\n  \n  private comparison(): Expr {\n    let left = this.addition();\n    while (this.match('GREATER', 'GREATER_EQUAL', 'LESS', 'LESS_EQUAL')) {\n      const t = this.previous().type;\n      const op = t === 'GREATER' ? '>' : t === 'GREATER_EQUAL' ? '>=' : t === 'LESS' ? '<' : '<=';\n      const right = this.addition();\n      left = { type: 'binary', op, left, right };\n    }\n    return left;\n  }\n  \n  private addition(): Expr {\n    let left = this.multiplication();\n    while (this.match('PLUS', 'MINUS')) {\n      const op = this.previous().type === 'PLUS' ? '+' : '-';\n      const right = this.multiplication();\n      left = { type: 'binary', op, left, right };\n    }\n    return left;\n  }\n  \n  private multiplication(): Expr {\n    let left = this.unary();\n    while (this.match('STAR', 'SLASH')) {\n      const op = this.previous().type === 'STAR' ? '*' : '/';\n      const right = this.unary();\n      left = { type: 'binary', op, left, right };\n    }\n    return left;\n  }\n  \n  private unary(): Expr {\n    if (this.match('MINUS')) {\n      return { type: 'unary', op: '-', operand: this.unary() };\n    }\n    return this.primary();\n  }\n  \n  private primary(): Expr {\n    if (this.match('NUMBER')) return { type: 'number', value: this.previous().value };\n    if (this.match('STRING')) return { type: 'string', value: this.previous().value };\n    if (this.match('BOOLEAN')) return { type: 'boolean', value: this.previous().value };\n    \n    if (this.match('LEFT_PAREN')) {\n      const expr = this.expression();\n      this.consume('RIGHT_PAREN', \"Expect ')' after expression.\");\n      return expr;\n    }\n    \n    if (this.match('CELL_REF')) {\n      const ref = this.previous().value;\n      if (this.match('COLON')) {\n        const end = this.consume('CELL_REF', \"Expect cell reference after ':'.\").value;\n        return { type: 'range', start: ref, end };\n      }\n      return { type: 'cellRef', ref };\n    }\n    \n    if (this.match('IDENTIFIER')) {\n      const name = this.previous().value;\n      this.consume('LEFT_PAREN', `Expect '(' after function name '${name}'.`);\n      const args: Expr[] = [];\n      if (!this.check('RIGHT_PAREN')) {\n        do {\n          args.push(this.expression());\n        } while (this.match('COMMA'));\n      }\n      this.consume('RIGHT_PAREN', \"Expect ')' after arguments.\");\n      return { type: 'call', name, args };\n    }\n    \n    throw new Error(`Unexpected token: ${this.peek().type}`);\n  }\n  \n  private match(...types: TokenType[]): boolean {\n    for (const type of types) {\n      if (this.check(type)) {\n        this.current++;\n        return true;\n      }\n    }\n    return false;\n  }\n  \n  private check(type: TokenType): boolean {\n    if (this.current >= this.tokens.length) return false;\n    return this.tokens[this.current].type === type;\n  }\n  \n  private consume(type: TokenType, message: string): Token {\n    if (this.check(type)) return this.tokens[this.current++];\n    throw new Error(message);\n  }\n  \n  private previous(): Token {\n    return this.tokens[this.current - 1];\n  }\n  \n  private peek(): Token {\n    return this.tokens[this.current];\n  }\n}\n\n// ===== Helpers =====\n\nfunction toNumber(val: any): number {\n  if (val === null || val === undefined) return 0;\n  if (typeof val === 'number') return val;\n  if (typeof val === 'boolean') return val ? 1 : 0;\n  if (typeof val === 'string') {\n    const n = parseFloat(val);\n    return isNaN(n) ? 0 : n;\n  }\n  return 0;\n}\n\nfunction flattenArgs(args: any[]): any[] {\n  return args.flat(Infinity);\n}\n\n// ===== Built-in functions =====\n\nconst functions: Record<string, (args: any[]) => any> = {\n  SUM(args: any[]): number {\n    const flat = flattenArgs(args);\n    const nums = flat.filter(v => typeof v === 'number');\n    return nums.reduce((a, b) => a + b, 0);\n  },\n  AVERAGE(args: any[]): number {\n    const flat = flattenArgs(args);\n    const nums = flat.filter(v => typeof v === 'number');\n    if (nums.length === 0) return 0;\n    return nums.reduce((a, b) => a + b, 0) / nums.length;\n  },\n  MIN(args: any[]): number {\n    const flat = flattenArgs(args);\n    const nums = flat.filter(v => typeof v === 'number');\n    if (nums.length === 0) return 0;\n    return Math.min(...nums);\n  },\n  MAX(args: any[]): number {\n    const flat = flattenArgs(args);\n    const nums = flat.filter(v => typeof v === 'number');\n    if (nums.length === 0) return 0;\n    return Math.max(...nums);\n  },\n  COUNT(args: any[]): number {\n    const flat = flattenArgs(args);\n    return flat.filter(v => typeof v === 'number').length;\n  },\n};\n\n// ===== Evaluator =====\n\nexport function evaluate(expr: Expr, context: EvalContext): any {\n  switch (expr.type) {\n    case 'number':\n    case 'string':\n    case 'boolean':\n      return expr.value;\n      \n    case 'cellRef':\n      return context.getCellValue(expr.ref);\n      \n    case 'range': {\n      const cells = expandRange(`${expr.start}:${expr.end}`);\n      return cells.map(cell => context.getCellValue(cell));\n    }\n      \n    case 'unary': {\n      const val = evaluate(expr.operand, context);\n      if (expr.op === '-') return -toNumber(val);\n      return val;\n    }\n      \n    case 'binary': {\n      const left = evaluate(expr.left, context);\n      const right = evaluate(expr.right, context);\n      \n      switch (expr.op) {\n        case '+': return toNumber(left) + toNumber(right);\n        case '-': return toNumber(left) - toNumber(right);\n        case '*': return toNumber(left) * toNumber(right);\n        case '/': return toNumber(left) / toNumber(right);\n        case '=': return left === right;\n        case '<>': return left !== right;\n        case '>': return toNumber(left) > toNumber(right);\n        case '>=': return toNumber(left) >= toNumber(right);\n        case '<': return toNumber(left) < toNumber(right);\n        case '<=': return toNumber(left) <= toNumber(right);\n        default: throw new Error(`Unknown operator: ${expr.op}`);\n      }\n    }\n      \n    case 'call': {\n      if (expr.name === 'IF') {\n        const condition = evaluate(expr.args[0], context);\n        if (condition) {\n          return evaluate(expr.args[1], context);\n        } else {\n          return evaluate(expr.args[2], context);\n        }\n      }\n      \n      if (expr.name in functions) {\n        const args = expr.args.map(arg => evaluate(arg, context));\n        return functions[expr.name](args);\n      }\n      \n      throw new Error(`Unknown function: ${expr.name}`);\n    }\n  }\n}\n\n// ===== Extract cell references from AST =====\n\nexport function extractCellRefs(expr: Expr): Set<string> {\n  const refs = new Set<string>();\n  \n  function walk(e: Expr): void {\n    switch (e.type) {\n      case 'cellRef':\n        refs.add(e.ref);\n        break;\n      case 'range':\n        expandRange(`${e.start}:${e.end}`).forEach(c => refs.add(c));\n        break;\n      case 'binary':\n        walk(e.left);\n        walk(e.right);\n        break;\n      case 'unary':\n        walk(e.operand);\n        break;\n      case 'call':\n        e.args.forEach(walk);\n        break;\n    }\n  }\n  \n  walk(expr);\n  return refs;\n}\n```\n\n### src/spreadsheet.ts\n\n```typescript\nimport { tokenize, Parser, evaluate, extractCellRefs, type EvalContext, type Expr } from './formula';\n\nexport class Spreadsheet {\n  private formulas: Map<string, string> = new Map();\n  private parsedFormulas: Map<string, Expr> = new Map();\n  private values: Map<string, any> = new Map();\n  \n  // depGraph[X] = set of cells that X depends on (X depends on these cells)\n  private depGraph: Map<string, Set<string>> = new Map();\n  // dependents[X] = set of cells that depend on X (these cells use X)\n  private dependents: Map<string, Set<string>> = new Map();\n  \n  set(cell: string, value: string | number | boolean): void {\n    const key = cell.toUpperCase();\n    \n    if (typeof value === 'string' && value.startsWith('=')) {\n      // Parse formula\n      const formulaStr = value.substring(1);\n      let tokens;\n      let ast;\n      try {\n        tokens = tokenize(formulaStr);\n        const parser = new Parser(tokens);\n        ast = parser.parse();\n      } catch (e: any) {\n        throw new Error(`Invalid formula in ${key}: ${e.message}`);\n      }\n      \n      // Extract dependencies\n      const deps = extractCellRefs(ast);\n      \n      // Check for circular dependency\n      if (this.wouldCreateCycle(key, deps)) {\n        throw new Error(`Circular reference: ${key} would create a cycle`);\n      }\n      \n      // Store formula\n      this.formulas.set(key, value);\n      this.parsedFormulas.set(key, ast);\n      \n      // Update dependency graph\n      this.setDependencies(key, deps);\n      \n      // Evaluate\n      const ctx = this.createContext();\n      try {\n        const result = evaluate(ast, ctx);\n        this.values.set(key, result);\n      } catch (e: any) {\n        this.values.set(key, null);\n      }\n    } else {\n      // Raw value\n      this.values.set(key, value);\n      this.formulas.delete(key);\n      this.parsedFormulas.delete(key);\n      \n      // Remove all dependencies\n      this.setDependencies(key, new Set());\n    }\n    \n    // Recompute all dependents\n    this.recompute(key);\n  }\n  \n  private setDependencies(cell: string, deps: Set<string>): void {\n    // Remove old dependencies\n    const oldDeps = this.depGraph.get(cell);\n    if (oldDeps) {\n      for (const dep of oldDeps) {\n        this.dependents.get(dep)?.delete(cell);\n      }\n    }\n    \n    // Set new dependencies\n    this.depGraph.set(cell, new Set(deps));\n    for (const dep of deps) {\n      if (!this.dependents.has(dep)) {\n        this.dependents.set(dep, new Set());\n      }\n      this.dependents.get(dep)!.add(cell);\n    }\n  }\n  \n  private wouldCreateCycle(cell: string, deps: Set<string>): boolean {\n    // BFS from each dependency to see if we can reach cell\n    const visited = new Set<string>();\n    const queue = [...deps];\n    \n    while (queue.length > 0) {\n      const current = queue.shift()!;\n      if (current === cell) return true;\n      if (visited.has(current)) continue;\n      visited.add(current);\n      \n      const nextDeps = this.depGraph.get(current);\n      if (nextDeps) {\n        queue.push(...nextDeps);\n      }\n    }\n    \n    return false;\n  }\n  \n  private recompute(changedCell: string): void {\n    // Find all transitive dependents\n    const affected = new Set<string>();\n    const queue = [...(this.dependents.get(changedCell) || [])];\n    \n    while (queue.length > 0) {\n      const cell = queue.shift()!;\n      if (affected.has(cell)) continue;\n      affected.add(cell);\n      \n      const deps = this.dependents.get(cell);\n      if (deps) {\n        queue.push(...deps);\n      }\n    }\n    \n    if (affected.size === 0) return;\n    \n    // Topological sort within the affected set\n    const sorted = this.topologicalSort(affected);\n    \n    // Recompute\n    const ctx = this.createContext();\n    for (const cell of sorted) {\n      const ast = this.parsedFormulas.get(cell);\n      if (ast) {\n        try {\n          this.values.set(cell, evaluate(ast, ctx));\n        } catch (e: any) {\n          this.values.set(cell, null);\n        }\n      }\n    }\n  }\n  \n  private topologicalSort(cells: Set<string>): string[] {\n    // Build subgraph with edges from dep → dependent within the set\n    const inDegree: Map<string, number> = new Map();\n    const adjacency: Map<string, Set<string>> = new Map();\n    \n    for (const cell of cells) {\n      if (!inDegree.has(cell)) inDegree.set(cell, 0);\n      if (!adjacency.has(cell)) adjacency.set(cell, new Set());\n      \n      const deps = this.depGraph.get(cell);\n      if (deps) {\n        for (const dep of deps) {\n          if (cells.has(dep)) {\n            // Edge: dep → cell (dep must be computed before cell)\n            adjacency.get(dep)!.add(cell);\n            inDegree.set(cell, (inDegree.get(cell) || 0) + 1);\n          }\n        }\n      }\n    }\n    \n    const queue: string[] = [];\n    for (const [cell, deg] of inDegree) {\n      if (deg === 0) queue.push(cell);\n    }\n    \n    const result: string[] = [];\n    while (queue.length > 0) {\n      const cell = queue.shift()!;\n      result.push(cell);\n      \n      for (const neighbor of adjacency.get(cell) || []) {\n        const deg = inDegree.get(neighbor)! - 1;\n        inDegree.set(neighbor, deg);\n        if (deg === 0) queue.push(neighbor);\n      }\n    }\n    