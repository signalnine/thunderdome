+/**
+ * Main Spreadsheet class.
+ *
+ * Manages a grid of cells containing values or formulas,
+ * with automatic reactive updates when dependencies change.
+ */
+
+import type { ASTNode } from './ast.js';
+import type { CellResolver } from './evaluator.js';
+import { parseFormula, extractCellRefs } from './parser.js';
+import { evaluate } from './evaluator.js';
+import { DependencyGraph } from './dependencyGraph.js';
+
+interface CellData {
+  /** The raw value or formula string */
+  raw: string | number | boolean;
+  /** Parsed formula AST, if the raw value is a formula */
+  formula?: ASTNode;
+}
+
+export class Spreadsheet {
+  /** Raw cell data (value or formula string) */
+  private cells: Map<string, CellData> = new Map();
+  /** Computed values */
+  private computed: Map<string, string | number | boolean> = new Map();
+  /** Dependency graph for reactive updates */
+  private graph: DependencyGraph = new DependencyGraph();
+
+  /**
+   * Set a cell's value. Can be a raw value (number, string, boolean)
+   * or a formula string starting with '='.
+   */
+  set(cell: string, value: string | number | boolean): void {
+    const normalizedCell = cell.toUpperCase();
+
+    // Check for circular reference first
+    if (typeof value === 'string' && value.startsWith('=')) {
+      const formulaBody = value.substring(1);
+      const ast = parseFormula(formulaBody);
+      const refs = extractCellRefs(ast);
+
+      // Try to set the dependencies; if it would create a cycle, throw
+      if (!this.graph.setDependencies(normalizedCell, refs)) {
+        throw new Error(
+          `Circular reference detected: setting ${cell} would create a cycle`
+        );
+      }
+
+      // Store and compute
+      this.cells.set(normalizedCell, { raw: value, formula: ast });
+    } else {
+      // Remove old dependencies (literal values have no dependencies)
+      this.graph.removeDependencies(normalizedCell);
+      this.cells.set(normalizedCell, { raw: value });
+    }
+
+    // Recompute this cell
+    this.recomputeCell(normalizedCell);
+
+    // Recompute all dependents
+    this.recomputeDependents(normalizedCell);
+  }
+
+  /**
+   * Get a cell's computed value. Returns null for empty cells.
+   */
+  get(cell: string): string | number | boolean | null {
+    const normalizedCell = cell.toUpperCase();
+    if (!this.cells.has(normalizedCell)) {
+      return null;
+    }
+    return this.computed.get(normalizedCell) ?? null;
+  }
+
+  /**
+   * Get the display string for a cell's computed value.
+   */
+  getDisplay(cell: string): string {
+    const value = this.get(cell);
+    if (value === null) return '';
+    return String(value);
+  }
+
+  /**
+   * Get all non-empty cells as a Map from cell reference to computed value.
+   */
+  getCells(): Map<string, string | number | boolean | null> {
+    const result = new Map<string, string | number | boolean | null>();
+    for (const [cell] of this.cells) {
+      result.set(cell, this.computed.get(cell) ?? null);
+    }
+    return result;
+  }
+
+  /**
+   * Recompute a single cell's value from its formula or raw value.
+   */
+  private recomputeCell(cell: string): void {
+    const data = this.cells.get(cell);
+    if (!data) {
+      this.computed.delete(cell);
+      return;
+    }
+
+    if (data.formula) {
+      // Evaluate formula
+      const resolver: CellResolver = (ref: string) => {
+        return this.computed.get(ref) ?? null;
+      };
+      try {
+        const value = evaluate(data.formula, resolver);
+        this.computed.set(cell, value);
+      } catch (e) {
+        // If evaluation fails, store the error as a string representation
+        this.computed.set(cell, 0);
+      }
+    } else {
+      // Raw value — store as-is
+      this.computed.set(cell, data.raw);
+    }
+  }
+
+  /**
+   * Recompute all transitive dependents of the changed cell,
+   * in topological order (dependencies before dependents).
+   */
+  private recomputeDependents(cell: string): void {
+    const dependents = this.graph.getTransitiveDependents(cell);
+    for (const dep of dependents) {
+      this.recomputeCell(dep);
+    }
+  }
+}
