ell, { raw: value, formula: ast });\n    } else {\n      // Remove old dependencies (literal values have no dependencies)\n      this.graph.removeDependencies(normalizedCell);\n      this.cells.set(normalizedCell, { raw: value });\n    }\n\n    // Recompute this cell\n    this.recomputeCell(normalizedCell);\n\n    // Recompute all dependents\n    this.recomputeDependents(normalizedCell);\n  }\n\n  /**\n   * Get a cell's computed value. Returns null for empty cells.\n   */\n  get(cell: string): string | number | boolean | null {\n    const normalizedCell = cell.toUpperCase();\n    if (!this.cells.has(normalizedCell)) {\n      return null;\n    }\n    return this.computed.get(normalizedCell) ?? null;\n  }\n\n  /**\n   * Get the display string for a cell's computed value.\n   */\n  getDisplay(cell: string): string {\n    const value = this.get(cell);\n    if (value === null) return '';\n    return String(value);\n  }\n\n  /**\n   * Get all non-empty cells as a Map from cell reference to computed value.\n   */\n  getCells(): Map<string, any> {\n    const result = new Map<string, any>();\n    for (const [cell] of this.cells) {\n      result.set(cell, this.computed.get(cell));\n    }\n    return result;\n  }\n\n  /**\n   * Recompute a single cell's value from its formula or raw value.\n   */\n  private recomputeCell(cell: string): void {\n    const data = this.cells.get(cell);\n    if (!data) {\n      this.computed.delete(cell);\n      return;\n    }\n\n    if (data.formula) {\n      // Evaluate formula\n      const resolver: CellResolver = (ref: string) => {\n        return this.computed.get(ref) ?? null;\n      };\n      try {\n        const value = evaluate(data.formula, resolver);\n        this.computed.set(cell, value);\n      } catch (e) {\n        // If evaluation fails, store the error as a string representation\n        this.computed.set(cell, 0);\n      }\n    } else {\n      // Raw value\n      if (data.raw === 'true') this.computed.set(cell, true);\n      else