index 0000000..3c69c84
--- /dev/null
+++ b/src/dependencyGraph.ts
@@ -0,0 +1,167 @@
+/**
+ * Directed acyclic graph for tracking cell dependencies.
+ *
+ * Edge direction: precedent → dependent
+ *   If B1 depends on A1, the edge is A1 → B1
+ *   (stored as dependents[A1].add(B1))
+ *
+ * This allows:
+ * 1. When A1 changes, we find all dependents to recompute
+ * 2. Topological sort to compute in the right order
+ * 3. Cycle detection before adding new edges
+ */
+
+export class DependencyGraph {
+  /**
+   * Forward edges: cell → Set of cells that depend on it.
+   * precedents[A1] = [B1, C1] means B1 and C1 depend on A1.
+   */
+  private dependents: Map<string, Set<string>> = new Map();
+
+  /**
+   * Backward edges: cell → Set of cells it depends on.
+   * deps[B1] = [A1] means B1 depends on A1.
+   */
+  private deps: Map<string, Set<string>> = new Map();
+
+  /**
+   * Set the dependencies for a cell. Returns true if successful,
+   * false if it would create a cycle.
+   *
+   * If the cell already had dependencies, they are replaced.
+   */
+  setDependencies(cell: string, newDeps: string[]): boolean {
+    // Remove old dependencies
+    this.removeDependencies(cell);
+
+    // Add new dependencies
+    const depSet = new Set(newDeps);
+    this.deps.set(cell, depSet);
+
+    for (const dep of depSet) {
+      if (!this.dependents.has(dep)) {
+        this.dependents.set(dep, new Set());
+      }
+      this.dependents.get(dep)!.add(cell);
+    }
+
+    // Check for cycles: follow forward edges from cell.
+    // If we can reach any of its new dependencies, adding them creates a cycle.
+    if (this.wouldFormCycle(cell, depSet)) {
+      // Rollback: remove the new dependencies
+      this.removeDependencies(cell);
+      return false;
+    }
+
+    return true;
+  }
+
+  /**
+   * Remove all dependency information for a cell.
+   */
+  removeDependencies(cell: string): void {
+    const oldDeps = this.deps.get(cell);
+    if (oldDeps) {
+      for (const dep of oldDeps) {
+        this.dependents.get(dep)?.delete(cell);
+        if (this.dependents.get(dep)?.size === 0) {
+          this.dependents.delete(dep);
+        }
+      }
+    }
+    this.deps.delete(cell);
+  }
+
+  /**
+   * Check if adding edges from deps to cell would create a cycle.
+   * A cycle exists if there's already a forward path from cell to any of its
+   * new dependencies.
+   */
+  private wouldFormCycle(cell: string, newDeps: Set<string>): boolean {
+    const visited = new Set<string>();
+    const stack = [cell];
+
+    while (stack.length > 0) {
+      const current = stack.pop()!;
+      if (newDeps.has(current)) {
+        return true;
+      }
+      if (visited.has(current)) continue;
+      visited.add(current);
+
+      const depsOfCurrent = this.dependents.get(current);
+      if (depsOfCurrent) {
+        for (const dep of depsOfCurrent) {
+          stack.push(dep);
+        }
+      }
+    }
+
+    return false;
+  }
+
+  /**
+   * Get all cells that directly depend on the given cell.
+   */
+  getDirectDependents(cell: string): string[] {
+    return [...(this.dependents.get(cell) ?? [])];
+  }
+
+  /**
+   * Get all cells that the given cell depends on directly.
+   */
+  getDependencies(cell: string): string[] {
+    return [...(this.deps.get(cell) ?? [])];
+  }
+
+  /**
+   * Get all cells that depend on the given cell, transitively.
+   * Returns them in topological order (dependencies before dependents).
+   */
+  getTransitiveDependents(cell: string): string[] {
+    const visited = new Set<string>();
+    const order: string[] = [];
+
+    const dfs = (c: string) => {
+      if (visited.has(c)) return;
+      visited.add(c);
+      const depsOfC = this.dependents.get(c);
+      if (depsOfC) {
+        for (const dep of depsOfC) {
+          dfs(dep);
+        }
+      }
+      order.push(c);
+    };
+
+    dfs(cell);
+
+    // Reverse post-order for topological sort
+    // This ensures dependencies come before cells that depend on them
+    order.reverse();
+
+    // Remove the starting cell
+    return order.filter(c => c !== cell);
+  }
+
+  /**
+   * Remove all graph data for a cell (both as dependent and dependency).
+   */
+  removeCell(cell: string): void {
+    this.removeDependencies(cell);
+
+    // Also remove from dependents maps of other cells
+    for (const [, depSet] of this.dependents) {
+      depSet.delete(cell);
+    }
+    this.dependents.delete(cell);
+    this.deps.delete(cell);
+  }
+
+  /**
+   * Check if the graph has any entries.
+   */
+  get hasEntries(): boolean {
+    return this.dependents.size > 0 || this.deps.size > 0;
+  }
+}
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..8595992
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,161 @@
+/**
+ * Evaluates a formula AST node into a computed value.
+ *
+ * The evaluator takes a `cellResolver` function that provides
+ * the current value of any cell reference encountered.
+ */
+
+import type { ASTNode } from './ast.js';
+import { resolveRange } from './reference.js';
+
+/** The types of values a cell can hold. */
+export type CellValue = string | number | boolean | null;
+
+/** Function type for looking up cell values during evaluation. */
+export type CellResolver = (ref: string) => CellValue;
+
+/**
+ * Evaluate an AST node and return its computed value.
+ */
+export function evaluate(node: ASTNode, resolveCell: CellResolver): string | number | boolean {
+  switch (node.type) {
+    case 'number':
+      return node.value;
+
+    case 'string':
+      return node.value;
+
+    case 'boolean':
+      return node.value;
+
+    case 'cellRef': {
+      const val = resolveCell(node.ref);
+      return val ?? 0; // empty cells resolve to 0
+    }
+
+    case 'range':
+      // Ranges should only appear as function arguments
+      throw new Error('Range used outside of function call');
+
+    case 'unaryOp':
+      if (node.op === '-') {
+        const val = evaluate(node.operand, resolveCell);
+        return -toNumber(val);
+      }
+      throw new Error(`Unknown unary operator: ${node.op}`);
+
+    case 'binaryOp': {
+      const left = evaluate(node.left, resolveCell);
+      const right = evaluate(node.right, resolveCell);
+
+      // Comparison operators return booleans
+      switch (node.op) {
+        case '>': return toNumber(left) > toNumber(right);
+        case '<': return toNumber(left) < toNumber(right);
+        case '>=': return toNumber(left) >= toNumber(right);
+        case '<=': return toNumber(left) <= toNumber(right);
+        case '=': return toNumber(left) === toNumber(right);
+        case '<>': return toNumber(left) !== toNumber(right);
+      }
+
+      // Arithmetic operators
+      switch (node.op) {
+        case '+': return toNumber(left) + toNumber(right);
+        case '-': return toNumber(left) - toNumber(right);
+        case '*': return toNumber(left) * toNumber(right);
+        case '/': return toNumber(left) / toNumber(right);
+      }
+
+      throw new Error(`Unknown binary operator: ${node.op}`);
+    }
+
+    case 'functionCall':
+      return evaluateFunction(node.name, node.args, resolveCell);
+
+    default:
+      throw new Error(`Unknown AST node type: ${(node as ASTNode).type}`);
+  }
+}
+
+function toNumber(val: unknown): number {
+  if (typeof val === 'number') return val;
+  if (val === null || val === undefined || val === false) return 0;
+  if (val === true) return 1;
+  const num = Number(val);
+  return isNaN(num) ? 0 : num;
+}
+
+/**
+ * Evaluate arguments to a function. Range arguments are expanded to their
+ * individual cell values. Returns a flat array of values.
+ */
+function resolveFunctionArgs(args: ASTNode[], resolveCell: CellResolver): CellValue[] {
+  const result: CellValue[] = [];
+  for (const arg of args) {
+    if (arg.type === 'range') {
+      const cells = resolveRange(arg.start, arg.end);
+      for (const ref of cells) {
+        result.push(resolveCell(ref) ?? null);
+      }
+    } else {
+      result.push(evaluate(arg, resolveCell));
+    }
+  }
+  return result;
+}
+
+function evaluateFunction(
+  name: string,
+  args: ASTNode[],
+  resolveCell: CellResolver
+): string | number | boolean {
+  switch (name) {
+    case 'SUM': {
+      const values = resolveFunctionArgs(args, resolveCell);
+      return values.reduce((sum: number, v: CellValue) => sum + toNumber(v), 0);
+    }
+
+    case 'AVERAGE': {
+      const values = resolveFunctionArgs(args, resolveCell);
+      const nums = values.filter(
+        (v: CellValue) => typeof v === 'number' || (v !== null && !isNaN(Number(v)))
+      );
+      if (nums.length === 0) return 0;
+      return nums.reduce((sum: number, v: CellValue) => sum + toNumber(v), 0) / nums.length;
+    }
+
+    case 'MIN': {
+      const values = resolveFunctionArgs(args, resolveCell);
+      const nums = values.map((v: CellValue) => toNumber(v));
+      if (nums.length === 0) return 0;
+      return Math.min(...nums);
+    }
+
+    case 'MAX': {
+      const values = resolveFunctionArgs(args, resolveCell);
+      const nums = values.map((v: CellValue) => toNumber(v));
+      if (nums.length === 0) return 0;
+      return Math.max(...nums);
+    }
+
+    case 'COUNT': {
+      const values = resolveFunctionArgs(args, resolveCell);
+      return values.filter(
+        (v: CellValue) => typeof v === 'number' || (v !== null && typeof v === 'boolean')
+      ).length;
+    }
+
+    case 'IF': {
+      if (args.length < 3) {
+        throw new Error('IF requires 3 arguments: condition, trueValue, falseValue');
+      }
+      const condition = evaluate(args[0], resolveCell);
+      const trueVal = evaluate(args[1], resolveCell);
+      const falseVal = evaluate(args[2], resolveCell);
+      return condition ? trueVal : falseVal;
+    }
+
+    default:
+      throw new Error(`Unknown function: ${name}`);
+  }
+}
