+/**
+ * Utilities for parsing and manipulating cell references like A1, AA1, etc.
+ *
+ * Columns: A-Z (1-26), AA-AZ (27-52), BA-BZ (53-78), ...
+ * Rows: 1-based integers.
+ */
+
+const CELL_REF_REGEX = /^([A-Z]+)(\d+)$/;
+
+/**
+ * Convert column letters to a 1-based column number.
+ * A → 1, B → 2, ..., Z → 26, AA → 27, ...
+ */
+export function columnToNumber(col: string): number {
+  let result = 0;
+  for (let i = 0; i < col.length; i++) {
+    result = result * 26 + (col.charCodeAt(i) - 64); // 'A' is 65 in ASCII
+  }
+  return result;
+}
+
+/**
+ * Convert a 1-based column number to column letters.
+ * 1 → A, 2 → B, ..., 26 → Z, 27 → AA, ...
+ */
+export function numberToColumn(num: number): string {
+  let result = '';
+  let n = num;
+  while (n > 0) {
+    n--; // shift so 0 = A
+    result = String.fromCharCode(65 + (n % 26)) + result;
+    n = Math.floor(n / 26);
+  }
+  return result;
+}
+
+/**
+ * Extract the column part from a cell reference like "A1".
+ */
+export function getColumn(ref: string): string {
+  const match = ref.match(CELL_REF_REGEX);
+  if (!match) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  return match[1];
+}
+
+/**
+ * Extract the row number from a cell reference like "A1".
+ */
+export function getRow(ref: string): number {
+  const match = ref.match(CELL_REF_REGEX);
+  if (!match) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  return parseInt(match[2], 10);
+}
+
+/**
+ * Parse a cell reference string into column and row components.
+ */
+export function parseCellRef(ref: string): { col: string; row: number; colNum: number } {
+  const match = ref.match(CELL_REF_REGEX);
+  if (!match) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  const col = match[1];
+  const row = parseInt(match[2], 10);
+  return { col, row, colNum: columnToNumber(col) };
+}
+
+/**
+ * Check if a string is a valid cell reference (e.g., A1, AA100).
+ */
+export function isValidCellRef(ref: string): boolean {
+  return CELL_REF_REGEX.test(ref);
+}
+
+/**
+ * Resolve a range string (A1:A5, A1:C3) into an array of cell references.
+ * Handles column ranges, row ranges, and block ranges.
+ */
+export function resolveRange(start: string, end: string): string[] {
+  const startCol = getColumn(start);
+  const startRow = getRow(start);
+  const endCol = getColumn(end);
+  const endRow = getRow(end);
+
+  const startColNum = columnToNumber(startCol);
+  const endColNum = columnToNumber(endCol);
+
+  const minCol = Math.min(startColNum, endColNum);
+  const maxCol = Math.max(startColNum, endColNum);
+  const minRow = Math.min(startRow, endRow);
+  const maxRow = Math.max(startRow, endRow);
+
+  const cells: string[] = [];
+  for (let col = minCol; col <= maxCol; col++) {
+    const colStr = numberToColumn(col);
+    for (let row = minRow; row <= maxRow; row++) {
+      cells.push(`${colStr}${row}`);
+    }
+  }
+  return cells;
+}
