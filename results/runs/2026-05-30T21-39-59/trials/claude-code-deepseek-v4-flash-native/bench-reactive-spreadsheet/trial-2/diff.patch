@@ -0,0 +1,58 @@
+/**
+ * AST node types for parsed formula expressions.
+ */
+
+export type ASTNode =
+  | NumberNode
+  | StringNode
+  | BooleanNode
+  | CellRefNode
+  | RangeNode
+  | BinaryOpNode
+  | UnaryOpNode
+  | FunctionCallNode;
+
+export interface NumberNode {
+  type: 'number';
+  value: number;
+}
+
+export interface StringNode {
+  type: 'string';
+  value: string;
+}
+
+export interface BooleanNode {
+  type: 'boolean';
+  value: boolean;
+}
+
+export interface CellRefNode {
+  type: 'cellRef';
+  ref: string;
+}
+
+export interface RangeNode {
+  type: 'range';
+  start: string;
+  end: string;
+}
+
+export interface BinaryOpNode {
+  type: 'binaryOp';
+  op: string;
+  left: ASTNode;
+  right: ASTNode;
+}
+
+export interface UnaryOpNode {
+  type: 'unaryOp';
+  op: string;
+  operand: ASTNode;
+}
+
+export interface FunctionCallNode {
+  type: 'functionCall';
+  name: string;
+  args: ASTNode[];
+}
