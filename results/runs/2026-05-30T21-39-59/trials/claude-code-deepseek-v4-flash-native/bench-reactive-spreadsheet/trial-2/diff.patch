+/**
+ * Formula tokenizer and parser.
+ *
+ * Produces an AST from a formula expression string (without the leading `=`).
+ *
+ * Grammar:
+ *   expression    → comparison
+ *   comparison    → addition ((">" | ">=" | "<" | "<=" | "=" | "<>") addition)*
+ *   addition      → term (("+" | "-") term)*
+ *   term          → unary (("*" | "/") unary)*
+ *   unary         → ("-") unary | primary
+ *   primary       → NUMBER | STRING | BOOLEAN
+ *                  | "(" expression ")"
+ *                  | functionCall
+ *                  | CELL_REF (":" CELL_REF)?
+ */
+
+import type { ASTNode } from './ast.js';
+import { resolveRange } from './reference.js';
+
+// ---- Token types ----
+
+type TokenType =
+  | 'NUMBER'
+  | 'STRING'
+  | 'BOOLEAN'
+  | 'CELL_REF'
+  | 'FUNCTION'
+  | 'PLUS'
+  | 'MINUS'
+  | 'STAR'
+  | 'SLASH'
+  | 'GREATER'
+  | 'GREATER_EQ'
+  | 'LESS'
+  | 'LESS_EQ'
+  | 'EQ'
+  | 'NOT_EQ'
+  | 'LPAREN'
+  | 'RPAREN'
+  | 'COMMA'
+  | 'COLON'
+  | 'EOF';
+
+interface Token {
+  type: TokenType;
+  value: string;
+}
+
+// ---- Tokenizer ----
+
+class Tokenizer {
+  private pos = 0;
+  private readonly source: string;
+
+  constructor(source: string) {
+    this.source = source;
+  }
+
+  private peek(offset = 0): string {
+    return this.source[this.pos + offset] ?? '\0';
+  }
+
+  private advance(): string {
+    return this.source[this.pos++] ?? '\0';
+  }
+
+  skipWhitespace(): void {
+    while (this.pos < this.source.length && /\s/.test(this.peek())) {
+      this.advance();
+    }
+  }
+
+  nextToken(): Token {
+    this.skipWhitespace();
+
+    if (this.pos >= this.source.length) {
+      return { type: 'EOF', value: '' };
+    }
+
+    const ch = this.peek();
+
+    // Single-character tokens
+    if (ch === '(') { this.advance(); return { type: 'LPAREN', value: '(' }; }
+    if (ch === ')') { this.advance(); return { type: 'RPAREN', value: ')' }; }
+    if (ch === ',') { this.advance(); return { type: 'COMMA', value: ',' }; }
+    if (ch === ':') { this.advance(); return { type: 'COLON', value: ':' }; }
+    if (ch === '+') { this.advance(); return { type: 'PLUS', value: '+' }; }
+    if (ch === '-') { this.advance(); return { type: 'MINUS', value: '-' }; }
+    if (ch === '*') { this.advance(); return { type: 'STAR', value: '*' }; }
+    if (ch === '/') { this.advance(); return { type: 'SLASH', value: '/' }; }
+
+    // Comparison operators: >=, <=, <>, >, <, =
+    if (ch === '>') {
+      this.advance();
+      if (this.peek() === '=') { this.advance(); return { type: 'GREATER_EQ', value: '>=' }; }
+      return { type: 'GREATER', value: '>' };
+    }
+    if (ch === '<') {
+      this.advance();
+      if (this.peek() === '=') { this.advance(); return { type: 'LESS_EQ', value: '<=' }; }
+      if (this.peek() === '>') { this.advance(); return { type: 'NOT_EQ', value: '<>' }; }
+      return { type: 'LESS', value: '<' };
+    }
+    if (ch === '=') {
+      this.advance();
+      // = at this level is the equality comparison operator
+      return { type: 'EQ', value: '=' };
+    }
+
+    // Strings: "hello"
+    if (ch === '"') {
+      return this.readString();
+    }
+
+    // Numbers: 42, 3.14
+    if (/\d/.test(ch)) {
+      return this.readNumber();
+    }
+
+    // Identifiers, cell references, booleans, function names
+    if (/[A-Za-z_]/.test(ch)) {
+      return this.readIdentifier();
+    }
+
+    throw new Error(`Unexpected character '${ch}' at position ${this.pos}`);
+  }
+
+  private readString(): Token {
+    this.advance(); // consume opening "
+    let value = '';
+    while (this.pos < this.source.length && this.peek() !== '"') {
+      value += this.advance();
+    }
+    if (this.pos >= this.source.length) {
+      throw new Error('Unterminated string literal');
+    }
+    this.advance(); // consume closing "
+    return { type: 'STRING', value };
+  }
+
+  private readNumber(): Token {
+    let value = '';
+    while (this.pos < this.source.length && /\d/.test(this.peek())) {
+      value += this.advance();
+    }
+    if (this.peek() === '.' && this.pos + 1 < this.source.length && /\d/.test(this.source[this.pos + 1])) {
+      value += this.advance(); // consume '.'
+      while (this.pos < this.source.length && /\d/.test(this.peek())) {
+        value += this.advance();
+      }
+    }
+    return { type: 'NUMBER', value };
+  }
+
+  private readIdentifier(): Token {
+    let value = '';
+    while (this.pos < this.source.length && /[A-Za-z0-9_]/.test(this.peek())) {
+      value += this.advance();
+    }
+
+    // Keywords: true, false
+    if (value === 'true') return { type: 'BOOLEAN', value: 'true' };
+    if (value === 'false') return { type: 'BOOLEAN', value: 'false' };
+
+    // Cell references: one or more letters followed by one or more digits (e.g., A1, AA100)
+    if (/^[A-Z]+[0-9]+$/i.test(value)) {
+      return { type: 'CELL_REF', value: value.toUpperCase() };
+    }
+
+    // Function names: any identifier followed by (
+    // We peek ahead (skipping whitespace) to see if the next char is (
+    const savedPos = this.pos;
+    this.skipWhitespace();
+    if (this.peek() === '(') {
+      return { type: 'FUNCTION', value: value.toUpperCase() };
+    }
+    // Not a function; restore position
+    this.pos = savedPos;
+
+    throw new Error(`Unexpected identifier '${value}' at position ${this.pos}`);
+  }
+
+  get position(): number {
+    return this.pos;
+  }
+}
+
+// ---- Parser ----
+
+export function parseFormula(source: string): ASTNode {
+  const tokenizer = new Tokenizer(source);
+  const tokens: Token[] = [];
+  // Tokenize all at once
+  for (;;) {
+    const token = tokenizer.nextToken();
+    tokens.push(token);
+    if (token.type === 'EOF') break;
+  }
+
+  // "peekable" token stream for recursive descent
+  let pos = 0;
+
+  function peek(): Token {
+    return tokens[pos];
+  }
+
+  function consume(type?: TokenType): Token {
+    const token = tokens[pos];
+    if (!token) throw new Error('Unexpected end of formula');
+    if (type !== undefined && token.type !== type) {
+      throw new Error(`Expected ${type} but got ${token.type} ('${token.value}') at token ${pos}`);
+    }
+    pos++;
+    return token;
+  }
+
+  function parseExpression(): ASTNode {
+    return parseComparison();
+  }
+
+  function parseComparison(): ASTNode {
+    let left = parseAddition();
+
+    const compOps = new Set<TokenType>(['GREATER', 'GREATER_EQ', 'LESS', 'LESS_EQ', 'EQ', 'NOT_EQ']);
+    while (compOps.has(peek().type)) {
+      const op = consume().value;
+      const right = parseAddition();
+      left = { type: 'binaryOp', op, left, right };
+    }
+
+    return left;
+  }
+
+  function parseAddition(): ASTNode {
+    let left = parseTerm();
+
+    while (peek().type === 'PLUS' || peek().type === 'MINUS') {
+      const op = consume().value;
+      const right = parseTerm();
+      left = { type: 'binaryOp', op, left, right };
+    }
+
+    return left;
+  }
+
+  function parseTerm(): ASTNode {
+    let left = parseUnary();
+
+    while (peek().type === 'STAR' || peek().type === 'SLASH') {
+      const op = consume().value;
+      const right = parseUnary();
+      left = { type: 'binaryOp', op, left, right };
+    }
+
+    return left;
+  }
+
+  function parseUnary(): ASTNode {
+    if (peek().type === 'MINUS') {
+      consume();
+      const operand = parseUnary();
+      return { type: 'unaryOp', op: '-', operand };
+    }
+    return parsePrimary();
+  }
+
+  function parsePrimary(): ASTNode {
+    const token = peek();
+
+    if (token.type === 'NUMBER') {
+      consume();
+      return { type: 'number', value: parseFloat(token.value) };
+    }
+
+    if (token.type === 'STRING') {
+      consume();
+      return { type: 'string', value: token.value };
+    }
+
+    if (token.type === 'BOOLEAN') {
+      consume();
+      return { type: 'boolean', value: token.value === 'true' };
+    }
+
+    if (token.type === 'LPAREN') {
+      consume();
+      const expr = parseExpression();
+      consume('RPAREN');
+      return expr;
+    }
+
+    if (token.type === 'FUNCTION') {
+      return parseFunctionCall();
+    }
+
+    if (token.type === 'CELL_REF') {
+      consume();
+      // Check for range: CELL_REF : CELL_REF
+      if (peek().type === 'COLON') {
+        consume('COLON');
+        const end = consume('CELL_REF');
+        return { type: 'range', start: token.value, end: end.value };
+      }
+      return { type: 'cellRef', ref: token.value };
+    }
+
+    throw new Error(`Unexpected token '${token.value}' (${token.type}) at position ${pos}`);
+  }
+
+  function parseFunctionCall(): ASTNode {
+    const name = consume('FUNCTION').value;
+    consume('LPAREN');
+
+    const args: ASTNode[] = [];
+    if (peek().type !== 'RPAREN') {
+      args.push(parseExpression());
+      while (peek().type === 'COMMA') {
+        consume('COMMA');
+        args.push(parseExpression());
+      }
+    }
+
+    consume('RPAREN');
+    return { type: 'functionCall', name, args };
+  }
+
+  const ast = parseExpression();
+  if (peek().type !== 'EOF') {
+    throw new Error(`Unexpected token '${peek().value}' after end of expression`);
+  }
+  return ast;
+}
+
+/**
+ * Extract all cell references from an AST node.
+ * Used for dependency tracking.
+ */
+export function extractCellRefs(node: ASTNode): string[] {
+  const refs = new Set<string>();
+
+  function walk(n: ASTNode): void {
+    switch (n.type) {
+      case 'cellRef':
+        refs.add(n.ref);
+        break;
+      case 'range':
+        {
+          const cells = resolveRange(n.start, n.end);
+          for (const cell of cells) {
+            refs.add(cell);
+          }
+        }
+        break;
+      case 'binaryOp':
+        walk(n.left);
+        walk(n.right);
+        break;
+      case 'unaryOp':
+        walk(n.operand);
+        break;
+      case 'functionCall':
+        for (const arg of n.args) {
+          walk(arg);
+        }
+        break;
+      default:
+        // number, string, boolean — no references
+        break;
+    }
+  }
+
+  walk(node);
+  return [...refs];
+}
