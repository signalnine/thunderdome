+
+    it('should evaluate division', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 10);
+      sheet.set('A2', 3);
+      sheet.set('A3', '=A1/A2');
+      expect(sheet.get('A3')).toBeCloseTo(3.333, 2);
+    });
+
+    it('should evaluate cell reference directly', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 42);
+      sheet.set('B1', '=A1');
+      expect(sheet.get('B1')).toBe(42);
+    });
+
+    it('should handle parentheses for grouping', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 2);
+      sheet.set('A2', 3);
+      sheet.set('A3', 4);
+      sheet.set('B1', '=(A1+A2)*A3');
