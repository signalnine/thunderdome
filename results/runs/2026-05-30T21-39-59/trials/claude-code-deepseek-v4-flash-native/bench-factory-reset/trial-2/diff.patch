lta === 0) continue;","-","         const cand = [...sol];","         let candCost = cost;","-","-        for (let i = 0; i < M; i++) {","-          if (bv[i] === 0) continue;","+        for (let t = 0; t < pos.length; t++) {","+          const i = pos[t];","           const oldV = cand[i];","           cand[i] = add(cand[i], mul(delta, bv[i], p), p);","           candCost += cand[i] - oldV;","         }"," ","         if (","-          candCost < bestCandidateCost ||","-          (candCost === bestCandidateCost &&","-            (bestCandidateSol === undefined ||","-              arrayLessThan(cand, bestCandidateSol)))","+          candCost < bestCost ||","+          (candCost === bestCost &&","+            (bestCand === undefined || arrayLessThan(cand, bestCand)))","         ) {","-          bestCandidateCost = candCost;","-          bestCandidateSol = cand;","-          bestVal = m;","+          bestCost = candCost;","+          bestCand = cand;","+          bestM = m;","         }","       }"," ","-      if (bestCandidateSol !== undefined) {","-        sol.splice(0, sol.length, ...bestCandidateSol);","-        cost = bestCandidateCost;","+      if (bestM !== curr) {","+        coeffs[j] = bestM;","+        sol.splice(0, sol.length, ...bestCand!);","+        cost = bestCost;","         improved = true;","       }","     }","   }","-","-  return sol;"," }"," "," // ==========================================================================","-// Finite-field helpers (GF(p), p prime, p ≤ 97)","+// Finite-field helpers (GF(p), p prime, p <= 97)"," // =========================================================================="," ","+function mod(a: number, p: number): number {","+  const r = a % p;","+  return r < 0 ? r + p : r;","+}","+"," function add(a: number, b: number, p: number): number {","   const r = a + b;","   return r >= p ? r - p : r;"]},{"oldStart":635,"oldLines":7,"newStart":606,"newLines":9,"lines":["   return res;"," }"," ","-/** Is array `a` lexicographically smaller than `b`? (MUTUAL length assumed) */","+// ---- array helpers --------------------------------------------------------","+","+/** True if array `a` is lexicographically smaller than `b` (same length). */"," function arrayLessThan(a: number[], b: number[]): boolean {","   for (let i = 0; i < a.length; i++) {","     if (a[i] !== b[i]) return a[i] < b[i];"]}],"originalFile":"// ============================================================================\n// Factory Reset – Toggle Puzzle (Part 1) & Counter Puzzle (Part 2)\n// ============================================================================\n\n// ---------------------------------------------------------------------------\n// Part 1 — Toggle Puzzle (GF(2))\n// ---------------------------------------------------------------------------\n\nexport interface Machine {\n  target: boolean[];\n  buttons: number[][];\n}\n\n/**\n * Solve the toggle puzzle.\n *\n * Each button toggles a specific set of lights.  Each button may be pressed at\n * most once.  Find the minimum-weight (fewest presses) solution with\n * lexicographically smallest tie-break, or null if none exists.\n *\n * Uses meet-in-the-middle on the button set when M > 22, direct enumeration\n * otherwise.\n */\nexport function solveToggle(machine: Machine): number[] | null {\n  const { target, buttons } = machine;\n  const N = target.length;\n  const M = buttons.length;\n\n  if (N === 0) return [];\n  if (M === 0) return target.every((v) => !v) ? [] : null;\n\n  // Precompute button masks (bits = light indices they affect)\n  const btnMasks: bigint[] = buttons.map((btn) => {\n    let m = 0n;\n    for (const idx of btn) m |= 1n << BigInt(idx);\n    return m;\n  });\n\n  // Target mask\n  let tgt = 0n;\n  for (let i = 0; i < N; i++) {\n    if (target[i]) tgt |= 1n << BigInt(i);\n  }\n\n  if (M <= 22) {\n    return solveToggleBrute(btnMasks, tgt, M);\n  }\n  return solveToggleMitm(btnMasks, tgt, M);\n}\n\n// ---- helpers shared by both toggle strategies ------------------------------\n\n/** Compare two button-set bitmasks lexicographically by index list.\n *  Returns negative if a < b, 0 if equal, positive if a > b. */\nfunction cmpBitmask(a: bigint, b: bigint, len: number): number {\n  for (let i = 0; i < len; i++) {\n    const ba = (a >> BigInt(i)) & 1n;\n    const bb = (b >> BigInt(i)) & 1n;\n    if (ba !== bb) return ba === 1n ? -1 : 1;\n  }\n  return 0;\n}\n\nfunction bitmaskToArray(m: bigint, len: number): number[] {\n  const out: number[] = [];\n  for (let i = 0; i < len; i++) {\n    if ((m >> BigInt(i)) & 1n) out.push(i);\n  }\n  return out;\n}\n\n// ---- direct brute-force (M ≤ 22) -------------------------------------------\n\nfunction solveToggleBrute(\n  btnMasks: bigint[],\n  tgt: bigint,\n  M: number,\n): number[] | null {\n  let bestMask: bigint | null = null;\n  let bestWt = Infinity;\n  const total = 1 << M;\n\n  for (let combo = 0; combo < total; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < M; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[i];\n        bm |= 1n << BigInt(i);\n        wt++;\n      }\n    }\n    if (pat === tgt) {\n      if (wt < bestWt || (wt === bestWt && cmpBitmask(bm, bestMask!, M) < 0)) {\n        bestWt = wt;\n        bestMask = bm;\n      }\n    }\n  }\n  return bestMask === null ? null : bitmaskToArray(bestMask, M);\n}\n\n// ---- meet-in-the-middle (M up to 40) ---------------------------------------\n\nfunction solveToggleMitm(\n  btnMasks: bigint[],\n  tgt: bigint,\n  M: number,\n): number[] | null {\n  const mid = Math.floor(M / 2);\n  const rightCnt = M - mid;\n\n  // Build left map: toggle-pattern → best (buttonMask, weight)\n  const leftMap = new Map<bigint, { bm: bigint; wt: number }>();\n  const leftTotal = 1 << mid;\n\n  for (let combo = 0; combo < leftTotal; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < mid; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[i];\n        bm |= 1n << BigInt(i);\n        wt++;\n      }\n    }\n    const prev = leftMap.get(pat);\n    if (\n      prev === undefined ||\n      wt < prev.wt ||\n      (wt === prev.wt && cmpBitmask(bm, prev.bm, mid) < 0)\n    ) {\n      leftMap.set(pat, { bm, wt });\n    }\n  }\n\n  // Enumerate right half and pair with left\n  const rightTotal = 1 << rightCnt;\n  let bestMask: bigint | null = null;\n  let bestWt = Infinity;\n\n  for (let combo = 0; combo < rightTotal; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < rightCnt; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[mid + i];\n        bm |= 1n << BigInt(mid + i);\n        wt++;\n      }\n    }\n\n    const need = tgt ^ pat;\n    const left = leftMap.get(need);\n    if (left === undefined) continue;\n\n    const totalWt = left.wt + wt;\n    const merged = left.bm | bm;\n\n    if (\n      totalWt < bestWt ||\n      (totalWt === bestWt && cmpBitmask(merged, bestMask!, M) < 0)\n    ) {\n      bestWt = totalWt;\n      bestMask = merged;\n    }\n  }\n\n  return bestMask === null ? null : bitmaskToArray(bestMask, M);\n}\n\n// ---------------------------------------------------------------------------\n// Part 2 — Counter Puzzle  (GF(p), p prime)\n// ---------------------------------------------------------------------------\n\n/**\n * Solve the counter puzzle.\n *\n * Each button increments a specific set of counters by 1 (wrapping at modulus\n * p).  Each button may be pressed 0 … p-1 times.  Return an array result[i] =\n * presses of button i, minimizing total presses (sum), with lexicographically\n * smallest tie-break, or null if no solution.\n */\nexport function solveCounter(\n  lights: number[],\n  buttons: number[][],\n  modulus: number,\n): number[] | null {\n  const N = lights.length; // counters\n  const M = buttons.length; // buttons\n  const p = modulus;\n\n  if (N === 0) return new Array(M).fill(0);\n  if (M === 0) {\n    return lights.every((v) => v === 0) ? [] : null;\n  }\n\n  // ---------- Build matrix ----------\n  // A[c][i] = 1 if button i affects counter c, else 0\n  const A: number[][] = Array.from({ length: N }, () => new Array(M).fill(0));\n  for (let i = 0; i < M; i++) {\n    for (const c of buttons[i]) {\n      A[c][i] = 1;\n    }\n  }\n\n  // ---------- Gaussian elimination over GF(p) ----------\n  const elim = gaussElimination(A, lights, p);\n  if (elim === null) return null; // inconsistent\n\n  const { particular, nullBasis, pivotCols } = elim;\n  const k = nullBasis.length;\n\n  if (k === 0) {\n    // Unique solution – no free variables\n    return particular;\n  }\n\n  // ---------- Search for minimum-cost solution ----------\n  // Enumerate null space when feasible, else use iterative descent.\n  // Compute the enumeration threshold adaptively.\n  let threshold = 5_000_000;\n  // Clamp so p^k doesn't exceed the threshold\n  let enumOk = true;\n  let combos = 1;\n  for (let i = 0; i < k; i++) {\n    combos *= p;\n    if (combos > threshold) {\n      enumOk = false;\n      break;\n    }\n  }\n\n  if (enumOk && combos <= threshold) {\n    return enumerateNullSpace(particular, nullBasis, p, k);\n  }\n  return descentNullSpace(particular, nullBasis, p, k);\n}\n\n// ==========================================================================\n// Gaussian elimination over GF(p)\n// ==========================================================================\n\ninterface ElimResult {\n  particular: number[];\n  nullBasis: number[][];\n  pivotCols: number[];\n}\n\n/**\n * Perform Gauss–Jordan elimination on the N×M matrix A over GF(p) with RHS b.\n * Returns the particular solution (free vars = 0), null space basis vectors,\n * and pivot column indices, or null if the system is inconsistent.\n *\n * The result satisfies: A * particular ≡ b (mod p), and\n * A * nullBasis[j] ≡ 0 (mod p) for each basis vector j.\n */\nfunction gaussElimination(\n  A: number[][],\n  b: number[],\n  p: number,\n): ElimResult | null {\n  const N = A.length;\n  const M = A[0].length;\n\n  // Augmented matrix with M+1 columns\n  const aug: number[][] = Array.from({ length: N }, (_, r) => {\n    const row = new Array(M + 1);\n    for (let c = 0; c < M; c++) row[c] = A[r][c] % p;\n    row[M] = b[r] % p;\n    return row;\n  });\n\n  const pivotCols: number[] = [];\n  let row = 0;\n\n  for (let col = 0; col < M && row < N; col++) {\n    // Find pivot (non-zero entry in this column at or below row `row`)\n    let pivotRow = -1;\n    for (let r = row; r < N; r++) {\n      if (aug[r][col] !== 0) {\n        pivotRow = r;\n        break;\n      }\n    }\n    if (pivotRow === -1) continue;\n\n    // Swap pivot row to current position\n    [aug[row], aug[pivotRow]] = [aug[pivotRow], aug[row]];\n\n    // Normalize pivot row (make aug[row][col] = 1)\n    const inv = modInv(aug[row][col], p);\n    for (let c = col; c <= M; c++) {\n      aug[row][c] = mul(aug[row][c], inv, p);\n    }\n\n    // Eliminate this column from ALL other rows (Gauss–Jordan)\n    for (let r = 0; r < N; r++) {\n      if (r !== row && aug[r][col] !== 0) {\n        const factor = aug[r][col];\n        for (let c = col; c <= M; c++) {\n          aug[r][c] = sub(aug[r][c], mul(factor, aug[row][c], p), p);\n        }\n      }\n    }\n\n    pivotCols.push(col);\n    row++;\n  }\n\n  // Inconsistency check: any row with all-zero LHS but non-zero RHS?\n  for (let r = row; r < N; r++) {\n    let zeroLhs = true;\n    for (let c = 0; c < M; c++) {\n      if (aug[r][c] !== 0) {\n        zeroLhs = false;\n        break;\n      }\n    }\n    if (zeroLhs && aug[r][M] !== 0) return null;\n  }\n\n  // ---- Particular solution (free variables = 0) ----\n  const particular = new Array(M).fill(0);\n  for (let i = 0; i < pivotCols.length; i++) {\n    const pc = pivotCols[i];\n    particular[pc] = aug[i][M]; // RHS of pivot row i\n  }\n\n  // ---- Null space basis ----\n  // Free variables are columns NOT in pivotCols\n  const freeCols: number[] = [];\n  const isPivot = new Set(pivotCols);\n  for (let c = 0; c < M; c++) {\n    if (!isPivot.has(c)) freeCols.push(c);\n  }\n\n  const nullBasis: number[][] = [];\n  for (let fi = 0; fi < freeCols.length; fi++) {\n    const fc = freeCols[fi];\n    const v = new Array(M).fill(0);\n    v[fc] = 1; // free var = 1\n\n    // For each pivot row, compute the value of the pivot variable\n    for (let ri = 0; ri < pivotCols.length; ri++) {\n      const pc = pivotCols[ri];\n      // Equation: x_pc + sum_{free} aug[ri][free] * y_free = aug[ri][M]\n      // For y_fc = 1, others = 0: x_pc = -aug[ri][fc] (mod p)\n      v[pc] = sub(0, aug[ri][fc], p);\n    }\n    nullBasis.push(v);\n  }\n\n  return { particular, nullBasis, pivotCols };\n}\n\n// ==========================================================================\n// Enumeration of null space (small k)\n// ==========================================================================\n\n/**\n * Search the null-space coset particular + span(nullBasis) for the\n * minimum-total-presses solution by enumerating all p^k assignments to\n * the free variables.\n *\n * Uses incremental updates of the solution vector for efficiency.\n */\nfunction enumerateNullSpace(\n  particular: number[],\n  nullBasis: number[][],\n  p: number,\n  k: number,\n): number[] | null {\n  const M = particular.length;\n  const total = Math.pow(p, k);\n\n  // Current solution vector and cost\n  const sol = [...particular];\n  let cost = sol.reduce((a, b) => a + b, 0);\n\n  let bestSol: number[] = [...sol];\n  let bestCost = cost;\n\n  // Indices into free variables (base-p counter)\n  const idx = new Array(k).fill(0);\n\n  for (let iter = 0; iter < total - 1; iter++) {\n    // Check current before incrementing\n    if (cost < bestCost || (cost === bestCost && arrayLessThan(sol, bestSol))) {\n      bestCost = cost;\n      bestSol = [...sol];\n    }\n\n    // Increment base-p counter, update sol and cost incrementally\n    for (let j = k - 1; j >= 0; j--) {\n      if (idx[j] < p - 1) {\n        // idx[j] → idx[j] + 1 : add one copy of nullBasis[j]\n        const bv = nullBasis[j];\n        // cost change: one more press of this free variable; each basic\n        // variable that depends on it also changes by bv[i] (mod p):\n        // new_cost change = (bv[i] != 0 ? newVal - oldVal : 0) accounting for wrap\n        for (let i = 0; i < M; i++) {\n          if (bv[i] === 0) continue;\n          const oldV = sol[i];\n          sol[i] = add(sol[i], bv[i], p);\n          cost += sol[i] - oldV;\n        }\n        // The free variable itself also increments by 1 → cost +1\n        cost += 1;\n        idx[j]++;\n        break;\n      } else {\n        // idx[j] goes from p-1 back to 0: remove (p-1) copies, i.e. subtract nullBasis[j] * (p-1)\n        const bv = nullBasis[j];\n        for (let i = 0; i < M; i++) {\n          if (bv[i] === 0) continue;\n          const oldV = sol[i];\n          // Subtract bv[i] * (p-1) = add bv[i] (since -(p-1) ≡ 1 mod p)\n          sol[i] = add(sol[i], bv[i], p); // same as subtracting (p-1) copies\n          cost += sol[i] - oldV;\n        }\n        // The free variable cost goes from p-1 to 0 → change = -(p-1)\n        cost -= p - 1;\n        idx[j] = 0;\n      }\n    }\n  }\n\n  // Check the last combination\n  if (cost < bestCost || (cost === bestCost && arrayLessThan(sol, bestSol))) {\n    bestCost = cost;\n    bestSol = [...sol];\n  }\n\n  return bestSol;\n}\n\n// ==========================================================================\n// Iterative descent for large null spaces\n// ==========================================================================\n\n/**\n * Search the null-space coset using coordinate descent.\n *\n * For each free variable (basis vector), try all p possible values and pick\n * the one that minimises total cost (with lexicographic tie-break).\n * Repeat until no improvement, then try additional random restarts.\n */\nfunction descentNullSpace(\n  particular: number[],\n  nullBasis: number[][],\n  p: number,\n  k: number,\n): number[] {\n  const M = particular.length;\n\n  // Start from y = 0 (the particular solution)\n  const best = runDescent(particular, nullBasis, p, k);\n  let bestCost = costSum(best);\n\n  // Additional restarts from random starting points\n  const restarts = 4;\n  for (let r = 0; r < restarts; r++) {\n    const start = [...particular];\n    for (let j = 0; j < k; j++) {\n      const c = Math.floor(Math.random() * p);\n      if (c === 0) continue;\n      const bv = nullBasis[j];\n      for (let i = 0; i < M; i++) {\n        start[i] = add(start[i], mul(c, bv[i], p), p);\n      }\n    }\n    const sol = runDescent(start, nullBasis, p, k);\n    const cst = costSum(sol);\n    if (cst < bestCost || (cst === bestCost && arrayLessThan(sol, best))) {\n      bestCost = cst;\n      best.splice(0, best.length, ...sol);\n    }\n  }\n\n  return best;\n}\n\n/**\n * Coordinate descent from a starting solution.\n * For each basis vector in sequence, try every multiple 0…p-1 and adopt\n * the choice that minimises cost (with lexicographic tie-break).\n * Repeat until a full pass yields no improvement.\n */\nfunction runDescent(\n  start: number[],\n  nullBasis: number[][],\n  p: number,\n  k: number,\n): number[] {\n  const M = start.length;\n  const sol = [...start];\n  let cost = costSum(sol);\n  let improved = true;\n\n  while (improved) {\n    improved = false;\n    for (let j = 0; j < k; j++) {\n      const bv = nullBasis[j];\n      // Try all possible multiples of this basis vector\n      let bestVal = 0;\n      let bestCandidateCost = cost; // with mult = 0\n      let bestCandidateSol: number[] | undefined;\n\n      // Current multiple of this basis in the solution\n      // We'll test each multiple m = 0 … p-1\n\n      // Find out the current multiple of basis j in `sol`.\n      // We can change from current multiple to any m.\n      // Instead of computing the current multiple, just try all m and\n      // compute the resulting solution.\n\n      for (let m = 0; m < p; m++) {\n        // Compute sol' = sol + (m - curr) * bv (mod p)\n        // But we don't know curr directly.  Simpler: compute delta.\n        // Actually, we can compute the effect of setting this free variable to m\n        // while keeping all other free variables fixed.\n        //\n        // The linear combination is:\n        // sol = particular + sum_l coeff[l] * nullBasis[l]\n        // We want to change only coeff[j] to m:\n        // sol' = particular + sum_{l≠j} coeff[l] * nullBasis[l] + m * nullBasis[j]\n        //      = sol - curr * nullBasis[j] + m * nullBasis[j]\n        //      = sol + (m - curr) * nullBasis[j] (mod p)\n        // = sol + delta * bv (mod p)\n\n        // Compute sol + (m - curr) * bv without knowing curr:\n        // We'll compute from scratch: particular + sum.  But that's M*k per try.\n        // Instead compute delta = m - curr by determining curr first.\n\n        // Determine current coefficient of nullBasis[j] in sol\n        // by looking at the free variable position (where bv[free] = 1,\n        // with bv being a unit vector at the free variable position)\n        // Actually bv[freeCol] = 1 for the free column, and for each pivot\n        // column pc, bv[pc] = -aug[i][freeCol].\n        // So the current coefficient is sol[freeCol].\n        break;\n      }\n\n      // ---- Simplified approach: for each m, compute full result ----\n      // Since p ≤ 97 and M ≤ 40, this is fast enough.\n      let currCoeff = 0;\n      // Find the free variable position for this basis vector\n      // The free variable is at the position where bv[i] = 1 (by construction)\n      // and bv has a single non-zero entry that is 1 (the free variable itself)\n      // plus negative values for pivot columns.\n      for (let i = 0; i < M; i++) {\n        if (bv[i] === 1) {\n          // Check if this is the free variable position, not a pivot column\n       