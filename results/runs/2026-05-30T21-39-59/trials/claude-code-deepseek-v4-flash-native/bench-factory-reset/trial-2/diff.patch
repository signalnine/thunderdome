t\n  let total = 1;\n  for (let i = 0; i < k; i++) {\n    total *= p;\n    if (total > 5_000_000) return false;\n  }\n  return true;\n}\n\n/**\n * Search the null-space coset particular + span(nullBasis) for the\n * minimum-total-presses solution by enumerating all p^k assignments.\n *\n * Uses incremental updates of the solution vector.\n */\nfunction enumerateNullSpace(\n  particular: number[],\n  nullBasis: number[][],\n  pivotCols: number[],\n  p: number,\n): number[] {\n  const M = particular.length;\n  const k = nullBasis.length;\n\n  // Precompute non-zero positions for each basis vector\n  const nz: number[][] = nullBasis.map((bv) => {\n    const pos: number[] = [];\n    for (let i = 0; i < M; i++) {\n      if (bv[i] !== 0) pos.push(i);\n    }\n    return pos;\n  });\n\n  // Current free-variable coefficients (base-p counter)\n  const idx = new Array(k).fill(0);\n\n  // Current solution vector and cost\n  const sol = [...particular];\n  let cost = costSum(sol);\n\n  let bestSol: number[] = [...sol];\n  let bestCost = cost;\n\n  // Total number of combinations\n  const total = Math.pow(p, k);\n\n  for (let iter = 0; iter < total; iter++) {\n    // Evaluate current state\n    if (cost < bestCost || (cost === bestCost && arrayLessThan(sol, bestSol))) {\n      bestCost = cost;\n      bestSol = [...sol];\n    }\n\n    // Increment base-p counter (skip on the last iteration)\n    if (iter === total - 1) break;\n\n    // Carry-propagate increment: increase the rightmost non-max position\n    // by 1, reset all positions to its right to 0.\n    for (let j = k - 1; j >= 0; j--) {\n      if (idx[j] < p - 1) {\n        // idx[j] goes from v to v+1  : add one copy of nullBasis[j]\n        idx[j]++;\n        const pos = nz[j];\n        for (let t = 0; t < pos.length; t++) {\n          const i = pos[t];\n          const oldV = sol[i];\n          sol[i] = add(sol[i], nullBasis[j][i], p);\n          cost += sol[i] - oldV;\n        }\n        break;\n      } else {\n        