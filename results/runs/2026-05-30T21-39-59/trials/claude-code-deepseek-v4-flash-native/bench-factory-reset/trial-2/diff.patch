ic set of counters by 1 (wrapping at modulus\n183\t * p).  Each button may be pressed 0 .. p-1 times.  Return an array result[i] =\n184\t * presses of button i, minimising total presses (sum), with lexicographically\n185\t * smallest tie-break, or null if no solution.\n186\t */\n187\texport function solveCounter(\n188\t  lights: number[],\n189\t  buttons: number[][],\n190\t  modulus: number,\n191\t): number[] | null {\n192\t  const N = lights.length; // counters\n193\t  const M = buttons.length; // buttons\n194\t  const p = modulus;\n195\t\n196\t  if (N === 0) return new Array(M).fill(0);\n197\t  if (M === 0) {\n198\t    return lights.every((v) => v === 0) ? [] : null;\n199\t  }\n200\t\n201\t  // ---------- Build matrix ----------\n202\t  // A[c][i] = 1 if button i affects counter c, else 0\n203\t  const A: number[][] = Array.from({ length: N }, () => new Array(M).fill(0));\n204\t  for (let i = 0; i < M; i++) {\n205\t    for (const c of buttons[i]) {\n206\t      A[c][i] = 1;\n207\t    }\n208\t  }\n209\t\n210\t  // ---------- Gaussian elimination over GF(p) ----------\n211\t  const elim = gaussElimination(A, lights, p);\n212\t  if (elim === null) return null; // inconsistent\n213\t\n214\t  const { particular, nullBasis, pivotCols } = elim;\n215\t  const k = nullBasis.length;\n216\t\n217\t  if (k === 0) {\n218\t    // Unique solution - no free variables\n219\t    return particular;\n220\t  }\n221\t\n222\t  // ---------- Search for minimum-cost solution ----------\n223\t  // Decide strategy based on p^k enumeration cost\n224\t  if (canEnumerate(p, k)) {\n225\t    return enumerateNullSpace(particular, nullBasis, pivotCols, p);\n226\t  }\n227\t  return descentNullSpace(particular, nullBasis, pivotCols, p);\n228\t}\n229\t\n230\t// ==========================================================================\n231\t// Gaussian elimination over GF(p)\n232\t// ==========================================================================\n233\t\n234\tinterface ElimResult {\n235\t  particular: number[];\n236\t  nullBasis: number[][];\n237\t  pivotCols: number[];\n238\t}\n239\t\n240\t/**\n241\t * Perform Gauss-Jordan elimination on the NxM matrix A over GF(p) with RHS b.\n242\t * Returns the particular solution (free vars = 0), null space basis vectors,\n243\t * and pivot column indices, or null if the system is inconsistent.\n244\t */\n245\tfunction gaussElimination(\n246\t  A: number[][],\n247\t  b: number[],\n248\t  p: number,\n249\t): ElimResult | null {\n250\t  const N = A.length;\n251\t  const M = A[0].length;\n252\t\n253\t  // Augmented matrix\n254\t  const aug: number[][] = Array.from({ length: N }, (_, r) => {\n255\t    const row = new Array(M + 1);\n256\t    for (let c = 0; c < M; c++) row[c] = mod(A[r][c], p);\n257\t    row[M] = mod(b[r], p);\n258\t    return row;\n259\t  });\n260\t\n261\t  const pivotCols: number[] = [];\n262\t  let row = 0;\n263\t\n264\t  for (let col = 0; col < M && row < N; col++) {\n265\t    // Find pivot (non-zero entry in this column at or below 'row')\n266\t    let pivotRow = -1;\n267\t    for (let r = row; r < N; r++) {\n268\t      if (aug[r][col] !== 0) {\n269\t        pivotRow = r;\n270\t        break;\n271\t      }\n272\t    }\n273\t    if (pivotRow === -1) continue;\n274\t\n275\t    // Swap pivot row to current position\n276\t    [aug[row], aug[pivotRow]] = [aug[pivotRow], aug[row]];\n277\t\n278\t    // Normalise pivot row (make pivot == 1)\n279\t    const inv = modInv(aug[row][col], p);\n280\t    for (let c = col; c <= M; c++) {\n281\t      aug[row][c] = mul(aug[row][c], inv, p);\n282\t    }\n283\t\n284\t    // Eliminate this column from ALL other rows (Gauss-Jordan)\n285\t    for (let r = 0; r < N; r++) {\n286\t      if (r !== row && aug[r][col] !== 0) {\n287\t        const factor = aug[r][col];\n288\t        for (let c = col; c <= M; c++) {\n289\t          aug[r][c] = sub(aug[r][c], mul(factor, aug[row][c], p), p);\n290\t        }\n291\t      }\n292\t    }\n293\t\n294\t    pivotCols.push(col);\n295\t    row++;\n296\t  }\n297\t\n298\t  // Inconsistency check: any row with all-zero LHS but non-zero RHS?\n299\t  for (let r = row; r < N; r++) {\n300\t    let zeroLhs = true;\n301\t    for (let c = 0; c < M; c++) {\n302\t      if (aug[r][c] !== 0) {\n303\t        zeroLhs = false;\n304\t        break;\n305\t      }\n306\t    }\n307\t    if (zeroLhs && aug[r][M] !== 0) return null;\n308\t  }\n309\t\n310\t  // ---- Particular solution (free variables = 0) ----\n311\t  const particular = new Array(M).fill(0);\n312\t  for (let i = 0; i < pivotCols.length; i++) {\n313\t    particular[pivotCols[i]] = aug[i][M];\n314\t  }\n315\t\n316\t  // ---- Null space basis ----\n317\t  const isPivot = new Set(pivotCols);\n318\t\n319\t  const nullBasis: number[][] = [];\n320\t  const freeCols: number[] = [];\n321\t  for (let c = 0; c < M; c++) {\n322\t    if (!isPivot.has(c)) freeCols.push(c);\n323\t  }\n324\t\n325\t  for (let fi = 0; fi < freeCols.length; fi++) {\n326\t    const fc = freeCols[fi];\n327\t    const v = new Array(M).fill(0);\n328\t    v[fc] = 1; // this free variable = 1\n329\t\n330\t    // For each pivot row, compute value of the pivot variable\n331\t    for (let ri = 0; ri < pivotCols.length; ri++) {\n332\t      const pc = pivotCols[ri];\n333\t      // Equation: x_pc + sum_{free} aug[ri][free] * y_free = aug[ri][M]\n334\t      // For y_fc = 1, others = 0: x_pc = -aug[ri][fc] (mod p)\n335\t      v[pc] = sub(0, aug[ri][fc], p);\n336\t    }\n337\t    nullBasis.push(v);\n338\t  }\n339\t\n340\t  return { particular, nullBasis, pivotCols };\n341\t}\n342\t\n343\t// ==========================================================================\n344\t// Enumeration of null space (small p^k)\n345\t// ==========================================================================\n346\t\n347\t/** Decide whether direct enumeration is feasible. */\n348\tfunction canEnumerate(p: number, k: number): boolean {\n349\t  if (k <= 3) return true; // always small enough\n350\t  // Compute p^k with early exit\n351\t  let total = 1;\n352\t  for (let i = 0; i < k; i++) {\n353\t    total *= p;\n354\t    if (total > 5_000_000) return false;\n355\t  }\n356\t  return true;\n357\t}\n358\t\n359\t/**\n360\t * Search the null-space coset particular + span(nullBasis) for the\n361\t * minimum-total-presses solution by enumerating all p^k assignments.\n362\t *\n363\t * Uses incremental updates of the solution vector.\n364\t */\n365\tfunction enumerateNullSpace(\n366\t  particular: number[],\n367\t  nullBasis: number[][],\n368\t  pivotCols: number[],\n369\t  p: number,\n370\t): number[] {\n371\t  const M = particular.length;\n372\t  const k = nullBasis.length;\n373\t\n374\t  // Precompute non-zero positions for each basis vector\n375\t  const nz: number[][] = nullBasis.map((bv) => {\n376\t    const pos: number[] = [];\n377\t    for (let i = 0; i < M; i++) {\n378\t      if (bv[i] !== 0) pos.push(i);\n379\t    }\n380\t    return pos;\n381\t  });\n382\t\n383\t  // Current free-variable coefficients (base-p counter)\n384\t  const idx = new Array(k).fill(0);\n385\t\n386\t  // Current solution vector and cost\n387\t  const sol = [...particular];\n388\t  let cost = costSum(sol);\n389\t\n390\t  let bestSol: number[] = [...sol];\n391\t  let bestCost = cost;\n392\t\n393\t  // Total number of combinations\n394\t  const total = Math.pow(p, k);\n395\t\n396\t  for (let iter = 0; iter < total; iter++) {\n397\t    // Evaluate current state\n398\t    if (cost < bestCost || (cost === bestCost && arrayLessThan(sol, bestSol))) {\n399\t      bestCost = cost;\n400\t      bestSol = [...sol];\n401\t    }\n402\t\n403\t    // Increment base-p counter (skip on the last iteration)\n404\t    if (iter === total - 1) break;\n405\t\n406\t    // Carry-propagate increment: increase the rightmost non-max position\n407\t    // by 1, reset all positions to its right to 0.\n408\t    for (let j = k - 1; j >= 0; j--) {\n409\t      if (idx[j] < p - 1) {\n410\t        // idx[j] goes from v to v+1  : add one copy of nullBasis[j]\n411\t        idx[j]++;\n412\t        const pos = nz[j];\n413\t        for (let t = 0; t < pos.length; t++) {\n414\t          const i = pos[t];\n415\t          const oldV = sol[i];\n416\t          sol[i] = add(sol[i], nullBasis[j][i], p);\n417\t          cost += sol[i] - oldV;\n418\t        }\n419\t        break;\n420\t      } else {\n421\t        // idx[j] goes from p-1 to 0  : remove (p-1) copies, add 1 copy\n422\t        // Because -(p-1) = 1 (mod p), the net change is adding one copy.\n423\t        idx[j] = 0;\n424\t        const pos = nz[j];\n425\t        for (let t = 0; t < pos.length; t++) {\n426\t          const i = pos[t];\n427\t          const oldV = sol[i];\n428\t          sol[i] = add(sol[i], nullBasis[j][i], p);\n429\t          cost += sol[i] - oldV;\n430\t        }\n431\t      }\n432\t    }\n433\t  }\n434\t\n435\t  return bestSol;\n436\t}\n437\t\n438\t// ==========================================================================\n439\t// Iterative descent for large null spaces\n440\t// ==========================================================================\n441\t\n442\t/**\n443\t * Search the null-space coset using coordinate descent.\n444\t *\n445\t * For each free variable (basis vector), try all p possible values and pick\n446\t * the one that minimises total cost (with lexicographic tie-break).\n447\t * Repeat until no improvement, then try additional random restarts.\n448\t */\n449\tfunction descentNullSpace(\n450\t  particular: number[],\n451\t  nullBasis: number[][],\n452\t  pivotCols: number[],\n453\t  p: number,\n454\t): number[] {\n455\t  const M = particular.length;\n456\t  const k = nullBasis.length;\n457\t\n458\t  // Precompute non-zero positions for each basis vector\n459\t  const nz: number[][] = nullBasis.map((bv) => {\n460\t    const pos: number[] = [];\n461\t    for (let i = 0; i < M; i++) {\n462\t      if (bv[i] !== 0) pos.push(i);\n463\t    }\n464\t    return pos;\n465\t  });\n466\t\n467\t  // Run descent with explicit coefficient tracking\n468\t  const coeffs = new Array(k).fill(0);\n469\t  const sol = [...particular];\n470\t\n471\t  // Descent from (0,0,...,0)\n472\t  localDescent(sol, coeffs, nullBasis, nz, p, k);\n473\t  let bestSol = [...sol];\n474\t  let bestCost = costSum(sol);\n475\t\n476\t  // Additional restarts from random starting points\n477\t  const restarts = Math.min(4, Math.max(1, Math.floor(20 / k)));\n478\t  for (let r = 0; r < restarts; r++) {\n479\t    const rCoeffs = new Array(k).fill(0);\n480\t    const rSol = [...particular];\n481\t\n482\t    // Randomise free variables\n483\t    for (let j = 0; j < k; j++) {\n484\t      const c = Math.floor(Math.random() * p);\n485\t      if (c === 0) continue;\n486\t      rCoeffs[j] = c;\n487\t      const pos = nz[j];\n488\t      for (let t = 0; t < pos.length; t++) {\n489\t        const i = pos[t];\n490\t        rSol[i] = add(rSol[i], mul(c, nullBasis[j][i], p), p);\n491\t      }\n492\t    }\n493\t\n494\t    localDescent(rSol, rCoeffs, nullBasis, nz, p, k);\n495\t\n496\t    const cst = costSum(rSol);\n497\t    if (cst < bestCost || (cst === bestCost && arrayLessThan(rSol, bestSol))) {\n498\t      bestCost = cst;\n499\t      bestSol = rSol;\n500\t    }\n501\t  }\n502\t\n503\t  return bestSol;\n504\t}\n505\t\n506\t/**\n507\t * Coordinate descent from a starting solution.\n508\t * Iterates over each basis vector, trying every multiple 0..p-1, and adopts\n509\t * the choice that minimises cost (with lexicographic tie-break).\n510\t * Repeats until a full pass yields no improvement.\n511\t */\n512\tfunction localDescent(\n513\t  sol: number[],\n514\t  coeffs: number[],\n515\t  nullBasis: number[][],\n516\t  nz: number[][],\n517\t  p: number,\n518\t  k: number,\n519\t): void {\n520\t  let cost = costSum(sol);\n521\t  let improved = true;\n522\t\n523\t  while (improved) {\n524\t    improved = false;\n525\t    for (let j = 0; j < k; j++) {\n526\t      const curr = coeffs[j];\n527\t      const bv = nullBasis[j];\n528\t      const pos = nz[j];\n529\t\n530\t      let bestM = curr;\n531\t      let bestCost = cost;\n532\t      let bestCand: number[] | undefined;\n533\t\n534\t      for (let m = 0; m < p; m++) {\n535\t        if (m === curr) continue;\n536\t        const delta = sub(m, curr, p);\n537\t\n538\t        const cand = [...sol];\n539\t        let candCost = cost;\n540\t        for (let t = 0; t < pos.length; t++) {\n541\t          const i = pos[t];\n542\t          const oldV = cand[i];\n543\t          cand[i] = add(cand[i], mul(delta, bv[i], p), p);\n544\t          candCost += cand[i] - oldV;\n545\t        }\n546\t\n547\t        if (\n548\t          candCost < bestCost ||\n549\t          (candCost === bestCost &&\n550\t            (bestCand === undefined || arrayLessThan(cand, bestCand)))\n551\t        ) {\n552\t          bestCost = candCost;\n553\t          bestCand = cand;\n554\t          bestM = m;\n555\t        }\n556\t      }\n557\t\n558\t      if (bestM !== curr) {\n559\t        coeffs[j] = bestM;\n560\t        sol.splice(0, sol.length, ...bestCand!);\n561\t        cost = bestCost;\n562\t        improved = true;\n563\t      }\n564\t    }\n565\t  }\n566\t}\n567\t\n568\t// ==========================================================================\n569\t// Finite-field helpers (GF(p), p prime, p <= 97)\n570\t// ==========================================================================\n571\t\n572\tfunction mod(a: number, p: number): number {\n573\t  const r = a % p;\n574\t  return r < 0 ? r + p : r;\n575\t}\n576\t\n577\tfunction add(a: number, b: number, p: number): number {\n578\t  const r = a + b;\n579\t  return r >= p ? r - p : r;\n580\t}\n581\t\n582\tfunction sub(a: number, b: number, p: number): number {\n583\t  const r = a - b;\n584\t  return r < 0 ? r + p : r;\n585\t}\n586\t\n587\tfunction mul(a: number, b: number, p: number): number {\n588\t  return (a * b) % p;\n589\t}\n590\t\n591\tfunction modInv(a: number, p: number): number {\n592\t  // Fermat: a^(p-2) mod p  (p is prime)\n593\t  let res = 1;\n594\t  let base = a % p;\n595\t  let exp = p - 2;\n596\t  while (exp > 0) {\n597\t    if (exp & 1) res = (res * base) % p;\n598\t    base = (base * base) % p;\n599\t    exp >>= 1;\n600\t  }\n601\t  return res;\n602\t}\n603\t\n604\t// ---- array helpers --------------------------------------------------------\n605\t\n606\t/** True if array `a` is lexicographically smaller than `b` (same length). */\n607\tfunction arrayLessThan(a: number[], b: number[]): boolean {\n608\t  for (let i = 0; i < a.length; i++) {\n609\t    if (a[i] !== b[i]) return a[i] < b[i];\n610\t  }\n611\t  return false;\n612\t}\n613\t\n614\tfunction costSum(arr: number[]): number {\n615\t  let s = 0;\n616\t  for (let i = 0; i < arr.length; i++) s += arr[i];\n617\t  return s;\n618\t}\n619\t"}]},"parent_tool_use_id":null,"session_id":"9d6633c0-814e-447a-972a-967055be4a9d","uuid":"ecf2399d-87b9-455b-910b-fc00de96c326","timestamp":"2026-05-30T23:24:24.943Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/index.ts","content":"// ============================================================================\n// Factory Reset – Toggle Puzzle (Part 1) & Counter Puzzle (Part 2)\n// ============================================================================\n\n// ---------------------------------------------------------------------------\n// Part 1 — Toggle Puzzle (GF(2))\n// ---------------------------------------------------------------------------\n\nexport interface Machine {\n  target: boolean[];\n  buttons: number[][];\n}\n\n/**\n * Solve the toggle puzzle.\n *\n * Each button toggles a specific set of lights.  Each button may be pressed at\n * most once.  Find the minimum-weight (fewest presses) solution with\n * lexicographically smallest tie-break, or null if none exists.\n *\n * Uses meet-in-the-middle on the button set when M > 22, direct enumeration\n * otherwise.\n */\nexport function solveToggle(machine: Machine): number[] | null {\n  const { target, buttons } = machine;\n  const N = target.length;\n  const M = buttons.length;\n\n  if (N === 0) return [];\n  if (M === 0) return target.every((v) => !v) ? [] : null;\n\n  // Precompute button masks (bits = light indices they affect)\n  const btnMasks: bigint[] = buttons.map((btn) => {\n    let m = 0n;\n    for (const idx of btn) m |= 1n << BigInt(idx);\n    return m;\n  });\n\n  // Target mask\n  let tgt = 0n;\n  for (let i = 0; i < N; i++) {\n    if (target[i]) tgt |= 1n << BigInt(i);\n  }\n\n  if (M <= 22) {\n    return solveToggleBrute(btnMasks, tgt, M);\n  }\n  return solveToggleMitm(btnMasks, tgt, M);\n}\n\n// ---- helpers shared by both toggle strategies ------------------------------\n\n/** Compare two button-set bitmasks lexicographically by index list.\n *  Returns negative if a < b, 0 if equal, positive if a > b. */\nfunction cmpBitmask(a: bigint, b: bigint, len: number): number {\n  for (let i = 0; i < len; i++) {\n    const ba = (a >> BigInt(i)) & 1n;\n    const bb = (b >> BigInt(i)) & 1n;\n    if (ba !== bb) return ba === 1n ? -1 : 1;\n  }\n  return 0;\n}\n\nfunction bitmaskToArray(m: bigint, len: number): number[] {\n  const out: number[] = [];\n  for (let i = 0; i < len; i++) {\n    if ((m >> BigInt(i)) & 1n) out.push(i);\n  }\n  return out;\n}\n\n// ---- direct brute-force (M <= 22) -------------------------------------------\n\nfunction solveToggleBrute(\n  btnMasks: bigint[],\n  tgt: bigint,\n  M: number,\n): number[] | null {\n  let bestMask: bigint | null = null;\n  let bestWt = Infinity;\n  const total = 1 << M;\n\n  for (let combo = 0; combo < total; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < M; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[i];\n        bm |= 1n << BigInt(i);\n        wt++;\n      }\n    }\n    if (pat === tgt) {\n      if (wt < bestWt || (wt === bestWt && cmpBitmask(bm, bestMask!, M) < 0)) {\n        bestWt = wt;\n        bestMask = bm;\n      }\n    }\n  }\n  return bestMask === null ? null : bitmaskToArray(bestMask, M);\n}\n\n// ---- meet-in-the-middle (M up to 40) ---------------------------------------\n\nfunction solveToggleMitm(\n  btnMasks: bigint[],\n  tgt: bigint,\n  M: number,\n): number[] | null {\n  const mid = Math.floor(M / 2);\n  const rightCnt = M - mid;\n\n  // Build left map: toggle-pattern -> best (buttonMask, weight)\n  const leftMap = new Map<bigint, { bm: bigint; wt: number }>();\n  const leftTotal = 1 << mid;\n\n  for (let combo = 0; combo < leftTotal; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < mid; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[i];\n        bm |= 1n << BigInt(i);\n        wt++;\n      }\n    }\n    const prev = leftMap.get(pat);\n    if (\n      prev === undefined ||\n      wt < prev.wt ||\n      (wt === prev.wt && cmpBitmask(bm, prev.bm, mid) < 0)\n    ) {\n      leftMap.set(pat, { bm, wt });\n    }\n  }\n\n  // Enumerate right half and pair with left\n  const rightTotal = 1 << rightCnt;\n  let bestMask: bigint | null = null;\n  let bestWt = Infinity;\n\n  for (let combo = 0; combo < rightTotal; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < rightCnt; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[mid + i];\n        bm |= 1n << BigInt(mid + i);\n        wt++;\n      }\n    }\n\n    const need = tgt ^ pat;\n    const left = leftMap.get(need);\n    if (left === undefined) continue;\n\n    const totalWt = left.wt + wt;\n    const merged = left.bm | bm;\n\n    if (\n      totalWt < bestWt ||\n      (totalWt === bestWt && cmpBitmask(merged, bestMask!, M) < 0)\n    ) {\n      bestWt = totalWt;\n      bestMask = merged;\n    }\n  }\n\n  return bestMask === null ? null : bitmaskToArray(bestMask, M);\n}\n\n// ---------------------------------------------------------------------------\n// Part 2 — Counter Puzzle  (GF(p), p prime)\n// ---------------------------------------------------------------------------\n\n/**\n * Solve the counter puzzle.\n *\n * Each button increments a specific set of counters by 1 (wrapping at modulus\n * p).  Each button may be pressed 0 .. p-1 times.  Return an array result[i] =\n * presses of button i, minimising total presses (sum), with lexicographically\n * smallest tie-break, or null if no solution.\n */\nexport function solveCounter(\n  lights: number[],\n  buttons: number[][],\n  modulus: number,\n): number[] | null {\n  const N = lights.length; // counters\n  const M = buttons.length; // buttons\n  const p = modulus;\n\n  if (N === 0) return new Array(M).fill(0);\n  if (M === 0) {\n    return lights.every((v) => v === 0) ? [] : null;\n  }\n\n  // ---------- Build matrix ----------\n  // A[c][i] = 1 if button i affects counter c, else 0\n  const A: number[][] = Array.from({ length: N }, () => new Array(M).fill(0));\n  for (let i = 0; i < M; i++) {\n    for (const c of buttons[i]) {\n      A[c][i] = 1;\n    }\n  }\n\n  // ---------- Gaussian elimination over GF(p) ----------\n  const elim = gaussElimination(A, lights, p);\n  if (elim === null) return null; // inconsistent\n\n  const { particular, nullBasis, pivotCols } = elim;\n  const k = nullBasis.length;\n\n  if (k === 0) {\n    // Unique solution - no free variables\n    return particular;\n  }\n\n  // ---------- Search for minimum-cost solution ----------\n  // Decide strategy based on p^k enumeration cost\n  if (canEnumerate(p, k)) {\n    return enumerateNullSpace(particular, nullBasis, pivotCols, p);\n  }\n  return descentNullSpace(particular, nullBasis, pivotCols, p);\n}\n\n// ==========================================================================\n// Gaussian elimination over GF(p)\n// ==========================================================================\n\ninterface ElimResult {\n  particular: number[];\n  nullBasis: number[][];\n  pivotCols: number[];\n}\n\n/**\n * Perform Gauss-Jordan elimination on the NxM matrix A over GF(p) with RHS