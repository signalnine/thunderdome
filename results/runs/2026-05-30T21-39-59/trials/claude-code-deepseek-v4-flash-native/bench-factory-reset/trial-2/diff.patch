ree variable (basis vector), try all p possible values and pick\n * the one that minimises total cost (with lexicographic tie-break).\n * Repeat until no improvement, then try additional random restarts.\n */\nfunction descentNullSpace(\n  particular: number[],\n  nullBasis: number[][],\n  pivotCols: number[],\n  p: number,\n): number[] {\n  const M = particular.length;\n  const k = nullBasis.length;\n\n  // Precompute non-zero positions for each basis vector\n  const nz: number[][] = nullBasis.map((bv) => {\n    const pos: number[] = [];\n    for (let i = 0; i < M; i++) {\n      if (bv[i] !== 0) pos.push(i);\n    }\n    return pos;\n  });\n\n  // Run descent with explicit coefficient tracking\n  const coeffs = new Array(k).fill(0);\n  const sol = [...particular];\n\n  // Descent from (0,0,...,0)\n  localDescent(sol, coeffs, nullBasis, nz, p, k);\n  let bestSol = [...sol];\n  let bestCost = costSum(sol);\n\n  // Additional restarts from random starting points\n  const restarts = Math.min(4, Math.max(1, Math.floor(20 / k)));\n  for (let r = 0; r < restarts; r++) {\n    const rCoeffs = new Array(k).fill(0);\n    const rSol = [...particular];\n\n    // Randomise free variables\n    for (let j = 0; j < k; j++) {\n      const c = Math.floor(Math.random() * p);\n      if (c === 0) continue;\n      rCoeffs[j] = c;\n      const pos = nz[j];\n      for (let t = 0; t < pos.length; t++) {\n        const i = pos[t];\n        rSol[i] = add(rSol[i], mul(c, nullBasis[j][i], p), p);\n      }\n    }\n\n    localDescent(rSol, rCoeffs, nullBasis, nz, p, k);\n\n    const cst = costSum(rSol);\n    if (cst < bestCost || (cst === bestCost && arrayLessThan(rSol, bestSol))) {\n      bestCost = cst;\n      bestSol = rSol;\n    }\n  }\n\n  return bestSol;\n}\n\n/**\n * Coordinate descent from a starting solution.\n * Iterates over each basis vector, trying every multiple 0..p-1, and adopts\n * the choice that minimises cost (with lexicographic tie-break).\n * Repeats until a full pass yields no improvement.\n */\nfunction localDescent(\n  sol: number[],\n  coeffs: number[],\n  nullBasis: number[][],\n  nz: number[][],\n  p: number,\n  k: number,\n): void {\n  let cost = costSum(sol);\n  let improved = true;\n\n  while (improved) {\n    improved = false;\n    for (let j = 0; j < k; j++) {\n      const curr = coeffs[j];\n      const bv = nullBasis[j];\n      const pos = nz[j];\n\n      let bestM = curr;\n      let bestCost = cost;\n      let bestCand: number[] | undefined;\n\n      for (let m = 0; m < p; m++) {\n        if (m === curr) continue;\n        const delta = sub(m, curr, p);\n\n        const cand = [...sol];\n        let candCost = cost;\n        for (let t = 0; t < pos.length; t++) {\n          const i = pos[t];\n          const oldV = cand[i];\n          cand[i] = add(cand[i], mul(delta, bv[i], p), p);\n          candCost += cand[i] - oldV;\n        }\n\n        if (\n          candCost < bestCost ||\n          (candCost === bestCost &&\n            (bestCand === undefined || arrayLessThan(cand, bestCand)))\n        ) {\n          bestCost = candCost;\n          bestCand = cand;\n          bestM = m;\n        }\n      }\n\n      if (bestM !== curr) {\n        coeffs[j] = bestM;\n        sol.splice(0, sol.length, ...bestCand!);\n        cost = bestCost;\n        improved = true;\n      }\n    }\n  }\n}\n\n// ==========================================================================\n// Finite-field helpers (GF(p), p prime, p <= 97)\n// ==========================================================================\n\nfunction mod(a: number, p: number): number {\n  const r = a % p;\n  return r < 0 ? r + p : r;\n}\n\nfunction add(a: number, b: number, p: number): number {\n  const r = a + b;\n  return r >= p ? r - p : r;\n}\n\nfunction sub(a: number, b: number, p: number): number {\n  const r = a - b;\n  return r < 0 ? r + p : r;\n}\n\nfunction mul(a: number, b: number, p: number): number {\n  return (a * b) % p;\n}\n\nfunction modInv(a: number, p: nu