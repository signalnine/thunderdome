+// Toggle Puzzle tests
+// ==========================================================================
+
+describe('solveToggle', () => {
+  it('should return [] for no lights with no buttons', () => {
+    expect(solveToggle({ target: [], buttons: [] })).toEqual([]);
+  });
+
+  it('should return [] when target is all false and no buttons', () => {
+    expect(solveToggle({ target: [false], buttons: [] })).toEqual([]);
+  });
+
+  it('should return null when no solution exists', () => {
+    // From the TASK.md example – no solution exists
+    const result = solveToggle({
+      target: [true, true, false, true],
+      buttons: [
+        [0, 1],
+        [1, 2, 3],
+        [0, 3],
+      ],
+    });
+    expect(result).toBeNull();
+  });
+
+  it('should solve a single light toggled by one button', () => {
+    const result = solveToggle({
+      target: [true],
+      buttons: [[0]],
+    });
+    expect(result).toEqual([0]);
+  });
+
+  it('should solve a single light with multiple buttons', () => {
+    // Light 0 toggled by buttons 0,1,2 – need odd number of presses
+    const result = solveToggle({
+      target: [true],
+      buttons: [[0], [0], [0]],
+    });
+    // Best: just press one button: all have weight 1, pick lexicographically smallest = [0]
+    expect(result).toEqual([0]);
+  });
+
+  it('should prefer fewer presses', () => {
+    // Two buttons, both toggle the same single light
+    // Pressing one button turns it on (1 press), pressing both turns it off (2 presses)
+    const result = solveToggle({
+      target: [true],
+      buttons: [[0], [0]],
+    });
+    expect(result).toEqual([0]); // [0] and [1] both work; [0] is lexicographically smaller
+  });
+
+  it('should handle multiple lights with overlap', () => {
+    // 3 lights, 2 buttons
