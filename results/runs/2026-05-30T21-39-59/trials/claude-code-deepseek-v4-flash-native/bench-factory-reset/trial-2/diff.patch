(combo & (1 << i)) {\n        pattern ^= masks[i];\n        buttonSet |= (1n << BigInt(i));\n        weight++;\n      }\n    }\n    \n    if (pattern === target) {\n      if (weight < bestWeight || (weight === bestWeight && compareBitmasks(buttonSet, bestMask!, M) < 0)) {\n        bestWeight = weight;\n        bestMask = buttonSet;\n      }\n    }\n  }\n  \n  return bestMask === null ? null : bitmaskToArray(bestMask, M);\n}\n\nfunction solveToggleMITM(\n  masks: bigint[],\n  target: bigint,\n  M: number\n): number[] | null {\n  const mid = Math.floor(M / 2);\n  \n  // Left half: buttons 0..mid-1, Right half: buttons mid..M-1\n  \n  // Enumerate left half and build map: pattern → best button mask\n  const leftMap = new Map<bigint, { mask: bigint; weight: number }>();\n  const leftCount = 1 << mid;\n  \n  // Use Gray code or just iterate\n  for (let combo = 0; combo < leftCount; combo++) {\n    let pattern = 0n;\n    let buttonSet = 0n;\n    let weight = 0;\n    \n    for (let i = 0; i < mid; i++) {\n      if (combo & (1 << i)) {\n        pattern ^= masks[i];\n        buttonSet |= (1n << BigInt(i));\n        weight++;\n      }\n    }\n    \n    const existing = leftMap.get(pattern);\n    if (!existing || weight < existing.weight || \n        (weight === existing.weight && compareBitmasks(buttonSet, existing.mask, mid) < 0)) {\n      leftMap.set(pattern, { mask: buttonSet, weight });\n    }\n  }\n  \n  // Enumerate right half and find best match\n  const rightCount = 1 << (M - mid);\n  let bestMask = null as bigint | null;\n  let bestWeight = Infinity;\n  \n  for (let combo = 0; combo < rightCount; combo++) {\n    let pattern = 0n;\n    let buttonSet = 0n;\n    let weight = 0;\n    \n    for (let i = 0; i < M - mid; i++) {\n      if (combo & (1 << i)) {\n        pattern ^= masks[mid + i];\n        buttonSet |= (1n << BigInt(mid + i));\n        weight++;\n      }\n    }\n    \n    // Find matching left result\n    const neededPattern = target ^ pattern;\n    const leftR