ew Set(pivotCols);\n\n  const nullBasis: number[][] = [];\n  const freeCols: number[] = [];\n  for (let c = 0; c < M; c++) {\n    if (!isPivot.has(c)) freeCols.push(c);\n  }\n\n  for (let fi = 0; fi < freeCols.length; fi++) {\n    const fc = freeCols[fi];\n    const v = new Array(M).fill(0);\n    v[fc] = 1; // this free variable = 1\n\n    // For each pivot row, compute value of the pivot variable\n    for (let ri = 0; ri < pivotCols.length; ri++) {\n      const pc = pivotCols[ri];\n      // Equation: x_pc + sum_{free} aug[ri][free] * y_free = aug[ri][M]\n      // For y_fc = 1, others = 0: x_pc = -aug[ri][fc] (mod p)\n      v[pc] = sub(0, aug[ri][fc], p);\n    }\n    nullBasis.push(v);\n  }\n\n  return { particular, nullBasis, pivotCols };\n}\n\n// ==========================================================================\n// Enumeration of null space (small p^k)\n// ==========================================================================\n\n/** Decide whether direct enumeration is feasible. */\nfunction canEnumerate(p: number, k: number): boolean {\n  if (k <= 3) return true; // always small enough\n  // Compute p^k with early exit\n  let total = 1;\n  for (let i = 0; i < k; i++) {\n    total *= p;\n    if (total > 5_000_000) return false;\n  }\n  return true;\n}\n\n/**\n * Search the null-space coset particular + span(nullBasis) for the\n * minimum-total-presses solution by enumerating all p^k assignments.\n *\n * Uses incremental updates of the solution vector.\n */\nfunction enumerateNullSpace(\n  particular: number[],\n  nullBasis: number[][],\n  pivotCols: number[],\n  p: number,\n): number[] {\n  const M = particular.length;\n  const k = nullBasis.length;\n\n  // Precompute non-zero positions for each basis vector\n  const nz: number[][] = nullBasis.map((bv) => {\n    const pos: number[] = [];\n    for (let i = 0; i < M; i++) {\n      if (bv[i] !== 0) pos.push(i);\n    }\n    return pos;\n  });\n\n  // Current free-variable coefficients (base-p counter)\n  