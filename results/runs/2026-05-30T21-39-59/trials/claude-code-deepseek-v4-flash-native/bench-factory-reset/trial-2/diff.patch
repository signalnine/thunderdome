+    const result = solveToggle({ target, buttons });
+    expect(result).not.toBeNull();
+    // Verify the solution works
+    if (result) {
+      const check = new Array(N).fill(false);
+      for (const pi of result) {
+        for (const l of buttons[pi]) {
+          check[l] = !check[l];
+        }
+      }
+      expect(check).toEqual(target);
+    }
+  });
+});
+
+// ==========================================================================
+// Counter Puzzle tests
+// ==========================================================================
