are two button-set bitmasks lexicographically by index list.\n54\t *  Returns negative if a < b, 0 if equal, positive if a > b. */\n55\tfunction cmpBitmask(a: bigint, b: bigint, len: number): number {\n56\t  for (let i = 0; i < len; i++) {\n57\t    const ba = (a >> BigInt(i)) & 1n;\n58\t    const bb = (b >> BigInt(i)) & 1n;\n59\t    if (ba !== bb) return ba === 1n ? -1 : 1;\n60\t  }\n61\t  return 0;\n62\t}\n63\t\n64\tfunction bitmaskToArray(m: bigint, len: number): number[] {\n65\t  const out: number[] = [];\n66\t  for (let i = 0; i < len; i++) {\n67\t    if ((m >> BigInt(i)) & 1n) out.push(i);\n68\t  }\n69\t  return out;\n70\t}\n71\t\n72\t// ---- direct brute-force (M <= 22) -------------------------------------------\n73\t\n74\tfunction solveToggleBrute(\n75\t  btnMasks: bigint[],\n76\t  tgt: bigint,\n77\t  M: number,\n78\t): number[] | null {\n79\t  let bestMask: bigint | null = null;\n80\t  let bestWt = Infinity;\n81\t  const total = 1 << M;\n82\t\n83\t  for (let combo = 0; combo < total; combo++) {\n84\t    let pat = 0n;\n85\t    let bm = 0n;\n86\t    let wt = 0;\n87\t    for (let i = 0; i < M; i++) {\n88\t      if (combo & (1 << i)) {\n89\t        pat ^= btnMasks[i];\n90\t        bm |= 1n << BigInt(i);\n91\t        wt++;\n92\t      }\n93\t    }\n94\t    if (pat === tgt) {\n95\t      if (wt < bestWt || (wt === bestWt && cmpBitmask(bm, bestMask!, M) < 0)) {\n96\t        bestWt = wt;\n97\t        bestMask = bm;\n98\t      }\n99\t    }\n100\t  }\n101\t  return bestMask === null ? null : bitmaskToArray(bestMask, M);\n102\t}\n103\t\n104\t// ---- meet-in-the-middle (M up to 40) ---------------------------------------\n105\t\n106\tfunction solveToggleMitm(\n107\t  btnMasks: bigint[],\n108\t  tgt: bigint,\n109\t  M: number,\n110\t): number[] | null {\n111\t  const mid = Math.floor(M / 2);\n112\t  const rightCnt = M - mid;\n113\t\n114\t  // Build left map: toggle-pattern -> best (buttonMask, weight)\n115\t  const leftMap = new Map<bigint, { bm: bigint; wt: number }>();\