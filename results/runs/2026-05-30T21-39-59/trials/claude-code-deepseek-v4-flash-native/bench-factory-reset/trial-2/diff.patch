\n\n// ---------------------------------------------------------------------------\n// Part 1 — Toggle Puzzle (GF(2))\n// ---------------------------------------------------------------------------\n\nexport interface Machine {\n  target: boolean[];\n  buttons: number[][];\n}\n\n/**\n * Solve the toggle puzzle.\n *\n * Each button toggles a specific set of lights.  Each button may be pressed at\n * most once.  Find the minimum-weight (fewest presses) solution with\n * lexicographically smallest tie-break, or null if none exists.\n *\n * Uses meet-in-the-middle on the button set when M > 22, direct enumeration\n * otherwise.\n */\nexport function solveToggle(machine: Machine): number[] | null {\n  const { target, buttons } = machine;\n  const N = target.length;\n  const M = buttons.length;\n\n  if (N === 0) return [];\n  if (M === 0) return target.every((v) => !v) ? [] : null;\n\n  // Precompute button masks (bits = light indices they affect)\n  const btnMasks: bigint[] = buttons.map((btn) => {\n    let m = 0n;\n    for (const idx of btn) m |= 1n << BigInt(idx);\n    return m;\n  });\n\n  // Target mask\n  let tgt = 0n;\n  for (let i = 0; i < N; i++) {\n    if (target[i]) tgt |= 1n << BigInt(i);\n  }\n\n  if (M <= 22) {\n    return solveToggleBrute(btnMasks, tgt, M);\n  }\n  return solveToggleMitm(btnMasks, tgt, M);\n}\n\n// ---- helpers shared by both toggle strategies ------------------------------\n\n/** Compare two button-set bitmasks lexicographically by index list.\n *  Returns negative if a < b, 0 if equal, positive if a > b. */\nfunction cmpBitmask(a: bigint, b: bigint, len: number): number {\n  for (let i = 0; i < len; i++) {\n    const ba = (a >> BigInt(i)) & 1n;\n    const bb = (b >> BigInt(i)) & 1n;\n    if (ba !== bb) return ba === 1n ? -1 : 1;\n  }\n  return 0;\n}\n\nfunction bitmaskToArray(m: bigint, len: number): number[] {\n  const out: number[] = [];\n  for (let i = 0; i < len; i++) {\n    if ((m >> BigInt(i)) & 1n) out.push(i);\n  }\n  return out;\n}\n\n// ---- direct brute-force (M <= 22) -------------------------------------------\n\nfunction solveToggleBrute(\n  btnMasks: bigint[],\n  tgt: bigint,\n  M: number,\n): number[] | null {\n  let bestMask: bigint | null = null;\n  let bestWt = Infinity;\n  const total = 1 << M;\n\n  for (let combo = 0; combo < total; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < M; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[i];\n        bm |= 1n << BigInt(i);\n        wt++;\n      }\n    }\n    if (pat === tgt) {\n      if (wt < bestWt || (wt === bestWt && cmpBitmask(bm, bestMask!, M) < 0)) {\n        bestWt = wt;\n        bestMask = bm;\n      }\n    }\n  }\n  return bestMask === null ? null : bitmaskToArray(bestMask, M);\n}\n\n// ---- meet-in-the-middle (M up to 40) ---------------------------------------\n\nfunction solveToggleMitm(\n  btnMasks: bigint[],\n  tgt: bigint,\n  M: number,\n): number[] | null {\n  const mid = Math.floor(M / 2);\n  const rightCnt = M - mid;\n\n  // Build left map: toggle-pattern -> best (buttonMask, weight)\n  const leftMap = new Map<bigint, { bm: bigint; wt: number }>();\n  const leftTotal = 1 << mid;\n\n  for (let combo = 0; combo < leftTotal; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < mid; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[i];\n        bm |= 1n << BigInt(i);\n        wt++;\n      }\n    }\n    const prev = leftMap.get(pat);\n    if (\n      prev === undefined ||\n      wt < prev.wt ||\n      (wt === prev.wt && cmpBitmask(bm, prev.bm, mid) < 0)\n    ) {\n      leftMap.set(pat, { bm, wt });\n    }\n  }\n\n  // Enumerate right half and pair with left\n  const rightTotal = 1 << rightCnt;\n  let bestMask: bigint | null = null;\n  let bestWt = Infinity;\n\n  for (let combo = 0; combo < rightTotal; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < rightCnt; i++) {\n      if (c