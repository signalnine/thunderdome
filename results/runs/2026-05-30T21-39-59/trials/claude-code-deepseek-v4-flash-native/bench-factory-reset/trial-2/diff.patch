s.length;\n\n  if (N === 0) return [];\n  if (M === 0) return target.every((v) => !v) ? [] : null;\n\n  // Precompute button masks (bits = light indices they affect)\n  const btnMasks: bigint[] = buttons.map((btn) => {\n    let m = 0n;\n    for (const idx of btn) m |= 1n << BigInt(idx);\n    return m;\n  });\n\n  // Target mask\n  let tgt = 0n;\n  for (let i = 0; i < N; i++) {\n    if (target[i]) tgt |= 1n << BigInt(i);\n  }\n\n  if (M <= 22) {\n    return solveToggleBrute(btnMasks, tgt, M);\n  }\n  return solveToggleMitm(btnMasks, tgt, M);\n}\n\n// ---- helpers shared by both toggle strategies ------------------------------\n\n/** Compare two button-set bitmasks lexicographically by index list.\n *  Returns negative if a < b, 0 if equal, positive if a > b. */\nfunction cmpBitmask(a: bigint, b: bigint, len: number): number {\n  for (let i = 0; i < len; i++) {\n    const ba = (a >> BigInt(i)) & 1n;\n    const bb = (b >> BigInt(i)) & 1n;\n    if (ba !== bb) return ba === 1n ? -1 : 1;\n  }\n  return 0;\n}\n\nfunction bitmaskToArray(m: bigint, len: number): number[] {\n  const out: number[] = [];\n  for (let i = 0; i < len; i++) {\n    if ((m >> BigInt(i)) & 1n) out.push(i);\n  }\n  return out;\n}\n\n// ---- direct brute-force (M <= 22) -------------------------------------------\n\nfunction solveToggleBrute(\n  btnMasks: bigint[],\n  tgt: bigint,\n  M: number,\n): number[] | null {\n  let bestMask: bigint | null = null;\n  let bestWt = Infinity;\n  const total = 1 << M;\n\n  for (let combo = 0; combo < total; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < M; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[i];\n        bm |= 1n << BigInt(i);\n        wt++;\n      }\n    }\n    if (pat === tgt) {\n      if (wt < bestWt || (wt === bestWt && cmpBitmask(bm, bestMask!, M) < 0)) {\n        bestWt = wt;\n        bestMask = bm;\n      }\n    }\n  }\n  return bestMask === null ? null : bitmaskToArray(bestMask, M);\n}\n\n// ---- meet-in-the-middle (M up to 40) ---------------------------------------\n\nfunction solveToggleMitm(\n  btnMasks: bigint[],\n  tgt: bigint,\n  M: number,\n): number[] | null {\n  const mid = Math.floor(M / 2);\n  const rightCnt = M - mid;\n\n  // Build left map: toggle-pattern -> best (buttonMask, weight)\n  const leftMap = new Map<bigint, { bm: bigint; wt: number }>();\n  const leftTotal = 1 << mid;\n\n  for (let combo = 0; combo < leftTotal; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < mid; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[i];\n        bm |= 1n << BigInt(i);\n        wt++;\n      }\n    }\n    const prev = leftMap.get(pat);\n    if (\n      prev === undefined ||\n      wt < prev.wt ||\n      (wt === prev.wt && cmpBitmask(bm, prev.bm, mid) < 0)\n    ) {\n      leftMap.set(pat, { bm, wt });\n    }\n  }\n\n  // Enumerate right half and pair with left\n  const rightTotal = 1 << rightCnt;\n  let bestMask: bigint | null = null;\n  let bestWt = Infinity;\n\n  for (let combo = 0; combo < rightTotal; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < rightCnt; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[mid + i];\n        bm |= 1n << BigInt(mid + i);\n        wt++;\n      }\n    }\n\n    const need = tgt ^ pat;\n    const left = leftMap.get(need);\n    if (left === undefined) continue;\n\n    const totalWt = left.wt + wt;\n    const merged = left.bm | bm;\n\n    if (\n      totalWt < bestWt ||\n      (totalWt === bestWt && cmpBitmask(merged, bestMask!, M) < 0)\n    ) {\n      bestWt = totalWt;\n      bestMask = merged;\n    }\n  }\n\n  return bestMask === null ? null : bitmaskToArray(bestMask, M);\n}\n\n// ---------------------------------------------------------------------------\n// Part 2 — Counter Puzzle  (GF(p), p prime)\n// ---------------------------------------------------------------------------\n\n/**\n * Solve the counter puzzle.\n *\n * Each button increments a specific set of counters by 1 (wrapping at modulus\n * p).  Each button may be pressed 0 .. p-1 times.  Return an array result[i] =\n * presses of button i, minimising total presses (sum), with lexicographically\n * smallest tie-break, or null if no solution.\n */\nexport function solveCounter(\n  lights: number[],\n  buttons: number[][],\n  modulus: number,\n): number[] | null {\n  const N = lights.length; // counters\n  const M = buttons.length; // buttons\n  const p = modulus;\n\n  if (N === 0) return new Array(M).fill(0);\n  if (M === 0) {\n    return lights.every((v) => v === 0) ? [] : null;\n  }\n\n  // ---------- Build matrix ----------\n  // A[c][i] = 1 if button i affects counter c, else 0\n  const A: number[][] = Array.from({ length: N }, () => new Array(M).fill(0));\n  for (let i = 0; i < M; i++) {\n    for (const c of buttons[i]) {\n      A[c][i] = 1;\n    }\n  }\n\n  // ---------- Gaussian elimination over GF(p) ----------\n  const elim = gaussElimination(A, lights, p);\n  if (elim === null) return null; // inconsistent\n\n  const { particular, nullBasis, pivotCols } = elim;\n  const k = nullBasis.length;\n\n  if (k === 0) {\n    // Unique solution - no free variables\n    return particular;\n  }\n\n  // ---------- Search for minimum-cost solution ----------\n  // Decide strategy based on p^k enumeration cost\n  if (canEnumerate(p, k)) {\n    return enumerateNullSpace(particular, nullBasis, pivotCols, p);\n  }\n  return descentNullSpace(particular, nullBasis, pivotCols, p);\n}\n\n// ==========================================================================\n// Gaussian elimination over GF(p)\n// ==========================================================================\n\ninterface ElimResult {\n  particular: number[];\n  nullBasis: number[][];\n  pivotCols: number[];\n}\n\n/**\n * Perform Gauss-Jordan elimination on the NxM matrix A over GF(p) with RHS b.\n * Returns the particular solution (free vars = 0), null space basis vectors,\n * and pivot column indices, or null if the system is inconsistent.\n */\nfunction gaussElimination(\n  A: number[][],\n  b: number[],\n  p: number,\n): ElimResult | null {\n  const N = A.length;\n  const M = A[0].length;\n\n  // Augmented matrix\n  const aug: number[][] = Array.from({ length: N }, (_, r) => {\n    const row = new Array(M + 1);\n    for (let c = 0; c < M; c++) row[c] = mod(A[r][c], p);\n    row[M] = mod(b[r], p);\n    return row;\n  });\n\n  const pivotCols: number[] = [];\n  let row = 0;\n\n  for (let col = 0; col < M && row < N; col++) {\n    // Find pivot (non-zero entry in this column at or below 'row')\n    let pivotRow = -1;\n    for (let r = row; r < N; r++) {\n      if (aug[r][col] !== 0) {\n        pivotRow = r;\n        break;\n      }\n    }\n    if (pivotRow === -1) continue;\n\n    // Swap pivot row to current position\n    [aug[row], aug[pivotRow]] = [aug[pivotRow], aug[row]];\n\n    // Normalise pivot row (make pivot == 1)\n    const inv = modInv(aug[row][col], p);\n    for (let c = col; c <= M; c++) {\n      aug[row][c] = mul(aug[row][c], inv, p);\n    }\n\n    // Eliminate this column from ALL other rows (Gauss-Jordan)\n    for (let r = 0; r < N; r++) {\n      if (r !== row && aug[r][col] !== 0) {\n        const factor = aug[r][col];\n        for (let c = col; c <= M; c++) {\n          aug[r][c] = sub(aug[r][c], mul(factor, aug[row][c], p), p);\n        }\n      }\n    }\n\n    pivotCols.push(col);\n    row++;\n  }\n\n  // Inconsistency check: any row with all-zero LHS but non-zero RHS?\n  for (let r = row; r < N; r++) {\n    let zeroLhs = true;\n    for (let c = 0; c < M; c++) {\n      if (aug[r][c] !== 0) {\n        zeroLhs = false;\n        break;\n      }\n    }\n    if (zeroLhs && aug[r][M] !== 0) return null;\n  }\n\n  // ---- Particular solution (free variables = 0) ----\n  const particular = new Array(M).fill(0);\n  for (let i = 0; i < pivotCols.length; i++) {\n    particular[pivotCols[i]] = aug[i][M];\n  }\n\n  // ---- Null space basis ----\n  const isPivot = new Set(pivotCols);\n\n  const nullBasis: number[][] = [];\n  const freeCols: number[] = [];\n  for (let c = 0; c < M; c++) {\n    if (!isPivot.has(c)) freeCols.push(c);\n  }\n\n  for (let fi = 0; fi < freeCols.length; fi++) {\n    const fc = freeCols[fi];\n    const v = new Array(M).fill(0);\n    v[fc] = 1; // this free variable = 1\n\n    // For each pivot row, compute value of the pivot variable\n    for (let ri = 0; ri < pivotCols.length; ri++) {\n      const pc = pivotCols[ri];\n      // Equation: x_pc + sum_{free} aug[ri][free] * y_free = aug[ri][M]\n      // For y_fc = 1, others = 0: x_pc = -aug[ri][fc] (mod p)\n      v[pc] = sub(0, aug[ri][fc], p);\n    }\n    nullBasis.push(v);\n  }\n\n  return { particular, nullBasis, pivotCols };\n}\n\n// ==========================================================================\n// Enumeration of null space (small p^k)\n// ==========================================================================\n\n/** Decide whether direct enumeration is feasible. */\nfunction canEnumerate(p: number, k: number): boolean {\n  if (k <= 3) return true; // always small enough\n  // Compute p^k with early exit\n  let total = 1;\n  for (let i = 0; i < k; i++) {\n    total *= p;\n    if (total > 5_000_000) return false;\n  }\n  return true;\n}\n\n/**\n * Search the null-space coset particular + span(nullBasis) for the\n * minimum-total-presses solution by enumerating all p^k assignments.\n *\n * Uses incremental updates of the solution vector.\n */\nfunction enumerateNullSpace(\n  particular: number[],\n  nullBasis: number[][],\n  pivotCols: number[],\n  p: number,\n): number[] {\n  const M = particular.length;\n  const k = nullBasis.length;\n\n  // Precompute non-zero positions for each basis vector\n  const nz: number[][] = nullBasis.map((bv) => {\n    const pos: number[] = [];\n    for (let i = 0; i < M; i++) {\n      if (bv[i] !== 0) pos.push(i);\n    }\n    return pos;\n  });\n\n  // Current free-variable coefficients (base-p counter)\n  const idx = new Array(k).fill(0);\n\n  // Current solution vector and cost\n  const sol = [...particular];\n  let cost = costSum(sol);\n\n  let bestSol: number[] = [...sol];\n  let bestCost = cost;\n\n  // Total number of combinations\n  const total = Math.pow(p, k);\n\n  for (let iter = 0; iter < total; iter++) {\n    // Evaluate current state\n    if (cost < bestCost || (cost === bestCost && arrayLessThan(sol, bestSol))) {\n      bestCost = cost;\n      bestSol = [...sol];\n    }\n\n    // Increment base-p counter (skip on the last iteration)\n    if (iter === total - 1) break;\n\n    // Carry-propagate increment: increase the rightmost non-max position\n    // by 1, reset all positions to its right to 0.\n    for (let j = k - 1; j >= 0; j--) {\n      if (idx[j] < p - 1) {\n        // idx[j] goes from v to v+1  : add one copy of nullBasis[j]\n        idx[j]++;\n        const pos = nz[j];\n        for (let t = 0; t < pos.length; t++) {\n          const i = pos[t];\n          const oldV = sol[i];\n          sol[i] = add(sol[i], nullBasis[j][i], p);\n          cost += sol[i] - oldV;\n        }\n        break;\n      } else {\n        // idx[j] goes from p-1 to 0  : remove (p-1) copies, add 1 copy\n        // Because -(p-1) = 1 (mod p), the net change is adding one copy.\n        idx[j] = 0;\n        const pos = nz[j];\n        for (let t = 0; t < pos.length; t++) {\n          const i = pos[t];\n          const oldV = sol[i];\n          sol[i] = add(sol[i], nullBasis[j][i], p);\n          cost += sol[i] - oldV;\n        }\n      }\n    }\n  }\n\n  return bestSol;\n}\n\n// ==========================================================================\n// Iterative descent for large null spaces\n// ==========================================================================\n\n/**\n * Search the null-space coset using coordinate descent.\n *\n * For each free variable (basis vector), try all p possible values and pick