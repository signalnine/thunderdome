+import { describe, it, expect } from 'vitest';
+import { solveToggle } from '../src/index.js';
+
+/**
+ * Build a solvable toggle instance with M buttons and N lights.
+ * The intended solution is a known set of button indices.
+ */
+function buildToggleCase(
+  M: number,
+  N: number,
+  solutionIndices: number[],
+): { target: boolean[]; buttons: number[][] } {
+  // Each button toggles a semi-random set of lights (seed via button index)
+  const buttons: number[][] = [];
+  for (let i = 0; i < M; i++) {
+    const btn: number[] = [];
+    for (let l = 0; l < N; l++) {
+      // Deterministic pattern so each button has ~N/2 lights
+      if ((i * 13 + l * 7 + 3) % 11 < 5) btn.push(l);
+    }
+    buttons.push(btn);
+  }
+
+  // Compute target from the intended solution
+  const target = new Array(N).fill(false);
+  for (const si of solutionIndices) {
+    for (const l of buttons[si]) {
+      target[l] = !target[l];
+    }
+  }
+  return { target, buttons };
+}
+
+describe('solveToggle large (meet-in-the-middle path)', () => {
+  it('M=30 solveable with 5 buttons pressed', () => {
+    const pressed = [2, 7, 15, 22, 28];
+    const { target, buttons } = buildToggleCase(30, 10, pressed);
+    const result = solveToggle({ target, buttons });
+    expect(result).not.toBeNull();
+    if (result) {
+      // Verify correctness
+      const check = new Array(10).fill(false);
+      for (const pi of result) {
+        for (const l of buttons[pi]) {
+          check[l] = !check[l];
+        }
+      }
+      expect(check).toEqual(target);
+    }
+  });
+
+  it('M=40 solveable with many buttons pressed', () => {
+    const pressed = [0, 3, 8, 12, 17, 22, 25, 31, 36, 39];
+    const { target, buttons } = buildToggleCase(40, 15, pressed);
+    const result = solveToggle({ target, buttons });
+    expect(result).not.toBeNull();
+    if (result) {
+      const check = new Array(15).fill(false);
+      for (const pi of result) {
+        for (const l of buttons[pi]) {
+          check[l] = !check[l];
+        }
+      }
+      expect(check).toEqual(target);
+      // The result should be no larger than the intended solution
+      expect(result.length).toBeLessThanOrEqual(pressed.length);
+    }
+  });
+
+  it('M=35 returns null for impossible target', () => {
+    // Build buttons where light 0 is only toggled by button 0.
+    // If target[0] = true, we must press button 0.
+    // But if buttons are constructed so there's ALSO an equation forcing
+    // an inconsistency… simpler: make a 1-light case with 35 buttons,
+    // none of which affect it.
+    const buttons: number[][] = Array.from({ length: 35 }, () => []);
+    const result = solveToggle({ target: [true], buttons });
+    expect(result).toBeNull();
+  });
+
+  it('M=40 single button solution', () => {
+    // Only button 17 toggles any lights (light 0), all other buttons do nothing.
+    const buttons: number[][] = Array.from({ length: 40 }, (_, i) =>
+      i === 17 ? [0] : [],
+    );
+    const result = solveToggle({ target: [true], buttons });
+    expect(result).toEqual([17]);
+  });
+
+  it('M=25 ensures lexicographically smallest tiebreak', () => {
+    // Two buttons affect the same single light:
+    // Buttons 5 and 20 each toggle light 0.
+    // Target: light 0 ON. Solutions: [5] or [20] (both weight 1).
+    // [5] is lexicographically smaller.
+    const buttons: number[][] = Array.from({ length: 25 }, (_, i) =>
+      i === 5 || i === 20 ? [0] : [],
+    );
+    const result = solveToggle({ target: [true], buttons });
+    expect(result).toEqual([5]);
+  });
+});
