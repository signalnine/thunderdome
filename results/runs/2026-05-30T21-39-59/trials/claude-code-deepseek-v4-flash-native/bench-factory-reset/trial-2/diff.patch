rix with M+1 columns\n  const aug: number[][] = Array.from({ length: N }, (_, r) => {\n    const row = new Array(M + 1);\n    for (let c = 0; c < M; c++) row[c] = A[r][c] % p;\n    row[M] = b[r] % p;\n    return row;\n  });\n\n  const pivotCols: number[] = [];\n  let row = 0;\n\n  for (let col = 0; col < M && row < N; col++) {\n    // Find pivot (non-zero entry in this column at or below row `row`)\n    let pivotRow = -1;\n    for (let r = row; r < N; r++) {\n      if (aug[r][col] !== 0) {\n        pivotRow = r;\n        break;\n      }\n    }\n    if (pivotRow === -1) continue;\n\n    // Swap pivot row to current position\n    [aug[row], aug[pivotRow]] = [aug[pivotRow], aug[row]];\n\n    // Normalize pivot row (make aug[row][col] = 1)\n    const inv = modInv(aug[row][col], p);\n    for (let c = col; c <= M; c++) {\n      aug[row][c] = mul(aug[row][c], inv, p);\n    }\n\n    // Eliminate this column from ALL other rows (Gauss–Jordan)\n    for (let r = 0; r < N; r++) {\n      if (r !== row && aug[r][col] !== 0) {\n        const factor = aug[r][col];\n        for (let c = col; c <= M; c++) {\n          aug[r][c] = sub(aug[r][c], mul(factor, aug[row][c], p), p);\n        }\n      }\n    }\n\n    pivotCols.push(col);\n    row++;\n  }\n\n  // Inconsistency check: any row with all-zero LHS but non-zero RHS?\n  for (let r = row; r < N; r++) {\n    let zeroLhs = true;\n    for (let c = 0; c < M; c++) {\n      if (aug[r][c] !== 0) {\n        zeroLhs = false;\n        break;\n      }\n    }\n    if (zeroLhs && aug[r][M] !== 0) return null;\n  }\n\n  // ---- Particular solution (free variables = 0) ----\n  const particular = new Array(M).fill(0);\n  for (let i = 0; i < pivotCols.length; i++) {\n    const pc = pivotCols[i];\n    particular[pc] = aug[i][M]; // RHS of pivot row i\n  }\n\n  // ---- Null space basis ----\n  // Free variables are columns NOT in pivotCols\n  const freeCols: number[] = [];\n  const isPivot = new Set(pivotCols);\n  for (let c = 0; c < M; c++) {\n    if (!isPivot.has(c)) freeCols.push(c);\n  }\n\n  const nullBasis: number[][] = [];\n  for (let fi = 0; fi < freeCols.length; fi++) {\n    const fc = freeCols[fi];\n    const v = new Array(M).fill(0);\n    v[fc] = 1; // free var = 1\n\n    // For each pivot row, compute the value of the pivot variable\n    for (let ri = 0; ri < pivotCols.length; ri++) {\n      const pc = pivotCols[ri];\n      // Equation: x_pc + sum_{free} aug[ri][free] * y_free = aug[ri][M]\n      // For y_fc = 1, others = 0: x_pc = -aug[ri][fc] (mod p)\n      v[pc] = sub(0, aug[ri][fc], p);\n    }\n    nullBasis.push(v);\n  }\n\n  return { particular, nullBasis, pivotCols };\n}\n\n// ==========================================================================\n// Enumeration of null space (small k)\n// ==========================================================================\n\n/**\n * Search the null-space coset particular + span(nullBasis) for the\n * minimum-total-presses solution by enumerating all p^k assignments to\n * the free variables.\n *\n * Uses incremental updates of the solution vector for efficiency.\n */\nfunction enumerateNullSpace(\n  particular: number[],\n  nullBasis: number[][],\n  p: number,\n  k: number,\n): number[] | null {\n  const M = particular.length;\n  const total = Math.pow(p, k);\n\n  // Current solution vector and cost\n  const sol = [...particular];\n  let cost = sol.reduce((a, b) => a + b, 0);\n\n  let bestSol: number[] = [...sol];\n  let bestCost = cost;\n\n  // Indices into free variables (base-p counter)\n  const idx = new Array(k).fill(0);\n\n  for (let iter = 0; iter < total - 1; iter++) {\n    // Check current before incrementing\n    if (cost < bestCost || (cost === bestCost && arrayLessThan(sol, bestSol))) {\n      bestCost = cost;\n      bestSol = [...sol];\n    }\n\n    // Increment base-p counter, update sol and cost incrementally\n    for (let j = k - 1; j >= 0; j--) {\n      if (idx[j] < p - 1) {\n        // idx[j] → idx[j] + 1 : add one copy of nullBasis[j]\n        const bv = nullBasis[j];\n        // cost change: one more press of this free variable; each basic\n        // variable that depends on it also changes by bv[i] (mod p):\n        // new_cost change = (bv[i] != 0 ? newVal - oldVal : 0) accounting for wrap\n        for (let i = 0; i < M; i++) {\n          if (bv[i] === 0) continue;\n          const oldV = sol[i];\n          sol[i] = add(sol[i], bv[i], p);\n          cost += sol[i] - oldV;\n        }\n        // The free variable itself also increments by 1 → cost +1\n        cost += 1;\n        idx[j]++;\n        break;\n      } else {\n        // idx[j] goes from p-1 back to 0: remove (p-1) copies, i.e. subtract nullBasis[j] * (p-1)\n        const bv = nullBasis[j];\n        for (let i = 0; i < M; i++) {\n          if (bv[i] === 0) continue;\n          const oldV = sol[i];\n          // Subtract bv[i] * (p-1) = add bv[i] (since -(p-1) ≡ 1 mod p)\n          sol[i] = add(sol[i], bv[i], p); // same as subtracting (p-1) copies\n          cost += sol[i] - oldV;\n        }\n        // The free variable cost goes from p-1 to 0 → change = -(p-1)\n        cost -= p - 1;\n        idx[j] = 0;\n      }\n    }\n  }\n\n  // Check the last combination\n  if (cost < bestCost || (cost === bestCost && arrayLessThan(sol, bestSol))) {\n    bestCost = cost;\n    bestSol = [...sol];\n  }\n\n  return bestSol;\n}\n\n// ==========================================================================\n// Iterative descent for large null spaces\n// ==========================================================================\n\n/**\n * Search the null-space coset using coordinate descent.\n *\n * For each free variable (basis vector), try all p possible values and pick\n * the one that minimises total cost (with lexicographic tie-break).\n * Repeat until no improvement, then try additional random restarts.\n */\nfunction descentNullSpace(\n  particular: number[],\n  nullBasis: number[][],\n  p: number,\n  k: number,\n): number[] {\n  con