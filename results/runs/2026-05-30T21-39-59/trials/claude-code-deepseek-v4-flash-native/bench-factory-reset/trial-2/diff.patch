leftMap.get(pat);\n    if (\n      prev === undefined ||\n      wt < prev.wt ||\n      (wt === prev.wt && cmpBitmask(bm, prev.bm, mid) < 0)\n    ) {\n      leftMap.set(pat, { bm, wt });\n    }\n  }\n\n  // Enumerate right half and pair with left\n  const rightTotal = 1 << rightCnt;\n  let bestMask: bigint | null = null;\n  let bestWt = Infinity;\n\n  for (let combo = 0; combo < rightTotal; combo++) {\n    let pat = 0n;\n    let bm = 0n;\n    let wt = 0;\n    for (let i = 0; i < rightCnt; i++) {\n      if (combo & (1 << i)) {\n        pat ^= btnMasks[mid + i];\n        bm |= 1n << BigInt(mid + i);\n        wt++;\n      }\n    }\n\n    const need = tgt ^ pat;\n    const left = leftMap.get(need);\n    if (left === undefined) continue;\n\n    const totalWt = left.wt + wt;\n    const merged = left.bm | bm;\n\n    if (\n      totalWt < bestWt ||\n      (totalWt === bestWt && cmpBitmask(merged, bestMask!, M) < 0)\n    ) {\n      bestWt = totalWt;\n      bestMask = merged;\n    }\n  }\n\n  return bestMask === null ? null : bitmaskToArray(bestMask, M);\n}\n\n// ---------------------------------------------------------------------------\n// Part 2 — Counter Puzzle  (GF(p), p prime)\n// ---------------------------------------------------------------------------\n\n/**\n * Solve the counter puzzle.\n *\n * Each button increments a specific set of counters by 1 (wrapping at modulus\n * p).  Each button may be pressed 0 .. p-1 times.  Return an array result[i] =\n * presses of button i, minimising total presses (sum), with lexicographically\n * smallest tie-break, or null if no solution.\n */\nexport function solveCounter(\n  lights: number[],\n  buttons: number[][],\n  modulus: number,\n): number[] | null {\n  const N = lights.length; // counters\n  const M = buttons.length; // buttons\n  const p = modulus;\n\n  if (N === 0) return new Array(M).fill(0);\n  if (M === 0) {\n    return lights.every((v) => v === 0) ? [] : null;\n  }\n\n  // ---------- Build matrix ----------\n  // A