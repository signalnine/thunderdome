======================================\n\ndescribe('solveToggle', () => {\n  // ---- Basic examples from problem description ----\n  it('returns null for the worked example (no solution)', () => {\n    // 4 lights, 3 buttons — target [T, T, F, T]\n    const result = solveToggle({\n      target: [true, true, false, true],\n      buttons: [\n        [0, 1],\n        [1, 2, 3],\n        [0, 3],\n      ],\n    });\n    expect(result).toBeNull();\n  });\n\n  it('solves a simple single-button case', () => {\n    const result = solveToggle({\n      target: [true, false],\n      buttons: [[0]],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  it('solves with no buttons needed (target already off)', () => {\n    const result = solveToggle({\n      target: [false, false, false],\n      buttons: [\n        [0],\n        [1],\n        [2],\n      ],\n    });\n    expect(result).toEqual([]);\n  });\n\n  it('solves with a single light and multiple buttons affecting it', () => {\n    // Button 0 toggles light 0, button 1 toggles light 0\n    // Target: [true]\n    // Either button works. Fewest presses = 1. Lexicographically smallest = [0]\n    const result = solveToggle({\n      target: [true],\n      buttons: [[0], [0]],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  // ---- Exact example from the task (worked out to have a solution) ----\n  it('solves a 3-light 3-button case', () => {\n    // Lights 0,1,2. Target [T, F, T]\n    // Button 0: toggles [0, 2]\n    // Button 1: toggles [0, 1]\n    // Button 2: toggles [1, 2]\n    // Only button 0: [T, F, T] — works!\n    const result = solveToggle({\n      target: [true, false, true],\n      buttons: [\n        [0, 2],\n        [0, 1],\n        [1, 2],\n      ],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  // ---- Tie-breaking: fewer presses ----\n  it('prefers fewer button presses', () => {\n    // Target: [T]\n    // Button 0: toggles [0]\n    // Button 1: toggles [0]\n    // Both work individually. Answer = [0] (fewer presses… same count, lex smaller)\n    const result = solveToggle({\n      target: [true],\n      buttons: [[0], [0]],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  // ---- Tie-breaking: lexicographically smallest ----\n  it('picks lexicographically smallest when counts tied', () => {\n    // 2 lights, target [F, T]\n    // Button 1 toggles [1]\n    // Button 2 toggles [1]\n    // Both work individually, count=1. Lexicographically smaller = [0] (index 0 < 1)\n    const result = solveToggle({\n      target: [false, true],\n      buttons: [\n        [1],\n        [1],\n      ],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  it('lex tie-break with two-button solutions', () => {\n    // 3 lights, target [T, T, F]\n    // Button 0: [0, 1]\n    // Button 1: [0, 2]\n    // Button 2: [1, 2]\n    // Need light 0 on: need odd number of presses from {0,1}\n    // Need light 1 on: odd from {0,2}\n    // Need light 2 off: even from {1,2}\n    // Press 0: [T, T, F] — works!\n    // Press 1, 2: [F, T, T] → [T, T, F] — wait:\n    //   1: [T, F, T], 2: [T, T, F] — that works too!\n    // Solution A: [0] count=1\n    // Solution B: [1, 2] count=2\n    // Best is A: [0]\n    const result = solveToggle({\n      target: [true, true, false],\n      buttons: [\n        [0, 1],\n        [0, 2],\n        [1, 2],\n      ],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  // ---- Larger cases ----\n  it('solves a 10-light xor system', () => {\n    // Each button toggles one light independently\n    const buttons = Array.from({ length: 10 }, (_, i) => [i]);\n    const target = [true, false, true, false, true, false, true, false, true, false];\n    const result = solveToggle({ target, buttons });\n    expect(result).toEqual([0, 2, 4, 6, 8]);\n  });\n\n  it('handles M > N with ties', () => {\n    // 2 lights, 4 buttons — many redundant ways\n    // Target: both on\n    // Button 0: [0], 1: [1], 2: [0,1], 3: [0,1]\n    // Best: press 0 and 1 → [0,1]\n    // Or: press 2 alone → [2] — count=1, wait that gives both on\n    // Actually button 2 toggles [0,1], so pressing 2 gives [T, T] — count=1\n    const result = solveToggle({\n      target: [true, true],\n      buttons: [[0], [1], [0, 1], [0, 1]],\n    });\n    // Pressing [2] or [3] both work with count=1. [2] is lexicographically smaller\n    expect(result).toEqual([2]);\n  });\n\n  it('40 lights, 40 independent buttons — each toggles one light', () => {\n    const N = 40;\n    const target: boolean[] = [];\n    const buttons: number[][] = [];\n    for (let i = 0; i < N; i++) {\n      target.push(i % 2 === 0);\n      buttons.push([i]);\n    }\n    const result = solveToggle({ target, buttons });\n    // All even-indexed buttons pressed\n    const expected: number[] = [];\n    for (let i = 0; i < N; i += 2) expected.push(i);\n    expect(result).toEqual(expected);\n  });\n\n  it('handles worst-case 40-light search (meet-in-the-middle test)', () => {\n    // 20 lights, 40 buttons where half the buttons are redundant\n    // Each button 0..19 toggles one distinct light\n    // Buttons 20..39 toggle [0..19] all at once\n    // Target: all lights off → 0 buttons pressed\n    const target = new Array(20).fill(false);\n    const buttons: number[][] = [];\n    for (let i = 0; i < 20; i++) buttons.push([i]);\n    for (let i = 0; i < 20; i++) {\n      const all = Array.from({ length: 20 }, (_, j) => j);\n      buttons.push(all);\n    }\n    const result = solveToggle({ target, buttons });\n    expect(result).toEqual([]);\n  });\n\n  it('40-button meet-in-the-middle stress test', () => {\n    // Create a matrix where we need to find a specific combination\n    // 5 lights, 40 buttons\n    // Each button toggles a subset\n    // Target: all on\n    // Create a known solution: press buttons 0, 10, 20, 30\n    // All other buttons are \"decoy\"\n    const target = new Array(5).fill(true);\n    const buttons: number[][] = [];\n    for (let i = 0; i < 40; i++) {\n      buttons.push([]);\n    }\n    // Button 0: toggles [0, 2]\n    buttons[0] = [0, 2];\n    // Button 10: toggles [1, 3]\n    buttons[10] = [1, 3];\n    // Button 20: toggles [2, 4]\n    buttons[20] = [2, 4];\n    // Button 30: toggles [0, 3, 4]\n    buttons[30] = [0, 3, 4];\n    // Add decoy buttons that toggle nothing\n    // Pressing 0,10,20,30:\n    // 0: [T,F,T,F,F]\n    // 10: [T,T,T,T,F]\n    // 20: [T,T,F,T,T]\n    // 30: [F,T,F,F,F] — wait that gives all off?\n    // Let me recalculate\n    // 0 -> [T,F,T,F,F]\n    // 10 -> [T,T,T,T,F] (XOR)\n    // 20 -> [T,T,F,F,T] (XOR, toggled index 2 which was on → off)\n    // 30 -> [F,T,F,T,F] (XOR toggled 0,3,4)\n    // Target is [T,T,T,T,T], this doesn't work.\n\n    // Let me just make a solvable system and verify\n    const target2 = [true, true, false, true, false];\n    const buttons2: number[][] = Array.from({ length: 40 }, () => []);\n    // The solution is [2, 3] (indices) which are buttons 2 and 3\n    // Check: target = [T, T, F, T, F]\n    // Button 2: toggles [0, 3]\n    buttons2[2] = [0, 3];\n    // Button 3: toggles [0, 1]\n    buttons2[3] = [0, 1];\n    // 2: [T,F,F,T,F]\n    // 3: [F,T,F,T,F] → wait\n    // After 2: [T,F,F,T,F]\n    // After 3: [F,T,F,F,F] — wrong\n    // Hmm. Let me try:\n    // Button 0: [0,3] -> need both 0 and 3\n    // Button 1: [0,1] -> toggles 0, need 0 off\n    // This gives [F,T,F,T,F] which is wrong too.\n\n    // OK let me just make a simpler solvable case\n    // 3 lights, target [T, T, F]\n    const target3 = [true, true, false];\n    const buttons3: number[][] = Array.from({ length: 40 }, () => []);\n    // Button 5: [0]\n    // Button 17: [1]\n    // Solution: press buttons 5 and 17\n    buttons3[5] = [0];\n    buttons3[17] = [1];\n    const result3 = solveToggle({ target: target3, buttons: buttons3 });\n    expect(result3).toEqual([5, 17]);\n  });\n\n  it('returns empty array when nothing needs to change', () => {\n    const result = solveToggle({\n      target: [false, false],\n      buttons: [\n        [0],\n        [1],\n        [0, 1],\n      ],\n    });\n    expect(result).toEqual([]);\n  });\n});\n\n// =========================================================================\n// Part 2 — Counter Puzzle\n// =========================================================================\n\ndescribe('solveCounter', () => {\n  // ---- Mod 2 toggle === GF(2) ----\n  it('works for mod 2 (same as toggle)', () => {\n    // 3 counters, target [1, 0, 1]\n    // Button 0: [0, 2]\n    // Button 1: [0, 1]\n    // Only button 0 → [1, 0, 1]\n    const result = solveCounter([1, 0, 1], [[0, 2], [0, 1], [1, 2]], 2);\n    expect(result).toEqual([1, 0, 0]);\n  });\n\n  // ---- Simple cases ----\n  it('simple: one button one counter', () => {\n    const result = solveCounter([1], [[0]], 5);\n    expect(result).toEqual([1]);\n  });\n\n  it('zero presses when all targets are 0', () => {\n    const result = solveCounter([0, 0, 0], [[0], [1], [2]], 7);\n    expect(result).toEqual([0, 0, 0]);\n  });\n\n  it('no solution: impossible target', () => {\n    // Button 0 affects counter 0, target is 1 mod 5\n    // But button 1 only affects counter 1\n    // Counter 0 can be incremented — so button 0 pressed 1 time works\n    // Wait that IS a solution. Let me think of an impossible one.\n    // 2 counters, 1 button affecting only counter 0, target [0, 1]\n    // Counter 1 can never be affected → no solution\n    const result = solveCounter([0, 1], [[0]], 5);\n    expect(result).toBeNull();\n  });\n\n  // ---- Prime mod with wrapping ----\n  it('handles wrap-around: press p-1 times', () => {\n    // 1 counter, modulus 5\n    // Button 0 affects counter 0\n    // Target: 4 (mod 5) = 4 presses\n    // Or press 0 times? No, 0 ≠ 4 mod 5\n    // Or... We need counter 0 to be 4. Pressing button 0 4 times gives 0→1→2→3→4.\n    // So result[0] = 4\n    const result = solveCounter([4], [[0]], 5);\n    expect(result).toEqual([4]);\n  });\n\n  it('minimum total presses across multiple solutions', () => {\n    // 2 counters, modulus 5\n    // Button 0: [0, 1]  — increments both\n    // Button 1: [1]      — increments counter 1 only\n    // Target: [1, 1]\n    // Option A: press button 0 once → [1, 1], total = 1\n    // Option B: press button 1 once → [0, 1] then we still need counter 0 at 1\n    //   B is impossible without button 0 or another button affecting counter 0\n    // So only option A: [1, 0]\n    const result = solveCounter([1, 1], [[0, 1], [1]], 5);\n    expect(result).toEqual([1, 0]);\n  });\n\n  it('minimum total presses: multiple valid solutions', () => {\n    // 1 counter, modulus 7\n    // Button 0: [0], Button 1: [0]\n    // Target: 2\n    // Option A: press button 0 twice → 2, total=2\n    // Option B: press button 1 twice → 2, total=2\n    // Option C: press button 0 once and button 1 once → 2, total=2\n    // All have total=2. Lexicographically smallest: [2, 0] < [1, 1] < [0, 2]\n    // Actually [2,0]: presses for [button0, button1] = 2 (mod 7) = 2 presses of button 0\n    // [1,1]: 1+1 = 2 mod 7 = target. Total = 1+1 = 2.\n    // [0,2]: 2 presses of button 1, total = 2.\n    // Lexicographically: [0, 2] vs [1, 1] vs [2, 0]\n    // Lexicographically smallest among equal total: [0,2]\n    const result = solveCounter([2], [[0], [0]], 7);\n    expect(result).toEqual([0, 2]);\n  });\n\n  it('lexicographic tie-breaking with equal cost', () => {\n    // 1 counter, modulus 5\n    // 3 buttons all affecting counter 0\n    // Target: 1\n    // Options: [1,0,0] (total=1), [0,1,0] (total=1), [0,0,1] (total=1)\n    // Lexicographically: [0,0,1] < [0,1,0] < [1,0,0]\n    // Actually wait: [0,0,1] at index 0: 0, [0,1,0] at index 0: 0, [1,0,0] at index 0: 1\n    // [0,0,1] vs [0,1,0]: index 0: 0=0, index 1: 0<1 → [0,0,1] wins\n    const result = solveCounter([1], [[0], [0], [0]], 5);\n    expect(result).toEqual([1, 0, 0]);\n    // Hmm, but actually we need to re-examine.\n    // The matrix is: [1, 1, 1 | 1] over Z_5.\n    // x_0 + x_1 + x_2 = 1 (mod 5)\n    // This is a rank-1 system with 3 variables, so 2 free variables.\n    // The solution space is 2-dimensional.\n    // Particular: [1, 0, 0]\n    // Null space basis: v1 = [-1, 1, 0] = [4, 1, 0] (mod 5), v2 = [-1, 0, 1] = [4, 0, 1]\n    // All solutions: [1, 0, 0] + t1*[4, 1, 0] + t2*[4, 0, 1] (mod 5)\n    // = [1+4t1+4t2, t1, t2] (mod 5)\n    // For t1=0,t2=0: [1,0,0] total=1\n    // For t1=1,t2=0: [0,1,0] total=1 (since 1+4=5=0 mod 5)\n    // For t1=0,t2=1: [0,0,1] total=1 (since 1+4=5=0 mod 5)\n    // For t1=1,t2=1: [4,1,1] total=6 (since 1+4+4=9=4 mod 5)\n    // etc.\n    // Three solutions with total=1: [1,0,0], [0,1,0], [0,0,1]\n    // Lexicographically smallest among equal total: [0,0,1]\n    const result = solveCounter([1], [[0], [0], [0]], 5);\n    expect(result).toEqual([0, 0, 1]);\n  });\n\n  // ---- Larger cases ----\n  it('40 counters, 40 buttons, mod 5 — unique solution', () => {\n    // Each button affects exactly one counter independently\n    // This should give a unique solution\n    const N = 40;\n    const buttons: number[][] = [];\n    const target: number[] = [];\n    for (let i = 0; i < N; i++) {\n      buttons.push([i]);\n      target.push(i % 5); // 0,1,2,3,4,0,1,...\n    }\n    const result = solveCounter(target, buttons, 5);\n    expect(result).not.toBeNull();\n    if (result) {\n      for (let i = 0; i < N; i++) {\n        expect(result[i] % 5).toBe(target[i] % 5);\n      }\n    }\n  });\n\n  it('multiple buttons per counter, mod 3', () => {\n    // 3 counters, 3 buttons\n    // Button 0: [0, 1]\n    // Button 1: [1, 2]\n    // Button 2: [0, 2]\n    // Target: [1, 1, 1] (mod 3)\n    // Equation 0: x0 + x2 = 1 (mod 3)\n    // Equation 1: x0 + x1 = 1 (mod 3)\n    // Equation 2: x1 + x2 = 1 (mod 3)\n    // From eq0: x2 = 1 - x0\n    // From eq1: x1 = 1 - x0\n    // From eq2: (1-x0) + (1-x0) = 2 - 2x0 = 1 → 2x0 = 1 → x0 = 2 (mod 3)\n    // So x0 = 2, x1 = 1-2 = -1 = 2 (mod 3), x2 = 1-2 = -1 = 2 (mod 3)\n    // Solution: [2, 2, 2] is the unique solution\n    const result = solveCounter([1, 1, 1], [[0, 1], [1, 2], [0, 2]], 3);\n    expect(result).toEqual([2, 2, 2]);\n  });\n\n  it('wrap-around with multiple solutions (mod 5)', () => {\n    // 2 counters, 2 buttons\n    // Button 0: [0, 1]\n    // Button 1: [0, 1]\n    // Target: [0, 0] (mod 5)\n    // Equations: x0 + x1 = 0 (mod 5) for both counters\n    // Particular: [0, 0]\n    // Null space: [1, 4] or [4, 1] or equivalently: x1 = -x0\n    // Solutions: [t, -t] for t = 0..4\n    // t=0: [0,0] total=0\n    // t=1: [1,4] total=5\n    // t=2: [2,3] total=5\n    // t=3: [3,2] total=5\n    // t=4: [4,1] total=5\n    // Minimum: [0, 0]\n    const result = solveCounter([0, 0], [[0, 1], [0, 1]], 5);\n    expect(result).toEqual([0, 0]);\n  });\n\n  it('wrapping gives lower total cost', () => {\n    // 1 counter, 1 button\n    // Modulus 5, target 1\n    // Button 0 affects counter 0\n    // Pressing 1 time: cost 1\n    // Pressing 6 times would be: cost 6 but (6 mod 5 = 1). But max is 4.\n    // So only [1] works.\n    // Actually simpler: 1 counter, 2 buttons both affecting it\n    // Mod 5, target 0\n    // [0,0] total=0\n    // [1,4] total=5 (1+4=5=0 mod 5)\n    // [4,1] total=5\n    // [2,3] total=5\n    // [3,2] total=5\n    // Minimum is [0,0].\n    // Hmm, this doesn't demonstrate wrapping being better.\n\n    // Let me construct one where wrapping helps.\n    // 1 counter, mod 7. Target = 6.\n    // Button 0: [0], Button 1: [0]\n    // Equations: x0 + x1 = 6 (mod 7)\n    // Particular: [6, 0], total = 6\n    // But also [0, 6], total = 6\n    // Or [1, 5], total = 6\n    // All have same total since x0 + x1 = 6 or 13 or 20...\n    // To make wrapping actually reduce cost:\n    // We need: setting free variables causes pivot variables to wrap,\n    // reducing their effective value.\n    //\n    // Consider: 2 counters, 2 buttons, mod 5\n    // Button 0: [0, 1]\n    // Button 1: [0]\n    // Target: [0, 2] (mod 5)\n    // Eqs: x0 + x1 = 0 (mod 5), x0 = 2 (mod 5)\n    // So x0 = 2, x1 = -2 = 3 (mod 5)\n    // Solution: [2, 3], total = 5\n    // Unique? rank 2 with 2 variables → unique. No choice.\n    const result = solveCounter([0, 2], [[0, 1], [0]], 5);\n    expect(result).toEqual([2, 3]);\n  });\n\n  it('uses modular inverse correctly', () => {\n    // Solvable with prime modulus where inversion matters\n    // 2 counters, 1 button affecting both\n    // Mod 7\n    // Target: [3, 4]\n    // Button 0: [0, 1] — increments both by 1 each press\n    // x0 = 3 (mod 7), x0 = 4 (mod 7) → impossible (contradiction)\n    const result = solveCounter([3, 4], [[0, 1]], 7);\n    expect(result).toBeNull();\n    // Actually wait, both equations are x0 = target, since x0 affects both.\n    // So 3 = 4 (mod 7) is not true → inconsistent.\n  });\n\n  it('handles prime modulus non-2', () => {\n    // Mod 13\n    // 3 buttons, 2 counters\n    // Button 0: [0], Button 1: [1], Button 2: [0, 1]\n    // Target: [5, 8]\n    // Eqs: x0 + x2 = 5, x1 + x2 = 8\n    // Particular (set x2 = 0): [5, 8, 0], total = 13\n    // Null space (x2 is free): x0 = 5 - x2, x1 = 8 - x2\n    // Solutions: [5-t, 8-t, t] for t ∈ {0,...,12}\n    // Total: (5-t) + (8-t) + t = 13 - t (without wrap)\n    // With wrap: when 5-t < 0 or 8-t < 0, wrap adds 13\n    // t=0: [5,8,0] total=13\n    // t=1: [4,7,1] total=12\n    // t=2: [3,6,2] total=11\n    // t=3: [2,5,3] total=10\n    // t=4: [1,4,4] total=9\n    // t=5: [0,3,5] total=8\n    // t=6: [12,2,6] total=20 (5-6=-1=12, 8-6=2, +6=20)\n    // Minimum: t=5 → [0,3,5] total=8\n    const result = solveCounter([5, 8], [[0], [1], [0, 1]], 13);\n    expect(result).toEqual([0, 3, 5]);\n  });\n\n  // ---- Performance stress ----\n  it('40 counters 40 buttons with several extra buttons', () => {\n    // 30 counters, 40 buttons\n    // First 30 buttons each affect one counter independently\n    // Last 10 buttons are decoys (affect no counters)\n    // Target: mix of values\n    const N = 30;\n    const M = 40;\n    const buttons: number[][] = Array.from({ length: M }, () => []);\n    const target: number[] = [];\n    for (let i = 0; i < N; i++) {\n      buttons[i] = [i];\n      target.push((i * 3) % 7);\n    }\n    const result = solveCounter(target, buttons, 7);\n    expect(result).not.toBeNull();\n    if (result) {\n      for (let i = 0; i < N; i++) {\n        expect(result[i] % 7).toBe(target[i] % 7);\n      }\n      for (let i = N; i < M; i++) {\n        expect(result[i]).toBe(0);\n      }\n    }\n  });\n});\n","structuredPatch":[{"oldStart":341,"oldLines":26,"newStart":341,"newLines":7,"lines":["     // Options: [1,0,0] (total=1), [0,1,0] (total=1), [0,0,1] (total=1)","     // Lexicographically: [0,0,1] < [0,1,0] < [1,0,0]","     // Actually wait: [0,0,1] at index 0: 0, [0,1,0] at index 0: 0, [1,0,0] at index 0: 1","-    // [0,0,1] vs [0,1,0]: index 0: 0=0, index 1: 0<1 → [0,0,1] wins","     const result = solveCounter([1], [[0], [0], [0]], 5);","-    expect(result).toEqual([1, 0, 0]);","-    // Hmm, but actually we need to re-examine.","-    // The matrix is: [1, 1, 1 | 1] over Z_5.","-    // x_0 + x_1 + x_2 = 1 (mod 5)","-    // This is a rank-1 system with 3 variables, so 2 free variables.","-    // The solution space is 2-dimensional.","-    // Particular: [1, 0, 0]","-    // Null space basis: v1 = [-1, 1, 0] = [4, 1, 0] (mod 5), v2 = [-1, 0, 1] = [4, 0, 1]","-    // All solutions: [1, 0, 0] + t1*[4, 1, 0] + t2*[4, 0, 1] (mod 5)","-    // = [1+4t1+4t2, t1, t2] (mod 5)","-    // For t1=0,t2=0: [1,0,0] total=1","-    // For t1=1,t2=0: [0,1,0] total=1 (since 1+4=5=0 mod 5)","-    // For t1=0,t2=1: [0,0,1] total=1 (since 1+4=5=0 mod 5)","-    // For t1=1,t2=1: [4,1,1] total=6 (since 1+4+4=9=4 mod 5)","-    // etc.","-    // Three solutions with total=1: [1,0,0], [0,1,0], [0,0,1]","-    // Lexicographically smallest among equal total: [0,0,1]","-    const result = solveCounter([1], [[0], [0], [0]], 5);","     expect(result).toEqual([0, 0, 1]);","   });"," "]}],"userModi