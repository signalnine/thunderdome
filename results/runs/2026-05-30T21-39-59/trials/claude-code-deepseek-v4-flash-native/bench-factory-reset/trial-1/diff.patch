=========================================================\n\ndescribe('solveToggle', () => {\n  // ---- Basic examples from problem description ----\n  it('returns null for the worked example (no solution)', () => {\n    // 4 lights, 3 buttons — target [T, T, F, T]\n    const result = solveToggle({\n      target: [true, true, false, true],\n      buttons: [\n        [0, 1],\n        [1, 2, 3],\n        [0, 3],\n      ],\n    });\n    expect(result).toBeNull();\n  });\n\n  it('solves a simple single-button case', () => {\n    const result = solveToggle({\n      target: [true, false],\n      buttons: [[0]],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  it('solves with no buttons needed (target already off)', () => {\n    const result = solveToggle({\n      target: [false, false, false],\n      buttons: [\n        [0],\n        [1],\n        [2],\n      ],\n    });\n    expect(result).toEqual([]);\n  });\n\n  it('solves with a single light and multiple buttons affecting it', () => {\n    // Button 0 toggles light 0, button 1 toggles light 0\n    // Target: [true]\n    // Either button works. Fewest presses = 1. Lexicographically smallest = [0]\n    const result = solveToggle({\n      target: [true],\n      buttons: [[0], [0]],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  // ---- Exact example from the task (worked out to have a solution) ----\n  it('solves a 3-light 3-button case', () => {\n    // Lights 0,1,2. Target [T, F, T]\n    // Button 0: toggles [0, 2]\n    // Button 1: toggles [0, 1]\n    // Button 2: toggles [1, 2]\n    // Only button 0: [T, F, T] — works!\n    const result = solveToggle({\n      target: [true, false, true],\n      buttons: [\n        [0, 2],\n        [0, 1],\n        [1, 2],\n      ],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  // ---- Tie-breaking: fewer presses ----\n  it('prefers fewer button presses', () => {\n    // Target: [T]\n    // Button 0: toggles [0]\n    // Button 1: toggles [0]\n    // Both work individually. Answer = [0] (fewer presses… same count, lex smaller)\n    const result = solveToggle({\n      target: [true],\n      buttons: [[0], [0]],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  // ---- Tie-breaking: lexicographically smallest ----\n  it('picks lexicographically smallest when counts tied', () => {\n    // 2 lights, target [F, T]\n    // Button 1 toggles [1]\n    // Button 2 toggles [1]\n    // Both work individually, count=1. Lexicographically smaller = [0] (index 0 < 1)\n    const result = solveToggle({\n      target: [false, true],\n      buttons: [\n        [1],\n        [1],\n      ],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  it('lex tie-break with two-button solutions', () => {\n    // 3 lights, target [T, T, F]\n    // Button 0: [0, 1]\n    // Button 1: [0, 2]\n    // Button 2: [1, 2]\n    // Need light 0 on: need odd number of presses from {0,1}\n    // Need light 1 on: odd from {0,2}\n    // Need light 2 off: even from {1,2}\n    // Press 0: [T, T, F] — works!\n    // Press 1, 2: [F, T, T] → [T, T, F] — wait:\n    //   1: [T, F, T], 2: [T, T, F] — that works too!\n    // Solution A: [0] count=1\n    // Solution B: [1, 2] count=2\n    // Best is A: [0]\n    const result = solveToggle({\n      target: [true, true, false],\n      buttons: [\n        [0, 1],\n        [0, 2],\n        [1, 2],\n      ],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  // ---- Larger cases ----\n  it('solves a 10-light xor system', () => {\n    // Each button toggles one light independently\n    const buttons = Array.from({ length: 10 }, (_, i) => [i]);\n    const target = [true, false, true, false, true, false, true, false, true, false];\n    const result = solveToggle({ target, buttons });\n    expect(result).toEqual([0, 2, 4, 6, 8]);\n  });\n\n  it('handles M > N with ties', () => {\n    // 2 lights, 4 buttons — many redundant ways\n    // Target: both on\n    // Button 0: [0], 1: [1], 2: [0,1], 3: [0,1]\n    // Best: press 0 and 1 