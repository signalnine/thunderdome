 false],\n      buttons: [\n        [0],\n        [1],\n        [0, 1],\n      ],\n    });\n    expect(result).toEqual([]);\n  });\n});\n\n// =========================================================================\n// Part 2 — Counter Puzzle\n// =========================================================================\n\ndescribe('solveCounter', () => {\n  // ---- Mod 2 toggle === GF(2) ----\n  it('works for mod 2 (same as toggle)', () => {\n    // 3 counters, target [1, 0, 1]\n    // Button 0: [0, 2]\n    // Button 1: [0, 1]\n    // Only button 0 → [1, 0, 1]\n    const result = solveCounter([1, 0, 1], [[0, 2], [0, 1], [1, 2]], 2);\n    expect(result).toEqual([1, 0, 0]);\n  });\n\n  // ---- Simple cases ----\n  it('simple: one button one counter', () => {\n    const result = solveCounter([1], [[0]], 5);\n    expect(result).toEqual([1]);\n  });\n\n  it('zero presses when all targets are 0', () => {\n    const result = solveCounter([0, 0, 0], [[0], [1], [2]], 7);\n    expect(result).toEqual([0, 0, 0]);\n  });\n\n  it('no solution: impossible target', () => {\n    // Button 0 affects counter 0, target is 1 mod 5\n    // But button 1 only affects counter 1\n    // Counter 0 can be incremented — so button 0 pressed 1 time works\n    // Wait that IS a solution. Let me think of an impossible one.\n    // 2 counters, 1 button affecting only counter 0, target [0, 1]\n    // Counter 1 can never be affected → no solution\n    const result = solveCounter([0, 1], [[0]], 5);\n    expect(result).toBeNull();\n  });\n\n  // ---- Prime mod with wrapping ----\n  it('handles wrap-around: press p-1 times', () => {\n    // 1 counter, modulus 5\n    // Button 0 affects counter 0\n    // Target: 4 (mod 5) = 4 presses\n    // Or press 0 times? No, 0 ≠ 4 mod 5\n    // Or... We need counter 0 to be 4. Pressing button 0 4 times gives 0→1→2→3→4.\n    // So result[0] = 4\n    const result = solveCounter([4], [[0]], 5);\n    expect(result).toEqual([4]);\n  });\n\n  it('minimum total presses across multiple solutions', () => {\n    // 2 counters, modulus 5\n    // Button 0: [0, 1]  — increments both\n    // Button 1: [1]      — increments counter 1 only\n    // Target: [1, 1]\n    // Option A: press button 0 once → [1, 1], total = 1\n    // Option B: press button 1 once → [0, 1] then we still need counter 0 at 1\n    //   B is impossible without button 0 or another button affecting counter 0\n    // So only option A: [1, 0]\n    const result = solveCounter([1, 1], [[0, 1], [1]], 5);\n    expect(result).toEqual([1, 0]);\n  });\n\n  it('minimum total presses: multiple valid solutions', () => {\n    // 1 counter, modulus 7\n    // Button 0: [0], Button 1: [0]\n    // Target: 2\n    // Option A: press button 0 twice → 2, total=2\n    // Option B: press button 1 twice → 2, total=2\n    // Option C: press button 0 once and button 1 once → 2, total=2\n    // All have total=2. Lexicographically smallest: [2, 0] < [1, 1] < [0, 2]\n    // Actually [2,0]: presses for [button0, button1] = 2 (mod 7) = 2 presses of button 0\n    // [1,1]: 1+1 = 2 mod 7 = target. Total = 1+1 = 2.\n    // [0,2]: 2 presses of button 1, total = 2.\n    // Lexicographically: [0, 2] vs [1, 1] vs [2, 0]\n    // At index 0: 0 < 1 < 2, so [0, 2] wins!\n    // Wait but is [0, 2] valid? Button 1 affects counter 0, pressing it 2 times = 2 mod 7. Yes.\n    const result = solveCounter([2], [[0], [0]], 7);\n    // Solutions with total=2: [2,0], [1,1], [0,2]\n    // Lexicographically smallest among equal total: [0,2]\n    const result = solveCounter([2], [[0], [0]], 7);\n    expect(result).toEqual([0, 2]);\n  });\n\n  it('lexicographic tie-breaking with equal cost', () => {\n    // 1 counter, modulus 5\n    // 3 buttons all affecting counter 0\n    // Target: 1\n    // Options: [1,0,0] (total=1), [0,1,0] (total=1), [0,0,1] (total=1)\n    // Lexicographically: [0,0,1] < [0,1,0] < [1,0,0]\n    // Actually wait: [0,0,1] at index 0: 0, [0,1,0] at index 0: 0, [1,0,0] at index 0: 1\n    // [0,0,1] vs [0,1,0]