---------------------\n// Types\n// ---------------------------------------------------------------------------\n\nexport interface Machine {\n  target: boolean[];\n  buttons: number[][];\n}\n\n// ---------------------------------------------------------------------------\n// Utilities\n// ---------------------------------------------------------------------------\n\n/** Lexicographic comparison between two sorted number arrays. */\nfunction lexLeq(a: number[], b: number[] | null): boolean {\n  if (b === null) return true;\n  const n = Math.min(a.length, b.length);\n  for (let i = 0; i < n; i++) {\n    if (a[i] !== b[i]) return a[i] < b[i];\n  }\n  return a.length <= b.length;\n}\n\n/** Merge two sorted arrays into one sorted array. */\nfunction mergeSorted(a: number[], b: number[]): number[] {\n  const r: number[] = [];\n  let i = 0, j = 0;\n  while (i < a.length && j < b.length) {\n    r.push(a[i] < b[j] ? a[i++] : b[j++]);\n  }\n  while (i < a.length) r.push(a[i++]);\n  while (j < b.length) r.push(b[j++]);\n  return r;\n}\n\n// ---------------------------------------------------------------------------\n// Part 1 — Toggle Puzzle  (GF(2) / XOR)\n// ---------------------------------------------------------------------------\n\nexport function solveToggle(machine: Machine): number[] | null {\n  const { target, buttons } = machine;\n  const M = buttons.length;\n  const N = target.length;\n\n  // Build bitmask for each button (up to 40 lights → BigInt)\n  const btnMasks: bigint[] = buttons.map(btn => {\n    let m = 0n;\n    for (const idx of btn) m |= 1n << BigInt(idx);\n    return m;\n  });\n\n  // Target bitmask\n  let tgtMask = 0n;\n  for (let i = 0; i < N; i++) if (target[i]) tgtMask |= 1n << BigInt(i);\n\n  // --------------------------------------------------\n  // Meet-in-the-middle\n  // --------------------------------------------------\n  const mid = M >>> 1;               // left size\n  const rightSize = M - mid;\n\n  // ---- left half: enumerate all subse