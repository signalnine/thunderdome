ghts off → 0 buttons pressed\n    const target = new Array(20).fill(false);\n    const buttons: number[][] = [];\n    for (let i = 0; i < 20; i++) buttons.push([i]);\n    for (let i = 0; i < 20; i++) {\n      const all = Array.from({ length: 20 }, (_, j) => j);\n      buttons.push(all);\n    }\n    const result = solveToggle({ target, buttons });\n    expect(result).toEqual([]);\n  });\n\n  it('40-button meet-in-the-middle stress test', () => {\n    // Create a matrix where we need to find a specific combination\n    // 5 lights, 40 buttons\n    // Each button toggles a subset\n    // Target: all on\n    // Create a known solution: press buttons 0, 10, 20, 30\n    // All other buttons are \"decoy\"\n    const target = new Array(5).fill(true);\n    const buttons: number[][] = [];\n    for (let i = 0; i < 40; i++) {\n      buttons.push([]);\n    }\n    // Button 0: toggles [0, 2]\n    buttons[0] = [0, 2];\n    // Button 10: toggles [1, 3]\n    buttons[10] = [1, 3];\n    // Button 20: toggles [2, 4]\n    buttons[20] = [2, 4];\n    // Button 30: toggles [0, 3, 4]\n    buttons[30] = [0, 3, 4];\n    // Add decoy buttons that toggle nothing\n    // Pressing 0,10,20,30:\n    // 0: [T,F,T,F,F]\n    // 10: [T,T,T,T,F]\n    // 20: [T,T,F,T,T]\n    // 30: [F,T,F,F,F] — wait that gives all off?\n    // Let me recalculate\n    // 0 -> [T,F,T,F,F]\n    // 10 -> [T,T,T,T,F] (XOR)\n    // 20 -> [T,T,F,F,T] (XOR, toggled index 2 which was on → off)\n    // 30 -> [F,T,F,T,F] (XOR toggled 0,3,4)\n    // Target is [T,T,T,T,T], this doesn't work.\n\n    // Let me just make a solvable system and verify\n    const target2 = [true, true, false, true, false];\n    const buttons2: number[][] = Array.from({ length: 40 }, () => []);\n    // The solution is [2, 3] (indices) which are buttons 2 and 3\n    // Check: target = [T, T, F, T, F]\n    // Button 2: toggles [0, 3]\n    buttons2[2] = [0, 3];\n    // Button 3: toggles [0, 1]\n    buttons2[3] = [0, 1];\n    // 2: [T,F,F,T,F]\n    // 3: [F,T,F,T,F] → wait\n    // After 2: [T,F,F,T,F]\n    // After 3: [F,T,F,F,F] — wrong\n    // Hmm. Let me try:\n    // Button 0: [0,3] -> need both 0 and 3\n    // Button 1: [0,1] -> toggles 0, need 0 off\n    // This gives [F,T,F,T,F] which is wrong too.\n\n    // OK let me just make a simpler solvable case\n    // 3 lights, target [T, T, F]\n    const target3 = [true, true, false];\n    const buttons3: number[][] = Array.from({ length: 40 }, () => []);\n    // Button 5: [0]\n    // Button 17: [1]\n    // Solution: press buttons 5 and 17\n    buttons3[5] = [0];\n    buttons3[17] = [1];\n    const result3 = solveToggle({ target: target3, buttons: buttons3 });\n    expect(result3).toEqual([5, 17]);\n  });\n\n  it('returns empty array when nothing needs to change', () => {\n    const result = solveToggle({\n      target: [false, false],\n      buttons: [\n        [0],\n        [1],\n        [0, 1],\n      ],\n    });\n    expect(result).toEqual([]);\n  });\n});\n\n// =========================================================================\n// Part 2 — Counter Puzzle\n// =========================================================================\n\ndescribe('solveCounter', () => {\n  // ---- Mod 2 toggle === GF(2) ----\n  it('works for mod 2 (same as toggle)', () => {\n    // 3 counters, target [1, 0, 1]\n    // Button 0: [0, 2]\n    // Button 1: [0, 1]\n    // Only button 0 → [1, 0, 1]\n    const result = solveCounter([1, 0, 1], [[0, 2], [0, 1], [1, 2]], 2);\n    expect(result).toEqual([1, 0, 0]);\n  });\n\n  // ---- Simple cases ----\n  it('simple: one button one counter', () => {\n    const result = solveCounter([1], [[0]], 5);\n    expect(result).toEqual([1]);\n  });\n\n  it('zero presses when all targets are 0', () => {\n    const result = solveCounter([0, 0, 0], [[0], [1], [2]], 7);\n    expect(result).toEqual([0, 0, 0]);\n  });\n\n  it('no solution: impossible target', () => {\n    // Button 0 affects counter 0, target is 1 mod 5\n    // But button 1 only affects count