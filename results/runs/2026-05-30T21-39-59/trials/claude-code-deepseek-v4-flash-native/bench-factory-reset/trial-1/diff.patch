+
+  // ---- Larger cases ----
+  it('40 counters, 40 buttons, mod 5 — unique solution', () => {
+    // Each button affects exactly one counter independently
+    // This should give a unique solution
+    const N = 40;
+    const buttons: number[][] = [];
+    const target: number[] = [];
+    for (let i = 0; i < N; i++) {
+      buttons.push([i]);
+      target.push(i % 5); // 0,1,2,3,4,0,1,...
+    }
+    const result = solveCounter(target, buttons, 5);
