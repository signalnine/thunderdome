et c = 0; c < M; c++) {\n166\t    if (!isPivot.has(c)) freeCols.push(c);\n167\t  }\n168\t\n169\t  const f = freeCols.length;\n170\t\n171\t  if (f === 0) {\n172\t    // Unique solution\n173\t    return sol;\n174\t  }\n175\t\n176\t  // ---- Build null-space matrix N (M × f) ----\n177\t  // N[i][k] = contribution of free variable k to variable i (mod p)\n178\t  const nullMat: number[][] = Array.from({ length: M }, () => new Array(f).fill(0));\n179\t  for (let k = 0; k < f; k++) {\n180\t    const freeIdx = freeCols[k];\n181\t    nullMat[freeIdx][k] = 1; // free variable itself\n182\t    // For each pivot row, compute the contribution\n183\t    for (let r = 0; r < rank; r++) {\n184\t      const pc = pivots[r];\n185\t      // In RREF, row r has: x_pc + sum_{free} A[r][free]*x_free = RHS[r]\n186\t      // So x_pc = RHS[r] - sum A[r][free]*x_free  (mod p)\n187\t      // Contribution of free variable freeIdx to x_pc: -rref[r][freeIdx]  (mod p)\n188\t      const coeff = rref[r][freeIdx];\n189\t      if (coeff !== 0) {\n190\t        nullMat[pc][k] = (p - coeff) % p; // -coeff mod p\n191\t      }\n192\t    }\n193\t  }\n194\t\n195\t  // ---- Minimize L1 norm over the affine subspace ----\n196\t  // We want to find t ∈ Z_p^f minimizing:\n197\t  //   cost(t) = Σ_i ( (sol[i] + Σ_k nullMat[i][k] * t[k]) mod p )\n198\t  // where t[k] = value assigned to the k-th free variable\n199\t\n200\t  const totalCombos = Math.pow(p, f);\n201\t\n202\t  // Threshold: enumerate when ≤ ~5 million\n203\t  const ENUM_THRESH = 5_000_000;\n204\t\n205\t  if (totalCombos <= ENUM_THRESH) {\n206\t    return enumerateSolutions(sol, nullMat, f, p);\n207\t  }\n208\t\n209\t  // ---- Fallback: meet-in-the-middle on free variables ----\n210\t  // Split free variables into two groups, enumerate each, then combine.\n211\t  // The cost is additive per component: cost(t₁,t₂) = Σᵢ f(solᵢ + v1ᵢ + v2ᵢ)\n212\t  // where v1 = N[:, group1]·t₁, v2 = N[:, group2]·t₂.\n213\t  // For each v2 candidate we look up all v1 that combine optimally.\n214\t  // To avoid O(p^f) iteration, we pre-group v1 results by a hash of the\n215\t  // full M-dimensional vector — but number of distinct vectors can be\n216\t  // as large as p^{f/2}. Instead we split by the STRUCTURE of the\n217\t  // modular wrap-around:\n218\t  //   cost = Σᵢ (solᵢ+v1ᵢ+v2ᵢ) - p·Σᵢ 𝟙(solᵢ+v1ᵢ+v2ᵢ ≥ p)\n219\t  //        = constᵢ + v1ᵢ + v2ᵢ - p·wrapᵢ\n220\t  // The wrap indicator couples v1 and v2; we CAN'T fully decouple.\n221\t  //\n222\t  // PRACTICAL FALLBACK: coordinate descent + multi-restart.\n223\t\n224\t  return localSearch(sol, nullMat, f, p);\n225\t}\n226\t\n227\t// ---------------------------------------------------------------------------\n228\t// Gaussian elimination over Z_p  (prime modulus)\n229\t// ---------------------------------------------------------------------------\n230\t\n231\tfunction gaussianElimination(\n232\t  mat: number[][],\n233\t  N: number,\n234\t  M: number,\n235\t  p: number,\n236\t): { rref: number[][]; pivots: number[]; rank: number } | null {\n237\t  // Work on a copy\n238\t  const a: number[][] = mat.map(row => [...row]);\n239\t  const pivots: number[] = [];\n240\t  let row = 0;\n241\t\n242\t  for (let col = 0; col < M && row < N; col++) {\n243\t    // Find pivot\n244\t    let pivotRow = -1;\n245\t    for (let r = row; r < N; r++) {\n246\t      if (a[r][col] !== 0) {\n247\t        pivotRow = r;\n248\t        break;\n249\t      }\n250\t    }\n251\t    if (pivotRow === -1) continue; // free variable\n252\t\n253\t    // Swap\n254\t    [a[row], a[pivotRow]] = [a[pivotRow], a[row]];\n255\t\n256\t    // Scale row to make pivot = 1\n257\t    const inv = modInv(a[row][col], p);\n258\t    for (let c = col; c <= M; c++) {\n259\t      a[row][c] = Number((BigInt(a[row][c]) * BigInt(inv)) % BigInt(p));\n260\t    }\n261\t\n262\t    // Eliminate all other rows\n263\t    for (let r = 0; r < N; r++) {\n264\t      if (r === row) continue;\n265\t      const factor = a[r][col];\n266\t      if (factor === 0) continue;\n267\t      for (let c = col; c <= M; c++) {\n268\t        a[r][c] = (a[r][c] - factor * a[row][c]) % p;\n269\t        if (a[r][c] < 0) a[r][c] += p;\n270\t      }\n271\t    }\n272\t\n273\t    pivots.push(col);\n274\t    row++;\n275\t  }\n276\t\n277\t  // Check consistency: all-zero rows must have RHS = 0\n278\t  for (let r = row; r < N; r++) {\n279\t    if (a[r][M] !== 0) return null; // inconsistent\n280\t  }\n281\t\n282\t  return { rref: a, pivots, rank: row };\n283\t}\n284\t\n285\t// ---------------------------------------------------------------------------\n286\t// Modular inverse (p is prime → Fermat)\n287\t// ---------------------------------------------------------------------------\n288\t\n289\tfunction modInv(a: number, p: number): number {\n290\t  // a^(p-2) mod p  (Fermat's little theorem, p prime)\n291\t  return Number(modPow(BigInt(a), BigInt(p - 2), BigInt(p)));\n292\t}\n293\t\n294\tfunction modPow(base: bigint, exp: bigint, mod: bigint): bigint {\n295\t  let result = 1n;\n296\t  let b = base % mod;\n297\t  let e = exp;\n298\t  while (e > 0n) {\n299\t    if (e & 1n) result = (result * b) % mod;\n300\t    b = (b * b) % mod;\n301\t    e >>= 1n;\n302\t  }\n303\t  return result;\n304\t}\n305\t\n306\t// ---------------------------------------------------------------------------\n307\t// Enumerate all solutions via free-variable assignment\n308\t// ---------------------------------------------------------------------------\n309\t\n310\tfunction enumerateSolutions(\n311\t  particular: number[],\n312\t  nullMat: number[][],\n313\t  f: number,\n314\t  p: number,\n315\t): number[] | null {\n316\t  const M = particular.length;\n317\t\n318\t  // Precompute the contribution vector for each free variable setting.\n319\t  // We'll store a flat array of all p^f possible configurations.\n320\t  // Index = free variable assignment encoded in base p.\n321\t\n322\t  const total = Math.pow(p, f);\n323\t  let bestCost = Infinity;\n324\t  let bestConfig: number[] | null = null;\n325\t\n326\t  // Enumerate all t ∈ Z_p^f\n327\t  // We use a \"carry\" approach to iterate through base-p counters\n328\t  const t: number[] = new Array(f).fill(0);\n329\t\n330\t  for (let idx = 0; idx < total; idx++) {\n331\t    // Compute the full solution x = particular + nullMat * t  (mod p)\n332\t    let cost = 0;\n333\t    const x: number[] = new Array(M);\n334\t    for (let i = 0; i < M; i++) {\n335\t      let val = particular[i];\n336\t      for (let k = 0; k < f; k++) {\n337\t        val = (val + nullMat[i][k] * t[k]) % p;\n338\t      }\n339\t      x[i] = val;\n340\t      cost += val;\n341\t    }\n342\t\n343\t    if (cost < bestCost || (cost === bestCost && lexLeq(x, bestConfig))) {\n344\t      bestCost = cost;\n345\t      bestConfig = x;\n346\t    }\n347\t\n348\t    // Increment t (base-p counter)\n349\t    if (idx + 1 < total) {\n350\t      for (let k = 0; k < f; k++) {\n351\t        t[k]++;\n352\t        if (t[k] < p) break;\n353\t        t[k] = 0; // carry\n354\t      }\n355\t    }\n356\t  }\n357\t\n358\t  return bestConfig;\n359\t}\n360\t\n361\t// ---------------------------------------------------------------------------\n362\t// Local search fallback  (coordinate descent + restarts)\n363\t// ---------------------------------------------------------------------------\n364\t\n365\tfunction localSearch(\n366\t  particular: number[],\n367\t  nullMat: number[][],\n368\t  f: number,\n369\t  p: number,\n370\t): number[] | null {\n371\t  const M = particular.length;\n372\t\n373\t  // Evaluate a configuration t (array of length f) → full solution + cost\n374\t  function evaluate(t: number[]): { x: number[]; cost: number } {\n375\t    const x: number[] = new Array(M);\n376\t    let cost = 0;\n377\t    for (let i = 0; i < M; i++) {\n378\t      let val = particular[i];\n379\t      for (let k = 0; k < f; k++) {\n380\t        val = (val + nullMat[i][k] * t[k]) % p;\n381\t      }\n382\t      x[i] = val;\n383\t      cost += val;\n384\t    }\n385\t    return { x, cost };\n386\t  }\n387\t\n388\t  // Start from the particular solution (all free vars = 0)\n389\t  let bestT = new Array(f).fill(0);\n390\t  let best = evaluate(bestT);\n391\t\n392\t  // Coordinate descent: try modifying one free variable at a time\n393\t  let improved = true;\n394\t  while (improved) {\n395\t    improved = false;\n396\t    for (let k = 0; k < f; k++) {\n397\t      const orig = bestT[k];\n398\t      for (let v = 0; v < p; v++) {\n399\t        if (v === orig) continue;\n400\t        bestT[k] = v;\n401\t        const cand = evaluate(bestT);\n402\t        if (cand.cost < best.cost ||\n403\t            (cand.cost === best.cost && lexLeq(cand.x, best.x))) {\n404\t          best = cand;\n405\t          improved = true;\n406\t        } else {\n407\t          bestT[k] = orig; // restore\n408\t        }\n409\t      }\n410\t      // Keep the best value for this variable\n411\t      if (improved) break;\n412\t    }\n413\t  }\n414\t\n415\t  // Multi-restart: try a few random starts\n416\t  for (let restart = 0; restart < 20; restart++) {\n417\t    const t = new Array(f).fill(0);\n418\t    for (let k = 0; k < f; k++) t[k] = Math.floor(Math.random() * p);\n419\t    const cand = evaluate(t);\n420\t\n421\t    // Coordinate descent from this start\n422\t    let localImproved = true;\n423\t    let localT = t;\n424\t    let localBest = cand;\n425\t    while (localImproved) {\n426\t      localImproved = false;\n427\t      for (let k = 0; k < f; k++) {\n428\t        const orig = localT[k];\n429\t        for (let v = 0; v < p; v++) {\n430\t          if (v === orig) continue;\n431\t          localT[k] = v;\n432\t          const c = evaluate(localT);\n433\t          if (c.cost < localBest.cost ||\n434\t              (c.cost === localBest.cost && lexLeq(c.x, localBest.x))) {\n435\t            localBest = c;\n436\t            localImproved = true;\n437\t          } else {\n438\t            localT[k] = orig;\n439\t          }\n440\t        }\n441\t        if (