 < b.length) r.push(b[j++]);\n  return r;\n}\n\n// ---------------------------------------------------------------------------\n// Part 1 — Toggle Puzzle  (GF(2) / XOR)\n// ---------------------------------------------------------------------------\n\nexport function solveToggle(machine: Machine): number[] | null {\n  const { target, buttons } = machine;\n  const M = buttons.length;\n  const N = target.length;\n\n  // Build bitmask for each button (up to 40 lights → BigInt)\n  const btnMasks: bigint[] = buttons.map(btn => {\n    let m = 0n;\n    for (const idx of btn) m |= 1n << BigInt(idx);\n    return m;\n  });\n\n  // Target bitmask\n  let tgtMask = 0n;\n  for (let i = 0; i < N; i++) if (target[i]) tgtMask |= 1n << BigInt(i);\n\n  // --------------------------------------------------\n  // Meet-in-the-middle\n  // --------------------------------------------------\n  const mid = M >>> 1;               // left size\n  const rightSize = M - mid;\n\n  // ---- left half: enumerate all subsets ----\n  const leftMap = new Map<bigint, { cnt: number; arr: number[] }>();\n  const leftLimit = 1 << mid;\n\n  for (let sub = 0; sub < leftLimit; sub++) {\n    let mask = 0n;\n    let cnt = 0;\n    const arr: number[] = [];\n    for (let i = 0; i < mid; i++) {\n      if (sub & (1 << i)) {\n        mask ^= btnMasks[i];\n        cnt++;\n        arr.push(i);\n      }\n    }\n    const prev = leftMap.get(mask);\n    if (!prev || cnt < prev.cnt || (cnt === prev.cnt && lexLeq(arr, prev.arr))) {\n      leftMap.set(mask, { cnt, arr });\n    }\n  }\n\n  // ---- right half: enumerate and combine ----\n  let bestCnt = Infinity;\n  let bestArr: number[] | null = null;\n  const rightLimit = 1 << rightSize;\n\n  for (let sub = 0; sub < rightLimit; sub++) {\n    let mask = 0n;\n    let cnt = 0;\n    const arr: number[] = [];\n    for (let i = 0; i < rightSize; i++) {\n      if (sub & (1 << i)) {\n        mask ^= btnMasks[mid + i];\n        cnt++;\n        arr.push(mid + i);\n      }\n    }\n    const need = tgtMask ^ mask;\n    const left = leftMap.get(need);\n    if (!left) continue;\n\n    const totalCnt = left.cnt + cnt;\n    if (totalCnt > bestCnt) continue;\n    const combined = mergeSorted(left.arr, arr);\n    if (totalCnt < bestCnt || lexLeq(combined, bestArr)) {\n      bestCnt = totalCnt;\n      bestArr = combined;\n    }\n  }\n\n  return bestArr;\n}\n\n// ---------------------------------------------------------------------------\n// Part 2 — Counter Puzzle  (Z_p  with prime modulus)\n// ---------------------------------------------------------------------------\n\nexport function solveCounter(\n  lights: number[],\n  buttons: number[][],\n  modulus: number,\n): number[] | null {\n  const N = lights.length;       // counters\n  const M = buttons.length;      // buttons\n  const p = modulus;\n\n  // ---- Build augmented matrix  N × (M+1) over Z_p ----\n  // mat[j][i] = 1 if button i toggles counter j\n  // mat[j][M] = target value for counter j\n  const mat: number[][] = Array.from({ length: N }, () => new Array(M + 1).fill(0));\n  for (let j = 0; j < N; j++) {\n    mat[j][M] = lights[j] % p;\n  }\n  for (let i = 0; i < M; i++) {\n    for (const j of buttons[i]) {\n      mat[j][i] = 1;\n    }\n  }\n\n  // ---- Gaussian elimination over Z_p ----\n  // Returns RREF matrix, pivot columns, rank, or null if inconsistent\n  const elim = gaussianElimination(mat, N, M, p);\n  if (elim === null) return null;\n  const { rref, pivots, rank } = elim;\n\n  // ---- Extract particular solution ----\n  // Free variables = 0, pivot variables = RHS\n  const sol: number[] = new Array(M).fill(0);\n  for (let r = 0; r < rank; r++) {\n    const c = pivots[r];\n    sol[c] = rref[r][M]; // already in [0, p-1]\n  }\n\n  // ---- Check for free variables ----\n  const freeCols: number[] = [];\n  const isPivot = new Set(pivots);\n  for (let c = 0; c < M; c++) {\n    if (!isPivot.has(c)) freeCols.push(c);\n  }\n\n  const f = freeCols.length;\n\n  if (f === 0) {\n    // Unique solution\n    return sol;\n  }\n\n  // ---- Build null-space matrix N (M × f) ----\n  // N[i][k] = contribution of free variable k to variable i (mod p)\n  const nullMat: number[][] = Array.from({ length: M }, () => new Array(f).fill(0));\n  for (let k = 0; k < f; k++) {\n    const freeIdx = freeCols[k];\n    nullMat[freeIdx][k] = 1; // free variable itself\n    // For each pivot row, compute the contribution\n    for (let r = 0; r < rank; r++) {\n      const pc = pivots[r];\n      // In RREF, row r has: x_pc + sum_{free} A[r][free]*x_free = RHS[r]\n      // So x_pc = RHS[r] - sum A[r][free]*x_free  (mod p)\n      // Contribution of free variable freeIdx to x_pc: -rref[r][freeIdx]  (mod p)\n      const coeff = rref[r][freeIdx];\n      if (coeff !== 0) {\n        nullMat[pc][k] = (p - coeff) % p; // -coeff mod p\n      }\n    }\n  }\n\n  // ---- Minimize L1 norm over the affine subspace ----\n  // We want to find t ∈ Z_p^f minimizing:\n  //   cost(t) = Σ_i ( (sol[i] + Σ_k nullMat[i][k] * t[k]) mod p )\n  // where t[k] = value assigned to the k-th free variable\n\n  const totalCombos = Math.pow(p, f);\n\n  // Threshold: enumerate when ≤ ~5 million\n  const ENUM_THRESH = 5_000_000;\n\n  if (totalCombos <= ENUM_THRESH) {\n    return enumerateSolutions(sol, nullMat, f, p);\n  }\n\n  // ---- Fallback: meet-in-the-middle on free variables ----\n  // Split free variables into two groups, enumerate each, then combine.\n  // The cost is additive per component: cost(t₁,t₂) = Σᵢ f(solᵢ + v1ᵢ + v2ᵢ)\n  // where v1 = N[:, group1]·t₁, v2 = N[:, group2]·t₂.\n  // For each v2 candidate we look up all v1 that combine optimally.\n  // To avoid O(p^f) iteration, we pre-group v1 results by a hash of the\n  // full M-dimensional vector — but number of distinct vectors can be\n  // as large as p^{f/2}. Instead we split by the STRUCTURE of the\n  // modular wrap-around:\n  //   cost = Σᵢ (solᵢ+v1ᵢ+v2ᵢ) - p·Σᵢ 𝟙(solᵢ+v1ᵢ+v2ᵢ ≥ p)\n  //        = constᵢ + v1ᵢ + v2ᵢ - p·wrapᵢ\n  // The wrap indicator couples v1 and v2; we CAN'T fully decouple.\n  //\n  // PRACTICAL FALLBACK: coordinate descent + multi-restart.\n\n  return localSearch(sol, nullMat, f, p);\n}\n\n// ---------------------------------------------------------------------------\n// Gaussian elimination over Z_p  (prime modulus)\n// ---------------------------------------------------------------------------\n\nfunction gaussianElimination(\n  mat: number[][],\n  N: number,\n  M: number,\n  p: number,\n): { rref: number[][]; pivots: number[]; rank: number } | null {\n  // Work on a copy\n  const a: number[][] = mat.map(row => [...row]);\n  const pivots: number[] = [];\n  let row = 0;\n\n  for (let col = 0; col < M && row < N; col++) {\n    // Find pivot\n    let pivotRow = -1;\n    for (let r = row; r < N; r++) {\n      if (a[r][col] !== 0) {\n        pivotRow = r;\n        break;\n      }\n    }\n    if (pivotRow === -1) continue; // free variable\n\n    // Swap\n    [a[row], a[pivotRow]] = [a[pivotRow], a[row]];\n\n    // Scale row to make pivot = 1\n    const inv = modInv(a[row][col], p);\n    for (let c = col; c <= M; c++) {\n      a[row][c] = Number((BigInt(a[row][c]) * BigInt(inv)) % BigInt(p));\n    }\n\n    // Eliminate all other rows\n    for (let r = 0; r < N; r++) {\n      if (r === row) continue;\n      const factor = a[r][col];\n      if (factor === 0) continue;\n      for (let c = col; c <= M; c++) {\n        a[r][c] = (a[r][c] - factor * a[row][c]) % p;\n        if (a[r][c] < 0) a[r][c] += p;\n      }\n    }\n\n    pivots.push(col);\n    row++;\n  }\n\n  // Check consistency: all-zero rows must have RHS = 0\n  for (let r = row; r < N; r++) {\n    if (a[r][M] !== 0) return null; // inconsistent\n  }\n\n  return { rref: a, pivots, rank: row };\n}\n\n// ---------------------------------------------------------------------------\n// Modular inverse (p is prime → Fermat)\n// ---------------------------------------------------------------------------\n\nfunction modInv(a: number, p: number): number {\n  // a^(p-2) mod p  (Fermat's little theorem, p prime)\n  return Number(modPow(BigInt(a), BigInt(p - 2), BigInt(p)));\n}\n\nfunction modPow(base: bigint, exp: bigint, mod: bigint): bigint {\n  let result = 1n;\n  let b = base % mod;\n  let e = exp;\n  while (e > 0n) {\n    if (e & 1n) result = (result * b) % mod;\n    b = (b * b) % mod;\n    e >>= 1n;\n  }\n  return result;\n}\n\n// ---------------------------------------------------------------------------\n// Enumerate all solutions via free-variable assignment\n// ---------------------------------------------------------------------------\n\nfunction enumerateSolutions(\n  particular: number[],\n  nullMat: number[][],\n  f: number,\n  p: number,\n): number[] | null {\n  const M = particular.length;\n\n  // Precompute the contribution vector for each free variable setting.\n  // We'll store a flat array of all p^f possible configurations.\n  // Index = free variable assignment encoded in base p.\n\n  const total = Math.pow(p, f);\n  let bestCost = Infinity;\n  let bestConfig: number[] | null = null;\n\n  // Enumerate all t ∈ Z_p^f\n  // We use a \"carry\" approach to iterate through base-p counters\n  const t: number[] = new Array(f).fill(0);\n\n  for (let idx = 0; idx < total; idx++) {\n    // Compute the full solution x = particular + nullMat * t  (mod p)\n    let cost = 0;\n    const x: number[] = new Array(M);\n    for (let i = 0; i < M; i++) {\n      let val = particular[i];\n      for (let k = 0; k < f; k++) {\n        val = (val + nullMat[i][k] * t[k]) % p;\n      }\n      x[i] = val;\n      cost += val;\n    }\n\n    if (cost < bestCost || (cost === bestCost && lexLeq(x, bestConfig))) {\n      bestCost = cost;\n      bestConfig = x;\n    }\n\n    // Increment t (base-p counter)\n    if (idx + 1 < total) {\n      for (let k = 0; k < f; k++) {\n        t[k]++;\n        if (t[k] < p) break;\n        t[k] = 0; // carry\n      }\n    }\n  }\n\n  return bestConfig;\n}\n\n// ---------------------------------------------------------------------------\n// Local search fallback  (coordinate descent + restarts)\n// ---------------------------------------------------------------------------\n\nfunction localSearch(\n  particular: number[],\n  nullMat: number[][],\n  f: number,\n  p: number,\n): number[] | null {\n  const M = particular.length;\n  const bestT: number[] = new Array(f).fill(0);\n\n  // Evaluate a configuration t (array of length f) → full solution + cost\n  function evaluate(t: number[]): { x: number[]; cost: number } {\n    const x: number[] = new Array(M);\n    let cost = 0;\n    for (let i = 0; i < M; i++) {\n      let val = particular[i];\n      for (let k = 0; k < f; k++) {\n        val = (val + nullMat[i][k] * t[k]) % p;\n      }\n      x[i] = val;\n      cost += val;\n    }\n    return { x, cost };\n  }\n\n  // Evaluate a single-variable change without modifying t\n  function evaluateDelta(t: number[], fixedK: number, fixedV: number): { x: number[]; cost: number } {\n    const x = new Array(M);\n    let cost = 0;\n    for (let i = 0; i < M; i++) {\n      let val = particular[i];\n      for (let k = 0; k < f; k++) {\n        val = (val + nullMat[i][k] * (k === fixedK ? fixedV : t[k])) % p;\n      }\n      x[i] = val;\n      cost += val;\n    }\n    return { x, cost };\n  }\n\n  // Coordinate descent from a starting configuration.\n  // Modifies `config` in place and returns the local optimum.\n  function descend(config: number[]): { x: number[]; cost: number } {\n    let best = evaluate(config);\n    let improved = true;\n    while (improved) {\n      improved = false;\n      for (let k = 0; k < f; k++) {\n        const orig = config[k];\n        let bestK = orig;\n        let bestKResult = best;\n        // For each possible value of this free variable\n        for (let v = 0; v < p; v++) {\n          if (v === orig) continue;\n          const cand = evaluateDelta(config, k, v);\n          if (cand.cost < bestKResult.cost ||\n              (cand.cost === bestKResult.cost && lexLeq(cand.x, bestKResult.x))) {\n            bestKResult = cand;\n            bestK = v;\n          }\n        }\n        if (bestK !== orig) {\n          // Apply the best value and restart scan\n          config[k] = bestK;\n          best = bestKResult;\n          improved = true;\n          break;\n        }\n      }\n    }\n    return best;\n  }\n\n  // Start from the particular solution (all free vars = 0)\n  let best = descend(bestT);\n\n  // Multi-restart: try a few random starts\n  for (let restart = 0; restart < 20; restart++) {\n    const t = new Array(f).fill(0);\n    for (let k = 0; k < f; k++) t[k] = Math.floor(Math.random() * p);\n    const local = descend(t);\n    if (local.cost < best.cost ||\n        (local.cost === best.cost && lexLeq(local.x, best.x))) {\n      best = local;\n    }\n  }\n\n  return best.x;\n}\n","numLines":453,"startLine":1,"totalLines":453}}}
