et c = 0; c < M; c++) {\n166\t    if (!isPivot.has(c)) freeCols.push(c);\n167\t  }\n168\t\n169\t  const f = freeCols.length;\n170\t\n171\t  if (f === 0) {\n172\t    // Unique solution\n173\t    return sol;\n174\t  }\n175\t\n176\t  // ---- Build null-space matrix N (M × f) ----\n177\t  // N[i][k] = contribution of free variable k to variable i (mod p)\n178\t  const nullMat: number[][] = Array.from({ length: M }, () => new Array(f).fill(0));\n179\t  for (let k = 0; k < f; k++) {\n180\t    const freeIdx = freeCols[k];\n181\t    nullMat[freeIdx][k] = 1; // free variable itself\n182\t    // For each pivot row, compute the contribution\n183\t    for (let r = 0; r < rank; r++) {\n184\t      const pc = pivots[r];\n185\t      // In RREF, row r has: x_pc + sum_{free} A[r][free]*x_free = RHS[r]\n186\t      // So x_pc = RHS[r] - sum A[r][free]*x_free  (mod p)\n187\t      // Contribution of free variable freeIdx to x_pc: -rref[r][freeIdx]  (mod p)\n188\t      const coeff = rref[r][freeIdx];\n189\t      if (coeff !== 0) {\n190\t        nullMat[pc][k] = (p - coeff) % p; // -coeff mod p\n191\t      }\n192\t    }\n193\t  }\n194\t\n195\t  // ---- Minimize L1 norm over the affine subspace ----\n196\t  // We want to find t ∈ Z_p^f minimizing:\n197\t  //   cost(t) = Σ_i ( (sol[i] + Σ_k nullMat[i][k] * t[k]) mod p )\n198\t  // where t[k] = value assigned to the k-th free variable\n199\t\n200\t  const totalCombos = Math.pow(p, f);\n201\t\n202\t  // Threshold: enumerate when ≤ ~5 million\n203\t  const ENUM_THRESH = 5_000_000;\n204\t\n205\t  if (totalCombos <= ENUM_THRESH) {\n206\t    return enumerateSolutions(sol, nullMat, f, p);\n207\t  }\n208\t\n209\t  // ---- Fallback: meet-in-the-middle on free variables ----\n210\t  // Split free variables into two groups, enumerate each, then combine.\n211\t  // The cost is additive per component: cost(t₁,t₂) = Σᵢ f(solᵢ + v1ᵢ + v2ᵢ)\n212\t  // where v1 = N[:, group1]·t₁, v2 = N[:, group2]·t₂.\n213\t  // For each v2 candidate we look up all v1 that combine optimally.\n214\t  // To avoid O(p^f) iteration, we pre-group v1 results by a hash of the\n215\t  // full M-dimensional vector — but number of distinct vectors can be\n216\t  // as large as p^{f/2}. Instead we split by the STRUCTURE of the\n217\t  // modular wrap-around:\n218\t  //   cost = Σᵢ (solᵢ+v1ᵢ+v2ᵢ) - p·Σᵢ 𝟙(solᵢ+v1ᵢ+v2ᵢ ≥ p)\n219\t  //        = constᵢ + v1ᵢ + v2ᵢ - p·wrapᵢ\n220\t  // The wrap indicator couples v1 and v2; we CAN'T fully decouple.\n221\t  //\n222\t  // PRACTICAL FALLBACK: coordinate descent + multi-restart.\n223\t\n224\t  return localSearch(sol, nullMat, f, p);\n225\t}\n226\t\n227\t// ---------------------------------------------------------------------------\n228\t// Gaussian elimination over Z_p  (prime modulus)\n229\t// ---------------------------------------------------------------------------\n230\t\n231\tfunction gaussianElimination(\n232\t  mat: number[][],\n233\t  N: number,\n234\t  M: number,\n235\t  p: number,\n236\t): { rref: number[][]; pivots: number[]; rank: number } | null {\n237\t  // Work on a copy\n238\t  const a: number[][] = mat.map(row => [...row]);\n239\t  const pivots: number[] = [];\n240\t  let row = 0;\n241\t\n242\t  for (let col = 0; col < M && row < N; col++) {\n243\t    // Find pivot\n244\t    let pivotRow = -1;\n245\t    for (let r = row; r < N; r++) {\n246\t      if (a[r][col] !== 0) {\n247\t        pivotRow = r;\n248\t        break;\n249\t      }\n250\t    }\n251\t    if (pivotRow === -1) continue; // free variable\n252\t\n253\t    // Swap\n254\t    [a[row], a[pivotRow]] = [a[pivotRow], a[row]];\n255\t\n256\t    // Scale row to make pivot = 1\n257\t    const inv = modInv(a[row][col], p);\n258\t    for (let c = col; c <= M; c++) {\n259\t      a[row][c] = Number((BigInt(a[row][c]) * BigInt(inv)) % BigInt(p));\n260\t    }\n261\t\n262\t    // Eliminate all other rows\n263\t    for (let r = 0; r < N; r++) {\n264\t      if (r === row) continue;\n265\t      const factor = a[r][col];\n266\t      if (factor === 0