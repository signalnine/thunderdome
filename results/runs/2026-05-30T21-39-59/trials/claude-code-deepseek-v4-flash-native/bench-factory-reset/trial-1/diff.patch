 const N = target.length;\n51\t\n52\t  // Build bitmask for each button (up to 40 lights → BigInt)\n53\t  const btnMasks: bigint[] = buttons.map(btn => {\n54\t    let m = 0n;\n55\t    for (const idx of btn) m |= 1n << BigInt(idx);\n56\t    return m;\n57\t  });\n58\t\n59\t  // Target bitmask\n60\t  let tgtMask = 0n;\n61\t  for (let i = 0; i < N; i++) if (target[i]) tgtMask |= 1n << BigInt(i);\n62\t\n63\t  // --------------------------------------------------\n64\t  // Meet-in-the-middle\n65\t  // --------------------------------------------------\n66\t  const mid = M >>> 1;               // left size\n67\t  const rightSize = M - mid;\n68\t\n69\t  // ---- left half: enumerate all subsets ----\n70\t  const leftMap = new Map<bigint, { cnt: number; arr: number[] }>();\n71\t  const leftLimit = 1 << mid;\n72\t\n73\t  for (let sub = 0; sub < leftLimit; sub++) {\n74\t    let mask = 0n;\n75\t    let cnt = 0;\n76\t    const arr: number[] = [];\n77\t    for (let i = 0; i < mid; i++) {\n78\t      if (sub & (1 << i)) {\n79\t        mask ^= btnMasks[i];\n80\t        cnt++;\n81\t        arr.push(i);\n82\t      }\n83\t    }\n84\t    const prev = leftMap.get(mask);\n85\t    if (!prev || cnt < prev.cnt || (cnt === prev.cnt && lexLeq(arr, prev.arr))) {\n86\t      leftMap.set(mask, { cnt, arr });\n87\t    }\n88\t  }\n89\t\n90\t  // ---- right half: enumerate and combine ----\n91\t  let bestCnt = Infinity;\n92\t  let bestArr: number[] | null = null;\n93\t  const rightLimit = 1 << rightSize;\n94\t\n95\t  for (let sub = 0; sub < rightLimit; sub++) {\n96\t    let mask = 0n;\n97\t    let cnt = 0;\n98\t    const arr: number[] = [];\n99\t    for (let i = 0; i < rightSize; i++) {\n100\t      if (sub & (1 << i)) {\n101\t        mask ^= btnMasks[mid + i];\n102\t        cnt++;\n103\t        arr.push(mid + i);\n104\t      }\n105\t    }\n106\t    const need = tgtMask ^ mask;\n107\t    const left = leftMap.get(need);\n108\t    if (!left) continue;\n109\t\n110\t    const totalCnt = left.cnt + cnt;\n11