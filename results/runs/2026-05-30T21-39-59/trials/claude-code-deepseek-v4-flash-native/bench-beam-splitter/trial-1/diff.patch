+/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ *
+ * Exports countBeamCells (distinct visited cells) and
+ * countBeamPaths (total source-to-exit paths).
+ *
+ * Strategy: beams only move downward (row+1 each step), so we process
+ * the grid row-by-row using DP. For each cell we track how many beam
+ * paths arrive in each of three directions (down, down-left, down-right).
+ * Splitters sum all incoming directions and produce two diagonal outputs.
+ * This avoids enumerating the exponential number of individual paths.
+ */
+
+type DirCounts = [bigint, bigint, bigint];
+
+/** Shared propagation engine. Returns visited cells and total path count. */
+function propagate(
+  grid: string[][],
+): { visited: ReadonlySet<string>; totalPaths: bigint } {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  const visited = new Set<string>();
+
+  // Locate the source cell (always on the top row).
+  let sourceCol = -1;
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') {
+      sourceCol = c;
+      break;
+    }
+  }
+  if (sourceCol === -1) {
+    return { visited, totalPaths: 0n };
+  }
+
+  visited.add(`0,${sourceCol}`);
+
+  // The source emits a beam straight down.  If there is no row below,
+  // the beam exits immediately.
+  if (rows === 1) {
+    return { visited, totalPaths: 1n };
+  }
+
+  // nextInput[col][dir] – number of beam paths entering the *next* row
+  // at (row, col) travelling in direction `dir`.
+  let nextInput: DirCounts[] = Array.from({ length: cols }, () => [0n, 0n, 0n]);
+  nextInput[sourceCol][0] = 1n; // source → row 1, same col, going down
+
+  let totalPaths = 0n;
+
+  // Process rows 1 … rows-1 (row 0 has no incoming beams from above).
+  for (let r = 1; r < rows; r++) {
+    const current = nextInput;
+    nextInput = Array.from({ length: cols }, () => [0n, 0n, 0n]);
+
+    for (let c = 0; c < cols; c++) {
+      const [down, downleft, downright] = current[c];
+      const total = down + downleft + downright;
+
+      if (total > 0n) {
+        visited.add(`${r},${c}`);
+      }
+
+      if (grid[r][c] === '^' && total > 0n) {
+        // ── Splitter ──────────────────────────────────────────
+        // All directions merge, then split into two diagonals.
+        // Down-left beam
+        if (c > 0 && r + 1 < rows) {
+          nextInput[c - 1][1] += total;
+        } else {
+          totalPaths += total;
+        }
+        // Down-right beam
+        if (c + 1 < cols && r + 1 < rows) {
+          nextInput[c + 1][2] += total;
+        } else {
+          totalPaths += total;
+        }
+      } else {
+        // ── Empty cell (or source on a non-top row, which we treat as empty) ──
+        // Beam continues in its original direction.
+        if (down > 0n) {
+          if (r + 1 < rows) {
+            nextInput[c][0] += down;
+          } else {
+            totalPaths += down;
+          }
+        }
+        if (downleft > 0n) {
+          if (c > 0 && r + 1 < rows) {
+            nextInput[c - 1][1] += downleft;
+          } else {
+            totalPaths += downleft;
+          }
+        }
+        if (downright > 0n) {
+          if (c + 1 < cols && r + 1 < rows) {
+            nextInput[c + 1][2] += downright;
+          } else {
+            totalPaths += downright;
+          }
+        }
+      }
+    }
+  }
+
+  return { visited, totalPaths };
+}
+
+// ── Exported API ────────────────────────────────────────────────────────
+
+/** Count distinct cells visited by any beam. */
+export function countBeamCells(grid: string[][]): number {
+  const { visited } = propagate(grid);
+  return visited.size;
+}
+
+/** Count total distinct source-to-exit paths (as a bigint). */
+export function countBeamPaths(grid: string[][]): bigint {
+  const { totalPaths } = propagate(grid);
+  return totalPaths;
+}
