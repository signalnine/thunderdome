@@ -0,0 +1,130 @@
+type Direction = 'down' | 'down-left' | 'down-right';
+
+const DELTA: Record<Direction, [number, number]> = {
+  down: [1, 0],
+  'down-left': [1, -1],
+  'down-right': [1, 1],
+};
+
+const DIR_INDEX: Record<Direction, number> = {
+  down: 0,
+  'down-left': 1,
+  'down-right': 2,
+};
+
+function findSource(grid: string[][]): number {
+  const cols = grid[0].length;
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') return c;
+  }
+  return -1;
+}
+
+/**
+ * Count the number of distinct cells visited by any beam.
+ * The source cell 'S' counts as visited. Splitter cells hit by beams count as visited.
+ * A cell counts once even if multiple beams pass through it.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+
+  const srcCol = findSource(grid);
+  if (srcCol < 0) return 0;
+
+  // Track visited cells with a 2D boolean array for O(1) lookups
+  const visited: boolean[][] = [];
+  for (let r = 0; r < rows; r++) {
+    visited.push(new Array(cols).fill(false));
+  }
+
+  visited[0][srcCol] = true;
+  let cellCount = 1;
+
+  // Index-based queue for O(1) dequeue
+  const queue: Array<[number, number, Direction]> = [[0, srcCol, 'down']];
+  let head = 0;
+
+  while (head < queue.length) {
+    const [row, col, dir] = queue[head++];
+    const [dr, dc] = DELTA[dir];
+    const nr = row + dr;
+    const nc = col + dc;
+
+    // Beam exits the grid — absorbed
+    if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) continue;
+
+    // Mark the cell we just entered
+    if (!visited[nr][nc]) {
+      visited[nr][nc] = true;
+      cellCount++;
+    }
+
+    if (grid[nr][nc] === '^') {
+      // Splitter: spawn both diagonal beams
+      queue.push([nr, nc, 'down-left']);
+      queue.push([nr, nc, 'down-right']);
+    } else {
+      // Continue in the same direction
+      queue.push([nr, nc, dir]);
+    }
+  }
+
+  return cellCount;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths through the grid.
+ * Uses DP with memoization — the grid is a DAG (row always increases),
+ * so no cycles are possible.
+ *
+ * With K splitters along a beam's path there are potentially 2^K paths,
+ * so enumerating individual paths is not feasible.  DP computes the sum
+ * directly in O(rows * cols * 3) time.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+
+  const srcCol = findSource(grid);
+  if (srcCol < 0) return 0n;
+
+  // Memoization table: memo[row][col][dirIndex] = cached bigint | undefined
+  const memo: (bigint | undefined)[][][] = [];
+  for (let r = 0; r < rows; r++) {
+    const rowMemo: (bigint | undefined)[][] = [];
+    for (let c = 0; c < cols; c++) {
+      rowMemo.push([undefined, undefined, undefined]);
+    }
+    memo.push(rowMemo);
+  }
+
+  function dfs(row: number, col: number, dir: Direction): bigint {
+    const [dr, dc] = DELTA[dir];
+    const nr = row + dr;
+    const nc = col + dc;
+
+    // Beam exits the grid — this path ends here
+    if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) return 1n;
+
+    // If we've already computed the number of paths from the next state, use it
+    const cached = memo[nr][nc][DIR_INDEX[dir]];
+    if (cached !== undefined) return cached;
+
+    let result: bigint;
+    if (grid[nr][nc] === '^') {
+      // Splitter: the beam splits into two diagonal directions
+      result = dfs(nr, nc, 'down-left') + dfs(nr, nc, 'down-right');
+    } else {
+      // Continue in the same direction
+      result = dfs(nr, nc, dir);
+    }
+
+    memo[nr][nc][DIR_INDEX[dir]] = result;
+    return result;
+  }
+
+  return dfs(0, srcCol, 'down');
+}
