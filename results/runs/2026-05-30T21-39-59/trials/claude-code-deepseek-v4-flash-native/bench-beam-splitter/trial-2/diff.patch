+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from './index.js';
+
+describe('countBeamCells', () => {
+  it('example 1: single splitter', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(5);
+  });
+
+  it('example 2: two splitters', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('1xN grid with just source', () => {
+    const grid = [['S', '.', '.']];
+    expect(countBeamCells(grid)).toBe(1);
+  });
+
+  it('R1 grid with source only, no splitters', () => {
+    const grid = [['S'], ['.'], ['.']];
+    expect(countBeamCells(grid)).toBe(3);
+  });
+
+  it('no splitters — straight line', () => {
+    const grid = [
+      ['.', 'S', '.'],
+      ['.', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(3);
+  });
+
+  it('splitter on bottom row — exit out of bounds', () => {
+    const grid = [
+      ['.', 'S', '.'],
+      ['.', '.', '.'],
+      ['.', '^', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(3);
+  });
+
+  it('converging beams count once', () => {
+    const grid = [
+      ['.', '.', 'S', '.', '.'],
+      ['.', '.', '^', '.', '.'],
+      ['.', '^', '.', '^', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(7);
+  });
+
+  it('splitter hit by multiple beams after convergence', () => {
+    const grid = [
+      ['.', '.', 'S', '.', '.'],
+      ['.', '.', '^', '.', '.'],
+      ['.', '^', '.', '^', '.'],
+      ['.', '^', '.', '.', '.'],
+    ];
+    // Source (0,2)
+    // (1,2) splitter -> DL (2,1) splitter, DR (2,3) splitter
+    // (2,1) splitter -> DL (3,0) splitter, DR (3,2)
+    // (2,3) splitter -> DL (3,2), DR (3,4)
+    // (3,0) splitter -> DL (4,-1) exit, DR (4,1) out of bounds
+    // (3,2) is '.' — both paths continue: (4,1) and (4,3) both out of bounds
+    // (3,4) -> (4,5) out of bounds
+    // Only in-bounds cells: (0,2), (1,2), (2,1), (2,3), (3,0), (3,2), (3,4)
+    expect(countBeamCells(grid)).toBe(7);
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('example 1: single splitter gives 2 paths', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('example 2: two splitters give 4 paths', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('no splitter gives 1 path', () => {
+    const grid = [
+      ['.', 'S', '.'],
+      ['.', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('1xN grid — immediate exit gives 1 path', () => {
+    const grid = [['S', '.', '.']];
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('Rx1 grid with splitter gives 2 paths', () => {
+    const grid = [['S'], ['.'], ['^'], ['.']];
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('two splitters in cascade gives 3 paths', () => {
+    // Splitter at (1,1): DR beam hits splitter at (2,2) which splits again
+    const grid = [
+      ['.', 'S', '.', '.'],
+      ['.', '^', '.', '.'],
+      ['.', '.', '^', '.'],
+      ['.', '.', '.', '.'],
+      ['.', '.', '.', '.'],
+    ];
+    // Source (0,1) -> (1,1)=splitter
+    //   DL: (2,0) -> (3,-1) exit = 1 path
+    //   DR: (2,2)=splitter -> DL(3,1)->(4,0)->(5,-1) exit, DR(3,3)->(4,3) exit
+    //   = 1 + 1 = 2 paths
+    // Total = 3
+    expect(countBeamPaths(grid)).toBe(3n);
+  });
+
+  it('large branching with convergent paths — DP correct', () => {
+    // Create a pattern where beams from different splits converge
+    // Row 0: . . S . .
+    // Row 1: . . ^ . .
+    // Row 2: . ^ . ^ .
+    // Row 3: . . ^ . .
+    // Row 4: . . . . .
+    const grid = [
+      ['.', '.', 'S', '.', '.'],
+      ['.', '.', '^', '.', '.'],
+      ['.', '^', '.', '^', '.'],
+      ['.', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    // Source (0,2) -> (1,2)=splitter
+    //   DL: (2,1)=splitter
+    //     DL: (3,0) continue -> exit at (4,-1)
+    //     DR: (3,2)=splitter!
+    //       DL: (4,1) exit
+    //       DR: (4,3) exit
+    //   DR: (2,3)=splitter
+    //     DL: (3,2)=splitter (same as above!)
+    //       DL: (4,1) exit (same as above)
+    //       DR: (4,3) exit (same as above)
+    //     DR: (3,4) continue -> exit at (4,4)
+    //
+    // From (3,2) splitter: both DL and DR beams exit
+    // Total paths:
+    // (0,2)->(1,2): 2 paths going into splitter (well, 1 initial)
+    // From (1,2) splitter:
+    //   - DL path: (2,1) -> split: [DL:(3,0)->exit] + [DR:(3,2)->split: [DL:(4,1)->exit, DR:(4,3)->exit]]
+    //     = 1 + 2 = 3
+    //   - DR path: (2,3) -> split: [DL:(3,2)->split: 2 paths] + [DR:(3,4)->exit]
+    //     = 2 + 1 = 3
+    // Total = 3 + 3 = 6
+    expect(countBeamPaths(grid)).toBe(6n);
+  });
+});
+
+describe('edge cases', () => {
+  it('empty grid returns 0', () => {
+    expect(countBeamCells([])).toBe(0);
+    expect(countBeamPaths([])).toBe(0n);
+  });
+
+  it('source at top, no rows below exits immediately', () => {
+    const grid = [['S']];
+    expect(countBeamCells(grid)).toBe(1);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('multiple splitters in same column', () => {
+    const grid = [
+      ['.', 'S', '.'],
+      ['.', '^', '.'],
+      ['.', '.', '.'],
+      ['.', '^', '.'],
+    ];
+    // Source (0,1) -> (1,1)=splitter
+    //   DL: (2,0) -> (3,-1) exit
+    //   DR: (2,2) -> (3,3)... wait, (3,2) -> (3,2) is not '^', continue
+    // Actually, beam at (2,2) going DR goes to (3,3) which is out of bounds for 4x3 grid
+    // Let me reconsider
+    // DL from (1,1): (2,0) -> (3,-1) exit = 1 path
+    // DR from (1,1): (2,2) -> (3,3) out of bounds for 4x3 (col 3 >= 3) = 1 path
+    // Wait, (3, 1) is the cell at row 3, col 1. Is it '^'? Let me check.
+    // grid[3][1] is '^'! But the beam is at (2, 2) going DR, it goes to (3, 3), not (3, 1).
+    // So (3, 3) is out of bounds = 1 path.
+    // Total = 2 paths.
+    expect(countBeamPaths(grid)).toBe(2n);
+    // Cells: (0,1), (1,1), (2,0), (2,2) = 4
+    // (3,1) is a splitter but it's not reached by any beam (DL goes to (2,0), DR goes to (2,2))
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('splitter with beam arriving diagonally', () => {
+    // A beam going DL enters a splitter — it should split regardless
+    const grid = [
+      ['.', '.', 'S', '.', '.'],
+      ['.', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    // Source (0,2) -> (1,2)=splitter
+    //   DL: (2,1) -> (3,0) -> (4,-1) exit
+    //   DR: (2,3) -> (3,4) -> (4,5) exit
+    // (3,1) is a '^' but never reached by any beam
+    // Visited cells: (0,2), (1,2), (2,1), (2,3), (3,0), (3,4) = 6
+    expect(countBeamPaths(grid)).toBe(2n);
+    expect(countBeamCells(grid)).toBe(6);
+  });
+});
