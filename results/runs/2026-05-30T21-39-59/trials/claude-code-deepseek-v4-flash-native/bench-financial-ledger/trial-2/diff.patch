te) continue;\n      if (endDate && entry.date > endDate) continue;\n\n      for (const c of entry.credits) {\n        const acct = this.accounts.get(c.account);\n        if (acct?.type === 'revenue') revenue += c.amount;\n      }\n\n      for (const d of entry.debits) {\n        const acct = this.accounts.get(d.account);\n        if (acct?.type === 'expense') expenses += d.amount;\n      }\n    }\n\n    return {\n      revenue,\n      expenses,\n      netIncome: revenue - expenses,\n    };\n  }\n}\n","structuredPatch":[{"oldStart":115,"oldLines":17,"newStart":115,"newLines":20,"lines":["     const account = this.accounts.get(accountName);","     if (!account) throw new Error(`Account not found: ${accountName}`);"," ","-    let balance = 0;","+    let debitTotal = 0;","+    let creditTotal = 0;","     for (const entry of this.entries) {","       for (const d of entry.debits) {","-        if (d.account === accountName) balance += d.amount;","+        if (d.account === accountName) debitTotal += d.amount;","       }","       for (const c of entry.credits) {","-        if (c.account === accountName) balance -= c.amount;","+        if (c.account === accountName) creditTotal += c.amount;","       }","     }"," ","-    return balance;","+    // Assets and expenses have debit-normal balances; liabilities, equity, and revenue have credit-normal balances","+    const debitNormal = account.type === 'asset' || account.type === 'expense';","+    return debitNormal ? debitTotal - creditTotal : creditTotal - debitTotal;","   }"," ","   getTrialBalance(): BalanceEntry[] {"]}],"userModified":false,"replaceAll":false}}
