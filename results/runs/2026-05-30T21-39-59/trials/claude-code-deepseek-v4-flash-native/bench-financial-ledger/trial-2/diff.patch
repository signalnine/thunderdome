try.debits) {\n        const acct = this.accounts.get(d.account);\n        if (acct?.type === 'expense') expenses += d.amount;\n      }\n    }\n\n    return {\n      revenue,\n      expenses,\n      netIncome: revenue + expenses,\n    };\n  }\n}\n","structuredPatch":[{"oldStart":75,"oldLines":6,"newStart":75,"newLines":18,"lines":["       }","     }"," ","+    // Validate all accounts share the same currency","+    const currencies = new Set<string>();","+    for (const d of debits) {","+      currencies.add(this.accounts.get(d.account)!.currency);","+    }","+    for (const c of credits) {","+      currencies.add(this.accounts.get(c.account)!.currency);","+    }","+    if (currencies.size > 1) {","+      throw new Error('All accounts in an entry must share the same currency');","+    }","+","     const totalDebits = debits.reduce((sum, d) => sum + d.amount, 0);","     const totalCredits = credits.reduce((sum, c) => sum + c.amount, 0);","     if (totalDebits !== totalCredits) {"]}],"userModified":false,"replaceAll":false}}
