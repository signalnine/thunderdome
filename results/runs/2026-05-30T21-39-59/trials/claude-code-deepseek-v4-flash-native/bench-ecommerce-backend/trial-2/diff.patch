nts.push(p); });\n\n    catalog.createProduct('Test', 10, 'test');\n    await drainMicrotasks();\n    expect(events).toHaveLength(1);\n  });\n\n  it('Inventory: stock management, reserve, release, low stock alerts', async () => {\n    const { bus, inventory } = createSystem();\n    const lowStockEvents: unknown[] = [];\n    bus.on(Events.LOW_STOCK_ALERT, (p: unknown) => { lowStockEvents.push(p); });\n\n    inventory.setStock('prod-1', 10);\n    expect(inventory.getStock('prod-1')).toBe(10);\n\n    inventory.setLowStockThreshold('prod-1', 5);\n    await drainMicrotasks();\n    // setting threshold should trigger check, 10 > 5 so no alert\n    expect(lowStockEvents).toHaveLength(0);\n\n    expect(inventory.reserve('prod-1', 3)).toBe(true);\n    expect(inventory.getStock('prod-1')).toBe(7);\n\n    expect(inventory.reserve('prod-1', 20)).toBe(false);\n    expect(inventory.getStock('prod-1')).toBe(7);\n\n    inventory.release('prod-1', 2);\n    expect(inventory.getStock('prod-1')).toBe(9);\n\n    // Low stock alert when total drops to threshold\n    inventory.setStock('prod-1', 5);\n    await drainMicrotasks();\n    expect(lowStockEvents.length).toBeGreaterThanOrEqual(1);\n  });\n\n  it('Cart: create, add, remove, update, clear, consolidate', async () => {\n    const { cart, bus } = createSystem();\n    const cartEvents: unknown[] = [];\n    bus.on(Events.CART_UPDATED, (p: unknown) => { cartEvents.push(p); });\n\n    const cid = cart.createCart('user-1');\n    expect(cid).toBeDefined();\n\n    cart.addItem(cid, 'prod-1', 2);\n    cart.addItem(cid, 'prod-2', 1);\n    expect(cart.getCart(cid)!.items).toHaveLength(2);\n\n    // Consolidation: adding same product should increase quantity\n    cart.addItem(cid, 'prod-1', 3);\n    const items = cart.getCart(cid)!.items;\n    expect(items).toHaveLength(2);\n    expect(items.find(i => i.productId === 'prod-1')!.quantity).toBe(5);\n\n    cart.updateQuantity(cid, 'prod-1', 1);\n    expect(cart.getCart(cid)!.items.find(i => i.productId === 'prod-1')!.quantity).toBe(1);\n\n    cart.removeItem(cid, 'prod-2');\n    expect(cart.getCart(cid)!.items).toHaveLength(1);\n\n    await drainMicrotasks();\n    expect(cartEvents.length).toBeGreaterThanOrEqual(4);\n\n    // Non-existent cart - should be no-op\n    cart.addItem('fake-cart', 'prod-1', 1);\n    expect(cart.getCart('fake-cart')).toBeNull();\n\n    // Clear\n    cart.clearCart(cid);\n    expect(cart.getCart(cid)!.items).toHaveLength(0);\n  });\n\n  it('Pricing: total calculation with tax and discounts', () => {\n    const { pricing, catalog } = createSystem();\n    catalog.createProduct('Widget', 29.99, 'gadgets');\n\n    const items = [\n      { productId: 'p1', quantity: 2, price: 29.99 },\n      { productId: 'p2', quantity: 1, price: 49.99 },\n    ];\n\n    // No discount\n    const result = pricing.calculateTotal(items);\n    expect(result.subtotal).toBe(109.97);\n    expect(result.discount).toBe(0);\n    expect(result.tax).toBeCloseTo(11.0, 1);\n    expect(Math.abs(result.total - (result.subtotal + result.tax))).toBeLessThan(0.01);\n\n    // With discount\n    pricing.addDiscountCode('SAVE10', 10);\n    const result2 = pricing.calculateTotal(items, 'SAVE10');\n    expect(result2.discount).toBeGreaterThan(0);\n    expect(result2.subtotal).toBe(109.97);\n    expect(result2.total).toBeLessThan(result.total);\n\n    // Unknown discount code\n    const result3 = pricing.calculateTotal(items, 'UNKNOWN');\n    expect(result3.discount).toBe(0);\n\n    // getPrice from catalog event\n    expect(pricing.getPrice('p1')).toBe(0); // not tracked by pricing since no product:created event\n  });\n\n  it('Pricing: listens for product created events', () => {\n    const { pricing, catalog } = createSystem();\n    const pid = catalog.createProduct('Widget', 29.99, 'gadgets');\n    expect(pricing.getPrice(pid)).toBe(29.99);\n  });\n\n  it('Orders: create, update status, list by user', async () => {\n    const { orders, bus } = createSystem();\n    const statusChanges: unknown[] = [];\n    bus.on(Events.ORDER_STATUS_CHANGED, (p: unknown) => { statusChanges.push(p); });\n\n    const oid = orders.createOrder('user-1', 'cart-1', 59.99);\n    const order = orders.getOrder(oid);\n    expect(order).not.toBeNull();\n    expect(order!.status).toBe(OrderStatus.PENDING);\n    expect(order!.userId).toBe('user-1');\n    expect(order!.total).toBe(59.99);\n\n    orders.updateStatus(oid, OrderStatus.CONFIRMED);\n    await drainMicrotasks();\n    expect(orders.getOrder(oid)!.status).toBe(OrderStatus.CONFIRMED);\n    expect(statusChanges).toHaveLength(1);\n    expect((statusChanges[0] as any).previousStatus).toBe(OrderStatus.PENDING);\n    expect((statusChanges[0] as any).status).toBe(OrderStatus.CONFIRMED);\n\n    orders.updateStatus(oid, OrderStatus.CANCELLED);\n    expect(orders.getOrder(oid)!.status).toBe(OrderStatus.CANCELLED);\n\n    // Non-existent order\n    orders.updateStatus('fake', OrderStatus.CONFIRMED); // no-op\n\n    // List by user\n    const oid2 = orders.createOrder('user-2', 'cart-2', 10);\n    const oid3 = orders.createOrder('user-1', 'cart-3', 20);\n    expect(orders.listOrders('user-1')).toHaveLength(2);\n    expect(orders.listOrders('user-2')).toHaveLength(1);\n    expect(orders.listOrders('user-3')).toHaveLength(0);\n  });\n\n  it('Payment: success mode', async () => {\n    const sys = createSystem({ paymentMode: 'success' });\n    const result = await sys.payment.processPayment('order-1', 100);\n    expect(result.status).toBe(PaymentStatus.SUCCESS);\n    expect(result.transactionId).toBeDefined();\n    expect(result.error).toBeUndefined();\n  });\n\n  it('Payment: fail mode', async () => {\n    const sys = createSystem({ paymentMode: 'fail' });\n    const result = await sys.payment.processPayment('order-1', 100);\n    expect(result.status).toBe(PaymentStatus.FAILED);\n    expect(result.error).toBeDefined();\n  });\n\n  it('Payment: timeout mode', async () => {\n    const sys = createSystem({ paymentMode: 'timeout' });\n    const result = await sys.payment.processPayment('order-1', 100);\n    expect(result.status).toBe(PaymentStatus.TIMEOUT);\n  });\n\n  it('Payment: refund', async () => {\n    const sys = createSystem({ paymentMode: 'success' });\n    const result = await sys.payment.processPayment('order-1', 100);\n    expect(await sys.payment.refund(result.transactionId!)).toBe(true);\n    expect(await sys.payment.refund('fake')).toBe(false);\n  });\n\n  it('Payment: emits PAYMENT_PROCESSED event', async () => {\n    const sys = createSystem({ paymentMode: 'success' });\n    const events: unknown[] = [];\n    sys.bus.on(Events.PAYMENT_PROCESSED, (p: unknown) => { events.push(p); });\n\n    await sys.payment.processPayment('order-1', 100);\n    await drainMicrotasks();\n    expect(events).toHaveLength(1);\n  });\n\n  it('Notifications: subscribe and receive notifications', async () => {\n    const { notifications, orders } = createSystem();\n\n    // Track order-user mapping via ORDER_CREATED event\n    // Create order first so notification service has the mapping\n    const oid = orders.createOrder('user-1', 'cart-1', 50);\n\n    notifications.subscribe('user-1');\n    expect(notifications.getNotifications('user-1')).toHaveLength(0);\n\n    // Status change should generate notification\n    orders.updateStatus(oid, OrderStatus.CONFIRMED);\n    await drainMicrotasks();\n    expect(notifications.getNotifications('user-1').length).toBeGreaterThanOrEqual(1);\n    expect(notifications.getNotifications('user-1')[0].type).toBe('order_status');\n\n    // Unsubscribed user gets nothing\n    expect(notifications.getNotifications('user-2')).toHaveLength(0);\n  });\n\n  it('Notifications: payment notifications', async () => {\n    const sys = createSystem();\n    const oid = sys.orders.createOrder('user-1', 'cart-1', 50);\n\n    sys.notifications.subscribe('user-1');\n    await sys.payment.processPayment(oid, 50);\n    await drainMicrotasks();\n\n    const notifs = sys.notifications.getNotifications('user-1');\n    const paymentNotifs = notifs.filter(n => n.type === 'payment');\n    expect(paymentNotifs.length).toBeGreaterThanOrEqual(1);\n  });\n\n  it('Analytics: event counts and revenue', async () => {\n    const sys = createSystem({ paymentMode: 'success' });\n\n    // Create a product and order it\n    const pid = sys.catalog.createProduct('Widget', 29.99, 'gadgets');\n    const cid = sys.cart.createCart('user-1');\n    sys.cart.addItem(cid, pid, 2);\n    const calc = sys.pricing.calculateTotal([{ productId: pid, quantity: 2, price: 29.99 }]);\n    const oid = sys.orders.createOrder('user-1', cid, calc.total);\n    await sys.payment.processPayment(oid, calc.total);\n    await drainMicrotasks();\n\n    expect(sys.analytics.getEventCount(Events.ORDER_CREATED)).toBe(1);\n    expect(sys.analytics.getEventCount(Events.PAYMENT_PROCESSED)).toBe(1);\n    expect(sys.analytics.getRevenue()).toBe(calc.total);\n\n    // Conversion rate\n    expect(sys.analytics.getConversionRate()).toBe(1); // 1 order / 1 unique cart\n\n    // No carts case\n    const sys2 = createSystem();\n    expect(sys2.analytics.getConversionRate()).toBe(0);\n  });\n\n  it('Analytics: top products', async () => {\n    const { cart, analytics } = createSystem();\n\n    const cid1 = cart.createCart('user-1');\n    cart.addItem(cid1, 'prod-a', 5);\n    cart.addItem(cid1, 'prod-b', 3);\n\n    const cid2 = cart.createCart('user-2');\n    cart.addItem(cid2, 'prod-a', 2);\n\n    await drainMicrotasks();\n\n    const top = analytics.getTopProducts(2);\n    expect(top).toHaveLength(2);\n    expect(top[0].productId).toBe('prod-a');\n    expect(top[0].count).toBe(7);\n    expect(top[1].productId).toBe('prod-b');\n    expect(top[1].count).toBe(3);\n\n    // limit fewer than available\n    const top1 = analytics.getTopProducts(1);\n    expect(top1).toHaveLength(1);\n    expect(top1[0].productId).toBe('prod-a');\n\n    // limit more than available\n    const top10 = analytics.getTopProducts(10);\n    expect(top10).toHaveLength(2);\n  });\n\n  it('Empty states: catalog returns null for missing products', () => {\n    const { catalog } = createSystem();\n    expect(catalog.getProduct('nonexistent')).toBeNull();\n    expect(catalog.listProducts()).toEqual([]);\n    expect(catalog.searchProducts('anything')).toEqual([]);\n  });\n\n  it('Empty states: analytics returns 0 for no events', () => {\n    const { analytics } = createSystem();\n    expect(analytics.getEventCount('nonexistent')).toBe(0);\n    expect(analytics.getRevenue()).toBe(0);\n  });\n\n  it('Order status lifecycle', () => {\n    const { orders } = createSystem();\n    const oid = orders.createOrder('user-1', 'cart-1', 100);\n    expect(orders.getOrder(oid)!.status).toBe(OrderStatus.PENDING);\n\n    orders.updateStatus(oid, OrderStatus.CONFIRMED);\n    expect(orders.getOrder(oid)!.status).toBe(OrderStatus.CONFIRMED);\n\n    orders.updateStatus(oid, OrderStatus.SHIPPED);\n    expect(orders.getOrder(oid)!.status).toBe(OrderStatus.SHIPPED);\n\n    orders.updateStatus(oid, OrderStatus.DELIVERED);\n    expect(orders.getOrder(oid)!.status).toBe(OrderStatus.DELIVERED);\n\n    orders.updateStatus(oid, OrderStatus.CANCELLED);\n    expect(orders.getOrder(oid)!.status).toBe(OrderStatus.CANCELLED);\n  });\n\n  it('All exports from index.ts', async () => {\n    const m = await import('./index.js');\n    expect(m.createCatalogService).toBeDefined();\n    expect(m.createInventoryService).toBeDefined();\n    expect(m.createCartService).toBeDefined();\n    expect(m.createPricingService).toBeDefined();\n    expect(m.createOrdersService).toBeDefined();\n    expect(m.createPaymentService).toBeDefined();\n    expect(m.createNotificationService).toBeDefined();\n    expect(m.createAnalyticsService).toBeDefined();\n  });\n\n  it('EventBus integration: services do not import each other', () => {\n    const { catalog, inventory, cart, pricing, orders, payment, notifications, analytics } = createSystem();\n    // Verify a