eturn 0;\n      return orderCount / uniqueCartIds.size;\n    },\n\n    getTopProducts(limit: number): Array<{ productId: string; count: number }> {\n      return Array.from(productOrderCounts.entries())\n        .sort((a, b) => b[1] - a[1])\n        .slice(0, limit)\n        .map(([productId, count]) => ({ productId, count }));\n    },\n  };\n}\n","structuredPatch":[{"oldStart":38,"oldLines":13,"newStart":38,"newLines":30,"lines":["     }","   });"," ","-  // Track product popularity from cart items","+  // Track product popularity from cart item deltas","+  const lastCartState = new Map<string, Map<string, number>>(); // cartId -> (productId -> quantity)","   bus.on(Events.CART_UPDATED, (payload: unknown) => {","     const event = payload as CartUpdatedEvent;","-    for (const item of event.items) {","-      const current = productOrderCounts.get(item.productId) ?? 0;","-      productOrderCounts.set(item.productId, current + item.quantity);","+    const prevItems = lastCartState.get(event.cartId) ?? new Map();","+    const newItems = new Map(event.items.map(i => [i.productId, i.quantity]));","+","+    for (const [productId, newQty] of newItems) {","+      const prevQty = prevItems.get(productId) ?? 0;","+      const delta = newQty - prevQty;","+      if (delta !== 0) {","+        productOrderCounts.set(productId, (productOrderCounts.get(productId) ?? 0) + delta);","+      }","     }","+","+    // Items removed from cart: subtract their previous quantity","+    for (const [productId, prevQty] of prevItems) {","+      if (!newItems.has(productId)) {","+        const current = productOrderCounts.get(productId) ?? 0;","+        productOrderCounts.set(productId, Math.max(0, current - prevQty));","+      }","+    }","+","+    lastCartState.set(event.cartId, newItems);","   });"," ","   return {"]}],"userModified":false,"replaceAll":false}}
