+    orders.updateStatus(oid, OrderStatus.CONFIRMED);
+    await drainMicrotasks();
+    expect(orders.getOrder(oid)!.status).toBe(OrderStatus.CONFIRMED);
+    expect(statusChanges).toHaveLength(1);
+    const change = statusChanges[0] as { previousStatus: OrderStatus; status: OrderStatus };
+    expect(change.previousStatus).toBe(OrderStatus.PENDING);
+    expect(change.status).toBe(OrderStatus.CONFIRMED);
