diff --git a/src/analytics/index.ts b/src/analytics/index.ts
new file mode 100644
index 0000000..3030b80
--- /dev/null
+++ b/src/analytics/index.ts
@@ -0,0 +1,88 @@
+import { EventBus } from '../bus.js';
+import { Events, AnalyticsService, CartUpdatedEvent, OrderCreatedEvent, PaymentProcessedEvent } from '../types.js';
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const orderTotals = new Map<string, number>(); // orderId -> total
+  let revenue = 0;
+  const uniqueCartIds = new Set<string>();
+  let orderCount = 0;
+  const productOrderCounts = new Map<string, number>(); // productId -> total ordered quantity
+
+  // Count all events by type
+  const allEventNames = Object.values(Events);
+  for (const eventName of allEventNames) {
+    bus.on(eventName, () => {
+      eventCounts.set(eventName, (eventCounts.get(eventName) ?? 0) + 1);
+    });
+  }
+
+  // Track unique carts
+  bus.on(Events.CART_UPDATED, (payload: unknown) => {
+    const event = payload as CartUpdatedEvent;
+    uniqueCartIds.add(event.cartId);
+  });
+
+  // Track orders and store order totals
+  bus.on(Events.ORDER_CREATED, (payload: unknown) => {
+    const event = payload as OrderCreatedEvent;
+    orderCount++;
+    orderTotals.set(event.orderId, event.total);
+  });
+
+  // Track revenue from successful payments
+  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {
+    const event = payload as PaymentProcessedEvent;
+    if (event.status === 'success') {
+      revenue += orderTotals.get(event.orderId) ?? 0;
+    }
+  });
+
+  // Track product popularity from cart item deltas
+  const lastCartState = new Map<string, Map<string, number>>(); // cartId -> (productId -> quantity)
+  bus.on(Events.CART_UPDATED, (payload: unknown) => {
+    const event = payload as CartUpdatedEvent;
+    const prevItems = lastCartState.get(event.cartId) ?? new Map();
+    const newItems = new Map(event.items.map(i => [i.productId, i.quantity]));
+
+    for (const [productId, newQty] of newItems) {
+      const prevQty = prevItems.get(productId) ?? 0;
+      const delta = newQty - prevQty;
+      if (delta !== 0) {
+        productOrderCounts.set(productId, (productOrderCounts.get(productId) ?? 0) + delta);
+      }
+    }
+
+    // Items removed from cart: subtract their previous quantity
+    for (const [productId, prevQty] of prevItems) {
+      if (!newItems.has(productId)) {
+        const current = productOrderCounts.get(productId) ?? 0;
+        productOrderCounts.set(productId, Math.max(0, current - prevQty));
+      }
+    }
+
+    lastCartState.set(event.cartId, newItems);
+  });
+
+  return {
+    getEventCount(eventType: string): number {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue(): number {
+      return revenue;
+    },
+
+    getConversionRate(): number {
+      if (uniqueCartIds.size === 0) return 0;
+      return orderCount / uniqueCartIds.size;
+    },
+
+    getTopProducts(limit: number): Array<{ productId: string; count: number }> {
+      return Array.from(productOrderCounts.entries())
+        .sort((a, b) => b[1] - a[1])
+        .slice(0, limit)
+        .map(([productId, count]) => ({ productId, count }));
+    },
+  };
+}
diff --git a/src/cart/index.ts b/src/cart/index.ts
new file mode 100644
index 0000000..c9cc5f5
--- /dev/null
+++ b/src/cart/index.ts
@@ -0,0 +1,81 @@
+import { v4 as uuid } from 'uuid';
+import { EventBus } from '../bus.js';
+import { CartService, Events, CartUpdatedEvent } from '../types.js';
+
+interface CartItem {
+  productId: string;
+  quantity: number;
+}
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: CartItem[];
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  function emitCartUpdated(cart: Cart): void {
+    const payload: CartUpdatedEvent = {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: cart.items.map(i => ({ productId: i.productId, quantity: i.quantity })),
+    };
+    bus.emit(Events.CART_UPDATED, payload);
+  }
+
+  return {
+    createCart(userId: string): string {
+      const id = uuid();
+      carts.set(id, { id, userId, items: [] });
+      return id;
+    },
+
+    addItem(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const existing = cart.items.find(i => i.productId === productId);
+      if (existing) {
+        existing.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      emitCartUpdated(cart);
+    },
+
+    removeItem(cartId: string, productId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items = cart.items.filter(i => i.productId !== productId);
+      emitCartUpdated(cart);
+    },
+
+    getCart(cartId: string): Cart | null {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      return {
+        id: cart.id,
+        userId: cart.userId,
+        items: cart.items.map(i => ({ productId: i.productId, quantity: i.quantity })),
+      };
+    },
+
+    clearCart(cartId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items = [];
+      emitCartUpdated(cart);
+    },
+
+    updateQuantity(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const existing = cart.items.find(i => i.productId === productId);
+      if (existing) {
+        existing.quantity = quantity;
+        emitCartUpdated(cart);
+      }
+    },
+  };
+}
