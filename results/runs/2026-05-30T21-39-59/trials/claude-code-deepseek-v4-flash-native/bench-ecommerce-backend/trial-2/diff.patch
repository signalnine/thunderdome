+import { createOrdersService } from './orders/index.js';
+import { createPaymentService } from './payment/index.js';
+import { createNotificationService } from './notifications/index.js';
+import { createAnalyticsService } from './analytics/index.js';
+import { OrderStatus, PaymentStatus, Events } from './types.js';
+
+/** Drain the microtask queue so async event handlers have a chance to run. */
+async function drainMicrotasks(): Promise<void> {
+  await new Promise(resolve => setTimeout(resolve, 0));
+}
+
+describe('E-Commerce Backend', () => {
+  function createSystem(options?: { paymentMode?: 'success' | 'fail' | 'timeout'; paymentDelay?: number }) {
+    const bus = new EventBus();
+    return {
+      bus,
+      catalog: createCatalogService(bus),
+      inventory: createInventoryService(bus),
+      cart: createCartService(bus),
+      pricing: createPricingService(bus),
+      orders: createOrdersService(bus),
+      payment: createPaymentService(bus, {
+        mode: options?.paymentMode ?? 'success',
+        delay: options?.paymentDelay ?? 10,
+      }),
+      notifications: createNotificationService(bus),
+      analytics: createAnalyticsService(bus),
+    };
+  }
+
+  it('Catalog: CRUD and search', () => {
+    const { catalog } = createSystem();
+
+    const pid = catalog.createProduct('Widget', 29.99, 'gadgets');
+    expect(pid).toBeDefined();
+    expect(typeof pid).toBe('string');
+
+    const product = catalog.getProduct(pid);
+    expect(product).not.toBeNull();
+    expect(product!.name).toBe('Widget');
+    expect(product!.price).toBe(29.99);
+    expect(product!.category).toBe('gadgets');
+
+    catalog.createProduct('Gizmo', 49.99, 'gadgets');
+    catalog.createProduct('Book', 9.99, 'media');
+
+    expect(catalog.listProducts('gadgets')).toHaveLength(2);
+    expect(catalog.listProducts('media')).toHaveLength(1);
+    expect(catalog.listProducts()).toHaveLength(3);
+
+    expect(catalog.searchProducts('giz')).toHaveLength(1);
+    expect(catalog.searchProducts('widget')).toHaveLength(1);
+    expect(catalog.searchProducts('GADGETS')).toHaveLength(2);
+
+    catalog.updateProduct(pid, { name: 'Super Widget', price: 34.99 });
+    expect(catalog.getProduct(pid)!.name).toBe('Super Widget');
+    expect(catalog.getProduct(pid)!.price).toBe(34.99);
+
+    expect(catalog.removeProduct(pid)).toBe(true);
+    expect(catalog.getProduct(pid)).toBeNull();
+    expect(catalog.removeProduct('nonexistent')).toBe(false);
+  });
+
+  it('Catalog: emits PRODUCT_CREATED event', async () => {
+    const { bus, catalog } = createSystem();
+    const events: unknown[] = [];
+    bus.on(Events.PRODUCT_CREATED, (p: unknown) => { events.push(p); });
+
+    catalog.createProduct('Test', 10, 'test');
+    await drainMicrotasks();
+    expect(events).toHaveLength(1);
+  });
+
+  it('Inventory: stock management, reserve, release, low stock alerts', async () => {
+    const { bus, inventory } = createSystem();
+    const lowStockEvents: unknown[] = [];
+    bus.on(Events.LOW_STOCK_ALERT, (p: unknown) => { lowStockEvents.push(p); });
+
+    inventory.setStock('prod-1', 10);
+    expect(inventory.getStock('prod-1')).toBe(10);
+
+    inventory.setLowStockThreshold('prod-1', 5);
+    await drainMicrotasks();
+    // setting threshold should trigger check, 10 > 5 so no alert
+    expect(lowStockEvents).toHaveLength(0);
+
+    expect(inventory.reserve('prod-1', 3)).toBe(true);
+    expect(inventory.getStock('prod-1')).toBe(7);
+
+    expect(inventory.reserve('prod-1', 20)).toBe(false);
+    expect(inventory.getStock('prod-1')).toBe(7);
+
+    inventory.release('prod-1', 2);
+    expect(inventory.getStock('prod-1')).toBe(9);
+
+    // Low stock alert when total drops to threshold
+    inventory.setStock('prod-1', 5);
+    await drainMicrotasks();
+    expect(lowStockEvents.length).toBeGreaterThanOrEqual(1);
+  });
+
+  it('Cart: create, add, remove, update, clear, consolidate', async () => {
