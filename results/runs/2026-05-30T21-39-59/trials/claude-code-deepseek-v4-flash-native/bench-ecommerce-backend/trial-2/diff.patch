+import { EventBus } from '../bus.js';
+import {
+  Events,
+  NotificationService,
+  NotificationSentEvent,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+} from '../types.js';
+
+interface Notification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const notifications = new Map<string, Notification[]>();
+  const orderUsers = new Map<string, string>(); // orderId -> userId
+
+  bus.on(Events.ORDER_CREATED, (payload: unknown) => {
+    const event = payload as OrderCreatedEvent;
+    orderUsers.set(event.orderId, event.userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload: unknown) => {
+    const event = payload as OrderStatusChangedEvent;
+    const userId = orderUsers.get(event.orderId);
+    if (!userId || !subscribers.has(userId)) return;
+
+    const message = `Order ${event.orderId} status changed from ${event.previousStatus} to ${event.status}`;
+    if (!notifications.has(userId)) notifications.set(userId, []);
+    notifications.get(userId)!.push({ type: 'order_status', message, timestamp: Date.now() });
+
+    const sentEvent: NotificationSentEvent = { userId, type: 'order_status', message };
+    bus.emit(Events.NOTIFICATION_SENT, sentEvent);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {
+    const event = payload as PaymentProcessedEvent;
+    const userId = orderUsers.get(event.orderId);
+    if (!userId || !subscribers.has(userId)) return;
+
+    let message: string;
+    if (event.status === 'success') {
+      message = `Payment for order ${event.orderId} processed successfully`;
+    } else {
+      message = `Payment for order ${event.orderId} failed: ${event.error ?? 'unknown error'}`;
+    }
+
+    if (!notifications.has(userId)) notifications.set(userId, []);
+    notifications.get(userId)!.push({ type: 'payment', message, timestamp: Date.now() });
+
+    const sentEvent: NotificationSentEvent = { userId, type: 'payment', message };
+    bus.emit(Events.NOTIFICATION_SENT, sentEvent);
+  });
+
+  return {
+    subscribe(userId: string): void {
+      subscribers.add(userId);
+      if (!notifications.has(userId)) {
+        notifications.set(userId, []);
+      }
+    },
+
+    getNotifications(userId: string): Notification[] {
+      return notifications.get(userId) ?? [];
+    },
+  };
+}
