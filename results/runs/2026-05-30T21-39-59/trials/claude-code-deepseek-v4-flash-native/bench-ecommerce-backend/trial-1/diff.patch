eviousStatus };\n      bus.emit(Events.ORDER_STATUS_CHANGED, payload);\n    },\n\n    listOrders(userId: string) {\n      const orderIds = userOrders.get(userId) ?? [];\n      return orderIds\n        .map(id => {\n          const order = orders.get(id);\n          if (!order) return null;\n          return { id: order.id, status: order.status, total: order.total };\n        })\n        .filter((o): o is { id: string; status: OrderStatus; total: number } => o !== null);\n    },\n  };\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":45,"cache_creation_input_tokens":0,"cache_read_input_tokens":35968,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3e99d806-a9fe-4278-8977-b41c2a595a73","uuid":"897816b8-efb4-495d-9837-85af3c8ca134"}
