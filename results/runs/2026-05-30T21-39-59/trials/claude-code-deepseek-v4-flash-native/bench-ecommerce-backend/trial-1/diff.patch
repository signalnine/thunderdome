+import { v4 as uuidv4 } from 'uuid';
+import { EventBus } from '../bus.js';
+import { Events, OrderCreatedEvent, OrderStatusChangedEvent, OrderStatus, OrderService } from '../types.js';
+
+const VALID_TRANSITIONS: Record<OrderStatus, OrderStatus[]> = {
+  [OrderStatus.PENDING]: [OrderStatus.CONFIRMED, OrderStatus.CANCELLED],
+  [OrderStatus.CONFIRMED]: [OrderStatus.SHIPPED, OrderStatus.CANCELLED],
+  [OrderStatus.SHIPPED]: [OrderStatus.DELIVERED],
+  [OrderStatus.DELIVERED]: [],
+  [OrderStatus.CANCELLED]: [],
+};
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, { id: string; userId: string; status: OrderStatus; total: number }>();
+  const userOrders = new Map<string, string[]>(); // userId → orderIds
+
+  return {
+    createOrder(userId: string, _cartId: string, total: number): string {
+      const id = uuidv4();
+      orders.set(id, { id, userId, status: OrderStatus.PENDING, total });
+
+      const list = userOrders.get(userId) ?? [];
+      list.push(id);
+      userOrders.set(userId, list);
+
+      const payload: OrderCreatedEvent = { orderId: id, userId, cartId: _cartId, total };
+      bus.emit(Events.ORDER_CREATED, payload);
+
+      return id;
+    },
+
+    getOrder(orderId: string) {
+      return orders.get(orderId) ?? null;
+    },
+
+    updateStatus(orderId: string, status: OrderStatus): void {
+      const order = orders.get(orderId);
+      if (!order) return;
+
+      const allowed = VALID_TRANSITIONS[order.status];
+      if (!allowed.includes(status)) return;
+
+      const previousStatus = order.status;
+      order.status = status;
+
+      const payload: OrderStatusChangedEvent = { orderId, status, previousStatus };
+      bus.emit(Events.ORDER_STATUS_CHANGED, payload);
+    },
+
+    listOrders(userId: string) {
+      const orderIds = userOrders.get(userId) ?? [];
+      return orderIds
+        .map(id => {
+          const order = orders.get(id);
+          if (!order) return null;
+          return { id: order.id, status: order.status, total: order.total };
+        })
+        .filter((o): o is { id: string; status: OrderStatus; total: number } => o !== null);
+    },
+  };
+}
