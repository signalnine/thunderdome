n      if (!cart) return;\n      cart.items.clear();\n      emitCartUpdate(cartId);\n    },\n\n    updateQuantity(cartId: string, productId: string, quantity: number): void {\n      const cart = carts.get(cartId);\n      if (!cart) return;\n      if (quantity <= 0) {\n        cart.items.delete(productId);\n      } else {\n        cart.items.set(productId, quantity);\n      }\n      emitCartUpdate(cartId);\n    },\n  };\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":140,"cache_creation_input_tokens":0,"cache_read_input_tokens":34432,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3e99d806-a9fe-4278-8977-b41c2a595a73","uuid":"bee9b0be-e803-41b4-9c01-37080b20698d"}
