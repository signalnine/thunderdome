@@ -0,0 +1,64 @@
+import { EventBus } from '../bus.js';
+import {
+  Events,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+  NotificationSentEvent,
+  NotificationService,
+} from '../types.js';
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const notifications = new Map<string, Array<{ type: string; message: string; timestamp: number }>>();
+  const orderOwners = new Map<string, string>(); // orderId → userId
+
+  function addNotification(userId: string, type: string, message: string): void {
+    if (!subscribers.has(userId)) return;
+    const userNotifications = notifications.get(userId) ?? [];
+    const timestamp = Date.now();
+    userNotifications.push({ type, message, timestamp });
+    notifications.set(userId, userNotifications);
+    const payload: NotificationSentEvent = { userId, type, message };
+    bus.emit(Events.NOTIFICATION_SENT, payload);
+  }
+
+  // Listen for order creation to record user-order mapping and notify
+  bus.on(Events.ORDER_CREATED, (payload: unknown) => {
+    const event = payload as OrderCreatedEvent;
+    orderOwners.set(event.orderId, event.userId);
+    addNotification(event.userId, 'order_created', `Order ${event.orderId} created for $${event.total}`);
+  });
+
+  // Listen for order status changes
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload: unknown) => {
+    const event = payload as OrderStatusChangedEvent;
+    const userId = orderOwners.get(event.orderId);
+    if (userId) {
+      addNotification(
+        userId,
+        'order_status',
+        `Order ${event.orderId} changed from ${event.previousStatus} to ${event.status}`
+      );
+    }
+  });
+
+  // Listen for payment events
+  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {
+    const event = payload as PaymentProcessedEvent;
+    const userId = orderOwners.get(event.orderId);
+    if (userId) {
+      addNotification(userId, 'payment', `Payment for order ${event.orderId}: ${event.status}`);
+    }
+  });
+
+  return {
+    subscribe(userId: string): void {
+      subscribers.add(userId);
+    },
+
+    getNotifications(userId: string) {
+      return notifications.get(userId) ?? [];
+    },
+  };
+}
