+// ── Express App ───────────────────────────────────────────────────────────────
+
+import express from 'express';
+import router from './routes.js';
+
+export function createApp(): express.Application {
+  const app = express();
+
+  app.use(express.json());
+
+  // Mount all routes under /api
+  app.use('/api', router);
+
+  return app;
+}
