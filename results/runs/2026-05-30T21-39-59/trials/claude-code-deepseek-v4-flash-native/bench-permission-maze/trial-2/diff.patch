@@ -0,0 +1,37 @@
+// ── Authentication ────────────────────────────────────────────────────────────
+
+import { randomUUID, createHash } from 'node:crypto';
+import type { Request, Response, NextFunction } from 'express';
+import { store } from './store.js';
+
+export function hashPassword(password: string): string {
+  return createHash('sha256').update(password).digest('hex');
+}
+
+export function generateToken(): string {
+  return randomUUID();
+}
+
+// ── Auth middleware ───────────────────────────────────────────────────────────
+
+export interface AuthRequest extends Request {
+  userId?: string;
+}
+
+export function requireAuth(req: AuthRequest, res: Response, next: NextFunction): void {
+  const authHeader = req.headers.authorization;
+  if (!authHeader || !authHeader.startsWith('Bearer ')) {
+    res.status(401).json({ error: 'Missing or invalid authorization header' });
+    return;
+  }
+
+  const token = authHeader.slice(7);
+  const userId = store.getUserIdByToken(token);
+  if (!userId) {
+    res.status(401).json({ error: 'Invalid or expired token' });
+    return;
+  }
+
+  req.userId = userId;
+  next();
+}
diff --git a/src/routes.ts b/src/routes.ts
new file mode 100644
index 0000000..af4f14e
--- /dev/null
+++ b/src/routes.ts
@@ -0,0 +1,446 @@
+// ── API Routes ────────────────────────────────────────────────────────────────
+
+import { Router } from 'express';
+import { randomUUID } from 'node:crypto';
+import { store } from './store.js';
+import { hashPassword, generateToken, requireAuth } from './auth.js';
+import type { AuthRequest } from './auth.js';
+import type { Role, ResourceType, ActionType } from './types.js';
+
+const router = Router();
+
+// ── Helpers ───────────────────────────────────────────────────────────────────
+
+function isValidRole(role: string): role is Role {
+  return role === 'viewer' || role === 'editor' || role === 'owner';
+}
+
+function logActivity(
+  actionType: ActionType,
+  userId: string,
+  targetType: ResourceType | 'share',
+  targetId: string,
+  details: string,
+): void {
+  store.addActivityLog(randomUUID(), actionType, userId, targetType, targetId, details);
+}
+
+// ── Auth Routes ───────────────────────────────────────────────────────────────
+
+router.post('/auth/register', (req, res) => {
+  const { username, password } = req.body;
+
+  if (!username || typeof username !== 'string' || username.trim().length === 0) {
+    res.status(400).json({ error: 'Username is required' });
+    return;
+  }
+  if (!password || typeof password !== 'string' || password.length === 0) {
+    res.status(400).json({ error: 'Password is required' });
+    return;
+  }
+
+  const trimmedUsername = username.trim();
+
+  if (store.getUserByUsername(trimmedUsername)) {
+    res.status(409).json({ error: 'Username already exists' });
+    return;
+  }
+
+  const id = randomUUID();
+  const passwordHash = hashPassword(password);
+  store.createUser(id, trimmedUsername, passwordHash);
+
+  const token = generateToken();
+  store.setToken(token, id);
+
+  res.status(201).json({
+    user: { id, username: trimmedUsername },
+    token,
+  });
+});
+
+router.post('/auth/login', (req, res) => {
+  const { username, password } = req.body;
+
+  if (!username || typeof username !== 'string' || !password || typeof password !== 'string') {
+    res.status(400).json({ error: 'Username and password are required' });
+    return;
+  }
+
+  const user = store.getUserByUsername(username.trim());
+  if (!user || user.passwordHash !== hashPassword(password)) {
+    res.status(401).json({ error: 'Invalid username or password' });
+    return;
+  }
+
+  const token = generateToken();
+  store.setToken(token, user.id);
+
+  res.json({
+    user: { id: user.id, username: user.username },
+    token,
+  });
+});
+
+// ── Folder Routes ────────────────────────────────────────────────────────────
+
+router.post('/folders', requireAuth, (req: AuthRequest, res) => {
+  const { name, parentId } = req.body;
+  const userId = req.userId!;
+
+  if (!name || typeof name !== 'string' || name.trim().length === 0) {
+    res.status(400).json({ error: 'Folder name is required' });
+    return;
+  }
+
+  // Validate parent folder exists and user has access
+  if (parentId) {
+    const parent = store.getFolder(parentId);
+    if (!parent) {
+      res.status(404).json({ error: 'Parent folder not found' });
+      return;
+    }
+    if (!store.hasPermission(userId, 'folder', parentId, 'editor')) {
+      res.status(403).json({ error: 'Insufficient permissions to create folder here' });
+      return;
+    }
+  }
+
+  const id = randomUUID();
+  const folder = store.createFolder(id, name.trim(), parentId || null, userId);
+
+  logActivity('folder.create', userId, 'folder', id, `Created folder "${name.trim()}"`);
+
+  res.status(201).json(folder);
+});
+
+router.get('/folders/:id', requireAuth, (req: AuthRequest, res) => {
+  const userId = req.userId!;
+  const folder = store.getFolder(req.params.id);
+
+  if (!folder) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  if (!store.hasPermission(userId, 'folder', folder.id, 'viewer')) {
+    res.status(403).json({ error: 'Access denied' });
+    return;
+  }
+
+  res.json({
+    ...folder,
+    children: store.getFolderChildren(folder.id),
+    documents: store.getFolderDocuments(folder.id),
+  });
+});
+
+router.put('/folders/:id', requireAuth, (req: AuthRequest, res) => {
+  const userId = req.userId!;
+  const { name } = req.body;
+
+  const folder = store.getFolder(req.params.id);
+  if (!folder) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  if (!store.hasPermission(userId, 'folder', folder.id, 'editor')) {
+    res.status(403).json({ error: 'Insufficient permissions' });
+    return;
+  }
+
+  if (name !== undefined && (typeof name !== 'string' || name.trim().length === 0)) {
+    res.status(400).json({ error: 'Invalid folder name' });
+    return;
+  }
+
+  const updated = store.updateFolder(folder.id, name?.trim());
+  logActivity('folder.update', userId, 'folder', folder.id, `Updated folder "${updated!.name}"`);
+  res.json(updated);
+});
+
+router.delete('/folders/:id', requireAuth, (req: AuthRequest, res) => {
+  const userId = req.userId!;
+  const folder = store.getFolder(req.params.id);
+
+  if (!folder) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  if (!store.hasPermission(userId, 'folder', folder.id, 'owner')) {
+    res.status(403).json({ error: 'Only the owner can delete folders' });
+    return;
+  }
+
+  logActivity('folder.delete', userId, 'folder', folder.id, `Deleted folder "${folder.name}"`);
+  store.deleteFolder(folder.id);
+
+  res.status(204).send();
+});
+
+// ── Document Routes ──────────────────────────────────────────────────────────
+
+router.post('/documents', requireAuth, (req: AuthRequest, res) => {
+  const { title, content, folderId } = req.body;
+  const userId = req.userId!;
+
+  if (!title || typeof title !== 'string' || title.trim().length === 0) {
+    res.status(400).json({ error: 'Document title is required' });
+    return;
+  }
+  if (content === undefined || typeof content !== 'string') {
+    res.status(400).json({ error: 'Document content is required' });
+    return;
+  }
+  if (!folderId || typeof folderId !== 'string') {
+    res.status(400).json({ error: 'Folder ID is required' });
+    return;
+  }
+
+  const folder = store.getFolder(folderId);
+  if (!folder) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  if (!store.hasPermission(userId, 'folder', folderId, 'editor')) {
+    res.status(403).json({ error: 'Insufficient permissions to create document in this folder' });
+    return;
+  }
+
+  const id = randomUUID();
+  const doc = store.createDocument(id, title.trim(), content, folderId, userId);
+
+  logActivity('document.create', userId, 'document', id, `Created document "${title.trim()}"`);
+
+  res.status(201).json(doc);
+});
+
+router.get('/documents/:id', requireAuth, (req: AuthRequest, res) => {
+  const userId = req.userId!;
+  const doc = store.getDocument(req.params.id);
+
+  if (!doc) {
+    res.status(404).json({ error: 'Document not found' });
+    return;
+  }
+
+  if (!store.hasPermission(userId, 'document', doc.id, 'viewer')) {
+    res.status(403).json({ error: 'Access denied' });
+    return;
+  }
+
+  res.json(doc);
+});
+
+router.put('/documents/:id', requireAuth, (req: AuthRequest, res) => {
+  const userId = req.userId!;
+  const { title, content } = req.body;
+
+  const doc = store.getDocument(req.params.id);
+  if (!doc) {
+    res.status(404).json({ error: 'Document not found' });
+    return;
+  }
+
+  if (!store.hasPermission(userId, 'document', doc.id, 'editor')) {
+    res.status(403).json({ error: 'Insufficient permissions' });
+    return;
+  }
+
+  if (title !== undefined && (typeof title !== 'string' || title.trim().length === 0)) {
+    res.status(400).json({ error: 'Invalid document title' });
+    return;
+  }
+  if (content !== undefined && typeof content !== 'string') {
+    res.status(400).json({ error: 'Invalid document content' });
+    return;
+  }
+
+  const updated = store.updateDocument(doc.id, title?.trim(), content);
+  logActivity('document.update', userId, 'document', doc.id, `Updated document "${updated!.title}"`);
+  res.json(updated);
+});
+
+router.delete('/documents/:id', requireAuth, (req: AuthRequest, res) => {
+  const userId = req.userId!;
+  const doc = store.getDocument(req.params.id);
+
+  if (!doc) {
+    res.status(404).json({ error: 'Document not found' });
+    return;
+  }
+
+  if (!store.hasPermission(userId, 'document', doc.id, 'owner')) {
+    res.status(403).json({ error: 'Only the owner can delete documents' });
+    return;
+  }
+
+  logActivity('document.delete', userId, 'document', doc.id, `Deleted document "${doc.title}"`);
+  store.deleteDocument(doc.id);
+
+  res.status(204).send();
+});
+
+// ── Sharing Routes ───────────────────────────────────────────────────────────
+
+router.post('/shares', requireAuth, (req: AuthRequest, res) => {
+  const { resourceType, resourceId, userId: targetUserId, role } = req.body;
+  const sharerId = req.userId!;
+
+  if (!resourceType || !['folder', 'document'].includes(resourceType)) {
+    res.status(400).json({ error: 'resourceType must be "folder" or "document"' });
+    return;
+  }
+  if (!resourceId || typeof resourceId !== 'string') {
+    res.status(400).json({ error: 'resourceId is required' });
+    return;
+  }
+  if (!targetUserId || typeof targetUserId !== 'string') {
+    res.status(400).json({ error: 'userId is required' });
+    return;
+  }
+  if (!role || !isValidRole(role)) {
+    res.status(400).json({ error: 'role must be "viewer", "editor", or "owner"' });
+    return;
+  }
+
+  const resourceType_typed = resourceType as ResourceType;
+
+  // Validate resource exists
+  if (resourceType_typed === 'folder') {
+    if (!store.getFolder(resourceId)) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+  } else {
+    if (!store.getDocument(resourceId)) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+  }
+
+  // Sharer must have editor or owner access on the resource
+  if (!store.hasPermission(sharerId, resourceType_typed, resourceId, 'editor')) {
+    res.status(403).json({ error: 'Insufficient permissions to share this resource' });
+    return;
+  }
+
+  // Validate target user exists
+  const targetUser = store.getUserById(targetUserId);
+  if (!targetUser) {
+    res.status(404).json({ error: 'Target user not found' });
+    return;
+  }
+
+  // Cannot share with self
+  if (targetUserId === sharerId) {
+    res.status(400).json({ error: 'Cannot share a resource with yourself' });
+    return;
+  }
+
+  // Check for existing share with this user on this resource
+  const existingShares = store.getSharesForResource(resourceType_typed, resourceId);
+  const existing = existingShares.find(s => s.userId === targetUserId);
+  if (existing) {
+    // Update the existing share's role
+    const updated = store.updateShare(existing.id, role);
+    logActivity('share.update', sharerId, 'share', existing.id,
+      `Updated share for ${targetUser.username} on ${resourceType_typed} "${resourceId}" to ${role}`);
+    res.json(updated);
+    return;
+  }
+
+  const shareId = randomUUID();
+  const share = store.createShare(shareId, resourceType_typed, resourceId, targetUserId, role, sharerId);
+
+  logActivity('share.create', sharerId, 'share', shareId,
+    `Shared ${resourceType_typed} with ${targetUser.username} as ${role}`);
+
+  res.status(201).json(share);
+});
+
+router.get('/shares/:resourceType/:resourceId', requireAuth, (req: AuthRequest, res) => {
+  const userId = req.userId!;
+  const { resourceType, resourceId } = req.params;
+
+  if (resourceType !== 'folder' && resourceType !== 'document') {
+    res.status(400).json({ error: 'Invalid resource type' });
+    return;
+  }
+
+  const resourceType_typed = resourceType as ResourceType;
+
+  if (!store.hasPermission(userId, resourceType_typed, resourceId, 'owner')) {
+    res.status(403).json({ error: 'Only the owner can view shares' });
+    return;
+  }
+
+  const shares = store.getSharesForResource(resourceType_typed, resourceId);
+  res.json(shares);
+});
+
+router.put('/shares/:id', requireAuth, (req: AuthRequest, res) => {
+  const userId = req.userId!;
+  const { role } = req.body;
+
+  const share = store.getShare(req.params.id);
+  if (!share) {
+    res.status(404).json({ error: 'Share not found' });
+    return;
+  }
+
+  if (!role || !isValidRole(role)) {
+    res.status(400).json({ error: 'role must be "viewer", "editor", or "owner"' });
+    return;
+  }
+
+  // Only owner of the resource can change share roles
+  if (!store.hasPermission(userId, share.resourceType, share.resourceId, 'owner')) {
+    res.status(403).json({ error: 'Only the resource owner can modify shares' });
+    return;
+  }
+
+  const updated = store.updateShare(share.id, role);
+  logActivity('share.update', userId, 'share', share.id,
+    `Changed share role to ${role}`);
+  res.json(updated);
+});
+
+router.delete('/shares/:id', requireAuth, (req: AuthRequest, res) => {
+  const userId = req.userId!;
+  const share = store.getShare(req.params.id);
+
+  if (!share) {
+    res.status(404).json({ error: 'Share not found' });
+    return;
+  }
+
+  // Only owner of the resource can remove shares
+  if (!store.hasPermission(userId, share.resourceType, share.resourceId, 'owner')) {
+    res.status(403).json({ error: 'Only the resource owner can remove shares' });
+    return;
+  }
+
+  logActivity('share.delete', userId, 'share', share.id, `Removed share`);
+  store.deleteShare(share.id);
+
+  res.status(204).send();
+});
+
+// ── Activity Routes ───────────────────────────────────────────────────────────
+
+router.get('/activity', requireAuth, (req: AuthRequest, _res) => {
+  // Return all activity logs (any authenticated user can see them)
+  const logs = store.getActivityLogs();
+
+  // Optional filtering by userId
+  const filterUserId = req.query.userId as string | undefined;
+  const filtered = filterUserId ? logs.filter(l => l.userId === filterUserId) : logs;
+
+  _res.json(filtered);
+});
+
+export default router;
