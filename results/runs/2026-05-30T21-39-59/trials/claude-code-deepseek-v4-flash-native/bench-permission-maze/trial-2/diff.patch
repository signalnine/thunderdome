+// ── Types ────────────────────────────────────────────────────────────────────
+
+export interface User {
+  id: string;
+  username: string;
+  passwordHash: string;
+  createdAt: Date;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+export type Role = 'viewer' | 'editor' | 'owner';
+
+export type ResourceType = 'folder' | 'document';
+
+export interface Share {
+  id: string;
+  resourceType: ResourceType;
+  resourceId: string;
+  userId: string;
+  role: Role;
+  sharedBy: string;
+  createdAt: Date;
+}
+
+export type ActionType =
+  | 'document.create'
+  | 'document.update'
+  | 'document.delete'
+  | 'folder.create'
+  | 'folder.update'
+  | 'folder.delete'
+  | 'share.create'
+  | 'share.update'
+  | 'share.delete';
+
+export interface ActivityLog {
+  id: string;
+  actionType: ActionType;
+  userId: string;
+  targetType: ResourceType | 'share';
+  targetId: string;
+  details: string;
+  timestamp: Date;
+}
