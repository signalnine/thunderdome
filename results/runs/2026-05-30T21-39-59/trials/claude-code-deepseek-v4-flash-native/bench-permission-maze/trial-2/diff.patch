+// ── In-Memory Data Store ──────────────────────────────────────────────────────
+
+import type {
+  User,
+  Folder,
+  Document,
+  Share,
+  ActivityLog,
+  Role,
+  ResourceType,
+  ActionType,
+} from './types.js';
+
+// ── Store class ──────────────────────────────────────────────────────────────
+
+class Store {
+  users = new Map<string, User>();
+  folders = new Map<string, Folder>();
+  documents = new Map<string, Document>();
+  shares = new Map<string, Share>();
+  activityLogs: ActivityLog[] = [];
+
+  /** username → User */
+  usernameIndex = new Map<string, User>();
+  /** token → userId */
+  tokenIndex = new Map<string, string>();
+  /** folderId → children folder ids */
+  folderChildren = new Map<string, Set<string>>();
+  /** folderId → document ids */
+  folderDocuments = new Map<string, Set<string>>();
+  /** userId → share ids */
+  userShares = new Map<string, Set<string>>();
+  /** (resourceType, resourceId) → share ids */
+  resourceShares = new Map<string, string[]>();
+
+  // ── Users ──
+
+  createUser(id: string, username: string, passwordHash: string): User {
+    const user: User = { id, username, passwordHash, createdAt: new Date() };
+    this.users.set(id, user);
+    this.usernameIndex.set(username, user);
+    return user;
+  }
+
+  getUserById(id: string): User | undefined {
+    return this.users.get(id);
+  }
+
+  getUserByUsername(username: string): User | undefined {
+    return this.usernameIndex.get(username);
+  }
+
+  // ── Tokens ──
+
+  setToken(token: string, userId: string): void {
+    this.tokenIndex.set(token, userId);
+  }
+
+  getUserIdByToken(token: string): string | undefined {
+    return this.tokenIndex.get(token);
+  }
+
+  // ── Folders ──
+
+  createFolder(id: string, name: string, parentId: string | null, ownerId: string): Folder {
+    const folder: Folder = {
+      id, name, parentId, ownerId,
+      createdAt: new Date(),
+      updatedAt: new Date(),
+    };
+    this.folders.set(id, folder);
+    this.folderChildren.set(id, new Set());
+    if (parentId) {
+      const siblings = this.folderChildren.get(parentId);
+      if (siblings) {
+        siblings.add(id);
+      }
+    }
+    return folder;
+  }
+
+  getFolder(id: string): Folder | undefined {
+    return this.folders.get(id);
+  }
+
+  updateFolder(id: string, name?: string): Folder | undefined {
+    const folder = this.folders.get(id);
+    if (!folder) return undefined;
+    if (name !== undefined) folder.name = name;
+    folder.updatedAt = new Date();
+    return folder;
+  }
+
+  deleteFolder(id: string): void {
+    const folder = this.folders.get(id);
+    if (!folder) return;
+
+    // Remove from parent's children list
+    if (folder.parentId) {
+      const siblings = this.folderChildren.get(folder.parentId);
+      siblings?.delete(id);
+    }
+
+    // Recursively delete child folders
+    const childFolderIds = [...(this.folderChildren.get(id) ?? [])];
+    for (const childId of childFolderIds) {
+      this.deleteFolder(childId);
+    }
+
+    // Delete documents in this folder
+    const docIds = [...(this.folderDocuments.get(id) ?? [])];
+    for (const docId of docIds) {
+      this.deleteDocument(docId);
+    }
+
+    // Delete shares for this folder
+    const key = this.resourceKey('folder', id);
+    const shareIds = this.resourceShares.get(key) ?? [];
+    for (const shareId of shareIds) {
+      this.shares.delete(shareId);
+    }
+    this.resourceShares.delete(key);
+
+    this.folders.delete(id);
+    this.folderChildren.delete(id);
+    this.folderDocuments.delete(id);
+  }
+
+  getFolderChildren(parentId: string): Folder[] {
+    const childIds = this.folderChildren.get(parentId) ?? new Set();
+    return [...childIds].map(id => this.folders.get(id)).filter(Boolean) as Folder[];
+  }
+
+  getFolderDocuments(folderId: string): Document[] {
+    const docIds = this.folderDocuments.get(folderId) ?? new Set();
+    return [...docIds].map(id => this.documents.get(id)).filter(Boolean) as Document[];
+  }
+
+  // ── Documents ──
+
+  createDocument(id: string, title: string, content: string, folderId: string, ownerId: string): Document {
+    const doc: Document = {
+      id, title, content, folderId, ownerId,
+      createdAt: new Date(),
+      updatedAt: new Date(),
+    };
+    this.documents.set(id, doc);
+    const docs = this.folderDocuments.get(folderId);
+    if (docs) {
+      docs.add(id);
+    }
+    return doc;
+  }
+
+  getDocument(id: string): Document | undefined {
+    return this.documents.get(id);
+  }
+
+  updateDocument(id: string, title?: string, content?: string): Document | undefined {
+    const doc = this.documents.get(id);
+    if (!doc) return undefined;
+    if (title !== undefined) doc.title = title;
+    if (content !== undefined) doc.content = content;
+    doc.updatedAt = new Date();
+    return doc;
+  }
+
+  deleteDocument(id: string): void {
+    const doc = this.documents.get(id);
+    if (!doc) return;
+    const docs = this.folderDocuments.get(doc.folderId);
+    docs?.delete(id);
+
+    const key = this.resourceKey('document', id);
+    const shareIds = this.resourceShares.get(key) ?? [];
+    for (const shareId of shareIds) {
+      this.shares.delete(shareId);
+    }
+    this.resourceShares.delete(key);
+
+    this.documents.delete(id);
+  }
+
+  // ── Shares ──
+
+  createShare(id: string, resourceType: ResourceType, resourceId: string, userId: string, role: Role, sharedBy: string): Share {
+    const share: Share = {
+      id, resourceType, resourceId, userId, role, sharedBy,
+      createdAt: new Date(),
+    };
+    this.shares.set(id, share);
+
+    const key = this.resourceKey(resourceType, resourceId);
+    const existing = this.resourceShares.get(key) ?? [];
+    existing.push(id);
+    this.resourceShares.set(key, existing);
+
+    const userSet = this.userShares.get(userId) ?? new Set();
+    userSet.add(id);
+    this.userShares.set(userId, userSet);
+
+    return share;
+  }
+
+  getShare(id: string): Share | undefined {
+    return this.shares.get(id);
+  }
+
+  getSharesForResource(resourceType: ResourceType, resourceId: string): Share[] {
+    const key = this.resourceKey(resourceType, resourceId);
+    const ids = this.resourceShares.get(key) ?? [];
+    return ids.map(id => this.shares.get(id)).filter(Boolean) as Share[];
+  }
+
+  updateShare(id: string, role: Role): Share | undefined {
+    const share = this.shares.get(id);
+    if (!share) return undefined;
+    share.role = role;
+    return share;
+  }
+
+  deleteShare(id: string): void {
+    const share = this.shares.get(id);
+    if (!share) return;
+
+    const key = this.resourceKey(share.resourceType, share.resourceId);
+    const ids = this.resourceShares.get(key) ?? [];
+    this.resourceShares.set(key, ids.filter(sid => sid !== id));
+
+    const userSet = this.userShares.get(share.userId);
+    userSet?.delete(id);
+
+    this.shares.delete(id);
+  }
+
+  // ── Activity ──
+
+  addActivityLog(id: string, actionType: ActionType, userId: string, targetType: ResourceType | 'share', targetId: string, details: string): ActivityLog {
+    const log: ActivityLog = {
+      id, actionType, userId, targetType, targetId, details,
+      timestamp: new Date(),
+    };
+    this.activityLogs.push(log);
+    return log;
+  }
+
+  getActivityLogs(): ActivityLog[] {
+    return [...this.activityLogs].reverse();
+  }
+
+  // ── Permission helpers ──
+
+  resourceKey(resourceType: ResourceType, resourceId: string): string {
+    return `${resourceType}:${resourceId}`;
+  }
+
+  /** Get the most permissive role for a user on a resource */
+  getEffectivePermission(userId: string, resourceType: ResourceType, resourceId: string): Role | null {
+    if (resourceType === 'folder') {
+      return this.getFolderPermission(userId, resourceId);
+    }
+    return this.getDocumentPermission(userId, resourceId);
+  }
+
+  private getFolderPermission(userId: string, folderId: string): Role | null {
+    const folder = this.folders.get(folderId);
+    if (!folder) return null;
+
+    // Owner has full access
+    if (folder.ownerId === userId) return 'owner';
+
+    // Check direct shares on this folder
+    const directRole = this.getDirectShareRole(userId, 'folder', folderId);
+    if (directRole) return directRole;
+
+    // Check parent chain
+    if (folder.parentId) {
+      return this.getFolderPermission(userId, folder.parentId);
+    }
+
+    return null;
+  }
+
+  private getDocumentPermission(userId: string, docId: string): Role | null {
+    const doc = this.documents.get(docId);
+    if (!doc) return null;
+
+    // Owner has full access
+    if (doc.ownerId === userId) return 'owner';
+
+    // Check direct shares on this document
+    const directRole = this.getDirectShareRole(userId, 'document', docId);
+    if (directRole) return directRole;
+
+    // Check parent folder chain
+    return this.getFolderPermission(userId, doc.folderId);
+  }
+
+  private getDirectShareRole(userId: string, resourceType: ResourceType, resourceId: string): Role | null {
+    const key = this.resourceKey(resourceType, resourceId);
+    const shareIds = this.resourceShares.get(key) ?? [];
+    let bestRole: Role | null = null;
+    for (const shareId of shareIds) {
+      const share = this.shares.get(shareId);
+      if (share && share.userId === userId) {
+        const roleRank = { viewer: 0, editor: 1, owner: 2 };
+        if (!bestRole || roleRank[share.role] > roleRank[bestRole]) {
+          bestRole = share.role;
+        }
+      }
+    }
+    return bestRole;
+  }
+
+  /** Check if user has at least the given role on a resource */
+  hasPermission(userId: string, resourceType: ResourceType, resourceId: string, minimumRole: Role): boolean {
+    const effective = this.getEffectivePermission(userId, resourceType, resourceId);
+    if (!effective) return false;
+    const rank: Record<Role, number> = { viewer: 0, editor: 1, owner: 2 };
+    return rank[effective] >= rank[minimumRole];
+  }
+}
+
+// ── Singleton ──
+
+export const store = new Store();
