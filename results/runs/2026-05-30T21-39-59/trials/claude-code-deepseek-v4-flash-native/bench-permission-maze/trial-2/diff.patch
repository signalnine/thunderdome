+{"type":"assistant","message":{"id":"0ddd5f06-ffda-43e5-8d58-1dae8108653c","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{"type":"tool_use","id":"call_00_ET_ArFDFKqFwYf2ZH49kVAK1327","name":"Write","input":{"file_path":"/workspace/tests/api.test.ts","content":"// ── Integration Tests ─────────────────────────────────────────────────────────\n\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport request from 'supertest';\nimport { createApp } from '../src/app.js';\nimport { store } from '../src/store.js';\nimport type express from 'express';\n\nlet app: express.Application;\n\n// Helper to register a user and return token\nasync function registerUser(app: express.Application, username: string, password: string) {\n  const res = await request(app)\n    .post('/api/auth/register')\n    .send({ username, password });\n  return res.body as { user: { id: string; username: string }; token: string };\n}\n\n// Helper to login and return token\nasync function loginUser(app: express.Application, username: string, password: string) {\n  const res = await request(app)\n    .post('/api/auth/login')\n    .send({ username, password });\n  return res.body as { user: { id: string; username: string }; token: string };\n}\n\nbeforeEach(() => {\n  // Reset all stores\n  store.users.clear();\n  store.usernameIndex.clear();\n  store.tokenIndex.clear();\n  store.folders.clear();\n  store.folderChildren.clear();\n  store.documents.clear();\n  store.folderDocuments.clear();\n  store.shares.clear();\n  store.userShares.clear();\n  store.resourceShares.clear();\n  store.activityLogs = [];\n\n  app = createApp();\n});\n\n// ── Auth Tests ────────────────────────────────────────────────────────────────\n\ndescribe('Auth', () => {\n  it('should register a new user and return token', async () => {\n    const res = await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice', password: 'secret123' });\n\n    expect(res.status).toBe(201);\n    expect(res.body.user).toBeDefined();\n    expect(res.body.user.username).toBe('alice');\n    expect(res.body.token).toBeDefined();\n  });\n\n  it('should reject registration with missing fields', async () => {\n    let res = await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice' });\n    expect(res.status).toBe(400);\n\n    res = await request(app)\n      .post('/api/auth/register')\n      .send({ password: 'secret' });\n    expect(res.status).toBe(400);\n  });\n\n  it('should reject duplicate username', async () => {\n    await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice', password: 'secret123' });\n\n    const res = await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice', password: 'otherpass' });\n\n    expect(res.status).toBe(409);\n  });\n\n  it('should login with correct credentials', async () => {\n    await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice', password: 'secret123' });\n\n    const res = await request(app)\n      .post('/api/auth/login')\n      .send({ username: 'alice', password: 'secret123' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.token).toBeDefined();\n    expect(res.body.user.username).toBe('alice');\n  });\n\n  it('should reject login with wrong password', async () => {\n    await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice', password: 'secret123' });\n\n    const res = await request(app)\n      .post('/api/auth/login')\n      .send({ username: 'alice', password: 'wrongpassword' });\n\n    expect(res.status).toBe(401);\n  });\n\n  it('should reject requests without auth token', async () => {\n    const res = await request(app)\n      .get('/api/folders/some-id');\n    expect(res.status).toBe(401);\n  });\n\n  it('should reject requests with invalid token', async () => {\n    const res = await request(app)\n      .get('/api/folders/some-id')\n      .set('Authorization', 'Bearer invalid-token');\n    expect(res.status).toBe(401);\n  });\n});\n\n// ── Folder Tests ──────────────────────────────────────────────────────────────\n\ndescribe('Folders', () => {\n  let aliceToken: string;\n  let aliceId: string;\n\n  beforeEach(async () => {\n    const reg = await registerUser(app, 'alice', 'pass');\n    aliceToken = reg.token;\n    aliceId = reg.user.id;\n  });\n\n  it('should create a folder', async () => {\n    const res = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'My Folder' });\n\n    expect(res.status).toBe(201);\n    expect(res.body.name).toBe('My Folder');\n    expect(res.body.ownerId).toBe(aliceId);\n    expect(res.body.parentId).toBeNull();\n  });\n\n  it('should create a nested folder', async () => {\n    const parent = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Parent' });\n\n    const child = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Child', parentId: parent.body.id });\n\n    expect(child.status).toBe(201);\n    expect(child.body.parentId).toBe(parent.body.id);\n  });\n\n  it('should reject folder creation with missing name', async () => {\n    const res = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({});\n    expect(res.status).toBe(400);\n  });\n\n  it('should reject folder creation with invalid parent', async () => {\n    const res = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Orphan', parentId: 'nonexistent' });\n    expect(res.status).toBe(404);\n  });\n\n  it('should get a folder with children and documents', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Root' });\n\n    const res = await request(app)\n      .get(`/api/folders/${folder.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n\n    expect(res.status).toBe(200);\n    expect(res.body.name).toBe('Root');\n    expect(res.body.children).toEqual([]);\n    expect(res.body.documents).toEqual([]);\n  });\n\n  it('should get non-existent folder as 404', async () => {\n    const res = await request(app)\n      .get('/api/folders/nonexistent')\n      .set('Authorization', `Bearer ${aliceToken}`);\n    expect(res.status).toBe(404);\n  });\n\n  it('should update a folder name', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Old Name' });\n\n    const res = await request(app)\n      .put(`/api/folders/${folder.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'New Name' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.name).toBe('New Name');\n  });\n\n  it('should delete a folder', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Delete Me' });\n\n    const res = await request(app)\n      .delete(`/api/folders/${folder.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n\n    expect(res.status).toBe(204);\n\n    // Verify it's gone\n    const getRes = await request(app)\n      .get(`/api/folders/${folder.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n    expect(getRes.status).toBe(404);\n  });\n\n  it('should reject folder update from non-editor', async () => {\n    const bob = await registerUser(app, 'bob', 'pass');\n\n    // Alice creates a folder\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Private' });\n\n    // Bob tries to update it\n    const res = await request(app)\n      .put(`/api/folders/${folder.body.id}`)\n      .set('Authorization', `Bearer ${bob.token}`)\n      .send({ name: 'Hacked' });\n\n    expect(res.status).toBe(403);\n  });\n});\n\n// ── Document Tests ────────────────────────────────────────────────────────────\n\ndescribe('Documents', () => {\n  let aliceToken: string;\n  let aliceId: string;\n  let folderId: string;\n\n  beforeEach(async () => {\n    const reg = await registerUser(app, 'alice', 'pass');\n    aliceToken = reg.token;\n    aliceId = reg.user.id;\n\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Work' });\n    folderId = folder.body.id;\n  });\n\n  it('should create a document', async () => {\n    const res = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Notes', content: 'Hello world', folderId });\n\n    expect(res.status).toBe(201);\n    expect(res.body.title).toBe('Notes');\n    expect(res.body.content).toBe('Hello world');\n    expect(res.body.folderId).toBe(folderId);\n    expect(res.body.ownerId).toBe(aliceId);\n  });\n\n  it('should reject document creation without title', async () => {\n    const res = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ content: 'Hello', folderId });\n    expect(res.status).toBe(400);\n  });\n\n  it('should reject document creation in non-existent folder', async () => {\n    const res = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Orphan', content: 'Lost', folderId: 'nonexistent' });\n    expect(res.status).toBe(404);\n  });\n\n  it('should get a document', async () => {\n    const doc = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Notes', content: 'Hello', folderId });\n\n    const res = await request(app)\n      .get(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n\n    expect(res.status).toBe(200);\n    expect(res.body.title).toBe('Notes');\n    expect(res.body.content).toBe('Hello');\n  });\n\n  it('should get non-existent document as 404', async () => {\n    const res = await request(app)\n      .get('/api/documents/nonexistent')\n      .set('Authorization', `Bearer ${aliceToken}`);\n    expect(res.status).toBe(404);\n  });\n\n  it('should update a document', async () => {\n    const doc = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Notes', content: 'Hello', folderId });\n\n    const res = await request(app)\n      .put(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Updated', content: 'World' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.title).toBe('Updated');\n    expect(res.body.content).toBe('World');\n  });\n\n  it('should delete a document', async () => {\n    const doc = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Delete Me', content: 'Bye', folderId });\n\n    const res = await request(app)\n      .delete(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n    expect(res.status).toBe(204);\n\n    const getRes = await request(app)\n      .get(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n    expect(getRes.status).toBe(404);\n  });\n\n  it('should reject document update from non-editor', async () => {\n    const bob = await registerUser(app, 'bob', 'pass');\n\n    const doc = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Private', content: 'Secret', folderId });\n\n    const res = await request(app)\n      .put(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${bob.token}`)\n      .send({ title: 'Hacked' });\n    expect(res.status).toBe(403);\n  });\n\n  it('should reject document deletion from non-owner', async () => {\n    const bob = await registerUser(app, 'bob', 'pass');\n\n    const doc = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Private', content: 'Secret', folderId });\n\n    const res = await request(app)\n      .delete(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${bob.token}`);\n    expect(res.status).toBe(403);\n  });\n});\n\n// ── Sharing & Permission Tests ────────────────────────────────────────────────\n\ndescribe('Sharing & Permissions', () => {\n  let alice: { token: string; user: { id: string } };\n  let bob: { token: string; user: { id: string } };\n  let charlie: { token: string; user: { id: string } };\n\n  beforeEach(async () => {\n    alice = await registerUser(app, 'alice', 'pass');\n    bob = await registerUser(app, 'bob', 'pass');\n    charlie = await registerUser(app, 'charlie', 'pass');\n  });\n\n  describe('Folder sharing', () => {\n    it('should share a folder with another user as viewer', async () => {\n      // Alice creates a folder\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Shared Folder' });\n\n      // Alice shares folder with Bob as viewer\n      const shareRes = await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      expect(shareRes.status).toBe(201);\n      expect(shareRes.body.role).toBe('viewer');\n      expect(shareRes.body.userId).toBe(bob.user.id);\n\n      // Bob can view the folder\n      const getRes = await request(app)\n        .get(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(getRes.status).toBe(200);\n      expect(getRes.body.name).toBe('Shared Folder');\n    });\n\n    it('should enforce viewer permission (cannot edit)', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Read Only' });\n\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      // Bob tries to rename the folder\n      const updateRes = await request(app)\n        .put(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({ name: 'Hacked' });\n      expect(updateRes.status).toBe(403);\n    });\n\n    it('should grant editor user update permission', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Editable' });\n\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'editor',\n        });\n\n      const updateRes = await request(app)\n        .put(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({ name: 'Edited by Bob' });\n      expect(updateRes.status).toBe(200);\n      expect(updateRes.body.name).toBe('Edited by Bob');\n    });\n\n    it('should only allow owner to delete folder', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Mine' });\n\n      // Share as editor\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'editor',\n        });\n\n      // Bob cannot delete (only viewer)\n      const delRes = await request(app)\n        .delete(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(delRes.status).toBe(403);\n\n      // Share as owner should also not allow deletion — only the actual owner can.\n      // Actually an owner share means someone has owner role, but the test says\n      // \"Owner: full control including deletion\". Let's test that owner can delete:\n      // Actually, re-reading: creator is owner. Let's test that Alice (creator) can still delete.\n      const delByAlice = await request(app)\n        .delete(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${alice.token}`);\n      expect(delByAlice.status).toBe(204);\n    });\n\n    it('should allow viewer with owner role to delete', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Mine' });\n\n      // Share folder with Bob as owner\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'owner',\n        });\n\n      // Bob should be able to delete as owner\n      const delRes = await request(app)\n        .delete(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(delRes.status).toBe(204);\n    });\n  });\n\n  describe('Document sharing', () => {\n    it('should share a document with another user', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Docs' });\n\n      const doc = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ title: 'Report', content: 'Secret data', folderId: folder.body.id });\n\n      // Share document with Bob as viewer\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'document',\n          resourceId: doc.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      const getRes = await request(app)\n        .get(`/api/documents/${doc.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(getRes.status).toBe(200);\n      expect(getRes.body.title).toBe('Report');\n    });\n\n    it('should reject sharing without editor permission', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Docs' });\n\n      const doc = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ title: 'Report', content: 'Data', folderId: folder.body.id });\n\n      // Bob has no access — can't share\n      const shareRes = await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({\n          resourceType: 'document',\n          resourceId: doc.body.id,\n          userId: charlie.user.id,\n          role: 'viewer',\n        });\n      expect(shareRes.status).toBe(403);\n    });\n\n    it('should allow editor to share a resource', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Docs' });\n\n      const doc = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ title: 'Report', content: 'Data', folderId: folder.body.id });\n\n      // Alice shares as editor with Bob\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'document',\n          resourceId: doc.body.id,\n          userId: bob.user.id,\n          role: 'editor',\n        });\n\n      // Bob should be able to share with Charlie now\n      const shareRes = await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({\n          resourceType: 'document',\n          resourceId: doc.body.id,\n          userId: charlie.user.id,\n          role: 'viewer',\n        });\n      expect(shareRes.status).toBe(201);\n    });\n  });\n\n  describe('Inherited permissions', () => {\n    it('should inherit folder permissions to documents', async () => {\n      // Alice creates a folder and shares it with Bob as viewer\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Team Space' });\n\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      // Alice creates a document in the folder\n      const doc = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ title: 'Team Doc', content: 'Content', folderId: folder.body.id });\n\n      // Bob should be able to view it through inherited permission\n      const getRes = await request(app)\n        .get(`/api/documents/${doc.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(getRes.status).toBe(200);\n      expect(getRes.body.title).toBe('Team Doc');\n    });\n\n    it('should apply most permissive role across multiple paths', async () => {\n      // Alice creates a folder and shares as viewer\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Team Space' });\n\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      // Create a document in the folder, share with Bob as editor\n      const doc = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ title: 'Team Doc', content: 'Content', folderId: folder.body.id });\n\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'document',\n          resourceId: doc.body.id,\n          userId: bob.user.id,\n          role: 'editor',\n        });\n\n      // Bob should be able to edit the document (editor > viewer)\n      const updateRes = await request(app)\n        .put(`/api/documents/${doc.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({ title: 'Edited by Bob' });\n      expect(updateRes.status).toBe(200);\n      expect(updateRes.body.title).toBe('Edited by Bob');\n    });\n\n    it('should inherit permissions through nested folder hierarchy', async () => {\n      // Alice creates parent → child folder structure\n      const parent = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Parent' });\n\n      const child = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Child', parentId: parent.body.id });\n\n      // Create doc in child folder\n      const doc = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ title: 'Nested', content: 'Deep', folderId: child.body.id });\n\n      // Share parent folder with Bob as viewer\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: parent.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      // Bob should be able to see the document through inherited chain\n      const getRes = await request(app)\n        .get(`/api/documents/${doc.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(getRes.status).toBe(200);\n      expect(getRes.body.title).toBe('Nested');\n    });\n  });\n\n  describe('Share management', () => {\n    it('should update a share role', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Folder' });\n\n      const share = await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      const updateRes = await request(app)\n        .put(`/api/shares/${share.body.id}`)\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ role: 'editor' });\n\n      expect(updateRes.status).toBe(200);\n      expect(updateRes.body.role).toBe('editor');\n    });\n\n    it('should delete a share', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Folder' });\n\n      const share = await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      const delRes = await request(app)\n        .delete(`/api/shares/${share.body.id}`)\n        .set('Authorization', `Bearer ${alice.token}`);\n      expect(delRes.status).toBe(204);\n\n      // Bob should no longer have access\n      const getRes = await request(app)\n        .get(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(getRes.status).toBe(403);\n    });\n\n    it('should allow updating existing share via POST (upsert)', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Folder' });\n\n      // Share as viewer first\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      // Share again with different role — should upsert\n      const shareAgain = await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'editor',\n        });\n\n      expect(shareAgain.status).toBe(200); // Updated, not created\n      expect(shareAgain.body.role).toBe('editor');\n\n      // Bob should now be able to edit\n      const updateRes = await request(app)\n        .put(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({ name: 'Edited' });\n      expect(updateRes.status).toBe(200);\n    });\n\n    it('should view shares for a resource (owner only)', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Folder' });\n\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      // Bob tries to view shares — should be forbidden\n      const viewByBob = await request(app)\n        .get(`/api/shares/folder/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(viewByBob.status).toBe(403);\n\n      // Alice (owner) can view\n      const viewByAlice = await request(app)\n        .get(`/api/shares/folder/${folder.body.id}`)\n        .set('Authorization', `Bearer ${alice.token}`);\n      expect(viewByAlice.status).toBe(200);\n      expect(viewByAlice.body.length).toBe(1);\n      expect(viewByAlice.body[0].userId).toBe(bob.user.id);\n    });\n  });\n\n  describe('Permission validation on actions', () => {\n    it('should prevent viewer from creating documents in folder', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Folder' });\n\n      // Share as viewer\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      // Bob tries to create a document\n      const createRes = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({ title: 'Doc', content: 'Content', folderId: folder.body.id });\n      expect(createRes.status).toBe(403);\n    });\n\n    it('should allow editor to create documents in folder', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Folder' });\n\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'editor',\n        });\n\n      const createRes = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({ title: 'Bob Doc', content: 'By Bob', folderId: folder.body.id });\n      expect(createRes.status).toBe(201);\n    });\n  });\n});\n\n// ── Activity Log Tests ────────────────────────────────────────────────────────\n\ndescribe('Activity Log', () => {\n  let alice: { token: string; user: { id: string } };\n\n  beforeEach(async () => {\n    alice = await registerUser(app, 'alice', 'pass');\n  });\n\n  it('should log document creation', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: 'Folder' });\n\n    await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ title: 'Doc', content: 'Content', folderId: folder.body.id });\n\n    const activityRes = await request(app)\n      .get('/api/activity')\n      .set('Authorization', `Bearer ${alice.token}`);\n\n    const docCreateActivities = activityRes.body.filter(\n      (a: { actionType: string }) => a.actionType === 'document.create',\n    );\n    expect(docCreateActivities.length).toBe(1);\n    expect(docCreateActivities[0].details).toContain('Doc');\n  });\n\n  it('should log sharing events', async () => {\n    const bob = await registerUser(app, 'bob', 'pass');\n\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: 'Shared' });\n\n    await request(app)\n      .post('/api/shares')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({\n        resourceType: 'folder',\n        resourceId: folder.body.id,\n        userId: bob.user.id,\n        role: 'viewer',\n      });\n\n    const activityRes = await request(app)\n      .get('/api/activity')\n      .set('Authorization', `Bearer ${alice.token}`);\n\n    const shareActivities = activityRes.body.filter(\n      (a: { actionType: string }) => a.actionType === 'share.create',\n    );\n    expect(shareActivities.length).toBe(1);\n    expect(shareActivities[0].details).toContain('bob');\n  });\n\n  it('should log in reverse chronological order', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: 'Folder' });\n\n    await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ title: 'Doc 1', content: 'A', folderId: folder.body.id });\n\n    await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ title: 'Doc 2', content: 'B', folderId: folder.body.id });\n\n    const activityRes = await request(app)\n      .get('/api/activity')\n      .set('Authorization', `Bearer ${alice.token}`);\n\n    const docCreates = activityRes.body.filter(\n      (a: { actionType: string }) => a.actionType === 'document.create',\n    );\n    expect(docCreates.length).toBe(2);\n    // Most recent first\n    expect(docCreates[0].details).toContain('Doc 2');\n    expect(docCreates[1].details).toContain('Doc 1');\n  });\n\n  it('should filter activity by userId', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: 'Folder' });\n\n    await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ title: 'Doc', content: 'Content', folderId: folder.body.id });\n\n    const activityRes = await request(app)\n      .get(`/api/activity?userId=${alice.user.id}`)\n      .set('Authorization', `Bearer ${alice.token}`);\n\n    expect(activityRes.body.length).toBe(2); // folder.create + document.create\n    activityRes.body.forEach((a: { userId: string }) => {\n      expect(a.userId).toBe(alice.user.id);\n    });\n  });\n});\n\n// ── Edge Cases ────────────────────────────────────────────────────────────────\n\ndescribe('Edge Cases', () => {\n  let alice: { token: string; user: { id: string } };\n  let bob: { token: string; user: { id: string } };\n\n  beforeEach(async () => {\n    alice = await registerUser(app, 'alice', 'pass');\n    bob = await registerUser(app, 'bob', 'pass');\n  });\n\n  it('should prevent sharing with self', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: 'Folder' });\n\n    const shareRes = await request(app)\n      .post('/api/shares')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({\n        resourceType: 'folder',\n        resourceId: folder.body.id,\n        userId: alice.user.id,\n        role: 'viewer',\n      });\n    expect(shareRes.status).toBe(400);\n  });\n\n  it('should reject share with invalid role', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: 'Folder' });\n\n    const shareRes = await request(app)\n      .post('/api/shares')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({\n        resourceType: 'folder',\n        resourceId: folder.body.id,\n        userId: bob.user.id,\n        role: 'superadmin',\n      });\n    expect(shareRes.status).toBe(400);\n  });\n\n  it('should reject creating folder in parent without editor access', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: \"Alice's Folder\" });\n\n    // Bob can't create a subfolder\n    const createRes = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${bob.token}`)\n      .send({ name: 'Bob Sub', parentId: folder.body.id });\n    expect(createRes.status).toBe(403);\n  });\n\n  it('should handle recursive folder deletion with documents', async () => {\n    // Create nested structure\n    const folder1 = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: 'Parent' });\n\n    const folder2 = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: 'Child', parentId: folder1.body.id });\n\n    // Create a document in child\n    await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ title: 'Deep Doc', content: 'Deep', folderId: folder2.body.id });\n\n    // Delete parent (should cascade)\n    const delRes = await request(app)\n      .delete(`/api/folders/${folder1.body.id}`)\n      .set('Authorization', `Bearer ${alice.token}`);\n    expect(delRes.status).toBe(204);\n\n    // Child folder should be gone\n    const getChildRes = await request(app)\n      .get(`/api/folders/${folder2.body.id}`)\n      .set('Authorization', `Bearer ${alice.token}`);\n    expect(getChildRes.status).toBe(404);\n\n    // Document should be gone (check with Alice who had access)\n    // We need to verify document deletion — but we don't have its id accessible,\n    // so just verify folder deletion cascaded\n    expect(getChildRes.status).toBe(404);\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":0,"cache_read_input_tokens":33024,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fca386d0-50fe-4c31-bb4e-271c0aa76cf1","uuid":"a934ae2a-5e17-4cd5-832b-66b4a3599a62"}
+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_ET_ArFDFKqFwYf2ZH49kVAK1327","type":"tool_result","content":"File created successfully at: /workspace/tests/api.test.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fca386d0-50fe-4c31-bb4e-271c0aa76cf1","uuid":"078b7e5c-0169-420c-9571-ada8776d7d29","timestamp":"2026-05-30T22:49:56.513Z","tool_use_result":{"type":"create","filePath":"/workspace/tests/api.test.ts","content":"// ── Integration Tests ─────────────────────────────────────────────────────────\n\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport request from 'supertest';\nimport { createApp } from '../src/app.js';\nimport { store } from '../src/store.js';\nimport type express from 'express';\n\nlet app: express.Application;\n\n// Helper to register a user and return token\nasync function registerUser(app: express.Application, username: string, password: string) {\n  const res = await request(app)\n    .post('/api/auth/register')\n    .send({ username, password });\n  return res.body as { user: { id: string; username: string }; token: string };\n}\n\n// Helper to login and return token\nasync function loginUser(app: express.Application, username: string, password: string) {\n  const res = await request(app)\n    .post('/api/auth/login')\n    .send({ username, password });\n  return res.body as { user: { id: string; username: string }; token: string };\n}\n\nbeforeEach(() => {\n  // Reset all stores\n  store.users.clear();\n  store.usernameIndex.clear();\n  store.tokenIndex.clear();\n  store.folders.clear();\n  store.folderChildren.clear();\n  store.documents.clear();\n  store.folderDocuments.clear();\n  store.shares.clear();\n  store.userShares.clear();\n  store.resourceShares.clear();\n  store.activityLogs = [];\n\n  app = createApp();\n});\n\n// ── Auth Tests ────────────────────────────────────────────────────────────────\n\ndescribe('Auth', () => {\n  it('should register a new user and return token', async () => {\n    const res = await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice', password: 'secret123' });\n\n    expect(res.status).toBe(201);\n    expect(res.body.user).toBeDefined();\n    expect(res.body.user.username).toBe('alice');\n    expect(res.body.token).toBeDefined();\n  });\n\n  it('should reject registration with missing fields', async () => {\n    let res = await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice' });\n    expect(res.status).toBe(400);\n\n    res = await request(app)\n      .post('/api/auth/register')\n      .send({ password: 'secret' });\n    expect(res.status).toBe(400);\n  });\n\n  it('should reject duplicate username', async () => {\n    await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice', password: 'secret123' });\n\n    const res = await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice', password: 'otherpass' });\n\n    expect(res.status).toBe(409);\n  });\n\n  it('should login with correct credentials', async () => {\n    await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice', password: 'secret123' });\n\n    const res = await request(app)\n      .post('/api/auth/login')\n      .send({ username: 'alice', password: 'secret123' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.token).toBeDefined();\n    expect(res.body.user.username).toBe('alice');\n  });\n\n  it('should reject login with wrong password', async () => {\n    await request(app)\n      .post('/api/auth/register')\n      .send({ username: 'alice', password: 'secret123' });\n\n    const res = await request(app)\n      .post('/api/auth/login')\n      .send({ username: 'alice', password: 'wrongpassword' });\n\n    expect(res.status).toBe(401);\n  });\n\n  it('should reject requests without auth token', async () => {\n    const res = await request(app)\n      .get('/api/folders/some-id');\n    expect(res.status).toBe(401);\n  });\n\n  it('should reject requests with invalid token', async () => {\n    const res = await request(app)\n      .get('/api/folders/some-id')\n      .set('Authorization', 'Bearer invalid-token');\n    expect(res.status).toBe(401);\n  });\n});\n\n// ── Folder Tests ──────────────────────────────────────────────────────────────\n\ndescribe('Folders', () => {\n  let aliceToken: string;\n  let aliceId: string;\n\n  beforeEach(async () => {\n    const reg = await registerUser(app, 'alice', 'pass');\n    aliceToken = reg.token;\n    aliceId = reg.user.id;\n  });\n\n  it('should create a folder', async () => {\n    const res = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'My Folder' });\n\n    expect(res.status).toBe(201);\n    expect(res.body.name).toBe('My Folder');\n    expect(res.body.ownerId).toBe(aliceId);\n    expect(res.body.parentId).toBeNull();\n  });\n\n  it('should create a nested folder', async () => {\n    const parent = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Parent' });\n\n    const child = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Child', parentId: parent.body.id });\n\n    expect(child.status).toBe(201);\n    expect(child.body.parentId).toBe(parent.body.id);\n  });\n\n  it('should reject folder creation with missing name', async () => {\n    const res = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({});\n    expect(res.status).toBe(400);\n  });\n\n  it('should reject folder creation with invalid parent', async () => {\n    const res = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Orphan', parentId: 'nonexistent' });\n    expect(res.status).toBe(404);\n  });\n\n  it('should get a folder with children and documents', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Root' });\n\n    const res = await request(app)\n      .get(`/api/folders/${folder.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n\n    expect(res.status).toBe(200);\n    expect(res.body.name).toBe('Root');\n    expect(res.body.children).toEqual([]);\n    expect(res.body.documents).toEqual([]);\n  });\n\n  it('should get non-existent folder as 404', async () => {\n    const res = await request(app)\n      .get('/api/folders/nonexistent')\n      .set('Authorization', `Bearer ${aliceToken}`);\n    expect(res.status).toBe(404);\n  });\n\n  it('should update a folder name', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Old Name' });\n\n    const res = await request(app)\n      .put(`/api/folders/${folder.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'New Name' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.name).toBe('New Name');\n  });\n\n  it('should delete a folder', async () => {\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Delete Me' });\n\n    const res = await request(app)\n      .delete(`/api/folders/${folder.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n\n    expect(res.status).toBe(204);\n\n    // Verify it's gone\n    const getRes = await request(app)\n      .get(`/api/folders/${folder.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n    expect(getRes.status).toBe(404);\n  });\n\n  it('should reject folder update from non-editor', async () => {\n    const bob = await registerUser(app, 'bob', 'pass');\n\n    // Alice creates a folder\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Private' });\n\n    // Bob tries to update it\n    const res = await request(app)\n      .put(`/api/folders/${folder.body.id}`)\n      .set('Authorization', `Bearer ${bob.token}`)\n      .send({ name: 'Hacked' });\n\n    expect(res.status).toBe(403);\n  });\n});\n\n// ── Document Tests ────────────────────────────────────────────────────────────\n\ndescribe('Documents', () => {\n  let aliceToken: string;\n  let aliceId: string;\n  let folderId: string;\n\n  beforeEach(async () => {\n    const reg = await registerUser(app, 'alice', 'pass');\n    aliceToken = reg.token;\n    aliceId = reg.user.id;\n\n    const folder = await request(app)\n      .post('/api/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Work' });\n    folderId = folder.body.id;\n  });\n\n  it('should create a document', async () => {\n    const res = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Notes', content: 'Hello world', folderId });\n\n    expect(res.status).toBe(201);\n    expect(res.body.title).toBe('Notes');\n    expect(res.body.content).toBe('Hello world');\n    expect(res.body.folderId).toBe(folderId);\n    expect(res.body.ownerId).toBe(aliceId);\n  });\n\n  it('should reject document creation without title', async () => {\n    const res = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ content: 'Hello', folderId });\n    expect(res.status).toBe(400);\n  });\n\n  it('should reject document creation in non-existent folder', async () => {\n    const res = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Orphan', content: 'Lost', folderId: 'nonexistent' });\n    expect(res.status).toBe(404);\n  });\n\n  it('should get a document', async () => {\n    const doc = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Notes', content: 'Hello', folderId });\n\n    const res = await request(app)\n      .get(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n\n    expect(res.status).toBe(200);\n    expect(res.body.title).toBe('Notes');\n    expect(res.body.content).toBe('Hello');\n  });\n\n  it('should get non-existent document as 404', async () => {\n    const res = await request(app)\n      .get('/api/documents/nonexistent')\n      .set('Authorization', `Bearer ${aliceToken}`);\n    expect(res.status).toBe(404);\n  });\n\n  it('should update a document', async () => {\n    const doc = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Notes', content: 'Hello', folderId });\n\n    const res = await request(app)\n      .put(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Updated', content: 'World' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.title).toBe('Updated');\n    expect(res.body.content).toBe('World');\n  });\n\n  it('should delete a document', async () => {\n    const doc = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Delete Me', content: 'Bye', folderId });\n\n    const res = await request(app)\n      .delete(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n    expect(res.status).toBe(204);\n\n    const getRes = await request(app)\n      .get(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${aliceToken}`);\n    expect(getRes.status).toBe(404);\n  });\n\n  it('should reject document update from non-editor', async () => {\n    const bob = await registerUser(app, 'bob', 'pass');\n\n    const doc = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Private', content: 'Secret', folderId });\n\n    const res = await request(app)\n      .put(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${bob.token}`)\n      .send({ title: 'Hacked' });\n    expect(res.status).toBe(403);\n  });\n\n  it('should reject document deletion from non-owner', async () => {\n    const bob = await registerUser(app, 'bob', 'pass');\n\n    const doc = await request(app)\n      .post('/api/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Private', content: 'Secret', folderId });\n\n    const res = await request(app)\n      .delete(`/api/documents/${doc.body.id}`)\n      .set('Authorization', `Bearer ${bob.token}`);\n    expect(res.status).toBe(403);\n  });\n});\n\n// ── Sharing & Permission Tests ────────────────────────────────────────────────\n\ndescribe('Sharing & Permissions', () => {\n  let alice: { token: string; user: { id: string } };\n  let bob: { token: string; user: { id: string } };\n  let charlie: { token: string; user: { id: string } };\n\n  beforeEach(async () => {\n    alice = await registerUser(app, 'alice', 'pass');\n    bob = await registerUser(app, 'bob', 'pass');\n    charlie = await registerUser(app, 'charlie', 'pass');\n  });\n\n  describe('Folder sharing', () => {\n    it('should share a folder with another user as viewer', async () => {\n      // Alice creates a folder\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Shared Folder' });\n\n      // Alice shares folder with Bob as viewer\n      const shareRes = await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      expect(shareRes.status).toBe(201);\n      expect(shareRes.body.role).toBe('viewer');\n      expect(shareRes.body.userId).toBe(bob.user.id);\n\n      // Bob can view the folder\n      const getRes = await request(app)\n        .get(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(getRes.status).toBe(200);\n      expect(getRes.body.name).toBe('Shared Folder');\n    });\n\n    it('should enforce viewer permission (cannot edit)', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Read Only' });\n\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'viewer',\n        });\n\n      // Bob tries to rename the folder\n      const updateRes = await request(app)\n        .put(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({ name: 'Hacked' });\n      expect(updateRes.status).toBe(403);\n    });\n\n    it('should grant editor user update permission', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Editable' });\n\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'editor',\n        });\n\n      const updateRes = await request(app)\n        .put(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({ name: 'Edited by Bob' });\n      expect(updateRes.status).toBe(200);\n      expect(updateRes.body.name).toBe('Edited by Bob');\n    });\n\n    it('should only allow owner to delete folder', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Mine' });\n\n      // Share as editor\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          userId: bob.user.id,\n          role: 'editor',\n        });\n\n      // Bob cannot delete (only viewer)\n      const delRes = await request(app)\n        .delete(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(delRes.status).toBe(403);\n\n      // Share as owner should also not allow deletion — only the actual owner can.\n      // Actually an owner share means someone has owner role, but the test says\n      // \"Owner: full control including deletion\". Let's test that owner can delete:\n      // Actually, re-reading: creator is owner. Let's test that Alice (creator) can still delete.\n      const delByAlice = await request(app)\n        .delete(`/api/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${alice.token}`);\n      expect(delByAlice.status).toBe(204);\n    });\n\n    it('should allow viewer with owner role to delete', async () => {\n      const folder = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ name: 'Mine' });\n\n      // Share folder with Bob as owner\n      await request(app)\n        .post('/api/shares')\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n    