+++ b/src/routes/documentRoutes.ts
@@ -0,0 +1,147 @@
+import { Router, type Response } from 'express';
+import { store } from '../store.js';
+import { requireAuth, type AuthRequest } from '../auth.js';
+
+const router = Router();
+
+router.use(requireAuth);
+
+// POST /api/documents
+router.post('/', (req: AuthRequest, res: Response): void => {
+  const { title, content, folderId } = req.body;
+
+  if (!title || typeof title !== 'string' || title.trim().length === 0) {
+    res.status(400).json({ error: 'Title is required and must be a non-empty string' });
+    return;
+  }
+
+  if (typeof content !== 'string') {
+    res.status(400).json({ error: 'Content must be a string' });
+    return;
+  }
+
+  if (!folderId) {
+    res.status(400).json({ error: 'Folder ID is required' });
+    return;
+  }
+
+  const folder = store.getFolder(folderId);
+  if (!folder) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  // Need at least editor on the parent folder to create documents
+  const perm = store.getEffectiveFolderPermission(folderId, req.user!.id);
+  if (!perm || perm === 'viewer') {
+    res.status(403).json({ error: 'Insufficient permissions to create document in this folder' });
+    return;
+  }
+
+  const doc = store.createDocument(title.trim(), content, folderId, req.user!.id);
+
+  store.addActivity(
+    'document:create',
+    req.user!.id,
+    req.user!.username,
+    'document',
+    doc.id,
+    doc.title,
+    { folderId },
+  );
+
+  res.status(201).json(doc);
+});
+
+// GET /api/documents/:id
+router.get('/:id', (req: AuthRequest, res: Response): void => {
+  const doc = store.getDocument(req.params.id);
+  if (!doc) {
+    res.status(404).json({ error: 'Document not found' });
+    return;
+  }
+
+  const perm = store.getEffectiveDocumentPermission(doc.id, req.user!.id);
+  if (!perm) {
+    res.status(404).json({ error: 'Document not found' });
+    return;
+  }
+
+  res.json({ ...doc, permission: perm });
+});
+
+// PUT /api/documents/:id
+router.put('/:id', (req: AuthRequest, res: Response): void => {
+  const { title, content } = req.body;
+
+  if (!title || typeof title !== 'string' || title.trim().length === 0) {
+    res.status(400).json({ error: 'Title is required and must be a non-empty string' });
+    return;
+  }
+
+  if (typeof content !== 'string') {
+    res.status(400).json({ error: 'Content must be a string' });
+    return;
+  }
+
+  const doc = store.getDocument(req.params.id);
+  if (!doc) {
+    res.status(404).json({ error: 'Document not found' });
+    return;
+  }
+
+  const perm = store.getEffectiveDocumentPermission(doc.id, req.user!.id);
+  if (!perm) {
+    res.status(404).json({ error: 'Document not found' });
+    return;
+  }
+  if (perm === 'viewer') {
+    res.status(403).json({ error: 'Insufficient permissions to update this document' });
+    return;
+  }
+
+  const updated = store.updateDocument(doc.id, title.trim(), content);
+
+  store.addActivity(
+    'document:update',
+    req.user!.id,
+    req.user!.username,
+    'document',
+    doc.id,
+    doc.title,
+    { oldTitle: doc.title, newTitle: title.trim() },
+  );
+
+  res.json(updated);
+});
+
+// DELETE /api/documents/:id
+router.delete('/:id', (req: AuthRequest, res: Response): void => {
+  const doc = store.getDocument(req.params.id);
+  if (!doc) {
+    res.status(404).json({ error: 'Document not found' });
+    return;
+  }
+
+  const perm = store.getEffectiveDocumentPermission(doc.id, req.user!.id);
+  if (perm !== 'owner') {
+    res.status(403).json({ error: 'Only the owner can delete this document' });
+    return;
+  }
+
+  const docTitle = doc.title;
+  store.deleteDocument(doc.id);
+
+  store.addActivity(
+    'document:delete',
+    req.user!.id,
+    req.user!.username,
+    'document',
+    req.params.id,
+    docTitle,
+  );
+
+  res.status(204).send();
+});
+
+export default router;
