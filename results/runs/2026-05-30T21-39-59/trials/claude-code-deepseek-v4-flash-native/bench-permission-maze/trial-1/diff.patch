+import { Router, type Response } from 'express';
+import { store } from '../store.js';
+import { requireAuth, type AuthRequest } from '../auth.js';
+
+const router = Router();
+
+router.use(requireAuth);
+
+// POST /api/folders
+router.post('/', (req: AuthRequest, res: Response): void => {
+  const { name, parentId } = req.body;
+
+  if (!name || typeof name !== 'string' || name.trim().length === 0) {
+    res.status(400).json({ error: 'Name is required and must be a non-empty string' });
+    return;
+  }
+
+  // If parentId is provided, verify the user has editor access on the parent
+  if (parentId) {
+    const parentFolder = store.getFolder(parentId);
+    if (!parentFolder) {
+      res.status(404).json({ error: 'Parent folder not found' });
+      return;
+    }
+
+    const perm = store.getEffectiveFolderPermission(parentId, req.user!.id);
+    if (!perm || perm === 'viewer') {
+      res.status(403).json({ error: 'Insufficient permissions to create folder here' });
+      return;
+    }
+  }
+
+  const folder = store.createFolder(name.trim(), parentId ?? null, req.user!.id);
+
+  store.addActivity(
+    'folder:create',
+    req.user!.id,
+    req.user!.username,
+    'folder',
+    folder.id,
+    folder.name,
+    { parentId: folder.parentId },
+  );
+
+  res.status(201).json(folder);
+});
+
+// GET /api/folders/:id
+router.get('/:id', (req: AuthRequest, res: Response): void => {
+  const folder = store.getFolder(req.params.id);
+  if (!folder) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  const perm = store.getEffectiveFolderPermission(folder.id, req.user!.id);
+  if (!perm) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  res.json({ ...folder, permission: perm });
+});
+
+// PUT /api/folders/:id
+router.put('/:id', (req: AuthRequest, res: Response): void => {
+  const { name } = req.body;
+
+  if (!name || typeof name !== 'string' || name.trim().length === 0) {
+    res.status(400).json({ error: 'Name is required and must be a non-empty string' });
+    return;
+  }
+
+  const folder = store.getFolder(req.params.id);
+  if (!folder) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  const perm = store.getEffectiveFolderPermission(folder.id, req.user!.id);
+  if (!perm) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+  if (perm === 'viewer') {
+    res.status(403).json({ error: 'Insufficient permissions to update this folder' });
+    return;
+  }
+
+  const oldName = folder.name;
+  const updated = store.updateFolder(folder.id, name.trim());
+
+  store.addActivity(
+    'folder:update',
+    req.user!.id,
+    req.user!.username,
+    'folder',
+    folder.id,
+    folder.name,
+    { oldName, newName: name.trim() },
+  );
+
+  res.json(updated);
+});
+
+// DELETE /api/folders/:id
+router.delete('/:id', (req: AuthRequest, res: Response): void => {
+  const folder = store.getFolder(req.params.id);
+  if (!folder) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  const perm = store.getEffectiveFolderPermission(folder.id, req.user!.id);
+  if (perm !== 'owner') {
+    res.status(403).json({ error: 'Only the owner can delete this folder' });
+    return;
+  }
+
+  const folderName = folder.name;
+  store.deleteFolder(folder.id);
+
+  store.addActivity(
+    'folder:delete',
+    req.user!.id,
+    req.user!.username,
+    'folder',
+    req.params.id,
+    folderName,
+  );
+
+  res.status(204).send();
+});
+
+// GET /api/folders/:id/documents
+router.get('/:id/documents', (req: AuthRequest, res: Response): void => {
+  const folder = store.getFolder(req.params.id);
+  if (!folder) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  const perm = store.getEffectiveFolderPermission(folder.id, req.user!.id);
+  if (!perm) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  const docs = store.getDocumentsInFolder(folder.id);
+  res.json(docs);
+});
+
+// GET /api/folders/:id/folders — list child folders
+router.get('/:id/folders', (req: AuthRequest, res: Response): void => {
+  const folder = store.getFolder(req.params.id);
+  if (!folder) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  const perm = store.getEffectiveFolderPermission(folder.id, req.user!.id);
+  if (!perm) {
+    res.status(404).json({ error: 'Folder not found' });
+    return;
+  }
+
+  const children = store.getChildFolders(folder.id);
+  res.json(children);
+});
+
+export default router;
