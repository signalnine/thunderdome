     expect(res.status).toBe(409);\n      expect(res.body.error).toBe('Username already exists');\n    });\n\n    it('should login an existing user', async () => {\n      await request(app)\n        .post('/api/auth/register')\n        .send({ username: 'alice', password: 'secret' });\n\n      const res = await request(app)\n        .post('/api/auth/login')\n        .send({ username: 'alice', password: 'secret' });\n\n      expect(res.status).toBe(200);\n      expect(res.body.user.username).toBe('alice');\n      expect(res.body.token).toBeDefined();\n    });\n\n    it('should reject login with wrong password', async () => {\n      await request(app)\n        .post('/api/auth/register')\n        .send({ username: 'alice', password: 'secret' });\n\n      const res = await request(app)\n        .post('/api/auth/login')\n        .send({ username: 'alice', password: 'wrong' });\n\n      expect(res.status).toBe(401);\n    });\n\n    it('should reject unauthenticated requests', async () => {\n      const res = await request(app)\n        .post('/api/folders')\n        .send({ name: 'My Folder' });\n\n      expect(res.status).toBe(401);\n    });\n\n    it('should reject requests with invalid token', async () => {\n      const res = await request(app)\n        .post('/api/folders')\n        .set('Authorization', 'Bearer invalid-token')\n        .send({ name: 'My Folder' });\n\n      expect(res.status).toBe(401);\n    });\n\n    it('should require username and password for register', async () => {\n      const res1 = await request(app).post('/api/auth/register').send({ username: 'alice' });\n      expect(res1.status).toBe(400);\n\n      const res2 = await request(app).post('/api/auth/register').send({ password: 'secret' });\n      expect(res2.status).toBe(400);\n    });\n  });\n\n  // ── Folders ──────────────────────────────────────────────────\n\n  describe('Folders', () => {\n    let token: string;\n\n    beforeEach(async () => {\n      token = await registerUser('alice', 