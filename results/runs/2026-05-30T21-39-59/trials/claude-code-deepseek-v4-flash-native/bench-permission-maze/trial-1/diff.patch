+{"type":"assistant","message":{"id":"0b887806-a39a-4fc5-bbbb-5b7d583018f3","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{"type":"tool_use","id":"call_00_ET_Pcrnnp52p29cuQnWiefn6053","name":"Write","input":{"file_path":"/workspace/src/routes/shareRoutes.ts","content":"import { Router, type Response } from 'express';\nimport { store } from '../store.js';\nimport { requireAuth, type AuthRequest } from '../auth.js';\nimport { type Role, type ResourceType } from '../types.js';\n\nconst router = Router();\n\nrouter.use(requireAuth);\n\n// POST /api/share\nrouter.post('/', (req: AuthRequest, res: Response): void => {\n  const { resourceType, resourceId, userId, role } = req.body as {\n    resourceType?: string;\n    resourceId?: string;\n    userId?: string;\n    role?: string;\n  };\n\n  if (!resourceType || !['folder', 'document'].includes(resourceType)) {\n    res.status(400).json({ error: 'resourceType must be \"folder\" or \"document\"' });\n    return;\n  }\n\n  if (!resourceId) {\n    res.status(400).json({ error: 'resourceId is required' });\n    return;\n  }\n\n  if (!userId) {\n    res.status(400).json({ error: 'userId is required' });\n    return;\n  }\n\n  if (!role || !['viewer', 'editor', 'owner'].includes(role)) {\n    res.status(400).json({ error: 'role must be \"viewer\", \"editor\", or \"owner\"' });\n    return;\n  }\n\n  // Cannot share with yourself\n  if (userId === req.user!.id) {\n    res.status(400).json({ error: 'Cannot share a resource with yourself' });\n    return;\n  }\n\n  // Check that target user exists\n  const targetUser = store.getUserById(userId);\n  if (!targetUser) {\n    res.status(404).json({ error: 'Target user not found' });\n    return;\n  }\n\n  // Check that the resource exists and user has permission to share it\n  let resourceName = '';\n  let effectivePerm: Role | null = null;\n\n  if (resourceType === 'folder') {\n    const folder = store.getFolder(resourceId);\n    if (!folder) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n    resourceName = folder.name;\n    effectivePerm = store.getEffectiveFolderPermission(resourceId, req.user!.id);\n  } else {\n    const doc = store.getDocument(resourceId);\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n    resourceName = doc.title;\n    effectivePerm = store.getEffectiveDocumentPermission(resourceId, req.user!.id);\n  }\n\n  // Need at least editor to share\n  if (!effectivePerm || effectivePerm === 'viewer') {\n    res.status(403).json({ error: 'Insufficient permissions to share this resource' });\n    return;\n  }\n\n  const share = store.shareResource(\n    resourceType as ResourceType,\n    resourceId,\n    userId,\n    role as Role,\n    req.user!.id,\n  );\n\n  store.addActivity(\n    'share:create',\n    req.user!.id,\n    req.user!.username,\n    resourceType,\n    resourceId,\n    resourceName,\n    {\n      sharedWithUserId: userId,\n      sharedWithUsername: targetUser.username,\n      role,\n    },\n  );\n\n  res.status(201).json(share);\n});\n\n// GET /api/share/:resourceType/:resourceId — list shares for a resource\nrouter.get('/:resourceType/:resourceId', (req: AuthRequest, res: Response): void => {\n  const { resourceType, resourceId } = req.params;\n\n  if (!['folder', 'document'].includes(resourceType)) {\n    res.status(400).json({ error: 'resourceType must be \"folder\" or \"document\"' });\n    return;\n  }\n\n  // Check the resource exists and user has permission to see shares\n  let effectivePerm: Role | null = null;\n\n  if (resourceType === 'folder') {\n    const folder = store.getFolder(resourceId);\n    if (!folder) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n    effectivePerm = store.getEffectiveFolderPermission(resourceId, req.user!.id);\n  } else {\n    const doc = store.getDocument(resourceId);\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n    effectivePerm = store.getEffectiveDocumentPermission(resourceId, req.user!.id);\n  }\n\n  if (!effectivePerm) {\n    res.status(404).json({ error: 'Resource not found' });\n    return;\n  }\n\n  if (effectivePerm === 'viewer') {\n    res.status(403).json({ error: 'Insufficient permissions to view shares' });\n    return;\n  }\n\n  const shares = store.getSharesForResource(resourceType as ResourceType, resourceId);\n  res.json(shares);\n});\n\nexport default router;\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":149,"cache_creation_input_tokens":0,"cache_read_input_tokens":48384,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"16b51ad2-2880-481a-a4c2-16c526ffc299","uuid":"52742411-5052-46f7-9dce-618d454f848d"}
