orization', `Bearer ${token}`)\n        .send({ name: 'To Delete' });\n\n      const res = await request(app)\n        .delete(`/api/folders/${created.body.id}`)\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(res.status).toBe(204);\n\n      const getRes = await request(app)\n        .get(`/api/folders/${created.body.id}`)\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(getRes.status).toBe(404);\n    });\n\n    it('should list child folders', async () => {\n      const parent = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ name: 'Parent' });\n\n      await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ name: 'Child 1', parentId: parent.body.id });\n\n      await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ name: 'Child 2', parentId: parent.body.id });\n\n      const res = await request(app)\n        .get(`/api/folders/${parent.body.id}/folders`)\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body).toHaveLength(2);\n    });\n\n    it('should return 404 for non-existent folder', async () => {\n      const res = await request(app)\n        .get('/api/folders/non-existent')\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(res.status).toBe(404);\n    });\n\n    it('should reject creating folder with empty name', async () => {\n      const res = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ name: '' });\n\n      expect(res.status).toBe(400);\n    });\n  });\n\n  // ── Documents ────────────────────────────────────────────────\n\n  describe('Documents', () => {\n    let token: string;\n    let folderId: string;\n\n    beforeEach(async () => {\n      token = await registerUser('alice', 'secret');\n      const folderRes = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ name: 'My Folder' });\n      folderId = folderRes.body.id;\n    });\n\n    it('should create a document', async () => {\n      const res = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ title: 'Doc 1', content: 'Hello world', folderId });\n\n      expect(res.status).toBe(201);\n      expect(res.body.title).toBe('Doc 1');\n      expect(res.body.content).toBe('Hello world');\n      expect(res.body.folderId).toBe(folderId);\n    });\n\n    it('should get a document', async () => {\n      const created = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ title: 'Doc 1', content: 'Hello', folderId });\n\n      const res = await request(app)\n        .get(`/api/documents/${created.body.id}`)\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('Doc 1');\n    });\n\n    it('should update a document', async () => {\n      const created = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ title: 'Old', content: 'Old content', folderId });\n\n      const res = await request(app)\n        .put(`/api/documents/${created.body.id}`)\n        .set('Authorization', `Bearer ${token}`)\n        .send({ title: 'New', content: 'New content' });\n\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('New');\n      expect(res.body.content).toBe('New content');\n    });\n\n    it('should delete a document', async () => {\n      const created = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ title: 'Doc', content: 'Content', folderId });\n\n      const res = await request(app)\n    