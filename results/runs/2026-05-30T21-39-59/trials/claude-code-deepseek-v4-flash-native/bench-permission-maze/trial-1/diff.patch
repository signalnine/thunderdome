index 0000000..6ca75f6
--- /dev/null
+++ b/src/routes/authRoutes.ts
@@ -0,0 +1,69 @@
+import { Router, type Request, type Response } from 'express';
+import { store } from '../store.js';
+import { hashPassword } from '../auth.js';
+
+const router = Router();
+
+// POST /api/auth/register
+router.post('/register', (req: Request, res: Response): void => {
+  const { username, password } = req.body;
+
+  if (!username || !password) {
+    res.status(400).json({ error: 'Username and password are required' });
+    return;
+  }
+
+  if (typeof username !== 'string' || typeof password !== 'string') {
+    res.status(400).json({ error: 'Username and password must be strings' });
+    return;
+  }
+
+  const trimmed = username.trim();
+  if (trimmed.length < 1) {
+    res.status(400).json({ error: 'Username cannot be empty' });
+    return;
+  }
+
+  if (store.getUserByUsername(trimmed)) {
+    res.status(409).json({ error: 'Username already exists' });
+    return;
+  }
+
+  const user = store.createUser(trimmed, hashPassword(password));
+  const token = store.createToken(user.id);
+
+  res.status(201).json({
+    user: { id: user.id, username: user.username },
+    token,
+  });
+});
+
+// POST /api/auth/login
+router.post('/login', (req: Request, res: Response): void => {
+  const { username, password } = req.body;
+
+  if (!username || !password) {
+    res.status(400).json({ error: 'Username and password are required' });
+    return;
+  }
+
+  if (typeof username !== 'string' || typeof password !== 'string') {
+    res.status(400).json({ error: 'Username and password must be strings' });
+    return;
+  }
+
+  const user = store.getUserByUsername(username.trim());
+  if (!user || user.passwordHash !== hashPassword(password)) {
+    res.status(401).json({ error: 'Invalid username or password' });
+    return;
+  }
+
+  const token = store.createToken(user.id);
+
+  res.json({
+    user: { id: user.id, username: user.username },
+    token,
+  });
+});
+
+export default router;
