@@ -0,0 +1,63 @@
+import { Request } from 'express';
+
+export type Role = 'viewer' | 'editor' | 'owner';
+
+export type ResourceType = 'folder' | 'document';
+
+export interface User {
+  id: string;
+  username: string;
+  passwordHash: string;
+  createdAt: Date;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+export interface ShareEntry {
+  id: string;
+  resourceType: ResourceType;
+  resourceId: string;
+  userId: string;
+  role: Role;
+  sharedBy: string;
+  createdAt: Date;
+}
+
+export interface ActivityEntry {
+  id: string;
+  actionType: string;
+  userId: string;
+  username: string;
+  targetType: string;
+  targetId: string;
+  targetName: string;
+  details?: Record<string, unknown>;
+  timestamp: Date;
+}
+
+export interface AuthRequest extends Request {
+  user?: User;
+}
+
+export const ROLE_HIERARCHY: Record<Role, number> = {
+  viewer: 1,
+  editor: 2,
+  owner: 3,
+};
