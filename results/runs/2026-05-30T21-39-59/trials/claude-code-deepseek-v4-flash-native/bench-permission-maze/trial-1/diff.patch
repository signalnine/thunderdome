+import { describe, it, expect, beforeEach } from 'vitest';
+import { createApp } from '../src/app.js';
+import { store } from '../src/store.js';
+import { hashPassword } from '../src/auth.js';
+import type { Express } from 'express';
+import request from 'supertest';
+
+let app: Express;
+
+// Helper: register a user and return token
+async function registerUser(username: string, password: string): Promise<string> {
+  const res = await request(app)
+    .post('/api/auth/register')
+    .send({ username, password });
+  return res.body.token;
+}
+
+describe('Permission Maze API', () => {
+  beforeEach(() => {
+    // Reset all in-memory state before each test
+    store.users.clear();
+    store.usersByUsername.clear();
+    store.folders.clear();
+    store.documents.clear();
+    store.shares.length = 0;
+    store.activities.length = 0;
+    store.tokens.clear();
+
+    app = createApp();
+  });
+
+  // ── Auth ─────────────────────────────────────────────────────
+
+  describe('Auth', () => {
+    it('should register a new user', async () => {
+      const res = await request(app)
+        .post('/api/auth/register')
+        .send({ username: 'alice', password: 'secret' });
+
+      expect(res.status).toBe(201);
+      expect(res.body.user).toBeDefined();
+      expect(res.body.user.username).toBe('alice');
+      expect(res.body.token).toBeDefined();
+    });
+
+    it('should reject duplicate username', async () => {
+      await request(app)
+        .post('/api/auth/register')
+        .send({ username: 'alice', password: 'secret' });
+
+      const res = await request(app)
+        .post('/api/auth/register')
+        .send({ username: 'alice', password: 'other' });
+
+      expect(res.status).toBe(409);
+      expect(res.body.error).toBe('Username already exists');
+    });
+
+    it('should login an existing user', async () => {
+      await request(app)
+        .post('/api/auth/register')
+        .send({ username: 'alice', password: 'secret' });
+
+      const res = await request(app)
+        .post('/api/auth/login')
+        .send({ username: 'alice', password: 'secret' });
+
+      expect(res.status).toBe(200);
+      expect(res.body.user.username).toBe('alice');
+      expect(res.body.token).toBeDefined();
+    });
+
+    it('should reject login with wrong password', async () => {
+      await request(app)
+        .post('/api/auth/register')
+        .send({ username: 'alice', password: 'secret' });
+
+      const res = await request(app)
+        .post('/api/auth/login')
+        .send({ username: 'alice', password: 'wrong' });
+
+      expect(res.status).toBe(401);
+    });
+
+    it('should reject unauthenticated requests', async () => {
+      const res = await request(app)
+        .post('/api/folders')
+        .send({ name: 'My Folder' });
+
+      expect(res.status).toBe(401);
+    });
+
+    it('should reject requests with invalid token', async () => {
+      const res = await request(app)
+        .post('/api/folders')
+        .set('Authorization', 'Bearer invalid-token')
+        .send({ name: 'My Folder' });
+
+      expect(res.status).toBe(401);
+    });
+
+    it('should require username and password for register', async () => {
+      const res1 = await request(app).post('/api/auth/register').send({ username: 'alice' });
+      expect(res1.status).toBe(400);
+
+      const res2 = await request(app).post('/api/auth/register').send({ password: 'secret' });
+      expect(res2.status).toBe(400);
+    });
+  });
+
+  // ── Folders ──────────────────────────────────────────────────
+
+  describe('Folders', () => {
+    let token: string;
+
+    beforeEach(async () => {
+      token = await registerUser('alice', 'secret');
+    });
+
+    it('should create a root folder', async () => {
+      const res = await request(app)
+        .post('/api/folders')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: 'My Folder' });
+
+      expect(res.status).toBe(201);
+      expect(res.body.name).toBe('My Folder');
+      expect(res.body.parentId).toBeNull();
+      expect(res.body.ownerId).toBeDefined();
+    });
+
+    it('should create a nested folder', async () => {
+      const parentRes = await request(app)
+        .post('/api/folders')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: 'Parent' });
+
+      const res = await request(app)
+        .post('/api/folders')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: 'Child', parentId: parentRes.body.id });
+
+      expect(res.status).toBe(201);
+      expect(res.body.parentId).toBe(parentRes.body.id);
+    });
+
+    it('should get a folder', async () => {
+      const created = await request(app)
+        .post('/api/folders')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: 'My Folder' });
+
+      const res = await request(app)
+        .get(`/api/folders/${created.body.id}`)
+        .set('Authorization', `Bearer ${token}`);
+
+      expect(res.status).toBe(200);
+      expect(res.body.name).toBe('My Folder');
+    });
+
+    it('should update a folder', async () => {
+      const created = await request(app)
+        .post('/api/folders')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: 'Old Name' });
+
+      const res = await request(app)
+        .put(`/api/folders/${created.body.id}`)
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: 'New Name' });
+
+      expect(res.status).toBe(200);
+      expect(res.body.name).toBe('New Name');
+    });
+
+    it('should delete a folder', async () => {
+      const created = await request(app)
+        .post('/api/folders')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: 'To Delete' });
+
+      const res = await request(app)
+        .delete(`/api/folders/${created.body.id}`)
+        .set('Authorization', `Bearer ${token}`);
+
+      expect(res.status).toBe(204);
+
+      const getRes = await request(app)
+        .get(`/api/folders/${created.body.id}`)
+        .set('Authorization', `Bearer ${token}`);
+
+      expect(getRes.status).toBe(404);
+    });
+
+    it('should list child folders', async () => {
+      const parent = await request(app)
+        .post('/api/folders')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: 'Parent' });
+
+      await request(app)
+        .post('/api/folders')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: 'Child 1', parentId: parent.body.id });
+
+      await request(app)
+        .post('/api/folders')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: 'Child 2', parentId: parent.body.id });
+
+      const res = await request(app)
+        .get(`/api/folders/${parent.body.id}/folders`)
+        .set('Authorization', `Bearer ${token}`);
+
+      expect(res.status).toBe(200);
+      expect(res.body).toHaveLength(2);
+    });
+
+    it('should return 404 for non-existent folder', async () => {
+      const res = await request(app)
+        .get('/api/folders/non-existent')
+        .set('Authorization', `Bearer ${token}`);
+
+      expect(res.status).toBe(404);
+    });
+
+    it('should reject creating folder with empty name', async () => {
+      const res = await request(app)
+        .post('/api/folders')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: '' });
+
+      expect(res.status).toBe(400);
+    });
+  });
+
+  // ── Documents ────────────────────────────────────────────────
+
+  describe('Documents', () => {
+    let token: string;
+    let folderId: string;
+
+    beforeEach(async () => {
+      token = await registerUser('alice', 'secret');
+      const folderRes = await request(app)
+        .post('/api/folders')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ name: 'My Folder' });
+      folderId = folderRes.body.id;
+    });
+
+    it('should create a document', async () => {
+      const res = await request(app)
+        .post('/api/documents')
+        .set('Authorization', `Bearer ${token}`)
+        .send({ title: 'Doc 1', content: 'Hello world', folderId });
+
+      expect(res.status).toBe(201);
+      expect(res.body.title).toBe('Doc 1');
+      expect(res.body.content).toBe('Hello world');
+      expect(res.body.folderId).toBe(folderId);
+    });
+
+    it('should get a document', async () => {
