@@ -0,0 +1,272 @@
+import { randomUUID } from 'crypto';
+import { type User, type Folder, type Document, type ShareEntry, type ActivityEntry, type Role, type ResourceType, ROLE_HIERARCHY } from './types.js';
+
+class Store {
+  readonly users = new Map<string, User>();
+  readonly usersByUsername = new Map<string, User>();
+  readonly folders = new Map<string, Folder>();
+  readonly documents = new Map<string, Document>();
+  readonly shares: ShareEntry[] = [];
+  readonly activities: ActivityEntry[] = [];
+  readonly tokens = new Map<string, string>(); // token -> userId
+
+  // ── User methods ──────────────────────────────────────────────
+
+  createUser(username: string, passwordHash: string): User {
+    const id = randomUUID();
+    const user: User = { id, username, passwordHash, createdAt: new Date() };
+    this.users.set(id, user);
+    this.usersByUsername.set(username, user);
+    return user;
+  }
+
+  getUserById(id: string): User | undefined {
+    return this.users.get(id);
+  }
+
+  getUserByUsername(username: string): User | undefined {
+    return this.usersByUsername.get(username);
+  }
+
+  // ── Token methods ─────────────────────────────────────────────
+
+  createToken(userId: string): string {
+    const token = randomUUID();
+    this.tokens.set(token, userId);
+    return token;
+  }
+
+  getUserIdByToken(token: string): string | undefined {
+    return this.tokens.get(token);
+  }
+
+  // ── Folder methods ────────────────────────────────────────────
+
+  createFolder(name: string, parentId: string | null, ownerId: string): Folder {
+    const id = randomUUID();
+    const now = new Date();
+    const folder: Folder = {
+      id, name, parentId, ownerId,
+      createdAt: now, updatedAt: now,
+    };
+    this.folders.set(id, folder);
+    return folder;
+  }
+
+  getFolder(id: string): Folder | undefined {
+    return this.folders.get(id);
+  }
+
+  updateFolder(id: string, name: string): Folder | undefined {
+    const folder = this.folders.get(id);
+    if (!folder) return undefined;
+    folder.name = name;
+    folder.updatedAt = new Date();
+    return folder;
+  }
+
+  deleteFolder(id: string): void {
+    // Recursively delete child folders
+    const children = Array.from(this.folders.values()).filter(f => f.parentId === id);
+    for (const child of children) {
+      this.deleteFolder(child.id);
+    }
+
+    // Delete documents inside this folder
+    const docs = Array.from(this.documents.values()).filter(d => d.folderId === id);
+    for (const doc of docs) {
+      this.deleteDocument(doc.id);
+    }
+
+    // Remove share entries for this folder
+    for (let i = this.shares.length - 1; i >= 0; i--) {
+      if (this.shares[i].resourceType === 'folder' && this.shares[i].resourceId === id) {
+        this.shares.splice(i, 1);
+      }
+    }
+
+    this.folders.delete(id);
+  }
+
+  getChildFolders(parentId: string): Folder[] {
+    return Array.from(this.folders.values()).filter(f => f.parentId === parentId);
+  }
+
+  // ── Document methods ──────────────────────────────────────────
+
+  createDocument(title: string, content: string, folderId: string, ownerId: string): Document {
+    const id = randomUUID();
+    const now = new Date();
+    const doc: Document = {
+      id, title, content, folderId, ownerId,
+      createdAt: now, updatedAt: now,
+    };
+    this.documents.set(id, doc);
+    return doc;
+  }
+
+  getDocument(id: string): Document | undefined {
+    return this.documents.get(id);
+  }
+
+  updateDocument(id: string, title: string, content: string): Document | undefined {
+    const doc = this.documents.get(id);
+    if (!doc) return undefined;
+    doc.title = title;
+    doc.content = content;
+    doc.updatedAt = new Date();
+    return doc;
+  }
+
+  deleteDocument(id: string): void {
+    for (let i = this.shares.length - 1; i >= 0; i--) {
+      if (this.shares[i].resourceType === 'document' && this.shares[i].resourceId === id) {
+        this.shares.splice(i, 1);
+      }
+    }
+    this.documents.delete(id);
+  }
+
+  getDocumentsInFolder(folderId: string): Document[] {
+    return Array.from(this.documents.values()).filter(d => d.folderId === folderId);
+  }
+
+  // ── Share methods ─────────────────────────────────────────────
+
+  shareResource(
+    resourceType: ResourceType,
+    resourceId: string,
+    userId: string,
+    role: Role,
+    sharedBy: string,
+  ): ShareEntry {
+    // Remove existing share for same user + resource (upsert)
+    for (let i = this.shares.length - 1; i >= 0; i--) {
+      const s = this.shares[i];
+      if (s.resourceType === resourceType && s.resourceId === resourceId && s.userId === userId) {
+        this.shares.splice(i, 1);
+      }
+    }
+
+    const entry: ShareEntry = {
+      id: randomUUID(),
+      resourceType,
+      resourceId,
+      userId,
+      role,
+      sharedBy,
+      createdAt: new Date(),
+    };
+    this.shares.push(entry);
+    return entry;
+  }
+
+  getSharesForResource(resourceType: ResourceType, resourceId: string): ShareEntry[] {
+    return this.shares.filter(s => s.resourceType === resourceType && s.resourceId === resourceId);
+  }
+
+  // ── Effective permission resolution ──────────────────────────
+
+  private roleValue(role: Role | null): number {
+    if (!role) return 0;
+    return ROLE_HIERARCHY[role];
+  }
+
+  private maxRole(roles: (Role | null)[]): Role | null {
+    let best = 0;
+    for (const r of roles) {
+      const v = this.roleValue(r);
+      if (v > best) best = v;
+    }
+    if (best <= 0) return null;
+    return (Object.entries(ROLE_HIERARCHY) as [Role, number][]).find(([, v]) => v === best)?.[0] ?? null;
+  }
+
+  /**
+   * Get the effective permission for a user on a folder.
+   * Walks up the folder tree collecting inherited shares.
+   */
+  getEffectiveFolderPermission(folderId: string, userId: string): Role | null {
+    const folder = this.folders.get(folderId);
+    if (!folder) return null;
+
+    // Owner always has full access
+    if (folder.ownerId === userId) return 'owner';
+
+    const roles: (Role | null)[] = [];
+
+    // Walk up the folder tree collecting direct shares
+    let currentId: string | null = folderId;
+    while (currentId) {
+      const direct = this.shares.find(
+        s => s.resourceType === 'folder' && s.resourceId === currentId && s.userId === userId,
+      );
+      if (direct) roles.push(direct.role);
+
+      const currentFolder = this.folders.get(currentId);
+      currentId = currentFolder?.parentId ?? null;
+    }
+
+    return this.maxRole(roles);
+  }
+
+  /**
+   * Get the effective permission for a user on a document.
+   * Checks direct shares + inherited permission from containing folder tree.
+   */
+  getEffectiveDocumentPermission(docId: string, userId: string): Role | null {
+    const doc = this.documents.get(docId);
+    if (!doc) return null;
+
+    // Owner always has full access
+    if (doc.ownerId === userId) return 'owner';
+
+    const roles: (Role | null)[] = [];
+
+    // Check direct share on document
+    const directShare = this.shares.find(
+      s => s.resourceType === 'document' && s.resourceId === docId && s.userId === userId,
+    );
+    if (directShare) roles.push(directShare.role);
+
+    // Check inherited permission from folder chain
+    if (doc.folderId) {
+      roles.push(this.getEffectiveFolderPermission(doc.folderId, userId));
+    }
+
+    return this.maxRole(roles);
+  }
+
+  // ── Activity log ──────────────────────────────────────────────
+
+  addActivity(
+    actionType: string,
+    userId: string,
+    username: string,
+    targetType: string,
+    targetId: string,
+    targetName: string,
+    details?: Record<string, unknown>,
+  ): ActivityEntry {
+    const entry: ActivityEntry = {
+      id: randomUUID(),
+      actionType,
+      userId,
+      username,
+      targetType,
+      targetId,
+      targetName,
+      details,
+      timestamp: new Date(),
+    };
+    this.activities.push(entry);
+    return entry;
+  }
+
+  getActivity(): ActivityEntry[] {
+    // Return most recent first
+    return [...this.activities].reverse();
+  }
+}
+
+export const store = new Store();
