{\n    const doc = store.getDocument(resourceId);\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n    resourceName = doc.title;\n    effectivePerm = store.getEffectiveDocumentPermission(resourceId, req.user!.id);\n  }\n  \n  // Need at least editor to share\n  if (!effectivePerm || effectivePerm === 'viewer') {\n    res.status(403).json({ error: 'Insufficient permissions to share this resource' });\n    return;\n  }\n  \n  const share = store.shareResource(resourceType, resourceId, userId, role as Role, req.user!.id);\n  \n  store.addActivity(\n    'share:create',\n    req.user!.id,\n    req.user!.username,\n    resourceType,\n    resourceId,\n    resourceName,\n    { sharedWithUserId: userId, sharedWithUsername: targetUser.username, role }\n  );\n  \n  res.status(201).json(share);\n});\n\n// GET /api/share/:resourceType/:resourceId\nrouter.get('/:resourceType/:resourceId', (req: AuthRequest, res) => {\n  const { resourceType, resourceId } = req.params;\n  \n  if (!['folder', 'document'].includes(resourceType)) {\n    res.status(400).json({ error: 'resourceType must be \"folder\" or \"document\"' });\n    return;\n  }\n  \n  // Check the resource exists and user has permission to see shares\n  let effectivePerm: Role | null = null;\n  \n  if (resourceType === 'folder') {\n    const folder = store.getFolder(resourceId);\n    if (!folder) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n    effectivePerm = store.getEffectiveFolderPermission(resourceId, req.user!.id);\n  } else {\n    const doc = store.getDocument(resourceId);\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n    effectivePerm = store.getEffectiveDocumentPermission(resourceId, req.user!.id);\n  }\n  \n  if (!effectivePerm) {\n    res.status(404).json({ error: 'Resource not found' });\n    return;\n  }\n  \n  // Only owner and editor can see shares\n  if (effectiv