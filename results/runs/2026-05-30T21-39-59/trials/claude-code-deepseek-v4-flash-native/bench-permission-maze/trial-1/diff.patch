 = bobRes.body.token;\n      bobId = bobRes.body.user.id;\n\n      // Alice creates a folder\n      const folderRes = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Shared Folder' });\n      folderId = folderRes.body.id;\n\n      // Alice creates a document in the folder\n      const docRes = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'My Doc', content: 'Secret', folderId });\n      docId = docRes.body.id;\n    });\n\n    it(\"should deny bob access to alice's folder initially\", async () => {\n      const res = await request(app)\n        .get(`/api/folders/${folderId}`)\n        .set('Authorization', `Bearer ${bobToken}`);\n\n      expect(res.status).toBe(404);\n    });\n\n    it(\"should deny bob access to alice's document initially\", async () => {\n      const res = await request(app)\n        .get(`/api/documents/${docId}`)\n        .set('Authorization', `Bearer ${bobToken}`);\n\n      expect(res.status).toBe(404);\n    });\n\n    it('should allow alice to share folder with bob as viewer', async () => {\n      const res = await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'viewer',\n        });\n\n      expect(res.status).toBe(201);\n      expect(res.body.role).toBe('viewer');\n    });\n\n    it('should allow bob to read folder after being shared as viewer', async () => {\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'viewer',\n        });\n\n      const res = await request(app)\n        .get(`/api/folders/${folderId}`)\n        .set('Authorization', `Bearer ${bobToken}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.permission).toBe('viewer');\n    });\n\n    it('should prevent bob from updating folder as viewer', async () => {\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'viewer',\n        });\n\n      const res = await request(app)\n        .put(`/api/folders/${folderId}`)\n        .set('Authorization', `Bearer ${bobToken}`)\n        .send({ name: 'Hacked Name' });\n\n      expect(res.status).toBe(403);\n    });\n\n    it('should allow bob to update folder as editor', async () => {\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'editor',\n        });\n\n      const res = await request(app)\n        .put(`/api/folders/${folderId}`)\n        .set('Authorization', `Bearer ${bobToken}`)\n        .send({ name: 'Updated by Bob' });\n\n      expect(res.status).toBe(200);\n    });\n\n    it('should prevent bob from deleting folder as editor (needs owner)', async () => {\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'editor',\n        });\n\n      const res = await request(app)\n        .delete(`/api/folders/${folderId}`)\n        .set('Authorization', `Bearer ${bobToken}`);\n\n      expect(res.status).toBe(403);\n    });\n\n    it('should inherit folder permission to documents inside', async () => {\n      // Share folder with bob as viewer\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'viewer',\n        });\n\n      // Bob should be able to read the document (inherited from folder)\n      const res = await request(app)\n        .get(`/api/documents/${docId}`)\n        .set('Authorization', `Bearer ${bobToken}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('My Doc');\n    });\n\n    it('should take most permissive role when direct share + inherited conflict', async () => {\n      // Share folder with bob as viewer\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'viewer',\n        });\n\n      // Share document with bob as editor (more permissive)\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'document',\n          resourceId: docId,\n          userId: bobId,\n          role: 'editor',\n        });\n\n      // Bob should have editor on the document (most permissive)\n      const res = await request(app)\n        .get(`/api/documents/${docId}`)\n        .set('Authorization', `Bearer ${bobToken}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.permission).toBe('editor');\n    });\n\n    it('should allow bob to create documents in folder as editor', async () => {\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'editor',\n        });\n\n      const res = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${bobToken}`)\n        .send({ title: \"Bob's Doc\", content: 'Hello', folderId });\n\n      expect(res.status).toBe(201);\n    });\n\n    it('should prevent bob from creating documents in folder as viewer', async () => {\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'viewer',\n        });\n\n      const res = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${bobToken}`)\n        .send({ title: \"Bob's Doc\", content: 'Hello', folderId });\n\n      expect(res.status).toBe(403);\n    });\n\n    it('should allow editor to share the resource with others', async () => {\n      // Register charlie\n      const charlieRes = await request(app)\n        .post('/api/auth/register')\n        .send({ username: 'charlie', password: 'secret' });\n      const charlieId = charlieRes.body.user.id;\n\n      // Share folder with bob as editor\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'editor',\n        });\n\n      // Bob (editor) shares folder with charlie as viewer\n      const res = await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${bobToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: charlieId,\n          role: 'viewer',\n        });\n\n      expect(res.status).toBe(201);\n\n      // Charlie should now have access\n      const charlieToken = charlieRes.body.token;\n      const viewRes = await request(app)\n        .get(`/api/folders/${folderId}`)\n        .set('Authorization', `Bearer ${charlieToken}`);\n\n      expect(viewRes.status).toBe(200);\n    });\n\n    it('should prevent viewer from sharing', async () => {\n      // Register charlie\n      const charlieRes = await request(app)\n        .post('/api/auth/register')\n        .send({ username: 'charlie', password: 'secret' });\n      const charlieId = charlieRes.body.user.id;\n\n      // Share folder with bob as viewer\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'viewer',\n        });\n\n      // Bob (viewer) tries to share — should fail\n      const res = await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${bobToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: charlieId,\n          role: 'viewer',\n        });\n\n      expect(res.status).toBe(403);\n    });\n\n    it('should not allow sharing with yourself', async () => {\n      const res = await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: aliceId,\n          role: 'owner',\n        });\n\n      expect(res.status).toBe(400);\n    });\n\n    it('should cascade permissions through nested folders', async () => {\n      // Alice creates a child folder\n      const childRes = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Child Folder', parentId: folderId });\n      const childFolderId = childRes.body.id;\n\n      // Alice creates a document in the child folder\n      const childDocRes = await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'Nested Doc', content: 'Deep', folderId: childFolderId });\n      const childDocId = childDocRes.body.id;\n\n      // Share parent folder with bob as viewer\n      await request(app)\n        .post('/api/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folderId,\n          userId: bobId,\n          role: 'viewer',\n        });\n\n      // Bob should see the child folder and its document\n      const folderRes = await request(app)\n        .get(`/api/folders/${childFolderId}`)\n        .set('Authorization', `Bearer ${bobToken}`);\n      expect(folderRes.status).toBe(200);\n\n      const docRes = await request(app)\n        .get(`/api/documents/${childDocId}`)\n        .set('Authorization', `Bearer ${bobToken}`);\n      expect(docRes.status).toBe(200);\n    });\n  });\n\n  // ── Activity Log ─────────────────────────────────────────────\n\n  describe('Activity Log', () => {\n    it('should record activity when creating a folder', async () => {\n      const token = await registerUser('alice', 'secret');\n\n      await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ name: 'My Folder' });\n\n      const res = await request(app)\n        .get('/api/activity')\n        .set('Authorization', `Bearer ${token}`);\n\n      expect(res.status).toBe(200);\n      expect(res.body.length).toBeGreaterThanOrEqual(1);\n      expect(res.body[0].actionType).toBe('folder:create');\n    });\n\n    it('should record activity when creating and updating a document', async () => {\n      const token = await registerUser('alice', 'secret');\n\n      const folderRes = await request(app)\n        .post('/api/folders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ name: 'Folder' });\n      const folderId = folderRes.body.id;\n\n      await request(app)\n        .post('/api/documents')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ title: 'Doc', content: 'Content', folderId });\n\n      await request(app)\n       