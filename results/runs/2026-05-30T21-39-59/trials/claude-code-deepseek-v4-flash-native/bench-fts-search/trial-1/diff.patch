\n49\t        SELECT COUNT(*) as total FROM notes_fts WHERE notes_fts MATCH ?\n50\t      `);\n51\t      const { total } = countStmt.get(q) as { total: number };\n52\t\n53\t      // Search with BM25 ranking and snippet highlighting\n54\t      const searchStmt = db.prepare(`\n55\t        SELECT\n56\t          n.id,\n57\t          n.title,\n58\t          COALESCE(highlight(notes_fts, 1, '<mark>', '</mark>'), n.body) as snippet,\n59\t          rank\n60\t        FROM notes_fts\n61\t        LEFT JOIN notes n ON notes_fts.rowid = n.id\n62\t        WHERE notes_fts MATCH ? AND n.id IS NOT NULL\n63\t        ORDER BY rank\n64\t        LIMIT ? OFFSET ?\n65\t      `);\n66\t\n67\t      const results = searchStmt.all(q, perPage, offset) as SearchResult[];\n68\t\n69\t      res.json({ results, total, page, perPage });\n70\t    } catch (err) {\n71\t      next(err);\n72\t    }\n73\t  });\n74\t\n75\t  // GET /notes/search/suggest - Autocomplete matching note titles\n76\t  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {\n77\t    try {\n78\t      const q = req.query.q as string | undefined;\n79\t\n80\t      if (!q || q.trim() === '') {\n81\t        throw new ValidationError('Query parameter q is required');\n82\t      }\n83\t\n84\t      // Build a prefix query: each term gets a * suffix for prefix matching\n85\t      const prefixQuery = q.trim().split(/\\s+/).filter(Boolean).map(term => `${term}*`).join(' ');\n86\t\n87\t      const suggestStmt = db.prepare(`\n88\t        SELECT DISTINCT n.id, n.title\n89\t        FROM notes_fts\n90\t        LEFT JOIN notes n ON notes_fts.rowid = n.id\n91\t        WHERE notes_fts MATCH ? AND n.id IS NOT NULL\n92\t        ORDER BY rank\n93\t        LIMIT 5\n94\t      `);\n95\t\n96\t      const results = suggestStmt.all(prefixQuery) as SuggestResult[];\n97\t\n98\t      res.json({ results });\n99\t    } catch (err) {\n100\t      next(err);\n101\t    }\n102\t  });\n103\t\n104\t  // GET /notes/:id - Get single note\n1