x.app)\n48\t      .post('/notes')\n49\t      .send({ title: 'New Note', body: 'New Body' });\n50\t\n51\t    expect(res.status).toBe(201);\n52\t    expect(res.body.note.title).toBe('New Note');\n53\t    expect(res.body.note.body).toBe('New Body');\n54\t    expect(res.body.note.id).toBeDefined();\n55\t  });\n56\t\n57\t  // 5. POST /notes creates note with tags\n58\t  it('POST /notes creates note with tags', async () => {\n59\t    const res = await request(appCtx.app)\n60\t      .post('/notes')\n61\t      .send({ title: 'Tagged Note', body: 'Body', tags: ['test', 'vitest'] });\n62\t\n63\t    expect(res.status).toBe(201);\n64\t    const tags = JSON.parse(res.body.note.tags);\n65\t    expect(tags).toContain('test');\n66\t    expect(tags).toContain('vitest');\n67\t  });\n68\t\n69\t  // 6. POST /notes returns 400 without title\n70\t  it('POST /notes returns 400 without title', async () => {\n71\t    const res = await request(appCtx.app)\n72\t      .post('/notes')\n73\t      .send({ body: 'Body only' });\n74\t\n75\t    expect(res.status).toBe(400);\n76\t  });\n77\t\n78\t  // 7. POST /notes returns 400 without body\n79\t  it('POST /notes returns 400 without body', async () => {\n80\t    const res = await request(appCtx.app)\n81\t      .post('/notes')\n82\t      .send({ title: 'Title only' });\n83\t\n84\t    expect(res.status).toBe(400);\n85\t  });\n86\t\n87\t  // 8. PUT /notes/:id updates note\n88\t  it('PUT /notes/:id updates note', async () => {\n89\t    const result = appCtx.db.prepare(\"INSERT INTO notes (title, body) VALUES ('Original', 'Original body')\").run();\n90\t    const id = result.lastInsertRowid;\n91\t\n92\t    const res = await request(appCtx.app)\n93\t      .put(`/notes/${id}`)\n94\t      .send({ title: 'Updated', body: 'Updated body' });\n95\t\n96\t    expect(res.status).toBe(200);\n97\t    expect(res.body.note.title).toBe('Updated');\n98\t    expect(res.body.note.body).toBe('Updated body');\n99\t  });\n100\t\n101\t  // 9. PUT /notes/:id returns 404 for non