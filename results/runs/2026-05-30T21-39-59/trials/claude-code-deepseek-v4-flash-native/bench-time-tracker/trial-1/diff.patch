@@ -0,0 +1,94 @@
+import { JsonStorage } from './storage.js';
+import type { TimeEntry, TimeStore } from './types.js';
+
+export class TimeTracker {
+  private storage: JsonStorage;
+  private store: TimeStore;
+
+  constructor(filePath: string) {
+    this.storage = new JsonStorage(filePath);
+    this.store = { entries: [] };
+  }
+
+  /** Load persisted state from disk. Must be called before other methods. */
+  async init(): Promise<void> {
+    this.store = await this.storage.load();
+  }
+
+  /** Start a named timer. If a timer is already running it is stopped first. */
+  async start(taskName: string): Promise<void> {
+    if (!taskName || taskName.trim().length === 0) {
+      throw new Error('Task name cannot be empty');
+    }
+
+    // Auto-stop the currently running timer, if any
+    if (this.store.activeEntry !== undefined) {
+      this.store.activeEntry.endTime = Date.now();
+      this.store.entries.push(this.store.activeEntry);
+    }
+
+    this.store.activeEntry = {
+      taskName,
+      startTime: Date.now(),
+    };
+
+    await this.storage.save(this.store);
+  }
+
+  /** Stop the currently running timer and return its entry. */
+  async stop(): Promise<TimeEntry> {
+    if (this.store.activeEntry === undefined) {
+      throw new Error('No active timer to stop');
+    }
+
+    this.store.activeEntry.endTime = Date.now();
+    const entry: TimeEntry = { ...this.store.activeEntry };
+    this.store.entries.push(this.store.activeEntry);
+    this.store.activeEntry = undefined;
+
+    await this.storage.save(this.store);
+
+    return entry;
+  }
+
+  /** Return all completed entries together with the active entry (if any). */
+  getEntries(): TimeEntry[] {
+    const result = [...this.store.entries];
+    if (this.store.activeEntry !== undefined) {
+      result.push(this.store.activeEntry);
+    }
+    return result;
+  }
+
+  /** Filter entries whose start time falls within the given range. */
+  getEntriesByDateRange(start: Date, end: Date): TimeEntry[] {
+    const startMs = start.getTime();
+    const endMs = end.getTime();
+
+    return this.getEntries().filter(
+      (entry) => entry.startTime >= startMs && entry.startTime <= endMs,
+    );
+  }
+
+  /**
+   * Return total time spent per task name in milliseconds.
+   * Running tasks use the current time for their duration.
+   */
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+    const now = Date.now();
+
+    for (const entry of this.getEntries()) {
+      const endTime = entry.endTime ?? now;
+      const duration = endTime - entry.startTime;
+
+      if (Object.prototype.hasOwnProperty.call(summary, entry.taskName)) {
+        summary[entry.taskName] += duration;
+      } else {
+        summary[entry.taskName] = duration;
+      }
+    }
+
+    return summary;
+  }
+}
