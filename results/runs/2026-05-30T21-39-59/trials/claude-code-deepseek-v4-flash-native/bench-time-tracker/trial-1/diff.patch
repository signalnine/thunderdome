@@ -0,0 +1,26 @@
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { dirname } from 'node:path';
+import type { TimeStore } from './types.js';
+
+export class JsonStorage {
+  private filePath: string;
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+  }
+
+  async load(): Promise<TimeStore> {
+    try {
+      const data = await readFile(this.filePath, { encoding: 'utf-8' });
+      const parsed = JSON.parse(data) as TimeStore;
+      return parsed;
+    } catch {
+      return { entries: [] };
+    }
+  }
+
+  async save(store: TimeStore): Promise<void> {
+    await mkdir(dirname(this.filePath), { recursive: true });
+    await writeFile(this.filePath, JSON.stringify(store, null, 2), { encoding: 'utf-8' });
+  }
+}
