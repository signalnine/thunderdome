+      const tracker = await fresh();
+      await tracker.start('coding');
+      await new Promise((r) => setTimeout(r, 10));
+      const entry = await tracker.stop();
+
+      expect(entry.taskName).toBe('coding');
+      expect(entry.startTime).toBeGreaterThan(0);
+      expect(entry.endTime).toBeDefined();
+      expect(entry.endTime!).toBeGreaterThan(entry.startTime);
+    });
+
+    it('should auto-stop the previous timer on start', async () => {
+      const tracker = await fresh();
+      await tracker.start('coding');
+      await new Promise((r) => setTimeout(r, 10));
+      await tracker.start('reading');
+
+      // entries: [completed 'coding', active 'reading']
+      const entries = tracker.getEntries();
+      expect(entries).toHaveLength(2);
+      expect(entries[0].taskName).toBe('coding');
+      expect(entries[0].endTime).toBeDefined();
+      expect(entries[1].taskName).toBe('reading');
+      expect(entries[1].endTime).toBeUndefined();
+
+      const entry = await tracker.stop();
+      expect(entry.taskName).toBe('reading');
+
+      // After stop: [completed 'coding', completed 'reading']
+      expect(tracker.getEntries()).toHaveLength(2);
+      expect(tracker.getEntries()[1].endTime).toBeDefined();
+    });
+
+    it('should throw when starting with empty name', async () => {
+      const tracker = await fresh();
