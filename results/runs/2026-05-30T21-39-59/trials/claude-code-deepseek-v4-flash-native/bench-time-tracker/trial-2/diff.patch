 type { TimeEntry } from './types.js';\n\nconst TEST_DIR = join(tmpdir(), 'time-tracker-tests');\nconst TEST_FILE = join(TEST_DIR, 'test-data.json');\n\nfunction freshTracker(filePath?: string): TimeTracker {\n  return new TimeTracker({ filePath: filePath ?? TEST_FILE });\n}\n\nfunction cleanTestDir(): void {\n  if (existsSync(TEST_DIR)) {\n    rmSync(TEST_DIR, { recursive: true, force: true });\n  }\n}\n\ndescribe('TimeTracker', () => {\n  beforeEach(() => {\n    cleanTestDir();\n  });\n\n  // ---------------------------------------------------------------\n  // Core Operations (30%)\n  // ---------------------------------------------------------------\n\n  describe('Core Operations', () => {\n    it('start() creates an active entry with start time', () => {\n      const tt = freshTracker();\n      const entry = tt.start('task1');\n      expect(entry.name).toBe('task1');\n      expect(entry.start).toBeGreaterThan(0);\n      expect(entry.stop).toBeNull();\n      expect(tt.getActiveTask()).toEqual(entry);\n    });\n\n    it('stop() sets end time on active entry', () => {\n      const tt = freshTracker();\n      tt.start('task1');\n      const stopped = tt.stop();\n      expect(stopped.stop).toBeGreaterThan(0);\n      expect(stopped.stop).toBeGreaterThanOrEqual(stopped.start);\n      expect(tt.getActiveTask()).toBeNull();\n    });\n\n    it('starting a new task auto-stops the previous one', () => {\n      const tt = freshTracker();\n      const first = tt.start('task1');\n      const second = tt.start('task2');\n\n      // First entry should now be stopped\n      expect(first.stop).toBeGreaterThan(0);\n      // Second entry should be running\n      expect(second.stop).toBeNull();\n      expect(tt.getActiveTask()?.name).toBe('task2');\n    });\n\n    it('stop() when nothing is running throws an error', () => {\n      const tt = freshTracker();\n      expect(() => tt.stop()).toThrow('No timer is currently running');\n    });\n  });\n\n  // ------------------------------