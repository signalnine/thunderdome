new file mode 100644
index 0000000..ea040c1
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,24 @@
+/** A single time tracking entry. */
+export interface TimeEntry {
+  /** The task name. */
+  name: string;
+  /** Timestamp (ms since epoch) when tracking started. */
+  start: number;
+  /** Timestamp (ms since epoch) when tracking stopped, or null if still running. */
+  stop: number | null;
+}
+
+/** Filter options passed to getLog(). */
+export interface LogFilter {
+  /** Only return entries that started on or after this date. Running entries are always included. */
+  since?: Date;
+}
+
+/** Summary of total time spent per task name, keyed by task name with values in milliseconds. */
+export type Summary = Record<string, number>;
+
+/** Options for constructing a TimeTracker. */
+export interface TimeTrackerOptions {
+  /** Path to the JSON file used for persistence. Defaults to './time-tracker-data.json'. */
+  filePath?: string;
+}
