acker();\n      const first = tt.start('task1');\n      const second = tt.start('task2');\n\n      // First entry should now be stopped\n      expect(first.stop).toBeGreaterThan(0);\n      // Second entry should be running\n      expect(second.stop).toBeNull();\n      expect(tt.getActiveTask()?.name).toBe('task2');\n    });\n\n    it('stop() when nothing is running throws an error', () => {\n      const tt = freshTracker();\n      expect(() => tt.stop()).toThrow('No timer is currently running');\n    });\n  });\n\n  // ---------------------------------------------------------------\n  // Query Operations (25%)\n  // ---------------------------------------------------------------\n\n  describe('Query Operations', () => {\n    it('getLog() returns all entries', () => {\n      const tt = freshTracker();\n      tt.start('a');\n      tt.stop();\n      tt.start('b');\n      tt.stop();\n\n      const log = tt.getLog();\n      expect(log).toHaveLength(2);\n    });\n\n    it('getLog({ since }) filters entries starting on or after that date', () => {\n      const tt = freshTracker();\n      tt.start('past');\n      tt.stop();\n\n      const since = new Date(Date.now() + 1); // a tiny bit in the future\n      tt.start('future');\n      tt.stop();\n\n      const log = tt.getLog({ since });\n      expect(log).toHaveLength(1);\n      expect(log[0].name).toBe('future');\n    });\n\n    it('getLog({ since }) includes running entries started before the since date', () => {\n      const tt = freshTracker();\n      // Create a past stopped entry\n      tt.start('past-stopped');\n      tt.stop();\n\n      // Create a running entry with an artificially early start time\n      // We need to manipulate the file directly to simulate a running entry from the past\n      const pastRunning: TimeEntry = {\n        name: 'past-running',\n        start: Date.now() - 60_000, // 1 minute ago\n        stop: null,\n      };\n\n      // Since we can't inject an entry with a past start time directly,\n      // we start one and let it keep running\n      tt.start('future');\n      // Don't stop it — it's running\n\n      const since = new Date(Date.now() - 30_000); // 30 seconds ago\n      const log = tt.getLog({ since });\n      // Should include the running entry even though it started before `since`\n      expect(log.length).toBeGreaterThan(0);\n      expect(log.some((e) => e.stop === null)).toBe(true);\n    });\n\n    it('getSummary() returns object keyed by task name with total duration in ms', () => {\n      const tt = freshTracker();\n      tt.start('task-a');\n      tt.stop();\n      tt.start('task-b');\n      tt.stop();\n\n      const summary = tt.getSummary();\n      expect(typeof summary).toBe('object');\n      expect(Object.keys(summary)).toContain('task-a');\n      expect(Object.keys(summary)).toContain('task-b');\n      expect(summary['task-a']).toBeGreaterThanOrEqual(0);\n      expect(summary['task-b']).toBeGreaterThanOrEqual(0);\n    });\n\n    it('getSummary() combines multiple entries for the same task name', () => {\n      const tt = freshTracker();\n      tt.start('same-task');\n      tt.stop();\n      tt.start('same-task');\n      tt.stop();\n\n      const summary = tt.getSummary();\n      expect(Object.keys(summary)).toHaveLength(1);\n      expect(summary['same-task']).toBeGreaterThan(0);\n    });\n\n    it('getActiveTask() returns current task or null', () => {\n      const tt = freshTracker();\n      expect(tt.getActiveTask()).toBeNull();\n\n      tt.start('active');\n      expect(tt.getActiveTask()).not.toBeNull();\n      expect(tt.getActiveTask()?.name).toBe('active');\n\n      tt.stop();\n      expect(tt.getActiveTask()).toBeNull();\n    });\n  });\n\n  // ---------------------------------------------------------------\n  // Persistence (20%)\n  // ---------------------------------------------------------------\n\n  describe('Persistence', () => {\n    it('persists data across instances', () => {\n      const filePath = join(TEST_DIR, 'persist.json');\n\n      const tt1 = freshTracker(filePath);\n      tt1.start('persistent-task');\n      tt1.stop();\n\n      // Create a new instance reading the same file\n      const tt2 = freshTracker(filePath);\n      const log = tt2.getLog();\n      expect(log).toHaveLength(1);\n      expect(log[0].name).toBe('persistent-task');\n    });\n\n    it('creates the data file if it does not exist', () => {\n      expect(existsSync(TEST_FILE)).toBe(false);\n      const tt = freshTracker();\n      tt.start('new-file');\n      expect(existsSync(TEST_FILE)).toBe(true);\n    });\n\n    it('file path is configurable', () => {\n      const customPath = join(TEST_DIR, 'custom-dir', 'custom.json');\n      const tt = freshTracker(customPath);\n      tt.start('custom');\n      tt.stop();\n\n      expect(existsSync(customPath)).toBe(true);\n\n      // Verify the data is readable\n      const raw = readFileSync(customPath, 'utf-8');\n      const data = JSON.parse(raw) as TimeEntry[];\n      expect(data).toHaveLength(1);\n      expect(data[0].name).toBe('custom');\n    });\n  });\n\n  // ---------------------------------------------------------------\n  // Edge Cases (15%)\n  // ---------------------------------------------------------------\n\n  describe('Edge Cases', () => {\n    it('start() with empty name throws an error', () => {\n      const tt = freshTracker();\n      expect(() => tt.start('')).toThrow();\n      expect(() => tt.start('   ')).toThrow();\n    });\n\n    it('supports unicode task names', () => {\n      const tt = freshTracker();\n      const entry = tt.start('🌟测试任务★ém💪');\n      expect(entry.name).toBe('🌟测试任务★ém💪');\n      expect(entry.start).toBeGreaterThan(0);\n    });\n\n    it('getLog({ since }) with future date returns empty array', () => {\n      const tt = freshTracker();\n      tt.start('now');\n      tt.stop();\n\n      const farFuture = new Date('2099-01-01');\n      const log = tt.getLog({ since: farFuture });\n      expect(log).toEqual([]);\n    });\n\n    it('getLog({ since }) with old date returns all entries', () => {\n      const tt = freshTracker();\n      tt.start('first');\n      tt.stop();\n      tt.start('second');\n      tt.stop();\n\n      const ancient = new Date('2000-01-01');\n      const log = tt.getLog({ since: ancient });\n      expect(log).toHaveLength(2);\n    });\n\n    it('getSummary() with no entries returns empty object', () => {\n      const tt = freshTracker();\n      expect(tt.getSummary()).toEqual({});\n    });\n\n    it('getLog() with no entries returns empty array', () => {\n      const tt = freshTracker();\n      expect(tt.getLog()).toEqual([]);\n    });\n\n    it('rapid sequential start calls do not corrupt data', () => {\n      const tt = freshTracker();\n      for (let i = 0; i < 100; i++) {\n        tt.start(`rapid-${i}`);\n      }\n      // After 100 starts without stops, only the last one should be running\n      expect(tt.getActiveTask()?.name).toBe('rapid-99');\n\n      // All previous entries should be stopped\n      const log = tt.getLog();\n      const running = log.filter((e) => e.stop === null);\n      expect(running).toHaveLength(1);\n\n      // Total entries = 100 (all rapid starts)\n      expect(log).toHaveLength(100);\n    });\n  });\n\n  // ---------------------------------------------------------------\n  // Data Integrity (10%)\n  // ---------------------------------------------------------------\n\n  describe('Data Integrity', () => {\n    it('multiple start/stop cycles accumulate correctly', () => {\n      const tt = freshTracker();\n      const cycles = 5;\n\n      for (let i = 0; i < cycles; i++) {\n        tt.start(`cycle-${i}`);\n        tt.stop();\n      }\n\n      expect(tt.getLog()).toHaveLength(cycles);\n\n      // Each cycle should have start <= stop\n      for (const entry of tt.getLog()) {\n        expect(entry.start).toBeLessThanOrEqual(entry.stop!);\n      }\n    });\n\n    it('log entries have correct shape', () => {\n      const tt = freshTracker();\n      const entry = tt.start('shape-test');\n      tt.stop();\n\n      const log = tt.getLog();\n      expect(log[0]).toHaveProperty('name');\n      expect(log[0]).toHaveProperty('start');\n      expect(log[0]).toHaveProperty('stop');\n      expect(typeof log[0].name).toBe('string');\n      expect(typeof log[0].start).toBe('number');\n      expect(typeof log[0].stop).toBe('number');\n    });\n\n    it('summary durations are positive numbers', () => {\n      const tt = freshTracker();\n      tt.start('positive');\n      tt.stop();\n\n      const summary = tt.getSummary();\n      expect(summary['positive']).toBeGreaterThanOrEqual(0);\n      expect(Number.isFinite(summary['positive'])).toBe(true);\n    });\n\n    it('stop() returns the stopped entry', () => {\n      const tt = freshTracker();\n      const started = tt.start('ret-me');\n      const stopped = tt.stop();\n      expect(stopped).toBe(started); // same object reference\n      expect(stopped.name).toBe('ret-me');\n    });\n\n    it('auto-stop returns the new entry and the previous task is stopped', () => {\n      const tt = freshTracker();\n      const first = tt.start('first');\n      const second = tt.start('second');\n\n      // Auto-stop should have stopped the first\n      expect(first.stop).not.toBeNull();\n      expect(first.stop).toBeGreaterThanOrEqual(first.start);\n\n      // The returned entry should be the new one\n      expect(second.name).toBe('second');\n      expect(second.stop).toBeNull();\n    });\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":152,"cache_creation_input_tokens":0,"cache_read_input_tokens":26880,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9b5806b2-f5f0-43db-81db-cd656381a2ad","uuid":"c535cef0-2fe2-4184-87f5-b7aecbb0a05d"}
