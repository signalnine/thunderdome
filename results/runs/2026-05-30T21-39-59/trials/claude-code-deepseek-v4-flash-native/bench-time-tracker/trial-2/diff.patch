+++ b/src/time-tracker.ts
@@ -0,0 +1,154 @@
+import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+import type { TimeEntry, LogFilter, Summary, TimeTrackerOptions } from './types.js';
+
+const DEFAULT_FILE_PATH = './time-tracker-data.json';
+
+/**
+ * A time tracker that persists entries to a JSON file.
+ *
+ * Provides start/stop timer semantics, querying, and summary aggregation.
+ */
+export class TimeTracker {
+  private filePath: string;
+  private entries: TimeEntry[];
+
+  /**
+   * @param options  Optional configuration (file path for persistence).
+   */
+  constructor(options?: TimeTrackerOptions) {
+    this.filePath = options?.filePath ?? DEFAULT_FILE_PATH;
+    this.entries = [];
+    this.load();
+  }
+
+  // ---------------------------------------------------------------
+  // Public API
+  // ---------------------------------------------------------------
+
+  /**
+   * Start tracking a named task.
+   *
+   * If another timer is already running, it is automatically stopped first.
+   *
+   * @param name  The task name (must be non-empty after trim).
+   * @returns     The newly created entry.
+   * @throws      If `name` is empty or only whitespace.
+   */
+  start(name: string): TimeEntry {
+    if (!name || name.trim().length === 0) {
+      throw new Error('Task name cannot be empty');
+    }
+
+    // Auto-stop any currently running entry
+    const active = this.getActiveTask();
+    if (active) {
+      active.stop = Date.now();
+    }
+
+    const entry: TimeEntry = {
+      name,
+      start: Date.now(),
+      stop: null,
+    };
+
+    this.entries.push(entry);
+    this.save();
+
+    return entry;
+  }
+
+  /**
+   * Stop the currently running timer.
+   *
+   * @returns The stopped entry (its `stop` field is set to the current time).
+   * @throws  If no timer is currently running.
+   */
+  stop(): TimeEntry {
+    const active = this.getActiveTask();
+    if (!active) {
+      throw new Error('No timer is currently running');
+    }
+
+    active.stop = Date.now();
+    this.save();
+
+    return active;
+  }
+
+  /**
+   * Retrieve all time entries, optionally filtered.
+   *
+   * When a `since` filter is provided, entries that started on or after that
+   * date are returned. Running entries are always included regardless of
+   * when they started.
+   *
+   * @param filter  Optional filter criteria.
+   * @returns       A shallow copy of the matching entries array.
+   */
+  getLog(filter?: LogFilter): TimeEntry[] {
+    if (!filter?.since) {
+      return [...this.entries];
+    }
+
+    const sinceTime = filter.since.getTime();
+    return this.entries.filter(
+      (entry) => entry.start >= sinceTime || entry.stop === null,
+    );
+  }
+
+  /**
+   * Summarise total time spent per task name.
+   *
+   * Results are in milliseconds and include running tasks (their duration
+   * is calculated against the current time).
+   *
+   * @returns A record keyed by task name with total duration in ms.
+   */
+  getSummary(): Summary {
+    const summary: Summary = {};
+
+    for (const entry of this.entries) {
+      const stopTime = entry.stop ?? Date.now();
+      const duration = stopTime - entry.start;
+
+      if (Object.prototype.hasOwnProperty.call(summary, entry.name)) {
+        summary[entry.name] += duration;
+      } else {
+        summary[entry.name] = duration;
+      }
+    }
+
+    return summary;
+  }
+
+  /**
+   * Get the currently running task, if any.
+   *
+   * @returns The active entry, or `null` if nothing is running.
+   */
+  getActiveTask(): TimeEntry | null {
+    return this.entries.find((entry) => entry.stop === null) ?? null;
+  }
+
+  // ---------------------------------------------------------------
+  // Persistence
+  // ---------------------------------------------------------------
+
+  /** Load entries from the JSON file on disk, if it exists. */
+  private load(): void {
+    try {
+      const raw = readFileSync(this.filePath, 'utf-8');
+      this.entries = JSON.parse(raw) as TimeEntry[];
+    } catch {
+      // File doesn't exist yet or is invalid — start fresh
+      this.entries = [];
+    }
+  }
+
+  /** Persist the current entries array to the JSON file. */
+  private save(): void {
+    mkdirSync(dirname(this.filePath), { recursive: true });
+    writeFileSync(this.filePath, JSON.stringify(this.entries, null, 2), 'utf-8');
+  }
+}
