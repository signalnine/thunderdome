+export interface Event {
+  id: string;
+  name: string;
+  duration: number;       // in minutes
+  attendees?: number;     // number of people attending (default: 1)
+  prerequisites?: string[]; // event IDs that must finish before this starts
+  preferredRoom?: string; // room ID preference (hint, not hard constraint)
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number;       // max attendees
+}
+
+export interface ScheduleOptions {
+  startTime: number;      // minutes from midnight (e.g., 540 = 9:00 AM)
+  endTime: number;        // minutes from midnight (e.g., 1020 = 5:00 PM)
+  gap?: number;           // minimum gap in minutes between events in same room (default: 15)
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;      // minutes from midnight
+  endTime: number;        // minutes from midnight
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[];  // event IDs that could not be scheduled
+}
+
+/**
+ * Validate the prerequisite graph for cycles and return a topological ordering of events.
+ * The ordering determines the scheduling priority while respecting prerequisite constraints.
+ * Throws an error if a cycle is detected (including self-references).
+ */
+function validateAndTopoSort(events: Event[], rooms: Room[]): Event[] {
+  const eventMap = new Map<string, Event>();
+  for (const e of events) {
+    if (eventMap.has(e.id)) {
+      throw new Error(`Duplicate event ID: ${e.id}`);
+    }
+    eventMap.set(e.id, e);
+  }
+
+  // Check self-references first (fast path)
+  for (const e of events) {
+    if (e.prerequisites) {
+      for (const prereqId of e.prerequisites) {
+        if (prereqId === e.id) {
+          throw new Error(
+            `Prerequisite graph contains a cycle: event "${e.id}" has a self-referencing prerequisite`
+          );
+        }
+      }
+    }
+  }
+
+  // Three-color DFS cycle detection
+  const WHITE = 0, GRAY = 1, BLACK = 2;
+  const color = new Map<string, number>();
+  for (const e of events) {
+    color.set(e.id, WHITE);
+  }
+
+  function dfs(eventId: string): void {
+    color.set(eventId, GRAY);
+    const e = eventMap.get(eventId);
+    if (e?.prerequisites) {
+      for (const prereqId of e.prerequisites) {
+        if (!eventMap.has(prereqId)) continue; // missing prereq – treat as satisfied
+        const c = color.get(prereqId);
+        if (c === GRAY) {
+          throw new Error(
+            `Cycle detected in prerequisite graph involving event "${prereqId}"`
+          );
+        }
+        if (c === WHITE) {
+          dfs(prereqId);
+        }
+      }
+    }
+    color.set(eventId, BLACK);
+  }
+
+  for (const e of events) {
+    if (color.get(e.id) === WHITE) {
+      dfs(e.id);
+    }
+  }
+
+  // Build forward graph for Kahn's algorithm: prereqId -> dependent
+  const forwardGraph = new Map<string, string[]>();
+  const dependentsCount = new Map<string, number>();
+  const inDegree = new Map<string, number>();
+
+  for (const e of events) {
+    forwardGraph.set(e.id, []);
+    dependentsCount.set(e.id, 0);
+    inDegree.set(e.id, 0);
+  }
+
+  for (const e of events) {
+    if (e.prerequisites) {
+      for (const prereqId of e.prerequisites) {
+        if (eventMap.has(prereqId)) {
+          forwardGraph.get(prereqId)!.push(e.id);
+          dependentsCount.set(prereqId, (dependentsCount.get(prereqId) ?? 0) + 1);
+          inDegree.set(e.id, (inDegree.get(e.id) ?? 0) + 1);
+        }
+      }
+    }
+  }
+
+  // Pre-compute how many rooms each event is eligible for (by capacity)
+  const eligibleRoomCount = new Map<string, number>();
+  for (const e of events) {
+    const attendees = e.attendees ?? 1;
+    const count = rooms.filter(r => r.capacity >= attendees).length;
+    eligibleRoomCount.set(e.id, count);
+  }
+
+  // Kahn's algorithm
+  const queue: string[] = [];
+  for (const [id, degree] of inDegree) {
+    if (degree === 0) {
+      queue.push(id);
+    }
+  }
+
+  const sorted: Event[] = [];
+  while (queue.length > 0) {
+    // Sort ready nodes by scheduling priority:
+    //   1. Fewer eligible rooms first (most resource-constrained)
+    //   2. Longer duration first (harder to fit in gaps)
+    //   3. More dependents first (they constrain more future scheduling)
+    //   4. Deterministic tiebreaker by ID
+    queue.sort((a, b) => {
+      const ea = eventMap.get(a)!;
+      const eb = eventMap.get(b)!;
+
+      // Fewer room options = more constrained = higher priority
+      const rcA = eligibleRoomCount.get(a) ?? rooms.length;
+      const rcB = eligibleRoomCount.get(b) ?? rooms.length;
+      if (rcA !== rcB) return rcA - rcB;
+
+      // Longer events are harder to fit — process them first
+      if (ea.duration !== eb.duration) return eb.duration - ea.duration;
+
+      // More dependents = more critical
+      const da = dependentsCount.get(a) ?? 0;
+      const db = dependentsCount.get(b) ?? 0;
+      if (da !== db) return db - da;
+
+      return a.localeCompare(b);
+    });
+
+    const id = queue.shift()!;
+    sorted.push(eventMap.get(id)!);
+
+    for (const neighbor of forwardGraph.get(id) ?? []) {
+      const nd = (inDegree.get(neighbor) ?? 1) - 1;
+      inDegree.set(neighbor, nd);
+      if (nd === 0) {
+        queue.push(neighbor);
+      }
+    }
+  }
+
+  return sorted;
+}
+
+/**
+ * Find the earliest valid start time for an event of the given duration in a room,
+ * respecting existing intervals and gap constraints.
+ */
+function findEarliestStart(
+  duration: number,
+  earliestPossibleStart: number,
+  intervals: Array<{ start: number; end: number }>,
+  options: ScheduleOptions,
+  gap: number,
+): number | null {
+  let candidate = Math.max(earliestPossibleStart, options.startTime);
+  if (candidate + duration > options.endTime) return null;
+
+  // Intervals are stored unsorted; sort for the search
+  const sorted = [...intervals].sort((a, b) => a.start - b.start);
+
+  for (const interval of sorted) {
+    if (candidate + duration + gap <= interval.start) {
+      // Candidate fits before this interval (with gap)
+      if (candidate + duration <= options.endTime) return candidate;
+      return null;
+    }
+    if (candidate < interval.end + gap) {
+      // Overlap; slide past this interval + gap
+      candidate = interval.end + gap;
+      if (candidate + duration > options.endTime) return null;
+    }
+  }
+
+  // Fits after all existing intervals
+  return candidate + duration <= options.endTime ? candidate : null;
+}
+
+/**
+ * Try to backfill unscheduled events into any remaining gaps across all rooms.
+ * This is a second pass that attempts to place events that the greedy first pass couldn't.
+ */
+function tryBackfill(
+  event: Event,
+  rooms: Room[],
+  roomIntervals: Map<string, Array<{ start: number; end: number }>>,
+  finishTimes: Map<string, number>,
+  options: ScheduleOptions,
+  gap: number,
+): { roomId: string; startTime: number } | null {
+  const attendees = event.attendees ?? 1;
+  const eligibleRooms = rooms.filter(r => r.capacity >= attendees);
+  if (eligibleRooms.length === 0) return null;
+
+  // Minimum start based on prerequisites
+  let earliestPossibleStart = options.startTime;
+  if (event.prerequisites) {
+    for (const prereqId of event.prerequisites) {
+      const prereqFinish = finishTimes.get(prereqId);
+      if (prereqFinish !== undefined) {
+        earliestPossibleStart = Math.max(earliestPossibleStart, prereqFinish + gap);
+      }
+    }
+  }
+
+  // Sort rooms: preferred first, then tightest fit
+  const orderedRooms = [...eligibleRooms].sort((a, b) => {
+    if (event.preferredRoom) {
+      if (a.id === event.preferredRoom && b.id !== event.preferredRoom) return -1;
+      if (a.id !== event.preferredRoom && b.id === event.preferredRoom) return 1;
+    }
+    const wasteA = a.capacity - attendees;
+    const wasteB = b.capacity - attendees;
+    return wasteA !== wasteB ? wasteA - wasteB : a.id.localeCompare(b.id);
+  });
+
+  for (const room of orderedRooms) {
+    const intervals = roomIntervals.get(room.id)!;
+    const startTime = findEarliestStart(
+      event.duration,
+      earliestPossibleStart,
+      intervals,
+      options,
+      gap,
+    );
+    if (startTime !== null) {
+      return { roomId: room.id, startTime };
+    }
+  }
+
+  return null;
+}
+
+/**
+ * Schedule events into rooms respecting capacity, time window, prerequisites,
+ * gaps, and room preferences while maximizing the total number of scheduled events.
+ */
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const gap = options.gap ?? 15;
+
+  // Step 1: Validate prerequisites (cycle detection) and get topological order
+  const sortedEvents = validateAndTopoSort(events, rooms);
+
+  // Step 2: Initialise state
+  const eventMap = new Map(events.map(e => [e.id, e]));
+  const finishTimes = new Map<string, number>();
+  const roomIntervals = new Map<string, Array<{ start: number; end: number }>>();
+  for (const room of rooms) {
+    roomIntervals.set(room.id, []);
+  }
+
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+
+  // Step 3: First pass – greedy scheduling in topological order
+  for (const event of sortedEvents) {
+    const attendees = event.attendees ?? 1;
+
+    // Filter rooms by capacity
+    const eligibleRooms = rooms.filter(r => r.capacity >= attendees);
+    if (eligibleRooms.length === 0) {
+      unscheduled.push(event.id);
+      continue;
+    }
+
+    // Determine earliest start based on prerequisite finish times
+    let earliestPossibleStart = options.startTime;
+    if (event.prerequisites) {
+      for (const prereqId of event.prerequisites) {
+        const prereqFinish = finishTimes.get(prereqId);
+        if (prereqFinish !== undefined) {
+          earliestPossibleStart = Math.max(earliestPossibleStart, prereqFinish + gap);
+        }
+      }
+    }
+
+    // Evaluate all eligible rooms; prefer:
+    //   a) the preferred room (if it can accommodate the event), or
+    //   b) the room offering the earliest start time (with tightest capacity fit as tiebreaker)
+    let bestPlacement: { roomId: string; startTime: number } | null = null;
+
+    // Sort rooms for evaluation order
+    const orderedRooms = [...eligibleRooms].sort((a, b) => {
+      // Preferred room first
+      if (event.preferredRoom) {
+        if (a.id === event.preferredRoom && b.id !== event.preferredRoom) return -1;
+        if (a.id !== event.preferredRoom && b.id === event.preferredRoom) return 1;
+      }
+      // Tightest capacity fit first
+      const wasteA = a.capacity - attendees;
+      const wasteB = b.capacity - attendees;
+      if (wasteA !== wasteB) return wasteA - wasteB;
+      return a.id.localeCompare(b.id);
+    });
+
+    for (const room of orderedRooms) {
+      const intervals = roomIntervals.get(room.id)!;
+      const startTime = findEarliestStart(
+        event.duration,
+        earliestPossibleStart,
+        intervals,
+        options,
+        gap,
+      );
+
+      if (startTime !== null) {
+        // If this is the preferred room, take it immediately
+        if (room.id === event.preferredRoom) {
+          bestPlacement = { roomId: room.id, startTime };
+          break;
+        }
+        // Otherwise, track the earliest available across all rooms
+        if (!bestPlacement || startTime < bestPlacement.startTime) {
+          bestPlacement = { roomId: room.id, startTime };
+        }
+      }
+    }
+
+    if (bestPlacement) {
+      const { roomId, startTime } = bestPlacement;
+      const endTime = startTime + event.duration;
+
+      roomIntervals.get(roomId)!.push({ start: startTime, end: endTime });
+      finishTimes.set(event.id, endTime);
+
+      assignments.push({ eventId: event.id, roomId, startTime, endTime });
+    } else {
+      unscheduled.push(event.id);
+    }
+  }
+
+  // Step 4: Second pass – try to backfill any unscheduled events into remaining gaps
+  if (unscheduled.length > 0) {
+    const remainingUnscheduled: string[] = [];
+
+    for (const eventId of unscheduled) {
+      const event = eventMap.get(eventId)!;
+      const placement = tryBackfill(
+        event,
+        rooms,
+        roomIntervals,
+        finishTimes,
+        options,
+        gap,
+      );
+
+      if (placement) {
+        const { roomId, startTime } = placement;
+        const endTime = startTime + event.duration;
+
+        roomIntervals.get(roomId)!.push({ start: startTime, end: endTime });
+        finishTimes.set(event.id, endTime);
+
+        assignments.push({ eventId: event.id, roomId, startTime, endTime });
+      } else {
+        remainingUnscheduled.push(eventId);
+      }
+    }
+
+    return { assignments, unscheduled: remainingUnscheduled };
+  }
+
+  return { assignments, unscheduled };
+}
+
+export default schedule;
