ing, number>();\n  for (const e of events) {\n    colors.set(e.id, WHITE);\n  }\n\n  // Build forward graph (prereq -> dependent) and reverse graph (dependent -> prereq)\n  const forwardGraph = new Map<string, string[]>();\n  const inDegree = new Map<string, number>();\n  \n  for (const e of events) {\n    forwardGraph.set(e.id, []);\n    inDegree.set(e.id, 0);\n  }\n\n  for (const e of events) {\n    if (e.prerequisites) {\n      for (const prereqId of e.prerequisites) {\n        if (prereqId === e.id) {\n          throw new Error(`Cycle detected: event \"${e.id}\" has a self-referencing prerequisite`);\n        }\n        if (eventMap.has(prereqId)) {\n          forwardGraph.get(prereqId)!.push(e.id);\n          inDegree.set(e.id, inDegree.get(e.id)! + 1);\n        }\n      }\n    }\n  }\n\n  // DFS for cycle detection\n  function dfs(eventId: string): void {\n    colors.set(eventId, GRAY);\n    const e = eventMap.get(eventId)!;\n    if (e.prerequisites) {\n      for (const prereqId of e.prerequisites) {\n        if (!eventMap.has(prereqId)) continue;\n        const c = colors.get(prereqId)!;\n        if (c === GRAY) {\n          throw new Error(`Cycle detected in prerequisite graph involving event \"${prereqId}\"`);\n        }\n        if (c === WHITE) {\n          dfs(prereqId);\n        }\n      }\n    }\n    colors.set(eventId, BLACK);\n  }\n\n  for (const e of events) {\n    if (colors.get(e.id) === WHITE) {\n      dfs(e.id);\n    }\n  }\n\n  // Kahn's algorithm for topological sort\n  const queue: string[] = [];\n  for (const [id, degree] of inDegree) {\n    if (degree === 0) {\n      queue.push(id);\n    }\n  }\n\n  const sorted: Event[] = [];\n  while (queue.length > 0) {\n    // Sort queue by scheduling priority:\n    // 1. Shorter events first (easier to place, maximize count)\n    // 2. Larger capacity need first (fewer room options)\n    // 3. More dependents first (they constrain more future events)\n    // 4. Alphabetical by ID for determinism\n    queue.sort((a, b) => {\n      const ea = eventMap.get(a)!;\n      const eb = eventMap.get(b)!;\n      \n      // Shorter first\n      if (ea.duration !== eb.duration) return ea.duration - eb.duration;\n      \n      // Larger capacity need first\n      const ca = ea.attendees ?? 1;\n      const cb = eb.attendees ?? 1;\n      if (ca !== cb) return cb - ca;\n      \n      // More dependents first (number of outgoing edges)\n      const da = forwardGraph.get(a)?.length ?? 0;\n      const db = forwardGraph.get(b)?.length ?? 0;\n      if (da !== db) return db - da;\n      \n      // Deterministic tiebreaker\n      return a.localeCompare(b);\n    });\n    \n    const id = queue.shift()!;\n    sorted.push(eventMap.get(id)!);\n    \n    for (const neighbor of forwardGraph.get(id) || []) {\n      const nd = inDegree.get(neighbor)! - 1;\n      inDegree.set(neighbor, nd);\n      if (nd === 0) {\n        queue.push(neighbor);\n      }\n    }\n  }\n\n  // Check if all events were sorted (if not, there's a cycle - but we already checked)\n  // Actually, Kahn's algorithm can detect cycles too, but our DFS already handles it\n  return sorted;\n}\n\nfunction schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {\n  const gap = options.gap ?? 15;\n  \n  // Validate and topologically sort\n  const sortedEvents = validateAndTopoSort(events);\n  \n  // Build event map\n  const eventMap = new Map(events.map(e => [e.id, e]));\n  \n  // Track finish times of scheduled events (for prerequisite checking)\n  const finishTimes = new Map<string, number>();\n  \n  // Track room schedules - for each room, a list of [start, end] intervals\n  const roomIntervals = new Map<string, Array<{ start: number; end: number }>>();\n  for (const room of rooms) {\n    roomIntervals.set(room.id, []);\n  }\n  \n  const assignments: Assignment[] = [];\n  const unscheduled: string[] = [];\n  \n  // Helper: find earliest valid start time for an event in a given room\n  function findEarl