all', capacity: 200 },\n      { id: 'roomA', name: 'Room A', capacity: 40 },\n      { id: 'roomB', name: 'Room B', capacity: 25 },\n      { id: 'roomC', name: 'Room C', capacity: 20 },\n    ];\n\n    const result = s(events, rooms, {\n      startTime: 540,  // 9:00\n      endTime: 1020,    // 17:00\n      gap: 15,\n    });\n\n    // All events should be scheduled in this scenario\n    expect(result.unscheduled).toHaveLength(0);\n    expect(result.assignments).toHaveLength(6);\n\n    // Keynote must be first\n    const keynote = result.assignments.find(a => a.eventId === 'keynote')!;\n    expect(keynote.startTime).toBe(540);\n\n    // All workshops must start after keynote + gap\n    for (const ws of ['workshopA', 'workshopB', 'workshopC']) {\n      const a = result.assignments.find(ass => ass.eventId === ws)!;\n      expect(a.startTime).toBeGreaterThanOrEqual(keynote.endTime + 15);\n    }\n\n    // Lunch must start after ALL workshops finish (+ gap)\n    const lunch = result.assignments.find(a => a.eventId === 'lunch')!;\n    const wsEnds = ['workshopA', 'workshopB', 'workshopC']\n      .map(id => result.assignments.find(a => a.eventId === id)!.endTime);\n    expect(lunch.startTime).toBeGreaterThanOrEqual(Math.max(...wsEnds) + 15);\n\n    // Panel must start after lunch\n    const panel = result.assignments.find(a => a.eventId === 'panel')!;\n    expect(panel.startTime).toBeGreaterThanOrEqual(lunch.endTime + 15);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
