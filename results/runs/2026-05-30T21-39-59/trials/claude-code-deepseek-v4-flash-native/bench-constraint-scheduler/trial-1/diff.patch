\n        if (prereqId === e.id) {\n          throw new Error(\n            `Prerequisite graph contains a cycle: event \"${e.id}\" has a self-referencing prerequisite`\n          );\n        }\n      }\n    }\n  }\n\n  // Three-color DFS cycle detection\n  const WHITE = 0, GRAY = 1, BLACK = 2;\n  const color = new Map<string, number>();\n  for (const e of events) {\n    color.set(e.id, WHITE);\n  }\n\n  function dfs(eventId: string): void {\n    color.set(eventId, GRAY);\n    const e = eventMap.get(eventId);\n    if (e?.prerequisites) {\n      for (const prereqId of e.prerequisites) {\n        if (!eventMap.has(prereqId)) continue; // missing prereq – treat as satisfied\n        const c = color.get(prereqId);\n        if (c === GRAY) {\n          throw new Error(\n            `Cycle detected in prerequisite graph involving event \"${prereqId}\"`\n          );\n        }\n        if (c === WHITE) {\n          dfs(prereqId);\n        }\n      }\n    }\n    color.set(eventId, BLACK);\n  }\n\n  for (const e of events) {\n    if (color.get(e.id) === WHITE) {\n      dfs(e.id);\n    }\n  }\n\n  // Build forward graph for Kahn's algorithm: prereqId -> dependent\n  const forwardGraph = new Map<string, string[]>();\n  const dependentsCount = new Map<string, number>(); // how many events depend on this one\n  const inDegree = new Map<string, number>();\n\n  for (const e of events) {\n    forwardGraph.set(e.id, []);\n    dependentsCount.set(e.id, 0);\n    inDegree.set(e.id, 0);\n  }\n\n  for (const e of events) {\n    if (e.prerequisites) {\n      for (const prereqId of e.prerequisites) {\n        if (eventMap.has(prereqId)) {\n          forwardGraph.get(prereqId)!.push(e.id);\n          dependentsCount.set(prereqId, (dependentsCount.get(prereqId) ?? 0) + 1);\n          inDegree.set(e.id, (inDegree.get(e.id) ?? 0) + 1);\n        }\n      }\n    }\n  }\n\n  // Kahn's algorithm\n  const queue: string[] = [];\n  for (const [id, degree] of inDegree) {\n    if (degree === 0) {\n   