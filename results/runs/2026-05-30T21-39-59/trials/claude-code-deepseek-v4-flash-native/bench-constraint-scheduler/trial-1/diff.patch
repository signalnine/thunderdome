+    // e2 and e3 both start after e1
+    for (const a of result.assignments) {
+      if (a.eventId !== 'e1') {
+        expect(a.startTime).toBeGreaterThanOrEqual(e1.endTime + 15);
+      }
+    }
+  });
+});
+
+// ── Prerequisite Cycles ───────────────────────────────────────────────────────
+describe('Prerequisite Cycles', () => {
