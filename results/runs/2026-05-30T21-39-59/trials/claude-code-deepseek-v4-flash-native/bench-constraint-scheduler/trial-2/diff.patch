+import { describe, it, expect } from 'vitest';
+import { schedule } from './scheduler.js';
+import type { Event, Room, ScheduleOptions } from './types.js';
+
+describe('Constraint-Based Event Scheduler', () => {
+  // ===================================================================
+  // Basic scheduling
+  // ===================================================================
+
+  it('should schedule a single event in a room', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Workshop', duration: 60, attendees: 10 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 20 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 1020 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(1);
+    expect(result.unscheduled).toHaveLength(0);
+    expect(result.assignments[0].eventId).toBe('e1');
+    expect(result.assignments[0].roomId).toBe('r1');
+    expect(result.assignments[0].startTime).toBe(540);
+    expect(result.assignments[0].endTime).toBe(600);
+  });
+
+  it('should use default attendees = 1 when not specified', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Workshop', duration: 30 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 1 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 600 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(1);
+    expect(result.unscheduled).toHaveLength(0);
+  });
+
+  it('should use default gap = 15 when not specified', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Event 1', duration: 30 },
+      { id: 'e2', name: 'Event 2', duration: 30 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 10 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 660 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(2);
+    // e1: 540-570, then 15 gap, e2: 585-615
+    expect(result.assignments.find((a) => a.eventId === 'e1')?.startTime).toBe(540);
+    expect(result.assignments.find((a) => a.eventId === 'e2')?.startTime).toBe(585);
+  });
+
+  it('should use custom gap when specified', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Event 1', duration: 30 },
+      { id: 'e2', name: 'Event 2', duration: 30 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 10 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 30 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(2);
+    // e1: 540-570, then 30 gap, e2: 600-630
+    expect(result.assignments.find((a) => a.eventId === 'e2')?.startTime).toBe(600);
+  });
+
+  // ===================================================================
+  // Room capacity
+  // ===================================================================
+
+  it('should not schedule an event in a room with insufficient capacity', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Big Event', duration: 60, attendees: 50 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Small Room', capacity: 10 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 1020 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(0);
+    expect(result.unscheduled).toEqual(['e1']);
+  });
+
+  it('should select a room with sufficient capacity when multiple rooms exist', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Big Event', duration: 60, attendees: 30 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Small Room', capacity: 10 },
+      { id: 'r2', name: 'Medium Room', capacity: 30 },
+      { id: 'r3', name: 'Large Room', capacity: 100 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 1020 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(1);
+    // Should be placed in either r2 or r3
+    expect(['r2', 'r3']).toContain(result.assignments[0].roomId);
+  });
+
+  // ===================================================================
+  // Time window
+  // ===================================================================
+
+  it('should not schedule events that exceed the time window', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Long Event', duration: 120, attendees: 5 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 10 },
+    ];
+    // Only 30 minute window
+    const options: ScheduleOptions = { startTime: 540, endTime: 570 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(0);
+    expect(result.unscheduled).toEqual(['e1']);
+  });
+
+  it('should schedule events exactly at the window boundaries', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Morning', duration: 60, attendees: 5 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 10 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 600 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(1);
+    expect(result.assignments[0].startTime).toBe(540);
+    expect(result.assignments[0].endTime).toBe(600);
+  });
+
+  // ===================================================================
+  // Room gaps
+  // ===================================================================
+
+  it('should enforce gaps between events in the same room', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Event 1', duration: 30 },
+      { id: 'e2', name: 'Event 2', duration: 30 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 10 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 30 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(2);
+    const e1 = result.assignments.find((a) => a.eventId === 'e1')!;
+    const e2 = result.assignments.find((a) => a.eventId === 'e2')!;
+    // e2 should start at least 30 min after e1 ends
+    expect(e2.startTime - e1.endTime).toBeGreaterThanOrEqual(30);
+  });
+
+  it('should allow back-to-back events when gap is 0', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Event 1', duration: 30 },
+      { id: 'e2', name: 'Event 2', duration: 30 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 10 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 600, gap: 0 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(2);
+    // e1: 540-570, e2: 570-600
+    expect(result.assignments.find((a) => a.eventId === 'e2')?.startTime).toBe(570);
+  });
+
+  // ===================================================================
+  // Prerequisites
+  // ===================================================================
+
+  it('should respect prerequisite ordering', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Setup', duration: 30 },
+      { id: 'e2', name: 'Main Event', duration: 60, prerequisites: ['e1'] },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 10 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 15 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(2);
+    const e1 = result.assignments.find((a) => a.eventId === 'e1')!;
+    const e2 = result.assignments.find((a) => a.eventId === 'e2')!;
+
+    // e1 must finish before e2 starts
+    expect(e1.endTime + 15).toBeLessThanOrEqual(e2.startTime);
+  });
+
+  it('should enforce gap between prerequisite and dependent events', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Setup', duration: 30 },
+      { id: 'e2', name: 'Main Event', duration: 30, prerequisites: ['e1'] },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 10 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 30 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(2);
+    const e1 = result.assignments.find((a) => a.eventId === 'e1')!;
+    const e2 = result.assignments.find((a) => a.eventId === 'e2')!;
+    // e1 ends at 570, gap 30 means e2 can start at 600
+    expect(e1.endTime + 30).toBeLessThanOrEqual(e2.startTime);
+  });
+
+  it('should handle multi-level prerequisites', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'A', duration: 30 },
+      { id: 'e2', name: 'B', duration: 30, prerequisites: ['e1'] },
+      { id: 'e3', name: 'C', duration: 30, prerequisites: ['e2'] },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 10 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 720, gap: 15 };
+
+    const result = schedule(events, rooms, options);
+    expect(result.assignments).toHaveLength(3);
+    const e1 = result.assignments.find((a) => a.eventId === 'e1')!;
+    const e2 = result.assignments.find((a) => a.eventId === 'e2')!;
+    const e3 = result.assignments.find((a) => a.eventId === 'e3')!;
+
+    expect(e1.endTime + 15).toBeLessThanOrEqual(e2.startTime);
+    expect(e2.endTime + 15).toBeLessThanOrEqual(e3.startTime);
+  });
+
+  it('should handle multiple prerequisites', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Part 1', duration: 30 },
+      { id: 'e2', name: 'Part 2', duration: 30 },
+      { id: 'e3', name: 'Final', duration: 30, prerequisites: ['e1', 'e2'] },
+    ];
+    const room: Room = { id: 'r1', name: 'Room A', capacity: 10 };
+    const options: ScheduleOptions = { startTime: 540, endTime: 780, gap: 15 };
+
+    const result = schedule([...events], [room], options);
+    expect(result.assignments).toHaveLength(3);
+    const e3 = result.assignments.find((a) => a.eventId === 'e3')!;
+    const e1End = result.assignments.find((a) => a.eventId === 'e1')!.endTime;
+    const e2End = result.assignments.find((a) => a.eventId === 'e2')!.endTime;
+    // e3 should start after max(e1.endTime, e2.endTime) + gap
+    expect(e3.startTime).toBeGreaterThanOrEqual(Math.max(e1End, e2End) + 15);
+  });
+
+  it('should mark dependent events as unscheduled when prerequisites are unscheduled', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Setup', duration: 120, attendees: 100 },
+      { id: 'e2', name: 'Main', duration: 30, prerequisites: ['e1'] },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Small Room', capacity: 10 },
+    ];
+    const options: ScheduleOptions = { startTime: 540, endTime: 600 };
+
+    const result = schedule(events, rooms, options);
+    // e1 can't fit (capacity), so e2 can't either
+    expect(result.unscheduled).toContain('e1');
+    expect(result.unscheduled).toContain('e2');
+  });
+
+  // ===================================================================
+  // Cycle detection
+  // ===================================================================
+
+  it('should throw on self-referencing prerequisite', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Self Loop', duration: 30, prerequisites: ['e1'] },
+    ];
+    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];
