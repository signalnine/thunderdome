itable rooms (meet capacity requirements)\n      const validRooms = rooms.filter((r) => r.capacity >= attendees);\n\n      if (validRooms.length === 0) {\n        unscheduled.push(eventId);\n        continue;\n      }\n\n      // Order rooms: preferred first, then by capacity ascending (closest fit)\n      const orderedRooms = [...validRooms].sort((a, b) => {\n        if (event.preferredRoom) {\n          if (a.id === event.preferredRoom && b.id === event.preferredRoom) {\n            return a.capacity - b.capacity;\n          }\n          if (a.id === event.preferredRoom) return -1;\n          if (b.id === event.preferredRoom) return 1;\n        }\n        return a.capacity - b.capacity;\n      });\n\n      // Try to find the best slot: earliest available, preferring preferred room\n      const earliestAllowedStart = prerequisiteEndTime + gap;\n\n      let bestSlot: { start: number; end: number } | null = null;\n      let bestRoomId: string | null = null;\n      let bestStart = Infinity;\n\n      for (const room of orderedRooms) {\n        const slot = findEarliestSlot(\n          room.id,\n          event.duration,\n          options.startTime,\n          options.endTime,\n          gap,\n          assignments,\n          earliestAllowedStart\n        );\n\n        if (slot) {\n          // Prefer earlier start times, with tiebreaker being room preference\n          if (slot.start < bestStart) {\n            bestStart = slot.start;\n            bestSlot = slot;\n            bestRoomId = room.id;\n          }\n        }\n      }\n\n      if (bestSlot && bestRoomId) {\n        assignments.push({\n          eventId: event.id,\n          roomId: bestRoomId,\n          startTime: bestSlot.start,\n          endTime: bestSlot.end,\n        });\n        scheduled.add(event.id);\n      } else {\n        unscheduled.push(eventId);\n      }\n    }\n  }\n\n  return { assignments, unscheduled };\n}\n\n/**\n * Main schedule function.\n *\n * Assigns events to rooms within a tim