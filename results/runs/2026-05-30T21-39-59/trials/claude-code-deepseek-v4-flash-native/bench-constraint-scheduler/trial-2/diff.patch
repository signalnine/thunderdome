equisite error: event \"${names.get(id) ?? id}\" references unknown event \"${prereq}\"`\n        );\n      }\n      if (color.get(prereq) === GRAY) {\n        throw new Error(\n          `Prerequisite cycle detected involving event: \"${names.get(id) ?? id}\"`\n        );\n      }\n      if (color.get(prereq) === WHITE) {\n        dfs(prereq);\n      }\n    }\n\n    color.set(id, BLACK);\n  }\n\n  for (const event of events) {\n    if (color.get(event.id) === WHITE) {\n      dfs(event.id);\n    }\n  }\n}\n\n/**\n * Topological sort using Kahn's algorithm.\n * Returns event IDs in dependency order (prerequisites before dependents).\n */\nfunction topologicalSort(events: Event[]): string[] {\n  const graph = new Map<string, string[]>();\n  const inDegree = new Map<string, number>();\n\n  for (const event of events) {\n    graph.set(event.id, []);\n    inDegree.set(event.id, 0);\n  }\n\n  for (const event of events) {\n    for (const prereq of event.prerequisites ?? []) {\n      graph.get(prereq)?.push(event.id);\n      inDegree.set(event.id, (inDegree.get(event.id) ?? 0) + 1);\n    }\n  }\n\n  const queue: string[] = [];\n  for (const [id, degree] of inDegree) {\n    if (degree === 0) {\n      queue.push(id);\n    }\n  }\n\n  const result: string[] = [];\n  const sortedSet = new Set<string>();\n\n  while (queue.length > 0) {\n    // Process nodes with same in-degree together, but sort by constrainedness\n    // within the same \"batch\" — this is handled later during scheduling.\n    const id = queue.shift()!;\n    result.push(id);\n    sortedSet.add(id);\n\n    for (const neighbor of graph.get(id) ?? []) {\n      const newDegree = (inDegree.get(neighbor) ?? 1) - 1;\n      inDegree.set(neighbor, newDegree);\n      if (newDegree === 0) {\n        queue.push(neighbor);\n      }\n    }\n  }\n\n  if (result.length !== events.length) {\n    throw new Error('Prerequisite cycle detected in graph');\n  }\n\n  return result;\n}\n\n/**\n * Compute DAG levels for each event (0 = no prerequisites, 1 = depends on level 0, etc.)\n */\nfunction computeLevels(events: Event[]): Map<string, number> {\n  const eventMap = new Map<string, Event>();\n  for (const event of events) {\n    eventMap.set(event.id, event);\n  }\n\n  const levels = new Map<string, number>();\n  const computed = new Set<string>();\n\n  function getLevel(id: string): number {\n    if (computed.has(id)) {\n      return levels.get(id) ?? 0;\n    }\n    const event = eventMap.get(id);\n    if (!event || !event.prerequisites || event.prerequisites.length === 0) {\n      levels.set(id, 0);\n      computed.add(id);\n      return 0;\n    }\n    let maxPrereqLevel = 0;\n    for (const prereqId of event.prerequisites) {\n      maxPrereqLevel = Math.max(maxPrereqLevel, getLevel(prereqId));\n    }\n    const level = maxPrereqLevel + 1;\n    levels.set(id, level);\n    computed.add(id);\n    return level;\n  }\n\n  for (const event of events) {\n    getLevel(event.id);\n  }\n\n  return levels;\n}\n\n/**\n * Room-time slot finder.\n * Finds the earliest available time slot for an event in a given room,\n * considering existing assignments, the time window, same-room gaps,\n * and prerequisite constraints.\n */\nfunction findEarliestSlot(\n  roomId: string,\n  duration: number,\n  windowStart: number,\n  windowEnd: number,\n  gap: number,\n  assignments: Assignment[],\n  earliestStart: number // from prerequisite constraints\n): { start: number; end: number } | null {\n  // Get all assignments for this room, sorted by start time\n  const roomAssignments = assignments\n    .filter((a) => a.roomId === roomId)\n    .sort((a, b) => a.startTime - b.startTime);\n\n  const effectiveEarliest = Math.max(windowStart, earliestStart);\n\n  if (roomAssignments.length === 0) {\n    // No events in this room yet — place at the earliest possible time\n    if (effectiveEarliest + duration <= windowEnd) {\n      return { start: effectiveEarliest, end: effectiveEarliest + duration };\n    }\n    return null;\n  }\n\n  // Check before the first event\n  const beforeFirstEnd = roomAssignments[0].startTime - gap;\n  if (effectiveEarliest + duration <= beforeFirstEnd) {\n    return { start: effectiveEarliest, end: effectiveEarliest + duration };\n  }\n\n  // Check between events\n  for (let i = 0; i < roomAssignments.length - 1; i++) {\n    const gapStart = roomAssignments[i].endTime + gap;\n    const gapEnd = roomAssignments[i + 1].startTime - gap;\n    const candidateStart = Math.max(gapStart, effectiveEarliest);\n    if (candidateStart + duration <= gapEnd) {\n      return { start: candidateStart, end: candidateStart + duration };\n    }\n  }\n\n  // Check after the last event\n  const afterLastStart = Math.max(\n    roomAssignments[roomAssignments.length - 1].endTime + gap,\n    effectiveEarliest\n  );\n  if (afterLastStart + duration <= windowEnd) {\n    return { start: afterLastStart, end: afterLastStart + duration };\n  }\n\n  return null;\n}\n\n/**\n * Compute a flexibility score for an event (lower = more constrained).\n * Used to determine scheduling priority.\n */\nfunction computeFlexibilityScore(\n  event: Event,\n  rooms: Room[],\n  eventMap: Map<string, Event>,\n  scheduled: Set<string>\n): number {\n  const attendees = event.attendees ?? 1;\n\n  // Count rooms that fit this event's capacity\n  let fittingRooms = 0;\n  for (const room of rooms) {\n    if (room.capacity >= attendees) {\n      fittingRooms++;\n    }\n  }\n\n  // Factors that make an event more constrained (lower score):\n  // - Fewer rooms that fit capacity → more constrained\n  // - Longer duration → harder to place\n  // - Preferred room (might be shared) → slightly constrained\n  // - More dependents → important to schedule early\n\n  const roomFitFactor = fittingRooms; // smaller = more constrained\n  const durationFactor = -event.duration; // longer = more constrained\n  const preferredPenalty = event.preferredRoom ? 1 : 0; // slightly more constrained if preferred\n\n  // Combination: lower score = more constrained\n  // We want roomFitFactor and durationFactor to dominate\n  return roomFitFactor * 100 + durationFactor * 2 + preferredPenalty;\n}\n\n/**\n * Schedule events to maximize the number of successfully placed events.\n */\nfunction trySchedule(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions,\n  topologicalOrder: string[]\n): ScheduleResult {\n  const gap = options.gap ?? 15;\n  const eventMap = new Map<string, Event>();\n  for (const event of events) {\n    eventMap.set(event.id, event);\n  }\n\n  // Group events by DAG level for level-by-level processing\n  const levels = computeLevels(events);\n  const eventsByLevel = new Map<number, string[]>();\n  for (const eventId of topologicalOrder) {\n    const level = levels.get(eventId) ?? 0;\n    if (!eventsByLevel.has(level)) {\n      eventsByLevel.set(level, []);\n    }\n    eventsByLevel.get(level)!.push(eventId);\n  }\n\n  const sortedLevels = [...eventsByLevel.keys()].sort((a, b) => a - b);\n\n  const assignments: Assignment[] = [];\n  const unscheduled: string[] = [];\n  const scheduled = new Set<string>();\n\n  for (const level of sortedLevels) {\n    const levelEvents = eventsByLevel.get(level)!;\n\n    // Sort events within this level by constrainedness (most constrained first)\n    // This ensures flexible events don't take slots that constrained events need\n    const scoredEvents = levelEvents\n      .map((id) => ({\n        id,\n        event: eventMap.get(id)!,\n        score: computeFlexibilityScore(eventMap.get(id)!, rooms, eventMap, scheduled),\n      }))\n      .sort((a, b) => a.score - b.score || a.id.localeCompare(b.id));\n\n    for (const { id: eventId, event } of scoredEvents) {\n      const attendees = event.attendees ?? 1;\n\n      // Compute the earliest start time based on prerequisite constraints\n      let prerequisiteEndTime = options.startTime - gap;\n      let allPrereqsScheduled = true;\n\n      for (const prereqId of event.prerequisites ?? []) {\n        if (!scheduled.has(prereqId)) {\n          // Prerequisite was not scheduled → this event can't be scheduled\n          allPrereqsScheduled = false;\n          break;\n        }\n        const prereqAssignment = assignments.find((a) => a.eventId === prereqId);\n        if (prereqAssignment) {\n          prerequisiteEndTime = Math.max(prerequisiteEndTime, prereqAssignment.endTime);\n        }\n      }\n\n      if (!allPrereqsScheduled) {\n        unscheduled.push(eventId);\n        continue;\n      }\n\n      // Find suitable rooms (meet capacity requirements)\n      const validRooms = rooms.filter((r) => r.capacity >= attendees);\n\n      if (validRooms.length === 0) {\n        unscheduled.push(eventId);\n        continue;\n      }\n\n      // Order rooms: preferred first, then by capacity ascending (closest fit)\n      const orderedRooms = [...validRooms].sort((a, b) => {\n        if (event.preferredRoom) {\n          if (a.id === event.preferredRoom && b.id === event.preferredRoom) {\n            return a.capacity - b.capacity;\n          }\n          if (a.id === event.preferredRoom) return -1;\n          if (b.id === event.preferredRoom) return 1;\n        }\n        return a.capacity - b.capacity;\n      });\n\n      // Try to find the best slot: earliest available, preferring preferred room\n      const earliestAllowedStart = prerequisiteEndTime + gap;\n\n      let bestSlot: { start: number; end: number } | null = null;\n      let bestRoomId: string | null = null;\n      let bestStart = Infinity;\n\n      for (const room of orderedRooms) {\n        const slot = findEarliestSlot(\n          room.id,\n          event.duration,\n          options.startTime,\n          options.endTime,\n          gap,\n          assignments,\n          earliestAllowedStart\n        );\n\n        if (slot) {\n          // Prefer earlier start times, with tiebreaker being room preference\n          if (slot.start < bestStart) {\n            bestStart = slot.start;\n            bestSlot = slot;\n            bestRoomId = room.id;\n          }\n        }\n      }\n\n      if (bestSlot && bestRoomId) {\n        assignments.push({\n          eventId: event.id,\n          roomId: bestRoomId,\n          startTime: bestSlot.start,\n          endTime: bestSlot.end,\n        });\n        scheduled.add(event.id);\n      } else {\n        unscheduled.push(eventId);\n      }\n    }\n  }\n\n  return { assignments, unscheduled };\n}\n\n/**\n * Main schedule function.\n *\n * Assigns events to rooms within a time window, respecting:\n * - Room capacity limits\n * - Prerequisite ordering (with gaps)\n * - Room gaps between consecutive events\n * - Room preferences (soft constraint)\n *\n * Throws an error if the prerequisite graph contains a cycle.\n * Returns unscheduled events when conflicts prevent scheduling.\n */\nexport function schedule(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions\n): ScheduleResult {\n  if (events.length === 0) {\n    return { assignments: [], unscheduled: [] };\n  }\n\n  if (rooms.length === 0) {\n    return { assignments: [], unscheduled: events.map((e) => e.id) };\n  }\n\n  // Step 1: Detect cycles (throws on cycle)\n  detectCycles(events);\n\n  // Step 2: Topological sort\n  const order = topologicalSort(events);\n\n  // Step 3: Schedule with optimization\n  const result = trySchedule(events, rooms, options, order);\n\n  return result;\n}\n","structuredPatch":[{"oldStart":214,"oldLines":8,"newStart":214,"newLines":8,"lines":[" function computeFlexibilityScore(","   event: Event,","   rooms: Room[],","-  eventMap: Map<string, Event>,","-  scheduled: Set<string>","+  _eventMap: Map<string, Event>,","+  _scheduled: Set<string>"," ): number {","   const attendees = event.attendees ?? 1;"," "]}],"userModified":false,"replaceAll":false}}
