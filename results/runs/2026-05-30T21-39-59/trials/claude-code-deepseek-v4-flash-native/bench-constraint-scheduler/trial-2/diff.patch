+        if (slot) {
+          // Prefer earlier start times, with tiebreaker being room preference
+          if (slot.start < bestStart) {
+            bestStart = slot.start;
+            bestSlot = slot;
+            bestRoomId = room.id;
+          }
+        }
+      }
+
+      if (bestSlot && bestRoomId) {
+        assignments.push({
+          eventId: event.id,
+          roomId: bestRoomId,
+          startTime: bestSlot.start,
+          endTime: bestSlot.end,
+        });
+        scheduled.add(event.id);
+      } else {
+        unscheduled.push(eventId);
+      }
+    }
+  }
+
+  return { assignments, unscheduled };
+}
+
+/**
+ * Main schedule function.
+ *
+ * Assigns events to rooms within a time window, respecting:
+ * - Room capacity limits
+ * - Prerequisite ordering (with gaps)
+ * - Room gaps between consecutive events
+ * - Room preferences (soft constraint)
+ *
+ * Throws an error if the prerequisite graph contains a cycle.
+ * Returns unscheduled events when conflicts prevent scheduling.
+ */
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions
+): ScheduleResult {
+  if (events.length === 0) {
+    return { assignments: [], unscheduled: [] };
+  }
+
+  if (rooms.length === 0) {
+    return { assignments: [], unscheduled: events.map((e) => e.id) };
+  }
+
+  // Step 1: Detect cycles (throws on cycle)
+  detectCycles(events);
+
+  // Step 2: Topological sort
+  const order = topologicalSort(events);
+
+  // Step 3: Schedule with optimization
+  const result = trySchedule(events, rooms, options, order);
+
+  return result;
+}
