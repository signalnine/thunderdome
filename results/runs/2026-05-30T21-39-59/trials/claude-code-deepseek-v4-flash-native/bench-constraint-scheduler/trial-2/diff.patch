+import type { Event, Room, ScheduleOptions, Assignment, ScheduleResult } from './types.js';
+
+/**
+ * Detect cycles in the prerequisite graph using DFS with recursion stack.
+ * Throws an error if a cycle (including self-references) is found.
+ */
+function detectCycles(events: Event[]): void {
+  const graph = new Map<string, string[]>();
+  const eventIds = new Set(events.map((e) => e.id));
+  for (const event of events) {
+    graph.set(event.id, event.prerequisites ?? []);
+  }
+
+  // Map event IDs to names for better error messages
+  const names = new Map<string, string>();
+  for (const event of events) {
+    names.set(event.id, event.name);
+  }
+
+  const WHITE = 0; // unvisited
+  const GRAY = 1; // in current DFS path
+  const BLACK = 2; // fully explored
+  const color = new Map<string, number>();
+
+  for (const event of events) {
+    color.set(event.id, WHITE);
+  }
+
+  function dfs(id: string): void {
+    color.set(id, GRAY);
+
+    const prereqs = graph.get(id) ?? [];
+    for (const prereq of prereqs) {
+      if (!eventIds.has(prereq)) {
+        // Prerequisite references a non-existent event
+        throw new Error(
+          `Prerequisite error: event "${names.get(id) ?? id}" references unknown event "${prereq}"`
+        );
+      }
+      if (color.get(prereq) === GRAY) {
+        throw new Error(
+          `Prerequisite cycle detected involving event: "${names.get(id) ?? id}"`
+        );
+      }
+      if (color.get(prereq) === WHITE) {
+        dfs(prereq);
+      }
+    }
+
+    color.set(id, BLACK);
+  }
+
+  for (const event of events) {
+    if (color.get(event.id) === WHITE) {
+      dfs(event.id);
+    }
+  }
+}
+
+/**
+ * Topological sort using Kahn's algorithm.
+ * Returns event IDs in dependency order (prerequisites before dependents).
+ */
+function topologicalSort(events: Event[]): string[] {
+  const graph = new Map<string, string[]>();
+  const inDegree = new Map<string, number>();
+
+  for (const event of events) {
+    graph.set(event.id, []);
+    inDegree.set(event.id, 0);
+  }
+
+  for (const event of events) {
+    for (const prereq of event.prerequisites ?? []) {
+      graph.get(prereq)?.push(event.id);
+      inDegree.set(event.id, (inDegree.get(event.id) ?? 0) + 1);
+    }
+  }
+
+  const queue: string[] = [];
+  for (const [id, degree] of inDegree) {
+    if (degree === 0) {
+      queue.push(id);
+    }
+  }
+
+  const result: string[] = [];
+  const sortedSet = new Set<string>();
+
+  while (queue.length > 0) {
+    // Process nodes with same in-degree together, but sort by constrainedness
+    // within the same "batch" — this is handled later during scheduling.
+    const id = queue.shift()!;
+    result.push(id);
+    sortedSet.add(id);
+
+    for (const neighbor of graph.get(id) ?? []) {
+      const newDegree = (inDegree.get(neighbor) ?? 1) - 1;
+      inDegree.set(neighbor, newDegree);
+      if (newDegree === 0) {
+        queue.push(neighbor);
+      }
+    }
+  }
+
+  if (result.length !== events.length) {
+    throw new Error('Prerequisite cycle detected in graph');
+  }
+
+  return result;
+}
+
+/**
+ * Compute DAG levels for each event (0 = no prerequisites, 1 = depends on level 0, etc.)
+ */
+function computeLevels(events: Event[]): Map<string, number> {
+  const eventMap = new Map<string, Event>();
+  for (const event of events) {
+    eventMap.set(event.id, event);
+  }
+
+  const levels = new Map<string, number>();
+  const computed = new Set<string>();
+
+  function getLevel(id: string): number {
+    if (computed.has(id)) {
+      return levels.get(id) ?? 0;
+    }
+    const event = eventMap.get(id);
+    if (!event || !event.prerequisites || event.prerequisites.length === 0) {
+      levels.set(id, 0);
+      computed.add(id);
+      return 0;
+    }
+    let maxPrereqLevel = 0;
+    for (const prereqId of event.prerequisites) {
+      maxPrereqLevel = Math.max(maxPrereqLevel, getLevel(prereqId));
+    }
+    const level = maxPrereqLevel + 1;
+    levels.set(id, level);
+    computed.add(id);
+    return level;
+  }
+
+  for (const event of events) {
+    getLevel(event.id);
+  }
+
+  return levels;
+}
+
+/**
+ * Room-time slot finder.
+ * Finds the earliest available time slot for an event in a given room,
+ * considering existing assignments, the time window, same-room gaps,
+ * and prerequisite constraints.
+ */
+function findEarliestSlot(
+  roomId: string,
+  duration: number,
+  windowStart: number,
+  windowEnd: number,
+  gap: number,
+  assignments: Assignment[],
+  earliestStart: number // from prerequisite constraints
+): { start: number; end: number } | null {
+  // Get all assignments for this room, sorted by start time
+  const roomAssignments = assignments
+    .filter((a) => a.roomId === roomId)
+    .sort((a, b) => a.startTime - b.startTime);
+
+  const effectiveEarliest = Math.max(windowStart, earliestStart);
+
+  if (roomAssignments.length === 0) {
+    // No events in this room yet — place at the earliest possible time
+    if (effectiveEarliest + duration <= windowEnd) {
+      return { start: effectiveEarliest, end: effectiveEarliest + duration };
+    }
+    return null;
+  }
+
+  // Check before the first event
+  const beforeFirstEnd = roomAssignments[0].startTime - gap;
+  if (effectiveEarliest + duration <= beforeFirstEnd) {
+    return { start: effectiveEarliest, end: effectiveEarliest + duration };
+  }
+
+  // Check between events
+  for (let i = 0; i < roomAssignments.length - 1; i++) {
+    const gapStart = roomAssignments[i].endTime + gap;
+    const gapEnd = roomAssignments[i + 1].startTime - gap;
+    const candidateStart = Math.max(gapStart, effectiveEarliest);
+    if (candidateStart + duration <= gapEnd) {
+      return { start: candidateStart, end: candidateStart + duration };
+    }
+  }
+
+  // Check after the last event
+  const afterLastStart = Math.max(
+    roomAssignments[roomAssignments.length - 1].endTime + gap,
+    effectiveEarliest
+  );
+  if (afterLastStart + duration <= windowEnd) {
+    return { start: afterLastStart, end: afterLastStart + duration };
+  }
+
+  return null;
+}
+
+/**
+ * Compute a flexibility score for an event (lower = more constrained).
+ * Used to determine scheduling priority.
+ */
+function computeFlexibilityScore(
+  event: Event,
+  rooms: Room[],
+  _eventMap: Map<string, Event>,
+  _scheduled: Set<string>
+): number {
+  const attendees = event.attendees ?? 1;
+
+  // Count rooms that fit this event's capacity
+  let fittingRooms = 0;
+  for (const room of rooms) {
+    if (room.capacity >= attendees) {
+      fittingRooms++;
+    }
+  }
+
+  // Factors that make an event more constrained (lower score):
+  // - Fewer rooms that fit capacity → more constrained
+  // - Longer duration → harder to place
+  // - Preferred room (might be shared) → slightly constrained
+  // - More dependents → important to schedule early
+
+  const roomFitFactor = fittingRooms; // smaller = more constrained
+  const durationFactor = -event.duration; // longer = more constrained
+  const preferredPenalty = event.preferredRoom ? 1 : 0; // slightly more constrained if preferred
+
+  // Combination: lower score = more constrained
+  // We want roomFitFactor and durationFactor to dominate
+  return roomFitFactor * 100 + durationFactor * 2 + preferredPenalty;
+}
+
+/**
+ * Schedule events to maximize the number of successfully placed events.
+ */
+function trySchedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  topologicalOrder: string[]
+): ScheduleResult {
+  const gap = options.gap ?? 15;
