uration: 30 },\n      { id: 'e2', name: 'Event 2', duration: 30 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 660 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n    // e1: 540-570, then 15 gap, e2: 585-615\n    expect(result.assignments.find((a) => a.eventId === 'e1')?.startTime).toBe(540);\n    expect(result.assignments.find((a) => a.eventId === 'e2')?.startTime).toBe(585);\n  });\n\n  it('should use custom gap when specified', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Event 1', duration: 30 },\n      { id: 'e2', name: 'Event 2', duration: 30 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 30 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n    // e1: 540-570, then 30 gap, e2: 600-630\n    expect(result.assignments.find((a) => a.eventId === 'e2')?.startTime).toBe(600);\n  });\n\n  // ===================================================================\n  // Room capacity\n  // ===================================================================\n\n  it('should not schedule an event in a room with insufficient capacity', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Big Event', duration: 60, attendees: 50 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Small Room', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(0);\n    expect(result.unscheduled).toEqual(['e1']);\n  });\n\n  it('should select a room with sufficient capacity when multiple rooms exist', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Big Event', duration: 60, attendees: 30 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Small Room', capacity: 10 },\n      { id: 'r2', name: 'Medium Room', capacity: 30 },\n      { id: 'r3', name: 'Large Room', capacity: 100 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(1);\n    // Should be placed in either r2 or r3\n    expect(['r2', 'r3']).toContain(result.assignments[0].roomId);\n  });\n\n  // ===================================================================\n  // Time window\n  // ===================================================================\n\n  it('should not schedule events that exceed the time window', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Long Event', duration: 120, attendees: 5 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    // Only 30 minute window\n    const options: ScheduleOptions = { startTime: 540, endTime: 570 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(0);\n    expect(result.unscheduled).toEqual(['e1']);\n  });\n\n  it('should schedule events exactly at the window boundaries', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Morning', duration: 60, attendees: 5 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 600 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0].startTime).toBe(540);\n    expect(result.assignments[0].endTime).toBe(600);\n  });\n\n  // ===================================================================\n  // Room gaps\n  // ===================================================================\n\n  it('should enforce gaps between events in the same room', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Event 1', duration: 30 },\n      { id: 'e2', name: 'Event 2', duration: 30 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 30 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n    const e1 = result.assignments.find((a) => a.eventId === 'e1')!;\n    const e2 = result.assignments.find((a) => a.eventId === 'e2')!;\n    // e2 should start at least 30 min after e1 ends\n    expect(e2.startTime - e1.endTime).toBeGreaterThanOrEqual(30);\n  });\n\n  it('should allow back-to-back events when gap is 0', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Event 1', duration: 30 },\n      { id: 'e2', name: 'Event 2', duration: 30 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 600, gap: 0 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n    // e1: 540-570, e2: 570-600\n    expect(result.assignments.find((a) => a.eventId === 'e2')?.startTime).toBe(570);\n  });\n\n  // ===================================================================\n  // Prerequisites\n  // ===================================================================\n\n  it('should respect prerequisite ordering', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Setup', duration: 30 },\n      { id: 'e2', name: 'Main Event', duration: 60, prerequisites: ['e1'] },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 15 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n    const e1 = result.assignments.find((a) => a.eventId === 'e1')!;\n    const e2 = result.assignments.find((a) => a.eventId === 'e2')!;\n\n    // e1 must finish before e2 starts\n    expect(e1.endTime + 15).toBeLessThanOrEqual(e2.startTime);\n  });\n\n  it('should enforce gap between prerequisite and dependent events', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Setup', duration: 30 },\n      { id: 'e2', name: 'Main Event', duration: 30, prerequisites: ['e1'] },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 30 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n    const e1 = result.assignments.find((a) => a.eventId === 'e1')!;\n    const e2 = result.assignments.find((a) => a.eventId === 'e2')!;\n    // e1 ends at 570, gap 30 means e2 can start at 600\n    expect(e1.endTime + 30).toBeLessThanOrEqual(e2.startTime);\n  });\n\n  it('should handle multi-level prerequisites', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 30 },\n      { id: 'e2', name: 'B', duration: 30, prerequisites: ['e1'] },\n      { id: 'e3', name: 'C', duration: 30, prerequisites: ['e2'] },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 720, gap: 15 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(3);\n    const e1 = result.assignments.find((a) => a.eventId === 'e1')!;\n    const e2 = result.assignments.find((a) => a.eventId === 'e2')!;\n    const e3 = result.assignments.find((a) => a.eventId === 'e3')!;\n\n    expect(e1.endTime + 15).toBeLessThanOrEqual(e2.startTime);\n    expect(e2.endTime + 15).toBeLessThanOrEqual(e3.startTime);\n  });\n\n  it('should handle multiple prerequisites', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Part 1', duration: 30 },\n      { id: 'e2', name: 'Part 2', duration: 30 },\n      { id: 'e3', name: 'Final', duration: 30, prerequisites: ['e1', 'e2'] },\n    ];\n    const room: Room = { id: 'r1', name: 'Room A', capacity: 10 };\n    const options: ScheduleOptions = { startTime: 540, endTime: 780, gap: 15 };\n\n    const result = schedule([...events], [room], options);\n    expect(result.assignments).toHaveLength(3);\n    const e3 = result.assignments.find((a) => a.eventId === 'e3')!;\n    const e1End = result.assignments.find((a) => a.eventId === 'e1')!.endTime;\n    const e2End = result.assignments.find((a) => a.eventId === 'e2')!.endTime;\n    // e3 should start after max(e1.endTime, e2.endTime) + gap\n    expect(e3.startTime).toBeGreaterThanOrEqual(Math.max(e1End, e2End) + 15);\n  });\n\n  it('should mark dependent events as unscheduled when prerequisites are unscheduled', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Setup', duration: 120, attendees: 100 },\n      { id: 'e2', name: 'Main', duration: 30, prerequisites: ['e1'] },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Small Room', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 600 };\n\n    const result = schedule(events, rooms, options);\n    // e1 can't fit (capacity), so e2 can't either\n    expect(result.unscheduled).toContain('e1');\n    expect(result.unscheduled).toContain('e2');\n  });\n\n  // ===================================================================\n  // Cycle detection\n  // ===================================================================\n\n  it('should throw on self-referencing prerequisite', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Self Loop', duration: 30, prerequisites: ['e1'] },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 600 };\n\n    expect(() => schedule(events, rooms, options)).toThrow(/cycle/i);\n  });\n\n  it('should throw on direct cycle between two events', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 30, prerequisites: ['e2'] },\n      { id: 'e2', name: 'B', duration: 30, prerequisites: ['e1'] },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 600 };\n\n    expect(() => schedule(events, rooms, options)).toThrow(/cycle/i);\n  });\n\n  it('should throw on longer cycle', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 30, prerequisites: ['e2'] },\n      { id: 'e2', name: 'B', duration: 30, prerequisites: ['e3'] },\n      { id: 'e3', name: 'C', duration: 30, prerequisites: ['e1'] },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 600 };\n\n    expect(() => schedule(events, rooms, options)).toThrow(/cycle/i);\n  });\n\n  it('should throw when prerequisite references non-existent event', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 30, prerequisites: ['nonexistent'] },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 600 };\n\n    expect(() => schedule(events, rooms, options)).toThrow(/unknown/i);\n  });\n\n  // ===================================================================\n  // Preferred room\n  // ===================================================================\n\n  it('should honor preferred room when possible', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Workshop', duration: 60, attendees: 5, preferredRoom: 'r2' },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n      { id: 'r2', name: 'Room B', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0].roomId).toBe('r2');\n  });\n\n  it('should use another room when preferred room has insufficient capacity', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Big Workshop', duration: 60, attendees: 20, preferredRoom: 'r1' },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Small Room', capacity: 5 },\n      { id: 'r2', name: 'Large Room', capacity: 30 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0].roomId).toBe('r2');\n  });\n\n  it('should use another room when preferred room is occupied', () => {\n    const events: Event[] = [\n      {\n        id: 'e1', name: 'First', duration: 60, attendees: 5, preferredRoom: 'r1',\n      },\n      {\n        id: 'e2', name: 'Second', duration: 60, attendees: 5, preferredRoom: 'r1',\n      },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n      { id: 'r2', name: 'Room B', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 720, gap: 15 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n    // At least one event should be in r2 since r1 is occupied\n    expect(result.assignments.some((a) => a.roomId === 'r2')).toBe(true);\n  });\n\n  // ===================================================================\n  // Empty / edge cases\n  // ===================================================================\n\n  it('should return empty result for empty events list', () => {\n    const result = schedule([], [{ id: 'r1', name: 'Room A', capacity: 10 }], {\n      startTime: 540,\n      endTime: 1020,\n    });\n    expect(result.assignments).toHaveLength(0);\n    expect(result.unscheduled).toHaveLength(0);\n  });\n\n  it('should mark all events unscheduled when no rooms exist', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Workshop', duration: 60 },\n    ];\n    const result = schedule(events, [], { startTime: 540, endTime: 1020 });\n    expect(result.assignments).toHaveLength(0);\n    expect(result.unscheduled).toEqual(['e1']);\n  });\n\n  // ===================================================================\n  // Cross-room scheduling (no gap requirements between different rooms)\n  // ===================================================================\n\n  it('should allow concurrent events in different rooms', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Event 1', duration: 60 },\n      { id: 'e2', name: 'Event 2', duration: 60 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n      { id: 'r2', name: 'Room B', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 15 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n    // Both should start at 540 (concurrent in different rooms)\n    expect(result.assignments.every((a) => a.startTime === 540)).toBe(true);\n  });\n\n  // ===================================================================\n  // Batch optimization - filling gaps\n  // ===================================================================\n\n  it('should fit events into gaps between other events', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Long', duration: 90 },\n      { id: 'e2', name: 'Short', duration: 30 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    // Window: 540-660 (120 min), gap 15\n    // e1 at 540-630, e2: must fit before e1 or after\n    // before e1: 540-570 (30 min) won't work since e1 starts at 540\n    // after e1: 630+15=645, 645+30=675 > 660 → no\n    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 15 };\n\n    const result = schedule(events, rooms, options);\n    // Only 1 can fit (90+15+30=135 > 120 window)\n    expect(result.assignments).toHaveLength(1);\n    expect(result.unscheduled).toHaveLength(1);\n  });\n\n  it('should schedule events in parallel across multiple rooms when constrained', () => {\n    // Two 60-min events, two rooms, 60-min window → both fit\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60 },\n      { id: 'e2', name: 'B', duration: 60 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n      { id: 'r2', name: 'Room B', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 600 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n  });\n\n  // ===================================================================\n  // Optimization: constrained events get priority\n  // ===================================================================\n\n  it('should prioritize scheduling constrained events over flexible ones', () => {\n    // Event A can only fit in one room (capacity 20)\n    // Event B can fit in both rooms (capacity 5)\n    // Both need the same room at the same time\n    // The scheduler should still try to fit both if possible\n    const events: Event[] = [\n      { id: 'a', name: 'Big Event', duration: 60, attendees: 15 },\n      { id: 'b', name: 'Small Event', duration: 60, attendees: 3 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Large Room', capacity: 20 },\n      { id: 'r2', name: 'Small Room', capacity: 5 },\n    ];\n    // Only enough time for one 60-min event per room (with gap considered)\n    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 15 };\n\n    const result = schedule(events, rooms, options);\n    // Both should fit: A in r1 (capacity 20), B in r2 (capacity 5)\n    expect(result.assignments).toHaveLength(2);\n  });\n\n  // ===================================================================\n  // Complex scenarios\n  // ===================================================================\n\n  it('should handle a full day of events with prerequisites', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Breakfast', duration: 30 },\n      { id: 'e2', name: 'Prep', duration: 45 },\n      { id: 'e3', name: 'Morning Session', duration: 90, prerequisites: ['e1', 'e2'] },\n      { id: 'e4', name: 'Lunch', duration: 60 },\n      { id: 'e5', name: 'Afternoon Session', duration: 120, prerequisites: ['e3'] },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Main Hall', capacity: 100 },\n      { id: 'r2', name: 'Workshop Room', capacity: 30 },\n    ];\n    const options: ScheduleOptions = {\n      startTime: 540, // 9:00 AM\n      endTime: 1020, // 5:00 PM\n      gap: 15,\n    };\n\n    const result = schedule(events, rooms, options);\n    // All events should be scheduled\n    expect(result.unscheduled).toHaveLength(0);\n    expect(result.assignments).toHaveLength(5);\n\n    // Verify prerequisite chain\n    const e1 = result.assignments.find((a) => a.eventId === 'e1')!;\n    const e2 = result.assignments.find((a) => a.eventId === 'e2')!;\n    const e3 = result.assignments.find((a) => a.eventId === 'e3')!;\n    const e5 = result.assignments.find((a) => a.eventId === 'e5')!;\n\n    expect(e3.startTime).toBeGreaterThanOrEqual(Math.max(e1.endTime, e2.endTime) + 15);\n    expect(e5.startTime).toBeGreaterThanOrEqual(e3.endTime + 15);\n  });\n\n  it('should return unscheduled events that cannot fit', () => {\n    // More events than slots available\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 120 },\n      { id: 'e2', name: 'B', duration: 120 },\n      { id: 'e3', name: 'C', duration: 120 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    // 120 min window, each event is 120 min, with gap 15\n    // Only one event can fit\n    const options: ScheduleOptions = { startTime: 540, endTime: 660, gap: 15 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.unscheduled).toHaveLength(2);\n  });\n\n  it('should handle events with zero duration', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Brief', duration: 0 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0].startTime).toBe(540);\n    expect(result.assignments[0].endTime).toBe(540);\n  });\n\n  it('should handle events with no attendees specified (defaults to 1)', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Workshop', duration: 60 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 1 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020 };\n\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(1);\n  });\n\n  it('should schedule an event that fits exactly in the gap between two others', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'First', duration: 30 },\n      { id: 'e2', name: 'Second', duration: 30 },\n      { id: 'e3', name: 'Middle', duration: 30 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 720, gap: 15 };\n    // Without e3: e1 at 540-570, e2 at 570+15=585 to 615\n    // With e3 between them: no room, since 570+15=585 and 585+30=61