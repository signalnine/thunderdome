+  const scheduled = new Set<string>();
+
+  for (const level of sortedLevels) {
+    const levelEvents = eventsByLevel.get(level)!;
+
+    // Sort events within this level by constrainedness (most constrained first)
+    // This ensures flexible events don't take slots that constrained events need
+    const scoredEvents = levelEvents
+      .map((id) => ({
+        id,
+        event: eventMap.get(id)!,
+        score: computeFlexibilityScore(eventMap.get(id)!, rooms, eventMap, scheduled),
+      }))
+      .sort((a, b) => a.score - b.score || a.id.localeCompare(b.id));
+
+    for (const { id: eventId, event } of scoredEvents) {
+      const attendees = event.attendees ?? 1;
