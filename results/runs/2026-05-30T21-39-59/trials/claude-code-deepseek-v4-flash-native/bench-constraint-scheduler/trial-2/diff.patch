rt using Kahn's algorithm.\n * Returns event IDs in dependency order (prerequisites before dependents).\n */\nfunction topologicalSort(events: Event[]): string[] {\n  const graph = new Map<string, string[]>();\n  const inDegree = new Map<string, number>();\n\n  for (const event of events) {\n    graph.set(event.id, []);\n    inDegree.set(event.id, 0);\n  }\n\n  for (const event of events) {\n    for (const prereq of event.prerequisites ?? []) {\n      graph.get(prereq)?.push(event.id);\n      inDegree.set(event.id, (inDegree.get(event.id) ?? 0) + 1);\n    }\n  }\n\n  const queue: string[] = [];\n  for (const [id, degree] of inDegree) {\n    if (degree === 0) {\n      queue.push(id);\n    }\n  }\n\n  const result: string[] = [];\n  const sortedSet = new Set<string>();\n\n  while (queue.length > 0) {\n    // Process nodes with same in-degree together, but sort by constrainedness\n    // within the same \"batch\" — this is handled later during scheduling.\n    const id = queue.shift()!;\n    result.push(id);\n    sortedSet.add(id);\n\n    for (const neighbor of graph.get(id) ?? []) {\n      const newDegree = (inDegree.get(neighbor) ?? 1) - 1;\n      inDegree.set(neighbor, newDegree);\n      if (newDegree === 0) {\n        queue.push(neighbor);\n      }\n    }\n  }\n\n  if (result.length !== events.length) {\n    throw new Error('Prerequisite cycle detected in graph');\n  }\n\n  return result;\n}\n\n/**\n * Compute DAG levels for each event (0 = no prerequisites, 1 = depends on level 0, etc.)\n */\nfunction computeLevels(events: Event[]): Map<string, number> {\n  const eventMap = new Map<string, Event>();\n  for (const event of events) {\n    eventMap.set(event.id, event);\n  }\n\n  const levels = new Map<string, number>();\n  const computed = new Set<string>();\n\n  function getLevel(id: string): number {\n    if (computed.has(id)) {\n      return levels.get(id) ?? 0;\n    }\n    const event = eventMap.get(id);\n    if (!event || !event.prerequisites || event.prerequisites.length === 0) {\n      levels.set(id, 0);\n      computed.add(id);\n      return 0;\n    }\n    let maxPrereqLevel = 0;\n    for (const prereqId of event.prerequisites) {\n      maxPrereqLevel = Math.max(maxPrereqLevel, getLevel(prereqId));\n    }\n    const level = maxPrereqLevel + 1;\n    levels.set(id, level);\n    computed.add(id);\n    return level;\n  }\n\n  for (const event of events) {\n    getLevel(event.id);\n  }\n\n  return levels;\n}\n\n/**\n * Room-time slot finder.\n * Finds the earliest available time slot for an event in a given room,\n * considering existing assignments, the time window, same-room gaps,\n * and prerequisite constraints.\n */\nfunction findEarliestSlot(\n  roomId: string,\n  duration: number,\n  windowStart: number,\n  windowEnd: number,\n  gap: number,\n  assignments: Assignment[],\n  earliestStart: number // from prerequisite constraints\n): { start: number; end: number } | null {\n  // Get all assignments for this room, sorted by start time\n  const roomAssignments = assignments\n    .filter((a) => a.roomId === roomId)\n    .sort((a, b) => a.startTime - b.startTime);\n\n  const effectiveEarliest = Math.max(windowStart, earliestStart);\n\n  if (roomAssignments.length === 0) {\n    // No events in this room yet — place at the earliest possible time\n    if (effectiveEarliest + duration <= windowEnd) {\n      return { start: effectiveEarliest, end: effectiveEarliest + duration };\n    }\n    return null;\n  }\n\n  // Check before the first event\n  const beforeFirstEnd = roomAssignments[0].startTime - gap;\n  if (effectiveEarliest + duration <= beforeFirstEnd) {\n    return { start: effectiveEarliest, end: effectiveEarliest + duration };\n  }\n\n  // Check between events\n  for (let i = 0; i < roomAssignments.length - 1; i++) {\n    const gapStart = roomAssignments[i].endTime + gap;\n    const gapEnd = roomAssignments[i + 1].startTime - gap;\n    const candidateStart = Math.max(gapStart, effectiveEarliest);\n    if (candidateSta