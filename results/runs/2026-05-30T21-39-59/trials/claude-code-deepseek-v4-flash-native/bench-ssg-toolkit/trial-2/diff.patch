+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,34 @@
+import { ContentFile, Plugin, BuildContext } from '../core/types.js';
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, ctx: BuildContext): ContentFile {
+        let content = file.content;
+        const assetRegex = /(src|href)="\.\/([^"]+)"/g;
+
+        // Get or create the asset manifest in shared data
+        const manifestKey = 'asset-manifest';
+        let manifest = ctx.data.get(manifestKey) as { assets: string[] } | undefined;
+        if (!manifest) {
+          manifest = { assets: [] };
+          ctx.data.set(manifestKey, manifest);
+        }
+
+        content = content.replace(assetRegex, (_match: string, attr: string, assetPath: string) => {
+          // Extract filename for the manifest
+          const filename = assetPath.split('/').pop()!;
+          if (!manifest!.assets.includes(filename)) {
+            manifest!.assets.push(filename);
+          }
+          return `${attr}="/assets/${assetPath}"`;
+        });
+
+        return { ...file, content };
+      },
+    },
+  };
+}
