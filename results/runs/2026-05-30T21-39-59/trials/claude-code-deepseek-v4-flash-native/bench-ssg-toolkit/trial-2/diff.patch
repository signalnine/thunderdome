@@ -0,0 +1,61 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin, BuildContext } from '../core/types.js';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      async transformContent(file: ContentFile, _ctx: BuildContext): Promise<ContentFile> {
+        let content = file.content;
+
+        // Handle admonition containers: :::note, :::warning, :::tip
+        content = content.replace(/:::(\w+)\n([\s\S]*?)\n:::/g, (_match: string, type: string, text: string) => {
+          return `<div class="admonition admonition-${type}">\n\n${text.trim()}\n\n</div>`;
+        });
+
+        // Extract footnote definitions ([^1]: text)
+        const footnotes: Array<{ id: string; text: string }> = [];
+        content = content.replace(/\[\^(\d+)\]:\s*([^\n]*)/g, (_match: string, id: string, text: string) => {
+          footnotes.push({ id, text: text.trim() });
+          return '';
+        });
+
+        // Replace footnote references with placeholders
+        const footnoteRefs: Array<{ id: string; num: number }> = [];
+        content = content.replace(/\[\^(\d+)\]/g, (_match: string, id: string) => {
+          const fn = footnotes.find(f => f.id === id);
+          if (fn) {
+            const num = footnotes.indexOf(fn) + 1;
+            footnoteRefs.push({ id, num });
+            return `__FN_REF_${id}__`;
+          }
+          return _match;
+        });
+
+        // Convert markdown to HTML
+        const html = await marked.parse(content);
+
+        // Replace footnote reference placeholders with sup tags
+        let result = html;
+        for (const ref of footnoteRefs) {
+          result = result.replace(`__FN_REF_${ref.id}__`, `<sup><a href="#fn-${ref.num}">${ref.num}</a></sup>`);
+        }
+
+        // Append footnotes section at the bottom
+        if (footnotes.length > 0) {
+          const items = footnotes
+            .map((fn, i) => `      <li id="fn-${i + 1}">${fn.text}</li>`)
+            .join('\n');
+          result += `\n<section class="footnotes">\n    <ol>\n${items}\n    </ol>\n  </section>`;
+        }
+
+        return {
+          ...file,
+          content: result,
+        };
+      },
+    },
+  };
+}
