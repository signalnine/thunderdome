+++ b/src/plugins/dev-server.ts
@@ -0,0 +1,57 @@
+import { Plugin, BuildContext } from '../core/types.js';
+
+interface DevServerRoute {
+  path: string;
+  handler: string;
+}
+
+interface DevServerConfig {
+  port: number;
+  routes: DevServerRoute[];
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const { output, data } = ctx;
+
+        const routes: DevServerRoute[] = [];
+
+        // Content routes from output pages
+        for (const [path] of output.entries()) {
+          if (path.endsWith('.html')) {
+            routes.push({ path: `/${path}`, handler: 'static' });
+          }
+        }
+
+        // Asset routes from asset-pipeline data
+        const manifest = data.get('asset-manifest') as { assets: string[] } | undefined;
+        const assetPaths: string[] = manifest?.assets || [];
+
+        for (const asset of assetPaths) {
+          routes.push({ path: `/assets/${asset}`, handler: 'asset' });
+        }
+
+        // Search index path
+        const searchIndexPath = output.has('search-index.json')
+          ? '/search-index.json'
+          : '';
+
+        const config: DevServerConfig = {
+          port: 3000,
+          routes,
+          assetPaths,
+          searchIndexPath,
+        };
+
+        ctx.data.set('dev-server-config', config);
+      },
+    },
+  };
+}
