ription><![CDATA[${file.content}]]></description>${pubDate}\n${categories}\n    </item>`;\n          })\n          .join('\\n');\n\n        const feed = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rss version=\"2.0\">\n  <channel>\n    <title>${escapeXml(config.title)}</title>\n    <link>${config.baseUrl}</link>\n    <description>${escapeXml(config.title)}</description>\n${items}\n  </channel>\n</rss>`;\n\n        ctx.output.set('feed.xml', feed);\n      },\n    },\n  };\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
