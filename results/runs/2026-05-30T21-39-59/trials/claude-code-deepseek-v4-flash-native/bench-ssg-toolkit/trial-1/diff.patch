+import { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, ctx: BuildContext): ContentFile {
+        let content = file.content;
+
+        // Match relative asset URLs: src="./..." or href="./..."
+        const assetRegex = /(?:src|href)="\.\/([^"]+)"/g;
+        const discovered: string[] = [];
+        let match;
+
+        // Collect all discovered assets
+        const regexCopy = new RegExp(assetRegex.source, 'g');
+        while ((match = regexCopy.exec(content)) !== null) {
+          discovered.push(match[1]);
+        }
+
+        // Rewrite relative URLs to /assets/ path
+        content = content.replace(/(src|href)="\.\/([^"]+)"/g, (_orig, attr: string, assetPath: string) => {
+          return `${attr}="/assets/${assetPath}"`;
+        });
+
+        // Accumulate into manifest (only if we found new assets)
+        if (discovered.length > 0) {
+          const existing = ctx.data.get('asset-manifest') as
+            | { assets: string[] }
+            | undefined;
+          if (existing) {
+            existing.assets.push(...discovered);
+          } else {
+            ctx.data.set('asset-manifest', { assets: [...discovered] });
+          }
+        }
+
+        return { ...file, content };
+      },
+    },
+  };
+}
