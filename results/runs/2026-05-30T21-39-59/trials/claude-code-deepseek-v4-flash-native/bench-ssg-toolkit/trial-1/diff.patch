+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,65 @@
+import { Plugin, ContentFile, BuildContext } from '../core/types.js';
+import { marked } from 'marked';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      async transformContent(file: ContentFile, _ctx: BuildContext): Promise<ContentFile> {
+        let content = file.content;
+
+        if (!content || content.trim() === '') {
+          return { ...file, content: content || '' };
+        }
+
+        // 1. Extract footnote definitions: [^N]: text
+        const footnoteDefRegex = /^\[\^(\d+)\]:\s*(.*)$/gm;
+        const footnotes: Array<{ num: string; text: string }> = [];
+        let match;
+        while ((match = footnoteDefRegex.exec(content)) !== null) {
+          footnotes.push({ num: match[1], text: match[2] });
+        }
+
+        // 2. Remove footnote definitions from content
+        content = content.replace(/^\[\^(\d+)\]:\s*(.*)$/gm, '');
+
+        // 3. Replace footnote references in text with superscript links
+        content = content.replace(/\[\^(\d+)\]/g, (orig, num: string) => {
+          // Only replace if we have a matching definition
+          const fn = footnotes.find(f => f.num === num);
+          if (fn) {
+            return `<sup><a href="#fn-${fn.num}">${fn.num}</a></sup>`;
+          }
+          return orig;
+        });
+
+        // 4. Convert admonition containers :::note, :::warning, :::tip
+        content = content.replace(
+          /:::(\w+)\n([\s\S]*?):::/g,
+          (_orig, type: string, inner: string) => {
+            return `<div class="admonition admonition-${type}">\n${inner.trim()}\n</div>`;
+          }
+        );
+
+        // 5. Convert markdown to HTML
+        const html = await marked.parse(content);
+
+        // 6. Append footnotes section if any
+        if (footnotes.length > 0) {
+          const footnoteItems = footnotes
+            .map(fn => `<li id="fn-${fn.num}">${fn.text}</li>`)
+            .join('\n');
+          return {
+            ...file,
+            content:
+              html + `\n<section class="footnotes">\n<ol>\n${footnoteItems}\n</ol>\n</section>`,
+          };
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
