+import { Plugin, BuildContext } from '../core/types.js';
+
+interface DevServerConfig {
+  port: number;
+  routes: Array<{ path: string; handler: string }>;
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const { output, data } = ctx;
+
+        const config: DevServerConfig = {
+          port: 3000,
+          routes: [],
+          assetPaths: [],
+          searchIndexPath: '/search-index.json',
+        };
+
+        // Content routes from output pages
+        for (const key of output.keys()) {
+          if (key !== 'search-index.json') {
+            config.routes.push({ path: `/${key}`, handler: 'static' });
+          }
+        }
+
+        // Asset paths from asset-pipeline manifest
+        const manifest = data.get('asset-manifest') as
+          | { assets: string[] }
+          | undefined;
+        if (manifest) {
+          config.assetPaths = [...manifest.assets];
+          for (const asset of manifest.assets) {
+            config.routes.push({
+              path: `/assets/${asset}`,
+              handler: 'asset',
+            });
+          }
+        }
+
+        // Search index path
+        if (output.has('search-index.json')) {
+          config.searchIndexPath = '/search-index.json';
+        }
+
+        ctx.data.set('dev-server-config', config);
+      },
+    },
+  };
+}
