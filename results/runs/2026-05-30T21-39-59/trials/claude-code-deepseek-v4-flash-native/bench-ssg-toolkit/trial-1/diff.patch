ontent = content.replace(/^\\[\\^(\\d+)\\]:\\s*(.*)$/gm, '');\n\n        // 3. Replace footnote references in text with superscript links\n        content = content.replace(/\\[\\^(\\d+)\\]/g, (orig, num: string) => {\n          // Only replace if we have a matching definition\n          const fn = footnotes.find(f => f.num === num);\n          if (fn) {\n            return `<sup><a href=\"#fn-${fn.num}\">${fn.num}</a></sup>`;\n          }\n          return orig;\n        });\n\n        // 4. Convert admonition containers :::note, :::warning, :::tip\n        content = content.replace(\n          /:::(\\w+)\\n([\\s\\S]*?):::/g,\n          (_orig, type: string, inner: string) => {\n            return `<div class=\"admonition admonition-${type}\">\\n${inner.trim()}\\n</div>`;\n          }\n        );\n\n        // 5. Convert markdown to HTML\n        const html = await marked.parse(content);\n\n        // 6. Append footnotes section if any\n        if (footnotes.length > 0) {\n          const footnoteItems = footnotes\n            .map(fn => `<li id=\"fn-${fn.num}\">${fn.text}</li>`)\n            .join('\\n');\n          return {\n            ...file,\n            content:\n              html + `\\n<section class=\"footnotes\">\\n<ol>\\n${footnoteItems}\\n</ol>\\n</section>`,\n          };\n        }\n\n        return { ...file, content: html };\n      },\n    },\n  };\n}\n","structuredPatch":[{"oldStart":7,"oldLines":7,"newStart":7,"newLines":7,"lines":["     version: '1.0.0',","     dependencies: [],","     hooks: {","-      transformContent(file: ContentFile, _ctx: BuildContext): ContentFile | Promise<ContentFile> {","+      async transformContent(file: ContentFile, _ctx: BuildContext): Promise<ContentFile> {","         let content = file.content;"," ","         if (!content || content.trim() === '') {"]}],"userModified":false,"replaceAll":false}}
