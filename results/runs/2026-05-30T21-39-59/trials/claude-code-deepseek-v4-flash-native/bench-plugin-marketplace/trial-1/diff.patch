+import * as vm from 'node:vm';
+import { SandboxResult, RunnerService } from '../types.js';
+
+export class SandboxedRunner implements RunnerService {
+  private createContext(
+    context: Record<string, unknown> | undefined,
+    logs: string[],
+  ): Record<string, unknown> {
+    const sandbox: Record<string, unknown> = {
+      console: {
+        log: (...args: unknown[]) => {
+          logs.push(args.map(String).join(' '));
+        },
+        warn: (...args: unknown[]) => {
+          logs.push(args.map(String).join(' '));
+        },
+        error: (...args: unknown[]) => {
+          logs.push(args.map(String).join(' '));
+        },
+        info: (...args: unknown[]) => {
+          logs.push(args.map(String).join(' '));
+        },
+      },
+      require: undefined,
+      module: undefined,
+      exports: undefined,
+      __dirname: undefined,
+      __filename: undefined,
+      process: undefined,
+      Buffer: undefined,
+      setImmediate: undefined,
+      setInterval: undefined,
+      setTimeout: undefined,
+      clearImmediate: undefined,
+      clearInterval: undefined,
+      clearTimeout: undefined,
+      global: undefined,
+      globalThis: undefined,
+    };
+
+    if (context) {
+      Object.assign(sandbox, context);
+    }
+
+    return sandbox;
+  }
+
+  async execute(
+    code: string,
+    context?: Record<string, unknown>,
+  ): Promise<SandboxResult> {
+    const logs: string[] = [];
+    const startHeap = process.memoryUsage().heapUsed;
+    const startTime = Date.now();
+
+    try {
+      const sandbox = this.createContext(context, logs);
+      const ctx = vm.createContext(sandbox);
+      const script = new vm.Script(code);
+      script.runInContext(ctx, { timeout: undefined });
+
+      const endHeap = process.memoryUsage().heapUsed;
+      const endTime = Date.now();
+
+      return {
+        success: true,
+        output: logs.join('\n'),
+        duration: endTime - startTime,
+        memoryUsed: endHeap - startHeap,
+      };
+    } catch (err: unknown) {
+      const endHeap = process.memoryUsage().heapUsed;
+      const endTime = Date.now();
+
+      return {
+        success: false,
+        output: logs.join('\n'),
+        duration: endTime - startTime,
+        memoryUsed: endHeap - startHeap,
+        error: err instanceof Error ? err.message : String(err),
+      };
+    }
+  }
+
+  async executeWithTimeout(
+    code: string,
+    timeoutMs: number,
+    context?: Record<string, unknown>,
+  ): Promise<SandboxResult> {
+    const logs: string[] = [];
+    const startHeap = process.memoryUsage().heapUsed;
+    const startTime = Date.now();
+
+    try {
+      const sandbox = this.createContext(context, logs);
+      const ctx = vm.createContext(sandbox);
+      const script = new vm.Script(code);
+      script.runInContext(ctx, { timeout: timeoutMs });
+
+      const endHeap = process.memoryUsage().heapUsed;
+      const endTime = Date.now();
+
+      return {
+        success: true,
+        output: logs.join('\n'),
+        duration: endTime - startTime,
+        memoryUsed: endHeap - startHeap,
+      };
+    } catch (err: unknown) {
+      if (
+        err instanceof Error &&
+        (err as NodeJS.ErrnoException).code === 'ERR_SCRIPT_EXECUTION_TIMEOUT'
+      ) {
+        return {
+          success: false,
+          output: logs.join('\n'),
+          duration: timeoutMs,
+          memoryUsed: 0,
+          error: 'Execution timed out',
+        };
+      }
+
+      const endHeap = process.memoryUsage().heapUsed;
+      const endTime = Date.now();
+
+      return {
+        success: false,
+        output: logs.join('\n'),
+        duration: endTime - startTime,
+        memoryUsed: endHeap - startHeap,
+        error: err instanceof Error ? err.message : String(err),
+      };
+    }
+  }
+}
