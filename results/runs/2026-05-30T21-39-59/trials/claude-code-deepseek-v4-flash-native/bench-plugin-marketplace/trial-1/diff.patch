index 0000000..f0a046c
--- /dev/null
+++ b/src/deps/index.ts
@@ -0,0 +1,191 @@
+import { DepsService, DependencyNode, RegistryService } from '../types.js';
+
+export class DependencyGraphAnalyzer implements DepsService {
+  buildTree(name: string, registry: RegistryService): DependencyNode {
+    return this.buildTreeInternal(name, registry, new Set<string>());
+  }
+
+  private buildTreeInternal(
+    name: string,
+    registry: RegistryService,
+    visited: Set<string>,
+  ): DependencyNode {
+    const manifest = registry.get(name);
+
+    // Handle missing dependencies gracefully - return a stub node
+    if (!manifest) {
+      return { name, version: '0.0.0', dependencies: [] };
+    }
+
+    // Prevent infinite recursion from cyclic dependencies
+    if (visited.has(name)) {
+      return { name: manifest.name, version: manifest.version, dependencies: [] };
+    }
+
+    visited.add(name);
+
+    const dependencies: DependencyNode[] = [];
+    for (const depName of Object.keys(manifest.dependencies)) {
+      dependencies.push(this.buildTreeInternal(depName, registry, visited));
+    }
+
+    return {
+      name: manifest.name,
+      version: manifest.version,
+      dependencies,
+    };
+  }
+
+  detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const manifest = registry.get(name);
+    if (!manifest) return null;
+
+    const cycles: string[][] = [];
+    const visited = new Set<string>();
+    const recStack = new Set<string>();
+    const path: string[] = [];
+
+    this.detectCyclesDFS(name, registry, visited, recStack, path, cycles);
+
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  private detectCyclesDFS(
+    name: string,
+    registry: RegistryService,
+    visited: Set<string>,
+    recStack: Set<string>,
+    path: string[],
+    cycles: string[][],
+  ): void {
+    visited.add(name);
+    recStack.add(name);
+    path.push(name);
+
+    const manifest = registry.get(name);
+    if (manifest) {
+      for (const depName of Object.keys(manifest.dependencies)) {
+        if (!visited.has(depName)) {
+          this.detectCyclesDFS(depName, registry, visited, recStack, path, cycles);
+        } else if (recStack.has(depName)) {
+          // Found a cycle - extract it from the current path
+          const cycleStartIndex = path.indexOf(depName);
+          const cycle = [...path.slice(cycleStartIndex), depName];
+          cycles.push(cycle);
+        }
+      }
+    }
+
+    path.pop();
+    recStack.delete(name);
+  }
+
+  topologicalSort(name: string, registry: RegistryService): string[] {
+    const manifest = registry.get(name);
+    if (!manifest) return [];
+
+    // Collect all nodes in the dependency subgraph (including missing deps)
+    const allNodes = this.collectAllReachableNodes(name, registry);
+
+    // Build in-degree map and adjacency list.
+    // Edge direction: dep -> dependent, meaning the dependency must come first.
+    const inDegree = new Map<string, number>();
+    const adjacency = new Map<string, string[]>();
+
+    for (const node of allNodes) {
+      inDegree.set(node, 0);
+      adjacency.set(node, []);
+    }
+
+    for (const node of allNodes) {
+      const nodeManifest = registry.get(node);
+      if (nodeManifest) {
+        for (const depName of Object.keys(nodeManifest.dependencies)) {
+          // edge: depName -> node (depName must precede node)
+          adjacency.get(depName)?.push(node);
+          inDegree.set(node, (inDegree.get(node) ?? 0) + 1);
+        }
+      }
+    }
+
+    // Kahn's algorithm - BFS topological sort
+    const bfsQueue: string[] = [];
+    for (const [node, degree] of inDegree) {
+      if (degree === 0) {
+        bfsQueue.push(node);
+      }
+    }
+
+    const result: string[] = [];
+    while (bfsQueue.length > 0) {
+      const node = bfsQueue.shift()!;
+      result.push(node);
+
+      for (const neighbor of adjacency.get(node) ?? []) {
+        const newDegree = (inDegree.get(neighbor) ?? 1) - 1;
+        inDegree.set(neighbor, newDegree);
+        if (newDegree === 0) {
+          bfsQueue.push(neighbor);
+        }
+      }
+    }
+
+    if (result.length !== allNodes.size) {
+      throw new Error('Circular dependency detected');
+    }
+
+    return result;
+  }
+
+  flattenDependencies(name: string, registry: RegistryService): string[] {
+    const allDeps = new Set<string>();
+    const queue: string[] = [name];
+    const visited = new Set<string>();
+
+    while (queue.length > 0) {
+      const current = queue.shift()!;
+      if (visited.has(current)) continue;
+      visited.add(current);
+
+      const nodeManifest = registry.get(current);
+      if (nodeManifest) {
+        for (const depName of Object.keys(nodeManifest.dependencies)) {
+          allDeps.add(depName);
+          queue.push(depName);
+        }
+      }
+    }
+
+    // Exclude the root plugin from the result
+    allDeps.delete(name);
+
+    return [...allDeps];
+  }
+
+  hasCircularDependency(name: string, registry: RegistryService): boolean {
+    return this.detectCycles(name, registry) !== null;
+  }
+
+  private collectAllReachableNodes(
+    name: string,
+    registry: RegistryService,
+  ): Set<string> {
+    const allNodes = new Set<string>();
+    const queue: string[] = [name];
+
+    while (queue.length > 0) {
+      const current = queue.shift()!;
+      if (allNodes.has(current)) continue;
+      allNodes.add(current);
+
+      const nodeManifest = registry.get(current);
+      if (nodeManifest) {
+        for (const depName of Object.keys(nodeManifest.dependencies)) {
+          queue.push(depName);
+        }
+      }
+    }
+
+    return allNodes;
+  }
+}
