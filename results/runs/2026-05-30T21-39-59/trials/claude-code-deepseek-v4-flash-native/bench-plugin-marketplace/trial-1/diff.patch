+      pluginName: 'a',
+      pluginVersion: '1.0.0',
+      userId: 'user1',
+      rating: 5,
+      comment: 'cool',
+    });
+    reviews.addReview({
+      pluginName: 'b',
+      pluginVersion: '1.0.0',
+      userId: 'user1',
+      rating: 4,
+      comment: 'nice',
+    });
+    reviews.addReview({
+      pluginName: 'c',
+      pluginVersion: '1.0.0',
+      userId: 'user2',
+      rating: 3,
+      comment: 'ok',
+    });
+
+    expect(reviews.getReviewsByUser('user1')).toHaveLength(2);
+    expect(reviews.getReviewsByUser('user2')).toHaveLength(1);
+    expect(reviews.getReviewsByUser('nobody')).toHaveLength(0);
+  });
+
+  // ---- count ----
+
+  it('should return the count of non-flagged reviews for a plugin', () => {
+    const r1 = reviews.addReview({
+      pluginName: 'p',
+      pluginVersion: '1.0.0',
+      userId: 'u1',
+      rating: 5,
+      comment: 'a',
+    });
+    reviews.addReview({
+      pluginName: 'p',
+      pluginVersion: '1.0.0',
+      userId: 'u2',
+      rating: 4,
+      comment: 'b',
+    });
+
+    expect(reviews.getReviewCount('p')).toBe(2);
+
+    reviews.flagReview(r1.id);
+    expect(reviews.getReviewCount('p')).toBe(1);
+  });
+
+  it('should return 0 for a plugin with no reviews', () => {
+    expect(reviews.getReviewCount('nonexistent')).toBe(0);
+  });
+});
+
+// ===========================================================================
+// DependencyGraphAnalyzer
+// ===========================================================================
+
+describe('DependencyGraphAnalyzer', () => {
+  let deps: DependencyGraphAnalyzer;
+  let registry: PluginRegistry;
+
+  beforeEach(() => {
+    deps = new DependencyGraphAnalyzer();
+    registry = new PluginRegistry();
+  });
+
+  // ---- buildTree ----
+
+  it('should build a dependency tree', () => {
+    registry.register(makeManifest({ name: 'dep-c', version: '1.0.0' }));
+    registry.register(
+      makeManifest({ name: 'dep-b', version: '1.0.0', dependencies: { 'dep-c': '^1.0.0' } }),
+    );
+    registry.register(
+      makeManifest({
+        name: 'dep-a',
+        version: '1.0.0',
+        dependencies: { 'dep-b': '^1.0.0' },
+      }),
+    );
+
+    const tree = deps.buildTree('dep-a', registry);
+    expect(tree.name).toBe('dep-a');
+    expect(tree.version).toBe('1.0.0');
+    expect(tree.dependencies).toHaveLength(1);
+    expect(tree.dependencies[0].name).toBe('dep-b');
+    expect(tree.dependencies[0].dependencies).toHaveLength(1);
+    expect(tree.dependencies[0].dependencies[0].name).toBe('dep-c');
+    expect(tree.dependencies[0].dependencies[0].dependencies).toHaveLength(0);
+  });
+
+  // ---- detectCycles ----
+
+  it('should detect a circular dependency and return the cycle path', () => {
+    registry.register(
+      makeManifest({
+        name: 'dep-a',
+        version: '1.0.0',
+        dependencies: { 'dep-b': '^1.0.0' },
+      }),
+    );
+    registry.register(
+      makeManifest({
+        name: 'dep-b',
+        version: '1.0.0',
+        dependencies: { 'dep-a': '^1.0.0' },
+      }),
+    );
+
+    const cycles = deps.detectCycles('dep-a', registry);
+    expect(cycles).not.toBeNull();
+    expect(cycles!).toHaveLength(1);
+    expect(cycles![0]).toEqual(['dep-a', 'dep-b', 'dep-a']);
+  });
+
+  it('should return null when there are no cycles', () => {
+    registry.register(makeManifest({ name: 'dep-c', version: '1.0.0' }));
+    registry.register(
+      makeManifest({ name: 'dep-b', version: '1.0.0', dependencies: { 'dep-c': '^1.0.0' } }),
+    );
+    registry.register(
+      makeManifest({
+        name: 'dep-a',
+        version: '1.0.0',
+        dependencies: { 'dep-b': '^1.0.0' },
+      }),
+    );
+
+    expect(deps.detectCycles('dep-a', registry)).toBeNull();
+  });
+
+  // ---- topologicalSort ----
+
+  it('should produce a topological order of dependencies', () => {
+    registry.register(makeManifest({ name: 'dep-c', version: '1.0.0' }));
+    registry.register(
+      makeManifest({ name: 'dep-b', version: '1.0.0', dependencies: { 'dep-c': '^1.0.0' } }),
+    );
+    registry.register(
+      makeManifest({
+        name: 'dep-a',
+        version: '1.0.0',
+        dependencies: { 'dep-b': '^1.0.0' },
+      }),
+    );
+
+    const sorted = deps.topologicalSort('dep-a', registry);
+    // dep-c has no deps, dep-b depends on dep-c, dep-a depends on dep-b
+    expect(sorted).toEqual(['dep-c', 'dep-b', 'dep-a']);
+  });
+
+  it('should throw on topological sort when a cycle exists', () => {
+    registry.register(
+      makeManifest({
+        name: 'dep-a',
+        version: '1.0.0',
+        dependencies: { 'dep-b': '^1.0.0' },
+      }),
+    );
+    registry.register(
+      makeManifest({
+        name: 'dep-b',
+        version: '1.0.0',
+        dependencies: { 'dep-a': '^1.0.0' },
+      }),
+    );
+
+    expect(() => deps.topologicalSort('dep-a', registry)).toThrow(
+      /circular dependency/i,
+    );
+  });
+
+  // ---- flattenDependencies ----
+
+  it('should return a flat list of all transitive dependencies', () => {
+    registry.register(makeManifest({ name: 'dep-c', version: '1.0.0' }));
+    registry.register(
+      makeManifest({ name: 'dep-b', version: '1.0.0', dependencies: { 'dep-c': '^1.0.0' } }),
+    );
+    registry.register(
+      makeManifest({
+        name: 'dep-a',
+        version: '1.0.0',
+        dependencies: { 'dep-b': '^1.0.0' },
+      }),
+    );
+
+    const flat = deps.flattenDependencies('dep-a', registry);
+    expect(flat).toContain('dep-b');
+    expect(flat).toContain('dep-c');
+    expect(flat).not.toContain('dep-a');
+  });
+
+  // ---- hasCircularDependency ----
+
+  it('should return true when a cycle exists', () => {
+    registry.register(
+      makeManifest({
+        name: 'dep-a',
+        version: '1.0.0',
+        dependencies: { 'dep-b': '^1.0.0' },
+      }),
+    );
+    registry.register(
+      makeManifest({
+        name: 'dep-b',
+        version: '1.0.0',
+        dependencies: { 'dep-a': '^1.0.0' },
+      }),
+    );
+
+    expect(deps.hasCircularDependency('dep-a', registry)).toBe(true);
+  });
+
+  it('should return false when no cycle exists', () => {
+    registry.register(makeManifest({ name: 'dep-b', version: '1.0.0' }));
+    registry.register(
+      makeManifest({
+        name: 'dep-a',
+        version: '1.0.0',
+        dependencies: { 'dep-b': '^1.0.0' },
+      }),
+    );
+
+    expect(deps.hasCircularDependency('dep-a', registry)).toBe(false);
+  });
+});
+
+// ===========================================================================
+// Integration
+// ===========================================================================
+
+describe('Integration', () => {
+  // ---- createMarketplace returns services ----
+
+  it('createMarketplace returns all five services and installPlugin', () => {
+    const mp = createMarketplace() as {
+      registry: PluginRegistry;
+      resolver: VersionResolver;
+      runner: SandboxedRunner;
+      reviews: ReviewSystem;
+      deps: DependencyGraphAnalyzer;
+      installPlugin: (m: PluginManifest) => Promise<unknown>;
+    };
+
+    expect(mp.registry).toBeInstanceOf(PluginRegistry);
+    expect(mp.resolver).toBeInstanceOf(VersionResolver);
+    expect(mp.runner).toBeInstanceOf(SandboxedRunner);
+    expect(mp.reviews).toBeInstanceOf(ReviewSystem);
+    expect(mp.deps).toBeInstanceOf(DependencyGraphAnalyzer);
+    expect(typeof mp.installPlugin).toBe('function');
+  });
+
+  // ---- installPlugin validates fields ----
+
+  const invalidCases: Array<{
+    label: string;
+    overrides: Partial<PluginManifest>;
+    errorPattern: RegExp;
+  }> = [
+    {
+      label: 'empty name',
+      overrides: { name: '' },
+      errorPattern: /non-empty string/i,
+    },
+    {
+      label: 'invalid version',
+      overrides: { version: 'not-semver' },
+      errorPattern: /invalid plugin version/i,
+    },
+    {
+      label: 'empty entryPoint',
+      overrides: { entryPoint: '' },
+      errorPattern: /non-empty string/i,
+    },
+  ];
+
+  for (const { label, overrides, errorPattern } of invalidCases) {
+    it(`should reject installPlugin with ${label}`, async () => {
+      const { installPlugin } = createMarketplace() as {
+        installPlugin: (m: PluginManifest) => Promise<unknown>;
+      };
+      await expect(installPlugin(makeManifest(overrides))).rejects.toThrow(
+        errorPattern,
+      );
+    });
+  }
+
+  // ---- full workflow ----
+
+  it('full workflow: register dependency, install plugin, resolve and execute', async () => {
+    const mp = createMarketplace() as {
+      registry: PluginRegistry;
+      installPlugin: (m: PluginManifest) => Promise<{
+        resolvedDeps: Array<{ name: string; version: string; satisfies: string }>;
+        executionResult: { success: boolean; output: string };
+      }>;
+    };
+
+    // Register a dependency first
+    mp.registry.register(DEP_A_MANIFEST_2);
+    mp.registry.register(DEP_A_MANIFEST_1);
+
+    // Install a plugin that depends on dep-a
+    const result = await mp.installPlugin({
+      name: 'my-app',
+      version: '1.0.0',
+      description: 'My application',
+      author: 'dev',
+      dependencies: { 'dep-a': '^1.0.0 || ^2.0.0' },
+      entryPoint: 'console.log("my-app running")',
+      permissions: [],
+    });
+
+    expect(result.resolvedDeps).toHaveLength(1);
+    expect(result.resolvedDeps[0].name).toBe('dep-a');
+    expect(result.resolvedDeps[0].version).toBe('2.0.0');
+    expect(result.resolvedDeps[0].satisfies).toBe('^1.0.0 || ^2.0.0');
+
+    expect(result.executionResult.success).toBe(true);
+    expect(result.executionResult.output).toBe('my-app running');
+  });
+
+  // ---- circular dep rejection ----
+
+  it('should reject installPlugin when a circular dependency is detected', async () => {
+    const mp = createMarketplace() as {
+      registry: PluginRegistry;
+      installPlugin: (m: PluginManifest) => Promise<unknown>;
+    };
+
+    // Pre-register a plugin that depends on plugin-a (the one we will install)
+    mp.registry.register({
+      name: 'plugin-b',
+      version: '1.0.0',
+      description: 'Plugin B',
+      author: 'dev',
+      dependencies: { 'plugin-a': '^1.0.0' },
+      entryPoint: 'console.log("b")',
+      permissions: [],
+    });
+
+    const manifestA = makeManifest({
+      name: 'plugin-a',
+      version: '1.0.0',
+      dependencies: { 'plugin-b': '^1.0.0' },
+      entryPoint: 'console.log("a")',
+    });
+
+    await expect(mp.installPlugin(manifestA)).rejects.toThrow(
+      /circular dependency/i,
+    );
+  });
+});
