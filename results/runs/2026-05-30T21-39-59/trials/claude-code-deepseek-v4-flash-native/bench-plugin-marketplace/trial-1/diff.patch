+++ b/src/index.ts
@@ -0,0 +1,96 @@
+import {
+  PluginManifest,
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+  ResolvedVersion,
+  SandboxResult,
+  VersionConstraint,
+} from './types.js';
+import { PluginRegistry } from './registry/index.js';
+import { VersionResolver } from './resolver/index.js';
+import { SandboxedRunner } from './runner/index.js';
+import { ReviewSystem } from './reviews/index.js';
+import { DependencyGraphAnalyzer } from './deps/index.js';
+import semver from 'semver';
+
+export function createMarketplace(options?: { dbPath?: string }): object {
+  const dbPath = options?.dbPath;
+  const registry: RegistryService = new PluginRegistry(dbPath);
+  const resolver: ResolverService = new VersionResolver();
+  const runner: RunnerService = new SandboxedRunner();
+  const reviews: ReviewService = new ReviewSystem(dbPath);
+  const deps: DepsService = new DependencyGraphAnalyzer();
+
+  return {
+    registry,
+    resolver,
+    runner,
+    reviews,
+    deps,
+
+    async installPlugin(
+      manifest: PluginManifest,
+    ): Promise<{ resolvedDeps: ResolvedVersion[]; executionResult: SandboxResult }> {
+      // a. Validate manifest fields
+      if (typeof manifest.name !== 'string' || manifest.name.length === 0) {
+        throw new Error('Plugin name must be a non-empty string');
+      }
+      if (typeof manifest.version !== 'string' || !semver.valid(manifest.version)) {
+        throw new Error(`Invalid plugin version: ${manifest.version}`);
+      }
+      if (typeof manifest.entryPoint !== 'string' || manifest.entryPoint.length === 0) {
+        throw new Error('Plugin entryPoint must be a non-empty string');
+      }
+
+      // b. Register the plugin
+      registry.register(manifest);
+
+      // c. Build version constraints from manifest dependencies
+      const constraints: VersionConstraint[] = Object.entries(
+        manifest.dependencies,
+      ).map(([name, range]) => ({ name, range }));
+
+      // d. Gather available versions for each dependency
+      const available: Record<string, string[]> = {};
+      for (const { name } of constraints) {
+        available[name] = registry.listVersions(name);
+      }
+
+      // e. Resolve dependency versions
+      const resolvedDeps = resolver.resolve(constraints, available);
+
+      // f. Check for circular dependencies
+      if (deps.hasCircularDependency(manifest.name, registry)) {
+        throw new Error('Circular dependency detected');
+      }
+
+      // g. Execute the entry point code in a sandbox
+      const executionResult = await runner.execute(manifest.entryPoint);
+
+      // h. Return resolved dependencies and execution result
+      return { resolvedDeps, executionResult };
+    },
+  };
+}
+
+// Re-export service classes for convenience
+export { PluginRegistry } from './registry/index.js';
+export { VersionResolver } from './resolver/index.js';
+export { SandboxedRunner } from './runner/index.js';
+export { ReviewSystem } from './reviews/index.js';
+export { DependencyGraphAnalyzer } from './deps/index.js';
+
+// Re-export types
+export type {
+  PluginManifest,
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+  ResolvedVersion,
+  SandboxResult,
+} from './types.js';
