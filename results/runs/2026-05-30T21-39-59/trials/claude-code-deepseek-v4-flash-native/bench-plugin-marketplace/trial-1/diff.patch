+++ b/src/registry/index.ts
@@ -0,0 +1,165 @@
+import Database from 'better-sqlite3';
+import semver from 'semver';
+import { PluginManifest, RegistryService } from '../types.js';
+
+interface PluginRow {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  entry_point: string;
+  permissions: string;
+  dependencies: string;
+}
+
+export class PluginRegistry implements RegistryService {
+  private db: Database.Database;
+
+  constructor(dbPath?: string) {
+    this.db = new Database(dbPath ?? ':memory:');
+    this.db.pragma('journal_mode = WAL');
+    this.createTable();
+  }
+
+  private createTable(): void {
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS plugins (
+        name TEXT NOT NULL,
+        version TEXT NOT NULL,
+        description TEXT NOT NULL,
+        author TEXT NOT NULL,
+        entry_point TEXT NOT NULL,
+        permissions TEXT NOT NULL DEFAULT '[]',
+        dependencies TEXT NOT NULL DEFAULT '{}',
+        PRIMARY KEY (name, version)
+      )
+    `);
+  }
+
+  register(manifest: PluginManifest): void {
+    const stmt = this.db.prepare(`
+      INSERT INTO plugins (name, version, description, author, entry_point, permissions, dependencies)
+      VALUES (@name, @version, @description, @author, @entryPoint, @permissions, @dependencies)
+    `);
+
+    try {
+      stmt.run({
+        name: manifest.name,
+        version: manifest.version,
+        description: manifest.description,
+        author: manifest.author,
+        entryPoint: manifest.entryPoint,
+        permissions: JSON.stringify(manifest.permissions),
+        dependencies: JSON.stringify(manifest.dependencies),
+      });
+    } catch (err: unknown) {
+      if (err instanceof Database.SqliteError && err.code === 'SQLITE_CONSTRAINT_PRIMARYKEY') {
+        throw new Error(`Plugin ${manifest.name}@${manifest.version} already exists`);
+      }
+      throw err;
+    }
+  }
+
+  get(name: string): PluginManifest | null {
+    const rows = this.db.prepare(
+      'SELECT * FROM plugins WHERE name = ?'
+    ).all(name) as PluginRow[];
+
+    if (rows.length === 0) return null;
+
+    rows.sort((a, b) => semver.rcompare(a.version, b.version));
+    return this.rowToManifest(rows[0]);
+  }
+
+  getVersion(name: string, version: string): PluginManifest | null {
+    const row = this.db.prepare(
+      'SELECT * FROM plugins WHERE name = ? AND version = ?'
+    ).get(name, version) as PluginRow | undefined;
+
+    return row ? this.rowToManifest(row) : null;
+  }
+
+  list(): PluginManifest[] {
+    const rows = this.db.prepare('SELECT * FROM plugins').all() as PluginRow[];
+    return rows.map((row) => this.rowToManifest(row));
+  }
+
+  search(query: string): PluginManifest[] {
+    const pattern = `%${query}%`;
+    const rows = this.db.prepare(`
+      SELECT * FROM plugins
+      WHERE name LIKE ? OR description LIKE ? OR author LIKE ?
+    `).all(pattern, pattern, pattern) as PluginRow[];
+
+    return rows.map((row) => this.rowToManifest(row));
+  }
+
+  remove(name: string, version: string): boolean {
+    const result = this.db.prepare(
+      'DELETE FROM plugins WHERE name = ? AND version = ?'
+    ).run(name, version);
+
+    return result.changes > 0;
+  }
+
+  listVersions(name: string): string[] {
+    const rows = this.db.prepare(
+      'SELECT version FROM plugins WHERE name = ?'
+    ).all(name) as { version: string }[];
+
+    const versions = rows.map((row) => row.version);
+    versions.sort(semver.compare);
+    return versions;
+  }
+
+  update(name: string, version: string, updates: Partial<PluginManifest>): void {
+    const existing = this.getVersion(name, version);
+    if (!existing) {
+      throw new Error(`Plugin ${name}@${version} not found`);
+    }
+
+    const setClauses: string[] = [];
+    const values: string[] = [];
+
+    const fieldMap: Record<string, keyof PluginManifest> = {
+      description: 'description',
+      author: 'author',
+      entry_point: 'entryPoint',
+      permissions: 'permissions',
+      dependencies: 'dependencies',
+    };
+
+    for (const [column, key] of Object.entries(fieldMap)) {
+      if (key in updates) {
+        setClauses.push(`${column} = ?`);
+        const value = updates[key];
+        if (value !== undefined) {
+          if (key === 'permissions' || key === 'dependencies') {
+            values.push(JSON.stringify(value));
+          } else {
+            values.push(value as string);
+          }
+        }
+      }
+    }
+
+    if (setClauses.length === 0) return;
+
+    values.push(name, version);
+    this.db.prepare(
+      `UPDATE plugins SET ${setClauses.join(', ')} WHERE name = ? AND version = ?`
+    ).run(...values);
+  }
+
+  private rowToManifest(row: PluginRow): PluginManifest {
+    return {
+      name: row.name,
+      version: row.version,
+      description: row.description,
+      author: row.author,
+      entryPoint: row.entry_point,
+      permissions: JSON.parse(row.permissions),
+      dependencies: JSON.parse(row.dependencies),
+    };
+  }
+}
