=============================================================\n// PluginRegistry\n// ===========================================================================\n\ndescribe('PluginRegistry', () => {\n  let registry: PluginRegistry;\n\n  beforeEach(() => {\n    registry = new PluginRegistry();\n  });\n\n  // ---- register + get ----\n\n  it('should register and get a plugin', () => {\n    registry.register(makeManifest());\n\n    const result = registry.get('test-plugin');\n    expect(result).not.toBeNull();\n    expect(result!.name).toBe('test-plugin');\n    expect(result!.version).toBe('1.0.0');\n    expect(result!.description).toBe('A test plugin');\n    expect(result!.author).toBe('tester');\n    expect(result!.entryPoint).toBe('console.log(\"hello\")');\n    expect(result!.permissions).toEqual([]);\n    expect(result!.dependencies).toEqual({});\n  });\n\n  it('should return the latest version via get()', () => {\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.register(makeManifest({ version: '3.0.0' }));\n    registry.register(makeManifest({ version: '2.0.0' }));\n\n    expect(registry.get('test-plugin')!.version).toBe('3.0.0');\n  });\n\n  it('should return null from get() when plugin does not exist', () => {\n    expect(registry.get('nonexistent')).toBeNull();\n  });\n\n  // ---- getVersion ----\n\n  it('should get a specific version via getVersion()', () => {\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.register(makeManifest({ version: '2.0.0' }));\n\n    const result = registry.getVersion('test-plugin', '1.0.0');\n    expect(result).not.toBeNull();\n    expect(result!.version).toBe('1.0.0');\n  });\n\n  it('should return null from getVersion() for non-existent plugin or version', () => {\n    registry.register(makeManifest());\n    expect(registry.getVersion('nonexistent', '1.0.0')).toBeNull();\n    expect(registry.getVersion('test-plugin', '99.0.0')).toBeNull();\n  });\n\n  // ---- list ----\n\n  it('should list all registered plugins', () => {\n    registry.register(makeManifest({ name: 'plugin-a' }));\n    registry.register(makeManifest({ name: 'plugin-b' }));\n\n    const all = registry.list();\n    expect(all).toHaveLength(2);\n    expect(all.map((p) => p.name).sort()).toEqual(['plugin-a', 'plugin-b']);\n  });\n\n  it('should return an empty array when no plugins are registered', () => {\n    expect(registry.list()).toEqual([]);\n  });\n\n  // ---- search ----\n\n  it('should search plugins by name', () => {\n    registry.register(makeManifest({ name: 'awesome-tool', description: 'does stuff' }));\n    registry.register(makeManifest({ name: 'other-tool', description: 'boring' }));\n\n    const results = registry.search('awesome');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('awesome-tool');\n  });\n\n  it('should search plugins by description', () => {\n    registry.register(makeManifest({ name: 'tool-a', description: 'file manager plugin' }));\n    registry.register(makeManifest({ name: 'tool-b', description: 'network scanner' }));\n\n    const results = registry.search('file manager');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('tool-a');\n  });\n\n  it('should return an empty array when search does not match', () => {\n    registry.register(makeManifest());\n    expect(registry.search('zzz_nonexistent')).toEqual([]);\n  });\n\n  // ---- remove ----\n\n  it('should remove a plugin and return true', () => {\n    registry.register(makeManifest());\n    expect(registry.remove('test-plugin', '1.0.0')).toBe(true);\n    expect(registry.get('test-plugin')).toBeNull();\n  });\n\n  it('should return false when removing a non-existent plugin', () => {\n    expect(registry.remove('nonexistent', '1.0.0')).toBe(false);\n  });\n\n  // ---- listVersions ----\n\n  it('should list all versions of a plugin in ascending order', () => {\n    registry.register(makeManifest({ version: '2.0.0' }));\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.register(makeManifest({ version: '3.0.0' }));\n\n    expect(registry.listVersions('test-plugin')).toEqual(['1.0.0', '2.0.0', '3.0.0']);\n  });\n\n  it('should return an empty array for a non-existent plugin', () => {\n    expect(registry.listVersions('nonexistent')).toEqual([]);\n  });\n\n  // ---- update ----\n\n  it('should update fields of an existing plugin', () => {\n    registry.register(makeManifest());\n    registry.update('test-plugin', '1.0.0', {\n      description: 'Updated desc',\n      author: 'new-author',\n    });\n\n    const updated = registry.get('test-plugin')!;\n    expect(updated.description).toBe('Updated desc');\n    expect(updated.author).toBe('new-author');\n    expect(updated.name).toBe('test-plugin');\n  });\n\n  it('should update permissions and dependencies (JSON fields)', () => {\n    registry.register(makeManifest());\n    registry.update('test-plugin', '1.0.0', {\n      permissions: ['read', 'write'],\n      dependencies: { depA: '^1.0.0' },\n    });\n\n    const updated = registry.get('test-plugin')!;\n    expect(updated.permissions).toEqual(['read', 'write']);\n    expect(updated.dependencies).toEqual({ depA: '^1.0.0' });\n  });\n\n  it('should throw when updating a non-existent plugin', () => {\n    expect(() =>\n      registry.update('nonexistent', '1.0.0', { description: 'x' }),\n    ).toThrow(/not found/i);\n  });\n\n  // ---- duplicate ----\n\n  it('should throw on duplicate registration', () => {\n    registry.register(makeManifest());\n    expect(() => registry.register(makeManifest())).toThrow(/already exists/i);\n  });\n});\n\n// ===========================================================================\n// VersionResolver\n// ===========================================================================\n\ndescribe('VersionResolver', () => {\n  let resolver: VersionResolver;\n\n  beforeEach(() => {\n    resolver = new VersionResolver();\n  });\n\n  // ---- satisfies ----\n\n  it('should check if a version satisfies a semver range', () => {\n    expect(resolver.satisfies('1.2.3', '^1.0.0')).toBe(true);\n    expect(resolver.satisfies('2.0.0', '^1.0.0')).toBe(false);\n    expect(resolver.satisfies('1.0.0', '1.0.0')).toBe(true);\n  });\n\n  it('should return false for an invalid version', () => {\n    expect(resolver.satisfies('not-a-version', '^1.0.0')).toBe(false);\n  });\n\n  // ---- maxSatisfying ----\n\n  it('should find the maximum satisfying version', () => {\n    const versions = ['1.0.0', '1.5.0', '2.0.0', '1.9.0'];\n    expect(resolver.maxSatisfying(versions, '^1.0.0')).toBe('1.9.0');\n    expect(resolver.maxSatisfying(versions, '^2.0.0')).toBe('2.0.0');\n    expect(resolver.maxSatisfying(versions, '~1.0.0')).toBe('1.0.0');\n  });\n\n  it('should return null when no version satisfies the range', () => {\n    expect(resolver.maxSatisfying(['1.0.0', '2.0.0'], '^3.0.0')).toBeNull();\n    expect(resolver.maxSatisfying([], '^1.0.0')).toBeNull();\n  });\n\n  // ---- validRange ----\n\n  it('should return true for valid semver ranges', () => {\n    expect(resolver.validRange('^1.0.0')).toBe(true);\n    expect(resolver.validRange('>=1.2.3 <2.0.0')).toBe(true);\n    expect(resolver.validRange('*')).toBe(true);\n    expect(resolver.validRange('1.0.0')).toBe(true);\n  });\n\n  it('should return false for invalid ranges', () => {\n    expect(resolver.validRange('not-a-range')).toBe(false);\n  });\n\n  // ---- resolve ----\n\n  it('should resolve a single constraint to the best version', () => {\n    const constraints = [{ name: 'dep-a', range: '^1.0.0' }];\n    const available = { 'dep-a': ['1.0.0', '1.5.0', '2.0.0'] };\n\n    const resolved = resolver.resolve(constraints, available);\n    expect(resolved).toHaveLength(1);\n    expect(resolved[0]).toEqual({\n      name: 'dep-a',\n      version: '1.5.0',\n      satisfies: '^1.0.0',\n    });\n  });\n\n  it('should resolve multiple constraints simultaneously', () => {\n    const constraints = [\n      { name: 'dep-a', range: '^1.0.0' },\n      { name: 'dep-b', range: '^2.0.0' },\n    ];\n    const available = {\n      'dep-a': ['1.0.0', '1.5.0'],\n      'dep-b': ['2.0.0', '2.1.0', '3.0.0'],\n    };\n\n    const resolved = resolver.resolve(constraints, available);\n    expect(resolved).toHaveLength(2);\n    expect(resolved.find((r) => r.name === 'dep-a')!.version).toBe('1.5.0');\n    expect(resolved.find((r) => r.name === 'dep-b')!.version).toBe('2.1.0');\n  });\n\n  it('should throw when a dependency package is missing', () => {\n    const constraints = [{ name: 'unknown', range: '^1.0.0' }];\n    expect(() => resolver.resolve(constraints, {})).toThrow(\n      /Cannot satisfy constraint/,\n    );\n  });\n\n  it('should throw when no version satisfies the constraint (unsatisfiable)', () => {\n    const constraints = [{ name: 'dep-a', range: '^5.0.0' }];\n    const available = { 'dep-a': ['1.0.0', '2.0.0'] };\n    expect(() => resolver.resolve(constraints, available)).toThrow(\n      /Cannot satisfy constraint/,\n    );\n  });\n});\n\n// ===========================================================================\n// SandboxedRunner\n// ===========================================================================\n\ndescribe('SandboxedRunner', () => {\n  let runner: SandboxedRunner;\n\n  beforeEach(() => {\n    runner = new SandboxedRunner();\n  });\n\n  it('should execute simple code and report success', async () => {\n    const result = await runner.execute('console.log(\"hello world\")');\n    expect(result.success).toBe(true);\n    expect(result.output).toBe('hello world');\n    expect(result.duration).toBeGreaterThanOrEqual(0);\n  });\n\n  it('should expose context variables to the sandbox', async () => {\n    const result = await runner.execute('console.log(x + y)', {\n      x: 10,\n      y: 20,\n    });\n    expect(result.success).toBe(true);\n    expect(result.output).toBe('30');\n  });\n\n  it('should enforce execution timeout', async () => {\n    const result = await runner.executeWithTimeout('while(true) {}', 100);\n    expect(result.success).toBe(false);\n    expect(result.error).toContain('timed out');\n    // On timeout the duration is set to timeoutMs\n    expect(result.duration).toBeGreaterThanOrEqual(100);\n  }, 10_000);\n\n  it('should capture runtime errors gracefully', async () => {\n    const result = await runner.execute('throw new Error(\"boom\")');\n    expect(result.success).toBe(false);\n    expect(result.error).toContain('boom');\n  });\n});\n\n// ===========================================================================\n// ReviewSystem\n// ===========================================================================\n\ndescribe('ReviewSystem', () => {\n  let reviews: ReviewSystem;\n\n  beforeEach(() => {\n    reviews = new ReviewSystem();\n  });\n\n  // ---- add + get ----\n\n  it('should add a review and retrieve it via getReviews', () => {\n    const added = reviews.addReview({\n      pluginName: 'test-plugin',\n      pluginVersion: '1.0.0',\n      userId: 'user1',\n      rating: 5,\n      comment: 'Great plugin!',\n    });\n\n    expect(added.id).toBeGreaterThan(0);\n    expect(added.pluginName).toBe('test-plugin');\n    expect(added.rating).toBe(5);\n    expect(added.flagged).toBe(false);\n    expect(added.createdAt).toBeTruthy();\n\n    const all = reviews.getReviews('test-plugin');\n    expect(all).toHaveLength(1);\n    expect(all[0].id).toBe(added.id);\n  });\n\n  // ---- average rating (excluding flagged) ----\n\n  it('should calculate average rating excluding flagged reviews', () => {\n    reviews.addReview({\n      pluginName: 'p',\n      pluginVersion: '1.0.0',\n      userId: 'u1',\n      rating: 5,\n      comment: 'good',\n    });\n    reviews.addReview({\n      pluginName: 'p',\n      pluginVersion: '1.0.0',\n      userId: 'u2',\n      rating: 5,\n      comment: 'great',\n    });\n    const flagged = reviews.addReview({\n      pluginName: 'p',\n      pluginVersion: '1.0.0',\n      userId: 'u3',\n      rating: 1,\n      comment: 'bad',\n    });\n\n    reviews.flagReview(flagged.id);\n\n    expect(reviews.getAverageRating('p')).toBe(5); // (5 + 5) / 2\n  });\n\n  it('should return 0 average when no reviews exist', () => {\n    expect(reviews.getAverageRating('nonexistent')).toBe(0);\n  });\n\n  // ---- flag ----\n\n  it('should flag a review so it is excluded from getReviews', () => {\n    const review = reviews.addReview({\n      pluginName: 'p',\n      pluginVersion: '1.0.0',\n      userId: 'u1',\n      rating: 3,\n      comment: 'ok',\n    });\n\n    reviews.flagReview(review.id);\n\n    // Flagged reviews appear in getFlaggedReviews\n    const flagged = reviews.getFlaggedReviews();\n    expect(flagged).toHaveLength(1);\n    expect(flagged[0].id).toBe(review.id);\n    expect(flagged[0].flagged).toBe(true);\n\n    // Flagged reviews are hidden from getReviews\n    expect(reviews.getReviews('p')).toHaveLength(0);\n  });\n\n  it('should throw when flagging a non-existent review', () => {\n    expect(() => reviews.flagReview(9999)).toThrow(/not found/i);\n  });\n\n  // ---- getFlaggedReviews ----\n\n  it('should return all flagged reviews', () => {\n    const r1 = reviews.addReview({\n      pluginName: 'a',\n      pluginVersion: '1.0.0',\n      userId: 'u1',\n      rating: 1,\n      comment: 'spam',\n    });\n    const r2 = reviews.addReview({\n      pluginName: 'b',\n      pluginVersion: '1.0.0',\n      userId: 'u2',\n      rating: 5,\n      comment: 'good',\n    });\n    const r3 = reviews.addReview({\n      pluginName: 'a',\n      pluginVersion: '1.0.0',\n      userId: 'u3',\n      rating: 2,\n      comment: 'bad',\n    });\n\n    reviews.flagReview(r1.id);\n    reviews.flagReview(r3.id);\n\n    const flagged = reviews.getFlaggedReviews();\n    expect(flagged).toHaveLength(2);\n  });\n\n  // ---- remove ----\n\n  it('should remove a review and return true', () => {\n    const review = reviews.addReview({\n      pluginName: 'p',\n      pluginVersion: '1.0.0',\n      userId: 'u1',\n      rating: 4,\n      comment: 'nice',\n    });\n\n    expect(reviews.removeReview(review.id)).toBe(true);\n    expect(reviews.getReviews('p')).toHaveLength(0);\n  });\n\n  it('should return false when removing a non-existent review', () => {\n    expect(reviews.removeReview(9999)).toBe(false);\n  });\n\n  // ---- by-user ----\n\n  it('should retrieve all reviews by a specific user (including flagged)', () => {\n    reviews.addReview({\n      pluginName: 'a',\n      pluginVersion: '1.0.0',\n      userId: 'user1',\n      rating: 5,\n      comment: 'cool',\n    });\n    reviews.addReview({\n      pluginName: 'b',\n      pluginVersion: '1.0.0',\n      userId: 'user1',\n      rating: 4,\n      comment: 'nice',\n    });\n    reviews.addReview({\n      pluginName: 'c',\n      pluginVersion: '1.0.0',\n      userId: 'user2',\n      rating: 3,\n      comment: 'ok',\n    });\n\n    expect(reviews.getReviewsByUser('user1')).toHaveLength(2);\n    expect(reviews.getReviewsByUser('user2')).toHaveLength(1);\n    expect(reviews.getReviewsByUser('nobody')).toHaveLength(0);\n  });\n\n  // ---- count ----\n\n  it('should return the count of non-flagged reviews for a plugin', () => {\n    const r1 = reviews.addReview({\n      pluginName: 'p',\n      pluginVersion: '1.0.0',\n      userId: 'u1',\n      rating: 5,\n      comment: 'a',\n    });\n    reviews.addReview({\n      pluginName: 'p',\n      pluginVersion: '1.0.0',\n      userId: 'u2',\n      rating: 4,\n      comment: 'b',\n    });\n\n    expect(reviews.getReviewCount('p')).toBe(2);\n\n    reviews.flagReview(r1.id);\n    expect(reviews.getReviewCount('p')).toBe(1);\n  });\n\n  it('should return 0 for a plugin with no reviews', () => {\n    expect(reviews.getReviewCount('nonexistent')).toBe(0);\n  });\n});\n\n// ===========================================================================\n// DependencyGraphAnalyzer\n// ===========================================================================\n\ndescribe('DependencyGraphAnalyzer', () => {\n  let deps: DependencyGraphAnalyzer;\n  let registry: PluginRegistry;\n\n  beforeEach(() => {\n    deps = new DependencyGraphAnalyzer();\n    registry = new PluginRegistry();\n  });\n\n  // ---- buildTree ----\n\n  it('should build a dependency tree', () => {\n    registry.register(makeManifest({ name: 'dep-c', version: '1.0.0' }));\n    registry.register(\n      makeManifest({ name: 'dep-b', version: '1.0.0', dependencies: { 'dep-c': '^1.0.0' } }),\n    );\n    registry.register(\n      makeManifest({\n        name: 'dep-a',\n        version: '1.0.0',\n        dependencies: { 'dep-b': '^1.0.0' },\n      }),\n    );\n\n    const tree = deps.buildTree('dep-a', registry);\n    expect(tree.name).toBe('dep-a');\n    expect(tree.version).toBe('1.0.0');\n    expect(tree.dependencies).toHaveLength(1);\n    expect(tree.dependencies[0].name).toBe('dep-b');\n    expect(tree.dependencies[0].dependencies).toHaveLength(1);\n    expect(tree.dependencies[0].dependencies[0].name).toBe('dep-c');\n    expect(tree.dependencies[0].dependencies[0].dependencies).toHaveLength(0);\n  });\n\n  // ---- detectCycles ----\n\n  it('should detect a circular dependency and return the cycle path', () => {\n    registry.register(\n      makeManifest({\n        name: 'dep-a',\n        version: '1.0.0',\n        dependencies: { 'dep-b': '^1.0.0' },\n      }),\n    );\n    registry.register(\n      makeManifest({\n        name: 'dep-b',\n        version: '1.0.0',\n        dependencies: { 'dep-a': '^1.0.0' },\n      }),\n    );\n\n    const cycles = deps.detectCycles('dep-a', registry);\n    expect(cycles).not.toBeNull();\n    expect(cycles!).toHaveLength(1);\n    expect(cycles![0]).toEqual(['dep-a', 'dep-b', 'dep-a']);\n  });\n\n  it('should return null when there are no cycles', () => {\n    registry.register(makeManifest({ name: 'dep-c', version: '1.0.0' }));\n    registry.register(\n      makeManifest({ name: 'dep-b', version: '1.0.0', dependencies: { 'dep-c': '^1.0.0' } }),\n    );\n    registry.register(\n      makeManifest({\n        name: 'dep-a',\n        version: '1.0.0',\n        dependencies: { 'dep-b': '^1.0.0' },\n      }),\n    );\n\n    expect(deps.detectCycles('dep-a', registry)).toBeNull();\n  });\n\n  // ---- topologicalSort ----\n\n  it('should produce a topological order of dependencies', () => {\n    registry.register(makeManifest({ name: 'dep-c', version: '1.0.0' }));\n    registry.register(\n      makeManifest({ name: 'dep-b', version: '1.0.0', dependencies: { 'dep-c': '^1.0.0' } }),\n    );\n    registry.register(\n      makeManifest({\n        name: 'dep-a',\n        version: '1.0.0',\n        dependencies: { 'dep-b': '^1.0.0' },\n      }),\n    );\n\n    const sorted = deps.topologicalSort('dep-a', registry);\n    // dep-c has no deps, dep-b depends on dep-c, dep-a depends on dep-b\n    expect(sorted).toEqual(['dep-c', 'dep-b', 'dep-a']);\n  });\n\n  it('should throw on topological sort when a cycle exists', () => {\n    registry.register(\n      makeManifest({\n        name: 'dep-a',\n        version: '1.0.0',\n        dependencies: { 'dep-b': '^1.0.0' },\n      }),\n    );\n    registry.register(\n      makeManifest({\n        name: 'dep-b',\n        version: '1.0.0',\n        dependencies: { 'dep-a': '^1.0.0' },\n      }),\n    );\n\n    expect(() => deps.topologicalSort('dep-a', registry)).toThrow(\n      /circular dependency/i,\n    );\n  });\n\n  // ---- flattenDependencies ----\n\n  it('should return a flat list of all transitive dependencies', () => {\n    registry.register(makeManifest({ name: 'dep-c', version: '1.0.0' }));\n    registry.register(\n      makeManifest({ name: 'dep-b', version: '1.0.0', dependencies: { 'dep-c': '^1.0.0' } }),\n    );\n    registry.register(\n      makeManifest({\n        name: 'dep-a',\n        version: '1.0.0',\n        dependencies: { 'dep-b': '^1.0.0' },\n      }),\n    );\n\n    const flat = deps.flattenDependencies('dep-a', registry);\n    expect(flat).toContain('dep-b');\n    expect(flat).toContain('dep-c');\n    expect(flat).not.toContain('dep-a');\n  });\n\n  // ---- hasCircularDependency ----\n\n  it('should return true when a cycle exists', () => {\n    registry.register(\n      makeManifest({\n        name: 'dep-a',\n        version: '1.0.0',\n        dependencies: { 'dep-b': '^1.0.0' },\n      }),\n    );\n    registry.register(\n      makeManifest({\n        name: 'dep-b',\n        version: '1.0.0',\n        dependencies: { 'dep-a': '^1.0.0' },\n      }),\n    );\n\n    expect(deps.hasCircularDependency('dep-a', registry)).toBe(true);\n  });\n\n  it('should return false when no cycle exists', () => {\n    registry.register(makeManifest({ name: 'dep-b', version: '1.0.0' }));\n    registry.register(\n      makeManifest({\n        name: 'dep-a',\n        version: '1.0.0',\n        dependencies: { 'dep-b': '^1.0.0' },\n      }),\n    );\n\n    expect(deps.hasCircularDependency('dep-a', registry)).toBe(false);\n  });\n});\n\n// ===========================================================================\n// Integration\n// ===========================================================================\n\ndescribe('Integration', () => {\n  // ---- createMarketplace returns services ----\n\n  it('createMarketplace returns all five services and installPlugin', () => {\n    const mp = createMarketplace() as {\n      registry: PluginRegistry;\n      resolver: VersionResolver;\n      runner: SandboxedRunner;\n      reviews: ReviewSystem;\n      deps: DependencyGraphAnalyzer;\n      installPlugin: (m: PluginManifest) => Promise<unknown>;\n    };\n\n    expect(mp.registry).toBeInstanceOf(PluginRegistry);\n    expect(mp.resolver).toBeInstanceOf(VersionResolver);\n    expect(mp.runner).toBeInstanceOf(SandboxedRunner);\n    expect(mp.reviews).toBeInstanceOf(ReviewSystem);\n    expect(mp.deps).toBeInstanceOf(DependencyGraphAnalyzer);\n    expect(typeof mp.installPlugin).toBe('function');\n  });\n\n  // ---- installPlug