+++ b/src/resolver/index.ts
@@ -0,0 +1,37 @@
+import semver from 'semver';
+import {
+  type ResolverService,
+  type VersionConstraint,
+  type ResolvedVersion,
+} from '../types.js';
+
+export class VersionResolver implements ResolverService {
+  satisfies(version: string, range: string): boolean {
+    return semver.satisfies(version, range);
+  }
+
+  maxSatisfying(versions: string[], range: string): string | null {
+    return semver.maxSatisfying(versions, range);
+  }
+
+  validRange(range: string): boolean {
+    return semver.validRange(range) !== null;
+  }
+
+  resolve(
+    constraints: VersionConstraint[],
+    available: Record<string, string[]>,
+  ): ResolvedVersion[] {
+    return constraints.map(({ name, range }) => {
+      const versions = available[name];
+      if (!versions) {
+        throw new Error(`Cannot satisfy constraint: ${name}@${range}`);
+      }
+      const version = semver.maxSatisfying(versions, range);
+      if (version === null) {
+        throw new Error(`Cannot satisfy constraint: ${name}@${range}`);
+      }
+      return { name, version, satisfies: range };
+    });
+  }
+}
