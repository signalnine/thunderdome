st r1 = marketplace.installPlugin(p1, 'result = \"first\";');\n    const r2 = marketplace.installPlugin(p2, 'result = \"second\";');\n\n    expect(r1.success).toBe(true);\n    expect(r1.execution!.output).toBe('first');\n    expect(r2.success).toBe(true);\n    expect(r2.execution!.output).toBe('second');\n  });\n});\n","structuredPatch":[{"oldStart":88,"oldLines":6,"newStart":88,"newLines":7,"lines":["       ...samplePlugin,","       name: 'other',","       description: 'Something else',","+      author: 'someone-else',","       version: '1.0.0',","     });"," "]}],"userModified":false,"replaceAll":false}}
