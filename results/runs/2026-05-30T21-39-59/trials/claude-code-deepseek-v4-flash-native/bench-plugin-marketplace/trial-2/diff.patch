@@ -0,0 +1,126 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from './types.js';
+
+export class ReviewServiceImpl implements ReviewService {
+  private db: Database.Database;
+
+  constructor(db?: Database.Database) {
+    if (db) {
+      this.db = db;
+    } else {
+      this.db = new Database(':memory:');
+    }
+    this.initSchema();
+  }
+
+  private initSchema(): void {
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS reviews (
+        id INTEGER PRIMARY KEY AUTOINCREMENT,
+        pluginName TEXT NOT NULL,
+        pluginVersion TEXT NOT NULL,
+        userId TEXT NOT NULL,
+        rating INTEGER NOT NULL CHECK (rating >= 1 AND rating <= 5),
+        comment TEXT NOT NULL DEFAULT '',
+        flagged INTEGER NOT NULL DEFAULT 0,
+        createdAt TEXT NOT NULL DEFAULT (datetime('now'))
+      )
+    `);
+
+    this.db.exec(`
+      CREATE INDEX IF NOT EXISTS idx_reviews_plugin ON reviews(pluginName)
+    `);
+
+    this.db.exec(`
+      CREATE INDEX IF NOT EXISTS idx_reviews_user ON reviews(userId)
+    `);
+
+    this.db.exec(`
+      CREATE INDEX IF NOT EXISTS idx_reviews_flagged ON reviews(flagged)
+    `);
+  }
+
+  addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+    const stmt = this.db.prepare(`
+      INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment)
+      VALUES (?, ?, ?, ?, ?)
+    `);
+    const result = stmt.run(
+      review.pluginName,
+      review.pluginVersion,
+      review.userId,
+      review.rating,
+      review.comment,
+    );
+
+    const row = this.db.prepare('SELECT * FROM reviews WHERE id = ?').get(
+      result.lastInsertRowid,
+    ) as Record<string, unknown>;
+
+    return this.rowToReview(row);
+  }
+
+  getReviews(pluginName: string): Review[] {
+    const rows = this.db.prepare(
+      'SELECT * FROM reviews WHERE pluginName = ? ORDER BY createdAt DESC',
+    ).all(pluginName) as Record<string, unknown>[];
+
+    return rows.map((r) => this.rowToReview(r));
+  }
+
+  getAverageRating(pluginName: string): number {
+    const row = this.db.prepare(
+      `SELECT AVG(CAST(rating AS REAL)) as avg
+       FROM reviews
+       WHERE pluginName = ? AND flagged = 0`,
+    ).get(pluginName) as { avg: number | null };
+
+    return row.avg ?? 0;
+  }
+
+  flagReview(reviewId: number): void {
+    this.db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?').run(reviewId);
+  }
+
+  getFlaggedReviews(): Review[] {
+    const rows = this.db.prepare(
+      'SELECT * FROM reviews WHERE flagged = 1 ORDER BY createdAt DESC',
+    ).all() as Record<string, unknown>[];
+
+    return rows.map((r) => this.rowToReview(r));
+  }
+
+  removeReview(reviewId: number): boolean {
+    const result = this.db.prepare('DELETE FROM reviews WHERE id = ?').run(reviewId);
+    return result.changes > 0;
+  }
+
+  getReviewsByUser(userId: string): Review[] {
+    const rows = this.db.prepare(
+      'SELECT * FROM reviews WHERE userId = ? ORDER BY createdAt DESC',
+    ).all(userId) as Record<string, unknown>[];
+
+    return rows.map((r) => this.rowToReview(r));
+  }
+
+  getReviewCount(pluginName: string): number {
+    const row = this.db.prepare(
+      'SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?',
+    ).get(pluginName) as { count: number };
+
+    return row.count;
+  }
+
+  private rowToReview(row: Record<string, unknown>): Review {
+    return {
+      id: row.id as number,
+      pluginName: row.pluginName as string,
+      pluginVersion: row.pluginVersion as string,
+      userId: row.userId as string,
+      rating: row.rating as number,
+      comment: row.comment as string,
+      flagged: (row.flagged as number) === 1,
+      createdAt: row.createdAt as string,
+    };
+  }
+}
