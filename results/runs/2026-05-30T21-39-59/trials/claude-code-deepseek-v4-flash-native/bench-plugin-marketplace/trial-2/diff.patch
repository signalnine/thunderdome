eImpl } from './runner.js';\nimport { ReviewServiceImpl } from './reviews.js';\nimport { DepsServiceImpl } from './deps.js';\n\nexport interface InstallResult {\n  success: boolean;\n  resolvedDependencies: ResolvedVersion[];\n  execution: SandboxResult | null;\n  error?: string;\n}\n\nexport interface Marketplace {\n  registry: RegistryService;\n  resolver: ResolverService;\n  runner: RunnerService;\n  reviews: ReviewService;\n  deps: DepsService;\n  installPlugin(manifest: PluginManifest, code: string, timeoutMs?: number): InstallResult;\n}\n\nexport function createMarketplace(db?: Database.Database): Marketplace {\n  const registry = new RegistryServiceImpl(db);\n  const resolver = new ResolverServiceImpl();\n  const runner = new RunnerServiceImpl();\n  const reviews = new ReviewServiceImpl(db);\n  const deps = new DepsServiceImpl();\n\n  function installPlugin(\n    manifest: PluginManifest,\n    code: string,\n    timeoutMs?: number,\n  ): InstallResult {\n    // Step 1: Validate required fields\n    if (!manifest.name || manifest.name.trim() === '') {\n      return {\n        success: false,\n        resolvedDependencies: [],\n        execution: null,\n        error: 'Plugin name is required',\n      };\n    }\n    if (!manifest.version || manifest.version.trim() === '') {\n      return {\n        success: false,\n        resolvedDependencies: [],\n        execution: null,\n        error: 'Plugin version is required',\n      };\n    }\n    if (!manifest.entryPoint || manifest.entryPoint.trim() === '') {\n      return {\n        success: false,\n        resolvedDependencies: [],\n        execution: null,\n        error: 'Plugin entryPoint is required',\n      };\n    }\n\n    // Step 2: Register the plugin\n    registry.register(manifest);\n\n    // Step 3: Resolve dependency versions\n    const depNames = Object.keys(manifest.dependencies);\n    let resolvedDependencies: ResolvedVersion[] = [];\n\n    if (depNames.length > 0) {\n      const constraints: VersionConstraint[] = depNames.map((depName) => ({\n        name: depName,\n        range: manifest.dependencies[depName],\n      }));\n\n      const available: Record<string, string[]> = {};\n      for (const depName of depNames) {\n        available[depName] = registry.listVersions(depName);\n      }\n\n      resolvedDependencies = resolver.resolve(constraints, available);\n    }\n\n    // Step 4: Check for circular dependencies\n    const hasCycles = deps.hasCircularDependency(manifest.name, registry);\n    if (hasCycles) {\n      return {\n        success: false,\n        resolvedDependencies,\n        execution: null,\n        error: 'Circular dependency detected',\n      };\n    }\n\n    // Step 5: Execute the entry point in the sandbox\n    const executionPromise = timeoutMs !== undefined\n      ? runner.executeWithTimeout(code, timeoutMs)\n      : runner.execute(code);\n\n    // We treat execution as synchronous since RunnerServiceImpl's execute\n    // methods use await internally and our SandboxResult is just a structured value.\n    // Use a synchronous trick with a completed promise.\n    let executionResult: SandboxResult;\n    executionPromise.then((result) => {\n      executionResult = result;\n    }).catch((err) => {\n      executionResult = {\n        success: false,\n        output: null,\n        duration: 0,\n        memoryUsed: 0,\n        error: err instanceof Error ? err.message : String(err),\n      };\n    });\n\n    // Since we're in a synchronous context and execute() is async,\n    // we need to wait for the result. We'll use a simple polling approach\n    // with a small timeout or run the vm synchronously.\n    //\n    // Actually, let's rethink this: vm execution is synchronous by nature.\n    // The RunnerServiceImpl wraps it in async but the underlying vm.runInContext\n    // is synchronous. The returned promise resolves immediately.\n    // So we can just await it... but this function is synchronous.\n    //\n    // Let's change approach: use a synchronous execution wrapper.\n    try {\n      const { executeCodeSync } = createSyncRunner();\n      executionResult = executeCodeSync(code, timeoutMs);\n    } catch (err) {\n      executionResult = {\n        success: false,\n        output: null,\n        duration: 0,\n        memoryUsed: 0,\n        error: err instanceof Error ? err.message : String(err),\n      };\n    }\n\n    return {\n      success: executionResult.success,\n      resolvedDependencies,\n      execution: executionResult,\n      error: executionResult.error,\n    };\n  }\n\n  function createSyncRunner() {\n    return {\n      executeCodeSync(code: string, timeoutMs?: number): SandboxResult {\n        // We use RunnerServiceImpl internally but we'll directly\n        // use the vm module synchronously since the installPlugin\n        // workflow must be synchronous.\n        const actualTimeout = timeoutMs ?? 5000;\n        // Delegate to the async method and wait (it's actually sync underneath)\n        const promise = runner.executeWithTimeout(code, actualTimeout);\n        // The promise resolves synchronously because vm execution is synchronous\n        // But to be safe, we use a synchronous wait\n        let result: SandboxResult | undefined;\n        promise.then((r) => { result = r; }).catch(() => { /* ignore */ });\n        // Busy-wait for up to 10ms (the promise should already be resolved)\n        const deadline = Date.now() + 10;\n        while (!result && Date.now() < deadline) {\n          // spin\n        }\n        if (!result) {\n          // Fallback: run directly with vm\n          const startMemory = process.memoryUsage().heapUsed;\n          const startTime = performance.now();\n          try {\n            const vm = require('vm');\n            const sandbox: Record<string, unknown> = {\n              console: Object.freeze({\n                log: (...args: unknown[]) => console.log(...args),\n                error: (...args: unknown[]) => console.error(...args),\n                warn: (...args: unknown[]) => console.warn(...args),\n                info: (...args: unknown[]) => console.info(...args),\n              }),\n            };\n            const ctx = vm.createContext(sandbox);\n            const script = new vm.Script(code);\n            script.runInContext(ctx, { timeout: actualTimeout, breakOnSigint: true });\n            const duration = Math.round((performance.now() - startTime) * 100) / 100;\n            const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - startMemory);\n            return {\n              success: true,\n              output: sandbox.result ?? sandbox.output ?? null,\n              duration,\n              memoryUsed,\n            };\n          } catch (err) {\n            const duration = Math.round((performance.now() - startTime) * 100) / 100;\n            const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - startMemory);\n            return {\n              success: false,\n              output: null,\n              duration,\n              memoryUsed,\n              error: err instanceof Error ? err.message : String(err),\n            };\n          }\n        }\n        return result;\n      },\n    };\n  }\n\n  return {\n    registry,\n    resolver,\n    runner,\n    reviews,\n    deps,\n    installPlugin,\n  };\n}\n","userModified":false}}
