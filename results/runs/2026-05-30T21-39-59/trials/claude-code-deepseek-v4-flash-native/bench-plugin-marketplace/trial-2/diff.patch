rieved!.version).toBe('1.0.0');\n    expect(retrieved!.description).toBe('A test plugin');\n    expect(retrieved!.author).toBe('tester');\n    expect(retrieved!.entryPoint).toBe('index.js');\n    expect(retrieved!.dependencies).toEqual({ 'dep-a': '^1.0.0' });\n    expect(retrieved!.permissions).toEqual(['read']);\n  });\n\n  it('should return null for non-existent plugin', () => {\n    expect(registry.get('non-existent')).toBeNull();\n  });\n\n  it('should get a specific version', () => {\n    registry.register(samplePlugin);\n    const retrieved = registry.getVersion('test-plugin', '1.0.0');\n    expect(retrieved).not.toBeNull();\n    expect(retrieved!.version).toBe('1.0.0');\n  });\n\n  it('should return null for non-existent version', () => {\n    registry.register(samplePlugin);\n    expect(registry.getVersion('test-plugin', '2.0.0')).toBeNull();\n  });\n\n  it('should list all plugins', () => {\n    registry.register(samplePlugin);\n    registry.register({ ...samplePlugin, name: 'another-plugin', version: '1.0.0' });\n\n    const list = registry.list();\n    expect(list).toHaveLength(2);\n  });\n\n  it('should search plugins by name', () => {\n    registry.register(samplePlugin);\n    registry.register({\n      ...samplePlugin,\n      name: 'unrelated',\n      description: 'Something completely different',\n      version: '1.0.0',\n    });\n\n    const results = registry.search('test');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('test-plugin');\n  });\n\n  it('should search plugins by description', () => {\n    registry.register(samplePlugin);\n    registry.register({\n      ...samplePlugin,\n      name: 'other',\n      description: 'Something else',\n      version: '1.0.0',\n    });\n\n    const results = registry.search('test plugin');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('test-plugin');\n  });\n\n  it('should remove a specific version', () => {\n    registry.register(samplePlugin);\n    expect(registry.remove('test-plugin', '1.0.0')).toBe(true);\n    expect(registry.get('test-plugin')).toBeNull();\n  });\n\n  it('should return false when removing non-existent version', () => {\n    expect(registry.remove('test-plugin', '1.0.0')).toBe(false);\n  });\n\n  it('should list versions', () => {\n    registry.register(samplePlugin);\n    registry.register({ ...samplePlugin, version: '2.0.0' });\n\n    const versions = registry.listVersions('test-plugin');\n    expect(versions).toHaveLength(2);\n    expect(versions).toContain('1.0.0');\n    expect(versions).toContain('2.0.0');\n  });\n\n  it('should update a plugin', () => {\n    registry.register(samplePlugin);\n    registry.update('test-plugin', '1.0.0', { description: 'Updated description' });\n\n    const retrieved = registry.getVersion('test-plugin', '1.0.0');\n    expect(retrieved!.description).toBe('Updated description');\n    expect(retrieved!.author).toBe('tester'); // unchanged\n  });\n\n  it('should register multiple versions of the same plugin', () => {\n    registry.register(samplePlugin);\n    registry.register({ ...samplePlugin, version: '2.0.0' });\n\n    expect(registry.listVersions('test-plugin')).toHaveLength(2);\n  });\n});\n\n// ===========================================\n// Version Resolver\n// ===========================================\ndescribe('VersionResolver', () => {\n  let resolver: ResolverServiceImpl;\n\n  beforeEach(() => {\n    resolver = new ResolverServiceImpl();\n  });\n\n  it('should resolve valid constraints', () => {\n    const constraints: VersionConstraint[] = [{ name: 'pkg-a', range: '^1.0.0' }];\n    const available: Record<string, string[]> = { 'pkg-a': ['1.0.0', '1.2.0', '2.0.0'] };\n    const result = resolver.resolve(constraints, available);\n\n    expect(result).toHaveLength(1);\n    expect(result[0].name).toBe('pkg-a');\n    expect(result[0].version).toBe('1.2.0');\n    expect(result[0].satisfies).toBe('^1.0.0');\n  });\n\n  it('should return empty when no versions satisfy', () => {\n    const constraints: VersionConstraint[] = [{ name: 'pkg-a', range: '^3.0.0' }];\n    const available: Record<string, string[]> = { 'pkg-a': ['1.0.0', '2.0.0'] };\n    const result = resolver.resolve(constraints, available);\n\n    expect(result).toHaveLength(0);\n  });\n\n  it('should resolve multiple constraints', () => {\n    const constraints: VersionConstraint[] = [\n      { name: 'pkg-a', range: '^1.0.0' },\n      { name: 'pkg-b', range: '~2.0.0' },\n    ];\n    const available: Record<string, string[]> = {\n      'pkg-a': ['1.0.0', '1.5.0'],\n      'pkg-b': ['2.0.0', '2.1.0'],\n    };\n    const result = resolver.resolve(constraints, available);\n\n    expect(result).toHaveLength(2);\n    expect(result.find((r) => r.name === 'pkg-a')!.version).toBe('1.5.0');\n    expect(result.find((r) => r.name === 'pkg-b')!.version).toBe('2.0.0');\n  });\n\n  it('should check satisfies', () => {\n    expect(resolver.satisfies('1.2.3', '^1.0.0')).toBe(true);\n    expect(resolver.satisfies('2.0.0', '^1.0.0')).toBe(false);\n  });\n\n  it('should find max satisfying version', () => {\n    expect(resolver.maxSatisfying(['1.0.0', '1.5.0', '1.9.0'], '^1.0.0')).toBe('1.9.0');\n    expect(resolver.maxSatisfying(['2.0.0', '3.0.0'], '^1.0.0')).toBeNull();\n  });\n\n  it('should validate ranges', () => {\n    expect(resolver.validRange('^1.0.0')).toBe(true);\n    expect(resolver.validRange('>=1.0.0 <2.0.0')).toBe(true);\n    expect(resolver.validRange('not-a-range')).toBe(false);\n  });\n\n  it('should resolve with empty constraints', () => {\n    expect(resolver.resolve([], {})).toEqual([]);\n  });\n});\n\n// ===========================================\n// Sandboxed Runner\n// ===========================================\ndescribe('SandboxedRunner', () => {\n  let runner: RunnerServiceImpl;\n\n  beforeEach(() => {\n    runner = new RunnerServiceImpl(5000);\n  });\n\n  it('should execute simple code', async () => {\n    const result = await runner.execute('const x = 1 + 1;');\n    expect(result.success).toBe(true);\n    expect(result.error).toBeUndefined();\n    expect(result.duration).toBeGreaterThanOrEqual(0);\n  });\n\n  it('should execute code with context', async () => {\n    const result = await runner.execute('result = x + y;', { x: 2, y: 3 });\n    expect(result.success).toBe(true);\n    expect(result.output).toBe(5);\n  });\n\n  it('should capture thrown errors', async () => {\n    const result = await runner.execute('throw new Error(\"oops\");');\n    expect(result.success).toBe(false);\n    expect(result.error).toContain('oops');\n  });\n\n  it('should capture syntax errors', async () => {\n    const result = await runner.execute('const x = ;');\n    expect(result.success).toBe(false);\n    expect(result.error).toBeDefined();\n  });\n\n  it('should enforce timeout', async () => {\n    const start = performance.now();\n    const result = await runner.executeWithTimeout(\n      'while(true) {}',\n      50,\n    );\n    const elapsed = performance.now() - start;\n\n    expect(result.success).toBe(false);\n    expect(result.error).toMatch(/timeout/i);\n    expect(elapsed).toBeLessThan(5000);\n  });\n\n  it('should expose console.log in sandbox', async () => {\n    const result = await runner.execute(\n      'console.log(\"hello\"); result = \"ok\";',\n    );\n    expect(result.success).toBe(true);\n    expect(result.output).toBe('ok');\n  });\n\n  it('should not have require in sandbox', async () => {\n    const result = await runner.execute(\n      'result = typeof require;',\n    );\n    expect(result.success).toBe(true);\n    expect(result.output).toBe('undefined');\n  });\n\n  it('should not have process in sandbox', async () => {\n    const result = await runner.execute(\n      'result = typeof process;',\n    );\n    expect(result.success).toBe(true);\n    expect(result.output).toBe('undefined');\n  });\n\n  it('should measure memory usage', async () => {\n    const result = await runner.execute('const a = []; for (let i = 0; i < 1000; i++) a.push(i);');\n    expect(result.success).toBe(true);\n    expect(result.memoryUsed).toBeGreaterThanOrEqual(0);\n  });\n});\n\n// ===========================================\n// Review System\n// ===========================================\ndescribe('ReviewSystem', () => {\n  let reviews: ReviewServiceImpl;\n  let db: Database.Database;\n\n  beforeEach(() => {\n    db = new Database(':memory:');\n    reviews = new ReviewServiceImpl(db);\n  });\n\n  it('should add a review', () => {\n    const review = reviews.addReview({\n      pluginName: 'test-plugin',\n      pluginVersion: '1.0.0',\n      userId: 'user1',\n      rating: 5,\n      comment: 'Great plugin!',\n    });\n\n    expect(review.id).toBeGreaterThan(0);\n    expect(review.pluginName).toBe('test-plugin');\n    expect(review.rating).toBe(5);\n    expect(review.flagged).toBe(false);\n    expect(review.createdAt).toBeDefined();\n  });\n\n  it('should get reviews by plugin', () => {\n    reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'nice' });\n    reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'u2', rating: 4, comment: 'good' });\n    reviews.addReview({ pluginName: 'p2', pluginVersion: '1.0.0', userId: 'u1', rating: 3, comment: 'ok' });\n\n    const p1Reviews = reviews.getReviews('p1');\n    expect(p1Reviews).toHaveLength(2);\n\n    const p2Reviews = reviews.getReviews('p2');\n    expect(p2Reviews).toHaveLength(1);\n  });\n\n  it('should get empty array for plugin with no reviews', () => {\n    expect(reviews.getReviews('nonexistent')).toEqual([]);\n  });\n\n  it('should compute average rating excluding flagged reviews', () => {\n    const r1 = reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'great' });\n    reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'u2', rating: 3, comment: 'ok' });\n    reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'u3', rating: 1, comment: 'bad' });\n\n    // Average of all three: (5+3+1)/3 = 3\n    expect(reviews.getAverageRating('p1')).toBe(3);\n\n    // Flag the bad review\n    reviews.flagReview(r1.id);\n\n    // Average excluding flagged: (3+1)/2 = 2\n    expect(reviews.getAverageRating('p1')).toBe(2);\n  });\n\n  it('should return 0 average when no unflagged reviews', () => {\n    const r = reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'great' });\n    reviews.flagReview(r.id);\n    expect(reviews.getAverageRating('p1')).toBe(0);\n  });\n\n  it('should return 0 average when no reviews exist', () => {\n    expect(reviews.getAverageRating('p1')).toBe(0);\n  });\n\n  it('should flag a review', () => {\n    const review = reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'u1', rating: 2, comment: 'bad' });\n    expect(review.flagged).toBe(false);\n\n    reviews.flagReview(review.id);\n    const flagged = reviews.getFlaggedReviews();\n    expect(flagged).toHaveLength(1);\n    expect(flagged[0].id).toBe(review.id);\n    expect(flagged[0].flagged).toBe(true);\n  });\n\n  it('should get flagged reviews', () => {\n    reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'good' });\n    const r2 = reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'u2', rating: 1, comment: 'bad' });\n    reviews.flagReview(r2.id);\n\n    const flagged = reviews.getFlaggedReviews();\n    expect(flagged).toHaveLength(1);\n    expect(flagged[0].id).toBe(r2.id);\n  });\n\n  it('should remove a review', () => {\n    const review = reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'nice' });\n    expect(reviews.removeReview(review.id)).toBe(true);\n    expect(reviews.getReviews('p1')).toHaveLength(0);\n  });\n\n  it('should return false when removing non-existent review', () => {\n    expect(reviews.remove