index 0000000..4069f25
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,125 @@
+import Database from 'better-sqlite3';
+import type {
+  PluginManifest,
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+  ResolvedVersion,
+  VersionConstraint,
+} from './types.js';
+import { RegistryServiceImpl } from './registry.js';
+import { ResolverServiceImpl } from './resolver.js';
+import { RunnerServiceImpl, executeCodeSync } from './runner.js';
+import { ReviewServiceImpl } from './reviews.js';
+import { DepsServiceImpl } from './deps.js';
+
+export interface InstallResult {
+  success: boolean;
+  resolvedDependencies: ResolvedVersion[];
+  execution: SandboxResult | null;
+  error?: string;
+}
+
+// Re-export SandboxResult locally for the InstallResult type
+import type { SandboxResult } from './types.js';
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest, code: string, timeoutMs?: number): InstallResult;
+}
+
+export function createMarketplace(db?: Database.Database): Marketplace {
+  const registry = new RegistryServiceImpl(db);
+  const resolver = new ResolverServiceImpl();
+  const runner = new RunnerServiceImpl();
+  const reviews = new ReviewServiceImpl(db);
+  const deps = new DepsServiceImpl();
+
+  function validateManifest(manifest: PluginManifest): string | null {
+    if (!manifest.name || manifest.name.trim() === '') {
+      return 'Plugin name is required';
+    }
+    if (!manifest.version || manifest.version.trim() === '') {
+      return 'Plugin version is required';
+    }
+    if (!manifest.entryPoint || manifest.entryPoint.trim() === '') {
+      return 'Plugin entryPoint is required';
+    }
+    return null;
+  }
+
+  function resolveDependencies(manifest: PluginManifest): ResolvedVersion[] {
+    const depNames = Object.keys(manifest.dependencies);
+    if (depNames.length === 0) return [];
+
+    const constraints: VersionConstraint[] = depNames.map((depName) => ({
+      name: depName,
+      range: manifest.dependencies[depName],
+    }));
+
+    const available: Record<string, string[]> = {};
+    for (const depName of depNames) {
+      available[depName] = registry.listVersions(depName);
+    }
+
+    return resolver.resolve(constraints, available);
+  }
+
+  function installPlugin(
+    manifest: PluginManifest,
+    code: string,
+    timeoutMs?: number,
+  ): InstallResult {
+    // Step 1: Validate required fields
+    const validationError = validateManifest(manifest);
+    if (validationError) {
+      return {
+        success: false,
+        resolvedDependencies: [],
+        execution: null,
+        error: validationError,
+      };
+    }
+
+    // Step 2: Register the plugin in the catalog
+    registry.register(manifest);
+
+    // Step 3: Resolve dependency versions against what's available
+    const resolvedDependencies = resolveDependencies(manifest);
+
+    // Step 4: Check for circular dependencies
+    if (deps.hasCircularDependency(manifest.name, registry)) {
+      return {
+        success: false,
+        resolvedDependencies,
+        execution: null,
+        error: 'Circular dependency detected',
+      };
+    }
+
+    // Step 5: Execute the plugin's entry point in the sandbox
+    const execution = executeCodeSync(code, timeoutMs ?? 5000);
+
+    return {
+      success: execution.success,
+      resolvedDependencies,
+      execution,
+      error: execution.error,
+    };
+  }
+
+  return {
+    registry,
+    resolver,
+    runner,
+    reviews,
+    deps,
+    installPlugin,
+  };
+}
diff --git a/src/registry.ts b/src/registry.ts
new file mode 100644
index 0000000..d93ffee
--- /dev/null
+++ b/src/registry.ts
@@ -0,0 +1,134 @@
+import Database from 'better-sqlite3';
+import type { PluginManifest, RegistryService } from './types.js';
+
+export class RegistryServiceImpl implements RegistryService {
+  private db: Database.Database;
+
+  constructor(db?: Database.Database) {
+    if (db) {
+      this.db = db;
+    } else {
+      this.db = new Database(':memory:');
+    }
+    this.initSchema();
+  }
+
+  private initSchema(): void {
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS plugins (
+        name TEXT NOT NULL,
+        version TEXT NOT NULL,
+        description TEXT NOT NULL DEFAULT '',
+        author TEXT NOT NULL DEFAULT '',
+        entryPoint TEXT NOT NULL DEFAULT '',
+        dependencies TEXT NOT NULL DEFAULT '{}',
+        permissions TEXT NOT NULL DEFAULT '[]',
+        createdAt TEXT NOT NULL DEFAULT (datetime('now')),
+        PRIMARY KEY (name, version)
+      )
+    `);
+  }
+
+  register(manifest: PluginManifest): void {
+    const stmt = this.db.prepare(`
+      INSERT OR REPLACE INTO plugins (name, version, description, author, entryPoint, dependencies, permissions, createdAt)
+      VALUES (?, ?, ?, ?, ?, ?, ?, datetime('now'))
+    `);
+    stmt.run(
+      manifest.name,
+      manifest.version,
+      manifest.description,
+      manifest.author,
+      manifest.entryPoint,
+      JSON.stringify(manifest.dependencies),
+      JSON.stringify(manifest.permissions),
+    );
+  }
+
+  get(name: string): PluginManifest | null {
+    return this.getVersion(name, this.latestVersion(name));
+  }
+
+  getVersion(name: string, version: string): PluginManifest | null {
+    const row = this.db.prepare(
+      'SELECT * FROM plugins WHERE name = ? AND version = ?',
+    ).get(name, version) as Record<string, unknown> | undefined;
+
+    if (!row) return null;
+
+    return this.rowToManifest(row);
+  }
+
+  list(): PluginManifest[] {
+    const rows = this.db.prepare(
+      'SELECT * FROM plugins ORDER BY name, version',
+    ).all() as Record<string, unknown>[];
+
+    return rows.map((r) => this.rowToManifest(r));
+  }
+
+  search(query: string): PluginManifest[] {
+    const pattern = `%${query}%`;
+    const rows = this.db.prepare(
+      `SELECT * FROM plugins
+       WHERE name LIKE ? OR description LIKE ? OR author LIKE ?
+       ORDER BY name, version`,
+    ).all(pattern, pattern, pattern) as Record<string, unknown>[];
+
+    return rows.map((r) => this.rowToManifest(r));
+  }
+
+  remove(name: string, version: string): boolean {
+    const result = this.db.prepare(
+      'DELETE FROM plugins WHERE name = ? AND version = ?',
+    ).run(name, version);
+
+    return result.changes > 0;
+  }
+
+  listVersions(name: string): string[] {
+    const rows = this.db.prepare(
+      'SELECT version FROM plugins WHERE name = ? ORDER BY version',
+    ).all(name) as { version: string }[];
+
+    return rows.map((r) => r.version);
+  }
+
+  update(name: string, version: string, updates: Partial<PluginManifest>): void {
+    const existing = this.getVersion(name, version);
+    if (!existing) return;
+
+    const merged = { ...existing, ...updates };
+    const stmt = this.db.prepare(`
+      UPDATE plugins
+      SET description = ?, author = ?, entryPoint = ?, dependencies = ?, permissions = ?
+      WHERE name = ? AND version = ?
+    `);
+    stmt.run(
+      merged.description,
+      merged.author,
+      merged.entryPoint,
+      JSON.stringify(merged.dependencies),
+      JSON.stringify(merged.permissions),
+      name,
+      version,
+    );
+  }
+
+  private latestVersion(name: string): string {
+    const rows = this.listVersions(name);
+    return rows.length > 0 ? rows[rows.length - 1] : '';
+  }
+
+  private rowToManifest(row: Record<string, unknown>): PluginManifest {
