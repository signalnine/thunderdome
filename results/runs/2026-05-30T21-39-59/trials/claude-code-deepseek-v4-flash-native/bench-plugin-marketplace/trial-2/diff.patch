istry: RegistryService,\n    visited: Set<string>,\n    result: string[],\n  ): void {\n    const manifest = registry.get(name);\n    if (!manifest) return;\n\n    const deps = Object.keys(manifest.dependencies);\n    for (const dep of deps) {\n      if (!visited.has(dep)) {\n        visited.add(dep);\n        result.push(dep);\n        this.flattenRec(dep, registry, visited, result);\n      }\n    }\n  }\n\n  hasCircularDependency(name: string, registry: RegistryService): boolean {\n    const cycles = this.detectCycles(name, registry);\n    return cycles !== null && cycles.length > 0;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":154,"cache_creation_input_tokens":0,"cache_read_input_tokens":32128,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"35b19cb4-139f-40a8-830c-f8ffdca3fd65","uuid":"ab468b16-7b6e-4e52-8b6b-957343c5bd07"}
