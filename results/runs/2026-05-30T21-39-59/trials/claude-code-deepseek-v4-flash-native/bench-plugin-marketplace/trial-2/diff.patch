lt = 1;');\n    expect(result.success).toBe(false);\n    expect(result.error).toContain('Circular');\n  });\n\n  it('should capture sandbox execution errors in install result', () => {\n    const manifest: PluginManifest = {\n      name: 'broken',\n      version: '1.0.0',\n      description: '',\n      author: '',\n      entryPoint: 'broken.js',\n      dependencies: {},\n      permissions: [],\n    };\n\n    const result = marketplace.installPlugin(manifest, 'throw new Error(\"broken code\");');\n    expect(result.success).toBe(false);\n    expect(result.execution!.success).toBe(false);\n    expect(result.execution!.error).toContain('broken code');\n  });\n\n  it('should handle timeout in sandbox during install', () => {\n    const manifest: PluginManifest = {\n      name: 'hang',\n      version: '1.0.0',\n      description: '',\n      author: '',\n      entryPoint: 'hang.js',\n      dependencies: {},\n      permissions: [],\n    };\n\n    const result = marketplace.installPlugin(manifest, 'while(true) {}', 50);\n    expect(result.success).toBe(false);\n    expect(result.execution!.error).toMatch(/timed out/i);\n  });\n\n  it('should register plugin in the catalog during install', () => {\n    const manifest: PluginManifest = {\n      name: 'new-plugin',\n      version: '1.0.0',\n      description: 'Fresh plugin',\n      author: 'dev',\n      entryPoint: 'main.js',\n      dependencies: {},\n      permissions: [],\n    };\n\n    marketplace.installPlugin(manifest, 'result = \"ok\";');\n    expect(marketplace.registry.get('new-plugin')).not.toBeNull();\n  });\n\n  it('should support multiple installs of different plugins', () => {\n    const p1: PluginManifest = {\n      name: 'p1', version: '1.0.0', description: '', author: '',\n      entryPoint: 'p1.js', dependencies: {}, permissions: [],\n    };\n    const p2: PluginManifest = {\n      name: 'p2', version: '1.0.0', description: '', author: '',\n      entryPoint: 'p2.js', dependencies: {}, permissions: [],\n    };\n