--- /dev/null
+++ b/src/deps.ts
@@ -0,0 +1,156 @@
+import type { DepsService, DependencyNode, RegistryService } from './types.js';
+
+export class DepsServiceImpl implements DepsService {
+  buildTree(name: string, registry: RegistryService): DependencyNode {
+    return this.buildTreeRec(name, registry, new Set<string>());
+  }
+
+  private buildTreeRec(
+    name: string,
+    registry: RegistryService,
+    visited: Set<string>,
+  ): DependencyNode {
+    const manifest = registry.get(name);
+    const node: DependencyNode = {
+      name,
+      version: manifest?.version ?? 'unknown',
+      dependencies: [],
+    };
+
+    if (!manifest) return node;
+
+    // Avoid infinite recursion — stop if we've seen this dep name before
+    // (circular deps are handled separately by detectCycles)
+    const depNames = Object.keys(manifest.dependencies);
+    for (const depName of depNames) {
+      if (visited.has(depName)) {
+        // Circular reference leaf
+        node.dependencies.push({
+          name: depName,
+          version: 'circular',
+          dependencies: [],
+        });
+      } else {
+        visited.add(depName);
+        node.dependencies.push(this.buildTreeRec(depName, registry, visited));
+      }
+    }
+
+    return node;
+  }
+
+  detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const cycles: string[][] = [];
+    const visited = new Set<string>();
+    const recStack = new Set<string>();
+    const pathMap = new Map<string, string[]>();
+
+    this.dfsFindCycles(name, registry, visited, recStack, pathMap, [], cycles);
+
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  private dfsFindCycles(
+    name: string,
+    registry: RegistryService,
+    visited: Set<string>,
+    recStack: Set<string>,
+    pathMap: Map<string, string[]>,
+    currentPath: string[],
+    cycles: string[][],
+  ): void {
+    const manifest = registry.get(name);
+    if (!manifest) return;
+
+    visited.add(name);
+    recStack.add(name);
+    pathMap.set(name, [...currentPath, name]);
+
+    const deps = Object.keys(manifest.dependencies);
+    for (const dep of deps) {
+      if (!recStack.has(dep)) {
+        this.dfsFindCycles(
+          dep,
+          registry,
+          visited,
+          recStack,
+          pathMap,
+          [...currentPath, name],
+          cycles,
+        );
+      } else if (recStack.has(dep)) {
+        // Found a cycle — trace from dep back through current path
+        const path = pathMap.get(name) ?? [];
+        const cycleStart = path.indexOf(dep);
+        if (cycleStart !== -1) {
+          const cycle = [...path.slice(cycleStart), dep];
+          cycles.push(cycle);
+        }
+      }
+    }
+
+    recStack.delete(name);
+  }
+
+  topologicalSort(name: string, registry: RegistryService): string[] {
+    const sorted: string[] = [];
+    const visited = new Set<string>();
+
+    this.topologicalSortRec(name, registry, visited, sorted);
+
+    return sorted;
+  }
+
+  private topologicalSortRec(
+    name: string,
+    registry: RegistryService,
+    visited: Set<string>,
+    sorted: string[],
+  ): void {
+    if (visited.has(name)) return;
+    visited.add(name);
+
+    const manifest = registry.get(name);
+    if (manifest) {
+      const deps = Object.keys(manifest.dependencies);
+      for (const dep of deps) {
+        this.topologicalSortRec(dep, registry, visited, sorted);
+      }
+    }
+
+    sorted.push(name);
+  }
+
+  flattenDependencies(name: string, registry: RegistryService): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>();
+
+    this.flattenRec(name, registry, visited, result);
+
+    return result;
+  }
+
+  private flattenRec(
+    name: string,
+    registry: RegistryService,
+    visited: Set<string>,
+    result: string[],
+  ): void {
+    const manifest = registry.get(name);
+    if (!manifest) return;
+
+    const deps = Object.keys(manifest.dependencies);
+    for (const dep of deps) {
+      if (!visited.has(dep)) {
+        visited.add(dep);
+        result.push(dep);
+        this.flattenRec(dep, registry, visited, result);
+      }
+    }
+  }
+
+  hasCircularDependency(name: string, registry: RegistryService): boolean {
+    const cycles = this.detectCycles(name, registry);
+    return cycles !== null && cycles.length > 0;
+  }
+}
