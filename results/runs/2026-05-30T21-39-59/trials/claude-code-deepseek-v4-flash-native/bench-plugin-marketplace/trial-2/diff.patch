@@ -0,0 +1,83 @@
+import vm from 'vm';
+import type { RunnerService, SandboxResult } from './types.js';
+
+const DEFAULT_TIMEOUT = 5000;
+
+/**
+ * Synchronously execute code in a V8 sandbox.
+ * This is the shared implementation used by both the async RunnerService
+ * and the synchronous installPlugin workflow.
+ */
+export function executeCodeSync(
+  code: string,
+  timeoutMs: number = DEFAULT_TIMEOUT,
+  context?: Record<string, unknown>,
+): SandboxResult {
+  const startTime = performance.now();
+  const startMemory = process.memoryUsage().heapUsed;
+
+  try {
+    const sandbox: Record<string, unknown> = {
+      ...(context ?? {}),
+      console: Object.freeze({
+        log: (...args: unknown[]) => console.log(...args),
+        error: (...args: unknown[]) => console.error(...args),
+        warn: (...args: unknown[]) => console.warn(...args),
+        info: (...args: unknown[]) => console.info(...args),
+      }),
+    };
+
+    const contextObject = vm.createContext(sandbox);
+    const script = new vm.Script(code);
+    script.runInContext(contextObject, {
+      timeout: timeoutMs,
+      breakOnSigint: true,
+    });
+
+    const duration = Math.round((performance.now() - startTime) * 100) / 100;
+    const endMemory = process.memoryUsage().heapUsed;
+    const memoryUsed = Math.max(0, endMemory - startMemory);
+
+    return {
+      success: true,
+      output: sandbox.result ?? sandbox.output ?? null,
+      duration,
+      memoryUsed,
+    };
+  } catch (err) {
+    const duration = Math.round((performance.now() - startTime) * 100) / 100;
+    const endMemory = process.memoryUsage().heapUsed;
+    const memoryUsed = Math.max(0, endMemory - startMemory);
+
+    return {
+      success: false,
+      output: null,
+      duration,
+      memoryUsed,
+      error: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+export class RunnerServiceImpl implements RunnerService {
+  private defaultTimeout: number;
+
+  constructor(defaultTimeout: number = DEFAULT_TIMEOUT) {
+    this.defaultTimeout = defaultTimeout;
+  }
+
+  async execute(
+    code: string,
+    context?: Record<string, unknown>,
+  ): Promise<SandboxResult> {
+    return this.executeWithTimeout(code, this.defaultTimeout, context);
+  }
+
+  async executeWithTimeout(
+    code: string,
+    timeoutMs: number,
+    context?: Record<string, unknown>,
+  ): Promise<SandboxResult> {
+    return executeCodeSync(code, timeoutMs, context);
+  }
+}
