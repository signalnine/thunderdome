ERE id = ? AND tenant_id = ?'\n      ).get(id, user.tenantId);\n\n      if (!existing) {\n        res.status(404).json({ error: 'Dashboard not found', code: 404 });\n        return;\n      }\n\n      // Widgets are deleted via ON DELETE CASCADE\n      db.prepare('DELETE FROM dashboards WHERE id = ?').run(id);\n\n      res.json({ success: true });\n    } catch (err) {\n      console.error('Delete dashboard error:', err);\n      res.status(500).json({ error: 'Internal server error', code: 500 });\n    }\n  });\n\n  return router;\n}\n","structuredPatch":[{"oldStart":11,"oldLines":7,"newStart":11,"newLines":6,"lines":["  */"," export function dashboardsRouter(db: Database.Database): Router {","   const router = Router();","-  router.use(authMiddleware(db));"," ","   // -----------------------------------------------------------------------","   // GET /dashboards  — list all dashboards for the tenant"]}],"userModified":false,"replaceAll":false}}
