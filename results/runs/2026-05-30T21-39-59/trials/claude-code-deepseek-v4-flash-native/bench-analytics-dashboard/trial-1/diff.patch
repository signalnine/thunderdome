vents')\n      .send({ name: 'test_event' });\n    expect(res.status).toBe(401);\n  });\n});\n\n// ==========================================================================\n// Query Engine\n// ==========================================================================\n\ndescribe('Query Engine', () => {\n  it('should count events by name', async () => {\n    const res = await request(app)\n      .post('/api/query/count')\n      .set('Authorization', `Bearer ${viewerToken}`)\n      .send({ eventName: 'page_view' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.count).toBeGreaterThanOrEqual(2);\n  });\n\n  it('should return 0 for unknown event', async () => {\n    const res = await request(app)\n      .post('/api/query/count')\n      .set('Authorization', `Bearer ${viewerToken}`)\n      .send({ eventName: 'nonexistent' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.count).toBe(0);\n  });\n\n  it('should enforce tenant isolation in count', async () => {\n    const res = await request(app)\n      .post('/api/query/count')\n      .set('Authorization', `Bearer ${adminToken}`)\n      .send({ eventName: 'page_view' });\n\n    expect(res.status).toBe(200);\n    // admin tenant has no events\n    expect(res.body.count).toBe(0);\n  });\n\n  it('should return timeseries results', async () => {\n    const res = await request(app)\n      .post('/api/query/timeseries')\n      .set('Authorization', `Bearer ${viewerToken}`)\n      .send({ eventName: 'page_view', granularity: 'day' });\n\n    expect(res.status).toBe(200);\n    expect(Array.isArray(res.body.results)).toBe(true);\n    expect(res.body.results.length).toBeGreaterThan(0);\n    expect(res.body.results[0]).toHaveProperty('period');\n    expect(res.body.results[0]).toHaveProperty('count');\n  });\n\n  it('should return breakdown results', async () => {\n    const res = await request(app)\n      .post('/api/query/breakdown')\n      .set('Authorization', `Bearer ${viewerToken}`)\n      .send({ even