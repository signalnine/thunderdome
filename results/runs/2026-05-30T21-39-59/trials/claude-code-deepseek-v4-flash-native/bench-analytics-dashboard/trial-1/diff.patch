@@ -0,0 +1,175 @@
+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { AuthenticatedRequest } from '../types.js';
+
+/**
+ * Export router factory.
+ *
+ * Routes:
+ *   GET /export/events       — export event data as CSV or JSON
+ *   GET /export/dashboards/:id — export a dashboard as CSV or JSON
+ *
+ * All routes enforce tenant isolation.
+ */
+export function exportRouter(db: Database.Database): Router {
+  const router = Router();
+
+  // -----------------------------------------------------------------------
+  // GET /export/events?format=csv|json
+  // -----------------------------------------------------------------------
+  router.get('/events', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const format = (req.query.format as string)?.toLowerCase() || 'json';
+      const eventName = req.query.eventName as string | undefined;
+      const startDate = req.query.startDate as string | undefined;
+      const endDate = req.query.endDate as string | undefined;
+
+      let sql = `SELECT id, name, properties, timestamp, user_id, session_id
+                 FROM events WHERE tenant_id = ?`;
+      const params: unknown[] = [user.tenantId];
+
+      if (eventName) {
+        sql += ' AND name = ?';
+        params.push(eventName);
+      }
+      if (startDate) {
+        sql += ' AND timestamp >= ?';
+        params.push(startDate);
+      }
+      if (endDate) {
+        sql += ' AND timestamp <= ?';
+        params.push(endDate);
+      }
+
+      sql += ' ORDER BY timestamp ASC';
+
+      const rows = db.prepare(sql).all(...params) as Array<{
+        id: string;
+        name: string;
+        properties: string;
+        timestamp: string;
+        user_id: string | null;
+        session_id: string | null;
+      }>;
+
+      if (format === 'csv') {
+        const csvHeader = 'id,name,properties,timestamp,user_id,session_id\n';
+        const csvRows = rows.map(r => {
+          const props = r.properties.replace(/"/g, '""');
+          return `"${r.id}","${r.name}","${props}","${r.timestamp}","${r.user_id ?? ''}","${r.session_id ?? ''}"`;
+        }).join('\n');
+
+        res.setHeader('Content-Type', 'text/csv');
+        res.setHeader('Content-Disposition', 'attachment; filename="events.csv"');
+        res.send(csvHeader + csvRows);
+      } else {
+        const data = rows.map(r => ({
+          id: r.id,
+          name: r.name,
+          properties: JSON.parse(r.properties),
+          timestamp: r.timestamp,
+          userId: r.user_id,
+          sessionId: r.session_id,
+        }));
+
+        res.setHeader('Content-Type', 'application/json');
+        res.setHeader('Content-Disposition', 'attachment; filename="events.json"');
+        res.json({ events: data });
+      }
+    } catch (err) {
+      console.error('Export events error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  // -----------------------------------------------------------------------
+  // GET /export/dashboards/:id?format=csv|json
+  // -----------------------------------------------------------------------
+  router.get('/dashboards/:id', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const { id } = req.params;
+      const format = (req.query.format as string)?.toLowerCase() || 'json';
+
+      const dashboard = db.prepare(
+        `SELECT id, name, config, owner_id, created_at, updated_at
+         FROM dashboards WHERE id = ? AND tenant_id = ?`
+      ).get(id, user.tenantId) as {
+        id: string;
+        name: string;
+        config: string;
+        owner_id: string;
+        created_at: string;
+        updated_at: string;
+      } | undefined;
+
+      if (!dashboard) {
+        res.status(404).json({ error: 'Dashboard not found', code: 404 });
+        return;
+      }
+
+      const widgets = db.prepare(
+        `SELECT id, type, config, position_x, position_y, width, height
+         FROM widgets WHERE dashboard_id = ?`
+      ).all(id) as Array<{
+        id: string;
+        type: string;
+        config: string;
+        position_x: number;
+        position_y: number;
+        width: number;
+        height: number;
+      }>;
+
+      if (format === 'csv') {
+        // Dashboard metadata as CSV rows
+        const lines: string[] = [];
+        lines.push('"section","key","value"');
+        lines.push(`"dashboard","id","${dashboard.id}"`);
+        lines.push(`"dashboard","name","${dashboard.name}"`);
+        lines.push(`"dashboard","config","${dashboard.config.replace(/"/g, '""')}"`);
+        lines.push(`"dashboard","owner_id","${dashboard.owner_id}"`);
+        lines.push(`"dashboard","created_at","${dashboard.created_at}"`);
+        lines.push(`"dashboard","updated_at","${dashboard.updated_at}"`);
+        lines.push('"widgets","id","type","config","position_x","position_y","width","height"');
+
+        for (const w of widgets) {
+          const cfg = w.config.replace(/"/g, '""');
+          lines.push(`"widget","${w.id}","${w.type}","${cfg}",${w.position_x},${w.position_y},${w.width},${w.height}`);
+        }
+
+        res.setHeader('Content-Type', 'text/csv');
+        res.setHeader('Content-Disposition', 'attachment; filename="dashboard.csv"');
+        res.send(lines.join('\n'));
+      } else {
+        res.setHeader('Content-Type', 'application/json');
+        res.setHeader('Content-Disposition', 'attachment; filename="dashboard.json"');
+        res.json({
+          dashboard: {
+            id: dashboard.id,
+            name: dashboard.name,
+            config: JSON.parse(dashboard.config),
+            ownerId: dashboard.owner_id,
+            createdAt: dashboard.created_at,
+            updatedAt: dashboard.updated_at,
+            widgets: widgets.map(w => ({
+              id: w.id,
+              type: w.type,
+              config: JSON.parse(w.config),
+              position_x: w.position_x,
+              position_y: w.position_y,
+              width: w.width,
+              height: w.height,
+            })),
+          },
+        });
+      }
+    } catch (err) {
+      console.error('Export dashboard error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  return router;
+}
diff --git a/src/routes/query.ts b/src/routes/query.ts
new file mode 100644
index 0000000..6826292
--- /dev/null
+++ b/src/routes/query.ts
@@ -0,0 +1,153 @@
+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { AuthenticatedRequest } from '../types.js';
+
+/**
+ * Query engine router factory.
+ *
+ * Routes:
+ *   POST /query/count       — count events matching a filter
+ *   POST /query/timeseries  — event counts bucketed over time
+ *   POST /query/breakdown   — event counts grouped by a property value
+ *
+ * Every query enforces tenant isolation via the authenticated user's tenantId.
+ */
+export function queryRouter(db: Database.Database): Router {
+  const router = Router();
+
+  // -----------------------------------------------------------------------
+  // POST /query/count
+  // -----------------------------------------------------------------------
+  router.post('/count', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const { eventName, startDate, endDate } = req.body as {
+        eventName?: string;
+        startDate?: string;
+        endDate?: string;
+      };
+
+      if (!eventName) {
+        res.status(400).json({ error: 'eventName is required', code: 400 });
+        return;
+      }
+
+      const rows = db.prepare(`
+        SELECT COUNT(*) as count
+        FROM events
+        WHERE tenant_id = ?
+          AND name = ?
+          AND (? IS NULL OR timestamp >= ?)
+          AND (? IS NULL OR timestamp <= ?)
+      `).get(user.tenantId, eventName, startDate ?? null, startDate ?? null, endDate ?? null, endDate ?? null) as { count: number };
+
+      res.json({ count: rows.count });
+    } catch (err) {
+      console.error('Count query error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  // -----------------------------------------------------------------------
+  // POST /query/timeseries
+  // -----------------------------------------------------------------------
+  router.post('/timeseries', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const { eventName, granularity, startDate, endDate } = req.body as {
+        eventName?: string;
+        granularity?: string;
+        startDate?: string;
+        endDate?: string;
+      };
+
+      if (!eventName) {
+        res.status(400).json({ error: 'eventName is required', code: 400 });
+        return;
+      }
+
+      const validGranularities = ['hour', 'day', 'week', 'month'];
+      const g = granularity && validGranularities.includes(granularity) ? granularity : 'day';
+
+      // Build the time-bucket expression per granularity
+      const periodExpr = {
+        hour: "strftime('%Y-%m-%dT%H:00:00', timestamp)",
+        day: "strftime('%Y-%m-%d', timestamp)",
+        week: "strftime('%Y-%W', timestamp)",
+        month: "strftime('%Y-%m', timestamp)",
+      }[g];
+
+      const rows = db.prepare(`
+        SELECT ${periodExpr} AS period, COUNT(*) AS count
+        FROM events
+        WHERE tenant_id = ?
+          AND name = ?
+          AND (? IS NULL OR timestamp >= ?)
+          AND (? IS NULL OR timestamp <= ?)
+        GROUP BY period
+        ORDER BY period ASC
+      `).all(user.tenantId, eventName, startDate ?? null, startDate ?? null, endDate ?? null, endDate ?? null) as Array<{ period: string; count: number }>;
+
+      res.json({ results: rows });
+    } catch (err) {
+      console.error('Timeseries query error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  // -----------------------------------------------------------------------
+  // POST /query/breakdown
+  // -----------------------------------------------------------------------
+  router.post('/breakdown', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const { eventName, property, startDate, endDate } = req.body as {
+        eventName?: string;
+        property?: string;
+        startDate?: string;
+        endDate?: string;
+      };
+
+      if (!eventName) {
+        res.status(400).json({ error: 'eventName is required', code: 400 });
+        return;
+      }
+
+      if (!property) {
+        res.status(400).json({ error: 'property is required for breakdown queries', code: 400 });
+        return;
+      }
+
+      // Sanitize property name to prevent SQL injection in the JSON path expression
+      const sanitized = property.replace(/[^a-zA-Z0-9_]/g, '');
+      if (!sanitized) {
+        res.status(400).json({ error: 'Invalid property name', code: 400 });
+        return;
+      }
+
+      const rows = db.prepare(`
+        SELECT json_extract(properties, '$."${sanitized}"') AS value, COUNT(*) AS count
+        FROM events
+        WHERE tenant_id = ?
+          AND name = ?
+          AND (? IS NULL OR timestamp >= ?)
+          AND (? IS NULL OR timestamp <= ?)
+        GROUP BY value
+        ORDER BY count DESC
+      `).all(user.tenantId, eventName, startDate ?? null, startDate ?? null, endDate ?? null, endDate ?? null) as Array<{ value: string | null; count: number }>;
+
+      // Convert null values to 'null' string for JSON serialization
+      const results = rows.map(r => ({
+        value: r.value === null ? null : r.value,
+        count: r.count,
+      }));
+
+      res.json({ results });
+    } catch (err) {
+      console.error('Breakdown query error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  return router;
+}
