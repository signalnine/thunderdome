ECT id FROM users WHERE email = ?').get(email);\n      if (existing) {\n        res.status(409).json({ error: 'Email already registered', code: 409 });\n        return;\n      }\n\n      const id = uuidv4();\n      const passwordHash = hashPassword(password);\n      const createdAt = new Date().toISOString();\n\n      db.prepare(\n        `INSERT INTO users (id, email, password_hash, tenant_id, role, created_at)\n         VALUES (?, ?, ?, ?, ?, ?)`\n      ).run(id, email, passwordHash, tenantId, userRole, createdAt);\n\n      const token = generateToken(id, tenantId, userRole);\n\n      res.status(201).json({\n        user: { id, email, tenantId, role: userRole },\n        token,\n      });\n    } catch (err) {\n      console.error('Register error:', err);\n      res.status(500).json({ error: 'Internal server error', code: 500 });\n    }\n  });\n\n  // -----------------------------------------------------------------------\n  // POST /login\n  // -----------------------------------------------------------------------\n  router.post('/login', (req: Request, res: Response) => {\n    try {\n      const { email, password } = req.body;\n\n      if (!email || !password) {\n        res.status(400).json({ error: 'email and password are required', code: 400 });\n        return;\n      }\n\n      const user = db.prepare(\n        'SELECT id, email, password_hash, tenant_id, role FROM users WHERE email = ?'\n      ).get(email) as { id: string; email: string; password_hash: string; tenant_id: string; role: string } | undefined;\n\n      if (!user || !verifyPassword(password, user.password_hash)) {\n        res.status(401).json({ error: 'Invalid email or password', code: 401 });\n        return;\n      }\n\n      const token = generateToken(user.id, user.tenant_id, user.role);\n\n      res.json({\n        user: { id: user.id, email: user.email, tenantId: user.tenant_id, role: user.role },\n        token,\n      });\n    } catch (err) {\n      console.error('Login error:', err);\