         'SELECT id, tenant_id FROM users WHERE id = ?'\n        ).get(id) as { id: string; tenant_id: string } | undefined;\n\n        if (!target) {\n          res.status(404).json({ error: 'User not found', code: 404 });\n          return;\n        }\n\n        if (target.tenant_id !== currentUser.tenantId) {\n          res.status(403).json({ error: 'Cannot change role of users in other tenants', code: 403 });\n          return;\n        }\n\n        db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, id);\n\n        const updated = db.prepare(\n          'SELECT id, email, tenant_id, role FROM users WHERE id = ?'\n        ).get(id) as { id: string; email: string; tenant_id: string; role: string };\n\n        res.json({\n          user: {\n            id: updated.id,\n            email: updated.email,\n            tenantId: updated.tenant_id,\n            role: updated.role,\n          },\n        });\n      } catch (err) {\n        console.error('Change role error:', err);\n        res.status(500).json({ error: 'Internal server error', code: 500 });\n      }\n    }\n  );\n\n  return router;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
