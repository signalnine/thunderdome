ds WHERE id = ? AND tenant_id = ?'\n      ).get(id, user.tenantId);\n\n      if (!existing) {\n        res.status(404).json({ error: 'Dashboard not found', code: 404 });\n        return;\n      }\n\n      // Widgets are deleted via ON DELETE CASCADE\n      db.prepare('DELETE FROM dashboards WHERE id = ?').run(id);\n\n      res.json({ success: true });\n    } catch (err) {\n      console.error('Delete dashboard error:', err);\n      res.status(500).json({ error: 'Internal server error', code: 500 });\n    }\n  });\n\n  return router;\n}\n","structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":6,"lines":[" import { Router, Request, Response } from 'express';"," import Database from 'better-sqlite3';"," import { v4 as uuidv4 } from 'uuid';","-import { authMiddleware } from '../auth.js';"," import { AuthenticatedRequest, DashboardInput, WidgetInput } from '../types.js';"," "," /**"]}],"userModified":false,"replaceAll":false}}
