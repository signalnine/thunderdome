+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { v4 as uuidv4 } from 'uuid';
+import { AuthenticatedRequest, EventInput } from '../types.js';
+
+/**
+ * Event ingestion router factory.
+ *
+ * Routes:
+ *   POST /events       — ingest a single event
+ *   POST /events/batch — ingest multiple events
+ */
+export function eventsRouter(db: Database.Database): Router {
+  const router = Router();
+
+  const insertStmt = db.prepare(
+    `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+     VALUES (?, ?, ?, ?, ?, ?, ?)`
+  );
+
+  // -----------------------------------------------------------------------
+  // POST /events  — single event
+  // -----------------------------------------------------------------------
+  router.post('/', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const { name, properties, timestamp, sessionId } = req.body as EventInput & { sessionId?: string };
+
+      if (!name) {
+        res.status(400).json({ error: 'Event name is required', code: 400 });
+        return;
+      }
+
+      const id = uuidv4();
+      const propsJson = JSON.stringify(properties ?? {});
+      const ts = timestamp ?? new Date().toISOString();
+
+      insertStmt.run(id, user.tenantId, name, propsJson, ts, user.userId, sessionId ?? null);
+
+      res.status(201).json({
+        event: {
+          id,
+          name,
+          properties: properties ?? {},
+          timestamp: ts,
+          tenantId: user.tenantId,
+          userId: user.userId,
+          sessionId: sessionId ?? null,
+        },
+      });
+    } catch (err) {
+      console.error('Ingest event error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  // -----------------------------------------------------------------------
+  // POST /events/batch  — batch events
+  // -----------------------------------------------------------------------
+  router.post('/batch', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const { events } = req.body as { events: EventInput[] };
+
+      if (!events || !Array.isArray(events) || events.length === 0) {
+        res.status(400).json({ error: 'events array is required and must be non-empty', code: 400 });
+        return;
+      }
+
+      const inserted = db.transaction(() => {
+        const results: Array<{
+          id: string;
+          name: string;
+          properties: Record<string, unknown>;
+          timestamp: string;
+        }> = [];
+
+        for (const ev of events) {
+          if (!ev.name) {
+            throw new Error('Each event must have a name');
+          }
+          const id = uuidv4();
+          const propsJson = JSON.stringify(ev.properties ?? {});
+          const ts = ev.timestamp ?? new Date().toISOString();
+
+          insertStmt.run(id, user.tenantId, ev.name, propsJson, ts, user.userId, ev.sessionId ?? null);
+          results.push({
+            id,
+            name: ev.name,
+            properties: ev.properties ?? {},
+            timestamp: ts,
+          });
+        }
+
+        return results;
+      })();
+
+      res.status(201).json({
+        events: inserted,
+        count: inserted.length,
+      });
+    } catch (err) {
+      const message = err instanceof Error ? err.message : 'Internal server error';
+      if (message === 'Each event must have a name') {
+        res.status(400).json({ error: message, code: 400 });
+        return;
+      }
+      console.error('Batch ingest error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  return router;
+}
