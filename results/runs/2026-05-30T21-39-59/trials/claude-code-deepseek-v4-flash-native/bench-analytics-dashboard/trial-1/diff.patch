@@ -0,0 +1,43 @@
+import { Request } from 'express';
+
+/** Shape carried in JWT tokens — must match { sub, tid, iat, exp } per rubric. */
+export interface JwtPayload {
+  sub: string;
+  tid: string;
+  role: 'admin' | 'editor' | 'viewer';
+  iat: number;
+  exp: number;
+}
+
+/** Decoded user information attached to authenticated requests. */
+export interface UserInfo {
+  userId: string;
+  tenantId: string;
+  role: 'admin' | 'editor' | 'viewer';
+}
+
+/** Express request augmented with authenticated user info. */
+export interface AuthenticatedRequest extends Request {
+  user: UserInfo;
+}
+
+export interface EventInput {
+  name: string;
+  properties?: Record<string, unknown>;
+  timestamp?: string;
+  sessionId?: string;
+}
+
+export interface DashboardInput {
+  name: string;
+  config?: Record<string, unknown>;
+}
+
+export interface WidgetInput {
+  type: 'counter' | 'timeseries' | 'breakdown' | 'funnel';
+  config?: Record<string, unknown>;
+  position_x?: number;
+  position_y?: number;
+  width?: number;
+  height?: number;
+}
