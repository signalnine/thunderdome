--- /dev/null
+++ b/src/routes/auth.ts
@@ -0,0 +1,182 @@
+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { v4 as uuidv4 } from 'uuid';
+import { hashPassword, verifyPassword, generateToken, authMiddleware, requireRole } from '../auth.js';
+import { AuthenticatedRequest } from '../types.js';
+
+/**
+ * Authentication router factory.
+ *
+ * Routes:
+ *   POST /register   — create a new user (public)
+ *   POST /login      — authenticate and receive JWT (public)
+ *   GET  /me         — current user profile (authenticated)
+ *   PUT  /users/:id/role — change a user's role (admin only)
+ */
+export function authRouter(db: Database.Database): Router {
+  const router = Router();
+
+  // -----------------------------------------------------------------------
+  // POST /register
+  // -----------------------------------------------------------------------
+  router.post('/register', (req: Request, res: Response) => {
+    try {
+      const { email, password, tenantId, role } = req.body;
+
+      if (!email || !password || !tenantId) {
+        res.status(400).json({ error: 'email, password, and tenantId are required', code: 400 });
+        return;
+      }
+
+      // Validate role
+      const validRoles = ['admin', 'editor', 'viewer'] as const;
+      const userRole = role && validRoles.includes(role) ? role : 'viewer';
+
+      // Check for duplicate email within the tenant (or globally — email is UNIQUE in schema)
+      const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(email);
+      if (existing) {
+        res.status(409).json({ error: 'Email already registered', code: 409 });
+        return;
+      }
+
+      const id = uuidv4();
+      const passwordHash = hashPassword(password);
+      const createdAt = new Date().toISOString();
+
+      db.prepare(
+        `INSERT INTO users (id, email, password_hash, tenant_id, role, created_at)
+         VALUES (?, ?, ?, ?, ?, ?)`
+      ).run(id, email, passwordHash, tenantId, userRole, createdAt);
+
+      const token = generateToken(id, tenantId, userRole);
+
+      res.status(201).json({
+        user: { id, email, tenantId, role: userRole },
+        token,
+      });
+    } catch (err) {
+      console.error('Register error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  // -----------------------------------------------------------------------
+  // POST /login
+  // -----------------------------------------------------------------------
+  router.post('/login', (req: Request, res: Response) => {
+    try {
+      const { email, password } = req.body;
+
+      if (!email || !password) {
+        res.status(400).json({ error: 'email and password are required', code: 400 });
+        return;
+      }
+
+      const user = db.prepare(
+        'SELECT id, email, password_hash, tenant_id, role FROM users WHERE email = ?'
+      ).get(email) as { id: string; email: string; password_hash: string; tenant_id: string; role: string } | undefined;
+
+      if (!user || !verifyPassword(password, user.password_hash)) {
+        res.status(401).json({ error: 'Invalid email or password', code: 401 });
+        return;
+      }
+
+      const token = generateToken(user.id, user.tenant_id, user.role);
+
+      res.json({
+        user: { id: user.id, email: user.email, tenantId: user.tenant_id, role: user.role },
+        token,
+      });
+    } catch (err) {
+      console.error('Login error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  // -----------------------------------------------------------------------
+  // GET /me  (authenticated)
+  // -----------------------------------------------------------------------
+  router.get('/me', authMiddleware(db), (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const record = db.prepare(
+        'SELECT id, email, tenant_id, role, created_at FROM users WHERE id = ?'
+      ).get(user.userId) as { id: string; email: string; tenant_id: string; role: string; created_at: string } | undefined;
+
+      if (!record) {
+        res.status(404).json({ error: 'User not found', code: 404 });
+        return;
+      }
+
+      res.json({
+        user: {
+          id: record.id,
+          email: record.email,
+          tenantId: record.tenant_id,
+          role: record.role,
+          createdAt: record.created_at,
+        },
+      });
+    } catch (err) {
+      console.error('Get profile error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  // -----------------------------------------------------------------------
+  // PUT /users/:id/role  (admin only)
+  // -----------------------------------------------------------------------
+  router.put(
+    '/users/:id/role',
+    authMiddleware(db),
+    requireRole('admin'),
+    (req: Request, res: Response) => {
+      try {
+        const { id } = req.params;
+        const { role } = req.body;
+        const currentUser = (req as AuthenticatedRequest).user;
+
+        const validRoles = ['admin', 'editor', 'viewer'];
+        if (!role || !validRoles.includes(role)) {
+          res.status(400).json({ error: 'Invalid role. Must be admin, editor, or viewer', code: 400 });
+          return;
+        }
+
+        // Ensure the target user belongs to the same tenant
+        const target = db.prepare(
+          'SELECT id, tenant_id FROM users WHERE id = ?'
+        ).get(id) as { id: string; tenant_id: string } | undefined;
+
+        if (!target) {
+          res.status(404).json({ error: 'User not found', code: 404 });
+          return;
+        }
+
+        if (target.tenant_id !== currentUser.tenantId) {
+          res.status(403).json({ error: 'Cannot change role of users in other tenants', code: 403 });
+          return;
+        }
+
+        db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, id);
+
+        const updated = db.prepare(
+          'SELECT id, email, tenant_id, role FROM users WHERE id = ?'
+        ).get(id) as { id: string; email: string; tenant_id: string; role: string };
+
+        res.json({
+          user: {
+            id: updated.id,
+            email: updated.email,
+            tenantId: updated.tenant_id,
+            role: updated.role,
+          },
+        });
+      } catch (err) {
+        console.error('Change role error:', err);
+        res.status(500).json({ error: 'Internal server error', code: 500 });
+      }
+    }
+  );
+
+  return router;
+}
diff --git a/src/routes/dashboards.ts b/src/routes/dashboards.ts
new file mode 100644
index 0000000..0920afb
--- /dev/null
+++ b/src/routes/dashboards.ts
@@ -0,0 +1,294 @@
+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { v4 as uuidv4 } from 'uuid';
+import { AuthenticatedRequest, DashboardInput, WidgetInput } from '../types.js';
+
+/**
+ * Dashboard CRUD router factory.
+ *
+ * All routes require authentication. Dashboards are scoped to the
+ * authenticated user's tenant.
+ */
+export function dashboardsRouter(db: Database.Database): Router {
+  const router = Router();
+
+  // -----------------------------------------------------------------------
+  // GET /dashboards  — list all dashboards for the tenant
+  // -----------------------------------------------------------------------
+  router.get('/', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+
+      const rows = db.prepare(
+        `SELECT id, name, config, owner_id, created_at, updated_at
+         FROM dashboards
+         WHERE tenant_id = ?
+         ORDER BY created_at DESC`
+      ).all(user.tenantId) as Array<{
+        id: string;
+        name: string;
+        config: string;
+        owner_id: string;
+        created_at: string;
+        updated_at: string;
+      }>;
+
+      const dashboards = rows.map(r => ({
+        id: r.id,
+        name: r.name,
+        config: JSON.parse(r.config),
+        ownerId: r.owner_id,
+        createdAt: r.created_at,
+        updatedAt: r.updated_at,
+      }));
+
+      res.json({ dashboards });
+    } catch (err) {
+      console.error('List dashboards error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  // -----------------------------------------------------------------------
+  // POST /dashboards  — create a new dashboard
+  // -----------------------------------------------------------------------
+  router.post('/', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const { name, config, widgets } = req.body as DashboardInput & { widgets?: WidgetInput[] };
+
+      if (!name) {
+        res.status(400).json({ error: 'Dashboard name is required', code: 400 });
+        return;
+      }
+
+      const id = uuidv4();
+      const configJson = JSON.stringify(config ?? {});
+      const now = new Date().toISOString();
+
+      const insertDashboard = db.prepare(
+        `INSERT INTO dashboards (id, tenant_id, name, owner_id, config, created_at, updated_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?)`
+      );
+
+      const insertWidget = db.prepare(
+        `INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
+      );
+
+      const result = db.transaction(() => {
+        insertDashboard.run(id, user.tenantId, name, user.userId, configJson, now, now);
+
+        const createdWidgets: Array<{
+          id: string;
+          type: string;
+          config: Record<string, unknown>;
+          position_x: number;
+          position_y: number;
+          width: number;
+          height: number;
+        }> = [];
+
+        if (widgets && Array.isArray(widgets)) {
+          for (const w of widgets) {
+            const wid = uuidv4();
+            const wConfig = JSON.stringify(w.config ?? {});
+            insertWidget.run(
+              wid, id, w.type, wConfig,
+              w.position_x ?? 0, w.position_y ?? 0,
+              w.width ?? 1, w.height ?? 1
+            );
+            createdWidgets.push({
+              id: wid,
+              type: w.type,
+              config: w.config ?? {},
+              position_x: w.position_x ?? 0,
+              position_y: w.position_y ?? 0,
+              width: w.width ?? 1,
+              height: w.height ?? 1,
+            });
+          }
+        }
+
+        return createdWidgets;
+      })();
+
+      res.status(201).json({
+        dashboard: {
+          id,
+          name,
+          config: config ?? {},
+          ownerId: user.userId,
+          tenantId: user.tenantId,
+          createdAt: now,
+          updatedAt: now,
+          widgets: result,
+        },
+      });
+    } catch (err) {
+      console.error('Create dashboard error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  // -----------------------------------------------------------------------
+  // GET /dashboards/:id  — get a single dashboard with widgets
+  // -----------------------------------------------------------------------
+  router.get('/:id', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const { id } = req.params;
+
+      const dashboard = db.prepare(
+        `SELECT id, name, config, owner_id, tenant_id, created_at, updated_at
+         FROM dashboards WHERE id = ? AND tenant_id = ?`
+      ).get(id, user.tenantId) as {
+        id: string;
+        name: string;
+        config: string;
+        owner_id: string;
+        tenant_id: string;
+        created_at: string;
+        updated_at: string;
+      } | undefined;
+
+      if (!dashboard) {
+        res.status(404).json({ error: 'Dashboard not found', code: 404 });
+        return;
+      }
+
+      const widgets = db.prepare(
+        `SELECT id, type, config, position_x, position_y, width, height
+         FROM widgets WHERE dashboard_id = ?`
+      ).all(id) as Array<{
+        id: string;
+        type: string;
+        config: string;
+        position_x: number;
+        position_y: number;
+        width: number;
+        height: number;
+      }>;
+
+      res.json({
+        dashboard: {
+          id: dashboard.id,
+          name: dashboard.name,
+          config: JSON.parse(dashboard.config),
+          ownerId: dashboard.owner_id,
+          tenantId: dashboard.tenant_id,
+          createdAt: dashboard.created_at,
+          updatedAt: dashboard.updated_at,
+          widgets: widgets.map(w => ({
+            id: w.id,
+            type: w.type,
+            config: JSON.parse(w.config),
+            position_x: w.position_x,
+            position_y: w.position_y,
+            width: w.width,
+            height: w.height,
+          })),
+        },
+      });
+    } catch (err) {
+      console.error('Get dashboard error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  // -----------------------------------------------------------------------
+  // PUT /dashboards/:id  — update a dashboard
+  // -----------------------------------------------------------------------
+  router.put('/:id', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const { id } = req.params;
+      const { name, config } = req.body as { name?: string; config?: Record<string, unknown> };
+
+      // Verify ownership
+      const existing = db.prepare(
+        'SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?'
+      ).get(id, user.tenantId);
+
+      if (!existing) {
+        res.status(404).json({ error: 'Dashboard not found', code: 404 });
+        return;
+      }
+
+      const now = new Date().toISOString();
+
+      if (name && config) {
+        db.prepare(
+          'UPDATE dashboards SET name = ?, config = ?, updated_at = ? WHERE id = ?'
+        ).run(name, JSON.stringify(config), now, id);
+      } else if (name) {
+        db.prepare(
+          'UPDATE dashboards SET name = ?, updated_at = ? WHERE id = ?'
+        ).run(name, now, id);
+      } else if (config) {
+        db.prepare(
+          'UPDATE dashboards SET config = ?, updated_at = ? WHERE id = ?'
+        ).run(JSON.stringify(config), now, id);
+      } else {
+        // No fields to update — just return the current state
+      }
+
+      const updated = db.prepare(
+        `SELECT id, name, config, owner_id, tenant_id, created_at, updated_at
+         FROM dashboards WHERE id = ?`
+      ).get(id) as {
+        id: string;
+        name: string;
+        config: string;
+        owner_id: string;
+        tenant_id: string;
+        created_at: string;
+        updated_at: string;
+      };
+
+      res.json({
+        dashboard: {
+          id: updated.id,
+          name: updated.name,
+          config: JSON.parse(updated.config),
+          ownerId: updated.owner_id,
+          tenantId: updated.tenant_id,
+          createdAt: updated.created_at,
+          updatedAt: updated.updated_at,
+        },
+      });
+    } catch (err) {
+      console.error('Update dashboard error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  // -----------------------------------------------------------------------
+  // DELETE /dashboards/:id  — delete a dashboard (and cascading widgets)
+  // -----------------------------------------------------------------------
+  router.delete('/:id', (req: Request, res: Response) => {
+    try {
+      const user = (req as AuthenticatedRequest).user;
+      const { id } = req.params;
+
+      const existing = db.prepare(
+        'SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?'
+      ).get(id, user.tenantId);
+
+      if (!existing) {
+        res.status(404).json({ error: 'Dashboard not found', code: 404 });
+        return;
+      }
+
+      // Widgets are deleted via ON DELETE CASCADE
+      db.prepare('DELETE FROM dashboards WHERE id = ?').run(id);
+
+      res.json({ success: true });
+    } catch (err) {
+      console.error('Delete dashboard error:', err);
+      res.status(500).json({ error: 'Internal server error', code: 500 });
+    }
+  });
+
+  return router;
+}
