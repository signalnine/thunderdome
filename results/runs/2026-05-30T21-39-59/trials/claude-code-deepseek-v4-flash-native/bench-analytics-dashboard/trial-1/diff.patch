rized', code: 401 });\n      return;\n    }\n    if (!roles.includes(user.role)) {\n      res.status(403).json({ error: 'Forbidden', code: 403 });\n      return;\n    }\n    next();\n  };\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
