+++ b/src/index.ts
@@ -0,0 +1,34 @@
+import express from 'express';
+import { initDatabase } from './db.js';
+import { authRouter } from './routes/auth.js';
+import { eventsRouter } from './routes/events.js';
+import { queryRouter } from './routes/query.js';
+import { dashboardsRouter } from './routes/dashboards.js';
+import { exportRouter } from './routes/export.js';
+import { authMiddleware } from './auth.js';
+
+/**
+ * Create and configure an Express application with all analytics routes.
+ *
+ * @param dbPath - Optional file path for the SQLite database.
+ *                 Defaults to `:memory:` when not provided.
+ * @returns A fully-configured Express application.
+ */
+export function createApp(dbPath?: string): express.Application {
+  const db = initDatabase(dbPath);
+  const app = express();
+
+  // --- Global middleware ---------------------------------------------------
+  app.use(express.json());
+
+  // --- Public / semi-public routes -----------------------------------------
+  app.use('/api/auth', authRouter(db));
+
+  // --- Protected routes (authentication required) --------------------------
+  app.use('/api/events', authMiddleware(db), eventsRouter(db));
+  app.use('/api/query', authMiddleware(db), queryRouter(db));
+  app.use('/api/dashboards', authMiddleware(db), dashboardsRouter(db));
+  app.use('/api/export', authMiddleware(db), exportRouter(db));
+
+  return app;
+}
