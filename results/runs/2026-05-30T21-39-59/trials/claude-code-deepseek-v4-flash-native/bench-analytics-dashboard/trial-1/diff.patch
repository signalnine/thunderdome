--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,39 @@
+import Database from 'better-sqlite3';
+import { readFileSync } from 'fs';
+import { join } from 'path';
+
+/**
+ * Initialize and return a SQLite database.
+ * Optionally accepts a file path; defaults to `:memory:`.
+ * Reads `schema.sql` from the project root to set up tables.
+ */
+export function initDatabase(dbPath?: string): Database.Database {
+  const db = new Database(dbPath ?? ':memory:');
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+
+  // Try multiple paths to find schema.sql — handles different runtime contexts
+  const candidatePaths = [
+    join(process.cwd(), 'schema.sql'),
+    join(__dirname, '..', 'schema.sql'),
+  ];
+
+  let schemaSql: string | null = null;
+  for (const p of candidatePaths) {
+    try {
+      schemaSql = readFileSync(p, 'utf-8');
+      break;
+    } catch {
+      // continue to next candidate
+    }
+  }
+
+  if (!schemaSql) {
+    throw new Error(
+      'Cannot find schema.sql. Tried: ' + candidatePaths.join(', ')
+    );
+  }
+
+  db.exec(schemaSql);
+  return db;
+}
