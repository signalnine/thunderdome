@@ -0,0 +1,392 @@
+import { describe, it, expect, beforeAll } from 'vitest';
+import request from 'supertest';
+import { createApp } from '../src/index.js';
+
+const app = createApp(':memory:');
+
+// Shared state across tests
+let viewerToken: string;
+let adminToken: string;
+const tenantId = 'tenant-1';
+const adminTenantId = 'tenant-admin';
+
+// Used to store IDs returned by POST endpoints
+let createdEventId: string;
+let createdDashboardId: string;
+
+beforeAll(async () => {
+  // Register an admin user
+  const adminRes = await request(app)
+    .post('/api/auth/register')
+    .send({ email: 'admin@test.com', password: 'password123', tenantId: adminTenantId, role: 'admin' });
+  adminToken = adminRes.body.token;
+
+  // Register a viewer user
+  const viewerRes = await request(app)
+    .post('/api/auth/register')
+    .send({ email: 'viewer@test.com', password: 'password123', tenantId, role: 'viewer' });
+  viewerToken = viewerRes.body.token;
+
+  // Register an editor user (for role-change tests)
+  await request(app)
+    .post('/api/auth/register')
+    .send({ email: 'editor@test.com', password: 'password123', tenantId, role: 'editor' });
+});
+
+// ==========================================================================
+// Auth tests
+// ==========================================================================
+
+describe('Auth', () => {
+  it('should register a new user', async () => {
+    const res = await request(app)
+      .post('/api/auth/register')
+      .send({ email: 'new@test.com', password: 'secret123', tenantId: 'tenant-new', role: 'editor' });
+
+    expect(res.status).toBe(201);
+    expect(res.body).toHaveProperty('token');
+    expect(res.body.user).toMatchObject({
+      email: 'new@test.com',
+      tenantId: 'tenant-new',
+      role: 'editor',
+    });
+  });
+
+  it('should reject duplicate email', async () => {
+    const res = await request(app)
+      .post('/api/auth/register')
+      .send({ email: 'viewer@test.com', password: 'pwd', tenantId: 'other' });
+    expect(res.status).toBe(409);
+  });
+
+  it('should login with valid credentials', async () => {
+    const res = await request(app)
+      .post('/api/auth/login')
+      .send({ email: 'viewer@test.com', password: 'password123' });
+
+    expect(res.status).toBe(200);
+    expect(res.body).toHaveProperty('token');
+    expect(res.body.user.email).toBe('viewer@test.com');
+  });
+
+  it('should reject invalid credentials', async () => {
+    const res = await request(app)
+      .post('/api/auth/login')
+      .send({ email: 'viewer@test.com', password: 'wrongpass' });
+    expect(res.status).toBe(401);
+  });
+
+  it('should return current user profile', async () => {
+    const res = await request(app)
+      .get('/api/auth/me')
+      .set('Authorization', `Bearer ${viewerToken}`);
+
+    expect(res.status).toBe(200);
+    expect(res.body.user.email).toBe('viewer@test.com');
+  });
+
+  it('should reject unauthenticated profile request', async () => {
+    const res = await request(app).get('/api/auth/me');
+    expect(res.status).toBe(401);
+  });
+
+  it('should allow admin to change user role', async () => {
+    const userRes = await request(app)
+      .post('/api/auth/register')
+      .send({ email: 'rolechange@test.com', password: 'pwd', tenantId: adminTenantId, role: 'viewer' });
+
+    const res = await request(app)
+      .put(`/api/auth/users/${userRes.body.user.id}/role`)
+      .set('Authorization', `Bearer ${adminToken}`)
+      .send({ role: 'editor' });
+
+    expect(res.status).toBe(200);
+    expect(res.body.user.role).toBe('editor');
+  });
+
+  it('should reject role change by non-admin', async () => {
+    const otherAdminRes = await request(app)
+      .post('/api/auth/register')
+      .send({ email: 'other-admin@test.com', password: 'pwd', tenantId: adminTenantId, role: 'admin' });
+
+    const res = await request(app)
+      .put(`/api/auth/users/${otherAdminRes.body.user.id}/role`)
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({ role: 'admin' });
+
+    expect(res.status).toBe(403);
+  });
+});
+
+// ==========================================================================
+// Events
+// ==========================================================================
+
+describe('Events', () => {
+  it('should ingest a single event', async () => {
+    const res = await request(app)
+      .post('/api/events')
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({
+        name: 'page_view',
+        properties: { url: '/home', browser: 'Chrome' },
+      });
+
+    expect(res.status).toBe(201);
+    expect(res.body.event.name).toBe('page_view');
+    expect(res.body.event.properties).toMatchObject({ url: '/home', browser: 'Chrome' });
+    createdEventId = res.body.event.id;
+  });
+
+  it('should require event name', async () => {
+    const res = await request(app)
+      .post('/api/events')
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({ properties: { url: '/test' } });
+    expect(res.status).toBe(400);
+  });
+
+  it('should ingest batch events', async () => {
+    const res = await request(app)
+      .post('/api/events/batch')
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({
+        events: [
+          { name: 'click', properties: { button: 'signup' } },
+          { name: 'click', properties: { button: 'login' } },
+          { name: 'page_view', properties: { url: '/pricing' } },
+        ],
+      });
+
+    expect(res.status).toBe(201);
+    expect(res.body.count).toBe(3);
+  });
+
+  it('should reject unauthenticated event ingestion', async () => {
+    const res = await request(app)
+      .post('/api/events')
+      .send({ name: 'test_event' });
+    expect(res.status).toBe(401);
+  });
+});
+
+// ==========================================================================
+// Query Engine
+// ==========================================================================
+
+describe('Query Engine', () => {
+  it('should count events by name', async () => {
+    const res = await request(app)
+      .post('/api/query/count')
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({ eventName: 'page_view' });
+
+    expect(res.status).toBe(200);
+    expect(res.body.count).toBeGreaterThanOrEqual(2);
+  });
+
+  it('should return 0 for unknown event', async () => {
+    const res = await request(app)
+      .post('/api/query/count')
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({ eventName: 'nonexistent' });
+
+    expect(res.status).toBe(200);
+    expect(res.body.count).toBe(0);
+  });
+
+  it('should enforce tenant isolation in count', async () => {
+    const res = await request(app)
+      .post('/api/query/count')
+      .set('Authorization', `Bearer ${adminToken}`)
+      .send({ eventName: 'page_view' });
+
+    expect(res.status).toBe(200);
+    // admin tenant has no events
+    expect(res.body.count).toBe(0);
+  });
+
+  it('should return timeseries results', async () => {
+    const res = await request(app)
+      .post('/api/query/timeseries')
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({ eventName: 'page_view', granularity: 'day' });
+
+    expect(res.status).toBe(200);
+    expect(Array.isArray(res.body.results)).toBe(true);
+    expect(res.body.results.length).toBeGreaterThan(0);
+    expect(res.body.results[0]).toHaveProperty('period');
+    expect(res.body.results[0]).toHaveProperty('count');
+  });
+
+  it('should return breakdown results', async () => {
+    const res = await request(app)
+      .post('/api/query/breakdown')
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({ eventName: 'page_view', property: 'url' });
+
+    expect(res.status).toBe(200);
+    expect(Array.isArray(res.body.results)).toBe(true);
+    expect(res.body.results.length).toBeGreaterThan(0);
+    expect(res.body.results[0]).toHaveProperty('value');
+    expect(res.body.results[0]).toHaveProperty('count');
+  });
+});
+
+// ==========================================================================
+// Dashboard CRUD
+// ==========================================================================
+
+describe('Dashboards', () => {
+  it('should create a dashboard', async () => {
+    const res = await request(app)
+      .post('/api/dashboards')
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({
+        name: 'My Dashboard',
+        config: { theme: 'dark' },
+        widgets: [
+          { type: 'counter', config: { eventName: 'page_view' }, position_x: 0, position_y: 0, width: 2, height: 1 },
+        ],
+      });
+
+    expect(res.status).toBe(201);
+    expect(res.body.dashboard.name).toBe('My Dashboard');
+    expect(res.body.dashboard.widgets).toHaveLength(1);
+    expect(res.body.dashboard.widgets[0].type).toBe('counter');
+    createdDashboardId = res.body.dashboard.id;
+  });
+
+  it('should list dashboards', async () => {
+    const res = await request(app)
+      .get('/api/dashboards')
+      .set('Authorization', `Bearer ${viewerToken}`);
+
+    expect(res.status).toBe(200);
+    expect(Array.isArray(res.body.dashboards)).toBe(true);
+    expect(res.body.dashboards.length).toBeGreaterThanOrEqual(1);
+  });
+
+  it('should get a single dashboard with widgets', async () => {
+    const res = await request(app)
+      .get(`/api/dashboards/${createdDashboardId}`)
+      .set('Authorization', `Bearer ${viewerToken}`);
+
+    expect(res.status).toBe(200);
+    expect(res.body.dashboard.name).toBe('My Dashboard');
+    expect(res.body.dashboard.widgets).toHaveLength(1);
+  });
+
+  it('should enforce tenant isolation on dashboards', async () => {
+    const res = await request(app)
+      .get(`/api/dashboards/${createdDashboardId}`)
+      .set('Authorization', `Bearer ${adminToken}`);
+
+    expect(res.status).toBe(404);
+  });
+
+  it('should update a dashboard', async () => {
+    const res = await request(app)
+      .put(`/api/dashboards/${createdDashboardId}`)
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({ name: 'Updated Dashboard', config: { theme: 'light' } });
+
+    expect(res.status).toBe(200);
+    expect(res.body.dashboard.name).toBe('Updated Dashboard');
+  });
+
+  it('should delete a dashboard', async () => {
+    const delRes = await request(app)
+      .delete(`/api/dashboards/${createdDashboardId}`)
+      .set('Authorization', `Bearer ${viewerToken}`);
+
+    expect(delRes.status).toBe(200);
+    expect(delRes.body.success).toBe(true);
+
+    // Verify it's gone
+    const getRes = await request(app)
+      .get(`/api/dashboards/${createdDashboardId}`)
+      .set('Authorization', `Bearer ${viewerToken}`);
+    expect(getRes.status).toBe(404);
+  });
+});
+
+// ==========================================================================
+// Export
+// ==========================================================================
+
+describe('Export', () => {
+  it('should export events as JSON', async () => {
+    const res = await request(app)
+      .get('/api/export/events?format=json')
+      .set('Authorization', `Bearer ${viewerToken}`);
+
+    expect(res.status).toBe(200);
+    expect(res.body.events).toBeDefined();
+    expect(Array.isArray(res.body.events)).toBe(true);
+  });
+
+  it('should export events as CSV', async () => {
+    const res = await request(app)
+      .get('/api/export/events?format=csv')
+      .set('Authorization', `Bearer ${viewerToken}`);
+
+    expect(res.status).toBe(200);
+    expect(res.headers['content-type']).toContain('text/csv');
+  });
+
+  it('should filter exported events', async () => {
+    const res = await request(app)
+      .get('/api/export/events?format=json&eventName=click')
+      .set('Authorization', `Bearer ${viewerToken}`);
+
+    expect(res.status).toBe(200);
+    expect(res.body.events.length).toBe(2);
+    expect(res.body.events.every((e: { name: string }) => e.name === 'click')).toBe(true);
+  });
+
+  it('should export dashboard as JSON', async () => {
+    // First create a dashboard to export
+    const dashRes = await request(app)
+      .post('/api/dashboards')
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({ name: 'Export Test Dashboard' });
+    const dashId = dashRes.body.dashboard.id;
+
+    const res = await request(app)
+      .get(`/api/export/dashboards/${dashId}?format=json`)
+      .set('Authorization', `Bearer ${viewerToken}`);
+
+    expect(res.status).toBe(200);
+    expect(res.body.dashboard.name).toBe('Export Test Dashboard');
+  });
+
+  it('should reject unauthenticated export', async () => {
+    const res = await request(app).get('/api/export/events');
+    expect(res.status).toBe(401);
+  });
+});
+
+// ==========================================================================
+// Unauthenticated access
+// ==========================================================================
+
+describe('Authentication enforcement', () => {
+  const protectedEndpoints = [
+    ['GET', '/api/auth/me'],
+    ['POST', '/api/events'],
+    ['POST', '/api/query/count'],
+    ['GET', '/api/dashboards'],
+    ['GET', '/api/export/events'],
+  ];
+
+  it.each(protectedEndpoints)('%s %s should return 401 without token', async (method: string, path: string) => {
+    const res = await request(app)
+      [method.toLowerCase() as 'get' | 'post'](path)
+      .send({});
+
+    expect(res.status).toBe(401);
+    expect(res.body).toHaveProperty('error');
+    expect(res.body).toHaveProperty('code', 401);
+  });
+});
