@@ -0,0 +1,77 @@
+import { Router, Request, Response } from 'express';
+import { getDb } from '../db.js';
+import { generateId } from '../utils.js';
+import { requireAuth } from '../middleware.js';
+
+const router = Router();
+
+// All routes require auth
+router.use(requireAuth);
+
+// POST /api/events - ingest a single event
+router.post('/', (req: Request, res: Response) => {
+  const { name, properties, timestamp, sessionId } = req.body;
+
+  if (!name || typeof name !== 'string') {
+    res.status(400).json({ error: 'Event name is required and must be a string' });
+    return;
+  }
+
+  const db = getDb();
+  const id = generateId();
+  const tenantId = req.user!.tenantId;
+  const userId = req.user!.userId;
+  const props = JSON.stringify(properties ?? {});
+  const ts = timestamp || new Date().toISOString();
+  const sid = sessionId || null;
+
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  ).run(id, tenantId, name, props, ts, userId, sid);
+
+  res.status(201).json({ id, name, tenantId, timestamp: ts });
+});
+
+// POST /api/events/batch - ingest multiple events
+router.post('/batch', (req: Request, res: Response) => {
+  const { events } = req.body;
+
+  if (!Array.isArray(events) || events.length === 0) {
+    res.status(400).json({ error: 'Events must be a non-empty array' });
+    return;
+  }
+
+  for (let i = 0; i < events.length; i++) {
+    if (!events[i].name || typeof events[i].name !== 'string') {
+      res.status(400).json({ error: `Event at index ${i} must have a name string` });
+      return;
+    }
+  }
+
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+  const userId = req.user!.userId;
+
+  const insert = db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  );
+
+  const ids: string[] = [];
+
+  const insertMany = db.transaction(() => {
+    for (const event of events) {
+      const id = generateId();
+      const props = JSON.stringify(event.properties ?? {});
+      const ts = event.timestamp || new Date().toISOString();
+      const sid = event.sessionId || null;
+      insert.run(id, tenantId, event.name, props, ts, userId, sid);
+      ids.push(id);
+    }
+  });
+
+  insertMany();
+
+  res.status(201).json({ count: events.length, ids });
+});
+
+export default router;
