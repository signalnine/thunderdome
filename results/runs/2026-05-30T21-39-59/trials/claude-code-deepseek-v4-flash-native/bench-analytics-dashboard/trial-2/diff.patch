+++ b/src/routes/dashboards.ts
@@ -0,0 +1,203 @@
+import { Router, Request, Response } from 'express';
+import { getDb } from '../db.js';
+import { generateId } from '../utils.js';
+import { requireAuth } from '../middleware.js';
+
+const router = Router();
+
+router.use(requireAuth);
+
+// GET /api/dashboards - list dashboards for tenant
+router.get('/', (req: Request, res: Response) => {
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+
+  const dashboards = db.prepare(
+    'SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC'
+  ).all(tenantId) as Array<{
+    id: string; tenant_id: string; name: string; owner_id: string;
+    config: string; created_at: string; updated_at: string;
+  }>;
+
+  res.json({
+    dashboards: dashboards.map((d) => ({
+      id: d.id,
+      tenantId: d.tenant_id,
+      name: d.name,
+      ownerId: d.owner_id,
+      config: JSON.parse(d.config),
+      createdAt: d.created_at,
+      updatedAt: d.updated_at,
+    })),
+  });
+});
+
+// POST /api/dashboards - create dashboard
+router.post('/', (req: Request, res: Response) => {
+  const { name, config, widgets } = req.body;
+
+  if (!name || typeof name !== 'string') {
+    res.status(400).json({ error: 'Dashboard name is required' });
+    return;
+  }
+
+  const db = getDb();
+  const id = generateId();
+  const tenantId = req.user!.tenantId;
+  const ownerId = req.user!.userId;
+  const configStr = JSON.stringify(config ?? {});
+  const now = new Date().toISOString();
+
+  const insertDashboard = db.prepare(
+    'INSERT INTO dashboards (id, tenant_id, name, owner_id, config, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  );
+
+  const insertWidget = db.prepare(
+    'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+  );
+
+  const transaction = db.transaction(() => {
+    insertDashboard.run(id, tenantId, name, ownerId, configStr, now, now);
+
+    const widgetIds: string[] = [];
+    if (Array.isArray(widgets)) {
+      for (const w of widgets) {
+        const wid = generateId();
+        insertWidget.run(
+          wid,
+          id,
+          w.type || 'counter',
+          JSON.stringify(w.config ?? {}),
+          w.positionX ?? 0,
+          w.positionY ?? 0,
+          w.width ?? 1,
+          w.height ?? 1
+        );
+        widgetIds.push(wid);
+      }
+    }
+
+    return { id, widgetIds };
+  });
+
+  const result = transaction();
+
+  res.status(201).json({
+    id: result.id,
+    name,
+    tenantId,
+    ownerId,
+    config: config ?? {},
+    widgetIds: result.widgetIds,
+    createdAt: now,
+    updatedAt: now,
+  });
+});
+
+// GET /api/dashboards/:id - get dashboard with widgets
+router.get('/:id', (req: Request, res: Response) => {
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+
+  const dashboard = db.prepare(
+    'SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(req.params.id, tenantId) as {
+    id: string; tenant_id: string; name: string; owner_id: string;
+    config: string; created_at: string; updated_at: string;
+  } | undefined;
+
+  if (!dashboard) {
+    res.status(404).json({ error: 'Dashboard not found' });
+    return;
+  }
+
+  const widgets = db.prepare(
+    'SELECT id, dashboard_id, type, config, position_x, position_y, width, height FROM widgets WHERE dashboard_id = ? ORDER BY position_y, position_x'
+  ).all(dashboard.id) as Array<{
+    id: string; dashboard_id: string; type: string; config: string;
+    position_x: number; position_y: number; width: number; height: number;
+  }>;
+
+  res.json({
+    id: dashboard.id,
+    name: dashboard.name,
+    tenantId: dashboard.tenant_id,
+    ownerId: dashboard.owner_id,
+    config: JSON.parse(dashboard.config),
+    widgets: widgets.map((w) => ({
+      id: w.id,
+      dashboardId: w.dashboard_id,
+      type: w.type,
+      config: JSON.parse(w.config),
+      positionX: w.position_x,
+      positionY: w.position_y,
+      width: w.width,
+      height: w.height,
+    })),
+    createdAt: dashboard.created_at,
+    updatedAt: dashboard.updated_at,
+  });
+});
+
+// PUT /api/dashboards/:id - update dashboard
+router.put('/:id', (req: Request, res: Response) => {
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+  const { name, config } = req.body;
+
+  const dashboard = db.prepare(
+    'SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(req.params.id, tenantId) as { id: string } | undefined;
+
+  if (!dashboard) {
+    res.status(404).json({ error: 'Dashboard not found' });
+    return;
+  }
+
+  const now = new Date().toISOString();
+
+  if (name && typeof name === 'string') {
+    db.prepare('UPDATE dashboards SET name = ?, updated_at = ? WHERE id = ?').run(name, now, dashboard.id);
+  }
+  if (config !== undefined) {
+    db.prepare('UPDATE dashboards SET config = ?, updated_at = ? WHERE id = ?').run(JSON.stringify(config), now, dashboard.id);
+  }
+
+  // Fetch updated
+  const updated = db.prepare(
+    'SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE id = ?'
+  ).get(dashboard.id) as {
+    id: string; tenant_id: string; name: string; owner_id: string;
+    config: string; created_at: string; updated_at: string;
+  };
+
+  res.json({
+    id: updated.id,
+    name: updated.name,
+    tenantId: updated.tenant_id,
+    ownerId: updated.owner_id,
+    config: JSON.parse(updated.config),
+    createdAt: updated.created_at,
+    updatedAt: updated.updated_at,
+  });
+});
+
+// DELETE /api/dashboards/:id
+router.delete('/:id', (req: Request, res: Response) => {
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+
+  const dashboard = db.prepare(
+    'SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(req.params.id, tenantId) as { id: string } | undefined;
+
+  if (!dashboard) {
+    res.status(404).json({ error: 'Dashboard not found' });
+    return;
+  }
+
+  db.prepare('DELETE FROM dashboards WHERE id = ?').run(dashboard.id);
+  res.json({ success: true });
+});
+
+export default router;
diff --git a/src/routes/events.ts b/src/routes/events.ts
