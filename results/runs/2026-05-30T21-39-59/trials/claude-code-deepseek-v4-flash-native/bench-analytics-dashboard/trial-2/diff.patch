+import { Router, Request, Response } from 'express';
+import { getDb } from '../db.js';
+import { requireAuth } from '../middleware.js';
+
+const router = Router();
+
+router.use(requireAuth);
+
+// GET /api/exports/events?format=csv|json&name=...&from=...&to=...
+router.get('/events', (req: Request, res: Response) => {
+  const { format, name, from, to } = req.query;
+
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+
+  let sql = 'SELECT id, name, properties, timestamp, user_id, session_id FROM events WHERE tenant_id = ?';
+  const params: (string | undefined)[] = [tenantId];
+
+  if (typeof name === 'string') {
+    sql += ' AND name = ?';
+    params.push(name);
+  }
+  if (typeof from === 'string') {
+    sql += ' AND timestamp >= ?';
+    params.push(from);
+  }
+  if (typeof to === 'string') {
+    sql += ' AND timestamp <= ?';
+    params.push(to);
+  }
+
+  sql += ' ORDER BY timestamp ASC';
+
+  const rows = db.prepare(sql).all(...params) as Array<{
+    id: string; name: string; properties: string; timestamp: string;
+    user_id: string | null; session_id: string | null;
+  }>;
+
+  const outputFormat = format === 'csv' ? 'csv' : 'json';
+
+  if (outputFormat === 'csv') {
+    const headers = ['id', 'name', 'properties', 'timestamp', 'userId', 'sessionId'];
+    const csvRows = rows.map((r) => [
+      escapeCsv(r.id),
+      escapeCsv(r.name),
+      escapeCsv(r.properties),
+      escapeCsv(r.timestamp),
+      escapeCsv(r.user_id ?? ''),
+      escapeCsv(r.session_id ?? ''),
+    ].join(','));
+
+    const csv = headers.join(',') + '\n' + csvRows.join('\n');
+
+    res.setHeader('Content-Type', 'text/csv');
+    res.setHeader('Content-Disposition', 'attachment; filename="events.csv"');
+    res.send(csv);
+  } else {
+    const data = rows.map((r) => ({
+      id: r.id,
+      name: r.name,
+      properties: JSON.parse(r.properties),
+      timestamp: r.timestamp,
+      userId: r.user_id,
+      sessionId: r.session_id,
+    }));
+    res.json(data);
+  }
+});
+
+// GET /api/exports/dashboards/:id?format=csv|json
+router.get('/dashboards/:id', (req: Request, res: Response) => {
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+  const { format } = req.query;
+
+  const dashboard = db.prepare(
+    'SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(req.params.id, tenantId) as {
+    id: string; tenant_id: string; name: string; owner_id: string;
+    config: string; created_at: string; updated_at: string;
+  } | undefined;
+
+  if (!dashboard) {
+    res.status(404).json({ error: 'Dashboard not found' });
+    return;
+  }
+
+  const widgets = db.prepare(
+    'SELECT id, type, config, position_x, position_y, width, height FROM widgets WHERE dashboard_id = ? ORDER BY position_y, position_x'
+  ).all(dashboard.id) as Array<{
+    id: string; type: string; config: string;
+    position_x: number; position_y: number; width: number; height: number;
+  }>;
+
+  const outputFormat = format === 'csv' ? 'csv' : 'json';
+
+  if (outputFormat === 'csv') {
+    // Dashboard-level metadata in CSV is awkward, so export widgets as CSV
+    const headers = ['widgetId', 'type', 'config', 'positionX', 'positionY', 'width', 'height'];
+    const csvRows = widgets.map((w) => [
+      escapeCsv(w.id),
+      escapeCsv(w.type),
+      escapeCsv(w.config),
+      String(w.position_x),
+      String(w.position_y),
+      String(w.width),
+      String(w.height),
+    ].join(','));
+
+    const csv = headers.join(',') + '\n' + csvRows.join('\n');
+
+    res.setHeader('Content-Type', 'text/csv');
+    res.setHeader('Content-Disposition', `attachment; filename="dashboard-${dashboard.id}.csv"`);
+    res.send(csv);
+  } else {
+    res.json({
+      id: dashboard.id,
+      name: dashboard.name,
+      tenantId: dashboard.tenant_id,
+      ownerId: dashboard.owner_id,
+      config: JSON.parse(dashboard.config),
+      widgets: widgets.map((w) => ({
+        id: w.id,
+        type: w.type,
+        config: JSON.parse(w.config),
+        positionX: w.position_x,
+        positionY: w.position_y,
+        width: w.width,
+        height: w.height,
+      })),
+      createdAt: dashboard.created_at,
+      updatedAt: dashboard.updated_at,
+    });
+  }
+});
+
+function escapeCsv(value: string): string {
+  if (value.includes(',') || value.includes('"') || value.includes('\n')) {
+    return '"' + value.replace(/"/g, '""') + '"';
+  }
+  return value;
+}
+
+export default router;
