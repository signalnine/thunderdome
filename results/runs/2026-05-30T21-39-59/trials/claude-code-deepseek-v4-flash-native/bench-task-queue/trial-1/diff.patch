+/**
+ * Core type definitions for the task queue system.
+ *
+ * Phases 1-12: All type definitions are defined here to support
+ * the complete feature set from basic FIFO queues through graceful shutdown.
+ */
+
+// ─── Task Status ───────────────────────────────────────────────────────────
+
+export type TaskStatus =
+  | 'pending'
+  | 'processing'
+  | 'completed'
+  | 'failed'
+  | 'cancelled'
+  | 'blocked';
+
+// ─── Callbacks ─────────────────────────────────────────────────────────────
+
+/** Callback signature for progress updates. */
+export interface ProgressCallback {
+  (taskId: string, progress: number, message?: string): void;
+}
+
+/** Callback signature for shutdown lifecycle events. */
+export interface ShutdownCallback {
+  (): void;
+}
+
+/** Callback signature for middleware functions (sync or async). */
+export type MiddlewareFunction = (
+  task: Task,
+  next: () => void | Promise<void>,
+) => void | Promise<void>;
+
+/** Callback signature for the final processing handler (sync or async). */
+export type ProcessFunction = (task: Task) => unknown | Promise<unknown>;
+
+// ─── Options ───────────────────────────────────────────────────────────────
+
+export interface AddTaskOptions {
+  /** Target queue name. Omit or pass 'default' for the default queue. */
+  queue?: string;
+  /** Priority from 1 (highest) to 10 (lowest). Defaults to 5. */
+  priority?: number;
+  /** Delay in milliseconds before the task becomes available. */
+  delay?: number;
+  /** Specific future time at which the task becomes available. */
+  availableAt?: Date;
+  /** Maximum number of retries on failure (default 3). */
+  maxRetries?: number;
+  /** Base backoff delay in milliseconds (default 1000). */
+  backoffDelay?: number;
+  /** Task IDs this task depends on completing. */
+  dependencies?: string[];
+}
+
+export interface ScheduleConfig {
+  /** Cron expression like "star/5 star star star star" (every 5 min) or "0 star star star star" (hourly). */
+  cron: string;
+  /** Target queue name. */
+  queue: string;
+  /** Payload to use each time the schedule fires. */
+  payload: unknown;
+}
+
+// ─── Domain Objects ────────────────────────────────────────────────────────
+
+/** Public representation of a task — read-only view of internal state. */
+export interface Task {
+  readonly id: string;
+  readonly status: TaskStatus;
+  readonly payload: unknown;
+  readonly priority: number;
+  readonly createdAt: Date;
+  readonly availableAt: Date | null;
+  readonly attempts: number;
+  readonly maxRetries: number;
+  readonly backoffDelay: number;
+  readonly dependencies: readonly string[];
+  readonly progress: number;
+  readonly progressMessage: string;
+  readonly error: string | null;
+  readonly result: unknown;
+  readonly queueName: string;
+  readonly startedAt: Date | null;
+  readonly completedAt: Date | null;
+  readonly cancelledAt: Date | null;
+}
+
+/** Public representation of a recurring schedule. */
+export interface Schedule {
+  readonly id: string;
+  readonly cron: string;
+  readonly queue: string;
+  readonly payload: unknown;
+  readonly createdAt: Date;
+  readonly lastEnqueuedAt: Date | null;
+}
+
+/** Result produced by the graceful shutdown operation. */
+export interface ShutdownResult {
+  completed: number;
+  cancelled: number;
+  duration: number;
+}
+
+// ─── Internal Types (not exported) ─────────────────────────────────────────
+
+/** Mutable internal task representation. */
+export interface TaskData {
+  id: string;
+  status: TaskStatus;
+  payload: unknown;
+  priority: number;
+  createdAt: Date;
+  availableAt: Date | null;
+  attempts: number;
+  maxRetries: number;
+  backoffDelay: number;
+  dependencies: string[];
+  /** Set of task IDs that depend on this task. */
+  dependents: Set<string>;
+  progress: number;
+  progressMessage: string;
+  error: string | null;
+  result: unknown;
+  queueName: string;
+  startedAt: Date | null;
+  completedAt: Date | null;
+  cancelledAt: Date | null;
+}
+
+/** Mutable internal schedule representation. */
+export interface ScheduleData {
+  id: string;
+  cron: string;
+  queue: string;
+  payload: unknown;
+  createdAt: Date;
+  lastEnqueuedAt: Date | null;
+}
+
+/** Per-queue state tracked by the queue manager. */
+export interface QueueState {
+  /** Pending tasks sorted by priority (asc) then createdAt (asc). */
+  pending: TaskData[];
+  /** Tasks blocked on unresolved dependencies, keyed by id. */
+  blocked: Map<string, TaskData>;
+  /** Dead-lettered tasks (exhausted retries). */
+  deadLetter: TaskData[];
+  /** Maximum concurrent processing slots (0 = unlimited). */
+  maxConcurrency: number;
+  /** Registered middleware functions. */
+  middleware: MiddlewareFunction[];
+  /** Registered processing handler, if any. */
+  handler: ProcessFunction | null;
+}
