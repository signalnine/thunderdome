.add('second');\n      queue.add('third');\n      expect(queue.getNext()?.payload).toBe('first');\n      expect(queue.getNext()?.payload).toBe('second');\n      expect(queue.getNext()?.payload).toBe('third');\n    });\n\n    it('should transition a task to processing on getNext', () => {\n      const task = queue.add('test');\n      const retrieved = queue.getNext();\n      expect(retrieved?.id).toBe(task.id);\n      expect(retrieved?.status).toBe('processing');\n      expect(retrieved?.startedAt).toBeInstanceOf(Date);\n    });\n\n    it('should return null when no tasks are available', () => {\n      expect(queue.getNext()).toBeNull();\n    });\n\n    it('should return null after all tasks are retrieved', () => {\n      queue.add('only');\n      queue.getNext();\n      expect(queue.getNext()).toBeNull();\n    });\n\n    it('should report the correct queue size', () => {\n      expect(queue.getQueueSize()).toBe(0);\n      queue.add('a');\n      expect(queue.getQueueSize()).toBe(1);\n      queue.add('b');\n      expect(queue.getQueueSize()).toBe(2);\n      queue.getNext();\n      expect(queue.getQueueSize()).toBe(1);\n      queue.getNext();\n      expect(queue.getQueueSize()).toBe(0);\n    });\n  });\n\n  // ──── Phase 2: Named Queues ──────────────────────────────────────────────\n  describe('Phase 2: Named Queues', () => {\n    it('should use a default queue when no name is given', () => {\n      queue.add('default task');\n      expect(queue.listQueues()).toContain('default');\n    });\n\n    it('should add tasks to a named queue', () => {\n      queue.add('email', { queue: 'emails' });\n      expect(queue.listQueues()).toContain('emails');\n    });\n\n    it('should retrieve tasks from the correct queue only', () => {\n      queue.add('urgent email', { queue: 'emails' });\n      queue.add('normal log', { queue: 'logs' });\n      expect(queue.getNext('emails')?.payload).toBe('urgent email');\n      expect(queue.getQueueSize('logs')).toBe(1);\n      expect(queue.getNext('default')).toBeNull();\n    });\n\n    it('should keep queues independent', () => {\n      queue.add('a', { queue: 'q1' });\n      queue.add('b', { queue: 'q2' });\n      queue.add('c', { queue: 'q1' });\n      expect(queue.getNext('q1')?.payload).toBe('a');\n      expect(queue.getNext('q2')?.payload).toBe('b');\n      expect(queue.getQueueSize('q1')).toBe(1);\n      expect(queue.getQueueSize('q2')).toBe(0);\n    });\n\n    it('should create a queue implicitly on first task', () => {\n      expect(queue.listQueues()).toEqual([]);\n      queue.add('first', { queue: 'myqueue' });\n      expect(queue.listQueues()).toContain('myqueue');\n    });\n\n    it('should return null for non-existent queues', () => {\n      expect(queue.getNext('nonexistent')).toBeNull();\n    });\n\n    it('should return 0 queue size for non-existent queues', () => {\n      expect(queue.getQueueSize('nonexistent')).toBe(0);\n    });\n\n    it('should be backward compatible: no queue name uses default', () => {\n      queue.add('legacy');\n      expect(queue.getNext()?.payload).toBe('legacy');\n    });\n  });\n\n  // ──── Phase 3: Priority ──────────────────────────────────────────────────\n  describe('Phase 3: Priority', () => {\n    it('should return higher priority tasks first (1 = highest)', () => {\n      queue.add('low', { priority: 10 });\n      queue.add('medium', { priority: 5 });\n      queue.add('high', { priority: 1 });\n      expect(queue.getNext()?.payload).toBe('high');\n      expect(queue.getNext()?.payload).toBe('medium');\n      expect(queue.getNext()?.payload).toBe('low');\n    });\n\n    it('should use FIFO order within the same priority', () => {\n      queue.add('first', { priority: 5 });\n      queue.add('second', { priority: 5 });\n      queue.add('third', { priority: 5 });\n      expect(queue.getNext()?.payload).toBe('first');\n      expect(queue.getNext()?.payload).toBe('second');\n      expect(queue.getNext()?.payload).toBe('third');\n    });\n\n    it('should default to priority 5', () => {\n      const task = queue.add('test');\n      expect(task.priority).toBe(5);\n    });\n\n    it('should expose priority on the task object', () => {\n      const task = queue.add('test', { priority: 1 });\n      expect(task.priority).toBe(1);\n    });\n\n    it('should reject invalid priority values outside 1-10', () => {\n      expect(() => queue.add('bad', { priority: 0 })).toThrow(InvalidPriorityError);\n      expect(() => queue.add('bad', { priority: 11 })).toThrow(InvalidPriorityError);\n      expect(() => queue.add('bad', { priority: -1 })).toThrow(InvalidPriorityError);\n    });\n\n    it('should reject non-integer priority values', () => {\n      expect(() => queue.add('bad', { priority: 3.5 })).toThrow(InvalidPriorityError);\n    });\n\n    it('should maintain separate priority ordering per queue', () => {\n      queue.add('q1-high', { queue: 'q1', priority: 1 });\n      queue.add('q2-high', { queue: 'q2', priority: 1 });\n      queue.add('q1-low', { queue: 'q1', priority: 10 });\n      expect(queue.getNext('q1')?.payload).toBe('q1-high');\n      expect(queue.getNext('q2')?.payload).toBe('q2-high');\n      expect(queue.getNext('q1')?.payload).toBe('q1-low');\n    });\n  });\n\n  // ──── Phase 4: Delayed Tasks ─────────────────────────────────────────────\n  describe('Phase 4: Delayed Tasks', () => {\n    beforeEach(() => {\n      vi.useFakeTimers();\n    });\n\n    it('should not return a delayed task before its delay elapses', () => {\n      queue.add('delayed', { delay: 10_000 });\n      expect(queue.getNext()).toBeNull();\n    });\n\n    it('should return a delayed task after its delay elapses', () => {\n      queue.add('delayed', { delay: 10_000 });\n      advance(10_000);\n      expect(queue.getNext()?.payload).toBe('delayed');\n    });\n\n    it('should prefer a non-delayed task over an unavailable delayed one', () => {\n      queue.add('delayed', { delay: 10_000 });\n      queue.add('immediate', { priority: 10 });\n      expect(queue.getNext()?.payload).toBe('immediate');\n    });\n\n    it('should order multiple delayed tasks by availability then priority then FIFO', () => {\n      queue.add('first-delayed', { delay: 5000, priority: 5 });\n      queue.add('high-priority', { delay: 2000, priority: 1 });\n      queue.add('second-delayed', { delay: 5000, priority: 5 });\n      expect(queue.getNext()).toBeNull();\n      advance(2000);\n      expect(queue.getNext()?.payload).toBe('high-priority');\n      advance(3000);\n      expect(queue.getNext()?.payload).toBe('first-delayed');\n      expect(queue.getNext()?.payload).toBe('second-delayed');\n    });\n\n    it('should expose availableAt on the task object', () => {\n      const task = queue.add('delayed', { delay: 5000 });\n      expect(task.availableAt).toBeInstanceOf(Date);\n      expect(task.availableAt!.getTime()).toBeGreaterThan(Date.now());\n    });\n\n    it('should support a specific future time via availableAt', () => {\n      const future = new Date(Date.now() + 30_000);\n      queue.add('scheduled', { availableAt: future });\n      expect(queue.getNext()).toBeNull();\n      advance(30_000);\n      expect(queue.getNext()?.payload).toBe('scheduled');\n    });\n\n    it('should reject both delay and availableAt together', () => {\n      expect(() =>\n        queue.add('bad', { delay: 1000, availableAt: new Date(Date.now() + 2000) }),\n      ).toThrow(TaskQueueError);\n    });\n\n    it('should reject negative delay', () => {\n      expect(() => queue.add('bad', { delay: -1 })).toThrow(TaskQueueError);\n    });\n  });\n\n  // ──── Phase 5: Retry with Backoff ────────────────────────────────────────\n  describe('Phase 5: Retry with Backoff', () => {\n    beforeEach(() => {\n      vi.useFakeTimers();\n    });\n\n    it('should allow completing a task successfully', () => {\n      const task = queue.add('test');\n      queue.getNext();\n      queue.complete(task.id, { result: 'ok' });\n      expect(queue.getTask(task.id)?.status).toBe('completed');\n      expect(queue.getTask(task.id)?.result).toEqual({ result: 'ok' });\n    });\n\n    it('should throw when completing a task not in processing state', () => {\n      const task = queue.add('test');\n      expect(() => queue.complete(task.id)).toThrow(TaskQueueError);\n    });\n\n    it('should re-enqueue a failed task when retries remain', () => {\n      const task = queue.add('retry-me', { maxRetries: 3, backoffDelay: 100 });\n      queue.getNext();\n      queue.fail(task.id, 'something went wrong');\n      expect(queue.getTask(task.id)?.status).toBe('pending');\n      expect(queue.getQueueSize()).toBe(1);\n    });\n\n    it('should apply exponential backoff on retry', () => {\n      const task = queue.add('retry-me', { maxRetries: 3, backoffDelay: 1000 });\n      const now = Date.now();\n      queue.getNext();\n      queue.fail(task.id, 'fail 1');\n      // Backoff: 1000 * 2^0 = 1000ms\n      expect(queue.getTask(task.id)?.availableAt!.getTime()).toBe(now + 1000);\n      advance(1000);\n      queue.getNext();\n      queue.fail(task.id, 'fail 2');\n      // Backoff: 1000 * 2^1 = 2000ms\n      expect(queue.getTask(task.id)?.availableAt!.getTime()).toBe(now + 1000 + 2000);\n    });\n\n    it('should track the number of attempts', () => {\n      const task = queue.add('retry-me', { maxRetries: 3 });\n      queue.getNext();\n      queue.fail(task.id);\n      expect(queue.getTask(task.id)?.attempts).toBe(1);\n      advance(1000);\n      queue.getNext();\n      queue.fail(task.id);\n      expect(queue.getTask(task.id)?.attempts).toBe(2);\n    });\n\n    it('should keep the original queue and priority on retry', () => {\n      const task = queue.add('retry-me', { queue: 'critical', priority: 1, maxRetries: 3 });\n      queue.getNext('critical');\n      queue.fail(task.id);\n      advance(1000);\n      const retried = queue.getNext('critical');\n      expect(retried?.queueName).toBe('critical');\n      expect(retried?.priority).toBe(1);\n    });\n\n    it('should move to failed state when retries exhausted', () => {\n      const task = queue.add('doomed', { maxRetries: 1, backoffDelay: 10 });\n      queue.getNext();\n      queue.fail(task.id, 'fail once');\n      // attempts=0 < maxRetries=1 → retry, attempts becomes 1\n      expect(queue.getTask(task.id)?.status).toBe('pending');\n      expect(queue.getTask(task.id)?.attempts).toBe(1);\n      advance(10);\n      queue.getNext();\n      queue.fail(task.id, 'fail twice');\n      // attempts=1, maxRetries=1 → no retry → DLQ\n      expect(queue.getTask(task.id)?.status).toBe('failed');\n      expect(queue.getTask(task.id)?.error).toBe('fail twice');\n      expect(queue.getTask(task.id)?.attempts).toBe(2);\n    });\n\n    it('should throw when failing a non-processing task', () => {\n      const task = queue.add('test');\n      expect(() => queue.fail(task.id)).toThrow(TaskQueueError);\n    });\n  });\n\n  // ──── Phase 6: Dead Letter Queue ─────────────────────────────────────────\n  describe('Phase 6: Dead Letter Queue', () => {\n    it('should move exhausted tasks to the dead letter queue', () => {\n      const task = queue.add('doomed', { maxRetries: 0 });\n      queue.getNext();\n      queue.fail(task.id, 'final error');\n      expect(queue.getTask(task.id)?.status).toBe('failed');\n      const dlq = queue.getDeadLetterTasks();\n      expect(dlq).toHaveLength(1);\n      expect(dlq[0].id).toBe(task.id);\n    });\n\n    it('should retain error information in dead letter entries', () => {\n      const task = queue.add('doomed', { maxRetries: 0 });\n      queue.getNext();\n      queue.fail(task.id, 'disk full');\n      const dlq = queue.getDeadLetterTasks();\n      expect(dlq[0].error).toBe('disk full');\n      expect(dlq[0].attempts).toBe(1);\n    });\n\n    it('should support per-queue dead letter queues', () => {\n      const t1 = queue.add('a', { queue: 'q1', maxRetries: 0 });\n      const t2 = queue.add('b', { queue: 'q2', maxRetries: 0 });\n      queue.getNext('q1');\n      queue.fail(t1.id);\n      queue.getNext('q2');\n      queue.fail(t2.id);\n      expect(queue.getDeadLetterTasks('q1')).toHaveLength(1);\n      expect(queue.getDeadLetterTasks('q2')).toHaveLength(1);\n      expect(queue.getDeadLetterTasks('default')).toHaveLength(0);\n    });\n\n    it('should allow retrying a dead letter task', () => {\n      const task = queue.add('retry-dlq', { maxRetries: 0 });\n      queue.getNext();\n      queue.fail(task.id);\n      expect(queue.getDeadLetterTasks()).toHaveLength(1);\n      queue.retryDeadLetter(task.id);\n      expect(queue.getDeadLetterTasks()).toHaveLength(0);\n      expect(queue.getTask(task.id)?.status).toBe('pending');\n      expect(queue.getTask(task.id)?.attempts).toBe(0);\n      const retried = queue.getNext();\n      expect(retried).not.toBeNull();\n      expect(retried!.id).toBe(task.id);\n    });\n\n    it('should clear dead letter tasks for a queue', () => {\n      const t1 = queue.add('a', { maxRetries: 0 });\n      const t2 = queue.add('b', { maxRetries: 0 });\n      queue.getNext();\n      queue.fail(t1.id);\n      queue.getNext();\n      queue.fail(t2.id);\n      expect(queue.getDeadLetterTasks()).toHaveLength(2);\n      queue.clearDeadLetter();\n      expect(queue.getDeadLetterTasks()).toHaveLength(0);\n      expect(queue.getTask(t1.id)).toBeNull();\n    });\n  });\n\n  // ──── Phase 7: Task Dependencies ─────────────────────────────────────────\n  describe('Phase 7: Task Dependencies', () => {\n    it('should block a task that depends on an incomplete task', () => {\n      const dep = queue.add('dependency');\n      const dependent = queue.add('dependent', { dependencies: [dep.id] });\n      expect(queue.getTask(dependent.id)?.status).toBe('blocked');\n    });\n\n    it('should not return a blocked task from getNext', () => {\n      const dep = queue.add('dependency');\n      queue.add('dependent', { dependencies: [dep.id] });\n      expect(queue.getNext()).not.toBeNull(); // The dependency\n      expect(queue.getNext()).toBeNull(); // Dependent is still blocked\n    });\n\n    it('should unblock a task when its dependency completes', () => {\n      const dep = queue.add('dependency');\n      const dependent = queue.add('dependent', { dependencies: [dep.id] });\n      expect(queue.getTask(dependent.id)?.status).toBe('blocked');\n      queue.getNext();\n      queue.complete(dep.id);\n      expect(queue.getTask(dependent.id)?.status).toBe('pending');\n    });\n\n    it('should make a dependent available after its dependency completes', () => {\n      const dep = queue.add('dependency');\n      queue.add('dependent', { dependencies: [dep.id] });\n      queue.getNext(); // claim dep\n      queue.complete(dep.id);\n      expect(queue.getNext()).not.toBeNull();\n    });\n\n    it('should throw MissingDependencyError for non-existent dependencies', () => {\n      expect(() =>\n        queue.add('orphan', { dependencies: ['nonexistent-id'] }),\n      ).toThrow(MissingDependencyError);\n    });\n\n    it('should allow valid linear dependency chains', () => {\n      const a = queue.add('a');\n      const b = queue.add('b', { dependencies: [a.id] });\n      const c = queue.add('c', { dependencies: [b.id] });\n      expect(queue.getTask(b.id)?.status).toBe('blocked');\n      expect(queue.getTask(c.id)?.status).toBe('blocked');\n    });\n\n    it('should not fail dependents when a dependency fails', () => {\n      const dep = queue.add('dep');\n      const dependent = queue.add('dependent', { dependencies: [dep.id] });\n      expect(queue.getTask(dependent.id)?.status).toBe('blocked');\n      queue.getNext(); // get dep\n      queue.fail(dep.id, 'error');\n      expect(queue.getTask(dependent.id)?.status).toBe('blocked');\n    });\n\n    it('should allow inspecting dependency info on a task', () => {\n      const depA = queue.add('depA');\n      const depB = queue.add('depB');\n      const task = queue.add('task', { dependencies: [depA.id, depB.id] });\n      expect(task.dependencies).toEqual([depA.id, depB.id]);\n      expect(task.status).toBe('blocked');\n    });\n  });\n\n  // ──── Phase 8: Concurrency Control ───────────────────────────────────────\n  describe('Phase 8: Concurrency Control', () => {\n    it('should limit the number of concurrently processing tasks', () => {\n      queue.setConcurrency(1);\n      queue.add('first');\n      queue.add('second');\n      queue.getNext(); // Claims first\n      expect(queue.getNext()).toBeNull(); // Second blocked by concurrency\n    });\n\n    it('should allow more tasks when concurrency is freed by completion', () => {\n      queue.setConcurrency(1);\n      const task = queue.add('only');\n      queue.getNext();\n      queue.complete(task.id);\n      expect(queue.getNext()).toBeNull(); // No more tasks\n    });\n\n    it('should free concurrency slot on permanent failure', () => {\n      queue.setConcurrency(1);\n      const task = queue.add('only', { maxRetries: 0 });\n      queue.getNext();\n      queue.fail(task.id, 'error');\n      expect(queue.getNext()).toBeNull(); // No more tasks\n    });\n\n    it('should default to unlimited concurrency (0)', () => {\n      expect(queue.getConcurrency()).toBe(0);\n      queue.add('a');\n      queue.add('b');\n      queue.getNext();\n      expect(queue.getNext()?.payload).toBe('b'); // Both can be processing\n    });\n\n    it('should report active count correctly', () => {\n      queue.add('a');\n      queue.add('b');\n      expect(queue.getActiveCount()).toBe(0);\n      queue.getNext();\n      expect(queue.getActiveCount()).toBe(1);\n      queue.getNext();\n      expect(queue.getActiveCount()).toBe(2);\n    });\n\n    it('should support per-queue concurrency limits', () => {\n      queue.setConcurrency(1, 'limited');\n      queue.setConcurrency(0, 'unlimited');\n      queue.add('a', { queue: 'limited' });\n      queue.add('b', { queue: 'limited' });\n      queue.getNext('limited');\n      expect(queue.getNext('limited')).toBeNull();\n    });\n\n    it('should respect priority ordering within concurrency limits', () => {\n      queue.setConcurrency(1);\n      queue.add('high', { priority: 1 });\n      queue.add('low', { priority: 10 });\n      expect(queue.getNext()?.payload).toBe('high');\n    });\n  });\n\n  // ──── Phase 9: Progress and Cancellation ─────────────────────────────────\n  describe('Phase 9: Progress and Cancellation', () => {\n    it('should report progress on a task', () => {\n      const task = queue.add('test');\n      queue.getNext();\n      queue.reportProgress(task.id, 50, 'halfway');\n      expect(queue.getTask(task.id)?.progress).toBe(50);\n      expect(queue.getTask(task.id)?.progressMessage).toBe('halfway');\n    });\n\n    it('should clamp progress values to 0-100', () => {\n      const task = queue.add('test');\n      queue.getNext();\n      queue.reportProgress(task.id, -10);\n      expect(queue.getTask(task.id)?.progress).toBe(0);\n      queue.reportProgress(task.id, 150);\n      expect(queue.getTask(task.id)?.progress).toBe(100);\n    });\n\n    it('should notify progress listeners', () => {\n      const task = queue.add('test');\n      queue.getNext();\n      const cb = vi.fn();\n      queue.onProgress(task.id, cb);\n      queue.reportProgress(task.id, 42, 'updating');\n      expect(cb).toHaveBeenCalledWith(task.id, 42, 'updating');\n    });\n\n    it('should return an unsubscribe function from onProgress', () => {\n      const task = queue.add('test');\n      queue.getNext();\n      const cb = vi.fn();\n      const unsubscribe = queue.onProgress(task.id, cb);\n      unsubscribe();\n      queue.reportProgress(task.id, 100);\n      expect(cb).not.toHaveBeenCalled();\n    });\n\n    it('should cancel a pending task', () => {\n      const task = queue.add('pending');\n      queue.cancel(task.id);\n      expect(queue.getTask(task.id)?.status).toBe('cancelled');\n      expect(queue.getTask(task.id)?.cancelledAt).toBeInstanceOf(Date);\n      expect(queue.getNext()).toBeNull();\n    });\n\n    it('should cancel a processing task', () => {\n      const task = queue.add('processing');\n      queue.getNext();\n      queue.cancel(task.id);\n      expect(queue.getTask(task.id)?.status).toBe('cancelled');\n    });\n\n    it('should reject cancelling a completed task', () => {\n      const task = queue.add('done');\n      queue.getNext();\n      queue.complete(task.id);\n      expect(() => queue.cancel(task.id)).toThrow(TaskQueueError);\n    });\n\n    it('should reject cancelling a failed task', () => {\n      const failTask = queue.add('failed', { maxRetries: 0 });\n      queue.getNext();\n      queue.fail(failTask.id, 'err');\n      expect(() => queue.cancel(failTask.id)).toThrow(TaskQueueError);\n    });\n  });\n\n  // ──── Phase 10: Recurring Tasks ──────────────────────────────────────────\n  describe('Phase 10: Recurring Tasks', () => {\n    beforeEach(() => {\n      vi.useFakeTimers();\n    });\n\n    it('should create a schedule and list it', () => {\n      const schedule = queue.addSchedule({\n        cron: '*/5 * * * *',\n        queue: 'default',\n        payload: 'recurring',\n      });\n      expect(schedule).toHaveProperty('id');\n      expect(schedule.cron).toBe('*/5 * * * *');\n      expect(queue.listSchedules()).toHaveLength(1);\n    });\n\n    it('should remove a schedule', () => {\n      const s = queue.addSchedule({\n        cron: '*/5 * * * *',\n        queue: 'default',\n        payload: 'recurring',\n      });\n      queue.removeSchedule(s.id);\n      expect(queue.listSchedules()).toHaveLength(0);\n    });\n\n    it('should enqueue tasks via tick() when cron matches', () => {\n      queue.addSchedule({ cron: '*/5 * * * *', queue: 'default', payload: 'recurring' });\n      vi.setSystemTime(new Date('2024-06-15T10:00:00'));\n      queue.tick();\n      expect(queue.getQueueSize()).toBe(1);\n      // Tick again at same minute — should deduplicate\n      queue.tick();\n      expect(queue.getQueueSize()).toBe(1);\n    });\n\n    it('should not enqueue when cron does not match', () => {\n      queue.addSchedule({ cron: '0 * * * *', queue: 'default', payload: 'hourly' });\n      vi.setSystemTime(new Date('2024-06-15T10:05:00')); // minute 5\n      queue.tick();\n      expect(queue.getQueueSize()).toBe(0);\n    });\n\n    it('should enqueue at the next matching interval', () => {\n      queue.addSchedule({ cron: '*/5 * * * *', queue: 'default', payload: 'recurring' });\n      vi.setSystemTime(new Date('2024-06-15T10:00:00'));\n      queue.tick();\n      expect(queue.getQueueSize()).toBe(1);\n      vi.setSystemTime(new Date('2024-06-15T10:05:00'));\n      queue.tick();\n      expect(queue.getQueueSize()).toBe(2);\n    });\n\n    it('should enqueue tasks that follow all queue rules', () => {\n      queue.addSchedule({ cron: '*/5 * * * *', queue: 'default', payload: 'recurring' });\n      vi.setSystemTime(new Date('2024-06-15T10:00:00'));\n      queue.tick();\n      const task = queue.getNext();\n      expect(task?.payload).toBe('recurring');\n      expect(task?.status).toBe('processing');\n    });\n  });\n\n  // ──── Phase 11: Middleware ───────────────────────────────────────────────\n  describe('Phase 11: Middleware', () => {\n    it('should call middleware in registration order', async () => {\n      const order: number[] = [];\n      queue.use(async (_task, next) => { order.push(1); await next(); });\n      queue.use(async (_task, next) => { order.push(2); await next(); });\n      queue.process(async (_task) => { order.push(3); return 'done'; });\n      queue.add('test');\n      await queue.processNext();\n      expect(order).toEqual([1, 2, 3]);\n    });\n\n    it('should invoke middleware when processing', async () => {\n      const spy = vi.fn();\n      queue.use((_task, next) => { spy('called'); next(); });\n      queue.process(async (_task) => 'result');\n      queue.add('test');\n      await queue.processNext();\n      expect(spy).toHaveBeenCalledWith('called');\n    });\n\n    it('should support middleware that skips processing by not calling next', async () => {\n      queue.use(() => { /* doesn't call next */ });\n      const handlerSpy = vi.fn();\n      queue.process(handlerSpy);\n      queue.add('test');\n      await queue.processNext();\n      expect(handlerSpy).not.toHaveBeenCalled();\n    });\n\n    it('should mark task as failed when middleware throws', async () => {\n      queue.use(() => { throw new Error('middleware error'); });\n      queue.process(async (_task) => 'done');\n      queue.add('test', { maxRetries: 0 });\n      const task = await queue.processNext();\n      expect(task?.status).toBe('failed');\n      expect(task?.error).toContain('middleware error');\n    });\n\n    it('should allow middleware to modify the task payload', async () => {\n      queue.use((task, next) => {\n        (task as { payload: Record<string, unknown> }).payload.modified = true;\n        next();\n      });\n      queue.process(async (task) => task.payload);\n      queue.add({ original: true });\n      const task = await queue.processNext();\n      expect(task?.status).toBe('completed');\n      const result = task?.result as { modified?: boolean; original?: boolean };\n      expect(result?.modified).toBe(true);\n    });\n\n    it('should keep middleware isolated per queue', async () => {\n      const mwSpy = vi.fn();\n      queue.use(mwSpy, 'monitored');\n      queue.use(() => {}, 'default');\n      queue.add('test', { queue: 'monitored' });\n      await queue.processNext('monitored');\n      expect(mwSpy).toHaveBeenCalled();\n    });\n  });\n\n  // ──── Phase 12: Graceful Shutdown ────────────────────────────────────────\n  describe('Phase 12: Graceful Shutdown', () => {\n    it('should report isShuttingDown as false initially', () => {\n      expect(queue.isShuttingDown).toBe(false);\n    });\n\n    it('should reject new tasks after shutdown is initiated', () => {\n      queue.shutdown(100);\n      expect(() => queue.add('new task')).toThrow(ShutdownError);\n    });\n\n    it('should complete immediately when no tasks are processing', async () => {\n      const result = await queue.shutdown(100);\n      expect(result.completed).toBe(0);\n      expect(result.cancelled).toBe(0);\n      expect(result.duration).toBeGreaterThanOrEqual(0);\n    });\n\n    it('should wait for a processing task to complete', async () => {\n      vi.useFakeTimers();\n      queue.add('processing-task');\n      const task = queue.getNext();\n      const shutdownPromise = queue.shutdown(10_000);\n      queue.complete(task!.id);\n      advance(0); // flush microtasks so the drain resolver runs\n      const result = await shutdownPromise;\n      expect(result.completed).toBe(1);\n      expect(result.cancelled).toBe(0);\n    });\n\n    it('should force-cancel tasks that exceed the shutdown timeout', async () => {\n      vi.useFakeTimers();\n      queue.add('slow-task');\n      queue.getNext();\n      const shutdownPromise = queue.shutdown(5_000);\n      advance(5_000); // past the timeout\n      const result = await shutdownPromise;\n      expect(result.cancelled).toBe(1);\n    });\n\n    it('should call shutdown lifecycle callbacks', async () => {\n      const cb = vi.fn();\n      queue.onShutdown(cb);\n      await queue.shutdown(100);\n      expect(cb).toHaveBeenCalled();\n    });\n\n    it('should be safe to call shutdown multiple times', async () => {\n      const a = await queue.shutdown(100);\n      const b = await queue.shutdown(100);\n      expect(b.completed).toBe(a.completed);\n      expect(b.cancelled).toBe(a.cancelled);\n    });\n  });\n\n  // ──── Integration & Edge Cases ───────────────────────────────────────────\n  describe('Integration & Edge Cases', () => {\n    it('should handle empty queue operations gracefully', () => {\n      expect(queue.getNext()).toBeNull();\n      expect(queue.getQueueSize()).toBe(0);\n      expect(queue.listQueues()).toEqual([]);\n    });\n\n    it('should handle tasks with undefined payload', () => {\n      const task = queue.add(undefined);\n      expect(task.payload).toBeUndefined();\n      expect(queue.getNext()?.payload).toBeUndefined();\n    });\n\n    it('should handle tasks with null payload', () => {\n      const task = queue.add(null);\n      expect(task.payload).toBeNull();\n      expect(queue.getNext()?.payload).toBeNull();\n    });\n\n    it('should handle 100 tasks in order', () => {\n      const count = 100;\n      for (let i = 0; i < count; i++) queue.add(i);\n      expect(queue.getQueueSize()).toBe(count);\n      for (let i = 0; i < count; i++) {\n        expect(queue.getNext()?.payload).toBe(i);\n      }\n      expect(queue.getNext()).toBeNull();\n    });\n\n    it('should integrate priority, delay, and retry', () => {\n      vi.useFakeTimers();\n      queue.add('high-delayed', { priority: 1, delay: 5000 });\n      queue.add('low-immediate', { priority: 10 });\n      // Immediate task is returned first despite lower priority\n      let task = queue.getNext();\n      expect(task?.payload).toBe('low-immediate');\n      queue.complete(task!.id);\n      // Delayed task not yet available\n      expect(queue.getNext()).toBeNull();\n      advance(5000);\n      // Delayed high-priority task is now available\n      task = queue.getNext();\n      expect(task?.payload).toBe('high-delayed');\n      // Fail it — should retry with backoff\n      queue.fail(task!.id, 'transient error');\n      expect(queue.getTask(task!.id)?.status).toBe('pending');\n      expect(queue.getTask(task!.id)?.attempts).toBe(1);\n    });\n\n    it('should integrate dependencies with named queues', () => {\n      const dep = queue.add('setup', { queue: 'init' });\n      queue.add('process', { queue: 'work', dependencies: [dep.id] });\n      queue.getNext('init');\n      queue.complete(dep.id);\n      const processTask = queue.getNext('work');\n      expect(processTask?.payload).toBe('process');\n    });\n\n    it('should integrate concurrency with priority ordering'