found: ${taskIds.join(', ')}`);\n    this.name = 'MissingDependencyError';\n  }\n}\n\nexport class ShutdownError extends TaskQueueError {\n  constructor() {\n    super('Task queue is shutting down. No new tasks accepted.');\n    this.name = 'ShutdownError';\n  }\n}\n\n// ─── Helpers ───────────────────────────────────────────────────────────────\n\nfunction validatePriority(priority: number): void {\n  if (!Number.isInteger(priority) || priority < 1 || priority > 10) {\n    throw new InvalidPriorityError(priority);\n  }\n}\n\n/** Compare function for sorting pending tasks: priority asc, then createdAt asc. */\nfunction comparePendingTasks(a: TaskData, b: TaskData): number {\n  if (a.priority !== b.priority) return a.priority - b.priority;\n  return a.createdAt.getTime() - b.createdAt.getTime();\n}\n\n// ─── Main TaskQueue ────────────────────────────────────────────────────────\n\n/**\n * In-memory task queue supporting 12 phases of features:\n *  - Basic FIFO, named queues, priority, delays, retry/backoff, DLQ,\n *    dependencies, concurrency control, progress/cancellation,\n *    recurring schedules, middleware, graceful shutdown.\n */\nexport class TaskQueue {\n  // ── Private State ──────────────────────────────────────────────────────\n\n  private queues = new Map<string, QueueState>();\n  /** Global task index by id for fast lookup. */\n  private tasks = new Map<string, TaskData>();\n  /** Active recurring schedules. */\n  private schedules = new Map<string, ScheduleData>();\n  /** Progress subscribers keyed by task id. */\n  private progressListeners = new Map<string, Set<ProgressCallback>>();\n  /** Shutdown lifecycle callbacks. */\n  private shutdownCallbacks = new Set<ShutdownCallback>();\n\n  // Shutdown state\n  private _shuttingDown = false;\n  private _shutdownPromise: Promise<ShutdownResult> | null = null;\n  /** Resolver called when all processing tasks finish. */\n  private _drainResolver: (() => void) | null = null;\n\n  // Unique id counter\n  private _idCounter = 0;\n\n  // ── Queue Management ──────────────────────────────────────────────────\n\n  private getOrCreateQueue(name: string): QueueState {\n    let q = this.queues.get(name);\n    if (!q) {\n      q = {\n        pending: [],\n        blocked: new Map(),\n        deadLetter: [],\n        maxConcurrency: 0,\n        middleware: [],\n        handler: null,\n      };\n      this.queues.set(name, q);\n    }\n    return q;\n  }\n\n  private getQueue(name: string): QueueState | undefined {\n    return this.queues.get(name);\n  }\n\n  // ── ID Generation ─────────────────────────────────────────────────────\n\n  private nextId(): string {\n    return `task_${Date.now().toString(36)}_${(++this._idCounter).toString(36)}`;\n  }\n\n  // ── Sorting Helpers ───────────────────────────────────────────────────\n\n  /** Insert a task into the pending array maintaining sort order. */\n  private insertPending(queue: QueueState, task: TaskData): void {\n    const arr = queue.pending;\n    // Binary search insertion point\n    let lo = 0;\n    let hi = arr.length;\n    while (lo < hi) {\n      const mid = (lo + hi) >>> 1;\n      if (comparePendingTasks(arr[mid], task) <= 0) {\n        lo = mid + 1;\n      } else {\n        hi = mid;\n      }\n    }\n    arr.splice(lo, 0, task);\n  }\n\n  // ── Circular Dependency Detection ─────────────────────────────────────\n\n  private detectCircularDependency(\n    taskId: string,\n    dependencies: string[],\n    visited = new Set<string>(),\n  ): boolean {\n    if (visited.has(taskId)) return true;\n    visited.add(taskId);\n    for (const depId of dependencies) {\n      const dep = this.tasks.get(depId);\n      if (!dep) continue; // Already validated existence elsewhere\n      if (dep.dependencies.length > 0) {\n        if (this.detectCircularDependency(depId, dep.dependencies, visited)) {\n          return true;\n        }\n      }\n    }\n    visited.delete(taskId);\n    return false;\n  }\n\n  // ── Dependency Resolution ─────────────────────────────────────────────\n\n  /** After a task completes, check if any blocked tasks are now unblocked. */\n  private resolveDependencies(completedTask: TaskData): void {\n    for (const dependentId of completedTask.dependents) {\n      const dependent = this.tasks.get(dependentId);\n      if (!dependent || dependent.status !== 'blocked') continue;\n\n      const allResolved = dependent.dependencies.every((depId) => {\n        const dep = this.tasks.get(depId);\n        return dep && dep.status === 'completed';\n      });\n\n      if (allResolved) {\n        dependent.status = 'pending';\n\n        // Remove from blocked map and add to pending\n        const queueName = dependent.queueName;\n        const queue = this.queues.get(queueName);\n        if (queue) {\n          queue.blocked.delete(dependentId);\n          this.insertPending(queue, dependent);\n        }\n      }\n    }\n  }\n\n  // ── Public Task Projection ────────────────────────────────────────────\n\n  private toPublicTask(t: TaskData): Task {\n    return {\n      id: t.id,\n      status: t.status,\n      payload: t.payload,\n      priority: t.priority,\n      createdAt: t.createdAt,\n      availableAt: t.availableAt,\n      attempts: t.attempts,\n      maxRetries: t.maxRetries,\n      backoffDelay: t.backoffDelay,\n      dependencies: [...t.dependencies],\n      progress: t.progress,\n      progressMessage: t.progressMessage,\n      error: t.error,\n      result: t.result,\n      queueName: t.queueName,\n      startedAt: t.startedAt,\n      completedAt: t.completedAt,\n      cancelledAt: t.cancelledAt,\n    };\n  }\n\n  // ── Expose Internal TaskData for middleware/process ───────────────────\n\n  /** Return internal TaskData (mutable), only for internal use. */\n  private getTaskData(id: string): TaskData | undefined {\n    return this.tasks.get(id);\n  }\n\n  // ── Middleware Runner ─────────────────────────────────────────────────\n\n  /**\n   * Run the middleware pipeline for a queue, ending with the registered\n   * handler (if any). The pipeline is: middleware[0] → middleware[1] → … → handler.\n   * If a middleware throws, the task fails.\n   * If a middleware does not call next(), processing stops (task stays in processing).\n   * If the handler succeeds, complete() is called automatically.\n   * If the handler throws, fail() is called automatically.\n   */\n  private async runMiddleware(\n    taskData: TaskData,\n    queue: QueueState,\n  ): Promise<void> {\n    const middlewares = queue.middleware;\n    const handler = queue.handler;\n\n    if (middlewares.length === 0 && !handler) return;\n\n    let idx = 0;\n\n    const next = async (): Promise<void> => {\n      if (idx < middlewares.length) {\n        await middlewares[idx++](this.toPublicTask(taskData), next);\n      } else if (handler) {\n        try {\n          const result = await handler(this.toPublicTask(taskData));\n          this.complete(taskData.id, result);\n        } catch (err) {\n          this.fail(\n            taskData.id,\n            err instanceof Error ? err.message : String(err),\n          );\n        }\n      }\n    };\n\n    try {\n      await next();\n    } catch (err) {\n      this.fail(\n        taskData.id,\n        err instanceof Error ? err.message : String(err),\n      );\n    }\n  }\n\n  // ── Check if queue can accept more processing ─────────────────────────\n\n  private canProcess(queue: QueueState): boolean {\n    if (queue.maxConcurrency <= 0) return true;\n    const activeCount = this.getActiveCountForQueue(queue);\n    return activeCount < queue.maxConcurrency;\n  }\n\n  private getActiveCountForQueue(queue: QueueState): number {\n    let count = 0;\n    for (const task of this.tasks.values()) {\n      if (\n        task.status === 'processing' &&\n        task.queueName === this.findQueueName(queue)\n      ) {\n        count++;\n      }\n    }\n    return count;\n  }\n\n  private findQueueName(queue: QueueState): string {\n    for (const [name, q] of this.queues) {\n      if (q === queue) return name;\n    }\n    return 'default';\n  }\n\n  // ── Shutdown Drain Tracking ───────────────────────────────────────────\n\n  /** Called internally when a task leaves 'processing' state. */\n  private trackDrain(): void {\n    if (!this._shuttingDown) return;\n    // Check if any processing tasks remain\n    for (const task of this.tasks.values()) {\n      if (task.status === 'processing') return;\n    }\n    this._drainResolver?.();\n  }\n\n  // ── Cron Helpers ──────────────────────────────────────────────────────\n\n  /** Check whether a cron expression matches the current time. */\n  private static cronMatches(cron: string): boolean {\n    const parts = cron.split(/\\s+/);\n    if (parts.length !== 5) return false;\n\n    const [minute, hour, dayOfMonth, month, dayOfWeek] = parts;\n    const now = new Date();\n\n    return (\n      TaskQueue.matchesField(minute, now.getMinutes(), 0, 59) &&\n      TaskQueue.matchesField(hour, now.getHours(), 0, 23) &&\n      TaskQueue.matchesField(dayOfMonth, now.getDate(), 1, 31) &&\n      TaskQueue.matchesField(month, now.getMonth() + 1, 1, 12) &&\n      TaskQueue.matchesField(dayOfWeek, now.getDay(), 0, 6)\n    );\n  }\n\n  private static matchesField(\n    pattern: string,\n    value: number,\n    _min: number,\n    _max: number,\n  ): boolean {\n    if (pattern === '*') return true;\n    if (pattern.startsWith('*/')) {\n      const interval = parseInt(pattern.slice(2), 10);\n      if (Number.isNaN(interval) || interval <= 0) return false;\n      return value % interval === 0;\n    }\n    return parseInt(pattern, 10) === value;\n  }\n\n  // ══════════════════════════════════════════════════════════════════════\n  //  PUBLIC API\n  // ══════════════════════════════════════════════════════════════════════\n\n  // ── Phase 1 & 2: Basic + Named Queues ─────────────────────────────────\n\n  /**\n   * Add a task to the queue.\n   *\n   * @param payload - Any data to associate with the task.\n   * @param options  - Queue name, priority, delay, retry, etc.\n   * @returns The newly created task.\n   * @throws {ShutdownError} if the queue is shutting down.\n   * @throws {InvalidPriorityError} if priority is outside 1-10.\n   * @throws {CircularDependencyError} if dependencies form a cycle.\n   * @throws {MissingDependencyError} if a dependency task does not exist.\n   */\n  add(payload: unknown, options?: AddTaskOptions): Task {\n    if (this._shuttingDown) {\n      throw new ShutdownError();\n    }\n\n    const queueName = options?.queue ?? 'default';\n    const priority = options?.priority ?? 5;\n    validatePriority(priority);\n\n    const delay = options?.delay;\n    const availableAt = options?.availableAt;\n    let resolvedAvailableAt: Date | null = null;\n\n    if (delay !== undefined && availableAt !== undefined) {\n      throw new TaskQueueError(\n        'Cannot specify both delay and availableAt',\n      );\n    }\n\n    if (delay !== undefined) {\n      if (delay < 0) {\n        throw new TaskQueueError('Delay must be non-negative');\n      }\n      resolvedAvailableAt = new Date(Date.now() + delay);\n    } else if (availableAt !== undefined) {\n      resolvedAvailableAt = availableAt;\n    }\n\n    const dependencies = options?.dependencies ?? [];\n    const maxRetries = options?.maxRetries ?? 3;\n    const backoffDelay = options?.backoffDelay ?? 1000;\n\n    // Validate dependencies existence\n    const missingDeps = dependencies.filter((id) => !this.tasks.has(id));\n    if (missingDeps.length > 0) {\n      throw new MissingDependencyError(missingDeps);\n    }\n\n    const id = this.nextId();\n    const createdAt = new Date();\n\n    // Check circular dependencies\n    if (this.detectCircularDependency(id, dependencies)) {\n      throw new CircularDependencyError(id);\n    }\n\n    // Determine initial status\n    let status: TaskStatus = 'pending';\n\n    // Count unresolved dependencies\n    const unresolvedDeps = dependencies.filter((depId) => {\n      const dep = this.tasks.get(depId);\n      return dep && dep.status !== 'completed';\n    });\n\n    if (unresolvedDeps.length > 0) {\n      status = 'blocked';\n    }\n\n    const taskData: TaskData = {\n      id,\n      status,\n      payload,\n      priority,\n      createdAt,\n      availableAt: resolvedAvailableAt,\n      attempts: 0,\n      maxRetries,\n      backoffDelay,\n      dependencies,\n      dependents: new Set(),\n      progress: 0,\n      progressMessage: '',\n      error: null,\n      result: undefined,\n      queueName,\n      startedAt: null,\n      completedAt: null,\n      cancelledAt: null,\n    };\n\n    // Register as dependent on each dependency\n    if (status === 'blocked') {\n      for (const depId of unresolvedDeps) {\n        const dep = this.tasks.get(depId);\n        if (dep) {\n          dep.dependents.add(id);\n        }\n      }\n    }\n\n    this.tasks.set(id, taskData);\n    const queue = this.getOrCreateQueue(queueName);\n\n    if (status === 'blocked') {\n      queue.blocked.set(id, taskData);\n    } else {\n      this.insertPending(queue, taskData);\n    }\n\n    return this.toPublicTask(taskData);\n  }\n\n  /**\n   * Retrieve and claim the next available task from a queue.\n   *\n   * The highest-priority available task is returned.  Tasks whose delay\n   * has not yet elapsed are skipped.  Blocked tasks are skipped.\n   * Returns null when no task is available or concurrency limit is reached.\n   */\n  getNext(queueName?: string): Task | null {\n    const qName = queueName ?? 'default';\n    const queue = this.getQueue(qName);\n    if (!queue) return null;\n\n    // Check concurrency\n    if (!this.canProcess(queue)) return null;\n\n    // Scan pending list for first available task\n    const now = Date.now();\n    let foundIdx = -1;\n\n    for (let i = 0; i < queue.pending.length; i++) {\n      const t = queue.pending[i];\n      if (t.status !== 'pending') continue;\n      if (t.availableAt && t.availableAt.getTime() > now) continue;\n      foundIdx = i;\n      break;\n    }\n\n    if (foundIdx === -1) return null;\n\n    const taskData = queue.pending[foundIdx];\n    queue.pending.splice(foundIdx, 1);\n    taskData.status = 'processing';\n    taskData.startedAt = new Date();\n\n    return this.toPublicTask(taskData);\n  }\n\n  /** Return the number of pending tasks for a queue (or all queues summed). */\n  getQueueSize(queueName?: string): number {\n    if (queueName !== undefined) {\n      const q = this.getQueue(queueName);\n      return q ? q.pending.length : 0;\n    }\n\n    let total = 0;\n    for (const q of this.queues.values()) {\n      total += q.pending.length;\n    }\n    return total;\n  }\n\n  /** List all existing queue names. */\n  listQueues(): string[] {\n    return [...this.queues.keys()];\n  }\n\n  /** Look up a task by its ID across all queues. Returns null if not found. */\n  getTask(taskId: string): Task | null {\n    const t = this.tasks.get(taskId);\n    return t ? this.toPublicTask(t) : null;\n  }\n\n  // ── Phase 5: Complete / Fail ──────────────────────────────────────────\n\n  /**\n   * Mark a task as completed successfully.\n   *\n   * Transitions the task to 'completed', resolves any dependents,\n   * and frees a concurrency slot.\n   */\n  complete(taskId: string, result?: unknown): void {\n    const task = this.tasks.get(taskId);\n    if (!task) {\n      throw new TaskQueueError(`Task ${taskId} not found`);\n    }\n    if (task.status !== 'processing') {\n      throw new TaskQueueError(\n        `Task ${taskId} is not in processing state (${task.status})`,\n      );\n    }\n\n    task.status = 'completed';\n    task.completedAt = new Date();\n    task.result = result;\n\n    // Resolve dependents\n    this.resolveDependencies(task);\n\n    // Track drain for shutdown\n    this.trackDrain();\n  }\n\n  /**\n   * Mark a task as failed.\n   *\n   * If retries remain, the task is re-enqueued with exponential backoff.\n   * If retries are exhausted, the task moves to the dead letter queue.\n   */\n  fail(taskId: string, error?: string | Error): void {\n    const task = this.tasks.get(taskId);\n    if (!task) {\n      throw new TaskQueueError(`Task ${taskId} not found`);\n    }\n    if (task.status !== 'processing') {\n      throw new TaskQueueError(\n        `Task ${taskId} is not in processing state (${task.status})`,\n      );\n    }\n\n    task.error = error instanceof Error ? error.message : (error ?? null);\n    task.attempts++;\n\n    const queue = this.getQueue(task.queueName);\n\n    if (task.attempts < task.maxRetries) {\n      // Re-enqueue with backoff\n      const backoffMs =\n        task.backoffDelay * Math.pow(2, task.attempts - 1);\n      task.status = 'pending';\n      task.availableAt = new Date(Date.now() + backoffMs);\n      task.error = null; // Clear error for retry\n      task.result = undefined;\n      task.startedAt = null;\n\n      if (queue) {\n        this.insertPending(queue, task);\n      }\n    } else {\n      // Exhausted retries → move to dead letter\n      task.status = 'failed';\n      if (queue) {\n        queue.deadLetter.push(task);\n      }\n      this.trackDrain();\n    }\n  }\n\n  // ── Phase 6: Dead Letter Queue ────────────────────────────────────────\n\n  /** Get all dead-lettered tasks for a given queue. */\n  getDeadLetterTasks(queueName?: string): Task[] {\n    const qName = queueName ?? 'default';\n    const q = this.getQueue(qName);\n    return q ? q.deadLetter.map((t) => this.toPublicTask(t)) : [];\n  }\n\n  /**\n   * Move a dead-lettered task back to its original queue for a fresh\n   * round of retries.  Errors are cleared and attempts reset.\n   */\n  retryDeadLetter(taskId: string): void {\n    const task = this.tasks.get(taskId);\n    if (!task) {\n      throw new TaskQueueError(`Task ${taskId} not found`);\n    }\n    if (task.status !== 'failed') {\n      throw new TaskQueueError(\n        `Task ${taskId} is not in failed state (${task.status})`,\n      );\n    }\n\n    const queue = this.getQueue(task.queueName);\n    if (!queue) {\n      throw new TaskQueueError(`Queue ${task.queueName} not found`);\n    }\n\n    // Remove from dead letter\n    const idx = queue.deadLetter.indexOf(task);\n    if (idx !== -1) {\n      queue.deadLetter.splice(idx, 1);\n    }\n\n    // Reset and re-enqueue\n    task.status = 'pending';\n    task.attempts = 0;\n    task.error = null;\n    task.result = undefined;\n    task.startedAt = null;\n    task.availableAt = null;\n\n    this.insertPending(queue, task);\n  }\n\n  /** Remove all dead-lettered tasks for a queue. */\n  clearDeadLetter(queueName?: string): void {\n    const qName = queueName ?? 'default';\n    const q = this.getQueue(qName);\n    if (q) {\n      // Remove from global task map too\n      for (const t of q.deadLetter) {\n        this.tasks.delete(t.id);\n      }\n      q.deadLetter = [];\n    }\n  }\n\n  // ── Phase 8: Concurrency Control ──────────────────────────────────────\n\n  /** Set the maximum number of concurrently processing tasks for a queue. */\n  setConcurrency(limit: number, queueName?: string): void {\n    if (limit < 0 || !Number.isInteger(limit)) {\n      throw new TaskQueueError(\n        'Concurrency limit must be a non-negative integer',\n      );\n    }\n    const qName = queueName ?? 'default';\n    const queue = this.getOrCreateQueue(qName);\n    queue.maxConcurrency = limit;\n  }\n\n  /** Get the concurrency limit for a queue (0 = unlimited). */\n  getConcurrency(queueName?: string): number {\n    const qName = queueName ?? 'default';\n    const q = this.getQueue(qName);\n    return q ? q.maxConcurrency : 0;\n  }\n\n  /** Get the number of currently processing tasks in a queue. */\n  getActiveCount(queueName?: string): number {\n    const qName = queueName ?? 'default';\n    const q = this.getQueue(qName);\n    if (!q) return 0;\n    return this.getActiveCountForQueue(q);\n  }\n\n  // ── Phase 9: Progress Tracking ────────────────────────────────────────\n\n  /**\n   * Report progress on a task.\n   *\n   * @param taskId   - The task to update.\n   * @param progress - Percentage 0–100.  Values outside this range are clamped.\n   * @param message  - Optional human-readable progress message.\n   */\n  reportProgress(taskId: string, progress: number, message?: string): void {\n    const task = this.tasks.get(taskId);\n    if (!task) {\n      throw new TaskQueueError(`Task ${taskId} not found`);\n    }\n\n    task.progress = Math.max(0, Math.min(100, progress));\n    if (message !== undefined) {\n      task.progressMessage = message;\n    }\n\n    // Notify listeners\n    const listeners = this.progressListeners.get(taskId);\n    if (listeners) {\n      for (const cb of listeners) {\n        try {\n          cb(taskId, task.progress, task.progressMessage);\n        } catch {\n          // Swallow listener errors\n        }\n      }\n    }\n  }\n\n  /**\n   * Subscribe to progress updates for a specific task.\n   *\n   * @returns An unsubscribe function.\n   */\n  onProgress(taskId: string, callback: ProgressCallback): () => void {\n    if (!this.progressListeners.has(taskId)) {\n      this.progressListeners.set(taskId, new Set());\n    }\n    this.progressListeners.get(taskId)!.add(callback);\n\n    return () => {\n      const set = this.progressListeners.get(taskId);\n      if (set) {\n        set.delete(callback);\n        if (set.size === 0) {\n          this.progressListeners.delete(taskId);\n        }\n      }\n    };\n  }\n\n  /**\n   * Cancel a task.\n   *\n   * Pending tasks are removed from the queue.  Processing tasks are\n   * marked as cancelled.  Cancelled tasks are never retried.\n   * Blocked tasks are removed from their blocked list.\n   */\n  cancel(taskId: string): void {\n    const task = this.tasks.get(taskId);\n    if (!task) {\n      throw new TaskQueueError(`Task ${taskId} not found`);\n    }\n\n    if (task.status === 'completed' || task.status === 'failed') {