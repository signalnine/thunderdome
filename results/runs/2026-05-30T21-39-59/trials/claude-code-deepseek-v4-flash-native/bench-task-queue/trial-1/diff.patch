task = this.tasks.get(taskId);\n    if (!task) throw new TaskQueueError(`Task ${taskId} not found`);\n    if (task.status !== 'failed') {\n      throw new TaskQueueError(\n        `Task ${taskId} is not failed (status: ${task.status})`,\n      );\n    }\n\n    const queue = this.queues.get(task.queueName);\n    if (!queue) throw new TaskQueueError(`Queue ${task.queueName} not found`);\n\n    // Remove from dead-letter list\n    const dlIdx = queue.deadLetter.indexOf(task);\n    if (dlIdx !== -1) queue.deadLetter.splice(dlIdx, 1);\n\n    // Reset\n    task.status = 'pending';\n    task.attempts = 0;\n    task.error = null;\n    task.result = undefined;\n    task.startedAt = null;\n    task.availableAt = null;\n\n    this.insertPending(queue, task);\n  }\n\n  /** Remove all dead-lettered tasks for a queue. */\n  clearDeadLetter(queueName?: string): void {\n    const qName = queueName ?? 'default';\n    const q = this.queues.get(qName);\n    if (q) {\n      for (const t of q.deadLetter) this.tasks.delete(t.id);\n      q.deadLetter = [];\n    }\n  }\n\n  // ── Phase 8: Concurrency Control ──────────────────────────────────────\n\n  /** Set the max concurrent processing limit for a queue (0 = unlimited). */\n  setConcurrency(limit: number, queueName?: string): void {\n    if (limit < 0 || !Number.isInteger(limit)) {\n      throw new TaskQueueError('Concurrency must be a non-negative integer');\n    }\n    this.getOrCreateQueue(queueName ?? 'default').maxConcurrency = limit;\n  }\n\n  /** Get the concurrency limit for a queue. */\n  getConcurrency(queueName?: string): number {\n    const q = this.queues.get(queueName ?? 'default');\n    return q ? q.maxConcurrency : 0;\n  }\n\n  /** Get the number of currently-processing tasks in a queue. */\n  getActiveCount(queueName?: string): number {\n    const qName = queueName ?? 'default';\n    const q = this.queues.get(qName);\n    return q ? this.getActiveCountForQueue(q) : 0;\n  }\n\n  // ── Phase 9: Progress Tracking ─────────