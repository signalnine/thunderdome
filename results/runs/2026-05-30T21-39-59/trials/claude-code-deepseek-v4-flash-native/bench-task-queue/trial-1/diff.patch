","originalFile":"import type {\n  Task,\n  TaskData,\n  TaskStatus,\n  AddTaskOptions,\n  ScheduleConfig,\n  Schedule,\n  ScheduleData,\n  QueueState,\n  ProgressCallback,\n  ShutdownCallback,\n  ShutdownResult,\n  MiddlewareFunction,\n  ProcessFunction,\n} from './types.js';\n\n// ─── Error Classes ─────────────────────────────────────────────────────────\n\nexport class TaskQueueError extends Error {\n  constructor(message: string) {\n    super(message);\n    this.name = 'TaskQueueError';\n  }\n}\n\nexport class InvalidPriorityError extends TaskQueueError {\n  constructor(value: number) {\n    super(`Invalid priority: ${value}. Priority must be between 1 and 10.`);\n    this.name = 'InvalidPriorityError';\n  }\n}\n\nexport class CircularDependencyError extends TaskQueueError {\n  constructor(chain: string) {\n    super(`Circular dependency detected: ${chain}`);\n    this.name = 'CircularDependencyError';\n  }\n}\n\nexport class MissingDependencyError extends TaskQueueError {\n  constructor(taskIds: string[]) {\n    super(`Dependencies not found: ${taskIds.join(', ')}`);\n    this.name = 'MissingDependencyError';\n  }\n}\n\nexport class ShutdownError extends TaskQueueError {\n  constructor() {\n    super('Task queue is shutting down. No new tasks accepted.');\n    this.name = 'ShutdownError';\n  }\n}\n\n// ─── Helpers ───────────────────────────────────────────────────────────────\n\nfunction validatePriority(priority: number): void {\n  if (!Number.isInteger(priority) || priority < 1 || priority > 10) {\n    throw new InvalidPriorityError(priority);\n  }\n}\n\n/** Comparison for sorting pending tasks: priority asc, then createdAt asc. */\nfunction comparePendingTasks(a: TaskData, b: TaskData): number {\n  if (a.priority !== b.priority) return a.priority - b.priority;\n  return a.createdAt.getTime() - b.createdAt.getTime();\n}\n\n// ═══════════════════════════════════════════════════════════════════════════\n//  TaskQueue\n// ═══════════════════════════════════════════════════════════════════════════\n\n/**\n * In-memory task queue with support for:\n *\n *  Phase  1 – Basic FIFO queue\n *  Phase  2 – Named queues\n *  Phase  3 – Priority (1–10)\n *  Phase  4 – Delayed / scheduled-availability tasks\n *  Phase  5 – Retry with exponential backoff\n *  Phase  6 – Dead letter queue\n *  Phase  7 – Task dependencies\n *  Phase  8 – Concurrency control\n *  Phase  9 – Progress tracking & cancellation\n *  Phase 10 – Recurring (cron-like) schedules\n *  Phase 11 – Middleware pipeline\n *  Phase 12 – Graceful shutdown\n */\nexport class TaskQueue {\n  // ── Private State ──────────────────────────────────────────────────────\n\n  private queues = new Map<string, QueueState>();\n  /** Global task index by id. */\n  private tasks = new Map<string, TaskData>();\n  /** Active recurring schedules. */\n  private schedules = new Map<string, ScheduleData>();\n  /** Progress subscribers keyed by task id. */\n  private progressListeners = new Map<string, Set<ProgressCallback>>();\n  /** Shutdown lifecycle callbacks. */\n  private shutdownCallbacks = new Set<ShutdownCallback>();\n\n  private _shuttingDown = false;\n  private _shutdownPromise: Promise<ShutdownResult> | null = null;\n  private _drainResolver: (() => void) | null = null;\n\n  private _idCounter = 0;\n\n  // ── Queue Helpers ──────────────────────────────────────────────────────\n\n  private getOrCreateQueue(name: string): QueueState {\n    let q = this.queues.get(name);\n    if (!q) {\n      q = {\n        pending: [],\n        blocked: new Map(),\n        deadLetter: [],\n        maxConcurrency: 0,\n        middleware: [],\n        handler: null,\n      };\n      this.queues.set(name, q);\n    }\n    return q;\n  }\n\n  /** Returns the queue name for a given QueueState reference. */\n  private queueNameForState(queue: QueueState): string {\n    for (const [name, q] of this.queues) {\n      if (q === queue) return name;\n    }\n    return 'default';\n  }\n\n  // ── Id Generation ─────────────────────────────────────────────────────\n\n  private nextId(): string {\n    return `task_${Date.now().toString(36)}_${(++this._idCounter).toString(36)}`;\n  }\n\n  // ── Pending-array Insertion (binary search) ───────────────────────────\n\n  private insertPending(queue: QueueState, task: TaskData): void {\n    const arr = queue.pending;\n    let lo = 0;\n    let hi = arr.length;\n    while (lo < hi) {\n      const mid = (lo + hi) >>> 1;\n      if (comparePendingTasks(arr[mid], task) <= 0) {\n        lo = mid + 1;\n      } else {\n        hi = mid;\n      }\n    }\n    arr.splice(lo, 0, task);\n  }\n\n  // ── Circular Dependency Detection ─────────────────────────────────────\n\n  /**\n   * Returns true when adding a task with the given `dependencies` would\n   * create a cycle.  Performs a DFS through the dependency graph.\n   */\n  private wouldCreateCycle(\n    candidateId: string,\n    dependencies: string[],\n  ): boolean {\n    const visited = new Set<string>();\n\n    const dfs = (currentId: string): boolean => {\n      if (currentId === candidateId) return true;\n      if (visited.has(currentId)) return false;\n      visited.add(currentId);\n\n      const node = this.tasks.get(currentId);\n      if (!node) return false;\n      for (const dep of node.dependencies) {\n        if (dfs(dep)) return true;\n      }\n      return false;\n    };\n\n    for (const dep of dependencies) {\n      if (dfs(dep)) return true;\n    }\n    return false;\n  }\n\n  // ── Dependency Resolution ─────────────────────────────────────────────\n\n  /** After a task completes, unblock any tasks that were waiting on it. */\n  private resolveDependencies(completedTask: TaskData): void {\n    for (const dependentId of completedTask.dependents) {\n      const dependent = this.tasks.get(dependentId);\n      if (!dependent || dependent.status !== 'blocked') continue;\n\n      const allResolved = dependent.dependencies.every((depId) => {\n        const dep = this.tasks.get(depId);\n        return dep && dep.status === 'completed';\n      });\n\n      if (allResolved) {\n        dependent.status = 'pending';\n        const queue = this.queues.get(dependent.queueName);\n        if (queue) {\n          queue.blocked.delete(dependentId);\n          this.insertPending(queue, dependent);\n        }\n      }\n    }\n  }\n\n  // ── Public Task Projection ────────────────────────────────────────────\n\n  private toPublicTask(t: TaskData): Task {\n    return {\n      id: t.id,\n      status: t.status,\n      payload: t.payload,\n      priority: t.priority,\n      createdAt: t.createdAt,\n      availableAt: t.availableAt,\n      attempts: t.attempts,\n      maxRetries: t.maxRetries,\n      backoffDelay: t.backoffDelay,\n      dependencies: [...t.dependencies],\n      progress: t.progress,\n      progressMessage: t.progressMessage,\n      error: t.error,\n      result: t.result,\n      queueName: t.queueName,\n      startedAt: t.startedAt,\n      completedAt: t.completedAt,\n      cancelledAt: t.cancelledAt,\n    };\n  }\n\n  // ── Concurrency Helpers ───────────────────────────────────────────────\n\n  private canProcessTask(queue: QueueState): boolean {\n    if (queue.maxConcurrency <= 0) return true;\n    return this.getActiveCountForQueue(queue) < queue.maxConcurrency;\n  }\n\n  private getActiveCountForQueue(queue: QueueState): number {\n    const qName = this.queueNameForState(queue);\n    let count = 0;\n    for (const task of this.tasks.values()) {\n      if (task.status === 'processing' && task.queueName === qName) {\n        count++;\n      }\n    }\n    return count;\n  }\n\n  // ── Middleware Runner ─────────────────────────────────────────────────\n\n  private async runMiddleware(\n    taskData: TaskData,\n    queue: QueueState,\n  ): Promise<void> {\n    const middlewares = queue.middleware;\n    const handler = queue.handler;\n\n    if (middlewares.length === 0 && !handler) return;\n\n    let idx = 0;\n\n    const next = async (): Promise<void> => {\n      if (idx < middlewares.length) {\n        await middlewares[idx++](this.toPublicTask(taskData), next);\n      } else if (handler) {\n        try {\n          const result = await handler(this.toPublicTask(taskData));\n          this.complete(taskData.id, result);\n        } catch (err) {\n          this.fail(\n            taskData.id,\n            err instanceof Error ? err.message : String(err),\n          );\n        }\n      }\n    };\n\n    try {\n      await next();\n    } catch (err) {\n      this.fail(\n        taskData.id,\n        err instanceof Error ? err.message : String(err),\n      );\n    }\n  }\n\n  // ── Drain Tracking (for graceful shutdown) ───────────────────────────\n\n  /**\n   * Called whenever a task transitions out of 'processing'.\n   * If shutdown is in progress and no processing tasks remain, resolves the drain.\n   */\n  private afterTaskCompletion(): void {\n    if (!this._shuttingDown) return;\n    for (const task of this.tasks.values()) {\n      if (task.status === 'processing') return;\n    }\n    // No more processing tasks\n    if (this._drainResolver) {\n      this._drainResolver();\n    }\n  }\n\n  /**\n   * Internal get-next that returns the mutable TaskData.\n   * Used by both `getNext()` and `processNext()`.\n   */\n  private internalGetNext(queue: QueueState): TaskData | null {\n    if (!this.canProcessTask(queue)) return null;\n\n    const now = Date.now();\n    for (let i = 0; i < queue.pending.length; i++) {\n      const t = queue.pending[i];\n      if (t.status !== 'pending') continue;\n      if (t.availableAt && t.availableAt.getTime() > now) continue;\n\n      queue.pending.splice(i, 1);\n      t.status = 'processing';\n      t.startedAt = new Date();\n      return t;\n    }\n    return null;\n  }\n\n  // ── Cron Helpers ──────────────────────────────────────────────────────\n\n  private static cronMatches(cron: string): boolean {\n    const parts = cron.split(/\\s+/);\n    if (parts.length !== 5) return false;\n\n    const [minute, hour, dom, month, dow] = parts;\n    const now = new Date();\n\n    return (\n      this.matchesField(minute, now.getMinutes()) &&\n      this.matchesField(hour, now.getHours()) &&\n      this.matchesField(dom, now.getDate()) &&\n      this.matchesField(month, now.getMonth() + 1) &&\n      this.matchesField(dow, now.getDay())\n    );\n  }\n\n  private static matchesField(pattern: string, value: number): boolean {\n    if (pattern === '*') return true;\n    if (pattern.startsWith('*/')) {\n      const interval = parseInt(pattern.slice(2), 10);\n      if (Number.isNaN(interval) || interval <= 0) return false;\n      return value % interval === 0;\n    }\n    return parseInt(pattern, 10) === value;\n  }\n\n  // ══════════════════════════════════════════════════════════════════════\n  //  PUBLIC API\n  // ══════════════════════════════════════════════════════════════════════\n\n  // ── Phase 1 & 2: Basic + Named Queues ─────────────────────────────────\n\n  /**\n   * Add a task to the queue.\n   *\n   * @throws {ShutdownError} if the queue is shutting down.\n   * @throws {InvalidPriorityError} if priority is outside 1–10.\n   * @throws {CircularDependencyError} if dependencies form a cycle.\n   * @throws {MissingDependencyError} if a dependency doesn't exist.\n   */\n  add(payload: unknown, options?: AddTaskOptions): Task {\n    if (this._shuttingDown) throw new ShutdownError();\n\n    const queueName = options?.queue ?? 'default';\n    const priority = options?.priority ?? 5;\n    validatePriority(priority);\n\n    const dependencies = options?.dependencies ?? [];\n    const maxRetries = options?.maxRetries ?? 3;\n    const backoffDelay = options?.backoffDelay ?? 1000;\n\n    // Resolve availability time\n    let availableAt: Date | null = null;\n    if (options?.delay !== undefined && options?.availableAt !== undefined) {\n      throw new TaskQueueError('Cannot specify both delay and availableAt');\n    }\n    if (options?.delay !== undefined) {\n      if (options.delay < 0) {\n        throw new TaskQueueError('delay must be non-negative');\n      }\n      availableAt = new Date(Date.now() + options.delay);\n    } else if (options?.availableAt !== undefined) {\n      availableAt = options.availableAt;\n    }\n\n    // Validate dependency existence\n    const missingDeps = dependencies.filter((id) => !this.tasks.has(id));\n    if (missingDeps.length > 0) {\n      throw new MissingDependencyError(missingDeps);\n    }\n\n    const id = this.nextId();\n    const createdAt = new Date();\n\n    // Cycle detection\n    if (this.wouldCreateCycle(id, dependencies)) {\n      throw new CircularDependencyError(id);\n    }\n\n    // Determine initial status (blocked if any deps are still pending/processing)\n    const unresolvedDeps = dependencies.filter((depId) => {\n      const dep = this.tasks.get(depId);\n      return dep && dep.status !== 'completed';\n    });\n    const initialStatus: TaskStatus =\n      unresolvedDeps.length > 0 ? 'blocked' : 'pending';\n\n    const taskData: TaskData = {\n      id,\n      status: initialStatus,\n      payload,\n      priority,\n      createdAt,\n      availableAt,\n      attempts: 0,\n      maxRetries,\n      backoffDelay,\n      dependencies: [...dependencies],\n      dependents: new Set(),\n      progress: 0,\n      progressMessage: '',\n      error: null,\n      result: undefined,\n      queueName,\n      startedAt: null,\n      completedAt: null,\n      cancelledAt: null,\n    };\n\n    // Register as dependent on each unresolved dependency\n    for (const depId of unresolvedDeps) {\n      const dep = this.tasks.get(depId);\n      if (dep) dep.dependents.add(id);\n    }\n\n    this.tasks.set(id, taskData);\n    const queue = this.getOrCreateQueue(queueName);\n\n    if (initialStatus === 'blocked') {\n      queue.blocked.set(id, taskData);\n    } else {\n      this.insertPending(queue, taskData);\n    }\n\n    return this.toPublicTask(taskData);\n  }\n\n  /**\n   * Retrieve and claim the next available task.\n   *\n   * Returns the highest-priority task whose availability time has elapsed,\n   * or `null` if the queue is empty, all tasks are blocked/delayed, or\n   * the concurrency limit has been reached.\n   */\n  getNext(queueName?: string): Task | null {\n    const qName = queueName ?? 'default';\n    const queue = this.queues.get(qName);\n    if (!queue) return null;\n\n    const data = this.internalGetNext(queue);\n    return data ? this.toPublicTask(data) : null;\n  }\n\n  /** Number of pending tasks in a queue (or across all queues). */\n  getQueueSize(queueName?: string): number {\n    if (queueName !== undefined) {\n      const q = this.queues.get(queueName);\n      return q ? q.pending.length : 0;\n    }\n    let total = 0;\n    for (const q of this.queues.values()) total += q.pending.length;\n    return total;\n  }\n\n  /** List all named queues that exist. */\n  listQueues(): string[] {\n    return [...this.queues.keys()];\n  }\n\n  /** Retrieve a task snapshot by id, or null. */\n  getTask(taskId: string): Task | null {\n    const t = this.tasks.get(taskId);\n    return t ? this.toPublicTask(t) : null;\n  }\n\n  // ── Phase 5: Complete / Fail ──────────────────────────────────────────\n\n  /**\n   * Mark a task as completed successfully.\n   * Resolves any dependents and frees a concurrency slot.\n   */\n  complete(taskId: string, result?: unknown): void {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new TaskQueueError(`Task ${taskId} not found`);\n    if (task.status !== 'processing') {\n      throw new TaskQueueError(\n        `Task ${taskId} is not processing (status: ${task.status})`,\n      );\n    }\n\n    task.status = 'completed';\n    task.completedAt = new Date();\n    task.result = result;\n\n    this.resolveDependencies(task);\n    this.afterTaskCompletion();\n  }\n\n  /**\n   * Mark a task as failed.\n   *\n   * If retries remain, the task is re-enqueued with exponential back