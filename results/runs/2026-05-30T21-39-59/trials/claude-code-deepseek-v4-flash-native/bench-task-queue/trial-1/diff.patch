+/**
+ * Task Queue System
+ *
+ * A fully-featured in-memory task queue supporting 12 phases of features
+ * from basic FIFO through graceful shutdown.
+ */
+
+export { TaskQueue } from './task-queue.js';
+export {
+  TaskQueueError,
+  InvalidPriorityError,
+  CircularDependencyError,
+  MissingDependencyError,
+  ShutdownError,
+} from './task-queue.js';
+
+export type {
+  Task,
+  TaskStatus,
+  TaskData,
+  AddTaskOptions,
+  ScheduleConfig,
+  Schedule,
+  ScheduleData,
+  QueueState,
+  ProgressCallback,
+  ShutdownCallback,
+  ShutdownResult,
+  MiddlewareFunction,
+  ProcessFunction,
+} from './types.js';
diff --git a/src/task-queue.ts b/src/task-queue.ts
new file mode 100644
index 0000000..36a0ed0
--- /dev/null
+++ b/src/task-queue.ts
@@ -0,0 +1,904 @@
+import type {
+  Task,
+  TaskData,
+  TaskStatus,
+  AddTaskOptions,
+  ScheduleConfig,
+  Schedule,
+  ScheduleData,
+  QueueState,
+  ProgressCallback,
+  ShutdownCallback,
+  ShutdownResult,
+  MiddlewareFunction,
+  ProcessFunction,
+} from './types.js';
+
+// ─── Error Classes ─────────────────────────────────────────────────────────
+
+export class TaskQueueError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'TaskQueueError';
+  }
+}
+
+export class InvalidPriorityError extends TaskQueueError {
+  constructor(value: number) {
+    super(`Invalid priority: ${value}. Priority must be between 1 and 10.`);
+    this.name = 'InvalidPriorityError';
+  }
+}
+
+export class CircularDependencyError extends TaskQueueError {
+  constructor(chain: string) {
+    super(`Circular dependency detected: ${chain}`);
+    this.name = 'CircularDependencyError';
+  }
+}
+
+export class MissingDependencyError extends TaskQueueError {
+  constructor(taskIds: string[]) {
+    super(`Dependencies not found: ${taskIds.join(', ')}`);
+    this.name = 'MissingDependencyError';
+  }
+}
+
+export class ShutdownError extends TaskQueueError {
+  constructor() {
+    super('Task queue is shutting down. No new tasks accepted.');
+    this.name = 'ShutdownError';
+  }
+}
+
+// ─── Helpers ───────────────────────────────────────────────────────────────
+
+function validatePriority(priority: number): void {
+  if (!Number.isInteger(priority) || priority < 1 || priority > 10) {
+    throw new InvalidPriorityError(priority);
+  }
+}
+
+/** Comparison for sorting pending tasks: priority asc, then createdAt asc. */
+function comparePendingTasks(a: TaskData, b: TaskData): number {
+  if (a.priority !== b.priority) return a.priority - b.priority;
+  return a.createdAt.getTime() - b.createdAt.getTime();
+}
+
+// ═══════════════════════════════════════════════════════════════════════════
+//  TaskQueue
+// ═══════════════════════════════════════════════════════════════════════════
+
+/**
+ * In-memory task queue with support for:
+ *
+ *  Phase  1 – Basic FIFO queue
+ *  Phase  2 – Named queues
+ *  Phase  3 – Priority (1–10)
+ *  Phase  4 – Delayed / scheduled-availability tasks
+ *  Phase  5 – Retry with exponential backoff
+ *  Phase  6 – Dead letter queue
+ *  Phase  7 – Task dependencies
+ *  Phase  8 – Concurrency control
+ *  Phase  9 – Progress tracking & cancellation
+ *  Phase 10 – Recurring (cron-like) schedules
+ *  Phase 11 – Middleware pipeline
+ *  Phase 12 – Graceful shutdown
+ */
+export class TaskQueue {
+  // ── Private State ──────────────────────────────────────────────────────
+
+  private queues = new Map<string, QueueState>();
+  /** Global task index by id. */
+  private tasks = new Map<string, TaskData>();
+  /** Active recurring schedules. */
+  private schedules = new Map<string, ScheduleData>();
+  /** Progress subscribers keyed by task id. */
+  private progressListeners = new Map<string, Set<ProgressCallback>>();
+  /** Shutdown lifecycle callbacks. */
+  private shutdownCallbacks = new Set<ShutdownCallback>();
+
+  private _shuttingDown = false;
+  private _shutdownPromise: Promise<ShutdownResult> | null = null;
+  private _drainResolver: (() => void) | null = null;
+
+  private _idCounter = 0;
+
+  // ── Queue Helpers ──────────────────────────────────────────────────────
+
+  private getOrCreateQueue(name: string): QueueState {
+    let q = this.queues.get(name);
+    if (!q) {
+      q = {
+        pending: [],
+        blocked: new Map(),
+        deadLetter: [],
+        maxConcurrency: 0,
+        middleware: [],
+        handler: null,
+      };
+      this.queues.set(name, q);
+    }
+    return q;
+  }
+
+  /** Returns the queue name for a given QueueState reference. */
+  private queueNameForState(queue: QueueState): string {
+    for (const [name, q] of this.queues) {
+      if (q === queue) return name;
+    }
+    return 'default';
+  }
+
+  // ── Id Generation ─────────────────────────────────────────────────────
+
+  private nextId(): string {
+    return `task_${Date.now().toString(36)}_${(++this._idCounter).toString(36)}`;
+  }
+
+  // ── Pending-array Insertion (binary search) ───────────────────────────
+
+  private insertPending(queue: QueueState, task: TaskData): void {
+    const arr = queue.pending;
+    let lo = 0;
+    let hi = arr.length;
+    while (lo < hi) {
+      const mid = (lo + hi) >>> 1;
+      if (comparePendingTasks(arr[mid], task) <= 0) {
+        lo = mid + 1;
+      } else {
+        hi = mid;
+      }
+    }
+    arr.splice(lo, 0, task);
+  }
+
+  // ── Circular Dependency Detection ─────────────────────────────────────
+
+  /**
+   * Returns true when adding a task with the given `dependencies` would
+   * create a cycle.  Performs a DFS through the dependency graph.
+   */
+  private wouldCreateCycle(
+    candidateId: string,
+    dependencies: string[],
+  ): boolean {
+    const visited = new Set<string>();
+
+    const dfs = (currentId: string): boolean => {
+      if (currentId === candidateId) return true;
+      if (visited.has(currentId)) return false;
+      visited.add(currentId);
+
+      const node = this.tasks.get(currentId);
+      if (!node) return false;
+      for (const dep of node.dependencies) {
+        if (dfs(dep)) return true;
+      }
+      return false;
+    };
+
+    for (const dep of dependencies) {
+      if (dfs(dep)) return true;
+    }
+    return false;
+  }
+
+  // ── Dependency Resolution ─────────────────────────────────────────────
+
+  /** After a task completes, unblock any tasks that were waiting on it. */
+  private resolveDependencies(completedTask: TaskData): void {
+    for (const dependentId of completedTask.dependents) {
+      const dependent = this.tasks.get(dependentId);
+      if (!dependent || dependent.status !== 'blocked') continue;
+
+      const allResolved = dependent.dependencies.every((depId) => {
+        const dep = this.tasks.get(depId);
+        return dep && dep.status === 'completed';
+      });
+
+      if (allResolved) {
+        dependent.status = 'pending';
+        const queue = this.queues.get(dependent.queueName);
+        if (queue) {
+          queue.blocked.delete(dependentId);
+          this.insertPending(queue, dependent);
+        }
+      }
+    }
+  }
+
+  // ── Public Task Projection ────────────────────────────────────────────
+
+  private toPublicTask(t: TaskData): Task {
+    return {
+      id: t.id,
+      status: t.status,
+      payload: t.payload,
+      priority: t.priority,
+      createdAt: t.createdAt,
+      availableAt: t.availableAt,
+      attempts: t.attempts,
+      maxRetries: t.maxRetries,
+      backoffDelay: t.backoffDelay,
+      dependencies: [...t.dependencies],
+      progress: t.progress,
+      progressMessage: t.progressMessage,
+      error: t.error,
+      result: t.result,
+      queueName: t.queueName,
+      startedAt: t.startedAt,
+      completedAt: t.completedAt,
+      cancelledAt: t.cancelledAt,
+    };
+  }
+
+  // ── Concurrency Helpers ───────────────────────────────────────────────
+
+  private canProcessTask(queue: QueueState): boolean {
+    if (queue.maxConcurrency <= 0) return true;
+    return this.getActiveCountForQueue(queue) < queue.maxConcurrency;
+  }
+
+  private getActiveCountForQueue(queue: QueueState): number {
+    const qName = this.queueNameForState(queue);
+    let count = 0;
+    for (const task of this.tasks.values()) {
+      if (task.status === 'processing' && task.queueName === qName) {
+        count++;
+      }
+    }
+    return count;
+  }
+
+  // ── Middleware Runner ─────────────────────────────────────────────────
+
+  private async runMiddleware(
+    taskData: TaskData,
+    queue: QueueState,
+  ): Promise<void> {
+    const middlewares = queue.middleware;
+    const handler = queue.handler;
+
+    if (middlewares.length === 0 && !handler) return;
+
+    let idx = 0;
+
+    const next = async (): Promise<void> => {
+      if (idx < middlewares.length) {
+        // Pass internal taskData (cast to Task) so middleware mutations propagate
+        await middlewares[idx++](taskData as unknown as Task, next);
+      } else if (handler) {
+        try {
+          const result = await handler(this.toPublicTask(taskData));
+          this.complete(taskData.id, result);
+        } catch (err) {
+          this.fail(
+            taskData.id,
+            err instanceof Error ? err.message : String(err),
+          );
+        }
+      }
+    };
+
+    try {
+      await next();
+    } catch (err) {
+      this.fail(
+        taskData.id,
+        err instanceof Error ? err.message : String(err),
+      );
+    }
+  }
+
+  // ── Drain Tracking (for graceful shutdown) ───────────────────────────
+
+  /**
+   * Called whenever a task transitions out of 'processing'.
+   * If shutdown is in progress and no processing tasks remain, resolves the drain.
+   */
+  private afterTaskCompletion(): void {
+    if (!this._shuttingDown) return;
+    for (const task of this.tasks.values()) {
+      if (task.status === 'processing') return;
+    }
+    // No more processing tasks
+    if (this._drainResolver) {
+      this._drainResolver();
+    }
+  }
+
+  /**
+   * Internal get-next that returns the mutable TaskData.
+   * Used by both `getNext()` and `processNext()`.
+   */
+  private internalGetNext(queue: QueueState): TaskData | null {
+    if (!this.canProcessTask(queue)) return null;
+
+    const now = Date.now();
+    for (let i = 0; i < queue.pending.length; i++) {
+      const t = queue.pending[i];
+      if (t.status !== 'pending') continue;
+      if (t.availableAt && t.availableAt.getTime() > now) continue;
+
+      queue.pending.splice(i, 1);
+      t.status = 'processing';
+      t.startedAt = new Date();
+      return t;
+    }
+    return null;
+  }
+
+  // ── Cron Helpers ──────────────────────────────────────────────────────
+
+  private static cronMatches(cron: string): boolean {
+    const parts = cron.split(/\s+/);
+    if (parts.length !== 5) return false;
+
+    const [minute, hour, dom, month, dow] = parts;
+    const now = new Date();
+
+    return (
+      this.matchesField(minute, now.getMinutes()) &&
+      this.matchesField(hour, now.getHours()) &&
+      this.matchesField(dom, now.getDate()) &&
+      this.matchesField(month, now.getMonth() + 1) &&
+      this.matchesField(dow, now.getDay())
+    );
+  }
+
+  private static matchesField(pattern: string, value: number): boolean {
+    if (pattern === '*') return true;
+    if (pattern.startsWith('*/')) {
+      const interval = parseInt(pattern.slice(2), 10);
+      if (Number.isNaN(interval) || interval <= 0) return false;
+      return value % interval === 0;
+    }
+    return parseInt(pattern, 10) === value;
+  }
+
+  // ══════════════════════════════════════════════════════════════════════
+  //  PUBLIC API
+  // ══════════════════════════════════════════════════════════════════════
+
+  // ── Phase 1 & 2: Basic + Named Queues ─────────────────────────────────
+
+  /**
+   * Add a task to the queue.
+   *
+   * @throws {ShutdownError} if the queue is shutting down.
+   * @throws {InvalidPriorityError} if priority is outside 1–10.
+   * @throws {CircularDependencyError} if dependencies form a cycle.
+   * @throws {MissingDependencyError} if a dependency doesn't exist.
+   */
+  add(payload: unknown, options?: AddTaskOptions): Task {
+    if (this._shuttingDown) throw new ShutdownError();
+
+    const queueName = options?.queue ?? 'default';
+    const priority = options?.priority ?? 5;
+    validatePriority(priority);
+
+    const dependencies = options?.dependencies ?? [];
+    const maxRetries = options?.maxRetries ?? 3;
+    const backoffDelay = options?.backoffDelay ?? 1000;
+
+    // Resolve availability time
+    let availableAt: Date | null = null;
+    if (options?.delay !== undefined && options?.availableAt !== undefined) {
+      throw new TaskQueueError('Cannot specify both delay and availableAt');
+    }
+    if (options?.delay !== undefined) {
+      if (options.delay < 0) {
+        throw new TaskQueueError('delay must be non-negative');
+      }
+      availableAt = new Date(Date.now() + options.delay);
+    } else if (options?.availableAt !== undefined) {
+      availableAt = options.availableAt;
+    }
+
+    // Validate dependency existence
+    const missingDeps = dependencies.filter((id) => !this.tasks.has(id));
+    if (missingDeps.length > 0) {
+      throw new MissingDependencyError(missingDeps);
+    }
+
+    const id = this.nextId();
+    const createdAt = new Date();
+
+    // Cycle detection
+    if (this.wouldCreateCycle(id, dependencies)) {
+      throw new CircularDependencyError(id);
+    }
+
+    // Determine initial status (blocked if any deps are still pending/processing)
+    const unresolvedDeps = dependencies.filter((depId) => {
+      const dep = this.tasks.get(depId);
+      return dep && dep.status !== 'completed';
+    });
+    const initialStatus: TaskStatus =
+      unresolvedDeps.length > 0 ? 'blocked' : 'pending';
+
+    const taskData: TaskData = {
+      id,
+      status: initialStatus,
+      payload,
+      priority,
+      createdAt,
+      availableAt,
+      attempts: 0,
+      maxRetries,
+      backoffDelay,
+      dependencies: [...dependencies],
+      dependents: new Set(),
+      progress: 0,
+      progressMessage: '',
+      error: null,
+      result: undefined,
+      queueName,
+      startedAt: null,
+      completedAt: null,
+      cancelledAt: null,
+    };
+
+    // Register as dependent on each unresolved dependency
+    for (const depId of unresolvedDeps) {
+      const dep = this.tasks.get(depId);
+      if (dep) dep.dependents.add(id);
+    }
+
+    this.tasks.set(id, taskData);
+    const queue = this.getOrCreateQueue(queueName);
+
+    if (initialStatus === 'blocked') {
+      queue.blocked.set(id, taskData);
+    } else {
+      this.insertPending(queue, taskData);
+    }
+
+    return this.toPublicTask(taskData);
+  }
+
+  /**
+   * Retrieve and claim the next available task.
+   *
+   * Returns the highest-priority task whose availability time has elapsed,
+   * or `null` if the queue is empty, all tasks are blocked/delayed, or
+   * the concurrency limit has been reached.
+   */
+  getNext(queueName?: string): Task | null {
+    const qName = queueName ?? 'default';
+    const queue = this.queues.get(qName);
+    if (!queue) return null;
+
+    const data = this.internalGetNext(queue);
+    return data ? this.toPublicTask(data) : null;
+  }
+
+  /** Number of pending tasks in a queue (or across all queues). */
+  getQueueSize(queueName?: string): number {
+    if (queueName !== undefined) {
+      const q = this.queues.get(queueName);
+      return q ? q.pending.length : 0;
+    }
+    let total = 0;
+    for (const q of this.queues.values()) total += q.pending.length;
+    return total;
+  }
+
+  /** List all named queues that exist. */
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  /** Retrieve a task snapshot by id, or null. */
+  getTask(taskId: string): Task | null {
+    const t = this.tasks.get(taskId);
+    return t ? this.toPublicTask(t) : null;
+  }
+
+  // ── Phase 5: Complete / Fail ──────────────────────────────────────────
+
+  /**
+   * Mark a task as completed successfully.
+   * Resolves any dependents and frees a concurrency slot.
+   */
+  complete(taskId: string, result?: unknown): void {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new TaskQueueError(`Task ${taskId} not found`);
+    if (task.status !== 'processing') {
+      throw new TaskQueueError(
+        `Task ${taskId} is not processing (status: ${task.status})`,
+      );
+    }
+
+    task.status = 'completed';
+    task.completedAt = new Date();
+    task.result = result;
+
+    this.resolveDependencies(task);
+    this.afterTaskCompletion();
+  }
+
+  /**
+   * Mark a task as failed.
+   *
+   * If retries remain, the task is re-enqueued with exponential backoff.
+   * Otherwise, it moves to the dead letter queue.
+   */
+  fail(taskId: string, error?: string | Error): void {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new TaskQueueError(`Task ${taskId} not found`);
+    if (task.status !== 'processing') {
+      throw new TaskQueueError(
+        `Task ${taskId} is not processing (status: ${task.status})`,
+      );
+    }
+
+    task.error = error instanceof Error ? error.message : (error ?? null);
+
+    const queue = this.queues.get(task.queueName);
+
+    // Check retry allowance BEFORE incrementing attempts
+    if (task.attempts < task.maxRetries) {
+      const backoffMs = task.backoffDelay * Math.pow(2, task.attempts);
+      task.attempts++;
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + backoffMs);
+      task.error = null;
+      task.result = undefined;
+      task.startedAt = null;
+
+      if (queue) this.insertPending(queue, task);
+    } else {
+      // Exhausted → dead letter
+      task.attempts++;
+      task.status = 'failed';
+      if (queue) queue.deadLetter.push(task);
+      this.afterTaskCompletion();
+    }
+  }
+
+  // ── Phase 6: Dead Letter Queue ────────────────────────────────────────
+
+  /** Return all dead-lettered tasks for a queue. */
+  getDeadLetterTasks(queueName?: string): Task[] {
+    const qName = queueName ?? 'default';
+    const q = this.queues.get(qName);
+    return q ? q.deadLetter.map((t) => this.toPublicTask(t)) : [];
+  }
+
+  /**
+   * Return a dead-lettered task to its original queue for a fresh round
+   * of retries.  Clears error info and resets the attempt counter.
+   */
+  retryDeadLetter(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new TaskQueueError(`Task ${taskId} not found`);
+    if (task.status !== 'failed') {
+      throw new TaskQueueError(
+        `Task ${taskId} is not failed (status: ${task.status})`,
+      );
+    }
+
+    const queue = this.queues.get(task.queueName);
+    if (!queue) throw new TaskQueueError(`Queue ${task.queueName} not found`);
+
+    // Remove from dead-letter list
+    const dlIdx = queue.deadLetter.indexOf(task);
+    if (dlIdx !== -1) queue.deadLetter.splice(dlIdx, 1);
+
+    // Reset
+    task.status = 'pending';
+    task.attempts = 0;
+    task.error = null;
+    task.result = undefined;
+    task.startedAt = null;
+    task.availableAt = null;
+
+    this.insertPending(queue, task);
+  }
+
+  /** Remove all dead-lettered tasks for a queue. */
+  clearDeadLetter(queueName?: string): void {
+    const qName = queueName ?? 'default';
+    const q = this.queues.get(qName);
+    if (q) {
+      for (const t of q.deadLetter) this.tasks.delete(t.id);
+      q.deadLetter = [];
+    }
+  }
+
+  // ── Phase 8: Concurrency Control ──────────────────────────────────────
+
+  /** Set the max concurrent processing limit for a queue (0 = unlimited). */
+  setConcurrency(limit: number, queueName?: string): void {
+    if (limit < 0 || !Number.isInteger(limit)) {
+      throw new TaskQueueError('Concurrency must be a non-negative integer');
+    }
+    this.getOrCreateQueue(queueName ?? 'default').maxConcurrency = limit;
+  }
+
+  /** Get the concurrency limit for a queue. */
+  getConcurrency(queueName?: string): number {
+    const q = this.queues.get(queueName ?? 'default');
+    return q ? q.maxConcurrency : 0;
+  }
+
+  /** Get the number of currently-processing tasks in a queue. */
+  getActiveCount(queueName?: string): number {
+    const qName = queueName ?? 'default';
+    const q = this.queues.get(qName);
+    return q ? this.getActiveCountForQueue(q) : 0;
+  }
+
+  // ── Phase 9: Progress Tracking ────────────────────────────────────────
+
+  /**
+   * Report progress on a task (0–100).  Notifies all subscribers.
+   * Values outside the range are clamped.
+   */
+  reportProgress(taskId: string, progress: number, message?: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new TaskQueueError(`Task ${taskId} not found`);
+
+    task.progress = Math.max(0, Math.min(100, progress));
+    if (message !== undefined) task.progressMessage = message;
+
+    const listeners = this.progressListeners.get(taskId);
+    if (listeners) {
+      for (const cb of listeners) {
+        try {
+          cb(taskId, task.progress, task.progressMessage);
+        } catch {
+          /* swallow listener errors */
+        }
+      }
+    }
+  }
+
+  /**
+   * Subscribe to progress updates for a task.
+   * @returns An unsubscribe function.
+   */
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    if (!this.progressListeners.has(taskId)) {
+      this.progressListeners.set(taskId, new Set());
+    }
+    this.progressListeners.get(taskId)!.add(callback);
+
+    return () => {
+      const set = this.progressListeners.get(taskId);
+      if (set) {
+        set.delete(callback);
+        if (set.size === 0) this.progressListeners.delete(taskId);
+      }
+    };
+  }
+
+  /**
+   * Cancel a task.
+   *
+   * Pending tasks are removed from the queue; processing tasks are
+   * marked cancelled; blocked tasks are removed from the blocked map.
+   * Cancelled tasks are never retried.
+   */
+  cancel(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new TaskQueueError(`Task ${taskId} not found`);
+
+    if (task.status === 'completed' || task.status === 'failed') {
+      throw new TaskQueueError(
+        `Cannot cancel task ${taskId} in status ${task.status}`,
+      );
+    }
+
+    const wasProcessing = task.status === 'processing';
+    const prevStatus = task.status;
+
+    task.status = 'cancelled';
+    task.cancelledAt = new Date();
+
+    // Remove from queue structures
+    const queue = this.queues.get(task.queueName);
+    if (!queue) return;
+
+    if (prevStatus === 'pending') {
+      const idx = queue.pending.indexOf(task);
+      if (idx !== -1) queue.pending.splice(idx, 1);
+    } else if (prevStatus === 'blocked') {
+      queue.blocked.delete(taskId);
+    }
+
+    if (wasProcessing) {
+      this.afterTaskCompletion();
+    }
+  }
+
+  // ── Phase 10: Recurring Tasks ─────────────────────────────────────────
+
+  /** Register a recurring schedule. */
+  addSchedule(config: ScheduleConfig): Schedule {
+    if (this._shuttingDown) throw new ShutdownError();
+
+    const id = `sched_${this.nextId()}`;
+    const schedule: ScheduleData = {
+      id,
+      cron: config.cron,
+      queue: config.queue,
+      payload: config.payload,
+      createdAt: new Date(),
+      lastEnqueuedAt: null,
+    };
+    this.schedules.set(id, schedule);
+    return {
+      id: schedule.id,
+      cron: schedule.cron,
+      queue: schedule.queue,
+      payload: schedule.payload,
+      createdAt: schedule.createdAt,
+      lastEnqueuedAt: schedule.lastEnqueuedAt,
+    };
+  }
+
+  /** Remove a schedule by id. */
+  removeSchedule(scheduleId: string): void {
+    this.schedules.delete(scheduleId);
+  }
+
+  /** List all active schedules. */
+  listSchedules(): Schedule[] {
+    return [...this.schedules.values()].map((s) => ({
+      id: s.id,
+      cron: s.cron,
+      queue: s.queue,
+      payload: s.payload,
+      createdAt: s.createdAt,
+      lastEnqueuedAt: s.lastEnqueuedAt,
+    }));
+  }
+
+  /**
+   * Evaluate all active schedules and enqueue tasks for any that are due.
+   * A schedule fires at most once per minute.
+   */
+  tick(): void {
+    const now = new Date();
+    const currentMinuteBucket = Math.floor(now.getTime() / 60_000);
+
+    for (const schedule of this.schedules.values()) {
+      if (!TaskQueue.cronMatches(schedule.cron)) continue;
+
+      if (schedule.lastEnqueuedAt) {
+        const lastBucket = Math.floor(
+          schedule.lastEnqueuedAt.getTime() / 60_000,
+        );
+        if (lastBucket === currentMinuteBucket) continue;
+      }
+
+      this.add(schedule.payload, { queue: schedule.queue });
+      schedule.lastEnqueuedAt = now;
+    }
+  }
+
+  // ── Phase 11: Middleware ───────────────────────────────────────────────
+
+  /** Register a middleware function for a queue. */
+  use(middleware: MiddlewareFunction, queueName?: string): void {
+    this.getOrCreateQueue(queueName ?? 'default').middleware.push(middleware);
+  }
+
+  /** Register a processing handler for a queue. */
+  process(handler: ProcessFunction, queueName?: string): void {
+    this.getOrCreateQueue(queueName ?? 'default').handler = handler;
+  }
+
+  /**
+   * Retrieve and process the next task from a queue.
+   *
+   * If a handler is registered, the task passes through all middleware
+   * and then to the handler, with automatic complete/fail.  If no handler
+   * is registered the task is still claimed but the caller must manually
+   * call complete/fail.
+   *
+   * @returns The claimed task, or null.
+   */
+  async processNext(queueName?: string): Promise<Task | null> {
+    const qName = queueName ?? 'default';
+    const queue = this.queues.get(qName);
+    if (!queue) return null;
+
+    const taskData = this.internalGetNext(queue);
+    if (!taskData) return null;
+
+    if (queue.middleware.length > 0 || queue.handler) {
+      await this.runMiddleware(taskData, queue);
+    }
+
+    return this.toPublicTask(taskData);
+  }
+
+  // ── Phase 12: Graceful Shutdown ───────────────────────────────────────
+
+  /** Whether the queue has been instructed to shut down. */
+  get isShuttingDown(): boolean {
+    return this._shuttingDown;
+  }
+
+  /** Register a callback to invoke during shutdown. */
+  onShutdown(callback: ShutdownCallback): void {
+    this.shutdownCallbacks.add(callback);
+  }
+
+  /**
+   * Initiate a graceful shutdown.
+   *
+   * 1. Stops accepting new tasks.
+   * 2. Runs registered shutdown callbacks.
+   * 3. Waits for processing tasks to finish (up to `timeout` ms).
+   * 4. Force-cancels any still-processing tasks after the timeout.
+   * 5. Returns a summary (completed, cancelled, duration).
+   *
+   * Calling shutdown multiple times safely returns the same result.
+   */
+  async shutdown(timeout = 30_000): Promise<ShutdownResult> {
+    if (this._shutdownPromise) return this._shutdownPromise;
+
+    this._shuttingDown = true;
+    const startTime = Date.now();
+
+    // Run callbacks
+    for (const cb of this.shutdownCallbacks) {
+      try {
+        cb();
+      } catch {
+        /* swallow */
+      }
+    }
+
+    this._shutdownPromise = new Promise<ShutdownResult>((resolve) => {
+      const processing = [...this.tasks.values()].filter(
+        (t) => t.status === 'processing',
+      );
+
+      if (processing.length === 0) {
+        resolve({ completed: 0, cancelled: 0, duration: Date.now() - startTime });
+        return;
+      }
+
+      const timeoutId = setTimeout(() => {
+        // Force-cancel still-processing tasks
+        for (const task of this.tasks.values()) {
+          if (task.status === 'processing') {
+            task.status = 'cancelled';
+            task.cancelledAt = new Date();
+          }
+        }
+        this._drainResolver = null;
+        // Count all tasks that were force-cancelled (we just set them above)
+        const cancelledCount = [...this.tasks.values()].filter(
+          (t) => t.cancelledAt !== null,
+        ).length;
+        resolve({
+          completed: [...this.tasks.values()].filter(
+            (t) => t.status === 'completed',
+          ).length,
+          cancelled: cancelledCount,
+          duration: Date.now() - startTime,
+        });
+      }, timeout);
+
+      this._drainResolver = () => {
+        clearTimeout(timeoutId);
+        resolve({
+          completed: [...this.tasks.values()].filter(
+            (t) => t.status === 'completed',
+          ).length,
+          cancelled: 0,
+          duration: Date.now() - startTime,
+        });
+      };
+    });
+
+    return this._shutdownPromise;
+  }
+}
