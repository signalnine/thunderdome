.duration).toBeGreaterThanOrEqual(50);\n  });\n\n  it('should force-cancel tasks that exceed the shutdown timeout', async () => {\n    const queue = new TaskQueue();\n    queue.enqueue('long-task');\n\n    const t1 = queue.dequeue()!;\n\n    // Short timeout — task won't complete in time\n    const summary = await queue.shutdown(100);\n\n    expect(summary.forceCancelled).toBe(1);\n    expect(t1.status).toBe('cancelled');\n  });\n\n  it('should run shutdown callbacks', async () => {\n    const queue = new TaskQueue();\n    const cb = vi.fn();\n\n    queue.onShutdown(cb);\n    await queue.shutdown();\n\n    expect(cb).toHaveBeenCalledTimes(1);\n  });\n\n  it('should be safe to call shutdown multiple times', async () => {\n    const queue = new TaskQueue();\n\n    const summary1 = await queue.shutdown();\n    const summary2 = await queue.shutdown();\n\n    // Both should return the same result\n    expect(summary1).toEqual(summary2);\n  });\n\n  it('should return a summary with detailed counts', async () => {\n    const queue = new TaskQueue();\n    queue.enqueue('task1');\n    queue.enqueue('task2');\n    queue.enqueue('task3');\n\n    const t1 = queue.dequeue()!;\n    const t2 = queue.dequeue()!;\n    const t3 = queue.dequeue()!;\n\n    // Complete t1, leave t2, t3 will be force-cancelled\n    setTimeout(() => queue.completeTask(t1.id), 20);\n\n    const summary = await queue.shutdown(50);\n\n    expect(summary).toHaveProperty('completed');\n    expect(summary).toHaveProperty('forceCancelled');\n    expect(summary).toHaveProperty('duration');\n    expect(summary.completed).toBeGreaterThanOrEqual(0);\n    expect(summary.forceCancelled).toBeGreaterThanOrEqual(0);\n    expect(summary.duration).toBeGreaterThan(0);\n  });\n\n  it('should not shut down while tasks are still enqueued but not processed', async () => {\n    const queue = new TaskQueue();\n    queue.enqueue('will-not-be-processed');\n\n    // Shutdown — there are no processing tasks, only pending\n    const s