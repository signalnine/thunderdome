ess('skipping', handler);\n\n    queue.enqueue('skipping', 'skipped');\n    await queue.process('skipping');\n\n    // Handler should NOT have been called\n    expect(handler).not.toHaveBeenCalled();\n  });\n\n  it('should allow middleware to modify the task', () => {\n    const queue = new TaskQueue();\n\n    queue.use(\n      'modifying',\n      async (ctx) => {\n        (ctx.task.payload as Record<string, unknown>).modified = true;\n        await ctx.next();\n      },\n    );\n\n    let processedTask: unknown;\n    queue.process('modifying', async (task) => {\n      processedTask = task;\n    });\n\n    queue.enqueue('modifying', { original: true });\n    queue.process('modifying');\n\n    expect(processedTask).toBeDefined();\n    expect(processedTask).toHaveProperty('payload.modified', true);\n    expect(processedTask).toHaveProperty('payload.original', true);\n  });\n\n  it('should mark task as failed if middleware throws', async () => {\n    const queue = new TaskQueue();\n\n    queue.use(\n      'failing',\n      async () => {\n        throw new Error('middleware error');\n      },\n    );\n    queue.process('failing', async () => {\n      // Should not reach here\n    });\n\n    queue.enqueue('failing', 'will-fail');\n    await queue.process('failing');\n\n    // Task should have been marked as failed\n    expect(queue.getDeadLetterTasks('failing').length).toBe(1);\n    expect(queue.getDeadLetterTasks('failing')[0].error).not.toBeNull();\n  });\n\n  it('should have independent middleware per queue', () => {\n    const queue = new TaskQueue();\n\n    const mw1 = vi.fn(async (ctx: MiddlewareContext) => {\n      await ctx.next();\n    });\n    const mw2 = vi.fn(async (ctx: MiddlewareContext) => {\n      await ctx.next();\n    });\n\n    queue.use('queue-a', mw1);\n    queue.use('queue-b', mw2);\n\n    const handler = vi.fn();\n    queue.process('queue-a', handler);\n\n    queue.enqueue('queue-a', 'task-a');\n    queue.process('queue-a');\n\n    expect(mw1).toHaveBeenCalledTimes(1);\n    expect(mw2).not.toHaveBeenCalled();\n  });\n\n  it('should handle multiple middlewares where one skips', async () => {\n    const queue = new TaskQueue();\n    const handler = vi.fn();\n\n    queue.use(\n      'multi',\n      async (ctx) => {\n        await ctx.next(); // pass through\n      },\n    );\n    queue.use(\n      'multi',\n      async () => {\n        // skip — does NOT call next\n      },\n    );\n    queue.use(\n      'multi',\n      async () => {\n        // Should never reach here\n      },\n    );\n    queue.process('multi', handler);\n\n    queue.enqueue('multi', 'test');\n    await queue.process('multi');\n\n    // Handler should not be called since second middleware skipped\n    expect(handler).not.toHaveBeenCalled();\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":126,"cache_creation_input_tokens":0,"cache_read_input_tokens":64512,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e9888b27-4f42-4b85-b6f2-263d9c89bc46","uuid":"80439ae2-4b95-4f72-9040-571e83690084"}
