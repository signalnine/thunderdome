         this.shutdownResolve = null;\n        }, timeout);\n      }\n    });\n  }\n\n  onShutdown(callback: () => void): void {\n    this.shutdownCallbacks.push(callback);\n  }\n\n  isShuttingDown(): boolean {\n    return this.shuttingDown;\n  }\n\n  // ── Private helpers ────────────────────────────────────────────────────────\n\n  private getOrCreateQueue(name: string): QueueState {\n    let queue = this.queues.get(name);\n    if (!queue) {\n      queue = {\n        name,\n        taskIds: new Set(),\n        deadLetter: [],\n        concurrency: null,\n        activeCount: 0,\n        middleware: [],\n        handler: null,\n      };\n      this.queues.set(name, queue);\n    }\n    return queue;\n  }\n\n  private getQueue(name?: string): QueueState | undefined {\n    if (name === undefined || name === null) {\n      return this.queues.get('default');\n    }\n    return this.queues.get(name);\n  }\n\n  private toPublicTask(task: TaskData): Task {\n    return task as unknown as Task;\n  }\n\n  // Phase 7: Cycle detection\n  private checkCycles(dependsOn: string[]): void {\n    const visited = new Set<string>();\n    const stack = new Set<string>();\n\n    // Build adjacency list from current tasks' dependencies\n    const graph = new Map<string, string[]>();\n    for (const [, task] of this.tasks) {\n      if (task.dependsOn.length > 0) {\n        graph.set(task.id, [...task.dependsOn]);\n      }\n    }\n\n    // Check if adding these dependencies (from a new task) would cause a cycle\n    const dfs = (node: string): boolean => {\n      if (stack.has(node)) return true; // cycle found\n      if (visited.has(node)) return false;\n\n      visited.add(node);\n      stack.add(node);\n\n      const deps = graph.get(node) ?? [];\n      for (const dep of deps) {\n        if (dfs(dep)) return true;\n      }\n\n      stack.delete(node);\n      return false;\n    };\n\n    // The new task depends on these tasks. If any of those tasks\n    // transitively depends on the new 