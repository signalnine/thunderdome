(() => {\n      expect(queue.getActiveCount()).toBe(0);\n    }, 10);\n  });\n\n  it('should respect priority within concurrency limit', () => {\n    const queue = new TaskQueue();\n    queue.setConcurrency(1);\n\n    queue.enqueue('low', { priority: 10 });\n    queue.enqueue('high', { priority: 1 });\n\n    // High priority should come out first\n    const t1 = queue.dequeue()!;\n    expect(t1.payload).toBe('high');\n  });\n\n  it('should set and query concurrency limits per queue', () => {\n    const queue = new TaskQueue();\n\n    queue.setConcurrency(5, 'worker');\n    expect(queue.getConcurrency('worker')).toBe(5);\n\n    // Default queue should still be unlimited\n    expect(queue.getConcurrency()).toBeNull();\n  });\n\n  it('should have independent limits per named queue', () => {\n    const queue = new TaskQueue();\n    queue.setConcurrency(1, 'q1');\n    queue.setConcurrency(3, 'q2');\n\n    queue.enqueue('q1', 'a');\n    queue.enqueue('q1', 'b');\n    queue.enqueue('q2', 'c');\n    queue.enqueue('q2', 'd');\n    queue.enqueue('q2', 'e');\n    queue.enqueue('q2', 'f');\n\n    // q1: only 1 active at a time\n    const t1 = queue.dequeue('q1')!;\n    expect(t1.payload).toBe('a');\n    expect(queue.dequeue('q1')).toBeNull();\n\n    // q2: up to 3 active\n    const t2 = queue.dequeue('q2')!;\n    const t3 = queue.dequeue('q2')!;\n    const t4 = queue.dequeue('q2')!;\n    expect(t2).not.toBeNull();\n    expect(t3).not.toBeNull();\n    expect(t4).not.toBeNull();\n    expect(queue.dequeue('q2')).toBeNull();\n\n    // Complete q1 task\n    queue.completeTask(t1.id);\n    expect(queue.dequeue('q1')!.payload).toBe('b');\n  });\n\n  it('should reject invalid concurrency limits', () => {\n    const queue = new TaskQueue();\n    expect(() => queue.setConcurrency(0)).toThrow();\n    expect(() => queue.setConcurrency(-1)).toThrow();\n    expect(() => queue.setConcurrency(1.5)).toThrow();\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":2900