+{"type":"assistant","message":{"id":"eb9a49d4-f552-41ad-86da-b0a87d767a6c","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{"type":"tool_use","id":"call_01_eWpTK5ggjflLa4rKHXeM8449","name":"Write","input":{"file_path":"/workspace/tests/phase-03.test.ts","content":"import { describe, it, expect } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 03: Priority', () => {\n  it('should use default priority of 5 when not specified', () => {\n    const queue = new TaskQueue();\n    const task = queue.enqueue('test');\n    expect(task.priority).toBe(5);\n  });\n\n  it('should dequeue higher-priority tasks first', () => {\n    const queue = new TaskQueue();\n\n    queue.enqueue({ msg: 'low' }, { priority: 10 });\n    queue.enqueue({ msg: 'high' }, { priority: 1 });\n    queue.enqueue({ msg: 'medium' }, { priority: 5 });\n\n    const t1 = queue.dequeue();\n    expect(t1!.payload).toEqual({ msg: 'high' });\n\n    const t2 = queue.dequeue();\n    expect(t2!.payload).toEqual({ msg: 'medium' });\n\n    const t3 = queue.dequeue();\n    expect(t3!.payload).toEqual({ msg: 'low' });\n  });\n\n  it('should maintain FIFO order within same priority', () => {\n    const queue = new TaskQueue();\n\n    queue.enqueue('first', { priority: 5 });\n    queue.enqueue('second', { priority: 5 });\n    queue.enqueue('third', { priority: 5 });\n\n    expect(queue.dequeue()!.payload).toBe('first');\n    expect(queue.dequeue()!.payload).toBe('second');\n    expect(queue.dequeue()!.payload).toBe('third');\n  });\n\n  it('should interleave priorities correctly', () => {\n    const queue = new TaskQueue();\n\n    queue.enqueue('A', { priority: 3 });\n    queue.enqueue('B', { priority: 1 });\n    queue.enqueue('C', { priority: 3 });\n    queue.enqueue('D', { priority: 5 });\n    queue.enqueue('E', { priority: 1 });\n\n    expect(queue.dequeue()!.payload).toBe('B'); // priority 1, first\n    expect(queue.dequeue()!.payload).toBe('E'); // priority 1, second\n    expect(queue.dequeue()!.payload).toBe('A'); // priority 3, first\n    expect(queue.dequeue()!.payload).toBe('C'); // priority 3, second\n    expect(queue.dequeue()!.payload).toBe('D'); // priority 5\n  });\n\n  it('should reject invalid priorities', () => {\n    const queue = new TaskQueue();\n\n    expect(() => queue.enqueue('bad', { priority: 0 })).toThrow();\n    expect(() => queue.enqueue('bad', { priority: 11 })).toThrow();\n    expect(() => queue.enqueue('bad', { priority: -1 })).toThrow();\n    expect(() => queue.enqueue('bad', { priority: 3.5 })).toThrow();\n  });\n\n  it('should allow valid priority values 1-10', () => {\n    const queue = new TaskQueue();\n\n    for (let p = 1; p <= 10; p++) {\n      const task = queue.enqueue(`p${p}`, { priority: p });\n      expect(task.priority).toBe(p);\n    }\n  });\n\n  it('should expose priority on the task object', () => {\n    const queue = new TaskQueue();\n    const task = queue.enqueue('test', { priority: 3 });\n    expect(task.priority).toBe(3);\n\n    // Also check after dequeue\n    const dequeued = queue.dequeue();\n    expect(dequeued!.priority).toBe(3);\n  });\n\n  it('should handle priority per named queue', () => {\n    const queue = new TaskQueue();\n\n    queue.enqueue('urgent', 'critical', { priority: 1 });\n    queue.enqueue('urgent', 'normal', { priority: 5 });\n    queue.enqueue('normal', 'important', { priority: 2 });\n\n    // Each queue should be independent\n    expect(queue.dequeue('urgent')!.payload).toBe('critical');\n    expect(queue.dequeue('normal')!.payload).toBe('important');\n    expect(queue.dequeue('urgent')!.payload).toBe('normal');\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1012,"cache_creation_input_tokens":0,"cache_read_input_tokens":54272,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e9888b27-4f42-4b85-b6f2-263d9c89bc46","uuid":"52833f46-5c95-4a15-ad21-18638b27