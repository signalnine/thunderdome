on = (context: MiddlewareContext) => Promise<void>;\n\nexport type ProcessHandler = (task: Task) => Promise<void>;\n\nexport interface ShutdownSummary {\n  completed: number;\n  forceCancelled: number;\n  duration: number;\n}\n\n// ── Internal types ─────────────────────────────────────────────────────────────\n\nconst TASK_OPTION_KEYS = new Set([\n  'priority',\n  'delay',\n  'runAt',\n  'maxRetries',\n  'backoffBase',\n  'dependsOn',\n]);\n\n/** Heuristic: does the value look like a TaskOptions object? */\nfunction isOptionsLike(value: unknown): value is TaskOptions {\n  if (typeof value !== 'object' || value === null || Array.isArray(value)) {\n    return false;\n  }\n  const keys = Object.keys(value);\n  if (keys.length === 0) return false;\n  return keys.some((k) => TASK_OPTION_KEYS.has(k));\n}\n\ninterface QueueState {\n  name: string;\n  taskIds: Set<string>;\n  deadLetter: TaskData[];\n  concurrency: number | null;\n  activeCount: number;\n  middleware: MiddlewareFunction[];\n  handler: ProcessHandler | null;\n}\n\ninterface TaskData {\n  id: string;\n  queueName: string;\n  payload: unknown;\n  status: TaskStatus;\n  priority: number;\n  createdAt: Date;\n  updatedAt: Date;\n  availableAt: Date | null;\n  attempts: number;\n  maxRetries: number;\n  backoffBase: number;\n  dependsOn: string[];\n  error: Error | null;\n  progress: { percentage: number; message?: string } | null;\n}\n\n// ── Main class ─────────────────────────────────────────────────────────────────\n\nexport class TaskQueue {\n  private readonly queues = new Map<string, QueueState>();\n  private readonly tasks = new Map<string, TaskData>();\n  private readonly schedules: ScheduleData[] = [];\n  private readonly progressListeners = new Map<string, Set<ProgressCallback>>();\n  private shuttingDown = false;\n  private shutdownResolve: (() => void) | null = null;\n  private shutdownTimeoutId: ReturnType<typeof setTimeout> | null = null;\n  private shutdownCallbacks: Array<() => void> = [];\n  private shutdownSummary: ShutdownSummary | null = null;\n  private shutdownCompletedCount = 0;\n  private shutdownForceCancelledCount = 0;\n  private shutdownStartTime = 0;\n\n  // ── Phase 1-2: Basic + Named Queues ─────────────────────────────────────────\n\n  enqueue(\n    queueNameOrPayload: unknown,\n    payloadOrOptions?: unknown,\n    maybeOptions?: TaskOptions,\n  ): Task {\n    if (this.shuttingDown) {\n      throw new Error('Cannot add tasks to a shutting-down queue');\n    }\n\n    let queueName: string;\n    let payload: unknown;\n    let options: TaskOptions | undefined;\n\n    if (typeof queueNameOrPayload === 'string' && payloadOrOptions !== undefined) {\n      if (isOptionsLike(payloadOrOptions)) {\n        // enqueue(payload, options) — first arg is a string payload\n        queueName = 'default';\n        payload = queueNameOrPayload;\n        options = payloadOrOptions as TaskOptions;\n      } else {\n        // enqueue(queueName, payload, options?)\n        queueName = queueNameOrPayload;\n        payload = payloadOrOptions;\n        options = maybeOptions;\n      }\n    } else {\n      // enqueue(payload, options?)\n      queueName = 'default';\n      payload = queueNameOrPayload;\n      options = payloadOrOptions as TaskOptions | undefined;\n    }\n\n    const priority = options?.priority ?? 5;\n    if (priority < 1 || priority > 10 || !Number.isInteger(priority)) {\n      throw new Error(\n        `Priority must be an integer between 1 and 10, got ${priority}`,\n      );\n    }\n\n    const taskId = crypto.randomUUID();\n\n    // Phase 7: Validate dependencies\n    const dependsOn: string[] = options?.dependsOn ?? [];\n    if (dependsOn.length > 0) {\n      for (const depId of dependsOn) {\n        const dep = this.tasks.get(depId);\n        if (!dep) {\n          throw new Error(`Dependency task \"${depId}\" does not exist`);\n        }\n      }\n      // Check for circular dependencies (including the new task)\n      this.checkCycles(taskId, dependsOn);\n    }\n\n    const now = new Date();\n    let availableAt: Date | null = null;\n\n    // Phase 4: delay / runAt\n    if (options?.delay !== undefined && options.delay > 0) {\n      availableAt = new Date(now.getTime() + options.delay);\n    }\n    if (options?.runAt !== undefined) {\n      const runAtTime =\n        options.runAt instanceof Date\n          ? options.runAt.getTime()\n          : options.runAt;\n      const runAtDate = new Date(runAtTime);\n      if (availableAt === null || runAtDate > availableAt) {\n        availableAt = runAtDate;\n      }\n    }\n\n    const task: TaskData = {\n      id: taskId,\n      queueName,\n      payload,\n      status: dependsOn.length > 0 ? 'blocked' : 'pending',\n      priority,\n      createdAt: now,\n      updatedAt: now,\n      availableAt,\n      attempts: 0,\n      maxRetries: options?.maxRetries ?? 3,\n      backoffBase: options?.backoffBase ?? 1000,\n      dependsOn,\n      error: null,\n      progress: null,\n    };\n\n    this.tasks.set(task.id, task);\n\n    const queue = this.getOrCreateQueue(queueName);\n    queue.taskIds.add(task.id);\n\n    return this.toPublicTask(task);\n  }\n\n  dequeue(queueName?: string): Task | null {\n    if (this.shuttingDown) return null;\n\n    const queue = this.getQueue(queueName);\n    if (!queue) return null;\n\n    // Phase 8: Check concurrency limit\n    if (queue.concurrency !== null && queue.activeCount >= queue.concurrency) {\n      return null;\n    }\n\n    const now = Date.now();\n    let bestTask: TaskData | null = null;\n\n    for (const taskId of queue.taskIds) {\n      const task = this.tasks.get(taskId);\n      if (!task) continue;\n      if (task.status !== 'pending' && task.status !== 'blocked') continue;\n\n      // Phase 4: Check availability (delay)\n      if (task.availableAt && task.availableAt.getTime() > now) continue;\n\n      // Phase 7: Check dependencies\n      if (task.dependsOn.length > 0) {\n        const allMet = task.dependsOn.every((depId) => {\n          const dep = this.tasks.get(depId);\n          return dep && dep.status === 'completed';\n        });\n        if (!allMet) {\n          // Ensure it's marked as blocked\n          if (task.status !== 'blocked') {\n            task.status = 'blocked';\n            task.updatedAt = new Date();\n          }\n          continue;\n        }\n        // Dependencies met — ensure it's pending (unblock)\n        if (task.status === 'blocked') {\n          task.status = 'pending';\n          task.updatedAt = new Date();\n        }\n      }\n\n      // Skip if not pending (e.g. still blocked after dependency check)\n      if (task.status !== 'pending') continue;\n\n      // Phase 3: Pick best by priority then FIFO\n      if (\n        bestTask === null ||\n        task.priority < bestTask.priority ||\n        (task.priority === bestTask.priority &&\n          task.createdAt.getTime() < bestTask.createdAt.getTime())\n      ) {\n        bestTask = task;\n      }\n    }\n\n    if (bestTask) {\n      bestTask.status = 'processing';\n      bestTask.updatedAt = new Date();\n      queue.activeCount++;\n      return this.toPublicTask(bestTask);\n    }\n\n    return null;\n  }\n\n  getQueueSize(queueName?: string): number {\n    const queue = this.getQueue(queueName);\n    if (!queue) return 0;\n\n    let count = 0;\n    for (const taskId of queue.taskIds) {\n      const task = this.tasks.get(taskId);\n      if (task && task.status === 'pending') {\n        // Count only if available (not delayed in the future)\n        if (!task.availableAt || task.availableAt.getTime() <= Date.now()) {\n          count++;\n        }\n      }\n    }\n    return count;\n  }\n\n  getQueueNames(): string[] {\n    return Array.from(this.queues.keys());\n  }\n\n  // ── Phase 5: Retry with Backoff ─────────────────────────────────────────────\n\n  completeTask(taskId: string): void {\n    const task = this.tasks.get(taskId);\n    if (!task) {\n      throw new Error(`Task \"${taskId}\" not found`);\n    }\n    if (task.status !== 'processing') {\n      throw new Error(\n        `Task \"${taskId}\" is not in processing state (current: ${task.status})`,\n      );\n    }\n\n    task.status = 'completed';\n    task.updatedAt = new Date();\n\n    // Free concurrency slot (Phase 8)\n    this.freeConcurrencySlot(task.queueName);\n\n    // Track for shutdown summary\n    if (this.shuttingDown) {\n      this.shutdownCompletedCount++;\n    }\n\n    // Check if this unblocks any dependent tasks (Phase 7)\n    this.checkDependentTasks(taskId);\n  }\n\n  failTask(taskId: string, error?: Error): void {\n    const task = this.tasks.get(taskId);\n    if (!task) {\n      throw new Error(`Task \"${taskId}\" not found`);\n    }\n\n    // Allow processing or cancelled (if cancelTask was called before failTask)\n    if (task.status !== 'processing' && task.status !== 'cancelled') {\n      throw new Error(\n        `Task \"${taskId}\" is not in processing state (current: ${task.status})`,\n      );\n    }\n\n    task.attempts++;\n    task.error = error ?? null;\n    task.updatedAt = new Date();\n\n    // Free concurrency slot (Phase 8) — safe if already freed by cancelTask\n    this.freeConcurrencySlot(task.queueName);\n\n    // Phase 9: Cancelled tasks are never retried\n    if (task.status === 'cancelled') {\n      return;\n    }\n\n    if (task.attempts < task.maxRetries) {\n      // Retry with backoff: baseDelay * 2^(attempt - 1)\n      const backoffDelay =\n        task.backoffBase * Math.pow(2, task.attempts - 1);\n      task.status = 'pending';\n      task.availableAt = new Date(Date.now() + backoffDelay);\n      task.error = null; // Clear error for retry\n    } else {\n      // Exhausted retries — mark as failed\n      task.status = 'failed';\n\n      // Phase 6: Move to dead letter queue\n      const queue = this.queues.get(task.queueName);\n      if (queue) {\n        queue.deadLetter.push({ ...task });\n      }\n    }\n  }\n\n  // ── Phase 6: Dead Letter Queue ─────────────────────────────────────────────\n\n  getDeadLetterTasks(queueName?: string): Task[] {\n    const queue = this.getQueue(queueName);\n    if (!queue) return [];\n    return queue.deadLetter.map((t) => this.toPublicTask(t));\n  }\n\n  retryDeadLetterTask(taskId: string): void {\n    // Find which queue has this task in its DLQ\n    for (const [, queue] of this.queues) {\n      const idx = queue.deadLetter.findIndex((t) => t.id === taskId);\n      if (idx !== -1) {\n        const liveTask = this.tasks.get(taskId);\n        if (liveTask) {\n          liveTask.status = 'pending';\n          liveTask.attempts = 0;\n          liveTask.error = null;\n          liveTask.updatedAt = new Date();\n          liveTask.availableAt = null;\n        }\n        queue.deadLetter.splice(idx, 1);\n        return;\n      }\n    }\n    throw new Error(`Dead letter task \"${taskId}\" not found`);\n  }\n\n  clearDeadLetterQueue(queueName?: string): void {\n    const queue = this.getQueue(queueName);\n    if (!queue) return;\n    queue.deadLetter = [];\n  }\n\n  // ── Phase 8: Concurrency Control ───────────────────────────────────────────\n\n  setConcurrency(limit: number, queueName?: string): void {\n    if (limit < 1 || !Number.isInteger(limit)) {\n      throw new Error('Concurrency limit must be a positive integer');\n    }\n    const queue = this.getOrCreateQueue(queueName ?? 'default');\n    queue.concurrency = limit;\n  }\n\n  getConcurrency(queueName?: string): number | null {\n    const queue = this.getQueue(queueName);\n    if (!queue) return null;\n    return queue.concurrency;\n  }\n\n  getActiveCount(queueName?: string): number {\n    const queue = this.getQueue(queueName);\n    if (!queue) return 0;\n    return queue.activeCount;\n  }\n\n  // ── Phase 9: Progress and Cancellation ─────────────────────────────────────\n\n  updateProgress(taskId: string, percentage: number, message?: string): void {\n    if (percentage < 0 || percentage > 100 || !Number.isFinite(percentage)) {\n      throw new Error('Progress percentage must be between 0 and 100');\n    }\n\n    const task = this.tasks.get(taskId);\n    if (!task) {\n      throw new Error(`Task \"${taskId}\" not found`);\n    }\n\n    task.progress = { percentage, message: message ?? undefined };\n    task.updatedAt = new Date();\n\n    // Notify listeners\n    const listeners = this.progressListeners.get(taskId);\n    if (listeners) {\n      const update: ProgressUpdate = {\n        taskId,\n        percentage,\n        message: message ?? undefined,\n      };\n      for (const cb of listeners) {\n        try {\n          cb(update);\n        } catch {\n          // Swallow listener errors\n        }\n      }\n    }\n  }\n\n  onProgress(taskId: string, callback: ProgressCallback): () => void {\n    const task = this.tasks.get(taskId);\n    if (!task) {\n      throw new Error(`Task \"${taskId}\" not found`);\n    }\n\n    let listeners = this.progressListeners.get(taskId);\n    if (!listeners) {\n      listeners = new Set();\n      this.progressListeners.set(taskId, listeners);\n    }\n    listeners.add(callback);\n\n    return () => {\n      listeners?.delete(callback);\n      if (listeners?.size === 0) {\n        this.progressListeners.delete(taskId);\n      }\n    };\n  }\n\n  cancelTask(taskId: string): void {\n    const task = this.tasks.get(taskId);\n    if (!task) {\n      throw new Error(`Task \"${taskId}\" not found`);\n    }\n\n    if (task.status === 'pending' || task.status === 'blocked') {\n      // Remove from queue, mark cancelled\n      task.status = 'cancelled';\n      task.updatedAt = new Date();\n      const queue = this.queues.get(task.queueName);\n      queue?.taskIds.delete(taskId);\n    } else if (task.status === 'processing') {\n      task.status = 'cancelled';\n      task.updatedAt = new Date();\n      // Free concurrency slot\n      this.freeConcurrencySlot(task.queueName);\n    } else {\n      throw new Error(\n        `Cannot cancel task \"${taskId}\" in state \"${task.status}\"`,\n      );\n    }\n  }\n\n  // ── Phase 10: Recurring Tasks ──────────────────────────────────────────────\n\n  addSchedule(\n    cronExpression: string,\n    queueName: string,\n    payload: unknown,\n  ): string {\n    // Validate cron expression\n    const parts = cronExpression.trim().split(/\\s+/);\n    if (parts.length !== 5) {\n      throw new Error(\n        `Invalid cron expression \"${cronExpression}\": expected 5 fields`,\n      );\n    }\n\n    // Validate each field's syntax\n    for (const part of parts) {\n      if (!/^(\\*|\\d+|\\*\\/\\d+)$/.test(part)) {\n        throw new Error(`Invalid cron field \"${part}\"`);\n      }\n    }\n\n    const schedule: ScheduleData = {\n      id: crypto.randomUUID(),\n      cronExpression,\n      queueName,\n      payload,\n      lastTriggered: null,\n    };\n\n    this.schedules.push(schedule);\n    return schedule.id;\n  }\n\n  removeSchedule(scheduleId: string): void {\n    const idx = this.schedules.findIndex((s) => s.id === scheduleId);\n    if (idx !== -1) {\n      this.schedules.splice(idx, 1);\n    }\n  }\n\n  listSchedules(): Schedule[] {\n    return this.schedules.map((s) => ({\n      id: s.id,\n      cronExpression: s.cronExpression,\n      queueName: s.queueName,\n      payload: s.payload,\n      lastTriggered: s.lastTriggered ? new Date(s.lastTriggered) : null,\n    }));\n  }\n\n  tick(): void {\n    const now = new Date();\n\n    for (const schedule of this.schedules) {\n      if (this.isCronDue(schedule.cronExpression, now, schedule.lastTriggered)) {\n        // Enqueue a task for this schedule\n        this.enqueueInternal(schedule.queueName, schedule.payload);\n        schedule.lastTriggered = new Date(now);\n      }\n    }\n  }\n\n  // ── Phase 11: Middleware Pipeline ──────────────────────────────────────────\n\n  use(queueName: string, middleware: MiddlewareFunction): void {\n    const queue = this.getOrCreateQueue(queueName);\n    queue.middleware.push(middleware);\n  }\n\n  /**\n   * Register a handler for a queue, or if no handler given, process the next\n   * task from the queue through the middleware pipeline.\n   *\n   * When processing, the return value is the processed task, or null if no\n   * task was available. If the middleware chain or handler throws, the task\n   * is marked as failed. Otherwise the task is completed automatically.\n   */\n  process(queueName: string, handler?: ProcessHandler): Promise<Task | null> {\n    if (handler) {\n      // Register handler\n      const queue = this.getOrCreateQueue(queueName);\n      queue.handler = handler;\n      return Promise.resolve(null);\n    }\n\n    return this.runMiddlewarePipeline(queueName);\n  }\n\n  // ── Phase 12: Graceful Shutdown ───────────────────────────────────────────\n\n  async shutdown(timeout?: number): Promise<ShutdownSummary> {\n    if (this.shutdownSummary) {\n      return this.shutdownSummary;\n    }\n\n    this.shuttingDown = true;\n    this.shutdownStartTime = Date.now();\n\n    // Run shutdown callbacks\n    for (const cb of this.shutdownCallbacks) {\n      try {\n        cb();\n      } catch {\n        // Swallow callback errors\n      }\n    }\n\n    // Count currently processing tasks\n    const activeTaskCount = this.getTotalActiveCount();\n\n    if (activeTaskCount === 0) {\n      // No tasks processing — complete immediately\n      return this.finalizeShutdown();\n    }\n\n    // Wait for processing tasks to finish, or timeout\n    return new Promise<ShutdownSummary>((resolve) => {\n      this.shutdownResolve = () => {\n        resolve(this.finalizeShutdown());\n      };\n\n      if (timeout !== undefined && timeout > 0) {\n        this.shutdownTimeoutId = setTimeout(() => {\n          // Force-cancel all still-processing tasks\n          this.forceCancelProcessingTasks();\n          this.shutdownResolve?.();\n          this.shutdownResolve = null;\n        }, timeout);\n      }\n    });\n  }\n\n  onShutdown(callback: () => void):