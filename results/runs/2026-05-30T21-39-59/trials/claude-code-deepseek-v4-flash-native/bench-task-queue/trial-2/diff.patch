t callback = vi.fn();\n    const unsubscribe = queue.onProgress(processing.id, callback);\n    queue.updateProgress(processing.id, 50);\n    expect(callback).toHaveBeenCalledTimes(1);\n\n    unsubscribe();\n    queue.updateProgress(processing.id, 100);\n    expect(callback).toHaveBeenCalledTimes(1); // not called again\n  });\n\n  it('should cancel a pending task', () => {\n    const queue = new TaskQueue();\n    const task = queue.enqueue('cancel-me');\n\n    expect(task.status).toBe('pending');\n    queue.cancelTask(task.id);\n    expect(task.status).toBe('cancelled');\n\n    // Should not appear in dequeue\n    expect(queue.dequeue()).toBeNull();\n    expect(queue.getQueueSize()).toBe(0);\n  });\n\n  it('should cancel a processing task', () => {\n    const queue = new TaskQueue();\n    const task = queue.enqueue('cancel-me');\n    const processing = queue.dequeue()!;\n\n    expect(processing.status).toBe('processing');\n\n    queue.cancelTask(processing.id);\n    expect(processing.status).toBe('cancelled');\n  });\n\n  it('should not retry cancelled tasks', () => {\n    const queue = new TaskQueue();\n    const task = queue.enqueue('no-retry', { maxRetries: 3 });\n    const processing = queue.dequeue()!;\n\n    queue.cancelTask(processing.id);\n\n    // If failTask is called, it shouldn't retry\n    queue.failTask(processing.id, new Error('err'));\n    expect(processing.status).toBe('cancelled');\n  });\n\n  it('should throw when cancelling non-cancellable tasks', () => {\n    const queue = new TaskQueue();\n    const task = queue.enqueue('test');\n    const processing = queue.dequeue()!;\n\n    queue.completeTask(processing.id);\n\n    expect(() => queue.cancelTask(processing.id)).toThrow();\n\n    // Cancelling non-existent task\n    expect(() => queue.cancelTask('non-existent')).toThrow();\n  });\n\n  it('should query a tasks progress', () => {\n    const queue = new TaskQueue();\n    const task = queue.enqueue('test');\n    const processing = queue.dequeue()!;\n\n    expect(processing.progress).toBeNull();\n\n    queue.updateProgress(processing.id, 75);\n    expect(processing.progress!.percentage).toBe(75);\n  });\n\n  it('should handle multiple listeners on the same task', () => {\n    const queue = new TaskQueue();\n    const task = queue.enqueue('test');\n    const processing = queue.dequeue()!;\n\n    const cb1 = vi.fn();\n    const cb2 = vi.fn();\n\n    queue.onProgress(processing.id, cb1);\n    queue.onProgress(processing.id, cb2);\n\n    queue.updateProgress(processing.id, 50);\n\n    expect(cb1).toHaveBeenCalledTimes(1);\n    expect(cb2).toHaveBeenCalledTimes(1);\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":2900,"cache_creation_input_tokens":0,"cache_read_input_tokens":59520,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e9888b27-4f42-4b85-b6f2-263d9c89bc46","uuid":"2831a2e7-b451-49c8-8753-67c3021214f0"}
