  activeCount: number;\n  middleware: MiddlewareFunction[];\n  handler: ProcessHandler | null;\n}\n\ninterface TaskData {\n  id: string;\n  queueName: string;\n  payload: unknown;\n  status: TaskStatus;\n  priority: number;\n  createdAt: Date;\n  updatedAt: Date;\n  availableAt: Date | null;\n  attempts: number;\n  maxRetries: number;\n  backoffBase: number;\n  dependsOn: string[];\n  error: Error | null;\n  progress: { percentage: number; message?: string } | null;\n}\n\n// ── Main class ─────────────────────────────────────────────────────────────────\n\nexport class TaskQueue {\n  private readonly queues = new Map<string, QueueState>();\n  private readonly tasks = new Map<string, TaskData>();\n  private readonly schedules: ScheduleData[] = [];\n  private readonly progressListeners = new Map<string, Set<ProgressCallback>>();\n  private shuttingDown = false;\n  private shutdownResolve: (() => void) | null = null;\n  private shutdownTimeoutId: ReturnType<typeof setTimeout> | null = null;\n  private shutdownCallbacks: Array<() => void> = [];\n  private shutdownSummary: ShutdownSummary | null = null;\n  private shutdownCompletedCount = 0;\n  private shutdownForceCancelledCount = 0;\n  private shutdownStartTime = 0;\n\n  // ── Phase 1-2: Basic + Named Queues ─────────────────────────────────────────\n\n  enqueue(\n    queueNameOrPayload: unknown,\n    payloadOrOptions?: unknown,\n    maybeOptions?: TaskOptions,\n  ): Task {\n    if (this.shuttingDown) {\n      throw new Error('Cannot add tasks to a shutting-down queue');\n    }\n\n    let queueName: string;\n    let payload: unknown;\n    let options: TaskOptions | undefined;\n\n    if (\n      typeof queueNameOrPayload === 'string' &&\n      payloadOrOptions !== undefined\n    ) {\n      // enqueue(queueName, payload, options?)\n      queueName = queueNameOrPayload;\n      payload = payloadOrOptions;\n      options = maybeOptions;\n    } else {\n      // enqueue(payload, options?)\n      queueName = 'default';\n      payload = queueNameOrPayload;\n      options = payloadOrOptions as TaskOptions | undefined;\n    }\n\n    const priority = options?.priority ?? 5;\n    if (priority < 1 || priority > 10 || !Number.isInteger(priority)) {\n      throw new Error(\n        `Priority must be an integer between 1 and 10, got ${priority}`,\n      );\n    }\n\n    // Validate dependencies (Phase 7)\n    const dependsOn: string[] = options?.dependsOn ?? [];\n    if (dependsOn.length > 0) {\n      for (const depId of dependsOn) {\n        const dep = this.tasks.get(depId);\n        if (!dep) {\n          throw new Error(`Dependency task \"${depId}\" does not exist`);\n        }\n      }\n      // Check for circular dependencies\n      this.checkCycles(dependsOn);\n    }\n\n    const now = new Date();\n    let availableAt: Date | null = null;\n\n    // Phase 4: delay / runAt\n    if (options?.delay !== undefined && options.delay > 0) {\n      availableAt = new Date(now.getTime() + options.delay);\n    }\n    if (options?.runAt !== undefined) {\n      const runAtTime =\n        options.runAt instanceof Date\n          ? options.runAt.getTime()\n          : options.runAt;\n      const runAtDate = new Date(runAtTime);\n      if (availableAt === null || runAtDate > availableAt) {\n        availableAt = runAtDate;\n      }\n    }\n\n    const task: TaskData = {\n      id: crypto.randomUUID(),\n      queueName,\n      payload,\n      status: dependsOn.length > 0 ? 'blocked' : 'pending',\n      priority,\n      createdAt: now,\n      updatedAt: now,\n      availableAt,\n      attempts: 0,\n      maxRetries: options?.maxRetries ?? 3,\n      backoffBase: options?.backoffBase ?? 1000,\n      dependsOn,\n      error: null,\n      progress: null,\n    };\n\n    this.tasks.set(task.id, task);\n\n    const queue = this.getOrCreateQueue(queueName);\n    queue.taskIds.add(task.id);\n\n    return this.toPublicTask(task);\n  }\n\n  dequeue(queueName?: string): Task | null {\n    if (this.shuttingDown) return null;\n\n    const queue = this.getQueue(queueName);\n    if (!queue) return null;\n\n    // Phase 8: Check concurrency limit\n    if (queue.concurrency !== null && queue.activeCount >= queue.concurrency) {\n      return null;\n    }\n\n    const now = Date.now();\n    let bestTask: TaskData | null = null;\n\n    for (const taskId of queue.taskIds) {\n      const task = this.tasks.get(taskId);\n      if (!task || task.status !== 'pending') continue;\n\n      // Phase 4: Check availability (delay)\n      if (task.availableAt && task.availableAt.getTime() > now) continue;\n\n      // Phase 7: Check dependencies\n      if (task.dependsOn.length > 0) {\n        const allMet = task.dependsOn.every((depId) => {\n          const dep = this.tasks.get(depId);\n          return dep && dep.status === 'completed';\n        });\n        if (!allMet) {\n          // Ensure it's marked as blocked\n          if (task.status !== 'blocked') {\n            task.status = 'blocked';\n            task.updatedAt = new Date();\n          }\n          continue;\n        }\n        // Dependencies met — ensure it's pending (unblock)\n        if (task.status === 'blocked') {\n          task.status = 'pending';\n          task.updatedAt = new Date();\n        }\n      }\n\n      // Phase 3: Pick best by priority then FIFO\n      if (\n        bestTask === null ||\n        task.priority < bestTask.priority ||\n        (task.priority === bestTask.priority &&\n          task.createdAt.getTime() < bestTask.createdAt.getTime())\n      ) {\n        bestTask = task;\n      }\n    }\n\n    if (bestTask) {\n      bestTask.status = 'processing';\n      bestTask.updatedAt = new Date();\n      queue.activeCount++;\n      return this.toPublicTask(bestTask);\n    }\n\n    return null;\n  }\n\n  getQueueSize(queueName?: string): number {\n    const queue = this.getQueue(queueName);\n    if (!queue) return 0;\n\n    let count = 0;\n    for (const taskId of queue.taskIds) {\n      const task = this.tasks.get(tas