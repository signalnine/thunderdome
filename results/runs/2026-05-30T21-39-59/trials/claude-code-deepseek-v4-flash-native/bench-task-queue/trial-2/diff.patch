ter queue when retries exhausted', async () => {\n    const queue = new TaskQueue();\n    queue.enqueue('will-fail', { maxRetries: 1, backoffBase: 10 });\n\n    const t1 = queue.dequeue()!;\n    queue.failTask(t1.id, new Error('fail 1'));\n\n    await new Promise((r) => setTimeout(r, 20));\n    const t2 = queue.dequeue()!;\n    queue.failTask(t2.id, new Error('fail 2'));\n\n    const deadLetter = queue.getDeadLetterTasks();\n    expect(deadLetter.length).toBe(1);\n    expect(deadLetter[0].payload).toBe('will-fail');\n    expect(deadLetter[0].error).not.toBeNull();\n    expect(deadLetter[0].error!.message).toBe('fail 2');\n  });\n\n  it('should retain error info and attempt count in DLQ', async () => {\n    const queue = new TaskQueue();\n    queue.enqueue('test', { maxRetries: 2, backoffBase: 10 });\n\n    const t1 = queue.dequeue()!;\n    queue.failTask(t1.id, new Error('attempt 1'));\n\n    await new Promise((r) => setTimeout(r, 20));\n    const t2 = queue.dequeue()!;\n    queue.failTask(t2.id, new Error('attempt 2'));\n\n    await new Promise((r) => setTimeout(r, 25));\n    const t3 = queue.dequeue()!;\n    queue.failTask(t3.id, new Error('attempt 3'));\n\n    const dlq = queue.getDeadLetterTasks();\n    expect(dlq.length).toBe(1);\n    expect(dlq[0].attempts).toBe(3);\n    expect(dlq[0].error!.message).toBe('attempt 3');\n  });\n\n  it('should support retrying a dead-lettered task', async () => {\n    const queue = new TaskQueue();\n    queue.enqueue('retry-me', { maxRetries: 1, backoffBase: 10 });\n\n    const t1 = queue.dequeue()!;\n    queue.failTask(t1.id, new Error('fail'));\n\n    await new Promise((r) => setTimeout(r, 20));\n    const t2 = queue.dequeue()!;\n    queue.failTask(t2.id, new Error('fail again'));\n\n    // Should be in DLQ\n    expect(queue.getDeadLetterTasks().length).toBe(1);\n\n    // Retry it\n    queue.retryDeadLetterTask(t2.id);\n\n    // DLQ should be empty\n    expect(queue.getDeadLetterTasks().length).toBe(0);\n\n    // Task should be pending with fresh attempts\n    const recovered = queue.dequeue()!;\n    expect(recovered.payload).toBe('retry-me');\n    expect(recovered.attempts).toBe(0);\n  });\n\n  it('should support clearing the dead letter queue', async () => {\n    const queue = new TaskQueue();\n    queue.enqueue('fail-1', { maxRetries: 1, backoffBase: 10 });\n    queue.enqueue('fail-2', { maxRetries: 1, backoffBase: 10 });\n\n    const t1 = queue.dequeue()!;\n    queue.failTask(t1.id, new Error('err'));\n\n    await new Promise((r) => setTimeout(r, 20));\n    const t1r = queue.dequeue()!;\n    queue.failTask(t1r.id, new Error('err'));\n\n    const t2 = queue.dequeue()!;\n    queue.failTask(t2.id, new Error('err'));\n\n    await new Promise((r) => setTimeout(r, 20));\n    const t2r = queue.dequeue()!;\n    queue.failTask(t2r.id, new Error('err'));\n\n    expect(queue.getDeadLetterTasks().length).toBe(2);\n\n    queue.clearDeadLetterQueue();\n    expect(queue.getDeadLetterTasks().length).toBe(0);\n  });\n\n  it('should have independent DLQs per named queue', async () => {\n    const queue = new TaskQueue();\n\n    queue.enqueue('q1', 'task1', { maxRetries: 1, backoffBase: 10 });\n    queue.enqueue('q2', 'task2', { maxRetries: 1, backoffBase: 10 });\n\n    // Fail q1 task\n    const t1 = queue.dequeue('q1')!;\n    queue.failTask(t1.id, new Error('err'));\n\n    await new Promise((r) => setTimeout(r, 20));\n    const t1r = queue.dequeue('q1')!;\n    queue.failTask(t1r.id, new Error('err'));\n\n    // Fail q2 task\n    const t2 = queue.dequeue('q2')!;\n    queue.failTask(t2.id, new Error('err'));\n\n    await new Promise((r) => setTimeout(r, 20));\n    const t2r = queue.dequeue('q2')!;\n    queue.failTask(t2r.id, new Error('err'));\n\n    expect(queue.getDeadLetterTasks('q1').length).toBe(1);\n    expect(queue.getDeadLetterTasks('q2').length).toBe(1);\n\n    // Clear only q1\n    queue.clearDeadLetterQueue('q1');\n    expect(queue.getDeadLetterTasks('q1').length).toBe(0);\n    expect(queue.getDeadLetterTasks('q2').length).toBe(1);\n  });\n\n  it('should return empty DLQ when no tasks have failed', () => {\n    const queue = new TaskQueue();\n    queue.enqueue('happy');\n    queue.dequeue()!;\n    expect(queue.getDeadLetterTasks()).toEqual([]);\n  });\n\n  it('should handle retrying from DLQ by task ID', async () => {\n    const queue = new TaskQueue();\n    queue.enqueue('test', { maxRetries: 1, backoffBase: 10 });\n\n    const t1 = queue.dequeue()!;\n    queue.failTask(t1.id, new Error('err'));\n\n    await new Promise((r) => setTimeout(r, 20));\n    const t2 = queue.dequeue()!;\n    queue.failTask(t2.id, new Error('err'));\n\n    const taskId = t2.id;\n    queue.retryDeadLetterTask(taskId);\n\n    const recovered = queue.dequeue()!;\n    expect(recovered.id).toBe(taskId);\n  });\n});\n","userModified":false}}
