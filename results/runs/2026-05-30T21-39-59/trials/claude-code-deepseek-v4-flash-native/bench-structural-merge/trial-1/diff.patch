+/**
+ * Version information for a document at a specific point in time.
+ */
+export interface Version {
+  /** Unique version identifier */
+  id: string;
+  /** Unix timestamp (ms) when this version was created */
+  timestamp: number;
+  /** The full document content at this version */
+  content: object;
+}
+
+/**
+ * Result of a three-way merge operation.
+ */
+export interface MergeResult {
+  /** Document contents after merge (with conflicts resolved in favor of "ours") */
+  merged: Record<string, object>;
+  /** List of conflicts found during merge (empty if no conflicts) */
+  conflicts: Conflict[];
+  /** Whether the merge was auto-applied (true when no conflicts) */
+  applied: boolean;
+}
+
+/**
+ * Describes a single field-level conflict during a merge.
+ */
+export interface Conflict {
+  /** The document ID where the conflict occurred */
+  documentId: string;
+  /** Dot-separated JSON path to the conflicting field, e.g. "a.b.c" */
+  path: string;
+  /** The value in the common ancestor */
+  base: unknown;
+  /** The value on the current (target) branch */
+  ours: unknown;
+  /** The value on the source branch being merged in */
+  theirs: unknown;
+}
