still have feature-auth's values (the merge wasn't applied)\n    expect(store.get('user')).toEqual({ name: 'Alice', role: 'superadmin', prefs: { theme: 'light', lang: 'en' } });\n    expect(store.get('analytics')).toBeUndefined();","originalFile":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { DocumentStore } from '../src/index.js';\n\n// ─── Helpers ─────────────────────────────────────────────────────────────────\n\nfunction makeStore(): DocumentStore {\n  return new DocumentStore();\n}\n\n// ─── CRUD Tests ──────────────────────────────────────────────────────────────\n\ndescribe('CRUD operations', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  describe('create', () => {\n    it('creates a document on the default branch', () => {\n      store.create('doc1', { a: 1 });\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('deep clones content so external mutations are isolated', () => {\n      const content: Record<string, any> = { nested: { x: 1 } };\n      store.create('doc1', content);\n      content.nested.x = 999;\n      expect(store.get('doc1')).toEqual({ nested: { x: 1 } });\n    });\n\n    it('deep clones on retrieval so mutations after get() are isolated', () => {\n      store.create('doc1', { a: 1 });\n      const retrieved = store.get('doc1') as Record<string, any>;\n      retrieved.a = 999;\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('throws when creating a duplicate ID on the same branch', () => {\n      store.create('doc1', { a: 1 });\n      expect(() => store.create('doc1', { b: 2 })).toThrow(\n        /already exists/i,\n      );\n    });\n\n    it('allows creating a new doc after a previous one was deleted', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      store.create('doc1', { b: 2 });\n      expect(store.get('doc1')).toEqual({ b: 2 });\n    });\n\n    it('accepts documents with arrays as field values', () => {\n      store.create('doc1', { items: [1, 2, 3], name: 'test' });\n      expect(store.get('doc1')).toEqual({ items: [1, 2, 3], name: 'test' });\n    });\n\n    it('accepts deeply nested documents', () => {\n      store.create('doc1', { a: { b: { c: { d: 42 } } } });\n      expect(store.get('doc1')).toEqual({ a: { b: { c: { d: 42 } } } });\n    });\n  });\n\n  describe('get', () => {\n    it('throws for a non-existent document', () => {\n      expect(() => store.get('ghost')).toThrow(/not found/i);\n    });\n\n    it('throws for a deleted document', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow(/not found/i);\n    });\n  });\n\n  describe('update', () => {\n    it('replaces the document content', () => {\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { b: 2 });\n      expect(store.get('doc1')).toEqual({ b: 2 });\n    });\n\n    it('deep clones on update', () => {\n      store.create('doc1', { a: 1 });\n      const content: Record<string, any> = { nested: { y: 2 } };\n      store.update('doc1', content);\n      content.nested.y = 999;\n      expect(store.get('doc1')).toEqual({ nested: { y: 2 } });\n    });\n\n    it('throws when updating a non-existent document', () => {\n      expect(() => store.update('ghost', { x: 1 })).toThrow(/not found/i);\n    });\n\n    it('throws when updating a deleted document', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.update('doc1', { b: 2 })).toThrow(/not found/i);\n    });\n  });\n\n  describe('delete', () => {\n    it('removes a document from the branch', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow(/not found/i);\n    });\n\n    it('throws when deleting a non-existent document', () => {\n      expect(() => store.delete('ghost')).toThrow(/not found/i);\n    });\n\n    it('throws when deleting an already-deleted document', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.delete('doc1')).toThrow(/not found/i);\n    });\n  });\n});\n\n// ─── Version History Tests ───────────────────────────────────────────────────\n\ndescribe('Version history', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('creates a version on create', () => {\n    store.create('doc1', { a: 1 });\n    const history = store.getHistory('doc1');\n    expect(history).toHaveLength(1);\n    expect(history[0].content).toEqual({ a: 1 });\n    expect(history[0].id).toBeDefined();\n    expect(typeof history[0].timestamp).toBe('number');\n  });\n\n  it('creates a version on each update', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', { b: 2 });\n    store.update('doc1', { c: 3 });\n    const history = store.getHistory('doc1');\n    expect(history).toHaveLength(3);\n    expect(history[0].content).toEqual({ a: 1 });\n    expect(history[1].content).toEqual({ b: 2 });\n    expect(history[2].content).toEqual({ c: 3 });\n  });\n\n  it('returns history in chronological order (oldest first)', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', { b: 2 });\n    store.update('doc1', { c: 3 });\n    const history = store.getHistory('doc1');\n    for (let i = 1; i < history.length; i++) {\n      expect(history[i].timestamp).toBeGreaterThanOrEqual(history[i - 1].timestamp);\n    }\n  });\n\n  it('deep clones version content in history', () => {\n    store.create('doc1', { a: [1, 2, 3] });\n    const history = store.getHistory('doc1');\n    const content = history[0].content as Record<string, any>;\n    content.a.push(999);\n    expect(store.get('doc1')).toEqual({ a: [1, 2, 3] });\n  });\n\n  it('getVersion returns content at a specific version', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', { b: 2 });\n    const history = store.getHistory('doc1');\n    const v1Content = store.getVersion('doc1', history[0].id);\n    expect(v1Content).toEqual({ a: 1 });\n    const v2Content = store.getVersion('doc1', history[1].id);\n    expect(v2Content).toEqual({ b: 2 });\n  });\n\n  it('getVersion deep clones the content', () => {\n    store.create('doc1', { a: [1] });\n    const history = store.getHistory('doc1');\n    const content = store.getVersion('doc1', history[0].id) as Record<string, any>;\n    content.a.push(999);\n    expect(store.getVersion('doc1', history[0].id)).toEqual({ a: [1] });\n  });\n\n  it('getVersion throws for an unknown version ID', () => {\n    store.create('doc1', { a: 1 });\n    expect(() => store.getVersion('doc1', 'fake-vid')).toThrow(/not found/i);\n  });\n\n  it('getVersion throws for a wrong doc ID', () => {\n    store.create('doc1', { a: 1 });\n    store.create('doc2', { b: 2 });\n    const h = store.getHistory('doc2');\n    expect(() => store.getVersion('doc1', h[0].id)).toThrow(/not found/i);\n  });\n\n  it('does not create a version on delete', () => {\n    store.create('doc1', { a: 1 });\n    store.delete('doc1');\n    expect(store.getHistory('doc1')).toHaveLength(1);\n  });\n\n  it('generates unique version IDs', () => {\n    store.create('doc1', { a: 1 });\n    store.create('doc2', { b: 2 });\n    const ids = new Set(\n      [...store.getHistory('doc1'), ...store.getHistory('doc2')].map((v) => v.id),\n    );\n    expect(ids.size).toBe(2);\n  });\n});\n\n// ─── Branching Tests ─────────────────────────────────────────────────────────\n\ndescribe('Branching', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('starts on the main branch', () => {\n    expect(store.getBranch()).toBe('main');\n  });\n\n  it('can create and switch to a new branch', () => {\n    store.createBranch('feature');\n    expect(store.listBranches()).toContain('feature');\n  });\n\n  it('isolates changes on different branches', () => {\n    store.create('doc1', { a: 1 });\n\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.create('doc2', { b: 2 });\n\n    // main should not see feature's doc\n    store.switchBranch('main');\n    expect(() => store.get('doc2')).toThrow(/not found/i);\n\n    // feature sees its own doc\n    store.switchBranch('feature');\n    expect(store.get('doc1')).toEqual({ a: 1 });\n    expect(store.get('doc2')).toEqual({ b: 2 });\n  });\n\n  it('siblings inherit the parent state at creation', () => {\n    store.create('doc1', { a: 1 });\n\n    store.createBranch('feature1');\n    store.switchBranch('feature1');\n    store.update('doc1', { a: 2 });\n\n    // Create feature2 from main (not from feature1)\n    store.switchBranch('main');\n    store.createBranch('feature2');\n    store.switchBranch('feature2');\n\n    // feature2 should have the original main state, not feature1's changes\n    expect(store.get('doc1')).toEqual({ a: 1 });\n  });\n\n  it('createBranch with fromBranch creates from that branch', () => {\n    store.create('doc1', { x: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { x: 2 });\n    store.create('doc2', { y: 1 });\n\n    store.createBranch('sub', 'feature');\n    store.switchBranch('sub');\n    expect(store.get('doc1')).toEqual({ x: 2 });\n    expect(store.get('doc2')).toEqual({ y: 1 });\n  });\n\n  it('throws when creating a branch with an existing name', () => {\n    store.createBranch('feature');\n    expect(() => store.createBranch('feature')).toThrow(/already exists/i);\n  });\n\n  it('throws when switching to a non-existent branch', () => {\n    expect(() => store.switchBranch('nope')).toThrow(/does not exist/i);\n  });\n\n  it('listBranches returns all branches', () => {\n    store.createBranch('a');\n    store.createBranch('b');\n    const branches = store.listBranches();\n    expect(branches).toContain('main');\n    expect(branches).toContain('a');\n    expect(branches).toContain('b');\n  });\n\n  it('getBranch returns the current branch after switching', () => {\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    expect(store.getBranch()).toBe('feature');\n    store.switchBranch('main');\n    expect(store.getBranch()).toBe('main');\n  });\n});\n\n// ─── Merge Tests ─────────────────────────────────────────────────────────────\n\ndescribe('Merge — basic conflicts', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('merges cleanly when only the source branch changed a field', () => {\n    store.create('doc1', { a: 1, b: 2 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 1, b: 99 });\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toHaveLength(0);\n    expect(result.merged.doc1).toEqual({ a: 1, b: 99 });\n    expect(store.get('doc1')).toEqual({ a: 1, b: 99 });\n  });\n\n  it('merges cleanly when only the current branch changed a field', () => {\n    store.create('doc1', { a: 1, b: 2 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 1, b: 99 });\n\n    // Merge current (feature) into main by switching perspective\n    store.switchBranch('main');\n    store.update('doc1', { a: 42, b: 2 });\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(true);\n    // main changed 'a', feature changed 'b' — no conflict\n    expect(result.conflicts).toHaveLength(0);\n    expect(result.merged.doc1).toEqual({ a: 42, b: 99 });\n    expect(store.get('doc1')).toEqual({ a: 42, b: 99 });\n  });\n\n  it('detects conflict when both branches change the same field to different values', () => {\n    store.create('doc1', { a: 1, b: 2 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 999, b: 2 });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 42, b: 2 });\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toHaveLength(1);\n    expect(result.conflicts[0].documentId).toBe('doc1');\n    expect(result.conflicts[0].path).toBe('a');\n    expect(result.conflicts[0].base).toBe(1);\n    expect(result.conflicts[0].ours).toBe(42);\n    expect(result.conflicts[0].theirs).toBe(999);\n  });\n\n  it('no conflict when both branches change the same field to the same value', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 42 });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 42 });\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toHaveLength(0);\n    expect(result.merged.doc1).toEqual({ a: 42 });\n  });\n\n  it('returns merged result with conflicts resolved in favour of ours', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 999 });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 42 });\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(false);\n    // Merged result should favour \"ours\" (42)\n    expect(result.merged.doc1).toEqual({ a: 42 });\n  });\n\n  it('does not auto-apply the branch changes when there are conflicts', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 999 });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 42 });\n    store.merge('feature');\n\n    // Main should still have its own version (42), unchanged\n    expect(store.get('doc1')).toEqual({ a: 42 });\n  });\n});\n\ndescribe('Merge — new documents', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('adds a document created on the source branch after fork', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.create('doc2', { b: 2 });\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(true);\n    expect(result.merged.doc2).toEqual({ b: 2 });\n    expect(store.get('doc2')).toEqual({ b: 2 });\n  });\n\n  it('does not touch a document only created on the current branch', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('main');\n    store.create('doc2', { b: 2 });\n\n    store.switchBranch('feature');\n    const result = store.merge('main');\n\n    expect(result.applied).toBe(true);\n    expect(store.get('doc2')).toEqual({ b: 2 });\n  });\n});\n\ndescribe('Merge — deletions', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('applies deletion when source branch deletes an unchanged doc', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.delete('doc1');\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(true);\n    expect(() => store.get('doc1')).toThrow(/not found/i);\n  });\n\n  it('conflicts when source branch deletes a doc we modified', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.delete('doc1');\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 42 });\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toHaveLength(1);\n    expect(result.conflicts[0].path).toBe('');\n    expect(result.conflicts[0].theirs).toBeUndefined();\n  });\n\n  it('conflicts when we deleted what the source branch modified', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 999 });\n\n    store.switchBranch('main');\n    store.delete('doc1');\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toHaveLength(1);\n    expect(result.conflicts[0].path).toBe('');\n    expect(result.conflicts[0].ours).toBeUndefined();\n    expect(result.conflicts[0].theirs).toEqual({ a: 999 });\n  });\n\n  it('no conflict when both branches delete the same doc', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.delete('doc1');\n    store.switchBranch('main');\n    store.delete('doc1');\n\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toHaveLength(0);\n  });\n});\n\ndescribe('Merge — nested object structural merge', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('merges changes to different nested sub-fields without conflict', () => {\n    store.create('doc1', { a: { x: 1, y: 2 }, b: { z: 3 } });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: { x: 1, y: 99 }, b: { z: 3 } });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: { x: 42, y: 2 }, b: { z: 3 } });\n    const result = store.merge('feature');\n\n    // a.x → main changed (42), a.y → feature changed (99) — different fields, no conflict\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toHaveLength(0);\n    expect((result.merged.doc1 as any).a.x).toBe(42);\n    expect((result.merged.doc1 as any).a.y).toBe(99);\n    expect(store.get('doc1')).toEqual({ a: { x: 42, y: 99 }, b: { z: 3 } });\n  });\n\n  it('detects conflict when both branches change the same nested field to different values', () => {\n    store.create('doc1', { config: { theme: 'light', fontSize: 12, lang: 'en' } });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { config: { theme: 'dark', fontSize: 12, lang: 'en' } });\n\n    store.switchBranch('main');\n    store.update('doc1', { config: { theme: 'solarized', fontSize: 12, lang: 'en' } });\n    const result = store.merge('feature');\n\n    // config.theme → both changed to different values (dark vs solarized)\n    // config.fontSize → unchanged\n    // config.lang → unchanged\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toHaveLength(1);\n    expect(result.conflicts[0].path).toBe('config.theme');\n    expect(result.conflicts[0].base).toBe('light');\n    expect(result.conflicts[0].ours).toBe('solarized');\n    expect(result.conflicts[0].theirs).toBe('dark');\n    // merged result favors ours\n    expect((result.merged.doc1 as any).config.theme).toBe('solarized');\n    expect((result.merged.doc1 as any).config.fontSize).toBe(12);\n    expect((result.merged.doc1 as any).config.lang).toBe('en');\n  });\n\n  it('deep merges nested objects where each side changed different sub-fields', () => {\n    store.create('doc1', { config: { theme: 'light', fontSize: 12, lang: 'en' } });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { config: { theme: 'dark', fontSize: 12, lang: 'en' } });\n\n    store.switchBranch('main');\n    store.update('doc1', { config: { theme: 'light', fontSize: 14, lang: 'en' } });\n    const result = store.merge('feature');\n\n    // config.theme → feature changed to 'dark' (clean)\n    // config.fontSize → main changed to 14 (clean)\n    // Different sub-fields → no conflict\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toHaveLength(0);\n    expect((result.merged.doc1 as any).config.theme).toBe('dark');\n    expect((result.merged.doc1 as any).config.fontSize).toBe(14);\n    expect((result.merged.doc1 as any).config.lang).toBe('en');\n  });\n\n  it('adds nested keys independently without conflict', () => {\n    store.create('doc1', { a: { existing: 1 } });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: { existing: 1, addedByFeature: 'yes' } });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: { existing: 1, addedByMain: 'also' } });\n    const result = store.merge('feature');\n\n    // Different keys added, no conflict\n    expect(result.applied).toBe(true);\n    expect((result.merged.doc1 as any).a.addedByFeature).toBe('yes');\n    expect((result.merged.doc1 as any).a.addedByMain).toBe('also');\n    expect((result.merged.doc1 as any).a.existing).toBe(1);\n    expect(store.get('doc1')).toEqual({\n      a: { existing: 1, addedByFeature: 'yes', addedByMain: 'also' },\n    });\n  });\n\n  it('detects conflict when both branches add different values for the same new key', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 1, b: 'featureVal' });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 1, b: 'mainVal' });\n    const result = store.merge('feature');\n\n    // Both added 'b' with different values\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toHaveLength(1);\n    expect(result.conflicts[0].path).toBe('b');\n  });\n\n  it('no conflict when both branches add the same key with same value', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 1, b: 'same' });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 1, b: 'same' });\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toHaveLength(0);\n  });\n});\n\ndescribe('Merge — arrays as leaf values', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('treats arrays as atomic values during merge', () => {\n    store.create('doc1', { items: [1, 2, 3] });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { items: [4, 5, 6] });\n\n    store.switchBranch('main');\n    store.update('doc1', { items: [7, 8, 9] });\n    const result = store.merge('feature');\n\n    // Both changed items to different arrays → conflict\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toHaveLength(1);\n    expect(result.conflicts[0].path).toBe('items');\n  });\n\n  it('no conflict when only one side changes an array', () => {\n    store.create('doc1', { items: [1, 2, 3], name: 'test' });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { items: [4, 5, 6], name: 'test' });\n\n    store.switchBranch('main');\n    // main doesn't change anything\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(true);\n    expect(result.merged.doc1).toEqual({ items: [4, 5, 6], name: 'test' });\n  });\n});\n\ndescribe('Merge — multiple documents', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('merges changes to different documents without cross-document conflicts', () => {\n    store.create('doc1', { a: 1 });\n    store.create('doc2', { b: 2 });\n    store.createBranch('feature');\n\n    store.switchBranch('feature');\n    store.update('doc1', { a: 99 });\n    store.update('doc2', { b: 88 });\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toHaveLength(0);\n    expect(store.get('doc1')).toEqual({ a: 99 });\n    expect(store.get('doc2')).toEqual({ b: 88 });\n  });\n\n  it('only conflicts on documents where fields actually conflict', () => {\n    store.create('doc1', { a: 1 });\n    store.create('doc2', { b: 2 });\n    store.createBranch('feature');\n\n    store.switchBranch('feature');\n    store.update('doc1', { a: 99 });\n    store.update('doc2', { b: 2 }); // no change\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 42 });\n    store.update('doc2', { b: 999 });\n\n    const result = store.merge('feature');\n\n    expect(result.applied).toBe(false);\n    // Only doc1 has a conflict on 'a'; doc2 has no base conflict\n    expect(result.conflicts).toHaveLength(1);\n    expect(result.conflicts[0].documentId).toBe('doc1');\n  });\n});\n\ndescribe('Merge — fast-forward / no-op', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('is a no-op when merging a branch into itself', () => {\n    store.create('doc1', { a: 1 });\n    const result = store.merge('main');\n    expect(result.applied).toBe(true);\n    expect(result.merged).toEqual({});\n  });\n\n  it('is a no-op when no changes happened on either side', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('main');\n\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toHaveLength(0);\n    expect(result.merged).toEqual({});\n  });\n\n  it('is a no-op when the same change is on both branches', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 2 });\n    store.switchBranch('main');\n    store.update('doc1', { a: 2 });\n\n    const result = store.merge('feature');\n\n    // No conflict, but merged result should show the same content\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toHaveLength(0);\n  });\n});\n\ndescribe('Merge — reverse (merge parent into child)', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('merges main into feature correctly', () => {\n    store.create('doc1', { a: 1, b: 2, c: 3 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 999, b: 2, c: 3 });   // feature changes 'a'\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 1, b: 42, c: 3 });     // main changes 'b'\n\n    store.switchBranch('feature');\n    const result = store.merge('main');\n\n    // Feature changed 'a', main changed 'b' → different fields, no conflict\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toHaveLength(0);\n    expect(result.merged.doc1).toEqual({ a: 999, b: 42, c: 3 });\n    expect(store.get('doc1')).toEqual({ a: 999, b: 42, c: 3 });\n  });\n\n  it('detects conflicts when merging parent into child', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 999 });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 42 });\n\n    store.switchBranch('feature');\n    const result = store.merge('main');\n\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toHaveLength(1);\n    expect(result.conflicts[0].path).toBe('a');\n  });\n});\n\ndescribe('Merge — sibling branches', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('merges one sibling into another cleanly', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature-a');\n    store.createBranch('feature-b');\n\n    store.switchBranch('feature-a');\n    store.update('doc1', { a: 1, addedByA: 'hello' });\n\n    store.switchBranch('feature-b');\n    store.update('doc1', { a: 1, addedByB: 'world' });\n\n    // Merge feature-a into feature-b\n    const result = store.merge('feature-a');\n\n    expect(result.applied).toBe(true);\n    expect((result.merged.doc1 as any).addedByA).toBe('hello');\n    expect((result.merged.doc1 as any).addedByB).toBe('world');\n    expect(store.get('doc1')).toEqual({\n      a: 1,\n      addedByA: 'hello',\n      addedByB: 'world',\n    });\n  });\n});\n\n// ─── Mutability / Isolation Tests ────────────────────────────────────────────\n\ndescribe('Immutability / isolation', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('branches do not share document references after creation', () => {\n    store.create('doc1', { a: { nested: true } });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n\n    // Modify on feature\n    const content = store.get('doc1') as Record<string, any>;\n    content.a = { different: true };\n    // The get() returns a clone, so this mutation doesn't affect storage\n\n    store.switchBranch('main');\n    expect(store.get('doc1')).toEqual({ a: { nested: true } });\n  });\n\n  it('merge result is properly deep cloned', () => {\n    store.create('doc1', { items: [1] });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { items: [1, 2, 3] });\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    const mergedItems = (result.merged.doc1 as any).items as number[];\n    mergedItems.push(999);\n    expect(store.get('doc1')).toEqual({ items: [1, 2, 3] });\n  });\n});\n\n// ─── Error Handling Tests ────────────────────────────────────────────────────\n\ndescribe('Error handling', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = makeStore();\n  });\n\n  it('throws on merge with non-existent source branch', () => {\n    expect(() => store.merge('phantom')).toThrow(/does not exist/i);\n  });\n\n  it('throws on createBranch from non-existent branch', () => {\n    expect(() => store.createBranch('new', 'phantom')).toThrow(/does not exist/i);\n  });\n});\n\n// ─── Comprehensive scenario ──────────────────────────────────────────────────\n\ndescribe('Complex merge scenario', () => {\n  it('handles a multi-document, multi-branch workflow with nested merges', () => {\n    const store = makeStore();\n\n    // Initial docs on main\n    store.create('user', { name: 'Alice', role: 'admin', prefs: { theme: 'light', lang: 'en' } });\n    store.create('config', { version: 1, flags: { beta: false } });\n\n    // Create branches\n    store.createBranch('feature-auth');\n    store.createBranch('feature-ui');\n\n    // Work on feature-auth\n    store.switchBranch('feature-auth');\n    store.update('user', { name: 'Alice', role: 'superadmin', prefs: { theme: 'light', lang: 'en' } });\n    store.update('config', { version: 1, flags: { beta: true } });\n\n    // Work on feature-ui\n    store.switchBranch('feature-ui');\n    store.update('user', { name: 'Alice', role: 'editor', prefs: { theme: 'dark', lang: 'fr' } });\n    store.create('analytics', { enabled: false });\n\n    // Merge feature-auth into main first\n    store.switchBranch('main');\n    const r1 = store.merge('feature-auth');\n    expect(r1.applied).toBe(true);\n    expect(store.get('user')).toEqual({ name: 'Alice', role: 'superadmin', prefs: { theme: 'light', lang: 'en' } });\n    expect(store.get('config')).toEqual({ version: 1, flags: { beta: true } });\n\n    // Merge feature-ui into main\n    const r2 = store.merge('feature-ui');\n    // user.prefs.theme: main (light from feature-auth base) vs feature-ui (dark) → conflict\n    // user.prefs.lang: main (en) vs feature-ui (fr) → conflict\n    // user.role: main (superadmin) vs feature-ui (admin) → conflict\n    // analytics: created on feature-ui, not on main → clean\n    expect(r2.applied).toBe(false);\n    expect(r2.conflicts.length).toBeGreaterThanOrEqual(1);\n\n    // analytics doc should be in merged result\n    expect(r2.merged.analytics).toEqual({ enabled: false });\n\n    // main branch should still have feature-auth's values (the merge wasn't applied)\n    expect(store.get('user')).toEqual({ name: 'Alice', role: 'superadmin', prefs: { theme: 'lig