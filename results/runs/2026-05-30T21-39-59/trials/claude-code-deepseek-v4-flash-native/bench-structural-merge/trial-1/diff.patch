  const newVersionId = this.addVersion(docId, content);\n      currentBranch.head.set(docId, newVersionId);\n    }\n\n    return { merged, conflicts: [], applied: true };\n  }\n\n  // ═════════════════════════════════════════════════════════════════════════\n  //  Private helpers\n  // ═════════════════════════════════════════════════════════════════════════\n\n  private getBranchData(name: string): BranchData {\n    const branch = this.branches.get(name);\n    if (!branch) {\n      throw new Error(`Branch \"${name}\" does not exist`);\n    }\n    return branch;\n  }\n\n  private getCurrentBranchData(): BranchData {\n    return this.getBranchData(this.currentBranchName);\n  }\n\n  /** Generate a unique version identifier (monotonically increasing). */\n  private nextVersionId(): string {\n    return `v${++this.versionCounter}`;\n  }\n\n  /** Return (and lazily create) the ordered version list for a document. */\n  private getDocVersionList(id: string): string[] {\n    let list = this.docVersions.get(id);\n    if (!list) {\n      list = [];\n      this.docVersions.set(id, list);\n    }\n    return list;\n  }\n\n  /**\n   * Store a new version of a document.\n   * Returns the newly created version ID.\n   */\n  private addVersion(docId: string, content: object): string {\n    const versionId = this.nextVersionId();\n    this.versions.set(versionId, {\n      id: versionId,\n      timestamp: Date.now(),\n      content: deepClone(content),\n    });\n    this.getDocVersionList(docId).push(versionId);\n    return versionId;\n  }\n\n  /** Deep-cloned content for a given version ID. */\n  private getVersionContent(versionId: string): object {\n    const version = this.versions.get(versionId);\n    if (!version) {\n      throw new Error(`Version \"${versionId}\" not found`);\n    }\n    return deepClone(version.content);\n  }\n\n  // ─── Merge base resolution ─────────────────────────────────────────────\n\n  /**\n   * Determine the correct merge base state when merging `sour