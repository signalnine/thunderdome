onId && theirVersionId !== baseVersionId) {\n          return { content: this.getVersionContent(theirVersionId), needsApply: true };\n        }\n        // Both changed -> field-level merge\n        const ours = this.getVersionContent(ourVersionId);\n        const theirs = this.getVersionContent(theirVersionId);\n        const mergedContent = threeWayMerge(base, ours, theirs, docId, '', conflicts);\n        return { content: mergedContent, needsApply: true };\n      }\n    }\n    \n    // Case: Doc not in any of base, ours, theirs (shouldn't happen)\n    return null;\n  }\n  \n  private getVersionContent(versionId: string): object {\n    const version = this.versions.get(versionId);\n    if (!version) throw new Error(`Version \"${versionId}\" not found`);\n    return deepClone(version.content);\n  }\n}\n```\n\nHmm, this is getting long. Let me think about the three-way merge function.\n\n```typescript\n// src/merge.ts\nimport { Conflict } from './types';\nimport { deepClone, deepEqual, isPlainObject } from './utils';\n\nexport function threeWayMerge(\n  base: any,\n  ours: any,\n  theirs: any,\n  docId: string,\n  path: string,\n  conflicts: Conflict[],\n): any {\n  // If all values are deeply equal, just return ours\n  if (deepEqual(ours, theirs)) {\n    return deepClone(ours);\n  }\n  \n  // If ours == base, use theirs\n  if (deepEqual(ours, base)) {\n    return deepClone(theirs);\n  }\n  \n  // If theirs == base, use ours\n  if (deepEqual(theirs, base)) {\n    return deepClone(ours);\n  }\n  \n  // Both changed to different values\n  // If all are plain objects, recurse\n  if (isPlainObject(base) && isPlainObject(ours) && isPlainObject(theirs)) {\n    return deepMergeObjects(base, ours, theirs, docId, path, conflicts);\n  }\n  \n  // Otherwise, it's a conflict at the leaf level\n  conflicts.push({\n    documentId: docId,\n    path: path || '(root)',\n    base: deepClone(base),\n    ours: deepClone(ours),\n    theirs: deepClone(theirs),\n  });\n  \n  // Favor ours