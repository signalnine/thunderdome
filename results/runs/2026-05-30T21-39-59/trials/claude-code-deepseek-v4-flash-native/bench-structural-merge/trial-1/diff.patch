+++ b/src/merge.ts
@@ -0,0 +1,224 @@
+import type { Conflict } from './types.js';
+import { deepClone, deepEqual, isPlainObject } from './utils.js';
+
+/**
+ * Perform a three-way structural merge on two document versions (ours and theirs)
+ * against a common ancestor (base).
+ *
+ * - If only one side changed a value, that change wins.
+ * - If both sides changed to the same value, no conflict.
+ * - If both sides changed to different leaf values, a conflict is recorded.
+ * - If both sides changed to different nested objects, the merge recurses into them.
+ * - When conflicts occur, the returned value favors "ours".
+ *
+ * @param base  Common ancestor value
+ * @param ours  Current branch's value
+ * @param theirs  Source (incoming) branch's value
+ * @param docId  Document ID being merged (for conflict reporting)
+ * @param path  Current dot-separated JSON path (for conflict reporting)
+ * @param conflicts  Accumulated conflicts array (mutated in place)
+ * @returns The merged value (with conflicts favoring "ours")
+ */
+export function threeWayMerge(
+  base: unknown,
+  ours: unknown,
+  theirs: unknown,
+  docId: string,
+  path: string,
+  conflicts: Conflict[],
+): unknown {
+  // All three agree — return ours
+  if (deepEqual(ours, theirs)) {
+    return deepClone(ours);
+  }
+
+  // Only one side changed
+  if (deepEqual(ours, base)) {
+    return deepClone(theirs);
+  }
+  if (deepEqual(theirs, base)) {
+    return deepClone(ours);
+  }
+
+  // Both sides changed to different values.
+  // If all three are plain objects, recurse field-by-field.
+  if (isPlainObject(base) && isPlainObject(ours) && isPlainObject(theirs)) {
+    return deepMergeObjects(base, ours, theirs, docId, path, conflicts);
+  }
+
+  // Leaf conflict — record and favor ours
+  conflicts.push({
+    documentId: docId,
+    path,
+    base: deepClone(base),
+    ours: deepClone(ours),
+    theirs: deepClone(theirs),
+  });
+
+  return deepClone(ours);
+}
+
+/**
+ * Recursively merge two plain objects (ours and theirs) against base.
+ * Handles key additions, deletions, and modifications at every nesting level.
+ */
+function deepMergeObjects(
+  base: Record<string, unknown>,
+  ours: Record<string, unknown>,
+  theirs: Record<string, unknown>,
+  docId: string,
+  path: string,
+  conflicts: Conflict[],
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+  const allKeys = new Set([
+    ...Object.keys(base),
+    ...Object.keys(ours),
+    ...Object.keys(theirs),
+  ]);
+
+  for (const key of allKeys) {
+    const childPath = path ? `${path}.${key}` : key;
+    const inBase = key in base;
+    const inOurs = key in ours;
+    const inTheirs = key in theirs;
+
+    const bVal: unknown = inBase ? base[key] : undefined;
+    const oVal: unknown = inOurs ? ours[key] : undefined;
+    const tVal: unknown = inTheirs ? theirs[key] : undefined;
+
+    // ---- Key was NOT in base ----
+    if (!inBase) {
+      if (inOurs && !inTheirs) {
+        // Only we added it
+        result[key] = deepClone(oVal);
+      } else if (!inOurs && inTheirs) {
+        // Only they added it
+        result[key] = deepClone(tVal);
+      } else {
+        // Both added the same key independently
+        mergeBothAdded(key, oVal, tVal, docId, childPath, conflicts, result);
+      }
+      continue;
+    }
+
+    // ---- Key WAS in base ----
+
+    // Both deleted it
+    if (!inOurs && !inTheirs) {
+      continue;
+    }
+
+    // We deleted it, they kept or modified it
+    if (!inOurs && inTheirs) {
+      mergeWeDeleted(key, bVal, tVal, docId, childPath, conflicts);
+      continue;
+    }
+
+    // They deleted it, we kept or modified it
+    if (inOurs && !inTheirs) {
+      mergeTheyDeleted(key, bVal, oVal, docId, childPath, conflicts, result);
+      continue;
+    }
+
+    // Both kept the key — recurse with three-way
+    result[key] = threeWayMerge(bVal, oVal, tVal, docId, childPath, conflicts);
+  }
+
+  return result;
+}
+
+/**
+ * Handle the case where both branches independently added the same new key
+ * (key existed in both ours and theirs, but not in base).
+ */
+function mergeBothAdded(
+  key: string,
+  oVal: unknown,
+  tVal: unknown,
+  docId: string,
+  childPath: string,
+  conflicts: Conflict[],
+  result: Record<string, unknown>,
+): void {
+  if (deepEqual(oVal, tVal)) {
+    // Same value added on both sides — no conflict
+    result[key] = deepClone(oVal);
+    return;
+  }
+
+  if (isPlainObject(oVal) && isPlainObject(tVal)) {
+    // Both added objects — recurse with empty base
+    result[key] = deepMergeObjects({}, oVal, tVal, docId, childPath, conflicts);
+    return;
+  }
+
+  // Both added different leaf values — conflict
+  conflicts.push({
+    documentId: docId,
+    path: childPath,
+    base: undefined,
+    ours: deepClone(oVal),
+    theirs: deepClone(tVal),
+  });
+
+  result[key] = deepClone(oVal);
+}
+
+/**
+ * Handle the case where we deleted a key that existed in base,
+ * but they kept or modified it.
+ */
+function mergeWeDeleted(
+  key: string,
+  bVal: unknown,
+  tVal: unknown,
+  docId: string,
+  childPath: string,
+  conflicts: Conflict[],
+): void {
+  if (deepEqual(bVal, tVal)) {
+    // They didn't change it — our deletion wins, no conflict
+    return;
+  }
+
+  // They modified it — conflict between our deletion and their modification
+  conflicts.push({
+    documentId: docId,
+    path: childPath,
+    base: deepClone(bVal),
+    ours: undefined,
+    theirs: deepClone(tVal),
+  });
+  // Favor ours (deletion) — skip the key
+}
+
+/**
+ * Handle the case where they deleted a key that existed in base,
+ * but we kept or modified it.
+ */
+function mergeTheyDeleted(
+  key: string,
+  bVal: unknown,
+  oVal: unknown,
+  docId: string,
+  childPath: string,
+  conflicts: Conflict[],
+  result: Record<string, unknown>,
+): void {
+  if (deepEqual(bVal, oVal)) {
+    // We didn't change it — their deletion wins, no conflict
+    return;
+  }
+
+  // We modified it — conflict between our modification and their deletion
+  conflicts.push({
+    documentId: docId,
+    path: childPath,
+    base: deepClone(bVal),
+    ours: deepClone(oVal),
+    theirs: undefined,
+  });
+  // Favor ours (keep our modified value)
+  result[key] = deepClone(oVal);
+}
