+/**
+ * Deep clone a value using JSON round-trip.
+ * Handles plain objects, arrays, primitives, null.
+ * Throws on non-serializable values (functions, undefined, symbols).
+ */
+export function deepClone<T>(value: T): T {
+  if (value === null || value === undefined) return value;
+  return JSON.parse(JSON.stringify(value));
+}
+
+/**
+ * Deep equality comparison between two values.
+ * Uses JSON serialization for reliable structural comparison.
+ */
+export function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (a === null || b === null) return false;
+  if (typeof a !== typeof b) return false;
+  return JSON.stringify(a) === JSON.stringify(b);
+}
+
+/**
+ * Check if a value is a plain object (not null, not array, typeof 'object').
+ * In JSON terms: a non-null object that isn't an array.
+ */
+export function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
