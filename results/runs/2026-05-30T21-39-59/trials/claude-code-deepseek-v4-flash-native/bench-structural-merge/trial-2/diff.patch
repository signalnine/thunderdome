e = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow();\n    });\n\n    it('should throw on delete if document does not exist', () => {\n      const store = new DocumentStore();\n      expect(() => store.delete('nonexistent')).toThrow();\n    });\n\n    it('should deep clone content on create', () => {\n      const store = new DocumentStore();\n      const original = { a: { nested: true } };\n      store.create('doc1', original);\n      original.a.nested = false;\n      expect(store.get('doc1')).toEqual({ a: { nested: true } });\n    });\n\n    it('should deep clone content on update', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      const updated = { b: { nested: true } };\n      store.update('doc1', updated);\n      updated.b.nested = false;\n      expect(store.get('doc1')).toEqual({ b: { nested: true } });\n    });\n\n    it('should allow recreation after deletion', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      store.create('doc1', { b: 2 });\n      expect(store.get('doc1')).toEqual({ b: 2 });\n    });\n  });\n\n  // ---------------------------------------------------------------\n  //  Version History\n  // ---------------------------------------------------------------\n\n  describe('Version history', () => {\n    it('should create a version on create', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(1);\n      expect(history[0].content).toEqual({ a: 1 });\n      expect(history[0].id).toBeDefined();\n      expect(history[0].timestamp).toBeGreaterThan(0);\n    });\n\n    it('should create a version on update', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { a: 2 });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(2);\n      expect(history[0].content).toEqual({ a: 1 });\n      expect(history[1].content).toEqual({ a: 2 });\n    });\n\n    it('should return history in chronological order', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { v: 0 });\n      store.update('doc1', { v: 1 });\n      store.update('doc1', { v: 2 });\n      const history = store.getHistory('doc1');\n      expect(history.map((v) => v.content)).toEqual([{ v: 0 }, { v: 1 }, { v: 2 }]);\n    });\n\n    it('should return versions with unique ids', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { a: 2 });\n      const history = store.getHistory('doc1');\n      expect(history[0].id).not.toBe(history[1].id);\n    });\n\n    it('should deep clone version content', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: { nested: true } });\n      const history = store.getHistory('doc1');\n      history[0].content.a.nested = false;\n      expect(store.getHistory('doc1')[0].content).toEqual({ a: { nested: true } });\n    });\n\n    it('getVersion should return content at specific version', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { a: 2 });\n      const history = store.getHistory('doc1');\n      const v1 = store.getVersion('doc1', history[0].id);\n      const v2 = store.getVersion('doc1', history[1].id);\n      expect(v1).toEqual({ a: 1 });\n      expect(v2).toEqual({ a: 2 });\n    });\n\n    it('getVersion should throw for nonexistent version', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      expect(() => store.getVersion('doc1', 'nonexistent')).toThrow();\n    });\n\n    it('getHistory should work for deleted documents', () => {\n      const store = new DocumentStore();\n      