/  Merging — Conflicts\n  // ---------------------------------------------------------------\n\n  describe('Merge — conflicts', () => {\n    it('should detect conflict when both changed same field to different values', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 999 });\n      store.switchBranch('main');\n      store.update('doc1', { a: 888 });\n      const result = store.merge('feature');\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].documentId).toBe('doc1');\n      expect(result.conflicts[0].path).toBe('a');\n      expect(result.applied).toBe(false);\n      // Current branch unchanged\n      expect(store.get('doc1')).toEqual({ a: 888 });\n    });\n\n    it('should not apply merge when there are conflicts', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 999 });\n      store.switchBranch('main');\n      store.update('doc1', { a: 888 });\n      store.merge('feature');\n      // Version history should not include merge version\n      expect(store.getHistory('doc1')).toHaveLength(2); // create + update\n    });\n\n    it('should return merged field even with conflicts (ours wins)', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 999 });\n      store.switchBranch('main');\n      store.update('doc1', { a: 888 });\n      const result = store.merge('feature');\n      expect(result.merged.doc1).toBeDefined();\n      // merged should show ours (888) for the conflicting path\n    });\n\n    it('should report conflict path correctly for nested objects', () => {\n      const store = new Document