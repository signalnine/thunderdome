gous rules.\n *\n * The merged result always uses \"ours\" for conflicting paths (for display).\n *\n * @returns merged value and accumulated conflicts.\n */\nexport function threeWayMergeFields(\n  base: unknown,\n  ours: unknown,\n  theirs: unknown,\n  docId: string,\n  path: string,\n): { merged: unknown; conflicts: Conflict[] } {\n  // ---- Leaf-value case: any of the three is not a plain object ----\n  if (!isPlainObject(base) || !isPlainObject(ours) || !isPlainObject(theirs)) {\n    return mergeLeaf(base, ours, theirs, docId, path);\n  }\n\n  // ---- All three are plain objects — recurse per key ----\n  const allKeys = new Set([\n    ...Object.keys(base),\n    ...Object.keys(ours),\n    ...Object.keys(theirs),\n  ]);\n\n  const merged: Record<string, unknown> = {};\n  const allConflicts: Conflict[] = [];\n\n  for (const key of allKeys) {\n    const childPath = path ? `${path}.${key}` : key;\n    const inBase = key in base;\n    const inOurs = key in ours;\n    const inTheirs = key in theirs;\n\n    if (inBase && inOurs && inTheirs) {\n      // Key exists on all three sides — recurse\n      const result = threeWayMergeFields(base[key], ours[key], theirs[key], docId, childPath);\n      if (result.merged !== undefined) {\n        merged[key] = result.merged;\n      }\n      allConflicts.push(...result.conflicts);\n    } else if (inBase && inOurs && !inTheirs) {\n      // Theirs removed this key\n      if (deepEqual(base[key], ours[key])) {\n        // Ours unchanged → accept theirs' removal (don't include key)\n      } else {\n        // Ours changed it while theirs removed it → conflict\n        allConflicts.push({\n          documentId: docId,\n          path: childPath,\n          base: base[key],\n          ours: ours[key],\n          theirs: undefined,\n        });\n        merged[key] = ours[key]; // ours wins for display\n      }\n    } else if (inBase && !inOurs && inTheirs) {\n      // Ours removed this key\n      if (deepEqual(base[key], theirs[key])) {