e.merge('feature');\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].documentId).toBe('doc1');\n      expect(result.applied).toBe(false);\n    });\n  });\n\n  // ---------------------------------------------------------------\n  //  Merging — Document-level scenarios\n  // ---------------------------------------------------------------\n\n  describe('Merge — document-level scenarios', () => {\n    it('should take document created only on source branch', () => {\n      const store = new DocumentStore();\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc1', { a: 1 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.conflicts).toHaveLength(0);\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('should take document created only on current branch', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc2', { b: 2 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.conflicts).toHaveLength(0);\n      expect(result.applied).toBe(true);\n      expect(store.get('doc2')).toEqual({ b: 2 });\n    });\n\n    it('should handle document created with same content on both branches', () => {\n      const store = new DocumentStore();\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc1', { a: 1 });\n      store.switchBranch('main');\n      store.create('doc1', { a: 1 });\n      const result = store.merge('feature');\n      expect(result.conflicts).toHaveLength(0);\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('should delete doc when only source deleted it and current unchanged', () => {\n  