+import { Conflict } from './types.js';
+
+/**
+ * Deep equality check for JSON-serializable values.
+ * Compares primitives, arrays (element-by-element), and plain objects (key-by-key).
+ */
+export function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (a == null || b == null) return a === b;
+  if (typeof a !== typeof b) return false;
+  if (typeof a !== 'object') return a === b;
+
+  if (Array.isArray(a) !== Array.isArray(b)) return false;
+  if (Array.isArray(a) && Array.isArray(b)) {
+    return a.length === b.length && a.every((v, i) => deepEqual(v, b[i]));
+  }
+
+  const aObj = a as Record<string, unknown>;
+  const bObj = b as Record<string, unknown>;
+  const keysA = Object.keys(aObj);
+  const keysB = Object.keys(bObj);
+  if (keysA.length !== keysB.length) return false;
+  return keysA.every((k) => k in bObj && deepEqual(aObj[k], bObj[k]));
+}
+
+/**
+ * Deep clone a JSON-serializable value.
+ */
+export function deepClone<T>(obj: T): T {
+  return JSON.parse(JSON.stringify(obj));
+}
+
+/**
+ * Check if a value is a plain object (not null, not array, typeof 'object').
+ */
+function isPlainObject(v: unknown): v is Record<string, unknown> {
+  return typeof v === 'object' && v !== null && !Array.isArray(v);
+}
+
+/**
+ * Compute a three-way field-level merge of base, ours, theirs.
+ *
+ * Recursively walks the object tree. For each path:
+ *  - If only one side changed → take that change (no conflict).
+ *  - If both sides changed to the same value → no conflict.
+ *  - If both sides changed to different values → conflict.
+ *  - If a key was added on one or both sides → analogous rules.
+ *  - If a key was removed on one or both sides → analogous rules.
+ *
+ * The merged result always uses "ours" for conflicting paths (for display).
+ *
+ * @returns merged value and accumulated conflicts.
+ */
+export function threeWayMergeFields(
+  base: unknown,
+  ours: unknown,
+  theirs: unknown,
+  docId: string,
+  path: string,
+): { merged: unknown; conflicts: Conflict[] } {
+  // ---- Leaf-value case: any of the three is not a plain object ----
+  if (!isPlainObject(base) || !isPlainObject(ours) || !isPlainObject(theirs)) {
+    return mergeLeaf(base, ours, theirs, docId, path);
+  }
+
+  // ---- All three are plain objects — recurse per key ----
+  const allKeys = new Set([
+    ...Object.keys(base),
+    ...Object.keys(ours),
+    ...Object.keys(theirs),
+  ]);
+
+  const merged: Record<string, unknown> = {};
+  const allConflicts: Conflict[] = [];
+
+  for (const key of allKeys) {
+    const childPath = path ? `${path}.${key}` : key;
+    const inBase = key in base;
+    const inOurs = key in ours;
+    const inTheirs = key in theirs;
+
+    if (inBase && inOurs && inTheirs) {
+      // Key exists on all three sides — recurse
+      const result = threeWayMergeFields(base[key], ours[key], theirs[key], docId, childPath);
+      if (result.merged !== undefined) {
+        merged[key] = result.merged;
+      }
+      allConflicts.push(...result.conflicts);
+    } else if (inBase && inOurs && !inTheirs) {
+      // Theirs removed this key
+      if (deepEqual(base[key], ours[key])) {
+        // Ours unchanged → accept theirs' removal (don't include key)
+      } else {
+        // Ours changed it while theirs removed it → conflict
+        allConflicts.push({
+          documentId: docId,
+          path: childPath,
+          base: base[key],
+          ours: ours[key],
+          theirs: undefined,
+        });
+        merged[key] = ours[key]; // ours wins for display
+      }
+    } else if (inBase && !inOurs && inTheirs) {
+      // Ours removed this key
+      if (deepEqual(base[key], theirs[key])) {
+        // Theirs unchanged → accept ours' removal (don't include key)
+      } else {
+        // Theirs changed it while ours removed it → conflict
+        allConflicts.push({
+          documentId: docId,
+          path: childPath,
+          base: base[key],
+          ours: undefined,
+          theirs: theirs[key],
+        });
+        // ours wins → keep removed (don't include)
+      }
+    } else if (!inBase && inOurs && inTheirs) {
+      // Both sides added the same key independently
+      if (deepEqual(ours[key], theirs[key])) {
+        merged[key] = ours[key];
+      } else {
+        allConflicts.push({
+          documentId: docId,
+          path: childPath,
+          base: undefined,
+          ours: ours[key],
+          theirs: theirs[key],
+        });
+        merged[key] = ours[key]; // ours wins for display
+      }
+    } else if (!inBase && inOurs) {
+      // Only ours added this key
+      merged[key] = ours[key];
+    } else if (!inBase && inTheirs) {
+      // Only theirs added this key
+      merged[key] = theirs[key];
+    }
+    // else (inBase && !inOurs && !inTheirs): both removed → skip
+  }
+
+  return { merged, conflicts: allConflicts };
+}
+
+/**
+ * Leaf-value three-way comparison.
+ */
+function mergeLeaf(
+  base: unknown,
+  ours: unknown,
+  theirs: unknown,
+  docId: string,
+  path: string,
+): { merged: unknown; conflicts: Conflict[] } {
+  // Both sides made the same change or neither changed
+  if (deepEqual(ours, theirs)) {
+    return { merged: ours, conflicts: [] };
+  }
+  // Only theirs changed
+  if (deepEqual(base, ours)) {
+    return { merged: theirs, conflicts: [] };
+  }
+  // Only ours changed
+  if (deepEqual(base, theirs)) {
+    return { merged: ours, conflicts: [] };
+  }
+  // Both changed to different values — conflict
+  return {
+    merged: ours, // ours wins for display
+    conflicts: [
+      {
+        documentId: docId,
+        path,
+        base,
+        ours,
+        theirs,
+      },
+    ],
+  };
+}
