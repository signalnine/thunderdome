+import { describe, it, expect } from 'vitest';
+import { DocumentStore } from '../src/index.js';
+
+describe('DocumentStore', () => {
+  // ---------------------------------------------------------------
+  //  CRUD
+  // ---------------------------------------------------------------
+
+  describe('CRUD', () => {
+    it('should create and get a document', () => {
+      const store = new DocumentStore();
+      store.create('doc1', { a: 1, b: 2 });
+      expect(store.get('doc1')).toEqual({ a: 1, b: 2 });
+    });
+
+    it('should return a deep clone on get', () => {
+      const store = new DocumentStore();
+      store.create('doc1', { a: { nested: true } });
+      const got = store.get('doc1');
+      got.a.nested = false;
+      expect(store.get('doc1')).toEqual({ a: { nested: true } });
+    });
+
+    it('should throw on create if document already exists', () => {
+      const store = new DocumentStore();
+      store.create('doc1', { a: 1 });
+      expect(() => store.create('doc1', { b: 2 })).toThrow();
+    });
+
+    it('should throw on get if document does not exist', () => {
+      const store = new DocumentStore();
+      expect(() => store.get('nonexistent')).toThrow();
+    });
+
+    it('should update a document', () => {
+      const store = new DocumentStore();
+      store.create('doc1', { a: 1 });
+      store.update('doc1', { a: 2, b: 3 });
+      expect(store.get('doc1')).toEqual({ a: 2, b: 3 });
+    });
+
+    it('should throw on update if document does not exist', () => {
+      const store = new DocumentStore();
+      expect(() => store.update('nonexistent', { a: 1 })).toThrow();
+    });
+
+    it('should delete a document', () => {
+      const store = new DocumentStore();
+      store.create('doc1', { a: 1 });
+      store.delete('doc1');
+      expect(() => store.get('doc1')).toThrow();
+    });
+
+    it('should throw on delete if document does not exist', () => {
+      const store = new DocumentStore();
+      expect(() => store.delete('nonexistent')).toThrow();
+    });
+
+    it('should deep clone content on create', () => {
+      const store = new DocumentStore();
+      const original = { a: { nested: true } };
+      store.create('doc1', original);
+      original.a.nested = false;
+      expect(store.get('doc1')).toEqual({ a: { nested: true } });
+    });
+
+    it('should deep clone content on update', () => {
+      const store = new DocumentStore();
+      store.create('doc1', { a: 1 });
+      const updated = { b: { nested: true } };
