+export type { Version, MergeResult, Conflict } from './types.js';
+
+// ---- Internal types ----
+
+interface DocumentEntry {
+  content: object;
+  versions: Version[];
+  deleted: boolean;
+}
+
+interface ForkInfo {
+  fromBranch: string;
+  /** Snapshot of non-deleted document content at fork time — docId → content */
+  snapshot: Map<string, object>;
+}
+
+type MergeDocResult =
+  | { kind: 'skip' }
+  | { kind: 'delete' }
+  | { kind: 'conflict'; conflict: Conflict; display?: object }
+  | { kind: 'merged'; content: object; conflicts: Conflict[] };
+
+// ---- DocumentStore implementation ----
+
+class DocumentStoreImpl implements IDocumentStore {
+  private readonly branches: Map<string, Map<string, DocumentEntry>> = new Map();
+  private currentBranchName: string = 'main';
+  private readonly branchForks: Map<string, ForkInfo> = new Map();
+  private versionCounter = 0;
+
+  constructor() {
+    this.branches.set('main', new Map());
+  }
+
+  // ---------------------------------------------------------------
+  //  Internal helpers
+  // ---------------------------------------------------------------
+
+  private getCurrentBranchDocs(): Map<string, DocumentEntry> {
+    const docs = this.branches.get(this.currentBranchName);
+    if (!docs) {
+      throw new Error(`Branch "${this.currentBranchName}" does not exist`);
+    }
+    return docs;
+  }
+
+  private getDocEntry(id: string): DocumentEntry {
+    const docs = this.getCurrentBranchDocs();
+    const entry = docs.get(id);
+    if (!entry) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    if (entry.deleted) {
+      throw new Error(`Document "${id}" has been deleted`);
+    }
+    return entry;
+  }
+
+  private createVersion(content: object): Version {
+    this.versionCounter++;
+    return {
+      id: `v${this.versionCounter}`,
+      timestamp: Date.now(),
+      content: deepClone(content),
+    };
+  }
+
+  // ---------------------------------------------------------------
+  //  CRUD
+  // ---------------------------------------------------------------
+
+  create(id: string, content: object): void {
+    const docs = this.getCurrentBranchDocs();
+    const existing = docs.get(id);
+    if (existing && !existing.deleted) {
+      throw new Error(`Document "${id}" already exists on branch "${this.currentBranchName}"`);
+    }
+
+    const version = this.createVersion(content);
+    const entry: DocumentEntry = {
+      content: deepClone(content),
+      versions: [version],
+      deleted: false,
+    };
+    docs.set(id, entry);
+  }
+
+  get(id: string): object {
+    return deepClone(this.getDocEntry(id).content);
+  }
+
+  update(id: string, content: object): void {
+    const entry = this.getDocEntry(id);
+    entry.content = deepClone(content);
+    const version = this.createVersion(content);
+    entry.versions.push(version);
+  }
+
+  delete(id: string): void {
+    const entry = this.getDocEntry(id);
+    entry.deleted = true;
+  }
+
+  // ---------------------------------------------------------------
+  //  Version history
+  // ---------------------------------------------------------------
+
+  getHistory(id: string): Version[] {
+    const docs = this.getCurrentBranchDocs();
+    const entry = docs.get(id);
+    if (!entry) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    return deepClone(entry.versions);
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const docs = this.getCurrentBranchDocs();
+    const entry = docs.get(id);
+    if (!entry) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    const version = entry.versions.find((v) => v.id === versionId);
+    if (!version) {
+      throw new Error(`Version "${versionId}" not found for document "${id}"`);
+    }
+    return deepClone(version.content);
+  }
+
+  // ---------------------------------------------------------------
+  //  Branching
+  // ---------------------------------------------------------------
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+
+    const sourceName = fromBranch ?? this.currentBranchName;
+    const sourceDocs = this.branches.get(sourceName);
+    if (!sourceDocs) {
+      throw new Error(`Source branch "${sourceName}" does not exist`);
+    }
+
+    // Deep-clone all documents from source into the new branch
+    const clonedDocs = new Map<string, DocumentEntry>();
+    for (const [id, entry] of sourceDocs) {
+      clonedDocs.set(id, deepClone(entry));
+    }
+    this.branches.set(name, clonedDocs);
+
+    // Snapshot non-deleted document content at fork point (the base for three-way merge)
+    const snapshot = new Map<string, object>();
+    for (const [id, entry] of sourceDocs) {
+      if (!entry.deleted) {
+        snapshot.set(id, deepClone(entry.content));
+      }
+    }
+    this.branchForks.set(name, { fromBranch: sourceName, snapshot });
+  }
+
+  switchBranch(name: string): void {
+    if (!this.branches.has(name)) {
+      throw new Error(`Branch "${name}" does not exist`);
+    }
+    this.currentBranchName = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranchName;
+  }
+
+  listBranches(): string[] {
+    return Array.from(this.branches.keys());
+  }
+
+  // ---------------------------------------------------------------
+  //  Merging
+  // ---------------------------------------------------------------
+
+  merge(sourceBranch: string): MergeResult {
+    // Resolve the common-ancestor (base) state
+    const baseState = this.resolveMergeBase(sourceBranch);
+    const currentDocs = this.getCurrentBranchDocs();
+    const sourceDocs = this.branches.get(sourceBranch);
+    if (!sourceDocs) {
+      throw new Error(`Source branch "${sourceBranch}" does not exist`);
+    }
+
+    // Collect all document IDs that exist in any of base / ours / theirs
+    const allIds = new Set<string>();
+    for (const id of baseState.keys()) allIds.add(id);
+    for (const [id, entry] of currentDocs) {
+      if (!entry.deleted) allIds.add(id);
+    }
+    for (const [id, entry] of sourceDocs) {
+      if (!entry.deleted) allIds.add(id);
+    }
+
+    const merged: Record<string, object> = {};
+    const conflicts: Conflict[] = [];
+    const docsToDelete = new Set<string>();
+
+    for (const id of allIds) {
+      const baseContent = baseState.get(id);
+      const currentEntry = currentDocs.get(id);
+      const sourceEntry = sourceDocs.get(id);
+
+      const currentContent = currentEntry && !currentEntry.deleted
+        ? currentEntry.content
+        : undefined;
+      const sourceContent = sourceEntry && !sourceEntry.deleted
+        ? sourceEntry.content
+        : undefined;
+
+      const result = this.mergeDocument(id, baseContent, currentContent, sourceContent);
+
+      switch (result.kind) {
+        case 'skip':
+          break;
+        case 'delete':
+          docsToDelete.add(id);
+          break;
+        case 'conflict':
+          conflicts.push(result.conflict);
+          if (result.display !== undefined) {
+            merged[id] = result.display as object;
+          }
+          break;
+        case 'merged':
+          if (result.content !== undefined) {
+            merged[id] = result.content as object;
+          }
+          conflicts.push(...result.conflicts);
+          break;
+      }
+    }
+
+    const applied = conflicts.length === 0;
+
+    if (applied) {
+      // Auto-apply the merge to the current branch
+      for (const [id, content] of Object.entries(merged)) {
+        const existing = currentDocs.get(id);
+        if (existing) {
+          existing.content = deepClone(content);
+          existing.deleted = false;
+          existing.versions.push(this.createVersion(content));
+        } else {
+          const version = this.createVersion(content);
+          currentDocs.set(id, {
+            content: deepClone(content),
+            versions: [version],
+            deleted: false,
+          });
+        }
+      }
+      for (const id of docsToDelete) {
+        const existing = currentDocs.get(id);
+        if (existing) {
+          existing.deleted = true;
+        }
+      }
+    }
+
+    return { merged, conflicts, applied };
+  }
+
+  /**
+   * Resolve the common-ancestor (base) state for a merge from `sourceBranch`
+   * into the current branch.
+   */
+  private resolveMergeBase(sourceBranch: string): Map<string, object> {
+    // Case 1: sourceBranch was forked from currentBranch
+    const sourceFork = this.branchForks.get(sourceBranch);
+    if (sourceFork && sourceFork.fromBranch === this.currentBranchName) {
+      return sourceFork.snapshot;
+    }
+
+    // Case 2: currentBranch was forked from sourceBranch
+    const currentFork = this.branchForks.get(this.currentBranchName);
+    if (currentFork && currentFork.fromBranch === sourceBranch) {
+      return currentFork.snapshot;
+    }
+
+    // Case 3: traverse the fork chain to find LCA
+    const ancestors = this.collectAncestors(this.currentBranchName);
+    if (ancestors.has(sourceBranch)) {
+      const sourceForkOfAncestor = this.branchForks.get(sourceBranch);
+      if (sourceForkOfAncestor) {
+        return sourceForkOfAncestor.snapshot;
+      }
+      return new Map();
+    }
+
+    const sourceAncestors = this.collectAncestors(sourceBranch);
+    if (sourceAncestors.has(this.currentBranchName)) {
+      const cf = this.branchForks.get(this.currentBranchName);
+      if (cf) {
+        return cf.snapshot;
+      }
+      return new Map();
+    }
+
+    return new Map();
+  }
+
+  /**
+   * Walk the fork chain from `branchName` up to the root,
+   * returning ancestor branch names (excluding `branchName` itself).
+   */
+  private collectAncestors(branchName: string): Set<string> {
+    const ancestors = new Set<string>();
+    let current = branchName;
+    // eslint-disable-next-line no-constant-condition
+    while (true) {
+      const fork = this.branchForks.get(current);
+      if (!fork) break;
+      ancestors.add(fork.fromBranch);
+      current = fork.fromBranch;
+    }
+    return ancestors;
+  }
+
+  /**
+   * Merge a single document across base / ours / theirs.
+   */
+  private mergeDocument(
+    id: string,
+    baseContent: object | undefined,
+    currentContent: object | undefined,
+    sourceContent: object | undefined,
+  ): MergeDocResult {
+    // ---- Document existed at fork time ----
+    if (baseContent !== undefined) {
+      // Both branches deleted it
+      if (currentContent === undefined && sourceContent === undefined) {
+        return { kind: 'skip' };
+      }
+
+      // Ours deleted
+      if (currentContent === undefined && sourceContent !== undefined) {
+        if (deepEqual(sourceContent, baseContent)) {
+          // Only ours deleted, theirs unchanged → keep ours (already deleted)
+          return { kind: 'skip' };
+        }
+        // Ours deleted, theirs modified → conflict
+        return {
+          kind: 'conflict',
+          conflict: {
+            documentId: id,
+            path: '',
+            base: baseContent,
+            ours: undefined,
+            theirs: sourceContent,
+          },
+          display: sourceContent,
+        };
+      }
+
+      // Theirs deleted
+      if (currentContent !== undefined && sourceContent === undefined) {
+        if (deepEqual(currentContent, baseContent)) {
+          // Only theirs deleted, ours unchanged → accept deletion
+          return { kind: 'delete' };
+        }
+        // Theirs deleted, ours modified → conflict
+        return {
+          kind: 'conflict',
+          conflict: {
+            documentId: id,
+            path: '',
+            base: baseContent,
+            ours: currentContent,
+            theirs: undefined,
+          },
+          display: currentContent,
+        };
+      }
+
+      // Both have content
+      if (deepEqual(currentContent, baseContent) && deepEqual(sourceContent, baseContent)) {
+        return { kind: 'skip' }; // neither changed
+      }
+
+      if (deepEqual(currentContent, baseContent)) {
+        // Only theirs changed
+        return { kind: 'merged', content: sourceContent!, conflicts: [] };
+      }
+
+      if (deepEqual(sourceContent, baseContent)) {
+        // Only ours changed
+        return { kind: 'merged', content: currentContent!, conflicts: [] };
+      }
+
+      // Both changed
+      if (deepEqual(currentContent, sourceContent)) {
+        // Both changed to the same value
+        return { kind: 'merged', content: currentContent!, conflicts: [] };
+      }
+
+      // Both changed differently — field-level merge
+      const result = threeWayMergeFields(baseContent, currentContent!, sourceContent!, id, '');
+      return {
+        kind: 'merged',
+        content: result.merged as object,
+        conflicts: result.conflicts,
+      };
+    }
+
+    // ---- Document did NOT exist at fork time (created on a branch) ----
+    if (currentContent !== undefined && sourceContent !== undefined) {
+      if (deepEqual(currentContent, sourceContent)) {
+        return { kind: 'merged', content: currentContent, conflicts: [] };
+      }
+      // Both created with different content → conflict
+      return {
+        kind: 'conflict',
+        conflict: {
+          documentId: id,
+          path: '',
+          base: undefined,
+          ours: currentContent,
+          theirs: sourceContent,
+        },
+        display: currentContent,
+      };
+    }
+
+    if (currentContent !== undefined) {
+      return { kind: 'merged', content: currentContent, conflicts: [] };
+    }
+
+    if (sourceContent !== undefined) {
+      return { kind: 'merged', content: sourceContent, conflicts: [] };
+    }
+
+    return { kind: 'skip' };
+  }
+}
+
+export { DocumentStoreImpl as DocumentStore };
