e');\n      expect(store.getBranch()).toBe('feature');\n    });\n\n    it('createBranch should copy documents from current branch', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('changes on one branch should not affect other branch', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 2 });\n      store.switchBranch('main');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('documents created on one branch should not appear on other', () => {\n      const store = new DocumentStore();\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc1', { a: 1 });\n      store.switchBranch('main');\n      expect(() => store.get('doc1')).toThrow();\n    });\n\n    it('createBranch with fromBranch should branch from specified branch', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 2 });\n      store.createBranch('subfeature', 'feature');\n      store.switchBranch('subfeature');\n      expect(store.get('doc1')).toEqual({ a: 2 });\n    });\n\n    it('createBranch should throw if branch already exists', () => {\n      const store = new DocumentStore();\n      expect(() => store.createBranch('main')).toThrow();\n    });\n\n    it('switchBranch should throw if branch does not exist', () => {\n      const store = new DocumentStore();\n      expect(() => store.switchBranch('nonexistent')).toThrow();\n    });\n\n    it('listBranches should list all branches', () => {\n      const store = new DocumentStore();\n      store.createBranch('a');\n      store.createBranch('b');\n      const branches = store.listBranches();\n      expect(branches).toContain('main');\n      expect(branches).toContain('a');\n      expect(branches).toContain('b');\n    });\n\n    it('deleted documents should stay deleted on other branches', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.delete('doc1');\n      store.switchBranch('main');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n  });\n\n  // ---------------------------------------------------------------\n  //  Merging — No changes\n  // ---------------------------------------------------------------\n\n  describe('Merge — no changes (fast-forward)', () => {\n    it('should be a no-op with no changes on either branch', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      const result = store.merge('feature');\n      expect(result.conflicts).toHaveLength(0);\n      expect(result.applied).toBe(true);\n      expect(result.merged).toEqual({});\n    });\n\n    it('should not create extra versions on no-op merge', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.merge('feature');\n      expect(store.getHistory('doc1')).toHaveLength(1);\n    });\n  });\n\n  // ---------------------------------------------------------------\n  //  Merging — Simple changes\n  // ---------------------------------------------------------------\n\n  describe('Merge — simple changes', () => {\n    it('should merge when only source branch changed a field', () => {\n      const store = new DocumentStore();\n      store.create('doc1', { a: 1, b: 2 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 1, b: 999 });\n      store.switchBranch('