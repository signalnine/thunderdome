 private async handleOrderCancelled(data: unknown): Promise<void> {\n    const event = data as OrderCancelledEvent;\n    // Release reserved stock — look up original order items from the event\n    // The order service attaches items to the cancellation event\n    const eventWithItems = data as OrderCancelledEvent & {\n      items?: Array<{ productId: string; quantity: number }>;\n      status?: string;\n    };\n\n    if (eventWithItems.status !== 'cancelled') return;\n\n    if (eventWithItems.items) {\n      for (const item of eventWithItems.items) {\n        this.repo.release(item.productId, item.quantity);\n      }\n    }\n\n    await this.eventBus.emit(ORDER_EVENTS.STOCK_RELEASED, {\n      orderId: event.orderId,\n      timestamp: Date.now(),\n    });\n  }\n\n  setStock(productId: string, quantity: number): void {\n    this.repo.setStock(productId, quantity);\n  }\n\n  getStock(productId: string) {\n    return this.repo.getStock(productId);\n  }\n}\n\n---FILE---\nexport interface StockRecord {\n  productId: string;\n  available: number;\n  reserved: number;\n}\n\nexport class InventoryRepository {\n  private store: Map<string, StockRecord> = new Map();\n\n  setStock(productId: string, available: number): void {\n    const existing = this.store.get(productId);\n    this.store.set(productId, {\n      productId,\n      available,\n      reserved: existing?.reserved ?? 0,\n    });\n  }\n\n  getStock(productId: string): StockRecord | undefined {\n    const record = this.store.get(productId);\n    return record ? { ...record } : undefined;\n  }\n\n  reserve(productId: string, quantity: number): boolean {\n    const record = this.store.get(productId);\n    if (!record || record.available < quantity) return false;\n    record.available -= quantity;\n    record.reserved += quantity;\n    return true;\n  }\n\n  release(productId: string, quantity: number): boolean {\n    const record = this.store.get(productId);\n    if (!record || record.reserved < quantity) return false;\n    record.reserved -= quantity;\n    record.available += quantity;\n    return true;\n  }\n\n  clear(): void {\n    this.store.clear();\n  }\n}\n\n---FILE---\nimport { EventBus } from '../events/bus.js';\nimport { ORDER_EVENTS } from '../events/types.js';\nimport { NotificationService } from '../notifications/service.js';\nimport { calculateOrderTotal } from './calculator.js';\nimport { OrderItem } from '../orders/repository.js';\n\nexport interface PaymentRecord {\n  orderId: string;\n  amount: number;\n  method: string;\n  status: 'charged' | 'refunded';\n  processedAt: number;\n}\n\nexport class BillingService {\n  private payments: Map<string, PaymentRecord> = new Map();\n\n  constructor(\n    private eventBus: EventBus,\n    private notificationService: NotificationService\n  ) {}\n\n  registerHandlers(): void {\n    this.eventBus.on(ORDER_EVENTS.STOCK_RESERVED, this.handleStockReserved.bind(this));\n    this.eventBus.on(ORDER_EVENTS.REFUNDED, this.handleRefund);\n  }\n\n  private async handleStockReserved(data: unknown): Promise<void> {\n    const event = data as { orderId: string; items: OrderItem[] };\n    // Payment would be charged here in a real system\n    await this.eventBus.emit(ORDER_EVENTS.PAYMENT_CHARGED, {\n      orderId: event.orderId,\n      amount: 0, // Actual amount set by order service\n      paymentMethod: 'card',\n      timestamp: Date.now(),\n    });\n  }\n\n  async chargePayment(\n    orderId: string,\n    items: OrderItem[],\n    discountPercent: number,\n    taxRate: number,\n    paymentMethod: string\n  ): Promise<PaymentRecord> {\n    const breakdown = calculateOrderTotal(items, discountPercent, taxRate);\n\n    const record: PaymentRecord = {\n      orderId,\n      amount: breakdown.total,\n      method: paymentMethod,\n      status: 'charged',\n      processedAt: Date.now(),\n    };\n\n    this.payments.set(orderId, record);\n    this.notificationService.sendConfirmation(orderId, breakdown.total);\n    return record;\n  }\n\n  private async handleRefund(data: unknown): Promise<void> {\n    const event = data as { orderId: string; amount: number };\n    const payment = this.payments.get(event.orderId);\n    if (payment) {\n      payment.status = 'refunded';\n      this.notificationService.sendRefundNotice(event.orderId, event.amount);\n    }\n  }\n\n  async issueRefund(orderId: string, amount: number): Promise<PaymentRecord | undefined> {\n    const payment = this.payments.get(orderId);\n    if (!payment) return undefined;\n\n    payment.status = 'refunded';\n\n    await this.eventBus.emit(ORDER_EVENTS.REFUNDED, {\n      orderId,\n      amount,\n      timestamp: Date.now(),\n    });\n\n    return { ...payment };\n  }\n\n  getPayment(orderId: string): PaymentRecord | undefined {\n    const p = this.payments.get(orderId);\n    return p ? { ...p } : undefined;\n  }\n\n  clear(): void {\n    this.payments.clear();\n  }\n}\n\n---FILE---\nimport { OrderItem } from '../orders/repository.js';\n\nexport interface PriceBreakdown {\n  subtotal: number;\n  discountAmount: number;\n  taxAmount: number;\n  total: number;\n}\n\nexport function calculateOrderTotal(\n  items: OrderItem[],\n  discountPercent: number,\n  taxRate: number\n): PriceBreakdown {\n  const subtotal = items.reduce(\n    (sum, item) => sum + item.unitPrice * item.quantity,\n    0\n  );\n\n  const discountAmount = Math.round(subtotal * (discountPercent / 100) * 100) / 100;\n  const afterDiscount = Math.round((subtotal - discountAmount) * 100) / 100;\n  const taxAmount = Math.round(afterDiscount * taxRate * 100) / 100;\n  const total = afterDiscount + taxAmount;\n\n  return {\n    subtotal: Math.round(subtotal * 100) / 100,\n    discountAmount: Math.round(discountAmount * 100) / 100,\n    taxAmount: Math.round(taxAmount * 100) / 100,\n    total,\n  };\n}\n\n---FILE---\nexport interface NotificationRecord {\n  type: string;\n  orderId: string;\n  message: string;\n  sentAt: number;\n}\n\nexport class NotificationService {\n  private templates: Map<string, string>;\n  private sent: NotificationRecord[] = [];\n\n  constructor() {\n    this.templates = new Map([\n      ['order.confirmed', 'Your order {orderId} has been confirmed. Total: ${total}'],\n      ['order.cancelled', 'Your order {orderId} has been cancelled. Reason: {reason}'],\n      ['order.refunded', 'Your refund of ${amount} for order {orderId} has been processed.'],\n    ]);\n  }\n\n  sendConfirmation(orderId: string, total: number): NotificationRecord {\n    const template = this.templates.get('order.confirmed')!;\n    const message = template\n      .replace('{orderId}', orderId)\n      .replace('{total}', total.toFixed(2));\n    const record: NotificationRecord = {\n      type: 'confirmation',\n      orderId,\n      message,\n      sentAt: Date.now(),\n    };\n    this.sent.push(record);\n    return record;\n  }\n\n  sendCancellation(orderId: string, reason: string): NotificationRecord {\n    const template = this.templates.get('order.cancelled')!;\n    const message = template\n      .replace('{orderId}', orderId)\n      .replace('{reason}', reason);\n    const record: NotificationRecord = {\n      type: 'cancellation',\n      orderId,\n      message,\n      sentAt: Date.now(),\n    };\n    this.sent.push(record);\n    return record;\n  }\n\n  sendRefundNotice(orderId: string, amount: number): NotificationRecord {\n    const template = this.templates.get('order.refunded')!;\n    const message = template\n      .replace('{orderId}', orderId)\n      .replace('{amount}', amount.toFixed(2));\n    const record: NotificationRecord = {\n      type: 'refund',\n      orderId,\n      message,\n      sentAt: Date.now(),\n    };\n    this.sent.push(record);\n    return record;\n  }\n\n  getSentNotifications(): NotificationRecord[] {\n    return [...this.sent];\n  }\n\n  clear(): void {\n    this.sent = [];\n  }\n}\n\n---FILE---\nexport interface OrderEvent {\n  orderId: string;\n  timestamp: number;\n}\n\nexport interface OrderCreatedEvent extends OrderEvent {\n  items: Array<{ productId: string; quantity: number; unitPrice: number }>;\n  customerId: string;\n}\n\nexport interface OrderCancelledEvent extends OrderEvent {\n  reason: string;\n}\n\nexport interface OrderRefundedEvent extends OrderEvent {\n  amount: number;\n}\n\nexport interface PaymentChargedEvent extends OrderEvent {\n  amount: number;\n  paymentMethod: string;\n}\n\nexport interface StockReservedEvent extends OrderEvent {\n  items: Array<{ productId: string; quantity: number }>;\n}\n\nexport const ORDER_EVENTS = {\n  CREATED: 'order.created',\n  CONFIRMED: 'order.confirmed',\n  CANCELLED: 'order.cancelled',\n  REFUNDED: 'order.refunded',\n  PAYMENT_CHARGED: 'order.payment.charged',\n  STOCK_RESERVED: 'order.stock.reserved',\n  STOCK_RELEASED: 'order.stock.released',\n  NOTIFICATION_SENT: 'order.notification.sent',\n} as const;\n\n---FILE---\nexport { EventBus } from './events/bus.js';\nexport { ORDER_EVENTS } from './events/types.js';\nexport type {\n  OrderEvent,\n  OrderCreatedEvent,\n  OrderCancelledEvent,\n  OrderRefundedEvent,\n  PaymentChargedEvent,\n  StockReservedEvent,\n} from './events/types.js';\n\nexport { OrderRepository } from './orders/repository.js';\nexport type { Order, OrderItem, OrderStatus } from './orders/repository.js';\nexport { OrderService } from './orders/service.js';\n\nexport { InventoryRepository } from './inventory/repository.js';\nexport type { StockRecord } from './inventory/repository.js';\nexport { InventoryService } from './inventory/service.js';\n\nexport { BillingService } from './billing/service.js';\nexport type { PaymentRecord } from './billing/service.js';\nexport { calculateOrderTotal } from './billing/calculator.js';\nexport type { PriceBreakdown } from './billing/calculator.js';\n\nexport { NotificationService } from './notifications/service.js';\nexport type { NotificationRecord } from './notifications/service.js';\n","exit_code":0,"status":"completed"}}
