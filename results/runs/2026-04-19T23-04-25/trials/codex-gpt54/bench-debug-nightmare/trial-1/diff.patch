   createdAt: Date.now(),\n      updatedAt: Date.now(),\n    });\n\n    const event: OrderCreatedEvent = {\n      orderId: id,\n      items: items.map((i) => ({\n        productId: i.productId,\n        quantity: i.quantity,\n        unitPrice: i.unitPrice,\n      })),\n      customerId,\n      timestamp: Date.now(),\n    };\n\n    await this.eventBus.emit(ORDER_EVENTS.CREATED, event);\n\n    // Charge payment and confirm\n    const payment = await this.billingService.chargePayment(\n      id,\n      items,\n      discount,\n      taxRate,\n      'card'\n    );\n\n    this.repo.update(id, {\n      status: 'confirmed',\n      total: payment.amount,\n    });\n\n    await this.eventBus.emit(ORDER_EVENTS.CONFIRMED, {\n      orderId: id,\n      timestamp: Date.now(),\n    });\n\n    return this.repo.findById(id)!;\n  }\n\n  async cancelOrder(id: string, reason: string): Promise<Order | undefined> {\n    const order = this.repo.findById(id);\n    if (!order) return undefined;\n    if (order.status !== 'confirmed') return undefined;\n\n    // Emit cancellation event, then update status\n    await this.eventBus.emit(ORDER_EVENTS.CANCELLED, {\n      orderId: id,\n      reason,\n      items: order.items.map((i) => ({\n        productId: i.productId,\n        quantity: i.quantity,\n      })),\n      timestamp: Date.now(),\n    });\n\n    this.repo.update(id, { status: 'cancelled' });\n\n    return this.repo.findById(id);\n  }\n\n  async refundOrder(id: string): Promise<Order | undefined> {\n    const order = this.repo.findById(id);\n    if (!order) return undefined;\n    if (order.status !== 'cancelled') return undefined;\n\n    const daysSinceCreation = Math.floor(\n      (Date.now() - order.createdAt) / (1000 * 60 * 60 * 24)\n    );\n\n    if (daysSinceCreation >= REFUND_WINDOW_DAYS) {\n      throw new Error(\n        `Refund window expired: ${daysSinceCreation} days since order (max ${REFUND_WINDOW_DAYS})`\n      );\n    }\n\n    await this.billingService.issueRefund(id, order.total);\n    this.repo.update(id, { status: 'refunded' });\n\n    return this.repo.findById(id);\n  }\n\n  getOrder(id: string): Order | undefined {\n    return this.repo.findById(id);\n  }\n\n  getOrdersByCustomer(customerId: string): Order[] {\n    return this.repo.findByCustomer(customerId);\n  }\n}\n\n---FILE---\nexport type OrderStatus = 'pending' | 'confirmed' | 'cancelled' | 'refunded';\n\nexport interface OrderItem {\n  productId: string;\n  quantity: number;\n  unitPrice: number;\n}\n\nexport interface Order {\n  id: string;\n  customerId: string;\n  items: OrderItem[];\n  status: OrderStatus;\n  total: number;\n  discount: number;\n  taxRate: number;\n  createdAt: number;\n  updatedAt: number;\n  notes?: string;\n}\n\nexport class OrderRepository {\n  private store: Map<string, Order> = new Map();\n\n  create(order: Order): Order {\n    this.store.set(order.id, { ...order });\n    return { ...order };\n  }\n\n  findById(id: string): Order | undefined {\n    const order = this.store.get(id);\n    return order ? { ...order } : undefined;\n  }\n\n  update(id: string, updates: Partial<Order>): Order | undefined {\n    const existing = this.store.get(id);\n    if (!existing) return undefined;\n    const updated = { ...updates, id, updatedAt: Date.now() } as Order;\n    this.store.set(id, updated);\n    return { ...updated };\n  }\n\n  findByCustomer(customerId: string): Order[] {\n    return Array.from(this.store.values())\n      .filter((o) => o.customerId === customerId)\n      .map((o) => ({ ...o }));\n  }\n\n  findByStatus(status: OrderStatus): Order[] {\n    return Array.from(this.store.values())\n      .filter((o) => o.status === status)\n      .map((o) => ({ ...o }));\n  }\n\n  clear(): void {\n    this.store.clear();\n  }\n}\n","exit_code":0,"status":"completed"}}
