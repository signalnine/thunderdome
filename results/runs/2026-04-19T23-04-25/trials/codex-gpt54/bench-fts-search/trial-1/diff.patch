+const RESULTS_PER_PAGE = 20;
+const TERM_PATTERN = /[\p{L}\p{N}_]+/gu;
+
+function normalizeSearchQuery(raw: string, usePrefix = false): string | null {
+  const trimmed = raw.trim();
+  if (trimmed === '') {
+    return null;
+  }
+
+  const tokens: string[] = [];
+  const pattern = /"([^"]+)"|(\S+)/g;
+
+  for (const match of trimmed.matchAll(pattern)) {
+    const [, phrase, segment] = match;
+
+    if (phrase !== undefined) {
+      const phraseTerms = phrase.match(TERM_PATTERN) ?? [];
+      if (phraseTerms.length > 0) {
+        tokens.push(`"${phraseTerms.join(' ')}"`);
+      }
+      continue;
+    }
+
+    const terms = (segment ?? '').match(TERM_PATTERN) ?? [];
+    for (const term of terms) {
+      tokens.push(usePrefix ? `${term}*` : term);
+    }
+  }
+
+  return tokens.length > 0 ? tokens.join(' ') : null;
+}
+
+function parsePage(value: unknown): number {
+  if (typeof value !== 'string') {
+    return 1;
+  }
+
+  const page = Number.parseInt(value, 10);
+  return Number.isInteger(page) && page > 0 ? page : 1;
+}
