new file mode 100644
index 0000000..202c503
--- /dev/null
+++ b/tests/task-queue.test.ts
@@ -0,0 +1,237 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import { TaskQueue } from '../src/index.js';
+
+describe('TaskQueue', () => {
+  it('processes basic FIFO tasks in the default queue', () => {
+    const queue = new TaskQueue();
+
+    const first = queue.addTask({ name: 'first' });
+    const second = queue.addTask({ name: 'second' });
+
+    expect(first.id).not.toBe(second.id);
+    expect(first.status).toBe('pending');
+    expect(queue.getWaitingCount()).toBe(2);
+
+    const next = queue.getNextTask();
+    expect(next?.id).toBe(first.id);
+    expect(next?.status).toBe('processing');
+    expect(queue.getWaitingCount()).toBe(1);
+  });
+
+  it('keeps named queues independent and lists them', () => {
+    const queue = new TaskQueue();
+
+    const alphaTask = queue.addTask('alpha', { job: 'a' });
+    queue.addTask('beta', { job: 'b' });
+
+    expect(queue.listQueueNames()).toEqual(['alpha', 'beta']);
+    expect(queue.getNextTask('alpha')?.id).toBe(alphaTask.id);
+    expect(queue.getNextTask('missing')).toBeNull();
+  });
+
+  it('orders tasks by priority and FIFO within the same priority', () => {
+    const queue = new TaskQueue();
+
+    const first = queue.addTask({ job: 'default' });
+    const urgent = queue.addTask({ job: 'urgent' }, { priority: 1 });
+    const urgentSecond = queue.addTask({ job: 'urgent-2' }, { priority: 1 });
+
+    expect(queue.getNextTask()?.id).toBe(urgent.id);
+    expect(queue.getNextTask()?.id).toBe(urgentSecond.id);
+    expect(queue.getNextTask()?.id).toBe(first.id);
+    expect(() => queue.addTask({ bad: true }, { priority: 0 })).toThrow(/Priority/);
+  });
+
+  it('hides delayed tasks until they become available', () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date('2026-01-01T00:00:00.000Z'));
+
+    const queue = new TaskQueue();
+    const immediate = queue.addTask({ job: 'now' });
+    const delayed = queue.addTask({ job: 'later' }, { delayMs: 5_000 });
+
+    expect(queue.getNextTask()?.id).toBe(immediate.id);
+    expect(queue.getNextTask()).toBeNull();
+
+    vi.advanceTimersByTime(5_000);
+    expect(queue.getNextTask()?.id).toBe(delayed.id);
+
+    vi.useRealTimers();
+  });
+
+  it('retries failed tasks with exponential backoff', () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date('2026-01-01T00:00:00.000Z'));
+
+    const queue = new TaskQueue();
+    const task = queue.addTask({ job: 'retry' }, { maxRetries: 2, baseBackoffMs: 100 });
+
+    expect(queue.getNextTask()?.id).toBe(task.id);
+    queue.failTask(task.id, new Error('boom'));
+    expect(task.status).toBe('pending');
+    expect(task.attempts).toBe(1);
+    expect(task.availableAt).toBe(Date.now() + 100);
+
+    vi.advanceTimersByTime(100);
+    expect(queue.getNextTask()?.id).toBe(task.id);
