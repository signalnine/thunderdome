--- /dev/null
+++ b/src/task-queue.ts
@@ -0,0 +1,989 @@
+import { randomUUID } from 'node:crypto';
+
+export const DEFAULT_QUEUE_NAME = 'default';
+
+export type TaskStatus =
+  | 'pending'
+  | 'blocked'
+  | 'processing'
+  | 'completed'
+  | 'failed'
+  | 'cancelled';
+
+export interface TaskError {
+  message: string;
+  name?: string;
+  stack?: string;
+}
+
+export interface TaskProgress {
+  percentage: number;
+  message?: string;
+  updatedAt: number | null;
+}
+
+export interface Task<T = unknown> {
+  id: string;
+  payload: T;
+  queueName: string;
+  status: TaskStatus;
+  createdAt: number;
+  updatedAt: number;
+  startedAt: number | null;
+  completedAt: number | null;
+  cancelledAt: number | null;
+  priority: number;
+  availableAt: number;
+  attempts: number;
+  maxRetries: number;
+  baseBackoffMs: number;
+  failureCount: number;
+  lastError?: TaskError;
+  dependencyIds: string[];
+  progress: TaskProgress;
+  metadata: Record<string, unknown>;
+  scheduleId?: string;
+}
+
+export interface TaskDependencyStatus {
+  taskId: string;
+  status: TaskStatus;
+  completed: boolean;
+}
+
+export interface DependencyInspection {
+  taskId: string;
+  blocked: boolean;
+  dependencyIds: string[];
+  resolvedDependencyIds: string[];
+  unresolvedDependencyIds: string[];
+  dependencies: TaskDependencyStatus[];
+}
+
+export interface AddTaskOptions {
+  queueName?: string;
+  id?: string;
+  priority?: number;
+  delayMs?: number;
+  availableAt?: number | Date;
+  maxRetries?: number;
+  baseBackoffMs?: number;
+  dependencies?: string[];
+  metadata?: Record<string, unknown>;
+}
+
+export interface QueueConcurrencyInfo {
+  limit: number | null;
+  activeCount: number;
+}
+
+export interface Schedule<T = unknown> {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  payload: T;
+  taskOptions: Omit<AddTaskOptions, 'queueName'>;
+  createdAt: number;
+  lastEnqueuedAt: number | null;
+}
+
+export interface ShutdownSummary {
+  completed: number;
+  forceCancelled: number;
+  durationMs: number;
+}
+
+export interface ShutdownOptions {
+  timeoutMs?: number;
+}
+
+export type ProgressListener = (progress: TaskProgress, task: Task) => void;
+export type TaskHandler = (task: Task) => void | Promise<void>;
+export type MiddlewareNext = () => Promise<void>;
+export type TaskMiddleware = (task: Task, next: MiddlewareNext) => void | Promise<void>;
+export type ShutdownCallback = () => void | Promise<void>;
+
+interface InternalTask extends Task {
+  sequence: number;
+  explicitDelay: boolean;
+  inDeadLetterQueue: boolean;
+  progressListeners: Set<ProgressListener>;
+}
+
+interface QueueState {
+  name: string;
+  taskIds: Set<string>;
+  deadLetterIds: string[];
+  concurrencyLimit: number | null;
+  activeTaskIds: Set<string>;
+  middleware: TaskMiddleware[];
+  handler?: TaskHandler;
+}
+
+interface ParsedSchedule {
+  kind: 'every-n-minutes' | 'hourly' | 'daily';
+  intervalMinutes?: number;
+}
+
+function isTaskLike(value: unknown): value is { id: string } {
+  return typeof value === 'object' && value !== null && 'id' in value;
+}
+
+function normalizeTaskId(taskOrId: string | Task): string {
+  return isTaskLike(taskOrId) ? taskOrId.id : taskOrId;
+}
+
+function normalizeAvailableAt(now: number, options: AddTaskOptions): { availableAt: number; explicitDelay: boolean } {
+  if (options.availableAt !== undefined) {
+    const availableAt = options.availableAt instanceof Date ? options.availableAt.getTime() : options.availableAt;
+    return { availableAt, explicitDelay: true };
+  }
+
+  if (options.delayMs !== undefined) {
+    return { availableAt: now + options.delayMs, explicitDelay: true };
+  }
+
+  return { availableAt: now, explicitDelay: false };
+}
+
+function normalizeError(error: unknown): TaskError {
+  if (error instanceof Error) {
+    return {
+      message: error.message,
+      name: error.name,
+      stack: error.stack,
+    };
+  }
+
+  return {
+    message: typeof error === 'string' ? error : JSON.stringify(error),
+  };
+}
+
+function assertPriority(priority: number): void {
+  if (!Number.isInteger(priority) || priority < 1 || priority > 10) {
+    throw new Error('Priority must be an integer between 1 and 10.');
+  }
+}
+
+function assertNonNegativeInteger(value: number, label: string): void {
+  if (!Number.isInteger(value) || value < 0) {
+    throw new Error(`${label} must be a non-negative integer.`);
+  }
+}
+
+function cloneOptions(options: Omit<AddTaskOptions, 'queueName'>): Omit<AddTaskOptions, 'queueName'> {
+  return {
+    ...options,
+    dependencies: options.dependencies ? [...options.dependencies] : undefined,
+    metadata: options.metadata ? { ...options.metadata } : undefined,
+  };
+}
+
+function toUtcMinuteBoundary(timestamp: number): number {
+  return Math.floor(timestamp / 60000) * 60000;
+}
+
+function parseCronExpression(expression: string): ParsedSchedule {
+  const everyMinutesMatch = expression.match(/^\*\/(\d+) \* \* \* \*$/);
+  if (everyMinutesMatch) {
+    const intervalMinutes = Number(everyMinutesMatch[1]);
+    if (!Number.isInteger(intervalMinutes) || intervalMinutes <= 0) {
+      throw new Error('Cron interval must be a positive integer.');
+    }
+
+    return { kind: 'every-n-minutes', intervalMinutes };
+  }
+
+  if (expression === '0 * * * *') {
+    return { kind: 'hourly' };
+  }
+
+  if (expression === '0 0 * * *') {
+    return { kind: 'daily' };
+  }
+
+  throw new Error('Unsupported cron expression.');
+}
+
+function scheduleMatches(parsed: ParsedSchedule, timestamp: number): boolean {
+  const date = new Date(timestamp);
+  const minutes = date.getUTCMinutes();
+  const hours = date.getUTCHours();
+
+  if (parsed.kind === 'every-n-minutes') {
+    return minutes % (parsed.intervalMinutes as number) === 0;
+  }
+
+  if (parsed.kind === 'hourly') {
+    return minutes === 0;
+  }
+
+  return minutes === 0 && hours === 0;
+}
+
+export class TaskQueue {
+  private readonly tasks = new Map<string, InternalTask>();
+  private readonly queues = new Map<string, QueueState>();
+  private readonly schedules = new Map<string, Schedule>();
+  private readonly dependencyGraph = new Map<string, Set<string>>();
+  private readonly shutdownCallbacks = new Set<ShutdownCallback>();
+  private readonly activeChangeListeners = new Set<() => void>();
+
+  private sequence = 0;
+  private shuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+
+  addTask<T>(payload: T, options?: AddTaskOptions): Task<T>;
+  addTask<T>(queueName: string, payload: T, options?: Omit<AddTaskOptions, 'queueName'>): Task<T>;
+  addTask<T>(
+    first: string | T,
+    second?: T | AddTaskOptions,
+    third?: Omit<AddTaskOptions, 'queueName'>,
+  ): Task<T> {
+    if (this.shuttingDown) {
+      throw new Error('Task queue is shutting down and is not accepting new tasks.');
+    }
+
+    const queueName = typeof first === 'string' && arguments.length >= 2 ? first : DEFAULT_QUEUE_NAME;
+    const payload = (queueName === DEFAULT_QUEUE_NAME ? first : second) as T;
+    const providedOptions = (queueName === DEFAULT_QUEUE_NAME ? second : third) as AddTaskOptions | undefined;
+    const options = providedOptions ?? {};
+    const now = Date.now();
+    const priority = options.priority ?? 5;
+    const maxRetries = options.maxRetries ?? 3;
+    const baseBackoffMs = options.baseBackoffMs ?? 1000;
+
+    assertPriority(priority);
+    assertNonNegativeInteger(maxRetries, 'maxRetries');
+    assertNonNegativeInteger(baseBackoffMs, 'baseBackoffMs');
+
+    const taskId = options.id ?? randomUUID();
+    if (this.tasks.has(taskId)) {
+      throw new Error(`Task with id "${taskId}" already exists.`);
+    }
+
+    const dependencyIds = [...(options.dependencies ?? [])];
+    this.validateDependencies(taskId, dependencyIds);
+
+    const { availableAt, explicitDelay } = normalizeAvailableAt(now, options);
+    const task: InternalTask = {
+      id: taskId,
+      payload,
+      queueName,
+      status: dependencyIds.length > 0 ? 'blocked' : 'pending',
+      createdAt: now,
+      updatedAt: now,
+      startedAt: null,
+      completedAt: null,
+      cancelledAt: null,
+      priority,
+      availableAt,
+      attempts: 0,
+      maxRetries,
+      baseBackoffMs,
+      failureCount: 0,
+      dependencyIds,
+      progress: {
+        percentage: 0,
+        updatedAt: null,
+      },
+      metadata: { ...(options.metadata ?? {}) },
+      sequence: this.sequence++,
+      explicitDelay,
+      inDeadLetterQueue: false,
+      progressListeners: new Set(),
+    };
+
+    const queue = this.ensureQueue(queueName);
+    queue.taskIds.add(task.id);
+    this.tasks.set(task.id, task);
+    for (const dependencyId of dependencyIds) {
+      const dependents = this.dependencyGraph.get(dependencyId) ?? new Set<string>();
+      dependents.add(task.id);
+      this.dependencyGraph.set(dependencyId, dependents);
+    }
+
+    this.refreshTaskBlockedState(task);
+    return task as Task<T>;
+  }
+
+  getNextTask(queueName = DEFAULT_QUEUE_NAME): Task | null {
+    if (this.shuttingDown) {
+      return null;
+    }
+
+    const queue = this.queues.get(queueName);
+    if (!queue) {
+      return null;
+    }
+
+    if (queue.concurrencyLimit !== null && queue.activeTaskIds.size >= queue.concurrencyLimit) {
+      return null;
+    }
+
+    const now = Date.now();
+    const candidates = [...queue.taskIds]
+      .map((taskId) => this.tasks.get(taskId))
+      .filter((task): task is InternalTask => task !== undefined)
+      .filter((task) => this.isRunnableTask(task, now))
+      .sort((left, right) => this.compareRunnableTasks(left, right));
+
+    const task = candidates[0];
+    if (!task) {
+      return null;
+    }
+
+    task.status = 'processing';
+    task.updatedAt = now;
+    task.startedAt = now;
+    task.attempts += 1;
+    task.progress = {
+      percentage: 0,
+      updatedAt: now,
+    };
+    queue.activeTaskIds.add(task.id);
+    this.notifyActiveChange();
+    return task;
+  }
+
+  async processNext(queueName = DEFAULT_QUEUE_NAME): Promise<Task | null> {
+    const task = this.getNextTask(queueName);
+    if (!task) {
+      return null;
+    }
+
+    const queue = this.ensureQueue(queueName);
+    const middleware = [...queue.middleware];
+    const handler = queue.handler;
+
+    const dispatch = async (index: number): Promise<void> => {
+      if (index < middleware.length) {
+        let nextCalled = false;
+        await middleware[index](task, async () => {
+          nextCalled = true;
+          await dispatch(index + 1);
+        });
+
+        if (!nextCalled) {
+          return;
+        }
+
+        return;
+      }
+
+      if (handler) {
+        await handler(task);
+      }
+    };
+
+    try {
+      await dispatch(0);
+      if (task.status === 'processing') {
+        this.completeTask(task.id);
+      }
+    } catch (error) {
+      if (task.status === 'processing') {
+        this.failTask(task.id, error);
+      }
+    }
+
+    return task;
+  }
+
+  completeTask(taskOrId: string | Task): Task {
+    const task = this.requireTask(taskOrId);
+    if (task.status !== 'processing') {
+      throw new Error('Only processing tasks can be completed.');
+    }
+
+    const now = Date.now();
+    task.status = 'completed';
+    task.updatedAt = now;
+    task.completedAt = now;
+    task.progress = {
+      percentage: 100,
+      updatedAt: now,
+    };
+    this.releaseActiveTask(task);
+    this.refreshDependents(task.id);
+    return task;
+  }
+
+  failTask(taskOrId: string | Task, error: unknown): Task {
+    const task = this.requireTask(taskOrId);
+    if (task.status !== 'processing') {
+      throw new Error('Only processing tasks can be failed.');
+    }
+
+    const now = Date.now();
+    task.failureCount += 1;
+    task.lastError = normalizeError(error);
+    task.updatedAt = now;
+    this.releaseActiveTask(task);
+
+    if (task.attempts <= task.maxRetries) {
+      const backoffDelay = task.baseBackoffMs * 2 ** (task.attempts - 1);
+      task.status = 'pending';
+      task.availableAt = now + backoffDelay;
+      task.startedAt = null;
+      task.explicitDelay = true;
+      task.progress = {
+        percentage: 0,
+        updatedAt: now,
+      };
+      return task;
+    }
+
+    task.status = 'failed';
+    task.completedAt = now;
+    task.progress = {
+      percentage: 0,
+      updatedAt: now,
+    };
+    this.moveToDeadLetterQueue(task);
+    return task;
+  }
+
+  cancelTask(taskOrId: string | Task): Task {
+    const task = this.requireTask(taskOrId);
+    if (task.status !== 'pending' && task.status !== 'blocked' && task.status !== 'processing') {
+      throw new Error('Only pending, blocked, or processing tasks can be cancelled.');
+    }
+
+    const now = Date.now();
+    const wasProcessing = task.status === 'processing';
+    task.status = 'cancelled';
+    task.updatedAt = now;
+    task.cancelledAt = now;
+    task.progress = {
+      ...task.progress,
+      updatedAt: now,
+    };
+    if (wasProcessing) {
+      this.releaseActiveTask(task);
+    }
+    return task;
+  }
+
+  getWaitingCount(queueName = DEFAULT_QUEUE_NAME): number {
+    const queue = this.queues.get(queueName);
+    if (!queue) {
+      return 0;
+    }
+
+    let count = 0;
+    for (const taskId of queue.taskIds) {
+      const task = this.tasks.get(taskId);
+      if (task && (task.status === 'pending' || task.status === 'blocked')) {
+        count += 1;
+      }
+    }
+
+    return count;
+  }
+
+  listQueueNames(): string[] {
+    return [...this.queues.keys()].sort();
+  }
+
+  getTask(taskOrId: string | Task): Task | undefined {
+    const taskId = normalizeTaskId(taskOrId);
+    return this.tasks.get(taskId);
+  }
+
+  getDeadLetterTasks(queueName = DEFAULT_QUEUE_NAME): Task[] {
+    const queue = this.queues.get(queueName);
+    if (!queue) {
+      return [];
+    }
+
+    return queue.deadLetterIds
+      .map((taskId) => this.tasks.get(taskId))
+      .filter((task): task is InternalTask => task !== undefined && task.inDeadLetterQueue);
+  }
+
+  retryDeadLetterTask(taskOrId: string | Task): Task {
+    const task = this.requireTask(taskOrId);
+    if (!task.inDeadLetterQueue) {
+      throw new Error('Task is not in a dead letter queue.');
+    }
+
+    const queue = this.ensureQueue(task.queueName);
+    queue.deadLetterIds = queue.deadLetterIds.filter((taskId) => taskId !== task.id);
+    task.inDeadLetterQueue = false;
+    task.status = task.dependencyIds.length > 0 ? 'blocked' : 'pending';
+    task.attempts = 0;
+    task.availableAt = Date.now();
+    task.startedAt = null;
+    task.completedAt = null;
+    task.lastError = undefined;
+    task.updatedAt = Date.now();
+    task.progress = {
+      percentage: 0,
+      updatedAt: task.updatedAt,
+    };
+    this.refreshTaskBlockedState(task);
+    return task;
+  }
+
+  clearDeadLetterQueue(queueName = DEFAULT_QUEUE_NAME): void {
+    const queue = this.queues.get(queueName);
+    if (!queue) {
+      return;
+    }
+
+    for (const taskId of queue.deadLetterIds) {
+      const task = this.tasks.get(taskId);
+      if (task) {
+        task.inDeadLetterQueue = false;
+      }
+    }
+    queue.deadLetterIds = [];
+  }
+
+  inspectDependencies(taskOrId: string | Task): DependencyInspection {
+    const task = this.requireTask(taskOrId);
+    const dependencies = task.dependencyIds.map((dependencyId) => {
+      const dependency = this.tasks.get(dependencyId);
+      if (!dependency) {
+        return {
+          taskId: dependencyId,
+          status: 'failed' as TaskStatus,
+          completed: false,
+        };
+      }
+
+      return {
+        taskId: dependency.id,
+        status: dependency.status,
+        completed: dependency.status === 'completed',
+      };
+    });
+
+    return {
+      taskId: task.id,
+      blocked: task.status === 'blocked',
+      dependencyIds: [...task.dependencyIds],
+      resolvedDependencyIds: dependencies.filter((dependency) => dependency.completed).map((dependency) => dependency.taskId),
+      unresolvedDependencyIds: dependencies.filter((dependency) => !dependency.completed).map((dependency) => dependency.taskId),
+      dependencies,
+    };
+  }
+
+  setConcurrency(limit: number | null): void;
+  setConcurrency(queueName: string, limit: number | null): void;
+  setConcurrency(first: number | string | null, second?: number | null): void {
+    const queueName = typeof first === 'string' ? first : DEFAULT_QUEUE_NAME;
+    const limit = typeof first === 'string' ? second ?? null : first;
+    if (limit !== null && (!Number.isInteger(limit) || limit < 1)) {
+      throw new Error('Concurrency limit must be null or an integer greater than 0.');
+    }
+
+    const queue = this.ensureQueue(queueName);
+    queue.concurrencyLimit = limit;
+  }
+
+  getConcurrency(queueName = DEFAULT_QUEUE_NAME): QueueConcurrencyInfo {
+    const queue = this.ensureQueue(queueName);
+    return {
+      limit: queue.concurrencyLimit,
+      activeCount: queue.activeTaskIds.size,
+    };
+  }
+
+  updateTaskProgress(taskOrId: string | Task, percentage: number, message?: string): TaskProgress {
+    const task = this.requireTask(taskOrId);
+    if (task.status !== 'processing') {
+      throw new Error('Only processing tasks can report progress.');
+    }
+
+    if (percentage < 0 || percentage > 100) {
+      throw new Error('Progress percentage must be between 0 and 100.');
+    }
+
+    const progress: TaskProgress = {
+      percentage,
+      message,
+      updatedAt: Date.now(),
+    };
+    task.progress = progress;
+    for (const listener of task.progressListeners) {
+      listener(progress, task);
+    }
+    return progress;
+  }
+
+  getTaskProgress(taskOrId: string | Task): TaskProgress {
+    const task = this.requireTask(taskOrId);
+    return { ...task.progress };
+  }
+
+  subscribeToProgress(taskOrId: string | Task, listener: ProgressListener): () => void {
+    const task = this.requireTask(taskOrId);
+    task.progressListeners.add(listener);
+    return () => {
+      task.progressListeners.delete(listener);
+    };
+  }
+
+  use(middleware: TaskMiddleware): void;
+  use(queueName: string, middleware: TaskMiddleware): void;
+  use(first: string | TaskMiddleware, second?: TaskMiddleware): void {
+    const queueName = typeof first === 'string' ? first : DEFAULT_QUEUE_NAME;
+    const middleware = typeof first === 'string' ? second : first;
+    if (!middleware) {
+      throw new Error('Middleware is required.');
+    }
+
+    this.ensureQueue(queueName).middleware.push(middleware);
+  }
+
+  setHandler(handler: TaskHandler): void;
+  setHandler(queueName: string, handler: TaskHandler): void;
+  setHandler(first: string | TaskHandler, second?: TaskHandler): void {
+    const queueName = typeof first === 'string' ? first : DEFAULT_QUEUE_NAME;
+    const handler = typeof first === 'string' ? second : first;
+    if (!handler) {
+      throw new Error('Handler is required.');
+    }
+
+    this.ensureQueue(queueName).handler = handler;
+  }
+
+  registerHandler(handler: TaskHandler): void;
+  registerHandler(queueName: string, handler: TaskHandler): void;
+  registerHandler(first: string | TaskHandler, second?: TaskHandler): void {
+    if (typeof first === 'string') {
+      this.setHandler(first, second as TaskHandler);
+      return;
+    }
+
+    this.setHandler(first);
+  }
+
+  addSchedule<T>(cronExpression: string, payload: T, options?: Omit<AddTaskOptions, 'queueName'> & { queueName?: string }): Schedule<T>;
+  addSchedule<T>(
+    queueName: string,
+    cronExpression: string,
+    payload: T,
+    options?: Omit<AddTaskOptions, 'queueName'>,
+  ): Schedule<T>;
+  addSchedule<T>(
+    first: string,
+    second: string | T,
+    third?: T | (Omit<AddTaskOptions, 'queueName'> & { queueName?: string }),
+    fourth?: Omit<AddTaskOptions, 'queueName'>,
+  ): Schedule<T> {
+    const queueName = typeof second === 'string' ? first : DEFAULT_QUEUE_NAME;
+    const cronExpression = typeof second === 'string' ? second : first;
+    const payload = (typeof second === 'string' ? third : second) as T;
+    const options = (typeof second === 'string' ? fourth : third) as (Omit<AddTaskOptions, 'queueName'> & {
+      queueName?: string;
+    }) | undefined;
+    parseCronExpression(cronExpression);
+
+    const taskOptions = cloneOptions(options ?? {});
+    const schedule: Schedule<T> = {
+      id: randomUUID(),
+      queueName: options?.queueName ?? queueName,
+      cronExpression,
+      payload,
+      taskOptions,
+      createdAt: Date.now(),
+      lastEnqueuedAt: null,
+    };
+
+    this.ensureQueue(schedule.queueName);
+    this.schedules.set(schedule.id, schedule as Schedule);
+    return schedule;
+  }
+
+  removeSchedule(scheduleOrId: string | Schedule): boolean {
+    const scheduleId = typeof scheduleOrId === 'string' ? scheduleOrId : scheduleOrId.id;
+    return this.schedules.delete(scheduleId);
+  }
+
+  listSchedules(): Schedule[] {
+    return [...this.schedules.values()];
+  }
+
+  tickSchedules(now = Date.now()): Task[] {
+    const enqueuedTasks: Task[] = [];
+    for (const schedule of this.schedules.values()) {
+      const parsed = parseCronExpression(schedule.cronExpression);
+      const lastSeen = schedule.lastEnqueuedAt ?? schedule.createdAt - 60000;
+      let cursor = toUtcMinuteBoundary(lastSeen + 60000);
+      const lastAllowed = toUtcMinuteBoundary(now);
+
+      while (cursor <= lastAllowed) {
+        if (scheduleMatches(parsed, cursor)) {
+          const task = this.addTask(schedule.queueName, schedule.payload, {
+            ...cloneOptions(schedule.taskOptions),
+            metadata: {
+              ...(schedule.taskOptions.metadata ?? {}),
+              scheduleId: schedule.id,
+              scheduledFor: cursor,
+            },
+          });
+          task.scheduleId = schedule.id;
+          enqueuedTasks.push(task);
+          schedule.lastEnqueuedAt = cursor;
+        }
+
+        cursor += 60000;
+      }
+    }
+
+    return enqueuedTasks;
+  }
+
+  onShutdown(callback: ShutdownCallback): () => void {
+    this.shutdownCallbacks.add(callback);
+    return () => {
+      this.shutdownCallbacks.delete(callback);
+    };
+  }
+
+  async shutdown(options: ShutdownOptions = {}): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) {
+      return this.shutdownPromise;
+    }
+
+    const timeoutMs = options.timeoutMs ?? 0;
+    const start = Date.now();
+    const completedBefore = this.countCompletedTasks();
+    this.shuttingDown = true;
+
+    this.shutdownPromise = (async () => {
+      await Promise.allSettled([...this.shutdownCallbacks].map((callback) => callback()));
+
+      if (this.getActiveTaskCount() > 0) {
+        await this.waitForActiveTasks(timeoutMs);
+      }
+
+      let forceCancelled = 0;
+      if (this.getActiveTaskCount() > 0) {
+        for (const queue of this.queues.values()) {
+          for (const taskId of [...queue.activeTaskIds]) {
+            const task = this.tasks.get(taskId);
+            if (task && task.status === 'processing') {
+              task.status = 'cancelled';
+              task.cancelledAt = Date.now();
+              task.updatedAt = task.cancelledAt;
+              this.releaseActiveTask(task);
+              forceCancelled += 1;
+            }
+          }
+        }
+      }
+
+      return {
+        completed: this.countCompletedTasks() - completedBefore,
+        forceCancelled,
+        durationMs: Date.now() - start,
+      };
+    })();
+
+    return this.shutdownPromise;
+  }
+
+  private compareRunnableTasks(left: InternalTask, right: InternalTask): number {
+    if (left.priority !== right.priority) {
+      return left.priority - right.priority;
+    }
+
+    if (left.explicitDelay && right.explicitDelay && left.availableAt !== right.availableAt) {
+      return left.availableAt - right.availableAt;
+    }
+
+    return left.sequence - right.sequence;
+  }
+
+  private isRunnableTask(task: InternalTask, now: number): boolean {
+    if (task.inDeadLetterQueue) {
+      return false;
+    }
+
+    if (task.status !== 'pending') {
+      return false;
+    }
+
+    if (task.availableAt > now) {
+      return false;
+    }
+
+    return this.areDependenciesResolved(task);
+  }
+
+  private areDependenciesResolved(task: InternalTask): boolean {
+    return task.dependencyIds.every((dependencyId) => this.tasks.get(dependencyId)?.status === 'completed');
+  }
+
+  private refreshTaskBlockedState(task: InternalTask): void {
+    if (task.status === 'cancelled' || task.status === 'completed' || task.status === 'failed' || task.status === 'processing') {
+      return;
+    }
+
+    task.status = this.areDependenciesResolved(task) ? 'pending' : 'blocked';
+    task.updatedAt = Date.now();
+  }
+
+  private refreshDependents(taskId: string): void {
+    const dependents = this.dependencyGraph.get(taskId);
+    if (!dependents) {
+      return;
+    }
+
+    for (const dependentId of dependents) {
+      const dependent = this.tasks.get(dependentId);
+      if (dependent) {
+        this.refreshTaskBlockedState(dependent);
+      }
+    }
+  }
+
+  private validateDependencies(taskId: string, dependencyIds: string[]): void {
+    const uniqueDependencies = new Set<string>();
+    for (const dependencyId of dependencyIds) {
+      if (dependencyId === taskId) {
+        throw new Error('Task cannot depend on itself.');
+      }
+
+      if (!this.tasks.has(dependencyId)) {
+        throw new Error(`Dependency task "${dependencyId}" does not exist.`);
+      }
+
+      if (uniqueDependencies.has(dependencyId)) {
+        throw new Error(`Duplicate dependency "${dependencyId}" is not allowed.`);
+      }
+
+      uniqueDependencies.add(dependencyId);
+      if (this.hasDependencyPath(dependencyId, taskId)) {
+        throw new Error('Circular dependency detected.');
+      }
+    }
+  }
+
+  private hasDependencyPath(fromTaskId: string, targetTaskId: string, seen = new Set<string>()): boolean {
+    if (fromTaskId === targetTaskId) {
+      return true;
+    }
+
+    if (seen.has(fromTaskId)) {
+      return false;
+    }
+
+    seen.add(fromTaskId);
+    const task = this.tasks.get(fromTaskId);
+    if (!task) {
+      return false;
+    }
+
+    return task.dependencyIds.some((dependencyId) => this.hasDependencyPath(dependencyId, targetTaskId, seen));
+  }
+
+  private ensureQueue(queueName: string): QueueState {
+    const existing = this.queues.get(queueName);
+    if (existing) {
+      return existing;
+    }
+
+    const queue: QueueState = {
+      name: queueName,
+      taskIds: new Set(),
+      deadLetterIds: [],
+      concurrencyLimit: null,
+      activeTaskIds: new Set(),
+      middleware: [],
+    };
+    this.queues.set(queueName, queue);
+    return queue;
+  }
+
+  private requireTask(taskOrId: string | Task): InternalTask {
+    const taskId = normalizeTaskId(taskOrId);
+    const task = this.tasks.get(taskId);
+    if (!task) {
+      throw new Error(`Task "${taskId}" was not found.`);
+    }
+
+    return task;
+  }
+
+  private moveToDeadLetterQueue(task: InternalTask): void {
+    const queue = this.ensureQueue(task.queueName);
+    task.inDeadLetterQueue = true;
+    if (!queue.deadLetterIds.includes(task.id)) {
+      queue.deadLetterIds.push(task.id);
+    }
+  }
+
+  private releaseActiveTask(task: InternalTask): void {
+    const queue = this.ensureQueue(task.queueName);
+    queue.activeTaskIds.delete(task.id);
+    this.notifyActiveChange();
+  }
+
+  private countCompletedTasks(): number {
+    let completed = 0;
+    for (const task of this.tasks.values()) {
+      if (task.status === 'completed') {
+        completed += 1;
+      }
+    }
+    return completed;
+  }
+
+  private getActiveTaskCount(): number {
+    let active = 0;
+    for (const queue of this.queues.values()) {
+      active += queue.activeTaskIds.size;
+    }
+    return active;
+  }
+
+  private notifyActiveChange(): void {
+    for (const listener of this.activeChangeListeners) {
+      listener();
+    }
+  }
+
+  private async waitForActiveTasks(timeoutMs: number): Promise<void> {
+    if (this.getActiveTaskCount() === 0) {
+      return;
+    }
+
+    await new Promise<void>((resolve) => {
+      let settled = false;
+      const complete = (): void => {
+        if (settled) {
+          return;
+        }
+
+        settled = true;
+        this.activeChangeListeners.delete(checkActive);
+        if (timer !== undefined) {
+          clearTimeout(timer);
+        }
+        resolve();
+      };
+
+      const checkActive = (): void => {
+        if (this.getActiveTaskCount() === 0) {
+          complete();
+        }
+      };
+
+      this.activeChangeListeners.add(checkActive);
+      let timer: NodeJS.Timeout | undefined;
+      if (timeoutMs >= 0) {
+        timer = setTimeout(() => {
+          complete();
+        }, timeoutMs);
+      }
+
+      checkActive();
+    });
+  }
+}
