+
+  websocketServer.on('connection', (socket, request) => {
+    const requestUrl = new URL(request.url ?? '/', 'http://localhost');
+    const match = requestUrl.pathname.match(/^\/documents\/([^/]+)\/ws$/);
+
+    if (!match) {
+      socket.close(1008, 'Invalid websocket path.');
+      return;
+    }
+
+    const documentId = decodeURIComponent(match[1]);
+    const clientId = randomUUID();
+
+    try {
+      const document = store.getDocument(documentId);
+      const client: ClientConnection = {
+        clientId,
+        documentId,
+        socket,
+      };
+
+      const room = rooms.get(documentId) ?? new Map<string, ClientConnection>();
+      room.set(clientId, client);
+      rooms.set(documentId, room);
+      sockets.add(socket);
+      store.addConnection(clientId, documentId);
+
+      sendMessage(socket, {
+        type: 'sync',
+        clientId,
+        document,
+      });
+
+      socket.on('message', (raw) => {
+        const buffer = Array.isArray(raw)
+          ? Buffer.concat(raw.map((part) => Buffer.from(part)))
+          : Buffer.from(raw instanceof ArrayBuffer ? new Uint8Array(raw) : raw);
+        handleClientMessage(client, buffer);
+      });
+
+      socket.on('close', () => {
+        removeClient(client);
+      });
+
+      socket.on('error', () => {
+        removeClient(client);
+      });
+    } catch (error) {
+      const message =
+        error instanceof DocumentNotFoundError ? error.message : 'Unable to open document.';
+      socket.close(1008, message);
+    }
+  });
+
+  const start = async (port = 0): Promise<number> => {
+    if (server) {
+      return parsePort(server);
+    }
+
+    server = createServer(app);
+
+    server.on('upgrade', (request, socket, head) => {
+      const requestUrl = new URL(request.url ?? '/', 'http://localhost');
+
+      if (!requestUrl.pathname.match(/^\/documents\/[^/]+\/ws$/)) {
+        socket.write('HTTP/1.1 404 Not Found\r\n\r\n');
+        socket.destroy();
+        return;
+      }
+
+      websocketServer.handleUpgrade(request, socket, head, (websocket) => {
+        websocketServer.emit('connection', websocket, request);
+      });
+    });
+
+    await new Promise<void>((resolvePromise) => {
+      server?.listen(port, resolvePromise);
+    });
+
+    return parsePort(server);
+  };
+
+  const stop = async (): Promise<void> => {
+    for (const socket of sockets) {
+      if (
+        socket.readyState === WebSocket.OPEN ||
+        socket.readyState === WebSocket.CONNECTING
+      ) {
+        socket.close();
+      }
+    }
+
+    await new Promise<void>((resolvePromise) => {
+      websocketServer.close(() => resolvePromise());
+    });
+
+    if (server) {
+      await new Promise<void>((resolvePromise, rejectPromise) => {
+        server?.close((error) => {
+          if (error) {
+            rejectPromise(error);
+            return;
+          }
+
+          resolvePromise();
+        });
+      });
+      server = null;
+    }
+
+    rooms.clear();
+    sockets.clear();
+    store.close();
+  };
+
+  return {
+    app,
+    start,
+    stop,
+  };
+};
+
+const handleDocumentError = (error: unknown, response: Response): void => {
+  if (error instanceof DocumentNotFoundError) {
+    response.status(404).json({ error: error.message });
+    return;
+  }
+
+  response.status(500).json({ error: 'Internal server error.' });
+};
