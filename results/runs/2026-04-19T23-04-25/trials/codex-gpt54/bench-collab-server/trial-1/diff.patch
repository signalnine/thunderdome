@@ -0,0 +1,185 @@
+export type InsertOperation = {
+  type: 'insert';
+  position: number;
+  text: string;
+};
+
+export type DeleteOperation = {
+  type: 'delete';
+  position: number;
+  length: number;
+};
+
+export type TextOperation = InsertOperation | DeleteOperation;
+
+export class InvalidOperationError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'InvalidOperationError';
+  }
+}
+
+export const isTextOperation = (value: unknown): value is TextOperation => {
+  if (!value || typeof value !== 'object') {
+    return false;
+  }
+
+  const candidate = value as Record<string, unknown>;
+
+  if (candidate.type === 'insert') {
+    return Number.isInteger(candidate.position) && typeof candidate.text === 'string';
+  }
+
+  if (candidate.type === 'delete') {
+    return Number.isInteger(candidate.position) && Number.isInteger(candidate.length);
+  }
+
+  return false;
+};
+
+export const normalizeOperation = (value: unknown): TextOperation => {
+  if (!isTextOperation(value)) {
+    throw new InvalidOperationError('Operation must be an insert or delete.');
+  }
+
+  if (value.type === 'insert') {
+    if (value.position < 0) {
+      throw new InvalidOperationError('Insert position must be >= 0.');
+    }
+
+    if (value.text.length === 0) {
+      throw new InvalidOperationError('Insert text must not be empty.');
+    }
+
+    return {
+      type: 'insert',
+      position: value.position,
+      text: value.text,
+    };
+  }
+
+  if (value.position < 0) {
+    throw new InvalidOperationError('Delete position must be >= 0.');
+  }
+
+  if (value.length <= 0) {
+    throw new InvalidOperationError('Delete length must be > 0.');
+  }
+
+  return {
+    type: 'delete',
+    position: value.position,
+    length: value.length,
+  };
+};
+
+export const applyOperation = (content: string, operation: TextOperation): string => {
+  if (operation.type === 'insert') {
+    if (operation.position > content.length) {
+      throw new InvalidOperationError('Insert position is outside the document.');
+    }
+
+    return (
+      content.slice(0, operation.position) +
+      operation.text +
+      content.slice(operation.position)
+    );
+  }
+
+  if (operation.position + operation.length > content.length) {
+    throw new InvalidOperationError('Delete range is outside the document.');
+  }
+
+  return (
+    content.slice(0, operation.position) +
+    content.slice(operation.position + operation.length)
+  );
+};
+
+export const transformOperation = (
+  incoming: TextOperation,
+  applied: TextOperation,
+): TextOperation => {
+  if (incoming.type === 'insert' && applied.type === 'insert') {
+    return {
+      ...incoming,
+      position:
+        incoming.position > applied.position || incoming.position === applied.position
+          ? incoming.position + applied.text.length
+          : incoming.position,
+    };
+  }
+
+  if (incoming.type === 'insert' && applied.type === 'delete') {
+    if (incoming.position <= applied.position) {
+      return incoming;
+    }
+
+    if (incoming.position >= applied.position + applied.length) {
+      return {
+        ...incoming,
+        position: incoming.position - applied.length,
+      };
+    }
+
+    return {
+      ...incoming,
+      position: applied.position,
+    };
+  }
+
+  if (incoming.type === 'delete' && applied.type === 'insert') {
+    if (applied.position <= incoming.position) {
+      return {
+        ...incoming,
+        position: incoming.position + applied.text.length,
+      };
+    }
+
+    if (applied.position < incoming.position + incoming.length) {
+      return {
+        ...incoming,
+        length: incoming.length + applied.text.length,
+      };
+    }
+
+    return incoming;
+  }
+
+  if (incoming.type === 'delete' && applied.type === 'delete') {
+    const incomingEnd = incoming.position + incoming.length;
+    const appliedEnd = applied.position + applied.length;
+
+    if (incomingEnd <= applied.position) {
+      return incoming;
+    }
+
+    if (incoming.position >= appliedEnd) {
+      return {
+        ...incoming,
+        position: incoming.position - applied.length,
+      };
+    }
+
+    const overlap =
+      Math.min(incomingEnd, appliedEnd) - Math.max(incoming.position, applied.position);
+    const nextLength = incoming.length - overlap;
+
+    if (nextLength <= 0) {
+      return {
+        type: 'delete',
+        position: Math.min(incoming.position, applied.position),
+        length: 0,
+      };
+    }
+
+    return {
+      type: 'delete',
+      position:
+        incoming.position >= applied.position ? applied.position : incoming.position,
+      length: nextLength,
+    };
+  }
+
+  return incoming;
+};
