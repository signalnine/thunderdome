+{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,360p' /workspace/src/server.ts\"","aggregated_output":"import { createServer, type Server as HttpServer } from 'node:http';\nimport { randomUUID } from 'node:crypto';\nimport { mkdirSync } from 'node:fs';\nimport { dirname, resolve } from 'node:path';\n\nimport Database from 'better-sqlite3';\nimport express, { type Express, type Request, type Response } from 'express';\nimport { WebSocketServer, type WebSocket } from 'ws';\n\nimport {\n  InvalidOperationError,\n  applyOperation,\n  normalizeOperation,\n  transformOperation,\n  type TextOperation,\n} from './ot.js';\n\ntype DocumentRecord = {\n  id: string;\n  title: string;\n  content: string;\n  version: number;\n  created_at: string;\n  updated_at: string;\n};\n\ntype VersionRecord = {\n  version: number;\n  content: string;\n  operation: string | null;\n  created_at: string;\n};\n\ntype PublicDocument = {\n  id: string;\n  title: string;\n  content: string;\n  version: number;\n  createdAt: string;\n  updatedAt: string;\n};\n\ntype PublicVersion = {\n  version: number;\n  content: string;\n  operation: TextOperation | null;\n  createdAt: string;\n};\n\ntype SyncMessage = {\n  type: 'sync';\n  clientId: string;\n  document: PublicDocument;\n};\n\ntype OperationMessage = {\n  type: 'op';\n  version: number;\n  operation: TextOperation;\n  originClientId: string;\n};\n\ntype ErrorMessage = {\n  type: 'error';\n  code: string;\n  message: string;\n  document?: PublicDocument;\n};\n\ntype ClientEnvelope = {\n  type: 'op';\n  baseVersion: number;\n  operation: unknown;\n};\n\ntype ClientConnection = {\n  clientId: string;\n  documentId: string;\n  socket: WebSocket;\n};\n\nclass DocumentNotFoundError extends Error {\n  constructor(documentId: string) {\n    super(`Document ${documentId} was not found.`);\n    this.name = 'DocumentNotFoundError';\n  }\n}\n\nclass ResyncRequiredError extends Error {\n  readonly document: PublicDocument;\n\n  constructor(document: PublicDocument) {\n    super('Document requires resynchronization.');\n    this.name = 'ResyncRequiredError';\n    this.document = document;\n  }\n}\n\nclass DocumentStore {\n  private readonly db: Database.Database;\n\n  constructor(dbPath: string) {\n    mkdirSync(dirname(dbPath), { recursive: true });\n    this.db = new Database(dbPath);\n    this.db.pragma('foreign_keys = ON');\n    this.db.pragma('journal_mode = WAL');\n    this.initialize();\n  }\n\n  close(): void {\n    this.db.close();\n  }\n\n  listDocuments(): PublicDocument[] {\n    const rows = this.db\n      .prepare(\n        `SELECT id, title, content, version, created_at, updated_at\n         FROM documents\n         ORDER BY updated_at DESC, id DESC`,\n      )\n      .all() as DocumentRecord[];\n\n    return rows.map((row) => this.toPublicDocument(row));\n  }\n\n  createDocument(input: { title: string; content?: string }): PublicDocument {\n    const id = randomUUID();\n    const now = this.timestamp();\n    const content = input.content ?? '';\n\n    this.db.transaction(() => {\n      this.db\n        .prepare(\n          `INSERT INTO documents (id, title, content, version, created_at, updated_at)\n           VALUES (?, ?, ?, 0, ?, ?)`,\n        )\n        .run(id, input.title, content, now, now);\n\n      this.db\n        .prepare(\n          `INSERT INTO versions (document_id, version, content, operation, created_at)\n           VALUES (?, 0, ?, NULL, ?)`,\n        )\n        .run(id, content, now);\n    })();\n\n    return this.getDocument(id);\n  }\n\n  getDocument(documentId: string): PublicDocument {\n    const row = this.db\n      .prepare(\n        `SELECT id, title, content, version, created_at, updated_at\n         FROM documents\n         WHERE id = ?`,\n      )\n      .get(documentId) as DocumentRecord | undefined;\n\n    if (!row) {\n      throw new DocumentNotFoundError(documentId);\n    }\n\n    return this.toPublicDocument(row);\n  }\n\n  updateDocument(\n    documentId: string,\n    input: { title: string; content: string },\n  ): PublicDocument {\n    return this.db.transaction(() => {\n      const current = this.getDocumentRow(documentId);\n      const nextVersion = current.version + 1;\n      const now = this.timestamp();\n\n      this.db\n        .prepare(\n          `UPDATE documents\n           SET title = ?, content = ?, version = ?, updated_at = ?\n           WHERE id = ?`,\n        )\n        .run(input.title, input.content, nextVersion, now, documentId);\n\n      this.db\n        .prepare(\n          `INSERT INTO versions (document_id, version, content, operation, created_at)\n           VALUES (?, ?, ?, NULL, ?)`,\n        )\n        .run(documentId, nextVersion, input.content, now);\n\n      return this.getDocument(documentId);\n    })();\n  }\n\n  deleteDocument(documentId: string): void {\n    const result = this.db.prepare('DELETE FROM documents WHERE id = ?').run(documentId);\n\n    if (result.changes === 0) {\n      throw new DocumentNotFoundError(documentId);\n    }\n  }\n\n  listVersions(documentId: string): PublicVersion[] {\n    this.getDocumentRow(documentId);\n\n    const rows = this.db\n      .prepare(\n        `SELECT version, content, operation, created_at\n         FROM versions\n         WHERE document_id = ?\n         ORDER BY version ASC`,\n      )\n      .all(documentId) as VersionRecord[];\n\n    return rows.map((row) => ({\n      version: row.version,\n      content: row.content,\n      operation: row.operation ? (JSON.parse(row.operation) as TextOperation) : null,\n      createdAt: row.created_at,\n    }));\n  }\n\n  addConnection(connectionId: string, documentId: string): void {\n    this.getDocumentRow(documentId);\n    this.db\n      .prepare(\n        `INSERT OR REPLACE INTO active_connections (id, document_id, connected_at)\n         VALUES (?, ?, ?)`,\n      )\n      .run(connectionId, documentId, this.timestamp());\n  }\n\n  removeConnection(connectionId: string): void {\n    this.db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);\n  }\n\n  applyCollaborativeOperation(\n    documentId: string,\n    baseVersion: number,\n    operation: TextOperation,\n  ): { document: PublicDocument; operation: TextOperation } {\n    return this.db.transaction(() => {\n      const current = this.getDocumentRow(documentId);\n\n      if (baseVersion > current.version) {\n        throw new InvalidOperationError(\n          `Base version ${baseVersion} is ahead of current version ${current.version}.`,\n        );\n      }\n\n      let transformed = operation;\n\n      if (baseVersion < current.version) {\n        const rows = this.db\n          .prepare(\n            `SELECT version, operation\n             FROM versions\n             WHERE document_id = ? AND version > ?\n             ORDER BY version ASC`,\n          )\n          .all(documentId, baseVersion) as Array<{ version: number; operation: string | null }>;\n\n        for (const row of rows) {\n          if (!row.operation) {\n            throw new ResyncRequiredError(this.toPublicDocument(current));\n          }\n\n          transformed = transformOperation(\n            transformed,\n            JSON.parse(row.operation) as TextOperation,\n          );\n        }\n      }\n\n      if (transformed.type === 'delete' && transformed.length === 0) {\n        return {\n          document: this.getDocument(documentId),\n          operation: transformed,\n        };\n      }\n\n      const nextContent = applyOperation(current.content, transformed);\n      const nextVersion = current.version + 1;\n      const now = this.timestamp();\n\n      this.db\n        .prepare(\n          `UPDATE documents\n           SET content = ?, version = ?, updated_at = ?\n           WHERE id = ?`,\n        )\n        .run(nextContent, nextVersion, now, documentId);\n\n      this.db\n        .prepare(\n          `INSERT INTO versions (document_id, version, content, operation, created_at)\n           VALUES (?, ?, ?, ?, ?)`,\n        )\n        .run(documentId, nextVersion, nextContent, JSON.stringify(transformed), now);\n\n      return {\n        document: this.getDocument(documentId),\n        operation: transformed,\n      };\n    })();\n  }\n\n  private initialize(): void {\n    this.db.exec(`\n      CREATE TABLE IF NOT EXISTS documents (\n        id TEXT PRIMARY KEY,\n        title TEXT NOT NULL,\n        content TEXT NOT NULL DEFAULT '',\n        version INTEGER NOT NULL DEFAULT 0,\n        created_at TEXT NOT NULL DEFAULT (datetime('now')),\n        updated_at TEXT NOT NULL DEFAULT (datetime('now'))\n      );\n\n      CREATE TABLE IF NOT EXISTS versions (\n        id INTEGER PRIMARY KEY AUTOINCREMENT,\n        document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,\n        version INTEGER NOT NULL,\n        content TEXT NOT NULL,\n        operation TEXT,\n        created_at TEXT NOT NULL DEFAULT (datetime('now')),\n        UNIQUE(document_id, version)\n      );\n\n      CREATE TABLE IF NOT EXISTS active_connections (\n        id TEXT PRIMARY KEY,\n        document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,\n        connected_at TEXT NOT NULL DEFAULT (datetime('now'))\n      );\n    `);\n\n    const documentColumns = this.db\n      .prepare(`PRAGMA table_info(documents)`)\n      .all() as Array<{ name: string }>;\n\n    if (!documentColumns.some((column) => column.name === 'version')) {\n      this.db.exec(`ALTER TABLE documents ADD COLUMN version INTEGER NOT NULL DEFAULT 0;`);\n    }\n  }\n\n  private getDocumentRow(documentId: string): DocumentRecord {\n    const row = this.db\n      .prepare(\n        `SELECT id, title, content, version, created_at, updated_at\n         FROM documents\n         WHERE id = ?`,\n      )\n      .get(documentId) as DocumentRecord | undefined;\n\n    if (!row) {\n      throw new DocumentNotFoundError(documentId);\n    }\n\n    return row;\n  }\n\n  private times