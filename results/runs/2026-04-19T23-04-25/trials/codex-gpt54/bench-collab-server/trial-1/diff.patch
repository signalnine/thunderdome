+const waitFor = async (predicate: () => boolean, timeoutMs = 5000): Promise<void> => {
+  const startedAt = Date.now();
+
+  while (!predicate()) {
+    if (Date.now() - startedAt > timeoutMs) {
+      throw new Error('Timed out waiting for condition.');
+    }
+
+    await new Promise((resolve) => setTimeout(resolve, 10));
+  }
+};
+
+const waitForMessage = async <
+  TMessage extends SyncMessage | OperationMessage | ErrorMessage,
+>(
+  queue: Array<SyncMessage | OperationMessage | ErrorMessage>,
+  predicate: (message: SyncMessage | OperationMessage | ErrorMessage) => message is TMessage,
+  timeoutMs = 5000,
+): Promise<TMessage> => {
+  const startedAt = Date.now();
+
+  while (Date.now() - startedAt <= timeoutMs) {
+    const index = queue.findIndex((message) => predicate(message));
+
+    if (index >= 0) {
+      return queue.splice(index, 1)[0] as TMessage;
+    }
+
+    await new Promise((resolve) => setTimeout(resolve, 10));
+  }
+
+  throw new Error('Timed out waiting for message.');
+};
+
+const countOccurrences = (content: string, token: string): number => {
+  return [...content].filter((character) => character === token).length;
+};
