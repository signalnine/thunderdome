@@ -0,0 +1,362 @@
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+import request from 'supertest';
+import { afterEach, describe, expect, it } from 'vitest';
+import { WebSocket } from 'ws';
+
+import { applyOperation, type TextOperation } from './ot.js';
+import { createApp } from './server.js';
+
+type DocumentResponse = {
+  document: {
+    id: string;
+    title: string;
+    content: string;
+    version: number;
+  };
+};
+
+type SyncMessage = {
+  type: 'sync';
+  clientId: string;
+  document: {
+    id: string;
+    title: string;
+    content: string;
+    version: number;
+  };
+};
+
+type OperationMessage = {
+  type: 'op';
+  version: number;
+  operation: TextOperation;
+  originClientId: string;
+};
+
+type ErrorMessage = {
+  type: 'error';
+  code: string;
+  message: string;
+};
+
+type ServerHandle = ReturnType<typeof createApp>;
+
+class MirrorClient {
+  readonly socket: WebSocket;
+
+  readonly ready: Promise<void>;
+
+  clientId = '';
+
+  content = '';
+
+  version = 0;
+
+  private readonly queue: Array<SyncMessage | OperationMessage | ErrorMessage> = [];
+
+  private resolveReady!: () => void;
+
+  constructor(url: string) {
+    this.socket = new WebSocket(url);
+    this.ready = new Promise<void>((resolve) => {
+      this.resolveReady = resolve;
+    });
+
+    this.socket.on('message', (raw) => {
+      const message = JSON.parse(raw.toString()) as SyncMessage | OperationMessage | ErrorMessage;
+      this.queue.push(message);
+
+      if (message.type === 'sync') {
+        this.clientId = message.clientId;
+        this.content = message.document.content;
+        this.version = message.document.version;
+        this.resolveReady();
+        return;
+      }
+
+      if (message.type === 'op') {
+        this.content = applyOperation(this.content, message.operation);
+        this.version = message.version;
+      }
+    });
+  }
+
+  sendOperation(baseVersion: number, operation: TextOperation): void {
+    this.socket.send(
+      JSON.stringify({
+        type: 'op',
+        baseVersion,
+        operation,
+      }),
+    );
+  }
+
+  async waitForVersion(targetVersion: number): Promise<void> {
+    await waitFor(() => this.version >= targetVersion);
+  }
+
+  async nextError(code: string): Promise<ErrorMessage> {
+    return waitForMessage(this.queue, (message): message is ErrorMessage => {
+      return message.type === 'error' && message.code === code;
+    });
+  }
+
+  close(): void {
+    this.socket.close();
+  }
+}
+
+const openClients = new Set<MirrorClient>();
+const tempPaths: string[] = [];
+const servers: ServerHandle[] = [];
+
+afterEach(async () => {
+  for (const client of openClients) {
+    client.close();
+  }
+  openClients.clear();
+
+  while (servers.length > 0) {
+    const server = servers.pop();
+    if (server) {
+      await server.stop();
+    }
+  }
+
+  for (const tempPath of tempPaths.splice(0)) {
+    rmSync(tempPath, { recursive: true, force: true });
+  }
+});
+
+describe('collaborative document server', () => {
+  it('supports REST CRUD and version history', async () => {
+    const { app } = await startServer();
+
+    const createResponse = await request(app)
+      .post('/documents')
+      .send({ title: 'Draft', content: 'hello' })
+      .expect(201);
+
+    const created = (createResponse.body as DocumentResponse).document;
+    expect(created.version).toBe(0);
+
+    const listResponse = await request(app).get('/documents').expect(200);
+    expect(listResponse.body.documents).toHaveLength(1);
+
+    const updateResponse = await request(app)
+      .put(`/documents/${created.id}`)
+      .send({ title: 'Draft v2', content: 'hello world' })
+      .expect(200);
+
+    const updated = (updateResponse.body as DocumentResponse).document;
+    expect(updated.version).toBe(1);
+    expect(updated.title).toBe('Draft v2');
+
+    const historyResponse = await request(app)
+      .get(`/documents/${created.id}/versions`)
+      .expect(200);
+
+    expect(historyResponse.body.versions).toHaveLength(2);
