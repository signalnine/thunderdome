@@ -0,0 +1,208 @@
+import type { EventFilter, EventInput, UserRole, WidgetInput } from './types';
+
+export class HttpError extends Error {
+  public readonly status: number;
+
+  constructor(status: number, message: string) {
+    super(message);
+    this.status = status;
+  }
+}
+
+export function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+export function requireString(
+  value: unknown,
+  field: string,
+  minLength = 1,
+): string {
+  if (typeof value !== 'string' || value.trim().length < minLength) {
+    throw new HttpError(400, `${field} must be a string`);
+  }
+
+  return value.trim();
+}
+
+export function optionalString(value: unknown, field: string): string | undefined {
+  if (value === undefined) {
+    return undefined;
+  }
+
+  return requireString(value, field);
+}
+
+export function requireRole(value: unknown): UserRole {
+  if (value === 'admin' || value === 'editor' || value === 'viewer') {
+    return value;
+  }
+
+  throw new HttpError(400, 'role must be one of admin, editor, or viewer');
+}
+
+export function normalizeTimestamp(value: unknown, field: string): string {
+  if (value === undefined) {
+    return new Date().toISOString();
+  }
+
+  const parsed = typeof value === 'string' ? Date.parse(value) : Number.NaN;
+  if (Number.isNaN(parsed)) {
+    throw new HttpError(400, `${field} must be a valid ISO timestamp`);
+  }
+
+  return new Date(parsed).toISOString();
+}
+
+function isJsonScalar(value: unknown): value is string | number | boolean | null {
+  return (
+    value === null ||
+    typeof value === 'string' ||
+    typeof value === 'number' ||
+    typeof value === 'boolean'
+  );
+}
+
+function requirePlainObject(value: unknown, field: string): Record<string, unknown> {
+  if (!isRecord(value)) {
+    throw new HttpError(400, `${field} must be an object`);
+  }
+
+  return value;
+}
+
+export function parseEventInput(value: unknown): EventInput {
+  const body = requirePlainObject(value, 'event');
+  const name = requireString(body.name, 'name');
+  const timestamp = normalizeTimestamp(body.timestamp, 'timestamp');
+  const sessionId = optionalString(body.sessionId, 'sessionId');
+
+  let properties: Record<string, unknown> | undefined;
+  if (body.properties !== undefined) {
+    properties = requirePlainObject(body.properties, 'properties');
+  }
+
+  return { name, timestamp, sessionId, properties };
+}
+
+export function parseBatchInput(value: unknown): EventInput[] {
+  if (!isRecord(value) || !Array.isArray(value.events)) {
+    throw new HttpError(400, 'events must be an array');
+  }
+
+  if (value.events.length === 0) {
+    throw new HttpError(400, 'events must not be empty');
+  }
+
+  return value.events.map((event) => parseEventInput(event));
+}
+
+export function parseEventFilter(value: unknown): EventFilter {
+  if (value === undefined) {
+    return {};
+  }
+
+  const body = requirePlainObject(value, 'filter');
+  const filter: EventFilter = {};
+
+  if (body.name !== undefined) {
+    filter.name = requireString(body.name, 'name');
+  }
+
+  if (body.from !== undefined) {
+    filter.from = normalizeTimestamp(body.from, 'from');
+  }
+
+  if (body.to !== undefined) {
+    filter.to = normalizeTimestamp(body.to, 'to');
+  }
+
+  if (body.properties !== undefined) {
+    const properties = requirePlainObject(body.properties, 'properties');
+    const parsed: Record<string, string | number | boolean | null> = {};
+
+    for (const [key, propertyValue] of Object.entries(properties)) {
+      if (!isJsonScalar(propertyValue)) {
+        throw new HttpError(400, `filter property ${key} must be a scalar value`);
+      }
+
+      parsed[key] = propertyValue;
+    }
+
+    filter.properties = parsed;
+  }
+
+  return filter;
+}
+
+export function parseInterval(value: unknown): 'hour' | 'day' | 'month' {
+  if (value === 'hour' || value === 'day' || value === 'month') {
+    return value;
+  }
+
+  throw new HttpError(400, 'interval must be one of hour, day, or month');
+}
+
+export function parseWidgets(value: unknown): WidgetInput[] {
+  if (value === undefined) {
+    return [];
+  }
+
+  if (!Array.isArray(value)) {
+    throw new HttpError(400, 'widgets must be an array');
+  }
+
+  return value.map((widget, index) => {
+    const body = requirePlainObject(widget, `widgets[${index}]`);
+    const type = body.type;
+    if (
+      type !== 'counter' &&
+      type !== 'timeseries' &&
+      type !== 'breakdown' &&
+      type !== 'funnel'
+    ) {
+      throw new HttpError(400, `widgets[${index}].type is invalid`);
+    }
+
+    if (body.config !== undefined && !isRecord(body.config)) {
+      throw new HttpError(400, `widgets[${index}].config must be an object`);
+    }
+
+    const numberField = (input: unknown, field: string, fallback: number): number => {
+      if (input === undefined) {
+        return fallback;
+      }
+
+      if (typeof input !== 'number' || !Number.isInteger(input)) {
+        throw new HttpError(400, `${field} must be an integer`);
+      }
+
+      return input;
+    };
+
+    return {
+      id: optionalString(body.id, `widgets[${index}].id`),
+      type,
+      config: (body.config as Record<string, unknown> | undefined) ?? {},
+      positionX: numberField(body.positionX, `widgets[${index}].positionX`, 0),
+      positionY: numberField(body.positionY, `widgets[${index}].positionY`, 0),
+      width: numberField(body.width, `widgets[${index}].width`, 1),
+      height: numberField(body.height, `widgets[${index}].height`, 1),
+    };
+  });
+}
+
+export function escapeCsvCell(value: unknown): string {
+  const rendered =
+    value === null || value === undefined
+      ? ''
+      : typeof value === 'string'
+        ? value
+        : JSON.stringify(value);
+
+  if (/[",\n]/.test(rendered)) {
+    return `"${rendered.replace(/"/g, '""')}"`;
+  }
+
+  return rendered;
+}
