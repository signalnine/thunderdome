+import request from 'supertest';
+import { describe, expect, test } from 'vitest';
+import { createApp } from './index';
+
+describe('analytics dashboard API', () => {
+  test('requires auth for protected routes', async () => {
+    const app = createApp({ databasePath: ':memory:', jwtSecret: 'test-secret' });
+
+    const response = await request(app).get('/auth/me');
+
+    expect(response.status).toBe(401);
+  });
+
+  test('supports tenant-scoped users, ingestion, queries, dashboards, and exports', async () => {
+    const app = createApp({ databasePath: ':memory:', jwtSecret: 'test-secret' });
+
+    const adminRegister = await request(app).post('/auth/register').send({
+      email: 'admin@example.com',
+      password: 'password123',
+    });
+
+    expect(adminRegister.status).toBe(201);
+    const adminToken = adminRegister.body.token as string;
+    const tenantId = adminRegister.body.user.tenantId as string;
+
+    const viewerRegister = await request(app).post('/auth/register').send({
+      email: 'viewer@example.com',
+      password: 'password123',
+      tenantId,
+    });
+
+    expect(viewerRegister.status).toBe(201);
+    expect(viewerRegister.body.user.role).toBe('viewer');
+
+    const promoteViewer = await request(app)
+      .patch(`/users/${viewerRegister.body.user.id}/role`)
+      .set('Authorization', `Bearer ${adminToken}`)
+      .send({ role: 'editor' });
+
+    expect(promoteViewer.status).toBe(200);
+    expect(promoteViewer.body.user.role).toBe('editor');
+
+    const otherTenantRegister = await request(app).post('/auth/register').send({
+      email: 'other@example.com',
+      password: 'password123',
+    });
+
+    const otherToken = otherTenantRegister.body.token as string;
+
+    const ingestBatch = await request(app)
+      .post('/events/batch')
+      .set('Authorization', `Bearer ${adminToken}`)
+      .send({
+        events: [
+          {
+            name: 'page_view',
+            timestamp: '2026-01-01T10:00:00.000Z',
+            properties: { url: '/home', plan: 'pro' },
+          },
+          {
+            name: 'page_view',
+            timestamp: '2026-01-01T12:00:00.000Z',
+            properties: { url: '/pricing', plan: 'pro' },
+          },
+          {
+            name: 'signup',
+            timestamp: '2026-01-02T09:00:00.000Z',
+            properties: { plan: 'free' },
+          },
+        ],
+      });
+
+    expect(ingestBatch.status).toBe(201);
+    expect(ingestBatch.body.count).toBe(3);
+
+    const ingestOtherTenant = await request(app)
+      .post('/events')
+      .set('Authorization', `Bearer ${otherToken}`)
+      .send({
+        name: 'page_view',
+        timestamp: '2026-01-01T10:00:00.000Z',
+        properties: { url: '/hidden' },
+      });
+
+    expect(ingestOtherTenant.status).toBe(201);
+
+    const countQuery = await request(app)
+      .post('/queries/count')
+      .set('Authorization', `Bearer ${adminToken}`)
+      .send({
+        filter: { name: 'page_view' },
+      });
+
+    expect(countQuery.status).toBe(200);
+    expect(countQuery.body.count).toBe(2);
+
+    const timeseriesQuery = await request(app)
+      .post('/queries/timeseries')
+      .set('Authorization', `Bearer ${adminToken}`)
+      .send({
+        interval: 'day',
+        filter: { name: 'page_view' },
+      });
+
+    expect(timeseriesQuery.status).toBe(200);
+    expect(timeseriesQuery.body.data).toEqual([{ bucket: '2026-01-01', count: 2 }]);
+
+    const breakdownQuery = await request(app)
+      .post('/queries/breakdown')
+      .set('Authorization', `Bearer ${adminToken}`)
+      .send({
+        property: 'url',
+        filter: { name: 'page_view' },
+      });
+
+    expect(breakdownQuery.status).toBe(200);
+    expect(breakdownQuery.body.data).toEqual([
+      { value: '/home', count: 1 },
+      { value: '/pricing', count: 1 },
+    ]);
+
+    const createDashboard = await request(app)
+      .post('/dashboards')
+      .set('Authorization', `Bearer ${adminToken}`)
+      .send({
+        name: 'Executive Overview',
+        config: { layout: 'grid' },
+        widgets: [
+          {
+            type: 'counter',
+            config: { query: 'page_view' },
+            width: 2,
+            height: 1,
+          },
+        ],
+      });
+
+    expect(createDashboard.status).toBe(201);
+    expect(createDashboard.body.dashboard.widgets).toHaveLength(1);
+
+    const listDashboards = await request(app)
+      .get('/dashboards')
+      .set('Authorization', `Bearer ${adminToken}`);
+
+    expect(listDashboards.status).toBe(200);
+    expect(listDashboards.body.dashboards).toHaveLength(1);
+
+    const exportEvents = await request(app)
+      .post('/exports/events')
+      .set('Authorization', `Bearer ${adminToken}`)
+      .send({ format: 'json', filter: { name: 'page_view' } });
+
+    expect(exportEvents.status).toBe(200);
+    const exportedEvents = JSON.parse(exportEvents.text) as Array<{ name: string }>;
+    expect(exportedEvents).toHaveLength(2);
+    expect(exportedEvents.every((event) => event.name === 'page_view')).toBe(true);
+
+    const exportDashboards = await request(app)
+      .post('/exports/dashboards')
+      .set('Authorization', `Bearer ${adminToken}`)
+      .send({ format: 'csv' });
+
+    expect(exportDashboards.status).toBe(200);
+    expect(exportDashboards.text).toContain('Executive Overview');
+
+    const otherTenantDashboards = await request(app)
+      .get('/dashboards')
+      .set('Authorization', `Bearer ${otherToken}`);
+
+    expect(otherTenantDashboards.status).toBe(200);
+    expect(otherTenantDashboards.body.dashboards).toHaveLength(0);
+  });
+});
