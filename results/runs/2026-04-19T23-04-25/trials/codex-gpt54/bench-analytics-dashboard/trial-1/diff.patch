@@ -0,0 +1,788 @@
+import express, { type NextFunction, type Request, type Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { createDatabase, type SqliteDatabase } from './db';
+import { hashPassword, signToken, toPublicUser, verifyPassword, verifyToken } from './auth';
+import type { AuthTokenPayload, EventFilter, EventInput, UserRecord, WidgetInput } from './types';
+import {
+  HttpError,
+  escapeCsvCell,
+  isRecord,
+  parseBatchInput,
+  parseEventFilter,
+  parseEventInput,
+  parseInterval,
+  parseWidgets,
+  requireRole,
+  requireString,
+} from './validation';
+
+type AuthenticatedRequest = Request & {
+  auth: AuthTokenPayload;
+};
+
+export interface CreateAppOptions {
+  databasePath?: string;
+  db?: SqliteDatabase;
+  jwtSecret?: string;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: WidgetInput['type'];
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+function getBucketExpression(interval: 'hour' | 'day' | 'month'): string {
+  if (interval === 'hour') {
+    return "strftime('%Y-%m-%dT%H:00:00Z', timestamp)";
+  }
+
+  if (interval === 'day') {
+    return "strftime('%Y-%m-%d', timestamp)";
+  }
+
+  return "strftime('%Y-%m', timestamp)";
+}
+
+function normalizeSqlJsonValue(value: string | number | boolean | null): string | number | null {
+  if (typeof value === 'boolean') {
+    return value ? 1 : 0;
+  }
+
+  return value;
+}
+
+function buildEventWhereClause(tenantId: string, filter: EventFilter): {
+  clause: string;
+  params: Array<string | number | null>;
+} {
+  const conditions = ['tenant_id = ?'];
+  const params: Array<string | number | null> = [tenantId];
+
+  if (filter.name) {
+    conditions.push('name = ?');
+    params.push(filter.name);
+  }
+
+  if (filter.from) {
+    conditions.push('timestamp >= ?');
+    params.push(filter.from);
+  }
+
+  if (filter.to) {
+    conditions.push('timestamp <= ?');
+    params.push(filter.to);
+  }
+
+  if (filter.properties) {
+    for (const [key, value] of Object.entries(filter.properties)) {
+      const path = `$.${key.replace(/"/g, '""')}`;
+      if (value === null) {
+        conditions.push("json_type(properties, ?) = 'null'");
+        params.push(path);
+      } else {
+        conditions.push('json_extract(properties, ?) = ?');
+        params.push(path, normalizeSqlJsonValue(value));
+      }
+    }
+  }
+
+  return {
+    clause: conditions.join(' AND '),
+    params,
+  };
+}
+
+function getAuthHeader(req: Request): string | undefined {
+  const authorization = req.header('authorization');
+  if (!authorization) {
+    return undefined;
+  }
+
+  const [scheme, token] = authorization.split(' ');
+  if (scheme !== 'Bearer' || !token) {
+    return undefined;
+  }
+
+  return token;
+}
+
+function requireAuth(jwtSecret: string) {
+  return (req: Request, _res: Response, next: NextFunction): void => {
+    const token = getAuthHeader(req);
+    if (!token) {
+      next(new HttpError(401, 'Authentication required'));
+      return;
+    }
+
+    try {
+      const auth = verifyToken(token, jwtSecret);
+      (req as AuthenticatedRequest).auth = auth;
+      next();
+    } catch (_error) {
+      next(new HttpError(401, 'Invalid authentication token'));
+    }
+  };
+}
+
+function requireAdmin(req: Request, _res: Response, next: NextFunction): void {
+  const auth = (req as AuthenticatedRequest).auth;
+  if (auth.role !== 'admin') {
+    next(new HttpError(403, 'Admin access required'));
+    return;
+  }
+
+  next();
+}
+
+function getAuthenticatedRequest(req: Request): AuthenticatedRequest {
+  return req as AuthenticatedRequest;
+}
+
+function serializeDashboard(row: DashboardRow, widgets: WidgetRow[]) {
+  return {
+    id: row.id,
+    tenantId: row.tenant_id,
+    name: row.name,
+    ownerId: row.owner_id,
+    config: JSON.parse(row.config) as Record<string, unknown>,
+    createdAt: row.created_at,
+    updatedAt: row.updated_at,
+    widgets: widgets.map((widget) => ({
+      id: widget.id,
+      dashboardId: widget.dashboard_id,
+      type: widget.type,
+      config: JSON.parse(widget.config) as Record<string, unknown>,
+      positionX: widget.position_x,
+      positionY: widget.position_y,
+      width: widget.width,
+      height: widget.height,
+    })),
+  };
+}
+
+function replaceDashboardWidgets(
+  db: SqliteDatabase,
+  dashboardId: string,
+  widgets: WidgetInput[],
+): void {
+  const deleteWidgets = db.prepare('DELETE FROM widgets WHERE dashboard_id = ?');
+  const insertWidget = db.prepare(`
+    INSERT INTO widgets (
+      id, dashboard_id, type, config, position_x, position_y, width, height
+    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
+  `);
+
+  const transaction = db.transaction((items: WidgetInput[]) => {
+    deleteWidgets.run(dashboardId);
+    for (const widget of items) {
+      insertWidget.run(
+        widget.id ?? uuidv4(),
+        dashboardId,
+        widget.type,
+        JSON.stringify(widget.config ?? {}),
+        widget.positionX ?? 0,
+        widget.positionY ?? 0,
+        widget.width ?? 1,
+        widget.height ?? 1,
+      );
+    }
+  });
+
+  transaction(widgets);
+}
+
+function fetchDashboardOrThrow(
+  db: SqliteDatabase,
+  dashboardId: string,
+  tenantId: string,
+): DashboardRow {
+  const dashboard = db
+    .prepare(
+      'SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE id = ? AND tenant_id = ?',
+    )
+    .get(dashboardId, tenantId) as DashboardRow | undefined;
+
+  if (!dashboard) {
+    throw new HttpError(404, 'Dashboard not found');
+  }
+
+  return dashboard;
+}
+
+function fetchWidgets(db: SqliteDatabase, dashboardId: string): WidgetRow[] {
+  return db
+    .prepare(
+      'SELECT id, dashboard_id, type, config, position_x, position_y, width, height FROM widgets WHERE dashboard_id = ? ORDER BY position_y, position_x, id',
+    )
+    .all(dashboardId) as WidgetRow[];
+}
+
+function sendExport(
+  res: Response,
+  filename: string,
+  format: 'json' | 'csv',
+  payload: unknown,
+  csv?: string,
+): void {
+  if (format === 'csv') {
+    res
+      .type('text/csv')
+      .setHeader('Content-Disposition', `attachment; filename="${filename}.csv"`)
+      .send(csv ?? '');
+    return;
+  }
+
+  res
+    .type('application/json')
+    .setHeader('Content-Disposition', `attachment; filename="${filename}.json"`)
+    .send(JSON.stringify(payload, null, 2));
+}
+
+export function createApp(options: CreateAppOptions = {}) {
+  const db = options.db ?? createDatabase(options.databasePath ?? ':memory:');
+  const jwtSecret = options.jwtSecret ?? 'development-secret';
+  const app = express();
+
+  app.use(express.json({ limit: '1mb' }));
+
+  app.get('/health', (_req, res) => {
+    res.json({ ok: true });
+  });
+
+  app.post('/auth/register', (req, res, next) => {
+    try {
+      if (!isRecord(req.body)) {
+        throw new HttpError(400, 'Request body must be an object');
+      }
+
+      const email = requireString(req.body.email, 'email');
+      const password = requireString(req.body.password, 'password', 8);
+      const tenantIdInput =
+        req.body.tenantId === undefined ? undefined : requireString(req.body.tenantId, 'tenantId');
+      const passwordHash = hashPassword(password);
+      const existingTenantUser =
+        tenantIdInput === undefined
+          ? undefined
+          : (db
+              .prepare('SELECT id FROM users WHERE tenant_id = ? LIMIT 1')
+              .get(tenantIdInput) as { id: string } | undefined);
+
+      if (tenantIdInput !== undefined && !existingTenantUser) {
+        throw new HttpError(400, 'tenantId does not exist');
+      }
+
+      const user: UserRecord = {
+        id: uuidv4(),
+        email,
+        password_hash: passwordHash,
+        tenant_id: tenantIdInput ?? uuidv4(),
+        role: tenantIdInput ? 'viewer' : 'admin',
+        created_at: new Date().toISOString(),
+      };
+
+      db.prepare(
+        'INSERT INTO users (id, email, password_hash, tenant_id, role, created_at) VALUES (?, ?, ?, ?, ?, ?)',
+      ).run(
+        user.id,
+        user.email,
+        user.password_hash,
+        user.tenant_id,
+        user.role,
+        user.created_at,
+      );
+
+      res.status(201).json({
+        token: signToken(user, jwtSecret),
+        user: toPublicUser(user),
+      });
+    } catch (error) {
