+type BeamState = {
+  down: bigint[];
+  downLeft: bigint[];
+  downRight: bigint[];
+};
+
+type SimulationResult = {
+  visitedCells: number;
+  pathCount: bigint;
+};
+
+function createState(cols: number): BeamState {
+  return {
+    down: Array<bigint>(cols).fill(0n),
+    downLeft: Array<bigint>(cols).fill(0n),
+    downRight: Array<bigint>(cols).fill(0n),
+  };
+}
+
+function findSourceColumns(grid: string[][]): number[] {
+  if (grid.length === 0) {
+    return [];
+  }
+
+  const sourceColumns: number[] = [];
+
+  for (let col = 0; col < grid[0].length; col += 1) {
+    if (grid[0][col] === 'S') {
+      sourceColumns.push(col);
+    }
+  }
+
+  return sourceColumns;
+}
+
+function simulate(grid: string[][]): SimulationResult {
+  const rows = grid.length;
+
+  if (rows === 0) {
+    return { visitedCells: 0, pathCount: 0n };
+  }
+
+  const cols = grid[0].length;
+
+  if (cols === 0) {
+    return { visitedCells: 0, pathCount: 0n };
+  }
+
+  let current = createState(cols);
+  let next = createState(cols);
+  let visitedCells = 0;
+  let pathCount = 0n;
+
+  for (const sourceCol of findSourceColumns(grid)) {
+    current.down[sourceCol] = 1n;
+  }
+
+  for (let row = 0; row < rows; row += 1) {
+    for (let col = 0; col < cols; col += 1) {
+      const down = current.down[col];
+      const downLeft = current.downLeft[col];
+      const downRight = current.downRight[col];
+      const total = down + downLeft + downRight;
+
+      if (total === 0n) {
+        continue;
+      }
+
+      visitedCells += 1;
+
+      if (grid[row][col] === '^') {
+        if (row + 1 >= rows || col - 1 < 0) {
+          pathCount += total;
+        } else {
+          next.downLeft[col - 1] += total;
+        }
+
+        if (row + 1 >= rows || col + 1 >= cols) {
+          pathCount += total;
+        } else {
+          next.downRight[col + 1] += total;
+        }
+
+        continue;
+      }
+
+      if (down !== 0n) {
+        if (row + 1 >= rows) {
+          pathCount += down;
+        } else {
+          next.down[col] += down;
+        }
+      }
+
+      if (downLeft !== 0n) {
+        if (row + 1 >= rows || col - 1 < 0) {
+          pathCount += downLeft;
+        } else {
+          next.downLeft[col - 1] += downLeft;
+        }
+      }
+
+      if (downRight !== 0n) {
+        if (row + 1 >= rows || col + 1 >= cols) {
+          pathCount += downRight;
+        } else {
+          next.downRight[col + 1] += downRight;
+        }
+      }
+    }
+
+    current = next;
+    next = createState(cols);
+  }
+
+  return { visitedCells, pathCount };
+}
+
+export function countBeamCells(grid: string[][]): number {
+  return simulate(grid).visitedCells;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  return simulate(grid).pathCount;
+}
