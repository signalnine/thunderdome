+import { countBeamCells, countBeamPaths } from '../src/index.js';
+
+describe('beam splitter simulator', () => {
+  it('counts cells and paths for a single splitter', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+
+    expect(countBeamCells(grid)).toBe(5);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('counts cells and paths for the branching example with two splitters', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+
+    expect(countBeamCells(grid)).toBe(6);
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('counts merged beams at one cell once while preserving path multiplicity', () => {
+    const grid = [
+      ['.', '.', 'S', '.', '.'],
+      ['.', '.', '^', '.', '.'],
+      ['.', '^', '.', '^', '.'],
+      ['.', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+
+    expect(countBeamCells(grid)).toBe(9);
+    expect(countBeamPaths(grid)).toBe(6n);
+  });
+
+  it('handles a source that exits immediately below the grid', () => {
+    const grid = [['S']];
+
+    expect(countBeamCells(grid)).toBe(1);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('returns zero when no source exists', () => {
+    const grid = [
+      ['.', '.'],
+      ['^', '.'],
+    ];
+
+    expect(countBeamCells(grid)).toBe(0);
+    expect(countBeamPaths(grid)).toBe(0n);
+  });
+});
