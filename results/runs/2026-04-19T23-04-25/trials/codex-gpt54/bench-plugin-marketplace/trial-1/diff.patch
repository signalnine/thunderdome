new file mode 100644
index 0000000..ddd6f94
--- /dev/null
+++ b/src/reviews/index.ts
@@ -0,0 +1,171 @@
+import Database from 'better-sqlite3';
+
+import type { Review, ReviewService } from '../types.js';
+
+type ReviewRow = {
+  id: number;
+  plugin_name: string;
+  plugin_version: string;
+  user_id: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  created_at: string;
+};
+
+const CREATE_REVIEWS_TABLE = `
+  CREATE TABLE IF NOT EXISTS reviews (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    plugin_name TEXT NOT NULL,
+    plugin_version TEXT NOT NULL,
+    user_id TEXT NOT NULL,
+    rating INTEGER NOT NULL,
+    comment TEXT NOT NULL,
+    flagged INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT NOT NULL
+  )
+`;
+
+function parseReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.plugin_name,
+    pluginVersion: row.plugin_version,
+    userId: row.user_id,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged === 1,
+    createdAt: row.created_at,
+  };
+}
+
+export function createReviewService(): ReviewService {
+  const db = new Database(':memory:');
+  db.exec(CREATE_REVIEWS_TABLE);
+
+  const insert = db.prepare(`
+    INSERT INTO reviews (
+      plugin_name,
+      plugin_version,
+      user_id,
+      rating,
+      comment,
+      flagged,
+      created_at
+    ) VALUES (
+      @plugin_name,
+      @plugin_version,
+      @user_id,
+      @rating,
+      @comment,
+      0,
+      @created_at
+    )
+  `);
+
+  const selectByPlugin = db.prepare<{ pluginName: string }, ReviewRow>(`
+    SELECT *
+    FROM reviews
+    WHERE plugin_name = @pluginName
+    ORDER BY id ASC
+  `);
+
+  const selectByUser = db.prepare<{ userId: string }, ReviewRow>(`
+    SELECT *
+    FROM reviews
+    WHERE user_id = @userId
+    ORDER BY id ASC
+  `);
+
+  const selectFlagged = db.prepare<[], ReviewRow>(`
+    SELECT *
+    FROM reviews
+    WHERE flagged = 1
+    ORDER BY id ASC
+  `);
+
+  const averageForPlugin = db.prepare<{ pluginName: string }, { average: number | null }>(`
+    SELECT AVG(rating) AS average
+    FROM reviews
+    WHERE plugin_name = @pluginName AND flagged = 0
+  `);
+
+  const countForPlugin = db.prepare<{ pluginName: string }, { total: number }>(`
+    SELECT COUNT(*) AS total
+    FROM reviews
+    WHERE plugin_name = @pluginName
+  `);
+
+  const flag = db.prepare<{ reviewId: number }>(`
+    UPDATE reviews
+    SET flagged = 1
+    WHERE id = @reviewId
+  `);
+
+  const remove = db.prepare<{ reviewId: number }>(`
+    DELETE FROM reviews
+    WHERE id = @reviewId
+  `);
+
+  return {
+    addReview(review) {
+      if (!Number.isInteger(review.rating) || review.rating < 1 || review.rating > 5) {
+        throw new Error('Rating must be an integer between 1 and 5');
+      }
+
+      const createdAt = new Date().toISOString();
+      const result = insert.run({
+        plugin_name: review.pluginName,
+        plugin_version: review.pluginVersion,
+        user_id: review.userId,
+        rating: review.rating,
+        comment: review.comment,
+        created_at: createdAt,
+      });
+
+      return {
+        id: Number(result.lastInsertRowid),
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment,
+        flagged: false,
+        createdAt,
+      };
+    },
+
+    getReviews(pluginName) {
+      return selectByPlugin.all({ pluginName }).map(parseReview);
+    },
+
+    getAverageRating(pluginName) {
+      const result = averageForPlugin.get({ pluginName });
+      return result?.average ?? 0;
+    },
+
+    flagReview(reviewId) {
+      const result = flag.run({ reviewId });
+      if (result.changes === 0) {
+        throw new Error(`Review ${reviewId} was not found`);
+      }
+    },
+
+    getFlaggedReviews() {
+      return selectFlagged.all().map(parseReview);
+    },
+
+    removeReview(reviewId) {
+      const result = remove.run({ reviewId });
+      return result.changes > 0;
+    },
+
+    getReviewsByUser(userId) {
+      return selectByUser.all({ userId }).map(parseReview);
+    },
+
+    getReviewCount(pluginName) {
+      return countForPlugin.get({ pluginName })?.total ?? 0;
+    },
+  };
+}
