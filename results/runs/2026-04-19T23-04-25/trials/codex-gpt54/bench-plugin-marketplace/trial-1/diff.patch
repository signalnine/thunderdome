diff --git a/tests/marketplace.test.ts b/tests/marketplace.test.ts
new file mode 100644
index 0000000..a635946
--- /dev/null
+++ b/tests/marketplace.test.ts
@@ -0,0 +1,207 @@
+import { describe, expect, it } from 'vitest';
+
+import { createMarketplace } from '../src/index.js';
+import { createDepsService } from '../src/deps/index.js';
+import { createRegistryService } from '../src/registry/index.js';
+import { createResolverService } from '../src/resolver/index.js';
+import { createReviewService } from '../src/reviews/index.js';
+import { createRunnerService } from '../src/runner/index.js';
+import type { PluginManifest } from '../src/types.js';
+
+function createManifest(overrides: Partial<PluginManifest> = {}): PluginManifest {
+  return {
+    name: 'formatter',
+    version: '1.0.0',
+    description: 'Formats plugin output',
+    author: 'dev',
+    dependencies: {},
+    entryPoint: 'module.exports = input.toUpperCase()',
+    permissions: [],
+    ...overrides,
+  };
+}
+
+describe('registry service', () => {
+  it('stores multiple versions and returns the highest version by name', () => {
+    const registry = createRegistryService();
+
+    registry.register(createManifest({ version: '1.0.0' }));
+    registry.register(createManifest({ version: '1.2.0' }));
+
+    expect(registry.get('formatter')?.version).toBe('1.2.0');
+    expect(registry.listVersions('formatter')).toEqual(['1.2.0', '1.0.0']);
+  });
+
+  it('supports search, updates, and version removal', () => {
+    const registry = createRegistryService();
+    registry.register(createManifest({ description: 'Code formatter', author: 'alice' }));
+
+    expect(registry.search('alice')).toHaveLength(1);
+
+    registry.update('formatter', '1.0.0', { description: 'Source formatter' });
+    expect(registry.getVersion('formatter', '1.0.0')?.description).toBe('Source formatter');
+
+    expect(registry.remove('formatter', '1.0.0')).toBe(true);
+    expect(registry.get('formatter')).toBeNull();
+  });
+});
+
+describe('resolver service', () => {
+  it('resolves concrete versions with semver constraints', () => {
+    const resolver = createResolverService();
+
+    expect(
+      resolver.resolve(
+        [
+          { name: 'core', range: '^1.0.0' },
+          { name: 'ui', range: '~2.1.0' },
+        ],
+        {
+          core: ['1.0.0', '1.4.0', '2.0.0'],
+          ui: ['2.0.9', '2.1.2', '2.2.0'],
+        },
+      ),
+    ).toEqual([
+      { name: 'core', version: '1.4.0', satisfies: '^1.0.0' },
+      { name: 'ui', version: '2.1.2', satisfies: '~2.1.0' },
+    ]);
+  });
+
+  it('rejects invalid ranges', () => {
+    const resolver = createResolverService();
+
+    expect(() =>
+      resolver.resolve([{ name: 'core', range: 'not-a-range' }], { core: ['1.0.0'] }),
+    ).toThrow(/Invalid version range/);
+  });
+});
+
+describe('runner service', () => {
+  it('executes sandboxed code with provided context', async () => {
+    const runner = createRunnerService();
+    const result = await runner.execute('module.exports = user + "-ok"', { user: 'alice' });
+
+    expect(result.success).toBe(true);
+    expect(result.output).toBe('alice-ok');
+    expect(result.duration).toBeGreaterThanOrEqual(0);
+  });
+
+  it('enforces timeouts for runaway code', async () => {
+    const runner = createRunnerService();
+    const result = await runner.executeWithTimeout('while (true) {}', 25);
+
+    expect(result.success).toBe(false);
+    expect(result.error).toMatch(/timed out|Script execution timed out/);
+  });
+});
+
+describe('review service', () => {
+  it('excludes flagged reviews from averages and supports review queries', () => {
+    const reviews = createReviewService();
+    const first = reviews.addReview({
+      pluginName: 'formatter',
+      pluginVersion: '1.0.0',
+      userId: 'u1',
+      rating: 5,
+      comment: 'Great',
+    });
+    reviews.addReview({
+      pluginName: 'formatter',
+      pluginVersion: '1.0.0',
+      userId: 'u2',
+      rating: 1,
+      comment: 'Bad',
+    });
+
+    reviews.flagReview(first.id);
+
+    expect(reviews.getAverageRating('formatter')).toBe(1);
+    expect(reviews.getFlaggedReviews()).toHaveLength(1);
+    expect(reviews.getReviewsByUser('u2')).toHaveLength(1);
+    expect(reviews.getReviewCount('formatter')).toBe(2);
+  });
+});
+
+describe('dependency service', () => {
+  it('builds trees, flattens dependencies, and sorts installation order', () => {
+    const registry = createRegistryService();
+    const deps = createDepsService();
+
+    registry.register(createManifest({ name: 'core', version: '1.0.0' }));
+    registry.register(createManifest({
+      name: 'lint',
+      version: '1.0.0',
+      dependencies: { core: '^1.0.0' },
+    }));
+    registry.register(createManifest({
+      name: 'formatter',
+      version: '1.0.0',
+      dependencies: { core: '^1.0.0', lint: '^1.0.0' },
+    }));
+
+    const tree = deps.buildTree('formatter', registry);
+
+    expect(tree.dependencies).toHaveLength(2);
+    expect(deps.flattenDependencies('formatter', registry)).toEqual(['core', 'lint']);
+    expect(deps.topologicalSort('formatter', registry)).toEqual(['core', 'lint', 'formatter']);
+  });
+
+  it('detects circular dependencies', () => {
+    const registry = createRegistryService();
+    const deps = createDepsService();
+
+    registry.register(createManifest({
+      name: 'a',
+      version: '1.0.0',
+      dependencies: { b: '^1.0.0' },
+    }));
+    registry.register(createManifest({
+      name: 'b',
+      version: '1.0.0',
+      dependencies: { c: '^1.0.0' },
+    }));
+    registry.register(createManifest({
+      name: 'c',
+      version: '1.0.0',
+      dependencies: { a: '^1.0.0' },
+    }));
+
+    expect(deps.hasCircularDependency('a', registry)).toBe(true);
+    expect(deps.detectCycles('a', registry)).toEqual([['a', 'b', 'c', 'a']]);
+  });
+});
+
+describe('marketplace integration', () => {
+  it('installs a plugin, resolves dependencies, and executes plugin code', async () => {
+    const marketplace = createMarketplace();
+
+    marketplace.registry.register(createManifest({ name: 'core', version: '1.0.0' }));
+
+    const plugin = createManifest({
+      name: 'formatter',
+      version: '2.0.0',
+      dependencies: { core: '^1.0.0' },
+      entryPoint: 'module.exports = prefix + subject',
+    });
+
+    const result = await marketplace.installPlugin(plugin, { prefix: 'hello-', subject: 'world' });
+
+    expect(result.resolvedDependencies).toEqual([
+      { name: 'core', version: '1.0.0', satisfies: '^1.0.0' },
+    ]);
+    expect(result.execution.output).toBe('hello-world');
+    expect(marketplace.registry.getVersion('formatter', '2.0.0')).not.toBeNull();
+  });
+
+  it('rolls back installation when dependency resolution fails', async () => {
+    const marketplace = createMarketplace();
+    const plugin = createManifest({
+      name: 'broken',
+      version: '1.0.0',
+      dependencies: { missing: '^1.0.0' },
+    });
+
+    await expect(marketplace.installPlugin(plugin)).rejects.toThrow(/No versions available/);
+    expect(marketplace.registry.getVersion('broken', '1.0.0')).toBeNull();
+  });
+});
