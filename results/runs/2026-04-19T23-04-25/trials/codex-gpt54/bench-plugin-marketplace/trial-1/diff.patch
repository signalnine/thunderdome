@@ -0,0 +1,45 @@
+import semver from 'semver';
+
+import type { ResolvedVersion, ResolverService } from '../types.js';
+
+export function createResolverService(): ResolverService {
+  return {
+    resolve(constraints, available) {
+      return constraints.map((constraint) => {
+        const versions = available[constraint.name];
+        if (!versions || versions.length === 0) {
+          throw new Error(`No versions available for dependency ${constraint.name}`);
+        }
+
+        if (!this.validRange(constraint.range)) {
+          throw new Error(`Invalid version range for ${constraint.name}: ${constraint.range}`);
+        }
+
+        const version = this.maxSatisfying(versions, constraint.range);
+        if (!version) {
+          throw new Error(`Unable to resolve ${constraint.name} with range ${constraint.range}`);
+        }
+
+        const resolved: ResolvedVersion = {
+          name: constraint.name,
+          version,
+          satisfies: constraint.range,
+        };
+
+        return resolved;
+      });
+    },
+
+    satisfies(version, range) {
+      return semver.satisfies(version, range, { includePrerelease: true });
+    },
+
+    maxSatisfying(versions, range) {
+      return semver.maxSatisfying(versions, range, { includePrerelease: true });
+    },
+
+    validRange(range) {
+      return semver.validRange(range) !== null;
+    },
+  };
+}
