@@ -0,0 +1,94 @@
+import { Script, createContext } from 'node:vm';
+
+import type { RunnerService, SandboxResult } from '../types.js';
+
+type SandboxGlobals = Record<string, unknown> & {
+  console: {
+    log: (...args: unknown[]) => void;
+    error: (...args: unknown[]) => void;
+    warn: (...args: unknown[]) => void;
+    info: (...args: unknown[]) => void;
+  };
+  module: {
+    exports: unknown;
+  };
+  exports: Record<string, unknown>;
+  globalThis?: unknown;
+};
+
+function createTimeoutError(timeoutMs: number): Error {
+  return new Error(`Execution timed out after ${timeoutMs}ms`);
+}
+
+async function runCode(
+  code: string,
+  timeoutMs: number,
+  context: Record<string, unknown> = {},
+): Promise<SandboxResult> {
+  const logs: unknown[][] = [];
+  const sandbox: SandboxGlobals = {
+    ...context,
+    console: {
+      log: (...args) => logs.push(args),
+      error: (...args) => logs.push(args),
+      warn: (...args) => logs.push(args),
+      info: (...args) => logs.push(args),
+    },
+    module: { exports: undefined },
+    exports: {},
+  };
+  sandbox.globalThis = sandbox;
+
+  const start = process.hrtime.bigint();
+  const beforeMemory = process.memoryUsage().heapUsed;
+
+  try {
+    const vmContext = createContext(sandbox);
+    const script = new Script(code);
+    const result = script.runInContext(vmContext, { timeout: timeoutMs });
+
+    const awaited = await Promise.race([
+      Promise.resolve(result),
+      new Promise<never>((_, reject) => {
+        setTimeout(() => reject(createTimeoutError(timeoutMs)), timeoutMs);
+      }),
+    ]);
+
+    const duration = Number(process.hrtime.bigint() - start) / 1_000_000;
+    const afterMemory = process.memoryUsage().heapUsed;
+    const exported = sandbox.module.exports !== undefined ? sandbox.module.exports : sandbox.exports;
+    const output = awaited === undefined
+      ? (Object.keys(exported as Record<string, unknown>).length > 0 ? exported : logs)
+      : awaited;
+
+    return {
+      success: true,
+      output,
+      duration,
+      memoryUsed: Math.max(0, afterMemory - beforeMemory),
+    };
+  } catch (error) {
+    const duration = Number(process.hrtime.bigint() - start) / 1_000_000;
+    const afterMemory = process.memoryUsage().heapUsed;
+
+    return {
+      success: false,
+      output: logs,
+      duration,
+      memoryUsed: Math.max(0, afterMemory - beforeMemory),
+      error: error instanceof Error ? error.message : String(error),
+    };
+  }
+}
+
+export function createRunnerService(): RunnerService {
+  return {
+    async execute(code, context) {
+      return runCode(code, 1000, context);
+    },
+
+    async executeWithTimeout(code, timeoutMs, context) {
+      return runCode(code, timeoutMs, context);
+    },
+  };
+}
