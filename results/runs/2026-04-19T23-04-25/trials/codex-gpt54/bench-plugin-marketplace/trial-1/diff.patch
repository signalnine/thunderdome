--- /dev/null
+++ b/src/deps/index.ts
@@ -0,0 +1,149 @@
+import semver from 'semver';
+
+import type { DependencyNode, DepsService, PluginManifest, RegistryService } from '../types.js';
+
+function resolveManifest(name: string, registry: RegistryService, range?: string): PluginManifest {
+  if (!range) {
+    const manifest = registry.get(name);
+    if (!manifest) {
+      throw new Error(`Plugin ${name} is not registered`);
+    }
+
+    return manifest;
+  }
+
+  if (semver.validRange(range) === null) {
+    throw new Error(`Invalid dependency range for ${name}: ${range}`);
+  }
+
+  const version = semver.maxSatisfying(registry.listVersions(name), range, { includePrerelease: true });
+  if (!version) {
+    throw new Error(`Unable to resolve dependency ${name} for range ${range}`);
+  }
+
+  const manifest = registry.getVersion(name, version);
+  if (!manifest) {
+    throw new Error(`Resolved dependency ${name}@${version} is missing from the registry`);
+  }
+
+  return manifest;
+}
+
+function cycleKey(cycle: string[]): string {
+  return cycle.join('>');
+}
+
+export function createDepsService(): DepsService {
+  return {
+    buildTree(name, registry) {
+      const visit = (pluginName: string, range?: string, stack = new Set<string>()): DependencyNode => {
+        const manifest = resolveManifest(pluginName, registry, range);
+        const key = `${manifest.name}@${manifest.version}`;
+        if (stack.has(key)) {
+          throw new Error(`Circular dependency detected while building tree: ${[...stack, key].join(' -> ')}`);
+        }
+
+        const nextStack = new Set(stack);
+        nextStack.add(key);
+
+        return {
+          name: manifest.name,
+          version: manifest.version,
+          dependencies: Object.entries(manifest.dependencies).map(([dependencyName, dependencyRange]) =>
+            visit(dependencyName, dependencyRange, nextStack),
+          ),
+        };
+      };
+
+      return visit(name);
+    },
+
+    detectCycles(name, registry) {
+      const cycles = new Map<string, string[]>();
+      const visited = new Set<string>();
+      const pathNames: string[] = [];
+      const pathKeys: string[] = [];
+
+      const visit = (pluginName: string, range?: string) => {
+        const manifest = resolveManifest(pluginName, registry, range);
+        const key = `${manifest.name}@${manifest.version}`;
+        const existingIndex = pathKeys.indexOf(key);
+        if (existingIndex >= 0) {
+          const cycle = [...pathNames.slice(existingIndex), manifest.name];
+          cycles.set(cycleKey(cycle), cycle);
+          return;
+        }
+
+        if (visited.has(key)) {
+          return;
+        }
+
+        visited.add(key);
+        pathKeys.push(key);
+        pathNames.push(manifest.name);
+
+        for (const [dependencyName, dependencyRange] of Object.entries(manifest.dependencies)) {
+          visit(dependencyName, dependencyRange);
+        }
+
+        pathKeys.pop();
+        pathNames.pop();
+      };
+
+      visit(name);
+      return cycles.size > 0 ? [...cycles.values()] : null;
+    },
+
+    topologicalSort(name, registry) {
+      const sorted: string[] = [];
+      const temporary = new Set<string>();
+      const permanent = new Set<string>();
+
+      const visit = (pluginName: string, range?: string) => {
+        const manifest = resolveManifest(pluginName, registry, range);
+        const key = `${manifest.name}@${manifest.version}`;
+
+        if (permanent.has(key)) {
+          return;
+        }
+
+        if (temporary.has(key)) {
+          throw new Error(`Circular dependency detected at ${manifest.name}@${manifest.version}`);
+        }
+
+        temporary.add(key);
+        for (const [dependencyName, dependencyRange] of Object.entries(manifest.dependencies)) {
+          visit(dependencyName, dependencyRange);
+        }
+        temporary.delete(key);
+        permanent.add(key);
+        sorted.push(manifest.name);
+      };
+
+      visit(name);
+      return sorted;
+    },
+
+    flattenDependencies(name, registry) {
+      const root = resolveManifest(name, registry);
+      const flattened = new Set<string>();
+
+      const collect = (manifest: PluginManifest) => {
+        for (const [dependencyName, dependencyRange] of Object.entries(manifest.dependencies)) {
+          const dependency = resolveManifest(dependencyName, registry, dependencyRange);
+          if (!flattened.has(dependency.name)) {
+            flattened.add(dependency.name);
+            collect(dependency);
+          }
+        }
+      };
+
+      collect(root);
+      return [...flattened];
+    },
+
+    hasCircularDependency(name, registry) {
+      return this.detectCycles(name, registry) !== null;
+    },
+  };
+}
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..7fd148e
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,118 @@
+import type {
+  DepsService,
+  PluginManifest,
+  RegistryService,
+  ResolverService,
+  ReviewService,
+  RunnerService,
+  SandboxResult,
+  VersionConstraint,
+} from './types.js';
+import { createDepsService } from './deps/index.js';
+import { createRegistryService } from './registry/index.js';
+import { createResolverService } from './resolver/index.js';
+import { createReviewService } from './reviews/index.js';
+import { createRunnerService } from './runner/index.js';
+
+export interface InstallPluginResult {
+  manifest: PluginManifest;
+  resolvedDependencies: {
+    name: string;
+    version: string;
+    satisfies: string;
+  }[];
+  execution: SandboxResult;
+}
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(
+    manifest: PluginManifest,
+    context?: Record<string, unknown>,
+    timeoutMs?: number,
+  ): Promise<InstallPluginResult>;
+}
+
+function validateManifest(manifest: PluginManifest): void {
+  if (!manifest.name.trim()) {
+    throw new Error('Plugin manifest must include a name');
+  }
+
+  if (!manifest.version.trim()) {
+    throw new Error('Plugin manifest must include a version');
+  }
+
+  if (!manifest.entryPoint.trim()) {
+    throw new Error('Plugin manifest must include an entryPoint');
+  }
+}
+
+function buildConstraints(manifest: PluginManifest): VersionConstraint[] {
+  return Object.entries(manifest.dependencies).map(([name, range]) => ({ name, range }));
+}
+
+function buildAvailableVersions(
+  constraints: VersionConstraint[],
+  registry: RegistryService,
+): Record<string, string[]> {
+  return Object.fromEntries(
+    constraints.map((constraint) => [constraint.name, registry.listVersions(constraint.name)]),
+  );
+}
+
+export function createMarketplace(): Marketplace {
+  const registry = createRegistryService();
+  const resolver = createResolverService();
+  const runner = createRunnerService();
+  const reviews = createReviewService();
+  const deps = createDepsService();
+
+  return {
+    registry,
+    resolver,
+    runner,
+    reviews,
+    deps,
+    async installPlugin(manifest, context, timeoutMs = 1000) {
+      validateManifest(manifest);
+      registry.register(manifest);
+
+      try {
+        const constraints = buildConstraints(manifest);
+        const available = buildAvailableVersions(constraints, registry);
+        const resolvedDependencies = resolver.resolve(constraints, available);
+
+        if (deps.hasCircularDependency(manifest.name, registry)) {
+          const cycles = deps.detectCycles(manifest.name, registry) ?? [];
+          throw new Error(`Circular dependencies detected: ${cycles.map((cycle) => cycle.join(' -> ')).join('; ')}`);
+        }
+
+        const execution = await runner.executeWithTimeout(manifest.entryPoint, timeoutMs, context);
+        if (!execution.success) {
+          throw new Error(execution.error ?? 'Plugin execution failed');
+        }
+
+        return {
+          manifest,
+          resolvedDependencies,
+          execution,
+        };
+      } catch (error) {
+        registry.remove(manifest.name, manifest.version);
+        throw error;
+      }
+    },
+  };
+}
+
+export {
+  createRegistryService,
+  createResolverService,
+  createRunnerService,
+  createReviewService,
+  createDepsService,
+};
diff --git a/src/registry/index.ts b/src/registry/index.ts
new file mode 100644
index 0000000..58cfa17
--- /dev/null
+++ b/src/registry/index.ts
@@ -0,0 +1,215 @@
+import Database from 'better-sqlite3';
+import semver from 'semver';
+
+import type { PluginManifest, RegistryService } from '../types.js';
+
+type RegistryRow = {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies: string;
+  entry_point: string;
+  permissions: string;
+};
+
+const CREATE_PLUGINS_TABLE = `
+  CREATE TABLE IF NOT EXISTS plugins (
+    name TEXT NOT NULL,
+    version TEXT NOT NULL,
+    description TEXT NOT NULL,
+    author TEXT NOT NULL,
+    dependencies TEXT NOT NULL,
+    entry_point TEXT NOT NULL,
+    permissions TEXT NOT NULL,
+    PRIMARY KEY (name, version)
+  )
+`;
+
+const SELECT_PLUGIN_COLUMNS = `
+  name,
+  version,
+  description,
+  author,
+  dependencies,
+  entry_point,
+  permissions
+`;
+
+function parseManifest(row: RegistryRow): PluginManifest {
+  return {
+    name: row.name,
+    version: row.version,
+    description: row.description,
+    author: row.author,
+    dependencies: JSON.parse(row.dependencies) as Record<string, string>,
+    entryPoint: row.entry_point,
+    permissions: JSON.parse(row.permissions) as string[],
+  };
+}
+
+function sortVersionsDesc(versions: string[]): string[] {
+  const valid = versions.filter((version) => semver.valid(version));
+  const invalid = versions.filter((version) => !semver.valid(version)).sort().reverse();
+  return [...semver.rsort(valid), ...invalid];
+}
+
+function getPreferredVersion(versions: string[]): string | null {
+  const [first] = sortVersionsDesc(versions);
+  return first ?? null;
+}
+
+export function createRegistryService(): RegistryService {
+  const db = new Database(':memory:');
+  db.exec(CREATE_PLUGINS_TABLE);
+
+  const insert = db.prepare(`
+    INSERT INTO plugins (
+      name,
+      version,
+      description,
+      author,
+      dependencies,
+      entry_point,
+      permissions
+    ) VALUES (
+      @name,
+      @version,
+      @description,
+      @author,
+      @dependencies,
+      @entry_point,
+      @permissions
+    )
+  `);
+
+  const selectVersion = db.prepare<{
+    name: string;
+    version: string;
+  }, RegistryRow>(`
+    SELECT ${SELECT_PLUGIN_COLUMNS}
+    FROM plugins
+    WHERE name = @name AND version = @version
+  `);
+
+  const selectByName = db.prepare<{ name: string }, RegistryRow>(`
+    SELECT ${SELECT_PLUGIN_COLUMNS}
+    FROM plugins
+    WHERE name = @name
+  `);
+
+  const selectAll = db.prepare<[], RegistryRow>(`
+    SELECT ${SELECT_PLUGIN_COLUMNS}
+    FROM plugins
+    ORDER BY name ASC, version DESC
+  `);
+
+  const search = db.prepare<{ query: string }, RegistryRow>(`
+    SELECT ${SELECT_PLUGIN_COLUMNS}
+    FROM plugins
+    WHERE LOWER(name) LIKE @query
+      OR LOWER(description) LIKE @query
+      OR LOWER(author) LIKE @query
+    ORDER BY name ASC, version DESC
+  `);
+
+  const remove = db.prepare<{ name: string; version: string }>(`
+    DELETE FROM plugins
+    WHERE name = @name AND version = @version
+  `);
+
+  const update = db.prepare(`
+    UPDATE plugins
+    SET description = @description,
+        author = @author,
+        dependencies = @dependencies,
+        entry_point = @entry_point,
+        permissions = @permissions
+    WHERE name = @name AND version = @version
+  `);
+
+  return {
+    register(manifest) {
+      if (!semver.valid(manifest.version)) {
+        throw new Error(`Invalid plugin version: ${manifest.version}`);
+      }
+
+      try {
+        insert.run({
+          name: manifest.name,
+          version: manifest.version,
+          description: manifest.description,
+          author: manifest.author,
+          dependencies: JSON.stringify(manifest.dependencies),
+          entry_point: manifest.entryPoint,
+          permissions: JSON.stringify(manifest.permissions),
+        });
+      } catch (error) {
+        if (error instanceof Error && error.message.includes('UNIQUE')) {
+          throw new Error(`Plugin ${manifest.name}@${manifest.version} is already registered`);
+        }
+
+        throw error;
+      }
+    },
+
+    get(name) {
+      const versions = selectByName.all({ name }).map((row) => row.version);
+      const preferred = getPreferredVersion(versions);
+      if (!preferred) {
+        return null;
+      }
+
+      const row = selectVersion.get({ name, version: preferred });
+      return row ? parseManifest(row) : null;
+    },
+
+    getVersion(name, version) {
+      const row = selectVersion.get({ name, version });
+      return row ? parseManifest(row) : null;
+    },
+
+    list() {
+      return selectAll.all().map(parseManifest);
+    },
+
+    search(query) {
+      const normalized = `%${query.toLowerCase()}%`;
+      return search.all({ query: normalized }).map(parseManifest);
+    },
+
+    remove(name, version) {
+      const result = remove.run({ name, version });
+      return result.changes > 0;
+    },
+
+    listVersions(name) {
+      return sortVersionsDesc(selectByName.all({ name }).map((row) => row.version));
+    },
+
+    update(name, version, updates) {
+      const existing = this.getVersion(name, version);
+      if (!existing) {
+        throw new Error(`Plugin ${name}@${version} is not registered`);
+      }
+
+      if (updates.name && updates.name !== name) {
+        throw new Error('Plugin name cannot be changed');
+      }
+
+      if (updates.version && updates.version !== version) {
+        throw new Error('Plugin version cannot be changed');
+      }
+
+      update.run({
+        name,
+        version,
+        description: updates.description ?? existing.description,
+        author: updates.author ?? existing.author,
+        dependencies: JSON.stringify(updates.dependencies ?? existing.dependencies),
+        entry_point: updates.entryPoint ?? existing.entryPoint,
+        permissions: JSON.stringify(updates.permissions ?? existing.permissions),
+      });
+    },
+  };
+}
