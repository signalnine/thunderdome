+
+function lowerBoundPresses(residual: number[], maxButtonWeight: number): number {
+  let maxResidual = 0;
+  let sumResidual = 0;
+  for (const value of residual) {
+    if (value > maxResidual) {
+      maxResidual = value;
+    }
+    sumResidual += value;
+  }
