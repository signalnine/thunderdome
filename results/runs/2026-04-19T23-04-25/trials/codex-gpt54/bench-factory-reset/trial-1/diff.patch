+export interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+interface HalfEntry {
+  state: bigint;
+  subset: number;
+  weight: number;
+}
+
+interface RrefResult {
+  consistent: boolean;
+  matrix: number[][];
+  rhs: number[];
+  pivotCols: number[];
+  freeCols: number[];
+}
+
+const BIGINT_ZERO = 0n;
+
+export function solveToggle(machine: Machine): number[] | null {
+  const lightCount = machine.target.length;
+  const buttonCount = machine.buttons.length;
+  if (lightCount === 0) {
+    return [];
+  }
+
+  const targetMask = booleanArrayToMask(machine.target);
+  const buttonMasks = machine.buttons.map((button) =>
+    toggleButtonToMask(button, lightCount),
+  );
+
+  const split = Math.floor(buttonCount / 2);
+  const leftEntries = enumerateHalf(buttonMasks.slice(0, split));
+  const rightBest = buildBestHalfMap(buttonMasks.slice(split), split);
+
+  let bestLeft = 0;
+  let bestRight = 0;
+  let bestWeight = Number.POSITIVE_INFINITY;
+
+  for (const entry of leftEntries) {
+    const needed = targetMask ^ entry.state;
+    const rightSubset = rightBest.get(needed);
+    if (rightSubset === undefined) {
+      continue;
+    }
+
+    const totalWeight = entry.weight + popcountNumber(rightSubset);
+    if (totalWeight > bestWeight) {
+      continue;
+    }
+
+    if (totalWeight < bestWeight) {
+      bestWeight = totalWeight;
+      bestLeft = entry.subset;
+      bestRight = rightSubset;
+      continue;
+    }
+
+    if (
+      compareTogglePairs(
+        entry.subset,
+        rightSubset,
+        bestLeft,
+        bestRight,
+        split,
+        buttonCount - split,
+      ) < 0
+    ) {
+      bestLeft = entry.subset;
+      bestRight = rightSubset;
+    }
+  }
+
+  if (!Number.isFinite(bestWeight)) {
+    return null;
+  }
+
+  return subsetPairToIndices(bestLeft, bestRight, split, buttonCount - split);
+}
+
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const counterCount = lights.length;
+  const buttonCount = buttons.length;
+
+  if (modulus === 2) {
+    const toggleResult = solveToggle({
+      target: lights.map((value) => mod(value, 2) === 1),
+      buttons,
+    });
+    if (toggleResult === null) {
+      return null;
+    }
+
+    const result = new Array<number>(buttonCount).fill(0);
+    for (const index of toggleResult) {
+      result[index] = 1;
+    }
+    return result;
+  }
+
+  if (counterCount === 0) {
+    return new Array<number>(buttonCount).fill(0);
+  }
+
+  const normalizedTarget = lights.map((value) => mod(value, modulus));
+  const denseColumns = buttons.map((button) =>
+    counterButtonToDenseColumn(button, counterCount, modulus),
+  );
+  const sparseColumns = denseColumns.map(denseToSparse);
+  const buttonWeights = buttons.map((button) => button.length);
+
+  const matrix = buildRowMatrix(denseColumns, counterCount, buttonCount);
+  const rref = gaussianElimination(matrix, normalizedTarget, modulus);
+  if (!rref.consistent) {
+    return null;
+  }
+
+  const particular = buildParticularSolution(rref, buttonCount);
+  let bestCost = vectorSum(particular);
+  let bestSolution = particular.slice();
+
+  const nullspace = buildNullspaceBasis(rref, buttonCount, modulus);
+  if (nullspace.length > 0) {
+    const improved = improveSolutionLocally(
+      particular,
+      nullspace,
+      bestCost,
+      modulus,
+    );
+    bestCost = improved.cost;
+    bestSolution = improved.solution;
+  }
+
+  const suffixBases = buildSuffixBases(denseColumns, counterCount, modulus);
+  const suffixMaxButtonWeight = buildSuffixMaxWeights(buttonWeights);
+
+  bestCost = searchMinimumCounterCost(
+    sparseColumns,
+    normalizedTarget,
+    suffixBases,
+    suffixMaxButtonWeight,
+    modulus,
+    bestCost,
+  );
+
+  const exact = searchLexicographicCounterSolution(
+    sparseColumns,
+    normalizedTarget,
+    suffixBases,
+    suffixMaxButtonWeight,
+    modulus,
+    bestCost,
+  );
+
+  if (exact === null) {
+    return bestSolution;
+  }
+
+  return exact;
+}
+
+function booleanArrayToMask(values: boolean[]): bigint {
+  let mask = BIGINT_ZERO;
+  for (let index = 0; index < values.length; index += 1) {
+    if (values[index]) {
+      mask |= 1n << BigInt(index);
+    }
+  }
+  return mask;
+}
+
+function toggleButtonToMask(button: number[], lightCount: number): bigint {
+  let mask = BIGINT_ZERO;
+  for (const rawIndex of button) {
+    if (rawIndex < 0 || rawIndex >= lightCount) {
+      continue;
+    }
+    mask ^= 1n << BigInt(rawIndex);
+  }
+  return mask;
+}
+
+function enumerateHalf(buttonMasks: bigint[]): HalfEntry[] {
+  const size = buttonMasks.length;
+  const subsetCount = 1 << size;
+  const states = new Array<bigint>(subsetCount);
+  const weights = new Array<number>(subsetCount);
+  const entries = new Array<HalfEntry>(subsetCount);
+
+  states[0] = BIGINT_ZERO;
+  weights[0] = 0;
+  entries[0] = { state: BIGINT_ZERO, subset: 0, weight: 0 };
+
+  for (let subset = 1; subset < subsetCount; subset += 1) {
+    const lsb = subset & -subset;
+    const bitIndex = Math.trunc(Math.log2(lsb));
+    const previous = subset ^ lsb;
+    const state = states[previous] ^ buttonMasks[bitIndex];
+    const weight = weights[previous] + 1;
+    states[subset] = state;
+    weights[subset] = weight;
+    entries[subset] = { state, subset, weight };
+  }
+
+  return entries;
+}
+
+function buildBestHalfMap(
+  buttonMasks: bigint[],
+  offset: number,
+): Map<bigint, number> {
+  const size = buttonMasks.length;
+  const entries = enumerateHalf(buttonMasks);
+  const best = new Map<bigint, number>();
+
+  for (const entry of entries) {
+    const current = best.get(entry.state);
+    if (current === undefined) {
+      best.set(entry.state, entry.subset);
+      continue;
+    }
+
+    const currentWeight = popcountNumber(current);
+    if (entry.weight < currentWeight) {
+      best.set(entry.state, entry.subset);
+      continue;
+    }
+
+    if (
+      entry.weight === currentWeight &&
+      compareSubsetLex(entry.subset, current, size, offset) < 0
+    ) {
+      best.set(entry.state, entry.subset);
+    }
+  }
+
+  return best;
+}
+
+function subsetPairToIndices(
+  leftSubset: number,
+  rightSubset: number,
+  leftSize: number,
+  rightSize: number,
+): number[] {
+  const result: number[] = [];
+  for (let index = 0; index < leftSize; index += 1) {
+    if ((leftSubset & (1 << index)) !== 0) {
+      result.push(index);
+    }
+  }
+  for (let index = 0; index < rightSize; index += 1) {
+    if ((rightSubset & (1 << index)) !== 0) {
+      result.push(leftSize + index);
+    }
+  }
+  return result;
+}
+
+function compareTogglePairs(
+  leftA: number,
+  rightA: number,
+  leftB: number,
+  rightB: number,
+  leftSize: number,
+  rightSize: number,
+): number {
+  const sequenceA = subsetPairToIndices(leftA, rightA, leftSize, rightSize);
+  const sequenceB = subsetPairToIndices(leftB, rightB, leftSize, rightSize);
+  return compareNumberArrays(sequenceA, sequenceB);
+}
+
+function compareSubsetLex(
+  subsetA: number,
+  subsetB: number,
+  size: number,
+  offset: number,
+): number {
+  const sequenceA = subsetToIndices(subsetA, size, offset);
+  const sequenceB = subsetToIndices(subsetB, size, offset);
+  return compareNumberArrays(sequenceA, sequenceB);
+}
+
+function subsetToIndices(subset: number, size: number, offset: number): number[] {
+  const result: number[] = [];
+  for (let index = 0; index < size; index += 1) {
+    if ((subset & (1 << index)) !== 0) {
+      result.push(offset + index);
+    }
+  }
+  return result;
+}
+
+function compareNumberArrays(valuesA: number[], valuesB: number[]): number {
+  const limit = Math.min(valuesA.length, valuesB.length);
+  for (let index = 0; index < limit; index += 1) {
+    if (valuesA[index] !== valuesB[index]) {
+      return valuesA[index] - valuesB[index];
+    }
+  }
+  return valuesA.length - valuesB.length;
+}
+
+function popcountNumber(value: number): number {
+  let current = value >>> 0;
+  let count = 0;
+  while (current !== 0) {
+    current &= current - 1;
+    count += 1;
+  }
+  return count;
+}
+
+function counterButtonToDenseColumn(
+  button: number[],
+  counterCount: number,
+  modulus: number,
+): number[] {
+  const column = new Array<number>(counterCount).fill(0);
+  for (const rawIndex of button) {
+    if (rawIndex < 0 || rawIndex >= counterCount) {
+      continue;
+    }
+    column[rawIndex] = mod(column[rawIndex] + 1, modulus);
+  }
+  return column;
+}
+
+function denseToSparse(column: number[]): Array<[number, number]> {
+  const result: Array<[number, number]> = [];
+  for (let row = 0; row < column.length; row += 1) {
+    if (column[row] !== 0) {
+      result.push([row, column[row]]);
+    }
+  }
+  return result;
+}
+
+function buildRowMatrix(
+  columns: number[][],
+  rowCount: number,
+  columnCount: number,
+): number[][] {
+  const matrix = new Array<number[]>(rowCount);
+  for (let row = 0; row < rowCount; row += 1) {
+    matrix[row] = new Array<number>(columnCount).fill(0);
+  }
+  for (let column = 0; column < columnCount; column += 1) {
+    for (let row = 0; row < rowCount; row += 1) {
+      matrix[row][column] = columns[column][row];
+    }
+  }
+  return matrix;
+}
+
+function gaussianElimination(
+  matrix: number[][],
+  rhs: number[],
+  modulus: number,
+): RrefResult {
+  const rows = matrix.length;
+  const cols = rows === 0 ? 0 : matrix[0].length;
+  const workingMatrix = matrix.map((row) => row.slice());
+  const workingRhs = rhs.slice();
+  const pivotCols: number[] = [];
+
+  let pivotRow = 0;
+  for (let column = 0; column < cols && pivotRow < rows; column += 1) {
+    let foundRow = -1;
+    for (let row = pivotRow; row < rows; row += 1) {
+      if (workingMatrix[row][column] !== 0) {
+        foundRow = row;
+        break;
+      }
+    }
+    if (foundRow === -1) {
+      continue;
+    }
+
+    if (foundRow !== pivotRow) {
+      [workingMatrix[pivotRow], workingMatrix[foundRow]] = [
+        workingMatrix[foundRow],
+        workingMatrix[pivotRow],
+      ];
+      [workingRhs[pivotRow], workingRhs[foundRow]] = [
+        workingRhs[foundRow],
+        workingRhs[pivotRow],
+      ];
+    }
+
+    const inverse = modInverse(workingMatrix[pivotRow][column], modulus);
+    for (let currentColumn = column; currentColumn < cols; currentColumn += 1) {
+      workingMatrix[pivotRow][currentColumn] = mod(
+        workingMatrix[pivotRow][currentColumn] * inverse,
+        modulus,
+      );
+    }
+    workingRhs[pivotRow] = mod(workingRhs[pivotRow] * inverse, modulus);
+
+    for (let row = 0; row < rows; row += 1) {
+      if (row === pivotRow || workingMatrix[row][column] === 0) {
+        continue;
+      }
+      const factor = workingMatrix[row][column];
+      for (let currentColumn = column; currentColumn < cols; currentColumn += 1) {
+        workingMatrix[row][currentColumn] = mod(
+          workingMatrix[row][currentColumn] -
+            factor * workingMatrix[pivotRow][currentColumn],
+          modulus,
+        );
+      }
+      workingRhs[row] = mod(workingRhs[row] - factor * workingRhs[pivotRow], modulus);
+    }
+
+    pivotCols.push(column);
+    pivotRow += 1;
+  }
+
+  for (let row = pivotRow; row < rows; row += 1) {
+    let allZero = true;
+    for (let column = 0; column < cols; column += 1) {
+      if (workingMatrix[row][column] !== 0) {
+        allZero = false;
+        break;
+      }
+    }
+    if (allZero && workingRhs[row] !== 0) {
+      return {
+        consistent: false,
+        matrix: workingMatrix,
+        rhs: workingRhs,
+        pivotCols,
+        freeCols: [],
+      };
+    }
+  }
+
+  const pivotSet = new Set(pivotCols);
+  const freeCols: number[] = [];
+  for (let column = 0; column < cols; column += 1) {
+    if (!pivotSet.has(column)) {
+      freeCols.push(column);
+    }
+  }
+
+  return {
+    consistent: true,
+    matrix: workingMatrix,
+    rhs: workingRhs,
+    pivotCols,
+    freeCols,
+  };
+}
+
+function buildParticularSolution(rref: RrefResult, variableCount: number): number[] {
+  const solution = new Array<number>(variableCount).fill(0);
+  for (let row = 0; row < rref.pivotCols.length; row += 1) {
+    solution[rref.pivotCols[row]] = rref.rhs[row];
+  }
+  return solution;
+}
+
+function buildNullspaceBasis(
+  rref: RrefResult,
+  variableCount: number,
+  modulus: number,
+): number[][] {
+  const basis: number[][] = [];
+  for (const freeColumn of rref.freeCols) {
+    const vector = new Array<number>(variableCount).fill(0);
+    vector[freeColumn] = 1;
+    for (let row = 0; row < rref.pivotCols.length; row += 1) {
+      vector[rref.pivotCols[row]] = mod(-rref.matrix[row][freeColumn], modulus);
+    }
+    basis.push(vector);
+  }
+  return basis;
+}
+
+function improveSolutionLocally(
+  start: number[],
+  nullspace: number[][],
+  initialCost: number,
+  modulus: number,
+): { solution: number[]; cost: number } {
+  const solution = start.slice();
+  let bestCost = initialCost;
+  let improved = true;
+
+  while (improved) {
+    improved = false;
+    for (const direction of nullspace) {
+      let localBestShift = 0;
+      let localBestCost = bestCost;
+
+      for (let shift = 1; shift < modulus; shift += 1) {
+        const candidateCost = shiftedCost(solution, direction, shift, modulus);
+        if (candidateCost < localBestCost) {
+          localBestCost = candidateCost;
+          localBestShift = shift;
+        }
+      }
+
+      if (localBestShift !== 0) {
+        applyShift(solution, direction, localBestShift, modulus);
+        bestCost = localBestCost;
+        improved = true;
+      }
+    }
+  }
+
+  return { solution, cost: bestCost };
+}
+
+function shiftedCost(
+  base: number[],
+  direction: number[],
+  shift: number,
+  modulus: number,
+): number {
+  let total = 0;
+  for (let index = 0; index < base.length; index += 1) {
+    total += mod(base[index] + shift * direction[index], modulus);
+  }
+  return total;
+}
+
+function applyShift(
+  base: number[],
+  direction: number[],
+  shift: number,
+  modulus: number,
+): void {
+  for (let index = 0; index < base.length; index += 1) {
+    base[index] = mod(base[index] + shift * direction[index], modulus);
+  }
+}
+
+function buildSuffixBases(
+  columns: number[][],
+  rowCount: number,
+  modulus: number,
+): Array<Array<{ pivot: number; vector: number[] }>> {
+  const result: Array<Array<{ pivot: number; vector: number[] }>> = new Array(
+    columns.length + 1,
+  );
+  result[columns.length] = [];
+
+  for (let index = columns.length - 1; index >= 0; index -= 1) {
+    const basis = result[index + 1].map((entry) => ({
+      pivot: entry.pivot,
+      vector: entry.vector.slice(),
+    }));
+    addVectorToBasis(basis, columns[index], modulus, rowCount);
+    result[index] = basis;
+  }
+
+  return result;
+}
+
+function addVectorToBasis(
+  basis: Array<{ pivot: number; vector: number[] }>,
+  input: number[],
+  modulus: number,
+  rowCount: number,
+): void {
+  const vector = input.slice();
+
+  for (const entry of basis) {
+    if (vector[entry.pivot] === 0) {
+      continue;
+    }
+    const factor = vector[entry.pivot];
+    for (let row = entry.pivot; row < rowCount; row += 1) {
+      vector[row] = mod(vector[row] - factor * entry.vector[row], modulus);
+    }
+  }
+
+  let pivot = -1;
+  for (let row = 0; row < rowCount; row += 1) {
+    if (vector[row] !== 0) {
+      pivot = row;
+      break;
+    }
+  }
+
+  if (pivot === -1) {
+    return;
+  }
+
+  const inverse = modInverse(vector[pivot], modulus);
+  for (let row = pivot; row < rowCount; row += 1) {
+    vector[row] = mod(vector[row] * inverse, modulus);
+  }
+
+  for (const entry of basis) {
+    if (entry.vector[pivot] === 0) {
+      continue;
+    }
+    const factor = entry.vector[pivot];
+    for (let row = pivot; row < rowCount; row += 1) {
+      entry.vector[row] = mod(entry.vector[row] - factor * vector[row], modulus);
+    }
+  }
+
+  basis.push({ pivot, vector });
+  basis.sort((left, right) => left.pivot - right.pivot);
+}
+
+function vectorInSpan(
+  target: number[],
+  basis: Array<{ pivot: number; vector: number[] }>,
+  modulus: number,
+): boolean {
+  const residual = target.slice();
+  for (const entry of basis) {
+    if (residual[entry.pivot] === 0) {
+      continue;
+    }
+    const factor = residual[entry.pivot];
+    for (let row = entry.pivot; row < residual.length; row += 1) {
+      residual[row] = mod(residual[row] - factor * entry.vector[row], modulus);
+    }
+  }
+  return residual.every((value) => value === 0);
+}
+
+function buildSuffixMaxWeights(weights: number[]): number[] {
+  const result = new Array<number>(weights.length + 1).fill(0);
+  for (let index = weights.length - 1; index >= 0; index -= 1) {
+    result[index] = Math.max(result[index + 1], weights[index]);
+  }
+  return result;
+}
+
+function searchMinimumCounterCost(
+  columns: Array<Array<[number, number]>>,
+  target: number[],
+  suffixBases: Array<Array<{ pivot: number; vector: number[] }>>,
+  suffixMaxButtonWeight: number[],
+  modulus: number,
+  initialBest: number,
+): number {
+  let best = initialBest;
+
+  const dfs = (index: number, currentCost: number, residual: number[]): void => {
+    if (currentCost >= best) {
+      return;
+    }
+
+    if (!vectorInSpan(residual, suffixBases[index], modulus)) {
+      return;
+    }
+
+    const lowerBound = lowerBoundPresses(
+      residual,
+      suffixMaxButtonWeight[index],
+    );
+    if (currentCost + lowerBound >= best) {
+      return;
+    }
+
+    if (index === columns.length) {
+      if (isZeroVector(residual)) {
+        best = currentCost;
+      }
+      return;
+    }
+
+    const remainingBudget = best - currentCost - 1;
+    const maxPresses = Math.min(modulus - 1, remainingBudget);
+    const column = columns[index];
+    const nextResidual = residual.slice();
+
+    for (let presses = 0; presses <= maxPresses; presses += 1) {
+      dfs(index + 1, currentCost + presses, nextResidual);
+      if (presses !== maxPresses) {
+        subtractSparseColumn(nextResidual, column, modulus);
+      }
+    }
+  };
+
+  dfs(0, 0, target.slice());
+  return best;
+}
+
+function searchLexicographicCounterSolution(
+  columns: Array<Array<[number, number]>>,
+  target: number[],
+  suffixBases: Array<Array<{ pivot: number; vector: number[] }>>,
+  suffixMaxButtonWeight: number[],
+  modulus: number,
+  exactCost: number,
+): number[] | null {
+  const assignment = new Array<number>(columns.length).fill(0);
+
+  const dfs = (index: number, currentCost: number, residual: number[]): boolean => {
+    if (!vectorInSpan(residual, suffixBases[index], modulus)) {
+      return false;
+    }
+
+    const lowerBound = lowerBoundPresses(
+      residual,
+      suffixMaxButtonWeight[index],
+    );
+    if (currentCost + lowerBound > exactCost) {
+      return false;
+    }
+
+    if (index === columns.length) {
+      return currentCost === exactCost && isZeroVector(residual);
+    }
+
+    const maxPresses = Math.min(modulus - 1, exactCost - currentCost);
+    const column = columns[index];
+    const nextResidual = residual.slice();
+
+    for (let presses = 0; presses <= maxPresses; presses += 1) {
+      assignment[index] = presses;
+      if (dfs(index + 1, currentCost + presses, nextResidual)) {
+        return true;
+      }
+      if (presses !== maxPresses) {
+        subtractSparseColumn(nextResidual, column, modulus);
+      }
+    }
+
+    return false;
+  };
+
+  return dfs(0, 0, target.slice()) ? assignment : null;
+}
+
+function subtractSparseColumn(
+  residual: number[],
+  column: Array<[number, number]>,
+  modulus: number,
+): void {
+  for (const [row, value] of column) {
