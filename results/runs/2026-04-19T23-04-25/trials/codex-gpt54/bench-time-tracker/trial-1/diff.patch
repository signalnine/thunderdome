new file mode 100644
index 0000000..b5689e0
--- /dev/null
+++ b/src/time-tracker.test.ts
@@ -0,0 +1,119 @@
+import { mkdtemp, readFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+
+import { describe, expect, it } from 'vitest';
+
+import { TimeTracker } from './time-tracker.js';
+
+function createClock(seed: string) {
+  let current = new Date(seed);
+
+  return {
+    now: () => new Date(current),
+    set: (value: string) => {
+      current = new Date(value);
+    },
+  };
+}
+
+describe('TimeTracker', () => {
+  it('creates parent directories and persists entries to disk', async () => {
+    const dir = await mkdtemp(join(tmpdir(), 'time-tracker-'));
+    const filePath = join(dir, 'nested', 'tracker.json');
+    const clock = createClock('2026-04-19T10:00:00.000Z');
+    const tracker = new TimeTracker({ filePath, now: clock.now });
+
+    await tracker.start('Write docs');
+    clock.set('2026-04-19T10:30:00.000Z');
+    await tracker.stop();
+
+    const raw = await readFile(filePath, 'utf8');
+
+    expect(JSON.parse(raw)).toEqual({
+      entries: [
+        {
+          taskName: 'Write docs',
+          startTime: '2026-04-19T10:00:00.000Z',
+          endTime: '2026-04-19T10:30:00.000Z',
+        },
+      ],
+    });
+  });
+
+  it('automatically stops the previous timer when a new one starts', async () => {
+    const dir = await mkdtemp(join(tmpdir(), 'time-tracker-'));
+    const filePath = join(dir, 'tracker.json');
+    const clock = createClock('2026-04-19T09:00:00.000Z');
+    const tracker = new TimeTracker({ filePath, now: clock.now });
