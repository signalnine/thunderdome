+      startTime: new Date('2026-04-19T09:00:00.000Z'),
+      endTime: new Date('2026-04-19T09:15:00.000Z'),
+    });
+    expect(entries[1]).toMatchObject({
+      taskName: 'Task B',
+      startTime: new Date('2026-04-19T09:15:00.000Z'),
+      endTime: null,
+    });
+  });
+
+  it('filters entries by start date range and summarizes duplicate task names', async () => {
+    const dir = await mkdtemp(join(tmpdir(), 'time-tracker-'));
+    const filePath = join(dir, 'tracker.json');
+    const clock = createClock('2026-04-18T23:50:00.000Z');
+    const tracker = new TimeTracker({ filePath, now: clock.now });
+
+    await tracker.start('Deep Work');
+    clock.set('2026-04-19T00:20:00.000Z');
+    await tracker.stop();
+    await tracker.start('メール返信 📬');
+    clock.set('2026-04-19T00:50:00.000Z');
+    await tracker.stop();
+    await tracker.start('Deep Work');
+    clock.set('2026-04-19T01:35:00.000Z');
+    await tracker.stop();
+
+    const entries = await tracker.getEntries({
+      start: new Date('2026-04-19T00:00:00.000Z'),
+      end: new Date('2026-04-19T23:59:59.999Z'),
+    });
+    const summary = await tracker.getSummary();
+
+    expect(entries).toHaveLength(2);
+    expect(entries.map((entry) => entry.taskName)).toEqual(['メール返信 📬', 'Deep Work']);
+    expect(summary).toEqual({
+      'Deep Work': 4500000,
+      'メール返信 📬': 1800000,
+    });
+  });
+
+  it('uses the current time when summarizing a running task', async () => {
+    const dir = await mkdtemp(join(tmpdir(), 'time-tracker-'));
+    const filePath = join(dir, 'tracker.json');
+    const clock = createClock('2026-04-19T12:00:00.000Z');
+    const tracker = new TimeTracker({ filePath, now: clock.now });
+
+    await tracker.start('Focus');
+    clock.set('2026-04-19T12:45:00.000Z');
+
+    await expect(tracker.getSummary()).resolves.toEqual({ Focus: 2700000 });
+  });
+
+  it('throws on empty task names and when stopping with no running timer', async () => {
+    const dir = await mkdtemp(join(tmpdir(), 'time-tracker-'));
+    const filePath = join(dir, 'tracker.json');
+    const tracker = new TimeTracker({ filePath });
+
+    await expect(tracker.start('   ')).rejects.toThrow('Task name cannot be empty.');
+    await expect(tracker.stop()).rejects.toThrow('No timer is currently running.');
+  });
+});
diff --git a/src/time-tracker.ts b/src/time-tracker.ts
new file mode 100644
index 0000000..016374d
--- /dev/null
+++ b/src/time-tracker.ts
@@ -0,0 +1,198 @@
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { dirname } from 'node:path';
+
+export interface TimeEntry {
+  taskName: string;
+  startTime: Date;
+  endTime: Date | null;
+}
+
+export interface TimeEntryFilter {
+  start?: Date;
+  end?: Date;
+}
+
+export interface TimeTrackerOptions {
+  filePath: string;
+  now?: () => Date;
+}
+
+interface StoredTimeEntry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+interface TrackerData {
+  entries: StoredTimeEntry[];
+}
+
+const EMPTY_DATA: TrackerData = { entries: [] };
+
+export class TimeTracker {
+  private readonly filePath: string;
+  private readonly now: () => Date;
+
+  public constructor(options: TimeTrackerOptions) {
+    this.filePath = options.filePath;
+    this.now = options.now ?? (() => new Date());
+  }
+
+  public async start(taskName: string): Promise<TimeEntry> {
+    if (taskName.trim().length === 0) {
+      throw new Error('Task name cannot be empty.');
+    }
+
+    return this.withData(async (data) => {
+      const timestamp = this.now();
+      const activeEntry = this.findRunningEntry(data.entries);
+
+      if (activeEntry !== undefined) {
+        activeEntry.endTime = timestamp.toISOString();
+      }
+
+      const newEntry: StoredTimeEntry = {
+        taskName,
+        startTime: timestamp.toISOString(),
+        endTime: null,
+      };
+
+      data.entries.push(newEntry);
+
+      return this.toEntry(newEntry);
+    });
+  }
+
+  public async stop(): Promise<TimeEntry> {
+    return this.withData(async (data) => {
+      const activeEntry = this.findRunningEntry(data.entries);
+
+      if (activeEntry === undefined) {
+        throw new Error('No timer is currently running.');
+      }
+
+      activeEntry.endTime = this.now().toISOString();
+
+      return this.toEntry(activeEntry);
+    });
+  }
+
+  public async getEntries(filter?: TimeEntryFilter): Promise<TimeEntry[]> {
+    const data = await this.loadData();
+    const entries = data.entries.map((entry) => this.toEntry(entry));
+
+    return entries.filter((entry) => this.matchesFilter(entry, filter));
+  }
+
+  public async getSummary(filter?: TimeEntryFilter): Promise<Record<string, number>> {
+    const now = this.now();
+    const entries = await this.getEntries(filter);
+
+    return entries.reduce<Record<string, number>>((summary, entry) => {
+      const endTime = entry.endTime ?? now;
+      const duration = Math.max(0, endTime.getTime() - entry.startTime.getTime());
+
+      summary[entry.taskName] = (summary[entry.taskName] ?? 0) + duration;
+
+      return summary;
+    }, {});
+  }
+
+  private async withData<T>(operation: (data: TrackerData) => Promise<T> | T): Promise<T> {
+    const data = await this.loadData();
+    const result = await operation(data);
+
+    await this.saveData(data);
+
+    return result;
+  }
+
+  private async loadData(): Promise<TrackerData> {
+    await this.ensureStorageFile();
+
+    const raw = await readFile(this.filePath, 'utf8');
+
+    if (raw.trim().length === 0) {
+      return { entries: [] };
+    }
+
+    const parsed = JSON.parse(raw) as Partial<TrackerData>;
+    const entries = parsed.entries;
+
+    if (!Array.isArray(entries)) {
+      throw new Error('Invalid time tracker data file.');
+    }
+
+    return {
+      entries: entries.map((entry) => this.validateStoredEntry(entry)),
+    };
+  }
+
+  private async saveData(data: TrackerData): Promise<void> {
+    await writeFile(this.filePath, JSON.stringify(data, null, 2), 'utf8');
+  }
+
+  private async ensureStorageFile(): Promise<void> {
+    await mkdir(dirname(this.filePath), { recursive: true });
+
+    try {
+      await readFile(this.filePath, 'utf8');
+    } catch (error: unknown) {
+      if (!this.isMissingFileError(error)) {
+        throw error;
+      }
+
+      await writeFile(this.filePath, JSON.stringify(EMPTY_DATA, null, 2), 'utf8');
+    }
+  }
+
+  private isMissingFileError(error: unknown): error is NodeJS.ErrnoException {
+    return error instanceof Error && 'code' in error && error.code === 'ENOENT';
+  }
+
+  private validateStoredEntry(entry: unknown): StoredTimeEntry {
+    if (typeof entry !== 'object' || entry === null) {
+      throw new Error('Invalid time tracker entry.');
+    }
+
+    const candidate = entry as Partial<StoredTimeEntry>;
+
+    if (
+      typeof candidate.taskName !== 'string' ||
+      typeof candidate.startTime !== 'string' ||
+      (candidate.endTime !== null && typeof candidate.endTime !== 'string')
+    ) {
+      throw new Error('Invalid time tracker entry.');
+    }
+
+    return {
+      taskName: candidate.taskName,
+      startTime: candidate.startTime,
+      endTime: candidate.endTime,
+    };
+  }
+
+  private findRunningEntry(entries: StoredTimeEntry[]): StoredTimeEntry | undefined {
+    return [...entries].reverse().find((entry) => entry.endTime === null);
+  }
+
+  private toEntry(entry: StoredTimeEntry): TimeEntry {
+    return {
+      taskName: entry.taskName,
+      startTime: new Date(entry.startTime),
+      endTime: entry.endTime === null ? null : new Date(entry.endTime),
+    };
+  }
+
+  private matchesFilter(entry: TimeEntry, filter?: TimeEntryFilter): boolean {
+    if (filter?.start !== undefined && entry.startTime < filter.start) {
+      return false;
+    }
+
+    if (filter?.end !== undefined && entry.startTime > filter.end) {
+      return false;
+    }
+
+    return true;
+  }
+}
