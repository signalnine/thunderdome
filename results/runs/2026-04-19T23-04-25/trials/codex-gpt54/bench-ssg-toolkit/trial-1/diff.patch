+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { escapeXml, normalizeBaseUrl } from './utils.js';
+
+function toTimestamp(file: ContentFile): number {
+  if (!file.date) {
+    return Number.NEGATIVE_INFINITY;
+  }
+
+  const timestamp = Date.parse(file.date);
+  return Number.isNaN(timestamp) ? Number.NEGATIVE_INFINITY : timestamp;
+}
+
+function toCdata(value: string): string {
+  return value.replace(/]]>/g, ']]]]><![CDATA[>');
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext) => {
+        const baseUrl = normalizeBaseUrl(ctx.config.baseUrl);
+        const items = [...ctx.files]
+          .sort((a, b) => toTimestamp(b) - toTimestamp(a))
+          .map((file) => {
+            const itemUrl = `${baseUrl}/${file.slug}.html`;
+            const categories = (file.tags ?? [])
+              .map((tag) => `<category>${escapeXml(tag.toLowerCase())}</category>`)
+              .join('');
+            const pubDate = file.date && !Number.isNaN(Date.parse(file.date))
+              ? `<pubDate>${new Date(file.date).toUTCString()}</pubDate>`
+              : '';
+
+            return `<item><title>${escapeXml(file.title)}</title><link>${escapeXml(itemUrl)}</link><guid>${escapeXml(itemUrl)}</guid>${pubDate}${categories}<description><![CDATA[${toCdata(file.content)}]]></description></item>`;
+          })
+          .join('');
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+<channel>
+<title>${escapeXml(ctx.config.title)}</title>
+<link>${escapeXml(baseUrl)}</link>
+<description>${escapeXml(ctx.config.title)}</description>
+${items}
+</channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
+
