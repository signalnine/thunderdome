+import { BuildContext, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+interface DevServerRoute {
+  path: string;
+  handler: string;
+}
+
+interface DevServerConfig {
+  port: number;
+  routes: DevServerRoute[];
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild: (ctx: BuildContext) => {
+        const manifest = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+        const assetPaths = manifest?.assets ?? [];
+        const routes: DevServerRoute[] = [];
+
+        for (const path of ctx.output.keys()) {
+          if (path.endsWith('.html')) {
+            routes.push({ path: `/${path}`, handler: 'static' });
+          }
+        }
+
+        for (const assetPath of assetPaths) {
+          routes.push({ path: `/assets/${assetPath}`, handler: 'asset' });
+        }
+
+        const config: DevServerConfig = {
+          port: 3000,
+          routes,
+          assetPaths,
+          searchIndexPath: ctx.output.has('search-index.json') ? '/search-index.json' : '',
+        };
+
+        ctx.data.set('dev-server-config', config);
+        ctx.output.set('dev-server.json', JSON.stringify(config, null, 2));
+      },
+    },
+  };
+}
+
