+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+function getAssetManifest(ctx: BuildContext): AssetManifest {
+  const existing = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+  if (existing) {
+    return existing;
+  }
+
+  const manifest: AssetManifest = { assets: [] };
+  ctx.data.set('asset-manifest', manifest);
+  return manifest;
+}
+
+function addAsset(ctx: BuildContext, assetPath: string): void {
+  const manifest = getAssetManifest(ctx);
+  if (!manifest.assets.includes(assetPath)) {
+    manifest.assets.push(assetPath);
+  }
+}
+
+function rewriteAssetUrl(url: string): string {
+  const normalized = url.replace(/^\.?\//, '').replace(/^(\.\.\/)+/, '');
+  return `/assets/${normalized}`;
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext) => {
+        const content = file.content.replace(
+          /\b(src|href)="([^"]+)"/g,
+          (match, attribute: string, url: string) => {
+            if (!/^(?:\.\/|\.\.\/)/.test(url)) {
+              return match;
+            }
+
+            const assetPath = url.replace(/^\.?\//, '').replace(/^(\.\.\/)+/, '');
+            addAsset(ctx, assetPath);
+            return `${attribute}="${rewriteAssetUrl(url)}"`;
+          },
+        );
+
+        return {
+          ...file,
+          content,
+        };
+      },
+      afterBuild: (ctx: BuildContext) => {
+        const manifest = getAssetManifest(ctx);
+        ctx.output.set('asset-manifest.json', JSON.stringify(manifest, null, 2));
+      },
+    },
+  };
+}
+
