+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { renderTaxonomyPage, toTaxonomySlug } from './utils.js';
+
+type TaxonomyMap = Map<string, ContentFile[]>;
+
+function addToMap(map: TaxonomyMap, key: string, file: ContentFile): void {
+  const normalizedKey = key.trim().toLowerCase();
+  if (!normalizedKey) {
+    return;
+  }
+
+  const files = map.get(normalizedKey) ?? [];
+  files.push(file);
+  map.set(normalizedKey, files);
+}
+
+function getCategoryValues(file: ContentFile): string[] {
+  const category = file.metadata.category;
+  const categories = file.metadata.categories;
+  const values: string[] = [];
+
+  if (typeof category === 'string') {
+    values.push(category);
+  }
+
+  if (Array.isArray(categories)) {
+    values.push(...categories.filter((item): item is string => typeof item === 'string'));
+  }
+
+  return values;
+}
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild: (ctx: BuildContext) => {
+        const tagMap: TaxonomyMap = new Map();
+        const categoryMap: TaxonomyMap = new Map();
+
+        for (const file of ctx.files) {
+          for (const tag of file.tags ?? []) {
+            addToMap(tagMap, tag, file);
+          }
+
+          for (const category of getCategoryValues(file)) {
+            addToMap(categoryMap, category, file);
+          }
+        }
+
+        ctx.data.set('taxonomy-tags', tagMap);
+        ctx.data.set('taxonomy-categories', categoryMap);
+      },
+      afterBuild: (ctx: BuildContext) => {
+        const tagMap = (ctx.data.get('taxonomy-tags') as TaxonomyMap | undefined) ?? new Map();
+        const categoryMap = (ctx.data.get('taxonomy-categories') as TaxonomyMap | undefined) ?? new Map();
+
+        for (const [tag, files] of tagMap.entries()) {
+          ctx.output.set(
+            `tags/${toTaxonomySlug(tag)}.html`,
+            renderTaxonomyPage('Tag', tag, files, ctx.config.title),
+          );
+        }
+
+        for (const [category, files] of categoryMap.entries()) {
+          ctx.output.set(
+            `categories/${toTaxonomySlug(category)}.html`,
+            renderTaxonomyPage('Category', category, files, ctx.config.title),
+          );
+        }
+      },
+    },
+  };
+}
+
diff --git a/src/plugins/utils.ts b/src/plugins/utils.ts
new file mode 100644
index 0000000..efdfaaf
--- /dev/null
+++ b/src/plugins/utils.ts
@@ -0,0 +1,61 @@
+import { ContentFile } from '../core/types.js';
+
+export function normalizeBaseUrl(baseUrl: string): string {
+  return baseUrl.replace(/\/+$/, '');
+}
+
+export function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+export function escapeXml(value: string): string {
+  return escapeHtml(value);
+}
+
+export function stripHtml(value: string): string {
+  return value
+    .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, ' ')
+    .replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, ' ')
+    .replace(/<[^>]+>/g, ' ')
+    .replace(/&nbsp;/g, ' ')
+    .replace(/&amp;/g, '&')
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;/g, '\'')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+export function toTaxonomySlug(value: string): string {
+  return value.trim().toLowerCase().replace(/\s+/g, '-');
+}
+
+export function renderTaxonomyPage(
+  label: string,
+  value: string,
+  files: ContentFile[],
+  siteTitle: string,
+): string {
+  const items = files
+    .map((file) => `<li><a href="/${escapeHtml(file.slug)}.html">${escapeHtml(file.title)}</a></li>`)
+    .join('');
+
+  return `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>${escapeHtml(label)}: ${escapeHtml(value)} | ${escapeHtml(siteTitle)}</title>
+</head>
+<body>
+  <h1>${escapeHtml(label)}: ${escapeHtml(value)}</h1>
+  <ul>${items}</ul>
+</body>
+</html>`;
+}
+
