+import { BuildContext, Plugin } from '../core/types.js';
+import { stripHtml } from './utils.js';
+
+interface SearchIndexEntry {
+  slug: string;
+  title: string;
+  content: string;
+  tags?: string[];
+}
+
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild: (ctx: BuildContext) => {
+        const index: SearchIndexEntry[] = ctx.files.map((file) => ({
+          slug: file.slug,
+          title: file.title,
+          content: stripHtml(file.content),
+          ...(file.tags && file.tags.length > 0 ? { tags: file.tags } : {}),
+        }));
+
+        ctx.output.set('search-index.json', JSON.stringify(index, null, 2));
+      },
+    },
+  };
+}
