@@ -0,0 +1,90 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+type Footnotes = Map<string, string>;
+
+function renderInline(content: string): string {
+  return content
+    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
+    .replace(/\[\^([^\]]+)\]/g, '<sup><a href="#fn-$1">$1</a></sup>');
+}
+
+function renderBlocks(markdown: string): string {
+  const blocks = markdown
+    .split(/\n\s*\n/)
+    .map((block) => block.trim())
+    .filter(Boolean);
+
+  return blocks.map((block) => renderBlock(block)).join('\n');
+}
+
+function renderBlock(block: string): string {
+  if (block.startsWith('<')) {
+    return block;
+  }
+
+  const headingMatch = block.match(/^(#{1,6})\s+([^\n]+)$/);
+  if (headingMatch) {
+    const level = headingMatch[1].length;
+    return `<h${level}>${renderInline(headingMatch[2].trim())}</h${level}>`;
+  }
+
+  return `<p>${renderInline(block.replace(/\n+/g, ' ').trim())}</p>`;
+}
+
+function extractFootnotes(markdown: string): { content: string; footnotes: Footnotes } {
+  const footnotes: Footnotes = new Map();
+  const content = markdown.replace(/^\[\^([^\]]+)\]:\s*(.+)$/gm, (_match, id: string, note: string) => {
+    footnotes.set(id, renderInline(note.trim()));
+    return '';
+  });
+
+  return { content, footnotes };
+}
+
+function renderAdmonitions(markdown: string): string {
+  return markdown.replace(
+    /^:::(note|warning|tip)\n([\s\S]*?)\n:::(?=\n|$)/gm,
+    (_match, type: string, body: string) => {
+      const renderedBody = renderBlocks(body.trim());
+      return `<div class="admonition admonition-${type}">\n${renderedBody}\n</div>`;
+    },
+  );
+}
+
+function renderFootnotes(footnotes: Footnotes): string {
+  if (footnotes.size === 0) {
+    return '';
+  }
+
+  const items = [...footnotes.entries()]
+    .map(([id, note]) => `<li id="fn-${id}">${note}</li>`)
+    .join('');
+
+  return `\n<section class="footnotes"><ol>${items}</ol></section>`;
+}
+
+function renderMarkdown(content: string): string {
+  if (!content.trim()) {
+    return '';
+  }
+
+  const { content: withoutFootnotes, footnotes } = extractFootnotes(content.replace(/\r\n/g, '\n'));
+  const withAdmonitions = renderAdmonitions(withoutFootnotes).trim();
+  const html = renderBlocks(withAdmonitions);
+  return `${html}${renderFootnotes(footnotes)}`;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile) => ({
+        ...file,
+        content: renderMarkdown(file.content),
+      }),
+    },
+  };
+}
+
