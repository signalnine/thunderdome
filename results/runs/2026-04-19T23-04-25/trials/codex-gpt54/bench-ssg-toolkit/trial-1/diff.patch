+import { ContentFile, Plugin } from '../core/types.js';
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile) => ({
+        ...file,
+        content: file.content.replace(
+          /<pre([^>]*)><code([^>]*)class="([^"]*\blanguage-([a-z0-9_-]+)\b[^"]*)"([^>]*)>/gi,
+          (_match, preAttrs: string, beforeClassAttrs: string, classValue: string, language: string, afterClassAttrs: string) => {
+            const highlightedClass = /\bhighlighted\b/.test(classValue)
+              ? classValue
+              : `${classValue} highlighted`;
+            const normalizedPreAttrs = /\bdata-language=/.test(preAttrs)
+              ? preAttrs
+              : `${preAttrs} data-language="${language}"`;
+
+            return `<pre${normalizedPreAttrs}><code${beforeClassAttrs}class="${highlightedClass}"${afterClassAttrs}>`;
+          },
+        ),
+      }),
+    },
+  };
+}
+
