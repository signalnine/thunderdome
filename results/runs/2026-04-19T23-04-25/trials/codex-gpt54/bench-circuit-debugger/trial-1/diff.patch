+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+type Op = Gate['op'];
+
+interface SearchState {
+  gates: Gate[];
+  swaps: string[];
+}
+
+function zWire(bit: number): string {
+  return `z${String(bit).padStart(2, '0')}`;
+}
+
+function applyOp(op: Op, a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+  }
+}
+
+function normalizePair(a: string, b: string): string {
+  return a < b ? `${a}|${b}` : `${b}|${a}`;
+}
+
+function buildTopologicalOrder(gates: Gate[]): number[] {
+  const producer = new Map<string, number>();
+  for (let i = 0; i < gates.length; i += 1) {
+    producer.set(gates[i].out, i);
+  }
+
+  const indegree = new Array<number>(gates.length).fill(0);
+  const consumers = Array.from({ length: gates.length }, () => [] as number[]);
+
+  for (let i = 0; i < gates.length; i += 1) {
+    for (const input of [gates[i].in1, gates[i].in2]) {
+      const source = producer.get(input);
+      if (source !== undefined) {
+        indegree[i] += 1;
+        consumers[source].push(i);
+      }
+    }
+  }
+
+  const queue: number[] = [];
+  for (let i = 0; i < indegree.length; i += 1) {
+    if (indegree[i] === 0) {
+      queue.push(i);
+    }
+  }
+
+  const order: number[] = [];
+  for (let cursor = 0; cursor < queue.length; cursor += 1) {
+    const gateIndex = queue[cursor];
+    order.push(gateIndex);
+
+    for (const consumer of consumers[gateIndex]) {
+      indegree[consumer] -= 1;
+      if (indegree[consumer] === 0) {
+        queue.push(consumer);
+      }
+    }
+  }
+
+  if (order.length !== gates.length) {
+    throw new Error('Circuit must be acyclic.');
+  }
+
+  return order;
+}
+
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values: Record<string, number> = { ...inputs };
+  const order = buildTopologicalOrder(gates);
+
+  for (const index of order) {
+    const gate = gates[index];
+    const a = values[gate.in1];
+    const b = values[gate.in2];
+
+    if (a === undefined || b === undefined) {
+      throw new Error(`Missing input value for gate ${gate.in1} ${gate.op} ${gate.in2} -> ${gate.out}`);
+    }
+
+    values[gate.out] = applyOp(gate.op, a, b);
+  }
+
+  return values;
+}
+
+function maxInputBit(gates: Gate[]): number {
+  let maxBit = -1;
+
+  for (const gate of gates) {
+    for (const wire of [gate.in1, gate.in2, gate.out]) {
+      if ((wire.startsWith('x') || wire.startsWith('y')) && wire.length >= 3) {
+        const bit = Number.parseInt(wire.slice(1), 10);
+        if (!Number.isNaN(bit)) {
+          maxBit = Math.max(maxBit, bit);
+        }
+      }
+    }
+  }
+
+  return maxBit;
+}
+
+function cloneGates(gates: Gate[]): Gate[] {
+  return gates.map((gate) => ({ ...gate }));
+}
+
+function swapOutputs(gates: Gate[], a: number, b: number): void {
+  const temp = gates[a].out;
+  gates[a].out = gates[b].out;
+  gates[b].out = temp;
+}
+
+function producerByWire(gates: Gate[]): Map<string, number> {
+  const map = new Map<string, number>();
+  for (let i = 0; i < gates.length; i += 1) {
+    map.set(gates[i].out, i);
+  }
+  return map;
+}
+
+function gateIndexByOpInputs(gates: Gate[]): Map<string, number> {
+  const map = new Map<string, number>();
+
+  for (let i = 0; i < gates.length; i += 1) {
+    const gate = gates[i];
+    map.set(`${gate.op}:${normalizePair(gate.in1, gate.in2)}`, i);
+  }
+
+  return map;
+}
+
+function findGate(
+  gatesBySignature: Map<string, number>,
+  op: Op,
+  a: string,
+  b: string,
+): number | undefined {
+  return gatesBySignature.get(`${op}:${normalizePair(a, b)}`);
+}
+
+function sharedMateForOps(gates: Gate[], fixedWire: string): string | undefined {
+  const xors = new Set<string>();
+  const ands = new Set<string>();
+
+  for (const gate of gates) {
+    if (gate.in1 !== fixedWire && gate.in2 !== fixedWire) {
+      continue;
+    }
+
+    const other = gate.in1 === fixedWire ? gate.in2 : gate.in1;
+    if (other.startsWith('x') || other.startsWith('y')) {
+      continue;
+    }
+
+    if (gate.op === 'XOR') {
+      xors.add(other);
+    } else if (gate.op === 'AND') {
+      ands.add(other);
+    }
+  }
+
+  for (const candidate of xors) {
+    if (ands.has(candidate)) {
+      return candidate;
+    }
+  }
+
+  return undefined;
+}
+
+function otherInputOfOr(gates: Gate[], fixedWire: string): string | undefined {
+  for (const gate of gates) {
+    if (gate.op !== 'OR') {
+      continue;
+    }
+    if (gate.in1 === fixedWire) {
+      return gate.in2;
+    }
+    if (gate.in2 === fixedWire) {
+      return gate.in1;
+    }
+  }
+
+  return undefined;
+}
+
+function applyCandidateSwap(state: SearchState, gateA: number, gateB: number): SearchState | undefined {
+  if (gateA === gateB) {
+    return undefined;
+  }
+
+  const wireA = state.gates[gateA].out;
+  const wireB = state.gates[gateB].out;
+
+  if (state.swaps.includes(wireA) || state.swaps.includes(wireB)) {
+    return undefined;
+  }
+
+  const nextGates = cloneGates(state.gates);
+  swapOutputs(nextGates, gateA, gateB);
+
+  return {
+    gates: nextGates,
+    swaps: [...state.swaps, wireA, wireB],
+  };
+}
+
+function dedupeStates(states: Array<SearchState | undefined>): SearchState[] {
+  const seen = new Set<string>();
+  const result: SearchState[] = [];
+
+  for (const state of states) {
+    if (state === undefined) {
+      continue;
+    }
+
+    const key = state.swaps.slice().sort().join(',');
+    if (!seen.has(key)) {
+      seen.add(key);
+      result.push(state);
+    }
+  }
+
+  return result;
+}
+
+function solve(state: SearchState, maxBit: number, memo: Set<string>): string[] | undefined {
+  const outputsKey = state.gates.map((gate) => gate.out).join(',');
+  const memoKey = `${outputsKey}::${state.swaps.slice().sort().join(',')}`;
+
+  if (memo.has(memoKey)) {
+    return undefined;
+  }
+  memo.add(memoKey);
+
+  if (state.swaps.length > 8) {
+    return undefined;
+  }
+
+  const gatesBySignature = gateIndexByOpInputs(state.gates);
+  const producers = producerByWire(state.gates);
+
+  const halfSum = findGate(gatesBySignature, 'XOR', 'x00', 'y00');
+  const halfCarry = findGate(gatesBySignature, 'AND', 'x00', 'y00');
+  if (halfSum === undefined || halfCarry === undefined) {
+    return undefined;
+  }
+
+  if (state.gates[halfSum].out !== zWire(0)) {
+    const zProducer = producers.get(zWire(0));
+    if (zProducer === undefined) {
+      return undefined;
+    }
+
+    for (const nextState of dedupeStates([applyCandidateSwap(state, halfSum, zProducer)])) {
+      const result = solve(nextState, maxBit, memo);
+      if (result !== undefined) {
+        return result;
+      }
+    }
+    return undefined;
+  }
+
+  let carryWire = state.gates[halfCarry].out;
+
+  for (let bit = 1; bit <= maxBit; bit += 1) {
+    const xWire = `x${String(bit).padStart(2, '0')}`;
+    const yWire = `y${String(bit).padStart(2, '0')}`;
+    const sumWire = zWire(bit);
+
+    const partialGate = findGate(gatesBySignature, 'XOR', xWire, yWire);
+    const generateGate = findGate(gatesBySignature, 'AND', xWire, yWire);
+    if (partialGate === undefined || generateGate === undefined) {
+      return undefined;
+    }
+
+    const sumGate = findGate(gatesBySignature, 'XOR', state.gates[partialGate].out, carryWire);
+    const propagateGate = findGate(gatesBySignature, 'AND', state.gates[partialGate].out, carryWire);
+
+    if (sumGate === undefined || propagateGate === undefined) {
+      const candidateStates: Array<SearchState | undefined> = [];
+
+      const correctedPartial = sharedMateForOps(state.gates, carryWire);
+      if (correctedPartial !== undefined && correctedPartial !== state.gates[partialGate].out) {
+        const partner = producers.get(correctedPartial);
+        if (partner !== undefined) {
+          candidateStates.push(applyCandidateSwap(state, partialGate, partner));
+        }
+      }
+
+      const correctedCarry = sharedMateForOps(state.gates, state.gates[partialGate].out);
+      if (correctedCarry !== undefined && correctedCarry !== carryWire) {
+        const carryProducer = producers.get(carryWire);
+        const partner = producers.get(correctedCarry);
+        if (carryProducer !== undefined && partner !== undefined) {
+          candidateStates.push(applyCandidateSwap(state, carryProducer, partner));
+        }
+      }
+
+      for (const nextState of dedupeStates(candidateStates)) {
+        const result = solve(nextState, maxBit, memo);
+        if (result !== undefined) {
+          return result;
+        }
+      }
+      return undefined;
+    }
+
+    if (state.gates[sumGate].out !== sumWire) {
+      const zProducer = producers.get(sumWire);
+      if (zProducer === undefined) {
+        return undefined;
+      }
+
+      for (const nextState of dedupeStates([applyCandidateSwap(state, sumGate, zProducer)])) {
+        const result = solve(nextState, maxBit, memo);
+        if (result !== undefined) {
+          return result;
+        }
+      }
+      return undefined;
+    }
+
+    const carryGate = findGate(gatesBySignature, 'OR', state.gates[generateGate].out, state.gates[propagateGate].out);
+
+    if (carryGate === undefined) {
+      const candidateStates: Array<SearchState | undefined> = [];
+
+      const correctedPropagate = otherInputOfOr(state.gates, state.gates[generateGate].out);
+      if (correctedPropagate !== undefined && correctedPropagate !== state.gates[propagateGate].out) {
+        const partner = producers.get(correctedPropagate);
+        if (partner !== undefined) {
+          candidateStates.push(applyCandidateSwap(state, propagateGate, partner));
+        }
+      }
+
+      const correctedGenerate = otherInputOfOr(state.gates, state.gates[propagateGate].out);
+      if (correctedGenerate !== undefined && correctedGenerate !== state.gates[generateGate].out) {
+        const partner = producers.get(correctedGenerate);
+        if (partner !== undefined) {
+          candidateStates.push(applyCandidateSwap(state, generateGate, partner));
+        }
+      }
+
+      for (const nextState of dedupeStates(candidateStates)) {
+        const result = solve(nextState, maxBit, memo);
+        if (result !== undefined) {
+          return result;
+        }
+      }
+      return undefined;
+    }
+
+    carryWire = state.gates[carryGate].out;
+  }
+
+  if (carryWire !== zWire(maxBit + 1)) {
+    const producers = producerByWire(state.gates);
+    const carryProducer = producers.get(carryWire);
+    const zProducer = producers.get(zWire(maxBit + 1));
+    if (carryProducer === undefined || zProducer === undefined) {
+      return undefined;
+    }
+
+    for (const nextState of dedupeStates([applyCandidateSwap(state, carryProducer, zProducer)])) {
+      const result = solve(nextState, maxBit, memo);
+      if (result !== undefined) {
+        return result;
+      }
+    }
+    return undefined;
+  }
+
+  if (state.swaps.length === 8) {
+    return state.swaps.slice().sort();
+  }
+
+  return undefined;
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  const maxBit = maxInputBit(gates);
+  if (maxBit < 0) {
+    return [];
+  }
+
+  const result = solve({ gates: cloneGates(gates), swaps: [] }, maxBit, new Set<string>());
+  if (result === undefined) {
+    throw new Error('Unable to determine swapped wires.');
+  }
+  return result;
+}
