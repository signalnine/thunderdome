@@ -0,0 +1,78 @@
+import { describe, expect, it } from 'vitest';
+
+import { findSwappedWires, simulate, type Gate } from '../src/index.js';
+
+function pad(bit: number): string {
+  return String(bit).padStart(2, '0');
+}
+
+function buildAdder(bits: number): Gate[] {
+  const gates: Gate[] = [];
+
+  for (let bit = 0; bit < bits; bit += 1) {
+    const x = `x${pad(bit)}`;
+    const y = `y${pad(bit)}`;
+
+    if (bit === 0) {
+      gates.push({ op: 'XOR', in1: x, in2: y, out: 'z00' });
+      gates.push({ op: 'AND', in1: x, in2: y, out: `c${pad(0)}` });
+      continue;
+    }
+
+    const partial = `p${pad(bit)}`;
+    const generate = `g${pad(bit)}`;
+    const propagate = `q${pad(bit)}`;
+    const carryIn = `c${pad(bit - 1)}`;
+    const carryOut = bit === bits - 1 ? `z${pad(bits)}` : `c${pad(bit)}`;
+
+    gates.push({ op: 'XOR', in1: x, in2: y, out: partial });
+    gates.push({ op: 'XOR', in1: partial, in2: carryIn, out: `z${pad(bit)}` });
+    gates.push({ op: 'AND', in1: x, in2: y, out: generate });
+    gates.push({ op: 'AND', in1: partial, in2: carryIn, out: propagate });
+    gates.push({ op: 'OR', in1: generate, in2: propagate, out: carryOut });
+  }
+
+  return gates;
+}
+
+function swapOutputs(gates: Gate[], left: number, right: number): void {
+  const temp = gates[left].out;
+  gates[left].out = gates[right].out;
+  gates[right].out = temp;
+}
+
+describe('simulate', () => {
+  it('evaluates an acyclic circuit in dependency order', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: 's0' },
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'c0' },
+      { op: 'OR', in1: 's0', in2: 'c0', out: 'z00' },
+    ];
+
+    expect(simulate(gates, { x00: 1, y00: 1 })).toMatchObject({
+      s0: 0,
+      c0: 1,
+      z00: 1,
+    });
+  });
+});
+
+describe('findSwappedWires', () => {
+  it('finds four swapped output-wire pairs in a ripple-carry adder', () => {
+    const gates = buildAdder(6);
+    const swaps: Array<[number, number]> = [
+      [3, 4],
+      [8, 9],
+      [13, 14],
+      [18, 19],
+    ];
+
+    const expected: string[] = [];
+    for (const [left, right] of swaps) {
+      expected.push(gates[left].out, gates[right].out);
+      swapOutputs(gates, left, right);
+    }
+
+    expect(findSwappedWires(gates)).toEqual(expected.sort());
+  });
+});
