@@ -0,0 +1,113 @@
+import { v4 as uuidv4 } from 'uuid';
+
+import { EventBus } from '../bus.js';
+import {
+  Events,
+  OrderStatus,
+  type OrderCreatedEvent,
+  type OrderService,
+  type OrderStatusChangedEvent,
+} from '../types.js';
+
+type OrderRecord = {
+  id: string;
+  userId: string;
+  cartId: string;
+  status: OrderStatus;
+  total: number;
+};
+
+const VALID_TRANSITIONS: Record<OrderStatus, ReadonlySet<OrderStatus>> = {
+  [OrderStatus.PENDING]: new Set([OrderStatus.CONFIRMED, OrderStatus.CANCELLED]),
+  [OrderStatus.CONFIRMED]: new Set([OrderStatus.SHIPPED, OrderStatus.CANCELLED]),
+  [OrderStatus.SHIPPED]: new Set([OrderStatus.DELIVERED]),
+  [OrderStatus.DELIVERED]: new Set(),
+  [OrderStatus.CANCELLED]: new Set(),
+};
+
+function serializeOrder(order: OrderRecord): { id: string; userId: string; status: OrderStatus; total: number } {
+  return {
+    id: order.id,
+    userId: order.userId,
+    status: order.status,
+    total: order.total,
+  };
+}
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, OrderRecord>();
+
+  return {
+    createOrder(userId, cartId, total) {
+      if (!Number.isFinite(total) || total < 0) {
+        throw new Error('total must be a non-negative number');
+      }
+
+      const orderId = uuidv4();
+      const order: OrderRecord = {
+        id: orderId,
+        userId,
+        cartId,
+        status: OrderStatus.PENDING,
+        total,
+      };
+
+      orders.set(orderId, order);
+
+      const payload: OrderCreatedEvent = {
+        orderId,
+        userId,
+        cartId,
+        total,
+      };
+
+      void bus.emit(Events.ORDER_CREATED, payload);
+
+      return orderId;
+    },
+
+    getOrder(orderId) {
+      const order = orders.get(orderId);
+      return order ? serializeOrder(order) : null;
+    },
+
+    updateStatus(orderId, status) {
+      const order = orders.get(orderId);
+
+      if (!order) {
+        throw new Error(`order not found: ${orderId}`);
+      }
+
+      if (order.status === status) {
+        return;
+      }
+
+      const allowed = VALID_TRANSITIONS[order.status];
+
+      if (!allowed.has(status)) {
+        throw new Error(`invalid status transition from ${order.status} to ${status}`);
+      }
+
+      const previousStatus = order.status;
+      order.status = status;
+
+      const payload: OrderStatusChangedEvent = {
+        orderId,
+        status,
+        previousStatus,
+      };
+
+      void bus.emit(Events.ORDER_STATUS_CHANGED, payload);
+    },
+
+    listOrders(userId) {
+      return [...orders.values()]
+        .filter((order) => order.userId === userId)
+        .map((order) => ({
+          id: order.id,
+          status: order.status,
+          total: order.total,
+        }));
+    },
+  };
+}
diff --git a/src/payment/index.ts b/src/payment/index.ts
new file mode 100644
index 0000000..4e7ddf5
--- /dev/null
+++ b/src/payment/index.ts
@@ -0,0 +1,87 @@
+import { v4 as uuidv4 } from 'uuid';
+
+import { EventBus } from '../bus.js';
+import { Events, PaymentStatus, type PaymentProcessedEvent, type PaymentService } from '../types.js';
+
+export type PaymentServiceOptions = {
+  defaultOutcome?: PaymentStatus.SUCCESS | PaymentStatus.FAILED | PaymentStatus.TIMEOUT;
+  delayMs?: number;
+  orderOutcomes?: Record<string, PaymentStatus.SUCCESS | PaymentStatus.FAILED | PaymentStatus.TIMEOUT>;
+  failureMessage?: string;
+  timeoutMessage?: string;
+};
+
+type TransactionRecord = {
+  orderId: string;
+  amount: number;
+  refunded: boolean;
+};
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => {
+    setTimeout(resolve, ms);
+  });
+}
+
+export function createPaymentService(
+  bus: EventBus,
+  options: PaymentServiceOptions = {},
+): PaymentService {
+  const transactions = new Map<string, TransactionRecord>();
+
+  return {
+    async processPayment(orderId, amount) {
+      if (!Number.isFinite(amount) || amount < 0) {
+        throw new Error('amount must be a non-negative number');
+      }
+
+      const outcome = options.orderOutcomes?.[orderId] ?? options.defaultOutcome ?? PaymentStatus.SUCCESS;
+      const delayMs = options.delayMs ?? 0;
+
+      if (delayMs > 0) {
+        await delay(delayMs);
+      }
+
+      if (outcome === PaymentStatus.SUCCESS) {
+        const transactionId = uuidv4();
+        transactions.set(transactionId, { orderId, amount, refunded: false });
+
+        const payload: PaymentProcessedEvent = {
+          orderId,
+          status: PaymentStatus.SUCCESS,
+          transactionId,
+        };
+
+        await bus.emit(Events.PAYMENT_PROCESSED, payload);
+
+        return { status: PaymentStatus.SUCCESS, transactionId };
+      }
+
+      const error =
+        outcome === PaymentStatus.TIMEOUT
+          ? options.timeoutMessage ?? 'payment processing timed out'
+          : options.failureMessage ?? 'payment processing failed';
+
+      const payload: PaymentProcessedEvent = {
+        orderId,
+        status: outcome,
+        error,
+      };
+
+      await bus.emit(Events.PAYMENT_PROCESSED, payload);
+
+      return { status: outcome, error };
+    },
+
+    async refund(transactionId) {
+      const transaction = transactions.get(transactionId);
+
+      if (!transaction || transaction.refunded) {
+        return false;
+      }
+
+      transaction.refunded = true;
+      return true;
+    },
+  };
+}
