+import { EventBus } from '../bus.js';
+import {
+  Events,
+  type InventoryService,
+  type InventoryUpdatedEvent,
+  type LowStockAlertEvent,
+} from '../types.js';
+
+function assertQuantity(quantity: number, field: string): void {
+  if (!Number.isInteger(quantity) || quantity < 0) {
+    throw new Error(`${field} must be a non-negative integer`);
+  }
+}
+
+function assertPositiveQuantity(quantity: number, field: string): void {
+  if (!Number.isInteger(quantity) || quantity <= 0) {
+    throw new Error(`${field} must be a positive integer`);
+  }
+}
+
+export function createInventoryService(bus: EventBus): InventoryService {
+  const stock = new Map<string, number>();
+  const thresholds = new Map<string, number>();
+
+  const emitInventoryUpdated = (productId: string): void => {
+    const payload: InventoryUpdatedEvent = {
+      productId,
+      quantity: stock.get(productId) ?? 0,
+    };
+
+    void bus.emit(Events.INVENTORY_UPDATED, payload);
+  };
+
+  const emitLowStockIfNeeded = (productId: string): void => {
+    const quantity = stock.get(productId) ?? 0;
+    const threshold = thresholds.get(productId);
+
+    if (threshold === undefined || quantity >= threshold) {
+      return;
+    }
+
+    const payload: LowStockAlertEvent = {
+      productId,
+      currentQuantity: quantity,
+      threshold,
+    };
+
+    void bus.emit(Events.LOW_STOCK_ALERT, payload);
+  };
+
+  return {
+    setStock(productId, quantity) {
+      assertQuantity(quantity, 'quantity');
+
+      stock.set(productId, quantity);
+      emitInventoryUpdated(productId);
+      emitLowStockIfNeeded(productId);
+    },
+
+    getStock(productId) {
+      return stock.get(productId) ?? 0;
+    },
+
+    reserve(productId, quantity) {
+      assertPositiveQuantity(quantity, 'quantity');
+
+      const current = stock.get(productId) ?? 0;
+
+      if (current < quantity) {
+        return false;
+      }
+
+      stock.set(productId, current - quantity);
+      emitInventoryUpdated(productId);
+      emitLowStockIfNeeded(productId);
+
+      return true;
+    },
+
+    release(productId, quantity) {
+      assertPositiveQuantity(quantity, 'quantity');
+
+      const current = stock.get(productId) ?? 0;
+      stock.set(productId, current + quantity);
+      emitInventoryUpdated(productId);
+      emitLowStockIfNeeded(productId);
+    },
+
+    setLowStockThreshold(productId, threshold) {
+      assertQuantity(threshold, 'threshold');
+
+      thresholds.set(productId, threshold);
+    },
+  };
+}
