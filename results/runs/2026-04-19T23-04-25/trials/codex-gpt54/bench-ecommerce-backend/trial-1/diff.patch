diff --git a/tests/ecommerce.test.ts b/tests/ecommerce.test.ts
new file mode 100644
index 0000000..d22ec33
--- /dev/null
+++ b/tests/ecommerce.test.ts
@@ -0,0 +1,165 @@
+import { describe, expect, it } from 'vitest';
+
+import { EventBus } from '../src/bus.js';
+import {
+  createAnalyticsService,
+  createCartService,
+  createCatalogService,
+  createInventoryService,
+  createNotificationService,
+  createOrderService,
+  createPaymentService,
+  createPricingService,
+} from '../src/index.js';
+import { Events, OrderStatus, PaymentStatus } from '../src/types.js';
+
+describe('e-commerce backend', () => {
+  it('keeps catalog and pricing aligned through product-created events', () => {
+    const bus = new EventBus();
+    const catalog = createCatalogService(bus);
+    const pricing = createPricingService(bus);
+
+    const productId = catalog.createProduct('Keyboard', 99.99, 'electronics');
+
+    expect(pricing.getPrice(productId)).toBe(99.99);
+    expect(catalog.searchProducts('key')).toEqual([
+      {
+        id: productId,
+        name: 'Keyboard',
+        price: 99.99,
+        category: 'electronics',
+      },
+    ]);
+
+    pricing.addDiscountCode('SAVE10', 10);
+    expect(
+      pricing.calculateTotal([{ productId, quantity: 2, price: pricing.getPrice(productId) }], 'save10'),
+    ).toEqual({
+      subtotal: 199.98,
+      discount: 20,
+      tax: 18,
+      total: 197.98,
+    });
+  });
+
+  it('tracks inventory and emits low-stock alerts', () => {
+    const bus = new EventBus();
+    const inventory = createInventoryService(bus);
+
+    inventory.setLowStockThreshold('p-1', 3);
+    inventory.setStock('p-1', 5);
+
+    expect(inventory.reserve('p-1', 2)).toBe(true);
+    expect(inventory.getStock('p-1')).toBe(3);
+
+    expect(inventory.reserve('p-1', 1)).toBe(true);
+    expect(inventory.getStock('p-1')).toBe(2);
+
+    const lowStockEvents = bus.getLog().filter((entry) => entry.event === Events.LOW_STOCK_ALERT);
+    expect(lowStockEvents).toHaveLength(1);
+    expect(lowStockEvents[0]?.payload).toEqual({
+      productId: 'p-1',
+      currentQuantity: 2,
+      threshold: 3,
+    });
+  });
+
+  it('consolidates cart items and clears quantities correctly', () => {
+    const bus = new EventBus();
+    const cartService = createCartService(bus);
+
+    const cartId = cartService.createCart('user-1');
+    cartService.addItem(cartId, 'product-a', 1);
+    cartService.addItem(cartId, 'product-a', 2);
+    cartService.updateQuantity(cartId, 'product-a', 4);
+    cartService.addItem(cartId, 'product-b', 1);
+    cartService.removeItem(cartId, 'product-b');
+
+    expect(cartService.getCart(cartId)).toEqual({
+      id: cartId,
+      userId: 'user-1',
+      items: [{ productId: 'product-a', quantity: 4 }],
+    });
+
+    cartService.clearCart(cartId);
+    expect(cartService.getCart(cartId)?.items).toEqual([]);
+  });
+
+  it('routes order and payment events into notifications and analytics', async () => {
+    const bus = new EventBus();
+    const catalog = createCatalogService(bus);
+    const cart = createCartService(bus);
+    const pricing = createPricingService(bus);
+    const orders = createOrderService(bus);
+    const notifications = createNotificationService(bus);
+    const analytics = createAnalyticsService(bus);
+    const payment = createPaymentService(bus, { defaultOutcome: PaymentStatus.SUCCESS });
+
+    notifications.subscribe('user-42');
+
+    const productA = catalog.createProduct('Mouse', 25, 'electronics');
+    const productB = catalog.createProduct('Pad', 15, 'electronics');
+
+    const cartId = cart.createCart('user-42');
+    cart.addItem(cartId, productA, 2);
+    cart.addItem(cartId, productB, 1);
+
+    const totals = pricing.calculateTotal([
+      { productId: productA, quantity: 2, price: pricing.getPrice(productA) },
+      { productId: productB, quantity: 1, price: pricing.getPrice(productB) },
+    ]);
+
+    const orderId = orders.createOrder('user-42', cartId, totals.total);
+    orders.updateStatus(orderId, OrderStatus.CONFIRMED);
+    orders.updateStatus(orderId, OrderStatus.SHIPPED);
+
+    const paymentResult = await payment.processPayment(orderId, totals.total);
+
+    expect(paymentResult.status).toBe(PaymentStatus.SUCCESS);
+    expect(analytics.getEventCount(Events.ORDER_CREATED)).toBe(1);
+    expect(analytics.getEventCount(Events.CART_UPDATED)).toBe(3);
+    expect(analytics.getRevenue()).toBe(totals.total);
+    expect(analytics.getConversionRate()).toBe(1);
+    expect(analytics.getTopProducts(2)).toEqual([
+      { productId: productA, count: 2 },
+      { productId: productB, count: 1 },
+    ]);
+
+    const userNotifications = notifications.getNotifications('user-42');
+    expect(userNotifications).toHaveLength(3);
+    expect(userNotifications.map((entry) => entry.type)).toEqual([
+      'order_status',
+      'order_status',
+      'payment',
+    ]);
+  });
+
+  it('supports failure and timeout payment simulations and refunds', async () => {
+    const bus = new EventBus();
+    const failurePayment = createPaymentService(bus, {
+      defaultOutcome: PaymentStatus.FAILED,
+      failureMessage: 'card declined',
+    });
+    const timeoutPayment = createPaymentService(bus, {
+      defaultOutcome: PaymentStatus.TIMEOUT,
+      timeoutMessage: 'processor timeout',
+    });
+    const successPayment = createPaymentService(bus);
+
+    await expect(failurePayment.processPayment('order-fail', 10)).resolves.toEqual({
+      status: PaymentStatus.FAILED,
+      error: 'card declined',
+    });
+
+    await expect(timeoutPayment.processPayment('order-timeout', 10)).resolves.toEqual({
+      status: PaymentStatus.TIMEOUT,
+      error: 'processor timeout',
+    });
+
+    const success = await successPayment.processPayment('order-success', 10);
+    expect(success.status).toBe(PaymentStatus.SUCCESS);
+    expect(success.transactionId).toBeTruthy();
+    expect(await successPayment.refund(success.transactionId as string)).toBe(true);
+    expect(await successPayment.refund(success.transactionId as string)).toBe(false);
+  });
+});
