nt;\n    47\t        orderCount += 1;\n    48\t        orderTotals.set(event.orderId, event.total);\n    49\t\n    50\t        if (countedProductOrders.has(event.orderId)) {\n    51\t          return;\n    52\t        }\n    53\t\n    54\t        countedProductOrders.add(event.orderId);\n    55\t        const cart = carts.get(event.cartId);\n    56\t\n    57\t        if (!cart) {\n    58\t          return;\n    59\t        }\n    60\t\n    61\t        for (const item of cart.items) {\n    62\t          productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);\n    63\t        }\n    64\t\n    65\t        return;\n    66\t      }\n    67\t\n    68\t      if (eventType === Events.PAYMENT_PROCESSED) {\n    69\t        const event = payload as PaymentProcessedEvent;\n    70\t\n    71\t        if (event.status !== PaymentStatus.SUCCESS || countedRevenueOrders.has(event.orderId)) {\n    72\t          return;\n    73\t        }\n    74\t\n    75\t        countedRevenueOrders.add(event.orderId);\n    76\t        const total = orderTotals.get(event.orderId) ?? 0;\n    77\t        revenue += total;\n    78\t      }\n    79\t    });\n    80\t  }\n    81\t\n    82\t  return {\n    83\t    getEventCount(eventType) {\n    84\t      return eventCounts.get(eventType) ?? 0;\n    85\t    },\n    86\t\n    87\t    getRevenue() {\n    88\t      return revenue;\n    89\t    },\n    90\t\n    91\t    getConversionRate() {\n    92\t      if (cartIds.size === 0) {\n    93\t        return 0;\n    94\t      }\n    95\t\n    96\t      return orderCount / cartIds.size;\n    97\t    },\n    98\t\n    99\t    getTopProducts(limit) {\n   100\t      return [...productCounts.entries()]\n   101\t        .map(([productId, count]) => ({ productId, count }))\n   102\t        .sort((left, right) => {\n   103\t          if (right.count !== left.count) {\n   104\t            return right.count - left.count;\n   105\t          }\n   106\t\n   107\t          return left.productId.localeCompare(right.productId);\n   108\t        })\n   109\t        .slice(0, limit);\n   110\t    },\n   111\t  };\n   112\t}\n","exit_code":0,"status":"completed"}}
