@@ -0,0 +1,123 @@
+import { v4 as uuidv4 } from 'uuid';
+
+import { EventBus } from '../bus.js';
+import { Events, type CartService, type CartUpdatedEvent } from '../types.js';
+
+type CartRecord = {
+  id: string;
+  userId: string;
+  items: Map<string, number>;
+};
+
+function assertPositiveQuantity(quantity: number): void {
+  if (!Number.isInteger(quantity) || quantity <= 0) {
+    throw new Error('quantity must be a positive integer');
+  }
+}
+
+function assertNonNegativeQuantity(quantity: number): void {
+  if (!Number.isInteger(quantity) || quantity < 0) {
+    throw new Error('quantity must be a non-negative integer');
+  }
+}
+
+function serializeCart(cart: CartRecord): { id: string; userId: string; items: Array<{ productId: string; quantity: number }> } {
+  return {
+    id: cart.id,
+    userId: cart.userId,
+    items: [...cart.items.entries()].map(([productId, quantity]) => ({
+      productId,
+      quantity,
+    })),
+  };
+}
+
+function serializeCartEvent(cart: CartRecord): CartUpdatedEvent {
+  return {
+    cartId: cart.id,
+    userId: cart.userId,
+    items: [...cart.items.entries()].map(([productId, quantity]) => ({
+      productId,
+      quantity,
+    })),
+  };
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, CartRecord>();
+
+  const getExistingCart = (cartId: string): CartRecord => {
+    const cart = carts.get(cartId);
+
+    if (!cart) {
+      throw new Error(`cart not found: ${cartId}`);
+    }
+
+    return cart;
+  };
+
+  const emitCartUpdated = (cart: CartRecord): void => {
+    const payload = serializeCartEvent(cart);
+    void bus.emit(Events.CART_UPDATED, payload);
+  };
+
+  return {
+    createCart(userId) {
+      const cartId = uuidv4();
+      const cart: CartRecord = {
+        id: cartId,
+        userId,
+        items: new Map(),
+      };
+
+      carts.set(cartId, cart);
+      emitCartUpdated(cart);
+
+      return cartId;
+    },
+
+    addItem(cartId, productId, quantity) {
+      assertPositiveQuantity(quantity);
+
+      const cart = getExistingCart(cartId);
+      const current = cart.items.get(productId) ?? 0;
+
+      cart.items.set(productId, current + quantity);
+      emitCartUpdated(cart);
+    },
+
+    removeItem(cartId, productId) {
+      const cart = getExistingCart(cartId);
+      const removed = cart.items.delete(productId);
+
+      if (removed) {
+        emitCartUpdated(cart);
+      }
+    },
+
+    getCart(cartId) {
+      const cart = carts.get(cartId);
+      return cart ? serializeCart(cart) : null;
+    },
+
+    clearCart(cartId) {
+      const cart = getExistingCart(cartId);
+      cart.items.clear();
+      emitCartUpdated(cart);
+    },
+
+    updateQuantity(cartId, productId, quantity) {
+      assertNonNegativeQuantity(quantity);
+
+      const cart = getExistingCart(cartId);
+
+      if (quantity === 0) {
+        cart.items.delete(productId);
+      } else {
+        cart.items.set(productId, quantity);
+      }
+
+      emitCartUpdated(cart);
+    },
+  };
+}
