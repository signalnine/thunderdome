@@ -0,0 +1,112 @@
+import { EventBus } from '../bus.js';
+import {
+  Events,
+  PaymentStatus,
+  type AnalyticsService,
+  type CartUpdatedEvent,
+  type OrderCreatedEvent,
+  type PaymentProcessedEvent,
+} from '../types.js';
+
+type CartSnapshot = {
+  userId: string;
+  items: Array<{ productId: string; quantity: number }>;
+};
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const carts = new Map<string, CartSnapshot>();
+  const cartIds = new Set<string>();
+  let orderCount = 0;
+  const orderTotals = new Map<string, number>();
+  const countedRevenueOrders = new Set<string>();
+  const countedProductOrders = new Set<string>();
+  const productCounts = new Map<string, number>();
+  let revenue = 0;
+
+  const incrementEvent = (eventType: string): void => {
+    eventCounts.set(eventType, (eventCounts.get(eventType) ?? 0) + 1);
+  };
+
+  for (const eventType of Object.values(Events)) {
+    bus.on(eventType, (payload) => {
+      incrementEvent(eventType);
+
+      if (eventType === Events.CART_UPDATED) {
+        const event = payload as CartUpdatedEvent;
+        cartIds.add(event.cartId);
+        carts.set(event.cartId, {
+          userId: event.userId,
+          items: event.items.map((item) => ({ ...item })),
+        });
+        return;
+      }
+
+      if (eventType === Events.ORDER_CREATED) {
+        const event = payload as OrderCreatedEvent;
+        orderCount += 1;
+        orderTotals.set(event.orderId, event.total);
+
+        if (countedProductOrders.has(event.orderId)) {
+          return;
+        }
+
+        countedProductOrders.add(event.orderId);
+        const cart = carts.get(event.cartId);
+
+        if (!cart) {
+          return;
+        }
+
+        for (const item of cart.items) {
+          productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+        }
+
+        return;
+      }
+
+      if (eventType === Events.PAYMENT_PROCESSED) {
+        const event = payload as PaymentProcessedEvent;
+
+        if (event.status !== PaymentStatus.SUCCESS || countedRevenueOrders.has(event.orderId)) {
+          return;
+        }
+
+        countedRevenueOrders.add(event.orderId);
+        const total = orderTotals.get(event.orderId) ?? 0;
+        revenue += total;
+      }
+    });
+  }
+
+  return {
+    getEventCount(eventType) {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue() {
+      return revenue;
+    },
+
+    getConversionRate() {
+      if (cartIds.size === 0) {
+        return 0;
+      }
+
+      return orderCount / cartIds.size;
+    },
+
+    getTopProducts(limit) {
+      return [...productCounts.entries()]
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((left, right) => {
+          if (right.count !== left.count) {
+            return right.count - left.count;
+          }
+
+          return left.productId.localeCompare(right.productId);
+        })
+        .slice(0, limit);
+    },
+  };
+}
