@@ -0,0 +1,94 @@
+import { EventBus } from '../bus.js';
+import {
+  Events,
+  PaymentStatus,
+  type NotificationSentEvent,
+  type NotificationService,
+  type OrderCreatedEvent,
+  type OrderStatusChangedEvent,
+  type PaymentProcessedEvent,
+} from '../types.js';
+
+type NotificationRecord = {
+  type: string;
+  message: string;
+  timestamp: number;
+};
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const notifications = new Map<string, NotificationRecord[]>();
+  const orderOwners = new Map<string, string>();
+
+  const recordNotification = (userId: string, type: string, message: string): void => {
+    if (!subscribers.has(userId)) {
+      return;
+    }
+
+    const entry: NotificationRecord = {
+      type,
+      message,
+      timestamp: Date.now(),
+    };
+
+    const userNotifications = notifications.get(userId) ?? [];
+    userNotifications.push(entry);
+    notifications.set(userId, userNotifications);
+
+    const payload: NotificationSentEvent = { userId, type, message };
+    void bus.emit(Events.NOTIFICATION_SENT, payload);
+  };
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const event = payload as OrderCreatedEvent;
+    orderOwners.set(event.orderId, event.userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    const event = payload as OrderStatusChangedEvent;
+    const userId = orderOwners.get(event.orderId);
+
+    if (!userId) {
+      return;
+    }
+
+    recordNotification(
+      userId,
+      'order_status',
+      `Order ${event.orderId} changed from ${event.previousStatus} to ${event.status}`,
+    );
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const event = payload as PaymentProcessedEvent;
+    const userId = orderOwners.get(event.orderId);
+
+    if (!userId) {
+      return;
+    }
+
+    let message = `Payment for order ${event.orderId} ${event.status}`;
+
+    if (event.status === PaymentStatus.SUCCESS && event.transactionId) {
+      message = `Payment for order ${event.orderId} succeeded with transaction ${event.transactionId}`;
+    } else if (event.error) {
+      message = `Payment for order ${event.orderId} ${event.status}: ${event.error}`;
+    }
+
+    recordNotification(userId, 'payment', message);
+  });
+
+  return {
+    subscribe(userId) {
+      subscribers.add(userId);
+
+      if (!notifications.has(userId)) {
+        notifications.set(userId, []);
+      }
+    },
+
+    getNotifications(userId) {
+      return [...(notifications.get(userId) ?? [])];
+    },
+  };
+}
