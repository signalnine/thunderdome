+type JsonPrimitive = string | number | boolean | null;
+type JsonValue = JsonPrimitive | JsonValue[] | { [key: string]: JsonValue };
+type JsonObject = { [key: string]: JsonValue };
+
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+export interface Conflict {
+  documentId: string;
+  path: string;
+  base: unknown;
+  ours: unknown;
+  theirs: unknown;
+}
+
+export interface MergeResult {
+  merged: Record<string, object>;
+  conflicts: Conflict[];
+  applied: boolean;
+}
+
+export interface DocumentStoreApi {
+  create(id: string, content: object): void;
+  get(id: string): object;
+  update(id: string, content: object): void;
+  delete(id: string): void;
+  getHistory(id: string): Version[];
+  getVersion(id: string, versionId: string): object;
+  createBranch(name: string, fromBranch?: string): void;
+  switchBranch(name: string): void;
+  getBranch(): string;
+  listBranches(): string[];
+  merge(sourceBranch: string): MergeResult;
+}
+
+interface DocumentRecord {
+  content?: JsonObject;
+  deleted: boolean;
+  history: Version[];
+}
+
+interface Commit {
+  id: string;
+  parents: string[];
+  state: Map<string, DocumentRecord>;
+}
+
+const MAIN_BRANCH = "main";
+const MISSING = Symbol("missing");
+
+type MergeNode = JsonValue | typeof MISSING;
+
+export class DocumentStore implements DocumentStoreApi {
+  private readonly branches = new Map<string, string>();
+  private readonly commits = new Map<string, Commit>();
+  private currentBranch = MAIN_BRANCH;
+  private versionCounter = 0;
+  private commitCounter = 0;
+
+  constructor() {
+    const initialCommit = this.createCommit([], new Map<string, DocumentRecord>());
+    this.branches.set(MAIN_BRANCH, initialCommit.id);
+  }
+
+  create(id: string, content: object): void {
+    const nextContent = this.assertJsonObject(content);
+    const state = this.cloneState(this.getCurrentCommit().state);
+    const existing = state.get(id);
+
+    if (existing !== undefined && !existing.deleted) {
+      throw new Error(`Document "${id}" already exists on branch "${this.currentBranch}".`);
+    }
+
+    const history = existing?.history.slice() ?? [];
+    history.push(this.createVersion(nextContent));
+
+    state.set(id, {
+      content: cloneJsonObject(nextContent),
+      deleted: false,
+      history,
+    });
+
+    this.advanceBranch(state);
+  }
+
+  get(id: string): object {
+    const record = this.getLiveRecord(id);
+    return cloneJsonObject(record.content!);
+  }
+
+  update(id: string, content: object): void {
+    const nextContent = this.assertJsonObject(content);
+    const state = this.cloneState(this.getCurrentCommit().state);
+    const existing = state.get(id);
+
+    if (existing === undefined || existing.deleted) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.currentBranch}".`);
+    }
+
+    const history = existing.history.slice();
+    history.push(this.createVersion(nextContent));
+
+    state.set(id, {
+      content: cloneJsonObject(nextContent),
+      deleted: false,
+      history,
+    });
+
+    this.advanceBranch(state);
+  }
+
+  delete(id: string): void {
+    const state = this.cloneState(this.getCurrentCommit().state);
+    const existing = state.get(id);
+
+    if (existing === undefined || existing.deleted) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.currentBranch}".`);
+    }
+
+    state.set(id, {
+      content: undefined,
+      deleted: true,
+      history: existing.history.slice(),
+    });
+
+    this.advanceBranch(state);
+  }
+
+  getHistory(id: string): Version[] {
+    const record = this.getRecord(id);
+    return record.history.map((version) => ({
+      id: version.id,
+      timestamp: version.timestamp,
+      content: cloneJsonObject(version.content as JsonObject),
+    }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const record = this.getRecord(id);
+    const version = record.history.find((entry) => entry.id === versionId);
+
+    if (version === undefined) {
+      throw new Error(`Version "${versionId}" does not exist for document "${id}".`);
+    }
+
+    return cloneJsonObject(version.content as JsonObject);
+  }
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists.`);
+    }
+
+    const sourceBranch = fromBranch ?? this.currentBranch;
+    const head = this.branches.get(sourceBranch);
+
+    if (head === undefined) {
+      throw new Error(`Branch "${sourceBranch}" does not exist.`);
+    }
+
+    this.branches.set(name, head);
+  }
+
+  switchBranch(name: string): void {
+    if (!this.branches.has(name)) {
+      throw new Error(`Branch "${name}" does not exist.`);
+    }
+
+    this.currentBranch = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return Array.from(this.branches.keys());
+  }
+
+  merge(sourceBranch: string): MergeResult {
+    if (sourceBranch === this.currentBranch) {
+      return {
+        merged: this.serializeVisibleState(this.getCurrentCommit().state),
+        conflicts: [],
+        applied: true,
+      };
+    }
+
+    const sourceHead = this.branches.get(sourceBranch);
+    if (sourceHead === undefined) {
+      throw new Error(`Branch "${sourceBranch}" does not exist.`);
+    }
+
+    const oursCommit = this.getCurrentCommit();
+    const theirsCommit = this.getCommit(sourceHead);
+    const baseCommit = this.findCommonAncestor(oursCommit.id, theirsCommit.id);
+
+    const mergeOutput = this.mergeStates(baseCommit.state, oursCommit.state, theirsCommit.state);
+    const merged = this.serializeVisibleState(mergeOutput.state);
+
+    if (mergeOutput.conflicts.length > 0) {
+      return {
+        merged,
+        conflicts: mergeOutput.conflicts,
+        applied: false,
+      };
+    }
+
+    const sourceOnlyChanges = this.collectChangedDocumentIds(baseCommit.state, theirsCommit.state);
+    if (sourceOnlyChanges.length === 0) {
+      return {
+        merged,
+        conflicts: [],
+        applied: true,
+      };
+    }
+
+    this.advanceBranch(mergeOutput.state, [oursCommit.id, theirsCommit.id]);
+
+    return {
+      merged,
+      conflicts: [],
+      applied: true,
+    };
+  }
+
+  private mergeStates(
+    baseState: Map<string, DocumentRecord>,
+    oursState: Map<string, DocumentRecord>,
+    theirsState: Map<string, DocumentRecord>,
+  ): { state: Map<string, DocumentRecord>; conflicts: Conflict[] } {
+    const nextState = this.cloneState(oursState);
+    const conflicts: Conflict[] = [];
+    const documentIds = new Set<string>([
+      ...baseState.keys(),
+      ...oursState.keys(),
+      ...theirsState.keys(),
+    ]);
+
+    for (const documentId of documentIds) {
+      const baseRecord = baseState.get(documentId);
+      const oursRecord = oursState.get(documentId);
+      const theirsRecord = theirsState.get(documentId);
+
+      const baseContent = this.recordToNode(baseRecord);
+      const oursContent = this.recordToNode(oursRecord);
+      const theirsContent = this.recordToNode(theirsRecord);
+
+      if (deepEqual(baseContent, oursContent) && deepEqual(baseContent, theirsContent)) {
+        continue;
+      }
+
+      const mergedDocument = this.mergeNode(
+        documentId,
+        "",
+        baseContent,
+        oursContent,
+        theirsContent,
+        conflicts,
+      );
+
+      if (mergedDocument === MISSING) {
+        const history = oursRecord?.history.slice() ?? theirsRecord?.history.slice() ?? baseRecord?.history.slice() ?? [];
+        nextState.set(documentId, {
+          content: undefined,
+          deleted: true,
+          history,
+        });
+        continue;
+      }
+
+      const mergedContent = mergedDocument as JsonObject;
+      const currentVisible = this.recordToNode(oursRecord);
+      const history = oursRecord?.history.slice() ?? [];
+      const shouldAppendVersion = !deepEqual(currentVisible, mergedDocument);
+
+      nextState.set(documentId, {
+        content: cloneJsonObject(mergedContent),
+        deleted: false,
+        history: shouldAppendVersion ? [...history, this.createVersion(mergedContent)] : history,
+      });
+    }
+
+    return { state: nextState, conflicts };
+  }
+
+  private mergeNode(
+    documentId: string,
+    path: string,
+    base: MergeNode,
+    ours: MergeNode,
+    theirs: MergeNode,
+    conflicts: Conflict[],
+  ): MergeNode {
+    if (deepEqual(ours, theirs)) {
+      return cloneNode(ours);
+    }
+
+    if (deepEqual(base, ours)) {
+      return cloneNode(theirs);
+    }
+
+    if (deepEqual(base, theirs)) {
+      return cloneNode(ours);
+    }
+
+    if (isPlainObjectNode(base) && isPlainObjectNode(ours) && isPlainObjectNode(theirs)) {
+      const result: JsonObject = {};
+      const keys = new Set<string>([
+        ...Object.keys(base),
+        ...Object.keys(ours),
+        ...Object.keys(theirs),
+      ]);
+
+      for (const key of keys) {
+        const childPath = path === "" ? key : `${path}.${key}`;
+        const mergedChild = this.mergeNode(
+          documentId,
+          childPath,
+          getObjectValue(base, key),
+          getObjectValue(ours, key),
+          getObjectValue(theirs, key),
+          conflicts,
+        );
+
+        if (mergedChild !== MISSING) {
+          result[key] = cloneNode(mergedChild) as JsonValue;
+        }
+      }
+
+      return result;
+    }
+
+    conflicts.push({
+      documentId,
+      path,
+      base: toExternalValue(base),
+      ours: toExternalValue(ours),
+      theirs: toExternalValue(theirs),
+    });
+
+    return cloneNode(ours);
+  }
+
+  private collectChangedDocumentIds(
+    baseState: Map<string, DocumentRecord>,
+    nextState: Map<string, DocumentRecord>,
+  ): string[] {
+    const changed: string[] = [];
+    const ids = new Set<string>([...baseState.keys(), ...nextState.keys()]);
+
+    for (const id of ids) {
+      if (!deepEqual(this.recordToNode(baseState.get(id)), this.recordToNode(nextState.get(id)))) {
+        changed.push(id);
+      }
+    }
+
+    return changed;
+  }
+
+  private serializeVisibleState(state: Map<string, DocumentRecord>): Record<string, object> {
+    const visible: Record<string, object> = {};
+
+    for (const [id, record] of state.entries()) {
+      if (!record.deleted && record.content !== undefined) {
+        visible[id] = cloneJsonObject(record.content);
+      }
+    }
+
+    return visible;
+  }
+
+  private findCommonAncestor(leftCommitId: string, rightCommitId: string): Commit {
+    const leftAncestors = this.collectAncestorDepths(leftCommitId);
+    const rightAncestors = this.collectAncestorDepths(rightCommitId);
+
+    let bestId: string | null = null;
+    let bestDistance = Number.POSITIVE_INFINITY;
+
+    for (const [commitId, leftDistance] of leftAncestors.entries()) {
+      const rightDistance = rightAncestors.get(commitId);
+      if (rightDistance === undefined) {
+        continue;
+      }
+
+      const totalDistance = leftDistance + rightDistance;
+      if (totalDistance < bestDistance) {
+        bestId = commitId;
+        bestDistance = totalDistance;
+      }
+    }
+
+    if (bestId === null) {
+      throw new Error("No common ancestor found.");
+    }
+
+    return this.getCommit(bestId);
+  }
+
+  private collectAncestorDepths(startCommitId: string): Map<string, number> {
+    const distances = new Map<string, number>();
+    const queue: Array<{ id: string; depth: number }> = [{ id: startCommitId, depth: 0 }];
+
+    while (queue.length > 0) {
+      const current = queue.shift()!;
+      const knownDepth = distances.get(current.id);
+
+      if (knownDepth !== undefined && knownDepth <= current.depth) {
+        continue;
+      }
+
+      distances.set(current.id, current.depth);
+
+      const commit = this.getCommit(current.id);
+      for (const parentId of commit.parents) {
+        queue.push({ id: parentId, depth: current.depth + 1 });
+      }
+    }
+
+    return distances;
+  }
+
+  private createVersion(content: JsonObject): Version {
+    this.versionCounter += 1;
+    return {
+      id: `v${this.versionCounter}`,
+      timestamp: Date.now(),
+      content: cloneJsonObject(content),
+    };
+  }
+
+  private advanceBranch(state: Map<string, DocumentRecord>, parents?: string[]): void {
+    const currentHead = this.branches.get(this.currentBranch);
+    if (currentHead === undefined) {
+      throw new Error(`Branch "${this.currentBranch}" does not exist.`);
+    }
+
+    const commit = this.createCommit(parents ?? [currentHead], state);
+    this.branches.set(this.currentBranch, commit.id);
+  }
+
+  private createCommit(parents: string[], state: Map<string, DocumentRecord>): Commit {
+    this.commitCounter += 1;
+    const commit: Commit = {
+      id: `c${this.commitCounter}`,
+      parents: parents.slice(),
+      state: this.cloneState(state),
+    };
+
+    this.commits.set(commit.id, commit);
+    return commit;
+  }
+
+  private cloneState(state: Map<string, DocumentRecord>): Map<string, DocumentRecord> {
+    const next = new Map<string, DocumentRecord>();
+
+    for (const [id, record] of state.entries()) {
+      next.set(id, {
+        content: record.content === undefined ? undefined : cloneJsonObject(record.content),
+        deleted: record.deleted,
+        history: record.history.map((version) => ({
+          id: version.id,
+          timestamp: version.timestamp,
+          content: cloneJsonObject(version.content as JsonObject),
+        })),
+      });
+    }
+
+    return next;
+  }
+
+  private getCurrentCommit(): Commit {
+    const head = this.branches.get(this.currentBranch);
+    if (head === undefined) {
+      throw new Error(`Branch "${this.currentBranch}" does not exist.`);
+    }
+
+    return this.getCommit(head);
+  }
+
+  private getCommit(id: string): Commit {
+    const commit = this.commits.get(id);
+    if (commit === undefined) {
+      throw new Error(`Commit "${id}" does not exist.`);
+    }
+
+    return commit;
+  }
+
+  private getRecord(id: string): DocumentRecord {
+    const record = this.getCurrentCommit().state.get(id);
+
+    if (record === undefined) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.currentBranch}".`);
+    }
+
+    return record;
+  }
+
+  private getLiveRecord(id: string): DocumentRecord {
+    const record = this.getRecord(id);
+    if (record.deleted || record.content === undefined) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.currentBranch}".`);
+    }
+
+    return record;
+  }
+
+  private recordToNode(record: DocumentRecord | undefined): MergeNode {
+    if (record === undefined || record.deleted || record.content === undefined) {
+      return MISSING;
+    }
+
+    return cloneJsonObject(record.content);
+  }
+
+  private assertJsonObject(content: object): JsonObject {
+    if (Array.isArray(content) || content === null) {
+      throw new Error("Document content must be a JSON object.");
+    }
+
+    return cloneJsonObject(content as JsonObject);
+  }
+}
+
+function cloneJsonObject(value: JsonObject): JsonObject {
+  return structuredClone(value);
+}
+
+function cloneNode(value: MergeNode): MergeNode {
+  if (value === MISSING) {
+    return MISSING;
+  }
+
+  return structuredClone(value);
+}
+
+function toExternalValue(value: MergeNode): unknown {
+  return value === MISSING ? undefined : structuredClone(value);
+}
+
+function isPlainObjectNode(value: MergeNode): value is JsonObject {
+  if (value === MISSING) {
+    return false;
+  }
+
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function getObjectValue(objectValue: JsonObject, key: string): MergeNode {
+  return Object.prototype.hasOwnProperty.call(objectValue, key)
+    ? (objectValue[key] as JsonValue)
+    : MISSING;
+}
+
+function deepEqual(left: unknown, right: unknown): boolean {
+  if (left === MISSING || right === MISSING) {
+    return left === right;
+  }
+
+  return JSON.stringify(left) === JSON.stringify(right);
+}
