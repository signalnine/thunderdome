+import { describe, expect, it } from "vitest";
+
+import { DocumentStore } from "../src/index.js";
+
+describe("DocumentStore", () => {
+  it("supports CRUD with deep cloning", () => {
+    const store = new DocumentStore();
+    const input = { profile: { name: "Ada" }, tags: ["math"] };
+
+    store.create("doc-1", input);
+    input.profile.name = "Grace";
+    input.tags.push("logic");
+
+    const result = store.get("doc-1") as { profile: { name: string }; tags: string[] };
+    expect(result).toEqual({ profile: { name: "Ada" }, tags: ["math"] });
+
+    result.profile.name = "Changed";
+    expect(store.get("doc-1")).toEqual({ profile: { name: "Ada" }, tags: ["math"] });
+
+    store.update("doc-1", { profile: { name: "Bea" }, tags: ["science"] });
+    expect(store.get("doc-1")).toEqual({ profile: { name: "Bea" }, tags: ["science"] });
+
+    store.delete("doc-1");
+    expect(() => store.get("doc-1")).toThrow(/does not exist/i);
+    expect(() => store.update("doc-1", { profile: { name: "Cleo" } })).toThrow(/does not exist/i);
+  });
+
+  it("tracks version history chronologically and allows version lookup after deletion", () => {
+    const store = new DocumentStore();
+
+    store.create("doc-1", { value: 1 });
+    store.update("doc-1", { value: 2, extra: { ok: true } });
+    store.delete("doc-1");
+
+    const history = store.getHistory("doc-1");
+    expect(history).toHaveLength(2);
+    expect(history[0].content).toEqual({ value: 1 });
+    expect(history[1].content).toEqual({ value: 2, extra: { ok: true } });
+    expect(history[0].timestamp).toBeLessThanOrEqual(history[1].timestamp);
+
+    const version = store.getVersion("doc-1", history[0].id) as { value: number };
+    expect(version).toEqual({ value: 1 });
+  });
+
+  it("isolates changes across branches", () => {
+    const store = new DocumentStore();
+
+    store.create("shared", { count: 1 });
+    store.createBranch("feature");
+    store.switchBranch("feature");
+    store.update("shared", { count: 2 });
+    store.create("feature-only", { enabled: true });
+
+    expect(store.getBranch()).toBe("feature");
+    expect(store.listBranches()).toEqual(["main", "feature"]);
+    expect(store.get("shared")).toEqual({ count: 2 });
+
+    store.switchBranch("main");
+    expect(store.get("shared")).toEqual({ count: 1 });
+    expect(() => store.get("feature-only")).toThrow(/does not exist/i);
+  });
+
+  it("auto-applies non-conflicting structural merges across documents", () => {
+    const store = new DocumentStore();
+
+    store.create("doc-1", { profile: { name: "Ada", city: "London" } });
+    store.create("doc-2", { enabled: true });
+    store.createBranch("feature");
+
+    store.update("doc-1", { profile: { name: "Ada Lovelace", city: "London" } });
+
+    store.switchBranch("feature");
+    store.update("doc-1", { profile: { name: "Ada", city: "Paris" } });
+    store.update("doc-2", { enabled: false });
+
+    store.switchBranch("main");
+    const merge = store.merge("feature");
+
+    expect(merge.applied).toBe(true);
+    expect(merge.conflicts).toEqual([]);
+    expect(merge.merged).toEqual({
+      "doc-1": { profile: { name: "Ada Lovelace", city: "Paris" } },
+      "doc-2": { enabled: false },
+    });
+    expect(store.get("doc-1")).toEqual({ profile: { name: "Ada Lovelace", city: "Paris" } });
+    expect(store.get("doc-2")).toEqual({ enabled: false });
+  });
+
+  it("reports conflicting field edits without applying the merge", () => {
+    const store = new DocumentStore();
+
+    store.create("doc-1", { settings: { theme: "light", locale: "en" } });
+    store.createBranch("feature");
+
+    store.update("doc-1", { settings: { theme: "dark", locale: "en" } });
+
+    store.switchBranch("feature");
+    store.update("doc-1", { settings: { theme: "solarized", locale: "en" } });
+
+    store.switchBranch("main");
+    const merge = store.merge("feature");
+
+    expect(merge.applied).toBe(false);
+    expect(merge.conflicts).toEqual([
+      {
+        documentId: "doc-1",
+        path: "settings.theme",
+        base: "light",
+        ours: "dark",
+        theirs: "solarized",
+      },
+    ]);
+    expect(merge.merged).toEqual({
+      "doc-1": { settings: { theme: "dark", locale: "en" } },
+    });
+    expect(store.get("doc-1")).toEqual({ settings: { theme: "dark", locale: "en" } });
+  });
+
+  it("merges deletions when only one side changed the document", () => {
+    const store = new DocumentStore();
+
+    store.create("doc-1", { title: "keep me?" });
+    store.createBranch("cleanup");
+
+    store.switchBranch("cleanup");
+    store.delete("doc-1");
+
+    store.switchBranch("main");
+    const merge = store.merge("cleanup");
+
+    expect(merge.applied).toBe(true);
+    expect(merge.merged).toEqual({});
+    expect(() => store.get("doc-1")).toThrow(/does not exist/i);
+    expect(store.getHistory("doc-1")).toHaveLength(1);
+  });
+
+  it("treats differing array edits as conflicts on that field", () => {
+    const store = new DocumentStore();
+
+    store.create("doc-1", { items: ["a"] });
+    store.createBranch("feature");
+
+    store.update("doc-1", { items: ["a", "b"] });
+
+    store.switchBranch("feature");
+    store.update("doc-1", { items: ["a", "c"] });
+
+    store.switchBranch("main");
+    const merge = store.merge("feature");
+
+    expect(merge.applied).toBe(false);
+    expect(merge.conflicts).toEqual([
+      {
+        documentId: "doc-1",
+        path: "items",
+        base: ["a"],
+        ours: ["a", "b"],
+        theirs: ["a", "c"],
+      },
+    ]);
+  });
+});
