+export interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+interface HalfEntry {
+  lo: number;
+  hi: number;
+  popcount: number;
+  priority: number;
+  mask: number;
+}
+
+const LO_BITS = 20;
+const KEY_MULT = 1 << LO_BITS;
+
+function lowestSetBitIndex(v: number): number {
+  return 31 - Math.clz32(v & -v);
+}
+
+function enumerateHalf(
+  buttonLo: number[],
+  buttonHi: number[],
+  offset: number,
+  size: number,
+): Map<number, HalfEntry> {
+  const map = new Map<number, HalfEntry>();
+  const weights = new Array<number>(size);
+  for (let j = 0; j < size; j++) weights[j] = Math.pow(2, size - 1 - j);
+
+  let curLo = 0;
+  let curHi = 0;
+  let curPop = 0;
+  let curPriority = 0;
+  let curMask = 0;
+
+  const record = () => {
+    const key = curLo * KEY_MULT + curHi;
+    const existing = map.get(key);
+    if (
+      !existing ||
+      curPop < existing.popcount ||
+      (curPop === existing.popcount && curPriority > existing.priority)
+    ) {
+      map.set(key, { lo: curLo, hi: curHi, popcount: curPop, priority: curPriority, mask: curMask });
+    }
+  };
+
+  record();
+  const total = size === 0 ? 1 : Math.pow(2, size);
+  for (let i = 1; i < total; i++) {
+    const low = i & -i;
+    const j = lowestSetBitIndex(low);
+    const wasIncluded = (curMask & (1 << j)) !== 0;
+    curMask ^= 1 << j;
+    const bIdx = offset + j;
+    curLo ^= buttonLo[bIdx];
+    curHi ^= buttonHi[bIdx];
+    if (wasIncluded) {
+      curPop -= 1;
+      curPriority -= weights[j];
+    } else {
+      curPop += 1;
+      curPriority += weights[j];
+    }
+    record();
+  }
+  return map;
+}
+
+export function solveToggle(machine: Machine): number[] | null {
+  const { target, buttons } = machine;
+  const N = target.length;
+  const M = buttons.length;
+
+  let targetLo = 0;
+  let targetHi = 0;
+  for (let i = 0; i < N; i++) {
+    if (target[i]) {
+      if (i < LO_BITS) targetLo |= 1 << i;
+      else targetHi |= 1 << (i - LO_BITS);
+    }
+  }
+
+  if (M === 0) {
+    return targetLo === 0 && targetHi === 0 ? [] : null;
+  }
+
+  const buttonLo = new Array<number>(M);
+  const buttonHi = new Array<number>(M);
+  for (let i = 0; i < M; i++) {
+    let lo = 0;
+    let hi = 0;
+    for (const idx of buttons[i]) {
+      if (idx < LO_BITS) lo ^= 1 << idx;
+      else hi ^= 1 << (idx - LO_BITS);
+    }
+    buttonLo[i] = lo;
+    buttonHi[i] = hi;
+  }
+
+  const sizeA = Math.ceil(M / 2);
+  const sizeB = M - sizeA;
+
+  const mapA = enumerateHalf(buttonLo, buttonHi, 0, sizeA);
+  const mapB = enumerateHalf(buttonLo, buttonHi, sizeA, sizeB);
+
+  let bestTotal = Infinity;
+  let bestPriorityA = -1;
+  let bestEntryA: HalfEntry | null = null;
+  let bestEntryB: HalfEntry | null = null;
+
+  for (const entryA of mapA.values()) {
+    const neededLo = targetLo ^ entryA.lo;
+    const neededHi = targetHi ^ entryA.hi;
+    const neededKey = neededLo * KEY_MULT + neededHi;
+    const entryB = mapB.get(neededKey);
+    if (!entryB) continue;
+    const total = entryA.popcount + entryB.popcount;
+    if (total < bestTotal || (total === bestTotal && entryA.priority > bestPriorityA)) {
+      bestTotal = total;
+      bestPriorityA = entryA.priority;
+      bestEntryA = entryA;
+      bestEntryB = entryB;
+    }
+  }
+
+  if (!bestEntryA || !bestEntryB) return null;
+
+  const result: number[] = [];
+  for (let j = 0; j < sizeA; j++) {
+    if (bestEntryA.mask & (1 << j)) result.push(j);
+  }
+  for (let j = 0; j < sizeB; j++) {
+    if (bestEntryB.mask & (1 << j)) result.push(sizeA + j);
+  }
+  return result;
+}
