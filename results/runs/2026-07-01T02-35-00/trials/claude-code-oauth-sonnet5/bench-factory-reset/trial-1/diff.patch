+        const factor = mat[r][col];
+        for (let c = col; c <= M; c++) {
+          mat[r][c] = modP(mat[r][c] - factor * mat[row][c], p);
+        }
+      }
+    }
+    pivotColOfRow.push(col);
+    row++;
+  }
+
+  for (let r = row; r < N; r++) {
+    if (mat[r][M] !== 0) return null;
+  }
+
+  const isPivotCol = new Array<boolean>(M).fill(false);
+  for (const c of pivotColOfRow) isPivotCol[c] = true;
+
+  const x0 = new Array<number>(M).fill(0);
+  for (let i = 0; i < pivotColOfRow.length; i++) {
+    x0[pivotColOfRow[i]] = mat[i][M];
+  }
+
+  const kernel: number[][] = [];
+  for (let f = 0; f < M; f++) {
+    if (isPivotCol[f]) continue;
+    const v = new Array<number>(M).fill(0);
+    v[f] = 1;
+    for (let i = 0; i < pivotColOfRow.length; i++) {
+      const coeff = mat[i][f];
+      if (coeff !== 0) v[pivotColOfRow[i]] = modP(-coeff, p);
+    }
+    kernel.push(v);
+  }
+
+  return { x0, kernel };
+}
+
+function addKernelInPlace(x: number[], vec: number[], p: number, M: number): number {
+  let delta = 0;
+  for (let i = 0; i < M; i++) {
+    const old = x[i];
+    let nv = old + vec[i];
+    if (nv >= p) nv -= p;
+    x[i] = nv;
+    delta += nv - old;
+  }
+  return delta;
+}
+
+const BRUTE_THRESHOLD = 12_000_000;
+const HEURISTIC_TIME_BUDGET_MS = 3500;
+
+function exactBruteForce(x0: number[], kernel: number[][], p: number, M: number, r: number, totalCombos: number): number[] {
+  let bestX = x0.slice();
+  let bestSum = sumArray(bestX);
+  const cur = x0.slice();
+  const digits = new Array<number>(r).fill(0);
+  let curSum = bestSum;
+
+  for (let t = 1; t < totalCombos; t++) {
+    let f = r - 1;
+    for (;;) {
+      digits[f] += 1;
+      if (digits[f] === p) {
+        digits[f] = 0;
+        curSum += addKernelInPlace(cur, kernel[f], p, M);
+        f -= 1;
+      } else {
+        curSum += addKernelInPlace(cur, kernel[f], p, M);
+        break;
+      }
+    }
+    if (curSum < bestSum || (curSum === bestSum && lexLess(cur, bestX))) {
+      bestSum = curSum;
+      bestX = cur.slice();
+    }
+  }
+  return bestX;
+}
+
+function heuristicSearch(x0: number[], kernel: number[][], p: number, M: number, r: number, timeBudgetMs: number): number[] {
+  let bestX = x0.slice();
+  let bestSum = sumArray(bestX);
+  const deadline = Date.now() + timeBudgetMs;
+  let firstPass = true;
+
+  while (Date.now() < deadline) {
+    const c = new Array<number>(r).fill(0);
+    let cur = x0.slice();
+    if (!firstPass) {
+      for (let f = 0; f < r; f++) {
+        c[f] = Math.floor(Math.random() * p);
+        if (c[f] !== 0) {
+          for (let i = 0; i < M; i++) cur[i] = modP(cur[i] + c[f] * kernel[f][i], p);
+        }
+      }
+    }
+    firstPass = false;
+
+    let improved = true;
+    let sweeps = 0;
+    while (improved && sweeps < 30 && Date.now() < deadline) {
+      improved = false;
+      sweeps++;
+      // Process free variables from highest column index to lowest: lexicographically
+      // smaller results prefer zeros in early positions, so later-indexed free
+      // variables should get first claim on absorbing nonzero weight.
+      for (let f = r - 1; f >= 0; f--) {
+        const base = cur.slice();
+        if (c[f] !== 0) {
+          for (let i = 0; i < M; i++) base[i] = modP(base[i] - c[f] * kernel[f][i], p);
+        }
+        let bestVal = c[f];
+        let bestArr = cur;
+        let bestS = sumArray(cur);
+        for (let v = 0; v < p; v++) {
+          if (v === c[f]) continue;
+          const cand = base.slice();
+          if (v !== 0) {
+            for (let i = 0; i < M; i++) cand[i] = modP(cand[i] + v * kernel[f][i], p);
+          }
+          const s = sumArray(cand);
+          if (isBetter(s, cand, bestS, bestArr)) {
+            bestS = s;
+            bestVal = v;
+            bestArr = cand;
+          }
+        }
+        if (bestVal !== c[f]) {
+          improved = true;
+          c[f] = bestVal;
+          cur = bestArr;
+        }
+      }
+    }
+
+    const s = sumArray(cur);
+    if (isBetter(s, cur, bestSum, bestX)) {
+      bestSum = s;
+      bestX = cur.slice();
+    }
+  }
+  return bestX;
+}
+
+export function solveCounter(lights: number[], buttons: number[][], modulus: number): number[] | null {
+  const M = buttons.length;
+  const p = modulus;
+
+  if (M === 0) {
+    return lights.every((v) => modP(v, p) === 0) ? [] : null;
+  }
+
+  const result = eliminate(lights, buttons, p, M);
+  if (!result) return null;
+  const { x0, kernel } = result;
+  const r = kernel.length;
+
+  if (r === 0) return x0;
+
+  let combos = 1;
+  let withinThreshold = true;
+  for (let i = 0; i < r; i++) {
+    combos *= p;
+    if (combos > BRUTE_THRESHOLD) {
+      withinThreshold = false;
+      break;
+    }
+  }
+
+  if (withinThreshold) {
+    return exactBruteForce(x0, kernel, p, M, r, combos);
+  }
+  return heuristicSearch(x0, kernel, p, M, r, HEURISTIC_TIME_BUDGET_MS);
+}
