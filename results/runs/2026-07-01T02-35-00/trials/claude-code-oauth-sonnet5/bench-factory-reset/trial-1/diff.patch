}\n  }\n\n  const pivotColOfRow: number[] = [];\n  let row = 0;\n  for (let col = 0; col < M && row < N; col++) {\n    let sel = -1;\n    for (let r = row; r < N; r++) {\n      if (mat[r][col] !== 0) {\n        sel = r;\n        break;\n      }\n    }\n    if (sel === -1) continue;\n    if (sel !== row) {\n      const tmp = mat[row];\n      mat[row] = mat[sel];\n      mat[sel] = tmp;\n    }\n    const inv = modInverse(mat[row][col], p);\n    for (let c = col; c <= M; c++) mat[row][c] = modP(mat[row][c] * inv, p);\n    for (let r = 0; r < N; r++) {\n      if (r !== row && mat[r][col] !== 0) {\n        const factor = mat[r][col];\n        for (let c = col; c <= M; c++) {\n          mat[r][c] = modP(mat[r][c] - factor * mat[row][c], p);\n        }\n      }\n    }\n    pivotColOfRow.push(col);\n    row++;\n  }\n\n  for (let r = row; r < N; r++) {\n    if (mat[r][M] !== 0) return null;\n  }\n\n  const isPivotCol = new Array<boolean>(M).fill(false);\n  for (const c of pivotColOfRow) isPivotCol[c] = true;\n\n  const x0 = new Array<number>(M).fill(0);\n  for (let i = 0; i < pivotColOfRow.length; i++) {\n    x0[pivotColOfRow[i]] = mat[i][M];\n  }\n\n  const kernel: number[][] = [];\n  for (let f = 0; f < M; f++) {\n    if (isPivotCol[f]) continue;\n    const v = new Array<number>(M).fill(0);\n    v[f] = 1;\n    for (let i = 0; i < pivotColOfRow.length; i++) {\n      const coeff = mat[i][f];\n      if (coeff !== 0) v[pivotColOfRow[i]] = modP(-coeff, p);\n    }\n    kernel.push(v);\n  }\n\n  return { x0, kernel };\n}\n\nfunction addKernelInPlace(x: number[], vec: number[], p: number, M: number): number {\n  let delta = 0;\n  for (let i = 0; i < M; i++) {\n    const old = x[i];\n    let nv = old + vec[i];\n    if (nv >= p) nv -= p;\n    x[i] = nv;\n    delta += nv - old;\n  }\n  return delta;\n}\n\nconst BRUTE_THRESHOLD = 12_000_000;\nconst HEURISTIC_TIME_BUDGET_MS = 4000;\n\nfunction exactBruteForce(x0: number[], kernel: number[][], p: number, M: number, r: number, totalCombos: number): number[] {\n  let bestX = x0.slice();\n  let bestSum = sumArray(bestX);\n  const cur = x0.slice();\n  const digits = new Array<number>(r).fill(0);\n  let curSum = bestSum;\n\n  for (let t = 1; t < totalCombos; t++) {\n    let f = r - 1;\n    for (;;) {\n      digits[f] += 1;\n      if (digits[f] === p) {\n        digits[f] = 0;\n        curSum += addKernelInPlace(cur, kernel[f], p, M);\n        f -= 1;\n      } else {\n        curSum += addKernelInPlace(cur, kernel[f], p, M);\n        break;\n      }\n    }\n    if (curSum < bestSum || (curSum === bestSum && lexLess(cur, bestX))) {\n      bestSum = curSum;\n      bestX = cur.slice();\n    }\n  }\n  return bestX;\n}\n\nfunction heuristicSearch(x0: number[], kernel: number[][], p: number, M: number, r: number, timeBudgetMs: number): number[] {\n  let bestX = x0.slice();\n  let bestSum = sumArray(bestX);\n  const deadline = Date.now() + timeBudgetMs;\n  let firstPass = true;\n\n  while (Date.now() < deadline) {\n    const c = new Array<number>(r).fill(0);\n    let cur = x0.slice();\n    if (!firstPass) {\n      for (let f = 0; f < r; f++) {\n        c[f] = Math.floor(Math.random() * p);\n        if (c[f] !== 0) {\n          for (let i = 0; i < M; i++) cur[i] = modP(cur[i] + c[f] * kernel[f][i], p);\n        }\n      }\n    }\n    firstPass = false;\n\n    let improved = true;\n    let sweeps = 0;\n    while (improved && sweeps < 30 && Date.now() < deadline) {\n      improved = false;\n      sweeps++;\n      // Process free variables from highest column index to lowest: lexicographically\n      // smaller results prefer zeros in early positions, so later-indexed free\n      // variables should get first claim on absorbing nonzero weight.\n      for (let f = r - 1; f >= 0; f--) {\n        const base = cur.slice();\n        if (c[f] !== 0) {\n          for (let i = 0; i < M; i++) base[i] = modP(base[i] - c[f] * kernel[f][i], p);\n        }\n        let bestVal = c[f];\n        let bestArr = cur;\n        let be