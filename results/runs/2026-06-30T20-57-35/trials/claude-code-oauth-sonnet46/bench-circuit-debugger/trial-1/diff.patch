@@ -0,0 +1,233 @@
+import { describe, it, expect } from 'vitest';
+import { simulate, findSwappedWires, type Gate } from './index.js';
+
+// ─── simulate ────────────────────────────────────────────────────────────────
+
+describe('simulate', () => {
+  it('evaluates AND gate', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 }).c).toBe(1);
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(0);
+    expect(simulate(gates, { a: 0, b: 0 }).c).toBe(0);
+  });
+
+  it('evaluates OR gate', () => {
+    const gates: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(1);
+    expect(simulate(gates, { a: 0, b: 0 }).c).toBe(0);
+  });
+
+  it('evaluates XOR gate', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 }).c).toBe(0);
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(1);
+  });
+
+  it('evaluates dependent chain', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 't' },
+      { op: 'XOR', in1: 't', in2: 'c', out: 'out' },
+    ];
+    const result = simulate(gates, { a: 1, b: 1, c: 1 });
+    expect(result.t).toBe(1);
+    expect(result.out).toBe(0);
+  });
+
+  it('returns all wire values including inputs', () => {
+    const gates: Gate[] = [{ op: 'OR', in1: 'x', in2: 'y', out: 'z' }];
+    const result = simulate(gates, { x: 1, y: 0 });
+    expect(result.x).toBe(1);
+    expect(result.y).toBe(0);
+    expect(result.z).toBe(1);
+  });
+
+  it('simulates a 4-bit adder: 3 + 5 = 8', () => {
+    const gates = makeCorrectAdder(4);
+    const inputs = makeInputs(4, 3n, 5n);
+    const result = simulate(gates, inputs);
+    expect(readZ(result, 4)).toBe(8n);
+  });
+
+  it('simulates a 4-bit adder: 7 + 7 = 14', () => {
+    const gates = makeCorrectAdder(4);
+    const inputs = makeInputs(4, 7n, 7n);
+    const result = simulate(gates, inputs);
+    expect(readZ(result, 4)).toBe(14n);
+  });
+});
+
+// ─── findSwappedWires ────────────────────────────────────────────────────────
+
+describe('findSwappedWires', () => {
+  it('returns empty array for correct adder', () => {
+    const gates = makeCorrectAdder(8);
+    expect(findSwappedWires(gates)).toEqual([]);
+  });
+
+  it('finds z ↔ generate swap', () => {
+    const correct = makeCorrectAdder(8);
+    // z02 is output of XOR(t02, c01); a02 is output of AND(x02, y02)
+    // swap their outputs
+    const swapA = 'z02';
+    const swapB = findOutputOf(correct, (g) =>
+      g.op === 'AND' && hasXY(g) && !isBit0(g) && g.in1.endsWith('02')
+    );
+    const broken = applySwap(correct, swapA, swapB!);
+    const result = findSwappedWires(broken);
+    expect(result).toContain(swapA);
+    expect(result).toContain(swapB!);
+  });
+
+  it('finds 4 swap pairs (8 wires) in a swapped 10-bit adder', () => {
+    const correct = makeCorrectAdder(10);
+    // Pick detectable pairs: z↔a, z↔b, t↔a, t↔b
+    const zWires = getWiresByRole(correct, 'z').slice(0, 2);
+    const tWires = getWiresByRole(correct, 't').slice(0, 2);
+    const aWires = getWiresByRole(correct, 'a').slice(0, 2);
+    const bWires = getWiresByRole(correct, 'b').slice(0, 2);
+
+    let broken = [...correct];
+    const pairs: [string, string][] = [
+      [zWires[0], aWires[0]],
+      [zWires[1], bWires[0]],
+      [tWires[0], aWires[1]],
+      [tWires[1], bWires[1]],
+    ];
+    for (const [a, b] of pairs) {
+      broken = applySwap(broken, a, b);
+    }
+
+    const result = findSwappedWires(broken);
+    expect(result).toHaveLength(8);
+    const expected = pairs.flat().sort();
+    expect(result).toEqual(expected);
+  });
+
+  it('returns results sorted', () => {
+    const correct = makeCorrectAdder(6);
+    const zWires = getWiresByRole(correct, 'z').slice(0, 2);
+    const aWires = getWiresByRole(correct, 'a').slice(0, 2);
+    const tWires = getWiresByRole(correct, 't').slice(0, 2);
+    const bWires = getWiresByRole(correct, 'b').slice(0, 2);
+    let broken = [...correct];
+    const pairs: [string, string][] = [
+      [zWires[0], aWires[0]],
+      [zWires[1], bWires[0]],
+      [tWires[0], aWires[1]],
+      [tWires[1], bWires[1]],
+    ];
+    for (const [a, b] of pairs) broken = applySwap(broken, a, b);
+    const result = findSwappedWires(broken);
+    expect(result).toEqual([...result].sort());
+  });
+});
+
+// ─── Helpers ─────────────────────────────────────────────────────────────────
+
+function makeCorrectAdder(n: number): Gate[] {
+  const gates: Gate[] = [];
+  const usedNames = new Set<string>();
+  let nameCounter = 0;
+
+  function name(): string {
+    let s: string;
+    do {
+      s = `w${nameCounter++}`;
+    } while (usedNames.has(s));
+    usedNames.add(s);
+    return s;
+  }
+
+  // Reserve x/y/z names
+  for (let i = 0; i < n; i++) {
+    const p = String(i).padStart(2, '0');
+    usedNames.add(`x${p}`); usedNames.add(`y${p}`); usedNames.add(`z${p}`);
+  }
+  usedNames.add(`z${String(n).padStart(2, '0')}`);
+
+  const c0 = name();
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: c0 });
+  let carry = c0;
+
+  for (let i = 1; i < n; i++) {
+    const p = String(i).padStart(2, '0');
+    const t = name(), a = name(), b = name(), c = name();
+    gates.push({ op: 'XOR', in1: `x${p}`, in2: `y${p}`, out: t });
+    gates.push({ op: 'XOR', in1: t, in2: carry, out: `z${p}` });
+    gates.push({ op: 'AND', in1: `x${p}`, in2: `y${p}`, out: a });
+    gates.push({ op: 'AND', in1: t, in2: carry, out: b });
+    gates.push({ op: 'OR', in1: a, in2: b, out: c });
+    carry = c;
+  }
+
+  const finalZ = `z${String(n).padStart(2, '0')}`;
+  for (const g of gates) {
+    if (g.out === carry) g.out = finalZ;
+    if (g.in1 === carry) g.in1 = finalZ;
+    if (g.in2 === carry) g.in2 = finalZ;
+  }
+
+  return gates;
+}
+
+function makeInputs(n: number, x: bigint, y: bigint): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < n; i++) {
+    const p = String(i).padStart(2, '0');
+    inputs[`x${p}`] = Number((x >> BigInt(i)) & 1n);
+    inputs[`y${p}`] = Number((y >> BigInt(i)) & 1n);
+  }
+  return inputs;
+}
+
+function readZ(wires: Record<string, number>, n: number): bigint {
+  let result = 0n;
+  for (let i = 0; i <= n; i++) {
+    const p = String(i).padStart(2, '0');
+    if (wires[`z${p}`]) result |= 1n << BigInt(i);
+  }
+  return result;
+}
+
+function applySwap(gates: Gate[], a: string, b: string): Gate[] {
+  return gates.map((g) => ({
+    ...g,
+    out: g.out === a ? b : g.out === b ? a : g.out,
+  }));
+}
+
+function hasXY(g: Gate): boolean {
+  return g.in1.startsWith('x') || g.in1.startsWith('y') ||
+         g.in2.startsWith('x') || g.in2.startsWith('y');
+}
+
+function isBit0(g: Gate): boolean {
+  return (g.in1 === 'x00' || g.in1 === 'y00') && (g.in2 === 'x00' || g.in2 === 'y00');
+}
+
+function findOutputOf(gates: Gate[], pred: (g: Gate) => boolean): string | undefined {
+  return gates.find(pred)?.out;
+}
+
+function getWiresByRole(gates: Gate[], role: 'z' | 't' | 'a' | 'b' | 'c'): string[] {
+  return gates.filter((g) => {
+    if (isBit0(g)) return false;
+    if (g.out.startsWith('z') && g.out !== 'z00') {
+      return role === 'z' && !isMaxZ(gates, g.out);
+    }
+    if (role === 't') return g.op === 'XOR' && hasXY(g);
+    if (role === 'a') return g.op === 'AND' && hasXY(g);
+    if (role === 'b') return g.op === 'AND' && !hasXY(g);
+    if (role === 'c') return g.op === 'OR';
+    return false;
+  }).map((g) => g.out);
+}
+
+function isMaxZ(gates: Gate[], wire: string): boolean {
+  const num = parseInt(wire.slice(1), 10);
+  return gates.every((g) => {
+    if (!g.out.startsWith('z')) return true;
+    return parseInt(g.out.slice(1), 10) <= num;
+  }) && gates.some((g) => g.out === wire);
+}
