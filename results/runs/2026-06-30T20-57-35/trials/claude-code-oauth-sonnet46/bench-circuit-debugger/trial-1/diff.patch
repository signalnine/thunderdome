me(rng, usedNames);\n\n    gates.push({ op: 'XOR', in1: xi, in2: yi, out: t });\n    gates.push({ op: 'XOR', in1: t, in2: carry, out: zi });\n    gates.push({ op: 'AND', in1: xi, in2: yi, out: a });\n    gates.push({ op: 'AND', in1: t, in2: carry, out: b });\n    gates.push({ op: 'OR', in1: a, in2: b, out: c });\n\n    carry = c;\n  }\n\n  // Final carry → z[n]\n  const finalZ = `z${String(n).padStart(2, '0')}`;\n  for (const gate of gates) {\n    if (gate.out === carry) gate.out = finalZ;\n    if (gate.in1 === carry) gate.in1 = finalZ;\n    if (gate.in2 === carry) gate.in2 = finalZ;\n  }\n\n  return gates;\n}\n\nfunction applySwaps(gates: Gate[], pairs: [string, string][]): Gate[] {\n  const swapMap = new Map<string, string>();\n  for (const [a, b] of pairs) {\n    swapMap.set(a, b);\n    swapMap.set(b, a);\n  }\n  return gates.map((g) => ({\n    ...g,\n    out: swapMap.get(g.out) ?? g.out,\n  }));\n}\n\nfunction shuffleGates(gates: Gate[], seed: number): Gate[] {\n  const rng = seededRandom(seed);\n  const arr = [...gates];\n  for (let i = arr.length - 1; i > 0; i--) {\n    const j = Math.floor(rng() * (i + 1));\n    [arr[i], arr[j]] = [arr[j], arr[i]];\n  }","is_error":false}]},"parent_tool_use_id":null,"session_id":"9d07972a-6540-4d2f-a24d-1bac1e745c15","uuid":"16f371ec-1e2b-4033-a446-003e2c73bd25","timestamp":"2026-06-30T21:19:31.185Z","tool_use_result":{"stdout":"import { describe, it, expect } from 'vitest';\nimport { discover, type Gate } from './_discovery.js';\n\n// ─── Seeded PRNG (xorshift32) ─────────────────────────────────────────────────\n\nfunction seededRandom(seed: number): () => number {\n  let state = seed | 0 || 1;\n  return () => {\n    state ^= state << 13;\n    state ^= state >> 17;\n    state ^= state << 5;\n    return (state >>> 0) / 0x100000000;\n  };\n}\n\n// ─── Circuit Generator ────────────────────────────────────────────────────────\n\nfunction randomWireName(rng: () => number, usedNames: Set<string>): string {\n  const chars = 'abcd