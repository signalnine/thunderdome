+import { Router, Request, Response } from 'express';
+import { randomBytes } from 'crypto';
+import { Store, newId } from '../store.js';
+
+export function createUsersRouter(store: Store): Router {
+  const router = Router();
+
+  router.post('/auth/register', (req: Request, res: Response): void => {
+    const { username, password } = req.body ?? {};
+
+    if (!username || !password) {
+      res.status(400).json({ error: 'Username and password are required' });
+      return;
+    }
+
+    const taken = [...store.users.values()].some(u => u.username === username);
+    if (taken) {
+      res.status(409).json({ error: 'Username already taken' });
+      return;
+    }
+
+    const id = newId();
+    store.users.set(id, { id, username, password });
+    res.status(201).json({ id, username });
+  });
+
+  router.post('/auth/login', (req: Request, res: Response): void => {
+    const { username, password } = req.body ?? {};
+
+    if (!username || !password) {
+      res.status(400).json({ error: 'Username and password are required' });
+      return;
+    }
+
+    const user = [...store.users.values()].find(
+      u => u.username === username && u.password === password
+    );
+    if (!user) {
+      res.status(401).json({ error: 'Invalid credentials' });
+      return;
+    }
+
+    const token = randomBytes(32).toString('hex');
+    store.tokens.set(token, user.id);
+    res.json({ token, userId: user.id });
+  });
+
+  return router;
+}
diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..187ffe9
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,140 @@
+import { randomUUID } from 'crypto';
+
+export type Role = 'viewer' | 'editor' | 'owner';
+
+const ROLE_ORDER: Record<Role, number> = { viewer: 0, editor: 1, owner: 2 };
+
+export function morePermissive(a: Role | null, b: Role | null): Role | null {
+  if (a === null) return b;
+  if (b === null) return a;
+  return ROLE_ORDER[a] >= ROLE_ORDER[b] ? a : b;
+}
+
+export interface User {
+  id: string;
+  username: string;
+  password: string;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  permissions: Map<string, Role>;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  permissions: Map<string, Role>;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface ActivityEntry {
+  id: string;
+  action: string;
+  userId: string;
+  resourceType: 'document' | 'folder';
+  resourceId: string;
+  timestamp: string;
+}
+
+export interface Store {
+  users: Map<string, User>;
+  tokens: Map<string, string>;
+  folders: Map<string, Folder>;
+  documents: Map<string, Document>;
+  activity: ActivityEntry[];
+}
+
+export function createStore(): Store {
+  return {
+    users: new Map(),
+    tokens: new Map(),
+    folders: new Map(),
+    documents: new Map(),
+    activity: [],
+  };
+}
+
+export function newId(): string {
+  return randomUUID();
+}
+
+export function getEffectiveFolderRole(store: Store, folderId: string, userId: string): Role | null {
+  const folder = store.folders.get(folderId);
+  if (!folder) return null;
+
+  let role: Role | null = null;
+
+  if (folder.ownerId === userId) {
+    role = 'owner';
+  }
+
+  const directRole = folder.permissions.get(userId) ?? null;
+  role = morePermissive(role, directRole);
+
+  if (folder.parentId) {
+    const parentRole = getEffectiveFolderRole(store, folder.parentId, userId);
+    role = morePermissive(role, parentRole);
+  }
+
+  return role;
+}
+
+export function getEffectiveDocumentRole(store: Store, docId: string, userId: string): Role | null {
+  const doc = store.documents.get(docId);
+  if (!doc) return null;
+
+  let role: Role | null = null;
+
+  if (doc.ownerId === userId) {
+    role = 'owner';
+  }
+
+  const directRole = doc.permissions.get(userId) ?? null;
+  role = morePermissive(role, directRole);
+
+  const folderRole = getEffectiveFolderRole(store, doc.folderId, userId);
+  role = morePermissive(role, folderRole);
+
+  return role;
+}
+
+export function logActivity(
+  store: Store,
+  action: string,
+  userId: string,
+  resourceType: 'document' | 'folder',
+  resourceId: string
+): void {
+  store.activity.push({
+    id: newId(),
+    action,
+    userId,
+    resourceType,
+    resourceId,
+    timestamp: new Date().toISOString(),
+  });
+}
+
+export function deleteFolderCascade(store: Store, folderId: string): void {
+  for (const [id, doc] of store.documents) {
+    if (doc.folderId === folderId) {
+      store.documents.delete(id);
+    }
+  }
+  for (const [id, folder] of store.folders) {
+    if (folder.parentId === folderId) {
+      deleteFolderCascade(store, id);
+    }
+  }
+  store.folders.delete(folderId);
+}
