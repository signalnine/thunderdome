le).toBe('editor');\n\n    const put = await request(srv)\n      .put(`/folders/${f.body.id}`)\n      .set('Authorization', `Bearer ${bobToken}`)\n      .send({ name: 'Renamed' });\n    expect(put.status).toBe(200);\n\n    const del = await request(srv)\n      .delete(`/folders/${f.body.id}`)\n      .set('Authorization', `Bearer ${bobToken}`);\n    expect(del.status).toBe(403);\n  });\n\n  it('viewer cannot share folder', async () => {\n    const f = await request(srv)\n      .post('/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Alice Folder' });\n\n    await request(srv)\n      .post(`/folders/${f.body.id}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ userId: bobId, role: 'viewer' });\n\n    await register(srv, 'carol');\n    const { userId: carolId } = await login(srv, 'carol');\n\n    const res = await request(srv)\n      .post(`/folders/${f.body.id}/share`)\n      .set('Authorization', `Bearer ${bobToken}`)\n      .send({ userId: carolId, role: 'viewer' });\n    expect(res.status).toBe(403);\n  });\n\n  it('editor can share folder', async () => {\n    const f = await request(srv)\n      .post('/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Alice Folder' });\n\n    await request(srv)\n      .post(`/folders/${f.body.id}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ userId: bobId, role: 'editor' });\n\n    await register(srv, 'carol');\n    const { userId: carolId } = await login(srv, 'carol');\n\n    const res = await request(srv)\n      .post(`/folders/${f.body.id}/share`)\n      .set('Authorization', `Bearer ${bobToken}`)\n      .send({ userId: carolId, role: 'viewer' });\n    expect(res.status).toBe(200);\n  });\n\n  describe('Permission Inheritance', () => {\n    it('folder access grants access to documents within it', async () => {\n      const f = await request(srv)\n        .post('/folders')\n        .set('Authorization',