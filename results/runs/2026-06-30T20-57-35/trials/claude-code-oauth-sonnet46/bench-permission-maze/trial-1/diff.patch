+import { Router, Request, Response } from 'express';
+import {
+  Store,
+  newId,
+  getEffectiveFolderRole,
+  logActivity,
+  deleteFolderCascade,
+  Role,
+} from '../store.js';
+
+function serializeFolder(
+  folder: { id: string; name: string; parentId: string | null; ownerId: string; createdAt: string; updatedAt: string },
+  role?: Role
+) {
+  return {
+    id: folder.id,
+    name: folder.name,
+    parentId: folder.parentId,
+    ownerId: folder.ownerId,
+    ...(role !== undefined ? { role } : {}),
+    createdAt: folder.createdAt,
+    updatedAt: folder.updatedAt,
+  };
+}
+
+export function createFoldersRouter(store: Store): Router {
+  const router = Router();
+
+  router.post('/folders', (req: Request, res: Response): void => {
+    const userId = req.userId!;
+    const { name, parentId } = req.body ?? {};
+
+    if (!name) {
+      res.status(400).json({ error: 'Name is required' });
+      return;
+    }
+
+    if (parentId) {
+      if (!store.folders.has(parentId)) {
+        res.status(404).json({ error: 'Parent folder not found' });
+        return;
+      }
+      const parentRole = getEffectiveFolderRole(store, parentId, userId);
+      if (!parentRole || parentRole === 'viewer') {
+        res.status(403).json({ error: 'Insufficient permissions' });
+        return;
+      }
+    }
+
+    const id = newId();
+    const now = new Date().toISOString();
+    const folder = {
+      id,
+      name,
+      parentId: parentId ?? null,
+      ownerId: userId,
+      permissions: new Map<string, Role>(),
+      createdAt: now,
+      updatedAt: now,
+    };
+    store.folders.set(id, folder);
+
+    res.status(201).json(serializeFolder(folder));
+  });
+
+  router.get('/folders/:id', (req: Request, res: Response): void => {
+    const userId = req.userId!;
+    const folder = store.folders.get(req.params.id);
+
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+
+    const role = getEffectiveFolderRole(store, folder.id, userId);
+    if (!role) {
+      res.status(403).json({ error: 'Insufficient permissions' });
+      return;
+    }
+
+    res.json(serializeFolder(folder, role));
+  });
+
+  router.put('/folders/:id', (req: Request, res: Response): void => {
+    const userId = req.userId!;
+    const folder = store.folders.get(req.params.id);
+
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+
+    const role = getEffectiveFolderRole(store, folder.id, userId);
+    if (!role || role === 'viewer') {
+      res.status(403).json({ error: 'Insufficient permissions' });
+      return;
+    }
+
+    const { name } = req.body ?? {};
+    if (!name) {
+      res.status(400).json({ error: 'Name is required' });
+      return;
+    }
+
+    folder.name = name;
+    folder.updatedAt = new Date().toISOString();
+
+    res.json(serializeFolder(folder));
+  });
+
+  router.delete('/folders/:id', (req: Request, res: Response): void => {
+    const userId = req.userId!;
+    const folder = store.folders.get(req.params.id);
+
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+
+    const role = getEffectiveFolderRole(store, folder.id, userId);
+    if (role !== 'owner') {
+      res.status(403).json({ error: 'Insufficient permissions' });
+      return;
+    }
+
+    deleteFolderCascade(store, folder.id);
+    res.status(204).send();
+  });
+
+  router.post('/folders/:id/share', (req: Request, res: Response): void => {
+    const userId = req.userId!;
+    const folder = store.folders.get(req.params.id);
+
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+
+    const requesterRole = getEffectiveFolderRole(store, folder.id, userId);
+    if (!requesterRole || requesterRole === 'viewer') {
+      res.status(403).json({ error: 'Insufficient permissions' });
+      return;
+    }
+
+    const { userId: targetId, role } = req.body ?? {};
+
+    if (!targetId || !role) {
+      res.status(400).json({ error: 'userId and role are required' });
+      return;
+    }
+
+    if (!['viewer', 'editor', 'owner'].includes(role)) {
+      res.status(400).json({ error: 'Invalid role' });
+      return;
+    }
+
+    if (!store.users.has(targetId)) {
+      res.status(404).json({ error: 'User not found' });
+      return;
+    }
+
+    folder.permissions.set(targetId, role as Role);
+    logActivity(store, 'folder_shared', userId, 'folder', folder.id);
+
+    res.json({ message: 'Shared successfully' });
+  });
+
+  return router;
+}
