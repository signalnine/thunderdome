diff --git a/src/routes/documents.ts b/src/routes/documents.ts
new file mode 100644
index 0000000..e171f32
--- /dev/null
+++ b/src/routes/documents.ts
@@ -0,0 +1,171 @@
+import { Router, Request, Response } from 'express';
+import {
+  Store,
+  newId,
+  getEffectiveFolderRole,
+  getEffectiveDocumentRole,
+  logActivity,
+  Role,
+} from '../store.js';
+
+function serializeDoc(
+  doc: { id: string; title: string; content: string; folderId: string; ownerId: string; createdAt: string; updatedAt: string },
+  role?: Role
+) {
+  return {
+    id: doc.id,
+    title: doc.title,
+    content: doc.content,
+    folderId: doc.folderId,
+    ownerId: doc.ownerId,
+    ...(role !== undefined ? { role } : {}),
+    createdAt: doc.createdAt,
+    updatedAt: doc.updatedAt,
+  };
+}
+
+export function createDocumentsRouter(store: Store): Router {
+  const router = Router();
+
+  router.post('/documents', (req: Request, res: Response): void => {
+    const userId = req.userId!;
+    const { title, content, folderId } = req.body ?? {};
+
+    if (!title || !folderId) {
+      res.status(400).json({ error: 'title and folderId are required' });
+      return;
+    }
+
+    if (!store.folders.has(folderId)) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+
+    const folderRole = getEffectiveFolderRole(store, folderId, userId);
+    if (!folderRole || folderRole === 'viewer') {
+      res.status(403).json({ error: 'Insufficient permissions' });
+      return;
+    }
+
+    const id = newId();
+    const now = new Date().toISOString();
+    const doc = {
+      id,
+      title,
+      content: content ?? '',
+      folderId,
+      ownerId: userId,
+      permissions: new Map<string, Role>(),
+      createdAt: now,
+      updatedAt: now,
+    };
+    store.documents.set(id, doc);
+    logActivity(store, 'document_created', userId, 'document', id);
+
+    res.status(201).json(serializeDoc(doc));
+  });
+
+  router.get('/documents/:id', (req: Request, res: Response): void => {
+    const userId = req.userId!;
+    const doc = store.documents.get(req.params.id);
+
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+
+    const role = getEffectiveDocumentRole(store, doc.id, userId);
+    if (!role) {
+      res.status(403).json({ error: 'Insufficient permissions' });
+      return;
+    }
+
+    res.json(serializeDoc(doc, role));
+  });
+
+  router.put('/documents/:id', (req: Request, res: Response): void => {
+    const userId = req.userId!;
+    const doc = store.documents.get(req.params.id);
+
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+
+    const role = getEffectiveDocumentRole(store, doc.id, userId);
+    if (!role || role === 'viewer') {
+      res.status(403).json({ error: 'Insufficient permissions' });
+      return;
+    }
+
+    const { title, content } = req.body ?? {};
+    if (title !== undefined) doc.title = title;
+    if (content !== undefined) doc.content = content;
+    doc.updatedAt = new Date().toISOString();
+
+    logActivity(store, 'document_updated', userId, 'document', doc.id);
+
+    res.json(serializeDoc(doc));
+  });
+
+  router.delete('/documents/:id', (req: Request, res: Response): void => {
+    const userId = req.userId!;
+    const doc = store.documents.get(req.params.id);
+
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+
+    const role = getEffectiveDocumentRole(store, doc.id, userId);
+    if (role !== 'owner') {
+      res.status(403).json({ error: 'Insufficient permissions' });
+      return;
+    }
+
+    store.documents.delete(doc.id);
+    logActivity(store, 'document_deleted', userId, 'document', doc.id);
+
+    res.status(204).send();
+  });
+
+  router.post('/documents/:id/share', (req: Request, res: Response): void => {
+    const userId = req.userId!;
+    const doc = store.documents.get(req.params.id);
+
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+
+    const requesterRole = getEffectiveDocumentRole(store, doc.id, userId);
+    if (!requesterRole || requesterRole === 'viewer') {
+      res.status(403).json({ error: 'Insufficient permissions' });
+      return;
+    }
+
+    const { userId: targetId, role } = req.body ?? {};
+
+    if (!targetId || !role) {
+      res.status(400).json({ error: 'userId and role are required' });
+      return;
+    }
+
+    if (!['viewer', 'editor', 'owner'].includes(role)) {
+      res.status(400).json({ error: 'Invalid role' });
+      return;
+    }
+
+    if (!store.users.has(targetId)) {
+      res.status(404).json({ error: 'User not found' });
+      return;
+    }
+
+    doc.permissions.set(targetId, role as Role);
+    logActivity(store, 'document_shared', userId, 'document', doc.id);
+
+    res.json({ message: 'Shared successfully' });
+  });
+
+  return router;
+}
