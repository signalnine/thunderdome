+import type { EventBus } from '../bus.js';
+import type { NotificationService } from '../types.js';
+import { Events } from '../types.js';
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribed = new Set<string>();
+  const orderToUser = new Map<string, string>();
+  const userNotifications = new Map<string, Array<{ type: string; message: string; timestamp: number }>>();
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const { orderId, userId } = payload as { orderId: string; userId: string };
+    orderToUser.set(orderId, userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    const { orderId, status } = payload as { orderId: string; status: string };
+    const userId = orderToUser.get(orderId);
+    if (!userId || !subscribed.has(userId)) return;
+    const notif = {
+      type: 'order_status',
+      message: `Order ${orderId} status changed to ${status}`,
+      timestamp: Date.now(),
+    };
+    if (!userNotifications.has(userId)) userNotifications.set(userId, []);
+    userNotifications.get(userId)!.push(notif);
+    void bus.emit(Events.NOTIFICATION_SENT, { userId, type: notif.type, message: notif.message });
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const { orderId, status } = payload as { orderId: string; status: string };
+    const userId = orderToUser.get(orderId);
+    if (!userId || !subscribed.has(userId)) return;
+    const notif = {
+      type: 'payment',
+      message: `Payment ${status} for order ${orderId}`,
+      timestamp: Date.now(),
+    };
+    if (!userNotifications.has(userId)) userNotifications.set(userId, []);
+    userNotifications.get(userId)!.push(notif);
+    void bus.emit(Events.NOTIFICATION_SENT, { userId, type: notif.type, message: notif.message });
+  });
+
+  return {
+    subscribe(userId) {
+      subscribed.add(userId);
+    },
+    getNotifications(userId) {
+      return userNotifications.get(userId) ?? [];
+    },
+  };
+}
