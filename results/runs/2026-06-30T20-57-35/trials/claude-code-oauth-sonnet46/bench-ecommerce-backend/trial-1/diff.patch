+import { randomUUID } from 'crypto';
+import type { EventBus } from '../bus.js';
+import type { CartService } from '../types.js';
+import { Events } from '../types.js';
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, { id: string; userId: string; items: Array<{ productId: string; quantity: number }> }>();
+
+  function emitUpdate(cartId: string) {
+    const cart = carts.get(cartId);
+    if (cart) {
+      void bus.emit(Events.CART_UPDATED, { cartId, userId: cart.userId, items: [...cart.items] });
+    }
+  }
+
+  return {
+    createCart(userId) {
+      const id = randomUUID();
+      carts.set(id, { id, userId, items: [] });
+      return id;
+    },
+    addItem(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const existing = cart.items.find(i => i.productId === productId);
+      if (existing) {
+        existing.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      emitUpdate(cartId);
+    },
+    removeItem(cartId, productId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items = cart.items.filter(i => i.productId !== productId);
+      emitUpdate(cartId);
+    },
+    getCart(cartId) {
+      const cart = carts.get(cartId);
+      return cart ? { id: cart.id, userId: cart.userId, items: [...cart.items] } : null;
+    },
+    clearCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items = [];
+      emitUpdate(cartId);
+    },
+    updateQuantity(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const item = cart.items.find(i => i.productId === productId);
+      if (item) item.quantity = quantity;
+      emitUpdate(cartId);
+    },
+  };
+}
