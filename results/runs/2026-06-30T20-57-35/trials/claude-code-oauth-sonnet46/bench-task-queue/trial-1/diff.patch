{\n    queue.schedule('work', '*/5 * * * *', { type: 'every-5' });\n    queue.schedule('work', '*/10 * * * *', { type: 'every-10' });\n\n    // At 5 minutes, only every-5 triggers\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const tasks5 = [];\n    let t;\n    while ((t = queue.dequeue('work')) !== null) {\n      tasks5.push(t);\n    }\n    expect(tasks5.length).toBe(1);\n    expect(tasks5[0].payload).toEqual({ type: 'every-5' });\n\n    // At 10 minutes, both trigger\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const tasks10 = [];\n    while ((t = queue.dequeue('work')) !== null) {\n      tasks10.push(t);\n    }\n    expect(tasks10.length).toBe(2);\n    const types = tasks10.map(t => t.payload.type).sort();\n    expect(types).toEqual(['every-10', 'every-5']);\n  });\n});\n```\n\n## phase-11.test.ts\n```typescript\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 11: Middleware Pipeline', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('middleware runs before task processing', async () => {\n    const log: string[] = [];\n\n    queue.use('work', async (_task, next) => {\n      log.push('middleware');\n      await next();\n    });\n\n    queue.enqueue('work', { job: 'test' });\n\n    await queue.process('work', async () => {\n      log.push('handler');\n    });\n\n    expect(log).toEqual(['middleware', 'handler']);\n  });\n\n  it('multiple middlewares run in the order they were added', async () => {\n    const log: string[] = [];\n\n    queue.use('work', async (_task, next) => {\n      log.push('first');\n      await next();\n    });\n\n    queue.use('work', async (_task, next) => {\n      log.push('second');\n      await next();\n    });\n\n    queue.use('work', async (_task, next) => {\n      log.push('third');\n      await next();\n    });\n\n    queue.enqueue('work', { job: 'test' });\n\