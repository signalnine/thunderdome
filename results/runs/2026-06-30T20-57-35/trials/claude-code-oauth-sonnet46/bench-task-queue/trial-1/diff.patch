+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MrVLFCNfdeeadw25ShPaon","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\n2\timport { TaskQueue } from '../src/index.js';\n3\t\n4\tdescribe('Phase 9: Progress and Cancellation', () => {\n5\t  let queue: TaskQueue;\n6\t\n7\t  beforeEach(() => {\n8\t    vi.useFakeTimers();\n9\t    queue = new TaskQueue();\n10\t  });\n11\t\n12\t  afterEach(() => {\n13\t    vi.useRealTimers();\n14\t  });\n15\t\n16\t  it('updateProgress sets the percentage for a task', () => {\n17\t    queue.enqueue('work', { job: 'progress' });\n18\t    const task = queue.dequeue('work')!;\n19\t\n20\t    queue.updateProgress(task.id, 50);\n21\t    const progress = queue.getProgress(task.id);\n22\t    expect(progress!.percent).toBe(50);\n23\t  });\n24\t\n25\t  it('getProgress returns current progress info', () => {\n26\t    queue.enqueue('work', { job: 'progress' });\n27\t    const task = queue.dequeue('work')!;\n28\t\n29\t    queue.updateProgress(task.id, 75, 'Almost done');\n30\t    const progress = queue.getProgress(task.id);\n31\t\n32\t    expect(progress).not.toBeNull();\n33\t    expect(progress!.percent).toBe(75);\n34\t    expect(progress!.message).toBe('Almost done');\n35\t    expect(progress!.updatedAt).toBeInstanceOf(Date);\n36\t  });\n37\t\n38\t  it('onProgress callback fires when progress is updated', () => {\n39\t    queue.enqueue('work', { job: 'callback' });\n40\t    const task = queue.dequeue('work')!;\n41\t\n42\t    const updates: Array<{ percent: number; message?: string }> = [];\n43\t    queue.onProgress(task.id, (info) => {\n44\t      updates.push({ percent: info.percent, message: info.message });\n45\t    });\n46\t\n47\t    queue.updateProgress(task.id, 25, 'Starting');\n48\t    queue.updateProgress(task.id, 50, 'Halfway');\n49\t    queue.updateProgress(task.id, 100, 'Done');\n50\t\n51\t    expect(updates).toHaveLength(3);\n52\t    expect(updates[0]).toEqual({ percent: 25, message: 'Starting' });\n53\t    expect(updates[1]).toEqual({ percent: 50, message: 'Halfway' });\n54\t    expect(updates[2]).toEqual({ percent: 100, message: 'Done' });\n55\t  });\n56\t\n57\t  it('cancel sets task status to cancelled', () => {\n58\t    const task = queue.enqueue('work', { job: 'cancel-me' });\n59\t    queue.cancel(task.id);\n60\t    expect(task.status).toBe('cancelled');\n61\t  });\n62\t\n63\t  it('cancelled pending task is removed from the queue', () => {\n64\t    queue.enqueue('work', { job: 'stay' });\n65\t    const toCancel = queue.enqueue('work', { job: 'cancel' });\n66\t    queue.enqueue('work', { job: 'stay2' });\n67\t\n68\t    queue.cancel(toCancel.id);\n69\t\n70\t    const t1 = queue.dequeue('work')!;\n71\t    const t2 = queue.dequeue('work')!;\n72\t    expect(t1.payload).toEqual({ job: 'stay' });\n73\t    expect(t2.payload).toEqual({ job: 'stay2' });\n74\t    expect(queue.dequeue('work')).toBeNull();\n75\t  });\n76\t\n77\t  it('cancelled processing task has its status set to cancelled', () => {\n78\t    queue.enqueue('work', { job: 'processing-cancel' });\n79\t    const task = queue.dequeue('work')!;\n80\t    expect(task.status).toBe('processing');\n81\t\n82\t    queue.cancel(task.id);\n83\t    expect(task.status).toBe('cancelled');\n84\t  });\n85\t\n86\t  it('cancelled task is not retried', () => {\n87\t    queue.enqueue('work', { job: 'no-retry' }, { maxRetries: 3 });\n88\t    const task = queue.dequeue('work')!;\n89\t\n90\t    queue.cancel(task.id);\n91\t\n92\t    // Even after long delay, cancelled task should not reappear\n93\t    vi.advanceTimersByTime(100000);\n94\t    expect(queue.dequeue('work')).toBeNull();\n95\t  });\n96\t\n97\t  it('progress message is optional', () => {\n98\t    queue.enqueue('work', { job: 'no-msg' });\n99\t    const task = queue.dequeue('work')!;\n100\t\n101\t    queue.updateProgress(task.id, 42);\n102\t    const progress = queue.getProgress(task.id);\n103\t\n104\t    expect(progress!