l();\n57\t\n58\t    // DLQ should be empty now\n59\t    expect(queue.getDLQ('emails').length).toBe(0);\n60\t\n61\t    // Task should be back in the queue\n62\t    const dequeued = queue.dequeue('emails');\n63\t    expect(dequeued).not.toBeNull();\n64\t    expect(dequeued!.id).toBe(task.id);\n65\t  });\n66\t\n67\t  it('clearDLQ removes all DLQ tasks for a queue', () => {\n68\t    queue.enqueue('work', { job: 'clear1' }, { maxRetries: 0 });\n69\t    queue.enqueue('work', { job: 'clear2' }, { maxRetries: 0 });\n70\t\n71\t    const t1 = queue.dequeue('work')!;\n72\t    queue.fail(t1.id, 'error');\n73\t    const t2 = queue.dequeue('work')!;\n74\t    queue.fail(t2.id, 'error');\n75\t\n76\t    expect(queue.getDLQ('work').length).toBe(2);\n77\t    queue.clearDLQ('work');\n78\t    expect(queue.getDLQ('work').length).toBe(0);\n79\t  });\n80\t\n81\t  it('DLQ task retains original error information', () => {\n82\t    queue.enqueue('work', { job: 'error-info' }, { maxRetries: 0 });\n83\t\n84\t    const task = queue.dequeue('work')!;\n85\t    queue.fail(task.id, 'specific error message');\n86\t\n87\t    const dlq = queue.getDLQ('work');\n88\t    expect(dlq[0].lastError).toBe('specific error message');\n89\t  });\n90\t\n91\t  it('DLQ task tracks failure count', () => {\n92\t    queue.enqueue('work', { job: 'count-fails' }, { maxRetries: 2 });\n93\t\n94\t    // Fail through all retries\n95\t    for (let i = 0; i < 2; i++) {\n96\t      const task = queue.dequeue('work')!;\n97\t      queue.fail(task.id, `error ${i}`);\n98\t      vi.advanceTimersByTime(1000 * Math.pow(2, i));\n99\t    }\n100\t    const lastAttempt = queue.dequeue('work')!;\n101\t    queue.fail(lastAttempt.id, 'final error');\n102\t\n103\t    const dlq = queue.getDLQ('work');\n104\t    expect(dlq[0].failCount).toBe(3); // original + 2 retries = 3 failures\n105\t  });\n106\t\n107\t  it('retried DLQ task gets a fresh retry count', () => {\n108\t    queue.enqueue('work', { job: 'fresh-retries' }, { maxRetries: 1 });\n109\