= new Date();\n        this.ensureQueue(queueName);\n        this.queues.get(queueName)!.push(task);\n      } else {\n        const newTask: Task = {\n          id: entry.id,\n          payload: entry.payload,\n          status: 'pending',\n          createdAt: entry.createdAt,\n          priority: entry.priority,\n          availableAt: new Date(),\n          attempts: 0,\n          queueName: entry.queueName,\n          maxRetries: entry.maxRetries,\n          backoffMs: entry.backoffMs,\n          dependsOn: entry.dependsOn,\n        };\n        this.allTasks.set(newTask.id, newTask);\n        this.ensureQueue(queueName);\n        this.queues.get(queueName)!.push(newTask);\n      }\n      return entry;\n    }\n    return null;\n  }\n\n  clearDLQ(queueName: string): void {\n    this.dlq.set(queueName, []);\n  }\n\n  getDependencies(taskId: string): Array<{ taskId: string; status: string }> {\n    const task = this.allTasks.get(taskId);\n    if (!task) return [];\n    return task.dependsOn.map(depId => {\n      const dep = this.allTasks.get(depId);\n      return { taskId: depId, status: dep?.status ?? 'unknown' };\n    });\n  }\n\n  setConcurrency(queueName: string, limit: number): void {\n    this.concurrency.set(queueName, limit);\n    if (!this.currentProcessing.has(queueName)) {\n      this.currentProcessing.set(queueName, 0);\n    }\n  }\n\n  getConcurrency(queueName: string): ConcurrencyInfo {\n    return {\n      current: this.currentProcessing.get(queueName) ?? 0,\n      max: this.concurrency.get(queueName) ?? Infinity,\n    };\n  }\n\n  updateProgress(taskId: string, percent: number, message?: string): void {\n    const info: ProgressInfo = { percent, updatedAt: new Date() };\n    if (message !== undefined) info.message = message;\n    this.progress.set(taskId, info);\n\n    const callbacks = this.progressCallbacks.get(taskId);\n    if (callbacks) {\n      for (const cb of callbacks) cb(info);\n    }\n  }\n\n  getProgress(taskId: string): ProgressInfo | nu