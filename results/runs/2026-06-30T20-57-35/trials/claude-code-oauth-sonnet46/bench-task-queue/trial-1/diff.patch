it shutdownPromise;\n\n    expect(() => queue.enqueue('work', { job: 'rejected' })).toThrow();\n  });\n\n  it('shutdown with no processing tasks resolves immediately', async () => {\n    queue.enqueue('work', { job: 'pending-only' });\n    // Don't dequeue - nothing is processing\n\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    const summary = await shutdownPromise;\n\n    expect(summary.completed).toBe(0);\n    expect(summary.cancelled).toBe(0);\n    expect(summary.elapsed).toBeLessThanOrEqual(100);\n  });\n});\n```\n\nAll 12 test files have been read and displayed above with their complete contents verbatim. These tests define a comprehensive TaskQueue implementation with 12 phases:\n\n1. **Phase 1**: Basic FIFO queue operations\n2. **Phase 2**: Named queues\n3. **Phase 3**: Priority handling\n4. **Phase 4**: Delayed/scheduled tasks\n5. **Phase 5**: Retry with exponential backoff\n6. **Phase 6**: Dead letter queue (DLQ)\n7. **Phase 7**: Task dependencies\n8. **Phase 8**: Concurrency control\n9. **Phase 9**: Progress tracking and cancellation\n10. **Phase 10**: Recurring cron-based tasks\n11. **Phase 11**: Middleware pipeline system\n12. **Phase 12**: Graceful shutdown"}]}]},"parent_tool_use_id":null,"session_id":"0f122924-a0ea-4945-8ed2-52b5e52c9c41","uuid":"dd21c9d5-c0a0-46b7-9cc3-0b155f6e173d","timestamp":"2026-06-30T21:00:45.330Z","tool_use_result":{"status":"completed","prompt":"Read ALL files in /workspace/tests/ directory. I need the complete content of every test file (phase-01.test.ts through phase-12.test.ts). Please read them all and return their complete contents verbatim. These are TypeScript vitest test files and I need every line.","agentId":"a1ea29378faec2af4","agentType":"Explore","content":[{"type":"text","text":"Here are the complete contents of all 12 test files from /workspace/tests/:\n\n## phase-01.test.ts\n```typescript\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 1: Basic FIFO Queue', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('enqueue returns a task with id and pending status', () => {\n    const task = queue.enqueue('default', { type: 'email', to: 'user@test.com' });\n    expect(task).toHaveProperty('id');\n    expect(typeof task.id).toBe('string');\n    expect(task.id.length).toBeGreaterThan(0);\n    expect(task.status).toBe('pending');\n    expect(task.payload).toEqual({ type: 'email', to: 'user@test.com' });\n  });\n\n  it('dequeue returns tasks in FIFO order', () => {\n    queue.enqueue('default', { order: 1 });\n    queue.enqueue('default', { order: 2 });\n    queue.enqueue('default', { order: 3 });\n\n    const first = queue.dequeue('default');\n    const second = queue.dequeue('default');\n    const third = queue.dequeue('default');\n\n    expect(first!.payload).toEqual({ order: 1 });\n    expect(second!.payload).toEqual({ order: 2 });\n    expect(third!.payload).toEqual({ order: 3 });\n  });\n\n  it('dequeue returns null when queue is empty', () => {\n    const result = queue.dequeue('default');\n    expect(result).toBeNull();\n  });\n\n  it('size returns the correct count of pending tasks', () => {\n    expect(queue.size()).toBe(0);\n    queue.enqueue('default', { a: 1 });\n    queue.enqueue('default', { a: 2 });\n    expect(queue.size()).toBe(2);\n    queue.dequeue('default');\n    expect(queue.size()).toBe(1);\n  });\n\n  it('dequeued task has processing status', () => {\n    queue.enqueue('default', { job: 'process' });\n    const task = queue.dequeue('default');\n    expect(task!.status).toBe('processing');\n  });\n\n  it('task has a createdAt timestamp', () => {\n    const before = new Date();\n    const task = queue.enqueue('default', { data: 'test' });\n    const after = new Date();\n\n    expect(task.createdAt).toBeInstanceOf(Date);\n    expect(task.createdAt.getTime()).toBeGreaterThanOrEqual(before.getTime