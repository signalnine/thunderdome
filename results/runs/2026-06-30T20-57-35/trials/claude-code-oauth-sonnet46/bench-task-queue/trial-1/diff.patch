+let idCounter = 0;
+function generateId(): string {
+  return `task-${Date.now()}-${++idCounter}-${Math.random().toString(36).slice(2, 9)}`;
+}
+
+type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';
+
+export interface Task {
+  id: string;
+  payload: Record<string, unknown>;
+  status: TaskStatus;
+  createdAt: Date;
+  priority: number;
+  availableAt: Date;
+  attempts: number;
+  queueName: string;
+  maxRetries: number;
+  backoffMs: number;
+  dependsOn: string[];
+}
+
+interface DLQEntry {
+  id: string;
+  payload: Record<string, unknown>;
+  status: TaskStatus;
+  createdAt: Date;
+  priority: number;
+  queueName: string;
+  maxRetries: number;
+  backoffMs: number;
+  dependsOn: string[];
+  lastError: string;
+  failCount: number;
+}
+
+interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: Record<string, unknown>;
+  active: boolean;
+  lastRun: Date | null;
+  createdAt: Date;
+}
+
+interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+
+interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+export class TaskQueue {
+  private queues: Map<string, Task[]> = new Map();
+  private allTasks: Map<string, Task> = new Map();
+  private dlq: Map<string, DLQEntry[]> = new Map();
+  private concurrency: Map<string, number> = new Map();
+  private currentProcessing: Map<string, number> = new Map();
+  private progress: Map<string, ProgressInfo> = new Map();
+  private progressCallbacks: Map<string, Array<(info: ProgressInfo) => void>> = new Map();
+  private schedules: Map<string, Schedule> = new Map();
+  private middlewares: Map<string, Middleware[]> = new Map();
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private shutdownResolve: ((s: ShutdownSummary) => void) | null = null;
+  private shutdownStartTime: number | null = null;
+  private shutdownTimeout: number = 30000;
+  private shutdownCallbacks: Array<() => void> = [];
+  private isShuttingDown = false;
+  private processingTasks: Set<string> = new Set();
+  private completedDuringShutdown = 0;
+  private cancelledDuringShutdown = 0;
+
+  private ensureQueue(name: string): Task[] {
+    if (!this.queues.has(name)) {
+      this.queues.set(name, []);
+    }
+    return this.queues.get(name)!;
+  }
+
+  enqueue(queueName: string, payload: Record<string, unknown>, options: {
+    priority?: number;
+    delay?: number;
+    runAt?: Date;
+    maxRetries?: number;
+    backoffMs?: number;
+    dependsOn?: string[];
+  } = {}): Task {
+    if (this.isShuttingDown) {
+      throw new Error('Queue is shutting down, no new tasks accepted');
+    }
+
+    const priority = options.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error(`Priority must be between 1 and 10, got ${priority}`);
+    }
+
+    const dependsOn = options.dependsOn ?? [];
+    for (const depId of dependsOn) {
+      if (!this.allTasks.has(depId)) {
+        throw new Error(`Dependency task ${depId} does not exist`);
+      }
+    }
+
+    // Circular dependency check
+    if (dependsOn.length > 0) {
+      const visited = new Set<string>();
+      const depsToCheck = [...dependsOn];
+      while (depsToCheck.length > 0) {
+        const depId = depsToCheck.pop()!;
+        if (visited.has(depId)) continue;
+        visited.add(depId);
+        const depTask = this.allTasks.get(depId);
+        if (depTask) {
+          depsToCheck.push(...depTask.dependsOn);
+        }
+      }
+    }
+
+    let availableAt = new Date();
+    if (options.runAt) {
+      availableAt = options.runAt;
+    } else if (options.delay) {
+      availableAt = new Date(Date.now() + options.delay);
+    }
+
+    const task: Task = {
+      id: generateId(),
+      payload,
+      status: 'pending',
+      createdAt: new Date(),
+      priority,
+      availableAt,
+      attempts: 0,
+      queueName,
+      maxRetries: options.maxRetries ?? 3,
+      backoffMs: options.backoffMs ?? 1000,
+      dependsOn,
+    };
+
+    this.ensureQueue(queueName);
+    this.queues.get(queueName)!.push(task);
+    this.allTasks.set(task.id, task);
+    return task;
+  }
+
+  private isAvailable(task: Task): boolean {
+    if (task.status !== 'pending') return false;
+    if (Date.now() < task.availableAt.getTime()) return false;
+    // Check dependencies
+    for (const depId of task.dependsOn) {
+      const dep = this.allTasks.get(depId);
+      if (!dep || dep.status !== 'completed') return false;
+    }
+    return true;
+  }
+
+  dequeue(queueName: string): Task | null {
+    const q = this.queues.get(queueName);
+    if (!q || q.length === 0) return null;
+
+    // Check concurrency
+    const maxConcurrency = this.concurrency.get(queueName);
+    if (maxConcurrency !== undefined) {
+      const current = this.currentProcessing.get(queueName) ?? 0;
+      if (current >= maxConcurrency) return null;
+    }
+
+    // Find best available task: by priority (asc), then FIFO (insertion order)
+    let bestIndex = -1;
+    let bestTask: Task | null = null;
+
+    for (let i = 0; i < q.length; i++) {
+      const task = q[i];
+      if (!this.isAvailable(task)) continue;
+      if (
+        bestTask === null ||
+        task.priority < bestTask.priority ||
+        (task.priority === bestTask.priority && task.availableAt < bestTask.availableAt)
+      ) {
+        bestIndex = i;
+        bestTask = task;
+      }
+    }
+
+    if (!bestTask || bestIndex === -1) return null;
+
+    q.splice(bestIndex, 1);
+    bestTask.status = 'processing';
+    bestTask.attempts += 1;
+
+    if (maxConcurrency !== undefined) {
+      this.currentProcessing.set(queueName, (this.currentProcessing.get(queueName) ?? 0) + 1);
+    }
+
+    this.processingTasks.add(bestTask.id);
+    return bestTask;
+  }
+
+  size(): number {
+    let total = 0;
+    for (const q of this.queues.values()) {
+      total += q.filter(t => t.status === 'pending').length;
+    }
+    return total;
+  }
+
+  queueSize(queueName: string): number {
+    return this.queues.get(queueName)?.filter(t => t.status === 'pending').length ?? 0;
+  }
+
+  listQueues(): string[] {
+    return Array.from(this.queues.keys());
+  }
+
+  complete(taskId: string): void {
+    const task = this.allTasks.get(taskId);
+    if (!task) return;
+    task.status = 'completed';
+    this.processingTasks.delete(taskId);
+
+    const current = this.currentProcessing.get(task.queueName) ?? 0;
+    if (current > 0) {
+      this.currentProcessing.set(task.queueName, current - 1);
+    }
+
+    if (this.isShuttingDown) {
+      this.completedDuringShutdown++;
+      this.checkShutdownComplete();
+    }
+  }
+
+  fail(taskId: string, error?: string): void {
+    const task = this.allTasks.get(taskId);
+    if (!task) return;
+
+    // If cancelled, don't retry
+    if (task.status === 'cancelled') return;
+
+    this.processingTasks.delete(taskId);
+
+    const current = this.currentProcessing.get(task.queueName) ?? 0;
+    if (current > 0) {
+      this.currentProcessing.set(task.queueName, current - 1);
+    }
+
+    const attemptsUsed = task.attempts;
+    const totalAllowed = task.maxRetries + 1;
+
+    if (attemptsUsed < totalAllowed) {
+      // Retry with backoff
+      const backoffDelay = task.backoffMs * Math.pow(2, attemptsUsed - 1);
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + backoffDelay);
+      this.ensureQueue(task.queueName);
+      this.queues.get(task.queueName)!.push(task);
+    } else {
+      // Move to DLQ
+      task.status = 'failed';
+      const dlqEntry: DLQEntry = {
+        id: task.id,
+        payload: task.payload,
+        status: 'failed',
+        createdAt: task.createdAt,
+        priority: task.priority,
+        queueName: task.queueName,
+        maxRetries: task.maxRetries,
+        backoffMs: task.backoffMs,
+        dependsOn: task.dependsOn,
+        lastError: error ?? '',
+        failCount: attemptsUsed,
+      };
+      if (!this.dlq.has(task.queueName)) {
+        this.dlq.set(task.queueName, []);
+      }
+      this.dlq.get(task.queueName)!.push(dlqEntry);
+
+      if (this.isShuttingDown) {
+        this.checkShutdownComplete();
+      }
+    }
+  }
+
+  getDLQ(queueName: string): DLQEntry[] {
+    return this.dlq.get(queueName) ?? [];
+  }
+
+  retryDLQ(taskId: string): DLQEntry | null {
+    for (const [queueName, entries] of this.dlq.entries()) {
+      const idx = entries.findIndex(e => e.id === taskId);
+      if (idx === -1) continue;
+      const entry = entries[idx];
+      entries.splice(idx, 1);
+
+      // Reset task
+      const task = this.allTasks.get(taskId);
+      if (task) {
+        task.status = 'pending';
+        task.attempts = 0;
+        task.availableAt = new Date();
+        this.ensureQueue(queueName);
+        this.queues.get(queueName)!.push(task);
+      } else {
+        const newTask: Task = {
+          id: entry.id,
+          payload: entry.payload,
+          status: 'pending',
+          createdAt: entry.createdAt,
+          priority: entry.priority,
+          availableAt: new Date(),
+          attempts: 0,
+          queueName: entry.queueName,
+          maxRetries: entry.maxRetries,
+          backoffMs: entry.backoffMs,
+          dependsOn: entry.dependsOn,
+        };
+        this.allTasks.set(newTask.id, newTask);
+        this.ensureQueue(queueName);
+        this.queues.get(queueName)!.push(newTask);
+      }
+      return entry;
+    }
+    return null;
+  }
+
+  clearDLQ(queueName: string): void {
+    this.dlq.set(queueName, []);
+  }
+
+  getDependencies(taskId: string): Array<{ taskId: string; status: string }> {
+    const task = this.allTasks.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map(depId => {
+      const dep = this.allTasks.get(depId);
+      return { taskId: depId, status: dep?.status ?? 'unknown' };
+    });
+  }
+
+  setConcurrency(queueName: string, limit: number): void {
+    this.concurrency.set(queueName, limit);
+    if (!this.currentProcessing.has(queueName)) {
+      this.currentProcessing.set(queueName, 0);
+    }
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    return {
+      current: this.currentProcessing.get(queueName) ?? 0,
+      max: this.concurrency.get(queueName) ?? Infinity,
+    };
+  }
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    const info: ProgressInfo = { percent, updatedAt: new Date() };
+    if (message !== undefined) info.message = message;
+    this.progress.set(taskId, info);
+
+    const callbacks = this.progressCallbacks.get(taskId);
+    if (callbacks) {
+      for (const cb of callbacks) cb(info);
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progress.get(taskId) ?? null;
+  }
+
+  onProgress(taskId: string, callback: (info: ProgressInfo) => void): () => void {
+    if (!this.progressCallbacks.has(taskId)) {
+      this.progressCallbacks.set(taskId, []);
+    }
+    this.progressCallbacks.get(taskId)!.push(callback);
+    return () => {
+      const cbs = this.progressCallbacks.get(taskId);
+      if (cbs) {
+        const idx = cbs.indexOf(callback);
+        if (idx !== -1) cbs.splice(idx, 1);
+      }
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.allTasks.get(taskId);
+    if (!task) return;
+    task.status = 'cancelled';
+
+    // Remove from queue if pending
+    for (const [, q] of this.queues.entries()) {
+      const idx = q.findIndex(t => t.id === taskId);
+      if (idx !== -1) {
+        q.splice(idx, 1);
+        break;
+      }
+    }
+
+    this.processingTasks.delete(taskId);
+  }
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: Record<string, unknown>): Schedule {
+    const schedule: Schedule = {
+      id: generateId(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+      lastRun: null,
+      createdAt: new Date(),
+    };
+    this.schedules.set(schedule.id, schedule);
+    return schedule;
+  }
+
+  unschedule(scheduleId: string): void {
+    const s = this.schedules.get(scheduleId);
+    if (s) s.active = false;
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const result: Schedule[] = [];
+    for (const s of this.schedules.values()) {
+      if (!s.active) continue;
+      if (queueName && s.queueName !== queueName) continue;
+      result.push(s);
+    }
+    return result;
+  }
+
+  private parseCron(expr: string): { intervalMinutes: number } | null {
+    // Support: */N * * * *  (every N minutes)
+    const everyN = expr.match(/^\*\/(\d+) \* \* \* \*$/);
+    if (everyN) return { intervalMinutes: parseInt(everyN[1], 10) };
+
+    // Support: 0 * * * * (every hour)
+    if (expr === '0 * * * *') return { intervalMinutes: 60 };
+
+    // Support: 0 0 * * * (every day)
+    if (expr === '0 0 * * *') return { intervalMinutes: 24 * 60 };
+
+    return null;
+  }
+
+  tick(): void {
+    const now = Date.now();
+    for (const schedule of this.schedules.values()) {
+      if (!schedule.active) continue;
+
+      const parsed = this.parseCron(schedule.cronExpression);
+      if (!parsed) continue;
+
+      const intervalMs = parsed.intervalMinutes * 60 * 1000;
+      const reference = schedule.lastRun?.getTime() ?? schedule.createdAt.getTime();
+      const elapsed = now - reference;
+
+      if (elapsed >= intervalMs) {
+        const times = Math.floor(elapsed / intervalMs);
+        for (let i = 0; i < times; i++) {
+          this.enqueue(schedule.queueName, { ...schedule.taskTemplate });
+        }
+        schedule.lastRun = new Date(now);
+      }
+    }
+  }
+
+  use(queueName: string, middleware: Middleware): void {
+    if (!this.middlewares.has(queueName)) {
+      this.middlewares.set(queueName, []);
+    }
+    this.middlewares.get(queueName)!.push(middleware);
+  }
+
+  async process(queueName: string, handler: (task: Task) => Promise<void>): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const middlewares = this.middlewares.get(queueName) ?? [];
+
+    let called = false;
+    const runMiddleware = async (index: number): Promise<void> => {
+      if (index >= middlewares.length) {
+        called = true;
+        await handler(task);
+        return;
+      }
+      await middlewares[index](task, () => runMiddleware(index + 1));
+    };
+
+    try {
+      await runMiddleware(0);
+      if (!called && middlewares.length === 0) {
+        // no middleware, handler was called above
+      }
+      this.complete(task.id);
+    } catch {
+      this.fail(task.id);
+    }
+  }
+
+  onShutdown(callback: () => void): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  shutdown(timeout: number = 30000): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+
+    this.isShuttingDown = true;
+    this.shutdownStartTime = Date.now();
+    this.shutdownTimeout = timeout;
+    this.completedDuringShutdown = 0;
+    this.cancelledDuringShutdown = 0;
+
+    for (const cb of this.shutdownCallbacks) cb();
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      this.shutdownResolve = resolve;
+
+      const checkDone = () => {
+        if (this.processingTasks.size === 0) {
+          resolve({
+            completed: this.completedDuringShutdown,
+            cancelled: this.cancelledDuringShutdown,
+            elapsed: Date.now() - this.shutdownStartTime!,
+          });
+          return;
+        }
+
+        // Set up timeout
+        const timer = setTimeout(() => {
+          // Force cancel remaining
+          for (const taskId of Array.from(this.processingTasks)) {
+            const task = this.allTasks.get(taskId);
+            if (task) {
+              task.status = 'cancelled';
+              this.cancelledDuringShutdown++;
+            }
+          }
+          this.processingTasks.clear();
+          resolve({
+            completed: this.completedDuringShutdown,
+            cancelled: this.cancelledDuringShutdown,
+            elapsed: Date.now() - this.shutdownStartTime!,
+          });
+        }, timeout);
+
+        // Store timer reference to cancel if tasks complete early
+        this._shutdownTimer = timer;
+      };
+
+      checkDone();
+    });
+
+    return this.shutdownPromise;
+  }
+
+  private _shutdownTimer: ReturnType<typeof setTimeout> | null = null;
+
+  private checkShutdownComplete(): void {
+    if (!this.isShuttingDown || !this.shutdownResolve) return;
+    if (this.processingTasks.size === 0) {
+      if (this._shutdownTimer) {
+        clearTimeout(this._shutdownTimer);
+        this._shutdownTimer = null;
+      }
+      this.shutdownResolve({
+        completed: this.completedDuringShutdown,
+        cancelled: this.cancelledDuringShutdown,
+        elapsed: Date.now() - this.shutdownStartTime!,
+      });
+    }
+  }
+}
