2 });\n    queue.enqueue('reports', { c: 3 });\n\n    const names = queue.listQueues();\n    expect(names).toContain('emails');\n    expect(names).toContain('notifications');\n    expect(names).toContain('reports');\n    expect(names.length).toBe(3);\n  });\n\n  it('queueSize returns the correct count per queue', () => {\n    queue.enqueue('fast', { x: 1 });\n    queue.enqueue('fast', { x: 2 });\n    queue.enqueue('slow', { x: 3 });\n\n    expect(queue.queueSize('fast')).toBe(2);\n    expect(queue.queueSize('slow')).toBe(1);\n  });\n\n  it('uses default queue name when none is specified', () => {\n    queue.enqueue('default', { fallback: true });\n    const task = queue.dequeue('default');\n    expect(task!.payload).toEqual({ fallback: true });\n    expect(queue.listQueues()).toContain('default');\n  });\n\n  it('dequeue from non-existent queue returns null', () => {\n    const result = queue.dequeue('nonexistent');\n    expect(result).toBeNull();\n  });\n});\n```\n\n## phase-03.test.ts\n```typescript\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 3: Priority', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('higher priority task is dequeued first', () => {\n    queue.enqueue('work', { name: 'low' }, { priority: 8 });\n    queue.enqueue('work', { name: 'high' }, { priority: 2 });\n\n    const task = queue.dequeue('work');\n    expect(task!.payload).toEqual({ name: 'high' });\n  });\n\n  it('same priority maintains FIFO order', () => {\n    queue.enqueue('work', { order: 'first' }, { priority: 5 });\n    queue.enqueue('work', { order: 'second' }, { priority: 5 });\n    queue.enqueue('work', { order: 'third' }, { priority: 5 });\n\n    expect(queue.dequeue('work')!.payload).toEqual({ order: 'first' });\n    expect(queue.dequeue('work')!.payload).toEqual({ order: 'second' });\n    expect(queue.dequeue('work')!.payload).toEqual({ order: 'third' });\n  });\n\n  it('default priority is 5', () => {\n    const task = queue.enqueue('work', { test: true });\n    expect(task.priority).toBe(5);\n  });\n\n  it('priority 1 is dequeued before priority 10', () => {\n    queue.enqueue('work', { name: 'lowest' }, { priority: 10 });\n    queue.enqueue('work', { name: 'highest' }, { priority: 1 });\n\n    const task = queue.dequeue('work');\n    expect(task!.payload).toEqual({ name: 'highest' });\n  });\n\n  it('three different priorities dequeue in correct order', () => {\n    queue.enqueue('work', { p: 'medium' }, { priority: 5 });\n    queue.enqueue('work', { p: 'low' }, { priority: 9 });\n    queue.enqueue('work', { p: 'high' }, { priority: 1 });\n\n    expect(queue.dequeue('work')!.payload).toEqual({ p: 'high' });\n    expect(queue.dequeue('work')!.payload).toEqual({ p: 'medium' });\n    expect(queue.dequeue('work')!.payload).toEqual({ p: 'low' });\n  });\n\n  it('later enqueued high priority beats earlier low priority', () => {\n    queue.enqueue('work', { name: 'first-low' }, { priority: 8 });\n    queue.enqueue('work', { name: 'second-high' }, { priority: 2 });\n\n    const task = queue.dequeue('work');\n    expect(task!.payload).toEqual({ name: 'second-high' });\n  });\n\n  it('priority works independently per named queue', () => {\n    queue.enqueue('queue-a', { name: 'a-low' }, { priority: 9 });\n    queue.enqueue('queue-a', { name: 'a-high' }, { priority: 1 });\n    queue.enqueue('queue-b', { name: 'b-only' }, { priority: 7 });\n\n    expect(queue.dequeue('queue-a')!.payload).toEqual({ name: 'a-high' });\n    expect(queue.dequeue('queue-b')!.payload).toEqual({ name: 'b-only' });\n  });\n\n  it('throws error for priority outside 1-10 range', () => {\n    expect(() => queue.enqueue('work', {}, { priority: 0 })).toThrow();\n    expect(() => queue.enqueue('work', {}, { priority: 11 })).toThrow();\n    expect(() => queue.enqueue('work', {}, { priority: -1 })).toThrow();\n  });\n});\n```\n\n## phase-04.test.ts\n```typescript\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 4: Delayed/Scheduled Tasks', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('delayed task is not available immediately', () => {\n    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n    const task = queue.dequeue('work');\n    expect(task).toBeNull();\n  });\n\n  it('delayed task becomes available after delay period', () => {\n    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n\n    vi.advanceTimersByTime(5000);\n\n    const task = queue.dequeue('work');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({ delayed: true });\n  });\n\n  it('runAt task is not available before the specified time', () => {\n    const futureDate = new Date(Date.now() + 10000);\n    queue.enqueue('work', { scheduled: true }, { runAt: futureDate });\n\n    const task = queue.dequeue('work');\n    expect(task).toBeNull();\n  });\n\n  it('runAt task becomes available at the specified time', () => {\n    const futureDate = new Date(Date.now() + 10000);\n    queue.enqueue('work', { scheduled: true }, { runAt: futureDate });\n\n    vi.advanceTimersByTime(10000);\n\n    const task = queue.dequeue('work');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({ scheduled: true });\n  });\n\n  it('non-delayed tasks dequeued before delayed tasks still waiting', () => {\n    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n    queue.enqueue('work', { immediate: true });\n\n    const task = queue.dequeue('work');\n    expect(task!.payload).toEqual({ immediate: true });\n  });\n\n  it('multiple delayed tasks ordered by availability time', () => {\n    queue.enqueue('work', { name: 'later' }, { delay: 10000 });\n    queue.enqueue('work', { name: 'sooner' }, { delay: 3000 });\n\n    vi.advanceTimersByTime(10000);\n\n    const first = queue.dequeue('work');\n    const second = queue.dequeue('work');\n\n    expect(first!.payload).toEqual({ name: 'sooner' });\n    expect(second!.payload).toEqual({ name: 'later' });\n  });\n\n  it('delay works with named queues', () => {\n    queue.enqueue('fast', { name: 'fast-delayed' }, { delay: 2000 });\n    queue.enqueue('slow', { name: 'slow-delayed' }, { delay: 8000 });\n\n    vi.advanceTimersByTime(2000);\n\n    expect(queue.dequeue('fast')).not.toBeNull();\n    expect(queue.dequeue('slow')).toBeNull();\n\n    vi.advanceTimersByTime(6000);\n\n    expect(queue.dequeue('slow')).not.toBeNull();\n  });\n});\n```\n\n## phase-05.test.ts\n```typescript\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 5: Retry with Backoff', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('fail marks a processing task as failed', () => {\n    queue.enqueue('work', { job: 'test' }, { maxRetries: 0 });\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'something went wrong');\n\n    // With maxRetries: 0, no retry - task stays failed\n    expect(task.status).toBe('failed');\n  });\n\n  it('failed task is re-enqueued automatically when retries remain', () => {\n    queue.enqueue('work', { job: 'retry-me' });\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'transient error');\n\n    // After backoff delay, task should be available again\n    vi.advanceTimersByTime(1000); // first retry: 1000ms\n    const retried = queue.dequeue('work');\n    expect(retried).not.toBeNull();\n    expect(retried!.id).toBe(task.id);\n  });\n\n  it('task attempts count is incremented on each retry', () => {\n    queue.enqueue('work', { job: 'count-attempts' });\n    const task = queue.dequeue('work')!;\n    expect(task.attempts).toBe(1);\n\n    queue.fail(task.id, 'error');\n    vi.advanceTimersByTime(1000);\n\n    const retry1 = queue.dequeue('work')!;\n    expect(retry1.attempts).toBe(2);\n  });\n\n  it('backoff delay increases exponentially between retries', () => {\n    queue.enqueue('work', { job: 'backoff-test' });\n\n    // First attempt\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'error 1');\n\n    // First retry after 1000ms (1000 * 2^0)\n    vi.advanceTimersByTime(999);\n    expect(queue.dequeue('work')).toBeNull();\n    vi.advanceTimersByTime(1);\n    expect(queue.dequeue('work')).not.toBeNull();\n\n    queue.fail(task.id, 'error 2');\n\n    // Second retry after 2000ms (1000 * 2^1)\n    vi.advanceTimersByTime(1999);\n    expect(queue.dequeue('work')).toBeNull();\n    vi.advanceTimersByTime(1);\n    expect(queue.dequeue('work')).not.toBeNull();\n\n    queue.fail(task.id, 'error 3');\n\n    // Third retry after 4000ms (1000 * 2^2)\n    vi.advanceTimersByTime(3999);\n    expect(queue.dequeue('work')).toBeNull();\n    vi.advanceTimersByTime(1);\n    expect(queue.dequeue('work')).not.toBeNull();\n  });\n\n  it('respects maxRetries limit (default 3)', () => {\n    queue.enqueue('work', { job: 'limited' });\n\n    for (let i = 0; i < 3; i++) {\n      const task = queue.dequeue('work')!;\n      expect(task).not.toBeNull();\n      queue.fail(task.id, `error ${i + 1}`);\n      vi.advanceTimersByTime(1000 * Math.pow(2, i));\n    }\n\n    // Fourth attempt\n    const lastAttempt = queue.dequeue('work')!;\n    expect(lastAttempt).not.toBeNull();\n    queue.fail(lastAttempt.id, 'final error');\n\n    // No more retries - should not re-appear\n    vi.advanceTimersByTime(100000);\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('accepts custom maxRetries option', () => {\n    queue.enqueue('work', { job: 'custom' }, { maxRetries: 1 });\n\n    // First attempt\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'error 1');\n    vi.advanceTimersByTime(1000);\n\n    // Second attempt (1 retry)\n    const retry = queue.dequeue('work')!;\n    expect(retry).not.toBeNull();\n    queue.fail(retry.id, 'error 2');\n\n    // No more retries\n    vi.advanceTimersByTime(100000);\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('retry preserves the original queue name', () => {\n    queue.enqueue('special-queue', { job: 'preserve-queue' });\n    const task = queue.dequeue('special-queue')!;\n    queue.fail(task.id, 'error');\n    vi.advanceTimersByTime(1000);\n\n    // Should appear in the same queue\n    const retried = queue.dequeue('special-queue');\n    expect(retried).not.toBeNull();\n    expect(retried!.id).toBe(task.id);\n\n    // Should not appear in other queues\n    expect(queue.dequeue('default')).toBeNull();\n  });\n\n  it('retry preserves the original priority', () => {\n    queue.enqueue('work', { job: 'high-pri' }, { priority: 1 });\n    queue.enqueue('work', { job: 'low-pri' }, { priority: 9 });\n\n    const highPri = queue.dequeue('work')!;\n    expect(highPri.payload).toEqual({ job: 'high-pri' });\n    queue.fail(highPri.id, 'error');\n    vi.advanceTimersByTime(1000);\n\n    // The retried high-priority task should still come before low-priority\n    const next = queue.dequeue('work')!;\n    expect(next.payload).toEqual({ job: 'high-pri' });\n  });\n});\n```\n\n## phase-06.test.ts\n```typescript\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 6: Dead Letter Queue', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('task moves to DLQ after exhausting all retries', () => {\n    queue.enqueue('work', { job: 'doomed' }, { maxRetries: 1 });\n\n    // First attempt\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'error 1');\n    vi.advanceTimersByTime(1000);\n\n    // Second attempt (1 retry)\n    const retry = queue.dequeue('work')!;\n    queue.fail(retry.id, 'error 2');\n\n    // Should be in DLQ now\n    const dlq = queue.getDLQ('work');\n    expect(dlq.length).toBe(1);\n    expect(dlq[0].id).toBe(task.id);\n  });\n\n  it('getDLQ returns all dead-letter tasks for a queue', () => {\n    queue.enqueue('work', { job: 'doomed1' }, { maxRetries: 0 });\n    queue.enqueue('work', { job: 'doomed2' }, { maxRetries: 0 });\n\n    const t1 = queue.dequeue('work')!;\n    queue.fail(t1.id, 'error');\n    const t2 = queue.dequeue('work')!;\n    queue.fail(t2.id, 'error');\n\n    const dlq = queue.getDLQ('work');\n    expect(dlq.length).toBe(2);\n  });\n\n  it('retryDLQ moves task back to its original queue', () => {\n    queue.enqueue('emails', { job: 'retry-dlq' }, { maxRetries: 0 });\n\n    const task = queue.dequeue('emails')!;\n    queue.fail(task.id, 'error');\n\n    expect(queue.getDLQ('emails').length).toBe(1);\n\n    const retried = queue.retryDLQ(task.id);\n    expect(retried).not.toBeNull();\n\n    // DLQ should be empty now\n    expect(queue.getDLQ('emails').length).toBe(0);\n\n    // Task should be back in the queue\n    const dequeued = queue.dequeue('emails');\n    expect(dequeued).not.toBeNull();\n    expect(dequeued!.id).toBe(task.id);\n  });\n\n  it('clearDLQ removes all DLQ tasks for a queue', () => {\n    queue.enqueue('work', { job: 'clear1' }, { maxRetries: 0 });\n    queue.enqueue('work', { job: 'clear2' }, { maxRetries: 0 });\n\n    const t1 = queue.dequeue('work')!;\n    queue.fail(t1.id, 'error');\n    const t2 = queue.dequeue('work')!;\n    queue.fail(t2.id, 'error');\n\n    expect(queue.getDLQ('work').length).toBe(2);\n    queue.clearDLQ('work');\n    expect(queue.getDLQ('work').length).toBe(0);\n  });\n\n  it('DLQ task retains original error information', () => {\n    queue.enqueue('work', { job: 'error-info' }, { maxRetries: 0 });\n\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'specific error message');\n\n    const dlq = queue.getDLQ('work');\n    expect(dlq[0].lastError).toBe('specific error message');\n  });\n\n  it('DLQ task tracks failure count', () => {\n    queue.enqueue('work', { job: 'count-fails' }, { maxRetries: 2 });\n\n    // Fail through all retries\n    for (let i = 0; i < 2; i++) {\n      const task = queue.dequeue('work')!;\n      queue.fail(task.id, `error ${i}`);\n      vi.advanceTimersByTime(1000 * Math.pow(2, i));\n    }\n    const lastAttempt = queue.dequeue('work')!;\n    queue.fail(lastAttempt.id, 'final error');\n\n    const dlq = queue.getDLQ('work');\n    expect(dlq[0].failCount).toBe(3); // original + 2 retries = 3 failures\n  });\n\n  it('retried DLQ task gets a fresh retry count', () => {\n    queue.enqueue('work', { job: 'fresh-retries' }, { maxRetries: 1 });\n\n    // Exhaust retries\n    const t1 = queue.dequeue('work')!;\n    queue.fail(t1.id, 'error 1');\n    vi.advanceTimersByTime(1000);\n    const t2 = queue.dequeue('work')!;\n    queue.fail(t2.id, 'error 2');\n\n    // Should be in DLQ\n    expect(queue.getDLQ('work').length).toBe(1);\n\n    // Retry from DLQ\n    queue.retryDLQ(t1.id);\n    const retried = queue.dequeue('work')!;\n    expect(retried).not.toBeNull();\n    expect(retried.attempts).toBe(1); // fresh attempt count\n\n    // Should have fresh retries available\n    queue.fail(retried.id, 'new error');\n    vi.advanceTimersByTime(1000);\n    const retry = queue.dequeue('work');\n    expect(retry).not.toBeNull(); // can retry again\n  });\n});\n```\n\n## phase-07.test.ts\n```typescript\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 7: Task Dependencies', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('task with dependencies is not available until deps complete', () => {\n    const dep = queue.enqueue('work', { name: 'dependency' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n\n    // Dequeue should return the dependency first (no deps blocking it)\n    const first = queue.dequeue('work');\n    expect(first!.payload).toEqual({ name: 'dependency' });\n\n    // Dependent should not be available yet\n    const second = queue.dequeue('work');\n    expect(second).toBeNull();\n  });\n\n  it('completing a dependency makes dependent task available', () => {\n    const dep = queue.enqueue('work', { name: 'dependency' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n\n    const task = queue.dequeue('work')!;\n    queue.complete(task.id);\n\n    // Now the dependent should be available\n    const dependent = queue.dequeue('work');\n    expect(dependent).not.toBeNull();\n    expect(dependent!.payload).toEqual({ name: 'dependent' });\n  });\n\n  it('all dependencies must complete before dependent is available', () => {\n    const dep1 = queue.enqueue('work', { name: 'dep1' });\n    const dep2 = queue.enqueue('work', { name: 'dep2' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep1.id, dep2.id] });\n\n    // Process dep1\n    const task1 = queue.dequeue('work')!;\n    queue.complete(task1.id);\n\n    // dep2 should be available but dependent should not\n    const task2 = queue.dequeue('work')!;\n    expect(task2.payload).toEqual({ name: 'dep2' });\n\n    // Dependent still blocked (dep2 not completed yet)\n    expect(queue.dequeue('work')).toBeNull();\n\n    // Complete dep2\n    queue.complete(task2.id);\n\n    // Now dependent is available\n    const dependent = queue.dequeue('work');\n    expect(dependent).not.toBeNull();\n    expect(dependent!.payload).toEqual({ name: 'dependent' });\n  });\n\n  it('circular dependency throws an error', () => {\n    const a = queue.enqueue('work', { name: 'A' });\n    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [a.id] });\n\n    // Trying to make A depend on B creates a cycle\n    expect(() =>\n      queue.enqueue('work', { name: 'C' }, { dependsOn: [b.id, a.id] })\n    ).not.toThrow(); // C -> B -> A is fine, no cycle\n\n    // Direct cycle: X depends on Y, Y depends on X\n    const x = queue.enqueue('work', { name: 'X' });\n    queue.enqueue('work', { name: 'Y' }, { dependsOn: [x.id] });\n\n    // This should not throw since there's no actual circular dependency here\n    // A true circular dependency:\n    const m = queue.enqueue('work', { name: 'M' });\n    const n = queue.enqueue('work', { name: 'N' }, { dependsOn: [m.id] });\n    expect(() =>\n      queue.enqueue('work', { name: 'O' }, { dependsOn: [n.id, m.id] })\n    ).not.toThrow(); // O -> N -> M is fine\n\n    // Real cycle detection test\n    const p = queue.enqueue('other', { name: 'P' });\n    const _q2 = queue.enqueue('other', { name: 'Q' }, { dependsOn: [p.id] });\n    // Cycle detection is verified above; with forward-only enqueue,\n    // cycles can only be detected at enqueue time through transitive dep chains.\n  });\n\n  it('getDependencies returns dependency info with statuses', () => {\n    const dep1 = queue.enqueue('work', { name: 'dep1' });\n    const dep2 = queue.enqueue('work', { name: 'dep2' });\n    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n      dependsOn: [dep1.id, dep2.id],\n    });\n\n    const deps = queue.getDependencies(dependent.id);\n    expect(deps).toHaveLength(2);\n    expect(deps).toContainEqual({ taskId: dep1.id, status: 'pending' });\n    expect(deps).toContainEqual({ taskId: dep2.id, status: 'pending' });\n\n    // After completing one\n    const task = queue.dequeue('work')!;\n    queue.complete(task.id);\n\n    const updatedDeps = queue.getDependencies(dependent.id);\n    const completedDep = updatedDeps.find(d => d.taskId === dep1.id);\n    expect(completedDep!.status).toBe('completed');\n  });\n\n  it('cascading dependencies work correctly (A depends on B depends on C)', () => {\n    const c = queue.enqueue('work', { name: 'C' });\n    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [c.id] });\n    const a = queue.enqueue('work', { name: 'A' }, { dependsOn: [b.id] });\n\n    // Only C is available\n    const taskC = queue.dequeue('work')!;\n    expect(taskC.payload).toEqual({ name: 'C' });\n    expect(queue.dequeue('work')).toBeNull();\n\n    queue.complete(taskC.id);\n\n    // Now B is available\n    const taskB = queue.dequeue('work')!;\n    expect(taskB.payload).toEqual({ name: 'B' });\n    expect(queue.dequeue('work')).toBeNull();\n\n    queue.complete(taskB.id);\n\n    // Now A is available\n    const taskA = queue.dequeue('work')!;\n    expect(taskA.payload).toEqual({ name: 'A' });\n    expect(taskA.id).toBe(a.id);\n  });\n\n  it('failed dependency does not auto-fail the dependent task', () => {\n    const dep = queue.enqueue('work', { name: 'dep' }, { maxRetries: 0 });\n    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n      dependsOn: [dep.id],\n    });\n\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'dep failed');\n\n    // Dependent stays blocked (not failed)\n    expect(dependent.status).toBe('pending');\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('dependency on non-existent task throws an error', () => {\n    expect(() =>\n      queue.enqueue('work', { name: 'orphan' }, { dependsOn: ['nonexistent-id'] })\n    ).toThrow();\n  });\n});\n```\n\n## phase-08.test.ts\n```typescript\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 8: Concurrency Control', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('setConcurrency limits the number of concurrent processing tasks', () => {\n    queue.setConcurrency('work', 2);\n    queue.enqueue('work', { job: 1 });\n    queue.enqueue('work', { job: 2 });\n    queue.enqueue('work', { job: 3 });\n\n    const t1 = queue.dequeue('work');\n    const t2 = queue.dequeue('work');\n    expect(t1).not.toBeNull();\n    expect(t2).not.toBeNull();\n\n    // Third dequeue should return null (at limit)\n    const t3 = queue.dequeue('work');\n    expect(t3).toBeNull();\n  });\n\n  it('dequeue returns null when at concurrency limit even if tasks available', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { job: 'a' });\n    queue.enqueue('work', { job: 'b' });\n\n    queue.dequeue('work'); // takes slot\n    const second = queue.dequeue('work');\n    expect(second).toBeNull();\n  });\n\n  it('completing a task frees a concurrency slot', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { job: 'first' });\n    queue.enqueue('work', { job: 'second' });\n\n    const first = queue.dequeue('work')!;\n    expect(queue.dequeue('work')).toBeNull(); // at limit\n\n    queue.complete(first.id);\n\n    const second = queue.dequeue('work');\n    expect(second).not.toBeNull();\n    expect(second!.payload).toEqual({ job: 'second' });\n  });\n\n  it('getConcurrency returns current and max info', () => {\n    queue.setConcurrency('work', 3);\n    queue.enqueue('work', { job: 1 });\n    queue.enqueue('work', { job: 2 });\n\n    const info1 = queue.getConcurrency('work');\n    expect(info1.max).toBe(3);\n    expect(info1.current).toBe(0);\n\n    queue.dequeue('work');\n    const info2 = queue.getConcurrency('work');\n    expect(info2.current).toBe(1);\n\n    queue.dequeue('work');\n    const info3 = queue.getConcurrency('work');\n    expect(info3.current).toBe(2);\n  });\n\n  it('default concurrency is unlimited', () => {\n    for (let i = 0; i < 100; i++) {\n      queue.enqueue('work', { job: i });\n    }\n\n    const tasks = [];\n    for (let i = 0; i < 100; i++) {\n      const t = queue.dequeue('work');\n      if (!t) break;\n      tasks.push(t);\n    }\n\n    expect(tasks.length).toBe(100);\n  });\n\n  it('concurrency limits are independent per queue', () => {\n    queue.setConcurrency('queue-a', 1);\n    queue.setConcurrency('queue-b', 2);\n\n    queue.enqueue('queue-a', { q: 'a1' });\n    queue.enqueue('queue-a', { q: 'a2' });\n    queue.enqueue('queue-b', { q: 'b1' });\n    queue.enqueue('queue-b', { q: 'b2' });\n    queue.enqueue('queue-b', { q: 'b3' });\n\n    queue.dequeue('queue-a'); // 1 processing in queue-a\n    expect(queue.dequeue('queue-a')).toBeNull(); // at limit for queue-a\n\n    queue.dequeue('queue-b'); // 1 processing in queue-b\n    expect(queue.dequeue('queue-b')).not.toBeNull(); // can still dequeue (limit 2)\n    expect(queue.dequeue('queue-b')).toBeNull(); // now at limit\n  });\n\n  it('concurrency respects priority ordering', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { name: 'low' }, { priority: 9 });\n    queue.enqueue('work', { name: 'high' }, { priority: 1 });\n\n    const task = queue.dequeue('work')!;\n    expect(task.payload).toEqual({ name: 'high' });\n  });\n});\n```\n\n## phase-09.test.ts\n```typescript\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 9: Progress and Cancellation', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('updateProgress sets the percentage for a task', () => {\n    queue.enqueue('work', { job: 'progress' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 50);\n    const progress = queue.getProgress(task.id);\n    expect(progress!.percent).toBe(50);\n  });\n\n  it('getProgress returns current progress info', () => {\n    queue.enqueue('work', { job: 'progress' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 75, 'Almost done');\n    const progress = queue.getProgress(task.id);\n\n    expect(progress).not.toBeNull();\n    expect(progress!.percent).toBe(75);\n    expect(progress!.message).toBe('Almost done');\n    expect(progress!.updatedAt).toBeInstanceOf(Date);\n  });\n\n  it('onProgress callback fires when progress is updated', () => {\n    queue.enqueue('work', { job: 'callback' });\n    const task = queue.dequeue('work')!;\n\n    const updates: Array<{ percent: number; message?: string }> = [];\n    queue.onProgress(task.id, (info) => {\n      updates.push({ percent: info.percent, message: info.message });\n    });\n\n    queue.updateProgress(task.id, 25, 'Starting');\n    queue.updateProgress(task.id, 50, 'Halfway');\n    queue.updateProgress(task.id, 100, 'Done');\n\n    expect(updates).toHaveLength(3);\n    expect(updates[0]).toEqual({ percent: 25, message: 'Starting' });\n    expect(updates[1]).toEqual({ percent: 50, message: 'Halfway' });\n    expect(updates[2]).toEqual({ percent: 100, message: 'Done' });\n  });\n\n  it('cancel sets task status to cancelled', () => {\n    const task = queue.enqueue('work', { job: 'cancel-me' });\n    queue.cancel(task.id);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('cancelled pending task is removed from the queue', () => {\n    queue.enqueue('work', { job: 'stay' });\n    const toCancel = queue.enqueue('work', { job: 'cancel' });\n    queue.enqueue('work', { job: 'stay2' });\n\n    queue.cancel(toCancel.id);\n\n    const t1 = queue.dequeue('work')!;\n    const t2 = queue.dequeue('work')!;\n    expect(t1.payload).toEqual({ job: 'stay' });\n    expect(t2.payload).toEqual({ job: 'stay2' });\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('cancelled processing task has its status set to cancelled', () => {\n    queue.enqueue('work', { job: 'processing-cancel' });\n    const task = queue.dequeue('work')!;\n    expect(task.status).toBe('processing');\n\n    queue.cancel(task.id);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('cancelled task is not retried', () => {\n    queue.enqueue('work', { job: 'no-retry' }, { maxRetries: 3 });\n    const task = queue.dequeue('work')!;\n\n    queue.cancel(task.id);\n\n    // Even after long delay, cancelled task should not reappear\n    vi.advanceTimersByTime(100000);\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('progress message is optional', () => {\n    queue.enqueue('work', { job: 'no-msg' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 42);\n    const progress = queue.getProgress(task.id);\n\n    expect(progress!.percent).toBe(42);\n    expect(progress!.message).toBeUndefined();\n  });\n});\n```\n\n## phase-10.test.ts\n```typescript\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 10: Recurring Tasks (Cron)', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers({ now: new Date('2025-01-01T00:00:00.000Z') });\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('schedule creates a recurring task definition', () => {\n    const schedule = queue.schedule('work', '*/5 * * * *', { type: 'cleanup' });\n\n    expect(schedule).toHaveProperty('id');\n    expect(schedule.queueName).toBe('work');\n    expect(schedule.cronExpression).toBe('*/5 * * * *');\n    expect(schedule.taskTemplate).toEqual({ type: 'cleanup' });\n    expect(schedule.active).toBe(true);\n  });\n\n  it('tick triggers scheduled tasks when they are due', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'periodic' });\n\n    // Advance 5 minutes\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const task = queue.dequeue('work');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({ type: 'periodic' });\n  });\n\n  it('unschedule stops future occurrences', () => {\n    const schedule = queue.schedule('work', '*/5 * * * *', { type: 'stop-me' });\n\n    queue.unschedule(schedule.id);\n\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('listSchedules returns active schedules', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'a' });\n    queue.schedule('work', '*/10 * * * *', { type: 'b' });\n    const toRemove = queue.schedule('other', '0 * * * *', { type: 'c' });\n\n    queue.unschedule(toRemove.id);\n\n    const schedules = queue.listSchedules();\n    expect(schedules.length).toBe(2);\n\n    const workSchedules = queue.listSchedules('work');\n    expect(workSchedules.length).toBe(2);\n  });\n\n  it('cron \"every 5 minutes\" triggers at correct intervals', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'five-min' });\n\n    // Advance 3 minutes - should not trigger\n    vi.advanceTimersByTime(3 * 60 * 1000);\n    queue.tick();\n    expect(queue.dequeue('work')).toBeNull();\n\n    // Advance 2 more minutes (total 5) - should trigger\n    vi.advanceTimersByTime(2 * 60 * 1000);\n    queue.tick();\n    expect(queue.dequeue('work')).not.toBeNull();\n  });\n\n  it('scheduled task gets the correct queue and payload', () => {\n    queue.schedule('notifications', '*/1 * * * *', {\n      type: 'reminder',\n      message: 'Check your inbox',\n    });\n\n    vi.advanceTimersByTime(1 * 60 * 1000);\n    queue.tick();\n\n    const task = queue.dequeue('notifications');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({\n      type: 'reminder',\n      message: 'Check your inbox',\n    });\n\n    // Should not be in other queues\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('multiple schedules can coexist', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'every-5' });\n    queue.schedule('work', '*/10 * * * *', { type: 'every-10' });\n\n    // At 5 minutes, only every-5 triggers\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const tasks5 = [];\n    let t;\n    while ((t = queue.dequeue('work')) !== null) {\n      tasks5.push(t);\n    }\n    expect(tasks5.length).toBe(1);\n    expect(tasks5[0].payload).toEqual({ type: 'every-5' });\n\n    // At 10 minutes, both trigger\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const tasks10 = [];\n    while ((t = queue.dequeue('work')) !== null) {\n      tasks10.push(t);\n    }\n    expect(tasks10.length).toBe(2);\n    const types = tasks10.map(t => t.payload.type).sort();\n    expect(types).toEqual(['every-10', 'every-5']);\n  });\n});\n```\n\n## phase-11.test.ts\n```typescript\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 11: Middleware Pipeline', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('middleware runs before task processing', async () => {\n    const log: string[] = [];\n\n    queue.use('work', async (_task, next) => {\n      log.push('middleware');\n      await next();\n    });\n\n    queue.enqueue('work', { job: 'test' });\n\n    await queue.process('work', async () => {\n      log.push('handler');\n    });\n\n    expect(log).toEqual(['middleware', 'handler']);\n  });\n\n  it('multiple middlewares run in the order they were added', async () => {\n    const log: string[] = [];\n\n    queue.use('work', async (_task, next) => {\n      log.push('first');\n      await next();\n    });\n\n    queue.use('work', async (_task, next) => {\n      log.push('second');\n      await next();\n    });\n\n    queue.use('work', async (_task, next) => {\n      log.push('third');\n      await next();\n    });\n\n    queue.enqueue('work', { job: 'test' });\n\n    await queue.process('work', async () => {\n      log.push('handler');\n    });\n\n    expect(log).toEqual(['first', 'second', 'third', 'handler']);\n  });\n\n  it('middleware can modify the task object', async () => {\n    queue.use('work', async (task, next) => {\n      task.payload.enriched = true;\n      task.payload.timestamp = '2025-01-01';\n      await next();\n    });\n\n    queue.enqueue('work', { job: 'enrich-me' });\n\n    let processedPayload: Record<string, unknown> | null = null;\n    await queue.process('work', async (task) => {\n      processedPayload = task.payload;\n    });\n\n    expect(processedPayload).toEqual({\n      job: 'enrich-me',\n      enriched: true,\n      timestamp: '2025-01-01',\n    });\n  });\n\n  it('middleware can skip processing by not calling next', async () => {\n    const log: string[] = [];\n\n    queue.use('work', async (_task, _next) => {\n      log.push('blocker');\n      // deliberately not calling next()\n    });\n\n    queue.enqueue('work', { job: 'blocked' });\n\n    await queue.process('work', async () => {\n      log.push('handler');\n    });\n\n    expect(log).toEqual(['blocker']);\n    expect(log).not.toContain('handler');\n  });\n\n  it('error in middleware fails the task', async () => {\n    queue.use('work', async (_task, _next) => {\n      throw new Error('middleware explosion');\n    });\n\n    const task = queue.enqueue('work', { job: 'explode' }, { maxRetries: 0 });\n\n    await queue.process('work', async () => {\n      // should not reach here\n    });\n\n    expect(task.status).toBe('failed');\n  });\n\n  it('middleware stacks are independent per queue', async () => {\n    const log: string[] = [];\n\n    queue.use('queue-a', async (_task, next) => {\n      log.push('a-middleware');\n      await next();\n    });\n\n    queue.use('queue-b', async (_task, next) => {\n      log.push('b-middleware');\n      await next();\n    });\n\n    queue.enqueue('queue-a', { job: 'a' });\n\n    await queue.process('queue-a', async () => {\n      log.push('a-handler');\n    });\n\n    expect(log).toEqual(['a-middleware', 'a-handler']);\n    expect(log).not.toContain('b-middleware');\n  });\n\n  it('middleware receives the task context', async () => {\n    let receivedTask: { id?: string; payload?: unknown; status?: string } | null = null;\n\n    queue.use('work', async (task, next) => {\n      receivedTask = task;\n      await next();\n    });\n\n    const enqueued = queue.enqueue('work', { job: 'context' });\n\n    await queue.process('work', async () => {});\n\n    expect(receivedTask).not.toBeNull();\n    expect(receivedTask!.id).toBe(enqueued.id);\n    expect(receivedTask!.payload).toEqual({ job: 'context' });\n  });\n});\n```\n\n## phase-12.test.ts\n```typescript\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 12: Graceful Shutdown', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('shutdown stops accepting new tasks', async () => {\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    await shutdownPromise;\n\n    expect(() => queue.enqueue('work', { job: 'too-late' })).toThrow();\n  });\n\n  it('shutdown waits for processing tasks to complete', async () => {\n    queue.enqueue('work', { job: 'in-flight' });\n    const task = queue.dequeue('work')!;\n\n    let resolved = false;\n    const shutdownPromise = queue.shutdown(10000).then((summary) => {\n      resolved = true;\n      return summary;\n    });\n\n    // Shutdown should not resolve yet (task still processing)\n    vi.advanceTimersByTime(100);\n    await Promise.resolve(); // flush microtasks\n    expect(resolved).toBe(false);\n\n    // Complete the task\n    queue.complete(task.id);\n    vi.advanceTimersByTime(0);\n    const summary = await shutdownPromise;\n\n    expect(resolved).toBe(true);\n    expect(summary.completed).toBe(1);\n  });\n\n  it('shutdown force-cancels tasks after timeout', async () => {\n    queue.enqueue('work', { job: 'slow' });\n    const task = queue.dequeue('work')!;\n\n    const shutdownPromise = queue.shutdown(3000);\n\n    // Advance past timeout\n    vi.advanceTimersByTime(3000);\n    const summary = await shutdownPromise;\n\n    expect(summary.cancelled).toBe(1);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('onShutdown callback fires during shutdown', async () => {\n    const log: string[] = [];\n    queue.onShutdown(() => {\n      log.push('shutdown-hook');\n    });\n\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    await shutdownPromise;\n\n    expect(log).toContain('shutdown-hook');\n  });\n\n  it('shutdown returns summary with completed, cancelled, and elapsed', async () => {\n    queue.enqueue('work', { job: 'fast' });\n    queue.enqueue('work', { job: 'slow' });\n\n    const fast = queue.dequeue('work')!;\n    const _slow = queue.dequeue('work')!;\n\n    const shutdownPromise = queue.shutdown(5000);\n\n    // Complete 'fast' quickly\n    queue.complete(fast.id);\n\n    // Let 'slow' timeout (it gets force-cancelled)\n    vi.advanceTimersByTime(5000);\n    const summary = await shutdownPromise;\n\n    expect(summary.completed).toBe(1);\n    expect(summary.cancelled).toBe(1);\n    expect(typeof summary.elapsed).toBe('number');\n    expect(summary.elapsed).toBeGreaterThanOrEqual(0);\n  });\n\n  it('multiple shutdown calls are idempotent', async () => {\n    const p1 = queue.shutdown(5000);\n    const p2 = queue.shutdown(5000);\n\n    vi.advanceTimersByTime(0);\n    const [s1, s2] = await Promise.all([p1, p2]);\n\n    // Should return the same result\n    expect(s1).toEqual(s2);\n  });\n\n  it('enqueue after shutdown throws an error', async () => {\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    await shutdownPromise;\n\n    expect(() => queue.enqueue('work', { job: 'rejected' })).toThrow();\n  });\n\n  it('shutdown with no processing tasks resolves immediately', async () => {\n    queue.enqueue('work', { job: 'pending-only' });\n    // Don't dequeue - nothing is processing\n\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    const summary = await shutdownPromise;\n\n    expect(summary.completed).toBe(0);\n    expect(summary.cancelled).toBe(0);\n    expect(summary.elapsed).toBeLessThanOrEqual(100);\n  });\n});\n```\n\nAll 12 test files have been read and displayed above with their complete contents verbatim. These tests define a comprehensive TaskQueue implementation with 12 phases:\n\n1. **Phase 1**: Basic FIFO queue operations\n2. **Phase 2**: Named queues\n3. **Phase 3**: Priority handling\n4. **Phase 4**: Delayed/scheduled tasks\n5. **Phase 5**: Retry with exponential backoff\n6. **Phase 6**: Dead letter queue (DLQ)\n7. **Phase 7**: Task dependencies\n8. **Phase 8**: Concurrency control\n9. **Phase 9**: Progress tracking and cancellation\n10. **Phase 10**: Recurring cron-based tasks\n11. **Phase 11**: Middleware pipeline system\n12. **Phase 12**: Graceful shutdown"}],"totalDurationMs":81481,"totalTokens":41088,"totalToolUseCount":13,"usage":{"input_tokens":7,"cache_creation_input_tokens":20603,"cache_read_input_tokens":5649,"output_tokens":14829,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":20603},"inference_geo":"not_available","iterations":[{"input_tokens":7,"output_tokens":14829,"cache_read_input_tokens":5649,"cache_creation_input_tokens":20603,"cache_creation":{"ephemeral_5m_input_tokens":20603,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"toolStats":{"readCount":12,"searchCount":0,"bashCount":1,"editFileCount":0,"linesAdded":0,"linesRemoved":0,"otherToolCount":0}}}
