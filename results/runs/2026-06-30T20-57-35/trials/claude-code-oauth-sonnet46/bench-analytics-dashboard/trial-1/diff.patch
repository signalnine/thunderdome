 { count: number };\n    } else {\n      result = db\n        .prepare('SELECT COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?')\n        .get(tenantId, event_name) as { count: number };\n    }\n\n    res.json({ count: result.count });\n  } catch (err) {\n    next(err);\n  }\n});\n\nrouter.post('/timeseries', (req, res, next) => {\n  try {\n    const { event_name, bucket = 'day', start, end } = req.body as {\n      event_name?: string;\n      bucket?: string;\n      start?: string;\n      end?: string;\n    };\n    if (!event_name) throw new AppError(400, 'event_name is required', 'VALIDATION_ERROR');\n\n    const db = getDb();\n    const tenantId = req.user!.tenantId;\n    const bucketExpr = BUCKET_FORMATS[bucket] ?? BUCKET_FORMATS['day'];\n\n    let data: unknown[];\n    if (start && end) {\n      data = db\n        .prepare(\n          `SELECT ${bucketExpr} as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ? AND timestamp >= ? AND timestamp <= ? GROUP BY bucket ORDER BY bucket`\n        )\n        .all(tenantId, event_name, start, end);\n    } else if (start) {\n      data = db\n        .prepare(\n          `SELECT ${bucketExpr} as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ? AND timestamp >= ? GROUP BY bucket ORDER BY bucket`\n        )\n        .all(tenantId, event_name, start);\n    } else if (end) {\n      data = db\n        .prepare(\n          `SELECT ${bucketExpr} as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ? AND timestamp <= ? GROUP BY bucket ORDER BY bucket`\n        )\n        .all(tenantId, event_name, end);\n    } else {\n      data = db\n        .prepare(\n          `SELECT ${bucketExpr} as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ? GROUP BY bucket ORDER BY bucket`\n        )\n        .all(tenantId, event_name);\n    }\n\n    res.json({ data });\n  } catch (err) {\n    next(err);\n  }\n});\n\nrouter.post('/breakdown', (req, res, next) => {\n  try {\n    const { event_name, property_key } = req.body as {\n      event_name?: string;\n      property_key?: string;\n    };\n    if (!event_name) throw new AppError(400, 'event_name is required', 'VALIDATION_ERROR');\n    if (!property_key) throw new AppError(400, 'property_key is required', 'VALIDATION_ERROR');\n\n    const db = getDb();\n    const tenantId = req.user!.tenantId;\n\n    const data = db\n      .prepare(\n        `SELECT json_extract(properties, '$.' || ?) as property_value, COUNT(*) as count\n         FROM events\n         WHERE tenant_id = ? AND name = ?\n         GROUP BY property_value\n         ORDER BY count DESC`\n      )\n      .all(property_key, tenantId, event_name);\n\n    res.json({ data });\n  } catch (err) {\n    next(err);\n  }\n});\n\nrouter.post('/funnel', (req, res, next) => {\n  try {\n    const { steps } = req.body as { steps?: string[] };\n    if (!steps || steps.length === 0) {\n      throw new AppError(400, 'steps is required', 'VALIDATION_ERROR');\n    }\n\n    const db = getDb();\n    const tenantId = req.user!.tenantId;\n\n    const stmt = db.prepare(\n      'SELECT COUNT(DISTINCT session_id) as count FROM events WHERE tenant_id = ? AND name = ? AND session_id IS NOT NULL'\n    );\n\n    const funnelSteps = steps.map((step) => {\n      const result = stmt.get(tenantId, step) as { count: number };\n      return { event_name: step, count: result.count };\n    });\n\n    res.json({ steps: funnelSteps });\n  } catch (err) {\n    next(err);\n  }\n});\n\nexport default router;\n","structuredPatch":[],"originalFile":null,"userModified":false}}
