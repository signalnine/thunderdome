own and funnel queries in full workflow', async () => {\n    const token = await registerAndLogin(app, 'funnel@test.com', 'pass', TENANT_A);\n\n    // Ingest funnel events with session\n    await request(app)\n      .post('/events/batch')\n      .set('Authorization', `Bearer ${token}`)\n      .send({\n        events: [\n          { name: 'page_view', properties: { page: '/landing' }, session_id: 'sess1' },\n          { name: 'signup_click', properties: {}, session_id: 'sess1' },\n          { name: 'signup_complete', properties: {}, session_id: 'sess1' },\n          { name: 'page_view', properties: { page: '/landing' }, session_id: 'sess2' },\n          { name: 'signup_click', properties: {}, session_id: 'sess2' },\n        ],\n      });\n\n    // Breakdown\n    const breakdownRes = await request(app)\n      .post('/query/breakdown')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'page_view', property_key: 'page' });\n\n    expect(breakdownRes.status).toBe(200);\n    expect(breakdownRes.body.data).toBeInstanceOf(Array);\n\n    // Funnel\n    const funnelRes = await request(app)\n      .post('/query/funnel')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ steps: ['page_view', 'signup_click', 'signup_complete'] });\n\n    expect(funnelRes.status).toBe(200);\n    expect(funnelRes.body.steps).toHaveLength(3);\n    // step 1 (page_view) >= step 2 (signup_click) >= step 3 (signup_complete)\n    expect(funnelRes.body.steps[0].count).toBeGreaterThanOrEqual(funnelRes.body.steps[1].count);\n    expect(funnelRes.body.steps[1].count).toBeGreaterThanOrEqual(funnelRes.body.steps[2].count);\n  });\n\n  // --- Tenant Isolation Across All Features (2 tests) ---\n\n  it('should isolate dashboards between tenants', async () => {\n    const tokenA = await registerAndLogin(app, 'isoA@test.com', 'pass', TENANT_A);\n    const tokenB = await registerAndLogin(app, 'isoB@test.com', 'pass', TENANT_B);\n\n    // Tenant A creates a dashboard\n    const 