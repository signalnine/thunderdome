+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+interface EventPayload {
+  name?: string;
+  properties?: Record<string, unknown>;
+  timestamp?: string;
+  session_id?: string;
+}
+
+const router = Router();
+
+router.post('/', (req, res, next) => {
+  try {
+    const { name, properties, timestamp, session_id } = req.body as EventPayload;
+    if (!name) throw new AppError(400, 'Event name is required', 'VALIDATION_ERROR');
+
+    const db = getDb();
+    const id = uuidv4();
+    const tenantId = req.user!.tenantId;
+    const userId = req.user!.id;
+    const ts = timestamp || new Date().toISOString();
+    const props = JSON.stringify(properties || {});
+
+    db.prepare(
+      'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    ).run(id, tenantId, name, props, ts, userId, session_id ?? null);
+
+    res.status(201).json({
+      id,
+      tenant_id: tenantId,
+      name,
+      properties: properties || {},
+      timestamp: ts,
+      user_id: userId,
+      session_id: session_id ?? null,
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/batch', (req, res, next) => {
+  try {
+    const { events } = req.body as { events?: EventPayload[] };
+    if (!events || events.length === 0) {
+      throw new AppError(400, 'Events array must not be empty', 'VALIDATION_ERROR');
+    }
+
+    const db = getDb();
+    const tenantId = req.user!.tenantId;
+    const userId = req.user!.id;
+
+    const insert = db.prepare(
+      'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    );
+
+    const insertedEvents = events.map((e) => {
+      if (!e.name) throw new AppError(400, 'Event name is required', 'VALIDATION_ERROR');
+      const id = uuidv4();
+      const ts = e.timestamp || new Date().toISOString();
+      const props = JSON.stringify(e.properties || {});
+      insert.run(id, tenantId, e.name, props, ts, userId, e.session_id ?? null);
+      return {
+        id,
+        tenant_id: tenantId,
+        name: e.name,
+        properties: e.properties || {},
+        timestamp: ts,
+        user_id: userId,
+        session_id: e.session_id ?? null,
+      };
+    });
+
+    res.status(201).json({ inserted: insertedEvents.length, events: insertedEvents });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
