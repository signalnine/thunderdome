+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const router = Router();
+
+router.post('/', (req, res, next) => {
+  try {
+    const { name, config } = req.body as { name?: string; config?: Record<string, unknown> };
+    if (!name) throw new AppError(400, 'name is required', 'VALIDATION_ERROR');
+
+    const db = getDb();
+    const id = uuidv4();
+    const tenantId = req.user!.tenantId;
+    const ownerId = req.user!.id;
+
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, tenantId, name, ownerId, JSON.stringify(config || {}));
+
+    const dashboard = db
+      .prepare('SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE id = ?')
+      .get(id) as { id: string; tenant_id: string; name: string; owner_id: string; config: string; created_at: string; updated_at: string };
+
+    res.status(201).json({ ...dashboard, config: JSON.parse(dashboard.config) });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/', (req, res, next) => {
+  try {
+    const db = getDb();
+    const tenantId = req.user!.tenantId;
+
+    const dashboards = db
+      .prepare('SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC')
+      .all(tenantId) as Array<{ id: string; tenant_id: string; name: string; owner_id: string; config: string; created_at: string; updated_at: string }>;
+
+    res.json(dashboards.map((d) => ({ ...d, config: JSON.parse(d.config) })));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/:id', (req, res, next) => {
+  try {
+    const db = getDb();
+    const tenantId = req.user!.tenantId;
+
+    const dashboard = db
+      .prepare('SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId) as { id: string; tenant_id: string; name: string; owner_id: string; config: string; created_at: string; updated_at: string } | undefined;
+
+    if (!dashboard) throw new AppError(404, 'Dashboard not found', 'NOT_FOUND');
+
+    const widgets = db
+      .prepare('SELECT id, dashboard_id, type, config, position_x, position_y, width, height FROM widgets WHERE dashboard_id = ?')
+      .all(dashboard.id) as Array<{ id: string; dashboard_id: string; type: string; config: string; position_x: number; position_y: number; width: number; height: number }>;
+
+    res.json({
+      ...dashboard,
+      config: JSON.parse(dashboard.config),
+      widgets: widgets.map((w) => ({ ...w, config: JSON.parse(w.config) })),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.patch('/:id', (req, res, next) => {
+  try {
+    const db = getDb();
+    const tenantId = req.user!.tenantId;
+
+    const existing = db
+      .prepare('SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId);
+    if (!existing) throw new AppError(404, 'Dashboard not found', 'NOT_FOUND');
+
+    const { name, config } = req.body as { name?: string; config?: Record<string, unknown> };
+    const updates: string[] = ["updated_at = datetime('now')"];
+    const params: unknown[] = [];
+
+    if (name !== undefined) { updates.push('name = ?'); params.push(name); }
+    if (config !== undefined) { updates.push('config = ?'); params.push(JSON.stringify(config)); }
+
+    params.push(req.params.id, tenantId);
+    db.prepare(`UPDATE dashboards SET ${updates.join(', ')} WHERE id = ? AND tenant_id = ?`).run(...params);
+
+    const updated = db
+      .prepare('SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE id = ?')
+      .get(req.params.id) as { id: string; tenant_id: string; name: string; owner_id: string; config: string; created_at: string; updated_at: string };
+
+    res.json({ ...updated, config: JSON.parse(updated.config) });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.delete('/:id', (req, res, next) => {
+  try {
+    const db = getDb();
+    const tenantId = req.user!.tenantId;
+
+    const existing = db
+      .prepare('SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId);
+    if (!existing) throw new AppError(404, 'Dashboard not found', 'NOT_FOUND');
+
+    db.prepare('DELETE FROM dashboards WHERE id = ? AND tenant_id = ?').run(req.params.id, tenantId);
+    res.status(204).send();
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/:id/widgets', (req, res, next) => {
+  try {
+    const db = getDb();
+    const tenantId = req.user!.tenantId;
+
+    const dashboard = db
+      .prepare('SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId);
+    if (!dashboard) throw new AppError(404, 'Dashboard not found', 'NOT_FOUND');
+
+    const { type, config, position_x = 0, position_y = 0, width = 1, height = 1 } = req.body as {
+      type?: string;
+      config?: Record<string, unknown>;
+      position_x?: number;
+      position_y?: number;
+      width?: number;
+      height?: number;
+    };
+    if (!type) throw new AppError(400, 'type is required', 'VALIDATION_ERROR');
+
+    const id = uuidv4();
+    db.prepare(
+      'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+    ).run(id, req.params.id, type, JSON.stringify(config || {}), position_x, position_y, width, height);
+
+    const widget = db
+      .prepare('SELECT id, dashboard_id, type, config, position_x, position_y, width, height FROM widgets WHERE id = ?')
+      .get(id) as { id: string; dashboard_id: string; type: string; config: string; position_x: number; position_y: number; width: number; height: number };
+
+    res.status(201).json({ ...widget, config: JSON.parse(widget.config) });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.delete('/:id/widgets/:widgetId', (req, res, next) => {
+  try {
+    const db = getDb();
+    const tenantId = req.user!.tenantId;
+
+    const dashboard = db
+      .prepare('SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId);
+    if (!dashboard) throw new AppError(404, 'Dashboard not found', 'NOT_FOUND');
+
+    db.prepare('DELETE FROM widgets WHERE id = ? AND dashboard_id = ?').run(req.params.widgetId, req.params.id);
+    res.status(204).send();
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
