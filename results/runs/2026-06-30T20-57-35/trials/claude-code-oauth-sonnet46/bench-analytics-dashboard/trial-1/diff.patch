@@ -0,0 +1,87 @@
+import { Router } from 'express';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+const CSV_HEADERS = ['id', 'tenant_id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'];
+
+function escapeCSV(val: unknown): string {
+  const str = val == null ? '' : String(val);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+const router = Router();
+
+router.get('/events', (req, res, next) => {
+  try {
+    const format = req.query.format as string;
+    if (format !== 'json' && format !== 'csv') {
+      throw new AppError(400, 'format must be json or csv', 'VALIDATION_ERROR');
+    }
+
+    const db = getDb();
+    const tenantId = req.user!.tenantId;
+
+    const events = db
+      .prepare('SELECT id, tenant_id, name, properties, timestamp, user_id, session_id FROM events WHERE tenant_id = ? ORDER BY timestamp ASC')
+      .all(tenantId) as EventRow[];
+
+    if (format === 'json') {
+      res.json(events.map((e) => ({ ...e, properties: JSON.parse(e.properties) })));
+      return;
+    }
+
+    const rows = events.map((e) =>
+      CSV_HEADERS.map((h) => escapeCSV(e[h as keyof EventRow])).join(',')
+    );
+    const csv = [CSV_HEADERS.join(','), ...rows].join('\n');
+    res.setHeader('Content-Type', 'text/csv');
+    res.send(csv);
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/dashboard/:id', (req, res, next) => {
+  try {
+    const db = getDb();
+    const tenantId = req.user!.tenantId;
+
+    const dashboard = db
+      .prepare('SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId) as {
+        id: string; tenant_id: string; name: string; owner_id: string;
+        config: string; created_at: string; updated_at: string;
+      } | undefined;
+
+    if (!dashboard) throw new AppError(404, 'Dashboard not found', 'NOT_FOUND');
+
+    const widgets = db
+      .prepare('SELECT id, dashboard_id, type, config, position_x, position_y, width, height FROM widgets WHERE dashboard_id = ?')
+      .all(dashboard.id) as Array<{
+        id: string; dashboard_id: string; type: string; config: string;
+        position_x: number; position_y: number; width: number; height: number;
+      }>;
+
+    res.json({
+      dashboard: { ...dashboard, config: JSON.parse(dashboard.config) },
+      widgets: widgets.map((w) => ({ ...w, config: JSON.parse(w.config) })),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
