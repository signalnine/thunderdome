_id) VALUES (?, ?, ?, ?, ?, ?, ?)'\n    );\n\n    const insertedEvents = events.map((e) => {\n      if (!e.name) throw new AppError(400, 'Event name is required', 'VALIDATION_ERROR');\n      const id = uuidv4();\n      const ts = e.timestamp || new Date().toISOString();\n      const props = JSON.stringify(e.properties || {});\n      insert.run(id, tenantId, e.name, props, ts, userId, e.session_id ?? null);\n      return {\n        id,\n        tenant_id: tenantId,\n        name: e.name,\n        properties: e.properties || {},\n        timestamp: ts,\n        user_id: userId,\n        session_id: e.session_id ?? null,\n      };\n    });\n\n    res.status(201).json({ inserted: insertedEvents.length, events: insertedEvents });\n  } catch (err) {\n    next(err);\n  }\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":125,"cache_read_input_tokens":64970,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":125},"output_tokens":69,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f5fc533f-14df-4cb0-8be4-1ce1ea0c900a","uuid":"13a47756-c595-4ae4-896a-ceb907c63771","request_id":"req_011Cca8ZH9eCB12PjdneakNC"}
