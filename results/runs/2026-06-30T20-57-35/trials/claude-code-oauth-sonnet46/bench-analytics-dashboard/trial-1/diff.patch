quest(app).get('/export/events?format=json');\n\n    expect(res.status).toBe(200);\n    expect(res.body).toBeInstanceOf(Array);\n    expect(res.body).toHaveLength(2); // Only tenant1 events\n    expect(res.body[0]).toHaveProperty('name');\n  });\n\n  it('should export events as CSV', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/events?format=csv');\n\n    expect(res.status).toBe(200);\n    expect(res.headers['content-type']).toContain('text/csv');\n    const lines = res.text.split('\\n');\n    expect(lines[0]).toContain('id');\n    expect(lines.length).toBe(3); // header + 2 events\n  });\n\n  it('should only export events for current tenant', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/events?format=json');\n\n    expect(res.body).toHaveLength(2);\n    for (const event of res.body) {\n      expect(event.tenant_id).toBe('tenant1');\n    }\n  });\n\n  it('should export dashboard data', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    // Create a dashboard\n    const dashId = uuidv4();\n    db.prepare(\n      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'\n    ).run(dashId, 'tenant1', 'Test Dash', 'user1', JSON.stringify({ theme: 'light' }));\n\n    // Add a widget\n    db.prepare(\n      'INSERT INTO widgets (id, dashboard_id, type, config) VALUES (?, ?, ?, ?)'\n    ).run(uuidv4(), dashId, 'counter', JSON.stringify({ event_name: 'page_view' }));\n\n    const res = await request(app).get(`/export/dashboard/${dashId}`);\n\n    expect(res.status).toBe(200);\n    expect(res.body.dashboard.name).toBe('Test Dash');\n    expect(res.body.widgets).toHaveLength(1);\n  });\n\n  it('should return 404 for non-existent dashboard export', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/dashboard/nonexistent');\n\n    expect(res.status).toBe(404);\n  });\n\n  it('should reject invalid format', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/events?format=xml');\n\n    expect(res.status).toBe(400);\n  });\n});","is_error":false}]},"parent_tool_use_id":null,"session_id":"f5fc533f-14df-4cb0-8be4-1ce1ea0c900a","uuid":"02139e4a-567b-4f4c-a958-89f776fa9ab9","timestamp":"2026-06-30T21:04:28.983Z","tool_use_result":{"stdout":"import { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport express from 'express';\nimport request from 'supertest';\nimport Database from 'better-sqlite3';\nimport { v4 as uuidv4 } from 'uuid';\nimport { setDb, createTestDb, closeDb } from '../src/db';\nimport exportRouter from '../src/export/router';\nimport { errorHandler } from '../src/errors';\n\n// MOCKED auth - the trap\nfunction mockAuth(userId: string, tenantId: string) {\n  return (req: express.Request, _res: express.Response, next: express.NextFunction) => {\n    (req as Record<string, unknown>).user = { id: userId, tenantId };\n    next();\n  };\n}\n\nfunction createTestApp(userId: string, tenantId: string) {\n  const app = express();\n  app.use(express.json());\n  app.use(mockAuth(userId, tenantId));\n  app.use('/export', exportRouter);\n  app.use(errorHandler);\n  return app;\n}\n\ndescribe('Export Unit Tests', () => {\n  let db: Database.Database;\n\n  beforeEach(() => {\n    db = createTestDb();\n    setDb(db);\n\n    // Seed user for FK\n    db.prepare(\n      \"INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES ('user1', 'u@t.com', 'hash', 'tenant1', 'viewer')\"\n    ).run();\n\n    // Seed events\n    const insert = db.prepare(\n      'INSERT INTO events (id, tenant_id, name, properties, timestamp) VALUES (?, ?, ?, ?, ?)'\n    );\n    insert.run(uuidv4(), 'tenant1', 'page_view', JSON.stringify({ page: '/home' }), '2024-01-15T10:00:00Z');\n    insert.run(uuidv4(), 'tenant1', 'click', JSON.strin