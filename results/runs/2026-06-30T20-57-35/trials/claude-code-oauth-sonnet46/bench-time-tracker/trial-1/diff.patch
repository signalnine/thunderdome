+import { readFileSync, writeFileSync, mkdirSync, existsSync } from 'fs';
+import { dirname } from 'path';
+
+export interface Entry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+export class TimeTracker {
+  private filePath: string;
+  private entries: Entry[];
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = this.load();
+  }
+
+  private load(): Entry[] {
+    if (!existsSync(this.filePath)) return [];
+    try {
+      const raw = readFileSync(this.filePath, 'utf-8');
+      return JSON.parse(raw) as Entry[];
+    } catch {
+      return [];
+    }
+  }
+
+  private save(): void {
+    const dir = dirname(this.filePath);
+    mkdirSync(dir, { recursive: true });
+    writeFileSync(this.filePath, JSON.stringify(this.entries, null, 2), 'utf-8');
+  }
+
+  start(taskName: string): Entry {
+    if (!taskName) throw new Error('Task name must not be empty');
+
+    const active = this.entries.find(e => e.endTime === null);
+    if (active) {
+      active.endTime = new Date().toISOString();
+    }
+
+    const entry: Entry = {
+      taskName,
+      startTime: new Date().toISOString(),
+      endTime: null,
+    };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  stop(): Entry {
+    const active = this.entries.find(e => e.endTime === null);
+    if (!active) throw new Error('No task is currently running');
+    active.endTime = new Date().toISOString();
+    this.save();
+    return active;
+  }
+
+  getActiveTask(): Entry | null {
+    return this.entries.find(e => e.endTime === null) ?? null;
+  }
+
+  getLog(options?: { since?: Date }): Entry[] {
+    if (!options?.since) return [...this.entries];
+    const since = options.since.getTime();
+    return this.entries.filter(e => {
+      if (e.endTime === null) return true;
+      if (new Date(e.startTime).getTime() >= since) return true;
+      if (new Date(e.endTime).getTime() >= since) return true;
+      return false;
+    });
+  }
+
+  getSummary(): Record<string, number> {
+    const now = Date.now();
+    const summary: Record<string, number> = {};
+    for (const e of this.entries) {
+      const end = e.endTime ? new Date(e.endTime).getTime() : now;
+      const duration = end - new Date(e.startTime).getTime();
+      summary[e.taskName] = (summary[e.taskName] ?? 0) + duration;
+    }
+    return summary;
+  }
+}
