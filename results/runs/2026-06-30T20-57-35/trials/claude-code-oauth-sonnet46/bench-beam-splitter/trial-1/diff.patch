+// dir: 0=DOWN, 1=DOWN_LEFT, 2=DOWN_RIGHT
+const DCOL = [0, -1, 1] as const;
+
+function findSource(grid: string[][]): number {
+  const cols = grid[0]?.length ?? 0;
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') return c;
+  }
+  return -1;
+}
+
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  const cols = grid[0]?.length ?? 0;
+  if (rows === 0 || cols === 0) return 0;
+
+  const srcCol = findSource(grid);
+  if (srcCol === -1) return 0;
+
+  const visitedCells = new Set<number>();
+  const visitedStates = new Set<number>();
+
+  const encodeState = (r: number, c: number, d: number) => (r * cols + c) * 3 + d;
+
+  visitedCells.add(srcCol); // row 0 * cols + srcCol = srcCol
+  const stack: [number, number, number][] = [[0, srcCol, 0]];
+
+  while (stack.length > 0) {
+    const [r, c, d] = stack.pop()!;
+    const sk = encodeState(r, c, d);
+    if (visitedStates.has(sk)) continue;
+    visitedStates.add(sk);
+
+    const nextDirs = grid[r][c] === '^' ? [1, 2] : [d];
+
+    for (const nd of nextDirs) {
+      const nr = r + 1;
+      const nc = c + DCOL[nd];
+      if (nr < rows && nc >= 0 && nc < cols) {
+        visitedCells.add(nr * cols + nc);
+        if (!visitedStates.has(encodeState(nr, nc, nd))) {
+          stack.push([nr, nc, nd]);
+        }
+      }
+    }
+  }
+
+  return visitedCells.size;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  const cols = grid[0]?.length ?? 0;
+  if (rows === 0 || cols === 0) return 0n;
+
+  const srcCol = findSource(grid);
+  if (srcCol === -1) return 0n;
+
+  // key = col * 3 + dir, value = number of paths arriving at (currentRow, col) with that dir
+  let current = new Map<number, bigint>();
+  current.set(srcCol * 3 + 0, 1n);
+
+  let totalPaths = 0n;
+
+  for (let r = 0; r < rows; r++) {
+    const next = new Map<number, bigint>();
+
+    for (const [key, cnt] of current) {
+      const c = (key / 3) | 0;
+      const d = key % 3;
+      const nextDirs = grid[r][c] === '^' ? [1, 2] : [d];
+
+      for (const nd of nextDirs) {
+        const nr = r + 1;
+        const nc = c + DCOL[nd];
+        if (nr >= rows || nc < 0 || nc >= cols) {
+          totalPaths += cnt;
+        } else {
+          const nk = nc * 3 + nd;
+          next.set(nk, (next.get(nk) ?? 0n) + cnt);
+        }
+      }
+    }
+
+    current = next;
+  }
+
+  return totalPaths;
+}
