--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,208 @@
+export interface Event {
+  id: string;
+  name: string;
+  duration: number;
+  attendees?: number;
+  prerequisites?: string[];
+  preferredRoom?: string;
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number;
+}
+
+export interface ScheduleOptions {
+  startTime: number;
+  endTime: number;
+  gap?: number;
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[];
+}
+
+function detectCycles(events: Event[]): void {
+  const eventIds = new Set(events.map(e => e.id));
+  const successors = new Map<string, string[]>(events.map(e => [e.id, []]));
+
+  for (const e of events) {
+    for (const prereq of (e.prerequisites ?? [])) {
+      if (prereq === e.id) {
+        throw new Error(`Cycle detected: event "${e.id}" lists itself as a prerequisite`);
+      }
+      if (eventIds.has(prereq)) {
+        successors.get(prereq)!.push(e.id);
+      }
+    }
+  }
+
+  const UNVISITED = 0, IN_STACK = 1, DONE = 2;
+  const state = new Map<string, number>(events.map(e => [e.id, UNVISITED]));
+
+  function dfs(id: string): void {
+    state.set(id, IN_STACK);
+    for (const next of successors.get(id)!) {
+      const s = state.get(next)!;
+      if (s === IN_STACK) throw new Error(`Cycle detected in prerequisite graph`);
+      if (s === UNVISITED) dfs(next);
+    }
+    state.set(id, DONE);
+  }
+
+  for (const e of events) {
+    if (state.get(e.id) === UNVISITED) dfs(e.id);
+  }
+}
+
+function buildTopologicalOrder(events: Event[], eventMap: Map<string, Event>): string[] {
+  const eventIds = new Set(events.map(e => e.id));
+  const inDegree = new Map<string, number>(events.map(e => [e.id, 0]));
+  const successors = new Map<string, string[]>(events.map(e => [e.id, []]));
+
+  for (const e of events) {
+    for (const prereq of (e.prerequisites ?? [])) {
+      if (eventIds.has(prereq)) {
+        successors.get(prereq)!.push(e.id);
+        inDegree.set(e.id, inDegree.get(e.id)! + 1);
+      }
+    }
+  }
+
+  const ready = events.filter(e => inDegree.get(e.id) === 0).map(e => e.id);
+  const result: string[] = [];
+
+  while (ready.length > 0) {
+    // More successors first (unblocks more dependent events);
+    // shorter duration first as tiebreaker (leaves more room for others).
+    ready.sort((a, b) => {
+      const succDiff = successors.get(b)!.length - successors.get(a)!.length;
+      if (succDiff !== 0) return succDiff;
+      return eventMap.get(a)!.duration - eventMap.get(b)!.duration;
+    });
+
+    const id = ready.shift()!;
+    result.push(id);
+
+    for (const succ of successors.get(id)!) {
+      const deg = inDegree.get(succ)! - 1;
+      inDegree.set(succ, deg);
+      if (deg === 0) ready.push(succ);
+    }
+  }
+
+  return result;
+}
+
+// Find the earliest start time for an event in a room given existing assignments (sorted by startTime).
+// Returns null if the event cannot fit within [minStart, maxEnd].
+function findEarliestSlot(
+  roomSlots: Assignment[],
+  duration: number,
+  minStart: number,
+  maxEnd: number,
+  gap: number
+): number | null {
+  let candidate = minStart;
+
+  for (const existing of roomSlots) {
+    // Can we fit before this existing event (with required gap after us)?
+    if (candidate + duration + gap <= existing.startTime) {
+      return candidate;
+    }
+    // Move past this existing event.
+    candidate = Math.max(candidate, existing.endTime + gap);
+  }
+
+  // Try placing after all existing events.
+  return candidate + duration <= maxEnd ? candidate : null;
+}
+
+export function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {
+  const gap = options.gap ?? 15;
+
+  detectCycles(events);
+
+  if (events.length === 0) return { assignments: [], unscheduled: [] };
+
+  const eventMap = new Map<string, Event>(events.map(e => [e.id, e]));
+  const eventIds = new Set(events.map(e => e.id));
+  const order = buildTopologicalOrder(events, eventMap);
+
+  // Per-room list of placed assignments, maintained in startTime order.
+  const roomSlots = new Map<string, Assignment[]>(rooms.map(r => [r.id, []]));
+  const scheduled = new Map<string, Assignment>();
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+
+  for (const eventId of order) {
+    const event = eventMap.get(eventId)!;
+    const attendees = event.attendees ?? 1;
+
+    // Derive the earliest allowed start from prerequisites.
+    let minStart = options.startTime;
+    let prereqBlocked = false;
+
+    for (const prereqId of (event.prerequisites ?? [])) {
+      if (!eventIds.has(prereqId)) continue; // external prereq — treat as already satisfied
+      const prereq = scheduled.get(prereqId);
+      if (!prereq) { prereqBlocked = true; break; }
+      minStart = Math.max(minStart, prereq.endTime + gap);
+    }
+
+    if (prereqBlocked) {
+      unscheduled.push(eventId);
+      continue;
+    }
+
+    // Build candidate room list: preferred room first, then smallest-capacity-that-fits.
+    const eligible = rooms
+      .filter(r => r.capacity >= attendees)
+      .sort((a, b) => {
+        const aPref = a.id === event.preferredRoom ? 0 : 1;
+        const bPref = b.id === event.preferredRoom ? 0 : 1;
+        if (aPref !== bPref) return aPref - bPref;
+        return a.capacity - b.capacity;
+      });
+
+    let placed = false;
+    for (const room of eligible) {
+      const slots = roomSlots.get(room.id)!;
+      const slot = findEarliestSlot(slots, event.duration, minStart, options.endTime, gap);
+
+      if (slot !== null) {
+        const assignment: Assignment = {
+          eventId,
+          roomId: room.id,
+          startTime: slot,
+          endTime: slot + event.duration,
+        };
+
+        // Insert into slots maintaining startTime order.
+        let i = slots.length;
+        while (i > 0 && slots[i - 1].startTime > slot) i--;
+        slots.splice(i, 0, assignment);
+
+        assignments.push(assignment);
+        scheduled.set(eventId, assignment);
+        placed = true;
+        break;
+      }
+    }
+
+    if (!placed) unscheduled.push(eventId);
+  }
+
+  return { assignments, unscheduled };
+}
+
+export default schedule;
