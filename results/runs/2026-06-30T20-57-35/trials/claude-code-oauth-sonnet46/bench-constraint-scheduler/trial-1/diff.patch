+describe('preferred room', () => {
+  it('assigns event to preferred room when available', () => {
+    const events: Event[] = [{ id: 'A', name: 'A', duration: 60, preferredRoom: 'R2' }];
+    const rooms: Room[] = [
+      { id: 'R1', name: 'R1', capacity: 10 },
+      { id: 'R2', name: 'R2', capacity: 10 },
+    ];
+    const { assignments } = schedule(events, rooms, DAY);
+    expect(assignments[0].roomId).toBe('R2');
+  });
+
+  it('falls back to another room when preferred lacks capacity', () => {
+    // R2 is the preference but it's too small; R1 should be used instead.
+    const events: Event[] = [{ id: 'B', name: 'B', duration: 60, attendees: 8, preferredRoom: 'R2' }];
+    const rooms: Room[] = [
+      { id: 'R1', name: 'R1', capacity: 10 },
+      { id: 'R2', name: 'R2', capacity: 3 }, // too small for B
+    ];
+    const { assignments, unscheduled } = schedule(events, rooms, DAY);
+    expect(unscheduled).toEqual([]);
+    const b = assignments.find(x => x.eventId === 'B')!;
+    expect(b.roomId).toBe('R1');
+  });
+});
+
+describe('maximization', () => {
+  it('schedules more short events instead of one long one', () => {
+    // Window: 120 min, gap=0, one room.
+    // A: 120 min (fills entire window)
+    // B: 60 min, C: 60 min (two that fit together)
+    // Optimal: B+C (2 events) rather than A (1 event).
+    const opts: ScheduleOptions = { startTime: 0, endTime: 120, gap: 0 };
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 120 },
+      { id: 'B', name: 'B', duration: 60 },
+      { id: 'C', name: 'C', duration: 60 },
+    ];
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 10 }];
+    const { assignments } = schedule(events, rooms, opts);
+    // Should schedule at least 2 events (B and C) rather than just A
+    expect(assignments.length).toBeGreaterThanOrEqual(2);
+  });
+
+  it('fills multiple rooms efficiently', () => {
+    const opts: ScheduleOptions = { startTime: 0, endTime: 120, gap: 0 };
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 60 },
+      { id: 'B', name: 'B', duration: 60 },
+      { id: 'C', name: 'C', duration: 60 },
+      { id: 'D', name: 'D', duration: 60 },
+    ];
+    const rooms: Room[] = [
+      { id: 'R1', name: 'R1', capacity: 10 },
+      { id: 'R2', name: 'R2', capacity: 10 },
+    ];
+    const { assignments, unscheduled } = schedule(events, rooms, opts);
+    expect(unscheduled).toEqual([]);
+    expect(assignments).toHaveLength(4);
+  });
+
+  it('uses gaps between events to fit additional events', () => {
+    // R1 has A and C with enough gap between them for B.
+    const opts: ScheduleOptions = { startTime: 0, endTime: 200, gap: 10 };
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 60 },
+      { id: 'B', name: 'B', duration: 30 },
+      { id: 'C', name: 'C', duration: 60 },
+    ];
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 10 }];
+    const { assignments, unscheduled } = schedule(events, rooms, opts);
+    // A(0-60) B(70-100) C(110-170) all fit within 200
+    expect(unscheduled).toEqual([]);
+    expect(assignments).toHaveLength(3);
+  });
+});
+
+describe('default attendees and gap', () => {
+  it('defaults attendees to 1', () => {
+    const events: Event[] = [{ id: 'A', name: 'A', duration: 60 }]; // no attendees field
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 1 }];  // capacity exactly 1
+    const { assignments, unscheduled } = schedule(events, rooms, DAY);
+    expect(unscheduled).toEqual([]);
+    expect(assignments).toHaveLength(1);
+  });
+
+  it('defaults gap to 15', () => {
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 60 },
+      { id: 'B', name: 'B', duration: 60 },
+    ];
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 10 }];
+    // No gap specified → default 15
+    const { assignments } = schedule(events, rooms, { startTime: 0, endTime: 200 });
+    const sorted = [...assignments].sort((a, b) => a.startTime - b.startTime);
+    expect(sorted[1].startTime - sorted[0].endTime).toBeGreaterThanOrEqual(15);
+  });
