@@ -0,0 +1,293 @@
+import { describe, it, expect } from 'vitest';
+import { schedule } from './index.js';
+import type { Event, Room, ScheduleOptions } from './index.js';
+
+const DAY: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 15 }; // 9am–5pm
+
+describe('basic scheduling', () => {
+  it('schedules a single event', () => {
+    const events: Event[] = [{ id: 'A', name: 'A', duration: 60 }];
+    const rooms: Room[] = [{ id: 'R1', name: 'Room 1', capacity: 10 }];
+    const { assignments, unscheduled } = schedule(events, rooms, DAY);
+    expect(unscheduled).toEqual([]);
+    expect(assignments).toHaveLength(1);
+    expect(assignments[0].eventId).toBe('A');
+    expect(assignments[0].roomId).toBe('R1');
+    expect(assignments[0].startTime).toBe(540);
+    expect(assignments[0].endTime).toBe(600);
+  });
+
+  it('returns empty result for no events', () => {
+    const { assignments, unscheduled } = schedule([], [{ id: 'R1', name: 'R1', capacity: 10 }], DAY);
+    expect(assignments).toEqual([]);
+    expect(unscheduled).toEqual([]);
+  });
+
+  it('schedules two events in the same room with gap', () => {
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 60 },
+      { id: 'B', name: 'B', duration: 60 },
+    ];
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 10 }];
+    const { assignments, unscheduled } = schedule(events, rooms, DAY);
+    expect(unscheduled).toEqual([]);
+    const a = assignments.find(x => x.eventId === 'A')!;
+    const b = assignments.find(x => x.eventId === 'B')!;
+    // Gap between them must be >= 15
+    const later = a.startTime < b.startTime ? b : a;
+    const earlier = a.startTime < b.startTime ? a : b;
+    expect(later.startTime - earlier.endTime).toBeGreaterThanOrEqual(15);
+  });
+});
+
+describe('capacity constraint', () => {
+  it('unschedules event when no room has enough capacity', () => {
+    const events: Event[] = [{ id: 'A', name: 'A', duration: 60, attendees: 50 }];
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 30 }];
+    const { assignments, unscheduled } = schedule(events, rooms, DAY);
+    expect(assignments).toHaveLength(0);
+    expect(unscheduled).toEqual(['A']);
+  });
+
+  it('uses smallest room that fits', () => {
+    const events: Event[] = [{ id: 'A', name: 'A', duration: 60, attendees: 5 }];
+    const rooms: Room[] = [
+      { id: 'R1', name: 'Small', capacity: 5 },
+      { id: 'R2', name: 'Large', capacity: 100 },
+    ];
+    const { assignments } = schedule(events, rooms, DAY);
+    expect(assignments[0].roomId).toBe('R1');
+  });
+
+  it('falls back to larger room when small is occupied', () => {
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 480, attendees: 5 }, // fills whole day
+      { id: 'B', name: 'B', duration: 60, attendees: 5 },
+    ];
+    const rooms: Room[] = [
+      { id: 'R1', name: 'Small', capacity: 5 },
+      { id: 'R2', name: 'Large', capacity: 100 },
+    ];
+    const { assignments, unscheduled } = schedule(events, rooms, DAY);
+    expect(unscheduled).toHaveLength(0);
+    const a = assignments.find(x => x.eventId === 'A')!;
+    const b = assignments.find(x => x.eventId === 'B')!;
+    expect(a.roomId).not.toBe(b.roomId);
+  });
+});
+
+describe('time window constraint', () => {
+  it('unschedules event that does not fit in window', () => {
+    const events: Event[] = [{ id: 'A', name: 'A', duration: 600 }]; // longer than 480min day
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 10 }];
+    const { assignments, unscheduled } = schedule(events, rooms, DAY);
+    expect(assignments).toHaveLength(0);
+    expect(unscheduled).toEqual(['A']);
+  });
+
+  it('respects explicit gap of 0', () => {
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 60 },
+      { id: 'B', name: 'B', duration: 60 },
+    ];
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 10 }];
+    const { assignments } = schedule(events, rooms, { startTime: 0, endTime: 120, gap: 0 });
+    expect(assignments).toHaveLength(2);
+    const sorted = [...assignments].sort((a, b) => a.startTime - b.startTime);
+    expect(sorted[0].endTime).toBe(sorted[1].startTime); // adjacent, no gap
+  });
+});
+
+describe('prerequisites', () => {
+  it('schedules dependent event after prerequisite', () => {
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 60 },
+      { id: 'B', name: 'B', duration: 60, prerequisites: ['A'] },
+    ];
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 10 }];
+    const { assignments, unscheduled } = schedule(events, rooms, DAY);
+    expect(unscheduled).toEqual([]);
+    const a = assignments.find(x => x.eventId === 'A')!;
+    const b = assignments.find(x => x.eventId === 'B')!;
+    expect(b.startTime).toBeGreaterThanOrEqual(a.endTime + 15);
+  });
+
+  it('applies gap between prerequisite and dependent even in different rooms', () => {
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 60, preferredRoom: 'R1' },
+      { id: 'B', name: 'B', duration: 60, prerequisites: ['A'], preferredRoom: 'R2' },
+    ];
+    const rooms: Room[] = [
+      { id: 'R1', name: 'R1', capacity: 10 },
+      { id: 'R2', name: 'R2', capacity: 10 },
+    ];
+    const { assignments } = schedule(events, rooms, DAY);
+    const a = assignments.find(x => x.eventId === 'A')!;
+    const b = assignments.find(x => x.eventId === 'B')!;
+    expect(a.roomId).toBe('R1');
+    expect(b.roomId).toBe('R2');
+    expect(b.startTime).toBeGreaterThanOrEqual(a.endTime + 15);
+  });
+
+  it('unschedules dependent when prerequisite is unscheduled', () => {
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 600 }, // can't fit
+      { id: 'B', name: 'B', duration: 60, prerequisites: ['A'] },
+    ];
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 10 }];
+    const { unscheduled } = schedule(events, rooms, DAY);
+    expect(unscheduled).toContain('A');
+    expect(unscheduled).toContain('B');
+  });
+
+  it('ignores prerequisites that reference unknown event IDs', () => {
+    const events: Event[] = [
+      { id: 'B', name: 'B', duration: 60, prerequisites: ['NONEXISTENT'] },
+    ];
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 10 }];
+    const { assignments, unscheduled } = schedule(events, rooms, DAY);
+    expect(unscheduled).toEqual([]);
+    expect(assignments).toHaveLength(1);
+  });
+
+  it('chain of prerequisites A->B->C scheduled in order', () => {
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 30 },
+      { id: 'B', name: 'B', duration: 30, prerequisites: ['A'] },
+      { id: 'C', name: 'C', duration: 30, prerequisites: ['B'] },
+    ];
+    const rooms: Room[] = [{ id: 'R1', name: 'R1', capacity: 10 }];
+    const { assignments, unscheduled } = schedule(events, rooms, DAY);
+    expect(unscheduled).toEqual([]);
+    const a = assignments.find(x => x.eventId === 'A')!;
+    const b = assignments.find(x => x.eventId === 'B')!;
+    const c = assignments.find(x => x.eventId === 'C')!;
+    expect(b.startTime).toBeGreaterThanOrEqual(a.endTime + 15);
+    expect(c.startTime).toBeGreaterThanOrEqual(b.endTime + 15);
+  });
+});
