+  });
+
+  it('throws on two-node cycle', () => {
+    const events: Event[] = [
+      { id: 'A', name: 'A', duration: 60, prerequisites: ['B'] },
+      { id: 'B', name: 'B', duration: 60, prerequisites: ['A'] },
