+import { threeWayMerge } from './merge.js';
+import type { Version, Conflict, MergeResult, DocState, BranchState } from './types.js';
+export type { Version, Conflict, MergeResult, DocumentStore } from './types.js';
+
+function clone<T>(val: T): T {
+  return JSON.parse(JSON.stringify(val));
+}
+
+function makeVersionId(): string {
+  return Math.random().toString(36).slice(2) + Date.now().toString(36);
+}
+
+class DocumentStoreImpl {
+  private branches: Map<string, BranchState> = new Map();
+  // branchPoint[branch] = snapshot of the branch it was created from at creation time
+  private branchPoints: Map<string, Map<string, object | null>> = new Map();
+  // parentBranch[branch] = the branch it was forked from
+  private parentBranch: Map<string, string> = new Map();
+  private current = 'main';
+
+  constructor() {
+    this.branches.set('main', new Map());
+    this.branchPoints.set('main', new Map());
+  }
+
+  private branchState(name?: string): BranchState {
+    const b = this.branches.get(name ?? this.current);
+    if (!b) throw new Error(`Branch not found: ${name ?? this.current}`);
+    return b;
+  }
+
+  private liveDoc(id: string, branchName?: string): DocState {
+    const state = this.branchState(branchName);
+    const doc = state.get(id);
+    if (!doc || doc.deleted) throw new Error(`Document not found: ${id}`);
+    return doc;
+  }
+
+  create(id: string, content: object): void {
+    const state = this.branchState();
+    const existing = state.get(id);
+    if (existing && !existing.deleted) throw new Error(`Document already exists: ${id}`);
+    const version: Version = { id: makeVersionId(), timestamp: Date.now(), content: clone(content) };
+    state.set(id, { content: clone(content), versions: [version], deleted: false });
+  }
+
+  get(id: string): object {
+    return clone(this.liveDoc(id).content);
+  }
+
+  update(id: string, content: object): void {
+    const doc = this.liveDoc(id);
+    const version: Version = { id: makeVersionId(), timestamp: Date.now(), content: clone(content) };
+    doc.content = clone(content);
+    doc.versions.push(version);
+  }
+
+  delete(id: string): void {
+    const doc = this.liveDoc(id);
+    doc.deleted = true;
+  }
+
+  getHistory(id: string): Version[] {
+    return clone(this.liveDoc(id).versions);
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const doc = this.liveDoc(id);
+    const v = doc.versions.find(v => v.id === versionId);
+    if (!v) throw new Error(`Version not found: ${versionId}`);
+    return clone(v.content);
+  }
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) throw new Error(`Branch already exists: ${name}`);
+    const src = fromBranch ?? this.current;
+    const srcState = this.branchState(src);
+
+    const newState: BranchState = new Map();
+    const snapshot: Map<string, object | null> = new Map();
+
+    for (const [id, doc] of srcState) {
+      newState.set(id, clone(doc));
+      snapshot.set(id, doc.deleted ? null : clone(doc.content));
+    }
+
+    this.branches.set(name, newState);
+    this.branchPoints.set(name, snapshot);
+    this.parentBranch.set(name, src);
+  }
+
+  switchBranch(name: string): void {
+    if (!this.branches.has(name)) throw new Error(`Branch not found: ${name}`);
+    this.current = name;
+  }
+
+  getBranch(): string {
+    return this.current;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  merge(sourceBranch: string): MergeResult {
+    if (!this.branches.has(sourceBranch)) throw new Error(`Branch not found: ${sourceBranch}`);
+    const targetState = this.branchState();
+    const sourceState = this.branchState(sourceBranch);
+
+    // Base is the snapshot at the point the source branch diverged from the current branch
+    // We need to find the common ancestor snapshot.
+    // Strategy: the branch point snapshot stored on sourceBranch is the state of its parent at fork time.
+    // If sourceBranch was forked from current branch, that snapshot is the base.
+    // Otherwise, we use an empty base (conservative).
+    const baseSnapshot = this.findBase(sourceBranch, this.current);
+
+    const allIds = new Set([...targetState.keys(), ...sourceState.keys()]);
+    const merged: Record<string, object> = {};
+    const allConflicts: Conflict[] = [];
+
+    for (const id of allIds) {
+      const baseContent: object = baseSnapshot.get(id) ?? {};
+      const ourDoc = targetState.get(id);
+      const theirDoc = sourceState.get(id);
+
+      const ourDeleted = !ourDoc || ourDoc.deleted;
+      const theirDeleted = !theirDoc || theirDoc.deleted;
+      const baseNull = !baseSnapshot.has(id) || baseSnapshot.get(id) === null;
+
+      if (ourDeleted && theirDeleted) continue;
+      if (ourDeleted && !theirDeleted) {
+        // we deleted, they kept/created — if base had it, conflict; if new on their side take it
+        if (baseNull) {
+          merged[id] = clone(theirDoc!.content);
+        }
+        // else: we deleted something that existed in base; they kept it — take ours (deleted), no conflict
+        continue;
+      }
+      if (!ourDeleted && theirDeleted) {
+        // they deleted, we kept — if base had it, keep ours (we modified it or it's unchanged)
+        merged[id] = clone(ourDoc!.content);
+        continue;
+      }
+
+      // both alive
+      const { result, conflicts } = threeWayMerge(
+        baseContent,
+        ourDoc!.content,
+        theirDoc!.content,
+        id
+      );
+      merged[id] = result;
+      allConflicts.push(...conflicts);
+    }
+
+    if (allConflicts.length === 0) {
+      // apply
+      for (const [id, content] of Object.entries(merged)) {
+        const existing = targetState.get(id);
+        if (!existing || existing.deleted) {
+          const version: Version = { id: makeVersionId(), timestamp: Date.now(), content: clone(content) };
+          targetState.set(id, { content: clone(content), versions: [version], deleted: false });
+        } else {
+          const version: Version = { id: makeVersionId(), timestamp: Date.now(), content: clone(content) };
+          existing.content = clone(content);
+          existing.versions.push(version);
+        }
+      }
+      return { merged, conflicts: [], applied: true };
+    }
+
+    return { merged, conflicts: allConflicts, applied: false };
+  }
+
+  private findBase(sourceBranch: string, targetBranch: string): Map<string, object | null> {
+    const sourceParent = this.parentBranch.get(sourceBranch);
+    if (sourceParent === targetBranch) {
+      return this.branchPoints.get(sourceBranch) ?? new Map();
+    }
+    const targetParent = this.parentBranch.get(targetBranch);
+    if (targetParent === sourceBranch) {
+      return this.branchPoints.get(targetBranch) ?? new Map();
+    }
+    // No direct ancestry found — empty base
+    return new Map();
+  }
+}
+
+export function createDocumentStore() {
+  return new DocumentStoreImpl();
+}
+
+export { DocumentStoreImpl as DocumentStore };
