+import type { Conflict } from './types.js';
+
+function flattenPaths(obj: any, prefix = ''): Record<string, any> {
+  const result: Record<string, any> = {};
+  for (const key of Object.keys(obj)) {
+    const path = prefix ? `${prefix}.${key}` : key;
+    const val = obj[key];
+    if (val !== null && typeof val === 'object' && !Array.isArray(val)) {
+      Object.assign(result, flattenPaths(val, path));
+    } else {
+      result[path] = val;
+    }
+  }
+  return result;
+}
+
+function setPath(obj: any, path: string, value: any): void {
+  const parts = path.split('.');
+  let cur = obj;
+  for (let i = 0; i < parts.length - 1; i++) {
+    if (cur[parts[i]] === undefined || typeof cur[parts[i]] !== 'object') {
+      cur[parts[i]] = {};
+    }
+    cur = cur[parts[i]];
+  }
+  cur[parts[parts.length - 1]] = value;
+}
+
+export function threeWayMerge(
+  base: object,
+  ours: object,
+  theirs: object,
+  docId: string
+): { result: object; conflicts: Conflict[] } {
+  const baseFlat = flattenPaths(base);
+  const oursFlat = flattenPaths(ours);
+  const theirsFlat = flattenPaths(theirs);
+
+  const allPaths = new Set([
+    ...Object.keys(baseFlat),
+    ...Object.keys(oursFlat),
+    ...Object.keys(theirsFlat),
+  ]);
+
+  const conflicts: Conflict[] = [];
+  const result: any = {};
+
+  for (const path of allPaths) {
+    const baseVal = baseFlat[path];
+    const ourVal = oursFlat[path];
+    const theirVal = theirsFlat[path];
+
+    const oursChanged = JSON.stringify(ourVal) !== JSON.stringify(baseVal);
+    const theirsChanged = JSON.stringify(theirVal) !== JSON.stringify(baseVal);
+
+    if (!oursChanged && !theirsChanged) {
+      if (ourVal !== undefined) setPath(result, path, ourVal);
+    } else if (oursChanged && !theirsChanged) {
+      if (ourVal !== undefined) setPath(result, path, ourVal);
+    } else if (!oursChanged && theirsChanged) {
+      if (theirVal !== undefined) setPath(result, path, theirVal);
+    } else {
+      // both changed
+      if (JSON.stringify(ourVal) === JSON.stringify(theirVal)) {
+        if (ourVal !== undefined) setPath(result, path, ourVal);
+      } else {
+        conflicts.push({ documentId: docId, path, base: baseVal, ours: ourVal, theirs: theirVal });
+        // favor ours in the result
+        if (ourVal !== undefined) setPath(result, path, ourVal);
+      }
+    }
+  }
+
+  return { result, conflicts };
+}
