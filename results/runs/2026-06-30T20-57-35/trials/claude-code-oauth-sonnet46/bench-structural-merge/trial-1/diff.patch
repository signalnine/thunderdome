index 0000000..fc8b5b3
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,285 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import { createDocumentStore } from './index.js';
+
+function store() {
+  return createDocumentStore();
+}
+
+describe('CRUD', () => {
+  it('create and get', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+
+  it('create throws on duplicate', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    expect(() => s.create('a', { x: 2 })).toThrow();
+  });
+
+  it('get throws on missing', () => {
+    const s = store();
+    expect(() => s.get('a')).toThrow();
+  });
+
+  it('update replaces content', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    s.update('a', { x: 2 });
+    expect(s.get('a')).toEqual({ x: 2 });
+  });
+
+  it('update throws on missing', () => {
+    const s = store();
+    expect(() => s.update('a', { x: 1 })).toThrow();
+  });
+
+  it('delete removes document', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    s.delete('a');
+    expect(() => s.get('a')).toThrow();
+  });
+
+  it('delete throws on missing', () => {
+    const s = store();
+    expect(() => s.delete('a')).toThrow();
+  });
+
+  it('get returns deep clone', () => {
+    const s = store();
+    s.create('a', { x: { y: 1 } });
+    const got = s.get('a') as any;
+    got.x.y = 99;
+    expect((s.get('a') as any).x.y).toBe(1);
+  });
+
+  it('create can reuse id after delete', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    s.delete('a');
+    s.create('a', { x: 2 });
+    expect(s.get('a')).toEqual({ x: 2 });
+  });
+});
+
+describe('Version history', () => {
+  it('create generates one version', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    const h = s.getHistory('a');
+    expect(h).toHaveLength(1);
+    expect(h[0].content).toEqual({ x: 1 });
+  });
+
+  it('update adds versions in order', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    s.update('a', { x: 2 });
+    s.update('a', { x: 3 });
+    const h = s.getHistory('a');
+    expect(h).toHaveLength(3);
+    expect(h[0].content).toEqual({ x: 1 });
+    expect(h[2].content).toEqual({ x: 3 });
+  });
+
+  it('versions have unique ids', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    s.update('a', { x: 2 });
+    const h = s.getHistory('a');
+    expect(h[0].id).not.toBe(h[1].id);
+  });
+
+  it('getVersion returns correct content', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    s.update('a', { x: 2 });
+    const h = s.getHistory('a');
+    expect(s.getVersion('a', h[0].id)).toEqual({ x: 1 });
+    expect(s.getVersion('a', h[1].id)).toEqual({ x: 2 });
+  });
+
+  it('getVersion throws on bad version id', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    expect(() => s.getVersion('a', 'nope')).toThrow();
+  });
+});
+
+describe('Branching', () => {
+  it('default branch is main', () => {
+    expect(store().getBranch()).toBe('main');
+  });
+
+  it('listBranches returns all branches', () => {
+    const s = store();
+    s.createBranch('dev');
+    expect(s.listBranches()).toContain('main');
+    expect(s.listBranches()).toContain('dev');
+  });
+
+  it('switchBranch changes active branch', () => {
+    const s = store();
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    expect(s.getBranch()).toBe('dev');
+  });
+
+  it('switchBranch throws on unknown branch', () => {
+    expect(() => store().switchBranch('nope')).toThrow();
+  });
+
+  it('createBranch copies current state', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+
+  it('changes on dev do not affect main', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    s.update('a', { x: 99 });
+    s.switchBranch('main');
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+
+  it('new doc on dev not visible on main', () => {
+    const s = store();
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    s.create('a', { x: 1 });
+    s.switchBranch('main');
+    expect(() => s.get('a')).toThrow();
+  });
+
+  it('createBranch from specific branch', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    s.createBranch('dev', 'main');
+    s.switchBranch('dev');
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+});
+
+describe('Merging — no conflicts', () => {
+  it('merge new doc from source into target', () => {
+    const s = store();
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    s.create('a', { x: 1 });
+    s.switchBranch('main');
+    const result = s.merge('dev');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toHaveLength(0);
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+
+  it('merge field change from source', () => {
+    const s = store();
+    s.create('doc', { x: 1, y: 2 });
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    s.update('doc', { x: 10, y: 2 });
+    s.switchBranch('main');
+    const result = s.merge('dev');
+    expect(result.applied).toBe(true);
+    expect(s.get('doc')).toEqual({ x: 10, y: 2 });
+  });
+
+  it('non-overlapping field changes merge cleanly', () => {
+    const s = store();
+    s.create('doc', { x: 1, y: 2 });
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    s.update('doc', { x: 1, y: 99 });
+    s.switchBranch('main');
+    s.update('doc', { x: 50, y: 2 });
+    const result = s.merge('dev');
+    expect(result.applied).toBe(true);
+    expect(s.get('doc')).toEqual({ x: 50, y: 99 });
+  });
+
+  it('same change on both sides — no conflict', () => {
+    const s = store();
+    s.create('doc', { x: 1 });
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    s.update('doc', { x: 42 });
+    s.switchBranch('main');
+    s.update('doc', { x: 42 });
+    const result = s.merge('dev');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toHaveLength(0);
+  });
+
+  it('independent documents merge cleanly', () => {
+    const s = store();
+    s.create('a', { v: 1 });
+    s.create('b', { v: 1 });
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    s.update('b', { v: 99 });
+    s.switchBranch('main');
+    s.update('a', { v: 50 });
+    const result = s.merge('dev');
+    expect(result.applied).toBe(true);
+    expect(s.get('a')).toEqual({ v: 50 });
+    expect(s.get('b')).toEqual({ v: 99 });
+  });
+});
+
+describe('Merging — conflicts', () => {
+  it('conflicting field change returns conflicts and does not apply', () => {
+    const s = store();
+    s.create('doc', { x: 1 });
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    s.update('doc', { x: 99 });
+    s.switchBranch('main');
+    s.update('doc', { x: 42 });
+    const result = s.merge('dev');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts).toHaveLength(1);
+    expect(result.conflicts[0]).toMatchObject({
+      documentId: 'doc',
+      path: 'x',
+      base: 1,
+      ours: 42,
+      theirs: 99,
+    });
+    // branch unchanged
+    expect(s.get('doc')).toEqual({ x: 42 });
+  });
+
+  it('merged field in result favors ours', () => {
+    const s = store();
+    s.create('doc', { x: 1 });
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    s.update('doc', { x: 99 });
+    s.switchBranch('main');
+    s.update('doc', { x: 42 });
+    const result = s.merge('dev');
+    expect((result.merged['doc'] as any).x).toBe(42);
+  });
+
+  it('nested conflict detected at correct path', () => {
+    const s = store();
+    s.create('doc', { a: { b: 1 } });
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    s.update('doc', { a: { b: 99 } });
+    s.switchBranch('main');
+    s.update('doc', { a: { b: 42 } });
+    const result = s.merge('dev');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts[0].path).toBe('a.b');
+    expect(result.conflicts[0].base).toBe(1);
+  });
+});
