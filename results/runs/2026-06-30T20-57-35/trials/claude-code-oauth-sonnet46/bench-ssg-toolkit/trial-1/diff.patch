@@ -0,0 +1,46 @@
+import { marked } from 'marked';
+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      async transformContent(file: ContentFile, _ctx: BuildContext): Promise<ContentFile> {
+        let content = file.content;
+
+        // Extract footnote definitions before markdown processing
+        const footnotes = new Map<string, string>();
+        content = content.replace(/\[\^(\d+)\]:\s*(.+)/g, (_match, num: string, text: string) => {
+          footnotes.set(num, text.trim());
+          return '';
+        });
+
+        // Replace inline footnote references with HTML
+        content = content.replace(/\[\^(\d+)\]/g, (_match, num: string) => {
+          return `<sup><a href="#fn-${num}">${num}</a></sup>`;
+        });
+
+        // Convert admonition containers to divs before marked
+        content = content.replace(/:::(\w+)\n([\s\S]*?)\n:::/g, (_match, type: string, inner: string) => {
+          return `<div class="admonition admonition-${type}">\n${inner}\n</div>`;
+        });
+
+        const html = await Promise.resolve(marked.parse(content)) as string;
+
+        if (footnotes.size === 0) {
+          return { ...file, content: html };
+        }
+
+        let section = '<section class="footnotes"><ol>';
+        for (const [num, text] of footnotes) {
+          section += `<li id="fn-${num}">${text}</li>`;
+        }
+        section += '</ol></section>';
+
+        return { ...file, content: html + section };
+      },
+    },
+  };
+}
