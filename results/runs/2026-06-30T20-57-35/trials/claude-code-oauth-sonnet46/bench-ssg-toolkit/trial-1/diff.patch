@@ -0,0 +1,27 @@
+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const index = ctx.files.map((file: ContentFile) => {
+          const plainText = file.content.replace(/<[^>]*>/g, '').trim();
+          const entry: { slug: string; title: string; content: string; tags?: string[] } = {
+            slug: file.slug,
+            title: file.title,
+            content: plainText,
+          };
+          if (file.tags) {
+            entry.tags = file.tags;
+          }
+          return entry;
+        });
+
+        ctx.output.set('search-index.json', JSON.stringify(index));
+      },
+    },
+  };
+}
