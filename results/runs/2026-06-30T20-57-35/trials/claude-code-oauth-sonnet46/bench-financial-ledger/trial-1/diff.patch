   }\n    }\n\n    // Bug 6: currency mismatch validation wasn't implemented\n    const allAccountNames = [...debits.map(d => d.account), ...credits.map(c => c.account)];\n    const currencies = new Set(allAccountNames.map(n => this.accounts.get(n)!.currency));\n    if (currencies.size > 1) {\n      throw new Error('Currency mismatch: all accounts in an entry must use the same currency');\n    }\n\n    const totalDebits = debits.reduce((sum, d) => sum + d.amount, 0);\n    const totalCredits = credits.reduce((sum, c) => sum + c.amount, 0);\n    if (totalDebits !== totalCredits) {\n      throw new Error(`Debits (${totalDebits}) must equal credits (${totalCredits})`);\n    }\n\n    for (const d of debits) {\n      if (d.amount <= 0) throw new Error('Amounts must be positive');\n    }\n    for (const c of credits) {\n      if (c.amount <= 0) throw new Error('Amounts must be positive');\n    }\n\n    const entry: JournalEntry = {\n      id: this.nextId++,\n      description,\n      debits: [...debits],\n      credits: [...credits],\n      date: date ?? new Date(),\n    };\n    this.entries.push(entry);\n    return entry;\n  }\n\n  getBalance(accountName: string): number {\n    const account = this.accounts.get(accountName);\n    if (!account) throw new Error(`Account not found: ${accountName}`);\n\n    let balance = 0;\n    for (const entry of this.entries) {\n      for (const d of entry.debits) {\n        if (d.account === accountName) balance += d.amount;\n      }\n      for (const c of entry.credits) {\n        if (c.account === accountName) balance -= c.amount;\n      }\n    }\n\n    // Bug 8: liabilities/equity/revenue have credit-normal balances — flip sign so\n    // a credited liability returns a positive number\n    const creditNormal = account.type === 'liability' || account.type === 'equity' || account.type === 'revenue';\n    return creditNormal ? -balance : balance;\n  }\n\n  getTrialBalance(): BalanceEntry[] {\n    const result: BalanceEntry[] = [];\n\n    for (const [name, account] of this.accounts) {\n      let totalDebits = 0;\n      let totalCredits = 0;\n\n      for (const entry of this.entries) {\n        for (const d of entry.debits) {\n          if (d.account === name) totalDebits += d.amount;\n        }\n        // Bug 1: credits were being added to totalDebits instead of totalCredits\n        for (const c of entry.credits) {\n          if (c.account === name) totalCredits += c.amount;\n        }\n      }\n\n      result.push({\n        account: name,\n        type: account.type,\n        debit: totalDebits,\n        credit: totalCredits,\n      });\n    }\n\n    return result;\n  }\n\n  getStatement(\n    accountName: string,\n    startDate?: Date,\n    endDate?: Date\n  ): StatementLine[] {\n    const account = this.accounts.get(accountName);\n    if (!account) throw new Error(`Account not found: ${accountName}`);\n\n    const lines: StatementLine[] = [];\n    let runningBalance = 0;\n\n    const sorted = [...this.entries].sort(\n      (a, b) => a.date.getTime() - b.date.getTime()\n    );\n\n    for (const entry of sorted) {\n      // Bug 4: startDate filter used <= (exclusive), should be < (inclusive start)\n      if (startDate && entry.date.getTime() < startDate.getTime()) continue;\n      if (endDate && entry.date.getTime() > endDate.getTime()) continue;\n\n      let debit = 0;\n      let credit = 0;\n\n      for (const d of entry.debits) {\n        if (d.account === accountName) debit += d.amount;\n      }\n      for (const c of entry.credits) {\n        if (c.account === accountName) credit += c.amount;\n      }\n\n      if (debit === 0 && credit === 0) continue;\n\n      // Bug 2: running balance added debit + credit; credits should reduce balance\n      runningBalance += debit - credit;\n\n      lines.push({\n        date: entry.date,\n        description: entry.description,\n        debit,\n        credit,\n        balance: runningBalance,\n      });\n    }\n\n    return lines;\n  }\n\n  splitEntry(