+import type { Operation, InsertOperation, DeleteOperation } from './models.js';
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+export function transformOperation(clientOp: Operation, serverOp: Operation): Operation {
+  if (clientOp.type === 'insert' && serverOp.type === 'insert') {
+    return transformInsertInsert(clientOp, serverOp);
+  }
+  if (clientOp.type === 'insert' && serverOp.type === 'delete') {
+    return transformInsertDelete(clientOp, serverOp);
+  }
+  if (clientOp.type === 'delete' && serverOp.type === 'insert') {
+    return transformDeleteInsert(clientOp, serverOp);
+  }
+  if (clientOp.type === 'delete' && serverOp.type === 'delete') {
+    return transformDeleteDelete(clientOp, serverOp);
+  }
+  return clientOp;
+}
+
+function transformInsertInsert(client: InsertOperation, server: InsertOperation): InsertOperation {
+  // Server wins at same position: client shifts right
+  if (server.position <= client.position) {
+    return { ...client, position: client.position + server.text.length };
+  }
+  return client;
+}
+
+function transformInsertDelete(client: InsertOperation, server: DeleteOperation): InsertOperation {
+  const serverEnd = server.position + server.count;
+  if (serverEnd <= client.position) {
+    // Server deleted entirely before client's insert position
+    return { ...client, position: client.position - server.count };
+  }
+  if (server.position >= client.position) {
+    // Server deleted at or after client's position
+    return client;
+  }
+  // Client's insert position is within the deleted range
+  return { ...client, position: server.position };
+}
+
+function transformDeleteInsert(client: DeleteOperation, server: InsertOperation): DeleteOperation {
+  if (server.position <= client.position) {
+    // Server inserted before/at client's delete start
+    return { ...client, position: client.position + server.text.length };
+  }
+  if (server.position > client.position + client.count) {
+    // Server inserted after client's delete range
+    return client;
+  }
+  // Server inserted within client's delete range: expand to include inserted text
+  return { ...client, count: client.count + server.text.length };
+}
+
+function transformDeleteDelete(client: DeleteOperation, server: DeleteOperation): DeleteOperation {
+  const clientEnd = client.position + client.count;
+  const serverEnd = server.position + server.count;
+
+  if (serverEnd <= client.position) {
+    // Server deleted entirely before client
+    return { ...client, position: client.position - server.count };
+  }
+  if (server.position >= clientEnd) {
+    // Server deleted entirely after client
+    return client;
+  }
+
+  // Overlapping deletions
+  // How many chars the server deleted before client.position
+  const deletedBefore = Math.max(0, Math.min(client.position, serverEnd) - server.position);
+  // How many chars overlap between both deletions
+  const overlapStart = Math.max(client.position, server.position);
+  const overlapEnd = Math.min(clientEnd, serverEnd);
+  const overlap = Math.max(0, overlapEnd - overlapStart);
+
+  return {
+    type: 'delete',
+    position: client.position - deletedBefore,
+    count: Math.max(0, client.count - overlap),
+  };
+}
+
+export function validateOperation(op: Operation, contentLength: number): boolean {
+  if (op.type === 'insert') {
+    return (
+      typeof op.position === 'number' &&
+      op.position >= 0 &&
+      op.position <= contentLength &&
+      typeof op.text === 'string'
+    );
+  }
+  if (op.type === 'delete') {
+    return (
+      typeof op.position === 'number' &&
+      typeof op.count === 'number' &&
+      op.position >= 0 &&
+      op.count > 0 &&
+      op.position + op.count <= contentLength
+    );
+  }
+  return false;
+}
