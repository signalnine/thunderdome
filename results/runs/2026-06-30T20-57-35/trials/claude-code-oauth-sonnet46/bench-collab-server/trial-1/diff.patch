+++ b/src/server.ts
@@ -0,0 +1,68 @@
+import express from 'express';
+import http from 'http';
+import { WebSocketServer } from 'ws';
+import { createDb, type DB } from './db.js';
+import { createRoutes } from './routes.js';
+import { createWsServer } from './ws.js';
+
+export interface AppInstance {
+  app: express.Application;
+  server: http.Server;
+  wss: WebSocketServer;
+  db: DB;
+  start(port?: number): Promise<number>;
+  stop(): Promise<void>;
+}
+
+export function createApp(dbPath?: string): AppInstance {
+  const db = createDb(dbPath);
+  const app = express();
+  app.use(express.json());
+  app.use(createRoutes(db));
+
+  const server = http.createServer(app);
+  const wss = createWsServer(server, db);
+
+  const instance: AppInstance = {
+    app,
+    server,
+    wss,
+    db,
+
+    start(port = 0): Promise<number> {
+      return new Promise((resolve, reject) => {
+        server.once('error', reject);
+        server.listen(port, () => {
+          server.off('error', reject);
+          const addr = server.address();
+          if (!addr || typeof addr === 'string') {
+            reject(new Error('Failed to get bound port'));
+            return;
+          }
+          resolve(addr.port);
+        });
+      });
+    },
+
+    stop(): Promise<void> {
+      return new Promise((resolve) => {
+        // Terminate all open WebSocket connections
+        for (const ws of wss.clients) {
+          ws.terminate();
+        }
+        wss.close(() => {
+          server.close(() => {
+            try {
+              db.close();
+            } catch {
+              // Already closed
+            }
+            resolve();
+          });
+        });
+      });
+    },
+  };
+
+  return instance;
+}
diff --git a/src/ws.ts b/src/ws.ts
new file mode 100644
index 0000000..92f07bf
--- /dev/null
+++ b/src/ws.ts
@@ -0,0 +1,178 @@
+import { WebSocketServer, WebSocket } from 'ws';
+import type { IncomingMessage, Server } from 'http';
+import { randomUUID } from 'crypto';
+import type { DB } from './db.js';
+import type { Operation } from './models.js';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+
+interface HistoryEntry {
+  version: number;
+  op: Operation;
+}
+
+interface DocumentRoom {
+  content: string;
+  version: number;
+  clients: Map<WebSocket, string>;
+  history: HistoryEntry[];
+}
+
+function send(ws: WebSocket, msg: Record<string, unknown>): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify(msg));
+  }
+}
+
+export function createWsServer(server: Server, db: DB): WebSocketServer {
+  const wss = new WebSocketServer({ server });
+  const rooms = new Map<string, DocumentRoom>();
+
+  function getOrCreateRoom(docId: string): DocumentRoom | null {
+    const existing = rooms.get(docId);
+    if (existing) return existing;
+
+    const doc = db
+      .prepare('SELECT id, content FROM documents WHERE id = ?')
+      .get(docId) as { id: string; content: string } | undefined;
+    if (!doc) return null;
+
+    const row = db
+      .prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?')
+      .get(docId) as { v: number | null };
+    const version = row.v ?? 0;
+
+    const room: DocumentRoom = {
+      content: doc.content,
+      version,
+      clients: new Map(),
+      history: [],
+    };
+    rooms.set(docId, room);
+    return room;
+  }
+
+  wss.on('connection', (ws: WebSocket, req: IncomingMessage) => {
+    const docId = (req.url ?? '/').slice(1);
+
+    const room = getOrCreateRoom(docId);
+    if (!room) {
+      send(ws, { type: 'error', message: 'Document not found' });
+      ws.close();
+      return;
+    }
+
+    const connId = randomUUID();
+    db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(connId, docId);
+    room.clients.set(ws, connId);
+
+    send(ws, { type: 'sync', content: room.content, version: room.version });
+
+    ws.on('message', (data) => {
+      let msg: Record<string, unknown>;
+      try {
+        msg = JSON.parse(data.toString());
+      } catch {
+        send(ws, { type: 'error', message: 'Invalid JSON' });
+        return;
+      }
+
+      if (msg.type !== 'operation') {
+        send(ws, { type: 'error', message: 'Unknown message type' });
+        return;
+      }
+
+      const rawOp = msg.operation as Record<string, unknown> | undefined;
+      if (!rawOp) {
+        send(ws, { type: 'error', message: 'Missing operation' });
+        return;
+      }
+
+      if (rawOp.type !== 'insert' && rawOp.type !== 'delete') {
+        send(ws, { type: 'error', message: 'Invalid operation type' });
+        return;
+      }
+
+      let op: Operation;
+      if (rawOp.type === 'insert') {
+        op = {
+          type: 'insert',
+          position: rawOp.position as number,
+          text: rawOp.text as string,
+        };
+      } else {
+        op = {
+          type: 'delete',
+          position: rawOp.position as number,
+          count: rawOp.count as number,
+        };
+      }
+
+      // Transform against operations that arrived between client's version and current
+      const clientVersion = typeof msg.version === 'number' ? msg.version : room.version;
+      if (clientVersion < room.version) {
+        const missed = room.history.filter(
+          (h) => h.version >= clientVersion && h.version < room.version,
+        );
+        for (const { op: serverOp } of missed) {
+          op = transformOperation(op, serverOp);
+        }
+      }
+
+      // Handle no-op delete produced by OT (client's delete was already covered by server)
+      if (op.type === 'delete' && op.count === 0) {
+        send(ws, { type: 'ack', version: room.version });
+        return;
+      }
+
+      if (!validateOperation(op, room.content.length)) {
+        send(ws, { type: 'error', message: 'Operation out of bounds' });
+        return;
+      }
+
+      const prevVersion = room.version;
+      const newContent = applyOperation(room.content, op);
+      const newVersion = room.version + 1;
+
+      db.prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?").run(
+        newContent,
+        docId,
+      );
+      db.prepare(
+        'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)',
+      ).run(docId, newVersion, newContent, JSON.stringify(op));
+
+      room.history.push({ version: prevVersion, op });
+      room.content = newContent;
+      room.version = newVersion;
+
+      send(ws, { type: 'ack', version: newVersion });
+
+      for (const [client] of room.clients) {
+        if (client !== ws) {
+          send(client, { type: 'operation', operation: op, version: newVersion });
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      const connId = room.clients.get(ws);
+      if (connId) {
+        try {
+          db.prepare('DELETE FROM active_connections WHERE id = ?').run(connId);
+        } catch {
+          // DB may be closed during shutdown
+        }
+        room.clients.delete(ws);
+      }
+      if (room.clients.size === 0) {
+        rooms.delete(docId);
+      }
+    });
+
+    ws.on('error', (_err) => {
+      // Errors handled via close event
+    });
+  });
+
+  return wss;
+}
