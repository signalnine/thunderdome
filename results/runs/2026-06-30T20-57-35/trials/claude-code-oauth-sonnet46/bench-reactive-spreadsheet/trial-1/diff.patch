new file mode 100644
index 0000000..67b1b9d
--- /dev/null
+++ b/src/cellRef.ts
@@ -0,0 +1,51 @@
+// Parses and resolves cell references and ranges
+
+export function colLettersToIndex(col: string): number {
+  col = col.toUpperCase();
+  let result = 0;
+  for (let i = 0; i < col.length; i++) {
+    result = result * 26 + (col.charCodeAt(i) - 64);
+  }
+  return result; // 1-based
+}
+
+export function indexToColLetters(n: number): string {
+  let result = '';
+  while (n > 0) {
+    const rem = (n - 1) % 26;
+    result = String.fromCharCode(65 + rem) + result;
+    n = Math.floor((n - 1) / 26);
+  }
+  return result;
+}
+
+const CELL_RE = /^([A-Za-z]+)([1-9][0-9]*)$/;
+
+export function parseCellRef(ref: string): { col: number; row: number } | null {
+  const m = CELL_RE.exec(ref);
+  if (!m) return null;
+  return { col: colLettersToIndex(m[1]), row: parseInt(m[2], 10) };
+}
+
+export function normalizeCellRef(ref: string): string {
+  return ref.toUpperCase();
+}
+
+export function expandRange(start: string, end: string): string[] {
+  const s = parseCellRef(start);
+  const e = parseCellRef(end);
+  if (!s || !e) throw new Error(`Invalid range: ${start}:${end}`);
+
+  const minCol = Math.min(s.col, e.col);
+  const maxCol = Math.max(s.col, e.col);
+  const minRow = Math.min(s.row, e.row);
+  const maxRow = Math.max(s.row, e.row);
+
+  const cells: string[] = [];
+  for (let row = minRow; row <= maxRow; row++) {
+    for (let col = minCol; col <= maxCol; col++) {
+      cells.push(indexToColLetters(col) + row);
+    }
+  }
+  return cells;
+}
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..d61749a
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,173 @@
+import { normalizeCellRef, parseCellRef } from './cellRef.js';
+import { evaluateFormula } from './parser.js';
+
+interface Cell {
+  raw: string | number | boolean;    // what was set
+  computed: string | number | boolean | null;
+  formula: string | null;            // if raw starts with '=', the formula body
+  deps: Set<string>;                 // cells this cell depends on
+  dependents: Set<string>;           // cells that depend on this cell
+}
+
+export class Spreadsheet {
+  private cells = new Map<string, Cell>();
+
+  private getCell(ref: string): Cell | undefined {
+    return this.cells.get(normalizeCellRef(ref));
+  }
+
+  private ensureCell(ref: string): Cell {
+    const key = normalizeCellRef(ref);
+    if (!this.cells.has(key)) {
+      this.cells.set(key, {
+        raw: '',
+        computed: null,
+        formula: null,
+        deps: new Set(),
+        dependents: new Set(),
+      });
+    }
+    return this.cells.get(key)!;
+  }
+
+  set(cell: string, value: string | number | boolean): void {
+    const ref = normalizeCellRef(cell);
+    if (!parseCellRef(ref)) throw new Error(`Invalid cell reference: ${cell}`);
+
+    const isFormula = typeof value === 'string' && value.startsWith('=');
+
+    // Compute new dependencies before committing, to detect cycles
+    let newDeps = new Set<string>();
+    let computed: string | number | boolean | null = null;
+
+    if (isFormula) {
+      const formulaBody = (value as string).slice(1);
+      const result = evaluateFormula(formulaBody, (r) => this.get(r));
+      newDeps = result.deps;
+      computed = result.value;
+    } else {
+      computed = typeof value === 'boolean' ? value : value;
+    }
+
+    // Detect cycles: would adding edges from ref -> newDeps create a cycle?
+    this.checkNoCycle(ref, newDeps);
+
+    // Remove old dependency edges
+    const existing = this.cells.get(ref);
+    if (existing) {
+      for (const dep of existing.deps) {
+        const depCell = this.cells.get(dep);
+        if (depCell) depCell.dependents.delete(ref);
+      }
+    }
+
+    // Write the cell
+    const c = this.ensureCell(ref);
+    c.raw = value;
+    c.formula = isFormula ? (value as string).slice(1) : null;
+    c.deps = newDeps;
+    c.computed = isFormula ? computed : (value === '' ? null : value as string | number | boolean);
+
+    // Add new dependency edges
+    for (const dep of newDeps) {
+      const depCell = this.ensureCell(dep);
+      depCell.dependents.add(ref);
+    }
+
+    // Reactively recompute all downstream dependents
+    this.recompute(ref);
+  }
+
+  get(cell: string): string | number | boolean | null {
+    const ref = normalizeCellRef(cell);
+    return this.cells.get(ref)?.computed ?? null;
+  }
+
+  getDisplay(cell: string): string {
+    const val = this.get(cell);
+    if (val === null) return '';
+    if (typeof val === 'boolean') return val ? 'TRUE' : 'FALSE';
+    return String(val);
+  }
+
+  getCells(): Map<string, string | number | boolean> {
+    const result = new Map<string, string | number | boolean>();
+    for (const [ref, cell] of this.cells) {
+      if (cell.computed !== null) {
+        result.set(ref, cell.computed);
+      }
+    }
+    return result;
+  }
+
+  private recompute(changedRef: string): void {
+    // Topological order via BFS over dependents
+    const order = this.topologicalDependents(changedRef);
+    for (const ref of order) {
+      const cell = this.cells.get(ref);
+      if (!cell || !cell.formula) continue;
+      const result = evaluateFormula(cell.formula, (r) => this.get(r));
+      cell.computed = result.value;
+
+      // Update deps in case they changed (they shouldn't for static formulas, but be safe)
+      for (const dep of cell.deps) {
+        const depCell = this.cells.get(dep);
+        if (depCell) depCell.dependents.delete(ref);
+      }
+      cell.deps = result.deps;
+      for (const dep of result.deps) {
+        const depCell = this.ensureCell(dep);
+        depCell.dependents.add(ref);
+      }
+    }
+  }
+
+  private topologicalDependents(startRef: string): string[] {
+    // BFS to collect all cells that depend on startRef, in dependency order
+    const visited = new Set<string>();
+    const queue: string[] = [];
+    const startCell = this.cells.get(startRef);
+    if (!startCell) return [];
+
+    for (const dep of startCell.dependents) {
+      queue.push(dep);
+    }
+
+    const result: string[] = [];
+    let i = 0;
+    while (i < queue.length) {
+      const ref = queue[i++];
+      if (visited.has(ref)) continue;
+      visited.add(ref);
+      result.push(ref);
+      const cell = this.cells.get(ref);
+      if (cell) {
+        for (const dep of cell.dependents) {
+          if (!visited.has(dep)) queue.push(dep);
+        }
+      }
+    }
+    return result;
+  }
+
+  private checkNoCycle(ref: string, newDeps: Set<string>): void {
+    // DFS: starting from each cell in newDeps, can we reach ref?
+    const visited = new Set<string>();
+    const stack = [...newDeps];
+
+    while (stack.length > 0) {
+      const current = stack.pop()!;
+      if (current === ref) {
+        throw new Error(`Circular reference detected involving ${ref}`);
+      }
+      if (visited.has(current)) continue;
+      visited.add(current);
+      const cell = this.cells.get(current);
+      if (cell) {
+        for (const dep of cell.deps) {
+          stack.push(dep);
+        }
+      }
+    }
+  }
+}
diff --git a/src/parser.ts b/src/parser.ts
new file mode 100644
index 0000000..782b23d
--- /dev/null
+++ b/src/parser.ts
@@ -0,0 +1,291 @@
+// Recursive descent parser/evaluator for spreadsheet formulas
+
+import { expandRange, normalizeCellRef, parseCellRef } from './cellRef.js';
+
+export type CellGetter = (ref: string) => string | number | boolean | null;
+
+// Tokenizer
+
+type TokenType =
+  | 'NUMBER' | 'STRING' | 'BOOL' | 'IDENT' | 'RANGE'
+  | 'PLUS' | 'MINUS' | 'STAR' | 'SLASH'
+  | 'EQ' | 'NEQ' | 'LT' | 'LTE' | 'GT' | 'GTE'
+  | 'LPAREN' | 'RPAREN' | 'COMMA' | 'COLON'
+  | 'EOF';
+
+interface Token {
+  type: TokenType;
+  value: string;
+}
+
+function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+
+  while (i < input.length) {
+    const ch = input[i];
+
+    if (/\s/.test(ch)) { i++; continue; }
+
+    if (ch === '"') {
+      let str = '';
+      i++;
+      while (i < input.length && input[i] !== '"') {
+        str += input[i++];
+      }
+      i++; // closing "
+      tokens.push({ type: 'STRING', value: str });
+      continue;
+    }
+
+    if (/[0-9]/.test(ch) || (ch === '.' && /[0-9]/.test(input[i + 1] ?? ''))) {
+      let num = '';
+      while (i < input.length && /[0-9.]/.test(input[i])) num += input[i++];
+      tokens.push({ type: 'NUMBER', value: num });
+      continue;
+    }
+
+    if (/[A-Za-z]/.test(ch)) {
+      let ident = '';
+      while (i < input.length && /[A-Za-z0-9]/.test(input[i])) ident += input[i++];
+      const upper = ident.toUpperCase();
+      if (upper === 'TRUE') tokens.push({ type: 'BOOL', value: 'true' });
+      else if (upper === 'FALSE') tokens.push({ type: 'BOOL', value: 'false' });
+      else tokens.push({ type: 'IDENT', value: upper });
+      continue;
+    }
+
+    switch (ch) {
+      case '+': tokens.push({ type: 'PLUS', value: '+' }); break;
+      case '-': tokens.push({ type: 'MINUS', value: '-' }); break;
+      case '*': tokens.push({ type: 'STAR', value: '*' }); break;
+      case '/': tokens.push({ type: 'SLASH', value: '/' }); break;
+      case '(': tokens.push({ type: 'LPAREN', value: '(' }); break;
+      case ')': tokens.push({ type: 'RPAREN', value: ')' }); break;
+      case ',': tokens.push({ type: 'COMMA', value: ',' }); break;
+      case ':': tokens.push({ type: 'COLON', value: ':' }); break;
+      case '<':
+        if (input[i + 1] === '=') { tokens.push({ type: 'LTE', value: '<=' }); i++; }
+        else if (input[i + 1] === '>') { tokens.push({ type: 'NEQ', value: '<>' }); i++; }
+        else tokens.push({ type: 'LT', value: '<' });
+        break;
+      case '>':
+        if (input[i + 1] === '=') { tokens.push({ type: 'GTE', value: '>=' }); i++; }
+        else tokens.push({ type: 'GT', value: '>' });
+        break;
+      case '=':
+        tokens.push({ type: 'EQ', value: '=' });
+        break;
+      default:
+        throw new Error(`Unexpected character: ${ch}`);
+    }
+    i++;
+  }
+
+  tokens.push({ type: 'EOF', value: '' });
+  return tokens;
+}
+
+// Parser
+
+class Parser {
+  private tokens: Token[];
+  private pos = 0;
+  private deps: Set<string>;
+  private getCellValue: CellGetter;
+
+  constructor(tokens: Token[], getCellValue: CellGetter, deps: Set<string>) {
+    this.tokens = tokens;
+    this.getCellValue = getCellValue;
+    this.deps = deps;
+  }
+
+  private peek(): Token { return this.tokens[this.pos]; }
+  private consume(): Token { return this.tokens[this.pos++]; }
+
+  private expect(type: TokenType): Token {
+    const tok = this.consume();
+    if (tok.type !== type) throw new Error(`Expected ${type}, got ${tok.type}`);
+    return tok;
+  }
+
+  parse(): string | number | boolean {
+    const result = this.parseComparison();
+    if (this.peek().type !== 'EOF') throw new Error('Unexpected tokens after expression');
+    return result;
+  }
+
+  private parseComparison(): string | number | boolean {
+    let left = this.parseAddSub();
+
+    const cmpTypes: TokenType[] = ['EQ', 'NEQ', 'LT', 'LTE', 'GT', 'GTE'];
+    while (cmpTypes.includes(this.peek().type)) {
+      const op = this.consume().value;
+      const right = this.parseAddSub();
+      switch (op) {
+        case '=':  left = left === right; break;
+        case '<>': left = left !== right; break;
+        case '<':  left = (left as number) < (right as number); break;
+        case '<=': left = (left as number) <= (right as number); break;
+        case '>':  left = (left as number) > (right as number); break;
+        case '>=': left = (left as number) >= (right as number); break;
+      }
+    }
+    return left;
+  }
+
+  private parseAddSub(): string | number | boolean {
+    let left = this.parseMulDiv();
+    while (this.peek().type === 'PLUS' || this.peek().type === 'MINUS') {
+      const op = this.consume().value;
+      const right = this.parseMulDiv();
+      if (op === '+') {
+        if (typeof left === 'string' || typeof right === 'string') {
+          left = String(left) + String(right);
+        } else {
+          left = (left as number) + (right as number);
+        }
+      } else {
+        left = (left as number) - (right as number);
+      }
+    }
+    return left;
+  }
+
+  private parseMulDiv(): string | number | boolean {
+    let left = this.parseUnary();
+    while (this.peek().type === 'STAR' || this.peek().type === 'SLASH') {
+      const op = this.consume().value;
+      const right = this.parseUnary();
+      left = op === '*'
+        ? (left as number) * (right as number)
+        : (left as number) / (right as number);
+    }
+    return left;
+  }
+
+  private parseUnary(): string | number | boolean {
+    if (this.peek().type === 'MINUS') {
+      this.consume();
+      return -(this.parsePrimary() as number);
+    }
+    if (this.peek().type === 'PLUS') {
+      this.consume();
+      return this.parsePrimary() as number;
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): string | number | boolean {
+    const tok = this.peek();
+
+    if (tok.type === 'NUMBER') {
+      this.consume();
+      return parseFloat(tok.value);
+    }
+
+    if (tok.type === 'STRING') {
+      this.consume();
+      return tok.value;
+    }
+
+    if (tok.type === 'BOOL') {
+      this.consume();
+      return tok.value === 'true';
+    }
+
+    if (tok.type === 'LPAREN') {
+      this.consume();
+      const val = this.parseComparison();
+      this.expect('RPAREN');
+      return val;
+    }
+
+    if (tok.type === 'IDENT') {
+      this.consume();
+      const name = tok.value;
+
+      // Check if it's a function call
+      if (this.peek().type === 'LPAREN') {
+        return this.parseFunction(name);
+      }
+
+      // Check if it's a cell reference (e.g., A1, AA10)
+      if (parseCellRef(name)) {
+        // Could be start of a range: A1:B2
+        if (this.peek().type === 'COLON') {
+          this.consume();
+          const endTok = this.expect('IDENT');
+          const cells = expandRange(name, endTok.value);
+          // A range used directly returns the first cell value (unusual but handle gracefully)
+          cells.forEach(c => this.deps.add(normalizeCellRef(c)));
+          return this.getCellValue(normalizeCellRef(cells[0])) ?? 0;
+        }
+        const ref = normalizeCellRef(name);
+        this.deps.add(ref);
+        const val = this.getCellValue(ref);
+        return val ?? 0;
+      }
+
+      throw new Error(`Unknown identifier: ${name}`);
+    }
+
+    throw new Error(`Unexpected token: ${tok.type} (${tok.value})`);
+  }
+
+  private parseFunction(name: string): string | number | boolean {
+    this.expect('LPAREN');
+
+    if (name === 'IF') {
+      const condition = this.parseComparison();
+      this.expect('COMMA');
+      const trueVal = this.parseComparison();
+      this.expect('COMMA');
+      const falseVal = this.parseComparison();
+      this.expect('RPAREN');
+      return condition ? trueVal : falseVal;
+    }
+
+    // Range functions: SUM, AVERAGE, MIN, MAX, COUNT
+    const rangeValues = this.parseRangeArg();
+    this.expect('RPAREN');
+    const nums = rangeValues.filter((v): v is number => typeof v === 'number');
+
+    switch (name) {
+      case 'SUM':     return nums.reduce((a, b) => a + b, 0);
+      case 'AVERAGE': return nums.length > 0 ? nums.reduce((a, b) => a + b, 0) / nums.length : 0;
+      case 'MIN':     return nums.length > 0 ? Math.min(...nums) : 0;
+      case 'MAX':     return nums.length > 0 ? Math.max(...nums) : 0;
+      case 'COUNT':   return nums.length;
+      default: throw new Error(`Unknown function: ${name}`);
+    }
+  }
+
+  private parseRangeArg(): (string | number | boolean)[] {
+    const startTok = this.expect('IDENT');
+    if (this.peek().type === 'COLON') {
+      this.consume();
+      const endTok = this.expect('IDENT');
+      const cells = expandRange(startTok.value, endTok.value);
+      cells.forEach(c => this.deps.add(normalizeCellRef(c)));
+      return cells.map(c => this.getCellValue(normalizeCellRef(c)) ?? 0);
+    }
+    // Single cell as range argument
+    const ref = normalizeCellRef(startTok.value);
+    this.deps.add(ref);
+    return [this.getCellValue(ref) ?? 0];
+  }
+}
+
+export interface ParseResult {
+  value: string | number | boolean;
+  deps: Set<string>;
+}
+
+export function evaluateFormula(formula: string, getCellValue: CellGetter): ParseResult {
+  const deps = new Set<string>();
+  const tokens = tokenize(formula);
+  const parser = new Parser(tokens, getCellValue, deps);
+  const value = parser.parse();
+  return { value, deps };
+}
