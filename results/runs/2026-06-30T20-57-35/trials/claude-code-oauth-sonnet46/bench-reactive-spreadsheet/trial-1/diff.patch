r to string', () => {\n      sheet.set('A1', 7);\n      expect(sheet.getDisplay('A1')).toBe('7');\n    });\n\n    it('returns string values as-is', () => {\n      sheet.set('A1', 'hello');\n      expect(sheet.getDisplay('A1')).toBe('hello');\n    });\n\n    it('displays booleans as TRUE/FALSE', () => {\n      sheet.set('A1', true);\n      expect(sheet.getDisplay('A1')).toBe('TRUE');\n      sheet.set('A2', false);\n      expect(sheet.getDisplay('A2')).toBe('FALSE');\n    });\n  });\n\n  // ── getCells ─────────────────────────────────────────────────────────────────\n\n  describe('getCells', () => {\n    it('returns empty map when no cells set', () => {\n      expect(sheet.getCells().size).toBe(0);\n    });\n\n    it('returns all non-empty cells', () => {\n      sheet.set('A1', 1);\n      sheet.set('B2', 'x');\n      const cells = sheet.getCells();\n      expect(cells.get('A1')).toBe(1);\n      expect(cells.get('B2')).toBe('x');\n    });\n  });\n\n  // ── Simple formulas ──────────────────────────────────────────────────────────\n\n  describe('simple formulas', () => {\n    it('evaluates a numeric literal formula', () => {\n      sheet.set('A1', '=42');\n      expect(sheet.get('A1')).toBe(42);\n    });\n\n    it('evaluates arithmetic', () => {\n      sheet.set('A1', '=2+3*4');\n      expect(sheet.get('A1')).toBe(14);\n    });\n\n    it('evaluates parenthesized arithmetic', () => {\n      sheet.set('A1', '=(2+3)*4');\n      expect(sheet.get('A1')).toBe(20);\n    });\n\n    it('evaluates unary minus', () => {\n      sheet.set('A1', '=-5');\n      expect(sheet.get('A1')).toBe(-5);\n    });\n\n    it('evaluates division', () => {\n      sheet.set('A1', '=10/4');\n      expect(sheet.get('A1')).toBe(2.5);\n    });\n\n    it('evaluates cell reference formula', () => {\n      sheet.set('A1', 10);\n      sheet.set('B1', '=A1');\n      expect(sheet.get('B1')).toBe(10);\n    });\n\n    it('evaluates cell addition formula', () => {\n      sheet.set('A1', 10);\n      sheet.set('A