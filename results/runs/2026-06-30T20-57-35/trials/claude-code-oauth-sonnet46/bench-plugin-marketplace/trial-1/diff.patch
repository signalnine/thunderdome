+import vm from 'vm';
+import type { SandboxResult, RunnerService } from '../types.js';
+
+export function createRunner(): RunnerService {
+  function runCode(code: string, context: Record<string, unknown> = {}, timeoutMs?: number): SandboxResult {
+    const start = process.hrtime.bigint();
+    const memBefore = process.memoryUsage().heapUsed;
+
+    try {
+      const sandbox = vm.createContext({ ...context });
+      const wrapped = `(function() { ${code} })()`;
+      const opts: vm.RunningScriptOptions = timeoutMs !== undefined ? { timeout: timeoutMs } : {};
+      const output = vm.runInContext(wrapped, sandbox, opts);
+      const duration = Number(process.hrtime.bigint() - start) / 1_000_000;
+      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - memBefore);
+      return { success: true, output, duration, memoryUsed };
+    } catch (error) {
+      const duration = Number(process.hrtime.bigint() - start) / 1_000_000;
+      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - memBefore);
+      return {
+        success: false,
+        output: null,
+        duration,
+        memoryUsed,
+        error: error instanceof Error ? error.message : String(error),
+      };
+    }
+  }
+
+  return {
+    async execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult> {
+      return runCode(code, context);
+    },
+
+    async executeWithTimeout(code: string, timeoutMs: number, context?: Record<string, unknown>): Promise<SandboxResult> {
+      return runCode(code, context, timeoutMs);
+    },
+  };
+}
