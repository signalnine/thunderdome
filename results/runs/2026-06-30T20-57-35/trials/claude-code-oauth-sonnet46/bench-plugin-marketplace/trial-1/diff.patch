+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+export function createDepsService(): DepsService {
+  const service: DepsService = {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      function buildNode(n: string, ancestors: Set<string>): DependencyNode {
+        const manifest = registry.get(n);
+        const node: DependencyNode = {
+          name: n,
+          version: manifest?.version ?? '0.0.0',
+          dependencies: [],
+        };
+        if (!manifest || ancestors.has(n)) return node;
+        const next = new Set(ancestors).add(n);
+        for (const depName of Object.keys(manifest.dependencies)) {
+          node.dependencies.push(buildNode(depName, next));
+        }
+        return node;
+      }
+      return buildNode(name, new Set());
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const cycles: string[][] = [];
+      const globalVisited = new Set<string>();
+
+      function dfs(current: string, path: string[], onPath: Set<string>): void {
+        if (onPath.has(current)) {
+          const start = path.indexOf(current);
+          cycles.push([...path.slice(start), current]);
+          return;
+        }
+        if (globalVisited.has(current)) return;
+
+        globalVisited.add(current);
+        onPath.add(current);
+        path.push(current);
+
+        const manifest = registry.get(current);
+        if (manifest) {
+          for (const depName of Object.keys(manifest.dependencies)) {
+            dfs(depName, path, onPath);
+          }
+        }
+
+        path.pop();
+        onPath.delete(current);
+      }
+
+      dfs(name, [], new Set());
+      return cycles.length > 0 ? cycles : null;
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const visited = new Set<string>();
+      const result: string[] = [];
+
+      function visit(n: string): void {
+        if (visited.has(n)) return;
+        visited.add(n);
+        const manifest = registry.get(n);
+        if (manifest) {
+          for (const depName of Object.keys(manifest.dependencies)) {
+            visit(depName);
+          }
+        }
+        result.push(n);
+      }
+
+      visit(name);
+      return result;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const visited = new Set<string>();
+      const result: string[] = [];
+
+      function collect(n: string, isRoot: boolean): void {
+        if (visited.has(n)) return;
+        visited.add(n);
+        const manifest = registry.get(n);
+        if (manifest) {
+          for (const depName of Object.keys(manifest.dependencies)) {
+            collect(depName, false);
+          }
+        }
+        if (!isRoot) result.push(n);
+      }
+
+      collect(name, true);
+      return result;
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return service.detectCycles(name, registry) !== null;
+    },
+  };
+
+  return service;
+}
