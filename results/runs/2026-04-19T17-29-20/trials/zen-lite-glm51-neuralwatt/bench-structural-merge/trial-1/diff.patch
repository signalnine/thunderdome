+/* eslint-disable @typescript-eslint/no-explicit-any */
+import type { Conflict } from './types.js';
+
+/**
+ * Recursively collect all keys from one or more objects.
+ */
+function allKeys(...objs: Record<string, any>[]): string[] {
+  const keySet = new Set<string>();
+  for (const obj of objs) {
+    if (obj && typeof obj === 'object') {
+      for (const key of Object.keys(obj)) {
+        keySet.add(key);
+      }
+    }
+  }
+  return [...keySet];
+}
+
+/**
+ * Three-way merge of two objects against a common base.
+ * Returns { merged, conflicts } where merged is the result (with "ours" winning conflicts)
+ * and conflicts is the list of detected conflicts.
+ */
+export function threeWayMerge(
+  base: any,
+  ours: any,
+  theirs: any,
+  path: string,
+  documentId: string,
+): { merged: any; conflicts: Conflict[] } {
+  const conflicts: Conflict[] = [];
+
+  // If both sides are the same, no conflict regardless of base
+  if (deepEqual(ours, theirs)) {
+    return { merged: deepClone(ours), conflicts: [] };
+  }
+
+  // If ours didn't change from base, take theirs
+  if (deepEqual(base, ours)) {
+    return { merged: deepClone(theirs), conflicts: [] };
+  }
+
+  // If theirs didn't change from base, take ours
+  if (deepEqual(base, theirs)) {
+    return { merged: deepClone(ours), conflicts: [] };
+  }
+
+  // Both sides changed to different values
+  // If both are objects, try recursive merge
+  if (
+    isPlainObject(base) && isPlainObject(ours) && isPlainObject(theirs)
+  ) {
+    const keys = allKeys(base as Record<string, any>, ours as Record<string, any>, theirs as Record<string, any>);
+    const merged: Record<string, any> = {};
+    for (const key of keys) {
+      const childPath = path ? `${path}.${key}` : key;
+      const baseVal = (base as Record<string, any>)[key];
+      const oursVal = (ours as Record<string, any>)[key];
+      const theirsVal = (theirs as Record<string, any>)[key];
+      const result = threeWayMerge(baseVal, oursVal, theirsVal, childPath, documentId);
+      merged[key] = result.merged;
+      conflicts.push(...result.conflicts);
+    }
+    return { merged, conflicts };
+  }
+
+  // Primitive conflict or type mismatch conflict
+  conflicts.push({
+    documentId,
+    path,
+    base: deepClone(base),
+    ours: deepClone(ours),
+    theirs: deepClone(theirs),
+  });
+
+  // "Ours" wins for the merged output
+  return { merged: deepClone(ours), conflicts };
+}
+
+function isPlainObject(val: any): val is Record<string, any> {
+  return val !== null && typeof val === 'object' && !Array.isArray(val);
+}
+
+function deepClone<T>(val: T): T {
+  if (val === undefined) return val;
+  return JSON.parse(JSON.stringify(val));
+}
+
+function deepEqual(a: any, b: any): boolean {
+  if (a === b) return true;
+  if (a === null || b === null) return false;
+  if (typeof a !== typeof b) return false;
+  if (typeof a !== 'object') return false;
+  if (Array.isArray(a) !== Array.isArray(b)) return false;
+  if (Array.isArray(a)) {
+    if (a.length !== b.length) return false;
+    return a.every((v, i) => deepEqual(v, b[i]));
+  }
+  const keysA = Object.keys(a);
+  const keysB = Object.keys(b);
+  if (keysA.length !== keysB.length) return false;
+  return keysA.every(k => deepEqual(a[k], b[k]));
+}
