+{"type":"assistant","message":{"id":"chatcmpl-a5aac8707619fb1a","content":[{"type":"tool_use","id":"chatcmpl-tool-b7352fe3c0982569","name":"Write","input":{"file_path":"/workspace/tests/document-store.test.ts","content":"import { describe, it, expect } from 'vitest';\nimport { DocumentStore } from '../src/index.js';\n\ndescribe('DocumentStore - CRUD', () => {\n  it('creates and gets a document', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { title: 'Hello' });\n    expect(store.get('doc1')).toEqual({ title: 'Hello' });\n  });\n\n  it('throws when creating a document with duplicate id', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { title: 'Hello' });\n    expect(() => store.create('doc1', { title: 'World' })).toThrow();\n  });\n\n  it('throws when getting a non-existent document', () => {\n    const store = new DocumentStore();\n    expect(() => store.get('missing')).toThrow();\n  });\n\n  it('updates a document', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { title: 'Hello' });\n    store.update('doc1', { title: 'World' });\n    expect(store.get('doc1')).toEqual({ title: 'World' });\n  });\n\n  it('throws when updating a non-existent document', () => {\n    const store = new DocumentStore();\n    expect(() => store.update('missing', { title: 'X' })).toThrow();\n  });\n\n  it('deletes a document', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { title: 'Hello' });\n    store.delete('doc1');\n    expect(() => store.get('doc1')).toThrow();\n  });\n\n  it('throws when deleting a non-existent document', () => {\n    const store = new DocumentStore();\n    expect(() => store.delete('missing')).toThrow();\n  });\n\n  it('deep clones on create and get to prevent mutation', () => {\n    const store = new DocumentStore();\n    const original = { nested: { value: 1 } };\n    store.create('doc1', original);\n    original.nested.value = 999;\n    expect(store.get('doc1')).toEqual({ nested: { value: 1 } });\n\n    const retrieved = store.get('doc1');\n    (retrieved as any).nested.value = 888;\n    expect(store.get('doc1')).toEqual({ nested: { value: 1 } });\n  });\n\n  it('deep clones on update to prevent mutation', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { a: 1 });\n    const updated = { a: 2 };\n    store.update('doc1', updated);\n    (updated as any).a = 999;\n    expect(store.get('doc1')).toEqual({ a: 2 });\n  });\n});\n\ndescribe('DocumentStore - Version History', () => {\n  it('records versions on create and update', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { v: 1 });\n    store.update('doc1', { v: 2 });\n    store.update('doc1', { v: 3 });\n\n    const history = store.getHistory('doc1');\n    expect(history).toHaveLength(3);\n    expect(history[0].content).toEqual({ v: 1 });\n    expect(history[1].content).toEqual({ v: 2 });\n    expect(history[2].content).toEqual({ v: 3 });\n  });\n\n  it('returns versions in chronological order (oldest first)', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { v: 1 });\n    store.update('doc1', { v: 2 });\n\n    const history = store.getHistory('doc1');\n    expect(history[0].timestamp).toBeLessThanOrEqual(history[1].timestamp);\n  });\n\n  it('each version has a unique id', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { v: 1 });\n    store.update('doc1', { v: 2 });\n\n    const history = store.getHistory('doc1');\n    expect(history[0].id).not.toBe(history[1].id);\n  });\n\n  it('getVersion returns content at a specific version', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { v: 1 });\n    store.update('doc1', { v: 2 });\n\n    const history = store.getHistory('doc1');\n    expect(store.getVersion('doc1', history[0].id)).toEqual({ v: 1 });\n    expect(store.getVersion('doc1', history[1].id)).toEqual({ v: 2 });\n  });\n\n  it('throws f