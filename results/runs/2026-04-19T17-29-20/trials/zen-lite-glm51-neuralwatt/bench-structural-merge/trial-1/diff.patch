ds a key and theirs doesn't have it: take the addition\nWhen both add the same key: compare values\n\nLet me refine my three-way merge function:\n\n```typescript\nfunction threeWayMergeField(\n  baseVal: any,\n  ourVal: any,\n  theirVal: any,\n  path: string,\n  documentId: string,\n  conflicts: Conflict[],\n  keyDeletedByUs: boolean,\n  keyDeletedByThem: boolean\n): { value: any; deleted: boolean } {\n  // Both deleted\n  if (keyDeletedByUs && keyDeletedByThem) {\n    return { value: undefined, deleted: true };\n  }\n  \n  // Only ours deleted\n  if (keyDeletedByUs) {\n    // Check if theirs changed from base\n    if (theirVal === baseVal || JSON.stringify(theirVal) === JSON.stringify(baseVal)) {\n      // Theirs unchanged, take deletion\n      return { value: undefined, deleted: true };\n    } else {\n      // Theirs changed, ours deleted: conflict\n      conflicts.push({ documentId, path, base: baseVal, ours: undefined, theirs: theirVal });\n      return { value: undefined, deleted: true }; // favor ours (delete)\n    }\n  }\n  \n  // Only theirs deleted\n  if (keyDeletedByThem) {\n    if (ourVal === baseVal || JSON.stringify(ourVal) === JSON.stringify(baseVal)) {\n      // Ours unchanged, take deletion\n      return { value: undefined, deleted: true };\n    } else {\n      // Ours changed, theirs deleted: conflict\n      conflicts.push({ documentId, path, base: baseVal, ours: ourVal, theirs: undefined });\n      return { value: ourVal, deleted: false }; // favor ours (keep)\n    }\n  }\n  \n  // Both have the value\n  // Same value on both sides\n  if (JSON.stringify(ourVal) === JSON.stringify(theirVal)) {\n    return { value: ourVal, deleted: false };\n  }\n  \n  // Check what changed from base\n  const oursChanged = JSON.stringify(ourVal) !== JSON.stringify(baseVal);\n  const theirsChanged = JSON.stringify(theirVal) !== JSON.stringify(baseVal);\n  \n  if (!oursChanged && theirsChanged) return { value: theirVal, deleted: false };\n  if (oursChanged && !theirsCh