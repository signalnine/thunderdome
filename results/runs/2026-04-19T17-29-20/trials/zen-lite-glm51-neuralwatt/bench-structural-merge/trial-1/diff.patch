!== undefined) {\n      // Was in base, theirs deleted it\n      if (deepEqual(baseVal, ourVal)) {\n        return undefined; // ours unchanged, take deletion\n      } else {\n        // Ours changed, theirs deleted: conflict\n        conflicts.push({ documentId, path, base: baseVal, ours: ourVal, theirs: undefined });\n        return ourVal; // favor ours\n      }\n    } else {\n      // Not in base, only ours added it\n      return ourVal;\n    }\n  }\n  \n  // Only theirs present\n  if (ourVal === undefined && theirVal !== undefined) {\n    if (baseVal !== undefined) {\n      // Was in base, ours deleted it\n      if (deepEqual(baseVal, theirVal)) {\n        return undefined; // theirs unchanged, take deletion\n      } else {\n        // Theirs changed, ours deleted: conflict\n        conflicts.push({ documentId, path, base: baseVal, ours: undefined, theirs: theirVal });\n        return undefined; // favor ours (delete)\n      }\n    } else {\n      // Not in base, only theirs added it\n      return theirVal;\n    }\n  }\n  \n  // Both present\n  if (deepEqual(ourVal, theirVal)) {\n    return ourVal; // same value, no conflict\n  }\n  \n  const oursChanged = !deepEqual(baseVal, ourVal);\n  const theirsChanged = !deepEqual(baseVal, theirVal);\n  \n  // Only ours changed\n  if (oursChanged && !theirsChanged) return ourVal;\n  // Only theirs changed\n  if (!oursChanged && theirsChanged) return theirVal;\n  \n  // Both changed to different values\n  // If all are plain objects, recurse\n  if (isPlainObject(baseVal) && isPlainObject(ourVal) && isPlainObject(theirVal)) {\n    const result: Record<string, unknown> = {};\n    const allKeys = new Set([\n      ...Object.keys(baseVal as object),\n      ...Object.keys(ourVal as object),\n      ...Object.keys(theirVal as object),\n    ]);\n    for (const key of allKeys) {\n      const childPath = path ? `${path}.${key}` : key;\n      const childBase = (baseVal as Record<string, unknown>)[key];\n      const childOurs = (ourVal