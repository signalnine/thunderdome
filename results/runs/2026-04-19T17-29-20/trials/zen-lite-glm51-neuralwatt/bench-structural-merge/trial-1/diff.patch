   const branch = this.currentBranch();\n    if (!branch.documents.has(id)) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.currentBranchName}\"`);\n    }\n    return deepClone(branch.documents.get(id)!);\n  }\n\n  update(id: string, content: object): void {\n    const branch = this.currentBranch();\n    if (!branch.documents.has(id)) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.currentBranchName}\"`);\n    }\n    const cloned = deepClone(content);\n    branch.documents.set(id, cloned);\n    const version: Version = {\n      id: generateVersionId(),\n      timestamp: Date.now(),\n      content: deepClone(content),\n    };\n    const history = branch.history.get(id) ?? [];\n    history.push(version);\n    branch.history.set(id, history);\n  }\n\n  delete(id: string): void {\n    const branch = this.currentBranch();\n    if (!branch.documents.has(id)) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.currentBranchName}\"`);\n    }\n    branch.documents.delete(id);\n  }\n\n  // --- Version History ---\n\n  getHistory(id: string): Version[] {\n    const branch = this.currentBranch();\n    const history = branch.history.get(id);\n    if (!history) {\n      throw new Error(`No history for document \"${id}\" on branch \"${this.currentBranchName}\"`);\n    }\n    return deepClone(history);\n  }\n\n  getVersion(id: string, versionId: string): object {\n    const branch = this.currentBranch();\n    const history = branch.history.get(id);\n    if (!history) {\n      throw new Error(`No history for document \"${id}\" on branch \"${this.currentBranchName}\"`);\n    }\n    const version = history.find(v => v.id === versionId);\n    if (!version) {\n      throw new Error(`Version \"${versionId}\" not found for document \"${id}\"`);\n    }\n    return deepClone(version.content);\n  }\n\n  // --- Branching ---\n\n  createBranch(name: string, fromBranch?: string): void {\n    if (this.branches.has(name)) {\n      throw new Error(`Branch \"${name}\" already exists`);\n    }\n    const sourceName = fromBranch ?? this.currentBranchName;\n    const source = this.branches.get(sourceName);\n    if (!source) {\n      throw new Error(`Source branch \"${sourceName}\" does not exist`);\n    }\n\n    // Snapshot the source branch's documents at this point\n    const forkSnapshot = new Map<string, object>();\n    for (const [docId, content] of source.documents) {\n      forkSnapshot.set(docId, deepClone(content));\n    }\n\n    // Clone documents and history\n    const documents = new Map<string, object>();\n    const history = new Map<string, Version[]>();\n    for (const [docId, content] of source.documents) {\n      documents.set(docId, deepClone(content));\n    }\n    for (const [docId, versions] of source.history) {\n      history.set(docId, deepClone(versions));\n    }\n\n    this.branches.set(name, {\n      documents,\n      history,\n      forkSnapshot,\n      parentBranch: sourceName,\n      order: branchOrderCounter++,\n    });\n  }\n\n  switchBranch(name: string): void {\n    if (!this.branches.has(name)) {\n      throw new Error(`Branch \"${name}\" does not exist`);\n    }\n    this.currentBranchName = name;\n  }\n\n  getBranch(): string {\n    return this.currentBranchName;\n  }\n\n  listBranches(): string[] {\n    return [...this.branches.keys()];\n  }\n\n  // --- Merging ---\n\n  merge(sourceBranch: string): MergeResult {\n    if (!this.branches.has(sourceBranch)) {\n      throw new Error(`Source branch \"${sourceBranch}\" does not exist`);\n    }\n    if (sourceBranch === this.currentBranchName) {\n      throw new Error('Cannot merge a branch into itself');\n    }\n\n    const current = this.currentBranch();\n    const source = this.branches.get(sourceBranch)!;\n\n    // Find the merge base (common ancestor state)\n    const base = this.findMergeBase(this.currentBranchName, sourceBranch);\n\n    // Collect all document IDs from base, current, and source\n    const allDocIds = new Set<string>();\n    for (const docId of base.keys()) allDocIds.add(docId);\n    for (const docId of current.documents.keys()) allDocIds.add(docId);\n    for (const docId of source.documents.keys()) allDocIds.add(docId);\n\n    const merged: Record<string, object> = {};\n    const conflicts: Conflict[] = [];\n\n    for (const docId of allDocIds) {\n      const baseContent = base.get(docId);\n      const oursContent = current.documents.get(docId);\n      const theirsContent = source.documents.get(docId);\n\n      // Fast-forward check: if nothing changed from base, skip\n      const oursChanged = !mapObjEqual(baseContent, oursContent);\n      const theirsChanged = !mapObjEqual(baseContent, theirsContent);\n\n      if (!oursChanged && !theirsChanged) {\n        // No changes on either side\n        if (oursContent !== undefined) {\n          merged[docId] = deepClone(oursContent);\n        }\n        continue;\n      }\n\n      if (!oursChanged && theirsChanged) {\n        // Only theirs changed - take theirs\n        if (theirsContent !== undefined) {\n          merged[docId] = deepClone(theirsContent);\n        }\n        // If theirsContent is undefined (deleted on theirs), don't include\n        continue;\n      }\n\n      if (oursChanged && !theirsChanged) {\n        // Only ours changed - keep ours\n        if (oursContent !== undefined) {\n          merged[docId] = deepClone(oursContent);\n        }\n        continue;\n      }\n\n      // Both sides changed - do three-way merge\n      if (\n        baseContent !== undefined &&\n        oursContent !== undefined &&\n        theirsContent !== undefined\n      ) {\n        // All three exist - structural merge\n        const result = threeWayMerge(baseContent, oursContent, theirsContent, '', docId);\n        merged[docId] = result.merged;\n        conflicts.push(...result.conflicts);\n      } else if (oursContent === undefined && theirsContent === undefined) {\n        // Both deleted - nothing to merge\n      } else if (baseContent === undefined) {\n        // Created on both sides independently\n        if (mapObjEqual(oursContent, theirsContent)) {\n          // Same content - no conflict\n          if (oursContent !== undefined) {\n            merged[docId] = deepClone(oursContent);\n          }\n        } else {\n          // Different content - conflict at root\n          conflicts.push({\n            documentId: docId,\n            path: '',\n            base: undefined,\n            ours: deepClone(oursContent),\n            theirs: deepClone(theirsContent),\n          });\n          // Ours wins for merged output\n          if (oursContent !== undefined) {\n            merged[docId] = deepClone(oursContent);\n          }\n        }\n      } else {\n        // One side deleted, other side modified - conflict at root\n        conflicts.push({\n          documentId: docId,\n          path: '',\n          base: deepClone(baseContent),\n          ours: deepClone(oursContent),\n          theirs: deepClone(theirsContent),\n        });\n        // Ours wins for merged output\n        if (oursContent !== undefined) {\n          merged[docId] = deepClone(oursContent);\n        }\n      }\n    }\n\n    const hasConflicts = conflicts.length > 0;\n\n    if (!hasConflicts) {\n      // Apply the merge to the current branch\n      current.documents.clear();\n      for (const [docId, content] of Object.entries(merged)) {\n        current.documents.set(docId, deepClone(content));\n      }\n    }\n\n    return {\n      merged,\n      conflicts,\n      applied: !hasConflicts,\n    };\n  }\n\n  // --- Private helpers ---\n\n  private currentBranch(): BranchData {\n    const branch = this.branches.get(this.currentBranchName);\n    if (!branch) {\n      throw new Error(`Current branch \"${this.currentBranchName}\" does not exist`);\n    }\n    return branch;\n  }\n\n  /**\n   * Find the merge base between two branches.\n   * Returns the snapshot of documents at the point where the branches diverged.\n   */\n  private findMergeBase(currentName: string, sourceName: string): Map<string, object> {\n    // Case 1: source was forked from current\n    if (this.branches.get(sourceName)!.parentBranch === currentName) {\n      return this.cloneMap(this.branches.get(sourceName)!.forkSnapshot!);\n    }\n\n    // Case 2: current was forked from source\n    if (this.branches.get(currentName)!.parentBranch === sourceName) {\n      return this.cloneMap(this.branches.get(currentName)!.forkSnapshot!);\n    }\n\n    // Case 3: Find common ancestor by walking both ancestry chains\n    const currentAncestors = this.getAncestryChain(currentName);\n    const sourceAncestors = this.getAncestryChain(sourceName);\n\n    // Find the earliest point of divergence\n    // The merge base is the fork snapshot of the earlier-created branch\n    // from the most recent common ancestor\n    for (const sa of sourceAncestors) {\n      for (const ca of currentAncestors) {\n        if (sa.parentBranch === ca.parentBranch) {\n          // Both were forked from the same parent\n          // Use the fork snapshot of the earlier-created one\n          if (sa.order < ca.order) {\n            return this.cloneMap(sa.forkSnapshot);\n          } else {\n            return this.cloneMap(ca.forkSnapshot);\n          }\n        }\n      }\n    }\n\n    // Fallback: both trace back to main, use the earliest fork from main\n    // This handles the case where one is a deeper descendant\n    const allAncestors = [...currentAncestors, ...sourceAncestors]\n      .filter(a => a.parentBranch === 'main')\n      .sort((a, b) => a.order - b.order);\n\n    if (allAncestors.length > 0) {\n      return this.cloneMap(allAncestors[0].forkSnapshot);\n    }\n\n    // Ultimate fallback: empty base\n    return new Map();\n  }\n\n  /**\n   * Get the ancestry chain of a branch (the branch itself and all its ancestors,\n   * excluding the root \"main\" branch which has no fork snapshot).\n   */\n  private getAncestryChain(branchName: string): Array<{ branchName: string; forkSnapshot: Map<string, object>; parentBranch: string; order: number }> {\n    const chain: Array<{ branchName: string; forkSnapshot: Map<string, object>; parentBranch: string; order: number }> = [];\n    let current = branchName;\n\n    while (current !== null) {\n      const branch = this.branches.get(current)!;\n      if (branch.parentBranch !== null) {\n        chain.push({\n          branchName: current,\n          forkSnapshot: branch.forkSnapshot!,\n          parentBranch: branch.parentBranch,\n          order: branch.order,\n        });\n      }\n      current = branch.parentBranch ?? null;\n    }\n\n    return chain;\n  }\n\n  private cloneMap(map: Map<string, object>): Map<string, object> {\n    const result = new Map<string, object>();\n    for (const [key, value] of map) {\n      result.set(key, deepClone(value));\n    }\n    return result;\n  }\n}\n\nfunction mapObjEqual(a: object | undefined, b: object | undefined): boolean {\n  if (a === b) return true;\n  if (a === undefined || b === undefined) return false;\n  return JSON.stringify(a) === JSON.stringify(b);\n}\n","structuredPatch":[],"originalFile":null}}
