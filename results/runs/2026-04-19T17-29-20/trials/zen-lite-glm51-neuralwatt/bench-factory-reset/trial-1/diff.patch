nst lights = Array.from({ length: n }, () => Math.floor(Math.random() * modulus));\n      const result = solveCounter(lights, buttons, modulus);\n      if (result !== null) {\n        expect(verifyCounter(lights, buttons, modulus, result)).toBe(true);\n      }\n    }\n  });\n\n  it(\"40x40 toggle with rank > 32\", () => {\n    // 40 lights, 40 buttons, ensure rank > 32 by making buttons affect unique lights\n    const n = 40;\n    const target = Array.from({ length: n }, () => true);\n    // Each button i toggles light i and light (i+1)%n - this creates a well-determined system\n    const buttons = Array.from({ length: n }, (_, i) => [i, (i + 1) % n]);\n    const machine = { target, buttons };\n    const result = solveToggle(machine);\n    if (result !== null) {\n      expect(verifyToggle(machine, result)).toBe(true);\n    }\n  });\n\n  it(\"40x40 toggle with free variables and rank > 32\", () => {\n    // 40 lights, 42 buttons (2 extra for free variables), rank should be 40\n    const n = 40;\n    const target = Array.from({ length: n }, () => Math.random() < 0.5);\n    // 40 buttons for unique lights, plus 2 extra buttons\n    const buttons = Array.from({ length: n }, (_, i) => [i]);\n    buttons.push([0, 1]); // Button 40 toggles lights 0,1\n    buttons.push([2, 3]); // Button 41 toggles lights 2,3\n    const machine = { target, buttons };\n    const result = solveToggle(machine);\n    if (result !== null) {\n      expect(verifyToggle(machine, result)).toBe(true);\n    }\n  });\n});","originalFile":"import { describe, it, expect } from \"vitest\";\nimport { solveToggle, solveCounter, Machine } from \"./index.js\";\n\n// Verification helper for toggle\nfunction verifyToggle(machine: Machine, result: number[] | null): boolean {\n  if (result === null) return true; // can't easily verify unsolvability\n  const state = new Array(machine.target.length).fill(false);\n  for (const btn of result) {\n    for (const light of machine.buttons[btn]) {\n      state[light] = !state[light];\n    }\n  }\n  return state.every((s, i) => s === machine.target[i]);\n}\n\n// Verification helper for counter\nfunction verifyCounter(\n  lights: number[],\n  buttons: number[][],\n  modulus: number,\n  result: number[] | null,\n): boolean {\n  if (result === null) return true;\n  const state = new Array(lights.length).fill(0);\n  for (let btn = 0; btn < result.length; btn++) {\n    for (const counter of buttons[btn]) {\n      state[counter] = (state[counter] + result[btn]) % modulus;\n    }\n  }\n  return state.every((s, i) => s === lights[i]);\n}\n\ndescribe(\"solveToggle\", () => {\n  it(\"solves the example from TASK.md (returns null)\", () => {\n    const machine = {\n      target: [true, true, false, true],\n      buttons: [[0, 1], [1, 2, 3], [0, 3]],\n    };\n    expect(solveToggle(machine)).toBeNull();\n  });\n\n  it(\"solves a simple solvable case\", () => {\n    const machine = {\n      target: [true, false, true],\n      buttons: [[0], [2]],\n    };\n    const result = solveToggle(machine);\n    expect(result).toEqual([0, 1]);\n    expect(verifyToggle(machine, result)).toBe(true);\n  });\n\n  it(\"returns empty array when target is all off\", () => {\n    const machine = {\n      target: [false, false, false],\n      buttons: [[0], [1]],\n    };\n    expect(solveToggle(machine)).toEqual([]);\n  });\n\n  it(\"prefers fewer button presses\", () => {\n    const machine = {\n      target: [true, true],\n      buttons: [[0, 1], [0], [1]],\n    };\n    const result = solveToggle(machine);\n    expect(result).toEqual([0]);\n    expect(verifyToggle(machine, result)).toBe(true);\n  });\n\n  it(\"prefers lexicographically smallest on tie\", () => {\n    const machine = {\n      target: [true, true],\n      buttons: [[0], [1], [0, 1]],\n    };\n    const result = solveToggle(machine);\n    expect(result).toEqual([2]);\n    expect(verifyToggle(machine, result)).toBe(true);\n  });\n\n  it(\"handles button that toggles no lights\", () => {\n    const machine = {\n      target: [true],\n      buttons: [[], [0]],\n    };\n    expect(solveToggle(machine)).toEqual([1]);\n  });\n\n  it(\"handles more buttons than lights\", () => {\n    const machine = {\n      target: [true],\n      buttons: [[0], [0], [0]],\n    };\n    const result = solveToggle(machine);\n    expect(result).toEqual([0]);\n    expect(verifyToggle(machine, result)).toBe(true);\n  });\n\n  it(\"returns null for truly unsolvable case\", () => {\n    const machine = {\n      target: [true, false],\n      buttons: [[0, 1]],\n    };\n    expect(solveToggle(machine)).toBeNull();\n  });\n\n  it(\"handles empty target\", () => {\n    const machine = {\n      target: [] as boolean[],\n      buttons: [] as number[][],\n    };\n    expect(solveToggle(machine)).toEqual([]);\n  });\n\n  it(\"solves identity case - each button toggles one unique light\", () => {\n    // 5 lights, 5 buttons, button i toggles light i, target all on\n    const machine = {\n      target: [true, true, true, true, true],\n      buttons: [[0], [1], [2], [3], [4]],\n    };\n    expect(solveToggle(machine)).toEqual([0, 1, 2, 3, 4]);\n  });\n\n  it(\"handles no buttons with non-zero target\", () => {\n    const machine = {\n      target: [true],\n      buttons: [] as number[][],\n    };\n    expect(solveToggle(machine)).toBeNull();\n  });\n\n  it(\"handles no buttons with zero target\", () => {\n    const machine = {\n      target: [false, false],\n      buttons: [] as number[][],\n    };\n    expect(solveToggle(machine)).toEqual([]);\n  });\n\n  it(\"solves larger case with many free variables\", () => {\n    // 10 lights, 20 buttons (identity-like with redundancy)\n    // Buttons 0-9 each toggle light i, buttons 10-19 each toggle light (i-10)\n    // Target: lights 0,2,4,6,8 on, rest off\n    const target = Array.from({ length: 10 }, (_, i) => i % 2 === 0);\n    const buttons = Array.from({ length: 20 }, (_, i) => [i % 10]);\n    const machine = { target, buttons };\n    const result = solveToggle(machine);\n    expect(result).not.toBeNull();\n    expect(verifyToggle(machine, result)).toBe(true);\n    // Should prefer single buttons: [0,2,4,6,8]\n    expect(result).toEqual([0, 2, 4, 6, 8]);\n  });\n\n  it(\"handles 40x40 identity case within time\", () => {\n    const n = 40;\n    const target = Array.from({ length: n }, () => true);\n    const buttons = Array.from({ length: n }, (_, i) => [i]);\n    const machine = { target, buttons };\n    const start = Date.now();\n    const result = solveToggle(machine);\n    const elapsed = Date.now() - start;\n    expect(elapsed).toBeLessThan(5000);\n    expect(result).toEqual(Array.from({ length: n }, (_, i) => i));\n  });\n\n  it(\"handles 40 buttons, 40 lights with random-ish pattern within time\", () => {\n    const n = 40;\n    // Each button toggles a random-ish set of lights\n    const buttons: number[][] = [];\n    for (let b = 0; b < n; b++) {\n      const affected: number[] = [];\n      for (let l = 0; l < n; l++) {\n        if ((b * 7 + l * 13) % 3 === 0) affected.push(l);\n      }\n      buttons.push(affected);\n    }\n    const target = Array.from({ length: n }, (_, i) => i % 3 === 0);\n    const machine = { target, buttons };\n    const start = Date.now();\n    const result = solveToggle(machine);\n    const elapsed = Date.now() - start;\n    expect(elapsed).toBeLessThan(5000);\n    if (result !== null) {\n      expect(verifyToggle(machine, result)).toBe(true);\n    }\n  });\n});\n\ndescribe(\"solveCounter\", () => {\n  it(\"solves a simple case with modulus 3\", () => {\n    const result = solveCounter([2, 1], [[0], [1]], 3);\n    expect(result).toEqual([2, 1]);\n    expect(verifyCounter([2, 1], [[0], [1]], 3, result)).toBe(true);\n  });\n\n  it(\"returns solution with minimum total presses\", () => {\n    // 1 counter, target [1], modulus 2\n    // b0 + b1 = 1 (mod 2). Solutions: (1,0) total=1, (0,1) total=1.\n    const result = solveCounter([1], [[0], [0]], 2);\n    expect(result).toEqual([0, 1]);\n  });\n\n  it(\"returns empty array when target is all zeros\", () => {\n    const result = solveCounter([0, 0], [[0], [1]], 5);\n    expect(result).toEqual([0, 0]);\n  });\n\n  it(\"handles wrapping\", () => {\n    const result = solveCounter([0], [[0]], 5);\n    expect(result).toEqual([0]);\n  });\n\n  it(\"prefers minimum total presses then lex smallest\", () => {\n    const result = solveCounter([2], [[0], [0]], 5);\n    expect(result).toEqual([0, 2]);\n  });\n\n  it(\"handles modulus 2 (same as toggle but different API)\", () => {\n    const result = solveCounter([1, 1], [[0, 1], [0]], 2);\n    expect(result).toEqual([1, 0]);\n    expect(verifyCounter([1, 1], [[0, 1], [0]], 2, result)).toBe(true);\n  });\n\n  it(\"returns null for truly unsolvable counter puzzle\", () => {\n    const result = solveCounter([1, 0], [[0, 1]], 2);\n    expect(result).toBeNull();\n  });\n\n  it(\"handles larger modulus\", () => {\n    const result = solveCounter([3], [[0]], 7);\n    expect(result).toEqual([3]);\n  });\n\n  it(\"handles empty target\", () => {\n    const result = solveCounter([], [], 5);\n    expect(result).toEqual([]);\n  });\n\n  it(\"solves counter with modulus 97\", () => {\n    const result = solveCounter([42], [[0]], 97);\n    expect(result).toEqual([42]);\n    expect(verifyCounter([42], [[0]], 97, result)).toBe(true);\n  });\n\n  it(\"solves 40 counters with modulus 97 identity case within time\", () => {\n    const n = 40;\n    const lights = Array.from({ length: n }, (_, i) => (i * 7) % 97);\n    const buttons = Array.from({ length: n }, (_, i) => [i]);\n    const start = Date.now();\n    const result = solveCounter(lights, buttons, 97);\n    const elapsed = Date.now() - start;\n    expect(elapsed).toBeLessThan(5000);\n    expect(result).not.toBeNull();\n    expect(verifyCounter(lights, buttons, 97, result)).toBe(true);\n    // Identity: each button i pressed lights[i] times\n    expect(result).toEqual(lights);\n  });\n\n  it(\"handles 40x40 counter puzzle with redundancy within time\", () => {\n    const n = 40;\n    const modulus = 7;\n    const lights = Array.from({ length: n }, (_, i) => i % modulus);\n    // Buttons: each toggles 2-3 counters\n    const buttons: number[][] = [];\n    for (let b = 0; b < n; b++) {\n      const affected = [(b % n), ((b + 1) % n)];\n      if (b % 3 === 0) affected.push((b + 5) % n);\n      buttons.push(affected);\n    }\n    const start = Date.now();\n    const result = solveCounter(lights, buttons, modulus);\n    const elapsed = Date.now() - start;\n    expect(elapsed).toBeLessThan(5000);\n    if (result !== null) {\n      expect(verifyCounter(lights, buttons, modulus, result)).toBe(true);\n    }\n  });\n\n  it(\"no buttons with non-zero target returns null\", () => {\n    expect(solveCounter([1], [], 5)).toBeNull();\n  });\n\n  it(\"no buttons with zero target returns empty\", () => {\n    expect(solveCounter([0, 0], [], 5)).toEqual([]);\n  });\n});\n","structuredPatch":[{"oldStart":282,"oldLines":4,"newStart":282,"newLines":73,"lines":["   it(\"no buttons with zero target returns empty\", () => {","     expect(solveCounter([0, 0], [], 5)).toEqual([]);","   });","+","+  it(\"stress test: random toggle puzzles verify correct\", () => {","+    // Generate random toggle puzzles and verify solutions","+    for (let trial = 0; trial < 50; trial++) {","+      const n = 10 + Math.floor(Math.random() * 20); // 10-29 lights/buttons","+      const buttons: number[][] = [];","+      for (let b = 0; b < n; b++) {","+        const affected: number[] = [];","+        for (let l = 0; l < n; l++) {","+          if (Math.random() < 0.3) affected.push(l);","+        }","+        buttons.push(affected);","+      }","+      const target = Array.from({ length: n }, () => Math.random() < 0.5);","+      const machine = { target, buttons };","+      const result = solveToggle(machine);","+      if (result !== null) {","+        expect(verifyToggle(machine, result)).toBe(true);","+      }","+    }","+  