turn target.every(t => !t) ? [] : null;\n  }\n\n  // Convert target to bitmask\n  let targetMask = 0;\n  for (let i = 0; i < n; i++) {\n    if (target[i]) targetMask |= (1 << i);\n  }\n\n  // Split buttons into two halves\n  const mid = Math.floor(m / 2);\n  const m1 = mid;      // number of buttons in first half\n  const m2 = m - mid;  // number of buttons in second half\n\n  // Precompute toggle masks for each button\n  const toggleMasks: number[] = buttons.map(btn =>\n    btn.reduce((acc, light) => acc | (1 << light), 0)\n  );\n\n  // Enumerate first half: map from state to best (count, bitmask)\n  const firstMap = new Map<number, { count: number; mask: number }>();\n\n  for (let mask = 0; mask < (1 << m1); mask++) {\n    let state = 0;\n    let count = 0;\n    for (let i = 0; i < m1; i++) {\n      if (mask & (1 << i)) {\n        state ^= toggleMasks[i];\n        count++;\n      }\n    }\n    const existing = firstMap.get(state);\n    if (!existing || count < existing.count ||\n        (count === existing.count && compareLex(mask, existing.mask) < 0)) {\n      firstMap.set(state, { count, mask });\n    }\n  }\n\n  // Enumerate second half\n  let bestCount = Infinity;\n  let bestFirstMask = 0;\n  let bestSecondMask = 0;\n\n  for (let mask = 0; mask < (1 << m2); mask++) {\n    let state = 0;\n    let count = 0;\n    for (let i = 0; i < m2; i++) {\n      if (mask & (1 << i)) {\n        state ^= toggleMasks[mid + i];\n        count++;\n      }\n    }\n    const needed = targetMask ^ state;\n    const first = firstMap.get(needed);\n    if (first) {\n      const total = first.count + count;\n      if (total < bestCount ||\n          (total === bestCount && compareCombined(first.mask, mask, mid, bestFirstMask, bestSecondMask, m1) < 0)) {\n        bestCount = total;\n        bestFirstMask = first.mask;\n        bestSecondMask = mask;\n      }\n    }\n  }\n\n  if (bestCount === Infinity) return null;\n\n  // Convert masks to button indices\n  const result: number[] = [];\n  for (let i = 0; i < m1; i++) {\n    if (bestFirstMask & (1 << i)) result.push(i);\n  }\n  for (let i = 0; i < m2; i++) {\n    if (bestSecondMask & (1 << i)) result.push(mid + i);\n  }\n  return result;\n}\n```\n\nI need the `compareLex` and `compareCombined` functions. Let me implement them.\n\n`compareLex(a, b)`: compares two bitmasks by the lexicographic order of their set bit positions.\n\n`compareCombined(mask1, mask2, mid, bestMask1, bestMask2, m1)`: compares two combined solutions (first half + second half) by the lexicographic order of the sorted button indices.\n\nActually, for the combined comparison, since all first-half indices (0..m1-1) are less than all second-half indices (mid..m-1), the sorted list is [first-half indices in order] + [second-half indices in order]. So:\n- First compare first-half sets lexicographically\n- If equal, compare second-half sets lexicographically\n\nFor the lexicographic comparison of a bitmask's set bits:\n- Find the lowest set bit of each\n- The one with the smaller lowest set bit is lexicographically smaller\n- If equal, remove that bit and compare again\n\n```\nfunction compareLex(a: number, b: number): number {\n  while (a !== 0 || b !== 0) {\n    if (a === 0) return 1;  // b has more elements, a is shorter so a < b\n    if (b === 0) return -1; // a has more elements, b is shorter so b < a\n    const lowA = a & (-a);\n    const lowB = b & (-b);\n    if (lowA !== lowB) return lowA - lowB;\n    a ^= lowA;\n    b ^= lowB;\n  }\n  return 0;\n}\n```\n\nWait, `lowA - lowB` gives the correct sign? lowA and lowB are powers of 2. If lowA < lowB, then lowA - lowB < 0, so we return negative, meaning a < b. That's correct because a's smallest index is smaller.\n\nIf lowA > lowB, then lowA - lowB > 0, so we return positive, meaning a > b. That's correct because b's smallest index is smaller.\n\nGood.\n\nFor the combined comparison:\n\n```\nfunction compareCombined(\n  f1: number, s1: number, f2: number, s2: number\n): number {\n 