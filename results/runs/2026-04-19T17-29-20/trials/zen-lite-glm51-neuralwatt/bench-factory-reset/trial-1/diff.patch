+export interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+// --- Lex comparison ---
+function lexLess(a: number[], b: number[]): boolean {
+  for (let i = 0; i < Math.min(a.length, b.length); i++) {
+    if (a[i] < b[i]) return true;
+    if (a[i] > b[i]) return false;
+  }
+  return a.length < b.length;
+}
+
+// --- 64-bit bitmask helpers (as two 32-bit words: [lo, hi]) ---
+// Used for rank up to 40, which needs more than 32 bits
+
+type Mask64 = [number, number]; // [lo, hi]
+
+function mask64SetBit(mask: Mask64, bit: number): void {
+  if (bit < 32) mask[0] |= (1 << bit);
+  else mask[1] |= (1 << (bit - 32));
+}
+
+function mask64GetBit(mask: Mask64, bit: number): number {
+  if (bit < 32) return (mask[0] >>> bit) & 1;
+  return (mask[1] >>> (bit - 32)) & 1;
+}
+
+function popcount32(n: number): number {
+  n = n - ((n >>> 1) & 0x55555555);
+  n = (n & 0x33333333) + ((n >>> 2) & 0x33333333);
+  return ((n + (n >>> 4) & 0x0f0f0f0f) * 0x01010101) >>> 24;
+}
+
+// --- GF(2) Toggle Solver ---
+
+export function solveToggle(machine: Machine): number[] | null {
+  const numVars = machine.buttons.length;
+  const numEqs = machine.target.length;
+
+  if (numEqs === 0) return [];
+  if (numVars === 0) {
+    return machine.target.some((t) => t) ? null : [];
+  }
+
+  // Build augmented matrix over GF(2)
+  const aug: number[][] = [];
+  for (let eq = 0; eq < numEqs; eq++) {
+    const row = new Array(numVars + 1).fill(0);
+    row[numVars] = machine.target[eq] ? 1 : 0;
+    aug.push(row);
+  }
+  for (let btn = 0; btn < numVars; btn++) {
+    for (const light of machine.buttons[btn]) {
+      aug[light][btn] = 1;
+    }
+  }
+
+  // RREF over GF(2)
+  const pivotCol = new Int32Array(numEqs).fill(-1);
+  const pivotRowMap = new Int32Array(numVars).fill(-1);
+  let rank = 0;
+  let curRow = 0;
+
+  for (let col = 0; col < numVars && curRow < numEqs; col++) {
+    let found = -1;
+    for (let row = curRow; row < numEqs; row++) {
+      if (aug[row][col] === 1) {
+        found = row;
+        break;
+      }
+    }
+    if (found === -1) continue;
+
+    [aug[curRow], aug[found]] = [aug[found], aug[curRow]];
+    pivotCol[curRow] = col;
+    pivotRowMap[col] = curRow;
+    rank++;
+
+    for (let row = 0; row < numEqs; row++) {
+      if (row !== curRow && aug[row][col] === 1) {
+        for (let j = 0; j <= numVars; j++) {
+          aug[row][j] ^= aug[curRow][j];
+        }
+      }
+    }
+    curRow++;
+  }
+
+  // Check consistency
+  for (let row = rank; row < numEqs; row++) {
+    if (aug[row][numVars] === 1) return null;
+  }
+
+  // Unique solution
+  if (rank === numVars) {
+    const pressed: number[] = [];
+    for (let r = 0; r < rank; r++) {
+      if (aug[r][numVars] === 1) pressed.push(pivotCol[r]);
+    }
+    return pressed;
+  }
+
+  // Identify free variables
+  const freeVars: number[] = [];
+  for (let col = 0; col < numVars; col++) {
+    if (pivotRowMap[col] === -1) freeVars.push(col);
+  }
+
+  const numFree = freeVars.length;
+
+  // Precompute: for each free var, which pivot rows it contributes to (packed as 64-bit bitmask)
+  const effect: Mask64[] = [];
+  for (let fi = 0; fi < numFree; fi++) {
+    const f = freeVars[fi];
+    const mask: Mask64 = [0, 0];
+    for (let r = 0; r < rank; r++) {
+      if (aug[r][f] === 1) mask64SetBit(mask, r);
+    }
+    effect.push(mask);
+  }
+
+  // baseMask: bit r set if RHS of pivot row r is 1
+  const baseMask: Mask64 = [0, 0];
+  for (let r = 0; r < rank; r++) {
+    if (aug[r][numVars] === 1) mask64SetBit(baseMask, r);
+  }
+
+  // Pivot column indices
+  const pCols: number[] = [];
+  for (let r = 0; r < rank; r++) pCols.push(pivotCol[r]);
+
+  if (numFree <= 25) {
+    return solveToggleEnumerate(numVars, numFree, rank, effect, baseMask, freeVars, pCols);
+  }
+
+  return solveToggleMITM(numVars, numFree, rank, effect, baseMask, freeVars, pCols);
+}
+
+function solveToggleEnumerate(
+  numVars: number,
+  numFree: number,
+  rank: number,
+  effect: Mask64[],
+  baseMask: Mask64,
+  freeVars: number[],
+  pCols: number[],
+): number[] | null {
+  const totalEnum = 1 << numFree;
+
+  // Precompute combined effect for each free assignment mask using DP
+  // combinedEffect[mask] = XOR of effect[fi] for all fi where bit fi is set in mask
+  const combinedEffectLo = new Int32Array(totalEnum);
+  const combinedEffectHi = new Int32Array(totalEnum);
+  for (let mask = 1; mask < totalEnum; mask++) {
+    const lowestBit = mask & (-mask);
+    const bitPos = 31 - Math.clz32(lowestBit);
+    combinedEffectLo[mask] = combinedEffectLo[mask ^ lowestBit] ^ effect[bitPos][0];
+    combinedEffectHi[mask] = combinedEffectHi[mask ^ lowestBit] ^ effect[bitPos][1];
+  }
+
+  // Pass 1: find minimum total press count
+  let bestTotal = Infinity;
+  for (let freeMask = 0; freeMask < totalEnum; freeMask++) {
+    const pivotLo = baseMask[0] ^ combinedEffectLo[freeMask];
+    const pivotHi = baseMask[1] ^ combinedEffectHi[freeMask];
+    const total = popcount32(freeMask) + popcount32(pivotLo) + popcount32(pivotHi);
+    if (total < bestTotal) bestTotal = total;
+  }
+
+  // Pass 2: find lex smallest pressed list with bestTotal
+  let bestResult: number[] | null = null;
+
+  for (let freeMask = 0; freeMask < totalEnum; freeMask++) {
+    const pivotLo = baseMask[0] ^ combinedEffectLo[freeMask];
+    const pivotHi = baseMask[1] ^ combinedEffectHi[freeMask];
+    const total = popcount32(freeMask) + popcount32(pivotLo) + popcount32(pivotHi);
+    if (total !== bestTotal) continue;
+
+    const pivotMask: Mask64 = [pivotLo, pivotHi];
+    const pressed = buildPressedList(freeMask, pivotMask, freeVars, pCols, numFree, rank);
+
+    if (bestResult === null || lexLess(pressed, bestResult)) {
+      bestResult = pressed;
+    }
+  }
+
+  return bestResult;
+}
+
+function buildPressedList(
+  freeMask: number,
+  pivotMask: Mask64,
+  freeVars: number[],
+  pCols: number[],
+  numFree: number,
+  rank: number,
+): number[] {
+  // Merge sorted lists of free vars and pivot vars that are "on"
+  const result: number[] = [];
+  let fi = 0, pi = 0;
+
+  while (fi < numFree && pi < rank) {
+    const fv = freeVars[fi];
+    const pv = pCols[pi];
+    const fOn = (freeMask >>> fi) & 1;
+    const pOn = mask64GetBit(pivotMask, pi);
+
+    if (fOn && pOn) {
+      if (fv <= pv) { result.push(fv); fi++; }
+      else { result.push(pv); pi++; }
+    } else if (fOn) {
+      result.push(fv); fi++;
+    } else if (pOn) {
+      result.push(pv); pi++;
+    } else {
+      fi++; pi++;
+    }
+  }
+
+  while (fi < numFree) {
+    if ((freeMask >>> fi) & 1) result.push(freeVars[fi]);
+    fi++;
+  }
+  while (pi < rank) {
+    if (mask64GetBit(pivotMask, pi)) result.push(pCols[pi]);
+    pi++;
+  }
+
+  return result;
+}
+
+function solveToggleMITM(
+  numVars: number,
+  numFree: number,
+  rank: number,
+  effect: Mask64[],
+  baseMask: Mask64,
+  freeVars: number[],
+  pCols: number[],
+): number[] | null {
+  const half = Math.floor(numFree / 2);
+  const leftCount = half;
+  const rightCount = numFree - half;
+
+  const leftEnum = 1 << leftCount;
+  const rightEnum = 1 << rightCount;
+
+  // For left half: compute combined effect
+  const leftEffectLo = new Int32Array(leftEnum);
+  const leftEffectHi = new Int32Array(leftEnum);
+  for (let mask = 1; mask < leftEnum; mask++) {
+    const lowestBit = mask & (-mask);
+    const bitPos = 31 - Math.clz32(lowestBit);
+    leftEffectLo[mask] = leftEffectLo[mask ^ lowestBit] ^ effect[bitPos][0];
+    leftEffectHi[mask] = leftEffectHi[mask ^ lowestBit] ^ effect[bitPos][1];
+  }
+
+  // For right half: compute combined effect
+  const rightEffectLo = new Int32Array(rightEnum);
+  const rightEffectHi = new Int32Array(rightEnum);
+  for (let mask = 1; mask < rightEnum; mask++) {
+    const lowestBit = mask & (-mask);
+    const bitPos = 31 - Math.clz32(lowestBit);
+    rightEffectLo[mask] = rightEffectLo[mask ^ lowestBit] ^ effect[leftCount + bitPos][0];
+    rightEffectHi[mask] = rightEffectHi[mask ^ lowestBit] ^ effect[leftCount + bitPos][1];
+  }
+
+  // Group left by effect mask, keep best (min pc, then min freeMask for lex)
+  const leftBest = new Map<string, { pc: number; freeMask: number }>();
+  for (let mask = 0; mask < leftEnum; mask++) {
+    const key = leftEffectLo[mask] + "," + leftEffectHi[mask];
+    const pc = popcount32(mask);
+    const existing = leftBest.get(key);
+    if (!existing || pc < existing.pc || (pc === existing.pc && mask < existing.freeMask)) {
+      leftBest.set(key, { pc, freeMask: mask });
+    }
+  }
+
+  const rightBest = new Map<string, { pc: number; freeMask: number }>();
+  for (let mask = 0; mask < rightEnum; mask++) {
+    const key = rightEffectLo[mask] + "," + rightEffectHi[mask];
+    const pc = popcount32(mask);
+    const existing = rightBest.get(key);
+    if (!existing || pc < existing.pc || (pc === existing.pc && mask < existing.freeMask)) {
+      rightBest.set(key, { pc, freeMask: mask });
+    }
+  }
+
+  // Match left and right
+  let bestTotal = Infinity;
+  let bestResult: number[] | null = null;
+
+  const leftEntries = Array.from(leftBest.entries());
+  const rightEntries = Array.from(rightBest.entries());
+  leftEntries.sort((a, b) => a[1].pc - b[1].pc);
+  rightEntries.sort((a, b) => a[1].pc - b[1].pc);
+
+  for (const [lKey, lVal] of leftEntries) {
+    if (lVal.pc >= bestTotal) break;
+
+    for (const [rKey, rVal] of rightEntries) {
+      const lb = lVal.pc + rVal.pc;
+      if (lb >= bestTotal) break;
+
+      // Parse keys
+      const [lLo, lHi] = lKey.split(",").map(Number);
+      const [rLo, rHi] = rKey.split(",").map(Number);
+
+      const pivotLo = baseMask[0] ^ lLo ^ rLo;
+      const pivotHi = baseMask[1] ^ lHi ^ rHi;
+      const total = lb + popcount32(pivotLo) + popcount32(pivotHi);
+
+      if (total < bestTotal || (total === bestTotal && bestResult !== null)) {
+        const fullFreeMask = lVal.freeMask | (rVal.freeMask << leftCount);
+        const pivotMask: Mask64 = [pivotLo, pivotHi];
+        const pressed = buildPressedList(fullFreeMask, pivotMask, freeVars, pCols, numFree, rank);
+
+        if (total < bestTotal || lexLess(pressed, bestResult!)) {
+          bestTotal = total;
+          bestResult = pressed;
+        }
+      }
+    }
+  }
+
+  return bestResult;
+}
+
+// --- GF(p) Counter Solver ---
+
+function modInverse(a: number, p: number): number {
+  let old_r = a, r = p;
+  let old_s = 1, s = 0;
+  while (r !== 0) {
+    const q = Math.floor(old_r / r);
+    [old_r, r] = [r, old_r - q * r];
+    [old_s, s] = [s, old_s - q * s];
+  }
+  return ((old_s % p) + p) % p;
+}
+
+function mod(a: number, p: number): number {
+  return ((a % p) + p) % p;
+}
+
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const numVars = buttons.length;
+  const numEqs = lights.length;
+
+  if (numEqs === 0 && numVars === 0) return [];
+  if (numEqs === 0) return new Array(numVars).fill(0);
+  if (numVars === 0) {
+    return lights.some((l) => l !== 0) ? null : [];
+  }
+
+  // Build augmented matrix over GF(p)
+  const aug: number[][] = [];
+  for (let eq = 0; eq < numEqs; eq++) {
+    aug.push(new Array(numVars + 1).fill(0));
+  }
+  for (let btn = 0; btn < numVars; btn++) {
+    for (const counter of buttons[btn]) {
+      aug[counter][btn] = mod(aug[counter][btn] + 1, modulus);
+    }
+  }
+  for (let eq = 0; eq < numEqs; eq++) {
+    aug[eq][numVars] = mod(lights[eq], modulus);
+  }
+
+  // RREF over GF(p)
+  const pivotCol = new Int32Array(numEqs).fill(-1);
+  const pivotRowMap = new Int32Array(numVars).fill(-1);
+  let rank = 0;
+  let curRow = 0;
+
+  for (let col = 0; col < numVars && curRow < numEqs; col++) {
+    let found = -1;
+    for (let row = curRow; row < numEqs; row++) {
+      if (aug[row][col] !== 0) {
+        found = row;
+        break;
+      }
+    }
+    if (found === -1) continue;
+
+    [aug[curRow], aug[found]] = [aug[found], aug[curRow]];
+
+    const inv = modInverse(aug[curRow][col], modulus);
+    for (let j = 0; j <= numVars; j++) {
+      aug[curRow][j] = mod(aug[curRow][j] * inv, modulus);
+    }
+
+    pivotCol[curRow] = col;
+    pivotRowMap[col] = curRow;
+    rank++;
+
+    for (let row = 0; row < numEqs; row++) {
+      if (row !== curRow && aug[row][col] !== 0) {
+        const factor = aug[row][col];
+        for (let j = 0; j <= numVars; j++) {
+          aug[row][j] = mod(aug[row][j] - factor * aug[curRow][j], modulus);
+        }
+      }
+    }
+    curRow++;
+  }
+
+  // Check consistency
+  for (let row = rank; row < numEqs; row++) {
+    if (aug[row][numVars] !== 0) return null;
+  }
+
+  // Unique solution
+  if (rank === numVars) {
+    const result = new Array(numVars);
+    for (let r = 0; r < rank; r++) {
+      result[pivotCol[r]] = aug[r][numVars];
+    }
+    return result;
+  }
+
+  // Identify free variables
+  const freeVars: number[] = [];
+  for (let col = 0; col < numVars; col++) {
+    if (pivotRowMap[col] === -1) freeVars.push(col);
+  }
+
+  const numFree = freeVars.length;
+
+  // Precompute pivot coefficients for free variables
+  const rhs = new Int32Array(rank);
+  const coeff = new Int32Array(rank * numFree);
+  for (let r = 0; r < rank; r++) {
+    rhs[r] = aug[r][numVars];
+    for (let j = 0; j < numFree; j++) {
+      coeff[r * numFree + j] = aug[r][freeVars[j]];
+    }
+  }
+
+  const pCols = Array.from(pivotCol.subarray(0, rank));
+
+  const enumSize = Math.pow(modulus, numFree);
+  if (enumSize <= 2_000_000) {
+    return solveCounterEnumerate(rank, numVars, numFree, freeVars, rhs, coeff, pCols, modulus);
+  }
+
+  return solveCounterBranchAndBound(rank, numVars, numFree, freeVars, rhs, coeff, pCols, modulus);
+}
+
+function solveCounterEnumerate(
+  rank: number,
+  numVars: number,
+  numFree: number,
+  freeVars: number[],
+  rhs: Int32Array,
+  coeff: Int32Array,
+  pCols: number[],
+  modulus: number,
+): number[] | null {
+  const totalEnum = Math.pow(modulus, numFree);
+  let best: number[] | null = null;
+  let bestTotal = Infinity;
+
+  const freeAssign = new Int32Array(numFree);
+
+  for (let enc = 0; enc < totalEnum; enc++) {
+    let tmp = enc;
+    let freeSum = 0;
+    for (let i = 0; i < numFree; i++) {
+      freeAssign[i] = tmp % modulus;
+      freeSum += freeAssign[i];
+      tmp = Math.floor(tmp / modulus);
+    }
+
+    if (freeSum > bestTotal) continue;
+
+    // Compute pivot values
+    let pivotSum = 0;
+    const pivotVals = new Int32Array(rank);
+    for (let r = 0; r < rank; r++) {
+      let val = rhs[r];
+      for (let j = 0; j < numFree; j++) {
+        val = mod(val - coeff[r * numFree + j] * freeAssign[j], modulus);
+      }
+      pivotVals[r] = val;
+      pivotSum += val;
+    }
+
+    const total = freeSum + pivotSum;
+    if (total > bestTotal) continue;
+    if (total === bestTotal && best !== null) {
+      const assignment = buildCounterAssignment(freeAssign, pivotVals, numVars, freeVars, pCols, rank);
+      if (!lexLessArr(assignment, best)) continue;
+      best = assignment;
+    } else {
+      best = buildCounterAssignment(freeAssign, pivotVals, numVars, freeVars, pCols, rank);
+      bestTotal = total;
+    }
+  }
+
+  return best;
+}
+
+function buildCounterAssignment(
+  freeAssign: Int32Array,
+  pivotVals: Int32Array,
+  numVars: number,
+  freeVars: number[],
+  pCols: number[],
+  rank: number,
+): number[] {
+  const result = new Array(numVars).fill(0);
+  for (let i = 0; i < freeAssign.length; i++) {
+    result[freeVars[i]] = freeAssign[i];
+  }
+  for (let r = 0; r < rank; r++) {
+    result[pCols[r]] = pivotVals[r];
+  }
+  return result;
+}
+
+function lexLessArr(a: number[], b: number[]): boolean {
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] < b[i]) return true;
+    if (a[i] > b[i]) return false;
+  }
+  return false;
+}
+
+function solveCounterBranchAndBound(
+  rank: number,
+  numVars: number,
+  numFree: number,
+  freeVars: number[],
+  rhs: Int32Array,
+  coeff: Int32Array,
+  pCols: number[],
+  modulus: number,
+): number[] | null {
+  const freeAssign = new Int32Array(numFree);
+  const pivotPartial = new Float64Array(rank);
+  for (let r = 0; r < rank; r++) pivotPartial[r] = rhs[r];
+
+  let best: number[] | null = null;
+  let bestTotal = Infinity;
+
+  function search(depth: number, freeSum: number): void {
+    if (depth === numFree) {
+      let pivotSum = 0;
+      const pivotVals = new Int32Array(rank);
+      for (let r = 0; r < rank; r++) {
+        pivotVals[r] = mod(pivotPartial[r], modulus);
+        pivotSum += pivotVals[r];
+      }
+      const total = freeSum + pivotSum;
+
+      if (total > bestTotal) return;
+      if (total === bestTotal && best !== null) {
+        const assignment = buildCounterAssignment(freeAssign, pivotVals, numVars, freeVars, pCols, rank);
+        if (!lexLessArr(assignment, best)) return;
+        best = assignment;
+      } else {
+        best = buildCounterAssignment(freeAssign, pivotVals, numVars, freeVars, pCols, rank);
+        bestTotal = total;
+      }
+      return;
+    }
+
+    if (freeSum > bestTotal) return;
+
+    for (let v = 0; v < modulus; v++) {
+      freeAssign[depth] = v;
+
+      for (let r = 0; r < rank; r++) {
+        pivotPartial[r] -= coeff[r * numFree + depth] * v;
+      }
+
+      search(depth + 1, freeSum + v);
+
+      for (let r = 0; r < rank; r++) {
+        pivotPartial[r] += coeff[r * numFree + depth] * v;
+      }
+    }
+    freeAssign[depth] = 0;
+  }
+
+  search(0, 0);
+  return best;
+}
