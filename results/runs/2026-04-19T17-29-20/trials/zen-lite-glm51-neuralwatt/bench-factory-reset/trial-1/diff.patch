on\"\n   210→  const result: number[] = [];\n   211→  let fi = 0, pi = 0;\n   212→\n   213→  while (fi < numFree && pi < rank) {\n   214→    const fv = freeVars[fi];\n   215→    const pv = pCols[pi];\n   216→    const fOn = (freeMask >>> fi) & 1;\n   217→    const pOn = mask64GetBit(pivotMask, pi);\n   218→\n   219→    if (fOn && pOn) {\n   220→      if (fv <= pv) { result.push(fv); fi++; }\n   221→      else { result.push(pv); pi++; }\n   222→    } else if (fOn) {\n   223→      result.push(fv); fi++;\n   224→    } else if (pOn) {\n   225→      result.push(pv); pi++;\n   226→    } else {\n   227→      fi++; pi++;\n   228→    }\n   229→  }\n   230→\n   231→  while (fi < numFree) {\n   232→    if ((freeMask >>> fi) & 1) result.push(freeVars[fi]);\n   233→    fi++;\n   234→  }\n   235→  while (pi < rank) {\n   236→    if (mask64GetBit(pivotMask, pi)) result.push(pCols[pi]);\n   237→    pi++;\n   238→  }\n   239→\n   240→  return result;\n   241→}\n   242→\n   243→function solveToggleMITM(\n   244→  numVars: number,\n   245→  numFree: number,\n   246→  rank: number,\n   247→  effect: Mask64[],\n   248→  baseMask: Mask64,\n   249→  freeVars: number[],\n   250→  pCols: number[],\n   251→): number[] | null {\n   252→  const half = Math.floor(numFree / 2);\n   253→  const leftCount = half;\n   254→  const rightCount = numFree - half;\n   255→\n   256→  const leftEnum = 1 << leftCount;\n   257→  const rightEnum = 1 << rightCount;\n   258→\n   259→  // For left half: compute combined effect\n   260→  const leftEffectLo = new Int32Array(leftEnum);\n   261→  const leftEffectHi = new Int32Array(leftEnum);\n   262→  for (let mask = 1; mask < leftEnum; mask++) {\n   263→    const lowestBit = mask & (-mask);\n   264→    const bitPos = 31 - Math.clz32(lowestBit);\n   265→    leftEffectLo[mask] = leftEffectLo[mask ^ lowestBit] ^ effect[bitPos][0];\n   266→    leftEffectHi[mask] = leftEffectHi[mask ^ lowestBit] ^ effect[bitPos][1];\n   267→  }\n   268→\n   269→  // For right half: compute combined effect\n   270→  const rightEffectLo = new Int32Array(rightEnum);\n   271→  const rightEffectHi = new Int32Array(rightEnum);\n   272→  for (let mask = 1; mask < rightEnum; mask++) {\n   273→    const lowestBit = mask & (-mask);\n   274→    const bitPos = 31 - Math.clz32(lowestBit);\n   275→    rightEffectLo[mask] = rightEffectLo[mask ^ lowestBit] ^ effect[leftCount + bitPos][0];\n   276→    rightEffectHi[mask] = rightEffectHi[mask ^ lowestBit] ^ effect[leftCount + bitPos][1];\n   277→  }\n   278→\n   279→  // Group left by effect mask, keep best (min pc, then min freeMask for lex)\n   280→  const leftBest = new Map<string, { pc: number; freeMask: number }>();\n   281→  for (let mask = 0; mask < leftEnum; mask++) {\n   282→    const key = leftEffectLo[mask] + \",\" + leftEffectHi[mask];\n   283→    const pc = popcount32(mask);\n   284→    const existing = leftBest.get(key);\n   285→    if (!existing || pc < existing.pc || (pc === existing.pc && mask < existing.freeMask)) {\n   286→      leftBest.set(key, { pc, freeMask: mask });\n   287→    }\n   288→  }\n   289→\n   290→  const rightBest = new Map<string, { pc: number; freeMask: number }>();\n   291→  for (let mask = 0; mask < rightEnum; mask++) {\n   292→    const key = rightEffectLo[mask] + \",\" + rightEffectHi[mask];\n   293→    const pc = popcount32(mask);\n   294→    const existing = rightBest.get(key);\n   295→    if (!existing || pc < existing.pc || (pc === existing.pc && mask < existing.freeMask)) {\n   296→      rightBest.set(key, { pc, freeMask: mask });\n   297→    }\n   298→  }\n   299→\n   300→  // Match left and right\n   301→  let bestTotal = Infinity;\n   302→  let bestResult: number[] | null = null;\n   303→\n   304→  const leftEntries = Array.from(leftBest.entries());\n   305→  const rightEntries = Array.from(rightBest.entries());\n   306→  leftEntries.sort((a, b) => a[1].pc - b[1].pc);\n   307→  rightEntries.sort((a, b) => a[1].pc - b[1].pc);\n   308→\n   309→  for (const [lKey, lVa