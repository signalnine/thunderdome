 numVars: number,\n   113→  rank: number,\n   114→  pivotCol: number[],\n   115→  pivotRow: number[],\n   116→  freeVars: number[],\n   117→): number[] | null {\n   118→  const numFree = freeVars.length;\n   119→  let best: number[] | null = null;\n   120→  let bestCount = Infinity;\n   121→\n   122→  for (let mask = 0; mask < (1 << numFree); mask++) {\n   123→    const assignment = new Array(numVars).fill(0);\n   124→\n   125→    // Set free variables from mask\n   126→    for (let i = 0; i < numFree; i++) {\n   127→      assignment[freeVars[i]] = (mask >> i) & 1;\n   128→    }\n   129→\n   130→    // Back-substitute pivot variables\n   131→    for (let r = rank - 1; r >= 0; r--) {\n   132→      const col = pivotCol[r];\n   133→      let val = aug[r][numVars];\n   134→      for (let j = col + 1; j < numVars; j++) {\n   135→        if (aug[r][j] === 1) val ^= assignment[j];\n   136→      }\n   137→      assignment[col] = val;\n   138→    }\n   139→\n   140→    const pressed: number[] = [];\n   141→    for (let i = 0; i < numVars; i++) {\n   142→      if (assignment[i] === 1) pressed.push(i);\n   143→    }\n   144→\n   145→    if (pressed.length < bestCount || (pressed.length === bestCount && lexLess(pressed, best!))) {\n   146→      best = pressed;\n   147→      bestCount = pressed.length;\n   148→    }\n   149→  }\n   150→\n   151→  return best;\n   152→}\n   153→\n   154→function lexLess(a: number[], b: number[]): boolean {\n   155→  for (let i = 0; i < Math.min(a.length, b.length); i++) {\n   156→    if (a[i] < b[i]) return true;\n   157→    if (a[i] > b[i]) return false;\n   158→  }\n   159→  return a.length < b.length;\n   160→}\n   161→\n   162→/**\n   163→ * Meet-in-the-middle for toggle puzzle with many free variables.\n   164→ * Split free variables into two halves, enumerate each, match on pivot variable constraints.\n   165→ */\n   166→function solveToggleMITM(\n   167→  machine: Machine,\n   168→  aug: number[][],\n   169→  numVars: number,\n   170→  _numEqs: number,\n   171→  rank: number,\n   172→  pivotCol: number[],\n   173→  _pivotRow: number[],\n   174→  freeVars: number[],\n   175→): number[] | null {\n   176→  const numFree = freeVars.length;\n   177→  const half = Math.floor(numFree / 2);\n   178→  const leftFree = freeVars.slice(0, half);\n   179→  const rightFree = freeVars.slice(half);\n   180→  const leftCount = leftFree.length;\n   181→  const rightCount = rightFree.length;\n   182→\n   183→  // For each pivot variable, compute its expression as: pivot = rhs XOR (sum of free var contributions)\n   184→  // We need to split the contribution into left and right halves.\n   185→\n   186→  // Build pivot expressions: for each pivot row, which free vars affect it?\n   187→  // pivot = aug[row][numVars] XOR sum(free_vars_in_row)\n   188→  // Split: pivot = rhs XOR leftContrib XOR rightContrib\n   189→\n   190→  interface HalfResult {\n   191→    // For matching: the key is the vector of pivot variable values induced by this half\n   192→    // (assuming right half free vars are 0 for left, and left half free vars are 0 for right)\n   193→    pivotKey: number; // bitmask of pivot values\n   194→    freeAssignment: number[]; // assignment for free vars in this half\n   195→    pressCount: number; // number of 1s in free vars for this half\n   196→  }\n   197→\n   198→  const leftResults: HalfResult[] = [];\n   199→  const rightResults: HalfResult[] = [];\n   200→\n   201→  // Enumerate left half\n   202→  for (let mask = 0; mask < (1 << leftCount); mask++) {\n   203→    const freeAssign = new Array(numVars).fill(0);\n   204→    let pressCount = 0;\n   205→    for (let i = 0; i < leftCount; i++) {\n   206→      freeAssign[leftFree[i]] = (mask >> i) & 1;\n   207→      if (freeAssign[leftFree[i]]) pressCount++;\n   208→    }\n   209→\n   210→    // Compute pivot values from left half contribution\n   211→    let pivotKey = 0;\n   212→    for (let r = 0; r < rank; r++) {\n   213→      const col = pivotCol[r];\n   214→      // pivot = aug[r][numVars] XOR sum of free var contributions from columns > col\n   215→      let val = aug[r][numVars];\n   216→      for (let j = col + 1; j < numVars; j++) {\n   217→        if (aug[r][j] === 1 && freeAssign[j] === 1) val ^= 1;\n   218→      }\n   219→      if (val) pivotKey |= (1 << r);\n   220→    }\n   221→\n   222→    leftResults.push({ pivotKey, freeAssignment: freeAssign.slice(), pressCount });\n   223→  }\n   224→\n   225→  // Enumerate right half\n   226→  for (let mask = 0; mask < (1 << rightCount); mask++) {\n   227→    const freeAssign = new Array(numVars).fill(0);\n   228→    let pressCount = 0;\n   229→    for (let i = 0; i < rightCount; i++) {\n   230→      freeAssign[rightFree[i]] = (mask >> i) & 1;\n   231→      if (freeAssign[rightFree[i]]) pressCount++;\n   232→    }\n   233→\n   234→    // For right half, compute the XOR that needs to be applied to pivot values\n   235→    // pivot = aug[r][numVars] XOR leftContrib XOR rightContrib\n   236→    // For left: pivotContribLeft = XOR of left free vars in that row\n   237→    // For right: we need the rightContrib so that combined: pivots are determined\n   238→    // We store rightContrib as a key\n   239→    let rightKey = 0;\n   240→    for (let r = 0; r < rank; r++) {\n   241→      const col = pivotCol[r];\n   242→      let val = 0;\n   243→      for (let j = col + 1; j < numVars; j++) {\n   244→        if (aug[r][j] === 1 && freeAssign[j] === 1) val ^= 1;\n   245→      }\n   246→      if (val) rightKey |= (1 << r);\n   247→    }\n   248→\n   249→    rightResults.push({ pivotKey: rightKey, freeAssignment: freeAssign.slice(), pressCount });\n   250→  }\n   251→\n   252→  // For each pivot variable, total = rhs XOR leftContrib XOR rightContrib\n   253→  // But we want to minimize total presses. The pivot variables also contribute to press count.\n   254→  // pivot[r] = aug[r][numVars] XOR leftContrib[r] XOR rightContrib[r]\n   255→  // So for a valid combination: leftResult.pivotKey XOR rightResult.pivotKey gives the\n   256→  // pivot values. The total press count = left.pressCount + right.pressCount + popcount(pivotValues).\n   257→\n   258→  // Group left results by pivotKey for fast lookup\n   259→  const leftByKey = new Map<number, { pressCount: number; freeAssignment: number[] }[]>();\n   260→  for (const lr of leftResults) {\n   261→    if (!leftByKey.has(lr.pivotKey)) leftByKey.set(lr.pivotKey, []);\n   262→    leftByKey.get(lr.pivotKey)!.push({ pressCount: lr.pressCount, freeAssignment: lr.freeAssignment });\n   263→  }\n   264→\n   265→  // For each left group, keep only the best (min press count, then lex)\n   266→  const leftBest = new Map<number, { pressCount: number; freeAssignment: number[] }>();\n   267→  for (const [key, entries] of leftByKey) {\n   268→    let best = entries[0];\n   269→    for (let i = 1; i < entries.length; i++) {\n   270→      const e = entries[i];\n   271→      if (e.pressCount < best.pressCount || (e.pressCount === best.pressCount && lexLessFree(e.freeAssignment, best.freeAssignment, leftFree))) {\n   272→        best = e;\n   273→      }\n   274→    }\n   275→    leftBest.set(key, best);\n   276→  }\n   277→\n   278→  // Also for right, group by pivotKey\n   279→  const rightByKey = new Map<number, { pressCount: number; freeAssignment: number[] }[]>();\n   280→  for (const rr of rightResults) {\n   281→    if (!rightByKey.has(rr.pivotKey)) rightByKey.set(rr.pivotKey, []);\n   282→    rightByKey.get(rr.pivotKey)!.push({ pressCount: rr.pressCount, freeAssignment: rr.freeAssignment });\n   283→  }\n   284→\n   285→  const rightBest = new Map<number, { pressCount: number; freeAssignment: number[] }>();\n   286→  for (const [key, entries] of rightByKey) {\n   287→    let best = entries[0];\n   288→    for (let i = 1; i < entries.length; i++) {\n   289→      const e = entries[i];\n   290→      if (e.pressCount < best.pressCount || (e.pressCount === best.pressCount && lexLessFree(e.freeAssignment, best.freeAssignment, rightFree))) {\n   291→        best = e;\n   292→      }\n   293→    }\n   294→    rightBest.set(key, best);\n   295→  }\n   296→\n   297→  // Now try all combinations of left and right\n   298→  let bestResult: number[] | null = null;\n   299→  let bestTotal = Infinity;\n   300→\n   301→  for (const [leftKey, leftVal] of leftBest) {\n   302→    for (const [rightKey, rightVal] of rightBest) {\n   303→      const pivotValues = leftKey ^ rightKey;\n   304→      // Reconstruct: pivot values need to match the RHS constraint\n   305→      // Actually: pivot[r] = aug[r][numVars] XOR (leftContrib from left) XOR (leftContrib from right)\n   306→      // But our keys already encode the contribution to pivot rows from each half.\n   307→      // Wait, let me reconsider.\n   308→      //\n   309→      // For left half: leftKey[r] = XOR of aug[r][j]*freeAssign[j] for j in leftFree where j > pivotCol[r]\n   310→      // For right half: rightKey[r] = same for rightFree\n   311→      // pivot[r] = aug[r][numVars] XOR leftKey[r] XOR rightKey[r]\n   312→      // So the actual pivot value is determined.\n   313→\n   314→      const pivotPressCount = popcount(pivotValues);\n   315→      const totalPresses = leftVal.pressCount + rightVal.pressCount + pivotPressCount;\n   316→\n   317→      if (totalPresses > bestTotal) continue;\n   318→      if (totalPresses === bestTotal && bestResult !== null) {\n   319→        const candidate = buildFullAssignment(\n   320→          leftVal.freeAssignment, rightVal.freeAssignment, pivotValues,\n   321→          rank, pivotCol, numVars,\n   322→        );\n   323→        if (!lexLess(candidate, bestResult)) continue;\n   324→        bestResult = candidate;\n   325→      } else {\n   326→        bestResult = buildFullAssignment(\n   327→          leftVal.freeAssignment, rightVal.freeAssignment, pivotValues,\n   328→          rank, pivotCol, numVars,\n   329→        );\n   330→        bestTotal = totalPresses;\n   331→      }\n   332→    }\n   333→  }\n   334→\n   335→  return bestResult;\n   336→}\n   337→\n   338→function buildFullAssignment(\n   339→  leftAssign: number[],\n   340→  rightAssign: number[],\n   341→  pivotValues: number,\n   342→  rank: number,\n   343→  pivotCol: number[],\n   344→  numVars: number,\n   345→): number[] {\n   346→  const assign = new Array(numVars).fill(0);\n   347→  for (let i = 0; i < numVars; i++) {\n   348→    if (leftAssign[i]) assign[i] = 1;\n   349→    if (rightAssign[i]) assign[i] = 1;\n   350→  }\n   351→  for (let r = 0; r < rank; r++) {\n   352→    assign[pivotCol[r]] = (pivotValues >> r) & 1;\n   353→  }\n   354→  const result: number[] = [];\n   355→  for (let i = 0; i < numVars; i++) {\n   356→    if (assign[i]) result.push(i);\n   357→  }\n   358→  return result;\n   359→}\n   360→\n   361→function lexLessFree(a: number[], b: number[], vars: number[]): boolean {\n   362→  for (const v of vars) {\n   363→    if (a[v] < b[v]) return true;\n   364→    if (a[v] > b[v]) return false;\n   365→  }\n   366→  return false;\n   367→}\n   368→\n   369→function popcount(n: number): number {\n   370→  let count = 0;\n   371→  while (n) {\n   372→    count += n & 1;\n   373→    n >>= 1;\n   374→  }\n   375→  return count;\n   376→}\n   377→\n   378→// --- GF(p) helpers ---\n   379→\n   380→function modInverse(a: number, p: number): number {\n   381→  // Extended Euclidean algorithm\n   382→  let old_r = a, r = p;\n   383→  let old_s = 1, s = 0;\n   384→  while (r !== 0) {\n   385→    const q = Math.floor(old_r / r);\n   386→    [old_r, r] = [r, old_r - q * r];\n   387→    [old_s, s] = [s, old_s - q * s];\n   388→  }\n   389→  return ((old_s % p) + p) % p;\n   390→}\n   391→\n   392→function mod(a: number, p: number): number {\n   393→  return ((a % p) + p) % p;\n   394→}\n   395→\n   396→function buildGFpMatrix(\n   397→  lights: number[],\n   398→  buttons: number[][],\n   399→  modulus: number,\n   400→): { aug: number[][]; numVars: number; numEqs: number } {\n   401→  const numVars = buttons.length;\n   402→  const numEqs = lights.length;\n   403→  const aug: number[][] = [];\n   404→  for (let eq = 0; eq < numEqs; eq++) {\n   405→    const row = new Array(numVars + 1).fill(0);\n   406→    for (let btn = 0; btn < numVars; btn++) {\n   407→      if (buttons[btn].includes(eq)) {\n   408→        row[btn] = 1;\n   409→      }\n   410→    }\n   411→    row[numVars] = mod(lights[eq], modulus);\n   412→    aug.push(row);\n   413→  }\n   414→  return { aug, numVars, numEqs };\n   415→}\n   416→\n   417→function rrefGFp(\n   418→  aug: number[][],\n   419→  numVars: number,\n   420→  numEqs: number,\n   421→  p: number,\n   422→): { pivotCol: number[]; pivotRow: number[]; rank: number } {\n   423→  const pivotCol = new Array(numEqs).fill(-1);\n   424→  const pivotRow = new Array(numVars).fill(-1);\n   425→  let rank = 0;\n   426→  let curRow = 0;\n   427→\n   428→  for (let col = 0; col < numVars && curRow < numEqs; col++) {\n   429→    // Find pivot\n   430→    let found = -1;\n   431→    for (let row = curRow; row < numEqs; row++) {\n   432→      if (aug[row][col] !== 0) {\n   433→        found = row;\n   434→        break;\n   435→      }\n   436→    }\n   437→    if (found === -1) continue;\n   438→\n   439→    // Swap\n   440→    [aug[curRow], aug[found]] = [aug[found], aug[curRow]];\n   441→\n   442→    // Scale pivot row\n   443→    const inv = modInverse(aug[curRow][col], p);\n   444→    for (let j = 0; j <= numVars; j++) {\n   445→      aug[curRow][j] = mod(aug[curRow][j] * inv, p);\n   446→    }\n   447→\n   448→    pivotCol[curRow] = col;\n   449→    pivotRow[col] = curRow;\n   450→    rank++;\n   451→\n   452→    // Eliminate\n   453→    for (let row = 0; row < numEqs; row++) {\n   454→      if (row !== curRow && aug[row][col] !== 0) {\n   455→        const factor = aug[row][col];\n   456→        for (let j = 0; j <= numVars; j++) {\n   457→          aug[row][j] = mod(aug[row][j] - factor * aug[curRow][j], p);\n   458→        }\n   459→      }\n   460→    }\n   461→    curRow++;\n   462→  }\n   463→\n   464→  return { pivotCol, pivotRow, rank };\n   465→}\n   466→\n   467→/**\n   468→ * Solve counter puzzle using GF(p) Gaussian elimination.\n   469→ */\n   470→export function solveCounter(\n   471→  lights: number[],\n   472→  buttons: number[][],\n   473→  modulus: number,\n   474→): number[] | null {\n   475→  const numVars = buttons.length;\n   476→  const numEqs = lights.length;\n   477→\n   478→  if (numEqs === 0 && numVars === 0) return [];\n   479→  if (numEqs === 0) return new Array(numVars).fill(0);\n   480→  if (numVars === 0) {\n   481→    return lights.some((l) => l !== 0) ? null : [];\n   482→  }\n   483→\n   484→  const { aug, numVars: nv, numEqs: ne } = buildGFpMatrix(lights, buttons, modulus);\n   485→  const { pivotCol, pivotRow, rank } = rrefGFp(aug, nv, ne, modulus);\n   486→\n   487→  // Check consistency\n   488→  for (let row = rank; row < ne; row++) {\n   489→    if (aug[row][nv] !== 0) return null;\n   490→  }\n   491→\n   492→  // Identify free variables\n   493→  const freeVars: number[] = [];\n   494→  for (let col = 0; col < nv; col++) {\n   495→    if (pivotRow[col] === -1) freeVars.push(col);\n   496→  }\n   497→\n   498→  const numFree = freeVars.length;\n   499→\n   500→  if (numFree <= 16) {\n   501→    return solveCounterEnumerate(aug, nv, rank, pivotCol, freeVars, modulus);\n   502→  }\n   503→\n   504→  // For larger free variable counts, use meet-in-the-middle\n   505→  return solveCounterMITM(aug, nv, rank, pivotCol, freeVars, modulus);\n   506→}\n   507→\n   508→function solveCounterEnumerate(\n   509→  aug: number[][],\n   510→  numVars: number,\n   511→  rank: number,\n   512→  pivotCol: number[],\n   513→  freeVars: number[],\n   514→  modulus: number,\n   515→): number[] | null {\n   516→  const numFree = freeVars.length;\n   517→  let best: number[] | null = null;\n   518→  let bestTotal = Infinity;\n   519→\n   520→  const total