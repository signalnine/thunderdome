space/src/index.ts","content":"export interface Machine {\n  target: boolean[];\n  buttons: number[][];\n}\n\n// --- Lex comparison ---\nfunction lexLess(a: number[], b: number[]): boolean {\n  for (let i = 0; i < Math.min(a.length, b.length); i++) {\n    if (a[i] < b[i]) return true;\n    if (a[i] > b[i]) return false;\n  }\n  return a.length < b.length;\n}\n\n// --- GF(2) Toggle Solver ---\n\nexport function solveToggle(machine: Machine): number[] | null {\n  const numVars = machine.buttons.length;\n  const numEqs = machine.target.length;\n\n  if (numEqs === 0) return [];\n  if (numVars === 0) {\n    return machine.target.some((t) => t) ? null : [];\n  }\n\n  // Build augmented matrix over GF(2)\n  // aug[eq][btn] = 1 if button btn toggles light eq; aug[eq][numVars] = target[eq]\n  const aug: number[][] = [];\n  for (let eq = 0; eq < numEqs; eq++) {\n    const row = new Array(numVars + 1).fill(0);\n    row[numVars] = machine.target[eq] ? 1 : 0;\n    aug.push(row);\n  }\n  for (let btn = 0; btn < numVars; btn++) {\n    for (const light of machine.buttons[btn]) {\n      aug[light][btn] = 1;\n    }\n  }\n\n  // RREF over GF(2)\n  const pivotCol = new Int32Array(numEqs).fill(-1);\n  const pivotRowMap = new Int32Array(numVars).fill(-1);\n  let rank = 0;\n  let curRow = 0;\n\n  for (let col = 0; col < numVars && curRow < numEqs; col++) {\n    let found = -1;\n    for (let row = curRow; row < numEqs; row++) {\n      if (aug[row][col] === 1) {\n        found = row;\n        break;\n      }\n    }\n    if (found === -1) continue;\n\n    [aug[curRow], aug[found]] = [aug[found], aug[curRow]];\n    pivotCol[curRow] = col;\n    pivotRowMap[col] = curRow;\n    rank++;\n\n    for (let row = 0; row < numEqs; row++) {\n      if (row !== curRow && aug[row][col] === 1) {\n        for (let j = 0; j <= numVars; j++) {\n          aug[row][j] ^= aug[curRow][j];\n        }\n      }\n    }\n    curRow++;\n  }\n\n  // Check consistency\n  for (let row = rank; row < numEqs; row++) {\n    if