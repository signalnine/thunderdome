= 0) return [];\n   366→  if (numEqs === 0) return new Array(numVars).fill(0);\n   367→  if (numVars === 0) {\n   368→    return lights.some((l) => l !== 0) ? null : [];\n   369→  }\n   370→\n   371→  // Build augmented matrix over GF(p)\n   372→  const aug: number[][] = [];\n   373→  for (let eq = 0; eq < numEqs; eq++) {\n   374→    aug.push(new Array(numVars + 1).fill(0));\n   375→  }\n   376→  for (let btn = 0; btn < numVars; btn++) {\n   377→    for (const counter of buttons[btn]) {\n   378→      aug[counter][btn] = mod(aug[counter][btn] + 1, modulus);\n   379→    }\n   380→  }\n   381→  for (let eq = 0; eq < numEqs; eq++) {\n   382→    aug[eq][numVars] = mod(lights[eq], modulus);\n   383→  }\n   384→\n   385→  // RREF over GF(p)\n   386→  const pivotCol = new Int32Array(numEqs).fill(-1);\n   387→  const pivotRowMap = new Int32Array(numVars).fill(-1);\n   388→  let rank = 0;\n   389→  let curRow = 0;\n   390→\n   391→  for (let col = 0; col < numVars && curRow < numEqs; col++) {\n   392→    let found = -1;\n   393→    for (let row = curRow; row < numEqs; row++) {\n   394→      if (aug[row][col] !== 0) {\n   395→        found = row;\n   396→        break;\n   397→      }\n   398→    }\n   399→    if (found === -1) continue;\n   400→\n   401→    [aug[curRow], aug[found]] = [aug[found], aug[curRow]];\n   402→\n   403→    const inv = modInverse(aug[curRow][col], modulus);\n   404→    for (let j = 0; j <= numVars; j++) {\n   405→      aug[curRow][j] = mod(aug[curRow][j] * inv, modulus);\n   406→    }\n   407→\n   408→    pivotCol[curRow] = col;\n   409→    pivotRowMap[col] = curRow;\n   410→    rank++;\n   411→\n   412→    for (let row = 0; row < numEqs; row++) {\n   413→      if (row !== curRow && aug[row][col] !== 0) {\n   414→        const factor = aug[row][col];\n   415→        for (let j = 0; j <= numVars; j++) {\n   416→          aug[row][j] = mod(aug[row][j] - factor * aug[curRow][j], modulus);\n   417→        }\n   418→      }\n   419→    }\n   420→    curRow