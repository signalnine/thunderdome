+import { describe, it, expect } from "vitest";
+import { solveToggle, solveCounter, Machine } from "./index.js";
+
+// Verification helper for toggle
+function verifyToggle(machine: Machine, result: number[] | null): boolean {
+  if (result === null) return true; // can't easily verify unsolvability
+  const state = new Array(machine.target.length).fill(false);
+  for (const btn of result) {
+    for (const light of machine.buttons[btn]) {
+      state[light] = !state[light];
+    }
+  }
+  return state.every((s, i) => s === machine.target[i]);
+}
+
+// Verification helper for counter
+function verifyCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+  result: number[] | null,
+): boolean {
+  if (result === null) return true;
+  const state = new Array(lights.length).fill(0);
+  for (let btn = 0; btn < result.length; btn++) {
+    for (const counter of buttons[btn]) {
+      state[counter] = (state[counter] + result[btn]) % modulus;
+    }
+  }
+  return state.every((s, i) => s === lights[i]);
+}
+
+describe("solveToggle", () => {
+  it("solves the example from TASK.md (returns null)", () => {
+    const machine = {
+      target: [true, true, false, true],
+      buttons: [[0, 1], [1, 2, 3], [0, 3]],
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it("solves a simple solvable case", () => {
+    const machine = {
+      target: [true, false, true],
+      buttons: [[0], [2]],
+    };
+    const result = solveToggle(machine);
+    expect(result).toEqual([0, 1]);
+    expect(verifyToggle(machine, result)).toBe(true);
+  });
+
+  it("returns empty array when target is all off", () => {
+    const machine = {
+      target: [false, false, false],
+      buttons: [[0], [1]],
+    };
+    expect(solveToggle(machine)).toEqual([]);
+  });
+
+  it("prefers fewer button presses", () => {
+    const machine = {
+      target: [true, true],
+      buttons: [[0, 1], [0], [1]],
+    };
+    const result = solveToggle(machine);
+    expect(result).toEqual([0]);
+    expect(verifyToggle(machine, result)).toBe(true);
+  });
+
+  it("prefers lexicographically smallest on tie", () => {
+    const machine = {
+      target: [true, true],
+      buttons: [[0], [1], [0, 1]],
+    };
+    const result = solveToggle(machine);
+    expect(result).toEqual([2]);
+    expect(verifyToggle(machine, result)).toBe(true);
+  });
+
+  it("handles button that toggles no lights", () => {
+    const machine = {
+      target: [true],
+      buttons: [[], [0]],
+    };
+    expect(solveToggle(machine)).toEqual([1]);
+  });
+
+  it("handles more buttons than lights", () => {
+    const machine = {
+      target: [true],
+      buttons: [[0], [0], [0]],
+    };
+    const result = solveToggle(machine);
+    expect(result).toEqual([0]);
+    expect(verifyToggle(machine, result)).toBe(true);
+  });
+
+  it("returns null for truly unsolvable case", () => {
+    const machine = {
+      target: [true, false],
+      buttons: [[0, 1]],
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it("handles empty target", () => {
+    const machine = {
+      target: [] as boolean[],
+      buttons: [] as number[][],
+    };
+    expect(solveToggle(machine)).toEqual([]);
+  });
+
+  it("solves identity case - each button toggles one unique light", () => {
+    // 5 lights, 5 buttons, button i toggles light i, target all on
+    const machine = {
+      target: [true, true, true, true, true],
+      buttons: [[0], [1], [2], [3], [4]],
+    };
+    expect(solveToggle(machine)).toEqual([0, 1, 2, 3, 4]);
+  });
+
+  it("handles no buttons with non-zero target", () => {
+    const machine = {
+      target: [true],
+      buttons: [] as number[][],
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it("handles no buttons with zero target", () => {
+    const machine = {
+      target: [false, false],
+      buttons: [] as number[][],
+    };
+    expect(solveToggle(machine)).toEqual([]);
+  });
+
+  it("solves larger case with many free variables", () => {
+    // 10 lights, 20 buttons (identity-like with redundancy)
+    // Buttons 0-9 each toggle light i, buttons 10-19 each toggle light (i-10)
+    // Target: lights 0,2,4,6,8 on, rest off
+    const target = Array.from({ length: 10 }, (_, i) => i % 2 === 0);
