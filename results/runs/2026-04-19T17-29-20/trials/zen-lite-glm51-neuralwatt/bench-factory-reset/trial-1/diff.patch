umFree);\n   480→\n   481→  for (let enc = 0; enc < totalEnum; enc++) {\n   482→    let tmp = enc;\n   483→    let freeSum = 0;\n   484→    for (let i = 0; i < numFree; i++) {\n   485→      freeAssign[i] = tmp % modulus;\n   486→      freeSum += freeAssign[i];\n   487→      tmp = Math.floor(tmp / modulus);\n   488→    }\n   489→\n   490→    if (freeSum > bestTotal) continue;\n   491→\n   492→    // Compute pivot values\n   493→    let pivotSum = 0;\n   494→    const pivotVals = new Int32Array(rank);\n   495→    for (let r = 0; r < rank; r++) {\n   496→      let val = rhs[r];\n   497→      for (let j = 0; j < numFree; j++) {\n   498→        val = mod(val - coeff[r * numFree + j] * freeAssign[j], modulus);\n   499→      }\n   500→      pivotVals[r] = val;\n   501→      pivotSum += val;\n   502→    }\n   503→\n   504→    const total = freeSum + pivotSum;\n   505→    if (total > bestTotal) continue;\n   506→    if (total === bestTotal && best !== null) {\n   507→      const assignment = buildCounterAssignment(freeAssign, pivotVals, numVars, freeVars, pCols, rank);\n   508→      if (!lexLessArr(assignment, best)) continue;\n   509→      best = assignment;\n   510→    } else {\n   511→      best = buildCounterAssignment(freeAssign, pivotVals, numVars, freeVars, pCols, rank);\n   512→      bestTotal = total;\n   513→    }\n   514→  }\n   515→\n   516→  return best;\n   517→}\n   518→\n   519→function buildCounterAssignment(\n   520→  freeAssign: Int32Array,\n   521→  pivotVals: Int32Array,\n   522→  numVars: number,\n   523→  freeVars: number[],\n   524→  pCols: number[],\n   525→  rank: number,\n   526→): number[] {\n   527→  const result = new Array(numVars).fill(0);\n   528→  for (let i = 0; i < freeAssign.length; i++) {\n   529→    result[freeVars[i]] = freeAssign[i];\n   530→  }\n   531→  for (let r = 0; r < rank; r++) {\n   532→    result[pCols[r]] = pivotVals[r];\n   533→  }\n   534→  return result;\n   535→}\n   536→\n   537→function lexLessArr(a: number[], b: numb