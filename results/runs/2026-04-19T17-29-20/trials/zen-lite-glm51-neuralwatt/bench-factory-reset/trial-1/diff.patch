], 3 buttons all toggle light 0\n    // Pressing any one button works; fewest presses = 1; lex smallest = [0]\n    const machine = {\n      target: [true],\n      buttons: [[0], [0], [0]],\n    };\n    expect(solveToggle(machine)).toEqual([0]);\n  });\n\n  it(\"returns null when no solution exists\", () => {\n    const _machine = {\n      target: [true],\n      buttons: [[0], [0]], // Both toggle light 0; pressing both gives false\n    };\n    // Actually pressing just button 0 gives true. So this is solvable.\n    // Let me fix: target [true], only button toggles light 0 twice equivalent\n    const machine2 = {\n      target: [true, true],\n      buttons: [[0, 1]], // Pressing it gives [true,true] - solvable\n    };\n    expect(solveToggle(machine2)).toEqual([0]);\n\n    // Truly unsolvable: 2 lights, target [true, false], buttons only toggle both together\n    const machine3 = {\n      target: [true, false],\n      buttons: [[0, 1]],\n    };\n    expect(solveToggle(machine3)).toBeNull();\n  });\n\n  it(\"handles empty target\", () => {\n    const machine = {\n      target: [] as boolean[],\n      buttons: [] as number[][],\n    };\n    expect(solveToggle(machine)).toEqual([]);\n  });\n});\n\ndescribe(\"solveCounter\", () => {\n  it(\"solves a simple case with modulus 3\", () => {\n    // 2 counters, target [2, 1], modulus 3\n    // Button 0: [0], Button 1: [1]\n    // Press button 0 twice, button 1 once\n    const result = solveCounter([2, 1], [[0], [1]], 3);\n    expect(result).toEqual([2, 1]);\n  });\n\n  it(\"returns null when no solution exists\", () => {\n    // 1 counter, target [1], modulus 2\n    // Button 0: [0], Button 1: [0]\n    // b0 + b1 = 1 (mod 2). Solutions: (1,0) and (0,1). Min total = 1.\n    const result = solveCounter([1], [[0], [0]], 2);\n    expect(result).toEqual([0, 1]); // lex smallest with total 1\n  });\n\n  it(\"returns empty array when target is all zeros\", () => {\n    const result = solveCounter([0, 0], [[0], [1]], 5);\n    expect(result).toEqual([0, 0]);\n  });\n\n  it(\"handles wrapping\", () => {\n    // 1 counter, target [0], modulus 5\n    // Button 0: [0] - pressing 5 times = 0 but max is 4. Pressing 0 times = 0.\n    const result = solveCounter([0], [[0]], 5);\n    expect(result).toEqual([0]);\n  });\n\n  it(\"prefers minimum total presses\", () => {\n    // 1 counter, target [2], modulus 5\n    // Button 0: [0], Button 1: [0]\n    // b0 + b1 = 2 (mod 5). Options: (2,0) total=2, (0,2) total=2, (1,1) total=2\n    // All tied on total, lex smallest is (0,2)... wait (1,1) < (0,2)? No: [1,1] > [0,2] because 1 > 0 at index 0.\n    // Actually lex compare: [0,2] vs [1,1] - 0 < 1 so [0,2] is lex smallest.\n    // But (2,0) total=2: [2,0] vs [0,2] - 0 < 2 so [0,2] is lex smallest.\n    const result = solveCounter([2], [[0], [0]], 5);\n    expect(result).toEqual([0, 2]);\n  });\n\n  it(\"handles modulus 2 (same as toggle but different API)\", () => {\n    // 2 counters, target [1, 1], modulus 2\n    // Button 0: [0,1], Button 1: [0]\n    // b0 + b1 = 1 (mod 2) for counter 0, b0 = 1 (mod 2) for counter 1\n    // From counter 1: b0=1. From counter 0: 1 + b1 = 1 => b1=0.\n    const result = solveCounter([1, 1], [[0, 1], [0]], 2);\n    expect(result).toEqual([1, 0]);\n  });\n\n  it(\"returns null for truly unsolvable counter puzzle\", () => {\n    // 2 counters, target [1, 0], modulus 2\n    // Button 0: [0, 1] (always increments both together)\n    // b0 = 1 (mod 2) for counter 0, b0 = 0 (mod 2) for counter 1 => impossible\n    const result = solveCounter([1, 0], [[0, 1]], 2);\n    expect(result).toBeNull();\n  });\n\n  it(\"handles larger modulus\", () => {\n    // 1 counter, target [3], modulus 7\n    // Button 0: [0]\n    const result = solveCounter([3], [[0]], 7);\n    expect(result).toEqual([3]);\n  });\n\n  it(\"handles empty target\", () => {\n    const result = solveCounter([], [], 5);\n    expect(result).toEqual([]);\n  });\n});\n"}}
