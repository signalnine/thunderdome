ew Map<number, { pressCount: number; freeAssignment: number[] }[]>();\n  for (const rr of rightResults) {\n    if (!rightByKey.has(rr.pivotKey)) rightByKey.set(rr.pivotKey, []);\n    rightByKey.get(rr.pivotKey)!.push({ pressCount: rr.pressCount, freeAssignment: rr.freeAssignment });\n  }\n\n  const rightBest = new Map<number, { pressCount: number; freeAssignment: number[] }>();\n  for (const [key, entries] of rightByKey) {\n    let best = entries[0];\n    for (let i = 1; i < entries.length; i++) {\n      const e = entries[i];\n      if (e.pressCount < best.pressCount || (e.pressCount === best.pressCount && lexLessFree(e.freeAssignment, best.freeAssignment, rightFree))) {\n        best = e;\n      }\n    }\n    rightBest.set(key, best);\n  }\n\n  // Now try all combinations of left and right\n  let bestResult: number[] | null = null;\n  let bestTotal = Infinity;\n\n  for (const [leftKey, leftVal] of leftBest) {\n    for (const [rightKey, rightVal] of rightBest) {\n      const pivotValues = leftKey ^ rightKey;\n      // Reconstruct: pivot values need to match the RHS constraint\n      // Actually: pivot[r] = aug[r][numVars] XOR (leftContrib from left) XOR (leftContrib from right)\n      // But our keys already encode the contribution to pivot rows from each half.\n      // Wait, let me reconsider.\n      //\n      // For left half: leftKey[r] = XOR of aug[r][j]*freeAssign[j] for j in leftFree where j > pivotCol[r]\n      // For right half: rightKey[r] = same for rightFree\n      // pivot[r] = aug[r][numVars] XOR leftKey[r] XOR rightKey[r]\n      // So the actual pivot value is determined.\n\n      const pivotPressCount = popcount(pivotValues);\n      const totalPresses = leftVal.pressCount + rightVal.pressCount + pivotPressCount;\n\n      if (totalPresses > bestTotal) continue;\n      if (totalPresses === bestTotal && bestResult !== null) {\n        const candidate = buildFullAssignment(\n          leftVal.freeAssignment, rightVal.freeAssignment, pivotValues,\n       