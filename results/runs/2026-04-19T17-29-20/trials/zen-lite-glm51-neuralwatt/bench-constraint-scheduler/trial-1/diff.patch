mplicated. Let me just implement the backtracking with skip and add a time limit. If the search takes too long, return the best solution found so far.\n\nFor practical inputs (N <= 20 or so), the backtracking with pruning should be fast enough. For larger inputs, the greedy approach will be used.\n\nLet me implement this hybrid approach:\n\n```typescript\nfunction schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {\n  const gap = options.gap ?? 15;\n  const eventMap = new Map(events.map(e => [e.id, e]));\n  \n  // Detect cycles\n  detectCycle(events, eventMap);\n  \n  // Topological sort with heuristic ordering\n  const topoOrder = topologicalSortWithHeuristics(events, eventMap, rooms);\n  \n  // Precompute valid rooms\n  const validRoomsMap = new Map<string, Room[]>();\n  for (const event of events) {\n    const attendees = event.attendees ?? 1;\n    const valid = rooms.filter(r => r.capacity >= attendees);\n    validRoomsMap.set(event.id, valid);\n  }\n  \n  // Try backtracking with time limit\n  const startTime = Date.now();\n  const TIME_LIMIT = 5000; // 5 seconds\n  \n  const best = { count: 0, assignments: new Map<string, Placement>() };\n  \n  function solve(index: number, assignments: Map<string, Placement>, roomSchedule: Map<string, Placement[]>, scheduledCount: number): boolean {\n    if (Date.now() - startTime > TIME_LIMIT) return false;\n    \n    if (index >= topoOrder.length) {\n      if (scheduledCount > best.count) {\n        best.count = scheduledCount;\n        best.assignments = new Map(assignments);\n      }\n      return best.count === events.length;\n    }\n    \n    // Pruning\n    const remaining = topoOrder.length - index;\n    if (scheduledCount + remaining <= best.count) return false;\n    \n    const event = topoOrder[index];\n    \n    // Check prerequisites\n    let earliestStart = options.startTime;\n    let prereqMet = true;\n    if (event.prerequisites) {\n      for (const prereqId of event.prerequisi