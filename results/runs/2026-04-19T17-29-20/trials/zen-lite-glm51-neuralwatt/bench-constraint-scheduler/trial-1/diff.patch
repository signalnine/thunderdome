tring, Event>): void {\n  const WHITE = 0, GRAY = 1, BLACK = 2;\n  const color = new Map<string, number>();\n  \n  for (const event of events) {\n    color.set(event.id, WHITE);\n  }\n  \n  function dfs(id: string): void {\n    const c = color.get(id);\n    if (c === BLACK) return;\n    if (c === GRAY) {\n      throw new CyclicDependencyError(`Cyclic dependency detected involving event ${id}`);\n    }\n    \n    color.set(id, GRAY);\n    const event = eventMap.get(id);\n    if (event?.prerequisites) {\n      for (const prereqId of event.prerequisites) {\n        if (color.has(prereqId)) { // Only check events in our list\n          dfs(prereqId);\n        }\n      }\n    }\n    color.set(id, BLACK);\n  }\n  \n  for (const event of events) {\n    if (color.get(event.id) === WHITE) {\n      dfs(event.id);\n    }\n  }\n}\n\nfunction topologicalSort(events: Event[], eventMap: Map<string, Event>): Event[] {\n  const visited = new Set<string>();\n  const result: Event[] = [];\n  \n  function visit(event: Event): void {\n    if (visited.has(event.id)) return;\n    visited.add(event.id);\n    \n    if (event.prerequisites) {\n      for (const prereqId of event.prerequisites) {\n        const prereq = eventMap.get(prereqId);\n        if (prereq) {\n          visit(prereq);\n        }\n      }\n    }\n    \n    result.push(event);\n  }\n  \n  for (const event of events) {\n    visit(event);\n  }\n  \n  return result;\n}\n\nfunction findEarliestSlot(\n  roomAssignments: Assignment[],\n  earliestStart: number,\n  duration: number,\n  gap: number,\n  windowEnd: number\n): number | null {\n  // Sort assignments by start time\n  const sorted = [...roomAssignments].sort((a, b) => a.startTime - b.startTime);\n  \n  // Try to fit before the first assignment\n  let candidateStart = earliestStart;\n  \n  for (const assignment of sorted) {\n    // Check if we can fit before this assignment\n    if (candidateStart + duration <= assignment.startTime - gap) {\n      // Wait, the gap is bet