s\nexport interface Event {\n  id: string;\n  name: string;\n  duration: number;\n  attendees?: number;\n  prerequisites?: string[];\n  preferredRoom?: string;\n}\n\nexport interface Room {\n  id: string;\n  name: string;\n  capacity: number;\n}\n\nexport interface ScheduleOptions {\n  startTime: number;\n  endTime: number;\n  gap?: number;\n}\n\nexport interface Assignment {\n  eventId: string;\n  roomId: string;\n  startTime: number;\n  endTime: number;\n}\n\nexport interface ScheduleResult {\n  assignments: Assignment[];\n  unscheduled: string[];\n}\n```\n\n```typescript\n// src/scheduler.ts\nimport type { Event, Room, ScheduleOptions, Assignment, ScheduleResult } from './types.js';\n\nexport function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {\n  if (events.length === 0) {\n    return { assignments: [], unscheduled: [] };\n  }\n  \n  const gap = options.gap ?? 15;\n  const eventMap = new Map(events.map(e => [e.id, e]));\n  \n  // 1. Detect cycles and compute topological order\n  const topoOrder = topologicalSort(events, eventMap);\n  \n  // 2. Backtracking solver\n  const roomSchedules = new Map<string, Assignment[]>();\n  for (const room of rooms) {\n    roomSchedules.set(room.id, []);\n  }\n  \n  const assignments = new Map<string, Assignment>();\n  let bestResult: ScheduleResult = {\n    assignments: [],\n    unscheduled: [...topoOrder]\n  };\n  \n  const MAX_ITERATIONS = 500_000;\n  let iterations = 0;\n  \n  function solve(index: number): void {\n    if (iterations >= MAX_ITERATIONS) return;\n    iterations++;\n    \n    // All events processed\n    if (index === topoOrder.length) {\n      if (assignments.size > bestResult.assignments.length) {\n        bestResult = {\n          assignments: [...assignments.values()],\n          unscheduled: topoOrder.filter(id => !assignments.has(id))\n        };\n      }\n      return;\n    }\n    \n    // Pruning: can't beat the best even if we schedule all remaining\n    const remaining = topoOrder.length - index;\n    if (assignments.size + remaining <= bestResult.assignments.length) {\n      return;\n    }\n    \n    const eventId = topoOrder[index];\n    const event = eventMap.get(eventId)!;\n    \n    // Check prerequisites\n    let minStart = options.startTime;\n    if (event.prerequisites && event.prerequisites.length > 0) {\n      const allPrereqsScheduled = event.prerequisites.every(id => assignments.has(id));\n      if (!allPrereqsScheduled) {\n        // Can't schedule this event, skip it\n        solve(index + 1);\n        return;\n      }\n      for (const prereqId of event.prerequisites) {\n        const prereqAssignment = assignments.get(prereqId)!;\n        minStart = Math.max(minStart, prereqAssignment.endTime + gap);\n      }\n    }\n    \n    // Check if event can fit in time window at all\n    if (minStart + event.duration > options.endTime) {\n      solve(index + 1);\n      return;\n    }\n    \n    // Find compatible rooms (capacity check)\n    const compatibleRooms = rooms.filter(r => r.capacity >= (event.attendees ?? 1));\n    \n    // Sort rooms: preferred room first, then by capacity (smallest first)\n    compatibleRooms.sort((a, b) => {\n      if (a.id === event.preferredRoom && b.id !== event.preferredRoom) return -1;\n      if (b.id === event.preferredRoom && a.id !== event.preferredRoom) return 1;\n      return a.capacity - b.capacity;\n    });\n    \n    // Try scheduling in each room\n    for (const room of compatibleRooms) {\n      if (iterations >= MAX_ITERATIONS) return;\n      \n      const schedule = roomSchedules.get(room.id)!;\n      const slotStart = findEarliestSlot(schedule, minStart, event.duration, gap, options.startTime, options.endTime);\n      \n      if (slotStart !== null) {\n        const assignment: Assignment = {\n          eventId: event.id,\n          roomId: room.id,\n          startTime: slotStart,\n          endTime: slotStart + event.duration\n        };\n        \n        assignments