 duration: 60, attendees: 3 },\n    ];\n    const result = schedule(events, [smallRoom], defaultOptions);\n    expect(result.assignments.find(a => a.eventId === 'e1')).toBeUndefined();\n    expect(result.assignments.find(a => a.eventId === 'e2')).toBeDefined();\n    expect(result.unscheduled).toContain('e1');\n  });\n\n  it('respects the time window', () => {\n    const events: Event[] = [{ id: 'e1', name: 'Long', duration: 500 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 600 };\n    const result = schedule(events, [defaultRoom], options);\n    expect(result.assignments).toHaveLength(0);\n    expect(result.unscheduled).toContain('e1');\n  });\n\n  it('enforces prerequisite ordering with gap', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Prereq', duration: 60 },\n      { id: 'e2', name: 'Dependent', duration: 60, prerequisites: ['e1'] },\n    ];\n    const result = schedule(events, [defaultRoom], { ...defaultOptions, gap: 15 });\n    expect(result.assignments).toHaveLength(2);\n    const e1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const e2 = result.assignments.find(a => a.eventId === 'e2')!;\n    expect(e2.startTime).toBeGreaterThanOrEqual(e1.endTime + 15);\n  });\n\n  it('honors preferred room when possible', () => {\n    const roomA: Room = { id: 'roomA', name: 'Room A', capacity: 50 };\n    const roomB: Room = { id: 'roomB', name: 'Room B', capacity: 50 };\n    const events: Event[] = [\n      { id: 'e1', name: 'Event', duration: 60, preferredRoom: 'roomB' },\n    ];\n    const result = schedule(events, [roomA, roomB], defaultOptions);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0].roomId).toBe('roomB');\n  });\n\n  it('falls back from preferred room if capacity is insufficient', () => {\n    const smallRoom: Room = { id: 'small', name: 'Small', capacity: 2 };\n    const bigRoom: Room = { id: 'big', name: 'Big', capacity: 100 };\n    const events: Event[] = [\n      { id: 'e1', name: 'Event', duration: 60, attendees: 50, preferredRoom: 'small' },\n    ];\n    const result = schedule(events, [smallRoom, bigRoom], defaultOptions);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0].roomId).toBe('big');\n  });\n\n  it('throws on prerequisite cycles', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60, prerequisites: ['e2'] },\n      { id: 'e2', name: 'B', duration: 60, prerequisites: ['e1'] },\n    ];\n    expect(() => schedule(events, [defaultRoom], defaultOptions)).toThrow();\n  });\n\n  it('throws on self-referencing prerequisites', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60, prerequisites: ['e1'] },\n    ];\n    expect(() => schedule(events, [defaultRoom], defaultOptions)).toThrow();\n  });\n\n  it('uses default gap of 15 minutes', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60 },\n      { id: 'e2', name: 'B', duration: 60 },\n    ];\n    const result = schedule(events, [defaultRoom], defaultOptions);\n    const e1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const e2 = result.assignments.find(a => a.eventId === 'e2')!;\n    if (e1.roomId === e2.roomId) {\n      expect(e2.startTime).toBeGreaterThanOrEqual(e1.endTime + 15);\n    }\n  });\n\n  it('custom gap value is respected', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60 },\n      { id: 'e2', name: 'B', duration: 60 },\n    ];\n    const result = schedule(events, [defaultRoom], { ...defaultOptions, gap: 30 });\n    const e1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const e2 = result.assignments.find(a => a.eventId === 'e2')!;\n    if (e1.roomId === e2.roomId) {\n      expect(e2.startTime).toBeGreaterThanOrEqual(e1.endTime + 30);\n    }\n  });\n\n  it('defaults attendees to 1', () => {\n    const tinyRoom: Room = { id: 'tiny', name: 'Tiny', capacity: 1 };\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60 },\n    ];\n    const result = schedule(events, [tinyRoom], defaultOptions);\n    expect(result.assignments).toHaveLength(1);\n  });\n\n  it('maximizes number of events scheduled', () => {\n    // One room, 9am-5pm = 480 min, gap=15\n    // With 60-min events, max per room: floor(480 / (60+15)) = 6 (last one needs no gap after)\n    // Actually: 6*60 + 5*15 = 360 + 75 = 435 <= 480. 7*60 + 6*15 = 420+90 = 510 > 480.\n    // So max 6 events of 60 min each.\n    const events: Event[] = Array.from({ length: 10 }, (_, i) => ({\n      id: `e${i}`,\n      name: `Event ${i}`,\n      duration: 60,\n    }));\n    const result = schedule(events, [defaultRoom], { ...defaultOptions, gap: 15 });\n    expect(result.assignments.length).toBeGreaterThanOrEqual(6);\n    expect(result.unscheduled.length + result.assignments.length).toBe(10);\n  });\n\n  it('assigns events to multiple rooms', () => {\n    const roomA: Room = { id: 'roomA', name: 'Room A', capacity: 50 };\n    const roomB: Room = { id: 'roomB', name: 'Room B', capacity: 50 };\n    const events: Event[] = Array.from({ length: 12 }, (_, i) => ({\n      id: `e${i}`,\n      name: `Event ${i}`,\n      duration: 60,\n    }));\n    const result = schedule(events, [roomA, roomB], { ...defaultOptions, gap: 15 });\n    const roomIds = new Set(result.assignments.map(a => a.roomId));\n    expect(roomIds.size).toBeGreaterThanOrEqual(2);\n  });\n\n  it('handles chain of prerequisites across rooms', () => {\n    const roomA: Room = { id: 'roomA', name: 'Room A', capacity: 50 };\n    const roomB: Room = { id: 'roomB', name: 'Room B', capacity: 50 };\n    const events: Event[] = [\n      { id: 'e1', name: 'First', duration: 60 },\n      { id: 'e2', name: 'Second', duration: 60, prerequisites: ['e1'] },\n      { id: 'e3', name: 'Third', duration: 60, prerequisites: ['e2'] },\n    ];\n    const result = schedule(events, [roomA, roomB], { ...defaultOptions, gap: 15 });\n    expect(result.assignments).toHaveLength(3);\n    const e1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const e2 = result.assignments.find(a => a.eventId === 'e2')!;\n    const e3 = result.assignments.find(a => a.eventId === 'e3')!;\n    expect(e2.startTime).toBeGreaterThanOrEqual(e1.endTime + 15);\n    expect(e3.startTime).toBeGreaterThanOrEqual(e2.endTime + 15);\n  });\n\n  it('puts unschedulable events in unscheduled list', () => {\n    const tinyRoom: Room = { id: 'tiny', name: 'Tiny', capacity: 2 };\n    const events: Event[] = [\n      { id: 'e1', name: 'Big', duration: 60, attendees: 100 },\n    ];\n    const result = schedule(events, [tinyRoom], defaultOptions);\n    expect(result.unscheduled).toContain('e1');\n    expect(result.assignments).toHaveLength(0);\n  });\n\n  it('events do not overlap in the same room', () => {\n    const events: Event[] = Array.from({ length: 5 }, (_, i) => ({\n      id: `e${i}`,\n      name: `Event ${i}`,\n      duration: 60,\n    }));\n    const result = schedule(events, [defaultRoom], { ...defaultOptions, gap: 10 });\n    // Group by room and verify no overlaps\n    const byRoom = new Map<string, typeof result.assignments>();\n    for (const a of result.assignments) {\n      if (!byRoom.has(a.roomId)) byRoom.set(a.roomId, []);\n      byRoom.get(a.roomId)!.push(a);\n    }\n    for (const [, assignments] of byRoom) {\n      const sorted = [...assignments].sort((a, b) => a.startTime - b.startTime);\n      for (let i = 1; i < sorted.length; i++) {\n        expect(sorted[i].startTime).toBeGreaterThanOrEqual(sorted[i - 1].endTime + 10);\n      }\n    }\n  });\n\n  it('zero gap is allowed', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60 },\n      { id: 'e2', name: 'B', duration: 60 },\n    ];\n    const result = schedule(events, [defaultRoom], { ...defaultOptions, gap: 0 });\n    const e1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const e2 = result.assignments.find(a => a.eventId === 'e2')!;\n    if (e1.roomId === e2.roomId) {\n      expect(e2.startTime).toBeGreaterThanOrEqual(e1.endTime);\n    }\n  });\n\n  it('handles events with multiple prerequisites', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60 },\n      { id: 'e2', name: 'B', duration: 90 },\n      { id: 'e3', name: 'C', duration: 60, prerequisites: ['e1', 'e2'] },\n    ];\n    const result = schedule(events, [defaultRoom], { ...defaultOptions, gap: 15 });\n    expect(result.assignments).toHaveLength(3);\n    const e1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const e2 = result.assignments.find(a => a.eventId === 'e2')!;\n    const e3 = result.assignments.find(a => a.eventId === 'e3')!;\n    expect(e3.startTime).toBeGreaterThanOrEqual(e1.endTime + 15);\n    expect(e3.startTime).toBeGreaterThanOrEqual(e2.endTime + 15);\n  });\n\n  it('handles prerequisite to an event not in the list (ignored)', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60, prerequisites: ['nonexistent'] },\n    ];\n    // Should not throw - nonexistent prereq is simply ignored\n    const result = schedule(events, [defaultRoom], defaultOptions);\n    expect(result.assignments).toHaveLength(1);\n  });\n\n  it('handles empty events list', () => {\n    const result = schedule([], [defaultRoom], defaultOptions);\n    expect(result.assignments).toHaveLength(0);\n    expect(result.unscheduled).toHaveLength(0);\n  });\n\n  it('handles empty rooms list', () => {\n    const events: Event[] = [{ id: 'e1', name: 'A', duration: 60 }];\n    const result = schedule(events, [], defaultOptions);\n    expect(result.unscheduled).toContain('e1');\n  });\n});\n"}}],"model":"zai-org/GLM-5.1-FP8","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":22585,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6f7019fd-dc11-47d6-8838-49e206b77c4d","uuid":"a5c12caa-8578-4984-884b-120880a6bf4c"}
