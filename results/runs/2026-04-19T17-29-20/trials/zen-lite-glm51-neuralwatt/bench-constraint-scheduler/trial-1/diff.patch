@@ -0,0 +1,254 @@
+import type { Event, Room, ScheduleOptions, Assignment, ScheduleResult } from './types.js';
+
+function topologicalSort(events: Event[], eventMap: Map<string, Event>): Event[] {
+  const inDegree = new Map<string, number>();
+  const adjList = new Map<string, string[]>();
+
+  for (const event of events) {
+    inDegree.set(event.id, 0);
+    adjList.set(event.id, []);
+  }
+
+  for (const event of events) {
+    for (const prereq of event.prerequisites ?? []) {
+      if (eventMap.has(prereq)) {
+        adjList.get(prereq)!.push(event.id);
+        inDegree.set(event.id, (inDegree.get(event.id) ?? 0) + 1);
+      }
+    }
+  }
+
+  const queue: string[] = [];
+  for (const [id, degree] of inDegree) {
+    if (degree === 0) queue.push(id);
+  }
+
+  const result: Event[] = [];
+  while (queue.length > 0) {
+    const id = queue.shift()!;
+    result.push(eventMap.get(id)!);
+    for (const neighbor of adjList.get(id) ?? []) {
+      const newDegree = (inDegree.get(neighbor) ?? 1) - 1;
+      inDegree.set(neighbor, newDegree);
+      if (newDegree === 0) queue.push(neighbor);
+    }
+  }
+
+  if (result.length !== events.length) {
+    throw new Error('Prerequisite graph contains a cycle');
+  }
+
+  return result;
+}
+
+function findEarliestSlot(
+  roomAssignments: Assignment[],
+  duration: number,
+  earliestStart: number,
+  latestEnd: number,
+  gap: number,
+): number | null {
+  if (earliestStart + duration > latestEnd) return null;
+
+  if (roomAssignments.length === 0) return earliestStart;
+
+  // Try before first assignment
+  if (earliestStart + duration + gap <= roomAssignments[0].startTime) {
+    return earliestStart;
+  }
+
+  // Try between consecutive assignments
+  for (let i = 0; i < roomAssignments.length - 1; i++) {
+    const slotStart = Math.max(earliestStart, roomAssignments[i].endTime + gap);
+    if (slotStart + duration > latestEnd) break;
+    if (slotStart + duration + gap <= roomAssignments[i + 1].startTime) {
+      return slotStart;
+    }
+  }
+
+  // Try after last assignment
+  const afterLast = Math.max(earliestStart, roomAssignments[roomAssignments.length - 1].endTime + gap);
+  if (afterLast + duration <= latestEnd) return afterLast;
+
+  return null;
+}
+
+function computeEarliestFromPrereqs(
+  event: Event,
+  assignmentMap: Map<string, Assignment>,
+  gap: number,
+  windowStart: number,
+): number {
+  let earliest = windowStart;
+  for (const prereqId of event.prerequisites ?? []) {
+    const prereqAssignment = assignmentMap.get(prereqId);
+    if (prereqAssignment) {
+      earliest = Math.max(earliest, prereqAssignment.endTime + gap);
+    }
+  }
+  return earliest;
+}
+
+type RoomSortStrategy = 'preferred-then-tight' | 'tightest-fit';
+
+function getEligibleRooms(event: Event, rooms: Room[], strategy: RoomSortStrategy): Room[] {
+  const attendees = event.attendees ?? 1;
+  const eligible = rooms.filter(r => r.capacity >= attendees);
+
+  if (strategy === 'preferred-then-tight') {
+    eligible.sort((a, b) => {
+      if (a.id === event.preferredRoom && b.id !== event.preferredRoom) return -1;
+      if (b.id === event.preferredRoom && a.id !== event.preferredRoom) return 1;
+      return a.capacity - b.capacity;
+    });
+  } else {
+    eligible.sort((a, b) => a.capacity - b.capacity);
+  }
+
+  return eligible;
+}
+
+function greedyScheduleTopo(
+  sortedEvents: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  gap: number,
+  roomStrategy: RoomSortStrategy,
+): ScheduleResult {
+  const assignments: Assignment[] = [];
+  const assignmentMap = new Map<string, Assignment>();
+  const roomSchedules = new Map<string, Assignment[]>(rooms.map(r => [r.id, []]));
+  const scheduled = new Set<string>();
+  const unscheduled: string[] = [];
+
+  for (const event of sortedEvents) {
+    const prereqs = event.prerequisites ?? [];
+    if (!prereqs.every(p => scheduled.has(p))) {
+      unscheduled.push(event.id);
+      continue;
+    }
+
+    const earliestFromPrereqs = computeEarliestFromPrereqs(event, assignmentMap, gap, options.startTime);
+    const eligibleRooms = getEligibleRooms(event, rooms, roomStrategy);
+
+    let placed = false;
+    for (const room of eligibleRooms) {
+      const roomAssignments = roomSchedules.get(room.id)!;
+      const startTime = findEarliestSlot(roomAssignments, event.duration, earliestFromPrereqs, options.endTime, gap);
+
+      if (startTime !== null) {
+        const assignment: Assignment = {
+          eventId: event.id,
+          roomId: room.id,
+          startTime,
+          endTime: startTime + event.duration,
+        };
+        assignments.push(assignment);
+        assignmentMap.set(event.id, assignment);
+        roomAssignments.push(assignment);
+        roomAssignments.sort((a, b) => a.startTime - b.startTime);
+        scheduled.add(event.id);
+        placed = true;
+        break;
+      }
+    }
+
+    if (!placed) unscheduled.push(event.id);
+  }
+
+  return { assignments, unscheduled };
+}
+
+function greedyScheduleConstrained(
+  topoOrdered: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  gap: number,
+  eventMap: Map<string, Event>,
+): ScheduleResult {
+  const assignments: Assignment[] = [];
+  const assignmentMap = new Map<string, Assignment>();
+  const roomSchedules = new Map<string, Assignment[]>(rooms.map(r => [r.id, []]));
+  const scheduled = new Set<string>();
+  const unscheduled: string[] = [];
+  const remaining = new Set(topoOrdered.map(e => e.id));
+
+  while (remaining.size > 0) {
+    const ready: Event[] = [];
+    for (const eventId of remaining) {
+      const event = eventMap.get(eventId)!;
+      const prereqs = (event.prerequisites ?? []).filter(p => eventMap.has(p));
+      if (prereqs.every(p => scheduled.has(p))) {
+        ready.push(event);
+      }
+    }
+
+    if (ready.length === 0) {
+      for (const id of remaining) unscheduled.push(id);
+      break;
+    }
+
+    // Sort: fewest eligible rooms first (most constrained), then by duration descending
+    ready.sort((a, b) => {
+      const aRooms = rooms.filter(r => r.capacity >= (a.attendees ?? 1)).length;
+      const bRooms = rooms.filter(r => r.capacity >= (b.attendees ?? 1)).length;
+      if (aRooms !== bRooms) return aRooms - bRooms;
+      return b.duration - a.duration;
+    });
+
+    let scheduledAny = false;
+    for (const event of ready) {
+      const earliestFromPrereqs = computeEarliestFromPrereqs(event, assignmentMap, gap, options.startTime);
+      const eligibleRooms = getEligibleRooms(event, rooms, 'preferred-then-tight');
+
+      for (const room of eligibleRooms) {
+        const roomAssignments = roomSchedules.get(room.id)!;
+        const startTime = findEarliestSlot(roomAssignments, event.duration, earliestFromPrereqs, options.endTime, gap);
+
+        if (startTime !== null) {
+          const assignment: Assignment = {
+            eventId: event.id,
+            roomId: room.id,
+            startTime,
+            endTime: startTime + event.duration,
+          };
+          assignments.push(assignment);
+          assignmentMap.set(event.id, assignment);
+          roomAssignments.push(assignment);
+          roomAssignments.sort((a, b) => a.startTime - b.startTime);
+          scheduled.add(event.id);
+          remaining.delete(event.id);
+          scheduledAny = true;
+          break;
+        }
+      }
+
+      if (scheduledAny) break;
+    }
+
+    if (!scheduledAny) {
+      // Could not schedule any ready event; remaining events are unschedulable
+      for (const id of remaining) unscheduled.push(id);
+      break;
+    }
+  }
+
+  return { assignments, unscheduled };
+}
+
+export function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {
+  const gap = options.gap ?? 15;
+  const eventMap = new Map(events.map(e => [e.id, e]));
+
+  const topoOrder = topologicalSort(events, eventMap);
+
+  const results: ScheduleResult[] = [
+    greedyScheduleTopo(topoOrder, rooms, options, gap, 'preferred-then-tight'),
+    greedyScheduleTopo(topoOrder, rooms, options, gap, 'tightest-fit'),
+    greedyScheduleConstrained(topoOrder, rooms, options, gap, eventMap),
+  ];
+
+  return results.reduce((best, r) =>
+    r.assignments.length > best.assignments.length ? r : best,
+  );
+}
