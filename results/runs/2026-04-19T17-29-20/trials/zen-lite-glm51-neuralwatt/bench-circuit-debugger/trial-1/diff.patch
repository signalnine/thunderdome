    const genWire = genGate?.out ?? null;\n\n    // Z-gate: XOR(psWire, carry) -> zi\n    if (psWire && carry) {\n      const zGate = byKey.get(key(psWire, carry, 'XOR'));\n      if (zGate) {\n        if (zGate.out !== zi) { swapped.add(zGate.out); swapped.add(zi); }\n      } else {\n        // Carry chain broken - try to recover via the gate that outputs zi\n        recoverZGate(zi, psWire, carry, byOut, byInput, swapped);\n      }\n\n      // Propagate gate: AND(psWire, carry)\n      const propGate = byKey.get(key(psWire, carry, 'AND'));\n      const propWire = propGate?.out ?? null;\n\n      // Carry out: OR(genWire, propWire)\n      if (genWire && propWire) {\n        const cGate = byKey.get(key(genWire, propWire, 'OR'));\n        carry = cGate?.out ?? null;\n      } else {\n        // Try to recover carry chain\n        carry = recoverCarry(psWire, carry, genWire, byKey, byInput, byOut, i, N, swapped);\n      }\n    } else {\n      swapped.add(zi);\n    }\n  }\n\n  if (swapped.size === 8) return [...swapped].sort();\n  return refineWithSimulation(gates, N, swapped, byOut);\n}\n\nfunction pad(n: number): string { return String(n).padStart(2, '0'); }\n\nfunction key(a: string, b: string, op: string): string {\n  return (a < b ? a + ',' + b : b + ',' + a) + ':' + op;\n}\n\nfunction recoverZGate(\n  zi: string, psWire: string, carryWire: string,\n  byOut: Map<string, Gate>, byInput: Map<string, Gate[]>,\n  swapped: Set<string>\n): void {\n  // The expected Z-gate (XOR of psWire and carryWire) doesn't exist.\n  // Try to find the actual Z-gate.\n\n  // Option 1: the gate outputting zi is a valid Z-gate with different inputs\n  const ziGate = byOut.get(zi);\n  if (ziGate && ziGate.op === 'XOR') {\n    // This gate is structurally a Z-gate but with different inputs\n    // One input might match psWire or carryWire\n    // The other input tells us the actual carry or partial-sum wire\n    return; // The output label is correct, inputs are just different\n  }\n\n  // Option 2: zi is swapped with another wire - find the actual Z-gate\n  // Look for XOR gates that consume psWire\n  const consumers = byInput.get(psWire) || [];\n  for (const g of consumers) {\n    if (g.op === 'XOR' && g.out !== psWire) {\n      // This could be the Z-gate\n      swapped.add(g.out);\n      swapped.add(zi);\n      return;\n    }\n  }\n\n  // Option 3: look for XOR gates that consume carryWire\n  const carryConsumers = byInput.get(carryWire) || [];\n  for (const g of carryConsumers) {\n    if (g.op === 'XOR' && g.out !== carryWire) {\n      swapped.add(g.out);\n      swapped.add(zi);\n      return;\n    }\n  }\n\n  swapped.add(zi);\n}\n\nfunction recoverCarry(\n  psWire: string, carryWire: string, genWire: string | null,\n  byKey: Map<string, Gate>, byInput: Map<string, Gate[]>,\n  byOut: Map<string, Gate>, bitIndex: number, N: number,\n  swapped: Set<string>\n): string | null {\n  // Try to find the carry-out gate when the normal trace fails\n  if (genWire) {\n    // Find the propagate wire by looking for AND gates consuming psWire\n    const consumers = byInput.get(psWire) || [];\n    const andGates = consumers.filter(g => g.op === 'AND');\n    for (const propGate of andGates) {\n      const propWire = propGate.out;\n      const cGate = byKey.get(key(genWire, propWire, 'OR'));\n      if (cGate) return cGate.out;\n    }\n  }\n\n  // Try to find carry from the next bit's Z-gate\n  if (bitIndex + 1 < N) {\n    const nextXi = `x${pad(bitIndex + 1)}`;\n    const nextYi = `y${pad(bitIndex + 1)}`;\n    const nextPs = byKey.get(key(nextXi, nextYi, 'XOR'));\n    if (nextPs) {\n      const nextZi = `z${pad(bitIndex + 1)}`;\n      const nextZGate = byOut.get(nextZi);\n      if (nextZGate && nextZGate.op === 'XOR') {\n        if (nextZGate.in1 === nextPs.out) return nextZGate.in2;\n        if (nextZGate.in2 === nextPs.out) return nextZGate.in1;\n      }\n    }\n  }\n\n  return null;\n}\n\nfunction refineWithSimulation(\n  gates: Gate[], N: number, found: Set<string>,\n  byOut: Map<string, Gate>\n): string[] {\n  // Use simulation to find wrong z-bits, then trace to find remaining swaps\n  const wrongBits = new Set<number>();\n\n  for (let xVal = 0; xVal <= Math.min(15, (1 << Math.min(N + 1, 4)) - 1); xVal++) {\n    for (let yVal = 0; yVal <= Math.min(15, (1 << Math.min(N + 1, 4)) - 1); yVal++) {\n      const inputs: Record<string, number> = {};\n      for (let j = 0; j <= N; j++) {\n        inputs[`x${pad(j)}`] = (xVal >> j) & 1;\n        inputs[`y${pad(j)}`] = (yVal >> j) & 1;\n      }\n      try {\n        const result = simulate(gates, inputs);\n        let actual = 0;\n        for (let j = 0; j <= N; j++) {\n          if (result[`z${pad(j)}`] === 1) actual |= (1 << j);\n        }\n        if (actual !== xVal + yVal) {\n          for (let j = 0; j <= N; j++) {\n            const e = ((xVal + yVal) >> j) & 1;\n            const a = (actual >> j) & 1;\n            if (e !== a) wrongBits.add(j);\n          }\n        }\n      } catch { /* ignore */ }\n    }\n  }\n\n  // For each wrong z-bit, add the z-wire as a suspect\n  for (const bit of wrongBits) {\n    found.add(`z${pad(bit)}`);\n  }\n\n  // Also check: find gates whose output SHOULD be a z-wire but isn't\n  for (const g of gates) {\n    if (g.out.startsWith('z')) continue;\n    // Check if this gate could be a z-output gate\n    if (g.op === 'XOR') {\n      for (let i = 0; i < N; i++) {\n        const xi = `x${pad(i)}`, yi = `y${pad(i)}`;\n        if ((g.in1 === xi && g.in2 === yi) || (g.in1 === yi && g.in2 === xi)) {\n          if (i === 0) found.add(g.out);\n        }\n      }\n    }\n  }\n\n  if (found.size === 8) return [...found].sort();\n\n  // Brute-force: try swapping pairs of candidate wires\n  const allWires = gates.map(g => g.out).filter(w => !w.startsWith('x') && !w.startsWith('y'));\n  const candidates = allWires.filter(w => !found.has(w));\n\n  for (let i = 0; i < candidates.length && found.size < 8; i++) {\n    for (let j = i + 1; j < candidates.length && found.size < 8; j++) {\n      if (testSwap(gates, N, candidates[i], candidates[j])) {\n        found.add(candidates[i]);\n        found.add(candidates[j]);\n      }\n    }\n  }\n\n  return [...found].sort();\n}\n\nfunction testSwap(gates: Gate[], N: number, w1: string, w2: string): boolean {\n  const swapped = gates.map(g => {\n    if (g.out === w1) return { ...g, out: w2 };\n    if (g.out === w2) return { ...g, out: w1 };\n    return g;\n  });\n  for (let x = 0; x <= 3; x++) {\n    for (let y = 0; y <= 3; y++) {\n      const inputs: Record<string, number> = {};\n      for (let j = 0; j <= N; j++) {\n        inputs[`x${pad(j)}`] = (x >> j) & 1;\n        inputs[`y${pad(j)}`] = (y >> j) & 1;\n      }\n      try {\n        const result = simulate(swapped, inputs);\n        let actual = 0;\n        for (let j = 0; j <= N; j++) {\n          if (result[`z${pad(j)}`] === 1) actual |= (1 << j);\n        }\n        if (actual !== x + y) return false;\n      } catch { return false; }\n    }\n  }\n  return true;\n}\n","structuredPatch":[{"oldStart":7,"oldLines":951,"newStart":7,"newLines":280,"lines":[" "," export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {","   const wires: Record<string, number> = { ...inputs };","-  const remaining = [...gates];","-","-  while (remaining.length > 0) {","-    const stillRemaining: Gate[] = [];","-    for (const gate of remaining) {","-      if (gate.in1 in wires && gate.in2 in wires) {","-        const a = wires[gate.in1];","-        const b = wires[gate.in2];","-        if (gate.op === 'AND') wires[gate.out] = a & b;","-        else if (gate.op === 'OR') wires[gate.out] = a | b;","-        else wires[gate.out] = a ^ b;","+  const pending: Gate[] = [...gates];","+  while (pending.length > 0) {","+    const stuck: Gate[] = [];","+    let progress = false;","+    for (const g of pending) {","+      if (g.in1 in wires && g.in2 in wires) {","+        const a = wires[g.in1], b = wires[g.in2];","+ 