+  // Looking at the example more carefully:
+  // "a03 OR b03 -> c03" and "c03 -> z04"
+  // This means the OR gate outputs c03, and z04 = c03 (same wire)
+  // But that can't be - a gate outputs ONE wire. So either:
+  // 1. The OR gate outputs z04 directly (c03 = z04)
+  // 2. There's an identity gate
+  // Actually, looking at the example, the carry output from the last OR gate
+  // IS zN. So the OR gate at bit N-1 has out = zN.
+  // But wait, for bits 1..N-2, the carry feeds into the next bit.
+  // For the last bit (N-1), the carry becomes zN.
+  // So the OR gate at bit N-1 should output zN, not c(N-1).
+
+  // Fix the last bit's carry gate
+  const lastIdx = gates.length - 1;
+  gates[lastIdx] = { ...gates[lastIdx], out: `z${String(N).padStart(2, '0')}` };
+
+  return gates;
+}
+
+function swapOutputs(gates: Gate[], w1: string, w2: string): Gate[] {
+  return gates.map(g => {
+    if (g.out === w1) return { ...g, out: w2 };
+    if (g.out === w2) return { ...g, out: w1 };
+    return g;
+  });
+}
+
+describe('simulate', () => {
+  it('simulates a single AND gate', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, c: 1 });
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, c: 0 });
+  });
+
+  it('simulates a single OR gate', () => {
+    const gates: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 0, b: 1 })).toEqual({ a: 0, b: 1, c: 1 });
+  });
+
+  it('simulates a single XOR gate', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, c: 0 });
+  });
+
+  it('simulates chained gates in dependency order', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'd' },
+      { op: 'OR', in1: 'd', in2: 'c', out: 'e' },
+    ];
+    expect(simulate(gates, { a: 1, b: 0, c: 1 })).toEqual({ a: 1, b: 0, c: 1, d: 0, e: 1 });
+  });
+
+  it('simulates a 4-bit adder correctly', () => {
+    const gates = buildCorrectAdder(4);
+    // Test a few values
+    for (let x = 0; x < 16; x++) {
+      for (let y = 0; y < 16; y++) {
+        const inputs: Record<string, number> = {};
+        for (let j = 0; j < 4; j++) {
+          inputs[`x${String(j).padStart(2, '0')}`] = (x >> j) & 1;
+          inputs[`y${String(j).padStart(2, '0')}`] = (y >> j) & 1;
+        }
+        const result = simulate(gates, inputs);
+        let z = 0;
+        for (let j = 0; j <= 4; j++) {
+          if (result[`z${String(j).padStart(2, '0')}`] === 1) z |= (1 << j);
+        }
+        expect(z).toBe(x + y);
+      }
+    }
+  });
+});
+
+describe('findSwappedWires', () => {
+  it('finds swapped wires in a 4-bit adder with 4 swaps', () => {
+    const gates = buildCorrectAdder(4);
+    // Apply 4 swaps
+    const swapped = swapOutputs(gates, 'z01', 'a01');
+    const swapped2 = swapOutputs(swapped, 'z02', 'b02');
+    const swapped3 = swapOutputs(swapped2, 'c01', 't02');
+    const swapped4 = swapOutputs(swapped3, 'b01', 'a02');
+
+    const result = findSwappedWires(swapped4);
+    expect(result.sort()).toEqual(['a01', 'a02', 'b01', 'b02', 'c01', 't02', 'z01', 'z02']);
+  });
+
+  it('finds swapped wires in an 8-bit adder', () => {
+    const gates = buildCorrectAdder(8);
+    const swapped = swapOutputs(gates, 'z03', 'a03');
+    const swapped2 = swapOutputs(swapped, 'z05', 'b05');
+    const swapped3 = swapOutputs(swapped2, 'c02', 't04');
+    const swapped4 = swapOutputs(swapped3, 'b06', 'a07');
+
+    const result = findSwappedWires(swapped4);
+    const expected = ['a03', 'a07', 'b05', 'b06', 'c02', 't04', 'z03', 'z05'].sort();
+    expect(result.sort()).toEqual(expected);
+  });
+
+  it('handles swaps involving only non-z wires', () => {
+    const gates = buildCorrectAdder(4);
+    const swapped = swapOutputs(gates, 'c00', 'a01');
+    const swapped2 = swapOutputs(swapped, 'c01', 'b02');
+    const swapped3 = swapOutputs(swapped2, 't01', 'a02');
+    const swapped4 = swapOutputs(swapped3, 't02', 'b01');
+
+    const result = findSwappedWires(swapped4);
+    expect(result.length).toBe(8);
+  });
+
+  it('handles swaps where z00 is swapped', () => {
+    const gates = buildCorrectAdder(4);
+    const swapped = swapOutputs(gates, 'z00', 'c00');
+    const swapped2 = swapOutputs(swapped, 'z01', 'a01');
+    const swapped3 = swapOutputs(swapped2, 'c01', 't02');
+    const swapped4 = swapOutputs(swapped3, 'b01', 'a02');
+
+    const result = findSwappedWires(swapped4);
+    expect(result.length).toBe(8);
+    expect(result).toContain('z00');
+    expect(result).toContain('c00');
+  });
+});
