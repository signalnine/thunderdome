\n    if (m) N = Math.max(N, parseInt(m[1]));\n  }\n  \n  const swapped = new Set<string>();\n  \n  // Check each z-wire\n  for (let i = 0; i <= N; i++) {\n    const zi = `z${String(i).padStart(2, '0')}`;\n    const g = byOut.get(zi);\n    if (!g) continue;\n    \n    if (i === 0) {\n      // z00 should be XOR(x00, y00)\n      if (g.op !== 'XOR' || !isXY(g, 0)) {\n        swapped.add(zi);\n      }\n    } else if (i === N) {\n      // zN should be OR\n      if (g.op !== 'OR') {\n        swapped.add(zi);\n      }\n    } else {\n      // zi should be XOR\n      if (g.op !== 'XOR') {\n        swapped.add(zi);\n      } else {\n        // Check if one input is from XOR(xi, yi)\n        const xi = `x${String(i).padStart(2, '0')}`;\n        const yi = `y${String(i).padStart(2, '0')}`;\n        const psGate = findByInputs(gates, xi, yi, 'XOR');\n        if (psGate) {\n          if (g.in1 !== psGate.out && g.in2 !== psGate.out) {\n            swapped.add(zi);\n          }\n        }\n      }\n    }\n  }\n  \n  // Check if XOR(xi, yi) for i > 0 outputs a z-wire\n  for (let i = 1; i <= N; i++) {\n    const xi = `x${String(i).padStart(2, '0')}`;\n    const yi = `y${String(i).padStart(2, '0')}`;\n    const g = findByInputs(gates, xi, yi, 'XOR');\n    if (g && g.out.startsWith('z')) {\n      swapped.add(g.out);\n    }\n  }\n  \n  // Check if AND(xi, yi) outputs a z-wire\n  for (let i = 0; i <= N; i++) {\n    const xi = `x${String(i).padStart(2, '0')}`;\n    const yi = `y${String(i).padStart(2, '0')}`;\n    const g = findByInputs(gates, xi, yi, 'AND');\n    if (g && g.out.startsWith('z')) {\n      swapped.add(g.out);\n    }\n  }\n  \n  // If we have 8 wires, return\n  if (swapped.size === 8) return [...swapped].sort();\n  \n  // Otherwise, use simulation + targeted brute force\n  // ...\n}\n\nfunction isXY(g: Gate, i: number): boolean {\n  const xi = `x${String(i).padStart(2, '0')}`;\n  const yi = `y${String(i).padStart(2, '0')}`;\n  return (g.in1 === xi && g.in2 === yi) || (g.in1 