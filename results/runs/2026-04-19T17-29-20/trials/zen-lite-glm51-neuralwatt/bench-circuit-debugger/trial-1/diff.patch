ut, g);\n\n  let N = 0;\n  for (const g of gates) {\n    const m = g.out.match(/^z(\\d+)$/);\n    if (m) N = Math.max(N, parseInt(m[1]));\n  }\n\n  // Step 1: Find wrong z-bits via simulation\n  const wrongBits = new Set<number>();\n  const testVals = [];\n  for (let v = 0; v < Math.min(256, 1 << Math.min(N + 1, 8)); v++) {\n    testVals.push(v);\n  }\n\n  for (const x of testVals) {\n    for (const y of testVals) {\n      const inputs: Record<string, number> = {};\n      for (let j = 0; j <= N; j++) {\n        inputs[`x${pad(j)}`] = (x >> j) & 1;\n        inputs[`y${pad(j)}`] = (y >> j) & 1;\n      }\n      let actual: number;\n      try {\n        const result = simulate(gates, inputs);\n        actual = 0;\n        for (let j = 0; j <= N; j++) {\n          if (result[`z${pad(j)}`] === 1) actual |= (1 << j);\n        }\n      } catch {\n        continue;\n      }\n      if (actual !== x + y) {\n        for (let j = 0; j <= N; j++) {\n          if (((x + y) >> j & 1) !== ((actual >> j) & 1)) wrongBits.add(j);\n        }\n      }\n    }\n  }\n\n  // Step 2: For each wrong z-bit, zi is a swapped wire.\n  // The gate that should produce zi is producing some other wire instead.\n  // We need to find what zi was swapped with.\n\n  // Collect all swapped wires found\n  const swapped = new Set<string>();\n  for (const bit of wrongBits) swapped.add(`z${pad(bit)}`);\n\n  // Step 3: For each z-wire that's wrong, find what it was swapped with.\n  // The gate producing zi (wrongly) should actually produce some other wire.\n  // And some other gate should produce zi.\n  //\n  // Approach: for each pair (zi, candidate), test if swapping them fixes\n  // the adder for the affected bits.\n  //\n  // But we need to find 4 pairs among potentially many candidates.\n  // Key optimization: a swap at bit i typically only affects bits >= i\n  // (due to carry propagation). So the FIRST wrong bit tells us about\n  // the first swap.\n\n  // Alternative: iterative fix approach.\n  // Find the lowest wrong z-bit. The zi wire for that bit must be swapped\n  // with some other wire. Try all possible swap partners for zi,\n  // pick the one that fixes the most bits, then repeat.\n\n  // Better: since there are only 4 pairs (8 wires), and we can identify\n  // which z-bits are wrong, we can use the following:\n  // - Each wrong z-bit means zi is involved in a swap\n  // - But a swap between two non-z wires can also cause wrong z-bits\n  //   (if it breaks the carry chain)\n\n  // Let me use a different approach entirely:\n  // Try all pairs of output wires, swap them, simulate, and check.\n  // With ~220 gates, there are ~220*219/2 ≈ 24000 pairs.\n  // For each pair, we need a quick simulation test.\n  // We need to find 4 pairs, so we do this iteratively.\n\n  // Even better: since we know there are exactly 4 pairs, and we can\n  // identify wrong z-bits, let's narrow candidates first.\n\n  // For a wrong z-bit i:\n  // - zi is one of the swapped wires\n  // - The other wire in the swap pair could be any non-input wire\n  // - But it's likely a wire that's \"near\" zi in the circuit\n\n  // Let me just do iterative single-swap search:\n  // Find the best single swap that fixes the most test cases,\n  // apply it, repeat 4 times.\n\n  const allWires = gates.map(g => g.out);\n\n  for (let round = 0; round < 4; round++) {\n    // Build current gates (with all swaps found so far applied)\n    let currentGates = applySwaps(gates, swapped);\n\n    // Find wrong bits in current circuit\n    const currentWrong = findWrongBits(currentGates, N);\n    if (currentWrong.size === 0) break;\n\n    // For each wrong z-bit, try swapping it with every other wire\n    let bestSwap: [string, string] | null = null;\n    let bestScore = -1;\n\n    for (const wrongBit of currentWrong) {\n      const zi = `z${pad(wrongBit)}`;\n\n      // Get candidate wires to swap with zi\n      // Candidate = any output wire that's not already in swapped set\n      // and is not an input wire (x/y)\n      const candidates = allWires.filter(w =>\n        !swapped.has(w) && w !== zi && !w.startsWith('x') && !w.startsWith('y')\n      );\n\n      for (const candidate of candidates) {\n        // Try swapping zi with candidate\n        const testSwapped = new Set(swapped);\n        testSwapped.add(zi);\n        testSwapped.add(candidate);\n\n        const testGates = applySwaps(gates, testSwapped);\n        const score = countCorrect(testGates, N);\n        if (score > bestScore) {\n          bestScore = score;\n          bestSwap = [zi, candidate];\n        }\n      }\n    }\n\n    // Also try swapping non-z wires (a swap between two internal wires)\n    if (!bestSwap || bestScore < countCorrect(currentGates, N)) {\n      // Try all pairs of non-z, non-x/y wires not yet swapped\n      const candidates = allWires.filter(w =>\n        !swapped.has(w) && !w.startsWith('x') && !w.startsWith('y')\n      );\n\n      for (let i = 0; i < candidates.length; i++) {\n        for (let j = i + 1; j < candidates.length; j++) {\n          const testSwapped = new Set(swapped);\n          testSwapped.add(candidates[i]);\n          testSwapped.add(candidates[j]);\n\n          const testGates = applySwaps(gates, testSwapped);\n          const score = countCorrect(testGates, N);\n          if (score > bestScore) {\n            bestScore = score;\n            bestSwap = [candidates[i], candidates[j]];\n          }\n        }\n      }\n    }\n\n    if (bestSwap) {\n      swapped.add(bestSwap[0]);\n      swapped.add(bestSwap[1]);\n    }\n  }\n\n  return [...swapped].sort();\n}\n\nfunction applySwaps(gates: Gate[], swappedSet: Set<string>): Gate[] {\n  // The swappedSet contains all wires involved in swaps.\n  // We need to figure out which pairs they form and apply the swaps.\n  // But we don't know the pairing! We need to track pairs.\n\n  // This approach has a flaw: we track individual wires, not pairs.\n  // Let me rethink...\n\n  // Actually, we need to track swap pairs, not