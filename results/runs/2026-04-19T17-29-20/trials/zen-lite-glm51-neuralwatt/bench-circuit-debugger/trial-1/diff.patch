+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const wires: Record<string, number> = { ...inputs };
+  const pending: Gate[] = [...gates];
+  while (pending.length > 0) {
+    const stuck: Gate[] = [];
+    let progress = false;
+    for (const g of pending) {
+      if (g.in1 in wires && g.in2 in wires) {
+        const a = wires[g.in1], b = wires[g.in2];
+        wires[g.out] = g.op === 'AND' ? a & b : g.op === 'OR' ? a | b : a ^ b;
+        progress = true;
+      } else {
+        stuck.push(g);
+      }
+    }
+    if (!progress) throw new Error('Unresolvable dependencies');
+    pending.length = 0;
+    pending.push(...stuck);
+  }
+  return wires;
+}
+
+const pad = (n: number) => String(n).padStart(2, '0');
+
+function swapOutputs(gates: Gate[], w1: string, w2: string): Gate[] {
+  return gates.map(g =>
+    g.out === w1 ? { ...g, out: w2 } :
+    g.out === w2 ? { ...g, out: w1 } : g
+  );
+}
+
+function quickVerify(gates: Gate[], N: number): boolean {
+  for (let x = 0; x < 4; x++) {
+    for (let y = 0; y < 4; y++) {
+      const inputs: Record<string, number> = {};
+      for (let j = 0; j <= Math.min(N, 2); j++) {
+        inputs[`x${pad(j)}`] = (x >> j) & 1;
+        inputs[`y${pad(j)}`] = (y >> j) & 1;
+        if (j <= N) { inputs[`x${pad(j)}`] = (x >> j) & 1; inputs[`y${pad(j)}`] = (y >> j) & 1; }
+      }
+      // Set remaining bits to 0
+      for (let j = 0; j <= N; j++) {
+        if (!(inputs[`x${pad(j)}`] !== undefined)) inputs[`x${pad(j)}`] = 0;
+        if (!(inputs[`y${pad(j)}`] !== undefined)) inputs[`y${pad(j)}`] = 0;
+      }
+      try {
+        const result = simulate(gates, inputs);
+        let actual = 0;
+        for (let j = 0; j <= N; j++) {
+          if (result[`z${pad(j)}`] === 1) actual |= (1 << j);
+        }
+        if (actual !== x + y) return false;
+      } catch {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+function fullVerify(gates: Gate[], N: number): boolean {
+  const limit = Math.min(16, 1 << Math.min(N + 1, 4));
+  for (let x = 0; x < limit; x++) {
+    for (let y = 0; y < limit; y++) {
+      const inputs: Record<string, number> = {};
+      for (let j = 0; j <= N; j++) {
+        inputs[`x${pad(j)}`] = (x >> j) & 1;
+        inputs[`y${pad(j)}`] = (y >> j) & 1;
+      }
+      try {
+        const result = simulate(gates, inputs);
+        let actual = 0;
+        for (let j = 0; j <= N; j++) {
+          if (result[`z${pad(j)}`] === 1) actual |= (1 << j);
+        }
+        if (actual !== x + y) return false;
+      } catch {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+function countCorrect(gates: Gate[], N: number): number {
+  let correct = 0;
+  const limit = Math.min(8, 1 << Math.min(N + 1, 3));
+  for (let x = 0; x < limit; x++) {
+    for (let y = 0; y < limit; y++) {
+      const inputs: Record<string, number> = {};
+      for (let j = 0; j <= N; j++) {
+        inputs[`x${pad(j)}`] = (x >> j) & 1;
+        inputs[`y${pad(j)}`] = (y >> j) & 1;
+      }
+      try {
+        const result = simulate(gates, inputs);
+        let actual = 0;
+        for (let j = 0; j <= N; j++) {
+          if (result[`z${pad(j)}`] === 1) actual |= (1 << j);
+        }
+        if (actual === x + y) correct++;
+      } catch { /* skip */ }
+    }
+  }
+  return correct;
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  let N = 0;
+  for (const g of gates) {
+    const m = g.out.match(/^z(\d+)$/);
+    if (m) N = Math.max(N, parseInt(m[1]));
+  }
+
+  const allOuts = gates.map(g => g.out);
+  const pairs: [string, string][] = [];
+  let currentGates = [...gates];
+
+  for (let round = 0; round < 4; round++) {
+    // Find wrong z-bits
+    const wrongBits = new Set<number>();
+    const limit = Math.min(8, 1 << Math.min(N + 1, 3));
+    for (let x = 0; x < limit; x++) {
+      for (let y = 0; y < limit; y++) {
+        const inputs: Record<string, number> = {};
+        for (let j = 0; j <= N; j++) {
+          inputs[`x${pad(j)}`] = (x >> j) & 1;
+          inputs[`y${pad(j)}`] = (y >> j) & 1;
+        }
+        try {
+          const result = simulate(currentGates, inputs);
+          let actual = 0;
+          for (let j = 0; j <= N; j++) {
+            if (result[`z${pad(j)}`] === 1) actual |= (1 << j);
+          }
+          if (actual !== x + y) {
+            for (let j = 0; j <= N; j++) {
+              if (((x + y) >> j & 1) !== ((actual >> j) & 1)) wrongBits.add(j);
+            }
+          }
+        } catch { /* skip */ }
+      }
+    }
+
+    if (wrongBits.size === 0) break;
+
+    // Try swapping each pair of output wires, find the one that improves the most
+    const usedWires = new Set(pairs.flat());
+    let bestPair: [string, string] | null = null;
+    let bestScore = countCorrect(currentGates, N);
+
+    // Prioritize: try swapping wrong z-wires with other wires first
+    const wrongZWires = [...wrongBits].map(b => `z${pad(b)}`);
+
+    // Candidate pairs: at least one should be a wrong z-wire or we try all
+    const candidates = allOuts.filter(w => !usedWires.has(w));
+
+    // Phase 1: try each wrong z-wire with each candidate
+    for (const zw of wrongZWires) {
+      for (const c of candidates) {
+        if (c === zw) continue;
+        const testGates = swapOutputs(currentGates, zw, c);
+        const score = countCorrect(testGates, N);
+        if (score > bestScore) {
+          bestScore = score;
+          bestPair = [zw, c];
+        }
+      }
+    }
+
+    // Phase 2: if no improvement with z-wires, try all candidate pairs
+    if (!bestPair) {
+      for (let i = 0; i < candidates.length; i++) {
+        for (let j = i + 1; j < candidates.length; j++) {
+          const testGates = swapOutputs(currentGates, candidates[i], candidates[j]);
+          const score = countCorrect(testGates, N);
+          if (score > bestScore) {
+            bestScore = score;
+            bestPair = [candidates[i], candidates[j]];
+          }
+        }
+      }
+    }
+
+    if (bestPair) {
+      pairs.push(bestPair);
+      currentGates = swapOutputs(currentGates, bestPair[0], bestPair[1]);
+    }
+  }
+
+  // Verify the result
+  if (!fullVerify(currentGates, N)) {
+    // If not fully correct, try exhaustive search for remaining pairs
+    // This handles edge cases where greedy approach doesn't work
+    const usedWires = new Set(pairs.flat());
+    const candidates = allOuts.filter(w => !usedWires.has(w));
+
+    // Try all remaining pairs
+    for (let i = 0; i < candidates.length; i++) {
+      for (let j = i + 1; j < candidates.length; j++) {
+        const testGates = swapOutputs(currentGates, candidates[i], candidates[j]);
+        if (fullVerify(testGates, N)) {
+          pairs.push([candidates[i], candidates[j]]);
+          currentGates = testGates;
+          break;
+        }
+      }
+      if (fullVerify(currentGates, N)) break;
+    }
+  }
+
+  const allSwapped = pairs.flat();
+  return [...allSwapped].sort();
+}
