j);","+        if (a !== x + y) return false;","       } catch { return false; }","     }","   }"]}],"originalFile":"export interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string;\n  in2: string;\n  out: string;\n}\n\nexport function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {\n  const wires: Record<string, number> = { ...inputs };\n  const pending: Gate[] = [...gates];\n  while (pending.length > 0) {\n    const stuck: Gate[] = [];\n    let progress = false;\n    for (const g of pending) {\n      if (g.in1 in wires && g.in2 in wires) {\n        const a = wires[g.in1], b = wires[g.in2];\n        wires[g.out] = g.op === 'AND' ? a & b : g.op === 'OR' ? a | b : a ^ b;\n        progress = true;\n      } else {\n        stuck.push(g);\n      }\n    }\n    if (!progress) throw new Error('Circuit has unresolvable dependencies');\n    pending.length = 0;\n    pending.push(...stuck);\n  }\n  return wires;\n}\n\nexport function findSwappedWires(gates: Gate[]): string[] {\n  const byOut = new Map<string, Gate>();\n  const byKey = new Map<string, Gate>();\n  const byInput = new Map<string, Gate[]>();\n\n  for (const g of gates) {\n    byOut.set(g.out, g);\n    byKey.set(key(g.in1, g.in2, g.op), g);\n    for (const w of [g.in1, g.in2]) {\n      if (!byInput.has(w)) byInput.set(w, []);\n      byInput.get(w)!.push(g);\n    }\n  }\n\n  let N = 0;\n  for (const g of gates) {\n    const m = g.out.match(/^z(\\d+)$/);\n    if (m) N = Math.max(N, parseInt(m[1]));\n  }\n\n  const swapped = new Set<string>();\n\n  // Trace the carry chain structurally\n  let carry: string | null = null;\n\n  for (let i = 0; i <= N; i++) {\n    const xi = `x${pad(i)}`, yi = `y${pad(i)}`, zi = `z${pad(i)}`;\n\n    if (i === 0) {\n      // Half adder: XOR->z00, AND->carry\n      const xor = byKey.get(key(xi, yi, 'XOR'));\n      if (xor && xor.out !== zi) { swapped.add(xor.out); swapped.add(zi); }\n      const and = byKey.get(key(xi, yi, 'AND'));\n      carry = and?.