+import { describe, test, expect } from 'vitest';
+import { solveToggle, solveCounter } from '../index.js';
+
+function verifyToggle(target: boolean[], buttons: number[][], result: number[]): boolean {
+  const state = new Array(target.length).fill(false);
+  for (const bi of result) {
+    for (const li of buttons[bi]) {
+      if (li >= 0 && li < target.length) state[li] = !state[li];
+    }
+  }
+  return state.every((v, i) => v === target[i]);
+}
+
+function verifyCounter(lights: number[], buttons: number[][], modulus: number, result: number[]): boolean {
+  const state = new Array(lights.length).fill(0);
+  for (let i = 0; i < buttons.length; i++) {
+    for (const cj of buttons[i]) {
+      if (cj >= 0 && cj < lights.length) {
+        state[cj] = (state[cj] + result[i]) % modulus;
+      }
+    }
+  }
+  return state.every((v, i) => v === lights[i]);
+}
+
+describe('solveToggle stress', () => {
+  test('40x40 identity matrix', () => {
+    const m = 40;
+    const buttons = Array.from({ length: m }, (_, i) => [i]);
+    const target = Array.from({ length: m }, (_, i) => i % 3 === 0);
+    const start = Date.now();
+    const result = solveToggle({ target, buttons });
+    const elapsed = Date.now() - start;
+    expect(elapsed).toBeLessThan(5000);
+    expect(result).not.toBeNull();
+    expect(verifyToggle(target, buttons, result!)).toBe(true);
+  });
+
+  test('40x40 with overlapping buttons', () => {
+    const n = 40, m = 40;
+    const buttons: number[][] = [];
+    for (let i = 0; i < m; i++) {
+      const affected: number[] = [];
+      for (let j = 0; j < n; j++) {
+        if ((i + j) % 3 === 0) affected.push(j);
+      }
+      buttons.push(affected);
+    }
+    const target = Array.from({ length: n }, (_, i) => i % 2 === 0);
+    const start = Date.now();
+    const result = solveToggle({ target, buttons });
+    const elapsed = Date.now() - start;
+    expect(elapsed).toBeLessThan(5000);
+    if (result !== null) {
+      expect(verifyToggle(target, buttons, result)).toBe(true);
+    }
+  });
+
+  test('toggle with ~10 free variables', () => {
+    // 10 lights, 20 buttons: rank ~10, so ~10 free vars → 2^10 = 1024 enumerations
+    const n = 10, m = 20;
+    const buttons: number[][] = [];
+    for (let i = 0; i < m; i++) {
+      const affected: number[] = [];
+      for (let j = 0; j < n; j++) {
+        if ((i * 7 + j * 3) % 5 < 2) affected.push(j);
+      }
+      buttons.push(affected);
+    }
+    const target = Array.from({ length: n }, () => true);
+    const start = Date.now();
+    const result = solveToggle({ target, buttons });
+    const elapsed = Date.now() - start;
+    expect(elapsed).toBeLessThan(5000);
+    if (result !== null) {
+      expect(verifyToggle(target, buttons, result)).toBe(true);
+      // Check sorted
+      for (let i = 1; i < result.length; i++) {
+        expect(result[i]).toBeGreaterThan(result[i - 1]);
+      }
+    }
+  });
+});
+
+describe('solveCounter stress', () => {
+  test('40x40 identity, mod 97', () => {
+    const m = 40;
+    const buttons = Array.from({ length: m }, (_, i) => [i]);
+    const lights = Array.from({ length: m }, (_, i) => (i * 17 + 3) % 97);
+    const start = Date.now();
