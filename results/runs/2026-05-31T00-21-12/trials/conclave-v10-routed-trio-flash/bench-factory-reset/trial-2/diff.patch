@@ -0,0 +1,297 @@
+interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+const POPCOUNT_TABLE = new Uint8Array(65536);
+for (let i = 1; i < 65536; i++) {
+  POPCOUNT_TABLE[i] = POPCOUNT_TABLE[i >> 1] + (i & 1);
+}
+
+function popcount32(n: number): number {
+  return POPCOUNT_TABLE[n & 0xFFFF] + POPCOUNT_TABLE[(n >>> 16) & 0xFFFF];
+}
+
+function mod(a: number, p: number): number {
+  return ((a % p) + p) % p;
+}
+
+function modInverse(a: number, p: number): number {
+  let [old_r, r] = [a, p];
+  let [old_s, s] = [1, 0];
+  while (r !== 0) {
+    const q = Math.floor(old_r / r);
+    [old_r, r] = [r, old_r - q * r];
+    [old_s, s] = [s, old_s - q * s];
+  }
+  return mod(old_s, p);
+}
+
+function isLexSmallerSet(aLo: number, aHi: number, bLo: number, bHi: number): boolean {
+  const dLo = aLo ^ bLo;
+  if (dLo !== 0) {
+    const lb = dLo & (-dLo);
+    return (aLo & lb) !== 0;
+  }
+  const dHi = aHi ^ bHi;
+  if (dHi !== 0) {
+    const lb = dHi & (-dHi);
+    return (aHi & lb) !== 0;
+  }
+  return false;
+}
+
+export function solveToggle(machine: Machine): number[] | null {
+  const { target, buttons } = machine;
+  const n = target.length;
+  const m = buttons.length;
+
+  if (n === 0) return [];
+  if (m === 0) return target.every(t => !t) ? [] : null;
+
+  const mat: number[][] = [];
+  for (let j = 0; j < n; j++) {
+    const row = new Array(m + 1).fill(0);
+    row[m] = target[j] ? 1 : 0;
+    mat.push(row);
+  }
+  for (let i = 0; i < m; i++) {
+    for (const lj of buttons[i]) {
+      if (lj >= 0 && lj < n) mat[lj][i] ^= 1;
+    }
+  }
+
+  const pivotCols: number[] = [];
+  let rank = 0;
+  for (let col = 0; col < m && rank < n; col++) {
+    let pr = -1;
+    for (let r = rank; r < n; r++) {
+      if (mat[r][col]) { pr = r; break; }
+    }
+    if (pr === -1) continue;
+    [mat[rank], mat[pr]] = [mat[pr], mat[rank]];
+    for (let r = 0; r < n; r++) {
+      if (r !== rank && mat[r][col]) {
+        for (let c = col; c <= m; c++) mat[r][c] ^= mat[rank][c];
+      }
+    }
+    pivotCols.push(col);
+    rank++;
+  }
+
+  for (let r = rank; r < n; r++) {
+    if (mat[r][m]) return null;
+  }
+
+  const pivotSet = new Set(pivotCols);
+  const freeVars: number[] = [];
+  for (let i = 0; i < m; i++) {
+    if (!pivotSet.has(i)) freeVars.push(i);
+  }
+  const k = freeVars.length;
+
+  if (k === 0) {
+    const result: number[] = [];
+    for (let r = 0; r < rank; r++) {
+      if (mat[r][m]) result.push(pivotCols[r]);
+    }
+    return result;
+  }
+
+  let x0Lo = 0, x0Hi = 0;
+  for (let r = 0; r < rank; r++) {
+    if (mat[r][m]) {
+      const col = pivotCols[r];
+      if (col < 32) x0Lo |= (1 << col);
+      else x0Hi |= (1 << (col - 32));
+    }
+  }
+
+  const nvLo: number[] = [], nvHi: number[] = [];
+  for (let fi = 0; fi < k; fi++) {
+    let lo = 0, hi = 0;
+    const fv = freeVars[fi];
+    if (fv < 32) lo |= (1 << fv);
+    else hi |= (1 << (fv - 32));
+    for (let r = 0; r < rank; r++) {
+      if (mat[r][fv]) {
+        const col = pivotCols[r];
+        if (col < 32) lo |= (1 << col);
+        else hi |= (1 << (col - 32));
+      }
+    }
+    nvLo.push(lo);
+    nvHi.push(hi);
+  }
+
+  let curLo = x0Lo, curHi = x0Hi;
+  let bestW = popcount32(curLo) + popcount32(curHi);
+  let bestLo = curLo, bestHi = curHi;
+
+  if (k <= 25) {
+    const total = 1 << k;
+    for (let i = 1; i < total; i++) {
+      const bit = 31 - Math.clz32(i & -i);
+      curLo ^= nvLo[bit];
+      curHi ^= nvHi[bit];
+      const w = popcount32(curLo) + popcount32(curHi);
+      if (w < bestW || (w === bestW && isLexSmallerSet(curLo, curHi, bestLo, bestHi))) {
+        bestW = w;
+        bestLo = curLo;
+        bestHi = curHi;
+      }
+    }
+  } else {
+    const reachLo = new Array(k + 1).fill(0);
+    const reachHi = new Array(k + 1).fill(0);
+    for (let d = k - 1; d >= 0; d--) {
+      reachLo[d] = reachLo[d + 1] | nvLo[d];
+      reachHi[d] = reachHi[d + 1] | nvHi[d];
+    }
+
+    const bnb = (depth: number, sLo: number, sHi: number) => {
+      const w = popcount32(sLo) + popcount32(sHi);
+      if (w < bestW || (w === bestW && isLexSmallerSet(sLo, sHi, bestLo, bestHi))) {
+        bestW = w;
+        bestLo = sLo;
+        bestHi = sHi;
+      }
+      if (depth === k) return;
+      const lb = w - popcount32(sLo & reachLo[depth]) - popcount32(sHi & reachHi[depth]);
+      if (lb >= bestW) return;
+      bnb(depth + 1, sLo, sHi);
+      bnb(depth + 1, sLo ^ nvLo[depth], sHi ^ nvHi[depth]);
+    };
+
+    bnb(0, x0Lo, x0Hi);
+  }
+
+  const result: number[] = [];
+  for (let i = 0; i < m; i++) {
+    const set = i < 32 ? ((bestLo >>> i) & 1) : ((bestHi >>> (i - 32)) & 1);
+    if (set) result.push(i);
+  }
+  return result;
+}
+
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): number[] | null {
+  const n = lights.length;
+  const m = buttons.length;
+  const p = modulus;
+
+  if (n === 0) return new Array(m).fill(0);
+  if (m === 0) return lights.every(l => l === 0) ? [] : null;
+
+  const mat: number[][] = [];
+  for (let j = 0; j < n; j++) {
+    const row = new Array(m + 1).fill(0);
+    row[m] = mod(lights[j], p);
+    mat.push(row);
+  }
+  for (let i = 0; i < m; i++) {
+    for (const cj of buttons[i]) {
+      if (cj >= 0 && cj < n) {
+        mat[cj][i] = (mat[cj][i] + 1) % p;
+      }
+    }
+  }
+
+  const pivotCols: number[] = [];
+  let rank = 0;
+  for (let col = 0; col < m && rank < n; col++) {
+    let pr = -1;
+    for (let r = rank; r < n; r++) {
+      if (mat[r][col] !== 0) { pr = r; break; }
+    }
+    if (pr === -1) continue;
+    [mat[rank], mat[pr]] = [mat[pr], mat[rank]];
+    const inv = modInverse(mat[rank][col], p);
+    for (let c = col; c <= m; c++) {
+      mat[rank][c] = (mat[rank][c] * inv) % p;
+    }
+    for (let r = 0; r < n; r++) {
+      if (r !== rank && mat[r][col] !== 0) {
+        const factor = mat[r][col];
+        for (let c = col; c <= m; c++) {
+          mat[r][c] = mod(mat[r][c] - factor * mat[rank][c], p);
+        }
+      }
+    }
+    pivotCols.push(col);
+    rank++;
+  }
+
+  for (let r = rank; r < n; r++) {
+    if (mat[r][m] !== 0) return null;
+  }
+
+  const pivotSet = new Set(pivotCols);
+  const freeVars: number[] = [];
+  for (let i = 0; i < m; i++) {
+    if (!pivotSet.has(i)) freeVars.push(i);
+  }
+  const k = freeVars.length;
+
+  const consts: number[] = [];
+  const coeffs: number[][] = [];
+  for (let r = 0; r < rank; r++) {
+    consts.push(mat[r][m]);
+    const row: number[] = [];
+    for (let i = 0; i < k; i++) {
+      row.push(mat[r][freeVars[i]]);
+    }
+    coeffs.push(row);
+  }
+
+  let bestTotal = Infinity;
+  let bestResult: number[] | null = null;
+
+  const result = new Array(m).fill(0);
+  const assignment = new Array(k).fill(0);
+
+  const evaluate = () => {
+    let total = 0;
+    for (let i = 0; i < k; i++) {
+      result[freeVars[i]] = assignment[i];
+      total += assignment[i];
+    }
+    for (let r = 0; r < rank; r++) {
+      let val = consts[r];
+      for (let i = 0; i < k; i++) {
+        val -= coeffs[r][i] * assignment[i];
+      }
+      val = mod(val, p);
+      result[pivotCols[r]] = val;
+      total += val;
+    }
+    if (total < bestTotal) {
+      bestTotal = total;
+      bestResult = result.slice();
+    } else if (total === bestTotal && bestResult !== null) {
+      for (let i = 0; i < m; i++) {
+        if (result[i] < bestResult[i]) { bestResult = result.slice(); return; }
+        if (result[i] > bestResult[i]) return;
+      }
+    }
+  };
+
+  for (;;) {
+    evaluate();
+    let carry = true;
+    for (let i = k - 1; i >= 0 && carry; i--) {
+      assignment[i]++;
+      if (assignment[i] >= p) {
+        assignment[i] = 0;
+      } else {
+        carry = false;
+      }
+    }
+    if (carry) break;
+  }
+
+  return bestResult;
+}
