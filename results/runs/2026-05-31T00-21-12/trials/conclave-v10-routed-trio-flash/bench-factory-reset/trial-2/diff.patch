+import { describe, test, expect } from 'vitest';
+import { solveToggle, solveCounter } from '../index.js';
+
+describe('solveToggle', () => {
+  test('task example: no solution for [T,T,F,T]', () => {
+    const result = solveToggle({
+      target: [true, true, false, true],
+      buttons: [[0, 1], [1, 2, 3], [0, 3]],
+    });
+    expect(result).toBeNull();
+  });
+
+  test('single button, single light → press it', () => {
+    expect(solveToggle({
+      target: [true],
+      buttons: [[0]],
+    })).toEqual([0]);
+  });
+
+  test('single button, single light, target off → press nothing', () => {
+    expect(solveToggle({
+      target: [false],
+      buttons: [[0]],
+    })).toEqual([]);
+  });
+
+  test('no buttons, all-off target → empty', () => {
+    expect(solveToggle({
+      target: [false, false],
+      buttons: [],
+    })).toEqual([]);
+  });
+
+  test('no buttons, non-trivial target → null', () => {
+    expect(solveToggle({
+      target: [true],
+      buttons: [],
+    })).toBeNull();
+  });
+
+  test('empty target → empty', () => {
+    expect(solveToggle({
+      target: [],
+      buttons: [[0]],
+    })).toEqual([]);
+  });
+
+  test('two independent buttons', () => {
+    expect(solveToggle({
+      target: [true, true],
+      buttons: [[0], [1]],
+    })).toEqual([0, 1]);
+  });
+
+  test('minimum weight with free variable', () => {
+    // buttons: 0→{0}, 1→{1}, 2→{0,1}
+    // target [T,T]: press 0+1 (weight 2) or press 2 (weight 1)
+    expect(solveToggle({
+      target: [true, true],
+      buttons: [[0], [1], [0, 1]],
+    })).toEqual([2]);
+  });
+
+  test('lex-smallest tie-breaking: same weight, prefer earlier indices', () => {
+    // buttons 0 and 1 both toggle light 0
+    // target [T]: press 0 (weight 1) or press 1 (weight 1)
+    // lex-smallest: [0]
+    expect(solveToggle({
+      target: [true],
+      buttons: [[0], [0]],
+    })).toEqual([0]);
+  });
+
+  test('all-off target with buttons → empty', () => {
+    expect(solveToggle({
+      target: [false, false, false],
+      buttons: [[0, 1], [1, 2], [0, 2]],
+    })).toEqual([]);
+  });
+
+  test('three buttons, need exactly two', () => {
+    // b0→{0,1}, b1→{1,2}, b2→{2}
+    // target [T,F,T]
+    // Press b0: [T,T,F]. Press b0+b1: [T,F,T]. ✓ Weight 2.
+    // Press b0+b2: [T,T,T]. No.
+    // Press b1: [F,T,T]. No.
+    // Press b1+b2: [F,T,F]. No.
+    // Press b2: [F,F,T]. No.
+    // Press b0+b1+b2: [T,F,F]. No.
+    expect(solveToggle({
+      target: [true, false, true],
+      buttons: [[0, 1], [1, 2], [2]],
+    })).toEqual([0, 1]);
+  });
+
+  test('larger puzzle: 6 lights, 6 buttons', () => {
+    // Identity-like: each button toggles one light
+    const buttons = [[0], [1], [2], [3], [4], [5]];
+    const target = [true, false, true, false, true, false];
+    expect(solveToggle({ target, buttons })).toEqual([0, 2, 4]);
+  });
+
+  test('button toggles no lights → free variable, not pressed', () => {
+    // b0 toggles light 0, b1 toggles nothing
+    // target [T]
+    expect(solveToggle({
+      target: [true],
+      buttons: [[0], []],
+    })).toEqual([0]);
+  });
+
+  test('duplicate light in button definition cancels', () => {
+    // b0 toggles [0,0] = no net effect
+    expect(solveToggle({
+      target: [true],
+      buttons: [[0, 0]],
+    })).toBeNull();
+  });
+
+  test('multiple free variables, finds minimum', () => {
+    // 1 light, 3 buttons all toggling light 0
+    // target [T]: any odd subset works
+    // Weight 1: {0}, {1}, {2}. Lex-smallest: {0}.
+    expect(solveToggle({
+      target: [true],
+      buttons: [[0], [0], [0]],
+    })).toEqual([0]);
+  });
+});
+
+describe('solveCounter', () => {
+  test('single button, single counter', () => {
+    expect(solveCounter([3], [[0]], 5)).toEqual([3]);
+  });
+
+  test('target all zeros → press nothing', () => {
+    expect(solveCounter([0, 0], [[0], [1]], 5)).toEqual([0, 0]);
+  });
+
+  test('no buttons, all-zero target → empty', () => {
+    expect(solveCounter([0], [], 3)).toEqual([]);
+  });
+
+  test('no buttons, non-zero target → null', () => {
+    expect(solveCounter([1], [], 3)).toBeNull();
+  });
+
+  test('no solution: inconsistent system', () => {
+    // Single button affects both counters equally
+    // target [1, 2] mod 3: need x≡1 and x≡2, impossible
+    expect(solveCounter([1, 2], [[0, 1]], 3)).toBeNull();
+  });
+
+  test('two independent buttons', () => {
+    expect(solveCounter([2, 3], [[0], [1]], 5)).toEqual([2, 3]);
+  });
+
+  test('minimum total with free variable', () => {
+    // b0→{0}, b1→{1}, b2→{0,1}
+    // target [1, 0] mod 3
+    // x0+x2≡1, x1+x2≡0
+    // x2=0: x0=1, x1=0 → total 1
+    // x2=1: x0=0, x1=2 → total 3
+    // x2=2: x0=2, x1=1 → total 5
+    expect(solveCounter([1, 0], [[0], [1], [0, 1]], 3)).toEqual([1, 0, 0]);
+  });
+
+  test('lex-smallest tie-breaking', () => {
+    // Two identical buttons affecting one counter
+    // target [1] mod 3
+    // x0+x1≡1 (mod 3)
+    // Solutions with total 1: (0,1) and (1,0)
+    // Lex-smallest: [0, 1]
+    expect(solveCounter([1], [[0], [0]], 3)).toEqual([0, 1]);
+  });
+
+  test('modulus 2 behaves like toggle', () => {
+    // mod 2: same as GF(2) toggle
+    expect(solveCounter([1, 1], [[0], [1]], 2)).toEqual([1, 1]);
+  });
+
+  test('larger modulus', () => {
+    // Single counter, single button, mod 97
+    expect(solveCounter([50], [[0]], 97)).toEqual([50]);
+  });
+
+  test('modular wrap-around in solution', () => {
+    // b0→{0,1}, target [1, 2] mod 5
+    // Press b0 x times: counter0=x, counter1=x
+    // Need x≡1 and x≡2 → impossible
+    expect(solveCounter([1, 2], [[0, 1]], 5)).toBeNull();
+  });
+
+  test('counter with multiple buttons and free variable', () => {
+    // 2 counters, 3 buttons, mod 5
+    // b0→{0}, b1→{1}, b2→{0,1}
+    // target [3, 4]
+    // x0+x2≡3, x1+x2≡4
+    // x2=0: x0=3, x1=4. total=7
+    // x2=1: x0=2, x1=3. total=6
+    // x2=2: x0=1, x1=2. total=5
+    // x2=3: x0=0, x1=1. total=4
+    // x2=4: x0=4, x1=0. total=8
+    expect(solveCounter([3, 4], [[0], [1], [0, 1]], 5)).toEqual([0, 1, 3]);
+  });
+
+  test('empty target → all zeros', () => {
+    expect(solveCounter([], [[0], [1]], 5)).toEqual([0, 0]);
+  });
+});
