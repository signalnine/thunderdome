+import { describe, test, expect } from 'vitest';
+import { solveToggle, solveCounter } from '../index.js';
+
+describe('solveToggle advanced', () => {
+  test('all buttons needed', () => {
+    // 4 lights, 4 buttons (identity)
+    const result = solveToggle({
+      target: [true, true, true, true],
+      buttons: [[0], [1], [2], [3]],
+    });
+    expect(result).toEqual([0, 1, 2, 3]);
+  });
+
+  test('overlapping buttons with unique solution', () => {
+    // b0→{0,1,2}, b1→{1,2,3}, b2→{2,3,4}
+    // target [T,T,F,F,T]
+    // b0: [1,1,1,0,0]
+    // b0+b2: [1,1,0,1,1]
+    // b0+b1: [1,0,0,1,0]
+    // b0+b1+b2: [1,0,1,0,1] → matches [T,F,T,F,T] not our target
+    // Let me compute manually:
+    // target: light0=1, light1=1, light2=0, light3=0, light4=1
+    // System: b0=1 (light0), b0^b1=1 (light1), b0^b1^b2=0 (light2), b1^b2=0 (light3), b2=1 (light4)
+    // From light4: b2=1
+    // From light3: b1^1=0 → b1=1
+    // From light2: b0^1^1=0 → b0=0
+    // From light1: 0^1=1 ✓
+    // From light0: 0=1 ✗ → no solution!
+    const result = solveToggle({
+      target: [true, true, false, false, true],
+      buttons: [[0, 1, 2], [1, 2, 3], [2, 3, 4]],
+    });
+    expect(result).toBeNull();
+  });
+
+  test('10 lights, 10 buttons identity', () => {
+    const buttons = Array.from({ length: 10 }, (_, i) => [i]);
+    const target = Array.from({ length: 10 }, (_, i) => i % 2 === 0);
+    const result = solveToggle({ target, buttons });
+    expect(result).toEqual([0, 2, 4, 6, 8]);
+  });
+
+  test('free variables with many solutions picks minimum weight', () => {
+    // 2 lights, 5 buttons
+    // b0→{0}, b1→{1}, b2→{0}, b3→{1}, b4→{0,1}
+    // target [T,T]
+    // Many solutions. Minimum weight: press b4 (weight 1)
+    const result = solveToggle({
+      target: [true, true],
+      buttons: [[0], [1], [0], [1], [0, 1]],
+    });
+    expect(result).toEqual([4]);
+  });
+
+  test('lex tie-break with multiple free vars', () => {
+    // 1 light, 4 buttons all toggling light 0
+    // target [T]
+    // Weight-1 solutions: {0}, {1}, {2}, {3}
+    // Lex-smallest: {0}
+    const result = solveToggle({
+      target: [true],
+      buttons: [[0], [0], [0], [0]],
+    });
+    expect(result).toEqual([0]);
+  });
+
+  test('performance: 20 lights, 20 buttons', () => {
+    const m = 20;
+    const buttons: number[][] = [];
+    for (let i = 0; i < m; i++) {
+      buttons.push([i % m, (i + 1) % m]);
+    }
+    const target = new Array(m).fill(false);
+    target[0] = true;
+    target[1] = true;
+    const start = Date.now();
+    const result = solveToggle({ target, buttons });
+    const elapsed = Date.now() - start;
+    expect(elapsed).toBeLessThan(5000);
+    expect(result).not.toBeNull();
+    // Verify the solution
+    if (result) {
+      const state = new Array(m).fill(false);
+      for (const bi of result) {
+        for (const li of buttons[bi]) {
+          state[li] = !state[li];
+        }
+      }
+      expect(state).toEqual(target);
+    }
+  });
+
+  test('verify solution correctness helper', () => {
+    // Helper that checks solution correctness
+    const target = [true, false, true, true, false];
+    const buttons = [[0, 2], [1, 3], [0, 1, 4], [2, 3, 4], [0, 3]];
+    const result = solveToggle({ target, buttons });
+    if (result !== null) {
+      const state = new Array(target.length).fill(false);
+      for (const bi of result) {
+        for (const li of buttons[bi]) {
+          state[li] = !state[li];
+        }
+      }
+      expect(state).toEqual(target);
+    }
+  });
+});
+
+describe('solveCounter advanced', () => {
+  test('three counters, three buttons, mod 7', () => {
+    // Identity: b0→{0}, b1→{1}, b2→{2}
+    // target [3, 5, 2]
+    expect(solveCounter([3, 5, 2], [[0], [1], [2]], 7)).toEqual([3, 5, 2]);
+  });
+
+  test('counter with wrap-around solution', () => {
+    // b0→{0}, target [0] mod 5
+    // Solution: press 0 times → [0]
+    expect(solveCounter([0], [[0]], 5)).toEqual([0]);
+  });
+
+  test('free variable picks minimum total', () => {
+    // 1 counter, 2 buttons both incrementing counter 0, mod 5
+    // target [3]: x0+x1≡3 (mod 5)
+    // Solutions: (0,3)→3, (1,2)→3, (2,1)→3, (3,0)→3, (4,4)→8
+    // All have total 3 except (4,4)→8. Among total-3: lex-smallest is [0,3]
+    expect(solveCounter([3], [[0], [0]], 5)).toEqual([0, 3]);
+  });
+
+  test('minimum total wins over lex', () => {
+    // 2 counters, 3 buttons, mod 7
+    // b0→{0}, b1→{1}, b2→{0,1}
+    // target [5, 3]
+    // x0+x2≡5, x1+x2≡3 (mod 7)
+    // x2=0: x0=5, x1=3 → total=8
+    // x2=1: x0=4, x1=2 → total=7
+    // x2=2: x0=3, x1=1 → total=6
+    // x2=3: x0=2, x1=0 → total=5
+    // x2=4: x0=1, x1=6 → total=11
+    // x2=5: x0=0, x1=5 → total=10
+    // x2=6: x0=6, x1=4 → total=16
+    // Best: x2=3 → [2, 0, 3], total=5
+    expect(solveCounter([5, 3], [[0], [1], [0, 1]], 7)).toEqual([2, 0, 3]);
+  });
+
+  test('performance: mod 97 with unique solution', () => {
+    const m = 10;
+    const buttons: number[][] = Array.from({ length: m }, (_, i) => [i]);
+    const lights = Array.from({ length: m }, (_, i) => (i * 13 + 7) % 97);
+    const start = Date.now();
+    const result = solveCounter(lights, buttons, 97);
+    const elapsed = Date.now() - start;
+    expect(elapsed).toBeLessThan(5000);
+    expect(result).toEqual(lights);
+  });
+
+  test('verify counter solution correctness', () => {
+    const p = 5;
+    const lights = [2, 3, 1];
+    const buttons = [[0, 1], [1, 2], [0, 2]];
+    const result = solveCounter(lights, buttons, p);
+    if (result !== null) {
+      const state = new Array(lights.length).fill(0);
+      for (let i = 0; i < buttons.length; i++) {
+        for (const cj of buttons[i]) {
+          state[cj] = (state[cj] + result[i]) % p;
+        }
+      }
+      expect(state).toEqual(lights);
+    }
+  });
+
+  test('large modulus stress', () => {
+    // Single button, mod 97, target 50
+    expect(solveCounter([50], [[0]], 97)).toEqual([50]);
+  });
+
+  test('2 free variables, mod 97', () => {
+    // 1 counter, 3 buttons, mod 97
+    // b0,b1,b2 all increment counter 0
+    // target [1]
+    // x0+x1+x2≡1 (mod 97)
+    // Minimum total: 1 (e.g., [0,0,1] or [0,1,0] or [1,0,0])
+    // Lex-smallest with total 1: [0,0,1]
+    const result = solveCounter([1], [[0], [0], [0]], 97);
+    expect(result).toEqual([0, 0, 1]);
+  });
+});
