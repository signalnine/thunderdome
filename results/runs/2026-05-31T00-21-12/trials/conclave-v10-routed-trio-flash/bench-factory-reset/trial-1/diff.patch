+export function solveToggle(machine: Machine): number[] | null {
+  const { target, buttons } = machine;
+  const N = target.length;
+  const M = buttons.length;
+
+  if (M === 0) {
+    return target.every((t) => !t) ? [] : null;
+  }
+
+  const matrix: number[][] = [];
+  for (let row = 0; row < N; row++) {
+    const r = new Array(M + 1).fill(0);
+    for (let col = 0; col < M; col++) {
+      if (buttons[col].includes(row)) {
+        r[col] = 1;
+      }
+    }
+    r[M] = target[row] ? 1 : 0;
+    matrix.push(r);
+  }
+
+  const pivotCol: number[] = [];
+  let curRow = 0;
+
+  for (let col = 0; col < M && curRow < N; col++) {
+    let pivotRow = -1;
+    for (let row = curRow; row < N; row++) {
+      if (matrix[row][col] === 1) {
+        pivotRow = row;
+        break;
+      }
+    }
+    if (pivotRow === -1) continue;
+
+    [matrix[curRow], matrix[pivotRow]] = [matrix[pivotRow], matrix[curRow]];
+    pivotCol.push(col);
+
+    for (let row = 0; row < N; row++) {
+      if (row !== curRow && matrix[row][col] === 1) {
+        for (let c = 0; c <= M; c++) {
+          matrix[row][c] ^= matrix[curRow][c];
+        }
+      }
+    }
+    curRow++;
+  }
+
+  const rank = pivotCol.length;
+
+  for (let row = rank; row < N; row++) {
+    if (matrix[row][M] === 1) {
+      return null;
+    }
+  }
+
+  const pivotColSet = new Set(pivotCol);
+  const freeCols: number[] = [];
+  for (let col = 0; col < M; col++) {
+    if (!pivotColSet.has(col)) freeCols.push(col);
+  }
+  const freeCount = freeCols.length;
+
+  const particular = new Array(M).fill(0);
+  for (let i = 0; i < rank; i++) {
+    particular[pivotCol[i]] = matrix[i][M];
+  }
+
+  if (freeCount === 0) {
+    const result: number[] = [];
+    for (let i = 0; i < M; i++) {
+      if (particular[i] === 1) result.push(i);
+    }
+    return result;
+  }
+
+  const nullVecs: number[][] = [];
+  for (const fc of freeCols) {
+    const nv = new Array(M).fill(0);
+    nv[fc] = 1;
+    for (let i = 0; i < rank; i++) {
