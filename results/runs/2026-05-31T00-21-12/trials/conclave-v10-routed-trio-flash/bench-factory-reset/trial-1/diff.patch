+    toggleBranchAndBound(
+      freeCount,
+      nullLos,
+      nullHis,
+      partLo,
+      partHi,
+      M,
+      matrix,
+      pivotCol,
+      freeCols,
+      rank,
+      (w: number, lo: number, hi: number) => {
+        if (
+          w < bestWeight ||
+          (w === bestWeight && lexSmallerPair(lo, hi, bestLo, bestHi))
+        ) {
+          bestWeight = w;
+          bestLo = lo;
+          bestHi = hi;
+        }
+      },
+    );
+  }
+
+  return pairToIndices(bestLo, bestHi, M);
