+  let initWeight = 0;
+  for (let i = 0; i < rank; i++) {
+    if (maxFreeDep[i] === -1) {
+      const pc = pivotCol[i];
+      if (pc < 20) {
+        initWeight += (partLo >> pc) & 1;
