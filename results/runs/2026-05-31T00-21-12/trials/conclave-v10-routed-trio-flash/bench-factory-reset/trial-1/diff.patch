+
+function toggleBranchAndBound(
+  freeCount: number,
+  nullLos: number[],
+  nullHis: number[],
+  partLo: number,
+  partHi: number,
+  M: number,
+  matrix: number[][],
+  pivotCol: number[],
+  freeCols: number[],
+  rank: number,
+  report: (w: number, lo: number, hi: number) => void,
+): void {
+  const maxFreeDep = new Array(rank).fill(-1);
+  for (let i = 0; i < rank; i++) {
+    for (let f = freeCount - 1; f >= 0; f--) {
+      if (matrix[i][freeCols[f]] === 1) {
+        maxFreeDep[i] = f;
+        break;
+      }
+    }
+  }
