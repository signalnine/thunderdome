+        if (
+          runningSum < bestSum ||
+          (runningSum === bestSum &&
+            (bestSolution === null || lexSmallerArr(currentSol, bestSolution)))
+        ) {
+          bestSum = runningSum;
+          bestSolution = currentSol.slice();
+        }
+        return;
+      }
+
+      const saved = currentSol.slice();
+
+      for (let v = 0; v < modulus; v++) {
+        if (v > 0) {
+          for (let j = 0; j < M; j++) {
+            currentSol[j] = (saved[j] + nullVecs[depth][j] * v) % modulus;
+          }
+        } else {
+          for (let j = 0; j < M; j++) {
+            currentSol[j] = saved[j];
+          }
+        }
+
+        let newContrib = 0;
+        const fc = freeCols[depth];
+        const fcRow = pivotColToRow.get(fc);
+        if (fcRow === undefined) {
+          newContrib += currentSol[fc];
+        }
+        for (let i = 0; i < rank; i++) {
+          if (maxFreeDep[i] === depth) {
+            newContrib += currentSol[pivotCol[i]];
+          }
+        }
+
+        const lb = runningSum + newContrib;
+        if (lb <= bestSum) {
+          dfs(depth + 1, runningSum + newContrib);
+        }
+      }
+
+      for (let j = 0; j < M; j++) {
+        currentSol[j] = saved[j];
+      }
+    };
+
+    let initSum = 0;
+    for (let i = 0; i < rank; i++) {
+      if (maxFreeDep[i] === -1) {
+        initSum += particular[pivotCol[i]];
+      }
+    }
+
+    dfs(0, initSum);
+  }
+
+  return bestSolution;
+}
+
+function lexSmallerArr(a: number[], b: number[]): boolean {
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] < b[i]) return true;
+    if (a[i] > b[i]) return false;
+  }
+  return false;
+}
+
+function modInverseTable(p: number): number[] {
+  const table = new Array(p).fill(0);
+  table[1] = 1;
+  for (let i = 2; i < p; i++) {
+    table[i] = (p - Math.floor(p / i) * table[p % i]) % p;
+    if (table[i] < 0) table[i] += p;
+  }
+  return table;
+}
