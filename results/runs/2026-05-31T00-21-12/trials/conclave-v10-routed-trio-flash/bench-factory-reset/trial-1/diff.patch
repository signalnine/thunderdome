+      if (
+        w < bestWeight ||
+        (w === bestWeight && lexSmallerPair(curLo, curHi, bestLo, bestHi))
+      ) {
+        bestWeight = w;
+        bestLo = curLo;
+        bestHi = curHi;
+      }
+    }
