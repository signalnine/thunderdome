ution exists', () => {\n    expect(solveCounter([0, 1], [[0]], 3)).toEqual(null);\n  });\n\n  it('handles modular wrapping', () => {\n    expect(solveCounter([0], [[0]], 5)).toEqual([0]);\n  });\n\n  it('finds minimum total presses', () => {\n    const result = solveCounter([3], [[0], [0]], 5);\n    expect(result).toEqual([0, 3]);\n  });\n\n  it('picks lexicographically smallest among tied solutions', () => {\n    const result = solveCounter([1], [[0], [0]], 7);\n    expect(result).toEqual([0, 1]);\n  });\n\n  it('handles two counters', () => {\n    expect(solveCounter([1, 2], [[0], [1]], 3)).toEqual([1, 2]);\n  });\n\n  it('handles overlapping buttons', () => {\n    const result = solveCounter([2, 3], [[0, 1], [1]], 5);\n    expect(result).toEqual([2, 1]);\n    expect(verifyCounter([2, 3], [[0, 1], [1]], result!, 5)).toBe(true);\n  });\n\n  it('handles no buttons with zero target', () => {\n    expect(solveCounter([0, 0], [], 3)).toEqual([]);\n  });\n\n  it('handles no buttons with non-zero target', () => {\n    expect(solveCounter([1], [], 3)).toEqual(null);\n  });\n\n  it('handles larger modulus', () => {\n    expect(solveCounter([50], [[0]], 97)).toEqual([50]);\n  });\n\n  it('handles button pressing multiple times for wrapping', () => {\n    expect(solveCounter([1], [[0]], 5)).toEqual([1]);\n  });\n\n  it('handles system with free variables - minimizes total', () => {\n    const result = solveCounter([1], [[0], [0], [0]], 5);\n    expect(result).toEqual([0, 0, 1]);\n  });\n\n  it('counter: mod 2 behaves like toggle', () => {\n    // mod 2, 2 counters, target [1, 1]\n    // Button 0: [0, 1] (toggles both)\n    // Single press gives [1, 1] ✓\n    const result = solveCounter([1, 1], [[0, 1]], 2);\n    expect(result).toEqual([1]);\n  });\n\n  it('handles larger system with unique solution', () => {\n    // 4 counters, 4 buttons, identity mapping, mod 7\n    const result = solveCounter([3, 1, 4, 6], [[0], [1], [2], [3]], 7);\n    expect(result).toEqual([3, 1, 4, 6])