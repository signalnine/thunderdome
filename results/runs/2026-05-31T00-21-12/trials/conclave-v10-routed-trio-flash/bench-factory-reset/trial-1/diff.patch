+
+function popcount32(n: number): number {
+  n = n - ((n >> 1) & 0x55555555);
+  n = (n & 0x33333333) + ((n >> 2) & 0x33333333);
+  n = (n + (n >> 4)) & 0x0f0f0f0f;
+  return (n * 0x01010101) >> 24;
+}
+
+function popcountPair(lo: number, hi: number): number {
+  return popcount32(lo) + popcount32(hi);
+}
+
+function lexSmallerPair(
+  aLo: number,
+  aHi: number,
+  bLo: number,
+  bHi: number,
+): boolean {
+  const diffLo = aLo ^ bLo;
+  if (diffLo !== 0) {
+    const lowest = diffLo & -diffLo;
+    return (aLo & lowest) !== 0;
+  }
+  const diffHi = aHi ^ bHi;
+  if (diffHi !== 0) {
+    const lowest = diffHi & -diffHi;
+    return (aHi & lowest) !== 0;
+  }
+  return false;
+}
+
+function arrToPair(arr: number[], M: number): [number, number] {
+  let lo = 0;
+  let hi = 0;
+  for (let i = 0; i < M; i++) {
+    if (arr[i]) {
+      if (i < 20) lo |= 1 << i;
+      else hi |= 1 << (i - 20);
+    }
+  }
+  return [lo, hi];
+}
+
+function pairToIndices(lo: number, hi: number, M: number): number[] {
+  const result: number[] = [];
+  for (let i = 0; i < Math.min(M, 20); i++) {
+    if (lo & (1 << i)) result.push(i);
+  }
+  for (let i = 20; i < M; i++) {
+    if (hi & (1 << (i - 20))) result.push(i);
+  }
+  return result;
+}
