pe', 'pipe'] }\n48\t      );\n49\t    } catch (err) {\n50\t      const error = err as { stdout?: string; stderr?: string; status?: number };\n51\t      stdout = error.stdout || '';\n52\t      exitCode = error.status || 1;\n53\t    }\n54\t\n55\t    if (exitCode !== 0) {\n56\t      throw new Error(`Circular dependencies found:\\n${stdout}`);\n57\t    }\n58\t  });\n59\t\n60\t  it('has no merge conflict markers in any TypeScript file', () => {\n61\t    const tsFiles = getAllTsFiles(join(ROOT_DIR, 'packages'));\n62\t    const filesWithMarkers: string[] = [];\n63\t\n64\t    for (const file of tsFiles) {\n65\t      const content = readFileSync(file, 'utf-8');\n66\t      if (\n67\t        content.includes('<<<<<<<') ||\n68\t        content.includes('>>>>>>>') ||\n69\t        content.includes('=======\\n')\n70\t      ) {\n71\t        filesWithMarkers.push(file.replace(ROOT_DIR + '/', ''));\n72\t      }\n73\t    }\n74\t\n75\t    expect(filesWithMarkers).toEqual([]);\n76\t  });\n77\t\n78\t  it('has no .env files with secrets', () => {\n79\t    const allFiles = getAllFiles(ROOT_DIR);\n80\t    const envFiles = allFiles.filter((f) => {\n81\t      const name = f.split('/').pop() || '';\n82\t      return name === '.env' || name.match(/^\\.env\\./);\n83\t    });\n84\t\n85\t    const envFilesWithSecrets: string[] = [];\n86\t    for (const envFile of envFiles) {\n87\t      const content = readFileSync(envFile, 'utf-8');\n88\t      if (\n89\t        content.includes('PASSWORD') ||\n90\t        content.includes('SECRET') ||\n91\t        content.includes('TOKEN') ||\n92\t        content.includes('API_KEY')\n93\t      ) {\n94\t        envFilesWithSecrets.push(envFile.replace(ROOT_DIR + '/', ''));\n95\t      }\n96\t    }\n97\t\n98\t    expect(envFilesWithSecrets).toEqual([]);\n99\t  });\n100\t\n101\t  it('all packages build successfully', () => {\n102\t    try {\n103\t      execSync('npx tsc -b --force', {\n104\t        cwd: ROOT_DIR,\n105\t        encoding: 'utf-8',\n106\t        timeout: