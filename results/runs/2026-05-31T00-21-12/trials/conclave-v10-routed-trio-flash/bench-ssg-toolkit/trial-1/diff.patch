  await plugin.hooks.afterBuild!(ctx);\n56\t    expect(ctx.output.has('tags/javascript.html')).toBe(true);\n57\t    expect(ctx.output.get('tags/javascript.html')).toContain('Post 1');\n58\t  });\n59\t\n60\t  it('handles files with no tags', async () => {\n61\t    const files = [\n62\t      makeFile({ slug: 'post-1', title: 'Post 1' }),\n63\t    ];\n64\t    const ctx = makeCtx(files);\n65\t    await plugin.hooks.beforeBuild!(ctx);\n66\t    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n67\t    expect(tagMap.size).toBe(0);\n68\t  });\n69\t\n70\t  it('handles files with multiple tags', async () => {\n71\t    const files = [\n72\t      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['js', 'node', 'web'] }),\n73\t    ];\n74\t    const ctx = makeCtx(files);\n75\t    await plugin.hooks.beforeBuild!(ctx);\n76\t    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n77\t    expect(tagMap.size).toBe(3);\n78\t    expect(tagMap.has('js')).toBe(true);\n79\t    expect(tagMap.has('node')).toBe(true);\n80\t    expect(tagMap.has('web')).toBe(true);\n81\t  });\n82\t\n83\t  it('tag pages list all files with that tag', async () => {\n84\t    const files = [\n85\t      makeFile({ slug: 'post-1', title: 'First Post', tags: ['tech'] }),\n86\t      makeFile({ slug: 'post-2', title: 'Second Post', tags: ['tech'] }),\n87\t    ];\n88\t    const ctx = makeCtx(files);\n89\t    await plugin.hooks.beforeBuild!(ctx);\n90\t    await plugin.hooks.afterBuild!(ctx);\n91\t    const tagPage = ctx.output.get('tags/tech.html')!;\n92\t    expect(tagPage).toContain('First Post');\n93\t    expect(tagPage).toContain('Second Post');\n94\t  });\n95\t\n96\t  it('stores tag map in ctx.data', async () => {\n97\t    const files = [\n98\t      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['alpha'] }),\n99\t    ];\n100\t    const ctx = makeCtx(files);\n101\t    await plugin.hooks.beforeBuild!(ctx);\n102\t    expect(ctx.data.has('taxonomy-tags')).toBe(true