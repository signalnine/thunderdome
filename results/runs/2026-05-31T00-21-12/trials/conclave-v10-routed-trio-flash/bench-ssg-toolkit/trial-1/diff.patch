+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,38 @@
+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, ctx: BuildContext): ContentFile {
+        const discovered: string[] = [];
+
+        let content = file.content;
+
+        content = content.replace(/src="\.\/([^"]+)"/g, (_, filename: string) => {
+          discovered.push(filename);
+          return `src="/assets/${filename}"`;
+        });
+
+        content = content.replace(/href="\.\/([^"]+)"/g, (_, filename: string) => {
+          discovered.push(filename);
+          return `href="/assets/${filename}"`;
+        });
+
+        if (discovered.length > 0) {
+          const existing = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+          const assets = existing ? [...existing.assets, ...discovered] : discovered;
+          ctx.data.set('asset-manifest', { assets });
+        }
+
+        return { ...file, content };
+      },
+    },
+  };
+}
diff --git a/src/plugins/dev-server.ts b/src/plugins/dev-server.ts
new file mode 100644
index 0000000..14e7655
--- /dev/null
+++ b/src/plugins/dev-server.ts
@@ -0,0 +1,48 @@
+import type { Plugin, BuildContext } from '../core/types.js';
+
+interface DevServerRoute {
+  path: string;
+  handler: string;
+}
+
+interface DevServerConfig {
+  port: number;
+  routes: DevServerRoute[];
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const manifest = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;
+        const assetPaths = manifest?.assets ?? [];
+
+        const routes: DevServerRoute[] = [];
+
+        for (const asset of assetPaths) {
+          routes.push({ path: `/assets/${asset}`, handler: 'asset' });
+        }
+
+        for (const path of ctx.output.keys()) {
+          if (path.endsWith('.html')) {
+            routes.push({ path: `/${path}`, handler: 'static' });
+          }
+        }
+
+        const config: DevServerConfig = {
+          port: 3000,
+          routes,
+          assetPaths,
+          searchIndexPath: '/search-index.json',
+        };
+
+        ctx.data.set('dev-server-config', config);
+      },
+    },
+  };
+}
