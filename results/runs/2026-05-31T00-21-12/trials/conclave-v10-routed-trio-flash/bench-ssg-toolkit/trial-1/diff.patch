+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,47 @@
+import { marked } from 'marked';
+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, _ctx: BuildContext): ContentFile {
+        let content = file.content;
+
+        // Convert admonition containers :::type\n...\n::: to HTML divs
+        content = content.replace(
+          /:::(\w+)\n([\s\S]*?)\n:::/g,
+          (_, type: string, inner: string) =>
+            `<div class="admonition admonition-${type}">\n${inner}\n</div>`,
+        );
+
+        // Extract footnote definitions [^n]: text
+        const footnotes = new Map<string, string>();
+        content = content.replace(/^\[\^(\d+)\]:\s*(.+)$/gm, (_, id: string, text: string) => {
+          footnotes.set(id, text.trim());
+          return '';
+        });
+
+        // Replace inline footnote references [^n] with superscript links
+        content = content.replace(
+          /\[\^(\d+)\]/g,
+          (_, id: string) => `<sup><a href="#fn-${id}">${id}</a></sup>`,
+        );
+
+        const html = marked.parse(content) as string;
+
+        let result = html;
+        if (footnotes.size > 0) {
+          const items = Array.from(footnotes.entries())
+            .map(([id, text]) => `<li id="fn-${id}">${text}</li>`)
+            .join('\n');
+          result += `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+        }
+
+        return { ...file, content: result };
+      },
+    },
+  };
+}
