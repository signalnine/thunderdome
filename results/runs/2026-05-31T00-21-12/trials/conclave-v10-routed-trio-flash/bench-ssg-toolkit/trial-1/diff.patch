+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VCDh9T81HguhfQgGSpazGd","type":"tool_result","content":"1\timport { BuildContext, ContentFile, Plugin, SiteConfig, Template } from './types.js';\n2\t\n3\texport class BuildEngine {\n4\t  private plugins: Plugin[] = [];\n5\t  private templates: Map<string, Template> = new Map();\n6\t\n7\t  constructor(private config: SiteConfig) {}\n8\t\n9\t  registerPlugin(plugin: Plugin): void {\n10\t    this.plugins.push(plugin);\n11\t  }\n12\t\n13\t  registerTemplate(template: Template): void {\n14\t    this.templates.set(template.name, template);\n15\t  }\n16\t\n17\t  // Resolve plugin execution order using topological sort\n18\t  resolvePluginOrder(): Plugin[] {\n19\t    const sorted: Plugin[] = [];\n20\t    const visited = new Set<string>();\n21\t    const visiting = new Set<string>();\n22\t    const pluginMap = new Map(this.plugins.map(p => [p.name, p]));\n23\t\n24\t    const visit = (name: string) => {\n25\t      if (visited.has(name)) return;\n26\t      if (visiting.has(name)) {\n27\t        throw new Error(`Circular dependency detected: ${name}`);\n28\t      }\n29\t      visiting.add(name);\n30\t      const plugin = pluginMap.get(name);\n31\t      if (plugin) {\n32\t        for (const dep of plugin.dependencies) {\n33\t          if (!pluginMap.has(dep)) {\n34\t            throw new Error(`Missing dependency: ${name} requires ${dep}`);\n35\t          }\n36\t          visit(dep);\n37\t        }\n38\t      }\n39\t      visiting.delete(name);\n40\t      visited.add(name);\n41\t      if (plugin) sorted.push(plugin);\n42\t    };\n43\t\n44\t    for (const plugin of this.plugins) {\n45\t      visit(plugin.name);\n46\t    }\n47\t    return sorted;\n48\t  }\n49\t\n50\t  async build(files: ContentFile[]): Promise<BuildContext> {\n51\t    const ctx: BuildContext = {\n52\t      config: this.config,\n53\t      files: [...files],\n54\t      output: new Map(),\n55\t      assets: new Map(),\n56\t      data: new Map