x.data.get('dev-server-config') as DevServerConfig;\n56\t    expect(config.assetPaths).toContain('image.png');\n57\t    expect(config.assetPaths).toContain('style.css');\n58\t    const assetRoutes = config.routes.filter(r => r.handler === 'asset');\n59\t    expect(assetRoutes.length).toBeGreaterThanOrEqual(2);\n60\t  });\n61\t\n62\t  it('config includes search index path', async () => {\n63\t    const output = new Map<string, string>();\n64\t    output.set('search-index.json', '[]');\n65\t    const ctx = makeCtx(output);\n66\t    await plugin.hooks.afterBuild!(ctx);\n67\t    const config = ctx.data.get('dev-server-config') as DevServerConfig;\n68\t    expect(config.searchIndexPath).toBe('/search-index.json');\n69\t  });\n70\t\n71\t  it('config includes content routes', async () => {\n72\t    const output = new Map<string, string>();\n73\t    output.set('post-1.html', '<html></html>');\n74\t    output.set('post-2.html', '<html></html>');\n75\t    const ctx = makeCtx(output);\n76\t    await plugin.hooks.afterBuild!(ctx);\n77\t    const config = ctx.data.get('dev-server-config') as DevServerConfig;\n78\t    const contentRoutes = config.routes.filter(r => r.handler === 'static');\n79\t    expect(contentRoutes.length).toBe(2);\n80\t  });\n81\t\n82\t  it('default port is 3000', async () => {\n83\t    const ctx = makeCtx();\n84\t    await plugin.hooks.afterBuild!(ctx);\n85\t    const config = ctx.data.get('dev-server-config') as DevServerConfig;\n86\t    expect(config.port).toBe(3000);\n87\t  });\n88\t\n89\t  it('handles missing asset-pipeline data gracefully', async () => {\n90\t    const ctx = makeCtx();\n91\t    await plugin.hooks.afterBuild!(ctx);\n92\t    const config = ctx.data.get('dev-server-config') as DevServerConfig;\n93\t    expect(config.assetPaths).toEqual([]);\n94\t  });\n95\t});\n96\t"}]},"parent_tool_use_id":"toolu_01RLTHZ3c1S17hzU13KX8ATq","session_id":"513d783b-a2db-4d05-8fed-6f013307be17","uuid":"152d137b-1bcf-48cd-a8b6-614536f11f28","timestamp":"2026-0