@@ -0,0 +1,32 @@
+import type { Plugin, BuildContext } from '../core/types.js';
+
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const index = ctx.files.map((file) => {
+          // Strip all HTML tags and normalize whitespace
+          const plainText = file.content
+            .replace(/<[^>]+>/g, ' ')
+            .replace(/\s+/g, ' ')
+            .trim();
+
+          const entry: Record<string, unknown> = {
+            slug: file.slug,
+            title: file.title,
+            content: plainText,
+          };
+          if (file.tags !== undefined) {
+            entry.tags = file.tags;
+          }
+          return entry;
+        });
+
+        ctx.output.set('search-index.json', JSON.stringify(index));
+      },
+    },
+  };
+}
