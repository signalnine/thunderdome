e.build([file]);\n54\t    const output = ctx.output.get('test-post.html')!;\n55\t    expect(output).toContain('<!DOCTYPE html>');\n56\t    expect(output).toContain('My Post');\n57\t    expect(output).toContain('<p>Content here</p>');\n58\t    expect(output).toContain('Test Site');\n59\t  });\n60\t\n61\t  it('builds with list template and renders list HTML', async () => {\n62\t    const engine = new BuildEngine(testConfig);\n63\t    engine.registerTemplate(createListTemplate());\n64\t    const file = makeFile({ title: 'My List', content: '<ul><li>Item</li></ul>', template: 'list' });\n65\t    const ctx = await engine.build([file]);\n66\t    const output = ctx.output.get('test-post.html')!;\n67\t    expect(output).toContain('<!DOCTYPE html>');\n68\t    expect(output).toContain('My List');\n69\t    expect(output).toContain('<div class=\"list\">');\n70\t    expect(output).toContain('<ul><li>Item</li></ul>');\n71\t  });\n72\t\n73\t  it('outputs raw content when no matching template', async () => {\n74\t    const engine = new BuildEngine(testConfig);\n75\t    const file = makeFile({ content: '<p>Raw content</p>' });\n76\t    const ctx = await engine.build([file]);\n77\t    expect(ctx.output.get('test-post.html')).toBe('<p>Raw content</p>');\n78\t  });\n79\t\n80\t  it('calls plugin beforeBuild hook', async () => {\n81\t    const engine = new BuildEngine(testConfig);\n82\t    let called = false;\n83\t    engine.registerPlugin(makePlugin({\n84\t      hooks: {\n85\t        beforeBuild: () => { called = true; },\n86\t      },\n87\t    }));\n88\t    await engine.build([]);\n89\t    expect(called).toBe(true);\n90\t  });\n91\t\n92\t  it('calls plugin transformContent hook to transform files', async () => {\n93\t    const engine = new BuildEngine(testConfig);\n94\t    engine.registerPlugin(makePlugin({\n95\t      hooks: {\n96\t        transformContent: (file) => ({\n97\t          ...file,\n98\t          content: file.content.toUpperCase(),\n99\t        }),\n100\t      },\n101\t    }));\n102\t    const ctx = await engine.build([makeFile({ content: 'hello' })]);\n103\t    expect(ctx.files[0].content).toBe('HELLO');\n104\t  });\n105\t\n106\t  it('calls plugin afterBuild hook', async () => {\n107\t    const engine = new BuildEngine(testConfig);\n108\t    let called = false;\n109\t    engine.registerPlugin(makePlugin({\n110\t      hooks: {\n111\t        afterBuild: () => { called = true; },\n112\t      },\n113\t    }));\n114\t    await engine.build([]);\n115\t    expect(called).toBe(true);\n116\t  });\n117\t\n118\t  it('executes plugins in dependency order', () => {\n119\t    const engine = new BuildEngine(testConfig);\n120\t    engine.registerPlugin(makePlugin({ name: 'b', dependencies: ['a'] }));\n121\t    engine.registerPlugin(makePlugin({ name: 'a', dependencies: [] }));\n122\t    const order = engine.resolvePluginOrder();\n123\t    expect(order.map(p => p.name)).toEqual(['a', 'b']);\n124\t  });\n125\t\n126\t  it('throws on circular dependency', () => {\n127\t    const engine = new BuildEngine(testConfig);\n128\t    engine.registerPlugin(makePlugin({ name: 'a', dependencies: ['b'] }));\n129\t    engine.registerPlugin(makePlugin({ name: 'b', dependencies: ['a'] }));\n130\t    expect(() => engine.resolvePluginOrder()).toThrow('Circular dependency');\n131\t  });\n132\t\n133\t  it('throws on missing dependency', () => {\n134\t    const engine = new BuildEngine(testConfig);\n135\t    engine.registerPlugin(makePlugin({ name: 'a', dependencies: ['missing'] }));\n136\t    expect(() => engine.resolvePluginOrder()).toThrow('Missing dependency');\n137\t  });\n138\t\n139\t  it('applies multiple plugins transformContent in order', async () => {\n140\t    const engine = new BuildEngine(testConfig);\n141\t    engine.registerPlugin(makePlugin({\n142\t      name: 'first',\n143\t      hooks: {\n144\t        transformContent: (file) => ({\n145\t          ...file,\n146\t          content: file.content + ' [first]',\n147\t        }),\n148\t      },\n149\t    }));