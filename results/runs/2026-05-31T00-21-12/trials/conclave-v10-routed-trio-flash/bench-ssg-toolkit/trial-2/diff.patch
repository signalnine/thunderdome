@@ -0,0 +1,50 @@
+import { marked } from 'marked';
+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      async transformContent(file: ContentFile, _ctx: BuildContext): Promise<ContentFile> {
+        let text = file.content;
+
+        // Pre-process admonition containers: :::type\ncontent\n:::
+        text = text.replace(/:::(\w+)\n([\s\S]*?)\n:::/g, (_match, type: string, body: string) => {
+          return `<div class="admonition admonition-${type}">${body}</div>`;
+        });
+
+        // Extract footnote definitions before markdown parsing
+        const footnotes = new Map<string, string>();
+        const defRegex = /\[\^(\d+)\]:\s*(.+)/g;
+        let m: RegExpExecArray | null;
+        while ((m = defRegex.exec(text)) !== null) {
+          footnotes.set(m[1], m[2].trim());
+        }
+        // Remove footnote definition lines
+        text = text.replace(/\[\^(\d+)\]:\s*.+\n?/g, '');
+        // Replace inline footnote references with HTML
+        text = text.replace(/\[\^(\d+)\]/g, (_match, num: string) => {
+          return `<sup><a href="#fn-${num}">${num}</a></sup>`;
+        });
+
+        // Convert markdown to HTML
+        const html = String(await Promise.resolve(marked.parse(text)));
+
+        // Append footnote section if any footnotes exist
+        let result = html;
+        if (footnotes.size > 0) {
+          let section = '<section class="footnotes"><ol>';
+          for (const [num, text] of footnotes) {
+            section += `<li id="fn-${num}">${text}</li>`;
+          }
+          section += '</ol></section>';
+          result += section;
+        }
+
+        return { ...file, content: result };
+      },
+    },
+  };
+}
