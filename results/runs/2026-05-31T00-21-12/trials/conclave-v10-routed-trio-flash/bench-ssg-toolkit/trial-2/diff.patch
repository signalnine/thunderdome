+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, ctx: BuildContext): ContentFile {
+        let manifest = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;
+        if (!manifest) {
+          manifest = { assets: [] };
+          ctx.data.set('asset-manifest', manifest);
+        }
+
+        const m = manifest;
+        let content = file.content;
+
+        // Rewrite src="./filename" -> src="/assets/filename"
+        content = content.replace(/src="\.\/([^"]+)"/g, (_match, filename: string) => {
+          if (!m.assets.includes(filename)) {
+            m.assets.push(filename);
+          }
+          return `src="/assets/${filename}"`;
+        });
+
+        // Rewrite href="./filename" -> href="/assets/filename"
+        content = content.replace(/href="\.\/([^"]+)"/g, (_match, filename: string) => {
+          if (!m.assets.includes(filename)) {
+            m.assets.push(filename);
+          }
+          return `href="/assets/${filename}"`;
+        });
+
+        return { ...file, content };
+      },
+    },
+  };
+}
