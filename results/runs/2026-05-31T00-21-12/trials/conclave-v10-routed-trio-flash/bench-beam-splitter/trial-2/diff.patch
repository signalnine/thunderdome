+type Direction = 'DOWN' | 'DOWN_LEFT' | 'DOWN_RIGHT';
+
+const DELTA: Record<Direction, readonly [number, number]> = {
+  DOWN: [1, 0],
+  DOWN_LEFT: [1, -1],
+  DOWN_RIGHT: [1, 1],
+};
+
+const DIR_IDX: Record<Direction, number> = { DOWN: 0, DOWN_LEFT: 1, DOWN_RIGHT: 2 };
+const IDX_DIR: Direction[] = ['DOWN', 'DOWN_LEFT', 'DOWN_RIGHT'];
+
+function findSourceCol(grid: string[][]): number {
+  return grid[0]?.indexOf('S') ?? -1;
+}
+
+function advance(r: number, c: number, dir: Direction, grid: string[][]): Array<[number, number, Direction]> {
+  if (grid[r][c] === '^') {
+    return [
+      [r + 1, c - 1, 'DOWN_LEFT'],
+      [r + 1, c + 1, 'DOWN_RIGHT'],
+    ];
+  }
+  const [dr, dc] = DELTA[dir];
+  return [[r + dr, c + dc, dir]];
+}
+
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  const cols = grid[0]?.length ?? 0;
+  if (!rows || !cols) return 0;
+
+  const srcCol = findSourceCol(grid);
+  if (srcCol === -1) return 0;
+
+  // Encode state as integer: (r * cols + c) * 3 + dirIndex
+  const sid = (r: number, c: number, dir: Direction) => (r * cols + c) * 3 + DIR_IDX[dir];
+
+  const visitedCells = new Set<number>();
+  const visitedStates = new Set<number>();
+
+  const queue: Array<[number, number, Direction]> = [[0, srcCol, 'DOWN']];
+  visitedStates.add(sid(0, srcCol, 'DOWN'));
+
+  let head = 0;
+  while (head < queue.length) {
+    const [r, c, dir] = queue[head++];
+    visitedCells.add(r * cols + c);
+
+    for (const [nr, nc, ndir] of advance(r, c, dir, grid)) {
+      if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) continue;
+      const s = sid(nr, nc, ndir);
+      if (!visitedStates.has(s)) {
+        visitedStates.add(s);
+        queue.push([nr, nc, ndir]);
+      }
+    }
+  }
+
+  return visitedCells.size;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  const cols = grid[0]?.length ?? 0;
+  if (!rows || !cols) return 0n;
+
+  const srcCol = findSourceCol(grid);
+  if (srcCol === -1) return 0n;
+
+  const sid = (r: number, c: number, dir: Direction) => (r * cols + c) * 3 + DIR_IDX[dir];
+
+  // Map from encoded state to path count
+  let current = new Map<number, bigint>();
+  current.set(sid(0, srcCol, 'DOWN'), 1n);
+
+  let total = 0n;
+
+  while (current.size > 0) {
+    const next = new Map<number, bigint>();
+
+    for (const [s, count] of current) {
+      const dirIdx = s % 3;
+      const pos = (s - dirIdx) / 3;
+      const r = Math.floor(pos / cols);
+      const c = pos % cols;
+      const dir = IDX_DIR[dirIdx];
+
+      for (const [nr, nc, ndir] of advance(r, c, dir, grid)) {
+        if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
+          total += count;
+        } else {
+          const ns = sid(nr, nc, ndir);
+          next.set(ns, (next.get(ns) ?? 0n) + count);
+        }
+      }
+    }
+
+    current = next;
+  }
+
+  return total;
+}
