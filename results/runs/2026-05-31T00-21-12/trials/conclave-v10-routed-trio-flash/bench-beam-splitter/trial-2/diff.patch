+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from './index.js';
+
+// Helper to build a grid from a string template
+function grid(rows: string[]): string[][] {
+  return rows.map(r => r.split(' '));
+}
+
+describe('countBeamCells', () => {
+  it('single source cell returns 1', () => {
+    expect(countBeamCells([['S']])).toBe(1);
+  });
+
+  it('straight-down beam visits all column cells', () => {
+    expect(countBeamCells([['S'], ['.'], ['.']])).toBe(3);
+  });
+
+  it('source at col 0 exits bottom', () => {
+    expect(countBeamCells([['S', '.'], ['.', '.']])).toBe(2); // (0,0),(1,0)
+  });
+
+  it('docs example 1: single splitter', () => {
+    const g = grid(['. S . . .', '. . . . .', '. ^ . . .', '. . . . .']);
+    expect(countBeamCells(g)).toBe(5);
+  });
+
+  it('docs example 2: two splitters, shared cell counts once', () => {
+    const g = grid(['. S . . .', '. ^ . . .', '^ . ^ . .', '. . . . .']);
+    expect(countBeamCells(g)).toBe(6);
+  });
+
+  it('splitter at left boundary: left split absorbed, right continues', () => {
+    // S at col 0, splitter below → left exits, right visits one more
+    const g = [['S', '.', '.'], ['^', '.', '.'], ['.', '.', '.']];
+    // beam: (0,0) → (1,0) hits ^ → (2,-1)[OOB] + (2,1)
+    // visited: (0,0),(1,0),(2,1) = 3
+    expect(countBeamCells(g)).toBe(3);
+  });
+
+  it('two beams merge at same cell same direction: counted once', () => {
+    // S, splitter, two more splitters whose right+left both land on same cell
+    // . S .
+    // . ^ .
+    // ^ . ^
+    // . . .
+    const g = [
+      ['.', 'S', '.'],
+      ['.', '^', '.'],
+      ['^', '.', '^'],
+      ['.', '.', '.'],
+    ];
+    // (0,1)→(1,1)'^'→(2,0)'^',(2,2)'^'
+    // (2,0)'^'→(3,-1)[OOB],(3,1)
+    // (2,2)'^'→(3,1),(3,3)[OOB col>=3]
+    // visited: (0,1),(1,1),(2,0),(2,2),(3,1) = 5
+    expect(countBeamCells(g)).toBe(5);
+  });
+
+  it('empty grid returns 0', () => {
+    expect(countBeamCells([])).toBe(0);
+  });
+
+  it('no source returns 0', () => {
+    expect(countBeamCells([['.', '.'], ['.', '.']])).toBe(0);
+  });
+
+  it('diagonal beam continues in same direction', () => {
+    // After split at row 1, down-right beam continues down-right
+    // S . . .
+    // ^ . . .
+    // . . . .
+    // . . . .
+    const g = [
+      ['S', '.', '.', '.'],
+      ['^', '.', '.', '.'],
+      ['.', '.', '.', '.'],
+      ['.', '.', '.', '.'],
+    ];
+    // (0,0)→(1,0)'^'→(2,-1)[OOB],(2,1)
+    // (2,1)→(3,2) [down-right continues]
+    // visited: (0,0),(1,0),(2,1),(3,2) = 4
+    expect(countBeamCells(g)).toBe(4);
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('single source, exits immediately (1-row grid)', () => {
+    // Source at row 0, beam moves to row 1 which doesn't exist
+    expect(countBeamPaths([['S']])).toBe(1n);
+  });
+
+  it('straight-down beam: 1 path', () => {
+    expect(countBeamPaths([['S'], ['.'], ['.']])).toBe(1n);
+  });
+
+  it('docs example 1: single splitter gives 2 paths', () => {
+    const g = grid(['. S . . .', '. . . . .', '. ^ . . .', '. . . . .']);
+    expect(countBeamPaths(g)).toBe(2n);
+  });
+
+  it('docs example 2: two splitters give 4 paths', () => {
+    const g = grid(['. S . . .', '. ^ . . .', '^ . ^ . .', '. . . . .']);
+    expect(countBeamPaths(g)).toBe(4n);
+  });
+
+  it('absorbed paths (exit through side) still count', () => {
+    // S at col 0, splitter → left exits, right exits: 2 paths
+    const g = [['S', '.'], ['^', '.'], ['.', '.']];
+    // (0,0)→(1,0)'^'→(2,-1)[OOB]+1, (2,1)→(3,2)[OOB]+1 = 2n
+    expect(countBeamPaths(g)).toBe(2n);
+  });
+
+  it('diagonal continues through empty cells: 1 path', () => {
+    const g = [
+      ['S', '.', '.', '.'],
+      ['^', '.', '.', '.'],
+      ['.', '.', '.', '.'],
+      ['.', '.', '.', '.'],
+    ];
+    // (2,-1)[OOB]+1, (2,1,DOWN_RIGHT)→(3,2,DOWN_RIGHT)→(4,3)[OOB]+1 = 2n
+    expect(countBeamPaths(g)).toBe(2n);
+  });
+
+  it('two beams at same cell same direction merges counts', () => {
+    const g = [
+      ['.', 'S', '.'],
+      ['.', '^', '.'],
+      ['^', '.', '^'],
+      ['.', '.', '.'],
+    ];
+    // paths: (3,-1)[OOB], (3,1)→(4,2)[OOB], (3,1)→(4,0)[OOB], (3,3)[OOB] = 4n
+    // Wait: (2,0)'^'→(3,-1)+1,(3,1,DOWN_RIGHT)
+    //        (2,2)'^'→(3,1,DOWN_LEFT),(3,3)+1
+    // (3,1,DOWN_RIGHT)→(4,2)+1
+    // (3,1,DOWN_LEFT)→(4,0)+1
+    // total = 4n
+    expect(countBeamPaths(g)).toBe(4n);
+  });
+
+  it('returns bigint type', () => {
+    const result = countBeamPaths([['S']]);
+    expect(typeof result).toBe('bigint');
+  });
+
+  it('empty grid returns 0n', () => {
+    expect(countBeamPaths([])).toBe(0n);
+  });
+
+  it('no source returns 0n', () => {
+    expect(countBeamPaths([['.', '.'], ['.', '.']])).toBe(0n);
+  });
+
+  it('performance: 200x200 grid with 50 splitters completes under 5s', () => {
+    const ROWS = 200;
+    const COLS = 200;
+    const g: string[][] = Array.from({ length: ROWS }, () => Array(COLS).fill('.'));
+    // S at col 100; splitters in a left-diagonal cascade so each left-split
+    // hits the next splitter: (1,100),(2,99),(3,98),...,(50,51)
+    g[0][100] = 'S';
+    for (let i = 0; i < 50; i++) {
+      g[i + 1][100 - i] = '^';
+    }
+
+    const start = Date.now();
+    const cells = countBeamCells(g);
+    const paths = countBeamPaths(g);
+    const elapsed = Date.now() - start;
+
+    expect(elapsed).toBeLessThan(5000);
+    expect(cells).toBeGreaterThan(0);
+    // Each splitter in the cascade adds 1 path: 50 splitters → 51 paths
+    expect(paths).toBe(51n);
+  });
+});
