@@ -0,0 +1,88 @@
+type Dir = 'D' | 'DL' | 'DR';
+
+const DIR_IDX: Record<Dir, number> = { D: 0, DL: 1, DR: 2 };
+const DIR_LIST: Dir[] = ['D', 'DL', 'DR'];
+const DC: Record<Dir, number> = { D: 0, DL: -1, DR: 1 };
+
+function children(c: number, dir: Dir, cell: string): [number, Dir][] {
+  if (cell === '^') {
+    return [[c - 1, 'DL'], [c + 1, 'DR']];
+  }
+  return [[c + DC[dir], dir]];
+}
+
+export function countBeamCells(grid: string[][]): number {
+  if (grid.length === 0) return 0;
+  const rows = grid.length;
+  const cols = grid[0].length;
+
+  const srcCol = grid[0].indexOf('S');
+  if (srcCol === -1) return 0;
+
+  const visited = new Set<number>();
+  visited.add(srcCol); // (0, srcCol)
+
+  // Map key: c * 3 + dir_index — deduplicates beams with same (col, direction) at each row
+  let level = new Map<number, true>();
+  level.set(srcCol * 3 + DIR_IDX['D'], true);
+
+  for (let r = 0; r < rows && level.size > 0; r++) {
+    const next = new Map<number, true>();
+
+    for (const key of level.keys()) {
+      const c = Math.floor(key / 3);
+      const dir = DIR_LIST[key % 3];
+
+      for (const [nc, nd] of children(c, dir, grid[r][c])) {
+        const nr = r + 1;
+        if (nr < rows && nc >= 0 && nc < cols) {
+          visited.add(nr * cols + nc);
+          next.set(nc * 3 + DIR_IDX[nd], true);
+        }
+      }
+    }
+
+    level = next;
+  }
+
+  return visited.size;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  if (grid.length === 0) return 0n;
+  const rows = grid.length;
+  const cols = grid[0].length;
+
+  const srcCol = grid[0].indexOf('S');
+  if (srcCol === -1) return 0n;
+
+  // Map key: c * 3 + dir_index → accumulated path count reaching this (col, dir) at current row
+  let level = new Map<number, bigint>();
+  level.set(srcCol * 3 + DIR_IDX['D'], 1n);
+
+  let total = 0n;
+
+  for (let r = 0; r < rows && level.size > 0; r++) {
+    const next = new Map<number, bigint>();
+
+    for (const [key, count] of level) {
+      const c = Math.floor(key / 3);
+      const dir = DIR_LIST[key % 3];
+
+      for (const [nc, nd] of children(c, dir, grid[r][c])) {
+        const nr = r + 1;
+        if (nr >= rows || nc < 0 || nc >= cols) {
+          total += count;
+        } else {
+          const nkey = nc * 3 + DIR_IDX[nd];
+          const prev = next.get(nkey) ?? 0n;
+          next.set(nkey, prev + count);
+        }
+      }
+    }
+
+    level = next;
+  }
+
+  return total;
+}
diff --git a/tests/index.test.ts b/tests/index.test.ts
