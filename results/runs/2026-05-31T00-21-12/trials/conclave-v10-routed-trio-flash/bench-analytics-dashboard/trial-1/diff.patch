+import { describe, it, expect, beforeEach } from 'vitest';
+import request from 'supertest';
+import { createApp } from './app.js';
+import { createDatabase } from './db.js';
+import type Database from 'better-sqlite3';
+
+let db: Database.Database;
+let app: ReturnType<typeof createApp>;
+
+beforeEach(() => {
+  db = createDatabase(':memory:');
+  app = createApp(db);
+});
+
+describe('Auth', () => {
+  it('registers a new user', async () => {
+    const res = await request(app)
+      .post('/auth/register')
+      .send({ email: 'a@test.com', password: 'pass', tenantId: 'T1', role: 'admin' });
+    expect(res.status).toBe(201);
+    expect(typeof res.body.token).toBe('string');
+    expect(res.body.user.role).toBe('admin');
+  });
+
+  it('rejects duplicate email', async () => {
+    await request(app).post('/auth/register').send({ email: 'a@test.com', password: 'x', tenantId: 'T1' });
+    const res = await request(app).post('/auth/register').send({ email: 'a@test.com', password: 'y', tenantId: 'T1' });
+    expect(res.status).toBe(409);
+  });
+
+  it('logs in with correct credentials', async () => {
+    await request(app).post('/auth/register').send({ email: 'a@test.com', password: 'pass', tenantId: 'T1' });
+    const res = await request(app).post('/auth/login').send({ email: 'a@test.com', password: 'pass' });
+    expect(res.status).toBe(200);
+    expect(typeof res.body.token).toBe('string');
+  });
+
+  it('rejects wrong password', async () => {
+    await request(app).post('/auth/register').send({ email: 'a@test.com', password: 'pass', tenantId: 'T1' });
+    const res = await request(app).post('/auth/login').send({ email: 'a@test.com', password: 'wrong' });
+    expect(res.status).toBe(401);
+  });
+
+  it('returns 401 for missing token on protected routes', async () => {
+    const res = await request(app).get('/users/me');
+    expect(res.status).toBe(401);
+  });
+});
+
+describe('User Management', () => {
+  let adminToken: string;
+  let viewerId: string;
+  let viewerToken: string;
+
+  beforeEach(async () => {
+    const r1 = await request(app).post('/auth/register').send({ email: 'admin@t.com', password: 'p', tenantId: 'T1', role: 'admin' });
+    adminToken = r1.body.token as string;
+    const r2 = await request(app).post('/auth/register').send({ email: 'viewer@t.com', password: 'p', tenantId: 'T1', role: 'viewer' });
+    viewerToken = r2.body.token as string;
+    viewerId = r2.body.user.id as string;
+  });
+
+  it('returns own profile', async () => {
+    const res = await request(app).get('/users/me').set('Authorization', `Bearer ${adminToken}`);
+    expect(res.status).toBe(200);
+    expect(res.body.email).toBe('admin@t.com');
+  });
+
+  it('admin can change user role', async () => {
+    const res = await request(app)
+      .put(`/users/${viewerId}/role`)
+      .set('Authorization', `Bearer ${adminToken}`)
+      .send({ role: 'editor' });
+    expect(res.status).toBe(200);
+    expect(res.body.role).toBe('editor');
+  });
+
+  it('non-admin cannot change roles', async () => {
+    const res = await request(app)
+      .put(`/users/${viewerId}/role`)
+      .set('Authorization', `Bearer ${viewerToken}`)
+      .send({ role: 'admin' });
+    expect(res.status).toBe(403);
+  });
+
+  it('cannot change roles across tenants', async () => {
+    const r = await request(app).post('/auth/register').send({ email: 'x@t2.com', password: 'p', tenantId: 'T2', role: 'admin' });
+    const adminT2 = r.body.token as string;
+    const res = await request(app)
+      .put(`/users/${viewerId}/role`)
+      .set('Authorization', `Bearer ${adminT2}`)
+      .send({ role: 'editor' });
+    expect(res.status).toBe(403);
+  });
+});
+
+describe('Event Ingestion', () => {
+  let token: string;
+
+  beforeEach(async () => {
+    const r = await request(app).post('/auth/register').send({ email: 'u@t.com', password: 'p', tenantId: 'T1' });
+    token = r.body.token as string;
+  });
+
+  it('ingests a single event', async () => {
+    const res = await request(app)
+      .post('/events')
+      .set('Authorization', `Bearer ${token}`)
+      .send({ name: 'page_view', properties: { url: '/home' } });
+    expect(res.status).toBe(201);
+    expect(res.body.name).toBe('page_view');
+  });
+
+  it('requires name', async () => {
+    const res = await request(app)
+      .post('/events')
+      .set('Authorization', `Bearer ${token}`)
+      .send({ properties: {} });
+    expect(res.status).toBe(400);
+  });
+
+  it('ingests a batch of events', async () => {
+    const res = await request(app)
+      .post('/events/batch')
+      .set('Authorization', `Bearer ${token}`)
+      .send([
+        { name: 'page_view', properties: { url: '/a' } },
+        { name: 'click', properties: { btn: 'x' } },
+      ]);
+    expect(res.status).toBe(201);
+    expect(res.body.inserted).toBe(2);
+  });
+});
+
+describe('Query Engine', () => {
+  let token: string;
+  let otherToken: string;
+
+  beforeEach(async () => {
+    const r = await request(app).post('/auth/register').send({ email: 'u@t.com', password: 'p', tenantId: 'T1' });
+    token = r.body.token as string;
+    const r2 = await request(app).post('/auth/register').send({ email: 'u@t2.com', password: 'p', tenantId: 'T2' });
+    otherToken = r2.body.token as string;
+
+    await request(app).post('/events/batch').set('Authorization', `Bearer ${token}`).send([
+      { name: 'page_view', properties: { url: '/home' }, timestamp: '2024-01-15T10:00:00Z' },
+      { name: 'page_view', properties: { url: '/about' }, timestamp: '2024-01-15T11:00:00Z' },
+      { name: 'page_view', properties: { url: '/home' }, timestamp: '2024-01-16T10:00:00Z' },
+      { name: 'click', properties: { btn: 'signup' }, timestamp: '2024-01-15T12:00:00Z' },
+    ]);
+  });
+
+  it('counts all events', async () => {
+    const res = await request(app).post('/queries').set('Authorization', `Bearer ${token}`).send({ type: 'count' });
+    expect(res.status).toBe(200);
+    expect(res.body.count).toBe(4);
+  });
+
+  it('counts filtered events', async () => {
+    const res = await request(app).post('/queries').set('Authorization', `Bearer ${token}`).send({ type: 'count', eventName: 'page_view' });
+    expect(res.body.count).toBe(3);
+  });
+
+  it('timeseries by day', async () => {
+    const res = await request(app).post('/queries').set('Authorization', `Bearer ${token}`).send({ type: 'timeseries', eventName: 'page_view', granularity: 'day' });
+    expect(res.status).toBe(200);
+    expect(res.body.data).toHaveLength(2);
+  });
+
+  it('breakdown by property', async () => {
+    const res = await request(app).post('/queries').set('Authorization', `Bearer ${token}`).send({ type: 'breakdown', eventName: 'page_view', breakdownProperty: 'url' });
+    expect(res.status).toBe(200);
+    const data = res.body.data as { value: string; count: number }[];
+    expect(data.find(d => d.value === '/home')?.count).toBe(2);
+  });
+
+  it('enforces tenant isolation', async () => {
+    const res = await request(app).post('/queries').set('Authorization', `Bearer ${otherToken}`).send({ type: 'count' });
+    expect(res.body.count).toBe(0);
+  });
+});
+
+describe('Dashboards', () => {
+  let token: string;
+  let otherToken: string;
+  let dashId: string;
+
+  beforeEach(async () => {
+    const r = await request(app).post('/auth/register').send({ email: 'u@t.com', password: 'p', tenantId: 'T1' });
+    token = r.body.token as string;
+    const r2 = await request(app).post('/auth/register').send({ email: 'u@t2.com', password: 'p', tenantId: 'T2' });
+    otherToken = r2.body.token as string;
+
+    const d = await request(app).post('/dashboards').set('Authorization', `Bearer ${token}`).send({ name: 'Dash1', config: { theme: 'dark' } });
+    dashId = d.body.id as string;
+  });
+
+  it('creates a dashboard', async () => {
+    const res = await request(app).post('/dashboards').set('Authorization', `Bearer ${token}`).send({ name: 'New' });
+    expect(res.status).toBe(201);
+    expect(res.body.name).toBe('New');
+  });
+
+  it('lists dashboards', async () => {
+    const res = await request(app).get('/dashboards').set('Authorization', `Bearer ${token}`);
+    expect(res.status).toBe(200);
+    expect(res.body).toHaveLength(1);
+  });
+
+  it('gets a dashboard', async () => {
+    const res = await request(app).get(`/dashboards/${dashId}`).set('Authorization', `Bearer ${token}`);
+    expect(res.status).toBe(200);
+    expect(res.body.name).toBe('Dash1');
+    expect(res.body.config).toEqual({ theme: 'dark' });
+  });
+
+  it('updates a dashboard', async () => {
+    const res = await request(app).put(`/dashboards/${dashId}`).set('Authorization', `Bearer ${token}`).send({ name: 'Updated' });
+    expect(res.status).toBe(200);
+    expect(res.body.name).toBe('Updated');
+  });
+
+  it('deletes a dashboard', async () => {
+    await request(app).delete(`/dashboards/${dashId}`).set('Authorization', `Bearer ${token}`);
+    const res = await request(app).get(`/dashboards/${dashId}`).set('Authorization', `Bearer ${token}`);
+    expect(res.status).toBe(404);
+  });
+
+  it('enforces tenant isolation', async () => {
+    const res = await request(app).get(`/dashboards/${dashId}`).set('Authorization', `Bearer ${otherToken}`);
+    expect(res.status).toBe(404);
+  });
+});
+
+describe('Export', () => {
+  let token: string;
+  let dashId: string;
+
+  beforeEach(async () => {
+    const r = await request(app).post('/auth/register').send({ email: 'u@t.com', password: 'p', tenantId: 'T1' });
+    token = r.body.token as string;
+
+    await request(app).post('/events/batch').set('Authorization', `Bearer ${token}`).send([
+      { name: 'page_view', properties: { url: '/home' } },
+      { name: 'click', properties: { btn: 'x' } },
+    ]);
+
+    const d = await request(app).post('/dashboards').set('Authorization', `Bearer ${token}`).send({ name: 'D1' });
+    dashId = d.body.id as string;
+  });
+
+  it('exports events as JSON', async () => {
+    const res = await request(app).get('/export/events').set('Authorization', `Bearer ${token}`);
+    expect(res.status).toBe(200);
+    expect(res.body.count).toBe(2);
+    expect(Array.isArray(res.body.data)).toBe(true);
+  });
+
+  it('exports events as CSV', async () => {
+    const res = await request(app).get('/export/events?format=csv').set('Authorization', `Bearer ${token}`);
+    expect(res.status).toBe(200);
+    expect(res.headers['content-type']).toContain('text/csv');
+    expect(typeof res.text).toBe('string');
+    expect(res.text).toContain('page_view');
+  });
+
+  it('exports dashboard as JSON', async () => {
+    const res = await request(app).get(`/export/dashboards/${dashId}`).set('Authorization', `Bearer ${token}`);
+    expect(res.status).toBe(200);
+    expect(res.body.dashboard.name).toBe('D1');
+  });
+
+  it('exports dashboard as CSV', async () => {
+    const res = await request(app).get(`/export/dashboards/${dashId}?format=csv`).set('Authorization', `Bearer ${token}`);
+    expect(res.status).toBe(200);
+    expect(res.headers['content-type']).toContain('text/csv');
+  });
+
+  it('export respects tenant boundary', async () => {
+    const r2 = await request(app).post('/auth/register').send({ email: 'x@t2.com', password: 'p', tenantId: 'T2' });
+    const t2 = r2.body.token as string;
+    const res = await request(app).get('/export/events').set('Authorization', `Bearer ${t2}`);
+    expect(res.body.count).toBe(0);
+  });
+});
