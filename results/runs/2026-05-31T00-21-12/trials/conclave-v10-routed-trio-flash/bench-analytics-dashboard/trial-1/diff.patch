+import express, { Application } from 'express';
+import Database from 'better-sqlite3';
+import { createDatabase } from './db.js';
+import { createAuthRouter } from './routes/auth.js';
+import { createUsersRouter } from './routes/users.js';
+import { createEventsRouter } from './routes/events.js';
+import { createQueriesRouter } from './routes/queries.js';
+import { createDashboardsRouter } from './routes/dashboards.js';
+import { createExportRouter } from './routes/export.js';
+import { authenticate } from './middleware/auth.js';
+
+export function createApp(db?: Database.Database): Application {
+  const app = express();
+  const database = db ?? createDatabase();
+
+  app.use(express.json());
+
+  app.use('/auth', createAuthRouter(database));
+  app.use('/users', createUsersRouter(database));
+  app.use('/events', authenticate, createEventsRouter(database));
+  app.use('/queries', authenticate, createQueriesRouter(database));
+  app.use('/dashboards', authenticate, createDashboardsRouter(database));
+  app.use('/export', authenticate, createExportRouter(database));
+
+  return app;
+}
