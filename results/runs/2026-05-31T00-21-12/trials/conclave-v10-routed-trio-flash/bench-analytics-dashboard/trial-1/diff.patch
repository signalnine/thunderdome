@@ -0,0 +1,66 @@
+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { v4 as uuidv4 } from 'uuid';
+
+interface EventInput {
+  name?: string;
+  properties?: Record<string, unknown>;
+  timestamp?: string;
+  userId?: string;
+  sessionId?: string;
+}
+
+export function createEventsRouter(db: Database.Database): Router {
+  const router = Router();
+
+  const insertStmt = db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  );
+
+  router.post('/', (req: Request, res: Response): void => {
+    const { name, properties, timestamp, userId, sessionId } = req.body as EventInput;
+
+    if (!name) {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+
+    const id = uuidv4();
+    const tenantId = req.user!.tenantId;
+    const ts = timestamp ?? new Date().toISOString();
+    const props = JSON.stringify(properties ?? {});
+
+    insertStmt.run(id, tenantId, name, props, ts, userId ?? null, sessionId ?? null);
+
+    res.status(201).json({ id, name, tenantId, timestamp: ts });
+  });
+
+  router.post('/batch', (req: Request, res: Response): void => {
+    const body = req.body as unknown;
+    if (!Array.isArray(body) || body.length === 0) {
+      res.status(400).json({ error: 'body must be a non-empty array of events' });
+      return;
+    }
+
+    const events = body as EventInput[];
+    const tenantId = req.user!.tenantId;
+    const results: { id: string; name: string }[] = [];
+
+    const insertMany = db.transaction((evts: EventInput[]) => {
+      for (const evt of evts) {
+        if (!evt.name) continue;
+        const id = uuidv4();
+        const ts = evt.timestamp ?? new Date().toISOString();
+        const props = JSON.stringify(evt.properties ?? {});
+        insertStmt.run(id, tenantId, evt.name, props, ts, evt.userId ?? null, evt.sessionId ?? null);
+        results.push({ id, name: evt.name });
+      }
+    });
+
+    insertMany(events);
+
+    res.status(201).json({ inserted: results.length, events: results });
+  });
+
+  return router;
+}
