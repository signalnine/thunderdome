  tenant_id: tenantId,\n      name: updatedName,\n      config: JSON.parse(updatedConfig) as Record<string, unknown>,\n      updated_at: now,\n    });\n  });\n\n  router.delete('/:id', (req: Request, res: Response): void => {\n    const tenantId = req.user!.tenantId;\n    const dashboard = db\n      .prepare('SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?')\n      .get(req.params.id, tenantId);\n\n    if (!dashboard) {\n      res.status(404).json({ error: 'Dashboard not found' });\n      return;\n    }\n\n    db.prepare('DELETE FROM dashboards WHERE id = ?').run(req.params.id);\n    res.status(204).send();\n  });\n\n  router.post('/:id/widgets', (req: Request, res: Response): void => {\n    const tenantId = req.user!.tenantId;\n    const dashboard = db\n      .prepare('SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?')\n      .get(req.params.id, tenantId);\n\n    if (!dashboard) {\n      res.status(404).json({ error: 'Dashboard not found' });\n      return;\n    }\n\n    const { type, config, position_x = 0, position_y = 0, width = 1, height = 1 } =\n      req.body as WidgetInput;\n\n    if (!type || !WIDGET_TYPES.includes(type)) {\n      res.status(400).json({ error: 'type must be counter, timeseries, breakdown, or funnel' });\n      return;\n    }\n\n    const widgetId = uuidv4();\n    const configStr = JSON.stringify(config ?? {});\n\n    db.prepare(\n      'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'\n    ).run(widgetId, req.params.id, type, configStr, position_x, position_y, width, height);\n\n    res.status(201).json({\n      id: widgetId,\n      dashboard_id: req.params.id,\n      type,\n      config: config ?? {},\n      position_x,\n      position_y,\n      width,\n      height,\n    });\n  });\n\n  return router;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
