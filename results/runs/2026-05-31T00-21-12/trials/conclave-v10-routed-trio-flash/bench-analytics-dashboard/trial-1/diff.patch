tring');\n\n  // 4. Bad login\n  const r4 = await req('POST', '/auth/login', { email: 'admin@t1.com', password: 'wrong' });\n  assert('bad login returns 401', r4.status === 401);\n\n  // 5. Profile\n  const r5 = await req('GET', '/users/me', undefined, adminToken);\n  assert('profile returns 200', r5.status === 200);\n  assert('profile has email', r5.body.email === 'admin@t1.com');\n\n  // 6. Unauthenticated request\n  const r6 = await req('GET', '/users/me');\n  assert('unauthenticated returns 401', r6.status === 401);\n\n  // 7. Register viewer\n  const r7 = await req('POST', '/auth/register', { email: 'viewer@t1.com', password: 'secret', tenantId: 'tenant1', role: 'viewer' });\n  assert('register viewer', r7.status === 201);\n  const viewerToken = r7.body.token;\n  const viewerId = r7.body.user.id;\n\n  // 8. Admin changes viewer role\n  const r8 = await req('PUT', `/users/${viewerId}/role`, { role: 'editor' }, adminToken);\n  assert('admin changes role', r8.status === 200);\n  assert('role updated', r8.body.role === 'editor');\n\n  // 9. Viewer can't change roles\n  const r9 = await req('PUT', `/users/${viewerId}/role`, { role: 'admin' }, viewerToken);\n  assert('viewer cannot change roles', r9.status === 403);\n\n  // 10. Ingest event\n  const r10 = await req('POST', '/events', { name: 'page_view', properties: { url: '/home' } }, adminToken);\n  assert('ingest event returns 201', r10.status === 201);\n  assert('event has id', typeof r10.body.id === 'string');\n\n  // 11. Batch ingest\n  const r11 = await req('POST', '/events/batch', [\n    { name: 'page_view', properties: { url: '/about' } },\n    { name: 'click', properties: { button: 'signup' } },\n    { name: 'page_view', properties: { url: '/home' } },\n  ], adminToken);\n  assert('batch ingest returns 201', r11.status === 201);\n  assert('batch inserted 3', r11.body.inserted === 3);\n\n  // 12. Query count\n  const r12 = await req('POST', '/queries', { type: 'count', eventName: 'page_view' }, adminToken);\