dated', r19.body.name === 'Updated Dashboard');\n\n  // 20. Dashboard tenant isolation\n  const r20 = await req('GET', `/dashboards/${dashId}`, undefined, otherToken);\n  assert('dashboard tenant isolation', r20.status === 404);\n\n  // 21. Export events JSON\n  const r21 = await req('GET', '/export/events', undefined, adminToken);\n  assert('export events json', r21.status === 200);\n  assert('export has data', Array.isArray(r21.body.data));\n  assert('export count', r21.body.count === 4);\n\n  // 22. Delete dashboard\n  const r22 = await req('DELETE', `/dashboards/${dashId}`, undefined, adminToken);\n  assert('delete dashboard', r22.status === 204);\n\n  const r23 = await req('GET', `/dashboards/${dashId}`, undefined, adminToken);\n  assert('dashboard gone after delete', r23.status === 404);\n\n  console.log(`\\nResults: ${pass} passed, ${fail} failed`);\n  server.close();\n  process.exit(fail > 0 ? 1 : 0);\n});\nEOF\n./node_modules/.bin/tsx /tmp/test-api.ts 2>&1 || node --loader ts-node/esm /tmp/test-api.ts 2>&1","description":"Run functional tests against the API"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":120,"cache_read_input_tokens":60171,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":120},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e23f6539-8458-4aae-878a-99e2f1b83074","uuid":"8e792f2a-886a-43da-99c7-000d50deabea","request_id":"req_011CbZkevoAy4pS7cr9pP8yq"}
