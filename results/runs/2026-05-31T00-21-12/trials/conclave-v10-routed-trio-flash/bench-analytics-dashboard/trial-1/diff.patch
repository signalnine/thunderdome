@@ -0,0 +1,105 @@
+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import type { DbEvent, Dashboard, Widget } from '../types.js';
+
+function toCsv(rows: Record<string, unknown>[]): string {
+  if (rows.length === 0) return '';
+  const headers = Object.keys(rows[0]);
+  const escape = (v: unknown): string => {
+    if (v === null || v === undefined) return '';
+    const s = String(v);
+    return s.includes(',') || s.includes('"') || s.includes('\n')
+      ? `"${s.replace(/"/g, '""')}"`
+      : s;
+  };
+  const lines = rows.map(row => headers.map(h => escape(row[h])).join(','));
+  return [headers.join(','), ...lines].join('\n');
+}
+
+export function createExportRouter(db: Database.Database): Router {
+  const router = Router();
+
+  router.get('/events', (req: Request, res: Response): void => {
+    const { format = 'json', eventName, start, end } = req.query as Record<string, string | undefined>;
+    const tenantId = req.user!.tenantId;
+
+    const conditions: string[] = ['tenant_id = ?'];
+    const params: unknown[] = [tenantId];
+
+    if (eventName) {
+      conditions.push('name = ?');
+      params.push(eventName);
+    }
+    if (start) {
+      conditions.push('timestamp >= ?');
+      params.push(start);
+    }
+    if (end) {
+      conditions.push('timestamp <= ?');
+      params.push(end);
+    }
+
+    const sql = `SELECT id, name, properties, timestamp, user_id, session_id FROM events WHERE ${conditions.join(' AND ')} ORDER BY timestamp`;
+    const events = db.prepare(sql).all(...params) as DbEvent[];
+
+    const parsed = events.map(e => ({
+      ...e,
+      properties: JSON.parse(e.properties) as Record<string, unknown>,
+    }));
+
+    if (format === 'csv') {
+      const csvRows = parsed.map(e => ({
+        ...e,
+        properties: JSON.stringify(e.properties),
+      })) as Record<string, unknown>[];
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', 'attachment; filename="events.csv"');
+      res.send(toCsv(csvRows));
+      return;
+    }
+
+    res.json({ data: parsed, count: parsed.length });
+  });
+
+  router.get('/dashboards/:id', (req: Request, res: Response): void => {
+    const { format = 'json' } = req.query as { format?: string };
+    const tenantId = req.user!.tenantId;
+
+    const dashboard = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId) as Dashboard | undefined;
+
+    if (!dashboard) {
+      res.status(404).json({ error: 'Dashboard not found' });
+      return;
+    }
+
+    const widgets = db
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+      .all(req.params.id) as Widget[];
+
+    if (format === 'csv') {
+      const widgetRows = widgets.map(w => ({
+        ...w,
+        config: w.config,
+      })) as Record<string, unknown>[];
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', `attachment; filename="dashboard-${req.params.id}.csv"`);
+      res.send(toCsv(widgetRows));
+      return;
+    }
+
+    res.json({
+      dashboard: {
+        ...dashboard,
+        config: JSON.parse(dashboard.config) as Record<string, unknown>,
+      },
+      widgets: widgets.map(w => ({
+        ...w,
+        config: JSON.parse(w.config) as Record<string, unknown>,
+      })),
+    });
+  });
+
+  return router;
+}
