new file mode 100644
index 0000000..a6584bf
--- /dev/null
+++ b/src/routes/queries.ts
@@ -0,0 +1,118 @@
+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+
+const VALID_IDENTIFIER = /^[\w.]+$/;
+
+interface QueryRequest {
+  type?: string;
+  eventName?: string;
+  filters?: Record<string, unknown>;
+  timeRange?: { start?: string; end?: string };
+  granularity?: string;
+  breakdownProperty?: string;
+}
+
+export function createQueriesRouter(db: Database.Database): Router {
+  const router = Router();
+
+  router.post('/', (req: Request, res: Response): void => {
+    const { type, eventName, filters, timeRange, granularity, breakdownProperty } =
+      req.body as QueryRequest;
+
+    if (!type) {
+      res.status(400).json({ error: 'type is required' });
+      return;
+    }
+
+    const tenantId = req.user!.tenantId;
+    const conditions: string[] = ['tenant_id = ?'];
+    const params: unknown[] = [tenantId];
+
+    if (eventName) {
+      conditions.push('name = ?');
+      params.push(eventName);
+    }
+
+    if (timeRange?.start) {
+      conditions.push('timestamp >= ?');
+      params.push(timeRange.start);
+    }
+
+    if (timeRange?.end) {
+      conditions.push('timestamp <= ?');
+      params.push(timeRange.end);
+    }
+
+    if (filters) {
+      for (const [key, value] of Object.entries(filters)) {
+        if (!VALID_IDENTIFIER.test(key)) {
+          res.status(400).json({ error: `Invalid filter key: ${key}` });
+          return;
+        }
+        conditions.push(`json_extract(properties, '$.${key}') = ?`);
+        params.push(value);
+      }
+    }
+
+    const where = `WHERE ${conditions.join(' AND ')}`;
+
+    if (type === 'count') {
+      const result = db
+        .prepare(`SELECT COUNT(*) as count FROM events ${where}`)
+        .get(...params) as { count: number };
+      res.json({ count: result.count });
+      return;
+    }
+
+    if (type === 'timeseries') {
+      const gran = granularity ?? 'day';
+      let fmt: string;
+      switch (gran) {
+        case 'hour':
+          fmt = '%Y-%m-%d %H:00:00';
+          break;
+        case 'week':
+          fmt = '%Y-%W';
+          break;
+        case 'month':
+          fmt = '%Y-%m';
+          break;
+        default:
+          fmt = '%Y-%m-%d';
+      }
+
+      const rows = db
+        .prepare(
+          `SELECT strftime('${fmt}', timestamp) as bucket, COUNT(*) as count FROM events ${where} GROUP BY bucket ORDER BY bucket`
+        )
+        .all(...params) as { bucket: string; count: number }[];
+
+      res.json({ data: rows });
+      return;
+    }
+
+    if (type === 'breakdown') {
+      if (!breakdownProperty) {
+        res.status(400).json({ error: 'breakdownProperty is required for breakdown queries' });
+        return;
+      }
+      if (!VALID_IDENTIFIER.test(breakdownProperty)) {
+        res.status(400).json({ error: 'Invalid breakdownProperty' });
+        return;
+      }
+
+      const rows = db
+        .prepare(
+          `SELECT json_extract(properties, '$.${breakdownProperty}') as value, COUNT(*) as count FROM events ${where} GROUP BY value ORDER BY count DESC`
+        )
+        .all(...params) as { value: unknown; count: number }[];
+
+      res.json({ data: rows });
+      return;
+    }
+
+    res.status(400).json({ error: `Unknown query type: ${type}` });
+  });
+
+  return router;
+}
diff --git a/src/routes/users.ts b/src/routes/users.ts
