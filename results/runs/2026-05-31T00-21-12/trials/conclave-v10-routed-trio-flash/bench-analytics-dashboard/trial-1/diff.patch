oBe(401);\n  });\n\n  it('returns 401 for missing token on protected routes', async () => {\n    const res = await request(app).get('/users/me');\n    expect(res.status).toBe(401);\n  });\n});\n\ndescribe('User Management', () => {\n  let adminToken: string;\n  let viewerId: string;\n  let viewerToken: string;\n\n  beforeEach(async () => {\n    const r1 = await request(app).post('/auth/register').send({ email: 'admin@t.com', password: 'p', tenantId: 'T1', role: 'admin' });\n    adminToken = r1.body.token as string;\n    const r2 = await request(app).post('/auth/register').send({ email: 'viewer@t.com', password: 'p', tenantId: 'T1', role: 'viewer' });\n    viewerToken = r2.body.token as string;\n    viewerId = r2.body.user.id as string;\n  });\n\n  it('returns own profile', async () => {\n    const res = await request(app).get('/users/me').set('Authorization', `Bearer ${adminToken}`);\n    expect(res.status).toBe(200);\n    expect(res.body.email).toBe('admin@t.com');\n  });\n\n  it('admin can change user role', async () => {\n    const res = await request(app)\n      .put(`/users/${viewerId}/role`)\n      .set('Authorization', `Bearer ${adminToken}`)\n      .send({ role: 'editor' });\n    expect(res.status).toBe(200);\n    expect(res.body.role).toBe('editor');\n  });\n\n  it('non-admin cannot change roles', async () => {\n    const res = await request(app)\n      .put(`/users/${viewerId}/role`)\n      .set('Authorization', `Bearer ${viewerToken}`)\n      .send({ role: 'admin' });\n    expect(res.status).toBe(403);\n  });\n\n  it('cannot change roles across tenants', async () => {\n    const r = await request(app).post('/auth/register').send({ email: 'x@t2.com', password: 'p', tenantId: 'T2', role: 'admin' });\n    const adminT2 = r.body.token as string;\n    const res = await request(app)\n      .put(`/users/${viewerId}/role`)\n      .set('Authorization', `Bearer ${adminT2}`)\n      .send({ role: 'editor' });\n    expect(res.status).toBe(403);\n  });\n});\n\ndescribe('Event Ingestion', () => {\n  let token: string;\n\n  beforeEach(async () => {\n    const r = await request(app).post('/auth/register').send({ email: 'u@t.com', password: 'p', tenantId: 'T1' });\n    token = r.body.token as string;\n  });\n\n  it('ingests a single event', async () => {\n    const res = await request(app)\n      .post('/events')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'page_view', properties: { url: '/home' } });\n    expect(res.status).toBe(201);\n    expect(res.body.name).toBe('page_view');\n  });\n\n  it('requires name', async () => {\n    const res = await request(app)\n      .post('/events')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ properties: {} });\n    expect(res.status).toBe(400);\n  });\n\n  it('ingests a batch of events', async () => {\n    const res = await request(app)\n      .post('/events/batch')\n      .set('Authorization', `Bearer ${token}`)\n      .send([\n        { name: 'page_view', properties: { url: '/a' } },\n        { name: 'click', properties: { btn: 'x' } },\n      ]);\n    expect(res.status).toBe(201);\n    expect(res.body.inserted).toBe(2);\n  });\n});\n\ndescribe('Query Engine', () => {\n  let token: string;\n  let otherToken: string;\n\n  beforeEach(async () => {\n    const r = await request(app).post('/auth/register').send({ email: 'u@t.com', password: 'p', tenantId: 'T1' });\n    token = r.body.token as string;\n    const r2 = await request(app).post('/auth/register').send({ email: 'u@t2.com', password: 'p', tenantId: 'T2' });\n    otherToken = r2.body.token as string;\n\n    await request(app).post('/events/batch').set('Authorization', `Bearer ${token}`).send([\n      { name: 'page_view', properties: { url: '/home' }, timestamp: '2024-01-15T10:00:00Z' },\n      { name: 'page_view', properties: { url: '/about' }, timestamp: '2024-01-15T11:00:00Z' },\n      { name: 'page_view', properties: { url: '/home' }, timestamp: '2024-01-16T10:00:00Z' },\n      { name: 'click', p