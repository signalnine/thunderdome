@@ -0,0 +1,175 @@
+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { v4 as uuidv4 } from 'uuid';
+import type { Dashboard, Widget } from '../types.js';
+
+interface DashboardInput {
+  name?: string;
+  config?: Record<string, unknown>;
+}
+
+interface WidgetInput {
+  type?: string;
+  config?: Record<string, unknown>;
+  position_x?: number;
+  position_y?: number;
+  width?: number;
+  height?: number;
+}
+
+const WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];
+
+export function createDashboardsRouter(db: Database.Database): Router {
+  const router = Router();
+
+  router.get('/', (req: Request, res: Response): void => {
+    const tenantId = req.user!.tenantId;
+    const dashboards = db
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC')
+      .all(tenantId) as Dashboard[];
+
+    res.json(
+      dashboards.map(d => ({ ...d, config: JSON.parse(d.config) as Record<string, unknown> }))
+    );
+  });
+
+  router.post('/', (req: Request, res: Response): void => {
+    const { name, config } = req.body as DashboardInput;
+
+    if (!name) {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+
+    const id = uuidv4();
+    const tenantId = req.user!.tenantId;
+    const ownerId = req.user!.userId;
+    const configStr = JSON.stringify(config ?? {});
+    const now = new Date().toISOString();
+
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    ).run(id, tenantId, name, ownerId, configStr, now, now);
+
+    res.status(201).json({
+      id,
+      tenant_id: tenantId,
+      name,
+      owner_id: ownerId,
+      config: config ?? {},
+      created_at: now,
+      updated_at: now,
+    });
+  });
+
+  router.get('/:id', (req: Request, res: Response): void => {
+    const tenantId = req.user!.tenantId;
+    const dashboard = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId) as Dashboard | undefined;
+
+    if (!dashboard) {
+      res.status(404).json({ error: 'Dashboard not found' });
+      return;
+    }
+
+    const widgets = db
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+      .all(req.params.id) as Widget[];
+
+    res.json({
+      ...dashboard,
+      config: JSON.parse(dashboard.config) as Record<string, unknown>,
+      widgets: widgets.map(w => ({ ...w, config: JSON.parse(w.config) as Record<string, unknown> })),
+    });
+  });
+
+  router.put('/:id', (req: Request, res: Response): void => {
+    const tenantId = req.user!.tenantId;
+    const dashboard = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId) as Dashboard | undefined;
+
+    if (!dashboard) {
+      res.status(404).json({ error: 'Dashboard not found' });
+      return;
+    }
+
+    const { name, config } = req.body as DashboardInput;
+    const updatedName = name ?? dashboard.name;
+    const updatedConfig = JSON.stringify(
+      config ?? (JSON.parse(dashboard.config) as Record<string, unknown>)
+    );
+    const now = new Date().toISOString();
+
+    db.prepare('UPDATE dashboards SET name = ?, config = ?, updated_at = ? WHERE id = ?').run(
+      updatedName,
+      updatedConfig,
+      now,
+      req.params.id
+    );
+
+    res.json({
+      id: req.params.id,
+      tenant_id: tenantId,
+      name: updatedName,
+      config: JSON.parse(updatedConfig) as Record<string, unknown>,
+      updated_at: now,
+    });
+  });
+
+  router.delete('/:id', (req: Request, res: Response): void => {
+    const tenantId = req.user!.tenantId;
+    const dashboard = db
+      .prepare('SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId);
+
+    if (!dashboard) {
+      res.status(404).json({ error: 'Dashboard not found' });
+      return;
+    }
+
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(req.params.id);
+    res.status(204).send();
+  });
+
+  router.post('/:id/widgets', (req: Request, res: Response): void => {
+    const tenantId = req.user!.tenantId;
+    const dashboard = db
+      .prepare('SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId);
+
+    if (!dashboard) {
+      res.status(404).json({ error: 'Dashboard not found' });
+      return;
+    }
+
+    const { type, config, position_x = 0, position_y = 0, width = 1, height = 1 } =
+      req.body as WidgetInput;
+
+    if (!type || !WIDGET_TYPES.includes(type)) {
+      res.status(400).json({ error: 'type must be counter, timeseries, breakdown, or funnel' });
+      return;
+    }
+
+    const widgetId = uuidv4();
+    const configStr = JSON.stringify(config ?? {});
+
+    db.prepare(
+      'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+    ).run(widgetId, req.params.id, type, configStr, position_x, position_y, width, height);
+
+    res.status(201).json({
+      id: widgetId,
+      dashboard_id: req.params.id,
+      type,
+      config: config ?? {},
+      position_x,
+      position_y,
+      width,
+      height,
+    });
+  });
+
+  return router;
+}
