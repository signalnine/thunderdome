new file mode 100644
index 0000000..5913388
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,12 @@
+import Database from 'better-sqlite3';
+import { readFileSync } from 'fs';
+import { join } from 'path';
+
+export function createDb(dbPath = ':memory:'): Database.Database {
+  const db = new Database(dbPath);
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+  const schema = readFileSync(join(__dirname, '..', 'schema.sql'), 'utf-8');
+  db.exec(schema);
+  return db;
+}
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..febe0ba
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,30 @@
+import express from 'express';
+import Database from 'better-sqlite3';
+import { createDb } from './db';
+import { createAuthRouter } from './routes/auth';
+import { createUsersRouter } from './routes/users';
+import { createEventsRouter } from './routes/events';
+import { createQueriesRouter } from './routes/queries';
+import { createDashboardsRouter } from './routes/dashboards';
+import { createExportsRouter } from './routes/exports';
+
+// Import types to activate global Express.Request augmentation
+import './types';
+
+export function createApp(db?: Database.Database): express.Application {
+  const database = db ?? createDb();
+  const app = express();
+
+  app.use(express.json());
+
+  app.use('/auth', createAuthRouter(database));
+  app.use('/users', createUsersRouter(database));
+  app.use('/events', createEventsRouter(database));
+  app.use('/queries', createQueriesRouter(database));
+  app.use('/dashboards', createDashboardsRouter(database));
+  app.use('/exports', createExportsRouter(database));
+
+  app.get('/health', (_req, res) => res.json({ status: 'ok' }));
+
+  return app;
+}
diff --git a/src/middleware/auth.ts b/src/middleware/auth.ts
new file mode 100644
index 0000000..672e3b3
--- /dev/null
+++ b/src/middleware/auth.ts
@@ -0,0 +1,45 @@
+import { Request, Response, NextFunction } from 'express';
+import jwt from 'jsonwebtoken';
+import { AuthUser } from '../types';
+
+export const JWT_SECRET = process.env.JWT_SECRET ?? 'analytics-secret-key-change-in-production';
+
+export function generateToken(user: AuthUser): string {
+  return jwt.sign(
+    { id: user.id, email: user.email, tenant_id: user.tenant_id, role: user.role },
+    JWT_SECRET,
+    { expiresIn: '7d' }
+  );
+}
+
+export function requireAuth(req: Request, res: Response, next: NextFunction): void {
+  const authHeader = req.headers.authorization;
+  if (!authHeader?.startsWith('Bearer ')) {
+    res.status(401).json({ error: 'Authorization token required' });
+    return;
+  }
+
+  const token = authHeader.slice(7);
+  try {
+    const payload = jwt.verify(token, JWT_SECRET) as AuthUser & jwt.JwtPayload;
+    req.user = {
+      id: payload.id,
+      email: payload.email,
+      tenant_id: payload.tenant_id,
+      role: payload.role,
+    };
+    next();
+  } catch {
+    res.status(401).json({ error: 'Invalid or expired token' });
+  }
+}
+
+export function requireAdmin(req: Request, res: Response, next: NextFunction): void {
+  requireAuth(req, res, () => {
+    if (req.user?.role !== 'admin') {
+      res.status(403).json({ error: 'Admin access required' });
+      return;
+    }
+    next();
+  });
+}
