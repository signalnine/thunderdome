nput[]) => {\n      for (const ev of events) {\n        if (!ev.name) continue;\n        insertEvent.run(\n          uuidv4(),\n          tenant_id,\n          ev.name,\n          JSON.stringify(ev.properties ?? {}),\n          ev.timestamp ?? new Date().toISOString(),\n          user_id\n        );\n      }\n    });\n\n    batchInsert(body.events);\n    res.status(201).json({ count: body.events.filter(e => e.name).length });\n  });\n\n  return router;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":713,"cache_read_input_tokens":39276,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":713},"output_tokens":52,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"36230959-8843-4b40-bc0c-19c97b8fd60a","uuid":"a4e47ae8-d061-4d5c-bfed-7bdc136fe8b0","request_id":"req_011CbZkrV2TcUQ4Ke7uyNbU7"}
