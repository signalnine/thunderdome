@@ -0,0 +1,89 @@
+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { requireAuth } from '../middleware/auth';
+import { DbEvent, DbDashboard, DbWidget } from '../types';
+
+function eventsToCsv(events: DbEvent[]): string {
+  const header = 'id,name,timestamp,user_id,session_id,properties';
+  const rows = events.map(e => {
+    const props = e.properties.replace(/"/g, '""');
+    const userId = e.user_id ?? '';
+    const sessionId = e.session_id ?? '';
+    return `${e.id},${e.name},${e.timestamp},${userId},${sessionId},"${props}"`;
+  });
+  return [header, ...rows].join('\n');
+}
+
+function dashboardToCsv(dashboard: DbDashboard, widgets: DbWidget[]): string {
+  const header = 'id,name,tenant_id,owner_id,created_at,updated_at,config';
+  const config = dashboard.config.replace(/"/g, '""');
+  const dashRow = `${dashboard.id},${dashboard.name},${dashboard.tenant_id},${dashboard.owner_id},${dashboard.created_at},${dashboard.updated_at},"${config}"`;
+
+  const widgetHeader = '\nwidget_id,type,position_x,position_y,width,height,config';
+  const widgetRows = widgets.map(w => {
+    const wConfig = w.config.replace(/"/g, '""');
+    return `${w.id},${w.type},${w.position_x},${w.position_y},${w.width},${w.height},"${wConfig}"`;
+  });
+
+  return [header, dashRow, widgetHeader, ...widgetRows].join('\n');
+}
+
+export function createExportsRouter(db: Database.Database): Router {
+  const router = Router();
+
+  router.get('/events', requireAuth, (req: Request, res: Response) => {
+    const format = (req.query.format as string | undefined) ?? 'json';
+    const { start, end, event_name } = req.query as Record<string, string | undefined>;
+    const tenant_id = req.user!.tenant_id;
+
+    const conditions: string[] = ['tenant_id = ?'];
+    const params: unknown[] = [tenant_id];
+
+    if (event_name) { conditions.push('name = ?'); params.push(event_name); }
+    if (start) { conditions.push('timestamp >= ?'); params.push(start); }
+    if (end) { conditions.push('timestamp <= ?'); params.push(end); }
+
+    const events = db
+      .prepare(`SELECT * FROM events WHERE ${conditions.join(' AND ')} ORDER BY timestamp ASC`)
+      .all(...params) as DbEvent[];
+
+    if (format === 'csv') {
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', 'attachment; filename="events.csv"');
+      res.send(eventsToCsv(events));
+    } else {
+      res.json(events.map(e => ({ ...e, properties: JSON.parse(e.properties) })));
+    }
+  });
+
+  router.get('/dashboard/:id', requireAuth, (req: Request, res: Response) => {
+    const format = (req.query.format as string | undefined) ?? 'json';
+
+    const dashboard = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.user!.tenant_id) as DbDashboard | undefined;
+
+    if (!dashboard) {
+      res.status(404).json({ error: 'Dashboard not found' });
+      return;
+    }
+
+    const widgets = db
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+      .all(req.params.id) as DbWidget[];
+
+    if (format === 'csv') {
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', `attachment; filename="dashboard-${dashboard.id}.csv"`);
+      res.send(dashboardToCsv(dashboard, widgets));
+    } else {
+      res.json({
+        ...dashboard,
+        config: JSON.parse(dashboard.config),
+        widgets: widgets.map(w => ({ ...w, config: JSON.parse(w.config) })),
+      });
+    }
+  });
+
+  return router;
+}
