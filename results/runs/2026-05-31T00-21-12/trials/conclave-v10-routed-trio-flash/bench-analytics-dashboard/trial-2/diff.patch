@@ -0,0 +1,101 @@
+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { v4 as uuidv4 } from 'uuid';
+import { requireAuth } from '../middleware/auth';
+import { DbDashboard, DbWidget } from '../types';
+
+function parseDashboard(d: DbDashboard) {
+  return { ...d, config: JSON.parse(d.config) };
+}
+
+export function createDashboardsRouter(db: Database.Database): Router {
+  const router = Router();
+
+  router.get('/', requireAuth, (req: Request, res: Response) => {
+    const rows = db
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC')
+      .all(req.user!.tenant_id) as DbDashboard[];
+    res.json(rows.map(parseDashboard));
+  });
+
+  router.post('/', requireAuth, (req: Request, res: Response) => {
+    const { name, config = {} } = req.body as { name?: string; config?: Record<string, unknown> };
+    if (!name) {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+
+    const id = uuidv4();
+    const now = new Date().toISOString();
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    ).run(id, req.user!.tenant_id, name, req.user!.id, JSON.stringify(config), now, now);
+
+    const dashboard = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DbDashboard;
+    res.status(201).json(parseDashboard(dashboard));
+  });
+
+  router.get('/:id', requireAuth, (req: Request, res: Response) => {
+    const dashboard = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.user!.tenant_id) as DbDashboard | undefined;
+
+    if (!dashboard) {
+      res.status(404).json({ error: 'Dashboard not found' });
+      return;
+    }
+
+    const widgets = db
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+      .all(req.params.id) as DbWidget[];
+
+    res.json({
+      ...parseDashboard(dashboard),
+      widgets: widgets.map(w => ({ ...w, config: JSON.parse(w.config) })),
+    });
+  });
+
+  router.put('/:id', requireAuth, (req: Request, res: Response) => {
+    const existing = db
+      .prepare('SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.user!.tenant_id) as { id: string } | undefined;
+
+    if (!existing) {
+      res.status(404).json({ error: 'Dashboard not found' });
+      return;
+    }
+
+    const { name, config } = req.body as { name?: string; config?: Record<string, unknown> };
+    const now = new Date().toISOString();
+
+    const updates: string[] = ['updated_at = ?'];
+    const params: unknown[] = [now];
+
+    if (name !== undefined) { updates.push('name = ?'); params.push(name); }
+    if (config !== undefined) { updates.push('config = ?'); params.push(JSON.stringify(config)); }
+
+    params.push(req.params.id);
+    db.prepare(`UPDATE dashboards SET ${updates.join(', ')} WHERE id = ?`).run(...params);
+
+    const updated = db
+      .prepare('SELECT * FROM dashboards WHERE id = ?')
+      .get(req.params.id) as DbDashboard;
+    res.json(parseDashboard(updated));
+  });
+
+  router.delete('/:id', requireAuth, (req: Request, res: Response) => {
+    const existing = db
+      .prepare('SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.user!.tenant_id) as { id: string } | undefined;
+
+    if (!existing) {
+      res.status(404).json({ error: 'Dashboard not found' });
+      return;
+    }
+
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(req.params.id);
+    res.status(204).send();
+  });
+
+  return router;
+}
