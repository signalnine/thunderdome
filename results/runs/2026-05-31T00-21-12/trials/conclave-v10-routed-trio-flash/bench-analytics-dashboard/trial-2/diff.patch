@@ -0,0 +1,67 @@
+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { v4 as uuidv4 } from 'uuid';
+import { requireAuth } from '../middleware/auth';
+import { DbEvent } from '../types';
+
+interface EventInput {
+  name?: string;
+  properties?: Record<string, unknown>;
+  timestamp?: string;
+}
+
+export function createEventsRouter(db: Database.Database): Router {
+  const router = Router();
+
+  const insertEvent = db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id) VALUES (?, ?, ?, ?, ?, ?)'
+  );
+
+  router.post('/', requireAuth, (req: Request, res: Response) => {
+    const body = req.body as EventInput;
+    if (!body.name) {
+      res.status(400).json({ error: 'event name is required' });
+      return;
+    }
+
+    const id = uuidv4();
+    const tenant_id = req.user!.tenant_id;
+    const properties = JSON.stringify(body.properties ?? {});
+    const timestamp = body.timestamp ?? new Date().toISOString();
+
+    insertEvent.run(id, tenant_id, body.name, properties, timestamp, req.user!.id);
+
+    const event = db.prepare('SELECT * FROM events WHERE id = ?').get(id) as DbEvent;
+    res.status(201).json({ ...event, properties: JSON.parse(event.properties) });
+  });
+
+  router.post('/batch', requireAuth, (req: Request, res: Response) => {
+    const body = req.body as { events?: EventInput[] };
+    if (!Array.isArray(body.events) || body.events.length === 0) {
+      res.status(400).json({ error: 'events array is required and must not be empty' });
+      return;
+    }
+
+    const tenant_id = req.user!.tenant_id;
+    const user_id = req.user!.id;
+
+    const batchInsert = db.transaction((events: EventInput[]) => {
+      for (const ev of events) {
+        if (!ev.name) continue;
+        insertEvent.run(
+          uuidv4(),
+          tenant_id,
+          ev.name,
+          JSON.stringify(ev.properties ?? {}),
+          ev.timestamp ?? new Date().toISOString(),
+          user_id
+        );
+      }
+    });
+
+    batchInsert(body.events);
+    res.status(201).json({ count: body.events.filter(e => e.name).length });
+  });
+
+  return router;
+}
