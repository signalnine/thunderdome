+++ b/src/index.ts
@@ -0,0 +1,119 @@
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'fs';
+import { dirname } from 'path';
+
+export interface TimeEntry {
+  taskName: string;
+  startTime: number;
+  stopTime: number | null;
+}
+
+export interface TimeSummary {
+  taskName: string;
+  totalMs: number;
+}
+
+export class TimeTracker {
+  private entries: TimeEntry[] = [];
+  private activeTimer: TimeEntry | null = null;
+  private readonly filePath: string;
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.ensureDirectory();
+    this.load();
+  }
+
+  start(name: string): void {
+    const trimmed = name.trim();
+    if (trimmed.length === 0) {
+      throw new Error('Task name cannot be empty');
+    }
+
+    // Auto-stop the active timer if one is running
+    if (this.activeTimer !== null) {
+      this.activeTimer.stopTime = Date.now();
+      this.activeTimer = null;
+    }
+
+    const entry: TimeEntry = {
+      taskName: name,
+      startTime: Date.now(),
+      stopTime: null,
+    };
+
+    this.entries.push(entry);
+    this.activeTimer = entry;
+    this.save();
+  }
+
+  stop(): TimeEntry {
+    if (this.activeTimer === null) {
+      throw new Error('No timer is currently running');
+    }
+
+    this.activeTimer.stopTime = Date.now();
+    const entry = this.activeTimer;
+    this.activeTimer = null;
+    this.save();
+    return entry;
+  }
+
+  getEntries(): TimeEntry[] {
+    return [...this.entries];
+  }
+
+  getEntriesByDateRange(start: Date, end: Date): TimeEntry[] {
+    const startMs = start.getTime();
+    const endMs = end.getTime();
+    return this.entries.filter(
+      entry => entry.startTime >= startMs && entry.startTime < endMs
+    );
+  }
+
+  getSummary(): TimeSummary[] {
+    const map = new Map<string, number>();
+    const now = Date.now();
+
+    for (const entry of this.entries) {
+      const duration = entry.stopTime !== null
+        ? entry.stopTime - entry.startTime
+        : now - entry.startTime;
+
+      const current = map.get(entry.taskName) ?? 0;
+      map.set(entry.taskName, current + duration);
+    }
+
+    return Array.from(map.entries())
+      .map(([taskName, totalMs]) => ({ taskName, totalMs }))
+      .sort((a, b) => b.totalMs - a.totalMs);
+  }
+
+  private ensureDirectory(): void {
+    const dir = dirname(this.filePath);
+    if (!existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+  }
+
+  private load(): void {
+    try {
+      if (existsSync(this.filePath)) {
+        const raw = readFileSync(this.filePath, 'utf-8');
+        const data = JSON.parse(raw) as TimeEntry[];
+        const loadTime = Date.now();
+        this.entries = data.map(entry => ({
+          ...entry,
+          // Auto-close any unstopped entries from a previous session
+          stopTime: entry.stopTime ?? loadTime,
+        }));
+      }
+    } catch {
+      // If the file is corrupted or unreadable, start fresh
+      this.entries = [];
+    }
+  }
+
+  private save(): void {
+    writeFileSync(this.filePath, JSON.stringify(this.entries, null, 2), 'utf-8');
+  }
+}
diff --git a/src/time-tracker.test.ts b/src/time-tracker.test.ts
new file mode 100644
index 0000000..17600b8
--- /dev/null
+++ b/src/time-tracker.test.ts
@@ -0,0 +1,251 @@
+import { describe, it, expect, afterEach } from 'vitest';
+import { existsSync, unlinkSync, rmSync } from 'fs';
+import { tmpdir } from 'os';
+import { join } from 'path';
+import { TimeTracker } from './index.js';
+
+const TEST_DB = join(tmpdir(), `time-tracker-test-${Date.now()}.json`);
+
+function makeTracker(filePath = TEST_DB): TimeTracker {
+  return new TimeTracker(filePath);
+}
+
+describe('TimeTracker', () => {
+  afterEach(() => {
+    // Clean up test db after each test
+    try {
+      if (existsSync(TEST_DB)) unlinkSync(TEST_DB);
+    } catch {
+      // ignore
+    }
+  });
+
+  describe('constructor', () => {
+    it('should start with empty entries', () => {
+      const tracker = makeTracker();
+      expect(tracker.getEntries()).toEqual([]);
+      expect(tracker.getSummary()).toEqual([]);
+    });
+  });
+
+  describe('start()', () => {
+    it('should start a timer with a valid name', () => {
+      const tracker = makeTracker();
+      tracker.start('work');
+      const entries = tracker.getEntries();
+      expect(entries).toHaveLength(1);
+      expect(entries[0].taskName).toBe('work');
+      expect(entries[0].stopTime).toBeNull();
+      expect(entries[0].startTime).toBeLessThanOrEqual(Date.now());
+    });
+
+    it('should throw on start with empty name', () => {
+      const tracker = makeTracker();
+      expect(() => tracker.start('')).toThrow();
+    });
+
+    it('should throw on start with whitespace-only name', () => {
+      const tracker = makeTracker();
+      expect(() => tracker.start('   ')).toThrow();
+    });
+
+    it('should auto-stop previous timer when starting a new one', () => {
+      const tracker = makeTracker();
+      tracker.start('work');
+      tracker.start('play');
+      const entries = tracker.getEntries();
+      expect(entries).toHaveLength(2);
+      expect(entries[0].taskName).toBe('work');
+      expect(entries[0].stopTime).not.toBeNull();
+      expect(entries[1].taskName).toBe('play');
+      expect(entries[1].stopTime).toBeNull();
+    });
+  });
+
+  describe('stop()', () => {
+    it('should stop the active timer and return the entry', () => {
+      const tracker = makeTracker();
+      tracker.start('work');
+      const entry = tracker.stop();
+      expect(entry.taskName).toBe('work');
+      expect(entry.stopTime).not.toBeNull();
+      expect(entry.stopTime!).toBeGreaterThanOrEqual(entry.startTime);
+    });
+
+    it('should throw on stop when nothing is running', () => {
+      const tracker = makeTracker();
+      expect(() => tracker.stop()).toThrow();
+    });
+
+    it('should throw on double stop', () => {
+      const tracker = makeTracker();
+      tracker.start('work');
+      tracker.stop();
+      expect(() => tracker.stop()).toThrow();
+    });
+  });
+
+  describe('getEntries()', () => {
+    it('should return all entries in order', () => {
+      const tracker = makeTracker();
+      tracker.start('a');
+      tracker.stop();
+      tracker.start('b');
+      tracker.stop();
+      tracker.start('c');
+      tracker.stop();
+      expect(tracker.getEntries()).toHaveLength(3);
+      expect(tracker.getEntries().map(e => e.taskName)).toEqual(['a', 'b', 'c']);
+    });
+  });
+
+  describe('getEntriesByDateRange()', () => {
+    it('should filter entries by date range', async () => {
+      const tracker = makeTracker();
+      tracker.start('past');
+      await sleep(5);
+      tracker.stop();
+      // Give enough gap so entries have distinct start times
+      await sleep(10);
+
+      const entries = tracker.getEntries();
+      const pastEntry = entries[0];
+
+      tracker.start('present');
+      await sleep(5);
+      tracker.stop();
+
+      const allEntries = tracker.getEntries();
+      const presentEntry = allEntries[1];
+
+      // Range that covers only past entry startTime
+      const pastFilter = tracker.getEntriesByDateRange(
+        new Date(pastEntry.startTime - 1),
+        new Date(presentEntry.startTime)
+      );
+      expect(pastFilter).toHaveLength(1);
+      expect(pastFilter[0].taskName).toBe('past');
+
+      // Range that covers only present entry
+      const presentFilter = tracker.getEntriesByDateRange(
+        new Date(presentEntry.startTime),
+        new Date(presentEntry.startTime + 1)
+      );
+      expect(presentFilter).toHaveLength(1);
+      expect(presentFilter[0].taskName).toBe('present');
+    });
+
+    it('should return empty array for range that matches nothing', () => {
+      const tracker = makeTracker();
+      tracker.start('work');
+      tracker.stop();
+      const result = tracker.getEntriesByDateRange(
+        new Date('2000-01-01'),
+        new Date('2000-01-02')
+      );
+      expect(result).toEqual([]);
+    });
+  });
+
+  describe('getSummary()', () => {
+    it('should summarize time per task name', async () => {
+      const tracker = makeTracker();
+      tracker.start('work');
+      await sleep(10);
+      tracker.stop();
+      tracker.start('work');
+      await sleep(10);
+      tracker.stop();
+
+      const summary = tracker.getSummary();
+      expect(summary).toHaveLength(1);
+      expect(summary[0].taskName).toBe('work');
+      expect(summary[0].totalMs).toBeGreaterThan(0);
+    });
+
+    it('should separate different task names', () => {
+      const tracker = makeTracker();
+      tracker.start('work');
+      tracker.stop();
+      tracker.start('break');
+      tracker.stop();
+
+      const summary = tracker.getSummary();
+      expect(summary).toHaveLength(2);
+      const workEntry = summary.find(s => s.taskName === 'work')!;
+      const breakEntry = summary.find(s => s.taskName === 'break')!;
+      expect(workEntry.totalMs).toBeGreaterThanOrEqual(0);
+      expect(breakEntry.totalMs).toBeGreaterThanOrEqual(0);
+    });
+
+    it('should use current time for running tasks', async () => {
+      const tracker = makeTracker();
+      tracker.start('running');
+      // Don't stop it — summary should use Date.now()
+      await sleep(5);
+      const summary = tracker.getSummary();
+      expect(summary).toHaveLength(1);
+      expect(summary[0].taskName).toBe('running');
+      expect(summary[0].totalMs).toBeGreaterThan(0);
+    });
+  });
+
+  describe('persistence', () => {
+    it('should persist data across sessions', () => {
+      const tracker1 = makeTracker();
+      tracker1.start('work');
+      tracker1.stop();
+
+      const tracker2 = makeTracker();
+      const entries = tracker2.getEntries();
+      expect(entries).toHaveLength(1);
+      expect(entries[0].taskName).toBe('work');
+      expect(entries[0].stopTime).not.toBeNull();
+    });
+
+    it('should restore multiple sessions', () => {
+      const t1 = makeTracker();
+      t1.start('first');
+      t1.stop();
+
+      const t2 = makeTracker();
+      t2.start('second');
+      t2.stop();
+
+      const t3 = makeTracker();
+      const entries = t3.getEntries();
+      expect(entries).toHaveLength(2);
+      expect(entries.map(e => e.taskName)).toEqual(['first', 'second']);
+    });
+  });
+
+  describe('unicode support', () => {
+    it('should support unicode task names', () => {
+      const tracker = makeTracker();
+      tracker.start('🔨 fixing bugs 🐛');
+      tracker.stop();
+      const entries = tracker.getEntries();
+      expect(entries[0].taskName).toBe('🔨 fixing bugs 🐛');
+
+      const summary = tracker.getSummary();
+      expect(summary[0].taskName).toBe('🔨 fixing bugs 🐛');
+      expect(summary[0].totalMs).toBeGreaterThanOrEqual(0);
+    });
+  });
+
+  describe('auto-create directories', () => {
+    it('should create parent directories for the data file', () => {
+      const deepPath = join(tmpdir(), `a/b/c/d/e-${Date.now()}.json`);
+      const tracker = new TimeTracker(deepPath);
+      tracker.start('test');
+      tracker.stop();
+      expect(existsSync(deepPath)).toBe(true);
+      // Cleanup
+      rmSync(join(tmpdir(), 'a'), { recursive: true, force: true });
+    });
+  });
+});
+
+function sleep(ms: number): Promise<void> {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
