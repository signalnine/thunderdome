+++ b/src/time-tracker.ts
@@ -0,0 +1,113 @@
+import { existsSync, readFileSync, writeFileSync, mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+import type { TimeEntry, TimeTrackerOptions, TimeTrackerData } from './types.js';
+
+const DEFAULT_FILE = './time-tracker-data.json';
+
+export class TimeTracker {
+  private data: TimeTrackerData;
+  private readonly filePath: string;
+
+  constructor(options?: TimeTrackerOptions) {
+    this.filePath = options?.file ?? DEFAULT_FILE;
+    this.data = this.load();
+  }
+
+  private load(): TimeTrackerData {
+    try {
+      if (existsSync(this.filePath)) {
+        const raw = readFileSync(this.filePath, 'utf-8');
+        return JSON.parse(raw) as TimeTrackerData;
+      }
+    } catch {
+      // If file is corrupted, start fresh
+    }
+    return { entries: [], activeIndex: null };
+  }
+
+  private save(): void {
+    const dir = dirname(this.filePath);
+    if (!existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+    writeFileSync(this.filePath, JSON.stringify(this.data, null, 2), 'utf-8');
+  }
+
+  start(taskName: string): TimeEntry {
+    const trimmed = taskName.trim();
+    if (trimmed.length === 0) {
+      throw new Error('Task name cannot be empty');
+    }
+
+    // Auto-stop any running task
+    if (this.data.activeIndex !== null) {
+      const active = this.data.entries[this.data.activeIndex];
+      active.endTime = new Date().toISOString();
+    }
+
+    const entry: TimeEntry = {
+      taskName,
+      startTime: new Date().toISOString(),
+    };
+
+    this.data.entries.push(entry);
+    this.data.activeIndex = this.data.entries.length - 1;
+    this.save();
+
+    return entry;
+  }
+
+  stop(): TimeEntry {
+    if (this.data.activeIndex === null) {
+      throw new Error('No active timer to stop');
+    }
+
+    const active = this.data.entries[this.data.activeIndex];
+    active.endTime = new Date().toISOString();
+    this.data.activeIndex = null;
+    this.save();
+
+    return active;
+  }
+
+  getLog(options?: { since?: Date }): TimeEntry[] {
+    let entries = this.data.entries;
+
+    if (options?.since) {
+      const sinceTime = options.since.getTime();
+      entries = entries.filter((entry) => {
+        const entryStartTime = new Date(entry.startTime).getTime();
+        // Include if entry started on/after since date, OR if it's still running
+        return entryStartTime >= sinceTime || entry.endTime === undefined;
+      });
+    }
+
+    // Return a shallow copy to prevent direct mutation
+    return [...entries];
+  }
+
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+    const now = Date.now();
+
+    for (const entry of this.data.entries) {
+      const startTime = new Date(entry.startTime).getTime();
+      const endTime = entry.endTime ? new Date(entry.endTime).getTime() : now;
+      const duration = endTime - startTime;
+
+      if (duration >= 0) {
+        summary[entry.taskName] = (summary[entry.taskName] ?? 0) + duration;
+      }
+    }
+
+    return summary;
+  }
+
+  getActiveTask(): { taskName: string } | null {
+    if (this.data.activeIndex === null) {
+      return null;
+    }
+    const entry = this.data.entries[this.data.activeIndex];
+    return { taskName: entry.taskName };
+  }
+}
