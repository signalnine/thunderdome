@@ -0,0 +1,373 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { TimeTracker } from './time-tracker.js';
+import type { TimeEntry } from './types.js';
+import { existsSync, unlinkSync, readFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+// Helper to create a temp file path
+function tmpPath(name: string): string {
+  return join(tmpdir(), `time-tracker-test-${name}.json`);
+}
+
+describe('TimeTracker - Core Operations', () => {
+  let filePath: string;
+
+  beforeEach(() => {
+    filePath = tmpPath(`core-${Date.now()}-${Math.random()}`);
+  });
+
+  afterEach(() => {
+    try { unlinkSync(filePath); } catch { /* ok */ }
+  });
+
+  it('start() creates an active entry with start time', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    const entry = tracker.start('test-task');
+    expect(entry.taskName).toBe('test-task');
+    expect(entry.startTime).toBeDefined();
+    expect(() => new Date(entry.startTime)).not.toThrow();
+    expect(new Date(entry.startTime).getTime()).not.toBeNaN();
+    expect(entry.endTime).toBeUndefined();
+  });
+
+  it('stop() sets end time on active entry', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    tracker.start('test-task');
+    const stopped = tracker.stop();
+    expect(stopped.taskName).toBe('test-task');
+    expect(stopped.endTime).toBeDefined();
+    expect(() => new Date(stopped.endTime!)).not.toThrow();
+    expect(new Date(stopped.endTime!).getTime()).not.toBeNaN();
+    expect(new Date(stopped.endTime!).getTime()).toBeGreaterThanOrEqual(new Date(stopped.startTime).getTime());
+  });
+
+  it('starting a new task auto-stops the previous one', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    tracker.start('first');
+    tracker.start('second');
+
+    // First entry should now have an endTime
+    const log = tracker.getLog();
+    expect(log).toHaveLength(2);
+    const firstEntry = log.find((e: TimeEntry) => e.taskName === 'first');
+    expect(firstEntry).toBeDefined();
+    expect(firstEntry!.endTime).toBeDefined();
+    const secondEntry = log.find((e: TimeEntry) => e.taskName === 'second');
+    expect(secondEntry).toBeDefined();
+    expect(secondEntry!.endTime).toBeUndefined();
+  });
+
+  it('stop() when nothing is running throws an error', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    expect(() => tracker.stop()).toThrow();
+  });
+});
+
+describe('TimeTracker - Query Operations', () => {
+  let filePath: string;
+
+  beforeEach(() => {
+    filePath = tmpPath(`query-${Date.now()}-${Math.random()}`);
+  });
+
+  afterEach(() => {
+    try { unlinkSync(filePath); } catch { /* ok */ }
+  });
+
+  it('getLog() returns all entries', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    tracker.start('task-a');
+    tracker.stop();
+    tracker.start('task-b');
+    tracker.stop();
+    const log = tracker.getLog();
+    expect(log).toHaveLength(2);
+  });
+
+  it('getLog({ since }) filters entries starting on or after that date', () => {
+    const tracker = new TimeTracker({ file: filePath });
+
+    // Create an entry with an old start time by manipulating the data directly
+    const oldDate = new Date('2020-01-01T00:00:00.000Z');
+    tracker.start('old-task');
+    tracker.stop();
+
+    // Manually set the old entry's startTime
+    const log = tracker.getLog();
+    log[0].startTime = oldDate.toISOString();
+    // Save back via a new start to trigger persistence
+    tracker.start('recent-task');
+    tracker.stop();
+
+    // Now query with a since date after the old entry
+    const sinceDate = new Date('2023-01-01T00:00:00.000Z');
+    const filtered = tracker.getLog({ since: sinceDate });
+    expect(filtered.length).toBeGreaterThanOrEqual(1);
+    // All returned entries should have startTime >= sinceDate OR be running
+    for (const entry of filtered) {
+      if (!entry.endTime) continue; // running entries always included
+      expect(new Date(entry.startTime).getTime()).toBeGreaterThanOrEqual(sinceDate.getTime());
+    }
+  });
+
+  it('getLog({ since }) includes running entries started before the since date', () => {
+    const tracker = new TimeTracker({ file: filePath });
+
+    // Create an entry that started long ago and is still running
+    tracker.start('running-old');
+
+    // Manually backdate it
+    const log = tracker.getLog();
+    const oldDate = new Date('2020-06-15T00:00:00.000Z');
+    log[0].startTime = oldDate.toISOString();
+
+    // Now query with a since date after the old entry
+    const sinceDate = new Date('2023-01-01T00:00:00.000Z');
+    const filtered = tracker.getLog({ since: sinceDate });
+    const runningOld = filtered.find((e: TimeEntry) => e.taskName === 'running-old');
+    expect(runningOld).toBeDefined();
+    // The running entry should have no endTime
+    expect(runningOld!.endTime).toBeUndefined();
+  });
+
+  it('getSummary() returns object keyed by task name with total duration in ms', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    tracker.start('task1');
+    tracker.stop();
+    const summary = tracker.getSummary();
+    expect(summary).toHaveProperty('task1');
+    expect(typeof summary.task1).toBe('number');
+    expect(summary.task1).toBeGreaterThanOrEqual(0);
+  });
+
+  it('getSummary() combines multiple entries for the same task name', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    tracker.start('task1');
+    tracker.stop();
+    tracker.start('task1');
+    tracker.stop();
+    const summary = tracker.getSummary();
+    expect(summary.task1).toBeGreaterThanOrEqual(0);
+    // Two separate entries should be summed
+    const log = tracker.getLog();
+    const task1Entries = log.filter((e: TimeEntry) => e.taskName === 'task1');
+    expect(task1Entries).toHaveLength(2);
+  });
+
+  it('getActiveTask() returns current task or null', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    expect(tracker.getActiveTask()).toBeNull();
+    tracker.start('active-task');
+    const active = tracker.getActiveTask();
+    expect(active).not.toBeNull();
+    expect(active!.taskName).toBe('active-task');
+    tracker.stop();
+    expect(tracker.getActiveTask()).toBeNull();
+  });
+});
+
+describe('TimeTracker - Persistence', () => {
+  let filePath: string;
+
+  beforeEach(() => {
+    filePath = tmpPath(`persist-${Date.now()}-${Math.random()}`);
+  });
+
+  afterEach(() => {
+    try { unlinkSync(filePath); } catch { /* ok */ }
+  });
+
+  it('persists data across instances', () => {
+    const tracker1 = new TimeTracker({ file: filePath });
+    tracker1.start('task-persist');
+    tracker1.stop();
+
+    const tracker2 = new TimeTracker({ file: filePath });
+    const log = tracker2.getLog();
+    expect(log).toHaveLength(1);
+    expect(log[0].taskName).toBe('task-persist');
+  });
+
+  it('creates the data file if it does not exist', () => {
+    expect(existsSync(filePath)).toBe(false);
+    const tracker = new TimeTracker({ file: filePath });
+    tracker.start('new-file-task');
+    expect(existsSync(filePath)).toBe(true);
+  });
+
+  it('file path is configurable', () => {
+    const customPath = tmpPath(`custom-${Date.now()}-${Math.random()}`);
+    try {
+      const tracker = new TimeTracker({ file: customPath });
+      tracker.start('custom-path-task');
+      expect(existsSync(customPath)).toBe(true);
+
+      const data = JSON.parse(readFileSync(customPath, 'utf-8'));
+      expect(data.entries).toHaveLength(1);
+      expect(data.entries[0].taskName).toBe('custom-path-task');
+    } finally {
+      try { unlinkSync(customPath); } catch { /* ok */ }
+    }
+  });
+});
+
+describe('TimeTracker - Edge Cases', () => {
+  let filePath: string;
+
+  beforeEach(() => {
+    filePath = tmpPath(`edge-${Date.now()}-${Math.random()}`);
+  });
+
+  afterEach(() => {
+    try { unlinkSync(filePath); } catch { /* ok */ }
+  });
+
+  it('start() with empty name throws an error', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    expect(() => tracker.start('')).toThrow();
+    expect(() => tracker.start('  ')).toThrow();
+  });
+
+  it('supports unicode task names', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    const unicodeName = '🔥測試🌟 あア αβγ 🎉';
+    const entry = tracker.start(unicodeName);
+    expect(entry.taskName).toBe(unicodeName);
+    tracker.stop();
+
+    const log = tracker.getLog();
+    expect(log[0].taskName).toBe(unicodeName);
+
+    // Verify persistence
+    const tracker2 = new TimeTracker({ file: filePath });
+    const log2 = tracker2.getLog();
+    expect(log2[0].taskName).toBe(unicodeName);
+  });
+
+  it('getLog({ since }) with future date returns empty array', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    tracker.start('future-test');
+    tracker.stop();
+    const futureDate = new Date('2099-12-31T23:59:59.999Z');
+    const filtered = tracker.getLog({ since: futureDate });
+    // Only running entries would show, none are running
+    const completedEntries = filtered.filter((e: TimeEntry) => e.endTime);
+    expect(completedEntries).toHaveLength(0);
+  });
+
+  it('getLog({ since }) with old date returns all entries', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    tracker.start('old-date-test');
+    tracker.stop();
+    const oldDate = new Date('1970-01-01T00:00:00.000Z');
+    const filtered = tracker.getLog({ since: oldDate });
+    expect(filtered).toHaveLength(1);
+    expect(filtered[0].taskName).toBe('old-date-test');
+  });
+
+  it('getSummary() with no entries returns empty object', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    const summary = tracker.getSummary();
+    expect(summary).toEqual({});
+  });
+
+  it('getLog() with no entries returns empty array', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    const log = tracker.getLog();
+    expect(log).toEqual([]);
+  });
+
+  it('rapid sequential start calls do not corrupt data', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    tracker.start('a');
+    tracker.start('b');
+    tracker.start('c');
+
+    const log = tracker.getLog();
+    expect(log).toHaveLength(3);
+    const names = log.map((e: TimeEntry) => e.taskName).sort();
+    expect(names).toEqual(['a', 'b', 'c']);
+
+    // First two should be stopped, last one running
+    expect(log.find((e: TimeEntry) => e.taskName === 'a')!.endTime).toBeDefined();
+    expect(log.find((e: TimeEntry) => e.taskName === 'b')!.endTime).toBeDefined();
+    expect(log.find((e: TimeEntry) => e.taskName === 'c')!.endTime).toBeUndefined();
+  });
+});
+
+describe('TimeTracker - Data Integrity', () => {
+  let filePath: string;
+
+  beforeEach(() => {
+    filePath = tmpPath(`integrity-${Date.now()}-${Math.random()}`);
+  });
+
+  afterEach(() => {
+    try { unlinkSync(filePath); } catch { /* ok */ }
+  });
+
+  it('multiple start/stop cycles accumulate correctly', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    const cycles = 5;
+    for (let i = 0; i < cycles; i++) {
+      tracker.start(`cycle-${i}`);
+      tracker.stop();
+    }
+    const log = tracker.getLog();
+    expect(log).toHaveLength(cycles);
+    for (let i = 0; i < cycles; i++) {
+      expect(log[i].taskName).toBe(`cycle-${i}`);
+    }
+  });
+
+  it('log entries have correct shape', () => {
+    const tracker = new TimeTracker({ file: filePath });
+    tracker.start('shape-test');
+    tracker.stop();
+    const log = tracker.getLog();
+    expect(log).toHaveLength(1);
+    const entry = log[0];
+    expect(entry).toHaveProperty('taskName');
+    expect(typeof entry.taskName).toBe('string');
+    expect(entry).toHaveProperty('startTime');
+    expect(typeof entry.startTime).toBe('string');
