s(depId)) {\n        throw new Error(`Dependency task ${depId} does not exist`);\n      }\n    }\n\n    const now = new Date();\n    let availableAt: Date;\n    if (explicitAvailableAt) {\n      availableAt = explicitAvailableAt;\n    } else if (delayMs !== undefined) {\n      availableAt = new Date(now.getTime() + delayMs);\n    } else {\n      availableAt = now;\n    }\n\n    const id = generateId();\n    this.allTaskIds.add(id);\n\n    const hasUnresolvedDeps = dependencies.length > 0 && !this.checkDependenciesResolved(dependencies);\n\n    const task: Task<T> = {\n      id,\n      queueName: this.name,\n      payload,\n      status: hasUnresolvedDeps ? 'blocked' : 'pending',\n      priority,\n      createdAt: now,\n      availableAt,\n      attempts: 0,\n      maxRetries,\n      baseDelay,\n      dependencies,\n      progress: null,\n    };\n\n    this.tasks.set(id, task);\n    return task;\n  }\n\n  private checkDependenciesResolved(depIds: string[]): boolean {\n    for (const depId of depIds) {\n      const depTask = this.getTaskById(depId);\n      if (!depTask || depTask.status !== 'completed') return false;\n    }\n    return true;\n  }\n\n  getTaskById(id: string): Task<T> | undefined {\n    return this.tasks.get(id);\n  }\n\n  dequeue(): Task<T> | null {\n    if (this.concurrencyLimit !== null && this.activeCount >= this.concurrencyLimit) {\n      return null;\n    }\n\n    const now = new Date();\n    const available = [...this.tasks.values()].filter(\n      (t) => t.status === 'pending' && t.availableAt <= now\n    );\n\n    if (available.length === 0) return null;\n\n    available.sort((a, b) => {\n      if (a.priority !== b.priority) return a.priority - b.priority;\n      if (a.availableAt.getTime() !== b.availableAt.getTime()) {\n        return a.availableAt.getTime() - b.availableAt.getTime();\n      }\n      return a.createdAt.getTime() - b.createdAt.getTime();\n    });\n\n    const task = available[0];\n    task.status = 'processing';\n    task.attempts++;\n    this.activeCount++;\n    return task;\n  }\n\n  complete(taskId: string): Task<T> {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task ${taskId} not found`);\n    if (task.status !== 'processing') throw new Error(`Task ${taskId} is not processing`);\n\n    task.status = 'completed';\n    this.activeCount--;\n    this.unblockDependents();\n    return task;\n  }\n\n  fail(taskId: string, error?: Error): Task<T> {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task ${taskId} not found`);\n    if (task.status !== 'processing') throw new Error(`Task ${taskId} is not processing`);\n\n    task.error = error;\n    this.activeCount--;\n\n    if (task.attempts < task.maxRetries + 1 && task.attempts <= task.maxRetries) {\n      // Retry: attempts is already incremented in dequeue\n      const backoff = task.baseDelay * Math.pow(2, task.attempts - 1);\n      task.availableAt = new Date(Date.now() + backoff);\n      task.status = 'pending';\n    } else {\n      task.status = 'failed';\n      // Move to DLQ\n      this.deadLetterQueue.set(task.id, {\n        task,\n        failedAt: new Date(),\n        errorMessage: error?.message,\n      });\n    }\n    return task;\n  }\n\n  cancel(taskId: string): Task<T> {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task ${taskId} not found`);\n    if (task.status !== 'pending' && task.status !== 'processing') {\n      throw new Error(`Task ${taskId} cannot be cancelled in status ${task.status}`);\n    }\n\n    if (task.status === 'processing') {\n      this.activeCount--;\n    }\n    task.status = 'cancelled';\n    return task;\n  }\n\n  reportProgress(taskId: string, percent: number, message?: string): void {\n    if (percent < 0 || percent > 100) throw new Error('Progress must be 0-100');\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task ${taskId} not found`);\n    if (task.status !== 'processing') throw new Error(`Task ${taskId} is not processing`);\n\n    task.progress = { percent, message };\n    const listeners = this.progressListeners.get(taskId);\n    if (listeners) {\n      for (const fn of listeners) fn({ percent, message });\n    }\n  }\n\n  subscribeProgress(taskId: string, fn: (p: { percent: number; message?: string }) => void): () => void {\n    if (!this.progressListeners.has(taskId)) {\n      this.progressListeners.set(taskId, new Set());\n    }\n    this.progressListeners.get(taskId)!.add(fn);\n    return () => {\n      this.progressListeners.get(taskId)?.delete(fn);\n    };\n  }\n\n  private unblockDependents(): void {\n    for (const task of this.tasks.values()) {\n      if (task.status === 'blocked' && this.checkDependenciesResolved(task.dependencies)) {\n        task.status = 'pending';\n      }\n    }\n  }\n\n  pendingCount(): number {\n    const now = new Date();\n    return [...this.tasks.values()].filter(\n      (t) => t.status === 'pending' && t.availableAt <= now\n    ).length;\n  }\n\n  getDeadLetterTasks(): DeadLetterEntry<T>[] {\n    return [...this.deadLetterQueue.values()];\n  }\n\n  requeueFromDLQ(taskId: string): Task<T> {\n    const entry = this.deadLetterQueue.get(taskId);\n    if (!entry) throw new Error(`Task ${taskId} not in dead letter queue`);\n\n    const task = entry.task;\n    task.status = 'pending';\n    task.attempts = 0;\n    task.availableAt = new Date();\n    task.error = undefined;\n    this.deadLetterQueue.delete(taskId);\n    // ensure still in tasks map\n    this.tasks.set(taskId, task);\n    return task;\n  }\n\n  clearDLQ(): void {\n    this.deadLetterQueue.clear();\n  }\n\n  setConcurrencyLimit(limit: number | null): void {\n    this.concurrencyLimit = limit;\n  }\n\n  getConcurrencyLimit(): number | null {\n    return this.concurrencyLimit;\n  }\n\n  getActiveCount(): number {\n    return this.activeCount;\n  }\n\n  useMiddleware(fn: MiddlewareFn<T>): void {\n    this.middlewareStack.push(fn);\n  }\n\n  setProcessor(fn: ProcessorFn<T>): void {\n    this.processor = fn;\n  }\n\n  async runWithMiddleware(task: Task<T>): Promise<void> {\n    const stack = [...this.middlewareStack];\n    let index = 0;\n\n    const next = async (): Promise<void> => {\n      if (index < stack.length) {\n        const mw = stack[index++];\n        await mw(task, next);\n      } else if (this.processor) {\n        await this.processor(task);\n      }\n    };\n\n    await next();\n  }\n\n  getAllTasks(): Task<T>[] {\n    return [...this.tasks.values()];\n  }\n\n  getProcessingTasks(): Task<T>[] {\n    return [...this.tasks.values()].filter((t) => t.status === 'processing');\n  }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":5,"lines":[" import {","   Task,","-  TaskStatus,","   AddTaskOptions,","   MiddlewareFn,","   ProcessorFn,"]}],"userModified":false,"replaceAll":false}}
