+// ============================================================
+// Phase 12: Graceful Shutdown
+// ============================================================
+describe('Phase 12: Graceful Shutdown', () => {
+  it('rejects new tasks after shutdown initiated', async () => {
+    const shutdownPromise = tq.shutdown(1000);
+    expect(() => tq.addTask('x')).toThrow();
+    await shutdownPromise;
+  });
+
+  it('shutdown completes immediately if no tasks processing', async () => {
+    const start = Date.now();
+    const summary = await tq.shutdown(5000);
+    expect(Date.now() - start).toBeLessThan(200);
+    expect(summary.completed).toBe(0);
+    expect(summary.forceCancelled).toBe(0);
+  });
+
+  it('shutdown waits for processing tasks to complete', async () => {
+    tq.addTask('x');
+    const t = tq.dequeue()!;
+    // Complete it after 100ms
+    setTimeout(() => tq.complete(t.id), 100);
+    const summary = await tq.shutdown(2000);
+    expect(summary.completed).toBe(1);
+    expect(summary.forceCancelled).toBe(0);
+  });
+
+  it('force-cancels tasks that exceed timeout', async () => {
+    tq.addTask('x');
+    tq.dequeue(); // processing, never completed
+    const summary = await tq.shutdown(100);
+    expect(summary.forceCancelled).toBe(1);
+  });
+
+  it('calls registered shutdown callbacks', async () => {
+    const cb = vi.fn();
+    tq.onShutdown(cb);
+    await tq.shutdown(0);
+    expect(cb).toHaveBeenCalled();
+  });
+
+  it('calling shutdown twice returns same result', async () => {
+    const p1 = tq.shutdown(1000);
+    const p2 = tq.shutdown(1000);
+    const [r1, r2] = await Promise.all([p1, p2]);
+    expect(r1).toBe(r2);
+  });
+
+  it('summary includes durationMs', async () => {
+    const summary = await tq.shutdown();
+    expect(summary.durationMs).toBeGreaterThanOrEqual(0);
+  });
+});
+
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..f384a1f
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,74 @@
+export type TaskStatus =
+  | 'pending'
+  | 'processing'
+  | 'completed'
+  | 'failed'
+  | 'cancelled'
+  | 'blocked';
+
+export interface TaskProgress {
+  percent: number;
+  message?: string;
+}
+
+export interface Task<T = unknown> {
+  id: string;
+  queueName: string;
+  payload: T;
+  status: TaskStatus;
+  priority: number;
+  createdAt: Date;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  baseDelay: number;
+  dependencies: string[];
+  progress: TaskProgress | null;
+  error?: Error;
+}
+
+export interface AddTaskOptions {
+  queue?: string;
+  priority?: number;
+  delayMs?: number;
+  availableAt?: Date;
+  maxRetries?: number;
+  baseDelay?: number;
+  dependencies?: string[];
+}
+
+export interface QueueStats {
+  name: string;
+  pending: number;
+  processing: number;
+  concurrencyLimit: number | null;
+  activeCount: number;
+}
+
+export interface ShutdownSummary {
+  completed: number;
+  forceCancelled: number;
+  durationMs: number;
+}
+
+export type MiddlewareFn<T = unknown> = (
+  task: Task<T>,
+  next: () => Promise<void>
+) => Promise<void>;
+
+export type ProcessorFn<T = unknown> = (task: Task<T>) => Promise<void>;
+
+export interface Schedule {
+  id: string;
+  cron: string;
+  queueName: string;
+  payload: unknown;
+  options: Omit<AddTaskOptions, 'queue'>;
+  lastRun: Date | null;
+}
+
+export interface DeadLetterEntry<T = unknown> {
+  task: Task<T>;
+  failedAt: Date;
+  errorMessage?: string;
+}
