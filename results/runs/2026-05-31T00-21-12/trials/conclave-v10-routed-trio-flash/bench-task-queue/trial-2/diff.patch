y', () => {\n    expect(tq.dequeue()).toBeNull();\n  });\n\n  it('pendingCount returns number of waiting tasks', () => {\n    tq.addTask('a');\n    tq.addTask('b');\n    expect(tq.pendingCount()).toBe(2);\n    tq.dequeue();\n    expect(tq.pendingCount()).toBe(1);\n  });\n});\n\n// ============================================================\n// Phase 2: Named Queues\n// ============================================================\ndescribe('Phase 2: Named Queues', () => {\n  it('adds tasks to named queues independently', () => {\n    tq.addTask('a', { queue: 'q1' });\n    tq.addTask('b', { queue: 'q2' });\n    expect(tq.pendingCount('q1')).toBe(1);\n    expect(tq.pendingCount('q2')).toBe(1);\n  });\n\n  it('dequeue pulls from specified queue only', () => {\n    const t1 = tq.addTask('q1-task', { queue: 'q1' });\n    tq.addTask('q2-task', { queue: 'q2' });\n    const got = tq.dequeue('q1');\n    expect(got?.id).toBe(t1.id);\n    expect(tq.pendingCount('q2')).toBe(1);\n  });\n\n  it('dequeue on non-existent queue returns null', () => {\n    expect(tq.dequeue('doesnotexist')).toBeNull();\n  });\n\n  it('listQueues returns all queue names', () => {\n    tq.addTask('x', { queue: 'alpha' });\n    tq.addTask('y', { queue: 'beta' });\n    const names = tq.listQueues();\n    expect(names).toContain('alpha');\n    expect(names).toContain('beta');\n  });\n\n  it('default queue works without specifying name', () => {\n    tq.addTask('default-task');\n    expect(tq.pendingCount()).toBe(1);\n    expect(tq.listQueues()).toContain('default');\n  });\n});\n\n// ============================================================\n// Phase 3: Priority\n// ============================================================\ndescribe('Phase 3: Priority', () => {\n  it('higher priority tasks (lower number) dequeued first', () => {\n    const low = tq.addTask('low', { priority: 8 });\n    const high = tq.addTask('high', { priority: 1 });\n    const mid = tq.addTask('mid', { priority: 5 });\n    expect(tq.dequeue()?.id).toBe(high.id);\n    expect(tq.dequeue()?.id).toBe(mid.id);\n    expect(tq.dequeue()?.id).toBe(low.id);\n  });\n\n  it('same priority tasks returned in FIFO order', () => {\n    const t1 = tq.addTask('first', { priority: 3 });\n    const t2 = tq.addTask('second', { priority: 3 });\n    expect(tq.dequeue()?.id).toBe(t1.id);\n    expect(tq.dequeue()?.id).toBe(t2.id);\n  });\n\n  it('default priority is 5', () => {\n    const task = tq.addTask('x');\n    expect(task.priority).toBe(5);\n  });\n\n  it('throws on invalid priority', () => {\n    expect(() => tq.addTask('x', { priority: 0 })).toThrow();\n    expect(() => tq.addTask('x', { priority: 11 })).toThrow();\n    expect(() => tq.addTask('x', { priority: 5.5 })).toThrow();\n  });\n\n  it('task exposes priority', () => {\n    const task = tq.addTask('x', { priority: 3 });\n    expect(task.priority).toBe(3);\n  });\n});\n\n// ============================================================\n// Phase 4: Delayed Tasks\n// ============================================================\ndescribe('Phase 4: Delayed Tasks', () => {\n  it('delayed task not returned before delay', () => {\n    tq.addTask('delayed', { delayMs: 10000 });\n    expect(tq.dequeue()).toBeNull();\n  });\n\n  it('non-delayed tasks preferred over delayed tasks', () => {\n    tq.addTask('delayed', { delayMs: 10000 });\n    const immediate = tq.addTask('immediate');\n    expect(tq.dequeue()?.id).toBe(immediate.id);\n  });\n\n  it('delayed task becomes available after delay', async () => {\n    tq.addTask('delayed', { delayMs: 50 });\n    expect(tq.dequeue()).toBeNull();\n    await new Promise((r) => setTimeout(r, 80));\n    expect(tq.dequeue()).not.toBeNull();\n  });\n\n  it('task exposes availableAt', () => {\n    const before = Date.now();\n    const task = tq.addTask('x', { delayMs: 1000 });\n    expect(task.availableAt.getTime()).toBeGreaterThanOrEqual(before + 1000);\n  });\n\n  it('availableAt option works directly', () => {\n    const future = new Date(Date.now() + 5000);\n    const task = tq.addTask('x', { availableAt: future });\n    expect(task.availableAt).toEqual(future);\n    expect(tq.dequeue()).toBeNull();\n  });\n});\n\n// ============================================================\n// Phase 5: Retry with Backoff\n// ============================================================\ndescribe('Phase 5: Retry with Backoff', () => {\n  it('completing a task marks it completed', () => {\n    tq.addTask('x');\n    const t = tq.dequeue()!;\n    tq.complete(t.id);\n    expect(t.status).toBe('completed');\n  });\n\n  it('failing a task re-queues it if retries remain', () => {\n    tq.addTask('x', { maxRetries: 2, baseDelay: 0 });\n    const t = tq.dequeue()!;\n    tq.fail(t.id);\n    expect(t.status).toBe('pending');\n    expect(t.attempts).toBe(1);\n  });\n\n  it('task is permanently failed when retries exhausted', () => {\n    tq.addTask('x', { maxRetries: 1, baseDelay: 0 });\n    const t = tq.dequeue()!;\n    tq.fail(t.id); // attempt 1 -> retry\n    const t2 = tq.dequeue()!;\n    expect(t2.id).toBe(t.id);\n    tq.fail(t2.id); // attempt 2 -> exhausted\n    expect(t.status).toBe('failed');\n  });\n\n  it('applies exponential backoff', () => {\n    tq.addTask('x', { maxRetries: 3, baseDelay: 100 });\n    const t = tq.dequeue()!;\n    const before = Date.now();\n    tq.fail(t.id); // attempt 1, backoff = 100 * 2^0 = 100ms\n    expect(t.availableAt.getTime()).toBeGreaterThanOrEqual(before + 100);\n  });\n\n  it('tracks attempts count', () => {\n    tq.addTask('x', { maxRetries: 5, baseDelay: 0 });\n    const t = tq.dequeue()!;\n    expect(t.attempts).toBe(1);\n    tq.fail(t.id);\n    tq.dequeue();\n    expect(t.attempts).toBe(2);\n  });\n\n  it('retried task keeps original queue and priority', () => {\n    tq.addTask('x', { queue: 'myq', priority: 2, maxRetries: 1, baseDelay: 0 });\n    const t = tq.dequeue('myq')!;\n    tq.fail(t.id);\n    const t2 = tq.dequeue('myq')!;\n    expect(t2.priority).toBe(2);\n    expect(t2.queueName).toBe('myq');\n  });\n});\n\n// ============================================================\n// Phase 6: Dead Letter Queue\n// ============================================================\ndescribe('Phase 6: Dead Letter Queue', () => {\n  it('exhausted task goes to DLQ', () => {\n    tq.addTask('x', { maxRetries: 0, baseDelay: 0 });\n    const t = tq.dequeue()!;\n    tq.fail(t.id, new Error('oops'));\n    const dlq = tq.getDeadLetterTasks();\n    expect(dlq).toHaveLength(1);\n    expect(dlq[0].task.id).toBe(t.id);\n  });\n\n  it('DLQ entry retains error info', () => {\n    tq.addTask('x', { maxRetries: 0, baseDelay: 0 });\n    const t = tq.dequeue()!;\n    tq.fail(t.id, new Error('fail reason'));\n    const dlq = tq.getDeadLetterTasks();\n    expect(dlq[0].errorMessage).toBe('fail reason');\n  });\n\n  it('can requeue from DLQ', () => {\n    tq.addTask('x', { maxRetries: 0, baseDelay: 0 });\n    const t = tq.dequeue()!;\n    tq.fail(t.id);\n    tq.requeueFromDLQ(t.id);\n    expect(t.status).toBe('pending');\n    const dlq = tq.getDeadLetterTasks();\n    expect(dlq).toHaveLength(0);\n  });\n\n  it('clearDLQ removes all entries', () => {\n    tq.addTask('x', { maxRetries: 0, baseDelay: 0 });\n    tq.addTask('y', { maxRetries: 0, baseDelay: 0 });\n    tq.fail(tq.dequeue()!.id);\n    tq.fail(tq.dequeue()!.id);\n    tq.clearDLQ();\n    expect(tq.getDeadLetterTasks()).toHaveLength(0);\n  });\n\n  it('each named queue has its own DLQ', () => {\n    tq.addTask('a', { queue: 'qa', maxRetries: 0, baseDelay: 0 });\n    tq.addTask('b', { queue: 'qb', maxRetries: 0, baseDelay: 0 });\n    tq.fail(tq.dequeue('qa')!.id);\n    tq.fail(tq.dequeue('qb')!.id);\n    expect(tq.getDeadLetterTasks('qa')).toHaveLength(1);\n    expect(tq.getDeadLetterTasks('qb')).toHaveLength(1);\n  });\n});\n\n// ============================================================\n// Phase 7: Task Dependencies\n// ============================================================\ndescribe('Phase 7: Task Dependencies', () => {\n  it('task with unresolved deps is blocked', () => {\n    const t1 = tq.addTask('first');\n    const t2 = tq.addTask('second', { dependencies: [t1.id] });\n    expect(t2.status).toBe('blocked');\n    expect(tq.dequeue()?.id).toBe(t1.id);\n    expect(tq.dequeue()).toBeNull(); // t2 still blocked\n  });\n\n  it('task unblocks when dependency completes', () => {\n    const t1 = tq.addTask('first');\n    const t2 = tq.addTask('second', { dependencies: [t1.id] });\n    tq.complete(tq.dequeue()!.id); // complete t1\n    expect(t2.status).toBe('pending');\n    expect(tq.dequeue()?.id).toBe(t2.id);\n  });\n\n  it('throws on non-existent dependency', () => {\n    expect(() => tq.addTask('x', { dependencies: ['fake-id'] })).toThrow();\n  });\n\n  it('detects circular dependencies', () => {\n    const t1 = tq.addTask('a');\n    const t2 = tq.addTask('b', { dependencies: [t1.id] });\n    expect(() => tq.addTask('c', { dependencies: [t2.id, t1.id] })).not.toThrow();\n    // direct cycle: add t3, then try to add t4 depending on t3 while t3 depends on t4 (impossible in forward direction)\n    // instead test: t1 -> t2 -> t1 can't happen (t1 already exists) but we can test indirect:\n    // create chain a -> b -> c, then try d that depends on a and also try to make a cycle\n    const ta = tq.addTask('chain-a');\n    const tb = tq.addTask('chain-b', { dependencies: [ta.id] });\n    // tc depends on tb (tb depends on ta)\n    // If we added ta with dependency on tc, that would be circular, but ta is already created\n    // So circular detection fires when the NEW task itself creates a cycle\n    // We simulate: t5 depends on t6, t6 depends on t5 - but t6 doesn't exist yet when creating t5\n    // The circular check applies to the deps chain at creation time\n    const t5 = tq.addTask('t5');\n    const t6 = tq.addTask('t6', { dependencies: [t5.id] });\n    // Now can we add t7 that creates a cycle? t7 -> t6 is fine, t7 -> t5 -> already resolved path\n    // True cycle: need A -> B -> A. Since A is created before B, A can't depend on B.\n    // But: A created, B depends on A, now add C that depends on B. Valid chain.\n    // Let's verify C -> B -> A doesn't throw\n    expect(() => tq.addTask('chain-c', { dependencies: [tb.id] })).not.toThrow();\n    void t6; // suppress unused\n  });\n\n  it('failed dependency does not auto-fail dependents', () => {\n    const t1 = tq.addTask('dep', { maxRetries: 0, baseDelay: 0 });\n    const t2 = tq.addTask('waiter', { dependencies: [t1.id] });\n    tq.fail(tq.dequeue()!.id); // fail t1 -> DLQ\n    expect(t2.status).toBe('blocked');\n  });\n});\n\n// ============================================================\n// Phase 8: Concurrency Control\n// ============================================================\ndescribe('Phase 8: Concurrency Control', () => {\n  it('concurrency limit prevents more tasks being dequeued', () => {\n    tq.setConcurrencyLimit('default', 2);\n    tq.addTask('a');\n    tq.addTask('b');\n    tq.addTask('c');\n    tq.dequeue();\n    tq.dequeue();\n    expect(tq.dequeue()).toBeNull(); // limit reached\n  });\n\n  it('completing a task frees a slot', () => {\n    tq.setConcurrencyLimit('default', 1);\n    tq.addTask('a');\n    tq.addTask('b');\n    const t = tq.dequeue()!;\n    expect(tq.dequeue()).toBeNull();\n    tq.complete(t.id);\n    expect(tq.dequeue()).not.toBeNull();\n  });\n\n  it('failing a task frees a slot', () => {\n    tq.setConcurrencyLimit('default', 1);\n    tq.addTask('a', { maxRetries: 0 });\n    tq.addTask('b');\n    const t = tq.dequeue()!;\n    tq.fail(t.id);\n    expect(tq.dequeue()).not.toBeNull();\n  });\n\n  it('default is no limit (unlimited)', () => {\n    expect(tq.getConcurrencyLimit('default')).toBeNull();\n  });\n\n  it('getActiveCount reflects processing tasks', () => {\n    tq.addTask('a');\n    tq.addTask('b');\n    tq.dequeue();\n    expect(tq.getActiveCount('default')).toBe(1);\n    tq.dequeue();\n    expect(tq.getActiveCount('default')).toBe(2);\n  });\n\n  it('highest priority task chosen when concurrency slot is available', () => {\n    tq.setConcurrencyLimit('default', 1);\n    const lo = tq.addTask('lo', { priority: 9 });\n    const hi = tq.addTask('hi', { priority: 1 });\n    expect(tq.dequeue()?.id).toBe(hi.id);\n    _ = lo;\n  });\n});\n\n// ============================================================\n// Phase 9: Progress Tracking and Cancellation\n// ============================================================\ndescribe('Phase 9: Progress and Cancellation', () => {\n  it('reports progress on processing task', () => {\n    tq.addTask('x');\n    const t = tq.dequeue()!;\n    tq.reportProgress(t.id, 50, 'halfway');\n    expect(t.progress?.percent).toBe(50);\n    expect(t.progress?.message).toBe('halfway');\n  });\n\n  it('subscribes and receives progress events', () => {\n    tq.addTask('x');\n    const t = tq.dequeue()!;\n    const events: number[] = [];\n    tq.subscribeProgress(t.id, (p) => events.push(p.percent));\n    tq.reportProgress(t.id, 25);\n    tq.reportProgress(t.id, 75);\n    expect(events).toEqual([25, 75]);\n  });\n\n  it('unsubscribe stops receiving events', () => {\n    tq.addTask('x');\n    const t = tq.dequeue()!;\n    const events: number[] = [];\n    const unsub = tq.subscribeProgress(t.id, (p) => events.push(p.percent));\n    tq.reportProgress(t.id, 10);\n    unsub();\n    tq.reportProgress(t.id, 20);\n    expect(events).toEqual([10]);\n  });\n\n  it('cancels pending task', () => {\n    const t = tq.addTask('x');\n    tq.cancel(t.id);\n    expect(t.status).toBe('cancelled');\n    expect(tq.dequeue()).toBeNull();\n  });\n\n  it('cancels processing task', () => {\n    tq.addTask('x');\n    const t = tq.dequeue()!;\n    tq.cancel(t.id);\n    expect(t.status).toBe('cancelled');\n  });\n\n  it('cancelled task is not retried', () => {\n    tq.addTask('x', { maxRetries: 3 });\n    const t = tq.dequeue()!;\n    tq.cancel(t.id);\n    expect(tq.dequeue()).toBeNull();\n  });\n\n  it('throws on invalid progress value', () => {\n    tq.addTask('x');\n    const t = tq.dequeue()!;\n    expect(() => tq.reportProgress(t.id, 101)).toThrow();\n    expect(() => tq.reportProgress(t.id, -1)).toThrow();\n  });\n});\n\n// ============================================================\n// Phase 10: Recurring Tasks\n// ============================================================\ndescribe('Phase 10: Recurring Tasks', () => {\n  it('creates a schedule', () => {\n    const sched = tq.addSchedule('*/5 * * * *', 'default', { type: 'recurring' });\n    expect(sched.id).toBeDefined();\n    expect(tq.listSchedules()).toHaveLength(1);\n  });\n\n  it('removes a schedule', () => {\n    const sched = tq.addSchedule('*/5 * * * *', 'default', {});\n    tq.removeSchedule(sched.id);\n    expect(tq.listSchedules()).toHaveLength(0);\n  });\n\n  it('tick enqueues task when cron matches', () => {\n    tq.addSchedule('*/5 * * * *', 'default', { value: 1 });\n    const date = new Date(2024, 0, 1, 12, 0, 0); // minute=0, divisible by 5\n    const tasks = tq.tick(date);\n    expect(tasks).toHaveLength(1);\n    expect(tq.pendingCount()).toBe(1);\n  });\n\n  it('tick does not enqueue when cron does not match', () => {\n    tq.addSchedule('*/5 * * * *', 'default', {});\n    const date = new Date(2024, 0, 1, 12, 3, 0); // minute=3, not divisible by 5\n    const tasks = tq.tick(date);\n    expect(tasks).toHaveLength(0);\n  });\n\n  it('every hour cron matches at minute 0', () => {\n    tq.addSchedule('0 * * * *', 'default', {});\n    expect(tq.tick(new Date(2024, 0, 1, 5, 0, 0))).toHaveLength(1);\n    expect(tq.tick(new Date(2024, 0, 1, 5, 1, 0))).toHaveLength(0);\n  });\n\n  it('daily cron matches at midnight only', () => {\n    tq.addSchedule('0 0 * * *', 'default', {});\n    expect(tq.tick(new Date(2024, 0, 1, 0, 0, 0))).toHaveLength(1);\n    expect(tq.tick(new Date(2024, 0, 1, 1, 0, 0))).toHaveLength(0);\n  });\n\n  it('removed schedule does not enqueue on tick', () => {\n    const sched = tq.addSchedule('*/1 * * * *', 'default', {});\n    tq.removeSchedule(sched.id);\n    tq.tick(new Date(2024, 0, 1, 0, 1, 0));\n    expect(tq.pendingCount()).toBe(0);\n  });\n\n  it('throws on unsupported cron', () => {\n    expect(() => tq.addSchedule('bad cron expr', 'default', {})).toThrow();\n  });\n});\n\n// ============================================================\n// Phase 11: Middleware\n// ============================================================\ndescribe('Phase 11: Middleware', () => {\n  it('middleware is called when processing', async () => {\n    const calls: string[] = [];\n    tq.useMiddleware('default', async (task, next) => {\n      calls.push('before');\n      await next();\n      calls.push('after');\n    });\n    tq.setProcessor('default', async () => {\n      calls.push('handler');\n    });\n    tq.addTask('x');\n    await tq.processNext();\n    expect(calls).toEqual(['before', 'handler', 'after']);\n  });\n\n  it('middleware can skip processing by not calling next', async () => {\n    const handlerCalled = vi.fn();\n    tq.useMiddleware('default', async (_task, _next) => {\n      // don't call next\n    });\n    tq.setProcessor('default', handlerCalled);\n    tq.addTask('x');\n    await tq.processNext();\n    expect(handlerCalled).not.toHaveBeenCalled();\n  });\n\n  it('multiple middlewares run in order', async () => {\n    const order: number[] = [];\n    tq.useMiddleware('default', async (_, next) => { order.push(1); await next(); order.push(4); });\n    tq.useMiddleware('default', async (_, next) => { order.push(2); await next(); order.push(3); });\n    tq.setProcessor('default', async () => {});\n    tq.addTask('x');\n    await tq.processNext();\n    expect(order).toEqual([1, 2, 3, 4]);\n  });\n\n  it('middleware can modify task', async () => {\n    tq.useMiddleware<{ raw: string }>('default', async (task, next) => {\n      (task.payload as unknown as Record<string, unknown>).modified = true;\n      await next();\n    });\n    let seenPayload: unknown;\n    tq.setProcessor('default', async (task) => { seenPayload = task.payload; });\n    tq.addTask({ raw: 'data' });\n    await tq.processNext();\n    expect((seenPayload as Record<string, unknown>).modified).toBe(true);\n  });\n\n  it('middleware throwing marks task as failed', async () => {\n    tq.useMiddleware('default', async () => { throw new Error('mw error'); });\n    tq.addTask('x', { maxRetries: 0 });\n    await tq.processNext();\n    const dlq = tq.getDeadLetterTasks();\n    expect(dlq).toHaveLength(1);\n  });\n\n  it('each queue has independent middleware stack', async () => {\n    const calls: string[] = [];\n    tq.useMiddleware('q1', async (_, next) => { calls.push('q1'); await next(); });\n    tq.setProcessor('q1', async () => {});\n    tq.setProcessor('q2', async () => {});\n    tq.addTask('x', { queue: 'q1' });\n    tq.addTask('y', { queue: 'q2' });\n    await tq.processNext('q1');\n    await tq.processNext('q2');\n    expect(calls).toEqual(['q1']);\n  });\n});\n\n// ============================================================\n// Phase 12: Graceful Shutdown\n// ============================================================\ndescribe('Phase 12: Graceful Shutdown', () => {\n  it('rejects new tasks after shutdown initiated', async () => {\n    const shutdownPromise = tq.shutdown(1000);\n    expect(() => tq.addTask('x')).toThrow();\n    await shutdownPromise;\n  });\n\n  it('shutdown completes immediately if no tasks processing', async () => {\n    const start = Date.now();\n    const summary = await tq.shutdown(5000);\n    expect(Date.now() - start).toBeLessThan(200);\n    expect(summary.completed).toBe(0);\n    expect(summary.forceCancelled).toBe(0);\n  });\n\n  it('shutdown waits for processing tasks to complete', async () => {\n    tq.addTask('x');\n    const t = tq.dequeue()!;\n    // Complete it after 100ms\n    setTimeout(() => tq.complete(t.id), 100);\n    const summary = await tq.shutdown(2000);\n    expect(summary.completed).toBe(1);\n    expect(summary.forceCancelled).toBe(0);\n  });\n\n  it('force-cancels tasks that exceed timeout', async () => {\n    tq.addTask('x');\n    tq.dequeue(); // processing, never completed\n    const summary = await tq.shutdown(100);\n    expect(summary.forceCancelled).toBe(1);\n  });\n\n  it('calls registered shutdown callbacks', async () => {\n    const cb = vi.fn();\n    tq.onShutdown(cb);\n    await tq.shutdown(0);\n    expect(cb).toHaveBeenCalled();\n  });\n\n  it('calling shutdown twice returns same result', async () => {\n    const p1 = tq.shutdown(1000);\n    const p2 = tq.shutdown(1000);\n    const [r1, r2] = await Promise.all([p1, p2]);\n    expect(r1).toBe(r2);\n  });\n\n  it('summary includes durationMs', async () => {\n    const summary = await tq.shutdown();\n    expect(summary.durationMs).toBeGreaterThanOrEqual(0);\n  });\n});\n\n// suppress unused variable warnings for test code\nconst _ = (_: unknown) => {};\n","structuredPatch":[{"oldStart":375,"oldLines":7,"newStart":375,"newLines":7,"lines":["     const lo = tq.addTask('lo', { priority: 9 });","     const hi = tq.addTask('hi', { priority: 1 });","     expect(tq.dequeue()?.id).toBe(hi.id);","-    _ = lo;","+    void lo;","   });"," });"," "]}],"userModified":false,"replaceAll":false}}
