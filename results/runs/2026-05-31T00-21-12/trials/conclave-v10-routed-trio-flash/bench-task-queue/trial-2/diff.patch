+export function parseCron(expr: string): (date: Date) => boolean {
+  // Supported:
+  // */N * * * *  -- every N minutes
+  // 0 * * * *   -- every hour on the hour
+  // 0 0 * * *   -- every day at midnight
+
+  const parts = expr.trim().split(/\s+/);
+  if (parts.length !== 5) throw new Error(`Unsupported cron expression: ${expr}`);
+
+  const [min, hour, dom, month, dow] = parts;
+
+  // every N minutes: */N * * * *
+  if (min.startsWith('*/') && hour === '*' && dom === '*' && month === '*' && dow === '*') {
+    const n = parseInt(min.slice(2), 10);
+    if (isNaN(n) || n <= 0) throw new Error(`Invalid cron expression: ${expr}`);
+    return (date: Date) => date.getMinutes() % n === 0;
+  }
+
+  // every hour: 0 * * * *
+  if (min === '0' && hour === '*' && dom === '*' && month === '*' && dow === '*') {
+    return (date: Date) => date.getMinutes() === 0;
+  }
+
+  // every day at midnight: 0 0 * * *
+  if (min === '0' && hour === '0' && dom === '*' && month === '*' && dow === '*') {
+    return (date: Date) => date.getMinutes() === 0 && date.getHours() === 0;
+  }
+
+  throw new Error(`Unsupported cron expression: ${expr}`);
+}
