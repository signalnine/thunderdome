@@ -0,0 +1,309 @@
+import { Queue } from './Queue.js';
+import {
+  Task,
+  AddTaskOptions,
+  QueueStats,
+  ShutdownSummary,
+  MiddlewareFn,
+  ProcessorFn,
+  DeadLetterEntry,
+  Schedule,
+} from './types.js';
+import { generateScheduleId } from './utils.js';
+import { parseCron } from './cron.js';
+
+export class TaskQueueSystem {
+  private queues: Map<string, Queue> = new Map();
+  private allTaskIds: Set<string> = new Set();
+  private schedules: Map<string, Schedule> = new Map();
+  private shutdownInitiated = false;
+  private shutdownCallbacks: Array<() => void | Promise<void>> = [];
+
+  static readonly DEFAULT_QUEUE = 'default';
+
+  private getOrCreateQueue(name: string): Queue {
+    if (!this.queues.has(name)) {
+      this.queues.set(name, new Queue(name, this.allTaskIds));
+    }
+    return this.queues.get(name)!;
+  }
+
+  addTask<T = unknown>(payload: T, options: AddTaskOptions = {}): Task<T> {
+    if (this.shutdownInitiated) {
+      throw new Error('System is shutting down, cannot add new tasks');
+    }
+
+    const queueName = options.queue ?? TaskQueueSystem.DEFAULT_QUEUE;
+    this.validateCircularDependencies(options.dependencies ?? []);
+
+    const queue = this.getOrCreateQueue(queueName) as Queue<T>;
+    return queue.addTask(payload, options);
+  }
+
+  private validateCircularDependencies(depIds: string[], visited: Set<string> = new Set(), path: Set<string> = new Set()): void {
+    for (const depId of depIds) {
+      if (!this.allTaskIds.has(depId)) continue; // existence check done in Queue
+      if (path.has(depId)) {
+        throw new Error(`Circular dependency detected involving task ${depId}`);
+      }
+      if (!visited.has(depId)) {
+        visited.add(depId);
+        const task = this.getTaskById(depId);
+        if (task) {
+          const newPath = new Set(path);
+          newPath.add(depId);
+          this.validateCircularDependencies(task.dependencies, visited, newPath);
+        }
+      }
+    }
+  }
+
+  dequeue(queueName: string = TaskQueueSystem.DEFAULT_QUEUE): Task | null {
+    const queue = this.queues.get(queueName);
+    if (!queue) return null;
+    return queue.dequeue();
+  }
+
+  complete(taskId: string): Task {
+    const queue = this.findQueueForTask(taskId);
+    if (!queue) throw new Error(`Task ${taskId} not found`);
+    return queue.complete(taskId);
+  }
+
+  fail(taskId: string, error?: Error): Task {
+    const queue = this.findQueueForTask(taskId);
+    if (!queue) throw new Error(`Task ${taskId} not found`);
+    return queue.fail(taskId, error);
+  }
+
+  cancel(taskId: string): Task {
+    const queue = this.findQueueForTask(taskId);
+    if (!queue) throw new Error(`Task ${taskId} not found`);
+    return queue.cancel(taskId);
+  }
+
+  pendingCount(queueName: string = TaskQueueSystem.DEFAULT_QUEUE): number {
+    const queue = this.queues.get(queueName);
+    if (!queue) return 0;
+    return queue.pendingCount();
+  }
+
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  getTaskById(taskId: string): Task | undefined {
+    for (const queue of this.queues.values()) {
+      const task = queue.getTaskById(taskId);
+      if (task) return task;
+    }
+    return undefined;
+  }
+
+  private findQueueForTask(taskId: string): Queue | undefined {
+    for (const queue of this.queues.values()) {
+      if (queue.getTaskById(taskId)) return queue;
+    }
+    return undefined;
+  }
+
+  reportProgress(taskId: string, percent: number, message?: string): void {
+    const queue = this.findQueueForTask(taskId);
+    if (!queue) throw new Error(`Task ${taskId} not found`);
+    queue.reportProgress(taskId, percent, message);
+  }
+
+  subscribeProgress(
+    taskId: string,
+    fn: (p: { percent: number; message?: string }) => void
+  ): () => void {
+    const queue = this.findQueueForTask(taskId);
+    if (!queue) throw new Error(`Task ${taskId} not found`);
+    return queue.subscribeProgress(taskId, fn);
+  }
+
+  getDeadLetterTasks(queueName: string = TaskQueueSystem.DEFAULT_QUEUE): DeadLetterEntry[] {
+    const queue = this.queues.get(queueName);
+    if (!queue) return [];
+    return queue.getDeadLetterTasks();
+  }
+
+  requeueFromDLQ(taskId: string): Task {
+    for (const queue of this.queues.values()) {
+      const dlqEntries = queue.getDeadLetterTasks();
+      if (dlqEntries.some((e) => e.task.id === taskId)) {
+        return queue.requeueFromDLQ(taskId);
+      }
+    }
+    throw new Error(`Task ${taskId} not in any dead letter queue`);
+  }
+
+  clearDLQ(queueName: string = TaskQueueSystem.DEFAULT_QUEUE): void {
+    const queue = this.queues.get(queueName);
+    if (queue) queue.clearDLQ();
+  }
+
+  setConcurrencyLimit(queueName: string, limit: number | null): void {
+    this.getOrCreateQueue(queueName).setConcurrencyLimit(limit);
+  }
+
+  getConcurrencyLimit(queueName: string): number | null {
+    return this.queues.get(queueName)?.getConcurrencyLimit() ?? null;
+  }
+
+  getActiveCount(queueName: string): number {
+    return this.queues.get(queueName)?.getActiveCount() ?? 0;
+  }
+
+  getQueueStats(queueName: string): QueueStats | null {
+    const queue = this.queues.get(queueName);
+    if (!queue) return null;
+    return {
+      name: queueName,
+      pending: queue.pendingCount(),
+      processing: queue.getActiveCount(),
+      concurrencyLimit: queue.getConcurrencyLimit(),
+      activeCount: queue.getActiveCount(),
+    };
+  }
+
+  useMiddleware<T = unknown>(queueName: string, fn: MiddlewareFn<T>): void {
+    (this.getOrCreateQueue(queueName) as Queue<T>).useMiddleware(fn);
+  }
+
+  setProcessor<T = unknown>(queueName: string, fn: ProcessorFn<T>): void {
+    (this.getOrCreateQueue(queueName) as Queue<T>).setProcessor(fn);
+  }
+
+  async processNext(queueName: string = TaskQueueSystem.DEFAULT_QUEUE): Promise<Task | null> {
+    const queue = this.queues.get(queueName);
+    if (!queue) return null;
+    const task = queue.dequeue();
+    if (!task) return null;
+
+    try {
+      await queue.runWithMiddleware(task);
+      if (task.status === 'processing') {
+        queue.complete(task.id);
+      }
+    } catch (err) {
+      if (task.status === 'processing') {
+        queue.fail(task.id, err instanceof Error ? err : new Error(String(err)));
+      }
+    }
+    return task;
+  }
+
+  addSchedule(cron: string, queueName: string, payload: unknown, options: Omit<AddTaskOptions, 'queue'> = {}): Schedule {
+    parseCron(cron); // validate
+    const id = generateScheduleId();
+    const schedule: Schedule = {
+      id,
+      cron,
+      queueName,
+      payload,
+      options,
+      lastRun: null,
+    };
+    this.schedules.set(id, schedule);
+    return schedule;
+  }
+
+  removeSchedule(scheduleId: string): void {
+    if (!this.schedules.has(scheduleId)) {
+      throw new Error(`Schedule ${scheduleId} not found`);
+    }
+    this.schedules.delete(scheduleId);
+  }
+
+  listSchedules(): Schedule[] {
+    return [...this.schedules.values()];
+  }
+
+  tick(now: Date = new Date()): Task[] {
+    const enqueued: Task[] = [];
+    for (const schedule of this.schedules.values()) {
+      const matcher = parseCron(schedule.cron);
+      if (matcher(now)) {
+        const task = this.addTask(schedule.payload, {
+          ...schedule.options,
+          queue: schedule.queueName,
+        });
+        schedule.lastRun = now;
+        enqueued.push(task);
+      }
+    }
+    return enqueued;
+  }
+
+  onShutdown(fn: () => void | Promise<void>): void {
+    this.shutdownCallbacks.push(fn);
+  }
+
+  async shutdown(timeoutMs = 30000): Promise<ShutdownSummary> {
+    if (this.shutdownInitiated) {
+      return this._shutdownPromise!;
+    }
+    this.shutdownInitiated = true;
+    this._shutdownPromise = this._doShutdown(timeoutMs);
+    return this._shutdownPromise;
+  }
+
+  private _shutdownPromise: Promise<ShutdownSummary> | null = null;
+
+  private async _doShutdown(timeoutMs: number): Promise<ShutdownSummary> {
+    const startTime = Date.now();
+
+    for (const cb of this.shutdownCallbacks) {
+      await cb();
+    }
+
+    const processingTasks: Task[] = [];
+    for (const queue of this.queues.values()) {
+      processingTasks.push(...queue.getProcessingTasks());
+    }
+
+    let completed = 0;
+    let forceCancelled = 0;
+
+    if (processingTasks.length === 0) {
+      return { completed: 0, forceCancelled: 0, durationMs: Date.now() - startTime };
+    }
+
+    const deadline = Date.now() + timeoutMs;
+
+    await new Promise<void>((resolve) => {
+      const check = () => {
+        const stillProcessing = processingTasks.filter((t) => t.status === 'processing');
+        if (stillProcessing.length === 0 || Date.now() >= deadline) {
+          resolve();
+        } else {
+          setTimeout(check, 50);
+        }
+      };
+      check();
+    });
+
+    for (const task of processingTasks) {
+      if (task.status === 'completed') {
+        completed++;
+      } else if (task.status === 'processing') {
+        const queue = this.findQueueForTask(task.id);
+        if (queue) {
+          try {
+            queue.cancel(task.id);
+          } catch {
+            // already changed status
+          }
+        }
+        forceCancelled++;
+      }
+    }
+
+    return {
+      completed,
+      forceCancelled,
+      durationMs: Date.now() - startTime,
+    };
+  }
+}
