tring,\n    fn: (p: { percent: number; message?: string }) => void\n  ): () => void {\n    const queue = this.findQueueForTask(taskId);\n    if (!queue) throw new Error(`Task ${taskId} not found`);\n    return queue.subscribeProgress(taskId, fn);\n  }\n\n  getDeadLetterTasks(queueName: string = TaskQueueSystem.DEFAULT_QUEUE): DeadLetterEntry[] {\n    const queue = this.queues.get(queueName);\n    if (!queue) return [];\n    return queue.getDeadLetterTasks();\n  }\n\n  requeueFromDLQ(taskId: string): Task {\n    for (const queue of this.queues.values()) {\n      const dlqEntries = queue.getDeadLetterTasks();\n      if (dlqEntries.some((e) => e.task.id === taskId)) {\n        return queue.requeueFromDLQ(taskId);\n      }\n    }\n    throw new Error(`Task ${taskId} not in any dead letter queue`);\n  }\n\n  clearDLQ(queueName: string = TaskQueueSystem.DEFAULT_QUEUE): void {\n    const queue = this.queues.get(queueName);\n    if (queue) queue.clearDLQ();\n  }\n\n  setConcurrencyLimit(queueName: string, limit: number | null): void {\n    this.getOrCreateQueue(queueName).setConcurrencyLimit(limit);\n  }\n\n  getConcurrencyLimit(queueName: string): number | null {\n    return this.queues.get(queueName)?.getConcurrencyLimit() ?? null;\n  }\n\n  getActiveCount(queueName: string): number {\n    return this.queues.get(queueName)?.getActiveCount() ?? 0;\n  }\n\n  getQueueStats(queueName: string): QueueStats | null {\n    const queue = this.queues.get(queueName);\n    if (!queue) return null;\n    return {\n      name: queueName,\n      pending: queue.pendingCount(),\n      processing: queue.getActiveCount(),\n      concurrencyLimit: queue.getConcurrencyLimit(),\n      activeCount: queue.getActiveCount(),\n    };\n  }\n\n  useMiddleware<T = unknown>(queueName: string, fn: MiddlewareFn<T>): void {\n    (this.getOrCreateQueue(queueName) as Queue<T>).useMiddleware(fn);\n  }\n\n  setProcessor<T = unknown>(queueName: string, fn: ProcessorFn<T>): void {\n    (this.getOrCreateQueue(queueName) as Queue<T>).setProcessor(fn);\n  }\n\n  async processNext(queueName: string = TaskQueueSystem.DEFAULT_QUEUE): Promise<Task | null> {\n    const queue = this.queues.get(queueName);\n    if (!queue) return null;\n    const task = queue.dequeue();\n    if (!task) return null;\n\n    try {\n      await queue.runWithMiddleware(task);\n      if (task.status === 'processing') {\n        queue.complete(task.id);\n      }\n    } catch (err) {\n      if (task.status === 'processing') {\n        queue.fail(task.id, err instanceof Error ? err : new Error(String(err)));\n      }\n    }\n    return task;\n  }\n\n  addSchedule(cron: string, queueName: string, payload: unknown, options: Omit<AddTaskOptions, 'queue'> = {}): Schedule {\n    parseCron(cron); // validate\n    const id = generateScheduleId();\n    const schedule: Schedule = {\n      id,\n      cron,\n      queueName,\n      payload,\n      options,\n      lastRun: null,\n    };\n    this.schedules.set(id, schedule);\n    return schedule;\n  }\n\n  removeSchedule(scheduleId: string): void {\n    if (!this.schedules.has(scheduleId)) {\n      throw new Error(`Schedule ${scheduleId} not found`);\n    }\n    this.schedules.delete(scheduleId);\n  }\n\n  listSchedules(): Schedule[] {\n    return [...this.schedules.values()];\n  }\n\n  tick(now: Date = new Date()): Task[] {\n    const enqueued: Task[] = [];\n    for (const schedule of this.schedules.values()) {\n      const matcher = parseCron(schedule.cron);\n      if (matcher(now)) {\n        const task = this.addTask(schedule.payload, {\n          ...schedule.options,\n          queue: schedule.queueName,\n        });\n        schedule.lastRun = now;\n        enqueued.push(task);\n      }\n    }\n    return enqueued;\n  }\n\n  onShutdown(fn: () => void | Promise<void>): void {\n    this.shutdownCallbacks.push(fn);\n  }\n\n  async shutdown(timeoutMs = 30000): Promise<ShutdownSummary> {\n    if (this.shutdownInitiated) {\n      return this._shutdownPromise!;\n    }\n  