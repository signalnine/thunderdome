ror(`Dependency task ${depId} does not exist`);\n      }\n    }\n\n    // Check for circular dependencies\n    if (dependencies.length > 0) {\n      this.checkCircularDependencies(dependencies, new Set());\n    }\n\n    let resolvedAvailableAt = new Date();\n    if (availableAt) {\n      resolvedAvailableAt = availableAt;\n    } else if (delay !== undefined) {\n      resolvedAvailableAt = new Date(Date.now() + delay);\n    }\n\n    const hasUnresolvedDeps = dependencies.some(depId => {\n      const dep = this.tasks.get(depId);\n      return dep && dep.status !== 'completed';\n    });\n\n    const task: Task<T> = {\n      id: generateId(),\n      payload,\n      status: hasUnresolvedDeps ? 'blocked' : 'pending',\n      priority,\n      createdAt: new Date(),\n      availableAt: resolvedAvailableAt,\n      attempts: 0,\n      maxRetries,\n      retryDelay,\n      queueName: this.name,\n      dependencies,\n      progress: 0,\n    };\n\n    this.tasks.set(task.id, task);\n    return task;\n  }\n\n  private checkCircularDependencies(depIds: string[], visiting: Set<string>): void {\n    for (const depId of depIds) {\n      if (visiting.has(depId)) {\n        throw new Error(`Circular dependency detected involving task ${depId}`);\n      }\n      const dep = this.tasks.get(depId);\n      if (dep && dep.dependencies.length > 0) {\n        const newVisiting = new Set(visiting);\n        newVisiting.add(depId);\n        this.checkCircularDependencies(dep.dependencies, newVisiting);\n      }\n    }\n  }\n\n  next(): Task<T> | null {\n    if (this.concurrencyLimit !== null && this.activeCount >= this.concurrencyLimit) {\n      return null;\n    }\n\n    const now = Date.now();\n    const available = Array.from(this.tasks.values()).filter(\n      t => t.status === 'pending' && t.availableAt.getTime() <= now\n    );\n\n    if (available.length === 0) return null;\n\n    // Sort: priority (asc = higher priority), then availableAt (asc), then createdAt (asc)\n    available.sort((a