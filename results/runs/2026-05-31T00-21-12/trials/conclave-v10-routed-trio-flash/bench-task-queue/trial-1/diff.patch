  add(payload: T, options: AddTaskOptions = {}): Task<T> {\n    if (this.shutdownPromise) {\n      throw new Error('System is shutting down; cannot add new tasks');\n    }\n    const queueName = options.queueName ?? DEFAULT_QUEUE;\n    const queue = this.getOrCreateQueue(queueName);\n    return queue.addTask(payload, { ...options, queueName });\n  }\n\n  // Phase 2: Get next task from named queue\n  next(queueName: string = DEFAULT_QUEUE): Task<T> | null {\n    const queue = this.getQueue(queueName);\n    if (!queue) return null;\n    return queue.next();\n  }\n\n  // Phase 1: Pending count\n  pendingCount(queueName: string = DEFAULT_QUEUE): number {\n    return this.getQueue(queueName)?.pendingCount() ?? 0;\n  }\n\n  size(queueName: string = DEFAULT_QUEUE): number {\n    return this.getQueue(queueName)?.size() ?? 0;\n  }\n\n  // Phase 2: List queues\n  listQueues(): string[] {\n    return Array.from(this.queues.keys());\n  }\n\n  // Phase 5: Complete a task\n  complete(taskId: string, queueName: string = DEFAULT_QUEUE): void {\n    const queue = this.getQueue(queueName);\n    if (!queue) throw new Error(`Queue ${queueName} not found`);\n    queue.complete(taskId);\n  }\n\n  // Phase 5: Fail a task\n  fail(taskId: string, error?: Error, queueName: string = DEFAULT_QUEUE): void {\n    const queue = this.getQueue(queueName);\n    if (!queue) throw new Error(`Queue ${queueName} not found`);\n    queue.fail(taskId, error);\n  }\n\n  // Phase 6: Dead letter queue\n  getDeadLetterQueue(queueName: string = DEFAULT_QUEUE): Task<T>[] {\n    return this.getQueue(queueName)?.getDeadLetterQueue() ?? [];\n  }\n\n  requeueFromDLQ(taskId: string, queueName: string = DEFAULT_QUEUE): Task<T> {\n    const queue = this.getQueue(queueName);\n    if (!queue) throw new Error(`Queue ${queueName} not found`);\n    return queue.requeueFromDLQ(taskId);\n  }\n\n  clearDeadLetterQueue(queueName: string = DEFAULT_QUEUE): void {\n    this.getQueue(queueName)?.clearDeadLetterQueue();\n  }\n\n  // Phase 7: Get task (for dependency inspection)\n  getTask(taskId: string, queueName: string = DEFAULT_QUEUE): Task<T> | undefined {\n    return this.getQueue(queueName)?.getTask(taskId);\n  }\n\n  // Phase 8: Concurrency\n  setConcurrency(limit: number | null, queueName: string = DEFAULT_QUEUE): void {\n    this.getOrCreateQueue(queueName).setConcurrency(limit);\n  }\n\n  getConcurrency(queueName: string = DEFAULT_QUEUE): number | null {\n    return this.getQueue(queueName)?.getConcurrency() ?? null;\n  }\n\n  getActiveCount(queueName: string = DEFAULT_QUEUE): number {\n    return this.getQueue(queueName)?.getActiveCount() ?? 0;\n  }\n\n  // Phase 9: Progress\n  setProgress(taskId: string, progress: number, message?: string, queueName: string = DEFAULT_QUEUE): void {\n    const queue = this.getQueue(queueName);\n    if (!queue) throw new Error(`Queue ${queueName} not found`);\n    queue.setProgress(taskId, progress, message);\n  }\n\n  onProgress(\n    taskId: string,\n    listener: (progress: number, message?: string) => void,\n    queueName: string = DEFAULT_QUEUE\n  ): () => void {\n    const queue = this.getOrCreateQueue(queueName);\n    return queue.onProgress(taskId, listener);\n  }\n\n  // Phase 9: Cancel\n  cancel(taskId: string, queueName: string = DEFAULT_QUEUE): boolean {\n    const queue = this.getQueue(queueName);\n    if (!queue) return false;\n    return queue.cancel(taskId);\n  }\n\n  // Phase 10: Scheduling\n  createSchedule(cronExpression: string, queueName: string, payload: unknown): Schedule {\n    return this.scheduler.create(cronExpression, queueName, payload);\n  }\n\n  removeSchedule(scheduleId: string): boolean {\n    return this.scheduler.remove(scheduleId);\n  }\n\n  listSchedules(): Schedule[] {\n    return this.scheduler.list();\n  }\n\n  tick(now?: Date): void {\n    const results = this.scheduler.tick(now);\n    for (const { schedule, shouldEnqueue } of results) {\n      if (shouldEnqueue && !this.shutdownPromise) {\n        this.getOr