@@ -0,0 +1,88 @@
+import { Schedule } from './types.js';
+
+let scheduleCounter = 0;
+
+interface ParsedCron {
+  type: 'every-n-minutes' | 'every-hour' | 'every-day';
+  n?: number;
+}
+
+function parseCron(expr: string): ParsedCron {
+  const parts = expr.trim().split(/\s+/);
+  if (parts.length !== 5) throw new Error(`Invalid cron expression: ${expr}`);
+
+  const [minute, hour, dom, month, dow] = parts;
+
+  if (hour === '*' && dom === '*' && month === '*' && dow === '*') {
+    const everyNMatch = minute.match(/^\*\/(\d+)$/);
+    if (everyNMatch) {
+      return { type: 'every-n-minutes', n: parseInt(everyNMatch[1]) };
+    }
+  }
+
+  if (minute === '0' && dom === '*' && month === '*' && dow === '*') {
+    if (hour === '*') return { type: 'every-hour' };
+  }
+
+  if (minute === '0' && hour === '0' && dom === '*' && month === '*' && dow === '*') {
+    return { type: 'every-day' };
+  }
+
+  throw new Error(`Unsupported cron expression: ${expr}. Supported: "*/N * * * *", "0 * * * *", "0 0 * * *"`);
+}
+
+function isDue(schedule: Schedule, now: Date): boolean {
+  const parsed = parseCron(schedule.cronExpression);
+  const last = schedule.lastRun;
+
+  if (!last) return true;
+
+  const diffMs = now.getTime() - last.getTime();
+
+  switch (parsed.type) {
+    case 'every-n-minutes':
+      return diffMs >= (parsed.n! * 60 * 1000);
+    case 'every-hour':
+      return diffMs >= 60 * 60 * 1000;
+    case 'every-day':
+      return diffMs >= 24 * 60 * 60 * 1000;
+  }
+}
+
+export class Scheduler {
+  private schedules: Map<string, Schedule> = new Map();
+
+  create(cronExpression: string, queueName: string, payload: unknown): Schedule {
+    // Validate
+    parseCron(cronExpression);
+
+    const schedule: Schedule = {
+      id: `schedule-${++scheduleCounter}`,
+      cronExpression,
+      queueName,
+      payload,
+    };
+    this.schedules.set(schedule.id, schedule);
+    return schedule;
+  }
+
+  remove(scheduleId: string): boolean {
+    return this.schedules.delete(scheduleId);
+  }
+
+  list(): Schedule[] {
+    return Array.from(this.schedules.values());
+  }
+
+  tick(now: Date = new Date()): Array<{ schedule: Schedule; shouldEnqueue: boolean }> {
+    const results = [];
+    for (const schedule of this.schedules.values()) {
+      const shouldEnqueue = isDue(schedule, now);
+      if (shouldEnqueue) {
+        schedule.lastRun = now;
+      }
+      results.push({ schedule, shouldEnqueue });
+    }
+    return results;
+  }
+}
