@@ -0,0 +1,286 @@
+import { Task, AddTaskOptions, Middleware, Handler } from './types.js';
+
+let idCounter = 0;
+function generateId(): string {
+  return `task-${++idCounter}-${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;
+}
+
+export class Queue<T = unknown> {
+  readonly name: string;
+  private tasks: Map<string, Task<T>> = new Map();
+  private deadLetterQueue: Task<T>[] = [];
+  private concurrencyLimit: number | null = null;
+  private activeCount = 0;
+  private middlewares: Middleware<T>[] = [];
+  private handler: Handler<T> | null = null;
+  private progressListeners: Map<string, Set<(progress: number, message?: string) => void>> = new Map();
+
+  constructor(name: string, options?: { concurrency?: number }) {
+    this.name = name;
+    if (options?.concurrency !== undefined) {
+      this.concurrencyLimit = options.concurrency;
+    }
+  }
+
+  addTask(payload: T, options: AddTaskOptions = {}): Task<T> {
+    const { priority = 5, delay, availableAt, maxRetries = 3, retryDelay = 1000, dependencies = [] } = options;
+
+    if (priority < 1 || priority > 10) {
+      throw new Error(`Priority must be between 1 and 10, got ${priority}`);
+    }
+
+    // Validate dependencies exist
+    for (const depId of dependencies) {
+      if (!this.tasks.has(depId)) {
+        throw new Error(`Dependency task ${depId} does not exist`);
+      }
+    }
+
+    // Check for circular dependencies
+    if (dependencies.length > 0) {
+      this.checkCircularDependencies(dependencies, new Set());
+    }
+
+    let resolvedAvailableAt = new Date();
+    if (availableAt) {
+      resolvedAvailableAt = availableAt;
+    } else if (delay !== undefined) {
+      resolvedAvailableAt = new Date(Date.now() + delay);
+    }
+
+    const hasUnresolvedDeps = dependencies.some(depId => {
+      const dep = this.tasks.get(depId);
+      return dep && dep.status !== 'completed';
+    });
+
+    const task: Task<T> = {
+      id: generateId(),
+      payload,
+      status: hasUnresolvedDeps ? 'blocked' : 'pending',
+      priority,
+      createdAt: new Date(),
+      availableAt: resolvedAvailableAt,
+      attempts: 0,
+      maxRetries,
+      retryDelay,
+      queueName: this.name,
+      dependencies,
+      progress: 0,
+    };
+
+    this.tasks.set(task.id, task);
+    return task;
+  }
+
+  private checkCircularDependencies(depIds: string[], visiting: Set<string>): void {
+    for (const depId of depIds) {
+      if (visiting.has(depId)) {
+        throw new Error(`Circular dependency detected involving task ${depId}`);
+      }
+      const dep = this.tasks.get(depId);
+      if (dep && dep.dependencies.length > 0) {
+        const newVisiting = new Set(visiting);
+        newVisiting.add(depId);
+        this.checkCircularDependencies(dep.dependencies, newVisiting);
+      }
+    }
+  }
+
+  next(): Task<T> | null {
+    if (this.concurrencyLimit !== null && this.activeCount >= this.concurrencyLimit) {
+      return null;
+    }
+
+    const now = Date.now();
+    const available = Array.from(this.tasks.values()).filter(
+      t => t.status === 'pending' && t.availableAt.getTime() <= now
+    );
+
+    if (available.length === 0) return null;
+
+    // Sort: priority (asc = higher priority), then availableAt (asc), then createdAt (asc)
+    available.sort((a, b) => {
+      if (a.priority !== b.priority) return a.priority - b.priority;
+      if (a.availableAt.getTime() !== b.availableAt.getTime()) {
+        return a.availableAt.getTime() - b.availableAt.getTime();
+      }
+      return a.createdAt.getTime() - b.createdAt.getTime();
+    });
+
+    const task = available[0];
+    task.status = 'processing';
+    task.attempts += 1;
+    this.activeCount += 1;
+    return task;
+  }
+
+  complete(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new Error(`Task ${taskId} not found`);
+    if (task.status !== 'processing') throw new Error(`Task ${taskId} is not processing`);
+
+    task.status = 'completed';
+    task.completedAt = new Date();
+    this.activeCount = Math.max(0, this.activeCount - 1);
+    this.unblockDependents(taskId);
+  }
+
+  fail(taskId: string, error?: Error): void {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new Error(`Task ${taskId} not found`);
+    if (task.status !== 'processing') throw new Error(`Task ${taskId} is not processing`);
+
+    this.activeCount = Math.max(0, this.activeCount - 1);
+
+    if (task.attempts <= task.maxRetries) {
+      // Retry with exponential backoff
+      const backoffDelay = task.retryDelay * Math.pow(2, task.attempts - 1);
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + backoffDelay);
+      task.error = error;
+    } else {
+      task.status = 'failed';
+      task.error = error;
+      task.failedAt = new Date();
+      // Move to dead letter queue
+      this.tasks.delete(taskId);
+      this.deadLetterQueue.push(task);
+    }
+  }
+
+  cancel(taskId: string): boolean {
+    const task = this.tasks.get(taskId);
+    if (!task) return false;
+    if (task.status !== 'pending' && task.status !== 'processing' && task.status !== 'blocked') return false;
+
+    if (task.status === 'processing') {
+      this.activeCount = Math.max(0, this.activeCount - 1);
+    }
+
+    task.status = 'cancelled';
+    task.maxRetries = 0; // Prevent retries
+    return true;
+  }
+
+  private unblockDependents(completedTaskId: string): void {
+    for (const task of this.tasks.values()) {
+      if (task.status === 'blocked' && task.dependencies.includes(completedTaskId)) {
+        const allResolved = task.dependencies.every(depId => {
+          const dep = this.tasks.get(depId);
+          return dep?.status === 'completed';
+        });
+        if (allResolved) {
+          task.status = 'pending';
+        }
+      }
+    }
+  }
+
+  getTask(taskId: string): Task<T> | undefined {
+    return this.tasks.get(taskId) ?? this.deadLetterQueue.find(t => t.id === taskId);
+  }
+
+  pendingCount(): number {
+    const now = Date.now();
+    return Array.from(this.tasks.values()).filter(
+      t => t.status === 'pending' && t.availableAt.getTime() <= now
+    ).length;
+  }
+
+  size(): number {
+    return Array.from(this.tasks.values()).filter(t => t.status === 'pending').length;
+  }
+
+  getDeadLetterQueue(): Task<T>[] {
+    return [...this.deadLetterQueue];
+  }
+
+  requeueFromDLQ(taskId: string): Task<T> {
+    const idx = this.deadLetterQueue.findIndex(t => t.id === taskId);
+    if (idx === -1) throw new Error(`Task ${taskId} not found in dead letter queue`);
+
+    const task = this.deadLetterQueue.splice(idx, 1)[0];
+    task.status = 'pending';
+    task.attempts = 0;
+    task.availableAt = new Date();
+    task.error = undefined;
+    task.failedAt = undefined;
+    this.tasks.set(task.id, task);
+    return task;
+  }
+
+  clearDeadLetterQueue(): void {
+    this.deadLetterQueue = [];
+  }
+
+  setProgress(taskId: string, progress: number, message?: string): void {
+    if (progress < 0 || progress > 100) throw new Error('Progress must be 0-100');
+    const task = this.tasks.get(taskId);
+    if (!task) throw new Error(`Task ${taskId} not found`);
+    if (task.status !== 'processing') throw new Error(`Task ${taskId} is not processing`);
+
+    task.progress = progress;
+    task.progressMessage = message;
+
+    const listeners = this.progressListeners.get(taskId);
+    if (listeners) {
+      for (const listener of listeners) {
+        listener(progress, message);
+      }
+    }
+  }
+
+  onProgress(taskId: string, listener: (progress: number, message?: string) => void): () => void {
+    if (!this.progressListeners.has(taskId)) {
+      this.progressListeners.set(taskId, new Set());
+    }
+    this.progressListeners.get(taskId)!.add(listener);
+    return () => {
+      this.progressListeners.get(taskId)?.delete(listener);
+    };
+  }
+
+  setConcurrency(limit: number | null): void {
+    this.concurrencyLimit = limit;
+  }
+
+  getConcurrency(): number | null {
+    return this.concurrencyLimit;
+  }
+
+  getActiveCount(): number {
+    return this.activeCount;
+  }
+
+  use(middleware: Middleware<T>): void {
+    this.middlewares.push(middleware);
+  }
+
+  setHandler(handler: Handler<T>): void {
+    this.handler = handler;
+  }
+
+  async processWithMiddleware(task: Task<T>): Promise<void> {
+    const stack = [...this.middlewares];
+    let index = 0;
+
+    const next = async (): Promise<void> => {
+      if (index < stack.length) {
+        const mw = stack[index++];
+        await mw(task, next);
+      } else if (this.handler) {
+        await this.handler(task);
+      }
+    };
+
+    await next();
+  }
+
+  getAllTasks(): Task<T>[] {
+    return Array.from(this.tasks.values());
+  }
+
+  getProcessingTasks(): Task<T>[] {
+    return Array.from(this.tasks.values()).filter(t => t.status === 'processing');
+  }
+}
