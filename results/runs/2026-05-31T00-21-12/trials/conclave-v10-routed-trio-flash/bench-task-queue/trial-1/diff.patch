+import { Queue } from './Queue.js';
+import { Scheduler } from './Scheduler.js';
+import { Task, AddTaskOptions, QueueOptions, Middleware, Handler, Schedule, ShutdownResult } from './types.js';
+
+const DEFAULT_QUEUE = 'default';
+
+export class TaskQueueSystem<T = unknown> {
+  private queues: Map<string, Queue<T>> = new Map();
+  private scheduler: Scheduler = new Scheduler();
+  private shutdownPromise: Promise<ShutdownResult> | null = null;
+  private shutdownCallbacks: Array<() => void | Promise<void>> = [];
+
+  private getOrCreateQueue(name: string, options?: QueueOptions): Queue<T> {
+    if (!this.queues.has(name)) {
+      this.queues.set(name, new Queue<T>(name, options));
+    }
+    return this.queues.get(name)!;
+  }
+
+  private getQueue(name: string): Queue<T> | undefined {
+    return this.queues.get(name);
+  }
+
+  // Phase 1 & 2: Add task
+  add(payload: T, options: AddTaskOptions = {}): Task<T> {
+    if (this.shutdownPromise) {
+      throw new Error('System is shutting down; cannot add new tasks');
+    }
+    const queueName = options.queueName ?? DEFAULT_QUEUE;
+    const queue = this.getOrCreateQueue(queueName);
+    return queue.addTask(payload, { ...options, queueName });
+  }
+
+  // Phase 2: Get next task from named queue
+  next(queueName: string = DEFAULT_QUEUE): Task<T> | null {
+    const queue = this.getQueue(queueName);
+    if (!queue) return null;
+    return queue.next();
+  }
+
+  // Phase 1: Pending count
+  pendingCount(queueName: string = DEFAULT_QUEUE): number {
+    return this.getQueue(queueName)?.pendingCount() ?? 0;
+  }
+
+  size(queueName: string = DEFAULT_QUEUE): number {
+    return this.getQueue(queueName)?.size() ?? 0;
+  }
+
+  // Phase 2: List queues
+  listQueues(): string[] {
+    return Array.from(this.queues.keys());
+  }
+
+  // Phase 5: Complete a task
+  complete(taskId: string, queueName: string = DEFAULT_QUEUE): void {
+    const queue = this.getQueue(queueName);
+    if (!queue) throw new Error(`Queue ${queueName} not found`);
+    queue.complete(taskId);
+  }
+
+  // Phase 5: Fail a task
+  fail(taskId: string, error?: Error, queueName: string = DEFAULT_QUEUE): void {
+    const queue = this.getQueue(queueName);
+    if (!queue) throw new Error(`Queue ${queueName} not found`);
+    queue.fail(taskId, error);
+  }
+
+  // Phase 6: Dead letter queue
+  getDeadLetterQueue(queueName: string = DEFAULT_QUEUE): Task<T>[] {
+    return this.getQueue(queueName)?.getDeadLetterQueue() ?? [];
+  }
+
+  requeueFromDLQ(taskId: string, queueName: string = DEFAULT_QUEUE): Task<T> {
+    const queue = this.getQueue(queueName);
+    if (!queue) throw new Error(`Queue ${queueName} not found`);
+    return queue.requeueFromDLQ(taskId);
+  }
+
+  clearDeadLetterQueue(queueName: string = DEFAULT_QUEUE): void {
+    this.getQueue(queueName)?.clearDeadLetterQueue();
+  }
+
+  // Phase 7: Get task (for dependency inspection)
+  getTask(taskId: string, queueName: string = DEFAULT_QUEUE): Task<T> | undefined {
+    return this.getQueue(queueName)?.getTask(taskId);
+  }
+
+  // Phase 8: Concurrency
+  setConcurrency(limit: number | null, queueName: string = DEFAULT_QUEUE): void {
+    this.getOrCreateQueue(queueName).setConcurrency(limit);
+  }
+
+  getConcurrency(queueName: string = DEFAULT_QUEUE): number | null {
+    return this.getQueue(queueName)?.getConcurrency() ?? null;
+  }
+
+  getActiveCount(queueName: string = DEFAULT_QUEUE): number {
+    return this.getQueue(queueName)?.getActiveCount() ?? 0;
+  }
+
+  // Phase 9: Progress
+  setProgress(taskId: string, progress: number, message?: string, queueName: string = DEFAULT_QUEUE): void {
+    const queue = this.getQueue(queueName);
+    if (!queue) throw new Error(`Queue ${queueName} not found`);
+    queue.setProgress(taskId, progress, message);
+  }
+
+  onProgress(
+    taskId: string,
+    listener: (progress: number, message?: string) => void,
+    queueName: string = DEFAULT_QUEUE
+  ): () => void {
+    const queue = this.getOrCreateQueue(queueName);
+    return queue.onProgress(taskId, listener);
+  }
+
+  // Phase 9: Cancel
+  cancel(taskId: string, queueName: string = DEFAULT_QUEUE): boolean {
+    const queue = this.getQueue(queueName);
+    if (!queue) return false;
+    return queue.cancel(taskId);
+  }
+
+  // Phase 10: Scheduling
+  createSchedule(cronExpression: string, queueName: string, payload: unknown): Schedule {
+    return this.scheduler.create(cronExpression, queueName, payload);
+  }
+
+  removeSchedule(scheduleId: string): boolean {
+    return this.scheduler.remove(scheduleId);
+  }
+
+  listSchedules(): Schedule[] {
+    return this.scheduler.list();
+  }
+
+  tick(now?: Date): void {
+    const results = this.scheduler.tick(now);
+    for (const { schedule, shouldEnqueue } of results) {
+      if (shouldEnqueue && !this.shutdownPromise) {
+        this.getOrCreateQueue(schedule.queueName).addTask(schedule.payload as T, {
+          queueName: schedule.queueName,
+        });
+      }
+    }
+  }
+
+  // Phase 11: Middleware
+  use(middleware: Middleware<T>, queueName: string = DEFAULT_QUEUE): void {
+    this.getOrCreateQueue(queueName).use(middleware);
+  }
+
+  setHandler(handler: Handler<T>, queueName: string = DEFAULT_QUEUE): void {
+    this.getOrCreateQueue(queueName).setHandler(handler);
+  }
+
+  async processNext(queueName: string = DEFAULT_QUEUE): Promise<boolean> {
+    const queue = this.getQueue(queueName);
+    if (!queue) return false;
+
+    const task = queue.next();
+    if (!task) return false;
+
+    try {
+      await queue.processWithMiddleware(task);
+      if (task.status === 'processing') {
+        queue.complete(task.id);
+      }
+    } catch (err) {
+      if (task.status === 'processing') {
+        queue.fail(task.id, err instanceof Error ? err : new Error(String(err)));
+      }
+    }
+    return true;
+  }
+
+  // Phase 12: Graceful shutdown
+  onShutdown(callback: () => void | Promise<void>): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  async shutdown(timeoutMs = 5000): Promise<ShutdownResult> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+
+    const startTime = Date.now();
+
+    this.shutdownPromise = (async (): Promise<ShutdownResult> => {
+      // Run shutdown callbacks
+      for (const cb of this.shutdownCallbacks) {
+        await cb();
+      }
+
+      // Collect all processing tasks
+      const processingTasks: Array<{ task: Task<T>; queue: Queue<T> }> = [];
+      for (const queue of this.queues.values()) {
+        for (const task of queue.getProcessingTasks()) {
+          processingTasks.push({ task, queue });
+        }
+      }
+
+      if (processingTasks.length === 0) {
+        return { completed: 0, forceCancelled: 0, durationMs: Date.now() - startTime };
+      }
+
+      // Wait for processing tasks with timeout
+      let completed = 0;
+      let forceCancelled = 0;
+
+      await Promise.race([
+        new Promise<void>(resolve => setTimeout(resolve, timeoutMs)),
+        (async () => {
+          const check = (): boolean =>
+            processingTasks.every(({ task }) => task.status !== 'processing');
+          while (!check()) {
+            await new Promise(r => setTimeout(r, 10));
+          }
+        })(),
+      ]);
+
+      for (const { task, queue } of processingTasks) {
+        if (task.status === 'completed' || task.status === 'failed') {
+          completed++;
+        } else if (task.status === 'processing') {
+          queue.cancel(task.id);
+          forceCancelled++;
+        } else {
+          completed++;
+        }
+      }
+
+      return { completed, forceCancelled, durationMs: Date.now() - startTime };
+    })();
+
+    return this.shutdownPromise;
+  }
+
+  isShuttingDown(): boolean {
+    return this.shutdownPromise !== null;
+  }
+}
