+++ b/src/types.ts
@@ -0,0 +1,51 @@
+export type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled' | 'blocked';
+
+export interface Task<T = unknown> {
+  id: string;
+  payload: T;
+  status: TaskStatus;
+  priority: number;
+  createdAt: Date;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  retryDelay: number;
+  queueName: string;
+  dependencies: string[];
+  progress: number;
+  progressMessage?: string;
+  error?: Error;
+  failedAt?: Date;
+  completedAt?: Date;
+}
+
+export interface AddTaskOptions {
+  priority?: number;
+  delay?: number;
+  availableAt?: Date;
+  maxRetries?: number;
+  retryDelay?: number;
+  dependencies?: string[];
+  queueName?: string;
+}
+
+export interface QueueOptions {
+  concurrency?: number;
+}
+
+export type Middleware<T = unknown> = (task: Task<T>, next: () => Promise<void>) => Promise<void>;
+export type Handler<T = unknown> = (task: Task<T>) => Promise<void>;
+
+export interface Schedule {
+  id: string;
+  cronExpression: string;
+  queueName: string;
+  payload: unknown;
+  lastRun?: Date;
+}
+
+export interface ShutdownResult {
+  completed: number;
+  forceCancelled: number;
+  durationMs: number;
+}
