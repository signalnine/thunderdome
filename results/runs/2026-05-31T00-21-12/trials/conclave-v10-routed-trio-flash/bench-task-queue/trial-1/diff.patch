+  it('failing exhausted retries moves to failed state (then DLQ)', () => {
+    const t = q.add('x', { maxRetries: 1, retryDelay: 1 });
+    q.next(); // attempts = 1
+    q.fail(t.id); // 1 <= 1 so retry with backoff
+    // Force availableAt to past so we can pick it up again
+    t.availableAt = new Date(Date.now() - 1);
+    q.next(); // attempts = 2
+    q.fail(t.id); // 2 > 1, exhausted -> DLQ
