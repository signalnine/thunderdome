 task.status = 'cancelled';\n    task.maxRetries = 0; // Prevent retries\n    return true;\n  }\n\n  private unblockDependents(completedTaskId: string): void {\n    for (const task of this.tasks.values()) {\n      if (task.status === 'blocked' && task.dependencies.includes(completedTaskId)) {\n        const allResolved = task.dependencies.every(depId => {\n          const dep = this.tasks.get(depId);\n          return dep?.status === 'completed';\n        });\n        if (allResolved) {\n          task.status = 'pending';\n        }\n      }\n    }\n  }\n\n  getTask(taskId: string): Task<T> | undefined {\n    return this.tasks.get(taskId) ?? this.deadLetterQueue.find(t => t.id === taskId);\n  }\n\n  pendingCount(): number {\n    const now = Date.now();\n    return Array.from(this.tasks.values()).filter(\n      t => t.status === 'pending' && t.availableAt.getTime() <= now\n    ).length;\n  }\n\n  size(): number {\n    return Array.from(this.tasks.values()).filter(t => t.status === 'pending').length;\n  }\n\n  getDeadLetterQueue(): Task<T>[] {\n    return [...this.deadLetterQueue];\n  }\n\n  requeueFromDLQ(taskId: string): Task<T> {\n    const idx = this.deadLetterQueue.findIndex(t => t.id === taskId);\n    if (idx === -1) throw new Error(`Task ${taskId} not found in dead letter queue`);\n\n    const task = this.deadLetterQueue.splice(idx, 1)[0];\n    task.status = 'pending';\n    task.attempts = 0;\n    task.availableAt = new Date();\n    task.error = undefined;\n    task.failedAt = undefined;\n    this.tasks.set(task.id, task);\n    return task;\n  }\n\n  clearDeadLetterQueue(): void {\n    this.deadLetterQueue = [];\n  }\n\n  setProgress(taskId: string, progress: number, message?: string): void {\n    if (progress < 0 || progress > 100) throw new Error('Progress must be 0-100');\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task ${taskId} not found`);\n    if (task.status !== 'processing') throw new Error(`Task ${taskId} is not processing`);\n\n    task.progress = progress;\n    task.progressMessage = message;\n\n    const listeners = this.progressListeners.get(taskId);\n    if (listeners) {\n      for (const listener of listeners) {\n        listener(progress, message);\n      }\n    }\n  }\n\n  onProgress(taskId: string, listener: (progress: number, message?: string) => void): () => void {\n    if (!this.progressListeners.has(taskId)) {\n      this.progressListeners.set(taskId, new Set());\n    }\n    this.progressListeners.get(taskId)!.add(listener);\n    return () => {\n      this.progressListeners.get(taskId)?.delete(listener);\n    };\n  }\n\n  setConcurrency(limit: number | null): void {\n    this.concurrencyLimit = limit;\n  }\n\n  getConcurrency(): number | null {\n    return this.concurrencyLimit;\n  }\n\n  getActiveCount(): number {\n    return this.activeCount;\n  }\n\n  use(middleware: Middleware<T>): void {\n    this.middlewares.push(middleware);\n  }\n\n  setHandler(handler: Handler<T>): void {\n    this.handler = handler;\n  }\n\n  async processWithMiddleware(task: Task<T>): Promise<void> {\n    const stack = [...this.middlewares];\n    let index = 0;\n\n    const next = async (): Promise<void> => {\n      if (index < stack.length) {\n        const mw = stack[index++];\n        await mw(task, next);\n      } else if (this.handler) {\n        await this.handler(task);\n      }\n    };\n\n    await next();\n  }\n\n  getAllTasks(): Task<T>[] {\n    return Array.from(this.tasks.values());\n  }\n\n  getProcessingTasks(): Task<T>[] {\n    return Array.from(this.tasks.values()).filter(t => t.status === 'processing');\n  }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":4,"lines":["-import { Task, TaskStatus, AddTaskOptions, Middleware, Handler } from './types.js';","+import { Task, AddTaskOptions, Middleware, Handler } from './types.js';"," "," let idCounter = 0;"," function generateId(): string {"]}],"userModified":false,"replaceAll":false}}
