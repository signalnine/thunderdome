ce', password: 'secret' });\n    expect(res.status).toBe(201);\n    expect(res.body.username).toBe('alice');\n    expect(res.body.id).toBeTruthy();\n    expect(res.body.password).toBeUndefined();\n  });\n\n  it('rejects duplicate username', async () => {\n    const srv = app();\n    await register(srv, 'alice');\n    const res = await request(srv).post('/auth/register').send({ username: 'alice', password: 'x' });\n    expect(res.status).toBe(409);\n  });\n\n  it('rejects registration without password', async () => {\n    const srv = app();\n    const res = await request(srv).post('/auth/register').send({ username: 'alice' });\n    expect(res.status).toBe(400);\n  });\n\n  it('logs in with correct credentials', async () => {\n    const srv = app();\n    await register(srv, 'alice', 'mypass');\n    const res = await request(srv).post('/auth/login').send({ username: 'alice', password: 'mypass' });\n    expect(res.status).toBe(200);\n    expect(res.body.token).toBeTruthy();\n  });\n\n  it('rejects bad password', async () => {\n    const srv = app();\n    await register(srv, 'alice');\n    const res = await request(srv).post('/auth/login').send({ username: 'alice', password: 'wrong' });\n    expect(res.status).toBe(401);\n  });\n\n  it('rejects requests without token', async () => {\n    const srv = app();\n    const res = await request(srv).get('/folders/1');\n    expect(res.status).toBe(401);\n  });\n\n  it('rejects requests with invalid token', async () => {\n    const srv = app();\n    const res = await request(srv).get('/folders/1').set('Authorization', 'Bearer fake');\n    expect(res.status).toBe(401);\n  });\n});\n\n// ── folders ───────────────────────────────────────────────────────────────────\n\ndescribe('folders', () => {\n  it('creates a folder', async () => {\n    const srv = app();\n    const alice = await setup(srv);\n    const a = authed(srv, alice.token);\n    const res = await a.post('/folders').send({ name: 'Projects' });\n    expect(res.status).toBe(