tId()}_${Math.random().toString(36).slice(2)}`;\n  }\n\n  function getEffectiveRole(userId: string, type: ResourceType, resourceId: string): Role | null {\n    let best: Role | null = null;\n\n    for (const p of permissions.values()) {\n      if (p.userId === userId && p.resourceType === type && p.resourceId === resourceId) {\n        best = best ? higherRole(best, p.role) : p.role;\n      }\n    }\n\n    if (type === 'document') {\n      const doc = documents.get(resourceId);\n      if (doc) {\n        const inherited = getEffectiveRole(userId, 'folder', doc.folderId);\n        if (inherited) best = best ? higherRole(best, inherited) : inherited;\n      }\n    }\n\n    if (type === 'folder') {\n      const folder = folders.get(resourceId);\n      if (folder?.parentId) {\n        const inherited = getEffectiveRole(userId, 'folder', folder.parentId);\n        if (inherited) best = best ? higherRole(best, inherited) : inherited;\n      }\n    }\n\n    return best;\n  }\n\n  function grantOwner(userId: string, type: ResourceType, resourceId: string): void {\n    const perm: Permission = { id: nextId(), resourceType: type, resourceId, userId, role: 'owner' };\n    permissions.set(perm.id, perm);\n  }\n\n  function log(action: string, userId: string, type: ResourceType, resourceId: string): void {\n    activity.push({ id: nextId(), action, userId, resourceType: type, resourceId, timestamp: new Date().toISOString() });\n  }\n\n  function auth(req: Request, res: Response, next: NextFunction): void {\n    const header = req.headers.authorization;\n    if (!header?.startsWith('Bearer ')) { res.status(401).json({ error: 'Unauthorized' }); return; }\n    const token = header.slice(7);\n    const user = [...users.values()].find(u => u.token === token);\n    if (!user) { res.status(401).json({ error: 'Unauthorized' }); return; }\n    (req as AuthenticatedRequest).currentUser = user;\n    next();\n  }\n\n  function canAt(userId: string, type: ResourceType, id: string, minRole: Role): boolean {\n    const role = getEffectiveRole(userId, type, id);\n    return role !== null && ROLE_RANK[role] >= ROLE_RANK[minRole];\n  }\n\n  const app = express();\n  app.use(express.json());\n\n  // ── Auth ──────────────────────────────────────────────────────────────────\n\n  app.post('/auth/register', (req: Request, res: Response) => {\n    const { username, password } = req.body ?? {};\n    if (!username || !password) return void res.status(400).json({ error: 'username and password required' });\n    if ([...users.values()].some(u => u.username === username))\n      return void res.status(409).json({ error: 'Username already taken' });\n    const user: User = { id: nextId(), username, password, token: makeToken() };\n    users.set(user.id, user);\n    res.status(201).json({ id: user.id, username: user.username });\n  });\n\n  app.post('/auth/login', (req: Request, res: Response) => {\n    const { username, password } = req.body ?? {};\n    const user = [...users.values()].find(u => u.username === username && u.password === password);\n    if (!user) return void res.status(401).json({ error: 'Invalid credentials' });\n    res.json({ token: user.token, userId: user.id });\n  });\n\n  // ── Folders ───────────────────────────────────────────────────────────────\n\n  app.post('/folders', auth, (req: Request, res: Response) => {\n    const user = (req as AuthenticatedRequest).currentUser;\n    const { name, parentId } = req.body ?? {};\n    if (!name) return void res.status(400).json({ error: 'name required' });\n\n    if (parentId !== undefined && parentId !== null) {\n      if (!folders.has(parentId)) return void res.status(404).json({ error: 'Parent folder not found' });\n      if (!canAt(user.id, 'folder', parentId, 'editor'))\n        return void res.status(403).json({ error: 'Forbidden' });\n    }\n\n    const folder: Folder = {\n      id: nextId(), name, parentId: parentId ?? null,\n      ownerId: user.id, createdAt: new Date().toISOString(),\n    };\n