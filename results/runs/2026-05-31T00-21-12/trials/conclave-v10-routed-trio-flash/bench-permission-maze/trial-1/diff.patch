new file mode 100644
index 0000000..3f41c6a
--- /dev/null
+++ b/src/app.test.ts
@@ -0,0 +1,543 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import request from 'supertest';
+import { createApp } from './app.js';
+
+// ── helpers ──────────────────────────────────────────────────────────────────
+
+function app() { return createApp(); }
+
+async function register(srv: ReturnType<typeof app>, username: string, password = 'pass') {
+  const res = await request(srv).post('/auth/register').send({ username, password });
+  expect(res.status).toBe(201);
+  return res.body as { id: string; username: string };
+}
+
+async function login(srv: ReturnType<typeof app>, username: string, password = 'pass') {
+  const res = await request(srv).post('/auth/login').send({ username, password });
+  expect(res.status).toBe(200);
+  return res.body as { token: string; userId: string };
+}
+
+async function setup(srv: ReturnType<typeof app>, username = 'alice') {
+  const user = await register(srv, username);
+  const { token } = await login(srv, username);
+  return { ...user, token };
+}
+
+function authed(srv: ReturnType<typeof app>, token: string) {
+  return {
+    post: (path: string) => request(srv).post(path).set('Authorization', `Bearer ${token}`),
+    get: (path: string) => request(srv).get(path).set('Authorization', `Bearer ${token}`),
+    put: (path: string) => request(srv).put(path).set('Authorization', `Bearer ${token}`),
+    del: (path: string) => request(srv).delete(path).set('Authorization', `Bearer ${token}`),
+  };
+}
+
+// ── auth ─────────────────────────────────────────────────────────────────────
+
+describe('auth', () => {
+  it('registers a new user', async () => {
+    const srv = app();
+    const res = await request(srv).post('/auth/register').send({ username: 'alice', password: 'secret' });
+    expect(res.status).toBe(201);
+    expect(res.body.username).toBe('alice');
+    expect(res.body.id).toBeTruthy();
+    expect(res.body.password).toBeUndefined();
+  });
+
+  it('rejects duplicate username', async () => {
+    const srv = app();
+    await register(srv, 'alice');
+    const res = await request(srv).post('/auth/register').send({ username: 'alice', password: 'x' });
+    expect(res.status).toBe(409);
+  });
+
+  it('rejects registration without password', async () => {
+    const srv = app();
+    const res = await request(srv).post('/auth/register').send({ username: 'alice' });
+    expect(res.status).toBe(400);
+  });
+
+  it('logs in with correct credentials', async () => {
+    const srv = app();
+    await register(srv, 'alice', 'mypass');
+    const res = await request(srv).post('/auth/login').send({ username: 'alice', password: 'mypass' });
+    expect(res.status).toBe(200);
+    expect(res.body.token).toBeTruthy();
+  });
+
+  it('rejects bad password', async () => {
+    const srv = app();
+    await register(srv, 'alice');
+    const res = await request(srv).post('/auth/login').send({ username: 'alice', password: 'wrong' });
+    expect(res.status).toBe(401);
+  });
+
+  it('rejects requests without token', async () => {
+    const srv = app();
+    const res = await request(srv).get('/folders/1');
+    expect(res.status).toBe(401);
+  });
+
+  it('rejects requests with invalid token', async () => {
+    const srv = app();
+    const res = await request(srv).get('/folders/1').set('Authorization', 'Bearer fake');
+    expect(res.status).toBe(401);
+  });
+});
+
+// ── folders ───────────────────────────────────────────────────────────────────
+
+describe('folders', () => {
+  it('creates a folder', async () => {
+    const srv = app();
+    const alice = await setup(srv);
+    const a = authed(srv, alice.token);
+    const res = await a.post('/folders').send({ name: 'Projects' });
+    expect(res.status).toBe(201);
+    expect(res.body.name).toBe('Projects');
+    expect(res.body.id).toBeTruthy();
+    expect(res.body.parentId).toBeNull();
+  });
+
+  it('gets a folder', async () => {
+    const srv = app();
+    const alice = await setup(srv);
+    const a = authed(srv, alice.token);
+    const { body: folder } = await a.post('/folders').send({ name: 'F' });
+    const res = await a.get(`/folders/${folder.id}`);
+    expect(res.status).toBe(200);
+    expect(res.body.name).toBe('F');
+  });
+
