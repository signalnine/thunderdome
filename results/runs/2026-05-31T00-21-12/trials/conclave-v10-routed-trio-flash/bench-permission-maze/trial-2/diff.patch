Content');\n      const res = await request(app)\n        .get(`/documents/${doc.id}`)\n        .set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('MyDoc');\n      expect(res.body.role).toBe('owner');\n    });\n\n    it('returns 404 for missing document', async () => {\n      const res = await request(app).get('/documents/missing').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(404);\n    });\n\n    it('updates a document', async () => {\n      const { body: doc } = await createDocument(token, folderId, 'Old', 'OldContent');\n      const res = await request(app)\n        .put(`/documents/${doc.id}`)\n        .set('Authorization', `Bearer ${token}`)\n        .send({ title: 'New', content: 'NewContent' });\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('New');\n      expect(res.body.content).toBe('NewContent');\n    });\n\n    it('deletes a document', async () => {\n      const { body: doc } = await createDocument(token, folderId, 'Del', '');\n      const del = await request(app)\n        .delete(`/documents/${doc.id}`)\n        .set('Authorization', `Bearer ${token}`);\n      expect(del.status).toBe(204);\n\n      const get = await request(app)\n        .get(`/documents/${doc.id}`)\n        .set('Authorization', `Bearer ${token}`);\n      expect(get.status).toBe(404);\n    });\n  });\n\n  describe('Permissions', () => {\n    let alice: { userId: string; token: string };\n    let bob: { userId: string; token: string };\n    let charlie: { userId: string; token: string };\n    let folderId: string;\n    let docId: string;\n\n    beforeEach(async () => {\n      alice = await registerUser('alice', 'pass');\n      bob = await registerUser('bob', 'pass');\n      charlie = await registerUser('charlie', 'pass');\n      const { body: folder } = await createFolder(alice.token, 'AliceFolder');\n      folderId = folder.id;\n      const { body: doc } = await createDocument(alice.token, folderId, 'AliceDoc', 'Secret');\n      docId = doc.id;\n    });\n\n    it('owner has owner role on their resources', async () => {\n      const res = await request(app)\n        .get(`/documents/${docId}`)\n        .set('Authorization', `Bearer ${alice.token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.role).toBe('owner');\n    });\n\n    it('unshared user cannot access document', async () => {\n      const res = await request(app)\n        .get(`/documents/${docId}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(res.status).toBe(403);\n    });\n\n    it('unshared user cannot access folder', async () => {\n      const res = await request(app)\n        .get(`/folders/${folderId}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(res.status).toBe(403);\n    });\n\n    it('viewer can read document', async () => {\n      await shareDocument(alice.token, docId, bob.userId, 'viewer');\n      const res = await request(app)\n        .get(`/documents/${docId}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.role).toBe('viewer');\n    });\n\n    it('viewer cannot update document', async () => {\n      await shareDocument(alice.token, docId, bob.userId, 'viewer');\n      const res = await request(app)\n        .put(`/documents/${docId}`)\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({ content: 'hacked' });\n      expect(res.status).toBe(403);\n    });\n\n    it('viewer cannot delete document', async () => {\n      await shareDocument(alice.token, docId, bob.userId, 'viewer');\n      const res = await request(app)\n        .delete(`/documents/${docId}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(res.status).toBe(403);\n    });\n\n    it('viewer cannot share document', async () => {\n      await shareDocument(alice.token, docId, bob.userId, 'viewer');\n      const res = await shareDocument(bob.token, docId, charlie.userId, 'viewer');\n      expect(res.status).toBe(403);\n    });\n\n    it('editor can read document', async () => {\n      await shareDocument(alice.token, docId, bob.userId, 'editor');\n      const res = await request(app)\n        .get(`/documents/${docId}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.role).toBe('editor');\n    });\n\n    it('editor can update document', async () => {\n      await shareDocument(alice.token, docId, bob.userId, 'editor');\n      const res = await request(app)\n        .put(`/documents/${docId}`)\n        .set('Authorization', `Bearer ${bob.token}`)\n        .send({ content: 'updated' });\n      expect(res.status).toBe(200);\n    });\n\n    it('editor cannot delete document', async () => {\n      await shareDocument(alice.token, docId, bob.userId, 'editor');\n      const res = await request(app)\n        .delete(`/documents/${docId}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(res.status).toBe(403);\n    });\n\n    it('editor can share document with others', async () => {\n      await shareDocument(alice.token, docId, bob.userId, 'editor');\n      const res = await shareDocument(bob.token, docId, charlie.userId, 'viewer');\n      expect(res.status).toBe(200);\n\n      const charlieRes = await request(app)\n        .get(`/documents/${docId}`)\n        .set('Authorization', `Bearer ${charlie.token}`);\n      expect(charlieRes.status).toBe(200);\n    });\n\n    it('owner can delete document', async () => {\n      const res = await request(app)\n        .delete(`/documents/${docId}`)\n        .set('Authorization', `Bearer ${alice.token}`);\n      expect(res.status).toBe(204);\n    });\n\n    it('folder share propagates to contained documents', async () => {\n      await shareFolder(alice.token, folderId, bob.userId, 'viewer');\n      const res = await request(app)\n        .get(`/documents/${docId}`)\n        