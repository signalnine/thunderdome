ments in the folder', async () => {\n      await shareFolder(alice.token, folderId, bob.userId, 'viewer');\n      const res = await createDocument(bob.token, folderId, 'BobDoc', 'Hi');\n      expect(res.status).toBe(403);\n    });\n\n    it('sharing rejects invalid role', async () => {\n      const res = await shareDocument(alice.token, docId, bob.userId, 'superadmin');\n      expect(res.status).toBe(400);\n    });\n\n    it('sharing rejects nonexistent user', async () => {\n      const res = await request(app)\n        .post(`/documents/${docId}/share`)\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ userId: 'nonexistent', role: 'viewer' });\n      expect(res.status).toBe(404);\n    });\n\n    it('sharing updates existing permission', async () => {\n      await shareDocument(alice.token, docId, bob.userId, 'viewer');\n      await shareDocument(alice.token, docId, bob.userId, 'editor');\n\n      const res = await request(app)\n        .get(`/documents/${docId}`)\n        .set('Authorization', `Bearer ${bob.token}`);\n      expect(res.body.role).toBe('editor');\n    });\n  });\n\n  describe('Activity Log', () => {\n    let alice: { userId: string; token: string };\n    let folderId: string;\n\n    beforeEach(async () => {\n      alice = await registerUser('alice', 'pass');\n      const { body: folder } = await createFolder(alice.token, 'Folder');\n      folderId = folder.id;\n    });\n\n    it('requires auth', async () => {\n      const res = await request(app).get('/activity');\n      expect(res.status).toBe(401);\n    });\n\n    it('returns activity log as array', async () => {\n      const res = await request(app)\n        .get('/activity')\n        .set('Authorization', `Bearer ${alice.token}`);\n      expect(res.status).toBe(200);\n      expect(Array.isArray(res.body)).toBe(true);\n    });\n\n    it('tracks document creation', async () => {\n      await createDocument(alice.token, folderId, 'Doc', '');\n      const res = await request(app).get('/activity').set('Authorization', `Bearer ${alice.token}`);\n      const actions = res.body.map((e: { action: string }) => e.action);\n      expect(actions).toContain('document.created');\n    });\n\n    it('tracks document update', async () => {\n      const { body: doc } = await createDocument(alice.token, folderId, 'Doc', '');\n      await request(app)\n        .put(`/documents/${doc.id}`)\n        .set('Authorization', `Bearer ${alice.token}`)\n        .send({ content: 'updated' });\n      const res = await request(app).get('/activity').set('Authorization', `Bearer ${alice.token}`);\n      const actions = res.body.map((e: { action: string }) => e.action);\n      expect(actions).toContain('document.updated');\n    });\n\n    it('tracks document deletion', async () => {\n      const { body: doc } = await createDocument(alice.token, folderId, 'Doc', '');\n      await request(app)\n        .delete(`/documents/${doc.id}`)\n        .set('Authorization', `Bearer ${alice.token}`);\n      const res = await request(app).get('/activity').set('Authorization', `Bearer ${alice.token}`);\n      const actions = res.body.map((e: { action: string }) => e.action);\n      expect(actions).toContain('document.deleted');\n    });\n\n    it('tracks share events', async () => {\n      const bob = await registerUser('bob', 'pass');\n      const { body: doc } = await createDocument(alice.token, folderId, 'Doc', '');\n      await shareDocument(alice.token, doc.id, bob.userId, 'viewer');\n      const res = await request(app).get('/activity').set('Authorization', `Bearer ${alice.token}`);\n      const actions = res.body.map((e: { action: string }) => e.action);\n      expect(actions).toContain('share.granted');\n    });\n\n    it('activity entries have required fields', async () => {\n      await createDocument(alice.token, folderId, 'Doc', '');\n      const res = await request(app).get('/activity').set('Authorization', `Bearer ${alice.token}`);\n      const entry = res.body.find((e: 