n      .send({ userId, role });\n  }\n\n  describe('Auth', () => {\n    it('registers a new user and returns token', async () => {\n      const res = await request(app).post('/auth/register').send({ username: 'alice', password: 'pass' });\n      expect(res.status).toBe(201);\n      expect(res.body.userId).toBeDefined();\n      expect(res.body.token).toBeDefined();\n    });\n\n    it('rejects registration with missing fields', async () => {\n      const res = await request(app).post('/auth/register').send({ username: 'alice' });\n      expect(res.status).toBe(400);\n    });\n\n    it('rejects duplicate username registration', async () => {\n      await registerUser('alice', 'pass');\n      const res = await request(app).post('/auth/register').send({ username: 'alice', password: 'other' });\n      expect(res.status).toBe(409);\n    });\n\n    it('logs in and returns a new token', async () => {\n      await registerUser('alice', 'pass');\n      const res = await request(app).post('/auth/login').send({ username: 'alice', password: 'pass' });\n      expect(res.status).toBe(200);\n      expect(res.body.token).toBeDefined();\n    });\n\n    it('rejects wrong password', async () => {\n      await registerUser('alice', 'pass');\n      const res = await request(app).post('/auth/login').send({ username: 'alice', password: 'wrong' });\n      expect(res.status).toBe(401);\n    });\n\n    it('rejects login for unknown user', async () => {\n      const res = await request(app).post('/auth/login').send({ username: 'nobody', password: 'pass' });\n      expect(res.status).toBe(401);\n    });\n\n    it('rejects requests without authorization header', async () => {\n      const res = await request(app).get('/folders/any');\n      expect(res.status).toBe(401);\n    });\n\n    it('rejects invalid token', async () => {\n      const res = await request(app).get('/folders/any').set('Authorization', 'Bearer badtoken');\n      expect(res.status).toBe(401);\n    });\n  });\n\n  describe('Folders', () => {\n    let token: string;\n    let userId: string;\n\n    beforeEach(async () => {\n      const user = await registerUser('alice', 'pass');\n      token = user.token;\n      userId = user.userId;\n    });\n\n    it('creates a root folder', async () => {\n      const res = await createFolder(token, 'Root');\n      expect(res.status).toBe(201);\n      expect(res.body.name).toBe('Root');\n      expect(res.body.id).toBeDefined();\n      expect(res.body.ownerId).toBe(userId);\n      expect(res.body.parentId).toBeNull();\n    });\n\n    it('creates a nested folder', async () => {\n      const { body: parent } = await createFolder(token, 'Parent');\n      const res = await createFolder(token, 'Child', parent.id);\n      expect(res.status).toBe(201);\n      expect(res.body.parentId).toBe(parent.id);\n    });\n\n    it('rejects folder creation without name', async () => {\n      const res = await request(app)\n        .post('/folders')\n        .set('Authorization', `Bearer ${token}`)\n        .send({});\n      expect(res.status).toBe(400);\n    });\n\n    it('rejects nested folder with invalid parent', async () => {\n      const res = await createFolder(token, 'Child', 'nonexistent');\n      expect(res.status).toBe(404);\n    });\n\n    it('gets a folder', async () => {\n      const { body: folder } = await createFolder(token, 'MyFolder');\n      const res = await request(app)\n        .get(`/folders/${folder.id}`)\n        .set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.name).toBe('MyFolder');\n      expect(res.body.role).toBe('owner');\n    });\n\n    it('returns 404 for missing folder', async () => {\n      const res = await request(app).get('/folders/missing').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(404);\n    });\n\n    it('updates a folder name', async () => {\n      const { body: folder } = await createFolder(token, 'Old');\n      const res = await request(app)\n        .