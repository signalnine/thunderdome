   return;\n    }\n    const role = getEffectiveRole(store, req.userId!, 'folder', folderId);\n    if (!canWrite(role)) {\n      res.status(403).json({ error: 'Access denied' });\n      return;\n    }\n    const { title, content } = req.body as { title?: string; content?: string };\n    if (!title) {\n      res.status(400).json({ error: 'Title required' });\n      return;\n    }\n    const id = randomUUID();\n    const doc = {\n      id,\n      title,\n      content: content ?? '',\n      folderId,\n      ownerId: req.userId!,\n      createdAt: new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n    };\n    store.documents.set(id, doc);\n    logActivity(store, 'document.created', req.userId!, 'document', id);\n    res.status(201).json(doc);\n  });\n\n  router.post('/:id/share', auth, (req, res) => {\n    const folder = store.folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n    const role = getEffectiveRole(store, req.userId!, 'folder', req.params.id);\n    if (!canShare(role)) {\n      res.status(403).json({ error: 'Access denied' });\n      return;\n    }\n    const { userId, role: grantedRole } = req.body as { userId?: string; role?: string };\n    if (!userId || !grantedRole) {\n      res.status(400).json({ error: 'userId and role required' });\n      return;\n    }\n    if (!['viewer', 'editor', 'owner'].includes(grantedRole)) {\n      res.status(400).json({ error: 'Invalid role' });\n      return;\n    }\n    if (!store.users.has(userId)) {\n      res.status(404).json({ error: 'User not found' });\n      return;\n    }\n    const existing = store.permissions.findIndex(\n      p => p.resourceType === 'folder' && p.resourceId === req.params.id && p.userId === userId\n    );\n    if (existing >= 0) {\n      store.permissions[existing].role = grantedRole as 'viewer' | 'editor' | 'owner';\n    } else {\n      store.permissions.push({\n        resourceType: 'folder',\