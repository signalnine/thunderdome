+import { Router } from 'express';
+import { randomUUID } from 'crypto';
+import { AppStore } from '../types.js';
+import { createAuthMiddleware } from '../middleware/auth.js';
+import { getEffectiveRole, canRead, canWrite, canDelete, canShare, logActivity } from '../store.js';
+
+export function createFoldersRouter(store: AppStore): Router {
+  const router = Router();
+  const auth = createAuthMiddleware(store);
+
+  router.post('/', auth, (req, res) => {
+    const { name, parentId } = req.body as { name?: string; parentId?: string };
+    if (!name) {
+      res.status(400).json({ error: 'Name required' });
+      return;
+    }
+    if (parentId) {
+      if (!store.folders.has(parentId)) {
+        res.status(404).json({ error: 'Parent folder not found' });
+        return;
+      }
+      const role = getEffectiveRole(store, req.userId!, 'folder', parentId);
+      if (!canWrite(role)) {
+        res.status(403).json({ error: 'Access denied' });
+        return;
+      }
+    }
+    const id = randomUUID();
+    const folder = {
+      id,
+      name,
+      parentId: parentId ?? null,
+      ownerId: req.userId!,
+      createdAt: new Date().toISOString(),
+    };
+    store.folders.set(id, folder);
+    logActivity(store, 'folder.created', req.userId!, 'folder', id);
+    res.status(201).json(folder);
+  });
+
+  router.get('/:id', auth, (req, res) => {
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+    const role = getEffectiveRole(store, req.userId!, 'folder', req.params.id);
+    if (!canRead(role)) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+    res.json({ ...folder, role });
+  });
+
+  router.put('/:id', auth, (req, res) => {
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+    const role = getEffectiveRole(store, req.userId!, 'folder', req.params.id);
+    if (!canWrite(role)) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+    const { name, parentId } = req.body as { name?: string; parentId?: string | null };
+    if (name !== undefined) folder.name = name;
+    if (parentId !== undefined) {
+      if (parentId !== null && !store.folders.has(parentId)) {
+        res.status(404).json({ error: 'Parent folder not found' });
+        return;
+      }
+      folder.parentId = parentId;
+    }
+    store.folders.set(req.params.id, folder);
+    logActivity(store, 'folder.updated', req.userId!, 'folder', req.params.id);
+    res.json(folder);
+  });
+
+  router.delete('/:id', auth, (req, res) => {
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+    const role = getEffectiveRole(store, req.userId!, 'folder', req.params.id);
+    if (!canDelete(role)) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+    store.folders.delete(req.params.id);
+    logActivity(store, 'folder.deleted', req.userId!, 'folder', req.params.id);
+    res.status(204).send();
+  });
+
+  router.post('/:folderId/documents', auth, (req, res) => {
+    const { folderId } = req.params;
+    const folder = store.folders.get(folderId);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+    const role = getEffectiveRole(store, req.userId!, 'folder', folderId);
+    if (!canWrite(role)) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+    const { title, content } = req.body as { title?: string; content?: string };
+    if (!title) {
+      res.status(400).json({ error: 'Title required' });
+      return;
+    }
+    const id = randomUUID();
+    const doc = {
+      id,
+      title,
+      content: content ?? '',
+      folderId,
+      ownerId: req.userId!,
+      createdAt: new Date().toISOString(),
+      updatedAt: new Date().toISOString(),
+    };
+    store.documents.set(id, doc);
+    logActivity(store, 'document.created', req.userId!, 'document', id);
+    res.status(201).json(doc);
+  });
+
+  router.post('/:id/share', auth, (req, res) => {
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+    const role = getEffectiveRole(store, req.userId!, 'folder', req.params.id);
+    if (!canShare(role)) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+    const { userId, role: grantedRole } = req.body as { userId?: string; role?: string };
+    if (!userId || !grantedRole) {
+      res.status(400).json({ error: 'userId and role required' });
+      return;
+    }
+    if (!['viewer', 'editor', 'owner'].includes(grantedRole)) {
+      res.status(400).json({ error: 'Invalid role' });
+      return;
+    }
+    if (!store.users.has(userId)) {
+      res.status(404).json({ error: 'User not found' });
+      return;
+    }
+    const existing = store.permissions.findIndex(
+      p => p.resourceType === 'folder' && p.resourceId === req.params.id && p.userId === userId
+    );
+    if (existing >= 0) {
+      store.permissions[existing].role = grantedRole as 'viewer' | 'editor' | 'owner';
+    } else {
+      store.permissions.push({
+        resourceType: 'folder',
+        resourceId: req.params.id,
+        userId,
+        role: grantedRole as 'viewer' | 'editor' | 'owner',
+      });
+    }
+    logActivity(store, 'share.granted', req.userId!, 'folder', req.params.id);
+    res.status(200).json({ message: 'Share granted' });
+  });
+
+  return router;
+}
diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..08a706a
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,111 @@
+import { randomUUID } from 'crypto';
+import { AppStore, ActivityEntry } from './types.js';
+
+export function createStore(): AppStore {
+  return {
+    users: new Map(),
+    usersByName: new Map(),
+    tokens: new Map(),
+    folders: new Map(),
+    documents: new Map(),
+    permissions: [],
+    activity: [],
+  };
+}
+
+function roleScore(role: string): number {
+  const scores: Record<string, number> = { viewer: 1, editor: 2, owner: 3 };
+  return scores[role] ?? 0;
+}
+
+function mostPermissiveRole(roles: string[]): string | null {
+  if (roles.length === 0) return null;
+  return roles.reduce((best, r) => (roleScore(r) > roleScore(best) ? r : best));
+}
+
+export function getEffectiveRole(
+  store: AppStore,
+  userId: string,
+  resourceType: 'folder' | 'document',
+  resourceId: string
+): string | null {
+  const roles: string[] = [];
+
+  if (resourceType === 'document') {
+    const doc = store.documents.get(resourceId);
+    if (!doc) return null;
+
+    if (doc.ownerId === userId) roles.push('owner');
+
+    store.permissions
+      .filter(p => p.resourceType === 'document' && p.resourceId === resourceId && p.userId === userId)
+      .forEach(p => roles.push(p.role));
+
+    let folderId: string | null = doc.folderId;
+    while (folderId) {
+      const folder = store.folders.get(folderId);
+      if (!folder) break;
+      if (folder.ownerId === userId) roles.push('owner');
+      store.permissions
+        .filter(p => p.resourceType === 'folder' && p.resourceId === folderId && p.userId === userId)
+        .forEach(p => roles.push(p.role));
+      folderId = folder.parentId;
+    }
+  } else {
+    const folder = store.folders.get(resourceId);
+    if (!folder) return null;
+
+    if (folder.ownerId === userId) roles.push('owner');
+
+    store.permissions
+      .filter(p => p.resourceType === 'folder' && p.resourceId === resourceId && p.userId === userId)
+      .forEach(p => roles.push(p.role));
+
+    let parentId = folder.parentId;
+    while (parentId) {
+      const parent = store.folders.get(parentId);
+      if (!parent) break;
+      if (parent.ownerId === userId) roles.push('owner');
+      store.permissions
+        .filter(p => p.resourceType === 'folder' && p.resourceId === parentId && p.userId === userId)
+        .forEach(p => roles.push(p.role));
+      parentId = parent.parentId;
+    }
+  }
+
+  return mostPermissiveRole(roles);
+}
+
+export function canRead(role: string | null): boolean {
+  return role !== null;
+}
+
+export function canWrite(role: string | null): boolean {
+  return role === 'editor' || role === 'owner';
+}
+
+export function canDelete(role: string | null): boolean {
+  return role === 'owner';
+}
+
+export function canShare(role: string | null): boolean {
+  return role === 'editor' || role === 'owner';
+}
+
+export function logActivity(
+  store: AppStore,
+  action: string,
+  userId: string,
+  resourceType: string,
+  resourceId: string
+): void {
+  const entry: ActivityEntry = {
+    id: randomUUID(),
+    action,
+    userId,
+    resourceType,
+    resourceId,
+    timestamp: new Date().toISOString(),
+  };
+  store.activity.push(entry);
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..1332bdf
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,52 @@
+export type Role = 'viewer' | 'editor' | 'owner';
+export type ResourceType = 'folder' | 'document';
+
+export interface User {
+  id: string;
+  username: string;
+  password: string;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: string;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface Permission {
+  resourceType: ResourceType;
+  resourceId: string;
+  userId: string;
+  role: Role;
+}
+
+export interface ActivityEntry {
+  id: string;
+  action: string;
+  userId: string;
+  resourceType: string;
+  resourceId: string;
+  timestamp: string;
+}
+
+export interface AppStore {
+  users: Map<string, User>;
+  usersByName: Map<string, User>;
+  tokens: Map<string, string>;
+  folders: Map<string, Folder>;
+  documents: Map<string, Document>;
+  permissions: Permission[];
+  activity: ActivityEntry[];
+}
