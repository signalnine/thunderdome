diff --git a/src/routes/auth.ts b/src/routes/auth.ts
new file mode 100644
index 0000000..0489413
--- /dev/null
+++ b/src/routes/auth.ts
@@ -0,0 +1,44 @@
+import { Router } from 'express';
+import { randomUUID } from 'crypto';
+import { AppStore } from '../types.js';
+
+export function createAuthRouter(store: AppStore): Router {
+  const router = Router();
+
+  router.post('/register', (req, res) => {
+    const { username, password } = req.body as { username?: string; password?: string };
+    if (!username || !password) {
+      res.status(400).json({ error: 'Username and password required' });
+      return;
+    }
+    if (store.usersByName.has(username)) {
+      res.status(409).json({ error: 'Username already exists' });
+      return;
+    }
+    const id = randomUUID();
+    const user = { id, username, password };
+    store.users.set(id, user);
+    store.usersByName.set(username, user);
+    const token = randomUUID();
+    store.tokens.set(token, id);
+    res.status(201).json({ userId: id, token });
+  });
+
+  router.post('/login', (req, res) => {
+    const { username, password } = req.body as { username?: string; password?: string };
+    if (!username || !password) {
+      res.status(400).json({ error: 'Username and password required' });
+      return;
+    }
+    const user = store.usersByName.get(username);
+    if (!user || user.password !== password) {
+      res.status(401).json({ error: 'Invalid credentials' });
+      return;
+    }
+    const token = randomUUID();
+    store.tokens.set(token, user.id);
+    res.status(200).json({ userId: user.id, token });
+  });
+
+  return router;
+}
diff --git a/src/routes/documents.ts b/src/routes/documents.ts
new file mode 100644
index 0000000..a2d729c
--- /dev/null
+++ b/src/routes/documents.ts
@@ -0,0 +1,102 @@
+import { Router } from 'express';
+import { AppStore } from '../types.js';
+import { createAuthMiddleware } from '../middleware/auth.js';
+import { getEffectiveRole, canRead, canWrite, canDelete, canShare, logActivity } from '../store.js';
+
+export function createDocumentsRouter(store: AppStore): Router {
+  const router = Router();
+  const auth = createAuthMiddleware(store);
+
+  router.get('/:id', auth, (req, res) => {
+    const doc = store.documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const role = getEffectiveRole(store, req.userId!, 'document', req.params.id);
+    if (!canRead(role)) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+    res.json({ ...doc, role });
+  });
+
+  router.put('/:id', auth, (req, res) => {
+    const doc = store.documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const role = getEffectiveRole(store, req.userId!, 'document', req.params.id);
+    if (!canWrite(role)) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+    const { title, content } = req.body as { title?: string; content?: string };
+    if (title !== undefined) doc.title = title;
+    if (content !== undefined) doc.content = content;
+    doc.updatedAt = new Date().toISOString();
+    store.documents.set(req.params.id, doc);
+    logActivity(store, 'document.updated', req.userId!, 'document', req.params.id);
+    res.json(doc);
+  });
+
+  router.delete('/:id', auth, (req, res) => {
+    const doc = store.documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const role = getEffectiveRole(store, req.userId!, 'document', req.params.id);
+    if (!canDelete(role)) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+    store.documents.delete(req.params.id);
+    logActivity(store, 'document.deleted', req.userId!, 'document', req.params.id);
+    res.status(204).send();
+  });
+
+  router.post('/:id/share', auth, (req, res) => {
+    const doc = store.documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const role = getEffectiveRole(store, req.userId!, 'document', req.params.id);
+    if (!canShare(role)) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+    const { userId, role: grantedRole } = req.body as { userId?: string; role?: string };
+    if (!userId || !grantedRole) {
+      res.status(400).json({ error: 'userId and role required' });
+      return;
+    }
+    if (!['viewer', 'editor', 'owner'].includes(grantedRole)) {
+      res.status(400).json({ error: 'Invalid role' });
+      return;
+    }
+    if (!store.users.has(userId)) {
+      res.status(404).json({ error: 'User not found' });
+      return;
+    }
+    const existing = store.permissions.findIndex(
+      p => p.resourceType === 'document' && p.resourceId === req.params.id && p.userId === userId
+    );
+    if (existing >= 0) {
+      store.permissions[existing].role = grantedRole as 'viewer' | 'editor' | 'owner';
+    } else {
+      store.permissions.push({
+        resourceType: 'document',
+        resourceId: req.params.id,
+        userId,
+        role: grantedRole as 'viewer' | 'editor' | 'owner',
+      });
+    }
+    logActivity(store, 'share.granted', req.userId!, 'document', req.params.id);
+    res.status(200).json({ message: 'Share granted' });
+  });
+
+  return router;
+}
