+        .set('Authorization', `Bearer ${bob.token}`)
+        .send({ content: 'permissive' });
+      expect(writeRes.status).toBe(200);
+    });
+
+    it('nested folder permissions propagate to documents', async () => {
+      const { body: child } = await createFolder(alice.token, 'Child', folderId);
+      const { body: nestedDoc } = await createDocument(alice.token, child.id, 'NestedDoc', '');
+
+      await shareFolder(alice.token, folderId, bob.userId, 'viewer');
+
+      const res = await request(app)
+        .get(`/documents/${nestedDoc.id}`)
+        .set('Authorization', `Bearer ${bob.token}`);
+      expect(res.status).toBe(200);
+    });
+
+    it('folder editor can create documents in the folder', async () => {
+      await shareFolder(alice.token, folderId, bob.userId, 'editor');
+      const res = await createDocument(bob.token, folderId, 'BobDoc', 'Hi');
+      expect(res.status).toBe(201);
+      expect(res.body.ownerId).toBe(bob.userId);
+    });
+
