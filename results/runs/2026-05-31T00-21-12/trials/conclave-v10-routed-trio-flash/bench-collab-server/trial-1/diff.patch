ient.nextMessage(); // sync\n    client.send({ type: 'unknown_type', data: 'whatever' });\n    const err = await client.nextMessage();\n    expect(err.type).toBe('error');\n    client.close();\n  });\n\n  it('rejects operation with negative position', async () => {\n    const client = await connectWs(`${wsBase}/documents/${docId}`);\n    const sync = await client.nextMessage();\n    client.send({\n      type: 'operation',\n      op: { type: 'insert', position: -1, text: 'x', version: sync.version as number, clientId: 'e' },\n    });\n    const err = await client.nextMessage();\n    expect(err.type).toBe('error');\n    client.close();\n  });\n\n  it('rejects operation with future version', async () => {\n    const client = await connectWs(`${wsBase}/documents/${docId}`);\n    const sync = await client.nextMessage();\n    client.send({\n      type: 'operation',\n      op: { type: 'insert', position: 0, text: 'x', version: (sync.version as number) + 9999, clientId: 'e' },\n    });\n    const err = await client.nextMessage();\n    expect(err.type).toBe('error');\n    client.close();\n  });\n\n  it('server remains functional after receiving malformed input', async () => {\n    const client = await connectWs(`${wsBase}/documents/${docId}`);\n    await client.nextMessage(); // sync\n    client.ws.send('{{{{broken json');\n    const err = await client.nextMessage();\n    expect(err.type).toBe('error');\n    // Server should still work\n    const res = await request(base).get(`/api/documents/${docId}`);\n    expect(res.status).toBe(200);\n    client.close();\n  });\n});\n\n// ─── Persistence ──────────────────────────────────────────────────────────────\n\ndescribe('Persistence', () => {\n  const dbFile = join(tmpdir(), `collab-test-${Date.now()}.db`);\n\n  afterAll(() => {\n    for (const f of [dbFile, `${dbFile}-wal`, `${dbFile}-shm`]) {\n      if (existsSync(f)) unlinkSync(f);\n    }\n  });\n\n  it('document survives server restart', async () => {\n    let app1 = createAp