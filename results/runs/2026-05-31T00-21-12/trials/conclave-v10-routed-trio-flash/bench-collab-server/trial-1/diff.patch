@@ -0,0 +1,87 @@
+import { Router, type Request, type Response } from 'express';
+import { randomUUID } from 'crypto';
+import type { Db } from './db.js';
+import type { Store } from './store.js';
+
+export function createRouter(db: Db, store: Store): Router {
+  const router = Router();
+  router.use((req, _res, next) => {
+    // Ensure JSON body parsing errors are handled
+    if (req.is('application/json') && req.body === undefined) {
+      req.body = {};
+    }
+    next();
+  });
+
+  router.post('/documents', (req: Request, res: Response) => {
+    const { title, content = '' } = req.body as { title?: unknown; content?: unknown };
+    if (!title || typeof title !== 'string') {
+      return res.status(400).json({ error: 'title is required' });
+    }
+    if (typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    const doc = db.createDocument(randomUUID(), title, content);
+    return res.status(201).json(doc);
+  });
+
+  router.get('/documents', (_req: Request, res: Response) => {
+    return res.json(db.listDocuments());
+  });
+
+  router.get('/documents/:id', (req: Request, res: Response) => {
+    const doc = db.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'Document not found' });
+    return res.json(doc);
+  });
+
+  router.put('/documents/:id', (req: Request, res: Response) => {
+    const existing = db.getDocument(req.params.id);
+    if (!existing) return res.status(404).json({ error: 'Document not found' });
+
+    const body = req.body as { title?: unknown; content?: unknown };
+    const title = body.title !== undefined ? body.title : existing.title;
+    const content = body.content !== undefined ? body.content : existing.content;
+
+    if (typeof title !== 'string') return res.status(400).json({ error: 'Invalid title' });
+    if (typeof content !== 'string') return res.status(400).json({ error: 'Invalid content' });
+
+    const updated = db.updateDocument(req.params.id, title, content);
+    if (!updated) return res.status(404).json({ error: 'Document not found' });
+
+    store.reloadDocument(req.params.id);
+    const state = store.getState(req.params.id);
+    if (state) {
+      store.broadcast(
+        req.params.id,
+        JSON.stringify({ type: 'sync', content: state.content, version: state.version })
+      );
+    }
+
+    return res.json(updated);
+  });
+
+  router.delete('/documents/:id', (req: Request, res: Response) => {
+    const deleted = db.deleteDocument(req.params.id);
+    if (!deleted) return res.status(404).json({ error: 'Document not found' });
+    store.evictDocument(req.params.id);
+    return res.status(204).end();
+  });
+
+  router.get('/documents/:id/versions', (req: Request, res: Response) => {
+    if (!db.getDocument(req.params.id)) {
+      return res.status(404).json({ error: 'Document not found' });
+    }
+    return res.json(db.getVersions(req.params.id));
+  });
+
+  router.get('/documents/:id/versions/:version', (req: Request, res: Response) => {
+    const version = parseInt(req.params.version, 10);
+    if (isNaN(version)) return res.status(400).json({ error: 'Invalid version number' });
+    const v = db.getVersion(req.params.id, version);
+    if (!v) return res.status(404).json({ error: 'Version not found' });
+    return res.json(v);
+  });
+
+  return router;
+}
diff --git a/src/server.ts b/src/server.ts
new file mode 100644
index 0000000..7010648
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,129 @@
+import express from 'express';
+import { createServer, type Server } from 'http';
+import { WebSocketServer, WebSocket } from 'ws';
+import { randomUUID } from 'crypto';
+import { createDb } from './db.js';
+import { createStore } from './store.js';
+import { createRouter } from './routes.js';
+import { validateOperation, type Operation } from './ot.js';
+
+interface WsMsg {
+  type: string;
+  op?: unknown;
+}
+
+export function createApp(dbPath?: string) {
+  const db = createDb(dbPath ?? ':memory:');
+  const store = createStore(db);
+
+  const expressApp = express();
+  expressApp.use(express.json());
+  expressApp.use('/api', createRouter(db, store));
+
+  const httpServer: Server = createServer(expressApp);
+  const wss = new WebSocketServer({ noServer: true });
+
+  httpServer.on('upgrade', (request, socket, head) => {
+    const url = request.url ?? '';
+    const match = /^\/documents\/([^/?#]+)/.exec(url);
+    if (!match) {
+      socket.write('HTTP/1.1 404 Not Found\r\n\r\n');
+      socket.destroy();
+      return;
+    }
+    const docId = match[1];
+    wss.handleUpgrade(request, socket, head, (ws) => {
+      wss.emit('connection', ws, request, docId);
+    });
+  });
+
+  wss.on('connection', (ws: WebSocket, _req: unknown, docId: string) => {
+    const clientId = randomUUID();
+    const state = store.addClient(docId, clientId, ws);
+
+    if (!state) {
+      ws.send(JSON.stringify({ type: 'error', message: 'Document not found' }));
+      ws.close(1008, 'Document not found');
+      return;
+    }
+
+    ws.send(JSON.stringify({ type: 'sync', content: state.content, version: state.version }));
+
+    ws.on('message', (data) => {
+      let msg: WsMsg;
+      try {
+        msg = JSON.parse(data.toString()) as WsMsg;
+      } catch {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid JSON' }));
+        return;
+      }
+
+      if (msg.type !== 'operation') {
+        ws.send(JSON.stringify({ type: 'error', message: `Unknown message type: ${msg.type}` }));
+        return;
+      }
+
+      if (!msg.op || typeof msg.op !== 'object') {
+        ws.send(JSON.stringify({ type: 'error', message: 'Missing or invalid op field' }));
+        return;
+      }
+
+      const opObj = msg.op as Record<string, unknown>;
+      // Assign clientId if not provided by client
+      if (!opObj.clientId) opObj.clientId = clientId;
+
+      if (!validateOperation(opObj)) {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid operation fields' }));
+        return;
+      }
+
+      const result = store.applyOp(docId, opObj as Operation);
+      if (!result.success) {
+        ws.send(JSON.stringify({ type: 'error', message: result.error }));
+        return;
+      }
+
+      const ack = JSON.stringify({ type: 'ack', version: result.version, op: result.operation });
+      ws.send(ack);
+
+      const broadcast = JSON.stringify({
+        type: 'operation',
+        op: result.operation,
+        version: result.version,
+      });
+      store.broadcast(docId, broadcast, clientId);
+    });
+
+    ws.on('close', () => store.removeClient(docId, clientId));
+    ws.on('error', () => store.removeClient(docId, clientId));
+  });
+
+  return {
+    app: httpServer,
+
+    start(port = 0): Promise<number> {
+      return new Promise((resolve, reject) => {
+        httpServer.once('error', reject);
+        httpServer.listen(port, () => {
+          httpServer.off('error', reject);
+          const addr = httpServer.address();
+          resolve(typeof addr === 'object' && addr !== null ? addr.port : port);
+        });
+      });
+    },
+
+    stop(): Promise<void> {
+      return new Promise((resolve) => {
+        for (const ws of wss.clients) {
+          ws.terminate();
+        }
+        wss.close(() => {
