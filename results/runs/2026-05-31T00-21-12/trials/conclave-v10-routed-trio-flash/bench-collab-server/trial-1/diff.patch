@@ -0,0 +1,101 @@
+import Database from 'better-sqlite3';
+import { readFileSync } from 'fs';
+import { fileURLToPath } from 'url';
+import { dirname, join } from 'path';
+import type { Operation } from './ot.js';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = dirname(__filename);
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface VersionRecord {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+export function createDb(dbPath = ':memory:') {
+  const db = new Database(dbPath);
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+  db.exec(readFileSync(join(__dirname, '..', 'schema.sql'), 'utf-8'));
+
+  const insertDoc = db.prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?) RETURNING *');
+  const insertVersion = db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)');
+  const getDoc = db.prepare('SELECT * FROM documents WHERE id = ?');
+  const listDocs = db.prepare('SELECT * FROM documents ORDER BY updated_at DESC');
+  const updateDocFull = db.prepare(
+    "UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ? RETURNING *"
+  );
+  const updateDocContent = db.prepare(
+    "UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?"
+  );
+  const deleteDoc = db.prepare('DELETE FROM documents WHERE id = ?');
+  const getVersions = db.prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC');
+  const getOneVersion = db.prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?');
+  const maxVersion = db.prepare('SELECT COALESCE(MAX(version), -1) as v FROM versions WHERE document_id = ?');
+
+  function nextVersionNum(id: string): number {
+    const row = maxVersion.get(id) as { v: number };
+    return row.v + 1;
+  }
+
+  return {
+    createDocument(id: string, title: string, content = ''): Document {
+      const doc = insertDoc.get(id, title, content) as Document;
+      insertVersion.run(id, 0, content, null);
+      return doc;
+    },
+
+    getDocument(id: string): Document | undefined {
+      return getDoc.get(id) as Document | undefined;
+    },
+
+    listDocuments(): Document[] {
+      return listDocs.all() as Document[];
+    },
+
+    updateDocument(id: string, title: string, content: string): Document | undefined {
+      const doc = updateDocFull.get(title, content, id) as Document | undefined;
+      if (doc) insertVersion.run(id, nextVersionNum(id), content, null);
+      return doc;
+    },
+
+    updateDocumentContent(id: string, content: string, operation?: Operation): boolean {
+      const result = updateDocContent.run(content, id);
+      if (result.changes > 0) {
+        insertVersion.run(id, nextVersionNum(id), content, operation ? JSON.stringify(operation) : null);
+        return true;
+      }
+      return false;
+    },
+
+    deleteDocument(id: string): boolean {
+      return deleteDoc.run(id).changes > 0;
+    },
+
+    getVersions(documentId: string): VersionRecord[] {
+      return getVersions.all(documentId) as VersionRecord[];
+    },
+
+    getVersion(documentId: string, version: number): VersionRecord | undefined {
+      return getOneVersion.get(documentId, version) as VersionRecord | undefined;
+    },
+
+    close(): void {
+      db.close();
+    },
+  };
+}
+
+export type Db = ReturnType<typeof createDb>;
diff --git a/src/ot.ts b/src/ot.ts
new file mode 100644
index 0000000..b242af7
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,110 @@
+export interface InsertOp {
+  type: 'insert';
+  position: number;
+  text: string;
+  version: number;
+  clientId: string;
+}
+
+export interface DeleteOp {
+  type: 'delete';
+  position: number;
+  length: number;
+  version: number;
+  clientId: string;
+}
+
+export type Operation = InsertOp | DeleteOp;
+
+export function transform(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    return transformII(op1, op2);
+  } else if (op1.type === 'insert' && op2.type === 'delete') {
+    return transformID(op1, op2 as DeleteOp);
+  } else if (op1.type === 'delete' && op2.type === 'insert') {
+    return transformDI(op1 as DeleteOp, op2 as InsertOp);
+  } else {
+    return transformDD(op1 as DeleteOp, op2 as DeleteOp);
+  }
+}
+
+function transformII(op1: InsertOp, op2: InsertOp): InsertOp {
+  if (op2.position < op1.position) {
+    return { ...op1, position: op1.position + op2.text.length };
+  }
+  // Tie-break by clientId to ensure deterministic ordering
+  if (op2.position === op1.position && op2.clientId < op1.clientId) {
+    return { ...op1, position: op1.position + op2.text.length };
+  }
+  return op1;
+}
+
+function transformID(op1: InsertOp, op2: DeleteOp): InsertOp {
+  const op2End = op2.position + op2.length;
+  if (op1.position <= op2.position) return op1;
+  if (op1.position >= op2End) return { ...op1, position: op1.position - op2.length };
+  return { ...op1, position: op2.position };
+}
+
+function transformDI(op1: DeleteOp, op2: InsertOp): DeleteOp {
+  const op1End = op1.position + op1.length;
+  if (op2.position <= op1.position) {
+    return { ...op1, position: op1.position + op2.text.length };
+  }
+  if (op2.position >= op1End) return op1;
+  // Insert is inside the delete range — extend the delete
+  return { ...op1, length: op1.length + op2.text.length };
+}
+
+function transformDD(op1: DeleteOp, op2: DeleteOp): DeleteOp {
+  const op1End = op1.position + op1.length;
+  const op2End = op2.position + op2.length;
+
+  if (op2End <= op1.position) {
+    // op2 entirely before op1
+    return { ...op1, position: op1.position - op2.length };
+  }
+  if (op2.position >= op1End) {
+    // op2 entirely after op1
+    return op1;
+  }
+  if (op2.position <= op1.position && op2End >= op1End) {
+    // op2 completely covers op1 — becomes no-op
+    return { ...op1, position: op2.position, length: 0 };
+  }
+  if (op2.position <= op1.position) {
+    // op2 overlaps the start of op1
+    return { ...op1, position: op2.position, length: op1End - op2End };
+  }
+  if (op2End >= op1End) {
+    // op2 overlaps the end of op1
+    return { ...op1, length: op2.position - op1.position };
+  }
+  // op2 is entirely within op1
+  return { ...op1, length: op1.length - op2.length };
+}
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    const pos = Math.max(0, Math.min(op.position, content.length));
+    return content.slice(0, pos) + op.text + content.slice(pos);
+  }
+  const pos = Math.max(0, Math.min(op.position, content.length));
+  const end = Math.min(pos + Math.max(0, op.length), content.length);
+  return content.slice(0, pos) + content.slice(end);
+}
+
+export function validateOperation(op: unknown): op is Operation {
+  if (!op || typeof op !== 'object') return false;
+  const o = op as Record<string, unknown>;
+  if (typeof o.version !== 'number' || !Number.isInteger(o.version) || o.version < 0) return false;
+  if (typeof o.clientId !== 'string') return false;
+  if (typeof o.position !== 'number' || !Number.isInteger(o.position) || o.position < 0) return false;
+  if (o.type === 'insert') {
+    return typeof o.text === 'string';
+  }
+  if (o.type === 'delete') {
+    return typeof o.length === 'number' && Number.isInteger(o.length) && (o.length as number) >= 0;
+  }
+  return false;
+}
