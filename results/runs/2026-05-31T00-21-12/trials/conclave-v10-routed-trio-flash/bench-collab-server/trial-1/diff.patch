D ────────────────────────────────────────────────────────────────\n\ndescribe('REST CRUD', () => {\n  let app: AppInstance;\n  let port: number;\n  let base: string;\n  let docId: string;\n\n  beforeAll(async () => {\n    app = createApp();\n    port = await app.start(0);\n    base = `http://localhost:${port}`;\n  });\n\n  afterAll(async () => {\n    await app.stop();\n  });\n\n  it('creates a document and returns 201', async () => {\n    const res = await request(base)\n      .post('/api/documents')\n      .send({ title: 'Hello', content: 'initial content' });\n    expect(res.status).toBe(201);\n    expect(res.body).toMatchObject({ title: 'Hello', content: 'initial content' });\n    expect(typeof res.body.id).toBe('string');\n    docId = res.body.id as string;\n  });\n\n  it('lists documents', async () => {\n    const res = await request(base).get('/api/documents');\n    expect(res.status).toBe(200);\n    expect(Array.isArray(res.body)).toBe(true);\n    expect(res.body.length).toBeGreaterThanOrEqual(1);\n  });\n\n  it('gets a document by id', async () => {\n    const res = await request(base).get(`/api/documents/${docId}`);\n    expect(res.status).toBe(200);\n    expect(res.body.id).toBe(docId);\n    expect(res.body.title).toBe('Hello');\n  });\n\n  it('returns 404 for missing document', async () => {\n    const res = await request(base).get('/api/documents/nonexistent-id');\n    expect(res.status).toBe(404);\n  });\n\n  it('updates document title via PUT', async () => {\n    const res = await request(base)\n      .put(`/api/documents/${docId}`)\n      .send({ title: 'Updated Title' });\n    expect(res.status).toBe(200);\n    expect(res.body.title).toBe('Updated Title');\n  });\n\n  it('updates document content via PUT', async () => {\n    const res = await request(base)\n      .put(`/api/documents/${docId}`)\n      .send({ content: 'new content' });\n    expect(res.status).toBe(200);\n    expect(res.body.content).toBe('new content');\n  });\n\n  it('returns 404 when updating nonexistent document', async () => {\n    const res = await request(base)\n      .put('/api/documents/nonexistent-id')\n      .send({ title: 'x' });\n    expect(res.status).toBe(404);\n  });\n\n  it('gets version history for a document', async () => {\n    const res = await request(base).get(`/api/documents/${docId}/versions`);\n    expect(res.status).toBe(200);\n    expect(Array.isArray(res.body)).toBe(true);\n    expect(res.body.length).toBeGreaterThanOrEqual(1);\n    expect(res.body[0]).toMatchObject({ document_id: docId, version: 0 });\n  });\n\n  it('gets a specific version', async () => {\n    const res = await request(base).get(`/api/documents/${docId}/versions/0`);\n    expect(res.status).toBe(200);\n    expect(res.body.version).toBe(0);\n    expect(res.body.document_id).toBe(docId);\n  });\n\n  it('deletes a document and returns 204', async () => {\n    const createRes = await request(base)\n      .post('/api/documents')\n      .send({ title: 'To Delete' });\n    const id = createRes.body.id as string;\n    const delRes = await request(base).delete(`/api/documents/${id}`);\n    expect(delRes.status).toBe(204);\n    const getRes = await request(base).get(`/api/documents/${id}`);\n    expect(getRes.status).toBe(404);\n  });\n});\n\n// ─── WebSocket Lifecycle ──────────────────────────────────────────────────────\n\ndescribe('WebSocket Lifecycle', () => {\n  let app: AppInstance;\n  let port: number;\n  let base: string;\n  let wsBase: string;\n  let docId: string;\n\n  beforeAll(async () => {\n    app = createApp();\n    port = await app.start(0);\n    base = `http://localhost:${port}`;\n    wsBase = `ws://localhost:${port}`;\n    const res = await request(base)\n      .post('/api/documents')\n      .send({ title: 'WS Doc', content: 'hello world' });\n    docId = res.body.id as string;\n  });\n\n  afterAll(async () => {\n    await app.stop();\n  });\n\n  it('connects to a document via WebSocket', async () => {\n    const client = await connectWs(`${wsBase}/documents/${docId}`);\n    expect(client.ws.readyState).toBe(WebSocket.OPEN);\n    client.close();\n  });\n\n  it('receives sync message on connect with content and version', async () => {\n    const client = await connectWs(`${wsBase}/documents/${docId}`);\n    const msg = await client.nextMessage();\n    expect(msg.type).toBe('sync');\n    expect(msg.content).toBe('hello world');\n    expect(typeof msg.version).toBe('number');\n    client.close();\n  });\n\n  it('sync message contains current document content', async () => {\n    const client = await connectWs(`${wsBase}/documents/${docId}`);\n    const sync = await client.nextMessage();\n    expect(sync.type).toBe('sync');\n    expect(sync.content).toBe('hello world');\n    client.close();\n  });\n\n  it('receives error when connecting to nonexistent document', async () => {\n    return new Promise<void>((resolve) => {\n      const ws = new WebSocket(`${wsBase}/documents/no-such-doc`);\n      ws.on('message', (data) => {\n        const msg = JSON.parse(data.toString()) as Record<string, unknown>;\n        expect(msg.type).toBe('error');\n        ws.close();\n        resolve();\n      });\n      ws.on('error', () => resolve());\n      ws.on('close', () => resolve());\n    });\n  });\n\n  it('multiple clients can connect to the same document', async () => {\n    const c1 = await connectWs(`${wsBase}/documents/${docId}`);\n    const c2 = await connectWs(`${wsBase}/documents/${docId}`);\n    const c3 = await connectWs(`${wsBase}/documents/${docId}`);\n    expect(c1.ws.readyState).toBe(WebSocket.OPEN);\n    expect(c2.ws.readyState).toBe(WebSocket.OPEN);\n    expect(c3.ws.readyState).toBe(WebSocket.OPEN);\n    c1.close(); c2.close(); c3.close();\n  });\n\n  it('client receives broadcast when another client edits', async () => {\n    const c1 = await connectWs(`${wsBase}/documents/${docId}`);\n    const c2 = await connectWs(`${wsBase}/documents/${docId}`);\n    const sync1 = await c1.nextMessage();\n    await c2.nextMessage(); // consume sync\n    const ver = sync1.version as number;\n\n    c1.send({\n      type: 'operation',\n      op: { type: 'insert', position: 0, text: 'X', version: ver, clientId: 'c1' },\n    });\n\n    await c1.nextMessage(); // ack\n    const broadcast = await c2.nextMessage();\n    expect(broadcast.type).toBe('operation');\n\n    c1.close(); c2.close();\n  });\n\n  it('disconnected client stops receiving messages', async () => {\n    const client = await connectWs(`${wsBase}/documents/${docId}`);\n    await client.nextMessage(); // sync\n    client.close();\n    await sleep(50);\n    expect(client.ws.readyState).toBe(WebSocket.CLOSED);\n  });\n\n  it('server handles client disconnect gracefully', async () => {\n    const c1 = await connectWs(`${wsBase}/documents/${docId}`);\n    const c2 = await connectWs(`${wsBase}/documents/${docId}`);\n    await c1.nextMessage();\n    await c2.nextMessage();\n    c1.close();\n    await sleep(50);\n    // c2 should still work\n    expect(c2.ws.readyState).toBe(WebSocket.OPEN);\n    c2.close();\n  });\n});\n\n// ─── Single Client Editing ────────────────────────────────────────────────────\n\ndescribe('Single Client Editing', () => {\n  let app: AppInstance;\n  let port: number;\n  let base: string;\n  let wsBase: string;\n\n  beforeAll(async () => {\n    app = createApp();\n    port = await app.start(0);\n    base = `http://localhost:${port}`;\n    wsBase = `ws://localhost:${port}`;\n  });\n\n  afterAll(async () => {\n    await app.stop();\n  });\n\n  async function makeDoc(content = ''): Promise<{ id: string; client: WsClient; version: number }> {\n    const res = await request(base).post('/api/documents').send({ title: 'Test', content });\n    const id = res.body.id as string;\n    const client = await connectWs(`${wsBase}/documents/${id}`);\n    const sync = await client.nextMessage();\n    return { id, client, version: sync.version as number };\n  }\n\n  it('inserts text at the beginning', async () => {\n    const { id, client, version } = await makeDoc('world');\n    client.send({ type: 'operation', op: { type: 'insert', position: 0, text: 'hello ', version, clientId: 'c1' } });\n    const ack = await client.nextMessage();\n    expect(ack.type).toBe('ack');\n    const res = await request(base).get(`/api/documents/${id}`);\n    expect(res.body.content).toBe('hello world');\n    client.close();\n  });\n\n  it('inserts text at the end', async () => {\n    const { id, client, version } = await makeDoc('hello');\n    client.send({ type: 'operation', op: { type: 'insert', position: 5, text: ' world', version, clientId: 'c1' } });\n    await client.nextMessage(); // ack\n    const res = await request(base).get(`/api/documents/${id}`);\n    expect(res.body.content).toBe('hello world');\n    client.close();\n  });\n\n  it('inserts text in the middle', async () => {\n    const { id, client, version } = await makeDoc('helloworld');\n    client.send({ type: 'operation', op: { type: 'insert', position: 5, text: ' ', version, clientId: 'c1' } });\n    await client.nextMessage(); // ack\n    const res = await request(base).get(`/api/documents/${id}`);\n    expect(res.body.content).toBe('hello world');\n    client.close();\n  });\n\n  it('deletes text from document', async () => {\n    const { id, client, version } = await makeDoc('hello world');\n    client.send({ type: 'operation', op: { type: 'delete', position: 5, length: 6, version, clientId: 'c1' } });\n    await client.nextMessage(); // ack\n    const res = await request(base).get(`/api/documents/${id}`);\n    expect(res.body.content).toBe('hello');\n    client.close();\n  });\n\n  it('applies multiple sequential operations', async () => {\n    const { id, client, version } = await makeDoc('');\n    client.send({ type: 'operation', op: { type: 'insert', position: 0, text: 'Hello', version, clientId: 'c1' } });\n    const ack1 = await client.nextMessage();\n    const v1 = (ack1 as { version: number }).version;\n    client.send({ type: 'operation', op: { type: 'insert', position: 5, text: ' World', version: v1, clientId: 'c1' } });\n    await client.nextMessage(); // ack2\n    const res = await request(base).get(`/api/documents/${id}`);\n    expect(res.body.content).toBe('Hello World');\n    client.close();\n  });\n\n  it('persists content after operations via REST', async () => {\n    const { id, client, version } = await makeDoc('start');\n    client.send({ type: 'operation', op: { type: 'insert', position: 5, text: '!', version, clientId: 'c1' } });\n    await client.nextMessage(); // ack\n    client.close();\n    await sleep(20);\n    const res = await request(base).get(`/api/documents/${id}`);\n    expect(res.body.content).toBe('start!');\n  });\n});\n\n// ─── Two-Client Convergence ───────────────────────────────────────────────────\n\ndescribe('Two-Client Convergence', () => {\n  let app: AppInstance;\n  let port: number;\n  let base: string;\n  let wsBase: string;\n\n  beforeAll(async () => {\n    app = createApp();\n    port = await app.start(0);\n    base = `http://localhost:${port}`;\n    wsBase = `ws://localhost:${port}`;\n  });\n\n  afterAll(async () => {\n    await app.stop();\n  });\n\n  async function setup(content = '') {\n    const res = await request(base).post('/api/documents').send({ title: 'Conv', content });\n    const id = res.body.id as string;\n    const c1 = await connectWs(`${wsBase}/documents/${id}`);\n    const c2 = await connectWs(`${wsBase}/documents/${id}`);\n    const s1 = await c1.nextMessage();\n    await c2.nextMessage();\n    return { id, c1, c2, version: s1.version as number };\n  }\n\n  it('two inserts at different positions both appear in final doc', async () => {\n    const { id, c1, c2, version } = await setup('ABCDE');\n    c1.send({ type: 'operation', op: { type: 'insert', position: 0, text: '1', version, clientId: 'c1' } });\n    c2.send({ type: 'operation', op: { type: 'insert', position: 5, text: '2', version, clientId: 'c2' } });\n    await c1.nextMessage(); // ack\n    await c2.nextMessage(); // broadcast or ack\n    await c2.nextMessage(); // ack\n    await c1.nextMessage(); // broadcast\n    const res = await request(base).get(`/api/documents/${id}`);\n    expect(res.body.content).toContain('1');\n    expect(res.body.content).toContain('2');\n    c1.close(); c2.close();\n  });\n\n  it('two concurrent inserts at same position both preserved', async () => {\n    const { id, c1, c2, version } = await setup('hello');\n    c1.send({ type: 'operation', op: { type: 'insert', position: 0, text: 'A', version, clientId: 'aaa' } });\n    c2.send({ type: 'operation', op: { type: 'insert', position: 0, text: 'B', version, clientId: 'bbb' } });\n    await Promise.all([c1.nextMessage(), c2.nextMessage()]);\n    await Promise.all([c1.nextMessage(), c2.nextMessage()]);\n    const res = await request(base).get(`/api/documents/${id}`);\n    expect(res.body.content).toContain('A');\n    expect(res.body.content).toContain('B');\n    expect(res.body.content).toContain('hello');\n    c1.close(); c2.close();\n  });\n\n  it('concurrent insert and delete converge correctly', async () => {\n    const { id, c1, c2, version } = await setup('Hello World');\n    // c1 inserts \"!\" at end, c2 deletes \" World\"\n    c1.send({ type: 'operation', op: { type: 'insert', position: 11, text: '!', version, clientId: 'c1' } });\n    c2.send({ type: 'operation', op: { type: 'delete', position: 5, length: 6, version, clientId: 'c2' } });\n    await Promise.all([c1.nextMessage(), c2.nextMessage()]);\n    await Promise.all([c1.nextMessage(), c2.nextMessage()]);\n    const res = await request(base).get(`/api/documents/${id}`);\n    // Both ops should be applied: insert of \"!\" and delete of \" World\"\n    expect(res.body.content).toContain('Hello');\n    expect(res.body.content).toContain('!');\n    c1.close(); c2.close();\n  });\n\n  it('all clients end up with the same content', async () => {\n    const { id, c1, c2, version } = await s