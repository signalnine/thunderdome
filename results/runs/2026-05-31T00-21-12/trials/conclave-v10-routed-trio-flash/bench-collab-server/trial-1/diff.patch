${wsBase}/documents/${docId}`);\n    const msg = await client.nextMessage();\n    expect(msg.type).toBe('sync');\n    expect(msg.content).toBe('hello world');\n    expect(typeof msg.version).toBe('number');\n    client.close();\n  });\n\n  it('sync message contains current document content', async () => {\n    const client = await connectWs(`${wsBase}/documents/${docId}`);\n    const sync = await client.nextMessage();\n    expect(sync.type).toBe('sync');\n    expect(sync.content).toBe('hello world');\n    client.close();\n  });\n\n  it('receives error when connecting to nonexistent document', async () => {\n    return new Promise<void>((resolve) => {\n      const ws = new WebSocket(`${wsBase}/documents/no-such-doc`);\n      ws.on('message', (data) => {\n        const msg = JSON.parse(data.toString()) as Record<string, unknown>;\n        expect(msg.type).toBe('error');\n        ws.close();\n        resolve();\n      });\n      ws.on('error', () => resolve());\n      ws.on('close', () => resolve());\n    });\n  });\n\n  it('multiple clients can connect to the same document', async () => {\n    const c1 = await connectWs(`${wsBase}/documents/${docId}`);\n    const c2 = await connectWs(`${wsBase}/documents/${docId}`);\n    const c3 = await connectWs(`${wsBase}/documents/${docId}`);\n    expect(c1.ws.readyState).toBe(WebSocket.OPEN);\n    expect(c2.ws.readyState).toBe(WebSocket.OPEN);\n    expect(c3.ws.readyState).toBe(WebSocket.OPEN);\n    c1.close(); c2.close(); c3.close();\n  });\n\n  it('client receives broadcast when another client edits', async () => {\n    const c1 = await connectWs(`${wsBase}/documents/${docId}`);\n    const c2 = await connectWs(`${wsBase}/documents/${docId}`);\n    const sync1 = await c1.nextMessage();\n    await c2.nextMessage(); // consume sync\n    const ver = sync1.version as number;\n\n    c1.send({\n      type: 'operation',\n      op: { type: 'insert', position: 0, text: 'X', version: ver, clientId: 'c1' },\n    });\n\n    await c1.nextMes