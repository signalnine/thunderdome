--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,125 @@
+import type { WebSocket } from 'ws';
+import { applyOperation, transform, type Operation } from './ot.js';
+import type { Db } from './db.js';
+
+interface ClientInfo {
+  ws: WebSocket;
+  clientId: string;
+}
+
+interface DocumentState {
+  id: string;
+  content: string;
+  version: number;
+  loadedAtVersion: number;
+  operations: Operation[];
+  clients: Map<string, ClientInfo>;
+}
+
+export type ApplyResult =
+  | { success: true; operation: Operation; version: number; content: string }
+  | { success: false; error: string };
+
+export function createStore(db: Db) {
+  const documents = new Map<string, DocumentState>();
+
+  function loadDocument(docId: string): DocumentState | undefined {
+    const doc = db.getDocument(docId);
+    if (!doc) return undefined;
+    const versions = db.getVersions(docId);
+    const version = Math.max(0, versions.length - 1);
+    const state: DocumentState = {
+      id: docId,
+      content: doc.content,
+      version,
+      loadedAtVersion: version,
+      operations: [],
+      clients: new Map(),
+    };
+    documents.set(docId, state);
+    return state;
+  }
+
+  function getOrLoad(docId: string): DocumentState | undefined {
+    return documents.get(docId) ?? loadDocument(docId);
+  }
+
+  return {
+    addClient(docId: string, clientId: string, ws: WebSocket): DocumentState | undefined {
+      const state = getOrLoad(docId);
+      if (!state) return undefined;
+      state.clients.set(clientId, { ws, clientId });
+      return state;
+    },
+
+    removeClient(docId: string, clientId: string): void {
+      const state = documents.get(docId);
+      if (!state) return;
+      state.clients.delete(clientId);
+      if (state.clients.size === 0) documents.delete(docId);
+    },
+
+    applyOp(docId: string, op: Operation): ApplyResult {
+      const state = getOrLoad(docId);
+      if (!state) return { success: false, error: 'Document not found' };
+
+      if (op.version < state.loadedAtVersion || op.version > state.version) {
+        return {
+          success: false,
+          error: `Invalid base version ${op.version}, current: ${state.version}`,
+        };
+      }
+
+      let transformed = { ...op };
+      const startIdx = op.version - state.loadedAtVersion;
+      for (let i = startIdx; i < state.operations.length; i++) {
+        transformed = transform(transformed, state.operations[i]) as typeof transformed;
+      }
+
+      state.content = applyOperation(state.content, transformed);
+      state.operations.push({ ...transformed, version: state.version });
+      state.version++;
+
+      db.updateDocumentContent(docId, state.content, transformed);
+
+      return {
+        success: true,
+        operation: { ...transformed, version: state.version },
+        version: state.version,
+        content: state.content,
+      };
+    },
+
+    broadcast(docId: string, message: string, excludeClientId?: string): void {
+      const state = documents.get(docId);
+      if (!state) return;
+      for (const [id, client] of state.clients) {
+        if (id !== excludeClientId && client.ws.readyState === 1) {
+          client.ws.send(message);
+        }
+      }
+    },
+
+    reloadDocument(docId: string): void {
+      const state = documents.get(docId);
+      if (!state) return;
+      const doc = db.getDocument(docId);
+      if (!doc) return;
+      const versions = db.getVersions(docId);
+      state.content = doc.content;
+      state.version = Math.max(0, versions.length - 1);
+      state.loadedAtVersion = state.version;
+      state.operations = [];
+    },
+
+    getState(docId: string): DocumentState | undefined {
+      return documents.get(docId);
+    },
+
+    evictDocument(docId: string): void {
+      documents.delete(docId);
+    },
+  };
+}
+
+export type Store = ReturnType<typeof createStore>;
