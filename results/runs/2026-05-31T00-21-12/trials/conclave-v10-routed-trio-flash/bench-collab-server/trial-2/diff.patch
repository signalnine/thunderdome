+import { describe, it, expect } from 'vitest';
+import { applyOp, transform, transformAgainstAll, validateOp, type Operation } from '../src/ot.js';
+
+describe('applyOp', () => {
+  it('inserts text at position', () => {
+    expect(applyOp('hello world', { type: 'insert', position: 5, text: ' beautiful' })).toBe(
+      'hello beautiful world',
+    );
+  });
+
+  it('inserts at start', () => {
+    expect(applyOp('world', { type: 'insert', position: 0, text: 'hello ' })).toBe('hello world');
+  });
+
+  it('inserts at end', () => {
+    expect(applyOp('hello', { type: 'insert', position: 5, text: '!' })).toBe('hello!');
+  });
+
+  it('inserts beyond end clamps to end', () => {
+    expect(applyOp('hi', { type: 'insert', position: 100, text: '!' })).toBe('hi!');
+  });
+
+  it('deletes characters', () => {
+    expect(applyOp('hello world', { type: 'delete', position: 5, length: 6 })).toBe('hello');
+  });
+
+  it('deletes at start', () => {
+    expect(applyOp('hello world', { type: 'delete', position: 0, length: 6 })).toBe('world');
+  });
+
+  it('delete clamps at end', () => {
+    expect(applyOp('hello', { type: 'delete', position: 3, length: 100 })).toBe('hel');
+  });
+
+  it('delete length 0 is no-op', () => {
+    expect(applyOp('hello', { type: 'delete', position: 2, length: 0 })).toBe('hello');
+  });
+});
+
+describe('transform: insert vs insert', () => {
+  it('against before op shifts op right', () => {
+    const op: Operation = { type: 'insert', position: 5, text: 'B' };
+    const against: Operation = { type: 'insert', position: 2, text: 'AA' };
+    const t = transform(op, against);
+    expect(t).toEqual({ type: 'insert', position: 7, text: 'B' });
+  });
+
+  it('against after op leaves op unchanged', () => {
+    const op: Operation = { type: 'insert', position: 2, text: 'B' };
+    const against: Operation = { type: 'insert', position: 5, text: 'AA' };
+    const t = transform(op, against);
+    expect(t).toEqual(op);
+  });
+
+  it('same position without priority shifts op right', () => {
+    const op: Operation = { type: 'insert', position: 3, text: 'B' };
+    const against: Operation = { type: 'insert', position: 3, text: 'A' };
+    const t = transform(op, against, false);
+    expect(t).toEqual({ type: 'insert', position: 4, text: 'B' });
+  });
+
+  it('same position with priority op stays', () => {
+    const op: Operation = { type: 'insert', position: 3, text: 'B' };
+    const against: Operation = { type: 'insert', position: 3, text: 'A' };
+    const t = transform(op, against, true);
+    expect(t).toEqual(op);
+  });
+
+  it('convergence: two inserts at different positions', () => {
+    const base = 'AC';
+    const opA: Operation = { type: 'insert', position: 1, text: 'B' }; // AC -> ABC
+    const opB: Operation = { type: 'insert', position: 2, text: 'D' }; // AC -> ACD
+
+    const opA2 = transform(opA, opB);
+    const opB2 = transform(opB, opA);
+
+    const path1 = applyOp(applyOp(base, opA), opB2); // apply A then B'
+    const path2 = applyOp(applyOp(base, opB), opA2); // apply B then A'
+    expect(path1).toBe(path2);
+    expect(path1).toBe('ABCD');
+  });
+});
+
+describe('transform: insert vs delete', () => {
+  it('delete before insert shifts insert left', () => {
