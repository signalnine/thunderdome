+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import supertest from 'supertest';
+import { createApp } from '../src/server.js';
+
+describe('REST API', () => {
+  let instance: ReturnType<typeof createApp>;
+  let request: supertest.SuperTest<supertest.Test>;
+
+  beforeEach(async () => {
+    instance = createApp(':memory:');
+    await instance.start(0);
+    request = supertest(instance.app);
+  });
+
+  afterEach(async () => {
+    await instance.stop();
+  });
+
+  describe('POST /api/documents', () => {
+    it('creates a document with title', async () => {
+      const res = await request.post('/api/documents').send({ title: 'My Doc' });
+      expect(res.status).toBe(201);
+      expect(res.body).toMatchObject({
+        title: 'My Doc',
+        content: '',
+        version: 0,
+      });
+      expect(typeof res.body.id).toBe('string');
+    });
+
+    it('creates a document with content', async () => {
+      const res = await request
+        .post('/api/documents')
+        .send({ title: 'Doc', content: 'Hello World' });
+      expect(res.status).toBe(201);
+      expect(res.body.content).toBe('Hello World');
+    });
+
+    it('returns 400 if title is missing', async () => {
+      const res = await request.post('/api/documents').send({ content: 'no title' });
+      expect(res.status).toBe(400);
+    });
+
+    it('returns 400 if title is empty', async () => {
+      const res = await request.post('/api/documents').send({ title: '' });
+      expect(res.status).toBe(400);
+    });
+  });
+
+  describe('GET /api/documents', () => {
+    it('returns empty array when no documents', async () => {
+      const res = await request.get('/api/documents');
+      expect(res.status).toBe(200);
+      expect(res.body).toEqual([]);
+    });
+
+    it('lists created documents', async () => {
+      await request.post('/api/documents').send({ title: 'Doc A' });
+      await request.post('/api/documents').send({ title: 'Doc B' });
+      const res = await request.get('/api/documents');
+      expect(res.status).toBe(200);
+      expect(res.body).toHaveLength(2);
+    });
+  });
+
+  describe('GET /api/documents/:id', () => {
+    it('returns document by id', async () => {
+      const created = await request.post('/api/documents').send({ title: 'Test' });
+      const id = created.body.id as string;
+      const res = await request.get(`/api/documents/${id}`);
+      expect(res.status).toBe(200);
+      expect(res.body.id).toBe(id);
+      expect(res.body.title).toBe('Test');
+    });
+
+    it('returns 404 for nonexistent document', async () => {
+      const res = await request.get('/api/documents/nonexistent-id');
+      expect(res.status).toBe(404);
+    });
+  });
