+
+describe('validateOp', () => {
+  it('accepts valid insert', () => {
+    expect(validateOp({ type: 'insert', position: 0, text: 'hello' })).toBe(true);
+  });
+
+  it('accepts valid delete', () => {
+    expect(validateOp({ type: 'delete', position: 5, length: 3 })).toBe(true);
