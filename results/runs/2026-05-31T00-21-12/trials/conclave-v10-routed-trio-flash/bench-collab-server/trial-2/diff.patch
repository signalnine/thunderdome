+{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01AyHgeiroCoLuk5QeYehwES","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MZa6atZo8YswCigm8Cu23F","name":"Write","input":{"file_path":"/workspace/tests/ws.test.ts","content":"import { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport { WebSocket } from 'ws';\nimport supertest from 'supertest';\nimport { createApp } from '../src/server.js';\nimport type { Operation } from '../src/ot.js';\n\ntype ServerMsg = {\n  type: 'sync' | 'op' | 'ack' | 'error';\n  content?: string;\n  version?: number;\n  operation?: Operation;\n  message?: string;\n};\n\nfunction connect(port: number, docId: string): Promise<{ ws: WebSocket; msgs: ServerMsg[] }> {\n  return new Promise((resolve, reject) => {\n    const ws = new WebSocket(`ws://127.0.0.1:${port}/ws/${docId}`);\n    const msgs: ServerMsg[] = [];\n    ws.on('error', reject);\n    ws.on('message', (data) => msgs.push(JSON.parse(data.toString()) as ServerMsg));\n    ws.on('open', () => resolve({ ws, msgs }));\n  });\n}\n\nfunction waitForMsg(msgs: ServerMsg[], predicate: (m: ServerMsg) => boolean, timeout = 2000): Promise<ServerMsg> {\n  return new Promise((resolve, reject) => {\n    const deadline = Date.now() + timeout;\n    function check() {\n      const found = msgs.find(predicate);\n      if (found) return resolve(found);\n      if (Date.now() > deadline) return reject(new Error('Timeout waiting for message'));\n      setTimeout(check, 10);\n    }\n    check();\n  });\n}\n\nfunction sendOp(ws: WebSocket, operation: Operation, baseVersion: number) {\n  ws.send(JSON.stringify({ type: 'op', operation, baseVersion }));\n}\n\nfunction closeWs(ws: WebSocket): Promise<void> {\n  return new Promise((resolve) => {\n    if (ws.readyState === WebSocket.CLOSED) return resolve();\n    ws.on('close', resolve);\n    ws.close();\n  });\n}\n\ndescribe('WebSocket collaboration', () => {\n  let instance: ReturnType<typeof createApp>;\n  let port: number;\n  let request: supertest.SuperTest<supertest.Test>;\n  let docId: string;\n\n  beforeEach(async () => {\n    instance = createApp(':memory:');\n    port = await instance.start(0);\n    request = supertest(instance.app);\n    const res = await request.post('/api/documents').send({ title: 'Collab Doc', content: 'hello' });\n    docId = res.body.id as string;\n  });\n\n  afterEach(async () => {\n    await instance.stop();\n  });\n\n  it('receives sync message on connect', async () => {\n    const { ws, msgs } = await connect(port, docId);\n    const sync = await waitForMsg(msgs, (m) => m.type === 'sync');\n    expect(sync.content).toBe('hello');\n    expect(sync.version).toBe(0);\n    await closeWs(ws);\n  });\n\n  it('closes with error on nonexistent document', async () => {\n    await new Promise<void>((resolve, reject) => {\n      const ws = new WebSocket(`ws://127.0.0.1:${port}/ws/nonexistent-doc-id`);\n      ws.on('close', resolve);\n      ws.on('error', reject);\n      // should close quickly\n      setTimeout(() => reject(new Error('Did not close')), 2000);\n    });\n  });\n\n  it('receives ack after sending operation', async () => {\n    const { ws, msgs } = await connect(port, docId);\n    await waitForMsg(msgs, (m) => m.type === 'sync');\n\n    sendOp(ws, { type: 'insert', position: 5, text: ' world' }, 0);\n    const ack = await waitForMsg(msgs, (m) => m.type === 'ack');\n    expect(ack.version).toBe(1);\n    await closeWs(ws);\n  });\n\n  it('broadcasts op to other clients', async () => {\n    const { ws: ws1, msgs: msgs1 } = await connect(port, docId);\n    const { ws: ws2, msgs: msgs2 } = await connect(port, docId);\n    await waitForMsg(msgs1, (m) => m.type === 'sync');\n    await waitForMsg(msgs2, (m) => m.type === 'sync');\n\n    sendOp(ws1, { type: 'insert', position: 5, text: '!' }, 0);\n    const broadcast = await waitForMsg(msgs2, (m) => m.type === 'op');\n    expect(broadcast.operation).toMatchObject({ type: 'insert', text: '!' });\n    expect(broadcast.version).toBe(1);\n\n    await closeWs(ws1);\n    await closeWs(ws2);\n  });\n\n  it('sender does NOT receive op broadcast (only ack)', async () => {\n    const { ws, msgs } = await connect(port, docId);\n    await waitForMsg(msgs, (m) => m.type === 'sync');\n\n    sendOp(ws, { type: 'insert', position: 0, text: 'X' }, 0);\n    await waitForMsg(msgs, (m) => m.type === 'ack');\n\n    // Give time for any unexpected op to arrive\n    await new Promise((r) => setTimeout(r, 100));\n    const opMsgs = msgs.filter((m) => m.type === 'op');\n    expect(opMsgs).toHaveLength(0);\n    await closeWs(ws);\n  });\n\n  it('returns error for invalid JSON', async () => {\n    const { ws, msgs } = await connect(port, docId);\n    await waitForMsg(msgs, (m) => m.type === 'sync');\n    ws.send('not json');\n    const err = await waitForMsg(msgs, (m) => m.type === 'error');\n    expect(err.message).toMatch(/JSON/i);\n    await closeWs(ws);\n  });\n\n  it('returns error for invalid operation', async () => {\n    const { ws, msgs } = await connect(port, docId);\n    await waitForMsg(msgs, (m) => m.type === 'sync');\n    ws.send(JSON.stringify({ type: 'op', operation: { type: 'bad' }, baseVersion: 0 }));\n    const err = await waitForMsg(msgs, (m) => m.type === 'error');\n    expect(err.message).toMatch(/operation/i);\n    await closeWs(ws);\n  });\n\n  it('returns error for missing baseVersion', async () => {\n    const { ws, msgs } = await connect(port, docId);\n    await waitForMsg(msgs, (m) => m.type === 'sync');\n    ws.send(JSON.stringify({ type: 'op', operation: { type: 'insert', position: 0, text: 'x' } }));\n    const err = await waitForMsg(msgs, (m) => m.type === 'error');\n    expect(err.message).toBeDefined();\n    await closeWs(ws);\n  });\n\n  it('concurrent inserts from 2 clients converge', async () => {\n    const { ws: ws1, msgs: msgs1 } = await connect(port, docId);\n    const { ws: ws2, msgs: msgs2 } = await connect(port, docId);\n    const sync1 = await waitForMsg(msgs1, (m) => m.type === 'sync');\n    await waitForMsg(msgs2, (m) => m.type === 'sync');\n\n    const baseVer = sync1.version!;\n\n    // Both send ops concurrently at same base version\n    sendOp(ws1, { type: 'insert', position: 0, text: 'A' }, baseVer);\n    sendOp(ws2, { type: 'insert', position: 0, text: 'B' }, baseVer);\n\n    await waitForMsg(msgs1, (m) => m.type === 'ack');\n    await waitForMsg(msgs2, (m) => m.type === 'ack');\n\n    // Wait a bit for all broadcasts to arrive\n    await new Promise((r) => setTimeout(r, 200));\n\n    // Check final document state\n    const docRes = await request.get(`/api/documents/${docId}`);\n    const finalContent = docRes.body.content as string;\n\n    // Both A and B must be present, and original content preserved\n    expect(finalContent).toContain('A');\n    expect(finalContent).toContain('B');\n    expect(finalContent).toContain('hello');\n\n    await closeWs(ws1);\n    await closeWs(ws2);\n  });\n\n  it('10 concurrent clients all converge', async () => {\n    const N = 10;\n    const clients = await Promise.all(\n      Array.from({ length: N }, (_, i) => connect(port, docId).then(async (c) => {\n        await waitForMsg(c.msgs, (m) => m.type === 'sync');\n        return { ...c, idx: i };\n      })),\n    );\n\n    // Each client sends a unique single-char insert at position 0\n    const chars = 'ABCDEFGHIJ';\n    for (const c of clients) {\n      sendOp(c.ws, { type: 'insert', position: 0, text: chars[c.idx] }, 0);\n    }\n\n    // Wait for all acks\n    await Promise.all(clients.map((c) => waitForMsg(c.msgs, (m) => m.type === 'ack', 5000)));\n    await new Promise((r) => setTimeout(r, 300));\n\n    // Final content should contain all characters\n    const docRes = await request.get(`/api/documents/${docId}`);\n    const finalContent = docRes.body.content as string;\n    for (const char of chars) {\n      expect(finalContent).toContain(char);\n    }\n\n    await Promise.all(clients.map((c) => closeWs(c.ws)));\n  });\n\n  it('persists content across restarts', async () => {\n    // Use a temp file for this test\n    const tmpDb = `/tmp/test-persist-${Date.now()}.db`;\n    const inst1 = createApp(tmpDb);\n    const p1 = await inst1.start(0);\n    const req1 = supertest(inst1.app);\n\n    const docRes = await req1.post('/api/documents').send({ title: 'Persist', content: 'start' });\n    const id = docRes.body.id as string;\n    const { ws, msgs } = await connect(p1, id);\n    await waitForMsg(msgs, (m) => m.type === 'sync');\n    sendOp(ws, { type: 'insert', position: 5, text: 'ed' }, 0);\n    await waitForMsg(msgs, (m) => m.type === 'ack');\n    await closeWs(ws);\n    await inst1.stop();\n\n    // Start fresh server with same DB\n    const inst2 = createApp(tmpDb);\n    const p2 = await inst2.start(0);\n    const req2 = supertest(inst2.app);\n\n    const getRes = await req2.get(`/api/documents/${id}`);\n    expect(getRes.body.content).toBe('started');\n    expect(getRes.body.version).toBe(1);\n\n    await inst2.stop();\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1714,"cache_read_input_tokens":46169,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1714},"output_tokens":40,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d46291f0-cb4f-4fb0-adfa-a29ed5415132","uuid":"1389c6b3-2f07-4f24-a5eb-c0dc5bf93926","request_id":"req_011CbZhbn3dPaa1SKy4TdRHd"}
