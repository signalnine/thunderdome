+++ b/src/db.ts
@@ -0,0 +1,151 @@
+import Database from 'better-sqlite3';
+import { randomUUID } from 'crypto';
+import type { Operation } from './ot.js';
+
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS documents (
+  id TEXT PRIMARY KEY,
+  title TEXT NOT NULL,
+  content TEXT NOT NULL DEFAULT '',
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  updated_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+
+CREATE TABLE IF NOT EXISTS versions (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  version INTEGER NOT NULL,
+  content TEXT NOT NULL,
+  operation TEXT,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  UNIQUE(document_id, version)
+);
+
+CREATE TABLE IF NOT EXISTS active_connections (
+  id TEXT PRIMARY KEY,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  connected_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+`;
+
+export interface DocRow {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface VersionRow {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+export interface Document extends DocRow {
+  version: number;
+}
+
+export function createDb(dbPath = ':memory:') {
+  const db = new Database(dbPath);
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+  db.exec(SCHEMA);
+
+  const stmts = {
+    insertDoc: db.prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?)'),
+    insertVersion: db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)',
+    ),
+    getDoc: db.prepare('SELECT * FROM documents WHERE id = ?'),
+    listDocs: db.prepare('SELECT * FROM documents ORDER BY created_at DESC'),
+    maxVersion: db.prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?'),
+    updateDoc: db.prepare(
+      "UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?",
+    ),
+    updateTitle: db.prepare(
+      "UPDATE documents SET title = ?, updated_at = datetime('now') WHERE id = ?",
+    ),
+    deleteDoc: db.prepare('DELETE FROM documents WHERE id = ?'),
+    getVersions: db.prepare(
+      'SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC',
+    ),
+    getOpsSince: db.prepare(
+      'SELECT version, operation FROM versions WHERE document_id = ? AND version > ? AND operation IS NOT NULL ORDER BY version ASC',
+    ),
+  };
+
+  function getVersion(documentId: string): number {
+    const row = stmts.maxVersion.get(documentId) as { v: number | null } | undefined;
+    return row?.v ?? 0;
+  }
+
+  function toDocument(row: DocRow): Document {
+    return { ...row, version: getVersion(row.id) };
+  }
+
+  return {
+    createDocument(title: string, content = ''): Document {
+      const id = randomUUID();
+      db.transaction(() => {
+        stmts.insertDoc.run(id, title, content);
+        stmts.insertVersion.run(id, 0, content, null);
+      })();
+      return toDocument(stmts.getDoc.get(id) as DocRow);
+    },
+
+    getDocument(id: string): Document | null {
+      const row = stmts.getDoc.get(id) as DocRow | undefined;
+      return row ? toDocument(row) : null;
+    },
+
+    listDocuments(): Document[] {
+      return (stmts.listDocs.all() as DocRow[]).map(toDocument);
+    },
+
+    updateDocument(id: string, fields: { title?: string; content?: string }): Document | null {
+      const existing = stmts.getDoc.get(id) as DocRow | undefined;
+      if (!existing) return null;
+      const title = fields.title ?? existing.title;
+      const content = fields.content ?? existing.content;
+      stmts.updateDoc.run(title, content, id);
+      return toDocument(stmts.getDoc.get(id) as DocRow);
+    },
+
+    deleteDocument(id: string): boolean {
+      const result = stmts.deleteDoc.run(id);
+      return result.changes > 0;
+    },
+
+    applyOperation(documentId: string, op: Operation, newContent: string, newVersion: number): void {
+      db.transaction(() => {
+        db.prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?").run(
+          newContent,
+          documentId,
+        );
+        stmts.insertVersion.run(documentId, newVersion, newContent, JSON.stringify(op));
+      })();
+    },
+
+    getVersions(documentId: string): VersionRow[] {
+      return stmts.getVersions.all(documentId) as VersionRow[];
+    },
+
+    getOperationsSince(documentId: string, fromVersion: number): { version: number; operation: Operation }[] {
+      const rows = stmts.getOpsSince.all(documentId, fromVersion) as {
+        version: number;
+        operation: string;
+      }[];
+      return rows.map((r) => ({ version: r.version, operation: JSON.parse(r.operation) as Operation }));
+    },
+
+    close(): void {
+      db.close();
+    },
+  };
+}
+
+export type Db = ReturnType<typeof createDb>;
diff --git a/src/ot.ts b/src/ot.ts
new file mode 100644
index 0000000..c74374f
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,90 @@
+export type InsertOp = { type: 'insert'; position: number; text: string };
+export type DeleteOp = { type: 'delete'; position: number; length: number };
+export type Operation = InsertOp | DeleteOp;
+
+export function applyOp(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    const pos = Math.min(Math.max(0, op.position), content.length);
+    return content.slice(0, pos) + op.text + content.slice(pos);
+  } else {
+    const pos = Math.min(Math.max(0, op.position), content.length);
+    const end = Math.min(pos + Math.max(0, op.length), content.length);
+    return content.slice(0, pos) + content.slice(end);
+  }
+}
+
+// Transform op so it can be applied after `against` has already been applied.
+// priority: when both are inserts at the same position, priority=true means op wins (goes first)
+export function transform(op: Operation, against: Operation, priority = false): Operation {
+  if (op.type === 'insert') {
+    if (against.type === 'insert') {
+      if (against.position < op.position || (against.position === op.position && !priority)) {
+        return { type: 'insert', position: op.position + against.text.length, text: op.text };
+      }
+      return op;
+    } else {
+      // Insert vs Delete
+      if (against.position + against.length <= op.position) {
+        return { type: 'insert', position: op.position - against.length, text: op.text };
+      } else if (against.position >= op.position) {
+        return op;
+      } else {
+        // op.position is within the deleted range — delete wins, insert becomes no-op
+        return { type: 'insert', position: against.position, text: '' };
+      }
+    }
+  } else {
+    if (against.type === 'insert') {
+      // Delete vs Insert
+      if (against.position <= op.position) {
+        return { type: 'delete', position: op.position + against.text.length, length: op.length };
+      } else if (against.position >= op.position + op.length) {
+        return op;
+      } else {
+        // insert is within the delete range — extend
+        return { type: 'delete', position: op.position, length: op.length + against.text.length };
+      }
+    } else {
+      // Delete vs Delete
+      // How much of `against` falls strictly before op.position?
+      const deletedBefore = Math.max(
+        0,
+        Math.min(op.position, against.position + against.length) - Math.max(0, against.position),
+      );
+      // How much of `against` overlaps with op's range?
+      const deletedWithin = Math.max(
+        0,
+        Math.min(op.position + op.length, against.position + against.length) -
+          Math.max(op.position, against.position),
+      );
+      return {
+        type: 'delete',
+        position: Math.max(0, op.position - deletedBefore),
+        length: Math.max(0, op.length - deletedWithin),
+      };
+    }
+  }
+}
+
+// Transform op against a sequence of operations (each already applied in order)
+export function transformAgainstAll(op: Operation, ops: Operation[]): Operation {
+  let result = op;
+  for (const against of ops) {
+    result = transform(result, against);
+  }
+  return result;
+}
+
+export function validateOp(op: unknown): op is Operation {
+  if (typeof op !== 'object' || op === null) return false;
+  const o = op as Record<string, unknown>;
+  if (o.type === 'insert') {
+    return typeof o.position === 'number' && o.position >= 0 && typeof o.text === 'string';
+  }
+  if (o.type === 'delete') {
+    return (
+      typeof o.position === 'number' && o.position >= 0 && typeof o.length === 'number' && o.length >= 0
+    );
+  }
+  return false;
+}
