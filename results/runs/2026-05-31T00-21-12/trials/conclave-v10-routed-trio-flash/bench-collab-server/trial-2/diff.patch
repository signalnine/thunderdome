+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { WebSocket } from 'ws';
+import supertest from 'supertest';
+import { createApp } from '../src/server.js';
+import type { Operation } from '../src/ot.js';
+
+type ServerMsg = {
+  type: 'sync' | 'op' | 'ack' | 'error';
+  content?: string;
+  version?: number;
+  operation?: Operation;
+  message?: string;
+};
+
+function connect(port: number, docId: string): Promise<{ ws: WebSocket; msgs: ServerMsg[] }> {
+  return new Promise((resolve, reject) => {
+    const ws = new WebSocket(`ws://127.0.0.1:${port}/ws/${docId}`);
+    const msgs: ServerMsg[] = [];
+    ws.on('error', reject);
+    ws.on('message', (data) => msgs.push(JSON.parse(data.toString()) as ServerMsg));
+    ws.on('open', () => resolve({ ws, msgs }));
+  });
+}
+
+function waitForMsg(msgs: ServerMsg[], predicate: (m: ServerMsg) => boolean, timeout = 2000): Promise<ServerMsg> {
+  return new Promise((resolve, reject) => {
+    const deadline = Date.now() + timeout;
+    function check() {
+      const found = msgs.find(predicate);
+      if (found) return resolve(found);
+      if (Date.now() > deadline) return reject(new Error('Timeout waiting for message'));
+      setTimeout(check, 10);
+    }
+    check();
+  });
+}
+
+function sendOp(ws: WebSocket, operation: Operation, baseVersion: number) {
+  ws.send(JSON.stringify({ type: 'op', operation, baseVersion }));
+}
+
+function closeWs(ws: WebSocket): Promise<void> {
+  return new Promise((resolve) => {
+    if (ws.readyState === WebSocket.CLOSED) return resolve();
+    ws.on('close', resolve);
+    ws.close();
+  });
+}
+
+describe('WebSocket collaboration', () => {
+  let instance: ReturnType<typeof createApp>;
+  let port: number;
+  let request: supertest.SuperTest<supertest.Test>;
+  let docId: string;
+
+  beforeEach(async () => {
+    instance = createApp(':memory:');
+    port = await instance.start(0);
+    request = supertest(instance.app);
+    const res = await request.post('/api/documents').send({ title: 'Collab Doc', content: 'hello' });
+    docId = res.body.id as string;
+  });
+
+  afterEach(async () => {
+    await instance.stop();
+  });
