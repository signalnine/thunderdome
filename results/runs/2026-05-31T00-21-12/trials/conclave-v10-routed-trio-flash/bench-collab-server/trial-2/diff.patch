new file mode 100644
index 0000000..e16ca2f
--- /dev/null
+++ b/src/wsHandler.ts
@@ -0,0 +1,167 @@
+import { WebSocketServer, WebSocket } from 'ws';
+import type { IncomingMessage } from 'http';
+import type { Db } from './db.js';
+import { validateOp, transformAgainstAll, applyOp, type Operation } from './ot.js';
+
+interface RoomState {
+  version: number;
+  content: string;
+  clients: Set<WebSocket>;
+}
+
+interface ClientOp {
+  type: 'op';
+  operation: unknown;
+  baseVersion: number;
+}
+
+interface SyncMessage {
+  type: 'sync';
+  content: string;
+  version: number;
+}
+
+interface OpMessage {
+  type: 'op';
+  operation: Operation;
+  version: number;
+}
+
+interface AckMessage {
+  type: 'ack';
+  version: number;
+}
+
+interface ErrorMessage {
+  type: 'error';
+  message: string;
+}
+
+type ServerMessage = SyncMessage | OpMessage | AckMessage | ErrorMessage;
+
+function send(ws: WebSocket, msg: ServerMessage): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify(msg));
+  }
+}
+
+function parseDocumentId(url: string | undefined): string | null {
+  if (!url) return null;
+  const match = url.match(/^\/ws\/([^/?#]+)/);
+  return match ? decodeURIComponent(match[1]) : null;
+}
+
+export function createWsHandler(db: Db): WebSocketServer {
+  const wss = new WebSocketServer({ noServer: true });
+  const rooms = new Map<string, RoomState>();
+
+  function getRoom(documentId: string): RoomState | null {
+    if (rooms.has(documentId)) return rooms.get(documentId)!;
+    const doc = db.getDocument(documentId);
+    if (!doc) return null;
+    const state: RoomState = {
+      version: doc.version,
+      content: doc.content,
+      clients: new Set(),
+    };
+    rooms.set(documentId, state);
+    return state;
+  }
+
+  wss.on('connection', (ws: WebSocket, req: IncomingMessage) => {
+    const documentId = parseDocumentId(req.url);
+    if (!documentId) {
+      send(ws, { type: 'error', message: 'Missing document ID' });
+      ws.close(1008, 'Missing document ID');
+      return;
+    }
+
+    const room = getRoom(documentId);
+    if (!room) {
+      send(ws, { type: 'error', message: 'Document not found' });
+      ws.close(1008, 'Document not found');
+      return;
+    }
+
+    room.clients.add(ws);
+
+    // Send current state to new client
+    send(ws, { type: 'sync', content: room.content, version: room.version });
+
+    ws.on('message', (data: Buffer | string) => {
+      let parsed: unknown;
+      try {
+        parsed = JSON.parse(data.toString());
+      } catch {
+        send(ws, { type: 'error', message: 'Invalid JSON' });
+        return;
+      }
+
+      if (typeof parsed !== 'object' || parsed === null) {
+        send(ws, { type: 'error', message: 'Expected JSON object' });
+        return;
+      }
+
+      const msg = parsed as Record<string, unknown>;
+
+      if (msg.type !== 'op') {
+        send(ws, { type: 'error', message: `Unknown message type: ${String(msg.type)}` });
+        return;
+      }
+
+      const clientMsg = msg as Partial<ClientOp>;
+      if (typeof clientMsg.baseVersion !== 'number') {
+        send(ws, { type: 'error', message: 'baseVersion must be a number' });
+        return;
+      }
+
+      if (!validateOp(clientMsg.operation)) {
+        send(ws, { type: 'error', message: 'Invalid operation' });
+        return;
+      }
+
+      const baseVersion = clientMsg.baseVersion;
+      const incomingOp = clientMsg.operation as Operation;
+
+      // Get operations applied since the client's base version
+      const opsSince = db.getOperationsSince(documentId, baseVersion).map((o) => o.operation);
+
+      // Transform the incoming op against concurrent ops
+      const transformedOp = transformAgainstAll(incomingOp, opsSince);
+
+      // Apply to current content
+      const newContent = applyOp(room.content, transformedOp);
+      const newVersion = room.version + 1;
+
+      // Persist
+      db.applyOperation(documentId, transformedOp, newContent, newVersion);
+
+      // Update in-memory state
+      room.content = newContent;
+      room.version = newVersion;
+
+      // Ack the sender
+      send(ws, { type: 'ack', version: newVersion });
+
+      // Broadcast to all other clients
+      for (const client of room.clients) {
+        if (client !== ws) {
+          send(client, { type: 'op', operation: transformedOp, version: newVersion });
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      if (room.clients.size === 0) {
+        rooms.delete(documentId);
+      }
+    });
+
+    ws.on('error', () => {
+      room.clients.delete(ws);
+    });
+  });
+
+  return wss;
+}
