+    const against: Operation = { type: 'delete', position: 3, length: 4 };
+    // against deletes [3,7), op wants to delete [5,10)
+    // [5,7) already gone, [7,10) remains -> delete [3, 3) -> position=3, length=3
+    const t = transform(op, against);
