this.advance(); return { type: 'String', value: t.value as string }; }\n    if (t.type === 'BOOLEAN') { this.advance(); return { type: 'Boolean', value: t.value as boolean }; }\n\n    if (t.type === 'IDENT') {\n      this.advance();\n      const name = t.value as string;\n\n      if (this.peek().type === 'LPAREN') {\n        this.advance();\n        const args: ASTNode[] = [];\n        if (this.peek().type !== 'RPAREN') {\n          args.push(this.parseFuncArg());\n          while (this.peek().type === 'COMMA') { this.advance(); args.push(this.parseFuncArg()); }\n        }\n        this.eat('RPAREN');\n        return { type: 'FunctionCall', name, args };\n      }\n\n      if (CELL_RE.test(name)) {\n        if (this.peek().type === 'COLON') {\n          this.advance();\n          const end = this.eat('IDENT').value as string;\n          return { type: 'Range', start: name, end };\n        }\n        return { type: 'CellRef', cell: name };\n      }\n\n      throw new Error(`Unknown identifier: ${name}`);\n    }\n\n    if (t.type === 'LPAREN') {\n      this.advance();\n      const expr = this.parseExpr();\n      this.eat('RPAREN');\n      return expr;\n    }\n\n    throw new Error(`Unexpected token: ${t.type}`);\n  }\n\n  private parseFuncArg(): ASTNode {\n    if (this.peek().type === 'IDENT' && CELL_RE.test(this.peek().value as string)\n      && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].type === 'COLON') {\n      const start = this.advance().value as string;\n      this.advance(); // ':'\n      const end = this.eat('IDENT').value as string;\n      return { type: 'Range', start, end };\n    }\n    return this.parseExpr();\n  }\n}\n\nfunction parseFormula(expr: string): ASTNode {\n  return new Parser(tokenize(expr)).parseExpr();\n}\n\n// ===== Cell Reference Utilities =====\n\nfunction colToNum(col: string): number {\n  let n = 0;\n  for (const c of col) n = n * 26 + c.charCodeAt(0) - 64;\n  return n;\n}\n\nfunction numToCol(n: number): string {\n  