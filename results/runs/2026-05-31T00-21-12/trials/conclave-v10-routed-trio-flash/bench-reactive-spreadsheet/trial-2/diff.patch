 () => {\n  it('handles simple number literal formula', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=42');\n    expect(s.get('A1')).toBe(42);\n  });\n\n  it('adds two cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('A3', '=A1+A2');\n    expect(s.get('A3')).toBe(30);\n  });\n\n  it('subtracts cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 3);\n    s.set('A3', '=A1-A2');\n    expect(s.get('A3')).toBe(7);\n  });\n\n  it('multiplies cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 4);\n    s.set('A2', 5);\n    s.set('A3', '=A1*A2');\n    expect(s.get('A3')).toBe(20);\n  });\n\n  it('divides cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 4);\n    s.set('A3', '=A1/A2');\n    expect(s.get('A3')).toBe(2.5);\n  });\n\n  it('respects operator precedence: * before +', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=2+3*4');\n    expect(s.get('A1')).toBe(14);\n  });\n\n  it('respects parentheses', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=(2+3)*4');\n    expect(s.get('A1')).toBe(20);\n  });\n\n  it('handles unary negation', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=-5');\n    expect(s.get('A1')).toBe(-5);\n  });\n\n  it('handles unary negation of cell', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 7);\n    s.set('B1', '=-A1');\n    expect(s.get('B1')).toBe(-7);\n  });\n\n  it('uses 0 for empty cell references in arithmetic', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1+5');\n    expect(s.get('A1')).toBe(5);\n  });\n\n  it('handles chained arithmetic', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('A3', 3);\n    s.set('A4', '=A1+A2+A3');\n    expect(s.get('A4')).toBe(6);\n  });\n});\n\n// ===== Reactive Updates =====\n\ndescribe('reactive updates', () => {\n  it('updates formula cell when dependency changes', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe(11);\n    s.set('A1', 50);\n    expect(s.get('B1')).toBe(51);\n  });\n\n  it('propagates changes through a chain', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('B1', '=A1+1');\n    s.set('C1', '=B1+1');\n    expect(s.get('C1')).toBe(3);\n    s.set('A1', 10);\n    expect(s.get('B1')).toBe(11);\n    expect(s.get('C1')).toBe(12);\n  });\n\n  it('propagates changes through a long chain', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 0);\n    s.set('A2', '=A1+1');\n    s.set('A3', '=A2+1');\n    s.set('A4', '=A3+1');\n    s.set('A5', '=A4+1');\n    expect(s.get('A5')).toBe(4);\n    s.set('A1', 10);\n    expect(s.get('A5')).toBe(14);\n  });\n\n  it('handles diamond dependency graph', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=A1*2');\n    s.set('C1', '=A1*3');\n    s.set('D1', '=B1+C1');\n    expect(s.get('D1')).toBe(25);\n    s.set('A1', 10);\n    expect(s.get('B1')).toBe(20);\n    expect(s.get('C1')).toBe(30);\n    expect(s.get('D1')).toBe(50);\n  });\n\n  it('changing formula updates dependencies correctly', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B1', 20);\n    s.set('C1', '=A1');\n    expect(s.get('C1')).toBe(10);\n    s.set('C1', '=B1');\n    expect(s.get('C1')).toBe(20);\n    s.set('A1', 99);\n    expect(s.get('C1')).toBe(20); // C1 no longer depends on A1\n    s.set('B1', 99);\n    expect(s.get('C1')).toBe(99);\n  });\n});\n\n// ===== Comparison Operators =====\n\ndescribe('comparison operators', () => {\n  it('evaluates greater than', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=5>3');\n    expect(s.get('A1')).toBe(true);\n    s.set('B1', '=3>5');\n    expect(s.get('B1')).toBe(false);\n  });\n\n  it('evaluates less than', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=3<5');\n    expect(s.get('A1')).toBe(true);\n  });\n\n  it('evaluates greater than or equal', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=5>=5');\n    expect(s.get('A1')).toBe(true);\n    s.set('B1', '=4>=5');\n    expect(s.get('B1')).toBe(false);\n  });\n\n  it('evaluates less than or equal', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=5<=5');\n    expect(s.get('A1')).toBe(true);\n  });\n\n  it('evaluates equality', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=5=5');\n    expect(s.get('A1')).toBe(true);\n    s.set('B1', '=5=6');\n    expect(s.get('B1')).toBe(false);\n  });\n\n  it('evaluates not equal', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=5<>6');\n    expect(s.get('A1')).toBe(true);\n    s.set('B1', '=5<>5');\n    expect(s.get('B1')).toBe(false);\n  });\n});\n\n// ===== IF Function =====\n\ndescribe('IF function', () => {\n  it('returns true branch when condition is true', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 50);\n    s.set('B1', '=IF(A1>30, \"big\", \"small\")');\n    expect(s.get('B1')).toBe('big');\n  });\n\n  it('returns false branch when condition is false', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B1', '=IF(A1>30, \"big\", \"small\")');\n    expect(s.get('B1')).toBe('small');\n  });\n\n  it('IF with numeric branches', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=IF(A1>3, 100, 0)');\n    expect(s.get('B1')).toBe(100);\n  });\n\n  it('IF with cell reference branches', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', 10);\n    s.set('C1', 20);\n    s.set('D1', '=IF(A1>3, B1, C1)');\n    expect(s.get('D1')).toBe(10);\n  });\n\n  it('IF reactively updates', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 50);\n    s.set('B1', '=IF(A1>30, \"big\", \"small\")');\n    expect(s.get('B1')).toBe('big');\n    s.set('A1', 10);\n    expect(s.get('B1')).toBe('small');\n  });\n\n  it('IF with boolean condition cell', () => {\n    const s = new Spreadsheet();\n    s.set('A1', true);\n    s.set('B1', '=IF(A1, 1, 0)');\n    expect(s.get('B1')).toBe(1);\n  });\n});\n\n// ===== SUM Function =====\n\ndescribe('SUM function', () => {\n  it('sums a column range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('A3', 3);\n    s.set('A4', 4);\n    s.set('A5', 5);\n    s.set('B1', '=SUM(A1:A5)');\n    expect(s.get('B1')).toBe(15);\n  });\n\n  it('sums a row range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B1', 20);\n    s.set('C1', 30);\n    s.set('D1', '=SUM(A1:C1)');\n    expect(s.get('D1')).toBe(60);\n  });\n\n  it('sums a block range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('B1', 3);\n    s.set('B2', 4);\n    s.set('C1', '=SUM(A1:B2)');\n    expect(s.get('C1')).toBe(10);\n  });\n\n  it('ignores non-numeric values in range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 'hello');\n    s.set('A3', 3);\n    s.set('B1', '=SUM(A1:A3)');\n    expect(s.get('B1')).toBe(4);\n  });\n\n  it('returns 0 for empty range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=SUM(B1:B3)');\n    expect(s.get('A1')).toBe(0);\n  });\n\n  it('SUM reactively updates when range cell changes', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('B1', '=SUM(A1:A2)');\n    expect(s.get('B1')).toBe(30);\n    s.set('A1', 50);\n    expect(s.get('B1')).toBe(70);\n  });\n});\n\n// ===== AVERAGE Function =====\n\ndescribe('AVERAGE function', () => {\n  it('computes average of a range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('A3', 30);\n    s.set('B1', '=AVERAGE(A1:A3)');\n    expect(s.get('B1')).toBe(20);\n  });\n\n  it('ignores non-numeric values', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 'text');\n    s.set('A3', 30);\n    s.set('B1', '=AVERAGE(A1:A3)');\n    expect(s.get('B1')).toBe(20);\n  });\n\n  it('returns 0 for empty range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=AVERAGE(B1:B3)');\n    expect(s.get('A1')).toBe(0);\n  });\n});\n\n// ===== MIN Function =====\n\ndescribe('MIN function', () => {\n  it('returns minimum value', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('A2', 2);\n    s.set('A3', 8);\n    s.set('B1', '=MIN(A1:A3)');\n    expect(s.get('B1')).toBe(2);\n  });\n\n  it('ignores non-numeric values', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('A2', 'text');\n    s.set('A3', 8);\n    s.set('B1', '=MIN(A1:A3)');\n    expect(s.get('B1')).toBe(5);\n  });\n\n  it('returns 0 for empty range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=MIN(B1:B3)');\n    expect(s.get('A1')).toBe(0);\n  });\n});\n\n// ===== MAX Function =====\n\ndescribe('MAX function', () => {\n  it('returns maximum value', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('A2', 2);\n    s.set('A3', 8);\n    s.set('B1', '=MAX(A1:A3)');\n    expect(s.get('B1')).toBe(8);\n  });\n\n  it('ignores non-numeric values', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('A2', 'text');\n    s.set('A3', 8);\n    s.set('B1', '=MAX(A1:A3)');\n    expect(s.get('B1')).toBe(8);\n  });\n});\n\n// ===== COUNT Function =====\n\ndescribe('COUNT function', () => {\n  it('counts numeric values in range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 'text');\n    s.set('A3', 3);\n    s.set('A4', true);\n    s.set('B1', '=COUNT(A1:A4)');\n    expect(s.get('B1')).toBe(2);\n  });\n\n  it('returns 0 for empty range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=COUNT(B1:B3)');\n    expect(s.get('A1')).toBe(0);\n  });\n});\n\n// ===== Ranges =====\n\ndescribe('range expansion', () => {\n  it('expands column range A1:A5 to 5 cells', () => {\n    const s = new Spreadsheet();\n    for (let i = 1; i <= 5; i++) s.set(`A${i}`, i);\n    s.set('B1', '=SUM(A1:A5)');\n    expect(s.get('B1')).toBe(15);\n  });\n\n  it('expands row range A1:E1', () => {\n    const s = new Spreadsheet();\n    ['A', 'B', 'C', 'D', 'E'].forEach((col, i) => s.set(`${col}1`, i + 1));\n    s.set('F1', '=SUM(A1:E1)');\n    expect(s.get('F1')).toBe(15);\n  });\n\n  it('expands block range A1:C3 (9 cells)', () => {\n    const s = new Spreadsheet();\n    for (let r = 1; r <= 3; r++)\n      for (const col of ['A', 'B', 'C'])\n        s.set(`${col}${r}`, 1);\n    s.set('D1', '=SUM(A1:C3)');\n    expect(s.get('D1')).toBe(9);\n  });\n\n  it('handles reverse range order (B3:A1)', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('A3', 3);\n    s.set('B1', '=SUM(A3:A1)');\n    expect(s.get('B1')).toBe(6);\n  });\n});\n\n// ===== Multi-letter Columns =====\n\ndescribe('multi-letter column references', () => {\n  it('supports AA1 cell reference', () => {\n    const s = new Spreadsheet();\n    s.set('AA1', 42);\n    expect(s.get('AA1')).toBe(42);\n  });\n\n  it('formula can reference AA1', () => {\n    const s = new Spreadsheet();\n    s.set('AA1', 10);\n    s.set('A1', '=AA1+5');\n    expect(s.get('A1')).toBe(15);\n  });\n\n  it('range spanning into AA column', () => {\n    const s = new Spreadsheet();\n    s.set('Z1', 10);\n    s.set('AA1', 20);\n    s.set('B1', '=SUM(Z1:AA1)');\n    expect(s.get('B1')).toBe(30);\n  });\n});\n\n// ===== Circular Reference Detection =====\n\ndescribe('circular reference detection', () => {\n  it('throws on direct self-reference', () => {\n    const s = new Spreadsheet();\n    expect(() => s.set('A1', '=A1+1')).toThrow(/[Cc]ircular/);\n  });\n\n  it('throws on direct two-cell cycle', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1+1');\n    expect(() => s.set('B1', '=A1+1')).toThrow(/[Cc]ircular/);\n  });\n\n  it('throws on indirect three-cell cycle', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1+1');\n    s.set('B1', '=C1+1');\n    expect(() => s.set('C1', '=A1+1')).toThrow(/[Cc]ircular/);\n  });\n\n  it('leaves existing values intact after circular error', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B1', '=A1+5');\n    expect(s.get('B1')).toBe(15);\n    expect(() => s.set('A1', '=B1+1')).toThrow(/[Cc]ircular/);\n    expect(s.get('A1')).toBe(10);\n    expect(s.get('B1')).toBe(15);\n  });\n});\n\n// ===== getDisplay =====\n\ndescribe('getDisplay', () => {\n  it('returns empty string for null cell', () => {\n    const s = new Spreadsheet();\n    expect(s.getDisplay('A1')).toBe('');\n  });\n\n  it('returns number as string', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 42);\n    expect(s.getDisplay('A1')).toBe('42');\n  });\n\n  it('returns float as string', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 3.14);\n    expect(s.getDisplay('A1')).toBe('3.14');\n  });\n\n  it('returns string value as-is', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 'hello');\n    expect(s.getDisplay('A1')).toBe('hello');\n  });\n\n  it('returns TRUE for boolean true', () => {\n    const s = new Spreadsheet();\n    s.set('A1', true);\n    expect(s.getDisplay('A1')).toBe('TRUE');\n  });\n\n  it('returns FALSE for boolean false', () => {\n    const s = new Spreadsheet();\n    s.set('A1', false);\n    expect(s.getDisplay('A1')).toBe('FALSE');\n  });\n\n  it('displays formula result', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('A3', '=A1+A2');\n    expect(s.getDisplay('A3')).toBe('30');\n  });\n});\n\n// ===== getCells =====\n\ndescribe('getCells', () => {\n  it('returns empty map for empty sheet', () => {\n    const s = new Spreadsheet();\n    expect(s.getCells().size).toBe(0);\n  });\n\n  it('returns all set cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B2', 'hello');\n    const cells = s.getCells();\n    expect(cells.get('A1')).toBe(10);\n    expect(cells.get('B2')).toBe('hello');\n  });\n\n  it('returns computed values for formula cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('A2', 10);\n    s.set('A3', '=A1+A2');\n    const cells = s.getCells();\n    expect(cells.get('A3')).toBe(15);\n  });\n});\n\n// ===== Full Example from Spec =====\n\ndescribe('spec example', () => {\n  it('matches the documented example', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 20);\n    sheet.set('A3', '=A1+A2');\n    expect(sheet.get('A3')).toBe(30);\n    expect(sheet.getDisplay('A3')).toBe('30');\n\n    sheet.set('A1', 50);\n    expect(sheet.get('A3')).toBe(70);\n\n    sheet.set('B1', '=SUM(A1:A2)');\n    expect(sheet.get('B1')).toBe(70);\n\n    sheet.set('C1', '=IF(A1>30, \"big\", \"small\")');\n    expect(sheet.get('C1')).toBe('big');\n  });\n});\n\n// ===== Edge Cases =====\n\ndescribe('edge cases', () => {\n  it('formula referencing unset cell treats it as 0', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1*2');\n    expect(s.get('A1')).toBe(0);\n    s.set('B1', 5);\n    expect(s.get('A1')).toBe(10);\n  });\n\n  it('negative number literal', () => {\n    const s = new Spreadsheet();\n    s.set('A1', -5);\n    expect(s.get('A1')).toBe(-5);\n  });\n\n  it('nested function calls with IF and comparison', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('A2', 10);\n    s.set('A3', 15);\n    s.set('B1', '=IF(SUM(A1:A3)>20, \"yes\", \"no\")');\n    expect(s.get('B1')).toBe('yes');\n    s.set('A3', 0);\n    expect(s.get('B1')).toBe('no');\n  });\n\n  it('overwriting a formula cell with a raw value stops reactive updates', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe(11);\n    s.set('B1', 99);\n    s.set('A1', 50);\n    expect(s.get('B1')).toBe(99);\n  });\n\n  it('handles zero as a cell value', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 0);\n    expect(s.get('A1')).toBe(0);\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe(1);\n  });\n\n  it('SUM with a single cell range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 42);\n    s.set('B1', '=SUM(A1:A1)');\n    expect(s.get('B1')).toBe(42);\n  });\n\n  it('COUNT reactive update', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 'text');\n    s.set('B1', '=COUNT(A1:A2)');\n    expect(s.get('B1')).toBe(1);\n    s.set('A2', 2);\n    expect(s.get('B1')).toBe(2);\n  });\n\n  it('complex formula: (A1+B1)*C1-D1', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 2);\n    s.set('B1', 3);\n    s.set('C1', 4);\n    s.set('D1', 1);\n    s.set('E1', '=(A1+B1)*C1-D1');\n    expect(s.get('E1')).toBe(19);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
