+export type CellValue = string | number | boolean | null;
+
+interface CellData {
+  raw: string | number | boolean;
+  computed: CellValue;
+  formula: string | null;
+  dependencies: Set<string>;
+}
+
+// ===== Tokenizer =====
+
+type TokenType =
+  | 'NUMBER' | 'STRING' | 'BOOLEAN' | 'IDENT'
+  | 'PLUS' | 'MINUS' | 'STAR' | 'SLASH'
+  | 'GTE' | 'LTE' | 'NEQ' | 'GT' | 'LT' | 'EQ'
+  | 'LPAREN' | 'RPAREN' | 'COMMA' | 'COLON'
+  | 'EOF';
+
+interface Token {
+  type: TokenType;
+  value: string | number | boolean;
+}
+
+function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+
+  while (i < input.length) {
+    if (/\s/.test(input[i])) { i++; continue; }
+
+    if (/[0-9]/.test(input[i]) || (input[i] === '.' && i + 1 < input.length && /[0-9]/.test(input[i + 1]))) {
+      let num = '';
+      while (i < input.length && /[0-9.]/.test(input[i])) num += input[i++];
+      tokens.push({ type: 'NUMBER', value: parseFloat(num) });
+      continue;
+    }
+
+    if (input[i] === '"') {
+      i++;
+      let str = '';
+      while (i < input.length && input[i] !== '"') {
+        if (input[i] === '\\' && i + 1 < input.length) i++;
+        str += input[i++];
+      }
+      if (i < input.length) i++;
+      tokens.push({ type: 'STRING', value: str });
+      continue;
+    }
+
+    if (/[A-Za-z]/.test(input[i])) {
+      let ident = '';
+      while (i < input.length && /[A-Za-z0-9]/.test(input[i])) ident += input[i++];
+      const upper = ident.toUpperCase();
+      if (upper === 'TRUE') tokens.push({ type: 'BOOLEAN', value: true });
+      else if (upper === 'FALSE') tokens.push({ type: 'BOOLEAN', value: false });
+      else tokens.push({ type: 'IDENT', value: upper });
+      continue;
+    }
+
+    const ch = input[i], ch2 = input[i + 1];
+    if (ch === '>' && ch2 === '=') { tokens.push({ type: 'GTE', value: '>=' }); i += 2; }
+    else if (ch === '<' && ch2 === '=') { tokens.push({ type: 'LTE', value: '<=' }); i += 2; }
+    else if (ch === '<' && ch2 === '>') { tokens.push({ type: 'NEQ', value: '<>' }); i += 2; }
+    else if (ch === '>') { tokens.push({ type: 'GT', value: '>' }); i++; }
+    else if (ch === '<') { tokens.push({ type: 'LT', value: '<' }); i++; }
+    else if (ch === '=') { tokens.push({ type: 'EQ', value: '=' }); i++; }
+    else if (ch === '+') { tokens.push({ type: 'PLUS', value: '+' }); i++; }
+    else if (ch === '-') { tokens.push({ type: 'MINUS', value: '-' }); i++; }
+    else if (ch === '*') { tokens.push({ type: 'STAR', value: '*' }); i++; }
+    else if (ch === '/') { tokens.push({ type: 'SLASH', value: '/' }); i++; }
+    else if (ch === '(') { tokens.push({ type: 'LPAREN', value: '(' }); i++; }
+    else if (ch === ')') { tokens.push({ type: 'RPAREN', value: ')' }); i++; }
+    else if (ch === ',') { tokens.push({ type: 'COMMA', value: ',' }); i++; }
+    else if (ch === ':') { tokens.push({ type: 'COLON', value: ':' }); i++; }
+    else throw new Error(`Unexpected character: ${ch}`);
+  }
+
+  tokens.push({ type: 'EOF', value: '' });
+  return tokens;
+}
+
+// ===== AST =====
+
+type ASTNode =
+  | { type: 'Number'; value: number }
+  | { type: 'String'; value: string }
+  | { type: 'Boolean'; value: boolean }
+  | { type: 'CellRef'; cell: string }
+  | { type: 'Range'; start: string; end: string }
+  | { type: 'BinaryOp'; op: string; left: ASTNode; right: ASTNode }
+  | { type: 'UnaryOp'; op: string; operand: ASTNode }
+  | { type: 'FunctionCall'; name: string; args: ASTNode[] };
+
+const CELL_RE = /^[A-Z]+[0-9]+$/;
+
+// ===== Parser =====
+
+class Parser {
+  private pos = 0;
+  constructor(private tokens: Token[]) {}
+
+  private peek(): Token { return this.tokens[this.pos]; }
+  private advance(): Token { return this.tokens[this.pos++]; }
+  private eat(type: TokenType): Token {
+    const t = this.advance();
+    if (t.type !== type) throw new Error(`Expected ${type}, got ${t.type}`);
+    return t;
+  }
+
+  parseExpr(): ASTNode { return this.parseComparison(); }
+
+  private parseComparison(): ASTNode {
+    let left = this.parseAdditive();
+    const cmpOps: TokenType[] = ['GTE', 'LTE', 'NEQ', 'GT', 'LT', 'EQ'];
+    while (cmpOps.includes(this.peek().type)) {
+      const op = this.advance().value as string;
+      left = { type: 'BinaryOp', op, left, right: this.parseAdditive() };
+    }
+    return left;
+  }
+
+  private parseAdditive(): ASTNode {
+    let left = this.parseMultiplicative();
+    while (this.peek().type === 'PLUS' || this.peek().type === 'MINUS') {
+      const op = this.advance().value as string;
+      left = { type: 'BinaryOp', op, left, right: this.parseMultiplicative() };
+    }
+    return left;
+  }
+
+  private parseMultiplicative(): ASTNode {
+    let left = this.parseUnary();
+    while (this.peek().type === 'STAR' || this.peek().type === 'SLASH') {
+      const op = this.advance().value as string;
+      left = { type: 'BinaryOp', op, left, right: this.parseUnary() };
+    }
+    return left;
+  }
+
+  private parseUnary(): ASTNode {
+    if (this.peek().type === 'MINUS') { this.advance(); return { type: 'UnaryOp', op: '-', operand: this.parseUnary() }; }
+    if (this.peek().type === 'PLUS') { this.advance(); return this.parseUnary(); }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): ASTNode {
+    const t = this.peek();
+
+    if (t.type === 'NUMBER') { this.advance(); return { type: 'Number', value: t.value as number }; }
+    if (t.type === 'STRING') { this.advance(); return { type: 'String', value: t.value as string }; }
+    if (t.type === 'BOOLEAN') { this.advance(); return { type: 'Boolean', value: t.value as boolean }; }
+
+    if (t.type === 'IDENT') {
+      this.advance();
+      const name = t.value as string;
+
+      if (this.peek().type === 'LPAREN') {
+        this.advance();
+        const args: ASTNode[] = [];
+        if (this.peek().type !== 'RPAREN') {
+          args.push(this.parseFuncArg());
+          while (this.peek().type === 'COMMA') { this.advance(); args.push(this.parseFuncArg()); }
+        }
+        this.eat('RPAREN');
+        return { type: 'FunctionCall', name, args };
+      }
+
+      if (CELL_RE.test(name)) {
+        if (this.peek().type === 'COLON') {
+          this.advance();
+          const end = this.eat('IDENT').value as string;
+          return { type: 'Range', start: name, end };
+        }
+        return { type: 'CellRef', cell: name };
+      }
+
+      throw new Error(`Unknown identifier: ${name}`);
+    }
+
+    if (t.type === 'LPAREN') {
+      this.advance();
+      const expr = this.parseExpr();
+      this.eat('RPAREN');
+      return expr;
+    }
+
+    throw new Error(`Unexpected token: ${t.type}`);
+  }
+
+  private parseFuncArg(): ASTNode {
+    if (this.peek().type === 'IDENT' && CELL_RE.test(this.peek().value as string)
+      && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].type === 'COLON') {
+      const start = this.advance().value as string;
+      this.advance(); // ':'
+      const end = this.eat('IDENT').value as string;
+      return { type: 'Range', start, end };
+    }
+    return this.parseExpr();
+  }
+}
+
+function parseFormula(expr: string): ASTNode {
+  return new Parser(tokenize(expr)).parseExpr();
+}
+
+// ===== Cell Reference Utilities =====
+
+function colToNum(col: string): number {
+  let n = 0;
+  for (const c of col) n = n * 26 + c.charCodeAt(0) - 64;
+  return n;
+}
+
+function numToCol(n: number): string {
+  let s = '';
+  while (n > 0) { n--; s = String.fromCharCode(65 + (n % 26)) + s; n = Math.floor(n / 26); }
+  return s;
+}
+
+function parseRef(cell: string): [string, number] {
+  const m = cell.match(/^([A-Z]+)([0-9]+)$/);
+  if (!m) throw new Error(`Invalid cell reference: ${cell}`);
+  return [m[1], parseInt(m[2], 10)];
+}
+
+function expandRange(start: string, end: string): string[] {
+  const [sc, sr] = parseRef(start);
+  const [ec, er] = parseRef(end);
+  const c1 = Math.min(colToNum(sc), colToNum(ec));
+  const c2 = Math.max(colToNum(sc), colToNum(ec));
+  const r1 = Math.min(sr, er);
+  const r2 = Math.max(sr, er);
+  const cells: string[] = [];
+  for (let c = c1; c <= c2; c++)
+    for (let r = r1; r <= r2; r++)
+      cells.push(`${numToCol(c)}${r}`);
+  return cells;
+}
+
+// ===== Dependency Collection =====
+
+function collectDeps(node: ASTNode, deps: Set<string>): void {
+  switch (node.type) {
+    case 'CellRef': deps.add(node.cell); break;
+    case 'Range': expandRange(node.start, node.end).forEach(c => deps.add(c)); break;
+    case 'BinaryOp': collectDeps(node.left, deps); collectDeps(node.right, deps); break;
+    case 'UnaryOp': collectDeps(node.operand, deps); break;
+    case 'FunctionCall': node.args.forEach(a => collectDeps(a, deps)); break;
+  }
+}
+
+// ===== Evaluator =====
+
+function evalNode(node: ASTNode, lookup: (cell: string) => CellValue): CellValue {
+  switch (node.type) {
+    case 'Number': return node.value;
+    case 'String': return node.value;
+    case 'Boolean': return node.value;
+    case 'CellRef': { const v = lookup(node.cell); return v === null ? 0 : v; }
+    case 'Range': throw new Error('Range cannot be used outside a function call');
+
+    case 'BinaryOp': {
+      const l = evalNode(node.left, lookup);
+      const r = evalNode(node.right, lookup);
+      return applyOp(node.op, l, r);
+    }
+
+    case 'UnaryOp': {
+      const v = evalNode(node.operand, lookup);
+      return node.op === '-' && typeof v === 'number' ? -v : v;
+    }
+
+    case 'FunctionCall': return callFunction(node.name, node.args, lookup);
+  }
+}
+
+function applyOp(op: string, l: CellValue, r: CellValue): CellValue {
+  switch (op) {
+    case '+':
+      if (typeof l === 'number' && typeof r === 'number') return l + r;
+      return String(l ?? '') + String(r ?? '');
+    case '-': return (l as number) - (r as number);
+    case '*': return (l as number) * (r as number);
+    case '/': {
+      if (r === 0) throw new Error('Division by zero');
+      return (l as number) / (r as number);
+    }
+    case '>': return (l as number) > (r as number);
+    case '<': return (l as number) < (r as number);
+    case '>=': return (l as number) >= (r as number);
+    case '<=': return (l as number) <= (r as number);
+    case '=': return l === r;
+    case '<>': return l !== r;
+    default: throw new Error(`Unknown operator: ${op}`);
+  }
+}
+
+function getRangeVals(node: ASTNode, lookup: (cell: string) => CellValue): CellValue[] {
+  if (node.type === 'Range') return expandRange(node.start, node.end).map(c => lookup(c));
+  return [evalNode(node, lookup)];
+}
+
+function callFunction(name: string, args: ASTNode[], lookup: (cell: string) => CellValue): CellValue {
+  switch (name) {
+    case 'SUM': {
+      const vals = getRangeVals(args[0], lookup);
+      return vals.reduce<number>((s, v) => s + (typeof v === 'number' ? v : 0), 0);
+    }
+    case 'AVERAGE': {
+      const nums = getRangeVals(args[0], lookup).filter((v): v is number => typeof v === 'number');
+      return nums.length === 0 ? 0 : nums.reduce((a, b) => a + b, 0) / nums.length;
+    }
+    case 'MIN': {
+      const nums = getRangeVals(args[0], lookup).filter((v): v is number => typeof v === 'number');
+      return nums.length === 0 ? 0 : Math.min(...nums);
+    }
+    case 'MAX': {
+      const nums = getRangeVals(args[0], lookup).filter((v): v is number => typeof v === 'number');
+      return nums.length === 0 ? 0 : Math.max(...nums);
+    }
+    case 'COUNT': {
+      return getRangeVals(args[0], lookup).filter(v => typeof v === 'number').length;
+    }
+    case 'IF': {
+      if (args.length !== 3) throw new Error('IF requires 3 arguments');
+      const cond = evalNode(args[0], lookup);
+      return evalNode(cond ? args[1] : args[2], lookup);
+    }
+    default: throw new Error(`Unknown function: ${name}`);
+  }
+}
+
+// ===== Spreadsheet =====
+
+export class Spreadsheet {
+  private cells = new Map<string, CellData>();
+  private revDeps = new Map<string, Set<string>>();
+
+  private getRevDeps(cell: string): Set<string> {
+    let s = this.revDeps.get(cell);
+    if (!s) { s = new Set(); this.revDeps.set(cell, s); }
+    return s;
+  }
+
+  set(cell: string, value: string | number | boolean): void {
+    cell = cell.toUpperCase();
+    if (!CELL_RE.test(cell)) throw new Error(`Invalid cell reference: ${cell}`);
+
+    let formula: string | null = null;
+    let deps = new Set<string>();
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      formula = value;
+      collectDeps(parseFormula(value.slice(1)), deps);
+    }
+
+    if (deps.size > 0) this.checkCircular(cell, deps);
+
+    const old = this.cells.get(cell);
+    if (old) {
+      for (const d of old.dependencies) this.getRevDeps(d).delete(cell);
+    }
+
+    this.cells.set(cell, { raw: value, computed: null, formula, dependencies: deps });
+
+    for (const d of deps) this.getRevDeps(d).add(cell);
+
+    this.recompute(cell);
+    for (const dep of this.topoOrder(cell)) this.recompute(dep);
+  }
+
+  private checkCircular(cell: string, deps: Set<string>): void {
+    const stack = [...deps];
+    const seen = new Set<string>();
+    while (stack.length > 0) {
+      const cur = stack.pop()!;
+      if (cur === cell) throw new Error(`Circular reference detected involving cell ${cell}`);
+      if (seen.has(cur)) continue;
+      seen.add(cur);
+      const d = this.cells.get(cur);
+      if (d) for (const dep of d.dependencies) stack.push(dep);
+    }
+  }
+
+  private recompute(cell: string): void {
+    const data = this.cells.get(cell);
+    if (!data) return;
+    if (!data.formula) { data.computed = data.raw; return; }
+    try {
+      data.computed = evalNode(parseFormula(data.formula.slice(1)), c => this.get(c));
+    } catch (e) {
+      data.computed = `#ERROR: ${(e as Error).message}`;
+    }
+  }
+
+  private topoOrder(startCell: string): string[] {
+    const affected = new Set<string>();
+    const queue = [...this.getRevDeps(startCell)];
+    for (let i = 0; i < queue.length; i++) {
+      const c = queue[i];
+      if (affected.has(c)) continue;
+      affected.add(c);
+      for (const dep of this.getRevDeps(c)) queue.push(dep);
+    }
+    if (affected.size === 0) return [];
+
+    const inDeg = new Map<string, number>();
+    for (const c of affected) {
+      let deg = 0;
+      for (const d of (this.cells.get(c)?.dependencies ?? new Set())) {
+        if (affected.has(d)) deg++;
+      }
+      inDeg.set(c, deg);
+    }
+
+    const ready = [...affected].filter(c => inDeg.get(c) === 0);
+    const result: string[] = [];
+    while (ready.length > 0) {
+      const c = ready.shift()!;
+      result.push(c);
+      for (const dep of this.getRevDeps(c)) {
+        if (!affected.has(dep)) continue;
+        const newDeg = (inDeg.get(dep) ?? 0) - 1;
+        inDeg.set(dep, newDeg);
+        if (newDeg === 0) ready.push(dep);
+      }
+    }
+    return result;
+  }
+
+  get(cell: string): CellValue {
+    return this.cells.get(cell.toUpperCase())?.computed ?? null;
+  }
+
+  getDisplay(cell: string): string {
+    const v = this.get(cell);
+    if (v === null) return '';
+    if (typeof v === 'boolean') return v ? 'TRUE' : 'FALSE';
+    return String(v);
+  }
+
+  getCells(): Map<string, CellValue> {
+    const result = new Map<string, CellValue>();
+    for (const [cell, data] of this.cells) {
+      if (data.computed !== null) result.set(cell, data.computed);
+    }
+    return result;
+  }
+}
