+
+interface CellData {
+  raw: string | number | boolean;
+  computed: CellValue;
+  formula: string | null;
+  dependencies: string[];
+}
+
+export class Spreadsheet {
+  private cells = new Map<string, CellData>();
+  private reverseDeps = new Map<string, Set<string>>();
+
+  set(cellRef: string, value: string | number | boolean): void {
+    const ref = cellRef.toUpperCase();
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      const formula = value.slice(1);
+
+      const { dependencies } = evaluateFormula(formula, () => null);
+      this.checkCircular(ref, dependencies);
+      this.removeReverseDeps(ref);
+
+      const computed = this.evalFormula(formula);
+      this.cells.set(ref, { raw: value, computed, formula, dependencies });
+
+      for (const dep of dependencies) {
+        if (!this.reverseDeps.has(dep)) this.reverseDeps.set(dep, new Set());
+        this.reverseDeps.get(dep)!.add(ref);
+      }
+    } else {
+      this.removeReverseDeps(ref);
+      this.cells.set(ref, { raw: value, computed: value, formula: null, dependencies: [] });
+    }
+
+    this.propagate(ref);
+  }
+
+  get(cellRef: string): CellValue {
+    return this.cells.get(cellRef.toUpperCase())?.computed ?? null;
+  }
+
+  getDisplay(cellRef: string): string {
+    const val = this.get(cellRef);
+    if (val === null) return '';
+    if (typeof val === 'boolean') return val ? 'TRUE' : 'FALSE';
+    return String(val);
+  }
+
+  getCells(): Map<string, CellValue> {
+    const result = new Map<string, CellValue>();
+    for (const [ref, cell] of this.cells) {
+      result.set(ref, cell.computed);
+    }
+    return result;
+  }
+
+  private evalFormula(formula: string): CellValue {
+    try {
+      const { value } = evaluateFormula(formula, ref => this.get(ref));
+      return value;
+    } catch {
+      return null;
+    }
+  }
+
+  private removeReverseDeps(ref: string): void {
+    const cell = this.cells.get(ref);
+    if (!cell) return;
+    for (const dep of cell.dependencies) {
+      this.reverseDeps.get(dep)?.delete(ref);
+    }
+  }
+
+  private checkCircular(ref: string, deps: string[]): void {
+    const visited = new Set<string>();
+
+    const canReach = (from: string): boolean => {
+      if (from === ref) return true;
+      if (visited.has(from)) return false;
+      visited.add(from);
+      const cell = this.cells.get(from);
+      if (!cell) return false;
+      for (const dep of cell.dependencies) {
+        if (canReach(dep)) return true;
+      }
+      return false;
+    };
+
+    for (const dep of deps) {
+      if (canReach(dep)) throw new Error(`Circular reference detected: ${ref}`);
+    }
+  }
+
+  private propagate(ref: string): void {
+    for (const cellRef of this.topologicalDependents(ref)) {
+      const cell = this.cells.get(cellRef);
+      if (cell?.formula !== null && cell?.formula !== undefined) {
+        cell.computed = this.evalFormula(cell.formula);
+      }
+    }
+  }
+
+  private topologicalDependents(start: string): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>();
+
+    const dfs = (ref: string): void => {
+      const deps = this.reverseDeps.get(ref);
+      if (!deps) return;
+      for (const dep of deps) {
+        if (!visited.has(dep)) {
+          visited.add(dep);
+          dfs(dep);
+          result.push(dep);
+        }
+      }
+    };
+
+    dfs(start);
+    return result.reverse();
+  }
+}
