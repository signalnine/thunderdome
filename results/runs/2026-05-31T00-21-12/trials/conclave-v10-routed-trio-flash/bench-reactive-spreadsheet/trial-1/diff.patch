diff --git a/src/cellRef.ts b/src/cellRef.ts
new file mode 100644
index 0000000..f113d37
--- /dev/null
+++ b/src/cellRef.ts
@@ -0,0 +1,36 @@
+export function colToIndex(col: string): number {
+  let result = 0;
+  for (const ch of col) {
+    result = result * 26 + (ch.charCodeAt(0) - 64);
+  }
+  return result;
+}
+
+export function indexToCol(idx: number): string {
+  let result = '';
+  while (idx > 0) {
+    idx--;
+    result = String.fromCharCode(65 + (idx % 26)) + result;
+    idx = Math.floor(idx / 26);
+  }
+  return result;
+}
+
+export function expandRange(start: string, end: string): string[] {
+  const sMatch = start.match(/^([A-Z]+)(\d+)$/);
+  const eMatch = end.match(/^([A-Z]+)(\d+)$/);
+  if (!sMatch || !eMatch) throw new Error(`Invalid range: ${start}:${end}`);
+
+  const startCol = colToIndex(sMatch[1]);
+  const endCol = colToIndex(eMatch[1]);
+  const startRow = parseInt(sMatch[2], 10);
+  const endRow = parseInt(eMatch[2], 10);
+
+  const cells: string[] = [];
+  for (let c = startCol; c <= endCol; c++) {
+    for (let r = startRow; r <= endRow; r++) {
+      cells.push(`${indexToCol(c)}${r}`);
+    }
+  }
+  return cells;
+}
diff --git a/src/formula.ts b/src/formula.ts
new file mode 100644
index 0000000..38180a7
--- /dev/null
+++ b/src/formula.ts
@@ -0,0 +1,238 @@
+import { expandRange } from './cellRef.js';
+
+export type CellValue = string | number | boolean | null;
+export type CellResolver = (ref: string) => CellValue;
+
+type TokenType =
+  | 'NUMBER' | 'STRING' | 'BOOL' | 'CELL_REF' | 'IDENT'
+  | 'PLUS' | 'MINUS' | 'STAR' | 'SLASH'
+  | 'GT' | 'LT' | 'GTE' | 'LTE' | 'EQ' | 'NEQ'
+  | 'LPAREN' | 'RPAREN' | 'COMMA' | 'COLON'
+  | 'EOF';
+
+interface Token {
+  type: TokenType;
+  value?: string | number | boolean;
+}
+
+function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+
+  while (i < input.length) {
+    if (/\s/.test(input[i])) { i++; continue; }
+
+    if (input[i] === '"') {
+      let str = '';
+      i++;
+      while (i < input.length && input[i] !== '"') str += input[i++];
+      i++;
+      tokens.push({ type: 'STRING', value: str });
+      continue;
+    }
+
+    if (/[0-9]/.test(input[i]) || (input[i] === '.' && /[0-9]/.test(input[i + 1] ?? ''))) {
+      let num = '';
+      while (i < input.length && /[0-9.]/.test(input[i])) num += input[i++];
+      tokens.push({ type: 'NUMBER', value: parseFloat(num) });
+      continue;
+    }
+
+    if (i + 1 < input.length) {
+      const two = input[i] + input[i + 1];
+      if (two === '<>') { tokens.push({ type: 'NEQ' }); i += 2; continue; }
+      if (two === '>=') { tokens.push({ type: 'GTE' }); i += 2; continue; }
+      if (two === '<=') { tokens.push({ type: 'LTE' }); i += 2; continue; }
+    }
+
+    switch (input[i]) {
+      case '+': tokens.push({ type: 'PLUS' });   i++; continue;
+      case '-': tokens.push({ type: 'MINUS' });  i++; continue;
+      case '*': tokens.push({ type: 'STAR' });   i++; continue;
+      case '/': tokens.push({ type: 'SLASH' });  i++; continue;
+      case '>': tokens.push({ type: 'GT' });     i++; continue;
+      case '<': tokens.push({ type: 'LT' });     i++; continue;
+      case '=': tokens.push({ type: 'EQ' });     i++; continue;
+      case '(': tokens.push({ type: 'LPAREN' }); i++; continue;
+      case ')': tokens.push({ type: 'RPAREN' }); i++; continue;
+      case ',': tokens.push({ type: 'COMMA' });  i++; continue;
+      case ':': tokens.push({ type: 'COLON' });  i++; continue;
+    }
+
+    if (/[A-Za-z]/.test(input[i])) {
+      let ident = '';
+      while (i < input.length && /[A-Za-z]/.test(input[i])) ident += input[i++].toUpperCase();
+
+      if (i < input.length && /[0-9]/.test(input[i])) {
+        let row = '';
+        while (i < input.length && /[0-9]/.test(input[i])) row += input[i++];
+        tokens.push({ type: 'CELL_REF', value: ident + row });
+      } else if (ident === 'TRUE') {
+        tokens.push({ type: 'BOOL', value: true });
+      } else if (ident === 'FALSE') {
+        tokens.push({ type: 'BOOL', value: false });
+      } else {
+        tokens.push({ type: 'IDENT', value: ident });
+      }
+      continue;
+    }
+
+    throw new Error(`Unexpected character '${input[i]}' in formula`);
+  }
+
+  tokens.push({ type: 'EOF' });
+  return tokens;
+}
+
+const AGGREGATE_FNS = new Set(['SUM', 'AVERAGE', 'MIN', 'MAX', 'COUNT']);
+
+class FormulaParser {
+  private pos = 0;
+  readonly dependencies = new Set<string>();
+
+  constructor(
+    private readonly tokens: Token[],
+    private readonly resolver: CellResolver,
+  ) {}
+
+  private peek(): Token { return this.tokens[this.pos]; }
+  private advance(): Token { return this.tokens[this.pos++]; }
+
+  private expect(type: TokenType): Token {
+    const tok = this.advance();
+    if (tok.type !== type) throw new Error(`Expected ${type} but got ${tok.type}`);
+    return tok;
+  }
+
+  parseExpression(): CellValue {
+    const left = this.parseAdditive();
+    const tok = this.peek();
+
+    if (tok.type === 'GT' || tok.type === 'LT' || tok.type === 'GTE' ||
+        tok.type === 'LTE' || tok.type === 'EQ' || tok.type === 'NEQ') {
+      this.advance();
+      const right = this.parseAdditive();
+      switch (tok.type) {
+        case 'GT':  return (left as number) > (right as number);
+        case 'LT':  return (left as number) < (right as number);
+        case 'GTE': return (left as number) >= (right as number);
+        case 'LTE': return (left as number) <= (right as number);
+        case 'EQ':  return left === right;
+        case 'NEQ': return left !== right;
+      }
+    }
+
+    return left;
+  }
+
+  private parseAdditive(): CellValue {
+    let left = this.parseMultiplicative();
+    while (this.peek().type === 'PLUS' || this.peek().type === 'MINUS') {
+      const op = this.advance();
+      const right = this.parseMultiplicative();
+      left = op.type === 'PLUS'
+        ? (left as number) + (right as number)
+        : (left as number) - (right as number);
+    }
+    return left;
+  }
+
+  private parseMultiplicative(): CellValue {
+    let left = this.parseUnary();
+    while (this.peek().type === 'STAR' || this.peek().type === 'SLASH') {
+      const op = this.advance();
+      const right = this.parseUnary();
+      left = op.type === 'STAR'
+        ? (left as number) * (right as number)
+        : (left as number) / (right as number);
+    }
+    return left;
+  }
+
+  private parseUnary(): CellValue {
+    if (this.peek().type === 'MINUS') {
+      this.advance();
+      return -(this.parseUnary() as number);
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): CellValue {
+    const tok = this.peek();
+
+    switch (tok.type) {
+      case 'NUMBER': this.advance(); return tok.value as number;
+      case 'STRING': this.advance(); return tok.value as string;
+      case 'BOOL':   this.advance(); return tok.value as boolean;
+
+      case 'CELL_REF': {
+        this.advance();
+        const ref = tok.value as string;
+        this.dependencies.add(ref);
+        return this.resolver(ref);
+      }
+
+      case 'IDENT': return this.parseFunctionCall();
+
+      case 'LPAREN': {
+        this.advance();
+        const val = this.parseExpression();
+        this.expect('RPAREN');
+        return val;
+      }
+
+      default:
+        throw new Error(`Unexpected token: ${tok.type}`);
+    }
+  }
+
+  private parseFunctionCall(): CellValue {
+    const name = (this.advance().value as string).toUpperCase();
+    this.expect('LPAREN');
+
+    if (AGGREGATE_FNS.has(name)) {
+      const startRef = (this.expect('CELL_REF').value as string);
+      this.expect('COLON');
+      const endRef = (this.expect('CELL_REF').value as string);
+
+      const cells = expandRange(startRef, endRef);
+      cells.forEach(c => this.dependencies.add(c));
+
+      const nums = cells
+        .map(c => this.resolver(c))
+        .filter((v): v is number => typeof v === 'number');
+
+      this.expect('RPAREN');
+
+      switch (name) {
+        case 'SUM':     return nums.reduce((a, b) => a + b, 0);
+        case 'AVERAGE': return nums.length > 0 ? nums.reduce((a, b) => a + b, 0) / nums.length : 0;
+        case 'MIN':     return nums.length > 0 ? Math.min(...nums) : 0;
+        case 'MAX':     return nums.length > 0 ? Math.max(...nums) : 0;
+        case 'COUNT':   return nums.length;
+      }
+    }
+
+    if (name === 'IF') {
+      const condition = this.parseExpression();
+      this.expect('COMMA');
+      const trueVal = this.parseExpression();
+      this.expect('COMMA');
+      const falseVal = this.parseExpression();
+      this.expect('RPAREN');
+      return condition ? trueVal : falseVal;
+    }
+
+    throw new Error(`Unknown function: ${name}`);
+  }
+}
+
+export function evaluateFormula(
+  formula: string,
+  resolver: CellResolver,
+): { value: CellValue; dependencies: string[] } {
+  const tokens = tokenize(formula);
+  const parser = new FormulaParser(tokens, resolver);
+  const value = parser.parseExpression();
+  return { value, dependencies: [...parser.dependencies] };
+}
