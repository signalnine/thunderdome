+import type { Conflict } from './types.js';
+
+function deepClone<T>(value: T): T {
+  return JSON.parse(JSON.stringify(value));
+}
+
+/** Flatten a nested object to dot-separated paths -> leaf values */
+function flatten(obj: object, prefix = ''): Record<string, any> {
+  const result: Record<string, any> = {};
+  for (const [key, value] of Object.entries(obj)) {
+    const path = prefix ? `${prefix}.${key}` : key;
+    if (value !== null && typeof value === 'object' && !Array.isArray(value)) {
+      Object.assign(result, flatten(value as object, path));
+    } else {
+      result[path] = value;
+    }
+  }
+  return result;
+}
+
+/** Set a value at a dot-separated path in a nested object */
+function setPath(obj: Record<string, any>, path: string, value: any): void {
+  const parts = path.split('.');
+  let cur = obj;
+  for (let i = 0; i < parts.length - 1; i++) {
+    if (cur[parts[i]] === undefined || typeof cur[parts[i]] !== 'object') {
+      cur[parts[i]] = {};
+    }
+    cur = cur[parts[i]];
+  }
+  cur[parts[parts.length - 1]] = value;
+}
+
+/** Delete a leaf at a dot-separated path; prune empty ancestor objects */
+function deletePath(obj: Record<string, any>, path: string): void {
+  const parts = path.split('.');
+  const ancestors: [Record<string, any>, string][] = [];
+  let cur = obj;
+  for (let i = 0; i < parts.length - 1; i++) {
+    if (cur[parts[i]] === undefined) return;
+    ancestors.push([cur, parts[i]]);
+    cur = cur[parts[i]];
+  }
+  delete cur[parts[parts.length - 1]];
+  // Prune empty parent objects
+  for (let i = ancestors.length - 1; i >= 0; i--) {
+    const [parent, key] = ancestors[i];
+    if (typeof parent[key] === 'object' && Object.keys(parent[key]).length === 0) {
+      delete parent[key];
+    } else {
+      break;
+    }
+  }
+}
+
+export interface ThreeWayResult {
+  merged: object;
+  conflicts: Omit<Conflict, 'documentId'>[];
+}
+
+/**
+ * Three-way merge for a single document.
+ * base: common ancestor, ours: current branch, theirs: source branch.
+ * Returns the merged document and any conflicts.
+ * Conflicts are resolved in favor of "ours" for the `merged` output.
+ */
+export function threeWayMerge(
+  documentId: string,
+  base: object | null,
+  ours: object | null,
+  theirs: object | null,
+): { merged: object | null; conflicts: Conflict[] } {
+  // Document deleted on both sides — already gone
+  if (ours === null && theirs === null) {
+    return { merged: null, conflicts: [] };
+  }
+
+  // Document deleted on theirs
+  if (theirs === null) {
+    if (base === null) {
+      // Ours added a new doc, theirs didn't — keep ours (no conflict)
+      return { merged: deepClone(ours!), conflicts: [] };
+    }
+    // Only theirs changed (ours == base) → accept deletion
+    if (JSON.stringify(ours) === JSON.stringify(base)) {
+      return { merged: null, conflicts: [] };
+    }
+    // Ours changed and theirs deleted → conflict on every modified field
+    const baseFlat = flatten(base);
+    const oursFlat = flatten(ours!);
+    const allPaths = new Set([...Object.keys(baseFlat), ...Object.keys(oursFlat)]);
+    const conflicts: Conflict[] = [];
+    for (const path of allPaths) {
+      const bv = baseFlat[path];
+      const ov = oursFlat[path];
+      if (JSON.stringify(ov) !== JSON.stringify(bv)) {
+        conflicts.push({ documentId, path, base: bv, ours: ov, theirs: undefined });
+      }
+    }
+    return { merged: deepClone(ours!), conflicts };
+  }
+
+  // Document deleted on ours
+  if (ours === null) {
+    if (base === null) {
+      // Theirs added a new doc, ours didn't — take theirs (no conflict)
+      return { merged: deepClone(theirs), conflicts: [] };
+    }
+    // Only ours changed (theirs == base) → accept deletion
+    if (JSON.stringify(theirs) === JSON.stringify(base)) {
+      return { merged: null, conflicts: [] };
+    }
+    // Theirs changed and ours deleted → conflict on every modified field
+    const baseFlat = flatten(base);
+    const theirsFlat = flatten(theirs);
+    const allPaths = new Set([...Object.keys(baseFlat), ...Object.keys(theirsFlat)]);
+    const conflicts: Conflict[] = [];
+    for (const path of allPaths) {
+      const bv = baseFlat[path];
+      const tv = theirsFlat[path];
+      if (JSON.stringify(tv) !== JSON.stringify(bv)) {
+        conflicts.push({ documentId, path, base: bv, ours: undefined, theirs: tv });
+      }
+    }
+    return { merged: null, conflicts }; // ours (deletion) wins in preview
+  }
+
+  const baseFlat = base ? flatten(base) : {};
+  const oursFlat = flatten(ours);
+  const theirsFlat = flatten(theirs);
+
+  const allPaths = new Set([
+    ...Object.keys(baseFlat),
+    ...Object.keys(oursFlat),
+    ...Object.keys(theirsFlat),
+  ]);
+
+  const mergedFlat: Record<string, any> = { ...deepClone(oursFlat) };
+  const conflicts: Conflict[] = [];
+  const deletedPaths = new Set<string>();
+
+  for (const path of allPaths) {
+    const baseVal = baseFlat[path];
+    const ourVal = oursFlat[path];
+    const theirVal = theirsFlat[path];
+
+    const oursChanged = JSON.stringify(ourVal) !== JSON.stringify(baseVal);
+    const theirsChanged = JSON.stringify(theirVal) !== JSON.stringify(baseVal);
+
+    if (!oursChanged && !theirsChanged) {
+      // Both unchanged — keep base value (already in mergedFlat via ours)
+      continue;
+    }
+
+    if (oursChanged && !theirsChanged) {
+      // Only ours changed — already in mergedFlat
+      if (ourVal === undefined) deletedPaths.add(path);
+      continue;
+    }
+
+    if (!oursChanged && theirsChanged) {
+      // Only theirs changed — take theirs
+      if (theirVal === undefined) {
+        delete mergedFlat[path];
+        deletedPaths.add(path);
+      } else {
+        mergedFlat[path] = theirVal;
+      }
+      continue;
+    }
+
+    // Both changed
+    if (JSON.stringify(ourVal) === JSON.stringify(theirVal)) {
+      // Same value on both sides — no conflict
+      if (ourVal === undefined) deletedPaths.add(path);
+      continue;
+    }
+
+    // Real conflict — record it, keep ours in merged
+    conflicts.push({
+      documentId,
+      path,
+      base: baseVal,
+      ours: ourVal,
+      theirs: theirVal,
+    });
+  }
+
+  // Reconstruct nested object from flat map
+  const mergedObj: Record<string, any> = {};
+  for (const [path, value] of Object.entries(mergedFlat)) {
+    if (!deletedPaths.has(path)) {
+      setPath(mergedObj, path, value);
+    }
+  }
+
+  return { merged: mergedObj, conflicts };
+}
