+{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01SfUrckXHfUWYsUD7LnwTop","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YSFfH7QrumVdTJWRRPh1Yr","name":"Write","input":{"file_path":"/workspace/src/index.test.ts","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { createDocumentStore } from './index.js';\nimport type { DocumentStore } from './index.js';\n\nlet store: DocumentStore;\n\nbeforeEach(() => {\n  store = createDocumentStore();\n});\n\n// ---- CRUD ----\n\ndescribe('create', () => {\n  it('creates a document and retrieves it', () => {\n    store.create('doc1', { name: 'Alice', age: 30 });\n    expect(store.get('doc1')).toEqual({ name: 'Alice', age: 30 });\n  });\n\n  it('throws if document already exists', () => {\n    store.create('doc1', { a: 1 });\n    expect(() => store.create('doc1', { b: 2 })).toThrow();\n  });\n\n  it('deep clones on storage (mutation does not affect store)', () => {\n    const content = { x: { y: 1 } };\n    store.create('doc1', content);\n    (content as any).x.y = 999;\n    expect((store.get('doc1') as any).x.y).toBe(1);\n  });\n});\n\ndescribe('get', () => {\n  it('throws for a non-existent document', () => {\n    expect(() => store.get('missing')).toThrow();\n  });\n\n  it('throws for a deleted document', () => {\n    store.create('doc1', { a: 1 });\n    store.delete('doc1');\n    expect(() => store.get('doc1')).toThrow();\n  });\n\n  it('deep clones on retrieval (mutation does not affect store)', () => {\n    store.create('doc1', { x: { y: 1 } });\n    const result = store.get('doc1') as any;\n    result.x.y = 999;\n    expect((store.get('doc1') as any).x.y).toBe(1);\n  });\n});\n\ndescribe('update', () => {\n  it('replaces document content', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', { b: 2 });\n    expect(store.get('doc1')).toEqual({ b: 2 });\n  });\n\n  it('throws for a non-existent document', () => {\n    expect(() => store.update('missing', { a: 1 })).toThrow();\n  });\n\n  it('creates a new version on each update', () => {\n    store.create('doc1', { v: 1 });\n    store.update('doc1', { v: 2 });\n    expect(store.getHistory('doc1')).toHaveLength(2);\n  });\n});\n\ndescribe('delete', () => {\n  it('removes the document from the current branch', () => {\n    store.create('doc1', { a: 1 });\n    store.delete('doc1');\n    expect(() => store.get('doc1')).toThrow();\n  });\n\n  it('throws for a non-existent document', () => {\n    expect(() => store.delete('missing')).toThrow();\n  });\n\n  it('allows re-creation after deletion', () => {\n    store.create('doc1', { a: 1 });\n    store.delete('doc1');\n    store.create('doc1', { a: 2 });\n    expect(store.get('doc1')).toEqual({ a: 2 });\n  });\n});\n\n// ---- Version History ----\n\ndescribe('getHistory', () => {\n  it('returns versions in chronological order', () => {\n    store.create('doc1', { v: 1 });\n    store.update('doc1', { v: 2 });\n    store.update('doc1', { v: 3 });\n    const history = store.getHistory('doc1');\n    expect(history).toHaveLength(3);\n    expect((history[0].content as any).v).toBe(1);\n    expect((history[1].content as any).v).toBe(2);\n    expect((history[2].content as any).v).toBe(3);\n  });\n\n  it('each version has a unique id and a timestamp', () => {\n    store.create('doc1', { v: 1 });\n    store.update('doc1', { v: 2 });\n    const [v1, v2] = store.getHistory('doc1');\n    expect(v1.id).toBeTruthy();\n    expect(v2.id).toBeTruthy();\n    expect(v1.id).not.toBe(v2.id);\n    expect(typeof v1.timestamp).toBe('number');\n  });\n\n  it('throws for non-existent document', () => {\n    expect(() => store.getHistory('missing')).toThrow();\n  });\n});\n\ndescribe('getVersion', () => {\n  it('returns content at a specific version', () => {\n    store.create('doc1', { v: 1 });\n    store.update('doc1', { v: 2 });\n    const [v1] = store.getHistory('doc1');\n    expect(store.getVersion('doc1', v1.id)).toEqual({ v: 1 });\n  });\n\n  it('throws for unknown versionId', () => {\n    store.create('doc1', { v: 1 });\n    expect(() => store.getVersion('doc1', 'nonexistent')).toThrow();\n  });\n});\n\n// ---- Branching ----\n\ndescribe('branching', () => {\n  it('default branch is main', () => {\n    expect(store.getBranch()).toBe('main');\n  });\n\n  it('listBranches returns all branches', () => {\n    store.createBranch('feature');\n    expect(store.listBranches()).toContain('main');\n    expect(store.listBranches()).toContain('feature');\n  });\n\n  it('switchBranch changes the active branch', () => {\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    expect(store.getBranch()).toBe('feature');\n  });\n\n  it('changes on one branch are not visible on another', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 99 });\n\n    store.switchBranch('main');\n    expect(store.get('doc1')).toEqual({ a: 1 });\n  });\n\n  it('documents created on a branch are not visible on main', () => {\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.create('doc2', { x: 1 });\n\n    store.switchBranch('main');\n    expect(() => store.get('doc2')).toThrow();\n  });\n\n  it('throws when switching to non-existent branch', () => {\n    expect(() => store.switchBranch('nonexistent')).toThrow();\n  });\n\n  it('throws when creating a duplicate branch', () => {\n    store.createBranch('feature');\n    expect(() => store.createBranch('feature')).toThrow();\n  });\n\n  it('createBranch with fromBranch parameter branches from specified branch', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 2 });\n\n    // Branch from feature while on feature\n    store.createBranch('hotfix', 'feature');\n    store.switchBranch('hotfix');\n    expect(store.get('doc1')).t