versionId}' not found for document '${id}'`);\n    }\n    return deepClone(version.content);\n  }\n\n  // ---- Branching ----\n\n  createBranch(name: string, fromBranch?: string): void {\n    if (this.branches.has(name)) {\n      throw new Error(`Branch '${name}' already exists`);\n    }\n    const sourceName = fromBranch ?? this.currentBranch;\n    const source = this.branches.get(sourceName);\n    if (!source) {\n      throw new Error(`Branch '${sourceName}' does not exist`);\n    }\n\n    // Deep-copy all documents from source into the new branch\n    const newDocs: Map<string, DocEntry> = new Map();\n    const baseSnapshot: Map<string, string | null> = new Map();\n\n    for (const [docId, entry] of source.docs) {\n      const copiedVersions = entry.versions.map((v) => ({ ...v, content: deepClone(v.content) }));\n      newDocs.set(docId, { versions: copiedVersions, deleted: entry.deleted });\n      // Record the tip version at fork time (null if deleted at fork)\n      if (!entry.deleted && copiedVersions.length > 0) {\n        baseSnapshot.set(docId, copiedVersions[copiedVersions.length - 1].id);\n      } else {\n        baseSnapshot.set(docId, null);\n      }\n    }\n\n    this.branches.set(name, {\n      docs: newDocs,\n      baseSnapshot,\n      parentBranch: sourceName,\n    });\n  }\n\n  switchBranch(name: string): void {\n    if (!this.branches.has(name)) {\n      throw new Error(`Branch '${name}' does not exist`);\n    }\n    this.currentBranch = name;\n  }\n\n  getBranch(): string {\n    return this.currentBranch;\n  }\n\n  listBranches(): string[] {\n    return Array.from(this.branches.keys());\n  }\n\n  // ---- Merging ----\n\n  merge(sourceBranch: string): MergeResult {\n    if (!this.branches.has(sourceBranch)) {\n      throw new Error(`Branch '${sourceBranch}' does not exist`);\n    }\n    if (sourceBranch === this.currentBranch) {\n      throw new Error(`Cannot merge a branch into itself`);\n    }\n\n    const ourBranch = this.branch();\n    const theirBranch = this.branches.get(sourceBranch)!;\n\n    // Collect all document IDs across both branches\n    const allDocIds = new Set([\n      ...ourBranch.docs.keys(),\n      ...theirBranch.docs.keys(),\n    ]);\n\n    const mergedDocs: Record<string, object> = {};\n    const allConflicts: Conflict[] = [];\n\n    for (const docId of allDocIds) {\n      const ourEntry = ourBranch.docs.get(docId);\n      const theirEntry = theirBranch.docs.get(docId);\n\n      // Resolve base content: find the common ancestor version\n      // The base snapshot is stored on the source branch (recorded at fork from our branch)\n      // Also check our branch's snapshot for documents forked from the source\n      const baseContent = this.resolveBase(docId, ourBranch, theirBranch);\n\n      const ourContent =\n        ourEntry && !ourEntry.deleted\n          ? ourEntry.versions[ourEntry.versions.length - 1].content\n          : null;\n      const theirContent =\n        theirEntry && !theirEntry.deleted\n          ? theirEntry.versions[theirEntry.versions.length - 1].content\n          : null;\n\n      const { merged, conflicts } = threeWayMerge(docId, baseContent, ourContent, theirContent);\n\n      allConflicts.push(...conflicts);\n\n      if (merged !== null) {\n        mergedDocs[docId] = deepClone(merged);\n      }\n    }\n\n    const applied = allConflicts.length === 0;\n\n    if (applied) {\n      // Apply the merge: update our branch with merged results\n      for (const docId of allDocIds) {\n        const mergedContent = mergedDocs[docId];\n        const ourEntry = ourBranch.docs.get(docId);\n        const theirEntry = theirBranch.docs.get(docId);\n\n        if (mergedContent === undefined) {\n          // Document should be deleted\n          if (ourEntry && !ourEntry.deleted) {\n            ourEntry.deleted = true;\n          }\n        } else if (!ourEntry || ourEntry.deleted) {\n          // New document from theirs\n          const version: Version = {\n            id: makeVersionId(),\n            timestamp: Date.now(),\n            content: deepClone(mergedContent),\n          };\n          ourBranch.docs.set(docId, { versions: [version], deleted: false });\n        } else {\n          // Check if our content actually changed\n          const ourCurrent = ourEntry.versions[ourEntry.versions.length - 1].content;\n          if (JSON.stringify(ourCurrent) !== JSON.stringify(mergedContent)) {\n            const version: Version = {\n              id: makeVersionId(),\n              timestamp: Date.now(),\n              content: deepClone(mergedContent),\n            };\n            ourEntry.versions.push(version);\n          }\n        }\n      }\n    }\n\n    return {\n      merged: mergedDocs,\n      conflicts: allConflicts,\n      applied,\n    };\n  }\n\n  /**\n   * Determine the base (common ancestor) content for a document during a merge.\n   * Strategy: look at the branch's baseSnapshot to find what the document looked like\n   * at fork time. The base is the lower of the two snapshots (i.e., the content when\n   * they last shared state).\n   */\n  private resolveBase(\n    docId: string,\n    ourBranch: BranchState,\n    theirBranch: BranchState,\n  ): object | null {\n    // Prefer the snapshot recorded on the source branch (theirs), since it was forked\n    // from somewhere and records what the doc looked like at fork time.\n    // If theirs has a snapshot for this doc, find that version in theirs's history.\n    if (theirBranch.baseSnapshot.has(docId)) {\n      const snapVersionId = theirBranch.baseSnapshot.get(docId);\n      if (snapVersionId === null) {\n        // Doc didn't exist when theirs was forked\n        return null;\n      }\n      // Find this version in their history (it was copied from the common ancestor)\n      const theirEntry = theirBranch.docs.get(docId);\n      if (theirEntry) {\n        const baseVersion = theirEntry.versions.find((v) => v.id === snapVersionId);\n        if (baseVersion) {\n          return deepClone(baseVersion.content);\n        }\n      }\n      // Fall through: find in our history\n      const ourEntry = ourBranch.docs.get(docId);\n      if (ourEntry) {\n        const baseVersion = ourEntry.versions.find((v) => v.id === snapVersionId);\n        if (baseVersion) {\n          return deepClone(baseVersion.content);\n        }\n      }\n    }\n\n    // Check our branch's snapshot for this doc (in case ours was forked from theirs)\n    if (ourBranch.baseSnapshot.has(docId)) {\n      const snapVersionId = ourBranch.baseSnapshot.get(docId);\n      if (snapVersionId === null) return null;\n      const ourEntry = ourBranch.docs.get(docId);\n      if (ourEntry) {\n        const baseVersion = ourEntry.versions.find((v) => v.id === snapVersionId);\n        if (baseVersion) return deepClone(baseVersion.content);\n      }\n    }\n\n    // No snapshot — treat as no common ancestor (new doc on one side)\n    return null;\n  }\n}\n\nexport function createDocumentStore(): DocumentStore {\n  return new DocumentStoreImpl();\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
