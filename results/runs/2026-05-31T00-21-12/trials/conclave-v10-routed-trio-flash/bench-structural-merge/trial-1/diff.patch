+import { describe, it, expect, beforeEach } from 'vitest';
+import { DocumentStore } from './index.js';
+
+describe('DocumentStore - CRUD', () => {
+  let store: DocumentStore;
+  beforeEach(() => { store = new DocumentStore(); });
+
+  it('creates and gets a document', () => {
+    store.create('doc1', { a: 1 });
+    expect(store.get('doc1')).toEqual({ a: 1 });
+  });
+
+  it('throws on duplicate create', () => {
+    store.create('doc1', { a: 1 });
+    expect(() => store.create('doc1', { a: 2 })).toThrow();
+  });
+
+  it('throws get on missing document', () => {
+    expect(() => store.get('nope')).toThrow();
+  });
+
+  it('updates document', () => {
+    store.create('doc1', { a: 1 });
+    store.update('doc1', { a: 2 });
+    expect(store.get('doc1')).toEqual({ a: 2 });
+  });
+
+  it('throws update on missing document', () => {
+    expect(() => store.update('nope', { a: 1 })).toThrow();
+  });
+
+  it('deletes document', () => {
+    store.create('doc1', { a: 1 });
+    store.delete('doc1');
+    expect(() => store.get('doc1')).toThrow();
+  });
+
+  it('throws delete on missing document', () => {
+    expect(() => store.delete('nope')).toThrow();
+  });
+
+  it('deep clones on get (no mutation)', () => {
+    store.create('doc1', { a: { b: 1 } });
+    const got = store.get('doc1') as any;
+    got.a.b = 99;
+    expect((store.get('doc1') as any).a.b).toBe(1);
+  });
+});
+
+describe('DocumentStore - Version History', () => {
+  let store: DocumentStore;
+  beforeEach(() => { store = new DocumentStore(); });
+
+  it('create generates a version', () => {
+    store.create('doc1', { a: 1 });
+    const history = store.getHistory('doc1');
+    expect(history).toHaveLength(1);
+    expect(history[0].content).toEqual({ a: 1 });
+  });
+
+  it('update appends version', () => {
+    store.create('doc1', { a: 1 });
+    store.update('doc1', { a: 2 });
+    const history = store.getHistory('doc1');
+    expect(history).toHaveLength(2);
+    expect(history[0].content).toEqual({ a: 1 });
+    expect(history[1].content).toEqual({ a: 2 });
+  });
+
+  it('versions have unique ids', () => {
+    store.create('doc1', { a: 1 });
+    store.update('doc1', { a: 2 });
+    const history = store.getHistory('doc1');
+    expect(history[0].id).not.toBe(history[1].id);
+  });
+
+  it('getVersion returns correct content', () => {
+    store.create('doc1', { a: 1 });
+    store.update('doc1', { a: 2 });
+    const history = store.getHistory('doc1');
+    expect(store.getVersion('doc1', history[0].id)).toEqual({ a: 1 });
+    expect(store.getVersion('doc1', history[1].id)).toEqual({ a: 2 });
+  });
+
+  it('getVersion throws on unknown version', () => {
+    store.create('doc1', { a: 1 });
+    expect(() => store.getVersion('doc1', 'bad-version')).toThrow();
+  });
+});
+
+describe('DocumentStore - Branching', () => {
+  let store: DocumentStore;
+  beforeEach(() => { store = new DocumentStore(); });
+
+  it('default branch is main', () => {
+    expect(store.getBranch()).toBe('main');
+  });
+
+  it('createBranch and listBranches', () => {
+    store.createBranch('feature');
+    expect(store.listBranches()).toContain('main');
+    expect(store.listBranches()).toContain('feature');
+  });
+
+  it('switchBranch changes active branch', () => {
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    expect(store.getBranch()).toBe('feature');
+  });
+
+  it('branches are isolated', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 2 });
+    expect(store.get('doc1')).toEqual({ a: 2 });
+    store.switchBranch('main');
+    expect(store.get('doc1')).toEqual({ a: 1 });
+  });
+
+  it('new doc on branch not visible on main', () => {
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.create('doc2', { x: 99 });
+    store.switchBranch('main');
+    expect(() => store.get('doc2')).toThrow();
+  });
+
+  it('createBranch from named branch', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature', 'main');
+    store.switchBranch('feature');
+    expect(store.get('doc1')).toEqual({ a: 1 });
+  });
+
+  it('throws switchBranch on unknown branch', () => {
+    expect(() => store.switchBranch('nope')).toThrow();
+  });
+
+  it('throws createBranch if name exists', () => {
+    store.createBranch('feature');
+    expect(() => store.createBranch('feature')).toThrow();
+  });
+});
+
+describe('DocumentStore - Merging', () => {
+  let store: DocumentStore;
+  beforeEach(() => { store = new DocumentStore(); });
+
+  it('merges non-conflicting field changes', () => {
+    store.create('doc1', { a: 1, b: 2 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 99, b: 2 }); // change a
+    store.switchBranch('main');
+    store.update('doc1', { a: 1, b: 77 }); // change b
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toHaveLength(0);
+    expect(result.merged['doc1']).toEqual({ a: 99, b: 77 });
+    expect(store.get('doc1')).toEqual({ a: 99, b: 77 });
+  });
+
+  it('detects conflict when both branches change same field differently', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 42 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 99 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts.length).toBeGreaterThan(0);
+    expect(result.conflicts[0].documentId).toBe('doc1');
+    expect(result.conflicts[0].path).toBe('a');
+    expect(result.conflicts[0].base).toBe(1);
+    expect(result.conflicts[0].ours).toBe(99);
+    expect(result.conflicts[0].theirs).toBe(42);
+    // branch unchanged
+    expect(store.get('doc1')).toEqual({ a: 99 });
+  });
+
+  it('no conflict when both change same field to same value', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 42 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 42 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toHaveLength(0);
+  });
+
+  it('merges new document from source branch', () => {
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.create('doc2', { x: 5 });
+    store.switchBranch('main');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.merged['doc2']).toEqual({ x: 5 });
+    expect(store.get('doc2')).toEqual({ x: 5 });
+  });
+
+  it('independent documents merge without conflict', () => {
+    store.create('doc1', { a: 1 });
+    store.create('doc2', { b: 2 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 10 });
+    store.switchBranch('main');
+    store.update('doc2', { b: 20 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.merged['doc1']).toEqual({ a: 10 });
+    expect(result.merged['doc2']).toEqual({ b: 20 });
+  });
+
+  it('noop merge when no changes on either side', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toHaveLength(0);
+    expect(Object.keys(result.merged)).toHaveLength(0);
+  });
+
+  it('merged field shows ours on conflict', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 42 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 99 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect((result.merged['doc1'] as any).a).toBe(99); // ours
+  });
+
+  it('deeply nested field conflict', () => {
+    store.create('doc1', { a: { b: { c: 1 } } });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: { b: { c: 42 } } });
+    store.switchBranch('main');
+    store.update('doc1', { a: { b: { c: 99 } } });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts[0].path).toBe('a.b.c');
+  });
+
+  it('only-theirs-changed field is taken without conflict', () => {
+    store.create('doc1', { a: 1, b: 2 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 10, b: 2 });
+    store.switchBranch('main');
+    // main doesn't change doc1
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(store.get('doc1')).toEqual({ a: 10, b: 2 });
+  });
+});
