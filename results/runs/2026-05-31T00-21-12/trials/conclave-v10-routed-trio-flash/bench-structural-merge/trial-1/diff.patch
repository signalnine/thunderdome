@@ -0,0 +1,313 @@
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+export interface Conflict {
+  documentId: string;
+  path: string;
+  base: any;
+  ours: any;
+  theirs: any;
+}
+
+export interface MergeResult {
+  merged: Record<string, object>;
+  conflicts: Conflict[];
+  applied: boolean;
+}
+
+interface DocState {
+  content: object | null; // null means deleted
+  versions: Version[];
+}
+
+interface BranchState {
+  docs: Map<string, DocState>;
+  // point where this branch diverged from its parent (snapshot of parent docs at branch time)
+  divergePoint: Map<string, DocState>;
+}
+
+let versionCounter = 0;
+
+function newVersionId(): string {
+  return `v${++versionCounter}-${Date.now()}`;
+}
+
+function clone<T>(obj: T): T {
+  return JSON.parse(JSON.stringify(obj));
+}
+
+function getLeafPaths(obj: object, prefix = ''): Map<string, any> {
+  const result = new Map<string, any>();
+  for (const [key, val] of Object.entries(obj)) {
+    const path = prefix ? `${prefix}.${key}` : key;
+    if (val !== null && typeof val === 'object' && !Array.isArray(val)) {
+      for (const [k, v] of getLeafPaths(val, path)) {
+        result.set(k, v);
+      }
+    } else {
+      result.set(path, val);
+    }
+  }
+  return result;
+}
+
+function applyPaths(paths: Map<string, any>): object {
+  const result: any = {};
+  for (const [path, val] of paths) {
+    const parts = path.split('.');
+    let cur = result;
+    for (let i = 0; i < parts.length - 1; i++) {
+      if (cur[parts[i]] === undefined) cur[parts[i]] = {};
+      cur = cur[parts[i]];
+    }
+    cur[parts[parts.length - 1]] = val;
+  }
+  return result;
+}
+
+export class DocumentStore {
+  private branches: Map<string, BranchState> = new Map();
+  private currentBranch: string = 'main';
+
+  constructor() {
+    this.branches.set('main', { docs: new Map(), divergePoint: new Map() });
+  }
+
+  private branch(): BranchState {
+    return this.branches.get(this.currentBranch)!;
+  }
+
+  private getDoc(branchName: string, id: string): DocState | undefined {
+    return this.branches.get(branchName)?.docs.get(id);
+  }
+
+  // CRUD
+
+  create(id: string, content: object): void {
+    const b = this.branch();
+    const existing = b.docs.get(id);
+    if (existing && existing.content !== null) {
+      throw new Error(`Document "${id}" already exists`);
+    }
+    const version: Version = { id: newVersionId(), timestamp: Date.now(), content: clone(content) };
+    if (existing) {
+      existing.content = clone(content);
+      existing.versions.push(version);
+    } else {
+      b.docs.set(id, { content: clone(content), versions: [version] });
+    }
+  }
+
+  get(id: string): object {
+    const doc = this.branch().docs.get(id);
+    if (!doc || doc.content === null) throw new Error(`Document "${id}" not found`);
+    return clone(doc.content);
+  }
+
+  update(id: string, content: object): void {
+    const doc = this.branch().docs.get(id);
+    if (!doc || doc.content === null) throw new Error(`Document "${id}" not found`);
+    const version: Version = { id: newVersionId(), timestamp: Date.now(), content: clone(content) };
+    doc.content = clone(content);
+    doc.versions.push(version);
+  }
+
+  delete(id: string): void {
+    const doc = this.branch().docs.get(id);
+    if (!doc || doc.content === null) throw new Error(`Document "${id}" not found`);
+    doc.content = null;
+  }
+
+  // Version history
+
+  getHistory(id: string): Version[] {
+    const doc = this.branch().docs.get(id);
+    if (!doc) throw new Error(`Document "${id}" not found`);
+    return clone(doc.versions);
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const doc = this.branch().docs.get(id);
+    if (!doc) throw new Error(`Document "${id}" not found`);
+    const v = doc.versions.find(v => v.id === versionId);
+    if (!v) throw new Error(`Version "${versionId}" not found`);
+    return clone(v.content);
+  }
+
+  // Branching
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) throw new Error(`Branch "${name}" already exists`);
+    const srcName = fromBranch ?? this.currentBranch;
+    const src = this.branches.get(srcName);
+    if (!src) throw new Error(`Branch "${srcName}" not found`);
+
+    // deep clone all docs
+    const docs = new Map<string, DocState>();
+    for (const [id, doc] of src.docs) {
+      docs.set(id, clone(doc));
+    }
+    // divergePoint is a snapshot of the source at branch time
+    const divergePoint = new Map<string, DocState>();
+    for (const [id, doc] of src.docs) {
+      divergePoint.set(id, clone(doc));
+    }
+    this.branches.set(name, { docs, divergePoint });
+  }
+
+  switchBranch(name: string): void {
+    if (!this.branches.has(name)) throw new Error(`Branch "${name}" not found`);
+    this.currentBranch = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return Array.from(this.branches.keys());
+  }
+
+  // Merging
+
+  merge(sourceBranch: string): MergeResult {
+    const targetBranchState = this.branch();
+    const srcBranchState = this.branches.get(sourceBranch);
+    if (!srcBranchState) throw new Error(`Branch "${sourceBranch}" not found`);
+
+    // The diverge point is stored on the source branch (what it saw when created from current or vice versa)
+    // We need the common ancestor. Since createBranch stores the state of source at branch time,
+    // the divergePoint of the source branch IS the common ancestor when source was created from current.
+    // But if current was created from source, divergePoint of current branch is the ancestor.
+    // General approach: use the source branch's divergePoint as base.
+    const srcDiverge = srcBranchState.divergePoint;
+
+    const conflicts: Conflict[] = [];
+    const merged: Record<string, object> = {};
+
+    // Collect all document IDs across source, target, and base
+    const allIds = new Set<string>([
+      ...targetBranchState.docs.keys(),
+      ...srcBranchState.docs.keys(),
+      ...srcDiverge.keys(),
+    ]);
+
+    for (const id of allIds) {
+      const baseDoc = srcDiverge.get(id);
+      const ourDoc = targetBranchState.docs.get(id);
+      const theirDoc = srcBranchState.docs.get(id);
+
+      const baseContent = baseDoc?.content ?? null;
+      const ourContent = ourDoc?.content ?? null;
+      const theirContent = theirDoc?.content ?? null;
+
+      // No changes on either side
+      const oursChanged = JSON.stringify(ourContent) !== JSON.stringify(baseContent);
+      const theirsChanged = JSON.stringify(theirContent) !== JSON.stringify(baseContent);
+
+      if (!oursChanged && !theirsChanged) continue;
+
+      // Only theirs changed
+      if (!oursChanged && theirsChanged) {
+        if (theirContent !== null) {
+          merged[id] = clone(theirContent);
+        }
+        continue;
+      }
+
+      // Only ours changed
+      if (oursChanged && !theirsChanged) {
+        if (ourContent !== null) {
+          merged[id] = clone(ourContent);
+        }
+        continue;
+      }
+
+      // Both changed - need field-level three-way merge
+      // Handle deletion cases
+      if (ourContent === null && theirContent === null) continue; // both deleted
+      if (ourContent === null) {
+        // we deleted, they modified - conflict at root
+        conflicts.push({ documentId: id, path: '', base: baseContent, ours: null, theirs: theirContent });
+        if (ourContent !== null) merged[id] = clone(ourContent);
+        continue;
+      }
+      if (theirContent === null) {
+        // they deleted, we modified - conflict at root
+        conflicts.push({ documentId: id, path: '', base: baseContent, ours: ourContent, theirs: null });
+        merged[id] = clone(ourContent);
+        continue;
+      }
+
+      // Both sides changed and both exist - do field-level merge
+      const basePaths = baseContent ? getLeafPaths(baseContent) : new Map<string, any>();
+      const ourPaths = getLeafPaths(ourContent);
+      const theirPaths = getLeafPaths(theirContent);
+
+      const allPaths = new Set([...ourPaths.keys(), ...theirPaths.keys(), ...basePaths.keys()]);
+      const mergedPaths = new Map<string, any>();
+      const docConflicts: Conflict[] = [];
+
+      for (const path of allPaths) {
+        const baseVal = basePaths.get(path);
+        const ourVal = ourPaths.get(path);
+        const theirVal = theirPaths.get(path);
+
+        const ourChanged = JSON.stringify(ourVal) !== JSON.stringify(baseVal);
+        const theirChanged = JSON.stringify(theirVal) !== JSON.stringify(baseVal);
+
+        if (!ourChanged && !theirChanged) {
+          if (ourVal !== undefined) mergedPaths.set(path, ourVal);
+        } else if (ourChanged && !theirChanged) {
+          if (ourVal !== undefined) mergedPaths.set(path, ourVal);
+        } else if (!ourChanged && theirChanged) {
+          if (theirVal !== undefined) mergedPaths.set(path, theirVal);
+        } else {
+          // both changed
+          if (JSON.stringify(ourVal) === JSON.stringify(theirVal)) {
+            // same value - no conflict
+            if (ourVal !== undefined) mergedPaths.set(path, ourVal);
+          } else {
+            docConflicts.push({ documentId: id, path, base: baseVal, ours: ourVal, theirs: theirVal });
+            if (ourVal !== undefined) mergedPaths.set(path, ourVal); // ours wins for display
+          }
+        }
+      }
+
+      const mergedDoc = applyPaths(mergedPaths);
+      merged[id] = mergedDoc;
+      conflicts.push(...docConflicts);
+    }
+
+    const applied = conflicts.length === 0;
+
+    if (applied) {
+      // Apply merged docs to current branch
+      for (const [id, content] of Object.entries(merged)) {
+        const doc = targetBranchState.docs.get(id);
+        const version: Version = { id: newVersionId(), timestamp: Date.now(), content: clone(content) };
+        if (doc) {
+          doc.content = clone(content);
+          doc.versions.push(version);
+        } else {
+          targetBranchState.docs.set(id, { content: clone(content), versions: [version] });
+        }
+      }
+      // Handle documents deleted in source that exist in target
+      for (const [id, theirDoc] of srcBranchState.docs) {
+        if (theirDoc.content === null) {
+          const baseDoc = srcDiverge.get(id);
+          const ourDoc = targetBranchState.docs.get(id);
+          if (ourDoc && ourDoc.content !== null && JSON.stringify(ourDoc.content) === JSON.stringify(baseDoc?.content)) {
+            ourDoc.content = null;
+          }
+        }
+      }
+    }
+
+    return { merged, conflicts, applied };
+  }
+}
