+describe('Deps', () => {
+  function makeChain() {
+    const r = createRegistry();
+    r.register(makeManifest('A', '1.0.0', { B: '^1.0.0' }));
+    r.register(makeManifest('B', '1.0.0', { C: '^1.0.0' }));
+    r.register(makeManifest('C', '1.0.0'));
+    return r;
+  }
+
+  it('buildTree returns tree with A->B->C nesting', () => {
+    const registry = makeChain();
+    const deps = createDepsService();
+    const tree = deps.buildTree('A', registry);
+    expect(tree.name).toBe('A');
+    expect(tree.dependencies).toHaveLength(1);
+    expect(tree.dependencies[0].name).toBe('B');
+    expect(tree.dependencies[0].dependencies).toHaveLength(1);
+    expect(tree.dependencies[0].dependencies[0].name).toBe('C');
+  });
+
+  it('detectCycles returns null for acyclic (A->B->C)', () => {
+    const registry = makeChain();
+    const deps = createDepsService();
+    expect(deps.detectCycles('A', registry)).toBeNull();
+  });
+
+  it('detectCycles finds cycle: D->{E} and E->{D}', () => {
+    const registry = createRegistry();
+    registry.register(makeManifest('D', '1.0.0', { E: '^1.0.0' }));
+    registry.register(makeManifest('E', '1.0.0', { D: '^1.0.0' }));
+    const deps = createDepsService();
+    expect(deps.detectCycles('D', registry)).not.toBeNull();
+  });
+
+  it('topologicalSort: C comes before B, B comes before A', () => {
+    const registry = makeChain();
+    const deps = createDepsService();
+    const sorted = deps.topologicalSort('A', registry);
+    const idxA = sorted.indexOf('A');
+    const idxB = sorted.indexOf('B');
+    const idxC = sorted.indexOf('C');
+    expect(idxC).toBeLessThan(idxB);
+    expect(idxB).toBeLessThan(idxA);
+  });
+
+  it('flattenDependencies for A: includes B and C, not A itself', () => {
+    const registry = makeChain();
+    const deps = createDepsService();
+    const flat = deps.flattenDependencies('A', registry);
+    expect(flat).toContain('B');
+    expect(flat).toContain('C');
+    expect(flat).not.toContain('A');
+  });
+
+  it('hasCircularDependency false for A, true for cycle D', () => {
+    const acyclicRegistry = makeChain();
+    const cyclicRegistry = createRegistry();
+    cyclicRegistry.register(makeManifest('D', '1.0.0', { E: '^1.0.0' }));
+    cyclicRegistry.register(makeManifest('E', '1.0.0', { D: '^1.0.0' }));
+
+    const deps = createDepsService();
+    expect(deps.hasCircularDependency('A', acyclicRegistry)).toBe(false);
+    expect(deps.hasCircularDependency('D', cyclicRegistry)).toBe(true);
+  });
+});
