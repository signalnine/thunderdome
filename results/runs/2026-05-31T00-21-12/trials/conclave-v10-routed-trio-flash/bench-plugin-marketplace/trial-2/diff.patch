+import { describe, it, expect } from 'vitest';
+import {
+  createRegistry,
+  createResolver,
+  createRunner,
+  createReviewService,
+  createDepsService,
+  createMarketplace,
+} from '../src/index.js';
+import type { PluginManifest } from '../src/index.js';
+
+const makeManifest = (
+  name: string,
+  version: string,
+  deps: Record<string, string> = {},
+): PluginManifest => ({
+  name,
+  version,
+  description: name + ' desc',
+  author: 'test',
+  dependencies: deps,
+  entryPoint: 'module.exports = 42;',
+  permissions: [],
+});
+
+// ---------------------------------------------------------------------------
+describe('Registry', () => {
+  it('register and get returns plugin', () => {
+    const registry = createRegistry();
+    const m = makeManifest('my-plugin', '1.0.0');
+    registry.register(m);
+    const result = registry.get('my-plugin');
+    expect(result).not.toBeNull();
+    expect(result?.name).toBe('my-plugin');
+    expect(result?.version).toBe('1.0.0');
+  });
+
+  it('get returns latest version when multiple versions exist', () => {
+    const registry = createRegistry();
+    registry.register(makeManifest('multi', '1.0.0'));
+    registry.register(makeManifest('multi', '2.0.0'));
+    const result = registry.get('multi');
+    expect(result?.version).toBe('2.0.0');
+  });
+
+  it('getVersion returns specific version', () => {
+    const registry = createRegistry();
+    registry.register(makeManifest('versioned', '1.0.0'));
+    registry.register(makeManifest('versioned', '2.0.0'));
+    const result = registry.getVersion('versioned', '1.0.0');
+    expect(result?.version).toBe('1.0.0');
+  });
+
+  it('get returns null for unknown plugin', () => {
+    const registry = createRegistry();
+    expect(registry.get('does-not-exist')).toBeNull();
+  });
+
+  it('list returns all registered plugins', () => {
+    const registry = createRegistry();
+    registry.register(makeManifest('alpha', '1.0.0'));
+    registry.register(makeManifest('beta', '1.0.0'));
+    const all = registry.list();
+    const names = all.map((m) => m.name);
+    expect(names).toContain('alpha');
+    expect(names).toContain('beta');
+  });
+
+  it('search finds by name fragment case-insensitively', () => {
+    const registry = createRegistry();
+    registry.register(makeManifest('FooBar', '1.0.0'));
+    registry.register(makeManifest('baz', '1.0.0'));
+    const results = registry.search('foo');
+    expect(results.length).toBe(1);
+    expect(results[0].name).toBe('FooBar');
+  });
+
+  it('remove returns true and plugin is gone', () => {
+    const registry = createRegistry();
+    registry.register(makeManifest('removable', '1.0.0'));
+    const removed = registry.remove('removable', '1.0.0');
+    expect(removed).toBe(true);
+    expect(registry.get('removable')).toBeNull();
+  });
+
+  it('remove returns false for nonexistent', () => {
+    const registry = createRegistry();
+    expect(registry.remove('ghost', '9.9.9')).toBe(false);
+  });
+
+  it('listVersions returns all versions', () => {
+    const registry = createRegistry();
+    registry.register(makeManifest('multi-v', '1.0.0'));
+    registry.register(makeManifest('multi-v', '1.1.0'));
+    registry.register(makeManifest('multi-v', '2.0.0'));
+    const versions = registry.listVersions('multi-v');
+    expect(versions).toHaveLength(3);
+    expect(versions).toContain('1.0.0');
+    expect(versions).toContain('1.1.0');
+    expect(versions).toContain('2.0.0');
+  });
+
+  it('update merges description field', () => {
+    const registry = createRegistry();
+    registry.register(makeManifest('updatable', '1.0.0'));
+    registry.update('updatable', '1.0.0', { description: 'new description' });
+    const result = registry.getVersion('updatable', '1.0.0');
+    expect(result?.description).toBe('new description');
+    expect(result?.author).toBe('test');
+  });
+});
+
+// ---------------------------------------------------------------------------
+describe('Resolver', () => {
+  it('resolve finds max satisfying version for range ^1.0.0 from [1.0.0, 1.2.0, 2.0.0] -> 1.2.0', () => {
+    const resolver = createResolver();
+    const constraints = [{ name: 'pkg', range: '^1.0.0' }];
+    const available = { pkg: ['1.0.0', '1.2.0', '2.0.0'] };
+    const resolved = resolver.resolve(constraints, available);
+    expect(resolved).toHaveLength(1);
+    expect(resolved[0].version).toBe('1.2.0');
+    expect(resolved[0].satisfies).toBe('^1.0.0');
+  });
+
+  it('resolve skips missing plugin names', () => {
+    const resolver = createResolver();
+    const constraints = [{ name: 'missing-pkg', range: '^1.0.0' }];
+    const available: Record<string, string[]> = {};
+    const resolved = resolver.resolve(constraints, available);
+    expect(resolved).toHaveLength(0);
+  });
+
+  it('resolve skips when no version satisfies', () => {
+    const resolver = createResolver();
+    const constraints = [{ name: 'pkg', range: '^3.0.0' }];
+    const available = { pkg: ['1.0.0', '1.2.0', '2.0.0'] };
+    const resolved = resolver.resolve(constraints, available);
+    expect(resolved).toHaveLength(0);
