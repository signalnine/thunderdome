nge(range: string): boolean;\n\nVersionConstraint: { name: string; range: string }\nResolvedVersion: { name: string; version: string; satisfies: string }\n\nWrite this exact content to /workspace/src/resolver/index.ts:\n\n\\`\\`\\`typescript\nimport semver from 'semver';\nimport type { VersionConstraint, ResolvedVersion, ResolverService } from '../types.js';\n\nexport function createResolver(): ResolverService {\n  return {\n    resolve(constraints, available) {\n      const results: ResolvedVersion[] = [];\n      for (const constraint of constraints) {\n        const versions = available[constraint.name] ?? [];\n        const best = semver.maxSatisfying(versions, constraint.range);\n        if (best !== null) {\n          results.push({ name: constraint.name, version: best, satisfies: constraint.range });\n        }\n      }\n      return results;\n    },\n    satisfies(version, range) {\n      return semver.satisfies(version, range);\n    },\n    maxSatisfying(versions, range) {\n      return semver.maxSatisfying(versions, range);\n    },\n    validRange(range) {\n      return semver.validRange(range) !== null;\n    },\n  };\n}\n\\`\\`\\`\n\nWrite this content to /workspace/src/resolver/index.ts using the Write tool.`, { label: 'resolver' }),\n\n  () => agent(`Write /workspace/src/runner/index.ts — the Sandboxed Runner module for a plugin marketplace.\n\nTASK: Write the file using the Write tool.\n\nProject: TypeScript ESM, \"type\": \"module\", Node16 module resolution.\n\nThe RunnerService interface (from src/types.ts):\n  execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult>;\n  executeWithTimeout(code: string, timeoutMs: number, context?: Record<string, unknown>): Promise<SandboxResult>;\n\nSandboxResult: { success: boolean; output: unknown; duration: number; memoryUsed: number; error?: string }\n\nUse Node.js vm module (NOT vm2). Key points:\n- vm.createContext(sandbox) creates the sandbox\n- new vm.Script(code).runInContext(ctx, { timeout: ms }) runs the code with a timeout\n- Wrap the user code in an IIFE to allow capturing: \"(function(module, exports, console) { \" + code + \" })(module, exports, console)\"\n- Inject a custom console that captures log/error/warn calls to an array\n- Use process.memoryUsage().heapUsed before and after for memory measurement\n- For timing: capture hrtime.bigint() or performance.now() before and after, compute difference in ms\n- If console was used (array length > 0), output = captured array; else output = sandbox.module.exports\n- On error: success=false, output=null, error=err.message\n\nWrite this exact content to /workspace/src/runner/index.ts:\n\n\\`\\`\\`typescript\nimport vm from 'node:vm';\nimport { performance } from 'node:perf_hooks';\nimport type { SandboxResult, RunnerService } from '../types.js';\n\nfunction runCode(code: string, timeoutMs: number, context?: Record<string, unknown>): Promise<SandboxResult> {\n  return new Promise((resolve) => {\n    const start = performance.now();\n    const memBefore = process.memoryUsage().heapUsed;\n\n    const captured: unknown[] = [];\n    const mockConsole = {\n      log: (...args: unknown[]) => { captured.push(args.length === 1 ? args[0] : args); },\n      error: (...args: unknown[]) => { captured.push(args.length === 1 ? args[0] : args); },\n      warn: (...args: unknown[]) => { captured.push(args.length === 1 ? args[0] : args); },\n      info: (...args: unknown[]) => { captured.push(args.length === 1 ? args[0] : args); },\n    };\n\n    const moduleObj = { exports: {} as unknown };\n    const sandbox: Record<string, unknown> = {\n      ...(context ?? {}),\n      console: mockConsole,\n      module: moduleObj,\n      exports: moduleObj.exports,\n    };\n\n    try {\n      const wrapped = \\`(function(module, exports, console) { \\${code} })(module, exports, console)\\`;\n      const script = new vm.Script(wrapped);\n      const ctx = vm.createContext(sandbox);\n      script.runInContext(ctx, { timeout: timeoutMs });\n\n      const duration = performance.now() - start;\n      const memAfter = process.memoryUsage().heapUsed;\n      const output = captured.length > 0 ? captured : (sandbox['module'] as typeof moduleObj).exports;\n\n      resolve({ success: true, output, duration, memoryUsed: Math.max(0, memAfter - memBefore) });\n    } catch (err) {\n      const duration = performance.now() - start;\n      const memAfter = process.memoryUsage().heapUsed;\n      resolve({\n        success: false,\n        output: null,\n        duration,\n        memoryUsed: Math.max(0, memAfter - memBefore),\n        error: err instanceof Error ? err.message : String(err),\n      });\n    }\n  });\n}\n\nexport function createRunner(): RunnerService {\n  return {\n    execute(code, context) {\n      return runCode(code, 5000, context);\n    },\n    executeWithTimeout(code, timeoutMs, context) {\n      return runCode(code, timeoutMs, context);\n    },\n  };\n}\n\\`\\`\\`\n\nWrite this content to /workspace/src/runner/index.ts using the Write tool.`, { label: 'runner' }),\n\n  () => agent(`Write /workspace/src/reviews/index.ts — the Review System module for a plugin marketplace.\n\nTASK: Write the file using the Write tool.\n\nProject: TypeScript ESM, \"type\": \"module\", Node16 module resolution.\n\nThe ReviewService interface (from src/types.ts):\n  addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review;\n  getReviews(pluginName: string): Review[];\n  getAverageRating(pluginName: string): number;\n  flagReview(reviewId: number): void;\n  getFlaggedReviews(): Review[];\n  removeReview(reviewId: number): boolean;\n  getReviewsByUser(userId: string): Review[];\n  getReviewCount(pluginName: string): number;\n\nReview interface: { id: number; pluginName: string; pluginVersion: string; userId: string; rating: number; comment: string; flagged: boolean; createdAt: string }\n\nKey: getAverageRating excludes flagged reviews, returns 0 if no non-flagged reviews exist.\ncreatedAt should be an ISO timestamp string generated at insert time.\nSQLite stores flagged as 0/1 integer; must convert to boolean when returning.\n\nWrite this exact content to /workspace/src/reviews/index.ts:\n\n\\`\\`\\`typescript\nimport Database from 'better-sqlite3';\nimport type { Review, ReviewService } from '../types.js';\n\ntype DbRow = {\n  id: number;\n  pluginName: string;\n  pluginVersion: string;\n  userId: string;\n  rating: number;\n  comment: string;\n  flagged: number;\n  createdAt: string;\n};\n\nfunction toReview(row: DbRow): Review {\n  return { ...row, flagged: row.flagged === 1 };\n}\n\nexport function createReviewService(): ReviewService {\n  const db = new Database(':memory:');\n  db.exec(\\`CREATE TABLE IF NOT EXISTS reviews (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    pluginName TEXT NOT NULL,\n    pluginVersion TEXT NOT NULL,\n    userId TEXT NOT NULL,\n    rating INTEGER NOT NULL,\n    comment TEXT NOT NULL,\n    flagged INTEGER NOT NULL DEFAULT 0,\n    createdAt TEXT NOT NULL\n  )\\`);\n\n  return {\n    addReview(review) {\n      const createdAt = new global.Date().toISOString();\n      const stmt = db.prepare(\n        'INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt) VALUES (?, ?, ?, ?, ?, 0, ?)'\n      );\n      const result = stmt.run(review.pluginName, review.pluginVersion, review.userId, review.rating, review.comment, createdAt);\n      const row = db.prepare('SELECT * FROM reviews WHERE id = ?').get(result.lastInsertRowid) as DbRow;\n      return toReview(row);\n    },\n    getReviews(pluginName) {\n      const rows = db.prepare('SELECT * FROM reviews WHERE pluginName = ?').all(pluginName) as DbRow[];\n      return rows.map(toReview);\n    },\n    getAverageRating(pluginName) {\n      const row = db.prepare('SELECT AVG(rating) as avg FROM reviews WHERE pluginName = ? AND flagged = 0').get(pluginName) as { avg: number | null };\n      return row.avg ?? 0;\n    },\n    flagReview(reviewId) {\n      db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?').run(reviewId);\n    },\n    getFlaggedReviews() {\n      const rows = db.prepare('SELECT * FROM reviews WHERE flagged = 1').all() as DbRow[];\n      return rows.map(toReview);\n    },\n    removeReview(reviewId) {\n      const result = db.prepare('DELETE FROM reviews WHERE id = ?').run(reviewId);\n      return result.changes > 0;\n    },\n    getReviewsByUser(userId) {\n      const rows = db.prepare('SELECT * FROM reviews WHERE userId = ?').all(userId) as DbRow[];\n      return rows.map(toReview);\n    },\n    getReviewCount(pluginName) {\n      const row = db.prepare('SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?').get(pluginName) as { count: number };\n      return row.count;\n    },\n  };\n}\n\\`\\`\\`\n\nIMPORTANT: The \\`new global.Date().toISOString()\\` is intentional — it references global.Date to work around any sandboxing. Actually, just use \\`new Date().toISOString()\\` since this runs in Node.js context, not in a vm sandbox. Write this file using the Write tool.`, { label: 'reviews' }),\n\n  () => agent(`Write /workspace/src/deps/index.ts — the Dependency Graph module for a plugin marketplace.\n\nTASK: Write the file using the Write tool.\n\nProject: TypeScript ESM, \"type\": \"module\", Node16 module resolution.\n\nThe DepsService interface (from src/types.ts):\n  buildTree(name: string, registry: RegistryService): DependencyNode;\n  detectCycles(name: string, registry: RegistryService): string[][] | null;\n  topologicalSort(name: string, registry: RegistryService): string[];\n  flattenDependencies(name: string, registry: RegistryService): string[];\n  hasCircularDependency(name: string, registry: RegistryService): boolean;\n\nDependencyNode: { name: string; version: string; dependencies: DependencyNode[] }\nRegistryService.get(name) returns PluginManifest | null\nPluginManifest.dependencies: Record<string, string> (name -> semver range)\n\nWrite this exact content to /workspace/src/deps/index.ts:\n\n\\`\\`\\`typescript\nimport type { DependencyNode, DepsService, RegistryService } from '../types.js';\n\nfunction buildTreeInner(name: string, registry: RegistryService, visiting: Set<string>): DependencyNode {\n  const manifest = registry.get(name);\n  if (!manifest) return { name, version: 'unknown', dependencies: [] };\n  if (visiting.has(name)) return { name, version: manifest.version, dependencies: [] };\n  visiting.add(name);\n  const deps = Object.keys(manifest.dependencies).map(depName =>\n    buildTreeInner(depName, registry, new Set(visiting))\n  );\n  return { name, version: manifest.version, dependencies: deps };\n}\n\nfunction findCycles(\n  name: string,\n  registry: RegistryService,\n  path: string[],\n  onPath: Set<string>,\n  visited: Set<string>,\n  cycles: string[][]\n): void {\n  if (onPath.has(name)) {\n    const idx = path.indexOf(name);\n    cycles.push([...path.slice(idx), name]);\n    return;\n  }\n  if (visited.has(name)) return;\n  visited.add(name);\n  onPath.add(name);\n  path.push(name);\n  const manifest = registry.get(name);\n  if (manifest) {\n    for (const depName of Object.keys(manifest.dependencies)) {\n      findCycles(depName, registry, path, onPath, visited, cycles);\n    }\n  }\n  path.pop();\n  onPath.delete(name);\n}\n\nfunction topoVisit(name: string, registry: RegistryService, visited: Set<string>, result: string[]): void {\n  if (visited.has(name)) return;\n  visited.add(name);\n  const manifest = registry.get(name);\n  if (manifest) {\n    for (const depName of Object.keys(manifest.dependencies)) {\n      topoVisit(depName, registry, visited, result);\n    }\n  }\n  result.push(name);\n}\n\nexport function createDepsService(): DepsService {\n  return {\n    buildTree(name, registry) {\n      return buildTreeInner(name, registry, new Set());\n    },\n    detectCycles(name, registry) {\n      const cycles: string[][] = [];\n      findCycles(name, registry, [], new Set(), new Set(), cycles);\n      return cycles.length > 0 ? cycles : null;\n    },\n    topologicalSort(name, registry) {\n      const result: string[] = [];\n      topoVisit(name, registry, new Set(), result);\n      return result;\n    },\n    flattenDependencies(name, registry) {\n      const seen = new Set<string>();\n      const queue = [name];\n      while (queue.length > 0) {\n        const current = queue.shift()!;\n        const manifest = registry.get(current);\n        if (!manifest) continue;\n        for (const depName of Object.keys(manifest.dependencies)) {\n          if (!seen.has(depName)) {\n            seen.add(depName);\n            queue.push(depName);\n          }\n        }\n      }\n      return Array.from(seen);\n    },\n    hasCircularDependency(name, registry) {\n      return this.detectCycles(name, registry) !== null;\n    },\n  };\n}\n\\`\\`\\`\n\nWrite this content to /workspace/src/deps/index.ts using the Write tool.`, { label: 'deps' }),\n])\n\nphase('Integrate')\nawait agent(`Write /workspace/src/index.ts — the integration layer for the plugin marketplace.\n\nTASK: Write the file using the Write tool.\n\nProject: TypeScript ESM, \"type\": \"module\", Node16 module resolution.\n\nThe 5 modules are at (use .js extensions for ESM imports):\n  - src/registry/index.ts  -> export createRegistry(): RegistryService\n  - src/resolver/index.ts  -> export createResolver(): ResolverService\n  - src/runner/index.ts    -> export createRunner(): RunnerService\n  - src/reviews/index.ts   -> export createReviewService(): ReviewService\n  - src/deps/index.ts      -> export createDepsService(): DepsService\n\nTypes from src/types.ts:\n  PluginManifest: { name, version, description, author, dependencies: Record<string,string>, entryPoint, permissions }\n  ResolvedVersion: { name, version, satisfies }\n  SandboxResult: { success, output, duration, memoryUsed, error? }\n  VersionConstraint: { name, range }\n\nWrite this exact content to /workspace/src/index.ts:\n\n\\`\\`\\`typescri