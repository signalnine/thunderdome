abase(':memory:')\n- Create table on init: CREATE TABLE IF NOT EXISTS plugins (name TEXT NOT NULL, version TEXT NOT NULL, manifest TEXT NOT NULL, PRIMARY KEY (name, version))\n- Store full manifest as JSON string in manifest column\n- For get(name): select all rows where name matches, sort versions, return latest. To sort semver correctly, you can import semver and use semver.rsort, or just sort the returned manifests array.\n- For search(query): do LIKE '%query%' on name column OR load all and filter by JSON.stringify containing the query (case-insensitive)\n- For remove(): use db.prepare().run() and check changes > 0\n- For update(): load existing, merge with {...existing, ...updates}, write back\n\nType safety: define type DbRow = { manifest: string } and cast db query results.\n\nHere is the complete file to write:\n\n\\`\\`\\`typescript\nimport Database from 'better-sqlite3';\nimport semver from 'semver';\nimport type { PluginManifest, RegistryService } from '../types.js';\n\ntype DbRow = { manifest: string };\n\nexport function createRegistry(): RegistryService {\n  const db = new Database(':memory:');\n  db.exec(\\`CREATE TABLE IF NOT EXISTS plugins (\n    name TEXT NOT NULL,\n    version TEXT NOT NULL,\n    manifest TEXT NOT NULL,\n    PRIMARY KEY (name, version)\n  )\\`);\n\n  const svc: RegistryService = {\n    register(manifest) {\n      db.prepare('INSERT OR REPLACE INTO plugins (name, version, manifest) VALUES (?, ?, ?)').run(manifest.name, manifest.version, JSON.stringify(manifest));\n    },\n    get(name) {\n      const rows = db.prepare('SELECT manifest FROM plugins WHERE name = ?').all(name) as DbRow[];\n      if (rows.length === 0) return null;\n      const manifests = rows.map(r => JSON.parse(r.manifest) as PluginManifest);\n      manifests.sort((a, b) => semver.rcompare(a.version, b.version));\n      return manifests[0];\n    },\n    getVersion(name, version) {\n      const row = db.prepare('SELECT manifest FROM plugins WHERE name = ? AND version