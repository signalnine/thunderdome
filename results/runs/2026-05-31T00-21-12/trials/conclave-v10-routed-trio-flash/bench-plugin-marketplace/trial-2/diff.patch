@@ -0,0 +1,82 @@
+import vm from 'node:vm';
+import { performance } from 'node:perf_hooks';
+import type { SandboxResult, RunnerService } from '../types.js';
+
+async function runCode(
+  code: string,
+  timeoutMs: number,
+  context?: Record<string, unknown>
+): Promise<SandboxResult> {
+  return new Promise((resolve) => {
+    const start = performance.now();
+    const memBefore = process.memoryUsage().heapUsed;
+
+    let duration = 0;
+    let memoryUsed = 0;
+
+    try {
+      const captured: unknown[] = [];
+
+      const mockConsole = {
+        log: (...args: unknown[]) => captured.push(...args),
+        error: (...args: unknown[]) => captured.push(...args),
+        warn: (...args: unknown[]) => captured.push(...args),
+        info: (...args: unknown[]) => captured.push(...args),
+      };
+
+      const moduleObj: { exports: Record<string, unknown> } = { exports: {} };
+
+      const sandbox: Record<string, unknown> = {
+        ...(context ?? {}),
+        console: mockConsole,
+        module: moduleObj,
+        exports: moduleObj.exports,
+      };
+
+      const wrappedCode = `(function(module, exports, console) {\n${code}\n})(module, exports, console);`;
+
+      const script = new vm.Script(wrappedCode);
+      const vmContext = vm.createContext(sandbox);
+      script.runInContext(vmContext, { timeout: timeoutMs });
+
+      const memAfter = process.memoryUsage().heapUsed;
+      duration = performance.now() - start;
+      memoryUsed = Math.max(0, memAfter - memBefore);
+
+      resolve({
+        success: true,
+        output: captured.length > 0 ? captured : moduleObj.exports,
+        duration,
+        memoryUsed,
+      });
+    } catch (err) {
+      const memAfter = process.memoryUsage().heapUsed;
+      duration = performance.now() - start;
+      memoryUsed = Math.max(0, memAfter - memBefore);
+
+      resolve({
+        success: false,
+        output: null,
+        duration,
+        memoryUsed,
+        error: err instanceof Error ? err.message : String(err),
+      });
+    }
+  });
+}
+
+export function createRunner(): RunnerService {
+  return {
+    execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult> {
+      return runCode(code, 5000, context);
+    },
+
+    executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context?: Record<string, unknown>
+    ): Promise<SandboxResult> {
+      return runCode(code, timeoutMs, context);
+    },
+  };
+}
