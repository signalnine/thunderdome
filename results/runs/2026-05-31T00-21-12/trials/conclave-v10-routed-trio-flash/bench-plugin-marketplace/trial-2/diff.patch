new file mode 100644
index 0000000..da55d53
--- /dev/null
+++ b/src/registry/index.ts
@@ -0,0 +1,86 @@
+import Database from 'better-sqlite3';
+import semver from 'semver';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+type DbRow = { manifest: string };
+
+export function createRegistry(): RegistryService {
+  const db = new Database(':memory:');
+
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS plugins (
+      name TEXT NOT NULL,
+      version TEXT NOT NULL,
+      manifest TEXT NOT NULL,
+      PRIMARY KEY (name, version)
+    )
+  `);
+
+  const stmtInsert = db.prepare(
+    'INSERT OR REPLACE INTO plugins (name, version, manifest) VALUES (?, ?, ?)'
+  );
+  const stmtGetAllVersions = db.prepare<[string], DbRow>(
+    'SELECT manifest FROM plugins WHERE name = ?'
+  );
+  const stmtGetVersion = db.prepare<[string, string], DbRow>(
+    'SELECT manifest FROM plugins WHERE name = ? AND version = ?'
+  );
+  const stmtList = db.prepare<[], DbRow>('SELECT manifest FROM plugins');
+  const stmtRemove = db.prepare(
+    'DELETE FROM plugins WHERE name = ? AND version = ?'
+  );
+  const stmtListVersions = db.prepare<[string], { version: string }>(
+    'SELECT version FROM plugins WHERE name = ?'
+  );
+
+  return {
+    register(manifest: PluginManifest): void {
+      stmtInsert.run(manifest.name, manifest.version, JSON.stringify(manifest));
+    },
+
+    get(name: string): PluginManifest | null {
+      const rows = stmtGetAllVersions.all(name) as DbRow[];
+      if (rows.length === 0) return null;
+      const manifests = rows.map((row) => JSON.parse(row.manifest) as PluginManifest);
+      manifests.sort((a, b) => semver.rcompare(a.version, b.version));
+      return manifests[0];
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const row = stmtGetVersion.get(name, version) as DbRow | undefined;
+      if (!row) return null;
+      return JSON.parse(row.manifest) as PluginManifest;
+    },
+
+    list(): PluginManifest[] {
+      const rows = stmtList.all() as DbRow[];
+      return rows.map((row) => JSON.parse(row.manifest) as PluginManifest);
+    },
+
+    search(query: string): PluginManifest[] {
+      const rows = stmtList.all() as DbRow[];
+      const lowerQuery = query.toLowerCase();
+      return rows
+        .filter((row) => row.manifest.toLowerCase().includes(lowerQuery))
+        .map((row) => JSON.parse(row.manifest) as PluginManifest);
+    },
+
+    remove(name: string, version: string): boolean {
+      const result = stmtRemove.run(name, version);
+      return result.changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      const rows = stmtListVersions.all(name) as { version: string }[];
+      return rows.map((row) => row.version);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const row = stmtGetVersion.get(name, version) as DbRow | undefined;
+      if (!row) return;
+      const existing = JSON.parse(row.manifest) as PluginManifest;
+      const merged: PluginManifest = { ...existing, ...updates };
+      stmtInsert.run(name, version, JSON.stringify(merged));
+    },
+  };
+}
diff --git a/src/resolver/index.ts b/src/resolver/index.ts
new file mode 100644
index 0000000..b8d70a9
--- /dev/null
+++ b/src/resolver/index.ts
@@ -0,0 +1,34 @@
+import semver from 'semver';
+import type { VersionConstraint, ResolvedVersion, ResolverService } from '../types.js';
+
+export function createResolver(): ResolverService {
+  return {
+    resolve(constraints: VersionConstraint[], available: Record<string, string[]>): ResolvedVersion[] {
+      const results: ResolvedVersion[] = [];
+      for (const constraint of constraints) {
+        const versions = available[constraint.name];
+        if (versions === undefined) {
+          continue;
+        }
+        const best = semver.maxSatisfying(versions, constraint.range);
+        if (best === null) {
+          continue;
+        }
+        results.push({ name: constraint.name, version: best, satisfies: constraint.range });
+      }
+      return results;
+    },
+
+    satisfies(version: string, range: string): boolean {
+      return semver.satisfies(version, range);
+    },
+
+    maxSatisfying(versions: string[], range: string): string | null {
+      return semver.maxSatisfying(versions, range);
+    },
+
+    validRange(range: string): boolean {
+      return semver.validRange(range) !== null;
+    },
+  };
+}
