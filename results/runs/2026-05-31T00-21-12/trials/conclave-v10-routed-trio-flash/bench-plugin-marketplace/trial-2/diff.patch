+    await expect(mp.installPlugin(manifest)).rejects.toThrow();
+  });
+
+  it('installPlugin throws on missing entryPoint', async () => {
+    const mp = createMarketplace();
+    const manifest: PluginManifest = {
+      ...makeManifest('no-entry', '1.0.0'),
+      entryPoint: '',
+    };
+    await expect(mp.installPlugin(manifest)).rejects.toThrow();
+  });
+
+  it('installPlugin resolves available deps: pre-register dep-a@1.2.0, install plugin with dep {dep-a:^1.0.0}', async () => {
+    const mp = createMarketplace();
+    mp.registry.register(makeManifest('dep-a', '1.2.0'));
+    const manifest = makeManifest('main-plugin', '1.0.0', { 'dep-a': '^1.0.0' });
+    const result = await mp.installPlugin(manifest);
+    expect(result.resolvedDependencies).toHaveLength(1);
+    expect(result.resolvedDependencies[0].name).toBe('dep-a');
+    expect(result.resolvedDependencies[0].version).toBe('1.2.0');
+  });
+
+  it('installPlugin throws on circular: dep-cycle depends on myplugin, myplugin depends on dep-cycle', async () => {
