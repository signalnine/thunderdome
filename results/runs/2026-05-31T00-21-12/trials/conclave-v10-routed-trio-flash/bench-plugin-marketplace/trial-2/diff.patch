index 0000000..97fe61c
--- /dev/null
+++ b/src/reviews/index.ts
@@ -0,0 +1,130 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface DbRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+function toReview(row: DbRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged !== 0,
+    createdAt: row.createdAt,
+  };
+}
+
+export function createReviewService(): ReviewService {
+  const db = new Database(':memory:');
+
+  db.exec(`
+    CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT,
+      pluginVersion TEXT,
+      userId TEXT,
+      rating INTEGER,
+      comment TEXT,
+      flagged INTEGER DEFAULT 0,
+      createdAt TEXT
+    )
+  `);
+
+  const stmtInsert = db.prepare<[string, string, string, number, string, string]>(`
+    INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, createdAt, flagged)
+    VALUES (?, ?, ?, ?, ?, ?, 0)
+  `);
+
+  const stmtGetReviews = db.prepare<[string], DbRow>(`
+    SELECT * FROM reviews WHERE pluginName = ?
+  `);
+
+  const stmtGetAverageRating = db.prepare<[string], { avg: number | null }>(`
+    SELECT AVG(rating) AS avg FROM reviews WHERE pluginName = ? AND flagged = 0
+  `);
+
+  const stmtFlagReview = db.prepare<[number]>(`
+    UPDATE reviews SET flagged = 1 WHERE id = ?
+  `);
+
+  const stmtGetFlaggedReviews = db.prepare<[], DbRow>(`
+    SELECT * FROM reviews WHERE flagged = 1
+  `);
+
+  const stmtRemoveReview = db.prepare<[number]>(`
+    DELETE FROM reviews WHERE id = ?
+  `);
+
+  const stmtGetReviewsByUser = db.prepare<[string], DbRow>(`
+    SELECT * FROM reviews WHERE userId = ?
+  `);
+
+  const stmtGetReviewCount = db.prepare<[string], { count: number }>(`
+    SELECT COUNT(*) AS count FROM reviews WHERE pluginName = ?
+  `);
+
+  const stmtGetById = db.prepare<[number], DbRow>(`
+    SELECT * FROM reviews WHERE id = ?
+  `);
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      const createdAt = new Date().toISOString();
+      const result = stmtInsert.run(
+        review.pluginName,
+        review.pluginVersion,
+        review.userId,
+        review.rating,
+        review.comment,
+        createdAt,
+      );
+      const row = stmtGetById.get(result.lastInsertRowid as number) as DbRow;
+      return toReview(row);
+    },
+
+    getReviews(pluginName: string): Review[] {
+      const rows = stmtGetReviews.all(pluginName);
+      return rows.map(toReview);
+    },
+
+    getAverageRating(pluginName: string): number {
+      const row = stmtGetAverageRating.get(pluginName);
+      return row?.avg ?? 0;
+    },
+
+    flagReview(reviewId: number): void {
+      stmtFlagReview.run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      const rows = stmtGetFlaggedReviews.all();
+      return rows.map(toReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      const result = stmtRemoveReview.run(reviewId);
+      return result.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      const rows = stmtGetReviewsByUser.all(userId);
+      return rows.map(toReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = stmtGetReviewCount.get(pluginName);
+      return row?.count ?? 0;
+    },
+  };
+}
