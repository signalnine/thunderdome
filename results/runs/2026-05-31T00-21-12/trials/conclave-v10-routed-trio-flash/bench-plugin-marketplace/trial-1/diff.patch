+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  plugin_name: string;
+  plugin_version: string;
+  user_id: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  created_at: string;
+}
+
+class Reviews implements ReviewService {
+  private db: Database.Database;
+  private nextId = 1;
+
+  constructor() {
+    this.db = new Database(':memory:');
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS reviews (
+        id INTEGER PRIMARY KEY,
+        plugin_name TEXT NOT NULL,
+        plugin_version TEXT NOT NULL,
+        user_id TEXT NOT NULL,
+        rating INTEGER NOT NULL,
+        comment TEXT NOT NULL,
+        flagged INTEGER NOT NULL DEFAULT 0,
+        created_at TEXT NOT NULL
+      )
+    `);
+  }
+
+  private rowToReview(row: ReviewRow): Review {
+    return {
+      id: row.id,
+      pluginName: row.plugin_name,
+      pluginVersion: row.plugin_version,
+      userId: row.user_id,
+      rating: row.rating,
+      comment: row.comment,
+      flagged: row.flagged === 1,
+      createdAt: row.created_at,
+    };
+  }
+
+  addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+    const id = this.nextId++;
+    const createdAt = new Date().toISOString();
+    this.db
+      .prepare(
+        'INSERT INTO reviews (id, plugin_name, plugin_version, user_id, rating, comment, flagged, created_at) VALUES (?, ?, ?, ?, ?, ?, 0, ?)'
+      )
+      .run(id, review.pluginName, review.pluginVersion, review.userId, review.rating, review.comment, createdAt);
+    return { ...review, id, flagged: false, createdAt };
+  }
+
+  getReviews(pluginName: string): Review[] {
+    const rows = this.db
+      .prepare('SELECT * FROM reviews WHERE plugin_name = ?')
+      .all(pluginName) as ReviewRow[];
+    return rows.map(r => this.rowToReview(r));
+  }
+
+  getAverageRating(pluginName: string): number {
+    const row = this.db
+      .prepare('SELECT AVG(rating) as avg FROM reviews WHERE plugin_name = ? AND flagged = 0')
+      .get(pluginName) as { avg: number | null };
+    return row.avg ?? 0;
+  }
+
+  flagReview(reviewId: number): void {
+    this.db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?').run(reviewId);
+  }
+
+  getFlaggedReviews(): Review[] {
+    const rows = this.db.prepare('SELECT * FROM reviews WHERE flagged = 1').all() as ReviewRow[];
+    return rows.map(r => this.rowToReview(r));
+  }
+
+  removeReview(reviewId: number): boolean {
+    const result = this.db.prepare('DELETE FROM reviews WHERE id = ?').run(reviewId);
+    return result.changes > 0;
+  }
+
+  getReviewsByUser(userId: string): Review[] {
+    const rows = this.db
+      .prepare('SELECT * FROM reviews WHERE user_id = ?')
+      .all(userId) as ReviewRow[];
+    return rows.map(r => this.rowToReview(r));
+  }
+
+  getReviewCount(pluginName: string): number {
+    const row = this.db
+      .prepare('SELECT COUNT(*) as count FROM reviews WHERE plugin_name = ?')
+      .get(pluginName) as { count: number };
+    return row.count;
+  }
+}
+
+export function createReviews(): ReviewService {
+  return new Reviews();
+}
