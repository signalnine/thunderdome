+++ b/src/registry/index.ts
@@ -0,0 +1,83 @@
+import Database from 'better-sqlite3';
+import semver from 'semver';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+class Registry implements RegistryService {
+  private db: Database.Database;
+
+  constructor() {
+    this.db = new Database(':memory:');
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS plugins (
+        name TEXT NOT NULL,
+        version TEXT NOT NULL,
+        data TEXT NOT NULL,
+        PRIMARY KEY (name, version)
+      )
+    `);
+  }
+
+  register(manifest: PluginManifest): void {
+    this.db
+      .prepare('INSERT OR REPLACE INTO plugins (name, version, data) VALUES (?, ?, ?)')
+      .run(manifest.name, manifest.version, JSON.stringify(manifest));
+  }
+
+  get(name: string): PluginManifest | null {
+    const versions = this.listVersions(name);
+    if (versions.length === 0) return null;
+    const latest = semver.maxSatisfying(versions, '*');
+    if (!latest) return null;
+    return this.getVersion(name, latest);
+  }
+
+  getVersion(name: string, version: string): PluginManifest | null {
+    const row = this.db
+      .prepare('SELECT data FROM plugins WHERE name = ? AND version = ?')
+      .get(name, version) as { data: string } | undefined;
+    if (!row) return null;
+    return JSON.parse(row.data) as PluginManifest;
+  }
+
+  list(): PluginManifest[] {
+    const rows = this.db.prepare('SELECT data FROM plugins').all() as { data: string }[];
+    return rows.map(r => JSON.parse(r.data) as PluginManifest);
+  }
+
+  search(query: string): PluginManifest[] {
+    const lower = query.toLowerCase();
+    return this.list().filter(
+      m =>
+        m.name.toLowerCase().includes(lower) ||
+        m.description.toLowerCase().includes(lower) ||
+        m.author.toLowerCase().includes(lower)
+    );
+  }
+
+  remove(name: string, version: string): boolean {
+    const result = this.db
+      .prepare('DELETE FROM plugins WHERE name = ? AND version = ?')
+      .run(name, version);
+    return result.changes > 0;
+  }
+
+  listVersions(name: string): string[] {
+    const rows = this.db
+      .prepare('SELECT version FROM plugins WHERE name = ?')
+      .all(name) as { version: string }[];
+    return rows.map(r => r.version);
+  }
+
+  update(name: string, version: string, updates: Partial<PluginManifest>): void {
+    const existing = this.getVersion(name, version);
+    if (!existing) throw new Error(`Plugin ${name}@${version} not found`);
+    const updated = { ...existing, ...updates, name, version };
+    this.db
+      .prepare('UPDATE plugins SET data = ? WHERE name = ? AND version = ?')
+      .run(JSON.stringify(updated), name, version);
+  }
+}
+
+export function createRegistry(): RegistryService {
+  return new Registry();
+}
