--- /dev/null
+++ b/src/deps/index.ts
@@ -0,0 +1,100 @@
+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+class Deps implements DepsService {
+  buildTree(name: string, registry: RegistryService): DependencyNode {
+    return this._buildTree(name, registry, new Set());
+  }
+
+  private _buildTree(name: string, registry: RegistryService, visiting: Set<string>): DependencyNode {
+    const manifest = registry.get(name);
+    if (!manifest) return { name, version: 'unknown', dependencies: [] };
+
+    if (visiting.has(name)) {
+      return { name, version: manifest.version, dependencies: [] };
+    }
+
+    visiting.add(name);
+    const children: DependencyNode[] = Object.keys(manifest.dependencies).map(dep =>
+      this._buildTree(dep, registry, new Set(visiting))
+    );
+    visiting.delete(name);
+
+    return { name, version: manifest.version, dependencies: children };
+  }
+
+  detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const cycles: string[][] = [];
+    const visited = new Set<string>();
+    const stack: string[] = [];
+
+    const dfs = (current: string): void => {
+      const cycleIdx = stack.indexOf(current);
+      if (cycleIdx !== -1) {
+        cycles.push([...stack.slice(cycleIdx), current]);
+        return;
+      }
+      if (visited.has(current)) return;
+
+      visited.add(current);
+      stack.push(current);
+
+      const manifest = registry.get(current);
+      if (manifest) {
+        for (const dep of Object.keys(manifest.dependencies)) {
+          dfs(dep);
+        }
+      }
+
+      stack.pop();
+    };
+
+    dfs(name);
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  topologicalSort(name: string, registry: RegistryService): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>();
+
+    const visit = (current: string): void => {
+      if (visited.has(current)) return;
+      visited.add(current);
+      const manifest = registry.get(current);
+      if (manifest) {
+        for (const dep of Object.keys(manifest.dependencies)) {
+          visit(dep);
+        }
+      }
+      result.push(current);
+    };
+
+    visit(name);
+    return result;
+  }
+
+  flattenDependencies(name: string, registry: RegistryService): string[] {
+    const all = new Set<string>();
+
+    const collect = (current: string): void => {
+      const manifest = registry.get(current);
+      if (!manifest) return;
+      for (const dep of Object.keys(manifest.dependencies)) {
+        if (!all.has(dep)) {
+          all.add(dep);
+          collect(dep);
+        }
+      }
+    };
+
+    collect(name);
+    return Array.from(all);
+  }
+
+  hasCircularDependency(name: string, registry: RegistryService): boolean {
+    return this.detectCycles(name, registry) !== null;
+  }
+}
+
+export function createDeps(): DepsService {
+  return new Deps();
+}
