= createRegistry();\n    expect(registry.remove('nope', '1.0.0')).toBe(false);\n  });\n\n  it('listVersions returns all versions', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.register(makeManifest({ version: '2.0.0' }));\n    const versions = registry.listVersions('test-plugin');\n    expect(versions).toContain('1.0.0');\n    expect(versions).toContain('2.0.0');\n    expect(versions).toHaveLength(2);\n  });\n\n  it('update modifies plugin metadata', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest());\n    registry.update('test-plugin', '1.0.0', { description: 'updated desc' });\n    expect(registry.getVersion('test-plugin', '1.0.0')?.description).toBe('updated desc');\n  });\n\n  it('update preserves name and version', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest());\n    registry.update('test-plugin', '1.0.0', { description: 'new' });\n    const m = registry.getVersion('test-plugin', '1.0.0');\n    expect(m?.name).toBe('test-plugin');\n    expect(m?.version).toBe('1.0.0');\n  });\n\n  it('register replaces an existing version', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ description: 'v1' }));\n    registry.register(makeManifest({ description: 'v2' }));\n    expect(registry.get('test-plugin')?.description).toBe('v2');\n  });\n});\n\n// ── Resolver ─────────────────────────────────────────────────────────────────\n\ndescribe('Resolver', () => {\n  it('resolves a simple constraint', () => {\n    const resolver = createResolver();\n    const result = resolver.resolve(\n      [{ name: 'lodash', range: '^4.0.0' }],\n      { lodash: ['3.0.0', '4.0.0', '4.17.21'] }\n    );\n    expect(result).toHaveLength(1);\n    expect(result[0].version).toBe('4.17.21');\n    expect(result[0].satisfies).toBe('^4.0.0');\n  });\n\n  it('returns nothing for unsatisfiable constraint', () => {\n    const resolver = createResolver();\n    const result = resolver.resolve(\n      [{ name: 'pkg', range: '^5.0.0' }],\n      { pkg: ['1.0.0', '2.0.0'] }\n    );\n    expect(result).toHaveLength(0);\n  });\n\n  it('handles missing package in available map', () => {\n    const resolver = createResolver();\n    const result = resolver.resolve([{ name: 'missing', range: '*' }], {});\n    expect(result).toHaveLength(0);\n  });\n\n  it('resolves multiple constraints', () => {\n    const resolver = createResolver();\n    const result = resolver.resolve(\n      [\n        { name: 'a', range: '^1.0.0' },\n        { name: 'b', range: '^2.0.0' },\n      ],\n      { a: ['1.0.0', '1.5.0'], b: ['2.0.0', '3.0.0'] }\n    );\n    expect(result).toHaveLength(2);\n    expect(result.find(r => r.name === 'a')?.version).toBe('1.5.0');\n    expect(result.find(r => r.name === 'b')?.version).toBe('2.0.0');\n  });\n\n  it('satisfies checks version against range', () => {\n    const resolver = createResolver();\n    expect(resolver.satisfies('1.2.3', '^1.0.0')).toBe(true);\n    expect(resolver.satisfies('2.0.0', '^1.0.0')).toBe(false);\n  });\n\n  it('maxSatisfying picks the best version', () => {\n    const resolver = createResolver();\n    expect(resolver.maxSatisfying(['1.0.0', '1.5.0', '2.0.0'], '^1.0.0')).toBe('1.5.0');\n    expect(resolver.maxSatisfying(['1.0.0'], '^2.0.0')).toBeNull();\n    expect(resolver.maxSatisfying([], '^1.0.0')).toBeNull();\n  });\n\n  it('validRange validates semver ranges', () => {\n    const resolver = createResolver();\n    expect(resolver.validRange('^1.0.0')).toBe(true);\n    expect(resolver.validRange('~2.3.0')).toBe(true);\n    expect(resolver.validRange('*')).toBe(true);\n    expect(resolver.validRange('not-a-range')).toBe(false);\n  });\n});\n\n// ── Runner ────────────────────────────────────────────────────────────────────\n\ndescribe('Runner', () => {\n  it('executes a simple expression', async () => {\n    const runner = createRunner();\n    const result = await runner.execute('1 + 1');\n    expect(result.success).toBe(true);\n    expect(result.output).toBe(2);\n  });\n\n  it('captures console.log output', async () => {\n    const runner = createRunner();\n    const result = await runner.execute('console.log(\"hello\"); undefined');\n    expect(result.success).toBe(true);\n    expect(result.output).toBe('hello');\n  });\n\n  it('handles runtime errors gracefully', async () => {\n    const runner = createRunner();\n    const result = await runner.execute('throw new Error(\"boom\")');\n    expect(result.success).toBe(false);\n    expect(result.error).toContain('boom');\n  });\n\n  it('supports context variables', async () => {\n    const runner = createRunner();\n    const result = await runner.execute('x + y', { x: 3, y: 4 });\n    expect(result.success).toBe(true);\n    expect(result.output).toBe(7);\n  });\n\n  it('enforces timeout on infinite loops', async () => {\n    const runner = createRunner();\n    const result = await runner.executeWithTimeout('while(true){}', 100);\n    expect(result.success).toBe(false);\n    expect(result.error).toBeDefined();\n  }, 3000);\n\n  it('returns numeric duration and memoryUsed', async () => {\n    const runner = createRunner();\n    const result = await runner.execute('42');\n    expect(typeof result.duration).toBe('number');\n    expect(result.duration).toBeGreaterThanOrEqual(0);\n    expect(typeof result.memoryUsed).toBe('number');\n  });\n\n  it('returns null output for undefined result with no logs', async () => {\n    const runner = createRunner();\n    const result = await runner.execute('undefined');\n    expect(result.success).toBe(true);\n    expect(result.output).toBeNull();\n  });\n\n  it('sandboxes code from the host environment', async () => {\n    const runner = createRunner();\n    const result = await runner.execute('typeof require');\n    expect(result.success).toBe(true);\n    expect(result.output).toBe('undefined');\n  });\n});\n\n// ── Reviews ───────────────────────────────────────────────────────────────────\n\ndescribe('Reviews', () => {\n  it('adds and retrieves a review', () => {\n    const reviews = createReviews();\n    const r = reviews.addReview({\n      pluginName: 'foo',\n      pluginVersion: '1.0.0',\n      userId: 'u1',\n      rating: 5,\n      comment: 'great',\n    });\n    expect(r.id).toBeDefined();\n    expect(r.flagged).toBe(false);\n    expect(reviews.getReviews('foo')).toHaveLength(1);\n  });\n\n  it('computes average rating excluding flagged reviews', () => {\n    const reviews = createReviews();\n    reviews.addReview({ pluginName: 'foo', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'great' });\n    const r2 = reviews.addReview({ pluginName: 'foo', pluginVersion: '1.0.0', userId: 'u2', rating: 1, comment: 'bad' });\n    reviews.flagReview(r2.id);\n    expect(reviews.getAverageRating('foo')).toBe(5);\n  });\n\n  it('flags a review', () => {\n    const reviews = createReviews();\n    const r = reviews.addReview({ pluginName: 'foo', pluginVersion: '1.0.0', userId: 'u1', rating: 3, comment: 'ok' });\n    reviews.flagReview(r.id);\n    const flagged = reviews.getFlaggedReviews();\n    expect(flagged).toHaveLength(1);\n    expect(flagged[0].flagged).toBe(true);\n  });\n\n  it('removes a review', () => {\n    const reviews = createReviews();\n    const r = reviews.addReview({ pluginName: 'foo', pluginVersion: '1.0.0', userId: 'u1', rating: 3, comment: 'ok' });\n    expect(reviews.removeReview(r.id)).toBe(true);\n    expect(reviews.getReviews('foo')).toHaveLength(0);\n  });\n\n  it('removeReview returns false for non-existent id', () => {\n    const reviews = createReviews();\n    expect(reviews.removeReview(999)).toBe(false);\n  });\n\n  it('getReviewsByUser returns only that user\\'s reviews', () => {\n    const reviews = createReviews();\n    reviews.addReview({ pluginName: 'foo', pluginVersion: '1.0.0', userId: 'u1', rating: 4, comment: 'nice' });\n    reviews.addReview({ pluginName: 'bar', pluginVersion: '1.0.0', userId: 'u1', rating: 3, comment: 'ok' });\n    reviews.addReview({ pluginName: 'baz', pluginVersion: '1.0.0', userId: 'u2', rating: 5, comment: 'wow' });\n    expect(reviews.getReviewsByUser('u1')).toHaveLength(2);\n    expect(reviews.getReviewsByUser('u2')).toHaveLength(1);\n  });\n\n  it('getReviewCount returns the total count', () => {\n    const reviews = createReviews();\n    reviews.addReview({ pluginName: 'foo', pluginVersion: '1.0.0', userId: 'u1', rating: 4, comment: 'nice' });\n    reviews.addReview({ pluginName: 'foo', pluginVersion: '1.0.0', userId: 'u2', rating: 3, comment: 'ok' });\n    expect(reviews.getReviewCount('foo')).toBe(2);\n    expect(reviews.getReviewCount('bar')).toBe(0);\n  });\n\n  it('returns 0 average for unknown plugin', () => {\n    const reviews = createReviews();\n    expect(reviews.getAverageRating('unknown')).toBe(0);\n  });\n\n  it('ids are unique across reviews', () => {\n    const reviews = createReviews();\n    const r1 = reviews.addReview({ pluginName: 'foo', pluginVersion: '1.0.0', userId: 'u1', rating: 4, comment: 'a' });\n    const r2 = reviews.addReview({ pluginName: 'foo', pluginVersion: '1.0.0', userId: 'u2', rating: 5, comment: 'b' });\n    expect(r1.id).not.toBe(r2.id);\n  });\n});\n\n// ── Deps ─────────────────────────────────────────────────────────────────────\n\ndescribe('Deps', () => {\n  it('builds a simple dependency tree', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'root', dependencies: { child: '^1.0.0' } }));\n    registry.register(makeManifest({ name: 'child', version: '1.0.0', dependencies: {} }));\n    const deps = createDeps();\n    const tree = deps.buildTree('root', registry);\n    expect(tree.name).toBe('root');\n    expect(tree.dependencies).toHaveLength(1);\n    expect(tree.dependencies[0].name).toBe('child');\n  });\n\n  it('builds a tree with unknown dep as leaf', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'root', dependencies: { ghost: '*' } }));\n    const deps = createDeps();\n    const tree = deps.buildTree('root', registry);\n    expect(tree.dependencies[0].name).toBe('ghost');\n    expect(tree.dependencies[0].version).toBe('unknown');\n  });\n\n  it('detects circular dependencies', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'a', dependencies: { b: '*' } }));\n    registry.register(makeManifest({ name: 'b', dependencies: { a: '*' } }));\n    const deps = createDeps();\n    const cycles = deps.detectCycles('a', registry);\n    expect(cycles).not.toBeNull();\n    expect(cycles!.length).toBeGreaterThan(0);\n  });\n\n  it('returns null when no cycles exist', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'a', dependencies: { b: '*' } }));\n    registry.register(makeManifest({ name: 'b', dependencies: {} }));\n    const deps = createDeps();\n    expect(deps.detectCycles('a', registry)).toBeNull();\n  });\n\n  it('topologicalSort places dependencies before dependents', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'a', dependencies: { b: '*', c: '*' } }));\n    registry.register(makeManifest({ name: 'b', dependencies: { c: '*' } }));\n    registry.register(makeManifest({ name: 'c', dependencies: {} }));\n    const deps = createDeps();\n    const sorted = deps.topologicalSort('a', registry);\n    expect(sorted.indexOf('c')).toBeLessThan(sorted.indexOf('b'));\n    expect(sorted.indexOf('b')).toBeLessThan(sorted.indexOf('a'));\n  });\n\n  it('flattenDependencies returns all transitive deps without duplicates', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'a', dependencies: { b: '*', c: '*' } }));\n    registry.register(makeManifest({ name: 'b', dependencies: { c: '*' } }));\n    registry.register(makeManifest({ name: 'c', dependencies: {} }));\n    const deps = createDeps();\n    const flat = deps.flattenDependencies('a', registry);\n    expect(flat).toContain('b');\n    expect(flat).toContain('c');\n    expect(flat.filter(x => x === 'c')).toHaveLength(1);\n  });\n\n  it('hasCircularDependency returns false for acyclic graph', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'a', dependencies: { b: '*' } }));\n    registry.register(makeManifest({ name: 'b', dependencies: {} }));\n    expect(createDeps().hasCircularDependency('a', registry)).toBe(false);\n  });\n\n  it('hasCircularDependency returns true for cyclic graph', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'x', dependencies: { y: '*' } }));\n    registry.register(makeManifest({ name: 'y', dependencies: { x: '*' } }));\n    expect(createDeps().hasCircularDependency('x', registry)).toBe(true);\n  });\n\n  it('flattenDependencies returns empty for plugin with no deps', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'leaf', dependencies: {} }));\n    expect(createDeps().flattenDependencies('leaf', registry)).toHaveLength(0);\n  });\n});\n\n// ── Marketplace Integration ───────────────────────────────────────────────────\n\ndescribe('Marketplace Integration', () => {\n  it('installPlugin registers, resolves deps, and executes entry point', async () => {\n    const mp = createMarketplace();\n    mp.registry.register(makeManifest({ name: 'dep-a', version: '1.2.0', dependencies: {} }));\n    const result = await mp.installPlugin(\n      makeManifest({\n        name: 'my-plugin',\n        version: '1.0.0',\n        dependencies: { 'dep-a': '^1.0.0' },\n        entryPoint: '42',\n      })\n    );\n    expect(result.sandboxResult.success).toBe(true);\n    expect(result.sandboxResult.output).toBe(42);\n    expect(result.resolvedDeps).toHaveLength(1);\n    expect(result.resolvedDeps[0].name).toBe('dep-a');\n    expect(result.resolvedDeps[0].version).toBe('1.2.0');\n  });\n\n  it('throws on missing name field', async () => {\n    const mp = createMarketplace();\n    await expect(\n      mp.installPlugin(makeManifest({ name: '' }))\n    ).rejects.toThrow();\n  });\n\n  it('throws on missing entryPoint field', async () => {\n    const mp = createMarketplace();\n    await expect(\n      mp.installPlugin(makeManifest({ entryPoint: '' }))\n    ).rejects.toThrow();\n  });\n\n  it('throws on circular dependency', async () => {\n    const mp = createMarketplace();\n    mp.registry.register(\n      makeManifest({ name: 'circ-b', version: '1.0.0', dependencies: { 'circ-a': '*' } })\n    );\n    await expect(\n      mp.installPlugin(\n        makeManifest({ name: 'circ-a', version: '1.0.0', dependencies: { 'circ-b': '*' }, entryPoint: '1' })\n      )\n    ).rejects.toThrow('Circular');\n  });\n\n  it('exposes all five services', () => {\n    const mp = createMarketplace();\n    expect(mp.registry).toBeDefined();\n    expect(mp.resolver).toBeDefined();\n    expect(mp.runner).toBeDefined();\n    expect(mp.reviews).toBeDefined();\n    expect(mp.deps).toBeDefined();\n  });\n\n  it('installPlugin with no deps succeeds', async () => {\n    const mp = createMarketplace();\n    const result = await mp.installPlugin(makeManifest({ entryPoint: '\"hello\"' }));\n    expect(result.sandboxResult.success).toBe(true);\n    expect(result.resolvedDeps).toHaveLength(0);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
