--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,71 @@
+import type {
+  PluginManifest,
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+  ResolvedVersion,
+  SandboxResult,
+  VersionConstraint,
+} from './types.js';
+import { createRegistry } from './registry/index.js';
+import { createResolver } from './resolver/index.js';
+import { createRunner } from './runner/index.js';
+import { createReviews } from './reviews/index.js';
+import { createDeps } from './deps/index.js';
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest): Promise<{
+    resolvedDeps: ResolvedVersion[];
+    sandboxResult: SandboxResult;
+  }>;
+}
+
+export function createMarketplace(): Marketplace {
+  const registry = createRegistry();
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviews();
+  const deps = createDeps();
+
+  async function installPlugin(manifest: PluginManifest): Promise<{
+    resolvedDeps: ResolvedVersion[];
+    sandboxResult: SandboxResult;
+  }> {
+    if (!manifest.name || !manifest.version || !manifest.entryPoint) {
+      throw new Error('Plugin manifest missing required fields: name, version, entryPoint');
+    }
+
+    registry.register(manifest);
+
+    const constraints: VersionConstraint[] = Object.entries(manifest.dependencies).map(
+      ([name, range]) => ({ name, range })
+    );
+    const available: Record<string, string[]> = {};
+    for (const m of registry.list()) {
+      if (!available[m.name]) available[m.name] = [];
+      if (!available[m.name].includes(m.version)) {
+        available[m.name].push(m.version);
+      }
+    }
+    const resolvedDeps = resolver.resolve(constraints, available);
+
+    if (deps.hasCircularDependency(manifest.name, registry)) {
+      throw new Error(`Circular dependency detected for plugin ${manifest.name}`);
+    }
+
+    const sandboxResult = await runner.execute(manifest.entryPoint);
+
+    return { resolvedDeps, sandboxResult };
+  }
+
+  return { registry, resolver, runner, reviews, deps, installPlugin };
+}
+
+export type { PluginManifest, VersionConstraint, ResolvedVersion, SandboxResult } from './types.js';
