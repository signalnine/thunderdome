LECT data FROM plugins WHERE name = ? AND version = ?').get(name, version) as { data: string } | undefined;\n    if (!row) return null;\n    return JSON.parse(row.data) as PluginManifest;\n  }\n\n  list(): PluginManifest[] {\n    const rows = this.db.prepare('SELECT data FROM plugins').all() as { data: string }[];\n    return rows.map(r => JSON.parse(r.data) as PluginManifest);\n  }\n\n  search(query: string): PluginManifest[] {\n    const lower = query.toLowerCase();\n    const rows = this.db.prepare('SELECT data FROM plugins').all() as { data: string }[];\n    return rows\n      .map(r => JSON.parse(r.data) as PluginManifest)\n      .filter(m =>\n        m.name.toLowerCase().includes(lower) ||\n        m.description.toLowerCase().includes(lower) ||\n        m.author.toLowerCase().includes(lower)\n      );\n  }\n\n  remove(name: string, version: string): boolean {\n    const result = this.db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?').run(name, version);\n    return result.changes > 0;\n  }\n\n  listVersions(name: string): string[] {\n    const rows = this.db.prepare('SELECT version FROM plugins WHERE name = ?').all(name) as { version: string }[];\n    return rows.map(r => r.version);\n  }\n\n  update(name: string, version: string, updates: Partial<PluginManifest>): void {\n    const existing = this.getVersion(name, version);\n    if (!existing) throw new Error(\\`Plugin \\${name}@\\${version} not found\\`);\n    const updated = { ...existing, ...updates, name, version };\n    this.db.prepare('UPDATE plugins SET data = ? WHERE name = ? AND version = ?').run(JSON.stringify(updated), name, version);\n  }\n}\n\nexport function createRegistry(): RegistryService {\n  return new Registry();\n}\n\nWrite only the file content, no extra explanation. Use the Write tool.`, { label: 'registry-module' }),\n\n  () => agent(`Write the file /workspace/src/resolver/index.ts with this exact content:\n\nimport semver from 'semver';\nimport type { VersionConstraint, ResolvedVersion, ResolverService } from '../types.js';\n\nclass Resolver implements ResolverService {\n  resolve(constraints: VersionConstraint[], available: Record<string, string[]>): ResolvedVersion[] {\n    const results: ResolvedVersion[] = [];\n    for (const constraint of constraints) {\n      const versions = available[constraint.name] ?? [];\n      const best = semver.maxSatisfying(versions, constraint.range);\n      if (best) {\n        results.push({ name: constraint.name, version: best, satisfies: constraint.range });\n      }\n    }\n    return results;\n  }\n\n  satisfies(version: string, range: string): boolean {\n    return semver.satisfies(version, range);\n  }\n\n  maxSatisfying(versions: string[], range: string): string | null {\n    return semver.maxSatisfying(versions, range);\n  }\n\n  validRange(range: string): boolean {\n    return semver.validRange(range) !== null;\n  }\n}\n\nexport function createResolver(): ResolverService {\n  return new Resolver();\n}\n\nWrite only the file content, no extra explanation. Use the Write tool.`, { label: 'resolver-module' }),\n\n  () => agent(`Write the file /workspace/src/runner/index.ts with this exact content:\n\nimport vm from 'node:vm';\nimport type { RunnerService, SandboxResult } from '../types.js';\n\nconst DEFAULT_TIMEOUT = 5000;\n\nclass Runner implements RunnerService {\n  async execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult> {\n    return this.executeWithTimeout(code, DEFAULT_TIMEOUT, context);\n  }\n\n  async executeWithTimeout(code: string, timeoutMs: number, context?: Record<string, unknown>): Promise<SandboxResult> {\n    const startMemory = process.memoryUsage().heapUsed;\n    const startTime = Date.now();\n\n    const output: unknown[] = [];\n    const sandbox: Record<string, unknown> = {\n      console: {\n        log: (...args: unknown[]) => { output.push(args.length === 1 ? args[0] : args); },\n        error: (...args: unknown[]) => { output.push(args.length === 1 ? args[0] : args); },\n        warn: (...args: unknown[]) => { output.push(args.length === 1 ? args[0] : args); },\n      },\n      ...(context ?? {}),\n    };\n\n    try {\n      vm.createContext(sandbox);\n      const rawResult = vm.runInContext(code, sandbox, { timeout: timeoutMs });\n\n      let finalResult: unknown = rawResult;\n      if (rawResult != null && typeof rawResult === 'object' && typeof (rawResult as { then?: unknown }).then === 'function') {\n        const timeoutPromise = new Promise<never>((_, reject) =>\n          setTimeout(() => reject(new Error(\\`Script timed out after \\${timeoutMs}ms\\`)), timeoutMs)\n        );\n        finalResult = await Promise.race([rawResult as Promise<unknown>, timeoutPromise]);\n      }\n\n      const duration = Date.now() - startTime;\n      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - startMemory);\n\n      const out =\n        finalResult !== undefined\n          ? finalResult\n          : output.length > 0\n          ? output.length === 1\n            ? output[0]\n            : output\n          : null;\n\n      return { success: true, output: out, duration, memoryUsed };\n    } catch (err) {\n      const duration = Date.now() - startTime;\n      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - startMemory);\n      return {\n        success: false,\n        output: null,\n        duration,\n        memoryUsed,\n        error: err instanceof Error ? err.message : String(err),\n      };\n    }\n  }\n}\n\nexport function createRunner(): RunnerService {\n  return new Runner();\n}\n\nWrite only the file content, no extra explanation. Use the Write tool.`, { label: 'runner-module' }),\n\n  () => agent(`Write the file /workspace/src/reviews/index.ts with this exact content:\n\nimport Database from 'better-sqlite3';\nimport type { Review, ReviewService } from '../types.js';\n\ninterface ReviewRow {\n  id: number;\n  plugin_name: string;\n  plugin_version: string;\n  user_id: string;\n  rating: number;\n  comment: string;\n  flagged: number;\n  created_at: string;\n}\n\nclass Reviews implements ReviewService {\n  private db: Database.Database;\n  private nextId = 1;\n\n  constructor() {\n    this.db = new Database(':memory:');\n    this.db.exec(\\`\n      CREATE TABLE IF NOT EXISTS reviews (\n        id INTEGER PRIMARY KEY,\n        plugin_name TEXT NOT NULL,\n        plugin_version TEXT NOT NULL,\n        user_id TEXT NOT NULL,\n        rating INTEGER NOT NULL,\n        comment TEXT NOT NULL,\n        flagged INTEGER NOT NULL DEFAULT 0,\n        created_at TEXT NOT NULL\n      )\n    \\`);\n  }\n\n  private rowToReview(row: ReviewRow): Review {\n    return {\n      id: row.id,\n      pluginName: row.plugin_name,\n      pluginVersion: row.plugin_version,\n      userId: row.user_id,\n      rating: row.rating,\n      comment: row.comment,\n      flagged: row.flagged === 1,\n      createdAt: row.created_at,\n    };\n  }\n\n  addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {\n    const id = this.nextId++;\n    const createdAt = new Date().toISOString();\n    this.db.prepare(\n      'INSERT INTO reviews (id, plugin_name, plugin_version, user_id, rating, comment, flagged, created_at) VALUES (?, ?, ?, ?, ?, ?, 0, ?)'\n    ).run(id, review.pluginName, review.pluginVersion, review.userId, review.rating, review.comment, createdAt);\n    return { ...review, id, flagged: false, createdAt };\n  }\n\n  getReviews(pluginName: string): Review[] {\n    const rows = this.db.prepare('SELECT * FROM reviews WHERE plugin_name = ?').all(pluginName) as ReviewRow[];\n    return rows.map(r => this.rowToReview(r));\n  }\n\n  getAverageRating(pluginName: string): number {\n    const row = this.db\n      .prepare('SELECT AVG(rating) as avg FROM reviews WHERE plugin_name = ? AND flagged = 0')\n      .get(pluginName) as { avg: number | null };\n    return row.avg ?? 0;\n  }\n\n  flagReview(reviewId: number): void {\n    this.db.prepare('UPDATE 