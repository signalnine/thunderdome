+import vm from 'node:vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT = 5000;
+
+class Runner implements RunnerService {
+  async execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult> {
+    return this.executeWithTimeout(code, DEFAULT_TIMEOUT, context);
+  }
+
+  async executeWithTimeout(
+    code: string,
+    timeoutMs: number,
+    context?: Record<string, unknown>
+  ): Promise<SandboxResult> {
+    const startMemory = process.memoryUsage().heapUsed;
+    const startTime = Date.now();
+
+    const output: unknown[] = [];
+    const sandbox: Record<string, unknown> = {
+      console: {
+        log: (...args: unknown[]) => { output.push(args.length === 1 ? args[0] : args); },
+        error: (...args: unknown[]) => { output.push(args.length === 1 ? args[0] : args); },
+        warn: (...args: unknown[]) => { output.push(args.length === 1 ? args[0] : args); },
+      },
+      ...(context ?? {}),
+    };
+
+    try {
+      vm.createContext(sandbox);
+      const rawResult = vm.runInContext(code, sandbox, { timeout: timeoutMs });
+
+      let finalResult: unknown = rawResult;
+      if (
+        rawResult != null &&
+        typeof rawResult === 'object' &&
+        typeof (rawResult as { then?: unknown }).then === 'function'
+      ) {
+        const timeoutPromise = new Promise<never>((_, reject) =>
+          setTimeout(
+            () => reject(new Error(`Script timed out after ${timeoutMs}ms`)),
+            timeoutMs
+          )
+        );
+        finalResult = await Promise.race([rawResult as Promise<unknown>, timeoutPromise]);
+      }
+
+      const duration = Date.now() - startTime;
+      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - startMemory);
+
+      const out =
+        finalResult !== undefined
+          ? finalResult
+          : output.length > 0
+          ? output.length === 1
+            ? output[0]
+            : output
+          : null;
+
+      return { success: true, output: out, duration, memoryUsed };
+    } catch (err) {
+      const duration = Date.now() - startTime;
+      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - startMemory);
+      return {
+        success: false,
+        output: null,
+        duration,
+        memoryUsed,
+        error: err instanceof Error ? err.message : String(err),
+      };
+    }
+  }
+}
+
+export function createRunner(): RunnerService {
+  return new Runner();
+}
