+
+const makeManifest = (overrides: Partial<PluginManifest> = {}): PluginManifest => ({
+  name: 'test-plugin',
+  version: '1.0.0',
+  description: 'A test plugin',
+  author: 'tester',
+  dependencies: {},
+  entryPoint: '1 + 1',
+  permissions: [],
+  ...overrides,
+});
+
+// ── Registry ──────────────────────────────────────────────────────────────────
+
+describe('Registry', () => {
+  it('registers and retrieves a plugin', () => {
+    const registry = createRegistry();
