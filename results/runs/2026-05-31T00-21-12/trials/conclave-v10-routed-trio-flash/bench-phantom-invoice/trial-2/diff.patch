s/invoices.test.ts","content":"// Force a non-UTC timezone so timezone-sensitive bugs are exposed\nprocess.env.TZ = 'America/New_York';\n\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport type Database from 'better-sqlite3';\nimport { createDatabase } from '../src/db/connection.js';\nimport {\n  getInvoicesByDateRange,\n  getInvoiceById,\n  createInvoice,\n  getInvoicesByCustomer,\n} from '../src/db/queries.js';\nimport {\n  calculateInvoiceTotal,\n  applyDiscount,\n  calculateSubtotal,\n  generateInvoice,\n} from '../src/services/billing.js';\nimport { getMonthlyReport, getCustomerReport, getRevenueByPeriod } from '../src/services/reporting.js';\n\nlet db: Database.Database;\n\nbeforeEach(() => {\n  db = createDatabase(':memory:');\n});\n\n// ─── Invoice CRUD (8 tests) ────────────────────────────────────────\n\ndescribe('Invoice CRUD', () => {\n  it('creates an invoice and returns its ID', () => {\n    const id = createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-03-15',\n      subtotal: 100,\n      discount_rate: 0,\n      tax_rate: 0.1,\n      total: 110,\n      status: 'draft',\n    });\n    expect(id).toBe(1);\n  });\n\n  it('retrieves an invoice by ID', () => {\n    const id = createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-03-15',\n      subtotal: 200,\n      discount_rate: 0.1,\n      tax_rate: 0.08,\n      total: 194.40,\n      status: 'sent',\n    });\n    const invoice = getInvoiceById(db, id);\n    expect(invoice).toBeDefined();\n    expect(invoice!.customer_id).toBe('cust-1');\n    expect(invoice!.subtotal).toBe(200);\n  });\n\n  it('returns undefined for non-existent invoice', () => {\n    const invoice = getInvoiceById(db, 999);\n    expect(invoice).toBeUndefined();\n  });\n\n  it('creates an invoice with line items', () => {\n    const id = createInvoice(db, {\n      customer_id: 'cust-2',\n      date: '2024-04-01',\n      subtotal: 250,\n      discount_rate: 0,\n      tax_rate: 0.05,\n      total: 262.50,\n      status: 'draft',\n      line_items: [\n        { description: 'Widget A', quantity: 5, unit_price: 30 },\n        { description: 'Widget B', quantity: 2, unit_price: 50 },\n      ],\n    });\n    const invoice = getInvoiceById(db, id);\n    expect(invoice!.line_items).toHaveLength(2);\n    expect(invoice!.line_items[0].description).toBe('Widget A');\n  });\n\n  it('lists invoices by customer', () => {\n    createInvoice(db, {\n      customer_id: 'cust-A',\n      date: '2024-01-10',\n      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'paid',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-B',\n      date: '2024-01-12',\n      subtotal: 200, discount_rate: 0, tax_rate: 0, total: 200, status: 'paid',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-A',\n      date: '2024-02-05',\n      subtotal: 150, discount_rate: 0, tax_rate: 0, total: 150, status: 'draft',\n    });\n\n    const invoices = getInvoicesByCustomer(db, 'cust-A');\n    expect(invoices).toHaveLength(2);\n    expect(invoices.every(inv => inv.customer_id === 'cust-A')).toBe(true);\n  });\n\n  it('returns invoices sorted by date', () => {\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-03-15',\n      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'draft',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-01-10',\n      subtotal: 200, discount_rate: 0, tax_rate: 0, total: 200, status: 'draft',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-02-20',\n      subtotal: 150, discount_rate: 0, tax_rate: 0, total: 150, status: 'draft',\n    });\n\n    const invoices = getInvoicesByDateRange(db, '2024-01-01', '2024-12-31');\n    expect(invoices[0].date).toBe('2024-01-10');\n    expect(invoices[1].date).toBe('2024-02-20');\n    expect(invoices[2].date).toBe('2024-03-15');\n  });\n\n  it('stores invoice status correctly', () => {\n    const id = createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-06-01',\n      subtotal: 500, discount_rate: 0.05, tax_rate: 0.1, total: 522.50,\n      status: 'paid',\n    });\n    const invoice = getInvoiceById(db, id);\n    expect(invoice!.status).toBe('paid');\n  });\n\n  it('calculates subtotal from line items', () => {\n    const items = [\n      { description: 'Item A', quantity: 3, unit_price: 10 },\n      { description: 'Item B', quantity: 1, unit_price: 25.50 },\n      { description: 'Item C', quantity: 2, unit_price: 7.25 },\n    ];\n    expect(calculateSubtotal(items)).toBe(70);\n  });\n});\n\n// ─── Billing Calculations (8 tests) ────────────────────────────────\n\ndescribe('Billing Calculations', () => {\n  it('calculates total without discount', () => {\n    // subtotal=100, no discount, 10% tax => 110\n    const total = calculateInvoiceTotal(100, 0, 0.1);\n    expect(total).toBe(110);\n  });\n\n  it('calculates total with 10% discount', () => {\n    // subtotal=200, 10% discount => 180, then 8% tax => 194.40\n    const total = calculateInvoiceTotal(200, 0.1, 0.08);\n    expect(total).toBe(194.40);\n  });\n\n  it('calculates total with 25% discount and 8% tax', () => {\n    // subtotal=400, 25% discount => 300, 8% tax => 324\n    const total = calculateInvoiceTotal(400, 0.25, 0.08);\n    expect(total).toBe(324);\n  });\n\n  it('applies discount correctly', () => {\n    expect(applyDiscount(200, 0.15)).toBe(170);\n  });\n\n  it('handles zero tax rate', () => {\n    const total = calculateInvoiceTotal(500, 0.2, 0);\n    expect(total).toBe(400);\n  });\n\n  it('handles zero subtotal', () => {\n    const total = calculateInvoiceTotal(0, 0.1, 0.08);\n    expect(total).toBe(0);\n  });\n\n  it('generates invoice with correct total', () => {\n    const id = generateInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-05-10',\n      discount_rate: 0,\n      tax_rate: 0.08,\n      line_items: [\n        { description: 'Service', quantity: 1, unit_price: 1000 },\n      ],\n    });\n    const invoice = getInvoiceById(db, id);\n    // 1000 * 1.0 * 1.08 = 1080\n    expect(invoice!.total).toBe(1080);\n  });\n\n  it('generates invoice with multiple line items and discount', () => {\n    const id = generateInvoice(db, {\n      customer_id: 'cust-2',\n      date: '2024-07-20',\n      discount_rate: 0.15,\n      tax_rate: 0,\n      line_items: [\n        { description: 'Product A', quantity: 10, unit_price: 50 },\n        { description: 'Product B', quantity: 5, unit_price: 100 },\n      ],\n    });\n    const invoice = getInvoiceById(db, id);\n    // subtotal = 500 + 500 = 1000\n    // discounted = 1000 * 0.85 = 850\n    // total = 850 * 1.0 = 850\n    expect(invoice!.total).toBe(850);\n  });\n});\n\n// ─── Date Range Queries (7 tests) ──────────────────────────────────\n\ndescribe('Date Range Queries', () => {\n  beforeEach(() => {\n    // Seed some invoices across different dates\n    const dates = [\n      '2024-01-15', '2024-01-31', '2024-02-01',\n      '2024-02-28', '2024-03-01', '2024-03-31',\n      '2024-06-30',\n    ];\n    dates.forEach((date, i) => {\n      createInvoice(db, {\n        customer_id: `cust-${i}`,\n        date,\n        subtotal: (i + 1) * 100,\n        discount_rate: 0,\n        tax_rate: 0,\n        total: (i + 1) * 100,\n        status: 'paid',\n      });\n    });\n  });\n\n  it('returns invoices within a date range', () => {\n    const invoices = getInvoicesByDateRange(db, '2024-02-01', '2024-03-15');\n    expect(invoices).toHaveLength(3);\n  });\n\n  it('returns empty array when no invoices match', () => {\n    const invoices = getInvoicesByDateRange(db, '2025-01-01', '2025-12-31');\n    expect(invoices).toHaveLength(0);\n  });\n\n  it('includes invoices on start date boundary', () => {\n    const invoices = getInvoicesByDateRange(db, '2024-01-15', '2024-01-20');\n    expect(invoices).toHaveLength(1);\n    expect(invoices[0].date).toBe('2024-01-15');\n  });\n\n  it('includes invoices on end date boundary', () => {\n    // Should include the invoice on 2024-03-31\n    const invoices = getInvoicesByDateRange(db, '2024-03-15', '2024-03-31');\n    expect(invoices).toHaveLength(1);\n    expect(invoices[0].date).toBe('2024-03-31');\n  });\n\n  it('handles single-month range correctly', () => {\n    const invoices = getInvoicesByDateRange(db, '2024-02-01', '2024-02-29');\n    expect(invoices).toHaveLength(2);\n  });\n\n  it('returns all invoices for full year range', () => {\n    const invoices = getInvoicesByDateRange(db, '2024-01-01', '2024-12-31');\n    expect(invoices).toHaveLength(7);\n  });\n\n  it('handles cross-month boundary range', () => {\n    // Jan 15 to Mar 02 should span across months\n    const invoices = getInvoicesByDateRange(db, '2024-01-15', '2024-03-02');\n    expect(invoices).toHaveLength(5);\n  });\n});\n\n// ─── Monthly Reporting (7 tests) ───────────────────────────────────\n\ndescribe('Monthly Reporting', () => {\n  beforeEach(() => {\n    // Seed invoices across months (avoiding 1st-of-month dates in seed data)\n    const data: { date: string; total: number }[] = [\n      { date: '2024-01-10', total: 100 },\n      { date: '2024-01-25', total: 200 },\n      { date: '2024-02-15', total: 300 },\n      { date: '2024-03-10', total: 400 },\n      { date: '2024-03-20', total: 150 },\n    ];\n    data.forEach(({ date, total }) => {\n      createInvoice(db, {\n        customer_id: 'cust-1',\n        date,\n        subtotal: total,\n        discount_rate: 0,\n        tax_rate: 0,\n        total,\n        status: 'paid',\n      });\n    });\n  });\n\n  it('generates monthly report with correct counts', () => {\n    const report = getMonthlyReport(db, 2024);\n    expect(report).toHaveLength(3);\n    expect(report[0].count).toBe(2); // January\n    expect(report[1].count).toBe(1); // February\n    expect(report[2].count).toBe(2); // March\n  });\n\n  it('generates monthly report with correct totals', () => {\n    const report = getMonthlyReport(db, 2024);\n    expect(report[0].total_revenue).toBe(300); // Jan: 100 + 200\n    expect(report[1].total_revenue).toBe(300); // Feb: 300\n    expect(report[2].total_revenue).toBe(550); // Mar: 400 + 150\n  });\n\n  it('returns empty report for year with no invoices', () => {\n    const report = getMonthlyReport(db, 2025);\n    expect(report).toHaveLength(0);\n  });\n\n  it('groups invoices correctly at month boundaries', () => {\n    // Add invoices at exact month boundaries\n    createInvoice(db, {\n      customer_id: 'cust-2',\n      date: '2024-01-31',\n      subtotal: 50, discount_rate: 0, tax_rate: 0, total: 50, status: 'paid',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-2',\n      date: '2024-02-01',\n      subtotal: 75, discount_rate: 0, tax_rate: 0, total: 75, status: 'paid',\n    });\n\n    const report = getMonthlyReport(db, 2024);\n    const jan = report.find(r => r.month === 1)!;\n    const feb = report.find(r => r.month === 2)!;\n\n    // Jan should have 3 invoices (10th, 25th, 31st) = 100 + 200 + 50 = 350\n    expect(jan.count).toBe(3);\n    expect(jan.total_revenue).toBe(350);\n\n    // Feb should have 2 invoices (15th, 1st) = 300 + 75 = 375\n    expect(feb.count).toBe(2);\n    expect(feb.total_revenue).toBe(375);\n  });\n\n  it('reports correct year in summaries', () => {\n    const report = getMonthlyReport(db, 2024);\n    expect(report.every(r => r.year === 2024)).toBe(true);\n  });\n\n  it('calculates customer report correctly', () => {\n    const report = getCustomerReport(db, 'cust-1');\n    expect(report.invoice_count).toBe(5);\n    expect(report.total_spent).toBe(1150);\n    expect(report.average_invoice).toBe(230);\n  });\n\n  it('calculates revenue by period', () => {\n    const result = getRevenueByPeriod(db, '2024-01-01', '2024-02-28');\n    expect(result.count).toBe(3);\n    expect(result.total).toBe(600); // 100 + 200 + 300\n  });\n});\n","numLines":370,"startLine":1,"totalLines":370}}}
