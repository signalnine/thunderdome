, out: 'z00' });\n  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });\n\n  for (let i = 1; i < n; i++) {\n    const xi = `x${pad(i)}`, yi = `y${pad(i)}`, zi = `z${pad(i)}`;\n    const prevC = `c${pad(i - 1)}`;\n    const ti = `t${pad(i)}`, ai = `a${pad(i)}`, bi = `b${pad(i)}`;\n\n    gates.push({ op: 'XOR', in1: xi, in2: yi, out: ti });\n    gates.push({ op: 'XOR', in1: ti, in2: prevC, out: zi });\n    gates.push({ op: 'AND', in1: xi, in2: yi, out: ai });\n    gates.push({ op: 'AND', in1: ti, in2: prevC, out: bi });\n\n    if (i < n - 1) {\n      gates.push({ op: 'OR', in1: ai, in2: bi, out: `c${pad(i)}` });\n    } else {\n      gates.push({ op: 'OR', in1: ai, in2: bi, out: `z${pad(n)}` });\n    }\n  }\n\n  return gates;\n}\n\n// Helper: build inputs for X and Y values with N bits\nfunction makeInputs(n: number, x: bigint, y: bigint): Record<string, number> {\n  const inputs: Record<string, number> = {};\n  const pad = (i: number) => String(i).padStart(2, '0');\n  for (let i = 0; i < n; i++) {\n    inputs[`x${pad(i)}`] = Number((x >> BigInt(i)) & 1n);\n    inputs[`y${pad(i)}`] = Number((y >> BigInt(i)) & 1n);\n  }\n  return inputs;\n}\n\n// Helper: extract Z value from wire map\nfunction readZ(wires: Record<string, number>, maxBit: number): bigint {\n  let result = 0n;\n  const pad = (i: number) => String(i).padStart(2, '0');\n  for (let i = 0; i <= maxBit; i++) {\n    const key = `z${pad(i)}`;\n    if (wires[key]) result |= 1n << BigInt(i);\n  }\n  return result;\n}\n\n// Helper: swap two gate outputs in a circuit\nfunction swapOutputs(gates: Gate[], wire1: string, wire2: string): Gate[] {\n  return gates.map(g => {\n    if (g.out === wire1) return { ...g, out: wire2 };\n    if (g.out === wire2) return { ...g, out: wire1 };\n    return { ...g };\n  });\n}\n\ndescribe('simulate', () => {\n  it('evaluates a single AND gate', () => {\n    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];\n    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, c: 1 });\n    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, c: 0 });\n    expect(simulate(gates, { a: 0, b: 1 })).toEqual({ a: 0, b: 1, c: 0 });\n    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, c: 0 });\n  });\n\n  it('evaluates a single OR gate', () => {\n    const gates: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'c' }];\n    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, c: 0 });\n    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, c: 1 });\n    expect(simulate(gates, { a: 0, b: 1 })).toEqual({ a: 0, b: 1, c: 1 });\n    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, c: 1 });\n  });\n\n  it('evaluates a single XOR gate', () => {\n    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'c' }];\n    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, c: 0 });\n    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, c: 1 });\n    expect(simulate(gates, { a: 0, b: 1 })).toEqual({ a: 0, b: 1, c: 1 });\n    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, c: 0 });\n  });\n\n  it('handles chained gates (dependency order)', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'a', in2: 'b', out: 'mid' },\n      { op: 'OR', in1: 'mid', in2: 'c', out: 'out' },\n    ];\n    expect(simulate(gates, { a: 1, b: 1, c: 0 })).toEqual({ a: 1, b: 1, c: 0, mid: 1, out: 1 });\n    expect(simulate(gates, { a: 0, b: 1, c: 0 })).toEqual({ a: 0, b: 1, c: 0, mid: 0, out: 0 });\n    expect(simulate(gates, { a: 0, b: 0, c: 1 })).toEqual({ a: 0, b: 0, c: 1, mid: 0, out: 1 });\n  });\n\n  it('handles gates listed in reverse dependency order', () => {\n    const gates: Gate[] = [\n      { op: 'OR', in1: 'mid', in2: 'c', out: 'out' },\n      { op: 'AND', in1: 'a', in2: 'b', out: 'mid' },\n    ];\n    expect(simulate(gates, { a: 1, b: 1, c: 0 })).toEqual({ a: 1, b: 1, c: 0, mid: 1, out: 1 });\n  });\n\n  it('simulates a correct 4-bit adder: 3+5=8', () => {\n    const gates = makeAdder(4);\n    const inputs = makeInputs(4, 3n, 5n);\n    const wires = simulate(gates, inputs);\n    expect(readZ(wires, 4)).toBe(8n);\n  });\n\n  it('simulates a correct 4-bit adder: 15+15=30', () => {\n    const gates = makeAdder(4);\n    const inputs = makeInputs(4, 15n, 15n);\n    const wires = simulate(gates, inputs);\n    expect(readZ(wires, 4)).toBe(30n);\n  });\n\n  it('simulates a correct 4-bit adder: 0+0=0', () => {\n    const gates = makeAdder(4);\n    const inputs = makeInputs(4, 0n, 0n);\n    const wires = simulate(gates, inputs);\n    expect(readZ(wires, 4)).toBe(0n);\n  });\n\n  it('simulates a correct 8-bit adder: 200+100=300', () => {\n    const gates = makeAdder(8);\n    const inputs = makeInputs(8, 200n, 100n);\n    const wires = simulate(gates, inputs);\n    expect(readZ(wires, 8)).toBe(300n);\n  });\n\n  it('returns values for all wires', () => {\n    const gates: Gate[] = [\n      { op: 'XOR', in1: 'x', in2: 'y', out: 'z' },\n    ];\n    const result = simulate(gates, { x: 1, y: 0 });\n    expect(Object.keys(result).sort()).toEqual(['x', 'y', 'z']);\n  });\n});\n\ndescribe('findSwappedWires', () => {\n  it('detects z wire swapped with internal AND wire', () => {\n    // 8-bit adder, swap z01 <-> a01\n    let gates = makeAdder(8);\n    gates = swapOutputs(gates, 'z01', 'a01');\n    const result = findSwappedWires(gates);\n    expect(result).toEqual(['a01', 'z01']);\n  });\n\n  it('detects partial sum swapped with z wire', () => {\n    // 8-bit adder, swap t01 <-> z02\n    let gates = makeAdder(8);\n    gates = swapOutputs(gates, 't01', 'z02');\n    const result = findSwappedWires(gates);\n    expect(result).toContain('t01');\n    expect(result).toContain('z02');\n  });\n\n  it('detects two z wires swapped', () => {\n    // 8-bit adder, swap z02 <-> z05\n    let gates = makeAdder(8);\n    gates = swapOutputs(gates, 'z02', 'z05');\n    const result = findSwappedWires(gates);\n    expect(result).toContain('z02');\n    expect(result).toContain('z05');\n  });\n\n  it('detects AND output swapped with partial sum from different bit', () => {\n    // 8-bit adder, swap a01 <-> t02\n    let gates = makeAdder(8);\n    gates = swapOutputs(gates, 'a01', 't02');\n    const result = findSwappedWires(gates);\n    expect(result).toContain('a01');\n    expect(result).toContain('t02');\n  });\n\n  it('finds all 8 wires with 4 swap pairs', () => {\n    // 8-bit adder, 4 swaps\n    let gates = makeAdder(8);\n    gates = swapOutputs(gates, 'z01', 'a01');\n    gates = swapOutputs(gates, 'z03', 't03');\n    gates = swapOutputs(gates, 'z05', 'b05');\n    gates = swapOutputs(gates, 'z07', 'a07');\n    const result = findSwappedWires(gates);\n    expect(result).toHaveLength(8);\n    expect(result).toEqual(['a01', 'a07', 'b05', 't03', 'z01', 'z03', 'z05', 'z07']);\n  });\n\n  it('returns sorted array', () => {\n    let gates = makeAdder(8);\n    gates = swapOutputs(gates, 'z01', 'a01');\n    gates = swapOutputs(gates, 'z03', 't03');\n    gates = swapOutputs(gates, 'z05', 'b05');\n    gates = swapOutputs(gates, 'z07', 'a07');\n    const result = findSwappedWires(gates);\n    const sorted = [...result].sort();\n    expect(result).toEqual(sorted);\n  });\n\n  it('handles 45-bit adder within 5 seconds', () => {\n    let gates = makeAdder(45);\n    // 4 swaps in different positions\n    gates = swapOutputs(gates, 'z05', 'a05');\n    gates = swapOutputs(gates, 'z15', 't15');\n    gates = swapOutputs(gates, 'z25', 'b25');\n    gates = swapOutputs(gates, 'z40', 'a40');\n    const start = Date.now();\n    const result = findSwappedWires(gates);\n    const elapsed = Date.now() - start;\n    expect(result).toHaveLength(8);\n    expect(elapsed).toBeLessThan(5000);\n  });\n\n  it('detects OR output swapped with z wire', () => {\n    // 8-bit adder: swap carry (OR output) with z wire\n    let gates = makeAdder(8);\n    gates = swapOutputs(gates, 'c03', 'z05');\n    const result = findSwappedWires(gates);\n    expect(result).toContain('c03');\n    expect(result).toContain('z05');\n  });\n\n  it('detects z00 swapped with another wire', () => {\n    let gates = makeAdder(8);\n    gates = swapOutputs(gates, 'z00', 'a03');\n    const result = findSwappedWires(gates);\n    expect(result).toContain('z00');\n    expect(result).toContain('a03');\n  });\n\n  it('detects swap involving the last z bit (final carry)', () => {\n    let gates = makeAdder(8);\n    // z08 is the final carry, produced by OR gate\n    gates = swapOutputs(gates, 'z08', 't04');\n    const result = findSwappedWires(gates);\n    expect(result).toContain('z08');\n    expect(result).toContain('t04');\n  });\n\n  it('works with randomized wire names', () => {\n    let gates = makeAdder(8);\n    // Rename all internal wires to random names\n    const renames: Record<string, string> = {};\n    let counter = 0;\n    const randomName = () => {\n      counter++;\n      return `w${String(counter).padStart(3, '0')}`;\n    };\n\n    // Map internal wires (not x/y/z) to random names\n    for (const g of gates) {\n      if (!g.out.startsWith('x') && !g.out.startsWith('y') && !g.out.startsWith('z')) {\n        if (!renames[g.out]) renames[g.out] = randomName();\n      }\n    }\n\n    // Apply renames\n    gates = gates.map(g => ({\n      op: g.op,\n      in1: renames[g.in1] ?? g.in1,\n      in2: renames[g.in2] ?? g.in2,\n      out: renames[g.out] ?? g.out,\n    }));\n\n    // Now swap some outputs — pick one z with one internal\n    const z03Gate = gates.find(g => g.out === 'z03')!;\n    const someInternal = gates.find(g => !g.out.startsWith('z') && !g.out.startsWith('x') && !g.out.startsWith('y'))!;\n    const wire1 = z03Gate.out;\n    const wire2 = someInternal.out;\n    gates = swapOutputs(gates, wire1, wire2);\n    // Also need 3 more swaps for exactly 4 pairs\n    // But for a partial test, just checking these 2 are found\n    // Hmm, the function expects exactly 4 pairs. Let me do 4 swaps.\n\n    // Actually the function should find all swapped wires regardless.\n    // Let me make 4 total swaps by picking more pairs.\n    // Since we renamed internals, let me pick z01 with another internal.\n    const z01Wire = 'z01';\n    const internal2 = gates.find(g => g.out !== wire2 && g.out !== z01Wire && !g.out.startsWith('z') && !g.out.startsWith('x') && !g.out.startsWith('y'))!;\n    gates = swapOutputs(gates, z01Wire, internal2.out);\n\n    const z05Wire = 'z05';\n    const internal3 = gates.find(g =>\n      g.out !== wire2 && g.out !== internal2.out && g.out !== z05Wire &&\n      !g.out.startsWith('z') && !g.out.startsWith('x') && !g.out.startsWith('y'))!;\n    gates = swapOutputs(gates, z05Wire, internal3.out);\n\n    const z07Wire = 'z07';\n    const internal4 = gates.find(g =>\n      g.out !== wire2 && g.out !== internal2.out && g.out !== internal3.out && g.out !== z07Wire &&\n      !g.out.startsWith('z') && !g.out.startsWith('x') && !g.out.startsWith('y'))!;\n    gates = swapOutputs(gates, z07Wire, internal4.out);\n\n    const result = findSwappedWires(gates);\n    expect(result).toHaveLength(8);\n    expect(result).toContain(wire2); // was swapped with z03\n    expect(result).toContain(wire1); // z03\n  });\n});\n","structuredPatch":[{"oldStart":299,"oldLines":4,"newStart":299,"newLines":72,"lines":["     expect(result).toContain(wire2); // was swapped with z03","     expect(result).toContain(wire1); // z03","   });","+","+  it('detects first carry (c00) swapped', () => {","+    let gates = makeAdder(8);","+    gates = swapOutputs(gates, 'c00', 'z03');","+    const result = findSwappedWires(gates);","+    expect(result).toContain('c00');","+    expect(result).toContain('z03');","+  });","+","+  it('detects prop carry swapped with z wire', () => {","+    let gates = makeAdder(8);","+    gates = swapOutputs(gates, 'b03', 'z04');","+    const result = findSwappedWires(gates);","+    expect(result).toContain('b03');","+    expect(result).toContain('z04');","+  });","+","+  it('handles mixed swap types across 4 pairs', () => {","+    let gates = makeAdder(16);","+    gates = swapOutputs(gates, 'z02', 'a02');   // z <-> gen carry","+    gates = swapOutputs(gates, 'z07', 'b07');   // z <-> prop carry","+    gates = swapOutputs(gates, 't10', 'z10');   // partial sum <-> z (caught as PARTIAL_SUM starts with z)","+    gates = swapOutputs(gates, 'z14', 'a14');   // z <-> gen carry","+    const result = findSwappedWires(gates);","+    expect(result).toHaveLength(8);","+    for (const w of ['z02', 'a02', 'z07', 'b07', 't10', 'z10', 'z14', 'a14']) {","+      expect(result).toContain(w);","+    }","+  });","+","+  it('simulates a 45-bit adder correctly', () => {","+    const gates = makeAdder(45);","+    const x = (1n << 44n) - 1n;","+    const y = 1n;","+    const inputs = makeInputs(45, x, y);","+    const wires = simulate(gates, inputs);","+    expect(readZ(wires, 45)).toBe(x + y);","+  });","+","+  it('simulates a large chain of dependencies', () => {","+    const gates: Gate[] = [","+      { op: 'XOR', in1: 'a', in2: 'b', out: 'r1' },","+      { op: 'AND', in1: 'r1', in2: 'c', out: 'r2' },","+      { op: 'OR', in1: 'r2', in2: 'd', out: 'r3' },","+      { op: 'XOR', in1: 'r3', in2: 'e', out: 'r4' },","+    ];","+    const result = simulate(gates, { a: 1, b: 0, c: 1, d: 0, e: 1 });","+    // r1 = 1^0 = 1, r2 = 1&1 = 1, r3 = 1|0 = 1, r4 = 1^1 = 0","+    expect(result.r4).toBe(0);","+  });","+","+  it('correctly handles swapped inputs at y side for XOR detection', () => {","+    // Ensure detection works when y comes before x in gate inputs","+    let gates = makeAdder(8);","+    // Swap input order for a few gates (shouldn't affect detection)","+    gates = gates.map(g => {","+      if (g.in1.startsWith('y') && g.in2.startsWith('x')) return g; // already y,x","+      if (g.in1.startsWith('x') && g.in2.startsWith('y'))","+        return { ...g, in1: g.in2, in2: g.in1 }; // swap to y,x","+      return g;","+    });","+    gates = swapOutputs(gates, 'z03', 'a0