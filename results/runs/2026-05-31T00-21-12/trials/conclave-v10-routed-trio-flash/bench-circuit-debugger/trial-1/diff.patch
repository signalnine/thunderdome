+import { describe, it, expect } from 'vitest';
+import { simulate, findSwappedWires, Gate } from './index.js';
+
+// Helper: generate a correct N-bit ripple-carry adder
+function makeAdder(n: number): Gate[] {
+  const gates: Gate[] = [];
+  const pad = (i: number) => String(i).padStart(2, '0');
+
+  // Bit 0: half adder
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+
+  for (let i = 1; i < n; i++) {
+    const xi = `x${pad(i)}`, yi = `y${pad(i)}`, zi = `z${pad(i)}`;
+    const prevC = `c${pad(i - 1)}`;
+    const ti = `t${pad(i)}`, ai = `a${pad(i)}`, bi = `b${pad(i)}`;
+
+    gates.push({ op: 'XOR', in1: xi, in2: yi, out: ti });
+    gates.push({ op: 'XOR', in1: ti, in2: prevC, out: zi });
+    gates.push({ op: 'AND', in1: xi, in2: yi, out: ai });
+    gates.push({ op: 'AND', in1: ti, in2: prevC, out: bi });
+
+    if (i < n - 1) {
+      gates.push({ op: 'OR', in1: ai, in2: bi, out: `c${pad(i)}` });
+    } else {
+      gates.push({ op: 'OR', in1: ai, in2: bi, out: `z${pad(n)}` });
+    }
+  }
+
+  return gates;
+}
+
+// Helper: build inputs for X and Y values with N bits
+function makeInputs(n: number, x: bigint, y: bigint): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  const pad = (i: number) => String(i).padStart(2, '0');
+  for (let i = 0; i < n; i++) {
+    inputs[`x${pad(i)}`] = Number((x >> BigInt(i)) & 1n);
+    inputs[`y${pad(i)}`] = Number((y >> BigInt(i)) & 1n);
+  }
+  return inputs;
+}
+
+// Helper: extract Z value from wire map
+function readZ(wires: Record<string, number>, maxBit: number): bigint {
+  let result = 0n;
+  const pad = (i: number) => String(i).padStart(2, '0');
+  for (let i = 0; i <= maxBit; i++) {
+    const key = `z${pad(i)}`;
+    if (wires[key]) result |= 1n << BigInt(i);
+  }
+  return result;
+}
+
+// Helper: swap two gate outputs in a circuit
+function swapOutputs(gates: Gate[], wire1: string, wire2: string): Gate[] {
+  return gates.map(g => {
+    if (g.out === wire1) return { ...g, out: wire2 };
+    if (g.out === wire2) return { ...g, out: wire1 };
+    return { ...g };
+  });
+}
+
+describe('simulate', () => {
+  it('evaluates a single AND gate', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, c: 1 });
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, c: 0 });
+    expect(simulate(gates, { a: 0, b: 1 })).toEqual({ a: 0, b: 1, c: 0 });
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, c: 0 });
+  });
+
+  it('evaluates a single OR gate', () => {
+    const gates: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, c: 0 });
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, c: 1 });
+    expect(simulate(gates, { a: 0, b: 1 })).toEqual({ a: 0, b: 1, c: 1 });
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, c: 1 });
+  });
+
+  it('evaluates a single XOR gate', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, c: 0 });
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, c: 1 });
+    expect(simulate(gates, { a: 0, b: 1 })).toEqual({ a: 0, b: 1, c: 1 });
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, c: 0 });
+  });
+
+  it('handles chained gates (dependency order)', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'mid' },
+      { op: 'OR', in1: 'mid', in2: 'c', out: 'out' },
+    ];
+    expect(simulate(gates, { a: 1, b: 1, c: 0 })).toEqual({ a: 1, b: 1, c: 0, mid: 1, out: 1 });
+    expect(simulate(gates, { a: 0, b: 1, c: 0 })).toEqual({ a: 0, b: 1, c: 0, mid: 0, out: 0 });
+    expect(simulate(gates, { a: 0, b: 0, c: 1 })).toEqual({ a: 0, b: 0, c: 1, mid: 0, out: 1 });
+  });
+
+  it('handles gates listed in reverse dependency order', () => {
+    const gates: Gate[] = [
+      { op: 'OR', in1: 'mid', in2: 'c', out: 'out' },
+      { op: 'AND', in1: 'a', in2: 'b', out: 'mid' },
+    ];
+    expect(simulate(gates, { a: 1, b: 1, c: 0 })).toEqual({ a: 1, b: 1, c: 0, mid: 1, out: 1 });
+  });
+
+  it('simulates a correct 4-bit adder: 3+5=8', () => {
+    const gates = makeAdder(4);
+    const inputs = makeInputs(4, 3n, 5n);
+    const wires = simulate(gates, inputs);
+    expect(readZ(wires, 4)).toBe(8n);
+  });
+
+  it('simulates a correct 4-bit adder: 15+15=30', () => {
+    const gates = makeAdder(4);
+    const inputs = makeInputs(4, 15n, 15n);
+    const wires = simulate(gates, inputs);
+    expect(readZ(wires, 4)).toBe(30n);
+  });
+
+  it('simulates a correct 4-bit adder: 0+0=0', () => {
+    const gates = makeAdder(4);
+    const inputs = makeInputs(4, 0n, 0n);
+    const wires = simulate(gates, inputs);
+    expect(readZ(wires, 4)).toBe(0n);
+  });
+
+  it('simulates a correct 8-bit adder: 200+100=300', () => {
+    const gates = makeAdder(8);
+    const inputs = makeInputs(8, 200n, 100n);
+    const wires = simulate(gates, inputs);
+    expect(readZ(wires, 8)).toBe(300n);
+  });
+
+  it('returns values for all wires', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 'x', in2: 'y', out: 'z' },
+    ];
+    const result = simulate(gates, { x: 1, y: 0 });
+    expect(Object.keys(result).sort()).toEqual(['x', 'y', 'z']);
+  });
+});
+
+describe('findSwappedWires', () => {
+  it('detects z wire swapped with internal AND wire', () => {
+    // 8-bit adder, swap z01 <-> a01
+    let gates = makeAdder(8);
+    gates = swapOutputs(gates, 'z01', 'a01');
+    const result = findSwappedWires(gates);
+    expect(result).toEqual(['a01', 'z01']);
+  });
+
+  it('detects partial sum swapped with z wire', () => {
+    // 8-bit adder, swap t01 <-> z02
+    let gates = makeAdder(8);
+    gates = swapOutputs(gates, 't01', 'z02');
+    const result = findSwappedWires(gates);
+    expect(result).toContain('t01');
+    expect(result).toContain('z02');
+  });
+
+  it('detects two z wires swapped', () => {
+    // 8-bit adder, swap z02 <-> z05
+    let gates = makeAdder(8);
+    gates = swapOutputs(gates, 'z02', 'z05');
+    const result = findSwappedWires(gates);
+    expect(result).toContain('z02');
+    expect(result).toContain('z05');
+  });
+
+  it('detects AND output swapped with partial sum from different bit', () => {
+    // 8-bit adder, swap a01 <-> t02
+    let gates = makeAdder(8);
+    gates = swapOutputs(gates, 'a01', 't02');
+    const result = findSwappedWires(gates);
+    expect(result).toContain('a01');
+    expect(result).toContain('t02');
+  });
+
