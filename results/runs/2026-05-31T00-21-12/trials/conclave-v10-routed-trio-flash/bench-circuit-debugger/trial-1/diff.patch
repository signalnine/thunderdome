+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const wires: Record<string, number> = { ...inputs };
+  const waitingOn = new Map<string, Gate[]>();
+  const pendingCount = new Map<Gate, number>();
+  const ready: Gate[] = [];
+
+  for (const gate of gates) {
+    let pending = 0;
+    if (!(gate.in1 in wires)) pending++;
+    if (!(gate.in2 in wires)) pending++;
+
+    if (pending === 0) {
+      ready.push(gate);
+    } else {
+      pendingCount.set(gate, pending);
+      for (const inp of [gate.in1, gate.in2]) {
+        if (!(inp in wires)) {
+          let list = waitingOn.get(inp);
+          if (!list) { list = []; waitingOn.set(inp, list); }
+          list.push(gate);
+        }
+      }
+    }
+  }
+
+  while (ready.length > 0) {
+    const gate = ready.pop()!;
+    const a = wires[gate.in1];
+    const b = wires[gate.in2];
+    let result: number;
+    switch (gate.op) {
+      case 'AND': result = a & b; break;
+      case 'OR':  result = a | b; break;
+      case 'XOR': result = a ^ b; break;
+    }
+    wires[gate.out] = result;
+
+    const waiting = waitingOn.get(gate.out);
+    if (waiting) {
+      for (const g of waiting) {
+        const count = pendingCount.get(g)! - 1;
+        if (count === 0) {
+          ready.push(g);
+          pendingCount.delete(g);
+        } else {
+          pendingCount.set(g, count);
+        }
+      }
+      waitingOn.delete(gate.out);
+    }
+  }
+
+  return wires;
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  const swapped = new Set<string>();
+
+  const gateByOutput = new Map<string, Gate>();
+  const consumers = new Map<string, Gate[]>();
+
+  for (const gate of gates) {
+    gateByOutput.set(gate.out, gate);
+    for (const inp of [gate.in1, gate.in2]) {
+      let list = consumers.get(inp);
+      if (!list) { list = []; consumers.set(inp, list); }
+      list.push(gate);
+    }
+  }
+
+  let maxBit = 0;
+  for (const gate of gates) {
+    for (const w of [gate.in1, gate.in2]) {
+      if (w.startsWith('x')) {
+        const bit = parseInt(w.slice(1));
+        if (bit + 1 > maxBit) maxBit = bit + 1;
+      }
+    }
+  }
+
+  const lastZ = 'z' + String(maxBit).padStart(2, '0');
+
+  function hasXYInputs(gate: Gate): boolean {
+    return (gate.in1.startsWith('x') || gate.in1.startsWith('y')) &&
+           (gate.in2.startsWith('x') || gate.in2.startsWith('y'));
+  }
+
+  function isFirstBit(gate: Gate): boolean {
+    return hasXYInputs(gate) && gate.in1.endsWith('00') && gate.in2.endsWith('00');
+  }
+
+  function feedsIntoOp(wire: string, op: string): boolean {
+    const list = consumers.get(wire);
+    if (!list) return false;
+    return list.some(g => g.op === op);
+  }
+
+  const N = maxBit;
+  const pad = (i: number) => String(i).padStart(2, '0');
+
+  function findGate(op: string, w1: string, w2: string): Gate | undefined {
+    return gates.find(g => g.op === op &&
+      ((g.in1 === w1 && g.in2 === w2) || (g.in1 === w2 && g.in2 === w1)));
+  }
+
+  // Pass 1: Structural type checks
+  for (const gate of gates) {
+    if (gate.op === 'XOR') {
+      if (hasXYInputs(gate)) {
+        if (isFirstBit(gate)) {
+          if (gate.out !== 'z00') swapped.add(gate.out);
+        } else {
+          if (gate.out.startsWith('z')) swapped.add(gate.out);
+          else if (!feedsIntoOp(gate.out, 'XOR') || !feedsIntoOp(gate.out, 'AND'))
+            swapped.add(gate.out);
+        }
+      } else {
+        if (!gate.out.startsWith('z')) swapped.add(gate.out);
+      }
+    } else if (gate.op === 'AND') {
+      if (isFirstBit(gate)) {
+        if (N > 1 && (!feedsIntoOp(gate.out, 'XOR') || !feedsIntoOp(gate.out, 'AND')))
+          swapped.add(gate.out);
+      } else {
+        if (!feedsIntoOp(gate.out, 'OR')) swapped.add(gate.out);
+      }
+    } else if (gate.op === 'OR') {
+      if (gate.out.startsWith('z') && gate.out !== lastZ) swapped.add(gate.out);
+    }
+  }
+
+  // Pass 2: Per-FULL_SUM verification
+  for (const gate of gates) {
+    if (gate.op !== 'XOR' || hasXYInputs(gate) || !gate.out.startsWith('z')) continue;
+
+    const bit = parseInt(gate.out.slice(1));
+    if (bit === 0) continue;
+
+    const p1 = gateByOutput.get(gate.in1);
+    const p2 = gateByOutput.get(gate.in2);
+    const isPartial1 = p1 !== undefined && p1.op === 'XOR' && hasXYInputs(p1);
+    const isPartial2 = p2 !== undefined && p2.op === 'XOR' && hasXYInputs(p2);
+
+    if (isPartial1 || isPartial2) {
+      // z-index check: verify the partial sum matches this bit
+      const partialGate = isPartial1 ? p1! : p2!;
+      const expectedBit = parseInt(partialGate.in1.slice(1));
+      const expectedZ = 'z' + pad(expectedBit);
+      if (gate.out !== expectedZ) swapped.add(gate.out);
+    } else {
+      // Neither input from a partial sum XOR — the partial was swapped away
+      // Find the correct carry using genPrev heuristic to flag the wrong input
+      const xyXor = findGate('XOR', 'x' + pad(bit), 'y' + pad(bit));
+      if (xyXor) swapped.add(xyXor.out);
+
+      let correctCarryInput: string | null = null;
+      if (bit === 1) {
+        const halfCarry = findGate('AND', 'x00', 'y00');
+        if (halfCarry) {
+          if (gate.in1 === halfCarry.out) correctCarryInput = gate.in1;
+          else if (gate.in2 === halfCarry.out) correctCarryInput = gate.in2;
+        }
+      } else {
+        const genPrev = findGate('AND', 'x' + pad(bit - 1), 'y' + pad(bit - 1));
+        if (genPrev) {
+          const orsOfGenPrev = (consumers.get(genPrev.out) || []).filter(g => g.op === 'OR');
+          if (orsOfGenPrev.length === 1) {
+            const expectedCarry = orsOfGenPrev[0].out;
+            if (gate.in1 === expectedCarry) correctCarryInput = gate.in1;
+            else if (gate.in2 === expectedCarry) correctCarryInput = gate.in2;
+          }
+        }
+      }
+
+      if (correctCarryInput !== null) {
+        const wrongInput = (correctCarryInput === gate.in1) ? gate.in2 : gate.in1;
+        swapped.add(wrongInput);
+      }
+    }
+  }
+
+  return Array.from(swapped).sort();
+}
