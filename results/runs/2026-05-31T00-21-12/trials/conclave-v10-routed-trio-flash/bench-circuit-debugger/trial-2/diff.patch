@@ -0,0 +1,204 @@
+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const wires: Record<string, number> = { ...inputs };
+  const remaining = [...gates];
+
+  while (remaining.length > 0) {
+    let progress = false;
+    for (let i = remaining.length - 1; i >= 0; i--) {
+      const gate = remaining[i];
+      if (wires[gate.in1] !== undefined && wires[gate.in2] !== undefined) {
+        const a = wires[gate.in1];
+        const b = wires[gate.in2];
+        switch (gate.op) {
+          case 'AND': wires[gate.out] = a & b; break;
+          case 'OR':  wires[gate.out] = a | b; break;
+          case 'XOR': wires[gate.out] = a ^ b; break;
+        }
+        remaining.splice(i, 1);
+        progress = true;
+      }
+    }
+    if (!progress) break;
+  }
+
+  return wires;
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  const swapped = new Set<string>();
+
+  const numBits = findNumBits(gates);
+  const byOutput = new Map<string, Gate>();
+  for (const g of gates) {
+    byOutput.set(g.out, g);
+  }
+
+  const gatesByInputs = new Map<string, Gate>();
+  for (const g of gates) {
+    const key = gateInputKey(g);
+    gatesByInputs.set(key, g);
+  }
+
+  function findGate(op: string, in1: string, in2: string): Gate | undefined {
+    return gatesByInputs.get(`${op}:${in1}:${in2}`) ?? gatesByInputs.get(`${op}:${in2}:${in1}`);
+  }
+
+  function findGateByOpAndOneInput(op: string, input: string): Gate[] {
+    return gates.filter(g => g.op === op && (g.in1 === input || g.in2 === input));
+  }
+
+  function otherInput(g: Gate, known: string): string {
+    return g.in1 === known ? g.in2 : g.in1;
+  }
+
+  function swap(a: string, b: string) {
+    swapped.add(a);
+    swapped.add(b);
+
+    const gA = byOutput.get(a)!;
+    const gB = byOutput.get(b)!;
+
+    byOutput.delete(a);
+    byOutput.delete(b);
+    gatesByInputs.delete(gateInputKey(gA));
+    gatesByInputs.delete(gateInputKey(gB));
+
+    gA.out = b;
+    gB.out = a;
+
+    byOutput.set(a, gB);
+    byOutput.set(b, gA);
+    gatesByInputs.set(gateInputKey(gA), gA);
+    gatesByInputs.set(gateInputKey(gB), gB);
+  }
+
+  // For bit 0: x00 XOR y00 -> z00, x00 AND y00 -> c0
+  // Check z00
+  const xorBit0 = findGate('XOR', 'x00', 'y00');
+  const andBit0 = findGate('AND', 'x00', 'y00');
+
+  if (xorBit0 && xorBit0.out !== 'z00') {
+    // z00's output is swapped with something
+    // Find what currently outputs z00
+    const currentZ00 = byOutput.get('z00');
+    if (currentZ00) {
+      swap(xorBit0.out, 'z00');
+    }
+  }
+
+  let prevCarry = andBit0!.out;
+
+  // For each subsequent bit, verify the adder structure
+  for (let i = 1; i < numBits; i++) {
+    const xi = `x${pad(i)}`;
+    const yi = `y${pad(i)}`;
+    const zi = `z${pad(i)}`;
+
+    // Step 1: xi XOR yi -> partial_sum (t_i)
+    const xorXY = findGate('XOR', xi, yi);
+    if (!xorXY) continue;
+
+    let partialSum = xorXY.out;
+
+    // Step 2: partial_sum XOR carry_in -> z_i
+    let xorWithCarry = findGate('XOR', partialSum, prevCarry);
+
+    if (!xorWithCarry) {
+      // The partial sum or carry might be swapped
+      // Check if prevCarry is used in an XOR with something
+      const xorWithPrevCarry = findGateByOpAndOneInput('XOR', prevCarry)
+        .filter(g => g !== xorXY);
+
+      if (xorWithPrevCarry.length === 1) {
+        // partialSum is wrong — it should be the other input of this XOR
+        const correctPartialSum = otherInput(xorWithPrevCarry[0], prevCarry);
+        swap(partialSum, correctPartialSum);
+        partialSum = xorXY.out; // after swap
+        xorWithCarry = xorWithPrevCarry[0];
+      } else {
+        // prevCarry might be wrong, check if partialSum is used in a XOR
+        const xorWithPartial = findGateByOpAndOneInput('XOR', partialSum)
+          .filter(g => g !== xorXY);
+
+        if (xorWithPartial.length === 1) {
+          const correctCarry = otherInput(xorWithPartial[0], partialSum);
+          swap(prevCarry, correctCarry);
+          prevCarry = andBit0!.out; // re-derive after swap for bit 0
+          // Actually re-derive prevCarry properly
+          if (i === 1) {
+            prevCarry = andBit0!.out;
+          }
+          xorWithCarry = xorWithPartial[0];
+        }
+      }
+    }
+
+    if (!xorWithCarry) continue;
+
+    // Check that xorWithCarry outputs z_i
+    if (xorWithCarry.out !== zi) {
+      swap(xorWithCarry.out, zi);
+    }
+
+    // Step 3: find the AND gates and OR for carry
+    // xi AND yi -> gen
+    const andXY = findGate('AND', xi, yi);
+    // partial_sum AND carry_in -> prop
+    const andPropGate = findGate('AND', partialSum, prevCarry);
+
+    if (andXY && andPropGate) {
+      // gen OR prop -> carry_out
+      const orGate = findGate('OR', andXY.out, andPropGate.out);
+      if (orGate) {
+        prevCarry = orGate.out;
+      } else {
+        // One of andXY.out or andPropGate.out might be swapped
+        const orWithAndXY = findGateByOpAndOneInput('OR', andXY.out);
+        if (orWithAndXY.length === 1) {
+          const correctProp = otherInput(orWithAndXY[0], andXY.out);
+          swap(andPropGate.out, correctProp);
+          prevCarry = orWithAndXY[0].out;
+        } else {
+          const orWithProp = findGateByOpAndOneInput('OR', andPropGate.out);
+          if (orWithProp.length === 1) {
+            const correctGen = otherInput(orWithProp[0], andPropGate.out);
+            swap(andXY.out, correctGen);
+            prevCarry = orWithProp[0].out;
+          }
+        }
+      }
+    }
+  }
+
+  return [...swapped].sort();
+}
+
+function pad(n: number): string {
+  return n.toString().padStart(2, '0');
+}
+
+function gateInputKey(g: Gate): string {
+  const [a, b] = [g.in1, g.in2].sort();
+  return `${g.op}:${a}:${b}`;
+}
+
+function findNumBits(gates: Gate[]): number {
+  let max = -1;
+  for (const g of gates) {
+    for (const w of [g.in1, g.in2, g.out]) {
+      const m = w.match(/^x(\d+)$/);
+      if (m) {
+        const n = parseInt(m[1], 10);
+        if (n > max) max = n;
+      }
+    }
+  }
+  return max + 1;
+}
