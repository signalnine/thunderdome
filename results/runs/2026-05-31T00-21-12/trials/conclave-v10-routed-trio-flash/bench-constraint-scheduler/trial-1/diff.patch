e('room gap constraint', () => {\n  it('respects default gap of 15 between events in same room', () => {\n    // 30 + 15 + 30 = 75 min needed; window is 60 min → only 1 fits\n    const result = schedule(\n      [event('A', 30), event('B', 30)],\n      [room('R1')],\n      opts(540, 600) // 60-min window, no gap specified (default 15)\n    );\n    expect(result.assignments).toHaveLength(1);\n    expect(result.unscheduled).toHaveLength(1);\n  });\n\n  it('respects custom gap between events in same room', () => {\n    // gap=0: 30+30=60 fits in 60-min window\n    const result = schedule(\n      [event('A', 30), event('B', 30)],\n      [room('R1')],\n      opts(540, 600, 0)\n    );\n    expect(result.assignments).toHaveLength(2);\n    expect(result.unscheduled).toHaveLength(0);\n  });\n\n  it('does not apply room gap to events in different rooms', () => {\n    const result = schedule(\n      [event('A', 60), event('B', 60)],\n      [room('R1'), room('R2')],\n      opts(540, 600, 15)\n    );\n    expect(result.assignments).toHaveLength(2);\n    expect(result.unscheduled).toHaveLength(0);\n    const a = result.assignments.find(x => x.eventId === 'A')!;\n    const b = result.assignments.find(x => x.eventId === 'B')!;\n    // Both start at 540 (different rooms, no gap required)\n    expect(a.startTime).toBe(540);\n    expect(b.startTime).toBe(540);\n  });\n\n  it('enforces gap between consecutive events in same room', () => {\n    const result = schedule(\n      [event('A', 30), event('B', 30)],\n      [room('R1')],\n      opts(540, 1020, 15)\n    );\n    const a = result.assignments.find(x => x.eventId === 'A')!;\n    const b = result.assignments.find(x => x.eventId === 'B')!;\n    expect(b.startTime - a.endTime).toBeGreaterThanOrEqual(15);\n  });\n});\n\ndescribe('prerequisites', () => {\n  it('schedules B after A + gap when B has A as prerequisite', () => {\n    const events = [\n      event('A', 60),\n      event('B', 30, { prerequisites: ['A'] }),\n    ];\n    const result = schedule(events, [room('R1'), room('R2')], opts(540, 1020, 15));\n    expect(result.unscheduled).toEqual([]);\n    const a = result.assignments.find(x => x.eventId === 'A')!;\n    const b = result.assignments.find(x => x.eventId === 'B')!;\n    expect(b.startTime).toBeGreaterThanOrEqual(a.endTime + 15);\n  });\n\n  it('applies prerequisite gap even when events are in different rooms', () => {\n    const events = [\n      event('A', 60),\n      event('B', 30, { prerequisites: ['A'] }),\n    ];\n    const result = schedule(events, [room('R1'), room('R2')], opts(540, 1020, 20));\n    const a = result.assignments.find(x => x.eventId === 'A')!;\n    const b = result.assignments.find(x => x.eventId === 'B')!;\n    // Different rooms, but prerequisite gap still applies\n    expect(b.startTime).toBeGreaterThanOrEqual(a.endTime + 20);\n  });\n\n  it('unschedules event when its prerequisite was not scheduled', () => {\n    // A is too long to fit; B depends on A\n    const events = [\n      event('A', 600), // won't fit in 60-min window\n      event('B', 30, { prerequisites: ['A'] }),\n    ];\n    const result = schedule(events, [room('R1')], opts(540, 600, 0));\n    expect(result.unscheduled).toContain('A');\n    expect(result.unscheduled).toContain('B');\n  });\n\n  it('propagates unscheduled transitively through prerequisite chain', () => {\n    const events = [\n      event('A', 600), // won't fit\n      event('B', 30, { prerequisites: ['A'] }),\n      event('C', 30, { prerequisites: ['B'] }),\n    ];\n    const result = schedule(events, [room('R1')], opts(540, 600, 0));\n    expect(result.unscheduled).toContain('A');\n    expect(result.unscheduled).toContain('B');\n    expect(result.unscheduled).toContain('C');\n  });\n\n  it('unschedules event with unknown prerequisite', () => {\n    const events = [event('B', 30, { prerequisites: ['nonexistent'] })];\n    const result = schedule(events, [room('R1')], opts());\n    expect(result.unscheduled).toContain('B');\n  });\n});\n\ndescribe('preferred room', () => {\n  it('assigns event to preferred room when available', () => {\n    const result = schedule(\n      [event('A', 60, { preferredRoom: 'R2' })],\n      [room('R1'), room('R2')],\n      opts()\n    );\n    expect(result.assignments.find(x => x.eventId === 'A')?.roomId).toBe('R2');\n  });\n\n  it('falls back to non-preferred room when preferred is full', () => {\n    // R2 already packed: schedule blocker first, then event with preferredRoom=R2\n    const events = [\n      event('Block', 480), // fills R2 entirely\n      event('A', 60, { preferredRoom: 'R2' }),\n    ];\n    const result = schedule(events, [room('R1'), room('R2')], opts(540, 1020, 0));\n    const a = result.assignments.find(x => x.eventId === 'A');\n    expect(a).toBeDefined();\n    expect(a?.roomId).toBe('R1'); // fell back to R1\n  });\n\n  it('honors preferredRoom even when another room has earlier availability', () => {\n    // R1 is empty, R2 has an event but still has room for A\n    const events = [\n      event('Block', 60), // placed in R2 first\n      event('A', 60, { preferredRoom: 'R2' }),\n    ];\n    const result = schedule(events, [room('R1'), room('R2')], opts(540, 1020, 0));\n    const block = result.assignments.find(x => x.eventId === 'Block')!;\n    const a = result.assignments.find(x => x.eventId === 'A');\n    expect(a).toBeDefined();\n    // A should be in R2 if it fits there (after Block + gap)\n    if (a?.roomId === 'R2') {\n      expect(a.startTime).toBeGreaterThanOrEqual(block.endTime);\n    }\n  });\n});\n\ndescribe('cycle detection', () => {\n  it('throws on direct self-reference (A -> A)', () => {\n    const events = [event('A', 30, { prerequisites: ['A'] })];\n    expect(() => schedule(events, [room('R1')], opts())).toThrow();\n  });\n\n  it('throws on indirect cycle (A -> B -> A)', () => {\n    const events = [\n      event('A', 30, { prerequisites: ['B'] }),\n      event('B', 30, { prerequisites: ['A'] }),\n    ];\n    expect(() => schedule(events, [room('R1')], opts())).toThrow();\n  });\n\n  it('throws on longer cycle (A -> B -> C -> A)', () => {\n    const events = [\n      event('A', 30, { prerequisites: ['C'] }),\n      event('B', 30, { prerequisites: ['A'] }),\n      event('C', 30, { prerequisites: ['B'] }),\n    ];\n    expect(() => schedule(events, [room('R1')], opts())).toThrow();\n  });\n\n  it('does not throw when prerequisites are acyclic', () => {\n    const events = [\n      event('A', 30),\n      event('B', 30, { prerequisites: ['A'] }),\n      event('C', 30, { prerequisites: ['B'] }),\n    ];\n    expect(() => schedule(events, [room('R1')], opts())).not.toThrow();\n  });\n});\n\ndescribe('maximization', () => {\n  it('schedules more shorter events over fewer longer events', () => {\n    // 1 room, 60-min window, gap=0\n    // Long(60) vs Short1(30)+Short2(30): prefer 2 events over 1\n    const events = [\n      event('Long', 60),\n      event('Short1', 30),\n      event('Short2', 30),\n    ];\n    const result = schedule(events, [room('R1')], opts(540, 600, 0));\n    expect(result.assignments).toHaveLength(2);\n    expect(result.assignments.map(a => a.eventId)).not.toContain('Long');\n    expect(result.unscheduled).toContain('Long');\n  });\n\n  it('uses multiple rooms to schedule more events concurrently', () => {\n    const events = [event('A', 60), event('B', 60), event('C', 60)];\n    const result = schedule(events, [room('R1'), room('R2'), room('R3')], opts(540, 600, 0));\n    expect(result.assignments).toHaveLength(3);\n    expect(result.unscheduled).toHaveLength(0);\n  });\n\n  it('does not over-schedule when constraints prevent it', () => {\n    // Only 1 room, 3 events, each 30 min, gap=15, window=60 → max 1 fits (30+15+30=75>60)\n    const events = [event('A', 30), event('B', 30), event('C', 30)];\n    const result = schedule(events, [room('R1')], opts(540, 600, 15));\n    expect(result.assignments).toHaveLength(1);\n    expect(result.unscheduled).toHaveLength(2);\n  });\n});\n\ndescribe('edge cases', () => {\n  it('handles no rooms — all events unscheduled', () => {\n    const result = schedule([event('A', 60)], [], opts());\n    expect(result.unscheduled).toContain('A');\n    expect(result.assignments).toHaveLength(0);\n  });\n\n  it('handles multiple prerequisites all satisfied', () => {\n    const events = [\n      event('A', 30),\n      event('B', 30),\n      event('C', 30, { prerequisites: ['A', 'B'] }),\n    ];\n    const result = schedule(events, [room('R1'), room('R2')], opts(540, 1020, 0));\n    expect(result.unscheduled).toEqual([]);\n    const a = result.assignments.find(x => x.eventId === 'A')!;\n    const b = result.assignments.find(x => x.eventId === 'B')!;\n    const c = result.assignments.find(x => x.eventId === 'C')!;\n    expect(c.startTime).toBeGreaterThanOrEqual(a.endTime);\n    expect(c.startTime).toBeGreaterThanOrEqual(b.endTime);\n  });\n\n  it('all assignments have valid startTime and endTime within window', () => {\n    const events = [event('A', 30), event('B', 45), event('C', 60)];\n    const result = schedule(events, [room('R1'), room('R2')], opts(540, 1020, 15));\n    for (const a of result.assignments) {\n      expect(a.startTime).toBeGreaterThanOrEqual(540);\n      expect(a.endTime).toBeLessThanOrEqual(1020);\n      expect(a.endTime - a.startTime).toBe(\n        events.find(e => e.id === a.eventId)!.duration\n      );\n    }\n  });\n\n  it('gap=0 allows back-to-back events in same room', () => {\n    const events = [event('A', 30), event('B', 30)];\n    const result = schedule(events, [room('R1')], opts(540, 600, 0));\n    expect(result.assignments).toHaveLength(2);\n    const a = result.assignments.find(x => x.eventId === 'A')!;\n    const b = result.assignments.find(x => x.eventId === 'B')!;\n    expect(b.startTime).toBe(a.endTime); // back-to-back\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
