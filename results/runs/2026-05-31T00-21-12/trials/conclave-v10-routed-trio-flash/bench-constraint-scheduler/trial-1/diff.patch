room('R1')], opts());\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0]).toMatchObject({\n      eventId: 'A',\n      roomId: 'R1',\n      startTime: 540,\n      endTime: 600,\n    });\n    expect(result.unscheduled).toEqual([]);\n  });\n\n  it('uses startTime as the initial placement', () => {\n    const result = schedule([event('A', 30)], [room('R1')], opts(600, 1020));\n    expect(result.assignments[0].startTime).toBe(600);\n  });\n\n  it('places multiple events back-to-back with gap', () => {\n    const events = [event('A', 30), event('B', 30)];\n    const result = schedule(events, [room('R1')], opts(540, 1020, 10));\n    expect(result.assignments).toHaveLength(2);\n    const a = result.assignments.find(x => x.eventId === 'A')!;\n    const b = result.assignments.find(x => x.eventId === 'B')!;\n    expect(b.startTime - a.endTime).toBeGreaterThanOrEqual(10);\n  });\n});\n\ndescribe('room capacity constraint', () => {\n  it('unschedules event when all rooms are too small', () => {\n    const result = schedule(\n      [event('A', 60, { attendees: 10 })],\n      [room('R1', 5)],\n      opts()\n    );\n    expect(result.unscheduled).toContain('A');\n    expect(result.assignments).toHaveLength(0);\n  });\n\n  it('uses a room with sufficient capacity', () => {\n    const result = schedule(\n      [event('A', 60, { attendees: 10 })],\n      [room('R1', 5), room('R2', 20)],\n      opts()\n    );\n    expect(result.unscheduled).not.toContain('A');\n    expect(result.assignments.find(x => x.eventId === 'A')?.roomId).toBe('R2');\n  });\n\n  it('defaults attendees to 1 when not specified', () => {\n    const result = schedule([event('A', 60)], [room('R1', 1)], opts());\n    expect(result.unscheduled).toEqual([]);\n    expect(result.assignments).toHaveLength(1);\n  });\n});\n\ndescribe('time window constraint', () => {\n  it('unschedules event that does not fit in the window', () => {\n    const result = schedule([event('A', 120)], [room('R1')],