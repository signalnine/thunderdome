new file mode 100644
index 0000000..d0730f9
--- /dev/null
+++ b/src/scheduler.ts
@@ -0,0 +1,195 @@
+export interface Event {
+  id: string;
+  name: string;
+  duration: number;
+  attendees?: number;
+  prerequisites?: string[];
+  preferredRoom?: string;
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number;
+}
+
+export interface ScheduleOptions {
+  startTime: number;
+  endTime: number;
+  gap?: number;
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[];
+}
+
+interface Interval {
+  start: number;
+  end: number;
+}
+
+function computeScheduleOrder(events: Event[]): Event[] {
+  const idToEvent = new Map(events.map(e => [e.id, e]));
+  const dependents = new Map<string, Set<string>>();
+  const inDegree = new Map<string, number>();
+
+  for (const event of events) {
+    inDegree.set(event.id, 0);
+    dependents.set(event.id, new Set());
+  }
+
+  for (const event of events) {
+    for (const prereqId of event.prerequisites ?? []) {
+      if (!idToEvent.has(prereqId)) continue;
+      dependents.get(prereqId)!.add(event.id);
+      inDegree.set(event.id, inDegree.get(event.id)! + 1);
+    }
+  }
+
+  // Kahn's algorithm, processing shorter-duration events first among ready events
+  const ready: Event[] = events
+    .filter(e => inDegree.get(e.id) === 0)
+    .sort((a, b) => a.duration - b.duration);
+
+  const result: Event[] = [];
+
+  while (ready.length > 0) {
+    const event = ready.shift()!;
+    result.push(event);
+
+    for (const depId of dependents.get(event.id)!) {
+      const newDeg = inDegree.get(depId)! - 1;
+      inDegree.set(depId, newDeg);
+      if (newDeg === 0) {
+        const dep = idToEvent.get(depId)!;
+        let lo = 0, hi = ready.length;
+        while (lo < hi) {
+          const mid = (lo + hi) >> 1;
+          if (ready[mid].duration <= dep.duration) lo = mid + 1;
+          else hi = mid;
+        }
+        ready.splice(lo, 0, dep);
+      }
+    }
+  }
+
+  if (result.length < events.length) {
+    const cycleIds = events
+      .filter(e => inDegree.get(e.id)! > 0)
+      .map(e => e.id);
+    throw new Error(`Prerequisite cycle detected: ${cycleIds.join(', ')}`);
+  }
+
+  return result;
+}
+
+// Find earliest start >= earliestStart where [start, start+duration] fits in the room.
+// All existing intervals must be separated from the new event by >= gap minutes.
+function findEarliestSlot(
+  intervals: Interval[],
+  earliestStart: number,
+  duration: number,
+  endTime: number,
+  gap: number
+): number | null {
+  let candidate = earliestStart;
+  for (const iv of intervals) {
+    // Can we place [candidate, candidate+duration] before this interval?
+    if (candidate + duration + gap <= iv.start) break;
+    // No — push candidate past this interval
+    candidate = Math.max(candidate, iv.end + gap);
+  }
+  return candidate + duration <= endTime ? candidate : null;
+}
+
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions
+): ScheduleResult {
+  const gap = options.gap ?? 15;
+  const ordered = computeScheduleOrder(events); // throws on cycle
+
+  const roomIntervals = new Map<string, Interval[]>(
+    rooms.map(r => [r.id, []])
+  );
+
+  const assignments: Assignment[] = [];
+  const assignmentMap = new Map<string, Assignment>();
+  const unscheduled: string[] = [];
+
+  for (const event of ordered) {
+    const attendees = event.attendees ?? 1;
+    let canSchedule = true;
+    let earliestStart = options.startTime;
+
+    for (const prereqId of event.prerequisites ?? []) {
+      const prereq = assignmentMap.get(prereqId);
+      if (!prereq) {
+        canSchedule = false;
+        break;
+      }
+      earliestStart = Math.max(earliestStart, prereq.endTime + gap);
+    }
+
+    if (!canSchedule) {
+      unscheduled.push(event.id);
+      continue;
+    }
+
+    // Preferred room first, then others sorted by smallest fitting capacity
+    const eligible = rooms.filter(r => r.capacity >= attendees);
+    const preferred = eligible.filter(r => r.id === event.preferredRoom);
+    const others = eligible
+      .filter(r => r.id !== event.preferredRoom)
+      .sort((a, b) => a.capacity - b.capacity);
+    const orderedRooms = [...preferred, ...others];
+
+    let placed = false;
+    for (const room of orderedRooms) {
+      const intervals = roomIntervals.get(room.id);
+      if (!intervals) continue;
+
+      const slot = findEarliestSlot(
+        intervals,
+        earliestStart,
+        event.duration,
+        options.endTime,
+        gap
+      );
+
+      if (slot !== null) {
+        const assignment: Assignment = {
+          eventId: event.id,
+          roomId: room.id,
+          startTime: slot,
+          endTime: slot + event.duration,
+        };
+        assignments.push(assignment);
+        assignmentMap.set(event.id, assignment);
+
+        const pos = intervals.findIndex(i => i.start > slot);
+        intervals.splice(pos === -1 ? intervals.length : pos, 0, {
+          start: slot,
+          end: slot + event.duration,
+        });
+        placed = true;
+        break;
+      }
+    }
+
+    if (!placed) {
+      unscheduled.push(event.id);
+    }
+  }
+
+  return { assignments, unscheduled };
+}
diff --git a/tests/scheduler.test.ts b/tests/scheduler.test.ts
