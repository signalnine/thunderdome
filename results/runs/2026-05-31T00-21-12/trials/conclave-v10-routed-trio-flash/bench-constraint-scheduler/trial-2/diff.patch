+  preferredRoom?: string;
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number;
+}
+
+export interface ScheduleOptions {
+  startTime: number;
+  endTime: number;
+  gap?: number;
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[];
+}
+
+function topoSort(events: Event[]): string[] {
+  const ids = new Set(events.map(e => e.id));
+  const inDegree = new Map<string, number>();
+  const adj = new Map<string, string[]>();
+
+  for (const e of events) {
+    if (!inDegree.has(e.id)) inDegree.set(e.id, 0);
+    if (!adj.has(e.id)) adj.set(e.id, []);
+  }
+
+  for (const e of events) {
+    for (const pre of e.prerequisites ?? []) {
+      if (pre === e.id) throw new Error(`Cycle detected: ${e.id} is a prerequisite of itself`);
+      if (!ids.has(pre)) continue; // external prereq not in event list, skip
+      adj.get(pre)!.push(e.id);
+      inDegree.set(e.id, (inDegree.get(e.id) ?? 0) + 1);
+    }
+  }
+
+  const queue: string[] = [];
+  for (const [id, deg] of inDegree) {
+    if (deg === 0) queue.push(id);
+  }
+
+  const order: string[] = [];
+  while (queue.length > 0) {
+    const cur = queue.shift()!;
+    order.push(cur);
+    for (const next of adj.get(cur) ?? []) {
+      const deg = inDegree.get(next)! - 1;
+      inDegree.set(next, deg);
+      if (deg === 0) queue.push(next);
+    }
+  }
+
+  if (order.length !== events.length) {
+    throw new Error('Cycle detected in prerequisite graph');
+  }
+
+  return order;
+}
+
+export function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {
+  const gap = options.gap ?? 15;
+
+  // Validate and get topological order (throws on cycle)
+  const order = topoSort(events);
+
+  const eventMap = new Map(events.map(e => [e.id, e]));
+
+  // Track end time of last event in each room
+  const roomEndTime = new Map<string, number>(rooms.map(r => [r.id, options.startTime]));
+
+  // Track end time of each scheduled event (for prerequisite checking)
+  const eventEndTime = new Map<string, number>();
+
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+
+  for (const id of order) {
+    const event = eventMap.get(id)!;
+    const attendees = event.attendees ?? 1;
+
+    // Earliest start: must be after all prerequisites end + gap
+    let earliestStart = options.startTime;
+    for (const preId of event.prerequisites ?? []) {
+      const preEnd = eventEndTime.get(preId);
+      if (preEnd !== undefined) {
+        earliestStart = Math.max(earliestStart, preEnd + gap);
+      }
+      // If prerequisite was unscheduled, we still try to schedule this event
+    }
+
+    // Find eligible rooms (capacity check)
+    const eligibleRooms = rooms.filter(r => r.capacity >= attendees);
+
+    if (eligibleRooms.length === 0) {
+      unscheduled.push(id);
+      continue;
+    }
+
+    // Sort rooms: preferred first, then by earliest available time
+    const preferred = event.preferredRoom;
+    const sortedRooms = [...eligibleRooms].sort((a, b) => {
+      const aPreferred = a.id === preferred ? 0 : 1;
+      const bPreferred = b.id === preferred ? 0 : 1;
+      if (aPreferred !== bPreferred) return aPreferred - bPreferred;
+      const aAvail = Math.max(roomEndTime.get(a.id)! + (roomEndTime.get(a.id)! > options.startTime ? gap : 0), earliestStart);
+      const bAvail = Math.max(roomEndTime.get(b.id)! + (roomEndTime.get(b.id)! > options.startTime ? gap : 0), earliestStart);
+      return aAvail - bAvail;
+    });
+
+    let placed = false;
+    for (const room of sortedRooms) {
+      const roomAvail = roomEndTime.get(room.id)!;
+      // Gap only needed if room has been used (roomAvail > startTime)
+      const startAfterRoom = roomAvail > options.startTime ? roomAvail + gap : roomAvail;
+      const startTime = Math.max(startAfterRoom, earliestStart);
+      const endTime = startTime + event.duration;
+
+      if (endTime <= options.endTime) {
+        assignments.push({ eventId: id, roomId: room.id, startTime, endTime });
+        roomEndTime.set(room.id, endTime);
+        eventEndTime.set(id, endTime);
+        placed = true;
+        break;
+      }
+    }
+
+    if (!placed) {
+      unscheduled.push(id);
+    }
+  }
+
+  return { assignments, unscheduled };
+}
+
+export default schedule;
