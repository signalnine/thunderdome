r room it got)\n    expect(a2.roomId).not.toBe(a1.roomId);\n  });","originalFile":"import { describe, it, expect } from 'vitest';\nimport { schedule } from './index.js';\nimport type { Event, Room, ScheduleOptions } from './index.js';\n\nconst opts: ScheduleOptions = { startTime: 540, endTime: 1020 }; // 9am-5pm\n\ndescribe('basic scheduling', () => {\n  it('schedules a single event', () => {\n    const events: Event[] = [{ id: 'e1', name: 'E1', duration: 60 }];\n    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];\n    const result = schedule(events, rooms, opts);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.unscheduled).toHaveLength(0);\n    const a = result.assignments[0];\n    expect(a.eventId).toBe('e1');\n    expect(a.roomId).toBe('r1');\n    expect(a.startTime).toBe(540);\n    expect(a.endTime).toBe(600);\n  });\n\n  it('schedules multiple events in same room with gap', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'E1', duration: 60 },\n      { id: 'e2', name: 'E2', duration: 60 },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];\n    const result = schedule(events, rooms, opts);\n    expect(result.assignments).toHaveLength(2);\n    const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n    // Both in same room, e2 must start after e1 ends + 15 gap\n    expect(a2.startTime).toBeGreaterThanOrEqual(a1.endTime + 15);\n  });\n\n  it('uses custom gap', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'E1', duration: 60 },\n      { id: 'e2', name: 'E2', duration: 60 },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];\n    const result = schedule(events, rooms, { ...opts, gap: 30 });\n    const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n    expect(a2.startTime).toBeGreaterThanOrEqual(a1.endTime + 30);\n  });\n\n  it('schedules events in parallel across rooms', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'E1', duration: 60 },\n      { id: 'e2', name: 'E2', duration: 60 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'R1', capacity: 10 },\n      { id: 'r2', name: 'R2', capacity: 10 },\n    ];\n    const result = schedule(events, rooms, opts);\n    expect(result.assignments).toHaveLength(2);\n    const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n    // Can be in different rooms at the same time\n    expect(a1.roomId).not.toBe(a2.roomId);\n    expect(a1.startTime).toBe(a2.startTime);\n  });\n});\n\ndescribe('capacity constraints', () => {\n  it('respects room capacity', () => {\n    const events: Event[] = [{ id: 'e1', name: 'E1', duration: 60, attendees: 20 }];\n    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];\n    const result = schedule(events, rooms, opts);\n    expect(result.assignments).toHaveLength(0);\n    expect(result.unscheduled).toContain('e1');\n  });\n\n  it('picks room with enough capacity', () => {\n    const events: Event[] = [{ id: 'e1', name: 'E1', duration: 60, attendees: 15 }];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'R1', capacity: 10 },\n      { id: 'r2', name: 'R2', capacity: 20 },\n    ];\n    const result = schedule(events, rooms, opts);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0].roomId).toBe('r2');\n  });\n\n  it('defaults attendees to 1', () => {\n    const events: Event[] = [{ id: 'e1', name: 'E1', duration: 60 }];\n    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 1 }];\n    const result = schedule(events, rooms, opts);\n    expect(result.assignments).toHaveLength(1);\n  });\n});\n\ndescribe('time window', () => {\n  it('does not schedule event that would run past endTime', () => {\n    const events: Event[] = [{ id: 'e1', na