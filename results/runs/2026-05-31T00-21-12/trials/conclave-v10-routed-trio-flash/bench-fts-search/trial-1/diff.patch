+/**
+ * Sanitize a user query for FTS5 MATCH syntax.
+ * Preserves quoted phrases, escapes special FTS5 characters in unquoted terms.
+ */
+function sanitizeFtsQuery(query: string): string {
+  const parts: string[] = [];
+  let remaining = query.trim();
+
+  while (remaining.length > 0) {
+    // Preserve quoted phrases
+    const phraseMatch = remaining.match(/^"([^"]*)"/);
+    if (phraseMatch) {
+      // Only include non-empty phrases
+      if (phraseMatch[1].length > 0) {
+        parts.push(`"${phraseMatch[1]}"`);
+      }
+      remaining = remaining.slice(phraseMatch[0].length).trim();
+      continue;
+    }
+
+    // Extract next word (sequence of non-whitespace characters)
+    const wordMatch = remaining.match(/^(\S+)/);
+    if (wordMatch) {
+      const word = wordMatch[1];
+      // Escape FTS5 special characters that have meaning at start of term
+      let escaped = word;
+      // These chars at start of term are FTS5 operators: + - ^
+      if (/^[+\-^]/.test(escaped) && escaped.length > 1) {
+        // Escape by wrapping in quotes so FTS5 treats it as a term
+        escaped = `"${escaped}"`;
+      }
+      parts.push(escaped);
+      remaining = remaining.slice(wordMatch[0].length).trim();
+      continue;
+    }
+
+    break;
+  }
+
+  return parts.join(' ');
+}
