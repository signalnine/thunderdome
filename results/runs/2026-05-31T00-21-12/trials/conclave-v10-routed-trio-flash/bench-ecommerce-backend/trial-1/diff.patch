+import { EventBus } from '../bus.js';
+import { NotificationService, Events, OrderCreatedEvent, OrderStatusChangedEvent, PaymentProcessedEvent } from '../types.js';
+
+export function createNotificationsService(bus: EventBus): NotificationService {
+  const notifications = new Map<string, Array<{ type: string; message: string; timestamp: number }>>();
+  const subscribedUsers = new Set<string>();
+  const orderUserMap = new Map<string, string>();
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const { orderId, userId } = payload as OrderCreatedEvent;
+    orderUserMap.set(orderId, userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    const { orderId, status, previousStatus } = payload as OrderStatusChangedEvent;
+    const userId = orderUserMap.get(orderId);
+    if (!userId || !subscribedUsers.has(userId)) return;
+    notifications.get(userId)!.push({
+      type: 'order_status',
+      message: `Order ${orderId} status changed from ${previousStatus} to ${status}`,
+      timestamp: Date.now(),
+    });
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const { orderId, status, transactionId, error } = payload as PaymentProcessedEvent;
+    const userId = orderUserMap.get(orderId);
+    if (!userId || !subscribedUsers.has(userId)) return;
+    const detail = transactionId ? ` (transaction: ${transactionId})` : error ? `: ${error}` : '';
+    notifications.get(userId)!.push({
+      type: 'payment',
+      message: `Payment for order ${orderId} ${status}${detail}`,
+      timestamp: Date.now(),
+    });
+  });
+
+  return {
+    subscribe(userId) {
+      subscribedUsers.add(userId);
+      if (!notifications.has(userId)) notifications.set(userId, []);
+    },
+
+    getNotifications(userId) {
+      return notifications.get(userId) ?? [];
+    },
+  };
+}
