+import { v4 as uuidv4 } from 'uuid';
+import { EventBus } from '../bus.js';
+import { PaymentService, Events, PaymentStatus, PaymentProcessedEvent } from '../types.js';
+
+export interface PaymentOptions {
+  mode?: 'success' | 'failure' | 'timeout';
+  timeoutMs?: number;
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentOptions = {}): PaymentService {
+  const { mode = 'success', timeoutMs = 100 } = options;
+  const transactions = new Map<string, { orderId: string; amount: number }>();
+
+  return {
+    async processPayment(orderId, amount) {
+      let status: PaymentStatus;
+      let transactionId: string | undefined;
+      let error: string | undefined;
+
+      if (mode === 'timeout') {
+        await new Promise<void>(resolve => setTimeout(resolve, timeoutMs));
+        status = PaymentStatus.TIMEOUT;
+        error = 'Payment timed out';
+      } else if (mode === 'failure') {
+        status = PaymentStatus.FAILED;
+        error = 'Payment failed';
+      } else {
+        transactionId = uuidv4();
+        transactions.set(transactionId, { orderId, amount });
+        status = PaymentStatus.SUCCESS;
+      }
+
+      await bus.emit(Events.PAYMENT_PROCESSED, { orderId, status, transactionId, error } satisfies PaymentProcessedEvent);
+      return { status, transactionId, error };
+    },
+
+    async refund(transactionId) {
+      const tx = transactions.get(transactionId);
+      if (!tx) return false;
+      transactions.delete(transactionId);
+      return true;
+    },
+  };
+}
