+import { v4 as uuidv4 } from 'uuid';
+import { EventBus } from '../bus.js';
+import { OrderService, Events, OrderStatus, OrderCreatedEvent, OrderStatusChangedEvent } from '../types.js';
+
+export function createOrdersService(bus: EventBus): OrderService {
+  const orders = new Map<string, { id: string; userId: string; cartId: string; status: OrderStatus; total: number }>();
+
+  return {
+    createOrder(userId, cartId, total) {
+      const id = uuidv4();
+      orders.set(id, { id, userId, cartId, status: OrderStatus.PENDING, total });
+      void bus.emit(Events.ORDER_CREATED, { orderId: id, userId, cartId, total } satisfies OrderCreatedEvent);
+      return id;
+    },
+
+    getOrder(orderId) {
+      const o = orders.get(orderId);
+      if (!o) return null;
+      return { id: o.id, userId: o.userId, status: o.status, total: o.total };
+    },
+
+    updateStatus(orderId, status) {
+      const o = orders.get(orderId);
+      if (!o) return;
+      const previousStatus = o.status;
+      o.status = status;
+      void bus.emit(Events.ORDER_STATUS_CHANGED, { orderId, status, previousStatus } satisfies OrderStatusChangedEvent);
+    },
+
+    listOrders(userId) {
+      return Array.from(orders.values())
+        .filter(o => o.userId === userId)
+        .map(o => ({ id: o.id, status: o.status, total: o.total }));
+    },
+  };
+}
