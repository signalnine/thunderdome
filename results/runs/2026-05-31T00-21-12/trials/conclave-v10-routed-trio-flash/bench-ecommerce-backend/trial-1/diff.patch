@@ -0,0 +1,65 @@
+import { v4 as uuidv4 } from 'uuid';
+import { EventBus } from '../bus.js';
+import { CartService, Events, CartUpdatedEvent } from '../types.js';
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, { id: string; userId: string; items: Map<string, number> }>();
+
+  function emitUpdated(cartId: string) {
+    const cart = carts.get(cartId);
+    if (!cart) return;
+    const items = Array.from(cart.items.entries()).map(([productId, quantity]) => ({ productId, quantity }));
+    void bus.emit(Events.CART_UPDATED, { cartId, userId: cart.userId, items } satisfies CartUpdatedEvent);
+  }
+
+  return {
+    createCart(userId) {
+      const id = uuidv4();
+      carts.set(id, { id, userId, items: new Map() });
+      emitUpdated(id);
+      return id;
+    },
+
+    addItem(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items.set(productId, (cart.items.get(productId) ?? 0) + quantity);
+      emitUpdated(cartId);
+    },
+
+    removeItem(cartId, productId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items.delete(productId);
+      emitUpdated(cartId);
+    },
+
+    getCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      return {
+        id: cart.id,
+        userId: cart.userId,
+        items: Array.from(cart.items.entries()).map(([productId, quantity]) => ({ productId, quantity })),
+      };
+    },
+
+    clearCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items.clear();
+      emitUpdated(cartId);
+    },
+
+    updateQuantity(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      if (quantity <= 0) {
+        cart.items.delete(productId);
+      } else {
+        cart.items.set(productId, quantity);
+      }
+      emitUpdated(cartId);
+    },
+  };
+}
