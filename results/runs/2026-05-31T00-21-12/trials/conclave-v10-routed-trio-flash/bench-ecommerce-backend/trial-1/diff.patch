@@ -0,0 +1,66 @@
+import { EventBus } from '../bus.js';
+import { AnalyticsService, Events, PaymentProcessedEvent, CartUpdatedEvent, OrderCreatedEvent, PaymentStatus } from '../types.js';
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  let totalRevenue = 0;
+  const uniqueCartIds = new Set<string>();
+  let orderCount = 0;
+  const productOrderCounts = new Map<string, number>();
+  const orderTotals = new Map<string, number>();
+  const cartItemsSnapshot = new Map<string, Array<{ productId: string; quantity: number }>>();
+
+  const trackedEvents = Object.values(Events);
+  for (const eventName of trackedEvents) {
+    bus.on(eventName, () => {
+      eventCounts.set(eventName, (eventCounts.get(eventName) ?? 0) + 1);
+    });
+  }
+
+  bus.on(Events.CART_UPDATED, (payload) => {
+    const { cartId, items } = payload as CartUpdatedEvent;
+    uniqueCartIds.add(cartId);
+    cartItemsSnapshot.set(cartId, items);
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const { orderId, cartId, total } = payload as OrderCreatedEvent;
+    orderCount++;
+    orderTotals.set(orderId, total);
+    const items = cartItemsSnapshot.get(cartId);
+    if (items) {
+      for (const item of items) {
+        productOrderCounts.set(item.productId, (productOrderCounts.get(item.productId) ?? 0) + item.quantity);
+      }
+    }
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const { orderId, status } = payload as PaymentProcessedEvent;
+    if (status === PaymentStatus.SUCCESS) {
+      totalRevenue += orderTotals.get(orderId) ?? 0;
+    }
+  });
+
+  return {
+    getEventCount(eventType) {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue() {
+      return totalRevenue;
+    },
+
+    getConversionRate() {
+      if (uniqueCartIds.size === 0) return 0;
+      return orderCount / uniqueCartIds.size;
+    },
+
+    getTopProducts(limit) {
+      return Array.from(productOrderCounts.entries())
+        .sort(([, a], [, b]) => b - a)
+        .slice(0, limit)
+        .map(([productId, count]) => ({ productId, count }));
+    },
+  };
+}
