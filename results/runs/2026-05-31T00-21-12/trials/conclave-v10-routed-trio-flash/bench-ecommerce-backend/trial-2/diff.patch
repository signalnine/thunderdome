+import { EventBus } from '../bus.js';
+import { NotificationService, Events, NotificationSentEvent, OrderCreatedEvent, OrderStatusChangedEvent, PaymentProcessedEvent } from '../types.js';
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribed = new Set<string>();
+  const notifications = new Map<string, Array<{ type: string; message: string; timestamp: number }>>();
+  const orderUsers = new Map<string, string>();
+
+  function deliver(userId: string, type: string, message: string): void {
+    if (!subscribed.has(userId)) return;
+    if (!notifications.has(userId)) notifications.set(userId, []);
+    const timestamp = Date.now();
+    notifications.get(userId)!.push({ type, message, timestamp });
+    const payload: NotificationSentEvent = { userId, type, message };
+    void bus.emit(Events.NOTIFICATION_SENT, payload);
+  }
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const event = payload as OrderCreatedEvent;
+    orderUsers.set(event.orderId, event.userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    const event = payload as OrderStatusChangedEvent;
+    const userId = orderUsers.get(event.orderId);
+    if (userId) deliver(userId, 'order_status', `Order ${event.orderId} status changed to ${event.status}`);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const event = payload as PaymentProcessedEvent;
+    const userId = orderUsers.get(event.orderId);
+    if (userId) deliver(userId, 'payment', `Payment for order ${event.orderId}: ${event.status}`);
+  });
+
+  return {
+    subscribe(userId: string): void {
+      subscribed.add(userId);
+    },
+
+    getNotifications(userId: string) {
+      return notifications.get(userId) ?? [];
+    },
+  };
+}
