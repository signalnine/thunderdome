diff --git a/src/analytics/index.ts b/src/analytics/index.ts
new file mode 100644
index 0000000..81cdd8e
--- /dev/null
+++ b/src/analytics/index.ts
@@ -0,0 +1,63 @@
+import { EventBus } from '../bus.js';
+import { AnalyticsService, Events, PaymentProcessedEvent, PaymentStatus, OrderCreatedEvent, CartUpdatedEvent } from '../types.js';
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  let revenue = 0;
+  const uniqueCartIds = new Set<string>();
+  let orderCount = 0;
+  const productOrderCounts = new Map<string, number>();
+  const orderTotals = new Map<string, number>();
+  const cartItems = new Map<string, Array<{ productId: string; quantity: number }>>();
+
+  for (const eventName of Object.values(Events)) {
+    bus.on(eventName, () => {
+      eventCounts.set(eventName, (eventCounts.get(eventName) ?? 0) + 1);
+    });
+  }
+
+  bus.on(Events.CART_UPDATED, (payload) => {
+    const event = payload as CartUpdatedEvent;
+    uniqueCartIds.add(event.cartId);
+    cartItems.set(event.cartId, event.items);
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const event = payload as OrderCreatedEvent;
+    orderCount++;
+    orderTotals.set(event.orderId, event.total);
+    const items = cartItems.get(event.cartId) ?? [];
+    for (const item of items) {
+      productOrderCounts.set(item.productId, (productOrderCounts.get(item.productId) ?? 0) + item.quantity);
+    }
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const event = payload as PaymentProcessedEvent;
+    if (event.status === PaymentStatus.SUCCESS) {
+      revenue += orderTotals.get(event.orderId) ?? 0;
+    }
+  });
+
+  return {
+    getEventCount(eventType: string): number {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue(): number {
+      return revenue;
+    },
+
+    getConversionRate(): number {
+      if (uniqueCartIds.size === 0) return 0;
+      return orderCount / uniqueCartIds.size;
+    },
+
+    getTopProducts(limit: number): Array<{ productId: string; count: number }> {
+      return Array.from(productOrderCounts.entries())
+        .sort((a, b) => b[1] - a[1])
+        .slice(0, limit)
+        .map(([productId, count]) => ({ productId, count }));
+    },
+  };
+}
diff --git a/src/cart/index.ts b/src/cart/index.ts
new file mode 100644
index 0000000..5d9e38b
--- /dev/null
+++ b/src/cart/index.ts
@@ -0,0 +1,66 @@
+import { v4 as uuidv4 } from 'uuid';
+import { EventBus } from '../bus.js';
+import { CartService, Events, CartUpdatedEvent } from '../types.js';
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, { id: string; userId: string; items: Map<string, number> }>();
+
+  function emitCartUpdated(cartId: string): void {
+    const cart = carts.get(cartId);
+    if (!cart) return;
+    const items = Array.from(cart.items.entries()).map(([productId, quantity]) => ({ productId, quantity }));
+    const payload: CartUpdatedEvent = { cartId, userId: cart.userId, items };
+    void bus.emit(Events.CART_UPDATED, payload);
+  }
+
+  return {
+    createCart(userId: string): string {
+      const id = uuidv4();
+      carts.set(id, { id, userId, items: new Map() });
+      return id;
+    },
+
+    addItem(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const current = cart.items.get(productId) ?? 0;
+      cart.items.set(productId, current + quantity);
+      emitCartUpdated(cartId);
+    },
+
+    removeItem(cartId: string, productId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items.delete(productId);
+      emitCartUpdated(cartId);
+    },
+
+    getCart(cartId: string) {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      return {
+        id: cart.id,
+        userId: cart.userId,
+        items: Array.from(cart.items.entries()).map(([productId, quantity]) => ({ productId, quantity })),
+      };
+    },
+
+    clearCart(cartId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items.clear();
+      emitCartUpdated(cartId);
+    },
+
+    updateQuantity(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      if (quantity <= 0) {
+        cart.items.delete(productId);
+      } else {
+        cart.items.set(productId, quantity);
+      }
+      emitCartUpdated(cartId);
+    },
+  };
+}
