+import { describe, it, expect, beforeEach } from 'vitest';
+import { EventBus } from '../bus.js';
+import { createCatalogService } from '../catalog/index.js';
+import { createInventoryService } from '../inventory/index.js';
+import { createCartService } from '../cart/index.js';
+import { createPricingService } from '../pricing/index.js';
+import { createOrderService } from '../orders/index.js';
+import { createPaymentService } from '../payment/index.js';
+import { createNotificationService } from '../notifications/index.js';
+import { createAnalyticsService } from '../analytics/index.js';
+import { Events, OrderStatus, PaymentStatus } from '../types.js';
+
+let bus: EventBus;
+
+beforeEach(() => {
+  bus = new EventBus();
+});
+
+describe('CatalogService', () => {
+  it('creates a product and emits event', async () => {
+    const catalog = createCatalogService(bus);
+    let emitted = false;
+    bus.on(Events.PRODUCT_CREATED, () => { emitted = true; });
+    const id = catalog.createProduct('Widget', 9.99, 'gadgets');
+    await Promise.resolve();
+    expect(typeof id).toBe('string');
+    expect(emitted).toBe(true);
+  });
+
+  it('getProduct returns null for unknown id', () => {
+    const catalog = createCatalogService(bus);
+    expect(catalog.getProduct('nope')).toBeNull();
+  });
+
+  it('listProducts filters by category', () => {
+    const catalog = createCatalogService(bus);
+    catalog.createProduct('A', 1, 'cat1');
+    catalog.createProduct('B', 2, 'cat2');
+    const result = catalog.listProducts('cat1');
+    expect(result).toHaveLength(1);
+    expect(result[0].name).toBe('A');
+  });
+
+  it('searchProducts finds by name substring', () => {
+    const catalog = createCatalogService(bus);
+    catalog.createProduct('Blue Widget', 5, 'gadgets');
+    catalog.createProduct('Red Gizmo', 3, 'tools');
+    expect(catalog.searchProducts('widget')).toHaveLength(1);
+    expect(catalog.searchProducts('gizmo')).toHaveLength(1);
+    expect(catalog.searchProducts('XYZ')).toHaveLength(0);
+  });
+
+  it('searchProducts finds by category substring', () => {
+    const catalog = createCatalogService(bus);
+    catalog.createProduct('Thing', 5, 'electronics');
+    expect(catalog.searchProducts('elect')).toHaveLength(1);
+  });
+
+  it('updateProduct changes fields', () => {
+    const catalog = createCatalogService(bus);
+    const id = catalog.createProduct('Old', 1, 'cat');
+    catalog.updateProduct(id, { name: 'New', price: 99 });
+    const p = catalog.getProduct(id);
+    expect(p?.name).toBe('New');
+    expect(p?.price).toBe(99);
+    expect(p?.category).toBe('cat');
+  });
+
+  it('removeProduct returns true on success and false for unknown', () => {
+    const catalog = createCatalogService(bus);
+    const id = catalog.createProduct('X', 1, 'c');
+    expect(catalog.removeProduct(id)).toBe(true);
+    expect(catalog.removeProduct('nope')).toBe(false);
+    expect(catalog.getProduct(id)).toBeNull();
+  });
+});
+
+describe('InventoryService', () => {
+  it('setStock and getStock', () => {
+    const inv = createInventoryService(bus);
+    inv.setStock('p1', 10);
+    expect(inv.getStock('p1')).toBe(10);
+  });
+
+  it('getStock returns 0 for unknown product', () => {
+    const inv = createInventoryService(bus);
+    expect(inv.getStock('unknown')).toBe(0);
+  });
+
+  it('reserve reduces stock and returns true', () => {
+    const inv = createInventoryService(bus);
+    inv.setStock('p1', 10);
+    expect(inv.reserve('p1', 3)).toBe(true);
+    expect(inv.getStock('p1')).toBe(7);
+  });
+
+  it('reserve returns false if insufficient', () => {
+    const inv = createInventoryService(bus);
+    inv.setStock('p1', 2);
+    expect(inv.reserve('p1', 5)).toBe(false);
+    expect(inv.getStock('p1')).toBe(2);
+  });
+
+  it('release increases stock', () => {
+    const inv = createInventoryService(bus);
+    inv.setStock('p1', 5);
+    inv.reserve('p1', 3);
+    inv.release('p1', 2);
+    expect(inv.getStock('p1')).toBe(4);
+  });
+
+  it('emits low stock alert when stock falls below threshold', async () => {
+    const inv = createInventoryService(bus);
+    const alerts: unknown[] = [];
+    bus.on(Events.LOW_STOCK_ALERT, (p) => { alerts.push(p); });
+    inv.setStock('p1', 10);
+    inv.setLowStockThreshold('p1', 5);
+    expect(alerts).toHaveLength(0);
+    inv.reserve('p1', 6);
+    await Promise.resolve();
+    expect(alerts).toHaveLength(1);
+  });
+});
+
+describe('CartService', () => {
+  it('creates a cart with unique id', () => {
+    const cart = createCartService(bus);
+    const id1 = cart.createCart('user1');
+    const id2 = cart.createCart('user1');
+    expect(id1).not.toBe(id2);
+  });
+
+  it('addItem consolidates same product', () => {
+    const cart = createCartService(bus);
+    const cartId = cart.createCart('user1');
+    cart.addItem(cartId, 'p1', 2);
+    cart.addItem(cartId, 'p1', 3);
+    const c = cart.getCart(cartId);
+    expect(c?.items).toHaveLength(1);
+    expect(c?.items[0].quantity).toBe(5);
+  });
+
+  it('removeItem removes a product', () => {
+    const cart = createCartService(bus);
+    const cartId = cart.createCart('user1');
+    cart.addItem(cartId, 'p1', 2);
+    cart.addItem(cartId, 'p2', 1);
+    cart.removeItem(cartId, 'p1');
+    const c = cart.getCart(cartId);
+    expect(c?.items).toHaveLength(1);
+    expect(c?.items[0].productId).toBe('p2');
+  });
+
+  it('clearCart empties the cart', () => {
+    const cart = createCartService(bus);
+    const cartId = cart.createCart('user1');
+    cart.addItem(cartId, 'p1', 5);
+    cart.clearCart(cartId);
+    expect(cart.getCart(cartId)?.items).toHaveLength(0);
+  });
+
+  it('updateQuantity sets quantity', () => {
+    const cart = createCartService(bus);
+    const cartId = cart.createCart('user1');
+    cart.addItem(cartId, 'p1', 5);
+    cart.updateQuantity(cartId, 'p1', 2);
+    expect(cart.getCart(cartId)?.items[0].quantity).toBe(2);
+  });
+
+  it('updateQuantity with 0 removes item', () => {
+    const cart = createCartService(bus);
+    const cartId = cart.createCart('user1');
+    cart.addItem(cartId, 'p1', 5);
+    cart.updateQuantity(cartId, 'p1', 0);
+    expect(cart.getCart(cartId)?.items).toHaveLength(0);
+  });
+
+  it('getCart returns null for unknown id', () => {
+    const cart = createCartService(bus);
+    expect(cart.getCart('nope')).toBeNull();
+  });
+
+  it('emits CART_UPDATED on addItem', async () => {
+    const cart = createCartService(bus);
+    const events: unknown[] = [];
+    bus.on(Events.CART_UPDATED, (p) => { events.push(p); });
+    const cartId = cart.createCart('user1');
+    cart.addItem(cartId, 'p1', 1);
+    await Promise.resolve();
+    expect(events).toHaveLength(1);
+  });
+});
+
+describe('PricingService', () => {
+  it('calculates subtotal, tax, total correctly', () => {
+    const pricing = createPricingService(bus);
+    const result = pricing.calculateTotal([
+      { productId: 'p1', quantity: 2, price: 10 },
+      { productId: 'p2', quantity: 1, price: 5 },
+    ]);
+    expect(result.subtotal).toBe(25);
+    expect(result.discount).toBe(0);
+    expect(result.tax).toBeCloseTo(2.5);
+    expect(result.total).toBeCloseTo(27.5);
+  });
+
+  it('applies percentage discount before tax', () => {
+    const pricing = createPricingService(bus);
+    pricing.addDiscountCode('SAVE20', 20);
+    const result = pricing.calculateTotal(
+      [{ productId: 'p1', quantity: 1, price: 100 }],
+      'SAVE20',
+    );
+    expect(result.subtotal).toBe(100);
+    expect(result.discount).toBe(20);
+    expect(result.tax).toBeCloseTo(8);
+    expect(result.total).toBeCloseTo(88);
+  });
+
+  it('unknown discount code applies no discount', () => {
+    const pricing = createPricingService(bus);
+    const result = pricing.calculateTotal(
+      [{ productId: 'p1', quantity: 1, price: 50 }],
+      'INVALID',
+    );
+    expect(result.discount).toBe(0);
+  });
+
+  it('tracks product price from PRODUCT_CREATED event', async () => {
+    const catalog = createCatalogService(bus);
+    const pricing = createPricingService(bus);
+    const id = catalog.createProduct('Widget', 42, 'stuff');
+    await Promise.resolve();
+    expect(pricing.getPrice(id)).toBe(42);
+  });
+
+  it('getPrice returns 0 for unknown product', () => {
+    const pricing = createPricingService(bus);
+    expect(pricing.getPrice('unknown')).toBe(0);
+  });
+});
+
+describe('OrderService', () => {
+  it('creates order with PENDING status', async () => {
+    const orders = createOrderService(bus);
+    const id = orders.createOrder('user1', 'cart1', 99.99);
+    await Promise.resolve();
+    const order = orders.getOrder(id);
+    expect(order?.status).toBe(OrderStatus.PENDING);
+    expect(order?.total).toBe(99.99);
+  });
+
+  it('emits ORDER_CREATED on creation', async () => {
+    const orders = createOrderService(bus);
+    const emitted: unknown[] = [];
+    bus.on(Events.ORDER_CREATED, (p) => { emitted.push(p); });
+    orders.createOrder('user1', 'cart1', 50);
+    await Promise.resolve();
+    expect(emitted).toHaveLength(1);
+  });
+
+  it('updateStatus changes status and emits event with previousStatus', async () => {
+    const orders = createOrderService(bus);
+    const changed: unknown[] = [];
+    bus.on(Events.ORDER_STATUS_CHANGED, (p) => { changed.push(p); });
+    const id = orders.createOrder('user1', 'cart1', 50);
+    await Promise.resolve();
+    orders.updateStatus(id, OrderStatus.CONFIRMED);
+    await Promise.resolve();
+    expect(orders.getOrder(id)?.status).toBe(OrderStatus.CONFIRMED);
