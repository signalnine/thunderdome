+import { v4 as uuidv4 } from 'uuid';
+import { EventBus } from '../bus.js';
+import { PaymentService, Events, PaymentProcessedEvent, PaymentStatus } from '../types.js';
+
+export interface PaymentOptions {
+  simulateSuccess?: boolean;
+  simulateFailure?: boolean;
+  simulateTimeout?: boolean;
+  timeoutMs?: number;
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentOptions = {}): PaymentService {
+  const transactions = new Map<string, { orderId: string; amount: number; status: PaymentStatus }>();
+
+  return {
+    async processPayment(orderId: string, amount: number): Promise<{ status: PaymentStatus; transactionId?: string; error?: string }> {
+      if (options.simulateTimeout) {
+        const delay = options.timeoutMs ?? 0;
+        if (delay > 0) await new Promise(resolve => setTimeout(resolve, delay));
+        const payload: PaymentProcessedEvent = { orderId, status: PaymentStatus.TIMEOUT, error: 'Payment timed out' };
+        await bus.emit(Events.PAYMENT_PROCESSED, payload);
+        return { status: PaymentStatus.TIMEOUT, error: 'Payment timed out' };
+      }
+
+      if (options.simulateFailure) {
+        const payload: PaymentProcessedEvent = { orderId, status: PaymentStatus.FAILED, error: 'Payment failed' };
+        await bus.emit(Events.PAYMENT_PROCESSED, payload);
+        return { status: PaymentStatus.FAILED, error: 'Payment failed' };
+      }
+
+      const transactionId = uuidv4();
+      transactions.set(transactionId, { orderId, amount, status: PaymentStatus.SUCCESS });
+      const payload: PaymentProcessedEvent = { orderId, status: PaymentStatus.SUCCESS, transactionId };
+      await bus.emit(Events.PAYMENT_PROCESSED, payload);
+      return { status: PaymentStatus.SUCCESS, transactionId };
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      const tx = transactions.get(transactionId);
+      if (!tx || tx.status !== PaymentStatus.SUCCESS) return false;
+      transactions.delete(transactionId);
+      return true;
+    },
+  };
+}
