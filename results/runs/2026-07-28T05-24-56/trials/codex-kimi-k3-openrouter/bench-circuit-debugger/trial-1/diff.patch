+import { describe, it, expect } from 'vitest';
+import { findSwappedWires, Gate } from '../src/index.js';
+import { buildAdder, applySwaps, shuffled } from './gen.js';
+
+// Deterministic RNG
+function makeRng(seed: number) {
+  let s = seed >>> 0;
+  return () => {
+    s ^= s << 13; s ^= s >>> 17; s ^= s << 5;
+    return (s >>> 0) / 4294967296;
+  };
+}
+
+// All wire names that appear as gate outputs in the adder.
+function outputWires(gates: Gate[]): string[] {
+  return gates.map((g) => g.out);
+}
+
+function randomSwappedCircuit(numBits: number, seed: number): { gates: Gate[]; expected: string[] } {
+  const base = buildAdder(numBits);
+  const rng = makeRng(seed);
+  const wires = outputWires(base);
+  // pick 4 disjoint random pairs
+  const chosen = new Set<string>();
+  const pairs: Array<[string, string]> = [];
+  while (pairs.length < 4) {
+    const a = wires[Math.floor(rng() * wires.length)];
+    const b = wires[Math.floor(rng() * wires.length)];
+    if (a === b || chosen.has(a) || chosen.has(b)) continue;
+    chosen.add(a); chosen.add(b);
+    pairs.push([a, b]);
+  }
+  const gates = shuffled(applySwaps(base, pairs), seed + 1);
+  return { gates, expected: pairs.flat().sort() };
+}
+
+describe('fuzz', () => {
+  it('many random 4-pair swaps across widths', () => {
+    const widths = [4, 5, 6, 8, 12, 20, 45];
+    let failures = 0;
+    for (const w of widths) {
+      for (let seed = 1; seed <= 60; seed++) {
+        const { gates, expected } = randomSwappedCircuit(w, seed * 1000 + w);
+        let result: string[];
+        try {
+          result = findSwappedWires(gates);
+        } catch (e) {
+          failures++;
+          console.log(`THROW w=${w} seed=${seed * 1000 + w}: ${(e as Error).message} expected=${expected}`);
+          continue;
+        }
+        if (JSON.stringify(result) !== JSON.stringify(expected)) {
+          failures++;
+          if (failures < 8) console.log(`MISMATCH w=${w} seed=${seed * 1000 + w}\n  got=${result}\n  exp=${expected}`);
+        }
+      }
+    }
+    expect(failures).toBe(0);
+  });
+});
