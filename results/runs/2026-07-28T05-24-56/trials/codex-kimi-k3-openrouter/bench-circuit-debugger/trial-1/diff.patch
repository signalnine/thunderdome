@@ -0,0 +1,140 @@
+import { describe, it, expect } from 'vitest';
+import { simulate, findSwappedWires, Gate } from '../src/index.js';
+import { buildAdder, applySwaps, shuffled } from './gen.js';
+
+function simulateAdder(gates: Gate[], numBits: number, x: bigint, y: bigint): bigint {
+  const p2 = (n: number) => (n < 10 ? `0${n}` : `${n}`);
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < numBits; i++) {
+    inputs[`x${p2(i)}`] = Number((x >> BigInt(i)) & 1n);
+    inputs[`y${p2(i)}`] = Number((y >> BigInt(i)) & 1n);
+  }
+  const values = simulate(gates, inputs);
+  let z = 0n;
+  for (let i = 0; i <= numBits; i++) {
+    if (values[`z${p2(i)}`] === 1) z |= 1n << BigInt(i);
+  }
+  return z;
+}
+
+describe('simulate', () => {
+  it('handles a single gate', () => {
+    expect(simulate([{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }], { a: 1, b: 1 })).toEqual({
+      a: 1,
+      b: 1,
+      c: 1,
+    });
+  });
+
+  it('applies all three ops', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'w' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'x' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'y' },
+      { op: 'XOR', in1: 'a', in2: 'c', out: 'z' },
+    ];
+    const out = simulate(gates, { a: 1, b: 0, c: 0 });
+    expect(out.w).toBe(0);
+    expect(out.x).toBe(1);
+    expect(out.y).toBe(1);
+    expect(out.z).toBe(1);
+  });
+
+  it('processes in dependency order regardless of gate order', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'd', in2: 'e', out: 'f' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'd' },
+      { op: 'OR', in1: 'b', in2: 'c', out: 'e' },
+    ];
+    const out = simulate(gates, { a: 1, b: 1, c: 0 });
+    expect(out.d).toBe(0);
+    expect(out.e).toBe(1);
+    expect(out.f).toBe(0);
+  });
+
+  it('computes correct sums for a clean 4-bit adder', () => {
+    const gates = buildAdder(4);
+    for (let x = 0n; x < 16n; x++) {
+      for (let y = 0n; y < 16n; y++) {
+        expect(simulateAdder(gates, 4, x, y)).toBe(x + y);
+      }
+    }
+  });
+});
+
+describe('findSwappedWires', () => {
+  it('returns empty for a clean circuit', () => {
+    expect(findSwappedWires(buildAdder(4))).toEqual([]);
+    expect(findSwappedWires(buildAdder(45))).toEqual([]);
+  });
+
+  it('detects a single swapped pair (4-bit)', () => {
+    const gates = applySwaps(buildAdder(4), [['z01', 'a01']]);
+    expect(findSwappedWires(gates)).toEqual(['a01', 'z01']);
+  });
+
+  it('detects z<->a style swaps', () => {
+    const pairs: Array<[string, string]> = [
+      ['z02', 'a02'],
+      ['t03', 'b03'],
+      ['c01', 'z03'],
+      ['z04', 'a04'],
+    ];
+    const gates = applySwaps(buildAdder(5), pairs);
+    expect(findSwappedWires(gates)).toEqual(pairs.flat().sort());
+  });
+
+  it('detects 4 disjoint pairs in a 6-bit adder', () => {
+    const pairs: Array<[string, string]> = [
+      ['z01', 'a01'],
+      ['z02', 'c01'],
+      ['t03', 'b03'],
+      ['z04', 'c03'],
+    ];
+    const gates = applySwaps(buildAdder(6), pairs);
+    const expected = pairs.flat().sort();
+    expect(findSwappedWires(gates)).toEqual(expected);
+  });
+
+  it('detects swaps affecting the final carry output', () => {
+    const pairs: Array<[string, string]> = [
+      ['z04', 'c03'],
+      ['z01', 't01'],
+      ['z02', 'a02'],
+      ['b03', 't03'],
+    ];
+    const gates = applySwaps(buildAdder(5), pairs);
+    const expected = pairs.flat().sort();
+    expect(findSwappedWires(gates)).toEqual(expected);
+  });
+
+  it('detects swaps on shuffled gate order', () => {
+    const pairs: Array<[string, string]> = [
+      ['z02', 'a02'],
+      ['c02', 'z03'],
+      ['t01', 'b01'],
+      ['z04', 'c03'],
+    ];
+    const gates = shuffled(applySwaps(buildAdder(6), pairs), 42);
+    const expected = pairs.flat().sort();
+    expect(findSwappedWires(gates)).toEqual(expected);
+  });
+
+  it('handles 45-bit adder quickly', () => {
+    const numBits = 45;
+    const p2 = (n: number) => (n < 10 ? `0${n}` : `${n}`);
+    const pairs: Array<[string, string]> = [
+      ['z05', 'a05'],
+      [`c10`, `z12`],
+      ['t20', 'b20'],
+      [`z${p2(43)}`, `c${p2(42)}`],
+    ];
+    const gates = shuffled(applySwaps(buildAdder(numBits), pairs), 7);
+    const expected = pairs.flat().sort();
+    const start = Date.now();
+    const result = findSwappedWires(gates);
+    const elapsed = Date.now() - start;
+    expect(result).toEqual(expected);
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
