+import { Gate } from '../src/index.js';
+
+// Build a canonical ripple-carry adder of the given width.
+export function buildAdder(numBits: number): Gate[] {
+  const gates: Gate[] = [];
+  const p2 = (n: number) => (n < 10 ? `0${n}` : `${n}`);
+  let carry = 'c00';
+  for (let i = 0; i < numBits; i++) {
+    const x = `x${p2(i)}`;
+    const y = `y${p2(i)}`;
+    const z = `z${p2(i)}`;
+    if (i === 0) {
+      gates.push({ op: 'XOR', in1: x, in2: y, out: z });
+      gates.push({ op: 'AND', in1: x, in2: y, out: carry });
+      continue;
+    }
+    const t = `t${p2(i)}`;
+    const a = `a${p2(i)}`;
+    const b = `b${p2(i)}`;
+    gates.push({ op: 'XOR', in1: x, in2: y, out: t });
+    gates.push({ op: 'XOR', in1: t, in2: carry, out: z });
+    gates.push({ op: 'AND', in1: x, in2: y, out: a });
+    gates.push({ op: 'AND', in1: t, in2: carry, out: b });
+    const nextCarry = i === numBits - 1 ? `z${p2(i + 1)}` : `c${p2(i)}`;
+    gates.push({ op: 'OR', in1: a, in2: b, out: nextCarry });
+    carry = nextCarry;
+  }
+  return gates;
+}
+
+export function applySwaps(gates: Gate[], pairs: Array<[string, string]>): Gate[] {
+  const map = new Map<string, string>();
+  for (const [a, b] of pairs) {
+    map.set(a, b);
+    map.set(b, a);
+  }
+  return gates.map((g) => {
+    const out = map.get(g.out);
+    return out === undefined ? g : { ...g, out };
+  });
+}
+
+export function shuffled<T>(arr: T[], seed: number): T[] {
+  const a = [...arr];
+  let s = seed;
+  for (let i = a.length - 1; i > 0; i--) {
+    s = (s * 1103515245 + 12345) & 0x7fffffff;
+    const j = s % (i + 1);
+    [a[i], a[j]] = [a[j], a[i]];
+  }
+  return a;
+}
+
+// reference add for testing
+export function refAdd(x: bigint, y: bigint): bigint {
+  return x + y;
+}
