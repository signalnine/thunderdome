+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+function applyOp(op: Gate['op'], a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+  }
+}
+
+/**
+ * Simulate the circuit. Gates fire in dependency order: a gate can only
+ * produce a value once both of its input wires have values.
+ */
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values: Record<string, number> = { ...inputs };
+  // Worklist evaluation: track how many inputs each gate is waiting on and
+  // which gates consume each wire, so every wire/gate is processed once.
+  const waiting = new Map<Gate, number>();
+  const consumers = new Map<string, Gate[]>();
+  const ready: Gate[] = [];
+  for (const gate of gates) {
+    let missing = 0;
+    for (const input of [gate.in1, gate.in2]) {
+      if (values[input] === undefined) {
+        missing++;
+        const list = consumers.get(input);
+        if (list) list.push(gate);
+        else consumers.set(input, [gate]);
+      }
+    }
+    waiting.set(gate, missing);
+    if (missing === 0) ready.push(gate);
+  }
+  while (ready.length > 0) {
+    const gate = ready.pop()!;
+    const a = values[gate.in1];
+    const b = values[gate.in2];
+    if (a === undefined || b === undefined) continue;
+    values[gate.out] = applyOp(gate.op, a, b);
+    for (const next of consumers.get(gate.out) ?? []) {
+      const remaining = waiting.get(next)! - 1;
+      waiting.set(next, remaining);
+      if (remaining === 0) ready.push(next);
+    }
+  }
+  return values;
+}
+const X_RE = /^x(\d+)$/;
+
+function pad2(n: number): string {
+  return n < 10 ? `0${n}` : `${n}`;
+}
+/**
+ * Find the 8 wires whose gate outputs were exchanged (4 swapped pairs) in a
+ * ripple-carry adder that should compute X + Y = Z.
+ *
+ * Swaps only rewrote gate `out` fields, so the input-reference graph is
+ * pristine: each gate still consumes the wire names the intended circuit
+ * says it should. Canonical wire roles are propagated through that graph
+ * using the full-adder template, starting from the known x/y/z anchors:
+ *
+ *   XOR(x_i, y_i) -> t_i     XOR(t_i, c_{i-1}) -> z_i
+ *   AND(x_i, y_i) -> a_i     AND(t_i, c_{i-1}) -> b_i
+ *                            OR (a_i, b_i)     -> c_i  (z_N on the last bit)
+ *
+ * A gate whose inputs match a template rule assigns the rule's role to its
+ * output wire. When a swap moved a wire, some gate's inputs no longer match
+ * the rule they should; the mismatch between the roles the gate's inputs
+ * actually carry and the roles it needs exposes the two exchanged wires.
+ *//**
+ * Find the 8 wires whose gate outputs were exchanged (4 swapped pairs) in a
+ * ripple-carry adder that should compute X + Y = Z.
+ *
+ * Two phases:
+ *
+ * 1. Structural localization. Swaps only rewrote gate `out` fields, so the
+ *    input-reference graph is pristine and canonical wire roles propagate
+ *    through it following the full-adder template:
+ *      XOR(x_i, y_i) -> t_i   XOR(t_i, c_{i-1}) -> z_i
+ *      AND(x_i, y_i) -> a_i   AND(t_i, c_{i-1}) -> b_i
+ *                             OR (a_i, b_i)     -> c_i (z_N on the last bit)
+ *    Propagation stalls exactly where a swap made a gate's inputs
+ *    inconsistent with the rule it should implement, so the wires touching
+ *    the stalled gates — plus the roles those gates fail to match — form a
+ *    tight candidate pool containing all swapped wires.
+ *
+ * 2. Exact repair. Depth-first search over candidate output swaps, scored
+ *    by test-vector simulation against a reference adder, keeping only swaps
+ *    that strictly increase the number of correct output bits, until the
+ *    circuit verifies.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  let numBits = 0;
+  for (const gate of gates) {
+    const match = X_RE.exec(gate.in1) ?? X_RE.exec(gate.in2);
+    if (match) numBits = Math.max(numBits, parseInt(match[1], 10) + 1);
+  }
+  if (numBits < 2) throw new Error('Malformed circuit: fewer than 2 input bits');
+
+  const wireRole = new Map<string, string>();
+  for (let i = 0; i < numBits; i++) {
+    wireRole.set(`x${pad2(i)}`, `x${pad2(i)}`);
+    wireRole.set(`y${pad2(i)}`, `y${pad2(i)}`);
+  }
+  const roleCarrier = new Map<string, string>();
+
+  const pending = new Set<Gate>(gates);
+  let progressed = true;
+  while (progressed && pending.size > 0) {
+    progressed = false;
+    for (const gate of [...pending]) {
+      const r1 = wireRole.get(gate.in1);
+      const r2 = wireRole.get(gate.in2);
+      if (r1 === undefined || r2 === undefined) continue;
+      const inferred = inferRole(gate.op, r1, r2, numBits);
+      if (inferred === undefined) continue;
+      wireRole.set(gate.out, inferred);
+      roleCarrier.set(inferred, gate.out);
+      pending.delete(gate);
+      progressed = true;
+    }
+  }
+
+  // Candidate pool: wires touching stalled gates, plus the carriers of the
+  // roles those gates reference and need.
+  const candidates = new Set<string>();
+  const includeRole = (r: string | undefined): void => {
+    if (r === undefined) return;
+    candidates.add(r);
+    const carrier = roleCarrier.get(r);
+    if (carrier !== undefined) candidates.add(carrier);
+  };
+  for (const gate of pending) {
+    for (const w of [gate.in1, gate.in2, gate.out]) {
+      if (!X_RE.test(w) && !/^y\d+$/.test(w)) candidates.add(w);
+    }
+    includeRole(wireRole.get(gate.in1));
+    includeRole(wireRole.get(gate.in2));
+  }
+  // For each stalled gate, also include the roles it might need.
+  for (const gate of pending) {
+    const r1 = wireRole.get(gate.in1);
+    const r2 = wireRole.get(gate.in2);
+    if (r1 === undefined || r2 === undefined) continue;
+    for (const needed of allRoles(numBits)) {
+      if (inferRole(gate.op, needed, r2, numBits) !== undefined) includeRole(needed);
+      if (inferRole(gate.op, r1, needed, numBits) !== undefined) includeRole(needed);
+    }
+  }
+
+  // Clean circuit fast path: nothing stalled, every wire carries its own role.
+  if (pending.size === 0) {
+    const clean = [...wireRole.entries()].every(([w, r]) => w === r || isXY(w));
+    if (clean) return [];
+  }
+
+  return repairBySimulation(gates, numBits, [...candidates]);
+}
+
+function isXY(w: string): boolean {
+  return X_RE.test(w) || /^y\d+$/.test(w);
+}
+
+function allRoles(numBits: number): string[] {
+  const roles: string[] = [];
+  for (let i = 0; i < numBits; i++) {
+    roles.push(`t${pad2(i)}`, `a${pad2(i)}`, `b${pad2(i)}`, `c${pad2(i)}`, `z${pad2(i)}`);
+  }
+  roles.push(`z${pad2(numBits)}`);
+  return roles;
+}
+
+interface StalledResolution {
+  intendedRole: string;
+  badWire: string;
+  neededRole: string;
+}
+
+/**
+ * A gate is stalled when its inputs carry roles inconsistent with every
+ * template rule for its op. When exactly one input can be re-interpreted to
+ * make a unique rule match, that input's wire was swapped: the gate needs a
+ * different role there. Returns the gate's intended output role, the
+ * offending input wire, and the role it actually needs.
+ */
+function resolveStalled(
+  gate: Gate,
+  r1: string,
+  r2: string,
+  numBits: number,
+): StalledResolution | undefined {
+  const tryRoles: string[] = [];
+  for (let i = 0; i < numBits; i++) {
+    tryRoles.push(`t${pad2(i)}`, `a${pad2(i)}`, `b${pad2(i)}`, `c${pad2(i)}`);
+  }
+  const candidates: StalledResolution[] = [];
+  for (const needed of tryRoles) {
+    const asFirst = inferRole(gate.op, needed, r2, numBits);
+    if (asFirst !== undefined && needed !== r1) {
+      candidates.push({ intendedRole: asFirst, badWire: gate.in1, neededRole: needed });
+    }
+    const asSecond = inferRole(gate.op, r1, needed, numBits);
+    if (asSecond !== undefined && needed !== r2) {
+      candidates.push({ intendedRole: asSecond, badWire: gate.in2, neededRole: needed });
+    }
+  }
+  if (candidates.length === 0) return undefined;
+  return candidates[0];
+}
+
+const T_RE = /^t(\d+)$/;
+const A_RE = /^a(\d+)$/;
+const C_RE = /^c(\d+)$/;
+
+/** Template role of a gate's output given its op and its inputs' roles. */
+function inferRole(op: Gate['op'], r1: string, r2: string, numBits: number): string | undefined {
+  if (op === 'XOR') {
+    for (const [a, b] of [[r1, r2], [r2, r1]] as const) {
+      const xm = X_RE.exec(a);
+      if (xm && /^y\d+$/.test(b) && xm[1] === b.slice(1)) {
+        const i = parseInt(xm[1], 10);
+        return i === 0 ? 'z00' : `t${pad2(i)}`;
+      }
+      const tm = T_RE.exec(a);
+      const cm = C_RE.exec(b);
+      if (tm && cm && parseInt(tm[1], 10) === parseInt(cm[1], 10) + 1) {
+        return `z${pad2(parseInt(tm[1], 10))}`;
+      }
+    }
+    return undefined;
+  }
+  if (op === 'AND') {
+    for (const [a, b] of [[r1, r2], [r2, r1]] as const) {
+      const xm = X_RE.exec(a);
+      if (xm && /^y\d+$/.test(b) && xm[1] === b.slice(1)) {
+        const i = parseInt(xm[1], 10);
+        return i === 0 ? 'c00' : `a${pad2(i)}`;
+      }
+      const tm = T_RE.exec(a);
+      const cm = C_RE.exec(b);
+      if (tm && cm && parseInt(tm[1], 10) === parseInt(cm[1], 10) + 1) {
+        return `b${pad2(parseInt(tm[1], 10))}`;
+      }
+    }
+    return undefined;
+  }
+  // OR
+  for (const [a, b] of [[r1, r2], [r2, r1]] as const) {
+    const am = A_RE.exec(a);
+    const bm = /^b(\d+)$/.exec(b);
+    if (am && bm && am[1] === bm[1]) {
+      const i = parseInt(am[1], 10);
+      return i === numBits - 1 ? `z${pad2(i + 1)}` : `c${pad2(i)}`;
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Exact fallback for swap clusters that stall structural propagation: depth-
+ * first search over candidate wire pairs, keeping swaps that strictly
+ * increase the number of correct output bits under test-vector simulation,
+ * until the circuit matches a reference adder. `fixed` contains wires already
+ * confirmed correct by structural propagation; only candidate wires are
+ * touched.
+ */
+function repairBySimulation(gates: Gate[], numBits: number, candidates: string[]): string[] {
+  const vectors = makeTestVectors(numBits);
+  const working = gates.map((g) => ({ ...g }));
+  const pool = [...new Set(candidates)];
+
+  const dfs = (depth: number): string[] | null => {
+    const failBit = lowestFailingBit(working, numBits, vectors);
+    if (failBit === -1) return [];
+    if (depth >= 4) return null;
+    const base = correctBitCount(working, numBits, vectors);
+    const scored: Array<{ swap: [string, string]; score: number }> = [];
+    for (let i = 0; i < pool.length; i++) {
+      for (let j = i + 1; j < pool.length; j++) {
+        swapOutputs(working, pool[i], pool[j]);
+        const score = correctBitCount(working, numBits, vectors);
+        swapOutputs(working, pool[i], pool[j]);
+        if (score > base) scored.push({ swap: [pool[i], pool[j]], score });
+      }
+    }
+    scored.sort((a, b) => b.score - a.score);
+    for (const { swap } of scored.slice(0, 8)) {
+      swapOutputs(working, swap[0], swap[1]);
+      const rest = dfs(depth + 1);
+      if (rest !== null) return [swap[0], swap[1], ...rest];
+      swapOutputs(working, swap[0], swap[1]);
+    }
+    return null;
+  };
+
+  const solved = dfs(0);
+  if (solved === null) throw new Error('Could not repair circuit');
+  return solved;
+}
+
+interface TestVector {
+  inputs: Record<string, number>;
+  expected: bigint;
+}
+
+function makeTestVectors(numBits: number): TestVector[] {
+  const vectors: TestVector[] = [];
+  const add = (x: bigint, y: bigint): void => {
+    const inputs: Record<string, number> = {};
+    for (let i = 0; i < numBits; i++) {
+      inputs[`x${pad2(i)}`] = Number((x >> BigInt(i)) & 1n);
+      inputs[`y${pad2(i)}`] = Number((y >> BigInt(i)) & 1n);
+    }
+    vectors.push({ inputs, expected: x + y });
+  };
+  const max = (1n << BigInt(numBits)) - 1n;
+  add(0n, 0n);
+  add(max, max);
+  add(1n, 1n);
+  add(max, 1n);
+  for (let i = 0; i < numBits; i++) {
+    add(1n << BigInt(i), 1n << BigInt(i));
+    add((1n << BigInt(i)) - 1n, 1n);
+  }
+  let state = 0x2545f491 ^ numBits;
+  const rand = (): bigint => {
+    state ^= state << 13;
+    state ^= state >>> 17;
+    state ^= state << 5;
+    return BigInt(state >>> 0);
+  };
+  for (let v = 0; v < 12; v++) {
+    let x = 0n;
+    let y = 0n;
+    for (let i = 0; i < numBits; i += 32) {
+      x |= rand() << BigInt(i);
+      y |= rand() << BigInt(i);
+    }
+    add(x & max, y & max);
+  }
+  return vectors;
+}
+
+function readZ(values: Record<string, number>, numBits: number): bigint {
+  let z = 0n;
+  for (let i = 0; i <= numBits; i++) {
+    if (values[`z${pad2(i)}`] === 1) z |= 1n << BigInt(i);
+  }
+  return z;
+}
+
+function lowestFailingBit(gates: Gate[], numBits: number, vectors: TestVector[]): number {
+  let lowest = -1;
+  for (const { inputs, expected } of vectors) {
+    const diff = readZ(simulate(gates, inputs), numBits) ^ expected;
+    if (diff === 0n) continue;
+    for (let i = 0; i <= numBits; i++) {
+      if ((diff >> BigInt(i)) & 1n) {
+        if (lowest === -1 || i < lowest) lowest = i;
+        break;
+      }
+    }
+  }
+  return lowest;
+}
+
+function correctBitCount(gates: Gate[], numBits: number, vectors: TestVector[]): number {
+  let total = 0;
+  for (const { inputs, expected } of vectors) {
+    let diff = readZ(simulate(gates, inputs), numBits) ^ expected;
+    let wrong = 0;
+    while (diff !== 0n) {
+      diff &= diff - 1n;
+      wrong++;
+    }
+    total += numBits + 1 - wrong;
+  }
+  return total;
+}
+
+function swapOutputs(gates: Gate[], a: string, b: string): void {
+  const ga = gates.find((g) => g.out === a);
+  const gb = gates.find((g) => g.out === b);
+  if (!ga || !gb) return;
+  ga.out = b;
+  gb.out = a;
+}
