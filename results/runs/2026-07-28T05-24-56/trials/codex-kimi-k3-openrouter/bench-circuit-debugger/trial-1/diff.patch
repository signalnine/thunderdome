@@ -0,0 +1,39 @@
+import { it } from 'vitest';
+import { findSwappedWires } from '../src/index.js';
+import { buildAdder, applySwaps, shuffled } from './gen.js';
+
+function makeRng(seed: number) {
+  let s = seed >>> 0;
+  return () => { s ^= s << 13; s ^= s >>> 17; s ^= s << 5; return (s >>> 0) / 4294967296; };
+}
+function bitOf(w: string): number {
+  const m = /(\d+)$/.exec(w); return m ? parseInt(m[1], 10) : -1;
+}
+it('analyze', () => {
+  const widths = [4, 5, 6, 8, 12, 20, 45];
+  let fail = 0, total = 0;
+  const failSeeds: number[] = [];
+  for (const w of widths) for (let seed = 1; seed <= 60; seed++) {
+    const base = buildAdder(w);
+    const rng = makeRng(seed * 1000 + w);
+    const wires = base.map(g => g.out);
+    const chosen = new Set<string>(); const pairs: Array<[string,string]> = [];
+    while (pairs.length < 4) {
+      const a = wires[Math.floor(rng()*wires.length)], b = wires[Math.floor(rng()*wires.length)];
+      if (a===b||chosen.has(a)||chosen.has(b)) continue;
+      chosen.add(a); chosen.add(b); pairs.push([a,b]);
+    }
+    const gates = shuffled(applySwaps(base, pairs), seed*1000+w+1);
+    const exp = pairs.flat().sort();
+    total++;
+    let ok = true;
+    try { ok = JSON.stringify(findSwappedWires(gates)) === JSON.stringify(exp); } catch { ok = false; }
+    if (!ok) {
+      fail++;
+      const bits = exp.map(bitOf).sort((a,b)=>a-b);
+      const spread = bits[bits.length-1]-bits[0];
+      failSeeds.push(spread);
+    }
+  }
+  console.log(`fail ${fail}/${total}; fail spreads: ${failSeeds.join(',')}`);
+});
