+import { randomUUID } from 'node:crypto';
+
+/**
+ * In-memory task queue system.
+ *
+ * Built across 12 phases: FIFO queues, named queues, priority, delayed/scheduled
+ * tasks, retry with exponential backoff, dead-letter queues, dependencies,
+ * concurrency control, progress/cancellation, recurring (cron) tasks, a
+ * middleware pipeline, and graceful shutdown.
+ */
+
+export type TaskStatus =
+  | 'pending'
+  | 'processing'
+  | 'completed'
+  | 'failed'
+  | 'cancelled';
+
+export interface Task {
+  id: string;
+  queueName: string;
+  payload: unknown;
+  status: TaskStatus;
+  createdAt: Date;
+  priority: number;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  dependsOn: string[];
+  lastError?: unknown;
+  failCount: number;
+  /** Monotonic enqueue sequence used as the final FIFO tie-breaker. */
+  seq: number;
+}
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: TaskStatus | 'unknown';
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type ProgressCallback = (info: ProgressInfo) => void;
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+
+export type TaskHandler = (task: Task) => Promise<void> | void;
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: unknown;
+  active: boolean;
+  /** Timestamp (ms) of the last cron boundary that has already been fired. */
+  lastRun: number;
+}
+
+export type ShutdownCallback = () => void;
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+interface QueueState {
+  name: string;
+  pending: Task[];
+  dlq: Task[];
+  processing: Set<string>;
+  concurrency: number;
+  middleware: Middleware[];
+}
+
+interface ShutdownState {
+  waitSet: Set<string>;
+  completed: number;
+  cancelled: number;
+  startTime: number;
+  resolve: (summary: ShutdownSummary) => void;
+  timer: ReturnType<typeof setTimeout> | null;
+}
+
+const DEFAULT_QUEUE = 'default';
+const DEFAULT_PRIORITY = 5;
+const DEFAULT_MAX_RETRIES = 3;
+const DEFAULT_BACKOFF_MS = 1000;
+const DEFAULT_SHUTDOWN_TIMEOUT = 30000;
+
+export class TaskQueue {
+  private queues = new Map<string, QueueState>();
+  private allTasks = new Map<string, Task>();
+  private progress = new Map<string, ProgressInfo>();
+  private progressCallbacks = new Map<string, Set<ProgressCallback>>();
+  private schedules = new Map<string, Schedule>();
+  private shutdownCallbacks: ShutdownCallback[] = [];
+  private seqCounter = 0;
+
+  private shuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private shutdownState: ShutdownState | null = null;
+
+  // ---------------------------------------------------------------------------
+  // Phase 1 / 2: enqueue, dequeue, size, named queues
+  // ---------------------------------------------------------------------------
+
+  enqueue(queueName: string, payload?: unknown, options: EnqueueOptions = {}): Task {
+    let qName = queueName;
+    let load = payload;
+    let opts = options;
+
+    // Backwards-compatible single-argument form: enqueue(payload[, options]).
+    if (typeof qName !== 'string') {
+      opts = (load as EnqueueOptions) || {};
+      load = qName;
+      qName = DEFAULT_QUEUE;
+    }
+
+    if (this.shuttingDown) {
+      throw new Error('TaskQueue is shutting down; cannot enqueue new tasks');
+    }
+
+    const priority = opts.priority ?? DEFAULT_PRIORITY;
+    if (priority < 1 || priority > 10) {
+      throw new Error(`priority must be between 1 and 10 (got ${priority})`);
+    }
+
+    const dependsOn = opts.dependsOn ?? [];
+    for (const depId of dependsOn) {
+      if (!this.allTasks.has(depId)) {
+        throw new Error(`cannot depend on non-existent task: ${depId}`);
+      }
+    }
+
+    const now = Date.now();
+    let availableAt = now;
+    if (typeof opts.delay === 'number') {
+      availableAt = now + opts.delay;
+    }
+    if (opts.runAt instanceof Date) {
+      availableAt = opts.runAt.getTime();
+    }
+
+    const task: Task = {
+      id: randomUUID(),
+      queueName: qName,
+      payload: load,
+      status: 'pending',
+      createdAt: new Date(now),
+      priority,
+      availableAt: new Date(availableAt),
+      attempts: 0,
+      maxRetries: opts.maxRetries ?? DEFAULT_MAX_RETRIES,
+      backoffMs: opts.backoffMs ?? DEFAULT_BACKOFF_MS,
+      dependsOn: [...dependsOn],
+      failCount: 0,
+      seq: this.seqCounter++,
+    };
+
+    this.allTasks.set(task.id, task);
+    if (this.hasCycle(task.id)) {
+      this.allTasks.delete(task.id);
+      throw new Error('circular dependency detected');
+    }
+
+    const queue = this.getOrCreateQueue(qName);
+    queue.pending.push(task);
+    return task;
+  }
+
+  dequeue(queueName: string = DEFAULT_QUEUE): Task | null {
+    const queue = this.queues.get(queueName);
+    if (!queue) {
+      return null;
+    }
+    if (queue.processing.size >= queue.concurrency) {
+      return null;
+    }
+
+    const now = Date.now();
+    let best: Task | null = null;
+    for (const task of queue.pending) {
+      if (task.availableAt.getTime() > now) {
+        continue;
+      }
+      if (!this.dependenciesSatisfied(task)) {
+        continue;
+      }
+      if (best === null || this.compareTasks(task, best) < 0) {
+        best = task;
+      }
+    }
+
+    if (!best) {
+      return null;
+    }
+
+    const idx = queue.pending.indexOf(best);
+    if (idx >= 0) {
+      queue.pending.splice(idx, 1);
+    }
+    best.status = 'processing';
+    best.attempts += 1;
+    queue.processing.add(best.id);
+    return best;
+  }
+
+  size(): number {
+    return this.queueSize(DEFAULT_QUEUE);
+  }
+
+  queueSize(queueName: string): number {
+    const queue = this.queues.get(queueName);
+    return queue ? queue.pending.length : 0;
+  }
+
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 5 / 6: complete, fail, retry with backoff, dead-letter queue
+  // ---------------------------------------------------------------------------
+
+  complete(taskId: string): void {
+    const task = this.allTasks.get(taskId);
+    if (!task || task.status !== 'processing') {
+      return;
+    }
+    task.status = 'completed';
+    const queue = this.queues.get(task.queueName);
+    if (queue) {
+      queue.processing.delete(taskId);
+    }
+    this.handleShutdownComplete(taskId);
+  }
+
+  fail(taskId: string, error?: unknown): void {
+    const task = this.allTasks.get(taskId);
+    if (!task || task.status !== 'processing') {
+      return;
+    }
+    const queue = this.queues.get(task.queueName);
+    if (queue) {
+      queue.processing.delete(taskId);
+    }
+
+    task.lastError = error;
+    task.failCount += 1;
+
+    if (task.attempts <= task.maxRetries) {
+      const delay = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.availableAt = new Date(Date.now() + delay);
+      task.status = 'pending';
+      if (queue) {
+        queue.pending.push(task);
+      }
+    } else {
+      task.status = 'failed';
+      if (queue) {
+        queue.dlq.push(task);
+      }
+    }
+  }
+
+  getDLQ(queueName: string): Task[] {
+    const queue = this.queues.get(queueName);
+    return queue ? [...queue.dlq] : [];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    const task = this.allTasks.get(taskId);
+    if (!task) {
+      return null;
+    }
+    const queue = this.queues.get(task.queueName);
+    if (!queue) {
+      return null;
+    }
+    const idx = queue.dlq.indexOf(task);
+    if (idx < 0) {
+      return null;
+    }
+    queue.dlq.splice(idx, 1);
+
+    task.attempts = 0;
+    task.status = 'pending';
+    task.availableAt = new Date(Date.now());
+    queue.pending.push(task);
+    return task;
+  }
+
+  clearDLQ(queueName: string): void {
+    const queue = this.queues.get(queueName);
+    if (queue) {
+      queue.dlq = [];
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 7: dependencies
+  // ---------------------------------------------------------------------------
+
+  getDependencies(taskId: string): DependencyInfo[] {
+    const task = this.allTasks.get(taskId);
+    if (!task) {
+      return [];
+    }
+    return task.dependsOn.map((id) => {
+      const dep = this.allTasks.get(id);
+      return { taskId: id, status: dep ? dep.status : 'unknown' };
+    });
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 8: concurrency control
+  // ---------------------------------------------------------------------------
+
+  setConcurrency(queueName: string, limit: number): void {
+    const queue = this.getOrCreateQueue(queueName);
+    queue.concurrency = limit > 0 ? limit : Infinity;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const queue = this.queues.get(queueName);
+    if (!queue) {
+      return { current: 0, max: Infinity };
+    }
+    return { current: queue.processing.size, max: queue.concurrency };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 9: progress and cancellation
+  // ---------------------------------------------------------------------------
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error(`progress percent must be between 0 and 100 (got ${percent})`);
+    }
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    this.progress.set(taskId, info);
+    const callbacks = this.progressCallbacks.get(taskId);
+    if (callbacks) {
+      for (const cb of callbacks) {
+        cb({ ...info });
+      }
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progress.get(taskId) ?? null;
+  }
+
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    let callbacks = this.progressCallbacks.get(taskId);
+    if (!callbacks) {
+      callbacks = new Set();
+      this.progressCallbacks.set(taskId, callbacks);
+    }
+    callbacks.add(callback);
+    return () => {
+      callbacks.delete(callback);
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.allTasks.get(taskId);
+    if (!task) {
+      return;
+    }
+    if (task.status !== 'pending' && task.status !== 'processing') {
+      return;
+    }
+    const queue = this.queues.get(task.queueName);
+    if (task.status === 'pending' && queue) {
+      const idx = queue.pending.indexOf(task);
+      if (idx >= 0) {
+        queue.pending.splice(idx, 1);
+      }
+    } else if (task.status === 'processing' && queue) {
+      queue.processing.delete(taskId);
+    }
+    task.status = 'cancelled';
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 10: recurring (cron) tasks
+  // ---------------------------------------------------------------------------
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {
+    const sched: Schedule = {
+      id: randomUUID(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+      lastRun: Date.now(),
+    };
+    this.schedules.set(sched.id, sched);
+    return sched;
+  }
+
+  unschedule(scheduleId: string): void {
+    const sched = this.schedules.get(scheduleId);
+    if (sched) {
+      sched.active = false;
+    }
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const active = [...this.schedules.values()].filter((s) => s.active);
+    if (queueName === undefined) {
+      return active;
+    }
+    return active.filter((s) => s.queueName === queueName);
+  }
+
+  tick(): void {
+    const now = Date.now();
+    for (const sched of this.schedules.values()) {
+      if (!sched.active) {
+        continue;
+      }
+      let next = computeNextRun(sched.cronExpression, sched.lastRun);
+      while (next <= now) {
+        this.enqueue(sched.queueName, sched.taskTemplate);
+        sched.lastRun = next;
+        next = computeNextRun(sched.cronExpression, sched.lastRun);
+      }
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 11: middleware pipeline
+  // ---------------------------------------------------------------------------
+
+  use(queueName: string, middleware: Middleware): void {
+    const queue = this.getOrCreateQueue(queueName);
+    queue.middleware.push(middleware);
+  }
+
+  async process(queueName: string, handler: TaskHandler): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) {
+      return;
+    }
+    const queue = this.queues.get(queueName);
+    const middleware = queue ? queue.middleware : [];
+
+    try {
+      const dispatch = async (index: number): Promise<void> => {
+        if (index < middleware.length) {
+          await middleware[index](task, () => dispatch(index + 1));
+        } else {
+          await handler(task);
+        }
+      };
+      await dispatch(0);
+      this.complete(task.id);
+    } catch (err) {
+      this.fail(task.id, err instanceof Error ? err.message : String(err));
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 12: graceful shutdown
+  // ---------------------------------------------------------------------------
+
+  onShutdown(callback: ShutdownCallback): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  shutdown(timeout: number = DEFAULT_SHUTDOWN_TIMEOUT): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) {
+      return this.shutdownPromise;
+    }
+    this.shuttingDown = true;
+    const startTime = Date.now();
+
+    for (const cb of this.shutdownCallbacks) {
+      cb();
+    }
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      const waitSet = new Set<string>();
+      for (const queue of this.queues.values()) {
+        for (const id of queue.processing) {
+          waitSet.add(id);
+        }
+      }
+
+      const state: ShutdownState = {
+        waitSet,
+        completed: 0,
+        cancelled: 0,
+        startTime,
+        resolve,
+        timer: null,
+      };
+      this.shutdownState = state;
+
+      if (waitSet.size === 0) {
+        this.finalizeShutdown();
+        return;
+      }
+
+      state.timer = setTimeout(() => {
+        const current = this.shutdownState;
+        if (!current) {
+          return;
+        }
+        for (const id of [...current.waitSet]) {
+          const task = this.allTasks.get(id);
+          if (task && task.status === 'processing') {
+            task.status = 'cancelled';
+            const queue = this.queues.get(task.queueName);
+            if (queue) {
+              queue.processing.delete(id);
+            }
+          }
+          current.cancelled += 1;
+          current.waitSet.delete(id);
+        }
+        this.finalizeShutdown();
+      }, timeout);
+    });
+
+    return this.shutdownPromise;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Internal helpers
+  // ---------------------------------------------------------------------------
+
+  private getOrCreateQueue(name: string): QueueState {
+    let queue = this.queues.get(name);
+    if (!queue) {
+      queue = {
+        name,
+        pending: [],
+        dlq: [],
+        processing: new Set(),
+        concurrency: Infinity,
+        middleware: [],
+      };
+      this.queues.set(name, queue);
+    }
+    return queue;
+  }
+
+  /** Sort key: priority (1 highest) -> availability time -> FIFO sequence. */
+  private compareTasks(a: Task, b: Task): number {
+    if (a.priority !== b.priority) {
+      return a.priority - b.priority;
+    }
+    const aAvail = a.availableAt.getTime();
+    const bAvail = b.availableAt.getTime();
+    if (aAvail !== bAvail) {
+      return aAvail - bAvail;
+    }
+    return a.seq - b.seq;
+  }
+
+  private dependenciesSatisfied(task: Task): boolean {
+    return task.dependsOn.every((id) => {
+      const dep = this.allTasks.get(id);
+      return dep !== undefined && dep.status === 'completed';
+    });
+  }
+
+  private hasCycle(startId: string): boolean {
+    const visiting = new Set<string>();
+    const visited = new Set<string>();
+
+    const dfs = (id: string): boolean => {
+      const task = this.allTasks.get(id);
+      if (!task) {
+        return false;
+      }
+      if (visiting.has(id)) {
+        return true;
+      }
+      if (visited.has(id)) {
+        return false;
+      }
+      visiting.add(id);
+      for (const dep of task.dependsOn) {
+        if (dfs(dep)) {
+          return true;
+        }
+      }
+      visiting.delete(id);
+      visited.add(id);
+      return false;
+    };
+
+    return dfs(startId);
+  }
+
+  private handleShutdownComplete(taskId: string): void {
+    const state = this.shutdownState;
+    if (!state || !state.waitSet.has(taskId)) {
+      return;
+    }
+    state.completed += 1;
+    state.waitSet.delete(taskId);
+    if (state.waitSet.size === 0) {
+      this.finalizeShutdown();
+    }
+  }
+
+  private finalizeShutdown(): void {
+    const state = this.shutdownState;
+    if (!state) {
+      return;
+    }
+    if (state.timer) {
+      clearTimeout(state.timer);
+      state.timer = null;
+    }
+    this.shutdownState = null;
+    state.resolve({
+      completed: state.completed,
+      cancelled: state.cancelled,
+      elapsed: Date.now() - state.startTime,
+    });
+  }
+}
+
+// -----------------------------------------------------------------------------
+// Cron support (Phase 10)
+// -----------------------------------------------------------------------------
+
+/**
+ * Compute the next timestamp (ms) strictly greater than `after` that matches the
+ * given cron expression. Supports the standard 5-field format using UTC fields;
+ * the benchmark exercises the every-N-minutes, hourly, and daily subset.
+ */
+function computeNextRun(cronExpression: string, after: number): number {
+  const fields = cronExpression.trim().split(/\s+/);
+  const [minField, hourField, domField, monthField, dowField] = [
+    fields[0] ?? '*',
+    fields[1] ?? '*',
+    fields[2] ?? '*',
+    fields[3] ?? '*',
+    fields[4] ?? '*',
+  ];
+
+  const MINUTE = 60000;
+  // Start at the first whole-minute boundary strictly after `after`.
+  let t = Math.floor(after / MINUTE) * MINUTE + MINUTE;
+  const cap = t + 367 * 24 * 60 * MINUTE;
+
+  for (; t <= cap; t += MINUTE) {
+    const date = new Date(t);
+    if (
+      matchCronField(date.getUTCMinutes(), minField) &&
+      matchCronField(date.getUTCHours(), hourField) &&
+      matchCronField(date.getUTCDate(), domField) &&
+      matchCronField(date.getUTCMonth() + 1, monthField) &&
+      matchCronField(date.getUTCDay(), dowField)
+    ) {
+      return t;
+    }
+  }
+  return cap;
+}
+
+function matchCronField(value: number, field: string): boolean {
+  if (field === '*') {
+    return true;
+  }
+  if (field.startsWith('*/')) {
+    const step = parseInt(field.slice(2), 10);
+    return Number.isFinite(step) && step > 0 && value % step === 0;
+  }
+  return field.split(',').some((part) => {
+    if (part.includes('-')) {
+      const [lo, hi] = part.split('-').map((n) => parseInt(n, 10));
+      return value >= lo && value <= hi;
+    }
+    return parseInt(part, 10) === value;
+  });
+}
