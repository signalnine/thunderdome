+/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ *
+ * Grid cells:
+ *   'S' — beam source (top row). Emits a beam straight down.
+ *   '^' — splitter. A beam arriving here is consumed and re-emitted as two
+ *         diagonal beams: one down-left and one down-right.
+ *   '.' — empty cell; beams pass through unchanged.
+ *
+ * Every beam advances row+1 on every step, so a beam's column drift is fully
+ * described by a single column delta:
+ *   -1 → down-left, 0 → straight down, +1 → down-right.
+ *
+ * Because the row strictly increases each step, the graph of beam states
+ * (row, col, delta) is acyclic. That lets us memoize instead of enumerating
+ * the (exponentially many) individual paths.
+ */
+
+/** Column delta for a beam: -1 = down-left, 0 = straight down, +1 = down-right. */
+type Delta = -1 | 0 | 1;
+
+/** Locate every source cell. Sources are expected on the top row, but we scan
+ *  the whole grid so the simulator is robust to unusual inputs. */
+function findSources(grid: string[][]): Array<readonly [number, number]> {
+  const sources: Array<readonly [number, number]> = [];
+  for (let r = 0; r < grid.length; r++) {
+    const row = grid[r];
+    if (row === undefined) continue;
+    for (let c = 0; c < row.length; c++) {
+      if (row[c] === 'S') sources.push([r, c]);
+    }
+  }
+  return sources;
+}
+
+/**
+ * Count the number of distinct grid cells visited by any beam.
+ *
+ * A cell is counted once no matter how many beams traverse it. The source cell
+ * and any splitter struck by a beam both count as visited. Cells outside the
+ * grid (where beams are absorbed) are not counted.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+  if (cols === 0) return 0;
+
+  const visitedCells = new Set<number>(); // key: r * cols + c
+  const seenStates = new Set<number>(); // key: (r * cols + c) * 3 + (delta + 1)
+
+  // DFS over beam states. Deduping on (row, col, delta) keeps this linear in
+  // the grid size even when the number of beams is exponential, because the
+  // downstream trajectory of a state is fully determined by that state.
+  const stack: Array<readonly [number, number, Delta]> = [];
+  for (const [r, c] of findSources(grid)) stack.push([r, c, 0]);
+
+  while (stack.length > 0) {
+    const item = stack.pop();
+    if (item === undefined) break;
+    const [r, c, delta] = item;
+
+    if (r < 0 || r >= rows || c < 0 || c >= cols) continue; // absorbed
+
+    const cellKey = r * cols + c;
+    const stateKey = cellKey * 3 + (delta + 1);
+    if (seenStates.has(stateKey)) continue;
+    seenStates.add(stateKey);
+    visitedCells.add(cellKey);
+
+    if (grid[r][c] === '^') {
+      stack.push([r + 1, c - 1, -1]); // down-left
+      stack.push([r + 1, c + 1, 1]); // down-right
+    } else {
+      stack.push([r + 1, c + delta, delta]); // continue in current direction
+    }
+  }
+
+  return visitedCells.size;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths through the grid.
+ *
+ * Each split at a '^' produces two independent paths. A path completes when its
+ * beam leaves the grid through any edge (such absorbed beams still count as
+ * completed paths). With K splitters along a beam's route the count can reach
+ * 2^K, so the result is returned as a bigint.
+ *
+ * The count is computed with memoized recursion over (row, col, delta) states,
+ * giving O(rows * cols) work regardless of how many paths exist.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+  if (cols === 0) return 0n;
+
+  // memo[(r * cols + c) * 3 + (delta + 1)] = number of exit paths from a beam
+  // located at the in-bounds cell (r, c) travelling with the given delta.
+  const memo: Array<bigint | undefined> = new Array(rows * cols * 3);
+
+  // Paths produced by a beam that has just moved to (r, c) with the given
+  // delta. If (r, c) is outside the grid the beam has exited: one path.
+  const step = (r: number, c: number, delta: Delta): bigint => {
+    if (r < 0 || r >= rows || c < 0 || c >= cols) return 1n;
+    return fromCell(r, c, delta);
+  };
+
+  // Paths produced by a beam sitting on the in-bounds cell (r, c).
+  const fromCell = (r: number, c: number, delta: Delta): bigint => {
+    const key = (r * cols + c) * 3 + (delta + 1);
+    const cached = memo[key];
+    if (cached !== undefined) return cached;
+
+    let result: bigint;
+    if (grid[r][c] === '^') {
+      // The splitter consumes the beam and emits two diagonals, regardless of
+      // the incoming direction.
+      result = step(r + 1, c - 1, -1) + step(r + 1, c + 1, 1);
+    } else {
+      result = step(r + 1, c + delta, delta);
+    }
+
+    memo[key] = result;
+    return result;
+  };
+
+  let total = 0n;
+  for (const [r, c] of findSources(grid)) total += fromCell(r, c, 0);
+  return total;
+}
