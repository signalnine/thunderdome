+
+  it('handles multiple sources on the top row', () => {
+    const grid = parse(`
+      S . S
+      . ^ .
+      . . .
+    `);
+    const { cells, paths } = brute(grid);
+    expect(countBeamCells(grid)).toBe(cells);
+    expect(countBeamPaths(grid)).toBe(paths);
+  });
+});
