+      . . . S . . .
+      . . . ^ . . .
+      . . ^ . ^ . .
+      . ^ . ^ . ^ .
+    `);
+    const { cells, paths } = brute(grid);
+    expect(countBeamCells(grid)).toBe(cells);
+    expect(countBeamPaths(grid)).toBe(paths);
+    expect(paths).toBeGreaterThan(2n);
+  });
+
+  it('counts merged cells only once but merged paths separately', () => {
+    // Two branches that land on the same cell: cell counted once, paths add up.
+    const grid = parse(`
+      . S .
+      . ^ .
+      ^ . ^
+    `);
+    const { cells, paths } = brute(grid);
+    expect(countBeamCells(grid)).toBe(cells);
+    expect(countBeamPaths(grid)).toBe(paths);
