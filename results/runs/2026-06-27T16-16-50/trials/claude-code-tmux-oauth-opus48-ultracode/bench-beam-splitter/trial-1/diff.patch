+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index';
+
+/** Parse a compact text grid ("S . ^" rows separated by newlines) into string[][]. */
+function parse(text: string): string[][] {
+  return text
+    .trim()
+    .split('\n')
+    .map((line) => line.trim().split(/\s+/));
+}
+
+/**
+ * Independent brute-force oracle: simulate every beam individually with no
+ * memoization. Each beam that leaves the grid is one completed path; the set of
+ * in-bounds cells touched is the visited-cell set. Only feasible for small grids
+ * with few splitters (cost is proportional to the number of paths, ~2^splitters).
+ */
+function brute(grid: string[][]): { cells: number; paths: bigint } {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  const cellSet = new Set<number>();
+  let paths = 0n;
+
+  const stack: Array<[number, number, number]> = [];
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      if (grid[r][c] === 'S') stack.push([r, c, 0]);
+    }
+  }
+
+  while (stack.length > 0) {
+    const [r, c, d] = stack.pop() as [number, number, number];
+    if (r < 0 || r >= rows || c < 0 || c >= cols) {
+      paths += 1n; // beam exited the grid -> one completed path
+      continue;
+    }
+    cellSet.add(r * cols + c);
+    if (grid[r][c] === '^') {
+      stack.push([r + 1, c - 1, -1]);
+      stack.push([r + 1, c + 1, 1]);
+    } else {
+      stack.push([r + 1, c + d, d]);
+    }
+  }
+
+  return { cells: cellSet.size, paths };
+}
+
+/** Deterministic PRNG (mulberry32) so any failing random case is reproducible. */
+function makeRng(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+function randomGrid(
+  rows: number,
+  cols: number,
+  splitterProb: number,
+  rng: () => number,
+): string[][] {
+  const grid: string[][] = [];
+  for (let r = 0; r < rows; r++) {
+    const row: string[] = [];
+    for (let c = 0; c < cols; c++) row.push(rng() < splitterProb ? '^' : '.');
+    grid.push(row);
+  }
+  // Exactly one source on the top row; overwrite whatever was generated there.
+  const sourceCol = Math.floor(rng() * cols);
+  grid[0][sourceCol] = 'S';
+  return grid;
+}
