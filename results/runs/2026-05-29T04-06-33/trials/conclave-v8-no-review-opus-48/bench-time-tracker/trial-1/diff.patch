+++ b/src/tracker.ts
@@ -0,0 +1,138 @@
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+import type {
+  DateRange,
+  Summary,
+  TimeEntry,
+  TimeTrackerOptions,
+} from './types.js';
+
+/**
+ * Tracks time spent on named tasks, persisting entries to a JSON file.
+ */
+export class TimeTracker {
+  private readonly filePath: string;
+  private readonly now: () => number;
+  private entries: TimeEntry[];
+
+  /**
+   * Create a tracker. If the persistence file already exists, its entries are loaded.
+   */
+  constructor(options: TimeTrackerOptions) {
+    this.filePath = options.filePath;
+    this.now = options.now ?? Date.now;
+    this.entries = this.load();
+  }
+
+  /**
+   * Start a new timer for the given task name. If a timer is already running,
+   * it is stopped automatically first.
+   *
+   * @throws if the name is empty or whitespace-only.
+   * @returns the newly created (running) entry.
+   */
+  start(name: string): TimeEntry {
+    if (name.trim().length === 0) {
+      throw new Error('Cannot start a timer with an empty name.');
+    }
+    const running = this.runningEntry();
+    if (running) {
+      running.stop = this.now();
+    }
+    const entry: TimeEntry = { name, start: this.now() };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  /**
+   * Stop the currently running timer.
+   *
+   * @throws if no timer is running.
+   * @returns the stopped entry.
+   */
+  stop(): TimeEntry {
+    const running = this.runningEntry();
+    if (!running) {
+      throw new Error('Cannot stop: no timer is currently running.');
+    }
+    running.stop = this.now();
+    this.save();
+    return running;
+  }
+
+  /**
+   * Retrieve recorded entries, optionally filtered by the start time falling
+   * within an (inclusive) date range.
+   */
+  getEntries(range?: DateRange): TimeEntry[] {
+    let result = this.entries;
+    if (range) {
+      const from = toMillis(range.from);
+      const to = toMillis(range.to);
+      result = result.filter((entry) => {
+        if (from !== undefined && entry.start < from) {
+          return false;
+        }
+        if (to !== undefined && entry.start > to) {
+          return false;
+        }
+        return true;
+      });
+    }
+    // Return copies so callers cannot mutate internal state.
+    return result.map((entry) => ({ ...entry }));
+  }
+
+  /**
+   * Summarize total time per task name, in milliseconds. Running tasks use the
+   * current time as their end. Entries sharing a name are summed together.
+   */
+  summary(): Summary {
+    const totals: Summary = {};
+    for (const entry of this.entries) {
+      const end = entry.stop ?? this.now();
+      const duration = Math.max(0, end - entry.start);
+      totals[entry.name] = (totals[entry.name] ?? 0) + duration;
+    }
+    return totals;
+  }
+
+  /** Return the currently running entry, if any. */
+  private runningEntry(): TimeEntry | undefined {
+    return this.entries.find((entry) => entry.stop === undefined);
+  }
+
+  /** Load entries from the persistence file, returning [] if it does not exist. */
+  private load(): TimeEntry[] {
+    if (!existsSync(this.filePath)) {
+      return [];
+    }
+    const raw = readFileSync(this.filePath, 'utf8');
+    if (raw.trim().length === 0) {
+      return [];
+    }
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) {
+      throw new Error(`Persistence file ${this.filePath} does not contain a JSON array.`);
+    }
+    return parsed as TimeEntry[];
+  }
+
+  /** Persist current entries to the file, creating parent directories as needed. */
+  private save(): void {
+    const dir = dirname(this.filePath);
+    if (dir && !existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+    writeFileSync(this.filePath, JSON.stringify(this.entries, null, 2), 'utf8');
+  }
+}
+
+/** Normalize a Date | number | undefined into ms since epoch. */
+function toMillis(value: number | Date | undefined): number | undefined {
+  if (value === undefined) {
+    return undefined;
+  }
+  return value instanceof Date ? value.getTime() : value;
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..2776a63
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,28 @@
+/** A single recorded time entry. */
+export interface TimeEntry {
+  /** The task name. */
+  name: string;
+  /** When the timer started, as milliseconds since the Unix epoch. */
+  start: number;
+  /** When the timer stopped, as milliseconds since the Unix epoch, or undefined if still running. */
+  stop?: number;
+}
+
+/** A date range filter. Both bounds are inclusive and optional. */
+export interface DateRange {
+  /** Lower bound (ms since epoch or a Date). Entries starting before this are excluded. */
+  from?: number | Date;
+  /** Upper bound (ms since epoch or a Date). Entries starting after this are excluded. */
+  to?: number | Date;
+}
+
+/** Options for constructing a {@link TimeTracker}. */
+export interface TimeTrackerOptions {
+  /** Path to the JSON file used for persistence. */
+  filePath: string;
+  /** Clock function returning the current time in ms since epoch. Defaults to Date.now. Useful for testing. */
+  now?: () => number;
+}
+
+/** A summary mapping each task name to its total tracked time in milliseconds. */
+export type Summary = Record<string, number>;
