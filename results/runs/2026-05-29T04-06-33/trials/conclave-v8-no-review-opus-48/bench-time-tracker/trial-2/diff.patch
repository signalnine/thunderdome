 });\n});\n\ndescribe('querying', () => {\n  it('returns all entries', () => {\n    const c = clock();\n    const tt = new TimeTracker({ filePath: join(dir, 'data.json'), now: c.now });\n    tt.start('a');\n    c.advance(10);\n    tt.start('b');\n    c.advance(10);\n    tt.stop();\n    expect(tt.getEntries()).toHaveLength(2);\n  });\n\n  it('filters entries by date range (inclusive)', () => {\n    const c = clock(0);\n    const tt = new TimeTracker({ filePath: join(dir, 'data.json'), now: c.now });\n    c.set(100);\n    tt.start('a'); // startedAt 100\n    c.set(200);\n    tt.start('b'); // startedAt 200\n    c.set(300);\n    tt.start('c'); // startedAt 300\n\n    expect(tt.getEntries({ from: 150 }).map((e) => e.name)).toEqual(['b', 'c']);\n    expect(tt.getEntries({ to: 250 }).map((e) => e.name)).toEqual(['a', 'b']);\n    expect(tt.getEntries({ from: 100, to: 300 }).map((e) => e.name)).toEqual([\n      'a',\n      'b',\n      'c',\n    ]);\n    expect(tt.getEntries({ from: 200, to: 200 }).map((e) => e.name)).toEqual(['b']);\n  });\n\n  it('accepts Date objects for range bounds', () => {\n    const c = clock(0);\n    const tt = new TimeTracker({ filePath: join(dir, 'data.json'), now: c.now });\n    c.set(1000);\n    tt.start('a');\n    c.set(5000);\n    tt.start('b');\n    const result = tt.getEntries({ from: new Date(2000), to: new Date(6000) });\n    expect(result.map((e) => e.name)).toEqual(['b']);\n  });\n\n  it('does not allow mutating internal state via returned entries', () => {\n    const tt = new TimeTracker({ filePath: join(dir, 'data.json') });\n    tt.start('a');\n    const entries = tt.getEntries();\n    entries[0].name = 'mutated';\n    expect(tt.getEntries()[0].name).toBe('a');\n  });\n});\n\ndescribe('summary', () => {\n  it('sums durations per task name', () => {\n    const c = clock(0);\n    const tt = new TimeTracker({ filePath: join(dir, 'data.json'), now: c.now });\n    c.set(0);\n    tt.start('a');\n    c.set(100);\n    tt.stop();\n    c.set(20