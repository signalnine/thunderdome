+++ b/src/storage.ts
@@ -0,0 +1,72 @@
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+import type { TimeEntry } from './types.js';
+
+/**
+ * Load time entries from a JSON file.
+ *
+ * Returns an empty array if the file does not exist yet.
+ * Throws if the file exists but contains malformed data.
+ */
+export function loadEntries(filePath: string): TimeEntry[] {
+  if (!existsSync(filePath)) {
+    return [];
+  }
+
+  const raw = readFileSync(filePath, 'utf8').trim();
+  if (raw === '') {
+    return [];
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch (err) {
+    throw new Error(
+      `Failed to parse time tracker data at ${filePath}: ${(err as Error).message}`,
+    );
+  }
+
+  if (!Array.isArray(parsed)) {
+    throw new Error(`Time tracker data at ${filePath} is not an array`);
+  }
+
+  return parsed.map((item) => validateEntry(item, filePath));
+}
+
+/**
+ * Persist time entries to a JSON file, creating parent directories as needed.
+ */
+export function saveEntries(filePath: string, entries: TimeEntry[]): void {
+  const dir = dirname(filePath);
+  if (dir !== '' && !existsSync(dir)) {
+    mkdirSync(dir, { recursive: true });
+  }
+  writeFileSync(filePath, JSON.stringify(entries, null, 2), 'utf8');
+}
+
+function validateEntry(item: unknown, filePath: string): TimeEntry {
+  if (typeof item !== 'object' || item === null) {
+    throw new Error(`Invalid entry in time tracker data at ${filePath}`);
+  }
+
+  const record = item as Record<string, unknown>;
+  if (typeof record.name !== 'string') {
+    throw new Error(`Entry with non-string name in time tracker data at ${filePath}`);
+  }
+  if (typeof record.startedAt !== 'number') {
+    throw new Error(`Entry with invalid startedAt in time tracker data at ${filePath}`);
+  }
+  if (record.stoppedAt !== undefined && typeof record.stoppedAt !== 'number') {
+    throw new Error(`Entry with invalid stoppedAt in time tracker data at ${filePath}`);
+  }
+
+  const entry: TimeEntry = {
+    name: record.name,
+    startedAt: record.startedAt,
+  };
+  if (typeof record.stoppedAt === 'number') {
+    entry.stoppedAt = record.stoppedAt;
+  }
+  return entry;
+}
diff --git a/src/tracker.ts b/src/tracker.ts
new file mode 100644
index 0000000..16f7a8f
--- /dev/null
+++ b/src/tracker.ts
@@ -0,0 +1,111 @@
+import { loadEntries, saveEntries } from './storage.js';
+import type {
+  DateRange,
+  Summary,
+  TimeEntry,
+  TimeTrackerOptions,
+} from './types.js';
+
+function toMillis(value: Date | number): number {
+  return value instanceof Date ? value.getTime() : value;
+}
+
+/**
+ * Tracks how time is spent across named tasks, persisting entries to a JSON
+ * file so they survive between sessions.
+ */
+export class TimeTracker {
+  private readonly filePath: string;
+  private readonly now: () => number;
+  private entries: TimeEntry[];
+
+  constructor(options: TimeTrackerOptions) {
+    this.filePath = options.filePath;
+    this.now = options.now ?? Date.now;
+    this.entries = loadEntries(this.filePath);
+  }
+
+  /**
+   * Start a timer for the given task name.
+   *
+   * If another timer is already running, it is stopped first. The new entry is
+   * persisted before returning.
+   *
+   * @throws if the name is empty or only whitespace.
+   */
+  start(name: string): TimeEntry {
+    if (name.trim() === '') {
+      throw new Error('Cannot start a timer with an empty name');
+    }
+
+    const running = this.getRunning();
+    if (running) {
+      running.stoppedAt = this.now();
+    }
+
+    const entry: TimeEntry = { name, startedAt: this.now() };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  /**
+   * Stop the currently running timer.
+   *
+   * @throws if no timer is running.
+   * @returns the entry that was stopped.
+   */
+  stop(): TimeEntry {
+    const running = this.getRunning();
+    if (!running) {
+      throw new Error('No timer is currently running');
+    }
+    running.stoppedAt = this.now();
+    this.save();
+    return running;
+  }
+
+  /** Return the currently running entry, if any. */
+  getRunning(): TimeEntry | undefined {
+    return this.entries.find((entry) => entry.stoppedAt === undefined);
+  }
+
+  /**
+   * Return entries, optionally filtered to those that overlap a date range.
+   *
+   * An entry matches the range if its start time is at or after `from` (when
+   * provided) and at or before `to` (when provided). Bounds are inclusive.
+   * Returns a shallow copy so callers cannot mutate internal state.
+   */
+  getEntries(range?: DateRange): TimeEntry[] {
+    let result = this.entries.map((entry) => ({ ...entry }));
+
+    if (range?.from !== undefined) {
+      const from = toMillis(range.from);
+      result = result.filter((entry) => entry.startedAt >= from);
+    }
+    if (range?.to !== undefined) {
+      const to = toMillis(range.to);
+      result = result.filter((entry) => entry.startedAt <= to);
+    }
+    return result;
+  }
+
+  /**
+   * Return total milliseconds spent per task name, summing entries that share a
+   * name. Running tasks count up to the current time.
+   */
+  getSummary(): Summary {
+    const summary: Summary = {};
+    for (const entry of this.entries) {
+      const end = entry.stoppedAt ?? this.now();
+      const duration = Math.max(0, end - entry.startedAt);
+      summary[entry.name] = (summary[entry.name] ?? 0) + duration;
+    }
+    return summary;
+  }
+
+  private save(): void {
+    saveEntries(this.filePath, this.entries);
+  }
+}
