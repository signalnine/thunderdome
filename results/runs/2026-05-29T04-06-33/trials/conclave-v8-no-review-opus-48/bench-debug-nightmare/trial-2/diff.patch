 quantity: 3, unitPrice: 29.99 },\n        { productId: 'B', quantity: 1, unitPrice: 49.99 },\n      ],\n      15,\n      0.1\n    );\n    // subtotal = 3*29.99 + 49.99 = 139.96\n    // discount = 139.96 * 0.15 = 20.994\n    // after discount = 118.966\n    // tax = 118.966 * 0.1 = 11.8966\n    // total = 130.8626 -> rounded to 130.86\n    expect(result.total).toBe(130.86);\n  });\n\n  it('rounds correctly for penny-edge amounts', () => {\n    // This specifically tests that we don't double-round\n    const result = calculateOrderTotal(\n      [{ productId: 'A', quantity: 1, unitPrice: 33.33 }],\n      5,\n      0.07\n    );\n    // subtotal = 33.33\n    // discount = 33.33 * 0.05 = 1.6665\n    // after discount = 31.6635\n    // tax = 31.6635 * 0.07 = 2.21644...\n    // total = 33.87994... -> 33.88\n    expect(result.total).toBe(33.88);\n  });\n});\n\ndescribe('BillingService', () => {\n  let bus: EventBus;\n  let notifications: NotificationService;\n  let billing: BillingService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    notifications = new NotificationService();\n    billing = new BillingService(bus, notifications);\n    billing.registerHandlers();\n  });\n\n  it('charges payment and records it', async () => {\n    const record = await billing.chargePayment(\n      'O1',\n      [{ productId: 'A', quantity: 1, unitPrice: 100 }],\n      0,\n      0.1,\n      'card'\n    );\n    expect(record.amount).toBe(110);\n    expect(record.status).toBe('charged');\n    expect(record.method).toBe('card');\n  });\n\n  it('sends confirmation notification on charge', async () => {\n    await billing.chargePayment(\n      'O1',\n      [{ productId: 'A', quantity: 1, unitPrice: 100 }],\n      0,\n      0.1,\n      'card'\n    );\n    const sent = notifications.getSentNotifications();\n    expect(sent).toHaveLength(1);\n    expect(sent[0].type).toBe('confirmation');\n    expect(sent[0].message).toContain('O1');\n  });\n\n  it('issues refund and updates payment status', async () => {\n    await billing.chargePayment(\n      'O1',\n      [{ productId: 'A', quantity: 1, unitPrice: 50 }],\n      0,\n      0,\n      'card'\n    );\n    const refund = await billing.issueRefund('O1', 50);\n    expect(refund?.status).toBe('refunded');\n  });\n\n  it('sends refund notification', async () => {\n    await billing.chargePayment(\n      'O1',\n      [{ productId: 'A', quantity: 1, unitPrice: 50 }],\n      0,\n      0,\n      'card'\n    );\n    await billing.issueRefund('O1', 50);\n    const sent = notifications.getSentNotifications();\n    const refundNotice = sent.find((n) => n.type === 'refund');\n    expect(refundNotice).toBeDefined();\n    expect(refundNotice!.message).toContain('50.00');\n  });\n});\n\n===== tests/events.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/events/bus.js';\n\ndescribe('EventBus', () => {\n  let bus: EventBus;\n\n  beforeEach(() => {\n    bus = new EventBus();\n  });\n\n  it('emits events to registered handlers', async () => {\n    const received: unknown[] = [];\n    bus.on('test', (data) => { received.push(data); });\n    await bus.emit('test', { value: 1 });\n    expect(received).toEqual([{ value: 1 }]);\n  });\n\n  it('supports multiple handlers for same event', async () => {\n    let count = 0;\n    bus.on('test', () => { count++; });\n    bus.on('test', () => { count++; });\n    await bus.emit('test', {});\n    expect(count).toBe(2);\n  });\n\n  it('does not fire handlers for different events', async () => {\n    let called = false;\n    bus.on('other', () => { called = true; });\n    await bus.emit('test', {});\n    expect(called).toBe(false);\n  });\n\n  it('removes handlers with off()', async () => {\n    let count = 0;\n    const handler = () => { count++; };\n    bus.on('test', handler);\n    bus.off('test', handler);\n    await bus.emit('test', {});\n    expect(count).toBe(0);\n  });\n\n  it('clears all handlers', async () => {\n    let count = 0;\n    bus.on('a', () => { count++; });\n    bus.on('b', () => { count++; });\n    bus.clear();\n    await bus.emit('a', {});\n    await bus.emit('b', {});\n    expect(count).toBe(0);\n  });\n});\n\n===== tests/inventory.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/events/bus.js';\nimport { InventoryRepository } from '../src/inventory/repository.js';\nimport { InventoryService } from '../src/inventory/service.js';\nimport { ORDER_EVENTS } from '../src/events/types.js';\n\ndescribe('InventoryService', () => {\n  let bus: EventBus;\n  let repo: InventoryRepository;\n  let service: InventoryService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    repo = new InventoryRepository();\n    service = new InventoryService(repo, bus);\n    service.registerHandlers();\n  });\n\n  it('reserves stock on order.created', async () => {\n    service.setStock('SKU-1', 10);\n    await bus.emit(ORDER_EVENTS.CREATED, {\n      orderId: 'O1',\n      items: [{ productId: 'SKU-1', quantity: 3, unitPrice: 10 }],\n      customerId: 'C1',\n      timestamp: Date.now(),\n    });\n    const stock = service.getStock('SKU-1');\n    expect(stock?.available).toBe(7);\n    expect(stock?.reserved).toBe(3);\n  });\n\n  it('throws when stock is insufficient', async () => {\n    service.setStock('SKU-1', 2);\n    await expect(\n      bus.emit(ORDER_EVENTS.CREATED, {\n        orderId: 'O1',\n        items: [{ productId: 'SKU-1', quantity: 5, unitPrice: 10 }],\n        customerId: 'C1',\n        timestamp: Date.now(),\n      })\n    ).rejects.toThrow('Insufficient stock');\n  });\n\n  it('rolls back partial reservations on failure', async () => {\n    service.setStock('SKU-1', 10);\n    service.setStock('SKU-2', 1);\n    try {\n      await bus.emit(ORDER_EVENTS.CREATED, {\n        orderId: 'O1',\n        items: [\n          { productId: 'SKU-1', quantity: 3, unitPrice: 10 },\n          { productId: 'SKU-2', quantity: 5, unitPrice: 