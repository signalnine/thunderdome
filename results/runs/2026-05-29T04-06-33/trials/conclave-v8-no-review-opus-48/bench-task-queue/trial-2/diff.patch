diff --git a/tests/phase01-04.test.ts b/tests/phase01-04.test.ts
new file mode 100644
index 0000000..3186883
--- /dev/null
+++ b/tests/phase01-04.test.ts
@@ -0,0 +1,210 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+
+/** A controllable clock for deterministic delay/scheduling tests. */
+function makeClock(start = 1_000_000) {
+  let now = start;
+  return {
+    fn: () => now,
+    advance: (ms: number) => {
+      now += ms;
+    },
+    set: (v: number) => {
+      now = v;
+    },
+  };
+}
+
+describe('Phase 1: basic FIFO queue', () => {
+  let q: TaskQueue;
+  beforeEach(() => {
+    q = new TaskQueue();
+  });
+
+  it('add returns a task with unique id, status and createdAt', () => {
+    const a = q.add({ x: 1 });
+    const b = q.add({ x: 2 });
+    expect(a.id).toBeTypeOf('string');
+    expect(a.id).not.toEqual(b.id);
+    expect(a.status).toBe('pending');
+    expect(typeof a.createdAt).toBe('number');
+    expect(a.payload).toEqual({ x: 1 });
+  });
+
+  it('new tasks start pending', () => {
+    expect(q.add('p').status).toBe('pending');
+  });
+
+  it('next returns oldest pending task and sets it processing', () => {
+    const a = q.add('a');
+    q.add('b');
+    const got = q.next();
+    expect(got?.id).toBe(a.id);
+    expect(got?.status).toBe('processing');
+  });
+
+  it('next returns null when nothing available', () => {
+    expect(q.next()).toBeNull();
+    q.add('a');
+    q.next();
+    expect(q.next()).toBeNull();
+  });
+
+  it('size reports waiting count', () => {
+    expect(q.size()).toBe(0);
+    q.add('a');
+    q.add('b');
+    expect(q.size()).toBe(2);
+    q.next();
+    expect(q.size()).toBe(1);
+  });
+
+  it('preserves FIFO order for equal priority', () => {
+    q.add('a');
+    q.add('b');
+    q.add('c');
+    expect(q.next()?.payload).toBe('a');
+    expect(q.next()?.payload).toBe('b');
+    expect(q.next()?.payload).toBe('c');
+  });
+});
+
+describe('Phase 2: named queues', () => {
+  let q: TaskQueue;
+  beforeEach(() => {
+    q = new TaskQueue();
+  });
+
+  it('adds to a named queue; omitting uses default', () => {
+    q.add('d');
+    q.add('e', { queue: 'emails' });
+    expect(q.size()).toBe(1);
+    expect(q.size('emails')).toBe(1);
+  });
+
+  it('queues are independent', () => {
+    q.add('a', { queue: 'q1' });
+    q.add('b', { queue: 'q2' });
+    expect(q.next('q1')?.payload).toBe('a');
+    expect(q.size('q2')).toBe(1);
+  });
+
+  it('next pulls only from the given queue', () => {
+    q.add('a', { queue: 'q1' });
+    expect(q.next('q2')).toBeNull();
+    expect(q.next('q1')?.payload).toBe('a');
+  });
+
+  it('queue created implicitly and listQueues reports it', () => {
+    q.add('a', { queue: 'reports' });
+    expect(q.listQueues()).toContain('reports');
+  });
+
+  it('next on unknown queue returns null and does not create it', () => {
+    expect(q.next('ghost')).toBeNull();
+    expect(q.listQueues()).not.toContain('ghost');
+  });
+});
+
+describe('Phase 3: priority', () => {
+  let q: TaskQueue;
+  beforeEach(() => {
+    q = new TaskQueue();
+  });
+
+  it('defaults to priority 5 and exposes it', () => {
+    const t = q.add('a');
+    expect(t.priority).toBe(5);
+  });
+
+  it('higher priority (lower number) returned first', () => {
+    q.add('low', { priority: 8 });
+    q.add('high', { priority: 1 });
+    q.add('mid', { priority: 5 });
+    expect(q.next()?.payload).toBe('high');
+    expect(q.next()?.payload).toBe('mid');
+    expect(q.next()?.payload).toBe('low');
+  });
+
+  it('equal priority falls back to FIFO', () => {
+    q.add('first', { priority: 3 });
+    q.add('second', { priority: 3 });
+    expect(q.next()?.payload).toBe('first');
+    expect(q.next()?.payload).toBe('second');
+  });
+
+  it('rejects invalid priority', () => {
+    expect(() => q.add('a', { priority: 0 })).toThrow();
+    expect(() => q.add('a', { priority: 11 })).toThrow();
+    expect(() => q.add('a', { priority: 2.5 })).toThrow();
+  });
+
+  it('priority is per-queue', () => {
+    q.add('a-low', { queue: 'a', priority: 9 });
+    q.add('b-high', { queue: 'b', priority: 1 });
+    expect(q.next('a')?.payload).toBe('a-low');
+  });
+});
+
+describe('Phase 4: delayed / scheduled', () => {
+  it('delayed task is not returned until available', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    q.add('later', { delay: 1000 });
+    expect(q.next()).toBeNull();
+    clock.advance(999);
+    expect(q.next()).toBeNull();
+    clock.advance(1);
+    expect(q.next()?.payload).toBe('later');
+  });
+
+  it('runAt schedules at an absolute time', () => {
+    const clock = makeClock(5000);
+    const q = new TaskQueue({ clock: clock.fn });
+    q.add('at', { runAt: 6000 });
+    expect(q.next()).toBeNull();
+    clock.set(6000);
+    expect(q.next()?.payload).toBe('at');
+  });
+
+  it('exposes availableAt', () => {
+    const clock = makeClock(1000);
+    const q = new TaskQueue({ clock: clock.fn });
+    const t = q.add('a', { delay: 500 });
+    expect(t.availableAt).toBe(1500);
+    const immediate = q.add('b');
+    expect(immediate.availableAt).toBe(1000);
+  });
+
+  it('non-delayed preferred over delayed', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    q.add('delayed', { delay: 100, priority: 1 });
+    q.add('now', { priority: 9 });
+    clock.advance(200); // both available now
+    expect(q.next()?.payload).toBe('now');
+    expect(q.next()?.payload).toBe('delayed');
+  });
+
+  it('available delayed tasks ordered by availableAt, then priority, then FIFO', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    q.add('d200', { delay: 200, priority: 5 });
+    q.add('d100-lowprio', { delay: 100, priority: 9 });
+    q.add('d100-hiprio', { delay: 100, priority: 1 });
+    clock.advance(500); // all available
+    // earliest availableAt first (100ms group), within it priority asc
+    expect(q.next()?.payload).toBe('d100-hiprio');
+    expect(q.next()?.payload).toBe('d100-lowprio');
+    expect(q.next()?.payload).toBe('d200');
+  });
+
+  it('delays work per named queue', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    q.add('a', { queue: 'q1', delay: 100 });
+    expect(q.next('q1')).toBeNull();
+    clock.advance(100);
+    expect(q.next('q1')?.payload).toBe('a');
+  });
+});
diff --git a/tests/phase05-08.test.ts b/tests/phase05-08.test.ts
new file mode 100644
index 0000000..7bbb996
--- /dev/null
+++ b/tests/phase05-08.test.ts
@@ -0,0 +1,210 @@
+import { describe, it, expect } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+
+function makeClock(start = 1_000_000) {
+  let now = start;
+  return {
+    fn: () => now,
+    advance: (ms: number) => {
+      now += ms;
+    },
+  };
+}
+
+describe('Phase 5: retry with backoff', () => {
+  it('complete transitions a processing task', () => {
+    const q = new TaskQueue();
+    const t = q.add('a');
+    q.next();
+    q.complete(t.id, 'done');
+    expect(q.getTask(t.id)?.status).toBe('completed');
+    expect(q.getTask(t.id)?.result).toBe('done');
+  });
+
+  it('failed task with retries left is re-queued with exponential backoff', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    const t = q.add('a', { baseDelay: 1000, maxRetries: 3 });
+
+    // attempt 1
+    q.next();
+    q.fail(t.id, new Error('boom'));
+    expect(q.getTask(t.id)?.status).toBe('delayed');
+    // backoff = 1000 * 2^0 = 1000
+    expect(q.next()).toBeNull();
+    clock.advance(1000);
+
+    // attempt 2
+    expect(q.next()?.id).toBe(t.id);
+    q.fail(t.id);
+    expect(q.next()).toBeNull();
+    // backoff = 1000 * 2^1 = 2000
+    clock.advance(1999);
+    expect(q.next()).toBeNull();
+    clock.advance(1);
+    expect(q.next()?.id).toBe(t.id);
+  });
+
+  it('tracks attempts', () => {
+    const q = new TaskQueue({ clock: makeClock().fn });
+    const t = q.add('a');
+    q.next();
+    expect(q.getTask(t.id)?.attempts).toBe(1);
+  });
+
+  it('default maxRetries is 3 (4 total attempts) then failed', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    const t = q.add('a', { baseDelay: 10 });
+    for (let i = 0; i < 4; i++) {
+      const got = q.next();
+      expect(got?.id).toBe(t.id);
+      q.fail(t.id);
+      clock.advance(10 * Math.pow(2, i)); // make backoff available
+    }
+    expect(q.getTask(t.id)?.status).toBe('failed');
+    expect(q.getTask(t.id)?.attempts).toBe(4);
+    // no further retries
+    expect(q.next()).toBeNull();
+  });
+
+  it('configurable maxRetries per task', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    const t = q.add('a', { maxRetries: 1, baseDelay: 10 });
+    q.next();
+    q.fail(t.id); // retry 1 scheduled
+    expect(q.getTask(t.id)?.status).toBe('delayed');
+    clock.advance(20);
+    q.next();
+    q.fail(t.id); // exhausted
+    expect(q.getTask(t.id)?.status).toBe('failed');
+  });
+
+  it('configurable baseDelay per task', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    const t = q.add('a', { baseDelay: 5000 });
+    q.next();
+    q.fail(t.id);
+    clock.advance(4999);
+    expect(q.next()).toBeNull();
+    clock.advance(1);
+    expect(q.next()?.id).toBe(t.id);
+  });
+
+  it('retried task keeps queue and priority', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    const t = q.add('a', { queue: 'jobs', priority: 2, baseDelay: 10 });
+    q.next('jobs');
+    q.fail(t.id);
+    clock.advance(10);
+    const again = q.next('jobs');
+    expect(again?.queue).toBe('jobs');
+    expect(again?.priority).toBe(2);
+  });
+});
+
+describe('Phase 6: dead letter queue', () => {
+  function exhaust(q: TaskQueue, clock: ReturnType<typeof makeClock>, id: string) {
+    for (let i = 0; i < 4; i++) {
+      q.next();
+      q.fail(id, new Error(`fail ${i}`));
+      clock.advance(10 * Math.pow(2, i));
+    }
+  }
+
+  it('exhausted task is moved to its queue DLQ with error and failure count', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    const t = q.add('a', { baseDelay: 10 });
+    exhaust(q, clock, t.id);
+    const dlq = q.getDeadLetterQueue();
+    expect(dlq).toHaveLength(1);
+    expect(dlq[0].id).toBe(t.id);
+    expect(dlq[0].error?.message).toBe('fail 3');
+    expect(dlq[0].attempts).toBe(4);
+  });
+
+  it('retryDeadLetter moves task back for fresh retries', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    const t = q.add('a', { baseDelay: 10 });
+    exhaust(q, clock, t.id);
+    const back = q.retryDeadLetter(t.id);
+    expect(back.attempts).toBe(0);
+    expect(q.getDeadLetterQueue()).toHaveLength(0);
+    expect(q.next()?.id).toBe(t.id);
+  });
+
+  it('clearDeadLetterQueue empties it', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    const t = q.add('a', { baseDelay: 10 });
+    exhaust(q, clock, t.id);
+    q.clearDeadLetterQueue();
+    expect(q.getDeadLetterQueue()).toHaveLength(0);
+  });
+
+  it('DLQ is per-queue', () => {
+    const clock = makeClock();
+    const q = new TaskQueue({ clock: clock.fn });
+    const t = q.add('a', { queue: 'jobs', baseDelay: 10 });
+    for (let i = 0; i < 4; i++) {
+      q.next('jobs');
+      q.fail(t.id);
+      clock.advance(10 * Math.pow(2, i));
+    }
+    expect(q.getDeadLetterQueue('jobs')).toHaveLength(1);
+    expect(q.getDeadLetterQueue('default')).toHaveLength(0);
+  });
+});
+
+describe('Phase 8: concurrency control', () => {
+  it('default is unlimited', () => {
+    const q = new TaskQueue();
+    q.add('a');
+    q.add('b');
+    expect(q.next()).not.toBeNull();
+    expect(q.next()).not.toBeNull();
+    expect(q.getConcurrency().limit).toBeNull();
+  });
+
+  it('limit caps simultaneous processing; next returns null at limit', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('q', 1);
+    q.add('a', { queue: 'q' });
+    q.add('b', { queue: 'q' });
+    expect(q.next('q')).not.toBeNull();
+    expect(q.next('q')).toBeNull(); // at limit
+    expect(q.size('q')).toBe(1); // b still waiting
+  });
+
+  it('complete/fail frees a slot', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('q', 1);
+    const a = q.add('a', { queue: 'q' });
+    q.add('b', { queue: 'q' });
+    q.next('q');
+    expect(q.next('q')).toBeNull();
+    q.complete(a.id);
+    expect(q.next('q')?.payload).toBe('b');
+  });
+
+  it('setConcurrency / getConcurrency report limit and active', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('q', 2);
+    q.add('a', { queue: 'q' });
+    q.next('q');
+    expect(q.getConcurrency('q')).toEqual({ limit: 2, active: 1 });
+  });
+
+  it('respects priority ordering subject to the limit', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('q', 1);
+    q.add('low', { queue: 'q', priority: 9 });
+    q.add('high', { queue: 'q', priority: 1 });
+    expect(q.next('q')?.payload).toBe('high');
+  });
+});
diff --git a/tests/phase07-09.test.ts b/tests/phase07-09.test.ts
