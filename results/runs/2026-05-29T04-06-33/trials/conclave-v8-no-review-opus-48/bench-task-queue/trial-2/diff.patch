+/**
+ * Dependency graph helpers.
+ */
+
+/**
+ * Detects whether introducing `newId` with edges to `newDeps` would create a
+ * cycle, given the dependency edges of all existing tasks.
+ *
+ * `existing` maps a task id to the ids it depends on. The check performs a DFS
+ * from `newId` following dependency edges; if it can reach `newId` again, the
+ * proposed set of dependencies forms a cycle (direct or indirect).
+ */
+export function wouldCreateCycle(
+  existing: Map<string, string[]>,
+  newId: string,
+  newDeps: string[],
+): boolean {
+  const deps = new Map(existing);
+  deps.set(newId, newDeps);
+
+  const visiting = new Set<string>();
+  const visited = new Set<string>();
+
+  const dfs = (node: string): boolean => {
+    if (visiting.has(node)) return true; // back-edge => cycle
+    if (visited.has(node)) return false;
+    visiting.add(node);
+    for (const dep of deps.get(node) ?? []) {
+      if (dfs(dep)) return true;
+    }
+    visiting.delete(node);
+    visited.add(node);
+    return false;
+  };
+
+  return dfs(newId);
+}
