' });\n    q.add('b', { queue: 'q2' });\n    await q.process('q1');\n    await q.process('q2');\n    expect(calls).toEqual(['q1', 'q2-handler']);\n  });\n\n  it('process returns null when nothing is available', async () => {\n    const q = new TaskQueue();\n    expect(await q.process('q')).toBeNull();\n  });\n});\n\ndescribe('Phase 12: graceful shutdown', () => {\n  it('completes immediately when nothing is processing', async () => {\n    const q = new TaskQueue();\n    const summary = await q.shutdown();\n    expect(summary).toEqual({ completed: 0, forceCancelled: 0, durationMs: expect.any(Number) });\n  });\n\n  it('stops accepting tasks after shutdown', async () => {\n    const q = new TaskQueue();\n    await q.shutdown();\n    expect(() => q.add('a')).toThrow();\n  });\n\n  it('runs shutdown callbacks', async () => {\n    const q = new TaskQueue();\n    let ran = false;\n    q.onShutdown(() => {\n      ran = true;\n    });\n    await q.shutdown();\n    expect(ran).toBe(true);\n  });\n\n  it('waits for processing tasks then summarizes completed', async () => {\n    const q = new TaskQueue();\n    const a = q.add('a');\n    const b = q.add('b');\n    q.next();\n    q.next();\n    const p = q.shutdown({ timeout: 1000 });\n    // finish both while shutdown waits\n    q.complete(a.id);\n    q.complete(b.id);\n    const summary = await p;\n    expect(summary.completed).toBe(2);\n    expect(summary.forceCancelled).toBe(0);\n  });\n\n  it('force-cancels tasks exceeding the timeout', async () => {\n    const q = new TaskQueue();\n    const a = q.add('a');\n    q.next();\n    const summary = await q.shutdown({ timeout: 30 });\n    expect(summary.forceCancelled).toBe(1);\n    expect(q.getTask(a.id)?.status).toBe('cancelled');\n  });\n\n  it('is idempotent and returns the same result', async () => {\n    const q = new TaskQueue();\n    const p1 = q.shutdown();\n    const p2 = q.shutdown();\n    expect(p1).toBe(p2);\n    const [s1, s2] = await Promise.all([p1, p2]);\n    exp