index 0000000..fb76ee1
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,137 @@
+/**
+ * Shared types for the in-memory task queue system.
+ */
+
+/** Lifecycle status of a task. */
+export type TaskStatus =
+  | 'pending' // waiting, immediately available
+  | 'delayed' // waiting, available at a future time
+  | 'blocked' // waiting on unresolved dependencies
+  | 'processing' // currently being worked on
+  | 'completed' // finished successfully
+  | 'failed' // failed and out of retries (also placed in DLQ)
+  | 'cancelled' // cancelled by the user; never retried
+  | 'dead'; // reserved alias for failed-in-DLQ (not used directly)
+
+/** Normalized error information attached to a task. */
+export interface TaskError {
+  message: string;
+  name?: string;
+  stack?: string;
+}
+
+/** Progress information for a running task. */
+export interface TaskProgress {
+  percent: number;
+  message?: string;
+}
+
+/** A single unit of work. Returned objects are live instances. */
+export interface Task<T = unknown> {
+  /** Unique identifier. */
+  readonly id: string;
+  /** Arbitrary payload supplied when the task was added. */
+  payload: T;
+  /** Name of the queue the task belongs to. */
+  readonly queue: string;
+  /** Current lifecycle status. */
+  status: TaskStatus;
+  /** Priority 1 (highest) .. 10 (lowest). */
+  priority: number;
+  /** Creation timestamp (ms). */
+  readonly createdAt: number;
+  /** Timestamp (ms) at which the task becomes available for processing. */
+  availableAt: number;
+  /** Whether the task was explicitly delayed/scheduled (affects ordering). */
+  scheduled: boolean;
+  /** Number of times processing has started. */
+  attempts: number;
+  /** Maximum number of retries after the first attempt. */
+  maxRetries: number;
+  /** Base backoff delay in ms. */
+  baseDelay: number;
+  /** IDs of tasks that must complete before this one becomes available. */
+  dependencies: string[];
+  /** Last error recorded for the task, if any. */
+  error?: TaskError;
+  /** Latest progress report, if any. */
+  progress?: TaskProgress;
+  /** Result value supplied to complete(), if any. */
+  result?: unknown;
+  /** True once the task has been cancelled (prevents any retry). */
+  cancelled: boolean;
+  /** Monotonic sequence number used for FIFO tie-breaking. */
+  readonly seq: number;
+  /** Arbitrary metadata middleware may attach. */
+  metadata: Record<string, unknown>;
+}
+
+/** Options accepted by `add`. */
+export interface AddOptions {
+  queue?: string;
+  priority?: number;
+  /** Delay in ms before the task becomes available. */
+  delay?: number;
+  /** Absolute timestamp (ms) at which the task becomes available. */
+  runAt?: number;
+  maxRetries?: number;
+  baseDelay?: number;
+  dependencies?: string[];
+}
+
+/** Dependency inspection result. */
+export interface DependencyStatus {
+  dependencies: string[];
+  completed: string[];
+  pending: string[];
+  blocked: boolean;
+}
+
+/** Concurrency inspection result. */
+export interface ConcurrencyInfo {
+  limit: number | null;
+  active: number;
+}
+
+/** A function that advances task processing to the next middleware/handler. */
+export type Next = () => void | Promise<void>;
+
+/** Middleware function registered per queue. */
+export type Middleware<T = unknown> = (task: Task<T>, next: Next) => void | Promise<void>;
+
+/** Final handler invoked after all middleware. */
+export type Handler<T = unknown> = (task: Task<T>) => void | Promise<void>;
+
+/** Progress listener. */
+export type ProgressListener = (progress: TaskProgress, task: Task) => void;
+
+/** A recurring schedule. */
+export interface Schedule {
+  readonly id: string;
+  readonly cron: string;
+  readonly queue: string;
+  readonly payload: unknown;
+  /** Options applied to each enqueued task. */
+  readonly options: AddOptions;
+  /** Timestamp of the most recent occurrence that has been enqueued. */
+  lastRun: number;
+}
+
+/** Options for `shutdown`. */
+export interface ShutdownOptions {
+  /** Max time (ms) to wait for processing tasks before force-cancelling. */
+  timeout?: number;
+}
+
+/** Summary returned by `shutdown`. */
+export interface ShutdownSummary {
+  completed: number;
+  forceCancelled: number;
+  durationMs: number;
+}
+
+/** Constructor options. */
+export interface TaskQueueOptions {
+  /** Injectable clock used for delays, backoff and cron. Defaults to Date.now. */
+  clock?: () => number;
+}
