+import { describe, it, expect } from 'vitest';
+import { TaskQueue, parseCron, nextCronTime } from '../src/index.js';
+
+describe('Phase 10: recurring tasks', () => {
+  it('parses and validates supported cron expressions', () => {
+    expect(() => parseCron('*/5 * * * *')).not.toThrow();
+    expect(() => parseCron('0 * * * *')).not.toThrow();
+    expect(() => parseCron('0 0 * * *')).not.toThrow();
+    expect(() => parseCron('bad')).toThrow();
+    expect(() => parseCron('0 0 1 * *')).toThrow(); // dom unsupported
+  });
+
+  it('nextCronTime computes the next occurrence', () => {
+    // base at an exact minute boundary, 00:00:00 UTC
+    const base = Date.UTC(2026, 0, 1, 0, 0, 0);
+    expect(nextCronTime('*/5 * * * *', base)).toBe(base + 5 * 60_000);
+    expect(nextCronTime('0 * * * *', base)).toBe(base + 60 * 60_000);
+    expect(nextCronTime('0 0 * * *', base)).toBe(base + 24 * 60 * 60_000);
+  });
+
+  it('create / list / remove schedules', () => {
+    const q = new TaskQueue();
+    const id = q.schedule('*/5 * * * *', { job: 1 }, { queue: 'cron' });
+    expect(q.listSchedules().map((s) => s.id)).toContain(id);
+    expect(q.removeSchedule(id)).toBe(true);
+    expect(q.listSchedules()).toHaveLength(0);
+  });
+
+  it('tick enqueues due tasks (with catch-up) and they are normal tasks', () => {
+    const base = Date.UTC(2026, 0, 1, 0, 0, 0);
+    let now = base;
+    const q = new TaskQueue({ clock: () => now });
+    q.schedule('*/5 * * * *', { job: 1 }, { queue: 'cron', priority: 2 });
+
+    // advance 12 minutes -> occurrences at +5 and +10
+    now = base + 12 * 60_000;
+    const enqueued = q.tick();
+    expect(enqueued).toHaveLength(2);
+    expect(q.size('cron')).toBe(2);
+    const t = q.next('cron');
+    expect(t?.payload).toEqual({ job: 1 });
+    expect(t?.priority).toBe(2); // template options applied
+  });
+
+  it('removing a schedule stops future occurrences', () => {
+    const base = Date.UTC(2026, 0, 1, 0, 0, 0);
+    let now = base;
+    const q = new TaskQueue({ clock: () => now });
+    const id = q.schedule('*/5 * * * *', {}, { queue: 'cron' });
+    q.removeSchedule(id);
+    now = base + 60 * 60_000;
+    expect(q.tick()).toHaveLength(0);
+  });
+
+  it('does not re-enqueue the same occurrence twice', () => {
+    const base = Date.UTC(2026, 0, 1, 0, 0, 0);
+    let now = base;
+    const q = new TaskQueue({ clock: () => now });
+    q.schedule('*/5 * * * *', {}, { queue: 'cron' });
+    now = base + 6 * 60_000;
+    expect(q.tick()).toHaveLength(1);
+    expect(q.tick()).toHaveLength(0); // same time, nothing new
+    now = base + 11 * 60_000;
+    expect(q.tick()).toHaveLength(1);
+  });
+});
+
+describe('Phase 11: middleware pipeline', () => {
+  it('runs middleware in order then handler', async () => {
+    const q = new TaskQueue();
+    const order: string[] = [];
+    q.use('q', async (_t, next) => {
+      order.push('mw1');
+      await next();
+    });
+    q.use('q', async (_t, next) => {
+      order.push('mw2');
+      await next();
+    });
+    q.setHandler('q', () => {
+      order.push('handler');
+    });
+    const t = q.add('payload', { queue: 'q' });
+    const processed = await q.process('q');
+    expect(processed?.id).toBe(t.id);
+    expect(order).toEqual(['mw1', 'mw2', 'handler']);
+    expect(q.getTask(t.id)?.status).toBe('completed');
+  });
+
+  it('not calling next skips the handler', async () => {
+    const q = new TaskQueue();
+    let handlerRan = false;
+    q.use('q', () => {
+      /* swallow: never calls next */
+    });
+    q.setHandler('q', () => {
+      handlerRan = true;
+    });
+    const t = q.add('p', { queue: 'q' });
+    await q.process('q');
+    expect(handlerRan).toBe(false);
+    expect(q.getTask(t.id)?.status).toBe('completed');
+  });
+
+  it('middleware can modify the task', async () => {
+    const q = new TaskQueue();
+    q.use('q', async (task, next) => {
+      task.metadata.traced = true;
+      task.payload = { transformed: true };
+      await next();
+    });
+    let seen: unknown;
+    q.setHandler('q', (task) => {
+      seen = task.payload;
+    });
+    const t = q.add('orig', { queue: 'q' });
+    await q.process('q');
+    expect(seen).toEqual({ transformed: true });
+    expect(q.getTask(t.id)?.metadata.traced).toBe(true);
+  });
+
+  it('middleware throwing marks the task failed', async () => {
+    const q = new TaskQueue({ clock: () => 0 });
+    q.use('q', () => {
+      throw new Error('mw boom');
+    });
+    q.setHandler('q', () => {
+      /* never reached */
+    });
+    const t = q.add('p', { queue: 'q', maxRetries: 0 });
+    await q.process('q');
+    expect(q.getTask(t.id)?.status).toBe('failed');
+    expect(q.getTask(t.id)?.error?.message).toBe('mw boom');
+  });
+
+  it('handler throwing marks the task failed', async () => {
+    const q = new TaskQueue({ clock: () => 0 });
+    q.setHandler('q', () => {
+      throw new Error('handler boom');
+    });
+    const t = q.add('p', { queue: 'q', maxRetries: 0 });
+    await q.process('q');
+    expect(q.getTask(t.id)?.status).toBe('failed');
+  });
+
+  it('middleware stacks are per-queue', async () => {
+    const q = new TaskQueue();
+    const calls: string[] = [];
+    q.use('q1', async (_t, next) => {
+      calls.push('q1');
+      await next();
+    });
+    q.setHandler('q1', () => {});
+    q.setHandler('q2', () => {
+      calls.push('q2-handler');
+    });
+    q.add('a', { queue: 'q1' });
+    q.add('b', { queue: 'q2' });
+    await q.process('q1');
+    await q.process('q2');
+    expect(calls).toEqual(['q1', 'q2-handler']);
+  });
+
+  it('process returns null when nothing is available', async () => {
+    const q = new TaskQueue();
+    expect(await q.process('q')).toBeNull();
+  });
+});
+
+describe('Phase 12: graceful shutdown', () => {
+  it('completes immediately when nothing is processing', async () => {
+    const q = new TaskQueue();
+    const summary = await q.shutdown();
+    expect(summary).toEqual({ completed: 0, forceCancelled: 0, durationMs: expect.any(Number) });
+  });
+
+  it('stops accepting tasks after shutdown', async () => {
+    const q = new TaskQueue();
+    await q.shutdown();
+    expect(() => q.add('a')).toThrow();
+  });
+
+  it('runs shutdown callbacks', async () => {
+    const q = new TaskQueue();
+    let ran = false;
+    q.onShutdown(() => {
+      ran = true;
+    });
