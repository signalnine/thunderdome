+++ b/tests/phase07-09.test.ts
@@ -0,0 +1,142 @@
+import { describe, it, expect } from 'vitest';
+import { TaskQueue, wouldCreateCycle } from '../src/index.js';
+
+describe('Phase 7: dependencies', () => {
+  it('task with unresolved deps is blocked and not returned', () => {
+    const q = new TaskQueue();
+    const a = q.add('a');
+    const b = q.add('b', { dependencies: [a.id] });
+    expect(q.getTask(b.id)?.status).toBe('blocked');
+    // a is returned first; b stays blocked
+    expect(q.next()?.id).toBe(a.id);
+    expect(q.next()).toBeNull();
+  });
+
+  it('completing a dependency unblocks dependents', () => {
+    const q = new TaskQueue();
+    const a = q.add('a');
+    const b = q.add('b', { dependencies: [a.id] });
+    q.next();
+    q.complete(a.id);
+    expect(q.getTask(b.id)?.status).toBe('pending');
+    expect(q.next()?.id).toBe(b.id);
+  });
+
+  it('depending on a non-existent task throws', () => {
+    const q = new TaskQueue();
+    expect(() => q.add('b', { dependencies: ['nope'] })).toThrow();
+  });
+
+  it('failed dependency keeps dependents blocked', () => {
+    const q = new TaskQueue({ clock: () => 0 });
+    const a = q.add('a', { maxRetries: 0 });
+    const b = q.add('b', { dependencies: [a.id] });
+    q.next();
+    q.fail(a.id); // a is now failed (no retries)
+    expect(q.getTask(a.id)?.status).toBe('failed');
+    expect(q.getTask(b.id)?.status).toBe('blocked');
+    expect(q.next()).toBeNull();
+  });
+
+  it('multiple dependencies all must complete', () => {
+    const q = new TaskQueue();
+    const a = q.add('a');
+    const b = q.add('b');
+    const c = q.add('c', { dependencies: [a.id, b.id] });
+    q.next(); // a
+    q.next(); // b
+    q.complete(a.id);
+    expect(q.getTask(c.id)?.status).toBe('blocked');
+    q.complete(b.id);
+    expect(q.getTask(c.id)?.status).toBe('pending');
+  });
+
+  it('getDependencyStatus is inspectable', () => {
+    const q = new TaskQueue();
+    const a = q.add('a');
+    const b = q.add('b');
+    const c = q.add('c', { dependencies: [a.id, b.id] });
+    q.next();
+    q.next();
+    q.complete(a.id);
+    const status = q.getDependencyStatus(c.id);
+    expect(status.dependencies).toEqual([a.id, b.id]);
+    expect(status.completed).toEqual([a.id]);
+    expect(status.pending).toEqual([b.id]);
+    expect(status.blocked).toBe(true);
+  });
+
+  it('detects cycles via the graph helper', () => {
+    // a -> b -> c -> a
+    const g = new Map<string, string[]>([
+      ['a', ['b']],
+      ['b', ['c']],
+    ]);
+    expect(wouldCreateCycle(g, 'c', ['a'])).toBe(true);
+    expect(wouldCreateCycle(g, 'c', [])).toBe(false);
+    // self loop
+    expect(wouldCreateCycle(new Map(), 'x', ['x'])).toBe(true);
+  });
+});
+
+describe('Phase 9: progress & cancellation', () => {
+  it('updateProgress / getProgress', () => {
+    const q = new TaskQueue();
+    const t = q.add('a');
+    q.next();
+    q.updateProgress(t.id, 42, 'halfway');
+    expect(q.getProgress(t.id)).toEqual({ percent: 42, message: 'halfway' });
+  });
+
+  it('rejects out-of-range progress', () => {
+    const q = new TaskQueue();
+    const t = q.add('a');
+    q.next();
+    expect(() => q.updateProgress(t.id, -1)).toThrow();
+    expect(() => q.updateProgress(t.id, 101)).toThrow();
+  });
+
+  it('onProgress notifies and can unsubscribe', () => {
+    const q = new TaskQueue();
+    const t = q.add('a');
+    q.next();
+    const seen: number[] = [];
+    const unsub = q.onProgress(t.id, (p) => seen.push(p.percent));
+    q.updateProgress(t.id, 10);
+    q.updateProgress(t.id, 20);
+    unsub();
+    q.updateProgress(t.id, 30);
+    expect(seen).toEqual([10, 20]);
+  });
+
+  it('cancel pending removes it from the queue', () => {
+    const q = new TaskQueue();
+    const t = q.add('a');
+    q.cancel(t.id);
+    expect(q.getTask(t.id)?.status).toBe('cancelled');
+    expect(q.size()).toBe(0);
+    expect(q.next()).toBeNull();
+  });
+
+  it('cancel processing updates status and frees slot', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('q', 1);
+    const t = q.add('a', { queue: 'q' });
+    q.add('b', { queue: 'q' });
+    q.next('q');
+    q.cancel(t.id);
+    expect(q.getTask(t.id)?.status).toBe('cancelled');
+    expect(q.getConcurrency('q').active).toBe(0);
+    expect(q.next('q')?.payload).toBe('b');
+  });
+
+  it('cancelled processing tasks are never retried', () => {
+    const q = new TaskQueue({ clock: () => 0 });
+    const t = q.add('a', { maxRetries: 3 });
+    q.next();
+    q.cancel(t.id);
+    q.fail(t.id, new Error('late')); // should not re-queue
+    expect(q.getTask(t.id)?.status).toBe('cancelled');
+    expect(q.size()).toBe(0);
+  });
+});
