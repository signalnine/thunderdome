index 0000000..984658c
--- /dev/null
+++ b/src/taskQueue.ts
@@ -0,0 +1,649 @@
+import { nextCronTime, parseCron } from './cron.js';
+import { wouldCreateCycle } from './graph.js';
+import {
+  AddOptions,
+  ConcurrencyInfo,
+  DependencyStatus,
+  Handler,
+  Middleware,
+  Next,
+  ProgressListener,
+  Schedule,
+  ShutdownOptions,
+  ShutdownSummary,
+  Task,
+  TaskError,
+  TaskProgress,
+  TaskQueueOptions,
+} from './types.js';
+
+const DEFAULT_QUEUE = 'default';
+const DEFAULT_PRIORITY = 5;
+const DEFAULT_MAX_RETRIES = 3;
+const DEFAULT_BASE_DELAY = 1000;
+const DEFAULT_SHUTDOWN_TIMEOUT = 30_000;
+
+/** Internal per-queue state. */
+class NamedQueue {
+  readonly name: string;
+  /** Tasks awaiting processing (pending / delayed / blocked). */
+  waiting: Task[] = [];
+  /** Ids of tasks currently being processed. */
+  processing = new Set<string>();
+  /** Permanently failed tasks. */
+  deadLetter: Task[] = [];
+  concurrencyLimit: number | null = null;
+  middleware: Middleware[] = [];
+  handler?: Handler;
+
+  constructor(name: string) {
+    this.name = name;
+  }
+}
+
+function normalizeError(err: unknown): TaskError {
+  if (err instanceof Error) {
+    return { message: err.message, name: err.name, stack: err.stack };
+  }
+  if (typeof err === 'string') {
+    return { message: err };
+  }
+  if (err === undefined || err === null) {
+    return { message: 'Task failed' };
+  }
+  return { message: String(err) };
+}
+
+/**
+ * A fully in-memory task queue supporting named queues, priority, delays,
+ * retries with backoff, dead-letter queues, dependencies, concurrency limits,
+ * progress/cancellation, recurring schedules, middleware and graceful shutdown.
+ */
+export class TaskQueue {
+  private readonly clock: () => number;
+  private readonly queues = new Map<string, NamedQueue>();
+  private readonly tasks = new Map<string, Task>();
+  private readonly schedules = new Map<string, Schedule>();
+  private readonly progressListeners = new Map<string, Set<ProgressListener>>();
+  private readonly shutdownCallbacks: Array<() => void | Promise<void>> = [];
+  private readonly processingListeners = new Set<() => void>();
+
+  private seqCounter = 0;
+  private scheduleCounter = 0;
+  private shuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+
+  constructor(options: TaskQueueOptions = {}) {
+    this.clock = options.clock ?? (() => Date.now());
+  }
+
+  // ---------------------------------------------------------------------------
+  // Queue helpers
+  // ---------------------------------------------------------------------------
+
+  private ensureQueue(name: string): NamedQueue {
+    let q = this.queues.get(name);
+    if (!q) {
+      q = new NamedQueue(name);
+      this.queues.set(name, q);
+    }
+    return q;
+  }
+
+  /** Names of all queues that currently exist. */
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  /** Look up a task by id (any status). */
+  getTask(id: string): Task | undefined {
+    return this.tasks.get(id);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 1-4 & 7: add
+  // ---------------------------------------------------------------------------
+
+  add<T = unknown>(payload: T, options: AddOptions = {}): Task<T> {
+    if (this.shuttingDown) {
+      throw new Error('Cannot add tasks: the queue is shutting down');
+    }
+
+    const priority = options.priority ?? DEFAULT_PRIORITY;
+    if (!Number.isInteger(priority) || priority < 1 || priority > 10) {
+      throw new Error(`Invalid priority ${priority}: must be an integer between 1 and 10`);
+    }
+
+    const queueName = options.queue ?? DEFAULT_QUEUE;
+    const dependencies = options.dependencies ? [...options.dependencies] : [];
+
+    for (const dep of dependencies) {
+      if (!this.tasks.has(dep)) {
+        throw new Error(`Cannot depend on non-existent task "${dep}"`);
+      }
+    }
+
+    const now = this.clock();
+    const id = this.generateId();
+
+    if (dependencies.length > 0) {
+      const existing = new Map<string, string[]>();
+      for (const [tid, t] of this.tasks) existing.set(tid, t.dependencies);
+      if (wouldCreateCycle(existing, id, dependencies)) {
+        throw new Error('Circular dependency detected');
+      }
+    }
+
+    let availableAt = now;
+    let scheduled = false;
+    if (typeof options.runAt === 'number') {
+      availableAt = options.runAt;
+      scheduled = true;
+    } else if (typeof options.delay === 'number' && options.delay > 0) {
+      availableAt = now + options.delay;
+      scheduled = true;
+    }
+
+    const task: Task<T> = {
+      id,
+      payload,
+      queue: queueName,
+      status: 'pending',
+      priority,
+      createdAt: now,
+      availableAt,
+      scheduled,
+      attempts: 0,
+      maxRetries: options.maxRetries ?? DEFAULT_MAX_RETRIES,
+      baseDelay: options.baseDelay ?? DEFAULT_BASE_DELAY,
+      dependencies,
+      cancelled: false,
+      seq: this.seqCounter++,
+      metadata: {},
+    };
+
+    this.recomputeWaitingStatus(task, now);
+
+    const q = this.ensureQueue(queueName);
+    q.waiting.push(task as Task);
+    this.tasks.set(id, task as Task);
+    return task;
+  }
+
+  /** Recompute the headline waiting status (pending/delayed/blocked). */
+  private recomputeWaitingStatus(task: Task, now: number): void {
+    if (!this.dependenciesResolved(task)) {
+      task.status = 'blocked';
+    } else if (task.availableAt > now) {
+      task.status = 'delayed';
+    } else {
+      task.status = 'pending';
+    }
+  }
+
+  private dependenciesResolved(task: Task): boolean {
+    return task.dependencies.every((dep) => this.tasks.get(dep)?.status === 'completed');
+  }
+
+  private isAvailable(task: Task, now: number): boolean {
+    return task.availableAt <= now && this.dependenciesResolved(task);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 1-4, 8: next / retrieval
+  // ---------------------------------------------------------------------------
+
+  /**
+   * Retrieve the next available task from a queue, transitioning it to
+   * `processing`. Returns null when nothing is available (including when the
+   * concurrency limit is reached).
+   */
+  next(queueName: string = DEFAULT_QUEUE): Task | null {
+    const q = this.queues.get(queueName);
+    if (!q) return null;
+
+    if (q.concurrencyLimit !== null && q.processing.size >= q.concurrencyLimit) {
+      return null;
+    }
+
+    const now = this.clock();
+    let best: Task | null = null;
+    for (const task of q.waiting) {
+      if (!this.isAvailable(task, now)) continue;
+      if (best === null || this.compare(task, best) < 0) {
+        best = task;
+      }
+    }
+    if (best === null) return null;
+
+    this.removeFromWaiting(q, best);
+    best.status = 'processing';
+    best.attempts += 1;
+    q.processing.add(best.id);
+    return best;
+  }
+
+  /**
+   * Ordering of available tasks:
+   *  - non-delayed tasks before delayed ones
+   *  - among delayed: availableAt asc, then priority asc, then FIFO
+   *  - among non-delayed: priority asc, then FIFO
+   */
+  private compare(a: Task, b: Task): number {
+    const aDelayed = a.scheduled ? 1 : 0;
+    const bDelayed = b.scheduled ? 1 : 0;
+    if (aDelayed !== bDelayed) return aDelayed - bDelayed;
+    if (aDelayed === 1 && a.availableAt !== b.availableAt) {
+      return a.availableAt - b.availableAt;
+    }
+    if (a.priority !== b.priority) return a.priority - b.priority;
+    return a.seq - b.seq;
+  }
+
+  private removeFromWaiting(q: NamedQueue, task: Task): void {
+    const idx = q.waiting.indexOf(task);
+    if (idx !== -1) q.waiting.splice(idx, 1);
+  }
+
+  /** Number of tasks waiting (pending/delayed/blocked) in a queue. */
+  size(queueName: string = DEFAULT_QUEUE): number {
+    return this.queues.get(queueName)?.waiting.length ?? 0;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 5-6: complete / fail / DLQ
+  // ---------------------------------------------------------------------------
+
+  /** Mark a processing task as completed. */
+  complete(taskId: string, result?: unknown): void {
+    const task = this.tasks.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    const q = this.ensureQueue(task.queue);
+    q.processing.delete(taskId);
+    task.status = 'completed';
+    task.result = result;
+
+    this.onDependencyResolved(taskId);
+    this.notifyProcessingChange();
+  }
+
+  /** Mark a processing task as failed, retrying with backoff or dead-lettering. */
+  fail(taskId: string, error?: unknown): void {
+    const task = this.tasks.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    const q = this.ensureQueue(task.queue);
+    q.processing.delete(taskId);
+    task.error = normalizeError(error);
+
+    // Cancelled tasks are never retried.
+    if (task.cancelled) {
+      this.notifyProcessingChange();
+      return;
+    }
+
+    const retriesUsed = task.attempts - 1;
+    if (retriesUsed < task.maxRetries) {
+      const delay = task.baseDelay * Math.pow(2, task.attempts - 1);
+      task.availableAt = this.clock() + delay;
+      task.scheduled = true;
+      task.status = 'delayed';
+      q.waiting.push(task);
+    } else {
+      task.status = 'failed';
+      q.deadLetter.push(task);
+    }
+    this.notifyProcessingChange();
+  }
+
+  /** Tasks that permanently failed for a queue. */
+  getDeadLetterQueue(queueName: string = DEFAULT_QUEUE): Task[] {
+    return [...(this.queues.get(queueName)?.deadLetter ?? [])];
+  }
+
+  /** Move a dead-lettered task back to its queue for a fresh round of retries. */
+  retryDeadLetter(taskId: string): Task {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new Error(`Unknown task "${taskId}"`);
+    const q = this.ensureQueue(task.queue);
+    const idx = q.deadLetter.indexOf(task);
+    if (idx === -1) {
+      throw new Error(`Task "${taskId}" is not in the dead letter queue`);
+    }
+    q.deadLetter.splice(idx, 1);
+
+    task.attempts = 0;
+    task.cancelled = false;
+    task.scheduled = false;
+    task.availableAt = this.clock();
+    this.recomputeWaitingStatus(task, this.clock());
+    q.waiting.push(task);
+    return task;
+  }
+
+  /** Remove all dead-lettered tasks for a queue. */
+  clearDeadLetterQueue(queueName: string = DEFAULT_QUEUE): void {
+    const q = this.queues.get(queueName);
+    if (!q) return;
+    for (const task of q.deadLetter) {
+      this.tasks.delete(task.id);
+    }
+    q.deadLetter = [];
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 7: dependencies
+  // ---------------------------------------------------------------------------
+
+  private onDependencyResolved(completedId: string): void {
+    const now = this.clock();
+    for (const task of this.tasks.values()) {
+      if (task.status !== 'blocked') continue;
+      if (!task.dependencies.includes(completedId)) continue;
+      this.recomputeWaitingStatus(task, now);
+    }
+  }
+
+  /** Inspect a task's dependency resolution status. */
+  getDependencyStatus(taskId: string): DependencyStatus {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new Error(`Unknown task "${taskId}"`);
+    const completed: string[] = [];
+    const pending: string[] = [];
+    for (const dep of task.dependencies) {
+      if (this.tasks.get(dep)?.status === 'completed') completed.push(dep);
+      else pending.push(dep);
+    }
+    return {
+      dependencies: [...task.dependencies],
+      completed,
+      pending,
+      blocked: pending.length > 0,
+    };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 8: concurrency
+  // ---------------------------------------------------------------------------
+
+  /** Set (or clear, with null) the max concurrency for a queue. */
+  setConcurrency(queueName: string, limit: number | null): void {
+    if (limit !== null && (!Number.isInteger(limit) || limit < 0)) {
+      throw new Error(`Invalid concurrency limit ${limit}`);
+    }
+    this.ensureQueue(queueName).concurrencyLimit = limit;
+  }
+
+  /** Query a queue's concurrency limit and active count. */
+  getConcurrency(queueName: string = DEFAULT_QUEUE): ConcurrencyInfo {
+    const q = this.queues.get(queueName);
+    return { limit: q?.concurrencyLimit ?? null, active: q?.processing.size ?? 0 };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 9: progress & cancellation
+  // ---------------------------------------------------------------------------
+
+  /** Report progress (0..100) for a processing task. */
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new Error(`Unknown task "${taskId}"`);
+    if (typeof percent !== 'number' || percent < 0 || percent > 100) {
+      throw new Error(`Invalid progress ${percent}: must be between 0 and 100`);
+    }
+    const progress: TaskProgress = { percent };
+    if (message !== undefined) progress.message = message;
+    task.progress = progress;
+
+    const listeners = this.progressListeners.get(taskId);
+    if (listeners) {
+      for (const listener of listeners) listener(progress, task);
+    }
+  }
+
+  /** Current progress for a task, if any. */
+  getProgress(taskId: string): TaskProgress | undefined {
+    return this.tasks.get(taskId)?.progress;
+  }
+
+  /** Subscribe to progress updates for a task. Returns an unsubscribe function. */
+  onProgress(taskId: string, listener: ProgressListener): () => void {
+    let listeners = this.progressListeners.get(taskId);
+    if (!listeners) {
+      listeners = new Set();
+      this.progressListeners.set(taskId, listeners);
+    }
+    listeners.add(listener);
+    return () => {
+      listeners?.delete(listener);
+    };
+  }
+
+  /** Cancel a pending or processing task. */
+  cancel(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) return;
+    const q = this.ensureQueue(task.queue);
+
+    if (task.status === 'processing') {
+      q.processing.delete(taskId);
+      task.cancelled = true;
+      task.status = 'cancelled';
+      this.notifyProcessingChange();
+      return;
+    }
+
+    if (task.status === 'pending' || task.status === 'delayed' || task.status === 'blocked') {
+      this.removeFromWaiting(q, task);
+      task.cancelled = true;
+      task.status = 'cancelled';
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 10: recurring tasks
+  // ---------------------------------------------------------------------------
+
+  /** Create a recurring schedule. Returns its id. */
+  schedule(cron: string, payload: unknown, options: AddOptions = {}): string {
+    parseCron(cron); // validate eagerly
+    const id = `sched-${this.scheduleCounter++}`;
+    const schedule: Schedule = {
+      id,
+      cron,
+      queue: options.queue ?? DEFAULT_QUEUE,
+      payload,
+      options: { ...options },
+      lastRun: this.clock(),
+    };
+    this.schedules.set(id, schedule);
+    return id;
+  }
+
+  /** Remove a schedule. Returns true if one was removed. */
+  removeSchedule(scheduleId: string): boolean {
+    return this.schedules.delete(scheduleId);
+  }
+
+  /** List active schedules. */
+  listSchedules(): Schedule[] {
+    return [...this.schedules.values()];
+  }
+
+  /** Evaluate all schedules and enqueue any due tasks. Returns enqueued tasks. */
+  tick(now: number = this.clock()): Task[] {
+    if (this.shuttingDown) return [];
+    const enqueued: Task[] = [];
+    for (const schedule of this.schedules.values()) {
+      let nextTime = nextCronTime(schedule.cron, schedule.lastRun);
+      while (nextTime <= now) {
+        const task = this.add(schedule.payload, {
+          ...schedule.options,
+          queue: schedule.queue,
+        });
+        enqueued.push(task);
+        schedule.lastRun = nextTime;
+        nextTime = nextCronTime(schedule.cron, nextTime);
+      }
+    }
+    return enqueued;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 11: middleware & processing
+  // ---------------------------------------------------------------------------
+
+  /** Register middleware for a queue (runs in registration order). */
+  use<T = unknown>(queueName: string, middleware: Middleware<T>): void {
+    this.ensureQueue(queueName).middleware.push(middleware as Middleware);
+  }
+
+  /** Register the handler invoked after all middleware for a queue. */
+  setHandler<T = unknown>(queueName: string, handler: Handler<T>): void {
+    this.ensureQueue(queueName).handler = handler as Handler;
+  }
+
+  /**
+   * Retrieve the next task from a queue and run it through the middleware
+   * pipeline and handler, marking it completed or failed.
+   */
+  async process(queueName: string = DEFAULT_QUEUE): Promise<Task | null> {
+    const task = this.next(queueName);
+    if (task === null) return null;
+    const q = this.ensureQueue(queueName);
+
+    try {
+      await this.runPipeline(q, task);
+      this.complete(task.id);
+    } catch (err) {
+      this.fail(task.id, err);
+    }
+    return task;
+  }
+
+  private async runPipeline(q: NamedQueue, task: Task): Promise<void> {
+    const middleware = q.middleware;
+    const handler = q.handler;
+    let lastDispatched = -1;
+
+    const dispatch = async (i: number): Promise<void> => {
+      if (i <= lastDispatched) {
+        throw new Error('next() called multiple times in middleware');
+      }
+      lastDispatched = i;
+      if (i < middleware.length) {
+        const next: Next = () => dispatch(i + 1);
+        await middleware[i](task, next);
+      } else if (handler) {
+        await handler(task);
+      }
+    };
+
+    await dispatch(0);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Phase 12: graceful shutdown
+  // ---------------------------------------------------------------------------
+
+  /** Register a callback to run during shutdown. */
+  onShutdown(callback: () => void | Promise<void>): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  /** Whether shutdown has been initiated. */
+  isShuttingDown(): boolean {
+    return this.shuttingDown;
+  }
+
+  /**
+   * Shut down the queue: stop accepting tasks, run shutdown callbacks, wait for
+   * processing tasks (up to timeout) and force-cancel any stragglers.
+   * Idempotent: repeated calls return the same result.
+   */
+  shutdown(options: ShutdownOptions = {}): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+    this.shuttingDown = true;
+    const timeout = options.timeout ?? DEFAULT_SHUTDOWN_TIMEOUT;
+    const start = Date.now();
+
+    this.shutdownPromise = (async (): Promise<ShutdownSummary> => {
+      for (const cb of this.shutdownCallbacks) {
+        await cb();
+      }
+
+      const processingIds = this.allProcessingIds();
+      let forceCancelled = 0;
+
+      if (processingIds.length > 0) {
+        await this.waitForDrain(processingIds, timeout);
+        for (const id of processingIds) {
+          const task = this.tasks.get(id);
+          if (task && task.status === 'processing') {
+            this.cancel(id);
+            forceCancelled += 1;
+          }
+        }
+      }
+
+      const completed = processingIds.length - forceCancelled;
+      return {
+        completed,
+        forceCancelled,
+        durationMs: Date.now() - start,
+      };
+    })();
+
+    return this.shutdownPromise;
+  }
+
+  private allProcessingIds(): string[] {
+    const ids: string[] = [];
+    for (const q of this.queues.values()) {
+      for (const id of q.processing) ids.push(id);
+    }
+    return ids;
+  }
+
+  private waitForDrain(ids: string[], timeout: number): Promise<void> {
+    const isDrained = () =>
+      ids.every((id) => this.tasks.get(id)?.status !== 'processing');
+
+    if (isDrained()) return Promise.resolve();
+
+    return new Promise<void>((resolve) => {
+      let settled = false;
+      const cleanup = () => {
+        if (settled) return;
+        settled = true;
+        clearTimeout(timer);
+        this.processingListeners.delete(listener);
+        resolve();
+      };
+      const listener = () => {
+        if (isDrained()) cleanup();
+      };
+      const timer = setTimeout(cleanup, timeout);
+      // Don't keep the event loop alive solely for the shutdown timer.
+      if (typeof timer === 'object' && timer && 'unref' in timer) {
+        (timer as { unref: () => void }).unref();
+      }
+      this.processingListeners.add(listener);
+    });
+  }
+
+  private notifyProcessingChange(): void {
+    for (const listener of [...this.processingListeners]) listener();
+  }
+
+  // ---------------------------------------------------------------------------
+
+  private generateId(): string {
+    if (typeof globalThis.crypto?.randomUUID === 'function') {
+      return globalThis.crypto.randomUUID();
+    }
+    // Fallback (should not be needed on Node 20+).
+    return `task-${this.seqCounter}-${Math.floor(Math.random() * 1e9).toString(16)}`;
+  }
+}
