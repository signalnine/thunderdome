@@ -0,0 +1,80 @@
+/**
+ * A deliberately small cron implementation supporting the subset required by
+ * the recurring-task phase:
+ *   - `*\/N * * * *`  every N minutes
+ *   - `0 * * * *`     every hour on the hour
+ *   - `0 0 * * *`     every day at midnight
+ *
+ * Field matching also tolerates plain numbers and comma lists for minute/hour
+ * so the implementation is a touch more general than strictly required, while
+ * the day-of-month / month / day-of-week fields must be `*`.
+ */
+
+const MINUTE_MS = 60_000;
+
+interface ParsedCron {
+  minute: string;
+  hour: string;
+}
+
+/** Parse and validate a cron expression. Throws on unsupported expressions. */
+export function parseCron(expr: string): ParsedCron {
+  const parts = expr.trim().split(/\s+/);
+  if (parts.length !== 5) {
+    throw new Error(`Invalid cron expression: "${expr}" (expected 5 fields)`);
+  }
+  const [minute, hour, dom, mon, dow] = parts;
+  if (dom !== '*' || mon !== '*' || dow !== '*') {
+    throw new Error(
+      `Unsupported cron expression: "${expr}" (day-of-month, month and day-of-week must be *)`,
+    );
+  }
+  validateField(minute, 0, 59, expr);
+  validateField(hour, 0, 23, expr);
+  return { minute, hour };
+}
+
+function validateField(field: string, min: number, max: number, expr: string): void {
+  if (field === '*') return;
+  if (field.startsWith('*/')) {
+    const n = Number(field.slice(2));
+    if (!Number.isInteger(n) || n <= 0) {
+      throw new Error(`Invalid step in cron expression: "${expr}"`);
+    }
+    return;
+  }
+  for (const piece of field.split(',')) {
+    const n = Number(piece);
+    if (!Number.isInteger(n) || n < min || n > max) {
+      throw new Error(`Invalid field value "${piece}" in cron expression: "${expr}"`);
+    }
+  }
+}
+
+function matchField(value: number, field: string): boolean {
+  if (field === '*') return true;
+  if (field.startsWith('*/')) {
+    const n = Number(field.slice(2));
+    return value % n === 0;
+  }
+  return field.split(',').some((piece) => Number(piece) === value);
+}
+
+/**
+ * Returns the smallest timestamp strictly greater than `after` that matches the
+ * expression. Iterates minute-by-minute (cheap for the supported subset).
+ */
+export function nextCronTime(expr: string, after: number): number {
+  const { minute, hour } = parseCron(expr);
+  // Start at the next whole minute strictly after `after`.
+  const start = Math.floor(after / MINUTE_MS) * MINUTE_MS + MINUTE_MS;
+  const maxIterations = 366 * 24 * 60; // up to a year of minutes
+  for (let i = 0; i < maxIterations; i++) {
+    const t = start + i * MINUTE_MS;
+    const d = new Date(t);
+    if (matchField(d.getUTCMinutes(), minute) && matchField(d.getUTCHours(), hour)) {
+      return t;
+    }
+  }
+  throw new Error(`Could not find next occurrence for cron "${expr}"`);
+}
