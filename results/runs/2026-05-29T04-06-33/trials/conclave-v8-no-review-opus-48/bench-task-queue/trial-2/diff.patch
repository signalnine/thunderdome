ew Map<string, NamedQueue>();\n  private readonly tasks = new Map<string, Task>();\n  private readonly schedules = new Map<string, Schedule>();\n  private readonly progressListeners = new Map<string, Set<ProgressListener>>();\n  private readonly shutdownCallbacks: Array<() => void | Promise<void>> = [];\n  private readonly processingListeners = new Set<() => void>();\n\n  private seqCounter = 0;\n  private scheduleCounter = 0;\n  private shuttingDown = false;\n  private shutdownPromise: Promise<ShutdownSummary> | null = null;\n\n  constructor(options: TaskQueueOptions = {}) {\n    this.clock = options.clock ?? (() => Date.now());\n  }\n\n  // ---------------------------------------------------------------------------\n  // Queue helpers\n  // ---------------------------------------------------------------------------\n\n  private ensureQueue(name: string): NamedQueue {\n    let q = this.queues.get(name);\n    if (!q) {\n      q = new NamedQueue(name);\n      this.queues.set(name, q);\n    }\n    return q;\n  }\n\n  /** Names of all queues that currently exist. */\n  listQueues(): string[] {\n    return [...this.queues.keys()];\n  }\n\n  /** Look up a task by id (any status). */\n  getTask(id: string): Task | undefined {\n    return this.tasks.get(id);\n  }\n\n  // ---------------------------------------------------------------------------\n  // Phase 1-4 & 7: add\n  // ---------------------------------------------------------------------------\n\n  add<T = unknown>(payload: T, options: AddOptions = {}): Task<T> {\n    if (this.shuttingDown) {\n      throw new Error('Cannot add tasks: the queue is shutting down');\n    }\n\n    const priority = options.priority ?? DEFAULT_PRIORITY;\n    if (!Number.isInteger(priority) || priority < 1 || priority > 10) {\n      throw new Error(`Invalid priority ${priority}: must be an integer between 1 and 10`);\n    }\n\n    const queueName = options.queue ?? DEFAULT_QUEUE;\n    const dependencies = options.dependencies ? [...options