@@ -0,0 +1,31 @@
+/** Thrown when a task is cancelled before or during processing. */
+export class CancelledError extends Error {
+  readonly taskId: string;
+  constructor(taskId: string) {
+    super(`Task ${taskId} was cancelled`);
+    this.name = 'CancelledError';
+    this.taskId = taskId;
+  }
+}
+
+/** Used to fail a task whose dependency did not complete successfully. */
+export class DependencyError extends Error {
+  readonly taskId: string;
+  readonly dependencyId: string;
+  constructor(taskId: string, dependencyId: string) {
+    super(`Task ${taskId} failed because dependency ${dependencyId} did not complete`);
+    this.name = 'DependencyError';
+    this.taskId = taskId;
+    this.dependencyId = dependencyId;
+  }
+}
+
+/** Thrown when adding to a queue that is closing or closed. */
+export class QueueClosedError extends Error {
+  readonly queue: string;
+  constructor(queue: string) {
+    super(`Queue "${queue}" is closed and cannot accept new tasks`);
+    this.name = 'QueueClosedError';
+    this.queue = queue;
+  }
+}
