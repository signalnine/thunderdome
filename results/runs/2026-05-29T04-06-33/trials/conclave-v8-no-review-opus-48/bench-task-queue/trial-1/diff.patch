--- /dev/null
+++ b/src/ids.ts
@@ -0,0 +1,15 @@
+let counter = 0;
+
+/** Generate a process-unique, monotonically-increasing task id. */
+export function nextId(prefix = 'task'): string {
+  counter += 1;
+  const rand = Math.floor(Math.random() * 0xffffff)
+    .toString(36)
+    .padStart(4, '0');
+  return `${prefix}_${Date.now().toString(36)}_${counter.toString(36)}_${rand}`;
+}
+
+/** Reset the internal counter. Intended for tests only. */
+export function resetIdCounter(): void {
+  counter = 0;
+}
