+++ b/src/backoff.ts
@@ -0,0 +1,54 @@
+/** Backoff configuration for automatic retries. */
+export interface BackoffConfig {
+  type: 'fixed' | 'linear' | 'exponential';
+  /** Base delay in milliseconds. */
+  delay: number;
+  /** Growth factor for exponential backoff (default 2). */
+  factor?: number;
+  /** Upper bound for the computed delay in milliseconds. */
+  maxDelay?: number;
+  /** When true, randomize the delay in the range [0, computed]. */
+  jitter?: boolean;
+}
+
+/** Either a fixed number of milliseconds or a structured backoff config. */
+export type BackoffStrategy = number | BackoffConfig;
+
+/**
+ * Compute the delay (ms) before the next retry.
+ *
+ * @param strategy the configured backoff strategy (null/undefined => no delay)
+ * @param attempt  the attempt number that just failed (1-based)
+ */
+export function computeBackoff(
+  strategy: BackoffStrategy | null | undefined,
+  attempt: number,
+): number {
+  if (strategy === null || strategy === undefined) return 0;
+  if (typeof strategy === 'number') return Math.max(0, Math.floor(strategy));
+
+  const factor = strategy.factor ?? 2;
+  const maxDelay = strategy.maxDelay ?? Number.POSITIVE_INFINITY;
+  const jitter = strategy.jitter ?? false;
+  const base = strategy.delay;
+
+  let ms: number;
+  switch (strategy.type) {
+    case 'fixed':
+      ms = base;
+      break;
+    case 'linear':
+      ms = base * attempt;
+      break;
+    case 'exponential':
+      ms = base * factor ** (attempt - 1);
+      break;
+    default:
+      ms = base;
+      break;
+  }
+
+  ms = Math.min(ms, maxDelay);
+  if (jitter) ms = Math.random() * ms;
+  return Math.max(0, Math.floor(ms));
+}
