new file mode 100644
index 0000000..2ce317c
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,139 @@
+import type { BackoffStrategy } from './backoff.js';
+
+/** Lifecycle status of a task. */
+export type TaskStatus =
+  | 'waiting' // ready to run, queued
+  | 'delayed' // waiting for a delay or retry-backoff timer
+  | 'pending' // waiting on unfinished dependencies
+  | 'active' // currently being processed
+  | 'completed'
+  | 'failed'
+  | 'cancelled';
+
+/** Context handed to a task handler. */
+export interface JobContext {
+  readonly id: string;
+  readonly queue: string;
+  /** 1-based attempt number for the current run. */
+  readonly attempt: number;
+  /** Aborts when the task is cancelled. */
+  readonly signal: AbortSignal;
+  /** Report progress (clamped to 0..100). */
+  updateProgress(value: number): void;
+}
+
+/** A task handler: receives the payload and a context, returns a result. */
+export type Handler<T, R> = (payload: T, ctx: JobContext) => R | Promise<R>;
+
+/** Context passed through the middleware pipeline. */
+export interface MiddlewareContext<T, R> {
+  readonly id: string;
+  readonly queue: string;
+  readonly attempt: number;
+  readonly signal: AbortSignal;
+  /** Mutable payload; middleware may transform it before calling next(). */
+  payload: T;
+  /** Result of the handler; middleware may transform it after next(). */
+  result: R | undefined;
+  updateProgress(value: number): void;
+}
+
+/** Koa-style middleware around task processing. */
+export type Middleware<T, R> = (
+  ctx: MiddlewareContext<T, R>,
+  next: () => Promise<void>,
+) => void | Promise<void>;
+
+/** Options for adding a single task. */
+export interface AddOptions {
+  /** Custom id (defaults to a generated unique id). */
+  id?: string;
+  /** Higher numbers run first; defaults to 0. */
+  priority?: number;
+  /** Milliseconds to wait before the task becomes eligible. */
+  delay?: number;
+  /** Maximum number of attempts (>= 1); defaults to 1. */
+  attempts?: number;
+  /** Backoff applied between retries. */
+  backoff?: BackoffStrategy;
+  /** Ids of tasks (in the same queue) that must complete first. */
+  dependencies?: string[];
+}
+
+/** Options when constructing or configuring a queue. */
+export interface QueueOptions {
+  /** Maximum number of simultaneously active tasks (>= 1); defaults to 1. */
+  concurrency?: number;
+}
+
+/** Options for recurring task schedules. */
+export interface RecurringOptions {
+  /** Stable key to identify/replace the schedule. */
+  key?: string;
+  /** Options applied to each task the schedule creates. */
+  taskOptions?: AddOptions;
+}
+
+/** Handle returned by addRecurring. */
+export interface RecurringHandle {
+  readonly key: string;
+  remove(): boolean;
+}
+
+/** Options controlling graceful shutdown. */
+export interface CloseOptions {
+  /** Abort active tasks immediately instead of waiting. */
+  force?: boolean;
+  /** Process all queued/waiting tasks before closing (default: active only). */
+  drain?: boolean;
+  /** Force-abort still-active tasks after this many milliseconds. */
+  timeout?: number;
+}
+
+/** Read-only snapshot of a task. */
+export interface JobInfo<T = unknown, R = unknown> {
+  id: string;
+  queue: string;
+  payload: T;
+  status: TaskStatus;
+  priority: number;
+  attempts: number;
+  maxAttempts: number;
+  progress: number;
+  result: R | undefined;
+  error: string | undefined;
+  dependencies: string[];
+  createdAt: number;
+  processAt: number;
+}
+
+/** Events emitted for an individual job. */
+export interface JobEvents<R> {
+  progress: [number];
+  completed: [R];
+  failed: [Error];
+  cancelled: [];
+}
+
+/** Public handle for an enqueued task. */
+export interface Job<T = unknown, R = unknown> {
+  readonly id: string;
+  readonly payload: T;
+  readonly status: TaskStatus;
+  readonly progress: number;
+  readonly attempts: number;
+  /** Resolves when the task completes, rejects when it fails or is cancelled. */
+  result(): Promise<R>;
+  /** Cancel the task; returns true if it was cancellable. */
+  cancel(): boolean;
+  /** Current snapshot. */
+  info(): JobInfo<T, R>;
+  /** Subscribe to a job event; returns an unsubscribe function. */
+  on<K extends keyof JobEvents<R>>(
+    event: K,
+    listener: (...args: JobEvents<R>[K]) => void,
+  ): () => void;
+}
+
+/** Per-status counts of tasks in a queue. */
+export type Counts = Record<TaskStatus, number>;
