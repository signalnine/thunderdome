diff --git a/src/plugins/asset-pipeline.ts b/src/plugins/asset-pipeline.ts
new file mode 100644
index 0000000..b80088d
--- /dev/null
+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,46 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+/**
+ * asset-pipeline: rewrites relative asset URLs (`./foo.png`) referenced in
+ * `src`/`href` attributes to the canonical `/assets/` path, and records every
+ * discovered asset in a manifest stored on the shared build context.
+ */
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, ctx: BuildContext): ContentFile {
+        const discovered: string[] = [];
+
+        const content = file.content.replace(
+          /(src|href)="\.\/([^"]+)"/g,
+          (_match, attr: string, path: string) => {
+            discovered.push(path);
+            return `${attr}="/assets/${path}"`;
+          }
+        );
+
+        if (discovered.length > 0) {
+          let manifest = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+          if (!manifest) {
+            manifest = { assets: [] };
+            ctx.data.set('asset-manifest', manifest);
+          }
+          for (const asset of discovered) {
+            if (!manifest.assets.includes(asset)) {
+              manifest.assets.push(asset);
+            }
+          }
+        }
+
+        return { ...file, content };
+      },
+    },
+  };
+}
diff --git a/src/plugins/dev-server.ts b/src/plugins/dev-server.ts
new file mode 100644
index 0000000..9f3d411
--- /dev/null
+++ b/src/plugins/dev-server.ts
@@ -0,0 +1,65 @@
+import { BuildContext, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+interface DevServerRoute {
+  path: string;
+  handler: string;
+}
+
+interface DevServerConfig {
+  port: number;
+  routes: DevServerRoute[];
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+const DEFAULT_PORT = 3000;
+
+/**
+ * dev-server: assembles a development server configuration (stored on
+ * `ctx.data` as `dev-server-config`) describing static content routes, asset
+ * routes from the asset manifest, and the search index path. Depends on
+ * asset-pipeline and search-index.
+ */
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const routes: DevServerRoute[] = [];
+
+        // Static routes for every rendered HTML page.
+        for (const path of ctx.output.keys()) {
+          if (path.endsWith('.html')) {
+            routes.push({ path: `/${path}`, handler: 'static' });
+          }
+        }
+
+        // Asset routes from the asset-pipeline manifest, if present.
+        const manifest = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+        const assetPaths = manifest ? [...manifest.assets] : [];
+        for (const asset of assetPaths) {
+          routes.push({ path: `/assets/${asset}`, handler: 'asset' });
+        }
+
+        const searchIndexPath = ctx.output.has('search-index.json')
+          ? '/search-index.json'
+          : '';
+
+        const config: DevServerConfig = {
+          port: DEFAULT_PORT,
+          routes,
+          assetPaths,
+          searchIndexPath,
+        };
+
+        ctx.data.set('dev-server-config', config);
+      },
+    },
+  };
+}
diff --git a/src/plugins/markdown-ext.ts b/src/plugins/markdown-ext.ts
new file mode 100644
index 0000000..016a8f9
--- /dev/null
+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,63 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+interface Footnote {
+  id: string;
+  text: string;
+}
+
+/**
+ * markdown-ext: converts Markdown to HTML with two extensions on top of the
+ * standard renderer — footnotes (`[^id]` references + `[^id]: text` definitions)
+ * and admonition containers (`:::note ... :::`).
+ */
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile): ContentFile {
+        let content = file.content;
+
+        // 1. Extract footnote definitions: `[^id]: footnote text`
+        const footnotes: Footnote[] = [];
+        content = content.replace(
+          /^\[\^([^\]]+)\]:[ \t]*(.*)$/gm,
+          (_match, id: string, text: string) => {
+            footnotes.push({ id, text: text.trim() });
+            return '';
+          }
+        );
+
+        // 2. Replace footnote references: `[^id]` -> linked superscript
+        content = content.replace(
+          /\[\^([^\]]+)\]/g,
+          (_match, id: string) => `<sup><a href="#fn-${id}">${id}</a></sup>`
+        );
+
+        // 3. Replace admonition containers: `:::type\n...\n:::`
+        content = content.replace(
+          /^:::(\w+)[ \t]*\n([\s\S]*?)\n:::[ \t]*$/gm,
+          (_match, type: string, inner: string) => {
+            const body = marked.parse(inner.trim()) as string;
+            return `<div class="admonition admonition-${type}">\n${body}\n</div>`;
+          }
+        );
+
+        // 4. Render the remaining Markdown to HTML.
+        let html = marked.parse(content) as string;
+
+        // 5. Append a footnotes section if any definitions were found.
+        if (footnotes.length > 0) {
+          const items = footnotes
+            .map((fn) => `<li id="fn-${fn.id}">${fn.text}</li>`)
+            .join('\n');
+          html += `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
new file mode 100644
index 0000000..1ef05e9
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,67 @@
+import { BuildContext, Plugin } from '../core/types.js';
+
+function escapeXml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+/**
+ * rss-feed: generates an RSS 2.0 `feed.xml` from the built content. Items carry
+ * the rendered HTML content (wrapped in CDATA), category tags, and are sorted
+ * newest-first by date. Depends on markdown-ext (HTML content) and taxonomy.
+ */
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const { baseUrl, title } = ctx.config;
+
+        const sorted = [...ctx.files].sort((a, b) =>
+          (b.date || '').localeCompare(a.date || '')
+        );
+
+        const items = sorted
+          .map((file) => {
+            const link = `${baseUrl}/${file.slug}.html`;
+            const parts = [
+              '    <item>',
+              `      <title>${escapeXml(file.title)}</title>`,
+              `      <link>${link}</link>`,
+              `      <guid>${link}</guid>`,
+              `      <description><![CDATA[${file.content}]]></description>`,
+            ];
+            if (file.date) {
+              parts.push(`      <pubDate>${new Date(file.date).toUTCString()}</pubDate>`);
+            }
+            if (file.tags) {
+              for (const tag of file.tags) {
+                parts.push(`      <category>${escapeXml(tag)}</category>`);
+              }
+            }
+            parts.push('    </item>');
+            return parts.join('\n');
+          })
+          .join('\n');
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(title)}</title>
+    <link>${baseUrl}</link>
+    <description>${escapeXml(title)}</description>
+${items}
+  </channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
diff --git a/src/plugins/search-index.ts b/src/plugins/search-index.ts
new file mode 100644
index 0000000..b6f9876
--- /dev/null
+++ b/src/plugins/search-index.ts
@@ -0,0 +1,51 @@
+import { BuildContext, Plugin } from '../core/types.js';
+
+interface SearchEntry {
+  title: string;
+  slug: string;
+  content: string;
+  tags?: string[];
+}
+
+function htmlToPlainText(html: string): string {
+  return html
+    .replace(/<[^>]*>/g, ' ')
+    .replace(/&amp;/g, '&')
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;/g, "'")
+    .replace(/&apos;/g, "'")
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+/**
+ * search-index: emits `search-index.json`, an array of entries containing each
+ * page's title, slug, plain-text content (HTML stripped, code blocks kept), and
+ * tags. Depends on markdown-ext and syntax-highlight (HTML content is ready).
+ */
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const index: SearchEntry[] = ctx.files.map((file) => {
+          const entry: SearchEntry = {
+            title: file.title,
+            slug: file.slug,
+            content: htmlToPlainText(file.content),
+          };
+          if (file.tags) {
+            entry.tags = file.tags;
+          }
+          return entry;
+        });
+
+        ctx.output.set('search-index.json', JSON.stringify(index, null, 2));
+      },
+    },
+  };
+}
