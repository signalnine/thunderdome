@@ -0,0 +1,26 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+/**
+ * syntax-highlight: annotates fenced code blocks that declare a language
+ * (`<pre><code class="language-X">`) by adding a `highlighted` class to the
+ * code element and a `data-language` attribute to the surrounding `<pre>`.
+ * Blocks without a language and inline `<code>` are left untouched.
+ */
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile): ContentFile {
+        const content = file.content.replace(
+          /<pre><code class="language-([^"]+)">([\s\S]*?)<\/code><\/pre>/g,
+          (_match, lang: string, code: string) =>
+            `<pre data-language="${lang}"><code class="language-${lang} highlighted">${code}</code></pre>`
+        );
+
+        return { ...file, content };
+      },
+    },
+  };
+}
diff --git a/src/plugins/taxonomy.ts b/src/plugins/taxonomy.ts
new file mode 100644
index 0000000..f028504
--- /dev/null
+++ b/src/plugins/taxonomy.ts
@@ -0,0 +1,74 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
+
+/**
+ * taxonomy: builds a tag index (`Map<tag, ContentFile[]>`) from every file's
+ * tags during `beforeBuild`, normalizing tags to lowercase, and emits a
+ * listing page (`tags/<tag>.html`) for each tag during `afterBuild`.
+ */
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild(ctx: BuildContext): void {
+        const tagMap = new Map<string, ContentFile[]>();
+
+        for (const file of ctx.files) {
+          if (!file.tags) continue;
+          for (const rawTag of file.tags) {
+            const tag = rawTag.toLowerCase();
+            const existing = tagMap.get(tag);
+            if (existing) {
+              existing.push(file);
+            } else {
+              tagMap.set(tag, [file]);
+            }
+          }
+        }
+
+        ctx.data.set('taxonomy-tags', tagMap);
+      },
+
+      afterBuild(ctx: BuildContext): void {
+        const tagMap = ctx.data.get('taxonomy-tags') as
+          | Map<string, ContentFile[]>
+          | undefined;
+        if (!tagMap) return;
+
+        for (const [tag, files] of tagMap) {
+          const items = files
+            .map(
+              (file) =>
+                `    <li><a href="/${file.slug}.html">${escapeHtml(file.title)}</a></li>`
+            )
+            .join('\n');
+
+          const page = `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>Posts tagged "${escapeHtml(tag)}" | ${escapeHtml(ctx.config.title)}</title>
+</head>
+<body>
+  <h1>Posts tagged "${escapeHtml(tag)}"</h1>
+  <ul>
+${items}
+  </ul>
+</body>
+</html>`;
+
+          ctx.output.set(`tags/${tag}.html`, page);
+        }
+      },
+    },
+  };
+}
