+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+const ADMONITION_RE = /^:::(\w+)\s*\n([\s\S]*?)\n:::/gm;
+const FOOTNOTE_DEF_RE = /^\[\^([^\]]+)\]:\s*(.*)$/gm;
+const FOOTNOTE_REF_RE = /\[\^([^\]]+)\]/g;
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: async (file: ContentFile): Promise<ContentFile> => {
+        let content = file.content;
+
+        // 1. Extract footnote definitions (e.g. "[^1]: text") before markdown parsing.
+        const footnotes: Array<{ id: string; text: string }> = [];
+        content = content.replace(FOOTNOTE_DEF_RE, (_match, id: string, text: string) => {
+          footnotes.push({ id, text: text.trim() });
+          return '';
+        });
+
+        // 2. Replace inline footnote references with superscript anchors.
+        content = content.replace(FOOTNOTE_REF_RE, (_match, id: string) => {
+          return `<sup><a href="#fn-${id}">${id}</a></sup>`;
+        });
+
+        // 3. Convert admonition containers (:::note ... :::) to admonition divs.
+        content = content.replace(ADMONITION_RE, (_match, type: string, body: string) => {
+          const inner = marked.parse(body.trim(), { async: false }) as string;
+          return `<div class="admonition admonition-${type}">\n${inner}\n</div>`;
+        });
+
+        // 4. Render the remaining markdown to HTML.
+        let html = marked.parse(content, { async: false }) as string;
+
+        // 5. Append the footnote section, if any definitions were found.
+        if (footnotes.length > 0) {
+          const items = footnotes
+            .map(fn => `<li id="fn-${fn.id}">${fn.text}</li>`)
+            .join('\n');
+          html += `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
