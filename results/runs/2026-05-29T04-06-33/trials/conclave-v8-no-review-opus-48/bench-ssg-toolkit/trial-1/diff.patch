@@ -0,0 +1,23 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+// Matches a fenced code block produced as <pre><code class="language-X">.
+const CODE_BLOCK_RE = /<pre><code class="language-([^"]+)">/g;
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        const newContent = file.content.replace(
+          CODE_BLOCK_RE,
+          (_match, lang: string) => {
+            return `<pre data-language="${lang}"><code class="language-${lang} highlighted">`;
+          }
+        );
+        return { ...file, content: newContent };
+      },
+    },
+  };
+}
diff --git a/src/plugins/taxonomy.ts b/src/plugins/taxonomy.ts
