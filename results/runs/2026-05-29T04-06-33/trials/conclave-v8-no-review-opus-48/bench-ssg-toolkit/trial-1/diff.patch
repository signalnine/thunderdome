index 0000000..f167327
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,64 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;');
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const { title, baseUrl } = ctx.config;
+
+        // Sort by date, newest first. Files without dates sort last.
+        const sorted = [...ctx.files].sort((a, b) => {
+          const da = a.date ?? '';
+          const db = b.date ?? '';
+          if (da === db) return 0;
+          if (!da) return 1;
+          if (!db) return -1;
+          return db.localeCompare(da);
+        });
+
+        const items = sorted
+          .map(file => buildItem(file, baseUrl))
+          .join('\n');
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(title)}</title>
+    <link>${baseUrl}</link>
+    <description>${escapeXml(title)}</description>
+${items}
+  </channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
+
+function buildItem(file: ContentFile, baseUrl: string): string {
+  const parts: string[] = [];
+  parts.push('    <item>');
+  parts.push(`      <title>${escapeXml(file.title)}</title>`);
+  parts.push(`      <link>${baseUrl}/${file.slug}.html</link>`);
+  parts.push(`      <guid>${baseUrl}/${file.slug}.html</guid>`);
+  if (file.date) {
+    parts.push(`      <pubDate>${new Date(file.date).toUTCString()}</pubDate>`);
+  }
+  for (const tag of file.tags ?? []) {
+    parts.push(`      <category>${escapeXml(tag)}</category>`);
+  }
+  parts.push(`      <description><![CDATA[${file.content}]]></description>`);
+  parts.push('    </item>');
+  return parts.join('\n');
+}
