+// Three-way structural merge of JSON documents.
+
+import { ABSENT, Maybe, deepClone, deepEqual, isPlainObject } from './util.js';
+import type { Conflict } from './types.js';
+
+/** Convert the ABSENT sentinel to `undefined` for reporting in conflicts. */
+function report(value: Maybe<unknown>): unknown {
+  return value === ABSENT ? undefined : value;
+}
+
+/**
+ * Recursively merge a single value across base/ours/theirs.
+ * Returns the merged value, or ABSENT if the key/document should not exist.
+ * Pushes any conflicts (with dot-separated paths) into `conflicts`.
+ */
+export function mergeValue(
+  base: Maybe<unknown>,
+  ours: Maybe<unknown>,
+  theirs: Maybe<unknown>,
+  path: string,
+  documentId: string,
+  conflicts: Conflict[],
+): Maybe<unknown> {
+  // Both sides agree (covers: unchanged, both-deleted, both-changed-to-same).
+  if (deepEqual(ours, theirs)) return ours;
+  // Only theirs diverged from base -> take theirs.
+  if (deepEqual(base, ours)) return theirs;
+  // Only ours diverged from base -> keep ours.
+  if (deepEqual(base, theirs)) return ours;
+
+  // Both sides changed differently. If all three are plain objects we can
+  // descend key-by-key; otherwise this is an irreconcilable conflict.
+  if (isPlainObject(base) && isPlainObject(ours) && isPlainObject(theirs)) {
+    const result: Record<string, unknown> = {};
+    const keys = new Set<string>([
+      ...Object.keys(base),
+      ...Object.keys(ours),
+      ...Object.keys(theirs),
+    ]);
+    for (const key of keys) {
+      const childPath = path ? `${path}.${key}` : key;
+      const merged = mergeValue(
+        keyOf(base, key),
+        keyOf(ours, key),
+        keyOf(theirs, key),
+        childPath,
+        documentId,
+        conflicts,
+      );
+      if (merged !== ABSENT) result[key] = merged;
+    }
+    return result;
+  }
+
+  conflicts.push({
+    documentId,
+    path,
+    base: report(base),
+    ours: report(ours),
+    theirs: report(theirs),
+  });
+  // For the "what would it look like" merged view, ours wins.
+  return ours;
+}
+
+function keyOf(obj: Record<string, unknown>, key: string): Maybe<unknown> {
+  return Object.prototype.hasOwnProperty.call(obj, key) ? obj[key] : ABSENT;
+}
+
+export interface DocumentMergeResult {
+  /** documentId -> merged content (documents that resolve to ABSENT are omitted). */
+  merged: Record<string, object>;
+  conflicts: Conflict[];
+}
+
+/**
+ * Merge whole document sets given the common-ancestor snapshot (base),
+ * the current branch (ours) and the source branch (theirs).
+ */
+export function mergeDocumentSets(
+  base: Map<string, object>,
+  ours: Map<string, object>,
+  theirs: Map<string, object>,
+): DocumentMergeResult {
+  const conflicts: Conflict[] = [];
+  const merged: Record<string, object> = {};
+
+  const ids = new Set<string>([...base.keys(), ...ours.keys(), ...theirs.keys()]);
+  for (const id of ids) {
+    const result = mergeValue(
+      base.has(id) ? (base.get(id) as unknown) : ABSENT,
+      ours.has(id) ? (ours.get(id) as unknown) : ABSENT,
+      theirs.has(id) ? (theirs.get(id) as unknown) : ABSENT,
+      '',
+      id,
+      conflicts,
+    );
+    if (result !== ABSENT) {
+      merged[id] = deepClone(result) as object;
+    }
+  }
+
+  return { merged, conflicts };
+}
