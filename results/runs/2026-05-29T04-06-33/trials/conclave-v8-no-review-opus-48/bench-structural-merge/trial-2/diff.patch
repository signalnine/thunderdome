+import { describe, it, expect, beforeEach } from 'vitest';
+import { DocumentStore } from './index.js';
+
+describe('Document CRUD', () => {
+  let store: DocumentStore;
+  beforeEach(() => {
+    store = new DocumentStore();
+  });
+
+  it('creates and gets a document', () => {
+    store.create('a', { x: 1 });
+    expect(store.get('a')).toEqual({ x: 1 });
+  });
+
+  it('throws when creating a duplicate id', () => {
+    store.create('a', { x: 1 });
+    expect(() => store.create('a', { y: 2 })).toThrow();
+  });
+
+  it('throws when getting a non-existent doc', () => {
+    expect(() => store.get('nope')).toThrow();
+  });
+
+  it('throws when getting a deleted doc', () => {
+    store.create('a', { x: 1 });
+    store.delete('a');
+    expect(() => store.get('a')).toThrow();
+  });
+
+  it('get returns a deep clone (mutation-safe)', () => {
+    store.create('a', { nested: { v: 1 } });
+    const got = store.get('a') as { nested: { v: number } };
+    got.nested.v = 999;
+    expect(store.get('a')).toEqual({ nested: { v: 1 } });
+  });
+
+  it('create stores a deep clone of the input', () => {
+    const input = { nested: { v: 1 } };
+    store.create('a', input);
+    input.nested.v = 999;
+    expect(store.get('a')).toEqual({ nested: { v: 1 } });
+  });
+
+  it('updates an existing doc', () => {
+    store.create('a', { x: 1 });
+    store.update('a', { x: 2, y: 3 });
+    expect(store.get('a')).toEqual({ x: 2, y: 3 });
+  });
+
+  it('update stores a deep clone of the input', () => {
+    store.create('a', { x: 1 });
+    const input = { nested: { v: 5 } };
+    store.update('a', input);
+    input.nested.v = 0;
+    expect(store.get('a')).toEqual({ nested: { v: 5 } });
+  });
+
+  it('throws when updating a non-existent doc', () => {
+    expect(() => store.update('a', { x: 1 })).toThrow();
+  });
+
+  it('deletes a doc', () => {
+    store.create('a', { x: 1 });
+    store.delete('a');
+    expect(() => store.get('a')).toThrow();
+  });
+
+  it('throws when deleting a non-existent doc', () => {
+    expect(() => store.delete('a')).toThrow();
+  });
+});
+
+describe('Version history', () => {
+  let store: DocumentStore;
+  beforeEach(() => {
+    store = new DocumentStore();
+  });
+
+  it('records a version on create', () => {
+    store.create('a', { x: 1 });
+    expect(store.getHistory('a')).toHaveLength(1);
+  });
+
+  it('adds a version per update, oldest first', () => {
+    store.create('a', { x: 1 });
