+import { deepClone, deepEqual } from './util.js';
+import { mergeDocumentSets } from './merge.js';
+import type { MergeResult, Version } from './types.js';
+
+export type { Conflict, MergeResult, Version } from './types.js';
+
+/**
+ * A commit in the version DAG. Each create/update/delete/applied-merge produces
+ * one commit holding a full snapshot of the branch's documents. Used to locate
+ * the three-way merge base (lowest common ancestor) between two branches.
+ */
+interface Commit {
+  id: string;
+  order: number; // monotonically increasing creation index, used to pick the LCA
+  parents: string[];
+  snapshot: Map<string, object>; // documentId -> content (deep-cloned)
+}
+
+interface Branch {
+  name: string;
+  head: string; // commit id
+  docs: Map<string, object>; // current working state (deep-cloned)
+  histories: Map<string, Version[]>; // per-document version history
+}
+
+export class DocumentStore {
+  private branches = new Map<string, Branch>();
+  private commits = new Map<string, Commit>();
+  private current: string;
+  private counter = 0;
+
+  constructor() {
+    const root = this.newCommit([], new Map());
+    const main: Branch = {
+      name: 'main',
+      head: root.id,
+      docs: new Map(),
+      histories: new Map(),
+    };
+    this.branches.set('main', main);
+    this.current = 'main';
+  }
+
+  // ---- id / commit helpers ------------------------------------------------
+
+  private nextId(prefix: string): string {
+    this.counter += 1;
+    return `${prefix}_${this.counter}`;
+  }
+
+  private newCommit(parents: string[], docs: Map<string, object>): Commit {
+    const snapshot = new Map<string, object>();
+    for (const [id, content] of docs) snapshot.set(id, deepClone(content));
+    const commit: Commit = {
+      id: this.nextId('c'),
+      order: this.counter, // counter was just bumped by nextId
+      parents,
+      snapshot,
+    };
+    this.commits.set(commit.id, commit);
+    return commit;
+  }
+
+  /** Record the current branch state as a new commit and advance HEAD. */
+  private commitBranch(branch: Branch, parents?: string[]): void {
+    const commit = this.newCommit(parents ?? [branch.head], branch.docs);
+    branch.head = commit.id;
+  }
+
+  private branchOrThrow(name: string): Branch {
+    const branch = this.branches.get(name);
+    if (!branch) throw new Error(`Branch "${name}" does not exist`);
+    return branch;
+  }
+
+  private get cur(): Branch {
+    return this.branchOrThrow(this.current);
+  }
+
+  private addVersion(branch: Branch, id: string, content: object): void {
+    let history = branch.histories.get(id);
+    if (!history) {
+      history = [];
+      branch.histories.set(id, history);
+    }
+    history.push({
+      id: this.nextId('v'),
+      timestamp: Date.now(),
+      content: deepClone(content),
+    });
+  }
+
+  // ---- Document CRUD ------------------------------------------------------
+
+  create(id: string, content: object): void {
+    const branch = this.cur;
+    if (branch.docs.has(id)) {
+      throw new Error(`Document "${id}" already exists on branch "${branch.name}"`);
+    }
+    const stored = deepClone(content);
+    branch.docs.set(id, stored);
+    this.addVersion(branch, id, stored);
+    this.commitBranch(branch);
+  }
+
+  get(id: string): object {
+    const branch = this.cur;
+    if (!branch.docs.has(id)) {
+      throw new Error(`Document "${id}" does not exist on branch "${branch.name}"`);
+    }
+    return deepClone(branch.docs.get(id)!);
+  }
+
+  update(id: string, content: object): void {
+    const branch = this.cur;
+    if (!branch.docs.has(id)) {
+      throw new Error(`Document "${id}" does not exist on branch "${branch.name}"`);
+    }
+    const stored = deepClone(content);
+    branch.docs.set(id, stored);
+    this.addVersion(branch, id, stored);
+    this.commitBranch(branch);
+  }
+
+  delete(id: string): void {
+    const branch = this.cur;
+    if (!branch.docs.has(id)) {
+      throw new Error(`Document "${id}" does not exist on branch "${branch.name}"`);
+    }
+    branch.docs.delete(id);
+    this.commitBranch(branch);
+  }
+
+  // ---- Version history ----------------------------------------------------
+
+  getHistory(id: string): Version[] {
+    const branch = this.cur;
+    const history = branch.histories.get(id);
+    if (!history) {
+      throw new Error(`No history for document "${id}" on branch "${branch.name}"`);
+    }
+    return history.map((v) => ({ ...v, content: deepClone(v.content) }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const branch = this.cur;
+    const history = branch.histories.get(id);
+    const version = history?.find((v) => v.id === versionId);
+    if (!version) {
+      throw new Error(`Version "${versionId}" of document "${id}" not found`);
+    }
+    return deepClone(version.content);
+  }
+
+  // ---- Branching ----------------------------------------------------------
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const source = this.branchOrThrow(fromBranch ?? this.current);
+    const docs = new Map<string, object>();
+    for (const [id, content] of source.docs) docs.set(id, deepClone(content));
+    const histories = new Map<string, Version[]>();
+    for (const [id, versions] of source.histories) {
+      histories.set(
+        id,
+        versions.map((v) => ({ ...v, content: deepClone(v.content) })),
+      );
+    }
+    // Share the source HEAD commit so it becomes the divergence point / merge base.
+    this.branches.set(name, { name, head: source.head, docs, histories });
+  }
+
+  switchBranch(name: string): void {
+    this.branchOrThrow(name);
+    this.current = name;
+  }
+
+  getBranch(): string {
+    return this.current;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  // ---- Merging ------------------------------------------------------------
+
+  merge(sourceBranch: string): MergeResult {
+    const ours = this.cur;
+    const theirs = this.branchOrThrow(sourceBranch);
+    if (theirs.name === ours.name) {
+      throw new Error('Cannot merge a branch into itself');
+    }
+
+    const baseCommit = this.mergeBase(ours.head, theirs.head);
+    const baseDocs = baseCommit ? baseCommit.snapshot : new Map<string, object>();
+
+    const { merged, conflicts } = mergeDocumentSets(baseDocs, ours.docs, theirs.docs);
+    const applied = conflicts.length === 0;
+
+    if (applied) {
+      this.applyMerge(ours, merged, theirs.head);
+    }
+
+    return { merged, conflicts, applied };
+  }
+
+  /** Apply a clean merge result to the current branch and create a merge commit. */
+  private applyMerge(
+    branch: Branch,
+    merged: Record<string, object>,
+    sourceHead: string,
+  ): void {
+    let changed = false;
+    const ids = new Set<string>([...branch.docs.keys(), ...Object.keys(merged)]);
+    for (const id of ids) {
+      const before = branch.docs.get(id);
+      const after = merged[id];
+      if (after === undefined) {
+        if (before !== undefined) {
+          branch.docs.delete(id);
+          changed = true;
+        }
+        continue;
+      }
+      if (before === undefined || !deepEqual(before, after)) {
+        const stored = deepClone(after);
+        branch.docs.set(id, stored);
+        this.addVersion(branch, id, stored);
+        changed = true;
+      }
+    }
+    if (changed) {
+      this.commitBranch(branch, [branch.head, sourceHead]);
+    }
+  }
+
+  /**
+   * Lowest common ancestor of two commits in the DAG: among all shared
+   * ancestors, the one created most recently (highest order index).
+   */
+  private mergeBase(a: string, b: string): Commit | undefined {
+    const ancestorsA = this.ancestors(a);
+    const ancestorsB = this.ancestors(b);
+    let best: Commit | undefined;
+    for (const id of ancestorsA) {
+      if (!ancestorsB.has(id)) continue;
+      const commit = this.commits.get(id)!;
+      if (!best || commit.order > best.order) best = commit;
+    }
+    return best;
+  }
+
+  private ancestors(start: string): Set<string> {
+    const seen = new Set<string>();
+    const stack = [start];
+    while (stack.length) {
+      const id = stack.pop()!;
+      if (seen.has(id)) continue;
+      seen.add(id);
+      const commit = this.commits.get(id);
+      if (commit) stack.push(...commit.parents);
+    }
+    return seen;
+  }
+}
+
+export default DocumentStore;
