nt = 'main';\n  }\n\n  // ---- id / commit helpers ------------------------------------------------\n\n  private nextId(prefix: string): string {\n    this.counter += 1;\n    return `${prefix}_${this.counter}`;\n  }\n\n  private newCommit(parents: string[], docs: Map<string, object>): Commit {\n    const snapshot = new Map<string, object>();\n    for (const [id, content] of docs) snapshot.set(id, deepClone(content));\n    const commit: Commit = {\n      id: this.nextId('c'),\n      order: this.counter, // counter was just bumped by nextId\n      parents,\n      snapshot,\n    };\n    this.commits.set(commit.id, commit);\n    return commit;\n  }\n\n  /** Record the current branch state as a new commit and advance HEAD. */\n  private commitBranch(branch: Branch, parents?: string[]): void {\n    const commit = this.newCommit(parents ?? [branch.head], branch.docs);\n    branch.head = commit.id;\n  }\n\n  private branchOrThrow(name: string): Branch {\n    const branch = this.branches.get(name);\n    if (!branch) throw new Error(`Branch \"${name}\" does not exist`);\n    return branch;\n  }\n\n  private get cur(): Branch {\n    return this.branchOrThrow(this.current);\n  }\n\n  private addVersion(branch: Branch, id: string, content: object): void {\n    let history = branch.histories.get(id);\n    if (!history) {\n      history = [];\n      branch.histories.set(id, history);\n    }\n    history.push({\n      id: this.nextId('v'),\n      timestamp: Date.now(),\n      content: deepClone(content),\n    });\n  }\n\n  // ---- Document CRUD ------------------------------------------------------\n\n  create(id: string, content: object): void {\n    const branch = this.cur;\n    if (branch.docs.has(id)) {\n      throw new Error(`Document \"${id}\" already exists on branch \"${branch.name}\"`);\n    }\n    const stored = deepClone(content);\n    branch.docs.set(id, stored);\n    this.addVersion(branch, id, stored);\n    this.commitBranch(branch);\n  }\n\n  get(id: string): object 