d, deepClone(content));\n    const histories = new Map<string, Version[]>();\n    for (const [id, versions] of source.histories) {\n      histories.set(\n        id,\n        versions.map((v) => ({ ...v, content: deepClone(v.content) })),\n      );\n    }\n    // Share the source HEAD commit so it becomes the divergence point / merge base.\n    this.branches.set(name, { name, head: source.head, docs, histories });\n  }\n\n  switchBranch(name: string): void {\n    this.branchOrThrow(name);\n    this.current = name;\n  }\n\n  getBranch(): string {\n    return this.current;\n  }\n\n  listBranches(): string[] {\n    return [...this.branches.keys()];\n  }\n\n  // ---- Merging ------------------------------------------------------------\n\n  merge(sourceBranch: string): MergeResult {\n    const ours = this.cur;\n    const theirs = this.branchOrThrow(sourceBranch);\n    if (theirs.name === ours.name) {\n      throw new Error('Cannot merge a branch into itself');\n    }\n\n    const baseCommit = this.mergeBase(ours.head, theirs.head);\n    const baseDocs = baseCommit ? baseCommit.snapshot : new Map<string, object>();\n\n    const { merged, conflicts } = mergeDocumentSets(baseDocs, ours.docs, theirs.docs);\n    const applied = conflicts.length === 0;\n\n    if (applied) {\n      this.applyMerge(ours, merged, theirs.head);\n    }\n\n    return { merged, conflicts, applied };\n  }\n\n  /** Apply a clean merge result to the current branch and create a merge commit. */\n  private applyMerge(\n    branch: Branch,\n    merged: Record<string, object>,\n    sourceHead: string,\n  ): void {\n    let changed = false;\n    const ids = new Set<string>([...branch.docs.keys(), ...Object.keys(merged)]);\n    for (const id of ids) {\n      const before = branch.docs.get(id);\n      const after = merged[id];\n      if (after === undefined) {\n        if (before !== undefined) {\n          branch.docs.delete(id);\n          changed = true;\n        }\n        continue;\n      }\n      if (bef