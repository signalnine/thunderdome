+import { describe, it, expect } from 'vitest';
+import { DocumentStore } from './index';
+
+describe('Documents (CRUD)', () => {
+  it('create stores a doc and get returns it', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+
+  it('create throws if id already exists', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    expect(() => s.create('a', { x: 2 })).toThrow();
+  });
+
+  it('create is allowed after delete', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.delete('a');
+    expect(() => s.create('a', { x: 2 })).not.toThrow();
+    expect(s.get('a')).toEqual({ x: 2 });
+  });
+
+  it('get returns a deep clone (no external mutation)', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: { y: 1 } });
+    const got = s.get('a') as { x: { y: number } };
+    got.x.y = 999;
+    expect(s.get('a')).toEqual({ x: { y: 1 } });
+  });
+
+  it('stored content is deep-cloned on write', () => {
+    const s = new DocumentStore();
+    const input = { x: { y: 1 } };
+    s.create('a', input);
+    input.x.y = 999;
+    expect(s.get('a')).toEqual({ x: { y: 1 } });
+  });
+
+  it('get throws for unknown doc', () => {
+    const s = new DocumentStore();
+    expect(() => s.get('nope')).toThrow();
+  });
+
+  it('get throws for deleted doc', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.delete('a');
+    expect(() => s.get('a')).toThrow();
+  });
+
+  it('update replaces content', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.update('a', { x: 2, z: 3 });
+    expect(s.get('a')).toEqual({ x: 2, z: 3 });
+  });
+
+  it('update throws for unknown doc', () => {
+    const s = new DocumentStore();
+    expect(() => s.update('a', { x: 1 })).toThrow();
+  });
+
+  it('update throws for deleted doc', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.delete('a');
+    expect(() => s.update('a', { x: 2 })).toThrow();
+  });
+
+  it('delete removes doc', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.delete('a');
+    expect(() => s.get('a')).toThrow();
+  });
+
+  it('delete throws for unknown doc', () => {
+    const s = new DocumentStore();
+    expect(() => s.delete('a')).toThrow();
+  });
+
+  it('delete throws if already deleted', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.delete('a');
+    expect(() => s.delete('a')).toThrow();
+  });
+});
+
+describe('Version history', () => {
+  it('create generates one version with id, timestamp, content', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    const h = s.getHistory('a');
+    expect(h).toHaveLength(1);
+    expect(typeof h[0].id).toBe('string');
+    expect(typeof h[0].timestamp).toBe('number');
+    expect(h[0].content).toEqual({ x: 1 });
+  });
+
+  it('update generates new versions, oldest first, unique ids', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.update('a', { x: 2 });
+    s.update('a', { x: 3 });
+    const h = s.getHistory('a');
+    expect(h).toHaveLength(3);
+    expect(h.map((v) => (v.content as { x: number }).x)).toEqual([1, 2, 3]);
+    const ids = new Set(h.map((v) => v.id));
+    expect(ids.size).toBe(3);
+    for (let i = 1; i < h.length; i++) {
+      expect(h[i].timestamp).toBeGreaterThanOrEqual(h[i - 1].timestamp);
+    }
+  });
+
+  it('getHistory throws for unknown doc', () => {
+    const s = new DocumentStore();
+    expect(() => s.getHistory('nope')).toThrow();
+  });
+
+  it('getVersion returns historical content', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.update('a', { x: 2 });
+    const h = s.getHistory('a');
+    expect(s.getVersion('a', h[0].id)).toEqual({ x: 1 });
+    expect(s.getVersion('a', h[1].id)).toEqual({ x: 2 });
+  });
+
+  it('getVersion returns a deep clone', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: { y: 1 } });
+    const h = s.getHistory('a');
+    const v = s.getVersion('a', h[0].id) as { x: { y: number } };
+    v.x.y = 999;
+    expect(s.getVersion('a', h[0].id)).toEqual({ x: { y: 1 } });
+  });
+
+  it('getVersion throws for unknown version', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    expect(() => s.getVersion('a', 'no-such-version')).toThrow();
+  });
+});
+
+describe('Branching', () => {
+  it('default branch is main', () => {
+    const s = new DocumentStore();
+    expect(s.getBranch()).toBe('main');
+  });
+
+  it('createBranch branches from current state', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+
+  it('createBranch with fromBranch uses that branch', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 99 });
+    // current branch is feature, but branch from main:
+    s.createBranch('fromMain', 'main');
+    s.switchBranch('fromMain');
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+
+  it('createBranch throws on duplicate', () => {
+    const s = new DocumentStore();
+    s.createBranch('feature');
+    expect(() => s.createBranch('feature')).toThrow();
+  });
+
+  it('switchBranch throws on unknown', () => {
+    const s = new DocumentStore();
+    expect(() => s.switchBranch('nope')).toThrow();
+  });
+
+  it('CRUD applies only to active branch; isolation', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 2 });
+    s.create('b', { y: 1 });
+    s.switchBranch('main');
+    expect(s.get('a')).toEqual({ x: 1 });
+    expect(() => s.get('b')).toThrow();
+  });
+
+  it('listBranches lists all branches', () => {
+    const s = new DocumentStore();
+    s.createBranch('feature');
+    s.createBranch('other');
+    expect(s.listBranches().sort()).toEqual(['feature', 'main', 'other']);
+  });
+});
+
+describe('Merging (three-way)', () => {
+  it('no changes on either side -> no-op, applied, no conflicts', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.createBranch('feature');
+    const r = s.merge('feature');
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.applied).toBe(true);
+  });
+
+  it('only source changed a field -> take theirs', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1, y: 2 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 1, y: 5 });
+    s.switchBranch('main');
+    const r = s.merge('feature');
+    expect(r.applied).toBe(true);
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.merged.a).toEqual({ x: 1, y: 5 });
+    expect(s.get('a')).toEqual({ x: 1, y: 5 });
+  });
+
+  it('only ours changed a field -> keep ours', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1, y: 2 });
+    s.createBranch('feature');
+    s.update('a', { x: 9, y: 2 }); // change on main (ours)
+    const r = s.merge('feature');
+    expect(r.applied).toBe(true);
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.merged.a).toEqual({ x: 9, y: 2 });
+  });
+
+  it('both changed same field to same value -> no conflict', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 7 });
+    s.switchBranch('main');
+    s.update('a', { x: 7 });
+    const r = s.merge('feature');
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.applied).toBe(true);
+    expect(r.merged.a).toEqual({ x: 7 });
+  });
+
+  it('both changed same field differently -> conflict, not applied, current unchanged', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 2 });
+    s.switchBranch('main');
+    s.update('a', { x: 3 });
+    const r = s.merge('feature');
+    expect(r.applied).toBe(false);
+    expect(r.conflicts).toHaveLength(1);
+    expect(r.conflicts[0]).toMatchObject({
+      documentId: 'a',
+      path: 'x',
+      base: 1,
+      ours: 3,
+      theirs: 2,
+    });
+    // merged shows ours-resolution
+    expect(r.merged.a).toEqual({ x: 3 });
+    // current branch unchanged
+    expect(s.get('a')).toEqual({ x: 3 });
+  });
+
+  it('nested non-conflicting changes combine; conflict path is dotted', () => {
+    const s = new DocumentStore();
+    s.create('a', { cfg: { color: 'red', size: 10 }, name: 'doc' });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { cfg: { color: 'blue', size: 10 }, name: 'doc' });
+    s.switchBranch('main');
+    s.update('a', { cfg: { color: 'red', size: 20 }, name: 'doc' });
+    const r = s.merge('feature');
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.applied).toBe(true);
+    expect(r.merged.a).toEqual({ cfg: { color: 'blue', size: 20 }, name: 'doc' });
+  });
+
+  it('nested conflict reports dot-separated path', () => {
+    const s = new DocumentStore();
+    s.create('a', { cfg: { color: 'red' } });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { cfg: { color: 'blue' } });
+    s.switchBranch('main');
+    s.update('a', { cfg: { color: 'green' } });
+    const r = s.merge('feature');
+    expect(r.applied).toBe(false);
+    expect(r.conflicts).toHaveLength(1);
+    expect(r.conflicts[0].path).toBe('cfg.color');
+  });
+
+  it('different docs on different branches merge cleanly', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.create('b', { y: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 2 }); // change a on feature
+    s.switchBranch('main');
+    s.update('b', { y: 2 }); // change b on main
+    const r = s.merge('feature');
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.applied).toBe(true);
+    expect(s.get('a')).toEqual({ x: 2 });
+    expect(s.get('b')).toEqual({ y: 2 });
+  });
+
+  it('added field on one side only is taken', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 1, added: true });
+    s.switchBranch('main');
+    const r = s.merge('feature');
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.merged.a).toEqual({ x: 1, added: true });
+  });
+
+  it('deleted field on one side (other unchanged) is removed', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1, y: 2 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 1 }); // removed y
+    s.switchBranch('main');
+    const r = s.merge('feature');
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.merged.a).toEqual({ x: 1 });
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+
+  it('doc created only on source appears in merged & applied', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.create('b', { y: 1 });
+    s.switchBranch('main');
+    const r = s.merge('feature');
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.merged.b).toEqual({ y: 1 });
+    expect(s.get('b')).toEqual({ y: 1 });
+  });
+
+  it('doc deleted on source (unchanged on ours) is removed on merge', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.create('b', { y: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.delete('b');
+    s.switchBranch('main');
+    const r = s.merge('feature');
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.applied).toBe(true);
+    expect(r.merged.b).toBeUndefined();
+    expect(() => s.get('b')).toThrow();
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+
+  it('merge throws if sourceBranch unknown', () => {
+    const s = new DocumentStore();
+    expect(() => s.merge('nope')).toThrow();
+  });
+
+  it('arrays treated atomically -> different arrays conflict', () => {
+    const s = new DocumentStore();
+    s.create('a', { list: [1, 2, 3] });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { list: [1, 2, 4] });
+    s.switchBranch('main');
+    s.update('a', { list: [1, 2, 5] });
+    const r = s.merge('feature');
+    expect(r.applied).toBe(false);
+    expect(r.conflicts).toHaveLength(1);
+    expect(r.conflicts[0].path).toBe('list');
+  });
+
+  it('same array change on both sides -> no conflict', () => {
+    const s = new DocumentStore();
+    s.create('a', { list: [1, 2, 3] });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { list: [9] });
+    s.switchBranch('main');
+    s.update('a', { list: [9] });
+    const r = s.merge('feature');
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.merged.a).toEqual({ list: [9] });
+  });
+
+  it('finds correct LCA across branch/merge topology', () => {
+    // main: a={x:0}
+    // create feature from main, both evolve, merge feature->main (clean),
+    // then create feature2 from main, change disjoint fields, merge clean.
+    const s = new DocumentStore();
+    s.create('a', { x: 0, y: 0, z: 0 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 1, y: 0, z: 0 }); // feature changes x
+    s.switchBranch('main');
+    s.update('a', { x: 0, y: 1, z: 0 }); // main changes y
+    const r1 = s.merge('feature');
+    expect(r1.conflicts).toHaveLength(0);
+    expect(s.get('a')).toEqual({ x: 1, y: 1, z: 0 });
+
+    // Now branch again and change z only; merge should be clean using new base.
+    s.createBranch('feature2');
+    s.switchBranch('feature2');
+    s.update('a', { x: 1, y: 1, z: 5 });
+    s.switchBranch('main');
+    const r2 = s.merge('feature2');
+    expect(r2.conflicts).toHaveLength(0);
+    expect(s.get('a')).toEqual({ x: 1, y: 1, z: 5 });
+  });
+
+  it('merge result merged field is a clone (no store mutation)', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 2 });
+    s.switchBranch('main');
+    const r = s.merge('feature');
+    (r.merged.a as { x: number }).x = 999;
+    expect(s.get('a')).toEqual({ x: 2 });
+  });
+
+  it('deep nested multi-field merge', () => {
+    const s = new DocumentStore();
+    s.create('a', { a: { b: { c: 1, d: 1 }, e: 1 } });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { a: { b: { c: 2, d: 1 }, e: 1 } }); // change c
+    s.switchBranch('main');
+    s.update('a', { a: { b: { c: 1, d: 1 }, e: 9 } }); // change e
+    const r = s.merge('feature');
+    expect(r.conflicts).toHaveLength(0);
+    expect(r.merged.a).toEqual({ a: { b: { c: 2, d: 1 }, e: 9 } });
+  });
+});
