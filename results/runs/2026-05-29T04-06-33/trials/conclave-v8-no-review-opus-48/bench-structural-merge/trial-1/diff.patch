+++ b/src/index.ts
@@ -0,0 +1,506 @@
+/**
+ * In-memory versioned document store with three-way structural merge.
+ * "Git for JSON documents."
+ */
+
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+export interface Conflict {
+  documentId: string;
+  path: string; // dot-separated JSON path, e.g. "a.b.c"
+  base: unknown;
+  ours: unknown;
+  theirs: unknown;
+}
+
+export interface MergeResult {
+  merged: Record<string, object>; // documentId -> merged content
+  conflicts: Conflict[];
+  applied: boolean;
+}
+
+// ---------------------------------------------------------------------------
+// Internal helpers
+// ---------------------------------------------------------------------------
+
+const cloneFn: <T>(value: T) => T =
+  typeof (globalThis as { structuredClone?: unknown }).structuredClone === 'function'
+    ? (value) => (globalThis as { structuredClone: <U>(v: U) => U }).structuredClone(value)
+    : (value) => JSON.parse(JSON.stringify(value));
+
+function clone<T>(value: T): T {
+  if (value === undefined || value === null) return value;
+  return cloneFn(value);
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (a === null || b === null) return a === b;
+  if (typeof a !== typeof b) return false;
+
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b)) return false;
+    if (a.length !== b.length) return false;
+    for (let i = 0; i < a.length; i++) {
+      if (!deepEqual(a[i], b[i])) return false;
+    }
+    return true;
+  }
+
+  if (typeof a === 'object') {
+    const ao = a as Record<string, unknown>;
+    const bo = b as Record<string, unknown>;
+    const aKeys = Object.keys(ao);
+    const bKeys = Object.keys(bo);
+    if (aKeys.length !== bKeys.length) return false;
+    for (const k of aKeys) {
+      if (!Object.prototype.hasOwnProperty.call(bo, k)) return false;
+      if (!deepEqual(ao[k], bo[k])) return false;
+    }
+    return true;
+  }
+
+  return false;
+}
+
+// ---------------------------------------------------------------------------
+// Internal data structures
+// ---------------------------------------------------------------------------
+
+interface DocState {
+  deleted: boolean;
+  content: object | null;
+  versions: Version[];
+}
+
+interface Commit {
+  id: string;
+  index: number;
+  parents: string[];
+  timestamp: number;
+  // Full snapshot of existing document contents at this commit.
+  snapshot: Map<string, object>;
+}
+
+interface Branch {
+  name: string;
+  head: string | null;
+  docs: Map<string, DocState>;
+}
+
+// ---------------------------------------------------------------------------
+// DocumentStore
+// ---------------------------------------------------------------------------
+
+export class DocumentStore {
+  private branches = new Map<string, Branch>();
+  private commits = new Map<string, Commit>();
+  private current: string;
+
+  private versionCounter = 0;
+  private commitCounter = 0;
+  private lastTimestamp = 0;
+
+  constructor() {
+    this.branches.set('main', { name: 'main', head: null, docs: new Map() });
+    this.current = 'main';
+  }
+
+  // --- timing / id helpers -------------------------------------------------
+
+  private nextTimestamp(): number {
+    let ts = Date.now();
+    if (ts <= this.lastTimestamp) ts = this.lastTimestamp + 1;
+    this.lastTimestamp = ts;
+    return ts;
+  }
+
+  private nextVersionId(): string {
+    this.versionCounter += 1;
+    return `v${this.versionCounter}`;
+  }
+
+  private nextCommitId(): string {
+    this.commitCounter += 1;
+    return `c${this.commitCounter}`;
+  }
+
+  private branchOrThrow(name: string): Branch {
+    const b = this.branches.get(name);
+    if (!b) throw new Error(`Branch "${name}" does not exist`);
+    return b;
+  }
+
+  private currentBranch(): Branch {
+    return this.branchOrThrow(this.current);
+  }
+
+  /** Build a snapshot map (docId -> content clone) from a branch's live docs. */
+  private snapshotOf(branch: Branch): Map<string, object> {
+    const snap = new Map<string, object>();
+    for (const [id, state] of branch.docs) {
+      if (!state.deleted && state.content !== null) {
+        snap.set(id, clone(state.content));
+      }
+    }
+    return snap;
+  }
+
+  /** Record a new commit on a branch, capturing its current state. */
+  private commit(branch: Branch, parents: string[]): void {
+    const id = this.nextCommitId();
+    const commit: Commit = {
+      id,
+      index: this.commitCounter,
+      parents: parents.filter((p): p is string => p !== null),
+      timestamp: this.nextTimestamp(),
+      snapshot: this.snapshotOf(branch),
+    };
+    this.commits.set(id, commit);
+    branch.head = id;
+  }
+
+  // --- Document CRUD -------------------------------------------------------
+
+  create(id: string, content: object): void {
+    const branch = this.currentBranch();
+    const existing = branch.docs.get(id);
+    if (existing && !existing.deleted) {
+      throw new Error(`Document "${id}" already exists`);
+    }
+    const stored = clone(content);
+    const version: Version = {
+      id: this.nextVersionId(),
+      timestamp: this.nextTimestamp(),
+      content: clone(content),
+    };
+    if (existing) {
+      // Re-create after delete: keep prior history, append new version.
+      existing.deleted = false;
+      existing.content = stored;
+      existing.versions.push(version);
+    } else {
+      branch.docs.set(id, { deleted: false, content: stored, versions: [version] });
+    }
+    this.commit(branch, [branch.head as string]);
+  }
+
+  get(id: string): object {
+    const branch = this.currentBranch();
+    const state = branch.docs.get(id);
+    if (!state || state.deleted || state.content === null) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    return clone(state.content);
+  }
+
+  update(id: string, content: object): void {
+    const branch = this.currentBranch();
+    const state = branch.docs.get(id);
+    if (!state || state.deleted || state.content === null) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    state.content = clone(content);
+    state.versions.push({
+      id: this.nextVersionId(),
+      timestamp: this.nextTimestamp(),
+      content: clone(content),
+    });
+    this.commit(branch, [branch.head as string]);
+  }
+
+  delete(id: string): void {
+    const branch = this.currentBranch();
+    const state = branch.docs.get(id);
+    if (!state || state.deleted) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    state.deleted = true;
+    state.content = null;
+    this.commit(branch, [branch.head as string]);
+  }
+
+  // --- Version history -----------------------------------------------------
+
+  getHistory(id: string): Version[] {
+    const branch = this.currentBranch();
+    const state = branch.docs.get(id);
+    if (!state) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    return state.versions.map((v) => ({
+      id: v.id,
+      timestamp: v.timestamp,
+      content: clone(v.content),
+    }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const branch = this.currentBranch();
+    const state = branch.docs.get(id);
+    if (!state) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    const version = state.versions.find((v) => v.id === versionId);
+    if (!version) {
+      throw new Error(`Version "${versionId}" of document "${id}" does not exist`);
+    }
+    return clone(version.content);
+  }
+
+  // --- Branching -----------------------------------------------------------
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const source = this.branchOrThrow(fromBranch ?? this.current);
+    const docs = new Map<string, DocState>();
+    for (const [id, state] of source.docs) {
+      docs.set(id, {
+        deleted: state.deleted,
+        content: state.content === null ? null : clone(state.content),
+        versions: state.versions.map((v) => ({
+          id: v.id,
+          timestamp: v.timestamp,
+          content: clone(v.content),
+        })),
+      });
+    }
+    this.branches.set(name, { name, head: source.head, docs });
+  }
+
+  switchBranch(name: string): void {
+    this.branchOrThrow(name);
+    this.current = name;
+  }
+
+  getBranch(): string {
+    return this.current;
+  }
+
+  listBranches(): string[] {
+    return Array.from(this.branches.keys());
+  }
+
+  // --- Merging -------------------------------------------------------------
+
+  merge(sourceBranch: string): MergeResult {
+    const source = this.branchOrThrow(sourceBranch);
+    const target = this.currentBranch();
+
+    if (source.name === target.name) {
+      // Merging a branch into itself: nothing to do.
+      return { merged: this.existingContents(target), conflicts: [], applied: true };
+    }
+
+    const baseSnapshot = this.mergeBaseSnapshot(target.head, source.head);
+
+    const docIds = new Set<string>();
+    for (const id of baseSnapshot.keys()) docIds.add(id);
+    for (const id of this.existingIds(target)) docIds.add(id);
+    for (const id of this.existingIds(source)) docIds.add(id);
+
+    const conflicts: Conflict[] = [];
+    const merged: Record<string, object> = {};
+    // mergedStates: docId -> content (object) or undefined (absent/deleted)
+    const mergedStates = new Map<string, object | undefined>();
+
+    for (const id of docIds) {
+      const base = baseSnapshot.has(id) ? baseSnapshot.get(id) : undefined;
+      const ours = this.contentOf(target, id);
+      const theirs = this.contentOf(source, id);
+
+      const result = this.mergeValue(base, ours, theirs, '', id, conflicts);
+      mergedStates.set(id, result as object | undefined);
+      if (result !== undefined) {
+        merged[id] = result as object;
+      }
+    }
+
+    const applied = conflicts.length === 0;
+
+    if (applied && target.head !== source.head) {
+      this.applyMerge(target, source, mergedStates);
+    }
+
+    return { merged, conflicts, applied };
+  }
+
+  // --- merge internals -----------------------------------------------------
+
+  private existingIds(branch: Branch): string[] {
+    const ids: string[] = [];
+    for (const [id, state] of branch.docs) {
+      if (!state.deleted && state.content !== null) ids.push(id);
+    }
+    return ids;
+  }
+
+  private existingContents(branch: Branch): Record<string, object> {
+    const out: Record<string, object> = {};
+    for (const id of this.existingIds(branch)) {
+      out[id] = clone(branch.docs.get(id)!.content as object);
+    }
+    return out;
+  }
+
+  private contentOf(branch: Branch, id: string): unknown {
+    const state = branch.docs.get(id);
+    if (!state || state.deleted || state.content === null) return undefined;
+    return state.content;
+  }
+
+  /**
+   * Three-way merge of a single value. Returns the merged value.
+   * `undefined` signals "absent" (key/document removed). Conflicts are pushed
+   * into `conflicts`, and conflicting values resolve in favour of `ours`.
+   */
+  private mergeValue(
+    base: unknown,
+    ours: unknown,
+    theirs: unknown,
+    path: string,
+    docId: string,
+    conflicts: Conflict[],
+  ): unknown {
+    if (deepEqual(ours, theirs)) {
+      return clone(ours);
+    }
+    if (deepEqual(base, ours)) {
+      // Only theirs changed.
+      return clone(theirs);
+    }
+    if (deepEqual(base, theirs)) {
+      // Only ours changed.
+      return clone(ours);
+    }
+
+    // Both sides changed, differently.
+    if (isPlainObject(ours) && isPlainObject(theirs)) {
+      const baseObj = isPlainObject(base) ? base : undefined;
+      const result: Record<string, unknown> = {};
+      const keys = new Set<string>([...Object.keys(ours), ...Object.keys(theirs)]);
+      for (const key of keys) {
+        const childPath = path === '' ? key : `${path}.${key}`;
+        const bv = baseObj ? baseObj[key] : undefined;
+        const child = this.mergeValue(bv, ours[key], theirs[key], childPath, docId, conflicts);
+        if (child !== undefined) {
+          result[key] = child;
+        }
+      }
+      return result;
+    }
+
+    // Scalar / array / type-mismatch conflict.
+    conflicts.push({
+      documentId: docId,
+      path,
+      base: clone(base),
+      ours: clone(ours),
+      theirs: clone(theirs),
+    });
+    return clone(ours);
+  }
+
+  /** Apply a conflict-free merge result to the target branch in place. */
+  private applyMerge(
+    target: Branch,
+    source: Branch,
+    mergedStates: Map<string, object | undefined>,
+  ): void {
+    for (const [id, mergedContent] of mergedStates) {
+      const state = target.docs.get(id);
+      const exists = !!state && !state.deleted && state.content !== null;
+
+      if (mergedContent === undefined) {
+        // Document should be absent in the merged result.
+        if (exists) {
+          state!.deleted = true;
+          state!.content = null;
+        }
+        continue;
+      }
+
+      if (!exists) {
+        // New document on target.
+        const version: Version = {
+          id: this.nextVersionId(),
+          timestamp: this.nextTimestamp(),
+          content: clone(mergedContent),
+        };
+        if (state) {
+          state.deleted = false;
+          state.content = clone(mergedContent);
+          state.versions.push(version);
+        } else {
+          target.docs.set(id, {
+            deleted: false,
+            content: clone(mergedContent),
+            versions: [version],
+          });
+        }
+      } else if (!deepEqual(state!.content, mergedContent)) {
+        state!.content = clone(mergedContent);
+        state!.versions.push({
+          id: this.nextVersionId(),
+          timestamp: this.nextTimestamp(),
+          content: clone(mergedContent),
+        });
+      }
+    }
+
+    this.commit(target, [target.head as string, source.head as string]);
+  }
+
+  /** Snapshot of the lowest common ancestor of two commits. */
+  private mergeBaseSnapshot(a: string | null, b: string | null): Map<string, object> {
+    if (a === null || b === null) return new Map();
+
+    const ancestorsA = this.ancestors(a);
+    const ancestorsB = this.ancestors(b);
+
+    let best: Commit | null = null;
+    for (const id of ancestorsA) {
+      if (!ancestorsB.has(id)) continue;
+      const commit = this.commits.get(id);
+      if (!commit) continue;
+      if (best === null || commit.index > best.index) {
+        best = commit;
+      }
+    }
+
+    if (!best) return new Map();
+    // Return a clone so callers can't mutate the stored snapshot.
+    const snap = new Map<string, object>();
+    for (const [id, content] of best.snapshot) {
+      snap.set(id, clone(content));
+    }
+    return snap;
+  }
+
+  private ancestors(start: string): Set<string> {
+    const seen = new Set<string>();
+    const stack = [start];
+    while (stack.length > 0) {
+      const id = stack.pop()!;
+      if (seen.has(id)) continue;
+      seen.add(id);
+      const commit = this.commits.get(id);
+      if (commit) {
+        for (const p of commit.parents) stack.push(p);
+      }
+    }
+    return seen;
+  }
+}
+
+export default DocumentStore;
