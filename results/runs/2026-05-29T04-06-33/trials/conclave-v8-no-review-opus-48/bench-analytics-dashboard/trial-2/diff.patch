diff --git a/src/routes/auth.ts b/src/routes/auth.ts
new file mode 100644
index 0000000..a902a44
--- /dev/null
+++ b/src/routes/auth.ts
@@ -0,0 +1,139 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import {
+  authenticate,
+  hashPassword,
+  signToken,
+  verifyPassword,
+  type AuthRequest,
+  type Role,
+} from '../auth.js';
+
+const ROLES: Role[] = ['admin', 'editor', 'viewer'];
+
+interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: Role;
+  created_at: string;
+}
+
+function publicUser(row: UserRow) {
+  return {
+    id: row.id,
+    email: row.email,
+    tenantId: row.tenant_id,
+    role: row.role,
+    createdAt: row.created_at,
+  };
+}
+
+export function authRouter(): Router {
+  const router = Router();
+
+  // Register
+  router.post('/auth/register', (req, res) => {
+    const db = (req as AuthRequest).db;
+    const { email, password, tenantId, role } = req.body ?? {};
+
+    if (typeof email !== 'string' || !email.trim() || typeof password !== 'string' || !password) {
+      res.status(400).json({ error: 'email and password are required' });
+      return;
+    }
+    if (role !== undefined && !ROLES.includes(role)) {
+      res.status(400).json({ error: 'invalid role' });
+      return;
+    }
+
+    const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(email);
+    if (existing) {
+      res.status(409).json({ error: 'email already registered' });
+      return;
+    }
+
+    // No tenantId => start a brand-new tenant and become its admin.
+    const newTenant = typeof tenantId !== 'string' || !tenantId.trim();
+    const resolvedTenant = newTenant ? uuidv4() : tenantId;
+    const resolvedRole: Role = role ?? (newTenant ? 'admin' : 'viewer');
+
+    const id = uuidv4();
+    db.prepare(
+      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)',
+    ).run(id, email, hashPassword(password), resolvedTenant, resolvedRole);
+
+    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow;
+    const user = publicUser(row);
+    const token = signToken({ id: user.id, email: user.email, tenantId: user.tenantId, role: user.role });
+    res.status(201).json({ token, user });
+  });
+
+  // Login
+  router.post('/auth/login', (req, res) => {
+    const db = (req as AuthRequest).db;
+    const { email, password } = req.body ?? {};
+    if (typeof email !== 'string' || typeof password !== 'string') {
+      res.status(400).json({ error: 'email and password are required' });
+      return;
+    }
+    const row = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as UserRow | undefined;
+    if (!row || !verifyPassword(password, row.password_hash)) {
+      res.status(401).json({ error: 'invalid credentials' });
+      return;
+    }
+    const user = publicUser(row);
+    const token = signToken({ id: user.id, email: user.email, tenantId: user.tenantId, role: user.role });
+    res.status(200).json({ token, user });
+  });
+
+  // Own profile
+  router.get('/me', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(auth.id) as UserRow | undefined;
+    if (!row) {
+      res.status(404).json({ error: 'user not found' });
+      return;
+    }
+    res.status(200).json({ user: publicUser(row) });
+  });
+
+  // List users in own tenant
+  router.get('/users', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const rows = db
+      .prepare('SELECT * FROM users WHERE tenant_id = ? ORDER BY created_at')
+      .all(auth.tenantId) as UserRow[];
+    res.status(200).json({ users: rows.map(publicUser) });
+  });
+
+  // Admin changes a user's role within their tenant
+  router.patch('/users/:id/role', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const { role } = req.body ?? {};
+
+    if (auth.role !== 'admin') {
+      res.status(403).json({ error: 'admin role required' });
+      return;
+    }
+    if (!ROLES.includes(role)) {
+      res.status(400).json({ error: 'invalid role' });
+      return;
+    }
+    const target = db.prepare('SELECT * FROM users WHERE id = ?').get(req.params.id) as
+      | UserRow
+      | undefined;
+    if (!target || target.tenant_id !== auth.tenantId) {
+      res.status(404).json({ error: 'user not found' });
+      return;
+    }
+    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);
+    const updated = db.prepare('SELECT * FROM users WHERE id = ?').get(target.id) as UserRow;
+    res.status(200).json({ user: publicUser(updated) });
+  });
+
+  return router;
+}
