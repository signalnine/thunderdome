@@ -0,0 +1,106 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { authenticate, type AuthRequest } from '../auth.js';
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+function publicDashboard(row: DashboardRow) {
+  return {
+    id: row.id,
+    tenantId: row.tenant_id,
+    name: row.name,
+    ownerId: row.owner_id,
+    config: JSON.parse(row.config) as unknown,
+    createdAt: row.created_at,
+    updatedAt: row.updated_at,
+  };
+}
+
+export function dashboardsRouter(): Router {
+  const router = Router();
+
+  router.post('/dashboards', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const { name, config } = req.body ?? {};
+    if (typeof name !== 'string' || !name.trim()) {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+    const id = uuidv4();
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)',
+    ).run(id, auth.tenantId, name, auth.id, JSON.stringify(config ?? {}));
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+    res.status(201).json({ dashboard: publicDashboard(row) });
+  });
+
+  router.get('/dashboards', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const rows = db
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at')
+      .all(auth.tenantId) as DashboardRow[];
+    res.status(200).json({ dashboards: rows.map(publicDashboard) });
+  });
+
+  router.get('/dashboards/:id', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(req.params.id) as
+      | DashboardRow
+      | undefined;
+    if (!row || row.tenant_id !== auth.tenantId) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    res.status(200).json({ dashboard: publicDashboard(row) });
+  });
+
+  const update = (req: AuthRequest, res: import('express').Response): void => {
+    const db = req.db;
+    const auth = req.user!;
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(req.params.id) as
+      | DashboardRow
+      | undefined;
+    if (!row || row.tenant_id !== auth.tenantId) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    const { name, config } = req.body ?? {};
+    const nextName = typeof name === 'string' && name.trim() ? name : row.name;
+    const nextConfig = config !== undefined ? JSON.stringify(config) : row.config;
+    db.prepare(
+      `UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?`,
+    ).run(nextName, nextConfig, row.id);
+    const updated = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(row.id) as DashboardRow;
+    res.status(200).json({ dashboard: publicDashboard(updated) });
+  };
+
+  router.put('/dashboards/:id', authenticate, (req, res) => update(req as AuthRequest, res));
+  router.patch('/dashboards/:id', authenticate, (req, res) => update(req as AuthRequest, res));
+
+  router.delete('/dashboards/:id', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(req.params.id) as
+      | DashboardRow
+      | undefined;
+    if (!row || row.tenant_id !== auth.tenantId) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(row.id);
+    res.status(204).end();
+  });
+
+  return router;
+}
diff --git a/src/routes/events.ts b/src/routes/events.ts
new file mode 100644
index 0000000..d3d0b53
--- /dev/null
+++ b/src/routes/events.ts
@@ -0,0 +1,102 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { authenticate, type AuthRequest } from '../auth.js';
+
+interface IncomingEvent {
+  name?: unknown;
+  properties?: unknown;
+  timestamp?: unknown;
+  sessionId?: unknown;
+}
+
+function normalizeTimestamp(value: unknown): string {
+  if (typeof value === 'string' && value.trim()) return value;
+  if (typeof value === 'number') return new Date(value).toISOString();
+  return new Date().toISOString();
+}
+
+function serializeProperties(value: unknown): string {
+  if (value && typeof value === 'object') return JSON.stringify(value);
+  return '{}';
+}
+
+export function eventsRouter(): Router {
+  const router = Router();
+
+  router.post('/events', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const body = (req.body ?? {}) as IncomingEvent;
+
+    if (typeof body.name !== 'string' || !body.name.trim()) {
+      res.status(400).json({ error: 'event name is required' });
+      return;
+    }
+
+    const id = uuidv4();
+    const timestamp = normalizeTimestamp(body.timestamp);
+    db.prepare(
+      `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+       VALUES (?, ?, ?, ?, ?, ?, ?)`,
+    ).run(
+      id,
+      auth.tenantId,
+      body.name,
+      serializeProperties(body.properties),
+      timestamp,
+      auth.id,
+      typeof body.sessionId === 'string' ? body.sessionId : null,
+    );
+
+    res.status(201).json({
+      event: {
+        id,
+        tenantId: auth.tenantId,
+        name: body.name,
+        properties: body.properties ?? {},
+        timestamp,
+        userId: auth.id,
+      },
+    });
+  });
+
+  router.post('/events/batch', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const events = (req.body ?? {}).events;
+
+    if (!Array.isArray(events)) {
+      res.status(400).json({ error: 'events array is required' });
+      return;
+    }
+    for (const ev of events as IncomingEvent[]) {
+      if (typeof ev?.name !== 'string' || !ev.name.trim()) {
+        res.status(400).json({ error: 'each event requires a name' });
+        return;
+      }
+    }
+
+    const insert = db.prepare(
+      `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+       VALUES (?, ?, ?, ?, ?, ?, ?)`,
+    );
+    const insertMany = db.transaction((items: IncomingEvent[]) => {
+      for (const ev of items) {
+        insert.run(
+          uuidv4(),
+          auth.tenantId,
+          ev.name,
+          serializeProperties(ev.properties),
+          normalizeTimestamp(ev.timestamp),
+          auth.id,
+          typeof ev.sessionId === 'string' ? ev.sessionId : null,
+        );
+      }
+    });
+    insertMany(events as IncomingEvent[]);
+
+    res.status(201).json({ count: events.length });
+  });
+
+  return router;
+}
diff --git a/src/routes/export.ts b/src/routes/export.ts
new file mode 100644
index 0000000..f6dd676
--- /dev/null
+++ b/src/routes/export.ts
@@ -0,0 +1,117 @@
+import { Router } from 'express';
+import { authenticate, type AuthRequest } from '../auth.js';
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+function csvCell(value: unknown): string {
+  const str = value === null || value === undefined ? '' : String(value);
+  if (/[",\n\r]/.test(str)) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+function toCsv(headers: string[], rows: unknown[][]): string {
+  const lines = [headers.map(csvCell).join(',')];
+  for (const row of rows) {
+    lines.push(row.map(csvCell).join(','));
+  }
+  return lines.join('\n');
+}
+
+function formatOf(req: AuthRequest): string {
+  const fmt = req.query.format;
+  return typeof fmt === 'string' ? fmt.toLowerCase() : 'json';
+}
+
+export function exportRouter(): Router {
+  const router = Router();
+
+  router.get('/export/events', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const fmt = formatOf(req as AuthRequest);
+    const rows = db
+      .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp')
+      .all(auth.tenantId) as EventRow[];
+
+    if (fmt === 'csv') {
+      const csv = toCsv(
+        ['id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'],
+        rows.map((r) => [r.id, r.name, r.properties, r.timestamp, r.user_id, r.session_id]),
+      );
+      res.status(200).type('text/csv').attachment('events.csv').send(csv);
+      return;
+    }
+    if (fmt !== 'json') {
+      res.status(400).json({ error: 'format must be json or csv' });
+      return;
+    }
+    res.status(200).json(
+      rows.map((r) => ({
+        id: r.id,
+        tenantId: r.tenant_id,
+        name: r.name,
+        properties: JSON.parse(r.properties) as unknown,
+        timestamp: r.timestamp,
+        userId: r.user_id,
+        sessionId: r.session_id,
+      })),
+    );
+  });
+
+  router.get('/export/dashboards/:id', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const fmt = formatOf(req as AuthRequest);
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(req.params.id) as
+      | DashboardRow
+      | undefined;
+    if (!row || row.tenant_id !== auth.tenantId) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+
+    if (fmt === 'csv') {
+      const csv = toCsv(
+        ['id', 'name', 'owner_id', 'config', 'created_at', 'updated_at'],
+        [[row.id, row.name, row.owner_id, row.config, row.created_at, row.updated_at]],
+      );
+      res.status(200).type('text/csv').attachment(`dashboard-${row.id}.csv`).send(csv);
+      return;
+    }
+    if (fmt !== 'json') {
+      res.status(400).json({ error: 'format must be json or csv' });
+      return;
+    }
+    res.status(200).json({
+      id: row.id,
+      tenantId: row.tenant_id,
+      name: row.name,
+      ownerId: row.owner_id,
+      config: JSON.parse(row.config) as unknown,
+      createdAt: row.created_at,
+      updatedAt: row.updated_at,
+    });
+  });
+
+  return router;
+}
diff --git a/src/routes/query.ts b/src/routes/query.ts
new file mode 100644
index 0000000..f7125aa
--- /dev/null
+++ b/src/routes/query.ts
@@ -0,0 +1,109 @@
+import { Router } from 'express';
+import { authenticate, type AuthRequest } from '../auth.js';
+
+interface QueryBody {
+  name?: unknown;
+  from?: unknown;
+  to?: unknown;
+  filters?: unknown;
+  interval?: unknown;
+  property?: unknown;
+}
+
+interface WhereResult {
+  clause: string;
+  params: unknown[];
+}
+
+const INTERVAL_FORMATS: Record<string, string> = {
+  hour: '%Y-%m-%dT%H:00',
+  day: '%Y-%m-%d',
+  week: '%Y-%W',
+  month: '%Y-%m',
+};
+
+// Builds a WHERE clause scoped to the tenant plus optional name / time / property filters.
+function buildWhere(tenantId: string, body: QueryBody): WhereResult {
+  const clauses: string[] = ['tenant_id = ?'];
+  const params: unknown[] = [tenantId];
+
+  if (typeof body.name === 'string' && body.name.trim()) {
+    clauses.push('name = ?');
+    params.push(body.name);
+  }
+  if (typeof body.from === 'string' && body.from.trim()) {
+    clauses.push('timestamp >= ?');
+    params.push(body.from);
+  }
+  if (typeof body.to === 'string' && body.to.trim()) {
+    clauses.push('timestamp <= ?');
+    params.push(body.to);
+  }
+  if (body.filters && typeof body.filters === 'object') {
+    for (const [key, value] of Object.entries(body.filters as Record<string, unknown>)) {
+      clauses.push(`json_extract(properties, '$.' || ?) = ?`);
+      params.push(key, value as string | number);
+    }
+  }
+
+  return { clause: clauses.join(' AND '), params };
+}
+
+export function queryRouter(): Router {
+  const router = Router();
+
+  router.post('/query/count', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const { clause, params } = buildWhere(auth.tenantId, (req.body ?? {}) as QueryBody);
+    const row = db
+      .prepare(`SELECT COUNT(*) AS count FROM events WHERE ${clause}`)
+      .get(...params) as { count: number };
+    res.status(200).json({ count: row.count });
+  });
+
+  router.post('/query/timeseries', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const body = (req.body ?? {}) as QueryBody;
+    const interval = typeof body.interval === 'string' ? body.interval : 'day';
+    const fmt = INTERVAL_FORMATS[interval];
+    if (!fmt) {
+      res.status(400).json({ error: `invalid interval; use one of ${Object.keys(INTERVAL_FORMATS).join(', ')}` });
+      return;
+    }
+    const { clause, params } = buildWhere(auth.tenantId, body);
+    const rows = db
+      .prepare(
+        `SELECT strftime('${fmt}', timestamp) AS bucket, COUNT(*) AS count
+         FROM events WHERE ${clause}
+         GROUP BY bucket ORDER BY bucket`,
+      )
+      .all(...params) as { bucket: string; count: number }[];
+    res.status(200).json({ interval, buckets: rows });
+  });
+
+  router.post('/query/breakdown', authenticate, (req, res) => {
+    const db = (req as AuthRequest).db;
+    const auth = (req as AuthRequest).user!;
+    const body = (req.body ?? {}) as QueryBody;
+    if (typeof body.property !== 'string' || !body.property.trim()) {
+      res.status(400).json({ error: 'property is required' });
+      return;
+    }
+    const { clause, params } = buildWhere(auth.tenantId, body);
+    const rows = db
+      .prepare(
+        `SELECT json_extract(properties, '$.' || ?) AS value, COUNT(*) AS count
+         FROM events WHERE ${clause}
+         GROUP BY value ORDER BY count DESC`,
+      )
+      .all(body.property, ...params) as { value: string | null; count: number }[];
+    res.status(200).json({
+      property: body.property,
+      breakdown: rows.map((r) => ({ value: r.value, count: r.count })),
+    });
+  });
+
+  return router;
+}
