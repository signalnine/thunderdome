known>[]);\n      res.status(200).type('text/csv').attachment('events.csv').send(csv);\n      return;\n    }\n\n    const events = rows.map((r) => ({\n      id: r.id,\n      tenantId: r.tenant_id,\n      name: r.name,\n      properties: JSON.parse(r.properties),\n      timestamp: r.timestamp,\n      userId: r.user_id,\n      sessionId: r.session_id,\n    }));\n    res.status(200).type('application/json').send(JSON.stringify({ events }));\n  });\n\n  router.get('/dashboards/:id', (req, res) => {\n    const row = db\n      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')\n      .get(req.params.id, req.user!.tenantId) as DashboardRow | undefined;\n    if (!row) {\n      res.status(404).json({ error: 'dashboard not found' });\n      return;\n    }\n    const format = (req.query.format as string) ?? 'json';\n    if (format === 'csv') {\n      const columns = ['id', 'tenant_id', 'name', 'owner_id', 'config', 'created_at', 'updated_at'];\n      const csv = toCsv(columns, [row as unknown as Record<string, unknown>]);\n      res.status(200).type('text/csv').attachment(`dashboard-${row.id}.csv`).send(csv);\n      return;\n    }\n    res.status(200).type('application/json').send(\n      JSON.stringify({\n        dashboard: {\n          id: row.id,\n          tenantId: row.tenant_id,\n          name: row.name,\n          ownerId: row.owner_id,\n          config: JSON.parse(row.config),\n          createdAt: row.created_at,\n          updatedAt: row.updated_at,\n        },\n      }),\n    );\n  });\n\n  return router;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1480,"cache_read_input_tokens":36956,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1480},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"26245a82-4995-49