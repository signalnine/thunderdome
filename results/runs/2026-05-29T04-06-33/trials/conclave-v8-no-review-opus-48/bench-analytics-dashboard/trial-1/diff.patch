diff --git a/src/queries.ts b/src/queries.ts
new file mode 100644
index 0000000..3946787
--- /dev/null
+++ b/src/queries.ts
@@ -0,0 +1,123 @@
+import type { DB } from './db.js';
+
+export interface QueryFilter {
+  /** Event name to match. */
+  name?: string;
+  /** Property equality filters, e.g. { url: '/home' } matched against the JSON properties. */
+  properties?: Record<string, string | number | boolean>;
+  /** Inclusive lower bound on timestamp (ISO or 'YYYY-MM-DD HH:MM:SS'). */
+  from?: string;
+  /** Exclusive upper bound on timestamp. */
+  to?: string;
+}
+
+interface BuiltWhere {
+  clause: string;
+  params: unknown[];
+}
+
+/** Build a parameterized WHERE clause that always scopes to a tenant. */
+function buildWhere(tenantId: string, filter: QueryFilter): BuiltWhere {
+  const conditions: string[] = ['tenant_id = ?'];
+  const params: unknown[] = [tenantId];
+
+  if (filter.name !== undefined) {
+    conditions.push('name = ?');
+    params.push(filter.name);
+  }
+  if (filter.from !== undefined) {
+    conditions.push('timestamp >= ?');
+    params.push(filter.from);
+  }
+  if (filter.to !== undefined) {
+    conditions.push('timestamp < ?');
+    params.push(filter.to);
+  }
+  if (filter.properties) {
+    for (const [key, value] of Object.entries(filter.properties)) {
+      conditions.push('json_extract(properties, ?) = ?');
+      params.push(`$.${key}`, value as string | number | boolean);
+    }
+  }
+
+  return { clause: conditions.join(' AND '), params };
+}
+
+export function countEvents(db: DB, tenantId: string, filter: QueryFilter): number {
+  const { clause, params } = buildWhere(tenantId, filter);
+  const row = db
+    .prepare(`SELECT COUNT(*) AS count FROM events WHERE ${clause}`)
+    .get(...params) as { count: number };
+  return row.count;
+}
+
+export type Interval = 'hour' | 'day' | 'week' | 'month';
+
+const STRFTIME_FORMAT: Record<Interval, string> = {
+  hour: '%Y-%m-%dT%H:00',
+  day: '%Y-%m-%d',
+  week: '%Y-W%W',
+  month: '%Y-%m',
+};
+
+export interface TimeseriesBucket {
+  bucket: string;
+  count: number;
+}
+
+export function timeseries(
+  db: DB,
+  tenantId: string,
+  filter: QueryFilter,
+  interval: Interval,
+): TimeseriesBucket[] {
+  const { clause, params } = buildWhere(tenantId, filter);
+  const fmt = STRFTIME_FORMAT[interval];
+  const rows = db
+    .prepare(
+      `SELECT strftime(?, timestamp) AS bucket, COUNT(*) AS count
+       FROM events WHERE ${clause}
+       GROUP BY bucket ORDER BY bucket ASC`,
+    )
+    .all(fmt, ...params) as TimeseriesBucket[];
+  return rows;
+}
+
+export interface BreakdownRow {
+  value: string | null;
+  count: number;
+}
+
+export function breakdown(
+  db: DB,
+  tenantId: string,
+  property: string,
+  filter: QueryFilter,
+): BreakdownRow[] {
+  const { clause, params } = buildWhere(tenantId, filter);
+  const rows = db
+    .prepare(
+      `SELECT json_extract(properties, ?) AS value, COUNT(*) AS count
+       FROM events WHERE ${clause}
+       GROUP BY value ORDER BY count DESC`,
+    )
+    .all(`$.${property}`, ...params) as BreakdownRow[];
+  return rows;
+}
+
+export interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+export function listEvents(db: DB, tenantId: string, filter: QueryFilter): EventRow[] {
+  const { clause, params } = buildWhere(tenantId, filter);
+  return db
+    .prepare(`SELECT * FROM events WHERE ${clause} ORDER BY timestamp ASC`)
+    .all(...params) as EventRow[];
+}
