+++ b/src/db.ts
@@ -0,0 +1,34 @@
+import Database from 'better-sqlite3';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+/**
+ * Locate schema.sql. It lives at the project root next to package.json.
+ * After compilation this file is in dist/, at runtime in src/ (tests), so we
+ * walk up from this module's directory until we find it.
+ */
+function loadSchema(): string {
+  const candidates = [
+    join(__dirname, '..', 'schema.sql'),
+    join(__dirname, '..', '..', 'schema.sql'),
+    join(process.cwd(), 'schema.sql'),
+  ];
+  for (const path of candidates) {
+    try {
+      return readFileSync(path, 'utf-8');
+    } catch {
+      // try next candidate
+    }
+  }
+  throw new Error('schema.sql not found');
+}
+
+export type DB = Database.Database;
+
+export function createDb(dbPath = ':memory:'): DB {
+  const db = new Database(dbPath);
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+  db.exec(loadSchema());
+  return db;
+}
