+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import type { DB } from '../db.js';
+import { authenticate } from '../auth.js';
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+function publicDashboard(row: DashboardRow) {
+  return {
+    id: row.id,
+    tenantId: row.tenant_id,
+    name: row.name,
+    ownerId: row.owner_id,
+    config: JSON.parse(row.config),
+    createdAt: row.created_at,
+    updatedAt: row.updated_at,
+  };
+}
+
+export function dashboardsRouter(db: DB): Router {
+  const router = Router();
+  router.use(authenticate);
+
+  router.post('/', (req, res) => {
+    const { name, config } = req.body ?? {};
+    if (typeof name !== 'string' || !name) {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+    const id = uuidv4();
+    const configJson = config !== undefined ? JSON.stringify(config) : '{}';
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)',
+    ).run(id, req.user!.tenantId, name, req.user!.id, configJson);
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+    res.status(201).json({ dashboard: publicDashboard(row) });
+  });
+
+  router.get('/', (req, res) => {
+    const rows = db
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at ASC')
+      .all(req.user!.tenantId) as DashboardRow[];
+    res.status(200).json({ dashboards: rows.map(publicDashboard) });
+  });
+
+  router.get('/:id', (req, res) => {
+    const row = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.user!.tenantId) as DashboardRow | undefined;
+    if (!row) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    res.status(200).json({ dashboard: publicDashboard(row) });
+  });
+
+  router.put('/:id', (req, res) => {
+    const existing = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.user!.tenantId) as DashboardRow | undefined;
+    if (!existing) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    const { name, config } = req.body ?? {};
+    const newName = typeof name === 'string' && name ? name : existing.name;
+    const newConfig = config !== undefined ? JSON.stringify(config) : existing.config;
+    db.prepare(
+      "UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?",
+    ).run(newName, newConfig, existing.id);
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(existing.id) as DashboardRow;
+    res.status(200).json({ dashboard: publicDashboard(row) });
+  });
+
+  router.delete('/:id', (req, res) => {
+    const info = db
+      .prepare('DELETE FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .run(req.params.id, req.user!.tenantId);
+    if (info.changes === 0) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    res.status(204).end();
+  });
+
+  return router;
+}
diff --git a/src/routes/events.ts b/src/routes/events.ts
new file mode 100644
index 0000000..3e3a151
--- /dev/null
+++ b/src/routes/events.ts
@@ -0,0 +1,92 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import type { DB } from '../db.js';
+import { authenticate } from '../auth.js';
+
+interface IncomingEvent {
+  name?: unknown;
+  properties?: unknown;
+  timestamp?: unknown;
+  sessionId?: unknown;
+}
+
+interface PreparedEvent {
+  id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  sessionId: string | null;
+}
+
+/** Normalize a raw event payload, returning null if invalid. */
+function prepareEvent(raw: IncomingEvent, now: string): PreparedEvent | null {
+  if (typeof raw?.name !== 'string' || raw.name.length === 0) return null;
+  let properties = '{}';
+  if (raw.properties !== undefined && raw.properties !== null) {
+    if (typeof raw.properties !== 'object' || Array.isArray(raw.properties)) return null;
+    properties = JSON.stringify(raw.properties);
+  }
+  const timestamp = typeof raw.timestamp === 'string' && raw.timestamp ? raw.timestamp : now;
+  const sessionId = typeof raw.sessionId === 'string' ? raw.sessionId : null;
+  return { id: uuidv4(), name: raw.name, properties, timestamp, sessionId };
+}
+
+export function eventsRouter(db: DB): Router {
+  const router = Router();
+  router.use(authenticate);
+
+  const insert = db.prepare(
+    `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+     VALUES (?, ?, ?, ?, ?, ?, ?)`,
+  );
+
+  router.post('/', (req, res) => {
+    const now = new Date().toISOString().replace('T', ' ').slice(0, 19);
+    const prepared = prepareEvent(req.body ?? {}, now);
+    if (!prepared) {
+      res.status(400).json({ error: 'event name is required' });
+      return;
+    }
+    const { tenantId, id: userId } = req.user!;
+    insert.run(prepared.id, tenantId, prepared.name, prepared.properties, prepared.timestamp, userId, prepared.sessionId);
+    res.status(201).json({
+      event: {
+        id: prepared.id,
+        tenantId,
+        name: prepared.name,
+        properties: JSON.parse(prepared.properties),
+        timestamp: prepared.timestamp,
+        userId,
+        sessionId: prepared.sessionId,
+      },
+    });
+  });
+
+  router.post('/batch', (req, res) => {
+    const events = (req.body ?? {}).events;
+    if (!Array.isArray(events) || events.length === 0) {
+      res.status(400).json({ error: 'events must be a non-empty array' });
+      return;
+    }
+    const now = new Date().toISOString().replace('T', ' ').slice(0, 19);
+    const prepared: PreparedEvent[] = [];
+    for (const raw of events) {
+      const p = prepareEvent(raw, now);
+      if (!p) {
+        res.status(400).json({ error: 'every event must have a name and valid properties' });
+        return;
+      }
+      prepared.push(p);
+    }
+    const { tenantId, id: userId } = req.user!;
+    const insertMany = db.transaction((items: PreparedEvent[]) => {
+      for (const p of items) {
+        insert.run(p.id, tenantId, p.name, p.properties, p.timestamp, userId, p.sessionId);
+      }
+    });
+    insertMany(prepared);
+    res.status(201).json({ count: prepared.length, ids: prepared.map((p) => p.id) });
+  });
+
+  return router;
+}
