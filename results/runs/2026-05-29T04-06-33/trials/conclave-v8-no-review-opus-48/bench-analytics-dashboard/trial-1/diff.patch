@@ -0,0 +1,97 @@
+import { Router } from 'express';
+import type { DB } from '../db.js';
+import { authenticate } from '../auth.js';
+import { listEvents, type EventRow, type QueryFilter } from '../queries.js';
+
+/** Escape a single CSV field per RFC 4180. */
+function csvField(value: unknown): string {
+  const str = value === null || value === undefined ? '' : String(value);
+  if (/[",\n\r]/.test(str)) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+/** Render rows of records to CSV given an ordered set of columns. */
+function toCsv(columns: string[], rows: Record<string, unknown>[]): string {
+  const lines = [columns.map(csvField).join(',')];
+  for (const row of rows) {
+    lines.push(columns.map((c) => csvField(row[c])).join(','));
+  }
+  return lines.join('\n');
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export function exportRouter(db: DB): Router {
+  const router = Router();
+  router.use(authenticate);
+
+  router.get('/events', (req, res) => {
+    const format = (req.query.format as string) ?? 'json';
+    const filter: QueryFilter = {};
+    if (typeof req.query.name === 'string') filter.name = req.query.name;
+    if (typeof req.query.from === 'string') filter.from = req.query.from;
+    if (typeof req.query.to === 'string') filter.to = req.query.to;
+
+    const rows: EventRow[] = listEvents(db, req.user!.tenantId, filter);
+
+    if (format === 'csv') {
+      const columns = ['id', 'tenant_id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'];
+      const csv = toCsv(columns, rows as unknown as Record<string, unknown>[]);
+      res.status(200).type('text/csv').attachment('events.csv').send(csv);
+      return;
+    }
+
+    const events = rows.map((r) => ({
+      id: r.id,
+      tenantId: r.tenant_id,
+      name: r.name,
+      properties: JSON.parse(r.properties),
+      timestamp: r.timestamp,
+      userId: r.user_id,
+      sessionId: r.session_id,
+    }));
+    res.status(200).type('application/json').send(JSON.stringify({ events }));
+  });
+
+  router.get('/dashboards/:id', (req, res) => {
+    const row = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.user!.tenantId) as DashboardRow | undefined;
+    if (!row) {
+      res.status(404).json({ error: 'dashboard not found' });
+      return;
+    }
+    const format = (req.query.format as string) ?? 'json';
+    if (format === 'csv') {
+      const columns = ['id', 'tenant_id', 'name', 'owner_id', 'config', 'created_at', 'updated_at'];
+      const csv = toCsv(columns, [row as unknown as Record<string, unknown>]);
+      res.status(200).type('text/csv').attachment(`dashboard-${row.id}.csv`).send(csv);
+      return;
+    }
+    res.status(200).type('application/json').send(
+      JSON.stringify({
+        dashboard: {
+          id: row.id,
+          tenantId: row.tenant_id,
+          name: row.name,
+          ownerId: row.owner_id,
+          config: JSON.parse(row.config),
+          createdAt: row.created_at,
+          updatedAt: row.updated_at,
+        },
+      }),
+    );
+  });
+
+  return router;
+}
diff --git a/src/routes/query.ts b/src/routes/query.ts
new file mode 100644
index 0000000..4abcbe2
--- /dev/null
+++ b/src/routes/query.ts
@@ -0,0 +1,56 @@
+import { Router } from 'express';
+import type { DB } from '../db.js';
+import { authenticate } from '../auth.js';
+import {
+  breakdown,
+  countEvents,
+  timeseries,
+  type Interval,
+  type QueryFilter,
+} from '../queries.js';
+
+const VALID_INTERVALS: Interval[] = ['hour', 'day', 'week', 'month'];
+
+/** Extract a QueryFilter from a request body, ignoring unknown fields. */
+function extractFilter(body: Record<string, unknown>): QueryFilter {
+  const filter: QueryFilter = {};
+  if (typeof body.name === 'string') filter.name = body.name;
+  if (typeof body.from === 'string') filter.from = body.from;
+  if (typeof body.to === 'string') filter.to = body.to;
+  if (body.properties && typeof body.properties === 'object' && !Array.isArray(body.properties)) {
+    filter.properties = body.properties as Record<string, string | number | boolean>;
+  }
+  return filter;
+}
+
+export function queryRouter(db: DB): Router {
+  const router = Router();
+  router.use(authenticate);
+
+  router.post('/count', (req, res) => {
+    const filter = extractFilter(req.body ?? {});
+    const count = countEvents(db, req.user!.tenantId, filter);
+    res.status(200).json({ count });
+  });
+
+  router.post('/timeseries', (req, res) => {
+    const body = req.body ?? {};
+    const interval: Interval = VALID_INTERVALS.includes(body.interval) ? body.interval : 'day';
+    const filter = extractFilter(body);
+    const buckets = timeseries(db, req.user!.tenantId, filter, interval);
+    res.status(200).json({ interval, buckets });
+  });
+
+  router.post('/breakdown', (req, res) => {
+    const body = req.body ?? {};
+    if (typeof body.property !== 'string' || !body.property) {
+      res.status(400).json({ error: 'property is required' });
+      return;
+    }
+    const filter = extractFilter(body);
+    const groups = breakdown(db, req.user!.tenantId, body.property, filter);
+    res.status(200).json({ property: body.property, groups });
+  });
+
+  return router;
+}
