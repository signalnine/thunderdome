 req.user!;\n    insert.run(prepared.id, tenantId, prepared.name, prepared.properties, prepared.timestamp, userId, prepared.sessionId);\n    res.status(201).json({\n      event: {\n        id: prepared.id,\n        tenantId,\n        name: prepared.name,\n        properties: JSON.parse(prepared.properties),\n        timestamp: prepared.timestamp,\n        userId,\n        sessionId: prepared.sessionId,\n      },\n    });\n  });\n\n  router.post('/batch', (req, res) => {\n    const events = (req.body ?? {}).events;\n    if (!Array.isArray(events) || events.length === 0) {\n      res.status(400).json({ error: 'events must be a non-empty array' });\n      return;\n    }\n    const now = new Date().toISOString().replace('T', ' ').slice(0, 19);\n    const prepared: PreparedEvent[] = [];\n    for (const raw of events) {\n      const p = prepareEvent(raw, now);\n      if (!p) {\n        res.status(400).json({ error: 'every event must have a name and valid properties' });\n        return;\n      }\n      prepared.push(p);\n    }\n    const { tenantId, id: userId } = req.user!;\n    const insertMany = db.transaction((items: PreparedEvent[]) => {\n      for (const p of items) {\n        insert.run(p.id, tenantId, p.name, p.properties, p.timestamp, userId, p.sessionId);\n      }\n    });\n    insertMany(prepared);\n    res.status(201).json({ count: prepared.length, ids: prepared.map((p) => p.id) });\n  });\n\n  return router;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1970,"cache_read_input_tokens":32726,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1970},"output_tokens":73,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"26245a82-4995-49b4-88df-329d8926efbb","uuid":"f143ca09-bdfd-4476-b027-58d48bf80f2c","request_id":"req_011CbWFf1y5mYWpRh3nrYqD8