diff --git a/src/db.ts b/src/db.ts
new file mode 100644
index 0000000..00f0f67
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,176 @@
+import Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+
+export interface DocumentRow {
+  id: string;
+  title: string;
+  content: string;
+  version: number;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface VersionRow {
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS documents (
+  id TEXT PRIMARY KEY,
+  title TEXT NOT NULL,
+  content TEXT NOT NULL DEFAULT '',
+  version INTEGER NOT NULL DEFAULT 0,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  updated_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+
+CREATE TABLE IF NOT EXISTS versions (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  version INTEGER NOT NULL,
+  content TEXT NOT NULL,
+  operation TEXT,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  UNIQUE(document_id, version)
+);
+
+CREATE INDEX IF NOT EXISTS idx_versions_doc ON versions(document_id, version);
+`;
+
+/**
+ * Thin persistence wrapper around better-sqlite3. All document mutations record a
+ * row in `versions` so the full edit history survives restarts.
+ */
+export class Store {
+  private db: Database.Database;
+
+  constructor(dbPath = ':memory:') {
+    this.db = new Database(dbPath);
+    this.db.pragma('journal_mode = WAL');
+    this.db.pragma('foreign_keys = ON');
+    this.db.exec(SCHEMA);
+  }
+
+  createDocument(title: string, content = ''): DocumentRow {
+    const id = randomUUID();
+    const insertDoc = this.db.prepare(
+      `INSERT INTO documents (id, title, content, version) VALUES (?, ?, ?, 0)`,
+    );
+    const insertVersion = this.db.prepare(
+      `INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, ?)`,
+    );
+    const tx = this.db.transaction(() => {
+      insertDoc.run(id, title, content);
+      insertVersion.run(id, content, JSON.stringify({ type: 'create' }));
+    });
+    tx();
+    return this.getDocument(id)!;
+  }
+
+  getDocument(id: string): DocumentRow | undefined {
+    return this.db.prepare(`SELECT * FROM documents WHERE id = ?`).get(id) as
+      | DocumentRow
+      | undefined;
+  }
+
+  listDocuments(): DocumentRow[] {
+    return this.db
+      .prepare(`SELECT * FROM documents ORDER BY updated_at DESC`)
+      .all() as DocumentRow[];
+  }
+
+  deleteDocument(id: string): boolean {
+    const info = this.db.prepare(`DELETE FROM documents WHERE id = ?`).run(id);
+    return info.changes > 0;
+  }
+
+  /**
+   * Persist a new version of a document: bump version, store content + operation,
+   * update the document row. `operation` is arbitrary JSON describing the change.
+   * Returns the updated document, or undefined if the document does not exist.
+   */
+  commitVersion(
+    id: string,
+    content: string,
+    operation: unknown,
+    title?: string,
+  ): DocumentRow | undefined {
+    const doc = this.getDocument(id);
+    if (!doc) return undefined;
+    const newVersion = doc.version + 1;
+    const newTitle = title ?? doc.title;
+    const updateDoc = this.db.prepare(
+      `UPDATE documents SET content = ?, title = ?, version = ?, updated_at = datetime('now') WHERE id = ?`,
+    );
+    const insertVersion = this.db.prepare(
+      `INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)`,
+    );
+    const tx = this.db.transaction(() => {
+      updateDoc.run(content, newTitle, newVersion, id);
+      insertVersion.run(id, newVersion, content, JSON.stringify(operation));
+    });
+    tx();
+    return this.getDocument(id);
+  }
+
+  /** Update only the title without producing a content version (used by REST PUT title-only). */
+  updateTitle(id: string, title: string): DocumentRow | undefined {
+    const doc = this.getDocument(id);
+    if (!doc) return undefined;
+    this.db
+      .prepare(`UPDATE documents SET title = ?, updated_at = datetime('now') WHERE id = ?`)
+      .run(title, id);
+    return this.getDocument(id);
+  }
+
+  listVersions(id: string): VersionRow[] {
+    return this.db
+      .prepare(
+        `SELECT version, content, operation, created_at FROM versions WHERE document_id = ? ORDER BY version ASC`,
+      )
+      .all(id) as VersionRow[];
+  }
+
+  getVersion(id: string, version: number): VersionRow | undefined {
+    return this.db
+      .prepare(
+        `SELECT version, content, operation, created_at FROM versions WHERE document_id = ? AND version = ?`,
+      )
+      .get(id, version) as VersionRow | undefined;
+  }
+
+  /**
+   * Return the parsed operation op-lists applied for versions strictly greater
+   * than `baseVersion`, in ascending version order. Used to rebase a concurrent
+   * op against everything that happened since its base.
+   */
+  operationsSince(id: string, baseVersion: number): unknown[][] {
+    const rows = this.db
+      .prepare(
+        `SELECT operation FROM versions WHERE document_id = ? AND version > ? ORDER BY version ASC`,
+      )
+      .all(id, baseVersion) as { operation: string | null }[];
+    const result: unknown[][] = [];
+    for (const r of rows) {
+      if (!r.operation) {
+        result.push([]);
+        continue;
+      }
+      const parsed = JSON.parse(r.operation);
+      if (Array.isArray(parsed)) {
+        result.push(parsed);
+      } else {
+        // create marker or non-op entry: contributes no transformable ops
+        result.push([]);
+      }
+    }
+    return result;
+  }
+
+  close(): void {
+    this.db.close();
+  }
+}
diff --git a/src/ot.ts b/src/ot.ts
new file mode 100644
index 0000000..f9c9624
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,216 @@
+// Operational Transform core for a single linear document (string of UTF-16 code units).
+//
+// Two primitive operations:
+//   insert: { type: 'insert', pos, text }
+//   delete: { type: 'delete', pos, length }
+//
+// The server is the single source of truth. Each client op carries the version it
+// was generated against (`baseVersion`). The server transforms the incoming op
+// forward through every operation applied since that base version, applies the
+// result, bumps the version, persists, and broadcasts the transformed op list so
+// every client converges to the same content.
+
+export interface InsertOp {
+  type: 'insert';
+  pos: number;
+  text: string;
+}
+
+export interface DeleteOp {
+  type: 'delete';
+  pos: number;
+  length: number;
+}
+
+export type Op = InsertOp | DeleteOp;
+
+export class OpError extends Error {}
+
+/**
+ * Validate that a value is a well-formed operation that can be applied to a
+ * document of the given length. Throws OpError on any problem.
+ */
+export function validateOp(op: unknown, contentLength: number): Op {
+  if (op === null || typeof op !== 'object') {
+    throw new OpError('operation must be an object');
+  }
+  const o = op as Record<string, unknown>;
+  if (o.type === 'insert') {
+    if (typeof o.pos !== 'number' || !Number.isInteger(o.pos)) {
+      throw new OpError('insert.pos must be an integer');
+    }
+    if (o.pos < 0 || o.pos > contentLength) {
+      throw new OpError('insert.pos out of bounds');
+    }
+    if (typeof o.text !== 'string') {
+      throw new OpError('insert.text must be a string');
+    }
+    if (o.text.length === 0) {
+      throw new OpError('insert.text must be non-empty');
+    }
+    return { type: 'insert', pos: o.pos, text: o.text };
+  }
+  if (o.type === 'delete') {
+    if (typeof o.pos !== 'number' || !Number.isInteger(o.pos)) {
+      throw new OpError('delete.pos must be an integer');
+    }
+    if (typeof o.length !== 'number' || !Number.isInteger(o.length)) {
+      throw new OpError('delete.length must be an integer');
+    }
+    if (o.length <= 0) {
+      throw new OpError('delete.length must be positive');
+    }
+    if (o.pos < 0 || o.pos + o.length > contentLength) {
+      throw new OpError('delete range out of bounds');
+    }
+    return { type: 'delete', pos: o.pos, length: o.length };
+  }
+  throw new OpError(`unknown operation type: ${String(o.type)}`);
+}
+
+/** Apply a single primitive op to content. Assumes the op is valid for content. */
+export function applyOp(content: string, op: Op): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.pos) + op.text + content.slice(op.pos);
+  }
+  return content.slice(0, op.pos) + content.slice(op.pos + op.length);
+}
+
+/**
+ * Apply an ordered list of primitive ops that are encoded as a *sequence* — each
+ * op's positions are relative to the document state produced by the previous op
+ * in the list. This is how transformed op-lists are stored and broadcast.
+ */
+export function applyOps(content: string, ops: Op[]): string {
+  let c = content;
+  for (const op of ops) {
+    c = applyOp(c, op);
+  }
+  return c;
+}
+
+/**
+ * Transform op `a` so it can be applied *after* op `b` has already been applied,
+ * where `a` and `b` were both generated against the same base state (they are
+ * concurrent). Returns the transformed op(s). May return:
+ *   - one op (the common case)
+ *   - zero ops (a delete fully cancelled by b's delete)
+ *   - two ops (a delete split by an insert that landed inside its range)
+ *
+ * When two ops produce two ops, they are returned as a *sequence* (each relative
+ * to the prior), so the result composes cleanly with applyOps / further transforms.
+ */
+export function transformOp(a: Op, b: Op): Op[] {
+  if (a.type === 'insert' && b.type === 'insert') {
+    // Shift a right if b precedes it. At the exact same position, break the tie
+    // deterministically by comparing text so the transform is symmetric (TP1):
+    // exactly one of transformOp(a,b)/transformOp(b,a) shifts.
+    const shift = b.pos < a.pos || (b.pos === a.pos && a.text > b.text);
+    const pos = shift ? a.pos + b.text.length : a.pos;
+    return [{ type: 'insert', pos, text: a.text }];
+  }
+
+  if (a.type === 'insert' && b.type === 'delete') {
+    let pos = a.pos;
+    if (a.pos > b.pos + b.length) {
+      pos = a.pos - b.length;
+    } else if (a.pos > b.pos) {
+      pos = b.pos; // a fell inside the deleted range -> collapse to its start
+    }
+    return [{ type: 'insert', pos, text: a.text }];
+  }
+
+  if (a.type === 'delete' && b.type === 'insert') {
+    const aStart = a.pos;
+    const aEnd = a.pos + a.length;
+    if (b.pos <= aStart) {
+      return [{ type: 'delete', pos: a.pos + b.text.length, length: a.length }];
+    }
+    if (b.pos >= aEnd) {
+      return [{ type: 'delete', pos: a.pos, length: a.length }];
+    }
+    // Insert landed strictly inside the delete range: split into two deletes that
+    // skip the inserted text, encoded as a sequence (right is relative to state
+    // after left has been applied, hence its pos accounts for the left delete).
+    const leftLen = b.pos - aStart;
+    const rightLen = a.length - leftLen;
+    const left: DeleteOp = { type: 'delete', pos: aStart, length: leftLen };
+    // After `left` deletes `leftLen` chars at aStart, the inserted text begins at
+    // aStart; skip it (b.text.length) to reach the remainder.
+    const right: DeleteOp = { type: 'delete', pos: aStart + b.text.length, length: rightLen };
+    const out: Op[] = [];
+    if (leftLen > 0) out.push(left);
+    if (rightLen > 0) out.push(right);
+    return out;
+  }
+
+  // delete vs delete
+  const a2 = a as DeleteOp;
+  const b2 = b as DeleteOp;
+  const aStart = a2.pos;
+  const aEnd = a2.pos + a2.length;
+  const bStart = b2.pos;
+  const bEnd = b2.pos + b2.length;
+
+  if (bEnd <= aStart) {
+    return [{ type: 'delete', pos: a2.pos - b2.length, length: a2.length }];
+  }
+  if (bStart >= aEnd) {
+    return [{ type: 'delete', pos: a2.pos, length: a2.length }];
+  }
+  // Overlap: remove the overlapping span from a's length and shift start left by
+  // however many chars b removed before a's start.
+  const overlap = Math.min(aEnd, bEnd) - Math.max(aStart, bStart);
+  const removedBefore = Math.max(0, Math.min(bEnd, aStart) - bStart);
+  const newStart = a2.pos - removedBefore;
+  const newLen = a2.length - overlap;
+  if (newLen <= 0) {
+    return [];
+  }
+  return [{ type: 'delete', pos: newStart, length: newLen }];
+}
+
+/**
+ * Transform two op-sequences `a` and `b` that are both relative to the *same*
+ * base state. Returns `{ aPrime, bPrime }` where `aPrime` applies after `b` and
+ * `bPrime` applies after `a`, such that `applyOps(applyOps(s, b), aPrime) ===
+ * applyOps(applyOps(s, a), bPrime)` (TP1 convergence). Built by recursively
+ * decomposing the sequences down to single-op pairs handled by `transformOp`.
+ */
+export function transformPair(a: Op[], b: Op[]): { aPrime: Op[]; bPrime: Op[] } {
+  if (a.length === 0) return { aPrime: [], bPrime: b };
+  if (b.length === 0) return { aPrime: a, bPrime: [] };
+
+  if (a.length === 1 && b.length === 1) {
+    return { aPrime: transformOp(a[0], b[0]), bPrime: transformOp(b[0], a[0]) };
+  }
+
+  if (b.length > 1) {
+    const b1 = [b[0]];
+    const bRest = b.slice(1); // relative to state after b1
+    const r1 = transformPair(a, b1); // aPrime after b1; bPrime after a
+    const r2 = transformPair(r1.aPrime, bRest); // aPrime after all of b
+    return { aPrime: r2.aPrime, bPrime: [...r1.bPrime, ...r2.bPrime] };
+  }
+
+  // a.length > 1, b.length === 1
+  const a1 = [a[0]];
+  const aRest = a.slice(1); // relative to state after a1
+  const r1 = transformPair(a1, b); // a1 after b; b after a1
+  const r2 = transformPair(aRest, r1.bPrime); // aRest after b; b after all of a
+  return { aPrime: [...r1.aPrime, ...r2.aPrime], bPrime: r2.bPrime };
+}
+
+/**
+ * Transform a freshly-arrived op (or op sequence) forward through a chronological
+ * list of op-lists that were applied after the op's base version. Each element of
+ * `history` is the (already-transformed, sequential) op-list that produced one
+ * version. Returns the op sequence rebased onto the latest version.
+ */
+export function transformAgainstHistory(incoming: Op[], history: Op[][]): Op[] {
+  let pending = incoming;
+  for (const applied of history) {
+    pending = transformPair(pending, applied).aPrime;
+  }
+  return pending;
+}
diff --git a/src/server.ts b/src/server.ts
new file mode 100644
index 0000000..32548e1
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,308 @@
+import express, { type Express, type Request, type Response } from 'express';
+import { createServer, type Server } from 'node:http';
+import { WebSocketServer, WebSocket } from 'ws';
+import { AddressInfo } from 'node:net';
+import { Store } from './db.js';
+import {
+  validateOp,
+  applyOps,
+  transformAgainstHistory,
+  OpError,
+  type Op,
+} from './ot.js';
+
+export interface CollabServer {
+  app: Express;
+  server: Server;
+  wss: WebSocketServer;
+  store: Store;
+  start(port?: number): Promise<number>;
+  stop(): Promise<void>;
+}
+
+const WS_PATH = /^\/documents\/([^/]+)\/ws$/;
+
+interface ClientState {
+  socket: WebSocket;
+  documentId: string;
+}
+
+/**
+ * Build the collaborative editing server. `dbPath` defaults to an in-memory
+ * database; pass a file path for persistence across restarts.
+ */
+export function createApp(dbPath?: string): CollabServer {
+  const store = new Store(dbPath ?? ':memory:');
+  const app = express();
+  app.use(express.json({ limit: '5mb' }));
+
+  // Connected clients grouped by document id (for broadcast).
+  const rooms = new Map<string, Set<ClientState>>();
+
+  function roomOf(id: string): Set<ClientState> {
+    let set = rooms.get(id);
+    if (!set) {
+      set = new Set();
+      rooms.set(id, set);
+    }
+    return set;
+  }
+
+  function broadcast(documentId: string, message: unknown): void {
+    const data = JSON.stringify(message);
+    const set = rooms.get(documentId);
+    if (!set) return;
+    for (const client of set) {
+      if (client.socket.readyState === WebSocket.OPEN) {
+        client.socket.send(data);
+      }
+    }
+  }
+
+  // ---------------------------------------------------------------- REST API
+
+  app.post('/documents', (req: Request, res: Response) => {
+    const { title, content } = req.body ?? {};
+    if (typeof title !== 'string' || title.trim().length === 0) {
+      return res.status(400).json({ error: 'title is required and must be a non-empty string' });
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    const doc = store.createDocument(title, content ?? '');
+    return res.status(201).json(doc);
+  });
+
+  app.get('/documents', (_req: Request, res: Response) => {
+    return res.json(store.listDocuments());
+  });
+
+  app.get('/documents/:id', (req: Request, res: Response) => {
+    const doc = store.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    return res.json(doc);
+  });
+
+  app.get('/documents/:id/versions', (req: Request, res: Response) => {
+    const doc = store.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    return res.json(store.listVersions(req.params.id));
+  });
+
+  app.get('/documents/:id/versions/:version', (req: Request, res: Response) => {
+    const version = Number(req.params.version);
+    if (!Number.isInteger(version) || version < 0) {
+      return res.status(400).json({ error: 'invalid version' });
+    }
+    const row = store.getVersion(req.params.id, version);
+    if (!row) return res.status(404).json({ error: 'version not found' });
+    return res.json(row);
+  });
+
+  app.put('/documents/:id', (req: Request, res: Response) => {
+    const doc = store.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    const { title, content } = req.body ?? {};
+    if (title !== undefined && (typeof title !== 'string' || title.trim().length === 0)) {
+      return res.status(400).json({ error: 'title must be a non-empty string' });
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    let updated = doc;
+    if (content !== undefined && content !== doc.content) {
+      // A full content replacement becomes a new version (represented as a
+      // replace-all operation: delete everything, then insert the new content).
+      const ops: Op[] = [];
+      if (doc.content.length > 0) ops.push({ type: 'delete', pos: 0, length: doc.content.length });
+      if (content.length > 0) ops.push({ type: 'insert', pos: 0, text: content });
+      updated = store.commitVersion(req.params.id, content, ops, title)!;
+      broadcast(req.params.id, {
+        type: 'op',
+        documentId: req.params.id,
+        version: updated.version,
+        ops,
+      });
+    } else if (title !== undefined && title !== doc.title) {
+      updated = store.updateTitle(req.params.id, title)!;
+    }
+    return res.json(updated);
+  });
+
+  app.delete('/documents/:id', (req: Request, res: Response) => {
+    const ok = store.deleteDocument(req.params.id);
+    if (!ok) return res.status(404).json({ error: 'document not found' });
+    // Disconnect any clients attached to the deleted document.
+    const set = rooms.get(req.params.id);
+    if (set) {
+      for (const client of set) {
+        safeSend(client.socket, { type: 'error', message: 'document deleted' });
+        client.socket.close();
+      }
+      rooms.delete(req.params.id);
+    }
+    return res.status(204).end();
+  });
+
+  // ------------------------------------------------------------ HTTP + WS glue
+
+  const server = createServer(app);
+  const wss = new WebSocketServer({ noServer: true });
+
+  server.on('upgrade', (request, socket, head) => {
+    const url = request.url ?? '';
+    const pathname = url.split('?')[0];
+    const match = WS_PATH.exec(pathname);
+    if (!match) {
+      socket.destroy();
+      return;
+    }
+    const documentId = decodeURIComponent(match[1]);
+    wss.handleUpgrade(request, socket, head, (ws) => {
+      wss.emit('connection', ws, request, documentId);
+    });
+  });
+
+  wss.on('connection', (ws: WebSocket, _request: unknown, documentId: string) => {
+    const doc = store.getDocument(documentId);
+    if (!doc) {
+      safeSend(ws, { type: 'error', message: 'document not found' });
+      ws.close();
+      return;
+    }
+
+    const client: ClientState = { socket: ws, documentId };
+    roomOf(documentId).add(client);
+
+    // Initial sync with the current authoritative state.
+    safeSend(ws, {
+      type: 'sync',
+      documentId,
+      version: doc.version,
+      content: doc.content,
+    });
+
+    ws.on('message', (raw) => {
+      handleMessage(client, raw.toString());
+    });
+
+    ws.on('close', () => {
+      rooms.get(documentId)?.delete(client);
+    });
+
+    ws.on('error', () => {
+      rooms.get(documentId)?.delete(client);
+    });
+  });
+
+  function handleMessage(client: ClientState, raw: string): void {
+    let msg: unknown;
+    try {
+      msg = JSON.parse(raw);
+    } catch {
+      return safeSend(client.socket, { type: 'error', message: 'invalid JSON' });
+    }
+    if (msg === null || typeof msg !== 'object') {
+      return safeSend(client.socket, { type: 'error', message: 'message must be an object' });
+    }
+    const m = msg as Record<string, unknown>;
+
+    if (m.type === 'ping') {
+      return safeSend(client.socket, { type: 'pong' });
+    }
+
+    if (m.type !== 'op') {
+      return safeSend(client.socket, { type: 'error', message: `unknown message type: ${String(m.type)}` });
+    }
+
+    const documentId = client.documentId;
+    const doc = store.getDocument(documentId);
+    if (!doc) {
+      return safeSend(client.socket, { type: 'error', message: 'document no longer exists' });
+    }
+
+    // Determine the base version the op was generated against.
+    const baseVersion = m.baseVersion === undefined ? doc.version : m.baseVersion;
+    if (typeof baseVersion !== 'number' || !Number.isInteger(baseVersion) || baseVersion < 0 || baseVersion > doc.version) {
+      return safeSend(client.socket, { type: 'error', message: 'invalid baseVersion' });
+    }
+
+    // Validate the op against the document content as it was at baseVersion.
+    const baseRow = store.getVersion(documentId, baseVersion);
+    const baseLength = baseRow ? baseRow.content.length : doc.content.length;
+    let op: Op;
+    try {
+      op = validateOp(m.op, baseLength);
+    } catch (err) {
+      const message = err instanceof OpError ? err.message : 'invalid operation';
+      return safeSend(client.socket, { type: 'error', message });
+    }
+
+    // Rebase the op past everything applied since its base version, then apply.
+    try {
+      const history = store.operationsSince(documentId, baseVersion) as Op[][];
+      const rebased = transformAgainstHistory([op], history);
+      const newContent = applyOps(doc.content, rebased);
+      const updated = store.commitVersion(documentId, newContent, rebased)!;
+      broadcast(documentId, {
+        type: 'op',
+        documentId,
+        version: updated.version,
+        ops: rebased,
+      });
+    } catch {
+      safeSend(client.socket, { type: 'error', message: 'failed to apply operation' });
+    }
+  }
+
+  function start(port = 0): Promise<number> {
+    return new Promise((resolve, reject) => {
+      server.once('error', reject);
+      server.listen(port, () => {
+        server.removeListener('error', reject);
+        const addr = server.address() as AddressInfo;
+        resolve(addr.port);
+      });
+    });
+  }
+
+  function stop(): Promise<void> {
+    return new Promise((resolve) => {
+      for (const set of rooms.values()) {
+        for (const client of set) {
+          try {
+            client.socket.terminate();
+          } catch {
+            /* ignore */
+          }
+        }
+      }
+      rooms.clear();
+      wss.close(() => {
+        server.close(() => {
+          store.close();
+          resolve();
+        });
+      });
+    });
+  }
+
+  return { app, server, wss, store, start, stop };
+}
+
+function safeSend(ws: WebSocket, message: unknown): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify(message));
+  }
+}
+
+// Allow running directly: `node dist/server.js`
+if (process.argv[1] && process.argv[1].endsWith('server.js')) {
+  const port = Number(process.env.PORT ?? 3000);
+  const dbPath = process.env.DB_PATH ?? 'collab.db';
+  const instance = createApp(dbPath);
+  instance.start(port).then((p) => {
+    // eslint-disable-next-line no-console
+    console.log(`collab server listening on :${p}`);
+  });
+}
