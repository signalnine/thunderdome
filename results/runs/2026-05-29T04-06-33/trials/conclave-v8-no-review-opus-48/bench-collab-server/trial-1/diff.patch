+import { describe, it, expect, afterEach } from 'vitest';
+import { Store } from '../src/db.js';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { existsSync, rmSync } from 'node:fs';
+
+const tmpFiles: string[] = [];
+function tmpDb(): string {
+  const p = join(tmpdir(), `coll-${randomUUID()}.db`);
+  tmpFiles.push(p);
+  return p;
+}
+
+afterEach(() => {
+  for (const f of tmpFiles.splice(0)) {
+    for (const ext of ['', '-wal', '-shm']) {
+      if (existsSync(f + ext)) rmSync(f + ext);
+    }
+  }
+});
+
+describe('Store CRUD', () => {
+  it('creates and reads a document with version 0', () => {
+    const s = new Store();
+    const doc = s.createDocument('Title', 'hello');
+    expect(doc.title).toBe('Title');
+    expect(doc.content).toBe('hello');
+    expect(doc.version).toBe(0);
+    expect(s.getDocument(doc.id)).toMatchObject({ id: doc.id, content: 'hello' });
+    s.close();
+  });
+
+  it('lists documents', () => {
+    const s = new Store();
+    s.createDocument('a');
+    s.createDocument('b');
+    expect(s.listDocuments().length).toBe(2);
+    s.close();
+  });
+
+  it('deletes a document and cascades versions', () => {
+    const s = new Store();
+    const doc = s.createDocument('x', 'abc');
+    expect(s.deleteDocument(doc.id)).toBe(true);
+    expect(s.getDocument(doc.id)).toBeUndefined();
+    expect(s.listVersions(doc.id).length).toBe(0);
+    expect(s.deleteDocument('nope')).toBe(false);
+    s.close();
+  });
+
+  it('commitVersion bumps version and records history', () => {
+    const s = new Store();
+    const doc = s.createDocument('x', '');
+    const v1 = s.commitVersion(doc.id, 'a', [{ type: 'insert', pos: 0, text: 'a' }]);
+    expect(v1!.version).toBe(1);
+    expect(v1!.content).toBe('a');
+    const v2 = s.commitVersion(doc.id, 'ab', [{ type: 'insert', pos: 1, text: 'b' }]);
+    expect(v2!.version).toBe(2);
+    const versions = s.listVersions(doc.id);
+    expect(versions.map((v) => v.version)).toEqual([0, 1, 2]);
+    s.close();
+  });
+
+  it('operationsSince returns ops after a base version', () => {
+    const s = new Store();
+    const doc = s.createDocument('x', '');
+    s.commitVersion(doc.id, 'a', [{ type: 'insert', pos: 0, text: 'a' }]);
+    s.commitVersion(doc.id, 'ab', [{ type: 'insert', pos: 1, text: 'b' }]);
+    const since0 = s.operationsSince(doc.id, 0);
+    expect(since0.length).toBe(2);
+    const since1 = s.operationsSince(doc.id, 1);
+    expect(since1.length).toBe(1);
+    s.close();
+  });
+
+  it('updateTitle does not create a version', () => {
+    const s = new Store();
+    const doc = s.createDocument('x', '');
+    s.updateTitle(doc.id, 'y');
+    expect(s.getDocument(doc.id)!.title).toBe('y');
+    expect(s.listVersions(doc.id).length).toBe(1); // only the create version
+    s.close();
+  });
+});
+
+describe('persistence across reopen', () => {
+  it('survives closing and reopening the same file', () => {
+    const path = tmpDb();
+    const s1 = new Store(path);
+    const doc = s1.createDocument('Persisted', 'data');
+    s1.commitVersion(doc.id, 'data!', [{ type: 'insert', pos: 4, text: '!' }]);
+    s1.close();
+
+    const s2 = new Store(path);
+    const reread = s2.getDocument(doc.id);
+    expect(reread).toBeDefined();
+    expect(reread!.content).toBe('data!');
+    expect(reread!.version).toBe(1);
+    expect(s2.listVersions(doc.id).length).toBe(2);
+    s2.close();
+  });
+});
