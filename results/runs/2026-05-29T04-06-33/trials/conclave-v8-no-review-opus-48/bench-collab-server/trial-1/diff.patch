+// ----- WebSocket tests ---------------------------------------------------
+
+async function makeDoc(title = 'Doc', content = ''): Promise<string> {
+  const res = await request(inst.app).post('/documents').send({ title, content });
+  return res.body.id;
+}
+
+// Poll the REST endpoint until the document reaches the expected version.
+async function waitForVersion(id: string, version: number, timeoutMs = 3000): Promise<any> {
+  const deadline = Date.now() + timeoutMs;
+  // eslint-disable-next-line no-constant-condition
+  while (true) {
+    const res = await request(inst.app).get(`/documents/${id}`);
+    if (res.body.version >= version) return res.body;
+    if (Date.now() > deadline) return res.body;
+    await new Promise((r) => setTimeout(r, 20));
+  }
+}
+
+describe('WebSocket realtime', () => {
+  it('sends a sync message on connect', async () => {
+    const id = await makeDoc('Doc', 'hello');
+    const c = connect(id);
+    const msg = await c.next();
+    expect(msg).toMatchObject({ type: 'sync', documentId: id, version: 0, content: 'hello' });
+    c.close();
+  });
+
+  it('rejects connecting to an unknown document', async () => {
+    const c = connect('does-not-exist');
+    const msg = await c.next();
+    expect(msg).toMatchObject({ type: 'error' });
+    await c.closed();
+  });
+
+  it('applies an op and broadcasts it to all clients', async () => {
+    const id = await makeDoc('Doc', 'hello');
+    const a = connect(id);
+    const b = connect(id);
+    await a.next(); // sync
+    await b.next(); // sync
+
+    a.send({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 5, text: ' world' } });
+    const msg = await b.next();
+    expect(msg.type).toBe('op');
+    expect(msg.version).toBe(1);
+
+    // Verify convergence via REST.
+    const res = await request(inst.app).get(`/documents/${id}`);
+    expect(res.body.content).toBe('hello world');
+    a.close();
+    b.close();
+  });
+
+  it('replies with an error on malformed op and does not crash', async () => {
+    const id = await makeDoc('Doc', 'hi');
+    const c = connect(id);
+    await c.next(); // sync
+
+    c.ws.send('not json{{');
+    expect((await c.next()).type).toBe('error');
+
+    c.send({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 99, text: 'x' } });
+    expect((await c.next()).type).toBe('error');
+
+    c.send({ type: 'frobnicate' });
+    expect((await c.next()).type).toBe('error');
+
+    c.send({ type: 'op', baseVersion: 0, op: { type: 'delete', pos: 0, length: 100 } });
+    expect((await c.next()).type).toBe('error');
+
+    // Server still works after a barrage of errors.
+    c.send({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 0, text: 'X' } });
+    expect((await c.next()).type).toBe('op');
+    c.close();
+  });
+
+  it('two concurrent inserts off the same base both survive and converge', async () => {
+    const id = await makeDoc('Doc', 'hello');
+    const a = connect(id);
+    const b = connect(id);
+    await a.next();
+    await b.next();
+
+    // Both base off version 0 and insert at the same position "simultaneously".
+    a.send({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 5, text: 'AAA' } });
+    b.send({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 5, text: 'BBB' } });
+
+    const doc = await waitForVersion(id, 2);
+    expect(doc.version).toBe(2);
+    expect(doc.content).toContain('AAA');
+    expect(doc.content).toContain('BBB');
+    expect(doc.content.length).toBe('hello'.length + 6);
+    a.close();
+    b.close();
+  });
+
+  it('handles 10 concurrent clients editing the same document without loss', async () => {
+    const id = await makeDoc('Doc', '');
+    const N = 10;
+    const clients: Client[] = [];
+    for (let i = 0; i < N; i++) clients.push(connect(id));
+    await Promise.all(clients.map((c) => c.next())); // syncs
+
+    // Each client inserts its unique char at position 0, all based on version 0.
+    for (let i = 0; i < N; i++) {
+      clients[i].send({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 0, text: String.fromCharCode(65 + i) } });
+    }
+
+    const doc = await waitForVersion(id, N);
+    expect(doc.version).toBe(N);
+    expect(doc.content.length).toBe(N);
+    for (let i = 0; i < N; i++) {
+      expect(doc.content).toContain(String.fromCharCode(65 + i));
+    }
+    clients.forEach((c) => c.close());
+  });
+
+  it('all clients converge to the same final content (broadcast order)', async () => {
+    const id = await makeDoc('Doc', 'start');
+    const a = connect(id);
+    const b = connect(id);
+    await a.next();
+    await b.next();
+
+    // Each client tracks its own copy by applying broadcast ops in arrival order.
+    const applyClient = (c: Client, initial: string) => {
+      const state = { content: initial };
+      c.ws.on('message', (data: Buffer) => {
+        const m = JSON.parse(data.toString());
+        if (m.type === 'op') {
+          for (const op of m.ops) {
+            if (op.type === 'insert') state.content = state.content.slice(0, op.pos) + op.text + state.content.slice(op.pos);
+            else state.content = state.content.slice(0, op.pos) + state.content.slice(op.pos + op.length);
+          }
+        }
+      });
+      return state;
+    };
+    const aState = applyClient(a, 'start');
+    const bState = applyClient(b, 'start');
+
+    a.send({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 0, text: 'A' } });
+    b.send({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 5, text: 'B' } });
+
+    const doc = await waitForVersion(id, 2);
+    await new Promise((r) => setTimeout(r, 100)); // let broadcasts settle on both clients
+    expect(aState.content).toBe(doc.content);
+    expect(bState.content).toBe(doc.content);
+    a.close();
+    b.close();
+  });
+});
