index 0000000..7fefb9b
--- /dev/null
+++ b/tests/server.test.ts
@@ -0,0 +1,323 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import request from 'supertest';
+import { WebSocket } from 'ws';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { existsSync, rmSync } from 'node:fs';
+import { createApp, type CollabServer } from '../src/server.js';
+
+let inst: CollabServer;
+let port: number;
+
+beforeEach(async () => {
+  inst = createApp();
+  port = await inst.start(0);
+});
+
+afterEach(async () => {
+  await inst.stop();
+});
+
+// ----- WebSocket helpers -------------------------------------------------
+//
+// `Client` buffers every message from the moment of connection so that the
+// immediate `sync` message (sent before the client even fires `open`) is never
+// missed by a late listener.
+
+class Client {
+  ws: WebSocket;
+  private queue: any[] = [];
+  private waiters: Array<(m: any) => void> = [];
+
+  constructor(documentId: string) {
+    this.ws = new WebSocket(`ws://127.0.0.1:${port}/documents/${documentId}/ws`);
+    this.ws.on('message', (data: Buffer) => {
+      const msg = JSON.parse(data.toString());
+      const w = this.waiters.shift();
+      if (w) w(msg);
+      else this.queue.push(msg);
+    });
+  }
+
+  next(): Promise<any> {
+    if (this.queue.length) return Promise.resolve(this.queue.shift());
+    return new Promise((resolve) => this.waiters.push(resolve));
+  }
+
+  send(obj: unknown): void {
+    this.ws.send(JSON.stringify(obj));
+  }
+
+  open(): Promise<void> {
+    return new Promise((resolve, reject) => {
+      if (this.ws.readyState === WebSocket.OPEN) return resolve();
+      this.ws.once('open', () => resolve());
+      this.ws.once('error', reject);
+    });
+  }
+
+  closed(): Promise<void> {
+    return new Promise((resolve) => {
+      if (this.ws.readyState === WebSocket.CLOSED) return resolve();
+      this.ws.once('close', () => resolve());
+    });
+  }
+
+  close(): void {
+    this.ws.close();
+  }
+}
+
+function connect(documentId: string): Client {
+  return new Client(documentId);
+}
