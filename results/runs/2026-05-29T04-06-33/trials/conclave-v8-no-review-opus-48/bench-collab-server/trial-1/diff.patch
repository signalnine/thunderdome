+{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_013d6MkTdAjGzyp4NFaNemGR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JaX2y1JQcP1rTUTUiYUBNK","name":"Write","input":{"file_path":"/workspace/tests/server.test.ts","content":"import { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport request from 'supertest';\nimport { WebSocket } from 'ws';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { randomUUID } from 'node:crypto';\nimport { existsSync, rmSync } from 'node:fs';\nimport { createApp, type CollabServer } from '../src/server.js';\n\nlet inst: CollabServer;\nlet port: number;\n\nbeforeEach(async () => {\n  inst = createApp();\n  port = await inst.start(0);\n});\n\nafterEach(async () => {\n  await inst.stop();\n});\n\n// ----- WebSocket helpers -------------------------------------------------\n\nfunction connect(documentId: string): WebSocket {\n  return new WebSocket(`ws://127.0.0.1:${port}/documents/${documentId}/ws`);\n}\n\nfunction nextMessage(ws: WebSocket): Promise<any> {\n  return new Promise((resolve, reject) => {\n    const onMsg = (data: Buffer) => {\n      cleanup();\n      resolve(JSON.parse(data.toString()));\n    };\n    const onErr = (e: Error) => {\n      cleanup();\n      reject(e);\n    };\n    const cleanup = () => {\n      ws.off('message', onMsg);\n      ws.off('error', onErr);\n    };\n    ws.on('message', onMsg);\n    ws.on('error', onErr);\n  });\n}\n\nfunction open(ws: WebSocket): Promise<void> {\n  return new Promise((resolve, reject) => {\n    if (ws.readyState === WebSocket.OPEN) return resolve();\n    ws.once('open', () => resolve());\n    ws.once('error', reject);\n  });\n}\n\nfunction closed(ws: WebSocket): Promise<void> {\n  return new Promise((resolve) => {\n    if (ws.readyState === WebSocket.CLOSED) return resolve();\n    ws.once('close', () => resolve());\n  });\n}\n\n// Collect messages of a given type until predicate is satisfied.\nfunction collect(ws: WebSocket, predicate: (msgs: any[]) => boolean): Promise<any[]> {\n  return new Promise((resolve) => {\n    const msgs: any[] = [];\n    const onMsg = (data: Buffer) => {\n      msgs.push(JSON.parse(data.toString()));\n      if (predicate(msgs)) {\n        ws.off('message', onMsg);\n        resolve(msgs);\n      }\n    };\n    ws.on('message', onMsg);\n  });\n}\n\n// ----- REST tests --------------------------------------------------------\n\ndescribe('REST API', () => {\n  it('createApp returns the documented shape', () => {\n    expect(typeof inst.start).toBe('function');\n    expect(typeof inst.stop).toBe('function');\n    expect(inst.app).toBeDefined();\n    expect(inst.wss).toBeDefined();\n  });\n\n  it('POST /documents creates a document', async () => {\n    const res = await request(inst.app).post('/documents').send({ title: 'Doc', content: 'hi' });\n    expect(res.status).toBe(201);\n    expect(res.body).toMatchObject({ title: 'Doc', content: 'hi', version: 0 });\n    expect(res.body.id).toBeTruthy();\n  });\n\n  it('POST /documents rejects missing title', async () => {\n    expect((await request(inst.app).post('/documents').send({})).status).toBe(400);\n    expect((await request(inst.app).post('/documents').send({ title: '' })).status).toBe(400);\n    expect((await request(inst.app).post('/documents').send({ title: 'x', content: 5 })).status).toBe(400);\n  });\n\n  it('GET /documents lists documents', async () => {\n    await request(inst.app).post('/documents').send({ title: 'a' });\n    await request(inst.app).post('/documents').send({ title: 'b' });\n    const res = await request(inst.app).get('/documents');\n    expect(res.status).toBe(200);\n    expect(res.body.length).toBe(2);\n  });\n\n  it('GET /documents/:id returns a doc or 404', async () => {\n    const { body } = await request(inst.app).post('/documents').send({ title: 'a' });\n    expect((await request(inst.app).get(`/documents/${body.id}`)).status).toBe(200);\n    expect((await request(inst.app).get('/documents/nope')).status).toBe(404);\n  });\n\n  it('PUT /documents/:id updates content and creates a version', async () => {\n    const { body } = await request(inst.app).post('/documents').send({ title: 'a', content: 'x' });\n    const res = await request(inst.app).put(`/documents/${body.id}`).send({ content: 'xy', title: 'b' });\n    expect(res.status).toBe(200);\n    expect(res.body.content).toBe('xy');\n    expect(res.body.title).toBe('b');\n    expect(res.body.version).toBe(1);\n    const versions = await request(inst.app).get(`/documents/${body.id}/versions`);\n    expect(versions.body.length).toBe(2);\n  });\n\n  it('DELETE /documents/:id removes a doc', async () => {\n    const { body } = await request(inst.app).post('/documents').send({ title: 'a' });\n    expect((await request(inst.app).delete(`/documents/${body.id}`)).status).toBe(204);\n    expect((await request(inst.app).get(`/documents/${body.id}`)).status).toBe(404);\n    expect((await request(inst.app).delete('/documents/nope')).status).toBe(404);\n  });\n\n  it('GET /documents/:id/versions returns history', async () => {\n    const { body } = await request(inst.app).post('/documents').send({ title: 'a', content: 'x' });\n    const res = await request(inst.app).get(`/documents/${body.id}/versions`);\n    expect(res.status).toBe(200);\n    expect(res.body[0].version).toBe(0);\n  });\n});\n\n// ----- WebSocket tests ---------------------------------------------------\n\nasync function makeDoc(title = 'Doc', content = ''): Promise<string> {\n  const res = await request(inst.app).post('/documents').send({ title, content });\n  return res.body.id;\n}\n\ndescribe('WebSocket realtime', () => {\n  it('sends a sync message on connect', async () => {\n    const id = await makeDoc('Doc', 'hello');\n    const ws = connect(id);\n    await open(ws);\n    const msg = await nextMessage(ws);\n    expect(msg).toMatchObject({ type: 'sync', documentId: id, version: 0, content: 'hello' });\n    ws.close();\n  });\n\n  it('rejects connecting to an unknown document', async () => {\n    const ws = connect('does-not-exist');\n    await open(ws);\n    const msg = await nextMessage(ws);\n    expect(msg).toMatchObject({ type: 'error' });\n    await closed(ws);\n  });\n\n  it('applies an op and broadcasts it to all clients', async () => {\n    const id = await makeDoc('Doc', 'hello');\n    const a = connect(id);\n    const b = connect(id);\n    await Promise.all([open(a), open(b)]);\n    await nextMessage(a); // sync\n    await nextMessage(b); // sync\n\n    const bGotOp = nextMessage(b);\n    a.send(JSON.stringify({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 5, text: ' world' } }));\n    const msg = await bGotOp;\n    expect(msg.type).toBe('op');\n    expect(msg.version).toBe(1);\n\n    // Verify convergence via REST.\n    const res = await request(inst.app).get(`/documents/${id}`);\n    expect(res.body.content).toBe('hello world');\n    a.close();\n    b.close();\n  });\n\n  it('replies with an error on malformed op and does not crash', async () => {\n    const id = await makeDoc('Doc', 'hi');\n    const ws = connect(id);\n    await open(ws);\n    await nextMessage(ws); // sync\n\n    const err1 = nextMessage(ws);\n    ws.send('not json{{');\n    expect((await err1).type).toBe('error');\n\n    const err2 = nextMessage(ws);\n    ws.send(JSON.stringify({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 99, text: 'x' } }));\n    expect((await err2).type).toBe('error');\n\n    const err3 = nextMessage(ws);\n    ws.send(JSON.stringify({ type: 'frobnicate' }));\n    expect((await err3).type).toBe('error');\n\n    // Server still works after errors.\n    const ok = nextMessage(ws);\n    ws.send(JSON.stringify({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 0, text: 'X' } }));\n    expect((await ok).type).toBe('op');\n    ws.close();\n  });\n\n  it('two concurrent inserts off the same base both survive and converge', async () => {\n    const id = await makeDoc('Doc', 'hello');\n    const a = connect(id);\n    const b = connect(id);\n    await Promise.all([open(a), open(b)]);\n    await nextMessage(a);\n    await nextMessage(b);\n\n    // Both base off version 0 and insert at the end \"simultaneously\".\n    a.send(JSON.stringify({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 5, text: 'AAA' } }));\n    b.send(JSON.stringify({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 5, text: 'BBB' } }));\n\n    // Wait until the document reaches version 2.\n    await new Promise((r) => setTimeout(r, 200));\n    const res = await request(inst.app).get(`/documents/${id}`);\n    expect(res.body.version).toBe(2);\n    expect(res.body.content).toContain('AAA');\n    expect(res.body.content).toContain('BBB');\n    expect(res.body.content.length).toBe('hello'.length + 6);\n    a.close();\n    b.close();\n  });\n\n  it('handles 10 concurrent clients editing the same document without loss', async () => {\n    const id = await makeDoc('Doc', '');\n    const N = 10;\n    const sockets: WebSocket[] = [];\n    for (let i = 0; i < N; i++) sockets.push(connect(id));\n    await Promise.all(sockets.map(open));\n    await Promise.all(sockets.map(nextMessage)); // syncs\n\n    // Each client inserts its unique char at position 0, all based on version 0.\n    for (let i = 0; i < N; i++) {\n      sockets[i].send(\n        JSON.stringify({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 0, text: String.fromCharCode(65 + i) } }),\n      );\n    }\n\n    // Wait for the document to reach version N.\n    await new Promise((r) => setTimeout(r, 400));\n    const res = await request(inst.app).get(`/documents/${id}`);\n    expect(res.body.version).toBe(N);\n    expect(res.body.content.length).toBe(N);\n    for (let i = 0; i < N; i++) {\n      expect(res.body.content).toContain(String.fromCharCode(65 + i));\n    }\n    sockets.forEach((s) => s.close());\n  });\n\n  it('all clients converge to the same final content (broadcast order)', async () => {\n    const id = await makeDoc('Doc', 'start');\n    const a = connect(id);\n    const b = connect(id);\n    await Promise.all([open(a), open(b)]);\n    await nextMessage(a);\n    await nextMessage(b);\n\n    // Each client tracks its own copy by applying broadcast ops in arrival order.\n    const applyClient = (ws: WebSocket, initial: string) => {\n      const state = { content: initial };\n      ws.on('message', (data: Buffer) => {\n        const m = JSON.parse(data.toString());\n        if (m.type === 'op') {\n          for (const op of m.ops) {\n            if (op.type === 'insert') state.content = state.content.slice(0, op.pos) + op.text + state.content.slice(op.pos);\n            else state.content = state.content.slice(0, op.pos) + state.content.slice(op.pos + op.length);\n          }\n        }\n      });\n      return state;\n    };\n    const aState = applyClient(a, 'start');\n    const bState = applyClient(b, 'start');\n\n    a.send(JSON.stringify({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 0, text: 'A' } }));\n    b.send(JSON.stringify({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 5, text: 'B' } }));\n\n    await new Promise((r) => setTimeout(r, 300));\n    const res = await request(inst.app).get(`/documents/${id}`);\n    expect(aState.content).toBe(res.body.content);\n    expect(bState.content).toBe(res.body.content);\n    a.close();\n    b.close();\n  });\n});\n\n// ----- Persistence across restart ---------------------------------------\n\ndescribe('persistence across server restart', () => {\n  const dbFiles: string[] = [];\n  afterEach(() => {\n    for (const f of dbFiles.splice(0)) {\n      for (const ext of ['', '-wal', '-shm']) if (existsSync(f + ext)) rmSync(f + ext);\n    }\n  });\n\n  it('documents and versions survive a full restart', async () => {\n    const path = join(tmpdir(), `coll-srv-${randomUUID()}.db`);\n    dbFiles.push(path);\n\n    const s1 = createApp(path);\n    await s1.start(0);\n    const { body } = await request(s1.app).post('/documents').send({ title: 'Persist', content: 'abc' });\n    await request(s1.app).put(`/documents/${body.id}`).send({ content: 'abcd' });\n    await s1.stop();\n\n    const s2 = createApp(path);\n    await s2.start(0);\n    const res = await request(s2.app).get(`/documents/${body.id}`);\n    expect(res.status).toBe(200);\n    expect(res.body.content).toBe('abcd');\n    expect(res.body.version).toBe(1);\n    const versions = await request(s2.app).get(`/documents/${body.id}/versions`);\n    expect(versions.body.length).toBe(2);\n    await s2.stop();\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":141,"cache_read_input_tokens":62803,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":141},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4525c012-51eb-44ec-a536-36abf1817d46","uuid":"ea99d6a4-fa48-467b-adfe-2e11b0aa9a08","request_id":"req_011CbWDLTpaJse2Zu3BvLo9W"}
