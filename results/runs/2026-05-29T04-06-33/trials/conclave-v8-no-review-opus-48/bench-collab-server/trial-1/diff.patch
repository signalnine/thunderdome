+++ b/tests/ot.test.ts
@@ -0,0 +1,186 @@
+import { describe, it, expect } from 'vitest';
+import {
+  applyOp,
+  applyOps,
+  validateOp,
+  transformOp,
+  transformAgainstHistory,
+  OpError,
+  type Op,
+} from '../src/ot.js';
+
+describe('applyOp', () => {
+  it('inserts text at a position', () => {
+    expect(applyOp('hello', { type: 'insert', pos: 5, text: ' world' })).toBe('hello world');
+    expect(applyOp('hello', { type: 'insert', pos: 0, text: 'X' })).toBe('Xhello');
+    expect(applyOp('ac', { type: 'insert', pos: 1, text: 'b' })).toBe('abc');
+  });
+  it('deletes a range', () => {
+    expect(applyOp('hello world', { type: 'delete', pos: 5, length: 6 })).toBe('hello');
+    expect(applyOp('abc', { type: 'delete', pos: 0, length: 1 })).toBe('bc');
+  });
+});
+
+describe('applyOps', () => {
+  it('applies an ordered sequence', () => {
+    expect(
+      applyOps('', [
+        { type: 'insert', pos: 0, text: 'abc' },
+        { type: 'insert', pos: 3, text: 'def' },
+      ]),
+    ).toBe('abcdef');
+  });
+});
+
+describe('validateOp', () => {
+  it('accepts valid ops', () => {
+    expect(validateOp({ type: 'insert', pos: 0, text: 'a' }, 0)).toEqual({
+      type: 'insert',
+      pos: 0,
+      text: 'a',
+    });
+    expect(validateOp({ type: 'delete', pos: 0, length: 1 }, 3)).toEqual({
+      type: 'delete',
+      pos: 0,
+      length: 1,
+    });
+  });
+  it('rejects malformed ops', () => {
+    expect(() => validateOp(null, 0)).toThrow(OpError);
+    expect(() => validateOp({ type: 'nope' }, 0)).toThrow(OpError);
+    expect(() => validateOp({ type: 'insert', pos: -1, text: 'a' }, 5)).toThrow(OpError);
+    expect(() => validateOp({ type: 'insert', pos: 6, text: 'a' }, 5)).toThrow(OpError);
+    expect(() => validateOp({ type: 'insert', pos: 0, text: '' }, 5)).toThrow(OpError);
+    expect(() => validateOp({ type: 'insert', pos: 0, text: 123 }, 5)).toThrow(OpError);
+    expect(() => validateOp({ type: 'delete', pos: 0, length: 0 }, 5)).toThrow(OpError);
+    expect(() => validateOp({ type: 'delete', pos: 3, length: 5 }, 5)).toThrow(OpError);
+    expect(() => validateOp({ type: 'delete', pos: 1.5, length: 1 }, 5)).toThrow(OpError);
+  });
+});
+
+// Helper: simulate two concurrent ops on the same base, applying each side's op
+// followed by the other side transformed, and assert both sides converge.
+function assertConverges(base: string, a: Op, b: Op) {
+  const aPrimeArr = transformOp(a, b); // a after b
+  const bPrimeArr = transformOp(b, a); // b after a
+  const left = applyOps(applyOp(base, b), aPrimeArr);
+  const right = applyOps(applyOp(base, a), bPrimeArr);
+  expect(left).toBe(right);
+  return left;
+}
+
+describe('transformOp convergence', () => {
+  it('insert vs insert: both preserved, deterministic', () => {
+    const result = assertConverges('hello', { type: 'insert', pos: 5, text: 'A' }, {
+      type: 'insert',
+      pos: 5,
+      text: 'B',
+    });
+    expect(result).toContain('A');
+    expect(result).toContain('B');
+  });
+
+  it('insert vs insert at different positions', () => {
+    assertConverges('hello world', { type: 'insert', pos: 0, text: 'X' }, {
+      type: 'insert',
+      pos: 5,
+      text: 'Y',
+    });
+  });
+
+  it('insert vs delete', () => {
+    assertConverges('hello world', { type: 'insert', pos: 8, text: 'X' }, {
+      type: 'delete',
+      pos: 0,
+      length: 6,
+    });
+  });
+
+  it('insert inside a deleted range collapses to range start', () => {
+    assertConverges('hello world', { type: 'insert', pos: 3, text: 'X' }, {
+      type: 'delete',
+      pos: 0,
+      length: 6,
+    });
+  });
+
+  it('delete vs delete, overlapping', () => {
+    assertConverges('abcdefgh', { type: 'delete', pos: 1, length: 4 }, {
+      type: 'delete',
+      pos: 3,
+      length: 4,
+    });
+  });
+
+  it('delete vs delete, identical (one fully cancelled)', () => {
+    assertConverges('abcdefgh', { type: 'delete', pos: 2, length: 3 }, {
+      type: 'delete',
+      pos: 2,
+      length: 3,
+    });
+  });
+
+  it('delete vs delete, disjoint', () => {
+    assertConverges('abcdefgh', { type: 'delete', pos: 0, length: 2 }, {
+      type: 'delete',
+      pos: 5,
+      length: 2,
+    });
+  });
+
+  it('delete split by a concurrent insert preserves the inserted text', () => {
+    const base = 'abcdef';
+    const del: Op = { type: 'delete', pos: 1, length: 4 }; // would delete bcde
+    const ins: Op = { type: 'insert', pos: 3, text: 'XYZ' }; // insert inside range
+    const result = assertConverges(base, del, ins);
+    expect(result).toContain('XYZ'); // inserted text survives the delete
+    expect(result).toBe('aXYZf');
+  });
+});
+
+describe('transformAgainstHistory convergence (server-side replay)', () => {
+  it('two concurrent inserts off the same base converge & preserve both', () => {
+    // base v0 = 'hello'. Client A inserts ' A' at 5 -> applied as v1.
+    // Client B (still at v0) inserts ' B' at 5 -> must be rebased past v1.
+    const base = 'hello';
+    const opA: Op = { type: 'insert', pos: 5, text: ' A' };
+    const v1 = applyOp(base, opA);
+    const opB: Op = { type: 'insert', pos: 5, text: ' B' };
+    const rebased = transformAgainstHistory([opB], [[opA]]);
+    const v2 = applyOps(v1, rebased);
+    expect(v2).toContain(' A');
+    expect(v2).toContain(' B');
+    expect(v2.length).toBe('hello'.length + ' A'.length + ' B'.length);
+  });
+
+  it('many concurrent inserts at the same position all survive', () => {
+    const base = '';
+    const n = 10;
+    const history: Op[][] = [];
+    let content = base;
+    let result = content;
+    // Apply n inserts each based on v0, server replays each past prior ones.
+    for (let i = 0; i < n; i++) {
+      const op: Op = { type: 'insert', pos: 0, text: String.fromCharCode(65 + i) };
+      const rebased = transformAgainstHistory([op], history);
+      result = applyOps(result, rebased);
+      history.push(rebased);
+    }
+    // All 10 distinct characters preserved.
+    expect(result.length).toBe(n);
+    for (let i = 0; i < n; i++) {
+      expect(result).toContain(String.fromCharCode(65 + i));
+    }
+  });
+
+  it('a delete rebased past a concurrent insert that split it', () => {
+    // v0 = 'abcdef'. v1: insert 'XYZ' at 3. Client at v0 sends delete(1,4).
+    const v0 = 'abcdef';
+    const ins: Op = { type: 'insert', pos: 3, text: 'XYZ' };
+    const v1 = applyOp(v0, ins);
+    const del: Op = { type: 'delete', pos: 1, length: 4 };
+    const rebased = transformAgainstHistory([del], [[ins]]);
+    const v2 = applyOps(v1, rebased);
+    expect(v2).toBe('aXYZf');
+  });
+});
