new file mode 100644
index 0000000..5e33cbe
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,160 @@
+// Operational Transform core.
+//
+// Operations are single primitive edits against a string:
+//   - insert: insert `text` at `position`
+//   - delete: remove `length` characters starting at `position`
+//
+// The server is the single source of truth: incoming operations are transformed
+// against the history of operations applied since the client's base version,
+// then applied and broadcast. This guarantees all clients converge.
+
+export interface InsertOp {
+  type: 'insert';
+  position: number;
+  text: string;
+}
+
+export interface DeleteOp {
+  type: 'delete';
+  position: number;
+  length: number;
+}
+
+export type Operation = InsertOp | DeleteOp;
+
+export interface ValidationResult {
+  ok: boolean;
+  error?: string;
+  op?: Operation;
+}
+
+function isInteger(n: unknown): n is number {
+  return typeof n === 'number' && Number.isFinite(n) && Number.isInteger(n);
+}
+
+/**
+ * Validate and normalize an untrusted operation payload.
+ */
+export function validateOp(raw: unknown): ValidationResult {
+  if (raw === null || typeof raw !== 'object') {
+    return { ok: false, error: 'operation must be an object' };
+  }
+  const op = raw as Record<string, unknown>;
+  if (op.type === 'insert') {
+    if (!isInteger(op.position) || (op.position as number) < 0) {
+      return { ok: false, error: 'insert.position must be a non-negative integer' };
+    }
+    if (typeof op.text !== 'string') {
+      return { ok: false, error: 'insert.text must be a string' };
+    }
+    if (op.text.length === 0) {
+      return { ok: false, error: 'insert.text must not be empty' };
+    }
+    return { ok: true, op: { type: 'insert', position: op.position as number, text: op.text } };
+  }
+  if (op.type === 'delete') {
+    if (!isInteger(op.position) || (op.position as number) < 0) {
+      return { ok: false, error: 'delete.position must be a non-negative integer' };
+    }
+    if (!isInteger(op.length) || (op.length as number) <= 0) {
+      return { ok: false, error: 'delete.length must be a positive integer' };
+    }
+    return {
+      ok: true,
+      op: { type: 'delete', position: op.position as number, length: op.length as number },
+    };
+  }
+  return { ok: false, error: "operation.type must be 'insert' or 'delete'" };
+}
+
+/**
+ * Apply an operation to a document string. Positions/lengths are clamped to the
+ * valid range so a malformed-but-typed op can never throw or corrupt state.
+ */
+export function apply(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    const pos = Math.max(0, Math.min(op.position, content.length));
+    return content.slice(0, pos) + op.text + content.slice(pos);
+  }
+  // delete
+  const pos = Math.max(0, Math.min(op.position, content.length));
+  const len = Math.max(0, Math.min(op.length, content.length - pos));
+  return content.slice(0, pos) + content.slice(pos + len);
+}
+
+/**
+ * Transform operation `a` so it can be applied *after* operation `b` has already
+ * been applied to the same base document. Returns the adjusted `a`.
+ *
+ * Insertions are never dropped. The single-op result for the rare
+ * "delete spanning a concurrent insert" case shrinks the delete so the inserted
+ * text is preserved.
+ */
+export function transform(a: Operation, b: Operation): Operation {
+  if (a.type === 'insert' && b.type === 'insert') {
+    if (a.position < b.position) return a;
+    if (a.position > b.position) return { ...a, position: a.position + b.text.length };
+    // Same position: break the tie deterministically so transform(a,b) and
+    // transform(b,a) agree on order regardless of application order (TP1).
+    if (a.text < b.text) return a;
+    return { ...a, position: a.position + b.text.length };
+  }
+
+  if (a.type === 'insert' && b.type === 'delete') {
+    if (a.position <= b.position) return a;
+    if (a.position > b.position + b.length) {
+      return { ...a, position: a.position - b.length };
+    }
+    // insert fell inside the deleted range -> collapse to delete start
+    return { ...a, position: b.position };
+  }
+
+  if (a.type === 'delete' && b.type === 'insert') {
+    const aEnd = a.position + a.length;
+    if (b.position >= aEnd) return a;
+    if (b.position <= a.position) {
+      return { ...a, position: a.position + b.text.length };
+    }
+    // insert landed strictly inside a's delete range: shrink the delete so the
+    // newly inserted text survives (preserve insertions).
+    return { ...a, length: b.position - a.position };
+  }
+
+  // delete vs delete
+  const aDel = a as DeleteOp;
+  const bDel = b as DeleteOp;
+  const aStart = aDel.position;
+  const aEnd = aDel.position + aDel.length;
+  const bStart = bDel.position;
+  const bEnd = bDel.position + bDel.length;
+
+  if (bEnd <= aStart) {
+    // b entirely before a -> shift a left
+    return { type: 'delete', position: aStart - bDel.length, length: aDel.length };
+  }
+  if (bStart >= aEnd) {
+    // b entirely after a -> unaffected
+    return aDel;
+  }
+  // overlap: remove the overlapping characters from a's deletion
+  const overlapStart = Math.max(aStart, bStart);
+  const overlapEnd = Math.min(aEnd, bEnd);
+  const overlapLen = overlapEnd - overlapStart;
+  const removedBefore = bStart < aStart ? Math.min(bEnd, aStart) - bStart : 0;
+  const newPos = aStart - removedBefore;
+  const newLen = Math.max(0, aDel.length - overlapLen);
+  return { type: 'delete', position: newPos, length: newLen };
+}
+
+/**
+ * Transform `op` against an ordered list of operations that have been applied
+ * since `op`'s base version. Null entries (e.g. wholesale REST replacements) are
+ * treated as identity.
+ */
+export function transformAgainst(op: Operation, history: Array<Operation | null>): Operation {
+  let result = op;
+  for (const h of history) {
+    if (h) result = transform(result, h);
+  }
+  return result;
+}
