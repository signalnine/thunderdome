+        JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, text: letters[i] }, version: 0 })
+      );
+    }
+    await new Promise((r) => setTimeout(r, 600));
+    const doc = await request(srv.app).get(`/documents/${id}`);
+    expect(doc.body.version).toBe(N);
+    expect(doc.body.content.length).toBe(N);
+    for (const ch of letters) expect(doc.body.content).toContain(ch);
+    await Promise.all(clients.map((c) => (c.close(), waitClosed(c))));
