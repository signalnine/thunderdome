    ws.send(\n      JSON.stringify({ type: 'op', op: { type: 'insert', position: 2, text: 'c' }, version: sync1.version })\n    );\n    const applied = await take();\n    expect(applied.type).toBe('op');\n    ws.close();\n    await srv.stop();","originalFile":"import { describe, it, expect, afterEach } from 'vitest';\nimport request from 'supertest';\nimport { WebSocket } from 'ws';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { rmSync } from 'node:fs';\nimport { randomUUID } from 'node:crypto';\nimport { createApp, CollabServer } from './server.js';\n\nlet dbPath: string;\n\nafterEach(() => {\n  for (const suffix of ['', '-wal', '-shm']) {\n    try {\n      rmSync(dbPath + suffix, { force: true });\n    } catch {\n      /* ignore */\n    }\n  }\n});\n\ndescribe('persistence across restart', () => {\n  it('retains documents, content and version history after stop + reopen', async () => {\n    dbPath = join(tmpdir(), `collab-${randomUUID()}.db`);\n\n    // --- session 1: create, edit via REST and WS ---\n    let srv: CollabServer = createApp(dbPath);\n    let port = await srv.start(0);\n    const created = await request(srv.app).post('/documents').send({ title: 'Persist', content: 'a' });\n    const id = created.body.id;\n    await request(srv.app).put(`/documents/${id}`).send({ content: 'ab' });\n\n    // a WS edit too\n    const ws = new WebSocket(`ws://127.0.0.1:${port}/documents/${id}`);\n    await new Promise<void>((res, rej) => {\n      ws.once('open', () => res());\n      ws.once('error', rej);\n    });\n    // wait for sync, then send op based on the synced version\n    const sync1 = await new Promise<Record<string, unknown>>((res) =>\n      ws.once('message', (d: Buffer) => res(JSON.parse(d.toString())))\n    );\n    expect(sync1.version).toBe(1); // 0 (create) + 1 (PUT)\n    ws.send(\n      JSON.stringify({ type: 'op', op: { type: 'insert', position: 2, text: 'c' }, version: sync1.version })\n    );\n    await new Promise<void>((res) => ws.once('message', () => res()));\n    ws.close();\n    await srv.stop();\n\n    // --- session 2: reopen same db file ---\n    srv = createApp(dbPath);\n    port = await srv.start(0);\n    const doc = await request(srv.app).get(`/documents/${id}`);\n    expect(doc.status).toBe(200);\n    expect(doc.body.content).toBe('abc');\n    expect(doc.body.version).toBe(2);\n\n    const versions = await request(srv.app).get(`/documents/${id}/versions`);\n    expect(versions.body.length).toBe(3); // v0 (create), v1 (PUT), v2 (WS op)\n\n    // a new WS client should sync to the persisted state and be able to keep editing\n    const ws2 = new WebSocket(`ws://127.0.0.1:${port}/documents/${id}`);\n    const sync = await new Promise<Record<string, unknown>>((res, rej) => {\n      ws2.once('error', rej);\n      ws2.once('message', (d: Buffer) => res(JSON.parse(d.toString())));\n    });\n    expect(sync.content).toBe('abc');\n    expect(sync.version).toBe(2);\n    ws2.close();\n    await srv.stop();\n  });\n});\n","structuredPatch":[{"oldStart":30,"oldLines":21,"newStart":30,"newLines":29,"lines":["     const id = created.body.id;","     await request(srv.app).put(`/documents/${id}`).send({ content: 'ab' });"," ","-    // a WS edit too","+    // a WS edit too (queue messages to avoid racing the immediate sync)","     const ws = new WebSocket(`ws://127.0.0.1:${port}/documents/${id}`);","+    const q: Record<string, unknown>[] = [];","+    const wake: (() => void)[] = [];","+    ws.on('message', (d: Buffer) => {","+      q.push(JSON.parse(d.toString()));","+      wake.shift()?.();","+    });","+    const take = async (): Promise<Record<string, unknown>> => {","+      if (q.length === 0) await new Promise<void>((r) => wake.push(r));","+      return q.shift()!;","+    };","     await new Promise<void>((res, rej) => {","       ws.once('open', () => res());","       ws.once('error', rej);","     });","-    // wait for sync, then send op based on the synced version","-    const