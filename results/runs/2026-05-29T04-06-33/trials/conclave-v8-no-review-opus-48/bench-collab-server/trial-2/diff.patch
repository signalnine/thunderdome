itle: 'A', content: 'old' });\n    const id = c.body.id;\n    const r = await request(srv.app).put(`/documents/${id}`).send({ content: 'new' });\n    expect(r.status).toBe(200);\n    expect(r.body.content).toBe('new');\n    expect(r.body.version).toBe(1);\n    const versions = await request(srv.app).get(`/documents/${id}/versions`);\n    expect(versions.body.length).toBe(2); // v0 + v1\n    expect((await request(srv.app).put('/documents/nope').send({ content: 'x' })).status).toBe(404);\n  });\n\n  it('deletes a document (204) then 404', async () => {\n    const c = await request(srv.app).post('/documents').send({ title: 'A' });\n    const id = c.body.id;\n    expect((await request(srv.app).delete(`/documents/${id}`)).status).toBe(204);\n    expect((await request(srv.app).get(`/documents/${id}`)).status).toBe(404);\n  });\n\n  it('serves version history and specific versions', async () => {\n    const c = await request(srv.app).post('/documents').send({ title: 'A', content: 'v0' });\n    const id = c.body.id;\n    await request(srv.app).put(`/documents/${id}`).send({ content: 'v1' });\n    const all = await request(srv.app).get(`/documents/${id}/versions`);\n    expect(all.body.length).toBe(2);\n    const v0 = await request(srv.app).get(`/documents/${id}/versions/0`);\n    expect(v0.body.content).toBe('v0');\n    expect((await request(srv.app).get(`/documents/${id}/versions/99`)).status).toBe(404);\n  });\n});\n\ndescribe('WebSocket collaboration', () => {\n  async function makeDoc(content = ''): Promise<string> {\n    const r = await request(srv.app).post('/documents').send({ title: 'WS', content });\n    return r.body.id;\n  }\n\n  it('sends a sync message on connect', async () => {\n    const id = await makeDoc('hello');\n    const ws = connect(id);\n    await open(ws);\n    const msg = await nextMessage(ws);\n    expect(msg.type).toBe('sync');\n    expect(msg.content).toBe('hello');\n    expect(msg.version).toBe(0);\n    ws.close();\n    await waitClosed(ws);\n  