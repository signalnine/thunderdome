+    const all = await request(srv.app).get(`/documents/${id}/versions`);
+    expect(all.body.length).toBe(2);
+    const v0 = await request(srv.app).get(`/documents/${id}/versions/0`);
+    expect(v0.body.content).toBe('v0');
+    expect((await request(srv.app).get(`/documents/${id}/versions/99`)).status).toBe(404);
+  });
+});
+
+describe('WebSocket collaboration', () => {
+  async function makeDoc(content = ''): Promise<string> {
+    const r = await request(srv.app).post('/documents').send({ title: 'WS', content });
+    return r.body.id;
+  }
+
+  it('sends a sync message on connect', async () => {
+    const id = await makeDoc('hello');
+    const ws = connect(id);
+    await open(ws);
+    const msg = await nextMessage(ws);
+    expect(msg.type).toBe('sync');
+    expect(msg.content).toBe('hello');
+    expect(msg.version).toBe(0);
+    ws.close();
+    await waitClosed(ws);
+  });
+
+  it('errors and closes for unknown document', async () => {
+    const ws = connect('does-not-exist');
+    await open(ws);
+    const msg = await nextMessage(ws);
+    expect(msg.type).toBe('error');
+    await waitClosed(ws);
+  });
+
+  it('applies an op, broadcasts it, and persists it', async () => {
+    const id = await makeDoc('');
+    const ws = connect(id);
+    await open(ws);
+    await nextMessage(ws); // sync
+    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, text: 'abc' }, version: 0 }));
+    const applied = await nextMessage(ws);
+    expect(applied.type).toBe('op');
+    expect(applied.version).toBe(1);
+    // persisted
+    const r = await request(srv.app).get(`/documents/${id}`);
+    expect(r.body.content).toBe('abc');
+    expect(r.body.version).toBe(1);
+    ws.close();
+    await waitClosed(ws);
+  });
+
+  it('broadcasts one client edit to another client', async () => {
+    const id = await makeDoc('');
+    const a = connect(id);
+    const b = connect(id);
+    await Promise.all([open(a), open(b)]);
+    await Promise.all([nextMessage(a), nextMessage(b)]); // syncs
+    const bGot = nextMessage(b);
+    a.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, text: 'X' }, version: 0 }));
+    const msg = await bGot;
+    expect(msg.type).toBe('op');
+    expect((msg.op as Record<string, unknown>).text).toBe('X');
+    a.close();
+    b.close();
+    await Promise.all([waitClosed(a), waitClosed(b)]);
+  });
+
+  it('rejects malformed op without crashing, keeps connection open', async () => {
+    const id = await makeDoc('hi');
+    const ws = connect(id);
+    await open(ws);
+    await nextMessage(ws); // sync
+    ws.send(JSON.stringify({ type: 'op', op: { type: 'frobnicate' }, version: 0 }));
+    const err = await nextMessage(ws);
+    expect(err.type).toBe('error');
+    // connection still works: send a valid op
+    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, text: 'Z' }, version: 0 }));
+    const ok = await nextMessage(ws);
+    expect(ok.type).toBe('op');
+    ws.close();
+    await waitClosed(ws);
+  });
+
+  it('rejects invalid base version gracefully', async () => {
+    const id = await makeDoc('');
+    const ws = connect(id);
+    await open(ws);
+    await nextMessage(ws);
+    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, text: 'x' }, version: 999 }));
+    const err = await nextMessage(ws);
+    expect(err.type).toBe('error');
+    ws.close();
+    await waitClosed(ws);
+  });
+
+  it('rejects invalid JSON gracefully', async () => {
+    const id = await makeDoc('');
+    const ws = connect(id);
+    await open(ws);
+    await nextMessage(ws);
+    ws.send('not json{');
+    const err = await nextMessage(ws);
+    expect(err.type).toBe('error');
+    ws.close();
+    await waitClosed(ws);
+  });
+});
+
+describe('concurrency & convergence', () => {
+  async function makeDoc(content = ''): Promise<string> {
+    const r = await request(srv.app).post('/documents').send({ title: 'C', content });
+    return r.body.id;
+  }
+
+  it('two concurrent inserts at same base preserve both texts', async () => {
+    const id = await makeDoc('');
+    const a = connect(id);
+    const b = connect(id);
+    await Promise.all([open(a), open(b)]);
+    await Promise.all([nextMessage(a), nextMessage(b)]);
+    // both base on version 0
+    a.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, text: 'AAA' }, version: 0 }));
+    b.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, text: 'BBB' }, version: 0 }));
+    // wait until server has applied 2 ops
+    await new Promise((r) => setTimeout(r, 300));
+    const doc = await request(srv.app).get(`/documents/${id}`);
+    expect(doc.body.version).toBe(2);
+    expect(doc.body.content).toContain('AAA');
+    expect(doc.body.content).toContain('BBB');
+    expect(doc.body.content.length).toBe(6);
+    a.close();
+    b.close();
+    await Promise.all([waitClosed(a), waitClosed(b)]);
+  });
+
+  it('handles 10 concurrent clients each inserting without corruption', async () => {
+    const id = await makeDoc('');
+    const N = 10;
+    const clients: WebSocket[] = [];
