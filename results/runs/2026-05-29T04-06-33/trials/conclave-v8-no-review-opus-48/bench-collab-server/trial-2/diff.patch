diff --git a/src/db.ts b/src/db.ts
new file mode 100644
index 0000000..7735c91
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,129 @@
+import Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+
+export interface DocumentRow {
+  id: string;
+  title: string;
+  content: string;
+  version: number;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface VersionRow {
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS documents (
+  id TEXT PRIMARY KEY,
+  title TEXT NOT NULL,
+  content TEXT NOT NULL DEFAULT '',
+  version INTEGER NOT NULL DEFAULT 0,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  updated_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+
+CREATE TABLE IF NOT EXISTS versions (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  version INTEGER NOT NULL,
+  content TEXT NOT NULL,
+  operation TEXT,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  UNIQUE(document_id, version)
+);
+`;
+
+export class Store {
+  readonly db: Database.Database;
+
+  constructor(dbPath = ':memory:') {
+    this.db = new Database(dbPath);
+    this.db.pragma('journal_mode = WAL');
+    this.db.pragma('foreign_keys = ON');
+    this.db.exec(SCHEMA);
+  }
+
+  createDocument(title: string, content = ''): DocumentRow {
+    const id = randomUUID();
+    const insertDoc = this.db.prepare(
+      'INSERT INTO documents (id, title, content, version) VALUES (?, ?, ?, 0)'
+    );
+    const insertVersion = this.db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)'
+    );
+    const tx = this.db.transaction(() => {
+      insertDoc.run(id, title, content);
+      insertVersion.run(id, content);
+    });
+    tx();
+    return this.getDocument(id)!;
+  }
+
+  getDocument(id: string): DocumentRow | undefined {
+    return this.db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as
+      | DocumentRow
+      | undefined;
+  }
+
+  listDocuments(): DocumentRow[] {
+    return this.db
+      .prepare('SELECT * FROM documents ORDER BY created_at DESC')
+      .all() as DocumentRow[];
+  }
+
+  /**
+   * Persist a new committed version of a document. `operation` is the JSON of the
+   * (transformed) op that produced this version, or null for a wholesale replace.
+   */
+  commitVersion(
+    id: string,
+    version: number,
+    content: string,
+    operation: string | null
+  ): void {
+    const updateDoc = this.db.prepare(
+      "UPDATE documents SET content = ?, version = ?, updated_at = datetime('now') WHERE id = ?"
+    );
+    const insertVersion = this.db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+    );
+    const tx = this.db.transaction(() => {
+      updateDoc.run(content, version, id);
+      insertVersion.run(id, version, content, operation);
+    });
+    tx();
+  }
+
+  deleteDocument(id: string): boolean {
+    const tx = this.db.transaction(() => {
+      this.db.prepare('DELETE FROM versions WHERE document_id = ?').run(id);
+      return this.db.prepare('DELETE FROM documents WHERE id = ?').run(id);
+    });
+    return tx().changes > 0;
+  }
+
+  listVersions(id: string): VersionRow[] {
+    return this.db
+      .prepare(
+        'SELECT version, content, operation, created_at FROM versions WHERE document_id = ? ORDER BY version ASC'
+      )
+      .all(id) as VersionRow[];
+  }
+
+  getVersion(id: string, version: number): VersionRow | undefined {
+    return this.db
+      .prepare(
+        'SELECT version, content, operation, created_at FROM versions WHERE document_id = ? AND version = ?'
+      )
+      .get(id, version) as VersionRow | undefined;
+  }
+
+  close(): void {
+    this.db.close();
+  }
+}
diff --git a/src/ot.test.ts b/src/ot.test.ts
new file mode 100644
index 0000000..328a268
--- /dev/null
+++ b/src/ot.test.ts
@@ -0,0 +1,132 @@
+import { describe, it, expect } from 'vitest';
+import { apply, transform, validateOp, Operation } from './ot.js';
+
+describe('apply', () => {
+  it('inserts text at a position', () => {
+    expect(apply('hello', { type: 'insert', position: 5, text: ' world' })).toBe('hello world');
+    expect(apply('ac', { type: 'insert', position: 1, text: 'b' })).toBe('abc');
+  });
+
+  it('clamps insert position into range', () => {
+    expect(apply('ab', { type: 'insert', position: 99, text: 'X' })).toBe('abX');
+    expect(apply('ab', { type: 'insert', position: -5, text: 'X' })).toBe('Xab');
+  });
+
+  it('deletes a range', () => {
+    expect(apply('hello world', { type: 'delete', position: 5, length: 6 })).toBe('hello');
+    expect(apply('abc', { type: 'delete', position: 1, length: 1 })).toBe('ac');
+  });
+
+  it('clamps delete length into range', () => {
+    expect(apply('abc', { type: 'delete', position: 1, length: 99 })).toBe('a');
+    expect(apply('abc', { type: 'delete', position: 5, length: 2 })).toBe('abc');
+  });
+});
+
+describe('validateOp', () => {
+  it('rejects non-objects and unknown types', () => {
+    expect(validateOp(null).ok).toBe(false);
+    expect(validateOp(42).ok).toBe(false);
+    expect(validateOp({ type: 'frobnicate' }).ok).toBe(false);
+  });
+
+  it('rejects bad inserts', () => {
+    expect(validateOp({ type: 'insert', position: -1, text: 'a' }).ok).toBe(false);
+    expect(validateOp({ type: 'insert', position: 1.5, text: 'a' }).ok).toBe(false);
+    expect(validateOp({ type: 'insert', position: 0 }).ok).toBe(false);
+    expect(validateOp({ type: 'insert', position: 0, text: '' }).ok).toBe(false);
+  });
+
+  it('rejects bad deletes', () => {
+    expect(validateOp({ type: 'delete', position: 0, length: 0 }).ok).toBe(false);
+    expect(validateOp({ type: 'delete', position: 0, length: -2 }).ok).toBe(false);
+    expect(validateOp({ type: 'delete', position: 0 }).ok).toBe(false);
+  });
+
+  it('accepts valid ops and normalizes', () => {
+    const r = validateOp({ type: 'insert', position: 2, text: 'hi', extra: 'x' });
+    expect(r.ok).toBe(true);
+    expect(r.op).toEqual({ type: 'insert', position: 2, text: 'hi' });
+  });
+});
+
+describe('transform insert/insert', () => {
+  it('a before b is unchanged', () => {
+    const a: Operation = { type: 'insert', position: 1, text: 'A' };
+    const b: Operation = { type: 'insert', position: 3, text: 'BB' };
+    expect(transform(a, b)).toEqual(a);
+  });
+
+  it('a after b shifts right', () => {
+    const a: Operation = { type: 'insert', position: 5, text: 'A' };
+    const b: Operation = { type: 'insert', position: 2, text: 'BB' };
+    expect(transform(a, b)).toEqual({ type: 'insert', position: 7, text: 'A' });
+  });
+
+  it('converges for concurrent inserts at the same position, preserving both', () => {
+    const base = 'XY';
+    const a: Operation = { type: 'insert', position: 1, text: 'A' };
+    const b: Operation = { type: 'insert', position: 1, text: 'B' };
+    // server order: apply a then transform b against a
+    const r1 = apply(apply(base, a), transform(b, a));
+    // server order: apply b then transform a against b
+    const r2 = apply(apply(base, b), transform(a, b));
+    expect(r1).toBe(r2);
+    expect(r1).toContain('A');
+    expect(r1).toContain('B');
+  });
+});
+
+describe('transform insert vs delete', () => {
+  it('insert before delete is unchanged', () => {
+    const a: Operation = { type: 'insert', position: 1, text: 'A' };
+    const b: Operation = { type: 'delete', position: 3, length: 2 };
+    expect(transform(a, b)).toEqual(a);
+  });
+
+  it('insert after delete shifts left', () => {
+    const a: Operation = { type: 'insert', position: 6, text: 'A' };
+    const b: Operation = { type: 'delete', position: 1, length: 2 };
+    expect(transform(a, b)).toEqual({ type: 'insert', position: 4, text: 'A' });
+  });
+
+  it('insert inside deleted range collapses to delete start', () => {
+    const a: Operation = { type: 'insert', position: 3, text: 'A' };
+    const b: Operation = { type: 'delete', position: 2, length: 4 };
+    expect(transform(a, b)).toEqual({ type: 'insert', position: 2, text: 'A' });
+  });
+});
+
+describe('transform delete vs insert', () => {
+  it('insert before delete shifts delete right', () => {
+    const a: Operation = { type: 'delete', position: 4, length: 2 };
+    const b: Operation = { type: 'insert', position: 1, text: 'BB' };
+    expect(transform(a, b)).toEqual({ type: 'delete', position: 6, length: 2 });
+  });
+
+  it('insert inside delete shrinks delete to preserve insertion', () => {
+    const base = 'abcdef';
+    const a: Operation = { type: 'delete', position: 1, length: 3 }; // remove bcd
+    const b: Operation = { type: 'insert', position: 2, text: 'XX' }; // inside
+    const afterB = apply(base, b); // 'abXXcdef'
+    const result = apply(afterB, transform(a, b));
+    expect(result).toContain('XX'); // insertion preserved
+  });
+});
+
+describe('transform delete vs delete', () => {
+  it('b before a shifts a left', () => {
+    const a: Operation = { type: 'delete', position: 5, length: 2 };
+    const b: Operation = { type: 'delete', position: 1, length: 2 };
+    expect(transform(a, b)).toEqual({ type: 'delete', position: 3, length: 2 });
+  });
+
+  it('overlapping deletes converge without negative length', () => {
+    const base = 'abcdefgh';
+    const a: Operation = { type: 'delete', position: 2, length: 4 }; // cdef
+    const b: Operation = { type: 'delete', position: 4, length: 3 }; // efg
+    const r1 = apply(apply(base, a), transform(b, a));
+    const r2 = apply(apply(base, b), transform(a, b));
+    expect(r1).toBe(r2);
+  });
+});
