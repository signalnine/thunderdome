e(\n      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)'\n    );\n    const tx = this.db.transaction(() => {\n      insertDoc.run(id, title, content);\n      insertVersion.run(id, content);\n    });\n    tx();\n    return this.getDocument(id)!;\n  }\n\n  getDocument(id: string): DocumentRow | undefined {\n    return this.db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as\n      | DocumentRow\n      | undefined;\n  }\n\n  listDocuments(): DocumentRow[] {\n    return this.db\n      .prepare('SELECT * FROM documents ORDER BY created_at DESC')\n      .all() as DocumentRow[];\n  }\n\n  /**\n   * Persist a new committed version of a document. `operation` is the JSON of the\n   * (transformed) op that produced this version, or null for a wholesale replace.\n   */\n  commitVersion(\n    id: string,\n    version: number,\n    content: string,\n    operation: string | null\n  ): void {\n    const updateDoc = this.db.prepare(\n      \"UPDATE documents SET content = ?, version = ?, updated_at = datetime('now') WHERE id = ?\"\n    );\n    const insertVersion = this.db.prepare(\n      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'\n    );\n    const tx = this.db.transaction(() => {\n      updateDoc.run(content, version, id);\n      insertVersion.run(id, version, content, operation);\n    });\n    tx();\n  }\n\n  deleteDocument(id: string): boolean {\n    const tx = this.db.transaction(() => {\n      this.db.prepare('DELETE FROM versions WHERE document_id = ?').run(id);\n      return this.db.prepare('DELETE FROM documents WHERE id = ?').run(id);\n    });\n    return tx().changes > 0;\n  }\n\n  listVersions(id: string): VersionRow[] {\n    return this.db\n      .prepare(\n        'SELECT version, content, operation, created_at FROM versions WHERE document_id = ? ORDER BY version ASC'\n      )\n      .all(id) as VersionRow[];\n  }\n\n  getVersion(id: string, version: number): VersionRow | undefined {\n    return this.db\n      .prepare(\n        'SELECT version, content, operation, created_at FROM versions WHERE document_id = ? AND version = ?'\n      )\n      .get(id, version) as VersionRow | undefined;\n  }\n\n  close(): void {\n    this.db.close();\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
