romise((r) => setTimeout(r, 300));\n    const doc = await request(srv.app).get(`/documents/${id}`);\n    expect(doc.body.version).toBe(2);\n    expect(doc.body.content).toContain('AAA');\n    expect(doc.body.content).toContain('BBB');\n    expect(doc.body.content.length).toBe(6);\n    a.close();\n    b.close();\n    await Promise.all([waitClosed(a), waitClosed(b)]);\n  });\n\n  it('handles 10 concurrent clients each inserting without corruption', async () => {\n    const id = await makeDoc('');\n    const N = 10;\n    const clients: WebSocket[] = [];\n    for (let i = 0; i < N; i++) clients.push(connect(id));\n    await Promise.all(clients.map(open));\n    await Promise.all(clients.map((c) => nextMessage(c))); // syncs\n\n    // each client inserts a unique single char at position 0, all based on version 0\n    const letters = 'ABCDEFGHIJ';\n    for (let i = 0; i < N; i++) {\n      clients[i].send(\n        JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, text: letters[i] }, version: 0 })\n      );\n    }\n    await new Promise((r) => setTimeout(r, 600));\n    const doc = await request(srv.app).get(`/documents/${id}`);\n    expect(doc.body.version).toBe(N);\n    expect(doc.body.content.length).toBe(N);\n    for (const ch of letters) expect(doc.body.content).toContain(ch);\n    await Promise.all(clients.map((c) => (c.close(), waitClosed(c))));\n  });\n});\n","structuredPatch":[{"oldStart":20,"oldLines":11,"newStart":20,"newLines":6,"lines":[" // Messages are buffered from the moment the socket is created so a test never"," // races against the immediate `sync` message the server pushes on connect."," ","-interface Client {","-  ws: WebSocket;","-  next(): Promise<Record<string, unknown>>;","-}","-"," const buffers = new WeakMap<WebSocket, Record<string, unknown>[]>();"," const waiters = new WeakMap<WebSocket, ((m: Record<string, unknown>) => void)[]>();"," "]}],"userModified":false,"replaceAll":false}}
