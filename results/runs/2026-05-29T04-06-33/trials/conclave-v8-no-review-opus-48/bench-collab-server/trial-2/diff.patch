essage(ws);\n    ws.send('not json{');\n    const err = await nextMessage(ws);\n    expect(err.type).toBe('error');\n    ws.close();\n    await waitClosed(ws);\n  });\n});\n\ndescribe('concurrency & convergence', () => {\n  async function makeDoc(content = ''): Promise<string> {\n    const r = await request(srv.app).post('/documents').send({ title: 'C', content });\n    return r.body.id;\n  }\n\n  function collectOps(ws: WebSocket, until: () => boolean): Promise<void> {\n    return new Promise((resolve) => {\n      const onMsg = () => {\n        if (until()) {\n          ws.off('message', onMsg);\n          resolve();\n        }\n      };\n      ws.on('message', onMsg);\n    });\n  }\n\n  it('two concurrent inserts at same base preserve both texts', async () => {\n    const id = await makeDoc('');\n    const a = connect(id);\n    const b = connect(id);\n    await Promise.all([open(a), open(b)]);\n    await Promise.all([nextMessage(a), nextMessage(b)]);\n    // both base on version 0\n    a.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, text: 'AAA' }, version: 0 }));\n    b.send(JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, text: 'BBB' }, version: 0 }));\n    // wait until server has applied 2 ops\n    await new Promise((r) => setTimeout(r, 300));\n    const doc = await request(srv.app).get(`/documents/${id}`);\n    expect(doc.body.version).toBe(2);\n    expect(doc.body.content).toContain('AAA');\n    expect(doc.body.content).toContain('BBB');\n    expect(doc.body.content.length).toBe(6);\n    a.close();\n    b.close();\n    await Promise.all([waitClosed(a), waitClosed(b)]);\n  });\n\n  it('handles 10 concurrent clients each inserting without corruption', async () => {\n    const id = await makeDoc('');\n    const N = 10;\n    const clients: WebSocket[] = [];\n    for (let i = 0; i < N; i++) clients.push(connect(id));\n    await Promise.all(clients.map(open));\n    await Promise.all(clients.map((c) => nextMessage(c))); // syncs