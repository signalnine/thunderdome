@@ -0,0 +1,323 @@
+import express, { Express, Request, Response } from 'express';
+import http from 'node:http';
+import { WebSocketServer, WebSocket } from 'ws';
+import type { IncomingMessage } from 'node:http';
+import { Store } from './db.js';
+import { apply, validateOp, transformAgainst, Operation } from './ot.js';
+
+export interface CollabServer {
+  app: Express;
+  store: Store;
+  start(port?: number): Promise<number>;
+  stop(): Promise<void>;
+}
+
+// In-memory live state for a document, rebuilt from the DB on first access.
+interface LiveDoc {
+  content: string;
+  version: number;
+  history: Array<Operation | null>; // history[i] produced version i+1
+  title: string;
+  clients: Set<WebSocket>;
+}
+
+export function createApp(dbPath?: string): CollabServer {
+  const store = new Store(dbPath);
+  const app = express();
+  app.use(express.json({ limit: '5mb' }));
+
+  const server = http.createServer(app);
+  const wss = new WebSocketServer({ noServer: true });
+
+  const live = new Map<string, LiveDoc>();
+
+  function loadLive(id: string): LiveDoc | undefined {
+    const existing = live.get(id);
+    if (existing) return existing;
+    const doc = store.getDocument(id);
+    if (!doc) return undefined;
+    const versions = store.listVersions(id);
+    const history: Array<Operation | null> = [];
+    for (const v of versions) {
+      if (v.version === 0) continue; // baseline, not an op
+      history[v.version - 1] = v.operation ? (JSON.parse(v.operation) as Operation) : null;
+    }
+    const liveDoc: LiveDoc = {
+      content: doc.content,
+      version: doc.version,
+      history,
+      title: doc.title,
+      clients: new Set(),
+    };
+    live.set(id, liveDoc);
+    return liveDoc;
+  }
+
+  // ---------------------------------------------------------------- REST API
+
+  app.post('/documents', (req: Request, res: Response) => {
+    const { title, content } = req.body ?? {};
+    if (typeof title !== 'string' || title.trim().length === 0) {
+      return res.status(400).json({ error: 'title is required and must be a non-empty string' });
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    const doc = store.createDocument(title, content ?? '');
+    return res.status(201).json(doc);
+  });
+
+  app.get('/documents', (_req: Request, res: Response) => {
+    return res.json(store.listDocuments());
+  });
+
+  app.get('/documents/:id', (req: Request, res: Response) => {
+    const doc = store.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    return res.json(doc);
+  });
+
+  app.put('/documents/:id', (req: Request, res: Response) => {
+    const id = req.params.id;
+    const doc = store.getDocument(id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    const { title, content } = req.body ?? {};
+    if (title !== undefined && (typeof title !== 'string' || title.trim().length === 0)) {
+      return res.status(400).json({ error: 'title must be a non-empty string' });
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    const newTitle = title ?? doc.title;
+    const newContent = content ?? doc.content;
+    const newVersion = doc.version + 1;
+    // Title-only change without content change keeps content the same.
+    store.db
+      .prepare("UPDATE documents SET title = ?, updated_at = datetime('now') WHERE id = ?")
+      .run(newTitle, id);
+    store.commitVersion(id, newVersion, newContent, null);
+
+    const liveDoc = live.get(id);
+    if (liveDoc) {
+      liveDoc.title = newTitle;
+      liveDoc.content = newContent;
+      liveDoc.version = newVersion;
+      liveDoc.history[newVersion - 1] = null; // wholesale replace = identity for OT
+      broadcast(liveDoc, { type: 'sync', documentId: id, content: newContent, version: newVersion, title: newTitle });
+    }
+    return res.json(store.getDocument(id));
+  });
+
+  app.delete('/documents/:id', (req: Request, res: Response) => {
+    const id = req.params.id;
+    const ok = store.deleteDocument(id);
+    if (!ok) return res.status(404).json({ error: 'document not found' });
+    const liveDoc = live.get(id);
+    if (liveDoc) {
+      for (const ws of liveDoc.clients) {
+        safeSend(ws, { type: 'error', message: 'document deleted' });
+        ws.close();
+      }
+      live.delete(id);
+    }
+    return res.status(204).end();
+  });
+
+  app.get('/documents/:id/versions', (req: Request, res: Response) => {
+    const doc = store.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    return res.json(store.listVersions(req.params.id));
+  });
+
+  app.get('/documents/:id/versions/:version', (req: Request, res: Response) => {
+    const versionNum = Number(req.params.version);
+    if (!Number.isInteger(versionNum)) {
+      return res.status(400).json({ error: 'version must be an integer' });
+    }
+    const v = store.getVersion(req.params.id, versionNum);
+    if (!v) return res.status(404).json({ error: 'version not found' });
+    return res.json(v);
+  });
+
+  // --------------------------------------------------------------- WebSocket
+
+  function safeSend(ws: WebSocket, msg: unknown): void {
+    if (ws.readyState === WebSocket.OPEN) {
+      ws.send(JSON.stringify(msg));
+    }
+  }
+
+  function broadcast(liveDoc: LiveDoc, msg: unknown): void {
+    const data = JSON.stringify(msg);
+    for (const ws of liveDoc.clients) {
+      if (ws.readyState === WebSocket.OPEN) ws.send(data);
+    }
+  }
+
+  function extractDocId(url: string | undefined): string | undefined {
+    if (!url) return undefined;
+    const pathname = url.split('?')[0];
+    const parts = pathname.split('/').filter(Boolean);
+    // Accept /documents/<id>, /documents/<id>/ws, /ws/<id>
+    if (parts[0] === 'documents' && parts[1]) return parts[1];
+    if (parts[0] === 'ws' && parts[1]) return parts[1];
+    return undefined;
+  }
+
+  server.on('upgrade', (req, socket, head) => {
+    const id = extractDocId(req.url);
+    if (!id) {
+      socket.destroy();
+      return;
+    }
+    wss.handleUpgrade(req, socket, head, (ws) => {
+      wss.emit('connection', ws, req, id);
+    });
+  });
+
+  wss.on('connection', (ws: WebSocket, _req: IncomingMessage, docId: string) => {
+    const liveDoc = loadLive(docId);
+    if (!liveDoc) {
+      safeSend(ws, { type: 'error', message: 'document not found' });
+      ws.close();
+      return;
+    }
+    liveDoc.clients.add(ws);
+    safeSend(ws, {
+      type: 'sync',
+      documentId: docId,
+      content: liveDoc.content,
+      version: liveDoc.version,
+      title: liveDoc.title,
+    });
+
+    ws.on('message', (raw) => {
+      let parsed: unknown;
+      try {
+        parsed = JSON.parse(raw.toString());
+      } catch {
+        return safeSend(ws, { type: 'error', message: 'invalid JSON' });
+      }
+      if (parsed === null || typeof parsed !== 'object') {
+        return safeSend(ws, { type: 'error', message: 'message must be an object' });
+      }
+      const msg = parsed as Record<string, unknown>;
+
+      if (msg.type === 'op') {
+        return handleOp(ws, docId, msg);
+      }
+      if (msg.type === 'sync') {
+        const d = live.get(docId)!;
+        return safeSend(ws, {
+          type: 'sync',
+          documentId: docId,
+          content: d.content,
+          version: d.version,
+          title: d.title,
+        });
+      }
+      return safeSend(ws, { type: 'error', message: `unknown message type: ${String(msg.type)}` });
+    });
+
+    ws.on('close', () => {
+      liveDoc.clients.delete(ws);
+    });
+    ws.on('error', () => {
+      liveDoc.clients.delete(ws);
+    });
+  });
+
+  function handleOp(ws: WebSocket, docId: string, msg: Record<string, unknown>): void {
+    const liveDoc = live.get(docId);
+    if (!liveDoc) {
+      safeSend(ws, { type: 'error', message: 'document not found' });
+      return;
+    }
+    const validation = validateOp(msg.op);
+    if (!validation.ok || !validation.op) {
+      safeSend(ws, { type: 'error', message: validation.error ?? 'invalid operation' });
+      return;
+    }
+    let baseVersion = msg.version;
+    if (baseVersion === undefined) baseVersion = liveDoc.version; // tolerate missing
+    if (
+      typeof baseVersion !== 'number' ||
+      !Number.isInteger(baseVersion) ||
+      baseVersion < 0 ||
+      baseVersion > liveDoc.version
+    ) {
+      safeSend(ws, {
+        type: 'error',
+        message: `invalid base version ${String(baseVersion)} (current ${liveDoc.version})`,
+      });
+      return;
+    }
+
+    // Transform against everything applied since the client's base version.
+    const concurrent = liveDoc.history.slice(baseVersion);
+    const transformed = transformAgainst(validation.op, concurrent);
+
+    liveDoc.content = apply(liveDoc.content, transformed);
+    liveDoc.version += 1;
+    liveDoc.history[liveDoc.version - 1] = transformed;
+
+    try {
+      store.commitVersion(docId, liveDoc.version, liveDoc.content, JSON.stringify(transformed));
+    } catch (err) {
+      safeSend(ws, { type: 'error', message: 'failed to persist operation' });
+      // roll back in-memory state to stay consistent with the DB
+      liveDoc.version -= 1;
+      liveDoc.history.length = liveDoc.version;
+      const doc = store.getDocument(docId);
+      if (doc) liveDoc.content = doc.content;
+      return;
+    }
+
+    broadcast(liveDoc, {
+      type: 'op',
+      documentId: docId,
+      op: transformed,
+      version: liveDoc.version,
+    });
+  }
+
+  // ------------------------------------------------------------- lifecycle
+
+  function start(port = 0): Promise<number> {
+    return new Promise((resolve, reject) => {
+      server.once('error', reject);
+      server.listen(port, () => {
+        const addr = server.address();
+        const actual = typeof addr === 'object' && addr ? addr.port : port;
+        resolve(actual);
+      });
+    });
+  }
+
+  function stop(): Promise<void> {
+    return new Promise((resolve) => {
+      for (const liveDoc of live.values()) {
+        for (const ws of liveDoc.clients) {
+          try {
+            ws.terminate();
+          } catch {
+            /* ignore */
+          }
+        }
+        liveDoc.clients.clear();
+      }
+      wss.close(() => {
+        server.close(() => {
+          try {
+            store.close();
+          } catch {
+            /* ignore */
+          }
+          resolve();
+        });
+      });
+    });
+  }
+
+  return { app, store, start, stop };
+}
