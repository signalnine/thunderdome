n,\n    });\n  }\n\n  // ------------------------------------------------------------- lifecycle\n\n  function start(port = 0): Promise<number> {\n    return new Promise((resolve, reject) => {\n      server.once('error', reject);\n      server.listen(port, () => {\n        const addr = server.address();\n        const actual = typeof addr === 'object' && addr ? addr.port : port;\n        resolve(actual);\n      });\n    });\n  }\n\n  function stop(): Promise<void> {\n    return new Promise((resolve) => {\n      for (const liveDoc of live.values()) {\n        for (const ws of liveDoc.clients) {\n          try {\n            ws.terminate();\n          } catch {\n            /* ignore */\n          }\n        }\n        liveDoc.clients.clear();\n      }\n      wss.close(() => {\n        server.close(() => {\n          try {\n            store.close();\n          } catch {\n            /* ignore */\n          }\n          resolve();\n        });\n      });\n    });\n  }\n\n  return { app, store, start, stop };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":1710,"cache_read_input_tokens":41764,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1710},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"da7756df-f462-46ae-969e-0e52bf108bdf","uuid":"5779521d-1ef2-4920-93a4-a3b10e6bbd0a","request_id":"req_011CbWD4STGqDRjhRjKn5ofd"}
