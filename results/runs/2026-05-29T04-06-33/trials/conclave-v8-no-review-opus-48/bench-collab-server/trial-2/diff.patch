Promise.all(clients.map(open));\n    await Promise.all(clients.map((c) => nextMessage(c))); // syncs\n\n    // each client inserts a unique single char at position 0, all based on version 0\n    const letters = 'ABCDEFGHIJ';\n    for (let i = 0; i < N; i++) {\n      clients[i].send(\n        JSON.stringify({ type: 'op', op: { type: 'insert', position: 0, text: letters[i] }, version: 0 })\n      );\n    }\n    await new Promise((r) => setTimeout(r, 600));\n    const doc = await request(srv.app).get(`/documents/${id}`);\n    expect(doc.body.version).toBe(N);\n    expect(doc.body.content.length).toBe(N);\n    for (const ch of letters) expect(doc.body.content).toContain(ch);\n    await Promise.all(clients.map((c) => (c.close(), waitClosed(c))));\n  });\n});\n","structuredPatch":[{"oldStart":16,"oldLines":21,"newStart":16,"newLines":35,"lines":[" });"," "," // ---- helpers for WebSocket clients ----","+//","+// Messages are buffered from the moment the socket is created so a test never","+// races against the immediate `sync` message the server pushes on connect."," ","+interface Client {","+  ws: WebSocket;","+  next(): Promise<Record<string, unknown>>;","+}","+","+const buffers = new WeakMap<WebSocket, Record<string, unknown>[]>();","+const waiters = new WeakMap<WebSocket, ((m: Record<string, unknown>) => void)[]>();","+"," function connect(docId: string): WebSocket {","-  return new WebSocket(`ws://127.0.0.1:${port}/documents/${docId}`);","+  const ws = new WebSocket(`ws://127.0.0.1:${port}/documents/${docId}`);","+  buffers.set(ws, []);","+  waiters.set(ws, []);","+  ws.on('message', (data: Buffer) => {","+    const msg = JSON.parse(data.toString());","+    const w = waiters.get(ws)!;","+    if (w.length > 0) w.shift()!(msg);","+    else buffers.get(ws)!.push(msg);","+  });","+  return ws;"," }"," "," function nextMessage(ws: WebSocket): Promise<Record<string, unknown>> {","-  return new Promise((resolve, reject) => {","-    const onMsg = (data: Buffer) => {","-     