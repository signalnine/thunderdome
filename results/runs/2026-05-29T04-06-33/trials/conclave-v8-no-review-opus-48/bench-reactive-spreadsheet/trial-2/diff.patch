+import { describe, it, expect } from 'vitest';
+import {
+  parseRef,
+  columnToIndex,
+  indexToColumn,
+  makeRef,
+  normalizeRef,
+  expandRange,
+} from './reference.js';
+
+describe('cell reference parsing', () => {
+  it('parses A1 to 0-based coords', () => {
+    expect(parseRef('A1')).toEqual({ col: 0, row: 0 });
+  });
+
+  it('parses multi-letter columns and large rows', () => {
+    expect(parseRef('AA1')).toEqual({ col: 26, row: 0 });
+    expect(parseRef('AZ1')).toEqual({ col: 51, row: 0 });
+    expect(parseRef('BA1')).toEqual({ col: 52, row: 0 });
+    expect(parseRef('Z100')).toEqual({ col: 25, row: 99 });
+  });
+
+  it('round-trips column letters and indices', () => {
+    expect(columnToIndex('A')).toBe(0);
+    expect(columnToIndex('Z')).toBe(25);
+    expect(columnToIndex('AA')).toBe(26);
+    expect(columnToIndex('AZ')).toBe(51);
+    expect(columnToIndex('BA')).toBe(52);
+    for (const c of [0, 1, 25, 26, 51, 52, 700, 27]) {
+      expect(columnToIndex(indexToColumn(c))).toBe(c);
+    }
+    expect(indexToColumn(0)).toBe('A');
+    expect(indexToColumn(26)).toBe('AA');
+  });
+
+  it('makeRef builds canonical strings', () => {
+    expect(makeRef({ col: 0, row: 0 })).toBe('A1');
+    expect(makeRef({ col: 26, row: 99 })).toBe('AA100');
+  });
+
+  it('normalizeRef upper-cases and validates', () => {
+    expect(normalizeRef('a1')).toBe('A1');
+    expect(normalizeRef('aa10')).toBe('AA10');
+  });
+
+  it('throws on invalid references', () => {
+    for (const bad of ['1A', 'A', 'A0', '', 'A-1', 'A1.5', '1', ':', 'AB']) {
+      expect(() => parseRef(bad)).toThrow();
+    }
+  });
+});
+
+describe('range expansion', () => {
+  it('expands a column range', () => {
+    expect(expandRange('A1', 'A5')).toEqual(['A1', 'A2', 'A3', 'A4', 'A5']);
+  });
+
+  it('expands a row range', () => {
+    expect(expandRange('A1', 'C1')).toEqual(['A1', 'B1', 'C1']);
+  });
+
+  it('expands a block range', () => {
+    expect(expandRange('A1', 'C3')).toEqual([
+      'A1', 'B1', 'C1',
+      'A2', 'B2', 'C2',
+      'A3', 'B3', 'C3',
+    ]);
+  });
+
+  it('normalizes reversed ranges', () => {
+    expect(expandRange('B2', 'A1')).toEqual(['A1', 'B1', 'A2', 'B2']);
+  });
+});
