;\n  });\n});\n\ndescribe('formula arithmetic', () => {\n  const sheet = () => new Spreadsheet();\n\n  it('handles the four operators', () => {\n    const s = sheet();\n    s.set('A1', '=1+2');\n    s.set('A2', '=10-4');\n    s.set('A3', '=3*4');\n    s.set('A4', '=12/4');\n    expect(s.get('A1')).toBe(3);\n    expect(s.get('A2')).toBe(6);\n    expect(s.get('A3')).toBe(12);\n    expect(s.get('A4')).toBe(3);\n  });\n\n  it('respects operator precedence', () => {\n    const s = sheet();\n    s.set('A1', '=2+3*4');\n    expect(s.get('A1')).toBe(14);\n  });\n\n  it('respects parentheses', () => {\n    const s = sheet();\n    s.set('A1', '=(2+3)*4');\n    expect(s.get('A1')).toBe(20);\n  });\n\n  it('handles unary minus', () => {\n    const s = sheet();\n    s.set('A1', 7);\n    s.set('B1', '=-5');\n    s.set('B2', '=-A1');\n    s.set('B3', '=3+-2');\n    expect(s.get('B1')).toBe(-5);\n    expect(s.get('B2')).toBe(-7);\n    expect(s.get('B3')).toBe(1);\n  });\n\n  it('handles decimals', () => {\n    const s = sheet();\n    s.set('A1', '=3.14*2');\n    expect(s.get('A1')).toBeCloseTo(6.28, 10);\n  });\n\n  it('division by zero yields an error', () => {\n    const s = sheet();\n    s.set('A1', '=1/0');\n    expect(s.get('A1')).toBe('#DIV/0!');\n  });\n});\n\ndescribe('cell references in formulas', () => {\n  it('reads a single cell', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B1', '=A1');\n    expect(s.get('B1')).toBe(10);\n  });\n\n  it('adds two cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('B1', 20);\n    s.set('C1', '=A1+B1');\n    expect(s.get('C1')).toBe(30);\n  });\n\n  it('treats empty cells as 0 in arithmetic', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=A1+Z9');\n    expect(s.get('B1')).toBe(5);\n  });\n\n  it('treats booleans as 1/0 in arithmetic', () => {\n    const s = new Spreadsheet();\n    s.set('A1', true);\n    s.set('A2', false);\n    s.set('B1', '=A1+A2+10');\n    expect(s.get('B1')).toBe(11);\n  });\n\n  it('errors on non-numeric string arithmetic', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 'hello');\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe('#VALUE!');\n  });\n\n  it('parses numeric strings in arithmetic', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '12');\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe(13);\n  });\n});\n\ndescribe('built-in functions', () => {\n  function seed() {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('A3', 3);\n    s.set('A4', 4);\n    s.set('A5', 5);\n    return s;\n  }\n\n  it('SUM over a column range', () => {\n    const s = seed();\n    s.set('B1', '=SUM(A1:A5)');\n    expect(s.get('B1')).toBe(15);\n  });\n\n  it('SUM over a row range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('B1', 2);\n    s.set('C1', 3);\n    s.set('D1', '=SUM(A1:C1)');\n    expect(s.get('D1')).toBe(6);\n  });\n\n  it('SUM over a block range', () => {\n    const s = new Spreadsheet();\n    for (const r of [1, 2, 3]) {\n      s.set(`A${r}`, r);\n      s.set(`B${r}`, r * 10);\n    }\n    s.set('C1', '=SUM(A1:B3)');\n    expect(s.get('C1')).toBe(1 + 2 + 3 + 10 + 20 + 30);\n  });\n\n  it('AVERAGE', () => {\n    const s = seed();\n    s.set('B1', '=AVERAGE(A1:A5)');\n    expect(s.get('B1')).toBe(3);\n  });\n\n  it('MIN and MAX', () => {\n    const s = seed();\n    s.set('B1', '=MIN(A1:A5)');\n    s.set('B2', '=MAX(A1:A5)');\n    expect(s.get('B1')).toBe(1);\n    expect(s.get('B2')).toBe(5);\n  });\n\n  it('COUNT counts only numeric cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 'text');\n    s.set('A3', true);\n    s.set('A4', 4);\n    s.set('B1', '=COUNT(A1:A4)');\n    expect(s.get('B1')).toBe(2);\n  });\n\n  it('functions ignore empty and non-numeric cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 'skip');\n    // A3 empty\n    s.set('A4', 20);\n    s.set('B1', '=SUM(A1:A4)');\n    expect(s.get('B1')).toBe(30);\n  });\n\n  it('AVERAGE of no numeric values returns 0', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 'x');\n    s.set('B1', '=AVERAGE(A1:A3)');\n    expect(s.get('B1')).toBe(0);\n  });\n\n  it('accepts scalar arguments', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('B1', '=SUM(A1, A2, 5)');\n    expect(s.get('B1')).toBe(8);\n  });\n\n  it('supports nested function calls', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('A3', 3);\n    s.set('B1', 10);\n    s.set('B2', 20);\n    s.set('B3', 30);\n    s.set('C1', '=SUM(A1:A3)+MAX(B1:B3)');\n    expect(s.get('C1')).toBe(6 + 30);\n  });\n});\n\ndescribe('IF and comparisons', () => {\n  it('basic IF with > comparison', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 50);\n    s.set('C1', '=IF(A1>30, \"big\", \"small\")');\n    expect(s.get('C1')).toBe('big');\n    s.set('A1', 10);\n    expect(s.get('C1')).toBe('small');\n  });\n\n  it('all comparison operators', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=IF(A1>4,1,0)');\n    s.set('B2', '=IF(A1<4,1,0)');\n    s.set('B3', '=IF(A1>=5,1,0)');\n    s.set('B4', '=IF(A1<=5,1,0)');\n    s.set('B5', '=IF(A1=5,1,0)');\n    s.set('B6', '=IF(A1<>5,1,0)');\n    expect(s.get('B1')).toBe(1);\n    expect(s.get('B2')).toBe(0);\n    expect(s.get('B3')).toBe(1);\n    expect(s.get('B4')).toBe(1);\n    expect(s.get('B5')).toBe(1);\n    expect(s.get('B6')).toBe(0);\n  });\n\n  it('string equality comparison', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 'x');\n    s.set('B1', '=IF(A1=\"x\",1,0)');\n    s.set('B2', '=IF(A1=\"y\",1,0)');\n    expect(s.get('B1')).toBe(1);\n    expect(s.get('B2')).toBe(0);\n  });\n\n  it('IF lazily evaluates only the chosen branch', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    // false branch divides by zero but is never taken\n    s.set('B1', '=IF(A1=1, 100, 1/0)');\n    expect(s.get('B1')).toBe(100);\n    // true branch would error but is not taken\n    s.set('C1', '=IF(A1=2, 1/0, 200)');\n    expect(s.get('C1')).toBe(200);\n  });\n});\n\ndescribe('reactive updates', () => {\n  it('updates direct dependents', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe(6);\n    s.set('A1', 10);\n    expect(s.get('B1')).toBe(11);\n  });\n\n  it('updates transitively', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('B1', '=A1+1');\n    s.set('C1', '=B1+1');\n    expect(s.get('C1')).toBe(3);\n    s.set('A1', 10);\n    expect(s.get('B1')).toBe(11);\n    expect(s.get('C1')).toBe(12);\n  });\n\n  it('clears dependencies when a formula becomes a raw value', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe(6);\n    s.set('B1', 100); // no longer depends on A1\n    s.set('A1', 999);\n    expect(s.get('B1')).toBe(100);\n  });\n\n  it('recomputes range-dependent cells when a member changes', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('A3', 3);\n    s.set('B1', '=SUM(A1:A3)');\n    expect(s.get('B1')).toBe(6);\n    s.set('A2', 20);\n    expect(s.get('B1')).toBe(24);\n  });\n\n  it('recomputes when a referenced empty cell becomes set', () => {\n    const s = new Spreadsheet();\n    s.set('B1', '=SUM(A1:A3)');\n    expect(s.get('B1')).toBe(0);\n    s.set('A2', 7);\n    expect(s.get('B1')).toBe(7);\n  });\n\n  it('updates a cell that depends on two changing inputs', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('A3', '=A1+A2');\n    expect(s.get('A3')).toBe(3);\n    s.set('A1', 50);\n    expect(s.get('A3')).toBe(52);\n  });\n});\n\ndescribe('circular reference detection', () => {\n  it('detects a direct two-cell cycle', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1');\n    expect(() => s.set('B1', '=A1')).toThrow(/circular/i);\n  });\n\n  it('detects an indirect cycle', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1');\n    s.set('B1', '=C1');\n    expect(() => s.set('C1', '=A1')).toThrow(/circular/i);\n  });\n\n  it('detects a self reference', () => {\n    const s = new Spreadsheet();\n    expect(() => s.set('A1', '=A1')).toThrow(/circular/i);\n  });\n\n  it('detects a cycle through a range', () => {\n    const s = new Spreadsheet();\n    expect(() => s.set('A1', '=SUM(A1:A3)')).toThrow(/circular/i);\n  });\n\n  it('keeps state consistent after a rejected cyclic set', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=A1');\n    expect(s.get('B1')).toBe(5);\n    // Attempt to create a cycle: A1 = B1 (B1 already depends on A1)\n    expect(() => s.set('A1', '=B1')).toThrow(/circular/i);\n    // A1 keeps its old value, B1 still works\n    expect(s.get('A1')).toBe(5);\n    expect(s.get('B1')).toBe(5);\n    // And A1 can still be updated normally afterwards\n    s.set('A1', 9);\n    expect(s.get('B1')).toBe(9);\n  });\n});\n\ndescribe('getCells', () => {\n  it('returns all non-empty cells with computed values', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('A3', '=A1+A2');\n    const cells = s.getCells();\n    expect(cells.get('A1')).toBe(10);\n    expect(cells.get('A2')).toBe(20);\n    expect(cells.get('A3')).toBe(30);\n    expect(cells.size).toBe(3);\n  });\n\n  it('excludes empty cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    const cells = s.getCells();\n    expect(cells.has('B2')).toBe(false);\n  });\n});\n\ndescribe('spec example usage', () => {\n  it('matches the documented example', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 20);\n    sheet.set('A3', '=A1+A2');\n    expect(sheet.get('A3')).toBe(30);\n    expect(sheet.getDisplay('A3')).toBe('30');\n\n    sheet.set('A1', 50);\n    expect(sheet.get('A3')).toBe(70);\n\n    sheet.set('B1', '=SUM(A1:A2)');\n    expect(sheet.get('B1')).toBe(70);\n\n    sheet.set('C1', '=IF(A1>30, \"big\", \"small\")');\n    expect(sheet.get('C1')).toBe('big');\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
