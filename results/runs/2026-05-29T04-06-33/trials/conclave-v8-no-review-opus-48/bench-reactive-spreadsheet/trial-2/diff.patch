+// Recursive-descent parser turning tokens into an AST.
+
+import { Token } from './tokenizer.js';
+import { Node } from './ast.js';
+import { normalizeRef } from './reference.js';
+
+const COMPARISON_OPS = new Set(['>', '<', '>=', '<=', '=', '<>']);
+const CELL_RE = /^[A-Za-z]+[1-9][0-9]*$/;
+
+export class Parser {
+  private tokens: Token[];
+  private pos = 0;
+
+  constructor(tokens: Token[]) {
+    this.tokens = tokens;
+  }
+
+  parse(): Node {
+    if (this.tokens.length === 0) {
+      throw new Error('Empty formula');
+    }
+    const node = this.parseExpression();
+    if (this.pos < this.tokens.length) {
+      throw new Error(
+        `Unexpected token '${this.tokens[this.pos].value}' in formula`
+      );
+    }
+    return node;
+  }
+
+  private peek(): Token | undefined {
+    return this.tokens[this.pos];
+  }
+
+  private next(): Token {
+    return this.tokens[this.pos++];
+  }
+
+  // expression -> comparison
+  private parseExpression(): Node {
+    return this.parseComparison();
+  }
+
+  // comparison -> additive (compop additive)?
+  private parseComparison(): Node {
+    let left = this.parseAdditive();
+    const tok = this.peek();
+    if (tok && tok.type === 'op' && COMPARISON_OPS.has(tok.value)) {
+      this.next();
+      const right = this.parseAdditive();
+      left = { kind: 'binary', op: tok.value, left, right };
+    }
+    return left;
+  }
+
+  // additive -> multiplicative (('+'|'-') multiplicative)*
+  private parseAdditive(): Node {
+    let left = this.parseMultiplicative();
+    while (true) {
+      const tok = this.peek();
+      if (tok && tok.type === 'op' && (tok.value === '+' || tok.value === '-')) {
+        this.next();
+        const right = this.parseMultiplicative();
+        left = { kind: 'binary', op: tok.value, left, right };
+      } else {
+        break;
+      }
+    }
+    return left;
+  }
+
+  // multiplicative -> unary (('*'|'/') unary)*
+  private parseMultiplicative(): Node {
+    let left = this.parseUnary();
+    while (true) {
+      const tok = this.peek();
+      if (tok && tok.type === 'op' && (tok.value === '*' || tok.value === '/')) {
+        this.next();
+        const right = this.parseUnary();
+        left = { kind: 'binary', op: tok.value, left, right };
+      } else {
+        break;
+      }
+    }
+    return left;
+  }
+
+  // unary -> ('-'|'+') unary | primary
+  private parseUnary(): Node {
+    const tok = this.peek();
+    if (tok && tok.type === 'op' && (tok.value === '-' || tok.value === '+')) {
+      this.next();
+      const operand = this.parseUnary();
+      return { kind: 'unary', op: tok.value as '-' | '+', operand };
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): Node {
+    const tok = this.peek();
+    if (!tok) {
+      throw new Error('Unexpected end of formula');
+    }
+
+    if (tok.type === 'number') {
+      this.next();
+      return { kind: 'number', value: parseFloat(tok.value) };
+    }
+
+    if (tok.type === 'string') {
+      this.next();
+      return { kind: 'string', value: tok.value };
+    }
+
+    if (tok.type === 'lparen') {
+      this.next();
+      const node = this.parseExpression();
+      const close = this.peek();
+      if (!close || close.type !== 'rparen') {
+        throw new Error('Missing closing parenthesis');
+      }
+      this.next();
+      return node;
+    }
+
+    if (tok.type === 'ident') {
+      this.next();
+      const after = this.peek();
+
+      // Function call
+      if (after && after.type === 'lparen') {
+        this.next(); // consume '('
+        const args = this.parseArgs();
+        const close = this.peek();
+        if (!close || close.type !== 'rparen') {
+          throw new Error(`Missing closing parenthesis in ${tok.value}()`);
+        }
+        this.next();
+        return { kind: 'func', name: tok.value.toUpperCase(), args };
+      }
+
+      // Cell reference (possibly a range)
+      if (!CELL_RE.test(tok.value)) {
+        throw new Error(`Invalid cell reference or function: ${tok.value}`);
+      }
+      const startRef = normalizeRef(tok.value);
+
+      if (after && after.type === 'colon') {
+        this.next(); // consume ':'
+        const endTok = this.peek();
+        if (!endTok || endTok.type !== 'ident' || !CELL_RE.test(endTok.value)) {
+          throw new Error('Invalid range end reference');
+        }
+        this.next();
+        return {
+          kind: 'range',
+          start: startRef,
+          end: normalizeRef(endTok.value),
+        };
+      }
+
+      return { kind: 'ref', ref: startRef };
+    }
+
+    throw new Error(`Unexpected token '${tok.value}' in formula`);
+  }
+
+  // Parse comma-separated argument list. Handles empty list.
+  private parseArgs(): Node[] {
+    const args: Node[] = [];
+    if (this.peek()?.type === 'rparen') {
+      return args;
+    }
+    args.push(this.parseExpression());
+    while (this.peek()?.type === 'comma') {
+      this.next();
+      args.push(this.parseExpression());
+    }
+    return args;
+  }
+}
+
+export function parseFormula(tokens: Token[]): Node {
+  return new Parser(tokens).parse();
+}
