+// Tokenizer for formula expressions (the part after '=').
+
+export type TokenType =
+  | 'number'
+  | 'string'
+  | 'ident' // function names and cell references
+  | 'op'
+  | 'lparen'
+  | 'rparen'
+  | 'comma'
+  | 'colon';
+
+export interface Token {
+  type: TokenType;
+  value: string;
+}
+
+const OPERATORS = ['>=', '<=', '<>', '+', '-', '*', '/', '>', '<', '='];
+
+export function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+  const n = input.length;
+
+  while (i < n) {
+    const ch = input[i];
+
+    // Whitespace
+    if (ch === ' ' || ch === '\t' || ch === '\n' || ch === '\r') {
+      i++;
+      continue;
+    }
+
+    // String literal: double-quoted
+    if (ch === '"') {
+      let str = '';
+      i++; // skip opening quote
+      while (i < n && input[i] !== '"') {
+        if (input[i] === '\\' && i + 1 < n) {
+          // allow escaped quotes/backslashes
+          const next = input[i + 1];
+          if (next === '"' || next === '\\') {
+            str += next;
+            i += 2;
+            continue;
+          }
+        }
+        str += input[i];
+        i++;
+      }
+      if (i >= n) {
+        throw new Error('Unterminated string literal in formula');
+      }
+      i++; // skip closing quote
+      tokens.push({ type: 'string', value: str });
+      continue;
+    }
+
+    // Number: digits with optional decimal point
+    if (isDigit(ch) || (ch === '.' && isDigit(input[i + 1]))) {
+      let num = '';
+      let seenDot = false;
+      while (i < n && (isDigit(input[i]) || input[i] === '.')) {
+        if (input[i] === '.') {
+          if (seenDot) break;
+          seenDot = true;
+        }
+        num += input[i];
+        i++;
+      }
+      tokens.push({ type: 'number', value: num });
+      continue;
+    }
+
+    // Identifier: letters then optional digits (function name or cell ref)
+    if (isAlpha(ch)) {
+      let ident = '';
+      while (i < n && (isAlpha(input[i]) || isDigit(input[i]))) {
+        ident += input[i];
+        i++;
+      }
+      tokens.push({ type: 'ident', value: ident });
+      continue;
+    }
+
+    // Parentheses, comma, colon
+    if (ch === '(') {
+      tokens.push({ type: 'lparen', value: ch });
+      i++;
+      continue;
+    }
+    if (ch === ')') {
+      tokens.push({ type: 'rparen', value: ch });
+      i++;
+      continue;
+    }
+    if (ch === ',') {
+      tokens.push({ type: 'comma', value: ch });
+      i++;
+      continue;
+    }
+    if (ch === ':') {
+      tokens.push({ type: 'colon', value: ch });
+      i++;
+      continue;
+    }
+
+    // Operators (multi-char first)
+    let matched = false;
+    for (const op of OPERATORS) {
+      if (input.startsWith(op, i)) {
+        tokens.push({ type: 'op', value: op });
+        i += op.length;
+        matched = true;
+        break;
+      }
+    }
+    if (matched) continue;
+
+    throw new Error(`Unexpected character in formula: '${ch}'`);
+  }
+
+  return tokens;
+}
+
+function isDigit(ch: string): boolean {
+  return ch >= '0' && ch <= '9';
+}
+
+function isAlpha(ch: string): boolean {
+  return (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z');
+}
