index 0000000..753ebd5
--- /dev/null
+++ b/src/reference.ts
@@ -0,0 +1,74 @@
+// Cell reference parsing and column letter <-> index conversion.
+
+export interface CellCoord {
+  col: number; // 0-based
+  row: number; // 0-based
+}
+
+const CELL_RE = /^([A-Z]+)([1-9][0-9]*)$/;
+
+/** Convert a column letter string (A, Z, AA, ...) to a 0-based index. */
+export function columnToIndex(letters: string): number {
+  if (!/^[A-Z]+$/.test(letters)) {
+    throw new Error(`Invalid column: ${letters}`);
+  }
+  let index = 0;
+  for (let i = 0; i < letters.length; i++) {
+    index = index * 26 + (letters.charCodeAt(i) - 64); // 'A' -> 1
+  }
+  return index - 1; // make 0-based
+}
+
+/** Convert a 0-based column index to its letter string (0 -> A). */
+export function indexToColumn(index: number): string {
+  if (!Number.isInteger(index) || index < 0) {
+    throw new Error(`Invalid column index: ${index}`);
+  }
+  let n = index + 1;
+  let result = '';
+  while (n > 0) {
+    const rem = (n - 1) % 26;
+    result = String.fromCharCode(65 + rem) + result;
+    n = Math.floor((n - 1) / 26);
+  }
+  return result;
+}
+
+/** Parse a cell reference like "A1" into 0-based coordinates. */
+export function parseRef(ref: string): CellCoord {
+  const m = CELL_RE.exec(ref);
+  if (!m) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  return {
+    col: columnToIndex(m[1]),
+    row: parseInt(m[2], 10) - 1,
+  };
+}
+
+/** Build a canonical reference string from coordinates. */
+export function makeRef(coord: CellCoord): string {
+  return indexToColumn(coord.col) + (coord.row + 1);
+}
+
+/** Normalize a reference to canonical uppercase form, validating it. */
+export function normalizeRef(ref: string): string {
+  return makeRef(parseRef(ref.toUpperCase()));
+}
+
+/** Expand a range "A1:C3" into the list of cell references it covers. */
+export function expandRange(start: string, end: string): string[] {
+  const a = parseRef(start);
+  const b = parseRef(end);
+  const minCol = Math.min(a.col, b.col);
+  const maxCol = Math.max(a.col, b.col);
+  const minRow = Math.min(a.row, b.row);
+  const maxRow = Math.max(a.row, b.row);
+  const refs: string[] = [];
+  for (let r = minRow; r <= maxRow; r++) {
+    for (let c = minCol; c <= maxCol; c++) {
+      refs.push(makeRef({ col: c, row: r }));
+    }
+  }
+  return refs;
+}
