@@ -0,0 +1,206 @@
+// Reactive spreadsheet engine.
+
+import { normalizeRef } from './reference.js';
+import { tokenize } from './tokenizer.js';
+import { parseFormula } from './parser.js';
+import { Node } from './ast.js';
+import {
+  evaluate,
+  extractDeps,
+  FormulaError,
+  CellValue,
+  EvalContext,
+} from './evaluator.js';
+
+type RawInput = string | number | boolean;
+type Stored = CellValue | FormulaError;
+
+export type { CellValue };
+
+export class Spreadsheet {
+  /** Original input per cell (raw value, or formula string starting with '='). */
+  private raw = new Map<string, RawInput>();
+  /** Parsed AST for formula cells. */
+  private formulas = new Map<string, Node>();
+  /** Computed value (or error) per cell. */
+  private values = new Map<string, Stored>();
+  /** cell -> set of cells it directly depends on. */
+  private precedents = new Map<string, Set<string>>();
+  /** cell -> set of cells that directly depend on it. */
+  private dependents = new Map<string, Set<string>>();
+
+  set(cell: string, value: RawInput): void {
+    const ref = normalizeRef(cell);
+
+    let newFormula: Node | null = null;
+    let newPrecedents = new Set<string>();
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      const expr = value.slice(1);
+      newFormula = parseFormula(tokenize(expr));
+      extractDeps(newFormula, newPrecedents);
+    }
+
+    // Reject changes that would introduce a circular dependency, leaving
+    // all existing state untouched.
+    if (newFormula && this.wouldCreateCycle(ref, newPrecedents)) {
+      throw new Error(`Circular reference detected at ${ref}`);
+    }
+
+    // Swap out old dependency edges for the new ones.
+    const oldPrecedents = this.precedents.get(ref);
+    if (oldPrecedents) {
+      for (const p of oldPrecedents) {
+        this.dependents.get(p)?.delete(ref);
+      }
+    }
+    if (newFormula) {
+      this.formulas.set(ref, newFormula);
+      this.precedents.set(ref, newPrecedents);
+      for (const p of newPrecedents) {
+        let set = this.dependents.get(p);
+        if (!set) {
+          set = new Set<string>();
+          this.dependents.set(p, set);
+        }
+        set.add(ref);
+      }
+    } else {
+      this.formulas.delete(ref);
+      this.precedents.delete(ref);
+    }
+
+    this.raw.set(ref, value);
+
+    // Recompute this cell and everything that transitively depends on it.
+    this.recompute(ref);
+  }
+
+  get(cell: string): CellValue {
+    const ref = normalizeRef(cell);
+    const v = this.values.get(ref);
+    if (v === undefined) return null;
+    if (v instanceof FormulaError) return v.code;
+    return v;
+  }
+
+  getDisplay(cell: string): string {
+    const v = this.get(cell);
+    if (v === null) return '';
+    if (typeof v === 'boolean') return v ? 'true' : 'false';
+    return String(v);
+  }
+
+  getCells(): Map<string, CellValue> {
+    const out = new Map<string, CellValue>();
+    for (const ref of this.values.keys()) {
+      out.set(ref, this.get(ref));
+    }
+    return out;
+  }
+
+  // --- internals ---
+
+  /** Does giving `cell` the precedents `newPrecedents` create a cycle? */
+  private wouldCreateCycle(cell: string, newPrecedents: Set<string>): boolean {
+    const visited = new Set<string>();
+    const stack: string[] = [...newPrecedents];
+    while (stack.length) {
+      const cur = stack.pop()!;
+      if (cur === cell) return true;
+      if (visited.has(cur)) continue;
+      visited.add(cur);
+      const deps = this.precedents.get(cur);
+      if (deps) {
+        for (const d of deps) stack.push(d);
+      }
+    }
+    return false;
+  }
+
+  /** Recompute `start` and all transitive dependents in dependency order. */
+  private recompute(start: string): void {
+    // Gather the affected set: start plus all transitive dependents.
+    const affected = new Set<string>();
+    const queue = [start];
+    while (queue.length) {
+      const cur = queue.shift()!;
+      if (affected.has(cur)) continue;
+      affected.add(cur);
+      const deps = this.dependents.get(cur);
+      if (deps) {
+        for (const d of deps) queue.push(d);
+      }
+    }
+
+    // Topological order within the affected set (Kahn's algorithm).
+    const indegree = new Map<string, number>();
+    for (const node of affected) {
+      let deg = 0;
+      const precs = this.precedents.get(node);
+      if (precs) {
+        for (const p of precs) {
+          if (affected.has(p)) deg++;
+        }
+      }
+      indegree.set(node, deg);
+    }
+
+    const ready: string[] = [];
+    for (const [node, deg] of indegree) {
+      if (deg === 0) ready.push(node);
+    }
+
+    let processed = 0;
+    while (ready.length) {
+      const node = ready.shift()!;
+      processed++;
+      this.computeCell(node);
+      const deps = this.dependents.get(node);
+      if (deps) {
+        for (const d of deps) {
+          if (!affected.has(d)) continue;
+          const deg = indegree.get(d)! - 1;
+          indegree.set(d, deg);
+          if (deg === 0) ready.push(d);
+        }
+      }
+    }
+
+    // Safety net: a cycle would leave nodes unprocessed (shouldn't happen
+    // because set() rejects cycles up front).
+    if (processed !== affected.size) {
+      throw new Error('Circular reference detected during recompute');
+    }
+  }
+
+  /** Compute and store a single cell's value. */
+  private computeCell(ref: string): void {
+    const formula = this.formulas.get(ref);
+    if (!formula) {
+      // Raw value cell.
+      const raw = this.raw.get(ref);
+      this.values.set(ref, raw === undefined ? null : (raw as CellValue));
+      return;
+    }
+    const ctx: EvalContext = {
+      resolve: (r: string): CellValue => {
+        const v = this.values.get(r);
+        if (v === undefined) return null;
+        if (v instanceof FormulaError) throw v;
+        return v;
+      },
+    };
+    try {
+      this.values.set(ref, evaluate(formula, ctx));
+    } catch (e) {
+      if (e instanceof FormulaError) {
+        this.values.set(ref, e);
+      } else {
+        this.values.set(ref, new FormulaError('#ERROR'));
+      }
+    }
+  }
+}
+
+export default Spreadsheet;
