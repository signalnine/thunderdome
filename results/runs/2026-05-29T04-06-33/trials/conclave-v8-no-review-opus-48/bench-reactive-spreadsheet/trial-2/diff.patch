diff --git a/src/ast.ts b/src/ast.ts
new file mode 100644
index 0000000..ee013dd
--- /dev/null
+++ b/src/ast.ts
@@ -0,0 +1,50 @@
+// AST node definitions for parsed formulas.
+
+export type Node =
+  | NumberNode
+  | StringNode
+  | RefNode
+  | RangeNode
+  | UnaryNode
+  | BinaryNode
+  | FuncNode;
+
+export interface NumberNode {
+  kind: 'number';
+  value: number;
+}
+
+export interface StringNode {
+  kind: 'string';
+  value: string;
+}
+
+export interface RefNode {
+  kind: 'ref';
+  ref: string; // canonical, e.g. "A1"
+}
+
+export interface RangeNode {
+  kind: 'range';
+  start: string; // canonical ref
+  end: string; // canonical ref
+}
+
+export interface UnaryNode {
+  kind: 'unary';
+  op: '-' | '+';
+  operand: Node;
+}
+
+export interface BinaryNode {
+  kind: 'binary';
+  op: string; // + - * / > < >= <= = <>
+  left: Node;
+  right: Node;
+}
+
+export interface FuncNode {
+  kind: 'func';
+  name: string; // upper-cased
+  args: Node[];
+}
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..bd50b22
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,212 @@
+// Evaluates a formula AST against a cell-value resolver, and extracts
+// the set of cell dependencies referenced by a formula.
+
+import { Node } from './ast.js';
+import { expandRange } from './reference.js';
+
+export type CellValue = number | string | boolean | null;
+
+/** Sentinel for a formula that could not be computed (e.g. #DIV/0!). */
+export class FormulaError extends Error {
+  readonly code: string;
+  constructor(code: string) {
+    super(code);
+    this.name = 'FormulaError';
+    this.code = code;
+  }
+}
+
+export interface EvalContext {
+  /** Resolve a cell's computed value. Empty cells return null.
+   *  Throws FormulaError if the referenced cell holds an error. */
+  resolve(ref: string): CellValue;
+}
+
+const AGG_FUNCS = new Set(['SUM', 'AVERAGE', 'MIN', 'MAX', 'COUNT']);
+
+export function evaluate(node: Node, ctx: EvalContext): CellValue {
+  switch (node.kind) {
+    case 'number':
+      return node.value;
+    case 'string':
+      return node.value;
+    case 'ref':
+      return ctx.resolve(node.ref);
+    case 'range':
+      // A bare range outside a function has no scalar value.
+      throw new FormulaError('#RANGE!');
+    case 'unary': {
+      const v = toNumber(evaluate(node.operand, ctx));
+      return node.op === '-' ? -v : v;
+    }
+    case 'binary':
+      return evalBinary(node.op, node.left, node.right, ctx);
+    case 'func':
+      return evalFunc(node.name, node.args, ctx);
+  }
+}
+
+function evalBinary(
+  op: string,
+  leftNode: Node,
+  rightNode: Node,
+  ctx: EvalContext
+): CellValue {
+  // Arithmetic
+  if (op === '+' || op === '-' || op === '*' || op === '/') {
+    const a = toNumber(evaluate(leftNode, ctx));
+    const b = toNumber(evaluate(rightNode, ctx));
+    switch (op) {
+      case '+':
+        return a + b;
+      case '-':
+        return a - b;
+      case '*':
+        return a * b;
+      case '/':
+        if (b === 0) throw new FormulaError('#DIV/0!');
+        return a / b;
+    }
+  }
+
+  // Comparison
+  const a = evaluate(leftNode, ctx);
+  const b = evaluate(rightNode, ctx);
+  return compare(op, a, b);
+}
+
+function compare(op: string, a: CellValue, b: CellValue): boolean {
+  const stringy = typeof a === 'string' || typeof b === 'string';
+
+  if (op === '=' || op === '<>') {
+    const eq = stringy ? toStr(a) === toStr(b) : toNumber(a) === toNumber(b);
+    return op === '=' ? eq : !eq;
+  }
+
+  // Ordering comparisons
+  if (stringy) {
+    const sa = toStr(a);
+    const sb = toStr(b);
+    switch (op) {
+      case '>':
+        return sa > sb;
+      case '<':
+        return sa < sb;
+      case '>=':
+        return sa >= sb;
+      case '<=':
+        return sa <= sb;
+    }
+  }
+  const na = toNumber(a);
+  const nb = toNumber(b);
+  switch (op) {
+    case '>':
+      return na > nb;
+    case '<':
+      return na < nb;
+    case '>=':
+      return na >= nb;
+    case '<=':
+      return na <= nb;
+  }
+  throw new FormulaError('#OP!');
+}
+
+function evalFunc(name: string, args: Node[], ctx: EvalContext): CellValue {
+  if (name === 'IF') {
+    if (args.length !== 3) {
+      throw new FormulaError('#IF!');
+    }
+    const cond = toBool(evaluate(args[0], ctx));
+    // Lazy: only evaluate the taken branch.
+    return cond ? evaluate(args[1], ctx) : evaluate(args[2], ctx);
+  }
+
+  if (AGG_FUNCS.has(name)) {
+    const nums = collectNumbers(args, ctx);
+    switch (name) {
+      case 'SUM':
+        return nums.reduce((s, x) => s + x, 0);
+      case 'COUNT':
+        return nums.length;
+      case 'AVERAGE':
+        return nums.length === 0
+          ? 0
+          : nums.reduce((s, x) => s + x, 0) / nums.length;
+      case 'MIN':
+        return nums.length === 0 ? 0 : Math.min(...nums);
+      case 'MAX':
+        return nums.length === 0 ? 0 : Math.max(...nums);
+    }
+  }
+
+  throw new FormulaError(`#NAME?`);
+}
+
+/** Collect numeric values from function arguments (ranges and scalars). */
+function collectNumbers(args: Node[], ctx: EvalContext): number[] {
+  const nums: number[] = [];
+  for (const arg of args) {
+    if (arg.kind === 'range') {
+      for (const ref of expandRange(arg.start, arg.end)) {
+        const v = ctx.resolve(ref);
+        if (typeof v === 'number') nums.push(v);
+      }
+    } else {
+      const v = evaluate(arg, ctx);
+      if (typeof v === 'number') nums.push(v);
+    }
+  }
+  return nums;
+}
+
+// --- Coercion helpers ---
+
+function toNumber(v: CellValue): number {
+  if (v === null) return 0;
+  if (typeof v === 'number') return v;
+  if (typeof v === 'boolean') return v ? 1 : 0;
+  // string: numeric strings allowed, otherwise an error
+  const trimmed = v.trim();
+  if (trimmed === '') return 0;
+  const n = Number(trimmed);
+  if (Number.isNaN(n)) throw new FormulaError('#VALUE!');
+  return n;
+}
+
+function toStr(v: CellValue): string {
+  if (v === null) return '';
+  if (typeof v === 'boolean') return v ? 'true' : 'false';
+  return String(v);
+}
+
+function toBool(v: CellValue): boolean {
+  if (v === null) return false;
+  if (typeof v === 'boolean') return v;
+  if (typeof v === 'number') return v !== 0;
+  return v.length > 0;
+}
+
+/** Walk the AST and collect every cell reference it depends on. */
+export function extractDeps(node: Node, out: Set<string>): void {
+  switch (node.kind) {
+    case 'ref':
+      out.add(node.ref);
+      break;
+    case 'range':
+      for (const ref of expandRange(node.start, node.end)) out.add(ref);
+      break;
+    case 'unary':
+      extractDeps(node.operand, out);
+      break;
+    case 'binary':
+      extractDeps(node.left, out);
+      extractDeps(node.right, out);
+      break;
+    case 'func':
+      for (const arg of node.args) extractDeps(arg, out);
+      break;
+    // number, string: no deps
+  }
+}
