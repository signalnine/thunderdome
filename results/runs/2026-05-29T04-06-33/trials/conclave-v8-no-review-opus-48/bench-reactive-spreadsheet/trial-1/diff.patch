+/**
+ * Reactive spreadsheet engine. Cells hold literal values or formulas; changing
+ * a cell automatically recomputes every cell that transitively depends on it.
+ * Circular dependencies are detected and rejected at `set` time.
+ */
+
+import { Node } from './ast.js';
+import { CellError, Evaluator, EvalValue, Scalar, scalarToString } from './evaluator.js';
+import { parseFormula } from './parser.js';
+import { normalizeRef } from './references.js';
+
+type CellKind = 'literal' | 'formula';
+
+interface CellRecord {
+  kind: CellKind;
+  /** Original input (literal value or formula string). */
+  raw: string | number | boolean;
+  /** Parsed AST for formula cells. */
+  ast?: Node;
+  /** Cells this cell directly references. */
+  precedents: Set<string>;
+  /** Last computed value. */
+  value: EvalValue;
+}
+
+/** Collect every cell reference a formula AST depends on. */
+function collectRefs(node: Node, out: Set<string>): void {
+  switch (node.type) {
+    case 'cell':
+      out.add(node.ref);
+      return;
+    case 'range':
+      for (const ref of node.refs) out.add(ref);
+      return;
+    case 'unary':
+      collectRefs(node.operand, out);
+      return;
+    case 'binary':
+      collectRefs(node.left, out);
+      collectRefs(node.right, out);
+      return;
+    case 'function':
+      for (const arg of node.args) collectRefs(arg, out);
+      return;
+    default:
+      return;
+  }
+}
+
+export class Spreadsheet {
+  private readonly cells = new Map<string, CellRecord>();
+  /** ref -> set of cells that directly depend on it. */
+  private readonly dependents = new Map<string, Set<string>>();
+
+  /** Set a cell's value: a raw value, or a formula string starting with '='. */
+  set(cell: string, value: string | number | boolean): void {
+    const ref = normalizeRef(cell);
+
+    const isFormula = typeof value === 'string' && value.startsWith('=');
+
+    let ast: Node | undefined;
+    const newPrecedents = new Set<string>();
+
+    if (isFormula) {
+      // Parse first — a parse error must not mutate any state.
+      ast = parseFormula((value as string).slice(1));
+      collectRefs(ast, newPrecedents);
+
+      // Reject cycles before applying any changes.
+      if (this.wouldCycle(ref, newPrecedents)) {
+        throw new Error(`Circular reference detected at ${ref}`);
+      }
+    }
+
+    // Detach old dependency edges (if the cell previously had any).
+    this.detachPrecedents(ref);
+
+    const record: CellRecord = {
+      kind: isFormula ? 'formula' : 'literal',
+      raw: value,
+      ast,
+      precedents: newPrecedents,
+      value: isFormula ? null : (value as Scalar),
+    };
+    this.cells.set(ref, record);
+
+    // Attach new dependency edges.
+    for (const p of newPrecedents) {
+      let set = this.dependents.get(p);
+      if (!set) {
+        set = new Set<string>();
+        this.dependents.set(p, set);
+      }
+      set.add(ref);
+    }
+
+    // Recompute this cell and everything downstream of it.
+    this.recompute(ref);
+  }
+
+  /** Get a cell's computed value. Returns null for empty cells. */
+  get(cell: string): string | number | boolean | null {
+    const ref = normalizeRef(cell);
+    const rec = this.cells.get(ref);
+    if (!rec) return null;
+    return this.externalize(rec.value);
+  }
+
+  /** Get the display string for a cell's computed value. */
+  getDisplay(cell: string): string {
+    const ref = normalizeRef(cell);
+    const rec = this.cells.get(ref);
+    if (!rec) return '';
+    if (rec.value instanceof CellError) return rec.value.code;
+    return scalarToString(rec.value);
+  }
+
+  /** Get all non-empty cells as a Map from cell reference to computed value. */
+  getCells(): Map<string, string | number | boolean | null> {
+    const out = new Map<string, string | number | boolean | null>();
+    for (const [ref, rec] of this.cells) {
+      out.set(ref, this.externalize(rec.value));
+    }
+    return out;
+  }
+
+  /** Convert an internal value (which may be a CellError) to the public form. */
+  private externalize(value: EvalValue): string | number | boolean | null {
+    if (value instanceof CellError) return value.code;
+    return value;
+  }
+
+  /** Read a cell's current stored value for use during evaluation. */
+  private resolve = (ref: string): EvalValue => {
+    const rec = this.cells.get(ref);
+    return rec ? rec.value : null;
+  };
+
+  /** Remove this cell from its current precedents' dependent sets. */
+  private detachPrecedents(ref: string): void {
+    const existing = this.cells.get(ref);
+    if (!existing) return;
+    for (const p of existing.precedents) {
+      const set = this.dependents.get(p);
+      if (set) {
+        set.delete(ref);
+        if (set.size === 0) this.dependents.delete(p);
+      }
+    }
+  }
+
+  /**
+   * Would assigning `newPrecedents` to `cell` create a cycle? Walks the
+   * existing precedent graph outward from the new precedents; reaching `cell`
+   * means it would (transitively) depend on itself.
+   */
+  private wouldCycle(cell: string, newPrecedents: Set<string>): boolean {
+    const stack = [...newPrecedents];
+    const visited = new Set<string>();
+    while (stack.length > 0) {
+      const cur = stack.pop() as string;
+      if (cur === cell) return true;
+      if (visited.has(cur)) continue;
+      visited.add(cur);
+      const rec = this.cells.get(cur);
+      if (rec) {
+        for (const p of rec.precedents) stack.push(p);
+      }
+    }
+    return false;
+  }
+
+  /**
+   * Recompute `start` and all cells transitively depending on it, in
+   * dependency order so each cell sees up-to-date precedents.
+   */
+  private recompute(start: string): void {
+    // Affected = start plus all transitive dependents.
+    const affected = new Set<string>();
+    const stack = [start];
+    while (stack.length > 0) {
+      const cur = stack.pop() as string;
+      if (affected.has(cur)) continue;
+      affected.add(cur);
+      const deps = this.dependents.get(cur);
+      if (deps) {
+        for (const d of deps) stack.push(d);
+      }
+    }
+
+    // Topological order via post-order DFS over precedents within `affected`.
+    const order: string[] = [];
+    const visited = new Set<string>();
+    const visit = (n: string): void => {
+      if (visited.has(n)) return;
+      visited.add(n);
+      const rec = this.cells.get(n);
+      if (rec) {
+        for (const p of rec.precedents) {
+          if (affected.has(p)) visit(p);
+        }
+      }
+      order.push(n);
+    };
+    for (const n of affected) visit(n);
+
+    // Evaluate formula cells in order; literals already hold their value.
+    const evaluator = new Evaluator(this.resolve);
+    for (const ref of order) {
+      const rec = this.cells.get(ref);
+      if (rec && rec.kind === 'formula' && rec.ast) {
+        rec.value = evaluator.evaluate(rec.ast);
+      }
+    }
+  }
+}
