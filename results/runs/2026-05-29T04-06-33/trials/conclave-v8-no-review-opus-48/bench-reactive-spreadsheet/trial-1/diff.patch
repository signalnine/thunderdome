+++ b/src/references.ts
@@ -0,0 +1,94 @@
+/**
+ * Cell reference utilities: parsing `A1`-style references, converting between
+ * column letters and 1-based indices, and expanding ranges into cell lists.
+ */
+
+const CELL_RE = /^([A-Za-z]+)([0-9]+)$/;
+
+export interface CellCoord {
+  col: number; // 1-based column index (A = 1)
+  row: number; // 1-based row index
+}
+
+/** Convert a column label (e.g. "A", "Z", "AA") to a 1-based index. */
+export function colLabelToNumber(label: string): number {
+  let n = 0;
+  for (const ch of label.toUpperCase()) {
+    n = n * 26 + (ch.charCodeAt(0) - 64); // 'A' -> 1
+  }
+  return n;
+}
+
+/** Convert a 1-based column index back to its letter label. */
+export function numberToColLabel(num: number): string {
+  let n = num;
+  let label = '';
+  while (n > 0) {
+    const rem = (n - 1) % 26;
+    label = String.fromCharCode(65 + rem) + label;
+    n = Math.floor((n - 1) / 26);
+  }
+  return label;
+}
+
+/** Returns true if `ref` is a syntactically valid cell reference. */
+export function isValidRef(ref: string): boolean {
+  return CELL_RE.test(ref.trim());
+}
+
+/**
+ * Normalize a cell reference to canonical uppercase form (e.g. "a1" -> "A1").
+ * Throws if the reference is invalid.
+ */
+export function normalizeRef(ref: string): string {
+  const m = CELL_RE.exec(ref.trim());
+  if (!m) {
+    throw new Error(`Invalid cell reference: "${ref}"`);
+  }
+  const col = m[1].toUpperCase();
+  const row = String(parseInt(m[2], 10));
+  if (row === '0') {
+    throw new Error(`Invalid cell reference (row must be >= 1): "${ref}"`);
+  }
+  return col + row;
+}
+
+/** Parse a normalized/raw ref into column/row coordinates. */
+export function parseRef(ref: string): CellCoord {
+  const m = CELL_RE.exec(ref.trim());
+  if (!m) {
+    throw new Error(`Invalid cell reference: "${ref}"`);
+  }
+  const row = parseInt(m[2], 10);
+  if (row < 1) {
+    throw new Error(`Invalid cell reference (row must be >= 1): "${ref}"`);
+  }
+  return { col: colLabelToNumber(m[1]), row };
+}
+
+/** Build a canonical ref string from coordinates. */
+export function coordToRef(coord: CellCoord): string {
+  return numberToColLabel(coord.col) + coord.row;
+}
+
+/**
+ * Expand a range "start:end" into the ordered list of cell refs it covers.
+ * Handles column ranges, row ranges, and 2D block ranges. The corners may be
+ * given in any order.
+ */
+export function expandRange(start: string, end: string): string[] {
+  const a = parseRef(start);
+  const b = parseRef(end);
+  const colMin = Math.min(a.col, b.col);
+  const colMax = Math.max(a.col, b.col);
+  const rowMin = Math.min(a.row, b.row);
+  const rowMax = Math.max(a.row, b.row);
+
+  const refs: string[] = [];
+  for (let row = rowMin; row <= rowMax; row++) {
+    for (let col = colMin; col <= colMax; col++) {
+      refs.push(coordToRef({ col, row }));
+    }
+  }
+  return refs;
+}
