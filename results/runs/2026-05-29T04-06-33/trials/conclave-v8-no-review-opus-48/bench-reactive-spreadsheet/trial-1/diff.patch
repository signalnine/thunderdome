+import { describe, it, expect } from 'vitest';
+import { Spreadsheet } from './index.js';
+
+describe('cell values & round-trip', () => {
+  it('round-trips a number', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 42);
+    expect(s.get('A1')).toBe(42);
+  });
+
+  it('round-trips a float', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 3.14);
+    expect(s.get('A1')).toBe(3.14);
