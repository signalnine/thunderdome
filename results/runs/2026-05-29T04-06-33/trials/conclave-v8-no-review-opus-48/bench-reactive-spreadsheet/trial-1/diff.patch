+/** AST node definitions for parsed formulas. */
+
+export type Node =
+  | NumberNode
+  | StringNode
+  | BooleanNode
+  | CellNode
+  | RangeNode
+  | UnaryNode
+  | BinaryNode
+  | FunctionNode;
+
+export interface NumberNode {
+  type: 'number';
+  value: number;
+}
+
+export interface StringNode {
+  type: 'string';
+  value: string;
+}
+
+export interface BooleanNode {
+  type: 'boolean';
+  value: boolean;
+}
+
+export interface CellNode {
+  type: 'cell';
+  ref: string; // normalized, e.g. "A1"
+}
+
+export interface RangeNode {
+  type: 'range';
+  refs: string[]; // expanded, normalized cell refs
+}
+
+export type ArithOp = '+' | '-' | '*' | '/';
+export type CompareOp = '>' | '<' | '>=' | '<=' | '=' | '<>';
+export type BinaryOp = ArithOp | CompareOp;
+
+export interface UnaryNode {
+  type: 'unary';
+  op: '+' | '-';
+  operand: Node;
+}
+
+export interface BinaryNode {
+  type: 'binary';
+  op: BinaryOp;
+  left: Node;
+  right: Node;
+}
+
+export interface FunctionNode {
+  type: 'function';
+  name: string; // uppercase
+  args: Node[];
+}
