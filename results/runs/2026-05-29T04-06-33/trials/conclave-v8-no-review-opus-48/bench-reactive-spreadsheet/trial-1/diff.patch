+/**
+ * Tokenizer + recursive-descent parser for spreadsheet formulas.
+ *
+ * Grammar (highest-level first):
+ *   expression  := comparison
+ *   comparison  := additive ( ('>'|'<'|'>='|'<='|'='|'<>') additive )?
+ *   additive    := multiplicative ( ('+'|'-') multiplicative )*
+ *   multiplicative := unary ( ('*'|'/') unary )*
+ *   unary       := ('+'|'-') unary | primary
+ *   primary     := number | string | boolean | funcCall | cellOrRange
+ *                | '(' expression ')'
+ *   cellOrRange := CELLREF ( ':' CELLREF )?
+ */
+
+import {
+  ArithOp,
+  CompareOp,
+  Node,
+} from './ast.js';
+import { expandRange, isValidRef, normalizeRef } from './references.js';
+
+type TokenType =
+  | 'number'
+  | 'string'
+  | 'name' // identifier: function name, cell ref, or boolean literal
+  | 'op'
+  | 'lparen'
+  | 'rparen'
+  | 'comma'
+  | 'colon';
+
+interface Token {
+  type: TokenType;
+  value: string;
+}
+
+const COMPARE_OPS: ReadonlySet<string> = new Set(['>', '<', '>=', '<=', '=', '<>']);
+
+function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+  const n = input.length;
+
+  while (i < n) {
+    const ch = input[i];
+
+    if (ch === ' ' || ch === '\t' || ch === '\n' || ch === '\r') {
+      i++;
+      continue;
+    }
+
+    // String literal (double-quoted), supporting "" as an escaped quote.
+    if (ch === '"') {
+      let str = '';
+      i++; // consume opening quote
+      while (i < n) {
+        if (input[i] === '"') {
+          if (input[i + 1] === '"') {
+            str += '"';
+            i += 2;
+            continue;
+          }
+          break;
+        }
+        str += input[i];
+        i++;
+      }
+      if (i >= n || input[i] !== '"') {
+        throw new Error('Unterminated string literal in formula');
+      }
+      i++; // consume closing quote
+      tokens.push({ type: 'string', value: str });
+      continue;
+    }
+
+    // Number literal (integer or decimal).
+    if ((ch >= '0' && ch <= '9') || (ch === '.' && /[0-9]/.test(input[i + 1] ?? ''))) {
+      let num = '';
+      while (i < n && /[0-9.]/.test(input[i])) {
+        num += input[i];
+        i++;
+      }
+      if ((num.match(/\./g) ?? []).length > 1) {
+        throw new Error(`Invalid number literal: "${num}"`);
+      }
+      tokens.push({ type: 'number', value: num });
+      continue;
+    }
+
+    // Identifier: letters optionally followed by digits (cell ref / function / boolean).
+    if (/[A-Za-z_]/.test(ch)) {
+      let name = '';
+      while (i < n && /[A-Za-z0-9_]/.test(input[i])) {
+        name += input[i];
+        i++;
+      }
+      tokens.push({ type: 'name', value: name });
+      continue;
+    }
+
+    // Two-character comparison operators.
+    const two = input.slice(i, i + 2);
+    if (two === '>=' || two === '<=' || two === '<>') {
+      tokens.push({ type: 'op', value: two });
+      i += 2;
+      continue;
+    }
+
+    switch (ch) {
+      case '+':
+      case '-':
+      case '*':
+      case '/':
+      case '>':
+      case '<':
+      case '=':
+        tokens.push({ type: 'op', value: ch });
+        i++;
+        continue;
+      case '(':
+        tokens.push({ type: 'lparen', value: ch });
+        i++;
+        continue;
+      case ')':
+        tokens.push({ type: 'rparen', value: ch });
+        i++;
+        continue;
+      case ',':
+        tokens.push({ type: 'comma', value: ch });
+        i++;
+        continue;
+      case ':':
+        tokens.push({ type: 'colon', value: ch });
+        i++;
+        continue;
+      default:
+        throw new Error(`Unexpected character in formula: "${ch}"`);
+    }
+  }
+
+  return tokens;
+}
+
+class Parser {
+  private pos = 0;
+
+  constructor(private readonly tokens: Token[]) {}
+
+  parse(): Node {
+    if (this.tokens.length === 0) {
+      throw new Error('Empty formula');
+    }
+    const node = this.parseExpression();
+    if (this.pos < this.tokens.length) {
+      throw new Error(
+        `Unexpected token "${this.tokens[this.pos].value}" in formula`,
+      );
+    }
+    return node;
+  }
+
+  private peek(): Token | undefined {
+    return this.tokens[this.pos];
+  }
+
+  private next(): Token {
+    const t = this.tokens[this.pos];
+    if (!t) {
+      throw new Error('Unexpected end of formula');
+    }
+    this.pos++;
+    return t;
+  }
+
+  private expect(type: TokenType): Token {
+    const t = this.peek();
+    if (!t || t.type !== type) {
+      throw new Error(
+        `Expected ${type} but found ${t ? `"${t.value}"` : 'end of formula'}`,
+      );
+    }
+    return this.next();
+  }
+
+  private parseExpression(): Node {
+    return this.parseComparison();
+  }
+
+  private parseComparison(): Node {
+    let left = this.parseAdditive();
+    const t = this.peek();
+    if (t && t.type === 'op' && COMPARE_OPS.has(t.value)) {
+      this.next();
+      const right = this.parseAdditive();
+      left = { type: 'binary', op: t.value as CompareOp, left, right };
+    }
+    return left;
+  }
+
+  private parseAdditive(): Node {
+    let left = this.parseMultiplicative();
+    let t = this.peek();
+    while (t && t.type === 'op' && (t.value === '+' || t.value === '-')) {
+      this.next();
+      const right = this.parseMultiplicative();
+      left = { type: 'binary', op: t.value as ArithOp, left, right };
+      t = this.peek();
+    }
+    return left;
+  }
+
+  private parseMultiplicative(): Node {
+    let left = this.parseUnary();
+    let t = this.peek();
+    while (t && t.type === 'op' && (t.value === '*' || t.value === '/')) {
+      this.next();
+      const right = this.parseUnary();
+      left = { type: 'binary', op: t.value as ArithOp, left, right };
+      t = this.peek();
+    }
+    return left;
+  }
+
+  private parseUnary(): Node {
+    const t = this.peek();
+    if (t && t.type === 'op' && (t.value === '+' || t.value === '-')) {
+      this.next();
+      const operand = this.parseUnary();
+      return { type: 'unary', op: t.value as '+' | '-', operand };
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): Node {
+    const t = this.peek();
+    if (!t) {
+      throw new Error('Unexpected end of formula');
+    }
+
+    if (t.type === 'number') {
+      this.next();
+      return { type: 'number', value: Number(t.value) };
+    }
+
+    if (t.type === 'string') {
+      this.next();
+      return { type: 'string', value: t.value };
+    }
+
+    if (t.type === 'lparen') {
+      this.next();
+      const inner = this.parseExpression();
+      this.expect('rparen');
+      return inner;
+    }
+
+    if (t.type === 'name') {
+      return this.parseName();
+    }
+
+    throw new Error(`Unexpected token "${t.value}" in formula`);
+  }
+
+  private parseName(): Node {
+    const t = this.next();
+    const name = t.value;
+
+    // Function call: NAME '(' args ')'
+    if (this.peek()?.type === 'lparen') {
+      this.next(); // consume '('
+      const args: Node[] = [];
+      if (this.peek()?.type !== 'rparen') {
+        args.push(this.parseExpression());
+        while (this.peek()?.type === 'comma') {
+          this.next();
+          args.push(this.parseExpression());
+        }
+      }
+      this.expect('rparen');
+      return { type: 'function', name: name.toUpperCase(), args };
+    }
+
+    // Boolean literals.
+    const upper = name.toUpperCase();
+    if (upper === 'TRUE') {
+      return { type: 'boolean', value: true };
+    }
+    if (upper === 'FALSE') {
+      return { type: 'boolean', value: false };
+    }
+
+    // Cell reference, possibly the start of a range.
+    if (!isValidRef(name)) {
+      throw new Error(`Invalid cell reference or identifier: "${name}"`);
+    }
+    const startRef = normalizeRef(name);
+
+    if (this.peek()?.type === 'colon') {
+      this.next(); // consume ':'
+      const endTok = this.expect('name');
+      if (!isValidRef(endTok.value)) {
+        throw new Error(`Invalid cell reference in range: "${endTok.value}"`);
+      }
+      const refs = expandRange(startRef, normalizeRef(endTok.value));
+      return { type: 'range', refs };
+    }
+
+    return { type: 'cell', ref: startRef };
+  }
+}
+
+/** Parse a formula body (the text after the leading '='). */
+export function parseFormula(formula: string): Node {
+  const tokens = tokenize(formula);
+  return new Parser(tokens).parse();
+}
