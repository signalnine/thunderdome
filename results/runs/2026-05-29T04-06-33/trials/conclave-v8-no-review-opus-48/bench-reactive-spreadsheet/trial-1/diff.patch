+/**
+ * Evaluate a formula AST against a resolver that supplies current cell values.
+ * Errors (division by zero, bad coercions, unknown functions) are represented
+ * as `CellError` values that propagate through dependent expressions rather
+ * than throwing.
+ */
+
+import { BinaryOp, Node } from './ast.js';
+
+/** A computed scalar value stored in / returned from a cell. */
+export type Scalar = number | string | boolean | null;
+
+/** Sentinel error value (e.g. "#DIV/0!") flowing through a computation. */
+export class CellError {
+  constructor(public readonly code: string) {}
+}
+
+export type EvalValue = Scalar | CellError;
+
+/** Resolves the current computed value of a referenced cell (may be an error). */
+export type Resolver = (ref: string) => EvalValue;
+
+function isError(v: EvalValue): v is CellError {
+  return v instanceof CellError;
+}
+
+/** Coerce a value to a number for arithmetic, or return a CellError. */
+function toNumber(v: EvalValue): number | CellError {
+  if (isError(v)) return v;
+  if (v === null) return 0;
+  if (typeof v === 'number') return v;
+  if (typeof v === 'boolean') return v ? 1 : 0;
+  // string
+  const trimmed = v.trim();
+  if (trimmed === '') return 0;
+  if (/^[+-]?(\d+\.?\d*|\.\d+)$/.test(trimmed)) {
+    return Number(trimmed);
+  }
+  return new CellError('#VALUE!');
+}
+
+/** Determine truthiness of a condition value for IF. */
+function isTruthy(v: EvalValue): boolean | CellError {
+  if (isError(v)) return v;
+  if (v === null) return false;
+  if (typeof v === 'boolean') return v;
+  if (typeof v === 'number') return v !== 0;
+  return v.length > 0;
+}
+
+interface RangeValues {
+  /** All resolved scalar values in the range. */
+  all: Scalar[];
+  /** Only the numeric values (booleans excluded). */
+  numbers: number[];
+}
+
+export class Evaluator {
+  constructor(private readonly resolve: Resolver) {}
+
+  evaluate(node: Node): EvalValue {
+    switch (node.type) {
+      case 'number':
+        return node.value;
+      case 'string':
+        return node.value;
+      case 'boolean':
+        return node.value;
+      case 'cell':
+        return this.resolve(node.ref);
+      case 'range':
+        // A bare range outside a function is not a scalar.
+        return new CellError('#VALUE!');
+      case 'unary':
+        return this.evalUnary(node.op, this.evaluate(node.operand));
+      case 'binary':
+        return this.evalBinary(node.op, node.left, node.right);
+      case 'function':
+        return this.evalFunction(node.name, node.args);
+    }
+  }
+
+  private evalUnary(op: '+' | '-', operand: EvalValue): EvalValue {
+    const num = toNumber(operand);
+    if (isError(num)) return num;
+    return op === '-' ? -num : num;
+  }
+
+  private evalBinary(op: BinaryOp, leftNode: Node, rightNode: Node): EvalValue {
+    const left = this.evaluate(leftNode);
+    const right = this.evaluate(rightNode);
+    if (isError(left)) return left;
+    if (isError(right)) return right;
+
+    switch (op) {
+      case '+':
+      case '-':
+      case '*':
+      case '/':
+        return this.evalArithmetic(op, left, right);
+      default:
+        return this.evalComparison(op, left, right);
+    }
+  }
+
+  private evalArithmetic(
+    op: '+' | '-' | '*' | '/',
+    left: Scalar,
+    right: Scalar,
+  ): EvalValue {
+    const a = toNumber(left);
+    if (isError(a)) return a;
+    const b = toNumber(right);
+    if (isError(b)) return b;
+
+    switch (op) {
+      case '+':
+        return a + b;
+      case '-':
+        return a - b;
+      case '*':
+        return a * b;
+      case '/':
+        if (b === 0) return new CellError('#DIV/0!');
+        return a / b;
+    }
+  }
+
+  private evalComparison(
+    op: '>' | '<' | '>=' | '<=' | '=' | '<>',
+    left: Scalar,
+    right: Scalar,
+  ): EvalValue {
+    // Equality/inequality: compare numerically when both coerce to numbers,
+    // otherwise compare by string value.
+    if (op === '=' || op === '<>') {
+      const equal = this.looseEqual(left, right);
+      return op === '=' ? equal : !equal;
+    }
+
+    // Ordering operators: numeric comparison.
+    const a = toNumber(left);
+    if (isError(a)) return a;
+    const b = toNumber(right);
+    if (isError(b)) return b;
+    switch (op) {
+      case '>':
+        return a > b;
+      case '<':
+        return a < b;
+      case '>=':
+        return a >= b;
+      case '<=':
+        return a <= b;
+    }
+  }
+
+  private looseEqual(left: Scalar, right: Scalar): boolean {
+    const ln = typeof left === 'number' || typeof left === 'boolean' || left === null;
+    const rn = typeof right === 'number' || typeof right === 'boolean' || right === null;
+    if (ln && rn) {
+      const a = toNumber(left);
+      const b = toNumber(right);
+      if (isError(a) || isError(b)) return false;
+      return a === b;
+    }
+    // At least one side is a string: compare by string representation.
+    return scalarToString(left) === scalarToString(right);
+  }
+
+  private collectRange(node: Node): RangeValues | CellError {
+    if (node.type !== 'range') {
+      // A single cell or scalar expression acts as a one-element range.
+      const v = this.evaluate(node);
+      if (isError(v)) return v;
+      const numbers = typeof v === 'number' ? [v] : [];
+      return { all: [v], numbers };
+    }
+    const all: Scalar[] = [];
+    const numbers: number[] = [];
+    for (const ref of node.refs) {
+      const v = this.resolve(ref);
+      if (isError(v)) return v;
+      all.push(v);
+      if (typeof v === 'number') {
+        numbers.push(v);
+      }
+    }
+    return { all, numbers };
+  }
+
+  private evalFunction(name: string, args: Node[]): EvalValue {
+    switch (name) {
+      case 'SUM':
+        return this.aggregate(args, (nums) => nums.reduce((a, b) => a + b, 0), 0);
+      case 'AVERAGE':
+        return this.aggregate(
+          args,
+          (nums) => nums.reduce((a, b) => a + b, 0) / nums.length,
+          new CellError('#DIV/0!'),
+        );
+      case 'MIN':
+        return this.aggregate(args, (nums) => Math.min(...nums), 0);
+      case 'MAX':
+        return this.aggregate(args, (nums) => Math.max(...nums), 0);
+      case 'COUNT':
+        return this.countFn(args);
+      case 'IF':
+        return this.ifFn(args);
+      default:
+        return new CellError('#NAME?');
+    }
+  }
+
+  /** Shared helper for numeric aggregate functions over their argument ranges. */
+  private aggregate(
+    args: Node[],
+    fn: (nums: number[]) => number,
+    empty: EvalValue,
+  ): EvalValue {
+    const nums: number[] = [];
+    for (const arg of args) {
+      const rv = this.collectRange(arg);
+      if (rv instanceof CellError) return rv;
+      nums.push(...rv.numbers);
+    }
+    if (nums.length === 0) return empty;
+    return fn(nums);
+  }
+
+  private countFn(args: Node[]): EvalValue {
+    let count = 0;
+    for (const arg of args) {
+      const rv = this.collectRange(arg);
+      if (rv instanceof CellError) return rv;
+      count += rv.numbers.length;
+    }
+    return count;
+  }
+
+  private ifFn(args: Node[]): EvalValue {
+    if (args.length !== 3) {
+      return new CellError('#ERROR!');
+    }
+    const cond = isTruthy(this.evaluate(args[0]));
+    if (cond instanceof CellError) return cond;
+    return cond ? this.evaluate(args[1]) : this.evaluate(args[2]);
+  }
+}
+
+/** Render a scalar as its display string. */
+export function scalarToString(v: Scalar): string {
+  if (v === null) return '';
+  if (typeof v === 'boolean') return v ? 'true' : 'false';
+  return String(v);
+}
