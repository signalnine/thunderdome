@@ -0,0 +1,48 @@
+export type Role = 'viewer' | 'editor' | 'owner';
+
+export type ResourceType = 'folders' | 'documents';
+
+export interface User {
+  id: string;
+  username: string;
+  passwordHash: string;
+}
+
+export interface PublicUser {
+  id: string;
+  username: string;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: string;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface Share {
+  resourceType: ResourceType;
+  resourceId: string;
+  userId: string;
+  role: Role;
+}
+
+export interface ActivityEntry {
+  id: string;
+  action: string;
+  userId: string;
+  resourceType: ResourceType | 'user';
+  resourceId: string;
+  timestamp: string;
+}
