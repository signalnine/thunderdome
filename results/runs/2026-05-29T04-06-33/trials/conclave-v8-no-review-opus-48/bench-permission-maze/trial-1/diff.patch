ost('/auth/login', (req: Request, res: Response) => {\n    const { username, password } = req.body ?? {};\n    if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {\n      res.status(400).json({ error: 'username and password are required' });\n      return;\n    }\n    const userId = store.usersByName.get(username);\n    const user = userId ? store.users.get(userId) : undefined;\n    if (!user || user.passwordHash !== store.createUser.length /* placeholder */ && false) {\n      // unreachable; replaced below\n    }\n    if (!user) {\n      res.status(401).json({ error: 'invalid credentials' });\n      return;\n    }\n    const { hashPassword } = require('./store.js') as typeof import('./store.js');\n    if (user.passwordHash !== hashPassword(password)) {\n      res.status(401).json({ error: 'invalid credentials' });\n      return;\n    }\n    const token = store.createToken(user.id);\n    res.status(200).json({ token, user: publicUser(user.id, user.username) });\n  });\n\n  // ---- Folders ----\n  app.post('/folders', auth, (req: AuthedRequest, res: Response) => {\n    const userId = req.userId!;\n    const { name, parentId } = req.body ?? {};\n    if (typeof name !== 'string' || !name) {\n      res.status(400).json({ error: 'name is required' });\n      return;\n    }\n    let parent: string | null = null;\n    if (parentId !== undefined && parentId !== null) {\n      if (typeof parentId !== 'string' || !store.folders.has(parentId)) {\n        res.status(404).json({ error: 'parent folder not found' });\n        return;\n      }\n      if (!hasAtLeast(effectiveRole(store, userId, 'folders', parentId), 'editor')) {\n        res.status(403).json({ error: 'insufficient permission on parent folder' });\n        return;\n      }\n      parent = parentId;\n    }\n    const folder = store.createFolder(name, parent, userId);\n    store.log('folder.create', userId, 'folders', folder.id);\n    res.status(201).json(folder);\n  });\n\n  app.get('/folders/:id', auth, (req: AuthedRequest, res: Response) => {\n    const userId = req.userId!;\n    const folder = store.folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'folder not found' });\n      return;\n    }\n    const role = effectiveRole(store, userId, 'folders', folder.id);\n    if (!hasAtLeast(role, 'viewer')) {\n      res.status(403).json({ error: 'access denied' });\n      return;\n    }\n    res.status(200).json({ ...folder, role });\n  });\n\n  app.put('/folders/:id', auth, (req: AuthedRequest, res: Response) => {\n    const userId = req.userId!;\n    const folder = store.folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'folder not found' });\n      return;\n    }\n    if (!hasAtLeast(effectiveRole(store, userId, 'folders', folder.id), 'editor')) {\n      res.status(403).json({ error: 'access denied' });\n      return;\n    }\n    const { name, parentId } = req.body ?? {};\n    if (name !== undefined) {\n      if (typeof name !== 'string' || !name) {\n        res.status(400).json({ error: 'name must be a non-empty string' });\n        return;\n      }\n      folder.name = name;\n    }\n    if (parentId !== undefined) {\n      if (parentId !== null && (typeof parentId !== 'string' || !store.folders.has(parentId))) {\n        res.status(404).json({ error: 'parent folder not found' });\n        return;\n      }\n      if (parentId === folder.id) {\n        res.status(400).json({ error: 'folder cannot be its own parent' });\n        return;\n      }\n      folder.parentId = parentId;\n    }\n    store.log('folder.update', userId, 'folders', folder.id);\n    res.status(200).json(folder);\n  });\n\n  app.delete('/folders/:id', auth, (req: AuthedRequest, res: Response) => {\n    const userId = req.userId!;\n    const folder = store.folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'folder not found' });\n      return;\n    }\n    if (!hasAtLeast(effectiveRole(store, userId, 'folders', folder.id), 'owner')) {\n      res.status(403).json({ error: 'access denied' });\n      return;\n    }\n    store.deleteFolderCascade(folder.id);\n    store.log('folder.delete', userId, 'folders', folder.id);\n    res.status(204).end();\n  });\n\n  // ---- Documents ----\n  app.post('/documents', auth, (req: AuthedRequest, res: Response) => {\n    const userId = req.userId!;\n    const { title, content, folderId } = req.body ?? {};\n    if (typeof title !== 'string' || !title || typeof folderId !== 'string' || !folderId) {\n      res.status(400).json({ error: 'title and folderId are required' });\n      return;\n    }\n    if (!store.folders.has(folderId)) {\n      res.status(404).json({ error: 'folder not found' });\n      return;\n    }\n    if (!hasAtLeast(effectiveRole(store, userId, 'folders', folderId), 'editor')) {\n      res.status(403).json({ error: 'insufficient permission on folder' });\n      return;\n    }\n    const doc = store.createDocument(title, typeof content === 'string' ? content : '', folderId, userId);\n    store.log('document.create', userId, 'documents', doc.id);\n    res.status(201).json(doc);\n  });\n\n  app.get('/documents/:id', auth, (req: AuthedRequest, res: Response) => {\n    const userId = req.userId!;\n    const doc = store.documents.get(req.params.id);\n    if (!doc) {\n      res.status(404).json({ error: 'document not found' });\n      return;\n    }\n    const role = effectiveRole(store, userId, 'documents', doc.id);\n    if (!hasAtLeast(role, 'viewer')) {\n      res.status(403).json({ error: 'access denied' });\n      return;\n    }\n    res.status(200).json({ ...doc, role });\n  });\n\n  app.put('/documents/:id', auth, (req: AuthedRequest, res: Response) => {\n    const userId = req.userId!;\n    const doc = store.documents.get(req.params.id);\n    if (!doc) {\n      res.status(404).json({ error: 'document not found' });\n      return;\n    }\n    if (!hasAtLeast(effectiveRole(store, userId, 'documents', doc.id), 'editor')) {\n      res.status(403).json({ error: 'access denied' });\n      return;\n    }\n    const { title, content } = req.body ?? {};\n    if (title !== undefined) {\n      if (typeof title !== 'string' || !title) {\n        res.status(400).json({ error: 'title must be a non-empty string' });\n        return;\n      }\n      doc.title = title;\n    }\n    if (content !== undefined) {\n      if (typeof content !== 'string') {\n        res.status(400).json({ error: 'content must be a string' });\n        return;\n      }\n      doc.content = content;\n    }\n    doc.updatedAt = new Date().toISOString();\n    store.log('document.update', userId, 'documents', doc.id);\n    res.status(200).json(doc);\n  });\n\n  app.delete('/documents/:id', auth, (req: AuthedRequest, res: Response) => {\n    const userId = req.userId!;\n    const doc = store.documents.get(req.params.id);\n    if (!doc) {\n      res.status(404).json({ error: 'document not found' });\n      return;\n    }\n    if (!hasAtLeast(effectiveRole(store, userId, 'documents', doc.id), 'owner')) {\n      res.status(403).json({ error: 'access denied' });\n      return;\n    }\n    store.documents.delete(doc.id);\n    store.removeSharesFor('documents', doc.id);\n    store.log('document.delete', userId, 'documents', doc.id);\n    res.status(204).end();\n  });\n\n  // ---- Sharing ----\n  const shareHandler = (resourceType: ResourceType) =>\n    (req: AuthedRequest, res: Response): void => {\n      const userId = req.userId!;\n      const resourceId = req.params.id;\n      const exists =\n        resourceType === 'folders'\n          ? store.folders.has(resourceId)\n          : store.documents.has(resourceId);\n      if (!exists) {\n        res.status(404).json({ error: 'resource not found' });\n        return;\n      }\n      const { username, role } = req.body ?? {};\n      if (!isRole(role)) {\n        res.status(400).json({ error: 'role must be viewer, editor, or owner' });\n        return;\n      }\n      if (typeof username !== 'string' || !username) {\n        res.status(400).json({ error: 'username is required' });\n        return;\n      }\n      const actorRole = effectiveRole(store, userId, resourceType, resourceId);\n      // Must be at least editor to share at all.\n      if (!hasAtLeast(actorRole, 'editor')) {\n        res.status(403).json({ error: 'insufficient permission to share' });\n        return;\n      }\n      // Only owners may grant a role >= their authority on owner-level actions.\n      // Granting owner role (role management) requires owner.\n      if (ROLE_RANK[role as Role] >= ROLE_RANK.owner && !hasAtLeast(actorRole, 'owner')) {\n        res.status(403).json({ error: 'only an owner may grant the owner role' });\n        return;\n      }\n      const targetId = store.usersByName.get(username);\n      if (!targetId) {\n        res.status(404).json({ error: 'target user not found' });\n        return;\n      }\n      store.addShare(resourceType, resourceId, targetId, role);\n      store.log('share', userId, resourceType, resourceId);\n      res.status(201).json({ resourceType, resourceId, userId: targetId, role });\n    };\n\n  app.post('/folders/:id/share', auth, shareHandler('folders'));\n  app.post('/documents/:id/share', auth, shareHandler('documents'));\n\n  // ---- Activity ----\n  app.get('/activity', auth, (_req: AuthedRequest, res: Response) => {\n    res.status(200).json(store.activity);\n  });\n\n  // ---- Fallbacks ----\n  app.use((_req: Request, res: Response) => {\n    res.status(404).json({ error: 'not found' });\n  });\n\n  app.use((err: unknown, _req: Request, res: Response, _next: NextFunction) => {\n    const message = err instanceof Error ? err.message : 'internal error';\n    res.status(400).json({ error: message });\n  });\n\n  return app;\n}\n\nexport default createApp;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_crea