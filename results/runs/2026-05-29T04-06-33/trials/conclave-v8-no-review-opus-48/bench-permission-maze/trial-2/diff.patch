+}
diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..8032ca3
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,136 @@
+// In-memory data store, domain types, and permission resolution logic.
+
+export type Role = 'viewer' | 'editor' | 'owner';
+export type ResourceType = 'folder' | 'document';
+
+export interface User {
+  id: string;
+  username: string;
+  password: string;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: string;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: string;
+}
+
+export interface Share {
+  resourceType: ResourceType;
+  resourceId: string;
+  userId: string;
+  role: Role;
+}
+
+export interface ActivityEntry {
+  id: string;
+  action: string;
+  userId: string;
+  targetType: ResourceType | 'share';
+  targetId: string;
+  timestamp: string;
+}
+
+export const ROLE_LEVELS: Record<Role, number> = {
+  viewer: 1,
+  editor: 2,
+  owner: 3,
+};
+
+export function isRole(value: unknown): value is Role {
+  return value === 'viewer' || value === 'editor' || value === 'owner';
+}
+
+export class Store {
+  users = new Map<string, User>();
+  usersByUsername = new Map<string, string>();
+  tokens = new Map<string, string>(); // token -> userId
+  folders = new Map<string, Folder>();
+  documents = new Map<string, Document>();
+  shares: Share[] = [];
+  activity: ActivityEntry[] = [];
+
+  private counter = 0;
+
+  nextId(prefix: string): string {
+    this.counter += 1;
+    return `${prefix}_${this.counter}`;
+  }
+
+  log(action: string, userId: string, targetType: ActivityEntry['targetType'], targetId: string): void {
+    this.activity.push({
+      id: this.nextId('act'),
+      action,
+      userId,
+      targetType,
+      targetId,
+      timestamp: new Date().toISOString(),
+    });
+  }
+
+  // --- Permission resolution -------------------------------------------------
+
+  /** Effective role level a user has on a folder, including inheritance from ancestors. */
+  folderLevel(userId: string, folderId: string, visited = new Set<string>()): number {
+    if (visited.has(folderId)) return 0;
+    visited.add(folderId);
+
+    const folder = this.folders.get(folderId);
+    if (!folder) return 0;
+
+    let level = 0;
+    if (folder.ownerId === userId) level = ROLE_LEVELS.owner;
+
+    for (const share of this.shares) {
+      if (share.resourceType === 'folder' && share.resourceId === folderId && share.userId === userId) {
+        level = Math.max(level, ROLE_LEVELS[share.role]);
+      }
+    }
+
+    if (folder.parentId) {
+      level = Math.max(level, this.folderLevel(userId, folder.parentId, visited));
+    }
+
+    return level;
+  }
+
+  /** Effective role level on a document: own role + direct shares + inherited folder role. */
+  documentLevel(userId: string, documentId: string): number {
+    const doc = this.documents.get(documentId);
+    if (!doc) return 0;
+
+    let level = 0;
+    if (doc.ownerId === userId) level = ROLE_LEVELS.owner;
+
+    for (const share of this.shares) {
+      if (share.resourceType === 'document' && share.resourceId === documentId && share.userId === userId) {
+        level = Math.max(level, ROLE_LEVELS[share.role]);
+      }
+    }
+
+    level = Math.max(level, this.folderLevel(userId, doc.folderId));
+    return level;
+  }
+
+  level(userId: string, type: ResourceType, id: string): number {
+    return type === 'folder' ? this.folderLevel(userId, id) : this.documentLevel(userId, id);
+  }
+
+  /** The role currently directly granted to a user on a resource, if any. */
+  directShare(type: ResourceType, id: string, userId: string): Share | undefined {
+    return this.shares.find(
+      (s) => s.resourceType === type && s.resourceId === id && s.userId === userId,
+    );
+  }
+}
