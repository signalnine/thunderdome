index 0000000..393865e
--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,375 @@
+import express, { type Request, type Response, type NextFunction } from 'express';
+import { randomBytes } from 'node:crypto';
+import {
+  Store,
+  ROLE_LEVELS,
+  isRole,
+  type Role,
+  type ResourceType,
+} from './store.js';
+
+// Augment Express Request with the authenticated user id.
+interface AuthedRequest extends Request {
+  userId?: string;
+}
+
+export function createApp(): express.Express {
+  const app = express();
+  app.use(express.json());
+
+  const store = new Store();
+
+  // --- Auth middleware -------------------------------------------------------
+  const authenticate = (req: AuthedRequest, res: Response, next: NextFunction): void => {
+    const header = req.header('authorization');
+    if (!header || !header.startsWith('Bearer ')) {
+      res.status(401).json({ error: 'Missing or malformed Authorization header' });
+      return;
+    }
+    const token = header.slice('Bearer '.length).trim();
+    const userId = store.tokens.get(token);
+    if (!userId) {
+      res.status(401).json({ error: 'Invalid token' });
+      return;
+    }
+    req.userId = userId;
+    next();
+  };
+
+  // --- Auth routes -----------------------------------------------------------
+  app.post('/auth/register', (req: Request, res: Response): void => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+      res.status(400).json({ error: 'username and password are required' });
+      return;
+    }
+    if (store.usersByUsername.has(username)) {
+      res.status(409).json({ error: 'username already taken' });
+      return;
+    }
+    const id = store.nextId('user');
+    store.users.set(id, { id, username, password });
+    store.usersByUsername.set(username, id);
+    res.status(201).json({ id, username });
+  });
+
+  app.post('/auth/login', (req: Request, res: Response): void => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+      res.status(400).json({ error: 'username and password are required' });
+      return;
+    }
+    const userId = store.usersByUsername.get(username);
+    const user = userId ? store.users.get(userId) : undefined;
+    if (!user || user.password !== password) {
+      res.status(401).json({ error: 'invalid credentials' });
+      return;
+    }
+    const token = randomBytes(24).toString('hex');
+    store.tokens.set(token, user.id);
+    res.status(200).json({ token });
+  });
+
+  // Everything below requires authentication.
+  app.use(authenticate);
+
+  // --- Helpers ---------------------------------------------------------------
+  const requireLevel = (
+    req: AuthedRequest,
+    res: Response,
+    type: ResourceType,
+    id: string,
+    needed: number,
+  ): boolean => {
+    const exists = type === 'folder' ? store.folders.has(id) : store.documents.has(id);
+    if (!exists) {
+      res.status(404).json({ error: `${type} not found` });
+      return false;
+    }
+    const level = store.level(req.userId as string, type, id);
+    if (level === 0) {
+      res.status(403).json({ error: 'no access to this resource' });
+      return false;
+    }
+    if (level < needed) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return false;
+    }
+    return true;
+  };
+
+  // --- Folder routes ---------------------------------------------------------
+  app.post('/folders', (req: AuthedRequest, res: Response): void => {
+    const { name, parentId } = req.body ?? {};
+    if (typeof name !== 'string' || !name) {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+    if (parentId !== undefined && parentId !== null) {
+      if (typeof parentId !== 'string' || !store.folders.has(parentId)) {
+        res.status(404).json({ error: 'parent folder not found' });
+        return;
+      }
+      if (store.folderLevel(req.userId as string, parentId) < ROLE_LEVELS.editor) {
+        res.status(403).json({ error: 'cannot create folder in parent without editor access' });
+        return;
+      }
+    }
+    const id = store.nextId('folder');
+    const folder = {
+      id,
+      name,
+      parentId: parentId ?? null,
+      ownerId: req.userId as string,
+      createdAt: new Date().toISOString(),
+    };
+    store.folders.set(id, folder);
+    store.log('folder.create', req.userId as string, 'folder', id);
+    res.status(201).json(folder);
+  });
+
+  app.get('/folders', (req: AuthedRequest, res: Response): void => {
+    const result = [...store.folders.values()].filter(
+      (f) => store.folderLevel(req.userId as string, f.id) > 0,
+    );
+    res.status(200).json(result);
+  });
+
+  app.get('/folders/:id', (req: AuthedRequest, res: Response): void => {
+    const { id } = req.params;
+    if (!requireLevel(req, res, 'folder', id, ROLE_LEVELS.viewer)) return;
+    res.status(200).json(store.folders.get(id));
+  });
+
+  app.put('/folders/:id', (req: AuthedRequest, res: Response): void => {
+    const { id } = req.params;
+    if (!requireLevel(req, res, 'folder', id, ROLE_LEVELS.editor)) return;
+    const folder = store.folders.get(id)!;
+    const { name, parentId } = req.body ?? {};
+
+    if (name !== undefined) {
+      if (typeof name !== 'string' || !name) {
+        res.status(400).json({ error: 'name must be a non-empty string' });
+        return;
+      }
+      folder.name = name;
+    }
+    if (parentId !== undefined) {
+      if (parentId !== null) {
+        if (typeof parentId !== 'string' || !store.folders.has(parentId)) {
+          res.status(404).json({ error: 'parent folder not found' });
+          return;
+        }
+        if (parentId === id || isDescendant(store, parentId, id)) {
+          res.status(400).json({ error: 'cannot move folder into itself or a descendant' });
+          return;
+        }
+        if (store.folderLevel(req.userId as string, parentId) < ROLE_LEVELS.editor) {
+          res.status(403).json({ error: 'no editor access to target parent' });
+          return;
+        }
+      }
+      folder.parentId = parentId;
+    }
+    store.log('folder.update', req.userId as string, 'folder', id);
+    res.status(200).json(folder);
+  });
+
+  app.delete('/folders/:id', (req: AuthedRequest, res: Response): void => {
+    const { id } = req.params;
+    if (!requireLevel(req, res, 'folder', id, ROLE_LEVELS.owner)) return;
+    deleteFolderCascade(store, id, req.userId as string);
+    res.status(204).end();
+  });
+
+  // --- Document routes -------------------------------------------------------
+  app.post('/documents', (req: AuthedRequest, res: Response): void => {
+    const { title, content, folderId } = req.body ?? {};
+    if (typeof title !== 'string' || !title) {
+      res.status(400).json({ error: 'title is required' });
+      return;
+    }
+    if (typeof folderId !== 'string' || !folderId) {
+      res.status(400).json({ error: 'folderId is required' });
+      return;
+    }
+    if (!store.folders.has(folderId)) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (store.folderLevel(req.userId as string, folderId) < ROLE_LEVELS.editor) {
+      res.status(403).json({ error: 'editor access to folder required to create documents' });
+      return;
+    }
+    const id = store.nextId('doc');
+    const doc = {
+      id,
+      title,
+      content: typeof content === 'string' ? content : '',
+      folderId,
+      ownerId: req.userId as string,
+      createdAt: new Date().toISOString(),
+    };
+    store.documents.set(id, doc);
+    store.log('document.create', req.userId as string, 'document', id);
+    res.status(201).json(doc);
+  });
+
+  app.get('/documents', (req: AuthedRequest, res: Response): void => {
+    const result = [...store.documents.values()].filter(
+      (d) => store.documentLevel(req.userId as string, d.id) > 0,
+    );
+    res.status(200).json(result);
+  });
+
+  app.get('/documents/:id', (req: AuthedRequest, res: Response): void => {
+    const { id } = req.params;
+    if (!requireLevel(req, res, 'document', id, ROLE_LEVELS.viewer)) return;
+    res.status(200).json(store.documents.get(id));
+  });
+
+  app.put('/documents/:id', (req: AuthedRequest, res: Response): void => {
+    const { id } = req.params;
+    if (!requireLevel(req, res, 'document', id, ROLE_LEVELS.editor)) return;
+    const doc = store.documents.get(id)!;
+    const { title, content } = req.body ?? {};
+    if (title !== undefined) {
+      if (typeof title !== 'string' || !title) {
+        res.status(400).json({ error: 'title must be a non-empty string' });
+        return;
+      }
+      doc.title = title;
+    }
+    if (content !== undefined) {
+      if (typeof content !== 'string') {
+        res.status(400).json({ error: 'content must be a string' });
+        return;
+      }
+      doc.content = content;
+    }
+    store.log('document.update', req.userId as string, 'document', id);
+    res.status(200).json(doc);
+  });
+
+  app.delete('/documents/:id', (req: AuthedRequest, res: Response): void => {
+    const { id } = req.params;
+    if (!requireLevel(req, res, 'document', id, ROLE_LEVELS.owner)) return;
+    store.documents.delete(id);
+    store.shares = store.shares.filter(
+      (s) => !(s.resourceType === 'document' && s.resourceId === id),
+    );
+    store.log('document.delete', req.userId as string, 'document', id);
+    res.status(204).end();
+  });
+
+  // --- Sharing ---------------------------------------------------------------
+  const shareHandler = (type: ResourceType) => (req: AuthedRequest, res: Response): void => {
+    const { id } = req.params;
+    const { username, role } = req.body ?? {};
+
+    const exists = type === 'folder' ? store.folders.has(id) : store.documents.has(id);
+    if (!exists) {
+      res.status(404).json({ error: `${type} not found` });
+      return;
+    }
+    if (!isRole(role)) {
+      res.status(400).json({ error: 'role must be one of viewer, editor, owner' });
+      return;
+    }
+    if (typeof username !== 'string' || !username) {
+      res.status(400).json({ error: 'username is required' });
+      return;
+    }
+
+    const actorLevel = store.level(req.userId as string, type, id);
+    if (actorLevel < ROLE_LEVELS.editor) {
+      res.status(403).json({ error: 'editor access required to share' });
+      return;
+    }
+
+    const targetUserId = store.usersByUsername.get(username);
+    if (!targetUserId) {
+      res.status(404).json({ error: 'user not found' });
+      return;
+    }
+
+    const existing = store.directShare(type, id, targetUserId);
+
+    // Granting the owner role, or changing an existing grant, requires owner.
+    if (role === 'owner' && actorLevel < ROLE_LEVELS.owner) {
+      res.status(403).json({ error: 'only an owner can grant the owner role' });
+      return;
+    }
+    if (existing && actorLevel < ROLE_LEVELS.owner) {
+      res.status(403).json({ error: 'only an owner can change an existing role' });
+      return;
+    }
+
+    const status = existing ? 200 : 201;
+    if (existing) {
+      existing.role = role as Role;
+    } else {
+      store.shares.push({ resourceType: type, resourceId: id, userId: targetUserId, role: role as Role });
+    }
+    store.log('share', req.userId as string, type, id);
+    res.status(status).json({ resourceType: type, resourceId: id, userId: targetUserId, role });
+  };
+
+  app.post('/folders/:id/share', shareHandler('folder'));
+  app.post('/documents/:id/share', shareHandler('document'));
+
+  const sharesListHandler = (type: ResourceType) => (req: AuthedRequest, res: Response): void => {
+    const { id } = req.params;
+    if (!requireLevel(req, res, type, id, ROLE_LEVELS.editor)) return;
+    const list = store.shares.filter((s) => s.resourceType === type && s.resourceId === id);
+    res.status(200).json(list);
+  };
+
+  app.get('/folders/:id/shares', sharesListHandler('folder'));
+  app.get('/documents/:id/shares', sharesListHandler('document'));
+
+  // --- Activity log ----------------------------------------------------------
+  app.get('/activity', (req: AuthedRequest, res: Response): void => {
+    res.status(200).json(store.activity);
+  });
+
+  return app;
+}
+
+// --- Module-level helpers ----------------------------------------------------
+
+/** True if `candidate` folder is a descendant of `ancestor`. */
+function isDescendant(store: Store, candidate: string, ancestor: string): boolean {
+  let current = store.folders.get(candidate);
+  const seen = new Set<string>();
+  while (current && current.parentId) {
+    if (seen.has(current.id)) return false;
+    seen.add(current.id);
+    if (current.parentId === ancestor) return true;
+    current = store.folders.get(current.parentId);
+  }
+  return false;
+}
+
+/** Recursively delete a folder, its descendant folders, and all contained documents. */
+function deleteFolderCascade(store: Store, folderId: string, actorId: string): void {
+  for (const doc of [...store.documents.values()]) {
+    if (doc.folderId === folderId) {
+      store.documents.delete(doc.id);
+      store.shares = store.shares.filter(
+        (s) => !(s.resourceType === 'document' && s.resourceId === doc.id),
+      );
+      store.log('document.delete', actorId, 'document', doc.id);
+    }
+  }
+  for (const child of [...store.folders.values()]) {
+    if (child.parentId === folderId) {
+      deleteFolderCascade(store, child.id, actorId);
+    }
+  }
+  store.folders.delete(folderId);
+  store.shares = store.shares.filter(
+    (s) => !(s.resourceType === 'folder' && s.resourceId === folderId),
+  );
+  store.log('folder.delete', actorId, 'folder', folderId);
+}
