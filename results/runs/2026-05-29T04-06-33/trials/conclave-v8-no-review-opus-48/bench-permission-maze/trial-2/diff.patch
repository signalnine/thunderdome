+import { describe, it, expect, beforeEach } from 'vitest';
+import request from 'supertest';
+import type { Express } from 'express';
+import { createApp } from './app.js';
+
+let app: Express;
+
+async function register(username: string, password = 'pw'): Promise<void> {
+  await request(app).post('/auth/register').send({ username, password });
+}
+
+async function login(username: string, password = 'pw'): Promise<string> {
+  const res = await request(app).post('/auth/login').send({ username, password });
+  return res.body.token as string;
+}
+
+function auth(token: string) {
+  return { Authorization: `Bearer ${token}` };
+}
+
+beforeEach(() => {
+  app = createApp();
+});
+
+describe('user management', () => {
+  it('registers a user -> 201 with id+username', async () => {
+    const res = await request(app).post('/auth/register').send({ username: 'alice', password: 'pw' });
+    expect(res.status).toBe(201);
+    expect(res.body).toMatchObject({ username: 'alice' });
+    expect(res.body.id).toBeTruthy();
+    expect(res.body.password).toBeUndefined();
+  });
+
+  it('rejects duplicate username -> 409', async () => {
+    await register('alice');
+    const res = await request(app).post('/auth/register').send({ username: 'alice', password: 'pw' });
+    expect(res.status).toBe(409);
+  });
+
+  it('rejects missing fields on register -> 400', async () => {
+    const res = await request(app).post('/auth/register').send({ username: 'x' });
+    expect(res.status).toBe(400);
+  });
+
+  it('logs in with valid creds -> token', async () => {
+    await register('alice');
+    const res = await request(app).post('/auth/login').send({ username: 'alice', password: 'pw' });
+    expect(res.status).toBe(200);
+    expect(typeof res.body.token).toBe('string');
+  });
+
+  it('rejects wrong password -> 401', async () => {
+    await register('alice');
+    const res = await request(app).post('/auth/login').send({ username: 'alice', password: 'nope' });
+    expect(res.status).toBe(401);
+  });
+
+  it('rejects unknown user -> 401', async () => {
+    const res = await request(app).post('/auth/login').send({ username: 'ghost', password: 'pw' });
+    expect(res.status).toBe(401);
+  });
+
+  it('rejects missing login fields -> 400', async () => {
+    const res = await request(app).post('/auth/login').send({ username: 'alice' });
+    expect(res.status).toBe(400);
+  });
+});
+
+describe('auth middleware', () => {
+  it('rejects no token -> 401', async () => {
+    const res = await request(app).get('/folders');
+    expect(res.status).toBe(401);
+  });
+
+  it('rejects malformed header -> 401', async () => {
+    const res = await request(app).get('/folders').set({ Authorization: 'Token abc' });
+    expect(res.status).toBe(401);
+  });
+
+  it('rejects invalid token -> 401', async () => {
+    const res = await request(app).get('/folders').set(auth('bogus'));
+    expect(res.status).toBe(401);
+  });
+});
+
+describe('folders', () => {
+  let token: string;
+  beforeEach(async () => {
+    await register('alice');
+    token = await login('alice');
+  });
+
+  it('creates a folder, creator is owner -> 201', async () => {
+    const res = await request(app).post('/folders').set(auth(token)).send({ name: 'Docs' });
+    expect(res.status).toBe(201);
+    expect(res.body).toMatchObject({ name: 'Docs', parentId: null });
+  });
+
+  it('rejects missing name -> 400', async () => {
+    const res = await request(app).post('/folders').set(auth(token)).send({});
+    expect(res.status).toBe(400);
+  });
+
+  it('rejects non-existent parent -> 404', async () => {
+    const res = await request(app).post('/folders').set(auth(token)).send({ name: 'x', parentId: 'nope' });
+    expect(res.status).toBe(404);
+  });
+
+  it('nests folders', async () => {
+    const parent = await request(app).post('/folders').set(auth(token)).send({ name: 'p' });
+    const child = await request(app)
+      .post('/folders')
+      .set(auth(token))
+      .send({ name: 'c', parentId: parent.body.id });
+    expect(child.status).toBe(201);
+    expect(child.body.parentId).toBe(parent.body.id);
+  });
+
+  it('gets folder as owner -> 200; 404 for missing', async () => {
+    const f = await request(app).post('/folders').set(auth(token)).send({ name: 'p' });
+    const ok = await request(app).get(`/folders/${f.body.id}`).set(auth(token));
+    expect(ok.status).toBe(200);
+    const missing = await request(app).get('/folders/nope').set(auth(token));
+    expect(missing.status).toBe(404);
+  });
+
+  it('denies access to a stranger -> 403', async () => {
+    const f = await request(app).post('/folders').set(auth(token)).send({ name: 'p' });
+    await register('bob');
+    const bob = await login('bob');
+    const res = await request(app).get(`/folders/${f.body.id}`).set(auth(bob));
+    expect(res.status).toBe(403);
+  });
+
+  it('updates folder name as owner', async () => {
+    const f = await request(app).post('/folders').set(auth(token)).send({ name: 'p' });
+    const res = await request(app).put(`/folders/${f.body.id}`).set(auth(token)).send({ name: 'renamed' });
+    expect(res.status).toBe(200);
+    expect(res.body.name).toBe('renamed');
+  });
+
+  it('prevents moving folder into its own descendant -> 400', async () => {
+    const a = await request(app).post('/folders').set(auth(token)).send({ name: 'a' });
+    const b = await request(app)
+      .post('/folders')
+      .set(auth(token))
+      .send({ name: 'b', parentId: a.body.id });
+    const res = await request(app)
+      .put(`/folders/${a.body.id}`)
+      .set(auth(token))
+      .send({ parentId: b.body.id });
+    expect(res.status).toBe(400);
+  });
+
+  it('deletes folder as owner -> 204 and cascades', async () => {
+    const f = await request(app).post('/folders').set(auth(token)).send({ name: 'p' });
+    const child = await request(app)
+      .post('/folders')
+      .set(auth(token))
+      .send({ name: 'c', parentId: f.body.id });
+    const doc = await request(app)
+      .post('/documents')
+      .set(auth(token))
+      .send({ title: 't', content: 'x', folderId: child.body.id });
+
+    const res = await request(app).delete(`/folders/${f.body.id}`).set(auth(token));
+    expect(res.status).toBe(204);
+    expect((await request(app).get(`/folders/${f.body.id}`).set(auth(token))).status).toBe(404);
+    expect((await request(app).get(`/folders/${child.body.id}`).set(auth(token))).status).toBe(404);
+    expect((await request(app).get(`/documents/${doc.body.id}`).set(auth(token))).status).toBe(404);
+  });
+
+  it('lists only accessible folders', async () => {
+    await request(app).post('/folders').set(auth(token)).send({ name: 'mine' });
+    await register('bob');
+    const bob = await login('bob');
+    await request(app).post('/folders').set(auth(bob)).send({ name: 'bobs' });
+    const res = await request(app).get('/folders').set(auth(token));
+    expect(res.body).toHaveLength(1);
+    expect(res.body[0].name).toBe('mine');
+  });
+});
+
+describe('documents', () => {
+  let token: string;
+  let folderId: string;
+  beforeEach(async () => {
+    await register('alice');
+    token = await login('alice');
+    const f = await request(app).post('/folders').set(auth(token)).send({ name: 'f' });
+    folderId = f.body.id;
+  });
+
+  it('creates document, creator is owner -> 201', async () => {
+    const res = await request(app)
+      .post('/documents')
+      .set(auth(token))
+      .send({ title: 'Doc', content: 'hi', folderId });
+    expect(res.status).toBe(201);
+    expect(res.body).toMatchObject({ title: 'Doc', content: 'hi', folderId });
+  });
+
+  it('rejects missing title or folderId -> 400', async () => {
+    expect((await request(app).post('/documents').set(auth(token)).send({ folderId })).status).toBe(400);
+    expect((await request(app).post('/documents').set(auth(token)).send({ title: 't' })).status).toBe(400);
+  });
+
+  it('rejects non-existent folder -> 404', async () => {
+    const res = await request(app)
+      .post('/documents')
+      .set(auth(token))
+      .send({ title: 't', folderId: 'nope' });
+    expect(res.status).toBe(404);
+  });
+
+  it('updates and deletes', async () => {
+    const d = await request(app)
+      .post('/documents')
+      .set(auth(token))
+      .send({ title: 't', content: 'c', folderId });
+    const upd = await request(app)
+      .put(`/documents/${d.body.id}`)
+      .set(auth(token))
+      .send({ content: 'new' });
+    expect(upd.status).toBe(200);
+    expect(upd.body.content).toBe('new');
+    const del = await request(app).delete(`/documents/${d.body.id}`).set(auth(token));
+    expect(del.status).toBe(204);
+  });
+});
+
+describe('sharing & permissions', () => {
+  let alice: string;
+  let bob: string;
+  let folderId: string;
+  let docId: string;
+
+  beforeEach(async () => {
+    await register('alice');
+    await register('bob');
+    alice = await login('alice');
+    bob = await login('bob');
+    const f = await request(app).post('/folders').set(auth(alice)).send({ name: 'f' });
+    folderId = f.body.id;
+    const d = await request(app)
+      .post('/documents')
+      .set(auth(alice))
+      .send({ title: 't', content: 'c', folderId });
+    docId = d.body.id;
+  });
+
+  it('shares a document as viewer -> bob can read but not edit', async () => {
+    const share = await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(alice))
+      .send({ username: 'bob', role: 'viewer' });
+    expect(share.status).toBe(201);
+
+    expect((await request(app).get(`/documents/${docId}`).set(auth(bob))).status).toBe(200);
+    const edit = await request(app)
+      .put(`/documents/${docId}`)
+      .set(auth(bob))
+      .send({ content: 'x' });
+    expect(edit.status).toBe(403);
+  });
+
+  it('viewer cannot share -> 403', async () => {
+    await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(alice))
+      .send({ username: 'bob', role: 'viewer' });
+    const res = await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(bob))
+      .send({ username: 'alice', role: 'viewer' });
+    expect(res.status).toBe(403);
+  });
+
+  it('editor can share and edit', async () => {
+    await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(alice))
+      .send({ username: 'bob', role: 'editor' });
+    const edit = await request(app)
+      .put(`/documents/${docId}`)
+      .set(auth(bob))
+      .send({ content: 'edited by bob' });
+    expect(edit.status).toBe(200);
+    // editor can grant viewer to a third user
+    await register('carol');
+    const share = await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(bob))
+      .send({ username: 'carol', role: 'viewer' });
+    expect(share.status).toBe(201);
+  });
+
+  it('only owner can grant owner role -> editor gets 403', async () => {
+    await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(alice))
+      .send({ username: 'bob', role: 'editor' });
+    await register('carol');
+    const res = await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(bob))
+      .send({ username: 'carol', role: 'owner' });
+    expect(res.status).toBe(403);
+  });
+
+  it('only owner can delete -> editor gets 403', async () => {
+    await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(alice))
+      .send({ username: 'bob', role: 'editor' });
+    const res = await request(app).delete(`/documents/${docId}`).set(auth(bob));
+    expect(res.status).toBe(403);
+  });
+
+  it('only owner can change an existing role -> editor gets 403', async () => {
+    await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(alice))
+      .send({ username: 'bob', role: 'editor' });
+    await register('carol');
+    await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(alice))
+      .send({ username: 'carol', role: 'viewer' });
+    // bob (editor) tries to change carol's existing role
+    const res = await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(bob))
+      .send({ username: 'carol', role: 'editor' });
+    expect(res.status).toBe(403);
+  });
+
+  it('rejects invalid role -> 400 and unknown user -> 404', async () => {
+    expect(
+      (
+        await request(app)
+          .post(`/documents/${docId}/share`)
+          .set(auth(alice))
+          .send({ username: 'bob', role: 'admin' })
+      ).status,
+    ).toBe(400);
+    expect(
+      (
+        await request(app)
+          .post(`/documents/${docId}/share`)
+          .set(auth(alice))
+          .send({ username: 'ghost', role: 'viewer' })
+      ).status,
+    ).toBe(404);
+  });
+
+  it('document inherits folder share permission', async () => {
+    await request(app)
+      .post(`/folders/${folderId}/share`)
+      .set(auth(alice))
+      .send({ username: 'bob', role: 'editor' });
+    // bob never shared directly on the doc but inherits editor from the folder
+    const edit = await request(app)
+      .put(`/documents/${docId}`)
+      .set(auth(bob))
+      .send({ content: 'via folder' });
+    expect(edit.status).toBe(200);
+  });
+
+  it('inherits permission from ancestor folders', async () => {
+    const sub = await request(app)
+      .post('/folders')
+      .set(auth(alice))
