+    expect(denied.status).toBe(403);
+  });
+});
+
+describe('activity log', () => {
+  it('records create, update, delete, and share events', async () => {
+    await register('alice');
+    await register('bob');
+    const alice = await login('alice');
+    const f = await request(app).post('/folders').set(auth(alice)).send({ name: 'f' });
+    const d = await request(app)
+      .post('/documents')
+      .set(auth(alice))
+      .send({ title: 't', folderId: f.body.id });
+    await request(app).put(`/documents/${d.body.id}`).set(auth(alice)).send({ content: 'x' });
+    await request(app)
+      .post(`/documents/${d.body.id}/share`)
+      .set(auth(alice))
+      .send({ username: 'bob', role: 'viewer' });
+    await request(app).delete(`/documents/${d.body.id}`).set(auth(alice));
+
+    const res = await request(app).get('/activity').set(auth(alice));
+    expect(res.status).toBe(200);
+    const actions = res.body.map((e: { action: string }) => e.action);
+    expect(actions).toContain('document.create');
+    expect(actions).toContain('document.update');
+    expect(actions).toContain('share');
+    expect(actions).toContain('document.delete');
+    for (const entry of res.body) {
+      expect(entry).toHaveProperty('userId');
+      expect(entry).toHaveProperty('targetType');
+      expect(entry).toHaveProperty('targetId');
+      expect(entry).toHaveProperty('timestamp');
+    }
+  });
+
+  it('requires auth -> 401', async () => {
+    const res = await request(app).get('/activity');
+    expect(res.status).toBe(401);
+  });
+});
