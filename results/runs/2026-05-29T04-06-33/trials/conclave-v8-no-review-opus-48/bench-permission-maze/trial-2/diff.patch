e,\n      targetId,\n      timestamp: new Date().toISOString(),\n    });\n  }\n\n  // --- Permission resolution -------------------------------------------------\n\n  /** Effective role level a user has on a folder, including inheritance from ancestors. */\n  folderLevel(userId: string, folderId: string, visited = new Set<string>()): number {\n    if (visited.has(folderId)) return 0;\n    visited.add(folderId);\n\n    const folder = this.folders.get(folderId);\n    if (!folder) return 0;\n\n    let level = 0;\n    if (folder.ownerId === userId) level = ROLE_LEVELS.owner;\n\n    for (const share of this.shares) {\n      if (share.resourceType === 'folder' && share.resourceId === folderId && share.userId === userId) {\n        level = Math.max(level, ROLE_LEVELS[share.role]);\n      }\n    }\n\n    if (folder.parentId) {\n      level = Math.max(level, this.folderLevel(userId, folder.parentId, visited));\n    }\n\n    return level;\n  }\n\n  /** Effective role level on a document: own role + direct shares + inherited folder role. */\n  documentLevel(userId: string, documentId: string): number {\n    const doc = this.documents.get(documentId);\n    if (!doc) return 0;\n\n    let level = 0;\n    if (doc.ownerId === userId) level = ROLE_LEVELS.owner;\n\n    for (const share of this.shares) {\n      if (share.resourceType === 'document' && share.resourceId === documentId && share.userId === userId) {\n        level = Math.max(level, ROLE_LEVELS[share.role]);\n      }\n    }\n\n    level = Math.max(level, this.folderLevel(userId, doc.folderId));\n    return level;\n  }\n\n  level(userId: string, type: ResourceType, id: string): number {\n    return type === 'folder' ? this.folderLevel(userId, id) : this.documentLevel(userId, id);\n  }\n\n  /** The role currently directly granted to a user on a resource, if any. */\n  directShare(type: ResourceType, id: string, userId: string): Share | undefined {\n    return this.shares.find(\n      (s) => s.resourceType === type && s.resourceId === id && s.userId === userId,\n    );\n  }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":263,"cache_creation_input_tokens":1514,"cache_read_input_tokens":23710,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1514},"output_tokens":9,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4524c392-3889-475d-86db-6ccb83e61e35","uuid":"4731a337-9e86-4691-9142-b00bcde09cbf","request_id":"req_011CbWJ2sg7J2SzYwvBr8CUA"}
