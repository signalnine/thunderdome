chema,\n  roleSchema,\n  validateCreateUser,\n  validateUserId,\n} from './validation.js';\n\n// Database\nexport {\n  createDatabase,\n  createTables,\n  insertUser,\n  findUserById,\n  findAllUsers,\n  type DatabaseConnection,\n} from './database.js';\n\n// Permissions\nexport {\n  hasPermission,\n  getAllPermissions,\n  canManageUsers,\n  canWrite,\n  canDelete,\n  requirePermission,\n} from './permissions.js';\n=== src/validation.ts ===\n/**\n * Schema validation using zod.\n * Uses z.pipe() for string-to-number coercion (requires zod >= 3.22).\n */\n\nimport { z } from 'zod';\nimport type { Role } from './types.js';\n\nexport const roleSchema = z.enum(['admin', 'user', 'viewer']);\n\nexport const createUserSchema = z.object({\n  name: z\n    .string()\n    .min(1, 'Name is required')\n    .max(100, 'Name must be 100 characters or less'),\n  email: z.string().email('Invalid email address'),\n  role: roleSchema,\n});\n\nexport const userIdSchema = z\n  .string()\n  .pipe(z.coerce.number().int().positive('User ID must be a positive integer'));\n\nexport const userFiltersSchema = z.object({\n  role: roleSchema.optional(),\n  search: z.string().optional(),\n  limit: z\n    .string()\n    .pipe(z.coerce.number().int().min(1).max(100))\n    .optional()\n    .default('20'),\n  offset: z\n    .string()\n    .pipe(z.coerce.number().int().min(0))\n    .optional()\n    .default('0'),\n});\n\nexport function validateCreateUser(data: unknown): {\n  success: boolean;\n  data?: { name: string; email: string; role: Role };\n  errors?: string[];\n} {\n  const result = createUserSchema.safeParse(data);\n  if (result.success) {\n    return { success: true, data: result.data };\n  }\n  return {\n    success: false,\n    errors: result.error.errors.map((e) => e.message),\n  };\n}\n\nexport function validateUserId(id: string): {\n  success: boolean;\n  data?: number;\n  errors?: string[];\n} {\n  const result = userIdSchema.safeParse(id);\n  if (result.success) {\n    return { success: true, data: result.data };\n  }\n  return {\n    success: false,\n    errors: result.error.errors.map((e) => e.message),\n  };\n}\n=== src/user.ts ===\n/**\n * User management: creation, validation, and retrieval.\n */\n\nimport type { User, CreateUserInput } from './types.js';\nimport { validateCreateUser } from './validation.js';\nimport { hasPermission } from './permissions.js';\nimport {\n  createDatabase,\n  createTables,\n  insertUser,\n  findUserById,\n  findAllUsers,\n  type DatabaseConnection,\n} from './database.js';\n\nlet defaultConn: DatabaseConnection | null = null;\n\nexport function getDefaultConnection(): DatabaseConnection {\n  if (!defaultConn) {\n    defaultConn = createDatabase(':memory:');\n    createTables(defaultConn);\n  }\n  return defaultConn;\n}\n\nexport function resetDefaultConnection(): void {\n  if (defaultConn) {\n    defaultConn.close();\n    defaultConn = null;\n  }\n}\n\nexport function registerUser(input: CreateUserInput): User {\n  const validation = validateCreateUser(input);\n  if (!validation.success) {\n    throw new Error(`Invalid user data: ${validation.errors?.join(', ')}`);\n  }\n\n  const conn = getDefaultConnection();\n  return insertUser(conn, input);\n}\n\nexport function validateUser(input: unknown): {\n  valid: boolean;\n  errors?: string[];\n} {\n  const result = validateCreateUser(input);\n  return {\n    valid: result.success,\n    errors: result.errors,\n  };\n}\n\nexport function getUserById(id: number): User | null {\n  const conn = getDefaultConnection();\n  return findUserById(conn, id);\n}\n\nexport function getAllUsers(): User[] {\n  const conn = getDefaultConnection();\n  return findAllUsers(conn);\n}\n\nexport function canUserPerformAction(\n  userRole: User['role'],\n  action: 'read' | 'write' | 'delete'\n): boolean {\n  return hasPermission(userRole, action);\n}\n=== tests/validation.test.ts ===\nimport { describe, it, expect } from 'vitest';\nimport {\n  validateCreateUser,\n  validateUserId,\n  userFiltersSchema,\n} from '../src/validation.js';\n\ndescribe('Validation', () => {\n  it('validates a correct user input', () => {\n    const result = validateCreateUser({\n      name: 'Alice',\n      email: 'alice@example.com',\n      role: 'admin',\n    });\n    expect(result.success).toBe(true);\n    expect(result.data).toEqual({\n      name: 'Alice',\n      email: 'alice@example.com',\n      role: 'admin',\n    });\n  });\n\n  it('rejects invalid email', () => {\n    const result = validateCreateUser({\n      name: 'Alice',\n      email: 'not-an-email',\n      role: 'admin',\n    });\n    expect(result.success).toBe(false);\n    expect(result.errors).toContain('Invalid email address');\n  });\n\n  it('uses z.pipe() to coerce string user ID to number', () => {\n    const result = validateUserId('42');\n    expect(result.success).toBe(true);\n    expect(result.data).toBe(42);\n  });\n\n  it('rejects non-numeric user ID via z.pipe()', () => {\n    const result = validateUserId('abc');\n    expect(result.success).toBe(false);\n  });\n\n  it('parses user filters with string-to-number coercion via z.pipe()', () => {\n    const result = userFiltersSchema.safeParse({\n      role: 'admin',\n      limit: '50',\n      offset: '10',\n    });\n    expect(result.success).toBe(true);\n    if (result.success) {\n      expect(result.data.limit).toBe(50);\n      expect(result.data.offset).toBe(10);\n    }\n  });\n});\n=== tests/permissions.test.ts ===\nimport { describe, it, expect } from 'vitest';\nimport {\n  hasPermission,\n  getAllPermissions,\n  canManageUsers,\n  canWrite,\n  canDelete,\n  requirePermission,\n} from '../src/permissions.js';\n\ndescribe('Permissions', () => {\n  it('admin has all permissions', () => {\n    expect(hasPermission('admin', 'read')).toBe(true);\n    expect(hasPermission('admin', 'write')).toBe(true);\n    expect(hasPermission('admin', 'delete')).toBe(true);\n    expect(hasPermission('admin', 'manage_users')).toBe(true);\n    expect(hasPermission('admin', 'view_reports')).toBe(true);\n  });\n\n  it('viewer can only read', () => {\n    expect(hasPermission('viewer', 'read')).toBe(true);\n    expect(hasPermission('viewer', 'write')).toBe(false);\n    expect(hasPermission('viewer', 'delete')).toBe(false);\n  });\n\n  it('returns all permissions for a role', () => {\n    const perms = getAllPermissions('user');\n    expect(perms).toContain('read');\n    expect(perms).toContain('write');\n    expect(perms).not.toContain('delete');\n  });\n\n  it('canManageUsers is true only for admin', () => {\n    expect(canManageUsers('admin')).toBe(true);\n    expect(canManageUsers('user')).toBe(false);\n    expect(canManageUsers('viewer')).toBe(false);\n  });\n\n  it('canWrite is true for admin and user', () => {\n    expect(canWrite('admin')).toBe(true);\n    expect(canWrite('user')).toBe(true);\n    expect(canWrite('viewer')).toBe(false);\n  });\n\n  it('canDelete is true only for admin', () => {\n    expect(canDelete('admin')).toBe(true);\n    expect(canDelete('user')).toBe(false);\n  });\n\n  it('requirePermission throws when permission is missing', () => {\n    expect(() => requirePermission('viewer', 'write')).toThrow(\n      \"Role 'viewer' does not have permission 'write'\"\n    );\n  });\n});\n=== tests/user.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport {\n  registerUser,\n  validateUser,\n  getUserById,\n  getAllUsers,\n  resetDefaultConnection,\n} from '../src/user.js';\n\ndescribe('User Management', () => {\n  beforeEach(() => {\n    resetDefaultConnection();\n  });\n\n  it('registers a new user with valid data', () => {\n    const user = registerUser({\n      name: 'Alice',\n      email: 'alice@example.com',\n      role: 'admin',\n    });\n    expect(user.id).toBe(1);\n    expect(user.name).toBe('Alice');\n    expect(user.email).toBe('alice@example.com');\n    expect(user.role).toBe('admin');\n  });\n\n  it('throws on invalid user data', () => {\n    expect(() =>\n      registerUser({ name: '', email: 'bad', role: 'admin' })\n    ).toThrow('Invalid user data');\n  });\n\n  it('retrieves a user by id', () => {\n    const created = registerUser({\n      name: 'Bob',\n      email: 'bob@example.com',\n      role: 'user',\n    });\n    const found = getUserById(created.id);\n    expect(found).not.toBeNull();\n    expect(found!.name).toBe('Bob');\n  });\n\n  it('returns null for nonexistent user', () => {\n    const found = getUserById(999);\n    expect(found).toBeNull();\n  });\n\n  it('lists all users', () => {\n    registerUser({ name: 'A', email: 'a@a.com', role: 'user' });\n    registerUser({ name: 'B', email: 'b@b.com', role: 'viewer' });\n    const all = getAllUsers();\n    expect(all).toHaveLength(2);\n  });\n\n  it('validates user input correctly', () => {\n    const valid = validateUser({\n      name: 'Test',\n      email: 'test@test.com',\n      role: 'user',\n    });\n    expect(valid.valid).toBe(true);\n\n    const invalid = validateUser({ name: '', email: 'not-an-email', role: 'hacker' });\n    expect(invalid.valid).toBe(false);\n    expect(invalid.errors).toBeDefined();\n  });\n});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
