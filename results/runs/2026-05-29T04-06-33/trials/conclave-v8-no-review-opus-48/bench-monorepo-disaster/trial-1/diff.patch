"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"Node16\",\n    \"moduleResolution\": \"Node16\",\n    \"outDir\": \"./dist\",\n    \"rootDir\": \"./src\",\n    \"strict\": true,\n    \"composite\": true,\n    \"declaration\": true,\n    \"declarationMap\": true,\n    \"sourceMap\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"forceConsistentCasingInFileNames\": true\n  },\n  \"include\": [\"src/**/*.ts\"],\n  \"exclude\": [\"node_modules\", \"dist\", \"tests\"],\n  \"references\": [\n    { \"path\": \"../core\" }\n  ]\n}\n=== packages/worker/src/jobs/sync.ts ===\n/**\n * Data sync job.\n * Syncs external user data into the local database.\n */\n\nimport {\n  createUser,\n  getUserById,\n  getAllUsers,\n  type CreateUserInput,\n} from '@monorepo/core';\n\ninterface ExternalUser {\n  name: string;\n  email: string;\n  role: 'admin' | 'user' | 'viewer';\n}\n\n// Simulated external data source\nfunction fetchExternalUsers(): ExternalUser[] {\n  return [\n    { name: 'External User 1', email: 'ext1@example.com', role: 'user' },\n    { name: 'External User 2', email: 'ext2@example.com', role: 'viewer' },\n  ];\n}\n\nexport async function syncJob(): Promise<void> {\n  const externalUsers = fetchExternalUsers();\n  const existingUsers = getAllUsers();\n  const existingEmails = new Set(existingUsers.map((u) => u.email));\n\n  let synced = 0;\n  let skipped = 0;\n\n  for (const extUser of externalUsers) {\n    if (existingEmails.has(extUser.email)) {\n      skipped++;\n      continue;\n    }\n\n    const input: CreateUserInput = {\n      name: extUser.name,\n      email: extUser.email,\n      role: extUser.role,\n    };\n\n    try {\n      const newUser = createUser(input);\n      if (newUser.id) {\n        synced++;\n      }\n    } catch (err) {\n      console.error(`Failed to sync user ${extUser.email}:`, err);\n    }\n  }\n\n  console.log(`Sync complete: ${synced} synced, ${skipped} skipped`);\n}\n\nexport async function syncSingleUser(userId: number): Promise<boolean> {\n  const user = getUserById(userId);\n  if (!user) {\n    console.error(`User ${userId} not found for sync`);\n    return false;\n  }\n\n  // In a real app, we'd sync to an external service here\n  console.log(`Synced user ${user.name} (${user.email})`);\n  return true;\n}\n=== packages/worker/src/jobs/cleanup.ts ===\n/**\n * Cleanup job.\n * Removes stale data and performs maintenance tasks.\n */\n\nimport { getAllUsers } from '@monorepo/core';\n\nexport interface CleanupResult {\n  staleRecords: number;\n  cleanedUp: number;\n  duration: number;\n}\n\nexport async function cleanupJob(): Promise<CleanupResult> {\n  const startTime = Date.now();\n\n  // Get all users to check for stale records\n  const users = getAllUsers();\n\n  let staleRecords = 0;\n  let cleanedUp = 0;\n\n  for (const user of users) {\n    const createdDate = new Date(user.createdAt);\n    const now = new Date();\n    const daysSinceCreation =\n      (now.getTime() - createdDate.getTime()) / (1000 * 60 * 60 * 24);\n\n    // Mark records older than 365 days as stale (simulation)\n    if (daysSinceCreation > 365) {\n      staleRecords++;\n      // In a real app, we'd archive or delete\n      cleanedUp++;\n    }\n  }\n\n  const duration = Date.now() - startTime;\n\n  console.log(\n    `Cleanup complete: ${staleRecords} stale, ${cleanedUp} cleaned in ${duration}ms`\n  );\n\n  return { staleRecords, cleanedUp, duration };\n}\n\nexport function getCleanupThresholdDays(): number {\n  return 365;\n}\n=== packages/worker/src/index.ts ===\n/**\n * Worker entry point.\n * Runs background jobs on a schedule.\n */\n\nimport { Scheduler } from './scheduler.js';\nimport { syncJob } from './jobs/sync.js';\nimport { cleanupJob } from './jobs/cleanup.js';\n\nexport function createWorker(): Scheduler {\n  const scheduler = new Scheduler();\n\n  // Register jobs\n  scheduler.register('sync', syncJob, 60_000); // Every 60 seconds\n  scheduler.register('cleanup', async () => { await cleanupJob(); }, 300_000); // Every 5 minutes\n\n  return scheduler;\n}\n\n// Start worker if run directly\nconst isMainModule = process.argv[1]?.includes('worker/dist/index.js');\nif (isMainModule) {\n  console.log('Starting worker...');\n  const worker = createWorker();\n  worker.start();\n\n  process.on('SIGINT', () => {\n    console.log('Shutting down worker...');\n    worker.stop();\n    process.exit(0);\n  });\n}\n=== packages/worker/src/scheduler.ts ===\n/**\n * Simple job scheduler for background tasks.\n */\n\nexport interface JobDefinition {\n  name: string;\n  handler: () => Promise<void> | void;\n  intervalMs: number;\n  timer?: ReturnType<typeof setInterval>;\n  lastRun?: Date;\n  runCount: number;\n  errors: string[];\n}\n\nexport class Scheduler {\n  private jobs: Map<string, JobDefinition> = new Map();\n  private running = false;\n\n  register(\n    name: string,\n    handler: () => Promise<void> | void,\n    intervalMs: number\n  ): void {\n    this.jobs.set(name, {\n      name,\n      handler,\n      intervalMs,\n      runCount: 0,\n      errors: [],\n    });\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n\n    for (const [, job] of this.jobs) {\n      job.timer = setInterval(async () => {\n        try {\n          await job.handler();\n          job.lastRun = new Date();\n          job.runCount++;\n        } catch (err) {\n          job.errors.push(\n            err instanceof Error ? err.message : String(err)\n          );\n        }\n      }, job.intervalMs);\n    }\n  }\n\n  stop(): void {\n    if (!this.running) return;\n    this.running = false;\n\n    for (const [, job] of this.jobs) {\n      if (job.timer) {\n        clearInterval(job.timer);\n        job.timer = undefined;\n      }\n    }\n  }\n\n  async runOnce(name: string): Promise<void> {\n    const job = this.jobs.get(name);\n    if (!job) {\n      throw new Error(`Job '${name}' not found`);\n    }\n\n    await job.handler();\n    job.lastRun = new Date();\n    job.runCount++;\n  }\n\n  getStatus(): Array<{\n    name: string;\n    lastRun: Date | undefined;\n    runCount: number;\n    errorCount: number;\n  }> {\n    return Array.from(this.jobs.values()).map((job) => ({\n      name: job.name,\n      lastRun: job.lastRun,\n      runCount: job.runCount,\n      errorCount: job.errors.length,\n    }));\n  }\n\n  isRunning(): boolean {\n    return this.running;\n  }\n}\n=== packages/worker/tests/scheduler.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { Scheduler } from '../src/scheduler.js';\n\ndescribe('Scheduler', () => {\n  let scheduler: Scheduler;\n\n  beforeEach(() => {\n    scheduler = new Scheduler();\n  });\n\n  it('registers a job', () => {\n    scheduler.register('test', () => {}, 1000);\n    const status = scheduler.getStatus();\n    expect(status).toHaveLength(1);\n    expect(status[0].name).toBe('test');\n  });\n\n  it('runs a job once', async () => {\n    let ran = false;\n    scheduler.register('test', () => { ran = true; }, 1000);\n    await scheduler.runOnce('test');\n    expect(ran).toBe(true);\n  });\n\n  it('tracks run count', async () => {\n    scheduler.register('test', () => {}, 1000);\n    await scheduler.runOnce('test');\n    await scheduler.runOnce('test');\n    const status = scheduler.getStatus();\n    expect(status[0].runCount).toBe(2);\n  });\n\n  it('throws for unknown job', async () => {\n    await expect(scheduler.runOnce('nonexistent')).rejects.toThrow(\n      \"Job 'nonexistent' not found\"\n    );\n  });\n\n  it('starts and stops', () => {\n    scheduler.register('test', () => {}, 60000);\n    scheduler.start();\n    expect(scheduler.isRunning()).toBe(true);\n    scheduler.stop();\n    expect(scheduler.isRunning()).toBe(false);\n  });\n});\n=== packages/worker/tests/sync.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { syncJob, syncSingleUser } from '../src/jobs/sync.js';\nimport {\n  registerUser,\n  getAllUsers,\n  resetDefaultConnection,\n} from '@monorepo/core';\n\ndescribe('Sync Job', () => {\n  beforeEach(() => {\n    resetDefaultConnection();\n  });\n\n  it('syncs external users into the database', async () => {\n    await syncJob();\n    const users = getAllUsers();\n    expect(users.length).toBeGreaterThan(0);\n  });\n\n  it('skips already existing users on re-run', async () => {\n    await syncJob();\n    const countAfterFirst = getAllUsers().length;\n    await syncJob();\n    const countAfterSecond = getAllUsers().length;\n    expect(countAfterSecond).toBe(countAfterFirst);\n  });\n\n  it('syncs a single user by id', async () => {\n    const user = registerUser({\n      name: 'Sync Test',\n      email: 'sync@test.com',\n      role: 'user',\n    });\n    const result = await syncSingleUser(user.id);\n    expect(result).toBe(true);\n  });\n\n  it('returns false for nonexistent user sync', async () => {\n    const result = await syncSingleUser(999);\n    expect(result).toBe(false);\n  });\n});\n=== packages/worker/tests/cleanup.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { cleanupJob, getCleanupThresholdDays } from '../src/jobs/cleanup.js';\nimport { resetDefaultConnection } from '@monorepo/core';\n\ndescribe('Cleanup Job', () => {\n  beforeEach(() => {\n    resetDefaultConnection();\n  });\n\n  it('runs cleanup without errors', async () => {\n    const result = await cleanupJob();\n    expect(result).toBeDefined();\n    expect(result.duration).toBeGreaterThanOrEqual(0);\n  });\n\n  it('returns correct cleanup threshold', () => {\n    expect(getCleanupThresholdDays()).toBe(365);\n  });\n});","is_error":false}]},"parent_tool_use_id":null,"session_id":"476d2da0-98cd-448b-a410-4e5990e4cba4","uuid":"ef146d26-0903-4259-8368-1fd542a32a1c","timestamp":"2026-05-29T04:36:23.873Z","tool_use_result":{"stdout":"########## api ##########\n{\n  \"name\": \"@monorepo/api\",\n  \"version\": \"1.0.0\",\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"start\": \"node dist/index.js\"\n  },\n  \"dependencies\": {\n    \"@monorepo/core\": \"*\",\n    \"express\": \"^4.21.0\"\n  },\n  \"devDependencies\": {\n    \"@types/express\": \"^4.17.0\",\n    \"supertest\": \"^7.0.0\",\n    \"@types/supertest\": \"^6.0.0\",\n    \"typescript\": \"^5.4.0\"\n  }\n}\n=== tsconfig ===\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"Node16\",\n    \"moduleResolution\": \"Node16\",\n    \"outDir\": \"./dist\",\n    \"rootDir\": \"./src\",\n    \"strict\": true,\n    \"composite\": true,\n    \"declaration\": true,\n    \"declarationMap\": true,\n    \"sourceMap\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"forceConsistentCasingInFileNames\": true\n  },\n  \"include\": [\"src/**/*.ts\"],\n  \"exclude\": [\"node_modules\", \"dist\", \"tests\"],\n  \"references\": [\n    { \"path\": \"../core\" }\n  ]\n}\n=== packages/api/src/middleware/auth.ts ===\n/**\n * Authentication middleware using core permissions.\n */\n\nimport type { Request, Response, NextFunction } from 'express';\nimport { hasPermission, type Role, type Permission } from '@monorepo/core';\n\n/**\n * Basic auth middleware that checks for a token header.\n * In this benchmark, we use a simplified mock auth system.\n */\nexport function authMiddleware(\n  req: Request,\n  res: Response,\n  next: NextFunction\n): void {\n  const token = req.headers['authorization']?.replace('Bearer ', '');\n\n  // Allow requests with valid mock tokens or role headers\n  if (token?.startsWith('mock-token-') || req.headers['x-user-role']) {\n    next();\n    return;\n  }\n\n  res.status(401).json({ error: 'Authentication required' });\n}\n\n/**\n * Middleware factory to require a specific permission.\n */\nexport function requirePermissionMiddleware(permission: Permission) {\n  return (req: Request, res: Response, next: NextFunction): void => {\n    const role = (req.headers['x-user-role'] as Role) || 'viewer';\n\n    if (!hasPermission(role, permission)) {\n      res.status(403).json({\n        error: `Permission '${permission}' required`,\n      });\n      return;\n    }\n\n    next();\n  };\n}\n=== packages/api/src/index.ts ===\n/**\n * Express API application setup.\n */\n\nimport express from 'express';\nimport { usersRouter } from './routes/users.js';\nimport { authRouter } from './routes/auth.js';\nimport { authMiddleware } from './middleware/auth.js';\n\nexport function createApp() {\n  const app = express();\n\n  app.use(express.json());\n\n  // Health check\n  app.get('/health', (_req, res) => {\n    res.json({ status: 'ok' });\n  });\n\n  // Public routes\n  app.use('/auth', authRouter);\n\n  // Protected routes\n  app.use('/users', authMiddleware, usersRouter);\n\n  // Error handler\n  app.use(\n    (\n      err: Error,\n      _req: express.Request,\n      res: express.Response,\n      _next: express.NextFunction\n    ) => {\n      console.error(err.message);\n      res.status(500).json({ error: 'Internal server error' });\n    }\n  );\n\n  return app;\n}\n\n// Start server if run directly\nconst isMainModule = process.argv[1]?.includes('api/dist/index.js');\nif (isMainModule) {\n  const port = process.env['PORT'] || 3000;\n  const app = createApp();\n  app.listen(port, () => {\n    console.log(`API server running on port ${port}`);\n  });\n}\n=== packages/api/src/routes/auth.ts ===\n/**\n * Authentication routes.\n */\n\nimport { Router, type Request, type Response } from 'express';\nimport { validateCreateUser, registerUser, type Role } from '@monorepo/core';\n\nexport const authRouter = Router();\n\n// Simple registration (public)\nauthRouter.post('/register', (req: Request, res: Response) => {\n  try {\n    const validation = validateCreateUser({\n      ...req.body,\n      role: 'user', // Force 'user' role for self-registration\n    });\n\n    if (!validation.success) {\n      res.status(400).json({ errors: validation.errors });\n      return;\n    }\n\n    const user = registerUser({\n      name: req.body.name,\n      email: req.body.email,\n      role: 'user' as Role,\n    });\n\n    res.status(201).json({\n      user,\n      token: `mock-token-${user.id}`, // Simplified for benchmark\n    });\n  } catch (err) {\n    if (err instanceof Error && err.message.includes('UNIQUE')) {\n      res.status(409).json({ error: 'Email already registered' });\n      return;\n    }\n    res.status(500).json({ error: 'Registration failed' });\n  }\n});\n\n// Simple login (mock)\nauthRouter.post('/login', (req: Request, res: Response) => {\n  try {\n    const { email } = req.body as { email?: string };\n    if (!email) {\n      res.status(400).json({ error: 'Email is required' });\n      return;\n    }\n\n    // In a real app, we'd verify credentials\n    res.json({\n      token: `mock-token-for-${email}`,\n      message: 'Login successful',\n    });\n  } catch (err) {\n    res.status(500).json({ error: 'Login failed' });\n  }\n});\n\n// Token validation (mock)\nauthRouter.get('/verify', (req: Request, res: Response) => {\n  const token = req.headers['authorization']?.replace('Bearer ', '');\n  if (!token) {\n    res.status(401).json({ error: 'No token provided' });\n    return;\n  }\n\n  // Simplified: any token with correct format is valid\n  if (token.startsWith('mock-token-')) {\n    res.json({ valid: true, token });\n  } else {\n    res.status(401).json({ valid: false, error: 'Invalid token' });\n  }\n});\n=== packages/api/src/routes/users.ts ===\n/**\n * User CRUD routes.\n */\n\nimport { Router, type Request, type Response } from 'express';\nimport {\n  createUser,\n  getUserById,\n  getAllUsers,\n  validateCreateUser,\n  validateUserId,\n  canManageUsers,\n  type Role,\n} from '@monorepo/core';\n\nexport const usersRouter = Router();\n\n// List all users\nusersRouter.get('/', (_req: Request, res: Response) => {\n  try {\n    const users = getAllUsers();\n    res.json({ users });\n  } catch (err) {\n    res.status(500).json({ error: 'Failed to fetch users' });\n  }\n});\n\n// Get user by ID\nusersRouter.get('/:id', (req: Request, res: Response) => {\n  try {\n    const validation = validateUserId(req.params['id']!);\n    if (!validation.success) {\n      res.status(400).json({ errors: validation.errors });\n      return;\n    }\n\n    const user = getUserById(validation.data!);\n    if (!user) {\n      res.status(404).json({ error: 'User not found' });\n      return;\n    }\n    res.json({ user });\n  } catch (err) {\n    res.status(500).json({ error: 'Failed to fetch user' });\n  }\n});\n\n// Create a new user\nusersRouter.post('/', (req: Request, res: Response) => {\n  try {\n    const callerRole = (req.headers['x-user-role'] as Role) || 'viewer';\n    if (!canManageUsers(callerRole)) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    const validation = validateCreateUser(req.body);\n    if (!validation.success) {\n      res.status(400).json({ errors: validation.errors });\n      return;\n    }\n\n    const user = createUser(req.body);\n    res.status(201).json({ user });\n  } catch (err) {\n    if (err instanceof Error && err.message.includes('UNIQUE')) {\n      res.status(409).json({ error: 'Email already exists' });\n      return;\n    }\n    res.status(500).json({ error: 'Failed to create user' });\n  }\n});\n\n// Delete user by ID\nusersRouter.delete('/:id', (req: Request, res: Response) => {\n  try {\n    const callerRole = (req.headers['x-user-role'] as Role) || 'viewer';\n    if (!canManageUsers(callerRole)) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    const validation = validateUserId(req.params['id']!);\n    if (!validation.success) {\n      res.status(400).json({ errors: validation.errors });\n      return;\n    }\n\n    const user = getUserById(validation.data!);\n    if (!user) {\n      res.status(404).json({ error: 'User not found' });\n      return;\n    }\n\n    // In a real app, we'd delete here\n    res.status(200).json({ message: 'User deleted', user });\n  } catch (err) {\n    res.status(500).json({ error: 'Failed to delete user' });\n  }\n});\n=== packages/api/tests/auth.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport request from 'supertest';\nimport { createApp } from '../src/index.js';\nimport { resetDefaultConnection } from '@monorepo/core';\n\ndescribe('Auth Routes', () => {\n  let app: ReturnType<typeof createApp>;\n\n  beforeEach(() => {\n    resetDefaultConnection();\n    app = createApp();\n  });\n\n  it('registers a new user', async () => {\n    const res = await request(app)\n      .post('/auth/register')\n      .send({ name: 'New User', email: 'new@test.com' });\n    expect(res.status).toBe(201);\n    expect(res.body.token).toBeDefined();\n    expect(res.body.user.role).toBe('user');\n  });\n\n  it('rejects registration with invalid data', async () => {\n    const res = await request(app)\n      .post('/auth/register')\n      .send({ name: '', email: 'bad' });\n    expect(res.status).toBe(400);\n  });\n\n  it('handles login', async () => {\n    const res = await request(app)\n      .post('/auth/login')\n      .send({ email: 'user@test.com' });\n    expect(res.status).toBe(200);\n    expect(res.body.token).toBeDefined();\n  });\n\n  it('rejects login without email', async () => {\n    const res = await request(app)\n      .post('/auth/login')\n      .send({});\n    expect(res.status).toBe(400);\n  });\n\n  it('verifies valid token', async () => {\n    const res = await request(app)\n      .get('/auth/verify')\n      .set('Authorization', 'Bearer mock-token-1');\n    expect(res.status).toBe(200);\n    expect(res.body.valid).toBe(true);\n  });\n\n  it('rejects invalid token', async () => {\n    const res = await request(app)\n      .get('/auth/verify')\n      .set('Authorization', 'Bearer bad-token');\n    expect(res.status).toBe(401);\n  });\n\n  it('rejects request without token', async () => {\n    const res = await request(app).get('/auth/verify');\n    expect(res.status).toBe(401);\n  });\n});\n=== packages/api/tests/users.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport request from 'supertest';\nimport { createApp } from '../src/index.js';\nimport { resetDefaultConnection } from '@monorepo/core';\n\ndescribe('User Routes', () => {\n  let app: ReturnType<typeof createApp>;\n\n  beforeEach(() => {\n    resetDefaultConnection();\n    app = createApp();\n  });\n\n<<<<<<< HEAD\n  it('creates user with valid data', async () => {\n    const res = await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: 'Test', email: 'test@test.com' });\n    expect(res.status).toBe(201);\n=======\n  it('registers user with valid data', async () => {\n    const res = await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: 'Test', email: 'test@test.com', role: 'user' });\n    expect(res.status).toBe(201);\n>>>>>>> refactor/user-system\n    expect(res.body.user.name).toBe('Test');\n  });\n\n  it('rejects user creation without admin role', async () => {\n    const res = await request(app)\n      .post('/users')\n      .set('x-user-role', 'viewer')\n      .send({ name: 'Test', email: 'test@test.com', role: 'user' });\n    expect(res.status).toBe(403);\n  });\n\n  it('returns 400 for invalid user data', async () => {\n    const res = await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: '', email: 'not-email', role: 'user' });\n    expect(res.status).toBe(400);\n  });\n\n  it('lists all users', async () => {\n    // Create a user first\n    await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: 'Alice', email: 'alice@test.com', role: 'user' });\n\n    const res = await request(app)\n      .get('/users')\n      .set('x-user-role', 'admin');\n    expect(res.status).toBe(200);\n    expect(res.body.users).toHaveLength(1);\n  });\n\n  it('gets user by id', async () => {\n    const createRes = await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: 'Bob', email: 'bob@test.com', role: 'user' });\n\n    const res = await request(app)\n      .get(`/users/${createRes.body.user.id}`)\n      .set('x-user-role', 'admin');\n    expect(res.status).toBe(200);\n    expect(res.body.user.name).toBe('Bob');\n  });\n\n  it('returns 404 for nonexistent user', async () => {\n    const res = await request(app)\n      .get('/users/999')\n      .set('x-user-role', 'admin');\n    expect(res.status).toBe(404);\n  });\n\n  it('returns 400 for invalid user id', async () => {\n    const res = await request(app)\n      .get('/users/abc')\n      .set('x-user-role', 'admin');\n    expect(res.status).toBe(400);\n  });\n\n  it('returns 409 for duplicate email', async () => {\n    await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: 'First', email: 'dup@test.com', role: 'user' });\n\n    const res = await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: 'Second', email: 'dup@test.com', role: 'user' });\n    expect(res.status).toBe(409);\n  });\n});\n########## worker ##########\n{\n  \"name\": \"@monorepo/worker\",\n  \"version\": \"1.0.0\",\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"start\": \"node dist/index.js\"\n  },\n  \"dependencies\": {\n    \"@monorepo/core\": \"*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^5.4.0\"\n  }\n}\n=== tsconfig ===\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"Node16\",\n    \"moduleResolution\": \"Node16\",\n    \"outDir\": \"./dist\",\n    \"rootDir\": \"./src\",\n    \"strict\": true,\n    \"composite\": true,\n    \"declaration\": true,\n    \"declarationMap\": true,\n    \"sourceMap\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"forceConsistentCasingInFileNames\": true\n  },\n  \"include\": [\"src/**/*.ts\"],\n  \"exclude\": [\"node_modules\", \"dist\", \"tests\"],\n  \"references\": [\n    { \"path\": \"../core\" }\n  ]\n}\n=== packages/worker/src/jobs/sync.ts ===\n/**\n * Data sync job.\n * Syncs external user data into the local database.\n */\n\nimport {\n  createUser,\n  getUserById,\n  getAllUsers,\n  type CreateUserInput,\n} from '@monorepo/core';\n\ninterface ExternalUser {\n  name: string;\n  email: string;\n  role: 'admin' | 'user' | 'viewer';\n}\n\n// Simulated external data source\nfunction fetchExternalUsers(): ExternalUser[] {\n  return [\n    { name: 'External User 1', email: 'ext1@example.com', role: 'user' },\n    { name: 'External User 2', email: 'ext2@example.com', role: 'viewer' },\n  ];\n}\n\nexport async function syncJob(): Promise<void> {\n  const externalUsers = fetchExternalUsers();\n  const existingUsers = getAllUsers();\n  const existingEmails = new Set(existingUsers.map((u) => u.email));\n\n  let synced = 0;\n  let skipped = 0;\n\n  for (const extUser of externalUsers) {\n    if (existingEmails.has(extUser.email)) {\n      skipped++;\n      continue;\n    }\n\n    const input: CreateUserInput = {\n      name: extUser.name,\n      email: extUser.email,\n      role: extUser.role,\n    };\n\n    try {\n      const newUser = createUser(input);\n      if (newUser.id) {\n        synced++;\n      }\n    } catch (err) {\n      console.error(`Failed to sync user ${extUser.email}:`, err);\n    }\n  }\n\n  console.log(`Sync complete: ${synced} synced, ${skipped} skipped`);\n}\n\nexport async function syncSingleUser(userId: number): Promise<boolean> {\n  const user = getUserById(userId);\n  if (!user) {\n    console.error(`User ${userId} not found for sync`);\n    return false;\n  }\n\n  // In a real app, we'd sync to an external service here\n  console.log(`Synced user ${user.name} (${user.email})`);\n  return true;\n}\n=== packages/worker/src/jobs/cleanup.ts ===\n/**\n * Cleanup job.\n * Removes stale data and performs maintenance tasks.\n */\n\nimport { getAllUsers } from '@monorepo/core';\n\nexport interface CleanupResult {\n  staleRecords: number;\n  cleanedUp: number;\n  duration: number;\n}\n\nexport async function cleanupJob(): Promise<CleanupResult> {\n  const startTime = Date.now();\n\n  // Get all users to check for stale records\n  const users = getAllUsers();\n\n  let staleRecords = 0;\n  let cleanedUp = 0;\n\n  for (const user of users) {\n    const createdDate = new Date(user.createdAt);\n    const now = new Date();\n    const daysSinceCreation =\n      (now.getTime() - createdDate.getTime()) / (1000 * 60 * 60 * 24);\n\n    // Mark records older than 365 days as stale (simulation)\n    if (daysSinceCreation > 365) {\n      staleRecords++;\n      // In a real app, we'd archive or delete\n      cleanedUp++;\n    }\n  }\n\n  const duration = Date.now() - startTime;\n\n  console.log(\n    `Cleanup complete: ${staleRecords} stale, ${cleanedUp} cleaned in ${duration}ms`\n  );\n\n  return { staleRecords, cleanedUp, duration };\n}\n\nexport function getCleanupThresholdDays(): number {\n  return 365;\n}\n=== packages/worker/src/index.ts ===\n/**\n * Worker entry point.\n * Runs background jobs on a schedule.\n */\n\nimport { Scheduler } from './scheduler.js';\nimport { syncJob } from './jobs/sync.js';\nimport { cleanupJob } from './jobs/cleanup.js';\n\nexport function createWorker(): Scheduler {\n  const scheduler = new Scheduler();\n\n  // Register jobs\n  scheduler.register('sync', syncJob, 60_000); // Every 60 seconds\n  scheduler.register('cleanup', async () => { await cleanupJob(); }, 300_000); // Every 5 minutes\n\n  return scheduler;\n}\n\n// Start worker if run directly\nconst isMainModule = process.argv[1]?.includes('worker/dist/index.js');\nif (isMainModule) {\n  console.log('Starting worker...');\n  const worker = createWorker();\n  worker.start();\n\n  process.on('SIGINT', () => {\n    console.log('Shutting down worker...');\n    worker.stop();\n    process.exit(0);\n  });\n}\n=== packages/worker/src/scheduler.ts ===\n/**\n * Simple job scheduler for background tasks.\n */\n\nexport interface JobDefinition {\n  name: string;\n  handler: () => Promise<void> | void;\n  intervalMs: number;\n  timer?: ReturnType<typeof setInterval>;\n  lastRun?: Date;\n  runCount: number;\n  errors: string[];\n}\n\nexport class Scheduler {\n  private jobs: Map<string, JobDefinition> = new Map();\n  private running = false;\n\n  register(\n    name: string,\n    handler: () => Promise<void> | void,\n    intervalMs: number\n  ): void {\n    this.jobs.set(name, {\n      name,\n      handler,\n      intervalMs,\n      runCount: 0,\n      errors: [],\n    });\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n\n    for (const [, job] of this.jobs) {\n      job.timer = setInterval(async () => {\n        try {\n          await job.handler();\n          job.lastRun = new Date();\n          job.runCount++;\n        } catch (err) {\n          job.errors.push(\n            err instanceof Error ? err.message : String(err)\n          );\n        }\n      }, job.intervalMs);\n    }\n  }\n\n  stop(): void {\n    if (!this.running) return;\n    this.running = false;\n\n    for (const [, job] of this.jobs) {\n      if (job.timer) {\n        clearInterval(job.timer);\n        job.timer = undefined;\n      }\n    }\n  }\n\n  async runOnce(name: string): Promise<void> {\n    const job = this.jobs.get(name);\n    if (!job) {\n      throw new Error(`Job '${name}' not found`);\n    }\n\n    await job.handler();\n    job.lastRun = new Date();\n    job.runCount++;\n  }\n\n  getStatus(): Array<{\n    name: string;\n    lastRun: Date | undefined;\n    runCount: number;\n    errorCount: number;\n  }> {\n    return Array.from(this.jobs.values()).map((job) => ({\n      name: job.name,\n      lastRun: job.lastRun,\n      runCount: job.runCount,\n      errorCount: job.errors.length,\n    }));\n  }\n\n  isRunning(): boolean {\n    return this.running;\n  }\n}\n=== packages/worker/tests/scheduler.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { Scheduler } from '../src/scheduler.js';\n\ndescribe('Scheduler', () => {\n  let scheduler: Scheduler;\n\n  beforeEach(() => {\n    scheduler = new Scheduler();\n  });\n\n  it('registers a job', () => {\n    scheduler.register('test', () => {}, 1000);\n    const status = scheduler.getStatus();\n    expect(status).toHaveLength(1);\n    expect(status[0].name).toBe('test');\n  });\n\n  it('runs a job once', async () => {\n    let ran = false;\n    scheduler.register('test', () => { ran = true; }, 1000);\n    await scheduler.runOnce('test');\n    expect(ran).toBe(true);\n  });\n\n  it('tracks run count', async () => {\n    scheduler.register('test', () => {}, 1000);\n    await scheduler.runOnce('test');\n    await scheduler.runOnce('test');\n    const status = scheduler.getStatus();\n    expect(status[0].runCount).toBe(2);\n  });\n\n  it('throws for unknown job', async () => {\n    await expect(scheduler.runOnce('nonexistent')).rejects.toThrow(\n      \"Job 'nonexistent' not found\"\n    );\n  });\n\n  it('starts and stops', () => {\n    scheduler.register('test', () => {}, 60000);\n    scheduler.start();\n    expect(scheduler.isRunning()).toBe(true);\n    scheduler.stop();\n    expect(scheduler.isRunning()).toBe(false);\n  });\n});\n=== packages/worker/tests/sync.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { syncJob, syncSingleUser } from '../src/jobs/sync.js';\nimport {\n  registerUser,\n  getAllUsers,\n  resetDefaultConnection,\n} from '@monorepo/core';\n\ndescribe('Sync Job', () => {\n  beforeEach(() => {\n    resetDefaultConnection();\n  });\n\n  it('syncs external users into the database', async () => {\n    await syncJob();\n    const users = getAllUsers();\n    expect(users.length).toBeGreaterThan(0);\n  });\n\n  it('skips already existing users on re-run', async () => {\n    await syncJob();\n    const countAfterFirst = getAllUsers().length;\n    await syncJob();\n    const countAfterSecond = getAllUsers().length;\n    expect(countAfterSecond).toBe(countAfterFirst);\n  });\n\n  it('syncs a single user by id', async () => {\n    const user = registerUser({\n      name: 'Sync Test',\n      email: 'sync@test.com',\n      role: 'user',\n    });\n    const result = await syncSingleUser(user.id);\n    expect(result).toBe(true);\n  });\n\n  it('returns false for nonexistent user sync', async () => {\n    const result = await syncSingleUser(999);\n    expect(result).toBe(false);\n  });\n});\n=== packages/worker/tests/cleanup.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { cleanupJob, getCleanupThresholdDays } from '../src/jobs/cleanup.js';\nimport { resetDefaultConnection } from '@monorepo/core';\n\ndescribe('Cleanup Job', () => {\n  beforeEach(() => {\n    resetDefaultConnection();\n  });\n\n  it('runs cleanup without errors', async () => {\n    const result = await cleanupJob();\n    expect(result).toBeDefined();\n    expect(result.duration).toBeGreaterThanOrEqual(0);\n  });\n\n  it('returns correct cleanup threshold', () => {\n    expect(getCleanupThresholdDays()).toBe(365);\n  });\n});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
