+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from './index.js';
+
+// Helper: build grid from rows of space-separated or raw chars.
+function g(rows: string[]): string[][] {
+  return rows.map((r) => r.split(''));
+}
+
+const EXAMPLE_1 = g(['.S...', '.....', '.^...', '.....']);
+
+const EXAMPLE_2 = g(['.S...', '.^...', '^.^..', '.....']);
+
+describe('countBeamCells', () => {
+  it('example 1 → 5', () => {
+    expect(countBeamCells(EXAMPLE_1)).toBe(5);
+  });
+
+  it('example 2 → 6 (overlapping landing cell counted once)', () => {
+    expect(countBeamCells(EXAMPLE_2)).toBe(6);
+  });
+
+  it('source with no splitter visits one cell per row in that column', () => {
+    const grid = g(['.S.', '...', '...', '...', '...']);
+    expect(countBeamCells(grid)).toBe(5);
+  });
+
+  it('single column straight beam → rows count', () => {
+    const grid = g(['S', '.', '.', '.', '.']);
+    expect(countBeamCells(grid)).toBe(5);
+  });
+
+  it('no source → 0', () => {
+    expect(countBeamCells(g(['...', '...']))).toBe(0);
+  });
+
+  it('empty grid → 0', () => {
+    expect(countBeamCells([])).toBe(0);
+    expect(countBeamCells([[]])).toBe(0);
+  });
+
+  it('beam exiting the side does not count out-of-bounds cells', () => {
+    // S at col 0, splitter immediately; down-left exits, down-right stays.
+    const grid = g(['S.', '^.']);
+    // visited: (0,0), (1,0) splitter. children: (2,-1) oob, (2,1) oob. => 2 cells
+    expect(countBeamCells(grid)).toBe(2);
+  });
+
+  it('multiple sources union their cells', () => {
+    const grid = g(['S.S', '...', '...']);
+    // two straight columns 0 and 2, 3 rows each, disjoint => 6
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('convergent beams onto same cell counted once', () => {
+    // splitter sends DL and DR; arrange so two beams reach same cell
+    const grid = g(['.S.', '.^.', '...']);
+    // (0,1),(1,1) splitter, children (2,0),(2,2). 4 cells
+    expect(countBeamCells(grid)).toBe(4);
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('example 1 → 2n', () => {
+    expect(countBeamPaths(EXAMPLE_1)).toBe(2n);
+  });
+
+  it('example 2 → 4n (absorbed beams still count)', () => {
+    expect(countBeamPaths(EXAMPLE_2)).toBe(4n);
+  });
+
+  it('no splitter → 1n', () => {
+    expect(countBeamPaths(g(['S', '.', '.']))).toBe(1n);
+  });
+
+  it('no source → 0n', () => {
+    expect(countBeamPaths(g(['...', '...']))).toBe(0n);
+  });
+
+  it('empty grid → 0n', () => {
+    expect(countBeamPaths([])).toBe(0n);
+    expect(countBeamPaths([[]])).toBe(0n);
+  });
+
+  it('multiple sources sum their paths', () => {
+    const grid = g(['S.S', '...', '...']);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('single splitter → 2n', () => {
+    expect(countBeamPaths(g(['S', '^', '.'])).valueOf()).toBe(2n);
+  });
+
+  it('full triangle of K splitter rows → 2^K paths', () => {
+    // Rows 1..K are entirely splitters; every entering beam splits each row,
+    // doubling the beam count K times. Grid is wide enough that no beam exits
+    // a side before row K+1, so the path count is exactly 2^K.
+    const K = 10;
+    const cols = 2 * K + 3;
+    const rows = K + 2;
+    const sc = K + 1;
+    const grid: string[][] = Array.from({ length: rows }, (_v, r) =>
+      Array.from({ length: cols }, () => (r >= 1 && r <= K ? '^' : '.')),
+    );
+    grid[0][sc] = 'S';
+    expect(countBeamPaths(grid)).toBe(2n ** BigInt(K));
+  });
+});
+
+describe('performance', () => {
+  it('200x200 grid with 50 splitters resolves < 5s', () => {
+    const N = 200;
+    const grid: string[][] = Array.from({ length: N }, () =>
+      Array.from({ length: N }, () => '.'),
+    );
+    grid[0][N / 2] = 'S';
+    // Scatter 50 splitters deterministically across the grid.
+    for (let i = 0; i < 50; i++) {
+      const r = 1 + ((i * 37) % (N - 1));
+      const c = (i * 53 + 7) % N;
+      grid[r][c] = '^';
+    }
+    const start = Date.now();
+    const cells = countBeamCells(grid);
+    const paths = countBeamPaths(grid);
+    const elapsed = Date.now() - start;
+    expect(cells).toBeGreaterThan(0);
+    expect(paths).toBeGreaterThan(0n);
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
+
+describe('cells/paths consistency on examples', () => {
+  it('example 1 paths and cells', () => {
+    expect(countBeamCells(EXAMPLE_1)).toBe(5);
+    expect(countBeamPaths(EXAMPLE_1)).toBe(2n);
+  });
+});
