 dimensions(grid);\n  if (rows === 0 || cols === 0) return 0n;\n\n  const sources = findSources(grid);\n  if (sources.length === 0) return 0n;\n\n  const memo = new Map<number, bigint>();\n  const stateId = (r: number, c: number, d: number): number =>\n    (r * cols + c) * 3 + d;\n\n  // Iterative DP from the bottom row upward avoids deep recursion on tall grids.\n  for (let r = rows - 1; r >= 0; r--) {\n    const row = grid[r];\n    for (let c = 0; c < row.length; c++) {\n      for (let d = 0; d < 3; d++) {\n        // paths for a beam entering (r, c) heading direction d.\n        let nr: number;\n        let nc: number;\n        let count: bigint;\n        if (row[c] === SPLITTER) {\n          // down-left child\n          count = exitPaths(r + 1, c - 1, DOWN_LEFT, rows, grid, memo, stateId);\n          // down-right child\n          count += exitPaths(r + 1, c + 1, DOWN_RIGHT, rows, grid, memo, stateId);\n        } else {\n          nr = r + 1;\n          nc = c + DCOL[d];\n          count = exitPaths(nr, nc, d, rows, grid, memo, stateId);\n        }\n        memo.set(stateId(r, c, d), count);\n      }\n    }\n  }\n\n  let total = 0n;\n  for (const [r, c] of sources) {\n    total += memo.get(stateId(r, c, DOWN))!;\n  }\n  return total;\n}\n\n/**\n * Paths for a beam entering cell (r, c) with direction d. An out-of-bounds\n * target means the beam exits → exactly one completed path. Otherwise the\n * already-computed memo value for the in-bounds state is returned (the DP fills\n * rows bottom-up, so lower rows are always available).\n */\nfunction exitPaths(\n  r: number,\n  c: number,\n  d: number,\n  rows: number,\n  grid: string[][],\n  memo: Map<number, bigint>,\n  stateId: (r: number, c: number, d: number) => number,\n): bigint {\n  if (r < 0 || r >= rows || c < 0 || c >= (grid[r]?.length ?? 0)) {\n    return 1n; // exited the grid → one path\n  }\n  return memo.get(stateId(r, c, d))!;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
