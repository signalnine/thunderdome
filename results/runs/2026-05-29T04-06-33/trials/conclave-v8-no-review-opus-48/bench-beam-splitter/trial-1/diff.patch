+/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ *
+ * Grid cells:
+ *  - 'S' beam source (emits a beam straight down through its own cell)
+ *  - '^' splitter (a beam entering it splits into down-left and down-right)
+ *  - '.' empty
+ *
+ * A beam state is (row, col, dir). Rows strictly increase each step, so the
+ * graph of beam states is a DAG with no cycles — both queries are linear in
+ * the number of reachable states (rows * cols * 3).
+ */
+
+// Direction column deltas: 0 = down, 1 = down-left, 2 = down-right.
+const DCOL = [0, -1, 1] as const;
+const DOWN = 0;
+const DOWN_LEFT = 1;
+const DOWN_RIGHT = 2;
+
+const SOURCE = 'S';
+const SPLITTER = '^';
+
+function dimensions(grid: string[][]): { rows: number; cols: number } {
+  const rows = grid.length;
+  let cols = 0;
+  for (const row of grid) {
+    if (row.length > cols) cols = row.length;
+  }
+  return { rows, cols };
+}
+
+/** Locate every source cell ('S') in the grid. */
+function findSources(grid: string[][]): Array<[number, number]> {
+  const sources: Array<[number, number]> = [];
+  for (let r = 0; r < grid.length; r++) {
+    const row = grid[r];
+    for (let c = 0; c < row.length; c++) {
+      if (row[c] === SOURCE) sources.push([r, c]);
+    }
+  }
+  return sources;
+}
+
+/**
+ * Count the distinct in-bounds cells visited by any beam.
+ *
+ * Performs a breadth-first traversal over beam states, deduplicating states so
+ * each (row, col, dir) is expanded at most once, and recording the cell of
+ * every in-bounds state.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const { rows, cols } = dimensions(grid);
+  if (rows === 0 || cols === 0) return 0;
+
+  const sources = findSources(grid);
+  if (sources.length === 0) return 0;
+
+  const stateId = (r: number, c: number, d: number): number =>
+    (r * cols + c) * 3 + d;
+  const cellId = (r: number, c: number): number => r * cols + c;
+
+  const seenStates = new Set<number>();
+  const visitedCells = new Set<number>();
+  const stack: Array<[number, number, number]> = [];
+
+  for (const [r, c] of sources) {
+    const id = stateId(r, c, DOWN);
+    if (!seenStates.has(id)) {
+      seenStates.add(id);
+      stack.push([r, c, DOWN]);
+    }
+  }
+
+  while (stack.length > 0) {
+    const [r, c, d] = stack.pop()!;
+    // State is guaranteed in-bounds when pushed; record its cell.
+    visitedCells.add(cellId(r, c));
+
+    const cell = grid[r][c];
+    const push = (nr: number, nc: number, nd: number): void => {
+      if (nr < 0 || nr >= rows || nc < 0 || nc >= (grid[nr]?.length ?? 0)) {
+        return; // out of bounds → absorbed
+      }
+      const id = stateId(nr, nc, nd);
+      if (!seenStates.has(id)) {
+        seenStates.add(id);
+        stack.push([nr, nc, nd]);
+      }
+    };
+
+    if (cell === SPLITTER) {
+      push(r + 1, c - 1, DOWN_LEFT);
+      push(r + 1, c + 1, DOWN_RIGHT);
+    } else {
+      push(r + 1, c + DCOL[d], d);
+    }
+  }
+
+  return visitedCells.size;
+}
+
+/**
+ * Count the total number of distinct source-to-exit beam paths.
+ *
+ * Uses memoized counting over beam states: `paths(r, c, dir)` is the number of
+ * exit paths produced by a beam entering cell (r, c) with direction `dir`.
+ * Because rows strictly increase, the recurrence is acyclic and each state is
+ * computed once. The result is a bigint since it can reach 2^K for K splitters.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const { rows, cols } = dimensions(grid);
+  if (rows === 0 || cols === 0) return 0n;
+
+  const sources = findSources(grid);
+  if (sources.length === 0) return 0n;
+
+  const memo = new Map<number, bigint>();
+  const stateId = (r: number, c: number, d: number): number =>
+    (r * cols + c) * 3 + d;
+
+  // Iterative DP from the bottom row upward avoids deep recursion on tall grids.
+  for (let r = rows - 1; r >= 0; r--) {
+    const row = grid[r];
+    for (let c = 0; c < row.length; c++) {
+      for (let d = 0; d < 3; d++) {
+        // paths for a beam entering (r, c) heading direction d.
+        let nr: number;
+        let nc: number;
+        let count: bigint;
+        if (row[c] === SPLITTER) {
+          // down-left child
+          count = exitPaths(r + 1, c - 1, DOWN_LEFT, rows, grid, memo, stateId);
+          // down-right child
+          count += exitPaths(r + 1, c + 1, DOWN_RIGHT, rows, grid, memo, stateId);
+        } else {
+          nr = r + 1;
+          nc = c + DCOL[d];
+          count = exitPaths(nr, nc, d, rows, grid, memo, stateId);
+        }
+        memo.set(stateId(r, c, d), count);
+      }
+    }
+  }
+
+  let total = 0n;
+  for (const [r, c] of sources) {
+    total += memo.get(stateId(r, c, DOWN))!;
+  }
+  return total;
+}
+
+/**
+ * Paths for a beam entering cell (r, c) with direction d. An out-of-bounds
+ * target means the beam exits → exactly one completed path. Otherwise the
+ * already-computed memo value for the in-bounds state is returned (the DP fills
+ * rows bottom-up, so lower rows are always available).
+ */
+function exitPaths(
+  r: number,
+  c: number,
+  d: number,
+  rows: number,
+  grid: string[][],
+  memo: Map<number, bigint>,
+  stateId: (r: number, c: number, d: number) => number,
+): bigint {
+  if (r < 0 || r >= rows || c < 0 || c >= (grid[r]?.length ?? 0)) {
+    return 1n; // exited the grid → one path
+  }
+  return memo.get(stateId(r, c, d))!;
+}
