+/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ *
+ * A beam is described by a state (row, col, dir) where `dir` is the horizontal
+ * step taken on each move; every move also advances the row by exactly one:
+ *   DOWN  = 0   (straight down)
+ *   LEFT  = -1  (down-left)
+ *   RIGHT = +1  (down-right)
+ *
+ * Because every move strictly increases `row`, propagation forms a DAG ordered
+ * by row — there are no cycles. We therefore sweep the grid row by row, which
+ * lets us count both distinct visited cells and the total number of
+ * source-to-exit paths in a single linear pass, without enumerating the
+ * (potentially astronomically many) individual paths.
+ */
+
+interface SimulationResult {
+  /** Number of distinct in-bounds cells visited by any beam. */
+  cells: number;
+  /** Total number of distinct source-to-exit paths. */
+  paths: bigint;
+}
+
+/**
+ * Run the full simulation once, computing both the visited-cell count and the
+ * total path count. Both public functions delegate here.
+ */
+function simulate(grid: string[][]): SimulationResult {
+  const rows = grid.length;
+  if (rows === 0) return { cells: 0, paths: 0n };
+
+  // Grids are rectangular per the spec; derive width from the first row but
+  // clamp every per-row access to that row's actual length to stay robust.
+  const cols = grid[0].length;
+  if (cols === 0) return { cells: 0, paths: 0n };
+
+  // Per-direction path weights for beams arriving at the current row.
+  // Layout: curr[col * 3 + (dir + 1)] = number of paths arriving at (r, col)
+  // travelling in direction `dir`.
+  let curr = new Array<bigint>(cols * 3).fill(0n);
+
+  // Seed: every 'S' emits one beam straight down from its own cell.
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') {
+      curr[c * 3 + 1] += 1n; // DOWN
+    }
+  }
+
+  const visited = new Set<number>(); // encoded as r * cols + c
+  let totalPaths = 0n;
+
+  for (let r = 0; r < rows; r++) {
+    const next = new Array<bigint>(cols * 3).fill(0n);
+    const row = grid[r];
+
+    for (let c = 0; c < cols; c++) {
+      const base = c * 3;
+      const wLeft = curr[base];
+      const wDown = curr[base + 1];
+      const wRight = curr[base + 2];
+      const total = wLeft + wDown + wRight;
+      if (total === 0n) continue;
+
+      // A beam is present at (r, c): mark the cell visited.
+      visited.add(r * cols + c);
+
+      const isSplitter = c < row.length && row[c] === '^';
+
+      if (isSplitter) {
+        // Splits regardless of incoming direction: every arriving path
+        // becomes one down-left path and one down-right path.
+        emit(next, cols, rows, r, c - 1, -1, total, (w) => (totalPaths += w));
+        emit(next, cols, rows, r, c + 1, 1, total, (w) => (totalPaths += w));
+      } else {
+        // Non-splitter ('S', '.', or anything else): each beam continues in
+        // its own direction.
+        if (wLeft > 0n) emit(next, cols, rows, r, c - 1, -1, wLeft, (w) => (totalPaths += w));
+        if (wDown > 0n) emit(next, cols, rows, r, c, 0, wDown, (w) => (totalPaths += w));
+        if (wRight > 0n) emit(next, cols, rows, r, c + 1, 1, wRight, (w) => (totalPaths += w));
+      }
+    }
+
+    curr = next;
+  }
+
+  return { cells: visited.size, paths: totalPaths };
+}
+
+/**
+ * Deliver weight `w` to target cell (r+1, newCol) travelling in `dir`.
+ * If the target falls outside the grid the paths exit and are reported via
+ * `onExit`; otherwise they accumulate in `next`.
+ */
+function emit(
+  next: bigint[],
+  cols: number,
+  rows: number,
+  r: number,
+  newCol: number,
+  dir: number,
+  w: bigint,
+  onExit: (w: bigint) => void,
+): void {
+  const newRow = r + 1;
+  if (newRow >= rows || newCol < 0 || newCol >= cols) {
+    onExit(w); // moved beyond an edge → absorbed → path exits
+    return;
+  }
+  next[newCol * 3 + (dir + 1)] += w;
+}
+
+/**
+ * Count the number of distinct cells visited by any beam. A cell counts once
+ * even if multiple beams pass through it. The source cell counts as visited,
+ * as do splitter cells that a beam reaches.
+ */
+export function countBeamCells(grid: string[][]): number {
+  return simulate(grid).cells;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths through the grid.
+ * Each split at a `'^'` yields two separate paths; a path ends when the beam
+ * exits the grid. Returned as a `bigint` since the count can be astronomical.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  return simulate(grid).paths;
+}
