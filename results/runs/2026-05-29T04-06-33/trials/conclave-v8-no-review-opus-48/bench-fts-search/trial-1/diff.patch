+import Database from 'better-sqlite3';
+import { SearchResult, SuggestResult } from './models.js';
+
+export const PER_PAGE = 20;
+const SUGGEST_LIMIT = 5;
+const SNIPPET_TOKENS = 32;
+
+/**
+ * Build a safe FTS5 MATCH expression from raw user input.
+ *
+ * The FTS5 query language treats characters like `"` `*` `(` `)` `:` `-` `+`
+ * `^` and `/` as operators/syntax, so passing raw user text to MATCH can throw
+ * a syntax error. We defuse this by extracting only the meaningful pieces:
+ *   - quoted "phrases" are preserved as FTS5 phrase queries
+ *   - everything else is split into alphanumeric tokens, each wrapped in
+ *     double quotes so any stray punctuation is treated as a separator.
+ *
+ * If `prefix` is true, a trailing `*` is appended to each bare token so the
+ * last word acts as an autocomplete prefix (e.g. "learn" -> matches "learning").
+ *
+ * Returns an empty string when the input contains no searchable tokens, in
+ * which case callers should short-circuit to an empty result set rather than
+ * running a MATCH against an empty/invalid expression.
+ */
+export function buildFtsQuery(raw: string, prefix = false): string {
+  const tokens: string[] = [];
+  // Match either a "double quoted phrase" or a run of non-whitespace.
+  const regex = /"([^"]*)"|(\S+)/g;
+  let m: RegExpExecArray | null;
+
+  while ((m = regex.exec(raw)) !== null) {
+    if (m[1] !== undefined) {
+      // Quoted phrase: keep inner words, drop any rogue quote chars.
+      const words = m[1].match(/[\p{L}\p{N}]+/gu);
+      if (words && words.length > 0) {
+        tokens.push('"' + words.join(' ') + '"');
+      }
+    } else {
+      // Bare chunk: extract alphanumeric/unicode-letter tokens.
+      const words = m[2].match(/[\p{L}\p{N}]+/gu);
+      if (words) {
+        for (const w of words) {
+          tokens.push(prefix ? '"' + w + '"' + '*' : '"' + w + '"');
+        }
+      }
+    }
+  }
+
+  return tokens.join(' ');
+}
+
+export function searchNotes(
+  db: Database.Database,
+  q: string,
+  page: number
+): { results: SearchResult[]; total: number; page: number; perPage: number } {
+  const match = buildFtsQuery(q);
+
+  if (match === '') {
+    return { results: [], total: 0, page, perPage: PER_PAGE };
+  }
+
+  const total = (
+    db
+      .prepare('SELECT COUNT(*) AS c FROM notes_fts WHERE notes_fts MATCH ?')
+      .get(match) as { c: number }
+  ).c;
+
+  const offset = (page - 1) * PER_PAGE;
+  const rows = db
+    .prepare(
+      `SELECT
+         n.id AS id,
+         n.title AS title,
+         snippet(notes_fts, -1, '<mark>', '</mark>', '…', ?) AS snippet,
+         bm25(notes_fts) AS rank
+       FROM notes_fts
+       JOIN notes n ON n.id = notes_fts.rowid
+       WHERE notes_fts MATCH ?
+       ORDER BY rank
+       LIMIT ? OFFSET ?`
+    )
+    .all(SNIPPET_TOKENS, match, PER_PAGE, offset) as SearchResult[];
+
+  return { results: rows, total, page, perPage: PER_PAGE };
+}
+
+export function suggestNotes(db: Database.Database, q: string): SuggestResult[] {
+  const match = buildFtsQuery(q, true);
+
+  if (match === '') {
+    return [];
+  }
+
+  const rows = db
+    .prepare(
+      `SELECT n.id AS id, n.title AS title
+       FROM notes_fts
+       JOIN notes n ON n.id = notes_fts.rowid
+       WHERE notes_fts MATCH ?
+       ORDER BY rank
+       LIMIT ?`
+    )
+    .all(match, SUGGEST_LIMIT) as SuggestResult[];
+
+  return rows;
+}
