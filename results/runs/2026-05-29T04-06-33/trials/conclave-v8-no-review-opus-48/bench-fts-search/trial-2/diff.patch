+/**
+ * Create the FTS5 virtual table and triggers that keep it synchronized with
+ * the `notes` table. Using triggers (rather than manual sync in the routes)
+ * ensures the index stays correct no matter how rows are inserted/updated/
+ * deleted -- including the seed script and tests that write directly to the
+ * `notes` table.
+ */
+function setupFts(db: Database.Database): void {
+  // External-content FTS5 table mirroring notes.title / notes.body.
+  db.exec(`
+    CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts USING fts5(
+      title,
+      body,
+      content='notes',
+      content_rowid='id'
+    )
+  `);
+
+  // Keep the index in sync with the underlying table.
+  db.exec(`
+    CREATE TRIGGER IF NOT EXISTS notes_ai AFTER INSERT ON notes BEGIN
+      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);
+    END;
+
+    CREATE TRIGGER IF NOT EXISTS notes_ad AFTER DELETE ON notes BEGIN
+      INSERT INTO notes_fts(notes_fts, rowid, title, body) VALUES ('delete', old.id, old.title, old.body);
+    END;
+
+    CREATE TRIGGER IF NOT EXISTS notes_au AFTER UPDATE ON notes BEGIN
+      INSERT INTO notes_fts(notes_fts, rowid, title, body) VALUES ('delete', old.id, old.title, old.body);
+      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);
+    END;
+  `);
+
+  // Rebuild from existing rows so a pre-populated (e.g. file-backed) database
+  // is indexed. This is a no-op for a freshly created empty table.
+  db.exec(`INSERT INTO notes_fts(notes_fts) VALUES ('rebuild')`);
+}
