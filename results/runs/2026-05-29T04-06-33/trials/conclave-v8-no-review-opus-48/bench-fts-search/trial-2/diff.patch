diff --git a/src/search.ts b/src/search.ts
new file mode 100644
index 0000000..f45bacd
--- /dev/null
+++ b/src/search.ts
@@ -0,0 +1,126 @@
+import Database from 'better-sqlite3';
+import { SearchResult, SuggestResult } from './models.js';
+
+export const PER_PAGE = 20;
+const SUGGEST_LIMIT = 5;
+
+/**
+ * Build a safe FTS5 MATCH expression from arbitrary user input.
+ *
+ * User queries may contain characters that are significant in the FTS5 query
+ * grammar (`"`, `*`, `(`, `:`, `+`, `-`, `^`, etc.). Passing them through
+ * unescaped causes "fts5: syntax error" failures. To stay both safe and
+ * useful we:
+ *   - extract explicit "double quoted" segments and keep them as phrases,
+ *   - treat the remaining whitespace-separated chunks as individual terms,
+ *   - wrap every term/phrase in double quotes (FTS5 string literals), which
+ *     neutralizes all special characters inside.
+ *
+ * Returns an empty string when there is nothing searchable, in which case the
+ * caller should short-circuit to an empty result set.
+ */
+export function buildMatchQuery(raw: string): string {
+  const tokens: string[] = [];
+
+  // Pull out explicit phrases delimited by double quotes first.
+  const remaining = raw.replace(/"([^"]*)"/g, (_match, phrase: string) => {
+    const cleaned = phrase.trim();
+    if (cleaned) {
+      tokens.push(quote(cleaned));
+    }
+    return ' ';
+  });
+
+  // Whatever is left becomes individual terms.
+  for (const word of remaining.split(/\s+/)) {
+    if (word) {
+      tokens.push(quote(word));
+    }
+  }
+
+  return tokens.join(' ');
+}
+
+/**
+ * Build a prefix MATCH expression for autocomplete. The last token becomes a
+ * prefix query (`term*`) so partial words match.
+ */
+export function buildPrefixQuery(raw: string): string {
+  const words = raw
+    .replace(/"/g, ' ')
+    .split(/\s+/)
+    .map((w) => w.replace(/[^\p{L}\p{N}]/gu, ''))
+    .filter(Boolean);
+
+  if (words.length === 0) {
+    return '';
+  }
+
+  // Quote the full phrase and apply a prefix wildcard to its last token.
+  return `${quote(words.join(' '))}*`;
+}
+
+function quote(value: string): string {
+  // Escape embedded double quotes by doubling them, per FTS5 string syntax.
+  return `"${value.replace(/"/g, '""')}"`;
+}
+
+export function search(
+  db: Database.Database,
+  rawQuery: string,
+  page: number
+): { results: SearchResult[]; total: number; page: number; perPage: number } {
+  const match = buildMatchQuery(rawQuery);
+
+  if (!match) {
+    return { results: [], total: 0, page, perPage: PER_PAGE };
+  }
+
+  const total = (
+    db
+      .prepare('SELECT COUNT(*) AS count FROM notes_fts WHERE notes_fts MATCH ?')
+      .get(match) as { count: number }
+  ).count;
+
+  const offset = (page - 1) * PER_PAGE;
+
+  const rows = db
+    .prepare(
+      `
+      SELECT
+        notes_fts.rowid AS id,
+        notes.title AS title,
+        snippet(notes_fts, -1, '<mark>', '</mark>', '…', 20) AS snippet,
+        rank AS rank
+      FROM notes_fts
+      JOIN notes ON notes.id = notes_fts.rowid
+      WHERE notes_fts MATCH ?
+      ORDER BY rank
+      LIMIT ? OFFSET ?
+      `
+    )
+    .all(match, PER_PAGE, offset) as SearchResult[];
+
+  return { results: rows, total, page, perPage: PER_PAGE };
+}
+
+export function suggest(db: Database.Database, rawQuery: string): SuggestResult[] {
+  const match = buildPrefixQuery(rawQuery);
+
+  if (!match) {
+    return [];
+  }
+
+  return db
+    .prepare(
+      `
+      SELECT notes_fts.rowid AS id, notes.title AS title
+      FROM notes_fts
+      JOIN notes ON notes.id = notes_fts.rowid
+      WHERE notes_fts MATCH ?
+      ORDER BY rank
+      LIMIT ?
+      `
+    )
+    .all(match, SUGGEST_LIMIT) as SuggestResult[];
+}
