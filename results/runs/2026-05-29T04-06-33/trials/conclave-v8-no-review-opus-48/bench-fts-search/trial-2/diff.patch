+{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_017vi5aYofyj6zQEXJqBDftU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01N59guWkjftih3VBVFfyh9c","name":"Write","input":{"file_path":"/workspace/src/search.ts","content":"import Database from 'better-sqlite3';\nimport { SearchResult, SuggestResult } from './models.js';\n\nexport const PER_PAGE = 20;\nconst SUGGEST_LIMIT = 5;\n\n/**\n * Build a safe FTS5 MATCH expression from arbitrary user input.\n *\n * User queries may contain characters that are significant in the FTS5 query\n * grammar (`\"`, `*`, `(`, `:`, `+`, `-`, `^`, etc.). Passing them through\n * unescaped causes \"fts5: syntax error\" failures. To stay both safe and\n * useful we:\n *   - extract explicit \"double quoted\" segments and keep them as phrases,\n *   - treat the remaining whitespace-separated chunks as individual terms,\n *   - wrap every term/phrase in double quotes (FTS5 string literals), which\n *     neutralizes all special characters inside.\n *\n * Returns an empty string when there is nothing searchable, in which case the\n * caller should short-circuit to an empty result set.\n */\nexport function buildMatchQuery(raw: string): string {\n  const tokens: string[] = [];\n\n  // Pull out explicit phrases delimited by double quotes first.\n  const remaining = raw.replace(/\"([^\"]*)\"/g, (_match, phrase: string) => {\n    const cleaned = phrase.trim();\n    if (cleaned) {\n      tokens.push(quote(cleaned));\n    }\n    return ' ';\n  });\n\n  // Whatever is left becomes individual terms.\n  for (const word of remaining.split(/\\s+/)) {\n    if (word) {\n      tokens.push(quote(word));\n    }\n  }\n\n  return tokens.join(' ');\n}\n\n/**\n * Build a prefix MATCH expression for autocomplete. The last token becomes a\n * prefix query (`term*`) so partial words match.\n */\nexport function buildPrefixQuery(raw: string): string {\n  const words = raw\n    .replace(/\"/g, ' ')\n    .split(/\\s+/)