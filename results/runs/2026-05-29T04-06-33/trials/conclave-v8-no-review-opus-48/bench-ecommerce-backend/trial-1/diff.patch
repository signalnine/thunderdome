+++ b/src/notifications/index.ts
@@ -0,0 +1,91 @@
+import { EventBus } from '../bus.js';
+import {
+  NotificationService,
+  Events,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+  NotificationSentEvent,
+} from '../types.js';
+
+interface Notification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+/**
+ * Notifications tracks order ownership and reacts to order/payment events.
+ *
+ * Subscription handlers emit `notification:sent` for live delivery, but
+ * getNotifications is derived from the bus log so it is correct regardless of
+ * handler registration order or microtask timing (the bus only runs the first
+ * handler synchronously when an emit is not awaited).
+ */
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+
+  function ownerOf(orderId: string): string | undefined {
+    for (const { event, payload } of bus.getLog()) {
+      if (event === Events.ORDER_CREATED) {
+        const created = payload as OrderCreatedEvent;
+        if (created.orderId === orderId) return created.userId;
+      }
+    }
+    return undefined;
+  }
+
+  // Live delivery: emit notification:sent for subscribed users as events arrive.
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload: unknown) => {
+    const { orderId, status } = payload as OrderStatusChangedEvent;
+    const userId = ownerOf(orderId);
+    if (!userId || !subscribers.has(userId)) return;
+    const sent: NotificationSentEvent = {
+      userId,
+      type: 'order_status',
+      message: `Order ${orderId} is now ${status}`,
+    };
+    void bus.emit(Events.NOTIFICATION_SENT, sent);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {
+    const { orderId, status } = payload as PaymentProcessedEvent;
+    const userId = ownerOf(orderId);
+    if (!userId || !subscribers.has(userId)) return;
+    const sent: NotificationSentEvent = {
+      userId,
+      type: 'payment',
+      message: `Payment for order ${orderId} ${status}`,
+    };
+    void bus.emit(Events.NOTIFICATION_SENT, sent);
+  });
+
+  return {
+    subscribe(userId: string): void {
+      subscribers.add(userId);
+    },
+
+    getNotifications(userId: string): Notification[] {
+      if (!subscribers.has(userId)) return [];
+      const orderToUser = new Map<string, string>();
+      const result: Notification[] = [];
+      for (const { event, payload, timestamp } of bus.getLog()) {
+        if (event === Events.ORDER_CREATED) {
+          const created = payload as OrderCreatedEvent;
+          orderToUser.set(created.orderId, created.userId);
+        } else if (event === Events.ORDER_STATUS_CHANGED) {
+          const { orderId, status } = payload as OrderStatusChangedEvent;
+          if (orderToUser.get(orderId) === userId) {
+            result.push({ type: 'order_status', message: `Order ${orderId} is now ${status}`, timestamp });
+          }
+        } else if (event === Events.PAYMENT_PROCESSED) {
+          const { orderId, status } = payload as PaymentProcessedEvent;
+          if (orderToUser.get(orderId) === userId) {
+            result.push({ type: 'payment', message: `Payment for order ${orderId} ${status}`, timestamp });
+          }
+        }
+      }
+      return result;
+    },
+  };
+}
