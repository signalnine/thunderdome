@@ -0,0 +1,67 @@
+import { EventBus } from '../bus.js';
+import { PaymentService, PaymentStatus, Events, PaymentProcessedEvent } from '../types.js';
+
+export interface PaymentOptions {
+  /** Forced outcome for every payment. Defaults to 'success'. */
+  outcome?: 'success' | 'failure' | 'timeout';
+  /** Simulated processing delay in milliseconds. Defaults to 0. */
+  delayMs?: number;
+}
+
+interface Transaction {
+  transactionId: string;
+  orderId: string;
+  amount: number;
+  refunded: boolean;
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentOptions = {}): PaymentService {
+  const outcome = options.outcome ?? 'success';
+  const delayMs = options.delayMs ?? 0;
+  const transactions = new Map<string, Transaction>();
+  let counter = 0;
+
+  return {
+    async processPayment(
+      orderId: string,
+      amount: number,
+    ): Promise<{ status: PaymentStatus; transactionId?: string; error?: string }> {
+      if (delayMs > 0) {
+        await delay(delayMs);
+      }
+
+      let result: { status: PaymentStatus; transactionId?: string; error?: string };
+      if (outcome === 'success') {
+        const transactionId = `txn_${++counter}`;
+        transactions.set(transactionId, { transactionId, orderId, amount, refunded: false });
+        result = { status: PaymentStatus.SUCCESS, transactionId };
+      } else if (outcome === 'failure') {
+        result = { status: PaymentStatus.FAILED, error: 'Payment failed' };
+      } else {
+        result = { status: PaymentStatus.TIMEOUT, error: 'Payment timed out' };
+      }
+
+      const payload: PaymentProcessedEvent = {
+        orderId,
+        status: result.status,
+        transactionId: result.transactionId,
+        error: result.error,
+      };
+      await bus.emit(Events.PAYMENT_PROCESSED, payload);
+      return result;
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      const txn = transactions.get(transactionId);
+      if (!txn || txn.refunded) {
+        return false;
+      }
+      txn.refunded = true;
+      return true;
+    },
+  };
+}
