diff --git a/src/analytics/index.ts b/src/analytics/index.ts
new file mode 100644
index 0000000..2ae5fa4
--- /dev/null
+++ b/src/analytics/index.ts
@@ -0,0 +1,77 @@
+import { EventBus } from '../bus.js';
+import {
+  AnalyticsService,
+  PaymentStatus,
+  Events,
+  OrderCreatedEvent,
+  CartUpdatedEvent,
+  PaymentProcessedEvent,
+} from '../types.js';
+
+/**
+ * Analytics derives every metric from the bus event log at query time.
+ *
+ * The bus awaits each handler, so when an emit is not awaited only the first
+ * registered handler runs synchronously and the rest are deferred to
+ * microtasks. Reading the (always-synchronous, fully-ordered) event log avoids
+ * any dependency on handler registration order or microtask timing.
+ */
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  return {
+    getEventCount(eventType: string): number {
+      return bus.getLog().filter((entry) => entry.event === eventType).length;
+    },
+
+    getRevenue(): number {
+      const orderTotals = new Map<string, number>();
+      let revenue = 0;
+      for (const { event, payload } of bus.getLog()) {
+        if (event === Events.ORDER_CREATED) {
+          const { orderId, total } = payload as OrderCreatedEvent;
+          orderTotals.set(orderId, total);
+        } else if (event === Events.PAYMENT_PROCESSED) {
+          const { orderId, status } = payload as PaymentProcessedEvent;
+          if (status === PaymentStatus.SUCCESS) {
+            revenue += orderTotals.get(orderId) ?? 0;
+          }
+        }
+      }
+      return revenue;
+    },
+
+    getConversionRate(): number {
+      const uniqueCarts = new Set<string>();
+      let orderCount = 0;
+      for (const { event, payload } of bus.getLog()) {
+        if (event === Events.CART_UPDATED) {
+          uniqueCarts.add((payload as CartUpdatedEvent).cartId);
+        } else if (event === Events.ORDER_CREATED) {
+          orderCount += 1;
+        }
+      }
+      if (uniqueCarts.size === 0) return 0;
+      return orderCount / uniqueCarts.size;
+    },
+
+    getTopProducts(limit: number): Array<{ productId: string; count: number }> {
+      const cartItems = new Map<string, Array<{ productId: string; quantity: number }>>();
+      const productOrderCounts = new Map<string, number>();
+      for (const { event, payload } of bus.getLog()) {
+        if (event === Events.CART_UPDATED) {
+          const { cartId, items } = payload as CartUpdatedEvent;
+          cartItems.set(cartId, items);
+        } else if (event === Events.ORDER_CREATED) {
+          const { cartId } = payload as OrderCreatedEvent;
+          const items = cartItems.get(cartId) ?? [];
+          for (const item of items) {
+            productOrderCounts.set(item.productId, (productOrderCounts.get(item.productId) ?? 0) + item.quantity);
+          }
+        }
+      }
+      return Array.from(productOrderCounts.entries())
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count)
+        .slice(0, limit);
+    },
+  };
+}
diff --git a/src/cart/index.ts b/src/cart/index.ts
new file mode 100644
index 0000000..85f2140
--- /dev/null
+++ b/src/cart/index.ts
@@ -0,0 +1,83 @@
+import { EventBus } from '../bus.js';
+import { CartService, Events, CartUpdatedEvent } from '../types.js';
+
+interface CartItem {
+  productId: string;
+  quantity: number;
+}
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: CartItem[];
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+  let counter = 0;
+
+  function emitUpdate(cart: Cart): void {
+    const payload: CartUpdatedEvent = {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: cart.items.map((i) => ({ ...i })),
+    };
+    void bus.emit(Events.CART_UPDATED, payload);
+  }
+
+  return {
+    createCart(userId: string): string {
+      const id = `cart_${++counter}`;
+      carts.set(id, { id, userId, items: [] });
+      return id;
+    },
+
+    addItem(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const existing = cart.items.find((i) => i.productId === productId);
+      if (existing) {
+        existing.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      // Drop items that consolidate to non-positive quantity.
+      cart.items = cart.items.filter((i) => i.quantity > 0);
+      emitUpdate(cart);
+    },
+
+    removeItem(cartId: string, productId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items = cart.items.filter((i) => i.productId !== productId);
+      emitUpdate(cart);
+    },
+
+    getCart(cartId: string): Cart | null {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      return { id: cart.id, userId: cart.userId, items: cart.items.map((i) => ({ ...i })) };
+    },
+
+    clearCart(cartId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items = [];
+      emitUpdate(cart);
+    },
+
+    updateQuantity(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const existing = cart.items.find((i) => i.productId === productId);
+      if (quantity <= 0) {
+        cart.items = cart.items.filter((i) => i.productId !== productId);
+      } else if (existing) {
+        existing.quantity = quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      emitUpdate(cart);
+    },
+  };
+}
