@@ -0,0 +1,57 @@
+import { EventBus } from '../bus.js';
+import { PricingService, Events, ProductCreatedEvent } from '../types.js';
+
+const TAX_RATE = 0.1;
+
+function round2(value: number): number {
+  return Math.round((value + Number.EPSILON) * 100) / 100;
+}
+
+export function createPricingService(bus: EventBus): PricingService {
+  const discountCodes = new Map<string, number>();
+  const prices = new Map<string, number>();
+
+  bus.on(Events.PRODUCT_CREATED, (payload: unknown) => {
+    const { productId, price } = payload as ProductCreatedEvent;
+    prices.set(productId, price);
+  });
+
+  return {
+    calculateTotal(
+      items: Array<{ productId: string; quantity: number; price: number }>,
+      discountCode?: string,
+    ): { subtotal: number; discount: number; tax: number; total: number } {
+      const subtotal = items.reduce((sum, item) => sum + item.price * item.quantity, 0);
+      const percentage = discountCode !== undefined ? discountCodes.get(discountCode) : undefined;
+      const discount = percentage !== undefined ? subtotal * (percentage / 100) : 0;
+      const taxable = subtotal - discount;
+      const tax = taxable * TAX_RATE;
+      const total = taxable + tax;
+      return {
+        subtotal: round2(subtotal),
+        discount: round2(discount),
+        tax: round2(tax),
+        total: round2(total),
+      };
+    },
+
+    addDiscountCode(code: string, percentage: number): void {
+      discountCodes.set(code, percentage);
+    },
+
+    getPrice(productId: string): number {
+      const tracked = prices.get(productId);
+      if (tracked !== undefined) return tracked;
+      // Fall back to the bus log in case the product:created handler has not
+      // yet run (the bus defers all but the first handler off the sync path).
+      let price = 0;
+      for (const { event, payload } of bus.getLog()) {
+        if (event === Events.PRODUCT_CREATED) {
+          const created = payload as ProductCreatedEvent;
+          if (created.productId === productId) price = created.price;
+        }
+      }
+      return price;
+    },
+  };
+}
