rt.addItem(cartId, gadget, 3);\n\n    // Pricing total.\n    const items = cart.getCart(cartId)!.items.map((i) => ({\n      productId: i.productId,\n      quantity: i.quantity,\n      price: pricing.getPrice(i.productId),\n    }));\n    const totals = pricing.calculateTotal(items);\n    // subtotal = 2*20 + 3*5 = 55; tax = 5.5; total = 60.5\n    expect(totals).toEqual({ subtotal: 55, discount: 0, tax: 5.5, total: 60.5 });\n\n    // Order lifecycle.\n    const orderId = orders.createOrder('alice', cartId, totals.total);\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n\n    // Payment (awaited -> flushes all pending handlers).\n    const pay = await payment.processPayment(orderId, totals.total);\n    expect(pay.status).toBe(PaymentStatus.SUCCESS);\n\n    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n    orders.updateStatus(orderId, OrderStatus.DELIVERED);\n\n    // Analytics — derived from the log, order-independent and synchronous.\n    expect(analytics.getRevenue()).toBe(60.5);\n    expect(analytics.getConversionRate()).toBe(1); // 1 order / 1 cart\n    const top = analytics.getTopProducts(5);\n    expect(top).toEqual([\n      { productId: gadget, count: 3 },\n      { productId: widget, count: 2 },\n    ]);\n\n    // Notifications for alice: 2 status changes recorded before payment +\n    // 1 payment + 2 after. Confirm at least the confirmed/payment/shipped/delivered.\n    const messages = notif.getNotifications('alice');\n    const types = messages.map((m) => m.type);\n    expect(types.filter((t) => t === 'order_status')).toHaveLength(3); // confirmed, shipped, delivered\n    expect(types.filter((t) => t === 'payment')).toHaveLength(1);\n\n    // Unsubscribed user sees nothing.\n    expect(notif.getNotifications('bob')).toEqual([]);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":392,"cache_read_input_tokens":70433,"cache_creation":{"