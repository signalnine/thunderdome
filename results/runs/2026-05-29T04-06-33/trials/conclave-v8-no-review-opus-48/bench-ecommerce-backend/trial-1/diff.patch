em', 42, 'c');\n    expect(pricing.getPrice(id)).toBe(42);\n    expect(pricing.getPrice('unknown')).toBe(0);\n  });\n});\n\ndescribe('Orders', () => {\n  let bus: EventBus;\n  beforeEach(() => {\n    bus = new EventBus();\n  });\n\n  it('creates pending order and emits order:created', () => {\n    const events: unknown[] = [];\n    bus.on(Events.ORDER_CREATED, (p) => events.push(p));\n    const orders = createOrderService(bus);\n    const id = orders.createOrder('u1', 'c1', 50);\n    expect(orders.getOrder(id)).toEqual({ id, userId: 'u1', status: OrderStatus.PENDING, total: 50 });\n    expect(events).toEqual([{ orderId: id, userId: 'u1', cartId: 'c1', total: 50 }]);\n  });\n\n  it('unknown order -> null', () => {\n    const orders = createOrderService(bus);\n    expect(orders.getOrder('nope')).toBeNull();\n  });\n\n  it('progresses through lifecycle emitting previousStatus', () => {\n    const events: Array<{ status: OrderStatus; previousStatus: OrderStatus }> = [];\n    bus.on(Events.ORDER_STATUS_CHANGED, (p) => events.push(p as never));\n    const orders = createOrderService(bus);\n    const id = orders.createOrder('u1', 'c1', 10);\n    orders.updateStatus(id, OrderStatus.CONFIRMED);\n    orders.updateStatus(id, OrderStatus.SHIPPED);\n    orders.updateStatus(id, OrderStatus.DELIVERED);\n    expect(events.map((e) => e.status)).toEqual([\n      OrderStatus.CONFIRMED,\n      OrderStatus.SHIPPED,\n      OrderStatus.DELIVERED,\n    ]);\n    expect(events[0].previousStatus).toBe(OrderStatus.PENDING);\n    expect(events[2].previousStatus).toBe(OrderStatus.SHIPPED);\n  });\n\n  it('allows cancellation from pending', () => {\n    const orders = createOrderService(bus);\n    const id = orders.createOrder('u1', 'c1', 10);\n    expect(() => orders.updateStatus(id, OrderStatus.CANCELLED)).not.toThrow();\n    expect(orders.getOrder(id)?.status).toBe(OrderStatus.CANCELLED);\n  });\n\n  it('throws on invalid transition', () => {\n    const orders = createOrderService(bus);\n    const id = orders.createOrder('u1', 'c1', 10);\n    orders.updateStatus(id, OrderStatus.CONFIRMED);\n    orders.updateStatus(id, OrderStatus.SHIPPED);\n    orders.updateStatus(id, OrderStatus.DELIVERED);\n    expect(() => orders.updateStatus(id, OrderStatus.SHIPPED)).toThrow();\n  });\n\n  it('lists orders by user', () => {\n    const orders = createOrderService(bus);\n    orders.createOrder('u1', 'c1', 10);\n    orders.createOrder('u2', 'c2', 20);\n    orders.createOrder('u1', 'c3', 30);\n    expect(orders.listOrders('u1')).toHaveLength(2);\n    expect(orders.listOrders('u2')).toHaveLength(1);\n  });\n});\n\ndescribe('Payment', () => {\n  let bus: EventBus;\n  beforeEach(() => {\n    bus = new EventBus();\n  });\n\n  it('succeeds by default and emits payment:processed', async () => {\n    const events: unknown[] = [];\n    bus.on(Events.PAYMENT_PROCESSED, (p) => events.push(p));\n    const payment = createPaymentService(bus);\n    const result = await payment.processPayment('o1', 100);\n    expect(result.status).toBe(PaymentStatus.SUCCESS);\n    expect(result.transactionId).toBeDefined();\n    expect(events).toHaveLength(1);\n  });\n\n  it('simulates failure', async () => {\n    const payment = createPaymentService(bus, { outcome: 'failure' });\n    const result = await payment.processPayment('o1', 100);\n    expect(result.status).toBe(PaymentStatus.FAILED);\n    expect(result.error).toBeDefined();\n  });\n\n  it('simulates timeout', async () => {\n    const payment = createPaymentService(bus, { outcome: 'timeout' });\n    const result = await payment.processPayment('o1', 100);\n    expect(result.status).toBe(PaymentStatus.TIMEOUT);\n  });\n\n  it('honours a delay', async () => {\n    const payment = createPaymentService(bus, { delayMs: 20 });\n    const start = Date.now();\n    await payment.processPayment('o1', 1);\n    expect(Date.now() - start).toBeGreaterThanOrEqual(15);\n  });\n\n  it('refunds a successful txn once', async () => {\n    const payment = createPaymentService(bus);\n    const result = await payment.processPayment('o1', 100);\n    expect(await payment.refund(result.transactionId!)).toBe(true);\n    expect(await payment.refund(result.transactionId!)).toBe(false);\n    expect(await payment.refund('unknown')).toBe(false);\n  });\n});\n\ndescribe('Notifications', () => {\n  let bus: EventBus;\n  beforeEach(() => {\n    bus = new EventBus();\n  });\n\n  it('records order status and payment notifications for subscribed users', async () => {\n    const notif = createNotificationService(bus);\n    const orders = createOrderService(bus);\n    const payment = createPaymentService(bus);\n    notif.subscribe('u1');\n    const id = orders.createOrder('u1', 'c1', 50);\n    orders.updateStatus(id, OrderStatus.CONFIRMED);\n    await payment.processPayment(id, 50);\n    const list = notif.getNotifications('u1');\n    expect(list.length).toBe(2);\n    expect(list.map((n) => n.type)).toContain('order_status');\n    expect(list.map((n) => n.type)).toContain('payment');\n  });\n\n  it('does not record for unsubscribed users', () => {\n    const notif = createNotificationService(bus);\n    const orders = createOrderService(bus);\n    const id = orders.createOrder('u2', 'c1', 50);\n    orders.updateStatus(id, OrderStatus.CONFIRMED);\n    expect(notif.getNotifications('u2')).toEqual([]);\n  });\n});\n\ndescribe('Analytics', () => {\n  let bus: EventBus;\n  beforeEach(() => {\n    bus = new EventBus();\n  });\n\n  it('counts events by type', () => {\n    const analytics = createAnalyticsService(bus);\n    const catalog = createCatalogService(bus);\n    catalog.createProduct('A', 1, 'c');\n    catalog.createProduct('B', 2, 'c');\n    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBe(2);\n    expect(analytics.getEventCount(Events.ORDER_CREATED)).toBe(0);\n  });\n\n  it('tracks revenue from successful payments only', async () => {\n    const analytics = createAnalyticsService(bus);\n    const orders = createOrderService(bus);\n    const okPay = createPaymentService(bus);\n    const o1 = orders.createOrder('u1', 'c1', 100);\n    const o2 = orders.createOrder('u2', 'c2', 200);\n    await okPay.processPayment(o1, 100);\n    const failPay = createPaymentService(bus, { outcome: 'failure' });\n    await failPay.processPayment(o2, 200);\n    expect(analytics.getRevenue()).toBe(100);\n  });\n\n  it('computes conversion rate orders/unique carts', () => {\n    const analytics = createAnalyticsService(bus);\n    const cart = createCartService(bus);\n    const orders = createOrderService(bus);\n    const c1 = cart.createCart('u1');\n    const c2 = cart.createCart('u2');\n    cart.addItem(c1, 'p1', 1); // cart:updated -> unique cart c1\n    cart.addItem(c2, 'p2', 1); // unique cart c2\n    orders.createOrder('u1', c1, 10); // 1 order\n    expect(analytics.getConversionRate()).toBe(0.5);\n  });\n\n  it('conversion rate 0 with no carts', () => {\n    const analytics = createAnalyticsService(bus);\n    expect(analytics.getConversionRate()).toBe(0);\n  });\n\n  it('ranks top products by ordered quantity', () => {\n    const analytics = createAnalyticsService(bus);\n    const cart = createCartService(bus);\n    const orders = createOrderService(bus);\n    const c1 = cart.createCart('u1');\n    cart.addItem(c1, 'p1', 2);\n    cart.addItem(c1, 'p2', 5);\n    orders.createOrder('u1', c1, 10);\n    const c2 = cart.createCart('u2');\n    cart.addItem(c2, 'p1', 3);\n    orders.createOrder('u2', c2, 10);\n    const top = analytics.getTopProducts(2);\n    expect(top[0]).toEqual({ productId: 'p1', count: 5 });\n    expect(top[1]).toEqual({ productId: 'p2', count: 5 });\n    expect(analytics.getTopProducts(1)).toHaveLength(1);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
