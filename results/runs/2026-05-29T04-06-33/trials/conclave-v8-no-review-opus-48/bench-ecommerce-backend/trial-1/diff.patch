nt: number; tax: number; total: number } {\n      const subtotal = items.reduce((sum, item) => sum + item.price * item.quantity, 0);\n      const percentage = discountCode !== undefined ? discountCodes.get(discountCode) : undefined;\n      const discount = percentage !== undefined ? subtotal * (percentage / 100) : 0;\n      const taxable = subtotal - discount;\n      const tax = taxable * TAX_RATE;\n      const total = taxable + tax;\n      return {\n        subtotal: round2(subtotal),\n        discount: round2(discount),\n        tax: round2(tax),\n        total: round2(total),\n      };\n    },\n\n    addDiscountCode(code: string, percentage: number): void {\n      discountCodes.set(code, percentage);\n    },\n\n    getPrice(productId: string): number {\n      return prices.get(productId) ?? 0;\n    },\n  };\n}\n","structuredPatch":[{"oldStart":40,"oldLines":7,"newStart":40,"newLines":18,"lines":["     },"," ","     getPrice(productId: string): number {","-      return prices.get(productId) ?? 0;","+      const tracked = prices.get(productId);","+      if (tracked !== undefined) return tracked;","+      // Fall back to the bus log in case the product:created handler has not","+      // yet run (the bus defers all but the first handler off the sync path).","+      let price = 0;","+      for (const { event, payload } of bus.getLog()) {","+        if (event === Events.PRODUCT_CREATED) {","+          const created = payload as ProductCreatedEvent;","+          if (created.productId === productId) price = created.price;","+        }","+      }","+      return price;","     },","   };"," }"]}],"userModified":false,"replaceAll":false}}
