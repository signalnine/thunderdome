n    seen.add(id);\n  }\n  expect(seen.size).toBe(events.length);\n  for (const e of events) expect(seen.has(e.id)).toBe(true);\n\n  // Per-assignment constraints.\n  for (const a of res.assignments) {\n    const ev = eventById.get(a.eventId)!;\n    expect(ev).toBeDefined();\n    // duration\n    expect(a.endTime - a.startTime).toBe(ev.duration);\n    // window\n    expect(a.startTime).toBeGreaterThanOrEqual(options.startTime);\n    expect(a.endTime).toBeLessThanOrEqual(options.endTime);\n    // capacity\n    const need = ev.attendees ?? 1;\n    expect(capacity.get(a.roomId)).toBeGreaterThanOrEqual(need);\n  }\n\n  // Room gaps: events in the same room must be gap-separated.\n  const byRoom = new Map<string, Assignment[]>();\n  for (const a of res.assignments) {\n    if (!byRoom.has(a.roomId)) byRoom.set(a.roomId, []);\n    byRoom.get(a.roomId)!.push(a);\n  }\n  for (const list of byRoom.values()) {\n    list.sort((x, y) => x.startTime - y.startTime);\n    for (let i = 1; i < list.length; i++) {\n      expect(list[i].startTime - list[i - 1].endTime).toBeGreaterThanOrEqual(\n        gap,\n      );\n    }\n  }\n\n  // Prerequisites: if placed, prereq must be placed and end+gap <= start.\n  const assignmentById = new Map(res.assignments.map((a) => [a.eventId, a]));\n  for (const a of res.assignments) {\n    const ev = eventById.get(a.eventId)!;\n    for (const pid of ev.prerequisites ?? []) {\n      const pa = assignmentById.get(pid);\n      expect(pa, `prereq ${pid} of ${a.eventId} must be scheduled`).toBeDefined();\n      expect(pa!.endTime + gap).toBeLessThanOrEqual(a.startTime);\n    }\n  }\n}\n\n// ---------------------------------------------------------------------------\n// API / Exports\n// ---------------------------------------------------------------------------\n\ndescribe('API surface', () => {\n  const evs: Event[] = [{ id: 'a', name: 'A', duration: 60 }];\n  const rs = rooms(['r1', 10]);\n  const o = opts(540, 1020);\n\n  it('named export schedule works', () => {\n    const res = schedule(evs, rs, o);\n    expect(res).toHaveProperty('assignments');\n    expect(res).toHaveProperty('unscheduled');\n  });\n\n  it('default export works and matches named export', () => {\n    expect(scheduleDefault(evs, rs, o)).toEqual(schedule(evs, rs, o));\n  });\n\n  it('Scheduler class works', () => {\n    const s = new Scheduler();\n    expect(s.schedule(evs, rs, o)).toEqual(schedule(evs, rs, o));\n  });\n\n  it('createScheduler factory works', () => {\n    const s = createScheduler();\n    expect(s.schedule(evs, rs, o)).toEqual(schedule(evs, rs, o));\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Basic placement\n// ---------------------------------------------------------------------------\n\ndescribe('basic placement', () => {\n  it('places a single event within the window', () => {\n    const evs: Event[] = [{ id: 'a', name: 'A', duration: 60 }];\n    const rs = rooms(['r1', 10]);\n    const o = opts(540, 1020);\n    const res = schedule(evs, rs, o);\n    expect(res.assignments).toHaveLength(1);\n    expect(res.unscheduled).toHaveLength(0);\n    const a = res.assignments[0];\n    expect(a.startTime).toBeGreaterThanOrEqual(540);\n    expect(a.endTime).toBeLessThanOrEqual(1020);\n    expect(a.endTime - a.startTime).toBe(60);\n    assertValid(evs, rs, o, res);\n  });\n\n  it('attendees defaults to 1 (fits capacity-1 room)', () => {\n    const evs: Event[] = [{ id: 'a', name: 'A', duration: 30 }];\n    const rs = rooms(['r1', 1]);\n    const o = opts(0, 100);\n    const res = schedule(evs, rs, o);\n    expect(byId(res, 'a')).toBeDefined();\n  });\n\n  it('endTime == startTime + duration', () => {\n    const evs: Event[] = [{ id: 'a', name: 'A', duration: 45 }];\n    const res = schedule(evs, rooms(['r1', 5]), opts(600, 800));\n    const a = byId(res, 'a')!;\n    expect(a.endTime).toBe(a.startTime + 45);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Rule 1 — Room capacity\n// ---------------------------------------------------------------------------\n\ndescribe('rule 1: room capacity', () => {\n  it('event exceeding all capacities is unscheduled', () => {\n    const evs: Event[] = [\n      { id: 'big', name: 'Big', duration: 30, attendees: 100 },\n    ];\n    const rs = rooms(['r1', 10], ['r2', 50]);\n    const o = opts(0, 480);\n    const res = schedule(evs, rs, o);\n    expect(res.unscheduled).toContain('big');\n    expect(res.assignments).toHaveLength(0);\n    assertValid(evs, rs, o, res);\n  });\n\n  it('event placed only in a room with enough capacity', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 30, attendees: 40 },\n    ];\n    const rs = rooms(['small', 10], ['big', 50]);\n    const res = schedule(evs, rs, opts(0, 480));\n    expect(byId(res, 'a')!.roomId).toBe('big');\n  });\n\n  it('attendees == capacity boundary is allowed', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 30, attendees: 10 },\n    ];\n    const res = schedule(evs, rooms(['r1', 10]), opts(0, 480));\n    expect(byId(res, 'a')).toBeDefined();\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Rule 2 — Time window\n// ---------------------------------------------------------------------------\n\ndescribe('rule 2: time window', () => {\n  it('all assignments are within the window', () => {\n    const evs: Event[] = Array.from({ length: 6 }, (_, i) => ({\n      id: `e${i}`,\n      name: `E${i}`,\n      duration: 60,\n    }));\n    const rs = rooms(['r1', 5], ['r2', 5]);\n    const o = opts(540, 1020);\n    const res = schedule(evs, rs, o);\n    for (const a of res.assignments) {\n      expect(a.startTime).toBeGreaterThanOrEqual(540);\n      expect(a.endTime).toBeLessThanOrEqual(1020);\n    }\n    assertValid(evs, rs, o, res);\n  });\n\n  it('event longer than the window is unscheduled', () => {\n    const evs: Event[] = [{ id: 'a', name: 'A', duration: 500 }];\n    const rs = rooms(['r1', 5]);\n    const o = opts(540, 1020); // window is 480 minutes\n    const res = schedule(evs, rs, o);\n    expect(res.unscheduled).toContain('a');\n  });\n\n  it('event ending exactly at endTime is allowed (boundary)', () => {\n    const evs: Event[] = [{ id: 'a', name: 'A', duration: 480 }];\n    const rs = rooms(['r1', 5]);\n    const o = opts(540, 1020);\n    const res = schedule(evs, rs, o);\n    const a = byId(res, 'a')!;\n    expect(a.startTime).toBe(540);\n    expect(a.endTime).toBe(1020);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Rule 3 — Room gaps\n// ---------------------------------------------------------------------------\n\ndescribe('rule 3: room gaps', () => {\n  it('default gap of 15 separates co-room events', () => {\n    // One room, two events -> they must be 15 apart.\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 60, preferredRoom: 'r1' },\n      { id: 'b', name: 'B', duration: 60, preferredRoom: 'r1' },\n    ];\n    const rs = rooms(['r1', 5]);\n    const o = opts(540, 1020);\n    const res = schedule(evs, rs, o);\n    expect(res.assignments).toHaveLength(2);\n    assertValid(evs, rs, o, res);\n    const a = byId(res, 'a')!;\n    const b = byId(res, 'b')!;\n    const [first, second] = a.startTime < b.startTime ? [a, b] : [b, a];\n    expect(second.startTime - first.endTime).toBeGreaterThanOrEqual(15);\n  });\n\n  it('gap=0 allows back-to-back events', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60 },\n    ];\n    const rs = rooms(['r1', 5]); // single room forces co-location\n    const o = opts(540, 720, 0); // exactly fits two 60-min events back to back\n    const res = schedule(evs, rs, o);\n    expect(res.assignments).toHaveLength(2);\n    assertValid(evs, rs, o, res);\n  });\n\n  it('custom gap of 30 is respected', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 60, preferredRoom: 'r1' },\n      { id: 'b', name: 'B', duration: 60, preferredRoom: 'r1' },\n    ];\n    const rs = rooms(['r1', 5]);\n    const o = opts(540, 1020, 30);\n    const res = schedule(evs, rs, o);\n    assertValid(evs, rs, o, res);\n    const a = byId(res, 'a')!;\n    const b = byId(res, 'b')!;\n    const [first, second] = a.startTime < b.startTime ? [a, b] : [b, a];\n    expect(second.startTime - first.endTime).toBeGreaterThanOrEqual(30);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Rule 4 — Prerequisites\n// ---------------------------------------------------------------------------\n\ndescribe('rule 4: prerequisites', () => {\n  it('prerequisite finishes (plus gap) before dependent starts', () => {\n    const evs: Event[] = [\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n      { id: 'a', name: 'A', duration: 60 },\n    ];\n    const rs = rooms(['r1', 5], ['r2', 5]);\n    const o = opts(540, 1020);\n    const res = schedule(evs, rs, o);\n    assertValid(evs, rs, o, res);\n    const a = byId(res, 'a')!;\n    const b = byId(res, 'b')!;\n    expect(a.endTime + 15).toBeLessThanOrEqual(b.startTime);\n  });\n\n  it('dependent is unscheduled if prerequisite cannot be scheduled', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 30, attendees: 999 }, // can't fit\n      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },\n    ];\n    const rs = rooms(['r1', 10]);\n    const o = opts(0, 480);\n    const res = schedule(evs, rs, o);\n    expect(res.unscheduled).toContain('a');\n    expect(res.unscheduled).toContain('b');\n    assertValid(evs, rs, o, res);\n  });\n\n  it('unknown prerequisite id => event unscheduled, no throw', () => {\n    const evs: Event[] = [\n      { id: 'b', name: 'B', duration: 30, prerequisites: ['ghost'] },\n    ];\n    const rs = rooms(['r1', 10]);\n    const o = opts(0, 480);\n    const res = schedule(evs, rs, o);\n    expect(res.unscheduled).toContain('b');\n    expect(res.assignments).toHaveLength(0);\n  });\n\n  it('chain A->B->C respects ordering with gaps', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 60, prerequisites: ['b'] },\n    ];\n    const rs = rooms(['r1', 5], ['r2', 5], ['r3', 5]);\n    const o = opts(0, 600);\n    const res = schedule(evs, rs, o);\n    expect(res.assignments).toHaveLength(3);\n    assertValid(evs, rs, o, res);\n    const a = byId(res, 'a')!;\n    const b = byId(res, 'b')!;\n    const c = byId(res, 'c')!;\n    expect(a.endTime + 15).toBeLessThanOrEqual(b.startTime);\n    expect(b.endTime + 15).toBeLessThanOrEqual(c.startTime);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Rule 5 — Preferred room\n// ---------------------------------------------------------------------------\n\ndescribe('rule 5: preferred room', () => {\n  it('honors preferred room when feasible', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 60, preferredRoom: 'r2' },\n    ];\n    const rs = rooms(['r1', 10], ['r2', 10]);\n    const o = opts(540, 1020);\n    const res = schedule(evs, rs, o);\n    expect(byId(res, 'a')!.roomId).toBe('r2');\n  });\n\n  it('preferred room is only a hint when infeasible there', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 60, attendees: 40, preferredRoom: 'small' },\n    ];\n    const rs = rooms(['small', 10], ['big', 50]);\n    const o = opts(540, 1020);\n    const res = schedule(evs, rs, o);\n    // Still scheduled, just not in the (too-small) preferred room.\n    expect(byId(res, 'a')!.roomId).toBe('big');\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Rule 6 — Cycles\n// ---------------------------------------------------------------------------\n\ndescribe('rule 6: prerequisite cycles throw', () => {\n  it('self-reference A->A throws', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 30, prerequisites: ['a'] },\n    ];\n    expect(() => schedule(evs, rooms(['r1', 5]), opts(0, 480))).toThrow();\n  });\n\n  it('two-node cycle A->B->A throws', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 30, prerequisites: ['b'] },\n      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },\n    ];\n    expect(() => schedule(evs, rooms(['r1', 5]), opts(0, 480))).toThrow();\n  });\n\n  it('longer cycle A->B->C->A throws', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 30, prerequisites: ['c'] },\n      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 30, prerequisites: ['b'] },\n    ];\n    expect(() => schedule(evs, rooms(['r1', 5]), opts(0, 480))).toThrow();\n  });\n\n  it('valid DAG does not throw', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 30 },\n      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 30, prerequisites: ['a', 'b'] },\n    ];\n    expect(() => schedule(evs, rooms(['r1', 5]), opts(0, 480))).not.toThrow();\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Rule 7 — Batch optimization (maximize)\n// ---------------------------------------------------------------------------\n\ndescribe('rule 7: maximize scheduled count', () => {\n  it('beats naive in-order placement', () => {\n    // Window is 0..120 with gap 0. One room.\n    // If we naively place the 120-min event first, it consumes the whole\n    // window and the two 60-min events cannot fit. The optimal solution skips\n    // the long event and schedules both short ones (count 2 > count 1).\n    const evs: Event[] = [\n      { id: 'long', name: 'Long', duration: 120 },\n      { id: 's1', name: 'S1', duration: 60 },\n      { id: 's2', name: 'S2', duration: 60 },\n    ];\n    const rs = rooms(['r1', 5]);\n    const o = opts(0, 120, 0);\n    const res = schedule(evs, rs, o);\n    expect(res.assignments).toHaveLength(2);\n    expect(byId(res, 's1')).toBeDefined();\n    expect(byId(res, 's2')).toBeDefined();\n    expect(res.unscheduled).toEqual(['long']);\n    assertValid(evs, rs, o, res);\n  });\n\n  it('schedules everything when capacity allows', () => {\n    const evs: Event[] = Array.from({ length: 4 }, (_, i) => ({\n      id: `e${i}`,\n      name: `E${i}`,\n      duration: 30,\n    }));\n    const rs = rooms(['r1', 5], ['r2', 5]);\n    const o = opts(540, 1020);\n    const res = schedule(evs, rs, o);\n    expect(res.unscheduled).toHaveLength(0);\n    assertValid(evs, rs, o, res);\n  });\n\n  it('over-subscribed window leaves some unscheduled, rest valid', () => {\n    // Single room, window fits at most 2 of these (with gap 15).\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 90 },\n      { id: 'b', name: 'B', duration: 90 },\n      { id: 'c', name: 'C', duration: 90 },\n    ];\n    const rs = rooms(['r1', 5]);\n    const o = opts(0, 200, 15); // 90 + 15 + 90 = 195 <= 200 -> 2 fit, not 3\n    const res = schedule(evs, rs, o);\n    expect(res.assignments).toHaveLength(2);\n    expect(res.unscheduled).toHaveLength(1);\n    assertValid(evs, rs, o, res);\n  });\n\n  it('packs across two rooms to maximize', () => {\n    // 4 events of 90 min, window 0..200, gap 15 => 2 per room, 2 rooms => 4.\n    const evs: Event[] = Array.from({ length: 4 }, (_, i) => ({\n      id: `e${i}`,\n      name: `E${i}`,\n      duration: 90,\n    }));\n    const rs = rooms(['r1', 5], ['r2', 5]);\n    const o = opts(0, 200, 15);\n    const res = schedule(evs, rs, o);\n    expect(res.assignments).toHaveLength(4);\n    assertValid(evs, rs, o, res);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// General invariants / edge cases\n// ---------------------------------------------------------------------------\n\ndescribe('edge cases & invariants', () => {\n  it('empty events => empty result', () => {\n    expect(schedule([], rooms(['r1', 5]), opts(0, 480))).toEqual({\n      assignments: [],\n      unscheduled: [],\n    });\n  });\n\n  it('no rooms => everything unscheduled', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 30 },\n      { id: 'b', name: 'B', duration: 30 },\n    ];\n    const res = schedule(evs, [], opts(0, 480));\n    expect(res.assignments).toHaveLength(0);\n    expect(res.unscheduled.sort()).toEqual(['a', 'b']);\n  });\n\n  it('does not mutate input arrays or objects', () => {\n    const evs: Event[] = [\n      { id: 'a', name: 'A', duration: 60, prerequisites: ['b'] },\n      { id: 'b', name: 'B', duration: 60 },\n    ];\n    const rs = rooms(['r1', 5]);\n    const o = opts(540, 1020, 20);\n    const evsCopy = JSON.parse(JSON.stringify(evs));\n    const rsCopy = JSON.parse(JSON.stringify(rs));\n    const oCopy = JSON.parse(JSON.stringify(o));\n    schedule(evs, rs, o);\n    expect(evs).toEqual(evsCopy);\n    expect(rs).toEqual(rsCopy);\n    expect(o).toEqual(oCopy);\n  });\n\n  it('every id partitioned exactly once across many events', () => {\n    const evs: Event[] = Array.from({ length: 20 }, (_, i) => ({\n      id: `e${i}`,\n      name: `E${i}`,\n      duration: 40 + (i % 3) * 20,\n      attendees: 1 + (i % 4),\n    }));\n    const rs = rooms(['r1', 5], ['r2', 3]);\n    const o = opts(540, 1020);\n    const res = schedule(evs, rs, o);\n    assertValid(evs, rs, o, res);\n    const all = new Set([\n      ...res.assignments.map((a) => a.eventId),\n      ...res.unscheduled,\n    ]);\n    expect(all.size).toBe(20);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
