+// Constraint-based event scheduler.
+//
+// Assigns events to rooms within a time window while respecting room
+// capacity, prerequisite ordering (with gaps), minimum room gaps and room
+// preferences. The placement is computed with a branch-and-bound search that
+// maximizes the number of scheduled events (with honoring `preferredRoom` as a
+// secondary objective), falling back to the best solution found so far if the
+// search budget is exhausted.
+
+export interface Event {
+  id: string;
+  name: string;
+  duration: number; // in minutes
+  attendees?: number; // number of people attending (default: 1)
+  prerequisites?: string[]; // event IDs that must finish before this starts
+  preferredRoom?: string; // room ID preference (hint, not hard constraint)
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number; // max attendees
+}
+
+export interface ScheduleOptions {
+  startTime: number; // minutes from midnight (e.g., 540 = 9:00 AM)
+  endTime: number; // minutes from midnight (e.g., 1020 = 5:00 PM)
+  gap?: number; // minimum gap in minutes between events in same room (default: 15)
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number; // minutes from midnight
+  endTime: number; // minutes from midnight
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[]; // event IDs that could not be scheduled
+}
+
+const DEFAULT_GAP = 15;
+const DEFAULT_ATTENDEES = 1;
+
+// Upper bound on search-node expansions. Guarantees termination on adversarial
+// inputs while leaving plenty of headroom for an exact answer on normal ones.
+const SEARCH_NODE_BUDGET = 300_000;
+
+interface PlacedInterval {
+  start: number;
+  end: number;
+}
+
+interface Placement {
+  roomId: string;
+  start: number;
+  end: number;
+}
+
+/**
+ * Detect a cycle (including self-references) in the prerequisite graph.
+ * Throws an Error if one is found. Only edges between known events are
+ * considered; references to unknown ids are treated as leaves.
+ */
+function assertNoCycles(events: Event[]): void {
+  const ids = new Set(events.map((e) => e.id));
+  const adjacency = new Map<string, string[]>();
+  for (const event of events) {
+    const prereqs = (event.prerequisites ?? []).filter((p) => ids.has(p));
+    adjacency.set(event.id, prereqs);
+  }
+
+  // 0 = unvisited, 1 = in progress (on the current DFS stack), 2 = done.
+  const state = new Map<string, number>();
+  for (const id of ids) state.set(id, 0);
+
+  // Iterative DFS to avoid stack overflow on long chains.
+  for (const start of ids) {
+    if (state.get(start) !== 0) continue;
+    const stack: Array<{ node: string; iter: number }> = [{ node: start, iter: 0 }];
+    state.set(start, 1);
+    while (stack.length > 0) {
+      const frame = stack[stack.length - 1];
+      const neighbors = adjacency.get(frame.node) ?? [];
+      if (frame.iter < neighbors.length) {
+        const next = neighbors[frame.iter];
+        frame.iter += 1;
+        const s = state.get(next);
+        if (s === 1) {
+          throw new Error(
+            `Prerequisite cycle detected involving event "${next}"`,
+          );
+        }
+        if (s === 0) {
+          state.set(next, 1);
+          stack.push({ node: next, iter: 0 });
+        }
+      } else {
+        state.set(frame.node, 2);
+        stack.pop();
+      }
+    }
+  }
+}
+
+/**
+ * Topologically order events so that every event appears after all of its
+ * (known) prerequisites. The graph is assumed acyclic (checked beforehand).
+ * Independent events keep a stable, deterministic ordering.
+ */
+function topologicalOrder(events: Event[]): Event[] {
+  const ids = new Set(events.map((e) => e.id));
+  const byId = new Map(events.map((e) => [e.id, e]));
+  const indegree = new Map<string, number>();
+  const dependents = new Map<string, string[]>();
+
+  for (const event of events) {
+    indegree.set(event.id, 0);
+    dependents.set(event.id, []);
+  }
+  for (const event of events) {
+    const prereqs = (event.prerequisites ?? []).filter((p) => ids.has(p));
+    indegree.set(event.id, prereqs.length);
+    for (const p of prereqs) {
+      dependents.get(p)!.push(event.id);
+    }
+  }
+
+  // Kahn's algorithm. Use the original input order as the tie-breaker so the
+  // output is deterministic.
+  const inputIndex = new Map(events.map((e, i) => [e.id, i]));
+  const ready: string[] = [];
+  for (const event of events) {
+    if (indegree.get(event.id) === 0) ready.push(event.id);
+  }
+  ready.sort((a, b) => inputIndex.get(a)! - inputIndex.get(b)!);
+
+  const order: Event[] = [];
+  while (ready.length > 0) {
+    const id = ready.shift()!;
+    order.push(byId.get(id)!);
+    for (const dep of dependents.get(id)!) {
+      const d = indegree.get(dep)! - 1;
+      indegree.set(dep, d);
+      if (d === 0) {
+        // Insert keeping input-order stability.
+        const idx = inputIndex.get(dep)!;
+        let lo = 0;
+        let hi = ready.length;
+        while (lo < hi) {
+          const mid = (lo + hi) >> 1;
+          if (inputIndex.get(ready[mid])! < idx) lo = mid + 1;
+          else hi = mid;
+        }
+        ready.splice(lo, 0, dep);
+      }
+    }
+  }
+  return order;
+}
+
+/**
+ * Enumerate left-aligned candidate start times for an event of the given
+ * duration in a room, honoring `gap` separation from already-placed intervals
+ * and a minimum start time. Left-aligning within each free slot is sufficient
+ * to reach a maximum-count placement.
+ */
+function candidateStarts(
+  placed: PlacedInterval[],
+  duration: number,
+  minStart: number,
+  windowEnd: number,
+  gap: number,
+): number[] {
+  const anchors: number[] = [minStart];
+  for (const iv of placed) {
+    const after = iv.end + gap;
+    if (after >= minStart) anchors.push(after);
+  }
+
+  const seen = new Set<number>();
+  const result: number[] = [];
+  for (const start of anchors) {
+    if (start < minStart) continue;
+    const end = start + duration;
+    if (end > windowEnd) continue;
+    if (seen.has(start)) continue;
+    // Feasible if it conflicts with no placed interval (respecting gap).
+    let ok = true;
+    for (const iv of placed) {
+      if (start >= iv.end + gap || end + gap <= iv.start) continue;
+      ok = false;
+      break;
+    }
+    if (ok) {
+      seen.add(start);
+      result.push(start);
+    }
+  }
+  result.sort((a, b) => a - b);
+  return result;
+}
+
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  if (!Array.isArray(events)) {
+    throw new TypeError('events must be an array');
+  }
+  if (!Array.isArray(rooms)) {
+    throw new TypeError('rooms must be an array');
+  }
+  if (!options || typeof options.startTime !== 'number' || typeof options.endTime !== 'number') {
+    throw new TypeError('options.startTime and options.endTime are required numbers');
+  }
+
+  const gap = options.gap ?? DEFAULT_GAP;
+  const { startTime, endTime } = options;
+
+  // Cycle detection always runs first — even for inputs that would otherwise be
+  // trivially empty — so malformed graphs are reported.
+  assertNoCycles(events);
+
+  const allIds = events.map((e) => e.id);
+
+  if (events.length === 0) {
+    return { assignments: [], unscheduled: [] };
+  }
+
+  const order = topologicalOrder(events);
+  const attendeesOf = (e: Event): number => e.attendees ?? DEFAULT_ATTENDEES;
+
+  // Precompute, per event, the rooms that can physically hold it (capacity).
+  const feasibleRooms = new Map<string, Room[]>();
+  for (const event of events) {
+    const need = attendeesOf(event);
+    const okRooms = rooms.filter((r) => r.capacity >= need);
+    feasibleRooms.set(event.id, okRooms);
+  }
+
+  // Search state.
+  const roomTimelines = new Map<string, PlacedInterval[]>();
+  for (const room of rooms) roomTimelines.set(room.id, []);
+  const placement = new Map<string, Placement | null>();
+
+  let bestScore = -1;
+  let bestPlacement = new Map<string, Placement | null>();
+  let nodes = 0;
+  let budgetExhausted = false;
+
+  const COUNT_WEIGHT = 1_000_000;
+
+  const currentScore = (): number => {
+    let count = 0;
+    let pref = 0;
+    for (const event of events) {
+      const p = placement.get(event.id);
+      if (p) {
+        count += 1;
+        if (event.preferredRoom !== undefined && p.roomId === event.preferredRoom) {
+          pref += 1;
+        }
+      }
+    }
+    return count * COUNT_WEIGHT + pref;
+  };
+
+  const recordIfBest = (): void => {
+    const score = currentScore();
+    if (score > bestScore) {
+      bestScore = score;
+      bestPlacement = new Map(placement);
+    }
+  };
+
+  // Minimum start time for an event given the placed end times of its
+  // prerequisites (plus gap) and the window start.
+  const minStartFor = (event: Event): number | null => {
+    let minStart = startTime;
+    for (const prereqId of event.prerequisites ?? []) {
+      const p = placement.get(prereqId);
+      if (!p) {
+        // Prerequisite not (yet) placed — event is not placeable now.
+        return null;
+      }
+      minStart = Math.max(minStart, p.end + gap);
+    }
+    return minStart;
+  };
+
+  const insertInterval = (roomId: string, iv: PlacedInterval): void => {
+    const list = roomTimelines.get(roomId)!;
+    let lo = 0;
+    let hi = list.length;
+    while (lo < hi) {
+      const mid = (lo + hi) >> 1;
+      if (list[mid].start < iv.start) lo = mid + 1;
+      else hi = mid;
+    }
+    list.splice(lo, 0, iv);
+  };
+
+  const removeInterval = (roomId: string, iv: PlacedInterval): void => {
+    const list = roomTimelines.get(roomId)!;
+    const idx = list.indexOf(iv);
+    if (idx >= 0) list.splice(idx, 1);
+  };
+
+  // Branch and bound over events in topological order. At each event we try
+  // every feasible placement (preferred room first) and also the option of
+  // leaving it unscheduled.
+  const solve = (index: number, placedCount: number): void => {
+    if (budgetExhausted) return;
+    if (nodes++ > SEARCH_NODE_BUDGET) {
+      budgetExhausted = true;
+      return;
+    }
+
+    if (index === order.length) {
+      recordIfBest();
+      return;
+    }
+
+    // Bound: even if every remaining event is placed in its preferred room we
+    // cannot exceed this score. Prune branches that cannot beat the best.
+    const remaining = order.length - index;
+    const optimisticCount = placedCount + remaining;
+    const optimisticScore = optimisticCount * COUNT_WEIGHT + optimisticCount;
+    if (optimisticScore <= bestScore) return;
+
+    const event = order[index];
+    const minStart = minStartFor(event);
+    const duration = event.duration;
+
+    interface Candidate {
+      room: Room;
+      start: number;
+      end: number;
+      preferred: boolean;
+    }
+    const candidates: Candidate[] = [];
+
+    if (minStart !== null && duration <= endTime - startTime) {
+      for (const room of feasibleRooms.get(event.id)!) {
+        const placed = roomTimelines.get(room.id)!;
+        const starts = candidateStarts(placed, duration, minStart, endTime, gap);
+        const preferred = event.preferredRoom !== undefined && room.id === event.preferredRoom;
+        for (const s of starts) {
+          candidates.push({ room, start: s, end: s + duration, preferred });
+        }
+      }
+    }
+
+    // Order placements: preferred room first, then earliest finishing (leaves
+    // the most room for later events).
+    candidates.sort((a, b) => {
+      if (a.preferred !== b.preferred) return a.preferred ? -1 : 1;
+      if (a.end !== b.end) return a.end - b.end;
+      return a.start - b.start;
+    });
+
+    for (const cand of candidates) {
+      const iv: PlacedInterval = { start: cand.start, end: cand.end };
+      insertInterval(cand.room.id, iv);
+      placement.set(event.id, {
+        roomId: cand.room.id,
+        start: cand.start,
+        end: cand.end,
+      });
+      solve(index + 1, placedCount + 1);
+      placement.set(event.id, null);
+      removeInterval(cand.room.id, iv);
+      if (budgetExhausted) return;
+    }
+
+    // Option: leave this event unscheduled.
+    placement.set(event.id, null);
+    solve(index + 1, placedCount);
+  };
+
+  for (const event of events) placement.set(event.id, null);
+  solve(0, 0);
+
+  // Build the result from the best placement found.
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+  for (const id of allIds) {
+    const p = bestPlacement.get(id) ?? null;
+    if (p) {
+      assignments.push({
+        eventId: id,
+        roomId: p.roomId,
+        startTime: p.start,
+        endTime: p.end,
+      });
+    } else {
+      unscheduled.push(id);
+    }
+  }
+
+  return { assignments, unscheduled };
+}
+
+export class Scheduler {
+  schedule(
+    events: Event[],
+    rooms: Room[],
+    options: ScheduleOptions,
+  ): ScheduleResult {
+    return schedule(events, rooms, options);
+  }
+}
+
+export function createScheduler(): Scheduler {
+  return new Scheduler();
+}
+
+export default schedule;
