index 0000000..8da720a
--- /dev/null
+++ b/src/scheduler.ts
@@ -0,0 +1,478 @@
+import type {
+  Event,
+  Room,
+  ScheduleOptions,
+  Assignment,
+  ScheduleResult,
+} from './types.js';
+
+const DEFAULT_GAP = 15;
+const DEFAULT_ATTENDEES = 1;
+
+interface PlacedInterval {
+  start: number;
+  end: number;
+}
+
+/**
+ * Detect a cycle in the prerequisite graph (including self-references).
+ * Edge A -> P means "A depends on prerequisite P". A cycle means a set of
+ * events mutually require each other, which can never be scheduled.
+ * Throws an Error if a cycle is found. Only edges to existing events are
+ * traversed (a self-reference still produces a back-edge and is caught).
+ */
+function assertNoCycles(events: Event[]): void {
+  const ids = new Set(events.map((e) => e.id));
+  const adj = new Map<string, string[]>();
+  for (const e of events) {
+    const deps = (e.prerequisites ?? []).filter((p) => ids.has(p));
+    adj.set(e.id, deps);
+  }
+
+  // 0 = unvisited, 1 = in progress (on stack), 2 = done
+  const state = new Map<string, number>();
+  for (const id of ids) state.set(id, 0);
+
+  const visit = (id: string, path: string[]): void => {
+    state.set(id, 1);
+    path.push(id);
+    for (const dep of adj.get(id) ?? []) {
+      const s = state.get(dep);
+      if (s === 1) {
+        const cycleStart = path.indexOf(dep);
+        const cycle = path.slice(cycleStart).concat(dep);
+        throw new Error(
+          `Prerequisite cycle detected: ${cycle.join(' -> ')}`
+        );
+      }
+      if (s === 0) visit(dep, path);
+    }
+    path.pop();
+    state.set(id, 2);
+  };
+
+  for (const id of ids) {
+    if (state.get(id) === 0) visit(id, []);
+  }
+}
+
+/**
+ * Find the earliest valid start time for an event in a given room such that:
+ *  - start >= earliestStart (already accounts for window start + prereqs)
+ *  - the [start, start+duration] interval stays within the window end
+ *  - the interval keeps `gap` minutes from every already-placed interval.
+ * Returns the start time, or null if no valid slot exists.
+ */
+function earliestStartInRoom(
+  duration: number,
+  earliestStart: number,
+  windowEnd: number,
+  gap: number,
+  placed: PlacedInterval[]
+): number | null {
+  // Candidate start positions are earliestStart itself and the moment just
+  // after each placed interval ends (+gap). The earliest feasible placement
+  // always begins at one of these points.
+  const candidates = [earliestStart];
+  for (const p of placed) {
+    const after = p.end + gap;
+    if (after > earliestStart) candidates.push(after);
+  }
+  candidates.sort((a, b) => a - b);
+
+  for (const start of candidates) {
+    const end = start + duration;
+    if (start < earliestStart) continue;
+    if (end > windowEnd) continue;
+    let ok = true;
+    for (const p of placed) {
+      // Compatible iff fully after (start >= p.end+gap) or fully before
+      // (end <= p.start-gap). Otherwise it conflicts.
+      if (!(start >= p.end + gap || end <= p.start - gap)) {
+        ok = false;
+        break;
+      }
+    }
+    if (ok) return start;
+  }
+  return null;
+}
+
+interface Candidate {
+  roomId: string;
+  start: number;
+  end: number;
+  capacity: number;
+  isPreferred: boolean;
+}
+
+interface RunStrategy {
+  // priority among events that are "ready" (all prereqs already processed);
+  // lower value = scheduled earlier.
+  eventKey: (e: Event, ctx: OrderContext) => number[];
+  // pick the best room candidate among feasible ones.
+  pickRoom: (cands: Candidate[]) => Candidate;
+}
+
+interface OrderContext {
+  index: Map<string, number>;
+  dependents: Map<string, number>;
+}
+
+function attendeesOf(e: Event): number {
+  return e.attendees ?? DEFAULT_ATTENDEES;
+}
+
+// Room pickers ---------------------------------------------------------------
+
+function pickEarliestThenSmallest(cands: Candidate[]): Candidate {
+  return [...cands].sort(
+    (a, b) =>
+      Number(b.isPreferred) - Number(a.isPreferred) ||
+      a.start - b.start ||
+      a.capacity - b.capacity ||
+      a.roomId.localeCompare(b.roomId)
+  )[0];
+}
+
+function pickBestFitCapacity(cands: Candidate[]): Candidate {
+  // Prefer the smallest-capacity room that fits, preserving large rooms.
+  return [...cands].sort(
+    (a, b) =>
+      Number(b.isPreferred) - Number(a.isPreferred) ||
+      a.capacity - b.capacity ||
+      a.start - b.start ||
+      a.roomId.localeCompare(b.roomId)
+  )[0];
+}
+
+// Event orderings ------------------------------------------------------------
+
+const orderByInput = (e: Event, ctx: OrderContext): number[] => [
+  ctx.index.get(e.id) ?? 0,
+];
+const orderByDurationDesc = (e: Event, ctx: OrderContext): number[] => [
+  -e.duration,
+  ctx.index.get(e.id) ?? 0,
+];
+const orderByAttendeesDesc = (e: Event, ctx: OrderContext): number[] => [
+  -attendeesOf(e),
+  -e.duration,
+  ctx.index.get(e.id) ?? 0,
+];
+const orderByDependentsDesc = (e: Event, ctx: OrderContext): number[] => [
+  -(ctx.dependents.get(e.id) ?? 0),
+  -e.duration,
+  ctx.index.get(e.id) ?? 0,
+];
+const orderByDurationAsc = (e: Event, ctx: OrderContext): number[] => [
+  e.duration,
+  ctx.index.get(e.id) ?? 0,
+];
+
+const STRATEGIES: RunStrategy[] = [];
+for (const pickRoom of [pickEarliestThenSmallest, pickBestFitCapacity]) {
+  for (const eventKey of [
+    orderByInput,
+    orderByDurationDesc,
+    orderByAttendeesDesc,
+    orderByDependentsDesc,
+    orderByDurationAsc,
+  ]) {
+    STRATEGIES.push({ eventKey, pickRoom });
+  }
+}
+
+function compareKeys(a: number[], b: number[]): number {
+  const n = Math.max(a.length, b.length);
+  for (let i = 0; i < n; i++) {
+    const av = a[i] ?? 0;
+    const bv = b[i] ?? 0;
+    if (av !== bv) return av - bv;
+  }
+  return 0;
+}
+
+interface RunResult {
+  assignments: Assignment[];
+  unscheduledCount: number;
+  preferredHonored: number;
+  totalEnd: number;
+}
+
+/**
+ * Run one greedy pass with the given strategy. Events are processed in a
+ * prerequisite-respecting order (Kahn's algorithm driven by the strategy's
+ * priority). Each event is placed at the earliest feasible slot in the best
+ * room. Events that cannot be placed — or whose prerequisites failed — are
+ * marked unscheduled.
+ */
+function runStrategy(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  strategy: RunStrategy,
+  ctx: OrderContext,
+  existingIds: Set<string>
+): RunResult {
+  const gap = options.gap ?? DEFAULT_GAP;
+  const windowStart = options.startTime;
+  const windowEnd = options.endTime;
+
+  const eventMap = new Map(events.map((e) => [e.id, e]));
+
+  // Build dependency bookkeeping for a Kahn-style ordering. An event becomes
+  // "ready" once all its (existing) prerequisites have been processed.
+  const remainingPrereqs = new Map<string, number>();
+  const dependentsOf = new Map<string, string[]>();
+  // events that can never be scheduled because a prerequisite is missing.
+  const hasMissingPrereq = new Set<string>();
+
+  for (const e of events) {
+    const prereqs = e.prerequisites ?? [];
+    let count = 0;
+    for (const p of prereqs) {
+      if (!existingIds.has(p)) {
+        hasMissingPrereq.add(e.id);
+        continue;
+      }
+      count++;
+      if (!dependentsOf.has(p)) dependentsOf.set(p, []);
+      dependentsOf.get(p)!.push(e.id);
+    }
+    remainingPrereqs.set(e.id, count);
+  }
+
+  const placedByRoom = new Map<string, PlacedInterval[]>();
+  for (const r of rooms) placedByRoom.set(r.id, []);
+
+  const assignments = new Map<string, Assignment>();
+  const failed = new Set<string>();
+
+  // ready set: events with no remaining prerequisites and not failed.
+  const ready: string[] = [];
+  for (const e of events) {
+    if ((remainingPrereqs.get(e.id) ?? 0) === 0 && !hasMissingPrereq.has(e.id)) {
+      ready.push(e.id);
+    }
+  }
+
+  const markFailed = (id: string): void => {
+    if (failed.has(id) || assignments.has(id)) return;
+    failed.add(id);
+    // cascade: dependents can never satisfy this prerequisite.
+    for (const dep of dependentsOf.get(id) ?? []) {
+      markFailed(dep);
+    }
+  };
+
+  // events with a missing prerequisite fail immediately (and cascade).
+  for (const id of hasMissingPrereq) markFailed(id);
+
+  const popReady = (): string | null => {
+    let bestIdx = -1;
+    let bestKey: number[] | null = null;
+    for (let i = 0; i < ready.length; i++) {
+      const ev = eventMap.get(ready[i])!;
+      const key = strategy.eventKey(ev, ctx);
+      if (bestKey === null || compareKeys(key, bestKey) < 0) {
+        bestKey = key;
+        bestIdx = i;
+      }
+    }
+    if (bestIdx === -1) return null;
+    const id = ready[bestIdx];
+    ready.splice(bestIdx, 1);
+    return id;
+  };
+
+  while (ready.length > 0) {
+    const id = popReady();
+    if (id === null) break;
+    if (failed.has(id) || assignments.has(id)) continue;
+    const ev = eventMap.get(id)!;
+
+    // earliest start = window start, raised by each prerequisite's end + gap.
+    let earliest = windowStart;
+    let prereqFailed = false;
+    for (const p of ev.prerequisites ?? []) {
+      const pa = assignments.get(p);
+      if (!pa) {
+        prereqFailed = true;
+        break;
+      }
+      earliest = Math.max(earliest, pa.endTime + gap);
+    }
+    if (prereqFailed) {
+      markFailed(id);
+      continue;
+    }
+
+    const attendees = attendeesOf(ev);
+    const cands: Candidate[] = [];
+    for (const room of rooms) {
+      if (attendees > room.capacity) continue;
+      const start = earliestStartInRoom(
+        ev.duration,
+        earliest,
+        windowEnd,
+        gap,
+        placedByRoom.get(room.id)!
+      );
+      if (start === null) continue;
+      cands.push({
+        roomId: room.id,
+        start,
+        end: start + ev.duration,
+        capacity: room.capacity,
+        isPreferred: ev.preferredRoom === room.id,
+      });
+    }
+
+    if (cands.length === 0) {
+      markFailed(id);
+      continue;
+    }
+
+    const chosen = strategy.pickRoom(cands);
+    assignments.set(id, {
+      eventId: id,
+      roomId: chosen.roomId,
+      startTime: chosen.start,
+      endTime: chosen.end,
+    });
+    placedByRoom
+      .get(chosen.roomId)!
+      .push({ start: chosen.start, end: chosen.end });
+
+    // release dependents whose prerequisites are now all processed.
+    for (const dep of dependentsOf.get(id) ?? []) {
+      const rem = (remainingPrereqs.get(dep) ?? 0) - 1;
+      remainingPrereqs.set(dep, rem);
+      if (rem === 0 && !failed.has(dep) && !hasMissingPrereq.has(dep)) {
+        ready.push(dep);
+      }
+    }
+  }
+
+  // any event neither assigned nor explicitly failed could not be reached
+  // (e.g. its prerequisite failed); treat as unscheduled.
+  let preferredHonored = 0;
+  let totalEnd = 0;
+  for (const a of assignments.values()) {
+    totalEnd += a.endTime;
+    const ev = eventMap.get(a.eventId)!;
+    if (ev.preferredRoom && ev.preferredRoom === a.roomId) preferredHonored++;
+  }
+
+  const unscheduledCount = events.length - assignments.size;
+
+  return {
+    assignments: [...assignments.values()],
+    unscheduledCount,
+    preferredHonored,
+    totalEnd,
+  };
+}
+
+/**
+ * Schedule events into rooms within the time window, honoring capacity,
+ * prerequisite ordering, room gaps, and (softly) preferred rooms, while
+ * maximizing the number of events scheduled.
+ */
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions
+): ScheduleResult {
+  // Validate prerequisite graph first — cycles are a hard error.
+  assertNoCycles(events);
+
+  if (events.length === 0) {
+    return { assignments: [], unscheduled: [] };
+  }
+
+  const existingIds = new Set(events.map((e) => e.id));
+
+  // Precompute ordering context shared across strategies.
+  const index = new Map<string, number>();
+  events.forEach((e, i) => index.set(e.id, i));
+
+  // dependents count = transitive number of events that depend on each event
+  // (how many others it could unlock). Computed via reverse reachability.
+  const directDependents = new Map<string, string[]>();
+  for (const e of events) {
+    for (const p of e.prerequisites ?? []) {
+      if (!existingIds.has(p)) continue;
+      if (!directDependents.has(p)) directDependents.set(p, []);
+      directDependents.get(p)!.push(e.id);
+    }
+  }
+  const dependents = new Map<string, number>();
+  const countDependents = (id: string): number => {
+    const seen = new Set<string>();
+    const stack = [...(directDependents.get(id) ?? [])];
+    while (stack.length) {
+      const cur = stack.pop()!;
+      if (seen.has(cur)) continue;
+      seen.add(cur);
+      for (const d of directDependents.get(cur) ?? []) stack.push(d);
+    }
+    return seen.size;
+  };
+  for (const e of events) dependents.set(e.id, countDependents(e.id));
+
+  const ctx: OrderContext = { index, dependents };
+
+  let best: RunResult | null = null;
+  for (const strategy of STRATEGIES) {
+    const result = runStrategy(events, rooms, options, strategy, ctx, existingIds);
+    if (best === null || isBetter(result, best)) {
+      best = result;
+    }
+  }
+
+  const scheduledIds = new Set(best!.assignments.map((a) => a.eventId));
+  const unscheduled = events
+    .map((e) => e.id)
+    .filter((id) => !scheduledIds.has(id));
+
+  // Stable output ordering for assignments: by start time then room.
+  const assignments = [...best!.assignments].sort(
+    (a, b) =>
+      a.startTime - b.startTime ||
+      a.roomId.localeCompare(b.roomId) ||
+      a.eventId.localeCompare(b.eventId)
+  );
+
+  return { assignments, unscheduled };
+}
+
+function isBetter(a: RunResult, b: RunResult): boolean {
+  // More scheduled wins; then more preferred rooms honored; then earlier finish.
+  if (a.assignments.length !== b.assignments.length) {
+    return a.assignments.length > b.assignments.length;
+  }
+  if (a.preferredHonored !== b.preferredHonored) {
+    return a.preferredHonored > b.preferredHonored;
+  }
+  return a.totalEnd < b.totalEnd;
+}
+
+/** Class-based wrapper around {@link schedule}. */
+export class Scheduler {
+  schedule(
+    events: Event[],
+    rooms: Room[],
+    options: ScheduleOptions
+  ): ScheduleResult {
+    return schedule(events, rooms, options);
+  }
+}
+
+/** Factory returning a {@link Scheduler} instance. */
+export function createScheduler(): Scheduler {
+  return new Scheduler();
+}
+
+export default schedule;
