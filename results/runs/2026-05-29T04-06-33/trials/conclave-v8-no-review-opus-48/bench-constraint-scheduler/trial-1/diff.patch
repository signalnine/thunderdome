+// --- Generic validator: asserts a result obeys every hard constraint ---
+function validate(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  result: ScheduleResult
+): void {
+  const gap = options.gap ?? 15;
+  const eventMap = new Map(events.map((e) => [e.id, e]));
+  const roomMap = new Map(rooms.map((r) => [r.id, r]));
+  const assignMap = new Map(result.assignments.map((a) => [a.eventId, a]));
+
+  // B8: every event accounted for exactly once
+  const allIds = events.map((e) => e.id);
+  const seen = new Set<string>();
+  for (const a of result.assignments) {
+    expect(seen.has(a.eventId)).toBe(false);
+    seen.add(a.eventId);
+  }
+  for (const id of result.unscheduled) {
+    expect(seen.has(id)).toBe(false);
+    seen.add(id);
+  }
+  expect(seen.size).toBe(allIds.length);
+  for (const id of allIds) expect(seen.has(id)).toBe(true);
+
+  for (const a of result.assignments) {
+    const ev = eventMap.get(a.eventId)!;
+    const room = roomMap.get(a.roomId)!;
+    expect(room).toBeDefined();
+    // C2 time window + duration consistency
+    expect(a.endTime).toBe(a.startTime + ev.duration);
+    expect(a.startTime).toBeGreaterThanOrEqual(options.startTime);
+    expect(a.endTime).toBeLessThanOrEqual(options.endTime);
+    // C1 capacity
+    expect(ev.attendees ?? 1).toBeLessThanOrEqual(room.capacity);
+    // C4 prerequisites
+    for (const p of ev.prerequisites ?? []) {
+      const pa = assignMap.get(p);
+      // C5: prereq must be scheduled
+      expect(pa).toBeDefined();
+      expect(pa!.endTime + gap).toBeLessThanOrEqual(a.startTime);
+    }
+  }
+
+  // C3 room gaps
+  for (const room of rooms) {
+    const inRoom = result.assignments
+      .filter((a) => a.roomId === room.id)
+      .sort((x, y) => x.startTime - y.startTime);
+    for (let i = 1; i < inRoom.length; i++) {
+      expect(inRoom[i - 1].endTime + gap).toBeLessThanOrEqual(inRoom[i].startTime);
+    }
+  }
+}
