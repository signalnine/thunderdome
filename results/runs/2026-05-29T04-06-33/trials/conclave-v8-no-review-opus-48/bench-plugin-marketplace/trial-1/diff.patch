@@ -0,0 +1,36 @@
+import semver from 'semver';
+import { VersionConstraint, ResolvedVersion, ResolverService } from '../types.js';
+
+export function createResolver(): ResolverService {
+  return {
+    satisfies(version: string, range: string): boolean {
+      return semver.satisfies(version, range);
+    },
+
+    maxSatisfying(versions: string[], range: string): string | null {
+      return semver.maxSatisfying(versions, range);
+    },
+
+    validRange(range: string): boolean {
+      return Boolean(semver.validRange(range));
+    },
+
+    resolve(
+      constraints: VersionConstraint[],
+      available: Record<string, string[]>,
+    ): ResolvedVersion[] {
+      const resolved: ResolvedVersion[] = [];
+      for (const { name, range } of constraints) {
+        const versions = available[name];
+        if (!versions || versions.length === 0) {
+          continue;
+        }
+        const best = semver.maxSatisfying(versions, range);
+        if (best !== null) {
+          resolved.push({ name, version: best, satisfies: range });
+        }
+      }
+      return resolved;
+    },
+  };
+}
