@@ -0,0 +1,240 @@
+import { createDepsService } from './index.js';
+import { PluginManifest, RegistryService } from '../types.js';
+
+// In-test registry STUB. Only get/getVersion are exercised by DepsService; the
+// rest throw if accidentally called.
+function makeRegistry(
+  manifests: Record<string, Partial<PluginManifest> & { dependencies?: Record<string, string> }>
+): RegistryService {
+  const store: Record<string, PluginManifest> = {};
+  for (const [name, m] of Object.entries(manifests)) {
+    store[name] = {
+      name,
+      version: m.version ?? '1.0.0',
+      description: '',
+      author: '',
+      dependencies: m.dependencies ?? {},
+      entryPoint: 'index.js',
+      permissions: [],
+    };
+  }
+  return {
+    register() {
+      throw new Error('not used');
+    },
+    get(name: string): PluginManifest | null {
+      return store[name] ?? null;
+    },
+    getVersion(name: string, version: string): PluginManifest | null {
+      const m = store[name];
+      return m && m.version === version ? m : null;
+    },
+    list() {
+      return Object.values(store);
+    },
+    search() {
+      return [];
+    },
+    remove() {
+      return false;
+    },
+    listVersions(name: string) {
+      return store[name] ? [store[name].version] : [];
+    },
+    update() {
+      throw new Error('not used');
+    },
+  };
+}
+
+describe('createDepsService', () => {
+  describe('buildTree', () => {
+    it('builds a nested dependency tree', () => {
+      const registry = makeRegistry({
+        a: { version: '1.0.0', dependencies: { b: '^1.0.0', c: '^1.0.0' } },
+        b: { version: '2.0.0', dependencies: { d: '^1.0.0' } },
+        c: { version: '3.0.0' },
+        d: { version: '4.0.0' },
+      });
+      const deps = createDepsService();
+      const tree = deps.buildTree('a', registry);
+
+      expect(tree.name).toBe('a');
+      expect(tree.version).toBe('1.0.0');
+      const childNames = tree.dependencies.map((n) => n.name).sort();
+      expect(childNames).toEqual(['b', 'c']);
+
+      const b = tree.dependencies.find((n) => n.name === 'b')!;
+      expect(b.version).toBe('2.0.0');
+      expect(b.dependencies.map((n) => n.name)).toEqual(['d']);
+      expect(b.dependencies[0].version).toBe('4.0.0');
+    });
+
+    it('includes a missing dependency as a node with empty version and no children', () => {
+      const registry = makeRegistry({
+        a: { version: '1.0.0', dependencies: { missing: '^1.0.0' } },
+      });
+      const deps = createDepsService();
+      const tree = deps.buildTree('a', registry);
+
+      expect(tree.dependencies).toHaveLength(1);
+      const missing = tree.dependencies[0];
+      expect(missing.name).toBe('missing');
+      expect(missing.version).toBe('');
+      expect(missing.dependencies).toEqual([]);
+    });
+
+    it('does not infinitely recurse on a cycle', () => {
+      const registry = makeRegistry({
+        a: { dependencies: { b: '^1.0.0' } },
+        b: { dependencies: { a: '^1.0.0' } },
+      });
+      const deps = createDepsService();
+      const tree = deps.buildTree('a', registry);
+
+      expect(tree.name).toBe('a');
+      const b = tree.dependencies[0];
+      expect(b.name).toBe('b');
+      // back-edge to 'a' is included as a node but not recursed
+      const backA = b.dependencies[0];
+      expect(backA.name).toBe('a');
+      expect(backA.dependencies).toEqual([]);
+    });
+
+    it('uses empty version when the root plugin is not in the registry', () => {
+      const registry = makeRegistry({});
+      const deps = createDepsService();
+      const tree = deps.buildTree('ghost', registry);
+      expect(tree).toEqual({ name: 'ghost', version: '', dependencies: [] });
+    });
+  });
+
+  describe('detectCycles', () => {
+    it('detects a simple cycle A -> B -> A', () => {
+      const registry = makeRegistry({
+        A: { dependencies: { B: '^1.0.0' } },
+        B: { dependencies: { A: '^1.0.0' } },
+      });
+      const deps = createDepsService();
+      const cycles = deps.detectCycles('A', registry);
+
+      expect(cycles).not.toBeNull();
+      expect(cycles!.length).toBeGreaterThanOrEqual(1);
+      const cycle = cycles![0];
+      // path forms a loop back to its start
+      expect(cycle[0]).toBe(cycle[cycle.length - 1]);
+      expect(cycle).toContain('A');
+      expect(cycle).toContain('B');
+    });
+
+    it('returns null for an acyclic graph', () => {
+      const registry = makeRegistry({
+        a: { dependencies: { b: '^1.0.0', c: '^1.0.0' } },
+        b: { dependencies: { d: '^1.0.0' } },
+        c: { dependencies: { d: '^1.0.0' } },
+        d: {},
+      });
+      const deps = createDepsService();
+      expect(deps.detectCycles('a', registry)).toBeNull();
+    });
+
+    it('detects a self-cycle A -> A', () => {
+      const registry = makeRegistry({
+        A: { dependencies: { A: '^1.0.0' } },
+      });
+      const deps = createDepsService();
+      const cycles = deps.detectCycles('A', registry);
+      expect(cycles).not.toBeNull();
+    });
+  });
+
+  describe('hasCircularDependency', () => {
+    it('is true when a cycle exists', () => {
+      const registry = makeRegistry({
+        A: { dependencies: { B: '^1.0.0' } },
+        B: { dependencies: { A: '^1.0.0' } },
+      });
+      const deps = createDepsService();
+      expect(deps.hasCircularDependency('A', registry)).toBe(true);
+    });
+
+    it('is false when no cycle exists', () => {
+      const registry = makeRegistry({
+        a: { dependencies: { b: '^1.0.0' } },
+        b: {},
+      });
+      const deps = createDepsService();
+      expect(deps.hasCircularDependency('a', registry)).toBe(false);
+    });
+  });
+
+  describe('topologicalSort', () => {
+    it('orders dependencies before dependents', () => {
+      const registry = makeRegistry({
+        a: { dependencies: { b: '^1.0.0', c: '^1.0.0' } },
+        b: { dependencies: { d: '^1.0.0' } },
+        c: { dependencies: { d: '^1.0.0' } },
+        d: {},
+      });
+      const deps = createDepsService();
+      const order = deps.topologicalSort('a', registry);
+
+      expect(order).toContain('a');
+      expect(order).toContain('d');
+      const idx = (n: string) => order.indexOf(n);
+      // every dependency must appear before its dependent
+      expect(idx('d')).toBeLessThan(idx('b'));
+      expect(idx('d')).toBeLessThan(idx('c'));
+      expect(idx('b')).toBeLessThan(idx('a'));
+      expect(idx('c')).toBeLessThan(idx('a'));
+      // each node appears exactly once
+      expect(new Set(order).size).toBe(order.length);
+    });
+
+    it('handles a cycle gracefully by breaking the back-edge (no throw)', () => {
+      const registry = makeRegistry({
+        a: { dependencies: { b: '^1.0.0' } },
+        b: { dependencies: { a: '^1.0.0' } },
+      });
+      const deps = createDepsService();
+      const order = deps.topologicalSort('a', registry);
+      expect(order.sort()).toEqual(['a', 'b']);
+    });
+  });
+
+  describe('flattenDependencies', () => {
+    it('returns unique transitive deps excluding the root and dedups shared deps', () => {
+      const registry = makeRegistry({
+        a: { dependencies: { b: '^1.0.0', c: '^1.0.0' } },
+        b: { dependencies: { d: '^1.0.0' } },
+        c: { dependencies: { d: '^1.0.0' } },
+        d: {},
+      });
+      const deps = createDepsService();
+      const flat = deps.flattenDependencies('a', registry);
+
+      expect(flat).not.toContain('a');
+      expect(flat.sort()).toEqual(['b', 'c', 'd']);
+      // d is reachable via both b and c but appears once
+      expect(flat.filter((n) => n === 'd')).toHaveLength(1);
+    });
+
+    it('handles cycles without infinite loop', () => {
+      const registry = makeRegistry({
+        a: { dependencies: { b: '^1.0.0' } },
+        b: { dependencies: { a: '^1.0.0' } },
+      });
+      const deps = createDepsService();
+      const flat = deps.flattenDependencies('a', registry);
+      expect(flat).toEqual(['b']);
+    });
+
+    it('does not crash on a missing dependency', () => {
+      const registry = makeRegistry({
+        a: { dependencies: { missing: '^1.0.0' } },
+      });
+      const deps = createDepsService();
+      expect(deps.flattenDependencies('a', registry)).toEqual(['missing']);
+    });
+  });
+});
