+import { createResolver } from './index.js';
+
+describe('ResolverService', () => {
+  const resolver = createResolver();
+
+  describe('satisfies', () => {
+    it('returns true when version satisfies range', () => {
+      expect(resolver.satisfies('1.2.3', '^1.0.0')).toBe(true);
+    });
+
+    it('returns false when version does not satisfy range', () => {
+      expect(resolver.satisfies('2.0.0', '^1.0.0')).toBe(false);
+    });
+  });
+
+  describe('maxSatisfying', () => {
+    it('returns the highest satisfying version', () => {
+      expect(resolver.maxSatisfying(['1.0.0', '1.2.0', '1.5.0', '2.0.0'], '^1.0.0')).toBe('1.5.0');
+    });
+
+    it('returns null when none satisfy', () => {
+      expect(resolver.maxSatisfying(['2.0.0', '3.0.0'], '^1.0.0')).toBeNull();
+    });
+
+    it('returns null for empty list', () => {
+      expect(resolver.maxSatisfying([], '^1.0.0')).toBeNull();
+    });
+  });
+
+  describe('validRange', () => {
+    it('returns true for a valid range', () => {
+      expect(resolver.validRange('^1.0.0')).toBe(true);
+    });
+
+    it('returns true for *', () => {
+      expect(resolver.validRange('*')).toBe(true);
+    });
+
+    it('returns false for an invalid range', () => {
+      expect(resolver.validRange('not-a-range')).toBe(false);
+    });
+  });
+
+  describe('resolve', () => {
+    it('resolves constraints to max satisfying versions', () => {
+      const constraints = [
+        { name: 'a', range: '^1.0.0' },
+        { name: 'b', range: '~2.1.0' },
+      ];
+      const available = {
+        a: ['1.0.0', '1.4.0', '2.0.0'],
+        b: ['2.1.0', '2.1.5', '2.2.0'],
+      };
+      expect(resolver.resolve(constraints, available)).toEqual([
+        { name: 'a', version: '1.4.0', satisfies: '^1.0.0' },
+        { name: 'b', version: '2.1.5', satisfies: '~2.1.0' },
+      ]);
+    });
+
+    it('skips constraints with no available versions', () => {
+      const constraints = [{ name: 'missing', range: '^1.0.0' }];
+      expect(resolver.resolve(constraints, {})).toEqual([]);
+    });
+
+    it('skips constraints with empty version arrays', () => {
+      const constraints = [{ name: 'a', range: '^1.0.0' }];
+      expect(resolver.resolve(constraints, { a: [] })).toEqual([]);
+    });
+
+    it('skips constraints where no version satisfies', () => {
+      const constraints = [{ name: 'a', range: '^5.0.0' }];
+      expect(resolver.resolve(constraints, { a: ['1.0.0', '2.0.0'] })).toEqual([]);
+    });
+
+    it('does not throw on unsatisfiable mix and returns only satisfiable ones', () => {
+      const constraints = [
+        { name: 'a', range: '^1.0.0' },
+        { name: 'b', range: '^9.0.0' },
+      ];
+      const available = {
+        a: ['1.1.0'],
+        b: ['1.0.0'],
+      };
+      expect(resolver.resolve(constraints, available)).toEqual([
+        { name: 'a', version: '1.1.0', satisfies: '^1.0.0' },
+      ]);
+    });
+
+    it('returns empty array for no constraints', () => {
+      expect(resolver.resolve([], {})).toEqual([]);
+    });
+  });
+});
