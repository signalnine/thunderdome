+import { describe, it, expect } from 'vitest';
+import { createMarketplace } from './index.js';
+import { PluginManifest } from './types.js';
+
+function manifest(overrides: Partial<PluginManifest> = {}): PluginManifest {
+  return {
+    name: 'demo',
+    version: '1.0.0',
+    description: 'a demo plugin',
+    author: 'tester',
+    dependencies: {},
+    entryPoint: 'result = 40 + 2;',
+    permissions: [],
+    ...overrides,
+  };
+}
+
+describe('createMarketplace', () => {
+  it('exposes all five capabilities', () => {
+    const mp = createMarketplace();
+    expect(mp.registry).toBeDefined();
+    expect(mp.resolver).toBeDefined();
+    expect(mp.runner).toBeDefined();
+    expect(mp.reviews).toBeDefined();
+    expect(mp.deps).toBeDefined();
+  });
+
+  it('installs a valid plugin, registers it, and executes the entry point', async () => {
+    const mp = createMarketplace();
+    const result = await mp.installPlugin(manifest());
+    expect(mp.registry.getVersion('demo', '1.0.0')).not.toBeNull();
+    expect(result.execution.success).toBe(true);
+    expect(result.execution.output).toBe(42);
+    expect(Array.isArray(result.resolved)).toBe(true);
+  });
+
+  it('resolves dependency versions against the registry', async () => {
+    const mp = createMarketplace();
+    mp.registry.register(manifest({ name: 'lib', version: '1.2.0', entryPoint: 'result = 1;' }));
+    mp.registry.register(manifest({ name: 'lib', version: '1.5.0', entryPoint: 'result = 1;' }));
+    const result = await mp.installPlugin(
+      manifest({ name: 'app', dependencies: { lib: '^1.0.0' } }),
+    );
+    const lib = result.resolved.find((r) => r.name === 'lib');
+    expect(lib).toBeDefined();
+    expect(lib?.version).toBe('1.5.0');
+    expect(lib?.satisfies).toBe('^1.0.0');
+  });
+
+  it('rejects a manifest missing required fields', async () => {
+    const mp = createMarketplace();
+    await expect(
+      mp.installPlugin(manifest({ name: '' })),
+    ).rejects.toThrow(/name/);
+    await expect(
+      mp.installPlugin(manifest({ version: '' })),
+    ).rejects.toThrow(/version/);
+    await expect(
+      mp.installPlugin(manifest({ entryPoint: '' })),
+    ).rejects.toThrow(/entryPoint/);
+  });
+
+  it('rejects when a circular dependency is detected', async () => {
+    const mp = createMarketplace();
+    // a -> b -> a
+    mp.registry.register(
+      manifest({ name: 'a', version: '1.0.0', dependencies: { b: '^1.0.0' }, entryPoint: 'result = 1;' }),
+    );
+    mp.registry.register(
+      manifest({ name: 'b', version: '1.0.0', dependencies: { a: '^1.0.0' }, entryPoint: 'result = 1;' }),
+    );
+    await expect(
+      mp.installPlugin(
+        manifest({ name: 'a', version: '1.0.1', dependencies: { b: '^1.0.0' }, entryPoint: 'result = 1;' }),
+      ),
+    ).rejects.toThrow(/circular/i);
+  });
+
+  it('returns resolved versions and execution result shape', async () => {
+    const mp = createMarketplace();
+    const result = await mp.installPlugin(manifest());
+    expect(result).toHaveProperty('resolved');
+    expect(result).toHaveProperty('execution');
+    expect(result.execution).toHaveProperty('duration');
+    expect(result.execution).toHaveProperty('memoryUsed');
+  });
+});
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..01e145a
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,89 @@
+import {
+  PluginManifest,
+  ResolvedVersion,
+  SandboxResult,
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+  VersionConstraint,
+} from './types.js';
+import { createRegistry } from './registry/index.js';
+import { createResolver } from './resolver/index.js';
+import { createRunner } from './runner/index.js';
+import { createReviewSystem } from './reviews/index.js';
+import { createDepsService } from './deps/index.js';
+
+export interface InstallResult {
+  manifest: PluginManifest;
+  resolved: ResolvedVersion[];
+  execution: SandboxResult;
+}
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest): Promise<InstallResult>;
+}
+
+export function createMarketplace(): Marketplace {
+  const registry = createRegistry();
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviewSystem();
+  const deps = createDepsService();
+
+  async function installPlugin(manifest: PluginManifest): Promise<InstallResult> {
+    // 1. Validate required fields.
+    if (!manifest || typeof manifest !== 'object') {
+      throw new Error('Invalid manifest: expected an object');
+    }
+    if (!manifest.name) {
+      throw new Error('Invalid manifest: missing required field "name"');
+    }
+    if (!manifest.version) {
+      throw new Error('Invalid manifest: missing required field "version"');
+    }
+    if (!manifest.entryPoint) {
+      throw new Error('Invalid manifest: missing required field "entryPoint"');
+    }
+
+    // 2. Register the plugin in the catalog.
+    registry.register(manifest);
+
+    // 3. Resolve dependency versions against what's available in the registry.
+    const dependencies = manifest.dependencies ?? {};
+    const constraints: VersionConstraint[] = Object.entries(dependencies).map(
+      ([name, range]) => ({ name, range }),
+    );
+    const available: Record<string, string[]> = {};
+    for (const constraint of constraints) {
+      available[constraint.name] = registry.listVersions(constraint.name);
+    }
+    const resolved = resolver.resolve(constraints, available);
+
+    // 4. Check for circular dependencies (reject if found).
+    if (deps.hasCircularDependency(manifest.name, registry)) {
+      throw new Error(
+        `Cannot install "${manifest.name}": circular dependency detected`,
+      );
+    }
+
+    // 5. Execute the plugin's entry point in the sandbox.
+    const execution = await runner.execute(manifest.entryPoint, {
+      manifest,
+      dependencies: resolved,
+    });
+
+    // 6. Return resolved dependency versions and sandbox execution result.
+    return { manifest, resolved, execution };
+  }
+
+  return { registry, resolver, runner, reviews, deps, installPlugin };
+}
+
+export * from './types.js';
