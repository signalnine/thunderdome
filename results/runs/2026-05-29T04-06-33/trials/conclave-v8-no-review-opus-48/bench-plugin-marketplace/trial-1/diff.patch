new file mode 100644
index 0000000..f3e8153
--- /dev/null
+++ b/src/runner/index.ts
@@ -0,0 +1,47 @@
+import vm from 'node:vm';
+import { SandboxResult, RunnerService } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+export function createRunner(): RunnerService {
+  function executeWithTimeout(
+    code: string,
+    timeoutMs: number,
+    context?: Record<string, unknown>,
+  ): Promise<SandboxResult> {
+    const sandbox: Record<string, unknown> = { ...(context ?? {}), result: undefined };
+    const vmContext = vm.createContext(sandbox);
+
+    const startMemory = process.memoryUsage().heapUsed;
+    const startTime = process.hrtime.bigint();
+
+    let success: boolean;
+    let output: unknown;
+    let error: string | undefined;
+
+    try {
+      const script = new vm.Script(code);
+      const completion = script.runInContext(vmContext, { timeout: timeoutMs });
+      output = sandbox.result !== undefined ? sandbox.result : completion;
+      success = true;
+    } catch (err) {
+      success = false;
+      output = undefined;
+      error = err instanceof Error ? err.message : String(err);
+    }
+
+    const endTime = process.hrtime.bigint();
+    const duration = Number(endTime - startTime) / 1e6;
+    const memoryUsed = process.memoryUsage().heapUsed - startMemory;
+
+    const base = { success, output, duration, memoryUsed };
+    const settled: SandboxResult = success ? base : { ...base, error };
+    return Promise.resolve(settled);
+  }
+
+  function execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult> {
+    return executeWithTimeout(code, DEFAULT_TIMEOUT_MS, context);
+  }
+
+  return { execute, executeWithTimeout };
+}
