new file mode 100644
index 0000000..a01a276
--- /dev/null
+++ b/src/deps/index.ts
@@ -0,0 +1,169 @@
+import { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+// Dependency Graph module.
+//
+// Each method takes (name, registry). Dependencies are resolved by reading the
+// latest manifest for a plugin via registry.get(name) and using
+// manifest.dependencies, which is a Record<depName, semverRange>. For graph
+// purposes we treat edges as name -> depName (a plugin depends on its deps).
+//
+// Missing-dependency policy: when a dependency name is not present in the
+// registry (registry.get returns null) we INCLUDE the node with version ''
+// (empty string) and no children rather than skipping it. This keeps the tree
+// shape informative without crashing.
+
+export function createDepsService(): DepsService {
+  // Returns the direct dependency names for a plugin, or [] if the plugin is
+  // not in the registry.
+  function directDeps(name: string, registry: RegistryService): string[] {
+    const manifest = registry.get(name);
+    if (!manifest || !manifest.dependencies) {
+      return [];
+    }
+    return Object.keys(manifest.dependencies);
+  }
+
+  function versionOf(name: string, registry: RegistryService): string {
+    const manifest = registry.get(name);
+    return manifest ? manifest.version : '';
+  }
+
+  function buildTree(name: string, registry: RegistryService): DependencyNode {
+    // `path` tracks the chain of ancestors to guard against cycles. When we hit
+    // a back-edge (a name already on the current path) we stop recursing and
+    // return the node with no children.
+    function build(current: string, path: Set<string>): DependencyNode {
+      const version = versionOf(current, registry);
+      if (path.has(current)) {
+        return { name: current, version, dependencies: [] };
+      }
+      const nextPath = new Set(path);
+      nextPath.add(current);
+      const dependencies = directDeps(current, registry).map((dep) =>
+        build(dep, nextPath)
+      );
+      return { name: current, version, dependencies };
+    }
+    return build(name, new Set());
+  }
+
+  function detectCycles(
+    name: string,
+    registry: RegistryService
+  ): string[][] | null {
+    const cycles: string[][] = [];
+    const seenCycleKeys = new Set<string>();
+    const path: string[] = [];
+    const onPath = new Set<string>();
+    const fullyVisited = new Set<string>();
+
+    function dfs(current: string): void {
+      if (onPath.has(current)) {
+        // Found a back-edge: extract the cycle from the path.
+        const start = path.indexOf(current);
+        const cycle = path.slice(start);
+        // Normalize the cycle so the same cycle reached via different entry
+        // points / rotations is reported once.
+        const key = canonicalCycleKey(cycle);
+        if (!seenCycleKeys.has(key)) {
+          seenCycleKeys.add(key);
+          cycles.push([...cycle, current]);
+        }
+        return;
+      }
+      if (fullyVisited.has(current)) {
+        return;
+      }
+      path.push(current);
+      onPath.add(current);
+      for (const dep of directDeps(current, registry)) {
+        dfs(dep);
+      }
+      path.pop();
+      onPath.delete(current);
+      fullyVisited.add(current);
+    }
+
+    dfs(name);
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  function canonicalCycleKey(cycle: string[]): string {
+    // Rotate the cycle so it starts at its lexicographically smallest member,
+    // giving a stable key independent of where the cycle was entered.
+    if (cycle.length === 0) {
+      return '';
+    }
+    let minIdx = 0;
+    for (let i = 1; i < cycle.length; i++) {
+      if (cycle[i] < cycle[minIdx]) {
+        minIdx = i;
+      }
+    }
+    const rotated = [...cycle.slice(minIdx), ...cycle.slice(0, minIdx)];
+    return rotated.join('->');
+  }
+
+  function hasCircularDependency(
+    name: string,
+    registry: RegistryService
+  ): boolean {
+    const cycles = detectCycles(name, registry);
+    return cycles !== null && cycles.length > 0;
+  }
+
+  function topologicalSort(name: string, registry: RegistryService): string[] {
+    // Post-order DFS produces dependencies before dependents. Back-edges
+    // (cycles) are skipped via the `onPath` guard rather than throwing.
+    const result: string[] = [];
+    const visited = new Set<string>();
+    const onPath = new Set<string>();
+
+    function dfs(current: string): void {
+      if (visited.has(current) || onPath.has(current)) {
+        return;
+      }
+      onPath.add(current);
+      for (const dep of directDeps(current, registry)) {
+        dfs(dep);
+      }
+      onPath.delete(current);
+      visited.add(current);
+      result.push(current);
+    }
+
+    dfs(name);
+    return result;
+  }
+
+  function flattenDependencies(
+    name: string,
+    registry: RegistryService
+  ): string[] {
+    // Unique transitive dependency names reachable from `name`, excluding
+    // `name` itself. Cycles are handled via the `visited` set.
+    const result: string[] = [];
+    const visited = new Set<string>([name]);
+
+    function dfs(current: string): void {
+      for (const dep of directDeps(current, registry)) {
+        if (!visited.has(dep)) {
+          visited.add(dep);
+          result.push(dep);
+          dfs(dep);
+        }
+      }
+    }
+
+    dfs(name);
+    return result;
+  }
+
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency,
+  };
+}
