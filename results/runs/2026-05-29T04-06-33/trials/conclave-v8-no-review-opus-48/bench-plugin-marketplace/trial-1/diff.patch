@@ -0,0 +1,43 @@
+import { createRunner } from './index.js';
+
+describe('createRunner', () => {
+  it('captures an assigned result variable', async () => {
+    const runner = createRunner();
+    const res = await runner.execute('result = 1 + 1');
+    expect(res.success).toBe(true);
+    expect(res.output).toBe(2);
+    expect(typeof res.duration).toBe('number');
+    expect(typeof res.memoryUsed).toBe('number');
+  });
+
+  it('uses provided context variables', async () => {
+    const runner = createRunner();
+    const res = await runner.execute('result = x * 2', { x: 5 });
+    expect(res.success).toBe(true);
+    expect(res.output).toBe(10);
+  });
+
+  it('uses the completion value when result is not assigned', async () => {
+    const runner = createRunner();
+    const res = await runner.execute('3 + 4');
+    expect(res.success).toBe(true);
+    expect(res.output).toBe(7);
+  });
+
+  it('reports errors thrown by the code', async () => {
+    const runner = createRunner();
+    const res = await runner.execute('throw new Error("boom")');
+    expect(res.success).toBe(false);
+    expect(res.output).toBeUndefined();
+    expect(res.error).toBeDefined();
+    expect(res.error).toContain('boom');
+  });
+
+  it('times out runaway code', async () => {
+    const runner = createRunner();
+    const res = await runner.executeWithTimeout('while(true){}', 100);
+    expect(res.success).toBe(false);
+    expect(res.error).toBeDefined();
+    expect(res.error?.toLowerCase()).toContain('timed out');
+  }, 10000);
+});
