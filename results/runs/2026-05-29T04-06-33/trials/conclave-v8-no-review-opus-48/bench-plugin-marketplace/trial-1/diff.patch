+++ b/src/registry/index.ts
@@ -0,0 +1,80 @@
+import semver from 'semver';
+import { PluginManifest, RegistryService } from '../types.js';
+
+function versionKey(name: string, version: string): string {
+  return `${name}@${version}`;
+}
+
+export function createRegistry(): RegistryService {
+  // Keyed by `${name}@${version}` for cheap exact-match upsert.
+  const store = new Map<string, PluginManifest>();
+
+  function entriesForName(name: string): PluginManifest[] {
+    const result: PluginManifest[] = [];
+    for (const manifest of store.values()) {
+      if (manifest.name === name) {
+        result.push(manifest);
+      }
+    }
+    return result;
+  }
+
+  return {
+    register(manifest: PluginManifest): void {
+      store.set(versionKey(manifest.name, manifest.version), { ...manifest });
+    },
+
+    get(name: string): PluginManifest | null {
+      const entries = entriesForName(name);
+      if (entries.length === 0) {
+        return null;
+      }
+      const sorted = semver.rsort(entries.map((e) => e.version));
+      const highest = sorted[0];
+      return store.get(versionKey(name, highest)) ?? null;
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      return store.get(versionKey(name, version)) ?? null;
+    },
+
+    list(): PluginManifest[] {
+      return Array.from(store.values());
+    },
+
+    search(query: string): PluginManifest[] {
+      const needle = query.toLowerCase();
+      return Array.from(store.values()).filter((m) => {
+        return (
+          m.name.toLowerCase().includes(needle) ||
+          m.description.toLowerCase().includes(needle) ||
+          m.author.toLowerCase().includes(needle)
+        );
+      });
+    },
+
+    remove(name: string, version: string): boolean {
+      return store.delete(versionKey(name, version));
+    },
+
+    listVersions(name: string): string[] {
+      const versions = entriesForName(name).map((e) => e.version);
+      return semver.rsort(versions);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const key = versionKey(name, version);
+      const existing = store.get(key);
+      if (!existing) {
+        return;
+      }
+      const merged: PluginManifest = { ...existing, ...updates };
+      // If identity changed via updates, re-key so lookups stay consistent.
+      const newKey = versionKey(merged.name, merged.version);
+      if (newKey !== key) {
+        store.delete(key);
+      }
+      store.set(newKey, merged);
+    },
+  };
+}
