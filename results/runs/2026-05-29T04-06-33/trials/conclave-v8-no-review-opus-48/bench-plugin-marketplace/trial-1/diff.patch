+import { createRegistry } from './index.js';
+import { PluginManifest, RegistryService } from '../types.js';
+
+function manifest(overrides: Partial<PluginManifest> = {}): PluginManifest {
+  return {
+    name: 'alpha',
+    version: '1.0.0',
+    description: 'A test plugin',
+    author: 'Ada',
+    dependencies: {},
+    entryPoint: 'index.js',
+    permissions: [],
+    ...overrides,
+  };
+}
+
+describe('createRegistry', () => {
+  let registry: RegistryService;
+
+  beforeEach(() => {
+    registry = createRegistry();
+  });
+
+  describe('register / get', () => {
+    it('stores a manifest and retrieves it by name', () => {
+      registry.register(manifest());
+      expect(registry.get('alpha')).toEqual(manifest());
+    });
+
+    it('returns null for unknown name', () => {
+      expect(registry.get('nope')).toBeNull();
+    });
+
+    it('keeps multiple versions of the same name', () => {
+      registry.register(manifest({ version: '1.0.0' }));
+      registry.register(manifest({ version: '2.0.0' }));
+      expect(registry.listVersions('alpha')).toEqual(['2.0.0', '1.0.0']);
+    });
+
+    it('get returns the highest semver version', () => {
+      registry.register(manifest({ version: '1.0.0' }));
+      registry.register(manifest({ version: '1.10.0' }));
+      registry.register(manifest({ version: '1.2.0' }));
+      expect(registry.get('alpha')?.version).toBe('1.10.0');
+    });
+
+    it('re-registering same name+version replaces (upsert, no duplicate)', () => {
+      registry.register(manifest({ version: '1.0.0', description: 'first' }));
+      registry.register(manifest({ version: '1.0.0', description: 'second' }));
+      expect(registry.list()).toHaveLength(1);
+      expect(registry.get('alpha')?.description).toBe('second');
+    });
+
+    it('stores a copy so external mutation does not leak in', () => {
+      const m = manifest();
+      registry.register(m);
+      m.description = 'mutated';
+      expect(registry.get('alpha')?.description).toBe('A test plugin');
+    });
+  });
+
+  describe('getVersion', () => {
+    it('returns exact match', () => {
+      registry.register(manifest({ version: '1.0.0' }));
+      registry.register(manifest({ version: '2.0.0' }));
+      expect(registry.getVersion('alpha', '1.0.0')?.version).toBe('1.0.0');
+    });
+
+    it('returns null when version absent', () => {
+      registry.register(manifest({ version: '1.0.0' }));
+      expect(registry.getVersion('alpha', '9.9.9')).toBeNull();
+    });
+
+    it('returns null when name absent', () => {
+      expect(registry.getVersion('ghost', '1.0.0')).toBeNull();
+    });
+  });
+
+  describe('list', () => {
+    it('returns all manifests across names and versions', () => {
+      registry.register(manifest({ name: 'alpha', version: '1.0.0' }));
+      registry.register(manifest({ name: 'alpha', version: '2.0.0' }));
+      registry.register(manifest({ name: 'beta', version: '1.0.0' }));
+      expect(registry.list()).toHaveLength(3);
+    });
+
+    it('is empty initially', () => {
+      expect(registry.list()).toEqual([]);
+    });
+  });
+
+  describe('search', () => {
+    beforeEach(() => {
+      registry.register(
+        manifest({ name: 'json-tools', description: 'parse JSON fast', author: 'Grace' })
+      );
+      registry.register(
+        manifest({ name: 'yaml-kit', description: 'YAML helpers', author: 'Alan' })
+      );
+    });
+
+    it('matches by name (case-insensitive)', () => {
+      expect(registry.search('JSON').map((m) => m.name)).toEqual(['json-tools']);
+    });
+
+    it('matches by description', () => {
+      expect(registry.search('helpers').map((m) => m.name)).toEqual(['yaml-kit']);
+    });
+
+    it('matches by author', () => {
+      expect(registry.search('grace').map((m) => m.name)).toEqual(['json-tools']);
+    });
+
+    it('returns empty array for no matches', () => {
+      expect(registry.search('zzz')).toEqual([]);
+    });
+  });
+
+  describe('remove', () => {
+    it('removes an exact version and returns true', () => {
+      registry.register(manifest({ version: '1.0.0' }));
+      registry.register(manifest({ version: '2.0.0' }));
+      expect(registry.remove('alpha', '1.0.0')).toBe(true);
+      expect(registry.listVersions('alpha')).toEqual(['2.0.0']);
+    });
+
+    it('returns false when not found', () => {
+      expect(registry.remove('alpha', '1.0.0')).toBe(false);
+    });
+  });
+
+  describe('listVersions', () => {
+    it('returns versions sorted descending by semver', () => {
+      registry.register(manifest({ version: '1.0.0' }));
+      registry.register(manifest({ version: '0.9.0' }));
+      registry.register(manifest({ version: '1.2.0' }));
+      registry.register(manifest({ version: '1.10.0' }));
+      expect(registry.listVersions('alpha')).toEqual(['1.10.0', '1.2.0', '1.0.0', '0.9.0']);
+    });
+
+    it('returns empty array for unknown name', () => {
+      expect(registry.listVersions('ghost')).toEqual([]);
+    });
+  });
+
+  describe('update', () => {
+    it('shallow-merges updates into the stored manifest', () => {
+      registry.register(manifest({ version: '1.0.0' }));
+      registry.update('alpha', '1.0.0', { description: 'updated', author: 'Bob' });
+      const got = registry.getVersion('alpha', '1.0.0');
+      expect(got?.description).toBe('updated');
+      expect(got?.author).toBe('Bob');
+      expect(got?.entryPoint).toBe('index.js');
+    });
+
+    it('is a no-op when entry does not exist', () => {
+      registry.update('ghost', '1.0.0', { description: 'x' });
+      expect(registry.getVersion('ghost', '1.0.0')).toBeNull();
+    });
+
+    it('re-keys when identity fields change', () => {
+      registry.register(manifest({ version: '1.0.0' }));
+      registry.update('alpha', '1.0.0', { version: '1.0.1' });
+      expect(registry.getVersion('alpha', '1.0.0')).toBeNull();
+      expect(registry.getVersion('alpha', '1.0.1')?.version).toBe('1.0.1');
+      expect(registry.list()).toHaveLength(1);
+    });
+  });
+});
