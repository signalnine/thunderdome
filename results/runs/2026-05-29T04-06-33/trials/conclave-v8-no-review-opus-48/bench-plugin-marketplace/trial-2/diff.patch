@@ -0,0 +1,60 @@
+import vm from 'node:vm';
+import { performance } from 'node:perf_hooks';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+/**
+ * Executes untrusted plugin code strings inside an isolated `vm` context.
+ * The sandbox has no access to `require`, `process`, or the host module system.
+ */
+export function createRunner(): RunnerService {
+  function run(
+    code: string,
+    timeoutMs: number,
+    context: Record<string, unknown>,
+  ): SandboxResult {
+    const sandbox: Record<string, unknown> = { ...context };
+    const ctx = vm.createContext(sandbox);
+
+    const startMem = process.memoryUsage().heapUsed;
+    const start = performance.now();
+    try {
+      const output = vm.runInContext(code, ctx, {
+        timeout: timeoutMs,
+        // Prevent code from blowing up the host on bad input.
+        displayErrors: false,
+      });
+      const duration = performance.now() - start;
+      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - startMem);
+      return { success: true, output, duration, memoryUsed };
+    } catch (err) {
+      const duration = performance.now() - start;
+      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - startMem);
+      return {
+        success: false,
+        output: undefined,
+        duration,
+        memoryUsed,
+        error: err instanceof Error ? err.message : String(err),
+      };
+    }
+  }
+
+  return {
+    async execute(
+      code: string,
+      context: Record<string, unknown> = {},
+    ): Promise<SandboxResult> {
+      return run(code, DEFAULT_TIMEOUT_MS, context);
+    },
+
+    async executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context: Record<string, unknown> = {},
+    ): Promise<SandboxResult> {
+      return run(code, timeoutMs, context);
+    },
+  };
+}
