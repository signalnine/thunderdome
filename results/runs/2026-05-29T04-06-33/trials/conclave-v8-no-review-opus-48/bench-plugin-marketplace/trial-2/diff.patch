index 0000000..01ad4c3
--- /dev/null
+++ b/src/resolver/index.ts
@@ -0,0 +1,40 @@
+import semver from 'semver';
+import type { ResolverService, VersionConstraint, ResolvedVersion } from '../types.js';
+
+/**
+ * Semver constraint resolution built on the `semver` package.
+ */
+export function createResolver(): ResolverService {
+  return {
+    satisfies(version: string, range: string): boolean {
+      return semver.satisfies(version, range);
+    },
+
+    maxSatisfying(versions: string[], range: string): string | null {
+      return semver.maxSatisfying(versions, range);
+    },
+
+    validRange(range: string): boolean {
+      return semver.validRange(range) !== null;
+    },
+
+    resolve(
+      constraints: VersionConstraint[],
+      available: Record<string, string[]>,
+    ): ResolvedVersion[] {
+      const resolved: ResolvedVersion[] = [];
+      for (const constraint of constraints) {
+        const versions = available[constraint.name] ?? [];
+        const best = semver.maxSatisfying(versions, constraint.range);
+        if (best !== null) {
+          resolved.push({
+            name: constraint.name,
+            version: best,
+            satisfies: constraint.range,
+          });
+        }
+      }
+      return resolved;
+    },
+  };
+}
diff --git a/src/reviews/index.ts b/src/reviews/index.ts
new file mode 100644
index 0000000..54a4b81
--- /dev/null
+++ b/src/reviews/index.ts
@@ -0,0 +1,106 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+function toReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged === 1,
+    createdAt: row.createdAt,
+  };
+}
+
+/**
+ * Review storage backed by better-sqlite3 (in-memory by default).
+ * Flagged reviews are excluded from average rating calculations.
+ */
+export function createReviews(dbPath = ':memory:'): ReviewService {
+  const db = new Database(dbPath);
+  db.pragma('journal_mode = WAL');
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT NOT NULL,
+      flagged INTEGER NOT NULL DEFAULT 0,
+      createdAt TEXT NOT NULL
+    );
+  `);
+
+  const insertStmt = db.prepare(
+    `INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+     VALUES (@pluginName, @pluginVersion, @userId, @rating, @comment, 0, @createdAt)`,
+  );
+  const getByIdStmt = db.prepare('SELECT * FROM reviews WHERE id = ?');
+  const getByPluginStmt = db.prepare('SELECT * FROM reviews WHERE pluginName = ?');
+  const avgStmt = db.prepare(
+    'SELECT AVG(rating) AS avg FROM reviews WHERE pluginName = ? AND flagged = 0',
+  );
+  const flagStmt = db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');
+  const flaggedStmt = db.prepare('SELECT * FROM reviews WHERE flagged = 1');
+  const removeStmt = db.prepare('DELETE FROM reviews WHERE id = ?');
+  const byUserStmt = db.prepare('SELECT * FROM reviews WHERE userId = ?');
+  const countStmt = db.prepare(
+    'SELECT COUNT(*) AS count FROM reviews WHERE pluginName = ?',
+  );
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      if (review.rating < 1 || review.rating > 5) {
+        throw new Error('Rating must be between 1 and 5');
+      }
+      const createdAt = new Date().toISOString();
+      const info = insertStmt.run({ ...review, createdAt });
+      const row = getByIdStmt.get(info.lastInsertRowid) as ReviewRow;
+      return toReview(row);
+    },
+
+    getReviews(pluginName: string): Review[] {
+      return (getByPluginStmt.all(pluginName) as ReviewRow[]).map(toReview);
+    },
+
+    getAverageRating(pluginName: string): number {
+      const row = avgStmt.get(pluginName) as { avg: number | null };
+      return row.avg ?? 0;
+    },
+
+    flagReview(reviewId: number): void {
+      flagStmt.run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      return (flaggedStmt.all() as ReviewRow[]).map(toReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      return removeStmt.run(reviewId).changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      return (byUserStmt.all(userId) as ReviewRow[]).map(toReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = countStmt.get(pluginName) as { count: number };
+      return row.count;
+    },
+  };
+}
