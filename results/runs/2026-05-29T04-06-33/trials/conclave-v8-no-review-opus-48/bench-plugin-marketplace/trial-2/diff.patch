@@ -0,0 +1,67 @@
+import { describe, it, expect } from 'vitest';
+import { createMarketplace } from '../src/index.js';
+import type { PluginManifest } from '../src/types.js';
+
+function manifest(over: Partial<PluginManifest> = {}): PluginManifest {
+  return {
+    name: 'alpha',
+    version: '1.0.0',
+    description: 'Alpha',
+    author: 'Alice',
+    dependencies: {},
+    entryPoint: '21 * 2',
+    permissions: [],
+    ...over,
+  };
+}
+
+describe('marketplace integration', () => {
+  it('exposes all five services and installPlugin', () => {
+    const mp = createMarketplace();
+    expect(mp.registry).toBeDefined();
+    expect(mp.resolver).toBeDefined();
+    expect(mp.runner).toBeDefined();
+    expect(mp.reviews).toBeDefined();
+    expect(mp.deps).toBeDefined();
+    expect(typeof mp.installPlugin).toBe('function');
+  });
+
+  it('installs a plugin, registering and executing the entry point', async () => {
+    const mp = createMarketplace();
+    const res = await mp.installPlugin(manifest());
+    expect(res.result.success).toBe(true);
+    expect(res.result.output).toBe(42);
+    expect(mp.registry.get('alpha')?.version).toBe('1.0.0');
+    expect(res.resolved).toEqual([]);
+  });
+
+  it('resolves dependency versions against the registry', async () => {
+    const mp = createMarketplace();
+    mp.registry.register(manifest({ name: 'lib', version: '1.0.0' }));
+    mp.registry.register(manifest({ name: 'lib', version: '1.4.0' }));
+    const res = await mp.installPlugin(
+      manifest({ name: 'app', dependencies: { lib: '^1.0.0' } }),
+    );
+    expect(res.resolved).toEqual([
+      { name: 'lib', version: '1.4.0', satisfies: '^1.0.0' },
+    ]);
+  });
+
+  it('rejects manifests missing required fields', async () => {
+    const mp = createMarketplace();
+    await expect(
+      mp.installPlugin(manifest({ entryPoint: '' })),
+    ).rejects.toThrow(/entryPoint/);
+    await expect(
+      mp.installPlugin(manifest({ name: '' })),
+    ).rejects.toThrow();
+  });
+
+  it('rejects circular dependencies', async () => {
+    const mp = createMarketplace();
+    mp.registry.register(manifest({ name: 'b', dependencies: { a: '^1.0.0' } }));
+    await expect(
+      mp.installPlugin(manifest({ name: 'a', dependencies: { b: '^1.0.0' } })),
+    ).rejects.toThrow(/[Cc]ircular/);
+  });
+});
