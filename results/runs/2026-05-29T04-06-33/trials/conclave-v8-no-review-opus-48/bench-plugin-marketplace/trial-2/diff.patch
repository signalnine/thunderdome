ross plugins and versions', () => {\n    reg.register(manifest({ name: 'alpha', version: '1.0.0' }));\n    reg.register(manifest({ name: 'alpha', version: '2.0.0' }));\n    reg.register(manifest({ name: 'beta', version: '1.0.0' }));\n    expect(reg.list()).toHaveLength(3);\n  });\n\n  it('searches by name, description and author case-insensitively', () => {\n    reg.register(manifest({ name: 'alpha', description: 'Logging tool', author: 'Alice' }));\n    reg.register(manifest({ name: 'beta', description: 'Cache', author: 'Bob' }));\n    expect(reg.search('LOG').map((m) => m.name)).toEqual(['alpha']);\n    expect(reg.search('bob').map((m) => m.name)).toEqual(['beta']);\n    expect(reg.search('a')).toHaveLength(2);\n  });\n\n  it('removes a specific version', () => {\n    reg.register(manifest({ version: '1.0.0' }));\n    reg.register(manifest({ version: '2.0.0' }));\n    expect(reg.remove('alpha', '1.0.0')).toBe(true);\n    expect(reg.listVersions('alpha')).toEqual(['2.0.0']);\n    expect(reg.remove('alpha', '1.0.0')).toBe(false);\n  });\n\n  it('returns [] versions for unknown plugin', () => {\n    expect(reg.listVersions('nope')).toEqual([]);\n  });\n\n  it('updates a manifest with partial fields', () => {\n    reg.register(manifest({ version: '1.0.0', description: 'old' }));\n    reg.update('alpha', '1.0.0', { description: 'updated' });\n    expect(reg.getVersion('alpha', '1.0.0')?.description).toBe('updated');\n  });\n\n  it('update throws for unknown plugin', () => {\n    expect(() => reg.update('x', '1.0.0', {})).toThrow();\n  });\n\n  it('does not leak internal references', () => {\n    const m = manifest();\n    reg.register(m);\n    const got = reg.get('alpha')!;\n    got.permissions.push('hacked');\n    expect(reg.get('alpha')?.permissions).toEqual([]);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1191,"cache_read_input_tokens":36838,"cache_cr