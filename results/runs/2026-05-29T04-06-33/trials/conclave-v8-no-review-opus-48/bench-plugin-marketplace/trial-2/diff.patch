est('a', { b: '^1.0.0' }));\n    reg.register(manifest('b', { a: '^1.0.0' }));\n    const cycles = deps.detectCycles('a', reg);\n    expect(cycles).not.toBeNull();\n    expect(deps.hasCircularDependency('a', reg)).toBe(true);\n  });\n\n  it('returns null when no cycles', () => {\n    reg.register(manifest('a', { b: '^1.0.0' }));\n    reg.register(manifest('b'));\n    expect(deps.detectCycles('a', reg)).toBeNull();\n    expect(deps.hasCircularDependency('a', reg)).toBe(false);\n  });\n\n  it('topologically sorts dependencies before dependents', () => {\n    reg.register(manifest('a', { b: '^1.0.0', c: '^1.0.0' }));\n    reg.register(manifest('b', { c: '^1.0.0' }));\n    reg.register(manifest('c'));\n    const order = deps.topologicalSort('a', reg);\n    expect(order.indexOf('c')).toBeLessThan(order.indexOf('b'));\n    expect(order.indexOf('b')).toBeLessThan(order.indexOf('a'));\n    expect(order[order.length - 1]).toBe('a');\n  });\n\n  it('flattens transitive dependencies uniquely', () => {\n    reg.register(manifest('a', { b: '^1.0.0', c: '^1.0.0' }));\n    reg.register(manifest('b', { c: '^1.0.0' }));\n    reg.register(manifest('c'));\n    const flat = deps.flattenDependencies('a', reg).sort();\n    expect(flat).toEqual(['b', 'c']);\n  });\n\n  it('handles flatten with cycles without infinite loop', () => {\n    reg.register(manifest('a', { b: '^1.0.0' }));\n    reg.register(manifest('b', { a: '^1.0.0' }));\n    const flat = deps.flattenDependencies('a', reg).sort();\n    expect(flat).toEqual(['a', 'b']);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1344,"cache_read_input_tokens":41447,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1344},"output_tokens":67,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"60472e8e-f3aa-461f-a71d