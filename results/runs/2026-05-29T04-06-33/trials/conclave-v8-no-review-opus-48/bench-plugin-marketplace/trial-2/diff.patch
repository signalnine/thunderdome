diff --git a/src/deps/index.ts b/src/deps/index.ts
new file mode 100644
index 0000000..75181d3
--- /dev/null
+++ b/src/deps/index.ts
@@ -0,0 +1,119 @@
+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+/**
+ * Dependency-graph analysis. Operates over a RegistryService to read each
+ * plugin's declared dependencies (manifest.dependencies: name -> range).
+ */
+export function createDeps(): DepsService {
+  function depNames(name: string, registry: RegistryService): string[] {
+    const manifest = registry.get(name);
+    if (!manifest) {
+      return [];
+    }
+    return Object.keys(manifest.dependencies);
+  }
+
+  function build(
+    name: string,
+    registry: RegistryService,
+    path: Set<string>,
+  ): DependencyNode {
+    const manifest = registry.get(name);
+    const version = manifest?.version ?? '';
+    const node: DependencyNode = { name, version, dependencies: [] };
+    if (path.has(name)) {
+      // Cycle: stop expanding to keep the tree finite.
+      return node;
+    }
+    const nextPath = new Set(path);
+    nextPath.add(name);
+    for (const dep of depNames(name, registry)) {
+      node.dependencies.push(build(dep, registry, nextPath));
+    }
+    return node;
+  }
+
+  function findCycles(name: string, registry: RegistryService): string[][] {
+    const cycles: string[][] = [];
+    const seen = new Set<string>();
+
+    function dfs(node: string, stack: string[], onStack: Set<string>): void {
+      stack.push(node);
+      onStack.add(node);
+      for (const dep of depNames(node, registry)) {
+        if (onStack.has(dep)) {
+          // Found a back edge: capture the cycle from dep .. node, dep.
+          const start = stack.indexOf(dep);
+          const cycle = stack.slice(start);
+          cycle.push(dep);
+          cycles.push(cycle);
+        } else if (!seen.has(dep)) {
+          dfs(dep, stack, onStack);
+        }
+      }
+      stack.pop();
+      onStack.delete(node);
+      seen.add(node);
+    }
+
+    dfs(name, [], new Set<string>());
+    return cycles;
+  }
+
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      return build(name, registry, new Set<string>());
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const cycles = findCycles(name, registry);
+      return cycles.length > 0 ? cycles : null;
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return findCycles(name, registry).length > 0;
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const order: string[] = [];
+      const visited = new Set<string>();
+      const onStack = new Set<string>();
+
+      function visit(node: string): void {
+        if (visited.has(node) || onStack.has(node)) {
+          return;
+        }
+        onStack.add(node);
+        for (const dep of depNames(node, registry)) {
+          visit(dep);
+        }
+        onStack.delete(node);
+        visited.add(node);
+        // Dependencies are pushed before the node that needs them.
+        order.push(node);
+      }
+
+      visit(name);
+      return order;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const result = new Set<string>();
+      const visited = new Set<string>();
+
+      function visit(node: string): void {
+        if (visited.has(node)) {
+          return;
+        }
+        visited.add(node);
+        for (const dep of depNames(node, registry)) {
+          result.add(dep);
+          visit(dep);
+        }
+      }
+
+      visit(name);
+      return [...result];
+    },
+  };
+}
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..2c63763
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,89 @@
+import { createRegistry } from './registry/index.js';
+import { createResolver } from './resolver/index.js';
+import { createRunner } from './runner/index.js';
+import { createReviews } from './reviews/index.js';
+import { createDeps } from './deps/index.js';
+import type {
+  PluginManifest,
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+  ResolvedVersion,
+  SandboxResult,
+  VersionConstraint,
+} from './types.js';
+
+export { createRegistry } from './registry/index.js';
+export { createResolver } from './resolver/index.js';
+export { createRunner } from './runner/index.js';
+export { createReviews } from './reviews/index.js';
+export { createDeps } from './deps/index.js';
+
+export interface InstallResult {
+  resolved: ResolvedVersion[];
+  result: SandboxResult;
+}
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest): Promise<InstallResult>;
+}
+
+export interface MarketplaceOptions {
+  dbPath?: string;
+}
+
+/**
+ * Compose all five capabilities into a marketplace with a high-level
+ * installPlugin workflow.
+ */
+export function createMarketplace(options: MarketplaceOptions = {}): Marketplace {
+  const registry = createRegistry();
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviews(options.dbPath);
+  const deps = createDeps();
+
+  async function installPlugin(manifest: PluginManifest): Promise<InstallResult> {
+    // 1. Validate required fields.
+    if (!manifest.name || !manifest.version || !manifest.entryPoint) {
+      throw new Error(
+        'Invalid manifest: name, version, and entryPoint are required',
+      );
+    }
+
+    // 2. Register the plugin in the catalog.
+    registry.register(manifest);
+
+    // 3. Resolve dependency versions against what is available in the registry.
+    const constraints: VersionConstraint[] = Object.entries(
+      manifest.dependencies ?? {},
+    ).map(([name, range]) => ({ name, range }));
+    const available: Record<string, string[]> = {};
+    for (const constraint of constraints) {
+      available[constraint.name] = registry.listVersions(constraint.name);
+    }
+    const resolved = resolver.resolve(constraints, available);
+
+    // 4. Reject installation if a circular dependency is detected.
+    if (deps.hasCircularDependency(manifest.name, registry)) {
+      throw new Error(
+        `Circular dependency detected for plugin "${manifest.name}"`,
+      );
+    }
+
+    // 5. Execute the plugin entry point in the sandbox.
+    const result = await runner.execute(manifest.entryPoint);
+
+    // 6. Return resolved dependency versions and the sandbox execution result.
+    return { resolved, result };
+  }
+
+  return { registry, resolver, runner, reviews, deps, installPlugin };
+}
diff --git a/src/registry/index.ts b/src/registry/index.ts
new file mode 100644
index 0000000..a65cc4f
--- /dev/null
+++ b/src/registry/index.ts
@@ -0,0 +1,111 @@
+import semver from 'semver';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+/**
+ * In-memory plugin catalog. Plugins are keyed by name, and each name maps to a
+ * map of version -> manifest so a single plugin can have many versions.
+ */
+export function createRegistry(): RegistryService {
+  const plugins = new Map<string, Map<string, PluginManifest>>();
+
+  function clone(m: PluginManifest): PluginManifest {
+    return {
+      ...m,
+      dependencies: { ...m.dependencies },
+      permissions: [...m.permissions],
+    };
+  }
+
+  function latestVersion(versions: Map<string, PluginManifest>): string | null {
+    let best: string | null = null;
+    for (const v of versions.keys()) {
+      if (best === null || semver.gt(v, best)) {
+        best = v;
+      }
+    }
+    return best;
+  }
+
+  return {
+    register(manifest: PluginManifest): void {
+      if (!manifest.name || !manifest.version) {
+        throw new Error('Cannot register plugin without name and version');
+      }
+      let versions = plugins.get(manifest.name);
+      if (!versions) {
+        versions = new Map<string, PluginManifest>();
+        plugins.set(manifest.name, versions);
+      }
+      versions.set(manifest.version, clone(manifest));
+    },
+
+    get(name: string): PluginManifest | null {
+      const versions = plugins.get(name);
+      if (!versions || versions.size === 0) {
+        return null;
+      }
+      const latest = latestVersion(versions);
+      return latest ? clone(versions.get(latest)!) : null;
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const versions = plugins.get(name);
+      const manifest = versions?.get(version);
+      return manifest ? clone(manifest) : null;
+    },
+
+    list(): PluginManifest[] {
+      const out: PluginManifest[] = [];
+      for (const versions of plugins.values()) {
+        for (const manifest of versions.values()) {
+          out.push(clone(manifest));
+        }
+      }
+      return out;
+    },
+
+    search(query: string): PluginManifest[] {
+      const q = query.toLowerCase();
+      return this.list().filter(
+        (m) =>
+          m.name.toLowerCase().includes(q) ||
+          m.description.toLowerCase().includes(q) ||
+          m.author.toLowerCase().includes(q),
+      );
+    },
+
+    remove(name: string, version: string): boolean {
+      const versions = plugins.get(name);
+      if (!versions || !versions.has(version)) {
+        return false;
+      }
+      versions.delete(version);
+      if (versions.size === 0) {
+        plugins.delete(name);
+      }
+      return true;
+    },
+
+    listVersions(name: string): string[] {
+      const versions = plugins.get(name);
+      if (!versions) {
+        return [];
+      }
+      return [...versions.keys()].sort(semver.compare);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const versions = plugins.get(name);
+      const existing = versions?.get(version);
+      if (!versions || !existing) {
+        throw new Error(`Plugin ${name}@${version} not found`);
+      }
+      const merged: PluginManifest = { ...existing, ...updates };
+      // Keep identity keys stable unless explicitly changed by the caller.
+      if (updates.version && updates.version !== version) {
+        versions.delete(version);
+      }
+      versions.set(merged.version, clone(merged));
+    },
+  };
+}
