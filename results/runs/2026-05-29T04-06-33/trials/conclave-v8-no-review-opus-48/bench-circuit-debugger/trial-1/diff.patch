+++ b/src/index.ts
@@ -0,0 +1,375 @@
+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string; // input wire name
+  in2: string; // input wire name
+  out: string; // output wire name
+}
+
+function apply(op: Gate['op'], a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+  }
+}
+
+/**
+ * Simulate a combinational circuit of logic gates.
+ *
+ * Gates are evaluated in dependency order: a gate fires only once both of its
+ * input wires have known values. The circuit is assumed acyclic. Returns the
+ * final value (0/1) of every wire, including the provided inputs.
+ */
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values: Record<string, number> = { ...inputs };
+
+  // Worklist topological evaluation (Kahn): a gate fires when its remaining
+  // unresolved inputs reach zero. O(gates + edges).
+  const consumers = new Map<string, number[]>(); // wire -> gates awaiting it
+  const remaining = new Array<number>(gates.length).fill(0);
+  const queue: number[] = [];
+
+  gates.forEach((g, i) => {
+    let need = 0;
+    for (const w of [g.in1, g.in2]) {
+      if (!(w in values)) {
+        need++;
+        let list = consumers.get(w);
+        if (!list) consumers.set(w, (list = []));
+        list.push(i);
+      }
+    }
+    remaining[i] = need;
+    if (need === 0) queue.push(i);
+  });
+
+  while (queue.length > 0) {
+    const i = queue.pop() as number;
+    const g = gates[i];
+    values[g.out] = apply(g.op, values[g.in1], values[g.in2]);
+    const waiting = consumers.get(g.out);
+    if (waiting) {
+      for (const j of waiting) {
+        if (--remaining[j] === 0) queue.push(j);
+      }
+    }
+  }
+
+  // Any gate still blocked depends on a wire that never resolved (e.g. a cycle);
+  // evaluate it best-effort so its output wire still appears (missing input = 0).
+  gates.forEach((g, i) => {
+    if (remaining[i] > 0 && !(g.out in values)) {
+      values[g.out] = apply(g.op, values[g.in1] ?? 0, values[g.in2] ?? 0);
+    }
+  });
+
+  return values;
+}
+
+// ---------------------------------------------------------------------------
+// Wire-name helpers
+// ---------------------------------------------------------------------------
+
+const isX = (w: string): boolean => /^x\d\d$/.test(w);
+const isY = (w: string): boolean => /^y\d\d$/.test(w);
+const isZ = (w: string): boolean => /^z\d\d$/.test(w);
+const isInput = (w: string): boolean => isX(w) || isY(w);
+const idx = (w: string): number => parseInt(w.slice(1), 10);
+
+/** Number of input bits N (inputs x00..x{N-1}). */
+function inputBitCount(gates: Gate[]): number {
+  let max = -1;
+  for (const g of gates) {
+    if (isX(g.in1)) max = Math.max(max, idx(g.in1));
+    if (isX(g.in2)) max = Math.max(max, idx(g.in2));
+  }
+  return max + 1;
+}
+
+/** Highest-numbered z wire (the most-significant output bit / final carry). */
+function topZWire(gates: Gate[]): string {
+  let maxZ = '';
+  for (const g of gates) {
+    if (isZ(g.out) && g.out > maxZ) maxZ = g.out;
+  }
+  return maxZ;
+}
+
+// ---------------------------------------------------------------------------
+// Structural detection
+// ---------------------------------------------------------------------------
+
+/**
+ * Flag wires whose producing gate violates the structural fingerprint of the
+ * role it occupies in a ripple-carry adder. Gate *operations* are never altered
+ * by a swap (only `out` names are exchanged), and a non-swapped wire's set of
+ * consumers is unchanged, so this flags exactly the swapped wires — provided
+ * the two wires of a swap play *distinct* roles. (Same-role swaps are caught by
+ * the functional pass below.) Runs in O(gates).
+ */
+function structuralCandidates(gates: Gate[]): Set<string> {
+  const maxZ = topZWire(gates);
+
+  // For each wire, the operations of the gates that consume it as an input.
+  const consumerOps = new Map<string, Set<Gate['op']>>();
+  const addConsumer = (wire: string, op: Gate['op']) => {
+    let s = consumerOps.get(wire);
+    if (!s) consumerOps.set(wire, (s = new Set()));
+    s.add(op);
+  };
+  for (const g of gates) {
+    addConsumer(g.in1, g.op);
+    addConsumer(g.in2, g.op);
+  }
+  const feeds = (wire: string, op: Gate['op']): boolean => consumerOps.get(wire)?.has(op) ?? false;
+
+  const faulty = new Set<string>();
+  for (const g of gates) {
+    const { op, in1, in2, out } = g;
+    const primaryInputs = isInput(in1) && isInput(in2);
+    const isBit0 = (in1 === 'x00' && in2 === 'y00') || (in1 === 'y00' && in2 === 'x00');
+
+    if (isZ(out)) {
+      // Anything writing a z wire must be the bit XOR, except the top carry (OR).
+      if (out === maxZ) {
+        if (op !== 'OR') faulty.add(out);
+      } else if (op !== 'XOR') {
+        faulty.add(out);
+      }
+    }
+
+    if (op === 'XOR') {
+      if (primaryInputs) {
+        // First-level XOR: bit-0 half-adder sum (z00), else partial sum t_i,
+        // which must feed an XOR and an AND (never an OR), and isn't a z wire.
+        if (isBit0) {
+          if (out !== 'z00') faulty.add(out);
+        } else if (isZ(out)) {
+          faulty.add(out);
+        } else if (feeds(out, 'OR') || !(feeds(out, 'XOR') && feeds(out, 'AND'))) {
+          faulty.add(out);
+        }
+      } else if (!isZ(out)) {
+        // Second-level XOR must produce a z output (the final sum bit).
+        faulty.add(out);
+      }
+    } else if (op === 'AND') {
+      if (isZ(out)) faulty.add(out); // AND never writes a z wire
+      if (isBit0) {
+        // c00 carry feeds bit-1's XOR and AND, not an OR.
+        if (feeds(out, 'OR')) faulty.add(out);
+      } else if (!feeds(out, 'OR') || feeds(out, 'XOR') || feeds(out, 'AND')) {
+        // Generate/propagate carry term: must feed (only) an OR.
+        faulty.add(out);
+      }
+    } else {
+      // OR: a carry. Either the top output bit, or feeds next bit's XOR and AND.
+      if (isZ(out)) {
+        if (out !== maxZ) faulty.add(out);
+      } else if (feeds(out, 'OR') || !(feeds(out, 'XOR') && feeds(out, 'AND'))) {
+        faulty.add(out);
+      }
+    }
+  }
+  return faulty;
+}
+
+// ---------------------------------------------------------------------------
+// Functional verification
+// ---------------------------------------------------------------------------
+
+// Bit ops use arithmetic, not bitwise operators, so they stay correct past 31
+// bits. Sums for <=45-bit adders fit comfortably in a safe JS integer.
+const bitAt = (n: number, i: number): number => Math.floor(n / 2 ** i) % 2;
+
+/** Test vectors that exercise every bit and the carry chain. */
+function testVectors(bits: number): Array<[number, number]> {
+  const vs: Array<[number, number]> = [];
+  for (let i = 0; i < bits; i++) {
+    const bit = 2 ** i;
+    vs.push([bit, 0], [0, bit], [bit, bit]);
+    const low = 2 ** (i + 1) - 1;
+    vs.push([low, 1], [1, low]);
+  }
+  return vs;
+}
+
+/**
+ * Topological ordering of gate indices for fast repeated evaluation. Returns
+ * null if the circuit has a cycle (which a swap may have introduced).
+ * O(gates + edges).
+ */
+function topoOrder(gates: Gate[]): number[] | null {
+  const consumers = new Map<string, number[]>();
+  const indeg = new Array<number>(gates.length).fill(0);
+  const isProduced = new Set<string>(gates.map((g) => g.out));
+
+  gates.forEach((g, i) => {
+    for (const w of [g.in1, g.in2]) {
+      if (isProduced.has(w)) {
+        indeg[i]++;
+        let list = consumers.get(w);
+        if (!list) consumers.set(w, (list = []));
+        list.push(i);
+      }
+    }
+  });
+
+  const order: number[] = [];
+  const queue: number[] = [];
+  gates.forEach((_, i) => {
+    if (indeg[i] === 0) queue.push(i);
+  });
+  while (queue.length > 0) {
+    const i = queue.pop() as number;
+    order.push(i);
+    const waiting = consumers.get(gates[i].out);
+    if (waiting) {
+      for (const j of waiting) {
+        if (--indeg[j] === 0) queue.push(j);
+      }
+    }
+  }
+  if (order.length !== gates.length) return null; // cycle
+  return order;
+}
+
+/**
+ * Lowest output-bit position that is wrong for some test vector, or bits+1 if
+ * the circuit adds correctly. Returns -1 if the circuit is cyclic (unusable).
+ */
+function firstWrongBit(gates: Gate[], bits: number, vectors: Array<[number, number]>): number {
+  const order = topoOrder(gates);
+  if (!order) return -1;
+
+  let worst = bits + 1;
+  for (const [x, y] of vectors) {
+    const values: Record<string, number> = {};
+    for (let i = 0; i < bits; i++) {
+      values['x' + String(i).padStart(2, '0')] = bitAt(x, i);
+      values['y' + String(i).padStart(2, '0')] = bitAt(y, i);
+    }
+    for (const gi of order) {
+      const g = gates[gi];
+      values[g.out] = apply(g.op, values[g.in1] ?? 0, values[g.in2] ?? 0);
+    }
+    let got = 0;
+    for (const w in values) {
+      if (isZ(w)) got += values[w] * 2 ** idx(w);
+    }
+    const want = x + y;
+    if (got === want) continue;
+    for (let i = 0; i <= bits && i < worst; i++) {
+      if (bitAt(got, i) !== bitAt(want, i)) {
+        worst = i;
+        break;
+      }
+    }
+    if (worst === 0) break;
+  }
+  return worst;
+}
+
+function swapOut(gates: Gate[], i: number, j: number): void {
+  const t = gates[i].out;
+  gates[i].out = gates[j].out;
+  gates[j].out = t;
+}
+
+/** Ancestor gate-output wires feeding `wire` (its cone of influence). */
+function cone(producer: Map<string, number>, gates: Gate[], wire: string): Set<string> {
+  const seen = new Set<string>();
+  const stack = [wire];
+  while (stack.length) {
+    const w = stack.pop() as string;
+    const gi = producer.get(w);
+    if (gi === undefined || seen.has(w)) continue;
+    seen.add(w);
+    stack.push(gates[gi].in1, gates[gi].in2);
+  }
+  return seen;
+}
+
+/**
+ * Greedy functional repair. Repeatedly locate the lowest wrong output bit and
+ * find the output-wire swap that pushes that frontier highest, collecting up to
+ * four swaps. Handles swaps the structural pass cannot see (same-role pairs).
+ * Returns the set of all swapped wires, or null if it cannot fully repair.
+ */
+function functionalCandidates(gates: Gate[], bits: number): Set<string> | null {
+  const work = gates.map((g) => ({ ...g }));
+  const vectors = testVectors(bits);
+  const swapped = new Set<string>();
+
+  for (let step = 0; step < 4; step++) {
+    const base = firstWrongBit(work, bits, vectors);
+    if (base > bits) break; // fully correct
+
+    const producer = new Map<string, number>();
+    work.forEach((g, i) => producer.set(g.out, i));
+    // Candidate region: gates feeding the lowest broken bit (and the next one).
+    const region = cone(producer, work, 'z' + String(Math.min(base, bits)).padStart(2, '0'));
+    if (base + 1 <= bits) {
+      for (const w of cone(producer, work, 'z' + String(base + 1).padStart(2, '0'))) region.add(w);
+    }
+    const regionIdx = [...region].map((w) => producer.get(w)!).filter((i) => i !== undefined);
+    const allIdx = work.map((_, i) => i);
+
+    let best: [number, number] | null = null;
+    let bestScore = base;
+    for (const i of regionIdx) {
+      for (const j of allIdx) {
+        if (i === j) continue;
+        swapOut(work, i, j);
+        // firstWrongBit returns -1 for a cyclic swap, so it is never selected.
+        const score = firstWrongBit(work, bits, vectors);
+        if (score > bestScore) {
+          bestScore = score;
+          best = [i, j];
+        }
+        swapOut(work, i, j); // revert
+      }
+    }
+    if (!best) return null; // stuck
+    const [bi, bj] = best;
+    // Record the two wire names involved, then commit the swap.
+    swapped.add(work[bi].out);
+    swapped.add(work[bj].out);
+    swapOut(work, bi, bj);
+  }
+
+  return firstWrongBit(work, bits, vectors) > bits ? swapped : null;
+}
+
+/**
+ * Find the 8 wires (4 swapped pairs) that break a ripple-carry adder computing
+ * X + Y = Z. Returns them sorted.
+ *
+ * Strategy: a fast O(n) structural scan flags wires whose gate violates the
+ * adder's wiring pattern. A non-swapped gate keeps its correct output name and
+ * (swap-invariant) consumer set, so it never trips a rule — the scan therefore
+ * only ever flags genuinely swapped wires (it is a subset of the true 8). Since
+ * exactly 8 wires are swapped, flagging 8 means we have found all of them.
+ *
+ * The scan is blind only to swaps between two wires of identical structural
+ * role (e.g. two sum outputs, or a partial-sum and a carry — both feed one XOR
+ * and one AND). For those rare cases we fall back to a functional, bit-by-bit
+ * greedy repair.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  const bits = inputBitCount(gates);
+  const structural = structuralCandidates(gates);
+
+  // No false positives + exactly 8 swapped wires => 8 flagged means all 8 found.
+  if (structural.size === 8) return [...structural].sort();
+
+  // Some swaps were structurally invisible; recover them functionally.
+  const functional = functionalCandidates(gates, bits);
+  if (functional && functional.size === 8) return [...functional].sort();
+
+  // Best effort: return whichever non-empty set we have.
+  return [...(functional ?? structural)].sort();
+}
