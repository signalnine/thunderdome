uts z00..z{N}). */\nfunction buildAdder(bits: number): Gate[] {\n  const gates: Gate[] = [];\n  // bit 0 half adder\n  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });\n  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });\n  let carry = 'c00';\n  for (let i = 1; i < bits; i++) {\n    const p = pad(i);\n    const t = `t${p}`;\n    const a = `a${p}`;\n    const b = `b${p}`;\n    const c = `c${p}`;\n    gates.push({ op: 'XOR', in1: `x${p}`, in2: `y${p}`, out: t });\n    gates.push({ op: 'AND', in1: `x${p}`, in2: `y${p}`, out: a });\n    gates.push({ op: 'XOR', in1: t, in2: carry, out: `z${p}` });\n    gates.push({ op: 'AND', in1: t, in2: carry, out: b });\n    gates.push({ op: 'OR', in1: a, in2: b, out: c });\n    carry = c;\n  }\n  // final carry is the most significant output bit\n  // rename last carry's gate output to z{bits}\n  const top = `z${pad(bits)}`;\n  const last = gates[gates.length - 1];\n  last.out = top;\n  return gates;\n}\n\nfunction applySwap(gates: Gate[], wa: string, wb: string): void {\n  const ga = gates.find((g) => g.out === wa)!;\n  const gb = gates.find((g) => g.out === wb)!;\n  ga.out = wb;\n  gb.out = wa;\n}\n\n/** Deterministic PRNG so tests are reproducible. */\nfunction makeRng(seed: number) {\n  let s = seed >>> 0;\n  return () => {\n    s = (s * 1664525 + 1013904223) >>> 0;\n    return s / 0x100000000;\n  };\n}\n\n/** True if the gate graph is acyclic (a swap may have introduced a cycle). */\nfunction isAcyclic(gates: Gate[]): boolean {\n  const producer = new Map<string, Gate>();\n  for (const g of gates) producer.set(g.out, g);\n  const state = new Map<string, number>(); // 0=visiting,1=done\n  const visit = (wire: string): boolean => {\n    const g = producer.get(wire);\n    if (!g) return true; // primary input\n    const st = state.get(wire);\n    if (st === 1) return true;\n    if (st === 0) return false; // back edge -> cycle\n    state.set(wire, 0);\n    if (!visit(g.in1) || !visit(g.in2)) return false;