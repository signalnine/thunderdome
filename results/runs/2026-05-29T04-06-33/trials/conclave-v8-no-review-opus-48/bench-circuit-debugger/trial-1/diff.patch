. Keying on\n * consumers (not the producer op) is exactly what characterises detectability.\n */\nfunction fingerprints(gates: Gate[]): Map<string, string> {\n  const consumers = new Map<string, string[]>();\n  for (const g of gates) {\n    for (const w of [g.in1, g.in2]) {\n      if (!consumers.has(w)) consumers.set(w, []);\n      consumers.get(w)!.push(g.op);\n    }\n  }\n  const fp = new Map<string, string>();\n  for (const g of gates) {\n    const cons = (consumers.get(g.out) ?? []).slice().sort().join(',');\n    // Terminal outputs (the z register) all share an empty consumer set; group\n    // them together so the random generator skips structurally-blind z<->z.\n    fp.set(g.out, cons === '' ? 'TERMINAL' : cons);\n  }\n  return fp;\n}","originalFile":"import { describe, it, expect } from 'vitest';\nimport { simulate, findSwappedWires, type Gate } from './index.js';\n\n// ---------------------------------------------------------------------------\n// Helpers: build a correct ripple-carry adder and apply controlled swaps.\n// ---------------------------------------------------------------------------\n\nconst pad = (n: number): string => n.toString().padStart(2, '0');\n\n/** Build a correct N-bit ripple-carry adder (inputs x00..,y00..; outputs z00..z{N}). */\nfunction buildAdder(bits: number): Gate[] {\n  const gates: Gate[] = [];\n  // bit 0 half adder\n  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });\n  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });\n  let carry = 'c00';\n  for (let i = 1; i < bits; i++) {\n    const p = pad(i);\n    const t = `t${p}`;\n    const a = `a${p}`;\n    const b = `b${p}`;\n    const c = `c${p}`;\n    gates.push({ op: 'XOR', in1: `x${p}`, in2: `y${p}`, out: t });\n    gates.push({ op: 'AND', in1: `x${p}`, in2: `y${p}`, out: a });\n    gates.push({ op: 'XOR', in1: t, in2: carry, out: `z${p}` });\n    gates.push({ op: 'AND', in1: t, in2: carry, out: b });\n    gates.push({ op: 'OR', in1: a, in2: b, out: c });\n    carry = c;\n  }\n  // final carry is the most significant output bit\n  // rename last carry's gate output to z{bits}\n  const top = `z${pad(bits)}`;\n  const last = gates[gates.length - 1];\n  last.out = top;\n  return gates;\n}\n\nfunction applySwap(gates: Gate[], wa: string, wb: string): void {\n  const ga = gates.find((g) => g.out === wa)!;\n  const gb = gates.find((g) => g.out === wb)!;\n  ga.out = wb;\n  gb.out = wa;\n}\n\n/**\n * Structural fingerprint of each output wire in a CLEAN adder: its gate's op\n * plus the sorted ops of its consumers. Two wires with the same fingerprint are\n * interchangeable, so a swap between them is not uniquely recoverable by any\n * algorithm — a well-posed problem never swaps such a pair. Used to keep the\n * random test focused on recoverable swaps.\n */\nfunction fingerprints(gates: Gate[]): Map<string, string> {\n  const consumers = new Map<string, string[]>();\n  for (const g of gates) {\n    for (const w of [g.in1, g.in2]) {\n      if (!consumers.has(w)) consumers.set(w, []);\n      consumers.get(w)!.push(g.op);\n    }\n  }\n  const fp = new Map<string, string>();\n  for (const g of gates) {\n    const cons = (consumers.get(g.out) ?? []).slice().sort().join(',');\n    fp.set(g.out, `${g.op}|${cons}`);\n  }\n  return fp;\n}\n\n/** Deterministic PRNG so tests are reproducible. */\nfunction makeRng(seed: number) {\n  let s = seed >>> 0;\n  return () => {\n    s = (s * 1664525 + 1013904223) >>> 0;\n    return s / 0x100000000;\n  };\n}\n\n/** True if the gate graph is acyclic (a swap may have introduced a cycle). */\nfunction isAcyclic(gates: Gate[]): boolean {\n  const producer = new Map<string, Gate>();\n  for (const g of gates) producer.set(g.out, g);\n  const state = new Map<string, number>(); // 0=visiting,1=done\n  const visit = (wire: string): boolean => {\n    const g = producer.get(wire);\n    if (!g) return true; // primary input\n    const st = state.get(wire);\n    if (st === 1) return true;\n    if (st === 0) return false; // back edge -> cycle\n    state.set(wire, 0);\n    if (!visit(g.in1) || !visit(g.in2)) return false;\n    state.set(wire, 1);\n    return true;\n  };\n  return gates.every((g) => visit(g.out));\n}\n\n/** Decode the z wires of a simulation result into an integer. */\nfunction decodeZ(values: Record<string, number>): bigint {\n  let n = 0n;\n  for (const [w, v] of Object.entries(values)) {\n    if (/^z\\d\\d$/.test(w)) n |= BigInt(v) << BigInt(parseInt(w.slice(1), 10));\n  }\n  return n;\n}\n\nfunction setInputs(bits: number, x: bigint, y: bigint): Record<string, number> {\n  const inputs: Record<string, number> = {};\n  for (let i = 0; i < bits; i++) {\n    inputs[`x${pad(i)}`] = Number((x >> BigInt(i)) & 1n);\n    inputs[`y${pad(i)}`] = Number((y >> BigInt(i)) & 1n);\n  }\n  return inputs;\n}\n\n// ---------------------------------------------------------------------------\n// simulate\n// ---------------------------------------------------------------------------\n\ndescribe('simulate', () => {\n  it('returns inputs unchanged when there are no gates', () => {\n    expect(simulate([], { a: 1, b: 0 })).toEqual({ a: 1, b: 0 });\n  });\n\n  it('computes AND', () => {\n    expect(simulate([{ op: 'AND', in1: 'a', in2: 'b', out: 'o' }], { a: 1, b: 1 }).o).toBe(1);\n    expect(simulate([{ op: 'AND', in1: 'a', in2: 'b', out: 'o' }], { a: 1, b: 0 }).o).toBe(0);\n    expect(simulate([{ op: 'AND', in1: 'a', in2: 'b', out: 'o' }], { a: 0, b: 0 }).o).toBe(0);\n  });\n\n  it('computes OR', () => {\n    expect(simulate([{ op: 'OR', in1: 'a', in2: 'b', out: 'o' }], { a: 1, b: 0 }).o).toBe(1);\n    expect(simulate([{ op: 'OR', in1: 'a', in2: 'b', out: 'o' }], { a: 0, b: 0 }).o).toBe(0);\n    expect(simulate([{ op: 'OR', in1: 'a', in2: 'b', out: 'o' }], { a: 1, b: 1 }).o).toBe(1);\n  });\n\n  it('computes XOR', () => {\n    expect(simulate([{ op: 'XOR', in1: 'a', in2: 'b', out: 'o' }], { a: 1, b: 0 }).o).toBe(1);\n    expect(simulate([{ op: 'XOR', in1: 'a', in2: 'b', out: 'o' }], { a: 1, b: 1 }).o).toBe(0);\n    expect(simulate([{ op: 'XOR', in1: 'a', in2: 'b', out: 'o' }], { a: 0, b: 0 }).o).toBe(0);\n  });\n\n  it('resolves chained gates and is order-independent', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'm', in2: 'd', out: 'o' }, // depends on m\n      { op: 'XOR', in1: 'a', in2: 'b', out: 'm' },\n    ];\n    const r = simulate(gates, { a: 1, b: 0, d: 1 });\n    expect(r.m).toBe(1);\n    expect(r.o).toBe(1);\n    // reversed order, same result\n    expect(simulate([...gates].reverse(), { a: 1, b: 0, d: 1 })).toEqual(r);\n  });\n\n  it('returns every wire', () => {\n    const r = simulate([{ op: 'XOR', in1: 'a', in2: 'b', out: 'o' }], { a: 1, b: 0 });\n    expect(Object.keys(r).sort()).toEqual(['a', 'b', 'o']);\n  });\n\n  it('a correct adder computes X + Y = Z for many inputs', () => {\n    const bits = 8;\n    const gates = buildAdder(bits);\n    const rng = makeRng(99);\n    for (let k = 0; k < 200; k++) {\n      const max = (1n << BigInt(bits)) - 1n;\n      const x = BigInt(Math.floor(rng() * Number(max + 1n)));\n      const y = BigInt(Math.floor(rng() * Number(max + 1n)));\n      const r = simulate(gates, setInputs(bits, x, y));\n      expect(decodeZ(r)).toBe(x + y);\n    }\n  });\n\n  it('handles a deep 45-bit adder', () => {\n    const bits = 45;\n    const gates = buildAdder(bits);\n    const x = (1n << 45n) - 1n;\n    const y = 1n;\n    expect(decodeZ(simulate(gates, setInputs(bits, x, y)))).toBe(x + y);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// findSwappedWires\n// ---------------------------------------------------------------------------\n\ndescribe('findSwappedWires', () => {\n  it('returns [] for a correct adder', () => {\n    expect(findSwappedWires(buildAdder(8))).toEqual([]);\n  });\n\n  it('detects a single swapped pair (z output <-> internal)', () => {\n    const gates = buildAdder(8);\n    applySwap(gates, 'z03', 'a03'); // sum bit swapped with a generate term\n    const found = findSwappedWires(gates);\n    expect(found).toContain('z03');\n    expect(found).toContain('a03');\n  });\n\n  it('returns a sorted array', () => {\n    const gates = buildAdder(8);\n    applySwap(gates, 'z05', 'b05');\n    const found = findSwappedWires(gates);\n    expect(found).toEqual([...found].sort());\n  });\n\n  it('detects 4 swapped pairs and computes a correct adder once unswapped', () => {\n    const bits = 16;\n    const gates = buildAdder(bits);\n    const pairs: [string, string][] = [\n      ['z02', 'a02'],\n      ['z06', 'b06'],\n      ['z10', 'c10'],\n      ['t13', 'a13'],\n    ];\n    const expected = pairs.flat().sort();\n    for (const [u, v] of pairs) applySwap(gates, u, v);\n    expect(findSwappedWires(gates)).toEqual(expected);\n  });\n\n  it('finds swaps across many random adders (8..45 bits, 4 well-posed swaps)', () => {\n    const rng = makeRng(2024);\n    let trials = 0;\n    for (let t = 0; t < 400; t++) {\n      const bits = 8 + Math.floor(rng() * 38); // 8..45\n      const clean = buildAdder(bits);\n      // A swap is only *recoverable* if the two wires play distinct structural\n      // roles. Two wires with identical fingerprints (e.g. two AND-terms that\n      // both feed an OR) are interchangeable — no algorithm could tell which\n      // pairing was the \"real\" one — so a well-posed problem never swaps them.\n      const fp = fingerprints(clean);\n      const gates = clean.map((g) => ({ ...g }));\n      const outs = gates.map((g) => g.out);\n      const used = new Set<string>();\n      const pairs: [string, string][] = [];\n      let guard = 0;\n      while (pairs.length < 4 && guard++ < 2000) {\n        const a = outs[Math.floor(rng() * outs.length)];\n        const b = outs[Math.floor(rng() * outs.length)];\n        if (a === b || used.has(a) || used.has(b)) continue;\n        if (fp.get(a) === fp.get(b)) continue; // ambiguous, skip\n        applySwap(gates, a, b);\n        if (isAcyclic(gates)) {\n          used.add(a);\n          used.add(b);\n          pairs.push([a, b]);\n        } else {\n          applySwap(gates, a, b); // revert cyclic swap\n        }\n      }\n      if (pairs.length < 4) continue; // couldn't build 4 swaps; skip\n      trials++;\n      const expected = [...used].sort();\n      const found = findSwappedWires(gates);\n      // The structural detector must flag exactly the swapped wires.\n      expect(found).toEqual(expected);\n    }\n    expect(trials).toBeGreaterThan(50);\n  });\n\n  it('detects same-role swaps via the functional fallback (two sum bits)', () => {\n    const gates = buildAdder(12);\n    applySwap(gates, 'z03', 'z07'); // two second-level sum XORs: structurally identical\n    expect(findSwappedWires(gates)).toEqual(['z03', 'z07']);\n  });\n\n  it('detects a mix of structural and same-role swaps', () => {\n    const gates = buildAdder(20);\n    applySwap(gates, 'z04', 'z09'); // same-role (sum/sum)\n    applySwap(gates, 'z12', 'a12'); // distinct-role (sum/generate)\n    applySwap(gates, 't08', 'a08'); // distinct-role (partial-sum/generate), acyclic\n    applySwap(gates, 'z16', 'z18'); // same-role (sum/sum)\n    expect(findSwappedWires(gates)).toEqual(\n      ['a08', 'a12', 't08', 'z04', 'z09', 'z12', 'z16', 'z18'].sort(),\n    );\n  });\n\n  it('completes a 45-bit circuit quickly', () => {\n    const gates = buildAdder(45);\n    applySwap(gates, 'z10', 'a10');\n    applySwap(gates, 'z20', 'b20');\n    applySwap(gates, 'z30', 'c30');\n    applySwap(gates, 't40', 'a40');\n    const start = performance.now();\n    const found = findSwappedWires(gates);\n    const elapsed = performance.now() - start;\n    expect(elapsed).toBeLessThan(5000);\n    expect(found).toEqual(['a10', 'a40', 'b20', 'c30', 't40', 'z10', 'z20', 'z30'].sort());\n  });\n});\n","structuredPatch":[{"oldStart":43,"oldLines":11,"newStart":43,"newLines":16,"lines":[" }"," "," /**","- * Structural fingerprint of each output wire i