n  for (const g of gates) {\n    for (const w of [g.in1, g.in2]) {\n      if (!consumers.has(w)) consumers.set(w, []);\n      consumers.get(w)!.push(g.op);\n    }\n  }\n  const fp = new Map<string, string>();\n  for (const g of gates) {\n    const cons = (consumers.get(g.out) ?? []).slice().sort().join(',');\n    // Terminal outputs (the z register) all share an empty consumer set; group\n    // them together so the random generator skips structurally-blind z<->z.\n    fp.set(g.out, cons === '' ? 'TERMINAL' : cons);\n  }\n  return fp;\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":2360,"cache_read_input_tokens":104802,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2360},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6390c177-33c1-444e-b750-2c06d1d10f28","uuid":"87b738b2-bf98-4f7f-b5bb-c14a139087ac","request_id":"req_011CbWL7C5EXjZQSHorzrxXo"}
