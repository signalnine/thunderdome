ame-role (sum/sum)\n    expect(findSwappedWires(gates)).toEqual(\n      ['a08', 'a12', 't08', 'z04', 'z09', 'z12', 'z16', 'z18'].sort(),\n    );\n  });\n\n  it('completes a 45-bit circuit quickly', () => {\n    const gates = buildAdder(45);\n    applySwap(gates, 'z10', 'a10');\n    applySwap(gates, 'z20', 'b20');\n    applySwap(gates, 'z30', 'c30');\n    applySwap(gates, 't40', 'a40');\n    const start = performance.now();\n    const found = findSwappedWires(gates);\n    const elapsed = performance.now() - start;\n    expect(elapsed).toBeLessThan(5000);\n    expect(found).toEqual(['a10', 'a40', 'b20', 'c30', 't40', 'z10', 'z20', 'z30'].sort());\n  });\n});\n","structuredPatch":[{"oldStart":43,"oldLines":35,"newStart":43,"newLines":40,"lines":[" }"," "," /**","- * Structural fingerprint of each output wire in a CLEAN adder: the sorted ops","- * of the gates that *consume* it, plus whether it is a terminal z output.","- *","- * A wire's consumer set is invariant under output-wire swaps (consumers key on","- * input-wire names, which a swap never touches). So two wires with the same","- * consumer fingerprint are structurally interchangeable — e.g. a partial-sum","- * t_i and a carry c_j both feed exactly one XOR and one AND. Swapping such a","- * pair leaves every gate satisfying its role, so no structural analysis can","- * recover it; a well-posed/AoC-style problem never swaps them. Keying on","- * consumers (not the producer op) is exactly what characterises detectability.","+ * Structural role of a clean-adder output wire, from its name. `maxZ` is the","+ * top carry (OR) and `c00` is the bit-0 carry — both are special and excluded","+ * from the random generator.","  */","-function fingerprints(gates: Gate[]): Map<string, string> {","-  const consumers = new Map<string, string[]>();","-  for (const g of gates) {","-    for (const w of [g.in1, g.in2]) {","-      if (!consumers.has(w)) consumers.set(w, []);","-      consumers.get(w)!.push(g.op);","-    }","-  }","-