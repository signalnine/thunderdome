];\n  const activeButtons: number[] = [];\n  for (let j = 0; j < m; j++) {\n    const col = new Array<number>(n).fill(0);\n    let any = false;\n    for (const ci of buttons[j]) {\n      if (ci >= 0 && ci < n) col[ci] = (col[ci] + 1) % p;\n    }\n    for (let i = 0; i < n; i++) if (col[i] !== 0) any = true;\n    if (any) {\n      cols.push(col);\n      activeButtons.push(j);\n    }\n  }\n  const k = cols.length;\n\n  // Augmented matrix over GF(p): n rows, k+1 columns (last = rhs / lights).\n  const rows: number[][] = [];\n  for (let i = 0; i < n; i++) {\n    const row = new Array<number>(k + 1).fill(0);\n    for (let j = 0; j < k; j++) row[j] = cols[j][i];\n    row[k] = ((lights[i] % p) + p) % p;\n    rows.push(row);\n  }\n\n  // Reduced row-echelon form over GF(p) using modular inverses (p prime).\n  const inv = buildInverses(p);\n  const pivotRowOfCol: number[] = new Array(k).fill(-1);\n  let pivotRow = 0;\n  for (let col = 0; col < k && pivotRow < rows.length; col++) {\n    let sel = -1;\n    for (let r = pivotRow; r < rows.length; r++) {\n      if (rows[r][col] !== 0) {\n        sel = r;\n        break;\n      }\n    }\n    if (sel === -1) continue;\n    [rows[pivotRow], rows[sel]] = [rows[sel], rows[pivotRow]];\n    // normalize pivot row so pivot == 1\n    const pr = rows[pivotRow];\n    const f0 = inv[pr[col]];\n    for (let c = col; c <= k; c++) pr[c] = (pr[c] * f0) % p;\n    // eliminate column from all other rows\n    for (let r = 0; r < rows.length; r++) {\n      if (r !== pivotRow && rows[r][col] !== 0) {\n        const factor = rows[r][col];\n        const a = rows[r];\n        for (let c = col; c <= k; c++) {\n          // ((..) % p + p) % p keeps the result in 0..p-1 and avoids JS's `-0`.\n          a[c] = (((a[c] - factor * pr[c]) % p) + p) % p;\n        }\n      }\n    }\n    pivotRowOfCol[col] = pivotRow;\n    pivotRow++;\n  }\n\n  // Consistency check.\n  for (const row of rows) {\n    let allZero = true;\n    for (let c = 0; c < k; c++) {\n     