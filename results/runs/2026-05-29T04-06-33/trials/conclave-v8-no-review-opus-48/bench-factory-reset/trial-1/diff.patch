j < buttons.length; j++) {\n    const times = presses[j];\n    for (const ci of buttons[j]) {\n      if (ci >= 0 && ci < n) counters[ci] = (counters[ci] + times) % mod;\n    }\n  }\n  return counters;\n}\n\nfunction eqNum(a: number[], b: number[]): boolean {\n  return a.length === b.length && a.every((v, i) => v === b[i]);\n}\n\nfunction lexLessArr(a: number[], b: number[]): boolean {\n  for (let i = 0; i < a.length; i++) {\n    if (a[i] !== b[i]) return a[i] < b[i];\n  }\n  return false;\n}\n\n// brute force: min total presses then lexicographically smallest array\nfunction bruteCounter(lights: number[], buttons: number[][], mod: number): number[] | null {\n  const m = buttons.length;\n  const cur = new Array<number>(m).fill(0);\n  let best: number[] | null = null;\n  const total = Math.pow(mod, m);\n  for (let it = 0; it < total; it++) {\n    if (eqNum(simulate(buttons, cur, lights.length, mod), lights)) {\n      const sum = cur.reduce((s, v) => s + v, 0);\n      const bestSum = best ? best.reduce((s, v) => s + v, 0) : Infinity;\n      if (best === null || sum < bestSum || (sum === bestSum && lexLessArr(cur, best))) {\n        best = [...cur];\n      }\n    }\n    // increment odometer base mod\n    let i = 0;\n    while (i < m) {\n      cur[i]++;\n      if (cur[i] === mod) {\n        cur[i] = 0;\n        i++;\n      } else break;\n    }\n  }\n  return best;\n}\n\nfunction assertValid(lights: number[], buttons: number[][], mod: number, result: number[]): void {\n  expect(result.length).toBe(buttons.length);\n  for (const v of result) {\n    expect(v).toBeGreaterThanOrEqual(0);\n    expect(v).toBeLessThan(mod);\n  }\n  expect(eqNum(simulate(buttons, result, lights.length, mod), lights)).toBe(true);\n}\n\n// ---- tests ------------------------------------------------------------------\n\ndescribe('solveCounter', () => {\n  it('returns all-zero when target is all-zero', () => {\n    expect(solveCounter([0, 0, 0], [[0], [1], [2]], 5)).toEqual([0, 0, 0]);\n  });\n\n  it('solves a basic case', () => {\n    const r = solveCounter([3, 0], [[0], [1]], 5)!;\n    assertValid([3, 0], [[0], [1]], 5, r);\n    expect(r).toEqual([3, 0]);\n  });\n\n  it('wraps around the modulus', () => {\n    // target 1 on counter 0, mod 5; button increments by 1 -> press once\n    const r = solveCounter([1], [[0]], 5)!;\n    expect(r).toEqual([1]);\n  });\n\n  it('requires multiple presses of a button when needed', () => {\n    // only way to reach 4 on the single counter is pressing button 4 times\n    const r = solveCounter([4], [[0]], 7)!;\n    expect(r).toEqual([4]);\n  });\n\n  it('button affecting no counters is pressed zero times', () => {\n    const lights = [2];\n    const buttons = [[], [0]];\n    const r = solveCounter(lights, buttons, 5)!;\n    assertValid(lights, buttons, 5, r);\n    expect(r[0]).toBe(0);\n    expect(r[1]).toBe(2);\n  });\n\n  it('duplicate counter indices within a button add up per press', () => {\n    // button 0 = [0,0] increments counter 0 by 2 per press; reach 4 mod 5 -> press twice\n    const lights = [4];\n    const buttons = [[0, 0]];\n    const r = solveCounter(lights, buttons, 5)!;\n    assertValid(lights, buttons, 5, r);\n    expect(r).toEqual([2]);\n  });\n\n  it('ignores out-of-range counter indices', () => {\n    const lights = [3];\n    const buttons = [[9], [0]];\n    const r = solveCounter(lights, buttons, 5)!;\n    assertValid(lights, buttons, 5, r);\n    expect(r[0]).toBe(0);\n  });\n\n  it('returns null when inconsistent', () => {\n    // two counters forced equal by one button, but target differs\n    const r = solveCounter([1, 2], [[0, 1]], 5);\n    expect(r).toBeNull();\n  });\n\n  it('minimizes total presses across redundant buttons', () => {\n    // counter 0 target 2 mod 5. button0 +1, button1 +1, button2 +2(=[0,0]) per press.\n    // min total: press button2 once (total 1) reaches 2.\n    const lights = [2];\n    const buttons = [[0], [0], [0, 0]];\n    const r = solveCounter(lights, buttons, 5)!;\n    assertValid(lights, buttons, 5, r);\n    expect(r.reduce((s, v) => s + v, 0)).toBe(1);\n    expect(r).toEqual([0, 0, 1]);\n  });\n\n  it('breaks total ties by lexicographically smallest array', () => {\n    // counter 0 target 1 mod 5; buttons 0 and 1 both +1. min total 1; tie between\n    // [1,0] and [0,1]; lexicographically smallest array is [0,1] (index 0: 0 < 1).\n    const lights = [1];\n    const buttons = [[0], [0]];\n    const r = solveCounter(lights, buttons, 5)!;\n    assertValid(lights, buttons, 5, r);\n    expect(r).toEqual([0, 1]);\n  });\n\n  it('does not mutate inputs', () => {\n    const lights = [1, 2, 3];\n    const buttons = [[0], [1], [2], [0, 1, 2]];\n    const snap = JSON.stringify([lights, buttons]);\n    solveCounter(lights, buttons, 7);\n    expect(JSON.stringify([lights, buttons])).toEqual(snap);\n  });\n\n  it('matches brute force across many random small instances', () => {\n    let seed = 54321;\n    const rng = () => (seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff;\n    const primes = [2, 3, 5, 7];\n    for (let t = 0; t < 250; t++) {\n      const mod = primes[Math.floor(rng() * primes.length)];\n      const n = 1 + Math.floor(rng() * 4);\n      const m = Math.floor(rng() * 5);\n      const buttons: number[][] = [];\n      for (let j = 0; j < m; j++) {\n        const set: number[] = [];\n        for (let ci = 0; ci < n; ci++) if (rng() < 0.5) set.push(ci);\n        buttons.push(set);\n      }\n      const lights: number[] = [];\n      for (let ci = 0; ci < n; ci++) lights.push(Math.floor(rng() * mod));\n      const got = solveCounter(lights, buttons, mod);\n      const exp = bruteCounter(lights, buttons, mod);\n      if (exp === null) {\n        expect(got).toBeNull();\n      } else {\n        expect(got).not.toBeNull();\n        assertValid(lights, buttons, mod, got!);\n        const gotSum = got!.reduce((s, v) => s + v, 0);\n        const expSum = exp.reduce((s, v) => s + v, 0);\n        expect(gotSum).toBe(expSum)