  }\n  }\n\n  const cur = Int32Array.from(particular);\n  let curSum = sumArr(particular);\n  let bestVec = Int32Array.from(particular);\n  let bestSum = curSum;\n  const digits = new Array<number>(f).fill(0);\n\n  for (;;) {\n    // increment base-p odometer; i = highest digit that changed\n    let i = 0;\n    while (i < f && digits[i] === p - 1) {\n      digits[i] = 0;\n      i++;\n    }\n    if (i === f) break; // enumerated all p^f\n    digits[i]++;\n\n    // apply cum[i+1] to the running solution, updating curSum incrementally\n    const idx = cumIdx[i + 1];\n    const val = cumVal[i + 1];\n    for (let t = 0; t < idx.length; t++) {\n      const c = idx[t];\n      let nv = cur[c] + val[t];\n      curSum += val[t];\n      if (nv >= p) {\n        nv -= p;\n        curSum -= p;\n      }\n      cur[c] = nv;\n    }\n\n    if (curSum < bestSum || (curSum === bestSum && lexSmallerTyped(cur, bestVec))) {\n      bestVec = Int32Array.from(cur);\n      bestSum = curSum;\n    }\n  }\n\n  // Map back to full button array (length m); inactive buttons stay 0.\n  const result = new Array<number>(m).fill(0);\n  for (let c = 0; c < k; c++) result[activeButtons[c]] = bestVec[c];\n  return result;\n}\n\nfunction buildInverses(p: number): number[] {\n  // inv[a] = modular inverse of a mod p, for a in 1..p-1 (p prime).\n  const inv = new Array<number>(p).fill(0);\n  if (p > 1) inv[1] = 1;\n  for (let a = 2; a < p; a++) {\n    // inv[a] = -(p/a) * inv[p % a] mod p\n    inv[a] = ((p - Math.floor(p / a)) * inv[p % a]) % p;\n  }\n  return inv;\n}\n\nfunction sumArr(a: number[]): number {\n  let s = 0;\n  for (let i = 0; i < a.length; i++) s += a[i];\n  return s;\n}\n\nfunction lexSmallerTyped(a: ArrayLike<number>, b: ArrayLike<number>): boolean {\n  for (let i = 0; i < a.length; i++) {\n    if (a[i] !== b[i]) return a[i] < b[i];\n  }\n  return false;\n}\n","structuredPatch":[{"oldStart":28,"oldLines":8,"newStart":28,"newLines":16,"lines":[" ","   // Build the parity column for each butt