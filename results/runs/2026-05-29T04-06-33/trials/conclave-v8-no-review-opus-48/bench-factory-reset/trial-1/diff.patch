@@ -0,0 +1,444 @@
+/**
+ * Factory Reset — button-toggle / counter puzzle solvers.
+ *
+ * Both puzzles are linear systems:
+ *   - Part 1 (toggle): A x = target over GF(2), x_j ∈ {0,1}.
+ *   - Part 2 (counter): A x ≡ lights (mod p) over GF(p), x_j ∈ {0..p-1}.
+ *
+ * Strategy: Gaussian elimination to reduced row-echelon form gives a particular
+ * solution plus a null-space basis. We then enumerate the (small) null space to
+ * find the optimal solution under the tie-break rules. Buttons that affect
+ * nothing are dropped up front so they never inflate the search space.
+ */
+
+export interface Machine {
+  /** desired on/off state for each light (all start off) */
+  target: boolean[];
+  /** buttons[i] = array of light indices toggled by button i */
+  buttons: number[][];
+}
+
+// =============================================================================
+// Part 1 — Toggle puzzle (GF(2))
+// =============================================================================
+
+export function solveToggle(machine: Machine): number[] | null {
+  const n = machine.target.length;
+  const m = machine.buttons.length;
+
+  // Build the parity column for each button (duplicates cancel, out-of-range ignored).
+  // active = buttons that toggle at least one light; only these can ever help.
+  //
+  // Two buttons with the SAME column have identical light effects. For a minimum
+  // (and lexicographically smallest) press set we never need more than the
+  // lowest-indexed button of each identical group: pressing two of them cancels
+  // (wasted weight), and one of them is dominated lex-wise by the lower index.
+  // So we keep only the first occurrence of each distinct column. This keeps the
+  // null-space dimension small even for duplicate-heavy inputs.
+  const cols: boolean[][] = [];
+  const activeButtons: number[] = [];
+  const seen = new Map<string, true>();
+  for (let j = 0; j < m; j++) {
+    const col = new Array<boolean>(n).fill(false);
+    let any = false;
+    for (const li of machine.buttons[j]) {
+      if (li >= 0 && li < n) {
+        col[li] = !col[li];
+      }
+    }
+    let key = '';
+    for (let i = 0; i < n; i++) {
+      if (col[i]) {
+        any = true;
+        key += i + ',';
+      }
+    }
+    if (!any) continue; // toggles nothing -> never pressed
+    if (seen.has(key)) continue; // duplicate column -> dominated by earlier button
+    seen.set(key, true);
+    cols.push(col);
+    activeButtons.push(j);
+  }
+
+  const k = cols.length; // number of active buttons
+
+  // Augmented matrix: one bitmask row per light, bits 0..k-1 = button columns,
+  // bit k = target. Represented as a boolean[] per row (k+1 wide) for clarity;
+  // k,n ≤ 40 so this is tiny.
+  const rows: boolean[][] = [];
+  for (let i = 0; i < n; i++) {
+    const row = new Array<boolean>(k + 1).fill(false);
+    for (let j = 0; j < k; j++) row[j] = cols[j][i];
+    row[k] = machine.target[i];
+    rows.push(row);
+  }
+
+  // Gaussian elimination to reduced row-echelon form over GF(2).
+  const pivotRowOfCol: number[] = new Array(k).fill(-1);
+  let pivotRow = 0;
+  for (let col = 0; col < k && pivotRow < rows.length; col++) {
+    let sel = -1;
+    for (let r = pivotRow; r < rows.length; r++) {
+      if (rows[r][col]) {
+        sel = r;
+        break;
+      }
+    }
+    if (sel === -1) continue;
+    [rows[pivotRow], rows[sel]] = [rows[sel], rows[pivotRow]];
+    // eliminate this column from every other row
+    for (let r = 0; r < rows.length; r++) {
+      if (r !== pivotRow && rows[r][col]) {
+        const a = rows[r];
+        const b = rows[pivotRow];
+        for (let c = col; c <= k; c++) a[c] = a[c] !== b[c];
+      }
+    }
+    pivotRowOfCol[col] = pivotRow;
+    pivotRow++;
+  }
+
+  // Consistency: any row with all-zero coefficients but target=1 is unsatisfiable.
+  for (const row of rows) {
+    let allZero = true;
+    for (let c = 0; c < k; c++) {
+      if (row[c]) {
+        allZero = false;
+        break;
+      }
+    }
+    if (allZero && row[k]) return null;
+  }
+
+  // Free columns = active buttons without a pivot.
+  const freeCols: number[] = [];
+  for (let c = 0; c < k; c++) if (pivotRowOfCol[c] === -1) freeCols.push(c);
+
+  // Particular solution (all free vars = 0): pivot var = rhs of its row.
+  // Stored as a bitmask over k columns split into lo (0..31) / hi (32..k-1).
+  let pLo = 0;
+  let pHi = 0;
+  for (let c = 0; c < k; c++) {
+    if (pivotRowOfCol[c] !== -1 && rows[pivotRowOfCol[c]][k]) {
+      if (c < 32) pLo |= 1 << c;
+      else pHi |= 1 << (c - 32);
+    }
+  }
+
+  // Null-space basis: one vector per free column.
+  // For free col f: bit f = 1; for each pivot col c, bit c = rows[pivotRow(c)][f].
+  const f = freeCols.length;
+  const basisLo = new Array<number>(f).fill(0);
+  const basisHi = new Array<number>(f).fill(0);
+  for (let bi = 0; bi < f; bi++) {
+    const fc = freeCols[bi];
+    let lo = 0;
+    let hi = 0;
+    if (fc < 32) lo |= 1 << fc;
+    else hi |= 1 << (fc - 32);
+    for (let c = 0; c < k; c++) {
+      if (pivotRowOfCol[c] !== -1 && rows[pivotRowOfCol[c]][fc]) {
+        if (c < 32) lo |= 1 << c;
+        else hi |= 1 << (c - 32);
+      }
+    }
+    basisLo[bi] = lo;
+    basisHi[bi] = hi;
+  }
+
+  // Enumerate all 2^f null-space combinations via Gray-code order (binary counter:
+  // the bit that flips 0->1 on each increment is the basis vector to XOR in).
+  let bestLo = pLo;
+  let bestHi = pHi;
+  let bestWeight = popcount(pLo) + popcount(pHi);
+
+  let curLo = pLo;
+  let curHi = pHi;
+  const counter = new Array<number>(f).fill(0);
+
+  // total iterations = 2^f - 1; loop by incrementing the binary counter.
+  for (;;) {
+    // increment counter, find the position that turned to 1
+    let pos = 0;
+    while (pos < f && counter[pos] === 1) {
+      counter[pos] = 0;
+      pos++;
+    }
+    if (pos === f) break; // overflow -> enumerated everything
+    counter[pos] = 1;
+
+    curLo ^= basisLo[pos];
+    curHi ^= basisHi[pos];
+
+    const w = popcount(curLo) + popcount(curHi);
+    if (w < bestWeight || (w === bestWeight && lexSmallerMask(curLo, curHi, bestLo, bestHi))) {
+      bestLo = curLo;
+      bestHi = curHi;
+      bestWeight = w;
+    }
+  }
+
+  // Map the chosen active-column bits back to original button indices.
+  const result: number[] = [];
+  for (let c = 0; c < k; c++) {
+    const set = c < 32 ? (bestLo >>> c) & 1 : (bestHi >>> (c - 32)) & 1;
+    if (set) result.push(activeButtons[c]);
+  }
+  result.sort((a, b) => a - b);
+  return result;
+}
+
+function popcount(x: number): number {
+  // 32-bit population count
+  x = x - ((x >>> 1) & 0x55555555);
+  x = (x & 0x33333333) + ((x >>> 2) & 0x33333333);
+  x = (x + (x >>> 4)) & 0x0f0f0f0f;
+  return (x * 0x01010101) >>> 24;
+}
+
+/**
+ * True if mask A represents a lexicographically smaller SORTED INDEX LIST than B,
+ * given equal popcount. The smaller list is the one containing the minimum element
+ * of the symmetric difference (proof: lists agree below that element).
+ */
+function lexSmallerMask(aLo: number, aHi: number, bLo: number, bHi: number): boolean {
+  const xLo = aLo ^ bLo;
+  const xHi = aHi ^ bHi;
+  if (xLo === 0 && xHi === 0) return false;
+  let bit: number;
+  let inA: number;
+  if (xLo !== 0) {
+    bit = lowestBit(xLo);
+    inA = (aLo >>> bit) & 1;
+  } else {
+    bit = lowestBit(xHi);
+    inA = (aHi >>> bit) & 1;
+  }
+  return inA === 1; // A contains the min differing index => A's list is smaller
+}
+
+function lowestBit(x: number): number {
+  // index of least-significant set bit (x != 0)
+  return popcount((x & -x) - 1);
+}
+
+// =============================================================================
+// Part 2 — Counter puzzle (GF(p), p prime)
+// =============================================================================
+
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const p = modulus;
+  const n = lights.length;
+  const m = buttons.length;
+
+  // Build column for each button: column[i] = (# times button increments counter i) mod p.
+  // Drop buttons that affect no counter (their press count is forced to 0).
+  //
+  // Buttons with the SAME column are interchangeable in the linear system (only
+  // the sum of their press counts matters). For minimum total presses the group
+  // contributes exactly its required residue, and that whole value is best placed
+  // on the HIGHEST-indexed member (zeros on earlier indices) to make the result
+  // array lexicographically smallest. So we collapse each identical-column group
+  // to a single variable living at its highest original index. This keeps the
+  // free dimension small even for duplicate-heavy inputs.
+  const groups = new Map<string, { col: number[]; repIndex: number }>();
+  for (let j = 0; j < m; j++) {
+    const col = new Array<number>(n).fill(0);
+    let any = false;
+    for (const ci of buttons[j]) {
+      if (ci >= 0 && ci < n) col[ci] = (col[ci] + 1) % p;
+    }
+    let key = '';
+    for (let i = 0; i < n; i++) {
+      if (col[i] !== 0) {
+        any = true;
+        key += i + ':' + col[i] + ',';
+      }
+    }
+    if (!any) continue; // affects no counter -> pressed 0 times
+    const existing = groups.get(key);
+    if (existing) existing.repIndex = j; // later buttons have higher index
+    else groups.set(key, { col, repIndex: j });
+  }
+  // Order reduced columns by their representative (highest) index ascending so
+  // that lexicographic comparison of the reduced solution vector matches
+  // lexicographic comparison of the full result array.
+  const reduced = [...groups.values()].sort((a, b) => a.repIndex - b.repIndex);
+  const cols: number[][] = reduced.map((g) => g.col);
+  const activeButtons: number[] = reduced.map((g) => g.repIndex);
+  const k = cols.length;
+
+  // Augmented matrix over GF(p): n rows, k+1 columns (last = rhs / lights).
+  const rows: number[][] = [];
+  for (let i = 0; i < n; i++) {
+    const row = new Array<number>(k + 1).fill(0);
+    for (let j = 0; j < k; j++) row[j] = cols[j][i];
+    row[k] = ((lights[i] % p) + p) % p;
+    rows.push(row);
+  }
+
+  // Reduced row-echelon form over GF(p) using modular inverses (p prime).
+  const inv = buildInverses(p);
+  const pivotRowOfCol: number[] = new Array(k).fill(-1);
+  let pivotRow = 0;
+  for (let col = 0; col < k && pivotRow < rows.length; col++) {
+    let sel = -1;
+    for (let r = pivotRow; r < rows.length; r++) {
+      if (rows[r][col] !== 0) {
+        sel = r;
+        break;
+      }
+    }
+    if (sel === -1) continue;
+    [rows[pivotRow], rows[sel]] = [rows[sel], rows[pivotRow]];
+    // normalize pivot row so pivot == 1
+    const pr = rows[pivotRow];
+    const f0 = inv[pr[col]];
+    for (let c = col; c <= k; c++) pr[c] = (pr[c] * f0) % p;
+    // eliminate column from all other rows
+    for (let r = 0; r < rows.length; r++) {
+      if (r !== pivotRow && rows[r][col] !== 0) {
+        const factor = rows[r][col];
+        const a = rows[r];
+        for (let c = col; c <= k; c++) {
+          // ((..) % p + p) % p keeps the result in 0..p-1 and avoids JS's `-0`.
+          a[c] = (((a[c] - factor * pr[c]) % p) + p) % p;
+        }
+      }
+    }
+    pivotRowOfCol[col] = pivotRow;
+    pivotRow++;
+  }
+
+  // Consistency check.
+  for (const row of rows) {
+    let allZero = true;
+    for (let c = 0; c < k; c++) {
+      if (row[c] !== 0) {
+        allZero = false;
+        break;
+      }
+    }
+    if (allZero && row[k] !== 0) return null;
+  }
+
+  const freeCols: number[] = [];
+  for (let c = 0; c < k; c++) if (pivotRowOfCol[c] === -1) freeCols.push(c);
+
+  // Particular solution over the k active columns (free vars = 0).
+  const particular = new Array<number>(k).fill(0);
+  for (let c = 0; c < k; c++) {
+    if (pivotRowOfCol[c] !== -1) particular[c] = rows[pivotRowOfCol[c]][k];
+  }
+
+  const f = freeCols.length;
+  // Null-space basis vector per free column fc:
+  //   x[fc] = 1; for each pivot col c, x[c] = (-rows[pivotRow(c)][fc]) mod p.
+  const basis: number[][] = [];
+  for (let bi = 0; bi < f; bi++) {
+    const fc = freeCols[bi];
+    const vec = new Array<number>(k).fill(0);
+    vec[fc] = 1;
+    for (let c = 0; c < k; c++) {
+      if (pivotRowOfCol[c] !== -1) {
+        const v = rows[pivotRowOfCol[c]][fc] % p;
+        vec[c] = (p - v) % p;
+      }
+    }
+    basis.push(vec);
+  }
+
+  // Enumerate p^f assignments of the free variables via a base-p odometer.
+  // cum[t] = (sum of basis[0..t-1]) mod p, so incrementing the odometer with a
+  // carry chain ending at index i changes the solution by cum[i+1] (mod p):
+  // each wrapped digit contributes +1 (≡ -(p-1)) and the carried digit +1.
+  // Each cum vector is stored sparsely (only nonzero components) so the hot
+  // update loop touches only the columns that actually change.
+  const cumIdx: Int32Array[] = [];
+  const cumVal: Int32Array[] = [];
+  {
+    const acc = new Array<number>(k).fill(0);
+    for (let t = 0; t <= f; t++) {
+      const idx: number[] = [];
+      const val: number[] = [];
+      for (let c = 0; c < k; c++) {
+        if (acc[c] !== 0) {
+          idx.push(c);
+          val.push(acc[c]);
+        }
+      }
+      cumIdx.push(Int32Array.from(idx));
+      cumVal.push(Int32Array.from(val));
+      if (t < f) for (let c = 0; c < k; c++) acc[c] = (acc[c] + basis[t][c]) % p;
+    }
+  }
+
+  const cur = Int32Array.from(particular);
+  let curSum = sumArr(particular);
+  let bestVec = Int32Array.from(particular);
+  let bestSum = curSum;
+  const digits = new Array<number>(f).fill(0);
+
+  for (;;) {
+    // increment base-p odometer; i = highest digit that changed
+    let i = 0;
+    while (i < f && digits[i] === p - 1) {
+      digits[i] = 0;
+      i++;
+    }
+    if (i === f) break; // enumerated all p^f
+    digits[i]++;
+
+    // apply cum[i+1] to the running solution, updating curSum incrementally
+    const idx = cumIdx[i + 1];
+    const val = cumVal[i + 1];
+    for (let t = 0; t < idx.length; t++) {
+      const c = idx[t];
+      let nv = cur[c] + val[t];
+      curSum += val[t];
+      if (nv >= p) {
+        nv -= p;
+        curSum -= p;
+      }
+      cur[c] = nv;
+    }
+
+    if (curSum < bestSum || (curSum === bestSum && lexSmallerTyped(cur, bestVec))) {
+      bestVec = Int32Array.from(cur);
+      bestSum = curSum;
+    }
+  }
+
+  // Map back to full button array (length m); inactive buttons stay 0.
+  const result = new Array<number>(m).fill(0);
+  for (let c = 0; c < k; c++) result[activeButtons[c]] = bestVec[c];
+  return result;
+}
+
+function buildInverses(p: number): number[] {
+  // inv[a] = modular inverse of a mod p, for a in 1..p-1 (p prime).
+  const inv = new Array<number>(p).fill(0);
+  if (p > 1) inv[1] = 1;
+  for (let a = 2; a < p; a++) {
+    // inv[a] = -(p/a) * inv[p % a] mod p
+    inv[a] = ((p - Math.floor(p / a)) * inv[p % a]) % p;
+  }
+  return inv;
+}
+
+function sumArr(a: number[]): number {
+  let s = 0;
+  for (let i = 0; i < a.length; i++) s += a[i];
+  return s;
+}
+
+function lexSmallerTyped(a: ArrayLike<number>, b: ArrayLike<number>): boolean {
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] !== b[i]) return a[i] < b[i];
+  }
+  return false;
+}
