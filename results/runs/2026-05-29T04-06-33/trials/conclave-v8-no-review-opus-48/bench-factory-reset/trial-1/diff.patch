----------\n\nfunction simulate(buttons: number[][], pressed: number[], n: number): boolean[] {\n  const lights = new Array<boolean>(n).fill(false);\n  for (const b of pressed) {\n    for (const li of buttons[b]) {\n      if (li >= 0 && li < n) lights[li] = !lights[li];\n    }\n  }\n  return lights;\n}\n\nfunction eqBool(a: boolean[], b: boolean[]): boolean {\n  return a.length === b.length && a.every((v, i) => v === b[i]);\n}\n\n// lexicographic comparison of sorted index lists\nfunction lexLess(a: number[], b: number[]): boolean {\n  const n = Math.min(a.length, b.length);\n  for (let i = 0; i < n; i++) {\n    if (a[i] !== b[i]) return a[i] < b[i];\n  }\n  return a.length < b.length;\n}\n\n// brute force reference: min cardinality, then lexicographically smallest list\nfunction bruteToggle(machine: Machine): number[] | null {\n  const m = machine.buttons.length;\n  const n = machine.target.length;\n  let best: number[] | null = null;\n  for (let mask = 0; mask < 1 << m; mask++) {\n    const pressed: number[] = [];\n    for (let j = 0; j < m; j++) if (mask & (1 << j)) pressed.push(j);\n    if (eqBool(simulate(machine.buttons, pressed, n), machine.target)) {\n      if (\n        best === null ||\n        pressed.length < best.length ||\n        (pressed.length === best.length && lexLess(pressed, best))\n      ) {\n        best = pressed;\n      }\n    }\n  }\n  return best;\n}\n\nfunction assertValid(machine: Machine, result: number[]): void {\n  expect([...result]).toEqual([...result].sort((a, b) => a - b)); // sorted\n  for (const idx of result) {\n    expect(idx).toBeGreaterThanOrEqual(0);\n    expect(idx).toBeLessThan(machine.buttons.length);\n  }\n  expect(eqBool(simulate(machine.buttons, result, machine.target.length), machine.target)).toBe(true);\n}\n\n// ---- tests ------------------------------------------------------------------\n\ndescribe('solveToggle', () => {\n  it('returns null for the TASK.md example', () => {\n    const machine: Machine = {\n      target: [true, true, false, true],\n      buttons: [[0, 1], [1, 2, 3], [0, 3]],\n    };\n    expect(solveToggle(machine)).toBeNull();\n  });\n\n  it('returns [] when target is all-off', () => {\n    expect(solveToggle({ target: [false, false, false], buttons: [[0], [1], [2]] })).toEqual([]);\n  });\n\n  it('returns [] when there are no buttons and target all-off', () => {\n    expect(solveToggle({ target: [false, false], buttons: [] })).toEqual([]);\n  });\n\n  it('returns null when no buttons but target needs a light on', () => {\n    expect(solveToggle({ target: [true], buttons: [] })).toBeNull();\n  });\n\n  it('solves a basic single-button case', () => {\n    const m: Machine = { target: [true, false], buttons: [[0], [1]] };\n    const r = solveToggle(m)!;\n    expect(r).toEqual([0]);\n    assertValid(m, r);\n  });\n\n  it('picks the fewest presses', () => {\n    // button 0 sets both lights at once; pressing 1 and 2 also works but is 2 presses\n    const m: Machine = { target: [true, true], buttons: [[0, 1], [0], [1]] };\n    const r = solveToggle(m)!;\n    assertValid(m, r);\n    expect(r).toEqual([0]);\n  });\n\n  it('breaks ties by lexicographically smallest index list', () => {\n    // lights 2; target [T,T]. Solutions: {0,1} via [0]+[1]; {2} alone? build so two equal-size minimal exist\n    // buttons: 0:[0], 1:[1], 2:[0], 3:[1] -> target [T,T] minimal size 2; smallest list is [0,1]\n    const m: Machine = { target: [true, true], buttons: [[0], [1], [0], [1]] };\n    const r = solveToggle(m)!;\n    assertValid(m, r);\n    expect(r).toEqual([0, 1]);\n  });\n\n  it('never presses a button that toggles nothing', () => {\n    const m: Machine = { target: [true], buttons: [[], [0], []] };\n    const r = solveToggle(m)!;\n    assertValid(m, r);\n    expect(r).toEqual([1]);\n  });\n\n  it('treats duplicate light indices within a button as canceling', () => {\n    // button 0 = [0,0] toggles nothing; need button 1 to set light 0\n    const m: Machine = { target: [true], buttons: [[0, 0], [0]] };\n    const r = solveToggle(m)!;\n    assertValid(m, r);\n    expect(r).toEqual([1]);\n  });\n\n  it('ignores out-of-range light indices without crashing', () => {\n    const m: Machine = { target: [true], buttons: [[5], [0]] };\n    const r = solveToggle(m)!;\n    assertValid(m, r);\n    expect(r).toEqual([1]);\n  });\n\n  it('does not mutate the input', () => {\n    const m: Machine = { target: [true, false, true], buttons: [[0], [2], [0, 2]] };\n    const snapshot = JSON.stringify(m);\n    solveToggle(m);\n    expect(JSON.stringify(m)).toEqual(snapshot);\n  });\n\n  it('matches brute force across many random small instances', () => {\n    let seed = 12345;\n    const rng = () => (seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff;\n    for (let t = 0; t < 300; t++) {\n      const n = 1 + Math.floor(rng() * 6);\n      const m = Math.floor(rng() * 8);\n      const buttons: number[][] = [];\n      for (let j = 0; j < m; j++) {\n        const set: number[] = [];\n        for (let li = 0; li < n; li++) if (rng() < 0.5) set.push(li);\n        buttons.push(set);\n      }\n      const target: boolean[] = [];\n      for (let li = 0; li < n; li++) target.push(rng() < 0.5);\n      const machine: Machine = { target, buttons };\n      const got = solveToggle(machine);\n      const exp = bruteToggle(machine);\n      if (exp === null) {\n        expect(got).toBeNull();\n      } else {\n        expect(got).not.toBeNull();\n        assertValid(machine, got!);\n        // same optimal cardinality\n        expect(got!.length).toBe(exp.length);\n        // exact lexicographically-smallest match\n        expect(got).toEqual(exp);\n      }\n    }\n  });\n\n  it('handles a 40x40 instance under the time limit', () => {\n    // construct a solvable instance with a known pressed set and moderate redundancy\n    const n = 40;\n    const m = 40;\n    let seed = 999;\n    const rng = () => (seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff;\n    const buttons: number[][] = [];\n    for (let j = 0; j < m; j++) {\n      const set: number[] = [];\n      for (let li = 0; li < n; li++) if (rng() < 0.3) set.push(li);\n      buttons.push(set);\n    }\n    // pick a random pressed set, derive target\n    const truth: number[] = [];\n    for (let j = 0; j < m; j++) if (rng() < 0.3) truth.push(j);\n    const target = simulate(buttons, truth, n);\n    const machine: Machine = { target, buttons };\n    const start = Date.now();\n    const r = solveToggle(machine);\n    expect(Date.now() - start).toBeLessThan(5000);\n    expect(r).not.toBeNull();\n    assertValid(machine, r!);\n    expect(r!.length).toBeLessThanOrEqual(truth.length);\n  });\n});\n","structuredPatch":[{"oldStart":162,"oldLines":6,"newStart":162,"newLines":31,"lines":["     }","   });"," ","+  it('prefers the lowest-index button among identical (duplicate) buttons', () => {","+    // buttons 0,2,4 all toggle light 0; need light 0 on -> press button 0 only.","+    const m: Machine = { target: [true], buttons: [[0], [], [0], [], [0]] };","+    const r = solveToggle(m)!;","+    assertValid(m, r);","+    expect(r).toEqual([0]);","+  });","+","+  it('stays fast with many duplicate buttons (high redundancy)', () => {","+    // 40 buttons but only 8 distinct columns -> naive null-space dim would be 32.","+    const n = 8;","+    const distinct: number[][] = [];","+    for (let d = 0; d < 8; d++) distinct.push([d]); // each lights one counter","+    const buttons: number[][] = [];","+    for (let j = 0; j < 40; j++) buttons.push([...distinct[j % 8]]);","+    const target = new Array<boolean>(n).fill(true); // need all 8 lit","+    const machine: Machine = { target, buttons };","+    const start = Date.now();","+    const r = solveToggle(machine)!;","+    expect(Date.now() - start).toBeLessThan(5000);","+    assertValid(machine, r);","+    // minimal: press the first button of each distinct group -> indices 0..7","+    expect(r).toEqual([0, 1, 2, 3, 4, 5, 