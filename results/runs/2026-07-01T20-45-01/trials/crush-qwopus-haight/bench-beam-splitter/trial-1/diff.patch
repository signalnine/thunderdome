@@ -0,0 +1,192 @@
+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index';
+
+describe('countBeamCells', () => {
+  it('should count visited cells with one splitter', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(5);
+  });
+
+  it('should count visited cells with two splitters', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('should return 1 for a source with no splitters and 1 row', () => {
+    const grid = [['S']];
+    expect(countBeamCells(grid)).toBe(1);
+  });
+
+  it('should count cells for a straight beam with no splitters', () => {
+    const grid = [
+      ['.', 'S', '.'],
+      ['.', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(3);
+  });
+
+  it('should handle a beam exiting left side', () => {
+    // 4 rows so beams from splitter reach row 3
+    const grid = [
+      ['S', '.', '.'],
+      ['.', '.', '.'],
+      ['^', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    // S at (0,0) → (1,0) → (2,0) splitter
+    // down-left: (3,-1) absorbed
+    // down-right: (3,1)
+    // visited: (0,0), (1,0), (2,0), (3,1) → 4
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('should handle a beam exiting right side', () => {
+    // 4 rows so beams from splitter reach row 3
+    const grid = [
+      ['.', '.', 'S'],
+      ['.', '.', '.'],
+      ['.', '.', '^'],
+      ['.', '.', '.'],
+    ];
+    // S at (0,2) → (1,2) → (2,2) splitter
+    // down-left: (3,1)
+    // down-right: (3,3) absorbed
+    // visited: (0,2), (1,2), (2,2), (3,1) → 4
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('should handle overlapping beams counting cell once', () => {
+    // Splitters at (1,1) and (2,0)
+    const grid = [
+      ['.', 'S', '.', '.'],
+      ['.', '^', '.', '.'],
+      ['^', '.', '.', '.'],
+      ['.', '.', '.', '.'],
+    ];
+    // S at (0,1) → (1,1) splitter → (2,0) and (2,2)
+    // (2,0) splitter → (3,-1) absorbed, (3,1)
+    // (2,2) → (3,3)
+    // visited: (0,1), (1,1), (2,0), (2,2), (3,1), (3,3) → 6
+    expect(countBeamCells(grid)).toBe(6);
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('should count paths with one splitter', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('should count paths with two splitters', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('should return 1n for a straight beam with no splitters', () => {
+    const grid = [
+      ['.', 'S', '.'],
+      ['.', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('should return 1n for a source in a 1x1 grid', () => {
+    const grid = [['S']];
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('should handle beam exiting left side', () => {
+    const grid = [
+      ['S', '.', '.'],
+      ['.', '.', '.'],
+      ['^', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    // S at (0,0) → (1,0) → (2,0) splitter → (3,-1) and (3,1)
+    // Both exit at row 4 → 2 paths
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('should handle a tall grid with many splitters (2^k paths)', () => {
+    // S at (0,3) → (1,3) → (2,3) splitter → (3,2) and (3,4)
+    // (3,2) down-left → (4,1), (3,4) down-right → (4,5)
+    // Splitters at (4,1) and (4,5)
+    // (4,1) → (5,0) and (5,2), (4,5) → (5,4) and (5,6)
+    // All exit at row 6 → 4 paths
+    const grid = [
+      ['.', '.', '.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.', '.', '.'],
+      ['.', '.', '.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.', '^', '.'],
+      ['.', '.', '.', '.', '.', '.', '.'],
+      ['.', '.', '.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('should handle 3 splitters in cascade (2^3 = 8 paths)', () => {
+    // S at (0,10) → (1,10) → (2,10) splitter
+    // → (3,9) and (3,11)
+    // (3,9) down-left → (4,8), (3,11) down-right → (4,12)
+    // Splitters at (4,8) and (4,12)
+    // (4,8) → (5,7) and (5,9), (4,12) → (5,11) and (5,13)
+    // (5,7) down-left → (6,6), (5,9) down-right → (6,10)
+    // (5,11) down-left → (6,10), (5,13) down-right → (6,14)
+    // Splitters at (6,6), (6,10), (6,14)
+    // (6,6) → (7,5) and (7,7)
+    // (6,10) → (7,9) and (7,11) — 2 beams converge here, each splits
+    // (6,14) → (7,13) and (7,15)
+    // Total: 2 + 4 + 2 = 8 paths
+    const rows = 10;
+    const cols = 21;
+    const grid: string[][] = Array.from({ length: rows }, () =>
+      Array(cols).fill('.'),
+    );
+    grid[0][10] = 'S';
+    grid[2][10] = '^';
+    grid[4][8] = '^';
+    grid[4][12] = '^';
+    grid[6][6] = '^';
+    grid[6][10] = '^';
+    grid[6][14] = '^';
+    expect(countBeamPaths(grid)).toBe(8n);
+  });
+
+  it('should handle large number of splitters efficiently', () => {
+    // 2-level cascade: 4 paths
+    const smallRows = 10;
+    const smallCols = 21;
+    const smallGrid: string[][] = Array.from({ length: smallRows }, () =>
+      Array(smallCols).fill('.'),
+    );
+    smallGrid[0][10] = 'S';
+    smallGrid[2][10] = '^';
+    smallGrid[4][8] = '^';
+    smallGrid[4][12] = '^';
+    // 2 levels → 4 paths
+    expect(countBeamPaths(smallGrid)).toBe(4n);
+  });
+});
