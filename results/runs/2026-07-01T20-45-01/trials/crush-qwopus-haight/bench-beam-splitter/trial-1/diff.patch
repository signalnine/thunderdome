+// Beam propagation simulator for a 2D grid laboratory.
+
+/**
+ * Directions: [rowDelta, colDelta]
+ *  0 = down       (row+1, same col)
+ *  1 = down-left  (row+1, col-1)
+ *  2 = down-right (row+1, col+1)
+ */
+const DIRS = [
+  [1, 0],   // down
+  [1, -1],  // down-left
+  [1, 1],   // down-right
+];
+
+/**
+ * Count the number of distinct cells visited by any beam.
+ * Uses BFS: each state is (row, col, direction).
+ * When a beam hits a splitter, it splits into two beams going down-left and down-right.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+
+  // Find the source
+  let srcCol = -1;
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') {
+      srcCol = c;
+      break;
+    }
+  }
+  if (srcCol === -1) return 0;
+
+  const visited = new Set<string>();
+  // BFS queue: each entry is (row, col, direction)
+  // The beam is currently at (row, col) and will move in `direction`.
+  const queue: [number, number, number][] = [[0, srcCol, 0]];
+  visited.add(`0,${srcCol}`);
+
+  while (queue.length > 0) {
+    const [r, c, dir] = queue.shift()!;
+    const [dr, dc] = DIRS[dir];
+    const nr = r + dr;
+    const nc = c + dc;
+
+    if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
+      // Beam exits grid — absorbed
+      continue;
+    }
+
+    const key = `${nr},${nc}`;
+    visited.add(key);
+
+    if (grid[nr][nc] === '^') {
+      // Splitter: beam splits into down-left (dir=1) and down-right (dir=2)
+      // Both new beams start from the splitter cell
+      queue.push([nr, nc, 1]);
+      queue.push([nr, nc, 2]);
+    } else {
+      // Continue in the same direction
+      queue.push([nr, nc, dir]);
+    }
+  }
+
+  return visited.size;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths through the grid.
+ * Uses dynamic programming: for each row, track how many beams with each
+ * direction reach each cell. When a beam hits a splitter, it splits into
+ * two (doubling the path count). When a beam exits the grid, add its count
+ * to the total.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+
+  // Find the source
+  let srcCol = -1;
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') {
+      srcCol = c;
+      break;
+    }
+  }
+  if (srcCol === -1) return 0n;
+
+  // dp[c][dir] = number of paths reaching cell (currentRow, c) traveling in direction dir
+  // dir: 0=down, 1=down-left, 2=down-right
+  // Initialize: at row 0, one path enters the source cell going down
+  const dp: bigint[][] = Array.from({ length: cols }, () => [0n, 0n, 0n]);
+  dp[srcCol][0] = 1n;
+
+  let total = 0n;
+
+  for (let r = 0; r < rows; r++) {
+    const nextDp: bigint[][] = Array.from({ length: cols }, () => [0n, 0n, 0n]);
+
+    for (let c = 0; c < cols; c++) {
+      const cell = grid[r][c];
+
+      for (let dir = 0; dir < 3; dir++) {
+        const count = dp[c][dir];
+        if (count === 0n) continue;
+
+        if (cell === '^') {
+          // Splitter: splits into down-left and down-right
+          // Down-left: (r+1, c-1)
+          const dlC = c - 1;
+          if (r + 1 < rows && dlC >= 0 && dlC < cols) {
+            nextDp[dlC][1] += count;
+          } else {
+            // Exits grid
+            total += count;
+          }
+          // Down-right: (r+1, c+1)
+          const drC = c + 1;
+          if (r + 1 < rows && drC >= 0 && drC < cols) {
+            nextDp[drC][2] += count;
+          } else {
+            // Exits grid
+            total += count;
+          }
+        } else {
+          // Non-splitter: beam continues in same direction
+          const [ddr, ddc] = DIRS[dir];
+          const nr = r + ddr;
+          const nc = c + ddc;
+
+          if (nr < rows && nc >= 0 && nc < cols) {
+            nextDp[nc][dir] += count;
+          } else {
+            // Exits grid
+            total += count;
+          }
+        }
+      }
+    }
+
+    dp.length = 0;
+    dp.push(...nextDp);
+  }
+
+  // After processing all rows, any beams still in dp are at the last row.
+  // They will exit on the next step (row `rows` is out of bounds).
+  for (let c = 0; c < cols; c++) {
+    for (let dir = 0; dir < 3; dir++) {
+      total += dp[c][dir];
+    }
+  }
+
+  return total;
+}
