+
+const router = Router();
+
+// POST /events - Ingest a single event
+router.post('/', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const { name, properties = {}, timestamp, user_id, session_id } = req.body;
+
+  if (!name) {
+    throw new AppError(400, 'BAD_REQUEST', 'Event name is required');
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  const eventTimestamp = timestamp || new Date().toISOString();
+
+  db.prepare(
+    `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)`
+  ).run(
+    id,
+    req.user.tenantId,
+    name,
+    JSON.stringify(properties),
+    eventTimestamp,
+    user_id || null,
+    session_id || null
+  );
+
+  res.status(201).json({
+    id,
+    tenant_id: req.user.tenantId,
+    name,
+    properties,
+    timestamp: eventTimestamp,
+    user_id,
+    session_id,
+  });
+});
+
+// POST /events/batch - Ingest multiple events
+router.post('/batch', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const { events } = req.body;
+
+  if (!events || !Array.isArray(events) || events.length === 0) {
+    throw new AppError(400, 'BAD_REQUEST', 'Events array is required and must not be empty');
+  }
+
+  const db = getDb();
+  const insert = db.prepare(
+    `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)`
+  );
+
+  const inserted: Record<string, unknown>[] = [];
+
+interface BatchEvent {
+  name?: string;
+  properties?: Record<string, unknown>;
+  timestamp?: string;
+  user_id?: string | null;
+  session_id?: string | null;
+}
+
+const insertMany = db.transaction((eventsArr: BatchEvent[]) => {
+    for (const event of eventsArr) {
+      if (!event.name) {
+        throw new AppError(400, 'BAD_REQUEST', 'Each event must have a name');
+      }
+
+      const id = uuidv4();
+      const eventTimestamp = event.timestamp || new Date().toISOString();
+
+      insert.run(
+        id,
+        req.user!.tenantId,
+        event.name,
+        JSON.stringify(event.properties || {}),
+        eventTimestamp,
+        event.user_id || null,
+        event.session_id || null
+      );
+
+      inserted.push({
+        id,
+        tenant_id: req.user!.tenantId,
+        name: event.name,
+        properties: event.properties || {},
+        timestamp: eventTimestamp,
+        user_id: event.user_id || null,
+        session_id: event.session_id || null,
+      });
+    }
+  });
+
+  insertMany(events);
+
+  res.status(201).json({
+    inserted: inserted.length,
+    events: inserted,
+  });
+});
+
+export default router;
