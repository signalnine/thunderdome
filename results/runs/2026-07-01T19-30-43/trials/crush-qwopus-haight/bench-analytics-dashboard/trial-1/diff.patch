+import express from 'express';
+import { authenticateToken } from './auth';
+import { errorHandler } from './errors';
+import usersPublicRouter from './users/public';
+import usersRouter from './users/router';
+import ingestRouter from './ingest/router';
+import queryRouter from './query/router';
+import dashboardsRouter from './dashboards/router';
+import exportRouter from './export/router';
+
+export function createApp(): express.Express {
+  const app = express();
+  app.use(express.json());
+
+  // Public routes (register, login)
+  app.use('/users', usersPublicRouter);
+
+  // Authenticated routes
+  const authStack = express.Router();
+  authStack.use(authenticateToken);
+  authStack.use('/users', usersRouter);
+  authStack.use('/events', ingestRouter);
+  authStack.use('/query', queryRouter);
+  authStack.use('/dashboards', dashboardsRouter);
+  authStack.use('/export', exportRouter);
+  app.use(authStack);
+
+  app.use(errorHandler);
+
+  return app;
+}
