+import { Router, Response } from 'express';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+import { AuthenticatedRequest } from '../auth';
+
+const router = Router();
+
+// GET /export/events?format=csv|json - Export events
+router.get('/events', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const format = (req.query.format as string) || 'json';
+
+  if (format !== 'json' && format !== 'csv') {
+    throw new AppError(400, 'BAD_REQUEST', 'Invalid format. Must be json or csv');
+  }
+
+  const db = getDb();
+  const events = db.prepare(
+    'SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp'
+  ).all(req.user.tenantId) as Array<Record<string, unknown>>;
+
+  if (format === 'csv') {
+    const headers = ['id', 'tenant_id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'];
+    const csvLines = [headers.join(',')];
+
+    for (const event of events) {
+      const row = headers.map(h => {
+        const val = event[h as keyof typeof event];
+        if (val === null || val === undefined) return '';
+        const str = String(val);
+        if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+          return `"${str.replace(/"/g, '""')}"`;
+        }
+        return str;
+      });
+      csvLines.push(row.join(','));
+    }
+
+    res.setHeader('Content-Type', 'text/csv');
+    res.status(200).send(csvLines.join('\n'));
+    return;
+  }
+
+  res.json(events);
+});
+
+// GET /export/dashboard/:id - Export dashboard data
+router.get('/dashboard/:id', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const db = getDb();
+  const dashboard = db.prepare(
+    'SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(req.params.id, req.user.tenantId);
+
+  if (!dashboard) {
+    throw new AppError(404, 'NOT_FOUND', 'Dashboard not found');
+  }
+
+  const widgets = db.prepare(
+    'SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y, position_x'
+  ).all(req.params.id);
+
+  res.json({
+    dashboard,
+    widgets,
+  });
+});
+
+export default router;
