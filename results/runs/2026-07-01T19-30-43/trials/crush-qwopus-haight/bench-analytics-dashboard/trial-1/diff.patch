+++ b/src/query/router.ts
@@ -0,0 +1,215 @@
+import { Router, Response } from 'express';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+import { AuthenticatedRequest } from '../auth';
+
+const router = Router();
+
+// POST /query/count - Count events matching filter
+router.post('/count', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const { event_name, start, end, property_key, property_value } = req.body;
+
+  if (!event_name) {
+    throw new AppError(400, 'BAD_REQUEST', 'event_name is required');
+  }
+
+  const db = getDb();
+  let query = 'SELECT COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?';
+  const params: (string | number)[] = [req.user.tenantId, event_name];
+
+  if (start) {
+    query += ' AND timestamp >= ?';
+    params.push(start);
+  }
+  if (end) {
+    query += ' AND timestamp <= ?';
+    params.push(end);
+  }
+  if (property_key) {
+    query += ` AND json_extract(properties, '$."' || ? || '"') = ?`;
+    params.push(property_key, property_value || '');
+  }
+
+  const result = db.prepare(query).get(...params) as Record<string, unknown>;
+  res.json({ count: Number(result.count) });
+});
+
+// POST /query/timeseries - Time-bucketed event counts
+router.post('/timeseries', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const { event_name, bucket = 'day', start, end } = req.body;
+
+  if (!event_name) {
+    throw new AppError(400, 'BAD_REQUEST', 'event_name is required');
+  }
+
+  const db = getDb();
+
+  // Determine strftime format based on bucket
+  let strftimeFormat: string;
+  switch (bucket) {
+    case 'hour':
+      strftimeFormat = '%Y-%m-%dT%H:00:00Z';
+      break;
+    case 'day':
+      strftimeFormat = '%Y-%m-%d';
+      break;
+    case 'week':
+      strftimeFormat = 'strftime("%Y-W%W", timestamp)';
+      break;
+    case 'month':
+      strftimeFormat = '%Y-%m';
+      break;
+    default:
+      strftimeFormat = '%Y-%m-%d';
+  }
+
+  let bucketExpr: string;
+  if (bucket === 'week') {
+    bucketExpr = strftimeFormat;
+  } else {
+    bucketExpr = `strftime('${strftimeFormat}', timestamp)`;
+  }
+
+  let query = `SELECT ${bucketExpr} as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?`;
+  const params: (string | number)[] = [req.user.tenantId, event_name];
+
+  if (start) {
+    query += ' AND timestamp >= ?';
+    params.push(start);
+  }
+  if (end) {
+    query += ' AND timestamp <= ?';
+    params.push(end);
+  }
+
+  query += ` GROUP BY ${bucketExpr} ORDER BY bucket`;
+
+  const results = db.prepare(query).all(...params);
+
+  res.json({ data: results });
+});
+
+// POST /query/breakdown - Event counts grouped by property
+router.post('/breakdown', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const { event_name, property_key } = req.body;
+
+  if (!event_name || !property_key) {
+    throw new AppError(400, 'BAD_REQUEST', 'event_name and property_key are required');
+  }
+
+  const db = getDb();
+
+  const query = `
+    SELECT json_extract(properties, '$."' || ? || '"') as property_value, COUNT(*) as count
+    FROM events
+    WHERE tenant_id = ? AND name = ?
+    GROUP BY property_value
+    ORDER BY count DESC
+  `;
+
+  const results = db.prepare(query).all(property_key, req.user.tenantId, event_name);
+
+  res.json({ data: results });
+});
+
+// POST /query/funnel - Multi-step funnel analysis
+router.post('/funnel', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const { steps } = req.body;
+
+  if (!steps || !Array.isArray(steps) || steps.length === 0) {
+    throw new AppError(400, 'BAD_REQUEST', 'steps array is required');
+  }
+
+  const db = getDb();
+  const tenantId = req.user.tenantId;
+
+  // Funnel: find unique sessions that completed each step in order
+  // A session completes a step if it has an event matching that step name
+  // Each subsequent step must happen after the previous one in the same session
+
+  const funnelSteps: { step: string; count: number }[] = [];
+
+  // Get all distinct sessions with timestamps for each step
+  const sessionData: Record<string, Map<number, string>> = {}; // session_id -> {step_index -> timestamp}
+
+  // Get all events for the relevant steps
+  const placeholders = steps.map(() => '?').join(',');
+
+  const events = db.prepare(
+    `SELECT session_id, name, timestamp FROM events
+     WHERE tenant_id = ? AND name IN (${placeholders}) AND session_id IS NOT NULL
+     ORDER BY session_id, timestamp`
+  ).all(tenantId, ...steps) as Array<{ session_id: string; name: string; timestamp: string }>;
+
+  // Process events per session
+  for (const event of events) {
+    const sid = event.session_id;
+    if (!sid) continue;
+
+    if (!sessionData[sid]) {
+      sessionData[sid] = new Map();
+    }
+
+    const stepIndex = steps.indexOf(event.name);
+    if (stepIndex === -1) continue;
+
+    // Only keep the first occurrence of each step per session
+    if (!sessionData[sid].has(stepIndex)) {
+      sessionData[sid].set(stepIndex, event.timestamp);
+    }
+  }
+
+  // Calculate funnel: for each step, count sessions that have completed it AND all prior steps in order
+  for (let i = 0; i < steps.length; i++) {
+    let count = 0;
+
+    for (const [, stepMap] of Object.entries(sessionData)) {
+      let valid = true;
+
+      for (let j = 0; j <= i; j++) {
+        if (!stepMap.has(j)) {
+          valid = false;
+          break;
+        }
+      }
+
+      // Check ordering: each step's timestamp must be >= previous step's timestamp
+      if (valid) {
+        for (let j = 1; j <= i; j++) {
+          const prev = stepMap.get(j - 1);
+          const curr = stepMap.get(j);
+          if (curr && prev && curr < prev) {
+            valid = false;
+            break;
+          }
+        }
+      }
+
+      if (valid) {
+        count++;
+      }
+    }
+
+    funnelSteps.push({ step: steps[i], count });
+  }
+
+  res.json({ steps: funnelSteps });
+});
+
+export default router;
