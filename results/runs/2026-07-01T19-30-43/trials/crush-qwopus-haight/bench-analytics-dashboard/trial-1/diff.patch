+import { Router, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+import { AuthenticatedRequest } from '../auth';
+
+const router = Router();
+
+// POST /dashboards - Create a dashboard
+router.post('/', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const { name, config } = req.body;
+
+  if (!name) {
+    throw new AppError(400, 'BAD_REQUEST', 'Dashboard name is required');
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+
+  db.prepare(
+    `INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)`
+  ).run(id, req.user.tenantId, name, req.user.id, JSON.stringify(config || {}));
+
+  res.status(201).json({
+    id,
+    tenant_id: req.user.tenantId,
+    name,
+    owner_id: req.user.id,
+    config: config || {},
+  });
+});
+
+// GET /dashboards - List dashboards for tenant
+router.get('/', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const db = getDb();
+  const dashboards = db.prepare(
+    'SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC'
+  ).all(req.user.tenantId);
+
+  res.json(dashboards);
+});
+
+// GET /dashboards/:id - Get dashboard by id with widgets
+router.get('/:id', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const db = getDb();
+  const dashboard = db.prepare(
+    'SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(req.params.id, req.user.tenantId);
+
+  if (!dashboard) {
+    throw new AppError(404, 'NOT_FOUND', 'Dashboard not found');
+  }
+
+  const widgets = db.prepare(
+    'SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y, position_x'
+  ).all(req.params.id);
+
+  res.json({ ...dashboard, widgets });
+});
+
+// PATCH /dashboards/:id - Update dashboard
+router.patch('/:id', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const { name, config } = req.body;
+
+  const db = getDb();
+  const existing = db.prepare(
+    'SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(req.params.id, req.user.tenantId) as Record<string, unknown> | undefined;
+
+  if (!existing) {
+    throw new AppError(404, 'NOT_FOUND', 'Dashboard not found');
+  }
+
+  const newName = name || existing.name;
+  const newConfig = config !== undefined ? JSON.stringify(config) : existing.config;
+
+  db.prepare(
+    `UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?`
+  ).run(newName, newConfig, req.params.id);
+
+  const updated = db.prepare(
+    'SELECT * FROM dashboards WHERE id = ?'
+  ).get(req.params.id);
+
+  res.json(updated);
+});
+
+// DELETE /dashboards/:id - Delete dashboard
+router.delete('/:id', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const db = getDb();
+  const result = db.prepare(
+    'DELETE FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).run(req.params.id, req.user.tenantId);
+
+  if (result.changes === 0) {
+    throw new AppError(404, 'NOT_FOUND', 'Dashboard not found');
+  }
+
+  res.status(204).send();
+});
+
+// POST /dashboards/:dashboardId/widgets - Add widget
+router.post('/:dashboardId/widgets', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const { type, config, position_x = 0, position_y = 0, width = 1, height = 1 } = req.body;
+
+  if (!type) {
+    throw new AppError(400, 'BAD_REQUEST', 'Widget type is required');
+  }
+
+  const validTypes = ['counter', 'timeseries', 'breakdown', 'funnel'];
+  if (!validTypes.includes(type)) {
+    throw new AppError(400, 'BAD_REQUEST', `Invalid widget type. Must be one of: ${validTypes.join(', ')}`);
+  }
+
+  const db = getDb();
+  const dashboard = db.prepare(
+    'SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(req.params.dashboardId, req.user.tenantId);
+
+  if (!dashboard) {
+    throw new AppError(404, 'NOT_FOUND', 'Dashboard not found');
+  }
+
+  const id = uuidv4();
+
+  db.prepare(
+    `INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
+  ).run(id, req.params.dashboardId, type, JSON.stringify(config || {}), position_x, position_y, width, height);
+
+  res.status(201).json({
+    id,
+    dashboard_id: req.params.dashboardId,
+    type,
+    config: config || {},
+    position_x,
+    position_y,
+    width,
+    height,
+  });
+});
+
+// DELETE /dashboards/:dashboardId/widgets/:widgetId - Delete widget
+router.delete('/:dashboardId/widgets/:widgetId', (req: AuthenticatedRequest, res: Response) => {
+  if (!req.user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Not authenticated');
+  }
+
+  const db = getDb();
+  const dashboard = db.prepare(
+    'SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(req.params.dashboardId, req.user.tenantId);
+
+  if (!dashboard) {
+    throw new AppError(404, 'NOT_FOUND', 'Dashboard not found');
+  }
+
+  const result = db.prepare(
+    'DELETE FROM widgets WHERE id = ? AND dashboard_id = ?'
+  ).run(req.params.widgetId, req.params.dashboardId);
+
+  if (result.changes === 0) {
+    throw new AppError(404, 'NOT_FOUND', 'Widget not found');
+  }
+
+  res.status(204).send();
+});
+
+export default router;
