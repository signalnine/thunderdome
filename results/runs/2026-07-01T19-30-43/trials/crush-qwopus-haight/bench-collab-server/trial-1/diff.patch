+import { Router } from 'express';
+import Database from 'better-sqlite3';
+
+export function createRoutes(db: Database.Database): Router {
+  const router = Router();
+
+  // POST /docs - Create document
+  router.post('/docs', (req, res) => {
+    const { title, content = '' } = req.body;
+    const id = crypto.randomUUID();
+    const now = new Date().toISOString();
+
+    const stmt = db.prepare(
+      'INSERT INTO documents (id, title, content, created_at, updated_at) VALUES (?, ?, ?, ?, ?)'
+    );
+    stmt.run(id, title, content, now, now);
+
+    // Version 0
+    db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation, created_at) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, 0, content, null, now);
+
+    res.status(201).json({ id, title, content, created_at: now, updated_at: now });
+  });
+
+  // GET /docs - List documents
+  router.get('/docs', (_req, res) => {
+    const docs = db.prepare('SELECT * FROM documents ORDER BY created_at DESC').all();
+    res.json(docs);
+  });
+
+  // GET /docs/:id - Get document
+  router.get('/docs/:id', (req, res) => {
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id);
+    if (!doc) {
+      return res.status(404).json({ error: 'Document not found' });
+    }
+    res.json(doc);
+  });
+
+  // PUT /docs/:id - Update document
+  router.put('/docs/:id', (req, res) => {
+    const { title, content } = req.body;
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id) as Record<string, unknown> | undefined;
+    if (!doc) {
+      return res.status(404).json({ error: 'Document not found' });
+    }
+
+    const now = new Date().toISOString();
+    const newTitle = title !== undefined ? title : (doc.title as string);
+    const newContent = content !== undefined ? content : (doc.content as string);
+
+    db.prepare('UPDATE documents SET title = ?, content = ?, updated_at = ? WHERE id = ?').run(
+      newTitle,
+      newContent,
+      now,
+      req.params.id
+    );
+
+    res.json({ id: req.params.id, title: newTitle, content: newContent, created_at: doc.created_at, updated_at: now });
+  });
+
+  // DELETE /docs/:id - Delete document
+  router.delete('/docs/:id', (req, res) => {
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id);
+    if (!doc) {
+      return res.status(404).json({ error: 'Document not found' });
+    }
+    db.prepare('DELETE FROM documents WHERE id = ?').run(req.params.id);
+    res.status(204).send();
+  });
+
+  // GET /docs/:id/versions - List version history
+  router.get('/docs/:id/versions', (req, res) => {
+    const versions = db.prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC').all(req.params.id);
+    res.json(versions);
+  });
+
+  // GET /docs/:id/versions/:version - Get specific version
+  router.get('/docs/:id/versions/:version', (req, res) => {
+    const version = db.prepare(
+      'SELECT * FROM versions WHERE document_id = ? AND version = ?'
+    ).get(req.params.id, parseInt(req.params.version, 10));
+    if (!version) {
+      return res.status(404).json({ error: 'Version not found' });
+    }
+    res.json(version);
+  });
+
+  return router;
+}
