+import { Operation, InsertOperation, DeleteOperation } from './models.js';
+
+/** Apply an operation to document content */
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    const o = op as InsertOperation;
+    return content.slice(0, o.position) + o.text + content.slice(o.position);
+  }
+  if (op.type === 'delete') {
+    const o = op as DeleteOperation;
+    return content.slice(0, o.position) + content.slice(o.position + o.count);
+  }
+  throw new Error(`Unknown operation type: ${(op as { type: string }).type}`);
+}
+
+/** Validate operation bounds against current content length */
+export function validateOperation(op: Operation, contentLength: number): boolean {
+  if (op.type === 'insert') {
+    const o = op as InsertOperation;
+    if (o.position < 0 || o.position > contentLength) return false;
+    if (typeof o.text !== 'string') return false;
+    return true;
+  }
+  if (op.type === 'delete') {
+    const o = op as DeleteOperation;
+    if (o.position < 0) return false;
+    if (o.count < 0) return false;
+    if (o.position + o.count > contentLength) return false;
+    return true;
+  }
+  return false;
+}
+
+/** Transform op1 against op2 (op2 was applied before op1 in the server's view) */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  // op2 was applied first on the server, we need to transform op1 so it
+  // applies correctly after op2.
+  const o2 = op2 as InsertOperation | DeleteOperation;
+  const o1 = op1 as InsertOperation | DeleteOperation;
+
+  if (o2.type === 'insert') {
+    const i2 = o2 as InsertOperation;
+    if (o1.type === 'insert') {
+      const i1 = o1 as InsertOperation;
+      if (i1.position <= i2.position) {
+        return { type: 'insert' as const, position: i1.position, text: i1.text };
+      }
+      return { type: 'insert' as const, position: i1.position + i2.text.length, text: i1.text };
+    }
+    // o1 is delete
+    const d1 = o1 as DeleteOperation;
+    if (d1.position >= i2.position + i2.text.length) {
+      return { type: 'delete' as const, position: d1.position - i2.text.length, count: d1.count };
+    }
+    if (d1.position >= i2.position) {
+      return { type: 'delete' as const, position: d1.position, count: d1.count };
+    }
+    // o1 deletes before the insert point
+    return { type: 'delete' as const, position: d1.position, count: d1.count };
+  }
+
+  // o2 is delete
+  const d2 = o2 as DeleteOperation;
+  if (o1.type === 'insert') {
+    const i1 = o1 as InsertOperation;
+    if (i1.position <= d2.position) {
+      return { type: 'insert' as const, position: i1.position, text: i1.text };
+    }
+    if (i1.position >= d2.position + d2.count) {
+      return { type: 'insert' as const, position: i1.position - d2.count, text: i1.text };
+    }
+    // Insert point falls within deleted range - push to start of deleted range
+    return { type: 'insert' as const, position: d2.position, text: i1.text };
+  }
+
+  // Both deletes
+  const d1 = o1 as DeleteOperation;
+  if (d1.position >= d2.position + d2.count) {
+    return { type: 'delete' as const, position: d1.position - d2.count, count: d1.count };
+  }
+  if (d1.position + d1.count <= d2.position) {
+    return { type: 'delete' as const, position: d1.position, count: d1.count };
+  }
+  // Overlapping deletes
+  // o2 deletes a range that overlaps with o1's delete range
+  if (d1.position <= d2.position) {
+    // o1 starts before o2
+    const end = Math.min(d1.position + d1.count, d2.position + d2.count);
+    const newCount = end - d2.position;
+    if (newCount <= 0) return { type: 'delete' as const, position: d2.position, count: 0 };
+    return { type: 'delete' as const, position: d2.position, count: newCount };
+  }
+  // d1.position > d2.position
+  const newCount = Math.max(0, d1.position + d1.count - (d2.position + d2.count));
+  return { type: 'delete' as const, position: d1.position - d2.count, count: newCount };
+}
