@@ -0,0 +1,192 @@
+import { WebSocketServer, WebSocket } from 'ws';
+import Database from 'better-sqlite3';
+import { IncomingMessage } from 'http';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+import type { Operation, WsMessage } from './models.js';
+
+interface Room {
+  clients: Map<WebSocket, Set<string>>; // client -> pending versions
+  content: string;
+  version: number;
+  pendingOps: Operation[]; // operations awaiting ack, in order
+}
+
+const rooms = new Map<string, Room>();
+
+function getRoom(docId: string, db: Database.Database): Room | null {
+  const existing = rooms.get(docId);
+  if (existing) return existing;
+
+  const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(docId) as Record<string, unknown> | undefined;
+  if (!doc) return null;
+
+  const room: Room = {
+    clients: new Map(),
+    content: (doc.content as string) || '',
+    version: 0,
+    pendingOps: [],
+  };
+
+  // Get the latest version
+  const latestVersion = db.prepare(
+    'SELECT version FROM versions WHERE document_id = ? ORDER BY version DESC LIMIT 1'
+  ).get(docId);
+  if (latestVersion) {
+    room.version = (latestVersion as { version: number }).version;
+  }
+
+  rooms.set(docId, room);
+  return room;
+}
+
+export function setupWebSocket(
+wss: WebSocketServer,
+  db: Database.Database
+): void {
+  wss.on('connection', (ws: WebSocket & { docId?: string }, req: IncomingMessage) => {
+    const url = new URL(req.url || '', 'http://localhost');
+    const docId = url.pathname.slice(1);
+
+    if (!docId) {
+      ws.send(JSON.stringify({ type: 'error', message: 'Document ID required' }));
+      ws.close();
+      return;
+    }
+
+    ws.docId = docId;
+
+    // Check if document exists
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(docId) as Record<string, unknown> | undefined;
+    if (!doc) {
+      ws.send(JSON.stringify({ type: 'error', message: 'Document not found' }));
+      ws.close();
+      return;
+    }
+
+    // Get or create room
+    const room = getRoom(docId, db);
+    if (!room) {
+      ws.send(JSON.stringify({ type: 'error', message: 'Document not found' }));
+      ws.close();
+      return;
+    }
+
+    // Get current content from DB for accuracy
+    const currentDoc = db.prepare('SELECT * FROM documents WHERE id = ?').get(docId) as Record<string, unknown> | undefined;
+    if (currentDoc) {
+      room.content = currentDoc.content as string;
+    }
+
+    // Get latest version from DB
+    const latestVersion = db.prepare(
+      'SELECT version FROM versions WHERE document_id = ? ORDER BY version DESC LIMIT 1'
+    ).get(docId);
+    if (latestVersion) {
+      room.version = (latestVersion as { version: number }).version;
+    }
+
+    // Track connection
+    room.clients.set(ws, new Set());
+    db.prepare(
+      'INSERT INTO active_connections (id, document_id) VALUES (?, ?)'
+    ).run(crypto.randomUUID(), docId);
+
+    // Send sync message
+    ws.send(JSON.stringify({
+      type: 'sync',
+      content: room.content,
+      version: room.version,
+    } as WsMessage));
+
+    ws.on('message', (data: Buffer) => {
+      let msg: WsMessage;
+      try {
+        msg = JSON.parse(data.toString());
+      } catch {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid JSON' } as WsMessage));
+        return;
+      }
+
+      if (msg.type !== 'operation') {
+        ws.send(JSON.stringify({ type: 'error', message: 'Unknown message type' } as WsMessage));
+        return;
+      }
+
+      const op = msg.operation as Operation | undefined;
+      if (!op || !op.type) {
+        ws.send(JSON.stringify({ type: 'error', message: 'Missing operation' } as WsMessage));
+        return;
+      }
+
+      // Validate operation type
+      if (op.type !== 'insert' && op.type !== 'delete') {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid operation type' } as WsMessage));
+        return;
+      }
+
+      const clientVersion = msg.version ?? room.version;
+
+      // Transform operation against any operations that happened since client's version
+      let transformedOp = op;
+      if (clientVersion < room.version) {
+        const opsSinceClient = room.pendingOps.slice(clientVersion);
+        for (const appliedOp of opsSinceClient) {
+          transformedOp = transformOperation(transformedOp, appliedOp);
+        }
+      }
+
+      // Validate transformed operation
+      if (!validateOperation(transformedOp, room.content.length)) {
+        ws.send(JSON.stringify({ type: 'error', message: 'Operation out of bounds' } as WsMessage));
+        return;
+      }
+
+      // Apply operation
+      const newContent = applyOperation(room.content, transformedOp);
+      room.content = newContent;
+      room.version += 1;
+
+      // Store pending op for future transforms
+      room.pendingOps.push(transformedOp);
+
+      // Save to database
+      const now = new Date().toISOString();
+      db.prepare(
+        'UPDATE documents SET content = ?, updated_at = ? WHERE id = ?'
+      ).run(newContent, now, docId);
+
+      db.prepare(
+        'INSERT INTO versions (document_id, version, content, operation, created_at) VALUES (?, ?, ?, ?, ?)'
+      ).run(docId, room.version, newContent, JSON.stringify(transformedOp), now);
+
+      // Send ack to sender
+      ws.send(JSON.stringify({
+        type: 'ack',
+        version: room.version,
+      } as WsMessage));
+
+      // Broadcast to other clients
+      const broadcastMsg = JSON.stringify({
+        type: 'operation',
+        operation: transformedOp,
+        version: room.version,
+      } as WsMessage);
+
+      for (const [client] of room.clients) {
+        if (client !== ws && client.readyState === WebSocket.OPEN) {
+          client.send(broadcastMsg);
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      db.prepare('DELETE FROM active_connections WHERE document_id = ?').run(docId);
+    });
+
