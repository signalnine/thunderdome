+import { Plugin, BuildContext, ContentFile } from '../core/types.js';
+
+const RELATIVE_URL_RE = /(src|href)="\.\/([^"\s]+)"/g;
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext): ContentFile => {
+        const manifest = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;
+        if (!manifest) {
+          ctx.data.set('asset-manifest', { assets: [] });
+        }
+
+        const currentManifest = ctx.data.get('asset-manifest') as { assets: string[] };
+
+        let newContent = file.content;
+        let match: RegExpExecArray | null;
+
+        const regex = new RegExp(RELATIVE_URL_RE.source, 'g');
+        const matches: RegExpExecArray[] = [];
+        while ((match = regex.exec(file.content)) !== null) {
+          matches.push(match);
+        }
+
+        for (const m of matches) {
+          const attr = m[1];
+          const filename = m[2];
+          currentManifest.assets.push(filename);
+          newContent = newContent.replace(`${attr}="./${filename}"`, `${attr}="/assets/${filename}"`);
+        }
+
+        return {
+          ...file,
+          content: newContent,
+        };
+      },
+    },
+  };
+}
+
+export default createAssetPipelinePlugin;
