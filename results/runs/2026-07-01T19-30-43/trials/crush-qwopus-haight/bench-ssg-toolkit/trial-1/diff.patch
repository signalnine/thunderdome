+import { Plugin, BuildContext, ContentFile } from '../core/types.js';
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, _ctx: BuildContext): ContentFile => {
+        const newContent = file.content.replace(
+          /<pre><code class="language-(\w+)"([^>]*)>([\s\S]*?)<\/code><\/pre>/g,
+          (_match, lang, attrs, codeContent) => {
+            return `<pre data-language="${lang}"${attrs}><code class="language-${lang} highlighted">${codeContent}</code></pre>`;
+          },
+        );
+
+        return {
+          ...file,
+          content: newContent,
+        };
+      },
+    },
+  };
+}
+
+export default createSyntaxHighlightPlugin;
