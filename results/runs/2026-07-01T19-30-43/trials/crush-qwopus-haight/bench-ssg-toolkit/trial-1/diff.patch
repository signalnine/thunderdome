+import { Plugin, BuildContext, ContentFile } from '../core/types.js';
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild: (ctx: BuildContext): void => {
+        const tagMap = new Map<string, ContentFile[]>();
+
+        for (const file of ctx.files) {
+          if (file.tags && file.tags.length > 0) {
+            for (const tag of file.tags) {
+              const normalized = tag.toLowerCase();
+              if (!tagMap.has(normalized)) {
+                tagMap.set(normalized, []);
+              }
+              tagMap.get(normalized)!.push(file);
+            }
+          }
+        }
+
+        ctx.data.set('taxonomy-tags', tagMap);
+      },
+
+      afterBuild: (ctx: BuildContext): void => {
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;
+        if (!tagMap) return;
+
+        for (const [tag, files] of tagMap) {
+          const tagPage = generateTagPage(tag, files, ctx.config);
+          ctx.output.set(`tags/${tag}.html`, tagPage);
+        }
+      },
+    },
+  };
+}
+
+function generateTagPage(tag: string, files: ContentFile[], config: BuildContext['config']): string {
+  const listItems = files
+    .map(f => `<li><a href="${f.slug}.html">${f.title}</a></li>`)
+    .join('\n');
+
+  return `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>Tag: ${tag} | ${config.title}</title>
+</head>
+<body>
+  <h1>Tag: ${tag}</h1>
+  <ul>
+${listItems}
+  </ul>
+</body>
+</html>`;
+}
+
+export default createTaxonomyPlugin;
