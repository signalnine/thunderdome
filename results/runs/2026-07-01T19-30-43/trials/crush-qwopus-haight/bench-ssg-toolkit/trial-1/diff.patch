+import { Plugin, BuildContext, ContentFile } from '../core/types.js';
+import { marked } from 'marked';
+
+const FOOTNOTE_DEF_RE = /^\[\^(\d+)\]:\s*(.+)$/gm;
+const ADMONITION_RE = /:::(note|warning|tip)\n([\s\S]*?)\n:::/g;
+
+function processFootnotes(content: string): { html: string } {
+  const footnotes: { id: string; content: string }[] = [];
+
+  const defMatches = [...content.matchAll(FOOTNOTE_DEF_RE)];
+  for (const m of defMatches) {
+    footnotes.push({ id: m[1], content: m[2].trim() });
+  }
+
+  let processed = content;
+  for (const fn of footnotes) {
+    processed = processed.replace(new RegExp(`\\[\\^${fn.id}\\]`, 'g'), `<sup><a href="#fn-${fn.id}">${fn.id}</a></sup>`);
+  }
+
+  processed = processed.replace(FOOTNOTE_DEF_RE, '');
+  processed = processed.replace(/^\n\s*\n/g, '\n\n');
+
+  let footnoteSection = '';
+  if (footnotes.length > 0) {
+    const items = footnotes
+      .map(fn => `<li id="fn-${fn.id}">${fn.content}</li>`)
+      .join('\n');
+    footnoteSection = `\n<section class="footnotes">
+<ol>
+${items}
+</ol>
+</section>`;
+  }
+
+  return { html: processed + footnoteSection };
+}
+
+function processAdmonitions(content: string): string {
+  return content.replace(ADMONITION_RE, (match, type, body) => {
+    const trimmed = body.trim();
+    return `<div class="admonition admonition-${type}">${trimmed}</div>`;
+  });
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, _ctx: BuildContext): ContentFile => {
+        const content = file.content;
+
+        if (/^<\s*html|^<\s*div|^<\s*span/i.test(content)) {
+          return file;
+        }
+
+        const { html: processed } = processFootnotes(content);
+        const withAdmonitions = processAdmonitions(processed);
+
+        const rendered = marked.parse(withAdmonitions, { async: false }) as string;
+
+        return {
+          ...file,
+          content: rendered,
+        };
+      },
+    },
+  };
+}
+
+export default createMarkdownExtPlugin;
