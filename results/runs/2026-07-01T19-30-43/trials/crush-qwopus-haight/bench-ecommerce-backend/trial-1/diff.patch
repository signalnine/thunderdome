+import { Events, NotificationService, OrderStatus, PaymentStatus } from '../types.js';
+import { EventBus } from '../bus.js';
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const notifications = new Map<string, Array<{ type: string; message: string; timestamp: number }>>();
+  const orderUserMap = new Map<string, string>();
+
+  bus.on(Events.ORDER_CREATED, (payload: unknown) => {
+    const data = payload as { orderId: string; userId: string };
+    if (data.orderId && data.userId) {
+      orderUserMap.set(data.orderId, data.userId);
+    }
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload: unknown) => {
+    const data = payload as { orderId: string; status: OrderStatus; previousStatus: OrderStatus };
+    if (!data.orderId) return;
+
+    const userId = orderUserMap.get(data.orderId);
+    if (!userId || !subscribers.has(userId)) return;
+
+    const entry = {
+      type: 'order_status',
+      message: `Order ${data.orderId} changed from ${data.previousStatus} to ${data.status}`,
+      timestamp: Date.now(),
+    };
+
+    if (!notifications.has(userId)) {
+      notifications.set(userId, []);
+    }
+    notifications.get(userId)!.push(entry);
+    bus.emit(Events.NOTIFICATION_SENT, { userId, type: 'order_status', message: entry.message });
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {
+    const data = payload as { orderId: string; status: PaymentStatus; transactionId?: string; error?: string };
+    if (!data.orderId) return;
+
+    const userId = orderUserMap.get(data.orderId);
+    if (!userId || !subscribers.has(userId)) return;
+
+    const entry = {
+      type: 'payment',
+      message: data.status === PaymentStatus.SUCCESS
+        ? `Payment successful for order ${data.orderId}`
+        : `Payment ${data.status} for order ${data.orderId}`,
+      timestamp: Date.now(),
+    };
+
+    if (!notifications.has(userId)) {
+      notifications.set(userId, []);
+    }
+    notifications.get(userId)!.push(entry);
+    bus.emit(Events.NOTIFICATION_SENT, { userId, type: 'payment', message: entry.message });
+  });
+
+  return {
+    subscribe(userId: string) {
+      subscribers.add(userId);
+      if (!notifications.has(userId)) {
+        notifications.set(userId, []);
+      }
+    },
+
+    getNotifications(userId: string) {
+      if (!subscribers.has(userId)) return [];
+      return notifications.get(userId) || [];
+    },
+  };
+}
