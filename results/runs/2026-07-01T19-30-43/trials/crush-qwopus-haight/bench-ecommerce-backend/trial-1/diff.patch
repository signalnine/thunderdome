@@ -0,0 +1,57 @@
+import { v4 as uuidv4 } from 'uuid';
+import { Events, PaymentService, PaymentStatus } from '../types.js';
+import { EventBus } from '../bus.js';
+
+interface PaymentServiceOptions {
+  simulateFailure?: boolean;
+  simulateTimeout?: boolean;
+}
+
+export function createPaymentService(
+  bus: EventBus,
+  options?: PaymentServiceOptions
+): PaymentService {
+  const transactions = new Map<string, { orderId: string; status: PaymentStatus; amount: number }>();
+
+  return {
+    async processPayment(orderId: string, amount: number) {
+      let status: PaymentStatus;
+      let error: string | undefined;
+
+      if (options?.simulateFailure) {
+        status = PaymentStatus.FAILED;
+        error = 'Payment declined';
+      } else if (options?.simulateTimeout) {
+        status = PaymentStatus.TIMEOUT;
+        error = 'Payment timed out';
+      } else {
+        status = PaymentStatus.SUCCESS;
+      }
+
+      const transactionId = uuidv4();
+      transactions.set(transactionId, { orderId, status, amount });
+
+      await bus.emit(Events.PAYMENT_PROCESSED, {
+        orderId,
+        status,
+        transactionId: status === PaymentStatus.SUCCESS ? transactionId : undefined,
+        error,
+      });
+
+      return {
+        status,
+        transactionId: status === PaymentStatus.SUCCESS ? transactionId : undefined,
+        error,
+      };
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      const tx = transactions.get(transactionId);
+      if (!tx || tx.status !== PaymentStatus.SUCCESS) {
+        return false;
+      }
+      tx.status = PaymentStatus.FAILED;
+      return true;
+    },
+  };
+}
