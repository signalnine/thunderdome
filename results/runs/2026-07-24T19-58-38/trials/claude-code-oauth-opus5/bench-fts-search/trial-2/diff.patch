external content\" table: it stores only the inverted index\n * and reads the original text back out of `notes` via `content_rowid`, so\n * titles and bodies are never duplicated on disk.\n */\nfunction createSearchIndex(db: Database.Database): void {\n  const alreadyIndexed = db\n    .prepare(`SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'notes_fts'`)\n    .get();\n\n  db.exec(`\n    CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts USING fts5(\n      title,\n      body,\n      content='notes',\n      content_rowid='id'\n    );\n\n    CREATE TRIGGER IF NOT EXISTS notes_fts_ai AFTER INSERT ON notes BEGIN\n      INSERT INTO notes_fts (rowid, title, body) VALUES (new.id, new.title, new.body);\n    END;\n\n    CREATE TRIGGER IF NOT EXISTS notes_fts_ad AFTER DELETE ON notes BEGIN\n      INSERT INTO notes_fts (notes_fts, rowid, title, body)\n        VALUES ('delete', old.id, old.title, old.body);\n    END;\n\n    CREATE TRIGGER IF NOT EXISTS notes_fts_au AFTER UPDATE ON notes BEGIN\n      INSERT INTO notes_fts (notes_fts, rowid, title, body)\n        VALUES ('delete', old.id, old.title, old.body);\n      INSERT INTO notes_fts (rowid, title, body) VALUES (new.id, new.title, new.body);\n    END;\n  `);\n\n  // Backfill for databases that already had rows before the index existed.\n  const indexed = db.prepare('SELECT COUNT(*) AS n FROM notes_fts').get() as { n: number };\n  const total = db.prepare('SELECT COUNT(*) AS n FROM notes').get() as { n: number };\n  if (indexed.n !== total.n) {\n    db.exec(`INSERT INTO notes_fts (notes_fts) VALUES ('rebuild')`);\n  }\n}\n\nexport function seedDatabase(db: Database.Database): void {\n  const insert = db.prepare(`\n    INSERT INTO notes (title, body, tags) VALUES (?, ?, ?)\n  `);\n\n  const notes = getSeedNotes();\n\n  const insertMany = db.transaction((items: { title: string; body: string; tags: string }[]) => {\n    for (const item of items) {\n      insert.run(item.title, item.body, item.tags);\n    }\n  });\n\n  insertMany(notes);\n}\n\nfunction getSeedNotes(): { title: string; body: string; tags: string }[] {\n  return [\n    {\n      title: 'Getting Started with TypeScript',\n      body: 'TypeScript is a typed superset of JavaScript that compiles to plain JavaScript. It adds optional static typing and class-based object-oriented programming to the language. TypeScript is designed for development of large applications and transcompiles to JavaScript.',\n      tags: JSON.stringify(['programming', 'typescript', 'javascript']),\n    },\n    {\n      title: 'Introduction to Python Programming',\n      body: 'Python is a high-level, interpreted programming language known for its simplicity and readability. It supports multiple programming paradigms including procedural, object-oriented, and functional programming. Python is widely used in web development, data science, and automation.',\n      tags: JSON.stringify(['programming', 'python']),\n    },\n    {\n      title: 'Understanding Database Indexing',\n      body: 'Database indexing is a data structure technique used to quickly locate and access data in a database. Indexes are created using columns that are frequently searched against. Without an index, the database must scan every row to find relevant data, which becomes slow for large tables.',\n      tags: JSON.stringify(['database', 'performance']),\n    },\n    {\n      title: 'Homemade Pasta Recipe',\n      body: 'Making fresh pasta at home is surprisingly simple. You need flour, eggs, salt, and olive oil. Mix the ingredients to form a dough, knead for 10 minutes until smooth, rest for 30 minutes, then roll out and cut into your desired shape. Cook in boiling salted water for 2-3 minutes.',\n      tags: JSON.stringify(['cooking', 'recipes', 'italian']),\n    },\n    {\n      title: 'Classic Chocolate Chip Cookies',\n      body: 'The perfect chocolate chip cookie requires butter, sugar, brown sugar, eggs, vanilla extract, flour, baking soda, salt, and chocolate chips. Cream