diff --git a/src/search.ts b/src/search.ts
new file mode 100644
index 0000000..d553025
--- /dev/null
+++ b/src/search.ts
@@ -0,0 +1,121 @@
+import Database from 'better-sqlite3';
+import { SearchResult, SuggestResult } from './models.js';
+
+export const PER_PAGE = 20;
+const SUGGEST_LIMIT = 5;
+
+// Titles matter more than bodies, so weight the title column higher when
+// computing BM25. Lower (more negative) scores are more relevant.
+const BM25 = 'bm25(notes_fts, 10.0, 1.0)';
+
+/**
+ * Strips characters that are meaningful to the FTS5 query grammar so that a
+ * user term can be safely embedded inside a double-quoted phrase. Returns null
+ * if nothing searchable is left (e.g. the term was pure punctuation).
+ */
+function sanitizeTerm(term: string): string | null {
+  const cleaned = term.replace(/"/g, ' ').trim();
+  return /[\p{L}\p{N}]/u.test(cleaned) ? cleaned : null;
+}
+
+/**
+ * Splits a raw user query into FTS5 phrase tokens.
+ *
+ * Anything the user wrapped in double quotes stays a single phrase; everything
+ * else is split on whitespace. Every token is re-emitted as a quoted phrase so
+ * that stray operators (`*`, `-`, `NEAR`, `(`, ...) are treated as literal text
+ * rather than query syntax.
+ */
+function toPhrases(raw: string): string[] {
+  const phrases: string[] = [];
+
+  for (const match of raw.matchAll(/"([^"]*)"/g)) {
+    const phrase = sanitizeTerm(match[1]);
+    if (phrase) phrases.push(phrase);
+  }
+
+  const unquoted = raw.replace(/"[^"]*"/g, ' ');
+  for (const word of unquoted.split(/\s+/)) {
+    const term = sanitizeTerm(word);
+    if (term) phrases.push(term);
+  }
+
+  return phrases;
+}
+
+/**
+ * Builds a MATCH expression where all terms must be present.
+ * Returns null when the query has no searchable content.
+ */
+export function buildMatchQuery(raw: string): string | null {
+  const phrases = toPhrases(raw);
+  if (phrases.length === 0) return null;
+  return phrases.map((p) => `"${p}"`).join(' ');
+}
+
+/**
+ * Builds a MATCH expression for autocomplete: all but the final term must match
+ * exactly, while the final (still being typed) term matches as a prefix.
+ */
+export function buildPrefixQuery(raw: string): string | null {
+  const phrases = toPhrases(raw);
+  if (phrases.length === 0) return null;
+  return phrases.map((p, i) => (i === phrases.length - 1 ? `"${p}"*` : `"${p}"`)).join(' ');
+}
+
+export interface SearchPage {
+  results: SearchResult[];
+  total: number;
+  page: number;
+  perPage: number;
+}
+
+export function searchNotes(db: Database.Database, rawQuery: string, page: number): SearchPage {
+  const match = buildMatchQuery(rawQuery);
+  const empty: SearchPage = { results: [], total: 0, page, perPage: PER_PAGE };
+  if (!match) return empty;
+
+  const countStmt = db.prepare(`
+    SELECT COUNT(*) AS total FROM notes_fts WHERE notes_fts MATCH ?
+  `);
+  const resultStmt = db.prepare(`
+    SELECT
+      notes_fts.rowid AS id,
+      notes_fts.title AS title,
+      snippet(notes_fts, -1, '<mark>', '</mark>', '…', 30) AS snippet,
+      ${BM25} AS rank
+    FROM notes_fts
+    WHERE notes_fts MATCH ?
+    ORDER BY ${BM25} ASC
+    LIMIT ? OFFSET ?
+  `);
+
+  try {
+    const { total } = countStmt.get(match) as { total: number };
+    const results = resultStmt.all(match, PER_PAGE, (page - 1) * PER_PAGE) as SearchResult[];
+    return { results, total, page, perPage: PER_PAGE };
+  } catch {
+    // A malformed MATCH expression is a bad query, not a server fault - report
+    // it as "nothing found" rather than a 500.
+    return empty;
+  }
+}
+
+export function suggestNotes(db: Database.Database, rawQuery: string): SuggestResult[] {
+  const match = buildPrefixQuery(rawQuery);
+  if (!match) return [];
+
+  const stmt = db.prepare(`
+    SELECT notes_fts.rowid AS id, notes_fts.title AS title
+    FROM notes_fts
+    WHERE notes_fts MATCH ?
+    ORDER BY ${BM25} ASC
+    LIMIT ?
+  `);
+
+  try {
+    return stmt.all(match, SUGGEST_LIMIT) as SuggestResult[];
+  } catch {
+    return [];
+  }
+}
