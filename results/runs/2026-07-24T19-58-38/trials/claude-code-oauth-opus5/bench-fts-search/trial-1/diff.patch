+import Database from 'better-sqlite3';
+import { SearchResult, SuggestResult } from './models.js';
+
+export const PER_PAGE = 20;
+const SUGGEST_LIMIT = 5;
+
+// Sentinel characters used as snippet delimiters. They are replaced with the
+// <mark> tags *after* the surrounding text has been HTML-escaped, so that
+// note content can never inject markup of its own.
+const MARK_OPEN = String.fromCharCode(1);
+const MARK_CLOSE = String.fromCharCode(2);
+const ELLIPSIS = '…';
+const SNIPPET_TOKENS = 20;
+
+interface SearchRow {
+  id: number;
+  title: string;
+  titleSnippet: string;
+  bodySnippet: string;
+  rank: number;
+}
+
+/**
+ * Splits a chunk of user input into bare FTS5 tokens. Everything that is not a
+ * letter or a digit is a separator, which keeps operators (`*`, `:`, `^`, `-`,
+ * `(`, `"`, `AND`/`OR` punctuation) from ever reaching the query parser.
+ */
+function tokenize(text: string): string[] {
+  return text.split(/[^\p{L}\p{N}]+/u).filter((t) => t.length > 0);
+}
+
+/**
+ * Translates a user query into a safe FTS5 MATCH expression.
+ *
+ * Double-quoted runs are preserved as phrase queries; everything else becomes
+ * an individual term. All terms are ANDed together. When `prefix` is set the
+ * final unquoted term is turned into a prefix query so autocomplete matches
+ * partially typed words.
+ *
+ * Returns null when the input contains nothing searchable, in which case the
+ * caller should report zero results rather than run a query.
+ */
+export function buildMatchQuery(raw: string, prefix = false): string | null {
+  const groups: { terms: string[]; quoted: boolean }[] = [];
+  const pattern = /"([^"]*)"|(\S+)/g;
+
+  let match: RegExpExecArray | null;
+  while ((match = pattern.exec(raw)) !== null) {
+    if (match[1] !== undefined) {
+      const terms = tokenize(match[1]);
+      if (terms.length > 0) {
+        groups.push({ terms, quoted: true });
+      }
+    } else {
+      for (const term of tokenize(match[2])) {
+        groups.push({ terms: [term], quoted: false });
+      }
+    }
+  }
+
+  if (groups.length === 0) {
+    return null;
+  }
+
+  return groups
+    .map((group, i) => {
+      const phrase = `"${group.terms.join(' ')}"`;
+      const isLast = i === groups.length - 1;
+      return prefix && isLast && !group.quoted ? `${phrase}*` : phrase;
+    })
+    .join(' AND ');
+}
+
+function escapeHtml(text: string): string {
+  return text
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+function renderSnippet(raw: string): string {
+  return escapeHtml(raw)
+    .split(MARK_OPEN)
+    .join('<mark>')
+    .split(MARK_CLOSE)
+    .join('</mark>');
+}
+
+/**
+ * Picks the snippet to show: prefer the body (more context) but fall back to
+ * the title when that is where the match actually happened, so a result always
+ * carries highlighting when possible.
+ */
+function pickSnippet(row: SearchRow): string {
+  const body = renderSnippet(row.bodySnippet ?? '');
+  if (body.includes('<mark>')) {
+    return body;
+  }
+  const title = renderSnippet(row.titleSnippet ?? '');
+  return title.includes('<mark>') ? title : body || title;
+}
+
+export interface SearchResponse {
+  results: SearchResult[];
+  total: number;
+  page: number;
+  perPage: number;
+}
+
+export function searchNotes(
+  db: Database.Database,
+  query: string,
+  page: number
+): SearchResponse {
+  const matchQuery = buildMatchQuery(query);
+  const safePage = Number.isFinite(page) && page >= 1 ? Math.floor(page) : 1;
+
+  if (matchQuery === null) {
+    return { results: [], total: 0, page: safePage, perPage: PER_PAGE };
+  }
+
+  const { total } = db
+    .prepare('SELECT COUNT(*) AS total FROM notes_fts WHERE notes_fts MATCH ?')
+    .get(matchQuery) as { total: number };
+
+  const rows = db
+    .prepare(
+      `
+      SELECT
+        rowid AS id,
+        title AS title,
+        snippet(notes_fts, 0, '${MARK_OPEN}', '${MARK_CLOSE}', '${ELLIPSIS}', ${SNIPPET_TOKENS}) AS titleSnippet,
+        snippet(notes_fts, 1, '${MARK_OPEN}', '${MARK_CLOSE}', '${ELLIPSIS}', ${SNIPPET_TOKENS}) AS bodySnippet,
+        rank AS rank
+      FROM notes_fts
+      WHERE notes_fts MATCH ?
+      ORDER BY rank
+      LIMIT ? OFFSET ?
+    `
+    )
+    .all(matchQuery, PER_PAGE, (safePage - 1) * PER_PAGE) as SearchRow[];
+
+  const results: SearchResult[] = rows.map((row) => ({
+    id: row.id,
+    title: row.title,
+    snippet: pickSnippet(row),
+    rank: row.rank,
+  }));
+
+  return { results, total, page: safePage, perPage: PER_PAGE };
+}
+
+export function suggestNotes(db: Database.Database, query: string): SuggestResult[] {
+  const matchQuery = buildMatchQuery(query, true);
+  if (matchQuery === null) {
+    return [];
+  }
+
+  return db
+    .prepare(
+      `
+      SELECT rowid AS id, title AS title
+      FROM notes_fts
+      WHERE notes_fts MATCH ?
+      ORDER BY rank
+      LIMIT ?
+    `
+    )
+    .all(matchQuery, SUGGEST_LIMIT) as SuggestResult[];
+}
