 undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      const input = req.body as Partial<NoteInput>;\n      const title = input.title ?? existing.title;\n      const body = input.body ?? existing.body;\n      const tags = input.tags ? JSON.stringify(input.tags) : existing.tags;\n\n      const stmt = db.prepare(`\n        UPDATE notes SET title = ?, body = ?, tags = ?, updated_at = datetime('now')\n        WHERE id = ?\n      `);\n      stmt.run(title, body, tags, id);\n\n      const note = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note;\n      res.json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // DELETE /notes/:id - Delete note\n  router.delete('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      db.prepare('DELETE FROM notes WHERE id = ?').run(id);\n      res.status(204).send();\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  return router;\n}\n","structuredPatch":[{"oldStart":31,"oldLines":6,"newStart":31,"newLines":28,"lines":["     }","   });"," ","+  // GET /notes/search/suggest - Autocomplete over note content","+  // Registered before /notes/:id so the literal paths win over the id param.","+  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {","+    try {","+      const q = requireQuery(req);","+      res.json({ results: suggestNotes(db, q) });","+    } catch (err) {","+      next(err);","+    }","+  });","+","+  // GET /notes/search - Full-text search","+  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {","+    try {","+      const q = requireQuery(req);","+      const page = parseInt(req.query.page as string) || 1;","+