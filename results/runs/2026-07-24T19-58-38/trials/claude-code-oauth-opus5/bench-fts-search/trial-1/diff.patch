+    const notes = (db.prepare('SELECT COUNT(*) AS c FROM notes').get() as { c: number }).c;
+    if (notes > 0) {
+      db.exec("INSERT INTO notes_fts(notes_fts) VALUES ('rebuild')");
+    }
+  }
+}
