@@ -0,0 +1,103 @@
+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+/** Guards against pathological graphs; cycles are cut before this is reached. */
+const MAX_DEPTH = 100;
+
+const UNKNOWN_VERSION = '0.0.0';
+
+function dependencyNames(name: string, registry: RegistryService): string[] {
+  const manifest = registry.get(name);
+  return manifest ? Object.keys(manifest.dependencies ?? {}) : [];
+}
+
+function versionOf(name: string, registry: RegistryService): string {
+  return registry.get(name)?.version ?? UNKNOWN_VERSION;
+}
+
+/**
+ * Dependency graph operations over a registry. Pure logic: the registry is
+ * passed in, so this module owns no storage of its own.
+ */
+export function createDepsService(): DepsService {
+  function buildTree(name: string, registry: RegistryService): DependencyNode {
+    const build = (current: string, path: string[], depth: number): DependencyNode => {
+      const node: DependencyNode = {
+        name: current,
+        version: versionOf(current, registry),
+        dependencies: [],
+      };
+      if (depth >= MAX_DEPTH) return node;
+      for (const dep of dependencyNames(current, registry)) {
+        // Cut the branch on a cycle rather than recursing forever.
+        if (path.includes(dep)) continue;
+        node.dependencies.push(build(dep, [...path, dep], depth + 1));
+      }
+      return node;
+    };
+    return build(name, [name], 0);
+  }
+
+  function detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const cycles: string[][] = [];
+    const seen = new Set<string>();
+    const visited = new Set<string>();
+    const path: string[] = [];
+
+    const visit = (current: string): void => {
+      const index = path.indexOf(current);
+      if (index !== -1) {
+        const cycle = path.slice(index);
+        const key = [...cycle].sort().join('>');
+        if (!seen.has(key)) {
+          seen.add(key);
+          cycles.push(cycle);
+        }
+        return;
+      }
+      if (visited.has(current)) return;
+      visited.add(current);
+      path.push(current);
+      for (const dep of dependencyNames(current, registry)) {
+        visit(dep);
+      }
+      path.pop();
+    };
+
+    visit(name);
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  function topologicalSort(name: string, registry: RegistryService): string[] {
+    const sorted: string[] = [];
+    const done = new Set<string>();
+    const inPath = new Set<string>();
+
+    const visit = (current: string): void => {
+      if (done.has(current) || inPath.has(current)) return;
+      inPath.add(current);
+      for (const dep of dependencyNames(current, registry)) {
+        visit(dep);
+      }
+      inPath.delete(current);
+      done.add(current);
+      sorted.push(current);
+    };
+
+    visit(name);
+    return sorted;
+  }
+
+  function flattenDependencies(name: string, registry: RegistryService): string[] {
+    return topologicalSort(name, registry).filter(dep => dep !== name);
+  }
+
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return detectCycles(name, registry) !== null;
+    },
+  };
+}
