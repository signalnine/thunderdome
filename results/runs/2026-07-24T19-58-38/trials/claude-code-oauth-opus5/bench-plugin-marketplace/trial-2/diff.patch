+++ b/src/registry/index.ts
@@ -0,0 +1,145 @@
+import Database from 'better-sqlite3';
+import { rcompare, valid } from 'semver';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+interface PluginRow {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies: string;
+  entryPoint: string;
+  permissions: string;
+}
+
+function toManifest(row: PluginRow): PluginManifest {
+  return {
+    name: row.name,
+    version: row.version,
+    description: row.description,
+    author: row.author,
+    dependencies: JSON.parse(row.dependencies) as Record<string, string>,
+    entryPoint: row.entryPoint,
+    permissions: JSON.parse(row.permissions) as string[],
+  };
+}
+
+/** Newest first; invalid semver falls back to reverse lexicographic order. */
+function byVersionDesc(a: string, b: string): number {
+  if (valid(a) && valid(b)) return rcompare(a, b);
+  return a < b ? 1 : a > b ? -1 : 0;
+}
+
+const SCHEMA = `
+  CREATE TABLE IF NOT EXISTS plugins (
+    name TEXT NOT NULL,
+    version TEXT NOT NULL,
+    description TEXT NOT NULL DEFAULT '',
+    author TEXT NOT NULL DEFAULT '',
+    dependencies TEXT NOT NULL DEFAULT '{}',
+    entryPoint TEXT NOT NULL DEFAULT '',
+    permissions TEXT NOT NULL DEFAULT '[]',
+    PRIMARY KEY (name, version)
+  );
+`;
+
+/**
+ * Plugin registry backed by SQLite. Plugins are keyed by (name, version), so
+ * several versions of the same plugin coexist.
+ */
+export function createRegistry(dbPath = ':memory:'): RegistryService {
+  const db = new Database(dbPath);
+  db.pragma('journal_mode = MEMORY');
+  db.exec(SCHEMA);
+
+  const insert = db.prepare(
+    `INSERT INTO plugins (name, version, description, author, dependencies, entryPoint, permissions)
+     VALUES (@name, @version, @description, @author, @dependencies, @entryPoint, @permissions)
+     ON CONFLICT (name, version) DO UPDATE SET
+       description = excluded.description,
+       author = excluded.author,
+       dependencies = excluded.dependencies,
+       entryPoint = excluded.entryPoint,
+       permissions = excluded.permissions`
+  );
+  const selectByName = db.prepare('SELECT * FROM plugins WHERE name = ?');
+  const selectByVersion = db.prepare('SELECT * FROM plugins WHERE name = ? AND version = ?');
+  const selectAll = db.prepare('SELECT * FROM plugins ORDER BY name, version');
+  const deleteVersion = db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?');
+
+  function rowsFor(name: string): PluginRow[] {
+    return (selectByName.all(name) as PluginRow[]).sort((a, b) => byVersionDesc(a.version, b.version));
+  }
+
+  function findVersion(name: string, version: string): PluginManifest | null {
+    const row = selectByVersion.get(name, version) as PluginRow | undefined;
+    return row ? toManifest(row) : null;
+  }
+
+  return {
+    register(manifest: PluginManifest): void {
+      if (!manifest.name || !manifest.version) {
+        throw new Error('Invalid manifest: name and version are required');
+      }
+      insert.run({
+        name: manifest.name,
+        version: manifest.version,
+        description: manifest.description ?? '',
+        author: manifest.author ?? '',
+        dependencies: JSON.stringify(manifest.dependencies ?? {}),
+        entryPoint: manifest.entryPoint ?? '',
+        permissions: JSON.stringify(manifest.permissions ?? []),
+      });
+    },
+
+    /** Returns the highest registered version of the plugin. */
+    get(name: string): PluginManifest | null {
+      const rows = rowsFor(name);
+      return rows.length > 0 ? toManifest(rows[0]) : null;
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      return findVersion(name, version);
+    },
+
+    list(): PluginManifest[] {
+      return (selectAll.all() as PluginRow[]).map(toManifest);
+    },
+
+    search(query: string): PluginManifest[] {
+      const needle = query.toLowerCase();
+      return (selectAll.all() as PluginRow[])
+        .map(toManifest)
+        .filter(
+          p =>
+            p.name.toLowerCase().includes(needle) ||
+            p.description.toLowerCase().includes(needle)
+        );
+    },
+
+    remove(name: string, version: string): boolean {
+      return deleteVersion.run(name, version).changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      return rowsFor(name).map(r => r.version);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const existing = findVersion(name, version);
+      if (!existing) {
+        throw new Error(`Plugin not found: ${name}@${version}`);
+      }
+      const merged: PluginManifest = { ...existing, ...updates, name, version };
+      insert.run({
+        name,
+        version,
+        description: merged.description,
+        author: merged.author,
+        dependencies: JSON.stringify(merged.dependencies),
+        entryPoint: merged.entryPoint,
+        permissions: JSON.stringify(merged.permissions),
+      });
+    },
+  };
+}
