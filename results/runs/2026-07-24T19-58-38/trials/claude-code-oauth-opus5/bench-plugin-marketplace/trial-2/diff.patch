     const existing = selectById.get(reviewId) as ReviewRow | undefined;\n      if (!existing) {\n        throw new Error(`Review not found: ${reviewId}`);\n      }\n      setFlagged.run(reviewId);\n    },\n\n    getFlaggedReviews(): Review[] {\n      return (selectFlagged.all() as ReviewRow[]).map(toReview);\n    },\n\n    removeReview(reviewId: number): boolean {\n      return deleteById.run(reviewId).changes > 0;\n    },\n\n    getReviewsByUser(userId: string): Review[] {\n      return (selectByUser.all(userId) as ReviewRow[]).map(toReview);\n    },\n\n    getReviewCount(pluginName: string): number {\n      const row = countForPlugin.get(pluginName) as { count: number };\n      return row.count;\n    },\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":206,"cache_read_input_tokens":45793,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":206},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ce62dad6-bee2-4238-b646-d60ca2f3564d","uuid":"8f097b08-7509-48f1-95e0-56aaa61eaa9d","request_id":"req_011CdMVn25m4CFbdwZ8XzPR4"}
