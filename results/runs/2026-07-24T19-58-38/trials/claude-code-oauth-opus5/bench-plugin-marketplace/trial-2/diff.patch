+import type { ResolvedVersion, ResolverService, VersionConstraint } from '../types.js';
+
+/**
+ * Semver constraint resolver. Each constraint is resolved independently against
+ * the versions available for that plugin name, picking the highest match.
+ */
+export function createResolver(): ResolverService {
+  return {
+    resolve(
+      constraints: VersionConstraint[],
+      available: Record<string, string[]>
+    ): ResolvedVersion[] {
+      return constraints.map(constraint => {
+        if (!validRange(constraint.range)) {
+          throw new Error(
+            `Invalid range "${constraint.range}" for "${constraint.name}"`
+          );
+        }
+        const versions = available[constraint.name] ?? [];
+        const version = maxSatisfying(versions, constraint.range, { loose: true });
+        if (version === null) {
+          throw new Error(
+            `Unsatisfiable constraint: no version of "${constraint.name}" satisfies "${constraint.range}"` +
+              ` (available: ${versions.join(', ') || 'none'})`
+          );
+        }
+        return { name: constraint.name, version, satisfies: constraint.range };
+      });
+    },
+
+    satisfies(version: string, range: string): boolean {
+      if (!validRange(range)) return false;
+      return satisfies(version, range, { loose: true });
+    },
+
+    maxSatisfying(versions: string[], range: string): string | null {
+      if (!validRange(range)) return null;
+      return maxSatisfying(versions, range, { loose: true });
+    },
+
+    validRange(range: string): boolean {
+      return validRange(range) !== null;
+    },
+  };
+}
diff --git a/src/reviews/index.ts b/src/reviews/index.ts
new file mode 100644
index 0000000..dfd36c2
--- /dev/null
+++ b/src/reviews/index.ts
@@ -0,0 +1,131 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+function toReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged !== 0,
+    createdAt: row.createdAt,
+  };
+}
+
+const SCHEMA = `
+  CREATE TABLE IF NOT EXISTS reviews (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    pluginName TEXT NOT NULL,
+    pluginVersion TEXT NOT NULL,
+    userId TEXT NOT NULL,
+    rating INTEGER NOT NULL,
+    comment TEXT NOT NULL DEFAULT '',
+    flagged INTEGER NOT NULL DEFAULT 0,
+    createdAt TEXT NOT NULL
+  );
+  CREATE INDEX IF NOT EXISTS idx_reviews_plugin ON reviews (pluginName);
+  CREATE INDEX IF NOT EXISTS idx_reviews_user ON reviews (userId);
+`;
+
+/**
+ * Ratings, comments and moderation flags backed by SQLite. Flagged reviews stay
+ * queryable but are excluded from the average rating.
+ */
+export function createReviewSystem(dbPath = ':memory:'): ReviewService {
+  const db = new Database(dbPath);
+  db.pragma('journal_mode = MEMORY');
+  db.exec(SCHEMA);
+
+  const insert = db.prepare(
+    `INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+     VALUES (@pluginName, @pluginVersion, @userId, @rating, @comment, 0, @createdAt)`
+  );
+  const selectById = db.prepare('SELECT * FROM reviews WHERE id = ?');
+  const selectByPlugin = db.prepare('SELECT * FROM reviews WHERE pluginName = ? ORDER BY id');
+  const selectByUser = db.prepare('SELECT * FROM reviews WHERE userId = ? ORDER BY id');
+  const selectFlagged = db.prepare('SELECT * FROM reviews WHERE flagged = 1 ORDER BY id');
+  const averageRating = db.prepare(
+    'SELECT AVG(rating) AS avg FROM reviews WHERE pluginName = ? AND flagged = 0'
+  );
+  const countForPlugin = db.prepare(
+    'SELECT COUNT(*) AS count FROM reviews WHERE pluginName = ?'
+  );
+  const setFlagged = db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');
+  const deleteById = db.prepare('DELETE FROM reviews WHERE id = ?');
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      if (!Number.isFinite(review.rating) || review.rating < 1 || review.rating > 5) {
+        throw new Error(`Invalid rating: ${review.rating} (expected 1-5)`);
+      }
+      const createdAt = new Date().toISOString();
+      const info = insert.run({
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment ?? '',
+        createdAt,
+      });
+      return {
+        id: Number(info.lastInsertRowid),
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment ?? '',
+        flagged: false,
+        createdAt,
+      };
+    },
+
+    getReviews(pluginName: string): Review[] {
+      return (selectByPlugin.all(pluginName) as ReviewRow[]).map(toReview);
+    },
+
+    /** Average of unflagged ratings, rounded to two decimals; 0 when none. */
+    getAverageRating(pluginName: string): number {
+      const row = averageRating.get(pluginName) as { avg: number | null };
+      if (row.avg === null) return 0;
+      return Math.round(row.avg * 100) / 100;
+    },
+
+    flagReview(reviewId: number): void {
+      const existing = selectById.get(reviewId) as ReviewRow | undefined;
+      if (!existing) {
+        throw new Error(`Review not found: ${reviewId}`);
+      }
+      setFlagged.run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      return (selectFlagged.all() as ReviewRow[]).map(toReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      return deleteById.run(reviewId).changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      return (selectByUser.all(userId) as ReviewRow[]).map(toReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = countForPlugin.get(pluginName) as { count: number };
+      return row.count;
+    },
+  };
+}
diff --git a/src/runner/index.ts b/src/runner/index.ts
new file mode 100644
index 0000000..7ad60a5
--- /dev/null
+++ b/src/runner/index.ts
@@ -0,0 +1,82 @@
+import { createContext, Script } from 'vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+/**
+ * Plugin code is treated as a function body, so `return` works and the
+ * completion value of the wrapper call becomes the sandbox output.
+ */
+function wrap(code: string): string {
+  return `(function () {\n${code}\n})()`;
+}
+
+/**
+ * Values crossing the vm realm boundary are copied into this realm when
+ * possible, so callers never hold a reference into a sandbox context.
+ */
+function detach(value: unknown): unknown {
+  if (value === null || typeof value !== 'object') return value;
+  try {
+    return structuredClone(value);
+  } catch {
+    return value;
+  }
+}
+
+function heapUsed(): number {
+  return process.memoryUsage().heapUsed;
+}
+
+function runIsolated(
+  code: string,
+  timeoutMs: number,
+  context: Record<string, unknown>
+): SandboxResult {
+  const sandbox: Record<string, unknown> = { ...context };
+  const startMemory = heapUsed();
+  const start = Date.now();
+
+  try {
+    const script = new Script(wrap(code));
+    const output: unknown = script.runInContext(createContext(sandbox), {
+      timeout: timeoutMs,
+      displayErrors: true,
+    });
+    return {
+      success: true,
+      output: detach(output),
+      duration: Date.now() - start,
+      memoryUsed: Math.max(0, heapUsed() - startMemory),
+    };
+  } catch (err) {
+    return {
+      success: false,
+      output: undefined,
+      duration: Date.now() - start,
+      memoryUsed: Math.max(0, heapUsed() - startMemory),
+      error: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+/** Executes untrusted plugin code in a fresh `vm` context per run. */
+export function createRunner(): RunnerService {
+  return {
+    async execute(
+      code: string,
+      context: Record<string, unknown> = {}
+    ): Promise<SandboxResult> {
+      return runIsolated(code, DEFAULT_TIMEOUT_MS, context);
+    },
+
+    async executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context: Record<string, unknown> = {}
+    ): Promise<SandboxResult> {
+      const timeout = Number.isFinite(timeoutMs) && timeoutMs > 0 ? timeoutMs : DEFAULT_TIMEOUT_MS;
+      return runIsolated(code, timeout, context);
+    },
+  };
+}
