,"tool_use_result":{"type":"text","file":{"filePath":"/workspace/tests/registry.test.ts","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { createRegistry } from '../src/registry/index.js';\nimport type { PluginManifest, RegistryService } from '../src/types.js';\n\nfunction makeManifest(overrides: Partial<PluginManifest> = {}): PluginManifest {\n  return {\n    name: 'test-plugin',\n    version: '1.0.0',\n    description: 'A test plugin',\n    author: 'tester',\n    dependencies: {},\n    entryPoint: 'return 42;',\n    permissions: ['read'],\n    ...overrides,\n  };\n}\n\ndescribe('Plugin Registry', () => {\n  let registry: RegistryService;\n\n  beforeEach(() => {\n    registry = createRegistry();\n  });\n\n  it('register stores plugin manifest', () => {\n    const manifest = makeManifest();\n    registry.register(manifest);\n    const stored = registry.get('test-plugin');\n    expect(stored).not.toBeNull();\n    expect(stored!.name).toBe('test-plugin');\n    expect(stored!.version).toBe('1.0.0');\n  });\n\n  it('get retrieves registered plugin', () => {\n    const manifest = makeManifest({ description: 'special plugin' });\n    registry.register(manifest);\n    const result = registry.get('test-plugin');\n    expect(result).not.toBeNull();\n    expect(result!.description).toBe('special plugin');\n  });\n\n  it('get returns null for unregistered', () => {\n    const result = registry.get('nonexistent');\n    expect(result).toBeNull();\n  });\n\n  it('list returns all plugins', () => {\n    registry.register(makeManifest({ name: 'plugin-a', version: '1.0.0' }));\n    registry.register(makeManifest({ name: 'plugin-b', version: '2.0.0' }));\n    const all = registry.list();\n    expect(all).toHaveLength(2);\n    const names = all.map(p => p.name);\n    expect(names).toContain('plugin-a');\n    expect(names).toContain('plugin-b');\n  });\n\n  it('search finds by name substring', () => {\n    registry.register(makeManifest({ name: 'awesome-logger' }));\n    registry.register(makeManifest({ name: 'basic-util' }));\n    const results = registry.search('logger');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('awesome-logger');\n  });\n\n  it('search finds by description', () => {\n    registry.register(makeManifest({ name: 'foo', description: 'A fantastic logging utility' }));\n    registry.register(makeManifest({ name: 'bar', description: 'Math helpers' }));\n    const results = registry.search('logging');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('foo');\n  });\n\n  it('remove deletes plugin version', () => {\n    registry.register(makeManifest({ name: 'removable', version: '1.0.0' }));\n    expect(registry.get('removable')).not.toBeNull();\n    const removed = registry.remove('removable', '1.0.0');\n    expect(removed).toBe(true);\n    expect(registry.get('removable')).toBeNull();\n  });\n\n  it('listVersions returns all versions for a plugin', () => {\n    registry.register(makeManifest({ name: 'multi', version: '1.0.0' }));\n    registry.register(makeManifest({ name: 'multi', version: '1.1.0' }));\n    registry.register(makeManifest({ name: 'multi', version: '2.0.0' }));\n    const versions = registry.listVersions('multi');\n    expect(versions).toHaveLength(3);\n    expect(versions).toContain('1.0.0');\n    expect(versions).toContain('1.1.0');\n    expect(versions).toContain('2.0.0');\n  });\n});\n","numLines":92,"startLine":1,"totalLines":92}}}
