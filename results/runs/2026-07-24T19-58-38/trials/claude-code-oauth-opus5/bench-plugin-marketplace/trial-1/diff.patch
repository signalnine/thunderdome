@@ -0,0 +1,48 @@
+import semver from 'semver';
+import type { ResolvedVersion, ResolverService, VersionConstraint } from '../types.js';
+
+/**
+ * Pure semver constraint resolution. Each constraint is resolved
+ * independently against the versions available for its plugin.
+ */
+export function createResolver(): ResolverService {
+  const service: ResolverService = {
+    resolve(
+      constraints: VersionConstraint[],
+      available: Record<string, string[]>
+    ): ResolvedVersion[] {
+      return constraints.map(constraint => {
+        const { name, range } = constraint;
+        if (!service.validRange(range)) {
+          throw new Error(`Invalid version range "${range}" for ${name}`);
+        }
+        const versions = available[name];
+        if (!versions || versions.length === 0) {
+          throw new Error(`No versions available for ${name}`);
+        }
+        const match = service.maxSatisfying(versions, range);
+        if (match === null) {
+          throw new Error(
+            `Unsatisfiable constraint: ${name}@${range} (available: ${versions.join(', ')})`
+          );
+        }
+        return { name, version: match, satisfies: range };
+      });
+    },
+
+    satisfies(version: string, range: string): boolean {
+      return semver.satisfies(version, range, { loose: true });
+    },
+
+    maxSatisfying(versions: string[], range: string): string | null {
+      if (!semver.validRange(range)) return null;
+      return semver.maxSatisfying(versions, range, { loose: true });
+    },
+
+    validRange(range: string): boolean {
+      return semver.validRange(range) !== null;
+    },
+  };
+
+  return service;
+}
