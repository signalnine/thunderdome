@@ -0,0 +1,126 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  plugin_name: string;
+  plugin_version: string;
+  user_id: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  created_at: string;
+}
+
+const SCHEMA = `
+  CREATE TABLE IF NOT EXISTS reviews (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    plugin_name TEXT NOT NULL,
+    plugin_version TEXT NOT NULL,
+    user_id TEXT NOT NULL,
+    rating INTEGER NOT NULL CHECK (rating >= 1 AND rating <= 5),
+    comment TEXT NOT NULL DEFAULT '',
+    flagged INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT NOT NULL
+  );
+  CREATE INDEX IF NOT EXISTS idx_reviews_plugin ON reviews(plugin_name);
+  CREATE INDEX IF NOT EXISTS idx_reviews_user ON reviews(user_id);
+`;
+
+function rowToReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.plugin_name,
+    pluginVersion: row.plugin_version,
+    userId: row.user_id,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged !== 0,
+    createdAt: row.created_at,
+  };
+}
+
+/**
+ * Review store backed by an in-memory SQLite database. Ratings, comments and
+ * moderation flags live together; flagged reviews are excluded from averages.
+ */
+export function createReviewSystem(filename = ':memory:'): ReviewService {
+  const db = new Database(filename);
+  db.pragma('journal_mode = MEMORY');
+  db.exec(SCHEMA);
+
+  const insertStmt = db.prepare(
+    `INSERT INTO reviews (plugin_name, plugin_version, user_id, rating, comment, flagged, created_at)
+     VALUES (?, ?, ?, ?, ?, 0, ?)`
+  );
+  const byIdStmt = db.prepare('SELECT * FROM reviews WHERE id = ?');
+  const byPluginStmt = db.prepare('SELECT * FROM reviews WHERE plugin_name = ? ORDER BY id');
+  const byUserStmt = db.prepare('SELECT * FROM reviews WHERE user_id = ? ORDER BY id');
+  const flaggedStmt = db.prepare('SELECT * FROM reviews WHERE flagged = 1 ORDER BY id');
+  const avgStmt = db.prepare(
+    'SELECT AVG(rating) AS avg FROM reviews WHERE plugin_name = ? AND flagged = 0'
+  );
+  const countStmt = db.prepare('SELECT COUNT(*) AS count FROM reviews WHERE plugin_name = ?');
+  const flagStmt = db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');
+  const deleteStmt = db.prepare('DELETE FROM reviews WHERE id = ?');
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      if (!Number.isInteger(review.rating) || review.rating < 1 || review.rating > 5) {
+        throw new Error(`Invalid rating: ${review.rating} (must be an integer 1-5)`);
+      }
+      const createdAt = new Date().toISOString();
+      const info = insertStmt.run(
+        review.pluginName,
+        review.pluginVersion,
+        review.userId,
+        review.rating,
+        review.comment ?? '',
+        createdAt
+      );
+      return {
+        id: Number(info.lastInsertRowid),
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment ?? '',
+        flagged: false,
+        createdAt,
+      };
+    },
+
+    getReviews(pluginName: string): Review[] {
+      return (byPluginStmt.all(pluginName) as ReviewRow[]).map(rowToReview);
+    },
+
+    /** Average of non-flagged ratings, rounded to 2 decimals. 0 when there are none. */
+    getAverageRating(pluginName: string): number {
+      const row = avgStmt.get(pluginName) as { avg: number | null };
+      if (row.avg === null) return 0;
+      return Math.round(row.avg * 100) / 100;
+    },
+
+    flagReview(reviewId: number): void {
+      const existing = byIdStmt.get(reviewId) as ReviewRow | undefined;
+      if (!existing) throw new Error(`Review not found: ${reviewId}`);
+      flagStmt.run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      return (flaggedStmt.all() as ReviewRow[]).map(rowToReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      return deleteStmt.run(reviewId).changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      return (byUserStmt.all(userId) as ReviewRow[]).map(rowToReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      return (countStmt.get(pluginName) as { count: number }).count;
+    },
+  };
+}
