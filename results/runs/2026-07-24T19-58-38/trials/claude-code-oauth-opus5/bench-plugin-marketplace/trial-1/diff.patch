@@ -0,0 +1,111 @@
+import { createRegistry } from './registry/index.js';
+import { createResolver } from './resolver/index.js';
+import { createRunner } from './runner/index.js';
+import { createReviewSystem } from './reviews/index.js';
+import { createDepsService } from './deps/index.js';
+import type {
+  DepsService,
+  PluginManifest,
+  RegistryService,
+  ResolvedVersion,
+  ResolverService,
+  ReviewService,
+  RunnerService,
+  SandboxResult,
+  VersionConstraint,
+} from './types.js';
+
+export interface InstallResult {
+  manifest: PluginManifest;
+  resolved: ResolvedVersion[];
+  sandboxResult: SandboxResult;
+}
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest): Promise<InstallResult>;
+}
+
+export interface MarketplaceOptions {
+  /** Timeout applied when running a plugin's entry point. */
+  installTimeoutMs?: number;
+}
+
+function validateManifest(manifest: PluginManifest): void {
+  if (!manifest || typeof manifest !== 'object') {
+    throw new Error('Invalid manifest: expected an object');
+  }
+  const missing: string[] = [];
+  if (typeof manifest.name !== 'string' || manifest.name.trim() === '') missing.push('name');
+  if (typeof manifest.version !== 'string' || manifest.version.trim() === '') missing.push('version');
+  if (typeof manifest.entryPoint !== 'string' || manifest.entryPoint.trim() === '') {
+    missing.push('entryPoint');
+  }
+  if (missing.length > 0) {
+    throw new Error(`Invalid manifest: missing or empty ${missing.join(', ')}`);
+  }
+}
+
+/** Composes the five independent modules into a single marketplace facade. */
+export function createMarketplace(options: MarketplaceOptions = {}): Marketplace {
+  const installTimeoutMs = options.installTimeoutMs ?? 5000;
+
+  const registry = createRegistry();
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviewSystem();
+  const deps = createDepsService();
+
+  const marketplace: Marketplace = {
+    registry,
+    resolver,
+    runner,
+    reviews,
+    deps,
+
+    async installPlugin(manifest: PluginManifest): Promise<InstallResult> {
+      validateManifest(manifest);
+      registry.register(manifest);
+
+      const constraints: VersionConstraint[] = Object.entries(manifest.dependencies ?? {}).map(
+        ([name, range]) => ({ name, range })
+      );
+      const available: Record<string, string[]> = {};
+      for (const { name } of constraints) {
+        available[name] = registry.listVersions(name);
+      }
+      const resolved = resolver.resolve(constraints, available);
+
+      if (deps.hasCircularDependency(manifest.name, registry)) {
+        throw new Error(`Circular dependency detected involving ${manifest.name}`);
+      }
+
+      const sandboxResult = await runner.executeWithTimeout(
+        manifest.entryPoint,
+        installTimeoutMs
+      );
+
+      return { manifest, resolved, sandboxResult };
+    },
+  };
+
+  return marketplace;
+}
+
+export type {
+  DependencyNode,
+  DepsService,
+  PluginManifest,
+  RegistryService,
+  ResolvedVersion,
+  ResolverService,
+  Review,
+  ReviewService,
+  RunnerService,
+  SandboxResult,
+  VersionConstraint,
+} from './types.js';
