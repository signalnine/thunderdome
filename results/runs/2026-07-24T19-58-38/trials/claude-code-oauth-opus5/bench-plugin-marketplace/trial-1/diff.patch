@@ -0,0 +1,101 @@
+import vm from 'node:vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+/** Globals every sandbox gets. Deliberately excludes I/O, process and require. */
+function baseSandbox(): Record<string, unknown> {
+  return {
+    console: {
+      log: () => undefined,
+      warn: () => undefined,
+      error: () => undefined,
+    },
+    Math,
+    JSON,
+    Date,
+  };
+}
+
+/**
+ * Rebuild a value produced inside the sandbox realm using host-realm
+ * constructors, so callers get plain objects/arrays they can compare and
+ * serialize normally.
+ */
+function toHostValue(value: unknown, depth = 0): unknown {
+  if (value === null || typeof value !== 'object' || depth > 20) return value;
+  if (Array.isArray(value)) return value.map(item => toHostValue(item, depth + 1));
+
+  const tag = Object.prototype.toString.call(value);
+  if (tag !== '[object Object]') return value;
+
+  const out: Record<string, unknown> = {};
+  for (const [key, item] of Object.entries(value as Record<string, unknown>)) {
+    out[key] = toHostValue(item, depth + 1);
+  }
+  return out;
+}
+
+function errorMessage(err: unknown): string {
+  if (err instanceof Error) return err.message;
+  return String(err);
+}
+
+/**
+ * Runs untrusted plugin code in a fresh `vm` context. Each call gets its own
+ * context, so no state leaks between executions.
+ */
+export function createRunner(): RunnerService {
+  async function run(
+    code: string,
+    timeoutMs: number,
+    context: Record<string, unknown> = {}
+  ): Promise<SandboxResult> {
+    const sandbox: Record<string, unknown> = { ...baseSandbox(), ...context };
+    const heapBefore = process.memoryUsage().heapUsed;
+    const started = Date.now();
+
+    try {
+      const script = new vm.Script(`(function () {\n${code}\n})();`, {
+        filename: 'plugin.vm.js',
+      });
+      const vmContext = vm.createContext(sandbox, {
+        codeGeneration: { strings: false, wasm: false },
+      });
+      const output = script.runInContext(vmContext, {
+        timeout: timeoutMs,
+        breakOnSigint: true,
+      });
+      const heapAfter = process.memoryUsage().heapUsed;
+      return {
+        success: true,
+        output: toHostValue(output),
+        duration: Date.now() - started,
+        memoryUsed: Math.max(0, heapAfter - heapBefore),
+      };
+    } catch (err) {
+      const heapAfter = process.memoryUsage().heapUsed;
+      return {
+        success: false,
+        output: undefined,
+        duration: Date.now() - started,
+        memoryUsed: Math.max(0, heapAfter - heapBefore),
+        error: errorMessage(err),
+      };
+    }
+  }
+
+  return {
+    execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult> {
+      return run(code, DEFAULT_TIMEOUT_MS, context);
+    },
+
+    executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context?: Record<string, unknown>
+    ): Promise<SandboxResult> {
+      return run(code, timeoutMs, context);
+    },
+  };
+}
