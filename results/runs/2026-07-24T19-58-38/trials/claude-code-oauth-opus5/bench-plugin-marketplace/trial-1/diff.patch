@@ -0,0 +1,129 @@
+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+const MAX_DEPTH = 100;
+
+function dependencyNames(name: string, registry: RegistryService): string[] {
+  const manifest = registry.get(name);
+  if (!manifest) return [];
+  return Object.keys(manifest.dependencies ?? {});
+}
+
+/**
+ * Dependency graph algorithms over whatever is in a registry.
+ * Pure logic: the registry is passed in, never imported.
+ */
+export function createDepsService(): DepsService {
+  const service: DepsService = {
+    /**
+     * Builds the dependency tree rooted at `name`. Recursion stops at a node
+     * already on the current path (cycle) or at MAX_DEPTH.
+     */
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      const path = new Set<string>();
+
+      const build = (current: string, depth: number): DependencyNode => {
+        const manifest = registry.get(current);
+        const node: DependencyNode = {
+          name: current,
+          version: manifest?.version ?? '0.0.0',
+          dependencies: [],
+        };
+        if (!manifest || depth >= MAX_DEPTH || path.has(current)) return node;
+
+        path.add(current);
+        for (const dep of Object.keys(manifest.dependencies ?? {})) {
+          node.dependencies.push(build(dep, depth + 1));
+        }
+        path.delete(current);
+        return node;
+      };
+
+      return build(name, 0);
+    },
+
+    /**
+     * DFS cycle detection. Returns every distinct cycle found as a list of
+     * names in traversal order, or null when the graph is acyclic.
+     */
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const cycles: string[][] = [];
+      const seenCycles = new Set<string>();
+      const visited = new Set<string>();
+      const path: string[] = [];
+      const onPath = new Set<string>();
+
+      const visit = (current: string): void => {
+        if (onPath.has(current)) {
+          const cycle = path.slice(path.indexOf(current));
+          const key = [...cycle].sort().join('|');
+          if (!seenCycles.has(key)) {
+            seenCycles.add(key);
+            cycles.push(cycle);
+          }
+          return;
+        }
+        if (visited.has(current)) return;
+
+        visited.add(current);
+        onPath.add(current);
+        path.push(current);
+        for (const dep of dependencyNames(current, registry)) {
+          visit(dep);
+        }
+        path.pop();
+        onPath.delete(current);
+      };
+
+      visit(name);
+      return cycles.length > 0 ? cycles : null;
+    },
+
+    /** Dependencies first, `name` last. Throws when the graph has a cycle. */
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const sorted: string[] = [];
+      const visited = new Set<string>();
+      const onPath = new Set<string>();
+
+      const visit = (current: string): void => {
+        if (visited.has(current)) return;
+        if (onPath.has(current)) {
+          throw new Error(`Circular dependency detected at ${current}`);
+        }
+
+        onPath.add(current);
+        for (const dep of dependencyNames(current, registry)) {
+          visit(dep);
+        }
+        onPath.delete(current);
+        visited.add(current);
+        sorted.push(current);
+      };
+
+      visit(name);
+      return sorted;
+    },
+
+    /** All transitive dependencies of `name`, excluding `name` itself. */
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const flat: string[] = [];
+      const visited = new Set<string>([name]);
+      const queue = [...dependencyNames(name, registry)];
+
+      while (queue.length > 0) {
+        const current = queue.shift() as string;
+        if (visited.has(current)) continue;
+        visited.add(current);
+        flat.push(current);
+        queue.push(...dependencyNames(current, registry));
+      }
+
+      return flat;
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return service.detectCycles(name, registry) !== null;
+    },
+  };
+
+  return service;
+}
