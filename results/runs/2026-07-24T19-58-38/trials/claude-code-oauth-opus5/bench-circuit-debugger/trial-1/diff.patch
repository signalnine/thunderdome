+import { describe, expect, it } from 'vitest';
+import type { Gate } from '../src/index.js';
+import { simulate } from '../src/index.js';
+import { addWith, buildAdder, makeRng, pad } from './adder.js';
+
+describe('simulate', () => {
+  it('applies each operation', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'and' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'or' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'xor' },
+    ];
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, and: 0, or: 1, xor: 1 });
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, and: 1, or: 1, xor: 0 });
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, and: 0, or: 0, xor: 0 });
+  });
+
+  it('returns input wires alongside computed ones', () => {
+    const values = simulate([{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }], { a: 1, b: 1 });
+    expect(values).toEqual({ a: 1, b: 1, c: 1 });
+  });
+
+  it('resolves gates given out of dependency order', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'd', in2: 'e', out: 'f' },
+      { op: 'OR', in1: 'c', in2: 'a', out: 'e' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'c' },
+      { op: 'XOR', in1: 'c', in2: 'b', out: 'd' },
+    ];
+    const values = simulate(gates, { a: 1, b: 0 });
+    expect(values.c).toBe(1);
+    expect(values.d).toBe(1);
+    expect(values.e).toBe(1);
+    expect(values.f).toBe(1);
+  });
+
+  it('handles a gate whose two inputs are the same wire', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'a', out: 'b' }];
+    expect(simulate(gates, { a: 1 }).b).toBe(0);
+  });
+
+  it('leaves gates whose inputs never arrive unevaluated', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'missing', out: 'c' }];
+    expect(simulate(gates, { a: 1 })).toEqual({ a: 1 });
+  });
+
+  it('treats any non-zero input as 1', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 5, b: 3 }).c).toBe(1);
+  });
+
+  it('adds correctly through a generated 8-bit adder', () => {
+    const gates = buildAdder(8, makeRng(7));
+    for (let x = 0; x < 256; x += 17) {
+      for (let y = 0; y < 256; y += 13) {
+        expect(addWith(gates, BigInt(x), BigInt(y), 8)).toBe(BigInt(x + y));
+      }
+    }
+  });
+
+  it('propagates a carry across all 45 bits', () => {
+    const n = 45;
+    const gates = buildAdder(n, makeRng(11));
+    const all = (1n << BigInt(n)) - 1n;
+    expect(addWith(gates, all, 1n, n)).toBe(all + 1n);
+    expect(addWith(gates, all, all, n)).toBe(all + all);
+  });
+
+  it('matches the worked 4-bit example from the task description', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+      { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },
+      { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },
+      { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },
+      { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },
+      { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },
+      { op: 'XOR', in1: 'x02', in2: 'y02', out: 't02' },
+      { op: 'XOR', in1: 't02', in2: 'c01', out: 'z02' },
+      { op: 'AND', in1: 'x02', in2: 'y02', out: 'a02' },
+      { op: 'AND', in1: 't02', in2: 'c01', out: 'b02' },
+      { op: 'OR', in1: 'a02', in2: 'b02', out: 'c02' },
+      { op: 'XOR', in1: 'x03', in2: 'y03', out: 't03' },
+      { op: 'XOR', in1: 't03', in2: 'c02', out: 'z03' },
+      { op: 'AND', in1: 'x03', in2: 'y03', out: 'a03' },
+      { op: 'AND', in1: 't03', in2: 'c02', out: 'b03' },
+      { op: 'OR', in1: 'a03', in2: 'b03', out: 'z04' },
+    ];
+    for (let x = 0; x < 16; x++) {
+      for (let y = 0; y < 16; y++) {
+        const inputs: Record<string, number> = {};
+        for (let i = 0; i < 4; i++) {
+          inputs[`x${pad(i)}`] = (x >> i) & 1;
+          inputs[`y${pad(i)}`] = (y >> i) & 1;
+        }
+        const values = simulate(gates, inputs);
+        let z = 0;
+        for (let i = 0; i <= 4; i++) z |= values[`z${pad(i)}`] << i;
+        expect(z).toBe(x + y);
+      }
+    }
+  });
+});
