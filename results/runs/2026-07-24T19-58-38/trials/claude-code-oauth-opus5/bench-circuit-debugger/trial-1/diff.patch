c00', out: 'z01' },\n      { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },\n      { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },\n      { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },\n      { op: 'XOR', in1: 'x02', in2: 'y02', out: 't02' },\n      // z02 and b02 are swapped: the sum bit is driven by an AND.\n      { op: 'XOR', in1: 't02', in2: 'c01', out: 'b02' },\n      { op: 'AND', in1: 'x02', in2: 'y02', out: 'a02' },\n      { op: 'AND', in1: 't02', in2: 'c01', out: 'z02' },\n      { op: 'OR', in1: 'a02', in2: 'b02', out: 'c02' },\n      { op: 'XOR', in1: 'x03', in2: 'y03', out: 't03' },\n      { op: 'XOR', in1: 't03', in2: 'c02', out: 'z03' },\n      { op: 'AND', in1: 'x03', in2: 'y03', out: 'a03' },\n      { op: 'AND', in1: 't03', in2: 'c02', out: 'b03' },\n      { op: 'OR', in1: 'a03', in2: 'b03', out: 'z04' },\n    ];\n    expect(findSwappedWires(gates)).toEqual(['b02', 'z02']);\n  });\n\n  it('finds swaps that both leave the gates looking structurally plausible', () => {\n    // Swapping two sum-bit outputs breaks nothing structurally: both gates are\n    // still XORs driving z wires. Only simulation can catch it.\n    const n = 12;\n    const gates = buildAdder(n, makeRng(5)).map((gate) => ({ ...gate }));\n    const byOutput = new Map(gates.map((gate) => [gate.out, gate]));\n    const swap = (a: string, b: string) => {\n      const first = byOutput.get(a) as Gate;\n      const second = byOutput.get(b) as Gate;\n      [first.out, second.out] = [second.out, first.out];\n    };\n    swap('z03', 'z07');\n    expect(findSwappedWires(gates)).toEqual(['z03', 'z07']);\n  });\n\n  it('recovers four random swaps across a range of widths', () => {\n    for (const n of [4, 6, 8, 16, 24, 45]) {\n      for (let trial = 0; trial < 8; trial++) {\n        const rng = makeRng(n * 1000 + trial + 1);\n        const { gates, swapped } = breakAdder(n, rng);\n        const found = findSwappedWires(gates);\n        expect(found, `n=${n} trial=${trial}`).toEqual(swapped)