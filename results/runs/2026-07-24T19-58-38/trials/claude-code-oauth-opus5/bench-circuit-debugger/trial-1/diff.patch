+++ b/src/trace.ts
@@ -0,0 +1,307 @@
+import type { Gate, GateOp } from './types.js';
+import { isCanonicalAdder, key } from './canonical.js';
+import { wireNamesByIndex } from './wires.js';
+
+/** The pair of gates that consume one stage's carry-in and partial sum. */
+interface StageCore {
+  /** the other wire both gates read */
+  partner: string;
+  sum: Gate;
+  propagated: Gate;
+}
+
+/** Guard against pathological branching on circuits that are not adders. */
+const MAX_STEPS = 50_000;
+
+/**
+ * Rebuild the adder stage by stage, swapping outputs back as mismatches appear.
+ *
+ * Only `out` fields were corrupted, so every gate's *inputs* still name the
+ * wires the original circuit intended: the input wiring is an uncorrupted
+ * skeleton. In it, the true carry out of bit i-1 is read by exactly two gates,
+ * one XOR and one AND, which share their other input — the true partial sum of
+ * bit i. Anchoring on that pair reveals the wire each gate ought to drive, and
+ * any gate driving something else is swapped back.
+ *
+ * Nothing here is simulated, which matters: undoing one swap of an entangled
+ * pair can leave the circuit momentarily cyclic, so a repair cannot in general
+ * be reached one simulate-and-compare step at a time.
+ *
+ * Where the evidence is ambiguous the alternatives are searched, bounded by
+ * `maxSwaps`. A result is accepted only if it reproduces the canonical adder
+ * exactly, which rules out the cascading "repairs" that reach an adder by
+ * rewriting far more wires than were ever broken.
+ *
+ * @returns the wires that had to move, or null if no such repair exists.
+ */
+export function traceRepair(
+  gates: Gate[],
+  n: number,
+  maxSwaps: number,
+  requiredWires: number | null = null,
+  thorough = false,
+): string[] | null {
+  if (n < 1) return null;
+  const working = gates.map((gate) => ({ ...gate }));
+  const names = wireNamesByIndex(working);
+
+  const producer = new Map<string, Gate>();
+  const consumers = new Map<string, Gate[]>();
+  const byInputs = new Map<string, Gate>();
+  for (const gate of working) {
+    producer.set(gate.out, gate);
+    for (const wire of [gate.in1, gate.in2]) {
+      const list = consumers.get(wire);
+      if (list) list.push(gate);
+      else consumers.set(wire, [gate]);
+    }
+    const id = key(gate.op, gate.in1, gate.in2);
+    if (!byInputs.has(id)) byInputs.set(id, gate);
+  }
+
+  const trail: Array<[string, string]> = [];
+  const exchange = (a: string, b: string) => {
+    const gateA = producer.get(a) as Gate;
+    const gateB = producer.get(b) as Gate;
+    gateA.out = b;
+    gateB.out = a;
+    producer.set(a, gateB);
+    producer.set(b, gateA);
+  };
+  /** Make the gate currently driving `from` drive `to` instead. */
+  const align = (from: string, to: string): boolean => {
+    if (from === to) return true;
+    if (trail.length >= maxSwaps) return false;
+    const gateA = producer.get(from);
+    const gateB = producer.get(to);
+    if (!gateA || !gateB || gateA === gateB) return false;
+    exchange(from, to);
+    trail.push([from, to]);
+    return true;
+  };
+  const rollbackTo = (mark: number) => {
+    while (trail.length > mark) {
+      const [a, b] = trail.pop() as [string, string];
+      exchange(a, b);
+    }
+  };
+
+  const otherInput = (gate: Gate, wire: string): string | null =>
+    gate.in1 === wire ? gate.in2 : gate.in2 === wire ? gate.in1 : null;
+
+  /**
+   * The stage fed by `wire`: one XOR and one AND consuming it and agreeing on
+   * their other input. Depends only on input wiring, so swaps never change it.
+   */
+  const stageFedBy = (wire: string): StageCore | null => {
+    const fed = consumers.get(wire);
+    if (!fed || fed.length !== 2) return null;
+    const sum = fed.find((gate) => gate.op === 'XOR');
+    const propagated = fed.find((gate) => gate.op === 'AND');
+    if (!sum || !propagated) return null;
+    const viaSum = otherInput(sum, wire);
+    const viaAnd = otherInput(propagated, wire);
+    if (viaSum === null || viaSum !== viaAnd || viaSum === wire) return null;
+    return { partner: viaSum, sum, propagated };
+  };
+
+  const gateFor = (op: GateOp, a: string | undefined, b: string | undefined) =>
+    a === undefined || b === undefined ? undefined : byInputs.get(key(op, a, b));
+
+  // Index the stages by the gates that make them up, so a stage can also be
+  // recognised from one of its gates rather than from a wire name.
+  const stageOfGate = new Map<Gate, StageCore>();
+  const stageInputs: string[] = [];
+  for (const wire of consumers.keys()) {
+    const core = stageFedBy(wire);
+    if (core) {
+      stageInputs.push(wire);
+      stageOfGate.set(core.sum, core);
+      stageOfGate.set(core.propagated, core);
+    }
+  }
+  // Only consulted in a thorough pass, when the targeted evidence runs out.
+  const everyStageInput = thorough ? stageInputs : [];
+  const everyOrGate = thorough ? working.filter((gate) => gate.op === 'OR') : [];
+
+  const movedWires = (): string[] => {
+    const moved: string[] = [];
+    for (let i = 0; i < working.length; i++) {
+      if (working[i].out !== gates[i].out) moved.push(gates[i].out);
+    }
+    return moved.sort();
+  };
+
+  /**
+   * The wire this stage's carry should come out on, read from the stage above:
+   * the next stage's partial sum shares its two gates with the carry coming in.
+   */
+  const carryOutName = (bit: number): string | undefined => {
+    if (bit + 1 >= n) return names.z.get(n);
+    const nextPartial = gateFor('XOR', names.x.get(bit + 1), names.y.get(bit + 1));
+    return nextPartial ? (stageFedBy(nextPartial.out)?.partner ?? undefined) : undefined;
+  };
+
+  let steps = 0;
+  let repaired: string[] | null = null;
+
+  /** Finish the carry chain: the last carry out is the top output bit. */
+  const finish = (carry: string): boolean => {
+    const top = names.z.get(n);
+    if (top === undefined) return false;
+    const mark = trail.length;
+    if (align(carry, top) && isCanonicalAdder(working, n)) {
+      const moved = movedWires();
+      if (requiredWires === null || moved.length === requiredWires) {
+        repaired = moved;
+        return true;
+      }
+    }
+    rollbackTo(mark);
+    return false;
+  };
+
+  const solve = (bit: number, carry: string): boolean => {
+    if (++steps > MAX_STEPS) return false;
+    if (bit === n) return finish(carry);
+
+    const zBit = names.z.get(bit);
+    const partialGate = gateFor('XOR', names.x.get(bit), names.y.get(bit));
+    const generatedGate = gateFor('AND', names.x.get(bit), names.y.get(bit));
+    if (!partialGate || !generatedGate || zBit === undefined) return false;
+
+    // Wires that could be this stage's carry-in, strongest evidence first. Each
+    // one implies the whole stage, since the two gates reading it are the
+    // stage's sum and propagate gates and their other input is its partial sum.
+    const candidates: string[] = [carry];
+
+    // The partial sum is in place, so its stage names the carry-in.
+    const fromPartial = stageFedBy(partialGate.out);
+    if (fromPartial) candidates.push(fromPartial.partner);
+
+    // Whatever drives this sum bit is probably this stage's sum gate.
+    const zDriver = producer.get(zBit);
+    const zStage = zDriver && stageOfGate.get(zDriver);
+    if (zStage) candidates.push(zStage.partner, otherInput(zStage.sum, zStage.partner) ?? '');
+
+    // Look ahead: the stage above names this stage's carry out, and the gates
+    // feeding the OR that produces it belong to this stage.
+    const above = carryOutName(bit);
+    const carryGate = above === undefined ? undefined : producer.get(above);
+    if (carryGate && carryGate.op === 'OR') {
+      for (const wire of [carryGate.in1, carryGate.in2]) {
+        const stage = stageOfGate.get(producer.get(wire) as Gate);
+        if (stage) {
+          candidates.push(stage.partner, otherInput(stage.sum, stage.partner) ?? '');
+        }
+      }
+    }
+
+    const seen = new Set<string>();
+    for (const carryWire of [...candidates, ...everyStageInput]) {
+      if (!carryWire || seen.has(carryWire)) continue;
+      seen.add(carryWire);
+      const core = stageFedBy(carryWire);
+      if (!core) continue;
+      const mark = trail.length;
+      if (
+        align(carry, carryWire) &&
+        align(partialGate.out, core.partner) &&
+        completeStage(bit, core, zBit, generatedGate)
+      ) {
+        return true;
+      }
+      rollbackTo(mark);
+    }
+    return false;
+  };
+
+  /** Route this stage's sum to z and its carries into the next stage. */
+  const completeStage = (
+    bit: number,
+    core: StageCore,
+    zBit: string,
+    generatedGate: Gate,
+  ): boolean => {
+    const mark = trail.length;
+    if (align(core.sum.out, zBit)) {
+      const propagated = core.propagated.out;
+      const generated = generatedGate.out;
+      const carryGates: Array<() => Gate | null> = [];
+      const direct = gateFor('OR', generated, propagated);
+      if (direct) {
+        carryGates.push(() => direct);
+      } else {
+        // Exactly one of the two carry terms is misnamed; the OR gate reading
+        // the other one names its true partner.
+        const viaPropagated = (consumers.get(propagated) ?? []).find((gate) => gate.op === 'OR');
+        if (viaPropagated) {
+          carryGates.push(() => {
+            const partner = otherInput(viaPropagated, propagated);
+            return partner !== null && align(generated, partner) ? viaPropagated : null;
+          });
+        }
+        const viaGenerated = (consumers.get(generated) ?? []).find((gate) => gate.op === 'OR');
+        if (viaGenerated) {
+          carryGates.push(() => {
+            const partner = otherInput(viaGenerated, generated);
+            return partner !== null && align(propagated, partner) ? viaGenerated : null;
+          });
+        }
+        // Both carry terms moved, so neither names the OR that should combine
+        // them. Look ahead instead: the next stage's core names this stage's
+        // carry out, and whichever gate drives that is the OR in question.
+        const ahead = carryOutName(bit);
+        const candidates = ahead === undefined ? [] : [producer.get(ahead)];
+        for (const candidate of [...candidates, ...everyOrGate]) {
+          if (!candidate || candidate.op !== 'OR') continue;
+          for (const [first, second] of [
+            [candidate.in1, candidate.in2],
+            [candidate.in2, candidate.in1],
+          ]) {
+            carryGates.push(() =>
+              align(generated, first) && align(propagated, second) ? candidate : null,
+            );
+          }
+        }
+      }
+
+      for (const carryGate of carryGates) {
+        const carryMark = trail.length;
+        const resolved = carryGate();
+        if (resolved && solve(bit + 1, resolved.out)) return true;
+        rollbackTo(carryMark);
+      }
+    }
+    rollbackTo(mark);
+    return false;
+  };
+
+  // Bit 0 is a half adder: its XOR is z00 and its AND starts the carry chain.
+  const sum0 = gateFor('XOR', names.x.get(0), names.y.get(0));
+  const carryGate0 = gateFor('AND', names.x.get(0), names.y.get(0));
+  const z0 = names.z.get(0);
+  if (!sum0 || !carryGate0 || z0 === undefined || !align(sum0.out, z0)) return null;
+
+  solve(1, carryGate0.out);
+  return repaired;
+}
+
+/**
+ * Find the smallest set of output swaps that turns these gates back into an
+ * adder, trying one swap, then two, and so on.
+ *
+ * Searching smallest-first matters: once a repair is found, extra swaps that
+ * happen to be invisible (exchanging the two inputs of an OR, for instance)
+ * could pad it out to any larger size, so only the minimal repair is
+ * well defined.
+ */
+export function minimalRepair(gates: Gate[], n: number, maxSwaps: number): string[] | null {
+  for (const thorough of [false, true]) {
+    for (let budget = 1; budget <= maxSwaps; budget++) {
+      const repaired = traceRepair(gates, n, budget, null, thorough);
+      if (repaired) return repaired;
+    }
+  }
+  return null;
+}
