string];\n      exchange(a, b);\n    }\n  };\n\n  const otherInput = (gate: Gate, wire: string): string | null =>\n    gate.in1 === wire ? gate.in2 : gate.in2 === wire ? gate.in1 : null;\n\n  /**\n   * The stage fed by `wire`: one XOR and one AND consuming it and agreeing on\n   * their other input. Depends only on input wiring, so swaps never change it.\n   */\n  const stageFedBy = (wire: string): StageCore | null => {\n    const fed = consumers.get(wire);\n    if (!fed || fed.length !== 2) return null;\n    const sum = fed.find((gate) => gate.op === 'XOR');\n    const propagated = fed.find((gate) => gate.op === 'AND');\n    if (!sum || !propagated) return null;\n    const viaSum = otherInput(sum, wire);\n    const viaAnd = otherInput(propagated, wire);\n    if (viaSum === null || viaSum !== viaAnd || viaSum === wire) return null;\n    return { partner: viaSum, sum, propagated };\n  };\n\n  const gateFor = (op: GateOp, a: string | undefined, b: string | undefined) =>\n    a === undefined || b === undefined ? undefined : byInputs.get(key(op, a, b));\n\n  // Index the stages by the gates that make them up, so a stage can also be\n  // recognised from one of its gates rather than from a wire name.\n  const stageOfGate = new Map<Gate, StageCore>();\n  for (const wire of consumers.keys()) {\n    const core = stageFedBy(wire);\n    if (core) {\n      stageOfGate.set(core.sum, core);\n      stageOfGate.set(core.propagated, core);\n    }\n  }\n\n  const movedWires = (): string[] => {\n    const moved: string[] = [];\n    for (let i = 0; i < working.length; i++) {\n      if (working[i].out !== gates[i].out) moved.push(gates[i].out);\n    }\n    return moved.sort();\n  };\n\n  /**\n   * The wire this stage's carry should come out on, read from the stage above:\n   * the next stage's partial sum shares its two gates with the carry coming in.\n   */\n  const carryOutName = (bit: number): string | undefined => {\n    if (bit + 1 >= n) return names.z.get(n);\n    const nextParti