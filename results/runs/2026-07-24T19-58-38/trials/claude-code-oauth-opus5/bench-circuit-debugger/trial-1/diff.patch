+/** The three logic operations a gate can perform. */
+export type GateOp = 'AND' | 'OR' | 'XOR';
+
+/** A single two-input logic gate driving one output wire. */
+export interface Gate {
+  op: GateOp;
+  /** input wire name */
+  in1: string;
+  /** input wire name */
+  in2: string;
+  /** output wire name */
+  out: string;
+}
