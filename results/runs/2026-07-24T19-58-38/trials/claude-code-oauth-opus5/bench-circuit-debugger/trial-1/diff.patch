+import { describe, expect, it } from 'vitest';
+import type { Gate } from '../src/index.js';
+import { findSwappedWires } from '../src/index.js';
+import { isCanonicalAdder } from '../src/canonical.js';
+import { structuralSuspects } from '../src/structure.js';
+import { buildAdder, makeRng, pad, stageOf } from './adder.js';
+
+describe('isCanonicalAdder', () => {
+  it('accepts a correct adder and rejects a corrupted one', () => {
+    for (const n of [1, 2, 4, 12, 45]) {
+      const gates = buildAdder(n, makeRng(n + 3));
+      expect(isCanonicalAdder(gates, n), `n=${n}`).toBe(true);
+
+      const broken = gates.map((gate) => ({ ...gate }));
+      const [first, second] =
+        n === 1 ? broken : [stageOf(broken, n - 1).sum, stageOf(broken, n - 1).propagated];
+      [first.out, second.out] = [second.out, first.out];
+      expect(isCanonicalAdder(broken, n), `n=${n} broken`).toBe(false);
+    }
+  });
+
+  it('rejects an adder missing its final carry bit', () => {
+    const gates = buildAdder(6, makeRng(9)).filter((gate) => gate.op !== 'OR');
+    expect(isCanonicalAdder(gates, 6)).toBe(false);
+  });
+});
+
+describe('structuralSuspects', () => {
+  it('flags gates sitting where an adder has no such role', () => {
+    const n = 16;
+    const gates = buildAdder(n, makeRng(21)).map((gate) => ({ ...gate }));
+    const swap = (first: Gate, second: Gate) => {
+      [first.out, second.out] = [second.out, first.out];
+    };
+    // Each of these leaves a gate in a position the adder pattern forbids: an
+    // AND driving a sum bit, and a bare x/y XOR driving one.
+    const four = stageOf(gates, 4);
+    const nine = stageOf(gates, 9);
+    swap(four.sum, four.propagated);
+    swap(nine.sum, nine.partial);
+    const expected = [four.sum.out, four.propagated.out, nine.sum.out, nine.partial.out].sort();
+
+    expect(structuralSuspects(gates)).toEqual(expected);
+  });
+
+  it('reports nothing for an intact adder', () => {
+    expect(structuralSuspects(buildAdder(12, makeRng(4)))).toEqual([]);
+  });
+});
+
+describe('findSwappedWires on circuits that are not adders', () => {
+  // Nothing can be proven about these, but they must degrade to a best guess
+  // rather than throw or hang.
+  const oddities: Array<[string, Gate[]]> = [
+    [
+      'a circuit that does not add',
+      [
+        { op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' },
+        { op: 'OR', in1: 'x00', in2: 'y00', out: 'z01' },
+      ],
+    ],
+    ['no recognisable registers', [{ op: 'XOR', in1: 'foo', in2: 'bar', out: 'baz' }]],
+    ['no gates at all', []],
+  ];
+  for (const [what, gates] of oddities) {
+    it(`survives ${what}`, () => {
+      const found = findSwappedWires(gates);
+      expect(Array.isArray(found)).toBe(true);
+      expect([...found].sort()).toEqual(found);
+    });
+  }
+});
+
+describe('a one-bit adder', () => {
+  it('is solved like any other width', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: `z${pad(1)}` },
+    ];
+    expect(findSwappedWires(gates)).toEqual(['z00', 'z01']);
+  });
+});
diff --git a/tests/find-swapped.test.ts b/tests/find-swapped.test.ts
new file mode 100644
index 0000000..e22f65f
--- /dev/null
+++ b/tests/find-swapped.test.ts
@@ -0,0 +1,158 @@
+import { describe, expect, it } from 'vitest';
+import type { Gate } from '../src/index.js';
+import { findSwappedWires } from '../src/index.js';
+import { breakAdder, buildAdder, isCorrectAdder, makeRng, pad, stageOf } from './adder.js';
+
+/** Apply the reported swaps and confirm the circuit becomes a correct adder. */
+function repairs(gates: Gate[], wires: string[], n: number): boolean {
+  const copy = gates.map((gate) => ({ ...gate }));
+  const byOutput = new Map(copy.map((gate) => [gate.out, gate]));
+  const rng = makeRng(99);
+  const pool = [...wires];
+  const attempt = (remaining: string[]): boolean => {
+    if (remaining.length === 0) return isCorrectAdder(copy, n, rng);
+    const [head, ...rest] = remaining;
+    for (let i = 0; i < rest.length; i++) {
+      const first = byOutput.get(head) as Gate;
+      const second = byOutput.get(rest[i]) as Gate;
+      [first.out, second.out] = [second.out, first.out];
+      byOutput.set(first.out, first);
+      byOutput.set(second.out, second);
+      if (attempt(rest.filter((_, j) => j !== i))) return true;
+      [first.out, second.out] = [second.out, first.out];
+      byOutput.set(first.out, first);
+      byOutput.set(second.out, second);
+    }
+    return false;
+  };
+  return attempt(pool);
+}
+
+describe('findSwappedWires', () => {
+  it('finds swaps of each kind of wire in a stage', () => {
+    const n = 12;
+    const gates = buildAdder(n, makeRng(5)).map((gate) => ({ ...gate }));
+    const swap = (first: Gate, second: Gate) => {
+      [first.out, second.out] = [second.out, first.out];
+    };
+    // One of each: sum bit against propagated carry, partial sum against
+    // generated carry, sum bit against carry out, and two sum bits.
+    const [two, five, eight] = [2, 5, 8].map((bit) => stageOf(gates, bit));
+    const expected = [
+      two.sum.out,
+      two.propagated.out,
+      five.partial.out,
+      five.generated.out,
+      eight.sum.out,
+      eight.carryOut.out,
+      `z${pad(1)}`,
+      `z${pad(10)}`,
+    ].sort();
+    swap(two.sum, two.propagated);
+    swap(five.partial, five.generated);
+    swap(eight.sum, eight.carryOut);
+    swap(stageOf(gates, 1).sum, stageOf(gates, 10).sum);
+
+    expect(findSwappedWires(gates)).toEqual(expected);
+  });
+
+  it('finds swaps that leave every gate looking structurally plausible', () => {
+    // Exchanging two sum-bit outputs breaks no structural rule: both gates are
+    // still XORs driving z wires, so nothing looks out of place locally.
+    const n = 16;
+    const gates = buildAdder(n, makeRng(5)).map((gate) => ({ ...gate }));
+    const byOutput = new Map(gates.map((gate) => [gate.out, gate]));
+    const swap = (a: string, b: string) => {
+      const first = byOutput.get(a) as Gate;
+      const second = byOutput.get(b) as Gate;
+      [first.out, second.out] = [second.out, first.out];
+    };
+    const pairs: Array<[number, number]> = [
+      [3, 7],
+      [2, 11],
+      [5, 13],
+      [6, 9],
+    ];
+    for (const [a, b] of pairs) swap(`z${pad(a)}`, `z${pad(b)}`);
+    const expected = pairs.flat().map((bit) => `z${pad(bit)}`).sort();
+
+    expect(findSwappedWires(gates)).toEqual(expected);
+  });
+
+  it('recovers four random swaps across a range of widths', () => {
+    for (const n of [4, 6, 8, 16, 24, 45]) {
+      for (let trial = 0; trial < 8; trial++) {
+        const rng = makeRng(n * 1000 + trial + 1);
+        const { gates, swapped } = breakAdder(n, rng);
+        const found = findSwappedWires(gates);
+        expect(found, `n=${n} trial=${trial}`).toEqual(swapped);
+        expect(repairs(gates, found, n), `n=${n} trial=${trial} repairs`).toBe(true);
+      }
+    }
+  });
+
+  it('returns wires sorted with no duplicates', () => {
+    const { gates } = breakAdder(20, makeRng(4242));
+    const found = findSwappedWires(gates);
+    expect(found).toHaveLength(8);
+    expect(new Set(found).size).toBe(8);
+    expect([...found].sort()).toEqual(found);
+  });
+
+  it('solves a 45-bit circuit well under the time limit', () => {
+    const { gates, swapped } = breakAdder(45, makeRng(2024));
+    expect(gates.length).toBeGreaterThan(200);
+    const started = performance.now();
+    const found = findSwappedWires(gates);
+    const elapsed = performance.now() - started;
+    expect(found).toEqual(swapped);
+    expect(elapsed).toBeLessThan(5000);
+  });
+
+  it('ignores the order gates are listed in', () => {
+    const rng = makeRng(31337);
+    const { gates, swapped } = breakAdder(16, rng);
+    const shuffled = [...gates];
+    for (let i = shuffled.length - 1; i > 0; i--) {
+      const j = Math.floor(rng() * (i + 1));
+      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
+    }
+    expect(findSwappedWires(shuffled)).toEqual(swapped);
+  });
+
+  it('does not mutate the gates it is given', () => {
+    const { gates } = breakAdder(12, makeRng(808));
+    const before = JSON.stringify(gates);
+    findSwappedWires(gates);
+    expect(JSON.stringify(gates)).toBe(before);
+  });
+
+  it('handles two swaps inside one bit, where no single swap makes progress', () => {
+    const n = 12;
+    const gates = buildAdder(n, makeRng(77)).map((gate) => ({ ...gate }));
+    const byOutput = new Map(gates.map((gate) => [gate.out, gate]));
+    const swap = (first: Gate, second: Gate) => {
+      [first.out, second.out] = [second.out, first.out];
+    };
+
+    // Both swaps sit inside bit 4, so repairing either one alone leaves bit 4
+    // wrong: no method that fixes one swap at a time can make progress here.
+    const bit4 = stageOf(gates, 4);
+    const expected = [
+      bit4.partial.out,
+      bit4.generated.out,
+      bit4.sum.out,
+      bit4.propagated.out,
+      `z${pad(1)}`,
+      `z${pad(9)}`,
+      `z${pad(8)}`,
+      `z${pad(10)}`,
+    ].sort();
+    swap(bit4.partial, bit4.generated);
+    swap(bit4.sum, bit4.propagated);
+    swap(byOutput.get(`z${pad(1)}`) as Gate, byOutput.get(`z${pad(9)}`) as Gate);
+    swap(byOutput.get(`z${pad(8)}`) as Gate, byOutput.get(`z${pad(10)}`) as Gate);
+
+    expect(findSwappedWires(gates)).toEqual(expected);
+  });
+});
