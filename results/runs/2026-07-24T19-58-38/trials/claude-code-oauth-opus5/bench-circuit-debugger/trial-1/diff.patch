+import type { Gate } from './types.js';
+
+/**
+ * Evaluate a combinational circuit.
+ *
+ * Gates fire as soon as both of their input wires hold a value, so the caller
+ * does not need to supply them in dependency order. Gates whose inputs never
+ * become available simply never fire and contribute no wire to the result.
+ *
+ * @param gates the gates making up the circuit (assumed acyclic)
+ * @param inputs initial wire values; any non-zero value counts as 1
+ * @returns every wire that ended up with a value, including the given inputs
+ */
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values = new Map<string, number>();
+  for (const wire of Object.keys(inputs)) {
+    values.set(wire, inputs[wire] ? 1 : 0);
+  }
+
+  // For each not-yet-known wire, the gates that are blocked waiting on it.
+  const blocked = new Map<string, number[]>();
+  const missing = new Int32Array(gates.length);
+  const ready: number[] = [];
+
+  for (let i = 0; i < gates.length; i++) {
+    const gate = gates[i];
+    let need = 0;
+    for (const wire of [gate.in1, gate.in2]) {
+      if (!values.has(wire)) {
+        need++;
+        const waiters = blocked.get(wire);
+        if (waiters) waiters.push(i);
+        else blocked.set(wire, [i]);
+      }
+    }
+    missing[i] = need;
+    if (need === 0) ready.push(i);
+  }
+
+  while (ready.length > 0) {
+    const index = ready.pop() as number;
+    const gate = gates[index];
+    const a = values.get(gate.in1) ?? 0;
+    const b = values.get(gate.in2) ?? 0;
+    values.set(gate.out, gate.op === 'AND' ? a & b : gate.op === 'OR' ? a | b : a ^ b);
+
+    const waiters = blocked.get(gate.out);
+    if (waiters) {
+      blocked.delete(gate.out);
+      for (const waiter of waiters) {
+        if (--missing[waiter] === 0) ready.push(waiter);
+      }
+    }
+  }
+
+  return Object.fromEntries(values);
+}
