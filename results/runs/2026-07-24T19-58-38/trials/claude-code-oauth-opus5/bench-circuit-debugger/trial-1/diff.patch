ir } from './trace.js';\nimport { buildTestSuite } from './vectors.js';\n\n/** Number of swapped pairs the circuits are known to contain. */\nconst SWAP_COUNT = 4;\n/** Safety valve so a pathological circuit cannot run unbounded. */\nconst MAX_EVALUATIONS = 200_000;\n/** How many \"no progress yet\" swaps to explore when no single swap helps. */\nconst ESCAPE_BRANCHES = 24;\n\ninterface Candidate {\n  a: number;\n  b: number;\n  /** lowest wrong output bit after applying this swap */\n  bad: number;\n}\n\n/**\n * Identify the eight wires involved in the four output swaps that stop these\n * gates from computing X + Y.\n *\n * Two independent methods back each other up:\n *\n *  1. Structural rules flag gates that sit in an impossible position for a\n *     ripple-carry adder. When they name exactly eight wires we confirm the\n *     answer by pairing them back into a textbook adder, so the answer is\n *     proven rather than merely plausible.\n *  2. Otherwise a guided search repairs the circuit one swap at a time,\n *     driven by the lowest output bit that is still wrong. Only wires feeding\n *     that bit can possibly fix it, which keeps the branching factor small\n *     enough to avoid any combinatorial blow-up.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  const n = inputBitCount(gates);\n\n  // Rebuilding the adder from its (uncorrupted) input wiring settles almost\n  // every circuit outright, and its result is verified against the canonical\n  // adder shape before being accepted.\n  const traced = minimalRepair(gates, n, SWAP_COUNT);\n  if (traced && traced.length === SWAP_COUNT * 2) return traced;\n\n  const evaluator = new CircuitEval(gates, buildTestSuite(n));\n  const suspects = structuralSuspects(gates);\n\n  // Nothing to trace if the circuit already adds correctly (a swap can cancel\n  // out, e.g. between the two inputs of one OR); use the structural reading.\n  if (evaluator.evaluate() > n) return suspects;\n\n  if (suspects.length === SWAP_COUNT * 2) {\n    const ids = suspects.map((wire) => evaluator.wireIdOf(wire));\n    if (ids.every((id) => id >= 0) && hasRepairingPairing(evaluator, ids, n)) return suspects;\n  }\n\n  return repairSearch(evaluator, n, suspects) ?? traced ?? suspects;\n}\n\n/** Does some perfect pairing of these wires restore a textbook adder? */\nfunction hasRepairingPairing(evaluator: CircuitEval, ids: number[], n: number): boolean {\n  const recurse = (pool: number[]): boolean => {\n    if (pool.length === 0) {\n      return evaluator.evaluate() > n && isCanonicalAdder(evaluator.currentGates(), n);\n    }\n    const [head, ...rest] = pool;\n    for (let i = 0; i < rest.length; i++) {\n      const partner = rest[i];\n      evaluator.swap(head, partner);\n      const found = recurse(rest.filter((_, j) => j !== i));\n      evaluator.swap(head, partner);\n      if (found) return true;\n    }\n    return false;\n  };\n  return recurse(ids);\n}\n\n/**\n * Repair the circuit by searching for four disjoint swaps, depth first.\n *\n * The search is ordered by the lowest wrong output bit: fixing it requires\n * re-driving a wire that feeds it, so candidates are drawn from that bit's\n * fan-in cone, tightest first.\n */\nfunction repairSearch(evaluator: CircuitEval, n: number, suspectNames: string[]): string[] | null {\n  const suspects = new Set(\n    suspectNames.map((wire) => evaluator.wireIdOf(wire)).filter((id) => id >= 0),\n  );\n  const used = new Set<number>();\n  const chosen: Array<[number, number]> = [];\n  let evaluations = 0;\n  // Weaker results, kept in preference order in case nothing better turns up:\n  // a proven adder reached in fewer than four swaps, then repairs that only\n  // agree with X+Y on the sampled inputs.\n  let provenShort: string[] | null = null;\n  let sampledFull: string[] | null = null;\n  let sampledShort: string[] | null = null;\n\n  const names = (pairs: Array<[number, number]>) =>\n    pairs.flat().map((id) => evaluator.wireName(id)).sort();\n\n  /** Prefer pairs the structural rules already distrust. */\n  const suspicion = (candidate: Candidate) =>\n    (suspects.has(candidate.a) ? 1 : 0) + (suspects.has(candidate.b) ? 1 : 0);\n\n  const collect = (bad: number, sources: number[], mustImprove: boolean): Candidate[] => {\n    const found: Candidate[] = [];\n    for (const a of sources) {\n      if (used.has(a)) continue;\n      for (const b of evaluator.drivenWires) {\n        if (b === a || used.has(b)) continue;\n        evaluator.swap(a, b);\n        const result = evaluator.evaluate();\n        evaluator.swap(a, b);\n        evaluations++;\n        if (result < 0) continue; // the swap introduced a cycle\n        if (mustImprove ? result > bad : result >= bad) found.push({ a, b, bad: result });\n      }\n      if (evaluations > MAX_EVALUATIONS) break;\n    }\n    found.sort((p, q) => q.bad - p.bad || suspicion(q) - suspicion(p));\n    return found;\n  };\n\n  const search = (depth: number): boolean => {\n    if (evaluations > MAX_EVALUATIONS) return false;\n    const bad = evaluator.evaluate();\n    if (bad < 0) return false;\n    if (bad > n) {\n      // Adding correctly on the sampled inputs is only a hint; matching the\n      // adder's structure exactly is proof. Accept nothing less than a proven\n      // repair using all four swaps, and keep the rest as fallbacks.\n      const proven = isCanonicalAdder(evaluator.currentGates(), n);\n      if (depth === SWAP_COUNT) {\n        if (proven) return true;\n        sampledFull ??= names(chosen);\n      } else if (proven) {\n        provenShort ??= names(chosen);\n      } else {\n        sampledShort ??= names(chosen);\n      }\n      return false;\n    }\n    if (depth === SWAP_COUNT) return false;\n\n    // Tiers widen only when the tighter, cheaper ones are exhausted.\n    const tiers: Array<() => Candidate[]> = [\n      () => collect(bad, evaluator.exclusiveConeOf(bad), true),\n      () => collect(bad, evaluator.coneOf(bad), true),\n      () =>\n        collect(bad, evaluator.exclusiveConeOf(bad).concat(evaluator.exclusiveConeOf(bad + 1)), false)\n          .slice(0, ESCAPE_BRANCHES),\n    ];\n\n    const tried = new Set<number>();\n    for (const tier of tiers) {\n      for (const candidate of tier()) {\n        const key = candidate.a * evaluator.numWires + candidate.b;\n        const mirror = candidate.b * evaluator.numWires + candidate.a;\n        if (tried.has(key) || tried.has(mirror)) continue;\n        tried.add(key);\n\n        evaluator.swap(candidate.a, candidate.b);\n        used.add(candidate.a);\n        used.add(candidate.b);\n        chosen.push([candidate.a, candidate.b]);\n\n        if (search(depth + 1)) return true;\n\n        chosen.pop();\n        used.delete(candidate.a);\n        used.delete(candidate.b);\n        evaluator.swap(candidate.a, candidate.b);\n        if (evaluations > MAX_EVALUATIONS) return false;\n      }\n    }\n    return false;\n  };\n\n  const solved = search(0);\n  const answer = solved ? names(chosen) : (provenShort ?? sampledFull ?? sampledShort);\n  for (let i = chosen.length - 1; i >= 0; i--) evaluator.swap(chosen[i][0], chosen[i][1]);\n  return answer;\n}\n","userModified":false}}
