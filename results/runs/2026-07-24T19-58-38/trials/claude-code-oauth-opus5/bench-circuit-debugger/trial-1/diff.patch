--- /dev/null
+++ b/src/wires.ts
@@ -0,0 +1,47 @@
+import type { Gate } from './types.js';
+
+/** The X register's input bits, least significant first. */
+export const X_WIRE = /^x(\d+)$/;
+/** The Y register's input bits. */
+export const Y_WIRE = /^y(\d+)$/;
+/** The Z register's output bits, one wider than the inputs. */
+export const Z_WIRE = /^z(\d+)$/;
+
+/** Highest x index in the circuit, plus one: the adder's input width. */
+export function inputBitCount(gates: Gate[]): number {
+  let max = -1;
+  for (const gate of gates) {
+    for (const wire of [gate.in1, gate.in2]) {
+      const match = X_WIRE.exec(wire);
+      if (match) max = Math.max(max, Number(match[1]));
+    }
+  }
+  return max + 1;
+}
+
+/** Map bit index to wire name for each register, honouring the circuit's padding. */
+export function wireNamesByIndex(gates: Gate[]): {
+  x: Map<number, string>;
+  y: Map<number, string>;
+  z: Map<number, string>;
+} {
+  const result = {
+    x: new Map<number, string>(),
+    y: new Map<number, string>(),
+    z: new Map<number, string>(),
+  };
+  const record = (wire: string) => {
+    const x = X_WIRE.exec(wire);
+    if (x) return void result.x.set(Number(x[1]), wire);
+    const y = Y_WIRE.exec(wire);
+    if (y) return void result.y.set(Number(y[1]), wire);
+    const z = Z_WIRE.exec(wire);
+    if (z) return void result.z.set(Number(z[1]), wire);
+  };
+  for (const gate of gates) {
+    record(gate.in1);
+    record(gate.in2);
+    record(gate.out);
+  }
+  return result;
+}
diff --git a/tests/adder.ts b/tests/adder.ts
new file mode 100644
index 0000000..09a55d7
--- /dev/null
+++ b/tests/adder.ts
@@ -0,0 +1,193 @@
+import type { Gate } from '../src/types.js';
+import { simulate } from '../src/simulate.js';
+
+export function pad(bit: number): string {
+  return bit < 10 ? `0${bit}` : String(bit);
+}
+
+/** Small deterministic PRNG so failures are reproducible. */
+export function makeRng(seed: number): () => number {
+  let state = seed >>> 0 || 1;
+  return () => {
+    state ^= state << 13;
+    state ^= state >>> 17;
+    state ^= state << 5;
+    return (state >>> 0) / 0x100000000;
+  };
+}
+
+/** Build a correct n-bit ripple-carry adder with random internal wire names. */
+export function buildAdder(n: number, rng: () => number): Gate[] {
+  const taken = new Set<string>();
+  const letters = 'abcdefghijklmnopqrstuvw';
+  const name = (): string => {
+    for (;;) {
+      let candidate = '';
+      for (let i = 0; i < 3; i++) candidate += letters[Math.floor(rng() * letters.length)];
+      if (!taken.has(candidate)) {
+        taken.add(candidate);
+        return candidate;
+      }
+    }
+  };
+
+  const gates: Gate[] = [];
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  // With a single input bit the carry out of bit 0 is already the top output.
+  let carry = n === 1 ? `z${pad(1)}` : name();
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: carry });
+
+  for (let i = 1; i < n; i++) {
+    const partial = name();
+    const generated = name();
+    const propagated = name();
+    const carryOut = i === n - 1 ? `z${pad(n)}` : name();
+    gates.push({ op: 'XOR', in1: `x${pad(i)}`, in2: `y${pad(i)}`, out: partial });
+    gates.push({ op: 'AND', in1: `x${pad(i)}`, in2: `y${pad(i)}`, out: generated });
+    gates.push({ op: 'XOR', in1: partial, in2: carry, out: `z${pad(i)}` });
+    gates.push({ op: 'AND', in1: partial, in2: carry, out: propagated });
+    gates.push({ op: 'OR', in1: generated, in2: propagated, out: carryOut });
+    carry = carryOut;
+  }
+
+  // Gate order carries no meaning; shuffle so nothing can depend on it.
+  for (let i = gates.length - 1; i > 0; i--) {
+    const j = Math.floor(rng() * (i + 1));
+    [gates[i], gates[j]] = [gates[j], gates[i]];
+  }
+  return gates;
+}
+
+/** The five gates making up one bit's full-adder stage (bit >= 1). */
+export interface Stage {
+  partial: Gate;
+  generated: Gate;
+  sum: Gate;
+  propagated: Gate;
+  carryOut: Gate;
+}
+
+/** Locate a stage's gates in a correct adder, by structure rather than name. */
+export function stageOf(gates: Gate[], bit: number): Stage {
+  const reads = (gate: Gate, wire: string) => gate.in1 === wire || gate.in2 === wire;
+  const find = (predicate: (gate: Gate) => boolean, what: string): Gate => {
+    const gate = gates.find(predicate);
+    if (!gate) throw new Error(`no ${what} gate for bit ${bit}`);
+    return gate;
+  };
+  const x = `x${pad(bit)}`;
+  const partial = find((g) => g.op === 'XOR' && reads(g, x), 'partial');
+  const generated = find((g) => g.op === 'AND' && reads(g, x), 'generated');
+  const sum = find((g) => g.op === 'XOR' && reads(g, partial.out), 'sum');
+  const propagated = find((g) => g.op === 'AND' && reads(g, partial.out), 'propagate');
+  const carryOut = find((g) => g.op === 'OR' && reads(g, generated.out), 'carry-out');
+  return { partial, generated, sum, propagated, carryOut };
+}
+
+function inputsFor(x: bigint, y: bigint, n: number): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < n; i++) {
+    inputs[`x${pad(i)}`] = Number((x >> BigInt(i)) & 1n);
+    inputs[`y${pad(i)}`] = Number((y >> BigInt(i)) & 1n);
+  }
+  return inputs;
+}
+
+/** Read the Z register out of a simulation result. */
+export function readZ(values: Record<string, number>, n: number): bigint {
+  let result = 0n;
+  for (let i = 0; i <= n; i++) {
+    if (values[`z${pad(i)}`]) result |= 1n << BigInt(i);
+  }
+  return result;
+}
+
+export function addWith(gates: Gate[], x: bigint, y: bigint, n: number): bigint {
+  return readZ(simulate(gates, inputsFor(x, y, n)), n);
+}
+
+/** Check X+Y on a spread of values chosen to exercise every carry path. */
+export function isCorrectAdder(gates: Gate[], n: number, rng: () => number): boolean {
+  const cases: Array<[bigint, bigint]> = [[0n, 0n]];
+  const all = (1n << BigInt(n)) - 1n;
+  cases.push([all, all], [all, 1n], [1n, all]);
+  for (let i = 0; i < n; i++) {
+    const bit = 1n << BigInt(i);
+    cases.push([bit, bit], [bit, 0n], [0n, bit], [bit | (bit >> 1n), bit >> 1n]);
+  }
+  for (let t = 0; t < 20; t++) {
+    let x = 0n;
+    let y = 0n;
+    for (let i = 0; i < n; i++) {
+      if (rng() < 0.5) x |= 1n << BigInt(i);
+      if (rng() < 0.5) y |= 1n << BigInt(i);
+    }
+    cases.push([x, y]);
+  }
+  return cases.every(([x, y]) => addWith(gates, x, y, n) === x + y);
+}
+
+export interface Broken {
+  gates: Gate[];
+  swapped: string[];
+}
+
+/**
+ * Swap four disjoint pairs of gate outputs, keeping only swap sets that leave
+ * the circuit acyclic and where every individual swap is observable.
+ *
+ * Some swaps change nothing: exchanging the outputs of the two AND gates that
+ * feed one OR leaves an identical circuit, so no method could ever report it.
+ * Requiring each swap to break the addition on its own keeps the expected
+ * answer well defined.
+ */
+export function breakAdder(n: number, rng: () => number, pairs = 4): Broken {
+  for (let attempt = 0; attempt < 500; attempt++) {
+    const correct = buildAdder(n, rng);
+    const gates = correct.map((gate) => ({ ...gate }));
+    const chosen = new Set<number>();
+    const swapped: string[] = [];
+    let observable = true;
+    while (chosen.size < pairs * 2 && observable) {
+      const a = Math.floor(rng() * gates.length);
+      const b = Math.floor(rng() * gates.length);
+      if (a === b || chosen.has(a) || chosen.has(b)) continue;
+
+      // Judge this swap on its own, against the intact adder.
+      const alone = correct.map((gate) => ({ ...gate }));
+      [alone[a].out, alone[b].out] = [alone[b].out, alone[a].out];
+      if (!hasCycle(alone) && isCorrectAdder(alone, n, rng)) {
+        observable = false;
+        break;
+      }
+
+      chosen.add(a);
+      chosen.add(b);
+      swapped.push(gates[a].out, gates[b].out);
+      [gates[a].out, gates[b].out] = [gates[b].out, gates[a].out];
+    }
+    if (!observable || hasCycle(gates)) continue;
+    if (isCorrectAdder(gates, n, rng)) continue;
+    return { gates, swapped: [...swapped].sort() };
+  }
+  throw new Error('could not construct a broken adder');
+}
+
+export function hasCycle(gates: Gate[]): boolean {
+  const producer = new Map<string, Gate>();
+  for (const gate of gates) producer.set(gate.out, gate);
+  const state = new Map<Gate, number>();
+  const visit = (gate: Gate): boolean => {
+    const seen = state.get(gate);
+    if (seen === 1) return true;
+    if (seen === 2) return false;
+    state.set(gate, 1);
+    for (const wire of [gate.in1, gate.in2]) {
+      const source = producer.get(wire);
+      if (source && visit(source)) return true;
+    }
+    state.set(gate, 2);
+    return false;
+  };
+  return gates.some(visit);
+}
