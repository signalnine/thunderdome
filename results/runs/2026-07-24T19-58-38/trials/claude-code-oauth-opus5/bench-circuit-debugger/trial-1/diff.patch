n isCorrectAdder(copy, n, rng);\n    const [head, ...rest] = remaining;\n    for (let i = 0; i < rest.length; i++) {\n      const first = byOutput.get(head) as Gate;\n      const second = byOutput.get(rest[i]) as Gate;\n      [first.out, second.out] = [second.out, first.out];\n      byOutput.set(first.out, first);\n      byOutput.set(second.out, second);\n      if (attempt(rest.filter((_, j) => j !== i))) return true;\n      [first.out, second.out] = [second.out, first.out];\n      byOutput.set(first.out, first);\n      byOutput.set(second.out, second);\n    }\n    return false;\n  };\n  return attempt(pool);\n}\n\ndescribe('findSwappedWires', () => {\n  it('finds a hand-built swap of a sum bit and a partial sum', () => {\n    const gates: Gate[] = [\n      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },\n      { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },\n      { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },\n      { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },\n      { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },\n      { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },\n      { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },\n      { op: 'XOR', in1: 'x02', in2: 'y02', out: 't02' },\n      // z02 and b02 are swapped: the sum bit is driven by an AND.\n      { op: 'XOR', in1: 't02', in2: 'c01', out: 'b02' },\n      { op: 'AND', in1: 'x02', in2: 'y02', out: 'a02' },\n      { op: 'AND', in1: 't02', in2: 'c01', out: 'z02' },\n      { op: 'OR', in1: 'a02', in2: 'b02', out: 'c02' },\n      { op: 'XOR', in1: 'x03', in2: 'y03', out: 't03' },\n      { op: 'XOR', in1: 't03', in2: 'c02', out: 'z03' },\n      { op: 'AND', in1: 'x03', in2: 'y03', out: 'a03' },\n      { op: 'AND', in1: 't03', in2: 'c02', out: 'b03' },\n      { op: 'OR', in1: 'a03', in2: 'b03', out: 'z04' },\n    ];\n    expect(findSwappedWires(gates)).toEqual(['b02', 'z02']);\n  });\n\n  it('finds swaps that both leave the gates looking structurally plausible', () => {\n    // Swapping two sum-bit outputs breaks nothing structurally: both gates are\n    // still XORs driving z wires. Only simulation can catch it.\n    const n = 12;\n    const gates = buildAdder(n, makeRng(5)).map((gate) => ({ ...gate }));\n    const byOutput = new Map(gates.map((gate) => [gate.out, gate]));\n    const swap = (a: string, b: string) => {\n      const first = byOutput.get(a) as Gate;\n      const second = byOutput.get(b) as Gate;\n      [first.out, second.out] = [second.out, first.out];\n    };\n    swap('z03', 'z07');\n    expect(findSwappedWires(gates)).toEqual(['z03', 'z07']);\n  });\n\n  it('recovers four random swaps across a range of widths', () => {\n    for (const n of [4, 6, 8, 16, 24, 45]) {\n      for (let trial = 0; trial < 8; trial++) {\n        const rng = makeRng(n * 1000 + trial + 1);\n        const { gates, swapped } = breakAdder(n, rng);\n        const found = findSwappedWires(gates);\n        expect(found, `n=${n} trial=${trial}`).toEqual(swapped);\n        expect(repairs(gates, found, n), `n=${n} trial=${trial} repairs`).toBe(true);\n      }\n    }\n  });\n\n  it('returns wires sorted with no duplicates', () => {\n    const { gates } = breakAdder(20, makeRng(4242));\n    const found = findSwappedWires(gates);\n    expect(found).toHaveLength(8);\n    expect(new Set(found).size).toBe(8);\n    expect([...found].sort()).toEqual(found);\n  });\n\n  it('solves a 45-bit circuit well under the time limit', () => {\n    const { gates, swapped } = breakAdder(45, makeRng(2024));\n    expect(gates.length).toBeGreaterThan(200);\n    const started = performance.now();\n    const found = findSwappedWires(gates);\n    const elapsed = performance.now() - started;\n    expect(found).toEqual(swapped);\n    expect(elapsed).toBeLessThan(5000);\n  });\n\n  it('ignores the order gates are listed in', () => {\n    const rng = makeRng(31337);\n    const { gates, swapped } = breakAdder(16, rng);\n    const shuffled = [...gates];\n    for (let i = shuffled.length - 1; i > 0; i--) {\n      const j = Math.floor(rng() * (i + 1));\n      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];\n    }\n    expect(findSwappedWires(shuffled)).toEqual(swapped);\n  });\n\n  it('does not mutate the gates it is given', () => {\n    const { gates } = breakAdder(12, makeRng(808));\n    const before = JSON.stringify(gates);\n    findSwappedWires(gates);\n    expect(JSON.stringify(gates)).toBe(before);\n  });\n\n  it('handles swaps confined to a single bit position', () => {\n    const n = 10;\n    const gates = buildAdder(n, makeRng(77)).map((gate) => ({ ...gate }));\n    const byOutput = new Map(gates.map((gate) => [gate.out, gate]));\n    // The partial sum and generated carry of bit 4 exchange outputs, as do the\n    // sum bit and the carry out of bit 5.\n    const partial4 = gates.find((g) => g.in1 === `x${pad(4)}` && g.op === 'XOR') as Gate;\n    const generated4 = gates.find((g) => g.in1 === `x${pad(4)}` && g.op === 'AND') as Gate;\n    const sum5 = byOutput.get(`z${pad(5)}`) as Gate;\n    const carry5 = gates.find(\n      (g) => g.op === 'OR' && (g.in1 === partial4.out || g.in2 === partial4.out),\n    );\n    [partial4.out, generated4.out] = [generated4.out, partial4.out];\n    const other = carry5 ?? (gates.find((g) => g.op === 'OR' && g !== sum5) as Gate);\n    const expected = [partial4.out, generated4.out, sum5.out, other.out].sort();\n    [sum5.out, other.out] = [other.out, sum5.out];\n    const found = findSwappedWires(gates);\n    expect(found).toEqual(expected);\n  });\n});\n","structuredPatch":[{"oldStart":116,"oldLines":23,"newStart":116,"newLines":47,"lines":["     expect(JSON.stringify(gates)).toBe(before);","   });"," ","-  it('handles swaps confined to a single bit position', () => {","-    const n = 10;","+  it('handles two swaps inside one bit, where no single swap makes progress', () => {","+    const n = 12;","     const gates = buildAdder(n, makeRng(77)).map((gate) => ({ ...gate }));","+    const stage = (bit: number) => {","+ 