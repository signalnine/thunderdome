32Array;\n  private readonly indegree: Int32Array;\n  private readonly pending: Int32Array;\n  private readonly queue: Int32Array;\n  private readonly values: Int32Array;\n  private readonly zIds: Int32Array;\n  private readonly expected: Int32Array[];\n  private readonly scratch: Uint8Array;\n\n  constructor(gates: Gate[], suite: TestSuite) {\n    this.numGates = gates.length;\n    this.words = suite.words;\n    this.n = suite.n;\n    this.expected = suite.z;\n\n    const intern = (wire: string): number => {\n      const existing = this.ids.get(wire);\n      if (existing !== undefined) return existing;\n      const id = this.names.length;\n      this.names.push(wire);\n      this.ids.set(wire, id);\n      return id;\n    };\n\n    const numGates = gates.length;\n    this.in1 = new Int32Array(numGates);\n    this.in2 = new Int32Array(numGates);\n    this.outWire = new Int32Array(numGates);\n    this.ops = new Uint8Array(numGates);\n    for (let i = 0; i < numGates; i++) {\n      const gate = gates[i];\n      this.in1[i] = intern(gate.in1);\n      this.in2[i] = intern(gate.in2);\n      this.outWire[i] = intern(gate.out);\n      this.ops[i] = gate.op === 'AND' ? OP_AND : gate.op === 'OR' ? OP_OR : OP_XOR;\n    }\n\n    const numWires = this.names.length;\n    this.numWires = numWires;\n    this.values = new Int32Array(numWires * this.words);\n    this.scratch = new Uint8Array(numWires);\n\n    this.producer = new Int32Array(numWires).fill(-1);\n    for (let i = 0; i < numGates; i++) this.producer[this.outWire[i]] = i;\n\n    this.drivenWires = [];\n    for (let w = 0; w < numWires; w++) {\n      if (this.producer[w] >= 0) this.drivenWires.push(w);\n    }\n\n    // Build the consumer adjacency in compressed form.\n    this.consumerStart = new Int32Array(numWires + 1);\n    for (let i = 0; i < numGates; i++) {\n      this.consumerStart[this.in1[i] + 1]++;\n      this.consumerStart[this.in2[i] + 1]++;\n    }\n    for (let w = 0; w < numWires; w++) this.consumerStart[w + 