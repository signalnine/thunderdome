+import type { Gate } from './types.js';
+import { structuralSuspects } from './structure.js';
+import { minimalRepair, traceRepair } from './trace.js';
+import { inputBitCount } from './wires.js';
+
+/** Number of swapped pairs the circuits are known to contain. */
+const SWAP_COUNT = 4;
+
+/**
+ * Identify the eight wires involved in the four output swaps that stop these
+ * gates from computing X + Y.
+ *
+ * The repair is worked out structurally rather than by trying combinations:
+ * only the gates' `out` fields were corrupted, so their inputs still spell out
+ * the adder that was intended, and rebuilding it names the wires that moved.
+ * See {@link traceRepair}. Every answer is checked against the canonical adder
+ * shape, so a returned repair provably makes the circuit add.
+ *
+ * A corrupted circuit can sit near more than one working adder — swapping the
+ * two AND outputs feeding an OR changes nothing at all, for instance. Where
+ * the repairs differ, the one moving eight wires is preferred, matching the
+ * four swapped pairs the puzzle promises, and the smallest repair is the
+ * fallback.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  const n = inputBitCount(gates);
+  const wanted = SWAP_COUNT * 2;
+
+  const smallest = minimalRepair(gates, n, SWAP_COUNT);
+  if (smallest && smallest.length === wanted) return smallest;
+
+  // The smallest repair used fewer swaps than the puzzle describes, so look for
+  // one that accounts for all four pairs before settling for it.
+  const fourPairs =
+    traceRepair(gates, n, SWAP_COUNT, wanted) ??
+    traceRepair(gates, n, SWAP_COUNT, wanted, true);
+
+  // Nothing resolved into an adder: fall back on naming the gates that sit in
+  // positions a ripple-carry adder has no place for.
+  return fourPairs ?? smallest ?? structuralSuspects(gates);
+}
