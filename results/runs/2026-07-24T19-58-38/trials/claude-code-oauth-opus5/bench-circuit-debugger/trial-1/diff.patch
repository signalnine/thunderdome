+/**
+ * Flag gate outputs that cannot appear where they do in a ripple-carry adder.
+ *
+ * A correct n-bit adder is built from exactly five gate roles per bit:
+ *
+ *   x_i XOR y_i -> t_i        partial sum
+ *   x_i AND y_i -> a_i        generated carry
+ *   t_i XOR c_(i-1) -> z_i    final sum bit
+ *   t_i AND c_(i-1) -> b_i    propagated carry
+ *   a_i OR  b_i -> c_i        carry out  (c_(n-1) is the top output bit)
+ *
+ * Each role implies hard constraints on a gate's operation, its output name and
+ * the operations of the gates it feeds. A wire whose gate violates one of them
+ * must have been moved by a swap. This misses swaps that leave both gates
+ * looking plausible (notably swapping two z outputs with each other), so the
+ * result is treated as a lead to verify rather than as an answer.
+ */
+export function structuralSuspects(gates: Gate[]): string[] {
+  const n = inputBitCount(gates);
+  const topBit = n; // index of the most significant output bit
+  const consumers = new Map<string, Gate[]>();
+  for (const gate of gates) {
+    for (const wire of [gate.in1, gate.in2]) {
+      const list = consumers.get(wire);
+      if (list) list.push(gate);
+      else consumers.set(wire, [gate]);
+    }
+  }
+
+  const suspects = new Set<string>();
+  for (const gate of gates) {
+    const fedBy = consumers.get(gate.out) ?? [];
+    const feedsOp = (op: Gate['op']) => fedBy.some((consumer) => consumer.op === op);
+    const outBit = bitIndex(Z_WIRE, gate.out);
+    const isZ = outBit >= 0;
+    const inputBit = sharedInputBit(gate);
+
+    if (isZ && outBit === topBit) {
+      // The top output bit is the final carry, produced by the last OR gate.
+      if (gate.op !== 'OR') suspects.add(gate.out);
+      continue;
+    }
+
+    if (gate.op === 'XOR') {
+      if (inputBit >= 0) {
+        // A partial sum. At bit 0 there is no carry-in, so it is z00 directly;
+        // above that it must feed this bit's sum XOR and carry AND.
+        if (inputBit === 0) {
+          if (outBit !== 0) suspects.add(gate.out);
+        } else if (isZ || !feedsOp('XOR') || !feedsOp('AND') || feedsOp('OR')) {
+          suspects.add(gate.out);
+        }
+      } else if (!isZ) {
+        // The only other XOR combines a partial sum with a carry: that is a
+        // sum bit and nothing else.
+        suspects.add(gate.out);
+      }
+    } else if (gate.op === 'AND') {
+      if (inputBit === 0) {
+        // Carry out of bit 0: feeds the next stage's XOR and AND.
+        if (isZ || !feedsOp('XOR') || !feedsOp('AND') || feedsOp('OR')) suspects.add(gate.out);
+      } else if (isZ || fedBy.length === 0 || fedBy.some((consumer) => consumer.op !== 'OR')) {
+        // Every other AND produces a carry term consumed only by an OR.
+        suspects.add(gate.out);
+      }
+    } else if (isZ || !feedsOp('XOR') || !feedsOp('AND') || feedsOp('OR')) {
+      // An OR produces a carry, which drives the next stage's XOR and AND.
+      suspects.add(gate.out);
+    }
+  }
+
+  return [...suspects].sort();
+}
+
+function bitIndex(pattern: RegExp, wire: string): number {
+  const match = pattern.exec(wire);
+  return match ? Number(match[1]) : -1;
+}
+
+/** Bit index shared by both inputs when a gate reads x_i and y_i, else -1. */
+function sharedInputBit(gate: Gate): number {
+  const pairs: Array<[number, number]> = [
+    [bitIndex(X_WIRE, gate.in1), bitIndex(Y_WIRE, gate.in2)],
+    [bitIndex(X_WIRE, gate.in2), bitIndex(Y_WIRE, gate.in1)],
+  ];
+  for (const [x, y] of pairs) {
+    if (x >= 0 && x === y) return x;
+  }
+  return -1;
+}
