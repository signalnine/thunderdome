+import type { Gate } from './types.js';
+import { AND, OR, compile, evaluate, producers, topoOrder, type Circuit } from './circuit.js';
+import { reconstruct } from './reconstruct.js';
+import { bitOf, buildViolationTable, wireName } from './shape.js';
+import { buildTestVectors, expectedSums } from './testvectors.js';
+
+/** Number of 32-bit words per wire, i.e. 512 test vectors evaluated at once. */
+const STRIDE = 16;
+/** Words used by the inner-loop check; the leading 128 vectors. */
+const FAST_WORDS = 4;
+const NUM_SWAPS = 4;
+/** Cap on circuit evaluations, so a pathological input still returns. */
+const EVAL_BUDGET = 400_000;
+/** Wall-clock allowance, well inside the five seconds we are asked for. */
+const TIME_LIMIT_MS = 2_500;
+/** Moves explored per level that don't repair another output bit. */
+const SIDEWAYS_KEEP = 8;
+
+interface Move {
+  g1: number;
+  g2: number;
+  /** lowest output bit still wrong after the swap */
+  bad: number;
+  /** output bits correct after the swap */
+  correct: number;
+  /** adder shape rules broken after the swap */
+  violations: number;
+}
+
+interface Context {
+  circuit: Circuit;
+  /** width of the X/Y inputs; Z is one bit wider */
+  bits: number;
+  numZ: number;
+  zIndex: Int32Array;
+  vals: Uint32Array;
+  expected: Uint32Array;
+  order: Int32Array;
+  rem: Uint8Array;
+  /** `gate * numWires + wire`: does that gate driving that wire break a rule */
+  violates: Uint8Array;
+  /** rules broken by the current wiring */
+  violations: number;
+  /** gates currently breaking a rule, first */
+  bySuspicion: Int32Array;
+  /** gate outputs as they were given to us, to diff repairs against */
+  originalOut: Int32Array;
+  /** output bits the last evaluation got right */
+  lastCorrect: number;
+  budget: number;
+  /** bit-parallel carry out of each stage, as a working adder makes it */
+  expectedCarry: Uint32Array;
+  /** scratch for cone walks, stamped per call instead of cleared */
+  coneSeen: Int32Array;
+  coneDone: Int32Array;
+  coneOrder: Int32Array;
+  coneStamp: number;
+  /** when to give up and answer with what we have */
+  deadline: number;
+  /** scratch for mapping wires back to the gate driving them */
+  driver: Int32Array;
+  bestPartial: string[] | null;
+}
+
+function violationsOf(c: Circuit, table: Uint8Array): number {
+  let total = 0;
+  for (let g = 0; g < c.numGates; g++) total += table[g * c.numWires + c.out[g]];
+  return total;
+}
+
+function createContext(gates: Gate[]): Context | null {
+  const circuit = compile(gates);
+
+  let bits = 0;
+  for (const name of circuit.names) {
+    const b = bitOf(name, 'x');
+    if (b >= 0) bits = Math.max(bits, b + 1);
+  }
+  if (bits === 0) return null;
+  const numZ = bits + 1;
+
+  const count = STRIDE * 32;
+  const tests = buildTestVectors(bits, count, FAST_WORDS * 32);
+  const { sums, carries } = expectedSums(tests);
+
+  const vals = new Uint32Array(circuit.numWires * STRIDE);
+  for (let t = 0; t < count; t++) {
+    const word = t >>> 5;
+    const bit = 1 << (t & 31);
+    for (let i = 0; i < bits; i++) {
+      const x = circuit.index.get(wireName(i, 'x'));
+      const y = circuit.index.get(wireName(i, 'y'));
+      if (x !== undefined && tests.x[t * bits + i]) vals[x * STRIDE + word] |= bit;
+      if (y !== undefined && tests.y[t * bits + i]) vals[y * STRIDE + word] |= bit;
+    }
+  }
+
+  const expected = new Uint32Array(numZ * STRIDE);
+  const zIndex = new Int32Array(numZ);
+  for (let j = 0; j < numZ; j++) {
+    const w = circuit.index.get(wireName(j, 'z'));
+    zIndex[j] = w === undefined ? -1 : w;
+    for (let t = 0; t < count; t++) {
+      if (sums[t * numZ + j]) expected[j * STRIDE + (t >>> 5)] |= 1 << (t & 31);
+    }
+  }
+
+  const expectedCarry = new Uint32Array(bits * STRIDE);
+  for (let i = 0; i < bits; i++) {
+    for (let t = 0; t < count; t++) {
+      if (carries[t * bits + i]) expectedCarry[i * STRIDE + (t >>> 5)] |= 1 << (t & 31);
+    }
+  }
+
+  const violates = buildViolationTable(circuit, bits);
+  const suspect = (g: number): number => violates[g * circuit.numWires + circuit.out[g]];
+  const bySuspicion = Int32Array.from({ length: circuit.numGates }, (_, i) => i).sort(
+    (a, b) => suspect(b) - suspect(a),
+  );
+
+  return {
+    circuit,
+    bits,
+    numZ,
+    zIndex,
+    vals,
+    expected,
+    expectedCarry,
+    coneSeen: new Int32Array(circuit.numWires),
+    coneDone: new Int32Array(circuit.numWires),
+    coneOrder: new Int32Array(circuit.numGates),
+    coneStamp: 0,
+    order: new Int32Array(circuit.numGates),
+    rem: new Uint8Array(circuit.numGates),
+    violates,
+    violations: violationsOf(circuit, violates),
+    bySuspicion,
+    originalOut: Int32Array.from(circuit.out),
+    lastCorrect: 0,
+    budget: EVAL_BUDGET,
+    deadline: Date.now() + TIME_LIMIT_MS,
+    driver: new Int32Array(circuit.numWires),
+    bestPartial: null,
+  };
+}
+
+/**
+ * Scores the circuit: returns the lowest output bit it gets wrong (`numZ` when
+ * it adds correctly, -1 when a swap has made the wiring cyclic) and leaves the
+ * total number of correct output bits in `ctx.lastCorrect`.
+ *
+ * Two numbers rather than one, because a stage can break in two independent
+ * places. A broken sum path shows up as the lowest wrong bit; a broken carry
+ * path leaves that bit alone and corrupts everything above it instead.
+ */
+function assess(ctx: Context, words: number): number {
+  ctx.budget--;
+  const c = ctx.circuit;
+  ctx.lastCorrect = 0;
+  if (!topoOrder(c, ctx.rem, ctx.order)) return -1;
+  evaluate(c, ctx.order, ctx.vals, words, STRIDE);
+
+  let bad = ctx.numZ;
+  let correct = 0;
+  for (let j = 0; j < ctx.numZ; j++) {
+    const w = ctx.zIndex[j];
+    let ok = w >= 0;
+    if (ok) {
+      const base = w * STRIDE;
+      const want = j * STRIDE;
+      for (let k = 0; k < words; k++) {
+        if (ctx.vals[base + k] !== ctx.expected[want + k]) {
+          ok = false;
+          break;
+        }
+      }
+    }
+    if (ok) correct++;
+    else if (j < bad) bad = j;
+  }
+  ctx.lastCorrect = correct;
+  return bad;
+}
+
+/**
+ * Whether `wire` is holding exactly the carry out of stage `stage`, given
+ * `driver`, the gate currently driving each wire.
+ *
+ * Only the cone feeding the wire is evaluated, and for a repair built from bit
+ * 0 upwards that cone is the part already settled — so this is a ground-truth
+ * check on a half-finished repair, and a walk that took a wrong turn can be
+ * dropped at the turn rather than at the end of the walk. A cycle in the cone
+ * is a wrong turn too: no prefix of an adder has one.
+ */
+function carryHolds(ctx: Context, stage: number, wire: number, driver: Int32Array): boolean {
+  const c = ctx.circuit;
+  if (wire < 0 || stage < 0 || stage >= ctx.bits) return false;
+
+  const stamp = ++ctx.coneStamp;
+  const { coneSeen: seen, coneDone: done, coneOrder: order } = ctx;
+  let count = 0;
+  const stack = [wire];
+  while (stack.length > 0) {
+    const w = stack[stack.length - 1];
+    const g = driver[w];
+    if (done[w] === stamp || g < 0) {
+      done[w] = stamp;
+      stack.pop();
+      continue;
+    }
+    if (seen[w] !== stamp) {
+      seen[w] = stamp;
+      stack.push(c.ina[g], c.inb[g]);
+      continue;
+    }
+    // Back at this wire with its inputs handled: any still open is a cycle.
+    if (done[c.ina[g]] !== stamp || done[c.inb[g]] !== stamp) return false;
+    order[count++] = g;
+    done[w] = stamp;
+    stack.pop();
+  }
+
+  const { op, ina, inb, out } = c;
+  const vals = ctx.vals;
+  for (let k = 0; k < count; k++) {
+    const g = order[k];
+    const a = ina[g] * STRIDE;
+    const b = inb[g] * STRIDE;
+    const o = out[g] * STRIDE;
+    switch (op[g]) {
+      case AND:
+        for (let w = 0; w < FAST_WORDS; w++) vals[o + w] = vals[a + w] & vals[b + w];
+        break;
+      case OR:
+        for (let w = 0; w < FAST_WORDS; w++) vals[o + w] = vals[a + w] | vals[b + w];
+        break;
+      default:
+        for (let w = 0; w < FAST_WORDS; w++) vals[o + w] = vals[a + w] ^ vals[b + w];
+        break;
+    }
+  }
+
+  const base = wire * STRIDE;
+  const want = stage * STRIDE;
+  for (let w = 0; w < FAST_WORDS; w++) {
+    if (vals[base + w] !== ctx.expectedCarry[want + w]) return false;
+  }
+  return true;
+}
+
+function coneFlags(c: Circuit, wire: number, producer: Int32Array, flags: Uint8Array): void {
+  if (wire < 0) return;
+  const seen = new Uint8Array(c.numWires);
+  const stack = [wire];
+  while (stack.length > 0) {
+    const w = stack.pop() as number;
+    if (seen[w]) continue;
+    seen[w] = 1;
+    const g = producer[w];
+    if (g < 0) continue;
+    flags[g] = 1;
+    stack.push(c.ina[g], c.inb[g]);
+  }
+}
+
+/**
+ * Splits the gates into those worth swapping when bit `bad` is the lowest
+ * wrong output, and everything else.
+ *
+ * A swap can only matter here if one side currently drives a wire feeding
+ * z[bad] or z[bad+1] — z[bad+1] included because a stage's carry output is not
+ * in its own sum's cone, so a mis-wired carry is invisible at z[bad]. Gates
+ * that also feed the bit below (already correct) are demoted: the damage is
+ * nearly always in the part of the cone the working prefix doesn't touch.
+ */
+function candidateGroups(ctx: Context, bad: number): [number[], number[]] {
+  const c = ctx.circuit;
+  const producer = producers(c);
+  const near = new Uint8Array(c.numGates);
+  coneFlags(c, ctx.zIndex[bad], producer, near);
+  if (bad + 1 < ctx.numZ) coneFlags(c, ctx.zIndex[bad + 1], producer, near);
+  const below = new Uint8Array(c.numGates);
+  if (bad > 0) coneFlags(c, ctx.zIndex[bad - 1], producer, below);
+
+  const fresh: number[] = [];
+  const rest: number[] = [];
+  for (const g of ctx.bySuspicion) {
+    if (!near[g]) continue;
+    (below[g] ? rest : fresh).push(g);
+  }
+  return [fresh, rest];
+}
+
+function swapOutputs(ctx: Context, g1: number, g2: number): void {
+  const c = ctx.circuit;
+  const w1 = c.out[g1];
+  const w2 = c.out[g2];
+  const n = c.numWires;
+  ctx.violations +=
+    ctx.violates[g1 * n + w2] +
+    ctx.violates[g2 * n + w1] -
+    ctx.violates[g1 * n + w1] -
+    ctx.violates[g2 * n + w2];
+  c.out[g1] = w2;
+  c.out[g2] = w1;
+}
+
+/**
+ * The gate pairs whose outputs the current repair has exchanged, or null if
+ * the repair isn't of that shape.
+ *
+ * Taken as a diff against the circuit we were handed rather than from the list
+ * of swaps performed, because a repair may route one gate through several
+ * exchanges on its way to the right output. What matters is that the result
+ * reads as pairs: the corruption was four two-way exchanges, so a fix that
+ * rotates three gates around a cycle explains the same behaviour but not the
+ * same story.
+ */
+function repairPairs(ctx: Context): Array<[number, number]> | null {
+  const c = ctx.circuit;
+  const driver = ctx.driver.fill(-1);
+  for (let g = 0; g < c.numGates; g++) driver[c.out[g]] = g;
+
+  const pairs: Array<[number, number]> = [];
+  for (let g = 0; g < c.numGates; g++) {
+    const was = ctx.originalOut[g];
+    if (c.out[g] === was) continue;
+    // Whoever took this gate's old wire must have given up the one it took.
+    const partner = driver[was];
+    if (partner < 0 || ctx.originalOut[partner] !== c.out[g]) return null;
+    if (g < partner) pairs.push([g, partner]);
+  }
+  return pairs;
+}
+
+function repairedWires(ctx: Context, pairs: Array<[number, number]>): string[] {
+  const names: string[] = [];
+  for (const [g1, g2] of pairs) {
+    names.push(ctx.circuit.names[ctx.originalOut[g1]], ctx.circuit.names[ctx.originalOut[g2]]);
+  }
+  return names.sort();
+}
+
+/**
+ * Whether the circuit, as currently rewired, is a repair we would sign off on:
+ * four exchanges, an adder that adds, and — the part that takes some care —
+ * four exchanges that each *matter*.
+ *
+ * A correct adder has a symmetry: the generate and propagate terms of a stage
+ * meet in an OR, so trading those two wires changes nothing. A repair can pick
+ * up such a pair for free and still add correctly, which makes it a true story
+ * about the circuit but the wrong answer, since a swap nobody can observe is
+ * not a swap the puzzle made. Putting each pair back one at a time and
+ * insisting the adder breaks rules those out.
+ */
+function isConvincingRepair(ctx: Context, pairs: Array<[number, number]>): boolean {
+  if (pairs.length !== NUM_SWAPS) return false;
+  // Most candidates die on the quick check, so spend the full suite only on
+  // the ones that survive it.
+  if (assess(ctx, FAST_WORDS) !== ctx.numZ) return false;
+  if (assess(ctx, STRIDE) !== ctx.numZ) return false;
+  for (const [g1, g2] of pairs) {
+    swapOutputs(ctx, g1, g2);
+    const stillAdds = assess(ctx, STRIDE) === ctx.numZ;
+    swapOutputs(ctx, g1, g2);
+    if (stillAdds) return false;
+  }
+  return true;
+}
+
+/**
+ * Scores swapping each gate in `drivers` against every other gate, keeping
+ * those that leave the already-working low bits alone.
+ */
+function scoreMoves(ctx: Context, drivers: number[], bad: number, moves: Move[]): void {
+  const c = ctx.circuit;
+  const seen = new Set<number>();
+  for (const g1 of drivers) {
+    for (const g2 of ctx.bySuspicion) {
+      if (g1 === g2 || ctx.budget <= 0) continue;
+      const key = g1 < g2 ? g1 * c.numGates + g2 : g2 * c.numGates + g1;
+      if (seen.has(key)) continue;
+      seen.add(key);
+
+      swapOutputs(ctx, g1, g2);
+      const nextBad = assess(ctx, FAST_WORDS);
+      const move = { g1, g2, bad: nextBad, correct: ctx.lastCorrect, violations: ctx.violations };
+      swapOutputs(ctx, g1, g2);
+      // Breaking a bit that already worked is never a step towards the repair,
+      // and a cyclic result (-1) is not a circuit at all.
+      if (nextBad >= bad) moves.push(move);
+    }
+  }
+}
+
+/**
+ * Orders swaps by how much of the adder they restore: first how far up the
+ * output the circuit now works, then how close the wiring is to an adder's
+ * shape, then how many bits are right anywhere.
+ *
+ * Shape outranks the bit count because when a stage is broken twice, repairing
+ * one half moves neither the failing bit nor, usually, the bit count — but it
+ * does resolve a structural violation, and that is the only visible progress.
+ */
+function byPromise(a: Move, b: Move): number {
+  return b.bad - a.bad || a.violations - b.violations || b.correct - a.correct;
+}
+
+/**
+ * Depth-first search over swaps, guided by how much of the adder works.
+ *
+ * Candidates must leave the already-correct low bits intact, and those that
+ * repair another output bit are taken first, which turns "choose 4 pairs out
+ * of ~24k" into a handful of probes per level. A stage can also be broken in
+ * two places at once — sum path and carry path — and then no single swap shows
+ * any functional gain, so the best-shaped swaps are explored anyway. Nothing
+ * is trusted until four swaps together pass the full test suite, so a wrong
+ * guess costs time rather than correctness.
+ */
+function search(ctx: Context, depth: number): boolean {
+  if (ctx.budget <= 0 || Date.now() > ctx.deadline) return false;
+  const pairs = repairPairs(ctx);
+  if (depth === NUM_SWAPS) return pairs !== null && isConvincingRepair(ctx, pairs);
+
+  // Candidates are ranked on a quick 128-vector check, so re-score any node we
+  // actually descend into against the whole suite before trusting it.
+  const bad = assess(ctx, STRIDE);
+  if (bad === ctx.numZ) {
+    // A correct adder with swaps to spare: the rest of the swaps cancel out and
+    // no amount of simulation can pin them down. Hold on to what we have.
+    const wires = pairs && repairedWires(ctx, pairs);
+    if (wires && (!ctx.bestPartial || wires.length > ctx.bestPartial.length)) {
+      ctx.bestPartial = wires;
+    }
+    return false;
+  }
+
+  const [fresh, rest] = candidateGroups(ctx, bad);
+  const moves: Move[] = [];
+  scoreMoves(ctx, fresh, bad, moves);
+  if (!moves.some((m) => m.bad > bad)) scoreMoves(ctx, rest, bad, moves);
+  moves.sort(byPromise);
+
+  let sideways = SIDEWAYS_KEEP;
+  for (const move of moves) {
+    if (ctx.budget <= 0) return false;
+    if (move.bad === bad && sideways-- <= 0) break;
+    swapOutputs(ctx, move.g1, move.g2);
+    if (search(ctx, depth + 1)) return true;
+    swapOutputs(ctx, move.g1, move.g2);
+  }
+  return false;
+}
+
+/**
+ * Finds the eight wires involved in the four output swaps that stop these
+ * gates from adding X and Y correctly. Returns them sorted.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  const ctx = createContext(gates);
+  if (!ctx) return [];
+
+  // Reading the adder off its (untouched) input wiring pins the swaps down
+  // directly, so try that first and keep the answer if it really does add.
+  let repaired: string[] | null = null;
+  const accept = (): boolean => {
+    const pairs = repairPairs(ctx);
+    if (!pairs || !isConvincingRepair(ctx, pairs)) return false;
+    repaired = repairedWires(ctx, pairs);
+    return true;
+  };
+  // The thorough walk can wander, so cap it well short of the overall budget
+  // and leave the rest of the time for the search.
+  const walkDeadline = ctx.deadline - 0.6 * TIME_LIMIT_MS;
+  const carryCheck = (stage: number, wire: number, driver: Int32Array): boolean =>
+    carryHolds(ctx, stage, wire, driver);
+  for (const [thorough, deadline] of [[false, ctx.deadline], [true, walkDeadline]] as const) {
+    if (reconstruct(ctx.circuit, ctx.bits, accept, carryCheck, thorough, deadline) && repaired) {
+      return repaired;
+    }
+    ctx.circuit.out.set(ctx.originalOut);
+  }
+  ctx.violations = violationsOf(ctx.circuit, ctx.violates);
+
+  // Otherwise hunt for the swaps by simulation, which needs no assumption
+  // about the circuit's shape beyond it being meant to add.
+  if (search(ctx, 0)) {
+    const pairs = repairPairs(ctx);
+    if (pairs) return repairedWires(ctx, pairs);
+  }
+
+  // Nothing verified end to end: fall back on the best partial repair, topped
+  // up with the gates whose wiring breaks the adder shape.
+  const found = new Set<string>(ctx.bestPartial ?? []);
+  for (const g of ctx.bySuspicion) {
+    if (found.size >= 2 * NUM_SWAPS) break;
+    if (ctx.violates[g * ctx.circuit.numWires + ctx.circuit.out[g]]) {
+      found.add(ctx.circuit.names[ctx.circuit.out[g]]);
+    }
+  }
+  return [...found].sort();
+}
diff --git a/src/testvectors.ts b/src/testvectors.ts
new file mode 100644
index 0000000..8b9de5f
--- /dev/null
+++ b/src/testvectors.ts
@@ -0,0 +1,106 @@
+/** Deterministic PRNG so results never depend on run order. */
+function mulberry32(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export interface TestVectors {
+  /** number of vectors */
+  count: number;
+  /** bit i of vector t at [t * bits + i] */
+  x: Uint8Array;
+  y: Uint8Array;
+  bits: number;
+}
+
+/**
+ * Builds `count` (x, y) input pairs for an `bits`-wide adder.
+ *
+ * The suite opens with structured patterns that stress carry generation and
+ * propagation, then single-bit walks, then uniform random pairs. Random pairs
+ * matter most: at every bit position they exercise all eight combinations of
+ * (x_i, y_i, carry_in) many times over, which is what makes "lowest wrong
+ * output bit" a trustworthy signal. The ordering matters because a quick check
+ * only reads the first slice of vectors.
+ */
+export function buildTestVectors(bits: number, count: number, fastCount: number): TestVectors {
+  const x = new Uint8Array(count * bits);
+  const y = new Uint8Array(count * bits);
+  const rand = mulberry32(0x5eed1234);
+  let t = 0;
+
+  const patterns: Array<(i: number) => [number, number]> = [
+    () => [0, 0],
+    () => [1, 1],
+    (i) => [1, i === 0 ? 1 : 0],
+    (i) => [0, i === 0 ? 1 : 0],
+    (i) => [i % 2, 1 - (i % 2)],
+    (i) => [1 - (i % 2), i % 2],
+    (i) => [i % 3 === 0 ? 1 : 0, i % 3 === 1 ? 1 : 0],
+    () => [1, 0],
+    () => [0, 1],
+  ];
+  for (const pattern of patterns) {
+    if (t >= count) break;
+    for (let i = 0; i < bits; i++) {
+      const [xi, yi] = pattern(i);
+      x[t * bits + i] = xi;
+      y[t * bits + i] = yi;
+    }
+    t++;
+  }
+
+  const randomFill = (limit: number): void => {
+    while (t < limit) {
+      for (let i = 0; i < bits; i++) {
+        x[t * bits + i] = rand() < 0.5 ? 1 : 0;
+        y[t * bits + i] = rand() < 0.5 ? 1 : 0;
+      }
+      t++;
+    }
+  };
+
+  // Keep the walks inside the fast window: they isolate one bit at a time.
+  randomFill(Math.max(0, Math.min(count, fastCount - 2 * bits)));
+  for (let i = 0; i < bits && t < count; i++) {
+    x[t * bits + i] = 1;
+    y[t * bits + i] = 1;
+    t++;
+  }
+  for (let i = 0; i < bits && t < count; i++) {
+    x[t * bits + i] = 1;
+    t++;
+  }
+  randomFill(count);
+
+  return { count, x, y, bits };
+}
+
+/**
+ * Expected sum bits and stage carries.
+ *
+ * `sums[t * (bits + 1) + j]` is bit j of x + y, and `carries[t * bits + i]` is
+ * the carry out of stage i — what the wire running from stage i into stage
+ * i + 1 must hold in a working adder.
+ */
+export function expectedSums(tests: TestVectors): { sums: Uint8Array; carries: Uint8Array } {
+  const { count, bits, x, y } = tests;
+  const sums = new Uint8Array(count * (bits + 1));
+  const carries = new Uint8Array(count * bits);
+  for (let t = 0; t < count; t++) {
+    let carry = 0;
+    for (let i = 0; i < bits; i++) {
+      const total = x[t * bits + i] + y[t * bits + i] + carry;
+      sums[t * (bits + 1) + i] = total & 1;
+      carry = total > 1 ? 1 : 0;
+      carries[t * bits + i] = carry;
+    }
+    sums[t * (bits + 1) + bits] = carry;
+  }
+  return { sums, carries };
+}
