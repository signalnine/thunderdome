+import type { Gate } from './types.js';
+
+function apply(op: Gate['op'], a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+  }
+}
+
+/**
+ * Evaluates a combinational circuit.
+ *
+ * Gates fire as soon as both of their inputs are known, so the caller does not
+ * have to supply them in dependency order. Returns every wire that ended up
+ * with a value: the supplied inputs plus every gate output that could be
+ * reached from them.
+ */
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values = new Map<string, number>();
+  for (const [wire, value] of Object.entries(inputs)) {
+    values.set(wire, value ? 1 : 0);
+  }
+
+  // Gates waiting on a wire, so we can wake them when that wire resolves.
+  const waiting = new Map<string, number[]>();
+  const pending = new Int32Array(gates.length);
+  const ready: number[] = [];
+
+  for (let i = 0; i < gates.length; i++) {
+    const gate = gates[i];
+    let missing = 0;
+    for (const wire of gate.in1 === gate.in2 ? [gate.in1] : [gate.in1, gate.in2]) {
+      if (values.has(wire)) continue;
+      missing++;
+      const list = waiting.get(wire);
+      if (list) list.push(i);
+      else waiting.set(wire, [i]);
+    }
+    pending[i] = missing;
+    if (missing === 0) ready.push(i);
+  }
+
+  while (ready.length > 0) {
+    const gate = gates[ready.pop() as number];
+    const a = values.get(gate.in1) as number;
+    const b = values.get(gate.in2) as number;
+    const known = values.has(gate.out);
+    values.set(gate.out, apply(gate.op, a, b));
+    if (known) continue; // wire was pre-seeded; nothing is waiting on it
+
+    const woken = waiting.get(gate.out);
+    if (!woken) continue;
+    for (const j of woken) {
+      if (--pending[j] === 0) ready.push(j);
+    }
+  }
+
+  return Object.fromEntries(values);
+}
