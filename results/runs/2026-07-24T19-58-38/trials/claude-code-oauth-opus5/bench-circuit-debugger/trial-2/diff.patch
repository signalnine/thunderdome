@@ -0,0 +1,178 @@
+import type { Gate } from '../src/types.js';
+import { simulate } from '../src/simulate.js';
+
+export function mulberry32(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+const pad = (n: number): string => String(n).padStart(2, '0');
+
+/** A correct ripple-carry adder of `bits` width, with random internal names. */
+export function buildAdder(bits: number, rand: () => number): Gate[] {
+  const used = new Set<string>();
+  const randomName = (): string => {
+    const letters = 'abcdefghijklmnopqrstuvwxyz';
+    for (;;) {
+      let name = '';
+      for (let i = 0; i < 3; i++) name += letters[Math.floor(rand() * 26)];
+      if (name[0] === 'x' || name[0] === 'y' || name[0] === 'z') continue;
+      if (used.has(name)) continue;
+      used.add(name);
+      return name;
+    }
+  };
+
+  const gates: Gate[] = [];
+  gates.push({ op: 'XOR', in1: `x${pad(0)}`, in2: `y${pad(0)}`, out: `z${pad(0)}` });
+  let carry = randomName();
+  gates.push({ op: 'AND', in1: `x${pad(0)}`, in2: `y${pad(0)}`, out: carry });
+
+  for (let i = 1; i < bits; i++) {
+    const half = randomName();
+    const gen = randomName();
+    const prop = randomName();
+    const next = i === bits - 1 ? `z${pad(bits)}` : randomName();
+    gates.push({ op: 'XOR', in1: `x${pad(i)}`, in2: `y${pad(i)}`, out: half });
+    gates.push({ op: 'XOR', in1: half, in2: carry, out: `z${pad(i)}` });
+    gates.push({ op: 'AND', in1: `x${pad(i)}`, in2: `y${pad(i)}`, out: gen });
+    gates.push({ op: 'AND', in1: half, in2: carry, out: prop });
+    gates.push({ op: 'OR', in1: gen, in2: prop, out: next });
+    carry = next;
+  }
+  return gates;
+}
+
+/** True if the gates add x + y correctly for the given random probes. */
+export function isCorrectAdder(gates: Gate[], bits: number, rand: () => number, trials = 60): boolean {
+  const cases: Array<[bigint, bigint]> = [
+    [0n, 0n],
+    [(1n << BigInt(bits)) - 1n, 1n],
+    [(1n << BigInt(bits)) - 1n, (1n << BigInt(bits)) - 1n],
+  ];
+  for (let t = cases.length; t < trials; t++) {
+    let x = 0n;
+    let y = 0n;
+    for (let i = 0; i < bits; i++) {
+      if (rand() < 0.5) x |= 1n << BigInt(i);
+      if (rand() < 0.5) y |= 1n << BigInt(i);
+    }
+    cases.push([x, y]);
+  }
+
+  for (const [x, y] of cases) {
+    const inputs: Record<string, number> = {};
+    for (let i = 0; i < bits; i++) {
+      inputs[`x${pad(i)}`] = Number((x >> BigInt(i)) & 1n);
+      inputs[`y${pad(i)}`] = Number((y >> BigInt(i)) & 1n);
+    }
+    const values = simulate(gates, inputs);
+    let got = 0n;
+    for (let j = 0; j <= bits; j++) {
+      const v = values[`z${pad(j)}`];
+      if (v === undefined) return false;
+      if (v) got |= 1n << BigInt(j);
+    }
+    if (got !== x + y) return false;
+  }
+  return true;
+}
+
+export interface SwappedCircuit {
+  gates: Gate[];
+  /** the eight wire names, sorted */
+  answer: string[];
+  /** the four swapped wire-name pairs */
+  swapped: Array<[string, string]>;
+}
+
+/**
+ * Takes a correct adder and swaps four disjoint pairs of gate outputs.
+ *
+ * Each swap is required to be individually observable: a pair whose exchange
+ * leaves the adder correct (the two AND terms feeding one OR, say) would be
+ * impossible for any solver to recover, so those are rejected here rather than
+ * smuggled into the expected answer.
+ */
+export function makeSwapped(bits: number, seed: number, numSwaps = 4): SwappedCircuit {
+  const rand = mulberry32(seed);
+  const base = buildAdder(bits, rand);
+
+  for (let attempt = 0; attempt < 500; attempt++) {
+    const gates = base.map((g) => ({ ...g }));
+    const taken = new Set<number>();
+    const pairs: Array<[number, number]> = [];
+    let ok = true;
+
+    while (pairs.length < numSwaps && ok) {
+      let found = false;
+      for (let tries = 0; tries < 400 && !found; tries++) {
+        const i = Math.floor(rand() * gates.length);
+        const j = Math.floor(rand() * gates.length);
+        if (i === j || taken.has(i) || taken.has(j)) continue;
+
+        const probe = base.map((g) => ({ ...g }));
+        const tmp = probe[i].out;
+        probe[i].out = probe[j].out;
+        probe[j].out = tmp;
+        // Reject swaps that leave the adder correct (unrecoverable by anyone)
+        // and swaps that make the circuit cyclic (some wire never resolves).
+        if (isCorrectAdder(probe, bits, mulberry32(seed + 7), 12)) continue;
+        if (Object.keys(simulate(probe, allZero(bits))).length !== countWires(probe)) continue;
+
+        taken.add(i);
+        taken.add(j);
+        pairs.push([i, j]);
+        found = true;
+      }
+      if (!found) ok = false;
+    }
+    if (!ok) continue;
+
+    const answer: string[] = [];
+    const swapped: Array<[string, string]> = [];
+    for (const [i, j] of pairs) {
+      const tmp = gates[i].out;
+      gates[i].out = gates[j].out;
+      gates[j].out = tmp;
+      answer.push(gates[i].out, gates[j].out);
+      swapped.push([gates[i].out, gates[j].out]);
+    }
+    if (isCorrectAdder(gates, bits, mulberry32(seed + 11), 40)) continue;
+
+    shuffle(gates, rand);
+    return { gates, answer: answer.sort(), swapped };
+  }
+  throw new Error(`could not build a swapped circuit for seed ${seed}`);
+}
+
+function allZero(bits: number): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < bits; i++) {
+    inputs[`x${pad(i)}`] = 0;
+    inputs[`y${pad(i)}`] = 0;
+  }
+  return inputs;
+}
+
+function countWires(gates: Gate[]): number {
+  const wires = new Set<string>();
+  for (const g of gates) {
+    wires.add(g.in1);
+    wires.add(g.in2);
+    wires.add(g.out);
+  }
+  return wires.size;
+}
+
+function shuffle<T>(items: T[], rand: () => number): void {
+  for (let i = items.length - 1; i > 0; i--) {
+    const j = Math.floor(rand() * (i + 1));
+    [items[i], items[j]] = [items[j], items[i]];
+  }
+}
