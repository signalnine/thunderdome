@@ -0,0 +1,143 @@
+import { describe, expect, it } from 'vitest';
+import { findSwappedWires } from '../src/index.js';
+import type { Gate } from '../src/index.js';
+import { isCorrectAdder, makeSwapped, mulberry32 } from './generator.js';
+
+const pad = (n: number): string => String(n).padStart(2, '0');
+
+/**
+ * A readable ripple-carry adder: stage i has half-sum `tNN`, generate `aNN`,
+ * propagate `bNN` and carry `cNN`, exactly like the example in the task.
+ */
+function namedAdder(bits: number): Gate[] {
+  const gates: Gate[] = [
+    { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+    { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+  ];
+  for (let i = 1; i < bits; i++) {
+    const carryIn = `c${pad(i - 1)}`;
+    const carryOut = i === bits - 1 ? `z${pad(bits)}` : `c${pad(i)}`;
+    gates.push({ op: 'XOR', in1: `x${pad(i)}`, in2: `y${pad(i)}`, out: `t${pad(i)}` });
+    gates.push({ op: 'XOR', in1: `t${pad(i)}`, in2: carryIn, out: `z${pad(i)}` });
+    gates.push({ op: 'AND', in1: `x${pad(i)}`, in2: `y${pad(i)}`, out: `a${pad(i)}` });
+    gates.push({ op: 'AND', in1: `t${pad(i)}`, in2: carryIn, out: `b${pad(i)}` });
+    gates.push({ op: 'OR', in1: `a${pad(i)}`, in2: `b${pad(i)}`, out: carryOut });
+  }
+  return gates;
+}
+
+function withSwaps(gates: Gate[], pairs: Array<[string, string]>): Gate[] {
+  const swapped = gates.map((g) => ({ ...g }));
+  for (const [a, b] of pairs) {
+    const i = swapped.findIndex((g) => g.out === a);
+    const j = swapped.findIndex((g) => g.out === b);
+    swapped[i].out = b;
+    swapped[j].out = a;
+  }
+  return swapped;
+}
+
+/** Is there a pairing of `wires` whose swaps turn `gates` into a real adder? */
+function isValidRepair(gates: Gate[], bits: number, wires: string[]): boolean {
+  if (wires.length !== 8) return false;
+  const pairings: Array<Array<[string, string]>> = [];
+  const build = (rest: string[], acc: Array<[string, string]>): void => {
+    if (rest.length === 0) {
+      pairings.push(acc);
+      return;
+    }
+    const [head, ...tail] = rest;
+    for (let i = 0; i < tail.length; i++) {
+      build([...tail.slice(0, i), ...tail.slice(i + 1)], [...acc, [head, tail[i]]]);
+    }
+  };
+  build(wires, []);
+
+  return pairings.some((pairing) => {
+    const trial = gates.map((g) => ({ ...g }));
+    const byOut = new Map(trial.map((g, i) => [g.out, i]));
+    for (const [a, b] of pairing) {
+      const i = byOut.get(a);
+      const j = byOut.get(b);
+      if (i === undefined || j === undefined) return false;
+      trial[i].out = b;
+      trial[j].out = a;
+      byOut.set(a, j);
+      byOut.set(b, i);
+    }
+    return isCorrectAdder(trial, bits, mulberry32(31337), 50);
+  });
+}
+
+describe('findSwappedWires', () => {
+  it('finds four hand-placed swaps in an 8-bit adder', () => {
+    const gates = withSwaps(namedAdder(8), [
+      ['z01', 'a01'], // sum bit traded with its stage's generate term
+      ['t03', 'a03'], // half sum traded with its stage's generate term
+      ['z05', 'c05'], // sum bit traded with the carry out
+      ['z07', 'a07'], // sum bit traded across into a generate term
+    ]);
+    expect(findSwappedWires(gates)).toEqual(['a01', 'a03', 'a07', 'c05', 't03', 'z01', 'z05', 'z07']);
+  });
+
+  it('finds a swap that lands on bit 0', () => {
+    const gates = withSwaps(namedAdder(8), [
+      ['z00', 'c00'],
+      ['z02', 'b02'],
+      ['t04', 'a04'],
+      ['z06', 'b06'],
+    ]);
+    expect(findSwappedWires(gates)).toEqual(['a04', 'b02', 'b06', 'c00', 't04', 'z00', 'z02', 'z06']);
+  });
+
+  it('returns the wires sorted', () => {
+    const wires = findSwappedWires(makeSwapped(24, 7).gates);
+    expect(wires).toHaveLength(8);
+    expect([...wires].sort()).toEqual(wires);
+  });
+
+  it('does not depend on the order the gates are listed in', () => {
+    const { gates, answer } = makeSwapped(30, 4242);
+    expect(findSwappedWires([...gates].reverse())).toEqual(answer);
+    expect(findSwappedWires([...gates])).toEqual(answer);
+  });
+
+  for (const bits of [4, 8, 16, 32, 45]) {
+    it(`recovers four swaps across generated ${bits}-bit adders`, () => {
+      for (let seed = 1; seed <= 15; seed++) {
+        const { gates, answer } = makeSwapped(bits, seed * 1000 + bits);
+        expect(findSwappedWires(gates)).toEqual(answer);
+      }
+    });
+  }
+
+  it('reports wires that genuinely repair the circuit', () => {
+    for (let seed = 1; seed <= 8; seed++) {
+      const { gates } = makeSwapped(20, seed * 77);
+      expect(isValidRepair(gates, 20, findSwappedWires(gates))).toBe(true);
+    }
+  });
+
+  it('solves a 45-bit circuit well inside the time limit', () => {
+    const { gates, answer } = makeSwapped(45, 20250724);
+    expect(gates.length).toBeGreaterThan(200);
+
+    const started = performance.now();
+    const wires = findSwappedWires(gates);
+    const elapsed = performance.now() - started;
+
+    expect(wires).toEqual(answer);
+    expect(elapsed).toBeLessThan(5000);
+  });
+
+  it('stays inside the time limit on the slowest circuit we can generate', () => {
+    let worst = 0;
+    for (let seed = 1; seed <= 40; seed++) {
+      const { gates } = makeSwapped(45, seed * 31 + 5);
+      const started = performance.now();
+      findSwappedWires(gates);
+      worst = Math.max(worst, performance.now() - started);
+    }
+    expect(worst).toBeLessThan(5000);
+  });
+});
