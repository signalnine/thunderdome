new file mode 100644
index 0000000..32f93dc
--- /dev/null
+++ b/src/circuit.ts
@@ -0,0 +1,136 @@
+import type { Gate } from './types.js';
+
+export const AND = 0;
+export const OR = 1;
+export const XOR = 2;
+
+/**
+ * A circuit flattened into typed arrays, addressed by integer wire ids.
+ *
+ * Only `out` ever changes while searching for swaps: a swap permutes which
+ * gate drives which wire, so the wire set, the input edges and therefore each
+ * gate's in-degree all stay fixed. That lets us reuse `consumers`/`indeg`
+ * across every candidate swap instead of rebuilding the graph each time.
+ */
+export interface Circuit {
+  names: string[];
+  index: Map<string, number>;
+  numWires: number;
+  numGates: number;
+  op: Uint8Array;
+  ina: Int32Array;
+  inb: Int32Array;
+  out: Int32Array;
+  /** gates reading each wire */
+  consumers: number[][];
+  /** number of a gate's inputs that are driven by another gate */
+  indeg: Uint8Array;
+}
+
+export function compile(gates: Gate[]): Circuit {
+  const index = new Map<string, number>();
+  const names: string[] = [];
+  const idOf = (name: string): number => {
+    let id = index.get(name);
+    if (id === undefined) {
+      id = names.length;
+      names.push(name);
+      index.set(name, id);
+    }
+    return id;
+  };
+
+  const numGates = gates.length;
+  const op = new Uint8Array(numGates);
+  const ina = new Int32Array(numGates);
+  const inb = new Int32Array(numGates);
+  const out = new Int32Array(numGates);
+
+  for (let i = 0; i < numGates; i++) {
+    const gate = gates[i];
+    op[i] = gate.op === 'AND' ? AND : gate.op === 'OR' ? OR : XOR;
+    ina[i] = idOf(gate.in1);
+    inb[i] = idOf(gate.in2);
+    out[i] = idOf(gate.out);
+  }
+
+  const numWires = names.length;
+  const driven = new Uint8Array(numWires);
+  for (let i = 0; i < numGates; i++) driven[out[i]] = 1;
+
+  const consumers: number[][] = [];
+  for (let w = 0; w < numWires; w++) consumers.push([]);
+  const indeg = new Uint8Array(numGates);
+
+  for (let i = 0; i < numGates; i++) {
+    consumers[ina[i]].push(i);
+    indeg[i] = driven[ina[i]];
+    if (inb[i] !== ina[i]) {
+      consumers[inb[i]].push(i);
+      indeg[i] += driven[inb[i]];
+    }
+  }
+
+  return { names, index, numWires, numGates, op, ina, inb, out, consumers, indeg };
+}
+
+/**
+ * Kahn topological sort. Writes the gate order into `order` (which doubles as
+ * the worklist) and returns false if the circuit contains a cycle — a swap can
+ * easily introduce one.
+ */
+export function topoOrder(c: Circuit, rem: Uint8Array, order: Int32Array): boolean {
+  rem.set(c.indeg);
+  let tail = 0;
+  for (let i = 0; i < c.numGates; i++) {
+    if (rem[i] === 0) order[tail++] = i;
+  }
+  for (let head = 0; head < tail; head++) {
+    const consumers = c.consumers[c.out[order[head]]];
+    for (let k = 0; k < consumers.length; k++) {
+      const j = consumers[k];
+      if (--rem[j] === 0) order[tail++] = j;
+    }
+  }
+  return tail === c.numGates;
+}
+
+/**
+ * Evaluates the circuit on `words` test vectors at once: `vals` holds one
+ * `stride`-word bit-slice per wire, where bit t of the slice is that wire's
+ * value under test vector t. Every gate writes its whole output slice, so the
+ * array needs no clearing between runs — only the primary inputs are fixed.
+ */
+export function evaluate(
+  c: Circuit,
+  order: Int32Array,
+  vals: Uint32Array,
+  words: number,
+  stride: number,
+): void {
+  const { op, ina, inb, out, numGates } = c;
+  for (let k = 0; k < numGates; k++) {
+    const g = order[k];
+    const a = ina[g] * stride;
+    const b = inb[g] * stride;
+    const o = out[g] * stride;
+    switch (op[g]) {
+      case AND:
+        for (let w = 0; w < words; w++) vals[o + w] = vals[a + w] & vals[b + w];
+        break;
+      case OR:
+        for (let w = 0; w < words; w++) vals[o + w] = vals[a + w] | vals[b + w];
+        break;
+      default:
+        for (let w = 0; w < words; w++) vals[o + w] = vals[a + w] ^ vals[b + w];
+        break;
+    }
+  }
+}
+
+/** Gate driving each wire, or -1 for a primary input. */
+export function producers(c: Circuit): Int32Array {
+  const producer = new Int32Array(c.numWires).fill(-1);
+  for (let i = 0; i < c.numGates; i++) producer[c.out[i]] = i;
+  return producer;
+}
