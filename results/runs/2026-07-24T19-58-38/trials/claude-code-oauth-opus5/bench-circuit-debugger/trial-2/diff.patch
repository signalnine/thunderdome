index 0000000..9d8b4c5
--- /dev/null
+++ b/src/shape.ts
@@ -0,0 +1,99 @@
+import { AND, XOR, type Circuit } from './circuit.js';
+
+export function bitOf(name: string, prefix: string): number {
+  if (name.length < 2 || name[0] !== prefix) return -1;
+  const rest = name.slice(1);
+  if (!/^\d+$/.test(rest)) return -1;
+  return Number(rest);
+}
+
+export function wireName(bit: number, prefix: string): string {
+  return prefix + String(bit).padStart(2, '0');
+}
+
+/**
+ * For every (gate, wire) pair, whether driving that wire from that gate would
+ * break the shape of a ripple-carry adder. Indexed as `gate * numWires + wire`.
+ *
+ * Each stage of the adder looks like
+ *
+ *     half = x ^ y      gen  = x & y
+ *     z    = half ^ cin prop = half & cin
+ *     cout = gen | prop
+ *
+ * which pins down, for every gate, what kind of wire it may drive: whether the
+ * wire is an output bit, and which mix of gates is allowed to read it. Swapping
+ * two outputs almost always violates one of those rules, so counting
+ * violations gives a cheap measure of how adder-shaped the circuit currently
+ * is — and because a gate's readers are fixed by wire name and never move, the
+ * whole table can be computed once up front and the count updated in constant
+ * time per swap.
+ *
+ * The rules are conservative: a correct adder scores zero, so a violation is
+ * always real. They are not complete — a swap between two structurally
+ * interchangeable wires is invisible here — which is why this only ever guides
+ * a search that verifies its answers by simulation.
+ */
+export function buildViolationTable(c: Circuit, bits: number): Uint8Array {
+  const { numGates, numWires } = c;
+  const topZ = wireName(bits, 'z');
+
+  // Per-wire facts, all independent of which gate currently drives the wire.
+  const isZ = new Uint8Array(numWires);
+  const isTopZ = new Uint8Array(numWires);
+  const readsXor = new Int32Array(numWires);
+  const readsAnd = new Int32Array(numWires);
+  const readsOr = new Int32Array(numWires);
+  for (let w = 0; w < numWires; w++) {
+    const name = c.names[w];
+    isZ[w] = bitOf(name, 'z') >= 0 ? 1 : 0;
+    isTopZ[w] = name === topZ ? 1 : 0;
+    for (const g of c.consumers[w]) {
+      if (c.op[g] === XOR) readsXor[w]++;
+      else if (c.op[g] === AND) readsAnd[w]++;
+      else readsOr[w]++;
+    }
+  }
+
+  // Per-gate facts: which stage's x/y inputs it reads, if any.
+  const stage = new Int32Array(numGates);
+  for (let g = 0; g < numGates; g++) {
+    const a = c.names[c.ina[g]];
+    const b = c.names[c.inb[g]];
+    const bit = (n: string): number => {
+      const x = bitOf(n, 'x');
+      return x >= 0 ? x : bitOf(n, 'y');
+    };
+    stage[g] = Math.max(bit(a), bit(b));
+  }
+
+  const table = new Uint8Array(numGates * numWires);
+  for (let g = 0; g < numGates; g++) {
+    for (let w = 0; w < numWires; w++) {
+      // A carry feeds the next stage's XOR and AND and nothing else; a
+      // generate or propagate term is only ever merged by an OR.
+      const feedsStage = readsXor[w] === 1 && readsAnd[w] === 1 && readsOr[w] === 0;
+      const feedsMerge = readsOr[w] > 0 && readsXor[w] === 0 && readsAnd[w] === 0;
+      let bad = false;
+
+      if (isZ[w] && !isTopZ[w] && c.op[g] !== XOR) {
+        bad = true; // every sum bit but the top one is its stage's final XOR
+      } else if (c.op[g] === XOR) {
+        if (stage[g] < 0) bad = !isZ[w] || isTopZ[w] === 1; // sum bit
+        else if (stage[g] === 0) bad = c.names[w] !== wireName(0, 'z'); // x00 ^ y00
+        else bad = isZ[w] === 1 || !feedsStage; // half sum
+      } else if (c.op[g] === AND) {
+        // x00 & y00 is the first carry; every other AND is a carry term.
+        if (stage[g] === 0) bad = isZ[w] === 1 || !feedsStage;
+        else bad = isZ[w] === 1 || !feedsMerge;
+      } else {
+        // OR: a carry, or the top output bit, which nothing reads.
+        if (isZ[w]) bad = isTopZ[w] === 0;
+        else bad = !feedsStage;
+      }
+
+      table[g * numWires + w] = bad ? 1 : 0;
+    }
+  }
+  return table;
+}
