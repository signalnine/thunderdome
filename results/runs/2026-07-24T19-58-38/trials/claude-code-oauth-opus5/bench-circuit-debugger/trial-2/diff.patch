+import { describe, expect, it } from 'vitest';
+import { simulate } from '../src/index.js';
+import type { Gate } from '../src/index.js';
+import { buildAdder, mulberry32 } from './generator.js';
+
+describe('simulate', () => {
+  it('applies each gate operation', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'and' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'or' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'xor' },
+    ];
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, and: 0, or: 1, xor: 1 });
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, and: 1, or: 1, xor: 0 });
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, and: 0, or: 0, xor: 0 });
+  });
+
+  it('resolves gates given out of dependency order', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'mid', in2: 'c', out: 'result' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'mid' },
+    ];
+    expect(simulate(gates, { a: 0, b: 1, c: 1 })).toEqual({ a: 0, b: 1, c: 1, mid: 1, result: 1 });
+  });
+
+  it('handles a deep chain of dependencies', () => {
+    const gates: Gate[] = [];
+    for (let i = 0; i < 200; i++) {
+      gates.push({ op: 'XOR', in1: `w${i}`, in2: 'one', out: `w${i + 1}` });
+    }
+    gates.reverse();
+    const values = simulate(gates, { w0: 0, one: 1 });
+    expect(values.w200).toBe(0);
+    expect(values.w199).toBe(1);
+  });
+
+  it('accepts a gate reading the same wire twice', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'a', out: 'b' }];
+    expect(simulate(gates, { a: 1 })).toEqual({ a: 1, b: 0 });
+  });
+
+  it('returns only the inputs when no gate can fire', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'p', in2: 'q', out: 'r' }];
+    expect(simulate(gates, { p: 1 })).toEqual({ p: 1 });
+  });
+
+  it('matches the example 4-bit adder from the task', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+      { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },
+      { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },
+      { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },
+      { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },
+      { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },
+      { op: 'XOR', in1: 'x02', in2: 'y02', out: 't02' },
+      { op: 'XOR', in1: 't02', in2: 'c01', out: 'z02' },
+      { op: 'AND', in1: 'x02', in2: 'y02', out: 'a02' },
+      { op: 'AND', in1: 't02', in2: 'c01', out: 'b02' },
+      { op: 'OR', in1: 'a02', in2: 'b02', out: 'c02' },
+      { op: 'XOR', in1: 'x03', in2: 'y03', out: 't03' },
+      { op: 'XOR', in1: 't03', in2: 'c02', out: 'z03' },
+      { op: 'AND', in1: 'x03', in2: 'y03', out: 'a03' },
+      { op: 'AND', in1: 't03', in2: 'c02', out: 'b03' },
+      { op: 'OR', in1: 'a03', in2: 'b03', out: 'z04' },
+    ];
+
+    for (let x = 0; x < 16; x++) {
+      for (let y = 0; y < 16; y++) {
+        const inputs: Record<string, number> = {};
+        for (let i = 0; i < 4; i++) {
+          inputs[`x0${i}`] = (x >> i) & 1;
+          inputs[`y0${i}`] = (y >> i) & 1;
+        }
+        const values = simulate(gates, inputs);
+        let sum = 0;
+        for (let j = 0; j < 5; j++) sum |= values[`z0${j}`] << j;
+        expect(sum).toBe(x + y);
+      }
+    }
+  });
+
+  it('adds correctly on a generated 45-bit adder', () => {
+    const bits = 45;
+    const rand = mulberry32(99);
+    const gates = buildAdder(bits, rand);
+    for (let trial = 0; trial < 25; trial++) {
+      let x = 0n;
+      let y = 0n;
+      const inputs: Record<string, number> = {};
+      for (let i = 0; i < bits; i++) {
+        const xi = rand() < 0.5 ? 1 : 0;
+        const yi = rand() < 0.5 ? 1 : 0;
+        inputs[`x${String(i).padStart(2, '0')}`] = xi;
+        inputs[`y${String(i).padStart(2, '0')}`] = yi;
+        if (xi) x |= 1n << BigInt(i);
+        if (yi) y |= 1n << BigInt(i);
+      }
+      const values = simulate(gates, inputs);
+      let sum = 0n;
+      for (let j = 0; j <= bits; j++) {
+        if (values[`z${String(j).padStart(2, '0')}`]) sum |= 1n << BigInt(j);
+      }
+      expect(sum).toBe(x + y);
+    }
+  });
+});
