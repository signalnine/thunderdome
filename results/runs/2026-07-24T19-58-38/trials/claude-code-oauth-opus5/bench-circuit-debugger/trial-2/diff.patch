diff --git a/src/reconstruct.ts b/src/reconstruct.ts
new file mode 100644
index 0000000..cb693d3
--- /dev/null
+++ b/src/reconstruct.ts
@@ -0,0 +1,241 @@
+import { AND, OR, XOR, type Circuit } from './circuit.js';
+import { bitOf, wireName } from './shape.js';
+
+/** Cap on branches explored, so a wildly non-adder input still returns. */
+const WALK_BUDGET = 500_000;
+
+interface Head {
+  half: number;
+  carry: number;
+  sum: number;
+}
+
+interface Tail {
+  gen: number;
+  prop: number;
+  merge: number;
+}
+
+/**
+ * Walks the adder stage by stage, repairing the wiring wherever it stops
+ * looking like an adder, and hands each complete repair to `accept`.
+ *
+ * This works because a swap only ever relabels gate *outputs*. Every gate's
+ * input wire names are exactly as the generator left them, so the circuit read
+ * from the input side is intact: the XOR and AND of `xNN`/`yNN` are always
+ * findable, and the two gates sharing a stage's (half-sum, carry-in) pair
+ * still share it. Walking that skeleton from bit 0 upwards, the carry chain
+ * says what each gate ought to emit, and a gate emitting anything else is one
+ * half of a swap — its partner being whichever gate holds the name it should
+ * have had.
+ *
+ * Where the walk can't tell which of two wires was renamed it tries both, so
+ * `accept` decides: it returns true for a repair it is happy with and the walk
+ * stops there. Returns false if no reading of the circuit satisfied it.
+ *
+ * `thorough` widens every stage to "any stage or OR gate nobody has claimed
+ * yet", which is needed when both of a stage's carry terms were renamed and so
+ * neither one can point at the other. It multiplies the branching, so it is
+ * worth a second pass rather than a first.
+ */
+export function reconstruct(
+  c: Circuit,
+  bits: number,
+  accept: () => boolean,
+  carryHolds: (stage: number, wire: number, driver: Int32Array) => boolean,
+  thorough = false,
+  deadline = Infinity,
+): boolean {
+  const byInputs = new Map<string, number>();
+  for (let g = 0; g < c.numGates; g++) {
+    const lo = Math.min(c.ina[g], c.inb[g]);
+    const hi = Math.max(c.ina[g], c.inb[g]);
+    byInputs.set(`${c.op[g]}:${lo}:${hi}`, g);
+  }
+  const gateFor = (op: number, a: number, b: number): number =>
+    byInputs.get(`${op}:${Math.min(a, b)}:${Math.max(a, b)}`) ?? -1;
+
+  /** the gate of that kind reading this wire, if there is exactly one */
+  const readerWithOp = (wire: number, op: number): number => {
+    let found = -1;
+    for (const g of c.consumers[wire]) {
+      if (c.op[g] !== op) continue;
+      if (found >= 0) return -1;
+      found = g;
+    }
+    return found;
+  };
+  const otherInput = (g: number, wire: number): number => (c.ina[g] === wire ? c.inb[g] : c.ina[g]);
+  const zWire = (bit: number): number => c.index.get(wireName(bit, 'z')) ?? -1;
+
+  const isPrimary = (w: number): boolean =>
+    bitOf(c.names[w], 'x') >= 0 || bitOf(c.names[w], 'y') >= 0;
+
+  const xorXY: number[] = [];
+  const andXY: number[] = [];
+  for (let i = 0; i < bits; i++) {
+    const x = c.index.get(wireName(i, 'x'));
+    const y = c.index.get(wireName(i, 'y'));
+    if (x === undefined || y === undefined) return false;
+    xorXY.push(gateFor(XOR, x, y));
+    andXY.push(gateFor(AND, x, y));
+    if (xorXY[i] < 0 || andXY[i] < 0) return false;
+  }
+
+  // The XOR/AND couples that read the same two internal wires: one per stage,
+  // and, like everything on the input side, immune to the swaps.
+  const stagePairs: number[] = [];
+  const partnerAnd = new Int32Array(c.numGates).fill(-1);
+  const merges: number[] = [];
+  for (let g = 0; g < c.numGates; g++) {
+    if (c.op[g] === OR) merges.push(g);
+    if (c.op[g] !== XOR || isPrimary(c.ina[g]) || isPrimary(c.inb[g])) continue;
+    const and = gateFor(AND, c.ina[g], c.inb[g]);
+    if (and < 0) continue;
+    stagePairs.push(g);
+    partnerAnd[g] = and;
+  }
+
+  const driver = new Int32Array(c.numWires).fill(-1);
+  for (let g = 0; g < c.numGates; g++) driver[c.out[g]] = g;
+
+  const undo: Array<[number, number]> = [];
+  /** makes `gate` emit `wire`, trading with whichever gate emits it today */
+  const reassign = (gate: number, wire: number): boolean => {
+    if (gate < 0 || wire < 0) return false;
+    const holder = driver[wire];
+    if (holder < 0) return false;
+    if (holder === gate) return true;
+    const had = c.out[gate];
+    c.out[gate] = wire;
+    c.out[holder] = had;
+    driver[wire] = gate;
+    driver[had] = holder;
+    undo.push([gate, holder]);
+    return true;
+  };
+  const rewind = (mark: number): void => {
+    while (undo.length > mark) {
+      const [gate, holder] = undo.pop() as [number, number];
+      const a = c.out[gate];
+      const b = c.out[holder];
+      c.out[gate] = b;
+      c.out[holder] = a;
+      driver[b] = gate;
+      driver[a] = holder;
+    }
+  };
+
+  const claimedPair = new Uint8Array(c.numGates);
+  const claimedMerge = new Uint8Array(c.numGates);
+  let budget = WALK_BUDGET;
+
+  const walk = (i: number, carryGate: number, carry: number): boolean => {
+    if (budget <= 0) return false;
+    // A finished walk costs far more than a step of one, since `accept` has to
+    // simulate; charge for it so the clock below is actually consulted.
+    budget -= i === bits ? 64 : 1;
+    if ((budget & 255) < 64 && Date.now() > deadline) return false;
+    if (i === bits) return accept();
+    const start = undo.length;
+
+    // Which gates form this stage's sum and propagate terms? Normally the pair
+    // reading (half-sum, carry-in) is right there. If not, one of those two
+    // names is stale, and whichever is still read by a XOR names the other.
+    const halfNow = c.out[xorXY[i]];
+    const heads: Head[] = [];
+    const seenHead = new Set<number>();
+    const addHead = (head: Head): void => {
+      const key = head.sum * c.numWires + head.half;
+      if (seenHead.has(key)) return;
+      seenHead.add(key);
+      heads.push(head);
+    };
+    const direct = gateFor(XOR, halfNow, carry);
+    if (direct >= 0) addHead({ half: halfNow, carry, sum: direct });
+    const viaHalf = readerWithOp(halfNow, XOR);
+    if (viaHalf >= 0) addHead({ half: halfNow, carry: otherInput(viaHalf, halfNow), sum: viaHalf });
+    const viaCarry = readerWithOp(carry, XOR);
+    if (viaCarry >= 0) addHead({ half: otherInput(viaCarry, carry), carry, sum: viaCarry });
+    if (thorough || heads.length === 0) {
+      for (const pair of stagePairs) {
+        if (claimedPair[pair]) continue;
+        addHead({ half: c.ina[pair], carry: c.inb[pair], sum: pair });
+        addHead({ half: c.inb[pair], carry: c.ina[pair], sum: pair });
+      }
+    }
+
+    for (const head of heads) {
+      rewind(start);
+      if (claimedPair[head.sum] || partnerAnd[head.sum] < 0) continue;
+      if (head.half !== halfNow && !reassign(xorXY[i], head.half)) continue;
+      if (head.carry !== carry && !reassign(carryGate, head.carry)) continue;
+      if (!reassign(head.sum, zWire(i))) continue;
+      const prop = partnerAnd[head.sum];
+
+      // Same question one level down for the OR that forms the carry out.
+      const afterHead = undo.length;
+      const genNow = c.out[andXY[i]];
+      const propNow = c.out[prop];
+      const tails: Tail[] = [];
+      const seenTail = new Set<number>();
+      const addTail = (tail: Tail): void => {
+        const key = tail.merge * c.numWires + tail.gen;
+        if (seenTail.has(key)) return;
+        seenTail.add(key);
+        tails.push(tail);
+      };
+      const merged = gateFor(OR, genNow, propNow);
+      if (merged >= 0) addTail({ gen: genNow, prop: propNow, merge: merged });
+      const viaProp = readerWithOp(propNow, OR);
+      if (viaProp >= 0) addTail({ gen: otherInput(viaProp, propNow), prop: propNow, merge: viaProp });
+      const viaGen = readerWithOp(genNow, OR);
+      if (viaGen >= 0) addTail({ gen: genNow, prop: otherInput(viaGen, genNow), merge: viaGen });
+      if (thorough || tails.length === 0) {
+        for (const merge of merges) {
+          if (claimedMerge[merge]) continue;
+          addTail({ gen: c.ina[merge], prop: c.inb[merge], merge });
+          addTail({ gen: c.inb[merge], prop: c.ina[merge], merge });
+        }
+      }
+
+      claimedPair[head.sum] = 1;
+      for (const tail of tails) {
+        rewind(afterHead);
+        if (claimedMerge[tail.merge]) continue;
+        if (tail.gen !== genNow && !reassign(andXY[i], tail.gen)) continue;
+        if (tail.prop !== propNow && !reassign(prop, tail.prop)) continue;
+
+        const last = i === bits - 1;
+        if (last && !reassign(tail.merge, zWire(bits))) continue;
+        // The carry this stage hands upwards is checkable against the real
+        // thing, which rules out a wrong reading here and now.
+        if (!carryHolds(i, c.out[tail.merge], driver)) continue;
+
+        claimedMerge[tail.merge] = 1;
+        const ok = last ? walk(i + 1, tail.merge, -1) : walk(i + 1, tail.merge, c.out[tail.merge]);
+        claimedMerge[tail.merge] = 0;
+        if (ok) {
+          claimedPair[head.sum] = 0;
+          return true;
+        }
+      }
+      claimedPair[head.sum] = 0;
+    }
+
+    rewind(start);
+    return false;
+  };
+
+  const start = undo.length;
+  // Bit 0 is a half adder: the XOR is the output bit, the AND is the carry.
+  if (reassign(xorXY[0], zWire(0))) {
+    if (bits === 1) {
+      if (reassign(andXY[0], zWire(1)) && accept()) return true;
+    } else if (walk(1, andXY[0], c.out[andXY[0]])) {
+      return true;
+    }
+  }
+  rewind(start);
+  return false;
+}
diff --git a/src/shape.ts b/src/shape.ts
