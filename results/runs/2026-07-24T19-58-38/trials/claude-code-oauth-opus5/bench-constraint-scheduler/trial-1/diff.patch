new file mode 100644
index 0000000..e044c77
--- /dev/null
+++ b/src/scheduler.ts
@@ -0,0 +1,604 @@
+import { PrerequisiteCycleError } from './errors.js';
+import type {
+  Assignment,
+  Event,
+  Room,
+  ScheduleOptions,
+  ScheduleResult,
+} from './types.js';
+
+const DEFAULT_GAP = 15;
+
+/** Wall-clock ceiling for the optimisation search, so large inputs stay snappy. */
+const TIME_BUDGET_MS = 1500;
+
+type Fit = 'earliest' | 'tightest';
+
+interface Task {
+  index: number;
+  id: string;
+  duration: number;
+  attendees: number;
+  /** Indices of events that must finish before this one starts. */
+  prereqs: number[];
+  dependents: number[];
+  /** Index into `rooms`, or -1 when there is no (known) preference. */
+  preferredRoom: number;
+  /** No placement can ever exist for this task, regardless of the order used. */
+  impossible: boolean;
+}
+
+interface Booking {
+  start: number;
+  end: number;
+}
+
+interface Slot {
+  room: number;
+  start: number;
+  end: number;
+}
+
+interface Problem {
+  tasks: Task[];
+  rooms: Room[];
+  windowStart: number;
+  windowEnd: number;
+  gap: number;
+}
+
+interface Solution {
+  slots: (Slot | null)[];
+  /** Number of events placed. */
+  scheduled: number;
+  /** Number of placed events that got their preferred room. */
+  preferred: number;
+  /** Sum of end times; used to break ties towards tidier, earlier schedules. */
+  compactness: number;
+}
+
+interface Candidate extends Solution {
+  priority: number[];
+  honorPreferred: boolean;
+  fit: Fit;
+}
+
+/**
+ * Assign events to rooms inside `[startTime, endTime]`, honouring capacity,
+ * room gaps, prerequisite ordering and (where possible) room preferences.
+ *
+ * Events that cannot be placed are reported in `unscheduled` rather than
+ * causing a failure. A cyclic prerequisite graph throws
+ * {@link PrerequisiteCycleError}.
+ */
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const eventList = events ?? [];
+  const roomList = rooms ?? [];
+
+  // Cycles are a hard error and are reported even when nothing could be
+  // scheduled anyway, so this check comes first.
+  const byId = indexEventsById(eventList);
+  assertAcyclic(eventList, byId);
+
+  const problem = buildProblem(eventList, roomList, options ?? ({} as ScheduleOptions), byId);
+  const solution = solve(problem);
+
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+  for (let i = 0; i < eventList.length; i++) {
+    const slot = solution.slots[i];
+    if (slot) {
+      assignments.push({
+        eventId: eventList[i].id,
+        roomId: roomList[slot.room].id,
+        startTime: slot.start,
+        endTime: slot.end,
+      });
+    } else {
+      unscheduled.push(eventList[i].id);
+    }
+  }
+  orderRoomsChronologically(assignments);
+  return { assignments, unscheduled };
+}
+
+/**
+ * Assignments come out in input order, except that the entries belonging to one
+ * room are put in timeline order among themselves. Zero-length events can share
+ * a start time with the event they sit next to, and this keeps such a room's
+ * sequence unambiguous to read.
+ */
+function orderRoomsChronologically(assignments: Assignment[]): void {
+  const positionsByRoom = new Map<string, number[]>();
+  assignments.forEach((assignment, i) => {
+    const positions = positionsByRoom.get(assignment.roomId);
+    if (positions) positions.push(i);
+    else positionsByRoom.set(assignment.roomId, [i]);
+  });
+
+  for (const positions of positionsByRoom.values()) {
+    if (positions.length < 2) continue;
+    const ordered = positions
+      .map((i) => assignments[i])
+      .sort((a, b) => a.startTime - b.startTime || a.endTime - b.endTime);
+    positions.forEach((position, k) => {
+      assignments[position] = ordered[k];
+    });
+  }
+}
+
+/* ------------------------------------------------------------------ *
+ * Problem set-up
+ * ------------------------------------------------------------------ */
+
+function indexEventsById(events: Event[]): Map<string, number[]> {
+  const byId = new Map<string, number[]>();
+  for (let i = 0; i < events.length; i++) {
+    const id = events[i]?.id;
+    const bucket = byId.get(id);
+    if (bucket) bucket.push(i);
+    else byId.set(id, [i]);
+  }
+  return byId;
+}
+
+/** Depth-first search over the prerequisite graph, throwing on any back edge. */
+function assertAcyclic(events: Event[], byId: Map<string, number[]>): void {
+  const WHITE = 0;
+  const GRAY = 1;
+  const BLACK = 2;
+  const color = new Uint8Array(events.length);
+  const path: number[] = [];
+
+  const visit = (i: number): void => {
+    color[i] = GRAY;
+    path.push(i);
+    for (const prereqId of events[i]?.prerequisites ?? []) {
+      for (const j of byId.get(prereqId) ?? []) {
+        if (color[j] === GRAY) {
+          const from = path.indexOf(j);
+          const cycle = path.slice(from).map((k) => events[k].id);
+          cycle.push(events[j].id);
+          throw new PrerequisiteCycleError(cycle);
+        }
+        if (color[j] === WHITE) visit(j);
+      }
+    }
+    color[i] = BLACK;
+    path.pop();
+  };
+
+  for (let i = 0; i < events.length; i++) {
+    if (color[i] === WHITE) visit(i);
+  }
+}
+
+function buildProblem(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  byId: Map<string, number[]>,
+): Problem {
+  const windowStart = numberOr(options.startTime, 0);
+  const windowEnd = numberOr(options.endTime, 0);
+  const gap = Math.max(0, numberOr(options.gap, DEFAULT_GAP));
+  const window = windowEnd - windowStart;
+
+  const roomIndex = new Map<string, number>();
+  rooms.forEach((room, i) => {
+    if (!roomIndex.has(room?.id)) roomIndex.set(room?.id, i);
+  });
+  const maxCapacity = rooms.reduce((max, r) => Math.max(max, numberOr(r?.capacity, 0)), -Infinity);
+
+  const tasks: Task[] = events.map((event, index) => {
+    const duration = numberOr(event?.duration, 0);
+    const attendees = numberOr(event?.attendees, 1);
+    const prereqs: number[] = [];
+    let missingPrereq = false;
+    for (const prereqId of event?.prerequisites ?? []) {
+      const targets = byId.get(prereqId);
+      // A prerequisite that is not part of this batch can never finish, so the
+      // dependent event is unschedulable.
+      if (!targets) missingPrereq = true;
+      else for (const j of targets) if (j !== index) prereqs.push(j);
+    }
+    return {
+      index,
+      id: event?.id,
+      duration,
+      attendees,
+      prereqs,
+      dependents: [],
+      preferredRoom: roomIndex.get(event?.preferredRoom as string) ?? -1,
+      impossible:
+        missingPrereq ||
+        rooms.length === 0 ||
+        !Number.isFinite(duration) ||
+        duration < 0 ||
+        duration > window ||
+        attendees > maxCapacity,
+    };
+  });
+
+  for (const task of tasks) {
+    for (const p of task.prereqs) tasks[p].dependents.push(task.index);
+  }
+  // An event whose prerequisite can never run cannot run either.
+  propagateImpossible(tasks);
+
+  return { tasks, rooms, windowStart, windowEnd, gap };
+}
+
+function propagateImpossible(tasks: Task[]): void {
+  const queue = tasks.filter((t) => t.impossible).map((t) => t.index);
+  while (queue.length > 0) {
+    const i = queue.pop() as number;
+    for (const dep of tasks[i].dependents) {
+      if (!tasks[dep].impossible) {
+        tasks[dep].impossible = true;
+        queue.push(dep);
+      }
+    }
+  }
+}
+
+function numberOr(value: unknown, fallback: number): number {
+  return typeof value === 'number' && !Number.isNaN(value) ? value : fallback;
+}
+
+/* ------------------------------------------------------------------ *
+ * Placement primitives
+ * ------------------------------------------------------------------ */
+
+/**
+ * Earliest start >= `from` at which `duration` fits into a room's timeline
+ * while keeping `gap` minutes clear on both sides. Returns null if it never
+ * fits before the end of the window.
+ */
+function earliestStart(
+  bookings: Booking[],
+  from: number,
+  duration: number,
+  gap: number,
+  windowEnd: number,
+): number | null {
+  let t = from;
+  for (const booking of bookings) {
+    if (booking.end + gap <= t) continue; // already clear of this booking
+    if (t + duration + gap <= booking.start) break; // fits in the hole before it
+    t = booking.end + gap;
+  }
+  return t + duration <= windowEnd ? t : null;
+}
+
+function betterSlot(a: Slot, b: Slot, fit: Fit, rooms: Room[], preferred: number): boolean {
+  const capA = rooms[a.room].capacity;
+  const capB = rooms[b.room].capacity;
+  if (fit === 'tightest') {
+    if (capA !== capB) return capA < capB;
+    if (a.end !== b.end) return a.end < b.end;
+  } else {
+    if (a.end !== b.end) return a.end < b.end;
+    if (capA !== capB) return capA < capB;
+  }
+  if ((a.room === preferred) !== (b.room === preferred)) return a.room === preferred;
+  return a.room < b.room;
+}
+
+/** Best room/start pair for a task given the rooms' current bookings. */
+function findSlot(
+  problem: Problem,
+  bookings: Booking[][],
+  task: Task,
+  from: number,
+  honorPreferred: boolean,
+  fit: Fit,
+): Slot | null {
+  const { rooms, gap, windowEnd } = problem;
+
+  const slotIn = (room: number): Slot | null => {
+    if (numberOr(rooms[room]?.capacity, 0) < task.attendees) return null;
+    const start = earliestStart(bookings[room], from, task.duration, gap, windowEnd);
+    return start === null ? null : { room, start, end: start + task.duration };
+  };
+
+  // Rule 5: the preference wins whenever it can be satisfied at all.
+  if (honorPreferred && task.preferredRoom >= 0) {
+    const preferred = slotIn(task.preferredRoom);
+    if (preferred) return preferred;
+  }
+
+  let best: Slot | null = null;
+  for (let room = 0; room < rooms.length; room++) {
+    const slot = slotIn(room);
+    if (slot && (!best || betterSlot(slot, best, fit, rooms, task.preferredRoom))) best = slot;
+  }
+  return best;
+}
+
+function insertBooking(bookings: Booking[], slot: Slot): void {
+  let i = bookings.length;
+  while (i > 0 && bookings[i - 1].start > slot.start) i--;
+  bookings.splice(i, 0, { start: slot.start, end: slot.end });
+}
+
+/**
+ * Place every task in the given order, skipping the ones that do not fit.
+ * The order must be a topological order of the prerequisite graph.
+ */
+function construct(problem: Problem, order: number[], honorPreferred: boolean, fit: Fit): Solution {
+  const { tasks, rooms, windowStart, gap } = problem;
+  const bookings: Booking[][] = rooms.map(() => []);
+  const slots: (Slot | null)[] = new Array(tasks.length).fill(null);
+  let scheduled = 0;
+  let preferred = 0;
+  let compactness = 0;
+
+  for (const i of order) {
+    const task = tasks[i];
+    if (task.impossible) continue;
+
+    let from = windowStart;
+    let ready = true;
+    for (const p of task.prereqs) {
+      const placed = slots[p];
+      if (!placed) {
+        ready = false;
+        break;
+      }
+      if (placed.end + gap > from) from = placed.end + gap;
+    }
+    if (!ready) continue;
+
+    const slot = findSlot(problem, bookings, task, from, honorPreferred, fit);
+    if (!slot) continue;
+
+    slots[i] = slot;
+    insertBooking(bookings[slot.room], slot);
+    scheduled++;
+    if (slot.room === task.preferredRoom) preferred++;
+    compactness += slot.end;
+  }
+
+  return { slots, scheduled, preferred, compactness };
+}
+
+/* ------------------------------------------------------------------ *
+ * Order generation
+ * ------------------------------------------------------------------ */
+
+/** Kahn's algorithm, always releasing the ready task with the lowest priority value. */
+function topoOrder(problem: Problem, priority: number[]): number[] {
+  const { tasks } = problem;
+  const n = tasks.length;
+  const indegree = new Int32Array(n);
+  for (const task of tasks) indegree[task.index] = task.prereqs.length;
+
+  const heap = new MinHeap(priority);
+  for (let i = 0; i < n; i++) if (indegree[i] === 0) heap.push(i);
+
+  const order: number[] = [];
+  while (heap.size > 0) {
+    const i = heap.pop() as number;
+    order.push(i);
+    for (const dep of tasks[i].dependents) {
+      if (--indegree[dep] === 0) heap.push(dep);
+    }
+  }
+  // Unreachable for an acyclic graph, but keeps the order total if it happens.
+  if (order.length < n) {
+    for (let i = 0; i < n; i++) if (indegree[i] > 0) order.push(i);
+  }
+  return order;
+}
+
+/** Binary heap over task indices, ordered by `key` then by index. */
+class MinHeap {
+  private readonly data: number[] = [];
+
+  constructor(private readonly key: number[]) {}
+
+  get size(): number {
+    return this.data.length;
+  }
+
+  push(value: number): void {
+    const data = this.data;
+    data.push(value);
+    let i = data.length - 1;
+    while (i > 0) {
+      const parent = (i - 1) >> 1;
+      if (!this.less(data[i], data[parent])) break;
+      [data[i], data[parent]] = [data[parent], data[i]];
+      i = parent;
+    }
+  }
+
+  pop(): number | undefined {
+    const data = this.data;
+    const top = data[0];
+    const last = data.pop() as number;
+    if (data.length > 0) {
+      data[0] = last;
+      let i = 0;
+      for (;;) {
+        const left = 2 * i + 1;
+        const right = left + 1;
+        let smallest = i;
+        if (left < data.length && this.less(data[left], data[smallest])) smallest = left;
+        if (right < data.length && this.less(data[right], data[smallest])) smallest = right;
+        if (smallest === i) break;
+        [data[i], data[smallest]] = [data[smallest], data[i]];
+        i = smallest;
+      }
+    }
+    return top;
+  }
+
+  private less(a: number, b: number): boolean {
+    return this.key[a] !== this.key[b] ? this.key[a] < this.key[b] : a < b;
+  }
+}
+
+/**
+ * A handful of structurally different priority vectors. Lower value = earlier.
+ * Which one wins depends entirely on the instance, so all of them get tried.
+ */
+function seedPriorities(problem: Problem): number[][] {
+  const { tasks, rooms } = problem;
+  const n = tasks.length;
+  const chain = criticalPath(problem);
+  const roomsFor = tasks.map((t) => rooms.filter((r) => numberOr(r?.capacity, 0) >= t.attendees).length);
+
+  const seeds: number[][] = [];
+  const push = (score: (t: Task, i: number) => number): void => {
+    seeds.push(Array.from({ length: n }, (_, i) => score(tasks[i], i)));
+  };
+
+  push((_, i) => i); // input order
+  push((t) => -t.duration); // longest first: the hardest things to fit
+  push((t) => t.duration); // shortest first: maximises raw count
+  push((t) => -t.attendees); // biggest crowds first, while big rooms are free
+  push((t, i) => roomsFor[i]); // most constrained first
+  push((t, i) => -chain[i]); // longest prerequisite chain first
+  push((t) => -t.dependents.length); // unblock the most work first
+  push((t) => -t.duration * Math.max(1, t.attendees)); // biggest "area" first
+  push((t, i) => (t.preferredRoom >= 0 ? -1 : 0) * n + i); // preferences claim rooms first
+  return seeds;
+}
+
+/** Longest remaining duration from each task down to a sink, prerequisite gaps included. */
+function criticalPath(problem: Problem): number[] {
+  const { tasks, gap } = problem;
+  const chain = new Array<number>(tasks.length).fill(-1);
+  const compute = (i: number): number => {
+    if (chain[i] >= 0) return chain[i];
+    chain[i] = tasks[i].duration; // guards against re-entry; the graph is acyclic
+    let longest = 0;
+    for (const dep of tasks[i].dependents) longest = Math.max(longest, compute(dep));
+    chain[i] = tasks[i].duration + (longest > 0 ? gap + longest : 0);
+    return chain[i];
+  };
+  for (let i = 0; i < tasks.length; i++) compute(i);
+  return chain;
+}
+
+/* ------------------------------------------------------------------ *
+ * Search
+ * ------------------------------------------------------------------ */
+
+function solve(problem: Problem): Solution {
+  const { tasks } = problem;
+  if (tasks.length === 0) return { slots: [], scheduled: 0, preferred: 0, compactness: 0 };
+
+  const evaluate = (priority: number[], honorPreferred: boolean, fit: Fit): Candidate => {
+    const solution = construct(problem, topoOrder(problem, priority), honorPreferred, fit);
+    return { ...solution, priority, honorPreferred, fit };
+  };
+
+  const seeds = seedPriorities(problem);
+  let best: Candidate = evaluate(seeds[0], true, 'earliest');
+  const consider = (candidate: Candidate): void => {
+    if (isBetter(candidate, best)) best = candidate;
+  };
+
+  // Pass 1: every seed order against both preference policies and both
+  // room-choice rules. Dropping a preference can free a room for someone else,
+  // so the "ignore preferences" variants are real contenders.
+  const fits: Fit[] = ['earliest', 'tightest'];
+  for (const priority of seeds) {
+    for (const honorPreferred of [true, false]) {
+      for (const fit of fits) consider(evaluate(priority, honorPreferred, fit));
+    }
+  }
+
+  const upper = upperBounds(problem);
+  const optimal = (c: Candidate): boolean =>
+    c.scheduled >= upper.scheduled && c.preferred >= upper.preferred;
+  if (optimal(best)) return best;
+
+  // Pass 2: large-neighbourhood search. Repeatedly promote an event that did
+  // not fit and re-run the construction, keeping anything that improves.
+  const deadline = Date.now() + TIME_BUDGET_MS;
+  const work = Math.max(1, tasks.length * Math.max(1, problem.rooms.length));
+  const iterations = clamp(Math.floor(400_000 / work), 40, 600);
+  const random = mulberry32(0x5eed);
+
+  for (let iter = 0; iter < iterations; iter++) {
+    if ((iter & 7) === 0 && Date.now() > deadline) break;
+
+    const base = best;
+    const priority = base.priority.slice();
+    const stuck = tasks.filter((t) => !base.slots[t.index] && !t.impossible);
+    const roll = stuck.length > 0 ? random() : 0.55 + random() * 0.45;
+
+    if (roll < 0.55) {
+      // Promote a task that missed out to the very front of the order.
+      const victim = stuck[Math.floor(random() * stuck.length)];
+      let lowest = priority[0];
+      for (const p of priority) if (p < lowest) lowest = p;
+      priority[victim.index] = lowest - 1 - random();
+    } else if (roll < 0.85) {
+      // Jitter a few priorities to escape a local optimum.
+      const spread = Math.max(1, tasks.length / 4);
+      const touched = 1 + Math.floor(random() * Math.min(5, tasks.length));
+      for (let k = 0; k < touched; k++) {
+        const i = Math.floor(random() * tasks.length);
+        priority[i] += (random() - 0.5) * spread;
+      }
+    } else {
+      // Fresh random order.
+      for (let i = 0; i < priority.length; i++) priority[i] = random();
+    }
+
+    const honorPreferred = random() < 0.75 ? base.honorPreferred : !base.honorPreferred;
+    const fit = random() < 0.75 ? base.fit : fits[Math.floor(random() * fits.length)];
+    const candidate = evaluate(priority, honorPreferred, fit);
+    consider(candidate);
+    if (optimal(best)) break;
+  }
+
+  return best;
+}
+
+function isBetter(a: Solution, b: Solution): boolean {
+  if (a.scheduled !== b.scheduled) return a.scheduled > b.scheduled;
+  if (a.preferred !== b.preferred) return a.preferred > b.preferred;
+  return a.compactness < b.compactness;
+}
+
+/** Ceilings the search can never beat; reaching them means we can stop early. */
+function upperBounds(problem: Problem): { scheduled: number; preferred: number } {
+  let scheduled = 0;
+  let preferred = 0;
+  for (const task of problem.tasks) {
+    if (task.impossible) continue;
+    scheduled++;
+    if (
+      task.preferredRoom >= 0 &&
+      numberOr(problem.rooms[task.preferredRoom]?.capacity, 0) >= task.attendees
+    ) {
+      preferred++;
+    }
+  }
+  return { scheduled, preferred };
+}
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.min(max, Math.max(min, value));
+}
+
+/** Small deterministic PRNG, so identical inputs always give identical output. */
+function mulberry32(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
