sk in the given order, skipping the ones that do not fit.\n * The order must be a topological order of the prerequisite graph.\n */\nfunction construct(problem: Problem, order: number[], honorPreferred: boolean, fit: Fit): Solution {\n  const { tasks, rooms, windowStart, gap } = problem;\n  const bookings: Booking[][] = rooms.map(() => []);\n  const slots: (Slot | null)[] = new Array(tasks.length).fill(null);\n  let scheduled = 0;\n  let preferred = 0;\n  let compactness = 0;\n\n  for (const i of order) {\n    const task = tasks[i];\n    if (task.impossible) continue;\n\n    let from = windowStart;\n    let ready = true;\n    for (const p of task.prereqs) {\n      const placed = slots[p];\n      if (!placed) {\n        ready = false;\n        break;\n      }\n      if (placed.end + gap > from) from = placed.end + gap;\n    }\n    if (!ready) continue;\n\n    const slot = findSlot(problem, bookings, task, from, honorPreferred, fit);\n    if (!slot) continue;\n\n    slots[i] = slot;\n    insertBooking(bookings[slot.room], slot);\n    scheduled++;\n    if (slot.room === task.preferredRoom) preferred++;\n    compactness += slot.end;\n  }\n\n  return { slots, scheduled, preferred, compactness };\n}\n\n/* ------------------------------------------------------------------ *\n * Order generation\n * ------------------------------------------------------------------ */\n\n/** Kahn's algorithm, always releasing the ready task with the lowest priority value. */\nfunction topoOrder(problem: Problem, priority: number[]): number[] {\n  const { tasks } = problem;\n  const n = tasks.length;\n  const indegree = new Int32Array(n);\n  for (const task of tasks) indegree[task.index] = task.prereqs.length;\n\n  const heap = new MinHeap(priority);\n  for (let i = 0; i < n; i++) if (indegree[i] === 0) heap.push(i);\n\n  const order: number[] = [];\n  while (heap.size > 0) {\n    const i = heap.pop() as number;\n    order.push(i);\n    for (const dep of tasks[i].dependents) {\n      if (--indegree[dep] === 0) heap.push(dep);\n    }\n  }\n  // Unreachable for an acyclic graph, but keeps the order total if it happens.\n  if (order.length < n) {\n    for (let i = 0; i < n; i++) if (indegree[i] > 0) order.push(i);\n  }\n  return order;\n}\n\n/** Binary heap over task indices, ordered by `key` then by index. */\nclass MinHeap {\n  private readonly data: number[] = [];\n\n  constructor(private readonly key: number[]) {}\n\n  get size(): number {\n    return this.data.length;\n  }\n\n  push(value: number): void {\n    const data = this.data;\n    data.push(value);\n    let i = data.length - 1;\n    while (i > 0) {\n      const parent = (i - 1) >> 1;\n      if (!this.less(data[i], data[parent])) break;\n      [data[i], data[parent]] = [data[parent], data[i]];\n      i = parent;\n    }\n  }\n\n  pop(): number | undefined {\n    const data = this.data;\n    const top = data[0];\n    const last = data.pop() as number;\n    if (data.length > 0) {\n      data[0] = last;\n      let i = 0;\n      for (;;) {\n        const left = 2 * i + 1;\n        const right = left + 1;\n        let smallest = i;\n        if (left < data.length && this.less(data[left], data[smallest])) smallest = left;\n        if (right < data.length && this.less(data[right], data[smallest])) smallest = right;\n        if (smallest === i) break;\n        [data[i], data[smallest]] = [data[smallest], data[i]];\n        i = smallest;\n      }\n    }\n    return top;\n  }\n\n  private less(a: number, b: number): boolean {\n    return this.key[a] !== this.key[b] ? this.key[a] < this.key[b] : a < b;\n  }\n}\n\n/**\n * A handful of structurally different priority vectors. Lower value = earlier.\n * Which one wins depends entirely on the instance, so all of them get tried.\n */\nfunction seedPriorities(problem: Problem): number[][] {\n  const { tasks, rooms } = problem;\n  const n = tasks.length;\n  const chain = criticalPath(problem);\n  const roomsFor = tasks.map((t) => rooms.filter((r) => numberOr(r?.