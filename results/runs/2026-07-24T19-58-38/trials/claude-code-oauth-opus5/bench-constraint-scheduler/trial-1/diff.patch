diff --git a/src/errors.ts b/src/errors.ts
new file mode 100644
index 0000000..5648bf7
--- /dev/null
+++ b/src/errors.ts
@@ -0,0 +1,14 @@
+/**
+ * Thrown when the prerequisite graph cannot be ordered because it contains a
+ * cycle (a self-reference `A -> A` counts as one).
+ */
+export class PrerequisiteCycleError extends Error {
+  /** The offending path, e.g. `['a', 'b', 'a']`. */
+  readonly cycle: string[];
+
+  constructor(cycle: string[]) {
+    super(`Prerequisite cycle detected: ${cycle.join(' -> ')}`);
+    this.name = 'PrerequisiteCycleError';
+    this.cycle = cycle;
+  }
+}
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..a35beb4
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,33 @@
+import { schedule as scheduleEvents } from './scheduler.js';
+import type { Event, Room, ScheduleOptions, ScheduleResult } from './types.js';
+
+export { schedule } from './scheduler.js';
+export { PrerequisiteCycleError } from './errors.js';
+export type { Assignment, Event, Room, ScheduleOptions, ScheduleResult } from './types.js';
+
+/**
+ * Object wrapper around {@link schedule}. Rooms and options may be supplied
+ * once to the constructor and reused, or passed per call.
+ */
+export class Scheduler {
+  constructor(
+    private readonly rooms: Room[] = [],
+    private readonly options?: ScheduleOptions,
+  ) {}
+
+  schedule(events: Event[], rooms?: Room[], options?: ScheduleOptions): ScheduleResult {
+    const resolvedRooms = rooms ?? this.rooms;
+    const resolvedOptions = options ?? this.options;
+    if (!resolvedOptions) {
+      throw new Error('Scheduler.schedule requires ScheduleOptions (startTime and endTime).');
+    }
+    return scheduleEvents(events, resolvedRooms, resolvedOptions);
+  }
+}
+
+/** Factory counterpart to {@link Scheduler}. */
+export function createScheduler(rooms: Room[] = [], options?: ScheduleOptions): Scheduler {
+  return new Scheduler(rooms, options);
+}
+
+export default scheduleEvents;
