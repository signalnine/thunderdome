+describe('cycles', () => {
+  const rms = rooms(['r1', 10]);
+
+  it('throws on a two-node cycle', () => {
+    const evts = [
+      event('a', 30, { prerequisites: ['b'] }),
+      event('b', 30, { prerequisites: ['a'] }),
+    ];
+    expect(() => schedule(evts, rms, NINE_TO_FIVE)).toThrow(PrerequisiteCycleError);
+    expect(() => schedule(evts, rms, NINE_TO_FIVE)).toThrow(/cycle/i);
+  });
+
+  it('throws on a self reference', () => {
+    const evts = [event('a', 30, { prerequisites: ['a'] })];
+    expect(() => schedule(evts, rms, NINE_TO_FIVE)).toThrow(/cycle/i);
+  });
+
+  it('throws on a longer cycle', () => {
+    const evts = [
+      event('a', 30, { prerequisites: ['c'] }),
+      event('b', 30, { prerequisites: ['a'] }),
+      event('c', 30, { prerequisites: ['b'] }),
+    ];
+    expect(() => schedule(evts, rms, NINE_TO_FIVE)).toThrow(PrerequisiteCycleError);
+  });
+
+  it('accepts a diamond, which is not a cycle', () => {
+    const evts = [
+      event('a', 30),
+      event('b', 30, { prerequisites: ['a'] }),
+      event('c', 30, { prerequisites: ['a'] }),
+      event('d', 30, { prerequisites: ['b', 'c'] }),
+    ];
+    const rms2 = rooms(['r1', 10], ['r2', 10]);
+    const result = schedule(evts, rms2, NINE_TO_FIVE);
+    expect(result.unscheduled).toEqual([]);
+    expectValid(result, evts, rms2, NINE_TO_FIVE);
+  });
+});
