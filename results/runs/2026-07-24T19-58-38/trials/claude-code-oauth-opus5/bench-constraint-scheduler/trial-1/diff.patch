+/** An event that needs a room and a slot in the day. */
+export interface Event {
+  id: string;
+  name: string;
+  /** Length of the event in minutes. */
+  duration: number;
+  /** Number of people attending. Defaults to 1. */
+  attendees?: number;
+  /** Event ids that must finish (plus the gap) before this one starts. */
+  prerequisites?: string[];
+  /** Room id the event would like to be in. A hint, not a hard constraint. */
+  preferredRoom?: string;
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number;
+}
+
+export interface ScheduleOptions {
+  /** Start of the schedulable window, in minutes from midnight. */
+  startTime: number;
+  /** End of the schedulable window, in minutes from midnight. */
+  endTime: number;
+  /** Minimum spacing between consecutive events in a room. Defaults to 15. */
+  gap?: number;
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  /** Ids of events that could not be placed, in input order. */
+  unscheduled: string[];
+}
diff --git a/tests/scheduler.test.ts b/tests/scheduler.test.ts
new file mode 100644
index 0000000..1ffd727
--- /dev/null
+++ b/tests/scheduler.test.ts
@@ -0,0 +1,373 @@
+import { describe, expect, it } from 'vitest';
+import schedule, {
+  createScheduler,
+  PrerequisiteCycleError,
+  Scheduler,
+  schedule as namedSchedule,
+} from '../src/index.js';
+import type { Event, Room, ScheduleOptions, ScheduleResult } from '../src/index.js';
+
+const rooms = (...specs: Array<[string, number]>): Room[] =>
+  specs.map(([id, capacity]) => ({ id, name: `Room ${id}`, capacity }));
+
+const event = (id: string, duration: number, extra: Partial<Event> = {}): Event => ({
+  id,
+  name: `Event ${id}`,
+  duration,
+  ...extra,
+});
+
+/** Asserts every scheduling rule holds for the produced result. */
+function expectValid(
+  result: ScheduleResult,
+  events: Event[],
+  roomList: Room[],
+  options: ScheduleOptions,
+): void {
+  const gap = options.gap ?? 15;
+  const byId = new Map(events.map((e) => [e.id, e]));
+  const placed = new Map(result.assignments.map((a) => [a.eventId, a]));
+
+  expect(result.assignments.length + result.unscheduled.length).toBe(events.length);
+  expect(new Set([...placed.keys(), ...result.unscheduled]).size).toBe(events.length);
+
+  for (const assignment of result.assignments) {
+    const source = byId.get(assignment.eventId) as Event;
+    const room = roomList.find((r) => r.id === assignment.roomId) as Room;
+    expect(room).toBeDefined();
+
+    // duration, window, capacity
+    expect(assignment.endTime - assignment.startTime).toBe(source.duration);
+    expect(assignment.startTime).toBeGreaterThanOrEqual(options.startTime);
+    expect(assignment.endTime).toBeLessThanOrEqual(options.endTime);
+    expect(source.attendees ?? 1).toBeLessThanOrEqual(room.capacity);
+
+    // prerequisites
+    for (const prereqId of source.prerequisites ?? []) {
+      const prereq = placed.get(prereqId);
+      expect(prereq, `prerequisite ${prereqId} of ${source.id} must be scheduled`).toBeDefined();
+      expect(assignment.startTime).toBeGreaterThanOrEqual((prereq as never as { endTime: number }).endTime + gap);
+    }
+  }
+
+  // room gaps
+  for (const room of roomList) {
+    const inRoom = result.assignments
+      .filter((a) => a.roomId === room.id)
+      .sort((a, b) => a.startTime - b.startTime);
+    for (let i = 1; i < inRoom.length; i++) {
+      expect(inRoom[i].startTime).toBeGreaterThanOrEqual(inRoom[i - 1].endTime + gap);
+    }
+  }
+}
+
+const NINE_TO_FIVE: ScheduleOptions = { startTime: 540, endTime: 1020 };
+
+describe('API surface', () => {
+  const evts = [event('a', 60)];
+  const rms = rooms(['r1', 10]);
+
+  it('exposes named, default, class and factory entry points', () => {
+    const expected = { assignments: [{ eventId: 'a', roomId: 'r1', startTime: 540, endTime: 600 }], unscheduled: [] };
+    expect(namedSchedule(evts, rms, NINE_TO_FIVE)).toEqual(expected);
+    expect(schedule(evts, rms, NINE_TO_FIVE)).toEqual(expected);
+    expect(new Scheduler(rms, NINE_TO_FIVE).schedule(evts)).toEqual(expected);
+    expect(createScheduler(rms, NINE_TO_FIVE).schedule(evts)).toEqual(expected);
+    expect(createScheduler().schedule(evts, rms, NINE_TO_FIVE)).toEqual(expected);
+  });
+
+  it('handles empty input', () => {
+    expect(schedule([], rms, NINE_TO_FIVE)).toEqual({ assignments: [], unscheduled: [] });
+    expect(schedule(evts, [], NINE_TO_FIVE)).toEqual({ assignments: [], unscheduled: ['a'] });
+  });
+});
+
+describe('capacity', () => {
+  it('only uses rooms big enough for the attendees', () => {
+    const evts = [event('big', 60, { attendees: 40 }), event('small', 60, { attendees: 2 })];
+    const rms = rooms(['tiny', 5], ['huge', 50]);
+    const result = schedule(evts, rms, NINE_TO_FIVE);
+
+    expect(result.unscheduled).toEqual([]);
+    expect(result.assignments.find((a) => a.eventId === 'big')?.roomId).toBe('huge');
+    expectValid(result, evts, rms, NINE_TO_FIVE);
+  });
+
+  it('leaves events nobody can host unscheduled', () => {
+    const evts = [event('crowd', 30, { attendees: 500 })];
+    const rms = rooms(['r1', 10]);
+    expect(schedule(evts, rms, NINE_TO_FIVE).unscheduled).toEqual(['crowd']);
+  });
+});
+
+describe('time window', () => {
+  it('rejects events longer than the window', () => {
+    const evts = [event('marathon', 600)];
+    const rms = rooms(['r1', 10]);
+    expect(schedule(evts, rms, NINE_TO_FIVE).unscheduled).toEqual(['marathon']);
+  });
+
+  it('keeps everything inside the window', () => {
+    const evts = Array.from({ length: 6 }, (_, i) => event(`e${i}`, 90));
+    const rms = rooms(['r1', 10], ['r2', 10]);
+    const options = { startTime: 0, endTime: 300 };
+    const result = schedule(evts, rms, options);
+    expectValid(result, evts, rms, options);
+  });
+});
+
+describe('room gaps', () => {
+  it('defaults to a 15 minute gap', () => {
+    const evts = [event('a', 60), event('b', 60)];
+    const rms = rooms(['r1', 10]);
+    const result = schedule(evts, rms, NINE_TO_FIVE);
+    const sorted = [...result.assignments].sort((x, y) => x.startTime - y.startTime);
+
+    expect(result.unscheduled).toEqual([]);
+    expect(sorted[1].startTime - sorted[0].endTime).toBeGreaterThanOrEqual(15);
+    expectValid(result, evts, rms, NINE_TO_FIVE);
+  });
+
+  it('honours a custom gap', () => {
+    const evts = [event('a', 60), event('b', 60), event('c', 60)];
+    const rms = rooms(['r1', 10]);
+    const options = { startTime: 540, endTime: 1020, gap: 45 };
+    expectValid(schedule(evts, rms, options), evts, rms, options);
+  });
+
+  it('keeps a room readable when zero-length events share a boundary', () => {
+    // A zero-length event may legitimately start where another one does when
+    // the gap is 0; the room's entries must still read in timeline order.
+    const rms = rooms(['r1', 10], ['r2', 10]);
+    for (const window of [60, 90, 120, 180]) {
+      const evts = [
+        event('long', 60),
+        event('zero', 0),
+        event('mid', 30),
+        event('zero2', 0),
+      ];
+      const options = { startTime: 0, endTime: window, gap: 0 };
+      const result = schedule(evts, rms, options);
+      expect(result.unscheduled).toEqual([]);
+      expectValid(result, evts, rms, options);
+    }
+  });
+
+  it('supports a zero gap', () => {
+    const evts = [event('a', 60), event('b', 60)];
+    const rms = rooms(['r1', 10]);
+    const options = { startTime: 0, endTime: 120, gap: 0 };
+    const result = schedule(evts, rms, options);
+    expect(result.unscheduled).toEqual([]);
+    expectValid(result, evts, rms, options);
+  });
+});
+
+describe('prerequisites', () => {
+  it('orders dependent events after their prerequisites, gap included', () => {
+    const evts = [
+      event('c', 30, { prerequisites: ['b'] }),
+      event('b', 30, { prerequisites: ['a'] }),
+      event('a', 30),
+    ];
+    const rms = rooms(['r1', 10], ['r2', 10]);
+    const result = schedule(evts, rms, NINE_TO_FIVE);
+    const at = (id: string) => result.assignments.find((a) => a.eventId === id) as { startTime: number; endTime: number };
+
+    expect(result.unscheduled).toEqual([]);
+    expect(at('b').startTime).toBeGreaterThanOrEqual(at('a').endTime + 15);
+    expect(at('c').startTime).toBeGreaterThanOrEqual(at('b').endTime + 15);
+    expectValid(result, evts, rms, NINE_TO_FIVE);
+  });
+
+  it('applies the gap across different rooms', () => {
+    const evts = [event('a', 30, { preferredRoom: 'r1' }), event('b', 30, { prerequisites: ['a'], preferredRoom: 'r2' })];
+    const rms = rooms(['r1', 10], ['r2', 10]);
+    const result = schedule(evts, rms, NINE_TO_FIVE);
+    const at = (id: string) => result.assignments.find((a) => a.eventId === id) as { startTime: number; endTime: number; roomId: string };
+
+    expect(at('a').roomId).toBe('r1');
+    expect(at('b').roomId).toBe('r2');
+    expect(at('b').startTime).toBeGreaterThanOrEqual(at('a').endTime + 15);
+  });
+
+  it('drops dependents when the prerequisite cannot be scheduled', () => {
+    const evts = [event('a', 30, { attendees: 100 }), event('b', 30, { prerequisites: ['a'] })];
+    const rms = rooms(['r1', 10]);
+    const result = schedule(evts, rms, NINE_TO_FIVE);
+    expect(result.assignments).toEqual([]);
+    expect(result.unscheduled.sort()).toEqual(['a', 'b']);
+  });
+
+  it('drops events whose prerequisite is not in the batch', () => {
+    const evts = [event('b', 30, { prerequisites: ['ghost'] })];
+    const rms = rooms(['r1', 10]);
+    expect(schedule(evts, rms, NINE_TO_FIVE).unscheduled).toEqual(['b']);
+  });
+
+  it('leaves no room for a chain that outgrows the window', () => {
+    const evts = [
+      event('a', 100),
+      event('b', 100, { prerequisites: ['a'] }),
+      event('c', 100, { prerequisites: ['b'] }),
+    ];
+    const rms = rooms(['r1', 10], ['r2', 10]);
+    const options = { startTime: 0, endTime: 250 };
+    const result = schedule(evts, rms, options);
+    expect(result.unscheduled).toEqual(['c']);
+    expectValid(result, evts, rms, options);
+  });
+});
