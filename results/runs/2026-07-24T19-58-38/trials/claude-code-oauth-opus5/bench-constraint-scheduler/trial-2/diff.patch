) => a.startTime - b.startTime);\n    for (let i = 1; i < inRoom.length; i++) {\n      expect(inRoom[i].startTime).toBeGreaterThanOrEqual(inRoom[i - 1].endTime + gap);\n    }\n  }\n\n  for (const a of result.assignments) {\n    const event = eventById.get(a.eventId) as Event;\n    for (const prereqId of event.prerequisites ?? []) {\n      if (!eventById.has(prereqId)) continue;\n      const prereq = byId(result, prereqId);\n      expect(prereq).toBeDefined();\n      expect((prereq as Assignment).endTime + gap).toBeLessThanOrEqual(a.startTime);\n    }\n  }\n}\n\ndescribe('API surface', () => {\n  it('exposes named, default, class and factory entry points', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 60 }];\n\n    expect(schedule(events, ROOMS, DAY).assignments).toHaveLength(1);\n    expect(schedulerDefault(events, ROOMS, DAY).assignments).toHaveLength(1);\n    expect(new Scheduler(DAY).schedule(events, ROOMS).assignments).toHaveLength(1);\n    expect(createScheduler(DAY).schedule(events, ROOMS).assignments).toHaveLength(1);\n  });\n\n  it('handles empty input', () => {\n    expect(schedule([], ROOMS, DAY)).toEqual({ assignments: [], unscheduled: [] });\n  });\n});\n\ndescribe('basic placement', () => {\n  it('places events inside the window with the requested duration', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 90 },\n    ];\n    const result = schedule(events, ROOMS, DAY);\n\n    expect(result.unscheduled).toEqual([]);\n    assertValid(result, events, ROOMS, DAY);\n  });\n\n  it('keeps the default 15 minute gap between events in one room', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60 },\n      { id: 'c', name: 'C', duration: 60 },\n    ];\n    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];\n    const result = schedule(events, rooms, DAY);\n\n    expect(result.unscheduled).toEqual([]);\n    assertValid(result, events, rooms, DAY);\n  });\n\n  it('honours a custom gap', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60 },\n    ];\n    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];\n    const options = { ...DAY, gap: 45 };\n    const result = schedule(events, rooms, options);\n\n    assertValid(result, events, rooms, options);\n    expect((byId(result, 'b') as Assignment).startTime).toBeGreaterThanOrEqual(\n      (byId(result, 'a') as Assignment).endTime + 45,\n    );\n  });\n\n  it('supports a zero gap', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 240 },\n      { id: 'b', name: 'B', duration: 240 },\n    ];\n    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];\n    const options = { startTime: 540, endTime: 1020, gap: 0 };\n    const result = schedule(events, rooms, options);\n\n    expect(result.unscheduled).toEqual([]);\n    assertValid(result, events, rooms, options);\n  });\n});\n\ndescribe('capacity', () => {\n  it('routes large events to rooms that can hold them', () => {\n    const events: Event[] = [{ id: 'all-hands', name: 'All hands', duration: 60, attendees: 40 }];\n    const result = schedule(events, ROOMS, DAY);\n\n    expect((byId(result, 'all-hands') as Assignment).roomId).toBe('large');\n  });\n\n  it('leaves events that exceed every room unscheduled', () => {\n    const events: Event[] = [\n      { id: 'huge', name: 'Huge', duration: 60, attendees: 500 },\n      { id: 'ok', name: 'OK', duration: 60, attendees: 2 },\n    ];\n    const result = schedule(events, ROOMS, DAY);\n\n    expect(result.unscheduled).toEqual(['huge']);\n    expect(byId(result, 'ok')).toBeDefined();\n  });\n\n  it('treats a missing attendee count as one person', () => {\n    const rooms: Room[] = [{ id: 'tiny', name: 'Tiny', capacity: 1 }];\n    const result = schedule([{ id: 'a', name: 'A', duration: 30 }], rooms, DAY);\n\n    expect(result.assignments).toHaveLength(1);\n  });\n});\n\ndescribe('time window', () => {\n  it('does not schedule past the end of the window', () => {\n    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 200 },\n      { id: 'b', name: 'B', duration: 200 },\n    ];\n    const options = { startTime: 540, endTime: 800 };\n    const result = schedule(events, rooms, options);\n\n    expect(result.assignments).toHaveLength(1);\n    expect(result.unscheduled).toHaveLength(1);\n    assertValid(result, events, rooms, options);\n  });\n\n  it('rejects events longer than the whole window', () => {\n    const result = schedule(\n      [{ id: 'marathon', name: 'Marathon', duration: 1000 }],\n      ROOMS,\n      DAY,\n    );\n\n    expect(result.unscheduled).toEqual(['marathon']);\n    expect(result.assignments).toEqual([]);\n  });\n});\n\ndescribe('prerequisites', () => {\n  it('orders dependents after their prerequisites, with the gap', () => {\n    const events: Event[] = [\n      { id: 'talk', name: 'Talk', duration: 60, prerequisites: ['setup'] },\n      { id: 'setup', name: 'Setup', duration: 30 },\n      { id: 'teardown', name: 'Teardown', duration: 30, prerequisites: ['talk'] },\n    ];\n    const result = schedule(events, ROOMS, DAY);\n\n    expect(result.unscheduled).toEqual([]);\n    assertValid(result, events, ROOMS, DAY);\n    expect(result.assignments.map((a) => a.eventId)).toEqual([\n      'setup',\n      'talk',\n      'teardown',\n    ]);\n  });\n\n  it('applies prerequisite ordering across different rooms', () => {\n    const rooms: Room[] = [\n      { id: 'r1', name: 'R1', capacity: 10 },\n      { id: 'r2', name: 'R2', capacity: 10 },\n    ];\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, preferredRoom: 'r1' },\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'], preferredRoom: 'r2' },\n    ];\n    const result = schedule(events, rooms, DAY);\n\n    assertValid(result, events, rooms, DAY);\n    expect((byId(result, 'b') as Assignment).startTime).toBeGreaterThanOrEqual(\n      (byId(result, 'a') as Assignment).endTime + 15,\n    );\n  });\n\n  it('drops dependents whose prerequisite cannot be scheduled', () => {\n    const events: Event[] = [\n      { id: 'huge', name: 'Huge', duration: 60, attendees: 999 },\n      { id: 'after', name: 'After', duration: 60, prerequisites: ['huge'] },\n    ];\n    const result = schedule(events, ROOMS, DAY);\n\n    expect(result.unscheduled.sort()).toEqual(['after', 'huge']);\n    expect(result.assignments).toEqual([]);\n  });\n\n  it('handles a deep chain', () => {\n    const events: Event[] = Array.from({ length: 6 }, (_, i) => ({\n      id: `e${i}`,\n      name: `E${i}`,\n      duration: 30,\n      prerequisites: i === 0 ? [] : [`e${i - 1}`],\n    }));\n    const result = schedule(events, ROOMS, DAY);\n\n    expect(result.unscheduled).toEqual([]);\n    assertValid(result, events, ROOMS, DAY);\n  });\n\n  it('ignores prerequisite IDs that are not part of the batch', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, prerequisites: ['ghost'] },\n    ];\n    const result = schedule(events, ROOMS, DAY);\n\n    expect(result.assignments).toHaveLength(1);\n  });\n});\n\ndescribe('prerequisite cycles', () => {\n  it('throws on a two-event cycle', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 30, prerequisites: ['b'] },\n      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },\n    ];\n\n    expect(() => schedule(events, ROOMS, DAY)).toThrow(/cycle/i);\n  });\n\n  it('throws on a self reference', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 30, prerequisites: ['a'] },\n    ];\n\n    expect(() => schedule(events, ROOMS, DAY)).toThrow(/cycle/i);\n  });\n\n  it('throws on a longer cycle even when other events are fine', () => {\n    const events: Event[] = [\n      { id: 'ok', name: 'OK', duration: 30 },\n      { id: 'a', name: 'A', duration: 30, prerequisites: ['c'] },\n      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 30, prerequisites: ['b'] },\n    ];\n\n    expect(() => schedule(events, ROOMS, DAY)).toThrow(/cycle/i);\n  });\n});\n\ndescribe('preferred rooms', () => {\n  it('honours the preference when it is feasible', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, preferredRoom: 'large' },\n      { id: 'b', name: 'B', duration: 60, preferredRoom: 'small' },\n    ];\n    const result = schedule(events, ROOMS, DAY);\n\n    expect((byId(result, 'a') as Assignment).roomId).toBe('large');\n    expect((byId(result, 'b') as Assignment).roomId).toBe('small');\n  });\n\n  it('falls back to another room when the preference cannot hold the event', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, attendees: 30, preferredRoom: 'small' },\n    ];\n    const result = schedule(events, ROOMS, DAY);\n\n    expect((byId(result, 'a') as Assignment).roomId).toBe('large');\n  });\n\n  it('ignores an unknown preferred room', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, preferredRoom: 'does-not-exist' },\n    ];\n    const result = schedule(events, ROOMS, DAY);\n\n    expect(result.assignments).toHaveLength(1);\n  });\n\n  it('never sacrifices a placement to satisfy a preference', () => {\n    const rooms: Room[] = [\n      { id: 'r1', name: 'R1', capacity: 10 },\n      { id: 'r2', name: 'R2', capacity: 10 },\n    ];\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 200, preferredRoom: 'r1' },\n      { id: 'b', name: 'B', duration: 200, preferredRoom: 'r1' },\n    ];\n    const options = { startTime: 540, endTime: 780 };\n    const result = schedule(events, rooms, options);\n\n    expect(result.unscheduled).toEqual([]);\n    assertValid(result, events, rooms, options);\n  });\n});\n\ndescribe('batch optimisation', () => {\n  it('packs a tight two-room instance that defeats naive first-fit', () => {\n    const rooms: Room[] = [\n      { id: 'r1', name: 'R1', capacity: 10 },\n      { id: 'r2', name: 'R2', capacity: 10 },\n    ];\n    // 240 minutes per room; 60+60 and 105+105 pack exactly with a 15m gap.\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 105 },\n      { id: 'c', name: 'C', duration: 60 },\n      { id: 'd', name: 'D', duration: 105 },\n    ];\n    const options = { startTime: 540, endTime: 780 };\n    const result = schedule(events, rooms, options);\n\n    expect(result.unscheduled).toEqual([]);\n    assertValid(result, events, rooms, options);\n  });\n\n  it('uses capacity wisely so small events do not hog the big room', () => {\n    const rooms: Room[] = [\n      { id: 'small', name: 'Small', capacity: 4 },\n      { id: 'big', name: 'Big', capacity: 40 },\n    ];\n    const options = { startTime: 540, endTime: 660, gap: 0 };\n    const events: Event[] = [\n      { id: 'tiny', name: 'Tiny', duration: 120, attendees: 2 },\n      { id: 'party', name: 'Party', duration: 120, attendees: 30 },\n    ];\n    const result = schedule(events, rooms, options);\n\n    expect(result.unscheduled).toEqual([]);\n    expect((byId(result, 'party') as Assignment).roomId).toBe('big');\n    expect((byId(result, 'tiny') as Assignment).roomId).toBe('small');\n  });\n\n  it('maximises placements when not everything fits', () => {\n    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];\n    const options = { startTime: 540, endTime: 720, gap: 15 };\n    const events: Event[] = [\n      { id: 'long', name: 'Long', duration: 180 },\n      { id: 's1', name: 'S1', duration: 60 },\n      { id: 's2', name: 'S2', duration: 60 },\n    ];\n    const result = schedule(events, rooms, options);\n\n    // Dropping 'long' lets both short events fit (60 + 15 + 60 = 135 <= 180).\n    expect(result.assignments).toHaveLength(2);\n    expect(result.unscheduled).toEqual(['long']);\n    assertValid(result, events, rooms, options);\n  });\n\n  it('is deterministic across runs', () => {\n    const events: Event[] = Array.from({ length: 12 }, (_, i) => ({\n      id: `e${i}`,\n      name: `E${i}`,\n      duration: 30 + (i % 4) * 20,\n      attendees: 1 + (i % 3) * 10,\n      prerequisites: i > 3 && i % 3 === 0 ? [`e${i - 3}`] : [],\n    }));\n    const rooms: Room[] = [\n      { id: 'a', name: 'A', capacity: 5 },\n      { id: 'b', name: 'B', capacity: 20 },\n      { id: 'c', name: 'C', capacity: 40 },\n    ];\n\n    const first = schedule(events, rooms, DAY);\n    const second = schedule(events, rooms, DAY);\n    expect(second).toEqual(first);\n    assertValid(first, events, rooms, DAY);\n  });\n});\n\ndescribe('degenerate input', () => {\n  it('marks everything unscheduled when there are no rooms', () => {\n    const result = schedule([{ id: 'a', name: 'A', duration: 30 }], [], DAY);\n\n    expect(result.assignments).toEqual([]);\n    expect(result.unscheduled).toEqual(['a']);\n  });\n\n  it('handles a zero-length window', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 0 },\n      { id: 'b', name: 'B', duration: 30 },\n    ];\n    const options = { startTime: 540, endTime: 540 };\n    const result = schedule(events, ROOMS, options);\n\n    expect(result.unscheduled).toEqual(['b']);\n    assertValid(result, events, ROOMS, options);\n  });\n\n  it('scales to a larger batch within the time limit', () => {\n    const events: Event[] = Array.from({ length: 120 }, (_, i) => ({\n      id: `e${i}`,\n      name: `E${i}`,\n      duration: 20 + (i % 5) * 10,\n      attendees: 1 + (i % 7) * 5,\n      preferredRoom: i % 4 === 0 ? 'r0' : undefined,\n      prerequisites: i > 10 && i % 10 === 0 ? [`e${i - 10}`] : [],\n    }));\n    const rooms: Room[] = Array.from({ length: 6 }, (_, i) => 