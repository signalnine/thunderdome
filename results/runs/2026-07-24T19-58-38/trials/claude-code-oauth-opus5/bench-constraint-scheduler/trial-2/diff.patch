@@ -0,0 +1,52 @@
+/**
+ * Public data model for the constraint-based event scheduler.
+ */
+
+/** A single event to be placed into a room at a point in time. */
+export interface Event {
+  id: string;
+  name: string;
+  /** Length of the event, in minutes. */
+  duration: number;
+  /** Number of people attending. Defaults to 1 when omitted. */
+  attendees?: number;
+  /** IDs of events that must finish (plus the gap) before this one starts. */
+  prerequisites?: string[];
+  /** Room ID this event would like to use. A hint, not a hard constraint. */
+  preferredRoom?: string;
+}
+
+/** A room events can be assigned to. */
+export interface Room {
+  id: string;
+  name: string;
+  /** Maximum number of attendees the room can hold. */
+  capacity: number;
+}
+
+/** Global constraints for a scheduling run. */
+export interface ScheduleOptions {
+  /** Start of the schedulable window, in minutes from midnight (540 = 9:00 AM). */
+  startTime: number;
+  /** End of the schedulable window, in minutes from midnight (1020 = 5:00 PM). */
+  endTime: number;
+  /** Minimum minutes between two events sharing a room. Defaults to 15. */
+  gap?: number;
+}
+
+/** A placed event. */
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  /** Minutes from midnight. */
+  startTime: number;
+  /** Minutes from midnight; always `startTime + event.duration`. */
+  endTime: number;
+}
+
+/** The outcome of a scheduling run. */
+export interface ScheduleResult {
+  assignments: Assignment[];
+  /** IDs of events that could not be placed without violating a constraint. */
+  unscheduled: string[];
+}
