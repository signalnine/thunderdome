+++ b/src/index.ts
@@ -0,0 +1,41 @@
+import { schedule } from './scheduler.js';
+import type { Event, Room, ScheduleOptions, ScheduleResult } from './types.js';
+
+export { schedule, DEFAULT_GAP, PrerequisiteCycleError } from './scheduler.js';
+export type {
+  Assignment,
+  Event,
+  Room,
+  ScheduleOptions,
+  ScheduleResult,
+} from './types.js';
+
+/**
+ * Object-oriented wrapper around {@link schedule}. Options given to the
+ * constructor act as defaults and can be overridden per call.
+ */
+export class Scheduler {
+  private readonly defaults: Partial<ScheduleOptions>;
+
+  constructor(defaults: Partial<ScheduleOptions> = {}) {
+    this.defaults = defaults;
+  }
+
+  schedule(
+    events: Event[],
+    rooms: Room[],
+    options?: Partial<ScheduleOptions>,
+  ): ScheduleResult {
+    return schedule(events, rooms, {
+      ...this.defaults,
+      ...options,
+    } as ScheduleOptions);
+  }
+}
+
+/** Factory counterpart to {@link Scheduler}. */
+export function createScheduler(defaults: Partial<ScheduleOptions> = {}): Scheduler {
+  return new Scheduler(defaults);
+}
+
+export default schedule;
diff --git a/src/scheduler.ts b/src/scheduler.ts
new file mode 100644
index 0000000..db23f75
--- /dev/null
+++ b/src/scheduler.ts
@@ -0,0 +1,866 @@
+import type {
+  Assignment,
+  Event,
+  Room,
+  ScheduleOptions,
+  ScheduleResult,
+} from './types.js';
+
+/** Default minimum gap (minutes) between two events in the same room. */
+export const DEFAULT_GAP = 15;
+
+/** Wall-clock budget for the optimisation phases. */
+const TIME_BUDGET_MS = 1500;
+/** Hard cap on branch-and-bound nodes, as a backstop for pathological inputs. */
+const NODE_BUDGET = 250_000;
+/** Largest instance we are willing to hand to the exhaustive search. */
+const BNB_MAX_EVENTS = 18;
+/** Start times considered per room at each branch-and-bound node. */
+const BNB_STARTS_PER_ROOM = 4;
+
+/**
+ * Thrown when the prerequisite graph contains a cycle (including `A -> A`).
+ */
+export class PrerequisiteCycleError extends Error {
+  /** The offending path, e.g. `['a', 'b', 'a']`. */
+  readonly cycle: string[];
+
+  constructor(cycle: string[]) {
+    super(`Prerequisite cycle detected: ${cycle.join(' -> ')}`);
+    this.name = 'PrerequisiteCycleError';
+    this.cycle = cycle;
+  }
+}
+
+interface PreparedEvent {
+  index: number;
+  id: string;
+  duration: number;
+  attendees: number;
+  /** Prerequisite event indices; unknown IDs are dropped. */
+  prereqs: number[];
+  /** Index into the room list, or -1 when absent/unknown. */
+  preferredRoom: number;
+  /** Room indices with sufficient capacity, ordered by capacity ascending. */
+  feasibleRooms: number[];
+  /** False when the event can never be placed, whatever else happens. */
+  placeable: boolean;
+  /** Number of transitive dependents; used to prioritise long chains. */
+  dependents: number;
+}
+
+interface Interval {
+  start: number;
+  end: number;
+}
+
+interface Context {
+  events: PreparedEvent[];
+  rooms: Room[];
+  windowStart: number;
+  windowEnd: number;
+  gap: number;
+  deadline: number;
+}
+
+/** One candidate schedule. Arrays are indexed by event index. */
+interface Solution {
+  room: Int32Array;
+  start: Int32Array;
+  end: Int32Array;
+  count: number;
+  /** How many `preferredRoom` hints were honoured. */
+  preferred: number;
+  /** Sum of end times; lower is a more compact schedule. */
+  compactness: number;
+}
+
+interface Strategy {
+  honorPreferred: boolean;
+  /** `first` takes the first room that fits, `earliest` the earliest slot. */
+  mode: 'first' | 'earliest';
+  roomOrder: 'capAsc' | 'capDesc';
+}
+
+const STRATEGIES: Strategy[] = [
+  { honorPreferred: true, mode: 'earliest', roomOrder: 'capAsc' },
+  { honorPreferred: true, mode: 'first', roomOrder: 'capAsc' },
+  { honorPreferred: true, mode: 'first', roomOrder: 'capDesc' },
+  { honorPreferred: true, mode: 'earliest', roomOrder: 'capDesc' },
+  { honorPreferred: false, mode: 'earliest', roomOrder: 'capAsc' },
+  { honorPreferred: false, mode: 'first', roomOrder: 'capAsc' },
+];
+
+/**
+ * Assign events to rooms inside `[startTime, endTime]`, honouring capacity,
+ * room gaps, prerequisite ordering and (softly) room preferences.
+ *
+ * The scheduler maximises the number of placed events: it runs a portfolio of
+ * greedy passes over different event orderings, repairs the leftovers, and
+ * finishes with a bounded branch-and-bound search on small instances.
+ *
+ * @throws {PrerequisiteCycleError} if the prerequisite graph has a cycle.
+ */
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const eventList = Array.isArray(events) ? events : [];
+  const roomList = Array.isArray(rooms) ? rooms : [];
+
+  const windowStart = finiteOr(options?.startTime, 0);
+  const rawEnd = finiteOr(options?.endTime, 24 * 60);
+  const windowEnd = Math.max(windowStart, rawEnd);
+  const gap = Math.max(0, finiteOr(options?.gap, DEFAULT_GAP));
+
+  const prepared = prepare(eventList, roomList, windowStart, windowEnd);
+
+  const cycle = findCycle(prepared);
+  if (cycle) {
+    throw new PrerequisiteCycleError(cycle.map((i) => prepared[i].id));
+  }
+
+  if (prepared.length === 0) {
+    return { assignments: [], unscheduled: [] };
+  }
+
+  const ctx: Context = {
+    events: prepared,
+    rooms: roomList,
+    windowStart,
+    windowEnd,
+    gap,
+    deadline: Date.now() + TIME_BUDGET_MS,
+  };
+
+  const best = optimise(ctx);
+  return buildResult(ctx, best, eventList);
+}
+
+/* -------------------------------------------------------------------------- */
+/* Preparation                                                                 */
+/* -------------------------------------------------------------------------- */
+
+function finiteOr(value: number | undefined, fallback: number): number {
+  return typeof value === 'number' && Number.isFinite(value) ? value : fallback;
+}
+
+function prepare(
+  events: Event[],
+  rooms: Room[],
+  windowStart: number,
+  windowEnd: number,
+): PreparedEvent[] {
+  const indexById = new Map<string, number>();
+  events.forEach((event, i) => {
+    if (event && !indexById.has(event.id)) indexById.set(event.id, i);
+  });
+
+  const roomIndexById = new Map<string, number>();
+  rooms.forEach((room, i) => {
+    if (room && !roomIndexById.has(room.id)) roomIndexById.set(room.id, i);
+  });
+
+  const byCapacity = rooms
+    .map((room, i) => ({ capacity: finiteOr(room?.capacity, 0), i }))
+    .sort((a, b) => a.capacity - b.capacity || a.i - b.i);
+
+  const windowLength = windowEnd - windowStart;
+
+  const prepared = events.map((event, index): PreparedEvent => {
+    const duration = finiteOr(event?.duration, 0);
+    const attendees = finiteOr(event?.attendees, 1);
+
+    const prereqs: number[] = [];
+    for (const id of event?.prerequisites ?? []) {
+      // Unknown prerequisite IDs reference nothing that can conflict, so they
+      // impose no constraint.
+      const target = indexById.get(id);
+      if (target !== undefined && !prereqs.includes(target)) prereqs.push(target);
+    }
+
+    const feasibleRooms = byCapacity
+      .filter((r) => attendees <= r.capacity)
+      .map((r) => r.i);
+
+    const preferredRoom =
+      event?.preferredRoom !== undefined
+        ? roomIndexById.get(event.preferredRoom) ?? -1
+        : -1;
+
+    const placeable =
+      duration >= 0 && duration <= windowLength && feasibleRooms.length > 0;
+
+    return {
+      index,
+      id: event?.id ?? String(index),
+      duration,
+      attendees,
+      prereqs,
+      preferredRoom,
+      feasibleRooms,
+      placeable,
+      dependents: 0,
+    };
+  });
+
+  countDependents(prepared);
+  return prepared;
+}
+
+/**
+ * Number of transitive dependents per event, so that events blocking long
+ * chains can be scheduled first. Falls back to direct dependents on large
+ * inputs, where the transitive closure gets expensive.
+ */
+function countDependents(events: PreparedEvent[]): void {
+  const n = events.length;
+  const dependentsOf: number[][] = events.map(() => []);
+  for (const event of events) {
+    for (const p of event.prereqs) dependentsOf[p].push(event.index);
+  }
+
+  if (n > 400) {
+    for (let i = 0; i < n; i++) events[i].dependents = dependentsOf[i].length;
+    return;
+  }
+
+  for (let i = 0; i < n; i++) {
+    const seen = new Set<number>();
+    const stack = [...dependentsOf[i]];
+    while (stack.length) {
+      const node = stack.pop() as number;
+      if (seen.has(node)) continue;
+      seen.add(node);
+      stack.push(...dependentsOf[node]);
+    }
+    events[i].dependents = seen.size;
+  }
+}
+
+/**
+ * Iterative DFS returning a cycle as a list of event indices (`a -> b -> a`),
+ * or null when the graph is acyclic.
+ */
+function findCycle(events: PreparedEvent[]): number[] | null {
+  const WHITE = 0;
+  const GRAY = 1;
+  const BLACK = 2;
+  const color = new Uint8Array(events.length);
+  const parent = new Int32Array(events.length).fill(-1);
+
+  for (let root = 0; root < events.length; root++) {
+    if (color[root] !== WHITE) continue;
+    color[root] = GRAY;
+    const stack: Array<{ node: number; next: number }> = [{ node: root, next: 0 }];
+
+    while (stack.length) {
+      const frame = stack[stack.length - 1];
+      const prereqs = events[frame.node].prereqs;
+      if (frame.next < prereqs.length) {
+        const child = prereqs[frame.next++];
+        if (color[child] === GRAY) {
+          const path = [frame.node];
+          let cursor = frame.node;
+          while (cursor !== child && parent[cursor] !== -1) {
+            cursor = parent[cursor];
+            path.push(cursor);
+          }
+          path.reverse();
+          path.push(child);
+          return path;
+        }
+        if (color[child] === WHITE) {
+          color[child] = GRAY;
+          parent[child] = frame.node;
+          stack.push({ node: child, next: 0 });
+        }
+      } else {
+        color[frame.node] = BLACK;
+        stack.pop();
+      }
+    }
+  }
+
+  return null;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Placement primitives                                                        */
+/* -------------------------------------------------------------------------- */
+
+/** True when `[start, start + duration]` clears every booking by `gap`. */
+function fits(
+  intervals: Interval[],
+  start: number,
+  duration: number,
+  gap: number,
+): boolean {
+  const end = start + duration;
+  for (const iv of intervals) {
+    if (start >= iv.end + gap) continue;
+    if (end + gap <= iv.start) continue;
+    return false;
+  }
+  return true;
+}
+
+/**
+ * Candidate start times in a room at or after `earliest`: the earliest instant
+ * itself plus the moment after each existing booking. Any placement can be
+ * left-shifted onto one of these, so nothing feasible is missed.
+ */
+function candidateStarts(
+  intervals: Interval[],
+  earliest: number,
+  duration: number,
+  gap: number,
+  windowEnd: number,
+  limit: number,
+): number[] {
+  const seen = new Set<number>([earliest]);
+  for (const iv of intervals) {
+    const after = iv.end + gap;
+    if (after > earliest) seen.add(after);
+  }
+
+  const sorted = [...seen].sort((a, b) => a - b);
+  const out: number[] = [];
+  for (const start of sorted) {
+    if (start + duration > windowEnd) break;
+    if (fits(intervals, start, duration, gap)) {
+      out.push(start);
+      if (out.length >= limit) break;
+    }
+  }
+  return out;
+}
+
+function earliestStart(
+  intervals: Interval[],
+  earliest: number,
+  duration: number,
+  gap: number,
+  windowEnd: number,
+): number | null {
+  const starts = candidateStarts(intervals, earliest, duration, gap, windowEnd, 1);
+  return starts.length ? starts[0] : null;
+}
+
+function insertInterval(intervals: Interval[], interval: Interval): void {
+  let i = intervals.length;
+  while (i > 0 && intervals[i - 1].start > interval.start) i--;
+  intervals.splice(i, 0, interval);
+}
+
+/* -------------------------------------------------------------------------- */
+/* Greedy construction                                                         */
+/* -------------------------------------------------------------------------- */
+
+function emptySolution(n: number): Solution {
+  return {
+    room: new Int32Array(n).fill(-1),
+    start: new Int32Array(n).fill(-1),
+    end: new Int32Array(n).fill(-1),
+    count: 0,
+    preferred: 0,
+    compactness: 0,
+  };
+}
+
+function runGreedy(ctx: Context, order: number[], strategy: Strategy): Solution {
+  const { events, gap, windowStart, windowEnd } = ctx;
+  const solution = emptySolution(events.length);
+  const booked: Interval[][] = ctx.rooms.map(() => []);
+
+  for (const index of order) {
+    const event = events[index];
+    if (!event.placeable) continue;
+
+    let earliest = windowStart;
+    let ready = true;
+    for (const p of event.prereqs) {
+      if (solution.room[p] === -1) {
+        ready = false;
+        break;
+      }
+      earliest = Math.max(earliest, solution.end[p] + gap);
+    }
+    if (!ready) continue;
+
+    let chosenRoom = -1;
+    let chosenStart = -1;
+
+    if (strategy.honorPreferred && event.preferredRoom >= 0) {
+      const room = event.preferredRoom;
+      if (event.feasibleRooms.includes(room)) {
+        const start = earliestStart(
+          booked[room],
+          earliest,
+          event.duration,
+          gap,
+          windowEnd,
+        );
+        if (start !== null) {
+          chosenRoom = room;
+          chosenStart = start;
+        }
+      }
+    }
+
+    if (chosenRoom === -1) {
+      const rooms =
+        strategy.roomOrder === 'capAsc'
+          ? event.feasibleRooms
+          : [...event.feasibleRooms].reverse();
+
+      for (const room of rooms) {
+        const start = earliestStart(
+          booked[room],
+          earliest,
+          event.duration,
+          gap,
+          windowEnd,
+        );
+        if (start === null) continue;
+        if (strategy.mode === 'first') {
+          chosenRoom = room;
+          chosenStart = start;
+          break;
+        }
+        if (chosenRoom === -1 || start < chosenStart) {
+          chosenRoom = room;
+          chosenStart = start;
+        }
+      }
+    }
+
+    if (chosenRoom === -1) continue;
+
+    const end = chosenStart + event.duration;
+    solution.room[index] = chosenRoom;
+    solution.start[index] = chosenStart;
+    solution.end[index] = end;
+    solution.count++;
+    solution.compactness += end;
+    if (event.preferredRoom === chosenRoom) solution.preferred++;
+    insertInterval(booked[chosenRoom], { start: chosenStart, end });
+  }
+
+  return solution;
+}
+
+/** Lexicographic quality: more events, then more honoured hints, then tighter. */
+function isBetter(candidate: Solution, incumbent: Solution): boolean {
+  if (candidate.count !== incumbent.count) return candidate.count > incumbent.count;
+  if (candidate.preferred !== incumbent.preferred) {
+    return candidate.preferred > incumbent.preferred;
+  }
+  if (candidate.compactness !== incumbent.compactness) {
+    return candidate.compactness < incumbent.compactness;
+  }
+  // Deterministic tie-break so repeated runs return identical schedules.
+  for (let i = 0; i < candidate.room.length; i++) {
+    if (candidate.room[i] !== incumbent.room[i]) {
+      return candidate.room[i] < incumbent.room[i];
+    }
+    if (candidate.start[i] !== incumbent.start[i]) {
+      return candidate.start[i] < incumbent.start[i];
+    }
+  }
+  return false;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Orderings                                                                   */
+/* -------------------------------------------------------------------------- */
+
+/**
+ * Topological order that greedily picks the ready event with the lowest key,
+ * so prerequisites always precede their dependents.
+ */
+function topologicalOrder(
+  events: PreparedEvent[],
+  key: (event: PreparedEvent) => number,
+): number[] {
+  const remaining = new Int32Array(events.length);
+  const dependentsOf: number[][] = events.map(() => []);
+  for (const event of events) {
+    remaining[event.index] = event.prereqs.length;
+    for (const p of event.prereqs) dependentsOf[p].push(event.index);
+  }
+
+  const ready: number[] = [];
+  for (const event of events) {
+    if (remaining[event.index] === 0) ready.push(event.index);
+  }
+
+  const order: number[] = [];
+  while (ready.length) {
+    let pick = 0;
+    for (let i = 1; i < ready.length; i++) {
+      const a = ready[i];
+      const b = ready[pick];
+      const ka = key(events[a]);
+      const kb = key(events[b]);
+      if (ka < kb || (ka === kb && a < b)) pick = i;
+    }
+    const index = ready.splice(pick, 1)[0];
+    order.push(index);
+    for (const dependent of dependentsOf[index]) {
+      if (--remaining[dependent] === 0) ready.push(dependent);
+    }
+  }
+
+  // Cycles were rejected earlier; this is belt-and-braces for stray nodes.
+  if (order.length < events.length) {
+    const placed = new Set(order);
+    for (const event of events) if (!placed.has(event.index)) order.push(event.index);
+  }
+  return order;
+}
+
+function makeRng(seed: number): () => number {
+  let state = seed >>> 0 || 1;
+  return () => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state / 4294967296;
+  };
+}
+
+/** Deterministic keys covering the usual "hardest first" intuitions. */
+const KEY_FUNCTIONS: Array<(event: PreparedEvent) => number> = [
+  (e) => -e.duration,
+  (e) => e.duration,
+  (e) => e.feasibleRooms.length * 100_000 - e.duration,
+  (e) => -e.dependents * 100_000 - e.duration,
+  (e) => -e.attendees * 1000 - e.duration,
+  (e) => e.index,
+  (e) => -e.dependents * 100_000 + e.duration,
+  (e) => -e.attendees * 1000 + e.duration,
+];
+
+/* -------------------------------------------------------------------------- */
+/* Optimisation driver                                                         */
+/* -------------------------------------------------------------------------- */
+
+function optimise(ctx: Context): Solution {
+  const { events } = ctx;
+  let best = emptySolution(events.length);
+
+  for (const key of KEY_FUNCTIONS) {
+    const order = topologicalOrder(events, key);
+    for (const strategy of STRATEGIES) {
+      const candidate = runGreedy(ctx, order, strategy);
+      if (isBetter(candidate, best)) best = candidate;
+    }
+  }
+
+  const upperBound = reachableCount(events);
+  if (best.count >= upperBound) return best;
+
+  best = randomRestarts(ctx, best, upperBound);
+  if (best.count >= upperBound) return best;
+
+  best = repairUnscheduled(ctx, best, upperBound);
+  if (best.count >= upperBound) return best;
+
+  return polish(ctx, branchAndBound(ctx, best, upperBound));
+}
+
+/**
+ * Re-place an already chosen set of events with the preference-aware greedy
+ * strategies. Branch-and-bound optimises head count alone, so this recovers
+ * room hints and compactness without ever giving up a placement.
+ */
+function polish(ctx: Context, solution: Solution): Solution {
+  const selected = ctx.events
+    .filter((e) => solution.room[e.index] !== -1)
+    .map((e) => e.index);
+  if (selected.length === 0) return solution;
+
+  const chosen = new Set(selected);
+  let best = solution;
+
+  for (const key of KEY_FUNCTIONS) {
+    if (Date.now() > ctx.deadline) break;
+    const order = topologicalOrder(ctx.events, key).filter((i) => chosen.has(i));
+    for (const strategy of STRATEGIES) {
+      const candidate = runGreedy(ctx, order, strategy);
+      if (isBetter(candidate, best)) best = candidate;
+    }
+  }
+
+  return best;
+}
+
+/**
+ * Best conceivable outcome: every event whose own prerequisite ancestry is
+ * placeable. Used both as a stopping rule and as a search bound.
+ */
+function reachableCount(events: PreparedEvent[]): number {
+  const viable = new Int8Array(events.length).fill(-1);
+
+  const resolve = (index: number): boolean => {
+    if (viable[index] !== -1) return viable[index] === 1;
+    viable[index] = 0; // Guards against re-entry; cycles are already rejected.
+    const event = events[index];
+    let ok = event.placeable;
+    if (ok) {
+      for (const p of event.prereqs) {
+        if (!resolve(p)) {
+          ok = false;
+          break;
+        }
+      }
+    }
+    viable[index] = ok ? 1 : 0;
+    return ok;
+  };
+
+  let total = 0;
+  for (let i = 0; i < events.length; i++) if (resolve(i)) total++;
+  return total;
+}
+
+function randomRestarts(ctx: Context, incumbent: Solution, upperBound: number): Solution {
+  const rng = makeRng(0x5eed);
+  const noise = new Float64Array(ctx.events.length);
+  let best = incumbent;
+
+  for (let attempt = 0; attempt < 120; attempt++) {
+    if (Date.now() > ctx.deadline) break;
+    for (let i = 0; i < noise.length; i++) noise[i] = rng();
+
+    const bias = attempt % 3;
+    const order = topologicalOrder(ctx.events, (e) => {
+      const jitter = noise[e.index] * 240;
+      if (bias === 0) return -e.duration + jitter;
+      if (bias === 1) return -e.dependents * 500 + jitter;
+      return jitter;
+    });
+
+    const strategy = STRATEGIES[attempt % STRATEGIES.length];
+    const candidate = runGreedy(ctx, order, strategy);
+    if (isBetter(candidate, best)) best = candidate;
+    if (best.count >= upperBound) break;
+  }
+
+  return best;
+}
+
+/**
+ * Targeted repair: for every event we failed to place, retry with that event
+ * (and its prerequisite chain) promoted to the front of the order.
+ */
+function repairUnscheduled(
+  ctx: Context,
+  incumbent: Solution,
+  upperBound: number,
+): Solution {
+  let best = incumbent;
+
+  for (let pass = 0; pass < 2; pass++) {
+    const stuck = ctx.events.filter(
+      (e) => e.placeable && best.room[e.index] === -1,
+    );
+    if (stuck.length === 0) break;
+
+    let improved = false;
+    for (const target of stuck) {
+      if (Date.now() > ctx.deadline) return best;
+
+      const promoted = ancestorClosure(ctx.events, target.index);
+      for (const key of KEY_FUNCTIONS.slice(0, 4)) {
+        const order = topologicalOrder(ctx.events, (e) =>
+          promoted.has(e.index) ? -1e9 + key(e) : key(e),
+        );
+        for (const strategy of STRATEGIES) {
+          const candidate = runGreedy(ctx, order, strategy);
+          if (isBetter(candidate, best)) {
+            best = candidate;
+            improved = true;
+          }
+        }
+      }
+      if (best.count >= upperBound) return best;
+    }
+    if (!improved) break;
+  }
+
+  return best;
+}
+
+function ancestorClosure(events: PreparedEvent[], index: number): Set<number> {
+  const closure = new Set<number>([index]);
+  const stack = [index];
+  while (stack.length) {
+    const node = stack.pop() as number;
+    for (const p of events[node].prereqs) {
+      if (!closure.has(p)) {
+        closure.add(p);
+        stack.push(p);
+      }
+    }
+  }
+  return closure;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Exhaustive search (small instances)                                         */
+/* -------------------------------------------------------------------------- */
+
+/**
+ * Depth-first search over (room, start) choices with a "can we still beat the
+ * incumbent" bound. Only worth running when the greedy portfolio left events
+ * behind and the instance is small enough to explore meaningfully.
+ */
+function branchAndBound(ctx: Context, incumbent: Solution, upperBound: number): Solution {
+  const { events, gap, windowStart, windowEnd } = ctx;
+  const n = events.length;
+  if (n > BNB_MAX_EVENTS || ctx.rooms.length === 0) return incumbent;
+
+  const order = topologicalOrder(
+    events,
+    (e) => e.feasibleRooms.length * 100_000 - e.duration,
+  );
+
+  // Upper bound on placements still available from position i onwards.
+  const suffix = new Int32Array(n + 1);
+  for (let i = n - 1; i >= 0; i--) {
+    suffix[i] = suffix[i + 1] + (events[order[i]].placeable ? 1 : 0);
+  }
+
+  const booked: Interval[][] = ctx.rooms.map(() => []);
+  const room = new Int32Array(n).fill(-1);
+  const start = new Int32Array(n).fill(-1);
+  const end = new Int32Array(n).fill(-1);
+
+  let best = incumbent;
+  let bestCount = incumbent.count;
+  let nodes = 0;
+  let exhausted = false;
+
+  const record = (count: number): void => {
+    const solution = emptySolution(n);
+    solution.count = count;
+    for (let i = 0; i < n; i++) {
+      solution.room[i] = room[i];
+      solution.start[i] = start[i];
+      solution.end[i] = end[i];
+      if (room[i] === -1) continue;
+      solution.compactness += end[i];
+      if (events[i].preferredRoom === room[i]) solution.preferred++;
+    }
+    best = solution;
+    bestCount = count;
+  };
+
+  const search = (position: number, placed: number): void => {
+    if (exhausted) return;
+    if (++nodes > NODE_BUDGET || (nodes % 512 === 0 && Date.now() > ctx.deadline)) {
+      exhausted = true;
+      return;
+    }
+    if (placed + suffix[position] <= bestCount) return;
+    if (position === n) {
+      if (placed > bestCount) record(placed);
+      return;
+    }
+
+    const index = order[position];
+    const event = events[index];
+
+    let earliest = windowStart;
+    let ready = event.placeable;
+    if (ready) {
+      for (const p of event.prereqs) {
+        if (room[p] === -1) {
+          ready = false;
+          break;
+        }
+        earliest = Math.max(earliest, end[p] + gap);
+      }
+    }
+
+    if (ready) {
+      const options: Array<{ room: number; start: number }> = [];
+      for (const r of event.feasibleRooms) {
+        for (const s of candidateStarts(
+          booked[r],
+          earliest,
+          event.duration,
+          gap,
+          windowEnd,
+          BNB_STARTS_PER_ROOM,
+        )) {
+          options.push({ room: r, start: s });
+        }
+      }
+      options.sort(
+        (a, b) =>
+          a.start - b.start ||
+          (b.room === event.preferredRoom ? 1 : 0) - (a.room === event.preferredRoom ? 1 : 0) ||
+          a.room - b.room,
+      );
+
+      for (const option of options) {
+        const interval = { start: option.start, end: option.start + event.duration };
+        room[index] = option.room;
+        start[index] = interval.start;
+        end[index] = interval.end;
+        insertInterval(booked[option.room], interval);
+
+        search(position + 1, placed + 1);
+
+        const slot = booked[option.room].indexOf(interval);
+        booked[option.room].splice(slot, 1);
+        room[index] = -1;
+        start[index] = -1;
+        end[index] = -1;
+
+        if (exhausted || bestCount >= upperBound) return;
+      }
+    }
+
+    // Leaving this event out is also a choice: it may free room for others.
+    search(position + 1, placed);
+  };
+
+  search(0, 0);
+  return best;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Result assembly                                                             */
+/* -------------------------------------------------------------------------- */
+
+function buildResult(ctx: Context, solution: Solution, source: Event[]): ScheduleResult {
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+
+  for (const event of ctx.events) {
+    const room = solution.room[event.index];
+    if (room === -1) {
+      unscheduled.push(event.id);
+      continue;
+    }
+    assignments.push({
+      eventId: source[event.index]?.id ?? event.id,
+      roomId: ctx.rooms[room].id,
+      startTime: solution.start[event.index],
+      endTime: solution.end[event.index],
+    });
+  }
+
+  const positionOf = new Map<Assignment, number>();
+  assignments.forEach((a, i) => positionOf.set(a, i));
+  assignments.sort(
+    (a, b) =>
+      a.startTime - b.startTime ||
+      (positionOf.get(a) as number) - (positionOf.get(b) as number),
+  );
+
+  return { assignments, unscheduled };
+}
