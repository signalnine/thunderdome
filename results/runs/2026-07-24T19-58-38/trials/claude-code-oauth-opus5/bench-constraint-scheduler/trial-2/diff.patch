+      { id: 'a', name: 'A', duration: 60 },
+      { id: 'b', name: 'B', duration: 60 },
+    ];
+    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];
+    const options = { ...DAY, gap: 45 };
+    const result = schedule(events, rooms, options);
+
+    assertValid(result, events, rooms, options);
+    expect((byId(result, 'b') as Assignment).startTime).toBeGreaterThanOrEqual(
