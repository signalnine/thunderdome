+    const options = { startTime: 540, endTime: 660, gap: 0 };
+    const events: Event[] = [
+      { id: 'tiny', name: 'Tiny', duration: 120, attendees: 2 },
+      { id: 'party', name: 'Party', duration: 120, attendees: 30 },
+    ];
+    const result = schedule(events, rooms, options);
+
+    expect(result.unscheduled).toEqual([]);
+    expect((byId(result, 'party') as Assignment).roomId).toBe('big');
+    expect((byId(result, 'tiny') as Assignment).roomId).toBe('small');
+  });
+
+  it('maximises placements when not everything fits', () => {
+    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];
+    const options = { startTime: 540, endTime: 720, gap: 15 };
+    const events: Event[] = [
+      { id: 'long', name: 'Long', duration: 180 },
+      { id: 's1', name: 'S1', duration: 60 },
+      { id: 's2', name: 'S2', duration: 60 },
+    ];
+    const result = schedule(events, rooms, options);
+
+    // Dropping 'long' lets both short events fit (60 + 15 + 60 = 135 <= 180).
+    expect(result.assignments).toHaveLength(2);
+    expect(result.unscheduled).toEqual(['long']);
+    assertValid(result, events, rooms, options);
+  });
+
+  it('is deterministic across runs', () => {
+    const events: Event[] = Array.from({ length: 12 }, (_, i) => ({
+      id: `e${i}`,
+      name: `E${i}`,
+      duration: 30 + (i % 4) * 20,
+      attendees: 1 + (i % 3) * 10,
+      prerequisites: i > 3 && i % 3 === 0 ? [`e${i - 3}`] : [],
+    }));
+    const rooms: Room[] = [
+      { id: 'a', name: 'A', capacity: 5 },
+      { id: 'b', name: 'B', capacity: 20 },
+      { id: 'c', name: 'C', capacity: 40 },
+    ];
+
+    const first = schedule(events, rooms, DAY);
+    const second = schedule(events, rooms, DAY);
+    expect(second).toEqual(first);
+    assertValid(first, events, rooms, DAY);
+  });
+});
+
+describe('degenerate input', () => {
+  it('marks everything unscheduled when there are no rooms', () => {
+    const result = schedule([{ id: 'a', name: 'A', duration: 30 }], [], DAY);
+
+    expect(result.assignments).toEqual([]);
+    expect(result.unscheduled).toEqual(['a']);
+  });
+
+  it('handles a zero-length window', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 0 },
+      { id: 'b', name: 'B', duration: 30 },
+    ];
+    const options = { startTime: 540, endTime: 540 };
+    const result = schedule(events, ROOMS, options);
+
+    expect(result.unscheduled).toEqual(['b']);
+    assertValid(result, events, ROOMS, options);
+  });
+
+  it('scales to a larger batch within the time limit', () => {
+    const events: Event[] = Array.from({ length: 120 }, (_, i) => ({
+      id: `e${i}`,
+      name: `E${i}`,
+      duration: 20 + (i % 5) * 10,
+      attendees: 1 + (i % 7) * 5,
+      preferredRoom: i % 4 === 0 ? 'r0' : undefined,
+      prerequisites: i > 10 && i % 10 === 0 ? [`e${i - 10}`] : [],
+    }));
+    const rooms: Room[] = Array.from({ length: 6 }, (_, i) => ({
+      id: `r${i}`,
+      name: `R${i}`,
+      capacity: 5 + i * 10,
+    }));
+
+    const started = Date.now();
+    const result = schedule(events, rooms, DAY);
+    expect(Date.now() - started).toBeLessThan(5000);
+    assertValid(result, events, rooms, DAY);
+  });
