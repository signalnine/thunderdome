+});
+
+describe('time window', () => {
+  it('does not schedule past the end of the window', () => {
+    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 200 },
