+import { describe, expect, it } from 'vitest';
+import schedulerDefault, {
+  createScheduler,
+  schedule,
+  Scheduler,
+  type Assignment,
+  type Event,
+  type Room,
+  type ScheduleOptions,
+  type ScheduleResult,
+} from '../src/index.js';
+
+const ROOMS: Room[] = [
+  { id: 'small', name: 'Small', capacity: 5 },
+  { id: 'large', name: 'Large', capacity: 50 },
+];
+
+const DAY: ScheduleOptions = { startTime: 540, endTime: 1020 };
+
+function byId(result: ScheduleResult, id: string): Assignment | undefined {
+  return result.assignments.find((a) => a.eventId === id);
+}
+
+/** Re-checks every hard constraint against a produced schedule. */
+function assertValid(
+  result: ScheduleResult,
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): void {
+  const gap = options.gap ?? 15;
+  const eventById = new Map(events.map((e) => [e.id, e]));
+  const roomById = new Map(rooms.map((r) => [r.id, r]));
+
+  const ids = result.assignments.map((a) => a.eventId);
+  expect(new Set(ids).size).toBe(ids.length);
+  expect([...ids, ...result.unscheduled].sort()).toEqual(
+    events.map((e) => e.id).sort(),
+  );
+
+  for (const a of result.assignments) {
+    const event = eventById.get(a.eventId) as Event;
+    const room = roomById.get(a.roomId) as Room;
+    expect(room).toBeDefined();
+    expect(a.endTime - a.startTime).toBe(event.duration);
+    expect(a.startTime).toBeGreaterThanOrEqual(options.startTime);
+    expect(a.endTime).toBeLessThanOrEqual(options.endTime);
+    expect(event.attendees ?? 1).toBeLessThanOrEqual(room.capacity);
+  }
+
+  for (const room of rooms) {
+    const inRoom = result.assignments
+      .filter((a) => a.roomId === room.id)
+      .sort((a, b) => a.startTime - b.startTime);
+    for (let i = 1; i < inRoom.length; i++) {
+      expect(inRoom[i].startTime).toBeGreaterThanOrEqual(inRoom[i - 1].endTime + gap);
+    }
+  }
+
+  for (const a of result.assignments) {
+    const event = eventById.get(a.eventId) as Event;
+    for (const prereqId of event.prerequisites ?? []) {
+      if (!eventById.has(prereqId)) continue;
+      const prereq = byId(result, prereqId);
+      expect(prereq).toBeDefined();
+      expect((prereq as Assignment).endTime + gap).toBeLessThanOrEqual(a.startTime);
+    }
+  }
+}
+
+describe('API surface', () => {
+  it('exposes named, default, class and factory entry points', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 60 }];
+
+    expect(schedule(events, ROOMS, DAY).assignments).toHaveLength(1);
+    expect(schedulerDefault(events, ROOMS, DAY).assignments).toHaveLength(1);
+    expect(new Scheduler(DAY).schedule(events, ROOMS).assignments).toHaveLength(1);
+    expect(createScheduler(DAY).schedule(events, ROOMS).assignments).toHaveLength(1);
+  });
+
+  it('handles empty input', () => {
+    expect(schedule([], ROOMS, DAY)).toEqual({ assignments: [], unscheduled: [] });
+  });
+});
+
+describe('basic placement', () => {
+  it('places events inside the window with the requested duration', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60 },
+      { id: 'b', name: 'B', duration: 90 },
+    ];
+    const result = schedule(events, ROOMS, DAY);
+
+    expect(result.unscheduled).toEqual([]);
+    assertValid(result, events, ROOMS, DAY);
+  });
+
+  it('keeps the default 15 minute gap between events in one room', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60 },
+      { id: 'b', name: 'B', duration: 60 },
+      { id: 'c', name: 'C', duration: 60 },
+    ];
+    const rooms: Room[] = [{ id: 'only', name: 'Only', capacity: 10 }];
+    const result = schedule(events, rooms, DAY);
+
+    expect(result.unscheduled).toEqual([]);
+    assertValid(result, events, rooms, DAY);
+  });
+
+  it('honours a custom gap', () => {
