th.pow(2, i));\n    87\t    }\n    88\t\n    89\t    // Fourth attempt\n    90\t    const lastAttempt = queue.dequeue('work')!;\n    91\t    expect(lastAttempt).not.toBeNull();\n    92\t    queue.fail(lastAttempt.id, 'final error');\n    93\t\n    94\t    // No more retries - should not re-appear\n    95\t    vi.advanceTimersByTime(100000);\n    96\t    expect(queue.dequeue('work')).toBeNull();\n    97\t  });\n    98\t\n    99\t  it('accepts custom maxRetries option', () => {\n   100\t    queue.enqueue('work', { job: 'custom' }, { maxRetries: 1 });\n   101\t\n   102\t    // First attempt\n   103\t    const task = queue.dequeue('work')!;\n   104\t    queue.fail(task.id, 'error 1');\n   105\t    vi.advanceTimersByTime(1000);\n   106\t\n   107\t    // Second attempt (1 retry)\n   108\t    const retry = queue.dequeue('work')!;\n   109\t    expect(retry).not.toBeNull();\n   110\t    queue.fail(retry.id, 'error 2');\n   111\t\n   112\t    // No more retries\n   113\t    vi.advanceTimersByTime(100000);\n   114\t    expect(queue.dequeue('work')).toBeNull();\n   115\t  });\n   116\t\n   117\t  it('retry preserves the original queue name', () => {\n   118\t    queue.enqueue('special-queue', { job: 'preserve-queue' });\n   119\t    const task = queue.dequeue('special-queue')!;\n   120\t    queue.fail(task.id, 'error');\n   121\t    vi.advanceTimersByTime(1000);\n   122\t\n   123\t    // Should appear in the same queue\n   124\t    const retried = queue.dequeue('special-queue');\n   125\t    expect(retried).not.toBeNull();\n   126\t    expect(retried!.id).toBe(task.id);\n   127\t\n   128\t    // Should not appear in other queues\n   129\t    expect(queue.dequeue('default')).toBeNull();\n   130\t  });\n   131\t\n   132\t  it('retry preserves the original priority', () => {\n   133\t    queue.enqueue('work', { job: 'high-pri' }, { priority: 1 });\n   134\t    queue.enqueue('work', { job: 'low-pri' }, { priority: 9 });\n   135\t\n   136\t    const highPri = queue.dequeue('work')!;