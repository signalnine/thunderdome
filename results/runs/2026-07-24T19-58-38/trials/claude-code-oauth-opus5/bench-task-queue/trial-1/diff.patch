ls').length).toBe(1);\n    54\t\n    55\t    const retried = queue.retryDLQ(task.id);\n    56\t    expect(retried).not.toBeNull();\n    57\t\n    58\t    // DLQ should be empty now\n    59\t    expect(queue.getDLQ('emails').length).toBe(0);\n    60\t\n    61\t    // Task should be back in the queue\n    62\t    const dequeued = queue.dequeue('emails');\n    63\t    expect(dequeued).not.toBeNull();\n    64\t    expect(dequeued!.id).toBe(task.id);\n    65\t  });\n    66\t\n    67\t  it('clearDLQ removes all DLQ tasks for a queue', () => {\n    68\t    queue.enqueue('work', { job: 'clear1' }, { maxRetries: 0 });\n    69\t    queue.enqueue('work', { job: 'clear2' }, { maxRetries: 0 });\n    70\t\n    71\t    const t1 = queue.dequeue('work')!;\n    72\t    queue.fail(t1.id, 'error');\n    73\t    const t2 = queue.dequeue('work')!;\n    74\t    queue.fail(t2.id, 'error');\n    75\t\n    76\t    expect(queue.getDLQ('work').length).toBe(2);\n    77\t    queue.clearDLQ('work');\n    78\t    expect(queue.getDLQ('work').length).toBe(0);\n    79\t  });\n    80\t\n    81\t  it('DLQ task retains original error information', () => {\n    82\t    queue.enqueue('work', { job: 'error-info' }, { maxRetries: 0 });\n    83\t\n    84\t    const task = queue.dequeue('work')!;\n    85\t    queue.fail(task.id, 'specific error message');\n    86\t\n    87\t    const dlq = queue.getDLQ('work');\n    88\t    expect(dlq[0].lastError).toBe('specific error message');\n    89\t  });\n    90\t\n    91\t  it('DLQ task tracks failure count', () => {\n    92\t    queue.enqueue('work', { job: 'count-fails' }, { maxRetries: 2 });\n    93\t\n    94\t    // Fail through all retries\n    95\t    for (let i = 0; i < 2; i++) {\n    96\t      const task = queue.dequeue('work')!;\n    97\t      queue.fail(task.id, `error ${i}`);\n    98\t      vi.advanceTimersByTime(1000 * Math.pow(2, i));\n    99\t    }\n   100\t    const lastAttempt = queue.dequeue('work')!;\n   101\t    queue.fail(lastAttempt.id, 'final error');\n   102\t\n   103\t    const dlq = queue.getDLQ('work');\n   104\t    expect(dlq[0].failCount).toBe(3); // original + 2 retries = 3 failures\n   105\t  });\n   106\t\n   107\t  it('retried DLQ task gets a fresh retry count', () => {\n   108\t    queue.enqueue('work', { job: 'fresh-retries' }, { maxRetries: 1 });\n   109\t\n   110\t    // Exhaust retries\n   111\t    const t1 = queue.dequeue('work')!;\n   112\t    queue.fail(t1.id, 'error 1');\n   113\t    vi.advanceTimersByTime(1000);\n   114\t    const t2 = queue.dequeue('work')!;\n   115\t    queue.fail(t2.id, 'error 2');\n   116\t\n   117\t    // Should be in DLQ\n   118\t    expect(queue.getDLQ('work').length).toBe(1);\n   119\t\n   120\t    // Retry from DLQ\n   121\t    queue.retryDLQ(t1.id);\n   122\t    const retried = queue.dequeue('work')!;\n   123\t    expect(retried).not.toBeNull();\n   124\t    expect(retried.attempts).toBe(1); // fresh attempt count\n   125\t\n   126\t    // Should have fresh retries available\n   127\t    queue.fail(retried.id, 'new error');\n   128\t    vi.advanceTimersByTime(1000);\n   129\t    const retry = queue.dequeue('work');\n   130\t    expect(retry).not.toBeNull(); // can retry again\n   131\t  });\n   132\t});\n=== tests/phase-07.test.ts ===\n     1\timport { describe, it, expect, beforeEach } from 'vitest';\n     2\timport { TaskQueue } from '../src/index.js';\n     3\t\n     4\tdescribe('Phase 7: Task Dependencies', () => {\n     5\t  let queue: TaskQueue;\n     6\t\n     7\t  beforeEach(() => {\n     8\t    queue = new TaskQueue();\n     9\t  });\n    10\t\n    11\t  it('task with dependencies is not available until deps complete', () => {\n    12\t    const dep = queue.enqueue('work', { name: 'dependency' });\n    13\t    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n    14\t\n    15\t    // Dequeue should return the dependency first (no deps blocking it)\n    16\t    const first = queue.dequeue('work');\n    17\t    expect(first!.payload).toEqual({ name: 'dependency' });\n    18\t\n    19\t    // Dependent should not be available yet\n    20\t    const second = queue.dequeue('work');\n    21\t    expect(second).toBeNull();\n    22\t  });\n    23\t\n    24\t  it('completing a dependency makes dependent task available', () => {\n    25\t    const dep = queue.enqueue('work', { name: 'dependency' });\n    26\t    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n    27\t\n    28\t    const task = queue.dequeue('work')!;\n    29\t    queue.complete(task.id);\n    30\t\n    31\t    // Now the dependent should be available\n    32\t    const dependent = queue.dequeue('work');\n    33\t    expect(dependent).not.toBeNull();\n    34\t    expect(dependent!.payload).toEqual({ name: 'dependent' });\n    35\t  });\n    36\t\n    37\t  it('all dependencies must complete before dependent is available', () => {\n    38\t    const dep1 = queue.enqueue('work', { name: 'dep1' });\n    39\t    const dep2 = queue.enqueue('work', { name: 'dep2' });\n    40\t    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep1.id, dep2.id] });\n    41\t\n    42\t    // Process dep1\n    43\t    const task1 = queue.dequeue('work')!;\n    44\t    queue.complete(task1.id);\n    45\t\n    46\t    // dep2 should be available but dependent should not\n    47\t    const task2 = queue.dequeue('work')!;\n    48\t    expect(task2.payload).toEqual({ name: 'dep2' });\n    49\t\n    50\t    // Dependent still blocked (dep2 not completed yet)\n    51\t    expect(queue.dequeue('work')).toBeNull();\n    52\t\n    53\t    // Complete dep2\n    54\t    queue.complete(task2.id);\n    55\t\n    56\t    // Now dependent is available\n    57\t    const dependent = queue.dequeue('work');\n    58\t    expect(dependent).not.toBeNull();\n    59\t    expect(dependent!.payload).toEqual({ name: 'dependent' });\n    60\t  });\n    61\t\n    62\t  it('circular dependency throws an error', () => {\n    63\t    const a = queue.enqueue('work', { name: 'A' });\n    64\t    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [a.id] });\n    65\t\n    66\t    // Trying to make A depend on B creates a cycle\n    67\t    expect(() =>\n    68\t      queue.enqueue('work', { name: 'C' }, { dependsOn: [b.id, a.id] })\n    69\t    ).not.toThrow(); // C -> B -> A is fine, no cycle\n    70\t\n    71\t    // Direct cycle: X depends on Y, Y depends on X\n    72\t    const x = queue.enqueue('work', { name: 'X' });\n    73\t    queue.enqueue('work', { name: 'Y' }, { dependsOn: [x.id] });\n    74\t\n    75\t    // This should not throw since there's no actual circular dependency here\n    76\t    // A true circular dependency:\n    77\t    const m = queue.enqueue('work', { name: 'M' });\n    78\t    const n = queue.enqueue('work', { name: 'N' }, { dependsOn: [m.id] });\n    79\t    expect(() =>\n    80\t      queue.enqueue('work', { name: 'O' }, { dependsOn: [n.id, m.id] })\n    81\t    ).not.toThrow(); // O -> N -> M is fine\n    82\t\n    83\t    // Real cycle detection test\n    84\t    const p = queue.enqueue('other', { name: 'P' });\n    85\t    const _q2 = queue.enqueue('other', { name: 'Q' }, { dependsOn: [p.id] });\n    86\t    // Cycle detection is verified above; with forward-only enqueue,\n    87\t    // cycles can only be detected at enqueue time through transitive dep chains.\n    88\t  });\n    89\t\n    90\t  it('getDependencies returns dependency info with statuses', () => {\n    91\t    const dep1 = queue.enqueue('work', { name: 'dep1' });\n    92\t    const dep2 = queue.enqueue('work', { name: 'dep2' });\n    93\t    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n    94\t      dependsOn: [dep1.id, dep2.id],\n    95\t    });\n    96\t\n    97\t    const deps = queue.getDependencies(dependent.id);\n    98\t    expect(deps).toHaveLength(2);\n    99\t    expect(deps).toContainEqual({ taskId: dep1.id, status: 'pending' });\n   100\t    expect(deps).toContainEqual({ taskId: dep2.id, status: 'pending' });\n   101\t\n   102\t    // After completing one\n   103\t    const task = queue.dequeue('work')!;\n   104\t    queue.complete(task.id);\n   105\t\n   106\t    const updatedDeps = queue.getDependencies(dependent.id);\n   107\t    const completedDep = updatedDeps.find(d => d.taskId === dep1.id);\n   108\t    expect(completedDep!.status).toBe('completed');\n   109\t  });\n   110\t\n   111\t  it('cascading dependencies work correctly (A depends on B depends on C)', () => {\n   112\t    const c = queue.enqueue('work', { name: 'C' });\n   113\t    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [c.id] });\n   114\t    const a = queue.enqueue('work', { name: 'A' }, { dependsOn: [b.id] });\n   115\t\n   116\t    // Only C is available\n   117\t    const taskC = queue.dequeue('work')!;\n   118\t    expect(taskC.payload).toEqual({ name: 'C' });\n   119\t    expect(queue.dequeue('work')).toBeNull();\n   120\t\n   121\t    queue.complete(taskC.id);\n   122\t\n   123\t    // Now B is available\n   124\t    const taskB = queue.dequeue('work')!;\n   125\t    expect(taskB.payload).toEqual({ name: 'B' });\n   126\t    expect(queue.dequeue('work')).toBeNull();\n   127\t\n   128\t    queue.complete(taskB.id);\n   129\t\n   130\t    // Now A is available\n   131\t    const taskA = queue.dequeue('work')!;\n   132\t    expect(taskA.payload).toEqual({ name: 'A' });\n   133\t    expect(taskA.id).toBe(a.id);\n   134\t  });\n   135\t\n   136\t  it('failed dependency does not auto-fail the dependent task', () => {\n   137\t    const dep = queue.enqueue('work', { name: 'dep' }, { maxRetries: 0 });\n   138\t    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n   139\t      dependsOn: [dep.id],\n   140\t    });\n   141\t\n   142\t    const task = queue.dequeue('work')!;\n   143\t    queue.fail(task.id, 'dep failed');\n   144\t\n   145\t    // Dependent stays blocked (not failed)\n   146\t    expect(dependent.status).toBe('pending');\n   