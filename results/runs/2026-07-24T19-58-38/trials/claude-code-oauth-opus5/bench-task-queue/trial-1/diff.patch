+import { randomUUID } from 'node:crypto';
+
+const DEFAULT_QUEUE = 'default';
+const DEFAULT_PRIORITY = 5;
+const DEFAULT_MAX_RETRIES = 3;
+const DEFAULT_BACKOFF_MS = 1000;
+const DEFAULT_SHUTDOWN_TIMEOUT = 30000;
+
+export type TaskStatus =
+  | 'pending'
+  | 'processing'
+  | 'completed'
+  | 'failed'
+  | 'cancelled';
+
+// Task payloads are user-defined and intentionally untyped.
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export type TaskPayload = any;
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface Task {
+  id: string;
+  queueName: string;
+  payload: TaskPayload;
+  status: TaskStatus;
+  priority: number;
+  createdAt: Date;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  dependsOn: string[];
+  failCount: number;
+  lastError?: string;
+  /** Monotonic insertion counter used to break ties (FIFO). */
+  seq: number;
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: TaskStatus;
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type ProgressCallback = (info: ProgressInfo) => void;
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: TaskPayload;
+  active: boolean;
+  nextRun: Date;
+}
+
+export type Middleware = (
+  task: Task,
+  next: () => Promise<void>,
+) => Promise<void> | void;
+
+export type TaskHandler = (task: Task) => Promise<void> | void;
+
+export type ShutdownCallback = () => void;
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+interface ShutdownState {
+  inFlight: Set<string>;
+  completed: number;
+  cancelled: number;
+  start: number;
+  timer: ReturnType<typeof setTimeout> | null;
+  resolve: (summary: ShutdownSummary) => void;
+  done: boolean;
+}
+
+export class TaskQueue {
+  /** Pending tasks, per queue name. */
+  private queues = new Map<string, Task[]>();
+  /** Every task ever created, by id. */
+  private tasks = new Map<string, Task>();
+  /** Ids of tasks currently in `processing` status, per queue name. */
+  private processingByQueue = new Map<string, Set<string>>();
+  private concurrencyLimits = new Map<string, number>();
+  private dlqs = new Map<string, Task[]>();
+  private middlewares = new Map<string, Middleware[]>();
+  private progress = new Map<string, ProgressInfo>();
+  private progressListeners = new Map<string, Set<ProgressCallback>>();
+  private schedules = new Map<string, Schedule>();
+  private shutdownCallbacks: ShutdownCallback[] = [];
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private shutdownState: ShutdownState | null = null;
+  private shuttingDown = false;
+  private seqCounter = 0;
+
+  // ---------------------------------------------------------------------
+  // Phase 1-7: enqueue / dequeue
+  // ---------------------------------------------------------------------
+
+  /**
+   * Add a task to a queue. Both `enqueue(payload)` and
+   * `enqueue(queueName, payload, options)` forms are supported.
+   */
+  enqueue(
+    queueNameOrPayload?: string | TaskPayload,
+    payload?: TaskPayload,
+    options: EnqueueOptions = {},
+  ): Task {
+    if (this.shuttingDown) {
+      throw new Error('TaskQueue is shutting down; cannot enqueue new tasks');
+    }
+
+    let queueName: string;
+    let actualPayload: TaskPayload;
+    if (typeof queueNameOrPayload === 'string') {
+      queueName = queueNameOrPayload;
+      actualPayload = payload;
+    } else {
+      queueName = DEFAULT_QUEUE;
+      actualPayload = queueNameOrPayload;
+    }
+
+    const priority = options.priority ?? DEFAULT_PRIORITY;
+    if (
+      typeof priority !== 'number' ||
+      Number.isNaN(priority) ||
+      priority < 1 ||
+      priority > 10
+    ) {
+      throw new Error(`Invalid priority ${priority}: must be between 1 and 10`);
+    }
+
+    const maxRetries = options.maxRetries ?? DEFAULT_MAX_RETRIES;
+    if (maxRetries < 0) {
+      throw new Error('maxRetries must be >= 0');
+    }
+    const backoffMs = options.backoffMs ?? DEFAULT_BACKOFF_MS;
+
+    const now = Date.now();
+    let availableAt = now;
+    if (options.runAt instanceof Date) {
+      availableAt = options.runAt.getTime();
+    }
+    if (typeof options.delay === 'number') {
+      availableAt = Math.max(availableAt, now + options.delay);
+    }
+
+    const dependsOn = options.dependsOn ? [...options.dependsOn] : [];
+    for (const depId of dependsOn) {
+      if (!this.tasks.has(depId)) {
+        throw new Error(`Dependency task not found: ${depId}`);
+      }
+    }
+    this.assertNoCycle(dependsOn);
+
+    const task: Task = {
+      id: randomUUID(),
+      queueName,
+      payload: actualPayload,
+      status: 'pending',
+      priority,
+      createdAt: new Date(now),
+      availableAt: new Date(availableAt),
+      attempts: 0,
+      maxRetries,
+      backoffMs,
+      dependsOn,
+      failCount: 0,
+      seq: this.seqCounter++,
+    };
+
+    this.tasks.set(task.id, task);
+    this.getQueue(queueName).push(task);
+    return task;
+  }
+
+  /**
+   * Take the next runnable task from a queue, or `null` when nothing is
+   * available (empty, delayed, blocked by dependencies, or at the
+   * concurrency limit).
+   */
+  dequeue(queueName: string = DEFAULT_QUEUE): Task | null {
+    if (this.shuttingDown) return null;
+
+    const queue = this.queues.get(queueName);
+    if (!queue || queue.length === 0) return null;
+
+    const processing = this.getProcessing(queueName);
+    const limit = this.concurrencyLimits.get(queueName) ?? Infinity;
+    if (processing.size >= limit) return null;
+
+    const now = Date.now();
+    let best: Task | null = null;
+    let bestIndex = -1;
+    for (let i = 0; i < queue.length; i++) {
+      const candidate = queue[i];
+      if (!this.isAvailable(candidate, now)) continue;
+      if (best === null || this.compare(candidate, best) < 0) {
+        best = candidate;
+        bestIndex = i;
+      }
+    }
+    if (best === null) return null;
+
+    queue.splice(bestIndex, 1);
+    best.status = 'processing';
+    best.attempts += 1;
+    processing.add(best.id);
+    return best;
+  }
+
+  /** Number of pending tasks in a queue (defaults to the `default` queue). */
+  size(queueName: string = DEFAULT_QUEUE): number {
+    return this.queueSize(queueName);
+  }
+
+  /** Number of pending tasks in the given named queue. */
+  queueSize(queueName: string): number {
+    const queue = this.queues.get(queueName);
+    if (!queue) return 0;
+    return queue.filter((t) => t.status === 'pending').length;
+  }
+
+  /** All queue names that have had at least one task enqueued. */
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  /** Look up a task by id. */
+  getTask(taskId: string): Task | null {
+    return this.tasks.get(taskId) ?? null;
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 5-6: completion, retry, dead letter queue
+  // ---------------------------------------------------------------------
+
+  /** Mark a processing task as completed. */
+  complete(taskId: string): Task | null {
+    const task = this.tasks.get(taskId);
+    if (!task) return null;
+    if (task.status !== 'processing') return task;
+
+    task.status = 'completed';
+    this.releaseSlot(task);
+
+    const state = this.shutdownState;
+    if (state && state.inFlight.delete(taskId)) {
+      state.completed += 1;
+      this.maybeFinishShutdown();
+    }
+    return task;
+  }
+
+  /**
+   * Mark a processing task as failed. Re-enqueues it with exponential
+   * backoff while retries remain, otherwise moves it to the dead letter
+   * queue.
+   */
+  fail(taskId: string, error?: string): Task | null {
+    const task = this.tasks.get(taskId);
+    if (!task) return null;
+    // Cancelled tasks are never retried.
+    if (task.status !== 'processing') return task;
+
+    task.failCount += 1;
+    if (error !== undefined) task.lastError = error;
+    this.releaseSlot(task);
+
+    const state = this.shutdownState;
+    if (state) state.inFlight.delete(taskId);
+
+    if (task.attempts <= task.maxRetries) {
+      const backoff = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + backoff);
+      this.getQueue(task.queueName).push(task);
+    } else {
+      task.status = 'failed';
+      this.getDLQStore(task.queueName).push(task);
+    }
+
+    if (state) this.maybeFinishShutdown();
+    return task;
+  }
+
+  /** All dead-lettered tasks for a queue. */
+  getDLQ(queueName: string): Task[] {
+    return [...(this.dlqs.get(queueName) ?? [])];
+  }
+
+  /** Move a dead-lettered task back into its original queue with fresh retries. */
+  retryDLQ(taskId: string): Task | null {
+    const task = this.tasks.get(taskId);
+    if (!task) return null;
+
+    const dlq = this.dlqs.get(task.queueName);
+    if (!dlq) return null;
+    const index = dlq.findIndex((t) => t.id === taskId);
+    if (index === -1) return null;
+
+    dlq.splice(index, 1);
+    task.status = 'pending';
+    task.attempts = 0;
+    task.availableAt = new Date(Date.now());
+    this.getQueue(task.queueName).push(task);
+    return task;
+  }
+
+  /** Drop every dead-lettered task for a queue. */
+  clearDLQ(queueName: string): void {
+    this.dlqs.set(queueName, []);
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 7: dependencies
+  // ---------------------------------------------------------------------
+
+  /** Dependency ids of a task along with their current statuses. */
+  getDependencies(taskId: string): DependencyInfo[] {
+    const task = this.tasks.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map((depId) => ({
+      taskId: depId,
+      status: this.tasks.get(depId)?.status ?? 'failed',
+    }));
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 8: concurrency
+  // ---------------------------------------------------------------------
+
+  /** Cap how many tasks of a queue may be in `processing` at once. */
+  setConcurrency(queueName: string, limit: number): void {
+    if (typeof limit !== 'number' || Number.isNaN(limit) || limit < 0) {
+      throw new Error('Concurrency limit must be a non-negative number');
+    }
+    this.concurrencyLimits.set(queueName, limit === 0 ? Infinity : limit);
+  }
+
+  /** Current in-flight count and configured maximum for a queue. */
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    return {
+      current: this.getProcessing(queueName).size,
+      max: this.concurrencyLimits.get(queueName) ?? Infinity,
+    };
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 9: progress and cancellation
+  // ---------------------------------------------------------------------
+
+  /** Report progress (0-100) for a task and notify subscribers. */
+  updateProgress(taskId: string, percent: number, message?: string): ProgressInfo {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new Error(`Task not found: ${taskId}`);
+    if (typeof percent !== 'number' || Number.isNaN(percent) || percent < 0 || percent > 100) {
+      throw new Error(`Invalid progress ${percent}: must be between 0 and 100`);
+    }
+
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    this.progress.set(taskId, info);
+
+    const listeners = this.progressListeners.get(taskId);
+    if (listeners) {
+      for (const listener of [...listeners]) listener(info);
+    }
+    return info;
+  }
+
+  /** Latest reported progress, or `null` if none has been reported. */
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progress.get(taskId) ?? null;
+  }
+
+  /** Subscribe to progress updates; returns an unsubscribe function. */
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    let listeners = this.progressListeners.get(taskId);
+    if (!listeners) {
+      listeners = new Set();
+      this.progressListeners.set(taskId, listeners);
+    }
+    listeners.add(callback);
+    return () => {
+      listeners?.delete(callback);
+    };
+  }
+
+  /** Cancel a pending or processing task. Cancelled tasks are never retried. */
+  cancel(taskId: string): boolean {
+    const task = this.tasks.get(taskId);
+    if (!task) return false;
+    if (task.status !== 'pending' && task.status !== 'processing') return false;
+
+    const wasProcessing = task.status === 'processing';
+    const queue = this.queues.get(task.queueName);
+    if (queue) {
+      const index = queue.indexOf(task);
+      if (index !== -1) queue.splice(index, 1);
+    }
+    task.status = 'cancelled';
+
+    if (wasProcessing) {
+      this.getProcessing(task.queueName).delete(task.id);
+      const state = this.shutdownState;
+      if (state && state.inFlight.delete(task.id)) {
+        state.cancelled += 1;
+        this.maybeFinishShutdown();
+      }
+    }
+    return true;
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 10: recurring schedules
+  // ---------------------------------------------------------------------
+
+  /** Register a recurring task using a small cron subset. */
+  schedule(
+    queueName: string,
+    cronExpression: string,
+    taskTemplate: TaskPayload,
+  ): Schedule {
+    const intervalMs = parseCron(cronExpression);
+    const entry: Schedule = {
+      id: randomUUID(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+      nextRun: new Date(nextOccurrence(Date.now(), intervalMs)),
+    };
+    this.schedules.set(entry.id, entry);
+    return entry;
+  }
+
+  /** Deactivate a schedule so it stops producing tasks. */
+  unschedule(scheduleId: string): boolean {
+    const entry = this.schedules.get(scheduleId);
+    if (!entry) return false;
+    entry.active = false;
+    return true;
+  }
+
+  /** Active schedules, optionally filtered by queue name. */
+  listSchedules(queueName?: string): Schedule[] {
+    const all = [...this.schedules.values()].filter((s) => s.active);
+    return queueName === undefined
+      ? all
+      : all.filter((s) => s.queueName === queueName);
+  }
+
+  /** Enqueue tasks for every schedule that is due right now. */
+  tick(): Task[] {
+    if (this.shuttingDown) return [];
+    const now = Date.now();
+    const created: Task[] = [];
+    for (const entry of this.schedules.values()) {
+      if (!entry.active) continue;
+      if (entry.nextRun.getTime() > now) continue;
+      created.push(this.enqueue(entry.queueName, entry.taskTemplate));
+      const intervalMs = parseCron(entry.cronExpression);
+      entry.nextRun = new Date(nextOccurrence(now, intervalMs));
+    }
+    return created;
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 11: middleware pipeline
+  // ---------------------------------------------------------------------
+
+  /** Append a middleware to a queue's pipeline. */
+  use(queueName: string, middleware: Middleware): void {
+    const stack = this.middlewares.get(queueName);
+    if (stack) stack.push(middleware);
+    else this.middlewares.set(queueName, [middleware]);
+  }
+
+  /**
+   * Dequeue one task and run it through the queue's middleware pipeline
+   * followed by `handler`. Errors anywhere in the chain fail the task.
+   */
+  async process(queueName: string, handler: TaskHandler): Promise<Task | null> {
+    const task = this.dequeue(queueName);
+    if (!task) return null;
+
+    const stack = this.middlewares.get(queueName) ?? [];
+    let lastCalled = -1;
+    const dispatch = async (index: number): Promise<void> => {
+      if (index <= lastCalled) {
+        throw new Error('next() called multiple times in middleware');
+      }
+      lastCalled = index;
+      if (index < stack.length) {
+        await stack[index](task, () => dispatch(index + 1));
+      } else {
+        await handler(task);
+      }
+    };
+
+    try {
+      await dispatch(0);
+    } catch (err) {
+      this.fail(task.id, err instanceof Error ? err.message : String(err));
+      return task;
+    }
+
+    // A middleware that short-circuits (never calls next) still releases
+    // the task; cancelled/failed tasks keep whatever status they got.
+    if (task.status === 'processing') this.complete(task.id);
+    return task;
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 12: graceful shutdown
+  // ---------------------------------------------------------------------
+
+  /** Register a callback invoked when shutdown begins. */
+  onShutdown(callback: ShutdownCallback): () => void {
+    this.shutdownCallbacks.push(callback);
+    return () => {
+      const index = this.shutdownCallbacks.indexOf(callback);
+      if (index !== -1) this.shutdownCallbacks.splice(index, 1);
+    };
+  }
+
+  /**
+   * Stop accepting new work and wait for in-flight tasks. Tasks still
+   * processing after `timeout` ms are force-cancelled. Idempotent.
+   */
+  shutdown(timeout: number = DEFAULT_SHUTDOWN_TIMEOUT): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+    this.shuttingDown = true;
+
+    const inFlight = new Set<string>();
+    for (const ids of this.processingByQueue.values()) {
+      for (const id of ids) inFlight.add(id);
+    }
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      const state: ShutdownState = {
+        inFlight,
+        completed: 0,
+        cancelled: 0,
+        start: Date.now(),
+        timer: null,
+        resolve,
+        done: false,
+      };
+      this.shutdownState = state;
+
+      for (const callback of [...this.shutdownCallbacks]) {
+        try {
+          callback();
+        } catch {
+          // Shutdown hooks must not block shutdown.
+        }
+      }
+
+      if (inFlight.size === 0) {
+        this.finishShutdown();
+        return;
+      }
+
+      state.timer = setTimeout(() => {
+        if (state.done) return;
+        for (const id of [...state.inFlight]) this.cancel(id);
+        this.finishShutdown();
+      }, timeout);
+    });
+
+    return this.shutdownPromise;
+  }
+
+  // ---------------------------------------------------------------------
+  // Internals
+  // ---------------------------------------------------------------------
+
+  private getQueue(queueName: string): Task[] {
+    let queue = this.queues.get(queueName);
+    if (!queue) {
+      queue = [];
+      this.queues.set(queueName, queue);
+    }
+    return queue;
+  }
+
+  private getProcessing(queueName: string): Set<string> {
+    let set = this.processingByQueue.get(queueName);
+    if (!set) {
+      set = new Set();
+      this.processingByQueue.set(queueName, set);
+    }
+    return set;
+  }
+
+  private getDLQStore(queueName: string): Task[] {
+    let dlq = this.dlqs.get(queueName);
+    if (!dlq) {
+      dlq = [];
+      this.dlqs.set(queueName, dlq);
+    }
+    return dlq;
+  }
+
+  private releaseSlot(task: Task): void {
+    this.getProcessing(task.queueName).delete(task.id);
+  }
+
+  private isAvailable(task: Task, now: number): boolean {
+    if (task.status !== 'pending') return false;
+    if (task.availableAt.getTime() > now) return false;
+    return this.dependenciesSatisfied(task);
+  }
+
+  private dependenciesSatisfied(task: Task): boolean {
+    for (const depId of task.dependsOn) {
+      if (this.tasks.get(depId)?.status !== 'completed') return false;
+    }
+    return true;
+  }
+
+  /**
+   * Ordering: priority first (1 = highest), then earliest availability,
+   * then insertion order.
+   */
+  private compare(a: Task, b: Task): number {
+    if (a.priority !== b.priority) return a.priority - b.priority;
+    const availDiff = a.availableAt.getTime() - b.availableAt.getTime();
+    if (availDiff !== 0) return availDiff;
+    return a.seq - b.seq;
+  }
+
+  /**
+   * Walk the dependency graph reachable from `roots` and throw if a cycle
+   * exists. A brand-new task cannot be depended upon yet, so cycles can only
+   * arise through an already-corrupted transitive chain.
+   */
+  private assertNoCycle(roots: string[]): void {
+    const visiting = new Set<string>();
+    const done = new Set<string>();
+
+    const visit = (id: string): void => {
+      if (done.has(id)) return;
+      if (visiting.has(id)) {
+        throw new Error(`Circular dependency detected involving task ${id}`);
+      }
+      visiting.add(id);
+      const task = this.tasks.get(id);
+      if (task) {
+        for (const depId of task.dependsOn) visit(depId);
+      }
+      visiting.delete(id);
+      done.add(id);
+    };
+
+    for (const root of roots) visit(root);
+  }
+
+  private maybeFinishShutdown(): void {
+    const state = this.shutdownState;
+    if (!state || state.done) return;
+    if (state.inFlight.size > 0) return;
+    this.finishShutdown();
+  }
+
+  private finishShutdown(): void {
+    const state = this.shutdownState;
+    if (!state || state.done) return;
+    state.done = true;
+    if (state.timer !== null) {
+      clearTimeout(state.timer);
+      state.timer = null;
+    }
+    state.resolve({
+      completed: state.completed,
+      cancelled: state.cancelled,
+      elapsed: Date.now() - state.start,
+    });
+  }
+}
+
+/** Milliseconds between runs for the supported cron subset. */
+function parseCron(expression: string): number {
+  const parts = expression.trim().split(/\s+/);
+  if (parts.length !== 5) {
+    throw new Error(`Unsupported cron expression: ${expression}`);
+  }
+  const [minute, hour, dayOfMonth, month, dayOfWeek] = parts;
+
+  if (dayOfMonth !== '*' || month !== '*' || dayOfWeek !== '*') {
+    throw new Error(`Unsupported cron expression: ${expression}`);
+  }
+
+  const stepMatch = /^\*\/(\d+)$/.exec(minute);
+  if (stepMatch && hour === '*') {
+    const step = Number(stepMatch[1]);
+    if (step < 1) throw new Error(`Unsupported cron expression: ${expression}`);
+    return step * 60_000;
+  }
+
+  if (minute === '0' && hour === '*') return 60 * 60_000;
+  if (minute === '0' && hour === '0') return 24 * 60 * 60_000;
+
+  const hourStep = /^\*\/(\d+)$/.exec(hour);
+  if (minute === '0' && hourStep) {
+    const step = Number(hourStep[1]);
+    if (step < 1) throw new Error(`Unsupported cron expression: ${expression}`);
+    return step * 60 * 60_000;
+  }
+
+  if (minute === '*' && hour === '*') return 60_000;
+
+  throw new Error(`Unsupported cron expression: ${expression}`);
+}
+
+/** First epoch-aligned occurrence strictly after `from`. */
+function nextOccurrence(from: number, intervalMs: number): number {
+  return (Math.floor(from / intervalMs) + 1) * intervalMs;
+}
