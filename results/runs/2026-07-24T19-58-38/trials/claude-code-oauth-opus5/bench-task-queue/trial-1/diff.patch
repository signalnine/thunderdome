 'dep2' });\n    93\t    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n    94\t      dependsOn: [dep1.id, dep2.id],\n    95\t    });\n    96\t\n    97\t    const deps = queue.getDependencies(dependent.id);\n    98\t    expect(deps).toHaveLength(2);\n    99\t    expect(deps).toContainEqual({ taskId: dep1.id, status: 'pending' });\n   100\t    expect(deps).toContainEqual({ taskId: dep2.id, status: 'pending' });\n   101\t\n   102\t    // After completing one\n   103\t    const task = queue.dequeue('work')!;\n   104\t    queue.complete(task.id);\n   105\t\n   106\t    const updatedDeps = queue.getDependencies(dependent.id);\n   107\t    const completedDep = updatedDeps.find(d => d.taskId === dep1.id);\n   108\t    expect(completedDep!.status).toBe('completed');\n   109\t  });\n   110\t\n   111\t  it('cascading dependencies work correctly (A depends on B depends on C)', () => {\n   112\t    const c = queue.enqueue('work', { name: 'C' });\n   113\t    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [c.id] });\n   114\t    const a = queue.enqueue('work', { name: 'A' }, { dependsOn: [b.id] });\n   115\t\n   116\t    // Only C is available\n   117\t    const taskC = queue.dequeue('work')!;\n   118\t    expect(taskC.payload).toEqual({ name: 'C' });\n   119\t    expect(queue.dequeue('work')).toBeNull();\n   120\t\n   121\t    queue.complete(taskC.id);\n   122\t\n   123\t    // Now B is available\n   124\t    const taskB = queue.dequeue('work')!;\n   125\t    expect(taskB.payload).toEqual({ name: 'B' });\n   126\t    expect(queue.dequeue('work')).toBeNull();\n   127\t\n   128\t    queue.complete(taskB.id);\n   129\t\n   130\t    // Now A is available\n   131\t    const taskA = queue.dequeue('work')!;\n   132\t    expect(taskA.payload).toEqual({ name: 'A' });\n   133\t    expect(taskA.id).toBe(a.id);\n   134\t  });\n   135\t\n   136\t  it('failed dependency does not auto-fail the dependent task', () => {\n   137\t    const dep = queue.enqueue('work', { name: 'dep' }, { maxRetries: 0 });\n   138\t    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n   139\t      dependsOn: [dep.id],\n   140\t    });\n   141\t\n   142\t    const task = queue.dequeue('work')!;\n   143\t    queue.fail(task.id, 'dep failed');\n   144\t\n   145\t    // Dependent stays blocked (not failed)\n   146\t    expect(dependent.status).toBe('pending');\n   147\t    expect(queue.dequeue('work')).toBeNull();\n   148\t  });\n   149\t\n   150\t  it('dependency on non-existent task throws an error', () => {\n   151\t    expect(() =>\n   152\t      queue.enqueue('work', { name: 'orphan' }, { dependsOn: ['nonexistent-id'] })\n   153\t    ).toThrow();\n   154\t  });\n   155\t});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
