+/**
+ * An in-memory task queue supporting named queues, priorities, delays,
+ * retries with exponential backoff, dead-letter queues, dependencies,
+ * concurrency limits, progress/cancellation, cron schedules, middleware
+ * and graceful shutdown.
+ */
+
+const DEFAULT_QUEUE = 'default';
+const DEFAULT_PRIORITY = 5;
+const DEFAULT_MAX_RETRIES = 3;
+const DEFAULT_BACKOFF_MS = 1000;
+const DEFAULT_SHUTDOWN_TIMEOUT_MS = 30000;
+
+export type TaskStatus =
+  | 'pending'
+  | 'processing'
+  | 'completed'
+  | 'failed'
+  | 'cancelled';
+
+export interface EnqueueOptions {
+  /** 1 (highest) .. 10 (lowest). Defaults to 5. */
+  priority?: number;
+  /** Milliseconds to wait before the task becomes available. */
+  delay?: number;
+  /** Absolute time at which the task becomes available. */
+  runAt?: Date;
+  /** How many times the task may be retried after the first attempt. */
+  maxRetries?: number;
+  /** Base delay for the exponential backoff between retries. */
+  backoffMs?: number;
+  /** Ids of tasks that must complete before this one becomes available. */
+  dependsOn?: string[];
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type ProgressCallback = (info: ProgressInfo) => void;
+
+export interface Task {
+  id: string;
+  queueName: string;
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  payload: any;
+  status: TaskStatus;
+  priority: number;
+  createdAt: Date;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  dependsOn: string[];
+  failCount: number;
+  lastError?: string;
+  progress?: ProgressInfo;
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: TaskStatus;
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export type TaskHandler = (task: Task) => void | Promise<void>;
+export type Middleware = (
+  task: Task,
+  next: () => Promise<void>,
+) => void | Promise<void>;
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  taskTemplate: any;
+  active: boolean;
+}
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+export type ShutdownCallback = () => void | Promise<void>;
+
+interface ScheduleState extends Schedule {
+  periodMs: number;
+  nextRunAt: number;
+}
+
+interface QueueState {
+  name: string;
+  /** Tasks awaiting execution, in insertion order. */
+  pending: Task[];
+  /** Ids of tasks currently in `processing` status. */
+  processing: Set<string>;
+  dlq: Task[];
+  concurrency: number;
+  middleware: Middleware[];
+}
+
+function createId(): string {
+  const webCrypto = (globalThis as { crypto?: { randomUUID?: () => string } })
+    .crypto;
+  if (webCrypto && typeof webCrypto.randomUUID === 'function') {
+    return webCrypto.randomUUID();
+  }
+  // RFC 4122 v4 shaped fallback for runtimes without randomUUID.
+  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (ch) => {
+    const rand = (Math.random() * 16) | 0;
+    const value = ch === 'x' ? rand : (rand & 0x3) | 0x8;
+    return value.toString(16);
+  });
+}
+
+/**
+ * Translates the supported cron subset into a fixed period in milliseconds.
+ * Supported: `*&#47;N * * * *`, `0 * * * *`, `0 0 * * *`, `0 *&#47;N * * *`.
+ */
+function cronPeriodMs(expression: string): number {
+  const parts = expression.trim().split(/\s+/);
+  if (parts.length !== 5) {
+    throw new Error(`Unsupported cron expression: ${expression}`);
+  }
+  const [minute, hour, dayOfMonth, month, dayOfWeek] = parts;
+  if (dayOfMonth !== '*' || month !== '*' || dayOfWeek !== '*') {
+    throw new Error(`Unsupported cron expression: ${expression}`);
+  }
+
+  const everyNMinutes = /^\*\/(\d+)$/.exec(minute);
+  if (everyNMinutes && hour === '*') {
+    const n = Number(everyNMinutes[1]);
+    if (n <= 0) throw new Error(`Unsupported cron expression: ${expression}`);
+    return n * 60_000;
+  }
+  if (minute === '0' && hour === '*') return 3_600_000;
+  if (minute === '0' && hour === '0') return 86_400_000;
+
+  const everyNHours = /^\*\/(\d+)$/.exec(hour);
+  if (minute === '0' && everyNHours) {
+    const n = Number(everyNHours[1]);
+    if (n <= 0) throw new Error(`Unsupported cron expression: ${expression}`);
+    return n * 3_600_000;
+  }
+  throw new Error(`Unsupported cron expression: ${expression}`);
+}
+
+function nextBoundaryAfter(now: number, periodMs: number): number {
+  return Math.floor(now / periodMs) * periodMs + periodMs;
+}
+
+function errorMessage(error: unknown): string | undefined {
+  if (error === undefined || error === null) return undefined;
+  if (error instanceof Error) return error.message;
+  return typeof error === 'string' ? error : String(error);
+}
+
+export class TaskQueue {
+  private readonly queues = new Map<string, QueueState>();
+  private readonly tasks = new Map<string, Task>();
+  private readonly progressListeners = new Map<string, Set<ProgressCallback>>();
+  private readonly schedules = new Map<string, ScheduleState>();
+  private readonly shutdownCallbacks: ShutdownCallback[] = [];
+
+  private shuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  /** Tasks that were still processing when shutdown began. */
+  private shutdownWatch = new Set<string>();
+  private shutdownCompleted = 0;
+  private shutdownCancelled = 0;
+  private finishShutdown: (() => void) | null = null;
+
+  // ---------------------------------------------------------------- queues
+
+  private getQueue(name: string): QueueState | undefined {
+    return this.queues.get(name);
+  }
+
+  private ensureQueue(name: string): QueueState {
+    let queue = this.queues.get(name);
+    if (!queue) {
+      queue = {
+        name,
+        pending: [],
+        processing: new Set(),
+        dlq: [],
+        concurrency: Infinity,
+        middleware: [],
+      };
+      this.queues.set(name, queue);
+    }
+    return queue;
+  }
+
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  /** Pending tasks in a queue, or across every queue when omitted. */
+  size(queueName?: string): number {
+    if (queueName !== undefined) return this.queueSize(queueName);
+    let total = 0;
+    for (const queue of this.queues.values()) total += queue.pending.length;
+    return total;
+  }
+
+  queueSize(queueName: string): number {
+    return this.getQueue(queueName)?.pending.length ?? 0;
+  }
+
+  // --------------------------------------------------------------- enqueue
+
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  enqueue(queueName: string, payload?: any, options?: EnqueueOptions): Task;
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  enqueue(payload: any, options?: EnqueueOptions): Task;
+  enqueue(
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    queueNameOrPayload?: any,
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    payloadOrOptions?: any,
+    maybeOptions?: EnqueueOptions,
+  ): Task {
+    if (this.shuttingDown) {
+      throw new Error('TaskQueue is shutting down; enqueue is not allowed');
+    }
+
+    let queueName = DEFAULT_QUEUE;
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    let payload: any;
+    let options: EnqueueOptions;
+
+    if (typeof queueNameOrPayload === 'string') {
+      queueName = queueNameOrPayload;
+      payload = payloadOrOptions;
+      options = maybeOptions ?? {};
+    } else {
+      payload = queueNameOrPayload;
+      options = (payloadOrOptions as EnqueueOptions) ?? {};
+    }
+
+    const priority = options.priority ?? DEFAULT_PRIORITY;
+    if (!Number.isFinite(priority) || priority < 1 || priority > 10) {
+      throw new Error(`Priority must be between 1 and 10, received ${priority}`);
+    }
+
+    const now = Date.now();
+    let availableAt = now;
+    if (options.delay !== undefined) {
+      if (!Number.isFinite(options.delay) || options.delay < 0) {
+        throw new Error(`Invalid delay: ${options.delay}`);
+      }
+      availableAt = now + options.delay;
+    }
+    if (options.runAt !== undefined) {
+      availableAt = Math.max(availableAt, options.runAt.getTime());
+    }
+
+    const dependsOn = options.dependsOn ?? [];
+    const id = createId();
+    this.validateDependencies(id, dependsOn);
+
+    const task: Task = {
+      id,
+      queueName,
+      payload,
+      status: 'pending',
+      priority,
+      createdAt: new Date(now),
+      availableAt: new Date(availableAt),
+      attempts: 0,
+      maxRetries: options.maxRetries ?? DEFAULT_MAX_RETRIES,
+      backoffMs: options.backoffMs ?? DEFAULT_BACKOFF_MS,
+      dependsOn: [...dependsOn],
+      failCount: 0,
+    };
+
+    this.tasks.set(task.id, task);
+    this.ensureQueue(queueName).pending.push(task);
+    return task;
+  }
+
+  // --------------------------------------------------------------- dequeue
+
+  dequeue(queueName: string = DEFAULT_QUEUE): Task | null {
+    const queue = this.getQueue(queueName);
+    if (!queue) return null;
+    if (queue.processing.size >= queue.concurrency) return null;
+
+    const now = Date.now();
+    let bestIndex = -1;
+    for (let i = 0; i < queue.pending.length; i++) {
+      const candidate = queue.pending[i];
+      if (!this.isAvailable(candidate, now)) continue;
+      if (bestIndex === -1 || this.comesFirst(candidate, queue.pending[bestIndex])) {
+        bestIndex = i;
+      }
+    }
+    if (bestIndex === -1) return null;
+
+    const [task] = queue.pending.splice(bestIndex, 1);
+    task.status = 'processing';
+    task.attempts += 1;
+    queue.processing.add(task.id);
+    return task;
+  }
+
+  private isAvailable(task: Task, now: number): boolean {
+    if (task.status !== 'pending') return false;
+    if (task.availableAt.getTime() > now) return false;
+    return this.dependenciesSatisfied(task);
+  }
+
+  private dependenciesSatisfied(task: Task): boolean {
+    return task.dependsOn.every(
+      (depId) => this.tasks.get(depId)?.status === 'completed',
+    );
+  }
+
+  /** Priority first, then availability time, then insertion order. */
+  private comesFirst(a: Task, b: Task): boolean {
+    if (a.priority !== b.priority) return a.priority < b.priority;
+    return a.availableAt.getTime() < b.availableAt.getTime();
+  }
+
+  // ------------------------------------------------------- complete / fail
+
+  complete(taskId: string): Task | null {
+    const task = this.tasks.get(taskId);
+    if (!task) return null;
+    if (task.status === 'completed' || task.status === 'cancelled') return task;
+
+    this.removeFromPending(task);
+    this.releaseSlot(task);
+    task.status = 'completed';
+    this.noteShutdownSettled(task);
+    return task;
+  }
+
+  fail(taskId: string, error?: unknown): Task | null {
+    const task = this.tasks.get(taskId);
+    if (!task) return null;
+    // Cancelled and already-finished tasks are never retried.
+    if (task.status === 'cancelled' || task.status === 'completed') return task;
+
+    this.removeFromPending(task);
+    this.releaseSlot(task);
+    task.lastError = errorMessage(error);
+    task.failCount += 1;
+
+    if (task.attempts <= task.maxRetries) {
+      const backoff = task.backoffMs * Math.pow(2, Math.max(task.attempts - 1, 0));
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + backoff);
+      this.ensureQueue(task.queueName).pending.push(task);
+    } else {
+      task.status = 'failed';
+      this.ensureQueue(task.queueName).dlq.push(task);
+    }
+    this.noteShutdownSettled(task);
+    return task;
+  }
+
+  private removeFromPending(task: Task): void {
+    const queue = this.getQueue(task.queueName);
+    if (!queue) return;
+    const index = queue.pending.indexOf(task);
+    if (index !== -1) queue.pending.splice(index, 1);
+  }
+
+  private releaseSlot(task: Task): void {
+    this.getQueue(task.queueName)?.processing.delete(task.id);
+  }
+
+  // ------------------------------------------------------------------ DLQ
+
+  getDLQ(queueName: string): Task[] {
+    return [...(this.getQueue(queueName)?.dlq ?? [])];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    for (const queue of this.queues.values()) {
+      const index = queue.dlq.findIndex((task) => task.id === taskId);
+      if (index === -1) continue;
+
+      const [task] = queue.dlq.splice(index, 1);
+      task.status = 'pending';
+      task.attempts = 0;
+      task.availableAt = new Date(Date.now());
+      queue.pending.push(task);
+      return task;
+    }
+    return null;
+  }
+
+  clearDLQ(queueName: string): void {
+    const queue = this.getQueue(queueName);
+    if (queue) queue.dlq = [];
+  }
+
+  // --------------------------------------------------------- dependencies
+
+  private validateDependencies(newTaskId: string, dependsOn: string[]): void {
+    for (const depId of dependsOn) {
+      if (!this.tasks.has(depId)) {
+        throw new Error(`Dependency task not found: ${depId}`);
+      }
+    }
+
+    // Walk the transitive dependency graph; reaching the new task means the
+    // edge we are about to add closes a cycle.
+    const seen = new Set<string>();
+    const stack = [...dependsOn];
+    while (stack.length > 0) {
+      const current = stack.pop() as string;
+      if (current === newTaskId) {
+        throw new Error(`Circular dependency detected for task ${newTaskId}`);
+      }
+      if (seen.has(current)) continue;
+      seen.add(current);
+      const task = this.tasks.get(current);
+      if (task) stack.push(...task.dependsOn);
+    }
+  }
+
+  getDependencies(taskId: string): DependencyInfo[] {
+    const task = this.tasks.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map((depId) => ({
+      taskId: depId,
+      status: this.tasks.get(depId)?.status ?? 'failed',
+    }));
+  }
+
+  // ---------------------------------------------------------- concurrency
+
+  setConcurrency(queueName: string, limit: number): void {
+    if (!Number.isFinite(limit) && limit !== Infinity) {
+      throw new Error(`Invalid concurrency limit: ${limit}`);
+    }
+    if (limit < 0) throw new Error(`Invalid concurrency limit: ${limit}`);
+    this.ensureQueue(queueName).concurrency = limit === 0 ? Infinity : limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const queue = this.getQueue(queueName);
+    return {
+      current: queue?.processing.size ?? 0,
+      max: queue?.concurrency ?? Infinity,
+    };
+  }
+
+  // ---------------------------------------------- progress & cancellation
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (!Number.isFinite(percent) || percent < 0 || percent > 100) {
+      throw new Error(`Progress percent must be between 0 and 100, got ${percent}`);
+    }
+    const task = this.tasks.get(taskId);
+    if (!task) throw new Error(`Task not found: ${taskId}`);
+
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    task.progress = info;
+    const listeners = this.progressListeners.get(taskId);
+    if (listeners) {
+      for (const listener of [...listeners]) listener(info);
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.tasks.get(taskId)?.progress ?? null;
+  }
+
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    let listeners = this.progressListeners.get(taskId);
+    if (!listeners) {
+      listeners = new Set();
+      this.progressListeners.set(taskId, listeners);
+    }
+    listeners.add(callback);
+    return () => {
+      listeners?.delete(callback);
+    };
+  }
+
+  cancel(taskId: string): boolean {
+    const task = this.tasks.get(taskId);
+    if (!task) return false;
+    if (task.status === 'completed' || task.status === 'cancelled') return false;
+
+    this.removeFromPending(task);
+    this.releaseSlot(task);
+    task.status = 'cancelled';
+    this.noteShutdownSettled(task);
+    return true;
+  }
+
+  // ----------------------------------------------------------- schedules
+
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  schedule(queueName: string, cronExpression: string, taskTemplate: any): Schedule {
+    const periodMs = cronPeriodMs(cronExpression);
+    this.ensureQueue(queueName);
+
+    const state: ScheduleState = {
+      id: createId(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+      periodMs,
+      nextRunAt: nextBoundaryAfter(Date.now(), periodMs),
+    };
+    this.schedules.set(state.id, state);
+    return state;
+  }
+
+  unschedule(scheduleId: string): boolean {
+    const state = this.schedules.get(scheduleId);
+    if (!state) return false;
+    state.active = false;
+    return true;
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    return [...this.schedules.values()].filter(
+      (state) =>
+        state.active && (queueName === undefined || state.queueName === queueName),
+    );
+  }
+
+  /** Enqueues a task for every schedule whose next occurrence is now due. */
+  tick(): Task[] {
+    if (this.shuttingDown) return [];
+    const now = Date.now();
+    const created: Task[] = [];
+
+    for (const state of this.schedules.values()) {
+      if (!state.active) continue;
+      while (state.nextRunAt <= now) {
+        created.push(this.enqueue(state.queueName, state.taskTemplate));
+        state.nextRunAt += state.periodMs;
+      }
+    }
+    return created;
+  }
+
+  // ---------------------------------------------------------- middleware
+
+  use(queueName: string, middleware: Middleware): void {
+    this.ensureQueue(queueName).middleware.push(middleware);
+  }
+
+  /** Dequeues one task and runs it through the middleware stack and handler. */
+  async process(queueName: string, handler: TaskHandler): Promise<Task | null> {
+    const task = this.dequeue(queueName);
+    if (!task) return null;
+
+    const stack = [...(this.getQueue(queueName)?.middleware ?? [])];
+    let lastCalled = -1;
+    const dispatch = async (index: number): Promise<void> => {
+      if (index <= lastCalled) {
+        throw new Error('next() called multiple times in the same middleware');
+      }
+      lastCalled = index;
+      if (index < stack.length) {
+        await stack[index](task, () => dispatch(index + 1));
+      } else {
+        await handler(task);
+      }
+    };
+
+    try {
+      await dispatch(0);
+    } catch (error) {
+      this.fail(task.id, error);
+      return task;
+    }
+    // A middleware that never calls next() simply skips the handler; the task
+    // is still considered settled rather than left dangling in `processing`.
+    if (task.status === 'processing') this.complete(task.id);
+    return task;
+  }
+
+  // ------------------------------------------------------------ shutdown
+
+  onShutdown(callback: ShutdownCallback): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  shutdown(timeout: number = DEFAULT_SHUTDOWN_TIMEOUT_MS): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+
+    this.shuttingDown = true;
+    const startedAt = Date.now();
+    this.shutdownCompleted = 0;
+    this.shutdownCancelled = 0;
+    this.shutdownWatch = new Set<string>();
+    for (const queue of this.queues.values()) {
+      for (const id of queue.processing) this.shutdownWatch.add(id);
+    }
+
+    for (const callback of this.shutdownCallbacks) {
+      try {
+        void callback();
+      } catch {
+        // A failing shutdown hook must not block the shutdown itself.
+      }
+    }
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      const summarize = (): ShutdownSummary => ({
+        completed: this.shutdownCompleted,
+        cancelled: this.shutdownCancelled,
+        elapsed: Date.now() - startedAt,
+      });
+
+      if (this.shutdownWatch.size === 0) {
+        this.finishShutdown = null;
+        resolve(summarize());
+        return;
+      }
+
+      let settled = false;
+      const timer = setTimeout(() => {
+        // Anything still in flight past the deadline is force-cancelled.
+        for (const id of [...this.shutdownWatch]) {
+          const task = this.tasks.get(id);
+          this.shutdownWatch.delete(id);
+          if (!task) continue;
+          this.releaseSlot(task);
+          task.status = 'cancelled';
+          this.shutdownCancelled += 1;
+        }
+        finish();
+      }, timeout);
+
+      const finish = () => {
+        if (settled) return;
+        settled = true;
+        this.finishShutdown = null;
+        clearTimeout(timer);
+        resolve(summarize());
+      };
+
+      this.finishShutdown = finish;
+    });
+
+    return this.shutdownPromise;
+  }
+
+  /**
+   * Records that a task being awaited by an in-progress shutdown has reached a
+   * terminal (or re-queued) state, and finishes the shutdown once none remain.
+   */
+  private noteShutdownSettled(task: Task): void {
+    if (!this.shutdownWatch.has(task.id)) return;
+    this.shutdownWatch.delete(task.id);
+    if (task.status === 'completed') this.shutdownCompleted += 1;
+    else if (task.status === 'cancelled') this.shutdownCancelled += 1;
+    if (this.shutdownWatch.size === 0) this.finishShutdown?.();
+  }
+}
+
+export default TaskQueue;
