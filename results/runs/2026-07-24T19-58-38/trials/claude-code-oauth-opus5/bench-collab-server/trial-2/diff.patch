index 0000000..3166a27
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,139 @@
+/**
+ * Data access for documents and their version history.
+ *
+ * Every mutation writes a row to `versions`, so any past state of a document
+ * can be retrieved and concurrent operations can be transformed against the
+ * operations that were committed since a client last synced.
+ */
+import { randomUUID } from 'node:crypto';
+import type { DB } from './db.js';
+import type { Document, Operation, Version, VersionRow } from './models.js';
+
+function decodeVersion(row: VersionRow): Version {
+  return {
+    ...row,
+    operation: row.operation ? (JSON.parse(row.operation) as Operation) : null,
+  };
+}
+
+export function listDocuments(db: DB): Document[] {
+  return db.prepare('SELECT * FROM documents ORDER BY created_at ASC, id ASC').all() as Document[];
+}
+
+export function getDocument(db: DB, id: string): Document | undefined {
+  return db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Document | undefined;
+}
+
+export function createDocument(db: DB, title: string, content = ''): Document {
+  const id = randomUUID();
+  const insert = db.transaction(() => {
+    db.prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?)').run(id, title, content);
+    db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)'
+    ).run(id, content);
+  });
+  insert();
+  return getDocument(db, id) as Document;
+}
+
+/** Update title and/or content; a content change is recorded as a new version. */
+export function updateDocument(
+  db: DB,
+  id: string,
+  changes: { title?: string; content?: string }
+): Document | undefined {
+  const existing = getDocument(db, id);
+  if (!existing) return undefined;
+
+  const title = changes.title ?? existing.title;
+  const content = changes.content ?? existing.content;
+
+  const update = db.transaction(() => {
+    db.prepare(
+      "UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?"
+    ).run(title, content, id);
+    if (content !== existing.content) {
+      db.prepare(
+        'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, NULL)'
+      ).run(id, currentVersion(db, id) + 1, content);
+    }
+  });
+  update();
+
+  return getDocument(db, id);
+}
+
+export function deleteDocument(db: DB, id: string): boolean {
+  return db.prepare('DELETE FROM documents WHERE id = ?').run(id).changes > 0;
+}
+
+export function listVersions(db: DB, id: string): Version[] {
+  const rows = db
+    .prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC')
+    .all(id) as VersionRow[];
+  return rows.map(decodeVersion);
+}
+
+export function getVersion(db: DB, id: string, version: number): Version | undefined {
+  const row = db
+    .prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?')
+    .get(id, version) as VersionRow | undefined;
+  return row ? decodeVersion(row) : undefined;
+}
+
+/** Highest committed version number for a document (0 when only the initial one exists). */
+export function currentVersion(db: DB, id: string): number {
+  const row = db
+    .prepare('SELECT MAX(version) AS version FROM versions WHERE document_id = ?')
+    .get(id) as { version: number | null } | undefined;
+  return row?.version ?? 0;
+}
+
+/** Content the document had at `version`, or undefined if that version is unknown. */
+export function contentAtVersion(db: DB, id: string, version: number): string | undefined {
+  const row = db
+    .prepare('SELECT content FROM versions WHERE document_id = ? AND version = ?')
+    .get(id, version) as { content: string } | undefined;
+  return row?.content;
+}
+
+/** Operations committed after `version`, oldest first. */
+export function operationsSince(db: DB, id: string, version: number): Operation[] {
+  const rows = db
+    .prepare(
+      'SELECT operation FROM versions WHERE document_id = ? AND version > ? ORDER BY version ASC'
+    )
+    .all(id, version) as { operation: string | null }[];
+  return rows
+    .filter((row): row is { operation: string } => row.operation !== null)
+    .map((row) => JSON.parse(row.operation) as Operation);
+}
+
+/**
+ * Persist the result of applying `op` and return the new version number.
+ * The document row and the history entry are written atomically.
+ */
+export function commitOperation(db: DB, id: string, content: string, op: Operation): number {
+  const commit = db.transaction(() => {
+    const version = currentVersion(db, id) + 1;
+    db.prepare(
+      "UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?"
+    ).run(content, id);
+    db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+    ).run(id, version, content, JSON.stringify(op));
+    return version;
+  });
+  return commit();
+}
+
+export function addConnection(db: DB, connectionId: string, documentId: string): void {
+  db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(
+    connectionId,
+    documentId
+  );
+}
+
+export function removeConnection(db: DB, connectionId: string): void {
+  db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);
+}
diff --git a/src/ws.ts b/src/ws.ts
new file mode 100644
index 0000000..16a52fe
--- /dev/null
+++ b/src/ws.ts
@@ -0,0 +1,185 @@
+/**
+ * WebSocket layer: one room per document, OT-based edit application.
+ *
+ * A client connects to `ws://host/<documentId>`, immediately receives a `sync`
+ * message with the current content and version, and then exchanges
+ * `operation` / `ack` messages. Operations are applied against the authoritative
+ * server state: an operation based on an older version is transformed against
+ * everything committed since, then persisted and broadcast to the rest of the
+ * room in its transformed form.
+ */
+import { randomUUID } from 'node:crypto';
+import type { Server as HttpServer } from 'node:http';
+import type { RawData } from 'ws';
+import { WebSocket, WebSocketServer } from 'ws';
+import type { DB } from './db.js';
+import type { Operation, ServerMessage } from './models.js';
+import { applyOperation, transformAgainstAll, validateOperation } from './ot.js';
+import {
+  addConnection,
+  commitOperation,
+  contentAtVersion,
+  currentVersion,
+  getDocument,
+  operationsSince,
+  removeConnection,
+} from './store.js';
+
+/** Rooms keyed by document id; each holds the sockets currently editing it. */
+type Rooms = Map<string, Set<WebSocket>>;
+
+function send(socket: WebSocket, message: ServerMessage): void {
+  if (socket.readyState === WebSocket.OPEN) {
+    socket.send(JSON.stringify(message));
+  }
+}
+
+function sendError(socket: WebSocket, message: string): void {
+  send(socket, { type: 'error', message });
+}
+
+function documentIdFromUrl(url: string | undefined): string {
+  const { pathname } = new URL(url ?? '/', 'http://localhost');
+  return decodeURIComponent(pathname.replace(/^\/+/, '').replace(/\/+$/, ''));
+}
+
+export function createWebSocketServer(server: HttpServer, db: DB): WebSocketServer {
+  const wss = new WebSocketServer({ server });
+  const rooms: Rooms = new Map();
+
+  const join = (docId: string, socket: WebSocket): void => {
+    let room = rooms.get(docId);
+    if (!room) {
+      room = new Set();
+      rooms.set(docId, room);
+    }
+    room.add(socket);
+  };
+
+  const leave = (docId: string, socket: WebSocket): void => {
+    const room = rooms.get(docId);
+    if (!room) return;
+    room.delete(socket);
+    if (room.size === 0) rooms.delete(docId);
+  };
+
+  const broadcast = (docId: string, sender: WebSocket, message: ServerMessage): void => {
+    const room = rooms.get(docId);
+    if (!room) return;
+    for (const peer of room) {
+      if (peer !== sender) send(peer, message);
+    }
+  };
+
+  const sendSync = (socket: WebSocket, docId: string): void => {
+    const doc = getDocument(db, docId);
+    if (!doc) {
+      sendError(socket, `document not found: ${docId}`);
+      return;
+    }
+    send(socket, { type: 'sync', content: doc.content, version: currentVersion(db, docId) });
+  };
+
+  const handleOperation = (socket: WebSocket, docId: string, payload: unknown, rawVersion: unknown): void => {
+    const doc = getDocument(db, docId);
+    if (!doc) {
+      sendError(socket, `document not found: ${docId}`);
+      return;
+    }
+
+    const serverVersion = currentVersion(db, docId);
+
+    // A client that omits its version is assumed to be up to date.
+    let baseVersion = serverVersion;
+    if (Number.isInteger(rawVersion)) {
+      baseVersion = Math.min(Math.max(rawVersion as number, 0), serverVersion);
+    }
+    const baseContent =
+      baseVersion === serverVersion ? doc.content : contentAtVersion(db, docId, baseVersion);
+    if (baseContent === undefined) {
+      sendError(socket, `unknown version: ${baseVersion}`);
+      return;
+    }
+
+    const validation = validateOperation(payload, baseContent.length);
+    if (!validation.valid) {
+      sendError(socket, validation.error ?? 'invalid operation');
+      return;
+    }
+
+    const operation = transformAgainstAll(
+      payload as Operation,
+      operationsSince(db, docId, baseVersion)
+    );
+    const content = applyOperation(doc.content, operation);
+    const version = commitOperation(db, docId, content, operation);
+
+    send(socket, { type: 'ack', version, operation });
+    broadcast(docId, socket, { type: 'operation', operation, version });
+  };
+
+  const handleMessage = (socket: WebSocket, docId: string, raw: RawData): void => {
+    let message: unknown;
+    try {
+      message = JSON.parse(raw.toString());
+    } catch {
+      sendError(socket, 'invalid JSON message');
+      return;
+    }
+
+    if (message === null || typeof message !== 'object' || Array.isArray(message)) {
+      sendError(socket, 'message must be an object');
+      return;
+    }
+
+    const { type, operation, version } = message as Record<string, unknown>;
+    switch (type) {
+      case 'operation':
+        handleOperation(socket, docId, operation, version);
+        break;
+      case 'sync':
+        sendSync(socket, docId);
+        break;
+      default:
+        sendError(socket, `unknown message type: ${String(type)}`);
+    }
+  };
+
+  wss.on('connection', (socket: WebSocket, req) => {
+    const docId = documentIdFromUrl(req.url);
+
+    if (!docId || !getDocument(db, docId)) {
+      sendError(socket, `document not found: ${docId}`);
+      socket.close(1008, 'document not found');
+      return;
+    }
+
+    const connectionId = randomUUID();
+    addConnection(db, connectionId, docId);
+    join(docId, socket);
+    sendSync(socket, docId);
+
+    const cleanup = (): void => {
+      leave(docId, socket);
+      try {
+        // Sockets can close while the server is shutting the database down.
+        if (db.open) removeConnection(db, connectionId);
+      } catch {
+        /* ignore */
+      }
+    };
+
+    socket.on('message', (raw: RawData) => {
+      try {
+        handleMessage(socket, docId, raw);
+      } catch (err) {
+        // A single bad message must never take down the room.
+        sendError(socket, err instanceof Error ? err.message : 'failed to process message');
+      }
+    });
+    socket.on('close', cleanup);
+    socket.on('error', cleanup);
+  });
+
+  return wss;
+}
