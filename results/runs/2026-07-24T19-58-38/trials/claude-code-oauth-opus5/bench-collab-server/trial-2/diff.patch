@@ -0,0 +1,101 @@
+/**
+ * REST API for document CRUD and version history.
+ */
+import { Router } from 'express';
+import type { DB } from './db.js';
+import {
+  createDocument,
+  deleteDocument,
+  getDocument,
+  getVersion,
+  listDocuments,
+  listVersions,
+  updateDocument,
+} from './store.js';
+
+export function createRoutes(db: DB): Router {
+  const router = Router();
+
+  router.post('/docs', (req, res) => {
+    const { title, content } = (req.body ?? {}) as { title?: unknown; content?: unknown };
+    if (typeof title !== 'string' || title.length === 0) {
+      res.status(400).json({ error: 'title is required' });
+      return;
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      res.status(400).json({ error: 'content must be a string' });
+      return;
+    }
+    res.status(201).json(createDocument(db, title, content ?? ''));
+  });
+
+  router.get('/docs', (_req, res) => {
+    res.json(listDocuments(db));
+  });
+
+  router.get('/docs/:id', (req, res) => {
+    const doc = getDocument(db, req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  router.put('/docs/:id', (req, res) => {
+    const { title, content } = (req.body ?? {}) as { title?: unknown; content?: unknown };
+    if (title !== undefined && typeof title !== 'string') {
+      res.status(400).json({ error: 'title must be a string' });
+      return;
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      res.status(400).json({ error: 'content must be a string' });
+      return;
+    }
+    const updated = updateDocument(db, req.params.id, {
+      title: title as string | undefined,
+      content: content as string | undefined,
+    });
+    if (!updated) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    res.json(updated);
+  });
+
+  router.delete('/docs/:id', (req, res) => {
+    if (!deleteDocument(db, req.params.id)) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    res.status(204).end();
+  });
+
+  router.get('/docs/:id/versions', (req, res) => {
+    if (!getDocument(db, req.params.id)) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    res.json(listVersions(db, req.params.id));
+  });
+
+  router.get('/docs/:id/versions/:version', (req, res) => {
+    if (!getDocument(db, req.params.id)) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    const version = Number(req.params.version);
+    if (!Number.isInteger(version)) {
+      res.status(400).json({ error: 'version must be an integer' });
+      return;
+    }
+    const found = getVersion(db, req.params.id, version);
+    if (!found) {
+      res.status(404).json({ error: 'version not found' });
+      return;
+    }
+    res.json(found);
+  });
+
+  return router;
+}
