+/**
+ * Shared domain types for the collaborative editing server.
+ */
+
+/** A document row as stored in the `documents` table. */
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+/** A version row as stored in the `versions` table (operation is raw JSON). */
+export interface VersionRow {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+/** A version as returned by the REST API (operation is decoded). */
+export interface Version extends Omit<VersionRow, 'operation'> {
+  operation: Operation | null;
+}
+
+/** A row of the `active_connections` table. */
+export interface ActiveConnection {
+  id: string;
+  document_id: string;
+  connected_at: string;
+}
+
+/** Insert `text` so that it starts at `position` in the document. */
+export interface InsertOperation {
+  type: 'insert';
+  position: number;
+  text: string;
+}
+
+/** Remove `count` characters starting at `position`. */
+export interface DeleteOperation {
+  type: 'delete';
+  position: number;
+  count: number;
+}
+
+export type Operation = InsertOperation | DeleteOperation;
+
+/** Messages a client may send over the WebSocket. */
+export interface ClientMessage {
+  type: string;
+  operation?: unknown;
+  version?: unknown;
+}
+
+/** Messages the server sends over the WebSocket. */
+export type ServerMessage =
+  | { type: 'sync'; content: string; version: number }
+  | { type: 'ack'; version: number; operation: Operation }
+  | { type: 'operation'; operation: Operation; version: number }
+  | { type: 'error'; message: string };
