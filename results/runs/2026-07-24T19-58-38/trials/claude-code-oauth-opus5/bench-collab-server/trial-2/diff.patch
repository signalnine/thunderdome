index 0000000..cfcae47
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,87 @@
+/**
+ * Application entry point: Express REST API and WebSocket server sharing a
+ * single HTTP server (and therefore a single port).
+ */
+import { createServer, type Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import type { Socket } from 'node:net';
+import express, { type Express } from 'express';
+import { WebSocket, type WebSocketServer } from 'ws';
+import { createDatabase, type DB } from './db.js';
+import { createRoutes } from './routes.js';
+import { createWebSocketServer } from './ws.js';
+
+export interface AppInstance {
+  app: Express;
+  server: Server;
+  wss: WebSocketServer;
+  db: DB;
+  /** Start listening; resolves with the port actually bound (0 picks a free one). */
+  start(port?: number): Promise<number>;
+  /** Close every connection, the HTTP server and the database. */
+  stop(): Promise<void>;
+}
+
+/** How long clients get to close politely before their sockets are destroyed. */
+const SHUTDOWN_GRACE_MS = 100;
+
+export function createApp(dbPath?: string): AppInstance {
+  const db = createDatabase(dbPath);
+  const app = express();
+
+  app.use(express.json());
+  app.use(createRoutes(db));
+
+  const server = createServer(app);
+  const wss = createWebSocketServer(server, db);
+
+  // Track raw sockets so shutdown can never hang on a keep-alive connection.
+  const sockets = new Set<Socket>();
+  server.on('connection', (socket: Socket) => {
+    sockets.add(socket);
+    socket.on('close', () => sockets.delete(socket));
+  });
+
+  const start = (port = 0): Promise<number> =>
+    new Promise((resolve, reject) => {
+      if (server.listening) {
+        resolve((server.address() as AddressInfo).port);
+        return;
+      }
+      server.once('error', reject);
+      server.listen(port, () => {
+        server.removeListener('error', reject);
+        resolve((server.address() as AddressInfo).port);
+      });
+    });
+
+  const stop = (): Promise<void> =>
+    new Promise((resolve) => {
+      for (const client of wss.clients) {
+        if (client.readyState === WebSocket.OPEN) {
+          client.close(1001, 'server shutting down');
+        }
+      }
+      wss.close();
+
+      const force = setTimeout(() => {
+        for (const client of wss.clients) client.terminate();
+        for (const socket of sockets) socket.destroy();
+      }, SHUTDOWN_GRACE_MS);
+
+      const finish = (): void => {
+        clearTimeout(force);
+        if (db.open) db.close();
+        resolve();
+      };
+
+      if (server.listening) {
+        server.close(() => finish());
+      } else {
+        for (const socket of sockets) socket.destroy();
+        finish();
+      }
+    });
+
+  return { app, server, wss, db, start, stop };
+}
