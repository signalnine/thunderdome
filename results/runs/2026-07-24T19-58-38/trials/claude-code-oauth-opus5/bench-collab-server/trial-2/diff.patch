rt function updateDocument(\n  db: DB,\n  id: string,\n  changes: { title?: string; content?: string }\n): Document | undefined {\n  const existing = getDocument(db, id);\n  if (!existing) return undefined;\n\n  const title = changes.title ?? existing.title;\n  const content = changes.content ?? existing.content;\n\n  const update = db.transaction(() => {\n    db.prepare(\n      \"UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?\"\n    ).run(title, content, id);\n    if (content !== existing.content) {\n      db.prepare(\n        'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, NULL)'\n      ).run(id, currentVersion(db, id) + 1, content);\n    }\n  });\n  update();\n\n  return getDocument(db, id);\n}\n\nexport function deleteDocument(db: DB, id: string): boolean {\n  return db.prepare('DELETE FROM documents WHERE id = ?').run(id).changes > 0;\n}\n\nexport function listVersions(db: DB, id: string): Version[] {\n  const rows = db\n    .prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC')\n    .all(id) as VersionRow[];\n  return rows.map(decodeVersion);\n}\n\nexport function getVersion(db: DB, id: string, version: number): Version | undefined {\n  const row = db\n    .prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?')\n    .get(id, version) as VersionRow | undefined;\n  return row ? decodeVersion(row) : undefined;\n}\n\n/** Highest committed version number for a document (0 when only the initial one exists). */\nexport function currentVersion(db: DB, id: string): number {\n  const row = db\n    .prepare('SELECT MAX(version) AS version FROM versions WHERE document_id = ?')\n    .get(id) as { version: number | null } | undefined;\n  return row?.version ?? 0;\n}\n\n/** Content the document had at `version`, or undefined if that version is unknown. */\nexport function contentAtVersion(db: DB, id: string, version: number): string | undefined {\n  const row = db\n    .prepare('SELECT content FROM versions WHERE document_id = ? AND version = ?')\n    .get(id, version) as { content: string } | undefined;\n  return row?.content;\n}\n\n/** Operations committed after `version`, oldest first. */\nexport function operationsSince(db: DB, id: string, version: number): Operation[] {\n  const rows = db\n    .prepare(\n      'SELECT operation FROM versions WHERE document_id = ? AND version > ? ORDER BY version ASC'\n    )\n    .all(id, version) as { operation: string | null }[];\n  return rows\n    .filter((row): row is { operation: string } => row.operation !== null)\n    .map((row) => JSON.parse(row.operation) as Operation);\n}\n\n/**\n * Persist the result of applying `op` and return the new version number.\n * The document row and the history entry are written atomically.\n */\nexport function commitOperation(db: DB, id: string, content: string, op: Operation): number {\n  const commit = db.transaction(() => {\n    const version = currentVersion(db, id) + 1;\n    db.prepare(\n      \"UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?\"\n    ).run(content, id);\n    db.prepare(\n      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'\n    ).run(id, version, content, JSON.stringify(op));\n    return version;\n  });\n  return commit();\n}\n\nexport function addConnection(db: DB, connectionId: string, documentId: string): void {\n  db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(\n    connectionId,\n    documentId\n  );\n}\n\nexport function removeConnection(db: DB, connectionId: string): void {\n  db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
