+/**
+ * Database setup: applies schema.sql to a new better-sqlite3 connection.
+ */
+import { existsSync, readFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import Database from 'better-sqlite3';
+
+export type DB = Database.Database;
+
+const moduleDir = dirname(fileURLToPath(import.meta.url));
+
+/** Locate schema.sql relative to this module (works from src/ and dist/). */
+function schemaPath(): string {
+  const candidates = [
+    join(moduleDir, '..', 'schema.sql'),
+    join(moduleDir, '..', '..', 'schema.sql'),
+    join(process.cwd(), 'schema.sql'),
+  ];
+  const found = candidates.find((candidate) => existsSync(candidate));
+  if (!found) {
+    throw new Error(`schema.sql not found (looked in: ${candidates.join(', ')})`);
+  }
+  return found;
+}
+
+/**
+ * Create a connection, apply the schema and reset transient state.
+ *
+ * @param dbPath File path for persistence, or `:memory:` (default) for an
+ *               ephemeral database.
+ */
+export function createDatabase(dbPath = ':memory:'): DB {
+  const db = new Database(dbPath);
+  db.pragma('foreign_keys = ON');
+  db.exec(readFileSync(schemaPath(), 'utf8'));
+  // Connections never survive a restart, so any rows left behind are stale.
+  db.exec('DELETE FROM active_connections');
+  return db;
+}
