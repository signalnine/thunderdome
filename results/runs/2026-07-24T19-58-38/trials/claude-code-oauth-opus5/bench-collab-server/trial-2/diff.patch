+/**
+ * Operational Transform primitives.
+ *
+ * The server keeps a linear history of operations. When a client sends an
+ * operation based on an older version, the operation is transformed against
+ * every operation that was committed since that version, so that the intent of
+ * both edits is preserved and all replicas converge.
+ */
+import type { DeleteOperation, Operation } from './models.js';
+
+export interface ValidationResult {
+  valid: boolean;
+  error?: string;
+}
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.min(Math.max(value, min), max);
+}
+
+/** Type guard for a well-formed operation payload of unknown provenance. */
+export function isOperation(value: unknown): value is Operation {
+  return validateOperation(value, Number.MAX_SAFE_INTEGER).valid;
+}
+
+/**
+ * Validate an operation's shape and its bounds against a document of
+ * `contentLength` characters.
+ */
+export function validateOperation(op: unknown, contentLength: number): ValidationResult {
+  if (op === null || typeof op !== 'object' || Array.isArray(op)) {
+    return { valid: false, error: 'operation must be an object' };
+  }
+
+  const candidate = op as { type?: unknown; position?: unknown; text?: unknown; count?: unknown };
+
+  if (candidate.type !== 'insert' && candidate.type !== 'delete') {
+    return { valid: false, error: `unknown operation type: ${String(candidate.type)}` };
+  }
+
+  if (!Number.isInteger(candidate.position)) {
+    return { valid: false, error: 'operation position must be an integer' };
+  }
+
+  const position = candidate.position as number;
+  if (position < 0 || position > contentLength) {
+    return {
+      valid: false,
+      error: `position ${position} out of bounds for document of length ${contentLength}`,
+    };
+  }
+
+  if (candidate.type === 'insert') {
+    if (typeof candidate.text !== 'string') {
+      return { valid: false, error: 'insert operation requires a text string' };
+    }
+    return { valid: true };
+  }
+
+  if (!Number.isInteger(candidate.count) || (candidate.count as number) < 0) {
+    return { valid: false, error: 'delete operation requires a non-negative integer count' };
+  }
+
+  const count = candidate.count as number;
+  if (position + count > contentLength) {
+    return {
+      valid: false,
+      error: `delete of ${count} at ${position} out of bounds for document of length ${contentLength}`,
+    };
+  }
+
+  return { valid: true };
+}
+
+/**
+ * Apply an operation to `content`, returning the new content.
+ *
+ * Positions are clamped defensively so a transformed operation can never throw
+ * or corrupt the document, even if it drifted out of range.
+ */
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    const position = clamp(op.position, 0, content.length);
+    return content.slice(0, position) + op.text + content.slice(position);
+  }
+
+  const position = clamp(op.position, 0, content.length);
+  const count = clamp(op.count, 0, content.length - position);
+  return content.slice(0, position) + content.slice(position + count);
+}
+
+/**
+ * Transform `op1` against `op2`, where `op2` has already been applied to the
+ * document. The result is `op1` rewritten so it can be applied on top of `op2`.
+ * `op2` wins ties, which gives a total order and therefore convergence.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    // Ties shift op1 to the right so that both insertions survive.
+    if (op1.position < op2.position) return op1;
+    return { ...op1, position: op1.position + op2.text.length };
+  }
+
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    if (op1.position <= op2.position) return op1;
+    if (op1.position >= op2.position + op2.count) {
+      return { ...op1, position: op1.position - op2.count };
+    }
+    // The insertion point was inside the removed range: collapse to its start.
+    return { ...op1, position: op2.position };
+  }
+
+  if (op1.type === 'delete' && op2.type === 'insert') {
+    const insertLength = op2.text.length;
+    if (op2.position <= op1.position) {
+      return { ...op1, position: op1.position + insertLength };
+    }
+    if (op2.position >= op1.position + op1.count) return op1;
+    // The text landed inside the range being removed; remove it as well so the
+    // deletion stays a single contiguous range.
+    return { ...op1, count: op1.count + insertLength };
+  }
+
+  const first = op1 as DeleteOperation;
+  const second = op2 as DeleteOperation;
+  const end1 = first.position + first.count;
+  const end2 = second.position + second.count;
+
+  if (second.position >= end1) return first;
+  if (end2 <= first.position) {
+    return { ...first, position: first.position - second.count };
+  }
+
+  // Overlapping deletions: drop the characters op2 already removed.
+  const overlap = Math.min(end1, end2) - Math.max(first.position, second.position);
+  const removedBefore = Math.max(0, Math.min(end2, first.position) - second.position);
+  return {
+    type: 'delete',
+    position: first.position - removedBefore,
+    count: Math.max(0, first.count - overlap),
+  };
+}
+
+/** Transform `op` against a sequence of already-applied operations, in order. */
+export function transformAgainstAll(op: Operation, applied: Operation[]): Operation {
+  return applied.reduce<Operation>((acc, other) => transformOperation(acc, other), op);
+}
