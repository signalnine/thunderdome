+/**
+ * SQLite setup and the data-access helpers shared by the REST routes and the
+ * WebSocket server.
+ */
+
+import { randomUUID } from 'node:crypto';
+import { existsSync, readFileSync } from 'node:fs';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import Database from 'better-sqlite3';
+
+import type { Document, Operation, Version } from './models.js';
+
+export type DatabaseHandle = Database.Database;
+
+/**
+ * Used when `schema.sql` cannot be located next to the compiled output (for
+ * example when this module is bundled). Kept byte-compatible with the file.
+ */
+const FALLBACK_SCHEMA = `
+CREATE TABLE IF NOT EXISTS documents (
+  id TEXT PRIMARY KEY,
+  title TEXT NOT NULL,
+  content TEXT NOT NULL DEFAULT '',
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  updated_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+
+CREATE TABLE IF NOT EXISTS versions (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  version INTEGER NOT NULL,
+  content TEXT NOT NULL,
+  operation TEXT,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  UNIQUE(document_id, version)
+);
+
+CREATE TABLE IF NOT EXISTS active_connections (
+  id TEXT PRIMARY KEY,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  connected_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+`;
+
+function loadSchema(): string {
+  const here = dirname(fileURLToPath(import.meta.url));
+  // Works both from `src/` during tests and from `dist/` after a build.
+  const candidates = [
+    join(here, 'schema.sql'),
+    resolve(here, '..', 'schema.sql'),
+    resolve(here, '..', '..', 'schema.sql'),
+  ];
+  for (const candidate of candidates) {
+    if (existsSync(candidate)) return readFileSync(candidate, 'utf8');
+  }
+  return FALLBACK_SCHEMA;
+}
+
+/**
+ * Open a database and apply the schema.
+ *
+ * @param dbPath File to persist to; defaults to a private in-memory database.
+ */
+export function createDatabase(dbPath = ':memory:'): DatabaseHandle {
+  const db = new Database(dbPath);
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+  db.exec(loadSchema());
+  // Connection rows only describe live sockets, so nothing survives a restart.
+  db.prepare('DELETE FROM active_connections').run();
+  return db;
+}
+
+// ------------------------------------------------------------------
+// Documents
+// ------------------------------------------------------------------
+
+/** Create a document plus its initial version (version 0). */
+export function createDocument(db: DatabaseHandle, title: string, content = ''): Document {
+  const id = randomUUID();
+  const insert = db.transaction(() => {
+    db.prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?)').run(id, title, content);
+    db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)'
+    ).run(id, content);
+  });
+  insert();
+  return getDocument(db, id) as Document;
+}
+
+export function getDocument(db: DatabaseHandle, id: string): Document | undefined {
+  return db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Document | undefined;
+}
+
+export function listDocuments(db: DatabaseHandle): Document[] {
+  return db.prepare('SELECT * FROM documents ORDER BY created_at ASC, id ASC').all() as Document[];
+}
+
+export function deleteDocument(db: DatabaseHandle, id: string): boolean {
+  const remove = db.transaction(() => {
+    db.prepare('DELETE FROM versions WHERE document_id = ?').run(id);
+    db.prepare('DELETE FROM active_connections WHERE document_id = ?').run(id);
+    return db.prepare('DELETE FROM documents WHERE id = ?').run(id).changes;
+  });
+  return remove() > 0;
+}
+
+/** Update the title and/or content of a document, recording a version when content changes. */
+export function updateDocument(
+  db: DatabaseHandle,
+  id: string,
+  changes: { title?: string; content?: string }
+): Document | undefined {
+  const existing = getDocument(db, id);
+  if (!existing) return undefined;
+
+  const title = changes.title ?? existing.title;
+  const content = changes.content ?? existing.content;
+
+  const update = db.transaction(() => {
+    db.prepare(
+      "UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?"
+    ).run(title, content, id);
+    if (content !== existing.content) {
+      appendVersion(db, id, content, null);
+    }
+  });
+  update();
+  return getDocument(db, id);
+}
+
+// ------------------------------------------------------------------
+// Versions
+// ------------------------------------------------------------------
+
+export function listVersions(db: DatabaseHandle, documentId: string): Version[] {
+  return db
+    .prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC')
+    .all(documentId) as Version[];
+}
+
+export function getVersion(
+  db: DatabaseHandle,
+  documentId: string,
+  version: number
+): Version | undefined {
+  return db
+    .prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?')
+    .get(documentId, version) as Version | undefined;
+}
+
+/** The highest version recorded for a document, or 0 when it has no history. */
+export function getCurrentVersion(db: DatabaseHandle, documentId: string): number {
+  const row = db
+    .prepare('SELECT MAX(version) AS version FROM versions WHERE document_id = ?')
+    .get(documentId) as { version: number | null } | undefined;
+  return row?.version ?? 0;
+}
+
+/** Every operation recorded after `version`, oldest first. */
+export function getOperationsSince(
+  db: DatabaseHandle,
+  documentId: string,
+  version: number
+): Operation[] {
+  const rows = db
+    .prepare(
+      'SELECT operation FROM versions WHERE document_id = ? AND version > ? AND operation IS NOT NULL ORDER BY version ASC'
+    )
+    .all(documentId, version) as { operation: string }[];
+
+  const operations: Operation[] = [];
+  for (const row of rows) {
+    try {
+      operations.push(JSON.parse(row.operation) as Operation);
+    } catch {
+      // A version row with unreadable JSON cannot participate in a transform;
+      // skipping it is better than failing the whole edit.
+    }
+  }
+  return operations;
+}
+
+/** Append a new version row, returning the version number it was given. */
+export function appendVersion(
+  db: DatabaseHandle,
+  documentId: string,
+  content: string,
+  operation: Operation | null
+): number {
+  const version = getCurrentVersion(db, documentId) + 1;
+  db.prepare(
+    'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+  ).run(documentId, version, content, operation ? JSON.stringify(operation) : null);
+  return version;
+}
+
+/** Persist an applied operation: update the document and record the new version. */
+export function commitOperation(
+  db: DatabaseHandle,
+  documentId: string,
+  content: string,
+  operation: Operation
+): number {
+  const commit = db.transaction(() => {
+    db.prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?").run(
+      content,
+      documentId
+    );
+    return appendVersion(db, documentId, content, operation);
+  });
+  return commit();
+}
+
+// ------------------------------------------------------------------
+// Active connections
+// ------------------------------------------------------------------
+
+export function addConnection(db: DatabaseHandle, documentId: string): string {
+  const id = randomUUID();
+  db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(id, documentId);
+  return id;
+}
+
+export function removeConnection(db: DatabaseHandle, id: string): void {
+  db.prepare('DELETE FROM active_connections WHERE id = ?').run(id);
+}
+
+export function clearConnections(db: DatabaseHandle): void {
+  db.prepare('DELETE FROM active_connections').run();
+}
