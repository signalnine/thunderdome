@@ -0,0 +1,87 @@
+/**
+ * Wires the REST API and the WebSocket server onto a single HTTP listener.
+ */
+
+import { createServer, type Server as HttpServer } from 'node:http';
+import type { AddressInfo } from 'node:net';
+
+import express, { type Express, type NextFunction, type Request, type Response } from 'express';
+import type { WebSocketServer } from 'ws';
+
+import { clearConnections, createDatabase, type DatabaseHandle } from './db.js';
+import { createRouter } from './routes.js';
+import { createWebSocketServer } from './ws.js';
+
+export interface AppInstance {
+  app: Express;
+  server: HttpServer;
+  wss: WebSocketServer;
+  db: DatabaseHandle;
+  /** Begin listening; resolves with the port actually bound (useful with port 0). */
+  start: (port?: number) => Promise<number>;
+  /** Close every socket, the HTTP server and the database. */
+  stop: () => Promise<void>;
+}
+
+/**
+ * Build a ready-to-start application.
+ *
+ * @param dbPath Path to the SQLite file; defaults to a private in-memory database.
+ */
+export function createApp(dbPath?: string): AppInstance {
+  const db = createDatabase(dbPath);
+
+  const app = express();
+  app.use(express.json({ limit: '5mb' }));
+  app.use(createRouter(db));
+
+  // Reject malformed JSON bodies rather than letting Express emit HTML.
+  app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
+    res.status(400).json({ error: err.message });
+  });
+
+  const server = createServer(app);
+  const wss = createWebSocketServer(server, db);
+
+  let listening = false;
+
+  const start = (port = 0): Promise<number> =>
+    new Promise<number>((resolvePort, reject) => {
+      const onError = (err: Error) => reject(err);
+      server.once('error', onError);
+      server.listen(port, () => {
+        server.removeListener('error', onError);
+        listening = true;
+        const address = server.address() as AddressInfo | string | null;
+        resolvePort(typeof address === 'object' && address !== null ? address.port : port);
+      });
+    });
+
+  const stop = (): Promise<void> =>
+    new Promise<void>((resolveStop) => {
+      const finish = () => {
+        try {
+          clearConnections(db);
+          db.close();
+        } catch {
+          // Already closed.
+        }
+        resolveStop();
+      };
+
+      for (const client of wss.clients) client.terminate();
+
+      wss.close(() => {
+        if (!listening) {
+          finish();
+          return;
+        }
+        listening = false;
+        // Drop keep-alive sockets so `close` is not held open by idle clients.
+        server.closeAllConnections?.();
+        server.close(() => finish());
+      });
+    });
+
+  return { app, server, wss, db, start, stop };
+}
