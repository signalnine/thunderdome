new file mode 100644
index 0000000..47faf8e
--- /dev/null
+++ b/src/routes.ts
@@ -0,0 +1,112 @@
+/**
+ * REST API for document CRUD and version history.
+ */
+
+import express, { type Request, type Response, type Router } from 'express';
+
+import {
+  createDocument,
+  deleteDocument,
+  getDocument,
+  getVersion,
+  listDocuments,
+  listVersions,
+  updateDocument,
+  type DatabaseHandle,
+} from './db.js';
+
+function notFound(res: Response): void {
+  res.status(404).json({ error: 'Document not found' });
+}
+
+export function createRouter(db: DatabaseHandle): Router {
+  const router = express.Router();
+
+  // POST /docs - create a document
+  router.post('/docs', (req: Request, res: Response) => {
+    const body = (req.body ?? {}) as { title?: unknown; content?: unknown };
+    const title = typeof body.title === 'string' && body.title.length > 0 ? body.title : 'Untitled';
+    if (body.content !== undefined && typeof body.content !== 'string') {
+      res.status(400).json({ error: 'content must be a string' });
+      return;
+    }
+    const document = createDocument(db, title, (body.content as string | undefined) ?? '');
+    res.status(201).json(document);
+  });
+
+  // GET /docs - list all documents
+  router.get('/docs', (_req: Request, res: Response) => {
+    res.status(200).json(listDocuments(db));
+  });
+
+  // GET /docs/:id/versions - full version history, oldest first
+  router.get('/docs/:id/versions', (req: Request, res: Response) => {
+    if (!getDocument(db, req.params.id)) {
+      notFound(res);
+      return;
+    }
+    res.status(200).json(listVersions(db, req.params.id));
+  });
+
+  // GET /docs/:id/versions/:version - a single point in history
+  router.get('/docs/:id/versions/:version', (req: Request, res: Response) => {
+    if (!getDocument(db, req.params.id)) {
+      notFound(res);
+      return;
+    }
+    const version = Number(req.params.version);
+    if (!Number.isInteger(version) || version < 0) {
+      res.status(400).json({ error: 'version must be a non-negative integer' });
+      return;
+    }
+    const record = getVersion(db, req.params.id, version);
+    if (!record) {
+      res.status(404).json({ error: 'Version not found' });
+      return;
+    }
+    res.status(200).json(record);
+  });
+
+  // GET /docs/:id - a single document
+  router.get('/docs/:id', (req: Request, res: Response) => {
+    const document = getDocument(db, req.params.id);
+    if (!document) {
+      notFound(res);
+      return;
+    }
+    res.status(200).json(document);
+  });
+
+  // PUT /docs/:id - update title and/or content
+  router.put('/docs/:id', (req: Request, res: Response) => {
+    const body = (req.body ?? {}) as { title?: unknown; content?: unknown };
+    if (body.title !== undefined && typeof body.title !== 'string') {
+      res.status(400).json({ error: 'title must be a string' });
+      return;
+    }
+    if (body.content !== undefined && typeof body.content !== 'string') {
+      res.status(400).json({ error: 'content must be a string' });
+      return;
+    }
+    const document = updateDocument(db, req.params.id, {
+      title: body.title as string | undefined,
+      content: body.content as string | undefined,
+    });
+    if (!document) {
+      notFound(res);
+      return;
+    }
+    res.status(200).json(document);
+  });
+
+  // DELETE /docs/:id
+  router.delete('/docs/:id', (req: Request, res: Response) => {
+    if (!deleteDocument(db, req.params.id)) {
+      notFound(res);
+      return;
+    }
+    res.status(204).end();
+  });
+
+  return router;
+}
