index 0000000..2dc5669
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,195 @@
+/**
+ * Operational Transform for plain-text documents.
+ *
+ * Two operation kinds are supported: `insert` (add text at a position) and
+ * `delete` (remove a run of characters). The server keeps a linear history of
+ * applied operations; an operation composed against an older version is
+ * transformed against every operation that landed since, which makes
+ * concurrent edits converge to the same content on every replica.
+ *
+ * The transform satisfies the convergence property TP1:
+ *
+ *   apply(apply(s, a), transform(b, a)) === apply(apply(s, b), transform(a, b))
+ *
+ * Two details are needed to get there. Insertions at the same position are
+ * ordered by a tie-break that is *asymmetric*, so exactly one of the two sides
+ * shifts. And a delete whose range is split by a concurrent insert becomes two
+ * deletes that step around the inserted text instead of swallowing it — which
+ * is why transforms return a list of operations rather than a single one.
+ */
+
+import type { DeleteOperation, InsertOperation, Operation } from './models.js';
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.max(min, Math.min(max, value));
+}
+
+/** True for operations that leave the document unchanged. */
+function isNoop(op: Operation): boolean {
+  return op.type === 'insert' ? op.text.length === 0 : op.count <= 0;
+}
+
+/** Narrow an unknown value to a structurally valid operation (bounds not checked). */
+export function isOperation(value: unknown): value is Operation {
+  if (typeof value !== 'object' || value === null) return false;
+  const op = value as Record<string, unknown>;
+  if (!Number.isInteger(op.position) || (op.position as number) < 0) return false;
+  if (op.type === 'insert') return typeof op.text === 'string';
+  if (op.type === 'delete') return Number.isInteger(op.count) && (op.count as number) >= 0;
+  return false;
+}
+
+/**
+ * Check that `op` is well formed and addresses characters that exist in a
+ * document of length `contentLength`.
+ */
+export function validateOperation(op: unknown, contentLength: number): op is Operation {
+  if (!isOperation(op)) return false;
+  if (op.position > contentLength) return false;
+  if (op.type === 'delete') {
+    if (op.count <= 0) return false;
+    if (op.position + op.count > contentLength) return false;
+  }
+  return true;
+}
+
+/** Return `content` with `op` applied. Positions are clamped so this never throws. */
+export function applyOperation(content: string, op: Operation): string {
+  const position = clamp(op.position, 0, content.length);
+  if (op.type === 'insert') {
+    return content.slice(0, position) + op.text + content.slice(position);
+  }
+  const count = clamp(op.count, 0, content.length - position);
+  return content.slice(0, position) + content.slice(position + count);
+}
+
+/** Apply operations in order. */
+export function applyOperations(content: string, ops: Operation[]): string {
+  return ops.reduce((acc, op) => applyOperation(acc, op), content);
+}
+
+/**
+ * Order two insertions that target the same position. Returns true when `a`
+ * should end up after `b`. The comparison must give opposite answers for
+ * (a, b) and (b, a), otherwise both peers shift and they diverge; when the
+ * texts are equal the resulting document is the same either way.
+ */
+function insertGoesAfter(a: InsertOperation, b: InsertOperation): boolean {
+  return a.text > b.text;
+}
+
+/**
+ * Transform `op1` so it can be applied to a document that has already had
+ * `op2` applied to it. Both operations are assumed to have been composed
+ * against the same original document.
+ *
+ * Returns the operations to apply in order. This is usually a single operation
+ * (or none, when `op1` was made redundant by `op2`), but a delete that a
+ * concurrent insert split down the middle becomes two.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation[] {
+  if (isNoop(op1)) return [];
+  if (isNoop(op2)) return [op1];
+
+  let result: Operation[];
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    result = [transformInsertInsert(op1, op2)];
+  } else if (op1.type === 'insert' && op2.type === 'delete') {
+    result = [transformInsertDelete(op1, op2)];
+  } else if (op1.type === 'delete' && op2.type === 'insert') {
+    result = transformDeleteInsert(op1, op2);
+  } else {
+    result = [transformDeleteDelete(op1 as DeleteOperation, op2 as DeleteOperation)];
+  }
+  return result.filter((op) => !isNoop(op));
+}
+
+function transformInsertInsert(op1: InsertOperation, op2: InsertOperation): InsertOperation {
+  if (op1.position < op2.position) return op1;
+  if (op1.position === op2.position && !insertGoesAfter(op1, op2)) return op1;
+  return { ...op1, position: op1.position + op2.text.length };
+}
+
+function transformInsertDelete(op1: InsertOperation, op2: DeleteOperation): InsertOperation {
+  if (op1.position <= op2.position) return op1;
+  if (op1.position >= op2.position + op2.count) {
+    return { ...op1, position: op1.position - op2.count };
+  }
+  // The insertion point was inside the removed range; collapse it to the start.
+  return { ...op1, position: op2.position };
+}
+
+function transformDeleteInsert(op1: DeleteOperation, op2: InsertOperation): DeleteOperation[] {
+  const end1 = op1.position + op1.count;
+  if (op2.position <= op1.position) {
+    return [{ ...op1, position: op1.position + op2.text.length }];
+  }
+  if (op2.position >= end1) return [op1];
+
+  // The insert landed strictly inside the range being deleted. Delete around
+  // it so the concurrent insertion survives, highest position first so the
+  // second delete's position stays valid.
+  const shift = op2.text.length;
+  return [
+    { type: 'delete', position: op2.position + shift, count: end1 - op2.position },
+    { type: 'delete', position: op1.position, count: op2.position - op1.position },
+  ];
+}
+
+function transformDeleteDelete(op1: DeleteOperation, op2: DeleteOperation): DeleteOperation {
+  const end1 = op1.position + op1.count;
+  const end2 = op2.position + op2.count;
+
+  if (op1.position >= end2) return { ...op1, position: op1.position - op2.count };
+  if (end1 <= op2.position) return op1;
+
+  // Ranges overlap: whatever op2 already removed must not be removed twice.
+  const overlap = Math.min(end1, end2) - Math.max(op1.position, op2.position);
+  const position = Math.min(op1.position, op2.position);
+  return { ...op1, position, count: Math.max(0, op1.count - overlap) };
+}
+
+/**
+ * Transform two concurrent sequences against each other.
+ *
+ * Returns `[as', bs']` where `as'` applies to a document that has already seen
+ * `bs`, and vice versa. Both sequences start from the same document state.
+ * Transforming element by element is not enough once an operation splits: the
+ * second half of a split sequence has to be transformed against a `b` that
+ * itself has been carried past the first half.
+ */
+function transformSequences(as: Operation[], bs: Operation[]): [Operation[], Operation[]] {
+  if (as.length === 0) return [[], bs];
+  if (bs.length === 0) return [as, []];
+
+  if (as.length === 1 && bs.length === 1) {
+    return [transformOperation(as[0], bs[0]), transformOperation(bs[0], as[0])];
+  }
+
+  if (as.length === 1) {
+    // Fold `a` through each `b` in turn; every `b` is already expressed in the
+    // context left by its predecessors, so it only needs the running `a`.
+    let carried = as;
+    const transformedBs: Operation[] = [];
+    for (const b of bs) {
+      const [nextA, nextB] = transformSequences(carried, [b]);
+      carried = nextA;
+      transformedBs.push(...nextB);
+    }
+    return [carried, transformedBs];
+  }
+
+  const [head, ...tail] = as;
+  const [headT, bsAfterHead] = transformSequences([head], bs);
+  const [tailT, bsFinal] = transformSequences(tail, bsAfterHead);
+  return [[...headT, ...tailT], bsFinal];
+}
+
+/**
+ * Transform a client operation into the context of the server's current
+ * document, given every operation committed since the client's base version.
+ */
+export function transformAgainstHistory(op: Operation, history: Operation[]): Operation[] {
+  if (history.length === 0) return isNoop(op) ? [] : [op];
+  return transformSequences([op], history)[0];
+}
