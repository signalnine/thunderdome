+/**
+ * Shared domain types for the collaborative Markdown server.
+ */
+
+/** A document row as stored in the `documents` table. */
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+/** A row of the `versions` table: the content of a document at one point in time. */
+export interface Version {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  /** JSON-encoded {@link Operation} that produced this version, or null for the initial version. */
+  operation: string | null;
+  created_at: string;
+}
+
+/** A row of the `active_connections` table. */
+export interface ActiveConnection {
+  id: string;
+  document_id: string;
+  connected_at: string;
+}
+
+/** Insert `text` so that it starts at `position` in the document. */
+export interface InsertOperation {
+  type: 'insert';
+  position: number;
+  text: string;
+}
+
+/** Remove `count` characters starting at `position`. */
+export interface DeleteOperation {
+  type: 'delete';
+  position: number;
+  count: number;
+}
+
+export type Operation = InsertOperation | DeleteOperation;
+
+/** Message sent by a client over the WebSocket. */
+export interface ClientMessage {
+  type: string;
+  operation?: unknown;
+  /** Document version the operation was composed against. Defaults to the server's current version. */
+  version?: number;
+}
+
+/** Full document state, sent when a client joins a room. */
+export interface SyncMessage {
+  type: 'sync';
+  documentId: string;
+  content: string;
+  version: number;
+}
+
+/**
+ * Confirmation that the sender's operation was applied. `operations` holds the
+ * operation as the server actually applied it after transforming it against
+ * concurrent edits, so the sender can reconcile its local copy.
+ */
+export interface AckMessage {
+  type: 'ack';
+  version: number;
+  operations: Operation[];
+}
+
+/** An operation from another client, already transformed into the receiver's context. */
+export interface OperationMessage {
+  type: 'operation';
+  operation: Operation;
+  version: number;
+}
+
+export interface ErrorMessage {
+  type: 'error';
+  message: string;
+}
+
+export type ServerMessage = SyncMessage | AckMessage | OperationMessage | ErrorMessage;
