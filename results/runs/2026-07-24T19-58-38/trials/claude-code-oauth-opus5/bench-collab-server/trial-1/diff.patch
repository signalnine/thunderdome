+{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CdMUiNT8gPL6s9pC76rxT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018wNxEM3ZYfQdbunxtAJeqi","name":"Write","input":{"file_path":"/workspace/src/ws.ts","content":"/**\n * WebSocket layer: one room per document, operational-transform based edits.\n *\n * A client connects to `ws://host/<documentId>` and immediately receives a\n * `sync` message with the current content and version. Edits arrive as\n * `{ type: 'operation', operation, version? }` where `version` is the document\n * version the client composed against. The server transforms the operation\n * against everything committed since that version, applies it, acknowledges\n * the sender and broadcasts the transformed operation to the rest of the room.\n */\n\nimport type { Server as HttpServer } from 'node:http';\n\nimport { WebSocket, WebSocketServer } from 'ws';\n\nimport {\n  addConnection,\n  getCurrentVersion,\n  getDocument,\n  getOperationsSince,\n  getVersion,\n  commitOperation,\n  removeConnection,\n  type DatabaseHandle,\n} from './db.js';\nimport type { ClientMessage, Operation, ServerMessage } from './models.js';\nimport { applyOperation, transformAgainstAll, validateOperation } from './ot.js';\n\ninterface Client {\n  socket: WebSocket;\n  documentId: string;\n  /** Primary key of this socket's row in `active_connections`. */\n  connectionId: string;\n}\n\nfunction send(socket: WebSocket, message: ServerMessage): void {\n  if (socket.readyState !== WebSocket.OPEN) return;\n  socket.send(JSON.stringify(message));\n}\n\nfunction sendError(socket: WebSocket, message: string): void {\n  send(socket, { type: 'error', message });\n}\n\n/** Extract the document id from a request URL such as `/abc-123?foo=1`. */\nfunction parseDocumentId(url: string | undefined): string {\n  const path = (url ?? '/').split('?')[0];\n  const raw = path.replace(/^\\/+/, '').replace(/\\/+$/, '');\n  try {\n    return decodeURIComponent(raw);\n  } catch {\n    return raw;\n  }\n}\n\nexport function createWebSocketServer(server: HttpServer, db: DatabaseHandle): WebSocketServer {\n  const wss = new WebSocketServer({ server });\n  /** Document id -> the clients currently editing it. */\n  const rooms = new Map<string, Set<Client>>();\n\n  function join(client: Client): void {\n    let room = rooms.get(client.documentId);\n    if (!room) {\n      room = new Set();\n      rooms.set(client.documentId, room);\n    }\n    room.add(client);\n  }\n\n  function leave(client: Client): void {\n    const room = rooms.get(client.documentId);\n    if (!room) return;\n    room.delete(client);\n    if (room.size === 0) rooms.delete(client.documentId);\n  }\n\n  /** Send `message` to every client in the room except `origin`. */\n  function broadcast(documentId: string, origin: Client, message: ServerMessage): void {\n    const room = rooms.get(documentId);\n    if (!room) return;\n    for (const peer of room) {\n      if (peer === origin) continue;\n      send(peer.socket, message);\n    }\n  }\n\n  function handleOperation(client: Client, message: ClientMessage): void {\n    const document = getDocument(db, client.documentId);\n    if (!document) {\n      sendError(client.socket, 'Document not found');\n      return;\n    }\n\n    const currentVersion = getCurrentVersion(db, client.documentId);\n    // Without an explicit version the client is assumed to be up to date.\n    let baseVersion = currentVersion;\n    if (Number.isInteger(message.version)) {\n      const requested = message.version as number;\n      if (requested >= 0 && requested <= currentVersion) baseVersion = requested;\n    }\n\n    const isCurrent = baseVersion === currentVersion;\n    const baseContent = isCurrent\n      ? document.content\n      : (getVersion(db, client.documentId, baseVersion)?.content ?? document.content);\n\n    // Bounds are checked against the document the client actually saw.\n    if (!validateOperation(message.operation, baseContent.length)) {\n      sendError(client.socket, 'Invalid operation');\n      return;\n    }\n\n    const history: Operation[] = isCurrent\n      ? []\n      : getOperationsSince(db, client.documentId, baseVersion);\n    const transformed = transformAgainstAll(message.operation, history);\n\n    const content = applyOperation(document.content, transformed);\n    const version = commitOperation(db, client.documentId, content, transformed);\n\n    send(client.socket, { type: 'ack', version, operation: transformed });\n    broadcast(client.documentId, client, { type: 'operation', operation: transformed, version });\n  }\n\n  function handleMessage(client: Client, raw: string): void {\n    let message: ClientMessage;\n    try {\n      const parsed: unknown = JSON.parse(raw);\n      if (typeof parsed !== 'object' || parsed === null) throw new Error('not an object');\n      message = parsed as ClientMessage;\n    } catch {\n      sendError(client.socket, 'Malformed message: expected JSON object');\n      return;\n    }\n\n    if (message.type !== 'operation') {\n      sendError(client.socket, `Unsupported message type: ${String(message.type)}`);\n      return;\n    }\n\n    try {\n      handleOperation(client, message);\n    } catch (err) {\n      sendError(client.socket, `Failed to apply operation: ${(err as Error).message}`);\n    }\n  }\n\n  wss.on('connection', (socket: WebSocket, request) => {\n    const documentId = parseDocumentId(request.url);\n\n    const document = documentId ? getDocument(db, documentId) : undefined;\n    if (!document) {\n      sendError(socket, `Document not found: ${documentId}`);\n      socket.close();\n      return;\n    }\n\n    const client: Client = {\n      socket,\n      documentId,\n      connectionId: addConnection(db, documentId),\n    };\n    join(client);\n\n    send(socket, {\n      type: 'sync',\n      documentId,\n      content: document.content,\n      version: getCurrentVersion(db, documentId),\n    });\n\n