s, countBeamPaths } from '../src/index.js';\n\n/** Parse a picture like `. S . .` / one row per line into a grid. */\nfunction parse(picture: string): string[][] {\n  return picture\n    .trim()\n    .split('\\n')\n    .map((line) => line.trim().split(/\\s+/));\n}\n\nconst COL_DELTA = [0, -1, 1];\n\n/**\n * Reference implementation #1: literally walk every beam, forking at each\n * splitter, with no merging or memoisation. Exponential, so only usable on\n * tiny grids — but it follows the stated rules as directly as possible.\n */\nfunction bruteForce(grid: string[][]): { cells: number; paths: bigint } {\n  const rows = grid.length;\n  const cols = grid[0]?.length ?? 0;\n  const visited = new Set<string>();\n  let paths = 0n;\n\n  const walk = (row: number, col: number, dir: number): void => {\n    if (row < 0 || row >= rows || col < 0 || col >= cols) {\n      paths += 1n; // absorbed: this beam completed one source-to-exit path\n      return;\n    }\n    visited.add(`${row},${col}`);\n    if (grid[row][col] === '^') {\n      walk(row + 1, col - 1, 1);\n      walk(row + 1, col + 1, 2);\n    } else {\n      walk(row + 1, col + COL_DELTA[dir], dir);\n    }\n  };\n\n  for (let row = 0; row < rows; row++) {\n    for (let col = 0; col < cols; col++) {\n      if (grid[row][col] === 'S') walk(row, col, 0);\n    }\n  }\n  return { cells: visited.size, paths };\n}\n\n/**\n * Reference implementation #2: top-down memoised recursion counting the paths\n * that *leave* the grid from a given state. Structurally the opposite of the\n * bottom-up sweep under test, so agreement between them is meaningful, and it\n * is cheap enough to run on full-size grids.\n */\nfunction oracle(grid: string[][]): { cells: number; paths: bigint } {\n  const rows = grid.length;\n  const cols = grid[0]?.length ?? 0;\n  const memo = new Map<number, bigint>();\n  const visited = new Set<number>();\n\n  const exitsFrom = (row: number, col: number, dir: number): bigint => {\n    if (row < 0 || row >= rows || col < 0 || col >= cols) return 1n;\n    visited.add(row * cols + col);\n    const key = (row * cols + col) * 3 + dir;\n    const cached = memo.get(key);\n    if (cached !== undefined) return cached;\n    // Beams strictly advance one row per step, so the state graph is acyclic\n    // and a plain memo needs no cycle handling.\n    const total =\n      grid[row][col] === '^'\n        ? exitsFrom(row + 1, col - 1, 1) + exitsFrom(row + 1, col + 1, 2)\n        : exitsFrom(row + 1, col + COL_DELTA[dir], dir);\n    memo.set(key, total);\n    return total;\n  };\n\n  let paths = 0n;\n  for (let row = 0; row < rows; row++) {\n    for (let col = 0; col < cols; col++) {\n      if (grid[row][col] === 'S') paths += exitsFrom(row, col, 0);\n    }\n  }\n  return { cells: visited.size, paths };\n}\n\nfunction blank(rows: number, cols: number): string[][] {\n  return Array.from({ length: rows }, () => new Array<string>(cols).fill('.'));\n}\n\ndescribe('worked examples from the spec', () => {\n  it('single splitter: 5 cells, 2 paths', () => {\n    const grid = parse(`\n      . S . . .\n      . . . . .\n      . ^ . . .\n      . . . . .\n    `);\n    expect(countBeamCells(grid)).toBe(5);\n    expect(countBeamPaths(grid)).toBe(2n);\n  });\n\n  it('two splitters, with beams merging on one cell and one exiting sideways', () => {\n    const grid = parse(`\n      . S . . .\n      . ^ . . .\n      ^ . ^ . .\n      . . . . .\n    `);\n    // (3,1) is reached by two beams but counts once.\n    expect(countBeamCells(grid)).toBe(6);\n    // All four branches count, including the one absorbed off the left edge.\n    expect(countBeamPaths(grid)).toBe(4n);\n  });\n});\n\ndescribe('edge cases', () => {\n  it('handles an empty grid', () => {\n    expect(countBeamCells([])).toBe(0);\n    expect(countBeamPaths([])).toBe(0n);\n  });\n\n  it('handles a grid of empty rows', () => {\n    expect(countBeamCells([[], []])).toBe(0);\n    expect(countBeamPaths([[], []])).toBe(0n);\n  });\n\n  it('reports nothing when there is no source', () => {\n    const grid = parse(`\n      . . .\n      . ^ .\n      . . .\n    `);\n    expect(countBeamCells(grid)).toBe(0);\n    expect(countBeamPaths(grid)).toBe(0n);\n  });\n\n  it('counts the source cell in a single-row grid', () => {\n    expect(countBeamCells([['.', 'S', '.']])).toBe(1);\n    expect(countBeamPaths([['.', 'S', '.']])).toBe(1n);\n  });\n\n  it('splits on the last row, both branches exiting immediately', () => {\n    const grid = parse(`\n      . S .\n      . ^ .\n    `);\n    expect(countBeamCells(grid)).toBe(2);\n    expect(countBeamPaths(grid)).toBe(2n);\n  });\n\n  it('absorbs the branch that leaves the left edge', () => {\n    const grid = parse(`\n      S . .\n      ^ . .\n      . . .\n    `);\n    // (0,0), (1,0) splitter, (2,1) — the down-left branch is absorbed at (2,-1).\n    expect(countBeamCells(grid)).toBe(3);\n    expect(countBeamPaths(grid)).toBe(2n);\n  });\n\n  it('absorbs the branch that leaves the right edge', () => {\n    const grid = parse(`\n      . . S\n      . . ^\n      . . .\n    `);\n    expect(countBeamCells(grid)).toBe(3);\n    expect(countBeamPaths(grid)).toBe(2n);\n  });\n\n  it('splits a diagonal beam regardless of its incoming direction', () => {\n    const grid = parse(`\n      . . S . .\n      . . ^ . .\n      . ^ . ^ .\n      . . . . .\n    `);\n    // The down-left beam into (2,1) and the down-right beam into (2,3) both\n    // still split into a down-left and a down-right branch.\n    expect(countBeamPaths(grid)).toBe(4n);\n    // (3,2) is reached by both inner branches but counts once.\n    expect(countBeamCells(grid)).toBe(7);\n  });\n\n  it('supports several sources on the top row', () => {\n    const grid = parse(`\n      S . S\n      . . .\n      . . .\n    `);\n    expect(countBeamCells(grid)).toBe(6);\n    expect(countBeamPaths(grid)).toBe(2n);\n  });\n\n  it('lets a beam pass straight through a source cell', () => {\n    const grid = parse(`\n      . S .\n      . S .\n      . . .\n    `);\n    // The lower source emits its own beam and the upper beam passes through,\n    // so two paths exit the bottom at (2,1).\n    expect(countBeamPaths(grid)).toBe(2n);\n    expect(countBeamCells(grid)).toBe(3);\n  });\n});\n\ndescribe('agreement with reference implementations', () => {\n  it('matches brute-force enumeration on randomised small grids', () => {\n    // Deterministic LCG so a failure is reproducible.\n    let seed = 0x2545f491;\n    const rand = (n: number): number => {\n      seed = (seed * 1103515245 + 12345) & 0x7fffffff;\n      return seed % n;\n    };\n\n    for (let trial = 0; trial < 400; trial++) {\n      const rows = 1 + rand(7);\n      const cols = 1 + rand(7);\n      const grid = blank(rows, cols);\n      // Keep the splitter count low so brute force stays tractable.\n      const splitters = rand(9);\n      for (let i = 0; i < splitters; i++) grid[rand(rows)][rand(cols)] = '^';\n      const sources = 1 + rand(2);\n      for (let i = 0; i < sources; i++) grid[0][rand(cols)] = 'S';\n\n      const expected = bruteForce(grid);\n      const label = grid.map((row) => row.join('')).join('/');\n      expect(countBeamCells(grid), label).toBe(expected.cells);\n      expect(countBeamPaths(grid), label).toBe(expected.paths);\n    }\n  });\n\n  it('matches the memoised oracle on a dense 200x200 grid', () => {\n    let seed = 0x9e3779b9;\n    const rand = (n: number): number => {\n      seed = (seed * 1103515245 + 12345) & 0x7fffffff;\n      return seed % n;\n    };\n    const grid = blank(200, 200);\n    for (let i = 0; i < 2000; i++) grid[1 + rand(199)][rand(200)] = '^';\n    grid[0][100] = 'S';\n\n    const expected = oracle(grid);\n    expect(countBeamCells(grid)).toBe(expected.cells);\n    expect(countBeamPaths(grid)).toBe(expected.paths);\n  });\n});\n\ndescribe('exponential path counts', () => {\n  it('returns exactly 2^50 when a beam crosses 50 full rows of splitters', () => {\n    // 401 columns wide, so no branch can reach a side edge within 50 rows and\n    // every branch splits on every one of rows 1..50.\n    const grid = blank(60, 401);\n    for (let row = 1; row <= 50; row++) grid[row].fill('^');\n    grid[0][200] = 'S';\n\n    expect(countBeamPaths(grid)).toBe(2n ** 50n);\n  });\n\n  it('returns a bigint that exceeds Number.MAX_SAFE_INTEGER exactly', () => {\n    const grid = blank(70, 401);\n    for (let row = 1; row <= 60; row++) grid[row].fill('^');\n    grid[0][200] = 'S';\n\n    const paths = countBeamPaths(grid);\n    expect(typeof paths).toBe('bigint');\n    expect(paths).toBe(1152921504606846976n); // 2^60\n    expect(paths).toBeGreaterThan(BigInt(Number.MAX_SAFE_INTEGER));\n  });\n});\n\ndescribe('performance', () => {\n  it('solves a 200x200 grid with 50 splitters well under 5 seconds', () => {\n    const grid = blank(200, 200);\n    grid[0][100] = 'S';\n    // Stack the 50 splitters down the source column and its immediate\n    // neighbours so they are all actually reached by beams.\n    for (let i = 0; i < 50; i++) grid[i * 3 + 1][100 + (i % 3) - 1] = '^';\n\n    const started = process.hrtime.bigint();\n    const cells = countBeamCells(grid);\n    const paths = countBeamPaths(grid);\n    const elapsedMs = Number(process.hrtime.bigint() - started) / 1e6;\n\n    expect(cells).toBeGreaterThan(0);\n    expect(paths).toBeGreaterThan(0n);\n    expect(paths).toBe(oracle(grid).paths);\n    expect(elapsedMs).toBeLessThan(5000);\n  });\n\n  it('stays fast when every cell is a splitter and counts are huge', () => {\n    const grid = blank(200, 200);\n    for (const row of grid) row.fill('^');\n    grid[0][100] = 'S';\n\n    const started = process.hrtime.bigint();\n    const paths = countBeamPaths(grid);\n    const elapsedMs = Number(process.hrtime.bigint() - started) / 1e6;\n\n    expect(paths).toBe(oracle(grid).paths);\n    expect(elapsedMs).toBeLessThan(5000);\n  });\n});\n","structuredPatch":[{"oldStart":273,"oldLines":18,"newStart":273,"newLines":19,"lines":["   it('