+/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ *
+ * Every beam advances exactly one row per step, so the graph of beam states
+ * — `(row, col, direction)` triples — is a DAG layered by row: an edge only
+ * ever runs from row `r` to row `r + 1`. That lets us sweep the grid
+ * top-to-bottom one row at a time, carrying the *number* of paths that reach
+ * each state rather than the paths themselves. Both answers then fall out of a
+ * single O(rows x cols) pass, instead of the 2^K blowup of enumerating paths
+ * individually for K splitters.
+ */
+
+export type Grid = string[][];
+
+const SOURCE = 'S';
+const SPLITTER = '^';
+
+/** Beams travel in one of three directions, each advancing exactly one row. */
+const DOWN = 0;
+const DOWN_LEFT = 1;
+const DOWN_RIGHT = 2;
+
+/** Column shift applied by each direction, indexed by the constants above. */
+const COL_DELTA = [0, -1, 1];
+
+export interface BeamStats {
+  /** Distinct grid cells touched by at least one beam. */
+  cells: number;
+  /** Total number of distinct source-to-exit paths. */
+  paths: bigint;
+}
+
+/**
+ * Propagate every beam through the grid, collecting both statistics at once.
+ *
+ * Beams that arrive at the same cell travelling in the same direction are
+ * indistinguishable from there on, so they are merged into a single state
+ * carrying the summed path count. This is what keeps the sweep linear in the
+ * grid size even when the path total is astronomically large.
+ */
+export function simulate(grid: Grid): BeamStats {
+  const rows = Array.isArray(grid) ? grid.length : 0;
+  // Tolerate ragged input: the width is the widest row, and any cell past the
+  // end of a short row is treated as empty space.
+  const cols = rows === 0 ? 0 : grid.reduce((max, row) => Math.max(max, row.length), 0);
+  if (rows === 0 || cols === 0) return { cells: 0, paths: 0n };
+
+  // `current[dir * cols + col]` is the number of distinct paths that arrive at
+  // (row, col) travelling in `dir`. `next` accumulates the following row; the
+  // two buffers are swapped and cleared each step.
+  let current: bigint[] = new Array<bigint>(3 * cols).fill(0n);
+  let next: bigint[] = new Array<bigint>(3 * cols).fill(0n);
+
+  let cells = 0;
+  let paths = 0n;
+
+  /**
+   * Move `count` paths from `fromRow` into (fromRow + 1, toCol) heading `dir`.
+   * Anything that lands outside the grid is absorbed, which ends those paths.
+   */
+  const emit = (fromRow: number, toCol: number, dir: number, count: bigint): void => {
+    if (fromRow + 1 >= rows || toCol < 0 || toCol >= cols) {
+      paths += count;
+      return;
+    }
+    next[dir * cols + toCol] += count;
+  };
+
+  for (let row = 0; row < rows; row++) {
+    const gridRow = grid[row];
+
+    // Sources emit a fresh downward beam from their own cell. Scanning every
+    // row (rather than just row 0) costs nothing and keeps the simulation
+    // correct if a source ever shows up lower down.
+    for (let col = 0; col < cols; col++) {
+      if (gridRow[col] === SOURCE) current[DOWN * cols + col] += 1n;
+    }
+
+    for (let col = 0; col < cols; col++) {
+      const down = current[DOWN * cols + col];
+      const left = current[DOWN_LEFT * cols + col];
+      const right = current[DOWN_RIGHT * cols + col];
+      if (down === 0n && left === 0n && right === 0n) continue;
+
+      // A cell counts once however many beams cross it.
+      cells++;
+
+      if (gridRow[col] === SPLITTER) {
+        // A splitter consumes the incoming beam and always emits one
+        // down-left and one down-right beam, whatever direction it arrived
+        // from — so the three incoming states collapse into one total.
+        const total = down + left + right;
+        emit(row, col + COL_DELTA[DOWN_LEFT], DOWN_LEFT, total);
+        emit(row, col + COL_DELTA[DOWN_RIGHT], DOWN_RIGHT, total);
+      } else {
+        // Every other cell is transparent: each beam keeps its direction.
+        if (down !== 0n) emit(row, col + COL_DELTA[DOWN], DOWN, down);
+        if (left !== 0n) emit(row, col + COL_DELTA[DOWN_LEFT], DOWN_LEFT, left);
+        if (right !== 0n) emit(row, col + COL_DELTA[DOWN_RIGHT], DOWN_RIGHT, right);
+      }
+    }
+
+    const spent = current;
+    current = next;
+    next = spent;
+    next.fill(0n);
+  }
+
+  return { cells, paths };
+}
+
+/**
+ * Count the distinct cells visited by any beam, including the source cell and
+ * any splitter a beam reaches.
+ */
+export function countBeamCells(grid: Grid): number {
+  return simulate(grid).cells;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths. Each split forks
+ * one path into two, so the total can be exponential in the splitter count —
+ * hence `bigint`.
+ */
+export function countBeamPaths(grid: Grid): bigint {
+  return simulate(grid).paths;
+}
