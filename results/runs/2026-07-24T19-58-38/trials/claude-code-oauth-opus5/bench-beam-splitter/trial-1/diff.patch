ull-size grids.\n */\nfunction oracle(grid: string[][]): { cells: number; paths: bigint } {\n  const rows = grid.length;\n  const cols = grid[0]?.length ?? 0;\n  const memo = new Map<number, bigint>();\n  const visited = new Set<number>();\n\n  const exitsFrom = (row: number, col: number, dir: number): bigint => {\n    if (row < 0 || row >= rows || col < 0 || col >= cols) return 1n;\n    visited.add(row * cols + col);\n    const key = (row * cols + col) * 3 + dir;\n    const cached = memo.get(key);\n    if (cached !== undefined) return cached;\n    // Beams strictly advance one row per step, so the state graph is acyclic\n    // and a plain memo needs no cycle handling.\n    const total =\n      grid[row][col] === '^'\n        ? exitsFrom(row + 1, col - 1, 1) + exitsFrom(row + 1, col + 1, 2)\n        : exitsFrom(row + 1, col + COL_DELTA[dir], dir);\n    memo.set(key, total);\n    return total;\n  };\n\n  let paths = 0n;\n  for (let row = 0; row < rows; row++) {\n    for (let col = 0; col < cols; col++) {\n      if (grid[row][col] === 'S') paths += exitsFrom(row, col, 0);\n    }\n  }\n  return { cells: visited.size, paths };\n}\n\nfunction blank(rows: number, cols: number): string[][] {\n  return Array.from({ length: rows }, () => new Array<string>(cols).fill('.'));\n}\n\ndescribe('worked examples from the spec', () => {\n  it('single splitter: 5 cells, 2 paths', () => {\n    const grid = parse(`\n      . S . . .\n      . . . . .\n      . ^ . . .\n      . . . . .\n    `);\n    expect(countBeamCells(grid)).toBe(5);\n    expect(countBeamPaths(grid)).toBe(2n);\n  });\n\n  it('two splitters, with beams merging on one cell and one exiting sideways', () => {\n    const grid = parse(`\n      . S . . .\n      . ^ . . .\n      ^ . ^ . .\n      . . . . .\n    `);\n    // (3,1) is reached by two beams but counts once.\n    expect(countBeamCells(grid)).toBe(6);\n    // All four branches count, including the one absorbed off the left edge.\n    expect(countBeamPaths(grid)).toBe(4