he grid: one completed path\n      return;\n    }\n    visited.add(`${row},${col}`);\n    if (grid[row][col] === '^') {\n      walk(row + 1, col - 1, -1);\n      walk(row + 1, col + 1, 1);\n    } else {\n      walk(row + 1, col + colDelta, colDelta);\n    }\n  };\n\n  for (let row = 0; row < rows; row++) {\n    for (let col = 0; col < cols; col++) {\n      if (grid[row][col] === 'S') walk(row, col, 0);\n    }\n  }\n  return { cells: visited.size, paths };\n}\n\n/** Deterministic PRNG so a failing random case is reproducible. */\nfunction mulberry32(seed: number): () => number {\n  let a = seed;\n  return () => {\n    a = (a + 0x6d2b79f5) | 0;\n    let t = Math.imul(a ^ (a >>> 15), 1 | a);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\ndescribe('spec examples', () => {\n  it('counts a single splitter', () => {\n    const grid = parse('.S...', '.....', '.^...', '.....');\n    expect(countBeamCells(grid)).toBe(5);\n    expect(countBeamPaths(grid)).toBe(2n);\n  });\n\n  it('counts two levels of splitters, including a converging cell', () => {\n    const grid = parse('.S...', '.^...', '^.^..', '.....');\n    // (3,1) is reached by two different beams but counts as one cell...\n    expect(countBeamCells(grid)).toBe(6);\n    // ...while both remain distinct paths.\n    expect(countBeamPaths(grid)).toBe(4n);\n  });\n});\n\ndescribe('beam movement', () => {\n  it('travels straight down with no splitters', () => {\n    const grid = parse('S', '.', '.');\n    expect(countBeamCells(grid)).toBe(3);\n    expect(countBeamPaths(grid)).toBe(1n);\n  });\n\n  it('counts a lone source row', () => {\n    const grid = parse('.S.');\n    expect(countBeamCells(grid)).toBe(1);\n    expect(countBeamPaths(grid)).toBe(1n);\n  });\n\n  it('absorbs a branch that leaves the left edge, still counting it as a path', () => {\n    const grid = parse('S.', '^.');\n    expect(countBeamCells(grid)).toBe(2);\n    expect(countBeamPaths(grid)).toBe(2n);\n  });\n\n  it('splits a diagonal beam regardless of its incoming direction', () => {\n    // The down-right branch from (1,1) hits the splitter at (2,2) while\n    // travelling diagonally, and must still fan out both ways.\n    const grid = parse('.S...', '.^...', '..^..', '.....', '.....');\n    expect(countBeamPaths(grid)).toBe(4n);\n    // (0,1) (1,1) (2,0) (2,2) (3,1) (3,3) (4,0) (4,2) (4,4) minus none\n    expect(countBeamCells(grid)).toBe(9);\n  });\n\n  it('handles multiple sources on the top row', () => {\n    const grid = parse('S..S', '....');\n    expect(countBeamCells(grid)).toBe(4);\n    expect(countBeamPaths(grid)).toBe(2n);\n  });\n\n  it('returns zero for a grid with no source', () => {\n    const grid = parse('...', '.^.');\n    expect(countBeamCells(grid)).toBe(0);\n    expect(countBeamPaths(grid)).toBe(0n);\n  });\n\n  it('handles degenerate grids', () => {\n    expect(countBeamCells([])).toBe(0);\n    expect(countBeamPaths([])).toBe(0n);\n    expect(countBeamCells([[]])).toBe(0);\n    expect(countBeamPaths([[]])).toBe(0n);\n  });\n});\n\ndescribe('agreement with a brute-force reference', () => {\n  it('matches on random small grids', () => {\n    const random = mulberry32(20260724);\n    for (let trial = 0; trial < 300; trial++) {\n      const rows = 2 + Math.floor(random() * 6);\n      const cols = 1 + Math.floor(random() * 7);\n      const grid: string[][] = [];\n      for (let row = 0; row < rows; row++) {\n        const cells: string[] = [];\n        for (let col = 0; col < cols; col++) {\n          cells.push(row > 0 && random() < 0.25 ? '^' : '.');\n        }\n        grid.push(cells);\n      }\n      grid[0][Math.floor(random() * cols)] = 'S';\n\n      const expected = bruteForce(grid);\n      const actual = { cells: countBeamCells(grid), paths: countBeamPaths(grid) };\n      expect({ grid: grid.map((r) => r.join('')), ...actual }).toEqual({\n        grid: grid.map((r) => r.join('')),\n        ...expected,\n      });\n    }\n  });\n});\n\ndescribe('scale', () => {\n  it('counts 2^50 paths through 50 dense splitter rows', () => {\n    // Rows 1..50 are solid splitters, so every path splits exactly 50 times.\n    // The fan spreads at most 50 columns from the source, so nothing escapes\n    // the sides before the splitters run out.\n    const size = 200;\n    const grid = Array.from({ length: size }, () => new Array<string>(size).fill('.'));\n    for (let row = 1; row <= 50; row++) grid[row].fill('^');\n    grid[0][100] = 'S';\n\n    expect(countBeamPaths(grid)).toBe(2n ** 50n);\n  });\n\n  it('handles a 200x200 grid with 50 splitters well under the time limit', () => {\n    const size = 200;\n    const random = mulberry32(7);\n    const grid = Array.from({ length: size }, () => new Array<string>(size).fill('.'));\n    for (let placed = 0; placed < 50; ) {\n      const row = 1 + Math.floor(random() * (size - 1));\n      const col = Math.floor(random() * size);\n      if (grid[row][col] === '.') {\n        grid[row][col] = '^';\n        placed++;\n      }\n    }\n    grid[0][size / 2] = 'S';\n\n    const started = performance.now();\n    const cells = countBeamCells(grid);\n    const paths = countBeamPaths(grid);\n    const elapsed = performance.now() - started;\n\n    expect(cells).toBeGreaterThan(0);\n    expect(paths).toBeGreaterThanOrEqual(1n);\n    expect(elapsed).toBeLessThan(5000);\n  });\n\n  it('stays fast when the whole grid is splitters', () => {\n    // Pathological: 200 splits deep, so path counts reach ~2^200.\n    const size = 200;\n    const grid = Array.from({ length: size }, () => new Array<string>(size).fill('^'));\n    grid[0][100] = 'S';\n\n    const started = performance.now();\n    const paths = countBeamPaths(grid);\n    expect(performance.now() - started).toBeLessThan(5000);\n    expect(paths).toBeGreaterThan(2n ** 64n);\n  });\n});\n","structuredPatch":[{"oldStart":89,"oldLines":9,"newStart":89,"newLines":11,"lines":["     // The down-right branch from (1,1) 