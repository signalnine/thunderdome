+import { describe, expect, it } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index.js';
+
+/** Build a grid from compact row strings: `parse('.S..', '..^.')`. */
+function parse(...rows: string[]): string[][] {
+  return rows.map((row) => row.split(''));
+}
+
+/**
+ * Independent reference implementation: walks every beam separately with no
+ * memoisation, exactly mirroring the prose rules. Exponential, so only usable
+ * on small grids — which is the point, it shares no logic with the DP.
+ */
+function bruteForce(grid: string[][]): { cells: number; paths: bigint } {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  const visited = new Set<string>();
+  let paths = 0n;
+
+  const walk = (row: number, col: number, colDelta: number): void => {
+    if (row < 0 || row >= rows || col < 0 || col >= cols) {
+      paths += 1n; // the beam left the grid: one completed path
+      return;
+    }
+    visited.add(`${row},${col}`);
+    if (grid[row][col] === '^') {
+      walk(row + 1, col - 1, -1);
+      walk(row + 1, col + 1, 1);
+    } else {
+      walk(row + 1, col + colDelta, colDelta);
+    }
+  };
+
+  for (let row = 0; row < rows; row++) {
+    for (let col = 0; col < cols; col++) {
+      if (grid[row][col] === 'S') walk(row, col, 0);
+    }
+  }
+  return { cells: visited.size, paths };
+}
+
+/** Deterministic PRNG so a failing random case is reproducible. */
+function mulberry32(seed: number): () => number {
+  let a = seed;
+  return () => {
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+describe('spec examples', () => {
+  it('counts a single splitter', () => {
+    const grid = parse('.S...', '.....', '.^...', '.....');
+    expect(countBeamCells(grid)).toBe(5);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('counts two levels of splitters, including a converging cell', () => {
+    const grid = parse('.S...', '.^...', '^.^..', '.....');
+    // (3,1) is reached by two different beams but counts as one cell...
+    expect(countBeamCells(grid)).toBe(6);
+    // ...while both remain distinct paths.
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+});
+
+describe('beam movement', () => {
+  it('travels straight down with no splitters', () => {
+    const grid = parse('S', '.', '.');
+    expect(countBeamCells(grid)).toBe(3);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('counts a lone source row', () => {
+    const grid = parse('.S.');
+    expect(countBeamCells(grid)).toBe(1);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('absorbs a branch that leaves the left edge, still counting it as a path', () => {
+    const grid = parse('S.', '^.');
+    expect(countBeamCells(grid)).toBe(2);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('splits a diagonal beam regardless of its incoming direction', () => {
+    // The down-right branch from (1,1) hits the splitter at (2,2) while
+    // travelling diagonally, and must still fan out both ways.
+    const grid = parse('.S...', '.^...', '..^..', '.....', '.....');
+    // One path leaves the left edge from (2,0); the diagonal split at (2,2)
+    // supplies the other two.
+    expect(countBeamPaths(grid)).toBe(3n);
+    // (0,1) (1,1) (2,0) (2,2) (3,1) (3,3) (4,0) (4,4)
+    expect(countBeamCells(grid)).toBe(8);
