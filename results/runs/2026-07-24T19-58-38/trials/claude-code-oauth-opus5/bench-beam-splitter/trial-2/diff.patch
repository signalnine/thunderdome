+/**
+ * Beam propagation over a 2D grid.
+ *
+ * Every beam advances exactly one row per step, so the graph of beam states
+ * `(row, col, direction)` is a DAG layered by row. That makes both queries
+ * cheap: reachability is a single sweep over at most `rows * cols * 3` states,
+ * and path counts fold bottom-up without ever enumerating a path.
+ */
+
+/** Cell that splits an arriving beam into two diagonal beams. */
+const SPLITTER = '^';
+
+/** Cell that emits a beam travelling straight down. */
+const SOURCE = 'S';
+
+/** Beam heading straight down: (row + 1, col). */
+const DOWN = 0;
+/** Beam heading down-left: (row + 1, col - 1). */
+const DOWN_LEFT = 1;
+/** Beam heading down-right: (row + 1, col + 1). */
+const DOWN_RIGHT = 2;
+
+/** Column offset applied by each direction; the row offset is always +1. */
+const COL_DELTA = [0, -1, 1];
+
+/** Number of distinct directions a beam can travel. */
+const DIRECTIONS = COL_DELTA.length;
+
+/** Shape of a grid, precomputed once per call. */
+interface Bounds {
+  rows: number;
+  cols: number;
+}
+
+function boundsOf(grid: string[][]): Bounds {
+  const rows = grid.length;
+  return { rows, cols: rows > 0 ? grid[0].length : 0 };
+}
+
+/**
+ * Every cell emitting a beam. The spec guarantees sources sit on the top row,
+ * but scanning the whole grid costs nothing and keeps the behaviour sane if one
+ * shows up elsewhere.
+ */
+function sourceCells(grid: string[][], { cols }: Bounds): number[] {
+  const sources: number[] = [];
+  for (let row = 0; row < grid.length; row++) {
+    for (let col = 0; col < cols; col++) {
+      if (grid[row][col] === SOURCE) sources.push(row * cols + col);
+    }
+  }
+  return sources;
+}
+
+/**
+ * Count the distinct cells any beam passes through, including the source cells
+ * and any splitters that are hit.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const bounds = boundsOf(grid);
+  const { rows, cols } = bounds;
+  if (rows === 0 || cols === 0) return 0;
+
+  // A state is `(row * cols + col) * DIRECTIONS + direction`. Revisiting a
+  // state can only retrace cells already counted, so each is expanded once.
+  const seenState = new Uint8Array(rows * cols * DIRECTIONS);
+  const seenCell = new Uint8Array(rows * cols);
+  let cellCount = 0;
+
+  const stack: number[] = [];
+  const advance = (row: number, col: number, direction: number): void => {
+    if (row >= rows || col < 0 || col >= cols) return; // absorbed at the edge
+    const state = (row * cols + col) * DIRECTIONS + direction;
+    if (seenState[state]) return;
+    seenState[state] = 1;
+    stack.push(state);
+  };
+
+  for (const cell of sourceCells(grid, bounds)) {
+    advance(Math.floor(cell / cols), cell % cols, DOWN);
+  }
+
+  for (let state = stack.pop(); state !== undefined; state = stack.pop()) {
+    const cell = Math.floor(state / DIRECTIONS);
+    if (!seenCell[cell]) {
+      seenCell[cell] = 1;
+      cellCount++;
+    }
+
+    const row = Math.floor(cell / cols);
+    const col = cell % cols;
+    if (grid[row][col] === SPLITTER) {
+      // The arriving beam is consumed; it never continues straight through.
+      advance(row + 1, col - 1, DOWN_LEFT);
+      advance(row + 1, col + 1, DOWN_RIGHT);
+    } else {
+      const direction = state % DIRECTIONS;
+      advance(row + 1, col + COL_DELTA[direction], direction);
+    }
+  }
+
+  return cellCount;
+}
+
+/**
+ * Count distinct source-to-exit paths. Each split forks the path in two, so the
+ * total is exponential in the number of splitters along a beam — hence bigint.
+ *
+ * Paths are counted with multiplicity: two beams that converge on the same cell
+ * from different branches remain two separate paths.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const bounds = boundsOf(grid);
+  const { rows, cols } = bounds;
+  if (rows === 0 || cols === 0) return 0n;
+
+  // pathsFrom[state] = number of ways a beam in that state reaches an edge.
+  // Rows are filled bottom-up, so the row below is always already resolved.
+  const pathsFrom = new Array<bigint>(rows * cols * DIRECTIONS);
+  const from = (row: number, col: number, direction: number): bigint =>
+    row >= rows || col < 0 || col >= cols
+      ? 1n // left the grid: this beam completes exactly one path
+      : pathsFrom[(row * cols + col) * DIRECTIONS + direction];
+
+  for (let row = rows - 1; row >= 0; row--) {
+    for (let col = 0; col < cols; col++) {
+      const base = (row * cols + col) * DIRECTIONS;
+      if (grid[row][col] === SPLITTER) {
+        // A splitter ignores the incoming direction, so all three states here
+        // continue as the same pair of diagonal beams.
+        const split = from(row + 1, col - 1, DOWN_LEFT) + from(row + 1, col + 1, DOWN_RIGHT);
+        pathsFrom[base + DOWN] = split;
+        pathsFrom[base + DOWN_LEFT] = split;
+        pathsFrom[base + DOWN_RIGHT] = split;
+      } else {
+        for (let direction = 0; direction < DIRECTIONS; direction++) {
+          pathsFrom[base + direction] = from(row + 1, col + COL_DELTA[direction], direction);
+        }
+      }
+    }
+  }
+
+  let total = 0n;
+  for (const cell of sourceCells(grid, bounds)) {
+    total += pathsFrom[cell * DIRECTIONS + DOWN];
+  }
+  return total;
+}
