+import { randomUUID } from 'node:crypto';
+import type { EventBus } from '../bus.js';
+import {
+  Events,
+  OrderStatus,
+  type OrderCreatedEvent,
+  type OrderService,
+  type OrderStatusChangedEvent,
+} from '../types.js';
+
+interface Order {
+  id: string;
+  userId: string;
+  cartId: string;
+  status: OrderStatus;
+  total: number;
+}
+
+/** Allowed forward transitions of the order lifecycle. */
+const TRANSITIONS: Record<OrderStatus, readonly OrderStatus[]> = {
+  [OrderStatus.PENDING]: [OrderStatus.CONFIRMED, OrderStatus.CANCELLED],
+  [OrderStatus.CONFIRMED]: [OrderStatus.SHIPPED, OrderStatus.CANCELLED],
+  [OrderStatus.SHIPPED]: [OrderStatus.DELIVERED],
+  [OrderStatus.DELIVERED]: [],
+  [OrderStatus.CANCELLED]: [],
+};
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, Order>();
+
+  return {
+    createOrder(userId, cartId, total) {
+      const order: Order = {
+        id: `order_${randomUUID()}`,
+        userId,
+        cartId,
+        status: OrderStatus.PENDING,
+        total,
+      };
+      orders.set(order.id, order);
+
+      const payload: OrderCreatedEvent = {
+        orderId: order.id,
+        userId: order.userId,
+        cartId: order.cartId,
+        total: order.total,
+      };
+      void bus.emit(Events.ORDER_CREATED, payload);
+
+      return order.id;
+    },
+
+    getOrder(orderId) {
+      const order = orders.get(orderId);
+      if (!order) return null;
+      return { id: order.id, userId: order.userId, status: order.status, total: order.total };
+    },
+
+    updateStatus(orderId, status) {
+      const order = orders.get(orderId);
+      if (!order) return;
+
+      const previousStatus = order.status;
+      if (!TRANSITIONS[previousStatus].includes(status)) return;
+
+      order.status = status;
+
+      const payload: OrderStatusChangedEvent = { orderId, status, previousStatus };
+      void bus.emit(Events.ORDER_STATUS_CHANGED, payload);
+    },
+
+    listOrders(userId) {
+      return [...orders.values()]
+        .filter(order => order.userId === userId)
+        .map(order => ({ id: order.id, status: order.status, total: order.total }));
+    },
+  };
+}
diff --git a/src/payment/index.ts b/src/payment/index.ts
new file mode 100644
index 0000000..48c6cc9
--- /dev/null
+++ b/src/payment/index.ts
@@ -0,0 +1,88 @@
+import { randomUUID } from 'node:crypto';
+import type { EventBus } from '../bus.js';
+import {
+  Events,
+  PaymentStatus,
+  type PaymentProcessedEvent,
+  type PaymentService,
+} from '../types.js';
+
+export interface PaymentServiceOptions {
+  /** Always decline the charge. */
+  simulateFailure?: boolean;
+  /** Always let the gateway call time out. */
+  simulateTimeout?: boolean;
+  /** How long a gateway round-trip takes, in ms. */
+  processingDelayMs?: number;
+  /** How long to wait before giving up on the gateway, in ms. */
+  timeoutMs?: number;
+}
+
+interface Transaction {
+  id: string;
+  orderId: string;
+  amount: number;
+  refunded: boolean;
+}
+
+const delay = (ms: number): Promise<void> =>
+  new Promise(resolve => {
+    setTimeout(resolve, ms);
+  });
+
+export function createPaymentService(
+  bus: EventBus,
+  options: PaymentServiceOptions = {},
+): PaymentService {
+  const {
+    simulateFailure = false,
+    simulateTimeout = false,
+    processingDelayMs = 0,
+    timeoutMs = 5,
+  } = options;
+
+  const transactions = new Map<string, Transaction>();
+
+  return {
+    async processPayment(orderId, amount) {
+      await delay(simulateTimeout ? timeoutMs : processingDelayMs);
+
+      let result: { status: PaymentStatus; transactionId?: string; error?: string };
+
+      if (simulateTimeout) {
+        result = {
+          status: PaymentStatus.TIMEOUT,
+          error: `Payment gateway timed out after ${timeoutMs}ms`,
+        };
+      } else if (simulateFailure) {
+        result = { status: PaymentStatus.FAILED, error: 'Payment declined by gateway' };
+      } else if (!(amount > 0)) {
+        result = { status: PaymentStatus.FAILED, error: 'Invalid payment amount' };
+      } else {
+        const transaction: Transaction = {
+          id: `txn_${randomUUID()}`,
+          orderId,
+          amount,
+          refunded: false,
+        };
+        transactions.set(transaction.id, transaction);
+        result = { status: PaymentStatus.SUCCESS, transactionId: transaction.id };
+      }
+
+      const payload: PaymentProcessedEvent = { orderId, ...result };
+      await bus.emit(Events.PAYMENT_PROCESSED, payload);
+
+      return result;
+    },
+
+    async refund(transactionId) {
+      await delay(processingDelayMs);
+
+      const transaction = transactions.get(transactionId);
+      if (!transaction || transaction.refunded) return false;
+
+      transaction.refunded = true;
+      return true;
+    },
+  };
+}
diff --git a/src/pricing/index.ts b/src/pricing/index.ts
new file mode 100644
index 0000000..dc6f476
--- /dev/null
+++ b/src/pricing/index.ts
@@ -0,0 +1,44 @@
+import type { EventBus } from '../bus.js';
+import { Events, type PricingService, type ProductCreatedEvent } from '../types.js';
+
+const TAX_RATE = 0.1;
+
+/** Rounds a monetary amount to two decimal places, dodging binary float drift. */
+function round2(amount: number): number {
+  return Math.round((amount + Number.EPSILON) * 100) / 100;
+}
+
+export function createPricingService(bus: EventBus): PricingService {
+  const prices = new Map<string, number>();
+  const discountCodes = new Map<string, number>();
+
+  bus.on(Events.PRODUCT_CREATED, payload => {
+    const { productId, price } = payload as ProductCreatedEvent;
+    prices.set(productId, price);
+  });
+
+  return {
+    calculateTotal(items, discountCode) {
+      const subtotal = round2(
+        items.reduce((sum, item) => sum + item.price * item.quantity, 0),
+      );
+
+      const percentage = discountCode ? discountCodes.get(discountCode) ?? 0 : 0;
+      const discount = round2(subtotal * (percentage / 100));
+
+      const taxable = round2(subtotal - discount);
+      const tax = round2(taxable * TAX_RATE);
+      const total = round2(taxable + tax);
+
+      return { subtotal, discount, tax, total };
+    },
+
+    addDiscountCode(code, percentage) {
+      discountCodes.set(code, Math.min(100, Math.max(0, percentage)));
+    },
+
+    getPrice(productId) {
+      return prices.get(productId) ?? 0;
+    },
+  };
+}
