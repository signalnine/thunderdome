@@ -0,0 +1,90 @@
+import { randomUUID } from 'node:crypto';
+import type { EventBus } from '../bus.js';
+import { Events, type CartService, type CartUpdatedEvent } from '../types.js';
+
+interface CartItem {
+  productId: string;
+  quantity: number;
+}
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: CartItem[];
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  const emitUpdated = (cart: Cart): void => {
+    const payload: CartUpdatedEvent = {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: cart.items.map(item => ({ ...item })),
+    };
+    void bus.emit(Events.CART_UPDATED, payload);
+  };
+
+  return {
+    createCart(userId) {
+      const cart: Cart = { id: `cart_${randomUUID()}`, userId, items: [] };
+      carts.set(cart.id, cart);
+      return cart.id;
+    },
+
+    addItem(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart || quantity <= 0) return;
+
+      const existing = cart.items.find(item => item.productId === productId);
+      if (existing) {
+        existing.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+
+      emitUpdated(cart);
+    },
+
+    removeItem(cartId, productId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      const index = cart.items.findIndex(item => item.productId === productId);
+      if (index === -1) return;
+
+      cart.items.splice(index, 1);
+      emitUpdated(cart);
+    },
+
+    getCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      return { id: cart.id, userId: cart.userId, items: cart.items.map(item => ({ ...item })) };
+    },
+
+    clearCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      cart.items = [];
+      emitUpdated(cart);
+    },
+
+    updateQuantity(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      const index = cart.items.findIndex(item => item.productId === productId);
+      if (index === -1) return;
+
+      if (quantity <= 0) {
+        cart.items.splice(index, 1);
+      } else {
+        cart.items[index].quantity = quantity;
+      }
+
+      emitUpdated(cart);
+    },
+  };
+}
