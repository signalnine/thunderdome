@@ -0,0 +1,74 @@
+import type { EventBus } from '../bus.js';
+import {
+  Events,
+  PaymentStatus,
+  type NotificationSentEvent,
+  type NotificationService,
+  type OrderCreatedEvent,
+  type OrderStatusChangedEvent,
+  type PaymentProcessedEvent,
+} from '../types.js';
+
+interface Notification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const inboxes = new Map<string, Notification[]>();
+  /** orderId -> userId, learned from order:created events. */
+  const orderOwners = new Map<string, string>();
+
+  const notify = (userId: string, type: string, message: string): void => {
+    if (!subscribers.has(userId)) return;
+
+    const inbox = inboxes.get(userId);
+    const notification: Notification = { type, message, timestamp: Date.now() };
+    if (inbox) {
+      inbox.push(notification);
+    } else {
+      inboxes.set(userId, [notification]);
+    }
+
+    const payload: NotificationSentEvent = { userId, type, message };
+    void bus.emit(Events.NOTIFICATION_SENT, payload);
+  };
+
+  bus.on(Events.ORDER_CREATED, payload => {
+    const { orderId, userId } = payload as OrderCreatedEvent;
+    orderOwners.set(orderId, userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, payload => {
+    const { orderId, status } = payload as OrderStatusChangedEvent;
+    const userId = orderOwners.get(orderId);
+    if (!userId) return;
+
+    notify(userId, 'order_status', `Order ${orderId} is now ${status}.`);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, payload => {
+    const { orderId, status, error } = payload as PaymentProcessedEvent;
+    const userId = orderOwners.get(orderId);
+    if (!userId) return;
+
+    const message =
+      status === PaymentStatus.SUCCESS
+        ? `Payment for order ${orderId} succeeded.`
+        : `Payment for order ${orderId} ${status}: ${error ?? 'unknown error'}`;
+    notify(userId, 'payment', message);
+  });
+
+  return {
+    subscribe(userId) {
+      subscribers.add(userId);
+      if (!inboxes.has(userId)) inboxes.set(userId, []);
+    },
+
+    getNotifications(userId) {
+      return (inboxes.get(userId) ?? []).map(notification => ({ ...notification }));
+    },
+  };
+}
