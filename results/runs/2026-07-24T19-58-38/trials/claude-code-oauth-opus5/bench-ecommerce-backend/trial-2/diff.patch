+import { randomUUID } from 'node:crypto';
+import type { EventBus } from '../bus.js';
+import { Events, type CatalogService, type ProductCreatedEvent } from '../types.js';
+
+interface Product {
+  id: string;
+  name: string;
+  price: number;
+  category: string;
+}
+
+export function createCatalogService(bus: EventBus): CatalogService {
+  const products = new Map<string, Product>();
+
+  const snapshot = (product: Product): Product => ({ ...product });
+
+  return {
+    createProduct(name, price, category) {
+      const product: Product = { id: `prod_${randomUUID()}`, name, price, category };
+      products.set(product.id, product);
+
+      const payload: ProductCreatedEvent = {
+        productId: product.id,
+        name: product.name,
+        price: product.price,
+        category: product.category,
+      };
+      void bus.emit(Events.PRODUCT_CREATED, payload);
+
+      return product.id;
+    },
+
+    getProduct(productId) {
+      const product = products.get(productId);
+      return product ? snapshot(product) : null;
+    },
+
+    listProducts(category) {
+      return [...products.values()]
+        .filter(p => category === undefined || p.category === category)
+        .map(snapshot);
+    },
+
+    searchProducts(query) {
+      const needle = query.trim().toLowerCase();
+      if (needle === '') return [];
+      return [...products.values()]
+        .filter(
+          p =>
+            p.name.toLowerCase().includes(needle) ||
+            p.category.toLowerCase().includes(needle),
+        )
+        .map(snapshot);
+    },
+
+    updateProduct(productId, updates) {
+      const product = products.get(productId);
+      if (!product) return;
+      if (updates.name !== undefined) product.name = updates.name;
+      if (updates.price !== undefined) product.price = updates.price;
+      if (updates.category !== undefined) product.category = updates.category;
+    },
+
+    removeProduct(productId) {
+      return products.delete(productId);
+    },
+  };
+}
