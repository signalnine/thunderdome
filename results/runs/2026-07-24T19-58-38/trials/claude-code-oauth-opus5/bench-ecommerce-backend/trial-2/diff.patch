@@ -0,0 +1,66 @@
+import type { EventBus } from '../bus.js';
+import {
+  Events,
+  type InventoryService,
+  type InventoryUpdatedEvent,
+  type LowStockAlertEvent,
+} from '../types.js';
+
+export function createInventoryService(bus: EventBus): InventoryService {
+  const stock = new Map<string, number>();
+  const thresholds = new Map<string, number>();
+
+  const getQuantity = (productId: string): number => stock.get(productId) ?? 0;
+
+  const emitUpdated = (productId: string, quantity: number): void => {
+    const payload: InventoryUpdatedEvent = { productId, quantity };
+    void bus.emit(Events.INVENTORY_UPDATED, payload);
+  };
+
+  const checkLowStock = (productId: string): void => {
+    const threshold = thresholds.get(productId);
+    if (threshold === undefined) return;
+
+    const currentQuantity = getQuantity(productId);
+    if (currentQuantity > threshold) return;
+
+    const payload: LowStockAlertEvent = { productId, currentQuantity, threshold };
+    void bus.emit(Events.LOW_STOCK_ALERT, payload);
+  };
+
+  const applyQuantity = (productId: string, quantity: number): void => {
+    stock.set(productId, quantity);
+    emitUpdated(productId, quantity);
+    checkLowStock(productId);
+  };
+
+  return {
+    setStock(productId, quantity) {
+      applyQuantity(productId, Math.max(0, quantity));
+    },
+
+    getStock(productId) {
+      return getQuantity(productId);
+    },
+
+    reserve(productId, quantity) {
+      if (quantity <= 0) return false;
+
+      const available = getQuantity(productId);
+      if (available < quantity) return false;
+
+      applyQuantity(productId, available - quantity);
+      return true;
+    },
+
+    release(productId, quantity) {
+      if (quantity <= 0) return;
+      applyQuantity(productId, getQuantity(productId) + quantity);
+    },
+
+    setLowStockThreshold(productId, threshold) {
+      thresholds.set(productId, threshold);
+      checkLowStock(productId);
+    },
+  };
+}
