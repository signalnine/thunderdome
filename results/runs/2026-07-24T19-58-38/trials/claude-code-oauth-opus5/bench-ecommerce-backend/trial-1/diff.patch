@@ -0,0 +1,51 @@
+import type { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+import type { PricingService, ProductCreatedEvent } from '../types.js';
+
+const TAX_RATE = 0.1;
+
+/** Money is kept to cent precision so float drift never leaks into totals. */
+function round2(value: number): number {
+  return Math.round(value * 100) / 100;
+}
+
+export function createPricingService(bus: EventBus): PricingService {
+  const prices = new Map<string, number>();
+  const discountCodes = new Map<string, number>();
+
+  bus.on(Events.PRODUCT_CREATED, (payload) => {
+    const { productId, price } = payload as ProductCreatedEvent;
+    prices.set(productId, price);
+  });
+
+  return {
+    calculateTotal(items, discountCode) {
+      const subtotal = round2(
+        items.reduce((sum, item) => sum + item.price * item.quantity, 0),
+      );
+
+      const percentage = discountCode
+        ? discountCodes.get(discountCode.trim().toUpperCase())
+        : undefined;
+      const discount = percentage ? round2(subtotal * (percentage / 100)) : 0;
+
+      // Tax applies to the discounted amount, not the gross subtotal.
+      const taxable = round2(subtotal - discount);
+      const tax = round2(taxable * TAX_RATE);
+      const total = round2(taxable + tax);
+
+      return { subtotal, discount, tax, total };
+    },
+
+    addDiscountCode(code, percentage) {
+      const normalized = code.trim().toUpperCase();
+      if (normalized === '') return;
+
+      discountCodes.set(normalized, Math.min(100, Math.max(0, percentage)));
+    },
+
+    getPrice(productId) {
+      return prices.get(productId) ?? 0;
+    },
+  };
+}
