@@ -0,0 +1,16 @@
+import type { EventBus } from '../bus.js';
+
+/**
+ * Publishes an event without blocking the caller.
+ *
+ * Most service methods are synchronous (`void`) by contract, so they cannot
+ * await the bus. Handlers still run to completion in the background; this
+ * helper just makes sure a throwing subscriber degrades into an isolated
+ * no-op rather than an unhandled rejection that would take down the process.
+ */
+export function emitAsync(bus: EventBus, event: string, payload: unknown): void {
+  void bus.emit(event, payload).catch(() => {
+    // A failing subscriber is not the publisher's problem: the event is
+    // already recorded in the bus log and other services stay unaffected.
+  });
+}
