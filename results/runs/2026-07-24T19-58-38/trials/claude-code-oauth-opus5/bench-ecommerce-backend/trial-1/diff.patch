+import { v4 as uuid } from 'uuid';
+import type { EventBus } from '../bus.js';
+import { Events, PaymentStatus } from '../types.js';
+import type { PaymentProcessedEvent, PaymentService } from '../types.js';
+
+export interface PaymentServiceOptions {
+  /** Force every charge to be declined by the gateway. */
+  simulateFailure?: boolean;
+  /** Force every charge to exceed the gateway deadline. */
+  simulateTimeout?: boolean;
+  /** Latency of a normal round trip to the gateway, in milliseconds. */
+  processingDelayMs?: number;
+  /** How long a simulated timeout waits before giving up, in milliseconds. */
+  timeoutMs?: number;
+}
+
+interface Transaction {
+  transactionId: string;
+  orderId: string;
+  amount: number;
+  refunded: boolean;
+}
+
+type PaymentResult = { status: PaymentStatus; transactionId?: string; error?: string };
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export function createPaymentService(
+  bus: EventBus,
+  options: PaymentServiceOptions = {},
+): PaymentService {
+  const {
+    simulateFailure = false,
+    simulateTimeout = false,
+    processingDelayMs = 0,
+    timeoutMs = 50,
+  } = options;
+
+  const transactions = new Map<string, Transaction>();
+
+  async function settle(orderId: string, result: PaymentResult): Promise<PaymentResult> {
+    const payload: PaymentProcessedEvent = {
+      orderId,
+      status: result.status,
+      transactionId: result.transactionId,
+      error: result.error,
+    };
+    // Awaited so callers observe a fully propagated payment before continuing.
+    await bus.emit(Events.PAYMENT_PROCESSED, payload);
+    return result;
+  }
+
+  return {
+    async processPayment(orderId, amount) {
+      if (!(amount > 0)) {
+        return settle(orderId, {
+          status: PaymentStatus.FAILED,
+          error: `Invalid payment amount: ${amount}`,
+        });
+      }
+
+      if (simulateTimeout) {
+        await delay(timeoutMs);
+        return settle(orderId, {
+          status: PaymentStatus.TIMEOUT,
+          error: `Payment gateway timed out after ${timeoutMs}ms`,
+        });
+      }
+
+      await delay(processingDelayMs);
+
+      if (simulateFailure) {
+        return settle(orderId, {
+          status: PaymentStatus.FAILED,
+          error: 'Payment declined by gateway',
+        });
+      }
+
+      const transactionId = `txn_${uuid()}`;
+      transactions.set(transactionId, { transactionId, orderId, amount, refunded: false });
+
+      return settle(orderId, { status: PaymentStatus.SUCCESS, transactionId });
+    },
+
+    async refund(transactionId) {
+      await delay(processingDelayMs);
+
+      const transaction = transactions.get(transactionId);
+      // Unknown transactions and double refunds are both rejected.
+      if (!transaction || transaction.refunded) return false;
+
+      transaction.refunded = true;
+      return true;
+    },
+  };
+}
