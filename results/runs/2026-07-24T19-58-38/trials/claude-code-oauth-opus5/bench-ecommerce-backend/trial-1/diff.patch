@@ -0,0 +1,111 @@
+import type { EventBus } from '../bus.js';
+import { Events, PaymentStatus } from '../types.js';
+import type {
+  AnalyticsEvent,
+  AnalyticsService,
+  CartUpdatedEvent,
+  OrderCreatedEvent,
+  PaymentProcessedEvent,
+} from '../types.js';
+
+/**
+ * Every domain event analytics observes. `analytics:event` is deliberately
+ * absent: it is this service's own output and subscribing would recurse.
+ */
+const TRACKED_EVENTS: readonly string[] = [
+  Events.PRODUCT_CREATED,
+  Events.INVENTORY_UPDATED,
+  Events.LOW_STOCK_ALERT,
+  Events.CART_UPDATED,
+  Events.PRICE_CALCULATED,
+  Events.ORDER_CREATED,
+  Events.ORDER_STATUS_CHANGED,
+  Events.PAYMENT_PROCESSED,
+  Events.NOTIFICATION_SENT,
+];
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const seenCarts = new Set<string>();
+  const seenOrders = new Set<string>();
+  /** Last known contents of each cart, used to attribute an order's products. */
+  const cartContents = new Map<string, Array<{ productId: string; quantity: number }>>();
+  /** Order totals, banked as revenue only once payment succeeds. */
+  const orderTotals = new Map<string, number>();
+  const productCounts = new Map<string, number>();
+  let revenue = 0;
+
+  function record(event: string, payload: unknown): void {
+    switch (event) {
+      case Events.CART_UPDATED: {
+        const { cartId, items } = payload as CartUpdatedEvent;
+        seenCarts.add(cartId);
+        cartContents.set(cartId, items.map((item) => ({ ...item })));
+        break;
+      }
+
+      case Events.ORDER_CREATED: {
+        const { orderId, cartId, total } = payload as OrderCreatedEvent;
+        seenOrders.add(orderId);
+        orderTotals.set(orderId, total);
+
+        for (const item of cartContents.get(cartId) ?? []) {
+          productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+        }
+        break;
+      }
+
+      case Events.PAYMENT_PROCESSED: {
+        const { orderId, status } = payload as PaymentProcessedEvent;
+        if (status === PaymentStatus.SUCCESS) {
+          revenue += orderTotals.get(orderId) ?? 0;
+        }
+        break;
+      }
+
+      default:
+        break;
+    }
+  }
+
+  for (const event of TRACKED_EVENTS) {
+    bus.on(event, async (payload) => {
+      // Metrics are updated before republishing so that any consumer of
+      // `analytics:event` sees a fully settled snapshot.
+      eventCounts.set(event, (eventCounts.get(event) ?? 0) + 1);
+      record(event, payload);
+
+      const summary: AnalyticsEvent = {
+        event,
+        data: (payload ?? {}) as Record<string, unknown>,
+        timestamp: Date.now(),
+      };
+      await bus.emit(Events.ANALYTICS_EVENT, summary);
+    });
+  }
+
+  return {
+    getEventCount(eventType) {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue() {
+      return revenue;
+    },
+
+    getConversionRate() {
+      if (seenCarts.size === 0) return 0;
+      return seenOrders.size / seenCarts.size;
+    },
+
+    getTopProducts(limit) {
+      if (limit <= 0) return [];
+
+      return [...productCounts.entries()]
+        .map(([productId, count]) => ({ productId, count }))
+        // Ties break on productId so the ranking is stable across runs.
+        .sort((a, b) => b.count - a.count || a.productId.localeCompare(b.productId))
+        .slice(0, limit);
+    },
+  };
+}
