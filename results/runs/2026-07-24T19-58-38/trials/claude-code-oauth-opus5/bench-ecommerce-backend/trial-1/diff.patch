edEvent;\n    const userId = orderOwners.get(orderId);\n    if (!userId) return;\n\n    await notify(\n      userId,\n      'order_status',\n      `Order ${orderId} moved from ${previousStatus} to ${status}.`,\n    );\n  });\n\n  bus.on(Events.PAYMENT_PROCESSED, async (payload) => {\n    const { orderId, status, error } = payload as PaymentProcessedEvent;\n    const userId = orderOwners.get(orderId);\n    if (!userId) return;\n\n    const message =\n      status === PaymentStatus.SUCCESS\n        ? `Payment for order ${orderId} succeeded.`\n        : `Payment for order ${orderId} ${status}${error ? `: ${error}` : ''}.`;\n\n    await notify(userId, 'payment', message);\n  });\n\n  return {\n    subscribe(userId) {\n      subscribers.add(userId);\n      if (!inboxes.has(userId)) inboxes.set(userId, []);\n    },\n\n    getNotifications(userId) {\n      return (inboxes.get(userId) ?? []).map((notification) => ({ ...notification }));\n    },\n  };\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
