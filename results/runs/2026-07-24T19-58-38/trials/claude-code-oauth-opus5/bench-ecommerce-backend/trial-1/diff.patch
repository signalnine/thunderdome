@@ -0,0 +1,67 @@
+import type { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+import type { InventoryService, InventoryUpdatedEvent, LowStockAlertEvent } from '../types.js';
+import { emitAsync } from '../shared/emit.js';
+
+export function createInventoryService(bus: EventBus): InventoryService {
+  const stock = new Map<string, number>();
+  const thresholds = new Map<string, number>();
+
+  /**
+   * Alerts when the on-hand quantity reaches or falls under the configured
+   * reorder point. Products without an explicit threshold never alert.
+   */
+  function checkLowStock(productId: string): void {
+    const threshold = thresholds.get(productId);
+    if (threshold === undefined) return;
+
+    const currentQuantity = stock.get(productId) ?? 0;
+    if (currentQuantity > threshold) return;
+
+    const payload: LowStockAlertEvent = { productId, currentQuantity, threshold };
+    emitAsync(bus, Events.LOW_STOCK_ALERT, payload);
+  }
+
+  /** Writes the new quantity, announces it, then evaluates the reorder point. */
+  function applyQuantity(productId: string, quantity: number): void {
+    const next = Math.max(0, quantity);
+    stock.set(productId, next);
+
+    const payload: InventoryUpdatedEvent = { productId, quantity: next };
+    emitAsync(bus, Events.INVENTORY_UPDATED, payload);
+
+    checkLowStock(productId);
+  }
+
+  return {
+    setStock(productId, quantity) {
+      applyQuantity(productId, quantity);
+    },
+
+    getStock(productId) {
+      return stock.get(productId) ?? 0;
+    },
+
+    reserve(productId, quantity) {
+      if (quantity <= 0) return false;
+
+      const available = stock.get(productId) ?? 0;
+      if (available < quantity) return false;
+
+      applyQuantity(productId, available - quantity);
+      return true;
+    },
+
+    release(productId, quantity) {
+      if (quantity <= 0) return;
+
+      const available = stock.get(productId) ?? 0;
+      applyQuantity(productId, available + quantity);
+    },
+
+    setLowStockThreshold(productId, threshold) {
+      thresholds.set(productId, Math.max(0, threshold));
+      checkLowStock(productId);
+    },
+  };
+}
