+import { v4 as uuid } from 'uuid';
+import type { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+import type { CatalogService, ProductCreatedEvent } from '../types.js';
+import { emitAsync } from '../shared/emit.js';
+
+interface Product {
+  id: string;
+  name: string;
+  price: number;
+  category: string;
+}
+
+/** Defensive copy so callers cannot mutate the catalog's internal state. */
+function snapshot(product: Product): Product {
+  return { ...product };
+}
+
+export function createCatalogService(bus: EventBus): CatalogService {
+  const products = new Map<string, Product>();
+
+  return {
+    createProduct(name, price, category) {
+      const id = uuid();
+      products.set(id, { id, name, price, category });
+
+      const payload: ProductCreatedEvent = { productId: id, name, price, category };
+      emitAsync(bus, Events.PRODUCT_CREATED, payload);
+
+      return id;
+    },
+
+    getProduct(productId) {
+      const product = products.get(productId);
+      return product ? snapshot(product) : null;
+    },
+
+    listProducts(category) {
+      return [...products.values()]
+        .filter((product) => category === undefined || product.category === category)
+        .map(snapshot);
+    },
+
+    searchProducts(query) {
+      const needle = query.trim().toLowerCase();
+      if (needle === '') return [];
+
+      return [...products.values()]
+        .filter(
+          (product) =>
+            product.name.toLowerCase().includes(needle) ||
+            product.category.toLowerCase().includes(needle),
+        )
+        .map(snapshot);
+    },
+
+    updateProduct(productId, updates) {
+      const product = products.get(productId);
+      if (!product) return;
+
+      if (updates.name !== undefined) product.name = updates.name;
+      if (updates.price !== undefined) product.price = updates.price;
+      if (updates.category !== undefined) product.category = updates.category;
+    },
+
+    removeProduct(productId) {
+      return products.delete(productId);
+    },
+  };
+}
