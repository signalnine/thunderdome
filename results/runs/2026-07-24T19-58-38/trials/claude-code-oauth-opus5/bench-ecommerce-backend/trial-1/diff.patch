+import { v4 as uuid } from 'uuid';
+import type { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+import type { CartService, CartUpdatedEvent } from '../types.js';
+import { emitAsync } from '../shared/emit.js';
+
+interface CartItem {
+  productId: string;
+  quantity: number;
+}
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: CartItem[];
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  /** Announces the full post-change contents of a cart. */
+  function publish(cart: Cart): void {
+    const payload: CartUpdatedEvent = {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: cart.items.map((item) => ({ ...item })),
+    };
+    emitAsync(bus, Events.CART_UPDATED, payload);
+  }
+
+  return {
+    createCart(userId) {
+      const id = uuid();
+      carts.set(id, { id, userId, items: [] });
+      return id;
+    },
+
+    addItem(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart || quantity <= 0) return;
+
+      const existing = cart.items.find((item) => item.productId === productId);
+      if (existing) {
+        existing.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+
+      publish(cart);
+    },
+
+    removeItem(cartId, productId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      const index = cart.items.findIndex((item) => item.productId === productId);
+      if (index === -1) return;
+
+      cart.items.splice(index, 1);
+      publish(cart);
+    },
+
+    getCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+
+      return {
+        id: cart.id,
+        userId: cart.userId,
+        items: cart.items.map((item) => ({ ...item })),
+      };
+    },
+
+    clearCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart || cart.items.length === 0) return;
+
+      cart.items = [];
+      publish(cart);
+    },
+
+    updateQuantity(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+
+      const index = cart.items.findIndex((item) => item.productId === productId);
+      if (index === -1) return;
+
+      // A non-positive quantity is a removal rather than an invalid state.
+      if (quantity <= 0) {
+        cart.items.splice(index, 1);
+      } else {
+        cart.items[index].quantity = quantity;
+      }
+
+      publish(cart);
+    },
+  };
+}
