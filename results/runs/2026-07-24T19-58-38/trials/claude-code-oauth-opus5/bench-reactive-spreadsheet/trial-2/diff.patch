+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qp5j3KixLexUDm9tLW4dzw","type":"tool_result","content":"1\timport type { Node } from './ast.js';\n2\timport { evaluate, type Resolver } from './evaluator.js';\n3\timport {\n4\t  CircularReferenceError,\n5\t  SpreadsheetError,\n6\t  isFormulaError,\n7\t} from './errors.js';\n8\timport { parseFormula, walk } from './parser.js';\n9\timport { compareRefs, expandRange, normalizeRef } from './reference.js';\n10\timport { formatValue, toPublicValue, type CellValue, type EvalValue } from './values.js';\n11\t\n12\t/** What a caller may store in a cell. Strings beginning with `=` are formulas. */\n13\texport type CellInput = string | number | boolean;\n14\t\n15\t/** A cell's stored content together with its computed value. */\n16\tinterface Cell {\n17\t  /** Exactly what the caller passed to {@link Spreadsheet.set}. */\n18\t  readonly input: CellInput;\n19\t  /** Parsed formula, or `null` for a literal value. */\n20\t  readonly formula: Node | null;\n21\t  /** Cells this one reads. Empty for literals. */\n22\t  readonly precedents: ReadonlySet<string>;\n23\t  /** Latest computed value; errors are kept as `FormulaError` objects. */\n24\t  value: EvalValue;\n25\t}\n26\t\n27\t/**\n28\t * A reactive spreadsheet.\n29\t *\n30\t * Cells hold literal values or formulas. The engine tracks which cells each\n31\t * formula reads and, whenever a cell changes, recomputes exactly the cells\n32\t * that transitively depend on it — in dependency order, so every formula sees\n33\t * up-to-date inputs.\n34\t *\n35\t * @example\n36\t * ```ts\n37\t * const sheet = new Spreadsheet();\n38\t * sheet.set('A1', 10);\n39\t * sheet.set('A2', 20);\n40\t * sheet.set('A3', '=A1+A2');\n41\t * sheet.get('A3'); // 30\n42\t * sheet.set('A1', 50);\n43\t * sheet.get('A3'); // 70 — recomputed automatically\n44\t * ```\n45\t */\n46\texport class Spreadsheet {\n47\t  /** Cell key (`A1`) to its content. Empty cells are absent. */\n48\t  private readonly cells = new Map<string, Cell>();\n49\t\n50\t  /** Reverse index: cell key to the cells whose formulas read it. */\n51\t  private readonly dependents = new Map<string, Set<string>>();\n52\t\n53\t  /** Reads a cell's current value; empty cells read as `null`. */\n54\t  private readonly resolve: Resolver = (key) => this.cells.get(key)?.value ?? null;\n55\t\n56\t  /**\n57\t   * Stores a value in a cell and recomputes everything that depends on it.\n58\t   *\n59\t   * A string starting with `=` is parsed as a formula; every other string is\n60\t   * stored as text, even if it looks numeric. Setting a cell to `''` clears\n61\t   * it.\n62\t   *\n63\t   * @throws {InvalidReferenceError} if `ref` is not a valid cell reference.\n64\t   * @throws {FormulaSyntaxError} if a formula cannot be parsed.\n65\t   * @throws {CircularReferenceError} if the formula would depend on itself,\n66\t   *   directly or through other cells. The sheet is left unchanged.\n67\t   */\n68\t  set(ref: string, value: CellInput): void {\n69\t    const key = normalizeRef(ref);\n70\t\n71\t    if (typeof value === 'string' && value === '') {\n72\t      this.clear(key);\n73\t      return;\n74\t    }\n75\t    validateInput(key, value);\n76\t\n77\t    let formula: Node | null = null;\n78\t    let precedents: ReadonlySet<string> = EMPTY_SET;\n79\t\n80\t    if (typeof value === 'string' && value.startsWith('=')) {\n81\t      formula = parseFormula(value.slice(1));\n82\t      precedents = collectPrecedents(formula);\n83\t\n84\t      // Reject cycles *before* mutating anything, so a rejected `set` is a\n85\t      // complete no-op.\n86\t      const cycle = this.findCycle(key, precedents);\n87\t      if (cycle) throw new CircularReferenceError(cycle);\n88\t    }\n89\t\n90\t    this.unlink(key);\n91\t    this.cells.set(key, { input: value, formula, precedents, value: null });\n92\t    for (const precedent of precedents) {\n93\t      let set = this.dependents.get(precedent);\n94\t      if (!set) {\n95