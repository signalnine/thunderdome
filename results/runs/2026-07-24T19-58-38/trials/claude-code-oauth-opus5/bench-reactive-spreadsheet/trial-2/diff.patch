lValue } from './values.js';\n\n/** What a caller may store in a cell. Strings beginning with `=` are formulas. */\nexport type CellInput = string | number | boolean;\n\n/** A cell's stored content together with its computed value. */\ninterface Cell {\n  /** Exactly what the caller passed to {@link Spreadsheet.set}. */\n  readonly input: CellInput;\n  /** Parsed formula, or `null` for a literal value. */\n  readonly formula: Node | null;\n  /** Cells this one reads. Empty for literals. */\n  readonly precedents: ReadonlySet<string>;\n  /** Latest computed value; errors are kept as `FormulaError` objects. */\n  value: EvalValue;\n}\n\n/**\n * A reactive spreadsheet.\n *\n * Cells hold literal values or formulas. The engine tracks which cells each\n * formula reads and, whenever a cell changes, recomputes exactly the cells\n * that transitively depend on it — in dependency order, so every formula sees\n * up-to-date inputs.\n *\n * @example\n * ```ts\n * const sheet = new Spreadsheet();\n * sheet.set('A1', 10);\n * sheet.set('A2', 20);\n * sheet.set('A3', '=A1+A2');\n * sheet.get('A3'); // 30\n * sheet.set('A1', 50);\n * sheet.get('A3'); // 70 — recomputed automatically\n * ```\n */\nexport class Spreadsheet {\n  /** Cell key (`A1`) to its content. Empty cells are absent. */\n  private readonly cells = new Map<string, Cell>();\n\n  /** Reverse index: cell key to the cells whose formulas read it. */\n  private readonly dependents = new Map<string, Set<string>>();\n\n  /** Reads a cell's current value; empty cells read as `null`. */\n  private readonly resolve: Resolver = (key) => this.cells.get(key)?.value ?? null;\n\n  /**\n   * Stores a value in a cell and recomputes everything that depends on it.\n   *\n   * A string starting with `=` is parsed as a formula; every other string is\n   * stored as text, even if it looks numeric. Setting a cell to `''` clears\n   * it.\n   *\n   * @throws {InvalidReferenceError} if `ref` is not a valid cell reference.\n   * @throws {FormulaSyntaxError} if a formula cannot be parsed.\n   * @throws {CircularReferenceError} if the formula would depend on itself,\n   *   directly or through other cells. The sheet is left unchanged.\n   */\n  set(ref: string, value: CellInput): void {\n    const key = normalizeRef(ref);\n\n    if (typeof value === 'string' && value === '') {\n      this.clear(key);\n      return;\n    }\n    validateInput(key, value);\n\n    let formula: Node | null = null;\n    let precedents: ReadonlySet<string> = EMPTY_SET;\n\n    if (typeof value === 'string' && value.startsWith('=')) {\n      formula = parseFormula(value.slice(1));\n      precedents = collectPrecedents(formula);\n\n      // Reject cycles *before* mutating anything, so a rejected `set` is a\n      // complete no-op.\n      const cycle = this.findCycle(key, precedents);\n      if (cycle) throw new CircularReferenceError(cycle);\n    }\n\n    this.unlink(key);\n    this.cells.set(key, { input: value, formula, precedents, value: null });\n    for (const precedent of precedents) {\n      let set = this.dependents.get(precedent);\n      if (!set) {\n        set = new Set();\n        this.dependents.set(precedent, set);\n      }\n      set.add(key);\n    }\n\n    this.recompute(key);\n  }\n\n  /**\n   * Returns a cell's computed value, or `null` if the cell is empty.\n   * Cells holding an error report it as its code, e.g. `\"#DIV/0!\"`.\n   */\n  get(ref: string): CellValue {\n    const cell = this.cells.get(normalizeRef(ref));\n    return cell ? toPublicValue(cell.value) : null;\n  }\n\n  /**\n   * Returns the string a spreadsheet would display for a cell: `''` for empty\n   * cells, `'TRUE'`/`'FALSE'` for booleans, numbers rounded to 15 significant\n   * digits, and error codes for errors.\n   */\n  getDisplay(ref: string): string {\n    const cell = this.cells.get(normalizeRef(ref));\n    return cell ? formatValue(cell.value) : '';\n  }\n\n  /** Returns the original input for a cell — formula text included — or `null`. */\n  getRaw(ref: string): CellInput | null {\n    return this.cells.get(normalizeRef(ref))?.input ?? null;\n  }\n\n  /** True when the cell holds a formula. */\n  isFormula(ref: string): boolean {\n    return this.cells.get(normalizeRef(ref))?.formula != null;\n  }\n\n  /** True when the cell holds an error value. */\n  hasError(ref: string): boolean {\n    const cell = this.cells.get(normalizeRef(ref));\n    return cell ? isFormulaError(cell.value) : false;\n  }\n\n  /**\n   * Every non-empty cell and its computed value, ordered the way a sheet\n   * reads: top to bottom, then left to right.\n   */\n  getCells(): Map<string, CellValue> {\n    const keys = [...this.cells.keys()].sort(compareRefs);\n    return new Map(keys.map((key) => [key, toPublicValue(this.cells.get(key)!.value)]));\n  }\n\n  /** Empties a cell and recomputes anything that referenced it. */\n  clear(ref: string): void {\n    const key = normalizeRef(ref);\n    if (!this.cells.has(key)) return;\n    this.unlink(key);\n    this.cells.delete(key);\n    this.recompute(key);\n  }\n\n  /** Removes every cell from the sheet. */\n  clearAll(): void {\n    this.cells.clear();\n    this.dependents.clear();\n  }\n\n  /** The cells whose formulas read `ref`, directly. */\n  getDependents(ref: string): string[] {\n    return [...(this.dependents.get(normalizeRef(ref)) ?? [])].sort(compareRefs);\n  }\n\n  /** The cells that `ref`'s formula reads, directly. */\n  getPrecedents(ref: string): string[] {\n    const cell = this.cells.get(normalizeRef(ref));\n    return cell ? [...cell.precedents].sort(compareRefs) : [];\n  }\n\n  /** Drops the edges recorded for `key`'s current formula. */\n  private unlink(key: string): void {\n    const cell = this.cells.get(key);\n    if (!cell) return;\n    for (const precedent of cell.precedents) {\n      const set = this.dependents.get(precedent);\n      if (!set) continue;\n      set.delete(key);\n      if (set.size === 0) this.dependents.delete(precedent);\n    }\n  }\n\n  /**\n   * Searches the precedent graph for a path from any of `precedents` back to\n   * `target`. Returns the offending chain, or `null` when there is none.\n   */\n  private findCycle(target: string, precedents: ReadonlySet<string>): string[] | null {\n    /** Records, for each visited cell, the cell that led us to it. */\n    const cameFrom = new Map<string, string>();\n    const visited = new Set<string>();\n    const stack: string[] = [];\n\n    for (const precedent of precedents) {\n      cameFrom.set(precedent, target);\n      stack.push(precedent);\n    }\n\n    while (stack.length > 0) {\n      const key = stack.pop()!;\n\n      if (key === target) {\n        const path = [key];\n        let current = key;\n        // Walk back along `cameFrom` until we return to the target.\n        while (cameFrom.has(current)) {\n          current = cameFrom.get(current)!;\n          path.push(current);\n          if (current === target) break;\n        }\n        return path.reverse();\n      }\n\n      if (visited.has(key)) continue;\n      visited.add(key);\n\n      const cell = this.cells.get(key);\n      if (!cell) continue;\n      for (const precedent of cell.precedents) {\n        if (!cameFrom.has(precedent)) cameFrom.set(precedent, key);\n        stack.push(precedent);\n      }\n    }\n\n    return null;\n  }\n\n  /**\n   * Recomputes `seed` and every cell that transitively depends on it.\n   *\n   * The affected cells are evaluated in topological order (Kahn's algorithm\n   * over the sub-graph), which guarantees each formula runs only after all of\n   * its inputs are up to date, and that each cell is evaluated exactly once.\n   */\n  private recompute(seed: string): void {\n    const affected = new Set<string>([seed]);\n    const frontier = [seed];\n    while (frontier.length > 0) {\n      const key = frontier.pop()!;\n      for (const dependent of this.dependents.get(key) ?? EMPTY_SET) {\n        if (affected.has(dependent)) continue;\n        affected