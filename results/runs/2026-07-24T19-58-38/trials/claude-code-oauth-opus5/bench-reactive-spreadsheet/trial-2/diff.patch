new file mode 100644
index 0000000..165ec01
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,179 @@
+import type { BinaryOperator, Node } from './ast.js';
+import { ErrorCode, FormulaError, isFormulaError } from './errors.js';
+import { BUILTIN_FUNCTIONS, isRangeValue, type ArgValue, type RangeValue } from './functions.js';
+import { expandRange, type RangeRef } from './reference.js';
+import { compareValues, toBoolean, toNumber, type CellValue, type EvalValue } from './values.js';
+
+/** Looks up the current value of a cell by its canonical key. */
+export type Resolver = (key: string) => EvalValue;
+
+/**
+ * Evaluates a parsed formula against the current sheet contents.
+ *
+ * Evaluation never throws for data-level problems: a bad operand or a
+ * division by zero becomes a {@link FormulaError} value that propagates
+ * outward, exactly as `#VALUE!` does in a spreadsheet.
+ */
+export function evaluate(node: Node, resolve: Resolver): EvalValue {
+  const result = evaluateNode(node, resolve);
+  if (isRangeValue(result)) {
+    // A range is only meaningful as a function argument.
+    return new FormulaError(ErrorCode.VALUE, 'A range cannot be used as a single value');
+  }
+  return result;
+}
+
+function evaluateNode(node: Node, resolve: Resolver): ArgValue {
+  switch (node.type) {
+    case 'number':
+    case 'string':
+    case 'boolean':
+      return node.value;
+
+    case 'reference':
+      return resolve(node.key);
+
+    case 'range':
+      return evaluateRange(node.range, resolve);
+
+    case 'unary': {
+      const operand = evaluateNode(node.operand, resolve);
+      if (isRangeValue(operand)) {
+        return new FormulaError(ErrorCode.VALUE, 'A range cannot be negated');
+      }
+      const numeric = toNumber(operand);
+      if (isFormulaError(numeric)) return numeric;
+      return node.operator === '-' ? -numeric : numeric;
+    }
+
+    case 'binary':
+      return evaluateBinary(node.operator, node.left, node.right, resolve);
+
+    case 'call':
+      return evaluateCall(node.name, node.args, resolve);
+  }
+}
+
+function evaluateRange(range: RangeRef, resolve: Resolver): RangeValue {
+  return { kind: 'range', values: expandRange(range).map((key) => resolve(key)) };
+}
+
+const COMPARISONS: Record<string, (order: number) => boolean> = {
+  '=': (order) => order === 0,
+  '<>': (order) => order !== 0,
+  '<': (order) => order < 0,
+  '<=': (order) => order <= 0,
+  '>': (order) => order > 0,
+  '>=': (order) => order >= 0,
+};
+
+function evaluateBinary(
+  operator: BinaryOperator,
+  leftNode: Node,
+  rightNode: Node,
+  resolve: Resolver,
+): EvalValue {
+  const left = evaluateNode(leftNode, resolve);
+  const right = evaluateNode(rightNode, resolve);
+
+  if (isRangeValue(left) || isRangeValue(right)) {
+    return new FormulaError(ErrorCode.VALUE, `A range cannot be an operand of "${operator}"`);
+  }
+  if (isFormulaError(left)) return left;
+  if (isFormulaError(right)) return right;
+
+  const compare = COMPARISONS[operator];
+  if (compare) {
+    return compare(compareValues(left as CellValue, right as CellValue));
+  }
+
+  const a = toNumber(left);
+  if (isFormulaError(a)) return a;
+  const b = toNumber(right);
+  if (isFormulaError(b)) return b;
+
+  switch (operator) {
+    case '+':
+      return finite(a + b);
+    case '-':
+      return finite(a - b);
+    case '*':
+      return finite(a * b);
+    case '/':
+      if (b === 0) return new FormulaError(ErrorCode.DIV0, 'Division by zero');
+      return finite(a / b);
+    default:
+      return new FormulaError(ErrorCode.VALUE, `Unsupported operator "${operator}"`);
+  }
+}
+
+/** Guards against overflow producing `Infinity`, which spreadsheets report as `#NUM!`. */
+function finite(value: number): EvalValue {
+  if (!Number.isFinite(value)) {
+    return new FormulaError(ErrorCode.NUM, 'Result is not a finite number');
+  }
+  return value;
+}
+
+function evaluateCall(name: string, args: Node[], resolve: Resolver): ArgValue {
+  if (name === 'IF') return evaluateIf(args, resolve);
+
+  const fn = BUILTIN_FUNCTIONS.get(name);
+  if (!fn) {
+    return new FormulaError(ErrorCode.NAME, `Unknown function "${name}"`);
+  }
+  if (args.length < fn.minArgs || args.length > fn.maxArgs) {
+    return new FormulaError(
+      ErrorCode.VALUE,
+      `${name} expects ${describeArity(fn.minArgs, fn.maxArgs)} but received ${args.length}`,
+    );
+  }
+  return fn.apply(args.map((arg) => evaluateArgument(arg, resolve)));
+}
+
+/**
+ * Evaluates one function argument.
+ *
+ * A reference is wrapped as a one-cell range so that aggregates treat it as
+ * *cell content* and filter it exactly as they filter a range: `SUM(A1,A2,A3)`
+ * and `SUM(A1:A3)` must agree. Literals and computed expressions are passed
+ * through, so a value written into the formula — `SUM(1, TRUE)` — still
+ * counts, which is the distinction Excel draws.
+ */
+function evaluateArgument(node: Node, resolve: Resolver): ArgValue {
+  const value = evaluateNode(node, resolve);
+  if (node.type === 'reference') {
+    return { kind: 'range', values: [value as EvalValue] };
+  }
+  return value;
+}
+
+/**
+ * `IF(condition, trueValue, falseValue)`.
+ *
+ * Only the selected branch is evaluated, so `IF(A1=0, 0, 1/A1)` stays safe
+ * when `A1` is zero. The false branch may be omitted and then defaults to
+ * `FALSE`.
+ */
+function evaluateIf(args: Node[], resolve: Resolver): ArgValue {
+  if (args.length < 2 || args.length > 3) {
+    return new FormulaError(ErrorCode.VALUE, `IF expects 2 or 3 arguments but received ${args.length}`);
+  }
+
+  const condition = evaluateNode(args[0], resolve);
+  if (isRangeValue(condition)) {
+    return new FormulaError(ErrorCode.VALUE, 'A range cannot be used as an IF condition');
+  }
+  const test = toBoolean(condition);
+  if (isFormulaError(test)) return test;
+
+  if (test) return evaluateNode(args[1], resolve);
+  if (args.length === 3) return evaluateNode(args[2], resolve);
+  return false;
+}
+
+function describeArity(min: number, max: number): string {
+  if (max === Infinity) return `at least ${min} argument${min === 1 ? '' : 's'}`;
+  if (min === max) return `${min} argument${min === 1 ? '' : 's'}`;
+  return `${min} to ${max} arguments`;
+}
