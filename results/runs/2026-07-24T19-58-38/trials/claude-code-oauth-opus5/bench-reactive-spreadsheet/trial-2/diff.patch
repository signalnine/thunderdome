@@ -0,0 +1,115 @@
+import { describe, expect, it } from 'vitest';
+import { InvalidReferenceError } from './errors.js';
+import {
+  columnToIndex,
+  compareRefs,
+  expandRange,
+  formatRef,
+  indexToColumn,
+  makeRange,
+  normalizeRef,
+  parseRef,
+  rangeSize,
+} from './reference.js';
+
+describe('column names', () => {
+  it('maps single letters', () => {
+    expect(columnToIndex('A')).toBe(0);
+    expect(columnToIndex('B')).toBe(1);
+    expect(columnToIndex('Z')).toBe(25);
+  });
+
+  it('maps multi-letter columns with bijective base-26', () => {
+    expect(columnToIndex('AA')).toBe(26);
+    expect(columnToIndex('AB')).toBe(27);
+    expect(columnToIndex('AZ')).toBe(51);
+    expect(columnToIndex('BA')).toBe(52);
+    expect(columnToIndex('ZZ')).toBe(701);
+    expect(columnToIndex('AAA')).toBe(702);
+  });
+
+  it('round-trips every index in the single- and double-letter space', () => {
+    for (let index = 0; index <= 800; index++) {
+      expect(columnToIndex(indexToColumn(index))).toBe(index);
+    }
+  });
+
+  it('renders indices back to letters', () => {
+    expect(indexToColumn(0)).toBe('A');
+    expect(indexToColumn(25)).toBe('Z');
+    expect(indexToColumn(26)).toBe('AA');
+    expect(indexToColumn(701)).toBe('ZZ');
+    expect(indexToColumn(702)).toBe('AAA');
+  });
+});
+
+describe('parseRef', () => {
+  it('parses a reference into zero-based column and one-based row', () => {
+    expect(parseRef('A1')).toEqual({ col: 0, row: 1 });
+    expect(parseRef('B2')).toEqual({ col: 1, row: 2 });
+    expect(parseRef('Z100')).toEqual({ col: 25, row: 100 });
+    expect(parseRef('AA1')).toEqual({ col: 26, row: 1 });
+  });
+
+  it('is case-insensitive and tolerates surrounding spaces', () => {
+    expect(parseRef('aa42')).toEqual(parseRef('AA42'));
+    expect(parseRef('  B7  ')).toEqual(parseRef('B7'));
+  });
+
+  it('rejects malformed references', () => {
+    for (const bad of ['', 'A', '1', 'A0', '1A', 'A1B', 'A 1', 'A-1', '$A$1', 'A1.5']) {
+      expect(() => parseRef(bad), bad).toThrow(InvalidReferenceError);
+    }
+  });
+
+  it('rejects references beyond the supported grid', () => {
+    expect(() => parseRef('AAAA1')).toThrow(InvalidReferenceError);
+    expect(() => parseRef('A1048577')).toThrow(InvalidReferenceError);
+  });
+
+  it('normalises to canonical upper-case text', () => {
+    expect(normalizeRef('aa1')).toBe('AA1');
+    expect(formatRef({ col: 26, row: 1 })).toBe('AA1');
+  });
+});
+
+describe('ranges', () => {
+  it('normalises corners given in either order', () => {
+    const forward = makeRange(parseRef('A1'), parseRef('C3'));
+    const reversed = makeRange(parseRef('C3'), parseRef('A1'));
+    expect(forward).toEqual(reversed);
+  });
+
+  it('expands a column range', () => {
+    const range = makeRange(parseRef('A1'), parseRef('A5'));
+    expect(expandRange(range)).toEqual(['A1', 'A2', 'A3', 'A4', 'A5']);
+  });
+
+  it('expands a row range', () => {
+    const range = makeRange(parseRef('A1'), parseRef('C1'));
+    expect(expandRange(range)).toEqual(['A1', 'B1', 'C1']);
+  });
+
+  it('expands a block in row-major order', () => {
+    const range = makeRange(parseRef('A1'), parseRef('B3'));
+    expect(expandRange(range)).toEqual(['A1', 'B1', 'A2', 'B2', 'A3', 'B3']);
+  });
+
+  it('reports its size', () => {
+    expect(rangeSize(makeRange(parseRef('A1'), parseRef('A5')))).toBe(5);
+    expect(rangeSize(makeRange(parseRef('A1'), parseRef('C3')))).toBe(9);
+    expect(rangeSize(makeRange(parseRef('B2'), parseRef('B2')))).toBe(1);
+  });
+
+  it('refuses to expand a range larger than the safety limit', () => {
+    const range = makeRange(parseRef('A1'), parseRef('ZZZ1048576'));
+    expect(() => expandRange(range)).toThrow(InvalidReferenceError);
+  });
+});
+
+describe('compareRefs', () => {
+  it('orders top-to-bottom, then left-to-right', () => {
+    const keys = ['B2', 'A1', 'C1', 'A2', 'AA1'];
+    expect([...keys].sort(compareRefs)).toEqual(['A1', 'C1', 'AA1', 'A2', 'B2']);
+  });
+});
