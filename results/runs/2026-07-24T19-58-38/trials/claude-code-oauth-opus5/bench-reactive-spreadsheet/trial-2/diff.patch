, () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B1', '=A1+5');\n    expect(sheet.get('B1')).toBe(5);\n  });\n});\n\ndescribe('cell references', () => {\n  it('reads other cells', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('B2', 20);\n    sheet.set('C3', '=A1+B2');\n    expect(sheet.get('C3')).toBe(30);\n  });\n\n  it('follows a chain of formulas', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 2);\n    sheet.set('A2', '=A1*2');\n    sheet.set('A3', '=A2*2');\n    sheet.set('A4', '=A3*2');\n    expect(sheet.get('A4')).toBe(16);\n  });\n\n  it('copies a value with a bare reference', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 'text');\n    sheet.set('B1', '=A1');\n    expect(sheet.get('B1')).toBe('text');\n  });\n\n  it('supports multi-letter columns', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('AA1', 5);\n    sheet.set('AB2', 7);\n    sheet.set('BZ100', '=AA1+AB2');\n    expect(sheet.get('BZ100')).toBe(12);\n  });\n\n  it('propagates errors through references', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=1/0');\n    sheet.set('A2', '=A1+1');\n    sheet.set('A3', '=A2*2');\n    expect(sheet.get('A2')).toBe('#DIV/0!');\n    expect(sheet.get('A3')).toBe('#DIV/0!');\n  });\n});\n\ndescribe('reactive updates', () => {\n  it('recomputes a direct dependent', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 5);\n    sheet.set('B1', '=A1+1');\n    expect(sheet.get('B1')).toBe(6);\n\n    sheet.set('A1', 10);\n    expect(sheet.get('B1')).toBe(11);\n  });\n\n  it('recomputes transitively through a long chain', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    for (let i = 2; i <= 50; i++) {\n      sheet.set(`A${i}`, `=A${i - 1}+1`);\n    }\n    expect(sheet.get('A50')).toBe(50);\n\n    sheet.set('A1', 101);\n    expect(sheet.get('A50')).toBe(150);\n  });\n\n  it('updates every branch of a diamond exactly once', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 4);\n    sheet.set('B1', '=A1*2');\n    sheet.set('B2', '=A1*3');\n    sheet.set('C1', '=B1+B2');\n    expect(sheet.get('C1')).toBe(20);\n\n    sheet.set('A1', 10);\n    expect(sheet.get('B1')).toBe(20);\n    expect(sheet.get('B2')).toBe(30);\n    expect(sheet.get('C1')).toBe(50);\n  });\n\n  it('recomputes when a referenced cell is filled in later', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B1', '=A1*2');\n    expect(sheet.get('B1')).toBe(0);\n\n    sheet.set('A1', 21);\n    expect(sheet.get('B1')).toBe(42);\n  });\n\n  it('recomputes ranges when any member changes', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('A2', 2);\n    sheet.set('B1', '=SUM(A1:A3)');\n    expect(sheet.get('B1')).toBe(3);\n\n    sheet.set('A3', 10);\n    expect(sheet.get('B1')).toBe(13);\n  });\n\n  it('drops stale dependencies when a formula is replaced', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('A2', 100);\n    sheet.set('B1', '=A1');\n    expect(sheet.get('B1')).toBe(1);\n\n    sheet.set('B1', '=A2');\n    expect(sheet.get('B1')).toBe(100);\n\n    // A1 is no longer an input, so changing it must not affect B1.\n    sheet.set('A1', 999);\n    expect(sheet.get('B1')).toBe(100);\n    expect(sheet.getDependents('A1')).toEqual([]);\n  });\n\n  it('recomputes when a formula becomes a literal', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 5);\n    sheet.set('B1', '=A1*2');\n    sheet.set('B1', 7);\n    expect(sheet.get('B1')).toBe(7);\n\n    sheet.set('A1', 100);\n    expect(sheet.get('B1')).toBe(7);\n  });\n\n  it('propagates a newly introduced error', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('B1', '=100/A1');\n    expect(sheet.get('B1')).toBe(10);\n\n    sheet.set('A1', 0);\n    expect(sheet.get('B1')).toBe('#DIV/0!');\n\n    sheet.set('A1', 4);\n    expect(sheet.get('B1')).toBe(25);\n  });\n\n  it('tracks dependencies through a wide fan-out', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 3);\n    for (let i = 1; i <= 100; i++) {\n      sheet.set(`B${i}`, `=A1*${i}`);\n    }\n    sheet.set('A1', 5);\n    expect(sheet.get('B1')).toBe(5);\n    expect(sheet.get('B50')).toBe(250);\n    expect(sheet.get('B100')).toBe(500);\n  });\n});\n\ndescribe('circular references', () => {\n  it('detects a self reference', () => {\n    const sheet = new Spreadsheet();\n    expect(() => sheet.set('A1', '=A1')).toThrow(CircularReferenceError);\n    expect(() => sheet.set('A1', '=A1+1')).toThrow(CircularReferenceError);\n  });\n\n  it('detects a two-cell cycle', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=B1');\n    expect(() => sheet.set('B1', '=A1')).toThrow(CircularReferenceError);\n  });\n\n  it('detects an indirect cycle through many cells', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=A2');\n    sheet.set('A2', '=A3');\n    sheet.set('A3', '=A4');\n    sheet.set('A4', '=A5');\n    expect(() => sheet.set('A5', '=A1')).toThrow(CircularReferenceError);\n  });\n\n  it('detects a cycle created through a range', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B1', '=SUM(A1:A5)');\n    expect(() => sheet.set('A3', '=B1*2')).toThrow(CircularReferenceError);\n  });\n\n  it('detects a cycle where the formula reaches itself through a range', () => {\n    const sheet = new Spreadsheet();\n    expect(() => sheet.set('A3', '=SUM(A1:A5)')).toThrow(CircularReferenceError);\n  });\n\n  it('reports the offending chain', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=B1');\n    sheet.set('B1', '=C1');\n    try {\n      sheet.set('C1', '=A1');\n      expect.unreachable('expected a CircularReferenceError');\n    } catch (error) {\n      expect(error).toBeInstanceOf(CircularReferenceError);\n      const { cycle, message } = error as CircularReferenceError;\n      expect(cycle[0]).toBe('C1');\n      expect(cycle[cycle.length - 1]).toBe('C1');\n      expect(cycle).toContain('A1');\n      expect(cycle).toContain('B1');\n      expect(message).toContain('Circular reference');\n    }\n  });\n\n  it('leaves the sheet untouched when a cycle is rejected', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1+1');\n    expect(() => sheet.set('A1', '=B1')).toThrow(CircularReferenceError);\n\n    // The rejected write must be a complete no-op.\n    expect(sheet.get('A1')).toBe(1);\n    expect(sheet.get('B1')).toBe(2);\n    expect(sheet.getRaw('A1')).toBe(1);\n    expect(sheet.getDependents('B1')).toEqual([]);\n\n    sheet.set('A1', 5);\n    expect(sheet.get('B1')).toBe(6);\n  });\n\n  it('allows a diamond, which is not a cycle', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1');\n    sheet.set('B2', '=A1');\n    expect(() => sheet.set('C1', '=B1+B2')).not.toThrow();\n    expect(sheet.get('C1')).toBe(2);\n  });\n\n  it('allows reusing a reference that was previously part of a rejected cycle', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=B1');\n    expect(() => sheet.set('B1', '=A1')).toThrow(CircularReferenceError);\n\n    sheet.set('A1', 10);\n    expect(() => sheet.set('B1', '=A1')).not.toThrow();\n    expect(sheet.get('B1')).toBe(10);\n  });\n});\n\ndescribe('scale', () => {\n  // These also guard the cost of `set`: cycle detection searches the cells\n  // that depend on the target rather than the whole upstream cone, which\n  // keeps building a deep chain linear instead of quadratic.\n  it('builds and propagates through a deep chain', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    for (let i = 2; i <= 5000; i++) {\n      sheet.set(`A${i}`, `=A${i - 1}+1`);\n    }\n    expect(sheet.get('A5000')).toBe(5000);\n\n    sheet.set('A1', 1001);\n    expect(sheet.get('A5000')).toBe(6000);\n  });\n\n  it('handles a cell with thousands of dependents', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 2);\n    for (let i = 1; i <= 5000; i++) {\n      sheet.set(`B${i}`, '=A1*3');\n    }\n    sheet.set('A1', 4);\n    expect(sheet.get('B1')).toBe(12);\n    expect(sheet.get('B5000')).toBe(12);\n  });\n\n  it('still detects a cycle closed at the end of a deep chain', () => {\n    // Built bottom-up, so the cycle closes at the far end of the chain from\n    // the cell being written — the case a one-directional search misses.\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=A2');\n    for (let i = 2; i <= 1000; i++) {\n      sheet.set(`A${i}`, `=A${i + 1}`);\n    }\n    expect(() => sheet.set('A1001', '=A1')).toThrow(CircularReferenceError);\n  });\n});\n\ndescribe('getDisplay', () => {\n  it('renders numbers without trailing noise', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=0.1+0.2');\n    sheet.set('A2', 30);\n    sheet.set('A3', 3.5);\n    expect(sheet.getDisplay('A1')).toBe('0.3');\n    expect(sheet.getDisplay('A2')).toBe('30');\n    expect(sheet.getDisplay('A3')).toBe('3.5');\n  });\n\n  it('renders text as-is', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 'hello');\n    expect(sheet.getDisplay('A1')).toBe('hello');\n  });\n\n  it('renders booleans in upper case, as a spreadsheet does', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', true);\n    sheet.set('A2', false);\n    expect(sheet.getDisplay('A1')).toBe('TRUE');\n    expect(sheet.getDisplay('A2')).toBe('FALSE');\n  });\n\n  it('renders empty cells as an empty string', () => {\n    const sheet = new Spreadsheet();\n    expect(sheet.getDisplay('A1')).toBe('');\n  });\n\n  it('renders errors as their code', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=1/0');\n    expect(sheet.getDisplay('A1')).toBe('#DIV/0!');\n  });\n\n  it('renders negative zero as zero', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=-0');\n    expect(sheet.getDisplay('A1')).toBe('0');\n  });\n});\n\ndescribe('getCells', () => {\n  it('returns every non-empty cell with its computed value', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 20);\n    sheet.set('A3', '=A1+A2');\n    sheet.set('B1', 'label');\n\n    const cells = sheet.getCells();\n    expect(cells.size).toBe(4);\n    expect(cells.get('A1')).toBe(10);\n    expect(cells.get('A2')).toBe(20);\n    expect(cells.get('A3')).toBe(30);\n    expect(cells.get('B1')).toBe('label');\n  });\n\n  it('omits empty cells and is empty for a new sheet', () => {\n    const sheet = new Spreadsheet();\n    expect(sheet.getCells().size).toBe(0);\n\n    sheet.set('A1', 1);\n    sheet.set('A1', '');\n    expect(sheet.getCells().size).toBe(0);\n  });\n\n  it('reads top-to-bottom then left-to-right', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B2', 1);\n    sheet.set('A1', 2);\n    sheet.set('C1', 3);\n    sheet.set('A2', 4);\n    expect([...sheet.getCells().keys()]).toEqual(['A1', 'C1', 'A2', 'B2']);\n  });\n\n  it('returns a snapshot that does not track later edits', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    const cells = sheet.getCells();\n    sheet.set('A1', 2);\n    expect(cells.get('A1')).toBe(1);\n  });\n});\n\ndescribe('clearing cells', () => {\n  it('clears with an empty string and recomputes dependents', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('B1', '=A1+5');\n    expect(sheet.get('B1')).toBe(15);\n\n    sheet.set('A1', '');\n    expect(sheet.get('A1')).toBeNull();\n    expect(sheet.get('B1')).toBe(5);\n  });\n\n  it('clears explicitly', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('B1', '=A1*2');\n    sheet.clear('A1');\n    expect(sheet.get('A1')).toBeNull();\n    expect(sheet.get('B1')).toBe(0);\n  });\n\n  it('releases a cleared formula’s dependencies', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1');\n    sheet.clear('B1');\n    expect(sheet.getDependents('A1')).toEqual([]);\n    expect(sheet.get('B1')).toBeNull();\n  });\n\n  it('ignores clearing an already empty cell', () => {\n    const sheet = new Spreadsheet();\n    expect(() => sheet.clear('A1')).not.toThrow();\n    expect(sheet.get('A1')).toBeNull();\n  });\n\n  it('empties the whole sheet', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1');\n    sheet.clearAll();\n    expect(sheet.getCells().size).toBe(0);\n    expect(sheet.get('B1')).toBeNull();\n  });\n});\n\ndescribe('inspection helpers', () => {\n  it('returns the original input including formula text', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 5);\n    sheet.set('A2', '=A1*2');\n    expect(sheet.getRaw('A1')).toBe(5);\n    expect(sheet.getRaw('A2')).toBe('=A1*2');\n    expect(sheet.getRaw('A3')).toBeNull();\n  });\n\n  it('reports which cells hold formulas and errors', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 5);\n    sheet.set('A2', '=A1*2');\n    sheet.set('A3', '=1/0');\n    expect(sheet.isFormula('A1')).toBe(false);\n    expect(sheet.isFormula('A2')).toBe(true);\n    expect(sheet.hasError('A2')).toBe(false);\n    expect(sheet.hasError('A3')).toBe(true);\n  });\n\n  it('lists direct precedents and dependents', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('C1', '=A1+B1');\n    sheet.set('C2', '=A1*2');\n    expect(sheet.getPrecedents('C1')).toEqual(['A1', 'B1']);\n    expect(sheet.getDependents('A1')).toEqual(['C1', 'C2']);\n    expect(sheet.getPrecedents('A1')).toEqual([]);\n  });\n});\n\ndescribe('invalid formulas', () => {\n  const sheet = new Spreadsheet();\n  const bad = ['=', '=1+', '=*2', '=(1+2', '=1+2)', '=A1 A2', '=\"unterminated', '=1..2', '=@A1'];\n\n  it.each(bad)('rej