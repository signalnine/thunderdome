n106\t      return new FormulaError(ErrorCode.VALUE, `Unsupported operator \"${operator}\"`);\n107\t  }\n108\t}\n109\t\n110\t/** Guards against overflow producing `Infinity`, which spreadsheets report as `#NUM!`. */\n111\tfunction finite(value: number): EvalValue {\n112\t  if (!Number.isFinite(value)) {\n113\t    return new FormulaError(ErrorCode.NUM, 'Result is not a finite number');\n114\t  }\n115\t  return value;\n116\t}\n117\t\n118\tfunction evaluateCall(name: string, args: Node[], resolve: Resolver): ArgValue {\n119\t  if (name === 'IF') return evaluateIf(args, resolve);\n120\t\n121\t  const fn = BUILTIN_FUNCTIONS.get(name);\n122\t  if (!fn) {\n123\t    return new FormulaError(ErrorCode.NAME, `Unknown function \"${name}\"`);\n124\t  }\n125\t  if (args.length < fn.minArgs || args.length > fn.maxArgs) {\n126\t    return new FormulaError(\n127\t      ErrorCode.VALUE,\n128\t      `${name} expects ${describeArity(fn.minArgs, fn.maxArgs)} but received ${args.length}`,\n129\t    );\n130\t  }\n131\t  return fn.apply(args.map((arg) => evaluateNode(arg, resolve)));\n132\t}\n133\t\n134\t/**\n135\t * `IF(condition, trueValue, falseValue)`.\n136\t *\n137\t * Only the selected branch is evaluated, so `IF(A1=0, 0, 1/A1)` stays safe\n138\t * when `A1` is zero. The false branch may be omitted and then defaults to\n139\t * `FALSE`.\n140\t */\n141\tfunction evaluateIf(args: Node[], resolve: Resolver): ArgValue {\n142\t  if (args.length < 2 || args.length > 3) {\n143\t    return new FormulaError(ErrorCode.VALUE, `IF expects 2 or 3 arguments but received ${args.length}`);\n144\t  }\n145\t\n146\t  const condition = evaluateNode(args[0], resolve);\n147\t  if (isRangeValue(condition)) {\n148\t    return new FormulaError(ErrorCode.VALUE, 'A range cannot be used as an IF condition');\n149\t  }\n150\t  const test = toBoolean(condition);\n151\t  if (isFormulaError(test)) return test;\n152\t\n153\t  if (test) return evaluateNode(args[1], resolve);\n154\t  if (args.length === 3) return eval