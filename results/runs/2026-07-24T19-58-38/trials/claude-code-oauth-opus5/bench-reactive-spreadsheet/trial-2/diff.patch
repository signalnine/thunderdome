+import { beforeEach, describe, expect, it } from 'vitest';
+import { BUILTIN_FUNCTIONS } from './functions.js';
+import { Spreadsheet } from './index.js';
+
+/** A sheet pre-filled with A1:A5 = 1..5 and a few non-numeric neighbours. */
+function numericSheet(): Spreadsheet {
+  const sheet = new Spreadsheet();
+  sheet.set('A1', 1);
+  sheet.set('A2', 2);
+  sheet.set('A3', 3);
+  sheet.set('A4', 4);
+  sheet.set('A5', 5);
+  return sheet;
+}
+
+describe('ranges', () => {
+  it('sums a column range', () => {
+    const sheet = numericSheet();
+    sheet.set('B1', '=SUM(A1:A5)');
+    expect(sheet.get('B1')).toBe(15);
+  });
+
+  it('sums a row range', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('B1', 20);
+    sheet.set('C1', 30);
+    sheet.set('D1', '=SUM(A1:C1)');
+    expect(sheet.get('D1')).toBe(60);
+  });
+
+  it('sums a rectangular block', () => {
+    const sheet = new Spreadsheet();
+    let expected = 0;
+    for (const col of ['A', 'B', 'C']) {
+      for (const row of [1, 2, 3]) {
+        const value = col.charCodeAt(0) + row;
+        sheet.set(`${col}${row}`, value);
+        expected += value;
+      }
+    }
+    sheet.set('E1', '=SUM(A1:C3)');
+    expect(sheet.get('E1')).toBe(expected);
+  });
+
+  it('covers exactly the cells inside the block', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', 1);
+    sheet.set('A2', 1);
+    sheet.set('B2', 1);
+    sheet.set('C1', 100); // outside
+    sheet.set('A3', 100); // outside
+    sheet.set('D1', '=SUM(A1:B2)');
+    expect(sheet.get('D1')).toBe(4);
+  });
+
+  it('accepts corners given in any order', () => {
+    const sheet = numericSheet();
+    sheet.set('B1', '=SUM(A5:A1)');
+    expect(sheet.get('B1')).toBe(15);
+  });
+
+  it('treats a single-cell range as that cell', () => {
+    const sheet = numericSheet();
+    sheet.set('B1', '=SUM(A3:A3)');
+    expect(sheet.get('B1')).toBe(3);
+  });
+
+  it('ignores empty cells and text inside a range', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 'label');
+    sheet.set('A4', 20);
+    sheet.set('B1', '=SUM(A1:A5)');
+    expect(sheet.get('B1')).toBe(30);
+  });
+
+  it('rejects a range used as a plain value', () => {
+    const sheet = numericSheet();
+    sheet.set('B1', '=A1:A5');
+    sheet.set('B2', '=A1:A5+1');
+    expect(sheet.get('B1')).toBe('#VALUE!');
+    expect(sheet.get('B2')).toBe('#VALUE!');
+  });
+
+  it('propagates an error from inside a range', () => {
+    const sheet = numericSheet();
+    sheet.set('A3', '=1/0');
+    sheet.set('B1', '=SUM(A1:A5)');
+    expect(sheet.get('B1')).toBe('#DIV/0!');
+  });
+
+  it('rejects an absurdly large range', () => {
+    const sheet = new Spreadsheet();
+    expect(() => sheet.set('B1', '=SUM(A1:ZZZ1048576)')).toThrow(/exceeds the limit/);
+  });
+});
+
+describe('SUM', () => {
