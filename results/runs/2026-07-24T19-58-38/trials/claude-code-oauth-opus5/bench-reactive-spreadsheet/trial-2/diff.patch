new file mode 100644
index 0000000..b25fca7
--- /dev/null
+++ b/src/parser.ts
@@ -0,0 +1,293 @@
+import type { BinaryOperator, Node } from './ast.js';
+import { FormulaSyntaxError, InvalidReferenceError } from './errors.js';
+import { formatRef, makeRange, parseRef } from './reference.js';
+import { tokenize, type Token } from './tokenizer.js';
+
+const COMPARISON_OPERATORS = new Set<string>(['=', '<>', '<', '<=', '>', '>=']);
+
+/**
+ * Cap on syntactic nesting (parentheses, unary signs, call arguments) while
+ * parsing. Each level costs several parser frames, so this stays low; no real
+ * formula nests anywhere near this deep.
+ */
+const MAX_NESTING_DEPTH = 256;
+
+/**
+ * Cap on the depth of the resulting tree. Long operator chains such as
+ * `=1+1+1+...` parse iteratively but build a left-deep tree, so this is what
+ * bounds recursion in {@link walk} and the evaluator. Without it the stack
+ * limit decides, which varies with how much stack the caller already used —
+ * making the same formula succeed or fail depending on context.
+ */
+const MAX_TREE_DEPTH = 1024;
+
+/** True when text looks like a cell reference such as `A1`. */
+function isCellReference(text: string): boolean {
+  if (!/^[A-Za-z]+[0-9]+$/.test(text)) return false;
+  try {
+    parseRef(text);
+    return true;
+  } catch (error) {
+    if (error instanceof InvalidReferenceError) return false;
+    throw error;
+  }
+}
+
+/**
+ * Recursive-descent parser for formula bodies.
+ *
+ * Precedence, loosest to tightest:
+ * comparison → addition/subtraction → multiplication/division → unary sign →
+ * primary (literals, references, ranges, function calls, parentheses).
+ */
+class Parser {
+  private readonly tokens: Token[];
+  private index = 0;
+  private depth = 0;
+
+  constructor(private readonly source: string) {
+    this.tokens = tokenize(source);
+  }
+
+  parse(): Node {
+    if (this.peek().type === 'eof') {
+      throw new FormulaSyntaxError('Formula is empty');
+    }
+    const node = this.parseComparison();
+    const token = this.peek();
+    if (token.type !== 'eof') {
+      throw new FormulaSyntaxError(
+        `Unexpected ${describe(token)} at position ${token.pos} in "${this.source}"`,
+      );
+    }
+    return node;
+  }
+
+  private peek(offset = 0): Token {
+    return this.tokens[Math.min(this.index + offset, this.tokens.length - 1)];
+  }
+
+  private next(): Token {
+    return this.tokens[this.index++];
+  }
+
+  private expect(type: Token['type'], what: string): Token {
+    const token = this.peek();
+    if (token.type !== type) {
+      throw new FormulaSyntaxError(
+        `Expected ${what} but found ${describe(token)} at position ${token.pos}`,
+      );
+    }
+    return this.next();
+  }
+
+  /**
+   * Enters a nested expression, keeping deeply nested formulas from
+   * overflowing the call stack with an opaque `RangeError`.
+   */
+  private enter(): void {
+    if (++this.depth > MAX_NESTING_DEPTH) {
+      throw new FormulaSyntaxError(`Formula nests more than ${MAX_NESTING_DEPTH} levels deep`);
+    }
+  }
+
+  private parseComparison(): Node {
+    this.enter();
+    try {
+      return this.parseComparisonInner();
+    } finally {
+      this.depth--;
+    }
+  }
+
+  private parseComparisonInner(): Node {
+    let left = this.parseAdditive();
+    while (this.peek().type === 'operator' && COMPARISON_OPERATORS.has(this.peek().value)) {
+      const operator = this.next().value as BinaryOperator;
+      const right = this.parseAdditive();
+      left = { type: 'binary', operator, left, right };
+    }
+    return left;
+  }
+
+  private parseAdditive(): Node {
+    let left = this.parseMultiplicative();
+    while (this.peek().type === 'operator' && (this.peek().value === '+' || this.peek().value === '-')) {
+      const operator = this.next().value as BinaryOperator;
+      const right = this.parseMultiplicative();
+      left = { type: 'binary', operator, left, right };
+    }
+    return left;
+  }
+
+  private parseMultiplicative(): Node {
+    let left = this.parseUnary();
+    while (this.peek().type === 'operator' && (this.peek().value === '*' || this.peek().value === '/')) {
+      const operator = this.next().value as BinaryOperator;
+      const right = this.parseUnary();
+      left = { type: 'binary', operator, left, right };
+    }
+    return left;
+  }
+
+  private parseUnary(): Node {
+    const token = this.peek();
+    if (token.type === 'operator' && (token.value === '-' || token.value === '+')) {
+      this.next();
+      this.enter();
+      try {
+        const operand = this.parseUnary();
+        return { type: 'unary', operator: token.value as '-' | '+', operand };
+      } finally {
+        this.depth--;
+      }
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): Node {
+    const token = this.next();
+
+    switch (token.type) {
+      case 'number': {
+        const value = Number(token.value);
+        if (!Number.isFinite(value)) {
+          throw new FormulaSyntaxError(`Invalid number "${token.value}" at position ${token.pos}`);
+        }
+        return { type: 'number', value };
+      }
+
+      case 'string':
+        return { type: 'string', value: token.value };
+
+      case 'lparen': {
+        const inner = this.parseComparison();
+        this.expect('rparen', '")"');
+        return inner;
+      }
+
+      case 'identifier':
+        return this.parseIdentifier(token);
+
+      default:
+        throw new FormulaSyntaxError(
+          `Unexpected ${describe(token)} at position ${token.pos} in "${this.source}"`,
+        );
+    }
+  }
+
+  /** An identifier is a function call, a boolean literal, a range, or a cell reference. */
+  private parseIdentifier(token: Token): Node {
+    const upper = token.value.toUpperCase();
+
+    if (this.peek().type === 'lparen') {
+      this.next();
+      const args: Node[] = [];
+      if (this.peek().type !== 'rparen') {
+        args.push(this.parseComparison());
+        while (this.peek().type === 'comma') {
+          this.next();
+          args.push(this.parseComparison());
+        }
+      }
+      this.expect('rparen', `")" to close ${upper}(`);
+      return { type: 'call', name: upper, args };
+    }
+
+    if (upper === 'TRUE' || upper === 'FALSE') {
+      return { type: 'boolean', value: upper === 'TRUE' };
+    }
+
+    if (!isCellReference(token.value)) {
+      throw new FormulaSyntaxError(
+        `Unknown identifier "${token.value}" at position ${token.pos}; ` +
+          'expected a cell reference or function call',
+      );
+    }
+
+    const start = parseRef(token.value);
+
+    // A colon turns two references into a range: A1:B3
+    if (this.peek().type === 'colon') {
+      this.next();
+      const endToken = this.peek();
+      if (endToken.type !== 'identifier' || !isCellReference(endToken.value)) {
+        throw new FormulaSyntaxError(
+          `Expected a cell reference after ":" at position ${endToken.pos}`,
+        );
+      }
+      this.next();
+      return { type: 'range', range: makeRange(start, parseRef(endToken.value)) };
+    }
+
+    return { type: 'reference', ref: start, key: formatRef(start) };
+  }
+}
+
+function describe(token: Token): string {
+  if (token.type === 'eof') return 'end of formula';
+  return `"${token.value}"`;
+}
+
+/**
+ * Parses a formula body — the text *after* the leading `=` — into an AST.
+ *
+ * @throws {FormulaSyntaxError} if the text is not a valid formula.
+ */
+export function parseFormula(body: string): Node {
+  const node = new Parser(body).parse();
+  assertWithinDepthLimit(node);
+  return node;
+}
+
+/**
+ * Rejects trees too deep to walk recursively. Measured with an explicit stack
+ * so that checking the limit cannot itself overflow.
+ */
+function assertWithinDepthLimit(root: Node): void {
+  const stack: Array<{ node: Node; depth: number }> = [{ node: root, depth: 1 }];
+
+  while (stack.length > 0) {
+    const { node, depth } = stack.pop()!;
+    if (depth > MAX_TREE_DEPTH) {
+      throw new FormulaSyntaxError(
+        `Formula is too complex: expression tree exceeds ${MAX_TREE_DEPTH} levels`,
+      );
+    }
+    switch (node.type) {
+      case 'unary':
+        stack.push({ node: node.operand, depth: depth + 1 });
+        break;
+      case 'binary':
+        stack.push({ node: node.left, depth: depth + 1 });
+        stack.push({ node: node.right, depth: depth + 1 });
+        break;
+      case 'call':
+        for (const arg of node.args) stack.push({ node: arg, depth: depth + 1 });
+        break;
+      default:
+        break;
+    }
+  }
+}
+
+/**
+ * Walks every node of an AST, calling `visitor` on each one.
+ */
+export function walk(node: Node, visitor: (node: Node) => void): void {
+  visitor(node);
+  switch (node.type) {
+    case 'unary':
+      walk(node.operand, visitor);
+      break;
+    case 'binary':
+      walk(node.left, visitor);
+      walk(node.right, visitor);
+      break;
+    case 'call':
+      for (const arg of node.args) walk(arg, visitor);
+      break;
+    default:
+      break;
+  }
+}
