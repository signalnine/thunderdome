--- /dev/null
+++ b/src/functions.ts
@@ -0,0 +1,100 @@
+import { ErrorCode, FormulaError, isFormulaError } from './errors.js';
+import { toNumber, type EvalValue } from './values.js';
+
+/** A block of cell values produced by a range argument such as `A1:A5`. */
+export interface RangeValue {
+  readonly kind: 'range';
+  readonly values: EvalValue[];
+}
+
+/** Anything that can be passed to a function: a single value or a range. */
+export type ArgValue = EvalValue | RangeValue;
+
+export function isRangeValue(value: ArgValue): value is RangeValue {
+  return typeof value === 'object' && value !== null && (value as RangeValue).kind === 'range';
+}
+
+/**
+ * Gathers the numbers an aggregate function should operate on.
+ *
+ * Values coming from a *range* are filtered: text, booleans and empty cells
+ * are skipped, matching how `SUM(A1:A5)` ignores a stray label. Values passed
+ * *directly* (`SUM(1, TRUE, "3")`) are coerced, because the caller clearly
+ * meant them to participate. Any error value short-circuits the whole result.
+ */
+function collectNumbers(args: ArgValue[]): number[] | FormulaError {
+  const numbers: number[] = [];
+
+  for (const arg of args) {
+    if (isRangeValue(arg)) {
+      for (const value of arg.values) {
+        if (isFormulaError(value)) return value;
+        if (typeof value === 'number') numbers.push(value);
+      }
+      continue;
+    }
+    if (isFormulaError(arg)) return arg;
+    if (arg === null) continue;
+    const coerced = toNumber(arg);
+    if (isFormulaError(coerced)) return coerced;
+    numbers.push(coerced);
+  }
+
+  return numbers;
+}
+
+/** Signature shared by every eagerly-evaluated built-in. */
+export interface BuiltinFunction {
+  readonly name: string;
+  readonly minArgs: number;
+  readonly maxArgs: number;
+  apply(args: ArgValue[]): EvalValue;
+}
+
+function aggregate(
+  name: string,
+  reduce: (numbers: number[]) => EvalValue,
+): BuiltinFunction {
+  return {
+    name,
+    minArgs: 1,
+    maxArgs: Infinity,
+    apply(args) {
+      const numbers = collectNumbers(args);
+      if (isFormulaError(numbers)) return numbers;
+      return reduce(numbers);
+    },
+  };
+}
+
+const SUM = aggregate('SUM', (numbers) => numbers.reduce((total, n) => total + n, 0));
+
+const AVERAGE = aggregate('AVERAGE', (numbers) => {
+  if (numbers.length === 0) {
+    return new FormulaError(ErrorCode.DIV0, 'AVERAGE received no numeric values');
+  }
+  return numbers.reduce((total, n) => total + n, 0) / numbers.length;
+});
+
+// MIN/MAX over nothing is 0 in Excel rather than an error. These fold rather
+// than spreading into Math.min/max, which overflows the stack on big ranges.
+const MIN = aggregate('MIN', (numbers) =>
+  numbers.length === 0 ? 0 : numbers.reduce((best, n) => (n < best ? n : best)),
+);
+const MAX = aggregate('MAX', (numbers) =>
+  numbers.length === 0 ? 0 : numbers.reduce((best, n) => (n > best ? n : best)),
+);
+const COUNT = aggregate('COUNT', (numbers) => numbers.length);
+
+/**
+ * Eagerly-evaluated built-in functions, keyed by upper-case name.
+ *
+ * `IF` is deliberately absent: its branches must stay unevaluated until the
+ * condition is known, so the evaluator implements it directly.
+ */
+export const BUILTIN_FUNCTIONS = new Map<string, BuiltinFunction>(
+  [SUM, AVERAGE, MIN, MAX, COUNT].map((fn) => [fn.name, fn]),
+);
+
+/** Names of every function the engine understands, including `IF`. */
+export const FUNCTION_NAMES: readonly string[] = [...BUILTIN_FUNCTIONS.keys(), 'IF'];
