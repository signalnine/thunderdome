+    expect(compare('=TRUE>FALSE')).toBe(true);
+  });
+
+  it('orders values of different types as number < text < boolean', () => {
+    expect(compare('=1<"a"')).toBe(true);
+    expect(compare('="a"<TRUE')).toBe(true);
+    expect(compare('=1="1"')).toBe(false);
+  });
+
+  it('compares an empty cell as the neutral value of the other side', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('B1', '=A1=0');
+    sheet.set('B2', '=A1=""');
+    sheet.set('B3', '=A1>-1');
+    expect(sheet.get('B1')).toBe(true);
+    expect(sheet.get('B2')).toBe(true);
+    expect(sheet.get('B3')).toBe(true);
+  });
+
+  it('compares computed cell values', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('B1', '=A1<A2');
+    sheet.set('B2', '=A1+10=A2');
+    expect(sheet.get('B1')).toBe(true);
+    expect(sheet.get('B2')).toBe(true);
+  });
+
+  it('binds looser than arithmetic', () => {
+    expect(compare('=1+1=2')).toBe(true);
+    expect(compare('=2*3>5')).toBe(true);
+  });
+});
+
+describe('string literals', () => {
+  it('reads and concatenates nothing but stores text', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '="hello"');
+    expect(sheet.get('A1')).toBe('hello');
+  });
+
+  it('supports escaped double quotes', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '="say ""hi"""');
+    expect(sheet.get('A1')).toBe('say "hi"');
+  });
+
+  it('preserves an empty string literal', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=""');
+    expect(sheet.get('A1')).toBe('');
+  });
+
+  it('keeps TRUE/FALSE as booleans, not text', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=TRUE');
+    sheet.set('A2', '=false');
+    expect(sheet.get('A1')).toBe(true);
+    expect(sheet.get('A2')).toBe(false);
+  });
+});
