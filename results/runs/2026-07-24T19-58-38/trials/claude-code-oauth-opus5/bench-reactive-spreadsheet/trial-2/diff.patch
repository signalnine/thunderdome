+/**
+ * A reactive spreadsheet engine.
+ *
+ * ```ts
+ * import { Spreadsheet } from './index.js';
+ *
+ * const sheet = new Spreadsheet();
+ * sheet.set('A1', 10);
+ * sheet.set('A2', 20);
+ * sheet.set('A3', '=SUM(A1:A2)');
+ * sheet.get('A3'); // 30
+ * ```
+ */
+
+export { Spreadsheet, type CellInput } from './spreadsheet.js';
+
+export {
+  CircularReferenceError,
+  ErrorCode,
+  FormulaError,
+  FormulaSyntaxError,
+  InvalidReferenceError,
+  SpreadsheetError,
+  isFormulaError,
+  type ErrorCodeValue,
+} from './errors.js';
+
+export { type CellValue, type EvalValue } from './values.js';
+
+export { FUNCTION_NAMES } from './functions.js';
+
+export {
+  columnToIndex,
+  indexToColumn,
+  normalizeRef,
+  parseRef,
+  type CellRef,
+  type RangeRef,
+} from './reference.js';
+
+export { Spreadsheet as default } from './spreadsheet.js';
