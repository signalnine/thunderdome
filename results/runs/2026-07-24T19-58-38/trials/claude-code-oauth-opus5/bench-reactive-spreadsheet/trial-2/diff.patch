 a diamond exactly once', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 4);\n    sheet.set('B1', '=A1*2');\n    sheet.set('B2', '=A1*3');\n    sheet.set('C1', '=B1+B2');\n    expect(sheet.get('C1')).toBe(20);\n\n    sheet.set('A1', 10);\n    expect(sheet.get('B1')).toBe(20);\n    expect(sheet.get('B2')).toBe(30);\n    expect(sheet.get('C1')).toBe(50);\n  });\n\n  it('recomputes when a referenced cell is filled in later', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B1', '=A1*2');\n    expect(sheet.get('B1')).toBe(0);\n\n    sheet.set('A1', 21);\n    expect(sheet.get('B1')).toBe(42);\n  });\n\n  it('recomputes ranges when any member changes', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('A2', 2);\n    sheet.set('B1', '=SUM(A1:A3)');\n    expect(sheet.get('B1')).toBe(3);\n\n    sheet.set('A3', 10);\n    expect(sheet.get('B1')).toBe(13);\n  });\n\n  it('drops stale dependencies when a formula is replaced', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('A2', 100);\n    sheet.set('B1', '=A1');\n    expect(sheet.get('B1')).toBe(1);\n\n    sheet.set('B1', '=A2');\n    expect(sheet.get('B1')).toBe(100);\n\n    // A1 is no longer an input, so changing it must not affect B1.\n    sheet.set('A1', 999);\n    expect(sheet.get('B1')).toBe(100);\n    expect(sheet.getDependents('A1')).toEqual([]);\n  });\n\n  it('recomputes when a formula becomes a literal', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 5);\n    sheet.set('B1', '=A1*2');\n    sheet.set('B1', 7);\n    expect(sheet.get('B1')).toBe(7);\n\n    sheet.set('A1', 100);\n    expect(sheet.get('B1')).toBe(7);\n  });\n\n  it('propagates a newly introduced error', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('B1', '=100/A1');\n    expect(sheet.get('B1')).toBe(10);\n\n    sheet.set('A1', 0);\n    expect(sheet.get('B1')).toBe('#DIV/0!');\n\n    sheet.set('A1', 4);\n    expect(sheet.get('B1')).toBe(25);\n  });\n\n  it('tracks dependencies through a wide fan-out', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 3);\n    for (let i = 1; i <= 100; i++) {\n      sheet.set(`B${i}`, `=A1*${i}`);\n    }\n    sheet.set('A1', 5);\n    expect(sheet.get('B1')).toBe(5);\n    expect(sheet.get('B50')).toBe(250);\n    expect(sheet.get('B100')).toBe(500);\n  });\n});\n\ndescribe('circular references', () => {\n  it('detects a self reference', () => {\n    const sheet = new Spreadsheet();\n    expect(() => sheet.set('A1', '=A1')).toThrow(CircularReferenceError);\n    expect(() => sheet.set('A1', '=A1+1')).toThrow(CircularReferenceError);\n  });\n\n  it('detects a two-cell cycle', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=B1');\n    expect(() => sheet.set('B1', '=A1')).toThrow(CircularReferenceError);\n  });\n\n  it('detects an indirect cycle through many cells', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=A2');\n    sheet.set('A2', '=A3');\n    sheet.set('A3', '=A4');\n    sheet.set('A4', '=A5');\n    expect(() => sheet.set('A5', '=A1')).toThrow(CircularReferenceError);\n  });\n\n  it('detects a cycle created through a range', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B1', '=SUM(A1:A5)');\n    expect(() => sheet.set('A3', '=B1*2')).toThrow(CircularReferenceError);\n  });\n\n  it('detects a cycle where the formula reaches itself through a range', () => {\n    const sheet = new Spreadsheet();\n    expect(() => sheet.set('A3', '=SUM(A1:A5)')).toThrow(CircularReferenceError);\n  });\n\n  it('reports the offending chain', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=B1');\n    sheet.set('B1', '=C1');\n    try {\n      sheet.set('C1', '=A1');\n      expect.unreachable('expected a CircularReferenceError');\n    } catch (error) {\n      expect(error).toBeInstanceOf(CircularReferenceError);\n      const { cycle, message } = error as CircularReferenceError;\n      expect(cycle[0]).toBe('C1');\n      expect(cycle[cycle.length - 1]).toBe('C1');\n      expect(cycle).toContain('A1');\n      expect(cycle).toContain('B1');\n      expect(message).toContain('Circular reference');\n    }\n  });\n\n  it('leaves the sheet untouched when a cycle is rejected', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1+1');\n    expect(() => sheet.set('A1', '=B1')).toThrow(CircularReferenceError);\n\n    // The rejected write must be a complete no-op.\n    expect(sheet.get('A1')).toBe(1);\n    expect(sheet.get('B1')).toBe(2);\n    expect(sheet.getRaw('A1')).toBe(1);\n    expect(sheet.getDependents('B1')).toEqual([]);\n\n    sheet.set('A1', 5);\n    expect(sheet.get('B1')).toBe(6);\n  });\n\n  it('allows a diamond, which is not a cycle', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1');\n    sheet.set('B2', '=A1');\n    expect(() => sheet.set('C1', '=B1+B2')).not.toThrow();\n    expect(sheet.get('C1')).toBe(2);\n  });\n\n  it('allows reusing a reference that was previously part of a rejected cycle', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=B1');\n    expect(() => sheet.set('B1', '=A1')).toThrow(CircularReferenceError);\n\n    sheet.set('A1', 10);\n    expect(() => sheet.set('B1', '=A1')).not.toThrow();\n    expect(sheet.get('B1')).toBe(10);\n  });\n});\n\ndescribe('scale', () => {\n  // These also guard the cost of `set`: cycle detection searches the cells\n  // that depend on the target rather than the whole upstream cone, which\n  // keeps building a deep chain linear instead of quadratic.\n  it('builds and propagates through a deep chain', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    for (let i = 2; i <= 5000; i++) {\n      sheet.set(`A${i}`, `=A${i - 1}+1`);\n    }\n    expect(sheet.get('A5000')).toBe(5000);\n\n    sheet.set('A1', 1001);\n    expect(shee