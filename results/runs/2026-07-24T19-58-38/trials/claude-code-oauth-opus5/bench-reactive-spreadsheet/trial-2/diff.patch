= 0;\n255\t      if (cell) {\n256\t        for (const precedent of cell.precedents) {\n257\t          if (affected.has(precedent)) count++;\n258\t        }\n259\t      }\n260\t      pending.set(key, count);\n261\t      if (count === 0) ready.push(key);\n262\t    }\n263\t\n264\t    while (ready.length > 0) {\n265\t      const key = ready.pop()!;\n266\t      this.evaluateCell(key);\n267\t      for (const dependent of this.dependents.get(key) ?? EMPTY_SET) {\n268\t        const remaining = pending.get(dependent);\n269\t        if (remaining === undefined) continue;\n270\t        pending.set(dependent, remaining - 1);\n271\t        if (remaining - 1 === 0) ready.push(dependent);\n272\t      }\n273\t    }\n274\t  }\n275\t\n276\t  /** Recomputes a single cell from its stored content. */\n277\t  private evaluateCell(key: string): void {\n278\t    const cell = this.cells.get(key);\n279\t    if (!cell) return;\n280\t    cell.value = cell.formula ? evaluate(cell.formula, this.resolve) : (cell.input as CellValue);\n281\t  }\n282\t}\n283\t\n284\tconst EMPTY_SET: ReadonlySet<string> = new Set<string>();\n285\t\n286\t/** Gathers every cell a formula reads, expanding ranges into their members. */\n287\tfunction collectPrecedents(formula: Node): ReadonlySet<string> {\n288\t  const precedents = new Set<string>();\n289\t  walk(formula, (node) => {\n290\t    if (node.type === 'reference') {\n291\t      precedents.add(node.key);\n292\t    } else if (node.type === 'range') {\n293\t      for (const key of expandRange(node.range)) precedents.add(key);\n294\t    }\n295\t  });\n296\t  return precedents;\n297\t}\n298\t\n299\tfunction validateInput(key: string, value: CellInput): void {\n300\t  const type = typeof value;\n301\t  if (type !== 'string' && type !== 'number' && type !== 'boolean') {\n302\t    throw new SpreadsheetError(\n303\t      `Cannot store ${value === null ? 'null' : type} in ${key}; ` +\n304\t        'expected a string, number, or boolean',\n305\t    );\n306\t  }\n307\t  i