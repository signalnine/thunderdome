+
+  it('allows reusing a reference that was previously part of a rejected cycle', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=B1');
+    expect(() => sheet.set('B1', '=A1')).toThrow(CircularReferenceError);
+
+    sheet.set('A1', 10);
+    expect(() => sheet.set('B1', '=A1')).not.toThrow();
+    expect(sheet.get('B1')).toBe(10);
+  });
+});
+
+describe('scale', () => {
+  // These also guard the cost of `set`: cycle detection searches the cells
+  // that depend on the target rather than the whole upstream cone, which
+  // keeps building a deep chain linear instead of quadratic.
+  it('builds and propagates through a deep chain', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    for (let i = 2; i <= 5000; i++) {
+      sheet.set(`A${i}`, `=A${i - 1}+1`);
+    }
+    expect(sheet.get('A5000')).toBe(5000);
+
+    sheet.set('A1', 1001);
+    expect(sheet.get('A5000')).toBe(6000);
+  });
+
+  it('handles a cell with thousands of dependents', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 2);
+    for (let i = 1; i <= 5000; i++) {
+      sheet.set(`B${i}`, '=A1*3');
+    }
+    sheet.set('A1', 4);
+    expect(sheet.get('B1')).toBe(12);
+    expect(sheet.get('B5000')).toBe(12);
+  });
+
+  it('still detects a cycle closed at the end of a deep chain', () => {
+    // Built bottom-up, so the cycle closes at the far end of the chain from
+    // the cell being written — the case a one-directional search misses.
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=A2');
+    for (let i = 2; i <= 1000; i++) {
+      sheet.set(`A${i}`, `=A${i + 1}`);
+    }
+    expect(() => sheet.set('A1001', '=A1')).toThrow(CircularReferenceError);
+  });
+});
+
+describe('getDisplay', () => {
+  it('renders numbers without trailing noise', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=0.1+0.2');
+    sheet.set('A2', 30);
+    sheet.set('A3', 3.5);
+    expect(sheet.getDisplay('A1')).toBe('0.3');
+    expect(sheet.getDisplay('A2')).toBe('30');
+    expect(sheet.getDisplay('A3')).toBe('3.5');
+  });
+
+  it('renders text as-is', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 'hello');
+    expect(sheet.getDisplay('A1')).toBe('hello');
+  });
+
+  it('renders booleans in upper case, as a spreadsheet does', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', true);
+    sheet.set('A2', false);
+    expect(sheet.getDisplay('A1')).toBe('TRUE');
+    expect(sheet.getDisplay('A2')).toBe('FALSE');
+  });
+
+  it('renders empty cells as an empty string', () => {
+    const sheet = new Spreadsheet();
+    expect(sheet.getDisplay('A1')).toBe('');
+  });
+
+  it('renders errors as their code', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=1/0');
+    expect(sheet.getDisplay('A1')).toBe('#DIV/0!');
+  });
+
+  it('renders negative zero as zero', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=-0');
+    expect(sheet.getDisplay('A1')).toBe('0');
+  });
+
+  it('agrees with get() about negative zero', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=0*-1');
+    expect(sheet.getDisplay('A1')).toBe('0');
+    expect(Object.is(sheet.get('A1'), -0)).toBe(false);
+    expect(sheet.get('A1')).toBe(0);
+  });
+});
+
+describe('getCells', () => {
+  it('returns every non-empty cell with its computed value', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('A3', '=A1+A2');
+    sheet.set('B1', 'label');
+
+    const cells = sheet.getCells();
+    expect(cells.size).toBe(4);
+    expect(cells.get('A1')).toBe(10);
+    expect(cells.get('A2')).toBe(20);
+    expect(cells.get('A3')).toBe(30);
+    expect(cells.get('B1')).toBe('label');
+  });
+
+  it('omits empty cells and is empty for a new sheet', () => {
+    const sheet = new Spreadsheet();
+    expect(sheet.getCells().size).toBe(0);
+
+    sheet.set('A1', 1);
+    sheet.set('A1', '');
+    expect(sheet.getCells().size).toBe(0);
+  });
+
+  it('reads top-to-bottom then left-to-right', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('B2', 1);
+    sheet.set('A1', 2);
+    sheet.set('C1', 3);
+    sheet.set('A2', 4);
+    expect([...sheet.getCells().keys()]).toEqual(['A1', 'C1', 'A2', 'B2']);
+  });
+
+  it('returns a snapshot that does not track later edits', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    const cells = sheet.getCells();
+    sheet.set('A1', 2);
+    expect(cells.get('A1')).toBe(1);
+  });
+});
+
+describe('clearing cells', () => {
+  it('clears with an empty string and recomputes dependents', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('B1', '=A1+5');
+    expect(sheet.get('B1')).toBe(15);
+
+    sheet.set('A1', '');
+    expect(sheet.get('A1')).toBeNull();
+    expect(sheet.get('B1')).toBe(5);
+  });
+
+  it('clears explicitly', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('B1', '=A1*2');
+    sheet.clear('A1');
+    expect(sheet.get('A1')).toBeNull();
+    expect(sheet.get('B1')).toBe(0);
+  });
+
+  it('releases a cleared formula’s dependencies', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1');
+    sheet.clear('B1');
+    expect(sheet.getDependents('A1')).toEqual([]);
+    expect(sheet.get('B1')).toBeNull();
+  });
+
+  it('ignores clearing an already empty cell', () => {
+    const sheet = new Spreadsheet();
+    expect(() => sheet.clear('A1')).not.toThrow();
+    expect(sheet.get('A1')).toBeNull();
+  });
+
+  it('empties the whole sheet', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1');
+    sheet.clearAll();
+    expect(sheet.getCells().size).toBe(0);
+    expect(sheet.get('B1')).toBeNull();
+  });
+});
+
+describe('inspection helpers', () => {
+  it('returns the original input including formula text', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 5);
+    sheet.set('A2', '=A1*2');
+    expect(sheet.getRaw('A1')).toBe(5);
+    expect(sheet.getRaw('A2')).toBe('=A1*2');
+    expect(sheet.getRaw('A3')).toBeNull();
+  });
+
+  it('reports which cells hold formulas and errors', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 5);
+    sheet.set('A2', '=A1*2');
+    sheet.set('A3', '=1/0');
+    expect(sheet.isFormula('A1')).toBe(false);
+    expect(sheet.isFormula('A2')).toBe(true);
+    expect(sheet.hasError('A2')).toBe(false);
+    expect(sheet.hasError('A3')).toBe(true);
+  });
+
+  it('lists direct precedents and dependents', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('C1', '=A1+B1');
+    sheet.set('C2', '=A1*2');
+    expect(sheet.getPrecedents('C1')).toEqual(['A1', 'B1']);
+    expect(sheet.getDependents('A1')).toEqual(['C1', 'C2']);
+    expect(sheet.getPrecedents('A1')).toEqual([]);
+  });
+});
+
+describe('invalid formulas', () => {
+  const sheet = new Spreadsheet();
+  const bad = ['=', '=1+', '=*2', '=(1+2', '=1+2)', '=A1 A2', '="unterminated', '=1..2', '=@A1'];
+
+  it.each(bad)('rejects %s', (formula) => {
+    expect(() => sheet.set('Z1', formula)).toThrow(FormulaSyntaxError);
+  });
+
+  it('rejects an unknown bare identifier', () => {
+    expect(() => sheet.set('Z1', '=FOO')).toThrow(FormulaSyntaxError);
+  });
+
+  it('reports an unknown function as #NAME?', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=NOPE(1)');
+    expect(s.get('A1')).toBe('#NAME?');
+  });
+
+  it('leaves the cell untouched when a formula fails to parse', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 7);
+    expect(() => s.set('A1', '=1+')).toThrow(FormulaSyntaxError);
+    expect(s.get('A1')).toBe(7);
+  });
+});
