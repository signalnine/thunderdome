--- /dev/null
+++ b/src/reference.ts
@@ -0,0 +1,153 @@
+import { InvalidReferenceError } from './errors.js';
+
+/**
+ * A parsed cell coordinate.
+ *
+ * `col` is a 0-based column index (A = 0, B = 1, ... Z = 25, AA = 26).
+ * `row` is the 1-based row number as written by the user (A1 has row 1).
+ */
+export interface CellRef {
+  readonly col: number;
+  readonly row: number;
+}
+
+/** A normalised rectangular block of cells. */
+export interface RangeRef {
+  readonly start: CellRef;
+  readonly end: CellRef;
+}
+
+const CELL_PATTERN = /^([A-Za-z]+)([0-9]+)$/;
+
+/**
+ * Upper bound on how many cells a single range may cover. This keeps a typo
+ * such as `=SUM(A1:ZZ999999)` from exhausting memory while staying far above
+ * any realistic sheet.
+ */
+export const MAX_RANGE_CELLS = 1_000_000;
+
+/** Largest supported column index, `ZZZ` (18277 as a 0-based index). */
+export const MAX_COLUMN = 18277;
+
+/** Largest supported row number. */
+export const MAX_ROW = 1_048_576;
+
+/**
+ * Converts a column name to a 0-based index using bijective base-26
+ * (`A` = 0, `Z` = 25, `AA` = 26, `AB` = 27, ...).
+ */
+export function columnToIndex(name: string): number {
+  let index = 0;
+  for (let i = 0; i < name.length; i++) {
+    const digit = name.charCodeAt(i) - 64; // 'A' (65) -> 1
+    if (digit < 1 || digit > 26) {
+      throw new InvalidReferenceError(`Invalid column name: "${name}"`);
+    }
+    index = index * 26 + digit;
+  }
+  return index - 1;
+}
+
+/** Converts a 0-based column index back to its letters (0 -> `A`, 26 -> `AA`). */
+export function indexToColumn(index: number): string {
+  if (!Number.isInteger(index) || index < 0) {
+    throw new InvalidReferenceError(`Invalid column index: ${index}`);
+  }
+  let name = '';
+  let n = index + 1;
+  while (n > 0) {
+    const remainder = (n - 1) % 26;
+    name = String.fromCharCode(65 + remainder) + name;
+    n = Math.floor((n - remainder) / 26);
+  }
+  return name;
+}
+
+/**
+ * Parses a textual cell reference such as `A1` or `aa42` into coordinates.
+ * Reference names are case-insensitive.
+ *
+ * @throws {InvalidReferenceError} if the text is not a well-formed reference.
+ */
+export function parseRef(ref: string): CellRef {
+  if (typeof ref !== 'string') {
+    throw new InvalidReferenceError(`Invalid cell reference: ${String(ref)}`);
+  }
+  const match = CELL_PATTERN.exec(ref.trim());
+  if (!match) {
+    throw new InvalidReferenceError(`Invalid cell reference: "${ref}"`);
+  }
+  const col = columnToIndex(match[1].toUpperCase());
+  const row = Number(match[2]);
+  if (row < 1) {
+    throw new InvalidReferenceError(`Row numbers start at 1: "${ref}"`);
+  }
+  if (col > MAX_COLUMN) {
+    throw new InvalidReferenceError(`Column out of range (max ZZZ): "${ref}"`);
+  }
+  if (row > MAX_ROW) {
+    throw new InvalidReferenceError(`Row out of range (max ${MAX_ROW}): "${ref}"`);
+  }
+  return { col, row };
+}
+
+/** Renders coordinates back into canonical upper-case text, e.g. `A1`. */
+export function formatRef(ref: CellRef): string {
+  return `${indexToColumn(ref.col)}${ref.row}`;
+}
+
+/**
+ * Normalises a user-supplied reference to its canonical upper-case form.
+ * Used as the key under which every cell is stored.
+ */
+export function normalizeRef(ref: string): string {
+  return formatRef(parseRef(ref));
+}
+
+/**
+ * Builds a range from two corners. The corners may be given in any order:
+ * `C3:A1` and `A1:C3` describe the same block.
+ */
+export function makeRange(a: CellRef, b: CellRef): RangeRef {
+  return {
+    start: { col: Math.min(a.col, b.col), row: Math.min(a.row, b.row) },
+    end: { col: Math.max(a.col, b.col), row: Math.max(a.row, b.row) },
+  };
+}
+
+/** Number of cells a range covers. */
+export function rangeSize(range: RangeRef): number {
+  return (range.end.col - range.start.col + 1) * (range.end.row - range.start.row + 1);
+}
+
+/**
+ * Lists every cell key inside a range in row-major order.
+ *
+ * @throws {InvalidReferenceError} if the range exceeds {@link MAX_RANGE_CELLS}.
+ */
+export function expandRange(range: RangeRef): string[] {
+  const size = rangeSize(range);
+  if (size > MAX_RANGE_CELLS) {
+    throw new InvalidReferenceError(
+      `Range ${formatRef(range.start)}:${formatRef(range.end)} covers ${size} cells, ` +
+        `which exceeds the limit of ${MAX_RANGE_CELLS}`,
+    );
+  }
+  const keys: string[] = [];
+  for (let row = range.start.row; row <= range.end.row; row++) {
+    for (let col = range.start.col; col <= range.end.col; col++) {
+      keys.push(`${indexToColumn(col)}${row}`);
+    }
+  }
+  return keys;
+}
+
+/**
+ * Orders two cell keys the way a spreadsheet reads: top-to-bottom, then
+ * left-to-right within a row.
+ */
+export function compareRefs(a: string, b: string): number {
+  const refA = parseRef(a);
+  const refB = parseRef(b);
+  return refA.row - refB.row || refA.col - refB.col;
+}
