t(sheet.get('B1')).toBe(21);\n  });\n\n  it('is zero over an entirely empty range', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B1', '=SUM(A1:A5)');\n    expect(sheet.get('B1')).toBe(0);\n  });\n\n  it('nests inside other expressions', () => {\n    const sheet = numericSheet();\n    sheet.set('B1', '=SUM(A1:A5)*2+1');\n    expect(sheet.get('B1')).toBe(31);\n  });\n});\n\ndescribe('AVERAGE', () => {\n  it('averages a range', () => {\n    const sheet = numericSheet();\n    sheet.set('B1', '=AVERAGE(A1:A5)');\n    expect(sheet.get('B1')).toBe(3);\n  });\n\n  it('divides by the count of numeric cells only', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 'text');\n    sheet.set('A3', 20);\n    sheet.set('B1', '=AVERAGE(A1:A3)');\n    expect(sheet.get('B1')).toBe(15);\n  });\n\n  it('is #DIV/0! when nothing numeric is in range', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B1', '=AVERAGE(A1:A5)');\n    expect(sheet.get('B1')).toBe('#DIV/0!');\n  });\n});\n\ndescribe('MIN and MAX', () => {\n  it('finds the extremes of a range', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 7);\n    sheet.set('A2', -3);\n    sheet.set('A3', 12);\n    sheet.set('B1', '=MIN(A1:A3)');\n    sheet.set('B2', '=MAX(A1:A3)');\n    expect(sheet.get('B1')).toBe(-3);\n    expect(sheet.get('B2')).toBe(12);\n  });\n\n  it('skips non-numeric cells', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 'zzz');\n    sheet.set('A2', 5);\n    sheet.set('A3', 9);\n    sheet.set('B1', '=MIN(A1:A3)');\n    sheet.set('B2', '=MAX(A1:A3)');\n    expect(sheet.get('B1')).toBe(5);\n    expect(sheet.get('B2')).toBe(9);\n  });\n\n  it('is zero over an empty range', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B1', '=MIN(A1:A5)');\n    sheet.set('B2', '=MAX(A1:A5)');\n    expect(sheet.get('B1')).toBe(0);\n    expect(sheet.get('B2')).toBe(0);\n  });\n\n  it('folds over very large inputs without blowing the call stack', () => {\n    // Guards against implementing MIN/MAX as Math.min(...numbers), which\n    // throws once the argument count passes the engine's stack limit.\n    const values = Array.from({ length: 200_000 }, (_, i) => i + 1);\n    const range = { kind: 'range' as const, values };\n    expect(BUILTIN_FUNCTIONS.get('MIN')!.apply([range])).toBe(1);\n    expect(BUILTIN_FUNCTIONS.get('MAX')!.apply([range])).toBe(200_000);\n  });\n\n  it('handles a large range without blowing the call stack', () => {\n    const sheet = new Spreadsheet();\n    for (let row = 1; row <= 20000; row++) sheet.set(`A${row}`, row);\n    sheet.set('C1', '=MAX(A1:A20000)');\n    sheet.set('C2', '=MIN(A1:A20000)');\n    expect(sheet.get('C1')).toBe(20000);\n    expect(sheet.get('C2')).toBe(1);\n  });\n});\n\ndescribe('COUNT', () => {\n  it('counts only numeric cells', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('A2', 'text');\n    sheet.set('A3', 3);\n    sheet.set('A5', true);\n    sheet.set('B1', '=COUNT(A1:A5)');\n    expect(sheet.get('B1')).toBe(2);\n  });\n\n  it('is zero over an empty range', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B1', '=COUNT(A1:A5)');\n    expect(sheet.get('B1')).toBe(0);\n  });\n});\n\ndescribe('IF', () => {\n  let sheet: Spreadsheet;\n\n  beforeEach(() => {\n    sheet = new Spreadsheet();\n    sheet.set('A1', 50);\n  });\n\n  it('picks a branch from a comparison', () => {\n    sheet.set('B1', '=IF(A1>30, \"big\", \"small\")');\n    expect(sheet.get('B1')).toBe('big');\n\n    sheet.set('A1', 10);\n    expect(sheet.get('B1')).toBe('small');\n  });\n\n  it('returns numbers and expressions from its branches', () => {\n    sheet.set('B1', '=IF(A1>=50, A1*2, 0)');\n    expect(sheet.get('B1')).toBe(100);\n  });\n\n  it('accepts a boolean condition', () => {\n    sheet.set('A2', true);\n    sheet.set('B1', '=IF(A2, \"yes\", \"no\")');\n    expect(sheet.get('B1')).toBe('yes');\n  });\n\n  it('treats a non-zero number as true', () => {\n    sheet.set('B1', '=IF(1, \"yes\", \"no\")');\n    sheet.set('B2', '=IF(0, \"yes\", \"no\")');\n    expect(sheet.get('B1')).toBe('yes');\n    expect(sheet.get('B2')).toBe('no');\n  });\n\n  it('defaults the missing false branch to FALSE', () => {\n    sheet.set('B1', '=IF(A1<0, \"negative\")');\n    expect(sheet.get('B1')).toBe(false);\n  });\n\n  it('does not evaluate the branch it did not take', () => {\n    sheet.set('A1', 0);\n    sheet.set('B1', '=IF(A1=0, \"safe\", 1/A1)');\n    expect(sheet.get('B1')).toBe('safe');\n  });\n\n  it('nests', () => {\n    sheet.set('B1', '=IF(A1>=90, \"A\", IF(A1>=50, \"B\", \"C\"))');\n    expect(sheet.get('B1')).toBe('B');\n\n    sheet.set('A1', 95);\n    expect(sheet.get('B1')).toBe('A');\n\n    sheet.set('A1', 5);\n    expect(sheet.get('B1')).toBe('C');\n  });\n\n  it('rejects a text condition with #VALUE!', () => {\n    sheet.set('A2', 'text');\n    sheet.set('B1', '=IF(A2, 1, 2)');\n    expect(sheet.get('B1')).toBe('#VALUE!');\n  });\n\n  it('propagates an error from its condition', () => {\n    sheet.set('A2', '=1/0');\n    sheet.set('B1', '=IF(A2>1, 1, 2)');\n    expect(sheet.get('B1')).toBe('#DIV/0!');\n  });\n\n  it('combines with aggregate functions', () => {\n    sheet.set('A2', 10);\n    sheet.set('A3', 20);\n    sheet.set('B1', '=IF(SUM(A2:A3)>25, MAX(A2:A3), MIN(A2:A3))');\n    expect(sheet.get('B1')).toBe(20);\n  });\n\n  it('reports the wrong number of arguments', () => {\n    sheet.set('B1', '=IF(A1>1)');\n    expect(sheet.get('B1')).toBe('#VALUE!');\n  });\n});\n\ndescribe('comparison operators', () => {\n  const compare = (formula: string): unknown => {\n    const sheet = new Spreadsheet();\n    sheet.set('Z1', formula);\n    return sheet.get('Z1');\n  };\n\n  it('compares numbers', () => {\n    expect(compare('=1<2')).toBe(true);\n    expect(compare('=2<=2')).toBe(true);\n    expect(compare('=3>4')).toBe(false);\n    expect(compare('=4>=4')).toBe(true);\n    expect(compare('=5=5')).toBe(true);\n    expect(compare('=5<>5')).toBe(false);\n  });\n\n  it('compares text case-insensitively', () => {\n    expect(compare('=\"abc\"=\"ABC\"')).toBe(true);\n    expect(compare('=\"apple\"<\"banana\"')).toBe(true);\n    expect(compare('=\"a\"<>\"b\"')).toBe(true);\n  });\n\n  it('compares booleans', () => {\n    expect(compare('=TRUE=TRUE')).toBe(true);\n    expect(compare('=TRUE>FALSE')).toBe(true);\n  });\n\n  it('orders values of different types as number < text < boolean', () => {\n    expect(compare('=1<\"a\"')).toBe(true);\n    expect(compare('=\"a\"<TRUE')).toBe(true);\n    expect(compare('=1=\"1\"')).toBe(false);\n  });\n\n  it('compares an empty cell as the neutral value of the other side', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('B1', '=A1=0');\n    sheet.set('B2', '=A1=\"\"');\n    sheet.set('B3', '=A1>-1');\n    expect(sheet.get('B1')).toBe(true);\n    expect(sheet.get('B2')).toBe(true);\n    expect(sheet.get('B3')).toBe(true);\n  });\n\n  it('compares computed cell values', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 20);\n    sheet.set('B1', '=A1<A2');\n    sheet.set('B2', '=A1+10=A2');\n    expect(sheet.get('B1')).toBe(true);\n    expect(sheet.get('B2')).toBe(true);\n  });\n\n  it('binds looser than arithmetic', () => {\n    expect(compare('=1+1=2')).toBe(true);\n    expect(compare('=2*3>5')).toBe(true);\n  });\n});\n\ndescribe('string literals', () => {\n  it('reads and concatenates nothing but stores text', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=\"hello\"');\n    expect(sheet.get('A1')).toBe('hello');\n  });\n\n  it('supports escaped double quotes', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=\"say \"\"hi\"\"\"');\n    expect(sheet.get('A1')).toBe('say \"hi\"');\n  });\n\n  it('preserves an empty string literal', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=\"\"');\n    