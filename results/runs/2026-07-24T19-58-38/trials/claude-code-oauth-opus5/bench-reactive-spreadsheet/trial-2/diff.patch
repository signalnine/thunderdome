@@ -0,0 +1,142 @@
+import { FormulaSyntaxError } from './errors.js';
+
+export type TokenType =
+  | 'number'
+  | 'string'
+  | 'identifier'
+  | 'operator'
+  | 'lparen'
+  | 'rparen'
+  | 'comma'
+  | 'colon'
+  | 'eof';
+
+export interface Token {
+  readonly type: TokenType;
+  /** Raw text for identifiers/operators, or the decoded literal for numbers/strings. */
+  readonly value: string;
+  /** Offset of the token within the formula body, for error messages. */
+  readonly pos: number;
+}
+
+/** Multi-character operators must be tried before their single-character prefixes. */
+const OPERATORS = ['<>', '<=', '>=', '+', '-', '*', '/', '<', '>', '='];
+
+function isDigit(ch: string): boolean {
+  return ch >= '0' && ch <= '9';
+}
+
+function isLetter(ch: string): boolean {
+  return (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z');
+}
+
+/**
+ * Splits a formula body (the text after the leading `=`) into tokens.
+ *
+ * Cell references and function names both arrive as `identifier` tokens; the
+ * parser decides which is which from the surrounding syntax. Ranges are
+ * emitted as `identifier colon identifier` and assembled by the parser.
+ */
+export function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+
+  while (i < input.length) {
+    const ch = input[i];
+
+    // Whitespace is insignificant between tokens.
+    if (ch === ' ' || ch === '\t' || ch === '\n' || ch === '\r') {
+      i++;
+      continue;
+    }
+
+    // Numbers: 42, 3.14, .5, 1e-3
+    if (isDigit(ch) || (ch === '.' && isDigit(input[i + 1] ?? ''))) {
+      const start = i;
+      while (i < input.length && isDigit(input[i])) i++;
+      if (input[i] === '.') {
+        i++;
+        while (i < input.length && isDigit(input[i])) i++;
+      }
+      if (input[i] === 'e' || input[i] === 'E') {
+        // Only consume the exponent if it is actually well-formed, so that
+        // something like `1E` still tokenizes as a number followed by a name.
+        let j = i + 1;
+        if (input[j] === '+' || input[j] === '-') j++;
+        if (isDigit(input[j] ?? '')) {
+          j++;
+          while (j < input.length && isDigit(input[j])) j++;
+          i = j;
+        }
+      }
+      tokens.push({ type: 'number', value: input.slice(start, i), pos: start });
+      continue;
+    }
+
+    // Strings: "hello", with "" as an escaped double quote.
+    if (ch === '"') {
+      const start = i;
+      i++;
+      let text = '';
+      let closed = false;
+      while (i < input.length) {
+        if (input[i] === '"') {
+          if (input[i + 1] === '"') {
+            text += '"';
+            i += 2;
+            continue;
+          }
+          i++;
+          closed = true;
+          break;
+        }
+        text += input[i];
+        i++;
+      }
+      if (!closed) {
+        throw new FormulaSyntaxError(`Unterminated string literal at position ${start}`);
+      }
+      tokens.push({ type: 'string', value: text, pos: start });
+      continue;
+    }
+
+    // Identifiers: cell references (A1), function names (SUM), TRUE/FALSE.
+    if (isLetter(ch) || ch === '_') {
+      const start = i;
+      while (i < input.length && (isLetter(input[i]) || isDigit(input[i]) || input[i] === '_')) {
+        i++;
+      }
+      tokens.push({ type: 'identifier', value: input.slice(start, i), pos: start });
+      continue;
+    }
+
+    if (ch === '(') {
+      tokens.push({ type: 'lparen', value: ch, pos: i++ });
+      continue;
+    }
+    if (ch === ')') {
+      tokens.push({ type: 'rparen', value: ch, pos: i++ });
+      continue;
+    }
+    if (ch === ',') {
+      tokens.push({ type: 'comma', value: ch, pos: i++ });
+      continue;
+    }
+    if (ch === ':') {
+      tokens.push({ type: 'colon', value: ch, pos: i++ });
+      continue;
+    }
+
+    const op = OPERATORS.find((candidate) => input.startsWith(candidate, i));
+    if (op) {
+      tokens.push({ type: 'operator', value: op, pos: i });
+      i += op.length;
+      continue;
+    }
+
+    throw new FormulaSyntaxError(`Unexpected character "${ch}" at position ${i}`);
+  }
+
+  tokens.push({ type: 'eof', value: '', pos: input.length });
+  return tokens;
+}
diff --git a/src/values.ts b/src/values.ts
new file mode 100644
index 0000000..c535f11
--- /dev/null
+++ b/src/values.ts
@@ -0,0 +1,128 @@
+import { ErrorCode, FormulaError, isFormulaError } from './errors.js';
+
+/** A value a cell can hold once computed. `null` means the cell is empty. */
+export type CellValue = number | string | boolean | null;
+
+/** A cell value, or an error value produced while evaluating a formula. */
+export type EvalValue = CellValue | FormulaError;
+
+/**
+ * Significant digits kept when rendering numbers. Real spreadsheets store full
+ * IEEE-754 precision but display 15 significant digits, which hides artefacts
+ * such as `0.1 + 0.2 = 0.30000000000000004`.
+ */
+const DISPLAY_PRECISION = 15;
+
+/** Text that counts as a number: optional sign, digits, decimals, exponent. */
+const DECIMAL_PATTERN = /^[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?$/;
+
+/**
+ * Coerces a value to a number the way a spreadsheet does inside arithmetic:
+ * empty cells count as 0, booleans as 1/0, and numeric text is converted.
+ * Anything else yields a `#VALUE!` error.
+ */
+export function toNumber(value: EvalValue): number | FormulaError {
+  if (isFormulaError(value)) return value;
+  if (value === null) return 0;
+  if (typeof value === 'number') return value;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+
+  // Decimal notation only. `Number()` alone would also accept "0x10" and
+  // "Infinity", which a spreadsheet treats as plain text.
+  const trimmed = value.trim();
+  if (DECIMAL_PATTERN.test(trimmed)) {
+    const parsed = Number(trimmed);
+    if (Number.isFinite(parsed)) return parsed;
+  }
+  return new FormulaError(ErrorCode.VALUE, `Cannot use text "${value}" as a number`);
+}
+
+/**
+ * Coerces a value to a boolean for use as an `IF` condition. Numbers are true
+ * when non-zero and empty cells are false; text is not convertible.
+ */
+export function toBoolean(value: EvalValue): boolean | FormulaError {
+  if (isFormulaError(value)) return value;
+  if (value === null) return false;
+  if (typeof value === 'boolean') return value;
+  if (typeof value === 'number') return value !== 0;
+  return new FormulaError(ErrorCode.VALUE, `Cannot use text "${value}" as a condition`);
+}
+
+/** Sort rank used when comparing values of different types (as in Excel). */
+function typeRank(value: Exclude<CellValue, null>): number {
+  if (typeof value === 'number') return 0;
+  if (typeof value === 'string') return 1;
+  return 2; // boolean
+}
+
+/**
+ * Compares two values, returning a negative number, zero, or a positive
+ * number. Empty cells adopt the neutral value of whatever they are compared
+ * with (0, `""`, or `false`), text compares case-insensitively, and values of
+ * different types order as number < text < boolean.
+ */
+export function compareValues(left: CellValue, right: CellValue): number {
+  let a = left;
+  let b = right;
+
+  // An empty cell takes on the "zero" of the other operand's type.
+  if (a === null && b === null) return 0;
+  if (a === null) a = emptyAs(b as Exclude<CellValue, null>);
+  if (b === null) b = emptyAs(a as Exclude<CellValue, null>);
+
+  const rankA = typeRank(a as Exclude<CellValue, null>);
+  const rankB = typeRank(b as Exclude<CellValue, null>);
+  if (rankA !== rankB) return rankA - rankB;
+
+  if (typeof a === 'number' && typeof b === 'number') {
+    return a === b ? 0 : a < b ? -1 : 1;
+  }
+  if (typeof a === 'string' && typeof b === 'string') {
+    const x = a.toUpperCase();
+    const y = b.toUpperCase();
+    return x === y ? 0 : x < y ? -1 : 1;
+  }
+  return Number(a) - Number(b);
+}
+
+function emptyAs(other: Exclude<CellValue, null>): CellValue {
+  if (typeof other === 'number') return 0;
+  if (typeof other === 'string') return '';
+  return false;
+}
+
+/**
+ * Renders a number the way a spreadsheet cell would: rounded to 15
+ * significant digits with trailing noise removed.
+ */
+export function formatNumber(value: number): string {
+  if (!Number.isFinite(value)) return ErrorCode.NUM;
+  const rounded = Number(value.toPrecision(DISPLAY_PRECISION));
+  if (rounded === 0) return '0'; // collapses -0
+  return String(rounded);
+}
+
+/**
+ * Renders any cell value as the string a spreadsheet would show. Empty cells
+ * render as `""`, booleans in upper case, and errors as their code.
+ */
+export function formatValue(value: EvalValue): string {
+  if (isFormulaError(value)) return value.code;
+  if (value === null) return '';
+  if (typeof value === 'number') return formatNumber(value);
+  if (typeof value === 'boolean') return value ? 'TRUE' : 'FALSE';
+  return value;
+}
+
+/**
+ * Converts an internal evaluation result into the public value: error values
+ * surface as their code string (`"#DIV/0!"`), everything else is unchanged.
+ */
+export function toPublicValue(value: EvalValue): CellValue {
+  if (isFormulaError(value)) return value.code;
+  // Collapse -0 to 0, matching what `formatValue` displays. Otherwise `get`
+  // and `getDisplay` disagree and callers using Object.is see a surprise.
+  if (value === 0) return 0;
+  return value;
+}
