ctly the cells inside the block', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', 1);\n    sheet.set('A2', 1);\n    sheet.set('B2', 1);\n    sheet.set('C1', 100); // outside\n    sheet.set('A3', 100); // outside\n    sheet.set('D1', '=SUM(A1:B2)');\n    expect(sheet.get('D1')).toBe(4);\n  });\n\n  it('accepts corners given in any order', () => {\n    const sheet = numericSheet();\n    sheet.set('B1', '=SUM(A5:A1)');\n    expect(sheet.get('B1')).toBe(15);\n  });\n\n  it('treats a single-cell range as that cell', () => {\n    const sheet = numericSheet();\n    sheet.set('B1', '=SUM(A3:A3)');\n    expect(sheet.get('B1')).toBe(3);\n  });\n\n  it('ignores empty cells and text inside a range', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 'label');\n    sheet.set('A4', 20);\n    sheet.set('B1', '=SUM(A1:A5)');\n    expect(sheet.get('B1')).toBe(30);\n  });\n\n  it('rejects a range used as a plain value', () => {\n    const sheet = numericSheet();\n    sheet.set('B1', '=A1:A5');\n    sheet.set('B2', '=A1:A5+1');\n    expect(sheet.get('B1')).toBe('#VALUE!');\n    expect(sheet.get('B2')).toBe('#VALUE!');\n  });\n\n  it('propagates an error from inside a range', () => {\n    const sheet = numericSheet();\n    sheet.set('A3', '=1/0');\n    sheet.set('B1', '=SUM(A1:A5)');\n    expect(sheet.get('B1')).toBe('#DIV/0!');\n  });\n\n  it('rejects an absurdly large range', () => {\n    const sheet = new Spreadsheet();\n    expect(() => sheet.set('B1', '=SUM(A1:ZZZ1048576)')).toThrow(/exceeds the limit/);\n  });\n});\n\ndescribe('SUM', () => {\n  it('adds numbers given directly', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=SUM(1, 2, 3)');\n    expect(sheet.get('A1')).toBe(6);\n  });\n\n  it('mixes ranges, references and literals', () => {\n    const sheet = numericSheet();\n    sheet.set('B1', '=SUM(A1:A3, A5, 10)');\n    expect(sheet.get('B1')).toBe(21);\n  });\n\n  it('i