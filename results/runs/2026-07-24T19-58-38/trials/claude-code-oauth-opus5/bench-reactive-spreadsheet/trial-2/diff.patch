+  });
+
+  it('is #DIV/0! when nothing numeric is in range', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('B1', '=AVERAGE(A1:A5)');
+    expect(sheet.get('B1')).toBe('#DIV/0!');
+  });
+});
+
