+import { describe, expect, it } from 'vitest';
+import { FormulaSyntaxError } from './errors.js';
+import { parseFormula } from './parser.js';
+import { tokenize } from './tokenizer.js';
+import { Spreadsheet } from './index.js';
+import { toNumber } from './values.js';
+
+describe('tokenizer', () => {
+  const kinds = (input: string): string[] => tokenize(input).map((token) => token.type);
+
+  it('classifies the basic token kinds', () => {
+    expect(kinds('A1+2')).toEqual(['identifier', 'operator', 'number', 'eof']);
+    expect(kinds('SUM(A1:A5)')).toEqual([
+      'identifier',
+      'lparen',
+      'identifier',
+      'colon',
+      'identifier',
+      'rparen',
+      'eof',
+    ]);
+  });
+
+  it('prefers two-character operators over their prefixes', () => {
+    expect(tokenize('1<>2')[1].value).toBe('<>');
+    expect(tokenize('1<=2')[1].value).toBe('<=');
+    expect(tokenize('1>=2')[1].value).toBe('>=');
+    expect(tokenize('1<2')[1].value).toBe('<');
+  });
+
+  it('decodes string literals including escaped quotes', () => {
+    expect(tokenize('"a""b"')[0].value).toBe('a"b');
+    expect(tokenize('""')[0].value).toBe('');
+  });
+
+  it('only consumes an exponent when it is well formed', () => {
+    // `1E3` is a number, but `1E` must not swallow the `E` — it is a name.
+    expect(kinds('1e3')).toEqual(['number', 'eof']);
+    expect(kinds('1E')).toEqual(['number', 'identifier', 'eof']);
+  });
+
+  it('does not mistake a column letter for an exponent', () => {
+    expect(kinds('E3')).toEqual(['identifier', 'eof']);
+  });
+
+  it('rejects unterminated strings and stray characters', () => {
+    expect(() => tokenize('"abc')).toThrow(FormulaSyntaxError);
+    expect(() => tokenize('1 @ 2')).toThrow(FormulaSyntaxError);
+  });
+});
+
+describe('parser', () => {
+  it('builds a left-associative tree for equal precedence', () => {
+    const node = parseFormula('1-2-3');
+    expect(node).toMatchObject({
+      type: 'binary',
+      operator: '-',
+      left: { type: 'binary', operator: '-' },
+      right: { type: 'number', value: 3 },
+    });
+  });
+
+  it('binds multiplication tighter than addition', () => {
+    expect(parseFormula('1+2*3')).toMatchObject({
+      type: 'binary',
+      operator: '+',
+      right: { type: 'binary', operator: '*' },
+    });
+  });
+
+  it('binds comparison loosest', () => {
+    expect(parseFormula('1+2=3')).toMatchObject({
+      type: 'binary',
+      operator: '=',
+      left: { type: 'binary', operator: '+' },
+    });
+  });
+
+  it('normalises range corners', () => {
+    expect(parseFormula('SUM(C3:A1)')).toMatchObject({
+      type: 'call',
+      name: 'SUM',
+      args: [{ type: 'range', range: { start: { col: 0, row: 1 }, end: { col: 2, row: 3 } } }],
+    });
+  });
+
+  it('upper-cases function names', () => {
+    expect(parseFormula('sum(A1:A2)')).toMatchObject({ type: 'call', name: 'SUM' });
+  });
+
+  it('parses a call with no arguments', () => {
+    expect(parseFormula('SUM()')).toMatchObject({ type: 'call', name: 'SUM', args: [] });
+  });
+});
+
+describe('robustness', () => {
+  it('rejects pathological formulas cleanly instead of overflowing the stack', () => {
+    const sheet = new Spreadsheet();
+    const cases = [
+      '=' + '('.repeat(5000) + '1' + ')'.repeat(5000),
+      '=' + '-'.repeat(5000) + '1',
+      '=' + Array.from({ length: 50_000 }, () => '1').join('+'),
+    ];
+    for (const formula of cases) {
+      expect(() => sheet.set('A1', formula)).toThrow(FormulaSyntaxError);
+    }
+    expect(sheet.get('A1')).toBeNull();
+  });
+
+  it('accepts long but reasonable operator chains', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=' + Array.from({ length: 1000 }, () => '1').join('+'));
+    expect(sheet.get('A1')).toBe(1000);
+  });
+
+  it('treats only decimal notation as numeric text', () => {
+    expect(toNumber('12')).toBe(12);
+    expect(toNumber('-3.5')).toBe(-3.5);
+    expect(toNumber('1e3')).toBe(1000);
+    expect(toNumber(' 7 ')).toBe(7);
+    // These are all text as far as a spreadsheet is concerned.
+    for (const text of ['0x10', '0b11', 'Infinity', 'NaN', '1,000', '']) {
+      expect(toNumber(text), text).toHaveProperty('code', '#VALUE!');
+    }
+  });
+
+  it('does not let hex-looking text act as a number', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '0x10');
+    sheet.set('B1', '=A1+0');
+    expect(sheet.get('B1')).toBe('#VALUE!');
+  });
+});
