diff --git a/src/ast.ts b/src/ast.ts
new file mode 100644
index 0000000..ee0f43b
--- /dev/null
+++ b/src/ast.ts
@@ -0,0 +1,62 @@
+import type { CellRef, RangeRef } from './reference.js';
+
+/** Operators that combine two operands. */
+export type BinaryOperator = '+' | '-' | '*' | '/' | '=' | '<>' | '<' | '<=' | '>' | '>=';
+
+export interface NumberNode {
+  readonly type: 'number';
+  readonly value: number;
+}
+
+export interface StringNode {
+  readonly type: 'string';
+  readonly value: string;
+}
+
+export interface BooleanNode {
+  readonly type: 'boolean';
+  readonly value: boolean;
+}
+
+export interface ReferenceNode {
+  readonly type: 'reference';
+  readonly ref: CellRef;
+  /** Canonical key (e.g. `A1`) used to look the cell up. */
+  readonly key: string;
+}
+
+export interface RangeNode {
+  readonly type: 'range';
+  readonly range: RangeRef;
+}
+
+export interface UnaryNode {
+  readonly type: 'unary';
+  readonly operator: '-' | '+';
+  readonly operand: Node;
+}
+
+export interface BinaryNode {
+  readonly type: 'binary';
+  readonly operator: BinaryOperator;
+  readonly left: Node;
+  readonly right: Node;
+}
+
+export interface CallNode {
+  readonly type: 'call';
+  /** Upper-cased function name. */
+  readonly name: string;
+  readonly args: Node[];
+}
+
+/** Any node in a parsed formula. */
+export type Node =
+  | NumberNode
+  | StringNode
+  | BooleanNode
+  | ReferenceNode
+  | RangeNode
+  | UnaryNode
+  | BinaryNode
+  | CallNode;
diff --git a/src/errors.ts b/src/errors.ts
new file mode 100644
index 0000000..33c7247
--- /dev/null
+++ b/src/errors.ts
@@ -0,0 +1,83 @@
+/**
+ * Error handling for the spreadsheet engine.
+ *
+ * Two distinct kinds of failure exist:
+ *
+ * 1. **Thrown errors** — the caller did something structurally invalid
+ *    (bad cell reference, unparsable formula, circular dependency). These
+ *    reject the mutation entirely and leave the sheet untouched.
+ * 2. **Error values** — the formula is well-formed but cannot produce a
+ *    result (`#DIV/0!`, `#VALUE!`, ...). These behave like real spreadsheet
+ *    errors: they become the cell's value and propagate to dependents.
+ */
+
+/** Standard spreadsheet error codes produced during evaluation. */
+export const ErrorCode = {
+  /** Division by zero. */
+  DIV0: '#DIV/0!',
+  /** A value has the wrong type for the operation. */
+  VALUE: '#VALUE!',
+  /** A reference is not valid. */
+  REF: '#REF!',
+  /** Unknown function name. */
+  NAME: '#NAME?',
+  /** A numeric operation overflowed or is otherwise undefined. */
+  NUM: '#NUM!',
+  /** No value is available (e.g. AVERAGE over an empty range). */
+  NA: '#N/A',
+} as const;
+
+export type ErrorCodeValue = (typeof ErrorCode)[keyof typeof ErrorCode];
+
+/**
+ * An error *value* living inside a cell. Unlike a thrown error this is a
+ * first-class value: it can be stored, read back and propagated through
+ * dependent formulas, exactly like `#DIV/0!` in a real spreadsheet.
+ */
+export class FormulaError {
+  readonly code: ErrorCodeValue;
+  readonly message: string;
+
+  constructor(code: ErrorCodeValue, message = '') {
+    this.code = code;
+    this.message = message;
+  }
+
+  toString(): string {
+    return this.code;
+  }
+}
+
+/** Type guard for {@link FormulaError}. */
+export function isFormulaError(value: unknown): value is FormulaError {
+  return value instanceof FormulaError;
+}
+
+/** Base class for every error the engine throws. */
+export class SpreadsheetError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = new.target.name;
+  }
+}
+
+/** Thrown when a cell reference or range cannot be parsed. */
+export class InvalidReferenceError extends SpreadsheetError {}
+
+/** Thrown when a formula's text cannot be parsed. */
+export class FormulaSyntaxError extends SpreadsheetError {}
+
+/**
+ * Thrown when a `set` would make a cell depend on itself, directly or
+ * through any chain of intermediate cells. The offending chain is included
+ * in the message and available as {@link cycle}.
+ */
+export class CircularReferenceError extends SpreadsheetError {
+  /** The cycle, starting and ending at the same cell. */
+  readonly cycle: string[];
+
+  constructor(cycle: string[]) {
+    super(`Circular reference detected: ${cycle.join(' -> ')}`);
+    this.cycle = cycle;
+  }
+}
