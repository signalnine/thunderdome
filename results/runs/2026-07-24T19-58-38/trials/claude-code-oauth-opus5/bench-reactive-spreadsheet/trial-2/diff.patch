ing that referenced it. */\n149\t  clear(ref: string): void {\n150\t    const key = normalizeRef(ref);\n151\t    if (!this.cells.has(key)) return;\n152\t    this.unlink(key);\n153\t    this.cells.delete(key);\n154\t    this.recompute(key);\n155\t  }\n156\t\n157\t  /** Removes every cell from the sheet. */\n158\t  clearAll(): void {\n159\t    this.cells.clear();\n160\t    this.dependents.clear();\n161\t  }\n162\t\n163\t  /** The cells whose formulas read `ref`, directly. */\n164\t  getDependents(ref: string): string[] {\n165\t    return [...(this.dependents.get(normalizeRef(ref)) ?? [])].sort(compareRefs);\n166\t  }\n167\t\n168\t  /** The cells that `ref`'s formula reads, directly. */\n169\t  getPrecedents(ref: string): string[] {\n170\t    const cell = this.cells.get(normalizeRef(ref));\n171\t    return cell ? [...cell.precedents].sort(compareRefs) : [];\n172\t  }\n173\t\n174\t  /** Drops the edges recorded for `key`'s current formula. */\n175\t  private unlink(key: string): void {\n176\t    const cell = this.cells.get(key);\n177\t    if (!cell) return;\n178\t    for (const precedent of cell.precedents) {\n179\t      const set = this.dependents.get(precedent);\n180\t      if (!set) continue;\n181\t      set.delete(key);\n182\t      if (set.size === 0) this.dependents.delete(precedent);\n183\t    }\n184\t  }\n185\t\n186\t  /**\n187\t   * Searches the precedent graph for a path from any of `precedents` back to\n188\t   * `target`. Returns the offending chain, or `null` when there is none.\n189\t   */\n190\t  private findCycle(target: string, precedents: ReadonlySet<string>): string[] | null {\n191\t    /** Records, for each visited cell, the cell that led us to it. */\n192\t    const cameFrom = new Map<string, string>();\n193\t    const visited = new Set<string>();\n194\t    const stack: string[] = [];\n195\t\n196\t    for (const precedent of precedents) {\n197\t      cameFrom.set(precedent, target);\n198\t      stack.push(precedent);\n199\t    }\n200\t\n201\t    whil