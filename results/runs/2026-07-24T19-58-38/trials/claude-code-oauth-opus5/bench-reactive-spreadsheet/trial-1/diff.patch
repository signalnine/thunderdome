+
+    expect(snapshot.get('A1')).toBe(1);
+    expect(sheet.getCells().get('A1')).toBe(2);
+  });
+
+  it('omits cleared cells', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('A2', 2);
+    sheet.clear('A1');
+
+    expect([...sheet.getCells().keys()]).toEqual(['A2']);
+  });
+});
+
+describe('clearing', () => {
+  it('empties a cell when set to an empty string', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 5);
+    sheet.set('A1', '');
+
+    expect(sheet.get('A1')).toBeNull();
+    expect(sheet.getCells().size).toBe(0);
+  });
+
+  it('recomputes dependents of a cleared cell', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 5);
+    sheet.set('B1', '=A1+1');
+    sheet.set('C1', '=SUM(A1:A2)');
+    expect(sheet.get('B1')).toBe(6);
