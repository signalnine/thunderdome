, 1);\n    sheet.set('A1', 'replaced');\n    expect(sheet.get('A1')).toBe('replaced');\n  });\n\n  it('accepts references in any case, with or without $', () => {\n    sheet.set('a1', 5);\n    expect(sheet.get('A1')).toBe(5);\n    sheet.set('B1', '=$a$1 * 2');\n    expect(sheet.get('b1')).toBe(10);\n  });\n});\n\ndescribe('empty cells', () => {\n  const sheet = new Spreadsheet();\n\n  it('read as null and display as an empty string', () => {\n    expect(sheet.get('Z99')).toBeNull();\n    expect(sheet.getDisplay('Z99')).toBe('');\n    expect(sheet.getRaw('Z99')).toBeNull();\n  });\n\n  it('count as zero inside formulas', () => {\n    sheet.set('A1', '=Z99+1');\n    expect(sheet.get('A1')).toBe(1);\n  });\n});\n\ndescribe('getDisplay', () => {\n  const sheet = new Spreadsheet();\n\n  it('renders each value type', () => {\n    sheet.set('A1', 30);\n    sheet.set('A2', 'text');\n    sheet.set('A3', true);\n    sheet.set('A4', false);\n    sheet.set('A5', -0.5);\n\n    expect(sheet.getDisplay('A1')).toBe('30');\n    expect(sheet.getDisplay('A2')).toBe('text');\n    expect(sheet.getDisplay('A3')).toBe('true');\n    expect(sheet.getDisplay('A4')).toBe('false');\n    expect(sheet.getDisplay('A5')).toBe('-0.5');\n  });\n\n  it('hides binary floating point noise', () => {\n    sheet.set('B1', 0.1);\n    sheet.set('B2', 0.2);\n    sheet.set('B3', '=B1+B2');\n\n    // The stored value keeps full double precision...\n    expect(sheet.get('B3')).toBeCloseTo(0.3, 15);\n    // ...while the display reads the way a spreadsheet would show it.\n    expect(sheet.getDisplay('B3')).toBe('0.3');\n  });\n\n  it('shows error codes', () => {\n    sheet.set('C1', '=1/0');\n    expect(sheet.getDisplay('C1')).toBe('#DIV/0!');\n  });\n});\n\ndescribe('getRaw', () => {\n  it('returns the formula source for formula cells', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 2);\n    sheet.set('A2', '=A1 * 3');\n\n    expect(sheet.getRaw('A1')).toBe(2);\n    expect(sheet.getRaw('A2'))