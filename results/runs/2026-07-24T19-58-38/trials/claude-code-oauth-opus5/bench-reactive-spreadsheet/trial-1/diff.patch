--- /dev/null
+++ b/src/reference.ts
@@ -0,0 +1,137 @@
+/**
+ * Parsing and formatting of A1-style cell references and ranges.
+ *
+ * Columns are 1-based indices: A = 1, Z = 26, AA = 27, AZ = 52, BA = 53, ...
+ * Rows are 1-based as written.
+ */
+
+import { InvalidCellReferenceError } from './errors.js';
+
+/** Largest supported column (`XFD`), matching common spreadsheet limits. */
+export const MAX_COLUMN = 16384;
+/** Largest supported row, matching common spreadsheet limits. */
+export const MAX_ROW = 1048576;
+
+/** A single cell, e.g. `B3` -> `{ col: 2, row: 3, key: 'B3' }`. */
+export interface CellRef {
+  readonly col: number;
+  readonly row: number;
+  /** Canonical uppercase name; also the key used in the engine's maps. */
+  readonly key: string;
+}
+
+/** A rectangular range. `start` is always the top-left, `end` the bottom-right. */
+export interface RangeRef {
+  readonly startCol: number;
+  readonly startRow: number;
+  readonly endCol: number;
+  readonly endRow: number;
+  /** Canonical name, e.g. `A1:C3`. */
+  readonly key: string;
+}
+
+const CELL_PATTERN = /^\$?([A-Za-z]+)\$?([0-9]+)$/;
+
+/** `'A'` -> 1, `'AA'` -> 27. Assumes the input is all letters. */
+export function columnToIndex(letters: string): number {
+  let index = 0;
+  for (let i = 0; i < letters.length; i++) {
+    const code = letters.charCodeAt(i);
+    // Uppercase A-Z is 65-90; lowercase a-z is 97-122.
+    const digit = (code >= 97 ? code - 97 : code - 65) + 1;
+    index = index * 26 + digit;
+  }
+  return index;
+}
+
+/** 1 -> `'A'`, 27 -> `'AA'`. Inverse of {@link columnToIndex}. */
+export function indexToColumn(index: number): string {
+  if (!Number.isInteger(index) || index < 1) {
+    throw new RangeError(`Column index out of range: ${index}`);
+  }
+  let letters = '';
+  let remaining = index;
+  while (remaining > 0) {
+    // Shift to 0-based for the modulo, since the system has no "zero digit".
+    const digit = (remaining - 1) % 26;
+    letters = String.fromCharCode(65 + digit) + letters;
+    remaining = Math.floor((remaining - 1) / 26);
+  }
+  return letters;
+}
+
+/** Builds the canonical key for a cell, e.g. `(2, 3)` -> `'B3'`. */
+export function cellKey(col: number, row: number): string {
+  return `${indexToColumn(col)}${row}`;
+}
+
+export function makeCellRef(col: number, row: number): CellRef {
+  return { col, row, key: cellKey(col, row) };
+}
+
+/**
+ * Parses an A1-style reference. A leading `$` on either component is accepted
+ * and ignored — absolute references only matter when copying formulas, which
+ * this engine does not do.
+ *
+ * @returns the reference, or `null` if the text is not a valid in-range cell.
+ */
+export function parseCellRef(text: string): CellRef | null {
+  const match = CELL_PATTERN.exec(text.trim());
+  if (!match) return null;
+
+  const col = columnToIndex(match[1]);
+  const row = Number(match[2]);
+  if (col < 1 || col > MAX_COLUMN) return null;
+  if (!Number.isInteger(row) || row < 1 || row > MAX_ROW) return null;
+
+  return makeCellRef(col, row);
+}
+
+/** Like {@link parseCellRef} but throws — used to validate public API arguments. */
+export function requireCellRef(text: string): CellRef {
+  if (typeof text !== 'string') {
+    throw new InvalidCellReferenceError(String(text));
+  }
+  const ref = parseCellRef(text);
+  if (!ref) throw new InvalidCellReferenceError(text);
+  return ref;
+}
+
+/**
+ * Builds a range from two corners. The corners are normalized, so `A5:A1` and
+ * `A1:A5` produce the same range.
+ */
+export function makeRange(a: CellRef, b: CellRef): RangeRef {
+  const startCol = Math.min(a.col, b.col);
+  const startRow = Math.min(a.row, b.row);
+  const endCol = Math.max(a.col, b.col);
+  const endRow = Math.max(a.row, b.row);
+  return {
+    startCol,
+    startRow,
+    endCol,
+    endRow,
+    key: `${cellKey(startCol, startRow)}:${cellKey(endCol, endRow)}`,
+  };
+}
+
+export function rangeContains(range: RangeRef, col: number, row: number): boolean {
+  return (
+    col >= range.startCol && col <= range.endCol && row >= range.startRow && row <= range.endRow
+  );
+}
+
+/** Number of cells the range covers, including empty ones. */
+export function rangeSize(range: RangeRef): number {
+  return (range.endCol - range.startCol + 1) * (range.endRow - range.startRow + 1);
+}
+
+/** Iterates the range in reading order (left-to-right, then top-to-bottom). */
+export function* iterateRange(range: RangeRef): Generator<CellRef> {
+  for (let row = range.startRow; row <= range.endRow; row++) {
+    for (let col = range.startCol; col <= range.endCol; col++) {
+      yield makeCellRef(col, row);
+    }
+  }
+}
diff --git a/src/spreadsheet.ts b/src/spreadsheet.ts
new file mode 100644
index 0000000..5f23c60
--- /dev/null
+++ b/src/spreadsheet.ts
@@ -0,0 +1,413 @@
+/**
+ * The reactive spreadsheet engine.
+ *
+ * ## How reactivity works
+ *
+ * Every cell records what it reads (its *dependencies*) as either single cells
+ * or whole ranges. The engine keeps the reverse edges too, so when a cell
+ * changes it can find its *dependents* directly:
+ *
+ * - `dependentsByCell` maps a cell to the cells whose formulas name it.
+ * - `rangesByReader` maps a formula cell to the ranges it reads; a change to
+ *   any cell inside such a range makes that formula a dependent. Ranges are
+ *   deliberately *not* expanded into per-cell edges — `SUM(A1:A1000)` is one
+ *   edge, and a cell created inside the range later is picked up for free.
+ *
+ * A `set` therefore does three things: install the new content, reject the
+ * assignment if it would close a cycle, then recompute the changed cell and
+ * everything downstream of it in topological order — each cell exactly once,
+ * and only after the cells it reads.
+ */
+
+import { collectDependencies, type Dependency, type Node } from './ast.js';
+import { evaluate, type EvaluationContext } from './evaluator.js';
+import { CellError, CircularReferenceError, FormulaSyntaxError } from './errors.js';
+import { parseFormula } from './parser.js';
+import {
+  iterateRange,
+  parseCellRef,
+  rangeContains,
+  rangeSize,
+  requireCellRef,
+  type CellRef,
+  type RangeRef,
+} from './reference.js';
+import {
+  formatValue,
+  toPublicValue,
+  type CellInput,
+  type CellValue,
+  type PublicCellValue,
+} from './values.js';
+
+interface Cell {
+  readonly ref: CellRef;
+  /** Exactly what was passed to `set`, including the leading `=` of a formula. */
+  readonly input: CellInput;
+  /** Parsed formula, or `null` for literals and formulas that failed to parse. */
+  readonly formula: Node | null;
+  readonly dependencies: readonly Dependency[];
+  /** Latest computed value. For non-formula cells this is fixed at `set` time. */
+  value: CellValue;
+}
+
+export class Spreadsheet {
+  private readonly cells = new Map<string, Cell>();
+
+  /** precedent cell key -> keys of cells that reference it directly. */
+  private readonly dependentsByCell = new Map<string, Set<string>>();
+
+  /** formula cell key -> ranges that formula reads. */
+  private readonly rangesByReader = new Map<string, readonly RangeRef[]>();
+
+  private readonly context: EvaluationContext = {
+    getCellValue: (ref) => this.cells.get(ref.key)?.value ?? null,
+    getRangeValues: (range) => this.collectRange(range).map((cell) => cell.value),
+  };
+
+  /**
+   * Sets a cell's content. A string beginning with `=` is treated as a formula;
+   * anything else is stored as a literal number, string, or boolean.
+   *
+   * Setting `''` clears the cell.
+   *
+   * @throws {CircularReferenceError} if the assignment would create a
+   *   dependency cycle. The sheet is left unchanged in that case.
+   * @throws {InvalidCellReferenceError} if `cell` is not a valid reference.
+   * @throws {TypeError} if `value` is not a string, number, or boolean.
+   */
+  set(cell: string, value: CellInput): void {
+    const ref = requireCellRef(cell);
+
+    if (value === '' || value === null || value === undefined) {
+      this.clear(ref.key);
+      return;
+    }
+    if (typeof value === 'number') {
+      if (!Number.isFinite(value)) {
+        throw new TypeError(`Cannot set ${ref.key} to a non-finite number: ${value}`);
+      }
+    } else if (typeof value !== 'string' && typeof value !== 'boolean') {
+      throw new TypeError(`Unsupported cell value for ${ref.key}: ${typeof value}`);
+    }
+
+    const previous = this.cells.get(ref.key);
+    this.install(this.buildCell(ref, value));
+
+    const cycle = this.findCycle(ref.key);
+    if (cycle) {
+      // Roll back so a rejected assignment has no observable effect.
+      if (previous) this.install(previous);
+      else this.remove(ref.key);
+      throw new CircularReferenceError(ref.key, cycle);
+    }
+
+    this.recalculate(ref);
+  }
+
+  /**
+   * Returns a cell's computed value, or `null` if the cell is empty.
+   * Error values are returned as their code, e.g. `'#DIV/0!'`.
+   */
+  get(cell: string): PublicCellValue {
+    const ref = requireCellRef(cell);
+    return toPublicValue(this.cells.get(ref.key)?.value ?? null);
+  }
+
+  /** Returns the display string for a cell; `''` for empty cells. */
+  getDisplay(cell: string): string {
+    const ref = requireCellRef(cell);
+    return formatValue(this.cells.get(ref.key)?.value ?? null);
+  }
+
+  /**
+   * Returns exactly what was passed to `set` — the formula source for formula
+   * cells — or `null` if the cell is empty.
+   */
+  getRaw(cell: string): CellInput | null {
+    const ref = requireCellRef(cell);
+    return this.cells.get(ref.key)?.input ?? null;
+  }
+
+  /**
+   * Every non-empty cell and its computed value, in reading order (top-to-bottom,
+   * then left-to-right). The returned map is a snapshot and is not live.
+   */
+  getCells(): Map<string, PublicCellValue> {
+    const ordered = [...this.cells.values()].sort(
+      (a, b) => a.ref.row - b.ref.row || a.ref.col - b.ref.col,
+    );
+    const result = new Map<string, PublicCellValue>();
+    for (const cell of ordered) result.set(cell.ref.key, toPublicValue(cell.value));
+    return result;
+  }
+
+  /** Empties a cell and recomputes anything that depended on it. */
+  clear(cell: string): void {
+    const ref = requireCellRef(cell);
+    if (!this.cells.has(ref.key)) return;
+    this.remove(ref.key);
+    this.recalculate(ref);
+  }
+
+  /** Removes every cell from the sheet. */
+  clearAll(): void {
+    this.cells.clear();
+    this.dependentsByCell.clear();
+    this.rangesByReader.clear();
+  }
+
+  // ---------------------------------------------------------------- content
+
+  private buildCell(ref: CellRef, input: CellInput): Cell {
+    if (typeof input !== 'string' || !input.startsWith('=')) {
+      return { ref, input, formula: null, dependencies: [], value: input };
+    }
+
+    try {
+      const formula = parseFormula(input.slice(1));
+      return {
+        ref,
+        input,
+        formula,
+        dependencies: collectDependencies(formula),
+        // Replaced by `recalculate` before anyone can observe it.
+        value: 0,
+      };
+    } catch (error) {
+      if (!(error instanceof FormulaSyntaxError)) throw error;
+      // A malformed formula is kept as an error value rather than rejected, so
+      // one bad entry cannot break the rest of the sheet.
+      return {
+        ref,
+        input,
+        formula: null,
+        dependencies: [],
+        value: new CellError('#ERROR!', error.message),
+      };
+    }
+  }
+
+  /** Adds (or replaces) a cell and rewrites its outgoing dependency edges. */
+  private install(cell: Cell): void {
+    this.remove(cell.ref.key);
+    this.cells.set(cell.ref.key, cell);
+
+    const ranges: RangeRef[] = [];
+    for (const dependency of cell.dependencies) {
+      if (dependency.kind === 'range') {
+        ranges.push(dependency.range);
+        continue;
+      }
+      let dependents = this.dependentsByCell.get(dependency.ref.key);
+      if (!dependents) {
+        dependents = new Set();
+        this.dependentsByCell.set(dependency.ref.key, dependents);
+      }
+      dependents.add(cell.ref.key);
+    }
+    if (ranges.length > 0) this.rangesByReader.set(cell.ref.key, ranges);
+  }
+
+  /** Deletes a cell and its outgoing edges. Incoming edges belong to others. */
+  private remove(key: string): void {
+    const cell = this.cells.get(key);
+    if (!cell) return;
+
+    for (const dependency of cell.dependencies) {
+      if (dependency.kind !== 'cell') continue;
+      const dependents = this.dependentsByCell.get(dependency.ref.key);
+      if (!dependents) continue;
+      dependents.delete(key);
+      if (dependents.size === 0) this.dependentsByCell.delete(dependency.ref.key);
+    }
+    this.rangesByReader.delete(key);
+    this.cells.delete(key);
+  }
+
+  // ------------------------------------------------------------ graph walks
+
+  /** Cells the given cell reads, restricted to cells that actually exist. */
+  private precedentsOf(key: string): string[] {
+    const cell = this.cells.get(key);
+    if (!cell) return [];
+
+    const keys: string[] = [];
+    for (const dependency of cell.dependencies) {
+      if (dependency.kind === 'cell') {
+        if (this.cells.has(dependency.ref.key)) keys.push(dependency.ref.key);
+      } else {
+        // Empty cells hold no formulas, so only populated ones can extend a path.
+        for (const inRange of this.collectRange(dependency.range)) keys.push(inRange.ref.key);
+      }
+    }
+    return keys;
+  }
+
+  /**
+   * Cells that read the given cell, directly or through a range.
+   *
+   * Range edges are stored per reader rather than expanded per cell, so finding
+   * the readers of a cell means checking each range-reading formula. That scan
+   * is skipped entirely — the common case — when the sheet has none.
+   */
+  private dependentsOf(ref: CellRef): string[] {
+    const direct = this.dependentsByCell.get(ref.key);
+    if (this.rangesByReader.size === 0) return direct ? [...direct] : [];
+
+    const keys = new Set(direct);
+    for (const [reader, ranges] of this.rangesByReader) {
+      if (ranges.some((range) => rangeContains(range, ref.col, ref.row))) keys.add(reader);
+    }
+    return [...keys];
+  }
+
+  /**
+   * Looks for a path from `startKey` back to itself.
+   *
+   * A cycle through a cell is visible from either end of the graph, so two
+   * searches run in lockstep — one following what the cell reads, one following
+   * what reads it — and the first to finish decides. That matters because the
+   * two sides are rarely the same size: appending `A_n = A_{n-1} + 1` to a
+   * chain has n cells upstream and none downstream, so checking only upstream
+   * would make building the chain quadratic. Meeting in the middle keeps each
+   * `set` proportional to the *smaller* side.
+   *
+   * Both searches are iterative, so a long chain cannot overflow the stack. A
+   * node already explored without reaching the start is skipped if seen again:
+   * whether it reaches the start is a property of the node, not of the path
+   * taken to it. Pre-existing cycles cannot occur — each would have been
+   * rejected when it was created.
+   *
+   * @returns the cycle as a list of cells starting and ending at `startKey`
+   *   (each cell reading the next), or `null` when the assignment is safe.
+   */
+  private findCycle(startKey: string): string[] | null {
+    const upstream = this.createWalker(startKey, (key) => this.precedentsOf(key));
+    const downstream = this.createWalker(startKey, (key) => {
+      const ref = this.refForKey(key);
+      return ref ? this.dependentsOf(ref) : [];
+    });
+
+    for (;;) {
+      const up = upstream.step();
+      if (up === 'cycle') return [...upstream.path];
+      if (up === 'done') return null;
+
+      const down = downstream.step();
+      // The downstream path runs against the direction of reading, so reverse
+      // it to describe the cycle the same way as the upstream one.
+      if (down === 'cycle') return [...downstream.path].reverse();
+      if (down === 'done') return null;
+    }
+  }
+
+  /**
+   * A resumable depth-first search from `startKey` that reports when it walks
+   * back onto its starting point.
+   */
+  private createWalker(startKey: string, neighbors: (key: string) => string[]) {
+    const visited = new Set<string>([startKey]);
+    const path: string[] = [startKey];
+    const stack = [{ nodes: neighbors(startKey), index: 0 }];
+
+    return {
+      /** The current search path; meaningful once `step` reports `'cycle'`. */
+      path,
+      /** Follows at most one edge. */
+      step(): 'cycle' | 'done' | 'searching' {
+        const frame = stack[stack.length - 1];
+        if (!frame) return 'done';
+
+        if (frame.index >= frame.nodes.length) {
+          stack.pop();
+          path.pop();
+          return 'searching';
+        }
+
+        const next = frame.nodes[frame.index++];
+        if (next === startKey) {
+          path.push(startKey);
+          return 'cycle';
+        }
+        if (visited.has(next)) return 'searching';
+
+        visited.add(next);
+        path.push(next);
+        stack.push({ nodes: neighbors(next), index: 0 });
+        return 'searching';
+      },
+    };
+  }
+
+  // ------------------------------------------------------------ evaluation
+
+  /**
+   * Recomputes `start` and everything downstream of it, each cell exactly once
+   * and only after the cells it reads.
+   *
+   * A depth-first search over dependents yields the affected cells in postorder;
+   * reversing that postorder is a topological order of the affected subgraph,
+   * which is the property we need. (Every dependent of an affected cell is
+   * itself affected, so no edge leaves the searched region.) The search is
+   * iterative — a 10,000-cell chain would overflow a recursive one.
+   */
+  private recalculate(start: CellRef): void {
+    const visited = new Set<string>([start.key]);
+    const postorder: string[] = [];
+    const stack = [{ ref: start, dependents: this.dependentsOf(start), index: 0 }];
+
+    while (stack.length > 0) {
+      const frame = stack[stack.length - 1];
+      if (frame.index >= frame.dependents.length) {
+        stack.pop();
+        postorder.push(frame.ref.key);
+        continue;
+      }
+
+      const key = frame.dependents[frame.index++];
+      if (visited.has(key)) continue;
+      visited.add(key);
+
+      const cell = this.cells.get(key);
+      if (cell) {
+        stack.push({ ref: cell.ref, dependents: this.dependentsOf(cell.ref), index: 0 });
+      }
+    }
+
+    for (let i = postorder.length - 1; i >= 0; i--) {
+      const cell = this.cells.get(postorder[i]);
+      // Literals, unparsable formulas, and cleared cells have nothing to redo.
+      if (cell?.formula) cell.value = evaluate(cell.formula, this.context);
+    }
+  }
+
+  /**
+   * Non-empty cells inside a range, in reading order.
+   *
+   * A range can cover millions of coordinates while the sheet holds a handful
+   * of cells, so this walks whichever of the two is smaller.
+   */
+  private collectRange(range: RangeRef): Cell[] {
+    const found: Cell[] = [];
+
+    if (rangeSize(range) <= this.cells.size) {
+      for (const ref of iterateRange(range)) {
+        const cell = this.cells.get(ref.key);
+        if (cell) found.push(cell);
+      }
+      return found;
+    }
+
+    for (const cell of this.cells.values()) {
+      if (rangeContains(range, cell.ref.col, cell.ref.row)) found.push(cell);
+    }
+    // The map is in insertion order; sort so range results stay deterministic.
+    found.sort((a, b) => a.ref.row - b.ref.row || a.ref.col - b.ref.col);
+    return found;
+  }
+
+  private refForKey(key: string): CellRef | null {
+    return this.cells.get(key)?.ref ?? parseCellRef(key);
+  }
+}
