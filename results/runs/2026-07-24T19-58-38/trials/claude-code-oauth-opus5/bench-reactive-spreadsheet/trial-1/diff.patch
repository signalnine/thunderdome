+<span class="cline-any cline-neutral">&nbsp;</span></td><td class="text"><pre class="prettyprint lang-js">/**
+ * Recursive-descent parser for formulas.
+ *
+ * Precedence, loosest to tightest:
+ *
+ *   comparison   `=  &lt;&gt;  &gt;  &lt;  &gt;=  &lt;=`   (left-associative)
+ *   concat       `&amp;`
+ *   additive     `+  -`
+ *   multiplicative `*  /`
+ *   unary        `-x  +x`
+ *   power        `^`                     (right-associative)
+ *   primary      literals, references, calls, `( ... )`
+ */
+&nbsp;
+import type { BinaryOperator, Node, UnaryOperator } from './ast.js';
+import { FormulaSyntaxError } from './errors.js';
+import { makeRange, parseCellRef } from './reference.js';
+import { tokenize, type Token } from './tokenizer.js';
+&nbsp;
+const COMPARISON_OPERATORS = new Set&lt;string&gt;(['=', '&lt;&gt;', '&gt;', '&lt;', '&gt;=', '&lt;=']);
+&nbsp;
+class Parser {
+  private readonly tokens: Token[];
+  private position = 0;
+&nbsp;
+  constructor(source: string) {
+    this.tokens = tokenize(source);
+  }
+&nbsp;
+  parse(): Node {
+    const expression = this.parseComparison();
+    const token = this.peek();
+    if (token.type !== 'eof') {
+      throw new FormulaSyntaxError(`Unexpected ${describe(token)}`, token.start);
+    }
+    return expression;
+  }
+&nbsp;
+  private peek(): Token {
+    return this.tokens[this.position];
+  }
+&nbsp;
+  private next(): Token {
+    return this.tokens[this.position++];
+  }
+&nbsp;
+  private matchOperator(...operators: string[]): Token | null {
+    const token = this.peek();
+    if (token.type === 'operator' &amp;&amp; operators.includes(token.value)) {
+      this.position++;
+      return token;
+    }
+    return null;
+  }
+&nbsp;
+  private parseComparison(): Node {
+    let left = this.parseConcat();
+    for (;;) {
+      const token = this.peek();
+      if (token.type !== 'operator' || !COMPARISON_OPERATORS.has(token.value)) return left;
+      this.position++;
+      left = { type: 'binary', operator: token.value as BinaryOperator, left, right: this.parseConcat() };
+    }
+  }
+&nbsp;
+  private parseConcat(): Node {
+    let left = this.parseAdditive();
+    for (;;) {
+      if (!this.matchOperator('&amp;')) return left;
+      left = { type: 'binary', operator: '&amp;', left, right: this.parseAdditive() };
+    }
+  }
+&nbsp;
+  private parseAdditive(): Node {
+    let left = this.parseMultiplicative();
+    for (;;) {
+      const token = this.matchOperator('+', '-');
+      if (!token) return left;
+      left = {
+        type: 'binary',
+        operator: token.value as BinaryOperator,
+        left,
+        right: this.parseMultiplicative(),
+      };
+    }
+  }
+&nbsp;
+  private parseMultiplicative(): Node {
+    let left = this.parseUnary();
+    for (;;) {
+      const token = this.matchOperator('*', '/');
+      if (!token) return left;
+      left = {
+        type: 'binary',
+        operator: token.value as BinaryOperator,
+        left,
+        right: this.parseUnary(),
+      };
+    }
+  }
+&nbsp;
+  private parseUnary(): Node {
+    const token = this.matchOperator('+', '-');
+    if (token) {
+      return { type: 'unary', operator: token.value as UnaryOperator, operand: this.parseUnary() };
+    }
+    return this.parsePower();
+  }
+&nbsp;
+  private parsePower(): Node {
+    const base = this.parsePrimary();
+    if (!this.matchOperator('^')) return base;
+    // Right-associative, and `2^-1` is allowed, so recurse through unary.
+    return { type: 'binary', operator: '^', left: base, right: this.parseUnary() };
+  }
+&nbsp;
+  private parsePrimary(): Node {
+    const token = this.next();
+&nbsp;
+    switch (token.type) {
+      case 'number':
+        return { type: 'number', value: Number(token.value) };
+&nbsp;
+      case 'string':
+        return { type: 'string', value: token.value };
+&nbsp;
+      case 'cell':
+        return this.parseReference(token);
+&nbsp;
+      case 'identifier': {
+        const upper = token.value.toUpperCase();
+        if (upper === 'TRUE' || upper === 'FALSE') {
+          // `TRUE()` is also valid spelling for the boolean literal.
+          if (this.peek().type === 'lparen') {
+            this.position++;
+            this.expect('rparen');
+          }
+          return { type: 'boolean', value: upper === 'TRUE' };
+        }
+        if (this.peek().type !== 'lparen') {
+          throw new FormulaSyntaxError(`Unknown name ${token.value}`, token.start);
+        }
+        this.position++;
+        return { type: 'call', name: upper, args: this.parseArguments() };
+      }
+&nbsp;
+      case 'lparen': {
+        const inner = this.parseComparison();
+        this.expect('rparen');
+        return inner;
+      }
+&nbsp;
+      default:
+        throw new FormulaSyntaxError(`Unexpected ${describe(token)}`, token.start);
+    }
+  }
+&nbsp;
+  /** Parses `A1` or, when a colon follows, the range `A1:B2`. */
+  private parseReference(token: Token): Node {
+    const start = parseCellRef(token.value);
+    if (!start) throw new FormulaSyntaxError(`Invalid cell reference ${token.value}`, token.start);
+&nbsp;
+    if (this.peek().type !== 'colon') return { type: 'ref', ref: start };
+&nbsp;
+    this.position++;
+    const endToken = this.next();
+    if (endToken.type !== 'cell') {
+      throw new FormulaSyntaxError(`Expected a cell reference after ':'`, endToken.start);
+    }
+    const end = parseCellRef(endToken.value);
+    if (!end) {
+      throw new FormulaSyntaxError(`Invalid cell reference ${endToken.value}`, endToken.start);
+    }
+    return { type: 'range', range: makeRange(start, end) };
+  }
+&nbsp;
+  private parseArguments(): Node[] {
+    const args: Node[] = [];
+    if (this.peek().type === 'rparen') {
+      this.position++;
+      return args;
+    }
+    for (;;) {
+      args.push(this.parseComparison());
+      const token = this.next();
+      if (token.type === 'rparen') return args;
+      if (token.type !== 'comma') {
+        throw new FormulaSyntaxError(`Expected ',' or ')' but found ${describe(token)}`, token.start);
+      }
+    }
+  }
+&nbsp;
+  private expect(type: Token['type']): Token {
+    const token = this.next();
+    if (token.type !== type) {
+      throw new FormulaSyntaxError(`Expected ${type} but found ${describe(token)}`, token.start);
+    }
+    return token;
+  }
+}
+&nbsp;
+function describe(token: Token): string {
+  return token.type === 'eof' ? 'end of formula' : `${JSON.stringify(token.value)}`;
+}
+&nbsp;
+/**
+ * Parses formula text *without* the leading `=`.
+ *
+ * @throws {FormulaSyntaxError} if the text is not a well-formed expression.
+ */
+export function parseFormula(source: string): Node {
+  if (source.trim() === '') throw new FormulaSyntaxError('Empty formula', 0);
+  return new Parser(source).parse();
+}
