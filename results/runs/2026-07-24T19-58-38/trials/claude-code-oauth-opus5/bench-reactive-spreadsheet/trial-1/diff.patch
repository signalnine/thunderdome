+import { describe, expect, it } from 'vitest';
+
+import { InvalidCellReferenceError } from '../errors.js';
+import {
+  columnToIndex,
+  indexToColumn,
+  iterateRange,
+  makeCellRef,
+  makeRange,
+  parseCellRef,
+  rangeContains,
+  rangeSize,
+  requireCellRef,
+} from '../reference.js';
+
+describe('column names', () => {
+  it('maps single letters to 1-based indices', () => {
+    expect(columnToIndex('A')).toBe(1);
+    expect(columnToIndex('B')).toBe(2);
+    expect(columnToIndex('Z')).toBe(26);
+  });
+
+  it('continues into multi-letter columns', () => {
+    expect(columnToIndex('AA')).toBe(27);
+    expect(columnToIndex('AZ')).toBe(52);
+    expect(columnToIndex('BA')).toBe(53);
+    expect(columnToIndex('ZZ')).toBe(702);
+    expect(columnToIndex('AAA')).toBe(703);
+  });
+
+  it('is case-insensitive', () => {
+    expect(columnToIndex('aa')).toBe(columnToIndex('AA'));
+  });
+
+  it('round-trips through indexToColumn', () => {
+    for (const name of ['A', 'M', 'Z', 'AA', 'AB', 'AZ', 'BA', 'ZZ', 'AAA', 'XFD']) {
+      expect(indexToColumn(columnToIndex(name))).toBe(name);
+    }
+  });
+});
+
+describe('parseCellRef', () => {
+  it('parses column/row pairs', () => {
+    expect(parseCellRef('A1')).toEqual({ col: 1, row: 1, key: 'A1' });
+    expect(parseCellRef('B2')).toEqual({ col: 2, row: 2, key: 'B2' });
+    expect(parseCellRef('Z100')).toEqual({ col: 26, row: 100, key: 'Z100' });
+    expect(parseCellRef('AA1')).toEqual({ col: 27, row: 1, key: 'AA1' });
+  });
+
+  it('normalizes case and surrounding whitespace', () => {
+    expect(parseCellRef('  b7 ')?.key).toBe('B7');
+  });
+
+  it('accepts and ignores absolute markers', () => {
+    expect(parseCellRef('$A$1')?.key).toBe('A1');
+    expect(parseCellRef('$C5')?.key).toBe('C5');
+  });
+
+  it('rejects malformed and out-of-range references', () => {
+    for (const text of ['', 'A', '1', 'A0', '1A', 'A1B', 'A 1', 'A-1', 'A1.5', 'XFE1']) {
+      expect(parseCellRef(text)).toBeNull();
+    }
+  });
+
+  it('throws from requireCellRef instead of returning null', () => {
+    expect(() => requireCellRef('nope')).toThrow(InvalidCellReferenceError);
+    expect(requireCellRef('c3').key).toBe('C3');
+  });
+});
+
+describe('ranges', () => {
+  it('normalizes reversed corners', () => {
+    const forward = makeRange(makeCellRef(1, 1), makeCellRef(1, 5));
+    const backward = makeRange(makeCellRef(1, 5), makeCellRef(1, 1));
+    expect(backward).toEqual(forward);
+    expect(forward.key).toBe('A1:A5');
+  });
+
+  it('reports containment and size', () => {
