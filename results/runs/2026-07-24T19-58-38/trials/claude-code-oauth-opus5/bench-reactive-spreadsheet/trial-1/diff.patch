+<span class="cline-any cline-neutral">&nbsp;</span></td><td class="text"><pre class="prettyprint lang-js">/**
+ * Formula evaluation.
+ *
+ * The evaluator is pure with respect to the sheet: it reads cell values through
+ * an {@link EvaluationContext} and never writes. Recomputation order is the
+ * engine's concern (see `spreadsheet.ts`), so by the time a formula is
+ * evaluated every cell it reads already holds a fresh value.
+ */
+&nbsp;
+import type { Node } from './ast.js';
+import { CellError, isCellError } from './errors.js';
+import type { CellRef, RangeRef } from './reference.js';
+import {
+  checkNumericResult,
+  compareValues,
+  toNumber,
+  toText,
+  type CellValue,
+} from './values.js';
+import { FUNCTIONS } from './functions.js';
+&nbsp;
+/** Read-only view of the sheet, supplied by the engine. */
+export interface EvaluationContext {
+  /** Current value of a cell, or `null` when the cell is empty. */
+  getCellValue(ref: CellRef): CellValue | null;
+  /** Values of the non-empty cells in a range, in reading order. */
+  getRangeValues(range: RangeRef): CellValue[];
+}
+&nbsp;
+/** What built-in functions are handed so they can evaluate arguments lazily. */
+export interface FunctionContext {
+  /** Evaluates an argument; `null` means it resolved to an empty cell. */
+  evaluate(node: Node): CellValue | null;
+  /** Expands an argument to a list of values, flattening ranges. */
+  expand(node: Node): (CellValue | null)[];
+}
+&nbsp;
+/**
+ * Evaluates a parsed formula.
+ *
