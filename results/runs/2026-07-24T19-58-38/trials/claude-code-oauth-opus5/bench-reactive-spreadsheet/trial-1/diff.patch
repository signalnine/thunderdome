+<span class="cline-any cline-neutral">&nbsp;</span></td><td class="text"><pre class="prettyprint lang-js">/** Converts formula text into a flat token stream for the parser. */
+&nbsp;
+import { FormulaSyntaxError } from './errors.js';
+&nbsp;
+export type TokenType =
+  | 'number'
+  | 'string'
+  | 'identifier'
+  | 'cell'
+  | 'operator'
+  | 'lparen'
+  | 'rparen'
+  | 'comma'
+  | 'colon'
+  | 'eof';
+&nbsp;
+export interface Token {
+  readonly type: TokenType;
+  /** Raw text for most tokens; the decoded contents for string literals. */
+  readonly value: string;
+  /** Offset of the token's first character in the source text. */
+  readonly start: number;
+}
+&nbsp;
+const OPERATORS = ['&lt;&gt;', '&gt;=', '&lt;=', '+', '-', '*', '/', '^', '&amp;', '=', '&gt;', '&lt;'];
+&nbsp;
+function isDigit(ch: string): boolean {
+  return ch &gt;= '0' &amp;&amp; ch &lt;= '9';
+}
+&nbsp;
+function isLetter(ch: string): boolean {
+  return (ch &gt;= 'A' &amp;&amp; ch &lt;= 'Z') || (ch &gt;= 'a' &amp;&amp; ch &lt;= 'z');
+}
+&nbsp;
+/** True for a word that looks like `A1` / `$B$2` rather than a function name. */
+function looksLikeCell(word: string): boolean {
+  return /^\$?[A-Za-z]+\$?[0-9]+$/.test(word);
+}
+&nbsp;
+export function tokenize(source: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+&nbsp;
+  while (i &lt; source.length) {
+    const ch = source[i];
+&nbsp;
+    if (ch === ' ' || ch === '\t' || ch === '\n' || ch === '\r') {
+      i++;
+      continue;
+    }
+&nbsp;
+    if (ch === '(') {
+      tokens.push({ type: 'lparen', value: ch, start: i++ });
+      continue;
+    }
+    if (ch === ')') {
+      tokens.push({ type: 'rparen', value: ch, start: i++ });
+      continue;
+    }
+    if (ch === ',' || ch === ';') {
+      tokens.push({ type: 'comma', value: ch, start: i++ });
+      continue;
+    }
+    if (ch === ':') {
+      tokens.push({ type: 'colon', value: ch, start: i++ });
+      continue;
+    }
+&nbsp;
+    if (ch === '"') {
+      const start = i;
+      i++;
+      let text = '';
+      let closed = false;
+      while (i &lt; source.length) {
+        if (source[i] === '"') {
+          // A doubled quote is an escaped quote, otherwise the string ends.
+          if (source[i + 1] === '"') {
+            text += '"';
+            i += 2;
+            continue;
+          }
+          i++;
+          closed = true;
+          break;
+        }
+        text += source[i++];
+      }
+      if (!closed) throw new FormulaSyntaxError('Unterminated string literal', start);
+      tokens.push({ type: 'string', value: text, start });
+      continue;
+    }
+&nbsp;
+    // A number may start with a digit or a bare decimal point (`.5`).
+    if (isDigit(ch) || (ch === '.' &amp;&amp; isDigit(source[i + 1<span class="branch-0 cbranch-no" title="branch not covered" >] ?? '')</span>)) {
+      const start = i;
+      while (i &lt; source.length &amp;&amp; isDigit(source[i])) i++;
+      if (source[i] === '.') {
+        i++;
+        while (i &lt; source.length &amp;&amp; isDigit(source[i])) i++;
+      }
+      // Scientific notation, but only when an exponent digit actually follows;
+      // otherwise the `E` belongs to a following name.
+      if (source[i] === 'e' || source[i] === 'E') {
+        const afterSign = source[i + 1] === '+' || source[i + 1] === '-' ? i + 2 : i + 1;
+        if (isDigit(source[afterSign<span class="branch-0 cbranch-no" title="branch not covered" >] ?? '')</span>) {
+          i = afterSign;
+          while (i &lt; source.length &amp;&amp; isDigit(source[i])) i++;
+        }
+      }
+      const text = source.slice(start, i);
+      const value = Number(text);
+      if (!Number.isFinite(value)) <span class="branch-0 cbranch-no" title="branch not covered" >throw new FormulaSyntaxError(`Invalid number: ${text}`, start);</span>
+      tokens.push({ type: 'number', value: text, start });
+      continue;
+    }
+&nbsp;
+    if (isLetter(ch) || ch === '$' || ch === '_') {
+      const start = i;
+      while (i &lt; source.length &amp;&amp; (isLetter(source[i]) || isDigit(source[i]) || '$_.'.includes(source[i]))) {
+        i++;
+      }
+      const word = source.slice(start, i);
+      tokens.push({ type: looksLikeCell(word) ? 'cell' : 'identifier', value: word, start });
+      continue;
+    }
+&nbsp;
+    const operator = OPERATORS.find((op) =&gt; source.startsWith(op, i));
+    if (operator) {
+      tokens.push({ type: 'operator', value: operator, start: i });
+      i += operator.length;
+      continue;
+    }
+&nbsp;
+    throw new FormulaSyntaxError(`Unexpected character ${JSON.stringify(ch)}`, i);
+  }
+&nbsp;
+  tokens.push({ type: 'eof', value: '', start: source.length });
+  return tokens;
+}
