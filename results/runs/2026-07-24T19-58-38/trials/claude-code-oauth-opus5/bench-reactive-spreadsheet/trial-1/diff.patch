readsheet();\n    sheet.set('A1', '=0*-1');\n    expect(sheet.getDisplay('A1')).toBe('0');\n  });\n\n  it('formats each value type', () => {\n    expect(formatValue(null)).toBe('');\n    expect(formatValue('text')).toBe('text');\n    expect(formatValue(true)).toBe('true');\n    expect(formatValue(new CellError('#REF!'))).toBe('#REF!');\n  });\n});\n\ndescribe('coercion helpers', () => {\n  it('converts what a spreadsheet would convert', () => {\n    expect(toNumber(null)).toBe(0);\n    expect(toNumber('')).toBe(0);\n    expect(toNumber('  7 ')).toBe(7);\n    expect(toNumber(true)).toBe(1);\n    expect(toNumber(false)).toBe(0);\n    expect(isCellError(toNumber('seven'))).toBe(true);\n  });\n\n  it('passes existing errors through untouched', () => {\n    const error = new CellError('#N/A');\n    expect(toNumber(error)).toBe(error);\n  });\n});\n\ndescribe('mixed-type comparison', () => {\n  it('orders numbers before text before booleans', () => {\n    expect(compareValues(1, 'a')).toBeLessThan(0);\n    expect(compareValues('a', true)).toBeLessThan(0);\n    expect(compareValues(true, 1)).toBeGreaterThan(0);\n    expect(compareValues(false, true)).toBeLessThan(0);\n    expect(compareValues(true, true)).toBe(0);\n  });\n\n  it('lets an empty cell take on the type it is compared with', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=Q9=FALSE');\n    sheet.set('A2', '=Q9=\"\"');\n    sheet.set('A3', '=Q9=0');\n\n    expect(sheet.get('A1')).toBe(true);\n    expect(sheet.get('A2')).toBe(true);\n    expect(sheet.get('A3')).toBe(true);\n  });\n\n  it('applies the same ordering inside formulas', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=1<\"a\"');\n    sheet.set('A2', '=\"a\"<TRUE');\n    sheet.set('A3', '=TRUE>1');\n\n    expect(sheet.get('A1')).toBe(true);\n    expect(sheet.get('A2')).toBe(true);\n    expect(sheet.get('A3')).toBe(true);\n  });\n});\n\ndescribe('reference limits', () => {\n  it('rejects rows and columns beyond the supported grid', () => {\n    expect(parseCellRef('A1048576')?.key).toBe('A1048576');\n    expect(parseCellRef('A1048577')).toBeNull();\n    expect(parseCellRef('XFD1')?.key).toBe('XFD1');\n    expect(parseCellRef('XFE1')).toBeNull();\n  });\n\n  it('refuses to name a column below A', () => {\n    expect(() => indexToColumn(0)).toThrow(RangeError);\n    expect(() => indexToColumn(1.5)).toThrow(RangeError);\n  });\n});\n\ndescribe('malformed formulas', () => {\n  let sheet: Spreadsheet;\n  beforeEach(() => {\n    sheet = new Spreadsheet();\n  });\n\n  const cases: Array<[string, string]> = [\n    ['unexpected character', '=1 # 2'],\n    ['range missing its end', '=SUM(A1:)'],\n    ['range ending in a non-cell', '=SUM(A1:5)'],\n    ['bare name that is not a function', '=TOTAL'],\n    ['function without parentheses', '=SUM A1'],\n    ['stray closing parenthesis', '=(1+2))'],\n    ['missing operand', '=1*'],\n    ['empty formula', '='],\n  ];\n\n  it.each(cases)('stores #ERROR! for a %s', (_label, formula) => {\n    sheet.set('A1', formula);\n    expect(sheet.get('A1')).toBe('#ERROR!');\n  });\n\n  it('does not poison neighbouring cells', () => {\n    sheet.set('A1', 5);\n    sheet.set('A2', '=this is not a formula');\n    sheet.set('A3', '=A1*2');\n\n    expect(sheet.get('A2')).toBe('#ERROR!');\n    expect(sheet.get('A3')).toBe(10);\n  });\n\n  it('recovers when the formula is corrected', () => {\n    sheet.set('A1', 5);\n    sheet.set('B1', '=A1+');\n    expect(sheet.get('B1')).toBe('#ERROR!');\n\n    sheet.set('B1', '=A1+1');\n    expect(sheet.get('B1')).toBe(6);\n\n    sheet.set('A1', 10);\n    expect(sheet.get('B1')).toBe(11);\n  });\n});\n\ndescribe('aggregate arguments', () => {\n  let sheet: Spreadsheet;\n  beforeEach(() => {\n    sheet = new Spreadsheet();\n  });\n\n  it('coerces literal arguments but skips values found in the sheet', () => {\n    sheet.set('A1', 'text');\n    sheet.set('A2', true);\n    sheet.set('B1', '=SUM(A1:A2)');\n    sheet.set('B2', '=