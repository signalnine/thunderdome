+++ b/src/evaluator.ts
@@ -0,0 +1,157 @@
+/**
+ * Formula evaluation.
+ *
+ * The evaluator is pure with respect to the sheet: it reads cell values through
+ * an {@link EvaluationContext} and never writes. Recomputation order is the
+ * engine's concern (see `spreadsheet.ts`), so by the time a formula is
+ * evaluated every cell it reads already holds a fresh value.
+ */
+
+import type { Node } from './ast.js';
+import { CellError, isCellError } from './errors.js';
+import type { CellRef, RangeRef } from './reference.js';
+import {
+  checkNumericResult,
+  compareValues,
+  toNumber,
+  toText,
+  type CellValue,
+} from './values.js';
+import { FUNCTIONS } from './functions.js';
+
+/** Read-only view of the sheet, supplied by the engine. */
+export interface EvaluationContext {
+  /** Current value of a cell, or `null` when the cell is empty. */
+  getCellValue(ref: CellRef): CellValue | null;
+  /** Values of the non-empty cells in a range, in reading order. */
+  getRangeValues(range: RangeRef): CellValue[];
+}
+
+/** What built-in functions are handed so they can evaluate arguments lazily. */
+export interface FunctionContext {
+  /** Evaluates an argument; `null` means it resolved to an empty cell. */
+  evaluate(node: Node): CellValue | null;
+  /** Expands an argument to a list of values, flattening ranges. */
+  expand(node: Node): (CellValue | null)[];
+}
+
+/**
+ * Evaluates a parsed formula.
+ *
+ * @returns the computed value; a {@link CellError} if the formula fails. Never
+ *   returns `null` — a formula whose result is an empty cell yields `0`, as in
+ *   a real spreadsheet.
+ */
+export function evaluate(node: Node, context: EvaluationContext): CellValue {
+  return evaluateNode(node, context) ?? 0;
+}
+
+function evaluateNode(node: Node, context: EvaluationContext): CellValue | null {
+  switch (node.type) {
+    case 'number':
+    case 'string':
+    case 'boolean':
+      return node.value;
+
+    case 'ref':
+      return context.getCellValue(node.ref);
+
+    case 'range':
+      // A range is only meaningful as a function argument; used as a value it
+      // has no single result.
+      return new CellError('#VALUE!', `Range ${node.range.key} used as a single value`);
+
+    case 'unary': {
+      const operand = toNumber(evaluateNode(node.operand, context));
+      if (isCellError(operand)) return operand;
+      return node.operator === '-' ? checkNumericResult(-operand) : operand;
+    }
+
+    case 'binary':
+      return evaluateBinary(node.operator, node.left, node.right, context);
+
+    case 'call':
+      return evaluateCall(node.name, node.args, context);
+  }
+}
+
+function evaluateBinary(
+  operator: string,
+  leftNode: Node,
+  rightNode: Node,
+  context: EvaluationContext,
+): CellValue {
+  const left = evaluateNode(leftNode, context);
+  const right = evaluateNode(rightNode, context);
+
+  if (operator === '&') {
+    const a = toText(left);
+    if (isCellError(a)) return a;
+    const b = toText(right);
+    if (isCellError(b)) return b;
+    return a + b;
+  }
+
+  if (isComparison(operator)) {
+    // Errors win over comparison: `#DIV/0! > 1` is still an error.
+    if (isCellError(left)) return left;
+    if (isCellError(right)) return right;
+    const order = compareValues(left, right);
+    switch (operator) {
+      case '=':
+        return order === 0;
+      case '<>':
+        return order !== 0;
+      case '>':
+        return order > 0;
+      case '<':
+        return order < 0;
+      case '>=':
+        return order >= 0;
+      default:
+        return order <= 0;
+    }
+  }
+
+  const a = toNumber(left);
+  if (isCellError(a)) return a;
+  const b = toNumber(right);
+  if (isCellError(b)) return b;
+
+  switch (operator) {
+    case '+':
+      return checkNumericResult(a + b);
+    case '-':
+      return checkNumericResult(a - b);
+    case '*':
+      return checkNumericResult(a * b);
+    case '/':
+      if (b === 0) return new CellError('#DIV/0!', 'Division by zero');
+      return checkNumericResult(a / b);
+    case '^':
+      return checkNumericResult(a ** b);
+    default:
+      return new CellError('#ERROR!', `Unknown operator ${operator}`);
+  }
+}
+
+function isComparison(operator: string): boolean {
+  return operator === '=' || operator === '<>' || operator === '>' || operator === '<' || operator === '>=' || operator === '<=';
+}
+
+function evaluateCall(
+  name: string,
+  args: readonly Node[],
+  context: EvaluationContext,
+): CellValue {
+  const implementation = FUNCTIONS[name];
+  if (!implementation) return new CellError('#NAME?', `Unknown function ${name}`);
+
+  const functionContext: FunctionContext = {
+    evaluate: (node) => evaluateNode(node, context),
+    expand: (node) =>
+      node.type === 'range' ? context.getRangeValues(node.range) : [evaluateNode(node, context)],
+  };
+
+  return implementation(args, functionContext);
+}
