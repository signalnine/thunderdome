+/**
+ * A reactive spreadsheet engine.
+ *
+ * ```ts
+ * const sheet = new Spreadsheet();
+ * sheet.set('A1', 10);
+ * sheet.set('A2', 20);
+ * sheet.set('A3', '=A1+A2');
+ * sheet.get('A3');        // 30
+ * sheet.set('A1', 50);
+ * sheet.get('A3');        // 70 — recomputed automatically
+ * ```
+ */
+
+import { Spreadsheet } from './spreadsheet.js';
+
+export { Spreadsheet };
+
+export {
+  CellError,
+  CircularReferenceError,
+  FormulaSyntaxError,
+  InvalidCellReferenceError,
+  isCellError,
+  type ErrorCode,
+} from './errors.js';
+
+export type { CellInput, CellValue, PublicCellValue } from './values.js';
+export type { CellRef, RangeRef } from './reference.js';
+
+export default Spreadsheet;
