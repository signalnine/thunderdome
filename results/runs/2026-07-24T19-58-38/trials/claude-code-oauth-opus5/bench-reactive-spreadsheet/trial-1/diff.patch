@@ -0,0 +1,271 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+
+import { Spreadsheet } from '../index.js';
+
+describe('arithmetic', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  /** Evaluates a formula in a scratch cell and returns its value. */
+  const evaluate = (formula: string) => {
+    sheet.set('Z1', formula);
+    return sheet.get('Z1');
+  };
+
+  it('applies the four operators', () => {
+    expect(evaluate('=2+3')).toBe(5);
+    expect(evaluate('=7-2')).toBe(5);
+    expect(evaluate('=6*7')).toBe(42);
+    expect(evaluate('=10/4')).toBe(2.5);
+  });
+
+  it('respects operator precedence', () => {
+    expect(evaluate('=2+3*4')).toBe(14);
+    expect(evaluate('=2*3+4')).toBe(10);
+    expect(evaluate('=10-2-3')).toBe(5);
+    expect(evaluate('=100/10/2')).toBe(5);
+    expect(evaluate('=1+2*3-4/2')).toBe(5);
+  });
+
+  it('groups with parentheses', () => {
+    expect(evaluate('=(2+3)*4')).toBe(20);
+    expect(evaluate('=2*(3+(4-1))')).toBe(12);
+    expect(evaluate('=((((5))))')).toBe(5);
+  });
+
+  it('handles unary signs', () => {
+    expect(evaluate('=-5')).toBe(-5);
+    expect(evaluate('=+5')).toBe(5);
+    expect(evaluate('=3 - -2')).toBe(5);
+    expect(evaluate('=-(2+3)')).toBe(-5);
+    expect(evaluate('=--7')).toBe(7);
+  });
+
+  it('parses decimals and scientific notation', () => {
+    expect(evaluate('=3.14')).toBe(3.14);
+    expect(evaluate('=.5+.25')).toBe(0.75);
+    expect(evaluate('=1e3')).toBe(1000);
+    expect(evaluate('=1.5e-2')).toBe(0.015);
+  });
+
+  it('ignores whitespace', () => {
+    expect(evaluate('=  1   +   2  ')).toBe(3);
+  });
+
+  it('raises to a power with ^', () => {
+    expect(evaluate('=2^10')).toBe(1024);
+    expect(evaluate('=2^3^2')).toBe(512); // right-associative
+  });
+});
+
+describe('cell references in formulas', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('B2', 4);
+  });
+
+  it('reads other cells', () => {
+    sheet.set('C1', '=A1');
+    sheet.set('C2', '=A1+B2');
+    sheet.set('C3', '=(A1+B2)*2');
+
+    expect(sheet.get('C1')).toBe(10);
+    expect(sheet.get('C2')).toBe(14);
+    expect(sheet.get('C3')).toBe(28);
+  });
+
+  it('reads far-away and multi-letter columns', () => {
+    sheet.set('AA100', 7);
+    sheet.set('D1', '=AA100*2');
+    expect(sheet.get('D1')).toBe(14);
+  });
+
+  it('treats a reference to an empty cell as zero', () => {
+    sheet.set('C1', '=A1+Q9');
+    expect(sheet.get('C1')).toBe(10);
+  });
+
+  it('chains formulas that reference other formulas', () => {
+    sheet.set('C1', '=A1*2');
+    sheet.set('C2', '=C1+B2');
+    sheet.set('C3', '=C2/2');
+
+    expect(sheet.get('C3')).toBe(12);
+  });
+});
+
+describe('value coercion', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('treats booleans as 1 and 0 in arithmetic', () => {
+    sheet.set('A1', true);
+    sheet.set('A2', false);
+    sheet.set('B1', '=A1+A2');
+    sheet.set('B2', '=A1*10');
+
+    expect(sheet.get('B1')).toBe(1);
+    expect(sheet.get('B2')).toBe(10);
+  });
+
+  it('parses numeric text', () => {
+    sheet.set('A1', '5');
+    sheet.set('B1', '=A1*2');
+    expect(sheet.get('B1')).toBe(10);
+  });
+
+  it('fails on text that is not a number', () => {
+    sheet.set('A1', 'hello');
+    sheet.set('B1', '=A1+1');
+    expect(sheet.get('B1')).toBe('#VALUE!');
+  });
+});
+
+describe('comparisons', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+  });
+
+  const evaluate = (formula: string) => {
+    sheet.set('Z1', formula);
+    return sheet.get('Z1');
+  };
+
+  it('compares numbers', () => {
+    expect(evaluate('=A1<A2')).toBe(true);
+    expect(evaluate('=A1>A2')).toBe(false);
+    expect(evaluate('=A1<=10')).toBe(true);
+    expect(evaluate('=A1>=11')).toBe(false);
+    expect(evaluate('=A1=10')).toBe(true);
+    expect(evaluate('=A1<>10')).toBe(false);
+  });
+
+  it('compares text lexicographically', () => {
+    expect(evaluate('="apple"<"banana"')).toBe(true);
+    expect(evaluate('="a"="a"')).toBe(true);
+    expect(evaluate('="a"<>"b"')).toBe(true);
+  });
+
+  it('binds looser than arithmetic', () => {
+    expect(evaluate('=1+1=2')).toBe(true);
+    expect(evaluate('=A1*2>A2-1')).toBe(true);
+  });
+
+  it('compares an empty cell as zero or as empty text', () => {
+    expect(evaluate('=Q9=0')).toBe(true);
+    expect(evaluate('=Q9=""')).toBe(true);
+    expect(evaluate('=Q9<1')).toBe(true);
+  });
+});
+
+describe('text concatenation', () => {
+  it('joins values with &', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 'Hello');
+    sheet.set('A2', 'World');
+    sheet.set('A3', '=A1&" "&A2');
+    sheet.set('A4', 1);
+    sheet.set('A5', '=A4&"/"&2');
+
+    expect(sheet.get('A3')).toBe('Hello World');
+    expect(sheet.get('A5')).toBe('1/2');
+  });
+});
+
+describe('string literals', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('are returned verbatim', () => {
+    sheet.set('A1', '="text"');
+    expect(sheet.get('A1')).toBe('text');
+  });
+
+  it('support doubled quotes as an escape', () => {
+    sheet.set('A1', '="say ""hi"""');
+    expect(sheet.get('A1')).toBe('say "hi"');
+  });
+
+  it('may be empty', () => {
+    sheet.set('A1', '=""');
+    expect(sheet.get('A1')).toBe('');
+  });
+});
+
+describe('boolean literals', () => {
+  it('are recognized in any case', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=TRUE');
+    sheet.set('A2', '=false');
+    sheet.set('A3', '=TRUE()');
+
+    expect(sheet.get('A1')).toBe(true);
+    expect(sheet.get('A2')).toBe(false);
+    expect(sheet.get('A3')).toBe(true);
+  });
+});
+
+describe('formula errors', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('reports division by zero', () => {
+    sheet.set('A1', 0);
+    sheet.set('B1', '=1/A1');
+    expect(sheet.get('B1')).toBe('#DIV/0!');
+  });
+
+  it('reports unknown functions', () => {
+    sheet.set('A1', '=NOSUCHFUNC(1)');
+    expect(sheet.get('A1')).toBe('#NAME?');
+  });
+
+  it('reports a range used as a single value', () => {
+    sheet.set('A1', '=A2:A3+1');
+    expect(sheet.get('A1')).toBe('#VALUE!');
+  });
+
+  it('reports overflow to infinity', () => {
+    sheet.set('A1', '=1e308*10');
+    expect(sheet.get('A1')).toBe('#NUM!');
+  });
+
+  it('keeps malformed formulas as #ERROR! rather than throwing', () => {
+    for (const formula of ['=1+', '=(1+2', '=*3', '="unterminated', '=', '=SUM(1,)']) {
+      expect(() => sheet.set('A1', formula)).not.toThrow();
+      expect(sheet.get('A1')).toBe('#ERROR!');
+      expect(sheet.getRaw('A1')).toBe(formula);
+    }
+  });
+
+  it('propagates errors through dependent formulas', () => {
+    sheet.set('A1', '=1/0');
+    sheet.set('B1', '=A1+1');
+    sheet.set('C1', '=B1*2');
+
+    expect(sheet.get('B1')).toBe('#DIV/0!');
+    expect(sheet.get('C1')).toBe('#DIV/0!');
+  });
+
+  it('clears the error once the cause is fixed', () => {
+    sheet.set('A1', 0);
+    sheet.set('B1', '=10/A1');
+    expect(sheet.get('B1')).toBe('#DIV/0!');
+
+    sheet.set('A1', 2);
+    expect(sheet.get('B1')).toBe(5);
+  });
+});
