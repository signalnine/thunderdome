+<span class="cline-any cline-neutral">&nbsp;</span></td><td class="text"><pre class="prettyprint lang-js">/** Cell value representation, coercion rules, and display formatting. */
+&nbsp;
+import { CellError, isCellError } from './errors.js';
+&nbsp;
+/** What a cell can hold once computed. Empty cells are represented by `null`. */
+export type CellValue = number | string | boolean | CellError;
+&nbsp;
+/** The public-facing form of a value: errors become their code strings. */
+export type PublicCellValue = number | string | boolean | null;
+&nbsp;
+/** Values accepted by `Spreadsheet.set`. */
+export type CellInput = string | number | boolean;
+&nbsp;
+export function toPublicValue(value: CellValue | null): PublicCellValue {
+  if (value === null) return null;
+  return isCellError(value) ? value.code : value;
+}
+&nbsp;
+/**
+ * Coerces a value to a number for arithmetic.
+ *
+ * Empty cells are 0, booleans are 1/0, and numeric strings are parsed — all
+ * following spreadsheet conventions. Anything else yields `#VALUE!`.
+ */
+export function toNumber(value: CellValue | null): number | CellError {
+  if (value === null) return 0;
+  if (isCellError(value)) return value;
+  if (typeof value === 'number') return value;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+&nbsp;
+  const text = value.trim();
+  if (text === '') return 0;
+  const parsed = Number(text);
+  if (!Number.isFinite(parsed)) {
+    return new CellError('#VALUE!', `Cannot convert ${JSON.stringify(value)} to a number`);
+  }
+  return parsed;
+}
+&nbsp;
+/**
+ * Coerces a value to a boolean for conditions.
+ *
+ * Numbers use the "non-zero is true" rule; text has no truthiness and yields
+ * `#VALUE!`, as in Excel.
+ */
+export function toBoolean(value: CellValue | null): boolean | CellError {
+  if (value === null) <span class="branch-0 cbranch-no" title="branch not covered" >return false;</span>
+  if (isCellError(value)) return value;
+  if (typeof value === 'boolean') return value;
+  if (typeof value === 'number') return value !== 0;
+  return new CellError('#VALUE!', `Cannot convert ${JSON.stringify(value)} to a boolean`);
+}
+&nbsp;
+/** Coerces a value to text for `&amp;` concatenation. */
+export function toText(value: CellValue | null): string | CellError {
+  if (value === null) <span class="branch-0 cbranch-no" title="branch not covered" >return '';</span>
+  if (isCellError(value)) <span class="branch-0 cbranch-no" title="branch not covered" >return value;</span>
+  return formatValue(value);
+}
+&nbsp;
+/**
+ * Guards against arithmetic that leaves the real numbers (overflow to
+ * `Infinity`, or `NaN` from something like `0^-1`).
+ */
+export function checkNumericResult(value: number): number | CellError {
+  if (!Number.isFinite(value)) {
+    return new CellError('#NUM!', 'Result is not a finite number');
+  }
+  return value;
+}
+&nbsp;
+/**
+ * Renders a number the way a spreadsheet would: full precision, minus the
+ * artifacts of binary floating point. `0.1 + 0.2` displays as `0.3` even
+ * though the stored value is `0.30000000000000004`.
+ */
+export function formatNumber(value: number): string {
+  if (Number.isNaN(value)) <span class="branch-0 cbranch-no" title="branch not covered" >return '#NUM!';</span>
+  if (!Number.isFinite(value)) <span class="branch-0 cbranch-no" title="branch not covered" >return value &gt; 0 ? 'Infinity' : '-Infinity';</span>
+  if (Number.isInteger(value)) {
+    // `-0` should read as `0`.
+    return String(value === 0 ? 0 : value);
+  }
+  // 15 significant digits round-trips through double precision while dropping
+  // the trailing noise that 17 digits would expose.
+  return String(Number(value.toPrecision(15)));
+}
+&nbsp;
+/** Display string for a computed value; empty cells render as `''`. */
+export function formatValue(value: CellValue | null): string {
+  if (value === null) return '';
+  if (isCellError(value)) return value.code;
+  if (typeof value === 'number') return formatNumber(value);
+  if (typeof value === 'boolean') return value ? 'true' : 'false';
+  return value;
+}
+&nbsp;
+/**
+ * Orders two values for comparison operators. Types never mix in a spreadsheet:
+ * numbers sort before text, which sorts before booleans.
+ *
+ * @returns a negative number, zero, or a positive number, like a comparator.
+ */
+export function compareValues(left: CellValue | null, right: CellValue | null): number {
+  const leftRank = typeRank(left);
+  const rightRank = typeRank(right);
+&nbsp;
+  if (leftRank !== rightRank) {
+    // An empty cell takes on the type of the value it is compared against,
+    // behaving as 0 / '' / false rather than as its own category.
+    if (left === null) return compareValues(emptyAs(rightRank), right);
+    if (right === null) <span class="branch-0 cbranch-no" title="branch not covered" >return compareValues(left, emptyAs(leftRank));</span>
+    return leftRank - rightRank;
+  }
+&nbsp;
+  switch (leftRank) {
+    case 0:
+      return (left as number) - (right as number);
+    case 1: {
+      const a = left as string;
+      const b = right as string;
+      return a &lt; b ? -1 : a &gt; <span class="branch-0 cbranch-no" title="branch not covered" >b ? 1 : 0</span>;
+    }
+    default:
+      return Number(left as boolean) - Number(right as boolean);
+  }
+}
+&nbsp;
+function typeRank(value: CellValue | null): number {
+  if (value === null) return 0;
+  if (typeof value === 'number') return 0;
+  if (typeof value === 'string') return 1;
+  return 2;
+}
+&nbsp;
+function emptyAs(rank: number): CellValue {
+  if (rank === 1) return '';
+  if (rank === 2) return <span class="branch-0 cbranch-no" title="branch not covered" >false;</span>
+<span class="cstat-no" title="statement not covered" >  return 0;</span>
+<span class="cstat-no" title="statement not covered" >}</span>
