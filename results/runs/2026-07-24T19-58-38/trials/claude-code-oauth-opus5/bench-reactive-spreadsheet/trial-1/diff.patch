UM(A1:A5)');\n  });\n\n  it('recomputes when a cell inside the range changes', () => {\n    expect(sheet.get('B1')).toBe(3);\n    sheet.set('A1', 10);\n    expect(sheet.get('B1')).toBe(12);\n  });\n\n  it('recomputes when a cell is added to a previously empty part of the range', () => {\n    sheet.set('A5', 100);\n    expect(sheet.get('B1')).toBe(103);\n  });\n\n  it('recomputes when a cell inside the range is cleared', () => {\n    sheet.clear('A2');\n    expect(sheet.get('B1')).toBe(1);\n  });\n\n  it('ignores changes outside the range', () => {\n    sheet.set('A6', 1000);\n    sheet.set('C1', 1000);\n    expect(sheet.get('B1')).toBe(3);\n  });\n\n  it('follows a formula that moves to a different range', () => {\n    sheet.set('D1', 50);\n    sheet.set('B1', '=SUM(D1:D5)');\n    expect(sheet.get('B1')).toBe(50);\n\n    // A1 is no longer read, so changing it must not disturb B1.\n    sheet.set('A1', 999);\n    expect(sheet.get('B1')).toBe(50);\n\n    sheet.set('D2', 5);\n    expect(sheet.get('B1')).toBe(55);\n  });\n\n  it('updates through a chain of range formulas', () => {\n    sheet.set('C1', '=B1*2');\n    sheet.set('D1', '=SUM(B1:C1)');\n\n    expect(sheet.get('D1')).toBe(9);\n    sheet.set('A1', 4);\n    expect(sheet.get('B1')).toBe(6);\n    expect(sheet.get('C1')).toBe(12);\n    expect(sheet.get('D1')).toBe(18);\n  });\n});\n\ndescribe('large ranges', () => {\n  it('handles a range far larger than the populated area', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('ZZ5000', 2);\n    sheet.set('B1', '=SUM(A1:ZZ100000)');\n    sheet.set('B2', '=COUNT(A1:ZZ100000)');\n\n    expect(sheet.get('B1')).toBe(3);\n    expect(sheet.get('B2')).toBe(2);\n\n    sheet.set('M500', 10);\n    expect(sheet.get('B1')).toBe(13);\n  });\n\n  it('aggregates thousands of cells', () => {\n    const sheet = new Spreadsheet();\n    for (let row = 1; row <= 1000; row++) sheet.set(`A${row}`, row);\n    sheet.set('C1', '=SUM(A1:A1000)');\n    sheet