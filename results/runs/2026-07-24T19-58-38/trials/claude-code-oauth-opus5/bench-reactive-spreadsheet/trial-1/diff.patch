index 0000000..4e4017f
--- /dev/null
+++ b/src/errors.ts
@@ -0,0 +1,86 @@
+/**
+ * Error values and exceptions used by the spreadsheet engine.
+ *
+ * The engine distinguishes two failure modes:
+ *
+ * 1. **Error values** ({@link CellError}) — spreadsheet-style errors such as
+ *    `#DIV/0!`. These live *inside* cells, propagate through formulas that
+ *    reference them, and are surfaced to callers as their code string.
+ * 2. **Exceptions** — thrown from the public API for programming mistakes
+ *    (a malformed cell reference) or for the one condition the spec requires
+ *    us to reject outright: a circular dependency.
+ */
+
+/** Spreadsheet error codes, using the conventional `#NAME!` spellings. */
+export type ErrorCode =
+  | '#DIV/0!'
+  | '#VALUE!'
+  | '#NAME?'
+  | '#REF!'
+  | '#NUM!'
+  | '#N/A'
+  | '#ERROR!';
+
+/**
+ * An error *value*. Unlike a thrown exception this is a first-class cell value:
+ * it can be stored in a cell and propagates to any formula that reads it.
+ */
+export class CellError {
+  readonly code: ErrorCode;
+  /** Human-readable detail; never shown in the cell, useful when debugging. */
+  readonly detail: string | undefined;
+
+  constructor(code: ErrorCode, detail?: string) {
+    this.code = code;
+    this.detail = detail;
+  }
+
+  toString(): string {
+    return this.code;
+  }
+}
+
+export function isCellError(value: unknown): value is CellError {
+  return value instanceof CellError;
+}
+
+/** Thrown by `set` when the assignment would create a dependency cycle. */
+export class CircularReferenceError extends Error {
+  /** The cell that was being assigned when the cycle was detected. */
+  readonly cell: string;
+  /** The cycle, starting and ending at the same cell, e.g. `['A1','B1','A1']`. */
+  readonly cycle: readonly string[];
+
+  constructor(cell: string, cycle: readonly string[]) {
+    super(`Circular reference detected at ${cell}: ${cycle.join(' -> ')}`);
+    this.name = 'CircularReferenceError';
+    this.cell = cell;
+    this.cycle = cycle;
+  }
+}
+
+/** Thrown when a string that should name a cell (e.g. `"A1"`) does not. */
+export class InvalidCellReferenceError extends Error {
+  readonly reference: string;
+
+  constructor(reference: string) {
+    super(`Invalid cell reference: ${JSON.stringify(reference)}`);
+    this.name = 'InvalidCellReferenceError';
+    this.reference = reference;
+  }
+}
+
+/**
+ * Raised while tokenizing/parsing a formula. Never escapes the public API:
+ * `Spreadsheet.set` catches it and stores `#ERROR!` in the cell, matching how
+ * a spreadsheet keeps working after a bad formula is entered.
+ */
+export class FormulaSyntaxError extends Error {
+  readonly position: number;
+
+  constructor(message: string, position: number) {
+    super(message);
+    this.name = 'FormulaSyntaxError';
+    this.position = position;
+  }
+}
