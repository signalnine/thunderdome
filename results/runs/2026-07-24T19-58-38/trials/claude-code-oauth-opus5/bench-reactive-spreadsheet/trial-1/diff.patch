ls — text and\n * booleans sitting in the sheet are skipped rather than treated as errors.\n * Literal arguments (`SUM(1, TRUE, \"5\")`) are coerced, since writing them was\n * deliberate. Any error encountered propagates immediately.\n */\nfunction gatherNumbers(\n  args: readonly Node[],\n  context: FunctionContext,\n): number[] | CellError {\n  const numbers: number[] = [];\n\n  for (const arg of args) {\n    if (arg.type === 'range' || arg.type === 'ref') {\n      for (const value of context.expand(arg)) {\n        if (isCellError(value)) return value;\n        if (typeof value === 'number') numbers.push(value);\n      }\n      continue;\n    }\n\n    const value = context.evaluate(arg);\n    if (isCellError(value)) return value;\n    if (value === null) continue;\n    const number = toNumber(value);\n    if (isCellError(number)) return number;\n    numbers.push(number);\n  }\n\n  return numbers;\n}\n\nfunction requireArity(\n  name: string,\n  args: readonly Node[],\n  min: number,\n  max = Infinity,\n): CellError | null {\n  if (args.length < min || args.length > max) {\n    const expected = max === Infinity ? `at least ${min}` : min === max ? `${min}` : `${min}-${max}`;\n    return new CellError('#VALUE!', `${name} expects ${expected} argument(s), got ${args.length}`);\n  }\n  return null;\n}\n\n/** Builds an aggregate whose result is derived from the gathered numbers. */\nfunction aggregate(\n  name: string,\n  reduce: (numbers: number[]) => CellValue,\n): FunctionImplementation {\n  return (args, context) => {\n    const arityError = requireArity(name, args, 1);\n    if (arityError) return arityError;\n\n    const numbers = gatherNumbers(args, context);\n    if (isCellError(numbers)) return numbers;\n    return reduce(numbers);\n  };\n}\n\nexport const FUNCTIONS: Record<string, FunctionImplementation> = {\n  SUM: aggregate('SUM', (numbers) => numbers.reduce((total, n) => total + n, 0)),\n\n  AVERAGE: aggregate('AVERAGE', (numbers) => {\n    if (numbers.length === 0) {\n      return new CellError('#DIV/0!', 'AVERAGE of no numeric values');\n    }\n    return numbers.reduce((total, n) => total + n, 0) / numbers.length;\n  }),\n\n  // MIN/MAX of nothing is 0 by spreadsheet convention, not an error.\n  MIN: aggregate('MIN', (numbers) => (numbers.length === 0 ? 0 : Math.min(...numbers))),\n\n  MAX: aggregate('MAX', (numbers) => (numbers.length === 0 ? 0 : Math.max(...numbers))),\n\n  COUNT: aggregate('COUNT', (numbers) => numbers.length),\n\n  IF: (args, context) => {\n    const arityError = requireArity('IF', args, 2, 3);\n    if (arityError) return arityError;\n\n    const condition = toBoolean(context.evaluate(args[0]));\n    if (isCellError(condition)) return condition;\n\n    const branch = condition ? args[1] : args[2];\n    // `IF(cond, x)` with the condition false yields FALSE, as in Excel.\n    if (branch === undefined) return false;\n    return context.evaluate(branch) ?? 0;\n  },\n};\n","structuredPatch":[{"oldStart":89,"oldLines":9,"newStart":89,"newLines":15,"lines":["   }),"," ","   // MIN/MAX of nothing is 0 by spreadsheet convention, not an error.","-  MIN: aggregate('MIN', (numbers) => (numbers.length === 0 ? 0 : Math.min(...numbers))),","+  // Reduced in a loop rather than with `Math.min(...numbers)`, which overflows","+  // the argument stack on large ranges.","+  MIN: aggregate('MIN', (numbers) =>","+    numbers.reduce((best, n) => (n < best ? n : best), numbers.length === 0 ? 0 : Infinity),","+  ),"," ","-  MAX: aggregate('MAX', (numbers) => (numbers.length === 0 ? 0 : Math.max(...numbers))),","+  MAX: aggregate('MAX', (numbers) =>","+    numbers.reduce((best, n) => (n > best ? n : best), numbers.length === 0 ? 0 : -Infinity),","+  ),"," ","   COUNT: aggregate('COUNT', (numbers) => numbers.length),"," "]}],"userModified":false,"replaceAll":false}}
