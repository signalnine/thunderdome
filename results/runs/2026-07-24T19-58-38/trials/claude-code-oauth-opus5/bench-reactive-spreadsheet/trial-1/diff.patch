+import type { Node } from './ast.js';
+import { CellError, isCellError } from './errors.js';
+import type { FunctionContext } from './evaluator.js';
+import { toBoolean, toNumber, type CellValue } from './values.js';
+&nbsp;
+export type FunctionImplementation = (
+  args: readonly Node[],
