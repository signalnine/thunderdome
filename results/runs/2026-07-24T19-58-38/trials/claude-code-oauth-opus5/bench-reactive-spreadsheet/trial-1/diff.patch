diff --git a/src/__tests__/circular.test.ts b/src/__tests__/circular.test.ts
new file mode 100644
index 0000000..a8ad1f9
--- /dev/null
+++ b/src/__tests__/circular.test.ts
@@ -0,0 +1,133 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+
+import { CircularReferenceError, Spreadsheet } from '../index.js';
+
+describe('circular reference detection', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('rejects a self reference', () => {
+    expect(() => sheet.set('A1', '=A1')).toThrow(CircularReferenceError);
+    expect(() => sheet.set('A1', '=A1+1')).toThrow(CircularReferenceError);
+  });
+
+  it('rejects a two-cell cycle', () => {
+    sheet.set('A1', '=B1');
+    expect(() => sheet.set('B1', '=A1')).toThrow(CircularReferenceError);
+  });
+
+  it('rejects an indirect cycle', () => {
+    sheet.set('A1', '=B1');
+    sheet.set('B1', '=C1');
+    sheet.set('C1', '=D1');
+    expect(() => sheet.set('D1', '=A1')).toThrow(CircularReferenceError);
+  });
+
+  it('rejects a cycle formed through a range', () => {
+    sheet.set('A1', 1);
+    sheet.set('B1', '=SUM(A1:A3)');
+    expect(() => sheet.set('A2', '=B1')).toThrow(CircularReferenceError);
+  });
+
+  it('rejects a cycle where the formula reads its own range', () => {
+    expect(() => sheet.set('B1', '=SUM(A1:C1)')).toThrow(CircularReferenceError);
+  });
+
+  it('rejects a cycle that closes through an arithmetic expression', () => {
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1*2+3');
+    sheet.set('C1', '=IF(B1>0, B1, 0)');
+    expect(() => sheet.set('A1', '=C1/2')).toThrow(CircularReferenceError);
+  });
+
+  it('detects the cycle regardless of which cell closes it', () => {
+    sheet.set('B1', '=A1');
+    sheet.set('C1', '=B1');
+    // Closing from the "upstream" end.
+    expect(() => sheet.set('A1', '=C1')).toThrow(CircularReferenceError);
+
+    const other = new Spreadsheet();
+    other.set('B1', '=C1');
+    other.set('A1', '=B1');
+    // Closing from the "downstream" end.
+    expect(() => other.set('C1', '=A1')).toThrow(CircularReferenceError);
+  });
+
+  it('reports the cells involved', () => {
+    sheet.set('A1', '=B1');
+    sheet.set('B1', '=C1');
+
+    try {
+      sheet.set('C1', '=A1');
+      expect.unreachable('setting C1 should have thrown');
+    } catch (error) {
+      expect(error).toBeInstanceOf(CircularReferenceError);
+      const circular = error as CircularReferenceError;
+      expect(circular.cell).toBe('C1');
+      expect(circular.cycle).toEqual(['C1', 'A1', 'B1', 'C1']);
+      expect(circular.message).toContain('C1');
+    }
+  });
+
+  it('leaves the sheet unchanged after a rejected assignment', () => {
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1+1');
+    sheet.set('C1', '=B1+1');
+
+    expect(() => sheet.set('A1', '=C1')).toThrow(CircularReferenceError);
+
+    // The old value and every dependent survive untouched.
+    expect(sheet.get('A1')).toBe(1);
+    expect(sheet.get('B1')).toBe(2);
+    expect(sheet.get('C1')).toBe(3);
+    expect(sheet.getRaw('A1')).toBe(1);
+
+    // And the sheet still works afterwards.
+    sheet.set('A1', 10);
+    expect(sheet.get('C1')).toBe(12);
+  });
+
+  it('does not leave a stale dependency after a rejected assignment', () => {
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1+1');
+    sheet.set('D1', 100);
+
+    expect(() => sheet.set('A1', '=B1')).toThrow(CircularReferenceError);
+
+    // A1 must not have kept the rejected formula's link to B1.
+    sheet.set('A1', '=D1');
+    expect(sheet.get('A1')).toBe(100);
+    expect(sheet.get('B1')).toBe(101);
+
+    sheet.set('D1', 5);
+    expect(sheet.get('B1')).toBe(6);
+  });
+
+  it('allows a formula that merely looks recursive', () => {
+    // Two cells reading a common source is a diamond, not a cycle.
+    sheet.set('A1', 4);
+    sheet.set('B1', '=A1*2');
+    sheet.set('C1', '=A1+B1');
+    expect(sheet.get('C1')).toBe(12);
+  });
+
+  it('allows reusing a cell once the cycle is broken', () => {
+    sheet.set('A1', '=B1');
+    expect(() => sheet.set('B1', '=A1')).toThrow(CircularReferenceError);
+
+    sheet.set('A1', 5);
+    sheet.set('B1', '=A1*2');
+    expect(sheet.get('B1')).toBe(10);
+  });
+
+  it('allows a cycle to be broken by clearing a cell', () => {
+    sheet.set('A1', '=B1');
+    expect(() => sheet.set('B1', '=A1')).toThrow(CircularReferenceError);
+
+    sheet.clear('A1');
+    sheet.set('B1', '=A1+1');
+    expect(sheet.get('B1')).toBe(1);
+  });
+});
diff --git a/src/__tests__/edge-cases.test.ts b/src/__tests__/edge-cases.test.ts
new file mode 100644
index 0000000..29ccb5c
--- /dev/null
+++ b/src/__tests__/edge-cases.test.ts
@@ -0,0 +1,179 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+
+import { CellError, Spreadsheet, isCellError } from '../index.js';
+import { indexToColumn, parseCellRef } from '../reference.js';
+import { compareValues, formatNumber, formatValue, toNumber } from '../values.js';
+
+describe('CellError', () => {
+  it('stringifies to its code and carries detail', () => {
+    const error = new CellError('#DIV/0!', 'Division by zero');
+    expect(String(error)).toBe('#DIV/0!');
+    expect(error.detail).toBe('Division by zero');
+    expect(isCellError(error)).toBe(true);
+    expect(isCellError('#DIV/0!')).toBe(false);
+  });
+});
+
+describe('number formatting', () => {
+  it('trims floating point noise without losing real precision', () => {
+    expect(formatNumber(30)).toBe('30');
+    expect(formatNumber(0.1 + 0.2)).toBe('0.3');
+    expect(formatNumber(1 / 3)).toBe('0.333333333333333');
+    expect(formatNumber(-2.5)).toBe('-2.5');
+    expect(formatNumber(1e21)).toBe('1e+21');
+    expect(formatNumber(1234567.891)).toBe('1234567.891');
+  });
+
+  it('renders negative zero as zero', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=0*-1');
+    expect(sheet.getDisplay('A1')).toBe('0');
+  });
+
+  it('formats each value type', () => {
+    expect(formatValue(null)).toBe('');
+    expect(formatValue('text')).toBe('text');
+    expect(formatValue(true)).toBe('true');
+    expect(formatValue(new CellError('#REF!'))).toBe('#REF!');
+  });
+});
+
+describe('coercion helpers', () => {
+  it('converts what a spreadsheet would convert', () => {
+    expect(toNumber(null)).toBe(0);
+    expect(toNumber('')).toBe(0);
+    expect(toNumber('  7 ')).toBe(7);
+    expect(toNumber(true)).toBe(1);
+    expect(toNumber(false)).toBe(0);
+    expect(isCellError(toNumber('seven'))).toBe(true);
+  });
+
+  it('passes existing errors through untouched', () => {
+    const error = new CellError('#N/A');
+    expect(toNumber(error)).toBe(error);
+  });
+});
+
+describe('mixed-type comparison', () => {
+  it('orders numbers before text before booleans', () => {
+    expect(compareValues(1, 'a')).toBeLessThan(0);
+    expect(compareValues('a', true)).toBeLessThan(0);
+    expect(compareValues(true, 1)).toBeGreaterThan(0);
+    expect(compareValues(false, true)).toBeLessThan(0);
+    expect(compareValues(true, true)).toBe(0);
+  });
+
+  it('lets an empty cell take on the type it is compared with', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=Q9=FALSE');
+    sheet.set('A2', '=Q9=""');
+    sheet.set('A3', '=Q9=0');
+
+    expect(sheet.get('A1')).toBe(true);
+    expect(sheet.get('A2')).toBe(true);
+    expect(sheet.get('A3')).toBe(true);
+  });
+
+  it('applies the same ordering inside formulas', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=1<"a"');
+    sheet.set('A2', '="a"<TRUE');
+    sheet.set('A3', '=TRUE>1');
+
+    expect(sheet.get('A1')).toBe(true);
+    expect(sheet.get('A2')).toBe(true);
+    expect(sheet.get('A3')).toBe(true);
+  });
+});
+
+describe('reference limits', () => {
+  it('rejects rows and columns beyond the supported grid', () => {
+    expect(parseCellRef('A1048576')?.key).toBe('A1048576');
+    expect(parseCellRef('A1048577')).toBeNull();
+    expect(parseCellRef('XFD1')?.key).toBe('XFD1');
+    expect(parseCellRef('XFE1')).toBeNull();
+  });
+
+  it('refuses to name a column below A', () => {
+    expect(() => indexToColumn(0)).toThrow(RangeError);
+    expect(() => indexToColumn(1.5)).toThrow(RangeError);
+  });
+});
+
+describe('malformed formulas', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  const cases: Array<[string, string]> = [
+    ['unexpected character', '=1 # 2'],
+    ['range missing its end', '=SUM(A1:)'],
+    ['range ending in a non-cell', '=SUM(A1:5)'],
+    ['bare name that is not a function', '=TOTAL'],
+    ['function without parentheses', '=SUM A1'],
+    ['stray closing parenthesis', '=(1+2))'],
+    ['missing operand', '=1*'],
+    ['empty formula', '='],
+    ['reference outside the grid', '=XFE1+1'],
+    ['range ending outside the grid', '=SUM(A1:XFE1)'],
+    ['arguments without a separator', '=SUM(A1 A2)'],
+  ];
+
+  it.each(cases)('stores #ERROR! for a %s', (_label, formula) => {
+    sheet.set('A1', formula);
+    expect(sheet.get('A1')).toBe('#ERROR!');
+  });
+
+  it('does not poison neighbouring cells', () => {
+    sheet.set('A1', 5);
+    sheet.set('A2', '=this is not a formula');
+    sheet.set('A3', '=A1*2');
+
+    expect(sheet.get('A2')).toBe('#ERROR!');
+    expect(sheet.get('A3')).toBe(10);
+  });
+
+  it('recovers when the formula is corrected', () => {
+    sheet.set('A1', 5);
+    sheet.set('B1', '=A1+');
+    expect(sheet.get('B1')).toBe('#ERROR!');
+
+    sheet.set('B1', '=A1+1');
+    expect(sheet.get('B1')).toBe(6);
+
+    sheet.set('A1', 10);
+    expect(sheet.get('B1')).toBe(11);
+  });
+});
+
+describe('aggregate arguments', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('coerces literal arguments but skips values found in the sheet', () => {
+    sheet.set('A1', 'text');
+    sheet.set('A2', true);
+    sheet.set('B1', '=SUM(A1:A2)');
+    sheet.set('B2', '=SUM(TRUE, "5", 1)');
+    sheet.set('B3', '=SUM("text")');
+
+    expect(sheet.get('B1')).toBe(0);
+    expect(sheet.get('B2')).toBe(7);
+    expect(sheet.get('B3')).toBe('#VALUE!');
+  });
+
+  it('treats a reference to an empty cell as no value at all', () => {
+    sheet.set('A1', 4);
+    sheet.set('B1', '=AVERAGE(A1, Q9)');
+    expect(sheet.get('B1')).toBe(4);
+  });
+
+  it('accepts nested expressions as arguments', () => {
+    sheet.set('A1', 3);
+    sheet.set('B1', '=SUM(A1*2, MAX(1, 2), (A1+1)/2)');
+    expect(sheet.get('B1')).toBe(10);
+  });
+});
diff --git a/src/__tests__/formulas.test.ts b/src/__tests__/formulas.test.ts
