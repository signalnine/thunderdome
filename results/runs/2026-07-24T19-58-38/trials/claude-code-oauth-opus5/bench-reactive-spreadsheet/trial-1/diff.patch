+import { beforeEach, describe, expect, it } from 'vitest';
+
+import { Spreadsheet } from '../index.js';
+
+describe('range shapes', () => {
+  let sheet: Spreadsheet;
+
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+    // A 3x3 block of 1..9, laid out in reading order.
+    let n = 1;
+    for (let row = 1; row <= 3; row++) {
+      for (const column of ['A', 'B', 'C']) {
+        sheet.set(`${column}${row}`, n++);
+      }
+    }
+  });
+
+  it('sums a column range', () => {
+    sheet.set('E1', '=SUM(A1:A3)');
+    expect(sheet.get('E1')).toBe(1 + 4 + 7);
+  });
+
+  it('sums a row range', () => {
+    sheet.set('E1', '=SUM(A1:C1)');
+    expect(sheet.get('E1')).toBe(1 + 2 + 3);
+  });
+
+  it('sums a rectangular block', () => {
+    sheet.set('E1', '=SUM(A1:C3)');
+    expect(sheet.get('E1')).toBe(45);
+  });
+
+  it('sums a sub-block', () => {
+    sheet.set('E1', '=SUM(B2:C3)');
+    expect(sheet.get('E1')).toBe(5 + 6 + 8 + 9);
+  });
+
+  it('treats a single-cell range as that cell', () => {
+    sheet.set('E1', '=SUM(B2:B2)');
+    expect(sheet.get('E1')).toBe(5);
+  });
+
+  it('accepts corners given in either order', () => {
+    sheet.set('E1', '=SUM(C3:A1)');
+    sheet.set('E2', '=SUM(A3:C1)');
+    expect(sheet.get('E1')).toBe(45);
+    expect(sheet.get('E2')).toBe(45);
+  });
+
+  it('spans multi-letter columns', () => {
+    sheet.set('AA1', 100);
+    sheet.set('AB1', 200);
+    sheet.set('E1', '=SUM(AA1:AB1)');
+    expect(sheet.get('E1')).toBe(300);
+  });
+});
+
+describe('ranges as dependencies', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('A2', 2);
+    sheet.set('B1', '=SUM(A1:A5)');
+  });
+
+  it('recomputes when a cell inside the range changes', () => {
+    expect(sheet.get('B1')).toBe(3);
+    sheet.set('A1', 10);
+    expect(sheet.get('B1')).toBe(12);
+  });
+
+  it('recomputes when a cell is added to a previously empty part of the range', () => {
+    sheet.set('A5', 100);
+    expect(sheet.get('B1')).toBe(103);
+  });
+
+  it('recomputes when a cell inside the range is cleared', () => {
+    sheet.clear('A2');
+    expect(sheet.get('B1')).toBe(1);
+  });
+
+  it('ignores changes outside the range', () => {
+    sheet.set('A6', 1000);
+    sheet.set('C1', 1000);
+    expect(sheet.get('B1')).toBe(3);
+  });
+
+  it('follows a formula that moves to a different range', () => {
+    sheet.set('D1', 50);
+    sheet.set('B1', '=SUM(D1:D5)');
+    expect(sheet.get('B1')).toBe(50);
+
+    // A1 is no longer read, so changing it must not disturb B1.
+    sheet.set('A1', 999);
+    expect(sheet.get('B1')).toBe(50);
+
+    sheet.set('D2', 5);
+    expect(sheet.get('B1')).toBe(55);
+  });
+
+  it('updates through a chain of range formulas', () => {
+    sheet.set('C1', '=B1*2');
+    sheet.set('D1', '=SUM(B1:C1)');
+
+    expect(sheet.get('D1')).toBe(9);
+    sheet.set('A1', 4);
+    expect(sheet.get('B1')).toBe(6);
+    expect(sheet.get('C1')).toBe(12);
+    expect(sheet.get('D1')).toBe(18);
+  });
+});
+
+describe('large ranges', () => {
+  it('handles a range far larger than the populated area', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('M5000', 2);
+    // The range spans ~1.3 billion coordinates but only three cells exist.
+    sheet.set('ZZ1', '=SUM(A1:N100000)');
+    sheet.set('ZZ2', '=COUNT(A1:N100000)');
+
+    expect(sheet.get('ZZ1')).toBe(3);
+    expect(sheet.get('ZZ2')).toBe(2);
+
+    sheet.set('B500', 10);
+    expect(sheet.get('ZZ1')).toBe(13);
+    expect(sheet.get('ZZ2')).toBe(3);
+  });
+
+  it('rejects a formula that sits inside the range it aggregates', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    expect(() => sheet.set('A2', '=SUM(A1:A5)')).toThrow(/[Cc]ircular/);
+  });
+
+  it('aggregates thousands of cells', () => {
+    const sheet = new Spreadsheet();
+    for (let row = 1; row <= 1000; row++) sheet.set(`A${row}`, row);
+    sheet.set('C1', '=SUM(A1:A1000)');
+    sheet.set('C2', '=AVERAGE(A1:A1000)');
+    sheet.set('C3', '=MAX(A1:A1000)');
+
+    expect(sheet.get('C1')).toBe(500500);
+    expect(sheet.get('C2')).toBe(500.5);
+    expect(sheet.get('C3')).toBe(1000);
+
+    sheet.set('A1000', 0);
+    expect(sheet.get('C1')).toBe(499500);
+    expect(sheet.get('C3')).toBe(999);
+  });
+});
