ing to average', () => {\n    sheet.set('C1', '=AVERAGE(D1:D9)');\n    expect(sheet.get('C1')).toBe('#DIV/0!');\n  });\n});\n\ndescribe('MIN and MAX', () => {\n  let sheet: Spreadsheet;\n  beforeEach(() => {\n    sheet = numericSheet();\n  });\n\n  it('find the extremes of a range', () => {\n    sheet.set('C1', '=MIN(A1:A5)');\n    sheet.set('C2', '=MAX(A1:A5)');\n    expect(sheet.get('C1')).toBe(1);\n    expect(sheet.get('C2')).toBe(10);\n  });\n\n  it('handle negative numbers', () => {\n    sheet.set('A1', -50);\n    sheet.set('C1', '=MIN(A1:A5)');\n    sheet.set('C2', '=MAX(A1:A5)');\n    expect(sheet.get('C1')).toBe(-50);\n    expect(sheet.get('C2')).toBe(10);\n  });\n\n  it('are zero over an empty range', () => {\n    sheet.set('C1', '=MIN(D1:D9)');\n    sheet.set('C2', '=MAX(D1:D9)');\n    expect(sheet.get('C1')).toBe(0);\n    expect(sheet.get('C2')).toBe(0);\n  });\n});\n\ndescribe('COUNT', () => {\n  let sheet: Spreadsheet;\n  beforeEach(() => {\n    sheet = numericSheet();\n  });\n\n  it('counts numeric cells only', () => {\n    sheet.set('A3', 'text');\n    sheet.set('A4', true);\n    sheet.set('C1', '=COUNT(A1:A10)');\n    expect(sheet.get('C1')).toBe(3);\n  });\n\n  it('counts across a block', () => {\n    sheet.set('B1', 9);\n    sheet.set('C1', '=COUNT(A1:B5)');\n    expect(sheet.get('C1')).toBe(6);\n  });\n\n  it('is zero over an empty range', () => {\n    sheet.set('C1', '=COUNT(D1:D9)');\n    expect(sheet.get('C1')).toBe(0);\n  });\n});\n\ndescribe('IF', () => {\n  let sheet: Spreadsheet;\n  beforeEach(() => {\n    sheet = new Spreadsheet();\n    sheet.set('A1', 50);\n  });\n\n  it('selects a branch on a comparison', () => {\n    sheet.set('B1', '=IF(A1>30, \"big\", \"small\")');\n    expect(sheet.get('B1')).toBe('big');\n\n    sheet.set('A1', 5);\n    expect(sheet.get('B1')).toBe('small');\n  });\n\n  it('supports every comparison operator', () => {\n    const cases: Array<[string, unknown]> = [\n      ['=IF(A1=50, \"y\", \"n\")', 'y'],\n      ['=I