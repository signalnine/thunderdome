+++ b/src/ast.ts
@@ -0,0 +1,115 @@
+/** Abstract syntax tree produced by the formula parser. */
+
+import type { CellRef, RangeRef } from './reference.js';
+
+export type BinaryOperator =
+  | '+'
+  | '-'
+  | '*'
+  | '/'
+  | '^'
+  | '&'
+  | '='
+  | '<>'
+  | '>'
+  | '<'
+  | '>='
+  | '<=';
+
+export type UnaryOperator = '+' | '-';
+
+export interface NumberLiteral {
+  readonly type: 'number';
+  readonly value: number;
+}
+
+export interface StringLiteral {
+  readonly type: 'string';
+  readonly value: string;
+}
+
+export interface BooleanLiteral {
+  readonly type: 'boolean';
+  readonly value: boolean;
+}
+
+export interface CellReferenceNode {
+  readonly type: 'ref';
+  readonly ref: CellRef;
+}
+
+export interface RangeReferenceNode {
+  readonly type: 'range';
+  readonly range: RangeRef;
+}
+
+export interface UnaryNode {
+  readonly type: 'unary';
+  readonly operator: UnaryOperator;
+  readonly operand: Node;
+}
+
+export interface BinaryNode {
+  readonly type: 'binary';
+  readonly operator: BinaryOperator;
+  readonly left: Node;
+  readonly right: Node;
+}
+
+export interface FunctionCallNode {
+  readonly type: 'call';
+  /** Always uppercase; function names are case-insensitive. */
+  readonly name: string;
+  readonly args: readonly Node[];
+}
+
+export type Node =
+  | NumberLiteral
+  | StringLiteral
+  | BooleanLiteral
+  | CellReferenceNode
+  | RangeReferenceNode
+  | UnaryNode
+  | BinaryNode
+  | FunctionCallNode;
+
+/** A thing a formula reads: either one cell or a whole range. */
+export type Dependency =
+  | { readonly kind: 'cell'; readonly ref: CellRef }
+  | { readonly kind: 'range'; readonly range: RangeRef };
+
+/**
+ * Collects every cell and range the expression reads, de-duplicated by key.
+ * Ranges are kept intact rather than expanded: a range may cover millions of
+ * cells, and the dependency graph tracks them as single edges.
+ */
+export function collectDependencies(node: Node): Dependency[] {
+  const byKey = new Map<string, Dependency>();
+
+  const walk = (current: Node): void => {
+    switch (current.type) {
+      case 'ref':
+        byKey.set(current.ref.key, { kind: 'cell', ref: current.ref });
+        return;
+      case 'range':
+        byKey.set(current.range.key, { kind: 'range', range: current.range });
+        return;
+      case 'unary':
+        walk(current.operand);
+        return;
+      case 'binary':
+        walk(current.left);
+        walk(current.right);
+        return;
+      case 'call':
+        for (const arg of current.args) walk(arg);
+        return;
+      default:
+        // Literals have no dependencies.
+        return;
+    }
+  };
+
+  walk(node);
+  return [...byKey.values()];
+}
