+&nbsp;
+/**
+ * Collects the numbers an aggregate should operate on.
+ *
+ * Ranges and cell references contribute only their numeric cells — text and
+ * booleans sitting in the sheet are skipped rather than treated as errors.
+ * Literal arguments (`SUM(1, TRUE, "5")`) are coerced, since writing them was
+ * deliberate. Any error encountered propagates immediately.
+ */
+function gatherNumbers(
+  args: readonly Node[],
+  context: FunctionContext,
+): number[] | CellError {
+  const numbers: number[] = [];
+&nbsp;
