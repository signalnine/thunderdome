+import { beforeEach, describe, expect, it } from 'vitest';
+
+import { InvalidCellReferenceError, Spreadsheet } from '../index.js';
+
+describe('the documented example', () => {
+  it('behaves exactly as advertised', () => {
+    const sheet = new Spreadsheet();
+
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('A3', '=A1+A2');
+    expect(sheet.get('A3')).toBe(30);
+    expect(sheet.getDisplay('A3')).toBe('30');
+
+    sheet.set('A1', 50);
+    expect(sheet.get('A3')).toBe(70);
+
+    sheet.set('B1', '=SUM(A1:A2)');
+    expect(sheet.get('B1')).toBe(70);
+
+    sheet.set('C1', '=IF(A1>30, "big", "small")');
+    expect(sheet.get('C1')).toBe('big');
+  });
+});
+
+describe('literal values', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('stores numbers, strings, and booleans unchanged', () => {
+    sheet.set('A1', 42);
+    sheet.set('A2', 3.14);
+    sheet.set('A3', -7);
+    sheet.set('B1', 'hello');
+    sheet.set('C1', true);
+    sheet.set('C2', false);
+
+    expect(sheet.get('A1')).toBe(42);
+    expect(sheet.get('A2')).toBe(3.14);
+    expect(sheet.get('A3')).toBe(-7);
+    expect(sheet.get('B1')).toBe('hello');
+    expect(sheet.get('C1')).toBe(true);
+    expect(sheet.get('C2')).toBe(false);
+  });
+
+  it('keeps numeric-looking strings as strings', () => {
+    sheet.set('A1', '42');
+    expect(sheet.get('A1')).toBe('42');
+    expect(typeof sheet.get('A1')).toBe('string');
+  });
+
+  it('does not treat text containing = as a formula', () => {
+    sheet.set('A1', 'a = b');
+    expect(sheet.get('A1')).toBe('a = b');
+  });
+
+  it('overwrites a previous value', () => {
+    sheet.set('A1', 1);
+    sheet.set('A1', 'replaced');
+    expect(sheet.get('A1')).toBe('replaced');
+  });
+
+  it('accepts references in any case, with or without $', () => {
+    sheet.set('a1', 5);
+    expect(sheet.get('A1')).toBe(5);
+    sheet.set('B1', '=$a$1 * 2');
+    expect(sheet.get('b1')).toBe(10);
+  });
+});
+
+describe('empty cells', () => {
+  const sheet = new Spreadsheet();
+
+  it('read as null and display as an empty string', () => {
+    expect(sheet.get('Z99')).toBeNull();
+    expect(sheet.getDisplay('Z99')).toBe('');
+    expect(sheet.getRaw('Z99')).toBeNull();
+  });
+
+  it('count as zero inside formulas', () => {
+    sheet.set('A1', '=Z99+1');
+    expect(sheet.get('A1')).toBe(1);
+  });
+});
+
+describe('getDisplay', () => {
+  const sheet = new Spreadsheet();
+
+  it('renders each value type', () => {
+    sheet.set('A1', 30);
+    sheet.set('A2', 'text');
+    sheet.set('A3', true);
+    sheet.set('A4', false);
+    sheet.set('A5', -0.5);
+
+    expect(sheet.getDisplay('A1')).toBe('30');
+    expect(sheet.getDisplay('A2')).toBe('text');
+    expect(sheet.getDisplay('A3')).toBe('true');
+    expect(sheet.getDisplay('A4')).toBe('false');
+    expect(sheet.getDisplay('A5')).toBe('-0.5');
+  });
+
+  it('hides binary floating point noise', () => {
+    sheet.set('B1', 0.1);
+    sheet.set('B2', 0.2);
+    sheet.set('B3', '=B1+B2');
+
+    // The stored value keeps full double precision...
+    expect(sheet.get('B3')).toBeCloseTo(0.3, 15);
+    // ...while the display reads the way a spreadsheet would show it.
+    expect(sheet.getDisplay('B3')).toBe('0.3');
