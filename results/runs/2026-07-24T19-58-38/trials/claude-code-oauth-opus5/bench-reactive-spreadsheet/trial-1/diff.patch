@@ -0,0 +1,233 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+
+import { Spreadsheet } from '../index.js';
+
+/** A sheet with numbers in A1:A5 and assorted junk alongside them. */
+function numericSheet(): Spreadsheet {
+  const sheet = new Spreadsheet();
+  sheet.set('A1', 1);
+  sheet.set('A2', 2);
+  sheet.set('A3', 3);
+  sheet.set('A4', 4);
+  sheet.set('A5', 10);
+  return sheet;
+}
+
+describe('SUM', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = numericSheet();
+  });
+
+  it('adds the values in a range', () => {
+    sheet.set('C1', '=SUM(A1:A5)');
+    expect(sheet.get('C1')).toBe(20);
+  });
+
+  it('accepts several arguments, including bare values', () => {
+    sheet.set('C1', '=SUM(A1:A2, A5, 100)');
+    expect(sheet.get('C1')).toBe(113);
+  });
+
+  it('skips text and booleans stored in the range', () => {
+    sheet.set('A3', 'three');
+    sheet.set('A4', true);
+    sheet.set('C1', '=SUM(A1:A5)');
+    expect(sheet.get('C1')).toBe(13);
+  });
+
+  it('is zero over an empty range', () => {
+    sheet.set('C1', '=SUM(D1:D9)');
+    expect(sheet.get('C1')).toBe(0);
+  });
+
+  it('is case-insensitive', () => {
+    sheet.set('C1', '=sum(a1:a5)');
+    expect(sheet.get('C1')).toBe(20);
+  });
+});
+
+describe('AVERAGE', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = numericSheet();
+  });
+
+  it('divides by the count of numeric values', () => {
+    sheet.set('C1', '=AVERAGE(A1:A5)');
+    expect(sheet.get('C1')).toBe(4);
+  });
+
+  it('ignores empty cells rather than counting them as zero', () => {
+    sheet.set('C1', '=AVERAGE(A1:A10)');
+    expect(sheet.get('C1')).toBe(4);
+  });
+
+  it('is #DIV/0! when there is nothing to average', () => {
+    sheet.set('C1', '=AVERAGE(D1:D9)');
+    expect(sheet.get('C1')).toBe('#DIV/0!');
+  });
+});
+
+describe('MIN and MAX', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = numericSheet();
+  });
+
+  it('find the extremes of a range', () => {
+    sheet.set('C1', '=MIN(A1:A5)');
+    sheet.set('C2', '=MAX(A1:A5)');
+    expect(sheet.get('C1')).toBe(1);
+    expect(sheet.get('C2')).toBe(10);
+  });
+
+  it('handle negative numbers', () => {
+    sheet.set('A1', -50);
+    sheet.set('C1', '=MIN(A1:A5)');
+    sheet.set('C2', '=MAX(A1:A5)');
+    expect(sheet.get('C1')).toBe(-50);
+    expect(sheet.get('C2')).toBe(10);
+  });
+
+  it('are zero over an empty range', () => {
+    sheet.set('C1', '=MIN(D1:D9)');
+    sheet.set('C2', '=MAX(D1:D9)');
+    expect(sheet.get('C1')).toBe(0);
+    expect(sheet.get('C2')).toBe(0);
+  });
+});
+
+describe('COUNT', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = numericSheet();
+  });
+
+  it('counts numeric cells only', () => {
+    sheet.set('A3', 'text');
+    sheet.set('A4', true);
+    sheet.set('C1', '=COUNT(A1:A10)');
+    expect(sheet.get('C1')).toBe(3);
+  });
+
+  it('counts across a block', () => {
+    sheet.set('B1', 9);
+    sheet.set('C1', '=COUNT(A1:B5)');
+    expect(sheet.get('C1')).toBe(6);
+  });
+
+  it('is zero over an empty range', () => {
+    sheet.set('C1', '=COUNT(D1:D9)');
+    expect(sheet.get('C1')).toBe(0);
+  });
+});
+
+describe('IF', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+    sheet.set('A1', 50);
+  });
+
+  it('selects a branch on a comparison', () => {
+    sheet.set('B1', '=IF(A1>30, "big", "small")');
+    expect(sheet.get('B1')).toBe('big');
+
+    sheet.set('A1', 5);
+    expect(sheet.get('B1')).toBe('small');
+  });
+
+  it('supports every comparison operator', () => {
+    const cases: Array<[string, unknown]> = [
+      ['=IF(A1=50, "y", "n")', 'y'],
+      ['=IF(A1<>50, "y", "n")', 'n'],
+      ['=IF(A1>=50, "y", "n")', 'y'],
+      ['=IF(A1<=49, "y", "n")', 'n'],
+      ['=IF(A1<100, "y", "n")', 'y'],
+    ];
+    for (const [formula, expected] of cases) {
+      sheet.set('B1', formula);
+      expect(sheet.get('B1'), formula).toBe(expected);
+    }
+  });
+
+  it('returns expressions, not just literals', () => {
+    sheet.set('B1', '=IF(A1>0, A1*2, 0)');
+    expect(sheet.get('B1')).toBe(100);
+  });
+
+  it('nests', () => {
+    sheet.set('B1', '=IF(A1>100, "high", IF(A1>10, "medium", "low"))');
+    expect(sheet.get('B1')).toBe('medium');
+
+    sheet.set('A1', 500);
+    expect(sheet.get('B1')).toBe('high');
+
+    sheet.set('A1', 1);
+    expect(sheet.get('B1')).toBe('low');
+  });
+
+  it('accepts a bare boolean or number as the condition', () => {
+    sheet.set('B1', '=IF(TRUE, 1, 2)');
+    sheet.set('B2', '=IF(0, 1, 2)');
+    sheet.set('B3', '=IF(A1, 1, 2)');
+
+    expect(sheet.get('B1')).toBe(1);
+    expect(sheet.get('B2')).toBe(2);
+    expect(sheet.get('B3')).toBe(1);
+  });
+
+  it('only evaluates the branch it takes', () => {
+    sheet.set('A1', 0);
+    sheet.set('B1', '=IF(A1=0, "safe", 1/A1)');
+    expect(sheet.get('B1')).toBe('safe');
+  });
+
+  it('defaults the missing branch to false', () => {
+    sheet.set('B1', '=IF(A1>1000, "big")');
+    expect(sheet.get('B1')).toBe(false);
+  });
+
+  it('rejects a text condition', () => {
+    sheet.set('B1', '=IF("text", 1, 2)');
+    expect(sheet.get('B1')).toBe('#VALUE!');
+  });
+
+  it('propagates an error from its condition', () => {
+    sheet.set('A2', '=1/0');
+    sheet.set('B1', '=IF(A2>1, 1, 2)');
+    expect(sheet.get('B1')).toBe('#DIV/0!');
+  });
+});
+
+describe('function composition', () => {
+  it('nests aggregates and arithmetic', () => {
+    const sheet = numericSheet();
+    sheet.set('C1', '=SUM(A1:A5)/COUNT(A1:A5)');
+    sheet.set('C2', '=MAX(A1:A5)-MIN(A1:A5)');
+    sheet.set('C3', '=IF(SUM(A1:A5)>15, AVERAGE(A1:A5), 0)');
+
+    expect(sheet.get('C1')).toBe(4);
+    expect(sheet.get('C2')).toBe(9);
+    expect(sheet.get('C3')).toBe(4);
+  });
+
+  it('propagates errors out of aggregates', () => {
+    const sheet = numericSheet();
+    sheet.set('A3', '=1/0');
+    sheet.set('C1', '=SUM(A1:A5)');
+    expect(sheet.get('C1')).toBe('#DIV/0!');
+  });
+
+  it('rejects the wrong number of arguments', () => {
+    const sheet = numericSheet();
+    sheet.set('C1', '=IF(A1>0)');
+    sheet.set('C2', '=IF(1,2,3,4)');
+    sheet.set('C3', '=SUM()');
+
+    expect(sheet.get('C1')).toBe('#VALUE!');
+    expect(sheet.get('C2')).toBe('#VALUE!');
+    expect(sheet.get('C3')).toBe('#VALUE!');
+  });
+});
