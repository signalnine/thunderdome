@@ -0,0 +1,43 @@
+import { Router } from 'express';
+import { AuthError } from '../errors';
+import { requireUser } from '../types';
+import { asObject, requireString } from '../utils';
+import { assertRole, changeRole, getProfile, login, register } from './service';
+
+const router = Router();
+
+router.post('/', (req, res) => {
+  const body = asObject(req.body);
+  const email = requireString(body, 'email');
+  const password = requireString(body, 'password');
+  const tenantId = requireString(body, 'tenant_id');
+
+  res.status(201).json(register(email, password, tenantId));
+});
+
+router.post('/login', (req, res) => {
+  const body = asObject(req.body);
+  const email = requireString(body, 'email');
+  const password = requireString(body, 'password');
+
+  const result = login(email, password);
+  if (!result) {
+    throw new AuthError('Invalid email or password');
+  }
+  res.json(result);
+});
+
+router.get('/me', (req, res) => {
+  const user = requireUser(req);
+  res.json(getProfile(user.id));
+});
+
+router.patch('/:id/role', (req, res) => {
+  const actor = requireUser(req);
+  const body = asObject(req.body);
+  const role = assertRole(body.role);
+
+  res.json(changeRole(actor.id, req.params.id, role, actor.tenantId));
+});
+
+export default router;
diff --git a/src/users/service.ts b/src/users/service.ts
new file mode 100644
index 0000000..97769f9
--- /dev/null
+++ b/src/users/service.ts
@@ -0,0 +1,112 @@
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ConflictError, ForbiddenError, NotFoundError, ValidationError } from '../errors';
+import { hashPassword, signToken, verifyPassword } from '../auth';
+import type { Role } from '../types';
+import { ROLES } from '../types';
+
+export interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: Role;
+  created_at: string;
+}
+
+export type PublicUser = Omit<UserRow, 'password_hash'>;
+
+export function toPublicUser(row: UserRow): PublicUser {
+  const { password_hash: _password_hash, ...rest } = row;
+  return rest;
+}
+
+export function findById(id: string): UserRow | undefined {
+  return getDb().prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow | undefined;
+}
+
+export function findByEmail(email: string): UserRow | undefined {
+  return getDb().prepare('SELECT * FROM users WHERE email = ?').get(email) as UserRow | undefined;
+}
+
+export function assertRole(value: unknown): Role {
+  if (typeof value !== 'string' || !ROLES.includes(value as Role)) {
+    throw new ValidationError(`role must be one of: ${ROLES.join(', ')}`);
+  }
+  return value as Role;
+}
+
+export function register(email: string, password: string, tenantId: string): PublicUser {
+  const normalizedEmail = email.trim().toLowerCase();
+  if (findByEmail(normalizedEmail)) {
+    throw new ConflictError('A user with that email already exists');
+  }
+
+  const row: UserRow = {
+    id: uuidv4(),
+    email: normalizedEmail,
+    password_hash: hashPassword(password),
+    tenant_id: tenantId,
+    role: 'viewer',
+    created_at: new Date().toISOString(),
+  };
+
+  try {
+    getDb()
+      .prepare(
+        `INSERT INTO users (id, email, password_hash, tenant_id, role, created_at)
+         VALUES (?, ?, ?, ?, ?, ?)`
+      )
+      .run(row.id, row.email, row.password_hash, row.tenant_id, row.role, row.created_at);
+  } catch (err) {
+    // Guards against a concurrent insert winning the race after the check above.
+    if (err instanceof Error && err.message.includes('UNIQUE')) {
+      throw new ConflictError('A user with that email already exists');
+    }
+    throw err;
+  }
+
+  return toPublicUser(row);
+}
+
+export interface LoginResult {
+  token: string;
+  user: PublicUser;
+}
+
+/** Returns null for both unknown email and bad password: no account enumeration. */
+export function login(email: string, password: string): LoginResult | null {
+  const row = findByEmail(email.trim().toLowerCase());
+  if (!row || !verifyPassword(password, row.password_hash)) {
+    return null;
+  }
+  return { token: signToken(row), user: toPublicUser(row) };
+}
+
+export function getProfile(userId: string): PublicUser {
+  const row = findById(userId);
+  if (!row) {
+    throw new NotFoundError('User not found');
+  }
+  return toPublicUser(row);
+}
+
+export function changeRole(
+  actorId: string,
+  targetId: string,
+  role: Role,
+  tenantId: string
+): PublicUser {
+  const actor = findById(actorId);
+  if (!actor || actor.role !== 'admin') {
+    throw new ForbiddenError('Only admins can change user roles');
+  }
+
+  const target = findById(targetId);
+  if (!target || target.tenant_id !== actor.tenant_id || target.tenant_id !== tenantId) {
+    throw new NotFoundError('User not found');
+  }
+
+  getDb().prepare('UPDATE users SET role = ? WHERE id = ?').run(role, targetId);
+  return toPublicUser({ ...target, role });
+}
diff --git a/src/utils.ts b/src/utils.ts
new file mode 100644
index 0000000..50e6de2
--- /dev/null
+++ b/src/utils.ts
@@ -0,0 +1,129 @@
+import { ValidationError } from './errors';
+
+/** Body payloads arrive untyped; this narrows them to an indexable object. */
+export function asObject(value: unknown, label = 'body'): Record<string, unknown> {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    throw new ValidationError(`${label} must be a JSON object`);
+  }
+  return value as Record<string, unknown>;
+}
+
+export function requireString(
+  source: Record<string, unknown>,
+  field: string,
+  label = field
+): string {
+  const value = source[field];
+  if (typeof value !== 'string' || value.trim() === '') {
+    throw new ValidationError(`${label} is required and must be a non-empty string`);
+  }
+  return value;
+}
+
+export function optionalString(
+  source: Record<string, unknown>,
+  field: string
+): string | undefined {
+  const value = source[field];
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  if (typeof value !== 'string') {
+    throw new ValidationError(`${field} must be a string`);
+  }
+  return value;
+}
+
+export function optionalPositiveInt(
+  source: Record<string, unknown>,
+  field: string
+): number | undefined {
+  const value = source[field];
+  if (value === undefined || value === null || value === '') {
+    return undefined;
+  }
+  const parsed = typeof value === 'number' ? value : Number(value);
+  if (!Number.isInteger(parsed) || parsed <= 0) {
+    throw new ValidationError(`${field} must be a positive integer`);
+  }
+  return parsed;
+}
+
+export function optionalInt(source: Record<string, unknown>, field: string): number | undefined {
+  const value = source[field];
+  if (value === undefined || value === null || value === '') {
+    return undefined;
+  }
+  const parsed = typeof value === 'number' ? value : Number(value);
+  if (!Number.isInteger(parsed)) {
+    throw new ValidationError(`${field} must be an integer`);
+  }
+  return parsed;
+}
+
+/** JSON-ish column values are stored as text; decode defensively. */
+export function parseJsonColumn(value: unknown): Record<string, unknown> {
+  if (typeof value !== 'string' || value === '') {
+    return {};
+  }
+  try {
+    const parsed: unknown = JSON.parse(value);
+    return typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)
+      ? (parsed as Record<string, unknown>)
+      : {};
+  } catch {
+    return {};
+  }
+}
+
+/** Serialises a config/properties payload, rejecting non-objects. */
+export function serializeJsonColumn(value: unknown, field: string): string {
+  if (value === undefined || value === null) {
+    return '{}';
+  }
+  if (typeof value !== 'object' || Array.isArray(value)) {
+    throw new ValidationError(`${field} must be a JSON object`);
+  }
+  return JSON.stringify(value);
+}
+
+/**
+ * Property keys are interpolated into JSON paths, so restrict them to a safe
+ * character set rather than trying to escape arbitrary input.
+ */
+const PROPERTY_KEY_PATTERN = /^[A-Za-z0-9_][A-Za-z0-9_.-]*$/;
+
+export function jsonPath(key: string, field = 'property_key'): string {
+  if (!PROPERTY_KEY_PATTERN.test(key)) {
+    throw new ValidationError(
+      `${field} must contain only letters, digits, underscores, dots or hyphens`
+    );
+  }
+  return `$.${key}`;
+}
+
+/** Normalises a timestamp to `YYYY-MM-DDTHH:MM:SS` in UTC for text comparison. */
+export function normalizeTimestamp(value: string, field: string): string {
+  const parsed = new Date(value);
+  if (Number.isNaN(parsed.getTime())) {
+    throw new ValidationError(`${field} must be a valid ISO-8601 timestamp`);
+  }
+  return parsed.toISOString().slice(0, 19);
+}
+
+export function csvEscape(value: unknown): string {
+  if (value === null || value === undefined) {
+    return '';
+  }
+  const text = String(value);
+  return /[",\n\r]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
+
+/** Renders rows as CSV with no trailing newline. */
+export function toCsv(columns: readonly string[], rows: readonly Record<string, unknown>[]): string {
+  const lines = [columns.join(',')];
+  for (const row of rows) {
+    lines.push(columns.map((column) => csvEscape(row[column])).join(','));
+  }
+  return lines.join('\n');
+}
