+import { Router } from 'express';
+import { requireUser } from '../types';
+import { asObject, requireString } from '../utils';
+import {
+  assertBucket,
+  assertSteps,
+  breakdown,
+  count,
+  funnel,
+  parseFilter,
+  parseLimit,
+  timeseries,
+} from './service';
+
+const router = Router();
+
+router.post('/count', (req, res) => {
+  const user = requireUser(req);
+  const body = asObject(req.body);
+  const filter = parseFilter(body, user.tenantId, { requireEventName: true });
+
+  res.json({ count: count(filter) });
+});
+
+router.post('/timeseries', (req, res) => {
+  const user = requireUser(req);
+  const body = asObject(req.body);
+  const filter = parseFilter(body, user.tenantId, { requireEventName: true });
+  const bucket = assertBucket(body.bucket);
+
+  res.json({ bucket, data: timeseries(filter, bucket) });
+});
+
+router.post('/breakdown', (req, res) => {
+  const user = requireUser(req);
+  const body = asObject(req.body);
+  const filter = parseFilter(body, user.tenantId, { requireEventName: true });
+  const propertyKey = requireString(body, 'property_key');
+
+  res.json({ property_key: propertyKey, data: breakdown(filter, propertyKey, parseLimit(body)) });
+});
+
+router.post('/funnel', (req, res) => {
+  const user = requireUser(req);
+  const body = asObject(req.body);
+  const filter = parseFilter(body, user.tenantId);
+  const steps = assertSteps(body.steps);
+
+  res.json({ steps: funnel(filter, steps) });
+});
+
+export default router;
