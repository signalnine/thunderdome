T * FROM dashboards WHERE tenant_id = ? ORDER BY created_at ASC, id ASC')\n    .all(tenantId) as DashboardRow[];\n  return rows.map(toDashboardDto);\n}\n\nexport function listWidgets(dashboardId: string): WidgetDto[] {\n  const rows = getDb()\n    .prepare(\n      `SELECT * FROM widgets WHERE dashboard_id = ?\n       ORDER BY position_y ASC, position_x ASC, id ASC`\n    )\n    .all(dashboardId) as WidgetRow[];\n  return rows.map(toWidgetDto);\n}\n\nexport function getDashboard(\n  id: string,\n  tenantId: string\n): DashboardDto & { widgets: WidgetDto[] } {\n  const dashboard = requireDashboard(id, tenantId);\n  return { ...toDashboardDto(dashboard), widgets: listWidgets(dashboard.id) };\n}\n\nexport function createDashboard(\n  tenantId: string,\n  ownerId: string,\n  name: string,\n  config: unknown\n): DashboardDto {\n  const now = new Date().toISOString();\n  const row: DashboardRow = {\n    id: uuidv4(),\n    tenant_id: tenantId,\n    name,\n    owner_id: ownerId,\n    config: serializeJsonColumn(config, 'config'),\n    created_at: now,\n    updated_at: now,\n  };\n\n  getDb()\n    .prepare(\n      `INSERT INTO dashboards (id, tenant_id, name, owner_id, config, created_at, updated_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`\n    )\n    .run(row.id, row.tenant_id, row.name, row.owner_id, row.config, row.created_at, row.updated_at);\n\n  return toDashboardDto(row);\n}\n\nexport function updateDashboard(\n  id: string,\n  tenantId: string,\n  updates: { name?: string; config?: unknown }\n): DashboardDto {\n  const existing = requireDashboard(id, tenantId);\n\n  const next: DashboardRow = {\n    ...existing,\n    name: updates.name ?? existing.name,\n    config:\n      updates.config === undefined\n        ? existing.config\n        : serializeJsonColumn(updates.config, 'config'),\n    updated_at: new Date().toISOString(),\n  };\n\n  getDb()\n    .prepare('UPDATE dashboards SET name = ?, config = ?, updated_at = ? WHERE id = ?')\n    .run(next.name, next.config, next