@@ -0,0 +1,41 @@
+import type { Request } from 'express';
+import { AuthError } from './errors';
+
+export type Role = 'admin' | 'editor' | 'viewer';
+
+export const ROLES: readonly Role[] = ['admin', 'editor', 'viewer'];
+
+export const WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'] as const;
+
+export type WidgetType = (typeof WIDGET_TYPES)[number];
+
+/** The caller identity attached to a request by the auth middleware. */
+export interface AuthUser {
+  id: string;
+  tenantId: string;
+  role?: Role;
+}
+
+declare global {
+  // eslint-disable-next-line @typescript-eslint/no-namespace
+  namespace Express {
+    interface Request {
+      user?: AuthUser;
+    }
+  }
+}
+
+/**
+ * Reads the authenticated caller off a request.
+ *
+ * Routers never verify tokens themselves — they only consume whatever identity
+ * the surrounding app attached — which keeps them mountable behind any auth
+ * implementation.
+ */
+export function requireUser(req: Request): AuthUser {
+  const user = req.user;
+  if (!user || typeof user.id !== 'string' || typeof user.tenantId !== 'string') {
+    throw new AuthError('Authentication required');
+  }
+  return user;
+}
