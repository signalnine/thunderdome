+}
+
+export type DashboardDto = Omit<DashboardRow, 'config'> & { config: Record<string, unknown> };
+export type WidgetDto = Omit<WidgetRow, 'config'> & { config: Record<string, unknown> };
+
+export function toDashboardDto(row: DashboardRow): DashboardDto {
+  return { ...row, config: parseJsonColumn(row.config) };
+}
+
+export function toWidgetDto(row: WidgetRow): WidgetDto {
+  return { ...row, config: parseJsonColumn(row.config) };
+}
+
+/**
+ * Loads a dashboard scoped to the tenant. A dashboard belonging to another
+ * tenant is reported as missing rather than forbidden, so IDs cannot be probed.
+ */
+export function requireDashboard(id: string, tenantId: string): DashboardRow {
+  const row = getDb()
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(id, tenantId) as DashboardRow | undefined;
+  if (!row) {
+    throw new NotFoundError('Dashboard not found');
+  }
+  return row;
+}
+
+export function listDashboards(tenantId: string): DashboardDto[] {
+  const rows = getDb()
+    .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at ASC, id ASC')
+    .all(tenantId) as DashboardRow[];
+  return rows.map(toDashboardDto);
+}
+
+export function listWidgets(dashboardId: string): WidgetDto[] {
+  const rows = getDb()
+    .prepare(
+      `SELECT * FROM widgets WHERE dashboard_id = ?
+       ORDER BY position_y ASC, position_x ASC, id ASC`
+    )
+    .all(dashboardId) as WidgetRow[];
+  return rows.map(toWidgetDto);
+}
+
+export function getDashboard(
+  id: string,
+  tenantId: string
+): DashboardDto & { widgets: WidgetDto[] } {
+  const dashboard = requireDashboard(id, tenantId);
+  return { ...toDashboardDto(dashboard), widgets: listWidgets(dashboard.id) };
+}
+
+export function createDashboard(
+  tenantId: string,
+  ownerId: string,
+  name: string,
+  config: unknown
+): DashboardDto {
+  const now = new Date().toISOString();
+  const row: DashboardRow = {
+    id: uuidv4(),
+    tenant_id: tenantId,
+    name,
+    owner_id: ownerId,
+    config: serializeJsonColumn(config, 'config'),
+    created_at: now,
+    updated_at: now,
+  };
+
+  getDb()
+    .prepare(
+      `INSERT INTO dashboards (id, tenant_id, name, owner_id, config, created_at, updated_at)
+       VALUES (?, ?, ?, ?, ?, ?, ?)`
+    )
+    .run(row.id, row.tenant_id, row.name, row.owner_id, row.config, row.created_at, row.updated_at);
+
+  return toDashboardDto(row);
+}
+
+export function updateDashboard(
+  id: string,
+  tenantId: string,
+  updates: { name?: string; config?: unknown }
+): DashboardDto {
+  const existing = requireDashboard(id, tenantId);
+
+  const next: DashboardRow = {
+    ...existing,
+    name: updates.name ?? existing.name,
+    config:
+      updates.config === undefined
+        ? existing.config
+        : serializeJsonColumn(updates.config, 'config'),
+    updated_at: new Date().toISOString(),
+  };
+
+  getDb()
+    .prepare('UPDATE dashboards SET name = ?, config = ?, updated_at = ? WHERE id = ?')
+    .run(next.name, next.config, next.updated_at, next.id);
+
+  return toDashboardDto(next);
+}
+
+export function deleteDashboard(id: string, tenantId: string): void {
+  const dashboard = requireDashboard(id, tenantId);
+  const db = getDb();
+  db.transaction(() => {
+    // Explicit, so deletion behaves the same whether or not FK enforcement is on.
+    db.prepare('DELETE FROM widgets WHERE dashboard_id = ?').run(dashboard.id);
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(dashboard.id);
+  })();
+}
+
+export function assertWidgetType(value: unknown): WidgetType {
+  if (typeof value !== 'string' || !WIDGET_TYPES.includes(value as WidgetType)) {
+    throw new ValidationError(`type must be one of: ${WIDGET_TYPES.join(', ')}`);
+  }
+  return value as WidgetType;
+}
+
+export function requireWidget(widgetId: string, dashboardId: string): WidgetRow {
+  const row = getDb()
+    .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')
+    .get(widgetId, dashboardId) as WidgetRow | undefined;
+  if (!row) {
+    throw new NotFoundError('Widget not found');
+  }
+  return row;
+}
+
+export interface WidgetInput {
+  type: WidgetType;
+  config: unknown;
+  position_x?: number;
+  position_y?: number;
+  width?: number;
+  height?: number;
+}
+
+export function createWidget(dashboardId: string, input: WidgetInput): WidgetDto {
+  const row: WidgetRow = {
+    id: uuidv4(),
+    dashboard_id: dashboardId,
+    type: input.type,
+    config: serializeJsonColumn(input.config, 'config'),
+    position_x: input.position_x ?? 0,
+    position_y: input.position_y ?? 0,
+    width: input.width ?? 1,
+    height: input.height ?? 1,
+  };
+
+  getDb()
+    .prepare(
+      `INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
+    )
+    .run(
+      row.id,
+      row.dashboard_id,
+      row.type,
+      row.config,
+      row.position_x,
+      row.position_y,
+      row.width,
+      row.height
+    );
+
+  return toWidgetDto(row);
+}
+
+export function updateWidget(
+  widgetId: string,
+  dashboardId: string,
+  body: Record<string, unknown>
+): WidgetDto {
+  const existing = requireWidget(widgetId, dashboardId);
+
+  const next: WidgetRow = {
+    ...existing,
+    type: body.type === undefined ? existing.type : assertWidgetType(body.type),
+    config:
+      body.config === undefined ? existing.config : serializeJsonColumn(body.config, 'config'),
+    position_x: optionalInt(body, 'position_x') ?? existing.position_x,
+    position_y: optionalInt(body, 'position_y') ?? existing.position_y,
+    width: optionalInt(body, 'width') ?? existing.width,
+    height: optionalInt(body, 'height') ?? existing.height,
+  };
+
+  getDb()
+    .prepare(
+      `UPDATE widgets SET type = ?, config = ?, position_x = ?, position_y = ?, width = ?, height = ?
+       WHERE id = ? AND dashboard_id = ?`
+    )
+    .run(
+      next.type,
+      next.config,
+      next.position_x,
+      next.position_y,
+      next.width,
+      next.height,
+      widgetId,
+      dashboardId
+    );
+
+  return toWidgetDto(next);
+}
+
+export function deleteWidget(widgetId: string, dashboardId: string): void {
+  const widget = requireWidget(widgetId, dashboardId);
+  getDb().prepare('DELETE FROM widgets WHERE id = ?').run(widget.id);
+}
