@@ -0,0 +1,97 @@
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ValidationError } from '../errors';
+import type { AuthUser } from '../types';
+import { asObject, optionalString, parseJsonColumn, requireString, serializeJsonColumn } from '../utils';
+
+export interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+export interface EventDto {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: Record<string, unknown>;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+export function toEventDto(row: EventRow): EventDto {
+  return { ...row, properties: parseJsonColumn(row.properties) };
+}
+
+/**
+ * Validates one inbound event. `tenant_id` always comes from the auth context,
+ * never from the payload, so a caller cannot write into another tenant.
+ */
+export function buildEvent(input: unknown, user: AuthUser, label = 'event'): EventRow {
+  const body = asObject(input, label);
+  const name = requireString(body, 'name', `${label}.name`);
+  const timestamp = optionalString(body, 'timestamp');
+
+  if (timestamp !== undefined && Number.isNaN(new Date(timestamp).getTime())) {
+    throw new ValidationError(`${label}.timestamp must be a valid ISO-8601 timestamp`);
+  }
+
+  return {
+    id: uuidv4(),
+    tenant_id: user.tenantId,
+    name,
+    properties: serializeJsonColumn(body.properties, `${label}.properties`),
+    timestamp: timestamp ?? new Date().toISOString(),
+    user_id: optionalString(body, 'user_id') ?? user.id,
+    session_id: optionalString(body, 'session_id') ?? null,
+  };
+}
+
+export function insertEvents(rows: readonly EventRow[]): EventDto[] {
+  const db = getDb();
+  const statement = db.prepare(
+    `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+     VALUES (?, ?, ?, ?, ?, ?, ?)`
+  );
+
+  const insertAll = db.transaction((batch: readonly EventRow[]) => {
+    for (const row of batch) {
+      statement.run(
+        row.id,
+        row.tenant_id,
+        row.name,
+        row.properties,
+        row.timestamp,
+        row.user_id,
+        row.session_id
+      );
+    }
+  });
+
+  insertAll(rows);
+  return rows.map(toEventDto);
+}
+
+export function ingestOne(input: unknown, user: AuthUser): EventDto {
+  return insertEvents([buildEvent(input, user)])[0];
+}
+
+export function ingestBatch(input: unknown, user: AuthUser): EventDto[] {
+  const body = asObject(input);
+  const events = body.events;
+
+  if (!Array.isArray(events)) {
+    throw new ValidationError('events must be an array');
+  }
+  if (events.length === 0) {
+    throw new ValidationError('events must contain at least one event');
+  }
+
+  const rows = events.map((event, index) => buildEvent(event, user, `events[${index}]`));
+  return insertEvents(rows);
+}
