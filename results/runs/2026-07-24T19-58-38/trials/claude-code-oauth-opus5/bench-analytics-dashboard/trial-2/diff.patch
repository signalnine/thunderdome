+import { Router } from 'express';
+import { ValidationError } from '../errors';
+import { requireUser } from '../types';
+import { asObject, optionalInt, requireString } from '../utils';
+import {
+  assertWidgetType,
+  createDashboard,
+  createWidget,
+  deleteDashboard,
+  deleteWidget,
+  getDashboard,
+  listDashboards,
+  listWidgets,
+  requireDashboard,
+  requireWidget,
+  toWidgetDto,
+  updateDashboard,
+  updateWidget,
+} from './service';
+
+const router = Router();
+
+router.get('/', (req, res) => {
+  const user = requireUser(req);
+  res.json(listDashboards(user.tenantId));
+});
+
+router.post('/', (req, res) => {
+  const user = requireUser(req);
+  const body = asObject(req.body);
+  const name = requireString(body, 'name');
+
+  res.status(201).json(createDashboard(user.tenantId, user.id, name, body.config));
+});
+
+router.get('/:id', (req, res) => {
+  const user = requireUser(req);
+  res.json(getDashboard(req.params.id, user.tenantId));
+});
+
+router.patch('/:id', (req, res) => {
+  const user = requireUser(req);
+  const body = asObject(req.body);
+
+  if (body.name === undefined && body.config === undefined) {
+    throw new ValidationError('Provide at least one of: name, config');
+  }
+  const name = body.name === undefined ? undefined : requireString(body, 'name');
+
+  res.json(updateDashboard(req.params.id, user.tenantId, { name, config: body.config }));
+});
+
+router.delete('/:id', (req, res) => {
+  const user = requireUser(req);
+  deleteDashboard(req.params.id, user.tenantId);
+  res.status(204).end();
+});
+
+// --- Widgets, always nested under a dashboard the caller's tenant owns ---
+
+router.get('/:id/widgets', (req, res) => {
+  const user = requireUser(req);
+  const dashboard = requireDashboard(req.params.id, user.tenantId);
+  res.json(listWidgets(dashboard.id));
+});
+
+router.post('/:id/widgets', (req, res) => {
+  const user = requireUser(req);
+  const dashboard = requireDashboard(req.params.id, user.tenantId);
+  const body = asObject(req.body);
+
+  res.status(201).json(
+    createWidget(dashboard.id, {
+      type: assertWidgetType(body.type),
+      config: body.config,
+      position_x: optionalInt(body, 'position_x'),
+      position_y: optionalInt(body, 'position_y'),
+      width: optionalInt(body, 'width'),
+      height: optionalInt(body, 'height'),
+    })
+  );
+});
+
+router.get('/:id/widgets/:widgetId', (req, res) => {
+  const user = requireUser(req);
+  const dashboard = requireDashboard(req.params.id, user.tenantId);
+  res.json(toWidgetDto(requireWidget(req.params.widgetId, dashboard.id)));
+});
+
+router.patch('/:id/widgets/:widgetId', (req, res) => {
+  const user = requireUser(req);
+  const dashboard = requireDashboard(req.params.id, user.tenantId);
+  res.json(updateWidget(req.params.widgetId, dashboard.id, asObject(req.body)));
+});
+
+router.delete('/:id/widgets/:widgetId', (req, res) => {
+  const user = requireUser(req);
+  const dashboard = requireDashboard(req.params.id, user.tenantId);
+  deleteWidget(req.params.widgetId, dashboard.id);
+  res.status(204).end();
+});
+
+export default router;
