@@ -0,0 +1,47 @@
+import Database from 'better-sqlite3';
+import { SCHEMA_SQL } from './schema';
+
+let current: Database.Database | null = null;
+
+/** Applies pragmas and the schema to a fresh connection. */
+export function initDb(db: Database.Database): Database.Database {
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+  db.exec(SCHEMA_SQL);
+  return db;
+}
+
+/** Creates an isolated in-memory database with the schema applied. */
+export function createTestDb(): Database.Database {
+  const db = new Database(':memory:');
+  db.pragma('foreign_keys = ON');
+  db.exec(SCHEMA_SQL);
+  return db;
+}
+
+/** Opens (or creates) a file-backed database and installs it as the active one. */
+export function openDb(file = process.env.DATABASE_PATH ?? 'analytics.db'): Database.Database {
+  const db = initDb(new Database(file));
+  setDb(db);
+  return db;
+}
+
+/** Installs `db` as the connection returned by `getDb()`. */
+export function setDb(db: Database.Database | null): void {
+  current = db;
+}
+
+export function getDb(): Database.Database {
+  if (!current) {
+    throw new Error('Database has not been initialised: call setDb() or openDb() first');
+  }
+  return current;
+}
+
+/** Closes and clears the active connection. Safe to call when none is set. */
+export function closeDb(): void {
+  if (current) {
+    current.close();
+    current = null;
+  }
+}
