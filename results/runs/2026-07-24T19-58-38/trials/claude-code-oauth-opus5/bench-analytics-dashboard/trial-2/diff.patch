+import { Router } from 'express';
+import { requireUser } from '../types';
+import { parseFilter, parseLimit } from '../query/service';
+import { asObject } from '../utils';
+import { assertFormat, eventsAsCsv, eventsAsJson, exportDashboard, exportEvents } from './service';
+
+const router = Router();
+
+router.get('/events', (req, res) => {
+  const user = requireUser(req);
+  const query = asObject(req.query, 'query');
+  const format = assertFormat(query.format);
+  const rows = exportEvents(parseFilter(query, user.tenantId), parseLimit(query));
+
+  if (format === 'csv') {
+    res.type('text/csv');
+    res.setHeader('Content-Disposition', 'attachment; filename="events.csv"');
+    res.send(eventsAsCsv(rows));
+    return;
+  }
+
+  res.json(eventsAsJson(rows));
+});
+
+router.get('/dashboard/:id', (req, res) => {
+  const user = requireUser(req);
+  res.json(exportDashboard(req.params.id, user.tenantId));
+});
+
+export default router;
