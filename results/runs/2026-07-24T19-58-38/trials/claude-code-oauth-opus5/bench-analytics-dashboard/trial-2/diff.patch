@@ -0,0 +1,65 @@
+import { getDb } from '../db';
+import { ValidationError } from '../errors';
+import type { EventRow } from '../ingest/service';
+import { toEventDto } from '../ingest/service';
+import type { EventDto } from '../ingest/service';
+import { requireDashboard, listWidgets, toDashboardDto } from '../dashboards/service';
+import type { DashboardDto, WidgetDto } from '../dashboards/service';
+import type { EventFilter } from '../query/service';
+import { buildWhere, TS_EXPR } from '../query/service';
+import { toCsv } from '../utils';
+
+export const EXPORT_FORMATS = ['json', 'csv'] as const;
+export type ExportFormat = (typeof EXPORT_FORMATS)[number];
+
+export const EVENT_COLUMNS = [
+  'id',
+  'tenant_id',
+  'name',
+  'properties',
+  'timestamp',
+  'user_id',
+  'session_id',
+] as const;
+
+export function assertFormat(value: unknown): ExportFormat {
+  if (value === undefined || value === null || value === '') {
+    return 'json';
+  }
+  if (typeof value !== 'string' || !EXPORT_FORMATS.includes(value as ExportFormat)) {
+    throw new ValidationError(`format must be one of: ${EXPORT_FORMATS.join(', ')}`);
+  }
+  return value as ExportFormat;
+}
+
+export function exportEvents(filter: EventFilter, limit?: number): EventRow[] {
+  const where = buildWhere(filter);
+  const sql = `SELECT ${EVENT_COLUMNS.join(', ')} FROM events WHERE ${where.sql}
+     ORDER BY ${TS_EXPR} ASC, rowid ASC${limit === undefined ? '' : ' LIMIT ?'}`;
+  const params = limit === undefined ? where.params : [...where.params, limit];
+  return getDb().prepare(sql).all(...params) as EventRow[];
+}
+
+export function eventsAsJson(rows: readonly EventRow[]): EventDto[] {
+  return rows.map(toEventDto);
+}
+
+/** CSV keeps `properties` as its raw JSON string so the payload stays flat. */
+export function eventsAsCsv(rows: readonly EventRow[]): string {
+  return toCsv(EVENT_COLUMNS, rows as unknown as Record<string, unknown>[]);
+}
+
+export interface DashboardExport {
+  dashboard: DashboardDto;
+  widgets: WidgetDto[];
+  exported_at: string;
+}
+
+export function exportDashboard(id: string, tenantId: string): DashboardExport {
+  const dashboard = requireDashboard(id, tenantId);
+  return {
+    dashboard: toDashboardDto(dashboard),
+    widgets: listWidgets(dashboard.id),
+    exported_at: new Date().toISOString(),
+  };
+}
