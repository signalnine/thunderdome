new file mode 100644
index 0000000..11cfffd
--- /dev/null
+++ b/src/query/service.ts
@@ -0,0 +1,224 @@
+import { getDb } from '../db';
+import { ValidationError } from '../errors';
+import { asObject, jsonPath, normalizeTimestamp, optionalPositiveInt, optionalString, requireString } from '../utils';
+
+/**
+ * Stored timestamps may be ISO-8601 (`2024-01-15T10:00:00Z`, with or without
+ * milliseconds) or SQLite's `datetime('now')` (`2024-01-15 10:00:00`). This
+ * expression reduces any of them to a comparable `YYYY-MM-DDTHH:MM:SS`.
+ */
+export const TS_EXPR = "replace(substr(timestamp, 1, 19), ' ', 'T')";
+
+export const BUCKETS = ['hour', 'day', 'week', 'month'] as const;
+export type Bucket = (typeof BUCKETS)[number];
+
+export interface EventFilter {
+  tenantId: string;
+  eventName?: string;
+  start?: string;
+  end?: string;
+  properties?: Record<string, unknown>;
+}
+
+export interface WhereClause {
+  sql: string;
+  params: unknown[];
+}
+
+/** Every query is scoped to the caller's tenant; that predicate is not optional. */
+export function buildWhere(filter: EventFilter): WhereClause {
+  const clauses = ['tenant_id = ?'];
+  const params: unknown[] = [filter.tenantId];
+
+  if (filter.eventName !== undefined) {
+    clauses.push('name = ?');
+    params.push(filter.eventName);
+  }
+  if (filter.start !== undefined) {
+    clauses.push(`${TS_EXPR} >= ?`);
+    params.push(normalizeTimestamp(filter.start, 'start'));
+  }
+  if (filter.end !== undefined) {
+    clauses.push(`${TS_EXPR} <= ?`);
+    params.push(normalizeTimestamp(filter.end, 'end'));
+  }
+  for (const [key, value] of Object.entries(filter.properties ?? {})) {
+    clauses.push('json_extract(properties, ?) = ?');
+    params.push(jsonPath(key, `filters.${key}`), value as string | number);
+  }
+
+  return { sql: clauses.join(' AND '), params };
+}
+
+/** Reads the filter fields shared by every query endpoint. */
+export function parseFilter(
+  body: Record<string, unknown>,
+  tenantId: string,
+  options: { requireEventName?: boolean } = {}
+): EventFilter {
+  const eventName = options.requireEventName
+    ? requireString(body, 'event_name')
+    : optionalString(body, 'event_name');
+
+  let properties: Record<string, unknown> | undefined;
+  if (body.filters !== undefined && body.filters !== null) {
+    properties = asObject(body.filters, 'filters');
+    for (const [key, value] of Object.entries(properties)) {
+      if (typeof value !== 'string' && typeof value !== 'number' && typeof value !== 'boolean') {
+        throw new ValidationError(`filters.${key} must be a string, number or boolean`);
+      }
+    }
+  }
+
+  return {
+    tenantId,
+    eventName,
+    start: optionalString(body, 'start'),
+    end: optionalString(body, 'end'),
+    properties,
+  };
+}
+
+export function count(filter: EventFilter): number {
+  const where = buildWhere(filter);
+  const row = getDb()
+    .prepare(`SELECT COUNT(*) AS count FROM events WHERE ${where.sql}`)
+    .get(...where.params) as { count: number };
+  return row.count;
+}
+
+export function assertBucket(value: unknown): Bucket {
+  if (value === undefined || value === null) {
+    return 'day';
+  }
+  if (typeof value !== 'string' || !BUCKETS.includes(value as Bucket)) {
+    throw new ValidationError(`bucket must be one of: ${BUCKETS.join(', ')}`);
+  }
+  return value as Bucket;
+}
+
+function bucketExpression(bucket: Bucket): string {
+  switch (bucket) {
+    case 'hour':
+      return `substr(${TS_EXPR}, 1, 13) || ':00:00'`;
+    case 'week':
+      return `strftime('%Y-W%W', ${TS_EXPR})`;
+    case 'month':
+      return `substr(${TS_EXPR}, 1, 7)`;
+    case 'day':
+    default:
+      return `substr(${TS_EXPR}, 1, 10)`;
+  }
+}
+
+export interface TimeseriesPoint {
+  bucket: string;
+  count: number;
+}
+
+export function timeseries(filter: EventFilter, bucket: Bucket): TimeseriesPoint[] {
+  const where = buildWhere(filter);
+  return getDb()
+    .prepare(
+      `SELECT ${bucketExpression(bucket)} AS bucket, COUNT(*) AS count
+       FROM events
+       WHERE ${where.sql}
+       GROUP BY bucket
+       ORDER BY bucket ASC`
+    )
+    .all(...where.params) as TimeseriesPoint[];
+}
+
+export interface BreakdownEntry {
+  property_value: string | number | boolean | null;
+  count: number;
+}
+
+export function breakdown(
+  filter: EventFilter,
+  propertyKey: string,
+  limit = 1000
+): BreakdownEntry[] {
+  const path = jsonPath(propertyKey);
+  const where = buildWhere(filter);
+  return getDb()
+    .prepare(
+      `SELECT json_extract(properties, ?) AS property_value, COUNT(*) AS count
+       FROM events
+       WHERE ${where.sql} AND json_extract(properties, ?) IS NOT NULL
+       GROUP BY property_value
+       ORDER BY count DESC, property_value ASC
+       LIMIT ?`
+    )
+    .all(path, ...where.params, path, limit) as BreakdownEntry[];
+}
+
+export interface FunnelStep {
+  step: number;
+  name: string;
+  count: number;
+  conversion_rate: number;
+}
+
+export function assertSteps(value: unknown): string[] {
+  if (!Array.isArray(value) || value.length === 0) {
+    throw new ValidationError('steps must be a non-empty array of event names');
+  }
+  return value.map((step, index) => {
+    if (typeof step !== 'string' || step.trim() === '') {
+      throw new ValidationError(`steps[${index}] must be a non-empty string`);
+    }
+    return step;
+  });
+}
+
+/**
+ * Counts how many sessions reached each step, in order.
+ *
+ * Events are grouped by session (falling back to user, then to the event itself)
+ * and replayed chronologically; ties on the truncated timestamp fall back to
+ * insertion order, so events recorded within the same second still advance the
+ * funnel in the order they arrived.
+ */
+export function funnel(filter: EventFilter, steps: readonly string[]): FunnelStep[] {
+  const where = buildWhere({ ...filter, eventName: undefined });
+  const placeholders = steps.map(() => '?').join(', ');
+
+  const rows = getDb()
+    .prepare(
+      `SELECT name, COALESCE(session_id, user_id, id) AS session_key
+       FROM events
+       WHERE ${where.sql} AND name IN (${placeholders})
+       ORDER BY ${TS_EXPR} ASC, rowid ASC`
+    )
+    .all(...where.params, ...steps) as { name: string; session_key: string }[];
+
+  const progress = new Map<string, number>();
+  for (const row of rows) {
+    const reached = progress.get(row.session_key) ?? 0;
+    if (reached < steps.length && row.name === steps[reached]) {
+      progress.set(row.session_key, reached + 1);
+    } else if (!progress.has(row.session_key)) {
+      progress.set(row.session_key, 0);
+    }
+  }
+
+  const counts = steps.map(() => 0);
+  for (const reached of progress.values()) {
+    for (let i = 0; i < reached; i += 1) {
+      counts[i] += 1;
+    }
+  }
+
+  const entered = counts[0];
+  return steps.map((name, index) => ({
+    step: index + 1,
+    name,
+    count: counts[index],
+    conversion_rate: entered === 0 ? 0 : Math.round((counts[index] / entered) * 10000) / 10000,
+  }));
+}
+
+export function parseLimit(body: Record<string, unknown>): number | undefined {
+  return optionalPositiveInt(body, 'limit');
+}
