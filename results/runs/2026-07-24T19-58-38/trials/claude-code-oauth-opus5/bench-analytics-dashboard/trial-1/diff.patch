wait request(pub()).post('/users').send({ email:'a@b.c', password:'p', tenant_id:'t1' });\n    const unknown = await request(pub()).post('/users/login').send({ email:'nope@b.c', password:'p' });\n    const wrong = await request(pub()).post('/users/login').send({ email:'a@b.c', password:'zz' });\n    expect(unknown.status).toBe(401); expect(wrong.status).toBe(401);\n    expect(unknown.body.error).toBe(wrong.body.error);\n  });\n  it('bare /me is 401, missing row is 404', async () => {\n    expect((await request(pub()).get('/users/me')).status).toBe(401);\n    expect((await request(authed('ghost','t1')).get('/users/me')).status).toBe(404);\n  });\n  it('non-admin 403, bad role 400, cross-tenant 404', async () => {\n    const a = await request(pub()).post('/users').send({ email:'ad@b.c', password:'p', tenant_id:'t1' });\n    const v = await request(pub()).post('/users').send({ email:'v@b.c', password:'p', tenant_id:'t1' });\n    const other = await request(pub()).post('/users').send({ email:'o@b.c', password:'p', tenant_id:'t2' });\n    db.prepare('UPDATE users SET role=? WHERE id=?').run('admin', a.body.id);\n    expect((await request(authed(v.body.id,'t1')).patch(`/users/${v.body.id}/role`).send({role:'admin'})).status).toBe(403);\n    expect((await request(authed(a.body.id,'t1')).patch(`/users/${v.body.id}/role`).send({role:'wizard'})).status).toBe(400);\n    expect((await request(authed(a.body.id,'t1')).patch(`/users/${other.body.id}/role`).send({role:'editor'})).status).toBe(404);\n    expect((await request(pub()).patch(`/users/${v.body.id}/role`).send({role:'editor'})).status).toBe(401);\n  });\n});\nEOF\nnpx vitest run /tmp/extra.test.ts --root=/workspace 2>&1 | tail -20","description":"Run supplementary contract checks"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":829,"cache_read_input_tokens":19344,"cache_creation":{"ephemeral_5m_input_tokens":829,"ephemeral_1h