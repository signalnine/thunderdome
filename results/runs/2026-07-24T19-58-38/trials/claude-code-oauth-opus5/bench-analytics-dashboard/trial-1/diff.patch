s Record<string, unknown>).user = { id: userId, tenantId };\n    next();\n  };\n}\n\nfunction createPublicApp() {\n  const app = express();\n  app.use(express.json());\n  app.use('/users', usersRouter);\n  app.use(errorHandler);\n  return app;\n}\n\nfunction createAuthedApp(userId: string, tenantId: string) {\n  const app = express();\n  app.use(express.json());\n  app.use(mockAuth(userId, tenantId));\n  app.use('/users', usersRouter);\n  app.use(errorHandler);\n  return app;\n}\n\ndescribe('Users Unit Tests', () => {\n  let db: Database.Database;\n\n  beforeEach(() => {\n    db = createTestDb();\n    setDb(db);\n  });\n\n  afterEach(() => {\n    closeDb();\n  });\n\n  it('should register a new user', async () => {\n    const app = createPublicApp();\n    const res = await request(app)\n      .post('/users')\n      .send({ email: 'test@example.com', password: 'pass123', tenant_id: 't1' });\n\n    expect(res.status).toBe(201);\n    expect(res.body).toHaveProperty('id');\n    expect(res.body.email).toBe('test@example.com');\n    expect(res.body.tenant_id).toBe('t1');\n    expect(res.body.role).toBe('viewer');\n  });\n\n  it('should reject duplicate email registration', async () => {\n    const app = createPublicApp();\n    await request(app)\n      .post('/users')\n      .send({ email: 'dup@example.com', password: 'pass123', tenant_id: 't1' });\n\n    const res = await request(app)\n      .post('/users')\n      .send({ email: 'dup@example.com', password: 'pass456', tenant_id: 't1' });\n\n    expect(res.status).toBe(409);\n  });\n\n  it('should login with correct credentials', async () => {\n    const app = createPublicApp();\n    await request(app)\n      .post('/users')\n      .send({ email: 'login@example.com', password: 'pass123', tenant_id: 't1' });\n\n    const res = await request(app)\n      .post('/users/login')\n      .send({ email: 'login@example.com', password: 'pass123' });\n\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty('token');\