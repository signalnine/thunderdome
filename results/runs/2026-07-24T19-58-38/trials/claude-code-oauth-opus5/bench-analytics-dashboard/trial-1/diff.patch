+/** The authenticated principal, derived from the JWT (or injected by tests). */
+export interface AuthUser {
+  id: string;
+  tenantId: string;
+}
+
+export type Role = 'admin' | 'editor' | 'viewer';
+
+export const ROLES: readonly Role[] = ['admin', 'editor', 'viewer'];
+
+declare global {
+  // eslint-disable-next-line @typescript-eslint/no-namespace
+  namespace Express {
+    interface Request {
+      user?: AuthUser;
+    }
+  }
+}
diff --git a/src/users/router.ts b/src/users/router.ts
new file mode 100644
index 0000000..b9626a0
--- /dev/null
+++ b/src/users/router.ts
@@ -0,0 +1,88 @@
+import { Router } from 'express';
+import { requireUser, signToken, verifyPassword } from '../auth';
+import { AuthError, ForbiddenError, NotFoundError, ValidationError } from '../errors';
+import { ROLES, type Role } from '../types';
+import { body, requireString } from '../validation';
+import {
+  createUser,
+  findByEmail,
+  findById,
+  findByIdInTenant,
+  toPublicUser,
+  updateRole,
+} from './service';
+
+/**
+ * User accounts. No auth middleware is installed here on purpose: the router is
+ * mounted both bare and behind an authenticating layer, so protected routes ask
+ * for the principal themselves via `requireUser`.
+ */
+const router = Router();
+
+/** Same message for unknown email and bad password, so neither is enumerable. */
+const BAD_CREDENTIALS = 'Invalid email or password';
+
+function requireRole(source: ReturnType<typeof body>): Role {
+  const value = requireString(source, 'role');
+  if (!ROLES.includes(value as Role)) {
+    throw new ValidationError(`role must be one of: ${ROLES.join(', ')}`);
+  }
+  return value as Role;
+}
+
+// POST /users - register. Public.
+router.post('/', (req, res) => {
+  const payload = body(req);
+  const email = requireString(payload, 'email');
+  const password = requireString(payload, 'password');
+  const tenantId = requireString(payload, 'tenant_id');
+
+  res.status(201).json(toPublicUser(createUser(email, password, tenantId)));
+});
+
+// POST /users/login - exchange credentials for a token. Public.
+router.post('/login', (req, res) => {
+  const payload = body(req);
+  const email = requireString(payload, 'email');
+  const password = requireString(payload, 'password');
+
+  const user = findByEmail(email);
+  if (!user || !verifyPassword(password, user.password_hash)) {
+    throw new AuthError(BAD_CREDENTIALS);
+  }
+
+  const token = signToken({ id: user.id, tenantId: user.tenant_id });
+  res.status(200).json({ token, user: toPublicUser(user) });
+});
+
+// GET /users/me - the authenticated user's own profile.
+router.get('/me', (req, res) => {
+  const principal = requireUser(req);
+  const user = findById(principal.id);
+  if (!user) {
+    throw new NotFoundError('User not found');
+  }
+  res.status(200).json(toPublicUser(user));
+});
+
+// PATCH /users/:id/role - admin-only, and only within the admin's own tenant.
+router.patch('/:id/role', (req, res) => {
+  const principal = requireUser(req);
+  const role = requireRole(body(req));
+
+  // Authority comes from the stored row, not the token, so a stale token cannot
+  // carry a role the user no longer holds.
+  const requester = findById(principal.id);
+  if (!requester || requester.role !== 'admin') {
+    throw new ForbiddenError('Admin role required');
+  }
+
+  const target = findByIdInTenant(req.params.id, requester.tenant_id);
+  if (!target) {
+    throw new NotFoundError('User not found');
+  }
+
+  res.status(200).json(toPublicUser(updateRole(target.id, role)));
+});
+
+export default router;
diff --git a/src/users/service.ts b/src/users/service.ts
new file mode 100644
index 0000000..ef56bb1
--- /dev/null
+++ b/src/users/service.ts
@@ -0,0 +1,82 @@
+import { randomUUID } from 'node:crypto';
+import { getDb } from '../db';
+import { ConflictError } from '../errors';
+import { hashPassword } from '../auth';
+import type { Role } from '../types';
+
+/** A `users` row exactly as stored, including the secret. Never leaves this module. */
+interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: Role;
+  created_at: string;
+}
+
+/** The user shape safe to serialise: `password_hash` is deliberately absent. */
+export interface PublicUser {
+  id: string;
+  email: string;
+  tenant_id: string;
+  role: Role;
+  created_at: string;
+}
+
+/** Strip the credential before a row is handed to a response. */
+export function toPublicUser(row: UserRow): PublicUser {
+  return {
+    id: row.id,
+    email: row.email,
+    tenant_id: row.tenant_id,
+    role: row.role,
+    created_at: row.created_at,
+  };
+}
+
+export function findById(id: string): UserRow | undefined {
+  return getDb().prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow | undefined;
+}
+
+export function findByEmail(email: string): UserRow | undefined {
+  return getDb().prepare('SELECT * FROM users WHERE email = ?').get(email) as UserRow | undefined;
+}
+
+/** Look a user up scoped to a tenant, so cross-tenant ids read as missing. */
+export function findByIdInTenant(id: string, tenantId: string): UserRow | undefined {
+  return getDb()
+    .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')
+    .get(id, tenantId) as UserRow | undefined;
+}
+
+/**
+ * Insert a new user. The pre-check keeps the common duplicate path readable; the
+ * UNIQUE constraint is still the authority, so a race also surfaces as a 409.
+ */
+export function createUser(email: string, password: string, tenantId: string): UserRow {
+  if (findByEmail(email)) {
+    throw new ConflictError('Email already registered');
+  }
+
+  const id = randomUUID();
+  try {
+    getDb()
+      .prepare(
+        'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'
+      )
+      .run(id, email, hashPassword(password), tenantId, 'viewer');
+  } catch (err) {
+    if (err instanceof Error && err.message.includes('UNIQUE')) {
+      throw new ConflictError('Email already registered');
+    }
+    throw err;
+  }
+
+  // The row is read back so `created_at` reflects the database default.
+  return findById(id) as UserRow;
+}
+
+export function updateRole(id: string, role: Role): UserRow {
+  getDb().prepare('UPDATE users SET role = ? WHERE id = ?').run(role, id);
+  return findById(id) as UserRow;
+}
