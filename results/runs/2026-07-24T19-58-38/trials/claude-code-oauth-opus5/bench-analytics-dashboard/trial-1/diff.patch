perties: { button: 'signup' } },\n          { name: 'page_view', properties: { page: '/about' } },\n        ],\n      });\n\n    expect(res.status).toBe(201);\n    expect(res.body.inserted).toBe(3);\n    expect(res.body.events).toHaveLength(3);\n  });\n\n  it('should reject empty batch', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app)\n      .post('/events/batch')\n      .send({ events: [] });\n\n    expect(res.status).toBe(400);\n  });\n\n  it('should set tenant_id from auth context', async () => {\n    const app = createTestApp('user1', 'tenant-abc');\n    const res = await request(app)\n      .post('/events')\n      .send({ name: 'test_event' });\n\n    expect(res.status).toBe(201);\n    expect(res.body.tenant_id).toBe('tenant-abc');\n  });\n\n  it('should accept custom timestamp', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const ts = '2024-01-15T10:30:00.000Z';\n    const res = await request(app)\n      .post('/events')\n      .send({ name: 'page_view', timestamp: ts });\n\n    expect(res.status).toBe(201);\n    expect(res.body.timestamp).toBe(ts);\n  });\n});\n","numLines":106,"startLine":1,"totalLines":106}}}
