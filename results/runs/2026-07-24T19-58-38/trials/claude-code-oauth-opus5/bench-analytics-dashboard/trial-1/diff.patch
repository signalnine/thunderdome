es.body.name).toBe('My Dashboard');\n212\t\n213\t    const listRes = await request(app)\n214\t      .get('/dashboards')\n215\t      .set('Authorization', `Bearer ${token}`);\n216\t\n217\t    expect(listRes.status).toBe(200);\n218\t    expect(listRes.body).toHaveLength(1);\n219\t  });\n220\t\n221\t  it('should get and update dashboard with real JWT', async () => {\n222\t    const token = await registerAndLogin(app, 'dashup@test.com', 'pass', TENANT_A);\n223\t\n224\t    const createRes = await request(app)\n225\t      .post('/dashboards')\n226\t      .set('Authorization', `Bearer ${token}`)\n227\t      .send({ name: 'Original' });\n228\t\n229\t    const dashId = createRes.body.id;\n230\t\n231\t    const updateRes = await request(app)\n232\t      .patch(`/dashboards/${dashId}`)\n233\t      .set('Authorization', `Bearer ${token}`)\n234\t      .send({ name: 'Updated' });\n235\t\n236\t    expect(updateRes.status).toBe(200);\n237\t    expect(updateRes.body.name).toBe('Updated');\n238\t\n239\t    const getRes = await request(app)\n240\t      .get(`/dashboards/${dashId}`)\n241\t      .set('Authorization', `Bearer ${token}`);\n242\t\n243\t    expect(getRes.status).toBe(200);\n244\t    expect(getRes.body.name).toBe('Updated');\n245\t  });\n246\t\n247\t  it('should delete dashboard with real JWT', async () => {\n248\t    const token = await registerAndLogin(app, 'dashdel@test.com', 'pass', TENANT_A);\n249\t\n250\t    const createRes = await request(app)\n251\t      .post('/dashboards')\n252\t      .set('Authorization', `Bearer ${token}`)\n253\t      .send({ name: 'To Delete' });\n254\t\n255\t    const dashId = createRes.body.id;\n256\t\n257\t    const delRes = await request(app)\n258\t      .delete(`/dashboards/${dashId}`)\n259\t      .set('Authorization', `Bearer ${token}`);\n260\t\n261\t    expect(delRes.status).toBe(204);\n262\t\n263\t    const getRes = await request(app)\n264\t      .get(`/dashboards/${dashId}`)\n265\t      .set('Authorization', `Bearer ${token}`);\n266\t\n