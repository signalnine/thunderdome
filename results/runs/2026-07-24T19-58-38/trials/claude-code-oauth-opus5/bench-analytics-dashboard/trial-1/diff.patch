nfunction resolveTimestamp(source: Body): string {\n  const raw = source.timestamp;\n  if (raw === undefined || raw === null) {\n    return new Date().toISOString();\n  }\n  if (typeof raw !== 'string' && typeof raw !== 'number') {\n    throw new ValidationError('timestamp must be an ISO-8601 string');\n  }\n  const parsed = new Date(raw);\n  if (Number.isNaN(parsed.getTime())) {\n    throw new ValidationError('timestamp must be a valid ISO-8601 date');\n  }\n  return parsed.toISOString();\n}\n\n/**\n * Validate one inbound event payload into a fully-formed row. `tenant_id` is\n * taken from the authenticated principal and never from the body, so a caller\n * cannot write into another tenant's data.\n */\nexport function buildEvent(source: Body, user: AuthUser): Event {\n  const name = requireString(source, 'name');\n  const properties = optionalObject(source, 'properties') ?? {};\n  const timestamp = resolveTimestamp(source);\n  const userId = optionalString(source, 'user_id') ?? user.id;\n  const sessionId = optionalString(source, 'session_id') ?? null;\n\n  return {\n    id: uuidv4(),\n    tenant_id: user.tenantId,\n    name,\n    properties,\n    timestamp,\n    user_id: userId,\n    session_id: sessionId,\n  };\n}\n\nfunction toRow(event: Event): EventRow {\n  return { ...event, properties: JSON.stringify(event.properties) };\n}\n\n/** Re-read an event through the JSON parser so responses match stored state. */\nfunction fromRow(row: EventRow): Event {\n  return { ...row, properties: parseJson(row.properties) };\n}\n\nexport function insertEvent(event: Event): Event {\n  getDb().prepare(INSERT_SQL).run(toRow(event));\n  return fromRow(toRow(event));\n}\n\n/** Insert a whole batch atomically: any failure leaves the table untouched. */\nexport function insertEvents(events: Event[]): Event[] {\n  const db = getDb();\n  const stmt = db.prepare(INSERT_SQL);\n  const runAll = db.transaction((rows: EventRow[]) => {\n    for (const row of rows) {\n      stmt.run(row);\n    }\n  });\n  const rows = events.map(toRow);\n  runAll(rows);\n  return rows.map(fromRow);\n}\n","structuredPatch":[{"oldStart":89,"oldLines":8,"newStart":89,"newLines":9,"lines":[" }"," "," export function insertEvent(event: Event): Event {","-  getDb().prepare(INSERT_SQL).run(toRow(event));","-  return fromRow(toRow(event));","+  const row = toRow(event);","+  getDb().prepare(INSERT_SQL).run(row);","+  return fromRow(row);"," }"," "," /** Insert a whole batch atomically: any failure leaves the table untouched. */"]}],"userModified":false,"replaceAll":false}}
