d) VALUES (?,?,?,?,?,?)');\n    ins.run(uuidv4(),'t1','page_view','{}','2024-01-15T10:00:00Z','a');\n    ins.run(uuidv4(),'t1','page_view','{}','2024-01-15T10:00:00.000Z','b');\n    const res = await request(app()).post('/query/count')\n      .send({ event_name:'page_view', start:'2024-01-15T00:00:00Z', end:'2024-01-15T23:59:59.999Z' });\n    console.log('MIXED FORMAT COUNT =', res.body.count);\n    expect(res.body.count).toBe(2);\n  });\n\n  it('never leaks another tenant', async () => {\n    const ins = db.prepare('INSERT INTO events (id,tenant_id,name,properties,timestamp,session_id) VALUES (?,?,?,?,?,?)');\n    ins.run(uuidv4(),'t1','page_view',JSON.stringify({page:'/mine'}),'2024-01-15T10:00:00Z','s1');\n    for (let i=0;i<5;i++) ins.run(uuidv4(),'t2','page_view',JSON.stringify({page:'/theirs'}),'2024-01-15T10:00:00Z','x'+i);\n\n    const c = await request(app()).post('/query/count').send({ event_name:'page_view' });\n    const b = await request(app()).post('/query/breakdown').send({ event_name:'page_view', property_key:'page' });\n    const f = await request(app()).post('/query/funnel').send({ steps:['page_view'] });\n    console.log('ISOLATION count =', c.body.count, 'breakdown =', JSON.stringify(b.body.data), 'funnel =', f.body.steps[0].count);\n    expect(c.body.count).toBe(1);\n    expect(b.body.data).toEqual([{ property_value: '/mine', count: 1 }]);\n    expect(f.body.steps[0].count).toBe(1);\n  });\n\n  it('rejects bad input and injection attempts', async () => {\n    const bad = await request(app()).post('/query/timeseries').send({ event_name:'x', bucket:'decade' });\n    const inj = await request(app()).post('/query/breakdown').send({ event_name:'x', property_key:'a\"; DROP TABLE events; --' });\n    const noSteps = await request(app()).post('/query/funnel').send({ steps: [] });\n    console.log('STATUSES bucket/propkey/steps =', bad.status, inj.status, noSteps.status);\n    expect([bad.status, inj.status, noSteps.status]).toEqual([400,400,400]);\n    