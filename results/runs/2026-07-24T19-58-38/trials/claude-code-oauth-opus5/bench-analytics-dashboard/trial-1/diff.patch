+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NqRXb9ytFUFY6a2kApXTi9","type":"tool_result","content":"1\timport { getDb } from '../db';\n2\t\n3\t/**\n4\t * Query builders for the analytics endpoints.\n5\t *\n6\t * Two invariants hold for every statement in this module:\n7\t *  - `tenant_id = ?` is always bound from the authenticated principal, so a\n8\t *    query can never observe another tenant's events.\n9\t *  - No caller-supplied value is ever concatenated into SQL. Property paths\n10\t *    travel as bound parameters to `json_extract`, and the only interpolated\n11\t *    fragments (bucket expressions) come from a fixed lookup table.\n12\t */\n13\t\n14\t/** Timestamps are stored in mixed ISO forms (`...Z` and `....000Z`), so string\n15\t * comparison is wrong; `datetime()` normalises both sides before comparing. */\n16\tconst TIME_LOWER = 'datetime(timestamp) >= datetime(?)';\n17\tconst TIME_UPPER = 'datetime(timestamp) <= datetime(?)';\n18\t\n19\texport const BUCKETS = ['hour', 'day', 'week', 'month'] as const;\n20\t\n21\texport type Bucket = (typeof BUCKETS)[number];\n22\t\n23\t/**\n24\t * Bucket key -> strftime format. Selected by an already-validated key so the\n25\t * raw request value never reaches the SQL text.\n26\t */\n27\tconst BUCKET_FORMATS: Record<Bucket, string> = {\n28\t  hour: '%Y-%m-%dT%H:00:00Z',\n29\t  day: '%Y-%m-%d',\n30\t  week: '%Y-W%W',\n31\t  month: '%Y-%m',\n32\t};\n33\t\n34\texport function isBucket(value: string): value is Bucket {\n35\t  return (BUCKETS as readonly string[]).includes(value);\n36\t}\n37\t\n38\t/** Equality filters on `properties`, keyed by JSON property name. */\n39\texport type Filters = Record<string, string>;\n40\t\n41\texport interface TimeRange {\n42\t  start?: string;\n43\t  end?: string;\n44\t}\n45\t\n46\texport interface CountQuery extends TimeRange {\n47\t  eventName: string;\n48\t  filters?: Filters;\n49\t}\n50\t\n51\texport interface TimeseriesQuery extends TimeRange {\n52\t  eventName: string;\n53\t  bucket: Bucket;\n54\t}\n55\t\n56\texport interface BreakdownQuery extends TimeRange {\n57\t  eventName: string;\n58\t  propertyKey: string;\n59\t  limit: number;\n60\t}\n61\t\n62\texport interface FunnelQuery extends TimeRange {\n63\t  steps: string[];\n64\t}\n65\t\n66\texport interface TimeseriesPoint {\n67\t  bucket: string;\n68\t  count: number;\n69\t}\n70\t\n71\texport interface BreakdownEntry {\n72\t  property_value: string;\n73\t  count: number;\n74\t}\n75\t\n76\texport interface FunnelStep {\n77\t  step: string;\n78\t  count: number;\n79\t  conversion_rate: number;\n80\t}\n81\t\n82\t/** A `$.\"key\"` path for `json_extract`. Bound as a parameter, never inlined. */\n83\texport function jsonPath(key: string): string {\n84\t  return `$.\"${key}\"`;\n85\t}\n86\t\n87\t/**\n88\t * Accumulates `WHERE` fragments alongside their bindings so the two can never\n89\t * drift out of order.\n90\t */\n91\tclass Conditions {\n92\t  private readonly clauses: string[] = [];\n93\t  private readonly params: unknown[] = [];\n94\t\n95\t  add(clause: string, ...values: unknown[]): this {\n96\t    this.clauses.push(clause);\n97\t    this.params.push(...values);\n98\t    return this;\n99\t  }\n100\t\n101\t  /** Tenant scope first: every query starts from a single tenant's events. */\n102\t  scope(tenantId: string): this {\n103\t    return this.add('tenant_id = ?', tenantId);\n104\t  }\n105\t\n106\t  range(range: TimeRange): this {\n107\t    if (range.start !== undefined) {\n108\t      this.add(TIME_LOWER, range.start);\n109\t    }\n110\t    if (range.end !== undefined) {\n111\t      this.add(TIME_UPPER, range.end);\n112\t    }\n113\t    return this;\n114\t  }\n115\t\n116\t  /** Each filter compares an extracted property to a literal, both bound. */\n117\t  filters(filters: Filters | undefined): this {\n118\t    for (const [key, value] of Object.entries(filters ?? {})) {\n119\t      this.add('json_extract(properties, ?) = ?', jsonPath(key), value);\n120\t   