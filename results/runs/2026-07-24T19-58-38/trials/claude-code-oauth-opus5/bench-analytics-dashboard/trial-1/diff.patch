+{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CdMW4GgnkcTeEEmtERPaN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Y8KdFQ2aZNjMoLgQ9yhNNm","name":"Write","input":{"file_path":"/workspace/src/export/router.ts","content":"import { Router, type Request } from 'express';\nimport { requireUser } from '../auth';\nimport { getDb } from '../db';\nimport { NotFoundError, ValidationError } from '../errors';\nimport { parseJson, type Body } from '../validation';\nimport { toCsv } from './csv';\n\n/**\n * Data export. Auth middleware is mounted by the application, not here, so every\n * handler resolves its principal with `requireUser()` and scopes every query to\n * that principal's tenant.\n */\nconst router = Router();\n\n/** A raw `events` row as it comes back from better-sqlite3. */\ninterface EventRow extends Record<string, unknown> {\n  id: string;\n  tenant_id: string;\n  name: string;\n  properties: string;\n  timestamp: string;\n  user_id: string | null;\n  session_id: string | null;\n}\n\ninterface DashboardRow {\n  id: string;\n  tenant_id: string;\n  name: string;\n  owner_id: string;\n  config: string;\n  created_at: string;\n  updated_at: string;\n}\n\ninterface WidgetRow {\n  id: string;\n  dashboard_id: string;\n  type: string;\n  config: string;\n  position_x: number;\n  position_y: number;\n  width: number;\n  height: number;\n}\n\n/** Column order of the CSV export; `id` leads the header row. */\nconst EVENT_COLUMNS = [\n  'id',\n  'tenant_id',\n  'name',\n  'properties',\n  'timestamp',\n  'user_id',\n  'session_id',\n] as const;\n\nconst FORMATS = ['json', 'csv'] as const;\ntype Format = (typeof FORMATS)[number];\n\n/** A single query-string value, rejecting repeated params rather than coercing. */\nfunction queryString(req: Request, field: string): string | undefined {\n  const value = req.query[field];\n  if (value === undefined) {\n    return undefined;\n  }\n  if (typeof value !== 'string') {\n    throw new ValidationError(`${field} must be a single value`);\n  }\n  const trimmed = value.trim();\n  return trimmed === '' ? undefined : trimmed;\n}\n\n/** Absent format defaults to json; anything outside the whitelist is a 400. */\nfunction parseFormat(req: Request): Format {\n  const value = queryString(req, 'format');\n  if (value === undefined) {\n    return 'json';\n  }\n  const format = value.toLowerCase();\n  if (!(FORMATS as readonly string[]).includes(format)) {\n    throw new ValidationError(`format must be one of: ${FORMATS.join(', ')}`);\n  }\n  return format as Format;\n}\n\n/** Optional positive-integer row cap. */\nfunction parseLimit(req: Request): number | undefined {\n  const value = queryString(req, 'limit');\n  if (value === undefined) {\n    return undefined;\n  }\n  const limit = Number(value);\n  if (!Number.isInteger(limit) || limit <= 0) {\n    throw new ValidationError('limit must be a positive integer');\n  }\n  return limit;\n}\n\n/** Fetch the tenant's events, oldest first, applying the optional filters. */\nfunction selectEvents(req: Request, tenantId: string): EventRow[] {\n  const clauses = ['tenant_id = ?'];\n  const params: (string | number)[] = [tenantId];\n\n  const eventName = queryString(req, 'event_name');\n  if (eventName !== undefined) {\n    clauses.push('name = ?');\n    params.push(eventName);\n  }\n\n  const start = queryString(req, 'start');\n  if (start !== undefined) {\n    clauses.push('timestamp >= ?');\n    params.push(start);\n  }\n\n  const end = queryString(req, 'end');\n  if (end !== undefined) {\n    clauses.push('timestamp <= ?');\n    params.push(end);\n  }\n\n  let sql = `SELECT id, tenant_id, name, properties, timestamp, user_id, session_id\n     FROM events\n     WHERE ${clauses.join(' AND ')}\n     ORDER BY timestamp ASC, id ASC`;\n\n  const limit = parseLimit(req);\n  if (limit !== undefined) {\n    sql += ' LIMIT ?';\n    params.push(limit);\n  }\n\n  return getDb().prepare(sql).all(...params) as EventRow[];\n}\n\n/** GET /export/events - the tenant's events as a JSON array or a CSV attachment. */\nrouter.get('/events', (req, res) => {\n  const user = requireUser(req);\n  // Parse the format before touching the database so a bad one fails fast.\n  const format = parseFormat(req);\n  const rows = selectEvents(req, user.tenantId);\n\n  if (format === 'csv') {\n    const filename = `events-${user.tenantId}-${Date.now()}.csv`;\n    res.setHeader('Content-Type', 'text/csv; charset=utf-8');\n    res.setHeader('Content-Disposition', `attachment; filename=\"${filename}\"`);\n    res.status(200).send(toCsv(rows, EVENT_COLUMNS));\n    return;\n  }\n\n  res.status(200).json(\n    rows.map((row) => ({\n      ...row,\n      properties: parseJson(row.properties),\n    }))\n  );\n});\n\n/** GET /export/dashboard/:id - a dashboard with its widgets, configs parsed. */\nrouter.get('/dashboard/:id', (req, res) => {\n  const user = requireUser(req);\n  const db = getDb();\n\n  // Tenant is part of the lookup, so another tenant's dashboard is a 404 rather\n  // than a 403 - the caller learns nothing about its existence.\n  const dashboard = db\n    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')\n    .get(req.params.id, user.tenantId) as DashboardRow | undefined;\n\n  if (!dashboard) {\n    throw new NotFoundError('Dashboard not found');\n  }\n\n  const widgets = db\n    .prepare(\n      `SELECT w.* FROM widgets w\n       JOIN dashboards d ON d.id = w.dashboard_id\n       WHERE w.dashboard_id = ? AND d.tenant_id = ?\n       ORDER BY w.position_y ASC, w.position_x ASC, w.id ASC`\n    )\n    .all(dashboard.id, user.tenantId) as WidgetRow[];\n\n  res.status(200).json({\n    dashboard: { ...dashboard, config: parseJson(dashboard.config) } satisfies Record<\n      string,\n      unknown\n    > & { config: Body },\n    widgets: widgets.map((widget) => ({ ...widget, config: parseJson(widget.config) })),\n  });\n});\n\nexport default router;\n"},"caller":{"type":"direc