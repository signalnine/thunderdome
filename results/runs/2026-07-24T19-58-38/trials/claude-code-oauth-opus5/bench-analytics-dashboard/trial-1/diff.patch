s = await request(app).post('/users/login').send({ email, password: 'pw' });\n  return res.body.token as string;\n}\n\ndescribe('probe', () => {\n  let app: ReturnType<typeof createApp>;\n  let db: Database.Database;\n\n  beforeEach(() => {\n    db = createTestDb();\n    setDb(db);\n    app = createApp();\n  });\n  afterEach(() => closeDb());\n\n  it('rejects a token signed with the wrong secret', async () => {\n    const forged = jwt.sign({ sub: 'x', tid: 'tenant-a' }, 'not-the-secret');\n    const res = await request(app).get('/users/me').set('Authorization', `Bearer ${forged}`);\n    expect(res.status).toBe(401);\n    expect(res.body.code).toBe('AUTH_ERROR');\n  });\n\n  it('rejects an expired token', async () => {\n    const expired = jwt.sign({ sub: 'x', tid: 't' }, 'dev-secret-change-me', { expiresIn: -10 });\n    const res = await request(app).get('/users/me').set('Authorization', `Bearer ${expired}`);\n    expect(res.status).toBe(401);\n  });\n\n  it('never leaks password_hash', async () => {\n    const token = await login(app, 'leak@t.com', 'ta');\n    const me = await request(app).get('/users/me').set('Authorization', `Bearer ${token}`);\n    expect(JSON.stringify(me.body)).not.toContain('password_hash');\n    expect(me.body.password_hash).toBeUndefined();\n  });\n\n  it('ignores tenant_id supplied in an event body', async () => {\n    const token = await login(app, 'spoof@t.com', 'ta');\n    const res = await request(app)\n      .post('/events')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'e', tenant_id: 'tenant-victim' });\n    expect(res.body.tenant_id).toBe('ta');\n  });\n\n  it('forbids a non-admin changing a role', async () => {\n    const token = await login(app, 'viewer@t.com', 'ta');\n    await request(app).post('/users').send({ email: 'v2@t.com', password: 'pw', tenant_id: 'ta' });\n    const target = db.prepare('SELECT id FROM users WHERE email = ?').get('v2@t.com') as { id: string };\n    const res = await request(app)\