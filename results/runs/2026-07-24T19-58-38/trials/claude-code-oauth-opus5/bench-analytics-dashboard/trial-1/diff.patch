toBe(400);\n    expect(res.body.code).toBe('VALIDATION_ERROR');\n  });\n\n  it('resists SQL/JSON-path injection through property_key', async () => {\n    const token = await login(app, 'inj@t.com', 'ta');\n    await request(app).post('/events').set('Authorization', `Bearer ${token}`)\n      .send({ name: 'e', properties: { page: '/a' } });\n    const res = await request(app).post('/query/breakdown').set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'e', property_key: 'page\"] , (SELECT 1) --' });\n    expect(res.status).toBe(400);\n    const n = db.prepare('SELECT COUNT(*) AS n FROM events').get() as { n: number };\n    expect(n.n).toBe(1);\n  });\n\n  it('counts a funnel correctly when every timestamp ties', async () => {\n    const token = await login(app, 'fun@t.com', 'ta');\n    const ts = '2024-03-01T12:00:00.000Z';\n    await request(app).post('/events/batch').set('Authorization', `Bearer ${token}`).send({\n      events: [\n        { name: 's1', session_id: 'a', timestamp: ts },\n        { name: 's2', session_id: 'a', timestamp: ts },\n        { name: 's3', session_id: 'a', timestamp: ts },\n        { name: 's1', session_id: 'b', timestamp: ts },\n        { name: 's2', session_id: 'b', timestamp: ts },\n      ],\n    });\n    const res = await request(app).post('/query/funnel').set('Authorization', `Bearer ${token}`)\n      .send({ steps: ['s1', 's2', 's3'] });\n    expect(res.body.steps.map((s: { count: number }) => s.count)).toEqual([2, 2, 1]);\n    expect(res.body.steps[2].conversion_rate).toBe(0.5);\n  });\n\n  it('does not count a funnel step that happened before the previous one', async () => {\n    const token = await login(app, 'ord@t.com', 'ta');\n    await request(app).post('/events/batch').set('Authorization', `Bearer ${token}`).send({\n      events: [\n        { name: 'checkout', session_id: 'z', timestamp: '2024-03-01T10:00:00Z' },\n        { name: 'view', session_id: 'z', timestamp: '2024-03-01T11:00:00Z' },\n      ],\n    });\n 