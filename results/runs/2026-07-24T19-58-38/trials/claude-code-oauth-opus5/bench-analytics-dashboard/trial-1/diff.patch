+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KtLWu4KQSoM1tW66eL9hZX","type":"tool_result","content":"1\t/**\n2\t * Minimal RFC 4180 CSV serialisation. Kept free of any domain knowledge so the\n3\t * same helper can render events, dashboards or anything else row-shaped.\n4\t */\n5\t\n6\t/** Characters that force a field to be quoted. */\n7\tconst MUST_QUOTE = /[\",\\n\\r]/;\n8\t\n9\t/**\n10\t * Render a single value as a CSV field. `null`/`undefined` become an empty\n11\t * field; anything containing a comma, quote or line break is wrapped in double\n12\t * quotes with inner quotes doubled.\n13\t */\n14\texport function escapeCsvValue(value: unknown): string {\n15\t  if (value === null || value === undefined) {\n16\t    return '';\n17\t  }\n18\t\n19\t  const text = typeof value === 'string' ? value : String(value);\n20\t  if (!MUST_QUOTE.test(text)) {\n21\t    return text;\n22\t  }\n23\t  return `\"${text.replace(/\"/g, '\"\"')}\"`;\n24\t}\n25\t\n26\t/**\n27\t * Serialise `rows` as CSV, emitting `columns` as the header row and projecting\n28\t * each row in the same order. Lines are joined with `\\n` and there is no\n29\t * trailing newline, so the line count is exactly `rows.length + 1`.\n30\t */\n31\texport function toCsv<T extends Record<string, unknown>>(\n32\t  rows: readonly T[],\n33\t  columns: readonly string[]\n34\t): string {\n35\t  const header = columns.map(escapeCsvValue).join(',');\n36\t  const body = rows.map((row) => columns.map((column) => escapeCsvValue(row[column])).join(','));\n37\t  return [header, ...body].join('\\n');\n38\t}\n39\t"}]},"parent_tool_use_id":null,"session_id":"6361eadf-da43-4c9c-9ff0-1e8c24cb2bcc","uuid":"1ac6af07-c7ad-4849-9437-e301cf85311a","timestamp":"2026-07-24T20:20:57.733Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/export/csv.ts","content":"/**\n * Minimal RFC 4180 CSV serialisation. Kept free of any domain knowledge so the\n * same helper can render events, dashboards or anything else row-shaped.\n */\n\n/** Characters that force a field to be quoted. */\nconst MUST_QUOTE = /[\",\\n\\r]/;\n\n/**\n * Render a single value as a CSV field. `null`/`undefined` become an empty\n * field; anything containing a comma, quote or line break is wrapped in double\n * quotes with inner quotes doubled.\n */\nexport function escapeCsvValue(value: unknown): string {\n  if (value === null || value === undefined) {\n    return '';\n  }\n\n  const text = typeof value === 'string' ? value : String(value);\n  if (!MUST_QUOTE.test(text)) {\n    return text;\n  }\n  return `\"${text.replace(/\"/g, '\"\"')}\"`;\n}\n\n/**\n * Serialise `rows` as CSV, emitting `columns` as the header row and projecting\n * each row in the same order. Lines are joined with `\\n` and there is no\n * trailing newline, so the line count is exactly `rows.length + 1`.\n */\nexport function toCsv<T extends Record<string, unknown>>(\n  rows: readonly T[],\n  columns: readonly string[]\n): string {\n  const header = columns.map(escapeCsvValue).join(',');\n  const body = rows.map((row) => columns.map((column) => escapeCsvValue(row[column])).join(','));\n  return [header, ...body].join('\\n');\n}\n","numLines":39,"startLine":1,"totalLines":39}}}
