new file mode 100644
index 0000000..60bdedf
--- /dev/null
+++ b/src/export/csv.ts
@@ -0,0 +1,38 @@
+/**
+ * Minimal RFC 4180 CSV serialisation. Kept free of any domain knowledge so the
+ * same helper can render events, dashboards or anything else row-shaped.
+ */
+
+/** Characters that force a field to be quoted. */
+const MUST_QUOTE = /[",\n\r]/;
+
+/**
+ * Render a single value as a CSV field. `null`/`undefined` become an empty
+ * field; anything containing a comma, quote or line break is wrapped in double
+ * quotes with inner quotes doubled.
+ */
+export function escapeCsvValue(value: unknown): string {
+  if (value === null || value === undefined) {
+    return '';
+  }
+
+  const text = typeof value === 'string' ? value : String(value);
+  if (!MUST_QUOTE.test(text)) {
+    return text;
+  }
+  return `"${text.replace(/"/g, '""')}"`;
+}
+
+/**
+ * Serialise `rows` as CSV, emitting `columns` as the header row and projecting
+ * each row in the same order. Lines are joined with `\n` and there is no
+ * trailing newline, so the line count is exactly `rows.length + 1`.
+ */
+export function toCsv<T extends Record<string, unknown>>(
+  rows: readonly T[],
+  columns: readonly string[]
+): string {
+  const header = columns.map(escapeCsvValue).join(',');
+  const body = rows.map((row) => columns.map((column) => escapeCsvValue(row[column])).join(','));
+  return [header, ...body].join('\n');
+}
diff --git a/src/export/router.ts b/src/export/router.ts
new file mode 100644
index 0000000..a0f9138
--- /dev/null
+++ b/src/export/router.ts
@@ -0,0 +1,193 @@
+import { Router, type Request } from 'express';
+import { requireUser } from '../auth';
+import { getDb } from '../db';
+import { NotFoundError, ValidationError } from '../errors';
+import { parseJson } from '../validation';
+import { toCsv } from './csv';
+
+/**
+ * Data export. Auth middleware is mounted by the application, not here, so every
+ * handler resolves its principal with `requireUser()` and scopes every query to
+ * that principal's tenant.
+ */
+const router = Router();
+
+/** A raw `events` row as it comes back from better-sqlite3. */
+interface EventRow extends Record<string, unknown> {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+/** Column order of the CSV export; `id` leads the header row. */
+const EVENT_COLUMNS = [
+  'id',
+  'tenant_id',
+  'name',
+  'properties',
+  'timestamp',
+  'user_id',
+  'session_id',
+] as const;
+
+const FORMATS = ['json', 'csv'] as const;
+type Format = (typeof FORMATS)[number];
+
+/** A single query-string value, rejecting repeated params rather than coercing. */
+function queryString(req: Request, field: string): string | undefined {
+  const value = req.query[field];
+  if (value === undefined) {
+    return undefined;
+  }
+  if (typeof value !== 'string') {
+    throw new ValidationError(`${field} must be a single value`);
+  }
+  const trimmed = value.trim();
+  return trimmed === '' ? undefined : trimmed;
+}
+
+/** Absent format defaults to json; anything outside the whitelist is a 400. */
+function parseFormat(req: Request): Format {
+  const value = queryString(req, 'format');
+  if (value === undefined) {
+    return 'json';
+  }
+  const format = value.toLowerCase();
+  if (!(FORMATS as readonly string[]).includes(format)) {
+    throw new ValidationError(`format must be one of: ${FORMATS.join(', ')}`);
+  }
+  return format as Format;
+}
+
+/** Optional positive-integer row cap. */
+function parseLimit(req: Request): number | undefined {
+  const value = queryString(req, 'limit');
+  if (value === undefined) {
+    return undefined;
+  }
+  const limit = Number(value);
+  if (!Number.isInteger(limit) || limit <= 0) {
+    throw new ValidationError('limit must be a positive integer');
+  }
+  return limit;
+}
+
+/** Fetch the tenant's events, oldest first, applying the optional filters. */
+function selectEvents(req: Request, tenantId: string): EventRow[] {
+  const clauses = ['tenant_id = ?'];
+  const params: (string | number)[] = [tenantId];
+
+  const eventName = queryString(req, 'event_name');
+  if (eventName !== undefined) {
+    clauses.push('name = ?');
+    params.push(eventName);
+  }
+
+  // Timestamps are stored in mixed ISO forms ('...Z' and '....000Z'), so a raw
+  // string comparison would misplace the boundary; datetime() normalises both
+  // sides first.
+  const start = queryString(req, 'start');
+  if (start !== undefined) {
+    clauses.push('datetime(timestamp) >= datetime(?)');
+    params.push(start);
+  }
+
+  const end = queryString(req, 'end');
+  if (end !== undefined) {
+    clauses.push('datetime(timestamp) <= datetime(?)');
+    params.push(end);
+  }
+
+  let sql = `SELECT id, tenant_id, name, properties, timestamp, user_id, session_id
+     FROM events
+     WHERE ${clauses.join(' AND ')}
+     ORDER BY timestamp ASC, id ASC`;
+
+  const limit = parseLimit(req);
+  if (limit !== undefined) {
+    sql += ' LIMIT ?';
+    params.push(limit);
+  }
+
+  return getDb().prepare(sql).all(...params) as EventRow[];
+}
+
+/** GET /export/events - the tenant's events as a JSON array or a CSV attachment. */
+router.get('/events', (req, res) => {
+  const user = requireUser(req);
+  // Parse the format before touching the database so a bad one fails fast.
+  const format = parseFormat(req);
+  const rows = selectEvents(req, user.tenantId);
+
+  if (format === 'csv') {
+    const filename = `events-${user.tenantId}-${Date.now()}.csv`;
+    res.setHeader('Content-Type', 'text/csv; charset=utf-8');
+    res.setHeader('Content-Disposition', `attachment; filename="${filename}"`);
+    res.status(200).send(toCsv(rows, EVENT_COLUMNS));
+    return;
+  }
+
+  res.status(200).json(
+    rows.map((row) => ({
+      ...row,
+      properties: parseJson(row.properties),
+    }))
+  );
+});
+
+/** GET /export/dashboard/:id - a dashboard with its widgets, configs parsed. */
+router.get('/dashboard/:id', (req, res) => {
+  const user = requireUser(req);
+  const db = getDb();
+
+  // Tenant is part of the lookup, so another tenant's dashboard is a 404 rather
+  // than a 403 - the caller learns nothing about its existence.
+  const dashboard = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(req.params.id, user.tenantId) as DashboardRow | undefined;
+
+  if (!dashboard) {
+    throw new NotFoundError('Dashboard not found');
+  }
+
+  const widgets = db
+    .prepare(
+      `SELECT w.* FROM widgets w
+       JOIN dashboards d ON d.id = w.dashboard_id
+       WHERE w.dashboard_id = ? AND d.tenant_id = ?
+       ORDER BY w.position_y ASC, w.position_x ASC, w.id ASC`
+    )
+    .all(dashboard.id, user.tenantId) as WidgetRow[];
+
+  res.status(200).json({
+    dashboard: { ...dashboard, config: parseJson(dashboard.config) },
+    widgets: widgets.map((widget) => ({ ...widget, config: parseJson(widget.config) })),
+  });
+});
+
+export default router;
diff --git a/src/ingest/router.ts b/src/ingest/router.ts
new file mode 100644
index 0000000..bfe3e02
--- /dev/null
+++ b/src/ingest/router.ts
@@ -0,0 +1,42 @@
+import { Router } from 'express';
+import { requireUser } from '../auth';
+import { ValidationError } from '../errors';
+import { body, type Body } from '../validation';
+import { buildEvent, insertEvent, insertEvents } from './service';
+
+/**
+ * Event ingestion. Auth middleware is mounted by the application, not here, so
+ * every handler resolves its principal with `requireUser()`.
+ */
+const router = Router();
+
+/** POST /events - ingest a single event. */
+router.post('/', (req, res) => {
+  const user = requireUser(req);
+  const event = buildEvent(body(req), user);
+  res.status(201).json(insertEvent(event));
+});
+
+/** POST /events/batch - ingest many events in one transaction. */
+router.post('/batch', (req, res) => {
+  const user = requireUser(req);
+  const raw = body(req).events;
+
+  if (!Array.isArray(raw) || raw.length === 0) {
+    throw new ValidationError('events must be a non-empty array');
+  }
+
+  // Validate every entry up front so an invalid item rejects the whole batch
+  // before anything is written.
+  const events = raw.map((entry) => {
+    if (typeof entry !== 'object' || entry === null || Array.isArray(entry)) {
+      throw new ValidationError('each event must be an object');
+    }
+    return buildEvent(entry as Body, user);
+  });
+
+  const inserted = insertEvents(events);
+  res.status(201).json({ inserted: inserted.length, events: inserted });
+});
+
+export default router;
diff --git a/src/ingest/service.ts b/src/ingest/service.ts
new file mode 100644
index 0000000..d4cc199
--- /dev/null
+++ b/src/ingest/service.ts
@@ -0,0 +1,109 @@
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ValidationError } from '../errors';
+import {
+  optionalObject,
+  optionalString,
+  parseJson,
+  requireString,
+  type Body,
+} from '../validation';
+import type { AuthUser } from '../types';
+
+/** An event as returned by the API: `properties` is a real object, not JSON text. */
+export interface Event {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: Body;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+/** The row shape as stored in SQLite, where `properties` is serialised JSON. */
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+const INSERT_SQL = `
+  INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+  VALUES (@id, @tenant_id, @name, @properties, @timestamp, @user_id, @session_id)
+`;
+
+/**
+ * Normalise a caller-supplied timestamp to ISO-8601 UTC, defaulting to now.
+ * An already-ISO value round-trips to exactly the same string.
+ */
+function resolveTimestamp(source: Body): string {
+  const raw = source.timestamp;
+  if (raw === undefined || raw === null) {
+    return new Date().toISOString();
+  }
+  if (typeof raw !== 'string' && typeof raw !== 'number') {
+    throw new ValidationError('timestamp must be an ISO-8601 string');
+  }
+  const parsed = new Date(raw);
+  if (Number.isNaN(parsed.getTime())) {
+    throw new ValidationError('timestamp must be a valid ISO-8601 date');
+  }
+  return parsed.toISOString();
+}
+
+/**
+ * Validate one inbound event payload into a fully-formed row. `tenant_id` is
+ * taken from the authenticated principal and never from the body, so a caller
+ * cannot write into another tenant's data.
+ */
+export function buildEvent(source: Body, user: AuthUser): Event {
+  const name = requireString(source, 'name');
+  const properties = optionalObject(source, 'properties') ?? {};
+  const timestamp = resolveTimestamp(source);
+  const userId = optionalString(source, 'user_id') ?? user.id;
+  const sessionId = optionalString(source, 'session_id') ?? null;
+
+  return {
+    id: uuidv4(),
+    tenant_id: user.tenantId,
+    name,
+    properties,
+    timestamp,
+    user_id: userId,
+    session_id: sessionId,
+  };
+}
+
+function toRow(event: Event): EventRow {
+  return { ...event, properties: JSON.stringify(event.properties) };
+}
+
+/** Re-read an event through the JSON parser so responses match stored state. */
+function fromRow(row: EventRow): Event {
+  return { ...row, properties: parseJson(row.properties) };
+}
+
+export function insertEvent(event: Event): Event {
+  const row = toRow(event);
+  getDb().prepare(INSERT_SQL).run(row);
+  return fromRow(row);
+}
+
+/** Insert a whole batch atomically: any failure leaves the table untouched. */
+export function insertEvents(events: Event[]): Event[] {
+  const db = getDb();
+  const stmt = db.prepare(INSERT_SQL);
+  const runAll = db.transaction((rows: EventRow[]) => {
+    for (const row of rows) {
+      stmt.run(row);
+    }
+  });
+  const rows = events.map(toRow);
+  runAll(rows);
+  return rows.map(fromRow);
+}
diff --git a/src/query/engine.ts b/src/query/engine.ts
new file mode 100644
index 0000000..e66fc9d
--- /dev/null
+++ b/src/query/engine.ts
@@ -0,0 +1,262 @@
+import { getDb } from '../db';
+
+/**
+ * Query builders for the analytics endpoints.
+ *
+ * Two invariants hold for every statement in this module:
+ *  - `tenant_id = ?` is always bound from the authenticated principal, so a
+ *    query can never observe another tenant's events.
+ *  - No caller-supplied value is ever concatenated into SQL. Property paths
+ *    travel as bound parameters to `json_extract`, and the only interpolated
+ *    fragments (bucket expressions) come from a fixed lookup table.
+ */
+
+/** Timestamps are stored in mixed ISO forms (`...Z` and `....000Z`), so string
+ * comparison is wrong; `datetime()` normalises both sides before comparing. */
+const TIME_LOWER = 'datetime(timestamp) >= datetime(?)';
+const TIME_UPPER = 'datetime(timestamp) <= datetime(?)';
+
+export const BUCKETS = ['hour', 'day', 'week', 'month'] as const;
+
+export type Bucket = (typeof BUCKETS)[number];
+
+/**
+ * Bucket key -> strftime format. Selected by an already-validated key so the
+ * raw request value never reaches the SQL text.
+ */
+const BUCKET_FORMATS: Record<Bucket, string> = {
+  hour: '%Y-%m-%dT%H:00:00Z',
+  day: '%Y-%m-%d',
+  week: '%Y-W%W',
+  month: '%Y-%m',
+};
+
+export function isBucket(value: string): value is Bucket {
+  return (BUCKETS as readonly string[]).includes(value);
+}
+
+/** Equality filters on `properties`, keyed by JSON property name. */
+export type Filters = Record<string, string>;
+
+export interface TimeRange {
+  start?: string;
+  end?: string;
+}
+
+export interface CountQuery extends TimeRange {
+  eventName: string;
+  filters?: Filters;
+}
+
+export interface TimeseriesQuery extends TimeRange {
+  eventName: string;
+  bucket: Bucket;
+}
+
+export interface BreakdownQuery extends TimeRange {
+  eventName: string;
+  propertyKey: string;
+  limit: number;
+}
+
+export interface FunnelQuery extends TimeRange {
+  steps: string[];
+}
+
+export interface TimeseriesPoint {
+  bucket: string;
+  count: number;
+}
+
+export interface BreakdownEntry {
+  property_value: string;
+  count: number;
+}
+
+export interface FunnelStep {
+  step: string;
+  count: number;
+  conversion_rate: number;
+}
+
+/** A `$."key"` path for `json_extract`. Bound as a parameter, never inlined. */
+export function jsonPath(key: string): string {
+  return `$."${key}"`;
+}
+
+/**
+ * Accumulates `WHERE` fragments alongside their bindings so the two can never
+ * drift out of order.
+ */
+class Conditions {
+  private readonly clauses: string[] = [];
+  private readonly params: unknown[] = [];
+
+  add(clause: string, ...values: unknown[]): this {
+    this.clauses.push(clause);
+    this.params.push(...values);
+    return this;
+  }
+
+  /** Tenant scope first: every query starts from a single tenant's events. */
+  scope(tenantId: string): this {
+    return this.add('tenant_id = ?', tenantId);
+  }
+
+  range(range: TimeRange): this {
+    if (range.start !== undefined) {
+      this.add(TIME_LOWER, range.start);
+    }
+    if (range.end !== undefined) {
+      this.add(TIME_UPPER, range.end);
+    }
+    return this;
+  }
+
+  /** Each filter compares an extracted property to a literal, both bound. */
+  filters(filters: Filters | undefined): this {
+    for (const [key, value] of Object.entries(filters ?? {})) {
+      this.add('json_extract(properties, ?) = ?', jsonPath(key), value);
+    }
+    return this;
+  }
+
+  get where(): string {
+    return this.clauses.join(' AND ');
+  }
+
+  get bindings(): unknown[] {
+    return this.params;
+  }
+}
+
+export function countEvents(tenantId: string, query: CountQuery): number {
+  const conditions = new Conditions()
+    .scope(tenantId)
+    .add('name = ?', query.eventName)
+    .range(query)
+    .filters(query.filters);
+
+  const row = getDb()
+    .prepare(`SELECT COUNT(*) AS count FROM events WHERE ${conditions.where}`)
+    .get(...conditions.bindings) as { count: number } | undefined;
+
+  return row?.count ?? 0;
+}
+
+export function timeseries(tenantId: string, query: TimeseriesQuery): TimeseriesPoint[] {
+  const conditions = new Conditions()
+    .scope(tenantId)
+    .add('name = ?', query.eventName)
+    .range(query);
+
+  // The format string comes from BUCKET_FORMATS, keyed by a validated bucket.
+  const expression = `strftime('${BUCKET_FORMATS[query.bucket]}', datetime(timestamp))`;
+
+  return getDb()
+    .prepare(
+      `SELECT ${expression} AS bucket, COUNT(*) AS count
+         FROM events
+        WHERE ${conditions.where}
+        GROUP BY bucket
+        ORDER BY bucket ASC`
+    )
+    .all(...conditions.bindings) as TimeseriesPoint[];
+}
+
+export function breakdown(tenantId: string, query: BreakdownQuery): BreakdownEntry[] {
+  const conditions = new Conditions()
+    .scope(tenantId)
+    .add('name = ?', query.eventName)
+    .range(query)
+    // Rows missing the property contribute nothing to a breakdown.
+    .add('json_extract(properties, ?) IS NOT NULL', jsonPath(query.propertyKey));
+
+  const rows = getDb()
+    .prepare(
+      `SELECT json_extract(properties, ?) AS property_value, COUNT(*) AS count
+         FROM events
+        WHERE ${conditions.where}
+        GROUP BY property_value
+        ORDER BY count DESC, property_value ASC
+        LIMIT ?`
+    )
+    .all(jsonPath(query.propertyKey), ...conditions.bindings, query.limit) as {
+    property_value: unknown;
+    count: number;
+  }[];
+
+  // json_extract yields the underlying JSON type; the API reports strings.
+  return rows.map((row) => ({
+    property_value: String(row.property_value),
+    count: row.count,
+  }));
+}
+
+interface FunnelRow {
+  name: string;
+  /** Normalised by SQLite so mixed ISO forms are string-comparable in JS. */
+  ts: string;
+  entity: string;
+}
+
+/**
+ * Count entities that completed each step in order with non-decreasing
+ * timestamps. The entity is the session, falling back to the user; events with
+ * neither are unattributable and are dropped.
+ *
+ * Comparison is `>=`, not `>`: batch-ingested events routinely share an
+ * identical millisecond timestamp, and a strict `>` would collapse such a
+ * funnel to zero after the first step.
+ */
+export function funnel(tenantId: string, query: FunnelQuery): FunnelStep[] {
+  const { steps } = query;
+  const placeholders = steps.map(() => '?').join(', ');
+  const conditions = new Conditions()
+    .scope(tenantId)
+    .add(`name IN (${placeholders})`, ...steps)
+    .range(query)
+    .add('COALESCE(session_id, user_id) IS NOT NULL');
+
+  const rows = getDb()
+    .prepare(
+      `SELECT name, datetime(timestamp) AS ts, COALESCE(session_id, user_id) AS entity
+         FROM events
+        WHERE ${conditions.where}
+        ORDER BY entity ASC, datetime(timestamp) ASC`
+    )
+    .all(...conditions.bindings) as FunnelRow[];
+
+  const counts = new Array<number>(steps.length).fill(0);
+  let entity: string | null = null;
+  let pointer = 0;
+  let reachedAt = '';
+
+  const startEntity = (next: string): void => {
+    entity = next;
+    pointer = 0;
+    reachedAt = '';
+  };
+
+  for (const row of rows) {
+    if (row.entity !== entity) {
+      startEntity(row.entity);
+    }
+    if (pointer >= steps.length) {
+      continue;
+    }
+    // Ties count: the candidate only has to be no earlier than the prior step.
+    if (row.name === steps[pointer] && (reachedAt === '' || row.ts >= reachedAt)) {
+      counts[pointer] += 1;
+      reachedAt = row.ts;
+      pointer += 1;
+    }
+  }
+
+  const total = counts[0] ?? 0;
+  return steps.map((step, index) => ({
+    step,
+    count: counts[index],
+    conversion_rate: total === 0 ? 0 : counts[index] / total,
+  }));
+}
diff --git a/src/query/router.ts b/src/query/router.ts
new file mode 100644
index 0000000..51d63e6
--- /dev/null
+++ b/src/query/router.ts
@@ -0,0 +1,172 @@
+import { Router } from 'express';
+import { requireUser } from '../auth';
+import { ValidationError } from '../errors';
+import { body, optionalInt, optionalObject, optionalString, type Body } from '../validation';
+import {
+  BUCKETS,
+  breakdown,
+  countEvents,
+  funnel,
+  isBucket,
+  timeseries,
+  type Bucket,
+  type Filters,
+  type TimeRange,
+} from './engine';
+
+/**
+ * Analytics queries over the events table.
+ *
+ * No auth middleware is installed here on purpose: the router is mounted behind
+ * an authenticating layer in the app and behind a mock in tests, so each handler
+ * asks for the principal itself via `requireUser`. Every query is scoped to that
+ * principal's tenant.
+ *
+ * Handlers are synchronous because better-sqlite3 is; failures throw and express
+ * forwards them to the shared error handler.
+ */
+const router = Router();
+
+const DEFAULT_BUCKET: Bucket = 'day';
+const DEFAULT_BREAKDOWN_LIMIT = 50;
+
+/**
+ * Property names allowed to reach `json_extract`. The path is bound as a
+ * parameter regardless, but restricting the alphabet also stops a crafted key
+ * from escaping the quoted `$."key"` path expression itself.
+ */
+const PROPERTY_KEY_PATTERN = /^[A-Za-z0-9_.-]+$/;
+
+function requireEventName(payload: Body): string {
+  const value = payload.event_name;
+  if (typeof value !== 'string' || value.trim() === '') {
+    throw new ValidationError('event_name is required');
+  }
+  return value;
+}
+
+function timeRange(payload: Body): TimeRange {
+  return {
+    start: optionalString(payload, 'start'),
+    end: optionalString(payload, 'end'),
+  };
+}
+
+function requireBucket(payload: Body): Bucket {
+  const value = optionalString(payload, 'bucket');
+  if (value === undefined) {
+    return DEFAULT_BUCKET;
+  }
+  if (!isBucket(value)) {
+    throw new ValidationError(`bucket must be one of: ${BUCKETS.join(', ')}`);
+  }
+  return value;
+}
+
+function requirePropertyKey(payload: Body): string {
+  const value = payload.property_key;
+  if (typeof value !== 'string' || value.trim() === '') {
+    throw new ValidationError('property_key is required');
+  }
+  if (!PROPERTY_KEY_PATTERN.test(value)) {
+    throw new ValidationError(
+      'property_key may only contain letters, digits, underscores, dots and hyphens'
+    );
+  }
+  return value;
+}
+
+/** Property filters are equality-only, so every value must be a string. */
+function optionalFilters(payload: Body): Filters | undefined {
+  const raw = optionalObject(payload, 'filters');
+  if (raw === undefined) {
+    return undefined;
+  }
+  const filters: Filters = {};
+  for (const [key, value] of Object.entries(raw)) {
+    if (!PROPERTY_KEY_PATTERN.test(key)) {
+      throw new ValidationError(`filters contains an invalid property name: ${key}`);
+    }
+    if (typeof value !== 'string') {
+      throw new ValidationError(`filters.${key} must be a string`);
+    }
+    filters[key] = value;
+  }
+  return filters;
+}
+
+function requireSteps(payload: Body): string[] {
+  const value = payload.steps;
+  if (!Array.isArray(value) || value.length === 0) {
+    throw new ValidationError('steps must be a non-empty array of event names');
+  }
+  return value.map((step) => {
+    if (typeof step !== 'string' || step.trim() === '') {
+      throw new ValidationError('steps must contain only non-empty event names');
+    }
+    return step;
+  });
+}
+
+// POST /query/count - how many matching events exist.
+router.post('/count', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const payload = body(req);
+
+  const count = countEvents(tenantId, {
+    eventName: requireEventName(payload),
+    filters: optionalFilters(payload),
+    ...timeRange(payload),
+  });
+
+  res.status(200).json({ count });
+});
+
+// POST /query/timeseries - matching events grouped into time buckets.
+router.post('/timeseries', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const payload = body(req);
+
+  const data = timeseries(tenantId, {
+    eventName: requireEventName(payload),
+    bucket: requireBucket(payload),
+    ...timeRange(payload),
+  });
+
+  res.status(200).json({ data });
+});
+
+// POST /query/breakdown - matching events grouped by a property value.
+router.post('/breakdown', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const payload = body(req);
+
+  const limit = optionalInt(payload, 'limit', DEFAULT_BREAKDOWN_LIMIT);
+  if (limit <= 0) {
+    throw new ValidationError('limit must be a positive integer');
+  }
+
+  const data = breakdown(tenantId, {
+    eventName: requireEventName(payload),
+    propertyKey: requirePropertyKey(payload),
+    limit,
+    ...timeRange(payload),
+  });
+
+  res.status(200).json({ data });
+});
+
+// POST /query/funnel - entities completing an ordered sequence of steps.
+router.post('/funnel', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const payload = body(req);
+
+  const steps = funnel(tenantId, {
+    steps: requireSteps(payload),
+    ...timeRange(payload),
+  });
+
+  res.status(200).json({ steps });
+});
+
+export default router;
