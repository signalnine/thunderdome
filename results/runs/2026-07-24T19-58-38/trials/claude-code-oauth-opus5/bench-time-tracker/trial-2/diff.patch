+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+
+export interface Entry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+function isEntry(value: unknown): value is Entry {
+  if (typeof value !== 'object' || value === null) return false;
+  const candidate = value as Record<string, unknown>;
+  return (
+    typeof candidate.taskName === 'string' &&
+    typeof candidate.startTime === 'string' &&
+    (candidate.endTime === null || typeof candidate.endTime === 'string')
+  );
+}
+
+export class TimeTracker {
+  private readonly filePath: string;
+  private entries: Entry[];
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = this.load();
+  }
+
+  start(taskName: string): Entry {
+    if (typeof taskName !== 'string' || taskName.trim() === '') {
+      throw new Error('taskName must be a non-empty string');
+    }
+
+    const now = new Date().toISOString();
+
+    const active = this.findActive();
+    if (active) {
+      active.endTime = now;
+    }
+
+    const entry: Entry = { taskName, startTime: now, endTime: null };
+    this.entries.push(entry);
+    this.save();
+    return { ...entry };
+  }
+
+  stop(): Entry {
+    const active = this.findActive();
+    if (!active) {
+      throw new Error('No task is currently running');
+    }
+    active.endTime = new Date().toISOString();
+    this.save();
+    return { ...active };
+  }
+
+  getActiveTask(): Entry | null {
+    const active = this.findActive();
+    return active ? { ...active } : null;
+  }
+
+  getLog(options?: { since?: Date }): Entry[] {
+    const since = options?.since;
+    if (!since) {
+      return this.entries.map((entry) => ({ ...entry }));
+    }
+
+    const sinceMs = since.getTime();
+    return this.entries
+      .filter((entry) => {
+        if (entry.endTime === null) return true;
+        if (new Date(entry.startTime).getTime() >= sinceMs) return true;
+        return new Date(entry.endTime).getTime() >= sinceMs;
+      })
+      .map((entry) => ({ ...entry }));
+  }
+
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+    const now = Date.now();
+
+    for (const entry of this.entries) {
+      const start = new Date(entry.startTime).getTime();
+      const end = entry.endTime === null ? now : new Date(entry.endTime).getTime();
+      const duration = Math.max(0, end - start);
+      summary[entry.taskName] = (summary[entry.taskName] ?? 0) + duration;
+    }
+
+    return summary;
+  }
+
+  private findActive(): Entry | undefined {
+    for (let i = this.entries.length - 1; i >= 0; i -= 1) {
+      const entry = this.entries[i];
+      if (entry.endTime === null) return entry;
+    }
+    return undefined;
+  }
+
+  private load(): Entry[] {
+    if (!existsSync(this.filePath)) return [];
+    try {
+      const raw = readFileSync(this.filePath, 'utf8');
+      if (raw.trim() === '') return [];
+      const parsed: unknown = JSON.parse(raw);
+      if (!Array.isArray(parsed)) return [];
+      return parsed.filter(isEntry);
+    } catch {
+      return [];
+    }
+  }
+
+  private save(): void {
+    const dir = dirname(this.filePath);
+    if (dir && !existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+    writeFileSync(this.filePath, `${JSON.stringify(this.entries, null, 2)}\n`, 'utf8');
+  }
+}
