+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+
+/** A single tracked time entry. */
+export interface Entry {
+  /** Name of the tracked task. */
+  taskName: string;
+  /** ISO 8601 timestamp of when tracking started. */
+  startTime: string;
+  /** ISO 8601 timestamp of when tracking stopped, or null while running. */
+  endTime: string | null;
+}
+
+/** Options accepted by {@link TimeTracker.getLog}. */
+export interface GetLogOptions {
+  /** Only return entries that overlap with or begin after this date. */
+  since?: Date;
+}
+
+function isEntry(value: unknown): value is Entry {
+  if (typeof value !== 'object' || value === null) return false;
+  const candidate = value as Record<string, unknown>;
+  return (
+    typeof candidate['taskName'] === 'string' &&
+    typeof candidate['startTime'] === 'string' &&
+    (candidate['endTime'] === null || typeof candidate['endTime'] === 'string')
+  );
+}
+
+/**
+ * Tracks task durations, persisting the log as JSON at a configurable path.
+ */
+export class TimeTracker {
+  private readonly filePath: string;
+  private entries: Entry[];
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = this.load();
+  }
+
+  /**
+   * Starts tracking `taskName`, auto-stopping any task already running.
+   * @throws if `taskName` is empty.
+   */
+  start(taskName: string): Entry {
+    if (typeof taskName !== 'string' || taskName.trim().length === 0) {
+      throw new Error('Task name must be a non-empty string');
+    }
+
+    const now = new Date().toISOString();
+    const active = this.findActive();
+    if (active) {
+      active.endTime = now;
+    }
+
+    const entry: Entry = { taskName, startTime: now, endTime: null };
+    this.entries.push(entry);
+    this.save();
+    return { ...entry };
+  }
+
+  /**
+   * Stops the currently running task.
+   * @throws if no task is running.
+   */
+  stop(): Entry {
+    const active = this.findActive();
+    if (!active) {
+      throw new Error('No task is currently running');
+    }
+
+    active.endTime = new Date().toISOString();
+    this.save();
+    return { ...active };
+  }
+
+  /** Returns the running entry, or null if nothing is active. */
+  getActiveTask(): Entry | null {
+    const active = this.findActive();
+    return active ? { ...active } : null;
+  }
+
+  /**
+   * Returns tracked entries, optionally limited to those overlapping
+   * `options.since` — entries started on or after it, still running, or
+   * ending on or after it.
+   */
+  getLog(options?: GetLogOptions): Entry[] {
+    const since = options?.since;
+    const entries = this.entries.map((entry) => ({ ...entry }));
+    if (!since) return entries;
+
+    const cutoff = since.getTime();
+    return entries.filter((entry) => {
+      if (entry.endTime === null) return true;
+      if (new Date(entry.startTime).getTime() >= cutoff) return true;
+      return new Date(entry.endTime).getTime() >= cutoff;
+    });
+  }
+
+  /** Returns total tracked milliseconds per task name. */
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+    const now = Date.now();
+
+    for (const entry of this.entries) {
+      const start = new Date(entry.startTime).getTime();
+      const end = entry.endTime === null ? now : new Date(entry.endTime).getTime();
+      const duration = Math.max(0, end - start);
+      summary[entry.taskName] = (summary[entry.taskName] ?? 0) + duration;
+    }
+
+    return summary;
+  }
+
+  private findActive(): Entry | undefined {
+    for (let i = this.entries.length - 1; i >= 0; i -= 1) {
+      const entry = this.entries[i];
+      if (entry && entry.endTime === null) return entry;
+    }
+    return undefined;
+  }
+
+  private load(): Entry[] {
+    if (!existsSync(this.filePath)) return [];
+    try {
+      const parsed: unknown = JSON.parse(readFileSync(this.filePath, 'utf8'));
+      if (!Array.isArray(parsed)) return [];
+      return parsed.filter(isEntry);
+    } catch {
+      return [];
+    }
+  }
+
+  private save(): void {
+    const dir = dirname(this.filePath);
+    if (dir && !existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+    writeFileSync(this.filePath, `${JSON.stringify(this.entries, null, 2)}\n`, 'utf8');
+  }
+}
