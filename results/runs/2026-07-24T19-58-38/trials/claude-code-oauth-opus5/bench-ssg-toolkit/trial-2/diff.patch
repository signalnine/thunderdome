@@ -0,0 +1,91 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+/**
+ * Rewrites relative asset references onto a single public prefix and records
+ * every asset it sees in a manifest on `ctx.data`.
+ */
+
+export const ASSET_MANIFEST_KEY = 'asset-manifest';
+
+export interface AssetManifest {
+  assets: string[];
+}
+
+export interface AssetPipelineOptions {
+  /** Public path that rewritten assets are served from. */
+  prefix?: string;
+}
+
+/** `src="..."` / `href="..."` in either quote style. */
+const ASSET_ATTRIBUTE = /\b(src|href)=("|')([^"']*)\2/g;
+
+/**
+ * The URL portion of a Markdown link or image, e.g. the `./a.png` in
+ * `![alt](./a.png "title")`. Handled as well as the HTML form so the plugin
+ * works whether it runs before or after the Markdown renderer.
+ */
+const MARKDOWN_TARGET = /(!?\[[^\]]*\]\(\s*)([^)\s]+)/g;
+
+/**
+ * A reference is rewritable only if it points at a file next to the content:
+ * protocol-relative, absolute, anchor and scheme URLs are all left alone.
+ */
+function isRelativeAsset(url: string): boolean {
+  if (url === '') return false;
+  if (url.startsWith('/') || url.startsWith('#') || url.startsWith('?')) return false;
+  return !/^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(url) && !url.startsWith('//');
+}
+
+/** `./img/photo.jpg` -> `img/photo.jpg` */
+function toAssetName(url: string): string {
+  return url.replace(/^\.\//, '').replace(/^\/+/, '');
+}
+
+function getManifest(ctx: BuildContext): AssetManifest {
+  const existing = ctx.data.get(ASSET_MANIFEST_KEY) as AssetManifest | undefined;
+  if (existing) return existing;
+
+  const manifest: AssetManifest = { assets: [] };
+  ctx.data.set(ASSET_MANIFEST_KEY, manifest);
+  return manifest;
+}
+
+export function createAssetPipelinePlugin(options: AssetPipelineOptions = {}): Plugin {
+  const prefix = (options.prefix ?? '/assets').replace(/\/+$/, '');
+
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, ctx: BuildContext): ContentFile {
+        const discovered: string[] = [];
+
+        const rewrite = (url: string): string => {
+          const name = toAssetName(url);
+          discovered.push(name);
+          return `${prefix}/${name}`;
+        };
+
+        const content = file.content
+          .replace(ASSET_ATTRIBUTE, (match, attribute: string, quote: string, url: string) =>
+            isRelativeAsset(url) ? `${attribute}=${quote}${rewrite(url)}${quote}` : match
+          )
+          .replace(MARKDOWN_TARGET, (match, opening: string, url: string) =>
+            isRelativeAsset(url) ? `${opening}${rewrite(url)}` : match
+          );
+
+        if (discovered.length > 0) {
+          const manifest = getManifest(ctx);
+          for (const name of discovered) {
+            if (!manifest.assets.includes(name)) {
+              manifest.assets.push(name);
+            }
+          }
+        }
+
+        return { ...file, content };
+      },
+    },
+  };
+}
