@@ -0,0 +1,75 @@
+import { BuildContext, Plugin } from '../core/types.js';
+import { ASSET_MANIFEST_KEY, AssetManifest } from './asset-pipeline.js';
+import { SEARCH_INDEX_PATH } from './search-index.js';
+
+/**
+ * Describes how a local preview server should serve the build: one route per
+ * output page, one per pipeline asset, and one for the search index.
+ * The config is published on `ctx.data` for a server process to consume.
+ */
+
+export const DEV_SERVER_CONFIG_KEY = 'dev-server-config';
+
+const DEFAULT_PORT = 3000;
+
+export type RouteHandler = 'static' | 'asset' | 'search';
+
+export interface DevServerRoute {
+  path: string;
+  handler: RouteHandler;
+}
+
+export interface DevServerConfig {
+  port: number;
+  routes: DevServerRoute[];
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+export interface DevServerOptions {
+  /** Port the preview server listens on. Defaults to 3000. */
+  port?: number;
+  /** Public path assets are served from. Must match the asset pipeline. */
+  assetPrefix?: string;
+}
+
+function readAssetPaths(ctx: BuildContext): string[] {
+  const manifest = ctx.data.get(ASSET_MANIFEST_KEY) as AssetManifest | undefined;
+  return manifest?.assets ? [...manifest.assets] : [];
+}
+
+export function createDevServerPlugin(options: DevServerOptions = {}): Plugin {
+  const port = options.port ?? DEFAULT_PORT;
+  const assetPrefix = (options.assetPrefix ?? '/assets').replace(/\/+$/, '');
+
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const assetPaths = readAssetPaths(ctx);
+
+        const routes: DevServerRoute[] = [...ctx.output.keys()]
+          .filter((path) => path.endsWith('.html'))
+          .sort()
+          .map((path) => ({ path: `/${path}`, handler: 'static' as const }));
+
+        for (const asset of assetPaths) {
+          routes.push({ path: `${assetPrefix}/${asset}`, handler: 'asset' });
+        }
+        if (ctx.output.has(SEARCH_INDEX_PATH)) {
+          routes.push({ path: `/${SEARCH_INDEX_PATH}`, handler: 'search' });
+        }
+
+        const config: DevServerConfig = {
+          port,
+          routes,
+          assetPaths,
+          searchIndexPath: `/${SEARCH_INDEX_PATH}`,
+        };
+        ctx.data.set(DEV_SERVER_CONFIG_KEY, config);
+      },
+    },
+  };
+}
