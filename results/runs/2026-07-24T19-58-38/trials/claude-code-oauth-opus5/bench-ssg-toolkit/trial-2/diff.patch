@@ -0,0 +1,46 @@
+import { BuildContext, Plugin } from '../core/types.js';
+import { escapeMarkup, normalizeBaseUrl } from './utils.js';
+
+/**
+ * Emits a sitemap covering everything already in the build output: content
+ * pages, the taxonomy listing pages, and the RSS feed. Because it reads
+ * `ctx.output`, it must run after the plugins that populate it — hence the
+ * declared dependencies.
+ */
+
+export const SITEMAP_PATH = 'sitemap.xml';
+
+const SITEMAP_NS = 'http://www.sitemaps.org/schemas/sitemap/0.9';
+
+const INDEXABLE = /\.(html|xml)$/;
+
+function indexablePaths(ctx: BuildContext): string[] {
+  return [...ctx.output.keys()]
+    .filter((path) => path !== SITEMAP_PATH && INDEXABLE.test(path))
+    .sort();
+}
+
+export function createSitemapPlugin(): Plugin {
+  return {
+    name: 'sitemap',
+    version: '1.0.0',
+    dependencies: ['taxonomy', 'rss-feed'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const baseUrl = normalizeBaseUrl(ctx.config.baseUrl);
+        const urls = indexablePaths(ctx)
+          .map((path) => `  <url>\n    <loc>${escapeMarkup(`${baseUrl}/${path}`)}</loc>\n  </url>`)
+          .join('\n');
+
+        ctx.output.set(
+          SITEMAP_PATH,
+          `<?xml version="1.0" encoding="UTF-8"?>
+<urlset xmlns="${SITEMAP_NS}">
+${urls}
+</urlset>
+`
+        );
+      },
+    },
+  };
+}
diff --git a/src/plugins/syntax-highlight.ts b/src/plugins/syntax-highlight.ts
new file mode 100644
index 0000000..be577e4
--- /dev/null
+++ b/src/plugins/syntax-highlight.ts
@@ -0,0 +1,49 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+/**
+ * Marks up fenced code blocks for client-side highlighting: the `<code>` tag
+ * gains a `highlighted` class and the wrapping `<pre>` gains a
+ * `data-language` attribute. Blocks with no language, and inline `<code>`,
+ * are left untouched.
+ */
+
+/** The `<pre ...><code ... class="...">` opening pair of a code block. */
+const CODE_BLOCK_OPENING = /<pre([^>]*)>\s*<code([^>]*)\bclass="([^"]*)"/g;
+
+const HIGHLIGHTED_CLASS = 'highlighted';
+
+function detectLanguage(classNames: string[]): string | undefined {
+  const languageClass = classNames.find((name) => name.startsWith('language-'));
+  return languageClass?.slice('language-'.length) || undefined;
+}
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile): ContentFile {
+        const content = file.content.replace(
+          CODE_BLOCK_OPENING,
+          (match, preAttrs: string, codeAttrs: string, classAttr: string) => {
+            const classNames = classAttr.split(/\s+/).filter(Boolean);
+            const language = detectLanguage(classNames);
+            if (!language) return match;
+
+            if (!classNames.includes(HIGHLIGHTED_CLASS)) {
+              classNames.push(HIGHLIGHTED_CLASS);
+            }
+            const pre = preAttrs.includes('data-language=')
+              ? preAttrs
+              : `${preAttrs} data-language="${language}"`;
+
+            return `<pre${pre}><code${codeAttrs}class="${classNames.join(' ')}"`;
+          }
+        );
+
+        return { ...file, content };
+      },
+    },
+  };
+}
diff --git a/src/plugins/taxonomy.ts b/src/plugins/taxonomy.ts
new file mode 100644
index 0000000..bed2250
--- /dev/null
+++ b/src/plugins/taxonomy.ts
@@ -0,0 +1,112 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { escapeMarkup, slugify } from './utils.js';
+
+/**
+ * Groups content by tag (and by the optional `category` metadata field) and
+ * emits a listing page for each term.
+ */
+
+export const TAG_INDEX_KEY = 'taxonomy-tags';
+export const CATEGORY_INDEX_KEY = 'taxonomy-categories';
+
+export type TaxonomyIndex = Map<string, ContentFile[]>;
+
+/** Terms are matched case-insensitively, so `JavaScript` and `JAVASCRIPT` collapse. */
+function normalizeTerm(term: string): string {
+  return term.trim().toLowerCase();
+}
+
+function addTerm(index: TaxonomyIndex, term: string, file: ContentFile): void {
+  const key = normalizeTerm(term);
+  if (!key) return;
+
+  const files = index.get(key);
+  if (files) {
+    files.push(file);
+  } else {
+    index.set(key, [file]);
+  }
+}
+
+function buildTagIndex(files: ContentFile[]): TaxonomyIndex {
+  const index: TaxonomyIndex = new Map();
+  for (const file of files) {
+    for (const tag of file.tags ?? []) {
+      addTerm(index, tag, file);
+    }
+  }
+  return index;
+}
+
+function buildCategoryIndex(files: ContentFile[]): TaxonomyIndex {
+  const index: TaxonomyIndex = new Map();
+  for (const file of files) {
+    const category = file.metadata.category;
+    if (typeof category === 'string') {
+      addTerm(index, category, file);
+    }
+  }
+  return index;
+}
+
+function renderTermPage(label: string, term: string, files: ContentFile[], siteTitle: string): string {
+  const items = files
+    .map(
+      (file) =>
+        `      <li><a href="/${escapeMarkup(file.slug)}.html">${escapeMarkup(file.title)}</a></li>`
+    )
+    .join('\n');
+
+  return `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>${escapeMarkup(term)} | ${escapeMarkup(siteTitle)}</title>
+</head>
+<body>
+  <h1>${label}: ${escapeMarkup(term)}</h1>
+  <div class="list">
+    <ul>
+${items}
+    </ul>
+  </div>
+</body>
+</html>`;
+}
+
+function renderIndexPages(
+  ctx: BuildContext,
+  index: TaxonomyIndex,
+  directory: string,
+  label: string
+): void {
+  for (const [term, files] of index) {
+    ctx.output.set(
+      `${directory}/${slugify(term)}.html`,
+      renderTermPage(label, term, files, ctx.config.title)
+    );
+  }
+}
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild(ctx: BuildContext): void {
+        ctx.data.set(TAG_INDEX_KEY, buildTagIndex(ctx.files));
+        ctx.data.set(CATEGORY_INDEX_KEY, buildCategoryIndex(ctx.files));
+      },
+
+      afterBuild(ctx: BuildContext): void {
+        const tags = (ctx.data.get(TAG_INDEX_KEY) as TaxonomyIndex | undefined) ?? new Map();
+        const categories =
+          (ctx.data.get(CATEGORY_INDEX_KEY) as TaxonomyIndex | undefined) ?? new Map();
+
+        renderIndexPages(ctx, tags, 'tags', 'Tag');
+        renderIndexPages(ctx, categories, 'categories', 'Category');
+      },
+    },
+  };
+}
diff --git a/src/plugins/utils.ts b/src/plugins/utils.ts
new file mode 100644
index 0000000..5eed417
--- /dev/null
+++ b/src/plugins/utils.ts
@@ -0,0 +1,61 @@
+/**
+ * Small helpers shared by the bundled plugins.
+ *
+ * Kept dependency-free so any plugin can import them without pulling in the
+ * rest of the toolkit.
+ */
+
+const ESCAPES: Record<string, string> = {
+  '&': '&amp;',
+  '<': '&lt;',
+  '>': '&gt;',
+  '"': '&quot;',
+  "'": '&#39;',
+};
+
+/**
+ * Escape text for embedding in markup. The entities used here are valid in
+ * both HTML and XML, so this is safe for feed/sitemap output too.
+ */
+export function escapeMarkup(value: string): string {
+  return value.replace(/[&<>"']/g, (char) => ESCAPES[char]);
+}
+
+const ENTITIES: Record<string, string> = {
+  '&amp;': '&',
+  '&lt;': '<',
+  '&gt;': '>',
+  '&quot;': '"',
+  '&#39;': "'",
+  '&apos;': "'",
+  '&nbsp;': ' ',
+};
+
+/**
+ * Strip HTML tags and collapse whitespace, yielding plain readable text.
+ *
+ * Entities are decoded only after tags are removed, so a decoded `<` can
+ * never be mistaken for markup, and a single pass over the string keeps
+ * `&amp;lt;` from decoding twice.
+ */
+export function stripHtml(html: string): string {
+  return html
+    .replace(/<[^>]*>/g, ' ')
+    .replace(/&(?:amp|lt|gt|quot|#39|apos|nbsp);/g, (entity) => ENTITIES[entity])
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+/** Drop any trailing slash so URLs can be joined with `${base}/${path}`. */
+export function normalizeBaseUrl(baseUrl: string): string {
+  return baseUrl.replace(/\/+$/, '');
+}
+
+/** Turn an arbitrary label into a filesystem/URL-safe slug. */
+export function slugify(value: string): string {
+  return value
+    .toLowerCase()
+    .trim()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
