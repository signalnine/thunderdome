diff --git a/src/plugins/markdown-ext.ts b/src/plugins/markdown-ext.ts
new file mode 100644
index 0000000..a763a5e
--- /dev/null
+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,126 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+/**
+ * Markdown renderer with two extensions beyond CommonMark:
+ *
+ *   - Footnotes:    `text[^1]` plus a `[^1]: definition` line.
+ *   - Admonitions:  `:::note` / `:::warning` / `:::tip` fenced containers.
+ */
+
+/** `[^label]: text` on its own line. */
+const FOOTNOTE_DEFINITION = /^\[\^([^\]\s]+)\]:[ \t]*(.*)$/gm;
+
+/** `[^label]` reference within the body text. */
+const FOOTNOTE_REFERENCE = /\[\^([^\]\s]+)\]/g;
+
+/** A `:::kind ... :::` container, possibly spanning many lines. */
+const ADMONITION_BLOCK = /^:::([a-zA-Z][\w-]*)[^\n]*\n([\s\S]*?)^:::[ \t]*$/gm;
+
+const ADMONITION_PLACEHOLDER = /<!--admonition:(\d+)-->/g;
+
+interface Footnote {
+  label: string;
+  number: number;
+  text: string;
+}
+
+function renderMarkdown(source: string): string {
+  return marked.parse(source, { async: false });
+}
+
+function renderInline(source: string): string {
+  return marked.parseInline(source, { async: false }).trim();
+}
+
+/**
+ * Pull `[^label]: ...` definitions out of the source and rewrite each
+ * reference to a superscript link. Footnotes are numbered by order of first
+ * reference, so `[^note]` renders as `1` when it appears first.
+ */
+function extractFootnotes(source: string): { body: string; footnotes: Footnote[] } {
+  const definitions = new Map<string, string>();
+  const body = source.replace(FOOTNOTE_DEFINITION, (_match, label: string, text: string) => {
+    definitions.set(label, text.trim());
+    return '';
+  });
+
+  if (definitions.size === 0) {
+    return { body: source, footnotes: [] };
+  }
+
+  const used = new Map<string, Footnote>();
+  const linked = body.replace(FOOTNOTE_REFERENCE, (match, label: string) => {
+    const text = definitions.get(label);
+    if (text === undefined) return match;
+
+    let footnote = used.get(label);
+    if (!footnote) {
+      footnote = { label, number: used.size + 1, text };
+      used.set(label, footnote);
+    }
+    return `<sup><a href="#fn-${footnote.number}">${footnote.number}</a></sup>`;
+  });
+
+  return { body: linked, footnotes: [...used.values()] };
+}
+
+function renderFootnoteSection(footnotes: Footnote[]): string {
+  const items = footnotes
+    .map((note) => `<li id="fn-${note.number}">${renderInline(note.text)}</li>`)
+    .join('\n');
+  return `<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+}
+
+/**
+ * Replace admonition containers with HTML comment placeholders. Comments pass
+ * through the Markdown renderer untouched, so the container bodies can be
+ * rendered separately and spliced back in afterwards.
+ */
+function extractAdmonitions(source: string): { body: string; blocks: string[] } {
+  const blocks: string[] = [];
+  const body = source.replace(ADMONITION_BLOCK, (_match, kind: string, inner: string) => {
+    const index = blocks.push(`${kind}\n${inner}`) - 1;
+    return `\n\n<!--admonition:${index}-->\n\n`;
+  });
+  return { body, blocks };
+}
+
+function restoreAdmonitions(html: string, blocks: string[]): string {
+  if (blocks.length === 0) return html;
+
+  return html.replace(ADMONITION_PLACEHOLDER, (match, rawIndex: string) => {
+    const block = blocks[Number(rawIndex)];
+    if (block === undefined) return match;
+
+    const newline = block.indexOf('\n');
+    const kind = block.slice(0, newline).toLowerCase();
+    const inner = block.slice(newline + 1);
+    return `<div class="admonition admonition-${kind}">\n${renderMarkdown(inner)}</div>`;
+  });
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile): ContentFile {
+        if (!file.content) {
+          return { ...file, content: '' };
+        }
+
+        const { body, footnotes } = extractFootnotes(file.content);
+        const { body: withoutAdmonitions, blocks } = extractAdmonitions(body);
+
+        let html = restoreAdmonitions(renderMarkdown(withoutAdmonitions), blocks);
+        if (footnotes.length > 0) {
+          html += `\n${renderFootnoteSection(footnotes)}\n`;
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
new file mode 100644
index 0000000..68f7659
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,112 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { TAG_INDEX_KEY, TaxonomyIndex } from './taxonomy.js';
+import { escapeMarkup, normalizeBaseUrl } from './utils.js';
+
+/**
+ * Emits an RSS 2.0 feed of every content file, newest first. Item bodies are
+ * the rendered HTML produced by markdown-ext; item categories come from the
+ * taxonomy index.
+ */
+
+export const FEED_PATH = 'feed.xml';
+
+export interface RssFeedOptions {
+  /** Maximum number of items in the feed. Defaults to all files. */
+  limit?: number;
+  /** Channel description; defaults to the site title. */
+  description?: string;
+}
+
+function timestampOf(file: ContentFile): number | undefined {
+  if (!file.date) return undefined;
+  const parsed = Date.parse(file.date);
+  return Number.isNaN(parsed) ? undefined : parsed;
+}
+
+/** Newest first; undated files sort to the end and keep their relative order. */
+function byDateDescending(a: ContentFile, b: ContentFile): number {
+  const left = timestampOf(a);
+  const right = timestampOf(b);
+  if (left === right) return 0;
+  if (left === undefined) return 1;
+  if (right === undefined) return -1;
+  return right - left;
+}
+
+/**
+ * Tags for a file, preferring the taxonomy index (which has already
+ * normalized casing) and falling back to the file's own tags.
+ */
+function categoriesFor(file: ContentFile, ctx: BuildContext): string[] {
+  const index = ctx.data.get(TAG_INDEX_KEY) as TaxonomyIndex | undefined;
+  if (!index) return file.tags ?? [];
+
+  const terms: string[] = [];
+  for (const [term, files] of index) {
+    if (files.some((tagged) => tagged.slug === file.slug)) {
+      terms.push(term);
+    }
+  }
+  return terms;
+}
+
+function toCdata(html: string): string {
+  // Split any literal `]]>` so it cannot terminate the section early.
+  return `<![CDATA[${html.replace(/]]>/g, ']]]]><![CDATA[>')}]]>`;
+}
+
+function renderItem(file: ContentFile, ctx: BuildContext, baseUrl: string): string {
+  const url = `${baseUrl}/${file.slug}.html`;
+  const timestamp = timestampOf(file);
+
+  const lines = [
+    '    <item>',
+    `      <title>${escapeMarkup(file.title)}</title>`,
+    `      <link>${escapeMarkup(url)}</link>`,
+    `      <guid isPermaLink="true">${escapeMarkup(url)}</guid>`,
+  ];
+
+  if (timestamp !== undefined) {
+    lines.push(`      <pubDate>${new Date(timestamp).toUTCString()}</pubDate>`);
+  }
+  for (const category of categoriesFor(file, ctx)) {
+    lines.push(`      <category>${escapeMarkup(category)}</category>`);
+  }
+  lines.push(`      <description>${toCdata(file.content.trim())}</description>`);
+  lines.push('    </item>');
+
+  return lines.join('\n');
+}
+
+export function createRssFeedPlugin(options: RssFeedOptions = {}): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const baseUrl = normalizeBaseUrl(ctx.config.baseUrl);
+        const ordered = [...ctx.files].sort(byDateDescending);
+        const items = (options.limit ? ordered.slice(0, options.limit) : ordered)
+          .map((file) => renderItem(file, ctx, baseUrl))
+          .join('\n');
+
+        const description = options.description ?? ctx.config.title;
+
+        ctx.output.set(
+          FEED_PATH,
+          `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeMarkup(ctx.config.title)}</title>
+    <link>${escapeMarkup(baseUrl)}</link>
+    <description>${escapeMarkup(description)}</description>
+${items}
+  </channel>
+</rss>
+`
+        );
+      },
+    },
+  };
+}
diff --git a/src/plugins/search-index.ts b/src/plugins/search-index.ts
new file mode 100644
index 0000000..d6e6ce0
--- /dev/null
+++ b/src/plugins/search-index.ts
@@ -0,0 +1,57 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { stripHtml } from './utils.js';
+
+/**
+ * Emits a JSON index of every page for client-side search. Content is the
+ * rendered HTML reduced to plain text — code blocks included, since they are
+ * often what readers search for.
+ */
+
+export const SEARCH_INDEX_PATH = 'search-index.json';
+
+export interface SearchIndexEntry {
+  slug: string;
+  title: string;
+  content: string;
+  tags?: string[];
+  date?: string;
+}
+
+export interface SearchIndexOptions {
+  /** Truncate indexed text to this many characters. Defaults to unlimited. */
+  maxContentLength?: number;
+}
+
+function toEntry(file: ContentFile, maxContentLength?: number): SearchIndexEntry {
+  let content = stripHtml(file.content);
+  if (maxContentLength !== undefined && content.length > maxContentLength) {
+    content = content.slice(0, maxContentLength).trimEnd();
+  }
+
+  const entry: SearchIndexEntry = {
+    slug: file.slug,
+    title: file.title,
+    content,
+  };
+  if (file.tags && file.tags.length > 0) {
+    entry.tags = [...file.tags];
+  }
+  if (file.date) {
+    entry.date = file.date;
+  }
+  return entry;
+}
+
+export function createSearchIndexPlugin(options: SearchIndexOptions = {}): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const entries = ctx.files.map((file) => toEntry(file, options.maxContentLength));
+        ctx.output.set(SEARCH_INDEX_PATH, JSON.stringify(entries, null, 2));
+      },
+    },
+  };
+}
