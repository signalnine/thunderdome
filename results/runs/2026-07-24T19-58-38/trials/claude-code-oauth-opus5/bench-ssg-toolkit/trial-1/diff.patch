@@ -0,0 +1,79 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+export const ASSET_MANIFEST_KEY = 'asset-manifest';
+
+export interface AssetManifest {
+  assets: string[];
+}
+
+/** Public prefix every local asset is served from. */
+const ASSET_PREFIX = '/assets/';
+
+/** `src="..."` / `href="..."` on any tag. */
+const URL_ATTRIBUTE = /\b(src|href)="([^"]*)"/g;
+
+/**
+ * Markdown `![alt](url)` / `[text](url)`. This plugin declares no dependencies,
+ * so the engine may schedule it either side of markdown-ext; handling both the
+ * markdown and the rendered-HTML spelling keeps it correct in either order.
+ */
+const MARKDOWN_URL = /(!?\[[^\]]*\]\()([^)\s]+)(\s*(?:"[^"]*")?\))/g;
+
+/**
+ * A URL points at a bundled asset when it is site-relative (no scheme, not
+ * already rooted at `/`) and does not name another content page.
+ */
+function isLocalAsset(url: string): boolean {
+  if (url === '') return false;
+  if (url.startsWith('/') || url.startsWith('#') || url.startsWith('?')) return false;
+  if (/^[a-z][a-z0-9+.-]*:/i.test(url)) return false;
+  return !/\.html?($|[?#])/i.test(url);
+}
+
+/** `./img/photo.jpg?v=2` -> `photo.jpg` — assets are flattened into one directory. */
+function assetName(url: string): string {
+  const path = url.split(/[?#]/)[0];
+  return path.slice(path.lastIndexOf('/') + 1);
+}
+
+function getManifest(ctx: BuildContext): AssetManifest {
+  const existing = ctx.data.get(ASSET_MANIFEST_KEY) as AssetManifest | undefined;
+  if (existing) return existing;
+  const manifest: AssetManifest = { assets: [] };
+  ctx.data.set(ASSET_MANIFEST_KEY, manifest);
+  return manifest;
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext): ContentFile => {
+        const manifest = getManifest(ctx);
+
+        /** Record the asset and return its public path, or null to leave the URL alone. */
+        const rewrite = (url: string): string | null => {
+          if (!isLocalAsset(url)) return null;
+          const name = assetName(url);
+          if (name === '') return null;
+          if (!manifest.assets.includes(name)) manifest.assets.push(name);
+          return `${ASSET_PREFIX}${name}`;
+        };
+
+        const content = file.content
+          .replace(URL_ATTRIBUTE, (match, attribute: string, url: string) => {
+            const rewritten = rewrite(url);
+            return rewritten === null ? match : `${attribute}="${rewritten}"`;
+          })
+          .replace(MARKDOWN_URL, (match, open: string, url: string, close: string) => {
+            const rewritten = rewrite(url);
+            return rewritten === null ? match : `${open}${rewritten}${close}`;
+          });
+
+        return { ...file, content };
+      },
+    },
+  };
+}
