@@ -0,0 +1,28 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+/**
+ * Opening `<pre><code class="language-xxx">` pair. Requiring the closing quote
+ * right after the language means blocks already carrying the `highlighted`
+ * class are skipped, so the transform is idempotent. Fenced blocks with no
+ * language, and inline `<code>`, do not match at all.
+ */
+const CODE_BLOCK_OPENING = /<pre([^>]*)><code class="language-([^"\s]+)"([^>]*)>/g;
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => ({
+        ...file,
+        content: file.content.replace(
+          CODE_BLOCK_OPENING,
+          (_match, preAttrs: string, language: string, codeAttrs: string) =>
+            `<pre${preAttrs} data-language="${language}">` +
+            `<code class="language-${language} highlighted"${codeAttrs}>`
+        ),
+      }),
+    },
+  };
+}
