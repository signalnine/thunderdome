@@ -0,0 +1,40 @@
+import { BuildContext, Plugin } from '../core/types.js';
+import { escapeXml, normalizeBaseUrl } from './utils.js';
+
+export const SITEMAP_PATH = 'sitemap.xml';
+
+/** Only pages and feeds belong in a sitemap — not data files such as the search index. */
+function isIndexable(path: string): boolean {
+  if (path === SITEMAP_PATH) return false;
+  return path.endsWith('.html') || path.endsWith('.xml');
+}
+
+export function createSitemapPlugin(): Plugin {
+  return {
+    name: 'sitemap',
+    version: '1.0.0',
+    // Depending on taxonomy and rss-feed guarantees their tag pages and
+    // feed.xml are already in ctx.output when this runs, so listing the
+    // output keys is enough to cover them.
+    dependencies: ['taxonomy', 'rss-feed'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const baseUrl = normalizeBaseUrl(ctx.config.baseUrl);
+        const urls = [...ctx.output.keys()]
+          .filter(isIndexable)
+          .sort()
+          .map((path) => `  <url>\n    <loc>${escapeXml(`${baseUrl}/${path}`)}</loc>\n  </url>`)
+          .join('\n');
+
+        ctx.output.set(
+          SITEMAP_PATH,
+          `<?xml version="1.0" encoding="UTF-8"?>
+<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
+${urls}
+</urlset>
+`
+        );
+      },
+    },
+  };
+}
