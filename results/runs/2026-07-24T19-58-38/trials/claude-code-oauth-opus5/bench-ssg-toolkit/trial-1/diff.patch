+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { TAXONOMY_TAGS_KEY, TaxonomyIndex } from './taxonomy.js';
+import { escapeXml, normalizeBaseUrl } from './utils.js';
+
+export const FEED_PATH = 'feed.xml';
+
+/** RSS `pubDate` must be RFC 822; unparseable or missing dates are omitted. */
+function toRfc822(date: string | undefined): string | undefined {
+  if (!date) return undefined;
+  const parsed = new Date(date);
+  return Number.isNaN(parsed.getTime()) ? undefined : parsed.toUTCString();
+}
+
+/** Undated files sort to the end of the feed. */
+function timestamp(file: ContentFile): number {
+  const parsed = file.date ? new Date(file.date).getTime() : NaN;
+  return Number.isNaN(parsed) ? -Infinity : parsed;
+}
+
+function byNewestFirst(a: ContentFile, b: ContentFile): number {
+  const left = timestamp(a);
+  const right = timestamp(b);
+  if (left === right) return 0;
+  return right > left ? 1 : -1;
+}
+
+/**
+ * Categories come from the taxonomy index when it is available, so a feed item
+ * carries the same normalized terms as the tag pages. Falls back to the file's
+ * own tags when the taxonomy plugin has not run.
+ */
+function categoriesOf(file: ContentFile, ctx: BuildContext): string[] {
+  const index = ctx.data.get(TAXONOMY_TAGS_KEY) as TaxonomyIndex | undefined;
+  if (index) {
+    const terms = [...index]
+      .filter(([, files]) => files.some((tagged) => tagged.slug === file.slug))
+      .map(([term]) => term);
+    if (terms.length > 0) return terms;
+  }
+  return file.tags ?? [];
+}
+
+function renderItem(file: ContentFile, ctx: BuildContext, baseUrl: string): string {
+  const link = `${baseUrl}/${file.slug}.html`;
+  const pubDate = toRfc822(file.date);
+  const lines = [
+    '    <item>',
+    `      <title>${escapeXml(file.title)}</title>`,
+    `      <link>${escapeXml(link)}</link>`,
+    `      <guid isPermaLink="true">${escapeXml(link)}</guid>`,
+  ];
+  if (pubDate) lines.push(`      <pubDate>${pubDate}</pubDate>`);
+  for (const category of categoriesOf(file, ctx)) {
+    lines.push(`      <category>${escapeXml(category)}</category>`);
+  }
+  // Content is already rendered HTML by this point, so it ships verbatim in CDATA.
+  lines.push(`      <description><![CDATA[${file.content}]]></description>`);
+  lines.push('    </item>');
+  return lines.join('\n');
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const baseUrl = normalizeBaseUrl(ctx.config.baseUrl);
+        const items = [...ctx.files]
+          .sort(byNewestFirst)
+          .map((file) => renderItem(file, ctx, baseUrl))
+          .join('\n');
+
+        ctx.output.set(
+          FEED_PATH,
+          `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(ctx.config.title)}</title>
+    <link>${escapeXml(baseUrl)}</link>
+    <description>${escapeXml(ctx.config.title)}</description>
+${items}
+  </channel>
+</rss>
+`
+        );
+      },
+    },
+  };
+}
