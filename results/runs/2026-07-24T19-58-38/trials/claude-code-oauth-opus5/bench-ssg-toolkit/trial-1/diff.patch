@@ -0,0 +1,79 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+import { slugify } from './utils.js';
+
+/** `[^1]: the note text` on its own line. */
+const FOOTNOTE_DEFINITION = /^[ \t]*\[\^([^\]\s]+)\]:[ \t]*(.*)$/gm;
+/** `[^1]` used inline in prose. */
+const FOOTNOTE_REFERENCE = /\[\^([^\]\s]+)\]/g;
+/** A `:::note ... :::` fenced container. */
+const ADMONITION = /^:::[ \t]*([A-Za-z][\w-]*)[ \t]*\r?\n([\s\S]*?)\r?\n?^:::[ \t]*$/gm;
+/** Marker standing in for an already-rendered admonition during markdown parsing. */
+const ADMONITION_PLACEHOLDER = /<!--admonition-(\d+)-->/g;
+
+function parseBlock(markdown: string): string {
+  return marked.parse(markdown, { async: false }) as string;
+}
+
+function parseInline(markdown: string): string {
+  return marked.parseInline(markdown, { async: false }) as string;
+}
+
+/**
+ * Render markdown to HTML with two extensions on top of CommonMark:
+ * footnotes (`[^1]` plus a collected `<section class="footnotes">`) and
+ * admonition containers (`:::note`).
+ */
+export function renderMarkdown(source: string): string {
+  // Pull footnote definitions out first so their `[^1]:` prefix is not mistaken
+  // for a reference in the next step.
+  const definitions = new Map<string, string>();
+  let body = source.replace(FOOTNOTE_DEFINITION, (_match, id: string, text: string) => {
+    definitions.set(id, text.trim());
+    return '';
+  });
+
+  // Referenced footnotes are numbered by order of first appearance.
+  const referenced: string[] = [];
+  body = body.replace(FOOTNOTE_REFERENCE, (match, id: string) => {
+    if (!definitions.has(id)) return match;
+    if (!referenced.includes(id)) referenced.push(id);
+    return `<sup><a href="#fn-${slugify(id)}">${referenced.indexOf(id) + 1}</a></sup>`;
+  });
+
+  // Admonitions are rendered ahead of time and swapped for HTML comments, which
+  // marked passes through untouched, so their inner markdown is not re-parsed.
+  const admonitions: string[] = [];
+  body = body.replace(ADMONITION, (_match, kind: string, inner: string) => {
+    const index = admonitions.length;
+    const klass = `admonition admonition-${kind.toLowerCase()}`;
+    admonitions.push(`<div class="${klass}">\n${parseBlock(inner)}</div>`);
+    return `<!--admonition-${index}-->`;
+  });
+
+  let html = parseBlock(body);
+  html = html.replace(ADMONITION_PLACEHOLDER, (_match, index: string) => admonitions[Number(index)] ?? '');
+
+  if (referenced.length > 0) {
+    const items = referenced
+      .map((id) => `<li id="fn-${slugify(id)}">${parseInline(definitions.get(id) ?? '')}</li>`)
+      .join('\n');
+    html += `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>\n`;
+  }
+
+  return html;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => ({
+        ...file,
+        content: renderMarkdown(file.content),
+      }),
+    },
+  };
+}
