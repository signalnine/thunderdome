+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { stripHtml } from './utils.js';
+
+export const SEARCH_INDEX_PATH = 'search-index.json';
+
+export interface SearchIndexEntry {
+  slug: string;
+  title: string;
+  content: string;
+  tags?: string[];
+}
+
+function toEntry(file: ContentFile): SearchIndexEntry {
+  const entry: SearchIndexEntry = {
+    slug: file.slug,
+    title: file.title,
+    // Code blocks are kept: their text is as searchable as prose.
+    content: stripHtml(file.content),
+  };
+  if (file.tags && file.tags.length > 0) entry.tags = [...file.tags];
+  return entry;
+}
+
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      // Runs after the content plugins so the indexed text matches the rendered page.
+      afterBuild: (ctx: BuildContext): void => {
+        const entries = ctx.files.map(toEntry);
+        ctx.output.set(SEARCH_INDEX_PATH, JSON.stringify(entries, null, 2));
+      },
+    },
+  };
+}
