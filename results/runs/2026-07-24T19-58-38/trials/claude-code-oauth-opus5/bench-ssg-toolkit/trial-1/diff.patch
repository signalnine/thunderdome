new file mode 100644
index 0000000..421e1aa
--- /dev/null
+++ b/src/plugins/taxonomy.ts
@@ -0,0 +1,75 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { escapeXml, slugify } from './utils.js';
+
+export const TAXONOMY_TAGS_KEY = 'taxonomy-tags';
+export const TAXONOMY_CATEGORIES_KEY = 'taxonomy-categories';
+
+export type TaxonomyIndex = Map<string, ContentFile[]>;
+
+/** Tags come from `file.tags`; a single category comes from `metadata.category`. */
+function termsOf(file: ContentFile, kind: 'tags' | 'categories'): string[] {
+  if (kind === 'tags') return file.tags ?? [];
+  const category = file.metadata.category;
+  return typeof category === 'string' ? [category] : [];
+}
+
+function buildIndex(files: ContentFile[], kind: 'tags' | 'categories'): TaxonomyIndex {
+  const index: TaxonomyIndex = new Map();
+  for (const file of files) {
+    for (const term of termsOf(file, kind)) {
+      // Terms are matched case-insensitively so `JS` and `js` share one page.
+      const key = term.toLowerCase();
+      const bucket = index.get(key);
+      if (bucket) bucket.push(file);
+      else index.set(key, [file]);
+    }
+  }
+  return index;
+}
+
+function renderTermPage(label: string, term: string, files: ContentFile[], siteTitle: string): string {
+  const items = files
+    .map((file) => `    <li><a href="/${file.slug}.html">${escapeXml(file.title)}</a></li>`)
+    .join('\n');
+  return `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>${escapeXml(label)}: ${escapeXml(term)} | ${escapeXml(siteTitle)}</title>
+</head>
+<body>
+  <h1>${escapeXml(label)}: ${escapeXml(term)}</h1>
+  <ul class="taxonomy-list">
+${items}
+  </ul>
+</body>
+</html>`;
+}
+
+function writeTermPages(ctx: BuildContext, index: TaxonomyIndex, dir: string, label: string): void {
+  for (const [term, files] of index) {
+    ctx.output.set(`${dir}/${slugify(term)}.html`, renderTermPage(label, term, files, ctx.config.title));
+  }
+}
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      // Indices are built up front so later plugins (rss-feed, sitemap) can read them.
+      beforeBuild: (ctx: BuildContext): void => {
+        ctx.data.set(TAXONOMY_TAGS_KEY, buildIndex(ctx.files, 'tags'));
+        ctx.data.set(TAXONOMY_CATEGORIES_KEY, buildIndex(ctx.files, 'categories'));
+      },
+
+      afterBuild: (ctx: BuildContext): void => {
+        const tags = ctx.data.get(TAXONOMY_TAGS_KEY) as TaxonomyIndex | undefined;
+        const categories = ctx.data.get(TAXONOMY_CATEGORIES_KEY) as TaxonomyIndex | undefined;
+        if (tags) writeTermPages(ctx, tags, 'tags', 'Tag');
+        if (categories) writeTermPages(ctx, categories, 'categories', 'Category');
+      },
+    },
+  };
+}
diff --git a/src/plugins/utils.ts b/src/plugins/utils.ts
new file mode 100644
index 0000000..1b5fa41
--- /dev/null
+++ b/src/plugins/utils.ts
@@ -0,0 +1,48 @@
+// Small helpers shared across plugins that emit XML/HTML or derive URLs.
+
+/** Escape a string for safe interpolation into XML/HTML markup. */
+export function escapeXml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+/** Tags that imply a word break; anything else (`<strong>`, `<a>`, …) is mid-sentence. */
+const BLOCK_TAG =
+  /<\/?(?:p|div|br|hr|h[1-6]|ul|ol|li|dl|dt|dd|section|article|aside|header|footer|nav|main|figure|figcaption|blockquote|pre|table|thead|tbody|tr|td|th)\b[^>]*>/gi;
+
+/**
+ * Reduce rendered HTML to plain text. Block tags become a space so adjacent
+ * blocks do not run together, while inline tags are dropped outright so
+ * `<strong>now</strong>.` reads as `now.` rather than `now .`.
+ * `&lt;`/`&gt;` are deliberately left encoded so the result never contains
+ * angle brackets that could be mistaken for markup downstream.
+ */
+export function stripHtml(html: string): string {
+  return html
+    .replace(BLOCK_TAG, ' ')
+    .replace(/<[^>]*>/g, '')
+    .replace(/&nbsp;/g, ' ')
+    .replace(/&quot;/g, '"')
+    .replace(/&#0*39;/g, "'")
+    .replace(/&amp;/g, '&')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+/** Strip trailing slashes so `${baseUrl}/${path}` never doubles up. */
+export function normalizeBaseUrl(baseUrl: string): string {
+  return baseUrl.replace(/\/+$/, '');
+}
+
+/** Lowercase a label and reduce it to a filesystem/URL-safe slug. */
+export function slugify(value: string): string {
+  return value
+    .toLowerCase()
+    .trim()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
