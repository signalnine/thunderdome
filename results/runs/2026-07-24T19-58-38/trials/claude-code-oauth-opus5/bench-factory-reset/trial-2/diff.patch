+++ b/tests/helpers.ts
@@ -0,0 +1,114 @@
+import type { Machine } from '../src/index.js';
+
+/** Deterministic PRNG so failures are reproducible. */
+export function makeRng(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state / 4294967296;
+  };
+}
+
+function betterIndices(a: number[], b: number[]): boolean {
+  if (a.length !== b.length) return a.length < b.length;
+  for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return a[i] < b[i];
+  return false;
+}
+
+/** Reference toggle solver: tries every subset of buttons. */
+export function bruteToggle(machine: Machine): number[] | null {
+  const n = machine.target.length;
+  const m = machine.buttons.length;
+  let best: number[] | null = null;
+  for (let s = 0; s < 1 << m; s++) {
+    const state = new Array<boolean>(n).fill(false);
+    const pressed: number[] = [];
+    for (let j = 0; j < m; j++) {
+      if (!((s >>> j) & 1)) continue;
+      pressed.push(j);
+      for (const light of machine.buttons[j]) {
+        if (light >= 0 && light < n) state[light] = !state[light];
+      }
+    }
+    let ok = true;
+    for (let i = 0; i < n; i++) {
+      if (state[i] !== !!machine.target[i]) {
+        ok = false;
+        break;
+      }
+    }
+    if (ok && (best === null || betterIndices(pressed, best))) best = pressed;
+  }
+  return best;
+}
+
+/** Reference counter solver: tries every press vector. */
+export function bruteCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const n = lights.length;
+  const m = buttons.length;
+  const presses = new Array<number>(m).fill(0);
+  let best: number[] | null = null;
+  let bestCost = Infinity;
+  for (;;) {
+    const counters = new Array<number>(n).fill(0);
+    let cost = 0;
+    for (let j = 0; j < m; j++) {
+      cost += presses[j];
+      for (const c of buttons[j]) {
+        if (c >= 0 && c < n) counters[c] = (counters[c] + presses[j]) % modulus;
+      }
+    }
+    let ok = true;
+    for (let i = 0; i < n; i++) {
+      if (counters[i] !== ((lights[i] % modulus) + modulus) % modulus) {
+        ok = false;
+        break;
+      }
+    }
+    if (ok && cost <= bestCost) {
+      if (best === null || cost < bestCost || betterIndices(presses, best)) {
+        best = presses.slice();
+        bestCost = cost;
+      }
+    }
+    let k = m - 1;
+    while (k >= 0 && presses[k] === modulus - 1) {
+      presses[k] = 0;
+      k--;
+    }
+    if (k < 0) break;
+    presses[k]++;
+  }
+  return best;
+}
+
+/** Applies a press vector and returns the resulting counters. */
+export function runCounters(
+  presses: number[],
+  buttons: number[][],
+  counterCount: number,
+  modulus: number,
+): number[] {
+  const counters = new Array<number>(counterCount).fill(0);
+  for (let j = 0; j < buttons.length; j++) {
+    for (const c of buttons[j]) {
+      if (c >= 0 && c < counterCount) counters[c] = (counters[c] + presses[j]) % modulus;
+    }
+  }
+  return counters;
+}
+
+/** Applies a set of button presses and returns the resulting lights. */
+export function runToggles(pressed: number[], buttons: number[][], lightCount: number): boolean[] {
+  const state = new Array<boolean>(lightCount).fill(false);
+  for (const j of pressed) {
+    for (const light of buttons[j]) {
+      if (light >= 0 && light < lightCount) state[light] = !state[light];
+    }
+  }
+  return state;
+}
