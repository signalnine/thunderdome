+  let bestLow = -1;
+  let bestHigh = -1;
+  curLo = 0;
+  curHi = 0;
+  const highTotal = 2 ** highCount;
+  for (let i = 0; i < highTotal; i++) {
+    if (i > 0) {
+      const flipped = ctz32(i);
+      curLo ^= colLo[lowCount + flipped];
+      curHi ^= colHi[lowCount + flipped];
+    }
+    const low = lookup(targetLo ^ curLo, targetHi ^ curHi);
+    if (low < 0) continue;
+    const high = i ^ (i >>> 1);
+    if (bestLow < 0 || betterPair(low, high, bestLow, bestHigh)) {
+      bestLow = low;
+      bestHigh = high;
+    }
+  }
+  if (bestLow < 0) return null;
+
+  const pressed: number[] = [];
+  for (let j = 0; j < lowCount; j++) if ((bestLow >>> j) & 1) pressed.push(j);
+  for (let j = 0; j < highCount; j++) if ((bestHigh >>> j) & 1) pressed.push(lowCount + j);
+  return pressed;
+}
+
+/** Ranks two subsets drawn from the same index range. */
+function betterSubset(a: number, b: number): boolean {
+  const pa = popcount32(a);
+  const pb = popcount32(b);
+  if (pa !== pb) return pa < pb;
+  const diff = a ^ b;
+  if (diff === 0) return false;
+  return (a & (diff & -diff)) !== 0;
+}
+
+/** Ranks two split subsets; the low half holds the smaller button indices. */
+function betterPair(aLow: number, aHigh: number, bLow: number, bHigh: number): boolean {
+  const pa = popcount32(aLow) + popcount32(aHigh);
+  const pb = popcount32(bLow) + popcount32(bHigh);
+  if (pa !== pb) return pa < pb;
+  if (aLow !== bLow) {
+    const diff = aLow ^ bLow;
+    return (aLow & (diff & -diff)) !== 0;
+  }
+  if (aHigh !== bHigh) {
+    const diff = aHigh ^ bHigh;
+    return (aHigh & (diff & -diff)) !== 0;
+  }
+  return false;
+}
