+  // The table only covers the low half, so cap it: a lopsided split costs more
+  // lookups but keeps memory bounded.
+  const lowCount = Math.min(m >>> 1, 21);
+  const highCount = m - lowCount;
+  const lowTotal = 2 ** lowCount;
+
+  // Open addressed table: light pattern -> cheapest subset of the low half
+  // that produces it.
+  let capacity = 4;
+  while (capacity < lowTotal * 2) capacity *= 2;
+  const mask = capacity - 1;
+  const keyLo = new Int32Array(capacity);
+  const keyHi = new Int32Array(capacity);
+  const value = new Int32Array(capacity);
+  const used = new Uint8Array(capacity);
+
+  const slotFor = (lo: number, hi: number): number => {
+    let h = Math.imul(lo, 0x9e3779b1) ^ Math.imul(hi + 0x165667b1, 0x85ebca6b);
+    h ^= h >>> 15;
+    h = Math.imul(h, 0x2545f491);
+    return (h ^ (h >>> 13)) & mask;
+  };
+
+  const insert = (lo: number, hi: number, subset: number): void => {
+    let slot = slotFor(lo, hi);
+    for (;;) {
+      if (!used[slot]) {
+        used[slot] = 1;
+        keyLo[slot] = lo;
+        keyHi[slot] = hi;
+        value[slot] = subset;
+        return;
+      }
+      if (keyLo[slot] === lo && keyHi[slot] === hi) {
+        if (betterSubset(subset, value[slot])) value[slot] = subset;
+        return;
+      }
+      slot = (slot + 1) & mask;
+    }
+  };
+
+  const lookup = (lo: number, hi: number): number => {
+    let slot = slotFor(lo, hi);
+    for (;;) {
+      if (!used[slot]) return -1;
+      if (keyLo[slot] === lo && keyHi[slot] === hi) return value[slot];
+      slot = (slot + 1) & mask;
+    }
+  };
+
+  let curLo = 0;
+  let curHi = 0;
+  insert(0, 0, 0);
+  for (let i = 1; i < lowTotal; i++) {
+    const flipped = ctz32(i);
+    curLo ^= colLo[flipped];
+    curHi ^= colHi[flipped];
+    insert(curLo, curHi, i ^ (i >>> 1));
+  }
