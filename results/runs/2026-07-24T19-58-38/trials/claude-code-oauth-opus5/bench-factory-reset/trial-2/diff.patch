tion at that\n    // total, the tie break is settled too. This is what rescues a machine with\n    // a huge null space but a cheap answer, where plain depth first search\n    // disappears into one corner of the tree.\n    deadline = startedAt + SEARCH_BUDGET_MS * 0.6;\n    let proven = false;\n    for (let ceiling = 0; ceiling <= bestCost; ceiling++) {\n      cap = ceiling;\n      reachedLeaf = false;\n      search(0, levels[0], 0, baseSettled);\n      if (aborted) break;\n      if (reachedLeaf) {\n        proven = true;\n        break;\n      }\n    }\n    if (!proven) {\n      // Out of time without a proof: spend what is left improving the incumbent.\n      aborted = false;\n      cap = Infinity;\n      deadline = startedAt + SEARCH_BUDGET_MS;\n      search(0, levels[0], 0, baseSettled);\n    }\n  }\n\n  return best === null ? null : Array.from(best);\n}\n\n/**\n * Assignment order for the free variables. A pivot counter can only be charged\n * to the bound once every free variable it depends on is assigned, so we\n * greedily pick the variable that finalises the most counters next. On a dense\n * system this changes nothing; on a sparse one it makes the bound bite early.\n */\nfunction orderFreeColumns(\n  mat: Int32Array,\n  stride: number,\n  rank: number,\n  freeCols: number[],\n): number[] {\n  const free = freeCols.length;\n  const pending = new Int32Array(rank);\n  for (let i = 0; i < rank; i++) {\n    for (let k = 0; k < free; k++) {\n      if (mat[i * stride + freeCols[k]] !== 0) pending[i]++;\n    }\n  }\n\n  const taken = new Uint8Array(free);\n  const order: number[] = [];\n  for (let step = 0; step < free; step++) {\n    let choice = -1;\n    let settles = -1;\n    for (let k = 0; k < free; k++) {\n      if (taken[k]) continue;\n      let count = 0;\n      for (let i = 0; i < rank; i++) {\n        if (pending[i] === 1 && mat[i * stride + freeCols[k]] !== 0) count++;\n      }\n      if (count > settles) {\n        settles = count;\n        choice = k;\n      }\n    }\n    taken[choice] = 1;\n    order.push(freeCols[choice]);\n    for (let i = 0; i < rank; i++) {\n      if (mat[i * stride + freeCols[choice]] !== 0) pending[i]--;\n    }\n  }\n  return order;\n}\n\n/**\n * Retunes one free variable at a time, keeping any change that lowers the total\n * press count, until a full sweep finds no improvement.\n */\nfunction coordinateDescent(\n  rootPivots: Int32Array,\n  pivotBasis: Int32Array[],\n  p: number,\n  record: (pivots: Int32Array, presses: Int32Array, cost: number) => void,\n): void {\n  const rank = rootPivots.length;\n  const free = pivotBasis.length;\n  const pivots = rootPivots.slice();\n  const presses = new Int32Array(free);\n  let pivotTotal = sumOf(pivots);\n  let cost = pivotTotal;\n\n  for (let sweep = 0; sweep < 40; sweep++) {\n    let improved = false;\n    for (let k = 0; k < free; k++) {\n      const vec = pivotBasis[k];\n      // Everything the retune leaves untouched.\n      const rest = cost - presses[k] - pivotTotal;\n      let bestDelta = 0;\n      let bestCost = cost;\n      let bestTotal = pivotTotal;\n      for (let delta = 1; delta < p; delta++) {\n        let total = 0;\n        for (let i = 0; i < rank; i++) total += (pivots[i] + delta * vec[i]) % p;\n        const candidate = rest + ((presses[k] + delta) % p) + total;\n        if (candidate < bestCost) {\n          bestCost = candidate;\n          bestDelta = delta;\n          bestTotal = total;\n        }\n      }\n      if (bestDelta !== 0) {\n        for (let i = 0; i < rank; i++) pivots[i] = (pivots[i] + bestDelta * vec[i]) % p;\n        presses[k] = (presses[k] + bestDelta) % p;\n        pivotTotal = bestTotal;\n        cost = bestCost;\n        improved = true;\n      }\n    }\n    record(pivots, presses, cost);\n    if (!improved) break;\n  }\n}\n\nfunction sumOf(values: Int32Array): number {\n  let total = 0;\n  for (let i = 0; i < values.length; i++) total += values[i];\n  return total;\n}\n\nfunction lexLess(a: Int32Ar