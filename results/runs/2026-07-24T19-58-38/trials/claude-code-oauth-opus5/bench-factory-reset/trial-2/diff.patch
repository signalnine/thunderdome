+import { describe, expect, it } from 'vitest';
+import { solveCounter, solveToggle } from '../src/index.js';
+import { bruteCounter, bruteToggle, makeRng } from './helpers.js';
+
+describe('stress', () => {
+  it('toggle matches brute force on many random machines', () => {
+    const rng = makeRng(1);
+    for (let trial = 0; trial < 3000; trial++) {
+      const lightCount = 1 + Math.floor(rng() * 9);
+      const buttonCount = Math.floor(rng() * 15);
+      const density = 0.1 + rng() * 0.8;
+      const buttons: number[][] = [];
+      for (let j = 0; j < buttonCount; j++) {
+        const touched: number[] = [];
+        for (let i = 0; i < lightCount; i++) if (rng() < density) touched.push(i);
+        buttons.push(touched);
+      }
+      const target: boolean[] = [];
+      for (let i = 0; i < lightCount; i++) target.push(rng() < 0.5);
+      const machine = { target, buttons };
+      expect({ trial, got: solveToggle(machine) }).toEqual({ trial, got: bruteToggle(machine) });
+    }
+  });
+
+  it('counter matches brute force on many random machines', () => {
+    const rng = makeRng(2);
+    const moduli = [2, 3, 5, 7, 11, 13];
+    for (let trial = 0; trial < 1500; trial++) {
+      const modulus = moduli[Math.floor(rng() * moduli.length)];
+      let buttonCount = 1 + Math.floor(rng() * 5);
+      while (modulus ** buttonCount > 60000) buttonCount--;
+      const counterCount = 1 + Math.floor(rng() * 4);
+      const density = 0.2 + rng() * 0.7;
+      const buttons: number[][] = [];
+      for (let j = 0; j < buttonCount; j++) {
+        const touched: number[] = [];
+        for (let i = 0; i < counterCount; i++) if (rng() < density) touched.push(i);
+        // Occasionally repeat an index so coefficients above one show up.
+        if (touched.length > 0 && rng() < 0.2) touched.push(touched[0]);
+        buttons.push(touched);
+      }
+      const lights: number[] = [];
+      for (let i = 0; i < counterCount; i++) lights.push(Math.floor(rng() * modulus));
+      expect({ trial, got: solveCounter(lights, buttons, modulus) }).toEqual({
+        trial,
+        got: bruteCounter(lights, buttons, modulus),
+      });
+    }
+  });
+});
