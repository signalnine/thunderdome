t vec = pivotBasis[k];\n      // Everything the retune leaves untouched.\n      const rest = cost - presses[k] - pivotTotal;\n      let bestDelta = 0;\n      let bestCost = cost;\n      let bestTotal = pivotTotal;\n      for (let delta = 1; delta < p; delta++) {\n        let total = 0;\n        for (let i = 0; i < rank; i++) total += (pivots[i] + delta * vec[i]) % p;\n        const candidate = rest + ((presses[k] + delta) % p) + total;\n        if (candidate < bestCost) {\n          bestCost = candidate;\n          bestDelta = delta;\n          bestTotal = total;\n        }\n      }\n      if (bestDelta !== 0) {\n        for (let i = 0; i < rank; i++) pivots[i] = (pivots[i] + bestDelta * vec[i]) % p;\n        presses[k] = (presses[k] + bestDelta) % p;\n        pivotTotal = bestTotal;\n        cost = bestCost;\n        improved = true;\n      }\n    }\n    record(pivots, presses, cost);\n    if (!improved) break;\n  }\n}\n\nfunction sumOf(values: Int32Array): number {","originalFile":"/** Milliseconds the search may spend before returning the best it has found. */\nconst SEARCH_BUDGET_MS = 3000;\n\n/** Above this many candidate assignments, deepening beats a plain sweep. */\nconst FULL_SWEEP_LIMIT = 5e6;\n\n/**\n * Counter variant: button `j` pressed `x[j]` times adds `x[j]` to every counter\n * it touches, so the puzzle is `A x = lights (mod p)` with `x` in `0..p-1`.\n *\n * Row reducing mod p gives one particular solution plus a null space of\n * dimension `f`; every solution is `x0 + sum(t_k * v_k)` for free choices of\n * `t`. Total presses is not linear in `t` (every counter wraps), so we search\n * the `t` space rather than solve for it, with two levers:\n *\n *   - a bound: a partial assignment has already committed `sum(t_k)` plus every\n *     pivot counter that no longer depends on an unassigned variable, and\n *     neither can shrink, so anything above the incumbent is dead;\n *   - iterative deepening on the total, for when the null space is far too big\