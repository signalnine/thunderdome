@@ -0,0 +1,130 @@
+import { describe, expect, it } from 'vitest';
+import { solveCounter } from '../src/index.js';
+import { makeRng, runCounters } from './helpers.js';
+
+/**
+ * Exact minimum press count by breadth first search over the counter states.
+ * Only usable when modulus^counters is small, but it is completely independent
+ * of the solver under test.
+ */
+function bfsOptimum(lights: number[], buttons: number[][], modulus: number): number | null {
+  const n = lights.length;
+  const size = modulus ** n;
+  const generators = buttons.map((touched) => {
+    const v = new Array<number>(n).fill(0);
+    for (const c of touched) if (c >= 0 && c < n) v[c] = (v[c] + 1) % modulus;
+    return v;
+  });
+  const encode = (digits: number[]): number => {
+    let idx = 0;
+    let pow = 1;
+    for (let i = 0; i < n; i++) {
+      idx += digits[i] * pow;
+      pow *= modulus;
+    }
+    return idx;
+  };
+  const target = encode(lights.map((v) => ((v % modulus) + modulus) % modulus));
+  const dist = new Int32Array(size).fill(-1);
+  dist[0] = 0;
+  let frontier = [0];
+  let depth = 0;
+  while (frontier.length > 0 && dist[target] < 0) {
+    const next: number[] = [];
+    for (const s of frontier) {
+      const digits: number[] = [];
+      let rest = s;
+      for (let i = 0; i < n; i++) {
+        digits.push(rest % modulus);
+        rest = Math.floor(rest / modulus);
+      }
+      for (const g of generators) {
+        let idx = 0;
+        let pow = 1;
+        for (let i = 0; i < n; i++) {
+          idx += ((digits[i] + g[i]) % modulus) * pow;
+          pow *= modulus;
+        }
+        if (dist[idx] < 0) {
+          dist[idx] = depth + 1;
+          next.push(idx);
+        }
+      }
+    }
+    depth++;
+    frontier = next;
+  }
+  return dist[target] < 0 ? null : dist[target];
+}
+
+describe('oracle', () => {
+  it('hits the true optimum on machines with a large null space', () => {
+    const shapes = [
+      { counters: 5, buttons: 15, modulus: 7 },
+      { counters: 4, buttons: 20, modulus: 11 },
+      { counters: 6, buttons: 18, modulus: 5 },
+      { counters: 3, buttons: 25, modulus: 13 },
+      { counters: 8, buttons: 30, modulus: 3 },
+      { counters: 14, buttons: 40, modulus: 2 },
+    ];
+    for (const shape of shapes) {
+      for (let trial = 0; trial < 4; trial++) {
+        const rng = makeRng(shape.counters * 1000 + shape.modulus * 10 + trial);
+        const buttons: number[][] = [];
+        for (let j = 0; j < shape.buttons; j++) {
+          const touched: number[] = [];
+          for (let i = 0; i < shape.counters; i++) if (rng() < 0.45) touched.push(i);
+          buttons.push(touched);
+        }
+        const lights: number[] = [];
+        for (let i = 0; i < shape.counters; i++) lights.push(Math.floor(rng() * shape.modulus));
+
+        const started = Date.now();
+        const got = solveCounter(lights, buttons, shape.modulus);
+        const elapsed = Date.now() - started;
+        const want = bfsOptimum(lights, buttons, shape.modulus);
+        const total = got === null ? null : got.reduce((a, b) => a + b, 0);
+        expect({ ...shape, trial, total }).toEqual({ ...shape, trial, total: want });
+        expect(elapsed).toBeLessThan(5000);
+        if (got !== null) {
+          expect(runCounters(got, buttons, shape.counters, shape.modulus)).toEqual(
+            lights.map((v) => ((v % shape.modulus) + shape.modulus) % shape.modulus),
+          );
+        }
+      }
+    }
+  }, 300000);
+
+  it('recovers a sparse planted press vector', () => {
+    // A handful of presses hidden in a state space far too big to enumerate:
+    // only deepening on the total finds them.
+    const shapes = [
+      { counters: 20, buttons: 40, modulus: 97, plant: 2 },
+      { counters: 20, buttons: 40, modulus: 97, plant: 3 },
+      { counters: 30, buttons: 40, modulus: 97, plant: 4 },
+      { counters: 25, buttons: 40, modulus: 13, plant: 3 },
+      { counters: 20, buttons: 40, modulus: 2, plant: 4 },
+    ];
+    for (const shape of shapes) {
+      const rng = makeRng(shape.counters * 77 + shape.modulus + shape.plant);
+      const buttons: number[][] = [];
+      for (let j = 0; j < shape.buttons; j++) {
+        const touched: number[] = [];
+        for (let i = 0; i < shape.counters; i++) if (rng() < 0.5) touched.push(i);
+        buttons.push(touched);
+      }
+      const presses = new Array<number>(shape.buttons).fill(0);
+      for (let k = 0; k < shape.plant; k++) presses[Math.floor(rng() * shape.buttons)] = 1;
+      const planted = presses.reduce((a, b) => a + b, 0);
+      const lights = runCounters(presses, buttons, shape.counters, shape.modulus);
+
+      const started = Date.now();
+      const got = solveCounter(lights, buttons, shape.modulus);
+      expect(Date.now() - started).toBeLessThan(5000);
+      expect(got).not.toBeNull();
+      expect(runCounters(got!, buttons, shape.counters, shape.modulus)).toEqual(lights);
+      // Nothing beats the plant, and the solver must not do worse.
+      expect(got!.reduce((a, b) => a + b, 0)).toBe(planted);
+    }
+  }, 120000);
+});
