+import { describe, expect, it } from 'vitest';
+import { solveToggle, type Machine } from '../src/index.js';
+import { bruteToggle, makeRng, runToggles } from './helpers.js';
+
+describe('solveToggle', () => {
+  it('returns null for the unsatisfiable example from the spec', () => {
+    expect(
+      solveToggle({
+        target: [true, true, false, true],
+        buttons: [
+          [0, 1],
+          [1, 2, 3],
+          [0, 3],
+        ],
+      }),
+    ).toBeNull();
+  });
+
+  it('presses nothing when the lights already match', () => {
+    expect(solveToggle({ target: [false, false], buttons: [[0], [1]] })).toEqual([]);
+    expect(solveToggle({ target: [], buttons: [] })).toEqual([]);
+  });
+
+  it('returns null when there are no buttons but lights must change', () => {
+    expect(solveToggle({ target: [true], buttons: [] })).toBeNull();
+  });
+
+  it('finds a simple exact cover', () => {
+    expect(
+      solveToggle({
+        target: [true, true, false, true],
+        buttons: [[0], [1], [2], [3]],
+      }),
+    ).toEqual([0, 1, 3]);
+  });
+
+  it('prefers the fewest presses', () => {
+    // Button 2 does in one press what buttons 0 and 1 do in two.
+    const machine: Machine = {
+      target: [true, true],
+      buttons: [[0], [1], [0, 1]],
+    };
+    expect(solveToggle(machine)).toEqual([2]);
+  });
+
+  it('breaks ties on press count lexicographically', () => {
+    // {0,3} and {1,2} both work; {0,3} is lexicographically smaller.
+    const machine: Machine = {
+      target: [true, true],
+      buttons: [[0], [1], [0], [1]],
+    };
+    expect(solveToggle(machine)).toEqual([0, 1]);
+
+    const machine2: Machine = {
+      target: [true, true],
+      buttons: [[0, 1], [0], [1]],
+    };
+    expect(solveToggle(machine2)).toEqual([0]);
+  });
+
+  it('treats a repeated light index within one button as a no-op', () => {
+    expect(solveToggle({ target: [true], buttons: [[0, 0], [0]] })).toEqual([1]);
+  });
+
+  it('matches brute force on random small machines', () => {
+    const rng = makeRng(20260724);
+    for (let trial = 0; trial < 400; trial++) {
+      const lightCount = 1 + Math.floor(rng() * 6);
+      const buttonCount = 1 + Math.floor(rng() * 10);
+      const buttons: number[][] = [];
+      for (let j = 0; j < buttonCount; j++) {
+        const touched: number[] = [];
+        for (let i = 0; i < lightCount; i++) if (rng() < 0.5) touched.push(i);
+        buttons.push(touched);
+      }
+      const target: boolean[] = [];
+      for (let i = 0; i < lightCount; i++) target.push(rng() < 0.5);
+
+      const machine: Machine = { target, buttons };
+      expect({ trial, got: solveToggle(machine) }).toEqual({
+        trial,
+        got: bruteToggle(machine),
+      });
+    }
+  });
+
+  it('matches brute force on random solvable machines', () => {
+    const rng = makeRng(777);
+    for (let trial = 0; trial < 200; trial++) {
+      const lightCount = 1 + Math.floor(rng() * 5);
+      const buttonCount = 1 + Math.floor(rng() * 10);
