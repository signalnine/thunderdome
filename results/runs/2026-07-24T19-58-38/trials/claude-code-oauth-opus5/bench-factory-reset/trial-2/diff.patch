+  it('never presses more than it has to', () => {
+    // Counter 0 needs 4 mod 5; four presses is the cheapest total, and the
+    // lexicographically smallest way to split them is all on the last button.
+    expect(solveCounter([4], [[0], [0]], 5)).toEqual([0, 4]);
