+/**
+ * Small bit helpers shared by the solvers.
+ *
+ * Bit sets are stored as `Uint32Array` word arrays, least significant word
+ * first; bit `b` lives at word `b >>> 5`, offset `b & 31`.
+ */
+
+export function popcount32(x: number): number {
+  let v = x - ((x >>> 1) & 0x55555555);
+  v = (v & 0x33333333) + ((v >>> 2) & 0x33333333);
+  v = (v + (v >>> 4)) & 0x0f0f0f0f;
+  return Math.imul(v, 0x01010101) >>> 24;
+}
+
+/** Index of the lowest set bit of a non-zero 32 bit word. */
+export function ctz32(x: number): number {
+  return 31 - Math.clz32(x & -x);
+}
+
+export function getBit(words: Uint32Array, bit: number): number {
+  return (words[bit >>> 5] >>> (bit & 31)) & 1;
+}
+
+export function setBit(words: Uint32Array, bit: number): void {
+  words[bit >>> 5] |= 1 << (bit & 31);
+}
+
+export function flipBit(words: Uint32Array, bit: number): void {
+  words[bit >>> 5] ^= 1 << (bit & 31);
+}
+
+export function xorInto(dst: Uint32Array, src: Uint32Array): void {
+  for (let i = 0; i < dst.length; i++) dst[i] ^= src[i];
+}
+
+export function popcountWords(words: Uint32Array): number {
+  let total = 0;
+  for (let i = 0; i < words.length; i++) total += popcount32(words[i]);
+  return total;
+}
+
+/** Indices of the set bits, ascending. */
+export function bitsToIndices(words: Uint32Array, limit: number): number[] {
+  const out: number[] = [];
+  for (let b = 0; b < limit; b++) if (getBit(words, b)) out.push(b);
+  return out;
+}
