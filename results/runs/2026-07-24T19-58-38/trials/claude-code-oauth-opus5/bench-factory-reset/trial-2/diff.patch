+import {
+  bitsToIndices,
+  ctz32,
+  flipBit,
+  getBit,
+  popcount32,
+  popcountWords,
+  setBit,
+  xorInto,
+} from './bits.js';
+
+export interface Machine {
+  /** Desired state for each light; every light starts off. */
+  target: boolean[];
+  /** buttons[i] = light indices toggled by button i. */
+  buttons: number[][];
+}
+
+/**
+ * Pressing a set of buttons is a sum over GF(2): each light ends on iff an odd
+ * number of the pressed buttons touch it, and the press order is irrelevant.
+ * So the puzzle is the linear system `A x = target` over GF(2), where column
+ * `j` of `A` is button `j` and `x` is the 0/1 press vector.
+ *
+ * We row reduce once to detect inconsistency and to shrink the system, then
+ * pick whichever exhaustive search is cheaper:
+ *
+ *   - enumerate the 2^f null space combinations (f = free variables), or
+ *   - meet in the middle over the 2^(M/2) subsets of each half of the buttons.
+ *
+ * The second is what keeps 40 buttons tractable: ~2^20 work instead of 2^40.
+ */
+export function solveToggle(machine: Machine): number[] | null {
+  const target = machine.target ?? [];
+  const buttons = machine.buttons ?? [];
+  const n = target.length;
+  const m = buttons.length;
+
+  // Augmented row per light: bits 0..m-1 are button coefficients, bit m is the
+  // right hand side.
+  const words = ((m + 1) >>> 5) + 1;
+  const rows: Uint32Array[] = [];
+  for (let i = 0; i < n; i++) {
+    const row = new Uint32Array(words);
+    if (target[i]) setBit(row, m);
+    rows.push(row);
+  }
+  for (let j = 0; j < m; j++) {
+    const touched = buttons[j] ?? [];
+    for (let k = 0; k < touched.length; k++) {
+      const light = touched[k];
+      // A button that hits the same light twice cancels out, and lights
+      // outside the target carry no constraint.
+      if (light >= 0 && light < n) flipBit(rows[light], j);
+    }
+  }
+
+  const pivotCols: number[] = [];
+  let rank = 0;
+  for (let col = 0; col < m && rank < n; col++) {
+    let sel = -1;
+    for (let i = rank; i < n; i++) {
+      if (getBit(rows[i], col)) {
+        sel = i;
+        break;
+      }
+    }
+    if (sel < 0) continue;
+    const tmp = rows[rank];
+    rows[rank] = rows[sel];
+    rows[sel] = tmp;
+    for (let i = 0; i < n; i++) {
+      if (i !== rank && getBit(rows[i], col)) xorInto(rows[i], rows[rank]);
+    }
+    pivotCols.push(col);
+    rank++;
+  }
+
+  // Rows below the rank are all-zero on the left: a set right hand side there
+  // is an unsatisfiable constraint.
+  for (let i = rank; i < n; i++) {
+    if (getBit(rows[i], m)) return null;
+  }
+
+  // Every reduced equation reads 0 = 0, so pressing nothing already works and
+  // nothing can beat zero presses.
+  let anyRhs = false;
+  for (let i = 0; i < rank; i++) {
+    if (getBit(rows[i], m)) {
+      anyRhs = true;
+      break;
+    }
+  }
+  if (!anyRhs) return [];
+
+  const freeCols: number[] = [];
+  {
+    const isPivot = new Uint8Array(m);
+    for (const col of pivotCols) isPivot[col] = 1;
+    for (let col = 0; col < m; col++) if (!isPivot[col]) freeCols.push(col);
+  }
+  const free = freeCols.length;
+
+  // Meet in the middle needs the reduced equation masks to fit in 64 bits and
+  // the high half to stay inside a 32 bit subset index.
+  const mitmUsable = rank <= 64 && m <= 51;
+  const useNullSpace = !mitmUsable || free <= m >>> 1;
+
+  return useNullSpace
+    ? searchNullSpace(rows, m, words, rank, pivotCols, freeCols)
+    : searchMeetInMiddle(rows, m, rank);
+}
+
+/** True when `a` beats `b`: fewer presses, then lexicographically smaller. */
+function better(a: Uint32Array, aPop: number, b: Uint32Array, bPop: number): boolean {
+  if (aPop !== bPop) return aPop < bPop;
+  // Same size, so the set holding the smallest index they disagree on is the
+  // lexicographically smaller sorted list.
+  for (let i = 0; i < a.length; i++) {
+    const diff = a[i] ^ b[i];
+    if (diff !== 0) return (a[i] & (diff & -diff)) !== 0;
+  }
+  return false;
+}
+
+/**
+ * Walk the whole solution set: one particular solution plus every combination
+ * of null space basis vectors, visited in Gray code order so each step flips a
+ * single basis vector.
+ */
+function searchNullSpace(
+  rows: Uint32Array[],
+  m: number,
+  words: number,
+  rank: number,
+  pivotCols: number[],
+  freeCols: number[],
+): number[] | null {
+  const particular = new Uint32Array(words);
+  for (let i = 0; i < rank; i++) {
+    if (getBit(rows[i], m)) setBit(particular, pivotCols[i]);
+  }
+
+  const free = freeCols.length;
+  const basis: Uint32Array[] = [];
+  for (let k = 0; k < free; k++) {
+    const vec = new Uint32Array(words);
+    setBit(vec, freeCols[k]);
+    for (let i = 0; i < rank; i++) {
+      if (getBit(rows[i], freeCols[k])) setBit(vec, pivotCols[i]);
+    }
+    basis.push(vec);
+  }
+
+  const current = particular.slice();
+  let best = current.slice();
+  let bestPop = popcountWords(current);
+
+  const total = 2 ** free;
+  for (let i = 1; i < total; i++) {
+    xorInto(current, basis[ctz32(i)]);
+    const pop = popcountWords(current);
+    if (better(current, pop, best, bestPop)) {
+      best = current.slice();
+      bestPop = pop;
+    }
+  }
+  return bitsToIndices(best, m);
+}
+
+/**
+ * Split the buttons in half. Each half has at most 2^24 subsets, so we can
+ * tabulate every light pattern the low half can produce and then, for each
+ * subset of the high half, look up the pattern that completes the target.
+ */
+function searchMeetInMiddle(rows: Uint32Array[], m: number, rank: number): number[] | null {
+  // Re-express each button over the `rank` reduced equations instead of the
+  // original lights: rank <= min(lights, buttons), so the masks fit in 64 bits.
+  const colLo = new Int32Array(m);
+  const colHi = new Int32Array(m);
+  let targetLo = 0;
+  let targetHi = 0;
+  for (let i = 0; i < rank; i++) {
+    const bit = 1 << (i & 31);
+    const high = i >= 32;
+    for (let j = 0; j < m; j++) {
