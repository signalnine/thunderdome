+/** Milliseconds the search may spend before returning the best it has found. */
+const SEARCH_BUDGET_MS = 3000;
+
+/** Above this many candidate assignments, deepening beats a plain sweep. */
+const FULL_SWEEP_LIMIT = 5e6;
+
+/**
+ * Counter variant: button `j` pressed `x[j]` times adds `x[j]` to every counter
+ * it touches, so the puzzle is `A x = lights (mod p)` with `x` in `0..p-1`.
+ *
+ * Row reducing mod p gives one particular solution plus a null space of
+ * dimension `f`; every solution is `x0 + sum(t_k * v_k)` for free choices of
+ * `t`. Total presses is not linear in `t` (every counter wraps), so the minimum
+ * has to be searched for rather than solved for. Which search depends on the
+ * machine:
+ *
+ *   - few independent counters: walk the counter configurations instead
+ *     (`solveByStates`), which is exact however many buttons there are;
+ *   - small null space: sweep every `t` under a branch and bound, where a
+ *     partial assignment has already committed `sum(t_k)` plus every pivot
+ *     counter that no longer depends on an unassigned variable, and neither can
+ *     shrink, so anything above the incumbent is dead;
+ *   - neither: deepen on the total, which finds a cheap answer hiding in a huge
+ *     null space, and fall back to improving the incumbent if time runs out.
+ *
+ * Only the `rank` pivot counters have to be tracked while searching: every
+ * other counter's value is simply the number of presses assigned to it.
+ *
+ * A machine that is dense, wide and high modulus at once (say 30 counters and
+ * 40 buttons mod 97) is a shortest vector problem with no known fast exact
+ * answer; there the budget runs out and the best solution found is returned.
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const p = modulus;
+  if (!Number.isInteger(p) || p < 1) return null;
+
+  const n = lights.length;
+  const m = buttons.length;
+  const stride = m + 1;
+
+  const mat = new Int32Array(n * stride);
+  for (let i = 0; i < n; i++) {
+    mat[i * stride + m] = (((lights[i] ?? 0) % p) + p) % p;
+  }
+  for (let j = 0; j < m; j++) {
+    const touched = buttons[j] ?? [];
+    for (let k = 0; k < touched.length; k++) {
+      const counter = touched[k];
+      // Counters outside the target carry no constraint; a repeated index in
+      // one button increments that counter once per occurrence.
+      if (counter >= 0 && counter < n) {
+        mat[counter * stride + j] = (mat[counter * stride + j] + 1) % p;
+      }
+    }
+  }
+
+  const pivotCols: number[] = [];
+  let rank = 0;
+  for (let col = 0; col < m && rank < n; col++) {
+    let sel = -1;
+    for (let i = rank; i < n; i++) {
+      if (mat[i * stride + col] !== 0) {
+        sel = i;
+        break;
+      }
+    }
+    if (sel < 0) continue;
+    if (sel !== rank) {
+      for (let c = 0; c < stride; c++) {
+        const tmp = mat[rank * stride + c];
+        mat[rank * stride + c] = mat[sel * stride + c];
+        mat[sel * stride + c] = tmp;
+      }
+    }
+    const inv = modInverse(mat[rank * stride + col], p);
+    for (let c = col; c < stride; c++) {
+      mat[rank * stride + c] = (mat[rank * stride + c] * inv) % p;
+    }
+    for (let i = 0; i < n; i++) {
+      const factor = mat[i * stride + col];
+      if (i === rank || factor === 0) continue;
+      for (let c = col; c < stride; c++) {
+        const v = (mat[i * stride + c] - factor * mat[rank * stride + c]) % p;
+        mat[i * stride + c] = v < 0 ? v + p : v;
+      }
+    }
+    pivotCols.push(col);
+    rank++;
+  }
+
+  // Rows past the rank read 0 = rhs, so a non-zero right hand side is a
+  // constraint no press vector can satisfy.
+  for (let i = rank; i < n; i++) {
+    if (mat[i * stride + m] !== 0) return null;
+  }
+
+  const isPivot = new Uint8Array(m);
+  for (const col of pivotCols) isPivot[col] = 1;
+  const unordered: number[] = [];
+  for (let col = 0; col < m; col++) if (!isPivot[col]) unordered.push(col);
+  const free = unordered.length;
+
+  // Few enough independent counters to enumerate every reachable configuration?
+  // Then walking the configurations beats searching the null space, and it
+  // stays exact no matter how many buttons there are.
+  const states = p ** rank;
+  const assignments = p ** free;
+  if (
+    (m + 1) * states <= 6e6 &&
+    m * states * (rank + 4) <= 3e8 &&
+    (assignments > FULL_SWEEP_LIMIT || m * states * (rank + 4) < assignments * (rank + 2))
+  ) {
+    return solveByStates(mat, stride, rank, m, p, states);
+  }
+
+  const freeCols = orderFreeColumns(mat, stride, rank, unordered);
+
+  // Pivot counters with every free variable at zero.
+  const rootPivots = new Int32Array(rank);
+  for (let i = 0; i < rank; i++) rootPivots[i] = mat[i * stride + m];
+
+  // What one press of free button k does to the pivot counters.
+  const pivotBasis: Int32Array[] = [];
+  for (let k = 0; k < free; k++) {
+    const vec = new Int32Array(rank);
+    for (let i = 0; i < rank; i++) vec[i] = (p - mat[i * stride + freeCols[k]]) % p;
+    pivotBasis.push(vec);
+  }
+
+  let best: Int32Array | null = null;
+  let bestCost = Infinity;
+
+  /** Expands a compact state into a full press vector and keeps it if it wins. */
+  const record = (pivots: Int32Array, presses: Int32Array, cost: number): void => {
+    if (cost > bestCost) return;
+    const candidate = new Int32Array(m);
+    for (let i = 0; i < rank; i++) candidate[pivotCols[i]] = pivots[i];
+    for (let k = 0; k < free; k++) candidate[freeCols[k]] = presses[k];
+    if (cost < bestCost || lexLess(candidate, best!)) {
+      best = candidate;
+      bestCost = cost;
+    }
+  };
+
+  const trail = new Int32Array(free);
+  record(rootPivots, trail, sumOf(rootPivots));
+
+  // A greedy pass first: any decent solution tightens the bound the search
+  // prunes with, which is worth far more than the pass costs.
+  if (free > 0) coordinateDescent(rootPivots, pivotBasis, p, record);
+
+  // Which free variable each pivot counter stops depending on. Once past it
+  // that counter is final and can be charged against the bound.
+  const settledAt: number[][] = [];
+  for (let k = 0; k < free; k++) settledAt.push([]);
+  let baseSettled = 0;
+  for (let i = 0; i < rank; i++) {
+    let last = -1;
+    for (let k = 0; k < free; k++) {
+      if (mat[i * stride + freeCols[k]] !== 0) last = k;
+    }
+    if (last < 0) baseSettled += rootPivots[i];
+    else settledAt[last].push(i);
+  }
+
+  // One scratch state per depth, so descending never has to undo arithmetic.
+  const levels: Int32Array[] = [rootPivots.slice()];
+  for (let k = 0; k < free; k++) levels.push(new Int32Array(rank));
+
+  const startedAt = Date.now();
+  let deadline = startedAt + SEARCH_BUDGET_MS;
+  let countdown = 4096;
+  let aborted = false;
+  /** Ceiling on the total for this pass; the incumbent tightens it further. */
+  let cap = Infinity;
+  let reachedLeaf = false;
+
+  const search = (depth: number, state: Int32Array, pressed: number, settled: number): void => {
+    if (--countdown <= 0) {
+      countdown = 4096;
+      if (Date.now() > deadline) {
+        aborted = true;
+        return;
+      }
+    }
+    if (depth === free) {
+      reachedLeaf = true;
+      record(state, trail, pressed + settled);
+      return;
+    }
+    const dst = levels[depth + 1];
+    const vec = pivotBasis[depth];
+    const settling = settledAt[depth];
+    for (let v = 0; v < p; v++) {
+      const limit = cap < bestCost ? cap : bestCost;
+      // Presses and settled counters only ever get added to, so this is a valid
+      // lower bound for the whole subtree. Equal totals stay in play because
+      // they can still win on the tie break.
+      if (pressed + v + settled > limit) break;
+      // Not pressing this button leaves the counters alone, so the parent's
+      // state can be handed straight down; that keeps long stretches of
+      // untouched buttons cheap, which is most of the tree once the bound bites.
+      let next = state;
+      if (v > 0) {
+        for (let i = 0; i < rank; i++) dst[i] = (state[i] + v * vec[i]) % p;
+        next = dst;
+      }
+      let nextSettled = settled;
+      for (let s = 0; s < settling.length; s++) nextSettled += next[settling[s]];
+      if (pressed + v + nextSettled <= limit) {
+        trail[depth] = v;
+        search(depth + 1, next, pressed + v, nextSettled);
+        trail[depth] = 0;
+        if (aborted) return;
+      }
+    }
+  };
+
+  if (p ** free <= FULL_SWEEP_LIMIT) {
+    // Small enough to walk in full, so branch and bound settles it outright.
+    search(0, levels[0], 0, baseSettled);
+  } else {
+    // Too big to sweep, so deepen on the total instead. A pass that finds
+    // nothing proves no solution is that cheap, so the first pass to reach a
+    // leaf has the optimum - and since it explores every solution at that
+    // total, the tie break is settled too. This is what rescues a machine with
+    // a huge null space but a cheap answer, where plain depth first search
+    // disappears into one corner of the tree.
+    deadline = startedAt + SEARCH_BUDGET_MS * 0.6;
+    let proven = false;
+    for (let ceiling = 0; ceiling <= bestCost; ceiling++) {
+      cap = ceiling;
+      reachedLeaf = false;
+      search(0, levels[0], 0, baseSettled);
+      if (aborted) break;
+      if (reachedLeaf) {
+        proven = true;
+        break;
+      }
+    }
+    if (!proven) {
+      // Out of time without a proof: spend what is left improving the incumbent.
+      aborted = false;
+      cap = Infinity;
+      deadline = startedAt + SEARCH_BUDGET_MS;
+      search(0, levels[0], 0, baseSettled);
+    }
+  }
+
+  return best === null ? null : Array.from(best);
+}
+
+const UNREACHABLE = 0x3fffffff;
+
+/**
+ * Exact solve by working over counter configurations instead of press vectors.
+ *
+ * `suffix[j][s]` is the cheapest way to get from configuration `s` to the target
+ * using only buttons `j..m-1`. Reading it off backwards, `suffix[j]` comes from
+ * `suffix[j+1]` by choosing how many times to press button `j`: adding that
+ * button repeatedly walks a cycle of length `p` through the configurations, and
+ * along one cycle `min over c of (c + next[s + c*g])` is just a relaxation
+ * sweep, so a whole button costs one pass over the configurations.
+ *
+ * With those in hand the answer reads off greedily. Because the total is
+ * already known to be minimal, a press count fits only if it lands exactly on
+ * the remaining budget - so taking the smallest that fits, button by button,
+ * gives the lexicographically smallest of the cheapest solutions.
+ */
+function solveByStates(
+  mat: Int32Array,
+  stride: number,
+  rank: number,
+  m: number,
+  p: number,
+  states: number,
+): number[] | null {
+  const generators: Int32Array[] = [];
+  for (let j = 0; j < m; j++) {
+    const g = new Int32Array(rank);
+    for (let i = 0; i < rank; i++) g[i] = mat[i * stride + j];
+    generators.push(g);
+  }
+  let target = 0;
+  for (let i = rank - 1; i >= 0; i--) target = target * p + mat[i * stride + m];
+
+  const suffix: Int32Array[] = new Array(m + 1);
+  const atTarget = new Int32Array(states).fill(UNREACHABLE);
+  atTarget[target] = 0;
+  suffix[m] = atTarget;
+
+  const delta = new Int32Array(states);
+  const visited = new Uint8Array(states);
+  const cycle = new Int32Array(p);
+
+  for (let j = m - 1; j >= 0; j--) {
+    const g = generators[j];
+    let moves = false;
+    for (let i = 0; i < rank; i++) {
+      if (g[i] !== 0) {
+        moves = true;
+        break;
+      }
+    }
+    if (!moves) {
+      // A button that changes nothing is never worth pressing.
+      suffix[j] = suffix[j + 1];
+      continue;
+    }
+
+    buildDelta(delta, g, p, rank, states);
+    const next = suffix[j + 1];
+    const here = new Int32Array(states);
+    visited.fill(0);
+    for (let start = 0; start < states; start++) {
+      if (visited[start]) continue;
+      let s = start;
+      for (let c = 0; c < p; c++) {
+        cycle[c] = s;
+        visited[s] = 1;
+        here[s] = next[s];
+        s += delta[s];
+      }
+      // Two sweeps: one covers the chains that stay inside the cycle order, the
+      // second the ones that wrap past the end.
+      for (let pass = 0; pass < 2; pass++) {
+        for (let c = p - 1; c >= 0; c--) {
+          const candidate = here[cycle[(c + 1) % p]] + 1;
+          if (candidate < here[cycle[c]]) here[cycle[c]] = candidate;
+        }
+      }
+    }
+    suffix[j] = here;
+  }
+
+  let remaining = suffix[0][0];
+  if (remaining >= UNREACHABLE) return null;
+
+  const presses = new Array<number>(m).fill(0);
+  let state = 0;
+  for (let j = 0; j < m; j++) {
+    const g = generators[j];
+    let candidate = state;
+    for (let c = 0; c < p; c++) {
+      if (c + suffix[j + 1][candidate] === remaining) {
+        presses[j] = c;
+        remaining -= c;
+        state = candidate;
+        break;
+      }
+      candidate = advance(candidate, g, p, rank);
+    }
+  }
+  return presses;
+}
+
+/** delta[s] is the index shift that adds one press of `g` to configuration s. */
+function buildDelta(
+  delta: Int32Array,
+  g: Int32Array,
+  p: number,
+  rank: number,
+  states: number,
+): void {
+  delta.fill(0);
+  let place = 1;
+  for (let i = 0; i < rank; i++) {
+    const gi = g[i];
+    for (let block = 0; block < states; block += place * p) {
+      for (let digit = 0; digit < p; digit++) {
+        const shift = (((digit + gi) % p) - digit) * place;
+        if (shift === 0) continue;
+        const from = block + digit * place;
+        for (let s = from; s < from + place; s++) delta[s] += shift;
+      }
+    }
+    place *= p;
+  }
+}
+
+/** One press of `g` applied to a single configuration index. */
+function advance(state: number, g: Int32Array, p: number, rank: number): number {
+  let result = 0;
+  let place = 1;
+  let rest = state;
+  for (let i = 0; i < rank; i++) {
+    const digit = rest % p;
+    rest = (rest - digit) / p;
+    result += ((digit + g[i]) % p) * place;
+    place *= p;
+  }
+  return result;
+}
+
+/**
+ * Assignment order for the free variables. A pivot counter can only be charged
+ * to the bound once every free variable it depends on is assigned, so we
+ * greedily pick the variable that finalises the most counters next. On a dense
+ * system this changes nothing; on a sparse one it makes the bound bite early.
+ */
+function orderFreeColumns(
+  mat: Int32Array,
+  stride: number,
+  rank: number,
+  freeCols: number[],
+): number[] {
+  const free = freeCols.length;
+  const pending = new Int32Array(rank);
+  for (let i = 0; i < rank; i++) {
+    for (let k = 0; k < free; k++) {
+      if (mat[i * stride + freeCols[k]] !== 0) pending[i]++;
+    }
+  }
+
+  const taken = new Uint8Array(free);
+  const order: number[] = [];
+  for (let step = 0; step < free; step++) {
+    let choice = -1;
+    let settles = -1;
+    for (let k = 0; k < free; k++) {
+      if (taken[k]) continue;
+      let count = 0;
+      for (let i = 0; i < rank; i++) {
+        if (pending[i] === 1 && mat[i * stride + freeCols[k]] !== 0) count++;
+      }
+      if (count > settles) {
+        settles = count;
+        choice = k;
+      }
+    }
+    taken[choice] = 1;
+    order.push(freeCols[choice]);
+    for (let i = 0; i < rank; i++) {
+      if (mat[i * stride + freeCols[choice]] !== 0) pending[i]--;
+    }
+  }
+  return order;
+}
+
+/**
+ * Retunes one free variable at a time, keeping any change that lowers the total
+ * press count, until a full sweep finds no improvement.
+ */
+function coordinateDescent(
+  rootPivots: Int32Array,
+  pivotBasis: Int32Array[],
+  p: number,
+  record: (pivots: Int32Array, presses: Int32Array, cost: number) => void,
+): void {
+  const rank = rootPivots.length;
+  const free = pivotBasis.length;
+  const pivots = rootPivots.slice();
+  const presses = new Int32Array(free);
+  let pivotTotal = sumOf(pivots);
+  let cost = pivotTotal;
+
+  for (let sweep = 0; sweep < 40; sweep++) {
+    let improved = false;
+    for (let k = 0; k < free; k++) {
+      const vec = pivotBasis[k];
+      // Everything the retune leaves untouched.
+      const rest = cost - presses[k] - pivotTotal;
+      let bestDelta = 0;
+      let bestCost = cost;
+      let bestTotal = pivotTotal;
+      for (let delta = 1; delta < p; delta++) {
+        let total = 0;
+        for (let i = 0; i < rank; i++) total += (pivots[i] + delta * vec[i]) % p;
+        const candidate = rest + ((presses[k] + delta) % p) + total;
+        if (candidate < bestCost) {
+          bestCost = candidate;
+          bestDelta = delta;
+          bestTotal = total;
+        }
+      }
+      if (bestDelta !== 0) {
+        for (let i = 0; i < rank; i++) pivots[i] = (pivots[i] + bestDelta * vec[i]) % p;
+        presses[k] = (presses[k] + bestDelta) % p;
+        pivotTotal = bestTotal;
+        cost = bestCost;
+        improved = true;
+      }
+    }
+    record(pivots, presses, cost);
+    if (!improved) break;
+  }
+}
+
+function sumOf(values: Int32Array): number {
+  let total = 0;
+  for (let i = 0; i < values.length; i++) total += values[i];
+  return total;
+}
+
+function lexLess(a: Int32Array, b: Int32Array): boolean {
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] !== b[i]) return a[i] < b[i];
+  }
+  return false;
+}
+
+function modInverse(a: number, p: number): number {
+  let result = 1;
+  let base = a % p;
+  let exp = p - 2;
+  while (exp > 0) {
+    if (exp & 1) result = (result * base) % p;
+    base = (base * base) % p;
+    exp >>= 1;
+  }
+  return result;
+}
