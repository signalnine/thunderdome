(rank);\n    for (let i = 0; i < rank; i++) g[i] = mat[i * stride + j];\n    generators.push(g);\n  }\n  let target = 0;\n  for (let i = rank - 1; i >= 0; i--) target = target * p + mat[i * stride + m];\n\n  const suffix: Int32Array[] = new Array(m + 1);\n  const atTarget = new Int32Array(states).fill(UNREACHABLE);\n  atTarget[target] = 0;\n  suffix[m] = atTarget;\n\n  const delta = new Int32Array(states);\n  const visited = new Uint8Array(states);\n  const cycle = new Int32Array(p);\n\n  for (let j = m - 1; j >= 0; j--) {\n    const g = generators[j];\n    let moves = false;\n    for (let i = 0; i < rank; i++) {\n      if (g[i] !== 0) {\n        moves = true;\n        break;\n      }\n    }\n    if (!moves) {\n      // A button that changes nothing is never worth pressing.\n      suffix[j] = suffix[j + 1];\n      continue;\n    }\n\n    buildDelta(delta, g, p, rank, states);\n    const next = suffix[j + 1];\n    const here = new Int32Array(states);\n    visited.fill(0);\n    for (let start = 0; start < states; start++) {\n      if (visited[start]) continue;\n      let s = start;\n      for (let c = 0; c < p; c++) {\n        cycle[c] = s;\n        visited[s] = 1;\n        here[s] = next[s];\n        s += delta[s];\n      }\n      // Two sweeps: one covers the chains that stay inside the cycle order, the\n      // second the ones that wrap past the end.\n      for (let pass = 0; pass < 2; pass++) {\n        for (let c = p - 1; c >= 0; c--) {\n          const candidate = here[cycle[(c + 1) % p]] + 1;\n          if (candidate < here[cycle[c]]) here[cycle[c]] = candidate;\n        }\n      }\n    }\n    suffix[j] = here;\n  }\n\n  let remaining = suffix[0][0];\n  if (remaining >= UNREACHABLE) return null;\n\n  const presses = new Array<number>(m).fill(0);\n  let state = 0;\n  for (let j = 0; j < m; j++) {\n    const g = generators[j];\n    let candidate = state;\n    for (let c = 0; c < p; c++) {\n      if (c + suffix[j + 1][candidate] === remaining) {\n        presses[