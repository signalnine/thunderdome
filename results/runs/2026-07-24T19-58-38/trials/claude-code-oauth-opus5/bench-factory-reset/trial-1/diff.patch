+/**
+ * Searches that treat a reduced counter system as a walk through counter-offset
+ * space, for the shapes where the free variables are too many to enumerate.
+ */
+
+/** Largest offset space either strategy will materialise. */
+const STATE_BUDGET = 8_000_000;
+
+/** Edge relaxations the breadth-first search may perform. */
+const STATE_WORK_BUDGET = 1_500_000_000;
+
+/** Press multisets each half of the split search may tabulate. */
+const HALF_BUDGET = 1_000_000;
+
+/** How often a search checks the clock, in nodes. */
+const CLOCK_INTERVAL = 4_095;
+
+/** Entries the per-button suffix cost tables may hold, at two bytes each. */
+const SUFFIX_BUDGET = 80_000_000;
+
+/** Stands in for "no number of presses reaches this offset" in a cost table. */
+const UNREACHABLE = 65535;
+
+/**
+ * A counter system already in reduced row echelon form.
+ *
+ * Row reduction turns the counters into `rank` independent rows, so pressing
+ * button `b` once adds column `b` of {@link generators} to the counter offsets
+ * and the puzzle becomes: reach {@link target} in as few presses as possible.
+ */
+export interface ReducedSystem {
+  /** Prime modulus the counters wrap at. */
+  p: number;
+  /** Number of independent rows, i.e. the length of a counter-offset vector. */
+  rank: number;
+  /** Number of buttons. */
+  buttonCount: number;
+  /**
+   * Column-major `buttonCount x rank` offsets, `generators[b * rank + i]`.
+   *
+   * The columns must span the offset space, which row reduction guarantees:
+   * each pivot column comes out as a distinct unit vector.
+   */
+  generators: Int32Array;
+  /** The counter offsets the presses have to add up to. */
+  target: Int32Array;
+  /** Timestamp past which a search should give up on ordering its answer. */
+  deadline: number;
+}
+
+
+/**
+ * Decides whether the residual state space is small enough to explore, and
+ * returns the buttons worth exploring it with.
+ *
+ * Buttons that move nothing, and duplicates of a button already listed, add no
+ * new edges to the search, so only distinct non-zero columns are kept.
+ */
+export function planStateSearch(system: ReducedSystem): number[] | null {
+  const { p, rank, generators, buttonCount } = system;
+  const stateCount = Math.pow(p, rank);
+  if (stateCount > STATE_BUDGET) return null;
+
+  const movers: number[] = [];
+  const seen = new Set<string>();
+  for (let b = 0; b < buttonCount; b++) {
+    let key = '';
+    let moves = false;
+    for (let i = 0; i < rank; i++) {
+      const v = generators[b * rank + i];
+      if (v !== 0) moves = true;
+      key += v + ',';
+    }
+    if (!moves || seen.has(key)) continue;
+    seen.add(key);
+    movers.push(b);
+  }
+  if (stateCount * rank * Math.max(movers.length, 1) > STATE_WORK_BUDGET) return null;
+  return movers;
+}
+
+/**
+ * Treats the reduced system as a walk through the space of counter offsets:
+ * pressing a button steps by that button's column, and the puzzle is to reach
+ * the target offset in as few steps as possible.
+ *
+ * Pressing a button p times is a no-op that costs p presses, so the shortest
+ * walk never repeats one that often and always respects the 0..p-1 range.
+ *
+ * Costing each button suffix separately answers the puzzle outright, but needs
+ * a table per button; where that will not fit, a single distance field over the
+ * offsets guides a search instead.
+ *
+ * Only call this once {@link planStateSearch} has approved the system; either
+ * way it materialises at least one array entry per offset.
+ */
+export function walkResidualStates(system: ReducedSystem, movers: number[]): number[] {
+  const stateCount = Math.pow(system.p, system.rank);
+  return (system.buttonCount + 1) * stateCount <= SUFFIX_BUDGET
+    ? walkBySuffixCost(system)
+    : walkByDistanceField(system, movers);
+}
+
+/**
+ * Per button and offset digit, how the offset index changes when that digit
+ * steps by the button's column, in both directions.
+ */
+function offsetSteps(system: ReducedSystem, powers: Int32Array): {
+  stepUp: Int32Array;
+  stepDown: Int32Array;
+} {
+  const { p, rank, generators, buttonCount } = system;
+  const stepUp = new Int32Array(buttonCount * rank * p);
+  const stepDown = new Int32Array(buttonCount * rank * p);
+  for (let b = 0; b < buttonCount; b++) {
+    for (let i = 0; i < rank; i++) {
+      const g = generators[b * rank + i];
+      const row = (b * rank + i) * p;
+      for (let d = 0; d < p; d++) {
+        stepUp[row + d] = ((d + g) % p) * powers[i] - d * powers[i];
+        stepDown[row + d] = ((((d - g) % p) + p) % p) * powers[i] - d * powers[i];
+      }
+    }
+  }
+  return { stepUp, stepDown };
+}
+
+/** Powers of the modulus, for encoding an offset vector as an array index. */
+function offsetPowers(system: ReducedSystem): Int32Array {
+  const powers = new Int32Array(system.rank + 1);
+  powers[0] = 1;
+  for (let i = 0; i < system.rank; i++) powers[i + 1] = powers[i] * system.p;
+  return powers;
+}
+
+/** Index of the offset vector the presses have to add up to. */
+function targetIndex(system: ReducedSystem, powers: Int32Array): number {
+  let index = 0;
+  for (let i = 0; i < system.rank; i++) index += system.target[i] * powers[i];
+  return index;
+}
+
+/**
+ * Finds the fewest presses that reach every offset, then reads an answer back
+ * out of that distance field.
+ *
+ * The distances ignore which buttons are still to come, so they are only a
+ * lower bound for the reconstruction, which therefore has to search. When that
+ * search runs out of time the field still yields a shortest answer directly,
+ * just not necessarily the lexicographically smallest one.
+ */
+export function walkByDistanceField(system: ReducedSystem, movers: number[]): number[] {
+  const { p, rank, buttonCount, deadline } = system;
+  const powers = offsetPowers(system);
+  const stateCount = powers[rank];
+  const { stepUp, stepDown } = offsetSteps(system, powers);
+
+  const reduceBy = (state: number, button: number): number => {
+    const off = button * rank;
+    let to = state;
+    for (let i = 0; i < rank; i++) to += stepDown[(off + i) * p + (((state / powers[i]) | 0) % p)];
+    return to;
+  };
+
+  // distance[v] is the fewest presses that sum to the offset vector v, which
+  // is also the fewest presses that reduce v back to zero.
+  const distance = new Int32Array(stateCount).fill(-1);
+  const queue = new Int32Array(stateCount);
+  distance[0] = 0;
+  let head = 0;
+  let tail = 1;
+  const digits = new Int32Array(rank);
+  while (head < tail) {
+    const state = queue[head++];
+    const next = distance[state] + 1;
+    for (let i = 0; i < rank; i++) digits[i] = ((state / powers[i]) | 0) % p;
+    for (let q = 0; q < movers.length; q++) {
+      const off = movers[q] * rank;
+      let to = state;
+      for (let i = 0; i < rank; i++) to += stepUp[(off + i) * p + digits[i]];
+      if (distance[to] < 0) {
+        distance[to] = next;
+        queue[tail++] = to;
+      }
+    }
+  }
+
+  const targetState = targetIndex(system, powers);
+  const shortest = distance[targetState];
+
+  const presses = new Array<number>(buttonCount).fill(0);
+  let nodes = 0;
+  let exhausted = false;
+
+  const reconstruct = (button: number, remaining: number, used: number): boolean => {
+    if (remaining === 0) return true; // every button left keeps its zero
+    if (button === buttonCount) return false;
+    if ((++nodes & CLOCK_INTERVAL) === 0 && Date.now() > deadline) {
+      exhausted = true;
+      return false;
+    }
+    let state = remaining;
+    for (let v = 0; v < p; v++) {
+      if (v > 0) state = reduceBy(state, button);
+      if (used + v > shortest) break;
+      const lower = distance[state];
+      if (lower >= 0 && used + v + lower <= shortest) {
+        presses[button] = v;
+        if (reconstruct(button + 1, state, used + v)) return true;
+        if (exhausted) return false;
+      }
+    }
+    presses[button] = 0;
+    return false;
+  };
+
+  if (reconstruct(0, targetState, 0)) return presses;
+
+  // Fallback: follow the distance field straight down. Still a shortest walk,
+  // just not necessarily the lexicographically smallest one.
+  presses.fill(0);
+  let state = targetState;
+  let left = shortest;
+  while (left > 0) {
+    for (let b = 0; b < buttonCount; b++) {
+      const to = reduceBy(state, b);
+      if (distance[to] === left - 1) {
+        presses[b]++;
+        state = to;
+        left--;
+        break;
+      }
+    }
+  }
+  return presses;
+}
+
+/**
+ * Costs every button suffix, then reads off the answer greedily.
+ *
+ * `cost[b][v]` is the fewest presses of buttons `b` and later that add up to
+ * offset `v`. Working down from the last button, each table follows from the
+ * one after it: pressing button `b` a further time costs one press and slides
+ * the offset one step along that button's orbit, and since the orbit is a cycle
+ * of length p, two relaxation passes around it settle every entry.
+ *
+ * With those tables the answer falls out directly. Walking the buttons in
+ * order and taking the fewest presses that still leaves an optimal completion
+ * behind gives the lexicographically smallest of the shortest answers.
+ */
+export function walkBySuffixCost(system: ReducedSystem): number[] {
+  const { p, rank, generators, buttonCount } = system;
+  const powers = offsetPowers(system);
+  const stateCount = powers[rank];
+  const { stepDown } = offsetSteps(system, powers);
+
+  const reduceBy = (state: number, button: number): number => {
+    const off = button * rank;
+    let to = state;
+    for (let i = 0; i < rank; i++) to += stepDown[(off + i) * p + (((state / powers[i]) | 0) % p)];
+    return to;
+  };
+
+  const cost = new Uint16Array((buttonCount + 1) * stateCount);
+  // Past the last button nothing can move, so only a settled offset is free.
+  const beyond = buttonCount * stateCount;
+  cost.fill(UNREACHABLE, beyond, beyond + stateCount);
+  cost[beyond] = 0;
+
+  const visited = new Uint8Array(stateCount);
+  const orbit = new Int32Array(p);
+  const around = new Int32Array(p);
+  const digits = new Int32Array(rank);
+
+  for (let b = buttonCount - 1; b >= 0; b--) {
+    const from = (b + 1) * stateCount;
+    const into = b * stateCount;
+    let moves = false;
+    for (let i = 0; i < rank; i++) {
+      if (generators[b * rank + i] !== 0) {
+        moves = true;
+        break;
+      }
+    }
+    if (!moves) {
+      cost.copyWithin(into, from, from + stateCount);
+      continue;
+    }
+    visited.fill(0);
+    for (let start = 0; start < stateCount; start++) {
+      if (visited[start]) continue;
+      // Walking the orbit one press at a time, carrying the digits along rather
+      // than decoding them at every step.
+      for (let i = 0; i < rank; i++) digits[i] = ((start / powers[i]) | 0) % p;
+      let length = 0;
+      let state = start;
+      do {
+        visited[state] = 1;
+        orbit[length] = state;
+        around[length] = cost[from + state];
+        length++;
+        for (let i = 0; i < rank; i++) {
+          const g = generators[b * rank + i];
+          if (g === 0) continue;
+          const was = digits[i];
+          const now = was >= g ? was - g : was - g + p;
+          digits[i] = now;
+          state += (now - was) * powers[i];
+        }
+      } while (state !== start);
+      // One more press costs one and moves one place along the orbit. Two laps
+      // are enough for that to settle, including across the wrap.
+      for (let lap = 0; lap < 2; lap++) {
+        for (let i = length - 1; i >= 0; i--) {
+          const viaPress = around[(i + 1) % length] + 1;
+          if (viaPress < around[i]) around[i] = viaPress;
+        }
+      }
+      for (let i = 0; i < length; i++) cost[into + orbit[i]] = around[i];
+    }
+  }
+
+  let remaining = targetIndex(system, powers);
+  const presses = new Array<number>(buttonCount).fill(0);
+  let left = cost[remaining];
+  for (let b = 0; b < buttonCount && left > 0; b++) {
+    const next = (b + 1) * stateCount;
+    let state = remaining;
+    for (let v = 0; v <= left && v < p; v++) {
+      if (v > 0) state = reduceBy(state, b);
+      if (v + cost[next + state] === left) {
+        presses[b] = v;
+        remaining = state;
+        left -= v;
+        break;
+      }
+    }
+  }
+  return presses;
+}
+
+/**
+ * Searches for a short answer by splitting the presses in two.
+ *
+ * Any solution of `d` presses is the union of two press multisets of at most
+ * `ceil(d / 2)` presses each, so tabulating the counter offset every small
+ * multiset produces and then looking up each one's complement finds the fewest
+ * presses exactly — provided that number is at most twice the half size. The
+ * table doubles as an admissible heuristic for reading the lexicographically
+ * smallest answer back out.
+ *
+ * @returns the optimal press counts, or `null` when no short enough answer
+ * exists and the result would be inconclusive.
+ */
+export function splitPresses(system: ReducedSystem): number[] | null {
+  const { p, rank, generators, target, buttonCount, deadline } = system;
+  if (rank === 0 || buttonCount === 0) return null;
+
+  // Counter vectors are used as map keys, so they have to encode exactly.
+  const powers = new Float64Array(rank + 1);
+  powers[0] = 1;
+  for (let i = 0; i < rank; i++) powers[i + 1] = powers[i] * p;
+  if (powers[rank] > Number.MAX_SAFE_INTEGER) return null;
+
+  // Largest half that keeps the table within budget. Multisets of at most
+  // `size` presses over `buttonCount` buttons number C(buttonCount + size, size).
+  let half = 0;
+  let multisets = 1;
+  const maxHalf = Math.ceil((buttonCount * (p - 1)) / 2);
+  while (half < maxHalf) {
+    const grown = (multisets * (buttonCount + half + 1)) / (half + 1);
+    if (grown > HALF_BUDGET) break;
+    multisets = grown;
+    half++;
+  }
+  if (half === 0) return null;
+
+  const digits = new Int32Array(rank);
+  const counts = new Int32Array(buttonCount);
+  let encoded = 0;
+
+  const press = (b: number): void => {
+    const off = b * rank;
+    for (let i = 0; i < rank; i++) {
+      const g = generators[off + i];
+      if (g === 0) continue;
+      const was = digits[i];
+      const now = (was + g) % p;
+      digits[i] = now;
+      encoded += (now - was) * powers[i];
+    }
+  };
+  const release = (b: number): void => {
+    const off = b * rank;
+    for (let i = 0; i < rank; i++) {
+      const g = generators[off + i];
+      if (g === 0) continue;
+      const was = digits[i];
+      const now = (was - g + p) % p;
+      digits[i] = now;
+      encoded += (now - was) * powers[i];
+    }
+  };
+
+  /** Walks every multiset of at most `left` further presses, in button order. */
+  const walk = (start: number, left: number, size: number, visit: (size: number) => void): void => {
+    visit(size);
+    if (left === 0) return;
+    for (let b = start; b < buttonCount; b++) {
+      if (counts[b] >= p - 1) continue;
+      counts[b]++;
+      press(b);
+      walk(b, left - 1, size + 1, visit);
+      release(b);
+      counts[b]--;
+    }
+  };
+
+  const reach = new Map<number, number>();
+  walk(0, half, 0, (size) => {
+    const seen = reach.get(encoded);
+    if (seen === undefined || size < seen) reach.set(encoded, size);
+  });
+
+  let targetEncoded = 0;
+  for (let i = 0; i < rank; i++) targetEncoded += target[i] * powers[i];
+
+  let shortest = Infinity;
+  walk(0, half, 0, (size) => {
+    if (size >= shortest) return;
+    let complement = 0;
+    for (let i = 0; i < rank; i++) {
+      complement += ((((target[i] - digits[i]) % p) + p) % p) * powers[i];
+    }
+    const other = reach.get(complement);
+    if (other !== undefined && size + other < shortest) shortest = size + other;
+  });
+  if (shortest === Infinity) return null;
+
+  // Read back the lexicographically smallest of the shortest answers: try the
+  // fewest presses on the lowest-numbered buttons first, and cut off any branch
+  // whose remaining offset already needs too many presses.
+  digits.set(target);
+  encoded = targetEncoded;
+  const presses = new Array<number>(buttonCount).fill(0);
+  let expired = false;
+  let nodes = 0;
+
+  const reconstruct = (button: number, used: number): boolean => {
+    if (encoded === 0) return true; // every button left keeps its zero
+    if (button === buttonCount) return false;
+    if ((++nodes & CLOCK_INTERVAL) === 0 && Date.now() > deadline) {
+      expired = true;
+      return false;
+    }
+    let taken = 0;
+    let done = false;
+    for (let v = 0; v < p; v++) {
+      if (v > 0) {
+        release(button);
+        taken++;
+      }
+      if (used + v > shortest) break;
+      const lower = reach.get(encoded) ?? half + 1;
+      if (used + v + lower <= shortest) {
+        presses[button] = v;
+        if (reconstruct(button + 1, used + v)) {
+          done = true;
+          break;
+        }
+        if (expired) break;
+      }
+    }
+    for (let i = 0; i < taken; i++) press(button);
+    if (!done) presses[button] = 0;
+    return done;
+  };
+
+  return reconstruct(0, 0) ? presses : null;
+}
