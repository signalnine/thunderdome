ducedSystem): number[] | null {\n  const { p, rank, buttonCount, generators, target } = system;\n  const presses = new Array<number>(buttonCount).fill(0);\n  let best: number[] | null = null;\n  let bestSum = Infinity;\n  const total = p ** buttonCount;\n  for (let step = 0; step < total; step++) {\n    if (step > 0) {\n      for (let b = 0; b < buttonCount; b++) {\n        if (++presses[b] < p) break;\n        presses[b] = 0;\n      }\n    }\n    let sum = 0;\n    for (let b = 0; b < buttonCount; b++) sum += presses[b];\n    if (sum > bestSum) continue;\n    let matches = true;\n    for (let i = 0; i < rank && matches; i++) {\n      let v = 0;\n      for (let b = 0; b < buttonCount; b++) v += presses[b] * generators[b * rank + i];\n      matches = v % p === target[i];\n    }\n    if (!matches) continue;\n    if (best === null || sum < bestSum) {\n      best = [...presses];\n      bestSum = sum;\n      continue;\n    }\n    for (let b = 0; b < buttonCount; b++) {\n      if (presses[b] !== best[b]) {\n        if (presses[b] < best[b]) best = [...presses];\n        break;\n      }\n    }\n  }\n  return best;\n}\n\ndescribe('walkResidualStates', () => {\n  it('matches brute force on random small systems', () => {\n    const random = makeRandom(24680);\n    for (const [p, rank, buttons] of [\n      [2, 3, 6],\n      [3, 2, 5],\n      [3, 3, 5],\n      [5, 2, 4],\n      [7, 2, 4],\n    ]) {\n      for (let trial = 0; trial < 12; trial++) {\n        const system = makeSystem(p, rank, buttons, random);\n        const movers = planStateSearch(system);\n        expect(movers).not.toBeNull();\n        expect(walkResidualStates(system, movers ?? [])).toEqual(bruteForce(system));\n      }\n    }\n  });\n\n  it('declines a state space it cannot hold', () => {\n    const random = makeRandom(1);\n    expect(planStateSearch(makeSystem(97, 8, 12, random))).toBeNull();\n  });\n\n  it('ignores buttons that move nothing', () => {\n    const system: ReducedSystem = {\n      p: 5,\n      rank: 1,\n      buttonCount: 3,\n      generators: Int32Array.from([0, 1, 0]),\n      target: Int32Array.from([3]),\n      deadline: Date.now() + 10_000,\n    };\n    expect(planStateSearch(system)).toEqual([1]);\n    expect(walkResidualStates(system, [1])).toEqual([0, 3, 0]);\n  });\n});\n\ndescribe('splitPresses', () => {\n  it('matches brute force on random small systems', () => {\n    const random = makeRandom(13579);\n    for (const [p, rank, buttons] of [\n      [2, 3, 6],\n      [3, 2, 5],\n      [3, 3, 5],\n      [5, 2, 4],\n      [7, 2, 4],\n    ]) {\n      for (let trial = 0; trial < 12; trial++) {\n        const system = makeSystem(p, rank, buttons, random);\n        expect(splitPresses(system)).toEqual(bruteForce(system));\n      }\n    }\n  });\n\n  it('agrees with the state walk on a system too wide to brute force', () => {\n    const random = makeRandom(31415);\n    for (let trial = 0; trial < 5; trial++) {\n      const system = makeSystem(97, 3, 40, random);\n      const movers = planStateSearch(system);\n      expect(movers).not.toBeNull();\n      expect(splitPresses(system)).toEqual(walkResidualStates(system, movers ?? []));\n    }\n  });\n\n  it('reports inconclusive when every answer is longer than it can split', () => {\n    // Forty buttons over six counters mod 97 needs about thirteen presses,\n    // which is past what half-sized multisets can cover.\n    const random = makeRandom(2718);\n    expect(splitPresses(makeSystem(97, 6, 40, random))).toBeNull();\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
