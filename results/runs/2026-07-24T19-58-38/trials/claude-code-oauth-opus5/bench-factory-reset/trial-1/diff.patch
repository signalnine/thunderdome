+import type { Machine } from './types.js';
+import {
+  ctz32,
+  lexBetterMask,
+  lexBetterWord,
+  maskToIndices,
+  popcount,
+  weightOf,
+  wordsFor,
+} from './bits.js';
+
+/**
+ * Largest button count the meet-in-the-middle search will take on. Each half is
+ * enumerated exhaustively, so this caps that at 2^25 subsets per side.
+ */
+const MAX_MITM_BUTTONS = 50;
+
+/** Largest null-space dimension the coset walk will enumerate. */
+const MAX_DIRECT_NULLITY = 25;
+
+/**
+ * Finds the smallest set of buttons whose combined toggles turn the all-off
+ * machine into `machine.target`.
+ *
+ * Toggling is addition modulo 2 and pressing a button twice is a no-op, so the
+ * puzzle is the linear system `A x = target` over GF(2) with `x` in {0,1}^M.
+ * Gaussian elimination reduces the solution set to a particular solution plus
+ * the null space of `A`; the minimum-weight member of that coset is then found
+ * either by walking the coset directly or by meeting in the middle, whichever
+ * search space is smaller.
+ *
+ * @returns ascending button indices, or `null` when the target is unreachable.
+ */
+export function solveToggle(machine: Machine): number[] | null {
+  const target = machine.target ?? [];
+  const buttons = machine.buttons ?? [];
+  const lightCount = target.length;
+  const buttonCount = buttons.length;
+
+  // Pressing nothing is the unique zero-press solution, so it always wins.
+  let allOff = true;
+  for (let i = 0; i < lightCount; i++) {
+    if (target[i]) {
+      allOff = false;
+      break;
+    }
+  }
+  if (allOff) return [];
+
+  const wm = wordsFor(buttonCount);
+
+  // One equation per light: which buttons toggle it, and whether it must end on.
+  const rows = new Uint32Array(lightCount * wm);
+  const rhs = new Uint8Array(lightCount);
+  for (let l = 0; l < lightCount; l++) rhs[l] = target[l] ? 1 : 0;
+  for (let b = 0; b < buttonCount; b++) {
+    const toggled = buttons[b] ?? [];
+    for (let q = 0; q < toggled.length; q++) {
+      const light = toggled[q];
+      // A light listed twice by one button is toggled twice, i.e. not at all.
+      if (light >= 0 && light < lightCount) rows[light * wm + (b >>> 5)] ^= 1 << (b & 31);
+    }
+  }
+
+  // Reduced row echelon form over GF(2).
+  const pivotCols: number[] = [];
+  let rank = 0;
+  for (let col = 0; col < buttonCount && rank < lightCount; col++) {
+    const word = col >>> 5;
+    const bit = 1 << (col & 31);
+    let pivot = -1;
+    for (let r = rank; r < lightCount; r++) {
+      if (rows[r * wm + word] & bit) {
+        pivot = r;
+        break;
+      }
+    }
+    if (pivot < 0) continue;
+    if (pivot !== rank) {
+      for (let w = 0; w < wm; w++) {
+        const tmp = rows[pivot * wm + w];
+        rows[pivot * wm + w] = rows[rank * wm + w];
+        rows[rank * wm + w] = tmp;
+      }
+      const tmp = rhs[pivot];
+      rhs[pivot] = rhs[rank];
+      rhs[rank] = tmp;
+    }
+    for (let r = 0; r < lightCount; r++) {
+      if (r === rank || !(rows[r * wm + word] & bit)) continue;
+      for (let w = 0; w < wm; w++) rows[r * wm + w] ^= rows[rank * wm + w];
+      rhs[r] ^= rhs[rank];
+    }
+    pivotCols.push(col);
+    rank++;
+  }
+
+  // Rows past the last pivot have no coefficients left; a non-zero right-hand
+  // side there is the contradiction 0 = 1.
+  for (let r = rank; r < lightCount; r++) {
+    if (rhs[r]) return null;
+  }
+
+  const nullity = buttonCount - rank;
+  const mitmUsable = buttonCount <= MAX_MITM_BUTTONS;
+  // Walking the coset costs 2^nullity; meeting in the middle costs ~2^(M/2+1).
+  const preferDirect = nullity <= Math.ceil(buttonCount / 2) + 1 && nullity <= MAX_DIRECT_NULLITY;
+  if (!preferDirect && mitmUsable) {
+    return solveByMeetInTheMiddle(target, buttons, lightCount, buttonCount);
+  }
+  if (nullity > MAX_DIRECT_NULLITY) {
+    throw new RangeError(
+      `solveToggle: search space too large (${buttonCount} buttons, nullity ${nullity})`,
+    );
+  }
+
+  // Particular solution: free buttons unpressed, pivot buttons take their row's value.
+  const particular = new Uint32Array(wm);
+  for (let i = 0; i < rank; i++) {
+    if (rhs[i]) particular[pivotCols[i] >>> 5] |= 1 << (pivotCols[i] & 31);
+  }
+  if (nullity === 0) return maskToIndices(particular, 0, buttonCount);
+
+  // Null-space basis: one vector per free button, pressing it plus whichever
+  // pivot buttons undo its effect.
+  const isPivot = new Uint8Array(buttonCount);
+  for (const col of pivotCols) isPivot[col] = 1;
+  const basis = new Uint32Array(nullity * wm);
+  let slot = 0;
+  for (let col = 0; col < buttonCount; col++) {
+    if (isPivot[col]) continue;
+    const off = slot * wm;
+    basis[off + (col >>> 5)] |= 1 << (col & 31);
+    for (let i = 0; i < rank; i++) {
+      if ((rows[i * wm + (col >>> 5)] >>> (col & 31)) & 1) {
+        basis[off + (pivotCols[i] >>> 5)] |= 1 << (pivotCols[i] & 31);
+      }
+    }
+    slot++;
+  }
+
+  return walkCoset(particular, basis, nullity, wm, buttonCount);
+}
+
+/**
+ * Enumerates the whole solution coset with a Gray-code walk: successive subsets
+ * of the null basis differ by one vector, so each step is a single XOR and an
+ * incremental weight update.
+ */
+function walkCoset(
+  particular: Uint32Array,
+  basis: Uint32Array,
+  nullity: number,
+  wm: number,
+  buttonCount: number,
+): number[] {
+  const current = Uint32Array.from(particular);
+  const best = Uint32Array.from(particular);
+  let currentWeight = weightOf(current, 0, wm);
+  let bestWeight = currentWeight;
+
+  const total = 2 ** nullity;
+  for (let step = 1; step < total; step++) {
+    const off = ctz32(step) * wm;
+    for (let w = 0; w < wm; w++) {
+      const before = current[w];
+      const after = before ^ basis[off + w];
+      current[w] = after;
+      currentWeight += popcount(after) - popcount(before);
+    }
+    if (
+      currentWeight < bestWeight ||
+      (currentWeight === bestWeight && lexBetterMask(current, 0, best, 0, wm))
+    ) {
+      best.set(current);
+      bestWeight = currentWeight;
+    }
+  }
+  return maskToIndices(best, 0, buttonCount);
+}
+
+/**
+ * Splits the buttons in half and matches the two halves through the light
+ * vector they produce. Every candidate press set is the union of a subset of
+ * the low half and a subset of the high half, and the two halves must XOR to
+ * the target, so tabulating the best low subset per light vector lets the high
+ * half be scanned in a single pass.
+ *
+ * This path is taken only when the coset is huge, which means the rank is small
+ * and the table therefore holds at most 2^rank entries.
+ */
+function solveByMeetInTheMiddle(
+  target: boolean[],
+  buttons: number[][],
+  lightCount: number,
+  buttonCount: number,
+): number[] | null {
+  const wn = wordsFor(lightCount);
+  const columns = new Uint32Array(buttonCount * wn);
+  for (let b = 0; b < buttonCount; b++) {
+    const toggled = buttons[b] ?? [];
+    for (let q = 0; q < toggled.length; q++) {
+      const light = toggled[q];
+      if (light >= 0 && light < lightCount) columns[b * wn + (light >>> 5)] ^= 1 << (light & 31);
+    }
+  }
+  const targetBits = new Uint32Array(wn);
+  for (let l = 0; l < lightCount; l++) {
+    if (target[l]) targetBits[l >>> 5] |= 1 << (l & 31);
+  }
+
+  // Light vectors fit a float key exactly while they stay under 53 bits.
+  const numericKeys = wn <= 2 && lightCount <= 53;
+  const keyOf = numericKeys
+    ? (bits: Uint32Array): number | string =>
+        wn === 1 ? bits[0] : bits[1] * 4294967296 + bits[0]
+    : (bits: Uint32Array): number | string => {
+        let key = '';
+        for (let w = 0; w < wn; w++) key += bits[w].toString(36) + ',';
+        return key;
+      };
+
+  const lowCount = buttonCount >> 1;
+  const highCount = buttonCount - lowCount;
+
+  // Best low-half subset (fewest presses, then lexicographically first) per light vector.
+  const table = new Map<number | string, number>();
+  const lowBits = new Uint32Array(wn);
+  let lowMask = 0;
+  table.set(keyOf(lowBits), 0);
+  const lowTotal = 2 ** lowCount;
+  for (let step = 1; step < lowTotal; step++) {
+    const b = ctz32(step);
+    lowMask ^= 1 << b;
+    for (let w = 0; w < wn; w++) lowBits[w] ^= columns[b * wn + w];
+    const key = keyOf(lowBits);
+    const seen = table.get(key);
+    if (seen === undefined) {
+      table.set(key, lowMask);
+    } else {
+      const a = popcount(lowMask);
+      const c = popcount(seen);
+      if (a < c || (a === c && lexBetterWord(lowMask, seen))) table.set(key, lowMask);
+    }
+  }
+
+  const highBits = new Uint32Array(wn);
+  const wanted = new Uint32Array(wn);
+  let highMask = 0;
+  let bestWeight = Infinity;
+  let bestLow = 0;
+  let bestHigh = 0;
+  const highTotal = 2 ** highCount;
+  for (let step = 0; step < highTotal; step++) {
+    if (step > 0) {
+      const b = ctz32(step);
+      highMask ^= 1 << b;
+      const off = (lowCount + b) * wn;
+      for (let w = 0; w < wn; w++) highBits[w] ^= columns[off + w];
+    }
+    for (let w = 0; w < wn; w++) wanted[w] = targetBits[w] ^ highBits[w];
+    const low = table.get(keyOf(wanted));
+    if (low === undefined) continue;
+    const weight = popcount(low) + popcount(highMask);
+    if (weight > bestWeight) continue;
+    if (
+      weight < bestWeight ||
+      (low !== bestLow ? lexBetterWord(low, bestLow) : lexBetterWord(highMask, bestHigh))
+    ) {
+      bestWeight = weight;
+      bestLow = low;
+      bestHigh = highMask;
+    }
+  }
+  if (bestWeight === Infinity) return null;
+
+  const pressed: number[] = [];
+  for (let b = 0; b < lowCount; b++) {
+    if ((bestLow >>> b) & 1) pressed.push(b);
+  }
+  for (let b = 0; b < highCount; b++) {
+    if ((bestHigh >>> b) & 1) pressed.push(lowCount + b);
+  }
+  return pressed;
+}
