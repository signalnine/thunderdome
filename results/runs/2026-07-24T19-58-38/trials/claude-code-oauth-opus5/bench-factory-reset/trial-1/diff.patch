@@ -0,0 +1,10 @@
+/**
+ * A machine with N lights (all initially off) and M buttons, where each button
+ * toggles a fixed set of lights and may be pressed at most once.
+ */
+export interface Machine {
+  /** Desired state of each light. Lights are indexed by position and start off. */
+  target: boolean[];
+  /** `buttons[i]` lists the light indices toggled by button `i`. */
+  buttons: number[][];
+}
