+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UziJ5HdHDkZRYum4bTPGHb","type":"tool_result","content":"1\timport { describe, expect, it } from 'vitest';\n2\timport {\n3\t  planStateSearch,\n4\t  splitPresses,\n5\t  walkByDistanceField,\n6\t  walkBySuffixCost,\n7\t  walkResidualStates,\n8\t  type ReducedSystem,\n9\t} from '../src/pressSearch.js';\n10\t\n11\t/**\n12\t * These searches only ever run on systems far too large to brute force, so they\n13\t * are exercised here directly on small reduced systems instead.\n14\t */\n15\t\n16\t/** Deterministic PRNG so failures are reproducible. */\n17\tfunction makeRandom(seed: number): () => number {\n18\t  let state = seed >>> 0;\n19\t  return () => {\n20\t    state ^= state << 13;\n21\t    state ^= state >>> 17;\n22\t    state ^= state << 5;\n23\t    return (state >>> 0) / 4294967296;\n24\t  };\n25\t}\n26\t\n27\t/**\n28\t * Builds a reduced system whose first `rank` buttons are the identity, which is\n29\t * what row reduction always produces and what makes every offset reachable.\n30\t */\n31\tfunction makeSystem(\n32\t  p: number,\n33\t  rank: number,\n34\t  buttonCount: number,\n35\t  random: () => number,\n36\t): ReducedSystem {\n37\t  const generators = new Int32Array(buttonCount * rank);\n38\t  for (let i = 0; i < rank; i++) generators[i * rank + i] = 1;\n39\t  for (let b = rank; b < buttonCount; b++) {\n40\t    for (let i = 0; i < rank; i++) generators[b * rank + i] = Math.floor(random() * p);\n41\t  }\n42\t  const target = new Int32Array(rank);\n43\t  for (let i = 0; i < rank; i++) target[i] = Math.floor(random() * p);\n44\t  return { p, rank, buttonCount, generators, target, deadline: Date.now() + 10_000 };\n45\t}\n46\t\n47\t/** Exhaustive reference over every press vector in range. */\n48\tfunction bruteForce(system: ReducedSystem): number[] | null {\n49\t  const { p, rank, buttonCount, generators, target } = system;\n50\t  const presses = new Array<number>(buttonCount).fill(0);\n51\t  let best: number[] | null = null;\n52\t  let bestSum = Infinity;\n53\t  const total = p ** buttonCount;\n54\t  for (let step = 0; step < total; step++) {\n55\t    if (step > 0) {\n56\t      for (let b = 0; b < buttonCount; b++) {\n57\t        if (++presses[b] < p) break;\n58\t        presses[b] = 0;\n59\t      }\n60\t    }\n61\t    let sum = 0;\n62\t    for (let b = 0; b < buttonCount; b++) sum += presses[b];\n63\t    if (sum > bestSum) continue;\n64\t    let matches = true;\n65\t    for (let i = 0; i < rank && matches; i++) {\n66\t      let v = 0;\n67\t      for (let b = 0; b < buttonCount; b++) v += presses[b] * generators[b * rank + i];\n68\t      matches = v % p === target[i];\n69\t    }\n70\t    if (!matches) continue;\n71\t    if (best === null || sum < bestSum) {\n72\t      best = [...presses];\n73\t      bestSum = sum;\n74\t      continue;\n75\t    }\n76\t    for (let b = 0; b < buttonCount; b++) {\n77\t      if (presses[b] !== best[b]) {\n78\t        if (presses[b] < best[b]) best = [...presses];\n79\t        break;\n80\t      }\n81\t    }\n82\t  }\n83\t  return best;\n84\t}\n85\t\n86\tconst SHAPES: [number, number, number][] = [\n87\t  [2, 3, 6],\n88\t  [3, 2, 5],\n89\t  [3, 3, 5],\n90\t  [5, 2, 4],\n91\t  [7, 2, 4],\n92\t];\n93\t\n94\tdescribe('walkResidualStates', () => {\n95\t  it('matches brute force on random small systems', () => {\n96\t    const random = makeRandom(24680);\n97\t    for (const [p, rank, buttons] of SHAPES) {\n98\t      for (let trial = 0; trial < 12; trial++) {\n99\t        const system = makeSystem(p, rank, buttons, random);\n100\t        const movers = planStateSearch(system);\n101\t        expect(movers).not.toBeNull();\n102\t        expect(walkResidualStates(system, movers ?? [])).toEqual(bruteForce(system));\n103\t      }\n104\t    }\n105\t  });\n106\t\n107\t  it('gets the same answer from either strategy', () => {\n108\t    // Which strategy runs depends on how many cost tables would fit, so both\n109\t    // are checked here directly.\n110\t    const random = makeRandom(112358);\n111\t    for (const [p, rank, buttons] of SHAPES) {\n112\t      for (let trial = 0; trial < 12; trial++) {\n113\t        const system = makeSystem(p, rank, buttons, random);\n114\t        const expected = bruteForce(system);\n115\t        expect(walkBySuffixCost(system)).toEqual(expected);\n116\t        expect(walkByDistanceField(system, planStateSearch(system) ?? [])).toEqual(expected);\n117\t      }\n118\t    }\n119\t  });\n120\t\n121\t  it('reads back a shortest walk when reconstruction runs out of time', () => {\n122\t    // A deadline already past forces the distance field's fallback, which keeps\n123\t    // the press count minimal but gives up on ordering.\n124\t    const random = makeRandom(6021);\n125\t    for (let trial = 0; trial < 12; trial++) {\n126\t      const system = makeSystem(5, 3, 5, random);\n127\t      const total = (best: number[] | null) => (best ?? []).reduce((a, b) => a + b, 0);\n128\t      const rushed = walkByDistanceField({ ...system, deadline: 0 }, planStateSearch(system) ?? []);\n129\t      expect(total(rushed)).toBe(total(bruteForce(system)));\n130\t    }\n131\t  });\n132\t\n133\t  it('declines a state space it cannot hold', () => {\n134\t    const random = makeRandom(1);\n135\t    expect(planStateSearch(makeSystem(97, 8, 12, random))).toBeNull();\n136\t  });\n137\t\n138\t  it('ignores buttons that move nothing', () => {\n139\t    const system: ReducedSystem = {\n140\t      p: 5,\n141\t      rank: 1,\n142\t      buttonCount: 3,\n143\t      generators: Int32Array.from([0, 1, 0]),\n144\t      target: Int32Array.from([3]),\n145\t      deadline: Date.now() + 10_000,\n146\t    };\n147\t    expect(planStateSearch(system)).toEqual([1]);\n148\t    expect(walkResidualStates(system, [1])).toEqual([0, 3, 0]);\n149\t  });\n150\t});\n151\t\n152\tdescribe('splitPresses', () => {\n153\t  it('matches brute force on random small systems', () => {\n154\t    const random = makeRandom(13579);\n155\t    for (const [p, rank, buttons] of [\n156\t      [2, 3, 6],\n157\t      [3, 2, 5],\n158\t      [3, 3, 5],\n159\t      [5, 2, 4],\n160\t      [7, 2, 4],\n161\t    ]) {\n162\t      for (let trial = 0; trial < 12; trial++) {\n163\t        const system = makeSystem(p, rank, buttons, random);\n164\t        expect(splitPresses(system)).toEqual(bruteForce(system));\n165\t      }\n166\t    }\n167\t  });\n168\t\n169\t  it('agrees with the state walk on a system too wide to brute force', () => {\n170\t    const random = makeRandom(31415);\n171\t    for (let trial = 0; trial < 5; trial++) {\n172\t      const system = makeSystem(97, 3, 40, random);\n173\t      const movers = planStateSearch(system);\n174\t      expect(movers).not.toBeNull();\n175\t      expect(splitPresses(system)).toEqual(walkResidualStates(system, movers ?? []));\n176\t    }\n177\t  });\n178\t\n179\t  it('reports inconclusive when every answer is longer than it can split', () => {\n180\t    // Forty buttons over six counters mod 97 needs about thirteen presses,\n181\t    // which is past what half-sized multisets can cover.\n182\t    const random = makeRandom(2718);\n183\t    expect(splitPresses(makeSystem(97, 6, 40, random))).toBeNull();\n184\t  });\n185\t});\n186\t"}]},"parent_tool_use_id":"toolu_01WSSqK6RbkBbvaR8h4kNxvX","session_id":"91404b81-880d-431d-80a0-ba44a8e2d951","uuid":"9757cf50-bc07-47eb-ab03-fd1b7e995ee3","timestamp":"2026-07-24T22:19:00.090Z","subagent_type":"general-purpose","task_description":"Audit solver implementation"}
