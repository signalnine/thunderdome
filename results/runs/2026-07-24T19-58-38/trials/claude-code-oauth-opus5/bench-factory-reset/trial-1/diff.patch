+/** Number of 32-bit words needed to hold `bits` bits (always at least one). */
+export function wordsFor(bits: number): number {
+  return Math.max(1, (bits + 31) >>> 5);
+}
+
+/** Population count of a 32-bit word. */
+export function popcount(v: number): number {
+  v = v - ((v >>> 1) & 0x55555555);
+  v = (v & 0x33333333) + ((v >>> 2) & 0x33333333);
+  v = (v + (v >>> 4)) & 0x0f0f0f0f;
+  return Math.imul(v, 0x01010101) >>> 24;
+}
+
+/** Index of the lowest set bit of a non-zero 32-bit word. */
+export function ctz32(v: number): number {
+  return 31 - Math.clz32(v & -v);
+}
+
+/** Total number of set bits across a multi-word bit set. */
+export function weightOf(bits: Uint32Array, offset: number, words: number): number {
+  let total = 0;
+  for (let w = 0; w < words; w++) total += popcount(bits[offset + w]);
+  return total;
+}
+
+/**
+ * Compares two equal-cardinality button sets the way their sorted index arrays
+ * compare lexicographically.
+ *
+ * Two sets of the same size first differ at their lowest differing index, and
+ * whichever set *contains* that index is the one with the smaller sorted array
+ * (its arrays agree up to that point and it continues with a smaller value).
+ */
+export function lexBetterMask(
+  a: Uint32Array,
+  aOffset: number,
+  b: Uint32Array,
+  bOffset: number,
+  words: number,
+): boolean {
+  for (let w = 0; w < words; w++) {
+    const diff = a[aOffset + w] ^ b[bOffset + w];
+    if (diff !== 0) return (a[aOffset + w] & (diff & -diff)) !== 0;
+  }
+  return false;
+}
+
+/** Single-word form of {@link lexBetterMask}. */
+export function lexBetterWord(a: number, b: number): boolean {
+  const diff = a ^ b;
+  return diff !== 0 && (a & (diff & -diff)) !== 0;
+}
+
+/** Ascending list of the indices set in a multi-word bit set. */
+export function maskToIndices(bits: Uint32Array, offset: number, count: number): number[] {
+  const out: number[] = [];
+  for (let i = 0; i < count; i++) {
+    if ((bits[offset + (i >>> 5)] >>> (i & 31)) & 1) out.push(i);
+  }
+  return out;
+}
