+  const reduced: ReducedSystem = {
+    p,
+    rank,
+    buttonCount,
+    generators,
+    target: base,
+    deadline: search.deadline,
+  };
+  const movers = planStateSearch(reduced);
+  if (movers !== null) return walkResidualStates(reduced, movers);
+
+  // Still too big to enumerate either way, but a small answer can be caught by
+  // splitting the presses in half.
+  const split = splitPresses(reduced);
+  if (split !== null) return split;
+
+  return branchAndBound(search);
+}
+
+interface Search {
+  p: number;
+  rank: number;
+  freeCount: number;
+  columns: Int32Array;
+  base: Int32Array;
+  slotOfCol: Int32Array;
+  buttonCount: number;
+  /** Timestamp past which a search should return its best answer so far. */
+  deadline: number;
+}
+
+/**
+ * Visits every assignment of the free variables with a mixed-radix odometer.
+ * Each tick subtracts one column from the running residuals, so a step costs
+ * only as much as the columns it carries through.
+ */
+function sweepAllAssignments(search: Search): number[] {
+  const { p, rank, freeCount, columns, base, slotOfCol, buttonCount } = search;
+  const y = new Int32Array(freeCount);
+  const res = Int32Array.from(base);
+  let sumY = 0;
+  let sumRes = 0;
+  for (let i = 0; i < rank; i++) sumRes += res[i];
+
+  let bestCost = sumY + sumRes;
+  let best = materialize(y, res, 0, slotOfCol, buttonCount);
+
+  const total = Math.pow(p, freeCount);
+  for (let step = 1; step < total; step++) {
+    let j = 0;
+    for (;;) {
+      const off = j * rank;
+      for (let i = 0; i < rank; i++) {
+        const c = columns[off + i];
+        if (c === 0) continue;
+        let v = res[i] - c;
+        if (v < 0) v += p;
+        sumRes += v - res[i];
+        res[i] = v;
+      }
+      sumY++;
+      if (++y[j] === p) {
+        y[j] = 0;
+        sumY -= p;
+        if (++j === freeCount) break;
+      } else {
+        break;
+      }
+    }
+    const cost = sumY + sumRes;
+    if (cost > bestCost) continue;
+    if (cost < bestCost || lexLess(y, res, 0, slotOfCol, buttonCount, best)) {
+      bestCost = cost;
+      best = materialize(y, res, 0, slotOfCol, buttonCount);
+    }
+  }
+  return best;
+}
+
+/**
+ * Depth-first search over the free variables when there are too many to sweep.
+ *
+ * The bound is exact on the part of the objective already pinned down: the
+ * presses spent on assigned free variables, plus the value of every pivot row
+ * whose free variables have all been assigned. Variables are ordered to settle
+ * rows as early as possible so that bound bites soon, and a coordinate-descent
+ * incumbent gives it something to bite against.
+ *
+ * This is the last resort, reached only when neither the free variables nor the
+ * residual states can be enumerated. It stops after {@link BRANCH_BUDGET} nodes
+ * and returns the best solution it has, which is valid but may not be minimal.
+ */
+function branchAndBound(search: Search): number[] {
+  const { p, rank, freeCount, columns, base, slotOfCol, buttonCount } = search;
+
+  // How many unassigned free variables still feed each pivot row.
+  const degree = new Int32Array(rank);
+  for (let i = 0; i < rank; i++) {
+    let d = 0;
+    for (let j = 0; j < freeCount; j++) {
+      if (columns[j * rank + i] !== 0) d++;
+    }
+    degree[i] = d;
+  }
+  // Rows no free variable touches are fixed for every candidate.
+  let constant = 0;
+  for (let i = 0; i < rank; i++) {
+    if (degree[i] === 0) constant += base[i];
+  }
+
+  // Greedy variable order: prefer whichever variable settles the most rows.
+  const order = new Int32Array(freeCount);
+  const settledAt: number[][] = [];
+  const taken = new Uint8Array(freeCount);
+  const remaining = Int32Array.from(degree);
+  for (let d = 0; d < freeCount; d++) {
+    let pick = -1;
+    let pickScore = -1;
+    let pickDegree = -1;
+    for (let j = 0; j < freeCount; j++) {
+      if (taken[j]) continue;
+      let score = 0;
+      let deg = 0;
+      for (let i = 0; i < rank; i++) {
+        if (columns[j * rank + i] === 0) continue;
+        deg++;
+        if (remaining[i] === 1) score++;
+      }
+      if (score > pickScore || (score === pickScore && deg > pickDegree)) {
+        pick = j;
+        pickScore = score;
+        pickDegree = deg;
+      }
+    }
+    taken[pick] = 1;
+    order[d] = pick;
+    const settled: number[] = [];
+    for (let i = 0; i < rank; i++) {
+      if (columns[pick * rank + i] === 0) continue;
+      if (--remaining[i] === 0) settled.push(i);
+    }
+    settledAt.push(settled);
+  }
+
+  const incumbent = coordinateDescent(search);
+  let bestCost = incumbent.cost;
+  let best = incumbent.values;
+
+  const resStack = new Int32Array((freeCount + 1) * rank);
+  for (let i = 0; i < rank; i++) resStack[i] = base[i];
+  const y = new Int32Array(freeCount);
+  let nodes = 0;
+  let expired = false;
+
+  const dfs = (depth: number, sumY: number, settledSum: number): void => {
+    if (sumY + settledSum > bestCost || expired) return;
+    if ((++nodes & CLOCK_INTERVAL) === 0 && Date.now() > search.deadline) {
+      expired = true;
+      return;
+    }
+    if (depth === freeCount) {
+      const cost = sumY + settledSum;
+      const offset = freeCount * rank;
+      if (cost < bestCost || lexLess(y, resStack, offset, slotOfCol, buttonCount, best)) {
+        bestCost = cost;
+        best = materialize(y, resStack, offset, slotOfCol, buttonCount);
+      }
+      return;
+    }
+    const j = order[depth];
+    const off = j * rank;
+    const src = depth * rank;
+    const dst = src + rank;
+    const settled = settledAt[depth];
+    for (let v = 0; v < p; v++) {
+      // Everything not yet accounted for is non-negative, so once the presses
+      // spent so far exceed the incumbent no larger value can recover.
+      if (sumY + v + settledSum > bestCost) break;
+      y[j] = v;
+      for (let i = 0; i < rank; i++) {
+        let nv = (resStack[src + i] - v * columns[off + i]) % p;
+        if (nv < 0) nv += p;
+        resStack[dst + i] = nv;
+      }
+      let nextSettled = settledSum;
+      for (let q = 0; q < settled.length; q++) nextSettled += resStack[dst + settled[q]];
+      dfs(depth + 1, sumY + v, nextSettled);
+    }
+    y[j] = 0;
+  };
+
+  dfs(0, 0, constant);
+  return best;
+}
+
+/**
+ * Hill-climbs on one free variable at a time from several starts, to get an
+ * upper bound the branch-and-bound can prune with straight away.
+ */
+function coordinateDescent(search: Search): { cost: number; values: number[] } {
+  const { p, rank, freeCount, columns, base, slotOfCol, buttonCount } = search;
+  const y = new Int32Array(freeCount);
+  const res = new Int32Array(rank);
+  let sumRes = 0;
+
+  const subtractColumn = (j: number): void => {
+    const off = j * rank;
+    for (let i = 0; i < rank; i++) {
+      const c = columns[off + i];
+      if (c === 0) continue;
+      let v = res[i] - c;
+      if (v < 0) v += p;
+      sumRes += v - res[i];
+      res[i] = v;
+    }
+  };
+
+  const recomputeResiduals = (): void => {
+    sumRes = 0;
+    for (let i = 0; i < rank; i++) {
+      let v = base[i];
+      for (let j = 0; j < freeCount; j++) {
+        const c = columns[j * rank + i];
+        if (c !== 0) v -= c * y[j];
+      }
+      v %= p;
+      if (v < 0) v += p;
+      res[i] = v;
+      sumRes += v;
+    }
+  };
+
+  let bestCost = Infinity;
+  let best: number[] = [];
+  let seed = 0x2545f491;
+  const nextRandom = (): number => {
+    seed ^= seed << 13;
+    seed ^= seed >>> 17;
+    seed ^= seed << 5;
+    return (seed >>> 0) / 4294967296;
+  };
+
+  for (let restart = 0; restart < RESTARTS; restart++) {
+    if (restart === 0) {
+      y.fill(0);
+    } else {
+      for (let j = 0; j < freeCount; j++) y[j] = Math.floor(nextRandom() * p);
+    }
+    recomputeResiduals();
+    let sumY = 0;
+    for (let j = 0; j < freeCount; j++) sumY += y[j];
+
+    let improved = true;
+    while (improved) {
+      improved = false;
+      for (let j = 0; j < freeCount; j++) {
+        const start = y[j];
+        const without = sumY - start;
+        let pickValue = start;
+        let pickCost = sumY + sumRes;
+        // Walk this variable through every value; each tick is one more press
+        // of the button, i.e. one more subtraction of its column.
+        for (let s = 1; s < p; s++) {
+          subtractColumn(j);
+          const value = (start + s) % p;
+          const cost = without + value + sumRes;
+          if (cost < pickCost) {
+            pickCost = cost;
+            pickValue = value;
+          }
+        }
+        subtractColumn(j); // p ticks in total return the residuals to `start`
+        for (let s = 0; s < (pickValue - start + p) % p; s++) subtractColumn(j);
+        if (pickValue !== start) {
+          y[j] = pickValue;
+          sumY = without + pickValue;
+          improved = true;
+        }
+      }
+    }
+
+    const cost = sumY + sumRes;
+    if (cost < bestCost || (cost === bestCost && lexLess(y, res, 0, slotOfCol, buttonCount, best))) {
+      bestCost = cost;
+      best = materialize(y, res, 0, slotOfCol, buttonCount);
+    }
+  }
+  return { cost: bestCost, values: best };
+}
