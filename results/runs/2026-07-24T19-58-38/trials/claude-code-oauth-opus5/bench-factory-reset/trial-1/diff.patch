@@ -0,0 +1,187 @@
+import { describe, expect, it } from 'vitest';
+import { solveCounter } from '../src/index.js';
+
+/** Applies press counts and reports the resulting counter values. */
+function apply(counters: number, buttons: number[][], presses: number[], modulus: number): number[] {
+  const state = new Array<number>(counters).fill(0);
+  for (let b = 0; b < buttons.length; b++) {
+    for (const c of buttons[b]) {
+      if (c >= 0 && c < counters) state[c] = (state[c] + presses[b]) % modulus;
+    }
+  }
+  return state;
+}
+
+/** Exhaustive reference solver; only usable for small button counts. */
+function bruteForce(lights: number[], buttons: number[][], modulus: number): number[] | null {
+  const m = buttons.length;
+  const presses = new Array<number>(m).fill(0);
+  let best: number[] | null = null;
+  const total = modulus ** m;
+  for (let step = 0; step < total; step++) {
+    if (step > 0) {
+      for (let j = 0; j < m; j++) {
+        if (++presses[j] < modulus) break;
+        presses[j] = 0;
+      }
+    }
+    const state = apply(lights.length, buttons, presses, modulus);
+    if (!state.every((v, i) => v === lights[i])) continue;
+    const sum = presses.reduce((a, b) => a + b, 0);
+    if (best === null) {
+      best = [...presses];
+      continue;
+    }
+    const bestSum = best.reduce((a, b) => a + b, 0);
+    if (sum < bestSum) {
+      best = [...presses];
+    } else if (sum === bestSum) {
+      for (let i = 0; i < m; i++) {
+        if (presses[i] !== best[i]) {
+          if (presses[i] < best[i]) best = [...presses];
+          break;
+        }
+      }
+    }
+  }
+  return best;
+}
+
+/** Deterministic PRNG so failures are reproducible. */
+function makeRandom(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state ^= state << 13;
+    state ^= state >>> 17;
+    state ^= state << 5;
+    return (state >>> 0) / 4294967296;
+  };
+}
+
+describe('solveCounter', () => {
+  it('presses nothing when every counter is already at its target', () => {
+    expect(solveCounter([0, 0], [[0], [1]], 5)).toEqual([0, 0]);
+  });
+
+  it('solves a single counter', () => {
+    expect(solveCounter([3], [[0]], 5)).toEqual([3]);
+  });
+
+  it('spreads presses across identical buttons to stay lexicographically first', () => {
+    // Every split of the four presses ties, so the leading entries stay small.
+    expect(solveCounter([4], [[0], [0]], 5)).toEqual([0, 4]);
+  });
+
+  it('uses wrap-around when it is cheaper than counting up', () => {
+    // Reaching 6 mod 7 costs six presses one way and one press the other.
+    expect(solveCounter([6], [[0], [0, 0]], 7)).toEqual([0, 3]);
+  });
+
+  it('reports no solution when the counters cannot be separated', () => {
+    // Every button moves both counters equally, so they can never differ.
+    expect(solveCounter([1, 2], [[0, 1], [0, 1]], 5)).toBeNull();
+  });
+
+  it('breaks ties on the lexicographically smallest press array', () => {
+    // Buttons 0 and 1 are interchangeable, so the presses go to the later one.
+    const solution = solveCounter([2], [[0], [0]], 5);
+    expect(solution).toEqual([0, 2]);
+  });
+
+  it('counts a counter listed twice by one button twice', () => {
+    expect(solveCounter([4], [[0, 0]], 7)).toEqual([2]);
+  });
+
+  it('handles no buttons', () => {
+    expect(solveCounter([0], [], 5)).toEqual([]);
+    expect(solveCounter([1], [], 5)).toBeNull();
+  });
+
+  it('handles no counters', () => {
+    expect(solveCounter([], [[0], [1]], 5)).toEqual([0, 0]);
+  });
+
+  it('agrees with brute force on random small systems', () => {
+    const random = makeRandom(31337);
+    for (const modulus of [2, 3, 5, 7]) {
+      for (let trial = 0; trial < 120; trial++) {
+        const counters = 1 + Math.floor(random() * 4);
+        const buttonCount = 1 + Math.floor(random() * 5);
+        const buttons: number[][] = [];
+        for (let b = 0; b < buttonCount; b++) {
+          const affected: number[] = [];
+          for (let c = 0; c < counters; c++) {
+            if (random() < 0.5) affected.push(c);
+          }
+          buttons.push(affected);
+        }
+        const lights = Array.from({ length: counters }, () => Math.floor(random() * modulus));
+        expect(solveCounter(lights, buttons, modulus)).toEqual(
+          bruteForce(lights, buttons, modulus),
+        );
+      }
+    }
+  });
+
+  it('agrees with brute force when buttons far outnumber counters', () => {
+    // Wide systems have large null spaces, which is the branch-and-bound path.
+    const random = makeRandom(5150);
+    for (const modulus of [3, 5]) {
+      for (let trial = 0; trial < 40; trial++) {
+        const counters = 1 + Math.floor(random() * 2);
+        const buttonCount = 6 + Math.floor(random() * 3);
+        const buttons: number[][] = [];
+        for (let b = 0; b < buttonCount; b++) {
+          const affected: number[] = [];
+          for (let c = 0; c < counters; c++) {
+            if (random() < 0.6) affected.push(c);
+          }
+          buttons.push(affected);
+        }
+        const lights = Array.from({ length: counters }, () => Math.floor(random() * modulus));
+        expect(solveCounter(lights, buttons, modulus)).toEqual(
+          bruteForce(lights, buttons, modulus),
+        );
+      }
+    }
+  });
+
+  it('solves 40 counters and 40 buttons at modulus 97 quickly', () => {
+    const random = makeRandom(9797);
+    for (let trial = 0; trial < 10; trial++) {
+      const buttons: number[][] = [];
+      for (let b = 0; b < 40; b++) {
+        const affected: number[] = [];
+        for (let c = 0; c < 40; c++) {
+          if (random() < 0.4) affected.push(c);
+        }
+        buttons.push(affected);
+      }
+      const truth = Array.from({ length: 40 }, () => Math.floor(random() * 97));
+      const lights = apply(40, buttons, truth, 97);
+      const started = Date.now();
+      const solution = solveCounter(lights, buttons, 97);
+      expect(Date.now() - started).toBeLessThan(5000);
+      expect(solution).not.toBeNull();
+      expect(apply(40, buttons, solution ?? [], 97)).toEqual(lights);
+    }
+  });
+
+  it('solves a wide system at modulus 97 quickly', () => {
+    const random = makeRandom(613);
+    const buttons: number[][] = [];
+    for (let b = 0; b < 40; b++) {
+      const affected: number[] = [];
+      for (let c = 0; c < 6; c++) {
+        if (random() < 0.5) affected.push(c);
+      }
+      buttons.push(affected);
+    }
+    const lights = Array.from({ length: 6 }, () => Math.floor(random() * 97));
+    const started = Date.now();
+    const solution = solveCounter(lights, buttons, 97);
+    expect(Date.now() - started).toBeLessThan(5000);
+    expect(solution).not.toBeNull();
+    expect(apply(6, buttons, solution ?? [], 97)).toEqual(lights);
+  });
+});
diff --git a/tests/pressSearch.test.ts b/tests/pressSearch.test.ts
new file mode 100644
index 0000000..835c9d8
--- /dev/null
+++ b/tests/pressSearch.test.ts
@@ -0,0 +1,185 @@
+import { describe, expect, it } from 'vitest';
+import {
+  planStateSearch,
+  splitPresses,
+  walkByDistanceField,
+  walkBySuffixCost,
+  walkResidualStates,
+  type ReducedSystem,
+} from '../src/pressSearch.js';
+
+/**
+ * These searches only ever run on systems far too large to brute force, so they
+ * are exercised here directly on small reduced systems instead.
+ */
+
+/** Deterministic PRNG so failures are reproducible. */
+function makeRandom(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state ^= state << 13;
+    state ^= state >>> 17;
+    state ^= state << 5;
+    return (state >>> 0) / 4294967296;
+  };
+}
+
+/**
+ * Builds a reduced system whose first `rank` buttons are the identity, which is
+ * what row reduction always produces and what makes every offset reachable.
+ */
+function makeSystem(
+  p: number,
+  rank: number,
+  buttonCount: number,
+  random: () => number,
+): ReducedSystem {
+  const generators = new Int32Array(buttonCount * rank);
+  for (let i = 0; i < rank; i++) generators[i * rank + i] = 1;
+  for (let b = rank; b < buttonCount; b++) {
+    for (let i = 0; i < rank; i++) generators[b * rank + i] = Math.floor(random() * p);
+  }
+  const target = new Int32Array(rank);
+  for (let i = 0; i < rank; i++) target[i] = Math.floor(random() * p);
+  return { p, rank, buttonCount, generators, target, deadline: Date.now() + 10_000 };
+}
+
+/** Exhaustive reference over every press vector in range. */
+function bruteForce(system: ReducedSystem): number[] | null {
+  const { p, rank, buttonCount, generators, target } = system;
+  const presses = new Array<number>(buttonCount).fill(0);
+  let best: number[] | null = null;
+  let bestSum = Infinity;
+  const total = p ** buttonCount;
+  for (let step = 0; step < total; step++) {
+    if (step > 0) {
+      for (let b = 0; b < buttonCount; b++) {
+        if (++presses[b] < p) break;
+        presses[b] = 0;
+      }
+    }
+    let sum = 0;
+    for (let b = 0; b < buttonCount; b++) sum += presses[b];
+    if (sum > bestSum) continue;
+    let matches = true;
+    for (let i = 0; i < rank && matches; i++) {
+      let v = 0;
+      for (let b = 0; b < buttonCount; b++) v += presses[b] * generators[b * rank + i];
+      matches = v % p === target[i];
+    }
+    if (!matches) continue;
+    if (best === null || sum < bestSum) {
+      best = [...presses];
+      bestSum = sum;
+      continue;
+    }
+    for (let b = 0; b < buttonCount; b++) {
+      if (presses[b] !== best[b]) {
+        if (presses[b] < best[b]) best = [...presses];
+        break;
+      }
+    }
+  }
+  return best;
+}
+
+const SHAPES: [number, number, number][] = [
+  [2, 3, 6],
+  [3, 2, 5],
+  [3, 3, 5],
+  [5, 2, 4],
+  [7, 2, 4],
+];
+
+describe('walkResidualStates', () => {
+  it('matches brute force on random small systems', () => {
+    const random = makeRandom(24680);
+    for (const [p, rank, buttons] of SHAPES) {
+      for (let trial = 0; trial < 12; trial++) {
+        const system = makeSystem(p, rank, buttons, random);
+        const movers = planStateSearch(system);
+        expect(movers).not.toBeNull();
+        expect(walkResidualStates(system, movers ?? [])).toEqual(bruteForce(system));
+      }
+    }
+  });
+
+  it('gets the same answer from either strategy', () => {
+    // Which strategy runs depends on how many cost tables would fit, so both
+    // are checked here directly.
+    const random = makeRandom(112358);
+    for (const [p, rank, buttons] of SHAPES) {
+      for (let trial = 0; trial < 12; trial++) {
+        const system = makeSystem(p, rank, buttons, random);
+        const expected = bruteForce(system);
+        expect(walkBySuffixCost(system)).toEqual(expected);
+        expect(walkByDistanceField(system, planStateSearch(system) ?? [])).toEqual(expected);
+      }
+    }
+  });
+
+  it('reads back a shortest walk when reconstruction runs out of time', () => {
+    // A deadline already past forces the distance field's fallback, which keeps
+    // the press count minimal but gives up on ordering.
+    const random = makeRandom(6021);
+    for (let trial = 0; trial < 12; trial++) {
+      const system = makeSystem(5, 3, 5, random);
+      const total = (best: number[] | null) => (best ?? []).reduce((a, b) => a + b, 0);
+      const rushed = walkByDistanceField({ ...system, deadline: 0 }, planStateSearch(system) ?? []);
+      expect(total(rushed)).toBe(total(bruteForce(system)));
+    }
+  });
+
+  it('declines a state space it cannot hold', () => {
+    const random = makeRandom(1);
+    expect(planStateSearch(makeSystem(97, 8, 12, random))).toBeNull();
+  });
+
+  it('ignores buttons that move nothing', () => {
+    const system: ReducedSystem = {
+      p: 5,
+      rank: 1,
+      buttonCount: 3,
+      generators: Int32Array.from([0, 1, 0]),
+      target: Int32Array.from([3]),
+      deadline: Date.now() + 10_000,
+    };
+    expect(planStateSearch(system)).toEqual([1]);
+    expect(walkResidualStates(system, [1])).toEqual([0, 3, 0]);
+  });
+});
+
+describe('splitPresses', () => {
+  it('matches brute force on random small systems', () => {
+    const random = makeRandom(13579);
+    for (const [p, rank, buttons] of [
+      [2, 3, 6],
+      [3, 2, 5],
+      [3, 3, 5],
+      [5, 2, 4],
+      [7, 2, 4],
+    ]) {
+      for (let trial = 0; trial < 12; trial++) {
+        const system = makeSystem(p, rank, buttons, random);
+        expect(splitPresses(system)).toEqual(bruteForce(system));
+      }
+    }
+  });
+
+  it('agrees with the state walk on a system too wide to brute force', () => {
+    const random = makeRandom(31415);
+    for (let trial = 0; trial < 5; trial++) {
+      const system = makeSystem(97, 3, 40, random);
+      const movers = planStateSearch(system);
+      expect(movers).not.toBeNull();
+      expect(splitPresses(system)).toEqual(walkResidualStates(system, movers ?? []));
+    }
+  });
+
+  it('reports inconclusive when every answer is longer than it can split', () => {
+    // Forty buttons over six counters mod 97 needs about thirteen presses,
+    // which is past what half-sized multisets can cover.
+    const random = makeRandom(2718);
+    expect(splitPresses(makeSystem(97, 6, 40, random))).toBeNull();
+  });
+});
diff --git a/tests/toggle.test.ts b/tests/toggle.test.ts
new file mode 100644
index 0000000..7787eb0
--- /dev/null
+++ b/tests/toggle.test.ts
@@ -0,0 +1,209 @@
+import { describe, expect, it } from 'vitest';
+import { solveToggle, type Machine } from '../src/index.js';
+
+/** Applies a press set and reports the resulting light states. */
+function apply(machine: Machine, presses: number[]): boolean[] {
+  const state = machine.target.map(() => false);
+  for (const b of presses) {
+    for (const light of machine.buttons[b]) {
+      if (light >= 0 && light < state.length) state[light] = !state[light];
+    }
+  }
+  return state;
+}
+
+/** Exhaustive reference solver; only usable for small button counts. */
+function bruteForce(machine: Machine): number[] | null {
+  const m = machine.buttons.length;
+  let best: number[] | null = null;
+  for (let mask = 0; mask < 1 << m; mask++) {
+    const presses: number[] = [];
+    for (let b = 0; b < m; b++) {
+      if ((mask >>> b) & 1) presses.push(b);
+    }
+    const state = apply(machine, presses);
+    if (!state.every((v, i) => v === machine.target[i])) continue;
+    if (best === null || presses.length < best.length) {
+      best = presses;
+      continue;
+    }
+    if (presses.length === best.length) {
+      for (let i = 0; i < presses.length; i++) {
+        if (presses[i] !== best[i]) {
+          if (presses[i] < best[i]) best = presses;
+          break;
+        }
+      }
+    }
+  }
+  return best;
+}
+
+/** Deterministic PRNG so failures are reproducible. */
+function makeRandom(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state ^= state << 13;
+    state ^= state >>> 17;
+    state ^= state << 5;
+    return (state >>> 0) / 4294967296;
+  };
+}
+
+describe('solveToggle', () => {
+  it('returns an empty press set when every light is already correct', () => {
+    expect(solveToggle({ target: [false, false, false], buttons: [[0], [1, 2]] })).toEqual([]);
+  });
+
+  it('detects the unsolvable example from the specification', () => {
+    const machine: Machine = {
+      target: [true, true, false, true],
+      buttons: [
+        [0, 1],
+        [1, 2, 3],
+        [0, 3],
+      ],
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it('solves a straightforward machine', () => {
+    const machine: Machine = {
+      target: [true, true, false, true],
+      buttons: [
+        [0, 1],
+        [1, 2, 3],
+        [0, 3],
+        [3],
+      ],
+    };
+    const solution = solveToggle(machine);
+    expect(solution).not.toBeNull();
+    expect(apply(machine, solution ?? [])).toEqual(machine.target);
+    expect(solution).toEqual(bruteForce(machine));
+  });
+
+  it('prefers fewer presses over a larger equivalent set', () => {
+    // Button 3 does on its own what buttons 0, 1 and 2 do together.
+    const machine: Machine = {
+      target: [true, true, true],
+      buttons: [[0], [1], [2], [0, 1, 2]],
+    };
+    expect(solveToggle(machine)).toEqual([3]);
+  });
+
+  it('breaks ties on the lexicographically smallest index list', () => {
+    // {0, 3} and {1, 2} both light everything; the first is lexicographically smaller.
+    const machine: Machine = {
+      target: [true, true, true, true],
+      buttons: [
+        [0, 1],
+        [0, 2],
+        [1, 3],
+        [2, 3],
+      ],
+    };
+    expect(solveToggle(machine)).toEqual([0, 3]);
+  });
+
+  it('treats a light listed twice by one button as untouched', () => {
+    const machine: Machine = { target: [true], buttons: [[0, 0], [0]] };
+    expect(solveToggle(machine)).toEqual([1]);
+  });
+
+  it('reports no solution when there are no buttons but lights to change', () => {
+    expect(solveToggle({ target: [true], buttons: [] })).toBeNull();
+  });
+
+  it('handles a machine with no lights at all', () => {
+    expect(solveToggle({ target: [], buttons: [[0], [1]] })).toEqual([]);
+  });
+
+  it('agrees with brute force on random small machines', () => {
+    const random = makeRandom(20260724);
+    for (let trial = 0; trial < 400; trial++) {
+      const lights = 1 + Math.floor(random() * 6);
+      const buttonCount = 1 + Math.floor(random() * 10);
+      const buttons: number[][] = [];
+      for (let b = 0; b < buttonCount; b++) {
+        const toggled: number[] = [];
+        for (let l = 0; l < lights; l++) {
+          if (random() < 0.5) toggled.push(l);
+        }
+        buttons.push(toggled);
+      }
+      const target = Array.from({ length: lights }, () => random() < 0.5);
+      const machine: Machine = { target, buttons };
+      expect(solveToggle(machine)).toEqual(bruteForce(machine));
+    }
+  });
+
+  it('agrees with brute force on machines with many dependent buttons', () => {
+    // Few lights and many buttons force the meet-in-the-middle path.
+    const random = makeRandom(777);
+    for (let trial = 0; trial < 60; trial++) {
+      const lights = 1 + Math.floor(random() * 3);
+      const buttonCount = 10 + Math.floor(random() * 5);
+      const buttons: number[][] = [];
+      for (let b = 0; b < buttonCount; b++) {
+        const toggled: number[] = [];
+        for (let l = 0; l < lights; l++) {
+          if (random() < 0.5) toggled.push(l);
+        }
+        buttons.push(toggled);
+      }
+      const target = Array.from({ length: lights }, () => random() < 0.5);
+      const machine: Machine = { target, buttons };
+      expect(solveToggle(machine)).toEqual(bruteForce(machine));
+    }
+  });
+
+  it('solves 40 lights and 40 buttons quickly', () => {
+    const random = makeRandom(4242);
+    for (let trial = 0; trial < 20; trial++) {
+      const buttons: number[][] = [];
+      for (let b = 0; b < 40; b++) {
+        const toggled: number[] = [];
+        for (let l = 0; l < 40; l++) {
+          if (random() < 0.5) toggled.push(l);
+        }
+        buttons.push(toggled);
+      }
+      // Build a reachable target so the instance is guaranteed solvable.
+      const target = new Array<boolean>(40).fill(false);
+      for (let b = 0; b < 40; b++) {
+        if (random() < 0.5) {
+          for (const l of buttons[b]) target[l] = !target[l];
+        }
+      }
+      const machine: Machine = { target, buttons };
+      const started = Date.now();
+      const solution = solveToggle(machine);
+      expect(Date.now() - started).toBeLessThan(5000);
+      expect(solution).not.toBeNull();
+      expect(apply(machine, solution ?? [])).toEqual(target);
+    }
+  });
+
+  it('solves 40 buttons against 12 lights quickly', () => {
+    // A low rank leaves a null space of dimension 28, far too large to walk.
+    const random = makeRandom(99);
+    const buttons: number[][] = [];
+    for (let b = 0; b < 40; b++) {
+      const toggled: number[] = [];
+      for (let l = 0; l < 12; l++) {
+        if (random() < 0.5) toggled.push(l);
+      }
+      buttons.push(toggled);
+    }
+    const target = Array.from({ length: 12 }, () => random() < 0.5);
+    const machine: Machine = { target, buttons };
+    const started = Date.now();
+    const solution = solveToggle(machine);
+    expect(Date.now() - started).toBeLessThan(5000);
+    expect(solution).not.toBeNull();
+    expect(apply(machine, solution ?? [])).toEqual(target);
+    // With 40 buttons over 12 lights a handful of presses always suffices.
+    expect((solution ?? []).length).toBeLessThanOrEqual(6);
+  });
+});
