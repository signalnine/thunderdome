for the best\n * answer found so far. Only the last-resort branch-and-bound and a pathological\n * reconstruction can reach this; every other path finishes far sooner.\n */\nconst TIME_BUDGET_MS = 3_000;\n\n/** How often a search checks the clock, in nodes. */\nconst CLOCK_INTERVAL = 4_095;\n\n/** Random restarts used to seed branch-and-bound with a good incumbent. */\nconst RESTARTS = 8;\n\n/** Multiplicative inverse of `a` modulo the prime `p`. */\nfunction modInverse(a: number, p: number): number {\n  let old = ((a % p) + p) % p;\n  let cur = p;\n  let oldCoeff = 1;\n  let coeff = 0;\n  while (cur !== 0) {\n    const q = Math.floor(old / cur);\n    [old, cur] = [cur, old - q * cur];\n    [oldCoeff, coeff] = [coeff, oldCoeff - q * coeff];\n  }\n  return ((oldCoeff % p) + p) % p;\n}\n\n/**\n * Reads the press count assigned to button `col`, given free-variable values\n * `y` and pivot residuals `res`.\n */\nfunction materialize(\n  y: Int32Array,\n  res: Int32Array,\n  resOffset: number,\n  slotOfCol: Int32Array,\n  buttonCount: number,\n): number[] {\n  const x = new Array<number>(buttonCount);\n  for (let c = 0; c < buttonCount; c++) {\n    const slot = slotOfCol[c];\n    x[c] = slot >= 0 ? y[slot] : res[resOffset + ~slot];\n  }\n  return x;\n}\n\n/** True when the candidate described by `y`/`res` is lexicographically before `other`. */\nfunction lexLess(\n  y: Int32Array,\n  res: Int32Array,\n  resOffset: number,\n  slotOfCol: Int32Array,\n  buttonCount: number,\n  other: number[],\n): boolean {\n  for (let c = 0; c < buttonCount; c++) {\n    const slot = slotOfCol[c];\n    const v = slot >= 0 ? y[slot] : res[resOffset + ~slot];\n    if (v !== other[c]) return v < other[c];\n  }\n  return false;\n}\n\n/**\n * Finds how many times to press each button so that every counter reaches its\n * target value modulo `modulus`.\n *\n * Presses commute and wrap at the modulus, so this is the linear system\n * `A x = lights` over GF(p) with `x` in [0, p)^M. Row reduction pins the pivot\n * buttons to a function of the free ones; the search below then picks the free\n * values minimising the total press count.\n *\n * @param lights target value of each counter (each counter starts at 0)\n * @param buttons `buttons[i]` lists the counter indices button `i` increments\n * @param modulus prime modulus the counters wrap at\n * @returns press count per button, or `null` when the target is unreachable.\n */\nexport function solveCounter(\n  lights: number[],\n  buttons: number[][],\n  modulus: number,\n): number[] | null {\n  const p = modulus;\n  const counterCount = lights.length;\n  const buttonCount = buttons.length;\n\n  if (!Number.isInteger(p) || p < 1) {\n    throw new RangeError(`solveCounter: modulus must be a positive integer, got ${modulus}`);\n  }\n  // Modulo 1 every counter is permanently 0, so nothing ever needs pressing.\n  if (p === 1) return new Array<number>(buttonCount).fill(0);\n\n  // Never pressing anything is the unique zero-press solution when it fits.\n  let allZero = true;\n  for (let r = 0; r < counterCount; r++) {\n    if ((((lights[r] % p) + p) % p) !== 0) {\n      allZero = false;\n      break;\n    }\n  }\n  if (allZero) return new Array<number>(buttonCount).fill(0);\n\n  // One equation per counter, augmented with its target value.\n  const stride = buttonCount + 1;\n  const matrix = new Int32Array(counterCount * stride);\n  for (let b = 0; b < buttonCount; b++) {\n    const affected = buttons[b] ?? [];\n    for (let q = 0; q < affected.length; q++) {\n      const c = affected[q];\n      // A counter listed twice by one button is incremented twice per press.\n      if (c >= 0 && c < counterCount) {\n        const at = c * stride + b;\n        matrix[at] = (matrix[at] + 1) % p;\n      }\n    }\n  }\n  for (let r = 0; r < counterCount; r++) {\n    matrix[r * stride + buttonCount] = (((lights[r] % p) + p) % p);\n  }\n\n  // Reduced row echelon form over GF(p).\n  const pivotCols: number[] = [];\n  let rank = 0;\n  for (let col = 0; col < buttonCount && rank < counterCount; col++) {\n    let pivot = -1;\n    for (let r = rank; r < counterCount; r++) {\n      if (matrix[r * stride + col] !== 0) {\n        pivot = r;\n        break;\n      }\n    }\n    if (pivot < 0) continue;\n    if (pivot !== rank) {\n      for (let t = col; t < stride; t++) {\n        const tmp = matrix[pivot * stride + t];\n        matrix[pivot * stride + t] = matrix[rank * stride + t];\n        matrix[rank * stride + t] = tmp;\n      }\n    }\n    const inv = modInverse(matrix[rank * stride + col], p);\n    if (inv !== 1) {\n      for (let t = col; t < stride; t++) {\n        matrix[rank * stride + t] = (matrix[rank * stride + t] * inv) % p;\n      }\n    }\n    for (let r = 0; r < counterCount; r++) {\n      if (r === rank) continue;\n      const factor = matrix[r * stride + col];\n      if (factor === 0) continue;\n      for (let t = col; t < stride; t++) {\n        let v = (matrix[r * stride + t] - factor * matrix[rank * stride + t]) % p;\n        if (v < 0) v += p;\n        matrix[r * stride + t] = v;\n      }\n    }\n    pivotCols.push(col);\n    rank++;\n  }\n\n  // A row with no coefficients left but a non-zero target is the statement 0 = c.\n  for (let r = rank; r < counterCount; r++) {\n    if (matrix[r * stride + buttonCount] !== 0) return null;\n  }\n\n  const isPivot = new Uint8Array(buttonCount);\n  for (const col of pivotCols) isPivot[col] = 1;\n  const freeCols: number[] = [];\n  for (let col = 0; col < buttonCount; col++) {\n    if (!isPivot[col]) freeCols.push(col);\n  }\n  const freeCount = freeCols.length;\n\n  // Where each button's press count comes from: a free slot, or a pivot row\n  // (encoded as its bitwise complement).\n  const slotOfCol = new Int32Array(buttonCount);\n  for (let j = 0; j < freeCount; j++) slotOfCol[freeCols[j]] = j;\n  for (let i = 0; i < rank; i++) slotOfCol[pivotCols[i]] = ~i;\n\n  // base[i] is pivot row i's target; columns[j * rank + i] is how much free\n  // variable j feeds into it.\n  const base = new Int32Array(rank);\n  for (let i = 0; i < rank; i++) base[i] = matrix[i * stride + buttonCount];\n  const columns = new Int32Array(freeCount * rank);\n  for (let j = 0; j < freeCount; j++) {\n    for (let i = 0; i < rank; i++) {\n      columns[j * rank + i] = matrix[i * stride + freeCols[j]];\n    }\n  }\n\n  if (freeCount === 0) {\n    const empty = new Int32Array(0);\n    return materialize(empty, base, 0, slotOfCol, buttonCount);\n  }\n\n  const search: Search = {\n    p,\n    rank,\n    freeCount,\n    columns,\n    base,\n    slotOfCol,\n    buttonCount,\n    deadline: Date.now() + TIME_BUDGET_MS,\n  };\n  if (Math.pow(p, freeCount) <= ENUMERATION_BUDGET) return sweepAllAssignments(search);\n\n  // The reduced rows say everything the system does, so button b moves the\n  // counters by column b of those rows and the puzzle becomes a walk in the\n  // residual space. That walk is cheap exactly when the sweep is not: few\n  // counters relative to buttons.\n  const generators = new Int32Array(buttonCount * rank);\n  for (let b = 0; b < buttonCount; b++) {\n    for (let i = 0; i < rank; i++) generators[b * rank + i] = matrix[i * stride + b];\n  }\n  const movers = planStateSearch(p, rank, generators, buttonCount);\n  if (movers !== null) return walkResidualStates(search, generators, movers);\n\n  // Still too big to enumerate either way, but a small answer can be caught by\n  // splitting the presses in half.\n  const split = splitPresses(search, generators);\n  if (split !== null) return split;\n\n  return branchAndBound(search);\n}\n\ninterface Search {\n  p: number;\n  rank: number;\n  freeCount: number;\n  columns: Int32Array;\n  base: Int32Array;\n  slotOfCol: Int32Array;\n  buttonCount: number;\n  /** Timestamp past which a search should return its best answer so far. */\n  deadline: number;\n}\n\n/**\n * Visits every assignment of the free variables with a mixed-radix odometer.\n * Each tick subtracts one column from the running residuals, so a step costs\n * only as much as the columns it carries through.\n */\nfunction sweepAllAssignments(search: Search): number[] {\n  const { p, rank, freeCount, columns, base, slotOfCol, buttonCount } = search;\n  const y = new Int32Array(freeCount);\n  const res = Int32Array.from(base);\n  let sumY = 0;\n  let sumRes = 0;\n  for (let i = 0; i < rank; i++) sumRes += res[i];\n\n  let bestCost = sumY + sumRes;\n  let best = materialize(y, res, 0, slotOfCol, buttonCount);\n\n  const total = Math.pow(p, freeCount);\n  for (let step = 1; step < total; step++) {\n    let j = 0;\n    for (;;) {\n      const off = j * rank;\n      for (let i = 0; i < rank; i++) {\n        const c = columns[off + i];\n        if (c === 0) continue;\n        let v = res[i] - c;\n        if (v < 0) v += p;\n        sumRes += v - res[i];\n        res[i] = v;\n      }\n      sumY++;\n      if (++y[j] === p) {\n        y[j] = 0;\n        sumY -= p;\n        if (++j === freeCount) break;\n      } else {\n        break;\n      }\n    }\n    const cost = sumY + sumRes;\n    if (cost > bestCost) continue;\n    if (cost < bestCost || lexLess(y, res, 0, slotOfCol, buttonCount, best)) {\n      bestCost = cost;\n      best = materialize(y, res, 0, slotOfCol, buttonCount);\n    }\n  }\n  return best;\n}\n\n/**\n * Depth-first search over the free variables when there are too many to sweep.\n *\n * The bound is exact on the part of the objective already pinned down: the\n * presses spent on assigned free variables, plus the value of every pivot row\n * whose free variables have all been assigned. Variables are ordered to settle\n * rows as early as possible so that bound bites soon, and a coordinate-descent\n * incumbent gives it something to bite against.\n *\n * This is the last resort, reached only when neither the free variables nor the\n * residual states can be enumerated. It stops after {@link BRANCH_BUDGET} nodes\n * and returns the best solution it has, which is valid but may not be minimal.\n */\nfunction branchAndBound(search: Search): number[] {\n  const { p, rank, freeCount, columns, base, slotOfCol, buttonCount } = search;\n\n  // How many unassigned free variables still feed each pivot row.\n  const degree = new Int32Array(rank);\n  for (let i = 0; i < rank; i++) {\n    let d = 0;\n    for (let j = 0; j < freeCount; j++) {\n      if (columns[j * rank + i] !== 0) d++;\n    }\n    degree[i] = d;\n  }\n  // Rows no free variable touches are fixed for every candidate.\n  let constant = 0;\n  for (let i = 0; i < rank; i++) {\n    if (degree[i] === 0) constant += base[i];\n  }\n\n  // Greedy variable order: prefer whichever variable settles the most rows.\n  const order = new Int32Array(freeCount);\n  const settledAt: number[][] = [];\n  const taken = new Uint8Array(freeCount);\n  const remaining = Int32Array.from(degree);\n  for (let d = 0; d < freeCount; d++) {\n    let pick = -1;\n    let pickScore = -1;\n    let pickDegree = -1;\n    for (let j = 0; j < freeCount; j++) {\n      if (taken[j]) continue;\n      let score = 0;\n      let deg = 0;\n      for (let i = 0; i < rank; i++) {\n        if (columns[j * rank + i] === 0) continue;\n        deg++;\n        if (remaining[i] === 1) score++;\n      }\n      if (score > pickScore || (score === pickScore && deg > pickDegree)) {\n        pick = j;\n        pickScore = score;\n        pickDegree = deg;\n      }\n    }\n    taken[pick] = 1;\n    order[d] = pick;\n    const settled: number[] = [];\n    for (let i = 0; i < rank; i++) {\n      if (columns[pick * rank + i] === 0) continue;\n      if (--remaining[i] === 0) settled.push(i);\n    }\n    settledAt.push(settled);\n  }\n\n  const incumbent = coordinateDescent(search);\n  let bestCost = incumbent.cost;\n  let best = incumbent.values;\n\n  const resStack = new Int32Array((freeCount + 1) * rank);\n  for (let i = 0; i < rank; i++) resStack[i] = base[i];\n  const y = new Int32Array(freeCount);\n  let nodes = 0;\n  let expire