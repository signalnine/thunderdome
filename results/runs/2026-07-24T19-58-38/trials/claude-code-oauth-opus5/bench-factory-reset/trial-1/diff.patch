+import {
+  planStateSearch,
+  splitPresses,
+  walkResidualStates,
+  type ReducedSystem,
+} from './pressSearch.js';
+
+/**
+ * Number of free-variable assignments the exhaustive sweep is allowed to visit.
+ * Beyond this the residual-state search or branch-and-bound takes over.
+ */
+const ENUMERATION_BUDGET = 3_000_000;
+
+/**
+ * Wall-clock milliseconds the searches may spend before settling for the best
+ * answer found so far. Only the last-resort branch-and-bound and a pathological
+ * reconstruction can reach this; every other path finishes far sooner.
+ */
+const TIME_BUDGET_MS = 2_000;
+
+/** How often a search checks the clock, in nodes. */
+const CLOCK_INTERVAL = 4_095;
+
+/** Random restarts used to seed branch-and-bound with a good incumbent. */
+const RESTARTS = 8;
+
+/** Multiplicative inverse of `a` modulo the prime `p`. */
+function modInverse(a: number, p: number): number {
+  let old = ((a % p) + p) % p;
+  let cur = p;
+  let oldCoeff = 1;
+  let coeff = 0;
+  while (cur !== 0) {
+    const q = Math.floor(old / cur);
+    [old, cur] = [cur, old - q * cur];
+    [oldCoeff, coeff] = [coeff, oldCoeff - q * coeff];
+  }
+  return ((oldCoeff % p) + p) % p;
+}
+
+/**
+ * Reads the press count assigned to button `col`, given free-variable values
+ * `y` and pivot residuals `res`.
+ */
+function materialize(
+  y: Int32Array,
+  res: Int32Array,
+  resOffset: number,
+  slotOfCol: Int32Array,
+  buttonCount: number,
+): number[] {
+  const x = new Array<number>(buttonCount);
+  for (let c = 0; c < buttonCount; c++) {
+    const slot = slotOfCol[c];
+    x[c] = slot >= 0 ? y[slot] : res[resOffset + ~slot];
+  }
+  return x;
+}
+
+/** True when the candidate described by `y`/`res` is lexicographically before `other`. */
+function lexLess(
+  y: Int32Array,
+  res: Int32Array,
+  resOffset: number,
+  slotOfCol: Int32Array,
+  buttonCount: number,
+  other: number[],
+): boolean {
+  for (let c = 0; c < buttonCount; c++) {
+    const slot = slotOfCol[c];
+    const v = slot >= 0 ? y[slot] : res[resOffset + ~slot];
+    if (v !== other[c]) return v < other[c];
+  }
+  return false;
+}
+
+/**
+ * Finds how many times to press each button so that every counter reaches its
+ * target value modulo `modulus`.
+ *
+ * Presses commute and wrap at the modulus, so this is the linear system
+ * `A x = lights` over GF(p) with `x` in [0, p)^M. Row reduction pins the pivot
+ * buttons to a function of the free ones, and what is left is a search for the
+ * free values that need the fewest presses. Which search depends on the shape:
+ * sweep the free values when there are few of them, walk the counter offsets
+ * when there are few counters, or split the presses in half when the answer is
+ * short.
+ *
+ * A system can be too wide for the first and too tall for the second — say
+ * twenty counters mod 97 against forty buttons, where the fewest presses is a
+ * genuinely hard question. There the answer is still valid and in range, but it
+ * is the best found within a time budget rather than a proven minimum.
+ *
+ * @param lights target value of each counter (each counter starts at 0)
+ * @param buttons `buttons[i]` lists the counter indices button `i` increments
+ * @param modulus prime modulus the counters wrap at
+ * @returns press count per button, or `null` when the target is unreachable.
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const p = modulus;
+  const counterCount = lights.length;
+  const buttonCount = buttons.length;
+
+  if (!Number.isInteger(p) || p < 1) {
+    throw new RangeError(`solveCounter: modulus must be a positive integer, got ${modulus}`);
+  }
+  // Modulo 1 every counter is permanently 0, so nothing ever needs pressing.
+  if (p === 1) return new Array<number>(buttonCount).fill(0);
+
+  // Never pressing anything is the unique zero-press solution when it fits.
+  let allZero = true;
+  for (let r = 0; r < counterCount; r++) {
+    if ((((lights[r] % p) + p) % p) !== 0) {
+      allZero = false;
+      break;
+    }
+  }
+  if (allZero) return new Array<number>(buttonCount).fill(0);
+
+  // One equation per counter, augmented with its target value.
+  const stride = buttonCount + 1;
+  const matrix = new Int32Array(counterCount * stride);
+  for (let b = 0; b < buttonCount; b++) {
