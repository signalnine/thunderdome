new file mode 100644
index 0000000..6115ff8
--- /dev/null
+++ b/src/routes/folders.ts
@@ -0,0 +1,208 @@
+import { Router } from 'express';
+import { currentUser } from '../auth.js';
+import { badRequest, notFound } from '../errors.js';
+import {
+  canRead,
+  folderSubtree,
+  isDescendantOf,
+  requireFolder,
+} from '../permissions.js';
+import type { Store } from '../store.js';
+import {
+  listShares,
+  parseRole,
+  resolveTargetUser,
+  revokeShare,
+  shareResource,
+} from '../sharing.js';
+import { documentView, folderView } from '../views.js';
+import { createDocument } from './documents.js';
+import { body, optionalId, requiredString, route } from './helpers.js';
+
+export function createFolderRouter(store: Store): Router {
+  const router = Router();
+
+  router.post(
+    '/',
+    route((req, res) => {
+      const user = currentUser(req);
+      const payload = body(req);
+      const name = requiredString(payload, 'name');
+      const parentId = optionalId(payload, 'parentId', 'parent', 'parentFolderId') ?? null;
+
+      // Nesting a folder requires write access to the destination.
+      if (parentId) requireFolder(store, user.id, parentId, 'editor');
+
+      const now = store.now();
+      const folder = {
+        id: store.id('fld'),
+        name,
+        parentId,
+        ownerId: user.id,
+        createdAt: now,
+        updatedAt: now,
+      };
+      store.folders.set(folder.id, folder);
+      store.log('folder.create', user.id, 'folder', folder.id, { name, parentId });
+
+      res.status(201).json(folderView(store, user.id, folder));
+    }),
+  );
+
+  router.get(
+    '/',
+    route((req, res) => {
+      const user = currentUser(req);
+      const parentFilter = optionalId(req.query as Record<string, unknown>, 'parentId');
+      const folders = [...store.folders.values()]
+        .filter((f) => canRead(store, user.id, 'folder', f.id))
+        .filter((f) => parentFilter === undefined || f.parentId === parentFilter)
+        .map((f) => folderView(store, user.id, f));
+      res.json(folders);
+    }),
+  );
+
+  router.get(
+    '/:id',
+    route((req, res) => {
+      const user = currentUser(req);
+      const folder = requireFolder(store, user.id, req.params.id, 'viewer');
+      res.json({
+        ...folderView(store, user.id, folder),
+        folders: store
+          .childFolders(folder.id)
+          .filter((f) => canRead(store, user.id, 'folder', f.id))
+          .map((f) => folderView(store, user.id, f)),
+        documents: store
+          .documentsInFolder(folder.id)
+          .filter((d) => canRead(store, user.id, 'document', d.id))
+          .map((d) => documentView(store, user.id, d)),
+      });
+    }),
+  );
+
+  router.get(
+    '/:id/children',
+    route((req, res) => {
+      const user = currentUser(req);
+      const folder = requireFolder(store, user.id, req.params.id, 'viewer');
+      res.json([
+        ...store
+          .childFolders(folder.id)
+          .filter((f) => canRead(store, user.id, 'folder', f.id))
+          .map((f) => folderView(store, user.id, f)),
+        ...store
+          .documentsInFolder(folder.id)
+          .filter((d) => canRead(store, user.id, 'document', d.id))
+          .map((d) => documentView(store, user.id, d)),
+      ]);
+    }),
+  );
+
+  router.get(
+    '/:id/documents',
+    route((req, res) => {
+      const user = currentUser(req);
+      const folder = requireFolder(store, user.id, req.params.id, 'viewer');
+      res.json(
+        store
+          .documentsInFolder(folder.id)
+          .filter((d) => canRead(store, user.id, 'document', d.id))
+          .map((d) => documentView(store, user.id, d)),
+      );
+    }),
+  );
+
+  router.post(
+    '/:id/documents',
+    route((req, res) => {
+      const user = currentUser(req);
+      const folder = requireFolder(store, user.id, req.params.id, 'editor');
+      const doc = createDocument(store, user, body(req), folder.id);
+      res.status(201).json(documentView(store, user.id, doc));
+    }),
+  );
+
+  const update = route((req, res) => {
+    const user = currentUser(req);
+    const folder = requireFolder(store, user.id, req.params.id, 'editor');
+    const payload = body(req);
+
+    if (payload.name !== undefined) folder.name = requiredString(payload, 'name');
+
+    const parentId = optionalId(payload, 'parentId', 'parent', 'parentFolderId');
+    if (parentId !== undefined && parentId !== folder.parentId) {
+      if (parentId !== null) {
+        if (parentId === folder.id || isDescendantOf(store, parentId, folder.id)) {
+          throw badRequest('A folder cannot be moved inside itself or one of its descendants');
+        }
+        requireFolder(store, user.id, parentId, 'editor');
+      }
+      folder.parentId = parentId;
+    }
+
+    folder.updatedAt = store.now();
+    store.log('folder.update', user.id, 'folder', folder.id, { name: folder.name });
+    res.json(folderView(store, user.id, folder));
+  });
+  router.put('/:id', update);
+  router.patch('/:id', update);
+
+  router.delete(
+    '/:id',
+    route((req, res) => {
+      const user = currentUser(req);
+      const folder = requireFolder(store, user.id, req.params.id, 'owner');
+
+      // Deleting a folder takes its whole subtree — folders, documents, shares.
+      for (const folderId of folderSubtree(store, folder.id).reverse()) {
+        for (const doc of store.documentsInFolder(folderId)) {
+          store.documents.delete(doc.id);
+          store.removeAllShares('document', doc.id);
+          store.log('document.delete', user.id, 'document', doc.id, {
+            cascadedFrom: folder.id,
+          });
+        }
+        store.folders.delete(folderId);
+        store.removeAllShares('folder', folderId);
+      }
+
+      store.log('folder.delete', user.id, 'folder', folder.id, { name: folder.name });
+      res.status(204).end();
+    }),
+  );
+
+  // ------------------------------------------------------------- sharing
+
+  const share = route((req, res) => {
+    const user = currentUser(req);
+    const payload = body(req);
+    if (!store.folders.has(req.params.id)) throw notFound('Folder not found');
+    const target = resolveTargetUser(store, payload);
+    const role = parseRole(payload.role ?? payload.permission ?? payload.accessLevel);
+    const created = shareResource(store, user, 'folder', req.params.id, target, role);
+    res.status(201).json({ ...created, username: target.username });
+  });
+  router.post('/:id/share', share);
+  router.post('/:id/shares', share);
+  router.post('/:id/permissions', share);
+
+  const shares = route((req, res) => {
+    const user = currentUser(req);
+    requireFolder(store, user.id, req.params.id, 'viewer');
+    res.json(listShares(store, 'folder', req.params.id));
+  });
+  router.get('/:id/shares', shares);
+  router.get('/:id/permissions', shares);
+
+  const unshare = route((req, res) => {
+    const user = currentUser(req);
+    revokeShare(store, user, 'folder', req.params.id, req.params.userId);
+    res.status(204).end();
+  });
+  router.delete('/:id/shares/:userId', unshare);
+  router.delete('/:id/share/:userId', unshare);
+  router.delete('/:id/permissions/:userId', unshare);
+
+  return router;
+}
