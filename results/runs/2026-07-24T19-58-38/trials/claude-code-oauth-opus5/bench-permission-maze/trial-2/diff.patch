@@ -0,0 +1,43 @@
+import { effectiveRole } from './permissions.js';
+import type { Store } from './store.js';
+import type { Document, Folder, Role } from './types.js';
+
+const permissions = (role: Role | null) => ({
+  canRead: role !== null,
+  canEdit: role === 'editor' || role === 'owner',
+  canShare: role === 'editor' || role === 'owner',
+  canDelete: role === 'owner',
+});
+
+export function folderView(store: Store, userId: string, folder: Folder) {
+  const role = effectiveRole(store, userId, 'folder', folder.id);
+  return {
+    id: folder.id,
+    name: folder.name,
+    parentId: folder.parentId,
+    ownerId: folder.ownerId,
+    createdAt: folder.createdAt,
+    updatedAt: folder.updatedAt,
+    type: 'folder' as const,
+    role,
+    permission: role,
+    permissions: permissions(role),
+  };
+}
+
+export function documentView(store: Store, userId: string, doc: Document) {
+  const role = effectiveRole(store, userId, 'document', doc.id);
+  return {
+    id: doc.id,
+    title: doc.title,
+    content: doc.content,
+    folderId: doc.folderId,
+    ownerId: doc.ownerId,
+    createdAt: doc.createdAt,
+    updatedAt: doc.updatedAt,
+    type: 'document' as const,
+    role,
+    permission: role,
+    permissions: permissions(role),
+  };
+}
