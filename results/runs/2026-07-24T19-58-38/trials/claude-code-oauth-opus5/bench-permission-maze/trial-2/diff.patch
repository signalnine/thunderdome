@@ -0,0 +1,93 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { createApp } from '../src/app.js';
+import { type Actor, type App, as, makeDoc, makeFolder, register } from './helpers.js';
+
+interface Entry {
+  action: string;
+  userId: string;
+  resourceId: string;
+  resourceType: string;
+  timestamp: string;
+}
+
+describe('activity log', () => {
+  let app: App;
+  let ana: Actor;
+  let bob: Actor;
+
+  beforeEach(async () => {
+    app = createApp();
+    ana = await register(app, 'ana');
+    bob = await register(app, 'bob');
+  });
+
+  it('records document creation, updates, deletion and shares', async () => {
+    const doc = await makeDoc(app, ana, 'doc');
+    await as(app, ana).put(`/documents/${doc}`).send({ content: 'v2' });
+    await as(app, ana).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'viewer' });
+    await as(app, ana).delete(`/documents/${doc}`);
+
+    const res = await as(app, ana).get('/activity');
+    expect(res.status).toBe(200);
+    const actions = (res.body as Entry[])
+      .filter((e) => e.resourceId === doc)
+      .map((e) => e.action);
+    expect(actions).toEqual([
+      'document.create',
+      'document.update',
+      'share.grant',
+      'document.delete',
+    ]);
+  });
+
+  it('stamps each entry with actor, target and timestamp', async () => {
+    const doc = await makeDoc(app, ana, 'doc');
+    const entry = ((await as(app, ana).get('/activity')).body as Entry[]).find(
+      (e) => e.resourceId === doc,
+    );
+
+    expect(entry).toMatchObject({
+      action: 'document.create',
+      userId: ana.id,
+      resourceType: 'document',
+      resourceId: doc,
+    });
+    expect(new Date(entry!.timestamp).toString()).not.toBe('Invalid Date');
+  });
+
+  it('hides activity about resources the caller cannot read', async () => {
+    const doc = await makeDoc(app, ana, 'private');
+    const visible = (await as(app, bob).get('/activity')).body as Entry[];
+    expect(visible.some((e) => e.resourceId === doc)).toBe(false);
+
+    await as(app, ana).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'viewer' });
+    const after = (await as(app, bob).get('/activity')).body as Entry[];
+    expect(after.some((e) => e.resourceId === doc && e.action === 'document.create')).toBe(true);
+  });
+
+  it('logs folder activity too', async () => {
+    const folder = await makeFolder(app, ana, 'root');
+    const entries = ((await as(app, ana).get('/activity')).body as Entry[]).filter(
+      (e) => e.resourceId === folder,
+    );
+    expect(entries.map((e) => e.action)).toContain('folder.create');
+  });
+
+  it('supports filtering', async () => {
+    const doc = await makeDoc(app, ana, 'doc');
+    await as(app, ana).put(`/documents/${doc}`).send({ content: 'v2' });
+
+    const filtered = (await as(app, ana).get('/activity?action=document.update'))
+      .body as Entry[];
+    expect(filtered).toHaveLength(1);
+    expect(filtered[0].action).toBe('document.update');
+
+    const perResource = (await as(app, ana).get(`/documents/${doc}/activity`)).body as Entry[];
+    expect(perResource.every((e) => e.resourceId === doc)).toBe(true);
+  });
+
+  it('requires authentication', async () => {
+    const res = await as(app, { ...ana, token: 'bogus' }).get('/activity');
+    expect(res.status).toBe(401);
+  });
+});
