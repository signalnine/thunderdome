+
+  it('blocks folder viewers from creating documents', async () => {
+    const folder = await makeFolder(app, ana, 'team');
+    await as(app, ana).post(`/folders/${folder}/share`).send({ userId: bob.id, role: 'viewer' });
+
+    expect((await as(app, bob).post(`/folders/${folder}/documents`).send({ title: 'x' })).status).toBe(
+      403,
+    );
+  });
+});
