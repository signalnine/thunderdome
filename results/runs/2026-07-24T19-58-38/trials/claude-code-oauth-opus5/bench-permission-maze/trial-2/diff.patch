@@ -0,0 +1,62 @@
+import express, { type Express, type NextFunction, type Request, type Response } from 'express';
+import { authenticate } from './auth.js';
+import { HttpError } from './errors.js';
+import { createActivityRouter } from './routes/activity.js';
+import { createAuthRouter } from './routes/auth.js';
+import { createDocumentRouter } from './routes/documents.js';
+import { createFolderRouter } from './routes/folders.js';
+import { createShareRouter } from './routes/shares.js';
+import { Store } from './store.js';
+
+export interface AppWithStore extends Express {
+  store: Store;
+}
+
+/** Builds an Express app backed by a brand-new in-memory store. */
+export function createApp(): AppWithStore {
+  const store = new Store();
+  const app = express() as AppWithStore;
+  app.store = store;
+
+  app.use(express.json({ limit: '5mb' }));
+
+  // Malformed JSON should read as a client error, not a 500.
+  app.use((err: unknown, _req: Request, res: Response, next: NextFunction) => {
+    if (err instanceof SyntaxError && 'body' in err) {
+      res.status(400).json({ error: 'Invalid JSON body' });
+      return;
+    }
+    next(err);
+  });
+
+  app.get('/health', (_req, res) => {
+    res.json({ status: 'ok' });
+  });
+
+  app.use(createAuthRouter(store));
+  app.use('/folders', authenticate(store), createFolderRouter(store));
+  app.use('/documents', authenticate(store), createDocumentRouter(store));
+  app.use(createShareRouter(store));
+  app.use(createActivityRouter(store));
+
+  app.use((req: Request, res: Response) => {
+    res.status(404).json({ error: `Cannot ${req.method} ${req.path}` });
+  });
+
+  app.use((err: unknown, _req: Request, res: Response, _next: NextFunction) => {
+    if (err instanceof HttpError) {
+      res.status(err.status).json({
+        error: err.message,
+        message: err.message,
+        ...(err.details ? { details: err.details } : {}),
+      });
+      return;
+    }
+    const message = err instanceof Error ? err.message : 'Internal server error';
+    res.status(500).json({ error: message, message });
+  });
+
+  return app;
+}
+
+export default createApp;
diff --git a/src/auth.ts b/src/auth.ts
new file mode 100644
index 0000000..c1f9308
--- /dev/null
+++ b/src/auth.ts
@@ -0,0 +1,51 @@
+import type { NextFunction, Request, Response } from 'express';
+import { unauthorized } from './errors.js';
+import type { Store } from './store.js';
+import type { User } from './types.js';
+
+declare global {
+  // eslint-disable-next-line @typescript-eslint/no-namespace
+  namespace Express {
+    interface Request {
+      user?: User;
+      token?: string;
+    }
+  }
+}
+
+function extractToken(req: Request): string | null {
+  const header = req.header('authorization');
+  if (header) {
+    const match = /^Bearer\s+(.+)$/i.exec(header.trim());
+    if (match) return match[1].trim();
+    // Tolerate a bare token in the Authorization header.
+    if (!header.includes(' ')) return header.trim();
+  }
+  const alt = req.header('x-auth-token');
+  return alt ? alt.trim() : null;
+}
+
+/** Rejects the request unless it carries a valid token. */
+export function authenticate(store: Store) {
+  return (req: Request, _res: Response, next: NextFunction): void => {
+    const token = extractToken(req);
+    if (!token) {
+      next(unauthorized('Missing authentication token'));
+      return;
+    }
+    const user = store.userForToken(token);
+    if (!user) {
+      next(unauthorized('Invalid or expired token'));
+      return;
+    }
+    req.user = user;
+    req.token = token;
+    next();
+  };
+}
+
+/** The authenticated user; only call from handlers mounted behind `authenticate`. */
+export function currentUser(req: Request): User {
+  if (!req.user) throw unauthorized();
+  return req.user;
+}
