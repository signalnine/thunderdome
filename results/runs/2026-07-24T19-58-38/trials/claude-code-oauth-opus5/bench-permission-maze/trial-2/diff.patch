@@ -0,0 +1,52 @@
+import request from 'supertest';
+import { createApp } from '../src/app.js';
+
+export type App = ReturnType<typeof createApp>;
+
+export interface Actor {
+  id: string;
+  username: string;
+  token: string;
+}
+
+let counter = 0;
+
+export async function register(app: App, username?: string): Promise<Actor> {
+  counter += 1;
+  const name = username ?? `user${counter}`;
+  const res = await request(app).post('/auth/register').send({ username: name, password: 'pw' });
+  if (res.status !== 201) throw new Error(`register failed: ${res.status} ${res.text}`);
+  return { id: res.body.id, username: name, token: res.body.token };
+}
+
+export const as = (app: App, actor: Actor) => ({
+  get: (url: string) => request(app).get(url).set('Authorization', `Bearer ${actor.token}`),
+  post: (url: string) => request(app).post(url).set('Authorization', `Bearer ${actor.token}`),
+  put: (url: string) => request(app).put(url).set('Authorization', `Bearer ${actor.token}`),
+  patch: (url: string) => request(app).patch(url).set('Authorization', `Bearer ${actor.token}`),
+  delete: (url: string) => request(app).delete(url).set('Authorization', `Bearer ${actor.token}`),
+});
+
+export async function makeFolder(
+  app: App,
+  actor: Actor,
+  name: string,
+  parentId?: string,
+): Promise<string> {
+  const res = await as(app, actor).post('/folders').send({ name, parentId });
+  if (res.status !== 201) throw new Error(`folder failed: ${res.status} ${res.text}`);
+  return res.body.id;
+}
+
+export async function makeDoc(
+  app: App,
+  actor: Actor,
+  title: string,
+  folderId?: string,
+): Promise<string> {
+  const res = await as(app, actor)
+    .post('/documents')
+    .send({ title, content: 'hello', folderId });
+  if (res.status !== 201) throw new Error(`document failed: ${res.status} ${res.text}`);
+  return res.body.id;
+}
diff --git a/tests/permissions.test.ts b/tests/permissions.test.ts
new file mode 100644
index 0000000..7c6c40f
--- /dev/null
+++ b/tests/permissions.test.ts
@@ -0,0 +1,212 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { createApp } from '../src/app.js';
+import { type Actor, type App, as, makeDoc, makeFolder, register } from './helpers.js';
+
+describe('sharing and effective permissions', () => {
+  let app: App;
+  let ana: Actor; // creator/owner
+  let bob: Actor; // collaborator
+  let eve: Actor; // outsider
+
+  beforeEach(async () => {
+    app = createApp();
+    ana = await register(app, 'ana');
+    bob = await register(app, 'bob');
+    eve = await register(app, 'eve');
+  });
+
+  it('denies access to users with no grant', async () => {
+    const doc = await makeDoc(app, ana, 'secret');
+    expect((await as(app, eve).get(`/documents/${doc}`)).status).toBe(403);
+    expect((await as(app, eve).put(`/documents/${doc}`).send({ content: 'x' })).status).toBe(403);
+    expect((await as(app, eve).delete(`/documents/${doc}`)).status).toBe(403);
+  });
+
+  it('gives a viewer read-only access', async () => {
+    const doc = await makeDoc(app, ana, 'secret');
+    const share = await as(app, ana)
+      .post(`/documents/${doc}/share`)
+      .send({ userId: bob.id, role: 'viewer' });
+    expect(share.status).toBe(201);
+
+    expect((await as(app, bob).get(`/documents/${doc}`)).status).toBe(200);
+    expect((await as(app, bob).put(`/documents/${doc}`).send({ content: 'x' })).status).toBe(403);
+    expect((await as(app, bob).delete(`/documents/${doc}`)).status).toBe(403);
+    // A viewer may not re-share.
+    expect(
+      (await as(app, bob).post(`/documents/${doc}/share`).send({ userId: eve.id, role: 'viewer' }))
+        .status,
+    ).toBe(403);
+  });
+
+  it('lets an editor read, modify and share but not delete', async () => {
+    const doc = await makeDoc(app, ana, 'secret');
+    await as(app, ana).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'editor' });
+
+    expect((await as(app, bob).get(`/documents/${doc}`)).status).toBe(200);
+    expect((await as(app, bob).put(`/documents/${doc}`).send({ content: 'edited' })).status).toBe(
+      200,
+    );
+    expect((await as(app, bob).delete(`/documents/${doc}`)).status).toBe(403);
+
+    const reshare = await as(app, bob)
+      .post(`/documents/${doc}/share`)
+      .send({ username: 'eve', role: 'viewer' });
+    expect(reshare.status).toBe(201);
+    expect((await as(app, eve).get(`/documents/${doc}`)).status).toBe(200);
+
+    // ...but an editor cannot hand out ownership.
+    const escalate = await as(app, bob)
+      .post(`/documents/${doc}/share`)
+      .send({ userId: eve.id, role: 'owner' });
+    expect(escalate.status).toBe(403);
+  });
+
+  it('gives a shared owner full control', async () => {
+    const doc = await makeDoc(app, ana, 'secret');
+    await as(app, ana).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'owner' });
+
+    expect((await as(app, bob).put(`/documents/${doc}`).send({ title: 'renamed' })).status).toBe(
+      200,
+    );
+    expect((await as(app, bob).delete(`/documents/${doc}`)).status).toBe(204);
+  });
+
+  it('inherits folder permissions down the tree', async () => {
+    const root = await makeFolder(app, ana, 'root');
+    const child = await makeFolder(app, ana, 'child', root);
+    const deep = await makeFolder(app, ana, 'deep', child);
+    const doc = await makeDoc(app, ana, 'buried', deep);
+
+    expect((await as(app, bob).get(`/documents/${doc}`)).status).toBe(403);
+
+    await as(app, ana).post(`/folders/${root}/share`).send({ userId: bob.id, role: 'viewer' });
+
+    expect((await as(app, bob).get(`/documents/${doc}`)).status).toBe(200);
+    expect((await as(app, bob).get(`/folders/${deep}`)).status).toBe(200);
+    expect((await as(app, bob).put(`/documents/${doc}`).send({ content: 'x' })).status).toBe(403);
+  });
+
+  it('resolves multiple grants to the most permissive role', async () => {
+    const folder = await makeFolder(app, ana, 'shared');
+    const doc = await makeDoc(app, ana, 'doc', folder);
+
+    await as(app, ana).post(`/folders/${folder}/share`).send({ userId: bob.id, role: 'viewer' });
+    await as(app, ana).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'editor' });
+
+    const view = await as(app, bob).get(`/documents/${doc}`);
+    expect(view.body.role).toBe('editor');
+    expect((await as(app, bob).put(`/documents/${doc}`).send({ content: 'ok' })).status).toBe(200);
+  });
+
+  it('does not downgrade a direct grant when a weaker folder grant exists', async () => {
+    const folder = await makeFolder(app, ana, 'shared');
+    const doc = await makeDoc(app, ana, 'doc', folder);
+
+    // Direct editor first, weaker folder-level viewer second.
+    await as(app, ana).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'editor' });
+    await as(app, ana).post(`/folders/${folder}/share`).send({ userId: bob.id, role: 'viewer' });
+
+    expect((await as(app, bob).get(`/documents/${doc}`)).body.role).toBe('editor');
+  });
+
+  it('takes the strongest role across nested folder grants', async () => {
+    const root = await makeFolder(app, ana, 'root');
+    const child = await makeFolder(app, ana, 'child', root);
+    const doc = await makeDoc(app, ana, 'doc', child);
+
+    await as(app, ana).post(`/folders/${root}/share`).send({ userId: bob.id, role: 'editor' });
+    await as(app, ana).post(`/folders/${child}/share`).send({ userId: bob.id, role: 'viewer' });
+
+    expect((await as(app, bob).get(`/documents/${doc}`)).body.role).toBe('editor');
+    expect((await as(app, bob).put(`/documents/${doc}`).send({ content: 'x' })).status).toBe(200);
+  });
+
+  it('supports the generic /share endpoint', async () => {
+    const doc = await makeDoc(app, ana, 'doc');
+    const res = await as(app, ana)
+      .post('/share')
+      .send({ resourceType: 'document', resourceId: doc, userId: bob.id, role: 'viewer' });
+    expect(res.status).toBe(201);
+    expect((await as(app, bob).get(`/documents/${doc}`)).status).toBe(200);
+  });
+
+  it('revokes access', async () => {
+    const doc = await makeDoc(app, ana, 'doc');
+    await as(app, ana).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'editor' });
+    expect((await as(app, bob).get(`/documents/${doc}`)).status).toBe(200);
+
+    expect((await as(app, ana).delete(`/documents/${doc}/shares/${bob.id}`)).status).toBe(204);
+    expect((await as(app, bob).get(`/documents/${doc}`)).status).toBe(403);
+  });
+
+  it('does not let an editor revoke another user', async () => {
+    const doc = await makeDoc(app, ana, 'doc');
+    await as(app, ana).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'editor' });
+    await as(app, ana).post(`/documents/${doc}/share`).send({ userId: eve.id, role: 'viewer' });
+
+    expect((await as(app, bob).delete(`/documents/${doc}/shares/${eve.id}`)).status).toBe(403);
+  });
+
+  it('validates share payloads', async () => {
+    const doc = await makeDoc(app, ana, 'doc');
+    expect(
+      (await as(app, ana).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'king' }))
+        .status,
+    ).toBe(400);
+    expect((await as(app, ana).post(`/documents/${doc}/share`).send({ role: 'viewer' })).status).toBe(
+      400,
+    );
+    expect(
+      (await as(app, ana).post(`/documents/${doc}/share`).send({ userId: 'ghost', role: 'viewer' }))
+        .status,
+    ).toBe(404);
+    expect(
+      (await as(app, ana).post('/documents/ghost/share').send({ userId: bob.id, role: 'viewer' }))
+        .status,
+    ).toBe(404);
+  });
+
+  it('lists the shares on a resource', async () => {
+    const doc = await makeDoc(app, ana, 'doc');
+    await as(app, ana).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'editor' });
+
+    const res = await as(app, ana).get(`/documents/${doc}/shares`);
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({ userId: ana.id, role: 'owner' }),
+        expect.objectContaining({ userId: bob.id, role: 'editor' }),
+      ]),
+    );
+  });
+
+  it('requires write access on the destination when moving a document', async () => {
+    const anaFolder = await makeFolder(app, ana, 'ana');
+    const bobFolder = await makeFolder(app, bob, 'bob');
+    const doc = await makeDoc(app, ana, 'doc', anaFolder);
+
+    const res = await as(app, ana).patch(`/documents/${doc}`).send({ folderId: bobFolder });
+    expect(res.status).toBe(403);
+  });
+
+  it('grants folder editors the right to create documents there', async () => {
+    const folder = await makeFolder(app, ana, 'team');
+    await as(app, ana).post(`/folders/${folder}/share`).send({ userId: bob.id, role: 'editor' });
+
