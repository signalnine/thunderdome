new file mode 100644
index 0000000..7287c22
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,157 @@
+import { randomBytes, scryptSync, timingSafeEqual } from 'node:crypto';
+import type {
+  ActivityEntry,
+  Document,
+  Folder,
+  PublicUser,
+  ResourceType,
+  Role,
+  Share,
+  User,
+} from './types.js';
+
+const shareKey = (type: ResourceType, resourceId: string, userId: string): string =>
+  `${type}:${resourceId}:${userId}`;
+
+/**
+ * All application state lives here. A fresh Store is created per `createApp()`
+ * call so tests (and server restarts) start from a clean slate.
+ */
+export class Store {
+  readonly users = new Map<string, User>();
+  readonly folders = new Map<string, Folder>();
+  readonly documents = new Map<string, Document>();
+  readonly shares = new Map<string, Share>();
+  readonly activity: ActivityEntry[] = [];
+
+  private readonly usersByUsername = new Map<string, string>();
+  private readonly tokens = new Map<string, string>();
+  private readonly sharesByKey = new Map<string, Share>();
+  private counter = 0;
+
+  id(prefix: string): string {
+    this.counter += 1;
+    return `${prefix}_${this.counter.toString(36)}${randomBytes(6).toString('hex')}`;
+  }
+
+  now(): string {
+    return new Date().toISOString();
+  }
+
+  // ---------------------------------------------------------------- users
+
+  createUser(username: string, password: string): User {
+    const salt = randomBytes(16).toString('hex');
+    const hash = scryptSync(password, salt, 64).toString('hex');
+    const user: User = {
+      id: this.id('usr'),
+      username,
+      passwordHash: `${salt}:${hash}`,
+      createdAt: this.now(),
+    };
+    this.users.set(user.id, user);
+    this.usersByUsername.set(username.toLowerCase(), user.id);
+    return user;
+  }
+
+  findUserByUsername(username: string): User | undefined {
+    const id = this.usersByUsername.get(username.toLowerCase());
+    return id ? this.users.get(id) : undefined;
+  }
+
+  verifyPassword(user: User, password: string): boolean {
+    const [salt, hash] = user.passwordHash.split(':');
+    if (!salt || !hash) return false;
+    const candidate = scryptSync(password, salt, 64);
+    const expected = Buffer.from(hash, 'hex');
+    return candidate.length === expected.length && timingSafeEqual(candidate, expected);
+  }
+
+  issueToken(userId: string): string {
+    const token = randomBytes(24).toString('hex');
+    this.tokens.set(token, userId);
+    return token;
+  }
+
+  userForToken(token: string): User | undefined {
+    const userId = this.tokens.get(token);
+    return userId ? this.users.get(userId) : undefined;
+  }
+
+  revokeToken(token: string): void {
+    this.tokens.delete(token);
+  }
+
+  // --------------------------------------------------------------- shares
+
+  getShare(type: ResourceType, resourceId: string, userId: string): Share | undefined {
+    return this.sharesByKey.get(shareKey(type, resourceId, userId));
+  }
+
+  setShare(share: Share): void {
+    const existing = this.getShare(share.resourceType, share.resourceId, share.userId);
+    if (existing) this.shares.delete(existing.id);
+    this.shares.set(share.id, share);
+    this.sharesByKey.set(shareKey(share.resourceType, share.resourceId, share.userId), share);
+  }
+
+  removeShare(type: ResourceType, resourceId: string, userId: string): Share | undefined {
+    const existing = this.getShare(type, resourceId, userId);
+    if (!existing) return undefined;
+    this.shares.delete(existing.id);
+    this.sharesByKey.delete(shareKey(type, resourceId, userId));
+    return existing;
+  }
+
+  sharesFor(type: ResourceType, resourceId: string): Share[] {
+    return [...this.shares.values()].filter(
+      (s) => s.resourceType === type && s.resourceId === resourceId,
+    );
+  }
+
+  removeAllShares(type: ResourceType, resourceId: string): void {
+    for (const share of this.sharesFor(type, resourceId)) {
+      this.removeShare(type, resourceId, share.userId);
+    }
+  }
+
+  // -------------------------------------------------------------- queries
+
+  childFolders(parentId: string | null): Folder[] {
+    return [...this.folders.values()].filter((f) => f.parentId === parentId);
+  }
+
+  documentsInFolder(folderId: string | null): Document[] {
+    return [...this.documents.values()].filter((d) => d.folderId === folderId);
+  }
+
+  // ------------------------------------------------------------- activity
+
+  log(
+    action: string,
+    userId: string,
+    resourceType: ActivityEntry['resourceType'],
+    resourceId: string,
+    details?: Record<string, unknown>,
+  ): ActivityEntry {
+    const entry: ActivityEntry = {
+      id: this.id('act'),
+      action,
+      userId,
+      resourceType,
+      resourceId,
+      timestamp: this.now(),
+      ...(details ? { details } : {}),
+    };
+    this.activity.push(entry);
+    return entry;
+  }
+}
+
+export const publicUser = (user: User): PublicUser => ({
+  id: user.id,
+  username: user.username,
+  createdAt: user.createdAt,
+});
+
+export const ROLES: Role[] = ['viewer', 'editor', 'owner'];
diff --git a/src/types.ts b/src/types.ts
