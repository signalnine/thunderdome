oute((req, res) => {\n      const user = currentUser(req);\n      const doc = requireDocument(store, user.id, req.params.id, 'owner');\n      store.documents.delete(doc.id);\n      store.removeAllShares('document', doc.id);\n      store.log('document.delete', user.id, 'document', doc.id, { title: doc.title });\n      res.status(204).end();\n    }),\n  );\n\n  // ------------------------------------------------------------- sharing\n\n  const share = route((req, res) => {\n    const user = currentUser(req);\n    const payload = body(req);\n    if (!store.documents.has(req.params.id)) throw notFound('Document not found');\n    const target = resolveTargetUser(store, payload);\n    const role = parseRole(payload.role ?? payload.permission ?? payload.accessLevel);\n    const created = shareResource(store, user, 'document', req.params.id, target, role);\n    res.status(201).json({ ...created, username: target.username });\n  });\n  router.post('/:id/share', share);\n  router.post('/:id/shares', share);\n  router.post('/:id/permissions', share);\n\n  const shares = route((req, res) => {\n    const user = currentUser(req);\n    requireDocument(store, user.id, req.params.id, 'viewer');\n    res.json(listShares(store, 'document', req.params.id));\n  });\n  router.get('/:id/shares', shares);\n  router.get('/:id/permissions', shares);\n\n  const unshare = route((req, res) => {\n    const user = currentUser(req);\n    revokeShare(store, user, 'document', req.params.id, req.params.userId);\n    res.status(204).end();\n  });\n  router.delete('/:id/shares/:userId', unshare);\n  router.delete('/:id/share/:userId', unshare);\n  router.delete('/:id/permissions/:userId', unshare);\n\n  return router;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
