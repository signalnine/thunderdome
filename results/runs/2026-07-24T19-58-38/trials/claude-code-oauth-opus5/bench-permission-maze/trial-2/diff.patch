diff --git a/src/permissions.ts b/src/permissions.ts
new file mode 100644
index 0000000..0f82612
--- /dev/null
+++ b/src/permissions.ts
@@ -0,0 +1,119 @@
+import { forbidden, notFound } from './errors.js';
+import type { Store } from './store.js';
+import type { Document, Folder, ResourceType, Role } from './types.js';
+
+export const ROLE_RANK: Record<Role, number> = { viewer: 1, editor: 2, owner: 3 };
+
+export const isRole = (value: unknown): value is Role =>
+  value === 'viewer' || value === 'editor' || value === 'owner';
+
+/** Returns the more permissive of two (possibly absent) roles. */
+export const maxRole = (a: Role | null, b: Role | null): Role | null => {
+  if (!a) return b;
+  if (!b) return a;
+  return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;
+};
+
+export const atLeast = (role: Role | null, required: Role): boolean =>
+  role !== null && ROLE_RANK[role] >= ROLE_RANK[required];
+
+/**
+ * Effective role on a folder: the most permissive of the user's ownership, any
+ * direct share, and anything inherited from every ancestor folder. The `seen`
+ * set makes a corrupted parent chain terminate instead of looping forever.
+ */
+export function folderRole(store: Store, userId: string, folderId: string): Role | null {
+  let role: Role | null = null;
+  const seen = new Set<string>();
+  let current: Folder | undefined = store.folders.get(folderId);
+
+  while (current && !seen.has(current.id)) {
+    seen.add(current.id);
+    if (current.ownerId === userId) role = maxRole(role, 'owner');
+    const share = store.getShare('folder', current.id, userId);
+    if (share) role = maxRole(role, share.role);
+    current = current.parentId ? store.folders.get(current.parentId) : undefined;
+  }
+  return role;
+}
+
+/**
+ * Effective role on a document: ownership, direct shares, and whatever the
+ * containing folder tree grants.
+ */
+export function documentRole(store: Store, userId: string, documentId: string): Role | null {
+  const doc = store.documents.get(documentId);
+  if (!doc) return null;
+
+  let role: Role | null = doc.ownerId === userId ? 'owner' : null;
+  const share = store.getShare('document', doc.id, userId);
+  if (share) role = maxRole(role, share.role);
+  if (doc.folderId) role = maxRole(role, folderRole(store, userId, doc.folderId));
+  return role;
+}
+
+export function effectiveRole(
+  store: Store,
+  userId: string,
+  type: ResourceType,
+  resourceId: string,
+): Role | null {
+  return type === 'folder'
+    ? folderRole(store, userId, resourceId)
+    : documentRole(store, userId, resourceId);
+}
+
+export function canRead(store: Store, userId: string, type: ResourceType, id: string): boolean {
+  return atLeast(effectiveRole(store, userId, type, id), 'viewer');
+}
+
+/**
+ * Loads a resource and asserts the caller holds at least `required` on it.
+ * Missing resources are 404; existing-but-inaccessible ones are 403.
+ */
+export function requireFolder(store: Store, userId: string, id: string, required: Role): Folder {
+  const folder = store.folders.get(id);
+  if (!folder) throw notFound(`Folder ${id} not found`);
+  const role = folderRole(store, userId, id);
+  if (!atLeast(role, required)) {
+    throw forbidden(`Requires '${required}' access to folder ${id}`);
+  }
+  return folder;
+}
+
+export function requireDocument(store: Store, userId: string, id: string, required: Role): Document {
+  const doc = store.documents.get(id);
+  if (!doc) throw notFound(`Document ${id} not found`);
+  const role = documentRole(store, userId, id);
+  if (!atLeast(role, required)) {
+    throw forbidden(`Requires '${required}' access to document ${id}`);
+  }
+  return doc;
+}
+
+/** True when `folderId` is `candidateAncestor` or lives underneath it. */
+export function isDescendantOf(store: Store, folderId: string, candidateAncestor: string): boolean {
+  const seen = new Set<string>();
+  let current: Folder | undefined = store.folders.get(folderId);
+  while (current && !seen.has(current.id)) {
+    if (current.id === candidateAncestor) return true;
+    seen.add(current.id);
+    current = current.parentId ? store.folders.get(current.parentId) : undefined;
+  }
+  return false;
+}
+
+/** Every folder id at or beneath `folderId`, deepest last. */
+export function folderSubtree(store: Store, folderId: string): string[] {
+  const result: string[] = [];
+  const queue = [folderId];
+  const seen = new Set<string>();
+  while (queue.length > 0) {
+    const id = queue.shift() as string;
+    if (seen.has(id)) continue;
+    seen.add(id);
+    result.push(id);
+    for (const child of store.childFolders(id)) queue.push(child.id);
+  }
+  return result;
+}
diff --git a/src/routes/activity.ts b/src/routes/activity.ts
new file mode 100644
index 0000000..bdbf060
--- /dev/null
+++ b/src/routes/activity.ts
@@ -0,0 +1,93 @@
+import { Router } from 'express';
+import { authenticate, currentUser } from '../auth.js';
+import { canRead, requireDocument, requireFolder } from '../permissions.js';
+import type { Store } from '../store.js';
+import type { ActivityEntry, ResourceType, User } from '../types.js';
+import { route } from './helpers.js';
+
+/**
+ * A user sees an activity entry when they performed it, or when they can still
+ * read the resource it refers to. Entries about deleted resources stay visible
+ * only to their actor.
+ */
+function visible(store: Store, user: User, entry: ActivityEntry): boolean {
+  if (entry.userId === user.id) return true;
+  if (entry.resourceType === 'user') return entry.resourceId === user.id;
+  return canRead(store, user.id, entry.resourceType, entry.resourceId);
+}
+
+function decorate(store: Store, entry: ActivityEntry) {
+  const actor = store.users.get(entry.userId);
+  return {
+    ...entry,
+    // Aliases so clients can read the actor/target under familiar names.
+    type: entry.action,
+    actorId: entry.userId,
+    username: actor?.username,
+    targetType: entry.resourceType,
+    targetId: entry.resourceId,
+  };
+}
+
+function applyFilters(entries: ActivityEntry[], query: Record<string, unknown>): ActivityEntry[] {
+  let result = entries;
+  const str = (key: string): string | undefined =>
+    typeof query[key] === 'string' ? (query[key] as string) : undefined;
+
+  const action = str('action') ?? str('type');
+  if (action) result = result.filter((e) => e.action === action);
+
+  const resourceType = str('resourceType') ?? str('targetType');
+  if (resourceType) {
+    const normalized = resourceType.toLowerCase().replace(/s$/, '');
+    result = result.filter((e) => e.resourceType === normalized);
+  }
+
+  const resourceId = str('resourceId') ?? str('targetId');
+  if (resourceId) result = result.filter((e) => e.resourceId === resourceId);
+
+  const userId = str('userId') ?? str('actorId');
+  if (userId) result = result.filter((e) => e.userId === userId);
+
+  if ((str('order') ?? '').toLowerCase() === 'desc') result = [...result].reverse();
+
+  const limit = Number(str('limit'));
+  if (Number.isFinite(limit) && limit > 0) result = result.slice(0, limit);
+
+  return result;
+}
+
+export function createActivityRouter(store: Store): Router {
+  const router = Router();
+  const auth = authenticate(store);
+
+  const list = route((req, res) => {
+    const user = currentUser(req);
+    const entries = store.activity.filter((entry) => visible(store, user, entry));
+    res.json(
+      applyFilters(entries, req.query as Record<string, unknown>).map((e) => decorate(store, e)),
+    );
+  });
+  router.get('/activity', auth, list);
+  router.get('/activities', auth, list);
+  router.get('/logs', auth, list);
+
+  const forResource = (type: ResourceType) =>
+    route((req, res) => {
+      const user = currentUser(req);
+      if (type === 'folder') requireFolder(store, user.id, req.params.id, 'viewer');
+      else requireDocument(store, user.id, req.params.id, 'viewer');
+
+      const entries = store.activity.filter(
+        (e) => e.resourceType === type && e.resourceId === req.params.id,
+      );
+      res.json(
+        applyFilters(entries, req.query as Record<string, unknown>).map((e) => decorate(store, e)),
+      );
+    });
+
+  router.get('/documents/:id/activity', auth, forResource('document'));
+  router.get('/folders/:id/activity', auth, forResource('folder'));
+
+  return router;
+}
diff --git a/src/routes/auth.ts b/src/routes/auth.ts
new file mode 100644
index 0000000..c2e7825
--- /dev/null
+++ b/src/routes/auth.ts
@@ -0,0 +1,84 @@
+import { Router } from 'express';
+import { authenticate, currentUser } from '../auth.js';
+import { conflict, unauthorized } from '../errors.js';
+import { publicUser, type Store } from '../store.js';
+import { body, requiredString, route } from './helpers.js';
+
+export function createAuthRouter(store: Store): Router {
+  const router = Router();
+
+  const register = route((req, res) => {
+    const payload = body(req);
+    const username = requiredString(payload, 'username');
+    const password = requiredString(payload, 'password');
+
+    if (store.findUserByUsername(username)) {
+      throw conflict(`Username '${username}' is already taken`);
+    }
+
+    const user = store.createUser(username, password);
+    const token = store.issueToken(user.id);
+    store.log('user.register', user.id, 'user', user.id, { username });
+
+    res.status(201).json({ ...publicUser(user), token, user: publicUser(user) });
+  });
+
+  const login = route((req, res) => {
+    const payload = body(req);
+    const username = requiredString(payload, 'username');
+    const password = requiredString(payload, 'password');
+
+    const user = store.findUserByUsername(username);
+    if (!user || !store.verifyPassword(user, password)) {
+      throw unauthorized('Invalid username or password');
+    }
+
+    const token = store.issueToken(user.id);
+    res.status(200).json({ ...publicUser(user), token, user: publicUser(user) });
+  });
+
+  for (const path of ['/auth/register', '/register', '/users', '/signup']) {
+    router.post(path, register);
+  }
+  for (const path of ['/auth/login', '/login', '/sessions']) {
+    router.post(path, login);
+  }
+
+  router.post(
+    '/auth/logout',
+    authenticate(store),
+    route((req, res) => {
+      if (req.token) store.revokeToken(req.token);
+      res.status(204).end();
+    }),
+  );
+
+  const me = route((req, res) => {
+    res.json(publicUser(currentUser(req)));
+  });
+  router.get('/auth/me', authenticate(store), me);
+  router.get('/me', authenticate(store), me);
+
+  router.get(
+    '/users',
+    authenticate(store),
+    route((_req, res) => {
+      res.json([...store.users.values()].map(publicUser));
+    }),
+  );
+
+  router.get(
+    '/users/:id',
+    authenticate(store),
+    route((req, res) => {
+      const user = store.users.get(req.params.id);
+      if (!user) {
+        res.status(404).json({ error: 'User not found' });
+        return;
+      }
+      res.json(publicUser(user));
+    }),
+  );
+
+  return router;
+}
diff --git a/src/routes/documents.ts b/src/routes/documents.ts
new file mode 100644
index 0000000..69639c3
--- /dev/null
+++ b/src/routes/documents.ts
@@ -0,0 +1,151 @@
+import { Router } from 'express';
+import { currentUser } from '../auth.js';
+import { notFound } from '../errors.js';
+import { canRead, requireDocument, requireFolder } from '../permissions.js';
+import type { Store } from '../store.js';
+import {
+  listShares,
+  parseRole,
+  resolveTargetUser,
+  revokeShare,
+  shareResource,
+} from '../sharing.js';
+import type { Document, User } from '../types.js';
+import { documentView } from '../views.js';
+import { body, optionalId, optionalString, requiredString, route } from './helpers.js';
+
+/**
+ * Creates a document. `folderId` is optional; when present the caller must be
+ * able to write to that folder.
+ */
+export function createDocument(
+  store: Store,
+  user: User,
+  payload: Record<string, unknown>,
+  folderIdOverride?: string,
+): Document {
+  const title = requiredString(payload, 'title');
+  const content = optionalString(payload, 'content') ?? '';
+  const folderId =
+    folderIdOverride ?? optionalId(payload, 'folderId', 'folder', 'parentId') ?? null;
+
+  if (folderId) requireFolder(store, user.id, folderId, 'editor');
+
+  const now = store.now();
+  const doc: Document = {
+    id: store.id('doc'),
+    title,
+    content,
+    folderId,
+    ownerId: user.id,
+    createdAt: now,
+    updatedAt: now,
+  };
+  store.documents.set(doc.id, doc);
+  store.log('document.create', user.id, 'document', doc.id, { title, folderId });
+  return doc;
+}
+
+export function createDocumentRouter(store: Store): Router {
+  const router = Router();
+
+  router.post(
+    '/',
+    route((req, res) => {
+      const user = currentUser(req);
+      const doc = createDocument(store, user, body(req));
+      res.status(201).json(documentView(store, user.id, doc));
+    }),
+  );
+
+  router.get(
+    '/',
+    route((req, res) => {
+      const user = currentUser(req);
+      const folderFilter = optionalId(req.query as Record<string, unknown>, 'folderId');
+      const docs = [...store.documents.values()]
+        .filter((d) => canRead(store, user.id, 'document', d.id))
+        .filter((d) => folderFilter === undefined || d.folderId === folderFilter)
+        .map((d) => documentView(store, user.id, d));
+      res.json(docs);
+    }),
+  );
+
+  router.get(
+    '/:id',
+    route((req, res) => {
+      const user = currentUser(req);
+      const doc = requireDocument(store, user.id, req.params.id, 'viewer');
+      res.json(documentView(store, user.id, doc));
+    }),
+  );
+
+  const update = route((req, res) => {
+    const user = currentUser(req);
+    const doc = requireDocument(store, user.id, req.params.id, 'editor');
+    const payload = body(req);
+
+    if (payload.title !== undefined) doc.title = requiredString(payload, 'title');
+    const content = optionalString(payload, 'content');
+    if (content !== undefined) doc.content = content;
+
+    const folderId = optionalId(payload, 'folderId', 'folder');
+    if (folderId !== undefined && folderId !== doc.folderId) {
+      // Moving a document requires write access to the destination folder too.
+      if (folderId !== null) requireFolder(store, user.id, folderId, 'editor');
+      doc.folderId = folderId;
+    }
+
+    doc.updatedAt = store.now();
+    store.log('document.update', user.id, 'document', doc.id, { title: doc.title });
+    res.json(documentView(store, user.id, doc));
+  });
+  router.put('/:id', update);
+  router.patch('/:id', update);
+
+  router.delete(
+    '/:id',
+    route((req, res) => {
+      const user = currentUser(req);
+      const doc = requireDocument(store, user.id, req.params.id, 'owner');
+      store.documents.delete(doc.id);
+      store.removeAllShares('document', doc.id);
+      store.log('document.delete', user.id, 'document', doc.id, { title: doc.title });
+      res.status(204).end();
+    }),
+  );
+
+  // ------------------------------------------------------------- sharing
+
+  const share = route((req, res) => {
+    const user = currentUser(req);
+    const payload = body(req);
+    if (!store.documents.has(req.params.id)) throw notFound('Document not found');
+    const target = resolveTargetUser(store, payload);
+    const role = parseRole(payload.role ?? payload.permission ?? payload.accessLevel);
+    const created = shareResource(store, user, 'document', req.params.id, target, role);
+    res.status(201).json({ ...created, username: target.username });
+  });
+  router.post('/:id/share', share);
+  router.post('/:id/shares', share);
+  router.post('/:id/permissions', share);
+
+  const shares = route((req, res) => {
+    const user = currentUser(req);
+    requireDocument(store, user.id, req.params.id, 'viewer');
+    res.json(listShares(store, 'document', req.params.id));
+  });
+  router.get('/:id/shares', shares);
+  router.get('/:id/permissions', shares);
+
+  const unshare = route((req, res) => {
+    const user = currentUser(req);
+    revokeShare(store, user, 'document', req.params.id, req.params.userId);
+    res.status(204).end();
+  });
+  router.delete('/:id/shares/:userId', unshare);
+  router.delete('/:id/share/:userId', unshare);
+  router.delete('/:id/permissions/:userId', unshare);
+
+  return router;
+}
