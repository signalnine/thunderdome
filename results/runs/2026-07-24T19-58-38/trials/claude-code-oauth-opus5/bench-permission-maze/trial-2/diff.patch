+import { beforeEach, describe, expect, it } from 'vitest';
+import request from 'supertest';
+import { createApp } from '../src/app.js';
+import { type App, as, register } from './helpers.js';
+
+describe('authentication', () => {
+  let app: App;
+  beforeEach(() => {
+    app = createApp();
+  });
+
+  it('registers a user and returns a token', async () => {
+    const res = await request(app).post('/auth/register').send({ username: 'ana', password: 'pw' });
+    expect(res.status).toBe(201);
+    expect(res.body.username).toBe('ana');
+    expect(res.body.token).toEqual(expect.any(String));
+    expect(res.body).not.toHaveProperty('passwordHash');
+  });
+
+  it('rejects registration without credentials', async () => {
+    expect((await request(app).post('/auth/register').send({ username: 'x' })).status).toBe(400);
+    expect((await request(app).post('/auth/register').send({})).status).toBe(400);
+  });
+
+  it('rejects a duplicate username', async () => {
+    await request(app).post('/auth/register').send({ username: 'ana', password: 'pw' });
+    const res = await request(app).post('/auth/register').send({ username: 'ana', password: 'pw2' });
+    expect(res.status).toBe(409);
+  });
+
+  it('logs in with valid credentials and rejects bad ones', async () => {
+    await request(app).post('/auth/register').send({ username: 'ana', password: 'pw' });
+
+    const ok = await request(app).post('/auth/login').send({ username: 'ana', password: 'pw' });
+    expect(ok.status).toBe(200);
+    expect(ok.body.token).toEqual(expect.any(String));
+
+    const bad = await request(app).post('/auth/login').send({ username: 'ana', password: 'nope' });
+    expect(bad.status).toBe(401);
+
+    const missing = await request(app).post('/auth/login').send({ username: 'zz', password: 'pw' });
+    expect(missing.status).toBe(401);
+  });
+
+  it('requires a valid token for protected routes', async () => {
+    expect((await request(app).get('/documents')).status).toBe(401);
+    expect((await request(app).get('/folders').set('Authorization', 'Bearer nope')).status).toBe(
+      401,
+    );
+    expect((await request(app).post('/folders').send({ name: 'x' })).status).toBe(401);
+  });
+
+  it('accepts the token issued by login', async () => {
+    const ana = await register(app, 'ana');
+    const login = await request(app).post('/auth/login').send({ username: 'ana', password: 'pw' });
+    const res = await request(app)
+      .get('/auth/me')
+      .set('Authorization', `Bearer ${login.body.token}`);
+    expect(res.status).toBe(200);
+    expect(res.body.id).toBe(ana.id);
+  });
+
+  it('returns 404 for unknown routes', async () => {
+    const ana = await register(app);
+    expect((await as(app, ana).get('/not-a-route')).status).toBe(404);
+  });
+});
