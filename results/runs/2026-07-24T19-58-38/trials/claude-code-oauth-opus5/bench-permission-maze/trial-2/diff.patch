+++ b/src/routes/shares.ts
@@ -0,0 +1,86 @@
+import { Router } from 'express';
+import { authenticate, currentUser } from '../auth.js';
+import { badRequest, notFound } from '../errors.js';
+import { canRead } from '../permissions.js';
+import type { Store } from '../store.js';
+import {
+  listShares,
+  parseResourceType,
+  parseRole,
+  resolveTargetUser,
+  resourceExists,
+  revokeShare,
+  shareResource,
+} from '../sharing.js';
+import { body, route } from './helpers.js';
+
+/** Generic `POST /share` style endpoints that name the resource in the payload. */
+export function createShareRouter(store: Store): Router {
+  const router = Router();
+  const auth = authenticate(store);
+
+  const share = route((req, res) => {
+    const user = currentUser(req);
+    const payload = body(req);
+    const type = parseResourceType(payload.resourceType ?? payload.type ?? payload.targetType);
+    const resourceId = payload.resourceId ?? payload.targetId ?? payload.id;
+    if (typeof resourceId !== 'string' || resourceId.length === 0) {
+      throw badRequest('resourceId is required');
+    }
+    if (!resourceExists(store, type, resourceId)) throw notFound(`${type} ${resourceId} not found`);
+
+    const target = resolveTargetUser(store, payload);
+    const role = parseRole(payload.role ?? payload.permission ?? payload.accessLevel);
+    const created = shareResource(store, user, type, resourceId, target, role);
+    res.status(201).json({ ...created, username: target.username });
+  });
+  router.post('/share', auth, share);
+  router.post('/shares', auth, share);
+  router.post('/permissions', auth, share);
+
+  router.get(
+    '/shares',
+    auth,
+    route((req, res) => {
+      const user = currentUser(req);
+      // Everything shared *with* the caller, plus the shares they can see on
+      // resources they hold access to.
+      const visible = [...store.shares.values()].filter(
+        (s) => s.userId === user.id || canRead(store, user.id, s.resourceType, s.resourceId),
+      );
+      res.json(visible);
+    }),
+  );
+
+  router.delete(
+    '/shares',
+    auth,
+    route((req, res) => {
+      const user = currentUser(req);
+      const payload = body(req);
+      const type = parseResourceType(payload.resourceType ?? payload.type);
+      const resourceId = payload.resourceId ?? payload.targetId;
+      if (typeof resourceId !== 'string') throw badRequest('resourceId is required');
+      const target = resolveTargetUser(store, payload);
+      revokeShare(store, user, type, resourceId, target.id);
+      res.status(204).end();
+    }),
+  );
+
+  router.get(
+    '/:resourceType(folders|documents)/:id/access',
+    auth,
+    route((req, res) => {
+      const user = currentUser(req);
+      const type = parseResourceType(req.params.resourceType);
+      if (!resourceExists(store, type, req.params.id)) throw notFound(`${type} not found`);
+      if (!canRead(store, user.id, type, req.params.id)) {
+        res.json({ role: null, permission: null, canRead: false });
+        return;
+      }
+      res.json(listShares(store, type, req.params.id));
+    }),
+  );
+
+  return router;
+}
diff --git a/src/sharing.ts b/src/sharing.ts
new file mode 100644
index 0000000..7f7c2f9
--- /dev/null
+++ b/src/sharing.ts
@@ -0,0 +1,172 @@
+import { badRequest, forbidden, notFound } from './errors.js';
+import { ROLE_RANK, atLeast, effectiveRole, isRole } from './permissions.js';
+import type { Store } from './store.js';
+import type { ResourceType, Role, Share, User } from './types.js';
+
+const RESOURCE_LABEL: Record<ResourceType, string> = { folder: 'Folder', document: 'Document' };
+
+export function resourceExists(store: Store, type: ResourceType, id: string): boolean {
+  return type === 'folder' ? store.folders.has(id) : store.documents.has(id);
+}
+
+export function resourceOwnerId(store: Store, type: ResourceType, id: string): string | undefined {
+  return type === 'folder' ? store.folders.get(id)?.ownerId : store.documents.get(id)?.ownerId;
+}
+
+export function parseResourceType(value: unknown): ResourceType {
+  if (typeof value !== 'string') throw badRequest('resourceType is required');
+  const normalized = value.toLowerCase().replace(/s$/, '');
+  if (normalized === 'folder' || normalized === 'document') return normalized;
+  throw badRequest(`Unknown resourceType '${value}' (expected 'folder' or 'document')`);
+}
+
+export function parseRole(value: unknown): Role {
+  if (typeof value === 'string' && isRole(value.toLowerCase())) return value.toLowerCase() as Role;
+  throw badRequest("role must be one of 'viewer', 'editor', 'owner'");
+}
+
+/** Accepts `userId`, `username`, or their common aliases in a share payload. */
+export function resolveTargetUser(store: Store, body: Record<string, unknown>): User {
+  const id = body.userId ?? body.targetUserId ?? body.user ?? body.sharedWith;
+  if (typeof id === 'string' && id.length > 0) {
+    const user = store.users.get(id);
+    if (user) return user;
+    // Fall through: some clients pass a username in the `user` field.
+    const byName = store.findUserByUsername(id);
+    if (byName) return byName;
+    throw notFound(`User ${id} not found`);
+  }
+
+  const username = body.username ?? body.targetUsername;
+  if (typeof username === 'string' && username.length > 0) {
+    const user = store.findUserByUsername(username);
+    if (!user) throw notFound(`User '${username}' not found`);
+    return user;
+  }
+
+  throw badRequest('userId or username is required');
+}
+
+/**
+ * Grants (or updates) a role on a resource.
+ *
+ * Editors may share, but only owners may hand out or alter `owner` access —
+ * otherwise an editor could promote themselves past their own ceiling.
+ */
+export function shareResource(
+  store: Store,
+  actor: User,
+  type: ResourceType,
+  resourceId: string,
+  target: User,
+  role: Role,
+): Share {
+  if (!resourceExists(store, type, resourceId)) {
+    throw notFound(`${RESOURCE_LABEL[type]} ${resourceId} not found`);
+  }
+
+  const actorRole = effectiveRole(store, actor.id, type, resourceId);
+  if (!atLeast(actorRole, 'editor')) {
+    throw forbidden(`Requires 'editor' access to share this ${type}`);
+  }
+
+  if (target.id === actor.id) {
+    throw badRequest('You cannot change your own access to a resource');
+  }
+  if (resourceOwnerId(store, type, resourceId) === target.id) {
+    throw badRequest('Cannot change the role of the resource creator');
+  }
+
+  const existing = store.getShare(type, resourceId, target.id);
+  const touchesOwner = role === 'owner' || existing?.role === 'owner';
+  if (touchesOwner && actorRole !== 'owner') {
+    throw forbidden("Only an owner can grant or modify 'owner' access");
+  }
+
+  const share: Share = {
+    id: existing?.id ?? store.id('shr'),
+    resourceType: type,
+    resourceId,
+    userId: target.id,
+    role,
+    grantedBy: actor.id,
+    createdAt: existing?.createdAt ?? store.now(),
+  };
+  store.setShare(share);
+  store.log('share.grant', actor.id, type, resourceId, {
+    targetUserId: target.id,
+    targetUsername: target.username,
+    role,
+  });
+  return share;
+}
+
+/** Owners may revoke anyone's access; anybody may drop their own. */
+export function revokeShare(
+  store: Store,
+  actor: User,
+  type: ResourceType,
+  resourceId: string,
+  targetUserId: string,
+): void {
+  if (!resourceExists(store, type, resourceId)) {
+    throw notFound(`${RESOURCE_LABEL[type]} ${resourceId} not found`);
+  }
+  const actorRole = effectiveRole(store, actor.id, type, resourceId);
+  if (actorRole !== 'owner' && actor.id !== targetUserId) {
+    throw forbidden("Only an owner can revoke another user's access");
+  }
+  if (!actorRole) throw forbidden('You do not have access to this resource');
+
+  const removed = store.removeShare(type, resourceId, targetUserId);
+  if (!removed) throw notFound('No such share');
+
+  store.log('share.revoke', actor.id, type, resourceId, { targetUserId });
+}
+
+export interface ShareView {
+  userId: string;
+  username: string;
+  role: Role;
+  resourceType: ResourceType;
+  resourceId: string;
+  grantedBy: string;
+  createdAt: string;
+  inherited: boolean;
+}
+
+/** Direct shares plus the implicit creator-owner entry, most permissive first. */
+export function listShares(store: Store, type: ResourceType, resourceId: string): ShareView[] {
+  const ownerId = resourceOwnerId(store, type, resourceId);
+  const views: ShareView[] = [];
+
+  if (ownerId) {
+    const owner = store.users.get(ownerId);
+    views.push({
+      userId: ownerId,
+      username: owner?.username ?? 'unknown',
+      role: 'owner',
+      resourceType: type,
+      resourceId,
+      grantedBy: ownerId,
+      createdAt: owner?.createdAt ?? '',
+      inherited: false,
+    });
+  }
+
+  for (const share of store.sharesFor(type, resourceId)) {
+    const user = store.users.get(share.userId);
+    views.push({
+      userId: share.userId,
+      username: user?.username ?? 'unknown',
+      role: share.role,
+      resourceType: type,
+      resourceId,
+      grantedBy: share.grantedBy,
+      createdAt: share.createdAt,
+      inherited: false,
+    });
+  }
+
+  return views.sort((a, b) => ROLE_RANK[b.role] - ROLE_RANK[a.role]);
+}
