ng('hex');\n    const user: User = {\n      id: this.id('usr'),\n      username,\n      passwordHash: `${salt}:${hash}`,\n      createdAt: this.now(),\n    };\n    this.users.set(user.id, user);\n    this.usersByUsername.set(username.toLowerCase(), user.id);\n    return user;\n  }\n\n  findUserByUsername(username: string): User | undefined {\n    const id = this.usersByUsername.get(username.toLowerCase());\n    return id ? this.users.get(id) : undefined;\n  }\n\n  verifyPassword(user: User, password: string): boolean {\n    const [salt, hash] = user.passwordHash.split(':');\n    if (!salt || !hash) return false;\n    const candidate = scryptSync(password, salt, 64);\n    const expected = Buffer.from(hash, 'hex');\n    return candidate.length === expected.length && timingSafeEqual(candidate, expected);\n  }\n\n  issueToken(userId: string): string {\n    const token = randomBytes(24).toString('hex');\n    this.tokens.set(token, userId);\n    return token;\n  }\n\n  userForToken(token: string): User | undefined {\n    const userId = this.tokens.get(token);\n    return userId ? this.users.get(userId) : undefined;\n  }\n\n  revokeToken(token: string): void {\n    this.tokens.delete(token);\n  }\n\n  // --------------------------------------------------------------- shares\n\n  getShare(type: ResourceType, resourceId: string, userId: string): Share | undefined {\n    return this.sharesByKey.get(shareKey(type, resourceId, userId));\n  }\n\n  setShare(share: Share): void {\n    const existing = this.getShare(share.resourceType, share.resourceId, share.userId);\n    if (existing) this.shares.delete(existing.id);\n    this.shares.set(share.id, share);\n    this.sharesByKey.set(shareKey(share.resourceType, share.resourceId, share.userId), share);\n  }\n\n  removeShare(type: ResourceType, resourceId: string, userId: string): Share | undefined {\n    const existing = this.getShare(type, resourceId, userId);\n    if (!existing) return undefined;\n    this.shares.delete(existing.i