+import { describe, expect, it } from 'vitest';
+import { as, createDocument, createFolder, newApp, register } from './helpers.js';
+
+describe('sharing and effective permissions', () => {
+  it('grants a viewer read-only access', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const folder = await createFolder(app, alice, 'Root');
+    const doc = await createDocument(app, alice, folder);
+
+    const share = await as(app, alice)
+      .post(`/documents/${doc}/share`)
+      .send({ userId: bob.id, role: 'viewer' });
+    expect(share.status).toBe(201);
+    expect(share.body.role).toBe('viewer');
+
+    const read = await as(app, bob).get(`/documents/${doc}`);
+    expect(read.status).toBe(200);
+    expect(read.body.role).toBe('viewer');
+
+    expect((await as(app, bob).patch(`/documents/${doc}`).send({ content: 'nope' })).status).toBe(
+      403,
+    );
+    expect((await as(app, bob).delete(`/documents/${doc}`)).status).toBe(403);
+  });
+
+  it('lets editors modify and re-share, but not grant ownership or delete', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const carol = await register(app, 'carol');
+    const folder = await createFolder(app, alice, 'Root');
+    const doc = await createDocument(app, alice, folder);
+
+    await as(app, alice).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'editor' });
+
+    expect((await as(app, bob).patch(`/documents/${doc}`).send({ content: 'edited' })).status).toBe(
+      200,
+    );
+
+    const reshare = await as(app, bob)
+      .post(`/documents/${doc}/share`)
+      .send({ userId: carol.id, role: 'viewer' });
+    expect(reshare.status).toBe(201);
+    expect((await as(app, carol).get(`/documents/${doc}`)).status).toBe(200);
+
+    const escalate = await as(app, bob)
+      .post(`/documents/${doc}/share`)
+      .send({ userId: carol.id, role: 'owner' });
+    expect(escalate.status).toBe(403);
+
+    expect((await as(app, bob).delete(`/documents/${doc}`)).status).toBe(403);
+  });
+
+  it('viewers cannot share', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const carol = await register(app, 'carol');
+    const folder = await createFolder(app, alice, 'Root');
+    const doc = await createDocument(app, alice, folder);
+
+    await as(app, alice).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'viewer' });
+    const res = await as(app, bob)
+      .post(`/documents/${doc}/share`)
+      .send({ userId: carol.id, role: 'viewer' });
+    expect(res.status).toBe(403);
+  });
+
+  it('promotes a co-owner who can then delete', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const folder = await createFolder(app, alice, 'Root');
+    const doc = await createDocument(app, alice, folder);
+
+    const res = await as(app, alice)
+      .post(`/documents/${doc}/share`)
+      .send({ userId: bob.id, role: 'owner' });
+    expect(res.status).toBe(201);
+    expect((await as(app, bob).delete(`/documents/${doc}`)).status).toBe(204);
+  });
+
+  it('inherits folder permissions down to nested folders and documents', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const root = await createFolder(app, alice, 'Root');
+    const child = await createFolder(app, alice, 'Child', root);
+    const doc = await createDocument(app, alice, child, 'Deep');
+
+    await as(app, alice).post(`/folders/${root}/share`).send({ userId: bob.id, role: 'viewer' });
+
+    expect((await as(app, bob).get(`/folders/${child}`)).status).toBe(200);
+    const read = await as(app, bob).get(`/documents/${doc}`);
+    expect(read.status).toBe(200);
+    expect(read.body.role).toBe('viewer');
+    expect((await as(app, bob).patch(`/documents/${doc}`).send({ content: 'x' })).status).toBe(403);
+  });
+
+  it('takes the most permissive role when access arrives through multiple paths', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const root = await createFolder(app, alice, 'Root');
+    const child = await createFolder(app, alice, 'Child', root);
+    const doc = await createDocument(app, alice, child, 'Deep');
+
+    // Weak access via the folder tree, stronger access granted directly.
+    await as(app, alice).post(`/folders/${root}/share`).send({ userId: bob.id, role: 'viewer' });
+    await as(app, alice).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'editor' });
+
+    const read = await as(app, bob).get(`/documents/${doc}`);
+    expect(read.body.role).toBe('editor');
+    expect((await as(app, bob).patch(`/documents/${doc}`).send({ content: 'ok' })).status).toBe(200);
+
+    // ...and the reverse: strong access inherited, weak access granted directly.
+    const doc2 = await createDocument(app, alice, child, 'Deep2');
+    await as(app, alice).post(`/folders/${child}/share`).send({ userId: bob.id, role: 'editor' });
+    await as(app, alice).post(`/documents/${doc2}/share`).send({ userId: bob.id, role: 'viewer' });
+
+    const read2 = await as(app, bob).get(`/documents/${doc2}`);
+    expect(read2.body.role).toBe('editor');
+    expect((await as(app, bob).patch(`/documents/${doc2}`).send({ content: 'ok' })).status).toBe(
+      200,
+    );
+  });
+
+  it('shares by username as well as id, and rejects unknown targets or roles', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const folder = await createFolder(app, alice, 'Root');
+    const doc = await createDocument(app, alice, folder);
+
+    const byName = await as(app, alice)
+      .post(`/documents/${doc}/share`)
+      .send({ username: 'bob', role: 'viewer' });
+    expect(byName.status).toBe(201);
+    expect(byName.body.userId).toBe(bob.id);
+
+    expect(
+      (await as(app, alice).post(`/documents/${doc}/share`).send({ userId: 'ghost', role: 'viewer' }))
+        .status,
+    ).toBe(404);
+    expect(
+      (await as(app, alice).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'admin' }))
+        .status,
+    ).toBe(400);
+    expect((await as(app, alice).post(`/documents/${doc}/share`).send({ role: 'viewer' })).status).toBe(
+      400,
+    );
+  });
+
+  it('lists and revokes shares', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const folder = await createFolder(app, alice, 'Root');
+    const doc = await createDocument(app, alice, folder);
+
+    await as(app, alice).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'editor' });
+
+    const list = await as(app, alice).get(`/documents/${doc}/shares`);
+    expect(list.status).toBe(200);
+    const roles = Object.fromEntries(
+      list.body.map((s: { userId: string; role: string }) => [s.userId, s.role]),
