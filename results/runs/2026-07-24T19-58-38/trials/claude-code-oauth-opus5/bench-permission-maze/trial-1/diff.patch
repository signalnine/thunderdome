+import { describe, expect, it } from 'vitest';
+import request from 'supertest';
+import { as, createDocument, createFolder, newApp, register } from './helpers.js';
+
+describe('route aliases and edge cases', () => {
+  it('supports the root-level auth aliases', async () => {
+    const app = newApp();
+    const reg = await request(app).post('/register').send({ username: 'a', password: 'pw1234' });
+    expect(reg.status).toBe(201);
+
+    const login = await request(app).post('/login').send({ username: 'a', password: 'pw1234' });
+    expect(login.status).toBe(200);
+
+    const viaUsers = await request(app).post('/users').send({ username: 'b', password: 'pw1234' });
+    expect(viaUsers.status).toBe(201);
+
+    const me = await request(app).get('/me').set('Authorization', `Bearer ${login.body.token}`);
+    expect(me.body.username).toBe('a');
+
+    const activity = await request(app)
+      .get('/activities')
+      .set('Authorization', `Bearer ${login.body.token}`);
+    expect(activity.status).toBe(200);
+  });
+
+  it('handles malformed JSON and unknown routes', async () => {
+    const app = newApp();
+    const bad = await request(app)
+      .post('/auth/register')
+      .set('Content-Type', 'application/json')
+      .send('{oops');
+    expect(bad.status).toBe(400);
+    expect((await request(app).get('/nope')).status).toBe(404);
+    expect((await request(app).get('/health')).status).toBe(200);
+  });
+
+  it('gives a folder owner full control over documents created there by an editor', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const folder = await createFolder(app, alice, 'Shared');
+
+    await as(app, alice).post(`/folders/${folder}/share`).send({ userId: bob.id, role: 'editor' });
+    const doc = await createDocument(app, bob, folder, 'Bob doc');
+
+    expect((await as(app, alice).delete(`/documents/${doc}`)).status).toBe(204);
+  });
+
+  it('updates an existing share with PUT', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const folder = await createFolder(app, alice, 'Root');
+    const doc = await createDocument(app, alice, folder);
+
+    await as(app, alice).post(`/documents/${doc}/share`).send({ userId: bob.id, role: 'viewer' });
+    const upgraded = await as(app, alice)
+      .put(`/documents/${doc}/share/${bob.id}`)
+      .send({ role: 'editor' });
+    expect(upgraded.status).toBe(200);
+    expect(upgraded.body.role).toBe('editor');
+    expect((await as(app, bob).patch(`/documents/${doc}`).send({ content: 'x' })).status).toBe(200);
+
+    expect((await as(app, alice).get(`/documents/${doc}/permissions`)).status).toBe(200);
+  });
+
+  it('keeps stores isolated between app instances', async () => {
+    const first = newApp();
+    const alice = await register(first, 'alice');
+    await createFolder(first, alice, 'Root');
+
+    const second = newApp();
+    expect((await as(second, alice).get('/folders')).status).toBe(401);
+  });
+});
