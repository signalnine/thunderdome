@@ -0,0 +1,68 @@
+import express, {
+  json,
+  type Express,
+  type NextFunction,
+  type Request,
+  type Response,
+} from 'express';
+import { authenticate } from './auth.js';
+import { HttpError } from './errors.js';
+import { activityRoutes } from './routes/activity.js';
+import { authRoutes, userRoutes } from './routes/auth.js';
+import { documentRoutes } from './routes/documents.js';
+import { folderRoutes } from './routes/folders.js';
+import { genericShareRoutes } from './routes/shares.js';
+import { Store } from './store.js';
+
+export interface AppOptions {
+  /** Inject a pre-populated store (mainly useful for tests). */
+  store?: Store;
+}
+
+export function createApp(options: AppOptions = {}): Express {
+  const store = options.store ?? new Store();
+  const app = express();
+
+  app.disable('x-powered-by');
+  app.use(json({ limit: '5mb' }));
+
+  app.get(['/health', '/healthz'], (_req, res) => {
+    res.status(200).json({ status: 'ok' });
+  });
+
+  app.use('/auth', authRoutes(store));
+  // Convenience aliases: POST /login, POST /register, GET /me.
+  app.use('/', authRoutes(store));
+  app.use('/users', userRoutes(store));
+  app.use('/folders', folderRoutes(store));
+  app.use('/documents', documentRoutes(store));
+  app.use(['/share', '/shares'], authenticate(store), genericShareRoutes(store));
+  app.use(['/activity', '/activities', '/activity-log'], activityRoutes(store));
+
+  app.use((req: Request, res: Response) => {
+    res.status(404).json({ error: `Not found: ${req.method} ${req.originalUrl}` });
+  });
+
+  app.use((err: unknown, _req: Request, res: Response, _next: NextFunction) => {
+    if (err instanceof HttpError) {
+      res.status(err.status).json({
+        error: err.message,
+        message: err.message,
+        ...(err.details ? { details: err.details } : {}),
+      });
+      return;
+    }
+    if (err instanceof SyntaxError && 'body' in err) {
+      res.status(400).json({ error: 'Malformed JSON body', message: 'Malformed JSON body' });
+      return;
+    }
+    const message = err instanceof Error ? err.message : 'Internal server error';
+    res.status(500).json({ error: message, message });
+    return;
+  });
+
+  return app;
+}
+
+export { Store };
+export default createApp;
diff --git a/src/auth.ts b/src/auth.ts
new file mode 100644
index 0000000..552ac18
--- /dev/null
+++ b/src/auth.ts
@@ -0,0 +1,66 @@
+import type { NextFunction, Request, RequestHandler, Response } from 'express';
+import { badRequest, unauthorized } from './errors.js';
+import type { Store } from './store.js';
+import type { User } from './types.js';
+
+declare module 'express-serve-static-core' {
+  interface Request {
+    user?: User;
+    token?: string;
+  }
+}
+
+const MIN_PASSWORD_LENGTH = 4;
+
+export function validateCredentials(username: unknown, password: unknown): {
+  username: string;
+  password: string;
+} {
+  if (typeof username !== 'string' || username.trim().length === 0) {
+    throw badRequest("'username' is required and must be a non-empty string");
+  }
+  if (typeof password !== 'string' || password.length === 0) {
+    throw badRequest("'password' is required and must be a non-empty string");
+  }
+  if (password.length < MIN_PASSWORD_LENGTH) {
+    throw badRequest(`'password' must be at least ${MIN_PASSWORD_LENGTH} characters`);
+  }
+  return { username: username.trim(), password };
+}
+
+function extractToken(req: Request): string | null {
+  const header = req.get('authorization');
+  if (header) {
+    const match = /^Bearer\s+(.+)$/i.exec(header.trim());
+    if (match) return match[1].trim();
+    // Tolerate a bare token in the Authorization header.
+    if (!header.includes(' ')) return header.trim();
+  }
+  const headerToken = req.get('x-auth-token');
+  return headerToken ? headerToken.trim() : null;
+}
+
+/** Rejects the request unless it carries a valid bearer token. */
+export function authenticate(store: Store): RequestHandler {
+  return (req: Request, _res: Response, next: NextFunction) => {
+    const token = extractToken(req);
+    if (!token) {
+      next(unauthorized('Missing authentication token'));
+      return;
+    }
+    const user = store.userForToken(token);
+    if (!user) {
+      next(unauthorized('Invalid or expired token'));
+      return;
+    }
+    req.user = user;
+    req.token = token;
+    next();
+  };
+}
+
+/** The authenticated user; safe to call inside handlers mounted behind `authenticate`. */
+export function currentUser(req: Request): User {
+  if (!req.user) throw unauthorized();
+  return req.user;
+}
