--- /dev/null
+++ b/src/routes/activity.ts
@@ -0,0 +1,45 @@
+import { Router } from 'express';
+import { authenticate, currentUser } from '../auth.js';
+import { canRead } from '../permissions.js';
+import type { Store } from '../store.js';
+import { isResourceType, type ActivityEntry } from '../types.js';
+
+/**
+ * A user sees an activity entry when they performed it, or when they can still
+ * read the resource it refers to (deleted resources stay visible to the actor).
+ */
+function visibleTo(store: Store, userId: string, entry: ActivityEntry): boolean {
+  if (entry.userId === userId) return true;
+  return canRead(store, userId, entry.resourceType, entry.resourceId);
+}
+
+export function activityRoutes(store: Store): Router {
+  const router = Router();
+  router.use(authenticate(store));
+
+  router.get('/', (req, res) => {
+    const user = currentUser(req);
+    let entries = store.activity.filter((e) => visibleTo(store, user.id, e));
+
+    const { resourceType, resourceId, action, userId } = req.query;
+    if (isResourceType(resourceType)) {
+      entries = entries.filter((e) => e.resourceType === resourceType);
+    }
+    if (typeof resourceId === 'string' && resourceId) {
+      entries = entries.filter((e) => e.resourceId === resourceId);
+    }
+    if (typeof action === 'string' && action) {
+      entries = entries.filter((e) => e.action === action);
+    }
+    if (typeof userId === 'string' && userId) {
+      entries = entries.filter((e) => e.userId === userId);
+    }
+    const limit = Number.parseInt(String(req.query.limit ?? ''), 10);
+    if (Number.isFinite(limit) && limit > 0) {
+      entries = entries.slice(-limit);
+    }
+    res.status(200).json(entries);
+  });
+
+  return router;
+}
diff --git a/src/routes/auth.ts b/src/routes/auth.ts
new file mode 100644
index 0000000..0bc3a92
--- /dev/null
+++ b/src/routes/auth.ts
@@ -0,0 +1,80 @@
+import { Router, type RequestHandler } from 'express';
+import { authenticate, currentUser, validateCredentials } from '../auth.js';
+import { conflict, unauthorized } from '../errors.js';
+import { publicUsers } from '../serialize.js';
+import type { Store } from '../store.js';
+import { asObject } from '../validate.js';
+import { toPublicUser } from '../types.js';
+
+function registerHandler(store: Store): RequestHandler {
+  return (req, res) => {
+    const body = asObject(req.body);
+    const { username, password } = validateCredentials(body.username, body.password);
+    if (store.findUserByUsername(username)) {
+      throw conflict('Username already taken');
+    }
+    const user = store.createUser(username, password);
+    const token = store.issueToken(user);
+    res.status(201).json({ ...toPublicUser(user), token, user: toPublicUser(user) });
+  };
+}
+
+function loginHandler(store: Store): RequestHandler {
+  return (req, res) => {
+    const body = asObject(req.body);
+    const { username, password } = validateCredentials(body.username, body.password);
+    const user = store.findUserByUsername(username);
+    if (!user || !store.verifyPassword(user, password)) {
+      throw unauthorized('Invalid username or password');
+    }
+    const token = store.issueToken(user);
+    res.status(200).json({ token, user: toPublicUser(user), ...toPublicUser(user) });
+  };
+}
+
+export function authRoutes(store: Store): Router {
+  const router = Router();
+
+  router.post('/register', registerHandler(store));
+  router.post('/signup', registerHandler(store));
+  router.post('/login', loginHandler(store));
+
+  router.post('/logout', authenticate(store), (req, res) => {
+    if (req.token) store.revokeToken(req.token);
+    res.status(204).end();
+  });
+
+  router.get('/me', authenticate(store), (req, res) => {
+    res.status(200).json(toPublicUser(currentUser(req)));
+  });
+
+  return router;
+}
+
+/** `/users` — registration is public, everything else needs a token. */
+export function userRoutes(store: Store): Router {
+  const router = Router();
+
+  router.post('/', registerHandler(store));
+
+  router.use(authenticate(store));
+
+  router.get('/', (_req, res) => {
+    res.status(200).json(publicUsers(store));
+  });
+
+  router.get('/me', (req, res) => {
+    res.status(200).json(toPublicUser(currentUser(req)));
+  });
+
+  router.get('/:id', (req, res) => {
+    const user = store.users.get(req.params.id) ?? store.findUserByUsername(req.params.id);
+    if (!user) {
+      res.status(404).json({ error: 'User not found' });
+      return;
+    }
+    res.status(200).json(toPublicUser(user));
+  });
+
+  return router;
+}
diff --git a/src/routes/documents.ts b/src/routes/documents.ts
new file mode 100644
index 0000000..e3d16cf
--- /dev/null
+++ b/src/routes/documents.ts
@@ -0,0 +1,102 @@
+import { Router, type RequestHandler } from 'express';
+import { authenticate, currentUser } from '../auth.js';
+import { badRequest, notFound } from '../errors.js';
+import { documentRole, readableDocuments, requireDocument, requireFolder } from '../permissions.js';
+import { documentView } from '../serialize.js';
+import type { Store } from '../store.js';
+import type { Doc, User } from '../types.js';
+import { asObject, optionalString, requiredString } from '../validate.js';
+import { resourceShareRoutes } from './shares.js';
+
+const MAX_TITLE = 300;
+
+/** Shared by `POST /documents` and `POST /folders/:id/documents`. */
+export function createDocumentInFolder(
+  store: Store,
+  user: User,
+  folderId: string,
+  body: Record<string, unknown>,
+): Doc {
+  const title = requiredString(body, 'title', { maxLength: MAX_TITLE });
+  const content = optionalString(body, 'content', { allowEmpty: true }) ?? '';
+
+  // Creating a document inside a folder counts as modifying that folder.
+  requireFolder(store, user.id, folderId, 'editor');
+
+  const doc = store.createDocument(title, content, folderId, user.id);
+  store.log('document.create', user.id, 'document', doc.id, { title, folderId });
+  return doc;
+}
+
+export function documentRoutes(store: Store): Router {
+  const router = Router();
+  router.use(authenticate(store));
+
+  router.post('/', (req, res) => {
+    const user = currentUser(req);
+    const body = asObject(req.body);
+    const folderId = body.folderId ?? body.folder ?? body.parentId;
+    if (typeof folderId !== 'string' || !folderId.trim()) {
+      throw badRequest("'folderId' is required — documents must live inside a folder");
+    }
+    const doc = createDocumentInFolder(store, user, folderId.trim(), body);
+    res.status(201).json(documentView(doc, 'owner'));
+  });
+
+  router.get('/', (req, res) => {
+    const user = currentUser(req);
+    let docs = readableDocuments(store, user.id);
+    const folderFilter = req.query.folderId;
+    if (typeof folderFilter === 'string' && folderFilter) {
+      docs = docs.filter((d) => d.folderId === folderFilter);
+    }
+    res.status(200).json(docs.map((d) => documentView(d, documentRole(store, user.id, d))));
+  });
+
+  router.get('/:id', (req, res) => {
+    const user = currentUser(req);
+    const { doc, role } = requireDocument(store, user.id, req.params.id, 'viewer');
+    res.status(200).json(documentView(doc, role));
+  });
+
+  const update: RequestHandler = (req, res) => {
+    const user = currentUser(req);
+    const { doc } = requireDocument(store, user.id, req.params.id, 'editor');
+    const body = asObject(req.body);
+
+    const title = optionalString(body, 'title', { maxLength: MAX_TITLE });
+    const content = optionalString(body, 'content', { allowEmpty: true });
+    const folderId = body.folderId;
+
+    if (typeof folderId === 'string' && folderId && folderId !== doc.folderId) {
+      requireFolder(store, user.id, folderId, 'editor');
+      doc.folderId = folderId;
+    }
+    if (title !== undefined) doc.title = title;
+    if (content !== undefined) doc.content = content;
+    doc.updatedAt = new Date().toISOString();
+
+    store.log('document.update', user.id, 'document', doc.id, { title: doc.title });
+    res.status(200).json(documentView(doc, documentRole(store, user.id, doc)));
+  };
+
+  router.patch('/:id', update);
+  router.put('/:id', update);
+
+  router.delete('/:id', (req, res) => {
+    const user = currentUser(req);
+    const { doc } = requireDocument(store, user.id, req.params.id, 'owner');
+    store.documents.delete(doc.id);
+    store.removeAllShares('document', doc.id);
+    store.log('document.delete', user.id, 'document', doc.id, { title: doc.title });
+    res.status(204).end();
+  });
+
+  router.use('/:id', resourceShareRoutes(store, 'document'));
+
+  router.use((req, _res, next) => {
+    next(notFound(`No document route for ${req.method} ${req.originalUrl}`));
+  });
+
+  return router;
+}
diff --git a/src/routes/folders.ts b/src/routes/folders.ts
new file mode 100644
index 0000000..2c60cd0
--- /dev/null
+++ b/src/routes/folders.ts
@@ -0,0 +1,150 @@
+import { Router, type RequestHandler } from 'express';
+import { authenticate, currentUser } from '../auth.js';
+import { badRequest, notFound } from '../errors.js';
+import {
+  documentRole,
+  folderRole,
+  readableFolders,
+  requireFolder,
+} from '../permissions.js';
+import { documentView, folderView } from '../serialize.js';
+import type { Store } from '../store.js';
+import { atLeast } from '../types.js';
+import { asObject, optionalId, optionalString, requiredString } from '../validate.js';
+import { createDocumentInFolder } from './documents.js';
+import { resourceShareRoutes } from './shares.js';
+
+const MAX_NAME = 200;
+
+export function folderRoutes(store: Store): Router {
+  const router = Router();
+  router.use(authenticate(store));
+
+  router.post('/', (req, res) => {
+    const user = currentUser(req);
+    const body = asObject(req.body);
+    const name = requiredString(body, 'name', { maxLength: MAX_NAME });
+    const parentId = optionalId(body, 'parentId') ?? optionalId(body, 'parent') ?? null;
+
+    if (parentId) {
+      // Adding a child to a folder is a modification of that folder.
+      requireFolder(store, user.id, parentId, 'editor');
+    }
+    const folder = store.createFolder(name, parentId, user.id);
+    store.log('folder.create', user.id, 'folder', folder.id, { name, parentId });
+    res.status(201).json(folderView(folder, 'owner'));
+  });
+
+  router.get('/', (req, res) => {
+    const user = currentUser(req);
+    const parentFilter = req.query.parentId;
+    let folders = readableFolders(store, user.id);
+    if (typeof parentFilter === 'string') {
+      const parentId = parentFilter === '' || parentFilter === 'null' ? null : parentFilter;
+      folders = folders.filter((f) => f.parentId === parentId);
+    }
+    res.status(200).json(folders.map((f) => folderView(f, folderRole(store, user.id, f.id))));
+  });
+
+  router.get('/:id', (req, res) => {
+    const user = currentUser(req);
+    const { folder, role } = requireFolder(store, user.id, req.params.id, 'viewer');
+    const children = store
+      .childFolders(folder.id)
+      .filter((f) => atLeast(folderRole(store, user.id, f.id), 'viewer'))
+      .map((f) => folderView(f, folderRole(store, user.id, f.id)));
+    const documents = store
+      .documentsInFolder(folder.id)
+      .filter((d) => atLeast(documentRole(store, user.id, d), 'viewer'))
+      .map((d) => documentView(d, documentRole(store, user.id, d)));
+    res.status(200).json({ ...folderView(folder, role), children, folders: children, documents });
+  });
+
+  router.get('/:id/children', (req, res) => {
+    const user = currentUser(req);
+    const { folder } = requireFolder(store, user.id, req.params.id, 'viewer');
+    const children = store
+      .childFolders(folder.id)
+      .filter((f) => atLeast(folderRole(store, user.id, f.id), 'viewer'))
+      .map((f) => folderView(f, folderRole(store, user.id, f.id)));
+    res.status(200).json(children);
+  });
+
+  router.get('/:id/documents', (req, res) => {
+    const user = currentUser(req);
+    const { folder } = requireFolder(store, user.id, req.params.id, 'viewer');
+    const documents = store
+      .documentsInFolder(folder.id)
+      .filter((d) => atLeast(documentRole(store, user.id, d), 'viewer'))
+      .map((d) => documentView(d, documentRole(store, user.id, d)));
+    res.status(200).json(documents);
+  });
+
+  router.post('/:id/documents', (req, res) => {
+    const user = currentUser(req);
+    const body = asObject(req.body);
+    const doc = createDocumentInFolder(store, user, req.params.id, body);
+    res.status(201).json(documentView(doc, 'owner'));
+  });
+
+  const update: RequestHandler = (req, res) => {
+    const user = currentUser(req);
+    const { folder } = requireFolder(store, user.id, req.params.id, 'editor');
+    const body = asObject(req.body);
+
+    const name = optionalString(body, 'name', { maxLength: MAX_NAME });
+    const parentId = optionalId(body, 'parentId');
+
+    if (parentId !== undefined && parentId !== folder.parentId) {
+      if (parentId !== null) {
+        if (parentId === folder.id) throw badRequest('A folder cannot be its own parent');
+        requireFolder(store, user.id, parentId, 'editor');
+        const descendants = new Set(store.subtree(folder.id).map((f) => f.id));
+        if (descendants.has(parentId)) {
+          throw badRequest('A folder cannot be moved inside one of its own descendants');
+        }
+      }
+      folder.parentId = parentId;
+    }
+    if (name !== undefined) folder.name = name;
+    folder.updatedAt = new Date().toISOString();
+
+    store.log('folder.update', user.id, 'folder', folder.id, { name: folder.name });
+    res.status(200).json(folderView(folder, folderRole(store, user.id, folder.id)));
+  };
+
+  router.patch('/:id', update);
+  router.put('/:id', update);
+
+  router.delete('/:id', (req, res) => {
+    const user = currentUser(req);
+    const { folder } = requireFolder(store, user.id, req.params.id, 'owner');
+
+    // Deleting a folder removes everything nested beneath it.
+    for (const descendant of store.subtree(folder.id).reverse()) {
+      for (const doc of store.documentsInFolder(descendant.id)) {
+        store.documents.delete(doc.id);
+        store.removeAllShares('document', doc.id);
+        store.log('document.delete', user.id, 'document', doc.id, {
+          title: doc.title,
+          cascade: true,
+        });
+      }
+      store.folders.delete(descendant.id);
+      store.removeAllShares('folder', descendant.id);
+      if (descendant.id !== folder.id) {
+        store.log('folder.delete', user.id, 'folder', descendant.id, { cascade: true });
+      }
+    }
+    store.log('folder.delete', user.id, 'folder', folder.id, { name: folder.name });
+    res.status(204).end();
+  });
+
+  router.use('/:id', resourceShareRoutes(store, 'folder'));
+
+  router.use((req, _res, next) => {
+    next(notFound(`No folder route for ${req.method} ${req.originalUrl}`));
+  });
+
+  return router;
+}
diff --git a/src/routes/shares.ts b/src/routes/shares.ts
new file mode 100644
index 0000000..9a23147
--- /dev/null
+++ b/src/routes/shares.ts
@@ -0,0 +1,75 @@
+import { Router } from 'express';
+import { currentUser } from '../auth.js';
+import { notFound } from '../errors.js';
+import { requireResource } from '../permissions.js';
+import { shareView } from '../serialize.js';
+import { accessList, grantShare, parseRole, resolveTargetUser, revokeShare } from '../sharing.js';
+import type { Store } from '../store.js';
+import { isResourceType, type ResourceType } from '../types.js';
+import { asObject } from '../validate.js';
+
+/**
+ * Share endpoints scoped to a single resource. Mounted under `/:id` of the
+ * folder and document routers (hence `mergeParams`).
+ */
+export function resourceShareRoutes(store: Store, resourceType: ResourceType): Router {
+  const router = Router({ mergeParams: true });
+
+  router.post(['/share', '/shares', '/permissions'], (req, res) => {
+    const actor = currentUser(req);
+    const body = asObject(req.body);
+    const target = resolveTargetUser(store, body);
+    const role = parseRole(body.role ?? body.permission);
+    const result = grantShare(store, actor, resourceType, req.params.id, target.id, role);
+    res.status(201).json(shareView(store, result));
+  });
+
+  router.put(['/share/:userId', '/shares/:userId', '/permissions/:userId'], (req, res) => {
+    const actor = currentUser(req);
+    const body = asObject(req.body);
+    const target = resolveTargetUser(store, { userId: req.params.userId });
+    const role = parseRole(body.role ?? body.permission);
+    const result = grantShare(store, actor, resourceType, req.params.id, target.id, role);
+    res.status(200).json(shareView(store, result));
+  });
+
+  router.get(['/share', '/shares', '/permissions', '/access'], (req, res) => {
+    const actor = currentUser(req);
+    requireResource(store, actor.id, resourceType, req.params.id, 'viewer');
+    res.status(200).json(accessList(store, resourceType, req.params.id));
+  });
+
+  router.delete(['/share/:userId', '/shares/:userId', '/permissions/:userId'], (req, res) => {
+    const actor = currentUser(req);
+    const target = resolveTargetUser(store, { userId: req.params.userId });
+    revokeShare(store, actor, resourceType, req.params.id, target.id);
+    res.status(204).end();
+  });
+
+  return router;
+}
+
+/** Generic `POST /share` — resource type and id travel in the body. */
+export function genericShareRoutes(store: Store): Router {
+  const router = Router();
+
+  router.post('/', (req, res) => {
+    const actor = currentUser(req);
+    const body = asObject(req.body);
+    const rawType = body.resourceType ?? body.type;
+    if (!isResourceType(rawType)) {
+      res.status(400).json({ error: "'resourceType' must be 'folder' or 'document'" });
+      return;
+    }
+    const resourceId = body.resourceId ?? body.documentId ?? body.folderId ?? body.id;
+    if (typeof resourceId !== 'string' || !resourceId) {
+      throw notFound('Resource not found');
+    }
+    const target = resolveTargetUser(store, body);
+    const role = parseRole(body.role ?? body.permission);
+    const result = grantShare(store, actor, rawType, resourceId, target.id, role);
+    res.status(201).json(shareView(store, result));
+  });
+
+  return router;
+}
diff --git a/src/serialize.ts b/src/serialize.ts
new file mode 100644
index 0000000..c969e0f
--- /dev/null
+++ b/src/serialize.ts
@@ -0,0 +1,37 @@
+import type { Store } from './store.js';
+import type { Doc, Folder, PublicUser, Role, Share } from './types.js';
+
+export interface FolderView extends Folder {
+  /** Effective role of the requesting user on this folder. */
+  role: Role | null;
+  permission: Role | null;
+}
+
+export interface DocumentView extends Doc {
+  role: Role | null;
+  permission: Role | null;
+}
+
+export interface ShareView extends Share {
+  username: string | null;
+}
+
+export function folderView(folder: Folder, role: Role | null): FolderView {
+  return { ...folder, role, permission: role };
+}
+
+export function documentView(doc: Doc, role: Role | null): DocumentView {
+  return { ...doc, role, permission: role };
+}
+
+export function shareView(store: Store, share: Share): ShareView {
+  return { ...share, username: store.users.get(share.userId)?.username ?? null };
+}
+
+export function publicUsers(store: Store): PublicUser[] {
+  return [...store.users.values()].map((u) => ({
+    id: u.id,
+    username: u.username,
+    createdAt: u.createdAt,
+  }));
+}
diff --git a/src/sharing.ts b/src/sharing.ts
new file mode 100644
index 0000000..ee45b4d
--- /dev/null
+++ b/src/sharing.ts
@@ -0,0 +1,131 @@
+import { badRequest, forbidden, notFound } from './errors.js';
+import { effectiveRole, requireResource } from './permissions.js';
+import type { Store } from './store.js';
+import { atLeast, isRole, type ResourceType, type Role, type Share, type User } from './types.js';
+
+/** Resolves the share target from `userId` / `username` (either spelling is accepted). */
+export function resolveTargetUser(store: Store, body: Record<string, unknown>): User {
+  const idLike = body.userId ?? body.targetUserId ?? body.user ?? body.id;
+  if (typeof idLike === 'string' && idLike.trim()) {
+    const user = store.users.get(idLike.trim());
+    if (user) return user;
+    const byName = store.findUserByUsername(idLike.trim());
+    if (byName) return byName;
+    throw notFound('Target user not found');
+  }
+  const nameLike = body.username ?? body.targetUsername;
+  if (typeof nameLike === 'string' && nameLike.trim()) {
+    const user = store.findUserByUsername(nameLike.trim());
+    if (user) return user;
+    throw notFound('Target user not found');
+  }
+  throw badRequest("'userId' (or 'username') is required");
+}
+
+export function parseRole(value: unknown): Role {
+  if (!isRole(value)) {
+    throw badRequest("'role' must be one of: viewer, editor, owner");
+  }
+  return value;
+}
+
+function resourceCreatorId(store: Store, resourceType: ResourceType, resourceId: string): string {
+  const resource =
+    resourceType === 'folder' ? store.folders.get(resourceId) : store.documents.get(resourceId);
+  if (!resource) throw notFound(`${resourceType === 'folder' ? 'Folder' : 'Document'} not found`);
+  return resource.ownerId;
+}
+
+/**
+ * Grants (or updates) a role for `targetUserId` on a resource.
+ *
+ * Editors may share, but only owners may hand out the `owner` role or change
+ * the role of an existing owner.
+ */
+export function grantShare(
+  store: Store,
+  actor: User,
+  resourceType: ResourceType,
+  resourceId: string,
+  targetUserId: string,
+  role: Role,
+): Share {
+  const actorRole = requireResource(store, actor.id, resourceType, resourceId, 'editor');
+
+  if (role === 'owner' && actorRole !== 'owner') {
+    throw forbidden("Only an owner can grant the 'owner' role");
+  }
+  const existing = store.getShare(resourceType, resourceId, targetUserId);
+  if (existing?.role === 'owner' && actorRole !== 'owner') {
+    throw forbidden("Only an owner can change another owner's role");
+  }
+  if (targetUserId === resourceCreatorId(store, resourceType, resourceId) && role !== 'owner') {
+    throw badRequest('The creator of a resource cannot be demoted');
+  }
+
+  const share = store.setShare(resourceType, resourceId, targetUserId, role, actor.id);
+  store.log('share.grant', actor.id, resourceType, resourceId, {
+    targetUserId,
+    role,
+  });
+  return share;
+}
+
+export function revokeShare(
+  store: Store,
+  actor: User,
+  resourceType: ResourceType,
+  resourceId: string,
+  targetUserId: string,
+): void {
+  requireResource(store, actor.id, resourceType, resourceId, 'owner');
+
+  if (targetUserId === resourceCreatorId(store, resourceType, resourceId)) {
+    throw badRequest("The creator's ownership cannot be revoked");
+  }
+  if (!store.removeShare(resourceType, resourceId, targetUserId)) {
+    throw notFound('No direct share exists for that user on this resource');
+  }
+  store.log('share.revoke', actor.id, resourceType, resourceId, { targetUserId });
+}
+
+/**
+ * Everyone with access to a resource: direct shares first, then anything
+ * inherited from parent folders (reported with `inherited: true`).
+ */
+export function accessList(
+  store: Store,
+  resourceType: ResourceType,
+  resourceId: string,
+): Array<Share & { inherited: boolean; effectiveRole: Role }> {
+  const direct = new Map(
+    store.listShares(resourceType, resourceId).map((s) => [s.userId, s] as const),
+  );
+  const result: Array<Share & { inherited: boolean; effectiveRole: Role }> = [];
+  const seen = new Set<string>();
+
+  for (const share of direct.values()) {
+    seen.add(share.userId);
+    result.push({
+      ...share,
+      inherited: false,
+      effectiveRole: effectiveRole(store, share.userId, resourceType, resourceId) ?? share.role,
+    });
+  }
+  for (const user of store.users.values()) {
+    if (seen.has(user.id)) continue;
+    const role = effectiveRole(store, user.id, resourceType, resourceId);
+    if (!atLeast(role, 'viewer')) continue;
+    result.push({
+      resourceType,
+      resourceId,
+      userId: user.id,
+      role: role as Role,
+      grantedBy: user.id,
+      grantedAt: user.createdAt,
+      inherited: true,
+      effectiveRole: role as Role,
+    });
+  }
+  return result;
+}
diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..be0113a
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,217 @@
+import { randomUUID, randomBytes, scryptSync, timingSafeEqual } from 'node:crypto';
+import type {
+  ActivityAction,
+  ActivityEntry,
+  Doc,
+  Folder,
+  ResourceType,
+  Role,
+  Share,
+  User,
+} from './types.js';
+
+function shareKey(resourceType: ResourceType, resourceId: string): string {
+  return `${resourceType}:${resourceId}`;
+}
+
+function now(): string {
+  return new Date().toISOString();
+}
+
+/**
+ * In-memory database. A fresh instance is created per `createApp()` call so that
+ * tests (and server restarts) always start from a clean slate.
+ */
+export class Store {
+  readonly users = new Map<string, User>();
+  readonly usersByUsername = new Map<string, User>();
+  readonly tokens = new Map<string, string>();
+  readonly folders = new Map<string, Folder>();
+  readonly documents = new Map<string, Doc>();
+  /** `${resourceType}:${resourceId}` -> userId -> share */
+  readonly shares = new Map<string, Map<string, Share>>();
+  readonly activity: ActivityEntry[] = [];
+
+  // ---------------------------------------------------------------- users
+
+  createUser(username: string, password: string): User {
+    const salt = randomBytes(16).toString('hex');
+    const user: User = {
+      id: randomUUID(),
+      username,
+      salt,
+      passwordHash: scryptSync(password, salt, 64).toString('hex'),
+      createdAt: now(),
+    };
+    this.users.set(user.id, user);
+    this.usersByUsername.set(username.toLowerCase(), user);
+    return user;
+  }
+
+  findUserByUsername(username: string): User | undefined {
+    return this.usersByUsername.get(username.toLowerCase());
+  }
+
+  verifyPassword(user: User, password: string): boolean {
+    const candidate = scryptSync(password, user.salt, 64);
+    const expected = Buffer.from(user.passwordHash, 'hex');
+    return candidate.length === expected.length && timingSafeEqual(candidate, expected);
+  }
+
+  issueToken(user: User): string {
+    const token = randomBytes(32).toString('hex');
+    this.tokens.set(token, user.id);
+    return token;
+  }
+
+  userForToken(token: string): User | undefined {
+    const userId = this.tokens.get(token);
+    return userId ? this.users.get(userId) : undefined;
+  }
+
+  revokeToken(token: string): void {
+    this.tokens.delete(token);
+  }
+
+  // -------------------------------------------------------------- folders
+
+  createFolder(name: string, parentId: string | null, ownerId: string): Folder {
+    const timestamp = now();
+    const folder: Folder = {
+      id: randomUUID(),
+      name,
+      parentId,
+      ownerId,
+      createdAt: timestamp,
+      updatedAt: timestamp,
+    };
+    this.folders.set(folder.id, folder);
+    this.setShare('folder', folder.id, ownerId, 'owner', ownerId);
+    return folder;
+  }
+
+  childFolders(parentId: string | null): Folder[] {
+    return [...this.folders.values()].filter((f) => f.parentId === parentId);
+  }
+
+  /** Walks up the parent chain, returning [folder, parent, grandparent, ...]. */
+  ancestorChain(folderId: string | null): Folder[] {
+    const chain: Folder[] = [];
+    const seen = new Set<string>();
+    let current = folderId;
+    while (current && !seen.has(current)) {
+      seen.add(current);
+      const folder = this.folders.get(current);
+      if (!folder) break;
+      chain.push(folder);
+      current = folder.parentId;
+    }
+    return chain;
+  }
+
+  /** The folder plus every folder nested beneath it, deepest last. */
+  subtree(folderId: string): Folder[] {
+    const root = this.folders.get(folderId);
+    if (!root) return [];
+    const result: Folder[] = [root];
+    const queue = [folderId];
+    const seen = new Set<string>(queue);
+    while (queue.length) {
+      const parentId = queue.shift() as string;
+      for (const child of this.childFolders(parentId)) {
+        if (seen.has(child.id)) continue;
+        seen.add(child.id);
+        result.push(child);
+        queue.push(child.id);
+      }
+    }
+    return result;
+  }
+
+  // ------------------------------------------------------------ documents
+
+  createDocument(title: string, content: string, folderId: string, ownerId: string): Doc {
+    const timestamp = now();
+    const doc: Doc = {
+      id: randomUUID(),
+      title,
+      content,
+      folderId,
+      ownerId,
+      createdAt: timestamp,
+      updatedAt: timestamp,
+    };
+    this.documents.set(doc.id, doc);
+    this.setShare('document', doc.id, ownerId, 'owner', ownerId);
+    return doc;
+  }
+
+  documentsInFolder(folderId: string): Doc[] {
+    return [...this.documents.values()].filter((d) => d.folderId === folderId);
+  }
+
+  // --------------------------------------------------------------- shares
+
+  setShare(
+    resourceType: ResourceType,
+    resourceId: string,
+    userId: string,
+    role: Role,
+    grantedBy: string,
+  ): Share {
+    const key = shareKey(resourceType, resourceId);
+    let bucket = this.shares.get(key);
+    if (!bucket) {
+      bucket = new Map<string, Share>();
+      this.shares.set(key, bucket);
+    }
+    const share: Share = {
+      resourceType,
+      resourceId,
+      userId,
+      role,
+      grantedBy,
+      grantedAt: now(),
+    };
+    bucket.set(userId, share);
+    return share;
+  }
+
+  getShare(resourceType: ResourceType, resourceId: string, userId: string): Share | undefined {
+    return this.shares.get(shareKey(resourceType, resourceId))?.get(userId);
+  }
+
+  listShares(resourceType: ResourceType, resourceId: string): Share[] {
+    return [...(this.shares.get(shareKey(resourceType, resourceId))?.values() ?? [])];
+  }
+
+  removeShare(resourceType: ResourceType, resourceId: string, userId: string): boolean {
+    return this.shares.get(shareKey(resourceType, resourceId))?.delete(userId) ?? false;
+  }
+
+  removeAllShares(resourceType: ResourceType, resourceId: string): void {
+    this.shares.delete(shareKey(resourceType, resourceId));
+  }
+
+  // ------------------------------------------------------------- activity
+
+  log(
+    action: ActivityAction,
+    userId: string,
+    resourceType: ResourceType,
+    resourceId: string,
+    details?: Record<string, unknown>,
+  ): ActivityEntry {
+    const entry: ActivityEntry = {
+      id: randomUUID(),
+      action,
+      userId,
+      resourceType,
+      resourceId,
+      timestamp: now(),
+      ...(details ? { details } : {}),
+    };
+    this.activity.push(entry);
+    return entry;
+  }
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..2d76c22
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,98 @@
+export type Role = 'viewer' | 'editor' | 'owner';
+
+export type ResourceType = 'folder' | 'document';
+
+/** Higher rank == more permissive. Used to merge roles granted through multiple paths. */
+export const ROLE_RANK: Record<Role, number> = {
+  viewer: 1,
+  editor: 2,
+  owner: 3,
+};
+
+export const ROLES: Role[] = ['viewer', 'editor', 'owner'];
+
+export function isRole(value: unknown): value is Role {
+  return typeof value === 'string' && (ROLES as string[]).includes(value);
+}
+
+export function isResourceType(value: unknown): value is ResourceType {
+  return value === 'folder' || value === 'document';
+}
+
+/** Returns the more permissive of two roles. */
+export function maxRole(a: Role | null, b: Role | null): Role | null {
+  if (!a) return b;
+  if (!b) return a;
+  return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;
+}
+
+export function atLeast(role: Role | null, required: Role): boolean {
+  return role !== null && ROLE_RANK[role] >= ROLE_RANK[required];
+}
+
+export interface User {
+  id: string;
+  username: string;
+  passwordHash: string;
+  salt: string;
+  createdAt: string;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface Doc {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface Share {
+  resourceType: ResourceType;
+  resourceId: string;
+  userId: string;
+  role: Role;
+  grantedBy: string;
+  grantedAt: string;
+}
+
+export type ActivityAction =
+  | 'folder.create'
+  | 'folder.update'
+  | 'folder.delete'
+  | 'document.create'
+  | 'document.update'
+  | 'document.delete'
+  | 'share.grant'
+  | 'share.revoke';
+
+export interface ActivityEntry {
+  id: string;
+  action: ActivityAction;
+  userId: string;
+  resourceType: ResourceType;
+  resourceId: string;
+  details?: Record<string, unknown>;
+  timestamp: string;
+}
+
+/** Public shape of a user (never leaks credentials). */
+export interface PublicUser {
+  id: string;
+  username: string;
+  createdAt: string;
+}
+
+export function toPublicUser(user: User): PublicUser {
+  return { id: user.id, username: user.username, createdAt: user.createdAt };
+}
diff --git a/src/validate.ts b/src/validate.ts
new file mode 100644
index 0000000..34e107a
--- /dev/null
+++ b/src/validate.ts
@@ -0,0 +1,50 @@
+import { badRequest } from './errors.js';
+
+export function asObject(body: unknown): Record<string, unknown> {
+  if (body && typeof body === 'object' && !Array.isArray(body)) {
+    return body as Record<string, unknown>;
+  }
+  return {};
+}
+
+export function requiredString(
+  body: Record<string, unknown>,
+  field: string,
+  opts: { maxLength?: number; allowEmpty?: boolean } = {},
+): string {
+  const value = body[field];
+  if (typeof value !== 'string') {
+    throw badRequest(`'${field}' is required and must be a string`);
+  }
+  const trimmed = opts.allowEmpty ? value : value.trim();
+  if (!opts.allowEmpty && trimmed.length === 0) {
+    throw badRequest(`'${field}' must not be empty`);
+  }
+  if (opts.maxLength && trimmed.length > opts.maxLength) {
+    throw badRequest(`'${field}' must be at most ${opts.maxLength} characters`);
+  }
+  return trimmed;
+}
+
+export function optionalString(
+  body: Record<string, unknown>,
+  field: string,
+  opts: { maxLength?: number; allowEmpty?: boolean } = {},
+): string | undefined {
+  if (body[field] === undefined) return undefined;
+  return requiredString(body, field, opts);
+}
+
+/** Reads a nullable id field: `undefined` when absent, `null` when explicitly null. */
+export function optionalId(
+  body: Record<string, unknown>,
+  field: string,
+): string | null | undefined {
+  const value = body[field];
+  if (value === undefined) return undefined;
+  if (value === null || value === '') return null;
+  if (typeof value !== 'string') {
+    throw badRequest(`'${field}' must be a string id or null`);
+  }
+  return value;
+}
diff --git a/tests/activity.test.ts b/tests/activity.test.ts
new file mode 100644
index 0000000..7c415d8
