+++ b/tests/activity.test.ts
@@ -0,0 +1,97 @@
+import { describe, expect, it } from 'vitest';
+import { as, createDocument, createFolder, newApp, register } from './helpers.js';
+
+interface Entry {
+  action: string;
+  userId: string;
+  resourceType: string;
+  resourceId: string;
+  timestamp: string;
+}
+
+describe('activity log', () => {
+  it('records document lifecycle events with actor, target and timestamp', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const folder = await createFolder(app, alice, 'Root');
+    const doc = await createDocument(app, alice, folder, 'Title');
+    await as(app, alice).patch(`/documents/${doc}`).send({ content: 'v2' });
+    await as(app, alice).delete(`/documents/${doc}`);
+
+    const res = await as(app, alice).get('/activity');
+    expect(res.status).toBe(200);
+    const entries: Entry[] = res.body;
+    const forDoc = entries.filter((e) => e.resourceId === doc);
+
+    expect(forDoc.map((e) => e.action)).toEqual([
+      'document.create',
+      'document.update',
+      'document.delete',
+    ]);
+    for (const entry of forDoc) {
+      expect(entry.userId).toBe(alice.id);
+      expect(entry.resourceType).toBe('document');
+      expect(Number.isNaN(Date.parse(entry.timestamp))).toBe(false);
+    }
+  });
+
+  it('records sharing events', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const folder = await createFolder(app, alice, 'Root');
+    const doc = await createDocument(app, alice, folder);
