diff --git a/src/permissions.ts b/src/permissions.ts
new file mode 100644
index 0000000..b912ac6
--- /dev/null
+++ b/src/permissions.ts
@@ -0,0 +1,107 @@
+import { forbidden, notFound } from './errors.js';
+import type { Store } from './store.js';
+import { atLeast, maxRole, type Doc, type Folder, type ResourceType, type Role } from './types.js';
+
+/**
+ * Effective role of a user on a folder: the most permissive role granted either
+ * directly on the folder or on any of its ancestors (permissions are inherited
+ * downwards through the folder hierarchy).
+ */
+export function folderRole(store: Store, userId: string, folderId: string): Role | null {
+  let role: Role | null = null;
+  for (const folder of store.ancestorChain(folderId)) {
+    role = maxRole(role, store.getShare('folder', folder.id, userId)?.role ?? null);
+    if (role === 'owner') break;
+  }
+  return role;
+}
+
+/**
+ * Effective role of a user on a document: the most permissive of the direct
+ * share on the document and anything inherited from its folder chain.
+ */
+export function documentRole(store: Store, userId: string, doc: Doc): Role | null {
+  const direct = store.getShare('document', doc.id, userId)?.role ?? null;
+  if (direct === 'owner') return 'owner';
+  return maxRole(direct, folderRole(store, userId, doc.folderId));
+}
+
+export function effectiveRole(
+  store: Store,
+  userId: string,
+  resourceType: ResourceType,
+  resourceId: string,
+): Role | null {
+  if (resourceType === 'folder') {
+    return store.folders.has(resourceId) ? folderRole(store, userId, resourceId) : null;
+  }
+  const doc = store.documents.get(resourceId);
+  return doc ? documentRole(store, userId, doc) : null;
+}
+
+export function canRead(
+  store: Store,
+  userId: string,
+  resourceType: ResourceType,
+  resourceId: string,
+): boolean {
+  return atLeast(effectiveRole(store, userId, resourceType, resourceId), 'viewer');
+}
+
+/**
+ * Loads a folder and asserts the caller holds at least `required` on it.
+ * Throws 404 when the folder does not exist, 403 when access is insufficient.
+ */
+export function requireFolder(
+  store: Store,
+  userId: string,
+  folderId: string,
+  required: Role,
+): { folder: Folder; role: Role } {
+  const folder = store.folders.get(folderId);
+  if (!folder) throw notFound('Folder not found');
+  const role = folderRole(store, userId, folderId);
+  if (!atLeast(role, required)) {
+    throw forbidden(`This action requires the '${required}' role on the folder`);
+  }
+  return { folder, role: role as Role };
+}
+
+export function requireDocument(
+  store: Store,
+  userId: string,
+  documentId: string,
+  required: Role,
+): { doc: Doc; role: Role } {
+  const doc = store.documents.get(documentId);
+  if (!doc) throw notFound('Document not found');
+  const role = documentRole(store, userId, doc);
+  if (!atLeast(role, required)) {
+    throw forbidden(`This action requires the '${required}' role on the document`);
+  }
+  return { doc, role: role as Role };
+}
+
+export function requireResource(
+  store: Store,
+  userId: string,
+  resourceType: ResourceType,
+  resourceId: string,
+  required: Role,
+): Role {
+  return resourceType === 'folder'
+    ? requireFolder(store, userId, resourceId, required).role
+    : requireDocument(store, userId, resourceId, required).role;
+}
+
+/** Every folder the user can at least read. */
+export function readableFolders(store: Store, userId: string): Folder[] {
+  return [...store.folders.values()].filter((f) => atLeast(folderRole(store, userId, f.id), 'viewer'));
+}
+
+/** Every document the user can at least read. */
+export function readableDocuments(store: Store, userId: string): Doc[] {
+  return [...store.documents.values()].filter((d) =>
+    atLeast(documentRole(store, userId, d), 'viewer'),
+  );
+}
