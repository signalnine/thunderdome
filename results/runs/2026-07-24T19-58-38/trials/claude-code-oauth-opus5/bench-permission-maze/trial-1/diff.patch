+++ b/tests/helpers.ts
@@ -0,0 +1,58 @@
+import request from 'supertest';
+import type { Express } from 'express';
+import { createApp } from '../src/app.js';
+
+export interface TestUser {
+  id: string;
+  username: string;
+  token: string;
+}
+
+export function newApp(): Express {
+  return createApp();
+}
+
+export async function register(app: Express, username: string): Promise<TestUser> {
+  const res = await request(app)
+    .post('/auth/register')
+    .send({ username, password: 'password123' });
+  if (res.status !== 201) {
+    throw new Error(`register(${username}) failed: ${res.status} ${JSON.stringify(res.body)}`);
+  }
+  return { id: res.body.id, username, token: res.body.token };
+}
+
+export const as = (app: Express, user: TestUser) => ({
+  get: (url: string) => request(app).get(url).set('Authorization', `Bearer ${user.token}`),
+  post: (url: string) => request(app).post(url).set('Authorization', `Bearer ${user.token}`),
+  patch: (url: string) => request(app).patch(url).set('Authorization', `Bearer ${user.token}`),
+  put: (url: string) => request(app).put(url).set('Authorization', `Bearer ${user.token}`),
+  delete: (url: string) => request(app).delete(url).set('Authorization', `Bearer ${user.token}`),
+});
+
+export async function createFolder(
+  app: Express,
+  user: TestUser,
+  name: string,
+  parentId?: string,
+): Promise<string> {
+  const res = await as(app, user).post('/folders').send({ name, parentId });
+  if (res.status !== 201) {
+    throw new Error(`createFolder failed: ${res.status} ${JSON.stringify(res.body)}`);
+  }
+  return res.body.id;
+}
+
+export async function createDocument(
+  app: Express,
+  user: TestUser,
+  folderId: string,
+  title = 'Doc',
+  content = 'hello',
+): Promise<string> {
+  const res = await as(app, user).post('/documents').send({ title, content, folderId });
+  if (res.status !== 201) {
+    throw new Error(`createDocument failed: ${res.status} ${JSON.stringify(res.body)}`);
+  }
+  return res.body.id;
+}
