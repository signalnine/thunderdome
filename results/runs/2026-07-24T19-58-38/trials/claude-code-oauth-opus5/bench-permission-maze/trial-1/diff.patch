+    expect((await as(app, alice).delete(`/documents/${doc}/share/${bob.id}`)).status).toBe(204);
+    expect((await as(app, bob).get(`/documents/${doc}`)).status).toBe(403);
+
+    // The creator's ownership cannot be revoked.
+    expect((await as(app, alice).delete(`/documents/${doc}/share/${alice.id}`)).status).toBe(400);
+  });
+
+  it('supports the generic /share endpoint', async () => {
+    const app = newApp();
+    const alice = await register(app, 'alice');
+    const bob = await register(app, 'bob');
+    const folder = await createFolder(app, alice, 'Root');
+
+    const res = await as(app, alice).post('/share').send({
+      resourceType: 'folder',
+      resourceId: folder,
+      userId: bob.id,
+      role: 'viewer',
