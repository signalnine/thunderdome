.toBe(97.2);\n    27\t  });\n    28\t\n    29\t  it('handles multiple items with discount and tax', () => {\n    30\t    const result = calculateOrderTotal(\n    31\t      [\n    32\t        { productId: 'A', quantity: 3, unitPrice: 29.99 },\n    33\t        { productId: 'B', quantity: 1, unitPrice: 49.99 },\n    34\t      ],\n    35\t      15,\n    36\t      0.1\n    37\t    );\n    38\t    // subtotal = 3*29.99 + 49.99 = 139.96\n    39\t    // discount = 139.96 * 0.15 = 20.994\n    40\t    // after discount = 118.966\n    41\t    // tax = 118.966 * 0.1 = 11.8966\n    42\t    // total = 130.8626 -> rounded to 130.86\n    43\t    expect(result.total).toBe(130.86);\n    44\t  });\n    45\t\n    46\t  it('rounds correctly for penny-edge amounts', () => {\n    47\t    // This specifically tests that we don't double-round\n    48\t    const result = calculateOrderTotal(\n    49\t      [{ productId: 'A', quantity: 1, unitPrice: 33.33 }],\n    50\t      5,\n    51\t      0.07\n    52\t    );\n    53\t    // subtotal = 33.33\n    54\t    // discount = 33.33 * 0.05 = 1.6665\n    55\t    // after discount = 31.6635\n    56\t    // tax = 31.6635 * 0.07 = 2.21644...\n    57\t    // total = 33.87994... -> 33.88\n    58\t    expect(result.total).toBe(33.88);\n    59\t  });\n    60\t});\n    61\t\n    62\tdescribe('BillingService', () => {\n    63\t  let bus: EventBus;\n    64\t  let notifications: NotificationService;\n    65\t  let billing: BillingService;\n    66\t\n    67\t  beforeEach(() => {\n    68\t    bus = new EventBus();\n    69\t    notifications = new NotificationService();\n    70\t    billing = new BillingService(bus, notifications);\n    71\t    billing.registerHandlers();\n    72\t  });\n    73\t\n    74\t  it('charges payment and records it', async () => {\n    75\t    const record = await billing.chargePayment(\n    76\t      'O1',\n    77\t      [{ productId: 'A', quantity: 1, unitPrice: 100 }],\n    78\t      0,\n    79\t      0.1,\n    80\t      'card'\n    81\t    );\n    82\t    expect(record.amount).toBe(110);\n    83\t    expect(record.status).toBe('charged');\n    84\t    expect(record.method).toBe('card');\n    85\t  });\n    86\t\n    87\t  it('sends confirmation notification on charge', async () => {\n    88\t    await billing.chargePayment(\n    89\t      'O1',\n    90\t      [{ productId: 'A', quantity: 1, unitPrice: 100 }],\n    91\t      0,\n    92\t      0.1,\n    93\t      'card'\n    94\t    );\n    95\t    const sent = notifications.getSentNotifications();\n    96\t    expect(sent).toHaveLength(1);\n    97\t    expect(sent[0].type).toBe('confirmation');\n    98\t    expect(sent[0].message).toContain('O1');\n    99\t  });\n   100\t\n   101\t  it('issues refund and updates payment status', async () => {\n   102\t    await billing.chargePayment(\n   103\t      'O1',\n   104\t      [{ productId: 'A', quantity: 1, unitPrice: 50 }],\n   105\t      0,\n   106\t      0,\n   107\t      'card'\n   108\t    );\n   109\t    const refund = await billing.issueRefund('O1', 50);\n   110\t    expect(refund?.status).toBe('refunded');\n   111\t  });\n   112\t\n   113\t  it('sends refund notification', async () => {\n   114\t    await billing.chargePayment(\n   115\t      'O1',\n   116\t      [{ productId: 'A', quantity: 1, unitPrice: 50 }],\n   117\t      0,\n   118\t      0,\n   119\t      'card'\n   120\t    );\n   121\t    await billing.issueRefund('O1', 50);\n   122\t    const sent = notifications.getSentNotifications();\n   123\t    const refundNotice = sent.find((n) => n.type === 'refund');\n   124\t    expect(refundNotice).toBeDefined();\n   125\t    expect(refundNotice!.message).toContain('50.00');\n   126\t  });\n   127\t});\n=== tests/events.test.ts ===\n     1\timport { describe, it, expect, beforeEach } from 'vitest';\n     2\timport { EventBus } from '../src/events/bus.js';\n     3\t\n     4\tdescribe('EventBus', () => {\n     5\t  let bus: EventBus;\n     6\t\n     7\t  beforeEach(() => {\n     8\t    bus = new EventBus();\n     9\t  });\n    10\t\n    11\t  it('emits events to registered handlers', async () => {\n    12\t    const received: unknown[] = [];\n    13\t    bus.on('test', (data) => { received.push(data); });\n    14\t    await bus.emit('test', { value: 1 });\n    15\t    expect(received).toEqual([{ value: 1 }]);\n    16\t  });\n    17\t\n    18\t  it('supports multiple handlers for same event', async () => {\n    19\t    let count = 0;\n    20\t    bus.on('test', () => { count++; });\n    21\t    bus.on('test', () => { count++; });\n    22\t    await bus.emit('test', {});\n    23\t    expect(count).toBe(2);\n    24\t  });\n    25\t\n    26\t  it('does not fire handlers for different events', async () => {\n    27\t    let called = false;\n    28\t    bus.on('other', () => { called = true; });\n    29\t    await bus.emit('test', {});\n    30\t    expect(called).toBe(false);\n    31\t  });\n    32\t\n    33\t  it('removes handlers with off()', async () => {\n    34\t    let count = 0;\n    35\t    const handler = () => { count++; };\n    36\t    bus.on('test', handler);\n    37\t    bus.off('test', handler);\n    38\t    await bus.emit('test', {});\n    39\t    expect(count).toBe(0);\n    40\t  });\n    41\t\n    42\t  it('clears all handlers', async () => {\n    43\t    let count = 0;\n    44\t    bus.on('a', () => { count++; });\n    45\t    bus.on('b', () => { count++; });\n    46\t    bus.clear();\n    47\t    await bus.emit('a', {});\n    48\t    await bus.emit('b', {});\n    49\t    expect(count).toBe(0);\n    50\t  });\n    51\t});\n=== tests/inventory.test.ts ===\n     1\timport { describe, it, expect, beforeEach } from 'vitest';\n     2\timport { EventBus } from '../src/events/bus.js';\n     3\timport { InventoryRepository } from '../src/inventory/repository.js';\n     4\timport { InventoryService } from '../src/inventory/service.js';\n     5\timport { ORDER_EVENTS } from '../src/events/types.js';\n     6\t\n     7\tdescribe('InventoryService', () => {\n     8\t  let bus: EventBus;\n     9\t  let repo: InventoryRepository;\n    10\t  let service: InventoryService;\n    11\t\n    12\t  beforeEach(() => {\n    13\t    bus = new EventBus();\n    14\t    repo = new InventoryRepository();\n    15\t    service = new InventoryService(repo, bus);\n    16\t    service.registerHandlers();\n    17\t  });\n    18\t\n    19\t  it('reserves stock on order.created', async () => {\n    20\t    service.setStock('SKU-1', 10);\n    21\t    await bus.emit(ORDER_EVENTS.CREATED, {\n    22\t      orderId: 'O1',\n    23\t      items: [{ productId: 'SKU-1', quantity: 3, unitPrice: 10 }],\n    24\t      customerId: 'C1',\n    25\t      timestamp: Date.now(),\n    26\t    });\n    27\t    const stock = service.getStock('SKU-1');\n    28\t    expect(stock?.available).toBe(7);\n    29\t    expect(stock?.reserved).toBe(3);\n    30\t  });\n    31\t\n    32\t  it('throws when stock is insufficient', async () => {\n    33\t    service.setStock('SKU-1', 2);\n    34\t    await expect(\n    35\t      bus.emit(ORDER_EVENTS.CREATED, {\n    36\t        orderId: 'O1',\n    37\t        items: [{ productId: 'SKU-1', quantity: 5, unitPrice: 10 }],\n    38\t        customerId: 'C1',\n    39\t        timestamp: Date.now(),\n    40\t      })\n    41\t    ).rejects.toThrow('Insufficient stock');\n    42\t  });\n    43\t\n    44\t  it('rolls back partial reservations on failure', async () => {\n    45\t    service.setStock('SKU-1', 10);\n    46\t    service.setStock('SKU-2', 1);\n    47\t    try {\n    48\t      await bus.emit(ORDER_EVENTS.CREATED, {\n    49\t        orderId: 'O1',\n    50\t        items: [\n    51\t          { productId: 'SKU-1', quantity: 3, unitPrice: 10 },\n    52\t          { productId: 'SKU-2', quantity: 5, unitPrice: 20 },\n    53\t        ],\n    54\t        customerId: 'C1',\n    55\t        timestamp: Date.now(),\n    56\t      });\n    57\t    } catch { /* expected */ }\n    58\t    const stock1 = service.getStock('SKU-1');\n    59\t    expect(stock1?.available).toBe(10);\n    60\t    expect(stock1?.reserved).toBe(0);\n    61\t  });\n    62\t\n    63\t  it('releases stock on order.cancelled', async () => {\n    64\t    service.setStock('SKU-1', 10);\n    65\t    // First reserve\n    66\t    await bus.emit(ORDER_EVENTS.CREATED, {\n    67\t      orderId: 'O1',\n    68\t      items: [{ productId: 'SKU-1', quantity: 3, unitPrice: 10 }],\n    69\t      customerId: 'C1',\n    70\t      timestamp: Date.now(),\n    71\t    });\n    72\t    // Then cancel\n    73\t    await bus.emit(ORDER_EVENTS.CANCELLED, {\n    74\t      orderId: 'O1',\n    75\t      reason: 'changed mind',\n    76\t      status: 'cancelled',\n    77\t      items: [{ productId: 'SKU-1', quantity: 3 }],\n    78\t      timestamp: Date.now(),\n    79\t    });\n    80\t    const stock = service.getStock('SKU-1');\n    81\t    expect(stock?.available).toBe(10);\n    82\t    expect(stock?.reserved).toBe(0);\n    83\t  });\n    84\t\n    85\t  it('reserves stock for concurrent orders independently', async () => {\n    86\t    service.setStock('SKU-1', 20);\n    87\t    await bus.emit(ORDER_EVENTS.CREATED, {\n    88\t      orderId: 'O1',\n    89\t      items: [{ productId: 'SKU-1', quantity: 5, unitPrice: 10 }],\n    90\t      customerId: 'C1',\n    91\t      timestamp: Date.now(),\n    92\t    });\n    93\t    await bus.emit(ORDER_EVENTS.CREATED, {\n    94\t      orderId: 'O2',\n    95\t      items: [{ productId: 'SKU-1', quantity: 3, unitPrice: 10 }],\n    96\t      customerId: 'C2',\n    97\t      timestamp: Date.now(),\n    98\t    });\n    99\t    const stock = service.getStock('SKU-1');\n   100\t    expect(stock?.available).toBe(12);\n   101\t    expect(stock?.reserved).toBe(8);\n   102\t  });\n   103\t});\n=== tests/notifications.test.ts ===\n     1\timport { describe, it, expect, beforeEach } from 'vitest';\n     2\timport { NotificationService } from '../src/notifications/service.js';\n     3\t\n     4\tdescribe('NotificationService', () => {\n     5\t  let service: NotificationService;\n     6\t\n     7\t  beforeEach(() => {\n     8\t    service = new NotificationService();\n     9\t  });\n    10\t\n    11\t  it('sends order confirmation', () => {\n    12\t    const record = service.sendConfirmation('O1', 99.99);\n    13\t    expect(record.type).toBe('confirmation');\n    14\t    expect(record.message).toContain('O1');\n    15\t    expect(record.message).toContain('99.99');\n    16\t  });\n    17\t\n    18\t  it('sends cancellation notice', () => {\n    19\t    const record = service.sendCancellation('O1', 'changed mind');\n    20\t    expect(record.type).toBe('cancellation');\n    21\t    expect(record.message).toContain('changed mind');\n    22\t  });\n    23\t\n    24\t  it('sends refund notice', () => {\n    25\t    const record = service.sendRefundNotice('O1', 50.00);\n    26\t    expect(record.type).toBe('refund');\n    27\t    expect(record.message).toContain('50.00');\n    28\t  });\n    29\t\n    30\t  it('tracks all sent notifications', () => {\n    31\t    service.sendConfirmation('O1', 100);\n    32\t    service.sendCancellation('O2', 'duplicate');\n    33\t    service.sendRefundNotice('O3', 75);\n    34\t    expect(service.getSentNotifications()).toHaveLength(3);\n    35\t  });\n    36\t});\n=== tests/orders.test.ts ===\n     1\timport { describe, it, expect, beforeEach } from 'vitest';\n     2\timport { EventBus } from '../src/events/bus.js';\n     3\timport { OrderRepository } from '../src/orders/repository.js';\n     4\timport { OrderService } from '../src/orders/service.js';\n     5\timport { InventoryRepository } from '../src/inventory/repository.js';\n     6\timport { InventoryService } from '../src/inventory/service.js';\n     7\timport { NotificationService } from '../src/notifications/service.js';\n     8\timport { BillingService } from '../src/billing/service.js';\n     9\t\n    10\tdescribe('OrderService', () => {\n    11\t  let bus: EventBus;\n    12\t  let orderRepo: OrderRepository;\n    13\t  let inventoryRepo: InventoryRepository;\n    14\t  let inventoryService: InventoryService;\n    15\t  let notifications: NotificationService;\n    16\t  let billing: BillingService;\n    17\t  let orderService: OrderService;\n    18\t\n    19\t  beforeEach(() => {\n    20\t    bus = new EventBus();\n    21\t    orderRepo = new OrderRepository();\n    22\t    inventoryRepo = new InventoryRepository();\n    23\t    inventoryService = new InventoryService(inventoryRepo, bus);\n    24\t    notifications = new NotificationService();\n    25\t    billing = new BillingService(bus, notifications);\n    26\t\n    27\t    inventoryService.registerHandlers();\n    28\t    billing.registerHandlers();\n    29\t\n    30\t    orderService = new OrderService(orderRepo, bus, billing);\n    31\t  });\n    32\t\n    33\t  it('creates an order and confirms it', async () => {\n    34\t    inventoryService.setStock('SKU-1', 10);\n    35\t    const order = await orderService.createOrder('O1', 'C1', [\n    36\t      { productId: 'SKU-1', quantity: 2, unitPrice: 25 },\n    37\t    ]);\n    38\t    expect(order.status).toBe('confirmed');\n    39\t    expect(order.total).toBe(55); // 50 + 10% tax\n    40\t  });\n    41\t\n    42\t  it('reserves stock when order is created', async () => {\n    43\t    inventoryService.setStock('SKU-1', 10);\n    44\t    await orderService.createOrder('O1', 'C1', [\n    45\t      { productId: 'SKU-1', quantity: 3, unitPrice: 10 },\n    46\t    ]);\n    47\t    const stock = inventoryService.getStock('SKU-1');\n    48\t    expect(stock?.available).toBe(7);\n    49\t    expect(stock?.reserved).toBe(3);\n    50\t  });\n    51\t\n    52\t  it('cancels a confirmed order', async () => {\n    53\t    inventoryService.setStock('SKU-1', 10);\n    54\t    await orderService.createOrder('O1', 'C1', [\n    55\t      { productId: 'SKU-1', quantity: 2, unitPrice: 10 },\n    56\t    ]);\n    57\t    const cancelled = await orderService.cancelOrder('O1', 'changed mind');\n    58\t    expect(cancelled?.status).toBe('cancelled');\n    59\t  });\n    60\t\n    61\t  it('releases stock when order is cancelled', async () => {\n    62\t    inventoryService.setStock('SKU-1', 10);\n    63\t    await orderService.createOrder('O1', 'C1', [\n    64\t      { productId: 'SKU-1', quantity: 4, unitPrice: 10 },\n    65\t    ]);\n    66\t    await orderService.cancelOrder('O1', 'changed mind');\n    67\t    const stock = inventoryService.getStock('SKU-1');\n    68\t    expect(stock?.available).toBe(10);\n    69\t    expect(stock?.reserved).toBe(0);\n    70\t  });\n    71\t\n    72\t  it('refuses to cancel a non-confirmed order', async () => {\n    73\t    inventoryService.setStock('SKU-1', 10);\n    74\t    await orderService.createOrder('O1', 'C1', [\n    75\t      { productId: 'SKU-1', quantity: 1, unitPrice: 10 },\n    76\t    ]);\n    77\t    await orderService.cancelOrder('O1', 'first cancel');\n    78\t    // Try to cancel again — already cancelled\n    79\t    const result = await orderService.cancelOrder('O1', 'second cancel');\n    80\t    expect(result).toBeUndefined();\n    81\t  });\n    82\t\n    83\t  it('refunds a cancelled order within 30 days', async () => {\n    84\t    inventoryService.setStock('SKU-1', 10);\n    85\t    await orderService.createOrder('O1', 'C1', [\n    86\t      { productId: 'SKU-1', quantity: 1, unitPrice: 100 },\n    87\t    ]);\n    88\t    await orderService.cancelOrder('O1', 'not needed');\n    89\t    const refunded = await orderService.refundOrder('O1');\n    90\t    expect(refunded?.status).toBe('refunded');\n    91\t  });\n    92\t\n    93\t  it('allows refund on exactly day 30', async () => {\n    94\t    inventoryService.setStock('SKU-1', 10);\n    95\t    await orderService.createOrder('O1', 'C1', [\n    96\t      { productId: 'SKU-1', quantity: 1, unitPrice: 100 },\n    97\t    ]);\n    98\t    // Manually backdate the order to exactly 30 days ago\n    99\t    const thirtyDaysMs = 30 * 24 * 60 * 60 * 1000;\n   100\t    orderRepo.update('O1', { createdAt: Date.now() - thirtyDaysMs });\n   101\t    await orderService.cancelOrder('O1', 'late cancel');\n   102\t    const refunded = await orderService.refundOrder('O1');\n   103\t    expect(refunded?.status).toBe('refunded');\n   104\t  });\n   105\t\n   106\t  it('rejects refund after 30-day window', async () => {\n   107\t    inventoryService.setStock('SKU-1', 10);\n   108\t    await orderService.createOrder('O1', 'C1', [\n   109\t      { productId: 'SKU-1', quantity: 1, unitPrice: 100 },\n   110\t    ]);\n   111\t    // Backdate to 31 days ago\n   112\t    const thirtyOneDaysMs = 31 * 24 * 60 * 60 * 1000;\n   113\t    orderRepo.update('O1', { createdAt: Date.now() - thirtyOneDaysMs });\n   114\t    await orderService.cancelOrder('O1', 'very late');\n   115\t    await expect(orderService.refundOrder('O1')).rejects.toThrow('Refund window expired');\n   116\t  });\n   117\t});\n   118\t\n   119\tdescribe('OrderRepository', () => {\n   120\t  let repo: OrderRepository;\n   121\t\n   122\t  beforeEach(() => {\n   123\t    repo = new OrderRepository();\n   124\t  });\n   125\t\n   126\t  it('creates and retrieves an order', () => {\n   127\t    const order = repo.create({\n   128\t      id: 'O1',\n   129\t      customerId: 'C1',\n   130\t      items: [],\n   131\t      status: 'pending',\n   132\t      total: 0,\n   133\t      discount: 0,\n   134\t      taxRate: 0.1,\n   135\t      createdAt: Date.now(),\n   136\t      updatedAt: Date.now(),\n   137\t    });\n   138\t    expect(repo.findById('O1')).toEqual(order);\n   139\t  });\n   140\t\n   141\t  it('updates order preserves other fields', () => {\n   142\t    repo.create({\n   143\t      id: 'O1',\n   144\t      customerId: 'C1',\n   145\t      items: [{ productId: 'A', quantity: 1, unitPrice: 10 }],\n   146\t      status: 'pending',\n   147\t      total: 10,\n   148\t      discount: 0,\n   149\t      taxRate: 0.1,\n   150\t      createdAt: 1000,\n   151\t      updatedAt: 1000,\n   152\t      notes: 'rush delivery',\n   153\t    });\n   154\t    const updated = repo.update('O1', { status: 'confirmed' });\n   155\t    expect(updated?.status).toBe('confirmed');\n   156\t    expect(updated?.customerId).toBe('C1');\n   157\t    expect(updated?.notes).toBe('rush delivery');\n   158\t    expect(updated?.items).toHaveLength(1);\n   159\t    expect(updated?.total).toBe(10);\n   160\t  });\n   161\t\n   162\t  it('returns undefined for missing order', () => {\n   163\t    expect(repo.findById('NOPE')).toBeUndefined();\n   164\t  });\n   165\t\n   166\t  it('finds orders by customer', () => {\n   167\t    repo.create({\n   168\t      id: 'O1', customerId: 'C1', items: [], status: 'pending',\n   169\t      total: 0, discount: 0, taxRate: 0, createdAt: 0, updatedAt: 0,\n   170\t    });\n   171\t    repo.create({\n   172\t      id: 'O2', customerId: 'C2', items: [], status: 'pending',\n   173\t      total: 0, discount: 0, taxRate: 0, createdAt: 0, updatedAt: 0,\n   174\t    });\n   175\t    repo.create({\n   176\t      id: 'O3', customerId: 'C1', items: [], status: 'pending',\n   177\t      total: 0, discount: 0, taxRate: 0, createdAt: 0, updatedAt: 0,\n   178\t    });\n   179\t    expect(repo.findByCustomer('C1')).toHaveLength(2);\n   180\t  });\n   181\t});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
