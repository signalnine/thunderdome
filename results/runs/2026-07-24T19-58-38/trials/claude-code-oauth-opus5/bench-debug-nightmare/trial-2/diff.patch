;\n    39\t  }\n    40\t\n    41\t  private async handleOrderCancelled(data: unknown): Promise<void> {\n    42\t    const event = data as OrderCancelledEvent;\n    43\t    // Release reserved stock — look up original order items from the event\n    44\t    // The order service attaches items to the cancellation event\n    45\t    const eventWithItems = data as OrderCancelledEvent & {\n    46\t      items?: Array<{ productId: string; quantity: number }>;\n    47\t      status?: string;\n    48\t    };\n    49\t\n    50\t    if (eventWithItems.status !== 'cancelled') return;\n    51\t\n    52\t    if (eventWithItems.items) {\n    53\t      for (const item of eventWithItems.items) {\n    54\t        this.repo.release(item.productId, item.quantity);\n    55\t      }\n    56\t    }\n    57\t\n    58\t    await this.eventBus.emit(ORDER_EVENTS.STOCK_RELEASED, {\n    59\t      orderId: event.orderId,\n    60\t      timestamp: Date.now(),\n    61\t    });\n    62\t  }\n    63\t\n    64\t  setStock(productId: string, quantity: number): void {\n    65\t    this.repo.setStock(productId, quantity);\n    66\t  }\n    67\t\n    68\t  getStock(productId: string) {\n    69\t    return this.repo.getStock(productId);\n    70\t  }\n    71\t}\n=== src/billing/calculator.ts ===\n     1\timport { OrderItem } from '../orders/repository.js';\n     2\t\n     3\texport interface PriceBreakdown {\n     4\t  subtotal: number;\n     5\t  discountAmount: number;\n     6\t  taxAmount: number;\n     7\t  total: number;\n     8\t}\n     9\t\n    10\texport function calculateOrderTotal(\n    11\t  items: OrderItem[],\n    12\t  discountPercent: number,\n    13\t  taxRate: number\n    14\t): PriceBreakdown {\n    15\t  const subtotal = items.reduce(\n    16\t    (sum, item) => sum + item.unitPrice * item.quantity,\n    17\t    0\n    18\t  );\n    19\t\n    20\t  const discountAmount = Math.round(subtotal * (discountPercent / 100) * 100) / 100;\n    21\t  const afterDiscount = Math.round((subtotal - discountAmount) * 100) / 100;\n    22\t  const taxAmount = Math.round(afterDiscount * taxRate * 100) / 100;\n    23\t  const total = afterDiscount + taxAmount;\n    24\t\n    25\t  return {\n    26\t    subtotal: Math.round(subtotal * 100) / 100,\n    27\t    discountAmount: Math.round(discountAmount * 100) / 100,\n    28\t    taxAmount: Math.round(taxAmount * 100) / 100,\n    29\t    total,\n    30\t  };\n    31\t}\n=== src/billing/service.ts ===\n     1\timport { EventBus } from '../events/bus.js';\n     2\timport { ORDER_EVENTS } from '../events/types.js';\n     3\timport { NotificationService } from '../notifications/service.js';\n     4\timport { calculateOrderTotal } from './calculator.js';\n     5\timport { OrderItem } from '../orders/repository.js';\n     6\t\n     7\texport interface PaymentRecord {\n     8\t  orderId: string;\n     9\t  amount: number;\n    10\t  method: string;\n    11\t  status: 'charged' | 'refunded';\n    12\t  processedAt: number;\n    13\t}\n    14\t\n    15\texport class BillingService {\n    16\t  private payments: Map<string, PaymentRecord> = new Map();\n    17\t\n    18\t  constructor(\n    19\t    private eventBus: EventBus,\n    20\t    private notificationService: NotificationService\n    21\t  ) {}\n    22\t\n    23\t  registerHandlers(): void {\n    24\t    this.eventBus.on(ORDER_EVENTS.STOCK_RESERVED, this.handleStockReserved.bind(this));\n    25\t    this.eventBus.on(ORDER_EVENTS.REFUNDED, this.handleRefund);\n    26\t  }\n    27\t\n    28\t  private async handleStockReserved(data: unknown): Promise<void> {\n    29\t    const event = data as { orderId: string; items: OrderItem[] };\n    30\t    // Payment would be charged here in a real system\n    31\t    await this.eventBus.emit(ORDER_EVENTS.PAYMENT_CHARGED, {\n    32\t      orderId: event.orderId,\n    33\t      amount: 0, // Actual amount set by order service\n    34\t      paymentMethod: 'card',\n    35\t      timestamp: Date.now(),\n    36\t    });\n    37\t  }\n    38\t\n    39\t  async chargePayment(\n    40\t    orderId: string,\n    41\t    items: OrderItem[],\n    42\t    discountPercent: number,\n    43\t    taxRate: number,\n    44\t    paymentMethod: string\n    45\t  ): Promise<PaymentRecord> {\n    46\t    const breakdown = calculateOrderTotal(items, discountPercent, taxRate);\n    47\t\n    48\t    const record: PaymentRecord = {\n    49\t      orderId,\n    50\t      amount: breakdown.total,\n    51\t      method: paymentMethod,\n    52\t      status: 'charged',\n    53\t      processedAt: Date.now(),\n    54\t    };\n    55\t\n    56\t    this.payments.set(orderId, record);\n    57\t    this.notificationService.sendConfirmation(orderId, breakdown.total);\n    58\t    return record;\n    59\t  }\n    60\t\n    61\t  private async handleRefund(data: unknown): Promise<void> {\n    62\t    const event = data as { orderId: string; amount: number };\n    63\t    const payment = this.payments.get(event.orderId);\n    64\t    if (payment) {\n    65\t      payment.status = 'refunded';\n    66\t      this.notificationService.sendRefundNotice(event.orderId, event.amount);\n    67\t    }\n    68\t  }\n    69\t\n    70\t  async issueRefund(orderId: string, amount: number): Promise<PaymentRecord | undefined> {\n    71\t    const payment = this.payments.get(orderId);\n    72\t    if (!payment) return undefined;\n    73\t\n    74\t    payment.status = 'refunded';\n    75\t\n    76\t    await this.eventBus.emit(ORDER_EVENTS.REFUNDED, {\n    77\t      orderId,\n    78\t      amount,\n    79\t      timestamp: Date.now(),\n    80\t    });\n    81\t\n    82\t    return { ...payment };\n    83\t  }\n    84\t\n    85\t  getPayment(orderId: string): PaymentRecord | undefined {\n    86\t    const p = this.payments.get(orderId);\n    87\t    return p ? { ...p } : undefined;\n    88\t  }\n    89\t\n    90\t  clear(): void {\n    91\t    this.payments.clear();\n    92\t  }\n    93\t}\n=== src/notifications/service.ts ===\n     1\texport interface NotificationRecord {\n     2\t  type: string;\n     3\t  orderId: string;\n     4\t  message: string;\n     5\t  sentAt: number;\n     6\t}\n     7\t\n     8\texport class NotificationService {\n     9\t  private templates: Map<string, string>;\n    10\t  private sent: NotificationRecord[] = [];\n    11\t\n    12\t  constructor() {\n    13\t    this.templates = new Map([\n    14\t      ['order.confirmed', 'Your order {orderId} has been confirmed. Total: ${total}'],\n    15\t      ['order.cancelled', 'Your order {orderId} has been cancelled. Reason: {reason}'],\n    16\t      ['order.refunded', 'Your refund of ${amount} for order {orderId} has been processed.'],\n    17\t    ]);\n    18\t  }\n    19\t\n    20\t  sendConfirmation(orderId: string, total: number): NotificationRecord {\n    21\t    const template = this.templates.get('order.confirmed')!;\n    22\t    const message = template\n    23\t      .replace('{orderId}', orderId)\n    24\t      .replace('{total}', total.toFixed(2));\n    25\t    const record: NotificationRecord = {\n    26\t      type: 'confirmation',\n    27\t      orderId,\n    28\t      message,\n    29\t      sentAt: Date.now(),\n    30\t    };\n    31\t    this.sent.push(record);\n    32\t    return record;\n    33\t  }\n    34\t\n    35\t  sendCancellation(orderId: string, reason: string): NotificationRecord {\n    36\t    const template = this.templates.get('order.cancelled')!;\n    37\t    const message = template\n    38\t      .replace('{orderId}', orderId)\n    39\t      .replace('{reason}', reason);\n    40\t    const record: NotificationRecord = {\n    41\t      type: 'cancellation',\n    42\t      orderId,\n    43\t      message,\n    44\t      sentAt: Date.now(),\n    45\t    };\n    46\t    this.sent.push(record);\n    47\t    return record;\n    48\t  }\n    49\t\n    50\t  sendRefundNotice(orderId: string, amount: number): NotificationRecord {\n    51\t    const template = this.templates.get('order.refunded')!;\n    52\t    const message = template\n    53\t      .replace('{orderId}', orderId)\n    54\t      .replace('{amount}', amount.toFixed(2));\n    55\t    const record: NotificationRecord = {\n    56\t      type: 'refund',\n    57\t      orderId,\n    58\t      message,\n    59\t      sentAt: Date.now(),\n    60\t    };\n    61\t    this.sent.push(record);\n    62\t    return record;\n    63\t  }\n    64\t\n    65\t  getSentNotifications(): NotificationRecord[] {\n    66\t    return [...this.sent];\n    67\t  }\n    68\t\n    69\t  clear(): void {\n    70\t    this.sent = [];\n    71\t  }\n    72\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
