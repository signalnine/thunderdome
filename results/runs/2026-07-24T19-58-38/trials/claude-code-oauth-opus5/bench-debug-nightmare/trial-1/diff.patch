55\t  clear(): void {\n    56\t    this.store.clear();\n    57\t  }\n    58\t}\n=== src/orders/service.ts ===\n     1\timport { EventBus } from '../events/bus.js';\n     2\timport { ORDER_EVENTS, OrderCreatedEvent } from '../events/types.js';\n     3\timport { OrderRepository, Order, OrderItem } from './repository.js';\n     4\timport { BillingService } from '../billing/service.js';\n     5\t\n     6\tconst REFUND_WINDOW_DAYS = 30;\n     7\t\n     8\texport class OrderService {\n     9\t  constructor(\n    10\t    private repo: OrderRepository,\n    11\t    private eventBus: EventBus,\n    12\t    private billingService: BillingService\n    13\t  ) {}\n    14\t\n    15\t  async createOrder(\n    16\t    id: string,\n    17\t    customerId: string,\n    18\t    items: OrderItem[],\n    19\t    discount: number = 0,\n    20\t    taxRate: number = 0.1\n    21\t  ): Promise<Order> {\n    22\t    this.repo.create({\n    23\t      id,\n    24\t      customerId,\n    25\t      items: [...items],\n    26\t      status: 'pending',\n    27\t      total: 0,\n    28\t      discount,\n    29\t      taxRate,\n    30\t      createdAt: Date.now(),\n    31\t      updatedAt: Date.now(),\n    32\t    });\n    33\t\n    34\t    const event: OrderCreatedEvent = {\n    35\t      orderId: id,\n    36\t      items: items.map((i) => ({\n    37\t        productId: i.productId,\n    38\t        quantity: i.quantity,\n    39\t        unitPrice: i.unitPrice,\n    40\t      })),\n    41\t      customerId,\n    42\t      timestamp: Date.now(),\n    43\t    };\n    44\t\n    45\t    await this.eventBus.emit(ORDER_EVENTS.CREATED, event);\n    46\t\n    47\t    // Charge payment and confirm\n    48\t    const payment = await this.billingService.chargePayment(\n    49\t      id,\n    50\t      items,\n    51\t      discount,\n    52\t      taxRate,\n    53\t      'card'\n    54\t    );\n    55\t\n    56\t    this.repo.update(id, {\n    57\t      status: 'confirmed',\n    58\t      total: payment.amou