+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015HD42DvxBhqvzSav5miRcM","type":"tool_result","content":"=== packages/core/src/database.ts ===\n     1\t/**\n     2\t * Database connection factory and table creation.\n     3\t * Uses better-sqlite3 for a simple embedded database.\n     4\t */\n     5\t\n     6\timport Database from 'better-sqlite3';\n     7\timport type { User } from './types.js';\n     8\t\n     9\texport interface DatabaseConnection {\n    10\t  db: Database.Database;\n    11\t  close: () => void;\n    12\t}\n    13\t\n    14\texport function createDatabase(path: string = ':memory:'): DatabaseConnection {\n    15\t  const db = new Database(path);\n    16\t\n    17\t  // Enable WAL mode for better concurrent read performance\n    18\t  db.pragma('journal_mode = WAL');\n    19\t  db.pragma('foreign_keys = ON');\n    20\t\n    21\t  return {\n    22\t    db,\n    23\t    close: () => db.close(),\n    24\t  };\n    25\t}\n    26\t\n    27\texport function createTables(conn: DatabaseConnection): void {\n    28\t  conn.db.exec(`\n    29\t    CREATE TABLE IF NOT EXISTS users (\n    30\t      id INTEGER PRIMARY KEY AUTOINCREMENT,\n    31\t      name TEXT NOT NULL,\n    32\t      email TEXT NOT NULL UNIQUE,\n    33\t      role TEXT NOT NULL CHECK(role IN ('admin', 'user', 'viewer')),\n    34\t      created_at TEXT NOT NULL DEFAULT (datetime('now')),\n    35\t      updated_at TEXT NOT NULL DEFAULT (datetime('now'))\n    36\t    );\n    37\t\n    38\t    CREATE INDEX IF NOT EXISTS idx_users_email ON users(email);\n    39\t    CREATE INDEX IF NOT EXISTS idx_users_role ON users(role);\n    40\t  `);\n    41\t}\n    42\t\n    43\texport function insertUser(\n    44\t  conn: DatabaseConnection,\n    45\t  user: { name: string; email: string; role: string }\n    46\t): User {\n    47\t  const stmt = conn.db.prepare(\n    48\t    'INSERT INTO users (name, email, role) VALUES (?, ?, ?) RETURNING *'\n    49\t  );\n    50\t  const row = stmt.get(user.name, user.email, user.role) as {\n    51\t    id: number;\n    52\t    name: string;\n    53\t    email: string;\n    54\t    role: string;\n    55\t    created_at: string;\n    56\t    updated_at: string;\n    57\t  };\n    58\t  return {\n    59\t    id: row.id,\n    60\t    name: row.name,\n    61\t    email: row.email,\n    62\t    role: row.role as User['role'],\n    63\t    createdAt: row.created_at,\n    64\t    updatedAt: row.updated_at,\n    65\t  };\n    66\t}\n    67\t\n    68\texport function findUserById(\n    69\t  conn: DatabaseConnection,\n    70\t  id: number\n    71\t): User | null {\n    72\t  const stmt = conn.db.prepare('SELECT * FROM users WHERE id = ?');\n    73\t  const row = stmt.get(id) as {\n    74\t    id: number;\n    75\t    name: string;\n    76\t    email: string;\n    77\t    role: string;\n    78\t    created_at: string;\n    79\t    updated_at: string;\n    80\t  } | undefined;\n    81\t  if (!row) return null;\n    82\t  return {\n    83\t    id: row.id,\n    84\t    name: row.name,\n    85\t    email: row.email,\n    86\t    role: row.role as User['role'],\n    87\t    createdAt: row.created_at,\n    88\t    updatedAt: row.updated_at,\n    89\t  };\n    90\t}\n    91\t\n    92\texport function findAllUsers(conn: DatabaseConnection): User[] {\n    93\t  const stmt = conn.db.prepare('SELECT * FROM users ORDER BY id');\n    94\t  const rows = stmt.all() as Array<{\n    95\t    id: number;\n    96\t    name: string;\n    97\t    email: string;\n    98\t    role: string;\n    99\t    created_at: string;\n   100\t    updated_at: string;\n   101\t  }>;\n   102\t  return rows.map((row) => ({\n   103\t    id: row.id,\n   104\t    name: row.name,\n   105\t    email: row.email,\n   106\t    role: row.role as User['role'],\n   107\t    createdAt: row.created_at,\n   108\t    updatedAt: row.updated_at,\n   109\t  }));\n   110\t}\n=== packages/core/src/index.ts ===\n     1\t/**\n     2\t * @monorepo/core - Shared business logic\n     3\t */\n     4\t\n     5\t// Types\n     6\texport type { User, CreateUserInput, UserFilters, Role, Permission } from './types.js';\n     7\t\n     8\t// User management\n     9\texport {\n    10\t  registerUser,\n    11\t  validateUser,\n    12\t  getUserById,\n    13\t  getAllUsers,\n    14\t  canUserPerformAction,\n    15\t  getDefaultConnection,\n    16\t  resetDefaultConnection,\n    17\t} from './user.js';\n    18\t\n    19\t// Validation\n    20\texport {\n    21\t  createUserSchema,\n    22\t  userIdSchema,\n    23\t  userFiltersSchema,\n    24\t  roleSchema,\n    25\t  validateCreateUser,\n    26\t  validateUserId,\n    27\t} from './validation.js';\n    28\t\n    29\t// Database\n    30\texport {\n    31\t  createDatabase,\n    32\t  createTables,\n    33\t  insertUser,\n    34\t  findUserById,\n    35\t  findAllUsers,\n    36\t  type DatabaseConnection,\n    37\t} from './database.js';\n    38\t\n    39\t// Permissions\n    40\texport {\n    41\t  hasPermission,\n    42\t  getAllPermissions,\n    43\t  canManageUsers,\n    44\t  canWrite,\n    45\t  canDelete,\n    46\t  requirePermission,\n    47\t} from './permissions.js';\n=== packages/core/src/permissions.ts ===\n     1\t/**\n     2\t * Permission checking and role-based access control.\n     3\t */\n     4\t\n     5\timport type { Role, Permission } from './types.js';\n     6\t\n     7\tconst ROLE_PERMISSIONS: Record<Role, Permission[]> = {\n     8\t  admin: ['read', 'write', 'delete', 'manage_users', 'view_reports'],\n     9\t  user: ['read', 'write', 'view_reports'],\n    10\t  viewer: ['read'],\n    11\t};\n    12\t\n    13\texport function hasPermission(role: Role, permission: Permission): boolean {\n    14\t  const permissions = ROLE_PERMISSIONS[role];\n    15\t  return permissions.includes(permission);\n    16\t}\n    17\t\n    18\texport function getAllPermissions(role: Role): Permission[] {\n    19\t  return [...ROLE_PERMISSIONS[role]];\n    20\t}\n    21\t\n    22\texport function canManag