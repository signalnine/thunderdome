@@ -0,0 +1,41 @@
+/** A JSON-compatible document. Top-level documents are always plain objects. */
+export type JsonObject = Record<string, unknown>;
+
+/** A single point in a document's history. */
+export interface Version {
+  /** Globally unique version identifier. */
+  id: string;
+  /** Wall-clock time (ms) at which the version was created. */
+  timestamp: number;
+  /** Full document content at this version. */
+  content: JsonObject;
+}
+
+/** A field that both branches changed in incompatible ways. */
+export interface Conflict {
+  documentId: string;
+  /**
+   * Dot-separated path to the conflicting field, e.g. `"a.b.c"`.
+   * An empty string means the whole document conflicts (e.g. edited on one
+   * branch and deleted on the other).
+   */
+  path: string;
+  /** Value at the common ancestor, or `undefined` if absent there. */
+  base: unknown;
+  /** Value on the current (target) branch, or `undefined` if absent/deleted. */
+  ours: unknown;
+  /** Value on the source branch, or `undefined` if absent/deleted. */
+  theirs: unknown;
+}
+
+export interface MergeResult {
+  /**
+   * Resulting document contents keyed by document id. Conflicting fields are
+   * resolved in favour of "ours" so the caller can see the shape of the result
+   * even when the merge was not applied.
+   */
+  merged: Record<string, JsonObject>;
+  conflicts: Conflict[];
+  /** True when the merge was auto-applied to the current branch. */
+  applied: boolean;
+}
