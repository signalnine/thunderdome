+++ b/src/store.ts
@@ -0,0 +1,370 @@
+import { mergeDocuments } from './merge.js';
+import type { Conflict, JsonObject, MergeResult, Version } from './types.js';
+import { deepClone, isPlainObject } from './util.js';
+
+export const DEFAULT_BRANCH = 'main';
+
+/**
+ * An immutable snapshot of a document. `content === null` marks a tombstone:
+ * the document was deleted at that point. Tombstones keep deletions visible to
+ * the merge algorithm instead of looking like "the branch never had this doc".
+ */
+interface VersionNode {
+  id: string;
+  documentId: string;
+  /** Monotonic creation order — used to sort history and to pick an ancestor. */
+  seq: number;
+  timestamp: number;
+  content: JsonObject | null;
+  parents: string[];
+}
+
+interface Branch {
+  name: string;
+  /** documentId -> id of the version the branch currently points at. */
+  heads: Map<string, string>;
+}
+
+/** What a merge decided to do with a single document. */
+interface DocumentPlan {
+  documentId: string;
+  /** Resulting content, or null when the document ends up deleted. */
+  content: JsonObject | null;
+  /** How to record the result on the target branch. */
+  action: 'none' | 'fast-forward' | 'commit';
+  /** Version to point at for a fast-forward. */
+  target?: string;
+  /** Parents of the merge version for a commit. */
+  parents: string[];
+}
+
+/**
+ * In-memory versioned document store with branching and three-way structural
+ * merge.
+ *
+ * Versions form a per-document DAG shared by all branches; a branch is just a
+ * map of document id to head version. Branching is therefore O(documents) and
+ * history is never copied or rewritten.
+ */
+export class DocumentStore {
+  private readonly versions = new Map<string, VersionNode>();
+  private readonly branches = new Map<string, Branch>();
+  private currentBranch: string = DEFAULT_BRANCH;
+  private seq = 0;
+  private lastTimestamp = 0;
+
+  constructor() {
+    this.branches.set(DEFAULT_BRANCH, { name: DEFAULT_BRANCH, heads: new Map() });
+  }
+
+  // ---------------------------------------------------------------- documents
+
+  create(id: string, content: object): void {
+    this.assertDocumentId(id);
+    const branch = this.branch();
+    if (this.liveVersion(branch, id) !== undefined) {
+      throw new Error(`Document "${id}" already exists on branch "${branch.name}"`);
+    }
+    const previous = branch.heads.get(id);
+    const node = this.commit(id, this.validContent(content, 'create'), previous ? [previous] : []);
+    branch.heads.set(id, node.id);
+  }
+
+  get(id: string): JsonObject {
+    return deepClone(this.requireLive(id).content as JsonObject);
+  }
+
+  update(id: string, content: object): void {
+    const branch = this.branch();
+    const head = this.requireLive(id);
+    const node = this.commit(id, this.validContent(content, 'update'), [head.id]);
+    branch.heads.set(id, node.id);
+  }
+
+  delete(id: string): void {
+    const branch = this.branch();
+    const head = this.requireLive(id);
+    const node = this.commit(id, null, [head.id]);
+    branch.heads.set(id, node.id);
+  }
+
+  /** Ids of every live document on the current branch. */
+  listDocuments(): string[] {
+    const branch = this.branch();
+    return [...branch.heads.keys()].filter((id) => this.liveVersion(branch, id) !== undefined);
+  }
+
+  // ------------------------------------------------------------------ history
+
+  getHistory(id: string): Version[] {
+    const branch = this.branch();
+    const head = branch.heads.get(id);
+    if (head === undefined) {
+      throw new Error(`Document "${id}" does not exist on branch "${branch.name}"`);
+    }
+    return [...this.ancestry(head)]
+      .map((versionId) => this.node(versionId))
+      .filter((node) => node.content !== null)
+      .sort((a, b) => a.seq - b.seq)
+      .map((node) => ({
+        id: node.id,
+        timestamp: node.timestamp,
+        content: deepClone(node.content as JsonObject),
+      }));
+  }
+
+  getVersion(id: string, versionId: string): JsonObject {
+    const branch = this.branch();
+    const head = branch.heads.get(id);
+    const node = this.versions.get(versionId);
+    // Only versions reachable from this branch are visible from this branch.
+    if (
+      head === undefined ||
+      node === undefined ||
+      node.documentId !== id ||
+      node.content === null ||
+      !this.ancestry(head).has(versionId)
+    ) {
+      throw new Error(
+        `Version "${versionId}" of document "${id}" does not exist on branch "${branch.name}"`,
+      );
+    }
+    return deepClone(node.content);
+  }
+
+  // ----------------------------------------------------------------- branches
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (typeof name !== 'string' || name === '') {
+      throw new Error('Branch name must be a non-empty string');
+    }
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const source = this.requireBranch(fromBranch ?? this.currentBranch);
+    this.branches.set(name, { name, heads: new Map(source.heads) });
+  }
+
+  switchBranch(name: string): void {
+    this.currentBranch = this.requireBranch(name).name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  deleteBranch(name: string): void {
+    if (name === this.currentBranch) {
+      throw new Error(`Cannot delete the current branch "${name}"`);
+    }
+    this.requireBranch(name);
+    this.branches.delete(name);
+  }
+
+  // -------------------------------------------------------------------- merge
+
+  merge(sourceBranch: string): MergeResult {
+    const source = this.requireBranch(sourceBranch);
+    const target = this.branch();
+
+    const conflicts: Conflict[] = [];
+    const plans: DocumentPlan[] = [];
+    const documentIds = new Set([...target.heads.keys(), ...source.heads.keys()]);
+
+    for (const documentId of documentIds) {
+      plans.push(this.planDocument(documentId, target, source, conflicts));
+    }
+
+    const applied = conflicts.length === 0;
+    if (applied) {
+      for (const plan of plans) this.applyPlan(plan, target);
+    }
+
+    // `merged` reflects the resulting state of the branch, with conflicting
+    // fields resolved in favour of "ours".
+    const merged: Record<string, JsonObject> = {};
+    for (const plan of plans) {
+      if (plan.content !== null) merged[plan.documentId] = deepClone(plan.content);
+    }
+    return { merged, conflicts, applied };
+  }
+
+  /** Decide the outcome for one document without mutating anything. */
+  private planDocument(
+    documentId: string,
+    target: Branch,
+    source: Branch,
+    conflicts: Conflict[],
+  ): DocumentPlan {
+    const ourId = target.heads.get(documentId);
+    const theirId = source.heads.get(documentId);
+
+    // Untouched by the source branch: keep whatever we have.
+    if (theirId === undefined || theirId === ourId) {
+      return this.unchangedPlan(documentId, ourId);
+    }
+    // Absent here, or unchanged since the fork point: take theirs wholesale.
+    if (ourId === undefined || this.ancestry(theirId).has(ourId)) {
+      return {
+        documentId,
+        content: this.node(theirId).content,
+        action: 'fast-forward',
+        target: theirId,
+        parents: [],
+      };
+    }
+    // Their side is already contained in ours: nothing to do.
+    if (this.ancestry(ourId).has(theirId)) {
+      return this.unchangedPlan(documentId, ourId);
+    }
+
+    const baseId = this.commonAncestor(ourId, theirId);
+    const base = baseId === undefined ? null : this.node(baseId).content;
+    const ours = this.node(ourId).content;
+    const theirs = this.node(theirId).content;
+    const parents = [ourId, theirId];
+
+    if (ours === null && theirs === null) {
+      return { documentId, content: null, action: 'commit', parents };
+    }
+    if (ours === null || theirs === null) {
+      // Deleted on one side, edited on the other: only the caller can decide.
+      conflicts.push({
+        documentId,
+        path: '',
+        base: base ?? undefined,
+        ours: ours ?? undefined,
+        theirs: theirs ?? undefined,
+      });
+      return { documentId, content: ours, action: 'commit', parents };
+    }
+
+    const result = mergeDocuments(documentId, base ?? undefined, ours, theirs);
+    conflicts.push(...result.conflicts);
+    return { documentId, content: result.content, action: 'commit', parents };
+  }
+
+  private unchangedPlan(documentId: string, ourId: string | undefined): DocumentPlan {
+    const content = ourId === undefined ? null : this.node(ourId).content;
+    return { documentId, content, action: 'none', parents: [] };
+  }
+
+  private applyPlan(plan: DocumentPlan, target: Branch): void {
+    if (plan.action === 'none') return;
+    if (plan.action === 'fast-forward') {
+      target.heads.set(plan.documentId, plan.target as string);
+      return;
+    }
+    // Clone: a merge result can reuse subtrees from either parent's content,
+    // and version nodes must never share structure.
+    const content = plan.content === null ? null : deepClone(plan.content);
+    const node = this.commit(plan.documentId, content, plan.parents);
+    target.heads.set(plan.documentId, node.id);
+  }
+
+  /**
+   * Newest version reachable from both sides — the point at which the branches
+   * diverged. `undefined` when the document was created independently on each
+   * branch and the histories share nothing.
+   */
+  private commonAncestor(a: string, b: string): string | undefined {
+    const reachableFromA = this.ancestry(a);
+    let best: VersionNode | undefined;
+    for (const versionId of this.ancestry(b)) {
+      if (!reachableFromA.has(versionId)) continue;
+      const node = this.node(versionId);
+      if (best === undefined || node.seq > best.seq) best = node;
+    }
+    return best?.id;
+  }
+
+  /** The version itself plus everything it descends from. */
+  private ancestry(versionId: string): Set<string> {
+    const seen = new Set<string>();
+    const stack = [versionId];
+    while (stack.length > 0) {
+      const current = stack.pop() as string;
+      if (seen.has(current)) continue;
+      seen.add(current);
+      stack.push(...this.node(current).parents);
+    }
+    return seen;
+  }
+
+  // ------------------------------------------------------------------ helpers
+
+  private commit(
+    documentId: string,
+    content: JsonObject | null,
+    parents: string[],
+  ): VersionNode {
+    this.seq += 1;
+    // Clamp to keep timestamps non-decreasing even if the clock steps back.
+    this.lastTimestamp = Math.max(Date.now(), this.lastTimestamp);
+    const node: VersionNode = {
+      id: `v${this.seq}-${documentId}`,
+      documentId,
+      seq: this.seq,
+      timestamp: this.lastTimestamp,
+      content,
+      parents,
+    };
+    this.versions.set(node.id, node);
+    return node;
+  }
+
+  private branch(): Branch {
+    return this.requireBranch(this.currentBranch);
+  }
+
+  private requireBranch(name: string): Branch {
+    const branch = this.branches.get(name);
+    if (branch === undefined) throw new Error(`Branch "${name}" does not exist`);
+    return branch;
+  }
+
+  private node(versionId: string): VersionNode {
+    const node = this.versions.get(versionId);
+    if (node === undefined) throw new Error(`Unknown version "${versionId}"`);
+    return node;
+  }
+
+  /** Head version of a document, or undefined if absent or deleted. */
+  private liveVersion(branch: Branch, id: string): VersionNode | undefined {
+    const head = branch.heads.get(id);
+    if (head === undefined) return undefined;
+    const node = this.node(head);
+    return node.content === null ? undefined : node;
+  }
+
+  private requireLive(id: string): VersionNode {
+    const branch = this.branch();
+    const node = this.liveVersion(branch, id);
+    if (node === undefined) {
+      throw new Error(`Document "${id}" does not exist on branch "${branch.name}"`);
+    }
+    return node;
+  }
+
+  private assertDocumentId(id: string): void {
+    if (typeof id !== 'string' || id === '') {
+      throw new Error('Document id must be a non-empty string');
+    }
+  }
+
+  private validContent(content: object, operation: string): JsonObject {
+    if (!isPlainObject(content)) {
+      throw new Error(`Cannot ${operation} a document from a non-object value`);
+    }
+    return deepClone(content);
+  }
+}
+
+/** Convenience factory for callers that prefer not to use `new`. */
+export function createStore(): DocumentStore {
+  return new DocumentStore();
+}
