t.merged.doc as { meta: { a: number } }).meta.a = 99;\n    expect(store.get('doc')).toEqual({ meta: { a: 1, b: 2 } });\n  });\n});","originalFile":"import { describe, expect, it } from 'vitest';\nimport { DocumentStore } from '../src/index.js';\n\ndescribe('document CRUD', () => {\n  it('creates and reads a document', () => {\n    const store = new DocumentStore();\n    store.create('doc', { title: 'hello', tags: ['a'] });\n    expect(store.get('doc')).toEqual({ title: 'hello', tags: ['a'] });\n  });\n\n  it('throws on duplicate create', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: 1 });\n    expect(() => store.create('doc', { a: 2 })).toThrow();\n  });\n\n  it('throws reading a missing or deleted document', () => {\n    const store = new DocumentStore();\n    expect(() => store.get('nope')).toThrow();\n    store.create('doc', { a: 1 });\n    store.delete('doc');\n    expect(() => store.get('doc')).toThrow();\n    expect(() => store.delete('doc')).toThrow();\n    expect(() => store.update('doc', { a: 2 })).toThrow();\n  });\n\n  it('throws updating a document that does not exist', () => {\n    const store = new DocumentStore();\n    expect(() => store.update('doc', { a: 1 })).toThrow();\n  });\n\n  it('deep clones on write and on read', () => {\n    const store = new DocumentStore();\n    const input = { nested: { list: [1, 2] } };\n    store.create('doc', input);\n\n    input.nested.list.push(3);\n    expect(store.get('doc')).toEqual({ nested: { list: [1, 2] } });\n\n    const read = store.get('doc') as { nested: { list: number[] } };\n    read.nested.list.push(99);\n    expect(store.get('doc')).toEqual({ nested: { list: [1, 2] } });\n  });\n\n  it('allows re-creating a deleted document', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: 1 });\n    store.delete('doc');\n    store.create('doc', { a: 2 });\n    expect(store.get('doc')).toEqual({ a: 2 });\n  });\n});\n\ndescribe('version history', () => {\n  it('records one version per create and update, oldest first', () => {\n    const store = new DocumentStore();\n    store.create('doc', { v: 1 });\n    store.update('doc', { v: 2 });\n    store.update('doc', { v: 3 });\n\n    const history = store.getHistory('doc');\n    expect(history.map((version) => version.content)).toEqual([{ v: 1 }, { v: 2 }, { v: 3 }]);\n    expect(new Set(history.map((version) => version.id)).size).toBe(3);\n    for (const version of history) expect(typeof version.timestamp).toBe('number');\n    expect(history[0].timestamp).toBeLessThanOrEqual(history[2].timestamp);\n  });\n\n  it('reads content at a specific version', () => {\n    const store = new DocumentStore();\n    store.create('doc', { v: 1 });\n    store.update('doc', { v: 2 });\n\n    const [first] = store.getHistory('doc');\n    expect(store.getVersion('doc', first.id)).toEqual({ v: 1 });\n    expect(() => store.getVersion('doc', 'bogus')).toThrow();\n  });\n\n  it('does not leak versions between branches', () => {\n    const store = new DocumentStore();\n    store.create('doc', { v: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { v: 2 });\n    const featureHistory = store.getHistory('doc');\n    expect(featureHistory).toHaveLength(2);\n\n    store.switchBranch('main');\n    expect(store.getHistory('doc')).toHaveLength(1);\n    expect(() => store.getVersion('doc', featureHistory[1].id)).toThrow();\n  });\n});\n\ndescribe('branching', () => {\n  it('defaults to main and tracks branches', () => {\n    const store = new DocumentStore();\n    expect(store.getBranch()).toBe('main');\n    store.createBranch('feature');\n    expect(store.listBranches()).toEqual(['main', 'feature']);\n    store.switchBranch('feature');\n    expect(store.getBranch()).toBe('feature');\n    expect(() => store.switchBranch('missing')).toThrow();\n    expect(() => store.createBranch('feature')).toThrow();\n  });\n\n  it('isolates changes between branches', () => {\n    const store = new DocumentStore();\n    store.create('doc', { v: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { v: 2 });\n    store.create('only-feature', { x: 1 });\n\n    store.switchBranch('main');\n    expect(store.get('doc')).toEqual({ v: 1 });\n    expect(() => store.get('only-feature')).toThrow();\n  });\n\n  it('branches from an explicit source branch', () => {\n    const store = new DocumentStore();\n    store.create('doc', { v: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { v: 2 });\n\n    store.switchBranch('main');\n    store.createBranch('from-feature', 'feature');\n    store.switchBranch('from-feature');\n    expect(store.get('doc')).toEqual({ v: 2 });\n    expect(() => store.createBranch('bad', 'missing')).toThrow();\n  });\n});\n\ndescribe('merging', () => {\n  it('fast-forwards when only the source changed', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { a: 1, b: 2 });\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n    expect(result.merged.doc).toEqual({ a: 1, b: 2 });\n    expect(store.get('doc')).toEqual({ a: 1, b: 2 });\n    // A fast-forward reuses the source versions instead of inventing new ones.\n    expect(store.getHistory('doc')).toHaveLength(2);\n  });\n\n  it('merges disjoint field changes without conflict', () => {\n    const store = new DocumentStore();\n    store.create('doc', { title: 'base', meta: { author: 'ann', views: 0 } });\n    store.createBranch('feature');\n\n    store.update('doc', { title: 'ours', meta: { author: 'ann', views: 0 } });\n    store.switchBranch('feature');\n    store.update('doc', { title: 'base', meta: { author: 'bob', views: 0 } });\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    expect(result.conflicts).toEqual([]);\n    expect(result.applied).toBe(true);\n    expect(store.get('doc')).toEqual({ title: 'ours', meta: { author: 'bob', views: 0 } });\n  });\n\n  it('treats identical changes on both sides as agreement', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: 1 });\n    store.createBranch('feature');\n    store.update('doc', { a: 2 });\n    store.switchBranch('feature');\n    store.update('doc', { a: 2 });\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    expect(result.conflicts).toEqual([]);\n    expect(result.applied).toBe(true);\n    expect(store.get('doc')).toEqual({ a: 2 });\n  });\n\n  it('reports conflicting field edits and leaves the branch untouched', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: { b: { c: 'base' } }, other: 1 });\n    store.createBranch('feature');\n\n    store.update('doc', { a: { b: { c: 'ours' } }, other: 2 });\n    store.switchBranch('feature');\n    store.update('doc', { a: { b: { c: 'theirs' } }, other: 1 });\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toEqual([\n      { documentId: 'doc', path: 'a.b.c', base: 'base', ours: 'ours', theirs: 'theirs' },\n    ]);\n    // `merged` previews the result with conflicts resolved as \"ours\".\n    expect(result.merged.doc).toEqual({ a: { b: { c: 'ours' } }, other: 2 });\n    // ...but nothing was applied.\n    expect(store.get('doc')).toEqual({ a: { b: { c: 'ours' } }, other: 2 });\n    store.switchBranch('feature');\n    expect(store.get('doc')).toEqual({ a: { b: { c: 'theirs' } }, other: 1 });\n  });\n\n  it('merges documents independently', () => {\n    const store = new DocumentStore();\n    store.create('a', { v: 0 });\n    store.create('b', { v: 0 });\n    store.createBranch('feature');\n\n    store.update('a', { v: 1 });\n    store.switchBranch('feature');\n    store.update('b', { v: 1 });\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    expect(result.conflicts).toEqual([]);\n    expect(result.merged).toEqual({ a: { v: 1 }, b: { v: 1 } });\n    expect(store.get('a')).toEqual({ v: 1 });\n    expect(store.get('b')).toEqual({ v: 1 });\n  });\n\n  it('adds documents created only on the source branch', () => {\n    const store = new DocumentStore();\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.create('new', { a: 1 });\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(store.get('new')).toEqual({ a: 1 });\n  });\n\n  it('is a no-op when nothing changed on either side', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: 1 });\n    store.createBranch('feature');\n\n    const result = store.merge('feature');\n    expect(result).toEqual({ merged: { doc: { a: 1 } }, conflicts: [], applied: true });\n    expect(store.getHistory('doc')).toHaveLength(1);\n  });\n\n  it('handles added and removed fields', () => {\n    const store = new DocumentStore();\n    store.create('doc', { keep: 1, drop: 2 });\n    store.createBranch('feature');\n\n    store.update('doc', { keep: 1 }); // ours removes `drop`\n    store.switchBranch('feature');\n    store.update('doc', { keep: 1, drop: 2, added: 3 }); // theirs adds `added`\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    expect(result.conflicts).toEqual([]);\n    expect(store.get('doc')).toEqual({ keep: 1, added: 3 });\n  });\n\n  it('conflicts when one side removes a field the other edits', () => {\n    const store = new DocumentStore();\n    store.create('doc', { field: 'base' });\n    store.createBranch('feature');\n\n    store.update('doc', {}); // ours removes it\n    store.switchBranch('feature')