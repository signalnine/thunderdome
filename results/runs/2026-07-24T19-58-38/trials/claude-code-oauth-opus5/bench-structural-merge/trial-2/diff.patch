+++ b/src/merge.ts
@@ -0,0 +1,114 @@
+import type { Conflict, JsonObject } from './types.js';
+import { deepEqual, isPlainObject } from './util.js';
+
+/**
+ * Sentinel for "this key is not present". Distinguishing absence from an
+ * explicit `undefined` matters: removing a field on one side while the other
+ * side edits it is a conflict, not a no-op.
+ */
+export const MISSING = Symbol('missing');
+export type Maybe<T> = T | typeof MISSING;
+
+function equalMaybe(a: Maybe<unknown>, b: Maybe<unknown>): boolean {
+  if (a === MISSING || b === MISSING) return a === b;
+  return deepEqual(a, b);
+}
+
+/** Convert the sentinel to `undefined` for the public `Conflict` shape. */
+function exposed(value: Maybe<unknown>): unknown {
+  return value === MISSING ? undefined : value;
+}
+
+function childPath(path: string, key: string): string {
+  return path === '' ? key : `${path}.${key}`;
+}
+
+function readKey(source: Maybe<unknown>, key: string): Maybe<unknown> {
+  if (!isPlainObject(source) || !Object.prototype.hasOwnProperty.call(source, key)) {
+    return MISSING;
+  }
+  return source[key];
+}
+
+/**
+ * Three-way merge of a single value.
+ *
+ * Conflicts are appended to `conflicts`; the returned value resolves any
+ * conflict in favour of `ours`. Arrays and scalars are treated as atomic — only
+ * plain objects are descended into.
+ */
+function mergeValue(
+  documentId: string,
+  path: string,
+  base: Maybe<unknown>,
+  ours: Maybe<unknown>,
+  theirs: Maybe<unknown>,
+  conflicts: Conflict[],
+): Maybe<unknown> {
+  // Both sides agree (including "both deleted it").
+  if (equalMaybe(ours, theirs)) return ours;
+  // Only one side moved away from the base — take that side.
+  if (equalMaybe(base, ours)) return theirs;
+  if (equalMaybe(base, theirs)) return ours;
+
+  // Both sides changed. Objects can still merge field-by-field.
+  if (isPlainObject(ours) && isPlainObject(theirs)) {
+    const baseObject: JsonObject = isPlainObject(base) ? base : {};
+    const result: JsonObject = {};
+    for (const key of unionKeys(ours, theirs, baseObject)) {
+      const value = mergeValue(
+        documentId,
+        childPath(path, key),
+        readKey(baseObject, key),
+        readKey(ours, key),
+        readKey(theirs, key),
+        conflicts,
+      );
+      if (value !== MISSING) result[key] = value;
+    }
+    return result;
+  }
+
+  conflicts.push({
+    documentId,
+    path,
+    base: exposed(base),
+    ours: exposed(ours),
+    theirs: exposed(theirs),
+  });
+  return ours;
+}
+
+/** Keys of all three objects, "ours" first, each key appearing once. */
+function unionKeys(...objects: JsonObject[]): string[] {
+  const seen = new Set<string>();
+  for (const object of objects) {
+    for (const key of Object.keys(object)) seen.add(key);
+  }
+  return [...seen];
+}
+
+export interface DocumentMerge {
+  content: JsonObject;
+  conflicts: Conflict[];
+}
+
+/** Three-way merge of two versions of a whole document. */
+export function mergeDocuments(
+  documentId: string,
+  base: JsonObject | undefined,
+  ours: JsonObject,
+  theirs: JsonObject,
+): DocumentMerge {
+  const conflicts: Conflict[] = [];
+  const merged = mergeValue(
+    documentId,
+    '',
+    base === undefined ? MISSING : base,
+    ours,
+    theirs,
+    conflicts,
+  );
+  // `ours` and `theirs` are both objects, so the result is always an object.
+  return { content: (merged === MISSING ? {} : merged) as JsonObject, conflicts };
+}
