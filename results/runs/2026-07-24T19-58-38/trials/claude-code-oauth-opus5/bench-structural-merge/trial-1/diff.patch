+import { describe, expect, it } from 'vitest';
+import { DocumentStore, createDocumentStore } from '../src/index.js';
+
+describe('document CRUD', () => {
+  it('creates and reads a document', () => {
+    const store = new DocumentStore();
+    store.create('doc', { title: 'hello', tags: ['a'] });
+    expect(store.get('doc')).toEqual({ title: 'hello', tags: ['a'] });
+  });
+
+  it('throws on duplicate create, missing get/update/delete', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
+    expect(() => store.create('doc', { a: 2 })).toThrow();
+    expect(() => store.get('nope')).toThrow();
+    expect(() => store.update('nope', { a: 1 })).toThrow();
+    expect(() => store.delete('nope')).toThrow();
+  });
+
+  it('throws when reading a deleted document', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
+    store.delete('doc');
+    expect(() => store.get('doc')).toThrow();
+    expect(store.has('doc')).toBe(false);
+  });
+
+  it('deep clones on write and on read', () => {
+    const store = new DocumentStore();
+    const input = { nested: { list: [1, 2] } };
+    store.create('doc', input);
+
+    input.nested.list.push(3); // mutating the caller's object must not leak in
+    expect(store.get('doc')).toEqual({ nested: { list: [1, 2] } });
+
+    const read = store.get('doc') as { nested: { list: number[] } };
+    read.nested.list.push(99); // mutating a read result must not leak in
+    expect(store.get('doc')).toEqual({ nested: { list: [1, 2] } });
+  });
+
+  it('rejects non-object content', () => {
+    const store = new DocumentStore();
+    expect(() => store.create('a', [1, 2] as unknown as object)).toThrow();
+    expect(() => store.create('b', null as unknown as object)).toThrow();
+  });
+});
+
+describe('version history', () => {
+  it('records a version per create and update, oldest first', () => {
+    const store = new DocumentStore();
+    store.create('doc', { v: 1 });
+    store.update('doc', { v: 2 });
+    store.update('doc', { v: 3 });
+
+    const history = store.getHistory('doc');
+    expect(history).toHaveLength(3);
+    expect(history.map((v) => v.content)).toEqual([{ v: 1 }, { v: 2 }, { v: 3 }]);
+    expect(new Set(history.map((v) => v.id)).size).toBe(3);
+    expect(history[0].timestamp).toBeLessThanOrEqual(history[2].timestamp);
+    expect(typeof history[0].timestamp).toBe('number');
+  });
+
+  it('reads content at a specific version and rejects unknown ones', () => {
+    const store = new DocumentStore();
+    store.create('doc', { v: 1 });
+    store.update('doc', { v: 2 });
+
+    const [first] = store.getHistory('doc');
+    expect(store.getVersion('doc', first.id)).toEqual({ v: 1 });
+    expect(() => store.getVersion('doc', 'bogus')).toThrow();
+    expect(() => store.getVersion('missing', first.id)).toThrow();
+  });
+
+  it('keeps history immutable against caller mutation', () => {
+    const store = new DocumentStore();
+    store.create('doc', { v: 1 });
+    const history = store.getHistory('doc') as { content: { v: number } }[];
+    history[0].content.v = 42;
+    expect(store.getHistory('doc')[0].content).toEqual({ v: 1 });
+  });
+});
+
+describe('branching', () => {
+  it('defaults to main and tracks branches', () => {
+    const store = new DocumentStore();
+    expect(store.getBranch()).toBe('main');
+    store.createBranch('feature');
+    expect(store.listBranches()).toEqual(['main', 'feature']);
+    store.switchBranch('feature');
+    expect(store.getBranch()).toBe('feature');
+  });
+
+  it('branches from the current state and isolates changes', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+
+    expect(store.get('doc')).toEqual({ a: 1 });
+    store.update('doc', { a: 2 });
+    store.create('only-feature', { x: 1 });
+
+    store.switchBranch('main');
+    expect(store.get('doc')).toEqual({ a: 1 });
+    expect(() => store.get('only-feature')).toThrow();
+  });
+
+  it('branches from an explicit source branch', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc', { a: 2 });
+
+    store.switchBranch('main');
+    store.createBranch('copy', 'feature');
+    store.switchBranch('copy');
+    expect(store.get('doc')).toEqual({ a: 2 });
+  });
+
+  it('rejects duplicate and unknown branches', () => {
+    const store = new DocumentStore();
+    store.createBranch('feature');
+    expect(() => store.createBranch('feature')).toThrow();
+    expect(() => store.createBranch('x', 'nope')).toThrow();
+    expect(() => store.switchBranch('nope')).toThrow();
+    expect(() => store.merge('nope')).toThrow();
+  });
+});
+
