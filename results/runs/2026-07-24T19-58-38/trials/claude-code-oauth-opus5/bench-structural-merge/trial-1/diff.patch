+
+    expect(result.conflicts).toEqual([]);
+    expect(store.get('fresh')).toEqual({ a: 1 });
+    expect(store.getHistory('fresh')).toHaveLength(1);
+  });
+
+  it('keeps merged results detached from store state', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
