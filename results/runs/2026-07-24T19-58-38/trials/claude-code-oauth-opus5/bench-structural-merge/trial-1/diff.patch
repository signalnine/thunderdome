diff --git a/src/json.ts b/src/json.ts
new file mode 100644
index 0000000..4ffed36
--- /dev/null
+++ b/src/json.ts
@@ -0,0 +1,65 @@
+import type { JsonObject, JsonValue } from './types.js';
+
+/** True for non-null, non-array objects (the only containers we merge structurally). */
+export function isPlainObject(value: unknown): value is JsonObject {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Recursive clone of a JSON value. Used at every storage and retrieval
+ * boundary so callers can never mutate state held by the store.
+ */
+export function deepClone<T extends JsonValue>(value: T): T;
+export function deepClone(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map((item) => deepClone(item));
+  }
+  if (isPlainObject(value)) {
+    const out: JsonObject = {};
+    for (const key of Object.keys(value)) {
+      out[key] = deepClone(value[key]);
+    }
+    return out;
+  }
+  return value;
+}
+
+/** Structural equality for JSON values. Object key order is not significant. */
+export function deepEqual(a: JsonValue, b: JsonValue): boolean {
+  if (Object.is(a, b)) return true;
+
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
+    return a.every((item, i) => deepEqual(item, b[i]));
+  }
+
+  if (isPlainObject(a) && isPlainObject(b)) {
+    const aKeys = Object.keys(a);
+    const bKeys = Object.keys(b);
+    if (aKeys.length !== bKeys.length) return false;
+    return aKeys.every(
+      (key) => Object.prototype.hasOwnProperty.call(b, key) && deepEqual(a[key], b[key]),
+    );
+  }
+
+  return false;
+}
+
+/**
+ * Validates that `content` is usable as a document body: a plain JSON object.
+ * Arrays are allowed inside fields but not as the document itself.
+ */
+export function assertDocumentContent(content: unknown, operation: string): JsonObject {
+  if (!isPlainObject(content)) {
+    throw new TypeError(
+      `${operation}: document content must be a plain object (received ${describe(content)})`,
+    );
+  }
+  return content;
+}
+
+function describe(value: unknown): string {
+  if (value === null) return 'null';
+  if (Array.isArray(value)) return 'an array';
+  return typeof value;
+}
diff --git a/src/merge.ts b/src/merge.ts
new file mode 100644
index 0000000..1572de0
--- /dev/null
+++ b/src/merge.ts
@@ -0,0 +1,149 @@
+import { deepClone, deepEqual, isPlainObject } from './json.js';
+import type { Conflict, JsonObject, JsonValue } from './types.js';
+
+/**
+ * Marks a value that is absent on one side of a merge. Distinguishing "absent"
+ * from `null`/`undefined` is what lets us tell "field was deleted" apart from
+ * "field was set to null".
+ */
+export const MISSING = Symbol('missing');
+export type Slot = JsonValue | typeof MISSING;
+
+/** A branch state: document id -> document content. */
+export type State = Map<string, JsonObject>;
+
+export interface StateMergeResult {
+  state: State;
+  conflicts: Conflict[];
+}
+
+function slotEqual(a: Slot, b: Slot): boolean {
+  if (a === MISSING || b === MISSING) return a === b;
+  return deepEqual(a, b);
+}
+
+/** Converts an internal slot to the value exposed on a `Conflict`. */
+function expose(slot: Slot): JsonValue | undefined {
+  return slot === MISSING ? undefined : deepClone(slot);
+}
+
+function slotAt(container: JsonObject, key: string): Slot {
+  if (!Object.prototype.hasOwnProperty.call(container, key)) return MISSING;
+  const value = container[key];
+  return value === undefined ? MISSING : value;
+}
+
+function childPath(path: string, key: string): string {
+  return path === '' ? key : `${path}.${key}`;
+}
+
+/**
+ * Three-way merges a single value.
+ *
+ * Resolution order:
+ *  1. Both sides agree (including "both deleted it") -> that value.
+ *  2. Only one side moved away from the base -> take the side that changed.
+ *  3. Both sides changed to different objects -> recurse field by field, so
+ *     edits to disjoint fields of the same object combine cleanly.
+ *  4. Otherwise the change is a genuine conflict; it is recorded and resolved
+ *     in favour of `ours`.
+ *
+ * Arrays are treated as atomic values: they are compared whole, never merged
+ * element-wise (element-wise merging of arrays has no single correct answer).
+ */
+export function mergeValue(
+  base: Slot,
+  ours: Slot,
+  theirs: Slot,
+  path: string,
+  documentId: string,
+  conflicts: Conflict[],
+): Slot {
+  if (slotEqual(ours, theirs)) return ours;
+  if (slotEqual(base, ours)) return theirs;
+  if (slotEqual(base, theirs)) return ours;
+
+  // Both sides changed. If both produced objects (and the base was an object or
+  // absent), the change may still be reconcilable field by field.
+  if (isPlainObject(ours) && isPlainObject(theirs) && (base === MISSING || isPlainObject(base))) {
+    const baseObject: JsonObject = base === MISSING ? {} : base;
+    const merged: JsonObject = {};
+
+    // A key surviving the merge must exist on at least one side: any key held
+    // only by the base was deleted by both.
+    for (const key of unionKeys(ours, theirs)) {
+      const value = mergeValue(
+        slotAt(baseObject, key),
+        slotAt(ours, key),
+        slotAt(theirs, key),
+        childPath(path, key),
+        documentId,
+        conflicts,
+      );
+      if (value !== MISSING) merged[key] = value;
+    }
+    return merged;
+  }
+
+  conflicts.push({
+    documentId,
+    path,
+    base: expose(base),
+    ours: expose(ours),
+    theirs: expose(theirs),
+  });
+  return ours;
+}
+
+function unionKeys(a: JsonObject, b: JsonObject): string[] {
+  const keys = Object.keys(a);
+  const seen = new Set(keys);
+  for (const key of Object.keys(b)) {
+    if (!seen.has(key)) {
+      seen.add(key);
+      keys.push(key);
+    }
+  }
+  return keys;
+}
+
+/**
+ * Three-way merges two branch states against their common ancestor.
+ *
+ * Documents are merged independently, so unrelated edits on different documents
+ * never interfere. A document deleted on one side and edited on the other is a
+ * conflict reported at the document root (path `""`).
+ */
+export function mergeStates(base: State, ours: State, theirs: State): StateMergeResult {
+  const state: State = new Map();
+  const conflicts: Conflict[] = [];
+
+  for (const documentId of unionIds(base, ours, theirs)) {
+    const b = base.has(documentId) ? (base.get(documentId) as JsonValue) : MISSING;
+    const o = ours.has(documentId) ? (ours.get(documentId) as JsonValue) : MISSING;
+    const t = theirs.has(documentId) ? (theirs.get(documentId) as JsonValue) : MISSING;
+
+    if (o === MISSING && t === MISSING) continue; // deleted (or absent) on both sides
+
+    const merged = mergeValue(b, o, t, '', documentId, conflicts);
+    if (merged !== MISSING) {
+      state.set(documentId, deepClone(merged) as JsonObject);
+    }
+  }
+
+  return { state, conflicts };
+}
+
+function unionIds(...states: State[]): string[] {
+  const ids: string[] = [];
+  const seen = new Set<string>();
+  for (const state of states) {
+    for (const id of state.keys()) {
+      if (!seen.has(id)) {
+        seen.add(id);
+        ids.push(id);
+      }
+    }
+  }
+  return ids;
+}
