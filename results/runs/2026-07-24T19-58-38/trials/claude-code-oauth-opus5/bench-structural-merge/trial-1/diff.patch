+describe('merge base tracking', () => {
+  it('advances the base so a re-merge does not resurrect merged deletions', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1, b: 2 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc', { a: 1, b: 3 });
+
+    store.switchBranch('main');
+    expect(store.merge('feature').applied).toBe(true);
+    expect(store.get('doc')).toEqual({ a: 1, b: 3 });
+
+    // Now change the merged field on main only. Re-merging must keep our newer
+    // value rather than treating the stale base as a competing change.
+    store.update('doc', { a: 1, b: 4 });
+    const second = store.merge('feature');
+    expect(second.conflicts).toEqual([]);
+    expect(store.get('doc')).toEqual({ a: 1, b: 4 });
+  });
+
+  it('uses the divergence point for branches of branches', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc', { a: 1, feat: true });
+
+    store.createBranch('sub'); // from feature
+    store.switchBranch('sub');
+    store.update('doc', { a: 1, feat: true, sub: true });
+
+    store.switchBranch('feature');
+    const result = store.merge('sub');
+    expect(result.conflicts).toEqual([]);
+    expect(store.get('doc')).toEqual({ a: 1, feat: true, sub: true });
+
+    // main diverged from feature before either edit; both land cleanly.
+    store.switchBranch('main');
+    const intoMain = store.merge('feature');
+    expect(intoMain.conflicts).toEqual([]);
+    expect(store.get('doc')).toEqual({ a: 1, feat: true, sub: true });
+  });
+
+  it('merges sibling branches against their shared ancestor', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1, b: 1 });
+    store.createBranch('left');
+    store.createBranch('right');
+
+    store.switchBranch('left');
+    store.update('doc', { a: 2, b: 1 });
+    store.switchBranch('right');
+    store.update('doc', { a: 1, b: 2 });
+
+    const result = store.merge('left');
+    expect(result.conflicts).toEqual([]);
+    expect(store.get('doc')).toEqual({ a: 2, b: 2 });
+  });
+
+  it('does not leak post-branch changes on the source into the base', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
+    store.createBranch('feature');
+
+    // main moves on after the branch point; feature is untouched.
+    store.update('doc', { a: 2 });
+    const result = store.merge('feature');
+
+    expect(result.conflicts).toEqual([]);
+    expect(store.get('doc')).toEqual({ a: 2 });
+  });
+});
+
+describe('merge edge cases', () => {
+  it('conflicts when both sides replace a scalar with different objects', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
+    store.createBranch('feature');
+
+    store.update('doc', { a: { x: 1 } });
+    store.switchBranch('feature');
+    store.update('doc', { a: { y: 2 } });
+
+    store.switchBranch('main');
+    const result = store.merge('feature');
+
+    expect(result.conflicts).toEqual([
+      { documentId: 'doc', path: 'a', base: 1, ours: { x: 1 }, theirs: { y: 2 } },
+    ]);
+  });
+
+  it('does not conflict when both sides delete the same document', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
+    store.createBranch('feature');
+
+    store.delete('doc');
+    store.switchBranch('feature');
+    store.delete('doc');
+
+    store.switchBranch('main');
+    const result = store.merge('feature');
+
+    expect(result.conflicts).toEqual([]);
+    expect(result.applied).toBe(true);
+    expect(result.merged).toEqual({});
+  });
+
+  it('adds a document created only on the source branch', () => {
+    const store = new DocumentStore();
+    store.createBranch('feature');
+    store.switchBranch('feature');
