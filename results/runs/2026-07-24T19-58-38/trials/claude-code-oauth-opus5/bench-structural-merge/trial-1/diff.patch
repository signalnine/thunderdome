tate | undefined {\n    return this.bases.get(a)?.get(b);\n  }\n\n  private setBase(a: string, b: string, state: State): void {\n    upsert(this.bases, a).set(b, state);\n    upsert(this.bases, b).set(a, state);\n  }\n\n  private branch(): Branch {\n    return this.branches.get(this.currentBranch) as Branch;\n  }\n\n  private record(id: string): DocumentRecord {\n    assertDocumentId(id);\n    const branch = this.branch();\n    const record = branch.documents.get(id);\n    if (!record) {\n      throw new Error(`Document \"${id}\" not found on branch \"${branch.name}\"`);\n    }\n    return record;\n  }\n\n  private newVersion(content: JsonObject): Version {\n    // Clamped so versions are never ordered inconsistently with their history,\n    // even when several writes land inside the same millisecond.\n    const timestamp = Math.max(Date.now(), this.lastTimestamp);\n    this.lastTimestamp = timestamp;\n    this.versionCounter += 1;\n    return { id: `v${this.versionCounter}`, timestamp, content };\n  }\n}\n\nfunction upsert(map: Map<string, Map<string, State>>, key: string): Map<string, State> {\n  let inner = map.get(key);\n  if (!inner) {\n    inner = new Map();\n    map.set(key, inner);\n  }\n  return inner;\n}\n\nfunction assertDocumentId(id: string): void {\n  if (typeof id !== 'string' || id === '') {\n    throw new TypeError('Document id must be a non-empty string');\n  }\n}\n\nfunction assertBranchName(name: string): void {\n  if (typeof name !== 'string' || name === '') {\n    throw new TypeError('Branch name must be a non-empty string');\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
