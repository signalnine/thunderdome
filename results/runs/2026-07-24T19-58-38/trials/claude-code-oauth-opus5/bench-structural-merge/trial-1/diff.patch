+    store.switchBranch('feature');
+    store.update('doc', { a: 1, b: 99 });
+
+    store.switchBranch('main');
+    const result = store.merge('feature');
+
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged.doc).toEqual({ a: 1, b: 99 });
+    expect(store.get('doc')).toEqual({ a: 1, b: 99 });
+  });
+
+  it('combines edits to different fields of the same document', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1, b: 2, c: 3 });
+    store.createBranch('feature');
+
+    store.update('doc', { a: 10, b: 2, c: 3 }); // ours
+    store.switchBranch('feature');
+    store.update('doc', { a: 1, b: 20, c: 3 }); // theirs
+
+    store.switchBranch('main');
+    const result = store.merge('feature');
+
+    expect(result.conflicts).toEqual([]);
+    expect(result.applied).toBe(true);
+    expect(store.get('doc')).toEqual({ a: 10, b: 20, c: 3 });
+  });
+
+  it('merges nested objects field by field', () => {
+    const store = new DocumentStore();
+    store.create('doc', { meta: { author: 'x', year: 2020 }, body: 'text' });
+    store.createBranch('feature');
+
+    store.update('doc', { meta: { author: 'y', year: 2020 }, body: 'text' });
+    store.switchBranch('feature');
+    store.update('doc', { meta: { author: 'x', year: 2021 }, body: 'text' });
+
+    store.switchBranch('main');
+    const result = store.merge('feature');
+
+    expect(result.conflicts).toEqual([]);
+    expect(store.get('doc')).toEqual({ meta: { author: 'y', year: 2021 }, body: 'text' });
+  });
+
+  it('does not conflict when both sides made the identical change', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
+    store.createBranch('feature');
+
+    store.update('doc', { a: 2 });
+    store.switchBranch('feature');
+    store.update('doc', { a: 2 });
+
+    store.switchBranch('main');
+    const result = store.merge('feature');
+
+    expect(result.conflicts).toEqual([]);
+    expect(result.applied).toBe(true);
+    expect(store.get('doc')).toEqual({ a: 2 });
+  });
+
+  it('reports conflicts with a dotted path and leaves the branch untouched', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: { b: { c: 1 } } });
+    store.createBranch('feature');
+
+    store.update('doc', { a: { b: { c: 2 } } });
+    store.switchBranch('feature');
+    store.update('doc', { a: { b: { c: 3 } } });
+
+    store.switchBranch('main');
+    const result = store.merge('feature');
+
+    expect(result.applied).toBe(false);
+    expect(result.conflicts).toEqual([
+      { documentId: 'doc', path: 'a.b.c', base: 1, ours: 2, theirs: 3 },
+    ]);
+    expect(store.get('doc')).toEqual({ a: { b: { c: 2 } } }); // unchanged
+    expect(result.merged.doc).toEqual({ a: { b: { c: 2 } } }); // resolved as ours
+  });
+
+  it('does not apply any document when another one conflicts', () => {
+    const store = new DocumentStore();
+    store.create('clean', { a: 1 });
+    store.create('dirty', { a: 1 });
+    store.createBranch('feature');
+
+    store.update('dirty', { a: 2 });
+    store.switchBranch('feature');
+    store.update('clean', { a: 5 });
+    store.update('dirty', { a: 3 });
+
+    store.switchBranch('main');
+    const result = store.merge('feature');
+
