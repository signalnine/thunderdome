+      { documentId: 'doc', path: 'list', base: [1, 2], ours: [1, 2, 3], theirs: [1, 2, 4] },
+    ]);
+  });
+
+  it('distinguishes a field set to null from a removed field', () => {
+    const store = new DocumentStore();
+    store.create('doc', { a: 1 });
+    store.createBranch('feature');
