--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,268 @@
+import { assertDocumentContent, deepClone, deepEqual } from './json.js';
+import { mergeStates, type State } from './merge.js';
+import type { DocumentStoreOptions, JsonObject, MergeResult, Version } from './types.js';
+
+interface DocumentRecord {
+  /** Current content. Never mutated in place: writes replace the whole value. */
+  content: JsonObject;
+  history: Version[];
+}
+
+interface Branch {
+  name: string;
+  documents: Map<string, DocumentRecord>;
+}
+
+const DEFAULT_BRANCH = 'main';
+
+/**
+ * An in-memory, versioned, branchable store for JSON documents.
+ *
+ * Every branch owns an independent set of documents, and every write appends an
+ * immutable version. Branches are reconciled with a three-way structural merge
+ * against the state at which they diverged.
+ *
+ * Internal invariant: stored JSON values are treated as immutable. Writes
+ * replace whole values, and everything crossing the API boundary is deep
+ * cloned, so no caller can reach into stored state.
+ */
+export class DocumentStore {
+  private readonly branches = new Map<string, Branch>();
+  /** Merge bases, symmetric: `bases.get(a).get(b)` is the divergence point of a and b. */
+  private readonly bases = new Map<string, Map<string, State>>();
+  private currentBranch: string;
+  private versionCounter = 0;
+  private lastTimestamp = 0;
+
+  constructor(options: DocumentStoreOptions = {}) {
+    const initial = options.defaultBranch ?? DEFAULT_BRANCH;
+    assertBranchName(initial);
+    this.branches.set(initial, { name: initial, documents: new Map() });
+    this.currentBranch = initial;
+  }
+
+  // --- Document CRUD -------------------------------------------------------
+
+  create(id: string, content: object): void {
+    assertDocumentId(id);
+    const value = assertDocumentContent(content, 'create');
+    const branch = this.branch();
+    if (branch.documents.has(id)) {
+      throw new Error(`Document "${id}" already exists on branch "${branch.name}"`);
+    }
+    const stored = deepClone(value);
+    branch.documents.set(id, { content: stored, history: [this.newVersion(stored)] });
+  }
+
+  get(id: string): JsonObject {
+    return deepClone(this.record(id).content);
+  }
+
+  update(id: string, content: object): void {
+    assertDocumentId(id);
+    const value = assertDocumentContent(content, 'update');
+    const record = this.record(id);
+    const stored = deepClone(value);
+    record.content = stored;
+    record.history.push(this.newVersion(stored));
+  }
+
+  delete(id: string): void {
+    assertDocumentId(id);
+    const branch = this.branch();
+    if (!branch.documents.has(id)) {
+      throw new Error(`Document "${id}" not found on branch "${branch.name}"`);
+    }
+    branch.documents.delete(id);
+  }
+
+  /** True when `id` exists on the current branch. Never throws. */
+  has(id: string): boolean {
+    return this.branch().documents.has(id);
+  }
+
+  /** Document ids on the current branch. */
+  listDocuments(): string[] {
+    return [...this.branch().documents.keys()];
+  }
+
+  // --- Version history -----------------------------------------------------
+
+  getHistory(id: string): Version[] {
+    return this.record(id).history.map((version) => ({
+      ...version,
+      content: deepClone(version.content),
+    }));
+  }
+
+  getVersion(id: string, versionId: string): JsonObject {
+    const version = this.record(id).history.find((candidate) => candidate.id === versionId);
+    if (!version) {
+      throw new Error(`Version "${versionId}" not found for document "${id}"`);
+    }
+    return deepClone(version.content);
+  }
+
+  // --- Branching -----------------------------------------------------------
+
+  createBranch(name: string, fromBranch?: string): void {
+    assertBranchName(name);
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const sourceName = fromBranch ?? this.currentBranch;
+    const source = this.branches.get(sourceName);
+    if (!source) {
+      throw new Error(`Branch "${sourceName}" does not exist`);
+    }
+
+    const documents = new Map<string, DocumentRecord>();
+    for (const [id, record] of source.documents) {
+      documents.set(id, { content: record.content, history: [...record.history] });
+    }
+    this.branches.set(name, { name, documents });
+
+    // The new branch starts life identical to its source, so it inherits the
+    // source's divergence points with every other branch...
+    for (const [other, state] of this.bases.get(sourceName) ?? []) {
+      this.setBase(name, other, state);
+    }
+    // ...and diverges from the source right here.
+    this.setBase(name, sourceName, this.snapshot(source));
+  }
+
+  switchBranch(name: string): void {
+    if (!this.branches.has(name)) {
+      throw new Error(`Branch "${name}" does not exist`);
+    }
+    this.currentBranch = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  // --- Merging -------------------------------------------------------------
+
+  /**
+   * Three-way merges `sourceBranch` into the current branch.
+   *
+   * With no conflicts the result is applied to the current branch and each
+   * changed document gains a new version. With conflicts nothing is applied and
+   * the current branch is left untouched; `merged` still shows what the result
+   * would look like, with each conflict resolved in favour of "ours".
+   */
+  merge(sourceBranch: string): MergeResult {
+    const source = this.branches.get(sourceBranch);
+    if (!source) {
+      throw new Error(`Branch "${sourceBranch}" does not exist`);
+    }
+    const target = this.branch();
+    if (source.name === target.name) {
+      throw new Error(`Cannot merge branch "${sourceBranch}" into itself`);
+    }
+
+    const base = this.getBase(target.name, source.name) ?? new Map();
+    const ours = this.snapshot(target);
+    const theirs = this.snapshot(source);
+    const { state, conflicts } = mergeStates(base, ours, theirs);
+
+    const merged: Record<string, JsonObject> = {};
+    for (const [id, content] of state) {
+      merged[id] = deepClone(content);
+    }
+
+    if (conflicts.length > 0) {
+      return { merged, conflicts, applied: false };
+    }
+
+    this.apply(target, state);
+    // The source is now an ancestor of the target, so it becomes the base for
+    // any later merge between the two.
+    this.setBase(target.name, source.name, theirs);
+
+    return { merged, conflicts, applied: true };
+  }
+
+  // --- Internals -----------------------------------------------------------
+
+  private apply(branch: Branch, state: State): void {
+    for (const [id, content] of state) {
+      const record = branch.documents.get(id);
+      if (!record) {
+        branch.documents.set(id, { content, history: [this.newVersion(content)] });
+      } else if (!deepEqual(record.content, content)) {
+        record.content = content;
+        record.history.push(this.newVersion(content));
+      }
+    }
+    for (const id of [...branch.documents.keys()]) {
+      if (!state.has(id)) branch.documents.delete(id);
+    }
+  }
+
+  private snapshot(branch: Branch): State {
+    const state: State = new Map();
+    for (const [id, record] of branch.documents) {
+      state.set(id, record.content);
+    }
+    return state;
+  }
+
+  private getBase(a: string, b: string): State | undefined {
+    return this.bases.get(a)?.get(b);
+  }
+
+  private setBase(a: string, b: string, state: State): void {
+    upsert(this.bases, a).set(b, state);
+    upsert(this.bases, b).set(a, state);
+  }
+
+  private branch(): Branch {
+    return this.branches.get(this.currentBranch) as Branch;
+  }
+
+  private record(id: string): DocumentRecord {
+    assertDocumentId(id);
+    const branch = this.branch();
+    const record = branch.documents.get(id);
+    if (!record) {
+      throw new Error(`Document "${id}" not found on branch "${branch.name}"`);
+    }
+    return record;
+  }
+
+  private newVersion(content: JsonObject): Version {
+    // Clamped so versions are never ordered inconsistently with their history,
+    // even when several writes land inside the same millisecond.
+    const timestamp = Math.max(Date.now(), this.lastTimestamp);
+    this.lastTimestamp = timestamp;
+    this.versionCounter += 1;
+    return { id: `v${this.versionCounter}`, timestamp, content };
+  }
+}
+
+function upsert(map: Map<string, Map<string, State>>, key: string): Map<string, State> {
+  let inner = map.get(key);
+  if (!inner) {
+    inner = new Map();
+    map.set(key, inner);
+  }
+  return inner;
+}
+
+function assertDocumentId(id: string): void {
+  if (typeof id !== 'string' || id === '') {
+    throw new TypeError('Document id must be a non-empty string');
+  }
+}
+
+function assertBranchName(name: string): void {
+  if (typeof name !== 'string' || name === '') {
+    throw new TypeError('Branch name must be a non-empty string');
+  }
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..4b4b50b
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,40 @@
+/** Public types for the versioned document store. */
+
+export type JsonPrimitive = string | number | boolean | null;
+export type JsonValue = JsonPrimitive | JsonValue[] | { [key: string]: JsonValue };
+export type JsonObject = { [key: string]: JsonValue };
+
+/** A point-in-time snapshot of a document, produced by every `create` and `update`. */
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: JsonObject;
+}
+
+/**
+ * A field both branches changed to different values.
+ *
+ * `path` is a dot-separated path into the document (e.g. `"a.b.c"`); the empty
+ * string denotes the document root, which is used for delete/modify conflicts.
+ * A value of `undefined` means the field (or document) was absent on that side.
+ */
+export interface Conflict {
+  documentId: string;
+  path: string;
+  base: JsonValue | undefined;
+  ours: JsonValue | undefined;
+  theirs: JsonValue | undefined;
+}
+
+export interface MergeResult {
+  /** The full resulting document set, keyed by document id. */
+  merged: Record<string, JsonObject>;
+  conflicts: Conflict[];
+  /** True when the merge was auto-applied to the current branch. */
+  applied: boolean;
+}
+
+export interface DocumentStoreOptions {
+  /** Name of the initial branch. Defaults to `"main"`. */
+  defaultBranch?: string;
+}
