+// Express REST routes for document CRUD and version history.
+
+import { Router, type Request, type Response } from 'express';
+import { randomUUID } from 'node:crypto';
+import type { DB } from './db.js';
+import type { Document, Version } from './models.js';
+
+export interface RouterHooks {
+  /** Called after a document is deleted so its live WS room can be evicted. */
+  onDocumentDeleted?: (docId: string) => void;
+}
+
+export function createRouter(db: DB, hooks: RouterHooks = {}): Router {
+  const router = Router();
+
+  const getDoc = db.prepare('SELECT * FROM documents WHERE id = ?');
+  const listDocs = db.prepare('SELECT * FROM documents ORDER BY created_at ASC, id ASC');
+  const insertDoc = db.prepare(
+    'INSERT INTO documents (id, title, content) VALUES (?, ?, ?)'
+  );
+  const insertVersion = db.prepare(
+    'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+  );
+  const deleteDoc = db.prepare('DELETE FROM documents WHERE id = ?');
+  const listVersions = db.prepare(
+    'SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC'
+  );
+  const getVersion = db.prepare(
+    'SELECT * FROM versions WHERE document_id = ? AND version = ?'
+  );
+
+  // Create a document (and its initial version 0).
+  router.post('/docs', (req: Request, res: Response) => {
+    const title = typeof req.body?.title === 'string' ? req.body.title : 'Untitled';
+    const content = typeof req.body?.content === 'string' ? req.body.content : '';
+    const id = randomUUID();
+    insertDoc.run(id, title, content);
+    insertVersion.run(id, 0, content, null);
+    const doc = getDoc.get(id) as Document;
+    res.status(201).json(doc);
+  });
+
+  // List all documents.
+  router.get('/docs', (_req: Request, res: Response) => {
+    res.json(listDocs.all() as Document[]);
+  });
+
+  // Get a single document.
+  router.get('/docs/:id', (req: Request, res: Response) => {
+    const doc = getDoc.get(req.params.id) as Document | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  // Update a document's title and/or content.
+  router.put('/docs/:id', (req: Request, res: Response) => {
+    const existing = getDoc.get(req.params.id) as Document | undefined;
+    if (!existing) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const title = typeof req.body?.title === 'string' ? req.body.title : existing.title;
+    const content = typeof req.body?.content === 'string' ? req.body.content : existing.content;
+    db.prepare(
+      "UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?"
+    ).run(title, content, req.params.id);
+    res.json(getDoc.get(req.params.id) as Document);
+  });
+
+  // Delete a document (cascades to versions and connections).
+  router.delete('/docs/:id', (req: Request, res: Response) => {
+    const existing = getDoc.get(req.params.id) as Document | undefined;
+    if (!existing) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    deleteDoc.run(req.params.id);
+    hooks.onDocumentDeleted?.(req.params.id);
+    res.status(204).end();
+  });
+
+  // List a document's version history.
+  router.get('/docs/:id/versions', (req: Request, res: Response) => {
+    res.json(listVersions.all(req.params.id) as Version[]);
+  });
+
+  // Get a specific version's content.
+  router.get('/docs/:id/versions/:version', (req: Request, res: Response) => {
+    const version = Number(req.params.version);
+    const row = getVersion.get(req.params.id, version) as Version | undefined;
+    if (!row) {
+      res.status(404).json({ error: 'Version not found' });
+      return;
+    }
+    res.json(row);
+  });
+
+  return router;
+}
diff --git a/src/server.ts b/src/server.ts
new file mode 100644
index 0000000..fe34284
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,75 @@
+// Combines the Express REST API and the WebSocket server on a single port.
+
+import express, { type Express, json } from 'express';
+import { createServer, type Server } from 'node:http';
+import { type WebSocketServer } from 'ws';
+import { createDatabase, type DB } from './db.js';
+import { createRouter } from './routes.js';
+import { setupWebSocket } from './ws.js';
+
+export interface AppInstance {
+  app: Express;
+  server: Server;
+  wss: WebSocketServer;
+  db: DB;
+  /** Start listening; resolves with the actual port (use 0 for a random one). */
+  start: (port?: number) => Promise<number>;
+  /** Cleanly shut down all connections, the server, and the database. */
+  stop: () => Promise<void>;
+}
+
+export function createApp(dbPath?: string): AppInstance {
+  const db = createDatabase(dbPath);
+
+  const app = express();
+  app.use(json());
+
+  const server = createServer(app);
+  const { wss, closeRoom } = setupWebSocket(server, db);
+
+  // Routes are registered after the WS layer so deletes can evict live rooms.
+  app.use(createRouter(db, { onDocumentDeleted: closeRoom }));
+
+  function start(port = 0): Promise<number> {
+    return new Promise((resolve, reject) => {
+      server.once('error', reject);
+      server.listen(port, () => {
+        server.removeListener('error', reject);
+        const address = server.address();
+        const actualPort =
+          address && typeof address === 'object' ? address.port : port;
+        resolve(actualPort);
+      });
+    });
+  }
+
+  function stop(): Promise<void> {
+    return new Promise((resolve) => {
+      for (const client of wss.clients) {
+        client.terminate();
+      }
+      wss.close(() => {
+        server.close(() => {
+          try {
+            db.close();
+          } catch {
+            // already closed
+          }
+          resolve();
+        });
+      });
+    });
+  }
+
+  return { app, server, wss, db, start, stop };
+}
+
+// Allow running the server directly: `node dist/server.js`.
+if (process.argv[1] && import.meta.url === `file://${process.argv[1]}`) {
+  const instance = createApp(process.env.DB_PATH);
+  const port = Number(process.env.PORT) || 3000;
+  instance.start(port).then((actual) => {
+    // eslint-disable-next-line no-console
+    console.log(`Collab server listening on http://localhost:${actual}`);
+  });
+}
diff --git a/src/ws.ts b/src/ws.ts
new file mode 100644
index 0000000..a76e2f7
--- /dev/null
+++ b/src/ws.ts
@@ -0,0 +1,206 @@
+// WebSocket server: one room per document, server-authoritative OT.
+//
+// Each message handler runs synchronously (better-sqlite3 is synchronous), so
+// operations on a given document are processed one at a time in arrival order —
+// there is no interleaving that could corrupt the document or its version.
+
+import { WebSocketServer, WebSocket } from 'ws';
+import { randomUUID } from 'node:crypto';
+import type { Server } from 'node:http';
+import type { DB } from './db.js';
+import type { Document, Operation } from './models.js';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+
+interface Room {
+  docId: string;
+  content: string;
+  version: number;
+  /** Operations applied this session, keyed by the version they produced. */
+  history: { version: number; op: Operation }[];
+  clients: Set<WebSocket>;
+}
+
+export interface WsHandle {
+  wss: WebSocketServer;
+  rooms: Map<string, Room>;
+  /** Evict a room (e.g. after its document is deleted) and close its clients. */
+  closeRoom: (docId: string) => void;
+}
+
+function send(ws: WebSocket, payload: Record<string, unknown>): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify(payload));
+  }
+}
+
+export function setupWebSocket(server: Server, db: DB): WsHandle {
+  const wss = new WebSocketServer({ server });
+  const rooms = new Map<string, Room>();
+
+  const getDoc = db.prepare('SELECT * FROM documents WHERE id = ?');
+  const maxVersion = db.prepare(
+    'SELECT MAX(version) AS v FROM versions WHERE document_id = ?'
+  );
+  const sessionOps = db.prepare(
+    'SELECT version, operation FROM versions WHERE document_id = ? AND operation IS NOT NULL ORDER BY version ASC'
+  );
+  const insertVersion = db.prepare(
+    'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+  );
+  const updateDoc = db.prepare(
+    "UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?"
+  );
+  const addConn = db.prepare(
+    'INSERT INTO active_connections (id, document_id) VALUES (?, ?)'
+  );
+  const removeConn = db.prepare('DELETE FROM active_connections WHERE id = ?');
+
+  function loadRoom(docId: string): Room | null {
+    const existing = rooms.get(docId);
+    if (existing) return existing;
+
+    const doc = getDoc.get(docId) as Document | undefined;
+    if (!doc) return null;
+
+    const versionRow = maxVersion.get(docId) as { v: number | null };
+    const version = versionRow.v ?? 0;
+    const history = (sessionOps.all(docId) as { version: number; operation: string }[]).map(
+      (r) => ({ version: r.version, op: JSON.parse(r.operation) as Operation })
+    );
+
+    const room: Room = { docId, content: doc.content, version, history, clients: new Set() };
+    rooms.set(docId, room);
+    return room;
+  }
+
+  const persistTx = db.transaction(
+    (docId: string, content: string, version: number, op: Operation) => {
+      insertVersion.run(docId, version, content, JSON.stringify(op));
+      updateDoc.run(content, docId);
+    }
+  );
+
+  function persist(docId: string, content: string, version: number, op: Operation): void {
+    persistTx(docId, content, version, op);
+  }
+
+  function handleOperation(ws: WebSocket, room: Room, msg: Record<string, unknown>): void {
+    const rawOp = msg.operation as Operation | undefined;
+    const baseVersion =
+      typeof msg.version === 'number' ? msg.version : room.version;
+
+    // Structural type check before any transform.
+    if (!rawOp || (rawOp.type !== 'insert' && rawOp.type !== 'delete')) {
+      send(ws, { type: 'error', message: 'Invalid operation type' });
+      return;
+    }
+
+    // Transform a stale op against everything applied since its base version.
+    let op: Operation = rawOp;
+    if (baseVersion < room.version) {
+      for (const entry of room.history) {
+        if (entry.version > baseVersion) {
+          op = transformOperation(op, entry.op);
+        }
+      }
+    }
+
+    // Bounds-check the (possibly transformed) op against the live content.
+    if (!validateOperation(op, room.content.length)) {
+      send(ws, { type: 'error', message: 'Operation out of bounds' });
+      return;
+    }
+
+    // Compute the result, persist it, and only then commit to in-memory state.
+    // If persistence fails (e.g. the document was deleted out from under the
+    // room), the room stays consistent with the DB and the process survives.
+    const newContent = applyOperation(room.content, op);
+    const newVersion = room.version + 1;
+    try {
+      persist(room.docId, newContent, newVersion, op);
+    } catch {
+      send(ws, { type: 'error', message: 'Failed to persist operation' });
+      return;
+    }
+    room.content = newContent;
+    room.version = newVersion;
+    room.history.push({ version: newVersion, op });
+
+    send(ws, { type: 'ack', version: newVersion });
+
+    const broadcast = JSON.stringify({ type: 'operation', operation: op, version: newVersion });
+    for (const client of room.clients) {
+      if (client !== ws && client.readyState === WebSocket.OPEN) {
+        client.send(broadcast);
+      }
+    }
+  }
+
+  wss.on('connection', (ws: WebSocket, req) => {
+    const rawPath = (req.url ?? '/').split('?')[0];
+    const docId = decodeURIComponent(rawPath.replace(/^\//, ''));
+
+    const room = loadRoom(docId);
+    if (!room) {
+      send(ws, { type: 'error', message: 'Document not found' });
+      ws.close();
+      return;
+    }
+
+    const connId = randomUUID();
+    try {
+      addConn.run(connId, docId);
+    } catch {
+      // Document vanished between the existence check and here.
+      send(ws, { type: 'error', message: 'Document not found' });
+      ws.close();
+      return;
+    }
+    room.clients.add(ws);
+
+    send(ws, { type: 'sync', content: room.content, version: room.version });
+
+    ws.on('message', (data: WebSocket.RawData) => {
+      let msg: Record<string, unknown>;
+      try {
+        msg = JSON.parse(data.toString());
+      } catch {
+        send(ws, { type: 'error', message: 'Invalid JSON' });
+        return;
+      }
+      if (msg.type !== 'operation') return;
+      // Backstop: never let an unexpected throw escape into an uncaughtException.
+      try {
+        handleOperation(ws, room, msg);
+      } catch {
+        send(ws, { type: 'error', message: 'Failed to process operation' });
+      }
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      removeConn.run(connId);
+    });
+
+    // Never let a socket-level error crash the process.
+    ws.on('error', () => {
+      room.clients.delete(ws);
+    });
+  });
+
+  function closeRoom(docId: string): void {
+    const room = rooms.get(docId);
+    if (!room) return;
+    rooms.delete(docId);
+    for (const client of room.clients) {
+      try {
+        client.close();
+      } catch {
+        // best effort
+      }
+    }
+    room.clients.clear();
+  }
+
+  return { wss, rooms, closeRoom };
+}
