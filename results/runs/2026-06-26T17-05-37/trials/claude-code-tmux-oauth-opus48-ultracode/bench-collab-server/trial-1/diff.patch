+// Operational Transform core.
+//
+// The server is the single authoritative transform point: every client op
+// carries the base `version` it was composed against. When that base is older
+// than the server's current version, the op is transformed against each
+// operation that has been applied since, then applied to the live document.
+// Because all transforms happen in one place against a totally-ordered log,
+// the result is deterministic and all clients converge.
+
+import type { Operation } from './models.js';
+
+/** Apply an operation to document content, returning the new content. */
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  // delete
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+/**
+ * Transform `op1` so that it can be applied *after* the already-applied `op2`.
+ * `op2` is treated as the prior (concurrent) operation; `op1`'s position is
+ * shifted to account for the characters `op2` inserted or removed.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op2.type === 'insert') {
+    return transformAgainstInsert(op1, op2.position, op2.text.length);
+  }
+  return transformAgainstDelete(op1, op2.position, op2.count);
+}
+
+function transformAgainstInsert(op1: Operation, insPos: number, insLen: number): Operation {
+  if (op1.type === 'delete') {
+    // Insert at/before the delete start: the whole delete shifts right.
+    if (insPos <= op1.position) {
+      return { ...op1, position: op1.position + insLen };
+    }
+    // Insert strictly inside the delete range: absorb it so the delete spans
+    // the inserted text too (a single contiguous delete can't skip the middle).
+    // Without this the delete would remove the wrong characters and corrupt
+    // the document for every client.
+    if (insPos < op1.position + op1.count) {
+      return { ...op1, count: op1.count + insLen };
+    }
+    // Insert at/after the delete end: the delete is unaffected.
+    return op1;
+  }
+
+  // op1 is an insert. Anything at or after the insertion point shifts right.
+  // Tie-break: an op at the exact insertion point moves *after* the inserted
+  // text so concurrent inserts at the same spot both survive deterministically.
+  if (op1.position >= insPos) {
+    return { ...op1, position: op1.position + insLen };
+  }
+  return op1;
+}
+
+function transformAgainstDelete(op1: Operation, delPos: number, delCount: number): Operation {
+  const delEnd = delPos + delCount;
+
+  if (op1.type === 'insert') {
+    if (op1.position <= delPos) return op1;
+    if (op1.position >= delEnd) return { ...op1, position: op1.position - delCount };
+    // Insertion landed inside the removed range: collapse to the deletion start.
+    return { ...op1, position: delPos };
+  }
+
+  // op1 is a delete being transformed against another delete.
+  const op1End = op1.position + op1.count;
+  if (op1.position >= delEnd) {
+    return { ...op1, position: op1.position - delCount };
+  }
+  if (op1End <= delPos) {
+    return op1;
+  }
+  // Overlapping deletes: remove only the portion that op2 did not already delete.
+  const start = Math.min(op1.position, delPos);
+  const overlap = Math.min(op1End, delEnd) - Math.max(op1.position, delPos);
+  const newCount = Math.max(0, op1.count - Math.max(0, overlap));
+  return { ...op1, position: start, count: newCount };
+}
+
+/** Validate that an operation is well-formed and within bounds for `contentLength`. */
+export function validateOperation(op: unknown, contentLength: number): op is Operation {
+  if (!op || typeof op !== 'object') return false;
+  const candidate = op as Record<string, unknown>;
+
+  if (candidate.type === 'insert') {
+    const { position, text } = candidate;
+    if (typeof position !== 'number' || !Number.isInteger(position)) return false;
+    if (typeof text !== 'string') return false;
+    return position >= 0 && position <= contentLength;
+  }
+
+  if (candidate.type === 'delete') {
+    const { position, count } = candidate;
+    if (typeof position !== 'number' || !Number.isInteger(position)) return false;
+    if (typeof count !== 'number' || !Number.isInteger(count)) return false;
+    if (position < 0 || count < 0) return false;
+    return position + count <= contentLength;
+  }
+
+  return false;
+}
