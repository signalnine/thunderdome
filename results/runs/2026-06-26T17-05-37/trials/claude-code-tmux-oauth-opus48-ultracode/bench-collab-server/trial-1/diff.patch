+// Data model interfaces shared across the collab server.
+
+/** A persisted document row. */
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+/** A stored version (snapshot) of a document. */
+export interface Version {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  /** JSON-encoded operation that produced this version (null for the initial version 0). */
+  operation: string | null;
+  created_at: string;
+}
+
+/** Insert `text` at `position`. */
+export interface InsertOperation {
+  type: 'insert';
+  position: number;
+  text: string;
+}
+
+/** Delete `count` characters starting at `position`. */
+export interface DeleteOperation {
+  type: 'delete';
+  position: number;
+  count: number;
+}
+
+export type Operation = InsertOperation | DeleteOperation;
+
+/** Messages exchanged over the WebSocket. */
+export interface OperationMessage {
+  type: 'operation';
+  operation: Operation;
+  version?: number;
+}
+
+export interface AckMessage {
+  type: 'ack';
+  version: number;
+}
+
+export interface SyncMessage {
+  type: 'sync';
+  content: string;
+  version: number;
+}
+
+export interface ErrorMessage {
+  type: 'error';
+  message: string;
+}
+
+export type ServerMessage = AckMessage | SyncMessage | ErrorMessage | OperationMessage;
