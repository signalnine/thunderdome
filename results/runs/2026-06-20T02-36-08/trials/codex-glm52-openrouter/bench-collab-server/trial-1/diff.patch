+import Database from 'better-sqlite3';
+import type { Database as DBType } from 'better-sqlite3';
+import { readFileSync } from 'node:fs';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import type { Document, Version } from './models.js';
+
+const __dirname = dirname(fileURLToPath(import.meta.url));
+
+export function openDatabase(dbPath?: string): DBType {
+  const db = new Database(dbPath ?? ':memory:');
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+  applySchema(db);
+  return db;
+}
+
+function applySchema(db: DBType): void {
+  let schemaPath: string;
+  const candidates = [
+    join(process.cwd(), 'schema.sql'),
+    join(__dirname, 'schema.sql'),
+    join(__dirname, '..', 'schema.sql'),
+    resolve(process.cwd(), 'schema.sql'),
+  ];
+  let found = false;
+  for (const candidate of candidates) {
+    try {
+      readFileSync(candidate, 'utf-8');
+      schemaPath = candidate;
+      found = true;
+      break;
+    } catch {
+      continue;
+    }
+  }
+  if (!found) {
+    throw new Error('schema.sql not found');
+  }
+  const schema = readFileSync(schemaPath!, 'utf-8');
+  db.exec(schema);
+}
+
+export function createDocument(
+  db: DBType,
+  title: string,
+  content = '',
+  id?: string,
+): Document {
+  const docId = id ?? generateId();
+  const now = new Date().toISOString();
+  db.prepare(
+    'INSERT INTO documents (id, title, content, created_at, updated_at) VALUES (?, ?, ?, ?, ?)',
+  ).run(docId, title, content, now, now);
+  const doc = getDocument(db, docId);
+  if (!doc) {
+    throw new Error('Failed to create document');
+  }
+  recordVersion(db, docId, 0, content, null);
+  return doc;
+}
+
+export function getDocument(db: DBType, id: string): Document | undefined {
+  const row = db
+    .prepare('SELECT * FROM documents WHERE id = ?')
+    .get(id) as Document | undefined;
+  return row;
+}
+
+export function listDocuments(db: DBType): Document[] {
+  return db
+    .prepare('SELECT * FROM documents ORDER BY created_at ASC')
+    .all() as Document[];
+}
+
+export function updateDocument(
+  db: DBType,
+  id: string,
+  fields: { title?: string; content?: string },
+): Document | undefined {
+  const existing = getDocument(db, id);
+  if (!existing) {
+    return undefined;
+  }
+  const title = fields.title ?? existing.title;
+  const content = fields.content ?? existing.content;
+  const now = new Date().toISOString();
+  db.prepare(
+    'UPDATE documents SET title = ?, content = ?, updated_at = ? WHERE id = ?',
+  ).run(title, content, now, id);
+  return getDocument(db, id);
+}
+
+export function deleteDocument(db: DBType, id: string): boolean {
+  const result = db.prepare('DELETE FROM documents WHERE id = ?').run(id);
+  return result.changes > 0;
+}
+
+export function getCurrentVersion(db: DBType, documentId: string): number {
+  const row = db
+    .prepare(
+      'SELECT MAX(version) as maxVersion FROM versions WHERE document_id = ?',
+    )
+    .get(documentId) as { maxVersion: number | null } | undefined;
+  if (!row || row.maxVersion === null) {
+    return 0;
+  }
+  return row.maxVersion;
+}
+
+export function recordVersion(
+  db: DBType,
+  documentId: string,
+  version: number,
+  content: string,
+  operation: unknown | null,
+): Version {
+  const opJson = operation ? JSON.stringify(operation) : null;
+  const result = db
+    .prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)',
+    )
+    .run(documentId, version, content, opJson);
+  const row = db
+    .prepare('SELECT * FROM versions WHERE id = ?')
+    .get(result.lastInsertRowid) as Version;
+  return row;
+}
+
+export function listVersions(db: DBType, documentId: string): Version[] {
+  return db
+    .prepare(
+      'SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC',
+    )
+    .all(documentId) as Version[];
+}
+
+export function getVersion(
+  db: DBType,
+  documentId: string,
+  version: number,
+): Version | undefined {
+  return db
+    .prepare(
+      'SELECT * FROM versions WHERE document_id = ? AND version = ?',
+    )
+    .get(documentId, version) as Version | undefined;
+}
+
+export function addConnection(db: DBType, connId: string, documentId: string): void {
+  db.prepare(
+    'INSERT INTO active_connections (id, document_id) VALUES (?, ?)',
+  ).run(connId, documentId);
+}
+
+export function removeConnection(db: DBType, connId: string): void {
+  db.prepare('DELETE FROM active_connections WHERE id = ?').run(connId);
+}
+
+export function clearConnections(db: DBType): void {
+  db.prepare('DELETE FROM active_connections').run();
+}
+
+function generateId(): string {
+  return (
+    Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10)
+  );
+}
