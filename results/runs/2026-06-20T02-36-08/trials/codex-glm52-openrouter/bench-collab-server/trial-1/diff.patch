+import { Router, type Request, type Response } from 'express';
+import type { Database as DBType } from 'better-sqlite3';
+import {
+  createDocument,
+  deleteDocument,
+  getDocument,
+  getVersion,
+  listDocuments,
+  listVersions,
+  updateDocument,
+} from './db.js';
+
+export function createRouter(db: DBType): Router {
+  const router = Router();
+
+  router.post('/docs', (req: Request, res: Response) => {
+    const title = req.body?.title;
+    const content = req.body?.content ?? '';
+    if (!title) {
+      res.status(400).json({ error: 'Title is required' });
+      return;
+    }
+    const doc = createDocument(db, title, content);
+    res.status(201).json(doc);
+  });
+
+  router.get('/docs', (_req: Request, res: Response) => {
+    const docs = listDocuments(db);
+    res.json(docs);
+  });
+
+  router.get('/docs/:id', (req: Request, res: Response) => {
+    const doc = getDocument(db, req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  router.put('/docs/:id', (req: Request, res: Response) => {
+    const fields: { title?: string; content?: string } = {};
+    if (req.body?.title !== undefined) {
+      fields.title = req.body.title;
+    }
+    if (req.body?.content !== undefined) {
+      fields.content = req.body.content;
+    }
+    const doc = updateDocument(db, req.params.id, fields);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  router.delete('/docs/:id', (req: Request, res: Response) => {
+    const deleted = deleteDocument(db, req.params.id);
+    if (!deleted) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.status(204).send();
+  });
+
+  router.get('/docs/:id/versions', (req: Request, res: Response) => {
+    const doc = getDocument(db, req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const versions = listVersions(db, req.params.id);
+    res.json(versions);
+  });
+
+  router.get('/docs/:id/versions/:version', (req: Request, res: Response) => {
+    const doc = getDocument(db, req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const version = parseInt(req.params.version, 10);
+    if (!Number.isInteger(version)) {
+      res.status(400).json({ error: 'Invalid version' });
+      return;
+    }
+    const ver = getVersion(db, req.params.id, version);
+    if (!ver) {
+      res.status(404).json({ error: 'Version not found' });
+      return;
+    }
+    res.json(ver);
+  });
+
+  return router;
+}
