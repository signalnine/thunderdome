+import { WebSocketServer, WebSocket } from 'ws';
+import type { IncomingMessage } from 'node:http';
+import type { Server } from 'node:http';
+import type { Database as DBType } from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+import type { Operation } from './models.js';
+import {
+  addConnection,
+  getCurrentVersion,
+  getDocument,
+  recordVersion,
+  removeConnection,
+} from './db.js';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+
+interface ClientInfo {
+  ws: WebSocket;
+  documentId: string;
+  connId: string;
+}
+
+interface RoomState {
+  documentId: string;
+  content: string;
+  version: number;
+  history: Operation[];
+  clients: Map<WebSocket, ClientInfo>;
+}
+
+export class CollabServer {
+  private wss: WebSocketServer;
+  private rooms = new Map<string, RoomState>();
+  private clients = new Map<WebSocket, ClientInfo>();
+  private db: DBType;
+
+  constructor(server: Server, db: DBType) {
+    this.db = db;
+    this.wss = new WebSocketServer({ server });
+    this.wss.on('connection', (ws: WebSocket, req: IncomingMessage) => {
+      this.handleConnection(ws, req);
+    });
+  }
+
+  getWebSocketServer(): WebSocketServer {
+    return this.wss;
+  }
+
+  private handleConnection(ws: WebSocket, req: IncomingMessage): void {
+    const url = req.url ?? '';
+    const path = url.split('?')[0];
+    const docId = decodeURIComponent(path.replace(/^\/+/, ''));
+
+    const doc = getDocument(this.db, docId);
+    if (!doc) {
+      ws.send(
+        JSON.stringify({
+          type: 'error',
+          message: `Document ${docId} not found`,
+        }),
+      );
+      ws.close();
+      return;
+    }
+
+    const connId = randomUUID();
+    addConnection(this.db, connId, docId);
+
+    let room = this.rooms.get(docId);
+    if (!room) {
+      const version = getCurrentVersion(this.db, docId);
+      room = {
+        documentId: docId,
+        content: doc.content,
+        version,
+        history: [],
+        clients: new Map(),
+      };
+      this.rooms.set(docId, room);
+    } else {
+      room.version = getCurrentVersion(this.db, docId);
+      room.content = doc.content;
+    }
+
+    const clientInfo: ClientInfo = { ws, documentId: docId, connId };
+    room.clients.set(ws, clientInfo);
+    this.clients.set(ws, clientInfo);
+
+    ws.send(
+      JSON.stringify({
+        type: 'sync',
+        content: room.content,
+        version: room.version,
+      }),
+    );
+
+    ws.on('message', (data: unknown) => {
+      this.handleMessage(ws, data);
+    });
+
+    ws.on('close', () => {
+      this.handleClose(ws);
+    });
+
+    ws.on('error', () => {
+      this.handleClose(ws);
+    });
+  }
+
+  private handleMessage(ws: WebSocket, data: unknown): void {
+    const clientInfo = this.clients.get(ws);
+    if (!clientInfo) {
+      return;
+    }
+
+    let parsed: Record<string, unknown>;
+    try {
+      const text =
+        typeof data === 'string'
+          ? data
+          : Buffer.isBuffer(data)
+            ? data.toString()
+            : (data as { toString: () => string }).toString();
+      parsed = JSON.parse(text) as Record<string, unknown>;
+    } catch {
+      this.sendError(ws, 'Invalid JSON');
+      return;
+    }
+
+    if (parsed.type !== 'operation') {
+      this.sendError(ws, 'Unknown message type');
+      return;
+    }
+
+    const rawOp = parsed.operation as Record<string, unknown>;
+    if (!rawOp || typeof rawOp !== 'object') {
+      this.sendError(ws, 'Missing operation');
+      return;
+    }
+
+    const op = this.parseOperation(rawOp);
+    if (!op) {
+      this.sendError(ws, 'Invalid operation');
+      return;
+    }
+
+    const room = this.rooms.get(clientInfo.documentId);
+    if (!room) {
+      this.sendError(ws, 'Room not found');
+      return;
+    }
+
+    const clientVersion =
+      typeof parsed.version === 'number' ? parsed.version : room.version;
+
+    try {
+      let transformedOp = op;
+
+      if (clientVersion < room.version) {
+        const opsSince = room.history.slice(
+          Math.min(clientVersion, room.history.length),
+        );
+        for (const priorOp of opsSince) {
+          transformedOp = transformOperation(transformedOp, priorOp);
+        }
+      }
+
+      validateOperation(transformedOp, room.content.length);
+
+      const newContent = applyOperation(room.content, transformedOp);
+      room.content = newContent;
+      room.version += 1;
+      room.history.push(transformedOp);
+
+      recordVersion(
+        this.db,
+        room.documentId,
+        room.version,
+        newContent,
+        transformedOp,
+      );
+
+      this.updateDocumentContent(room.documentId, newContent);
+
+      ws.send(
+        JSON.stringify({
+          type: 'ack',
+          version: room.version,
+        }),
+      );
+
+      const broadcastMsg = JSON.stringify({
+        type: 'operation',
+        operation: transformedOp,
+        version: room.version,
+      });
+      for (const [clientWs] of room.clients) {
+        if (clientWs !== ws && clientWs.readyState === WebSocket.OPEN) {
+          clientWs.send(broadcastMsg);
+        }
+      }
+    } catch (err) {
+      this.sendError(ws, (err as Error).message);
+    }
+  }
+
+  private parseOperation(
+    raw: Record<string, unknown>,
+  ): Operation | null {
+    if (raw.type === 'insert') {
+      if (
+        typeof raw.position !== 'number' ||
+        typeof raw.text !== 'string'
+      ) {
+        return null;
+      }
+      return { type: 'insert', position: raw.position, text: raw.text };
+    }
+    if (raw.type === 'delete') {
+      if (
+        typeof raw.position !== 'number' ||
+        typeof raw.count !== 'number'
+      ) {
+        return null;
+      }
+      return { type: 'delete', position: raw.position, count: raw.count };
+    }
+    return null;
+  }
+
+  private updateDocumentContent(documentId: string, content: string): void {
+    const now = new Date().toISOString();
+    this.db
+      .prepare(
+        'UPDATE documents SET content = ?, updated_at = ? WHERE id = ?',
+      )
+      .run(content, now, documentId);
+  }
+
+  private handleClose(ws: WebSocket): void {
+    const clientInfo = this.clients.get(ws);
+    if (!clientInfo) {
+      return;
+    }
+    this.clients.delete(ws);
+    removeConnection(this.db, clientInfo.connId);
+
+    const room = this.rooms.get(clientInfo.documentId);
+    if (room) {
+      room.clients.delete(ws);
+      if (room.clients.size === 0) {
+        this.rooms.delete(clientInfo.documentId);
+      }
+    }
+  }
+
+  private sendError(ws: WebSocket, message: string): void {
+    if (ws.readyState === WebSocket.OPEN) {
+      ws.send(JSON.stringify({ type: 'error', message }));
+    }
+  }
+
+  closeAll(): void {
+    for (const [ws, clientInfo] of this.clients) {
+      removeConnection(this.db, clientInfo.connId);
+      try {
+        ws.close();
+      } catch {
+        // ignore
+      }
+      this.clients.delete(ws);
+    }
+    this.rooms.clear();
+    this.wss.close();
+  }
+}
