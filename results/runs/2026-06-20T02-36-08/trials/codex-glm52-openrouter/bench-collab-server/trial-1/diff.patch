@@ -0,0 +1,163 @@
+import type { Operation } from './models.js';
+
+export function validateOperation(
+  op: Operation,
+  contentLength: number,
+): void {
+  if (op.type === 'insert') {
+    if (
+      typeof op.position !== 'number' ||
+      !Number.isInteger(op.position) ||
+      op.position < 0 ||
+      op.position > contentLength
+    ) {
+      throw new Error('Invalid insert position');
+    }
+    if (typeof op.text !== 'string') {
+      throw new Error('Invalid insert text');
+    }
+  } else if (op.type === 'delete') {
+    if (
+      typeof op.position !== 'number' ||
+      !Number.isInteger(op.position) ||
+      op.position < 0 ||
+      op.position > contentLength
+    ) {
+      throw new Error('Invalid delete position');
+    }
+    if (
+      typeof op.count !== 'number' ||
+      !Number.isInteger(op.count) ||
+      op.count <= 0 ||
+      op.position + op.count > contentLength
+    ) {
+      throw new Error('Invalid delete count');
+    }
+  } else {
+    throw new Error('Invalid operation type');
+  }
+}
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return (
+      content.slice(0, op.position) + op.text + content.slice(op.position)
+    );
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    return {
+      type: 'insert',
+      position: transformInsertInsert(
+        op1.position,
+        op2.position,
+        op2.text.length,
+      ),
+      text: op1.text,
+    };
+  }
+
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    return {
+      type: 'insert',
+      position: transformInsertDelete(
+        op1.position,
+        op2.position,
+        op2.count,
+      ),
+      text: op1.text,
+    };
+  }
+
+  if (op1.type === 'delete' && op2.type === 'insert') {
+    return {
+      type: 'delete',
+      position: transformDeleteInsertPosition(
+        op1.position,
+        op2.position,
+        op2.text.length,
+      ),
+      count: op1.count,
+    };
+  }
+
+  if (op1.type === 'delete' && op2.type === 'delete') {
+    const result = transformDeleteDelete(
+      op1.position,
+      op1.count,
+      op2.position,
+      op2.count,
+    );
+    return { type: 'delete', position: result.position, count: result.count };
+  }
+
+  return op1;
+}
+
+function transformInsertInsert(
+  pos1: number,
+  pos2: number,
+  len2: number,
+): number {
+  if (pos1 <= pos2) {
+    return pos1;
+  }
+  return pos1 + len2;
+}
+
+function transformInsertDelete(
+  pos1: number,
+  pos2: number,
+  count2: number,
+): number {
+  if (pos1 <= pos2) {
+    return pos1;
+  }
+  if (pos1 >= pos2 + count2) {
+    return pos1 - count2;
+  }
+  return pos2;
+}
+
+function transformDeleteInsertPosition(
+  pos1: number,
+  pos2: number,
+  len2: number,
+): number {
+  if (pos2 <= pos1) {
+    return pos1 + len2;
+  }
+  return pos1;
+}
+
+function transformDeleteDelete(
+  pos1: number,
+  count1: number,
+  pos2: number,
+  count2: number,
+): { position: number; count: number } {
+  const end1 = pos1 + count1;
+  const end2 = pos2 + count2;
+
+  if (end1 <= pos2) {
+    return { position: pos1, count: count1 };
+  }
+  if (pos1 >= end2) {
+    return { position: pos1 - count2, count: count1 };
+  }
+
+  const overlap = Math.min(end1, end2) - Math.max(pos1, pos2);
+  const newCount = count1 - overlap;
+
+  let newPosition: number;
+  if (pos1 < pos2) {
+    newPosition = pos1;
+  } else {
+    newPosition = pos2;
+  }
+
+  return { position: newPosition, count: Math.max(0, newCount) };
+}
