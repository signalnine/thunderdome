+import express, { type Express } from 'express';
+import { createServer, type Server } from 'node:http';
+import type { WebSocketServer } from 'ws';
+import type { Database as DBType } from 'better-sqlite3';
+import { createRouter } from './routes.js';
+import { clearConnections, openDatabase } from './db.js';
+import { CollabServer } from './ws.js';
+
+export interface AppInstance {
+  app: Express;
+  server: Server;
+  wss: WebSocketServer;
+  db: DBType;
+  start: (port?: number) => Promise<number>;
+  stop: () => Promise<void>;
+}
+
+export function createApp(dbPath?: string): AppInstance {
+  const db = openDatabase(dbPath);
+  clearConnections(db);
+
+  const app = express();
+  app.use(express.json());
+  app.use('/', createRouter(db));
+
+  const server = createServer(app);
+  const collab = new CollabServer(server, db);
+
+  const start = (port = 0): Promise<number> => {
+    return new Promise((resolve, reject) => {
+      server.listen(port, () => {
+        const address = server.address();
+        const actualPort =
+          typeof address === 'object' && address ? address.port : port;
+        resolve(actualPort);
+      });
+      server.on('error', reject);
+    });
+  };
+
+  const stop = (): Promise<void> => {
+    return new Promise((resolve) => {
+      collab.closeAll();
+      server.close(() => {
+        db.close();
+        resolve();
+      });
+    });
+  };
+
+  return {
+    app,
+    server,
+    wss: collab.getWebSocketServer(),
+    db,
+    start,
+    stop,
+  };
+}
