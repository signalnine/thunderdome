+import { describe, it, expect } from 'vitest';
+import { solveToggle, solveCounter, type Machine } from '../src/index.js';
+
+function applyToggle(target: boolean[], buttons: number[][], press: number[]): boolean[] {
+  const s = target.map(() => false); // start all off
+  for (const c of press) for (const idx of buttons[c]) s[idx] = !s[idx];
+  return s;
+}
+
+function bruteToggle(machine: Machine): number[] | null {
+  const { target, buttons } = machine;
+  const M = buttons.length;
+  let best: number[] | null = null;
+  for (let mask = 0; mask < (1 << M); mask++) {
+    const press: number[] = [];
+    for (let c = 0; c < M; c++) if ((mask >> c) & 1) press.push(c);
+    const s = applyToggle(target, buttons, press);
+    if (s.every((v, i) => v === target[i])) {
+      if (best === null || press.length < best.length ||
+          (press.length === best.length && lexLessArr(press, best))) best = press;
+    }
+  }
+  return best;
+}
+
+function lexLessArr(a: number[], b: number[]): boolean {
+  for (let i = 0; i < Math.min(a.length, b.length); i++)
+    if (a[i] !== b[i]) return a[i] < b[i];
+  return a.length < b.length;
+}
+
+function bruteCounter(lights: number[], buttons: number[][], p: number): number[] | null {
+  const M = buttons.length;
+  const N = lights.length;
+  let best: number[] | null = null;
+  let bestTotal = -1;
+  const t = new Array(M).fill(0);
+  const rec = (c: number) => {
+    if (c === M) {
+      const vals = new Array(N).fill(0);
+      for (let i = 0; i < M; i++) for (const idx of buttons[i]) vals[idx] = (vals[idx] + t[i]) % p;
+      if (vals.every((v, i) => v === lights[i])) {
+        const total = t.reduce((a, x) => a + x, 0);
+        if (best === null || total < bestTotal || (total === bestTotal && lexLessArr(t, best))) {
+          best = t.slice(); bestTotal = total;
+        }
+      }
+      return;
+    }
+    for (let v = 0; v < p; v++) { t[c] = v; rec(c + 1); }
+  };
+  rec(0);
+  return best;
+}
+
+describe('solveToggle', () => {
+  it('example returns null', () => {
+    const m: Machine = {
+      target: [true, true, false, true],
+      buttons: [[0, 1], [1, 2, 3], [0, 3]],
+    };
+    expect(solveToggle(m)).toBeNull();
+  });
+
+  it('all-off target -> empty', () => {
+    const m: Machine = { target: [false, false, false], buttons: [[0, 1], [1, 2]] };
+    expect(solveToggle(m)).toEqual([]);
+  });
+
+  it('no buttons but target on -> null', () => {
+    const m: Machine = { target: [true], buttons: [] };
+    expect(solveToggle(m)).toBeNull();
+  });
+
+  it('simple solvable', () => {
+    const m: Machine = { target: [true, true], buttons: [[0, 1]] };
+    expect(solveToggle(m)).toEqual([0]);
+  });
+
+  it('chooses fewest presses (tie-break lex)', () => {
+    // two single buttons both achieve target; pick fewer (1 each) then lex -> [0]
+    const m: Machine = { target: [true], buttons: [[0], [0]] };
+    expect(solveToggle(m)).toEqual([0]);
+  });
+
+  it('matches brute force on random small', () => {
+    for (let trial = 0; trial < 300; trial++) {
+      const N = 1 + Math.floor(Math.random() * 6);
+      const M = 1 + Math.floor(Math.random() * 7);
+      const target = Array.from({ length: N }, () => Math.random() < 0.5);
+      const buttons = Array.from({ length: M }, () =>
+        Array.from({ length: 1 + Math.floor(Math.random() * 3) }, () =>
+          Math.floor(Math.random() * N)));
+      const m: Machine = { target, buttons };
+      const got = solveToggle(m);
+      const exp = bruteToggle(m);
+      if (got === null) { expect(exp).toBeNull(); continue; }
+      expect(exp).not.toBeNull();
+      // verify validity
+      const s = applyToggle(target, buttons, got!);
+      expect(s).toEqual(target);
+      // verify optimality via brute
+      expect(got!.length).toBe(exp!.length);
+      expect(got).toEqual(exp);
+    }
+  });
+});
+
+describe('solveCounter', () => {
+  it('all-zero -> zeros', () => {
+    expect(solveCounter([0, 0, 0], [[0, 1], [1, 2]], 5)).toEqual([0, 0]);
+  });
+
+  it('no buttons but nonzero -> null', () => {
+    expect(solveCounter([3], [], 5)).toBeNull();
+  });
+
+  it('basic unique', () => {
+    // x0 + x1 = 1, x0 = 1 => x1=0
+    expect(solveCounter([1, 1], [[0, 1], [0]], 7)).toEqual([1, 0]);
+  });
+
+  it('wraparound: target via multiple presses', () => {
+    // counter 0, button increments it; target 4 mod 5 => press 4 times
+    expect(solveCounter([4], [[0]], 5)).toEqual([4]);
+  });
+
+  it('matches brute force on random small', () => {
+    for (let trial = 0; trial < 200; trial++) {
+      const N = 1 + Math.floor(Math.random() * 4);
+      const M = 1 + Math.floor(Math.random() * 5);
+      const p = [2, 3, 5, 7, 11][Math.floor(Math.random() * 5)];
+      const lights = Array.from({ length: N }, () => Math.floor(Math.random() * p));
+      const buttons = Array.from({ length: M }, () =>
+        Array.from({ length: 1 + Math.floor(Math.random() * 3) }, () =>
+          Math.floor(Math.random() * N)));
+      const got = solveCounter(lights, buttons, p);
+      const exp = bruteCounter(lights, buttons, p);
+      if (got === null) { expect(exp).toBeNull(); continue; }
+      expect(exp).not.toBeNull();
+      // verify
+      const vals = new Array(N).fill(0);
+      for (let i = 0; i < M; i++) for (const idx of buttons[i]) vals[idx] = (vals[idx] + got![i]) % p;
+      expect(vals).toEqual(lights);
+      // optimal via brute
+      const gt = got!.reduce((a, x) => a + x, 0);
+      const et = exp!.reduce((a, x) => a + x, 0);
+      expect(gt).toBe(et);
+      expect(got).toEqual(exp);
+    }
+  });
+
+  it('p=2 case with free var lex tie-break', () => {
+    // N=1 counter, M=2 buttons both touching counter 0: x0 + x1 = 0 (mod 2).
+    // solutions (0,0),(1,1). min total 0 -> [0,0]
+    expect(solveCounter([0], [[0], [0]], 2)).toEqual([0, 0]);
+  });
+
+  it('p=2 free var prefers min total then lex', () => {
+    // x0 + x1 = 1 (mod 2): solutions (1,0) and (0,1). totals both 1; lex -> [0,1]
+    expect(solveCounter([1], [[0], [0]], 2)).toEqual([0, 1]);
+  });
+});
