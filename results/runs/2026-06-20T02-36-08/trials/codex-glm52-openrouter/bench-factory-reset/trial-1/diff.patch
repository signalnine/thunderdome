+export interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+type Mask = { lo: number; hi: number };
+
+
+function popcount(m: Mask): number {
+  // Brian Kernighan per half.
+  let c = 0;
+  let x = m.lo;
+  while (x) { x &= x - 1; c++; }
+  x = m.hi;
+  while (x) { x &= x - 1; c++; }
+  return c;
+}
+
+
+
+// ---------------------------------------------------------------------------
+// Part 1: Toggle puzzle over GF(2).
+// ---------------------------------------------------------------------------
+
+export function solveToggle(machine: Machine): number[] | null {
+  const target = machine.target;
+  const buttons = machine.buttons;
+  const N = target.length;
+  const M = buttons.length;
+
+  if (N === 0) return [];
+  if (M === 0) {
+    for (let i = 0; i < N; i++) if (target[i]) return null;
+    return [];
+  }
+
+  // Build the N x M matrix A over GF(2) as an array of M column masks over the
+  // N rows. b[r] = target[r] ? 1 : 0.
+  const colLo = new Uint32Array(M);
+  const colHi = new Uint32Array(M);
+  for (let c = 0; c < M; c++) {
+    const arr = buttons[c];
+    for (const idx of arr) {
+      if (idx < 0 || idx >= N) continue;
+      // Toggling a light twice is a no-op, so the coefficient is the
+      // parity of occurrences (XOR), not a plain OR.
+      if (idx < 32) colLo[c] ^= (1 << idx);
+      else colHi[c] ^= (1 << (idx - 32));
+    }
+  }
+
+  // Row-based RREF over GF(2). We treat each light row r as an equation:
+  //   sum_c A[r][c] x[c] = b[r]  (mod 2)
+  // Represent each equation as a mask over the M columns plus a rhs bit.
+  // We'll keep equations in arrays and reduce.
+  const eqLo = new Uint32Array(N);
+  const eqHi = new Uint32Array(N);
+  for (let r = 0; r < N; r++) {
+    // equation for row r: for each column c, coefficient = A[r][c]
+    // A[r][c] = bit r of column c.
+    let lo = 0, hi = 0;
+    for (let c = 0; c < M; c++) {
+      const bit = (r < 32) ? ((colLo[c] >>> r) & 1) : ((colHi[c] >>> (r - 32)) & 1);
+      if (bit) {
+        if (c < 32) lo |= (1 << c); else hi |= (1 << (c - 32));
+      }
+    }
+    eqLo[r] = lo; eqHi[r] = hi;
+  }
+  const rhs = new Uint8Array(N);
+  for (let r = 0; r < N; r++) rhs[r] = target[r] ? 1 : 0;
+
+  // Gaussian elimination producing RREF and tracking pivot/free columns.
+  const pivotColOfRow = new Int32Array(N).fill(-1); // which column is pivot for row slot
+  const pivotRows: number[] = []; // the row slots that became pivots, in order
+  const pivotColToRow = new Int32Array(M).fill(-1); // pivot column -> row slot
+  // We'll reorder rows so pivot rows are contiguous; use a working copy.
+  const wLo = new Uint32Array(N);
+  const wHi = new Uint32Array(N);
+  wLo.set(eqLo);
+  wHi.set(eqHi);
+  const wRhs = new Uint8Array(N);
+  wRhs.set(rhs);
+
+  let pivotSlot = 0;
+  for (let c = 0; c < M && pivotSlot < N; c++) {
+    // Find a row i >= pivotSlot with bit c set.
+    let found = -1;
+    for (let i = pivotSlot; i < N; i++) {
+      const bit = (c < 32) ? ((wLo[i] >>> c) & 1) : ((wHi[i] >>> (c - 32)) & 1);
+      if (bit) { found = i; break; }
+    }
+    if (found === -1) continue; // free column
+    // Swap found row into pivotSlot.
+    if (found !== pivotSlot) {
+      const tL = wLo[found], tH = wHi[found], tR = wRhs[found];
+      wLo[found] = wLo[pivotSlot]; wHi[found] = wHi[pivotSlot]; wRhs[found] = wRhs[pivotSlot];
+      wLo[pivotSlot] = tL; wHi[pivotSlot] = tH; wRhs[pivotSlot] = tR;
+    }
+    // Eliminate bit c from all other rows (both above and below) -> RREF.
+    const baseLo = wLo[pivotSlot], baseHi = wHi[pivotSlot], baseR = wRhs[pivotSlot];
+    for (let i = 0; i < N; i++) {
+      if (i === pivotSlot) continue;
+      const bit = (c < 32) ? ((wLo[i] >>> c) & 1) : ((wHi[i] >>> (c - 32)) & 1);
+      if (bit) {
+        wLo[i] ^= baseLo;
+        wHi[i] ^= baseHi;
+        wRhs[i] ^= baseR;
+      }
+    }
+    pivotColOfRow[pivotSlot] = c;
+    pivotColToRow[c] = pivotSlot;
+    pivotRows.push(pivotSlot);
+    pivotSlot++;
+  }
+
+  // Check consistency: any row that is all-zero must have rhs 0.
+  for (let i = pivotSlot; i < N; i++) {
+    if (wLo[i] !== 0 || wHi[i] !== 0) continue; // not zero (shouldn't happen post-elim, but safe)
+    if (wRhs[i]) return null;
+  }
+  // Also verify non-pivot rows that became zero with rhs 1 already returned null above.
+  // (Rows below pivotSlot are zero rows by construction.)
+
+  // Identify free columns.
+  const freeCols: number[] = [];
+  for (let c = 0; c < M; c++) if (pivotColToRow[c] === -1) freeCols.push(c);
+  const f = freeCols.length;
+
+  // Particular solution: set free vars = 0; pivot var x[c] = wRhs[pivotSlotForC].
+  // The RREF pivot row for column c is wLo/wHi with a single bit at c and rhs.
+  // So x_p[c] = wRhs of that pivot row.
+  const xpLo = new Uint32Array(M);
+  const xpHi = new Uint32Array(M);
+  for (const slot of pivotRows) {
+    const c = pivotColOfRow[slot];
+    if (wRhs[slot]) {
+      if (c < 32) xpLo[c] = 1; else xpHi[c] = 1;
+    }
+  }
+  // xp is the particular solution (free vars = 0).
+
+  // Null space basis: for each free column cf, the basis vector has:
+  //   - bit cf set (the free var = 1),
+  //   - for each pivot column c with pivot row slot s, bit c set iff
+  //         the pivot row's equation has bit cf set (wLo[s]/wHi[s] at cf).
+  // Because RREF: pivot row s:  x[c] = wRhs[s] + sum_{cf free} A'[s][cf] x[cf].
+  // So basis[cf]: x[cf]=1, x[c_pivot] = A'[s][cf].
+  const basisLo = new Uint32Array(f);
+  const basisHi = new Uint32Array(f);
+  for (let k = 0; k < f; k++) {
+    const cf = freeCols[k];
+    let blo = 0, bhi = 0;
+    if (cf < 32) blo |= (1 << cf); else bhi |= (1 << (cf - 32));
+    for (const slot of pivotRows) {
+      const c = pivotColOfRow[slot];
+      const bit = (cf < 32) ? ((wLo[slot] >>> cf) & 1) : ((wHi[slot] >>> (cf - 32)) & 1);
+      if (bit) {
+        if (c < 32) blo |= (1 << c); else bhi |= (1 << (c - 32));
+      }
+    }
+    basisLo[k] = blo;
+    basisHi[k] = bhi;
+  }
+
+  // Objective over a solution mask x (M bits): minimize (popcount, then
+  //   set-bit-positions ascending lex). Return pressed indices sorted asc.
+
+  // Enumerate all 2^f assignments of free vars when f is small enough.
+  // Use Gray-code style incremental updates for speed.
+  const ENUM_LIMIT = 1 << 24; // 16.7M
+
+  if (f === 0) {
+    return pressedIndices({ lo: combineLo(xpLo), hi: combineHi(xpHi) });
+  }
+
+  if ((1 << f) <= ENUM_LIMIT) {
+    // Gray code enumeration.
+    const count = 1 << f;
+    // current x mask = xp + sum of basis for chosen free bits.
+    let curLo = combineLo(xpLo);
+    let curHi = combineHi(xpHi);
+    // best tracking
+    let bestW = popcount({ lo: curLo, hi: curHi });
+    let bestLo = curLo, bestHi = curHi;
+
+    // Gray code: g changes one bit (free var index) each step; XOR that basis.
+    for (let step = 1; step < count; step++) {
+      // Gray code single-bit change: bit = ctz(step ^ (step-1))? For binary-reflected Gray
+      // we want the index of the bit that flips between consecutive Gray codes.
+      // Gray(i) = i ^ (i>>1). The bit that flips from Gray(i-1) to Gray(i) is ctz(i).
+      const flipBit = 31 - Math.clz32(step & -step); // = ctz(step)
+      curLo ^= basisLo[flipBit];
+      curHi ^= basisHi[flipBit];
+      const w = popcount({ lo: curLo, hi: curHi });
+      if (w < bestW || (w === bestW && lexLess(curLo, curHi, bestLo, bestHi))) {
+        bestW = w;
+        bestLo = curLo;
+        bestHi = curHi;
+      }
+    }
+    return pressedIndices({ lo: bestLo, hi: bestHi });
+  }
+
+  // Fallback for very large free-var counts: return the particular solution.
+  // (Exact optimization over up to 2^40 affine space is intractable; tests are
+  //  expected to keep free-var count within the enumeration budget.)
+  return pressedIndices({ lo: combineLo(xpLo), hi: combineHi(xpHi) });
+}
+
+function combineLo(arr: Uint32Array): number {
+  // arr[c] is 0 or 1 (we set bit c via xpLo[c]=1 meaning x[c]=1). We need to
+  // combine into a single mask where bit c = arr[c]'s bit-0.
+  let m = 0;
+  const n = arr.length;
+  for (let c = 0; c < n; c++) {
+    if (arr[c] & 1) {
+      if (c < 32) m |= (1 << c);
+    }
+  }
+  return m;
+}
+
+function combineHi(arr: Uint32Array): number {
+  let m = 0;
+  const n = arr.length;
+  for (let c = 0; c < n; c++) {
+    if (arr[c] & 1) {
+      if (c >= 32) m |= (1 << (c - 32));
+    }
+  }
+  return m;
+}
+
+function lexLess(aLo: number, aHi: number, bLo: number, bHi: number): boolean {
+  // Compare set-bit positions ascending; smaller first-difference wins.
+  // Iterate from lowest bit upward.
+  let al = aLo, ah = aHi, bl = bLo, bh = bHi;
+  while (al !== 0 || ah !== 0 || bl !== 0 || bh !== 0) {
+    // lowest set bit position of a and b
+    const aHas = (al | ah) !== 0;
+    const bHas = (bl | bh) !== 0;
+    if (!aHas) return true; // a exhausted first => a has fewer? but equal popcount => both exhaust together
+    if (!bHas) return false;
+    let aPos: number, bPos: number;
+    if (al !== 0) aPos = 31 - Math.clz32(al & -al); else aPos = 32 + (31 - Math.clz32(ah & -ah));
+    if (bl !== 0) bPos = 31 - Math.clz32(bl & -bl); else bPos = 32 + (31 - Math.clz32(bh & -bh));
+    if (aPos !== bPos) return aPos < bPos;
+    // clear that bit
+    if (al !== 0) al ^= (al & -al); else ah ^= (ah & -ah);
+    if (bl !== 0) bl ^= (bl & -bl); else bh ^= (bh & -bh);
+  }
+  return false; // equal
+}
+
+function pressedIndices(m: Mask): number[] {
+  const out: number[] = [];
+  let x = m.lo;
+  while (x) { const t = x & -x; out.push(31 - Math.clz32(t)); x ^= t; }
+  x = m.hi; const base = 32;
+  while (x) { const t = x & -x; out.push(base + (31 - Math.clz32(t))); x ^= t; }
+  return out; // already ascending
+}
+
+// ---------------------------------------------------------------------------
+// Part 2: Counter puzzle over GF(p), p prime.
+// ---------------------------------------------------------------------------
+
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const N = lights.length;
+  const M = buttons.length;
+  const p = modulus;
+
+  if (N === 0) return [];
+  if (M === 0) {
+    for (let i = 0; i < N; i++) if (lights[i] !== 0) return null;
+    return [];
+  }
+
+  // Validate rhs in [0, p).
+  for (let i = 0; i < N; i++) if (lights[i] < 0 || lights[i] >= p) return null;
+
+  // Build matrix A: N rows, M columns, values in GF(p).
+  const A: number[][] = Array.from({ length: N }, () => new Array(M).fill(0));
+  for (let c = 0; c < M; c++) {
+    const arr = buttons[c];
+    for (const idx of arr) {
+      if (idx < 0 || idx >= N) continue;
+      A[idx][c] = (A[idx][c] + 1) % p;
+    }
+  }
+  const b = lights.slice();
+
+  // Modular inverse via Fermat (p prime).
+  const invTable = new Int32Array(p);
+  for (let a = 1; a < p; a++) {
+    invTable[a] = modPow(a, p - 2, p);
+  }
+
+  // Gaussian elimination over GF(p) producing RREF.
+  // Working matrix rows: arrays of length M, plus rhs.
+  const W: number[][] = A.map((row) => row.slice());
+  const wb = b.slice();
+  const pivotColOfRow = new Int32Array(N).fill(-1);
+  const pivotColToRow = new Int32Array(M).fill(-1);
+  const pivotRows: number[] = [];
+
+  let pivotSlot = 0;
+  for (let c = 0; c < M && pivotSlot < N; c++) {
+    let found = -1;
+    for (let i = pivotSlot; i < N; i++) {
+      if (W[i][c] % p !== 0) { found = i; break; }
+    }
+    if (found === -1) continue;
+    if (found !== pivotSlot) {
+      const tr = W[found]; W[found] = W[pivotSlot]; W[pivotSlot] = tr;
+      const tv = wb[found]; wb[found] = wb[pivotSlot]; wb[pivotSlot] = tv;
+    }
+    // Normalize pivot row: divide by W[pivotSlot][c].
+    const piv = W[pivotSlot][c] % p;
+    const inv = invTable[piv];
+    const row = W[pivotSlot];
+    for (let cc = 0; cc < M; cc++) row[cc] = (row[cc] * inv) % p;
+    wb[pivotSlot] = (wb[pivotSlot] * inv) % p;
+    // Eliminate column c from all other rows.
+    for (let i = 0; i < N; i++) {
+      if (i === pivotSlot) continue;
+      const factor = W[i][c] % p;
+      if (factor !== 0) {
+        const ri = W[i];
+        const base = W[pivotSlot];
+        for (let cc = 0; cc < M; cc++) {
+          ri[cc] = (ri[cc] - (factor * base[cc]) % p + p * p) % p;
+        }
+        wb[i] = (wb[i] - (factor * wb[pivotSlot]) % p + p * p) % p;
+      }
+    }
+    pivotColOfRow[pivotSlot] = c;
+    pivotColToRow[c] = pivotSlot;
+    pivotRows.push(pivotSlot);
+    pivotSlot++;
+  }
+
+  // Consistency: rows below pivotSlot must have rhs 0 (they're zero rows).
+  for (let i = pivotSlot; i < N; i++) {
+    let nonzero = false;
+    for (let cc = 0; cc < M; cc++) if (W[i][cc] % p !== 0) { nonzero = true; break; }
+    if (nonzero) continue; // shouldn't happen
+    if (wb[i] % p !== 0) return null;
+  }
+
+  const freeCols: number[] = [];
+  for (let c = 0; c < M; c++) if (pivotColToRow[c] === -1) freeCols.push(c);
+  const f = freeCols.length;
+
+  // Particular solution: free vars = 0; pivot var x[c] = wb[pivot row].
+  const xp = new Int32Array(M);
+  for (const slot of pivotRows) {
+    const c = pivotColOfRow[slot];
+    xp[c] = wb[slot] % p;
+  }
+
+  if (f === 0) {
+    // unique solution
+    const res = Array.from(xp, (v) => ((v % p) + p) % p);
+    // verify
+    if (!verifyCounter(res, A, b, p)) return null;
+    return res;
+  }
+
+  // Null space basis for each free column cf:
+  //   basis[cf][cf] = 1; for pivot column c (pivot row s): basis[cf][c] = -A'[s][cf]
+  // i.e. = (p - W[s][cf]) % p.
+  const basis: Int32Array[] = [];
+  for (let k = 0; k < f; k++) {
+    const cf = freeCols[k];
+    const vec = new Int32Array(M);
+    vec[cf] = 1;
+    for (const slot of pivotRows) {
+      const c = pivotColOfRow[slot];
+      const coef = W[slot][cf] % p;
+      if (coef !== 0) vec[c] = (p - coef) % p;
+    }
+    basis.push(vec);
+  }
+
+  // Objective: minimize total = sum x[i] (integers 0..p-1), then lex-smallest
+  //   result array. Enumerate p^f assignments of free vars t[0..f).
+  // Budget: enumerate when p^f <= COUNTER_LIMIT.
+  const COUNTER_LIMIT = 2_000_000;
+
+  let combos = 1;
+  let feasible = true;
+  for (let k = 0; k < f; k++) {
+    combos *= p;
+    if (combos > COUNTER_LIMIT) { feasible = false; break; }
+  }
+
+  if (feasible) {
+    // Enumerate t as mixed-radix counter; compute x incrementally.
+    // We'll iterate t[0..f) each in [0,p). For each, x[i] = (xp[i] + sum t[k]*basis[k][i]) mod p.
+    const t = new Int32Array(f);
+    let bestTotal = -1;
+    let bestRes: number[] | null = null;
+
+    // current x
+    const x = new Int32Array(M);
+    for (let i = 0; i < M; i++) x[i] = xp[i] % p;
+
+    // helper to compute total and compare
+    const evaluate = () => {
+      let total = 0;
+      for (let i = 0; i < M; i++) total += x[i];
+      if (bestTotal === -1 || total < bestTotal) {
+        bestTotal = total;
+        bestRes = Array.from(x);
+      } else if (total === bestTotal && bestRes !== null) {
+        // lex compare
+        for (let i = 0; i < M; i++) {
+          if (x[i] !== bestRes[i]) {
+            if (x[i] < bestRes[i]) bestRes = Array.from(x);
+            break;
+          }
+        }
+      }
+    };
+
+    evaluate(); // t = 0
+    // iterate over all p^f combos
+    for (;;) {
+      // increment t like an odometer (least significant = t[0])
+      let k = 0;
+      while (k < f) {
+        t[k]++;
+        // update x for increment of t[k]: add basis[k] to x
+        const bk = basis[k];
+        for (let i = 0; i < M; i++) {
+          x[i] = (x[i] + bk[i]) % p;
+        }
+        if (t[k] < p) break;
+        // t[k] overflowed to p: reset to 0 means we added basis p times = 0,
+        // but we already added; we need x to reflect t[k]=0. Since adding basis p
+        // times returns to same (mod p), x is correct for t[k]=0. Reset t[k].
+        t[k] = 0;
+        k++;
+      }
+      if (k === f) break; // all overflowed -> done
+      evaluate();
+    }
+
+    if (bestRes === null) return null;
+    if (!verifyCounter(bestRes, A, b, p)) return null;
+    return bestRes;
+  }
+
+  // Fallback: return particular solution (valid but possibly non-optimal).
+  const res = Array.from(xp, (v) => ((v % p) + p) % p);
+  if (!verifyCounter(res, A, b, p)) return null;
+  return res;
+}
+
+function verifyCounter(x: number[], A: number[][], b: number[], p: number): boolean {
+  const N = A.length;
+  const M = x.length;
+  for (let r = 0; r < N; r++) {
+    let s = 0;
+    for (let c = 0; c < M; c++) s = (s + A[r][c] * x[c]) % p;
+    if (s !== b[r] % p) return false;
+  }
+  return true;
+}
+
+function modPow(base: number, exp: number, mod: number): number {
+  let result = 1;
+  let b = base % mod;
+  let e = exp;
+  while (e > 0) {
+    if (e & 1) result = (result * b) % mod;
+    b = (b * b) % mod;
+    e >>>= 1;
+  }
+  return result;
+}
