+{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && cat > src/index.ts << 'CODEEOF'\nexport interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string;\n  in2: string;\n  out: string;\n}\n\nconst OPS: Record<Gate['op'], (a: number, b: number) => number> = {\n  AND: (a, b) => (a === 1 && b === 1 ? 1 : 0),\n  OR: (a, b) => (a === 1 || b === 1 ? 1 : 0),\n  XOR: (a, b) => (a \"'!== b ? 1 : 0),\n};\n\nexport function simulate(\n  gates: Gate[],\n  inputs: Record<string, number>\n): Record<string, number> {\n  const wires: Record<string, number> = { ...inputs };\n  const byOutput = new Map<string, Gate>();\n  for (const g of gates) byOutput.set(g.out, g);\n\n  const dependents: Map<string, string[]> = new Map();\n  const inDegree: Record<string, number> = {};\n  for (const g of gates) {\n    let deg = 0;\n    for (const inp of [g.in1, g.in2]) {\n      if (byOutput.has(inp) && inp !== g.out) deg++;\n    }\n    inDegree[g.out] = deg;\n    for (const inp of [g.in1, g.in2]) {\n      if (byOutput.has(inp) && inp !== g.out) {\n        if (!dependents.has(inp)) dependents.set(inp, []);\n        dependents.get(inp)!.push(g.out);\n      }\n    }\n  }\n\n  const ready: string[] = [];\n  for (const g of gates) {\n    if (inDegree[g.out] === 0) ready.push(g.out);\n  }\n\n  const pending = new Set(gates.map((g) => g.out));\n  while (ready.length) {\n    const out = ready.pop()!;\n    const g = byOutput.get(out)!;\n    if (g.in1 in wires && g.in2 in wires) {\n      wires[out] = OPS[g.op](wires[g.in1], wires[g.in2]);\n      pending.delete(out);\n      for (const dep of dependents.get(out) ?? []) {\n        inDegree[dep]--;\n        if (inDegree[dep] === 0 && !(dep in wires)) ready.push(dep);\n      }\n    }\n  }\n\n  if (pending.size) {\n    let changed = true;\n    while (changed && pending.size) {\n      changed = false;\n      for (const out of [...pending]) {\n        const g = byOutput.get(out)!;\n        if (g.in1 in wires && g.in2 in wires) {\n          wires[out] = OPS[g.op](wires[g.in1], wires[g.in2]);\n          pending.delete(out);\n          changed = true;\n        }\n      }\n    }\n  }\n\n  return wires;\n}\n\n// ---------- findSwappedWires ----------\n\nfunction pad(n: number): string {\n  return n.toString().padStart(2, '\"'0');\n}\n\nfunction isX(w: string): boolean {\n  return /\"'^x'\"\\\\d+\"'$/.test(w);\n}\nfunction isY(w: string): boolean {\n  return /''^y'\"\\\\d+\"'$/.test(w);\n}\nfunction isZ(w: string): boolean {\n  return /''^z'\"\\\\d+\"'$/.test(w);\n}\nfunction wireNum(w: string): number | null {\n  const m = /''^([xyz])('\"\\\\d+)\"'$/.exec(w);\n  return m ? parseInt(m[2], 10) : null;\n}\n\nfunction findGate(\n  gates: Gate[],\n  op: Gate['\"'op'],\n  a: string,\n  b: string\n): Gate | undefined {\n  return gates.find(\n    (g) =>\n      g.op === op &&\n      ((g.in1 === a && g.in2 === b) || (g.in1 === b && g.in2 === a))\n  );\n}\n\nfunction cloneGates(gates: Gate[]): Gate[] {\n  return gates.map((g) => ({ ...g }));\n}\n\nfunction swapOut(gates: Gate[], a: string, b: string): void {\n  let ia = -1;\n  let ib = -1;\n  for (let i = 0; i < gates.length; i++) {\n    if (gates[i].out === a) ia = i;\n    if (gates[i].out === b) ib = i;\n  }\n  if (ia < 0 || ib < 0) return;\n  const tmp = gates[ia].out;\n  gates[ia].out = gates[ib].out;\n  gates[ib].out = tmp;\n}\n\nfunction makeInputs(N: number, x: number, y: number): Record<string, number> {\n  const inputs: Record<string, number> = {};\n  for (let i = 0; i < N; i++) {\n    inputs[\"'`x${pad(i)}`] = (x >> i) & 1;\n    inputs[`y${pad(i)}`] = (y >> i) & 1;\n  }\n  return inputs;\n}\n\nconst TEST_VECTORS: [number, number][] = [\n  [0, 0],\n  [1, 1],\n  [1, 0],\n  [0, 1],\n  [3, 5],\n  [7, 1],\n  [0x55, 0x33],\n  [0xff, 0x01],\n  [0xaaaa, 0x5555],\n  [0x7, 0x7],\n];\n\nfunction makeTests(N: number): [number, number][] {\n  const mask = N >= 31 ? 0xffffffff : (1 << N) - 1;\n  const tests = TEST_VECTORS.map(([x, y]) => [x & mask, y & mask] as [number, number]);\n  tests.push([mask, 1]);\n  tests.push([mask, mask]);\n  return tests;\n}\n\nfunction fullyCorrect(gates: Gate[], N: number): boolean {\n  const tests: [number, number][] = makeTests(N);\n  if (N <= 10) {\n    const size = 1 << N;\n    for (let x = 0; x < size; x++) {\n      for (let y = 0; y < size; y++) {\n        tests.push([x, y]);\n      }\n    }\n  } else {\n    let s = 98765;\n    const rnd = () => {\n      s = (s * 1103515245 + 12345) & 0x7fffffff;\n      return s;\n    };\n    const mask = N >= 31 ? 0xffffffff : (1 << N) - 1;\n    for (let t = 0; t < 50; t++) tests.push([rnd() & mask, rnd() & mask]);\n  }\n  for (const [x, y] of tests) {\n    const w = simulate(gates, makeInputs(N, x, y));\n    const expected = BigInt(x) + BigInt(y);\n    let got = 0n;\n    for (let i = 0; i <= N; i++) {\n      if (w[`z${pad(i)}`] === 1) got |= 1n << BigInt(i);\n    }\n    if (got !== expected) return false;\n  }\n  return true;\n}\n\n/** Return the lowest z-bit index that is wrong, or -1. */\nfunction lowestWrongBit(gates: Gate[], N: number): number {\n  const tests = makeTests(N);\n  let lowest = -1;\n  for (const [x, y] of tests) {\n    const w = simulate(gates, makeInputs(N, x, y));\n    const expected = BigInt(x) + BigInt(y);\n    for (let i = 0; i <= N; i++) {\n      const expBit = Number((expected >> BigInt(i)) & 1n);\n      if ((w[`z${pad(i)}`] ?? 0) !== expBit) {\n        if (lowest === -1 || i < lowest) lowest = i;\n        break;\n      }\n    }\n  }\n  return lowest;\n}\n\nfunction bitsCorrectUpTo(gates: Gate[], N: number, upTo: number): boolean {\n  const tests = makeTests(N);\n  for (const [x, y] of tests) {\n    const w = simulate(gates, makeInputs(N, x, y));\n    const expected = BigInt(x) + BigInt(y);\n    for (let i = 0; i <= upTo; i++) {\n      const expBit = Number((expected >> BigInt(i)) & 1n);\n      if ((w[`z${pad(i)}`] ?? 0) !== expBit) return false;\n    }\n  }\n  return true;\n}\n\n/**\n * Build the local cone of wires relevant to bit b being the lowest wrong bit.\n * Uses transitive dependency tracing from z_b (up to depth 3) plus structural\n * wires for bits b and b-1.\n */\nfunction buildLocalCone(\n  gates: Gate[],\n  N: number,\n  b: number,\n  alreadySwapped: string[]\n): string[] {\n  const outMap = new Map<string, Gate>();\n  for (const g of gates) outMap.set(g.out, g);\n\n  const cone = new Set<string>();\n  const fixed = new Set(alreadySwapped);\n  const add = (w: string | undefined) => {\n    if (w && !isX(w) && !isY(w) && !fixed.has(w)) cone.add(w);\n  };\n\n  const zb = `z${pad(b)}`;\n  add(zb);\n\n  // Transitive dependency cone: from z_b, trace inputs up to depth 4.\n  const visited = new Set<string>();\n  const queue: [string, number][] = [];\n  if (outMap.has(zb)) queue.push([zb, 0]);\n  while (queue.length) {\n    const [wire, depth] = queue.shift()!;\n    if (visited.has(wire)) continue;\n    visited.add(wire);\n    add(wire);\n    if (depth >= 4) continue;\n    const g = outMap.get(wire);\n    if (g) {\n      for (const inp of [g.in1, g.in2]) {\n        if (outMap.has(inp) && !visited.has(inp)) {\n          queue.push([inp, depth + 1]);\n        }\n      }\n    }\n  }\n\n  // Also add structural wires for bit b and b-1.\n  if (b >= 0) {\n    const partialG = findGate(gates, '\"'XOR', \"'`x${pad(b)}`, `y${pad(b)}`);\n    add(partialG?.out);\n    const genG = findGate(gates, '\"'AND', \"'`x${pad(b)}`, `y${pad(b)}`);\n    add(genG?.out);\n  }\n  if (b >= 1) {\n    const partialPrev = findGate(gates, '\"'XOR', \"'`x${pad(b - 1)}`, `y${pad(b - 1)}`);\n    add(partialPrev?.out);\n    const genPrev = findGate(gates, '\"'AND', \"'`x${pad(b - 1)}`, `y${pad(b - 1)}`);\n    add(genPrev?.out);\n  }\n\n  // For bit 0, also add carry_0.\n  if (b === 0) {\n    add(findGate(gates, '\"'AND', \"'`x${pad(0)}`, `y${pad(0)}`)?.out);\n  }\n\n  return [...cone];\n}\n\n/**\n * Simulation-guided backtracking search. At each level, find the lowest wrong\n * bit,