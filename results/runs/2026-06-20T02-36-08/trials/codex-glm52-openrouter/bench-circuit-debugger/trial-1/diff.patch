.random()*10);\n  const correct=buildAdder(N);\n  \n  const outs=correct.map(g=>g.out);\n  const shuffled=[...outs].sort(()=>Math.random()-0.5);\n  const pairs=[];\n  for(let i=0;i<8;i+=2) pairs.push([shuffled[i],shuffled[i+1]]);\n  \n  const swapped=applySwaps(correct,pairs);\n  \n  // Skip if cycles (problem guarantees acyclic)\n  if(hasCycle(swapped)){skipped++;continue;}\n  \n  const expected=pairs.flat().sort();\n  const t0=Date.now();\n  const result=findSwappedWires(swapped);\n  const dt=Date.now()-t0;\n  \n  const ok=JSON.stringify(result)===JSON.stringify(expected);\n  if(ok)pass++;else{fail++;if(fail<=5)console.log(`FAIL N=${N} dt=${dt}ms'\"\\\\n  expected:\"'${expected.join('\"',')}\\\\n  got:\"'${result.join('\"',')}\"'`);}\n  if(dt>5000)console.log(`SLOW N=${N} dt=${dt}ms`);\n}\nconsole.log(`'\"\\\\nPass: \"'${pass}, Fail: ${fail}, Skipped(cycles): ${skipped}`);\nEOF\ntimeout 120 npx tsx /tmp/gen-test2.mjs 2>&1 | tail -20'","aggregated_output":"FAIL N=3 dt=12ms\n  expected:a01,a02,b01,c01,t02,z00,z01,z02\n  got:a01,a02,b01,z00,z01,z02\nFAIL N=6 dt=77ms\n  expected:a01,a02,a03,b01,c00,t02,t03,t05\n  got:\nFAIL N=6 dt=115ms\n  expected:a01,a02,a04,a05,b01,c02,t02,z01\n  got:a02,a04,a05,c02,t02,z01\nFAIL N=5 dt=43ms\n  expected:a01,b02,c00,c01,c03,z00,z03,z04\n  got:\nFAIL N=5 dt=1143ms\n  expected:b04,c02,t02,t03,t04,z00,z01,z02\n  got:\nSLOW N=8 dt=67518ms\nSLOW N=10 dt=19400ms\nSLOW N=9 dt=6640ms\n","exit_code":0,"status":"completed"}}
