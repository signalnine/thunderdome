+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+const OPS: Record<Gate['op'], (a: number, b: number) => number> = {
+  AND: (a, b) => (a === 1 && b === 1 ? 1 : 0),
+  OR: (a, b) => (a === 1 || b === 1 ? 1 : 0),
+  XOR: (a, b) => (a !== b ? 1 : 0),
+};
+
+export function simulate(
+  gates: Gate[],
+  inputs: Record<string, number>
+): Record<string, number> {
+  const wires: Record<string, number> = { ...inputs };
+  const byOutput = new Map<string, Gate>();
+  for (const g of gates) byOutput.set(g.out, g);
+
+  const dependents: Map<string, string[]> = new Map();
+  const inDegree: Record<string, number> = {};
+  for (const g of gates) {
+    let deg = 0;
+    for (const inp of [g.in1, g.in2]) {
+      if (byOutput.has(inp) && inp !== g.out) deg++;
+    }
+    inDegree[g.out] = deg;
+    for (const inp of [g.in1, g.in2]) {
+      if (byOutput.has(inp) && inp !== g.out) {
+        if (!dependents.has(inp)) dependents.set(inp, []);
+        dependents.get(inp)!.push(g.out);
+      }
+    }
+  }
+
+  const ready: string[] = [];
+  for (const g of gates) {
+    if (inDegree[g.out] === 0) ready.push(g.out);
+  }
+
+  const pending = new Set(gates.map((g) => g.out));
+  while (ready.length) {
+    const out = ready.pop()!;
+    const g = byOutput.get(out)!;
+    if (g.in1 in wires && g.in2 in wires) {
+      wires[out] = OPS[g.op](wires[g.in1], wires[g.in2]);
+      pending.delete(out);
+      for (const dep of dependents.get(out) ?? []) {
+        inDegree[dep]--;
+        if (inDegree[dep] === 0 && !(dep in wires)) ready.push(dep);
+      }
+    }
+  }
+
+  if (pending.size) {
+    let changed = true;
+    while (changed && pending.size) {
+      changed = false;
+      for (const out of [...pending]) {
+        const g = byOutput.get(out)!;
+        if (g.in1 in wires && g.in2 in wires) {
+          wires[out] = OPS[g.op](wires[g.in1], wires[g.in2]);
+          pending.delete(out);
+          changed = true;
+        }
+      }
+    }
+  }
+
+  return wires;
+}
+
+// ---------- findSwappedWires ----------
+
+function pad(n: number): string {
+  return n.toString().padStart(2, '0');
+}
+
+function isX(w: string): boolean {
+  return /^x\d+$/.test(w);
+}
+function isY(w: string): boolean {
+  return /^y\d+$/.test(w);
+}
+function isZ(w: string): boolean {
+  return /^z\d+$/.test(w);
+}
+function wireNum(w: string): number | null {
+  const m = /^([xyz])(\d+)$/.exec(w);
+  return m ? parseInt(m[2], 10) : null;
+}
+
+function findGate(
+  gates: Gate[],
+  op: Gate['op'],
+  a: string,
+  b: string
+): Gate | undefined {
+  return gates.find(
+    (g) =>
+      g.op === op &&
+      ((g.in1 === a && g.in2 === b) || (g.in1 === b && g.in2 === a))
+  );
+}
+
+function cloneGates(gates: Gate[]): Gate[] {
+  return gates.map((g) => ({ ...g }));
+}
+
+function swapOut(gates: Gate[], a: string, b: string): void {
+  let ia = -1;
+  let ib = -1;
+  for (let i = 0; i < gates.length; i++) {
+    if (gates[i].out === a) ia = i;
+    if (gates[i].out === b) ib = i;
+  }
+  if (ia < 0 || ib < 0) return;
+  const tmp = gates[ia].out;
+  gates[ia].out = gates[ib].out;
+  gates[ib].out = tmp;
+}
+
+function makeInputs(N: number, x: number, y: number): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < N; i++) {
+    inputs[`x${pad(i)}`] = (x >> i) & 1;
+    inputs[`y${pad(i)}`] = (y >> i) & 1;
+  }
+  return inputs;
+}
+
+/** Test vectors that exercise each bit with carry 0 and 1. */
+function getTestVectors(N: number): [number, number][] {
+  const mask = N >= 31 ? 0xffffffff : (1 << N) - 1;
+  const vectors: [number, number][] = [
+    [0, 0],
+    [1, 1],
+    [mask, 1],
+    [mask, mask],
+  ];
+  for (let i = 0; i < N && i < 31; i++) {
+    vectors.push([1 << i, 0]);
+    vectors.push([0, 1 << i]);
+    vectors.push([1 << i, 1 << i]);
+    if (i > 0) vectors.push([(1 << i) - 1, 1]);
+  }
+  return vectors;
+}
+
+function quickCorrect(gates: Gate[], N: number): boolean {
+  for (const [x, y] of getTestVectors(N)) {
+    const w = simulate(gates, makeInputs(N, x, y));
+    const expected = BigInt(x) + BigInt(y);
+    let got = 0n;
+    for (let i = 0; i <= N; i++) {
+      if (w[`z${pad(i)}`] === 1) got |= 1n << BigInt(i);
+    }
+    if (got !== expected) return false;
+  }
+  return true;
+}
+
+function fullyCorrect(gates: Gate[], N: number): boolean {
+  if (!quickCorrect(gates, N)) return false;
+  let s = 98765;
+  const rnd = () => {
+    s = (s * 1103515245 + 12345) & 0x7fffffff;
+    return s;
+  };
+  const mask = N >= 31 ? 0xffffffff : (1 << N) - 1;
+  for (let t = 0; t < 30; t++) {
+    const x = rnd() & mask;
+    const y = rnd() & mask;
+    const w = simulate(gates, makeInputs(N, x, y));
+    const expected = BigInt(x) + BigInt(y);
+    let got = 0n;
+    for (let i = 0; i <= N; i++) {
+      if (w[`z${pad(i)}`] === 1) got |= 1n << BigInt(i);
+    }
+    if (got !== expected) return false;
+  }
+  return true;
+}
+
+/** Return the lowest wrong z-bit index, or -1. */
+function lowestWrongBit(gates: Gate[], N: number): number {
+  const vectors = getTestVectors(N);
+  let lowest = -1;
+  for (const [x, y] of vectors) {
+    const w = simulate(gates, makeInputs(N, x, y));
+    const expected = BigInt(x) + BigInt(y);
+    for (let i = 0; i <= N; i++) {
+      const expBit = Number((expected >> BigInt(i)) & 1n);
+      if ((w[`z${pad(i)}`] ?? 0) !== expBit) {
+        if (lowest === -1 || i < lowest) lowest = i;
+        break;
+      }
+    }
+  }
+  return lowest;
+}
+
+function bitsCorrectUpTo(gates: Gate[], N: number, upTo: number): boolean {
+  const vectors = getTestVectors(N);
+  for (const [x, y] of vectors) {
+    const w = simulate(gates, makeInputs(N, x, y));
+    const expected = BigInt(x) + BigInt(y);
+    for (let i = 0; i <= upTo; i++) {
+      const expBit = Number((expected >> BigInt(i)) & 1n);
+      if ((w[`z${pad(i)}`] ?? 0) !== expBit) return false;
+    }
+  }
+  return true;
+}
+
+function bitCorrect(gates: Gate[], N: number, b: number): boolean {
+  const vectors = getTestVectors(N);
+  for (const [x, y] of vectors) {
+    const w = simulate(gates, makeInputs(N, x, y));
+    const expected = BigInt(x) + BigInt(y);
+    const expBit = Number((expected >> BigInt(b)) & 1n);
+    if ((w[`z${pad(b)}`] ?? 0) !== expBit) return false;
+  }
+  return true;
+}
+
+/** Gates that reference wire w as input. */
+function users(gates: Gate[], w: string): Gate[] {
+  return gates.filter((g) => g.in1 === w || g.in2 === w);
+}
+
+/** Trace carry_i by walking the chain from bit 0 (by gate inputs). */
+function traceCarry(gates: Gate[], targetBit: number): string | undefined {
+  let carry: string | undefined = findGate(gates, 'AND', `x${pad(0)}`, `y${pad(0)}`)?.out;
+  if (!carry) return undefined;
+  if (targetBit === 0) return carry;
+  for (let i = 1; i <= targetBit; i++) {
+    const partial = findGate(gates, 'XOR', `x${pad(i)}`, `y${pad(i)}`)?.out;
+    const gen = findGate(gates, 'AND', `x${pad(i)}`, `y${pad(i)}`)?.out;
+    if (!partial || !gen || !carry) return undefined;
+    const prop: string | undefined = findGate(gates, 'AND', partial, carry)?.out;
+    if (!prop) return undefined;
+    const nextCarry: string | undefined = findGate(gates, 'OR', gen, prop)?.out;
+    if (!nextCarry) return undefined;
+    carry = nextCarry;
+  }
+  return carry;
+}
+
+/**
+ * Collect structural swap candidates by checking each bit's gate structure.
+ * Gates are identified by their fixed primary inputs (x_i, y_i), which are
+ * unaffected by output swaps. We then check if each gate's output is consumed
+ * by the expected gate types.
+ */
+function collectCandidates(gates: Gate[]): string[] {
+  let maxZ = 0;
+  for (const g of gates) {
+    if (isZ(g.out)) {
+      const n = wireNum(g.out)!;
+      if (n > maxZ) maxZ = n;
+    }
+  }
+  const N = maxZ;
+  const outMap = new Map<string, Gate>();
+  for (const g of gates) outMap.set(g.out, g);
+
+  const bad = new Set<string>();
+  const add = (w: string | undefined) => {
+    if (w && !isX(w) && !isY(w)) bad.add(w);
+  };
+
+  // --- Bit 0 ---
+  // z_0 = XOR(x_0, y_0). partial_0 = XOR(x_0, y_0) = z_0.
+  // carry_0 = AND(x_0, y_0).out. Should be consumed by XOR (z_1) and AND (prop_1).
+  {
+    const partial0 = findGate(gates, 'XOR', `x${pad(0)}`, `y${pad(0)}`);
+    const carry0 = findGate(gates, 'AND', `x${pad(0)}`, `y${pad(0)}`);
+
+    if (partial0 && partial0.out !== `z${pad(0)}`) {
+      add(partial0.out); // partial_0 should be z_0
+      add(`z${pad(0)}`);
+    }
+    const z0Gate = outMap.get(`z${pad(0)}`);
+    if (z0Gate && z0Gate.op !== 'XOR') {
+      add(`z${pad(0)}`);
+    }
+
+    // carry_0 should be consumed by an XOR gate (z_1's gate) and an AND gate (prop_1).
+    if (carry0) {
+      const xorUsers = users(gates, carry0.out).filter(
+        (g) => g.op === 'XOR' && g !== carry0
+      );
+      const andUsers = users(gates, carry0.out).filter(
+        (g) => g.op === 'AND'
+      );
+      if (xorUsers.length === 0 && andUsers.length === 0) {
+        add(carry0.out); // carry_0 not consumed properly
+      }
+    }
+  }
+
+  // --- Bits 1 to N-1 ---
+  for (let i = 1; i <= N - 1; i++) {
+    const xi = `x${pad(i)}`;
+    const yi = `y${pad(i)}`;
+    const zi = `z${pad(i)}`;
+
+    // partial_i = XOR(x_i, y_i).out — always findable by inputs.
+    const partialG = findGate(gates, 'XOR', xi, yi);
+    // gen_i = AND(x_i, y_i).out — always findable by inputs.
+    const genG = findGate(gates, 'AND', xi, yi);
+
+    // Check z_i: should be produced by XOR with partial_i as input.
+    const zGate = outMap.get(zi);
+    if (zGate) {
+      if (zGate.op !== 'XOR') {
+        add(zi);
+      } else if (partialG) {
+        const hasPartial =
+          zGate.in1 === partialG.out || zGate.in2 === partialG.out;
+        if (!hasPartial) {
+          // z_i's XOR gate doesn't use partial_i.
+          // Either z_i is swapped, or partial_i is swapped.
+          add(zi);
+          // Check if partial_i is consumed by any XOR gate (other than itself).
+          const xorUsersOfPartial = users(gates, partialG.out).filter(
+            (g) => g.op === 'XOR' && g !== partialG
+          );
+          if (xorUsersOfPartial.length === 0) {
+            add(partialG.out); // partial_i not used by any XOR → swapped
+          }
+        }
+      }
+    } else {
+      add(zi); // z_i not produced by any gate
+    }
+
+    // Check partial_i: should be consumed by an XOR gate (z_i) and an AND gate (prop_i).
+    if (partialG) {
+      const xorUsers = users(gates, partialG.out).filter(
+        (g) => g.op === 'XOR' && g !== partialG
+      );
+      const andUsers = users(gates, partialG.out).filter(
+        (g) => g.op === 'AND'
+      );
+      if (xorUsers.length === 0) {
+        add(partialG.out); // partial_i not consumed by XOR → swapped
+      }
+      if (andUsers.length === 0) {
+        add(partialG.out); // partial_i not consumed by AND → swapped
+      }
+    }
+
+    // Check gen_i: should be consumed by an OR gate (carry_i).
+    if (genG) {
+      const orUsers = users(gates, genG.out).filter(
+        (g) => g.op === 'OR'
+      );
+      if (orUsers.length === 0) {
+        add(genG.out); // gen_i not consumed by OR → swapped
+      }
+    }
+  }
+
+  // --- Bit N: z_N = carry_{N-1} ---
+  {
+    const zN = `z${pad(N)}`;
+    const zNGate = outMap.get(zN);
+    if (zNGate) {
+      if (N === 1) {
+        if (zNGate.op !== 'AND') add(zN);
+      } else {
+        if (zNGate.op !== 'OR') add(zN);
+      }
+    }
+  }
+
+  // --- Carry chain consistency rules ---
+  // For each bit i (1..N-1), carry_i = OR(gen_i, prop_i).
+  // gen_i = AND(x_i, y_i) — identified by inputs.
+  // prop_i = AND(partial_i, carry_{i-1}).
+  // The OR gate consuming gen_i should have prop_i as the other input.
+  // prop_i's other input (besides partial_i) should be carry_{i-1}.
+  //
+  // We trace the carry chain and check that each carry wire is consumed by
+  // the correct bit's gates. carry_{i-1} should be consumed by z_i's XOR
+  // AND prop_i's AND. If a carry wire is consumed by the WRONG bit's gates,
+  // flag it.
+
+  // For each bit i (1..N-1):
+  //   The OR gate consuming gen_i = carry_i.
+  //   carry_i should be consumed by z_{i+1}'s XOR and prop_{i+1}'s AND (for i<N-1).
+  //   OR for i=N-1, carry_{N-1} should be z_N.
+  for (let i = 1; i <= N - 1; i++) {
+    const genG = findGate(gates, 'AND', `x${pad(i)}`, `y${pad(i)}`);
+    if (!genG) continue;
+    // Find OR gate using gen_i.
+    const orGates = users(gates, genG.out).filter((g) => g.op === 'OR');
+    for (const orGate of orGates) {
+      const carryI = orGate.out;
+      const otherInput = orGate.in1 === genG.out ? orGate.in2 : orGate.in1;
+      const otherGate = outMap.get(otherInput);
+
+      // otherGate should be AND (prop_i). Its inputs should be partial_i and carry_{i-1}.
+      if (otherGate && otherGate.op !== 'AND') {
+        add(otherInput);
+      }
+      if (otherGate && otherGate.op === 'AND') {
+        // prop_i's inputs: partial_i and carry_{i-1}.
+        const partialG = findGate(gates, 'XOR', `x${pad(i)}`, `y${pad(i)}`);
+        if (partialG) {
+          const hasPartial =
+            otherGate.in1 === partialG.out || otherGate.in2 === partialG.out;
+          if (!hasPartial) {
+            // prop_i doesn't use partial_i — something is swapped.
+            add(otherInput);
+            add(partialG.out);
+          }
+        }
+      }
+
+      // carry_i should be consumed by the next bit (z_{i+1} and prop_{i+1}).
+      if (i < N - 1) {
+        // Find the next bit's partial: XOR(x_{i+1}, y_{i+1}).
+        const partialNext = findGate(gates, 'XOR', `x${pad(i + 1)}`, `y${pad(i + 1)}`);
+        // carry_i should be consumed by z_{i+1}'s XOR gate.
+        // z_{i+1} = XOR(partial_{i+1}, carry_i).
+        const xorUsers = users(gates, carryI).filter(
+          (g) => g.op === 'XOR' && g !== findGate(gates, 'XOR', `x${pad(i)}`, `y${pad(i)}`)
+        );
+        // Check if any XOR user of carryI also uses partialNext.
+        const correctXor = partialNext
+          ? xorUsers.find(
+              (g) =>
+                g.in1 === partialNext.out || g.in2 === partialNext.out
+            )
+          : undefined;
+        if (!correctXor && partialNext) {
+          // carry_i is not used by the correct XOR gate (z_{i+1}).
+          add(carryI);
+        }
+
+        // carry_i should be consumed by prop_{i+1}'s AND gate.
+        // prop_{i+1} = AND(partial_{i+1}, carry_i).
+        const andUsers = users(gates, carryI).filter((g) => g.op === 'AND');
+        const correctAnd = partialNext
+          ? andUsers.find(
+              (g) =>
+                g.in1 === partialNext.out || g.in2 === partialNext.out
+            )
+          : undefined;
+        if (!correctAnd && partialNext) {
+          // carry_i is not used by the correct AND gate (prop_{i+1}).
+          add(carryI);
+        }
+      } else {
+        // i === N-1: carry_{N-1} should be z_N.
+        if (carryI !== `z${pad(N)}`) {
+          add(carryI);
+          add(`z${pad(N)}`);
+        }
+      }
+    }
+  }
+
+  // For each bit i (1..N-1), the z_i gate (XOR) should have inputs:
+  // partial_i and carry_{i-1}.
+  for (let i = 1; i <= N - 1; i++) {
+    const partialG = findGate(gates, 'XOR', `x${pad(i)}`, `y${pad(i)}`);
+    const zi = `z${pad(i)}`;
+    const zGate = outMap.get(zi);
+    if (!partialG || !zGate || zGate.op !== 'XOR') continue;
+    const hasPartial =
+      zGate.in1 === partialG.out || zGate.in2 === partialG.out;
+    if (!hasPartial) continue;
+    const carryInput =
+      zGate.in1 === partialG.out ? zGate.in2 : zGate.in1;
+    if (i === 1) {
+      const carry0 = findGate(gates, 'AND', `x${pad(0)}`, `y${pad(0)}`);
+      if (carry0 && carryInput !== carry0.out) {
+        add(carryInput);
+        add(carry0.out);
+      }
+    } else {
+      const carryGate = outMap.get(carryInput);
+      if (carryGate && carryGate.op !== 'OR') {
+        add(carryInput);
+      }
+    }
+  }
+
+  // --- Additional rules ---
+
+  // Rule: No OR gate should have x/y primary inputs.
+  for (const g of gates) {
+    if (g.op === 'OR') {
+      const bothXY =
+        (isX(g.in1) || isY(g.in1)) && (isX(g.in2) || isY(g.in2));
+      if (bothXY) add(g.out);
+    }
+  }
+
+  // Rule: For i >= 1, AND(x_i, y_i) should not output z_i.
+  for (let i = 1; i < N; i++) {
+    const andG = findGate(gates, 'AND', `x${pad(i)}`, `y${pad(i)}`);
+    if (andG && andG.out === `z${pad(i)}`) add(andG.out);
+  }
+
+  // Rule: For i >= 1, XOR(x_i, y_i) should not output z_i.
+  for (let i = 1; i < N; i++) {
+    const xorG = findGate(gates, 'XOR', `x${pad(i)}`, `y${pad(i)}`);
+    if (xorG && xorG.out === `z${pad(i)}`) add(xorG.out);
+  }
+
+  // Rule: z_N should be the output of OR(gen_{N-1}, prop_{N-1}).
+  // Trace carry to N-1 and check if it equals z_N.
+  if (N >= 2) {
+    const carryN1 = traceCarry(gates, N - 1);
+    if (carryN1 && carryN1 !== `z${pad(N)}`) {
+      add(carryN1);
+      add(`z${pad(N)}`);
+    }
+  }
+
+  return [...bad];
+}
+
+/** Build the local cone of wires relevant to wrong bit b. */
+function buildLocalCone(gates: Gate[], N: number, b: number): string[] {
+  const outMap = new Map<string, Gate>();
+  for (const g of gates) outMap.set(g.out, g);
+
+  const cone = new Set<string>();
+  const add = (w: string | undefined) => {
+    if (w && !isX(w) && !isY(w)) cone.add(w);
+  };
+
+  const zb = `z${pad(b)}`;
+  add(zb);
+
+  // Transitive deps of z_b (depth 4).
+  const visited = new Set<string>();
+  const queue: [string, number][] = [];
+  if (outMap.has(zb)) queue.push([zb, 0]);
+  while (queue.length) {
+    const [wire, depth] = queue.shift()!;
+    if (visited.has(wire)) continue;
+    visited.add(wire);
+    add(wire);
+    if (depth >= 4) continue;
+    const g = outMap.get(wire);
+    if (g) {
+      for (const inp of [g.in1, g.in2]) {
+        if (outMap.has(inp) && !visited.has(inp)) {
+          queue.push([inp, depth + 1]);
+        }
+      }
+    }
+  }
+
+  // Structural wires for bit b.
+  const partialG = findGate(gates, 'XOR', `x${pad(b)}`, `y${pad(b)}`);
+  add(partialG?.out);
+  const genG = findGate(gates, 'AND', `x${pad(b)}`, `y${pad(b)}`);
+  add(genG?.out);
+  if (partialG) for (const g of users(gates, partialG.out)) add(g.out);
+  if (genG) for (const g of users(gates, genG.out)) add(g.out);
+
+  // Structural wires for bit b-1.
+  if (b >= 1) {
+    const partialPrev = findGate(gates, 'XOR', `x${pad(b - 1)}`, `y${pad(b - 1)}`);
+    add(partialPrev?.out);
+    const genPrev = findGate(gates, 'AND', `x${pad(b - 1)}`, `y${pad(b - 1)}`);
+    add(genPrev?.out);
+    const carryPrev = b === 1
+      ? findGate(gates, 'AND', `x${pad(0)}`, `y${pad(0)}`)?.out
+      : traceCarry(gates, b - 1);
+    add(carryPrev);
+    if (carryPrev) for (const g of users(gates, carryPrev)) add(g.out);
+    if (partialPrev) for (const g of users(gates, partialPrev.out)) add(g.out);
+  }
+
+  if (b === 0) {
+    const carry0 = findGate(gates, 'AND', `x${pad(0)}`, `y${pad(0)}`)?.out;
+    add(carry0);
+    if (carry0) for (const g of users(gates, carry0)) add(g.out);
+  }
+
+  return [...cone];
+}
+
+/** Generate all perfect matchings of an even-length array. */
+function* matchings(items: string[]): Generator<string[]> {
+  if (items.length === 0) { yield []; return; }
+  if (items.length === 2) { yield [items[0], items[1]]; return; }
+  const first = items[0];
+  for (let i = 1; i < items.length; i++) {
+    const pair = [first, items[i]];
+    const rest = [...items.slice(1, i), ...items.slice(i + 1)];
+    for (const m of matchings(rest)) yield [...pair, ...m];
+  }
+}
+
+function* combinations<T>(arr: T[], k: number): Generator<T[]> {
+  function* helper(start: number, chosen: T[]): Generator<T[]> {
+    if (chosen.length === k) { yield [...chosen]; return; }
+    for (let i = start; i < arr.length; i++) {
+      chosen.push(arr[i]);
+      yield* helper(i + 1, chosen);
+      chosen.pop();
+    }
+  }
+  yield* helper(0, []);
+}
+
+/** Try all 4-pair matchings from the candidate set. */
+function tryPairings(gates: Gate[], N: number, candidates: string[]): string[] | null {
+  const verify = (swapList: string[]): boolean => {
+    const newGates = cloneGates(gates);
+    for (let i = 0; i < swapList.length; i += 2) {
+      swapOut(newGates, swapList[i], swapList[i + 1]);
+    }
+    return quickCorrect(newGates, N) && fullyCorrect(newGates, N);
+  };
+
+  if (candidates.length < 8) return null;
+  if (candidates.length === 8) {
+    for (const m of matchings(candidates)) {
+      if (verify(m)) return [...m].sort();
+    }
+    return null;
+  }
+  if (candidates.length <= 20) {
+    for (const sub of combinations(candidates, 8)) {
+      for (const m of matchings(sub)) {
+        if (verify(m)) return [...m].sort();
+      }
+    }
+  }
+  return null;
+}
+
+/** Simulation-guided backtracking as fallback. */
+function backtrackSearch(gates: Gate[], N: number): string[] | null {
+  let nodeCount = 0;
+  const MAX_NODES = 200000;
+  const bt = (
+    work: Gate[],
+    swapped: string[],
+    remaining: number
+  ): string[] | null => {
+    if (++nodeCount > MAX_NODES) return null;
+    if (remaining === 0) {
+      return fullyCorrect(work, N) ? [...swapped] : null;
+    }
+    const b = lowestWrongBit(work, N);
+    if (b === -1) {
+      // No wrong bits detected by test vectors.
+      if (fullyCorrect(work, N)) return [...swapped];
+      // Remaining swaps undetected — can't proceed with this path.
+      return null;
+    }
+
+    const cone = buildLocalCone(work, N, b);
+    const fixedSet = new Set(swapped);
+    const allOuts = work
+      .map((g) => g.out)
+      .filter((w) => !isX(w) && !isY(w) && !fixedSet.has(w));
+
+    // Try all single swaps (cone × allOuts) that fix bit b.
+    const seen = new Set<string>();
+    for (const c of cone) {
+      for (const cand of allOuts) {
+        if (c === cand) continue;
+        const key = c < cand ? `${c}|${cand}` : `${cand}|${c}`;
+        if (seen.has(key)) continue;
+        seen.add(key);
+        const test = cloneGates(work);
+        swapOut(test, c, cand);
+        if (bitCorrect(test, N, b) && bitsCorrectUpTo(test, N, b)) {
+          const result = bt(test, [...swapped, c, cand], remaining - 1);
+          if (result) return result;
+        }
+      }
+    }
+
+    // If no single swap works, try cone × cone direct double swaps only.
+    if (remaining >= 2) {
+      for (let i = 0; i < cone.length; i++) {
+        for (let j = i + 1; j < cone.length; j++) {
+          const test = cloneGates(work);
+          swapOut(test, cone[i], cone[j]);
+          if (bitCorrect(test, N, b) && bitsCorrectUpTo(test, N, b)) {
+            const result = bt(test, [...swapped, cone[i], cone[j]], remaining - 1);
+            if (result) return result;
+          }
+        }
+      }
+    }
+
+    return null;
+  };
+
+  return bt(gates, [], 4);
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  let maxZ = 0;
+  for (const g of gates) {
+    if (isZ(g.out)) {
+      const n = wireNum(g.out)!;
+      if (n > maxZ) maxZ = n;
+    }
+  }
+  const N = maxZ;
+
+  // Phase 1: structural candidates + pairing verification.
+  const candidates = collectCandidates(gates);
+  if (candidates.length >= 8 && candidates.length <= 20) {
+    const result = tryPairings(gates, N, candidates);
+    if (result) return result;
+  }
+
+  // Phase 2: simulation-guided backtracking.
+  const btResult = backtrackSearch(gates, N);
+  if (btResult) return [...new Set(btResult)].sort();
+
+  return [];
+}
