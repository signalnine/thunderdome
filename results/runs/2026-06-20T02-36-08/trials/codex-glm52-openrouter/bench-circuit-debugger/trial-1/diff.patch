+{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && cat > src/index.ts << 'CODEEOF'\nexport interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string;\n  in2: string;\n  out: string;\n}\n\nconst OPS: Record<Gate['op'], (a: number, b: number) => number> = {\n  AND: (a, b) => (a === 1 && b === 1 ? 1 : 0),\n  OR: (a, b) => (a === 1 || b === 1 ? 1 : 0),\n  XOR: (a, b) => (a \"'!== b ? 1 : 0),\n};\n\nexport function simulate(\n  gates: Gate[],\n  inputs: Record<string, number>\n): Record<string, number> {\n  const wires: Record<string, number> = { ...inputs };\n  const byOutput = new Map<string, Gate>();\n  for (const g of gates) byOutput.set(g.out, g);\n\n  const dependents: Map<string, string[]> = new Map();\n  const inDegree: Record<string, number> = {};\n  for (const g of gates) {\n    let deg = 0;\n    for (const inp of [g.in1, g.in2]) {\n      if (byOutput.has(inp) && inp !== g.out) deg++;\n    }\n    inDegree[g.out] = deg;\n    for (const inp of [g.in1, g.in2]) {\n      if (byOutput.has(inp) && inp !== g.out) {\n        if (!dependents.has(inp)) dependents.set(inp, []);\n        dependents.get(inp)!.push(g.out);\n      }\n    }\n  }\n\n  const ready: string[] = [];\n  for (const g of gates) {\n    if (inDegree[g.out] === 0) ready.push(g.out);\n  }\n\n  const pending = new Set(gates.map((g) => g.out));\n  while (ready.length) {\n    const out = ready.pop()!;\n    const g = byOutput.get(out)!;\n    if (g.in1 in wires && g.in2 in wires) {\n      wires[out] = OPS[g.op](wires[g.in1], wires[g.in2]);\n      pending.delete(out);\n      for (const dep of dependents.get(out) ?? []) {\n        inDegree[dep]--;\n        if (inDegree[dep] === 0 && !(dep in wires)) ready.push(dep);\n      }\n    }\n  }\n\n  if (pending.size) {\n    let changed = true;\n    while (changed && pending.size) {\n      changed = false;\n      for (const out of [...pending]) {\n        const g = byOutput.get(out)!;\n        if (g.in1