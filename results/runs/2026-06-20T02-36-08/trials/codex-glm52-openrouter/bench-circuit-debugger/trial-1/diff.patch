, y]) => [x & mask, y & mask] as [number, number]);\n  tests.push([mask, 1]);\n  tests.push([mask, mask]);\n  return tests;\n}\n\nfunction fullyCorrect(gates: Gate[], N: number): boolean {\n  const tests: [number, number][] = makeTests(N);\n  if (N <= 10) {\n    const size = 1 << N;\n    for (let x = 0; x < size; x++) {\n      for (let y = 0; y < size; y++) {\n        tests.push([x, y]);\n      }\n    }\n  } else {\n    let s = 98765;\n    const rnd = () => {\n      s = (s * 1103515245 + 12345) & 0x7fffffff;\n      return s;\n    };\n    const mask = N >= 31 ? 0xffffffff : (1 << N) - 1;\n    for (let t = 0; t < 50; t++) tests.push([rnd() & mask, rnd() & mask]);\n  }\n  for (const [x, y] of tests) {\n    const w = simulate(gates, makeInputs(N, x, y));\n    const expected = BigInt(x) + BigInt(y);\n    let got = 0n;\n    for (let i = 0; i <= N; i++) {\n      if (w[`z${pad(i)}`] === 1) got |= 1n << BigInt(i);\n    }\n    if (got !== expected) return false;\n  }\n  return true;\n}\n\n/** Return the lowest z-bit index that is wrong, or -1. */\nfunction lowestWrongBit(gates: Gate[], N: number): number {\n  const tests = makeTests(N);\n  let lowest = -1;\n  for (const [x, y] of tests) {\n    const w = simulate(gates, makeInputs(N, x, y));\n    const expected = BigInt(x) + BigInt(y);\n    for (let i = 0; i <= N; i++) {\n      const expBit = Number((expected >> BigInt(i)) & 1n);\n      if ((w[`z${pad(i)}`] ?? 0) !== expBit) {\n        if (lowest === -1 || i < lowest) lowest = i;\n        break;\n      }\n    }\n  }\n  return lowest;\n}\n\nfunction bitsCorrectUpTo(gates: Gate[], N: number, upTo: number): boolean {\n  const tests = makeTests(N);\n  for (const [x, y] of tests) {\n    const w = simulate(gates, makeInputs(N, x, y));\n    const expected = BigInt(x) + BigInt(y);\n    for (let i = 0; i <= upTo; i++) {\n      const expBit = Number((expected >> BigInt(i)) & 1n);\n      if ((w[`z${pad(i)}`] ?? 0) !== expBit) return false;\n    }\n  }\n  return true;\n}\n\n/** Trace carry_i by walking the chain from bit 0 (by gate inputs). */\nfunction traceCarry(gates: Gate[], targetBit: number): string | undefined {\n  let carry: string | undefined = findGate(gates, '\"'AND', \"'`x${pad(0)}`, `y${pad(0)}`)?.out;\n  if (!carry) return undefined;\n  if (targetBit === 0) return carry;\n  for (let i = 1; i <= targetBit; i++) {\n    const partial = findGate(gates, '\"'XOR', \"'`x${pad(i)}`, `y${pad(i)}`)?.out;\n    const gen = findGate(gates, '\"'AND', \"'`x${pad(i)}`, `y${pad(i)}`)?.out;\n    if (!partial || !gen || !carry) return undefined;\n    const prop: string | undefined = findGate(gates, '\"'AND', partial, carry)?.out;\n    if (\"'!prop) return undefined;\n    const nextCarry: string | undefined = findGate(gates, '\"'OR', gen, prop)?.out;\n    if (\"'!nextCarry) return undefined;\n    carry = nextCarry;\n  }\n  return carry;\n}\n\n/** Gates that reference wire w as input. */\nfunction users(gates: Gate[], w: string): Gate[] {\n  return gates.filter((g) => g.in1 === w || g.in2 === w);\n}\n\n/**\n * Build the local cone of wires relevant to bit b being the lowest wrong bit.\n * Includes transitive deps of z_b, structural wires for bits b and b-1,\n * and \"structural neighbors\" (gates sharing inputs with cone gates).\n */\nfunction buildLocalCone(\n  gates: Gate[],\n  N: number,\n  b: number,\n  alreadySwapped: string[]\n): string[] {\n  const outMap = new Map<string, Gate>();\n  for (const g of gates) outMap.set(g.out, g);\n\n  const cone = new Set<string>();\n  const fixed = new Set(alreadySwapped);\n  const add = (w: string | undefined) => {\n    if (w && !isX(w) && !isY(w) && !fixed.has(w)) cone.add(w);\n  };\n\n  const zb = `z${pad(b)}`;\n  add(zb);\n\n  // Transitive dependency cone: from z_b, trace inputs up to depth 4.\n  const visited = new Set<string>();\n  const queue: [string, number][] = [];\n  if (outMap.has(zb)) queue.push([zb, 0]);\n  while (queue.length) {\n    const [wire, depth] = queue.shift()!;\n    if (visited.has(wire)) continue;\n    visited.add(wire);\n    add(wire);\n    if (depth >= 4) continue;\n    const g = outMap.get(wire);\n    if (g) {\n      for (const inp of [g.in1, g.in2]) {\n        if (outMap.has(inp) && !visited.has(inp)) {\n          queue.push([inp, depth + 1]);\n        }\n      }\n    }\n  }\n\n  // Structural wires for bit b.\n  const partialG = findGate(gates, '\"'XOR', \"'`x${pad(b)}`, `y${pad(b)}`);\n  add(partialG?.out);\n  const genG = findGate(gates, '\"'AND', \"'`x${pad(b)}`, `y${pad(b)}`);\n  add(genG?.out);\n\n  // Structural neighbors: gates using partial_b or gen_b as input.\n  if (partialG) {\n    for (const g of users(gates, partialG.out)) {\n      add(g.out);\n    }\n  }\n  if (genG) {\n    for (const g of users(gates, genG.out)) {\n      add(g.out);\n    }\n  }\n\n  // Structural wires for bit b-1 (carry into bit b).\n  if (b >= 1) {\n    const partialPrev = findGate(gates, '\"'XOR', \"'`x${pad(b - 1)}`, `y${pad(b - 1)}`);\n    add(partialPrev?.out);\n    const genPrev = findGate(gates, '\"'AND', \"'`x${pad(b - 1)}`, `y${pad(b - 1)}`);\n    add(genPrev?.out);\n\n    // Carry_{b-1}\n    let carryPrev: string | undefined;\n    if (b === 1) {\n      carryPrev = findGate(gates, '\"'AND', \"'`x${pad(0)}`, `y${pad(0)}`)?.out;\n    } else {\n      carryPrev = traceCarry(gates, b - 1);\n    }\n    add(carryPrev);\n\n    // Gates using carry_{b-1} as input.\n    if (carryPrev) {\n      for (const g of users(gates, carryPrev)) {\n        add(g.out);\n      }\n    }\n\n    // Gates using partial_{b-1} as input.\n    if (partialPrev) {\n      for (const g of users(gates, partialPrev.out)) {\n        add(g.out);\n      }\n    }\n  }\n\n  // For bit 0, also add carry_0 and its users.\n  if (b === 0) {\n    const carry0 = findGate(gates, '\"'AND', \"'`x${pad(0)}`, `y${pad(0)}`)?.out;\n    add(carry0);\n    if (carry0) {\n      for (const g of users(gates, carry0)) {\n        add(g.out);\n      }\n    }\n  }\n\n  return [...cone];\n}\n\n/**\n * Simulation-guided backtracking search. At each level, find the lowest wrong\n * bit, try all single swaps from the cone that fix it. If no single swap works,\n * try all pairs of swaps from the cone.\n */\nfunction backtrackSearch(gates: Gate[], N: number): string[] | null {\n  const bt = (\n    work: Gate[],\n    swapped: string[],\n    remaining: number\n  ): string[] | null => {\n    if (remaining === 0) {\n      return fullyCorrect(work, N) ? [...swapped] : null;\n    }\n    const b = lowestWrongBit(work, N);\n    if (b === -1) {\n      return fullyCorrect(work, N) ? [...swapped] : null;\n    }\n\n    const cone = buildLocalCone(work, N, b, swapped);\n    const fixedSet = new Set(swapped);\n    const allOuts = work\n      .map((g) => g.out)\n      .filter((w) => !isX(w) && !isY(w) && !fixedSet.has(w));\n\n    // Collect all single swaps that fix bit b.\n    const singleSwaps: [string, string][] = [];\n    const seen = new Set<string>();\n    for (const c of cone) {\n      for (const cand of allOuts) {\n        if (c === cand) continue;\n        const key = c < cand ? `${c}|${cand}` : `${cand}|${c}`;\n        if (seen.has(key)) continue;\n        seen.add(key);\n        const test = cloneGates(work);\n        swapOut(test, c, cand);\n        if (bitsCorrectUpTo(test, N, b)) {\n          singleSwaps.push([c, cand]);\n        }\n      }\n    }\n\n    // Try each single swap with backtracking.\n    for (const [a, b2] of singleSwaps) {\n      const test = cloneGates(work);\n      swapOut(test, a, b2);\n      const result = bt(test, [...swapped, a, b2], remaining - 1);\n      if (result) return result;\n    }\n\n    // If no single swap works, try all PAIRS of swaps from the cone.\n    // This handles the case where two swaps affect the same bit.\n    if (singleSwaps.length === 0 && remaining >= 2) {\n      // Candidate pairs: both endpoints in cone, or cone x allOuts.\n      // Generate all distinct swap pairs (s1, s2) where s1 != s2 and no wire overlap.\n      const coneList = cone;\