mission('admin', 'write')).toBe(true);\n    expect(hasPermission('admin', 'delete')).toBe(true);\n    expect(hasPermission('admin', 'manage_users')).toBe(true);\n    expect(hasPermission('admin', 'view_reports')).toBe(true);\n  });\n\n  it('viewer can only read', () => {\n    expect(hasPermission('viewer', 'read')).toBe(true);\n    expect(hasPermission('viewer', 'write')).toBe(false);\n    expect(hasPermission('viewer', 'delete')).toBe(false);\n  });\n\n  it('returns all permissions for a role', () => {\n    const perms = getAllPermissions('user');\n    expect(perms).toContain('read');\n    expect(perms).toContain('write');\n    expect(perms).not.toContain('delete');\n  });\n\n  it('canManageUsers is true only for admin', () => {\n    expect(canManageUsers('admin')).toBe(true);\n    expect(canManageUsers('user')).toBe(false);\n    expect(canManageUsers('viewer')).toBe(false);\n  });\n\n  it('canWrite is true for admin and user', () => {\n    expect(canWrite('admin')).toBe(true);\n    expect(canWrite('user')).toBe(true);\n    expect(canWrite('viewer')).toBe(false);\n  });\n\n  it('canDelete is true only for admin', () => {\n    expect(canDelete('admin')).toBe(true);\n    expect(canDelete('user')).toBe(false);\n  });\n\n  it('requirePermission throws when permission is missing', () => {\n    expect(() => requirePermission('viewer', 'write')).toThrow(\n      \"Role 'viewer' does not have permission 'write'\"\n    );\n  });\n});\n","exit_code":0,"status":"completed"}}
