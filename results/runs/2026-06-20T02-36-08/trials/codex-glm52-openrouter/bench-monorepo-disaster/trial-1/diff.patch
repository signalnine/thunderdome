Interval(async () => {\n        try {\n          await job.handler();\n          job.lastRun = new Date();\n          job.runCount++;\n        } catch (err) {\n          job.errors.push(\n            err instanceof Error ? err.message : String(err)\n          );\n        }\n      }, job.intervalMs);\n    }\n  }\n\n  stop(): void {\n    if (!this.running) return;\n    this.running = false;\n\n    for (const [, job] of this.jobs) {\n      if (job.timer) {\n        clearInterval(job.timer);\n        job.timer = undefined;\n      }\n    }\n  }\n\n  async runOnce(name: string): Promise<void> {\n    const job = this.jobs.get(name);\n    if (!job) {\n      throw new Error(`Job '${name}' not found`);\n    }\n\n    await job.handler();\n    job.lastRun = new Date();\n    job.runCount++;\n  }\n\n  getStatus(): Array<{\n    name: string;\n    lastRun: Date | undefined;\n    runCount: number;\n    errorCount: number;\n  }> {\n    return Array.from(this.jobs.values()).map((job) => ({\n      name: job.name,\n      lastRun: job.lastRun,\n      runCount: job.runCount,\n      errorCount: job.errors.length,\n    }));\n  }\n\n  isRunning(): boolean {\n    return this.running;\n  }\n}\n\n=== /workspace/packages/worker/src/jobs/cleanup.ts ===\n/**\n * Cleanup job.\n * Removes stale data and performs maintenance tasks.\n */\n\nimport { getAllUsers } from '@monorepo/core';\n\nexport interface CleanupResult {\n  staleRecords: number;\n  cleanedUp: number;\n  duration: number;\n}\n\nexport async function cleanupJob(): Promise<CleanupResult> {\n  const startTime = Date.now();\n\n  // Get all users to check for stale records\n  const users = getAllUsers();\n\n  let staleRecords = 0;\n  let cleanedUp = 0;\n\n  for (const user of users) {\n    const createdDate = new Date(user.createdAt);\n    const now = new Date();\n    const daysSinceCreation =\n      (now.getTime() - createdDate.getTime()) / (1000 * 60 * 60 * 24);\n\n    // Mark records older than 365 days as stale (simulation)\n    if (daysSinceCreation > 365) {\n      staleRecords++;\n      // In a real app, we'd archive or delete\n      cleanedUp++;\n    }\n  }\n\n  const duration = Date.now() - startTime;\n\n  console.log(\n    `Cleanup complete: ${staleRecords} stale, ${cleanedUp} cleaned in ${duration}ms`\n  );\n\n  return { staleRecords, cleanedUp, duration };\n}\n\nexport function getCleanupThresholdDays(): number {\n  return 365;\n}\n\n=== /workspace/packages/worker/src/jobs/sync.ts ===\n/**\n * Data sync job.\n * Syncs external user data into the local database.\n */\n\nimport {\n  createUser,\n  getUserById,\n  getAllUsers,\n  type CreateUserInput,\n} from '@monorepo/core';\n\ninterface ExternalUser {\n  name: string;\n  email: string;\n  role: 'admin' | 'user' | 'viewer';\n}\n\n// Simulated external data source\nfunction fetchExternalUsers(): ExternalUser[] {\n  return [\n    { name: 'External User 1', email: 'ext1@example.com', role: 'user' },\n    { name: 'External User 2', email: 'ext2@example.com', role: 'viewer' },\n  ];\n}\n\nexport async function syncJob(): Promise<void> {\n  const externalUsers = fetchExternalUsers();\n  const existingUsers = getAllUsers();\n  const existingEmails = new Set(existingUsers.map((u) => u.email));\n\n  let synced = 0;\n  let skipped = 0;\n\n  for (const extUser of externalUsers) {\n    if (existingEmails.has(extUser.email)) {\n      skipped++;\n      continue;\n    }\n\n    const input: CreateUserInput = {\n      name: extUser.name,\n      email: extUser.email,\n      role: extUser.role,\n    };\n\n    try {\n      const newUser = createUser(input);\n      if (newUser.id) {\n        synced++;\n      }\n    } catch (err) {\n      console.error(`Failed to sync user ${extUser.email}:`, err);\n    }\n  }\n\n  console.log(`Sync complete: ${synced} synced, ${skipped} skipped`);\n}\n\nexport async function syncSingleUser(userId: number): Promise<boolean> {\n  const user = getUserById(userId);\n  if (!user) {\n    console.error(`User ${userId} not found for sync`);\n    return false;\n  }\n\n  // In a real app, we'd sync to an external service here\n  console.log(`Synced user ${user.name} (${user.email})`);\n  return true;\n}\n\n","exit_code":0,"status":"completed"}}
