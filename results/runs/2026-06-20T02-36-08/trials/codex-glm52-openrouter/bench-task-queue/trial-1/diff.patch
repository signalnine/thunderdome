+  ): Task {
+    if (this.shuttingDown) {
+      throw new Error('Cannot enqueue tasks after shutdown has been initiated');
+    }
+
+    let queueName: string;
+    let data: unknown;
+    let opts: TaskOptions | undefined;
+
+    if (payload === undefined && options === undefined) {
+      queueName = 'default';
+      data = first;
+      opts = undefined;
+    } else {
+      queueName = first as string;
+      data = payload;
+      opts = options;
+    }
+
+    const priority = opts?.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error('Priority must be between 1 and 10');
+    }
+
+    const dependsOn = opts?.dependsOn ?? [];
+    for (const depId of dependsOn) {
+      if (!this.tasks.has(depId)) {
+        throw new Error(`Dependency task not found: ${depId}`);
+      }
+    }
+
+    const id = randomUUID();
+    this.checkCycle(dependsOn, id);
+
+    const createdAt = new Date();
+    let availableAt = createdAt;
+    if (opts?.delay !== undefined) {
+      availableAt = new Date(createdAt.getTime() + opts.delay);
+    }
+    if (opts?.runAt) {
+      availableAt = opts.runAt;
+    }
+
+    const task: Task = {
+      id,
+      payload: data,
+      status: 'pending',
+      createdAt,
+      priority,
+      availableAt,
+      attempts: 0,
+      maxRetries: opts?.maxRetries ?? 3,
+      backoffMs: opts?.backoffMs ?? 1000,
+      failCount: 0,
+      queueName,
+      dependsOn,
+      seq: this.seqCounter++,
+    };
+
+    this.tasks.set(id, task);
+    const q = this.getOrCreateQueue(queueName);
+    q.pending.push(task);
+    return task;
+  }
+
+  dequeue(queueName: string = 'default'): Task | null {
+    const q = this.queues.get(queueName);
+    if (!q) return null;
+    if (q.concurrencyLimit !== Infinity && q.processing.size >= q.concurrencyLimit) {
+      return null;
+    }
+
+    const best = this.bestTask(q.pending);
+    if (!best) return null;
+
+    const idx = q.pending.indexOf(best);
+    if (idx >= 0) q.pending.splice(idx, 1);
+
+    best.status = 'processing';
+    best.attempts += 1;
+    q.processing.add(best.id);
+    return best;
+  }
+
+  size(): number {
+    let total = 0;
+    for (const q of this.queues.values()) {
+      total += q.pending.length;
+    }
+    return total;
+  }
+
+  queueSize(queueName: string): number {
+    const q = this.queues.get(queueName);
+    return q ? q.pending.length : 0;
+  }
+
+  listQueues(): string[] {
+    return Array.from(this.queues.keys());
+  }
+
+  complete(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) return;
+    const wasProcessing = task.status === 'processing';
+    task.status = 'completed';
+    const q = this.queues.get(task.queueName);
+    if (q) {
+      if (wasProcessing) q.processing.delete(taskId);
+      const idx = q.pending.indexOf(task);
+      if (idx >= 0) q.pending.splice(idx, 1);
+    }
+    if (wasProcessing && this.shuttingDown) {
+      this.shutdownCompleted++;
+      this.maybeFinishShutdown();
+    }
+  }
+
+  fail(taskId: string, error?: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    task.lastError = error;
+    task.failCount += 1;
+
+    const q = this.queues.get(task.queueName);
+    if (q) q.processing.delete(taskId);
+
+    if (task.attempts <= task.maxRetries) {
+      const delay = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + delay);
+      if (q) q.pending.push(task);
+    } else {
+      task.status = 'failed';
+      if (q) q.dlq.push(task);
+    }
+
+    if (this.shuttingDown) {
+      this.maybeFinishShutdown();
+    }
+  }
+
+  getDLQ(queueName: string): Task[] {
+    const q = this.queues.get(queueName);
+    return q ? [...q.dlq] : [];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    for (const q of this.queues.values()) {
+      const idx = q.dlq.findIndex((t) => t.id === taskId);
+      if (idx >= 0) {
+        const task = q.dlq[idx];
+        q.dlq.splice(idx, 1);
+        task.status = 'pending';
+        task.attempts = 0;
+        task.failCount = 0;
+        task.lastError = undefined;
+        task.availableAt = new Date();
+        const targetQ = this.getOrCreateQueue(task.queueName);
+        targetQ.pending.push(task);
+        return task;
+      }
+    }
+    return null;
+  }
+
+  clearDLQ(queueName: string): void {
+    const q = this.queues.get(queueName);
+    if (q) q.dlq = [];
+  }
+
+  getDependencies(taskId: string): Array<{ taskId: string; status: string }> {
+    const task = this.tasks.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map((depId) => {
+      const dep = this.tasks.get(depId);
+      return { taskId: depId, status: dep ? dep.status : 'unknown' };
+    });
+  }
+
+  setConcurrency(queueName: string, limit: number): void {
+    const q = this.getOrCreateQueue(queueName);
+    q.concurrencyLimit = limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const q = this.queues.get(queueName);
+    if (!q) return { current: 0, max: Infinity };
+    return { current: q.processing.size, max: q.concurrencyLimit };
+  }
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error('Progress percent must be between 0 and 100');
+    }
+    const info: ProgressInfo = {
+      percent,
+      updatedAt: new Date(),
+    };
+    if (message !== undefined) {
+      info.message = message;
+    }
+    this.progressMap.set(taskId, info);
+    const cbs = this.progressCallbacks.get(taskId);
+    if (cbs) {
+      for (const cb of cbs) cb(info);
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progressMap.get(taskId) ?? null;
+  }
+
+  onProgress(
+    taskId: string,
+    callback: (info: ProgressInfo) => void,
+  ): () => void {
+    let set = this.progressCallbacks.get(taskId);
+    if (!set) {
+      set = new Set();
+      this.progressCallbacks.set(taskId, set);
+    }
+    set.add(callback);
+    return () => {
+      set!.delete(callback);
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) return;
+    const wasProcessing = task.status === 'processing';
+    task.status = 'cancelled';
+    const q = this.queues.get(task.queueName);
+    if (q) {
+      if (wasProcessing) q.processing.delete(taskId);
+      const idx = q.pending.indexOf(task);
+      if (idx >= 0) q.pending.splice(idx, 1);
+    }
+    if (wasProcessing && this.shuttingDown) {
+      this.shutdownCancelled++;
+      this.maybeFinishShutdown();
+    }
+  }
+
+  schedule(
+    queueName: string,
+    cronExpression: string,
+    taskTemplate: unknown,
+  ): Schedule {
+    const id = randomUUID();
+    const now = new Date();
+    const nextRun = this.computeNextRun(now, cronExpression);
+    const sched: Schedule = {
+      id,
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+      nextRun,
+    };
+    this.schedules.set(id, sched);
+    return sched;
+  }
+
+  unschedule(scheduleId: string): void {
+    const s = this.schedules.get(scheduleId);
+    if (s) s.active = false;
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const result: Schedule[] = [];
+    for (const s of this.schedules.values()) {
+      if (!s.active) continue;
+      if (queueName !== undefined && s.queueName !== queueName) continue;
+      result.push(s);
+    }
+    return result;
+  }
+
+  tick(): void {
+    const now = Date.now();
+    for (const s of this.schedules.values()) {
+      if (!s.active) continue;
+      while (s.nextRun.getTime() <= now) {
+        this.enqueue(s.queueName, s.taskTemplate);
+        s.nextRun = this.computeNextRun(s.nextRun, s.cronExpression);
+      }
+    }
+  }
+
+  use(queueName: string, middleware: Middleware): void {
+    const q = this.getOrCreateQueue(queueName);
+    q.middleware.push(middleware);
+  }
+
+  async process(queueName: string, handler: TaskHandler): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+    const q = this.queues.get(queueName);
+    const middlewares = q ? q.middleware : [];
+    try {
+      await this.runMiddleware(task, middlewares, handler);
+      this.complete(task.id);
+    } catch (err) {
+      this.fail(task.id, err instanceof Error ? err.message : String(err));
+    }
+  }
+
+  shutdown(timeout: number = 30000): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+
+    this.shuttingDown = true;
+    this.shutdownStart = Date.now();
+    this.shutdownCompleted = 0;
+    this.shutdownCancelled = 0;
+
+    for (const cb of this.shutdownCallbacks) {
+      try {
+        cb();
+      } catch {
+        // ignore callback errors
+      }
+    }
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      this.shutdownResolve = resolve;
+      this.shutdownTimer = setTimeout(() => {
+        this.forceCancelProcessing();
+        this.finishShutdown();
+      }, timeout);
+
+      if (this.totalProcessing() === 0) {
+        if (this.shutdownTimer) clearTimeout(this.shutdownTimer);
+        this.finishShutdown();
+      }
+    });
+
+    return this.shutdownPromise;
+  }
+
+  onShutdown(callback: () => void): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  private getOrCreateQueue(queueName: string): QueueData {
+    let q = this.queues.get(queueName);
+    if (!q) {
+      q = {
+        pending: [],
+        middleware: [],
+        concurrencyLimit: Infinity,
+        processing: new Set<string>(),
+        dlq: [],
+      };
+      this.queues.set(queueName, q);
+    }
+    return q;
+  }
+
+  private bestTask(tasks: Task[]): Task | null {
+    const now = Date.now();
+    const available = tasks.filter(
+      (t) =>
+        t.status === 'pending' &&
+        t.availableAt.getTime() <= now &&
+        this.depsSatisfied(t),
+    );
+    if (available.length === 0) return null;
+    available.sort((a, b) => {
+      if (a.priority !== b.priority) return a.priority - b.priority;
+      const at = a.availableAt.getTime();
+      const bt = b.availableAt.getTime();
+      if (at !== bt) return at - bt;
+      return a.seq - b.seq;
+    });
+    return available[0];
+  }
+
+  private depsSatisfied(task: Task): boolean {
+    if (task.dependsOn.length === 0) return true;
+    return task.dependsOn.every((depId) => {
+      const dep = this.tasks.get(depId);
+      return dep !== undefined && dep.status === 'completed';
+    });
+  }
+
+  private checkCycle(dependsOn: string[], newId: string): void {
+    const visited = new Set<string>();
+    const stack = [...dependsOn];
+    while (stack.length > 0) {
+      const cur = stack.pop()!;
+      if (cur === newId) {
+        throw new Error('Circular dependency detected');
+      }
+      if (visited.has(cur)) continue;
+      visited.add(cur);
+      const t = this.tasks.get(cur);
+      if (t) {
+        for (const d of t.dependsOn) stack.push(d);
+      }
+    }
+  }
+
+  private runMiddleware(
+    task: Task,
+    middlewares: Middleware[],
+    handler: TaskHandler,
+  ): Promise<void> {
+    let index = 0;
+    const next = async (): Promise<void> => {
+      if (index < middlewares.length) {
+        const mw = middlewares[index];
+        index++;
+        await mw(task, next);
+      } else {
+        await handler(task);
+      }
+    };
+    return next();
+  }
+
+  private totalProcessing(): number {
+    let count = 0;
+    for (const q of this.queues.values()) {
+      count += q.processing.size;
+    }
+    return count;
+  }
+
+  private forceCancelProcessing(): void {
+    const ids: string[] = [];
+    for (const q of this.queues.values()) {
+      for (const id of q.processing) ids.push(id);
+    }
+    for (const id of ids) this.cancel(id);
+  }
+
+  private maybeFinishShutdown(): void {
+    if (this.shutdownResolve && this.totalProcessing() === 0) {
+      if (this.shutdownTimer) clearTimeout(this.shutdownTimer);
+      this.finishShutdown();
+    }
+  }
+
+  private finishShutdown(): void {
+    if (!this.shutdownResolve) return;
+    const resolve = this.shutdownResolve;
+    this.shutdownResolve = null;
+    const elapsed = Date.now() - this.shutdownStart;
+    resolve({
+      completed: this.shutdownCompleted,
+      cancelled: this.shutdownCancelled,
+      elapsed,
+    });
+  }
+
+  private computeNextRun(from: Date, cron: string): Date {
+    const fields = cron.trim().split(/\s+/);
+    let d = new Date(from.getTime());
+    d.setUTCSeconds(0, 0);
+    d = new Date(d.getTime() + 60000);
+    let iterations = 0;
+    while (!this.matchesCron(d, fields)) {
+      d = new Date(d.getTime() + 60000);
+      iterations++;
+      if (iterations > 525600) break;
+    }
+    return d;
+  }
+
+  private matchesCron(date: Date, fields: string[]): boolean {
+    const minField = fields[0] ?? '*';
+    const hourField = fields[1] ?? '*';
+    const domField = fields[2] ?? '*';
+    const monthField = fields[3] ?? '*';
+    const dowField = fields[4] ?? '*';
+    return (
+      this.matchField(date.getUTCMinutes(), minField) &&
+      this.matchField(date.getUTCHours(), hourField) &&
+      this.matchField(date.getUTCDate(), domField) &&
+      this.matchField(date.getUTCMonth() + 1, monthField) &&
+      this.matchField(date.getUTCDay(), dowField)
+    );
+  }
+
+  private matchField(value: number, field: string): boolean {
+    if (field === '*') return true;
+    const everyMatch = field.match(/^\*\/(\d+)$/);
+    if (everyMatch) {
+      const n = parseInt(everyMatch[1], 10);
+      return n > 0 && value % n === 0;
+    }
+    const num = parseInt(field, 10);
+    if (Number.isNaN(num)) return true;
+    return value === num;
+  }
+}
