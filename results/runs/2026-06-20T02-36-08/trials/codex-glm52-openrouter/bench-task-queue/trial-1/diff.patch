+{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'cat /workspace/tests/phase-07.test.ts /workspace/tests/phase-08.test.ts'","aggregated_output":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 7: Task Dependencies', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('task with dependencies is not available until deps complete', () => {\n    const dep = queue.enqueue('work', { name: 'dependency' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n\n    // Dequeue should return the dependency first (no deps blocking it)\n    const first = queue.dequeue('work');\n    expect(first!.payload).toEqual({ name: 'dependency' });\n\n    // Dependent should not be available yet\n    const second = queue.dequeue('work');\n    expect(second).toBeNull();\n  });\n\n  it('completing a dependency makes dependent task available', () => {\n    const dep = queue.enqueue('work', { name: 'dependency' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n\n    const task = queue.dequeue('work')!;\n    queue.complete(task.id);\n\n    // Now the dependent should be available\n    const dependent = queue.dequeue('work');\n    expect(dependent).not.toBeNull();\n    expect(dependent!.payload).toEqual({ name: 'dependent' });\n  });\n\n  it('all dependencies must complete before dependent is available', () => {\n    const dep1 = queue.enqueue('work', { name: 'dep1' });\n    const dep2 = queue.enqueue('work', { name: 'dep2' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep1.id, dep2.id] });\n\n    // Process dep1\n    const task1 = queue.dequeue('work')!;\n    queue.complete(task1.id);\n\n    // dep2 should be available but dependent should not\n    const task2 = queue.dequeue('work')!;\n    expect(task2.payload).toEqual({ name: 'dep2' });\n\n    // Dependent still blocked (dep2 not completed yet)\n    expect(queue.dequeue('work')).toBeNull();\n\n    // Complete dep2\n    queue.complete(task2.id);\n\n    // Now dependent is available\n    const dependent = queue.dequeue('work');\n    expect(dependent).not.toBeNull();\n    expect(dependent!.payload).toEqual({ name: 'dependent' });\n  });\n\n  it('circular dependency throws an error', () => {\n    const a = queue.enqueue('work', { name: 'A' });\n    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [a.id] });\n\n    // Trying to make A depend on B creates a cycle\n    expect(() =>\n      queue.enqueue('work', { name: 'C' }, { dependsOn: [b.id, a.id] })\n    ).not.toThrow(); // C -> B -> A is fine, no cycle\n\n    // Direct cycle: X depends on Y, Y depends on X\n    const x = queue.enqueue('work', { name: 'X' });\n    queue.enqueue('work', { name: 'Y' }, { dependsOn: [x.id] });\n\n    // This should not throw since there's no actual circular dependency here\n    // A true circular dependency:\n    const m = queue.enqueue('work', { name: 'M' });\n    const n = queue.enqueue('work', { name: 'N' }, { dependsOn: [m.id] });\n    expect(() =>\n      queue.enqueue('work', { name: 'O' }, { dependsOn: [n.id, m.id] })\n    ).not.toThrow(); // O -> N -> M is fine\n\n    // Real cycle detection test\n    const p = queue.enqueue('other', { name: 'P' });\n    const _q2 = queue.enqueue('other', { name: 'Q' }, { dependsOn: [p.id] });\n    // Cycle detection is verified above; with forward-only enqueue,\n    // cycles can only be detected at enqueue time through transitive dep chains.\n  });\n\n  it('getDependencies returns dependency info with statuses', () => {\n    const dep1 = queue.enqueue('work', { name: 'dep1' });\n    const dep2 = queue.enqueue('work', { name: 'dep2' });\n    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n      dependsOn: [dep1.id, dep2.id],\n    });\n\n    const deps = queue.getDependencies(dependent.id);\n    expect(deps).toHaveLength(2);\n    expect(deps).toContainEqual({ taskId: dep1.id, status: 'pending' });\n    expect(deps).toContainEqual({ taskId: dep2.id, status: 'pending' });\n\n    // After completing one\n    const task = queue.dequeue('work')!;\n    queue.complete(task.id);\n\n    const updatedDeps = queue.getDependencies(dependent.id);\n    const completedDep = updatedDeps.find(d => d.taskId === dep1.id);\n    expect(completedDep!.status).toBe('completed');\n  });\n\n  it('cascading dependencies work correctly (A depends on B depends on C)', () => {\n    const c = queue.enqueue('work', { name: 'C' });\n    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [c.id] });\n    const a = queue.enqueue('work', { name: 'A' }, { dependsOn: [b.id] });\n\n    // Only C is available\n    const taskC = queue.dequeue('work')!;\n    expect(taskC.payload).toEqual({ name: 'C' });\n    expect(queue.dequeue('work')).toBeNull();\n\n    queue.complete(taskC.id);\n\n    // Now B is available\n    const taskB = queue.dequeue('work')!;\n    expect(taskB.payload).toEqual({ name: 'B' });\n    expect(queue.dequeue('work')).toBeNull();\n\n    queue.complete(taskB.id);\n\n    // Now A is available\n    const taskA = queue.dequeue('work')!;\n    expect(taskA.payload).toEqual({ name: 'A' });\n    expect(taskA.id).toBe(a.id);\n  });\n\n  it('failed dependency does not auto-fail the dependent task', () => {\n    const dep = queue.enqueue('work', { name: 'dep' }, { maxRetries: 0 });\n    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n      dependsOn: [dep.id],\n    });\n\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'dep failed');\n\n    // Dependent stays blocked (not failed)\n    expect(dependent.status).toBe('pending');\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('dependency on non-existent task throws an error', () => {\n    expect(() =>\n      queue.enqueue('work', { name: 'orphan' }, { dependsOn: ['nonexistent-id'] })\n    ).toThrow();\n  });\n});\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 8: Concurrency Control', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('setConcurrency limits the number of concurrent processing tasks', () => {\n    queue.setConcurrency('work', 2);\n    queue.enqueue('work', { job: 1 });\n    queue.enqueue('work', { job: 2 });\n    queue.enqueue('work', { job: 3 });\n\n    const t1 = queue.dequeue('work');\n    const t2 = queue.dequeue('work');\n    expect(t1).not.toBeNull();\n    expect(t2).not.toBeNull();\n\n    // Third dequeue should return null (at limit)\n    const t3 = queue.dequeue('work');\n    expect(t3).toBeNull();\n  });\n\n  it('dequeue returns null when at concurrency limit even if tasks available', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { job: 'a' });\n    queue.enqueue('work', { job: 'b' });\n\n    queue.dequeue('work'); // takes slot\n    const second = queue.dequeue('work');\n    expect(second).toBeNull();\n  });\n\n  it('completing a task frees a concurrency slot', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { job: 'first' });\n    queue.enqueue('work', { job: 'second' });\n\n    const first = queue.dequeue('work')!;\n    expect(queue.dequeue('work')).toBeNull(); // at limit\n\n    queue.complete(first.id);\n\n    const second = queue.dequeue('work');\n    expect(second).not.toBeNull();\n    expect(second!.payload).toEqual({ job: 'second' });\n  });\n\n  it('getConcurrency returns current and max info', () => {\n    queue.setConcurrency('work', 3);\n    queue.enqueue('work', { job: 1 });\n    queue.enqueue('work', { job: 2 });\n\n    const info1 = queue.getConcurrency('work');\n    expect(info1.max).toBe(3);\n    expect(info1.current).toBe(0);\n\n    queue.dequeue('work');\n    const info2 = queue.getConcurrency('work');\n    expect(info2.current).toBe(1);\n\n    queue.dequeue('work');\n    const info3 = queue.getConcurrency('work');\n    expect(info3.current).toBe(2);\n  });\n\n  it('default concurrency is unlimited', () => {\n    for (let i = 0; i < 100; i++) {\n      queue.enqueue('work', { job: i });\n    }\n\n    const tasks = [];\n    for (let i = 0; i < 100; i++) {\n      const t = queue.dequeue('work');\n      if (!t) break;\n      tasks.push(t);\n    }\n\n    expect(tasks.length).toBe(100);\n  });\n\n  it('concurrency limits are independent per queue', () => {\n    queue.setConcurrency('queue-a', 1);\n    queue.setConcurrency('queue-b', 2);\n\n    queue.enqueue('queue-a', { q: 'a1' });\n    queue.enqueue('queue-a', { q: 'a2' });\n    queue.enqueue('queue-b', { q: 'b1' });\n    queue.enqueue('queue-b', { q: 'b2' });\n    queue.enqueue('queue-b', { q: 'b3' });\n\n    queue.dequeue('queue-a'); // 1 processing in queue-a\n    expect(queue.dequeue('queue-a')).toBeNull(); // at limit for queue-a\n\n    queue.dequeue('queue-b'); // 1 processing in queue-b\n    expect(queue.dequeue('queue-b')).not.toBeNull(); // can still dequeue (limit 2)\n    expect(queue.dequeue('queue-b')).toBeNull(); // now at limit\n  });\n\n  it('concurrency respects priority ordering', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { name: 'low' }, { priority: 9 });\n    queue.enqueue('work', { name: 'high' }, { priority: 1 });\n\n    const task = queue.dequeue('work')!;\n    expect(task.payload).toEqual({ name: 'high' });\n  });\n});\n","exit_code":0,"status":"completed"}}
