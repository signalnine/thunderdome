+{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'cat /workspace/tests/phase-09.test.ts /workspace/tests/phase-10.test.ts'","aggregated_output":"import { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 9: Progress and Cancellation', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('updateProgress sets the percentage for a task', () => {\n    queue.enqueue('work', { job: 'progress' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 50);\n    const progress = queue.getProgress(task.id);\n    expect(progress!.percent).toBe(50);\n  });\n\n  it('getProgress returns current progress info', () => {\n    queue.enqueue('work', { job: 'progress' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 75, 'Almost done');\n    const progress = queue.getProgress(task.id);\n\n    expect(progress).not.toBeNull();\n    expect(progress!.percent).toBe(75);\n    expect(progress!.message).toBe('Almost done');\n    expect(progress!.updatedAt).toBeInstanceOf(Date);\n  });\n\n  it('onProgress callback fires when progress is updated', () => {\n    queue.enqueue('work', { job: 'callback' });\n    const task = queue.dequeue('work')!;\n\n    const updates: Array<{ percent: number; message?: string }> = [];\n    queue.onProgress(task.id, (info) => {\n      updates.push({ percent: info.percent, message: info.message });\n    });\n\n    queue.updateProgress(task.id, 25, 'Starting');\n    queue.updateProgress(task.id, 50, 'Halfway');\n    queue.updateProgress(task.id, 100, 'Done');\n\n    expect(updates).toHaveLength(3);\n    expect(updates[0]).toEqual({ percent: 25, message: 'Starting' });\n    expect(updates[1]).toEqual({ percent: 50, message: 'Halfway' });\n    expect(updates[2]).toEqual({ percent: 100, message: 'Done' });\n  });\n\n  it('cancel sets task status to cancelled', () => {\n    const task = queue.enqueue('work', { job: 'cancel-me' });\n    queue.cancel(task.id);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('cancelled pending task is removed from the queue', () => {\n    queue.enqueue('work', { job: 'stay' });\n    const toCancel = queue.enqueue('work', { job: 'cancel' });\n    queue.enqueue('work', { job: 'stay2' });\n\n    queue.cancel(toCancel.id);\n\n    const t1 = queue.dequeue('work')!;\n    const t2 = queue.dequeue('work')!;\n    expect(t1.payload).toEqual({ job: 'stay' });\n    expect(t2.payload).toEqual({ job: 'stay2' });\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('cancelled processing task has its status set to cancelled', () => {\n    queue.enqueue('work', { job: 'processing-cancel' });\n    const task = queue.dequeue('work')!;\n    expect(task.status).toBe('processing');\n\n    queue.cancel(task.id);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('cancelled task is not retried', () => {\n    queue.enqueue('work', { job: 'no-retry' }, { maxRetries: 3 });\n    const task = queue.dequeue('work')!;\n\n    queue.cancel(task.id);\n\n    // Even after long delay, cancelled task should not reappear\n    vi.advanceTimersByTime(100000);\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('progress message is optional', () => {\n    queue.enqueue('work', { job: 'no-msg' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 42);\n    const progress = queue.getProgress(task.id);\n\n    expect(progress!.percent).toBe(42);\n    expect(progress!.message).toBeUndefined();\n  });\n});\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 10: Recurring Tasks (Cron)', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers({ now: new Date('2025-01-01T00:00:00.000Z') });\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('schedule creates a recurring task definition', () => {\n    const schedule = queue.schedule('work', '*/5 * * * *', { type: 'cleanup' });\n\n    expect(schedule).toHaveProperty('id');\n    expect(schedule.queueName).toBe('work');\n    expect(schedule.cronExpression).toBe('*/5 * * * *');\n    expect(schedule.taskTemplate).toEqual({ type: 'cleanup' });\n    expect(schedule.active).toBe(true);\n  });\n\n  it('tick triggers scheduled tasks when they are due', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'periodic' });\n\n    // Advance 5 minutes\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const task = queue.dequeue('work');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({ type: 'periodic' });\n  });\n\n  it('unschedule stops future occurrences', () => {\n    const schedule = queue.schedule('work', '*/5 * * * *', { type: 'stop-me' });\n\n    queue.unschedule(schedule.id);\n\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('listSchedules returns active schedules', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'a' });\n    queue.schedule('work', '*/10 * * * *', { type: 'b' });\n    const toRemove = queue.schedule('other', '0 * * * *', { type: 'c' });\n\n    queue.unschedule(toRemove.id);\n\n    const schedules = queue.listSchedules();\n    expect(schedules.length).toBe(2);\n\n    const workSchedules = queue.listSchedules('work');\n    expect(workSchedules.length).toBe(2);\n  });\n\n  it('cron \"every 5 minutes\" triggers at correct intervals', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'five-min' });\n\n    // Advance 3 minutes - should not trigger\n    vi.advanceTimersByTime(3 * 60 * 1000);\n    queue.tick();\n    expect(queue.dequeue('work')).toBeNull();\n\n    // Advance 2 more minutes (total 5) - should trigger\n    vi.advanceTimersByTime(2 * 60 * 1000);\n    queue.tick();\n    expect(queue.dequeue('work')).not.toBeNull();\n  });\n\n  it('scheduled task gets the correct queue and payload', () => {\n    queue.schedule('notifications', '*/1 * * * *', {\n      type: 'reminder',\n      message: 'Check your inbox',\n    });\n\n    vi.advanceTimersByTime(1 * 60 * 1000);\n    queue.tick();\n\n    const task = queue.dequeue('notifications');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({\n      type: 'reminder',\n      message: 'Check your inbox',\n    });\n\n    // Should not be in other queues\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('multiple schedules can coexist', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'every-5' });\n    queue.schedule('work', '*/10 * * * *', { type: 'every-10' });\n\n    // At 5 minutes, only every-5 triggers\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const tasks5 = [];\n    let t;\n    while ((t = queue.dequeue('work')) !== null) {\n      tasks5.push(t);\n    }\n    expect(tasks5.length).toBe(1);\n    expect(tasks5[0].payload).toEqual({ type: 'every-5' });\n\n    // At 10 minutes, both trigger\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const tasks10 = [];\n    while ((t = queue.dequeue('work')) !== null) {\n      tasks10.push(t);\n    }\n    expect(tasks10.length).toBe(2);\n    const types = tasks10.map(t => t.payload.type).sort();\n    expect(types).toEqual(['every-10', 'every-5']);\n  });\n});\n","exit_code":0,"status":"completed"}}
