+export type Grid = string[][];
+
+// Beam directions. Each step always advances row by +1.
+const DOWN = 0; //       (row + 1, col)
+const DOWN_LEFT = 1; //  (row + 1, col - 1)
+const DOWN_RIGHT = 2; // (row + 1, col + 1)
+
+interface SourceLocation {
+  row: number;
+  col: number;
+}
+
+interface BeamState {
+  row: number;
+  col: number;
+  dir: number;
+}
+
+interface Transitions {
+  // In-bounds successor states (beams that continue into the grid).
+  nexts: BeamState[];
+  // How many branches leave the grid from this state (absorbed beams).
+  exits: number;
+}
+
+function locateSource(grid: Grid): SourceLocation | null {
+  if (grid.length === 0 || grid[0].length === 0) return null;
+  const topRow = grid[0];
+  for (let col = 0; col < topRow.length; col++) {
+    if (topRow[col] === 'S') return { row: 0, col };
+  }
+  return null;
+}
+
+// Given an in-bounds beam at (row, col) traveling in `dir`, compute where it
+// goes next. The cell type determines the transition:
+//   'S' -> one beam straight down (source always emits downward)
+//   '^' -> two diagonal beams (down-left + down-right), regardless of incoming dir
+//   '.' -> continue in the current direction
+// Successors that fall outside the grid are counted as `exits` (absorbed).
+function transitions(
+  grid: Grid,
+  rows: number,
+  cols: number,
+  row: number,
+  col: number,
+  dir: number,
+): Transitions {
+  const cell = grid[row][col];
+  const result: Transitions = { nexts: [], exits: 0 };
+
+  const advance = (nextRow: number, nextCol: number, nextDir: number): void => {
+    if (
+      nextRow < 0 ||
+      nextRow >= rows ||
+      nextCol < 0 ||
+      nextCol >= cols
+    ) {
+      result.exits += 1;
+    } else {
+      result.nexts.push({ row: nextRow, col: nextCol, dir: nextDir });
+    }
+  };
+
+  if (cell === 'S') {
+    advance(row + 1, col, DOWN);
+  } else if (cell === '^') {
+    advance(row + 1, col - 1, DOWN_LEFT);
+    advance(row + 1, col + 1, DOWN_RIGHT);
+  } else {
+    // '.' (or any other pass-through cell): keep the current heading.
+    if (dir === DOWN) {
+      advance(row + 1, col, DOWN);
+    } else if (dir === DOWN_LEFT) {
+      advance(row + 1, col - 1, DOWN_LEFT);
+    } else {
+      advance(row + 1, col + 1, DOWN_RIGHT);
+    }
+  }
+
+  return result;
+}
+
+/**
+ * Count the number of distinct grid cells visited by any beam.
+ * The source cell counts, as does every splitter cell a beam reaches.
+ * Out-of-bounds (absorbed) cells do not count. Overlapping beams at the same
+ * cell are counted once.
+ *
+ * Uses BFS over (row, col, dir) states with a visited-state guard, so each
+ * reachable state is processed at most once. The state space is bounded by
+ * rows * cols * 3, keeping this efficient even for large grids.
+ */
+export function countBeamCells(grid: Grid): number {
+  const source = locateSource(grid);
+  if (source === null) return 0;
+
+  const rows = grid.length;
+  const cols = grid[0].length;
+
+  // Distinct cells visited (keyed by row * cols + col).
+  const visitedCells = new Set<number>();
+  // States already queued/processed (keyed by (row * cols + col) * 3 + dir).
+  const seenStates = new Set<number>();
+  const queue: BeamState[] = [];
+
+  const cellKey = (r: number, c: number): number => r * cols + c;
+  const stateKey = (r: number, c: number, d: number): number =>
+    (r * cols + c) * 3 + d;
+
+  const enqueue = (state: BeamState): void => {
+    visitedCells.add(cellKey(state.row, state.col));
+    const key = stateKey(state.row, state.col, state.dir);
+    if (!seenStates.has(key)) {
+      seenStates.add(key);
+      queue.push(state);
+    }
+  };
+
+  enqueue({ row: source.row, col: source.col, dir: DOWN });
+
+  let head = 0;
+  while (head < queue.length) {
+    const state = queue[head++];
+    const { nexts } = transitions(
+      grid,
+      rows,
+      cols,
+      state.row,
+      state.col,
+      state.dir,
+    );
+    for (const next of nexts) {
+      enqueue(next);
+    }
+  }
+
+  return visitedCells.size;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths.
+ *
+ * A path ends when a beam moves beyond any grid edge. Each split at '^'
+ * branches into two independent paths. Because every step strictly increases
+ * the row, the state graph is a DAG with no cycles, so the count is computed
+ * via memoized dynamic programming over (row, col, dir) states rather than by
+ * enumerating individual paths.
+ *
+ *   paths(row, col, dir) = sum over each successor:
+ *        1                          if the successor leaves the grid
+ *        paths(successor)           otherwise
+ *
+ * The result can be very large, so it is returned as a bigint. The number of
+ * distinct subproblems is bounded by rows * cols * 3, so this stays fast even
+ * when the path count is astronomically large.
+ */
+export function countBeamPaths(grid: Grid): bigint {
+  const source = locateSource(grid);
+  if (source === null) return 0n;
+
+  const rows = grid.length;
+  const cols = grid[0].length;
+
+  const memo = new Map<number, bigint>();
+  const keyOf = (r: number, c: number, d: number): number =>
+    (r * cols + c) * 3 + d;
+
+  const dp = (row: number, col: number, dir: number): bigint => {
+    const key = keyOf(row, col, dir);
+    const cached = memo.get(key);
+    if (cached !== undefined) return cached;
+
+    const { nexts, exits } = transitions(grid, rows, cols, row, col, dir);
+    let sum = BigInt(exits);
+    for (const next of nexts) {
+      sum += dp(next.row, next.col, next.dir);
+    }
+
+    memo.set(key, sum);
+    return sum;
+  };
+
+  return dp(source.row, source.col, DOWN);
+}
