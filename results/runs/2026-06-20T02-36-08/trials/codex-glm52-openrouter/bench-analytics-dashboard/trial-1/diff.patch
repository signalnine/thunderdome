es.body) {\\n      expect(event.tenant_id).toBe('tenant1');\\n    }\\n  });\\n\\n  it('should export dashboard data', async () => {\\n    const app = createTestApp('user1', 'tenant1');\\n    // Create a dashboard\\n    const dashId = uuidv4();\\n    db.prepare(\\n      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'\\n    ).run(dashId, 'tenant1', 'Test Dash', 'user1', JSON.stringify({ theme: 'light' }));\\n\\n    // Add a widget\\n    db.prepare(\\n      'INSERT INTO widgets (id, dashboard_id, type, config) VALUES (?, ?, ?, ?)'\\n    ).run(uuidv4(), dashId, 'counter', JSON.stringify({ event_name: 'page_view' }));\\n\\n    const res = await request(app).get(`/export/dashboard/${dashId}`);\\n\\n    expect(res.status).toBe(200);\\n    expect(res.body.dashboard.name).toBe('Test Dash');\\n    expect(res.body.widgets).toHaveLength(1);\\n  });\\n\\n  it('should return 404 for non-existent dashboard export', async () => {\\n    const app = createTestApp('user1', 'tenant1');\\n    const res = await request(app).get('/export/dashboard/nonexistent');\\n\\n    expect(res.status).toBe(404);\\n  });\\n\\n  it('should reject invalid format', async () => {\\n    const app = createTestApp('user1', 'tenant1');\\n    const res = await request(app).get('/export/events?format=xml');\\n\\n    expect(res.status).toBe(400);\\n  });\\n});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n","exit_code":0,"status":"completed"}}
