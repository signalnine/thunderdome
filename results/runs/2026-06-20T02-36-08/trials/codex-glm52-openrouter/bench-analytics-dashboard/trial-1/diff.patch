+import { Router, Request, Response, NextFunction } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+import { authMiddleware } from '../auth';
+import { EventRow } from '../types';
+
+const router = Router();
+
+function parseEvent(row: EventRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: JSON.parse(row.properties),
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+interface IngestBody {
+  name?: string;
+  properties?: Record<string, unknown>;
+  timestamp?: string;
+  user_id?: string;
+  session_id?: string;
+}
+
+function insertEvent(tenantId: string, userId: string | undefined, body: IngestBody): EventRow {
+  const id = uuidv4();
+  const properties = JSON.stringify(body.properties ?? {});
+  const timestamp = body.timestamp ?? new Date().toISOString();
+  const db = getDb();
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  ).run(id, tenantId, body.name!, properties, timestamp, body.user_id ?? userId ?? null, body.session_id ?? null);
+  return db.prepare('SELECT * FROM events WHERE id = ?').get(id) as EventRow;
+}
+
+router.post('/', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { name } = req.body as IngestBody;
+    if (!name) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'name is required');
+    }
+    const row = insertEvent(req.user!.tenantId, req.user!.id, req.body);
+    res.status(201).json(parseEvent(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/batch', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { events } = req.body as { events?: IngestBody[] };
+    if (!events || !Array.isArray(events) || events.length === 0) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'events must be a non-empty array');
+    }
+
+    for (const ev of events) {
+      if (!ev.name) {
+        throw new ApiError(400, 'VALIDATION_ERROR', 'each event must have a name');
+      }
+    }
+
+    const inserted: EventRow[] = [];
+    const db = getDb();
+    const txn = db.transaction(() => {
+      for (const ev of events) {
+        inserted.push(insertEvent(req.user!.tenantId, req.user!.id, ev));
+      }
+    });
+    txn();
+
+    res.status(201).json({ inserted: inserted.length, events: inserted.map(parseEvent) });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
