+import { Router, Request, Response, NextFunction } from 'express';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+import { authMiddleware } from '../auth';
+import { EventRow, DashboardRow, WidgetRow } from '../types';
+
+const router = Router();
+
+function parseEvent(row: EventRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: JSON.parse(row.properties),
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+function escapeCsv(value: string): string {
+  if (/[",\n]/.test(value)) {
+    return `"${value.replace(/"/g, '""')}"`;
+  }
+  return value;
+}
+
+router.get('/events', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const format = (req.query.format as string) || 'json';
+    if (format !== 'csv' && format !== 'json') {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'format must be csv or json');
+    }
+
+    const rows = getDb()
+      .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp')
+      .all(req.user!.tenantId) as EventRow[];
+
+    if (format === 'json') {
+      res.json(rows.map(parseEvent));
+    } else {
+      const headers = ['id', 'tenant_id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'];
+      const lines = [headers.join(',')];
+      for (const row of rows) {
+        lines.push(
+          [
+            escapeCsv(row.id),
+            escapeCsv(row.tenant_id),
+            escapeCsv(row.name),
+            escapeCsv(row.properties),
+            escapeCsv(row.timestamp),
+            escapeCsv(row.user_id ?? ''),
+            escapeCsv(row.session_id ?? ''),
+          ].join(',')
+        );
+      }
+      res.setHeader('Content-Type', 'text/csv');
+      res.send(lines.join('\n'));
+    }
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/dashboard/:id', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const db = getDb();
+    const dash = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.user!.tenantId) as DashboardRow | undefined;
+
+    if (!dash) {
+      throw new ApiError(404, 'DASHBOARD_NOT_FOUND', 'Dashboard not found');
+    }
+
+    const widgets = db
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+      .all(req.params.id) as WidgetRow[];
+
+    res.json({
+      dashboard: {
+        id: dash.id,
+        tenant_id: dash.tenant_id,
+        name: dash.name,
+        owner_id: dash.owner_id,
+        config: JSON.parse(dash.config),
+        created_at: dash.created_at,
+        updated_at: dash.updated_at,
+      },
+      widgets: widgets.map((w) => ({
+        id: w.id,
+        dashboard_id: w.dashboard_id,
+        type: w.type,
+        config: JSON.parse(w.config),
+        position_x: w.position_x,
+        position_y: w.position_y,
+        width: w.width,
+        height: w.height,
+      })),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
