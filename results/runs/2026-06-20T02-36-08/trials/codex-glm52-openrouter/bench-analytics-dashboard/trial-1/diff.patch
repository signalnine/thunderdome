@@ -0,0 +1,108 @@
+import { Router, Request, Response, NextFunction } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+import { hashPassword, verifyPassword, signToken, authMiddleware } from '../auth';
+import { UserRow } from '../types';
+
+const router = Router();
+
+function parseUser(row: UserRow) {
+  return {
+    id: row.id,
+    email: row.email,
+    tenant_id: row.tenant_id,
+    role: row.role,
+    created_at: row.created_at,
+  };
+}
+
+router.post('/', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { email, password, tenant_id } = req.body;
+
+    if (!email || !password || !tenant_id) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'email, password, and tenant_id are required');
+    }
+
+    const db = getDb();
+    const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(email);
+    if (existing) {
+      throw new ApiError(409, 'DUPLICATE_EMAIL', 'A user with this email already exists');
+    }
+
+    const id = uuidv4();
+    const passwordHash = hashPassword(password);
+    db.prepare(
+      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, email, passwordHash, tenant_id, 'viewer');
+
+    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow;
+    res.status(201).json(parseUser(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/login', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { email, password } = req.body;
+
+    if (!email || !password) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'email and password are required');
+    }
+
+    const db = getDb();
+    const row = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as UserRow | undefined;
+    if (!row || !verifyPassword(password, row.password_hash)) {
+      throw new ApiError(401, 'INVALID_CREDENTIALS', 'Invalid email or password');
+    }
+
+    const token = signToken({ sub: row.id, tid: row.tenant_id, role: row.role });
+    res.json({ token, user: parseUser(row) });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/me', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const db = getDb();
+    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as UserRow | undefined;
+    if (!row) {
+      throw new ApiError(404, 'USER_NOT_FOUND', 'User not found');
+    }
+    res.json(parseUser(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.patch('/:id/role', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { role } = req.body;
+    const validRoles = ['admin', 'viewer', 'editor'];
+    if (!role || !validRoles.includes(role)) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'role must be one of: admin, viewer, editor');
+    }
+
+    const db = getDb();
+    const requester = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as UserRow | undefined;
+    if (!requester || requester.role !== 'admin') {
+      throw new ApiError(403, 'FORBIDDEN', 'Admin access required');
+    }
+
+    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(req.params.id) as UserRow | undefined;
+    if (!row) {
+      throw new ApiError(404, 'USER_NOT_FOUND', 'User not found');
+    }
+
+    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, req.params.id);
+    const updated = db.prepare('SELECT * FROM users WHERE id = ?').get(req.params.id) as UserRow;
+    res.json(parseUser(updated));
+  } catch (err) {
+    next(err);
+  }
+});
