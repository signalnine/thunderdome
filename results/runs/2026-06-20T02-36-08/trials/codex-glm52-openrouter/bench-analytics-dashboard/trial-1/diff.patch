+import { Router, Request, Response, NextFunction } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+import { authMiddleware } from '../auth';
+import { DashboardRow, WidgetRow } from '../types';
+
+const router = Router();
+
+const WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];
+
+function parseDashboard(row: DashboardRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    owner_id: row.owner_id,
+    config: JSON.parse(row.config),
+    created_at: row.created_at,
+    updated_at: row.updated_at,
+  };
+}
+
+function parseWidget(row: WidgetRow) {
+  return {
+    id: row.id,
+    dashboard_id: row.dashboard_id,
+    type: row.type,
+    config: JSON.parse(row.config),
+    position_x: row.position_x,
+    position_y: row.position_y,
+    width: row.width,
+    height: row.height,
+  };
+}
+
+function getDashboardForTenant(dashboardId: string, tenantId: string): DashboardRow {
+  const row = getDb()
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(dashboardId, tenantId) as DashboardRow | undefined;
+  if (!row) {
+    throw new ApiError(404, 'DASHBOARD_NOT_FOUND', 'Dashboard not found');
+  }
+  return row;
+}
+
+router.post('/', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { name, config } = req.body;
+    if (!name) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'name is required');
+    }
+
+    const id = uuidv4();
+    const db = getDb();
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, req.user!.tenantId, name, req.user!.id, JSON.stringify(config ?? {}));
+
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+    res.status(201).json(parseDashboard(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const rows = getDb()
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at')
+      .all(req.user!.tenantId) as DashboardRow[];
+    res.json(rows.map(parseDashboard));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/:id', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const dash = getDashboardForTenant(req.params.id, req.user!.tenantId);
+    const widgets = getDb()
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+      .all(req.params.id) as WidgetRow[];
+    res.json({ ...parseDashboard(dash), widgets: widgets.map(parseWidget) });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.patch('/:id', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    getDashboardForTenant(req.params.id, req.user!.tenantId);
+    const { name, config } = req.body;
+    const db = getDb();
+
+    if (name !== undefined) {
+      db.prepare('UPDATE dashboards SET name = ?, updated_at = datetime(\'now\') WHERE id = ?').run(name, req.params.id);
+    }
+    if (config !== undefined) {
+      db.prepare('UPDATE dashboards SET config = ?, updated_at = datetime(\'now\') WHERE id = ?').run(JSON.stringify(config), req.params.id);
+    }
+
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(req.params.id) as DashboardRow;
+    res.json(parseDashboard(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.delete('/:id', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    getDashboardForTenant(req.params.id, req.user!.tenantId);
+    getDb().prepare('DELETE FROM dashboards WHERE id = ?').run(req.params.id);
+    res.status(204).send();
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/:id/widgets', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    getDashboardForTenant(req.params.id, req.user!.tenantId);
+    const { type, config, position_x, position_y, width, height } = req.body;
+
+    if (!type || !WIDGET_TYPES.includes(type)) {
+      throw new ApiError(400, 'VALIDATION_ERROR', `type must be one of: ${WIDGET_TYPES.join(', ')}`);
+    }
+
+    const id = uuidv4();
+    const db = getDb();
+    db.prepare(
+      'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+    ).run(
+      id,
+      req.params.id,
+      type,
+      JSON.stringify(config ?? {}),
+      position_x ?? 0,
+      position_y ?? 0,
+      width ?? 1,
+      height ?? 1
+    );
+
+    const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as WidgetRow;
+    res.status(201).json(parseWidget(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/:id/widgets', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    getDashboardForTenant(req.params.id, req.user!.tenantId);
+    const rows = getDb()
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+      .all(req.params.id) as WidgetRow[];
+    res.json(rows.map(parseWidget));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.patch('/:id/widgets/:widgetId', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    getDashboardForTenant(req.params.id, req.user!.tenantId);
+    const { type, config, position_x, position_y, width, height } = req.body;
+    const db = getDb();
+
+    if (type !== undefined && !WIDGET_TYPES.includes(type)) {
+      throw new ApiError(400, 'VALIDATION_ERROR', `type must be one of: ${WIDGET_TYPES.join(', ')}`);
+    }
+
+    const row = db.prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?').get(req.params.widgetId, req.params.id) as WidgetRow | undefined;
+    if (!row) {
+      throw new ApiError(404, 'WIDGET_NOT_FOUND', 'Widget not found');
+    }
+
+    db.prepare('UPDATE widgets SET type = COALESCE(?, type), config = COALESCE(?, config), position_x = COALESCE(?, position_x), position_y = COALESCE(?, position_y), width = COALESCE(?, width), height = COALESCE(?, height) WHERE id = ?')
+      .run(type ?? null, config !== undefined ? JSON.stringify(config) : null, position_x ?? null, position_y ?? null, width ?? null, height ?? null, req.params.widgetId);
+
+    const updated = db.prepare('SELECT * FROM widgets WHERE id = ?').get(req.params.widgetId) as WidgetRow;
+    res.json(parseWidget(updated));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.delete('/:id/widgets/:widgetId', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    getDashboardForTenant(req.params.id, req.user!.tenantId);
+    const result = getDb().prepare('DELETE FROM widgets WHERE id = ? AND dashboard_id = ?').run(req.params.widgetId, req.params.id);
+    if (result.changes === 0) {
+      throw new ApiError(404, 'WIDGET_NOT_FOUND', 'Widget not found');
+    }
+    res.status(204).send();
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
