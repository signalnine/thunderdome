@@ -0,0 +1,154 @@
+import { Router, Request, Response, NextFunction } from 'express';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+import { authMiddleware } from '../auth';
+import { EventRow } from '../types';
+
+const router = Router();
+
+interface FilterBody {
+  event_name?: string;
+  start?: string;
+  end?: string;
+}
+
+function buildWhere(tenantId: string, body: FilterBody): { clause: string; params: unknown[] } {
+  const params: unknown[] = [tenantId];
+  let clause = 'tenant_id = ?';
+
+  if (body.event_name) {
+    clause += ' AND name = ?';
+    params.push(body.event_name);
+  }
+  if (body.start) {
+    clause += ' AND datetime(timestamp) >= datetime(?)';
+    params.push(body.start);
+  }
+  if (body.end) {
+    clause += ' AND datetime(timestamp) <= datetime(?)';
+    params.push(body.end);
+  }
+  return { clause, params };
+}
+
+router.post('/count', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { event_name } = req.body as FilterBody;
+    if (!event_name) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'event_name is required');
+    }
+    const { clause, params } = buildWhere(req.user!.tenantId, req.body);
+    const row = getDb().prepare(`SELECT COUNT(*) as count FROM events WHERE ${clause}`).get(...params) as { count: number };
+    res.json({ count: row.count });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/timeseries', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { event_name } = req.body as FilterBody & { bucket?: string };
+    if (!event_name) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'event_name is required');
+    }
+
+    const bucket = req.body.bucket || 'day';
+    const fmt: Record<string, string> = {
+      minute: '%Y-%m-%dT%H:%M:00',
+      hour: '%Y-%m-%dT%H:00:00',
+      day: '%Y-%m-%d',
+      week: '%Y-W%W',
+      month: '%Y-%m',
+    };
+    const fmtStr = fmt[bucket] ?? fmt.day;
+
+    const { clause, params } = buildWhere(req.user!.tenantId, req.body);
+    const rows = getDb()
+      .prepare(`SELECT strftime('${fmtStr}', timestamp) as bucket, COUNT(*) as count FROM events WHERE ${clause} GROUP BY bucket ORDER BY bucket`)
+      .all(...params) as { bucket: string; count: number }[];
+
+    res.json({ data: rows });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/breakdown', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { event_name, property_key } = req.body as FilterBody & { property_key?: string };
+    if (!event_name) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'event_name is required');
+    }
+    if (!property_key) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'property_key is required');
+    }
+
+    const { clause, params } = buildWhere(req.user!.tenantId, req.body);
+    const escaped = property_key.replace(/'/g, "''");
+    const rows = getDb()
+      .prepare(`SELECT json_extract(properties, '$.${escaped}') as property_value, COUNT(*) as count FROM events WHERE ${clause} GROUP BY property_value ORDER BY count DESC`)
+      .all(...params) as { property_value: string | null; count: number }[];
+
+    res.json({
+      data: rows.map((r) => ({
+        property_value: r.property_value === null ? '(none)' : r.property_value,
+        count: r.count,
+      })),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/funnel', authMiddleware, (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { steps } = req.body as { steps?: string[] };
+    if (!steps || !Array.isArray(steps) || steps.length === 0) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'steps must be a non-empty array');
+    }
+
+    const tenantId = req.user!.tenantId;
+    const placeholders = steps.map(() => '?').join(',');
+    const events = getDb()
+      .prepare(
+        `SELECT * FROM events WHERE tenant_id = ? AND name IN (${placeholders}) ORDER BY session_id, timestamp`
+      )
+      .all(tenantId, ...steps) as EventRow[];
+
+    const sessionKey = (e: EventRow): string => e.session_id ?? e.user_id ?? `row:${e.id}`;
+
+    const sessions = new Map<string, EventRow[]>();
+    for (const ev of events) {
+      const key = sessionKey(ev);
+      if (!sessions.has(key)) sessions.set(key, []);
+      sessions.get(key)!.push(ev);
+    }
+
+    const stepCounts = steps.map(() => 0);
+
+    for (const evs of sessions.values()) {
+      let prevTime = '';
+      let reached = 0;
+      for (let i = 0; i < steps.length; i++) {
+        const next = evs.find((e) => e.name === steps[i] && e.timestamp >= prevTime);
+        if (next) {
+          reached = i + 1;
+          prevTime = next.timestamp;
+        } else {
+          break;
+        }
+      }
+      for (let i = 0; i < reached; i++) {
+        stepCounts[i]++;
+      }
+    }
+
+    res.json({
+      steps: steps.map((name, i) => ({ step: name, count: stepCounts[i] })),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
