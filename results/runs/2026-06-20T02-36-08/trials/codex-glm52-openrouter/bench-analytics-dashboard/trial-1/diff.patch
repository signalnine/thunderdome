UserRow | undefined;\n    if (\"'!row || !verifyPassword(password, row.password_hash)) {\n      throw new ApiError(401, '\"'INVALID_CREDENTIALS', 'Invalid email or password');\n    }\n\n    const token = signToken({ sub: row.id, tid: row.tenant_id, role: row.role });\n    res.json({ token, user: parseUser(row) });\n  } catch (err) {\n    next(err);\n  }\n});\n\nrouter.get('/me', authMiddleware, (req: Request, res: Response, next: NextFunction) => {\n  try {\n    const db = getDb();\n    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user\"'!.id) as UserRow | undefined;\n    if (!row) {\n      throw new ApiError(404, '\"'USER_NOT_FOUND', 'User not found');\n    }\n    res.json(parseUser(row));\n  } catch (err) {\n    next(err);\n  }\n});\n\nrouter.patch('/:id/role', authMiddleware, requireRole('admin'), (req: Request, res: Response, next: NextFunction) => {\n  try {\n    const { role } = req.body;\n    const validRoles = ['admin', 'viewer', 'editor'];\n    if (\"'!role || !validRoles.includes(role)) {\n      throw new ApiError(400, '\"'VALIDATION_ERROR', 'role must be one of: admin, viewer, editor');\n    }\n\n    const db = getDb();\n    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(req.params.id) as UserRow | undefined;\n    if (\"'!row) {\n      throw new ApiError(404, '\"'USER_NOT_FOUND', 'User not found');\n    }\n\n    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, req.params.id);\n    const updated = db.prepare('SELECT * FROM users WHERE id = ?').get(req.params.id) as UserRow;\n    res.json(parseUser(updated));\n  } catch (err) {\n    next(err);\n  }\n});\n\nexport default router;\nEOF\necho done\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
