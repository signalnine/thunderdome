+import type { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+import type { CartService } from '../types.js';
+import { randomUUID } from 'crypto';
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, { id: string; userId: string; items: Map<string, number> }>();
+
+  function emit(cartId: string) {
+    const c = carts.get(cartId);
+    if (!c) return;
+    const items = [...c.items.entries()].map(([productId, quantity]) => ({ productId, quantity }));
+    void bus.emit(Events.CART_UPDATED, { cartId: c.id, userId: c.userId, items });
+  }
+
+  return {
+    createCart(userId) {
+      const id = randomUUID();
+      carts.set(id, { id, userId, items: new Map() });
+      return id;
+    },
+    addItem(cartId, productId, quantity) {
+      const c = carts.get(cartId);
+      if (!c) return;
+      const prev = c.items.get(productId) ?? 0;
+      c.items.set(productId, prev + quantity);
+      emit(cartId);
+    },
+    removeItem(cartId, productId) {
+      const c = carts.get(cartId);
+      if (!c) return;
+      c.items.delete(productId);
+      emit(cartId);
+    },
+    getCart(cartId) {
+      const c = carts.get(cartId);
+      if (!c) return null;
+      const items = [...c.items.entries()].map(([productId, quantity]) => ({ productId, quantity }));
+      return { id: c.id, userId: c.userId, items };
+    },
+    clearCart(cartId) {
+      const c = carts.get(cartId);
+      if (!c) return;
+      c.items.clear();
+      emit(cartId);
+    },
+    updateQuantity(cartId, productId, quantity) {
+      const c = carts.get(cartId);
+      if (!c) return;
+      if (quantity <= 0) c.items.delete(productId);
+      else c.items.set(productId, quantity);
+      emit(cartId);
+    },
+  };
+}
