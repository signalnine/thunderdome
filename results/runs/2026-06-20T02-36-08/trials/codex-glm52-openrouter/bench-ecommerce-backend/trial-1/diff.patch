+import type { EventBus } from '../bus.js';
+import { Events, PaymentStatus } from '../types.js';
+import type { AnalyticsService } from '../types.js';
+import type {
+  CartUpdatedEvent,
+  OrderCreatedEvent,
+  PaymentProcessedEvent,
+  AnalyticsEvent,
+} from '../types.js';
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const cartItems = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const uniqueCarts = new Set<string>();
+  const orderTotals = new Map<string, number>();
+  let ordersCount = 0;
+  let revenue = 0;
+  const productCounts = new Map<string, number>();
+
+  function track(event: string) {
+    eventCounts.set(event, (eventCounts.get(event) ?? 0) + 1);
+  }
+
+  function emitAnalytics(event: string, data: Record<string, unknown>) {
+    const payload: AnalyticsEvent = { event, data, timestamp: Date.now() };
+    void bus.emit(Events.ANALYTICS_EVENT, payload);
+  }
+
+  bus.on(Events.PRODUCT_CREATED, (payload) => {
+    track(Events.PRODUCT_CREATED);
+    emitAnalytics(Events.PRODUCT_CREATED, payload as Record<string, unknown>);
+  });
+  bus.on(Events.INVENTORY_UPDATED, (payload) => {
+    track(Events.INVENTORY_UPDATED);
+    emitAnalytics(Events.INVENTORY_UPDATED, payload as Record<string, unknown>);
+  });
+  bus.on(Events.LOW_STOCK_ALERT, (payload) => {
+    track(Events.LOW_STOCK_ALERT);
+    emitAnalytics(Events.LOW_STOCK_ALERT, payload as Record<string, unknown>);
+  });
+  bus.on(Events.CART_UPDATED, (payload) => {
+    const e = payload as CartUpdatedEvent;
+    track(Events.CART_UPDATED);
+    uniqueCarts.add(e.cartId);
+    cartItems.set(e.cartId, e.items.map(i => ({ productId: i.productId, quantity: i.quantity })));
+    emitAnalytics(Events.CART_UPDATED, payload as Record<string, unknown>);
+  });
+  bus.on(Events.PRICE_CALCULATED, (payload) => {
+    track(Events.PRICE_CALCULATED);
+    emitAnalytics(Events.PRICE_CALCULATED, payload as Record<string, unknown>);
+  });
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const e = payload as OrderCreatedEvent;
+    track(Events.ORDER_CREATED);
+    orderTotals.set(e.orderId, e.total);
+    ordersCount++;
+    const items = cartItems.get(e.cartId) ?? [];
+    for (const item of items) {
+      productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+    }
+    emitAnalytics(Events.ORDER_CREATED, payload as Record<string, unknown>);
+  });
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    track(Events.ORDER_STATUS_CHANGED);
+    emitAnalytics(Events.ORDER_STATUS_CHANGED, payload as Record<string, unknown>);
+  });
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const e = payload as PaymentProcessedEvent;
+    track(Events.PAYMENT_PROCESSED);
+    if (e.status === PaymentStatus.SUCCESS) {
+      revenue += orderTotals.get(e.orderId) ?? 0;
+    }
+    emitAnalytics(Events.PAYMENT_PROCESSED, payload as Record<string, unknown>);
+  });
+  bus.on(Events.NOTIFICATION_SENT, (payload) => {
+    track(Events.NOTIFICATION_SENT);
+    emitAnalytics(Events.NOTIFICATION_SENT, payload as Record<string, unknown>);
+  });
+
+  return {
+    getEventCount(eventType) {
+      return eventCounts.get(eventType) ?? 0;
+    },
+    getRevenue() {
+      return revenue;
+    },
+    getConversionRate() {
+      const carts = uniqueCarts.size;
+      if (carts === 0) return 0;
+      return ordersCount / carts;
+    },
+    getTopProducts(limit) {
+      return [...productCounts.entries()]
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count)
+        .slice(0, limit);
+    },
+  };
+}
