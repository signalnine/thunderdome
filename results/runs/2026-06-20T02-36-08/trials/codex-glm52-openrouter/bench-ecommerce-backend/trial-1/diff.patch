+import type { EventBus } from '../bus.js';
+import { Events, OrderStatus } from '../types.js';
+import type { OrderService } from '../types.js';
+import { randomUUID } from 'crypto';
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, { id: string; userId: string; cartId: string; status: OrderStatus; total: number }>();
+
+  return {
+    createOrder(userId, cartId, total) {
+      const id = randomUUID();
+      const order = { id, userId, cartId, status: OrderStatus.PENDING, total };
+      orders.set(id, order);
+      void bus.emit(Events.ORDER_CREATED, { orderId: id, userId, cartId, total });
+      return id;
+    },
+    getOrder(orderId) {
+      const o = orders.get(orderId);
+      return o ? { id: o.id, userId: o.userId, status: o.status, total: o.total } : null;
+    },
+    updateStatus(orderId, status) {
+      const o = orders.get(orderId);
+      if (!o) return;
+      const previousStatus = o.status;
+      o.status = status;
+      void bus.emit(Events.ORDER_STATUS_CHANGED, { orderId, status, previousStatus });
+    },
+    listOrders(userId) {
+      return [...orders.values()]
+        .filter(o => o.userId === userId)
+        .map(o => ({ id: o.id, status: o.status, total: o.total }));
+    },
+  };
+}
