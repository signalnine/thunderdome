+import type { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+import type { CatalogService } from '../types.js';
+import { randomUUID } from 'crypto';
+
+export function createCatalogService(bus: EventBus): CatalogService {
+  const products = new Map<string, { id: string; name: string; price: number; category: string }>();
+
+  return {
+    createProduct(name, price, category) {
+      const id = randomUUID();
+      const product = { id, name, price, category };
+      products.set(id, product);
+      void bus.emit(Events.PRODUCT_CREATED, { productId: id, name, price, category });
+      return id;
+    },
+    getProduct(productId) {
+      const p = products.get(productId);
+      return p ? { ...p } : null;
+    },
+    listProducts(category) {
+      const all = [...products.values()].map(p => ({ ...p }));
+      return category ? all.filter(p => p.category === category) : all;
+    },
+    searchProducts(query) {
+      const q = query.toLowerCase();
+      return [...products.values()]
+        .map(p => ({ ...p }))
+        .filter(p => p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q));
+    },
+    updateProduct(productId, updates) {
+      const p = products.get(productId);
+      if (!p) return;
+      if (updates.name !== undefined) p.name = updates.name;
+      if (updates.price !== undefined) p.price = updates.price;
+      if (updates.category !== undefined) p.category = updates.category;
+    },
+    removeProduct(productId) {
+      return products.delete(productId);
+    },
+  };
+}
