+import type { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+import type { PricingService } from '../types.js';
+
+const TAX_RATE = 0.1;
+
+export function createPricingService(bus: EventBus): PricingService {
+  const prices = new Map<string, number>();
+  const discounts = new Map<string, number>();
+
+  bus.on(Events.PRODUCT_CREATED, (payload) => {
+    const p = payload as { productId: string; price: number };
+    prices.set(p.productId, p.price);
+  });
+
+  return {
+    calculateTotal(items, discountCode) {
+      const subtotal = items.reduce((sum, i) => sum + i.price * i.quantity, 0);
+      const percentage = discountCode ? discounts.get(discountCode) ?? 0 : 0;
+      const discount = subtotal * (percentage / 100);
+      const afterDiscount = subtotal - discount;
+      const tax = afterDiscount * TAX_RATE;
+      const total = afterDiscount + tax;
+      return { subtotal, discount, tax, total };
+    },
+    addDiscountCode(code, percentage) {
+      discounts.set(code, percentage);
+    },
+    getPrice(productId) {
+      return prices.get(productId) ?? 0;
+    },
+  };
+}
