@@ -0,0 +1,48 @@
+import type { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+import type { NotificationService } from '../types.js';
+import type { OrderCreatedEvent, OrderStatusChangedEvent, PaymentProcessedEvent } from '../types.js';
+
+type Notification = { type: string; message: string; timestamp: number };
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscriptions = new Set<string>();
+  const userNotifications = new Map<string, Notification[]>();
+  const orderUserMap = new Map<string, string>();
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const e = payload as OrderCreatedEvent;
+    orderUserMap.set(e.orderId, e.userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    const e = payload as OrderStatusChangedEvent;
+    const userId = orderUserMap.get(e.orderId);
+    if (!userId || !subscriptions.has(userId)) return;
+    const list = userNotifications.get(userId) ?? [];
+    const message = `Order ${e.orderId} status changed to ${e.status}`;
+    list.push({ type: 'order_status', message, timestamp: Date.now() });
+    userNotifications.set(userId, list);
+    void bus.emit(Events.NOTIFICATION_SENT, { userId, type: 'order_status', message });
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const e = payload as PaymentProcessedEvent;
+    const userId = orderUserMap.get(e.orderId);
+    if (!userId || !subscriptions.has(userId)) return;
+    const list = userNotifications.get(userId) ?? [];
+    const message = `Payment for order ${e.orderId} ${e.status}`;
+    list.push({ type: 'payment', message, timestamp: Date.now() });
+    userNotifications.set(userId, list);
+    void bus.emit(Events.NOTIFICATION_SENT, { userId, type: 'payment', message });
+  });
+
+  return {
+    subscribe(userId) {
+      subscriptions.add(userId);
+    },
+    getNotifications(userId) {
+      return [...(userNotifications.get(userId) ?? [])];
+    },
+  };
+}
