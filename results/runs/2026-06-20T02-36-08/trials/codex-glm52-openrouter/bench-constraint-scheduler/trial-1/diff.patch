+  let best: Best = { score: 0, count: 0, assignments: [] };
+
+  const SCORE_WEIGHT = 100000;
+
+  const dfs = (idx: number): void => {
+    const remaining = n - idx;
+    // Branch and bound pruning.
+    const placedCount = placed.size;
+    if (placedCount + remaining < best.count) {
+      return;
+    }
+    if (
+      placedCount + remaining === best.count &&
+      placedCount * SCORE_WEIGHT + remaining <= best.score &&
+      best.count > 0
