@@ -0,0 +1,346 @@
+export interface Event {
+  id: string;
+  name: string;
+  duration: number;
+  attendees?: number;
+  prerequisites?: string[];
+  preferredRoom?: string;
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number;
+}
+
+export interface ScheduleOptions {
+  startTime: number;
+  endTime: number;
+  gap?: number;
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[];
+}
+
+interface Interval {
+  start: number;
+  end: number;
+}
+
+class CycleError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'CycleError';
+  }
+}
+
+const DEFAULT_GAP = 15;
+const DEFAULT_ATTENDEES = 1;
+
+/**
+ * Detect cycles in the prerequisite graph (including self-references).
+ * Throws CycleError if a cycle is found.
+ */
+function detectCycle(events: Map<string, Event>): void {
+  const WHITE = 0;
+  const GRAY = 1;
+  const BLACK = 2;
+  const color = new Map<string, number>();
+
+  for (const id of events.keys()) {
+    color.set(id, WHITE);
+  }
+
+  const visit = (id: string, path: string[]): void => {
+    const c = color.get(id);
+    if (c === GRAY) {
+      throw new CycleError(
+        `Prerequisite cycle detected: ${[...path, id].join(' -> ')}`,
+      );
+    }
+    if (c === BLACK) return;
+    color.set(id, GRAY);
+    const ev = events.get(id);
+    if (ev && ev.prerequisites) {
+      for (const pre of ev.prerequisites) {
+        if (pre === id) {
+          throw new CycleError(`Prerequisite cycle detected: ${id} -> ${id}`);
+        }
+        if (events.has(pre)) {
+          visit(pre, [...path, id]);
+        }
+      }
+    }
+    color.set(id, BLACK);
+  };
+
+  for (const id of events.keys()) {
+    if (color.get(id) === WHITE) {
+      visit(id, []);
+    }
+  }
+}
+
+/**
+ * Topologically sort events so that prerequisites come before dependents.
+ * Events are tie-broken by constraint tightness to improve search pruning.
+ */
+function topoSort(events: Map<string, Event>): string[] {
+  const inDegree = new Map<string, number>();
+  const dependents = new Map<string, string[]>();
+  for (const id of events.keys()) {
+    inDegree.set(id, 0);
+    dependents.set(id, []);
+  }
+  for (const [id, ev] of events) {
+    if (ev.prerequisites) {
+      for (const pre of ev.prerequisites) {
+        if (events.has(pre)) {
+          inDegree.set(id, (inDegree.get(id) ?? 0) + 1);
+          dependents.get(pre)!.push(id);
+        }
+      }
+    }
+  }
+
+  // Priority: events with fewer feasible options first (heuristic).
+  const ready: string[] = [];
+  for (const [id, deg] of inDegree) {
+    if (deg === 0) ready.push(id);
+  }
+
+  const result: string[] = [];
+  while (ready.length > 0) {
+    // Pick the most constrained: more prerequisites already resolved is
+    // irrelevant here; use shorter duration first as a simple heuristic to
+    // pack tightly and prune faster.
+    ready.sort((a, b) => {
+      const ea = events.get(a)!;
+      const eb = events.get(b)!;
+      return ea.duration - eb.duration;
+    });
+    const id = ready.shift()!;
+    result.push(id);
+    for (const dep of dependents.get(id) ?? []) {
+      inDegree.set(dep, (inDegree.get(dep) ?? 0) - 1);
+      if (inDegree.get(dep) === 0) ready.push(dep);
+    }
+  }
+  return result;
+}
+
+/**
+ * Find the earliest feasible start time for an event of `dur` minutes in a
+ * room whose busy intervals are `busy`, given a lower bound `L` and the
+ * scheduling window/gap. Returns null if no feasible slot exists.
+ */
+function earliestFit(
+  busy: Interval[],
+  L: number,
+  dur: number,
+  windowStart: number,
+  windowEnd: number,
+  gap: number,
+): number | null {
+  const ivs = busy.slice().sort((a, b) => a.start - b.start);
+  let s = Math.max(L, windowStart);
+  let idx = 0;
+  for (;;) {
+    if (s + dur > windowEnd) return null;
+    // Advance past intervals that end before s (with gap).
+    while (idx < ivs.length && ivs[idx].end + gap <= s) {
+      idx++;
+    }
+    if (idx >= ivs.length) {
+      return s;
+    }
+    const iv = ivs[idx];
+    // Conflict if [s, s+dur] overlaps iv considering gap on both sides.
+    if (s + dur + gap > iv.start && s < iv.end + gap) {
+      s = iv.end + gap;
+      continue;
+    }
+    return s;
+  }
+}
+
+interface Best {
+  score: number;
+  count: number;
+  assignments: Assignment[];
+}
+
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const gap = options.gap ?? DEFAULT_GAP;
