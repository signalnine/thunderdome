+{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc 'cat /workspace/src/core/types.ts /workspace/src/core/index.ts'","aggregated_output":"export interface SiteConfig {\n  title: string;\n  baseUrl: string;\n  outputDir: string;\n  contentDir: string;\n  templateDir: string;\n}\n\nexport interface ContentFile {\n  slug: string;\n  title: string;\n  content: string;        // raw content (markdown or html)\n  metadata: Record<string, unknown>;\n  date?: string;\n  tags?: string[];\n  template?: string;\n}\n\nexport interface BuildContext {\n  config: SiteConfig;\n  files: ContentFile[];\n  output: Map<string, string>;  // output path -> rendered content\n  assets: Map<string, Buffer>;  // output path -> binary data\n  data: Map<string, unknown>;   // shared plugin data store\n}\n\nexport interface PluginHooks {\n  beforeBuild?: (ctx: BuildContext) => Promise<void> | void;\n  transformContent?: (file: ContentFile, ctx: BuildContext) => Promise<ContentFile> | ContentFile;\n  afterBuild?: (ctx: BuildContext) => Promise<void> | void;\n}\n\nexport interface Plugin {\n  name: string;\n  version: string;\n  dependencies: string[];  // names of plugins this depends on\n  hooks: PluginHooks;\n}\n\nexport interface Template {\n  name: string;\n  render: (content: string, data: Record<string, unknown>) => string;\n}\nexport { BuildEngine } from './engine.js';\nexport { createDefaultTemplate, createListTemplate } from './templates.js';\nexport type { BuildContext, ContentFile, Plugin, PluginHooks, SiteConfig, Template } from './types.js';\n","exit_code":0,"status":"completed"}}
