+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,62 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+interface Footnote {
+  id: string;
+  content: string;
+}
+
+function extractFootnotes(content: string): { body: string; notes: Footnote[] } {
+  const notes: Footnote[] = [];
+  const refPattern = /\[\^(\d+)\]:\s*(.+)$/gm;
+  let body = content.replace(refPattern, (_match, id: string, text: string) => {
+    notes.push({ id, content: text.trim() });
+    return '';
+  });
+  body = body.replace(/\n{3,}/g, '\n\n').trimEnd();
+  return { body, notes };
+}
+
+function injectFootnoteRefs(body: string, notes: Footnote[]): string {
+  if (notes.length === 0) return body;
+  let result = body.replace(/\[\^(\d+)\]/g, (_match, id: string) => {
+    return `<sup><a href="#fn-${id}">${id}</a></sup>`;
+  });
+  const list = notes
+    .map((n) => `<li id="fn-${n.id}">${n.content}</li>`)
+    .join('\n');
+  result += `\n\n<section class="footnotes">\n<ol>\n${list}\n</ol>\n</section>`;
+  return result;
+}
+
+function transformAdmonitions(content: string): string {
+  const blockPattern = /:::(\w+)\n([\s\S]*?)\n:::/g;
+  return content.replace(
+    blockPattern,
+    (_match, type: string, body: string) => {
+      const trimmed = body.trim();
+      return `<div class="admonition admonition-${type}">\n${trimmed}\n</div>`;
+    },
+  );
+}
+
+function renderMarkdown(content: string): string {
+  const { body, notes } = extractFootnotes(content);
+  const admonished = transformAdmonitions(body);
+  const html = marked.parse(admonished, { async: false }) as string;
+  return injectFootnoteRefs(html, notes);
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile) => {
+        const rendered = renderMarkdown(file.content);
+        return { ...file, content: rendered };
+      },
+    },
+  };
+}
