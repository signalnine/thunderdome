+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,38 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+function getManifest(ctx: BuildContext): AssetManifest {
+  const existing = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+  if (existing) return existing;
+  const manifest: AssetManifest = { assets: [] };
+  ctx.data.set('asset-manifest', manifest);
+  return manifest;
+}
+
+function rewriteAsset(content: string, ctx: BuildContext): string {
+  const manifest = getManifest(ctx);
+  const pattern = /(\b(?:src|href)\s*=\s*)"(\.\/([^"]+))"/g;
+  return content.replace(pattern, (_match, attr: string, _full: string, filename: string) => {
+    if (!manifest.assets.includes(filename)) {
+      manifest.assets.push(filename);
+    }
+    return `${attr}"/assets/${filename}"`;
+  });
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext) => {
+        const content = rewriteAsset(file.content, ctx);
+        return { ...file, content };
+      },
+    },
+  };
+}
diff --git a/src/plugins/dev-server.ts b/src/plugins/dev-server.ts
new file mode 100644
