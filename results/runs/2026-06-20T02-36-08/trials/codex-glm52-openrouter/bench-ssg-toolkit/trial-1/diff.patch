index 0000000..b56648a
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,78 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+function formatPubDate(dateStr: string | undefined): string | null {
+  if (!dateStr) return null;
+  const date = new Date(dateStr);
+  if (isNaN(date.getTime())) return null;
+  return date.toUTCString();
+}
+
+function fileTags(file: ContentFile, tagMap?: Map<string, ContentFile[]>): string[] {
+  if (!tagMap) return [];
+  const tags: string[] = [];
+  for (const [tag, files] of tagMap) {
+    if (files.some((f) => f.slug === file.slug)) {
+      tags.push(tag);
+    }
+  }
+  return tags;
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext) => {
+        const { config } = ctx;
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+
+        const sorted = [...ctx.files].sort((a, b) => {
+          const da = a.date ? new Date(a.date).getTime() : 0;
+          const db = b.date ? new Date(b.date).getTime() : 0;
+          return db - da;
+        });
+
+        const items = sorted
+          .map((file) => {
+            const pubDate = formatPubDate(file.date);
+            const link = `${config.baseUrl}/${file.slug}.html`;
+            const tags = fileTags(file, tagMap);
+            const categories = tags
+              .map((tag) => `      <category>${escapeXml(tag)}</category>`)
+              .join('\n');
+            const categoryBlock = categories ? `\n${categories}` : '';
+            const pubDateBlock = pubDate ? `\n      <pubDate>${pubDate}</pubDate>` : '';
+            return `    <item>
+      <title>${escapeXml(file.title)}</title>
+      <link>${link}</link>${pubDateBlock}${categoryBlock}
+      <description><![CDATA[${file.content}]]></description>
+    </item>`;
+          })
+          .join('\n');
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(config.title)}</title>
+    <link>${config.baseUrl}</link>
+    <description>${escapeXml(config.title)}</description>
+${items}
+  </channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
