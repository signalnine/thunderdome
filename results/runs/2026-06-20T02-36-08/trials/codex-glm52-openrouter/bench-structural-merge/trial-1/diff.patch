diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..493a705
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,498 @@
+import { randomUUID } from 'node:crypto';
+
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+export interface Conflict {
+  documentId: string;
+  path: string;
+  base: unknown;
+  ours: unknown;
+  theirs: unknown;
+}
+
+export interface MergeResult {
+  merged: Record<string, object>;
+  conflicts: Conflict[];
+  applied: boolean;
+}
+
+export interface DocumentStore {
+  create(id: string, content: object): void;
+  get(id: string): object;
+  update(id: string, content: object): void;
+  delete(id: string): void;
+  getHistory(id: string): Version[];
+  getVersion(id: string, versionId: string): object;
+  createBranch(name: string, fromBranch?: string): void;
+  switchBranch(name: string): void;
+  getBranch(): string;
+  listBranches(): string[];
+  merge(sourceBranch: string): MergeResult;
+}
+
+type DocMap = Map<string, object>;
+
+interface Branch {
+  name: string;
+  documents: DocMap;
+  histories: Map<string, Version[]>;
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+function deepClone<T>(value: T): T {
+  if (value === null || typeof value !== 'object') return value;
+  return JSON.parse(JSON.stringify(value)) as T;
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (a === null || b === null) return false;
+  if (typeof a !== typeof b) return false;
+  if (typeof a !== 'object') return false;
+
+  const aIsArray = Array.isArray(a);
+  const bIsArray = Array.isArray(b);
+  if (aIsArray !== bIsArray) return false;
+
+  if (aIsArray) {
+    const aa = a as unknown[];
+    const bb = b as unknown[];
+    if (aa.length !== bb.length) return false;
+    for (let i = 0; i < aa.length; i++) {
+      if (!deepEqual(aa[i], bb[i])) return false;
+    }
+    return true;
+  }
+
+  const ao = a as Record<string, unknown>;
+  const bo = b as Record<string, unknown>;
+  const aKeys = Object.keys(ao);
+  const bKeys = Object.keys(bo);
+  if (aKeys.length !== bKeys.length) return false;
+  for (const key of aKeys) {
+    if (!Object.prototype.hasOwnProperty.call(bo, key)) return false;
+    if (!deepEqual(ao[key], bo[key])) return false;
+  }
+  return true;
+}
+
+interface FieldResult {
+  value: unknown;
+  present: boolean;
+}
+
+// Three-way merge of a single field value. `present === false` means the key
+// should be removed from the containing object (i.e. the merged value is
+// `undefined` / deleted).
+function mergeField(
+  base: unknown,
+  ours: unknown,
+  theirs: unknown,
+  path: string,
+  conflicts: Conflict[],
+  documentId: string,
+): FieldResult {
+  // Both sides agree -> take it.
+  if (deepEqual(ours, theirs)) {
+    return { value: deepClone(ours), present: ours !== undefined };
+  }
+  // Ours unchanged -> take theirs.
+  if (deepEqual(base, ours)) {
+    return { value: deepClone(theirs), present: theirs !== undefined };
+  }
+  // Theirs unchanged -> take ours.
+  if (deepEqual(base, theirs)) {
+    return { value: deepClone(ours), present: ours !== undefined };
+  }
+
+  // Both sides changed, but in compatible (structural) ways -> recurse.
+  if (isPlainObject(ours) && isPlainObject(theirs)) {
+    const baseObj = isPlainObject(base) ? (base as Record<string, unknown>) : {};
+    const merged: Record<string, unknown> = {};
+    const keys = new Set<string>([
+      ...Object.keys(baseObj),
+      ...Object.keys(ours as Record<string, unknown>),
+      ...Object.keys(theirs as Record<string, unknown>),
+    ]);
+    for (const key of keys) {
+      const childPath = path ? `${path}.${key}` : key;
+      const child = mergeField(
+        baseObj[key],
+        (ours as Record<string, unknown>)[key],
+        (theirs as Record<string, unknown>)[key],
+        childPath,
+        conflicts,
+        documentId,
+      );
+      if (child.present) {
+        merged[key] = child.value;
+      }
+    }
+    return { value: merged, present: true };
+  }
+
+  // Genuine conflict at this leaf. Resolve in favour of "ours" for the
+  // preview merged result.
+  conflicts.push({
+    documentId,
+    path,
+    base: deepClone(base),
+    ours: deepClone(ours),
+    theirs: deepClone(theirs),
+  });
+  return { value: deepClone(ours), present: ours !== undefined };
+}
+
+interface DocMergeResult {
+  content?: object;
+  deleted: boolean;
+}
+
+// Three-way merge of a single document. Handles create / delete / modify at
+// the document level, delegating field-level decisions to `mergeField`.
+//
+// `undefined` for a side means "document not present on that branch". Whether
+// that counts as a deletion depends on whether the document existed in the
+// common ancestor (`base`).
+function mergeDocument(
+  documentId: string,
+  base: object | undefined,
+  ours: object | undefined,
+  theirs: object | undefined,
+  conflicts: Conflict[],
+): DocMergeResult {
+  const basePresent = base !== undefined;
+  const oursPresent = ours !== undefined;
+  const theirsPresent = theirs !== undefined;
+
+  // Absent on both sides -> nothing to merge.
+  if (!oursPresent && !theirsPresent) {
+    return { deleted: true };
+  }
+
+  // Present on both sides -> structural field merge. If the document did not
+  // exist in the base (both sides created it independently) we merge against
+  // an empty object so that matching fields are reconciled without spurious
+  // conflicts.
+  if (oursPresent && theirsPresent) {
+    const result = mergeField(
+      base as unknown,
+      ours as unknown,
+      theirs as unknown,
+      '',
+      conflicts,
+      documentId,
+    );
+    return { content: result.value as object, deleted: false };
+  }
+
+  // Present on ours, absent on theirs.
+  if (oursPresent) {
+    if (!basePresent) {
+      // Ours created it; theirs never had it -> take ours, no conflict.
+      return { content: deepClone(ours!), deleted: false };
+    }
+    // Theirs deleted a document that existed in the base.
+    if (deepEqual(base, ours)) {
+      // Ours unchanged -> delete wins cleanly.
+      return { deleted: true };
+    }
+    // modify-vs-delete conflict; ours wins the preview.
+    conflicts.push({
+      documentId,
+      path: '',
+      base: deepClone(base),
+      ours: deepClone(ours),
+      theirs: undefined,
+    });
+    return { content: deepClone(ours), deleted: false };
+  }
+
+  // Present on theirs, absent on ours.
+  if (!basePresent) {
+    // Theirs created it; ours never had it -> take theirs, no conflict.
+    return { content: deepClone(theirs!), deleted: false };
+  }
+  // Ours deleted a document that existed in the base.
+  if (deepEqual(base, theirs)) {
+    // Theirs unchanged -> delete wins cleanly.
+    return { deleted: true };
+  }
+  // delete-vs-modify conflict; ours (delete) wins the preview.
+  conflicts.push({
+    documentId,
+    path: '',
+    base: deepClone(base),
+    ours: undefined,
+    theirs: deepClone(theirs),
+  });
+  return { deleted: true };
+}
+
+// ---------------------------------------------------------------------------
+// Store
+// ---------------------------------------------------------------------------
+
+export class DocumentStoreImpl implements DocumentStore {
+  private branches = new Map<string, Branch>();
+  private current: string;
+  // Common-ancestor snapshots keyed by unordered branch-name pair.
+  private mergeBases = new Map<string, DocMap>();
+
+  constructor() {
+    const main: Branch = {
+      name: 'main',
+      documents: new Map(),
+      histories: new Map(),
+    };
+    this.branches.set('main', main);
+    this.current = 'main';
+  }
+
+  // -- Document CRUD -------------------------------------------------------
+
+  create(id: string, content: object): void {
+    const branch = this.activeBranch();
+    if (branch.documents.has(id)) {
+      throw new Error(`Document "${id}" already exists on branch "${branch.name}"`);
+    }
+    const clone = deepClone(content);
+    branch.documents.set(id, clone);
+    this.recordVersion(branch, id, clone);
+  }
+
+  get(id: string): object {
+    const branch = this.activeBranch();
+    if (!branch.documents.has(id)) {
+      throw new Error(`Document "${id}" does not exist on branch "${branch.name}"`);
+    }
+    return deepClone(branch.documents.get(id)!);
+  }
+
+  update(id: string, content: object): void {
+    const branch = this.activeBranch();
+    if (!branch.documents.has(id)) {
+      throw new Error(`Document "${id}" does not exist on branch "${branch.name}"`);
+    }
+    const clone = deepClone(content);
+    branch.documents.set(id, clone);
+    this.recordVersion(branch, id, clone);
+  }
+
+  delete(id: string): void {
+    const branch = this.activeBranch();
+    if (!branch.documents.has(id)) {
+      throw new Error(`Document "${id}" does not exist on branch "${branch.name}"`);
+    }
+    branch.documents.delete(id);
+  }
+
+  // -- Version history -----------------------------------------------------
+
+  getHistory(id: string): Version[] {
+    const branch = this.activeBranch();
+    const versions = branch.histories.get(id);
+    if (!versions || versions.length === 0) {
+      throw new Error(`No version history for document "${id}" on branch "${branch.name}"`);
+    }
+    return versions.map((v) => ({ ...v, content: deepClone(v.content) }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const branch = this.activeBranch();
+    const versions = branch.histories.get(id);
+    if (!versions) {
+      throw new Error(`No version history for document "${id}" on branch "${branch.name}"`);
+    }
+    const version = versions.find((v) => v.id === versionId);
+    if (!version) {
+      throw new Error(`Version "${versionId}" not found for document "${id}"`);
+    }
+    return deepClone(version.content);
+  }
+
+  // -- Branching -----------------------------------------------------------
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const fromName = fromBranch ?? this.current;
+    const from = this.branches.get(fromName);
+    if (!from) {
+      throw new Error(`Branch "${fromName}" does not exist`);
+    }
+
+    const branch: Branch = {
+      name,
+      documents: new Map(),
+      histories: new Map(),
+    };
+    for (const [id, content] of from.documents) {
+      branch.documents.set(id, deepClone(content));
+    }
+    for (const [id, versions] of from.histories) {
+      branch.histories.set(
+        id,
+        versions.map((v) => ({ ...v, content: deepClone(v.content) })),
+      );
+    }
+    this.branches.set(name, branch);
+
+    // The new branch diverged from `fromName` right now.
+    this.setMergeBase(name, fromName, this.snapshot(from));
+
+    // Inherit common-ancestor relationships with all other branches: since
+    // `name` is a copy of `fromName` at this instant, its relationship to any
+    // third branch is identical to `fromName`'s.
+    for (const otherName of this.branches.keys()) {
+      if (otherName === name || otherName === fromName) continue;
+      const key = this.mergeBaseKey(fromName, otherName);
+      const inherited = this.mergeBases.get(key);
+      if (inherited) {
+        const cloned = new Map<string, object>();
+        for (const [id, content] of inherited) {
+          cloned.set(id, deepClone(content));
+        }
+        this.setMergeBase(name, otherName, cloned);
+      }
+    }
+  }
+
+  switchBranch(name: string): void {
+    if (!this.branches.has(name)) {
+      throw new Error(`Branch "${name}" does not exist`);
+    }
+    this.current = name;
+  }
+
+  getBranch(): string {
+    return this.current;
+  }
+
+  listBranches(): string[] {
+    return Array.from(this.branches.keys());
+  }
+
+  // -- Merging -------------------------------------------------------------
+
+  merge(sourceBranch: string): MergeResult {
+    const targetName = this.current;
+    if (sourceBranch === targetName) {
+      return { merged: {}, conflicts: [], applied: true };
+    }
+    const source = this.branches.get(sourceBranch);
+    if (!source) {
+      throw new Error(`Branch "${sourceBranch}" does not exist`);
+    }
+    const target = this.branches.get(targetName)!;
+
+    const baseSnapshot = this.getMergeBase(targetName, sourceBranch);
+
+    const ids = new Set<string>([
+      ...baseSnapshot.keys(),
+      ...target.documents.keys(),
+      ...source.documents.keys(),
+    ]);
+
+    const conflicts: Conflict[] = [];
+    const merged: Record<string, object> = {};
+    const changes: { id: string; content?: object; deleted: boolean }[] = [];
+
+    for (const id of ids) {
+      const base = baseSnapshot.get(id);
+      const ours = target.documents.get(id);
+      const theirs = source.documents.get(id);
+
+      const result = mergeDocument(id, base, ours, theirs, conflicts);
+
+      if (result.deleted) {
+        if (ours !== undefined) {
+          changes.push({ id, deleted: true });
+        }
+        continue;
+      }
+
+      const content = result.content!;
+      if (ours === undefined || !deepEqual(ours, content)) {
+        changes.push({ id, content, deleted: false });
+      }
+      merged[id] = content;
+    }
+
+    const applied = conflicts.length === 0;
+    if (applied) {
+      for (const change of changes) {
+        if (change.deleted) {
+          target.documents.delete(change.id);
+        } else {
+          target.documents.set(change.id, deepClone(change.content!));
+        }
+      }
+      // After a successful merge, the common ancestor between the two branches
+      // advances to the source branch's current state.
+      this.setMergeBase(targetName, sourceBranch, this.snapshot(source));
+    }
+
+    return { merged, conflicts, applied };
+  }
+
+  // -- Internals -----------------------------------------------------------
+
+  private activeBranch(): Branch {
+    const branch = this.branches.get(this.current);
+    if (!branch) {
+      throw new Error(`Active branch "${this.current}" does not exist`);
+    }
+    return branch;
+  }
+
+  private recordVersion(branch: Branch, id: string, content: object): void {
+    let versions = branch.histories.get(id);
+    if (!versions) {
+      versions = [];
+      branch.histories.set(id, versions);
+    }
+    versions.push({
+      id: randomUUID(),
+      timestamp: Date.now(),
+      content: deepClone(content),
+    });
+  }
+
+  private snapshot(branch: Branch): DocMap {
+    const snap = new Map<string, object>();
+    for (const [id, content] of branch.documents) {
+      snap.set(id, deepClone(content));
+    }
+    return snap;
+  }
+
+  private mergeBaseKey(a: string, b: string): string {
+    return a < b ? `${a}\u0000${b}` : `${b}\u0000${a}`;
+  }
+
+  private getMergeBase(a: string, b: string): DocMap {
+    return this.mergeBases.get(this.mergeBaseKey(a, b)) ?? new Map();
+  }
+
+  private setMergeBase(a: string, b: string, snap: DocMap): void {
+    this.mergeBases.set(this.mergeBaseKey(a, b), snap);
+  }
+}
+
+
+export function createDocumentStore(): DocumentStore {
+  return new DocumentStoreImpl();
+}
diff --git a/tests/store.test.ts b/tests/store.test.ts
new file mode 100644
index 0000000..b9697dc
--- /dev/null
+++ b/tests/store.test.ts
@@ -0,0 +1,363 @@
+import { describe, it, expect } from 'vitest';
+import { createDocumentStore, type DocumentStore } from '../src/index';
+
+function store(): DocumentStore {
+  return createDocumentStore();
+}
+
+describe('DocumentStore CRUD', () => {
+  it('creates, gets, updates, and deletes', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    expect(s.get('a')).toEqual({ x: 1 });
+    s.update('a', { x: 2 });
+    expect(s.get('a')).toEqual({ x: 2 });
+    s.delete('a');
+    expect(() => s.get('a')).toThrow();
+  });
+
+  it('throws on duplicate create', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    expect(() => s.create('a', { x: 2 })).toThrow();
+  });
+
+  it('throws on update of missing doc', () => {
+    const s = store();
+    expect(() => s.update('a', { x: 1 })).toThrow();
+  });
+
+  it('throws on delete of missing doc', () => {
+    const s = store();
+    expect(() => s.delete('a')).toThrow();
+  });
+
+  it('deep-clones on store and retrieve', () => {
+    const s = store();
+    const original = { nested: { y: 1 } };
+    s.create('a', original);
+    original.nested.y = 999;
+    expect(s.get('a')).toEqual({ nested: { y: 1 } });
+    const got = s.get("a") as Record<string, unknown>;
+    (got.nested as Record<string, unknown>).y = 42;
+    got.nested.y = 42;
+    expect(s.get('a')).toEqual({ nested: { y: 1 } });
+  });
+});
+
+describe('Version history', () => {
+  it('records versions chronologically', () => {
+    const s = store();
+    s.create('a', { v: 1 });
+    s.update('a', { v: 2 });
+    s.update('a', { v: 3 });
+    const hist = s.getHistory('a');
+    expect(hist).toHaveLength(3);
+    expect(hist[0].content).toEqual({ v: 1 });
+    expect(hist[2].content).toEqual({ v: 3 });
+    expect(hist[0].timestamp).toBeLessThanOrEqual(hist[1].timestamp);
+    expect(hist[1].timestamp).toBeLessThanOrEqual(hist[2].timestamp);
+  });
+
+  it('returns content by version id', () => {
+    const s = store();
+    s.create('a', { v: 1 });
+    s.update('a', { v: 2 });
+    const hist = s.getHistory('a');
+    expect(s.getVersion('a', hist[0].id)).toEqual({ v: 1 });
+    expect(s.getVersion('a', hist[1].id)).toEqual({ v: 2 });
+  });
+
+  it('throws on unknown version id', () => {
+    const s = store();
+    s.create('a', { v: 1 });
+    expect(() => s.getVersion('a', 'nope')).toThrow();
+  });
+});
+
+describe('Branching', () => {
+  it('isolates changes between branches', () => {
+    const s = store();
+    s.create('a', { x: 1 });
+    s.createBranch('dev');
+    s.switchBranch('dev');
+    s.update('a', { x: 2 });
+    s.switchBranch('main');
+    expect(s.get('a')).toEqual({ x: 1 });
+    s.switchBranch('dev');
