+++ b/src/runner/index.ts
@@ -0,0 +1,123 @@
+import { createContext, Script, Context } from 'vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+function measureMemory(): number {
+  return process.memoryUsage().heapUsed;
+}
+
+function wrapCode(code: string): string {
+  return `(function() {\n${code}\n})()`;
+}
+
+function runInSandbox(
+  code: string,
+  context: Record<string, unknown> = {}
+): { output: unknown; error?: string } {
+  const sandbox: Context = createContext({
+    ...context,
+    console: {
+      log: (..._args: unknown[]) => {
+        // swallow logs to keep sandbox isolated
+      },
+    },
+  });
+
+  const script = new Script(wrapCode(code));
+
+  let output: unknown = undefined;
+  try {
+    output = script.runInContext(sandbox, { breakOnSigint: true });
+  } catch (err) {
+    return { output: undefined, error: err instanceof Error ? err.message : String(err) };
+  }
+
+  return { output };
+}
+
+export function createRunner(): RunnerService {
+  async function executeInternal(
+    code: string,
+    timeoutMs: number | undefined,
+    context?: Record<string, unknown>
+  ): Promise<SandboxResult> {
+    const startMemory = measureMemory();
+    const startTime = process.hrtime.bigint();
+
+    let result: { output: unknown; error?: string };
+    let timedOut = false;
+
+    if (timeoutMs !== undefined) {
+      // Synchronous vm can't be interrupted cleanly for infinite loops without a
+      // separate thread. Run the code in a worker thread so we can terminate it
+      // on timeout.
+      const { Worker } = await import('worker_threads');
+      const workerCode = `
+        const { createContext, Script } = require('vm');
+        const { parentPort } = require('worker_threads');
+        const userCode = ${JSON.stringify(wrapCode(code))};
+        const ctx = ${JSON.stringify(context ?? {})};
+        try {
+          const sandbox = createContext({ ...ctx });
+          const script = new Script(userCode);
+          const output = script.runInContext(sandbox);
+          parentPort.postMessage({ output });
+        } catch (err) {
+          parentPort.postMessage({ error: err instanceof Error ? err.message : String(err) });
+        }
+      `;
+      const worker = new Worker(workerCode, { eval: true });
+      result = await new Promise<{ output: unknown; error?: string }>(resolve => {
+        let settled = false;
+        const timer = setTimeout(() => {
+          if (settled) return;
+          settled = true;
+          timedOut = true;
+          worker.terminate();
+          resolve({ output: undefined, error: `Execution timed out after ${timeoutMs}ms` });
+        }, timeoutMs);
+
+        worker.on('message', (msg: { output?: unknown; error?: string }) => {
+          if (settled) return;
+          settled = true;
+          clearTimeout(timer);
+          worker.terminate();
+          resolve({ output: msg.output, error: msg.error });
+        });
+
+        worker.on('error', (err: Error) => {
+          if (settled) return;
+          settled = true;
+          clearTimeout(timer);
+          worker.terminate();
+          resolve({ output: undefined, error: err.message });
+        });
+      });
+    } else {
+      result = runInSandbox(code, context);
+    }
+
+    const endTime = process.hrtime.bigint();
+    const duration = Number(endTime - startTime) / 1e6;
+
+    return {
+      success: !result.error && !timedOut,
+      output: timedOut ? undefined : result.output,
+      duration,
+      memoryUsed: measureMemory() - startMemory,
+      error: result.error,
+    };
+  }
+
+  return {
+    execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult> {
+      return executeInternal(code, undefined, context);
+    },
+    executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context?: Record<string, unknown>
+    ): Promise<SandboxResult> {
+      return executeInternal(code, timeoutMs, context);
+    },
+  };
+}
