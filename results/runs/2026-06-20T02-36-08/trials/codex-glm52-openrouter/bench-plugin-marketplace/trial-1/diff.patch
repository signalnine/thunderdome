index 0000000..7b5048f
--- /dev/null
+++ b/src/deps/index.ts
@@ -0,0 +1,127 @@
+import type {
+  DepsService,
+  RegistryService,
+  DependencyNode,
+} from '../types.js';
+
+function getManifest(name: string, registry: RegistryService) {
+  const manifest = registry.get(name);
+  if (!manifest) {
+    throw new Error(`Plugin "${name}" not found in registry`);
+  }
+  return manifest;
+}
+
+export function createDepsService(): DepsService {
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      const visited = new Set<string>();
+      const build = (pluginName: string): DependencyNode => {
+        const manifest = getManifest(pluginName, registry);
+        const node: DependencyNode = {
+          name: manifest.name,
+          version: manifest.version,
+          dependencies: [],
+        };
+        if (visited.has(pluginName)) {
+          return node;
+        }
+        visited.add(pluginName);
+        for (const depName of Object.keys(manifest.dependencies)) {
+          node.dependencies.push(build(depName));
+        }
+        return node;
+      };
+      return build(name);
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const cycles: string[][] = [];
+      const visited = new Set<string>();
+      const stack: string[] = [];
+      const onStack = new Set<string>();
+
+      const dfs = (pluginName: string): void => {
+        if (onStack.has(pluginName)) {
+          const cycleStart = stack.indexOf(pluginName);
+          const cycle = stack.slice(cycleStart).concat(pluginName);
+          cycles.push(cycle);
+          return;
+        }
+        if (visited.has(pluginName)) return;
+        visited.add(pluginName);
+        onStack.add(pluginName);
+        stack.push(pluginName);
+
+        const manifest = registry.get(pluginName);
+        if (manifest) {
+          for (const depName of Object.keys(manifest.dependencies)) {
+            dfs(depName);
+          }
+        }
+
+        stack.pop();
+        onStack.delete(pluginName);
+      };
+
+      dfs(name);
+      return cycles.length > 0 ? cycles : null;
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const result: string[] = [];
+      const visited = new Set<string>();
+      const visiting = new Set<string>();
+
+      const visit = (pluginName: string): void => {
+        if (visited.has(pluginName)) return;
+        if (visiting.has(pluginName)) return; // cycle: stop to avoid infinite loop
+        visiting.add(pluginName);
+        const manifest = registry.get(pluginName);
+        if (manifest) {
+          for (const depName of Object.keys(manifest.dependencies)) {
+            visit(depName);
+          }
+        }
+        visiting.delete(pluginName);
+        if (!visited.has(pluginName)) {
+          visited.add(pluginName);
+          result.push(pluginName);
+        }
+      };
+
+      visit(name);
+      return result;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const result: string[] = [];
+      const visited = new Set<string>();
+      const visiting = new Set<string>();
+
+      const visit = (pluginName: string, isRoot: boolean): void => {
+        if (visited.has(pluginName) || visiting.has(pluginName)) return;
+        visiting.add(pluginName);
+        const manifest = registry.get(pluginName);
+        if (manifest) {
+          for (const depName of Object.keys(manifest.dependencies)) {
+            visit(depName, false);
+          }
+        }
+        visiting.delete(pluginName);
+        visited.add(pluginName);
+        if (!isRoot) {
+          result.push(pluginName);
+        }
+      };
+
+      visit(name, true);
+      return result;
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      const cycles = this.detectCycles(name, registry);
+      return cycles !== null;
+    },
+  };
+}
