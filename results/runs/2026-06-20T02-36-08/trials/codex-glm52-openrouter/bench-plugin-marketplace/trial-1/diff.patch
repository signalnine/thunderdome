or on timeout', async () => {\n    const result = await runner.executeWithTimeout(\n      'var i = 0; while(true) { i++; }',\n      50\n    );\n    expect(result.success).toBe(false);\n    expect(result.error).toBeDefined();\n    expect(result.duration).toBeGreaterThan(0);\n  });\n});\n","exit_code":0,"status":"completed"}}
