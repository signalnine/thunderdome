.flagReview(review.id);\n    const flagged = reviews.getFlaggedReviews();\n    expect(flagged).toHaveLength(1);\n    expect(flagged[0].flagged).toBe(true);\n  });\n\n  it('getFlaggedReviews returns only flagged', () => {\n    const r1 = reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u1', rating: 1, comment: 'bad' });\n    reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u2', rating: 5, comment: 'good' });\n    reviews.flagReview(r1.id);\n    const flagged = reviews.getFlaggedReviews();\n    expect(flagged).toHaveLength(1);\n    expect(flagged[0].id).toBe(r1.id);\n  });\n\n  it('removeReview deletes review', () => {\n    const review = reviews.addReview({\n      pluginName: 'p',\n      pluginVersion: '1.0.0',\n      userId: 'u1',\n      rating: 3,\n      comment: 'meh',\n    });\n    expect(reviews.removeReview(review.id)).toBe(true);\n    expect(reviews.getReviews('p')).toHaveLength(0);\n  });\n\n  it('getReviewsByUser returns user reviews', () => {\n    reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'alice', rating: 5, comment: 'love it' });\n    reviews.addReview({ pluginName: 'p2', pluginVersion: '1.0.0', userId: 'alice', rating: 4, comment: 'nice' });\n    reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'bob', rating: 3, comment: 'ok' });\n    const aliceReviews = reviews.getReviewsByUser('alice');\n    expect(aliceReviews).toHaveLength(2);\n    aliceReviews.forEach(r => expect(r.userId).toBe('alice'));\n  });\n\n  it('getReviewCount returns correct count', () => {\n    reviews.addReview({ pluginName: 'counter', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'a' });\n    reviews.addReview({ pluginName: 'counter', pluginVersion: '1.0.0', userId: 'u2', rating: 4, comment: 'b' });\n    reviews.addReview({ pluginName: 'counter', pluginVersion: '1.1.0', userId: 'u3', rating: 3, comment: 'c' });\n    expect(reviews.getReviewCount('counter')).toBe(3);\n  });\n});\n","exi