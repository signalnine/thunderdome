index 0000000..6ba3bcc
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,91 @@
+import { createRegistry } from './registry/index.js';
+import { createResolver } from './resolver/index.js';
+import { createRunner } from './runner/index.js';
+import { createReviewSystem } from './reviews/index.js';
+import { createDepsService } from './deps/index.js';
+import type {
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+  PluginManifest,
+  ResolvedVersion,
+  SandboxResult,
+} from './types.js';
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest): Promise<{
+    resolved: ResolvedVersion[];
+    sandboxResult: SandboxResult;
+  }>;
+}
+
+export interface InstallResult {
+  resolved: ResolvedVersion[];
+  sandboxResult: SandboxResult;
+}
+
+function validateManifest(manifest: PluginManifest): void {
+  if (
+    !manifest.name ||
+    typeof manifest.name !== 'string' ||
+    manifest.name.trim() === '' ||
+    !manifest.version ||
+    typeof manifest.version !== 'string' ||
+    manifest.version.trim() === '' ||
+    !manifest.entryPoint ||
+    typeof manifest.entryPoint !== 'string' ||
+    manifest.entryPoint.trim() === ''
+  ) {
+    throw new Error('Invalid manifest: name, version, and entryPoint are required');
+  }
+}
+
+export function createMarketplace(): Marketplace {
+  const registry = createRegistry();
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviewSystem();
+  const deps = createDepsService();
+
+  return {
+    registry,
+    resolver,
+    runner,
+    reviews,
+    deps,
+
+    async installPlugin(manifest: PluginManifest): Promise<InstallResult> {
+      validateManifest(manifest);
+
+      registry.register(manifest);
+
+      if (deps.hasCircularDependency(manifest.name, registry)) {
+        throw new Error(
+          `Circular dependency detected for plugin "${manifest.name}"`
+        );
+      }
+
+      const constraints = Object.entries(manifest.dependencies).map(
+        ([name, range]) => ({ name, range })
+      );
+
+      const available: Record<string, string[]> = {};
+      for (const constraint of constraints) {
+        available[constraint.name] = registry.listVersions(constraint.name);
+      }
+
+      const resolved = resolver.resolve(constraints, available);
+
+      const sandboxResult = await runner.execute(manifest.entryPoint);
+
+      return { resolved, sandboxResult };
+    },
+  };
+}
diff --git a/src/registry/index.ts b/src/registry/index.ts
new file mode 100644
index 0000000..81a3446
--- /dev/null
+++ b/src/registry/index.ts
@@ -0,0 +1,118 @@
+import Database from 'better-sqlite3';
+import type { Database as DatabaseType } from 'better-sqlite3';
+import type { PluginManifest, RegistryService } from '../types.js';
+import { compare } from 'semver';
+
+const CREATE_SQL = `
+  CREATE TABLE IF NOT EXISTS plugins (
+    name TEXT NOT NULL,
+    version TEXT NOT NULL,
+    description TEXT NOT NULL,
+    author TEXT NOT NULL,
+    dependencies TEXT NOT NULL,
+    entry_point TEXT NOT NULL,
+    permissions TEXT NOT NULL,
+    PRIMARY KEY (name, version)
+  )
+`;
+
+function rowToManifest(row: Record<string, string>): PluginManifest {
+  return {
+    name: row.name,
+    version: row.version,
+    description: row.description,
+    author: row.author,
+    dependencies: JSON.parse(row.dependencies) as Record<string, string>,
+    entryPoint: row.entry_point,
+    permissions: JSON.parse(row.permissions) as string[],
+  };
+}
+
+export function createRegistry(db?: DatabaseType): RegistryService {
+  const database = db ?? new Database(':memory:');
+  database.exec(CREATE_SQL);
+
+  const registerStmt = database.prepare(
+    `INSERT OR REPLACE INTO plugins (name, version, description, author, dependencies, entry_point, permissions)
+     VALUES (@name, @version, @description, @author, @dependencies, @entry_point, @permissions)`
+  );
+  const getVersionStmt = database.prepare(
+    'SELECT * FROM plugins WHERE name = ? AND version = ?'
+  );
+  const listByNameStmt = database.prepare('SELECT * FROM plugins WHERE name = ?');
+  const listAllStmt = database.prepare('SELECT * FROM plugins');
+  const searchStmt = database.prepare(
+    'SELECT * FROM plugins WHERE name LIKE ? OR description LIKE ?'
+  );
+  const removeStmt = database.prepare(
+    'DELETE FROM plugins WHERE name = ? AND version = ?'
+  );
+  const updateStmt = database.prepare(
+    `UPDATE plugins SET
+       description = COALESCE(@description, description),
+       author = COALESCE(@author, author),
+       dependencies = COALESCE(@dependencies, dependencies),
+       entry_point = COALESCE(@entry_point, entry_point),
+       permissions = COALESCE(@permissions, permissions)
+     WHERE name = @name AND version = @version`
+  );
+
+  return {
+    register(manifest: PluginManifest): void {
+      registerStmt.run({
+        name: manifest.name,
+        version: manifest.version,
+        description: manifest.description,
+        author: manifest.author,
+        dependencies: JSON.stringify(manifest.dependencies),
+        entry_point: manifest.entryPoint,
+        permissions: JSON.stringify(manifest.permissions),
+      });
+    },
+
+    get(name: string): PluginManifest | null {
+      const rows = listByNameStmt.all(name) as Record<string, string>[];
+      if (rows.length === 0) return null;
+      rows.sort((a, b) => compare(b.version, a.version));
+      return rowToManifest(rows[0]);
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const row = getVersionStmt.get(name, version) as Record<string, string> | undefined;
+      return row ? rowToManifest(row) : null;
+    },
+
+    list(): PluginManifest[] {
+      const rows = listAllStmt.all() as Record<string, string>[];
+      return rows.map(rowToManifest);
+    },
+
+    search(query: string): PluginManifest[] {
+      const pattern = `%${query}%`;
+      const rows = searchStmt.all(pattern, pattern) as Record<string, string>[];
+      return rows.map(rowToManifest);
+    },
+
+    remove(name: string, version: string): boolean {
+      const info = removeStmt.run(name, version);
+      return info.changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      const rows = listByNameStmt.all(name) as Record<string, string>[];
+      return rows.map(r => r.version).sort((a, b) => compare(a, b));
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      updateStmt.run({
+        name,
+        version,
+        description: updates.description ?? null,
+        author: updates.author ?? null,
+        dependencies: updates.dependencies ? JSON.stringify(updates.dependencies) : null,
+        entry_point: updates.entryPoint ?? null,
+        permissions: updates.permissions ? JSON.stringify(updates.permissions) : null,
+      });
+    },
+  };
+}
