+export function colToIndex(letters: string): number {
+    let n = 0;
+    for (const c of letters) {
+        n = n * 26 + (c.charCodeAt(0) - 64);
+    }
+    return n - 1;
+}
+
+export function indexToCol(index: number): string {
+    let n = index + 1;
+    let s = '';
+    while (n > 0) {
+        const rem = (n - 1) % 26;
+        s = String.fromCharCode(65 + rem) + s;
+        n = Math.floor((n - 1) / 26);
+    }
+    return s;
+}
+
+export function parseCellRef(ref: string): { col: number; row: number } {
+    const trimmed = ref.trim();
+    const match = trimmed.match(/^([A-Za-z]+)(\d+)$/);
+    if (!match) {
+        throw new Error(`Invalid cell reference: ${ref}`);
+    }
+    const letters = match[1].toUpperCase();
+    const rowStr = match[2];
+    const row = parseInt(rowStr, 10);
+    if (row === 0) {
+        throw new Error(`Invalid cell reference: ${ref}`);
+    }
+    const col = colToIndex(letters);
+    return { col, row };
+}
+
+export function cellKey(col: number, row: number): string {
+    return indexToCol(col) + String(row);
+}
+
+export function normalizeRef(ref: string): string {
+    const { col, row } = parseCellRef(ref);
+    return cellKey(col, row);
+}
+
+export function expandRange(start: string, end: string): string[] {
+    const startParsed = parseCellRef(start);
+    const endParsed = parseCellRef(end);
+    const minCol = Math.min(startParsed.col, endParsed.col);
+    const maxCol = Math.max(startParsed.col, endParsed.col);
+    const minRow = Math.min(startParsed.row, endParsed.row);
+    const maxRow = Math.max(startParsed.row, endParsed.row);
+    const result: string[] = [];
+    for (let r = minRow; r <= maxRow; r++) {
+        for (let c = minCol; c <= maxCol; c++) {
+            result.push(cellKey(c, r));
+        }
+    }
+    return result;
+}
