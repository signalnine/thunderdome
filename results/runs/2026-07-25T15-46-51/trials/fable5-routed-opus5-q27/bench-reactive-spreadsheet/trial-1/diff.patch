+import { normalizeRef } from './refs.js';
+
+export type Expr =
+  | { kind: 'num'; value: number }
+  | { kind: 'str'; value: string }
+  | { kind: 'bool'; value: boolean }
+  | { kind: 'ref'; ref: string }
+  | { kind: 'range'; start: string; end: string }
+  | { kind: 'bin'; op: BinOp; left: Expr; right: Expr }
+  | { kind: 'neg'; operand: Expr }
+  | { kind: 'call'; name: string; args: Expr[] };
+
+export type BinOp = '+' | '-' | '*' | '/' | '=' | '<>' | '<' | '>' | '<=' | '>=';
+
+interface Token {
+  type: 'num' | 'str' | 'ident' | 'op' | 'lparen' | 'rparen' | 'comma' | 'colon';
+  text: string;
+}
+
+const CELL_REF_RE = /^[A-Za-z]+\d+$/;
+
+function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+  while (i < input.length) {
+    const ch = input[i];
+    if (ch === ' ' || ch === '\t' || ch === '\n' || ch === '\r') {
+      i++;
+    } else if (ch >= '0' && ch <= '9') {
+      let j = i;
+      while (j < input.length && input[j] >= '0' && input[j] <= '9') j++;
+      if (input[j] === '.') {
+        j++;
+        while (j < input.length && input[j] >= '0' && input[j] <= '9') j++;
+      }
+      tokens.push({ type: 'num', text: input.slice(i, j) });
+      i = j;
+    } else if (ch === '.') {
+      let j = i + 1;
+      while (j < input.length && input[j] >= '0' && input[j] <= '9') j++;
+      if (j === i + 1) throw new Error(`Unexpected character '.' in formula`);
+      tokens.push({ type: 'num', text: input.slice(i, j) });
+      i = j;
+    } else if (ch === '"') {
+      let j = i + 1;
+      let text = '';
+      for (;;) {
+        if (j >= input.length) throw new Error('Unterminated string literal in formula');
+        if (input[j] === '"') {
+          if (input[j + 1] === '"') {
+            text += '"';
+            j += 2;
+          } else {
+            j++;
+            break;
+          }
+        } else {
+          text += input[j];
+          j++;
+        }
+      }
+      tokens.push({ type: 'str', text });
+      i = j;
+    } else if (/[A-Za-z_]/.test(ch)) {
+      let j = i;
+      while (j < input.length && /[A-Za-z0-9_]/.test(input[j])) j++;
+      tokens.push({ type: 'ident', text: input.slice(i, j) });
+      i = j;
+    } else if (ch === '<') {
+      if (input[i + 1] === '>' || input[i + 1] === '=') {
+        tokens.push({ type: 'op', text: '<' + input[i + 1] });
+        i += 2;
+      } else {
+        tokens.push({ type: 'op', text: '<' });
+        i++;
+      }
+    } else if (ch === '>') {
+      if (input[i + 1] === '=') {
+        tokens.push({ type: 'op', text: '>=' });
+        i += 2;
+      } else {
+        tokens.push({ type: 'op', text: '>' });
+        i++;
+      }
+    } else if (ch === '=' || ch === '+' || ch === '-' || ch === '*' || ch === '/') {
+      tokens.push({ type: 'op', text: ch });
+      i++;
+    } else if (ch === '(') {
+      tokens.push({ type: 'lparen', text: ch });
+      i++;
+    } else if (ch === ')') {
+      tokens.push({ type: 'rparen', text: ch });
+      i++;
+    } else if (ch === ',') {
+      tokens.push({ type: 'comma', text: ch });
+      i++;
+    } else if (ch === ':') {
+      tokens.push({ type: 'colon', text: ch });
+      i++;
+    } else {
+      throw new Error(`Unexpected character '${ch}' in formula`);
+    }
+  }
+  return tokens;
+}
+
+class Parser {
+  private pos = 0;
+
+  constructor(private tokens: Token[]) {}
+
+  parse(): Expr {
+    const expr = this.parseComparison();
+    if (this.pos < this.tokens.length) {
+      throw new Error(`Unexpected token '${this.tokens[this.pos].text}' in formula`);
+    }
+    return expr;
+  }
+
+  private peek(): Token | undefined {
+    return this.tokens[this.pos];
+  }
+
+  private next(): Token {
+    const tok = this.tokens[this.pos];
+    if (!tok) throw new Error('Unexpected end of formula');
+    this.pos++;
+    return tok;
+  }
+
+  private parseComparison(): Expr {
+    let left = this.parseAdditive();
+    for (;;) {
+      const tok = this.peek();
+      if (tok?.type === 'op' && ['=', '<>', '<', '>', '<=', '>='].includes(tok.text)) {
+        this.next();
+        const right = this.parseAdditive();
+        left = { kind: 'bin', op: tok.text as BinOp, left, right };
+      } else {
+        return left;
+      }
+    }
+  }
+
+  private parseAdditive(): Expr {
+    let left = this.parseMultiplicative();
+    for (;;) {
+      const tok = this.peek();
+      if (tok?.type === 'op' && (tok.text === '+' || tok.text === '-')) {
+        this.next();
+        const right = this.parseMultiplicative();
+        left = { kind: 'bin', op: tok.text as BinOp, left, right };
+      } else {
+        return left;
+      }
+    }
+  }
+
+  private parseMultiplicative(): Expr {
+    let left = this.parseUnary();
+    for (;;) {
+      const tok = this.peek();
+      if (tok?.type === 'op' && (tok.text === '*' || tok.text === '/')) {
+        this.next();
+        const right = this.parseUnary();
+        left = { kind: 'bin', op: tok.text as BinOp, left, right };
+      } else {
+        return left;
+      }
+    }
+  }
+
+  private parseUnary(): Expr {
+    const tok = this.peek();
+    if (tok?.type === 'op' && tok.text === '-') {
+      this.next();
+      return { kind: 'neg', operand: this.parseUnary() };
+    }
+    if (tok?.type === 'op' && tok.text === '+') {
+      this.next();
+      return this.parseUnary();
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): Expr {
+    const tok = this.next();
+    if (tok.type === 'num') {
+      return { kind: 'num', value: parseFloat(tok.text) };
+    }
+    if (tok.type === 'str') {
+      return { kind: 'str', value: tok.text };
+    }
+    if (tok.type === 'lparen') {
+      const expr = this.parseComparison();
+      const close = this.next();
+      if (close.type !== 'rparen') throw new Error(`Expected ')' in formula`);
+      return expr;
+    }
+    if (tok.type === 'ident') {
+      const upper = tok.text.toUpperCase();
+      if (upper === 'TRUE') return { kind: 'bool', value: true };
+      if (upper === 'FALSE') return { kind: 'bool', value: false };
+      if (this.peek()?.type === 'lparen') {
+        this.next();
+        const args: Expr[] = [];
+        if (this.peek()?.type === 'rparen') {
+          this.next();
+        } else {
+          for (;;) {
+            args.push(this.parseComparison());
+            const sep = this.next();
+            if (sep.type === 'rparen') break;
+            if (sep.type !== 'comma') throw new Error(`Expected ',' or ')' in function call`);
+          }
+        }
+        return { kind: 'call', name: upper, args };
+      }
+      if (!CELL_REF_RE.test(tok.text)) {
+        throw new Error(`Invalid reference or unknown name '${tok.text}' in formula`);
+      }
+      const start = normalizeRef(tok.text);
+      if (this.peek()?.type === 'colon') {
+        this.next();
+        const endTok = this.next();
+        if (endTok.type !== 'ident' || !CELL_REF_RE.test(endTok.text)) {
+          throw new Error('Expected cell reference after ":" in range');
+        }
+        return { kind: 'range', start, end: normalizeRef(endTok.text) };
+      }
+      return { kind: 'ref', ref: start };
+    }
+    throw new Error(`Unexpected token '${tok.text}' in formula`);
+  }
+}
+
+export function parseFormula(source: string): Expr {
+  const body = source.slice(1); // strip leading '='
+  const tokens = tokenize(body);
+  if (tokens.length === 0) throw new Error('Empty formula');
+  return new Parser(tokens).parse();
+}
