diff --git a/src/engine.ts b/src/engine.ts
new file mode 100644
index 0000000..eb11b4c
--- /dev/null
+++ b/src/engine.ts
@@ -0,0 +1,295 @@
+import { normalizeRef, expandRange } from './refs.js';
+import { parseFormula, Expr, BinOp } from './parser.js';
+
+export type CellValue = string | number | boolean | null;
+
+class FormulaError extends Error {
+  constructor(public code: string) {
+    super(code);
+  }
+}
+
+interface Cell {
+  raw: string | number | boolean;
+  formula: Expr | null;
+  value: CellValue;
+  deps: Set<string>;
+}
+
+export class Spreadsheet {
+  private cells = new Map<string, Cell>();
+  // key -> set of formula cells that read it; kept separately from `cells`
+  // so empty cells referenced by ranges/refs can still have dependents.
+  private dependents = new Map<string, Set<string>>();
+
+  set(cell: string, value: string | number | boolean): void {
+    const key = normalizeRef(cell);
+    let formula: Expr | null = null;
+    let deps = new Set<string>();
+    if (typeof value === 'string' && value.startsWith('=')) {
+      formula = parseFormula(value);
+      deps = collectDeps(formula);
+      this.checkNoCycle(key, deps);
+    }
+
+    const existing = this.cells.get(key);
+    if (existing) {
+      for (const dep of existing.deps) {
+        this.dependents.get(dep)?.delete(key);
+      }
+    }
+    for (const dep of deps) {
+      let set = this.dependents.get(dep);
+      if (!set) {
+        set = new Set();
+        this.dependents.set(dep, set);
+      }
+      set.add(key);
+    }
+    this.cells.set(key, { raw: value, formula, value: null, deps });
+    this.recomputeFrom(key);
+  }
+
+  get(cell: string): CellValue {
+    const c = this.cells.get(normalizeRef(cell));
+    return c ? c.value : null;
+  }
+
+  getDisplay(cell: string): string {
+    const value = this.get(cell);
+    if (value === null) return '';
+    return String(value);
+  }
+
+  getCells(): Map<string, CellValue> {
+    const result = new Map<string, CellValue>();
+    for (const [key, c] of this.cells) {
+      result.set(key, c.value);
+    }
+    return result;
+  }
+
+  // Throws if making `key` depend on `newDeps` would create a cycle, i.e. if
+  // `key` is reachable from any of `newDeps` by following dependency edges.
+  private checkNoCycle(key: string, newDeps: Set<string>): void {
+    const stack = [...newDeps];
+    const visited = new Set<string>();
+    while (stack.length > 0) {
+      const current = stack.pop()!;
+      if (current === key) {
+        throw new Error(`Circular reference detected involving ${key}`);
+      }
+      if (visited.has(current)) continue;
+      visited.add(current);
+      const cell = this.cells.get(current);
+      if (cell) {
+        for (const dep of cell.deps) stack.push(dep);
+      }
+    }
+  }
+
+  private recomputeFrom(key: string): void {
+    // Collect the changed cell plus all transitive dependents.
+    const affected = new Set<string>();
+    const stack = [key];
+    while (stack.length > 0) {
+      const current = stack.pop()!;
+      if (affected.has(current)) continue;
+      affected.add(current);
+      const deps = this.dependents.get(current);
+      if (deps) {
+        for (const dependent of deps) stack.push(dependent);
+      }
+    }
+
+    // Topologically order the affected cells by their dependency edges
+    // (restricted to the affected set), then evaluate in order. The graph is
+    // acyclic because set() rejects cycles.
+    const ordered: string[] = [];
+    const state = new Map<string, 'visiting' | 'done'>();
+    const visit = (current: string): void => {
+      if (state.get(current) === 'done') return;
+      state.set(current, 'visiting');
+      const cell = this.cells.get(current);
+      if (cell) {
+        for (const dep of cell.deps) {
+          if (affected.has(dep) && state.get(dep) !== 'done') visit(dep);
+        }
+      }
+      state.set(current, 'done');
+      ordered.push(current);
+    };
+    for (const current of affected) visit(current);
+
+    for (const current of ordered) {
+      const cell = this.cells.get(current);
+      if (!cell) continue;
+      if (cell.formula) {
+        try {
+          cell.value = this.evaluate(cell.formula);
+        } catch (err) {
+          cell.value = err instanceof FormulaError ? err.code : '#ERROR!';
+        }
+      } else {
+        cell.value = cell.raw;
+      }
+    }
+  }
+
+  private readCell(key: string): CellValue {
+    const cell = this.cells.get(key);
+    return cell ? cell.value : null;
+  }
+
+  private evaluate(expr: Expr): CellValue {
+    switch (expr.kind) {
+      case 'num':
+        return expr.value;
+      case 'str':
+        return expr.value;
+      case 'bool':
+        return expr.value;
+      case 'ref':
+        return this.readCell(expr.ref);
+      case 'range':
+        throw new FormulaError('#VALUE!');
+      case 'neg':
+        return -toNumber(this.evaluate(expr.operand));
+      case 'bin':
+        return this.evaluateBinary(expr.op, expr.left, expr.right);
+      case 'call':
+        return this.evaluateCall(expr.name, expr.args);
+    }
+  }
+
+  private evaluateBinary(op: BinOp, leftExpr: Expr, rightExpr: Expr): CellValue {
+    const left = this.evaluate(leftExpr);
+    const right = this.evaluate(rightExpr);
+    switch (op) {
+      case '+':
+        return toNumber(left) + toNumber(right);
+      case '-':
+        return toNumber(left) - toNumber(right);
+      case '*':
+        return toNumber(left) * toNumber(right);
+      case '/': {
+        const divisor = toNumber(right);
+        if (divisor === 0) throw new FormulaError('#DIV/0!');
+        return toNumber(left) / divisor;
+      }
+      case '=':
+        return compare(left, right) === 0;
+      case '<>':
+        return compare(left, right) !== 0;
+      case '<':
+        return compare(left, right) < 0;
+      case '>':
+        return compare(left, right) > 0;
+      case '<=':
+        return compare(left, right) <= 0;
+      case '>=':
+        return compare(left, right) >= 0;
+    }
+  }
+
+  private evaluateCall(name: string, args: Expr[]): CellValue {
+    if (name === 'IF') {
+      if (args.length !== 3) throw new FormulaError('#VALUE!');
+      const condition = this.evaluate(args[0]);
+      return isTruthy(condition) ? this.evaluate(args[1]) : this.evaluate(args[2]);
+    }
+
+    if (!['SUM', 'AVERAGE', 'MIN', 'MAX', 'COUNT'].includes(name)) {
+      throw new FormulaError('#NAME?');
+    }
+    if (args.length === 0) throw new FormulaError('#VALUE!');
+
+    const numbers: number[] = [];
+    for (const arg of args) {
+      if (arg.kind === 'range') {
+        for (const key of expandRange(arg.start, arg.end)) {
+          const value = this.readCell(key);
+          if (typeof value === 'number') numbers.push(value);
+        }
+      } else {
+        const value = this.evaluate(arg);
+        if (typeof value === 'number') numbers.push(value);
+      }
+    }
+
+    switch (name) {
+      case 'SUM':
+        return numbers.reduce((a, b) => a + b, 0);
+      case 'AVERAGE':
+        if (numbers.length === 0) throw new FormulaError('#DIV/0!');
+        return numbers.reduce((a, b) => a + b, 0) / numbers.length;
+      case 'MIN':
+        return numbers.length === 0 ? 0 : Math.min(...numbers);
+      case 'MAX':
+        return numbers.length === 0 ? 0 : Math.max(...numbers);
+      case 'COUNT':
+        return numbers.length;
+      default:
+        throw new FormulaError('#NAME?');
+    }
+  }
+}
+
+function collectDeps(expr: Expr): Set<string> {
+  const deps = new Set<string>();
+  const walk = (node: Expr): void => {
+    switch (node.kind) {
+      case 'ref':
+        deps.add(node.ref);
+        break;
+      case 'range':
+        for (const key of expandRange(node.start, node.end)) deps.add(key);
+        break;
+      case 'bin':
+        walk(node.left);
+        walk(node.right);
+        break;
+      case 'neg':
+        walk(node.operand);
+        break;
+      case 'call':
+        for (const arg of node.args) walk(arg);
+        break;
+      default:
+        break;
+    }
+  };
+  walk(expr);
+  return deps;
+}
+
+function toNumber(value: CellValue): number {
+  if (value === null) return 0;
+  if (typeof value === 'number') return value;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+  const parsed = Number(value);
+  if (Number.isNaN(parsed) || value.trim() === '') throw new FormulaError('#VALUE!');
+  return parsed;
+}
+
+function isTruthy(value: CellValue): boolean {
+  if (typeof value === 'boolean') return value;
+  if (typeof value === 'number') return value !== 0;
+  if (value === null) return false;
+  throw new FormulaError('#VALUE!');
+}
+
+// Returns negative/zero/positive like a comparator. Strings compare
+// lexicographically (case-insensitive); everything else compares numerically.
+function compare(left: CellValue, right: CellValue): number {
+  if (typeof left === 'string' && typeof right === 'string') {
+    const a = left.toLowerCase();
+    const b = right.toLowerCase();
+    return a < b ? -1 : a > b ? 1 : 0;
+  }
+  if (typeof left === 'string' || typeof right === 'string') {
+    // Mixed string/non-string values are never equal; order strings last.
+    return typeof left === 'string' ? 1 : -1;
+  }
+  return toNumber(left) - toNumber(right);
+}
