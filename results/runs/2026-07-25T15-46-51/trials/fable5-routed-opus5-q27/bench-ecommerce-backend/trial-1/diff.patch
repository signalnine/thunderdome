@@ -0,0 +1,43 @@
+import { EventBus } from '../bus.js';
+import { PaymentService, PaymentStatus, Events } from '../types.js';
+
+export interface PaymentServiceOptions {
+  simulateFailure?: boolean;
+  simulateTimeout?: boolean;
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentServiceOptions = {}): PaymentService {
+  let counter = 0;
+  const transactions = new Set<string>();
+
+  return {
+    async processPayment(
+      orderId: string,
+      _amount: number
+    ): Promise<{ status: PaymentStatus; transactionId?: string; error?: string }> {
+      let result: { status: PaymentStatus; transactionId?: string; error?: string };
+
+      if (options.simulateTimeout) {
+        result = { status: PaymentStatus.TIMEOUT, error: 'Payment timed out' };
+      } else if (options.simulateFailure) {
+        result = { status: PaymentStatus.FAILED, error: 'Payment declined' };
+      } else {
+        const transactionId = 'tx-' + (++counter);
+        transactions.add(transactionId);
+        result = { status: PaymentStatus.SUCCESS, transactionId };
+      }
+
+      await bus.emit(Events.PAYMENT_PROCESSED, { orderId, ...result });
+
+      return result;
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      if (transactions.has(transactionId)) {
+        transactions.delete(transactionId);
+        return true;
+      }
+      return false;
+    },
+  };
+}
