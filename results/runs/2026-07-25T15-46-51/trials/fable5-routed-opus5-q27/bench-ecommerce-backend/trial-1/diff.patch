@@ -0,0 +1,36 @@
+import { EventBus } from '../bus.js';
+import { PricingService, ProductCreatedEvent, Events } from '../types.js';
+
+export function createPricingService(bus: EventBus): PricingService {
+  const prices = new Map<string, number>();
+  const discounts = new Map<string, number>();
+
+  bus.on(Events.PRODUCT_CREATED, (payload) => {
+    const e = payload as ProductCreatedEvent;
+    prices.set(e.productId, e.price);
+  });
+
+  // Guard against float artifacts like 90 * 0.1 === 9.000000000000002
+  const round2 = (n: number): number => Math.round(n * 100) / 100;
+
+  return {
+    calculateTotal(
+      items: Array<{ productId: string; quantity: number; price: number }>,
+      discountCode?: string
+    ): { subtotal: number; discount: number; tax: number; total: number } {
+      const subtotal = round2(items.reduce((sum, i) => sum + i.price * i.quantity, 0));
+      const pct = discountCode !== undefined ? discounts.get(discountCode) : undefined;
+      const discount = pct !== undefined ? round2((subtotal * pct) / 100) : 0;
+      const taxable = subtotal - discount;
+      const tax = round2(taxable * 0.1);
+      const total = round2(taxable + tax);
+      return { subtotal, discount, tax, total };
+    },
+    addDiscountCode(code: string, percentage: number): void {
+      discounts.set(code, percentage);
+    },
+    getPrice(productId: string): number {
+      return prices.get(productId) ?? 0;
+    },
+  };
+}
