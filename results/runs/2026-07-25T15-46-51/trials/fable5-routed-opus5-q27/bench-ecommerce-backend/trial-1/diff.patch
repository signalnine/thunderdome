OCESSED, (payload) => {\n    track(Events.PAYMENT_PROCESSED);\n    const e = payload as PaymentProcessedEvent;\n    if (e.status === PaymentStatus.SUCCESS) {\n      revenue += orderTotals.get(e.orderId) ?? 0;\n    }\n  });\n\n  return {\n    getEventCount(eventType: string): number {\n      return counts.get(eventType) ?? 0;\n    },\n    getRevenue(): number {\n      return revenue;\n    },\n    getConversionRate(): number {\n      return uniqueCarts.size === 0 ? 0 : orderCount / uniqueCarts.size;\n    },\n    getTopProducts(limit: number): Array<{ productId: string; count: number }> {\n      return Array.from(productCounts.entries())\n        .map(([productId, count]) => ({ productId, count }))\n        .sort((a, b) => b.count - a.count)\n        .slice(0, limit);\n    },\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":13309,"cache_read_input_tokens":48829,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13309},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"dbba5675-f534-485d-9b4e-7351f5b99dee","uuid":"f05401e5-388b-4fe9-b8d5-efd7d6c297ff","request_id":"req_011CdP3rXnmyQaDvPhvYMAF2"}
