+import { EventBus } from '../bus.js';
+import { OrderService, OrderStatus, Events } from '../types.js';
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<
+    string,
+    { id: string; userId: string; cartId: string; status: OrderStatus; total: number }
+  >();
+  let counter = 0;
+
+  return {
+    createOrder(userId: string, cartId: string, total: number): string {
+      const id = 'order-' + (++counter);
+      orders.set(id, { id, userId, cartId, status: OrderStatus.PENDING, total });
+      void bus.emit(Events.ORDER_CREATED, { orderId: id, userId, cartId, total });
+      return id;
+    },
+
+    getOrder(orderId: string): { id: string; userId: string; status: OrderStatus; total: number } | null {
+      const order = orders.get(orderId);
+      if (!order) {
+        return null;
+      }
+      return { id: order.id, userId: order.userId, status: order.status, total: order.total };
+    },
+
+    updateStatus(orderId: string, status: OrderStatus): void {
+      const order = orders.get(orderId);
+      if (!order) {
+        return;
+      }
+      const previousStatus = order.status;
+      order.status = status;
+      void bus.emit(Events.ORDER_STATUS_CHANGED, { orderId, status, previousStatus });
+    },
+
+    listOrders(userId: string): Array<{ id: string; status: OrderStatus; total: number }> {
+      const result: Array<{ id: string; status: OrderStatus; total: number }> = [];
+      for (const order of orders.values()) {
+        if (order.userId === userId) {
+          result.push({ id: order.id, status: order.status, total: order.total });
+        }
+      }
+      return result;
+    },
+  };
+}
