+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nrq5uvant8BZ7DXUqFkcb7","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach } from 'vitest';\n2\timport { createHash } from 'crypto';\n3\timport { readFileSync, readdirSync } from 'fs';\n4\timport { resolve, dirname } from 'path';\n5\timport { fileURLToPath } from 'url';\n6\timport { EventBus } from '../src/bus.js';\n7\timport { Events, OrderStatus, PaymentStatus } from '../src/types.js';\n8\timport { createCatalogService } from '../src/catalog/index.js';\n9\timport { createInventoryService } from '../src/inventory/index.js';\n10\timport { createCartService } from '../src/cart/index.js';\n11\timport { createPricingService } from '../src/pricing/index.js';\n12\timport { createOrderService } from '../src/orders/index.js';\n13\timport { createPaymentService } from '../src/payment/index.js';\n14\timport { createNotificationService } from '../src/notifications/index.js';\n15\timport { createAnalyticsService } from '../src/analytics/index.js';\n16\t\n17\tconst __filename = fileURLToPath(import.meta.url);\n18\tconst __dirname = dirname(__filename);\n19\tconst srcDir = resolve(__dirname, '..', 'src');\n20\t\n21\tfunction sha256(filePath: string): string {\n22\t  const content = readFileSync(filePath, 'utf-8');\n23\t  return createHash('sha256').update(content).digest('hex');\n24\t}\n25\t\n26\tdescribe('Integration Tests', () => {\n27\t  let bus: EventBus;\n28\t  let catalog: ReturnType<typeof createCatalogService>;\n29\t  let inventory: ReturnType<typeof createInventoryService>;\n30\t  let cart: ReturnType<typeof createCartService>;\n31\t  let pricing: ReturnType<typeof createPricingService>;\n32\t  let orders: ReturnType<typeof createOrderService>;\n33\t  let payment: ReturnType<typeof createPaymentService>;\n34\t  let notifications: ReturnType<typeof createNotificationService>;\n35\t  let analytics: ReturnType<typeof createAnalyticsService>;\n36\t\n37\t  beforeEach(() => {