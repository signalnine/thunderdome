index 0000000..b9cc16b
--- /dev/null
+++ b/src/notifications/index.ts
@@ -0,0 +1,51 @@
+import { EventBus } from '../bus.js';
+import {
+  NotificationService,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+  Events,
+} from '../types.js';
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const notifications = new Map<string, Array<{ type: string; message: string; timestamp: number }>>();
+  const orderToUser = new Map<string, string>();
+
+  function notify(userId: string, type: string, message: string): void {
+    if (!subscribers.has(userId)) return;
+    let userNotifications = notifications.get(userId);
+    if (!userNotifications) {
+      userNotifications = [];
+      notifications.set(userId, userNotifications);
+    }
+    userNotifications.push({ type, message, timestamp: Date.now() });
+    void bus.emit(Events.NOTIFICATION_SENT, { userId, type, message });
+  }
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const e = payload as OrderCreatedEvent;
+    orderToUser.set(e.orderId, e.userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    const e = payload as OrderStatusChangedEvent;
+    const userId = orderToUser.get(e.orderId);
+    if (userId) notify(userId, 'order_status', 'Order ' + e.orderId + ' status changed to ' + e.status);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const e = payload as PaymentProcessedEvent;
+    const userId = orderToUser.get(e.orderId);
+    if (userId) notify(userId, 'payment', 'Payment for order ' + e.orderId + ': ' + e.status);
+  });
+
+  return {
+    subscribe(userId: string): void {
+      subscribers.add(userId);
+    },
+    getNotifications(userId: string): Array<{ type: string; message: string; timestamp: number }> {
+      return notifications.get(userId) ?? [];
+    },
+  };
+}
