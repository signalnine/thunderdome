index 0000000..56ecf8a
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,248 @@
+import { deepClone, deepEqual } from './utils.js';
+import { mergeDocument } from './merge.js';
+import type { Version, MergeResult, Conflict } from './types.js';
+
+export type { Version, MergeResult, Conflict } from './types.js';
+export { mergeDocument } from './merge.js';
+
+interface DocRecord {
+  content: object;
+  versions: Version[];
+}
+
+/**
+ * A commit is an immutable snapshot of every document on a branch. Records and
+ * version arrays are shared between commits and replaced copy-on-write, so a
+ * commit's state never changes after creation.
+ */
+interface Commit {
+  id: number;
+  parents: Commit[];
+  state: Map<string, DocRecord>;
+}
+
+export class DocumentStore {
+  private commitCounter = 0;
+  private versionCounter = 0;
+  private branches = new Map<string, Commit>();
+  private currentBranch = 'main';
+
+  constructor() {
+    this.branches.set('main', this.newCommit([], new Map()));
+  }
+
+  // ---- Document CRUD ----
+
+  create(id: string, content: object): void {
+    const state = this.head().state;
+    if (state.has(id)) {
+      throw new Error(`Document "${id}" already exists on branch "${this.currentBranch}"`);
+    }
+    const version = this.newVersion(content);
+    this.commitState(this.withDoc(state, id, { content: deepClone(content), versions: [version] }));
+  }
+
+  get(id: string): object {
+    return deepClone(this.record(id).content);
+  }
+
+  update(id: string, content: object): void {
+    const state = this.head().state;
+    const existing = state.get(id);
+    if (!existing) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.currentBranch}"`);
+    }
+    const version = this.newVersion(content);
+    this.commitState(
+      this.withDoc(state, id, {
+        content: deepClone(content),
+        versions: [...existing.versions, version],
+      }),
+    );
+  }
+
+  delete(id: string): void {
+    const state = this.head().state;
+    if (!state.has(id)) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.currentBranch}"`);
+    }
+    const next = new Map(state);
+    next.delete(id);
+    this.commitState(next);
+  }
+
+  // ---- Version history ----
+
+  getHistory(id: string): Version[] {
+    return this.record(id).versions.map((v) => ({
+      id: v.id,
+      timestamp: v.timestamp,
+      content: deepClone(v.content),
+    }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const version = this.record(id).versions.find((v) => v.id === versionId);
+    if (!version) {
+      throw new Error(`Version "${versionId}" does not exist for document "${id}"`);
+    }
+    return deepClone(version.content);
+  }
+
+  // ---- Branching ----
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const from = fromBranch ?? this.currentBranch;
+    const fromHead = this.branches.get(from);
+    if (!fromHead) {
+      throw new Error(`Branch "${from}" does not exist`);
+    }
+    this.branches.set(name, fromHead);
+  }
+
+  switchBranch(name: string): void {
+    if (!this.branches.has(name)) {
+      throw new Error(`Branch "${name}" does not exist`);
+    }
+    this.currentBranch = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  // ---- Merging ----
+
+  merge(sourceBranch: string): MergeResult {
+    const theirHead = this.branches.get(sourceBranch);
+    if (!theirHead) {
+      throw new Error(`Branch "${sourceBranch}" does not exist`);
+    }
+    const ourHead = this.head();
+
+    if (sourceBranch === this.currentBranch || theirHead === ourHead) {
+      return { merged: this.contentsOf(ourHead.state), conflicts: [], applied: true };
+    }
+
+    const base = this.commonAncestor(ourHead, theirHead);
+
+    // Nothing new on the source branch: no-op fast-forward.
+    if (base === theirHead) {
+      return { merged: this.contentsOf(ourHead.state), conflicts: [], applied: true };
+    }
+
+    const baseState = base ? base.state : new Map<string, DocRecord>();
+    const ids = new Set<string>([
+      ...baseState.keys(),
+      ...ourHead.state.keys(),
+      ...theirHead.state.keys(),
+    ]);
+
+    const conflicts: Conflict[] = [];
+    const mergedState = new Map<string, DocRecord>();
+    for (const id of ids) {
+      const baseRec = baseState.get(id);
+      const ourRec = ourHead.state.get(id);
+      const theirRec = theirHead.state.get(id);
+      const outcome = mergeDocument(id, baseRec?.content, ourRec?.content, theirRec?.content);
+      conflicts.push(...outcome.conflicts);
+      if (outcome.content === undefined) continue;
+
+      if (ourRec && deepEqual(outcome.content, ourRec.content)) {
+        mergedState.set(id, ourRec);
+      } else if (theirRec && deepEqual(outcome.content, theirRec.content)) {
+        mergedState.set(id, theirRec);
+      } else {
+        const versions = ourRec?.versions ?? theirRec?.versions ?? [];
+        mergedState.set(id, {
+          content: outcome.content,
+          versions: [...versions, this.newVersion(outcome.content)],
+        });
+      }
+    }
+
+    const applied = conflicts.length === 0;
+    if (applied) {
+      this.branches.set(this.currentBranch, this.newCommit([ourHead, theirHead], mergedState));
+    }
+    return { merged: this.contentsOf(mergedState), conflicts, applied };
+  }
+
+  // ---- Internals ----
+
+  private head(): Commit {
+    const head = this.branches.get(this.currentBranch);
+    if (!head) {
+      throw new Error(`Branch "${this.currentBranch}" does not exist`);
+    }
+    return head;
+  }
+
+  private record(id: string): DocRecord {
+    const record = this.head().state.get(id);
+    if (!record) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.currentBranch}"`);
+    }
+    return record;
+  }
+
+  private newVersion(content: object): Version {
+    return { id: `v${++this.versionCounter}`, timestamp: Date.now(), content: deepClone(content) };
+  }
+
+  private newCommit(parents: Commit[], state: Map<string, DocRecord>): Commit {
+    return { id: this.commitCounter++, parents, state };
+  }
+
+  private commitState(state: Map<string, DocRecord>): void {
+    this.branches.set(this.currentBranch, this.newCommit([this.head()], state));
+  }
+
+  private withDoc(state: Map<string, DocRecord>, id: string, record: DocRecord): Map<string, DocRecord> {
+    const next = new Map(state);
+    next.set(id, record);
+    return next;
+  }
+
+  private contentsOf(state: Map<string, DocRecord>): Record<string, object> {
+    const result: Record<string, object> = {};
+    for (const [id, record] of state) {
+      result[id] = deepClone(record.content);
+    }
+    return result;
+  }
+
+  /**
+   * Lowest common ancestor of two commits: BFS outward from `b`, returning the
+   * first commit that is also an ancestor of `a` (closest to the branch tips).
+   */
+  private commonAncestor(a: Commit, b: Commit): Commit | undefined {
+    const ancestorsOfA = new Set<Commit>();
+    const stack: Commit[] = [a];
+    while (stack.length) {
+      const commit = stack.pop()!;
+      if (ancestorsOfA.has(commit)) continue;
+      ancestorsOfA.add(commit);
+      stack.push(...commit.parents);
+    }
+    const queue: Commit[] = [b];
+    const seen = new Set<Commit>();
+    while (queue.length) {
+      const commit = queue.shift()!;
+      if (seen.has(commit)) continue;
+      seen.add(commit);
+      if (ancestorsOfA.has(commit)) return commit;
+      queue.push(...commit.parents);
+    }
+    return undefined;
+  }
+}
+
+export default DocumentStore;
