@@ -0,0 +1,142 @@
+import { isPlainObject, deepClone, deepEqual } from './utils.js';
+import type { Conflict } from './types.js';
+
+/** Result of merging a single document: the merged content plus any conflicts encountered. */
+export interface DocMergeOutcome {
+  /** Merged content; `undefined` means the document is absent/deleted in the merge result. */
+  content: object | undefined;
+  /** Conflicts found during the merge, resolved in favour of "ours" in `content`. */
+  conflicts: Conflict[];
+}
+
+/**
+ * Three-way structural merge of a JSON document.
+ *
+ * `base` is the common ancestor, `ours` the current branch, `theirs` the source
+ * branch; `undefined` on any side means the document does not exist there.
+ * Conflicts are reported but always resolved in favour of "ours" in the returned
+ * content, so the merge never fails.
+ */
+export function mergeDocument(
+  documentId: string,
+  base: object | undefined,
+  ours: object | undefined,
+  theirs: object | undefined,
+): DocMergeOutcome {
+  // 1. Both sides agree (both deleted, both added identically, both changed identically, unchanged).
+  if (deepEqual(ours, theirs)) {
+    return { content: ours === undefined ? undefined : deepClone(ours), conflicts: [] };
+  }
+
+  // 2. Only our side changed.
+  if (deepEqual(theirs, base)) {
+    return { content: ours === undefined ? undefined : deepClone(ours), conflicts: [] };
+  }
+
+  // 3. Only their side changed.
+  if (deepEqual(ours, base)) {
+    return { content: theirs === undefined ? undefined : deepClone(theirs), conflicts: [] };
+  }
+
+  // 4. Both sides changed differently.
+  // 4a. Delete-vs-modify, or a shape we cannot descend into: whole-document conflict.
+  if (!isPlainObject(ours) || !isPlainObject(theirs)) {
+    const conflict: Conflict = {
+      documentId,
+      path: '',
+      base: base === undefined ? undefined : deepClone(base),
+      ours: ours === undefined ? undefined : deepClone(ours),
+      theirs: theirs === undefined ? undefined : deepClone(theirs),
+    };
+    return { content: ours === undefined ? undefined : deepClone(ours), conflicts: [conflict] };
+  }
+
+  // 4b. Both sides are plain objects: merge key by key.
+  const baseObject = isPlainObject(base) ? (base as Record<string, unknown>) : {};
+  const conflicts: Conflict[] = [];
+  const content = mergeObjects(
+    documentId,
+    baseObject,
+    ours as Record<string, unknown>,
+    theirs as Record<string, unknown>,
+    '',
+    conflicts,
+  );
+  return { content, conflicts };
+}
+
+/**
+ * Recursively merges three plain objects, appending any conflicts to `conflicts`.
+ * `prefix` is the dotted path of the objects being merged ('' at the document root).
+ * Arrays and scalars are treated as atomic values (no element-wise merge).
+ */
+function mergeObjects(
+  documentId: string,
+  base: Record<string, unknown>,
+  ours: Record<string, unknown>,
+  theirs: Record<string, unknown>,
+  prefix: string,
+  conflicts: Conflict[],
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  // Ours' keys first, then anything only present in theirs/base, for a stable key order.
+  const keys: string[] = Object.keys(ours);
+  const seen = new Set(keys);
+  for (const key of [...Object.keys(theirs), ...Object.keys(base)]) {
+    if (!seen.has(key)) {
+      seen.add(key);
+      keys.push(key);
+    }
+  }
+
+  for (const key of keys) {
+    const b = Object.prototype.hasOwnProperty.call(base, key) ? base[key] : undefined;
+    const o = Object.prototype.hasOwnProperty.call(ours, key) ? ours[key] : undefined;
+    const t = Object.prototype.hasOwnProperty.call(theirs, key) ? theirs[key] : undefined;
+    const childPath = prefix ? `${prefix}.${key}` : key;
+
+    // Both sides agree on this key.
+    if (deepEqual(o, t)) {
+      if (o !== undefined) result[key] = deepClone(o);
+      continue;
+    }
+
+    // Only we touched this key (their value still matches base).
+    if (deepEqual(t, b)) {
+      if (o !== undefined) result[key] = deepClone(o);
+      continue;
+    }
+
+    // Only they touched this key.
+    if (deepEqual(o, b)) {
+      if (t !== undefined) result[key] = deepClone(t);
+      continue;
+    }
+
+    // Both changed: descend if all three sides are plain objects.
+    if (isPlainObject(b) && isPlainObject(o) && isPlainObject(t)) {
+      result[key] = mergeObjects(
+        documentId,
+        b as Record<string, unknown>,
+        o as Record<string, unknown>,
+        t as Record<string, unknown>,
+        childPath,
+        conflicts,
+      );
+      continue;
+    }
+
+    // Otherwise the values are atomic and incompatible: record a conflict, keep ours.
+    conflicts.push({
+      documentId,
+      path: childPath,
+      base: b === undefined ? undefined : deepClone(b),
+      ours: o === undefined ? undefined : deepClone(o),
+      theirs: t === undefined ? undefined : deepClone(t),
+    });
+    if (o !== undefined) result[key] = deepClone(o);
+  }
+
+  return result;
+}
