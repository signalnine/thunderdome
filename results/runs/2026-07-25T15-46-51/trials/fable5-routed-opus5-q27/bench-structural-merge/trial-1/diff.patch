ap(h => h.id));\n    expect(ids.size).toBe(3);\n  });\n\n  it('getVersion returns content at that version', () => {\n    const store = new DocumentStore();\n    store.create('a', { v: 1 });\n    store.update('a', { v: 2 });\n    const history = store.getHistory('a');\n    expect(store.getVersion('a', history[0].id)).toEqual({ v: 1 });\n    expect(store.getVersion('a', history[1].id)).toEqual({ v: 2 });\n  });\n\n  it('getVersion throws for unknown version id', () => {\n    const store = new DocumentStore();\n    store.create('a', { v: 1 });\n    expect(() => store.getVersion('a', 'bogus')).toThrow();\n  });\n});\n\ndescribe('branching', () => {\n  it('default branch is main', () => {\n    const store = new DocumentStore();\n    expect(store.getBranch()).toBe('main');\n  });\n\n  it('createBranch and switchBranch', () => {\n    const store = new DocumentStore();\n    store.create('a', { x: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    expect(store.getBranch()).toBe('feature');\n    expect(store.get('a')).toEqual({ x: 1 });\n    const branches = store.listBranches();\n    expect(branches).toContain('main');\n    expect(branches).toContain('feature');\n  });\n\n  it('changes on one branch are not visible on another', () => {\n    const store = new DocumentStore();\n    store.create('a', { x: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('a', { x: 2 });\n    store.create('b', { y: 1 });\n    store.switchBranch('main');\n    expect(store.get('a')).toEqual({ x: 1 });\n    expect(() => store.get('b')).toThrow();\n  });\n\n  it('createBranch from a named branch', () => {\n    const store = new DocumentStore();\n    store.create('a', { x: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('a', { x: 2 });\n    store.switchBranch('main');\n    store.createBranch('other', 'feature');\n    store.switchBranch('other');\n    expect(store.get('a')).toEqual({ x: 2 });\n  });\n\n  it('createBranch throws if name exists', () => {\n    const store = new DocumentStore();\n    store.createBranch('feature');\n    expect(() => store.createBranch('feature')).toThrow();\n  });\n\n  it('switchBranch throws for unknown branch', () => {\n    const store = new DocumentStore();\n    expect(() => store.switchBranch('nope')).toThrow();\n  });\n});\n\ndescribe('merging', () => {\n  it('non-overlapping field changes merge cleanly', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: 1, b: 2 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { a: 10, b: 2 });\n    store.switchBranch('main');\n    store.update('doc', { a: 1, b: 20 });\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n    expect(result.merged['doc']).toEqual({ a: 10, b: 20 });\n    expect(store.get('doc')).toEqual({ a: 10, b: 20 });\n  });\n\n  it('both sides changing a field to the same value is not a conflict', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { a: 5 });\n    store.switchBranch('main');\n    store.update('doc', { a: 5 });\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n    expect(store.get('doc')).toEqual({ a: 5 });\n  });\n\n  it('conflicting change to the same field', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { a: 2 });\n    store.switchBranch('main');\n    store.update('doc', { a: 3 });\n    const result = store.merge('feature');\n    expect(result.applied).toBe(false);\n    expect(result.conflicts.length).toBe(1);\n    const c = result.conflicts[0];\n    expect(c.documentId).toBe('doc');\n    expect(c.path).toBe('a');\n    expect(c.base).toBe(1);\n    expect(c.ours).toBe(3);\n    expect(c.theirs).toBe(2);\n    expect(result.merged['doc']).toEqual({ a: 3 });\n    expect(store.get('doc')).toEqual({ a: 3 });\n  });\n\n  it('nested conflict paths use dot notation', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: { b: { c: 1 } }, other: 0 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { a: { b: { c: 2 } }, other: 0 });\n    store.switchBranch('main');\n    store.update('doc', { a: { b: { c: 3 } }, other: 0 });\n    const result = store.merge('feature');\n    expect(result.applied).toBe(false);\n    expect(result.conflicts.length).toBe(1);\n    expect(result.conflicts[0].path).toBe('a.b.c');\n    expect(result.conflicts[0].base).toBe(1);\n    expect(result.conflicts[0].ours).toBe(3);\n    expect(result.conflicts[0].theirs).toBe(2);\n  });\n\n  it('nested non-overlapping changes merge', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: { x: 1, y: 2 } });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { a: { x: 100, y: 2 } });\n    store.switchBranch('main');\n    store.update('doc', { a: { x: 1, y: 200 } });\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(store.get('doc')).toEqual({ a: { x: 100, y: 200 } });\n  });\n\n  it('document added only on source branch is brought over', () => {\n    const store = new DocumentStore();\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.create('newdoc', { v: 1 });\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(store.get('newdoc')).toEqual({ v: 1 });\n    expect(result.merged['newdoc']).toEqual({ v: 1 });\n  });\n\n  it('changes to different documents merge with no conflicts', () => {\n    const store = new DocumentStore();\n    store.create('d1', { v: 1 });\n    store.create('d2', { v: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('d1', { v: 10 });\n    store.switchBranch('main');\n    store.update('d2', { v: 20 });\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n    expect(store.get('d1')).toEqual({ v: 10 });\n    expect(store.get('d2')).toEqual({ v: 20 });\n  });\n\n  it('merge with no changes on either side is a no-op', () => {\n    const store = new DocumentStore();\n    store.create('doc', { v: 1 });\n    store.createBranch('feature');\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n    expect(store.get('doc')).toEqual({ v: 1 });\n  });\n\n  it('deletion on one side only is applied', () => {\n    const store = new DocumentStore();\n    store.create('doc', { v: 1 });\n    store.create('keep', { k: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.delete('doc');\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(() => store.get('doc')).toThrow();\n    expect(store.get('keep')).toEqual({ k: 1 });\n  });\n\n  it('delete versus modify is a conflict and not applied', () => {\n    const store = new DocumentStore();\n    store.create('doc', { v: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { v: 2 });\n    store.switchBranch('main');\n    store.delete('doc');\n    const result = store.merge('feature');\n    expect(result.applied).toBe(false);\n    expect(result.conflicts.length).toBe(1);\n    expect(result.conflicts[0].documentId).toBe('doc');\n    expect(() => store.get('doc')).toThrow();\n  });\n\n  it('merge throws for unknown source branch', () => {\n    const store = new DocumentStore();\n    expect(() => store.merge('nope')).toThrow();\n  });\n\n  it('array fields are atomic', () => {\n    const store = new DocumentStore();\n    store.create('doc', { list: [1, 2] });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { list: [1, 2, 3] });\n    store.switchBranch('main');\n    store.update('doc', { list: [9] });\n    const result = store.merge('feature');\n    expect(result.applied).toBe(false);\n    expect(result.conflicts[0].path).toBe('list');\n    expect(result.conflicts[0].ours).toEqual([9]);\n    expect(result.conflicts[0].theirs).toEqual([1, 2, 3]);\n  });\n\n  it('merged branch history allows further merges', () => {\n    const store = new DocumentStore();\n    store.create('doc', { a: 1, b: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc', { a: 2, b: 1 });\n    store.switchBranch('main');\n    const result1 = store.merge('feature');\n    expect(result1.applied).toBe(true);\n    store.switchBranch('feature');\n    store.update('doc', { a: 2, b: 2 });\n    store.switchBranch('main');\n    const result2 = store.merge('feature');\n    expect(result2.applied).toBe(true);\n    expect(store.get('doc')).toEqual({ a: 2, b: 2 });\n  });\n});\n","numLines":331,"startLine":1,"totalLines":331}}}
