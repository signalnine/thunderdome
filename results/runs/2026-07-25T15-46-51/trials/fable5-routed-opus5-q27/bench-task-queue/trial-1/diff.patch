+import { randomUUID } from 'node:crypto';
+
+export type TaskStatus =
+  | 'pending'
+  | 'processing'
+  | 'completed'
+  | 'failed'
+  | 'cancelled';
+
+/* eslint-disable @typescript-eslint/no-explicit-any */
+export type TaskPayload = any;
+/* eslint-enable @typescript-eslint/no-explicit-any */
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface Task {
+  id: string;
+  payload: TaskPayload;
+  status: TaskStatus;
+  createdAt: Date;
+  availableAt: Date;
+  priority: number;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  queueName: string;
+  dependsOn: string[];
+  lastError?: string;
+  failCount: number;
+  seq: number;
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: TaskStatus;
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type ProgressCallback = (info: ProgressInfo) => void;
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: TaskPayload;
+  active: boolean;
+}
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+export type TaskHandler = (task: Task) => void | Promise<void>;
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+export type ShutdownCallback = () => void;
+
+interface ShutdownState {
+  outstanding: Set<string>;
+  completed: number;
+  cancelled: number;
+  start: number;
+  timer: ReturnType<typeof setTimeout> | null;
+  resolve: (summary: ShutdownSummary) => void;
+}
+
+function nextCronTime(cronExpression: string, afterMs: number): number {
+  const parts = cronExpression.split(/\s+/);
+  if (parts.length !== 5) {
+    throw new Error('Unsupported cron expression: ' + cronExpression);
+  }
+  const m = parts[0];
+  const h = parts[1];
+  if (parts[2] !== '*' || parts[3] !== '*' || parts[4] !== '*') {
+    throw new Error('Unsupported cron expression: ' + cronExpression);
+  }
+  let matcher: (date: Date) => boolean;
+  const starSlashMatch = m.match(/^\*\/(\d+)$/);
+  if (starSlashMatch && h === '*') {
+    const n = parseInt(starSlashMatch[1], 10);
+    if (n <= 0) {
+      throw new Error('Unsupported cron expression: ' + cronExpression);
+    }
+    matcher = (date: Date) => date.getUTCMinutes() % n === 0;
+  } else if (m === '0' && h === '*') {
+    matcher = (date: Date) => date.getUTCMinutes() === 0;
+  } else if (m === '0' && h === '0') {
+    matcher = (date: Date) => date.getUTCMinutes() === 0 && date.getUTCHours() === 0;
+  } else {
+    throw new Error('Unsupported cron expression: ' + cronExpression);
+  }
+  const start = Math.floor(afterMs / 60000) + 1;
+  for (let i = 0; i <= 1441; i++) {
+    const t = (start + i) * 60000;
+    if (matcher(new Date(t))) {
+      return t;
+    }
+  }
+  throw new Error('No next cron time found');
+}
+
+export class TaskQueue {
+  private tasks = new Map<string, Task>();
+  private queues = new Map<string, Task[]>();
+  private dlqs = new Map<string, Task[]>();
+  private concurrencyLimits = new Map<string, number>();
+  private processing = new Set<string>();
+  private progress = new Map<string, ProgressInfo>();
+  private progressListeners = new Map<string, Set<ProgressCallback>>();
+  private schedules = new Map<string, Schedule>();
+  private scheduleNextDue = new Map<string, number>();
+  private middlewares = new Map<string, Middleware[]>();
+  private shutdownCallbacks: ShutdownCallback[] = [];
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private shutdownState: ShutdownState | null = null;
+  private seqCounter = 0;
+
+  // ---- Phase 1 & 2: basic queue operations ----
+
+  enqueue(payload: TaskPayload): Task;
+  enqueue(queueName: string, payload: TaskPayload, options?: EnqueueOptions): Task;
+  enqueue(
+    queueNameOrPayload: string | TaskPayload,
+    maybePayload?: TaskPayload,
+    options: EnqueueOptions = {}
+  ): Task {
+    if (this.shutdownPromise) {
+      throw new Error('Queue is shutting down; enqueue is not allowed');
+    }
+
+    let queueName: string;
+    let payload: TaskPayload;
+    if (typeof queueNameOrPayload === 'string') {
+      queueName = queueNameOrPayload;
+      payload = maybePayload;
+    } else {
+      queueName = 'default';
+      payload = queueNameOrPayload;
+    }
+
+    const priority = options.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error(`Priority must be between 1 and 10, got ${priority}`);
+    }
+
+    const dependsOn = options.dependsOn ?? [];
+    for (const depId of dependsOn) {
+      if (!this.tasks.has(depId)) {
+        throw new Error(`Dependency task not found: ${depId}`);
+      }
+    }
+    this.assertNoCycle(dependsOn);
+
+    const now = Date.now();
+    let availableAt: Date;
+    if (options.runAt !== undefined) {
+      availableAt = new Date(options.runAt.getTime());
+    } else if (options.delay !== undefined) {
+      availableAt = new Date(now + options.delay);
+    } else {
+      availableAt = new Date(now);
+    }
+
+    const task: Task = {
+      id: randomUUID(),
+      payload,
+      status: 'pending',
+      createdAt: new Date(now),
+      availableAt,
+      priority,
+      attempts: 0,
+      maxRetries: options.maxRetries ?? 3,
+      backoffMs: options.backoffMs ?? 1000,
+      queueName,
+      dependsOn,
+      failCount: 0,
+      seq: this.seqCounter++,
+    };
+
+    this.tasks.set(task.id, task);
+    this.getQueue(queueName).push(task);
+    return task;
+  }
+
+  dequeue(queueName = 'default'): Task | null {
+    const queue = this.queues.get(queueName);
+    if (!queue) {
+      return null;
+    }
+
+    const limit = this.concurrencyLimits.get(queueName) ?? Infinity;
+    if (this.processingCount(queueName) >= limit) {
+      return null;
+    }
+
+    const now = Date.now();
+    let best: Task | null = null;
+    let bestIndex = -1;
+    for (let i = 0; i < queue.length; i++) {
+      const task = queue[i];
+      if (task.status !== 'pending') continue;
+      if (task.availableAt.getTime() > now) continue;
+      if (!this.dependenciesCompleted(task)) continue;
+      if (
+        best === null ||
+        task.priority < best.priority ||
+        (task.priority === best.priority &&
+          task.availableAt.getTime() < best.availableAt.getTime()) ||
+        (task.priority === best.priority &&
+          task.availableAt.getTime() === best.availableAt.getTime() &&
+          task.seq < best.seq)
+      ) {
+        best = task;
+        bestIndex = i;
+      }
+    }
+
+    if (best === null) {
+      return null;
+    }
+
+    queue.splice(bestIndex, 1);
+    best.status = 'processing';
+    best.attempts += 1;
+    this.processing.add(best.id);
+    return best;
+  }
+
+  size(queueName = 'default'): number {
+    return this.queueSize(queueName);
+  }
+
+  queueSize(queueName: string): number {
+    const queue = this.queues.get(queueName);
+    if (!queue) return 0;
+    return queue.filter((t) => t.status === 'pending').length;
+  }
+
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  // ---- Phase 5: completion, failure and retries ----
+
+  complete(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task || task.status !== 'processing') return;
+    task.status = 'completed';
+    this.processing.delete(taskId);
+    this.settleDuringShutdown(taskId, 'completed');
+  }
+
+  fail(taskId: string, error?: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    task.lastError = error;
+    task.failCount += 1;
+    this.processing.delete(taskId);
+
+    if (this.shutdownState && this.shutdownState.outstanding.has(taskId)) {
+      task.status = 'failed';
+      this.settleDuringShutdown(taskId, 'failed');
+      return;
+    }
+
+    if (task.attempts <= task.maxRetries) {
+      // Retries remain: re-enqueue with exponential backoff.
+      const delay = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + delay);
+      this.getQueue(task.queueName).push(task);
+    } else {
+      task.status = 'failed';
+      this.getDlq(task.queueName).push(task);
+    }
+  }
+
+  // ---- Phase 6: dead letter queue ----
+
+  getDLQ(queueName: string): Task[] {
+    return [...this.getDlq(queueName)];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    for (const dlq of this.dlqs.values()) {
+      const index = dlq.findIndex((t) => t.id === taskId);
+      if (index !== -1) {
+        const task = dlq[index];
+        dlq.splice(index, 1);
+        task.status = 'pending';
+        task.attempts = 0;
+        task.availableAt = new Date(Date.now());
+        this.getQueue(task.queueName).push(task);
+        return task;
+      }
+    }
+    return null;
+  }
+
+  clearDLQ(queueName: string): void {
+    this.dlqs.set(queueName, []);
+  }
+
+  // ---- Phase 7: dependencies ----
+
+  getDependencies(taskId: string): DependencyInfo[] {
+    const task = this.tasks.get(taskId);
+    if (!task) {
+      throw new Error(`Task not found: ${taskId}`);
+    }
+    return task.dependsOn.map((depId) => {
+      const dep = this.tasks.get(depId);
+      return { taskId: depId, status: dep ? dep.status : 'failed' };
+    });
+  }
+
+  // ---- Phase 8: concurrency ----
+
+  setConcurrency(queueName: string, limit: number): void {
+    this.concurrencyLimits.set(queueName, limit);
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    return {
+      current: this.processingCount(queueName),
+      max: this.concurrencyLimits.get(queueName) ?? Infinity,
+    };
+  }
+
+  // ---- Phase 9: progress and cancellation ----
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error(`Progress percent must be between 0 and 100, got ${percent}`);
+    }
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    this.progress.set(taskId, info);
+    const listeners = this.progressListeners.get(taskId);
+    if (listeners) {
+      for (const listener of listeners) {
+        listener(info);
+      }
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progress.get(taskId) ?? null;
+  }
+
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    let listeners = this.progressListeners.get(taskId);
+    if (!listeners) {
+      listeners = new Set();
+      this.progressListeners.set(taskId, listeners);
+    }
+    listeners.add(callback);
+    return () => {
+      listeners.delete(callback);
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) return;
+
+    if (task.status === 'pending') {
+      const queue = this.queues.get(task.queueName);
+      if (queue) {
+        const index = queue.indexOf(task);
+        if (index !== -1) queue.splice(index, 1);
+      }
+      task.status = 'cancelled';
+    } else if (task.status === 'processing') {
+      task.status = 'cancelled';
+      this.processing.delete(taskId);
+      this.settleDuringShutdown(taskId, 'cancelled');
+    }
+  }
+
+  // ---- Phase 10: recurring tasks ----
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: TaskPayload): Schedule {
+    const nextDue = nextCronTime(cronExpression, Date.now());
+    const sched: Schedule = {
+      id: randomUUID(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+    };
+    this.schedules.set(sched.id, sched);
+    this.scheduleNextDue.set(sched.id, nextDue);
+    return sched;
+  }
+
+  unschedule(scheduleId: string): void {
+    const sched = this.schedules.get(scheduleId);
+    if (sched) sched.active = false;
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const all = [...this.schedules.values()].filter((s) => s.active);
+    return queueName === undefined ? all : all.filter((s) => s.queueName === queueName);
+  }
+
+  tick(): void {
+    const now = Date.now();
+    for (const sched of this.schedules.values()) {
+      if (!sched.active) continue;
+      const due = this.scheduleNextDue.get(sched.id);
+      if (due !== undefined && due <= now) {
+        this.enqueue(sched.queueName, sched.taskTemplate);
+        this.scheduleNextDue.set(sched.id, nextCronTime(sched.cronExpression, now));
+      }
+    }
+  }
+
+  // ---- Phase 11: middleware pipeline ----
+
+  use(queueName: string, middleware: Middleware): void {
+    let stack = this.middlewares.get(queueName);
+    if (!stack) {
+      stack = [];
+      this.middlewares.set(queueName, stack);
+    }
+    stack.push(middleware);
+  }
+
+  async process(queueName: string, handler: TaskHandler): Promise<void> {
+    for (;;) {
+      const task = this.dequeue(queueName);
+      if (task === null) break;
+      const stack = this.middlewares.get(queueName) ?? [];
+      const run = (index: number): Promise<void> => {
+        if (index < stack.length) {
+          return Promise.resolve(stack[index](task, () => run(index + 1)));
+        }
+        return Promise.resolve(handler(task));
+      };
+      try {
+        await run(0);
+        this.complete(task.id);
+      } catch (err) {
+        this.fail(task.id, err instanceof Error ? err.message : String(err));
+      }
+    }
+  }
+
+  // ---- Phase 12: graceful shutdown ----
+
+  onShutdown(callback: ShutdownCallback): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  shutdown(timeout = 30000): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) {
+      return this.shutdownPromise;
+    }
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      for (const callback of this.shutdownCallbacks) {
+        callback();
+      }
+
+      const start = Date.now();
+      const outstanding = new Set(this.processing);
+      const state: ShutdownState = {
+        outstanding,
+        completed: 0,
+        cancelled: 0,
+        start,
+        timer: null,
+        resolve,
+      };
+      this.shutdownState = state;
+
+      if (outstanding.size === 0) {
+        resolve({ completed: 0, cancelled: 0, elapsed: Date.now() - start });
+        return;
+      }
+
+      state.timer = setTimeout(() => {
+        for (const id of [...outstanding]) {
+          const task = this.tasks.get(id);
+          if (task && task.status === 'processing') {
+            task.status = 'cancelled';
+          }
+          this.processing.delete(id);
+          state.cancelled += 1;
+        }
+        outstanding.clear();
+        resolve({
+          completed: state.completed,
+          cancelled: state.cancelled,
+          elapsed: Date.now() - start,
+        });
+      }, timeout);
+    });
+
+    return this.shutdownPromise;
+  }
+
+  // ---- internals ----
+
+  private getQueue(queueName: string): Task[] {
+    let queue = this.queues.get(queueName);
+    if (!queue) {
+      queue = [];
+      this.queues.set(queueName, queue);
+    }
+    return queue;
+  }
+
+  private getDlq(queueName: string): Task[] {
+    let dlq = this.dlqs.get(queueName);
+    if (!dlq) {
+      dlq = [];
+      this.dlqs.set(queueName, dlq);
+    }
+    return dlq;
+  }
+
+  private processingCount(queueName: string): number {
+    let count = 0;
+    for (const id of this.processing) {
+      const task = this.tasks.get(id);
+      if (task && task.queueName === queueName) count += 1;
+    }
+    return count;
+  }
+
+  private dependenciesCompleted(task: Task): boolean {
+    return task.dependsOn.every((depId) => this.tasks.get(depId)?.status === 'completed');
+  }
+
+  private assertNoCycle(dependsOn: string[]): void {
+    // Dependencies must already exist, so a new task cannot introduce a
+    // back-edge; this guards against cycles in the existing dependency graph
+    // reachable from the new task's dependencies.
+    const visiting = new Set<string>();
+    const visited = new Set<string>();
+    const visit = (id: string): void => {
+      if (visited.has(id)) return;
+      if (visiting.has(id)) {
+        throw new Error('Circular dependency detected');
+      }
+      visiting.add(id);
+      const task = this.tasks.get(id);
+      if (task) {
+        for (const depId of task.dependsOn) {
+          visit(depId);
+        }
+      }
+      visiting.delete(id);
+      visited.add(id);
+    };
+    for (const depId of dependsOn) {
+      visit(depId);
+    }
+  }
+
+  private settleDuringShutdown(taskId: string, outcome: 'completed' | 'failed' | 'cancelled'): void {
+    const state = this.shutdownState;
+    if (!state || !state.outstanding.has(taskId)) return;
+    state.outstanding.delete(taskId);
+    if (outcome === 'completed') state.completed += 1;
+    if (outcome === 'cancelled') state.cancelled += 1;
+    if (state.outstanding.size === 0) {
+      if (state.timer !== null) clearTimeout(state.timer);
+      state.resolve({
+        completed: state.completed,
+        cancelled: state.cancelled,
+        elapsed: Date.now() - state.start,
+      });
+    }
+  }
+}
