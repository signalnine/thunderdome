+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EwWY3aZhY6yWerQnSzxeqo","type":"tool_result","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 1: Basic FIFO Queue', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('enqueue returns a task with id and pending status', () => {\n    const task = queue.enqueue('default', { type: 'email', to: 'user@test.com' });\n    expect(task).toHaveProperty('id');\n    expect(typeof task.id).toBe('string');\n    expect(task.id.length).toBeGreaterThan(0);\n    expect(task.status).toBe('pending');\n    expect(task.payload).toEqual({ type: 'email', to: 'user@test.com' });\n  });\n\n  it('dequeue returns tasks in FIFO order', () => {\n    queue.enqueue('default', { order: 1 });\n    queue.enqueue('default', { order: 2 });\n    queue.enqueue('default', { order: 3 });\n\n    const first = queue.dequeue('default');\n    const second = queue.dequeue('default');\n    const third = queue.dequeue('default');\n\n    expect(first!.payload).toEqual({ order: 1 });\n    expect(second!.payload).toEqual({ order: 2 });\n    expect(third!.payload).toEqual({ order: 3 });\n  });\n\n  it('dequeue returns null when queue is empty', () => {\n    const result = queue.dequeue('default');\n    expect(result).toBeNull();\n  });\n\n  it('size returns the correct count of pending tasks', () => {\n    expect(queue.size()).toBe(0);\n    queue.enqueue('default', { a: 1 });\n    queue.enqueue('default', { a: 2 });\n    expect(queue.size()).toBe(2);\n    queue.dequeue('default');\n    expect(queue.size()).toBe(1);\n  });\n\n  it('dequeued task has processing status', () => {\n    queue.enqueue('default', { job: 'process' });\n    const task = queue.dequeue('default');\n    expect(task!.status).toBe('processing');\n  });\n\n  it('task has a createdAt timestamp', () => {\n    const before = new Date();\n    c