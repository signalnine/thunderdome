rrency('work');\n    expect(info3.current).toBe(2);\n  });\n\n  it('default concurrency is unlimited', () => {\n    for (let i = 0; i < 100; i++) {\n      queue.enqueue('work', { job: i });\n    }\n\n    const tasks = [];\n    for (let i = 0; i < 100; i++) {\n      const t = queue.dequeue('work');\n      if (!t) break;\n      tasks.push(t);\n    }\n\n    expect(tasks.length).toBe(100);\n  });\n\n  it('concurrency limits are independent per queue', () => {\n    queue.setConcurrency('queue-a', 1);\n    queue.setConcurrency('queue-b', 2);\n\n    queue.enqueue('queue-a', { q: 'a1' });\n    queue.enqueue('queue-a', { q: 'a2' });\n    queue.enqueue('queue-b', { q: 'b1' });\n    queue.enqueue('queue-b', { q: 'b2' });\n    queue.enqueue('queue-b', { q: 'b3' });\n\n    queue.dequeue('queue-a'); // 1 processing in queue-a\n    expect(queue.dequeue('queue-a')).toBeNull(); // at limit for queue-a\n\n    queue.dequeue('queue-b'); // 1 processing in queue-b\n    expect(queue.dequeue('queue-b')).not.toBeNull(); // can still dequeue (limit 2)\n    expect(queue.dequeue('queue-b')).toBeNull(); // now at limit\n  });\n\n  it('concurrency respects priority ordering', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { name: 'low' }, { priority: 9 });\n    queue.enqueue('work', { name: 'high' }, { priority: 1 });\n\n    const task = queue.dequeue('work')!;\n    expect(task.payload).toEqual({ name: 'high' });\n  });\n});\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 9: Progress and Cancellation', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('updateProgress sets the percentage for a task', () => {\n    queue.enqueue('work', { job: 'progress' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 50);\n    const 