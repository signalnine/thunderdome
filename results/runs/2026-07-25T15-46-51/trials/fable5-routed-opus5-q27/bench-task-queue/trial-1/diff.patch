+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R2bbjnZbj35HfpRJ1euQv1","type":"tool_result","content":"import { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 4: Delayed/Scheduled Tasks', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('delayed task is not available immediately', () => {\n    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n    const task = queue.dequeue('work');\n    expect(task).toBeNull();\n  });\n\n  it('delayed task becomes available after delay period', () => {\n    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n\n    vi.advanceTimersByTime(5000);\n\n    const task = queue.dequeue('work');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({ delayed: true });\n  });\n\n  it('runAt task is not available before the specified time', () => {\n    const futureDate = new Date(Date.now() + 10000);\n    queue.enqueue('work', { scheduled: true }, { runAt: futureDate });\n\n    const task = queue.dequeue('work');\n    expect(task).toBeNull();\n  });\n\n  it('runAt task becomes available at the specified time', () => {\n    const futureDate = new Date(Date.now() + 10000);\n    queue.enqueue('work', { scheduled: true }, { runAt: futureDate });\n\n    vi.advanceTimersByTime(10000);\n\n    const task = queue.dequeue('work');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({ scheduled: true });\n  });\n\n  it('non-delayed tasks dequeued before delayed tasks still waiting', () => {\n    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n    queue.enqueue('work', { immediate: true });\n\n    const task = queue.dequeue('work');\n    expect(task!.payload).toEqual({ immediate: true });\n  });\n\n  it('multiple delayed tasks ordered by availability time', () => {\n    queue.enqueue('work', { name: 'later' }, { delay: 10000 });\n    queue.enqueue('work', { name: 'sooner' }, { delay: 3000 });\n\n    vi.advanceTimersByTime(10000);\n\n    const first = queue.dequeue('work');\n    const second = queue.dequeue('work');\n\n    expect(first!.payload).toEqual({ name: 'sooner' });\n    expect(second!.payload).toEqual({ name: 'later' });\n  });\n\n  it('delay works with named queues', () => {\n    queue.enqueue('fast', { name: 'fast-delayed' }, { delay: 2000 });\n    queue.enqueue('slow', { name: 'slow-delayed' }, { delay: 8000 });\n\n    vi.advanceTimersByTime(2000);\n\n    expect(queue.dequeue('fast')).not.toBeNull();\n    expect(queue.dequeue('slow')).toBeNull();\n\n    vi.advanceTimersByTime(6000);\n\n    expect(queue.dequeue('slow')).not.toBeNull();\n  });\n});\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 5: Retry with Backoff', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('fail marks a processing task as failed', () => {\n    queue.enqueue('work', { job: 'test' }, { maxRetries: 0 });\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'something went wrong');\n\n    // With maxRetries: 0, no retry - task stays failed\n    expect(task.status).toBe('failed');\n  });\n\n  it('failed task is re-enqueued automatically when retries remain', () => {\n    queue.enqueue('work', { job: 'retry-me' });\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'transient error');\n\n    // After backoff delay, task should be available again\n    vi.advanceTimersByTime(1000); // first retry: 1000ms\n    const retried = queue.dequeue('work');\n    expect(retried).not.toBeNull();\n    expect(retried!.id).toBe(task.id);\n  });\n\n  it('task attempts count is incremented on each retry