 * 1000);\n    queue.tick();\n    expect(queue.dequeue('work')).toBeNull();\n\n    // Advance 2 more minutes (total 5) - should trigger\n    vi.advanceTimersByTime(2 * 60 * 1000);\n    queue.tick();\n    expect(queue.dequeue('work')).not.toBeNull();\n  });\n\n  it('scheduled task gets the correct queue and payload', () => {\n    queue.schedule('notifications', '*/1 * * * *', {\n      type: 'reminder',\n      message: 'Check your inbox',\n    });\n\n    vi.advanceTimersByTime(1 * 60 * 1000);\n    queue.tick();\n\n    const task = queue.dequeue('notifications');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({\n      type: 'reminder',\n      message: 'Check your inbox',\n    });\n\n    // Should not be in other queues\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('multiple schedules can coexist', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'every-5' });\n    queue.schedule('work', '*/10 * * * *', { type: 'every-10' });\n\n    // At 5 minutes, only every-5 triggers\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const tasks5 = [];\n    let t;\n    while ((t = queue.dequeue('work')) !== null) {\n      tasks5.push(t);\n    }\n    expect(tasks5.length).toBe(1);\n    expect(tasks5[0].payload).toEqual({ type: 'every-5' });\n\n    // At 10 minutes, both trigger\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const tasks10 = [];\n    while ((t = queue.dequeue('work')) !== null) {\n      tasks10.push(t);\n    }\n    expect(tasks10.length).toBe(2);\n    const types = tasks10.map(t => t.payload.type).sort();\n    expect(types).toEqual(['every-10', 'every-5']);\n  });\n});\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 11: Middleware Pipeline', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('middleware runs before task processing', async () => {\n    const log: string[] = [];\n\n    queue.use('work', async (_task, next) => {\n      log.push('middleware');\n      await next();\n    });\n\n    queue.enqueue('work', { job: 'test' });\n\n    await queue.process('work', async () => {\n      log.push('handler');\n    });\n\n    expect(log).toEqual(['middleware', 'handler']);\n  });\n\n  it('multiple middlewares run in the order they were added', async () => {\n    const log: string[] = [];\n\n    queue.use('work', async (_task, next) => {\n      log.push('first');\n      await next();\n    });\n\n    queue.use('work', async (_task, next) => {\n      log.push('second');\n      await next();\n    });\n\n    queue.use('work', async (_task, next) => {\n      log.push('third');\n      await next();\n    });\n\n    queue.enqueue('work', { job: 'test' });\n\n    await queue.process('work', async () => {\n      log.push('handler');\n    });\n\n    expect(log).toEqual(['first', 'second', 'third', 'handler']);\n  });\n\n  it('middleware can modify the task object', async () => {\n    queue.use('work', async (task, next) => {\n      task.payload.enriched = true;\n      task.payload.timestamp = '2025-01-01';\n      await next();\n    });\n\n    queue.enqueue('work', { job: 'enrich-me' });\n\n    let processedPayload: Record<string, unknown> | null = null;\n    await queue.process('work', async (task) => {\n      processedPayload = task.payload;\n    });\n\n    expect(processedPayload).toEqual({\n      job: 'enrich-me',\n      enriched: true,\n      timestamp: '2025-01-01',\n    });\n  });\n\n  it('middleware can skip processing by not calling next', async () => {\n    const log: string[] = [];\n\n    queue.use('work', async (_task, _next) => {\n      log.push('blocker');\n      // deliberately not calling next()\n    });\n\n    queue.enqueue('work', { job: 'blocked' });\n\n    await queue.process('work', async () => {\n      log.push('handler');\n    });\n\n    expect(log).toEqual(['blocker']);\n    expect(log).not.toContain('handler');\n  });\n\n  it('error in middleware fails the task', async () => {\n    queue.use('work', async (_task, _next) => {\n      throw new Error('middleware explosion');\n    });\n\n    const task = queue.enqueue('work', { job: 'explode' }, { maxRetries: 0 });\n\n    await queue.process('work', async () => {\n      // should not reach here\n    });\n\n    expect(task.status).toBe('failed');\n  });\n\n  it('middleware stacks are independent per queue', async () => {\n    const log: string[] = [];\n\n    queue.use('queue-a', async (_task, next) => {\n      log.push('a-middleware');\n      await next();\n    });\n\n    queue.use('queue-b', async (_task, next) => {\n      log.push('b-middleware');\n      await next();\n    });\n\n    queue.enqueue('queue-a', { job: 'a' });\n\n    await queue.process('queue-a', async () => {\n      log.push('a-handler');\n    });\n\n    expect(log).toEqual(['a-middleware', 'a-handler']);\n    expect(log).not.toContain('b-middleware');\n  });\n\n  it('middleware receives the task context', async () => {\n    let receivedTask: { id?: string; payload?: unknown; status?: string } | null = null;\n\n    queue.use('work', async (task, next) => {\n      receivedTask = task;\n      await next();\n    });\n\n    const enqueued = queue.enqueue('work', { job: 'context' });\n\n    await queue.process('work', async () => {});\n\n    expect(receivedTask).not.toBeNull();\n    expect(receivedTask!.id).toBe(enqueued.id);\n    expect(receivedTask!.payload).toEqual({ job: 'context' });\n  });\n});\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 12: Graceful Shutdown', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('shutdown stops accepting new tasks', async () => {\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    await shutdownPromise;\n\n    expect(() => queue.enqueue('work', { job: 'too-late' })).toThrow();\n  });\n\n  it('shutdown waits for processing tasks to complete', async () => {\n    queue.enqueue('work', { job: 'in-flight' });\n    const task = queue.dequeue('work')!;\n\n    let resolved = false;\n    const shutdownPromise = queue.shutdown(10000).then((summary) => {\n      resolved = true;\n      return summary;\n    });\n\n    // Shutdown should not resolve yet (task still processing)\n    vi.advanceTimersByTime(100);\n    await Promise.resolve(); // flush microtasks\n    expect(resolved).toBe(false);\n\n    // Complete the task\n    queue.complete(task.id);\n    vi.advanceTimersByTime(0);\n    const summary = await shutdownPromise;\n\n    expect(resolved).toBe(true);\n    expect(summary.completed).toBe(1);\n  });\n\n  it('shutdown force-cancels tasks after timeout', async () => {\n    queue.enqueue('work', { job: 'slow' });\n    const task = queue.dequeue('work')!;\n\n    const shutdownPromise = queue.shutdown(3000);\n\n    // Advance past timeout\n    vi.advanceTimersByTime(3000);\n    const summary = await shutdownPromise;\n\n    expect(summary.cancelled).toBe(1);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('onShutdown callback fires during shutdown', async () => {\n    const log: string[] = [];\n    queue.onShutdown(() => {\n      log.push('shutdown-hook');\n    });\n\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    await shutdownPromise;\n\n    expect(log).toContain('shutdown-hook');\n  });\n\n  it('shutdown returns summary with completed, cancelled, and elapsed', async () => {\n    queue.enqueue('work', { job: 'fast' });\n    queue.enqueue('work', { job: 'slow' });\n\n    const fast = queue.dequeue('work')!;\n    const _slow = queue.dequeue('work')!;\n\n    const shutdownPromise = queue.shutdown(5000);\n\n    // Complete 'fast' quickly\n    queue.complete(fast.id);\n\n    // Let 'slow' timeout (it gets force-cancelled)\n    vi.advanceTimersByTime(5000);\n    const summary = await shutdownPromise;\n\n    expect(summary.completed).toBe(1);\n    expect(summary.cancelled).toBe(1);\n    expect(typeof summary.elapsed).toBe('number');\n    expect(summary.elapsed).toBeGreaterThanOrEqual(0);\n  });\n\n  it('multiple shutdown calls are idempotent', async () => {\n    const p1 = queue.shutdown(5000);\n    const p2 = queue.shutdown(5000);\n\n    vi.advanceTimersByTime(0);\n    const [s1, s2] = await Promise.all([p1, p2]);\n\n    // Should return the same result\n    expect(s1).toEqual(s2);\n  });\n\n  it('enqueue after shutdown throws an error', async () => {\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    await shutdownPromise;\n\n    expect(() => queue.enqueue('work', { job: 'rejected' })).toThrow();\n  });\n\n  it('shutdown with no processing tasks resolves immediately', async () => {\n    queue.enqueue('work', { job: 'pending-only' });\n    // Don't dequeue - nothing is processing\n\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    const summary = await shutdownPromise;\n\n    expect(summary.completed).toBe(0);\n    expect(summary.cancelled).toBe(0);\n    expect(summary.elapsed).toBeLessThanOrEqual(100);\n  });\n});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
