const samples = sampleSet(n, rand);\n  for (let attempt = 0; attempt < 1000; attempt++) {\n    const picked = shuffle(outs, rand).slice(0, 8);\n    const pairs: Array<[string, string]> = [\n      [picked[0], picked[1]], [picked[2], picked[3]], [picked[4], picked[5]], [picked[6], picked[7]],\n    ];\n    let valid = true;\n    for (const pair of pairs) {\n      const c = applySwaps(gates, [pair]);\n      const v = simulate(c, toInputs(n, 0n, 0n));\n      if (!allZDefined(v, n)) { valid = false; break; }\n      if (addsCorrectly(c, n, samples)) { valid = false; break; }\n    }\n    if (!valid) continue;\n    const c4 = applySwaps(gates, pairs);\n    if (!allZDefined(simulate(c4, toInputs(n, 0n, 0n)), n)) continue;\n    if (addsCorrectly(c4, n, samples)) continue;\n    return pairs;\n  }\n  throw new Error('could not generate swaps');\n}\n\nit('debug randomized cases', () => {\n  for (const [n, seed] of [[12, 1], [24, 2], [45, 3], [45, 7]] as Array<[number, number]>) {\n    const rand = mulberry32(seed);\n    const base = buildAdder(n);\n    const pairs = randomSwapPairs(base, n, rand);\n    const swapped = applySwaps(base, pairs);\n    const t0 = performance.now();\n    let res: string[] | string;\n    try {\n      res = findSwappedWires(swapped);\n    } catch (e) {\n      res = `ERROR: ${(e as Error).message}`;\n    }\n    const dt = Math.round(performance.now() - t0);\n    const expected = pairs.flat().sort();\n    // eslint-disable-next-line no-console\n    console.log(`n=${n} seed=${seed} pairs=${JSON.stringify(pairs)} time=${dt}ms`);\n    // eslint-disable-next-line no-console\n    console.log(`  expected=${JSON.stringify(expected)}`);\n    // eslint-disable-next-line no-console\n    console.log(`  got     =${JSON.stringify(res)}`);\n  }\n}, 60000);\nEOF\nnpx vitest run debug/repro.test.ts 2>&1 | grep -E 'n=|expected=|got     =|stdout' | head -30","description":"Reproduce randomized failures with per-case debug output","timeout":180000},"caller":{"type":"direct"}