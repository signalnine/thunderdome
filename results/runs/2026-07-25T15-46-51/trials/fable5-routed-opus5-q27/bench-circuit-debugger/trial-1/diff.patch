+        const diff = values[zWire[j]] ^ lz[j];
+        if (diff !== 0) {
+          if (j < minFail) return null;
+          if (j < fail) fail = j;
+          if (zBad[j] === 0) {
+            zBad[j] = 1;
+            bad++;
+          }
+          miss += popcount(diff);
+        }
+      }
+    }
+    return { fail, bad, miss };
+  }
+
+  /** Symbolic role produced by a gate from its two input roles. */
+  private static combine(op: number, s1: number, s2: number): number {
+    if (s1 === ROLE_NONE || s2 === ROLE_NONE) return ROLE_NONE;
+    let k1 = s1 >>> 8;
+    let b1 = s1 & 0xff;
+    let k2 = s2 >>> 8;
+    let b2 = s2 & 0xff;
+    if (k1 > k2) {
+      const kt = k1;
+      k1 = k2;
+      k2 = kt;
+      const bt = b1;
+      b1 = b2;
+      b2 = bt;
+    }
+    if (op === OP_XOR) {
+      if (k1 === K_X && k2 === K_Y && b1 === b2) {
+        return b1 === 0 ? role(K_S, 0) : role(K_T, b1);
+      }
+      if (k1 === K_T && k2 === K_C && b1 === b2 + 1) return role(K_S, b1);
+    } else if (op === OP_AND) {
+      if (k1 === K_X && k2 === K_Y && b1 === b2) {
+        return b1 === 0 ? role(K_C, 0) : role(K_A, b1);
+      }
+      if (k1 === K_T && k2 === K_C && b1 === b2 + 1) return role(K_B, b1);
+    } else {
+      if (k1 === K_A && k2 === K_B && b1 === b2) return role(K_C, b1);
+    }
+    return ROLE_NONE;
+  }
+
+  /**
+   * Compute the exact symbolic role of every wire in the current circuit.
+   * Returns false for a cyclic circuit. The circuit is a correct adder iff
+   * every z_j ends up carrying zTarget[j].
+   */
+  private computeRoles(): boolean {
+    if (!this.topoSort()) return false;
+    const { roles, order, gOp, gIn1, gIn2, gOut } = this;
+    roles.fill(ROLE_NONE);
+    for (let i = 0; i < this.nBits; i++) {
+      roles[this.xWire[i]] = role(K_X, i);
+      roles[this.yWire[i]] = role(K_Y, i);
+    }
+    for (let k = 0; k < this.nGates; k++) {
+      const gi = order[k];
+      roles[gOut[gi]] = SwapFinder.combine(gOp[gi], roles[gIn1[gi]], roles[gIn2[gi]]);
+    }
+    return true;
+  }
+
+  /** True iff every z wire carries its target role (exact adder). */
+  private rolesPerfect(): boolean {
+    if (!this.computeRoles()) return false;
+    for (let j = 0; j < this.nOut; j++) {
+      if (this.roles[this.zWire[j]] !== this.zTarget[j]) return false;
+    }
+    return true;
+  }
+
+  /**
+   * Role-guided repair proposals for the lowest failing bit: figure out which
+   * wire currently carries the value that z_fail (or, recursively, one of the
+   * intermediate carry/propagate positions feeding it) is supposed to carry,
+   * and propose swapping it into place. Exact and gradient-free, so it works
+   * where no single swap improves the numeric score.
+   */
+  private proposals(failBit: number): {
+    primary: Array<[number, number]>;
+    secondary: Array<[number, number]>;
+  } {
+    const none: Array<[number, number]> = [];
+    if (!this.computeRoles()) return { primary: none, secondary: none };
+    const byRole = new Map<number, number>();
+    for (let w = 0; w < this.nWires; w++) {
+      if (this.roles[w] !== ROLE_NONE) byRole.set(this.roles[w], w);
+    }
+    const primary: Array<[number, number]> = [];
+    const secondary: Array<[number, number]> = [];
+    let sink = primary;
+    const propose = (a: number, b: number): void => {
+      if (a === b || this.used[a] || this.used[b]) return;
+      if (this.producer[a] < 0 || this.producer[b] < 0) return;
+      sink.push(a < b ? [a, b] : [b, a]);
+    };
+    const decompose = (r: number): [number, number, number] | null => {
+      const kind = r >>> 8;
+      const bit = r & 0xff;
+      if (kind === K_T) return [OP_XOR, role(K_X, bit), role(K_Y, bit)];
+      if (kind === K_A) return [OP_AND, role(K_X, bit), role(K_Y, bit)];
+      if (kind === K_S) {
+        if (bit === 0) return [OP_XOR, role(K_X, 0), role(K_Y, 0)];
+        return [OP_XOR, role(K_T, bit), role(K_C, bit - 1)];
+      }
+      if (kind === K_B) return [OP_AND, role(K_T, bit), role(K_C, bit - 1)];
+      if (kind === K_C) {
+        if (bit === 0) return [OP_AND, role(K_X, 0), role(K_Y, 0)];
+        return [OP_OR, role(K_A, bit), role(K_B, bit)];
+      }
+      return null;
+    };
+    // Find the wire carrying role r, recursively proposing repairs for the
+    // structure that should produce it when nothing carries it yet.
+    const need = (r: number, guard: number): number => {
+      const have = byRole.get(r);
+      if (have !== undefined) return have;
+      if (guard <= 0) return -1;
+      const parts = decompose(r);
+      if (!parts) return -1;
+      const [op, r1, r2] = parts;
+      const w1 = need(r1, guard - 1);
+      const w2 = need(r2, guard - 1);
+      // The gate that should compute r reads one of w1/w2 but is mis-fed on
+      // the other input: propose renaming that input's producer.
+      const scan = (whave: number, wneed: number): void => {
+        if (whave < 0 || wneed < 0) return;
+        for (let k = this.consumerStart[whave]; k < this.consumerStart[whave + 1]; k++) {
+          const gi = this.consumers[k];
+          if (this.gOp[gi] !== op) continue;
+          const other = this.gIn1[gi] === whave ? this.gIn2[gi] : this.gIn1[gi];
+          if (other !== wneed) {
+            const prev = sink;
+            sink = primary;
+            propose(other, wneed);
+            sink = prev;
+          }
+        }
+      };
+      scan(w1, w2);
+      scan(w2, w1);
+      return -1;
+    };
+    const target = this.zTarget[failBit];
+    const holder = need(target, 3 * PAIR_COUNT);
+    if (holder >= 0 && holder !== this.zWire[failBit]) {
+      propose(this.zWire[failBit], holder);
+    }
+    // Anchor on the gate driving z_fail: even when both of its inputs are
+    // mis-fed (two swap pairs corrupting the same gate), propose swapping
+    // each input with the wire holding the role that position needs. These
+    // cross-products are less precise than need-chain proposals, so they go
+    // to the secondary list.
+    sink = secondary;
+    const anchor = this.producer[this.zWire[failBit]];
+    const parts = decompose(target);
+    if (anchor >= 0 && parts && this.gOp[anchor] === parts[0]) {
+      const [, rA, rB] = parts;
+      const in1 = this.gIn1[anchor];
+      const in2 = this.gIn2[anchor];
+      const r1 = this.roles[in1];
+      const r2 = this.roles[in2];
+      for (const [needRole, otherRole] of [
+        [rA, rB],
+        [rB, rA],
+      ]) {
+        if (r1 === needRole || r2 === needRole) continue;
+        const have = need(needRole, 3 * PAIR_COUNT);
+        if (have < 0) continue;
+        if (r1 !== otherRole) propose(in1, have);
+        if (r2 !== otherRole) propose(in2, have);
+      }
+    }
+    return { primary, secondary };
+  }
+
+  /** True iff the circuit adds correctly on every battery vector. */
+  private simPerfect(): boolean {
+    const s = this.score(this.perfect);
+    return s !== null && s.fail === this.perfect;
+  }
+
+  /** Exchange the producing gates of wires u and v. Self-inverse. */
+  private applySwap(u: number, v: number): void {
+    const gu = this.producer[u];
+    const gv = this.producer[v];
+    this.gOut[gu] = v;
+    this.gOut[gv] = u;
+    this.producer[u] = gv;
+    this.producer[v] = gu;
+  }
+
+  /**
+   * Output wires of gates that violate ripple-carry adder invariants. The
+   * checks classify each gate by op/inputs and require its output wire to
+   * play the matching role (derived from the wire's static consumers).
+   */
+  private structuralSuspects(): number[] {
+    const suspects: number[] = [];
+    const topBit = this.nOut - 1;
+    for (let gi = 0; gi < this.nGates; gi++) {
+      const op = this.gOp[gi];
+      const out = this.gOut[gi];
+      const zBit = this.zBitOf[out];
+      const b1 = this.xyBit[this.gIn1[gi]];
+      const b2 = this.xyBit[this.gIn2[gi]];
+      const xyInputs = b1 >= 0 && b2 >= 0;
+      const bit0 = xyInputs && b1 === 0 && b2 === 0;
+
+      let feedsXor = false;
+      let feedsAnd = false;
+      let feedsOr = false;
+      for (let k = this.consumerStart[out]; k < this.consumerStart[out + 1]; k++) {
+        const cop = this.gOp[this.consumers[k]];
+        if (cop === OP_XOR) feedsXor = true;
+        else if (cop === OP_AND) feedsAnd = true;
+        else feedsOr = true;
+      }
+
+      let bad = false;
+      if (zBit >= 0) {
+        if (zBit === topBit) {
+          bad = op !== OP_OR;
+        } else if (op !== OP_XOR) {
+          bad = true;
+        } else if (zBit === 0) {
+          bad = !bit0;
+        } else {
+          bad = xyInputs;
+        }
+      } else if (op === OP_XOR) {
+        // Internal XOR must be an x^y partial sum feeding the sum XOR and
+        // the propagate AND of its own bit.
+        bad = !xyInputs || bit0 || !feedsXor || !feedsAnd;
+      } else if (op === OP_AND) {
+        if (bit0) {
+          // x00 AND y00 is the bit-0 carry: consumed like any carry.
+          bad = !feedsXor || !feedsAnd;
+        } else {
+          bad = !feedsOr || feedsXor || feedsAnd;
+        }
+      } else {
+        // Internal OR is a carry: feeds the next bit's XOR and AND.
+        bad = !feedsXor || !feedsAnd || feedsOr;
+      }
+      if (bad) suspects.push(out);
+    }
+    return suspects;
+  }
+
+  /** Full verification: exact roles, structure and simulation all agree. */
+  private verified(): boolean {
+    return this.rolesPerfect() && this.structuralSuspects().length === 0 && this.simPerfect();
+  }
+
+  /**
+   * The 4 chosen pairs may cover the right 8 wires with the wrong pairing
+   * (crossed pairs of commutative gate inputs score deceptively well).
+   * Un-apply the current pairing and try every alternative pairing of the
+   * same wire set; the returned answer only needs the set to be right.
+   */
+  private repairPairing(): boolean {
+    const wires = this.chosen.slice();
+    for (let i = wires.length - 2; i >= 0; i -= 2) {
+      this.applySwap(wires[i], wires[i + 1]);
+    }
+    const ok = this.tryMatchings(wires);
+    for (let i = 0; i < wires.length; i += 2) {
+      this.applySwap(wires[i], wires[i + 1]);
+    }
+    return ok;
+  }
+
+  /**
+   * Try every pairing of the suspect wires; accept one whose swaps yield a
+   * verified adder.
+   */
+  private tryMatchings(wires: number[]): boolean {
+    if (wires.length === 0) {
+      return this.verified();
+    }
+    const first = wires[0];
+    for (let k = 1; k < wires.length; k++) {
+      const partner = wires[k];
+      const rest = wires.filter((_, i) => i !== 0 && i !== k);
+      this.applySwap(first, partner);
+      if (this.tryMatchings(rest)) {
+        this.applySwap(first, partner);
+        return true;
+      }
+      this.applySwap(first, partner);
+    }
+    return false;
+  }
+
+  /** Produced wires in the fan-in cone of output bit zBit (inclusive). */
+  private coneWires(zBit: number): number[] {
+    this.inCone.fill(0);
+    const start = this.zWire[zBit];
+    const stack: number[] = [start];
+    const result: number[] = [];
+    this.inCone[start] = 1;
+    while (stack.length > 0) {
+      const w = stack.pop() as number;
+      const gi = this.producer[w];
+      if (gi < 0) continue;
+      result.push(w);
+      for (const next of [this.gIn1[gi], this.gIn2[gi]]) {
+        if (this.inCone[next] === 0) {
+          this.inCone[next] = 1;
+          stack.push(next);
+        }
+      }
+    }
+    return result;
+  }
+
+  /** level[w] = highest x/y bit index in w's fan-in (current circuit). */
+  private computeLevels(): void {
+    this.topoSort();
+    const { level, order, gIn1, gIn2, gOut } = this;
+    level.fill(0);
+    for (let w = 0; w < this.nWires; w++) {
+      if (this.xyBit[w] >= 0) level[w] = this.xyBit[w];
+    }
+    for (let k = 0; k < this.nGates; k++) {
+      const gi = order[k];
+      level[gOut[gi]] = Math.max(level[gIn1[gi]], level[gIn2[gi]]);
+    }
+  }
+
+  /** Score the given swaps and keep the viable ones as candidates. */
+  private scorePairs(pairs: Array<[number, number]>): Candidate[] {
+    const out: Candidate[] = [];
+    const seen = new Set<number>();
+    for (const [u, v] of pairs) {
+      const key = u * this.nWires + v;
+      if (seen.has(key)) continue;
+      seen.add(key);
+      this.applySwap(u, v);
+      const s = this.score(0);
+      this.applySwap(u, v);
+      if (s) out.push({ u, v, fail: s.fail, bad: s.bad, miss: s.miss });
+    }
+    return out;
+  }
+
+  /**
+   * Score every candidate swap (u from `cone`, v any unused gate output).
+   * With nearBit >= 0 only partners whose level is close to that bit are
+   * considered. minFail is forwarded to score() for early rejection.
+   */
+  private enumerate(
+    cone: number[],
+    coneSet: Set<number>,
+    nearBit: number,
+    minFail: number,
+  ): Candidate[] {
+    const out: Candidate[] = [];
+    for (const u of cone) {
+      if (this.used[u]) continue;
+      if (Date.now() > this.deadline) break;
+      for (const v of this.allOuts) {
+        if (v === u || this.used[v]) continue;
+        if (coneSet.has(v) && v < u) continue;
+        if (nearBit >= 0 && Math.abs(this.level[v] - nearBit) > LEVEL_WINDOW) continue;
+        this.applySwap(u, v);
+        const s = this.score(minFail);
+        this.applySwap(u, v);
+        if (s) out.push({ u, v, fail: s.fail, bad: s.bad, miss: s.miss });
+      }
+    }
+    return out;
+  }
+
+  private tryCandidates(
+    cands: Candidate[],
+    cap: number,
+    depth: number,
+    tried: Set<number>,
+  ): boolean {
+    cands.sort((a, b) => b.fail - a.fail || a.bad - b.bad || a.miss - b.miss);
+    let attempts = 0;
+    for (const c of cands) {
+      if (attempts >= cap || Date.now() > this.deadline) break;
+      const key = Math.min(c.u, c.v) * this.nWires + Math.max(c.u, c.v);
+      if (tried.has(key)) continue;
+      tried.add(key);
+      attempts++;
+      this.applySwap(c.u, c.v);
+      this.used[c.u] = 1;
+      this.used[c.v] = 1;
+      this.chosen.push(c.u, c.v);
+      const parentDeadline = this.deadline;
+      this.deadline = Math.min(parentDeadline, Date.now() + this.slices[depth]);
+      const won = this.search(c, depth + 1);
+      this.deadline = parentDeadline;
+      if (won) return true;
+      this.chosen.pop();
+      this.chosen.pop();
+      this.used[c.u] = 0;
+      this.used[c.v] = 0;
+      this.applySwap(c.u, c.v);
+    }
+    return false;
+  }
+
+  /**
+   * Depth-limited repair search. At each node, candidate swaps are tried in
+   * tiers:
+   *   1. role-guided proposals (exact, gradient-free);
+   *   2. pairs of currently structure-suspect wires;
+   *   3. strictly fail-advancing swaps with both ends near the failing bit;
+   *   4. strictly improving swaps anywhere in the failing bit's cone;
+   *   5. non-worsening ("sideways") swaps — needed when two swapped pairs
+   *      corrupt the same bit and no single swap can advance it;
+   *   6. any swap, including ones that unmask lower failing bits (needed
+   *      when a swapped pair masks an earlier error).
+   */
+  private search(cur: Score, depth: number): boolean {
+    if (Date.now() > this.deadline) return false;
+    if (depth === PAIR_COUNT) {
+      if (cur.fail === this.perfect && this.verified()) return true;
+      return this.repairPairing();
+    }
+    if (cur.fail === this.perfect) return false;
+
+    const tried = new Set<number>();
+
+    const props = this.proposals(cur.fail);
+    const primary = this.scorePairs(props.primary);
+    if (this.tryCandidates(primary, PROPOSAL_CAPS[depth], depth, tried)) return true;
+    const secondary = this.scorePairs(props.secondary);
+    if (this.tryCandidates(secondary, PROPOSAL_CAPS[depth], depth, tried)) return true;
+
+    // Wires that are structurally suspicious in the current circuit are prime
+    // swap candidates: pairing them up often fixes bits that no single swap
+    // can improve on the numeric metric.
+    const suspects = this.structuralSuspects().filter((w) => this.used[w] === 0);
+    if (suspects.length >= 2 && suspects.length <= 10) {
+      const pairs: Array<[number, number]> = [];
+      for (let i = 0; i < suspects.length; i++) {
+        for (let j = i + 1; j < suspects.length; j++) {
+          pairs.push([suspects[i], suspects[j]]);
+        }
+      }
+      if (this.tryCandidates(this.scorePairs(pairs), SUSPECT_CAPS[depth], depth, tried)) {
+        return true;
+      }
+    }
+
+    const cone = this.coneWires(cur.fail);
+    const coneSet = new Set(cone);
+    this.computeLevels();
+    const better = (c: Candidate): boolean =>
+      c.fail > cur.fail ||
+      (c.fail === cur.fail && (c.bad < cur.bad || (c.bad === cur.bad && c.miss < cur.miss)));
+
+    // Cheap first pass around the failing bit — but only trust it for swaps
+    // that strictly advance the failing bit; "sideways" improvements must
+    // compete against the full enumeration below.
+    const nearCone = cone.filter((w) => Math.abs(this.level[w] - cur.fail) <= LEVEL_WINDOW);
+    const eNear = this.enumerate(nearCone, coneSet, cur.fail, cur.fail);
+    if (this.tryCandidates(eNear.filter((c) => c.fail > cur.fail), STRICT_CAPS[depth], depth, tried)) {
+      return true;
+    }
+
+    const eAll = this.enumerate(cone, coneSet, -1, cur.fail);
+    if (this.tryCandidates(eAll.filter(better), STRICT_CAPS[depth], depth, tried)) return true;
+    if (this.tryCandidates(eAll.filter((c) => !better(c)), SIDEWAYS_CAPS[depth], depth, tried)) {
+      return true;
+    }
+
+    if (Date.now() > this.deadline) return false;
+    const eFull = this.enumerate(cone, coneSet, -1, 0);
+    return this.tryCandidates(eFull.filter((c) => c.fail < cur.fail), SIDEWAYS_CAPS[depth], depth, tried);
+  }
+}
+
+/**
+ * Given an adder circuit in which exactly 4 pairs of gate output wires were
+ * swapped, return the 8 affected wire names sorted alphabetically.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  return new SwapFinder(gates).solve();
+}
