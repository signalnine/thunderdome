urn sum;\n}\nfunction allZDefined(values: Record<string, number>, n: number): boolean {\n  for (let j = 0; j <= n; j++) if (values[`z${pad(j)}`] === undefined) return false;\n  return true;\n}\nfunction addsCorrectly(gates: Gate[], n: number, samples: Array<[bigint, bigint]>): boolean {\n  for (const [x, y] of samples) {\n    const values = simulate(gates, toInputs(n, x, y));\n    if (!allZDefined(values, n)) return false;\n    if (readZ(values, n) !== x + y) return false;\n  }\n  return true;\n}\nfunction applySwaps(gates: Gate[], pairs: Array<[string, string]>): Gate[] {\n  const copy = gates.map((g) => ({ ...g }));\n  for (const [p, q] of pairs) {\n    const gp = copy.find((g) => g.out === p);\n    const gq = copy.find((g) => g.out === q);\n    if (gp && gq) { gp.out = q; gq.out = p; }\n  }\n  return copy;\n}\nfunction randBig(n: number, rand: () => number): bigint {\n  let result = 0n;\n  for (let i = 0; i < n; i++) if (rand() < 0.5) result |= 1n << BigInt(i);\n  return result;\n}\nfunction sampleSet(n: number, rand: () => number): Array<[bigint, bigint]> {\n  const samples: Array<[bigint, bigint]> = [];\n  for (let i = 0; i < n; i++) {\n    samples.push([1n << BigInt(i), 0n]);\n    samples.push([0n, 1n << BigInt(i)]);\n    samples.push([1n << BigInt(i), 1n << BigInt(i)]);\n    samples.push([(1n << BigInt(i + 1)) - 1n, 1n]);\n  }\n  const full = (1n << BigInt(n)) - 1n;\n  samples.push([full, full], [full, 1n], [0n, 0n]);\n  for (let i = 0; i < 20; i++) samples.push([randBig(n, rand), randBig(n, rand)]);\n  return samples;\n}\nfunction shuffle<T>(arr: T[], rand: () => number): T[] {\n  const copy = [...arr];\n  for (let i = copy.length - 1; i > 0; i--) {\n    const j = Math.floor(rand() * (i + 1));\n    [copy[i], copy[j]] = [copy[j], copy[i]];\n  }\n  return copy;\n}\nfunction randomSwapPairs(gates: Gate[], n: number, rand: () => number): Array<[string, string]> | null {\n  const outs = gates.map((g) => g.out);\n  const samples = sampleSet(n, rand);\n  for (let attempt = 0; attempt < 1000; attempt++) {\n    const picked = shuffle(outs, rand).slice(0, 8);\n    const pairs: Array<[string, string]> = [\n      [picked[0], picked[1]], [picked[2], picked[3]], [picked[4], picked[5]], [picked[6], picked[7]],\n    ];\n    let valid = true;\n    for (const pair of pairs) {\n      const c = applySwaps(gates, [pair]);\n      const v = simulate(c, toInputs(n, 0n, 0n));\n      if (!allZDefined(v, n)) { valid = false; break; }\n      if (addsCorrectly(c, n, samples)) { valid = false; break; }\n    }\n    if (!valid) continue;\n    const c4 = applySwaps(gates, pairs);\n    if (!allZDefined(simulate(c4, toInputs(n, 0n, 0n)), n)) continue;\n    if (addsCorrectly(c4, n, samples)) continue;\n    return pairs;\n  }\n  return null;\n}\n\nit('fuzz many seeds', () => {\n  let failures = 0;\n  let maxTime = 0;\n  let total = 0;\n  const times: number[] = [];\n  for (const n of [8, 16, 24, 45]) {\n    const base = buildAdder(n);\n    for (let seed = 100; seed < 100 + 25; seed++) {\n      const rand = mulberry32(seed * 977 + n);\n      const pairs = randomSwapPairs(base, n, rand);\n      if (!pairs) continue;\n      total++;\n      const swapped = applySwaps(base, pairs);\n      const expected = pairs.flat().sort();\n      const t0 = performance.now();\n      let got: string[] | null = null;\n      let err = '';\n      try { got = findSwappedWires(swapped); } catch (e) { err = (e as Error).message; }\n      const dt = performance.now() - t0;\n      times.push(dt);\n      if (dt > maxTime) maxTime = dt;\n      if (!got || JSON.stringify(got) !== JSON.stringify(expected)) {\n        failures++;\n        console.log(`FAIL n=${n} seed=${seed} pairs=${JSON.stringify(pairs)} time=${Math.round(dt)}ms`);\n        console.log(`  expected=${JSON.stringify(expected)} got=${got ? JSON.stringify(got) : err}`);\n      }\n    }\n  }\n  times.sort((a, b) => a - b);\n  console.log(`total=${total} failures=${failures} maxTime=${Math.round(maxTime)}ms p50=${Math.round(