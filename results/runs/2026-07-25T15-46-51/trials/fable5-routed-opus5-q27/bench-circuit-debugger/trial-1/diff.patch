      bad = !bit0;\n        } else {\n          bad = xyInputs;\n        }\n      } else if (op === OP_XOR) {\n        // Internal XOR must be an x^y partial sum feeding the sum XOR and\n        // the propagate AND of its own bit.\n        bad = !xyInputs || bit0 || !feedsXor || !feedsAnd;\n      } else if (op === OP_AND) {\n        if (bit0) {\n          // x00 AND y00 is the bit-0 carry: consumed like any carry.\n          bad = !feedsXor || !feedsAnd;\n        } else {\n          bad = !feedsOr || feedsXor || feedsAnd;\n        }\n      } else {\n        // Internal OR is a carry: feeds the next bit's XOR and AND.\n        bad = !feedsXor || !feedsAnd || feedsOr;\n      }\n      if (bad) suspects.push(out);\n    }\n    return suspects;\n  }\n\n  /**\n   * Try every pairing of the suspect wires; accept one whose swaps yield a\n   * circuit that passes the full battery and has no structural suspects.\n   */\n  private tryMatchings(wires: number[]): boolean {\n    if (wires.length === 0) {\n      const s = this.score(this.perfect);\n      return s !== null && this.structuralSuspects().length === 0;\n    }\n    const first = wires[0];\n    for (let k = 1; k < wires.length; k++) {\n      const partner = wires[k];\n      const rest = wires.filter((_, i) => i !== 0 && i !== k);\n      this.applySwap(first, partner);\n      if (this.tryMatchings(rest)) {\n        this.applySwap(first, partner);\n        return true;\n      }\n      this.applySwap(first, partner);\n    }\n    return false;\n  }\n\n  /** Produced wires in the fan-in cone of output bit zBit (inclusive). */\n  private coneWires(zBit: number): number[] {\n    this.inCone.fill(0);\n    const start = this.zWire[zBit];\n    const stack: number[] = [start];\n    const result: number[] = [];\n    this.inCone[start] = 1;\n    while (stack.length > 0) {\n      const w = stack.pop() as number;\n      const gi = this.producer[w];\n      if (gi < 0) continue;\n      result.push(w);\n      for (const next of [this.gIn1