}\n\n/**\n * Simulate the circuit: propagate values from the given inputs through every\n * gate in dependency order and return the final value of every wire.\n */\nexport function simulate(\n  gates: Gate[],\n  inputs: Record<string, number>,\n): Record<string, number> {\n  const values: Record<string, number> = { ...inputs };\n  const waiters = new Map<string, number[]>();\n  const missing = new Array<number>(gates.length).fill(0);\n  const queue: number[] = [];\n\n  gates.forEach((gate, i) => {\n    for (const wire of [gate.in1, gate.in2]) {\n      if (wire in values) continue;\n      missing[i]++;\n      const list = waiters.get(wire);\n      if (list) list.push(i);\n      else waiters.set(wire, [i]);\n    }\n    if (missing[i] === 0) queue.push(i);\n  });\n\n  for (let head = 0; head < queue.length; head++) {\n    const gate = gates[queue[head]];\n    const a = values[gate.in1];\n    const b = values[gate.in2];\n    values[gate.out] = gate.op === 'AND' ? a & b : gate.op === 'OR' ? a | b : a ^ b;\n    const list = waiters.get(gate.out);\n    if (list) {\n      for (const gi of list) {\n        if (--missing[gi] === 0) queue.push(gi);\n      }\n    }\n  }\n  return values;\n}\n\nconst OP_AND = 0;\nconst OP_OR = 1;\nconst OP_XOR = 2;\nconst PAIR_COUNT = 4;\nconst LEVEL_WINDOW = 3;\n// Branching caps per search depth; narrower deeper down so backtracking out\n// of a wrong early pick stays affordable.\nconst PROPOSAL_CAPS = [8, 8, 8, 8];\nconst SUSPECT_CAPS = [10, 10, 8, 6];\nconst STRICT_CAPS = [30, 20, 12, 8];\nconst SIDEWAYS_CAPS = [12, 8, 6, 5];\n\n// Symbolic wire roles for the ripple-carry adder, encoded as kind<<8|bit.\n// A wire's role is the exact boolean function of the x/y inputs it computes;\n// it is derived bottom-up from gate inputs, which swaps never touch.\nconst ROLE_NONE = 0;\nconst K_X = 1;\nconst K_Y = 2;\nconst K_T = 3; // x_i XOR y_i (partial sum), i > 0\nconst K_A = 4; // x_i AND y_i (generate), i > 0\nconst K_B = 5; // t_i AND c_{i-1} (propagate)\nconst K_C = 6; // carry out of bit i\nconst K_S = 7; // sum bit i\nconst role = (kind: number, bit: number): number => (kind << 8) | bit;\n\ninterface Score {\n  fail: number;\n  bad: number;\n  miss: number;\n}\n\ninterface Candidate extends Score {\n  u: number;\n  v: number;\n}\n\nfunction popcount(n: number): number {\n  n -= (n >>> 1) & 0x55555555;\n  n = (n & 0x33333333) + ((n >>> 2) & 0x33333333);\n  n = (n + (n >>> 4)) & 0x0f0f0f0f;\n  return (n * 0x01010101) >>> 24;\n}\n\nfunction mulberry32(seed: number): () => number {\n  let s = seed >>> 0;\n  return () => {\n    s = (s + 0x6d2b79f5) >>> 0;\n    let t = s;\n    t = Math.imul(t ^ (t >>> 15), t | 1);\n    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\n/**\n * Identifies the 8 output wires involved in the 4 swapped pairs of an adder\n * circuit. Strategy:\n *   1. Flag gates violating ripple-carry structural invariants; if exactly 8\n *      wires are flagged, confirm by finding a pairing of them whose un-swap\n *      makes the circuit a verified adder.\n *   2. Otherwise run a depth-4 repair search over candidate swaps, scored by\n *      bit-parallel simulation on a battery of test vectors. At each node,\n *      candidates derived from exact symbolic wire roles (\"which wire holds\n *      the value this position needs\") and from structural suspects are\n *      tried first; a cone-restricted enumeration with progressively relaxed\n *      acceptance tiers is the fallback, with backtracking throughout.\n */\nclass SwapFinder {\n  private readonly nGates: number;\n  private readonly names: string[] = [];\n  private readonly gOp: Int32Array;\n  private readonly gIn1: Int32Array;\n  private readonly gIn2: Int32Array;\n  private readonly gOut: Int32Array;\n  private readonly nWires: number;\n\n  private readonly xWire: number[] = [];\n  private readonly yWire: number[] = [];\n  private readonly zWire: number[] = [];\n  private readonly nBits: number;\n  private readonly nOut: number;\n  private readonly perfect: number;\n\n  private readonly zBitOf: Int32Array;\n  private readonly xyBit: Int32Array;\n  private readonly zTarget: Int32Array;\n\n  private readonly consumerStart: Int32Array;\n  private readonly consumers: Int32Array;\n\n  private readonly producer: Int32Array;\n  private readonly allOuts: number[] = [];\n  private readonly indeg: Int32Array;\n  private readonly order: Int32Array;\n  private readonly values: Int32Array;\n  private readonly roles: Int32Array;\n  private readonly zBad: Uint8Array;\n  private readonly level: Int32Array;\n  private readonly inCone: Uint8Array;\n  private readonly used: Uint8Array;\n  private readonly chosen: number[] = [];\n\n  private readonly laneX: Int32Array[] = [];\n  private readonly laneY: Int32Array[] = [];\n  private readonly laneZ: Int32Array[] = [];\n  private nLanes = 0;\n\n  private deadline = Number.MAX_SAFE_INTEGER;\n\n  constructor(gates: Gate[]) {\n    this.nGates = gates.length;\n    const wireIds = new Map<string, number>();\n    const idOf = (w: string): number => {\n      let i = wireIds.get(w);\n      if (i === undefined) {\n        i = this.names.length;\n        wireIds.set(w, i);\n        this.names.push(w);\n      }\n      return i;\n    };\n\n    this.gOp = new Int32Array(this.nGates);\n    this.gIn1 = new Int32Array(this.nGates);\n    this.gIn2 = new Int32Array(this.nGates);\n    this.gOut = new Int32Array(this.nGates);\n    gates.forEach((g, i) => {\n      this.gOp[i] = g.op === 'AND' ? OP_AND : g.op === 'OR' ? OP_OR : OP_XOR;\n      this.gIn1[i] = idOf(g.in1);\n      this.gIn2[i] = idOf(g.in2);\n      this.gOut[i] = idOf(g.out);\n    });\n    this.nWires = this.names.length;\n\n    this.zBitOf = new Int32Array(this.nWires).fill(-1);\n    this.xyBit = new Int32Array(this.nWires).fill(-1);\n    for (let w = 0; w < this.nWires; w++) {\n      const m = /^([xyz])(\\d+)$/.exec(this.names[w]);\n      if (!m) continue;\n      const bit = parseInt(m[2], 10);\n      if (m[1] === 'x') {\n        this.xWire[bit] = w;\n        this.xyBit[w] = bit;\n      } else if (m[1] === 'y') {\n        this.yWire[bit] = w;\n        this.xyBit[w] = bit;\n      } else {\n        this.zWire[bit] = w;\n        this.zBitOf[w] = bit;\n      }\n    }\n    this.nBits = this.xWire.length;\n    this.nOut = this.zWire.length;\n    this.perfect = this.nOut;\n\n    this.zTarget = new Int32Array(this.nOut);\n    for (let j = 0; j < this.nOut; j++) {\n      this.zTarget[j] = j === this.nBits ? role(K_C, this.nBits - 1) : role(K_S, j);\n    }\n\n    // Static consumer adjacency (CSR keyed by wire). Gate inputs never change\n    // under output swaps, so this is computed once.\n    const counts = new Int32Array(this.nWires);\n    for (let gi = 0; gi < this.nGates; gi++) {\n      counts[this.gIn1[gi]]++;\n      counts[this.gIn2[gi]]++;\n    }\n    this.consumerStart = new Int32Array(this.nWires + 1);\n    for (let w = 0; w < this.nWires; w++) {\n      this.consumerStart[w + 1] = this.consumerStart[w] + counts[w];\n    }\n    this.consumers = new Int32Array(this.consumerStart[this.nWires]);\n    const fill = this.consumerStart.slice(0, this.nWires);\n    for (let gi = 0; gi < this.nGates; gi++) {\n      this.consumers[fill[this.gIn1[gi]]++] = gi;\n      this.consumers[fill[this.gIn2[gi]]++] = gi;\n    }\n\n    this.producer = new Int32Array(this.nWires).fill(-1);\n    for (let gi = 0; gi < this.nGates; gi++) {\n      this.producer[this.gOut[gi]] = gi;\n    }\n    for (let w = 0; w < this.nWires; w++) {\n      if (this.producer[w] >= 0) this.allOuts.push(w);\n    }\n\n    this.indeg = new Int32Array(this.nGates);\n    this.order = new Int32Array(this.nGates);\n    this.values = new Int32Array(this.nWires);\n    this.roles = new Int32Array(this.nWires);\n    this.zBad = new Uint8Array(this.nOut);\n    this.level = new Int32Array(this.nWires);\n    this.inCone = new Uint8Array(this.nWires);\n    this.used = new Uint8Array(this.nWires);\n\n    this.buildBattery();\n  }\n\n  solve(): string[] {\n    this.deadline = Date.now() + 4500;\n    const base = this.score(0);\n    if (!base) {\n      throw new Error('Circuit contains a cycle');\n    }\n    if (base.fail === this.perfect) {\n      return [];\n    }\n    const suspects = this.structuralSuspects();\n    if (suspects.length === 2 * PAIR_COUNT && this.tryMatchings(suspects)) {\n      return suspects.map((w) => this.names[w]).sort();\n    }\n    if (this.search(base, 0)) {\n      return this.chosen.map((w) => this.names[w]).sort();\n    }\n    throw new Error('Unable to identify swapped wires');\n  }\n\n  /**\n   * Test battery: for every bit i the four patterns (2^i, 0), (0, 2^i),\n   * (2^i, 2^i) and (2^(i+1)-1, 1) plus corner cases and seeded random\n   * vectors, packed 32 vectors per lane.\n   */\n  private buildBattery(): void {\n    const vecX: bigint[] = [];\n    const vecY: bigint[] = [];\n    const add = (x: bigint, y: bigint): void => {\n      vecX.push(x);\n      vecY.push(y);\n    };\n    const n = this.nBits;\n    const full = (1n << BigInt(n)) - 1n;\n    for (let i = 0; i < n; i++) {\n      const bit = 1n << BigInt(i);\n      add(bit, 0n);\n      add(0n, bit);\n      add(bit, bit);\n      add((bit << 1n) - 1n, 1n);\n    }\n    add(full, 1n);\n    add(full, full);\n    add(1n, full);\n    add(0n, 0n);\n    const rand = mulberry32(0x1234abcd);\n    const randomBits = (): bigint => {\n      let v = 0n;\n      for (let i = 0; i < n; i++) {\n        if (rand() < 0.5) v |= 1n << BigInt(i);\n      }\n      return v;\n    };\n    for (let i = 0; i < 32; i++) add(randomBits(), randomBits());\n    while (vecX.length % 32 !== 0) add(randomBits(), randomBits());\n\n    this.nLanes = vecX.length / 32;\n    for (let l = 0; l < this.nLanes; l++) {\n      const lx = new Int32Array(n);\n      const ly = new Int32Array(n);\n      const lz = new Int32Array(this.nOut);\n      for (let v = 0; v < 32; v++) {\n        const x = vecX[l * 32 + v];\n        const y = vecY[l * 32 + v];\n        const z = x + y;\n        for (let i = 0; i < n; i++) {\n          if ((x >> BigInt(i)) & 1n) lx[i] |= 1 << v;\n          if ((y >> BigInt(i)) & 1n) ly[i] |= 1 << v;\n        }\n        for (let j = 0; j < this.nOut; j++) {\n          if ((z >> BigInt(j)) & 1n) lz[j] |= 1 << v;\n        }\n      }\n      this.laneX.push(lx);\n      this.laneY.push(ly);\n      this.laneZ.push(lz);\n    }\n  }\n\n  /** Kahn topological sort into this.order; false if the circuit is cyclic. */\n  private topoSort(): boolean {\n    const { indeg, order, producer, gIn1, gIn2, gOut, consumerStart, consumers } = this;\n    let tail = 0;\n    for (let gi = 0; gi < this.nGates; gi++) {\n      indeg[gi] = (producer[gIn1[gi]] >= 0 ? 1 : 0) + (producer[gIn2[gi]] >= 0 ? 1 : 0);\n      if (indeg[gi] === 0) order[tail++] = gi;\n    }\n    for (let head = 0; head < tail; head++) {\n      const w = gOut[order[head]];\n      for (let k = consumerStart[w]; k < consumerStart[w + 1]; k++) {\n        const gi = consumers[k];\n        if (--indeg[gi] === 0) order[tail++] = gi;\n      }\n    }\n    return tail === this.nGates;\n  }\n\n  /**\n   * Evaluate the whole battery. fail = lowest mismatching output bit,\n   * bad = number of distinct mismatching output bits, miss = total count of\n   * mismatching (vector, bit) entries. Returns null for a cyclic circuit or\n   * as soon as any output bit below minFail mismatches (early rejection of\n   * candidates that break already-correct low bits).\n   */\n  private score(minFail: number): Score | null {\n    if (!this.topoSort()) return null;\n    const { values, order, gOp, gIn1, gIn2, gOut, zWire, zBad } = this;\n    let fail = this.perfect;\n    let bad = 0;\n    let miss = 0;\n    zBad.fill(0);\n    for (let l = 0; l < this.nLanes; l++) {\n      const lx = this.laneX[l];\n      const ly = this.laneY[l];\n      const lz = this.laneZ[l];\n      for (let i = 0; i < this.nBits; i++) {\n        values[this.xWire[i]] = lx[i];\n        values[this.yWire[i]] = ly[i];\n      }\n      for (let k = 0; k < this.nGates; k++) {\n        const gi = order[k];\n        const a = values[gIn1[gi]];\n        const b = values[gIn2[gi]];\n        values[gOut[gi]] = gOp[gi] === OP_AND ? a & b : gOp[gi] === OP_OR ? a | b : a ^ b;\n      }\n      for (let j = 0; j < this.nOut; j++) {\n        const diff = values[zWire[j]] ^ lz[j];\n        if (diff !== 0) {\n          if (j < minFail) return null;\n          if (j < fail) fail = j;\n          if (zBad[j] === 0) {\n            zBad[j] = 1;\n            bad++;\n          }\n          miss += popcount(diff);\n        }\n      }\n    }\n    return { fail, bad, miss };\n  }\n\n  /** Symbolic role produced by a gate from its two input roles. */\n  private static combine(op: number, s1: number, s2: number): number {\n    if (s1 === ROLE_NONE || s2 === ROLE_NONE) return ROLE_NONE;\n    let k1 = s1 >>> 8;\n    let b1 = s1 & 0xff;\n    let k2 = s2 >>> 8;\n    let b2 = s2 & 0xff;\n    if (k1 > k2) {\n      const kt = k1;\n      k1 = k2;\n      k2 = kt;\n      const bt = b1;\n      b1 = b2;\n      b2 = bt;\n    }\n    if (op === OP_XOR) {\n      if (k1 === K_X && k2 === K_Y && b1 === b2) {\n        return b1 === 0 ? role(K_S, 0) : role(K_T, b1);\n      }\n      if (k1 === K_T && k2 === K_C && b1 === b2 + 1) return role(K_S, b1);\n    } else if (op === OP_AND) {\n      if (k1 === K_X && k2 === K_Y && b1 === b2) {\n        return b1 === 0 ? role(K_C, 0) : role(K_A, b1);\n      }\n      if (k1 === K_T && k2 === K_C && b1 === b2 + 1) return role(K_B, b1);\n    } else {\n      if (k1 === K_A && k2 === K_B && b1 === b2) return role(K_C, b1);\n    }\n    return ROLE_NONE;\n  }\n\n  /**\n   * Compute the exact symbolic role of every wire in the current circuit.\n   * Returns false for a cyclic circuit. The circuit is a correct adder iff\n   * every z_j ends up carrying zTarget[j].\n   */\n  private computeRoles(): boolean {\n    if (!this.topoSort()) return false;\n    const { roles, order, gOp, gIn1, gIn2, gOut } = this;\n    roles.fill(ROLE_NONE);\n    for (let i = 0; i < this.nBits; i++) {\n      roles[this.xWire[i]] = role(K_X, i);\n      roles[this.yWire[i]] = role(K_Y, i);\n    }\n    for (let k = 0; k < this.nGates; k++) {\n      const gi = order[k];\n      roles[gOut[gi]] = SwapFinder.combine(gOp[gi], roles[gIn1[gi]], roles[gIn2[gi]]);\n    }\n    return true;\n  }\n\n  /** True iff every z wire carries its target role (exact adder). */\n  private rolesPerfect(): boolean {\n    if (!this.computeRoles()) return false;\n    for (let j = 0; j < this.nOut; j++) {\n      if (this.roles[this.zWire[j]] !== this.zTarget[j]) return false;\n    }\n    return true;\n  }\n\n  /**\n   * Role-guided repair proposals for the lowest failing bit: figure out which\n   * wire currently carries the value that z_fail (or, recursively, one of the\n   * intermediate carry/propagate positions feeding it) is supposed to carry,\n   * and propose swapping it into place. Exact and gradient-free, so it works\n   * where no single swap improves the numeric score.\n   */\n  private proposals(failBit: number): Array<[number, number]> {\n    if (!this.computeRoles()) return [];\n    const byRole = new Map<number, number>();\n    for (let w = 0; w < this.nWires; w++) {\n      if (this.roles[w] !== ROLE_NONE) byRole.set(this.roles[w], w);\n    }\n    const out: Array<[number, number]> = [];\n    const propose = (a: number, b: number): void => {\n      if (a === b || this.used[a] || this.used[b]) return;\n      if (this.producer[a] < 0 || this.producer[b] < 0) return;\n      out.push(a < b ? [a, b] : [b, a]);\n    };\n    const decompose = (r: number): [number, number, number] | null => {\n      const kind = r >>> 8;\n      const bit = r & 0xff;\n      if (kind === K_T) return [OP_XOR, role(K_X, bit), role(K_Y, bit)];\n      if (kind === K_A) return [OP_AND, role(K_X, bit), role(K_Y, bit)];\n      if (kind === K_S) {\n        if (bit === 0) return [OP_XOR, role(K_X, 0), role(K_Y, 0)];\n        return [OP_XOR, role(K_T, bit), role(K_C, bit - 1)];\n      }\n      if (kind === K_B) return [OP_AND, role(K_T, bit), role(K_C, bit - 1)];\n      if (kind === K_C) {\n        if (bit === 0) return [OP_AND, role(K_X, 0), role(K_Y, 0)];\n        return [OP_OR, role(K_A, bit), role(K_B, bit)];\n      }\n      return null;\n    };\n    // Find the wire carrying role r, recursively proposing repairs for the\n    // structure that should produce it when nothing carries it yet.\n    const need = (r: number, guard: number): number => {\n      const have = byRole.get(r);\n      if (have !== undefined) return have;\n      if (guard <= 0) return -1;\n      const parts = decompose(r);\n      if (!parts) return -1;\n      const [op, r1, r2] = parts;\n      const w1 = need(r1, guard - 1);\n      const w2 = need(r2, guard - 1);\n      // The gate that should compute r reads one of w1/w2 but is mis-fed on\n      // the other input: propose renaming that input's producer.\n      const scan = (whave: number, wneed: number): void => {\n        if (whave < 0 || wneed < 0) return;\n        for (let k = this.consumerStart[whave]; k < this.consumerStart[whave + 1]; k++) {\n          const gi = this.consumers[k];\n          if (this.gOp[gi] !== op) continue;\n          const other = this.gIn1[gi] === whave ? this.gIn2[gi] : this.gIn1[gi];\n          if (other !== wneed) propose(other, wneed);\n        }\n      };\n      scan(w1, w2);\n      scan(w2, w1);\n      return -1;\n    };\n    const target = this.zTarget[failBit];\n    const holder = need(target, 3 * PAIR_COUNT);\n    if (holder >= 0 && holder !== this.zWire[failBit]) {\n      propose(this.zWire[failBit], holder);\n    }\n    return out;\n  }\n\n  /** True iff the circuit adds correctly on every battery vector. */\n  private simPerfect(): boolean {\n    const s = this.score(this.perfect);\n    return s !== null && s.fail === this.perfect;\n  }\n\n  /** Exchange the producing gates of wires u and v. Self-inverse. */\n  private applySwap(u: number, v: number): void {\n    const gu = this.producer[u];\n    const gv = this.producer[v];\n    this.gOut[gu] = v;\n    this.gOut[gv] = u;\n    this.producer[u] = gv;\n    this.producer[v] = gu;\n  }\n\n  /**\n   * Output wires of gates that violate ripple-carry adder invariants. The\n   * checks classify each gate by op/inputs and require its output wire to\n   * play the matching role (derived from the wire's static consumers).\n   */\n  private structuralSuspects(): number[] {\n    const suspects: number[] = [];\n    const topBit = this.nOut - 1;\n    for (let gi = 0; gi < this.nGates; gi++) {\n      const op = this.gOp[gi];\n      const out = this.gOut[gi];\n      const zBit = this.zBitOf[out];\n      const b1 = this.xyBit[this.gIn1[gi]];\n      const b2 = this.xyBit[this.gIn2[gi]];\n      const xyInputs = b1 >= 0 && b2 >= 0;\n      const bit0 = xyInputs && b1 === 0 && b2 === 0;\n\n      let feedsXor = false;\n      let feedsAnd = false;\n      let feedsOr = false;\n      for (let k = this.consumerStart[out]; k < this.consumerStart[out + 1]; k++) {\n        const cop = this.gOp[this.consumers[k]];\n        if (cop === OP_XOR) feedsXor = true;\n        else if (cop === OP_AND) feedsAnd = true;\n        else feedsOr = true;\n      }\n\n      let bad = false;\n      if (zBit >= 0) {\n        if (zBit === topBit) {\n          bad = op !== OP_OR;\n        } else if (op !== OP_XOR) {\n          bad = true;\n        } else if (zBit === 0) {\n          bad = !bit0;\n        } else {\n          bad = xyInputs;\n        }\n      } else if (op === OP_XOR) {\n        // Internal XOR must be an x^y partial sum feeding the sum XOR and\n        // the propagate AND of its own bit.\n        bad = !xyInputs || bit0 || !feedsXor || !feedsAnd;\n      } else if (op === OP_AND) {\n        if (bit0) {\n          // x00 AND y00 is the bit-0 carry: consumed like any carry.\n          bad = !feedsXor || !feedsAnd;\n        } else {\n          bad = !feedsOr || feedsXor || feedsAnd;\n        }\n      } else {\n        // Internal OR is a carry: feeds the next bit's XOR and AND.\n        bad = !feedsXor || !feedsAnd || feedsOr;\n      }\n      if (bad) suspects.push(out);\n    }\n    return suspects;\n  }\n\n  /** Full verification: exact roles, structure and simulation all agree. */\n  private verified(): boolean {\n    return this.rolesPerfect() && this.structuralSuspects().length === 0 && this.simPerfect();\n  }\n\n  /**\n   * Try every pairing of the suspect wires; accept one whose swaps yield a\n   * verified adder.\n   */\n  private tryMatchings(wires: number[]): boolean {\n    if (wires.length === 0) {\n      return this.verified();\n    }\n    const first = wires[0];\n    for (let k = 1; k < wires.length; k++) {\n      const partner = wires[k];\n      const rest = wires.filter((_, i) => i !== 0 && i !== k);\n      this.applySwap(first, partner);\n      if (this.tryMatchings(rest)) {\n        this.applySwap(first, partner);\n        return true;\n      }\n      this.applySwap(first, partner);\n    }\n    return false;\n  }\n\n  /** Produced wires in the fan-in cone of output bit zBit (inclusive). */\n  private coneWires(zBit: number): number[] {\n    this.inCone.fill(0);\n    const start = this.zWire[zBit];\n    const stack: number[] = [start];\n    const result: number[] = [];\n    this.inCone[start] = 1;\n    while (stack.length > 0) {\n      const w = stack.pop() as number;\n      const gi = this.producer[w];\n      if (gi < 0) continue;\n      result.push(w);\n      for (const next of [this.gIn1[gi], this.gIn2[gi]]) {\n        if (this.inCone[next] === 0) {\n          this.inCone[next] = 1;\n          stack.push(next);\n        }\n      }\n    }\n    return result;\n  }\n\n  /** level[w] = highest x/y bit index in w's fan-in (current circuit). */\n  private computeLevels(): void {\n    this.topoSort();\n    const { level, order, gIn1, gIn2, gOut } = this;\n    level.fill(0);\n    for (let w = 0; w < this.nWires; w++) {\n      if (this.xyBit[w] >= 0) level[w] = this.xyBit[w];\n    }\n    for (let k = 0; k < this.nGates; k++) {\n      const gi = order[k];\n      level[gOut[gi]] = Math.max(level[gIn1[gi]], level[gIn2[gi]]);\n    }\n  }\n\n  /** Score the given swaps and keep the viable ones as candidates. */\n  private scorePairs(pairs: Array<[number, number]>): Candidate[] {\n    const out: Candidate[] = [];\n    const seen = new Set<number>();\n    for (const [u, v] of pairs) {\n      const key = u * this.nWires + v;\n      if (seen.has(key)) continue;\n      seen.add(key);\n      this.applySwap(u, v);\n      const s = this.score(0);\n      this.applySwap(u, v);\n      if (s) out.push({ u, v, fail: s.fail, bad: s.bad, miss: s.miss });\n    }\n    return out;\n  }\n\n  /**\n   * Score every candidate swap (u from `cone`, v any unused gate output).\n   * With nearBit >= 0 only partners whose level is close to that bit are\n   * considered. minFail is forwarded to score() for early rejection.\n   */\n  private enumerate(\n    cone: number[],\n    coneSet: Set<number>,\n    nearBit: number,\n    minFail: number,\n  ): Candidate[] {\n    const out: Candidate[] = [];\n    for (const u of cone) {\n      if (this.used[u]) continue;\n      if (Date.now() > this.deadline) break;\n      for (const v of this.allOuts) {\n        if (v === u || this.used[v]) continue;\n        if (coneSet.has(v) && v < u) continue;\n        if (nearBit >= 0 && Math.abs(this.level[v] - nearBit) > LEVEL_WINDOW) continue;\n        this.applySwap(u, v);\n        const s = this.score(minFail);\n        this.applySwap(u, v);\n        if (s) out.push({ u, v, fail: s.fail, bad: s.bad, miss: s.miss });\n      }\n    }\n    return out;\n  }\n\n  private tryCandidates(\n    cands: Candidate[],\n    cap: number,\n    depth: number,\n    tried: Set<number>,\n  ): boolean {\n    cands.sort((a, b) => b.fail - a.fail || a.bad - b.bad || a.miss - b.miss);\n    let attempts = 0;\n    for (const c of cands) {\n      if (attempts >= cap || Date.now() > this.deadline) break;\n      const key = Math.min(c.u, c.v) * this.nWires + Math.max(c.u, c.v);\n      if (tried.has(key)) continue;\n      tried.add(key);\n      attempts++;\n      this.applySwap(c.u, c.v);\n      this.used[c.u] = 1;\n      this.used[c.v] = 1;\n      this.chosen.push(c.u, c.v);\n      if (this.search(c, depth + 1)) return true;\n      this.chosen.pop();\n      this.chosen.pop();\n      this.used[c.u] = 0;\n      this.used[c.v] = 0;\n      this.applySwap(c.u, c.v);\n    }\n    return false;\n  }\n\n  /**\n   * Depth-limited repair search. At each node, candidate swaps are tried in\n   * tiers:\n   *   1. role-guided proposals (exact, gradient-free);\n   *   2. pairs of currently structure-suspect wires;\n   *   3. strictly fail-advancing swaps with both ends near the failing bit;\n   *   4. strictly improving swaps anywhere in the failing bit's cone;\n   *   5. non-worsening (\"sideways\") swaps — needed when two swapped pairs\n   *      corrupt the same bit and no single swap can advance it;\n   *   6. any swap, including ones that unmask lower failing bits (needed\n   *      when a swapped pair masks an earlier error).\n   */\n  private search(cur: Score, depth: number): boolean {\n    if (Date.now() > this.deadline) return false;\n    if (cur.fail === this.perfect) {\n      return depth === PAIR_COUNT && this.verified();\n    }\n    if (depth === PAIR_COUNT) return false;\n\n    const tried = new Set<number>();\n\n    const props = this.scorePairs(this.proposals(cur.fail));\n    if (this.tryCandidates(props, PROPOSAL_CAPS[depth], depth, tried)) return true;\n\n    // Wires that are structurally suspicious in the current circuit are prime\n    // swap candidates: pairing them up often fixes bits that no single swap\n    // can improve on the numeric metric.\n    const suspects = this.structuralSuspects().filter((w) => this.used[w] === 0);\n    if (suspects.length >= 2 && suspects.length <= 10) {\n      c