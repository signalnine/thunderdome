 this.indeg = new Int32Array(this.nGates);\n    this.order = new Int32Array(this.nGates);\n    this.values = new Int32Array(this.nWires);\n    this.roles = new Int32Array(this.nWires);\n    this.zBad = new Uint8Array(this.nOut);\n    this.level = new Int32Array(this.nWires);\n    this.inCone = new Uint8Array(this.nWires);\n    this.used = new Uint8Array(this.nWires);\n\n    this.buildBattery();\n  }\n\n  solve(): string[] {\n    this.deadline = Date.now() + 4500;\n    const base = this.score(0);\n    if (!base) {\n      throw new Error('Circuit contains a cycle');\n    }\n    if (base.fail === this.perfect) {\n      return [];\n    }\n    const suspects = this.structuralSuspects();\n    if (suspects.length === 2 * PAIR_COUNT && this.tryMatchings(suspects)) {\n      return suspects.map((w) => this.names[w]).sort();\n    }\n    if (this.search(base, 0)) {\n      return this.chosen.map((w) => this.names[w]).sort();\n    }\n    throw new Error('Unable to identify swapped wires');\n  }\n\n  /**\n   * Test battery: for every bit i the four patterns (2^i, 0), (0, 2^i),\n   * (2^i, 2^i) and (2^(i+1)-1, 1) plus corner cases and seeded random\n   * vectors, packed 32 vectors per lane.\n   */\n  private buildBattery(): void {\n    const vecX: bigint[] = [];\n    const vecY: bigint[] = [];\n    const add = (x: bigint, y: bigint): void => {\n      vecX.push(x);\n      vecY.push(y);\n    };\n    const n = this.nBits;\n    const full = (1n << BigInt(n)) - 1n;\n    for (let i = 0; i < n; i++) {\n      const bit = 1n << BigInt(i);\n      add(bit, 0n);\n      add(0n, bit);\n      add(bit, bit);\n      add((bit << 1n) - 1n, 1n);\n    }\n    add(full, 1n);\n    add(full, full);\n    add(1n, full);\n    add(0n, 0n);\n    const rand = mulberry32(0x1234abcd);\n    const randomBits = (): bigint => {\n      let v = 0n;\n      for (let i = 0; i < n; i++) {\n        if (rand() < 0.5) v |= 1n << BigInt(i);\n      }\n      return v;\n    };\n    for (let i = 0; i < 32; i++) add(randomBits(), randomBits());\n    while (vecX.length % 32 !== 0) add(randomBits(), randomBits());\n\n    this.nLanes = vecX.length / 32;\n    for (let l = 0; l < this.nLanes; l++) {\n      const lx = new Int32Array(n);\n      const ly = new Int32Array(n);\n      const lz = new Int32Array(this.nOut);\n      for (let v = 0; v < 32; v++) {\n        const x = vecX[l * 32 + v];\n        const y = vecY[l * 32 + v];\n        const z = x + y;\n        for (let i = 0; i < n; i++) {\n          if ((x >> BigInt(i)) & 1n) lx[i] |= 1 << v;\n          if ((y >> BigInt(i)) & 1n) ly[i] |= 1 << v;\n        }\n        for (let j = 0; j < this.nOut; j++) {\n          if ((z >> BigInt(j)) & 1n) lz[j] |= 1 << v;\n        }\n      }\n      this.laneX.push(lx);\n      this.laneY.push(ly);\n      this.laneZ.push(lz);\n    }\n  }\n\n  /** Kahn topological sort into this.order; false if the circuit is cyclic. */\n  private topoSort(): boolean {\n    const { indeg, order, producer, gIn1, gIn2, gOut, consumerStart, consumers } = this;\n    let tail = 0;\n    for (let gi = 0; gi < this.nGates; gi++) {\n      indeg[gi] = (producer[gIn1[gi]] >= 0 ? 1 : 0) + (producer[gIn2[gi]] >= 0 ? 1 : 0);\n      if (indeg[gi] === 0) order[tail++] = gi;\n    }\n    for (let head = 0; head < tail; head++) {\n      const w = gOut[order[head]];\n      for (let k = consumerStart[w]; k < consumerStart[w + 1]; k++) {\n        const gi = consumers[k];\n        if (--indeg[gi] === 0) order[tail++] = gi;\n      }\n    }\n    return tail === this.nGates;\n  }\n\n  /**\n   * Evaluate the whole battery. fail = lowest mismatching output bit,\n   * bad = number of distinct mismatching output bits, miss = total count of\n   * mismatching (vector, bit) entries. Returns null for a cyclic circuit or\n   * as soon as any output bit below minFail mismatches (early rejection of\n   * candidates that break already-correct low bits).\n   */\n  private score(minFail: number): Score | null {\n    if (!this.topoSort()) return null;\n    const { values, order, gOp, gIn1, gIn2, gOut, zWire, zBad } = this;\n    let fail = this.perfect;\n    let bad = 0;\n    let miss = 0;\n    zBad.fill(0);\n    for (let l = 0; l < this.nLanes; l++) {\n      const lx = this.laneX[l];\n      const ly = this.laneY[l];\n      const lz = this.laneZ[l];\n      for (let i = 0; i < this.nBits; i++) {\n        values[this.xWire[i]] = lx[i];\n        values[this.yWire[i]] = ly[i];\n      }\n      for (let k = 0; k < this.nGates; k++) {\n        const gi = order[k];\n        const a = values[gIn1[gi]];\n        const b = values[gIn2[gi]];\n        values[gOut[gi]] = gOp[gi] === OP_AND ? a & b : gOp[gi] === OP_OR ? a | b : a ^ b;\n      }\n      for (let j = 0; j < this.nOut; j++) {\n        const diff = values[zWire[j]] ^ lz[j];\n        if (diff !== 0) {\n          if (j < minFail) return null;\n          if (j < fail) fail = j;\n          if (zBad[j] === 0) {\n            zBad[j] = 1;\n            bad++;\n          }\n          miss += popcount(diff);\n        }\n      }\n    }\n    return { fail, bad, miss };\n  }\n\n  /** Symbolic role produced by a gate from its two input roles. */\n  private static combine(op: number, s1: number, s2: number): number {\n    if (s1 === ROLE_NONE || s2 === ROLE_NONE) return ROLE_NONE;\n    let k1 = s1 >>> 8;\n    let b1 = s1 & 0xff;\n    let k2 = s2 >>> 8;\n    let b2 = s2 & 0xff;\n    if (k1 > k2) {\n      const kt = k1;\n      k1 = k2;\n      k2 = kt;\n      const bt = b1;\n      b1 = b2;\n      b2 = bt;\n    }\n    if (op === OP_XOR) {\n      if (k1 === K_X && k2 === K_Y && b1 === b2) {\n        return b1 === 0 ? role(K_S, 0) : role(K_T, b1);\n      }\n      if (k1 === K_T && k2 === K_C && b1 === b2 + 1) return role(K_S, b1);\n    } else if (op === OP_AND) {\n      if (k1 === K_X && k2 === K_Y && b1 === b2) {\n        return b1 === 0 ? role(K_C, 0) : role(K_A, b1);\n      }\n      if (k1 === K_T && k2 === K_C && b1 === b2 + 1) return role(K_B, b1);\n    } else {\n      if (k1 === K_A && k2 === K_B && b1