ires + Math.max(c.u, c.v);\n      if (tried.has(key)) continue;\n      tried.add(key);\n      attempts++;\n      this.applySwap(c.u, c.v);\n      this.used[c.u] = 1;\n      this.used[c.v] = 1;\n      this.chosen.push(c.u, c.v);\n      if (this.search(c, depth + 1)) return true;\n      this.chosen.pop();\n      this.chosen.pop();\n      this.used[c.u] = 0;\n      this.used[c.v] = 0;\n      this.applySwap(c.u, c.v);\n    }\n    return false;\n  }\n\n  /**\n   * Depth-limited repair search. Acceptance tiers, applied in order:\n   *   1. strictly improving swaps with both ends near the failing bit;\n   *   2. strictly improving swaps anywhere;\n   *   3. non-worsening swaps (same lowest failing bit);\n   *   4. any swap, including ones that unmask lower failing bits (needed\n   *      when a swapped pair masks an earlier error).\n   */\n  private search(cur: Score, depth: number): boolean {\n    if (process.env.SWAP_DEBUG) console.log(`search d=${depth} fail=${cur.fail} bad=${cur.badBits} miss=${cur.miss} chosen=${this.chosen.map((w) => this.names[w]).join(',')}`);\n    if (Date.now() > this.deadline) return false;\n    if (cur.fail === this.perfect) {\n      return depth === PAIR_COUNT && this.structuralSuspects().length === 0;\n    }\n    if (depth === PAIR_COUNT) return false;\n\n    const tried = new Set<number>();\n\n    // Wires that are structurally suspicious in the current circuit are prime\n    // swap candidates: pairing them up often fixes bits that no single swap\n    // can improve on the numeric metric (two pairs corrupting the same bit).\n    const suspects = this.structuralSuspects().filter((w) => this.used[w] === 0);\n    if (suspects.length >= 2 && suspects.length <= 10) {\n      const cands: Candidate[] = [];\n      for (let i = 0; i < suspects.length; i++) {\n        for (let j = i + 1; j < suspects.length; j++) {\n          this.applySwap(suspects[i], suspects[j]);\n          const s = this.score(0);\n          this.applySwap(suspects[i], suspects[