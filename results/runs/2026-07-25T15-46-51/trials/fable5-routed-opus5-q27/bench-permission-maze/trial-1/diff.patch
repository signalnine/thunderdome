@@ -0,0 +1,512 @@
+import express, { Request, Response, NextFunction, Router } from 'express';
+import { randomBytes, randomUUID, scryptSync, timingSafeEqual } from 'node:crypto';
+
+export type Role = 'viewer' | 'editor' | 'owner';
+
+const ROLE_RANK: Record<Role, number> = { viewer: 1, editor: 2, owner: 3 };
+
+export interface User {
+  id: string;
+  username: string;
+  passwordSalt: string;
+  passwordHash: string;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  shares: Map<string, Role>;
+  createdAt: string;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  shares: Map<string, Role>;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface ActivityEntry {
+  id: string;
+  action: string;
+  userId: string;
+  resourceType: 'document' | 'folder';
+  resourceId: string;
+  timestamp: string;
+}
+
+interface Store {
+  users: Map<string, User>;
+  usersByName: Map<string, User>;
+  tokens: Map<string, string>; // token -> userId
+  folders: Map<string, Folder>;
+  documents: Map<string, Document>;
+  activity: ActivityEntry[];
+}
+
+interface AuthedRequest extends Request {
+  userId?: string;
+}
+
+function hashPassword(password: string, salt: string): string {
+  return scryptSync(password, salt, 32).toString('hex');
+}
+
+function isRole(value: unknown): value is Role {
+  return value === 'viewer' || value === 'editor' || value === 'owner';
+}
+
+function maxRole(a: Role | null, b: Role | null): Role | null {
+  if (!a) return b;
+  if (!b) return a;
+  return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;
+}
+
+function atLeast(role: Role | null, required: Role): boolean {
+  return role !== null && ROLE_RANK[role] >= ROLE_RANK[required];
+}
+
+export function createApp(): express.Express {
+  const store: Store = {
+    users: new Map(),
+    usersByName: new Map(),
+    tokens: new Map(),
+    folders: new Map(),
+    documents: new Map(),
+    activity: [],
+  };
+
+  // Effective role on a folder: ownership, direct share, or inherited from
+  // any ancestor folder -- the most permissive of all paths wins.
+  function folderRole(folderId: string | null, userId: string): Role | null {
+    let role: Role | null = null;
+    let current = folderId;
+    const visited = new Set<string>();
+    while (current && !visited.has(current)) {
+      visited.add(current);
+      const folder = store.folders.get(current);
+      if (!folder) break;
+      if (folder.ownerId === userId) role = maxRole(role, 'owner');
+      role = maxRole(role, folder.shares.get(userId) ?? null);
+      current = folder.parentId;
+    }
+    return role;
+  }
+
+  function documentRole(doc: Document, userId: string): Role | null {
+    let role: Role | null = doc.ownerId === userId ? 'owner' : null;
+    role = maxRole(role, doc.shares.get(userId) ?? null);
+    return maxRole(role, folderRole(doc.folderId, userId));
+  }
+
+  function logActivity(
+    action: string,
+    userId: string,
+    resourceType: 'document' | 'folder',
+    resourceId: string
+  ): void {
+    store.activity.push({
+      id: randomUUID(),
+      action,
+      userId,
+      resourceType,
+      resourceId,
+      timestamp: new Date().toISOString(),
+    });
+  }
+
+  function serializeFolder(folder: Folder) {
+    return {
+      id: folder.id,
+      name: folder.name,
+      parentId: folder.parentId,
+      ownerId: folder.ownerId,
+      createdAt: folder.createdAt,
+      shares: Object.fromEntries(folder.shares),
+    };
+  }
+
+  function serializeDocument(doc: Document) {
+    return {
+      id: doc.id,
+      title: doc.title,
+      content: doc.content,
+      folderId: doc.folderId,
+      ownerId: doc.ownerId,
+      createdAt: doc.createdAt,
+      updatedAt: doc.updatedAt,
+      shares: Object.fromEntries(doc.shares),
+    };
+  }
+
+  const app = express();
+  app.use(express.json());
+
+  // --- Auth (public) ---
+
+  app.post('/auth/register', (req: Request, res: Response) => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || username.length === 0) {
+      return res.status(400).json({ error: 'username is required' });
+    }
+    if (typeof password !== 'string' || password.length === 0) {
+      return res.status(400).json({ error: 'password is required' });
+    }
+    if (store.usersByName.has(username)) {
+      return res.status(409).json({ error: 'username already taken' });
+    }
+    const salt = randomBytes(16).toString('hex');
+    const user: User = {
+      id: randomUUID(),
+      username,
+      passwordSalt: salt,
+      passwordHash: hashPassword(password, salt),
+    };
+    store.users.set(user.id, user);
+    store.usersByName.set(username, user);
+    return res.status(201).json({ id: user.id, username: user.username });
+  });
+
+  app.post('/auth/login', (req: Request, res: Response) => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || typeof password !== 'string') {
+      return res.status(400).json({ error: 'username and password are required' });
+    }
+    const user = store.usersByName.get(username);
+    if (!user) {
+      return res.status(401).json({ error: 'invalid credentials' });
+    }
+    const attempt = Buffer.from(hashPassword(password, user.passwordSalt), 'hex');
+    const actual = Buffer.from(user.passwordHash, 'hex');
+    if (!timingSafeEqual(attempt, actual)) {
+      return res.status(401).json({ error: 'invalid credentials' });
+    }
+    const token = randomBytes(24).toString('hex');
+    store.tokens.set(token, user.id);
+    return res.status(200).json({ token, userId: user.id });
+  });
+
+  // --- Auth middleware for everything below ---
+
+  const authed = Router();
+  app.use(authed);
+
+  authed.use((req: AuthedRequest, res: Response, next: NextFunction) => {
+    const header = req.headers.authorization;
+    if (!header || !header.startsWith('Bearer ')) {
+      return res.status(401).json({ error: 'missing bearer token' });
+    }
+    const userId = store.tokens.get(header.slice('Bearer '.length));
+    if (!userId) {
+      return res.status(401).json({ error: 'invalid token' });
+    }
+    req.userId = userId;
+    return next();
+  });
+
+  // Resolves the target user of a share request from userId or username.
+  function resolveUser(body: Record<string, unknown>): User | null {
+    if (typeof body.userId === 'string') return store.users.get(body.userId) ?? null;
+    if (typeof body.username === 'string') return store.usersByName.get(body.username) ?? null;
+    return null;
+  }
+
+  function handleShare(
+    req: AuthedRequest,
+    res: Response,
+    resourceType: 'document' | 'folder',
+    resource: Folder | Document,
+    actorRole: Role | null
+  ) {
+    if (!atLeast(actorRole, 'editor')) {
+      return res.status(403).json({ error: 'insufficient permissions to share' });
+    }
+    const body = (req.body ?? {}) as Record<string, unknown>;
+    if (!isRole(body.role)) {
+      return res.status(400).json({ error: 'role must be viewer, editor, or owner' });
+    }
+    if (body.role === 'owner' && actorRole !== 'owner') {
+      return res.status(403).json({ error: 'only owners can grant the owner role' });
+    }
+    const target = resolveUser(body);
+    if (!target) {
+      return res.status(404).json({ error: 'target user not found' });
+    }
+    const existing = resource.shares.get(target.id);
+    if (existing && ROLE_RANK[existing] > ROLE_RANK[body.role] && actorRole !== 'owner') {
+      return res.status(403).json({ error: 'only owners can downgrade roles' });
+    }
+    resource.shares.set(target.id, body.role);
+    logActivity(`${resourceType}.shared`, req.userId as string, resourceType, resource.id);
+    return res.status(200).json({
+      resourceType,
+      resourceId: resource.id,
+      userId: target.id,
+      role: body.role,
+    });
+  }
+
+  // --- Folders ---
+
+  authed.post('/folders', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const { name, parentId } = req.body ?? {};
+    if (typeof name !== 'string' || name.length === 0) {
+      return res.status(400).json({ error: 'name is required' });
+    }
+    let parent: Folder | null = null;
+    if (parentId !== undefined && parentId !== null) {
+      if (typeof parentId !== 'string' || !store.folders.has(parentId)) {
+        return res.status(404).json({ error: 'parent folder not found' });
+      }
+      parent = store.folders.get(parentId) as Folder;
+      if (!atLeast(folderRole(parent.id, userId), 'editor')) {
+        return res.status(403).json({ error: 'insufficient permissions on parent folder' });
+      }
+    }
+    const folder: Folder = {
+      id: randomUUID(),
+      name,
+      parentId: parent ? parent.id : null,
+      ownerId: userId,
+      shares: new Map(),
+      createdAt: new Date().toISOString(),
+    };
+    store.folders.set(folder.id, folder);
+    logActivity('folder.created', userId, 'folder', folder.id);
+    return res.status(201).json(serializeFolder(folder));
+  });
+
+  authed.get('/folders/:id', (req: AuthedRequest, res: Response) => {
+    const folder = store.folders.get(req.params.id);
+    if (!folder) return res.status(404).json({ error: 'folder not found' });
+    const role = folderRole(folder.id, req.userId as string);
+    if (!atLeast(role, 'viewer')) {
+      return res.status(403).json({ error: 'insufficient permissions' });
+    }
+    const children = [...store.folders.values()]
+      .filter((f) => f.parentId === folder.id)
+      .map(serializeFolder);
+    const documents = [...store.documents.values()]
+      .filter((d) => d.folderId === folder.id)
+      .map(serializeDocument);
+    return res.status(200).json({
+      ...serializeFolder(folder),
+      effectiveRole: role,
+      folders: children,
+      documents,
+    });
+  });
+
+  const updateFolder = (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) return res.status(404).json({ error: 'folder not found' });
+    if (!atLeast(folderRole(folder.id, userId), 'editor')) {
+      return res.status(403).json({ error: 'insufficient permissions' });
+    }
+    const { name, parentId } = req.body ?? {};
+    if (name !== undefined) {
+      if (typeof name !== 'string' || name.length === 0) {
+        return res.status(400).json({ error: 'name must be a non-empty string' });
+      }
+      folder.name = name;
+    }
+    if (parentId !== undefined) {
+      if (parentId === null) {
+        folder.parentId = null;
+      } else {
+        if (typeof parentId !== 'string' || !store.folders.has(parentId)) {
+          return res.status(404).json({ error: 'parent folder not found' });
+        }
+        // Reject moves that would create a cycle in the hierarchy.
+        let cursor: string | null = parentId;
+        while (cursor) {
+          if (cursor === folder.id) {
+            return res.status(400).json({ error: 'cannot move a folder into itself' });
+          }
+          cursor = store.folders.get(cursor)?.parentId ?? null;
+        }
+        if (!atLeast(folderRole(parentId, userId), 'editor')) {
+          return res.status(403).json({ error: 'insufficient permissions on parent folder' });
+        }
+        folder.parentId = parentId;
+      }
+    }
+    logActivity('folder.updated', userId, 'folder', folder.id);
+    return res.status(200).json(serializeFolder(folder));
+  };
+  authed.patch('/folders/:id', updateFolder);
+  authed.put('/folders/:id', updateFolder);
+
+  authed.delete('/folders/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) return res.status(404).json({ error: 'folder not found' });
+    if (!atLeast(folderRole(folder.id, userId), 'owner')) {
+      return res.status(403).json({ error: 'only owners can delete' });
+    }
+    // Delete the folder and everything nested under it.
+    const toDelete = [folder.id];
+    for (let i = 0; i < toDelete.length; i++) {
+      for (const f of store.folders.values()) {
+        if (f.parentId === toDelete[i]) toDelete.push(f.id);
+      }
+    }
+    for (const folderId of toDelete) {
+      for (const doc of [...store.documents.values()]) {
+        if (doc.folderId === folderId) {
+          store.documents.delete(doc.id);
+          logActivity('document.deleted', userId, 'document', doc.id);
+        }
+      }
+      store.folders.delete(folderId);
+      logActivity('folder.deleted', userId, 'folder', folderId);
+    }
+    return res.status(204).send();
+  });
+
+  authed.post('/folders/:id/share', (req: AuthedRequest, res: Response) => {
+    const folder = store.folders.get(req.params.id);
+    if (!folder) return res.status(404).json({ error: 'folder not found' });
+    return handleShare(req, res, 'folder', folder, folderRole(folder.id, req.userId as string));
+  });
+
+  // --- Documents ---
+
+  function createDocument(req: AuthedRequest, res: Response, folderId: unknown) {
+    const userId = req.userId as string;
+    const { title, content } = req.body ?? {};
+    if (typeof title !== 'string' || title.length === 0) {
+      return res.status(400).json({ error: 'title is required' });
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    if (typeof folderId !== 'string' || !store.folders.has(folderId)) {
+      return res.status(404).json({ error: 'folder not found' });
+    }
+    if (!atLeast(folderRole(folderId, userId), 'editor')) {
+      return res.status(403).json({ error: 'insufficient permissions on folder' });
+    }
+    const now = new Date().toISOString();
+    const doc: Document = {
+      id: randomUUID(),
+      title,
+      content: typeof content === 'string' ? content : '',
+      folderId,
+      ownerId: userId,
+      shares: new Map(),
+      createdAt: now,
+      updatedAt: now,
+    };
+    store.documents.set(doc.id, doc);
+    logActivity('document.created', userId, 'document', doc.id);
+    return res.status(201).json(serializeDocument(doc));
+  }
+
+  authed.post('/documents', (req: AuthedRequest, res: Response) => {
+    return createDocument(req, res, (req.body ?? {}).folderId);
+  });
+
+  authed.post('/folders/:folderId/documents', (req: AuthedRequest, res: Response) => {
+    return createDocument(req, res, req.params.folderId);
+  });
+
+  authed.get('/documents/:id', (req: AuthedRequest, res: Response) => {
+    const doc = store.documents.get(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    const role = documentRole(doc, req.userId as string);
+    if (!atLeast(role, 'viewer')) {
+      return res.status(403).json({ error: 'insufficient permissions' });
+    }
+    return res.status(200).json({ ...serializeDocument(doc), effectiveRole: role });
+  });
+
+  const updateDocument = (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const doc = store.documents.get(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    if (!atLeast(documentRole(doc, userId), 'editor')) {
+      return res.status(403).json({ error: 'insufficient permissions' });
+    }
+    const { title, content, folderId } = req.body ?? {};
+    if (title !== undefined) {
+      if (typeof title !== 'string' || title.length === 0) {
+        return res.status(400).json({ error: 'title must be a non-empty string' });
+      }
+      doc.title = title;
+    }
+    if (content !== undefined) {
+      if (typeof content !== 'string') {
+        return res.status(400).json({ error: 'content must be a string' });
+      }
+      doc.content = content;
+    }
+    if (folderId !== undefined) {
+      if (typeof folderId !== 'string' || !store.folders.has(folderId)) {
+        return res.status(404).json({ error: 'folder not found' });
+      }
+      if (!atLeast(folderRole(folderId, userId), 'editor')) {
+        return res.status(403).json({ error: 'insufficient permissions on target folder' });
+      }
+      doc.folderId = folderId;
+    }
+    doc.updatedAt = new Date().toISOString();
+    logActivity('document.updated', userId, 'document', doc.id);
+    return res.status(200).json(serializeDocument(doc));
+  };
+  authed.patch('/documents/:id', updateDocument);
+  authed.put('/documents/:id', updateDocument);
+
+  authed.delete('/documents/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId as string;
+    const doc = store.documents.get(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    if (!atLeast(documentRole(doc, userId), 'owner')) {
+      return res.status(403).json({ error: 'only owners can delete' });
+    }
+    store.documents.delete(doc.id);
+    logActivity('document.deleted', userId, 'document', doc.id);
+    return res.status(204).send();
+  });
+
+  authed.post('/documents/:id/share', (req: AuthedRequest, res: Response) => {
+    const doc = store.documents.get(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    return handleShare(req, res, 'document', doc, documentRole(doc, req.userId as string));
+  });
+
+  // --- Activity log ---
+
+  authed.get('/activity', (req: AuthedRequest, res: Response) => {
+    const { resourceType, resourceId, action } = req.query;
+    let entries = store.activity;
+    if (typeof resourceType === 'string') {
+      entries = entries.filter((e) => e.resourceType === resourceType);
+    }
+    if (typeof resourceId === 'string') {
+      entries = entries.filter((e) => e.resourceId === resourceId);
+    }
+    if (typeof action === 'string') {
+      entries = entries.filter((e) => e.action === action);
+    }
+    return res.status(200).json(entries);
+  });
+
+  // Malformed JSON and other errors.
+  app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
+    if (err instanceof SyntaxError) {
+      return res.status(400).json({ error: 'invalid JSON body' });
+    }
+    return res.status(500).json({ error: 'internal server error' });
+  });
+
+  return app;
+}
