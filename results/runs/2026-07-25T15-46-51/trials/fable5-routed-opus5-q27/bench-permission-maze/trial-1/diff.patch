eatedAt: folder.createdAt,\n      shares: Object.fromEntries(folder.shares),\n    };\n  }\n\n  function serializeDocument(doc: Document) {\n    return {\n      id: doc.id,\n      title: doc.title,\n      content: doc.content,\n      folderId: doc.folderId,\n      ownerId: doc.ownerId,\n      createdAt: doc.createdAt,\n      updatedAt: doc.updatedAt,\n      shares: Object.fromEntries(doc.shares),\n    };\n  }\n\n  const app = express();\n  app.use(express.json());\n\n  // --- Auth (public) ---\n\n  app.post('/auth/register', (req: Request, res: Response) => {\n    const { username, password } = req.body ?? {};\n    if (typeof username !== 'string' || username.length === 0) {\n      return res.status(400).json({ error: 'username is required' });\n    }\n    if (typeof password !== 'string' || password.length === 0) {\n      return res.status(400).json({ error: 'password is required' });\n    }\n    if (store.usersByName.has(username)) {\n      return res.status(409).json({ error: 'username already taken' });\n    }\n    const salt = randomBytes(16).toString('hex');\n    const user: User = {\n      id: randomUUID(),\n      username,\n      passwordSalt: salt,\n      passwordHash: hashPassword(password, salt),\n    };\n    store.users.set(user.id, user);\n    store.usersByName.set(username, user);\n    return res.status(201).json({ id: user.id, username: user.username });\n  });\n\n  app.post('/auth/login', (req: Request, res: Response) => {\n    const { username, password } = req.body ?? {};\n    if (typeof username !== 'string' || typeof password !== 'string') {\n      return res.status(400).json({ error: 'username and password are required' });\n    }\n    const user = store.usersByName.get(username);\n    if (!user) {\n      return res.status(401).json({ error: 'invalid credentials' });\n    }\n    const attempt = Buffer.from(hashPassword(password, user.passwordSalt), 'hex');\n    const actual = Buffer.from(user.passwordHash, 'hex');\n    if (!timingSafeEqual(attemp