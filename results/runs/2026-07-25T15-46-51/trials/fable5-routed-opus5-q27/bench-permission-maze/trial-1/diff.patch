+
+  it('GET document returns 200 with content', async () => {
+    const token = await registerAndLogin('user1');
+    const folderId = await makeFolder(token, 'test');
+    const createRes = await request(app)
+      .post(`/folders/${folderId}/documents`)
+      .set('Authorization', `Bearer ${token}`)
+      .send({ title: 'doc', content: 'content' });
+    const docId = createRes.body.id;
+    const res = await request(app)
+      .get(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${token}`);
+    expect(res.status).toBe(200);
+    expect(res.body.content).toBe('content');
+  });
+
+  it('GET unknown document returns 404', async () => {
+    const token = await registerAndLogin('user1');
+    const res = await request(app)
+      .get('/documents/nope')
+      .set('Authorization', `Bearer ${token}`);
+    expect(res.status).toBe(404);
+  });
+
+  it('PATCH updates title and content returns 200', async () => {
+    const token = await registerAndLogin('user1');
+    const folderId = await makeFolder(token, 'test');
+    const createRes = await request(app)
+      .post(`/folders/${folderId}/documents`)
+      .set('Authorization', `Bearer ${token}`)
+      .send({ title: 'old', content: 'old' });
+    const docId = createRes.body.id;
+    const res = await request(app)
+      .patch(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${token}`)
+      .send({ title: 'new', content: 'new' });
+    expect(res.status).toBe(200);
+    expect(res.body.title).toBe('new');
+    expect(res.body.content).toBe('new');
+  });
+
+  it('DELETE returns 204 then GET 404', async () => {
+    const token = await registerAndLogin('user1');
+    const folderId = await makeFolder(token, 'test');
+    const createRes = await request(app)
+      .post(`/folders/${folderId}/documents`)
+      .set('Authorization', `Bearer ${token}`)
+      .send({ title: 'doc', content: 'content' });
+    const docId = createRes.body.id;
+    const delRes = await request(app)
+      .delete(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${token}`);
+    expect(delRes.status).toBe(204);
+    const getRes = await request(app)
+      .get(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${token}`);
+    expect(getRes.status).toBe(404);
+  });
+});
+
+describe('activity', () => {
+  it('creating then updating then deleting a document produces log entries document.created, document.updated, document.deleted each with resourceType document and correct resourceId', async () => {
+    const token = await registerAndLogin('user1');
+    const folderId = await makeFolder(token, 'test');
+    const createRes = await request(app)
+      .post(`/folders/${folderId}/documents`)
+      .set('Authorization', `Bearer ${token}`)
+      .send({ title: 'doc', content: 'content' });
+    const docId = createRes.body.id;
+
+    await request(app)
+      .patch(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${token}`)
+      .send({ title: 'updated' });
+
+    await request(app)
+      .delete(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${token}`);
+
+    const activityRes = await request(app)
+      .get('/activity')
+      .set('Authorization', `Bearer ${token}`);
