+
+  it('create with nonexistent folder returns 404', async () => {
+    const token = await registerAndLogin('user1');
+    const res = await request(app)
+      .post('/documents')
+      .set('Authorization', `Bearer ${token}`)
+      .send({ title: 'doc', content: 'content', folderId: 'nope' });
