+import { describe, it, expect, beforeEach } from 'vitest';
+import request from 'supertest';
+import { createApp } from '../src/app';
+
+let app: ReturnType<typeof createApp>;
+
+beforeEach(() => {
+  app = createApp();
+});
+
+async function registerAndLogin(username: string): Promise<{ token: string; userId: string }> {
+  await request(app).post('/auth/register').send({ username, password: `pw-${username}` });
+  const res = await request(app).post('/auth/login').send({ username, password: `pw-${username}` });
+  return { token: res.body.token, userId: res.body.userId };
+}
+
+const auth = (token: string) => ({ Authorization: `Bearer ${token}` });
+
+async function makeFolder(token: string, name: string, parentId?: string): Promise<string> {
+  const res = await request(app).post('/folders').set(auth(token)).send({ name, parentId });
+  expect(res.status).toBe(201);
+  return res.body.id;
+}
+
+async function makeDoc(token: string, folderId: string, title = 'doc'): Promise<string> {
+  const res = await request(app)
+    .post(`/folders/${folderId}/documents`)
+    .set(auth(token))
+    .send({ title, content: 'hello' });
+  expect(res.status).toBe(201);
+  return res.body.id;
+}
+
+async function share(
+  token: string,
+  resourceType: 'folders' | 'documents',
+  id: string,
+  userId: string,
+  role: string
+) {
+  return request(app).post(`/${resourceType}/${id}/share`).set(auth(token)).send({ userId, role });
+}
+
+describe('access control basics', () => {
+  it('denies access to users with no share', async () => {
+    const alice = await registerAndLogin('alice');
+    const mallory = await registerAndLogin('mallory');
+    const folderId = await makeFolder(alice.token, 'private');
+    const docId = await makeDoc(alice.token, folderId);
+
+    expect((await request(app).get(`/folders/${folderId}`).set(auth(mallory.token))).status).toBe(403);
+    expect((await request(app).get(`/documents/${docId}`).set(auth(mallory.token))).status).toBe(403);
+    expect(
+      (await request(app).delete(`/documents/${docId}`).set(auth(mallory.token))).status
+    ).toBe(403);
+  });
+
+  it('viewer can read but not modify, delete, or share', async () => {
+    const alice = await registerAndLogin('alice');
+    const bob = await registerAndLogin('bob');
+    const carol = await registerAndLogin('carol');
+    const folderId = await makeFolder(alice.token, 'f');
+    const docId = await makeDoc(alice.token, folderId);
+
+    expect((await share(alice.token, 'documents', docId, bob.userId, 'viewer')).status).toBe(200);
+
+    const read = await request(app).get(`/documents/${docId}`).set(auth(bob.token));
+    expect(read.status).toBe(200);
+    expect(read.body.effectiveRole).toBe('viewer');
+
+    expect(
+      (await request(app).patch(`/documents/${docId}`).set(auth(bob.token)).send({ title: 'x' }))
+        .status
+    ).toBe(403);
+    expect((await request(app).delete(`/documents/${docId}`).set(auth(bob.token))).status).toBe(403);
+    expect((await share(bob.token, 'documents', docId, carol.userId, 'viewer')).status).toBe(403);
+  });
+
+  it('editor can read, modify, and share, but not delete or grant owner', async () => {
+    const alice = await registerAndLogin('alice');
+    const bob = await registerAndLogin('bob');
+    const carol = await registerAndLogin('carol');
+    const folderId = await makeFolder(alice.token, 'f');
+    const docId = await makeDoc(alice.token, folderId);
+
+    await share(alice.token, 'documents', docId, bob.userId, 'editor');
+
+    const update = await request(app)
+      .patch(`/documents/${docId}`)
+      .set(auth(bob.token))
+      .send({ content: 'edited by bob' });
+    expect(update.status).toBe(200);
+    expect(update.body.content).toBe('edited by bob');
+
+    expect((await share(bob.token, 'documents', docId, carol.userId, 'viewer')).status).toBe(200);
+    expect((await share(bob.token, 'documents', docId, carol.userId, 'owner')).status).toBe(403);
+    expect((await request(app).delete(`/documents/${docId}`).set(auth(bob.token))).status).toBe(403);
+  });
+
+  it('a granted owner has full control', async () => {
+    const alice = await registerAndLogin('alice');
+    const bob = await registerAndLogin('bob');
+    const folderId = await makeFolder(alice.token, 'f');
+    const docId = await makeDoc(alice.token, folderId);
+
+    await share(alice.token, 'documents', docId, bob.userId, 'owner');
+    expect((await request(app).delete(`/documents/${docId}`).set(auth(bob.token))).status).toBe(204);
+  });
+
+  it('rejects invalid roles and unknown target users', async () => {
+    const alice = await registerAndLogin('alice');
+    const folderId = await makeFolder(alice.token, 'f');
+    const docId = await makeDoc(alice.token, folderId);
+
+    expect((await share(alice.token, 'documents', docId, 'nobody', 'viewer')).status).toBe(404);
+    const bad = await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(alice.token))
+      .send({ userId: alice.userId, role: 'superadmin' });
+    expect(bad.status).toBe(400);
+  });
+
+  it('supports sharing by username', async () => {
+    const alice = await registerAndLogin('alice');
+    const bob = await registerAndLogin('bob');
+    const folderId = await makeFolder(alice.token, 'f');
+    const docId = await makeDoc(alice.token, folderId);
+
+    const res = await request(app)
+      .post(`/documents/${docId}/share`)
+      .set(auth(alice.token))
+      .send({ username: 'bob', role: 'viewer' });
+    expect(res.status).toBe(200);
+    expect((await request(app).get(`/documents/${docId}`).set(auth(bob.token))).status).toBe(200);
+  });
+});
+
+describe('folder permission inheritance', () => {
+  it('folder share grants access to documents inside', async () => {
+    const alice = await registerAndLogin('alice');
+    const bob = await registerAndLogin('bob');
+    const folderId = await makeFolder(alice.token, 'shared');
+    const docId = await makeDoc(alice.token, folderId);
+
+    await share(alice.token, 'folders', folderId, bob.userId, 'viewer');
+    const read = await request(app).get(`/documents/${docId}`).set(auth(bob.token));
+    expect(read.status).toBe(200);
+    expect(read.body.effectiveRole).toBe('viewer');
+  });
+
+  it('folder share is inherited through nested subfolders', async () => {
+    const alice = await registerAndLogin('alice');
+    const bob = await registerAndLogin('bob');
+    const rootId = await makeFolder(alice.token, 'root');
+    const midId = await makeFolder(alice.token, 'mid', rootId);
+    const leafId = await makeFolder(alice.token, 'leaf', midId);
+    const docId = await makeDoc(alice.token, leafId);
+
+    await share(alice.token, 'folders', rootId, bob.userId, 'editor');
+
+    expect((await request(app).get(`/folders/${leafId}`).set(auth(bob.token))).status).toBe(200);
+    const update = await request(app)
+      .patch(`/documents/${docId}`)
+      .set(auth(bob.token))
+      .send({ title: 'renamed' });
+    expect(update.status).toBe(200);
+  });
+
+  it('editor on a folder can create documents in it; viewer cannot', async () => {
+    const alice = await registerAndLogin('alice');
+    const bob = await registerAndLogin('bob');
+    const carol = await registerAndLogin('carol');
+    const folderId = await makeFolder(alice.token, 'f');
+
+    await share(alice.token, 'folders', folderId, bob.userId, 'editor');
+    await share(alice.token, 'folders', folderId, carol.userId, 'viewer');
+
+    const byEditor = await request(app)
+      .post(`/folders/${folderId}/documents`)
+      .set(auth(bob.token))
+      .send({ title: 't', content: 'c' });
+    expect(byEditor.status).toBe(201);
+
+    const byViewer = await request(app)
+      .post(`/folders/${folderId}/documents`)
+      .set(auth(carol.token))
+      .send({ title: 't', content: 'c' });
+    expect(byViewer.status).toBe(403);
+  });
+
+  it('most permissive role wins across multiple access paths', async () => {
+    const alice = await registerAndLogin('alice');
+    const bob = await registerAndLogin('bob');
+    const folderId = await makeFolder(alice.token, 'f');
+    const docId = await makeDoc(alice.token, folderId);
+
+    // viewer directly on the document, editor via the folder -> effective editor
+    await share(alice.token, 'documents', docId, bob.userId, 'viewer');
+    await share(alice.token, 'folders', folderId, bob.userId, 'editor');
+
+    const read = await request(app).get(`/documents/${docId}`).set(auth(bob.token));
+    expect(read.body.effectiveRole).toBe('editor');
+    expect(
+      (await request(app).patch(`/documents/${docId}`).set(auth(bob.token)).send({ title: 'y' }))
+        .status
+    ).toBe(200);
+  });
+
+  it('deleting a folder removes nested folders and documents', async () => {
+    const alice = await registerAndLogin('alice');
+    const rootId = await makeFolder(alice.token, 'root');
+    const subId = await makeFolder(alice.token, 'sub', rootId);
+    const docId = await makeDoc(alice.token, subId);
+
+    expect((await request(app).delete(`/folders/${rootId}`).set(auth(alice.token))).status).toBe(204);
+    expect((await request(app).get(`/folders/${subId}`).set(auth(alice.token))).status).toBe(404);
+    expect((await request(app).get(`/documents/${docId}`).set(auth(alice.token))).status).toBe(404);
+  });
+
+  it('rejects moving a folder into its own descendant', async () => {
+    const alice = await registerAndLogin('alice');
+    const rootId = await makeFolder(alice.token, 'root');
+    const subId = await makeFolder(alice.token, 'sub', rootId);
+
+    const res = await request(app)
+      .patch(`/folders/${rootId}`)
+      .set(auth(alice.token))
+      .send({ parentId: subId });
+    expect(res.status).toBe(400);
+  });
+});
+
+describe('sharing activity', () => {
+  it('logs share events with actor and resource', async () => {
+    const alice = await registerAndLogin('alice');
+    const bob = await registerAndLogin('bob');
+    const folderId = await makeFolder(alice.token, 'f');
+    const docId = await makeDoc(alice.token, folderId);
+
+    await share(alice.token, 'documents', docId, bob.userId, 'viewer');
+    await share(alice.token, 'folders', folderId, bob.userId, 'viewer');
+
+    const res = await request(app).get('/activity').set(auth(alice.token));
+    expect(res.status).toBe(200);
+    const docShare = res.body.find((e: { action: string }) => e.action === 'document.shared');
+    expect(docShare).toMatchObject({
+      userId: alice.userId,
+      resourceType: 'document',
+      resourceId: docId,
+    });
+    expect(typeof docShare.timestamp).toBe('string');
+    const folderShare = res.body.find((e: { action: string }) => e.action === 'folder.shared');
+    expect(folderShare).toMatchObject({ resourceType: 'folder', resourceId: folderId });
+  });
+});
