+    const deleted = entries.find((e: any) => e.action === 'document.deleted');
+    expect(deleted).toBeDefined();
+    expect(deleted.resourceType).toBe('document');
+    expect(deleted.resourceId).toBe(docId);
+  });
+
+  it('GET /activity without token returns 401', async () => {
+    const res = await request(app).get('/activity');
+    expect(res.status).toBe(401);
+  });
