rce.shares.get(target.id);\n    if (existing && ROLE_RANK[existing] > ROLE_RANK[body.role] && actorRole !== 'owner') {\n      return res.status(403).json({ error: 'only owners can downgrade roles' });\n    }\n    resource.shares.set(target.id, body.role);\n    logActivity(`${resourceType}.shared`, req.userId as string, resourceType, resource.id);\n    return res.status(200).json({\n      resourceType,\n      resourceId: resource.id,\n      userId: target.id,\n      role: body.role,\n    });\n  }\n\n  // --- Folders ---\n\n  authed.post('/folders', (req: AuthedRequest, res: Response) => {\n    const userId = req.userId as string;\n    const { name, parentId } = req.body ?? {};\n    if (typeof name !== 'string' || name.length === 0) {\n      return res.status(400).json({ error: 'name is required' });\n    }\n    let parent: Folder | null = null;\n    if (parentId !== undefined && parentId !== null) {\n      if (typeof parentId !== 'string' || !store.folders.has(parentId)) {\n        return res.status(404).json({ error: 'parent folder not found' });\n      }\n      parent = store.folders.get(parentId) as Folder;\n      if (!atLeast(folderRole(parent.id, userId), 'editor')) {\n        return res.status(403).json({ error: 'insufficient permissions on parent folder' });\n      }\n    }\n    const folder: Folder = {\n      id: randomUUID(),\n      name,\n      parentId: parent ? parent.id : null,\n      ownerId: userId,\n      shares: new Map(),\n      createdAt: new Date().toISOString(),\n    };\n    store.folders.set(folder.id, folder);\n    logActivity('folder.created', userId, 'folder', folder.id);\n    return res.status(201).json(serializeFolder(folder));\n  });\n\n  authed.get('/folders/:id', (req: AuthedRequest, res: Response) => {\n    const folder = store.folders.get(req.params.id);\n    if (!folder) return res.status(404).json({ error: 'folder not found' });\n    const role = folderRole(folder.id, req.userId as string);\n    if (!atLeast(role, 'viewer')) {\n      return res.status(403).json({ error: 'insufficient permissions' });\n    }\n    const children = [...store.folders.values()]\n      .filter((f) => f.parentId === folder.id)\n      .map(serializeFolder);\n    const documents = [...store.documents.values()]\n      .filter((d) => d.folderId === folder.id)\n      .map(serializeDocument);\n    return res.status(200).json({\n      ...serializeFolder(folder),\n      effectiveRole: role,\n      folders: children,\n      documents,\n    });\n  });\n\n  const updateFolder = (req: AuthedRequest, res: Response) => {\n    const userId = req.userId as string;\n    const folder = store.folders.get(req.params.id);\n    if (!folder) return res.status(404).json({ error: 'folder not found' });\n    if (!atLeast(folderRole(folder.id, userId), 'editor')) {\n      return res.status(403).json({ error: 'insufficient permissions' });\n    }\n    const { name, parentId } = req.body ?? {};\n    if (name !== undefined) {\n      if (typeof name !== 'string' || name.length === 0) {\n        return res.status(400).json({ error: 'name must be a non-empty string' });\n      }\n      folder.name = name;\n    }\n    if (parentId !== undefined) {\n      if (parentId === null) {\n        folder.parentId = null;\n      } else {\n        if (typeof parentId !== 'string' || !store.folders.has(parentId)) {\n          return res.status(404).json({ error: 'parent folder not found' });\n        }\n        // Reject moves that would create a cycle in the hierarchy.\n        let cursor: string | null = parentId;\n        while (cursor) {\n          if (cursor === folder.id) {\n            return res.status(400).json({ error: 'cannot move a folder into itself' });\n          }\n          cursor = store.folders.get(cursor)?.parentId ?? null;\n        }\n        if (!atLeast(folderRole(parentId, userId), 'editor')) {\n          return res.status(403).json({ error: 'insufficient permissions on parent folder' });\n        }\n        folder.parentId = parentId;\n   