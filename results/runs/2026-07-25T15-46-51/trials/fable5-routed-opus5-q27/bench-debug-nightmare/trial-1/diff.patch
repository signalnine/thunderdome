nt',\n} as const;\nexport interface NotificationRecord {\n  type: string;\n  orderId: string;\n  message: string;\n  sentAt: number;\n}\n\nexport class NotificationService {\n  private templates: Map<string, string>;\n  private sent: NotificationRecord[] = [];\n\n  constructor() {\n    this.templates = new Map([\n      ['order.confirmed', 'Your order {orderId} has been confirmed. Total: ${total}'],\n      ['order.cancelled', 'Your order {orderId} has been cancelled. Reason: {reason}'],\n      ['order.refunded', 'Your refund of ${amount} for order {orderId} has been processed.'],\n    ]);\n  }\n\n  sendConfirmation(orderId: string, total: number): NotificationRecord {\n    const template = this.templates.get('order.confirmed')!;\n    const message = template\n      .replace('{orderId}', orderId)\n      .replace('{total}', total.toFixed(2));\n    const record: NotificationRecord = {\n      type: 'confirmation',\n      orderId,\n      message,\n      sentAt: Date.now(),\n    };\n    this.sent.push(record);\n    return record;\n  }\n\n  sendCancellation(orderId: string, reason: string): NotificationRecord {\n    const template = this.templates.get('order.cancelled')!;\n    const message = template\n      .replace('{orderId}', orderId)\n      .replace('{reason}', reason);\n    const record: NotificationRecord = {\n      type: 'cancellation',\n      orderId,\n      message,\n      sentAt: Date.now(),\n    };\n    this.sent.push(record);\n    return record;\n  }\n\n  sendRefundNotice(orderId: string, amount: number): NotificationRecord {\n    const template = this.templates.get('order.refunded')!;\n    const message = template\n      .replace('{orderId}', orderId)\n      .replace('{amount}', amount.toFixed(2));\n    const record: NotificationRecord = {\n      type: 'refund',\n      orderId,\n      message,\n      sentAt: Date.now(),\n    };\n    this.sent.push(record);\n    return record;\n  }\n\n  getSentNotifications(): NotificationRecord[] {\n    return [...this.sent];\n  }\n\n  clear(): void {\n    this.sent = [];\n  }\n}\nexport { EventBus } from './events/bus.js';\nexport { ORDER_EVENTS } from './events/types.js';\nexport type {\n  OrderEvent,\n  OrderCreatedEvent,\n  OrderCancelledEvent,\n  OrderRefundedEvent,\n  PaymentChargedEvent,\n  StockReservedEvent,\n} from './events/types.js';\n\nexport { OrderRepository } from './orders/repository.js';\nexport type { Order, OrderItem, OrderStatus } from './orders/repository.js';\nexport { OrderService } from './orders/service.js';\n\nexport { InventoryRepository } from './inventory/repository.js';\nexport type { StockRecord } from './inventory/repository.js';\nexport { InventoryService } from './inventory/service.js';\n\nexport { BillingService } from './billing/service.js';\nexport type { PaymentRecord } from './billing/service.js';\nexport { calculateOrderTotal } from './billing/calculator.js';\nexport type { PriceBreakdown } from './billing/calculator.js';\n\nexport { NotificationService } from './notifications/service.js';\nexport type { NotificationRecord } from './notifications/service.js';","is_error":false}]},"parent_tool_use_id":null,"session_id":"445862ff-7d07-4488-8aab-07c5b848d863","uuid":"dae0e244-e543-42b5-9bd6-51ae4c7f8778","timestamp":"2026-07-25T15:57:29.080Z","tool_use_result":{"stdout":"export type EventHandler = (data: unknown) => void | Promise<void>;\n\n// Module-level handler registry — shared across all EventBus instances\nconst globalHandlers: Map<string, EventHandler[]> = new Map();\n\nexport class EventBus {\n  on(event: string, handler: EventHandler): void {\n    const existing = globalHandlers.get(event) ?? [];\n    existing.push(handler);\n    globalHandlers.set(event, existing);\n  }\n\n  off(event: string, handler: EventHandler): void {\n    const existing = globalHandlers.get(event);\n    if (!existing) return;\n    globalHandlers.set(\n      event,\n      existing.filter((h) => h !== handler)\n    );\n  }\n\n  async emit(event: string, data: unknown):