+import { readFileSync, writeFileSync, mkdirSync, existsSync } from 'fs';
+import { dirname } from 'path';
+
+export interface Entry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+export class TimeTracker {
+  private entries: Entry[];
+  private readonly filePath: string;
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    if (existsSync(filePath)) {
+      try {
+        const content = readFileSync(filePath, 'utf8');
+        this.entries = JSON.parse(content) as Entry[];
+      } catch {
+        this.entries = [];
+      }
+    } else {
+      this.entries = [];
+    }
+  }
+
+  private save(): void {
+    mkdirSync(dirname(this.filePath), { recursive: true });
+    writeFileSync(this.filePath, JSON.stringify(this.entries, null, 2), 'utf8');
+  }
+
+  start(taskName: string): Entry {
+    if (taskName === '') {
+      throw new Error('Task name must not be empty');
+    }
+    const activeEntry = this.entries.find((e) => e.endTime === null);
+    if (activeEntry) {
+      activeEntry.endTime = new Date().toISOString();
+    }
+    const entry: Entry = {
+      taskName,
+      startTime: new Date().toISOString(),
+      endTime: null,
+    };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  stop(): Entry {
+    const activeEntry = this.entries.find((e) => e.endTime === null);
+    if (!activeEntry) {
+      throw new Error('No task is currently running');
+    }
+    activeEntry.endTime = new Date().toISOString();
+    this.save();
+    return activeEntry;
+  }
+
+  getActiveTask(): Entry | null {
+    return this.entries.find((e) => e.endTime === null) ?? null;
+  }
+
+  getLog(options?: { since?: Date }): Entry[] {
+    if (!options || !options.since) {
+      return [...this.entries];
+    }
+    const sinceTime = options.since.getTime();
+    return this.entries.filter((entry) => {
+      const startTime = new Date(entry.startTime).getTime();
+      if (startTime >= sinceTime) {
+        return true;
+      }
+      if (entry.endTime === null) {
+        return true;
+      }
+      const endTime = new Date(entry.endTime).getTime();
+      if (endTime >= sinceTime) {
+        return true;
+      }
+      return false;
+    });
+  }
+
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+    for (const entry of this.entries) {
+      const startTime = new Date(entry.startTime).getTime();
+      const endTime = entry.endTime ? new Date(entry.endTime).getTime() : Date.now();
+      const duration = endTime - startTime;
+      if (summary[entry.taskName] === undefined) {
+        summary[entry.taskName] = 0;
+      }
+      summary[entry.taskName] += duration;
+    }
+    return summary;
+  }
+}
