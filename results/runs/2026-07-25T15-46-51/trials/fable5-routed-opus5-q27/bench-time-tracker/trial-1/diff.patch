;\n    expect(typeof entry.startTime).toBe('string');\n    expect(typeof entry.endTime).toBe('string');\n  });\n\n  // 16. Summary durations are positive numbers\n  it('summary durations are positive numbers', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('positive task');\n    const s = Date.now();\n    while (Date.now() - s < 5) { /* busy wait */ }\n    tracker.stop();\n    const summary = tracker.getSummary();\n    expect(summary['positive task']).toBeGreaterThanOrEqual(0);\n    expect(typeof summary['positive task']).toBe('number');\n  });\n\n  // 17. Since filter with future date returns empty array\n  it('getLog({ since }) with future date returns empty array', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('past task');\n    tracker.stop();\n    const futureDate = new Date(Date.now() + 86400000); // tomorrow\n    const filtered = tracker.getLog({ since: futureDate });\n    expect(filtered).toHaveLength(0);\n  });\n\n  // 18. Since filter with old date returns all entries\n  it('getLog({ since }) with old date returns all entries', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('task 1');\n    tracker.stop();\n    tracker.start('task 2');\n    tracker.stop();\n    const oldDate = new Date('2000-01-01');\n    const filtered = tracker.getLog({ since: oldDate });\n    expect(filtered).toHaveLength(2);\n  });\n\n  // 19. Stop returns the stopped entry\n  it('stop() returns the stopped entry', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('stoppable task');\n    const stopped = tracker.stop();\n    expect(stopped.taskName).toBe('stoppable task');\n    expect(stopped.endTime).toBeTruthy();\n  });\n\n  // 20. Auto-stop returns/logs the auto-stopped task info\n  it('auto-stop returns the new entry and the previous task is stopped', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('first task');\n    const newEntry = tracker.start('second task');\n    expect(newEntry.taskName).toBe('second task');\n    const log = tracker.getLog();\n    const first = log.find(e => e.taskName === 'first task');\n    expect(first!.endTime).toBeTruthy();\n  });\n\n  // 21. Concurrent start calls don't corrupt data\n  it('rapid sequential start calls do not corrupt data', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('rapid 1');\n    tracker.start('rapid 2');\n    tracker.start('rapid 3');\n    const log = tracker.getLog();\n    expect(log).toHaveLength(3);\n    const active = log.filter(e => e.endTime === null);\n    expect(active).toHaveLength(1);\n    expect(active[0].taskName).toBe('rapid 3');\n  });\n\n  // 22. Summary with no entries returns empty object\n  it('getSummary() with no entries returns empty object', () => {\n    const tracker = new TimeTracker(filePath);\n    const summary = tracker.getSummary();\n    expect(summary).toEqual({});\n  });\n\n  // 23. Log with no entries returns empty array\n  it('getLog() with no entries returns empty array', () => {\n    const tracker = new TimeTracker(filePath);\n    const log = tracker.getLog();\n    expect(log).toEqual([]);\n  });\n\n  // 24. File is created if it doesn't exist\n  it('creates the data file if it does not exist', () => {\n    const newPath = join(tempDir, 'nonexistent.json');\n    expect(existsSync(newPath)).toBe(false);\n    const tracker = new TimeTracker(newPath);\n    tracker.start('creation test');\n    tracker.stop();\n    expect(existsSync(newPath)).toBe(true);\n  });\n\n  // 25. File path is configurable\n  it('file path is configurable', () => {\n    const customPath = join(tempDir, 'custom', 'path', 'data.json');\n    const tracker = new TimeTracker(customPath);\n    tracker.start('custom path task');\n    tracker.stop();\n    expect(existsSync(customPath)).toBe(true);\n\n    const tracker2 = new TimeTracker(customPath);\n    const log = tracker2.getLog();\n    expect(log).toHaveLength(1);\n    expect(log