his starts\n  preferredRoom?: string; // room ID hint, not a hard constraint\n}\n\nexport interface Room {\n  id: string;\n  name: string;\n  capacity: number;\n}\n\nexport interface ScheduleOptions {\n  startTime: number; // minutes from midnight\n  endTime: number; // minutes from midnight\n  gap?: number; // min gap between events in the same room (default 15)\n}\n\nexport interface Assignment {\n  eventId: string;\n  roomId: string;\n  startTime: number;\n  endTime: number;\n}\n\nexport interface ScheduleResult {\n  assignments: Assignment[];\n  unscheduled: string[];\n}\n\ninterface Booking {\n  start: number;\n  end: number;\n}\n\ninterface GreedyOutcome {\n  assignments: Map<string, Assignment>;\n  unscheduled: Set<string>;\n  preferencesHonored: number;\n}\n\ntype Comparator = (a: Event, b: Event) => number;\n\n/**\n * Orders the ready queue before each pick. Receives the current earliest\n * feasible start of each ready event so orderings can react to how the\n * rooms have filled up so far.\n */\ntype ReadySorter = (ready: Event[], earliestStartOf: (e: Event) => number) => void;\n\nfunction detectCycles(events: Event[], eventMap: Map<string, Event>): void {\n  const WHITE = 0,\n    GRAY = 1,\n    BLACK = 2;\n  const color = new Map<string, number>();\n  for (const e of events) color.set(e.id, WHITE);\n\n  const visit = (id: string): void => {\n    color.set(id, GRAY);\n    const ev = eventMap.get(id);\n    for (const p of ev?.prerequisites ?? []) {\n      if (!eventMap.has(p)) continue;\n      const c = color.get(p);\n      if (c === GRAY) {\n        throw new Error(`Prerequisite cycle detected involving event \"${p}\"`);\n      }\n      if (c === WHITE) visit(p);\n    }\n    color.set(id, BLACK);\n  };\n\n  for (const e of events) {\n    if (color.get(e.id) === WHITE) visit(e.id);\n  }\n}\n\n/**\n * Earliest start >= from at which [start, start + duration] fits into the\n * room's booking list with `gap` minutes of separation, ending by windowEnd.\n * Returns null if it cannot fit.\n */\nfunction earliestSlot(\n  bookings: Booking[],\n  from: number,\n  duration: number,\n  gap: number,\n  windowEnd: number\n): number | null {\n  let start = from;\n  for (const b of bookings) {\n    if (start + duration + gap <= b.start) break; // fits before this booking\n    if (start < b.end + gap) start = b.end + gap; // pushed past this booking\n  }\n  return start + duration <= windowEnd ? start : null;\n}\n\nfunction insertBooking(bookings: Booking[], booking: Booking): void {\n  let i = 0;\n  while (i < bookings.length && bookings[i].start < booking.start) i++;\n  bookings.splice(i, 0, booking);\n}\n\nfunction runGreedy(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions,\n  gap: number,\n  sortReady: ReadySorter,\n  strictPreference: boolean\n): GreedyOutcome {\n  const eventMap = new Map(events.map((e) => [e.id, e]));\n  const assignments = new Map<string, Assignment>();\n  const unscheduled = new Set<string>();\n  const bookings = new Map<string, Booking[]>(rooms.map((r) => [r.id, []]));\n  let preferencesHonored = 0;\n\n  // Kahn's algorithm over prerequisites that reference known events; a\n  // prerequisite pointing at an unknown event can never be satisfied.\n  const indegree = new Map<string, number>();\n  const dependents = new Map<string, string[]>();\n  const missingPrereq = new Set<string>();\n  for (const e of events) {\n    let deg = 0;\n    for (const p of e.prerequisites ?? []) {\n      if (eventMap.has(p)) {\n        deg++;\n        const list = dependents.get(p) ?? [];\n        list.push(e.id);\n        dependents.set(p, list);\n      } else {\n        missingPrereq.add(e.id);\n      }\n    }\n    indegree.set(e.id, deg);\n  }\n\n  const ready: Event[] = events.filter((e) => indegree.get(e.id) === 0);\n\n  while (ready.length > 0) {\n    ready.sort(compare);\n    const event = ready.shift() as Event;\n\n    const release = (): void => {\n      for (const depId of dependents.get(event.id) ?? [