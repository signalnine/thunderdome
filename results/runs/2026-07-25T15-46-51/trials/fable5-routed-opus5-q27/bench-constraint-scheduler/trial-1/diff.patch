const cp = (id: string): number => {\n    const cached = memo.get(id);\n    if (cached !== undefined) return cached;\n    const ev = eventMap.get(id) as Event;\n    let tail = 0;\n    for (const d of dependents.get(id) ?? []) {\n      tail = Math.max(tail, gap + cp(d));\n    }\n    const result = ev.duration + tail;\n    memo.set(id, result);\n    return result;\n  };\n  for (const e of events) cp(e.id);\n  return memo;\n}\n\nexport function schedule(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions\n): ScheduleResult {\n  const gap = options.gap ?? 15;\n  const eventMap = new Map(events.map((e) => [e.id, e]));\n  detectCycles(events, eventMap);\n\n  const index = new Map(events.map((e, i) => [e.id, i]));\n  const cp = criticalPaths(events, gap);\n  const attendeesOf = (e: Event): number => e.attendees ?? 1;\n  const roomChoices = (e: Event): number =>\n    rooms.filter((r) => r.capacity >= attendeesOf(e)).length;\n\n  const byIndex: Comparator = (a, b) =>\n    (index.get(a.id) as number) - (index.get(b.id) as number);\n  const byCp: Comparator = (a, b) =>\n    (cp.get(b.id) as number) - (cp.get(a.id) as number);\n  const staticOrderings: Comparator[] = [\n    (a, b) => byCp(a, b) || byIndex(a, b),\n    (a, b) =>\n      roomChoices(a) - roomChoices(b) ||\n      attendeesOf(b) - attendeesOf(a) ||\n      byIndex(a, b),\n    (a, b) =>\n      attendeesOf(b) - attendeesOf(a) ||\n      b.duration - a.duration ||\n      byIndex(a, b),\n    (a, b) => a.duration - b.duration || byIndex(a, b),\n    (a, b) => b.duration - a.duration || byIndex(a, b),\n    byIndex,\n  ];\n  const sorters: ReadySorter[] = staticOrderings.map(\n    (cmp) => (ready) => ready.sort(cmp)\n  );\n  // Dynamic ordering: react to how rooms have filled up so far — events\n  // whose feasible start is earliest go first, keeping tight slots usable.\n  sorters.push((ready, earliestStartOf) => {\n    const starts = new Map(ready.map((e) => [e.id, earliestStartOf(e)]));\n    ready.sort((a, b) => {\n      const sa = starts.get(a.id) as number;\n      const sb = starts.get(b.id) as number;\n      if (sa !== sb) return sa < sb ? -1 : 1; // safe for Infinity\n      return byCp(a, b) || byIndex(a, b);\n    });\n  });\n\n  let best: GreedyOutcome | null = null;\n  for (const strictPreference of [true, false]) {\n    for (const sortReady of sorters) {\n      const outcome = runGreedy(\n        events,\n        rooms,\n        options,\n        gap,\n        sortReady,\n        strictPreference\n      );\n      if (\n        best === null ||\n        outcome.assignments.size > best.assignments.size ||\n        (outcome.assignments.size === best.assignments.size &&\n          outcome.preferencesHonored > best.preferencesHonored)\n      ) {\n        best = outcome;\n      }\n    }\n  }\n\n  const result = best as GreedyOutcome;\n  const assignments = [...result.assignments.values()].sort(\n    (a, b) =>\n      a.startTime - b.startTime || a.eventId.localeCompare(b.eventId)\n  );\n  const unscheduled = events\n    .filter((e) => result.unscheduled.has(e.id))\n    .map((e) => e.id);\n  return { assignments, unscheduled };\n}\n\nexport class Scheduler {\n  schedule(\n    events: Event[],\n    rooms: Room[],\n    options: ScheduleOptions\n  ): ScheduleResult {\n    return schedule(events, rooms, options);\n  }\n}\n\nexport function createScheduler(): Scheduler {\n  return new Scheduler();\n}\n\nexport default schedule;\n","structuredPatch":[{"oldStart":316,"oldLines":10,"newStart":316,"newLines":25,"lines":["       attendeesOf(b) - attendeesOf(a) ||","       b.duration - a.duration ||","       byIndex(a, b),","+    (a, b) =>","+      attendeesOf(b) - attendeesOf(a) ||","+      a.duration - b.duration ||","+      byIndex(a, b),","     (a, b) => a.duration - b.duration || byIndex(a, b),","     (a, b) => b.duration - a.duration || byIndex(a, b),","     byIndex,","   ];","+  // Random-restart orderings escape traps none of the fixed heuristics","+  // cover (e.g. a high-c