id, result);\n    return result;\n  };\n  for (const e of events) cp(e.id);\n  return memo;\n}\n\nexport function schedule(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions\n): ScheduleResult {\n  const gap = options.gap ?? 15;\n  const eventMap = new Map(events.map((e) => [e.id, e]));\n  detectCycles(events, eventMap);\n\n  const index = new Map(events.map((e, i) => [e.id, i]));\n  const cp = criticalPaths(events, gap);\n  const attendeesOf = (e: Event): number => e.attendees ?? 1;\n  const roomChoices = (e: Event): number =>\n    rooms.filter((r) => r.capacity >= attendeesOf(e)).length;\n\n  const byIndex: Comparator = (a, b) =>\n    (index.get(a.id) as number) - (index.get(b.id) as number);\n  const orderings: Comparator[] = [\n    (a, b) =>\n      (cp.get(b.id) as number) - (cp.get(a.id) as number) || byIndex(a, b),\n    (a, b) =>\n      roomChoices(a) - roomChoices(b) ||\n      attendeesOf(b) - attendeesOf(a) ||\n      byIndex(a, b),\n    (a, b) =>\n      attendeesOf(b) - attendeesOf(a) ||\n      b.duration - a.duration ||\n      byIndex(a, b),\n    (a, b) => a.duration - b.duration || byIndex(a, b),\n    (a, b) => b.duration - a.duration || byIndex(a, b),\n    byIndex,\n  ];\n\n  let best: GreedyOutcome | null = null;\n  for (const strictPreference of [true, false]) {\n    for (const compare of orderings) {\n      const outcome = runGreedy(\n        events,\n        rooms,\n        options,\n        gap,\n        compare,\n        strictPreference\n      );\n      if (\n        best === null ||\n        outcome.assignments.size > best.assignments.size ||\n        (outcome.assignments.size === best.assignments.size &&\n          outcome.preferencesHonored > best.preferencesHonored)\n      ) {\n        best = outcome;\n      }\n    }\n  }\n\n  const result = best as GreedyOutcome;\n  const assignments = [...result.assignments.values()].sort(\n    (a, b) =>\n      a.startTime - b.startTime || a.eventId.localeCompare(b.eventId)\n  );\n  const unscheduled = events\n    .filter((e) => result.unscheduled.has(e.id))\n    .map((e) => e.id);\n  return { assignments, unscheduled };\n}\n\nexport class Scheduler {\n  schedule(\n    events: Event[],\n    rooms: Room[],\n    options: ScheduleOptions\n  ): ScheduleResult {\n    return schedule(events, rooms, options);\n  }\n}\n\nexport function createScheduler(): Scheduler {\n  return new Scheduler();\n}\n\nexport default schedule;\n","structuredPatch":[{"oldStart":44,"oldLines":6,"newStart":44,"newLines":13,"lines":[" "," type Comparator = (a: Event, b: Event) => number;"," ","+/**","+ * Orders the ready queue before each pick. Receives the current earliest","+ * feasible start of each ready event so orderings can react to how the","+ * rooms have filled up so far.","+ */","+type ReadySorter = (ready: Event[], earliestStartOf: (e: Event) => number) => void;","+"," function detectCycles(events: Event[], eventMap: Map<string, Event>): void {","   const WHITE = 0,","     GRAY = 1,"]}],"userModified":false,"replaceAll":false}}
