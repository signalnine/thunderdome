@@ -0,0 +1,400 @@
+export interface Event {
+  id: string;
+  name: string;
+  duration: number; // minutes
+  attendees?: number; // default 1
+  prerequisites?: string[]; // event IDs that must finish before this starts
+  preferredRoom?: string; // room ID hint, not a hard constraint
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number;
+}
+
+export interface ScheduleOptions {
+  startTime: number; // minutes from midnight
+  endTime: number; // minutes from midnight
+  gap?: number; // min gap between events in the same room (default 15)
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[];
+}
+
+interface Booking {
+  start: number;
+  end: number;
+}
+
+interface GreedyOutcome {
+  assignments: Map<string, Assignment>;
+  unscheduled: Set<string>;
+  preferencesHonored: number;
+}
+
+type Comparator = (a: Event, b: Event) => number;
+
+/**
+ * Orders the ready queue before each pick. Receives the current earliest
+ * feasible start of each ready event so orderings can react to how the
+ * rooms have filled up so far.
+ */
+type ReadySorter = (ready: Event[], earliestStartOf: (e: Event) => number) => void;
+
+function detectCycles(events: Event[], eventMap: Map<string, Event>): void {
+  const WHITE = 0,
+    GRAY = 1,
+    BLACK = 2;
+  const color = new Map<string, number>();
+  for (const e of events) color.set(e.id, WHITE);
+
+  const visit = (id: string): void => {
+    color.set(id, GRAY);
+    const ev = eventMap.get(id);
+    for (const p of ev?.prerequisites ?? []) {
+      if (!eventMap.has(p)) continue;
+      const c = color.get(p);
+      if (c === GRAY) {
+        throw new Error(`Prerequisite cycle detected involving event "${p}"`);
+      }
+      if (c === WHITE) visit(p);
+    }
+    color.set(id, BLACK);
+  };
+
+  for (const e of events) {
+    if (color.get(e.id) === WHITE) visit(e.id);
+  }
+}
+
+/**
+ * Earliest start >= from at which [start, start + duration] fits into the
+ * room's booking list with `gap` minutes of separation, ending by windowEnd.
+ * Returns null if it cannot fit.
+ */
+function earliestSlot(
+  bookings: Booking[],
+  from: number,
+  duration: number,
+  gap: number,
+  windowEnd: number
+): number | null {
+  let start = from;
+  for (const b of bookings) {
+    if (start + duration + gap <= b.start) break; // fits before this booking
+    if (start < b.end + gap) start = b.end + gap; // pushed past this booking
+  }
+  return start + duration <= windowEnd ? start : null;
+}
+
+function insertBooking(bookings: Booking[], booking: Booking): void {
+  let i = 0;
+  while (i < bookings.length && bookings[i].start < booking.start) i++;
+  bookings.splice(i, 0, booking);
+}
+
+function runGreedy(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  gap: number,
+  sortReady: ReadySorter,
+  strictPreference: boolean
+): GreedyOutcome {
+  const eventMap = new Map(events.map((e) => [e.id, e]));
+  const assignments = new Map<string, Assignment>();
+  const unscheduled = new Set<string>();
+  const bookings = new Map<string, Booking[]>(rooms.map((r) => [r.id, []]));
+  let preferencesHonored = 0;
+
+  // Kahn's algorithm over prerequisites that reference known events; a
+  // prerequisite pointing at an unknown event can never be satisfied.
+  const indegree = new Map<string, number>();
+  const dependents = new Map<string, string[]>();
+  const missingPrereq = new Set<string>();
+  for (const e of events) {
+    let deg = 0;
+    for (const p of e.prerequisites ?? []) {
+      if (eventMap.has(p)) {
+        deg++;
+        const list = dependents.get(p) ?? [];
+        list.push(e.id);
+        dependents.set(p, list);
+      } else {
+        missingPrereq.add(e.id);
+      }
+    }
+    indegree.set(e.id, deg);
+  }
+
+  const ready: Event[] = events.filter((e) => indegree.get(e.id) === 0);
+
+  const prereqFloor = (e: Event): number => {
+    let earliest = options.startTime;
+    for (const p of e.prerequisites ?? []) {
+      const asg = assignments.get(p);
+      if (asg) earliest = Math.max(earliest, asg.endTime + gap);
+    }
+    return earliest;
+  };
+
+  const earliestStartOf = (e: Event): number => {
+    if (
+      missingPrereq.has(e.id) ||
+      (e.prerequisites ?? []).some((p) => unscheduled.has(p))
+    ) {
+      return Infinity;
+    }
+    const from = prereqFloor(e);
+    const attendees = e.attendees ?? 1;
+    let best = Infinity;
+    for (const room of rooms) {
+      if (room.capacity < attendees) continue;
+      const start = earliestSlot(
+        bookings.get(room.id) as Booking[],
+        from,
+        e.duration,
+        gap,
+        options.endTime
+      );
+      if (start !== null && start < best) best = start;
+    }
+    return best;
+  };
+
+  while (ready.length > 0) {
+    sortReady(ready, earliestStartOf);
+    const event = ready.shift() as Event;
+
+    const release = (): void => {
+      for (const depId of dependents.get(event.id) ?? []) {
+        const deg = (indegree.get(depId) ?? 0) - 1;
+        indegree.set(depId, deg);
+        if (deg === 0) ready.push(eventMap.get(depId) as Event);
+      }
+    };
+
+    const prereqs = (event.prerequisites ?? []).filter((p) => eventMap.has(p));
+    const blocked =
+      missingPrereq.has(event.id) || prereqs.some((p) => unscheduled.has(p));
+    if (blocked) {
+      unscheduled.add(event.id);
+      release();
+      continue;
+    }
+
+    const earliest = prereqFloor(event);
+    const attendees = event.attendees ?? 1;
+    const candidates = rooms.filter((r) => r.capacity >= attendees);
+
+    let chosen: { room: Room; start: number } | null = null;
+    for (const room of candidates) {
+      const start = earliestSlot(
+        bookings.get(room.id) as Booking[],
+        earliest,
+        event.duration,
+        gap,
+        options.endTime
+      );
+      if (start === null) continue;
+      const isPreferred = room.id === event.preferredRoom;
+      if (isPreferred && strictPreference) {
+        // Preference is honored whenever the event fits there at all.
+        chosen = { room, start };
+        break;
+      }
+      if (chosen === null) {
+        chosen = { room, start };
+        continue;
+      }
+      const chosenPreferred = chosen.room.id === event.preferredRoom;
+      const better =
+        start < chosen.start ||
+        (start === chosen.start &&
+          !chosenPreferred &&
+          (isPreferred || room.capacity < chosen.room.capacity));
+      if (better) chosen = { room, start };
+    }
+
+    if (chosen === null) {
+      unscheduled.add(event.id);
+    } else {
+      assignments.set(event.id, {
+        eventId: event.id,
+        roomId: chosen.room.id,
+        startTime: chosen.start,
+        endTime: chosen.start + event.duration,
+      });
+      insertBooking(bookings.get(chosen.room.id) as Booking[], {
+        start: chosen.start,
+        end: chosen.start + event.duration,
+      });
+      if (event.preferredRoom === chosen.room.id) preferencesHonored++;
+    }
+    release();
+  }
+
+  return { assignments, unscheduled, preferencesHonored };
+}
+
+/** Deterministic PRNG so random-restart orderings are reproducible. */
+function mulberry32(seed: number): () => number {
+  let a = seed | 0;
+  return () => {
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+/** Longest chain of work (durations + gaps) that depends on each event. */
+function criticalPaths(events: Event[], gap: number): Map<string, number> {
+  const eventMap = new Map(events.map((e) => [e.id, e]));
+  const dependents = new Map<string, string[]>();
+  for (const e of events) {
+    for (const p of e.prerequisites ?? []) {
+      if (!eventMap.has(p)) continue;
+      const list = dependents.get(p) ?? [];
+      list.push(e.id);
+      dependents.set(p, list);
+    }
+  }
+  const memo = new Map<string, number>();
+  const cp = (id: string): number => {
+    const cached = memo.get(id);
+    if (cached !== undefined) return cached;
+    const ev = eventMap.get(id) as Event;
+    let tail = 0;
+    for (const d of dependents.get(id) ?? []) {
+      tail = Math.max(tail, gap + cp(d));
+    }
+    const result = ev.duration + tail;
+    memo.set(id, result);
+    return result;
+  };
+  for (const e of events) cp(e.id);
+  return memo;
+}
+
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions
+): ScheduleResult {
+  const gap = options.gap ?? 15;
+  const eventMap = new Map(events.map((e) => [e.id, e]));
+  detectCycles(events, eventMap);
+
+  const index = new Map(events.map((e, i) => [e.id, i]));
+  const cp = criticalPaths(events, gap);
+  const attendeesOf = (e: Event): number => e.attendees ?? 1;
+  const roomChoices = (e: Event): number =>
+    rooms.filter((r) => r.capacity >= attendeesOf(e)).length;
+
+  const byIndex: Comparator = (a, b) =>
+    (index.get(a.id) as number) - (index.get(b.id) as number);
+  const byCp: Comparator = (a, b) =>
+    (cp.get(b.id) as number) - (cp.get(a.id) as number);
+  const staticOrderings: Comparator[] = [
+    (a, b) => byCp(a, b) || byIndex(a, b),
+    (a, b) =>
+      roomChoices(a) - roomChoices(b) ||
+      attendeesOf(b) - attendeesOf(a) ||
+      byIndex(a, b),
+    (a, b) =>
+      attendeesOf(b) - attendeesOf(a) ||
+      b.duration - a.duration ||
+      byIndex(a, b),
+    (a, b) =>
+      attendeesOf(b) - attendeesOf(a) ||
+      a.duration - b.duration ||
+      byIndex(a, b),
+    (a, b) => a.duration - b.duration || byIndex(a, b),
+    (a, b) => b.duration - a.duration || byIndex(a, b),
+    byIndex,
+  ];
+  // Random-restart orderings escape traps none of the fixed heuristics
+  // cover (e.g. a high-critical-path event whose chain cannot fit anyway).
+  const restarts = events.length > 100 ? 6 : 20;
+  for (let r = 0; r < restarts; r++) {
+    const rnd = mulberry32(0x9e3779b9 + r * 0x85eb);
+    const priority = new Map(events.map((e) => [e.id, rnd()]));
+    staticOrderings.push(
+      (a, b) =>
+        (priority.get(a.id) as number) - (priority.get(b.id) as number)
+    );
+  }
+  const sorters: ReadySorter[] = staticOrderings.map(
+    (cmp) => (ready) => ready.sort(cmp)
+  );
+  // Dynamic ordering: react to how rooms have filled up so far — events
+  // whose feasible start is earliest go first, keeping tight slots usable.
+  sorters.push((ready, earliestStartOf) => {
+    const starts = new Map(ready.map((e) => [e.id, earliestStartOf(e)]));
+    ready.sort((a, b) => {
+      const sa = starts.get(a.id) as number;
+      const sb = starts.get(b.id) as number;
+      if (sa !== sb) return sa < sb ? -1 : 1; // safe for Infinity
+      return byCp(a, b) || byIndex(a, b);
+    });
+  });
+
+  let best: GreedyOutcome | null = null;
+  for (const strictPreference of [true, false]) {
+    for (const sortReady of sorters) {
+      const outcome = runGreedy(
+        events,
+        rooms,
+        options,
+        gap,
+        sortReady,
+        strictPreference
+      );
+      if (
+        best === null ||
+        outcome.assignments.size > best.assignments.size ||
+        (outcome.assignments.size === best.assignments.size &&
+          outcome.preferencesHonored > best.preferencesHonored)
+      ) {
+        best = outcome;
+      }
+    }
+  }
+
+  const result = best as GreedyOutcome;
+  const assignments = [...result.assignments.values()].sort(
+    (a, b) =>
+      a.startTime - b.startTime || a.eventId.localeCompare(b.eventId)
+  );
+  const unscheduled = events
+    .filter((e) => result.unscheduled.has(e.id))
+    .map((e) => e.id);
+  return { assignments, unscheduled };
+}
+
+export class Scheduler {
+  schedule(
+    events: Event[],
+    rooms: Room[],
+    options: ScheduleOptions
+  ): ScheduleResult {
+    return schedule(events, rooms, options);
+  }
+}
+
+export function createScheduler(): Scheduler {
+  return new Scheduler();
+}
+
+export default schedule;
