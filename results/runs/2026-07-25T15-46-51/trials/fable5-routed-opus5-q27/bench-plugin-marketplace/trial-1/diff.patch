+import vm from 'node:vm';
+import { performance } from 'node:perf_hooks';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+function run(code: string, timeoutMs: number, context: Record<string, unknown>): SandboxResult {
+  // Fresh context per run so no state leaks between executions.
+  const sandbox = vm.createContext({ ...context });
+  const memoryBefore = process.memoryUsage().heapUsed;
+  const start = performance.now();
+  try {
+    const script = new vm.Script(`(function () { ${code} })()`);
+    const output: unknown = script.runInContext(sandbox, { timeout: timeoutMs });
+    return {
+      success: true,
+      output,
+      duration: performance.now() - start,
+      memoryUsed: Math.max(0, process.memoryUsage().heapUsed - memoryBefore),
+    };
+  } catch (err) {
+    return {
+      success: false,
+      output: null,
+      duration: performance.now() - start,
+      memoryUsed: Math.max(0, process.memoryUsage().heapUsed - memoryBefore),
+      error: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+export function createRunner(): RunnerService {
+  return {
+    async execute(code: string, context: Record<string, unknown> = {}): Promise<SandboxResult> {
+      return run(code, DEFAULT_TIMEOUT_MS, context);
+    },
+    async executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context: Record<string, unknown> = {},
+    ): Promise<SandboxResult> {
+      return run(code, timeoutMs, context);
+    },
+  };
+}
