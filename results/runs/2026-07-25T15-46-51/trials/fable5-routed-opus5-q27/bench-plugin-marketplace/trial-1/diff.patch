+import type { PluginManifest, RegistryService } from '../types.js';
+import Database from 'better-sqlite3';
+
+interface Row {
+  id: number;
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies: string;
+  entryPoint: string;
+  permissions: string;
+}
+
+function rowToManifest(row: Row): PluginManifest {
+  return {
+    name: row.name,
+    version: row.version,
+    description: row.description,
+    author: row.author,
+    dependencies: JSON.parse(row.dependencies),
+    entryPoint: row.entryPoint,
+    permissions: JSON.parse(row.permissions),
+  };
+}
+
+export function createRegistry(): RegistryService {
+  const db = new Database(':memory:');
+
+  db.exec(`
+    CREATE TABLE plugins (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      name TEXT NOT NULL,
+      version TEXT NOT NULL,
+      description TEXT NOT NULL,
+      author TEXT NOT NULL,
+      dependencies TEXT NOT NULL,
+      entryPoint TEXT NOT NULL,
+      permissions TEXT NOT NULL,
+      UNIQUE(name, version)
+    )
+  `);
+
+  const insertStmt = db.prepare(`
+    INSERT OR REPLACE INTO plugins (name, version, description, author, dependencies, entryPoint, permissions)
+    VALUES (@name, @version, @description, @author, @dependencies, @entryPoint, @permissions)
+  `);
+
+  const getByNameStmt = db.prepare(`
+    SELECT * FROM plugins WHERE name = @name ORDER BY id DESC LIMIT 1
+  `);
+
+  const getByNameVersionStmt = db.prepare(`
+    SELECT * FROM plugins WHERE name = @name AND version = @version
+  `);
+
+  const listStmt = db.prepare(`
+    SELECT * FROM plugins ORDER BY id
+  `);
+
+  const searchStmt = db.prepare(`
+    SELECT * FROM plugins WHERE lower(name) LIKE @pattern OR lower(description) LIKE @pattern
+  `);
+
+  const removeStmt = db.prepare(`
+    DELETE FROM plugins WHERE name = @name AND version = @version
+  `);
+
+  const listVersionsStmt = db.prepare(`
+    SELECT version FROM plugins WHERE name = @name ORDER BY id
+  `);
+
+  return {
+    register(manifest: PluginManifest): void {
+      insertStmt.run({
+        name: manifest.name,
+        version: manifest.version,
+        description: manifest.description,
+        author: manifest.author,
+        dependencies: JSON.stringify(manifest.dependencies),
+        entryPoint: manifest.entryPoint,
+        permissions: JSON.stringify(manifest.permissions),
+      });
+    },
+
+    get(name: string): PluginManifest | null {
+      const row = getByNameStmt.get({ name }) as Row | undefined;
+      if (!row) return null;
+      return rowToManifest(row);
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const row = getByNameVersionStmt.get({ name, version }) as Row | undefined;
+      if (!row) return null;
+      return rowToManifest(row);
+    },
+
+    list(): PluginManifest[] {
+      const rows = listStmt.all() as Row[];
+      return rows.map(rowToManifest);
+    },
+
+    search(query: string): PluginManifest[] {
+      const pattern = '%' + query.toLowerCase() + '%';
+      const rows = searchStmt.all({ pattern }) as Row[];
+      return rows.map(rowToManifest);
+    },
+
+    remove(name: string, version: string): boolean {
+      const info = removeStmt.run({ name, version });
+      return info.changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      const rows = listVersionsStmt.all({ name }) as { version: string }[];
+      return rows.map((row) => row.version);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const row = getByNameVersionStmt.get({ name, version }) as Row | undefined;
+      if (!row) {
+        throw new Error('Plugin not found: ' + name + '@' + version);
+      }
+      const existing = rowToManifest(row);
+      const merged: PluginManifest = {
+        name: existing.name,
+        version: existing.version,
+        description: updates.description ?? existing.description,
+        author: updates.author ?? existing.author,
+        dependencies: updates.dependencies ?? existing.dependencies,
+        entryPoint: updates.entryPoint ?? existing.entryPoint,
+        permissions: updates.permissions ?? existing.permissions,
+      };
+      insertStmt.run({
+        name: merged.name,
+        version: merged.version,
+        description: merged.description,
+        author: merged.author,
+        dependencies: JSON.stringify(merged.dependencies),
+        entryPoint: merged.entryPoint,
+        permissions: JSON.stringify(merged.permissions),
+      });
+    },
+  };
+}
