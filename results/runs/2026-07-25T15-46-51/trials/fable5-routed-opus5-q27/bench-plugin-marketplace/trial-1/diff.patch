LACE INTO plugins (name, version, description, author, dependencies, entryPoint, permissions) VALUES (...).\n7. get(name): return the manifest for the most recently inserted row with that name (ORDER BY id DESC LIMIT 1), or null if none.\n8. getVersion(name, version): exact match row or null.\n9. list(): all rows as manifests ordered by id.\n10. search(query): case-insensitive substring match on name OR description. Use: SELECT * FROM plugins WHERE lower(name) LIKE ? OR lower(description) LIKE ? with parameter '%' + query.toLowerCase() + '%' (same parameter twice).\n11. remove(name, version): DELETE row, return true if info.changes > 0.\n12. listVersions(name): array of version strings for that name ordered by id.\n13. update(name, version, updates): read the existing row; if missing, throw new Error('Plugin not found: ' + name + '@' + version); merge updates over the existing manifest (updates win) but keep original name and version; then INSERT OR REPLACE the merged row.\n14. Cast better-sqlite3 results: stmt.get(...) as Row | undefined, stmt.all(...) as Row[].\n15. Must compile under TypeScript strict with no unused variables. Use const arrow functions or an object literal implementing RegistryService.\"","description":"Delegate registry module to light worker","run_in_background":true},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2578,"cache_read_input_tokens":37199,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2578},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0f5d1419-0467-4de4-bf0b-2cd92ee62a86","uuid":"89035a4e-1856-44c9-9c48-b379a3f596e1","request_id":"req_011CdP3T1p5ujCmMhLSNSoWM"}
