@@ -0,0 +1,39 @@
+import semver from 'semver';
+import type { VersionConstraint, ResolvedVersion, ResolverService } from '../types.js';
+
+export function createResolver(): ResolverService {
+  function satisfies(version: string, range: string): boolean {
+    return semver.satisfies(version, range);
+  }
+
+  function maxSatisfying(versions: string[], range: string): string | null {
+    return semver.maxSatisfying(versions, range);
+  }
+
+  function validRange(range: string): boolean {
+    return semver.validRange(range) !== null;
+  }
+
+  function resolve(constraints: VersionConstraint[], available: Record<string, string[]>): ResolvedVersion[] {
+    const results: ResolvedVersion[] = [];
+    for (const c of constraints) {
+      const versions = available[c.name];
+      if (!versions || versions.length === 0) {
+        throw new Error('No available versions for ' + c.name);
+      }
+      const version = semver.maxSatisfying(versions, c.range);
+      if (version === null) {
+        throw new Error('Cannot resolve ' + c.name + '@' + c.range);
+      }
+      results.push({ name: c.name, version, satisfies: c.range });
+    }
+    return results;
+  }
+
+  return {
+    resolve,
+    satisfies,
+    maxSatisfying,
+    validRange,
+  };
+}
