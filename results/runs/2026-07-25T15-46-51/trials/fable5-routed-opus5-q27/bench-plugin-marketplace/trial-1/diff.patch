+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+const MAX_DEPTH = 100;
+
+function dependencyNames(name: string, registry: RegistryService): string[] {
+  const manifest = registry.get(name);
+  return manifest ? Object.keys(manifest.dependencies) : [];
+}
+
+function buildNode(
+  name: string,
+  registry: RegistryService,
+  ancestors: Set<string>,
+  depth: number,
+): DependencyNode {
+  const manifest = registry.get(name);
+  const node: DependencyNode = {
+    name,
+    version: manifest ? manifest.version : '0.0.0',
+    dependencies: [],
+  };
+  if (!manifest || depth >= MAX_DEPTH || ancestors.has(name)) {
+    return node;
+  }
+  const nextAncestors = new Set(ancestors);
+  nextAncestors.add(name);
+  for (const dep of Object.keys(manifest.dependencies)) {
+    node.dependencies.push(buildNode(dep, registry, nextAncestors, depth + 1));
+  }
+  return node;
+}
+
+export function createDepsService(): DepsService {
+  const detectCycles = (name: string, registry: RegistryService): string[][] | null => {
+    const cycles: string[][] = [];
+    const stack: string[] = [];
+    const onStack = new Set<string>();
+    const visited = new Set<string>();
+
+    const dfs = (current: string): void => {
+      visited.add(current);
+      onStack.add(current);
+      stack.push(current);
+      for (const dep of dependencyNames(current, registry)) {
+        if (onStack.has(dep)) {
+          cycles.push([...stack.slice(stack.indexOf(dep)), dep]);
+        } else if (!visited.has(dep)) {
+          dfs(dep);
+        }
+      }
+      stack.pop();
+      onStack.delete(current);
+    };
+
+    dfs(name);
+    return cycles.length > 0 ? cycles : null;
+  };
+
+  const topologicalSort = (name: string, registry: RegistryService): string[] => {
+    if (detectCycles(name, registry) !== null) {
+      throw new Error(`Circular dependency detected for ${name}`);
+    }
+    const sorted: string[] = [];
+    const visited = new Set<string>();
+
+    const visit = (current: string): void => {
+      if (visited.has(current)) return;
+      visited.add(current);
+      for (const dep of dependencyNames(current, registry)) {
+        visit(dep);
+      }
+      sorted.push(current);
+    };
+
+    visit(name);
+    return sorted;
+  };
+
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      return buildNode(name, registry, new Set(), 0);
+    },
+    detectCycles,
+    topologicalSort,
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      return topologicalSort(name, registry).filter(dep => dep !== name);
+    },
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return detectCycles(name, registry) !== null;
+    },
+  };
+}
