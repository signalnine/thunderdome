+++ b/src/reviews/index.ts
@@ -0,0 +1,141 @@
+import type { Review, ReviewService } from '../types.js';
+import Database from 'better-sqlite3';
+
+interface Row {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+function rowToReview(row: Row): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged === 1,
+    createdAt: row.createdAt,
+  };
+}
+
+export function createReviewSystem(): ReviewService {
+  const db = new Database(':memory:');
+
+  db.exec(`
+    CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT NOT NULL,
+      flagged INTEGER NOT NULL DEFAULT 0,
+      createdAt TEXT NOT NULL
+    )
+  `);
+
+  const insertStmt = db.prepare(`
+    INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+    VALUES (?, ?, ?, ?, ?, 0, ?)
+  `);
+
+  const getReviewsStmt = db.prepare(
+    `SELECT * FROM reviews WHERE pluginName = ? ORDER BY id`
+  );
+
+  const getAverageRatingStmt = db.prepare(
+    `SELECT AVG(rating) as avg FROM reviews WHERE pluginName = ? AND flagged = 0`
+  );
+
+  const flagReviewStmt = db.prepare(
+    `UPDATE reviews SET flagged = 1 WHERE id = ?`
+  );
+
+  const getFlaggedReviewsStmt = db.prepare(
+    `SELECT * FROM reviews WHERE flagged = 1`
+  );
+
+  const removeReviewStmt = db.prepare(
+    `DELETE FROM reviews WHERE id = ?`
+  );
+
+  const getReviewsByUserStmt = db.prepare(
+    `SELECT * FROM reviews WHERE userId = ? ORDER BY id`
+  );
+
+  const getReviewCountStmt = db.prepare(
+    `SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?`
+  );
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      const { pluginName, pluginVersion, userId, rating, comment } = review;
+      if (!Number.isInteger(rating) || rating < 1 || rating > 5) {
+        throw new Error('Rating must be between 1 and 5');
+      }
+      const createdAt = new Date().toISOString();
+      const info = insertStmt.run(
+        pluginName,
+        pluginVersion,
+        userId,
+        rating,
+        comment,
+        createdAt
+      );
+      return {
+        id: Number(info.lastInsertRowid),
+        pluginName,
+        pluginVersion,
+        userId,
+        rating,
+        comment,
+        flagged: false,
+        createdAt,
+      };
+    },
+
+    getReviews(pluginName: string): Review[] {
+      const rows = getReviewsStmt.all(pluginName) as Row[];
+      return rows.map(rowToReview);
+    },
+
+    getAverageRating(pluginName: string): number {
+      const result = getAverageRatingStmt.get(pluginName) as { avg: number | null } | undefined;
+      if (!result || result.avg === null) {
+        return 0;
+      }
+      return result.avg;
+    },
+
+    flagReview(reviewId: number): void {
+      flagReviewStmt.run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      const rows = getFlaggedReviewsStmt.all() as Row[];
+      return rows.map(rowToReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      const info = removeReviewStmt.run(reviewId);
+      return info.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      const rows = getReviewsByUserStmt.all(userId) as Row[];
+      return rows.map(rowToReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const result = getReviewCountStmt.get(pluginName) as { count: number } | undefined;
+      return result ? result.count : 0;
+    },
+  };
+}
