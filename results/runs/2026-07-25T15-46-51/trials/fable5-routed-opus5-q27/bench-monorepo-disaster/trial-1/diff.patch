+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TMkUicdyBQNKJypYV5kCE4","type":"tool_result","content":"/**\n * Worker entry point.\n * Runs background jobs on a schedule.\n */\n\nimport { Scheduler } from './scheduler.js';\nimport { syncJob } from './jobs/sync.js';\nimport { cleanupJob } from './jobs/cleanup.js';\n\nexport function createWorker(): Scheduler {\n  const scheduler = new Scheduler();\n\n  // Register jobs\n  scheduler.register('sync', syncJob, 60_000); // Every 60 seconds\n  scheduler.register('cleanup', async () => { await cleanupJob(); }, 300_000); // Every 5 minutes\n\n  return scheduler;\n}\n\n// Start worker if run directly\nconst isMainModule = process.argv[1]?.includes('worker/dist/index.js');\nif (isMainModule) {\n  console.log('Starting worker...');\n  const worker = createWorker();\n  worker.start();\n\n  process.on('SIGINT', () => {\n    console.log('Shutting down worker...');\n    worker.stop();\n    process.exit(0);\n  });\n}\n/**\n * Simple job scheduler for background tasks.\n */\n\nexport interface JobDefinition {\n  name: string;\n  handler: () => Promise<void> | void;\n  intervalMs: number;\n  timer?: ReturnType<typeof setInterval>;\n  lastRun?: Date;\n  runCount: number;\n  errors: string[];\n}\n\nexport class Scheduler {\n  private jobs: Map<string, JobDefinition> = new Map();\n  private running = false;\n\n  register(\n    name: string,\n    handler: () => Promise<void> | void,\n    intervalMs: number\n  ): void {\n    this.jobs.set(name, {\n      name,\n      handler,\n      intervalMs,\n      runCount: 0,\n      errors: [],\n    });\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n\n    for (const [, job] of this.jobs) {\n      job.timer = setInterval(async () => {\n        try {\n          await job.handler();\n          job.lastRun = new Date();\n          job.runCount++;\n        } catch (err) {\n          job.errors.push(\n            err instanceof Error ? err.me