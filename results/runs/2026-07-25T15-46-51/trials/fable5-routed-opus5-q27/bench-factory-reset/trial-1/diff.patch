+import { describe, it, expect } from 'vitest';
+import { solveToggle, solveCounter } from '../src/index.js';
+
+function mulberry32(seed: number): () => number {
+  return () => {
+    let x = seed += 0x6d2b79f5;
+    x = Math.imul(x ^ x >>> 15, 1 | x);
+    x = Math.imul(x + (x ^ x >>> 7), 61 | x);
+    return ((x ^ x >>> 14) >>> 0) / 4294967296;
+  };
+}
+
+function applyToggle(n: number, buttons: number[][], presses: number[]): boolean[] {
+  const state = Array(n).fill(false);
+  for (const p of presses) {
+    for (const L of buttons[p]) {
+      state[L] = !state[L];
+    }
+  }
+  return state;
+}
+
+function bruteToggle(target: boolean[], buttons: number[][]): number[] | null {
+  const M = buttons.length;
+  let best: number[] | null = null;
+  for (let mask = 0; mask < (1 << M); mask++) {
+    const presses: number[] = [];
+    for (let i = 0; i < M; i++) {
+      if (mask & (1 << i)) {
+        presses.push(i);
+      }
+    }
+    const state = applyToggle(target.length, buttons, presses);
+    if (state.every((v, i) => v === target[i])) {
+      if (best === null || presses.length < best.length || (presses.length === best.length && cmpArrays(presses, best) < 0)) {
+        best = presses;
+      }
+    }
+  }
+  return best;
+}
+
+function applyCounter(n: number, buttons: number[][], x: number[], mod: number): number[] {
+  const state = Array(n).fill(0);
+  for (let i = 0; i < x.length; i++) {
+    for (const c of buttons[i]) {
+      state[c] = (state[c] + x[i]) % mod;
+    }
+  }
+  return state;
+}
+
+function bruteCounter(lights: number[], buttons: number[][], mod: number): number[] | null {
+  const M = buttons.length;
+  let best: number[] | null = null;
+  const x = Array(M).fill(0);
+  function recurse(idx: number) {
+    if (idx === M) {
+      const state = applyCounter(lights.length, buttons, x, mod);
+      if (state.every((v, i) => v === lights[i])) {
+        const sum = x.reduce((a, b) => a + b, 0);
+        if (best === null || sum < best.reduce((a, b) => a + b, 0) || (sum === best.reduce((a, b) => a + b, 0) && cmpArrays(x, best) < 0)) {
+          best = [...x];
+        }
+      }
+      return;
+    }
+    for (let v = 0; v < mod; v++) {
+      x[idx] = v;
+      recurse(idx + 1);
+    }
+  }
+  recurse(0);
+  return best;
+}
+
+function cmpArrays(a: number[], b: number[]): number {
+  const len = Math.min(a.length, b.length);
+  for (let i = 0; i < len; i++) {
+    if (a[i] !== b[i]) {
+      return a[i] - b[i];
+    }
+  }
+  return a.length - b.length;
+}
+
+describe('solveToggle basics', () => {
+  it('task example is unsolvable', () => {
+    const target = [true, true, false, true];
+    const buttons = [[0, 1], [1, 2, 3], [0, 3]];
+    expect(solveToggle({ target, buttons })).toBeNull();
+  });
+
+  it('all-off target needs no presses', () => {
+    const target = [false, false, false];
+    const buttons = [[0], [1, 2]];
+    expect(solveToggle({ target, buttons })).toEqual([]);
+  });
+
+  it('single button', () => {
+    const target = [true, false];
+    const buttons = [[0]];
+    expect(solveToggle({ target, buttons })).toEqual([0]);
+  });
+
+  it('no buttons, nonzero target', () => {
+    const target = [true];
+    const buttons: number[][] = [];
+    expect(solveToggle({ target, buttons })).toBeNull();
+  });
+
+  it('zero lights', () => {
+    const target: boolean[] = [];
+    const buttons = [[], []];
+    expect(solveToggle({ target, buttons })).toEqual([]);
+  });
+
+  it('duplicate light index in a button cancels', () => {
+    const target1 = [true];
+    const buttons1 = [[0, 0]];
+    expect(solveToggle({ target: target1, buttons: buttons1 })).toBeNull();
+
+    const target2 = [false];
+    const buttons2 = [[0, 0]];
+    expect(solveToggle({ target: target2, buttons: buttons2 })).toEqual([]);
+  });
+
+  it('prefers fewer buttons', () => {
+    const target = [true, true];
+    const buttons = [[0], [1], [0, 1]];
+    expect(solveToggle({ target, buttons })).toEqual([2]);
+  });
+
+  it('lex tie-break', () => {
+    const target = [true, true];
+    const buttons = [[0, 1], [0], [1]];
+    expect(solveToggle({ target, buttons })).toEqual([0]);
+  });
+
+  it('identical buttons tie-break', () => {
+    const target = [true];
+    const buttons = [[0], [0]];
+    expect(solveToggle({ target, buttons })).toEqual([0]);
+  });
+});
+
+describe('solveToggle randomized vs brute force', () => {
+  it('matches brute force', () => {
+    const rng = mulberry32(12345);
+    for (let i = 0; i < 150; i++) {
+      const n = 1 + Math.floor(rng() * 5);
+      const m = Math.floor(rng() * 9);
+      const buttons: number[][] = [];
+      for (let j = 0; j < m; j++) {
+        const btn: number[] = [];
+        for (let k = 0; k < n; k++) {
+          if (rng() < 0.5) {
+            btn.push(k);
+          }
+        }
+        buttons.push(btn);
+      }
+      const target: boolean[] = [];
+      for (let k = 0; k < n; k++) {
+        target.push(rng() < 0.5);
+      }
+      const expected = bruteToggle(target, buttons);
+      const actual = solveToggle({ target, buttons });
+      expect(actual).toEqual(expected);
+    }
+  });
+});
+
+describe('solveToggle performance', () => {
+  it('handles 40 buttons and 40 lights quickly', () => {
+    const rng = mulberry32(999);
+    const n = 40;
+    const m = 40;
+    const buttons: number[][] = [];
+    for (let j = 0; j < m; j++) {
+      const btn: number[] = [];
+      for (let k = 0; k < n; k++) {
+        if (rng() < 0.5) {
+          btn.push(k);
+        }
+      }
+      buttons.push(btn);
+    }
+    const secret: number[] = [];
+    for (let j = 0; j < m; j++) {
+      if (rng() < 0.5) {
+        secret.push(j);
+      }
+    }
+    const target = applyToggle(n, buttons, secret);
+    const t0 = Date.now();
+    const res = solveToggle({ target, buttons });
+    const elapsed = Date.now() - t0;
+    expect(elapsed).toBeLessThan(5000);
+    expect(res).not.toBeNull();
+    expect(applyToggle(n, buttons, res!)).toEqual(target);
+    expect(res!.length).toBeLessThanOrEqual(secret.length);
+  });
+
+  it('unsolvable 40-button instance is fast', () => {
+    const rng = mulberry32(777);
+    const n = 40;
+    const m = 40;
+    const buttons: number[][] = [];
+    for (let j = 0; j < m; j++) {
+      const btn: number[] = [];
+      for (let k = 0; k < n - 1; k++) {
+        if (rng() < 0.5) {
+          btn.push(k);
+        }
+      }
+      buttons.push(btn);
+    }
+    const target: boolean[] = [];
+    for (let k = 0; k < n; k++) {
+      if (k === n - 1) {
+        target.push(true);
+      } else {
+        target.push(rng() < 0.5);
+      }
+    }
+    const t0 = Date.now();
+    const res = solveToggle({ target, buttons });
+    const elapsed = Date.now() - t0;
+    expect(elapsed).toBeLessThan(5000);
+    expect(res).toBeNull();
+  });
+});
+
+describe('solveCounter basics', () => {
+  it('simple unique solution', () => {
+    const lights = [2, 3];
+    const buttons = [[0], [1]];
+    const mod = 5;
+    expect(solveCounter(lights, buttons, mod)).toEqual([2, 3]);
+  });
+
+  it('shared counter', () => {
+    const lights = [3];
+    const buttons = [[0], [0]];
+    const mod = 5;
+    expect(solveCounter(lights, buttons, mod)).toEqual([0, 3]);
+  });
+
+  it('zero target', () => {
+    const lights = [0, 0];
+    const buttons = [[0], [1]];
+    const mod = 7;
+    expect(solveCounter(lights, buttons, mod)).toEqual([0, 0]);
+  });
+
+  it('no buttons, nonzero target', () => {
+    const lights = [1];
+    const buttons: number[][] = [];
+    const mod = 3;
+    expect(solveCounter(lights, buttons, mod)).toBeNull();
+  });
+
+  it('untouched counter makes it unsolvable', () => {
+    const lights = [1, 1];
+    const buttons = [[0]];
+    const mod = 3;
+    expect(solveCounter(lights, buttons, mod)).toBeNull();
+  });
+
+  it('duplicate counter index adds twice', () => {
+    const lights = [4];
+    const buttons = [[0, 0]];
+    const mod = 5;
+    expect(solveCounter(lights, buttons, mod)).toEqual([2]);
+  });
+
+  it('button affecting nothing stays 0', () => {
+    const lights = [1];
+    const buttons = [[], [0]];
+    const mod = 3;
+    expect(solveCounter(lights, buttons, mod)).toEqual([0, 1]);
+  });
+
+  it('mod 2 behaves like toggle', () => {
+    const lights = [1, 1, 0];
+    const buttons = [[0, 1], [1, 2], [0, 2]];
+    const mod = 2;
+    expect(solveCounter(lights, buttons, mod)).toEqual([1, 0, 0]);
+  });
+});
+
+describe('solveCounter randomized vs brute force', () => {
+  it('matches brute force', () => {
+    const rng = mulberry32(4242);
+    for (let i = 0; i < 120; i++) {
+      const mods = [2, 3, 5];
+      const mod = mods[Math.floor(rng() * 3)];
+      const n = 1 + Math.floor(rng() * 4);
+      const m = Math.floor(rng() * 5);
+      if (Math.pow(mod, m) > 4000) {
+        continue;
+      }
+      const buttons: number[][] = [];
+      for (let j = 0; j < m; j++) {
+        const btn: number[] = [];
+        for (let k = 0; k < n; k++) {
+          if (rng() < 0.5) {
+            btn.push(k);
+          }
+        }
+        buttons.push(btn);
+      }
+      const lights: number[] = [];
+      for (let k = 0; k < n; k++) {
+        lights.push(Math.floor(rng() * mod));
+      }
+      const expected = bruteCounter(lights, buttons, mod);
+      const actual = solveCounter(lights, buttons, mod);
+      expect(actual).toEqual(expected);
+    }
+  });
+});
+
+describe('solveCounter performance', () => {
+  it('handles 40 buttons, 40 counters, mod 97', () => {
+    const rng = mulberry32(31337);
