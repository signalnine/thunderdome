ecord<string, unknown>;\n    const eventName = requireEventName(body);\n    const bucket = (body.bucket ?? 'day') as Bucket;\n    if (!VALID_BUCKETS.includes(bucket)) {\n      throw new ApiError(\n        400,\n        `bucket must be one of: ${VALID_BUCKETS.join(', ')}`,\n        'VALIDATION_ERROR'\n      );\n    }\n    const data = timeseries(getDb(), auth.tenantId, eventName, bucket, parseRange(body));\n    res.status(200).json({ data });\n  } catch (err) {\n    next(err);\n  }\n});\n\nrouter.post('/breakdown', (req: Request, res: Response, next: NextFunction) => {\n  try {\n    const auth = getAuthUser(req);\n    const body = (req.body ?? {}) as Record<string, unknown>;\n    const eventName = requireEventName(body);\n    const propertyKey = body.property_key;\n    if (typeof propertyKey !== 'string' || propertyKey.length === 0) {\n      throw new ApiError(400, 'property_key is required', 'VALIDATION_ERROR');\n    }\n    const data = breakdown(getDb(), auth.tenantId, eventName, propertyKey, parseRange(body));\n    res.status(200).json({ data });\n  } catch (err) {\n    next(err);\n  }\n});\n\nrouter.post('/funnel', (req: Request, res: Response, next: NextFunction) => {\n  try {\n    const auth = getAuthUser(req);\n    const body = (req.body ?? {}) as Record<string, unknown>;\n    const steps = body.steps;\n    if (\n      !Array.isArray(steps) ||\n      steps.length === 0 ||\n      steps.some((s) => typeof s !== 'string' || s.length === 0)\n    ) {\n      throw new ApiError(400, 'steps must be a non-empty array of event names', 'VALIDATION_ERROR');\n    }\n    const result = funnel(getDb(), auth.tenantId, steps as string[], parseRange(body));\n    res.status(200).json({ steps: result });\n  } catch (err) {\n    next(err);\n  }\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2705,"cache_read_input_tokens":51122,"cache_creation":{"ephe