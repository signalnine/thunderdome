@@ -0,0 +1,33 @@
+import { Request, Response, NextFunction } from 'express';
+
+export class ApiError extends Error {
+  status: number;
+  code: string;
+
+  constructor(status: number, message: string, code: string) {
+    super(message);
+    this.status = status;
+    this.code = code;
+  }
+}
+
+export function errorHandler(
+  err: unknown,
+  _req: Request,
+  res: Response,
+  _next: NextFunction
+): void {
+  if (err instanceof ApiError) {
+    res.status(err.status).json({ error: err.message, code: err.code });
+    return;
+  }
+  if (
+    err instanceof SyntaxError &&
+    'status' in err &&
+    (err as { status?: number }).status === 400
+  ) {
+    res.status(400).json({ error: 'Invalid JSON body', code: 'INVALID_JSON' });
+    return;
+  }
+  res.status(500).json({ error: 'Internal server error', code: 'INTERNAL_ERROR' });
+}
diff --git a/src/export/router.ts b/src/export/router.ts
new file mode 100644
index 0000000..f4bc816
--- /dev/null
+++ b/src/export/router.ts
@@ -0,0 +1,164 @@
+import { Router, Request, Response, NextFunction } from 'express';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+import { getAuthUser } from '../auth';
+import { countEvents, timeseries, breakdown, funnel, VALID_BUCKETS, Bucket } from '../query/engine';
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: 'counter' | 'timeseries' | 'breakdown' | 'funnel';
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+const router = Router();
+
+function csvEscape(value: string): string {
+  if (value.includes(',') || value.includes('"') || value.includes('\n')) {
+    return '"' + value.replace(/"/g, '""') + '"';
+  }
+  return value;
+}
+
+function toCsv(rows: EventRow[]): string {
+  const header = 'id,tenant_id,name,properties,timestamp,user_id,session_id';
+  const lines = [header];
+  for (const row of rows) {
+    const fields = [
+      row.id,
+      row.tenant_id,
+      row.name,
+      row.properties,
+      row.timestamp,
+      row.user_id ?? '',
+      row.session_id ?? '',
+    ];
+    const line = fields.map(csvEscape).join(',');
+    lines.push(line);
+  }
+  return lines.join('\n');
+}
+
+router.get('/events', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { format = 'json', start, end } = req.query;
+    const fmt = typeof format === 'string' ? format : 'json';
+    if (fmt !== 'json' && fmt !== 'csv') {
+      throw new ApiError(400, 'format must be json or csv', 'VALIDATION_ERROR');
+    }
+
+    const user = getAuthUser(req);
+    const db = getDb();
+
+    let sql = 'SELECT * FROM events WHERE tenant_id = ?';
+    const params: (string | number)[] = [user.tenantId];
+
+    if (typeof start === 'string') {
+      sql += ' AND timestamp >= ?';
+      params.push(start);
+    }
+    if (typeof end === 'string') {
+      sql += ' AND timestamp <= ?';
+      params.push(end);
+    }
+
+    sql += ' ORDER BY timestamp ASC';
+
+    const rows = db.prepare(sql).all(...params) as EventRow[];
+
+    if (fmt === 'json') {
+      const result = rows.map(r => ({
+        ...r,
+        properties: JSON.parse(r.properties),
+      }));
+      res.status(200).json(result);
+    } else {
+      const csv = toCsv(rows);
+      res.setHeader('Content-Type', 'text/csv');
+      res.status(200).send(csv);
+    }
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/dashboard/:id', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { id } = req.params;
+    const user = getAuthUser(req);
+    const db = getDb();
+
+    const dash = db.prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?').get(id, user.tenantId) as DashboardRow | undefined;
+    if (!dash) {
+      throw new ApiError(404, 'Dashboard not found', 'NOT_FOUND');
+    }
+
+    const widgets = db.prepare('SELECT * FROM widgets WHERE dashboard_id = ?').all(id) as WidgetRow[];
+
+    const widgetResults = widgets.map(w => {
+      const cfg = JSON.parse(w.config) as Record<string, unknown>;
+      let data: unknown = null;
+
+      if (w.type === 'counter') {
+        if (typeof cfg.event_name === 'string') {
+          data = { count: countEvents(db, user.tenantId, cfg.event_name) };
+        }
+      } else if (w.type === 'timeseries') {
+        if (typeof cfg.event_name === 'string') {
+          const bucket = (VALID_BUCKETS as string[]).includes(cfg.bucket as string) ? (cfg.bucket as Bucket) : 'day';
+          data = { data: timeseries(db, user.tenantId, cfg.event_name, bucket) };
+        }
+      } else if (w.type === 'breakdown') {
+        if (typeof cfg.event_name === 'string' && typeof cfg.property_key === 'string') {
+          data = { data: breakdown(db, user.tenantId, cfg.event_name, cfg.property_key) };
+        }
+      } else if (w.type === 'funnel') {
+        if (Array.isArray(cfg.steps) && cfg.steps.length > 0 && cfg.steps.every((s: unknown) => typeof s === 'string')) {
+          data = { steps: funnel(db, user.tenantId, cfg.steps as string[]) };
+        }
+      }
+
+      return {
+        ...w,
+        config: JSON.parse(w.config),
+        data,
+      };
+    });
+
+    res.status(200).json({
+      dashboard: {
+        ...dash,
+        config: JSON.parse(dash.config),
+      },
+      widgets: widgetResults,
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
diff --git a/src/ingest/router.ts b/src/ingest/router.ts
new file mode 100644
index 0000000..f40ae39
--- /dev/null
+++ b/src/ingest/router.ts
@@ -0,0 +1,117 @@
+import { Router, Request, Response, NextFunction } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+import { getAuthUser } from '../auth';
+
+const router = Router();
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface EventResponse {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: Record<string, unknown>;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+function buildEvent(tenantId: string, body: Record<string, unknown>): EventRow {
+  const name = body.name;
+  if (typeof name !== 'string' || name.length === 0) {
+    throw new ApiError(400, 'name is required', 'VALIDATION_ERROR');
+  }
+
+  const properties = body.properties ?? {};
+  const propertiesStr = JSON.stringify(properties);
+
+  const timestamp = (typeof body.timestamp === 'string' && body.timestamp) ? body.timestamp : new Date().toISOString();
+
+  const user_id = typeof body.user_id === 'string' ? body.user_id : null;
+  const session_id = typeof body.session_id === 'string' ? body.session_id : null;
+
+  const id = uuidv4();
+
+  return {
+    id,
+    tenant_id: tenantId,
+    name,
+    properties: propertiesStr,
+    timestamp,
+    user_id,
+    session_id,
+  };
+}
+
+function toResponse(row: EventRow): EventResponse {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: JSON.parse(row.properties) as Record<string, unknown>,
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+router.post('/', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const auth = getAuthUser(req);
+    const body = req.body as Record<string, unknown>;
+    const row = buildEvent(auth.tenantId, body);
+    const db = getDb();
+    const stmt = db.prepare('INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)');
+    stmt.run(row.id, row.tenant_id, row.name, row.properties, row.timestamp, row.user_id, row.session_id);
+    res.status(201).json(toResponse(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/batch', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const auth = getAuthUser(req);
+    const body = req.body as Record<string, unknown>;
+    const events = body.events;
+    if (!Array.isArray(events) || events.length === 0) {
+      throw new ApiError(400, 'events must be a non-empty array', 'VALIDATION_ERROR');
+    }
+    for (const evt of events) {
+      const evtBody = evt as Record<string, unknown>;
+      const name = evtBody.name;
+      if (typeof name !== 'string' || name.length === 0) {
+        throw new ApiError(400, 'each event requires a name', 'VALIDATION_ERROR');
+      }
+    }
+    const db = getDb();
+    const stmt = db.prepare('INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)');
+    const rows: EventRow[] = [];
+    db.transaction(() => {
+      for (const evt of events) {
+        const evtBody = evt as Record<string, unknown>;
+        const row = buildEvent(auth.tenantId, evtBody);
+        stmt.run(row.id, row.tenant_id, row.name, row.properties, row.timestamp, row.user_id, row.session_id);
+        rows.push(row);
+      }
+    })();
+    res.status(201).json({
+      inserted: events.length,
+      events: rows.map(toResponse),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
diff --git a/src/query/engine.ts b/src/query/engine.ts
new file mode 100644
index 0000000..ef26413
--- /dev/null
+++ b/src/query/engine.ts
@@ -0,0 +1,132 @@
+import Database from 'better-sqlite3';
+
+export interface TimeRange {
+  start?: string;
+  end?: string;
+}
+
+export type Bucket = 'hour' | 'day' | 'week' | 'month';
+
+export const VALID_BUCKETS: Bucket[] = ['hour', 'day', 'week', 'month'];
+
+const BUCKET_FORMATS: Record<Bucket, string> = {
+  hour: '%Y-%m-%dT%H:00:00Z',
+  day: '%Y-%m-%d',
+  week: '%Y-W%W',
+  month: '%Y-%m',
+};
+
+function rangeClause(range: TimeRange, params: unknown[]): string {
+  let clause = '';
+  if (range.start) {
+    clause += ' AND timestamp >= ?';
+    params.push(range.start);
+  }
+  if (range.end) {
+    clause += ' AND timestamp <= ?';
+    params.push(range.end);
+  }
+  return clause;
+}
+
+export function countEvents(
+  db: Database.Database,
+  tenantId: string,
+  eventName: string,
+  range: TimeRange = {}
+): number {
+  const params: unknown[] = [tenantId, eventName];
+  const clause = rangeClause(range, params);
+  const row = db
+    .prepare(`SELECT COUNT(*) AS count FROM events WHERE tenant_id = ? AND name = ?${clause}`)
+    .get(...params) as { count: number };
+  return row.count;
+}
+
+export function timeseries(
+  db: Database.Database,
+  tenantId: string,
+  eventName: string,
+  bucket: Bucket,
+  range: TimeRange = {}
+): Array<{ bucket: string; count: number }> {
+  const params: unknown[] = [tenantId, eventName];
+  const clause = rangeClause(range, params);
+  const format = BUCKET_FORMATS[bucket];
+  return db
+    .prepare(
+      `SELECT strftime('${format}', timestamp) AS bucket, COUNT(*) AS count
+       FROM events WHERE tenant_id = ? AND name = ?${clause}
+       GROUP BY bucket ORDER BY bucket`
+    )
+    .all(...params) as Array<{ bucket: string; count: number }>;
+}
+
+export function breakdown(
+  db: Database.Database,
+  tenantId: string,
+  eventName: string,
+  propertyKey: string,
+  range: TimeRange = {}
+): Array<{ property_value: string | null; count: number }> {
+  const jsonPath = `$."${propertyKey.replace(/"/g, '""')}"`;
+  const params: unknown[] = [jsonPath, tenantId, eventName];
+  const clause = rangeClause(range, params);
+  return db
+    .prepare(
+      `SELECT json_extract(properties, ?) AS property_value, COUNT(*) AS count
+       FROM events WHERE tenant_id = ? AND name = ?${clause}
+       GROUP BY property_value ORDER BY count DESC`
+    )
+    .all(...params) as Array<{ property_value: string | null; count: number }>;
+}
+
+export function funnel(
+  db: Database.Database,
+  tenantId: string,
+  steps: string[],
+  range: TimeRange = {}
+): Array<{ name: string; count: number }> {
+  const placeholders = steps.map(() => '?').join(', ');
+  const params: unknown[] = [tenantId, ...steps];
+  const clause = rangeClause(range, params);
+  const rows = db
+    .prepare(
+      `SELECT name, session_id, user_id, id, timestamp
+       FROM events WHERE tenant_id = ? AND name IN (${placeholders})${clause}
+       ORDER BY timestamp ASC, id ASC`
+    )
+    .all(...params) as Array<{
+    name: string;
+    session_id: string | null;
+    user_id: string | null;
+    id: string;
+    timestamp: string;
+  }>;
+
+  // Group events by session (falling back to user, then to the event itself
+  // so anonymous one-off events still count toward the first step).
+  const groups = new Map<string, string[]>();
+  for (const row of rows) {
+    const key = row.session_id ?? row.user_id ?? `event:${row.id}`;
+    const list = groups.get(key);
+    if (list) {
+      list.push(row.name);
+    } else {
+      groups.set(key, [row.name]);
+    }
+  }
+
+  const counts = steps.map(() => 0);
+  for (const names of groups.values()) {
+    let stepIndex = 0;
+    for (const name of names) {
+      if (stepIndex < steps.length && name === steps[stepIndex]) {
+        counts[stepIndex] += 1;
+        stepIndex += 1;
+      }
+    }
+  }
+
+  return steps.map((name, i) => ({ name, count: counts[i] }));
+}
diff --git a/src/query/router.ts b/src/query/router.ts
new file mode 100644
index 0000000..b61b8bd
--- /dev/null
+++ b/src/query/router.ts
@@ -0,0 +1,109 @@
+import { Router, Request, Response, NextFunction } from 'express';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+import { getAuthUser } from '../auth';
+import {
+  countEvents,
+  timeseries,
+  breakdown,
+  funnel,
+  VALID_BUCKETS,
+  Bucket,
+  TimeRange,
+} from './engine';
+
+function parseRange(body: Record<string, unknown>): TimeRange {
+  const range: TimeRange = {};
+  if (body.start !== undefined) {
+    if (typeof body.start !== 'string') {
+      throw new ApiError(400, 'start must be an ISO timestamp string', 'VALIDATION_ERROR');
+    }
+    range.start = body.start;
+  }
+  if (body.end !== undefined) {
+    if (typeof body.end !== 'string') {
+      throw new ApiError(400, 'end must be an ISO timestamp string', 'VALIDATION_ERROR');
+    }
+    range.end = body.end;
+  }
+  return range;
+}
+
+function requireEventName(body: Record<string, unknown>): string {
+  const eventName = body.event_name;
+  if (typeof eventName !== 'string' || eventName.length === 0) {
+    throw new ApiError(400, 'event_name is required', 'VALIDATION_ERROR');
+  }
+  return eventName;
+}
+
+const router = Router();
+
+router.post('/count', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const auth = getAuthUser(req);
+    const body = (req.body ?? {}) as Record<string, unknown>;
+    const eventName = requireEventName(body);
+    const count = countEvents(getDb(), auth.tenantId, eventName, parseRange(body));
+    res.status(200).json({ count });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/timeseries', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const auth = getAuthUser(req);
+    const body = (req.body ?? {}) as Record<string, unknown>;
+    const eventName = requireEventName(body);
+    const bucket = (body.bucket ?? 'day') as Bucket;
+    if (!VALID_BUCKETS.includes(bucket)) {
+      throw new ApiError(
+        400,
+        `bucket must be one of: ${VALID_BUCKETS.join(', ')}`,
+        'VALIDATION_ERROR'
+      );
+    }
+    const data = timeseries(getDb(), auth.tenantId, eventName, bucket, parseRange(body));
+    res.status(200).json({ data });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/breakdown', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const auth = getAuthUser(req);
+    const body = (req.body ?? {}) as Record<string, unknown>;
+    const eventName = requireEventName(body);
+    const propertyKey = body.property_key;
+    if (typeof propertyKey !== 'string' || propertyKey.length === 0) {
+      throw new ApiError(400, 'property_key is required', 'VALIDATION_ERROR');
+    }
+    const data = breakdown(getDb(), auth.tenantId, eventName, propertyKey, parseRange(body));
+    res.status(200).json({ data });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/funnel', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const auth = getAuthUser(req);
+    const body = (req.body ?? {}) as Record<string, unknown>;
+    const steps = body.steps;
+    if (
+      !Array.isArray(steps) ||
+      steps.length === 0 ||
+      steps.some((s) => typeof s !== 'string' || s.length === 0)
+    ) {
+      throw new ApiError(400, 'steps must be a non-empty array of event names', 'VALIDATION_ERROR');
+    }
+    const result = funnel(getDb(), auth.tenantId, steps as string[], parseRange(body));
+    res.status(200).json({ steps: result });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
