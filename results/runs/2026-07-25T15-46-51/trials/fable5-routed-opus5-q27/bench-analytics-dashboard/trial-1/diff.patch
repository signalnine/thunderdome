tDb();\n    setDb(db);\n\n    // Seed user for FK\n    db.prepare(\n      \"INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES ('user1', 'u@t.com', 'hash', 'tenant1', 'viewer')\"\n    ).run();\n\n    // Seed events\n    const insert = db.prepare(\n      'INSERT INTO events (id, tenant_id, name, properties, timestamp) VALUES (?, ?, ?, ?, ?)'\n    );\n    insert.run(uuidv4(), 'tenant1', 'page_view', JSON.stringify({ page: '/home' }), '2024-01-15T10:00:00Z');\n    insert.run(uuidv4(), 'tenant1', 'click', JSON.stringify({ button: 'cta' }), '2024-01-15T11:00:00Z');\n    insert.run(uuidv4(), 'tenant2', 'page_view', JSON.stringify({ page: '/other' }), '2024-01-15T10:00:00Z');\n  });\n\n  afterEach(() => {\n    closeDb();\n  });\n\n  it('should export events as JSON', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/events?format=json');\n\n    expect(res.status).toBe(200);\n    expect(res.body).toBeInstanceOf(Array);\n    expect(res.body).toHaveLength(2); // Only tenant1 events\n    expect(res.body[0]).toHaveProperty('name');\n  });\n\n  it('should export events as CSV', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/events?format=csv');\n\n    expect(res.status).toBe(200);\n    expect(res.headers['content-type']).toContain('text/csv');\n    const lines = res.text.split('\\n');\n    expect(lines[0]).toContain('id');\n    expect(lines.length).toBe(3); // header + 2 events\n  });\n\n  it('should only export events for current tenant', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/events?format=json');\n\n    expect(res.body).toHaveLength(2);\n    for (const event of res.body) {\n      expect(event.tenant_id).toBe('tenant1');\n    }\n  });\n\n  it('should export dashboard data', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    // Create 