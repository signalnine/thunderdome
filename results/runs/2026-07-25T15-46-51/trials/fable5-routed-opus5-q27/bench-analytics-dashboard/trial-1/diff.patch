@@ -0,0 +1,283 @@
+import { Router, Request, Response, NextFunction } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+import { getAuthUser } from '../auth';
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+interface Dashboard {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: Record<string, unknown>;
+  created_at: string;
+  updated_at: string;
+}
+
+interface Widget {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: Record<string, unknown>;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+function parseDashboard(row: DashboardRow): Dashboard {
+  return {
+    ...row,
+    config: JSON.parse(row.config),
+  };
+}
+
+function parseWidget(row: WidgetRow): Widget {
+  return {
+    ...row,
+    config: JSON.parse(row.config),
+  };
+}
+
+function getDashboardForTenant(db: ReturnType<typeof getDb>, id: string, tenantId: string): DashboardRow {
+  const row = db.prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?').get(id, tenantId) as DashboardRow | undefined;
+  if (!row) {
+    throw new ApiError(404, 'Dashboard not found', 'NOT_FOUND');
+  }
+  return row;
+}
+
+const VALID_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];
+
+const router = Router();
+
+router.post('/', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const db = getDb();
+    const auth = getAuthUser(req);
+    const body = req.body as Record<string, unknown>;
+    const name = body.name;
+    if (typeof name !== 'string' || name.trim() === '') {
+      throw new ApiError(400, 'name is required', 'VALIDATION_ERROR');
+    }
+    const config = body.config ?? {};
+    const now = new Date().toISOString();
+    const id = uuidv4();
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    ).run(id, auth.tenantId, name, auth.id, JSON.stringify(config), now, now);
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+    res.status(201).json(parseDashboard(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const db = getDb();
+    const auth = getAuthUser(req);
+    const rows = db.prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at').all(auth.tenantId) as DashboardRow[];
+    res.status(200).json(rows.map(parseDashboard));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/:id', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const db = getDb();
+    const auth = getAuthUser(req);
+    const id = req.params.id;
+    const dash = getDashboardForTenant(db, id, auth.tenantId);
+    const widgets = db.prepare('SELECT * FROM widgets WHERE dashboard_id = ?').all(id) as WidgetRow[];
+    res.status(200).json({
+      ...parseDashboard(dash),
+      widgets: widgets.map(parseWidget),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.patch('/:id', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const db = getDb();
+    const auth = getAuthUser(req);
+    const id = req.params.id;
+    getDashboardForTenant(db, id, auth.tenantId);
+    const body = req.body as Record<string, unknown>;
+    const updates: string[] = [];
+    const values: unknown[] = [];
+    if ('name' in body) {
+      const name = body.name;
+      if (typeof name !== 'string' || name.trim() === '') {
+        throw new ApiError(400, 'name is required', 'VALIDATION_ERROR');
+      }
+      updates.push('name = ?');
+      values.push(name);
+    }
+    if ('config' in body) {
+      updates.push('config = ?');
+      values.push(JSON.stringify(body.config));
+    }
+    const now = new Date().toISOString();
+    updates.push('updated_at = ?');
+    values.push(now);
+    if (updates.length > 0) {
+      values.push(id);
+      db.prepare(`UPDATE dashboards SET ${updates.join(', ')} WHERE id = ?`).run(...values);
+    }
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+    res.status(200).json(parseDashboard(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.delete('/:id', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const db = getDb();
+    const auth = getAuthUser(req);
+    const id = req.params.id;
+    getDashboardForTenant(db, id, auth.tenantId);
+    db.prepare('DELETE FROM widgets WHERE dashboard_id = ?').run(id);
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(id);
+    res.status(204).send();
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/:id/widgets', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const db = getDb();
+    const auth = getAuthUser(req);
+    const id = req.params.id;
+    getDashboardForTenant(db, id, auth.tenantId);
+    const body = req.body as Record<string, unknown>;
+    const type = body.type;
+    if (!VALID_TYPES.includes(type as string)) {
+      throw new ApiError(400, 'invalid widget type', 'VALIDATION_ERROR');
+    }
+    const config = body.config ?? {};
+    const position_x = typeof body.position_x === 'number' ? body.position_x : 0;
+    const position_y = typeof body.position_y === 'number' ? body.position_y : 0;
+    const width = typeof body.width === 'number' ? body.width : 1;
+    const height = typeof body.height === 'number' ? body.height : 1;
+    const widgetId = uuidv4();
+    db.prepare(
+      'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+    ).run(widgetId, id, type, JSON.stringify(config), position_x, position_y, width, height);
+    const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(widgetId) as WidgetRow;
+    res.status(201).json(parseWidget(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.patch('/:id/widgets/:widgetId', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const db = getDb();
+    const auth = getAuthUser(req);
+    const id = req.params.id;
+    const widgetId = req.params.widgetId;
+    getDashboardForTenant(db, id, auth.tenantId);
+    const widget = db.prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?').get(widgetId, id) as WidgetRow | undefined;
+    if (!widget) {
+      throw new ApiError(404, 'Widget not found', 'NOT_FOUND');
+    }
+    const body = req.body as Record<string, unknown>;
+    const updates: string[] = [];
+    const values: unknown[] = [];
+    if ('type' in body) {
+      const type = body.type;
+      if (!VALID_TYPES.includes(type as string)) {
+        throw new ApiError(400, 'invalid widget type', 'VALIDATION_ERROR');
+      }
+      updates.push('type = ?');
+      values.push(type);
+    }
+    if ('config' in body) {
+      updates.push('config = ?');
+      values.push(JSON.stringify(body.config));
+    }
+    if ('position_x' in body) {
+      if (typeof body.position_x !== 'number') {
+        throw new ApiError(400, 'position_x must be a number', 'VALIDATION_ERROR');
+      }
+      updates.push('position_x = ?');
+      values.push(body.position_x);
+    }
+    if ('position_y' in body) {
+      if (typeof body.position_y !== 'number') {
+        throw new ApiError(400, 'position_y must be a number', 'VALIDATION_ERROR');
+      }
+      updates.push('position_y = ?');
+      values.push(body.position_y);
+    }
+    if ('width' in body) {
+      if (typeof body.width !== 'number') {
+        throw new ApiError(400, 'width must be a number', 'VALIDATION_ERROR');
+      }
+      updates.push('width = ?');
+      values.push(body.width);
+    }
+    if ('height' in body) {
+      if (typeof body.height !== 'number') {
+        throw new ApiError(400, 'height must be a number', 'VALIDATION_ERROR');
+      }
+      updates.push('height = ?');
+      values.push(body.height);
+    }
+    if (updates.length > 0) {
+      values.push(widgetId);
+      db.prepare(`UPDATE widgets SET ${updates.join(', ')} WHERE id = ?`).run(...values);
+    }
+    const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(widgetId) as WidgetRow;
+    res.status(200).json(parseWidget(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.delete('/:id/widgets/:widgetId', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const db = getDb();
+    const auth = getAuthUser(req);
+    const id = req.params.id;
+    const widgetId = req.params.widgetId;
+    getDashboardForTenant(db, id, auth.tenantId);
+    const widget = db.prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?').get(widgetId, id) as WidgetRow | undefined;
+    if (!widget) {
+      throw new ApiError(404, 'Widget not found', 'NOT_FOUND');
+    }
+    db.prepare('DELETE FROM widgets WHERE id = ?').run(widgetId);
+    res.status(204).send();
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
