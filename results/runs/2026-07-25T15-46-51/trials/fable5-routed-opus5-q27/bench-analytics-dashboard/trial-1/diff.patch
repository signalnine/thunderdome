rftime('${format}', timestamp) AS bucket, COUNT(*) AS count\n       FROM events WHERE tenant_id = ? AND name = ?${clause}\n       GROUP BY bucket ORDER BY bucket`\n    )\n    .all(...params) as Array<{ bucket: string; count: number }>;\n}\n\nexport function breakdown(\n  db: Database.Database,\n  tenantId: string,\n  eventName: string,\n  propertyKey: string,\n  range: TimeRange = {}\n): Array<{ property_value: string | null; count: number }> {\n  const jsonPath = `$.\"${propertyKey.replace(/\"/g, '\"\"')}\"`;\n  const params: unknown[] = [jsonPath, tenantId, eventName];\n  const clause = rangeClause(range, params);\n  return db\n    .prepare(\n      `SELECT json_extract(properties, ?) AS property_value, COUNT(*) AS count\n       FROM events WHERE tenant_id = ? AND name = ?${clause}\n       GROUP BY property_value ORDER BY count DESC`\n    )\n    .all(...params) as Array<{ property_value: string | null; count: number }>;\n}\n\nexport function funnel(\n  db: Database.Database,\n  tenantId: string,\n  steps: string[],\n  range: TimeRange = {}\n): Array<{ name: string; count: number }> {\n  const placeholders = steps.map(() => '?').join(', ');\n  const params: unknown[] = [tenantId, ...steps];\n  const clause = rangeClause(range, params);\n  const rows = db\n    .prepare(\n      `SELECT name, session_id, user_id, id, timestamp\n       FROM events WHERE tenant_id = ? AND name IN (${placeholders})${clause}\n       ORDER BY timestamp ASC, id ASC`\n    )\n    .all(...params) as Array<{\n    name: string;\n    session_id: string | null;\n    user_id: string | null;\n    id: string;\n    timestamp: string;\n  }>;\n\n  // Group events by session (falling back to user, then to the event itself\n  // so anonymous one-off events still count toward the first step).\n  const groups = new Map<string, string[]>();\n  for (const row of rows) {\n    const key = row.session_id ?? row.user_id ?? `event:${row.id}`;\n    const list = groups.get(key);\n    if (list) {\n      list.push(row.name);\n    } else {\n      groups.set(key, [row.name]);\n    }\n  }\n\n  const counts = steps.map(() => 0);\n  for (const names of groups.values()) {\n    let stepIndex = 0;\n    for (const name of names) {\n      if (stepIndex < steps.length && name === steps[stepIndex]) {\n        counts[stepIndex] += 1;\n        stepIndex += 1;\n      }\n    }\n  }\n\n  return steps.map((name, i) => ({ name, count: counts[i] }));\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
