+import { Request, Response, NextFunction } from 'express';
+import jwt from 'jsonwebtoken';
+import { ApiError } from './errors';
+
+export const JWT_SECRET = process.env.JWT_SECRET || 'dev-secret-change-in-production';
+export const JWT_EXPIRES_IN = '24h';
+
+export interface AuthUser {
+  id: string;
+  tenantId: string;
+}
+
+export interface AuthedRequest extends Request {
+  user?: AuthUser;
+}
+
+export function getAuthUser(req: Request): AuthUser {
+  const user = (req as AuthedRequest).user;
+  if (!user) {
+    throw new ApiError(401, 'Not authenticated', 'AUTH_ERROR');
+  }
+  return user;
+}
+
+export function signToken(userId: string, tenantId: string): string {
+  return jwt.sign({ sub: userId, tid: tenantId }, JWT_SECRET, {
+    expiresIn: JWT_EXPIRES_IN,
+  });
+}
+
+export function requireAuth(req: Request, res: Response, next: NextFunction): void {
+  const header = req.headers.authorization;
+  if (!header || !header.startsWith('Bearer ')) {
+    next(new ApiError(401, 'Missing or malformed Authorization header', 'AUTH_ERROR'));
+    return;
+  }
+  const token = header.slice('Bearer '.length);
+  try {
+    const payload = jwt.verify(token, JWT_SECRET) as jwt.JwtPayload;
+    if (typeof payload.sub !== 'string' || typeof payload.tid !== 'string') {
+      next(new ApiError(401, 'Invalid token payload', 'AUTH_ERROR'));
+      return;
+    }
+    (req as AuthedRequest).user = { id: payload.sub, tenantId: payload.tid };
+    next();
+  } catch {
+    next(new ApiError(401, 'Invalid or expired token', 'AUTH_ERROR'));
+  }
+}
diff --git a/src/dashboards/router.ts b/src/dashboards/router.ts
