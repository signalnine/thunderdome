t decoded = jwt.decode(token) as Record<string, unknown>;\n55\t\n56\t    expect(decoded).toHaveProperty('sub');\n57\t    expect(decoded).toHaveProperty('tid');\n58\t    expect(decoded).toHaveProperty('iat');\n59\t    expect(decoded).toHaveProperty('exp');\n60\t    expect(decoded.tid).toBe(TENANT_A);\n61\t  });\n62\t\n63\t  // --- Auth Error Format Consistency (2 tests) ---\n64\t\n65\t  it('should return consistent error format for missing auth', async () => {\n66\t    const endpoints = [\n67\t      { method: 'get' as const, url: '/users/me' },\n68\t      { method: 'post' as const, url: '/events' },\n69\t      { method: 'post' as const, url: '/query/count' },\n70\t      { method: 'get' as const, url: '/dashboards' },\n71\t      { method: 'get' as const, url: '/export/events?format=json' },\n72\t    ];\n73\t\n74\t    for (const ep of endpoints) {\n75\t      const res = await request(app)[ep.method](ep.url);\n76\t      expect(res.status).toBe(401);\n77\t      expect(res.body).toHaveProperty('error');\n78\t      expect(res.body).toHaveProperty('code');\n79\t      expect(typeof res.body.error).toBe('string');\n80\t      expect(typeof res.body.code).toBe('string');\n81\t    }\n82\t  });\n83\t\n84\t  it('should return consistent error format for invalid token', async () => {\n85\t    const endpoints = [\n86\t      { method: 'get' as const, url: '/users/me' },\n87\t      { method: 'post' as const, url: '/events' },\n88\t      { method: 'get' as const, url: '/dashboards' },\n89\t    ];\n90\t\n91\t    for (const ep of endpoints) {\n92\t      const res = await request(app)\n93\t        [ep.method](ep.url)\n94\t        .set('Authorization', 'Bearer invalid-token-here');\n95\t\n96\t      expect(res.status).toBe(401);\n97\t      expect(res.body).toHaveProperty('error');\n98\t      expect(res.body).toHaveProperty('code');\n99\t      expect(res.body.code).toBe('AUTH_ERROR');\n100\t    }\n101\t  });\n102\t\n103\t  // --- Ingest with Real Auth (2 tests) ---\n104\t\n105\t  it('should 