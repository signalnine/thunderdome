+import { Router } from 'express';
+import { randomUUID } from 'node:crypto';
+import type { Database } from 'better-sqlite3';
+import type { Document, Version } from './models.js';
+
+export function createRoutes(db: Database): Router {
+  const router = Router();
+
+  router.post('/docs', (req, res) => {
+    const { title = 'Untitled', content = '' } = (req.body ?? {}) as { title?: string; content?: string };
+    const id = randomUUID();
+    db.prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?)').run(id, title, content);
+    db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)').run(id, content);
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Document | undefined;
+    res.status(201).json(doc);
+  });
+
+  router.get('/docs', (_req, res) => {
+    const docs = db.prepare('SELECT * FROM documents ORDER BY created_at').all() as Document[];
+    res.json(docs);
+  });
+
+  router.get('/docs/:id', (req, res) => {
+    const { id } = req.params;
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Document | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  router.put('/docs/:id', (req, res) => {
+    const { id } = req.params;
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Document | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const { title, content } = (req.body ?? {}) as { title?: string; content?: string };
+    if (typeof title === 'string') {
+      db.prepare('UPDATE documents SET title = ?, updated_at = datetime(\'now\') WHERE id = ?').run(title, id);
+    }
+    if (typeof content === 'string') {
+      db.prepare('UPDATE documents SET content = ?, updated_at = datetime(\'now\') WHERE id = ?').run(content, id);
+      const next = (db.prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?').get(id) as { v: number | null }).v ?? 0;
+      db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, NULL)').run(id, next + 1, content);
+    }
+    const updatedDoc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Document | undefined;
+    res.json(updatedDoc);
+  });
+
+  router.delete('/docs/:id', (req, res) => {
+    const { id } = req.params;
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Document | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    db.prepare('DELETE FROM documents WHERE id = ?').run(id);
+    res.status(204).end();
+  });
+
+  router.get('/docs/:id/versions', (req, res) => {
+    const { id } = req.params;
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Document | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const versions = db.prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC').all(id) as Version[];
+    res.json(versions);
+  });
+
+  router.get('/docs/:id/versions/:version', (req, res) => {
+    const { id } = req.params;
+    const v = Number.parseInt(req.params.version, 10);
+    if (Number.isNaN(v)) {
+      res.status(404).json({ error: 'Version not found' });
+      return;
+    }
+    const row = db.prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?').get(id, v) as Version | undefined;
+    if (!row) {
+      res.status(404).json({ error: 'Version not found' });
+      return;
+    }
+    res.json(row);
+  });
+
+  return router;
+}
