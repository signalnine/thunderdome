"originalFile":"import { WebSocketServer, WebSocket } from 'ws';\nimport type { Server } from 'node:http';\nimport type { Database } from 'better-sqlite3';\nimport { randomUUID } from 'node:crypto';\nimport type { Document, Operation } from './models.js';\nimport { applyOperation, transformOperation, validateOperation } from './ot.js';\n\ninterface Room {\n  content: string;\n  version: number;\n  /** Ops applied since the room was loaded; history[i] produced version historyBase + i + 1. */\n  history: Operation[];\n  historyBase: number;\n  clients: Set<WebSocket>;\n}\n\nfunction send(ws: WebSocket, msg: Record<string, unknown>): void {\n  if (ws.readyState === WebSocket.OPEN) {\n    ws.send(JSON.stringify(msg));\n  }\n}\n\nexport function setupWss(server: Server, db: Database): WebSocketServer {\n  const wss = new WebSocketServer({ server });\n  const rooms = new Map<string, Room>();\n\n  const getDoc = db.prepare('SELECT * FROM documents WHERE id = ?');\n  const maxVersion = db.prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?');\n  const updateDoc = db.prepare(\"UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?\");\n  const insertVersion = db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)');\n  const insertConn = db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)');\n  const deleteConn = db.prepare('DELETE FROM active_connections WHERE id = ?');\n\n  function getRoom(docId: string, doc: Document): Room {\n    let room = rooms.get(docId);\n    if (!room) {\n      const version = (maxVersion.get(docId) as { v: number | null }).v ?? 0;\n      room = { content: doc.content, version, history: [], historyBase: version, clients: new Set() };\n      rooms.set(docId, room);\n    }\n    return room;\n  }\n\n  function handleOperation(ws: WebSocket, docId: string, room: Room, raw: unknown): void {\n    const msg = raw as { type?: unknown; operation?: unknown;