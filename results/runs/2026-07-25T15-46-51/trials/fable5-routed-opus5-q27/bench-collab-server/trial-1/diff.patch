+import Database from 'better-sqlite3';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+
+const schemaPath = fileURLToPath(new URL('../schema.sql', import.meta.url));
+
+/**
+ * Open (or create) the SQLite database, apply the schema, and clear any
+ * stale connection rows left over from a previous run.
+ */
+export function createDb(dbPath = ':memory:'): Database.Database {
+  const db = new Database(dbPath);
+  db.pragma('foreign_keys = ON');
+  db.exec(readFileSync(schemaPath, 'utf-8'));
+  db.exec('DELETE FROM active_connections');
+  return db;
+}
