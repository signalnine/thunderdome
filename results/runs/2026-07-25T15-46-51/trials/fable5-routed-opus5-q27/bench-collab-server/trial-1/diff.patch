sed);\n      } catch {\n        send(ws, { type: 'error', message: 'Failed to process operation' });\n      }\n    });\n\n    ws.on('close', () => {\n      room.clients.delete(ws);\n      try {\n        deleteConn.run(connId);\n      } catch {\n        // db may already be closed during shutdown\n      }\n      if (room.clients.size === 0) {\n        rooms.delete(docId);\n      }\n    });\n  });\n\n  return wss;\n}\n","structuredPatch":[{"oldStart":48,"oldLines":7,"newStart":48,"newLines":12,"lines":["       return;","     }"," ","-    let op = msg.operation as Operation;","+    if (!validateOperation(msg.operation, Number.POSITIVE_INFINITY)) {","+      send(ws, { type: 'error', message: 'Invalid operation' });","+      return;","+    }","+","+    let op: Operation = msg.operation;","     const base = typeof msg.version === 'number'","       ? Math.min(Math.max(msg.version, room.historyBase), room.version)","       : room.version;"]},{"oldStart":58,"oldLines":7,"newStart":63,"newLines":10,"lines":["       op = transformOperation(op, room.history[v - room.historyBase]);","     }"," ","-    if (!validateOperation(op, room.content.length)) {","+    // A delete whose entire range was already removed concurrently collapses to","+    // a count of 0; that is a legitimate no-op, not an invalid operation.","+    const isNoopDelete = op.type === 'delete' && op.count === 0;","+    if (!isNoopDelete && !validateOperation(op, room.content.length)) {","       send(ws, { type: 'error', message: 'Invalid operation' });","       return;","     }"]}],"userModified":false,"replaceAll":false}}
