@@ -0,0 +1,94 @@
+import type { Operation } from './models.js';
+
+/**
+ * Applies an operation to a document and returns the resulting content.
+ * A delete with a count of 0 is treated as a no-op.
+ */
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  if (op.count === 0) {
+    return content;
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+/**
+ * Transforms `op1` against a concurrent operation `op2` that has already been
+ * applied to the document, so that `op1` can be applied afterwards and preserve
+ * its original intent. Always returns a new object; neither input is mutated.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert') {
+    if (op2.type === 'insert') {
+      // Ties shift: op2 already occupies the position, so op1 lands after it.
+      if (op1.position < op2.position) {
+        return { type: 'insert', position: op1.position, text: op1.text };
+      }
+      return { type: 'insert', position: op1.position + op2.text.length, text: op1.text };
+    }
+    // insert vs delete
+    if (op1.position <= op2.position) {
+      return { type: 'insert', position: op1.position, text: op1.text };
+    }
+    if (op1.position >= op2.position + op2.count) {
+      return { type: 'insert', position: op1.position - op2.count, text: op1.text };
+    }
+    // The insertion point fell inside the removed range; collapse to its start.
+    return { type: 'insert', position: op2.position, text: op1.text };
+  }
+
+  if (op2.type === 'insert') {
+    // delete vs insert
+    if (op2.position <= op1.position) {
+      return { type: 'delete', position: op1.position + op2.text.length, count: op1.count };
+    }
+    if (op2.position >= op1.position + op1.count) {
+      return { type: 'delete', position: op1.position, count: op1.count };
+    }
+    // The insertion landed inside the range being deleted; widen the range so it
+    // still covers through its original end.
+    return { type: 'delete', position: op1.position, count: op1.count + op2.text.length };
+  }
+
+  // delete vs delete: characters already removed by op2 must not be removed twice.
+  const overlapStart = Math.max(op1.position, op2.position);
+  const overlapEnd = Math.min(op1.position + op1.count, op2.position + op2.count);
+  const overlap = Math.max(0, overlapEnd - overlapStart);
+  const shift = Math.min(op2.count, Math.max(0, op1.position - op2.position));
+  return {
+    type: 'delete',
+    position: op1.position - shift,
+    count: op1.count - overlap,
+  };
+}
+
+/**
+ * Type guard checking that `op` is a structurally valid {@link Operation} whose
+ * bounds fit a document of `contentLength` characters.
+ */
+export function validateOperation(op: unknown, contentLength: number): op is Operation {
+  if (typeof op !== 'object' || op === null) {
+    return false;
+  }
+  const candidate = op as Record<string, unknown>;
+  const type = candidate.type;
+  if (type !== 'insert' && type !== 'delete') {
+    return false;
+  }
+  const position = candidate.position;
+  if (typeof position !== 'number' || !Number.isInteger(position) || position < 0) {
+    return false;
+  }
+  if (type === 'insert') {
+    return typeof candidate.text === 'string' && position <= contentLength;
+  }
+  const count = candidate.count;
+  return (
+    typeof count === 'number' &&
+    Number.isInteger(count) &&
+    count >= 1 &&
+    position + count <= contentLength
+  );
+}
