+import { WebSocketServer, WebSocket } from 'ws';
+import type { Server } from 'node:http';
+import type { Database } from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+import type { Document, Operation } from './models.js';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+
+interface Room {
+  content: string;
+  version: number;
+  /** Ops applied since the room was loaded; history[i] produced version historyBase + i + 1. */
+  history: Operation[];
+  historyBase: number;
+  clients: Set<WebSocket>;
+}
+
+function send(ws: WebSocket, msg: Record<string, unknown>): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify(msg));
+  }
+}
+
+export function setupWss(server: Server, db: Database): WebSocketServer {
+  const wss = new WebSocketServer({ server });
+  const rooms = new Map<string, Room>();
+
+  const getDoc = db.prepare('SELECT * FROM documents WHERE id = ?');
+  const maxVersion = db.prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?');
+  const updateDoc = db.prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?");
+  const insertVersion = db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)');
+  const insertConn = db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)');
+  const deleteConn = db.prepare('DELETE FROM active_connections WHERE id = ?');
+
+  function getRoom(docId: string, doc: Document): Room {
+    let room = rooms.get(docId);
+    if (!room) {
+      const version = (maxVersion.get(docId) as { v: number | null }).v ?? 0;
+      room = { content: doc.content, version, history: [], historyBase: version, clients: new Set() };
+      rooms.set(docId, room);
+    }
+    return room;
+  }
+
+  function handleOperation(ws: WebSocket, docId: string, room: Room, raw: unknown): void {
+    const msg = raw as { type?: unknown; operation?: unknown; version?: unknown };
+    if (msg.type !== 'operation') {
+      send(ws, { type: 'error', message: 'Unsupported message type' });
+      return;
+    }
+
+    if (!validateOperation(msg.operation, Number.POSITIVE_INFINITY)) {
+      send(ws, { type: 'error', message: 'Invalid operation' });
+      return;
+    }
+
+    let op: Operation = msg.operation;
+    const base = typeof msg.version === 'number'
+      ? Math.min(Math.max(msg.version, room.historyBase), room.version)
+      : room.version;
+
+    // Transform the incoming op against every op applied since its base version.
+    for (let v = base; v < room.version; v++) {
+      op = transformOperation(op, room.history[v - room.historyBase]);
+    }
+
+    // A delete whose entire range was already removed concurrently collapses to
+    // a count of 0; that is a legitimate no-op, not an invalid operation.
+    const isNoopDelete = op.type === 'delete' && op.count === 0;
+    if (!isNoopDelete && !validateOperation(op, room.content.length)) {
+      send(ws, { type: 'error', message: 'Invalid operation' });
+      return;
+    }
+
+    room.content = applyOperation(room.content, op);
+    room.version += 1;
+    room.history.push(op);
+
+    updateDoc.run(room.content, docId);
+    insertVersion.run(docId, room.version, room.content, JSON.stringify(op));
+
+    send(ws, { type: 'ack', version: room.version });
+    for (const client of room.clients) {
+      if (client !== ws) {
+        send(client, { type: 'operation', operation: op, version: room.version });
+      }
+    }
+  }
+
+  wss.on('connection', (ws, req) => {
+    const docId = decodeURIComponent((req.url ?? '/').split('?')[0].replace(/^\//, ''));
+    const doc = getDoc.get(docId) as Document | undefined;
+    if (!doc) {
+      send(ws, { type: 'error', message: `Document ${docId} not found` });
+      ws.close();
+      return;
+    }
+
+    const room = getRoom(docId, doc);
+    room.clients.add(ws);
+    const connId = randomUUID();
+    insertConn.run(connId, docId);
+
+    send(ws, { type: 'sync', content: room.content, version: room.version });
+
+    ws.on('message', (data) => {
+      let parsed: unknown;
+      try {
+        parsed = JSON.parse(data.toString());
+      } catch {
+        send(ws, { type: 'error', message: 'Malformed JSON' });
+        return;
+      }
+      try {
+        handleOperation(ws, docId, room, parsed);
+      } catch {
+        send(ws, { type: 'error', message: 'Failed to process operation' });
+      }
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      try {
+        deleteConn.run(connId);
+      } catch {
+        // db may already be closed during shutdown
+      }
+      if (room.clients.size === 0) {
+        rooms.delete(docId);
+      }
+    });
+  });
+
+  return wss;
+}
