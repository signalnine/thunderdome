+/**
+ * Counts the number of unique cells visited by beams originating from the source.
+ * @param grid - 2D array of single-char strings.
+ * @returns The number of unique cells visited.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+  if (cols === 0) return 0;
+
+  let sr = -1;
+  let sc = -1;
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      if (grid[r][c] === 'S') {
+        sr = r;
+        sc = c;
+        break;
+      }
+    }
+    if (sr !== -1) break;
+  }
+  if (sr === -1) return 0;
+
+  const visited = new Set<number>();
+  const seen = new Set<number>();
+
+  const queue: [number, number, number][] = [[sr, sc, 0]];
+  let idx = 0;
+
+  while (idx < queue.length) {
+    const [r, c, dir] = queue[idx++];
+    const stateKey = (r * cols + c) * 3 + (dir + 1);
+    if (seen.has(stateKey)) continue;
+    seen.add(stateKey);
+    visited.add(r * cols + c);
+
+    const outgoing = grid[r][c] === '^' ? [-1, 1] : [dir];
+    for (const d of outgoing) {
+      const nr = r + 1;
+      const nc = c + d;
+      if (nr < rows && nc >= 0 && nc < cols) {
+        queue.push([nr, nc, d]);
+      }
+    }
+  }
+
+  return visited.size;
+}
+
+/**
+ * Counts the number of distinct source-to-exit beam paths through the grid.
+ * @param grid - 2D array of single-char strings.
+ * @returns The number of distinct beam paths as a bigint.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+  if (cols === 0) return 0n;
+
+  let sr = -1;
+  let sc = -1;
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      if (grid[r][c] === 'S') {
+        sr = r;
+        sc = c;
+        break;
+      }
+    }
+    if (sr !== -1) break;
+  }
+  if (sr === -1) return 0n;
+
+  let total = 0n;
+  let current = new Map<number, bigint>();
+  current.set(sc * 3 + 1, 1n);
+
+  for (let r = sr; r < rows; r++) {
+    const next = new Map<number, bigint>();
+    for (const [key, count] of current.entries()) {
+      const c = Math.floor(key / 3);
+      const dir = (key % 3) - 1;
+
+      const outgoing = grid[r][c] === '^' ? [-1, 1] : [dir];
+      for (const d of outgoing) {
+        const nr = r + 1;
+        const nc = c + d;
+        if (nr >= rows || nc < 0 || nc >= cols) {
+          total += count;
+        } else {
+          const nkey = nc * 3 + (d + 1);
+          next.set(nkey, (next.get(nkey) ?? 0n) + count);
+        }
+      }
+    }
+    current = next;
+    if (current.size === 0) break;
+  }
+
+  return total;
+}
