@@ -0,0 +1,44 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: async (file: ContentFile): Promise<ContentFile> => {
+        let source = file.content;
+
+        // Collect footnote definitions and strip them from the source
+        const footnotes = new Map<string, string>();
+        source = source.replace(/^\[\^([^\]]+)\]:[ \t]*(.*)$/gm, (_match, id: string, text: string) => {
+          footnotes.set(id, text.trim());
+          return '';
+        });
+
+        // Footnote references become superscript links
+        source = source.replace(/\[\^([^\]]+)\]/g, '<sup><a href="#fn-$1">$1</a></sup>');
+
+        // Admonition containers become divs; surrounding blank lines make
+        // marked treat the div tags as HTML blocks and still render the body
+        source = source.replace(
+          /^:::(\w+)\r?\n([\s\S]*?)\r?\n:::[ \t]*$/gm,
+          (_match, kind: string, body: string) =>
+            `<div class="admonition admonition-${kind}">\n\n${body}\n\n</div>`
+        );
+
+        let html = await marked.parse(source);
+
+        if (footnotes.size > 0) {
+          const items = [...footnotes.entries()]
+            .map(([id, text]) => `<li id="fn-${id}">${text}</li>`)
+            .join('\n');
+          html += `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
