+import { Plugin, BuildContext } from '../core/types.js';
+
+export function createSitemapPlugin(): Plugin {
+  return {
+    name: 'sitemap',
+    version: '1.0.0',
+    dependencies: ['taxonomy', 'rss-feed'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const paths = [...ctx.output.keys()];
+        const filteredPaths = paths.filter(
+          (p) => p.endsWith('.html') || p.endsWith('.xml'),
+        );
+
+        const urls = filteredPaths.map((p) => ctx.config.baseUrl + '/' + p);
+
+        const urlBlocks = urls
+          .map((url) => {
+            return '<url>\n<loc>' + url + '</loc>\n</url>';
+          })
+          .join('\n');
+
+        const sitemap =
+          '<?xml version="1.0" encoding="UTF-8"?>\n' +
+          '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n' +
+          urlBlocks +
+          '\n</urlset>';
+
+        ctx.output.set('sitemap.xml', sitemap);
+      },
+    },
+  };
+}
