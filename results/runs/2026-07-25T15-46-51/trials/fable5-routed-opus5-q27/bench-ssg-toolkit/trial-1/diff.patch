+import { Plugin, ContentFile } from '../core/types.js';
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild(ctx) {
+        const tagMap = new Map<string, ContentFile[]>();
+
+        for (const file of ctx.files) {
+          const tags = file.tags ?? [];
+          for (const tag of tags) {
+            const lowerTag = tag.toLowerCase();
+            const existing = tagMap.get(lowerTag);
+            if (existing) {
+              existing.push(file);
+            } else {
+              tagMap.set(lowerTag, [file]);
+            }
+          }
+        }
+
+        ctx.data.set('taxonomy-tags', tagMap);
+      },
+      afterBuild(ctx) {
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+        if (tagMap === undefined) {
+          return;
+        }
+
+        for (const [tag, files] of tagMap) {
+          const items = files
+            .map((file) => `<li><a href="/${file.slug}.html">${file.title}</a></li>`)
+            .join('');
+          const page = `<html><body><h1>Tag: ${tag}</h1><ul>${items}</ul></body></html>`;
