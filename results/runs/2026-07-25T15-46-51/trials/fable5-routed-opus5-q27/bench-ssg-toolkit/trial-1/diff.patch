+import { Plugin, ContentFile } from '../core/types.js';
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild(ctx) {
+        const sorted = [...ctx.files].sort((a, b) => {
+          const tsA = a.date ? Date.parse(a.date) : 0;
+          const tsB = b.date ? Date.parse(b.date) : 0;
+          return tsB - tsA;
+        });
+
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+
+        const items = sorted.map((file) => {
+          const link = `${ctx.config.baseUrl}/${file.slug}.html`;
+          const pubDate = file.date ? `<pubDate>${new Date(file.date).toUTCString()}</pubDate>` : '';
+
+          let categories: string[];
+          if (tagMap) {
+            categories = [...tagMap.keys()].filter((tag) => {
+              const filesForTag = tagMap.get(tag);
+              return filesForTag && filesForTag.some((f) => f.slug === file.slug);
+            });
+          } else {
+            categories = file.tags ?? [];
+          }
+
+          const categoryElements = categories.map((tag) => `<category>${tag}</category>`).join('\n');
+
+          return [
+            `<item>`,
+            `<title>${file.title}</title>`,
+            `<link>${link}</link>`,
+            pubDate,
+            categoryElements,
+            `<description><![CDATA[${file.content}]]></description>`,
+            `</item>`,
+          ]
+            .filter(Boolean)
+            .join('\n');
+        });
+
+        const feed = [
+          `<?xml version="1.0" encoding="UTF-8"?>`,
+          `<rss version="2.0">`,
+          `<channel>`,
+          `<title>${ctx.config.title}</title>`,
+          `<link>${ctx.config.baseUrl}</link>`,
+          `<description>${ctx.config.title}</description>`,
+          ...items,
+          `</channel>`,
+          `</rss>`,
+        ].join('\n');
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
