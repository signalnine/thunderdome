\t    const invoice = getInvoiceById(db, 999);\n61\t    expect(invoice).toBeUndefined();\n62\t  });\n63\t\n64\t  it('creates an invoice with line items', () => {\n65\t    const id = createInvoice(db, {\n66\t      customer_id: 'cust-2',\n67\t      date: '2024-04-01',\n68\t      subtotal: 250,\n69\t      discount_rate: 0,\n70\t      tax_rate: 0.05,\n71\t      total: 262.50,\n72\t      status: 'draft',\n73\t      line_items: [\n74\t        { description: 'Widget A', quantity: 5, unit_price: 30 },\n75\t        { description: 'Widget B', quantity: 2, unit_price: 50 },\n76\t      ],\n77\t    });\n78\t    const invoice = getInvoiceById(db, id);\n79\t    expect(invoice!.line_items).toHaveLength(2);\n80\t    expect(invoice!.line_items[0].description).toBe('Widget A');\n81\t  });\n82\t\n83\t  it('lists invoices by customer', () => {\n84\t    createInvoice(db, {\n85\t      customer_id: 'cust-A',\n86\t      date: '2024-01-10',\n87\t      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'paid',\n88\t    });\n89\t    createInvoice(db, {\n90\t      customer_id: 'cust-B',\n91\t      date: '2024-01-12',\n92\t      subtotal: 200, discount_rate: 0, tax_rate: 0, total: 200, status: 'paid',\n93\t    });\n94\t    createInvoice(db, {\n95\t      customer_id: 'cust-A',\n96\t      date: '2024-02-05',\n97\t      subtotal: 150, discount_rate: 0, tax_rate: 0, total: 150, status: 'draft',\n98\t    });\n99\t\n100\t    const invoices = getInvoicesByCustomer(db, 'cust-A');\n101\t    expect(invoices).toHaveLength(2);\n102\t    expect(invoices.every(inv => inv.customer_id === 'cust-A')).toBe(true);\n103\t  });\n104\t\n105\t  it('returns invoices sorted by date', () => {\n106\t    createInvoice(db, {\n107\t      customer_id: 'cust-1',\n108\t      date: '2024-03-15',\n109\t      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'draft',\n110\t    });\n111\t    createInvoice(db, {\n112\t      customer_id: 'cust-1',\n113\t      date: '2024-01-10',\n114\t      subtotal: 20