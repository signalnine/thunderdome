+import Database from 'better-sqlite3';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+function createDb(): Database.Database {
+  const db = new Database(':memory:');
+  db.pragma('journal_mode = WAL');
+  db.exec(`
+    CREATE TABLE plugins (
+      name TEXT NOT NULL,
+      version TEXT NOT NULL,
+      description TEXT NOT NULL DEFAULT '',
+      author TEXT NOT NULL DEFAULT '',
+      dependencies TEXT NOT NULL DEFAULT '{}',
+      entry_point TEXT NOT NULL DEFAULT '',
+      permissions TEXT NOT NULL DEFAULT '[]',
+      PRIMARY KEY (name, version)
+    )
+  `);
+  return db;
+}
+
+function toRow(manifest: PluginManifest): Record<string, unknown> {
+  return {
+    name: manifest.name,
+    version: manifest.version,
+    description: manifest.description,
+    author: manifest.author,
+    dependencies: JSON.stringify(manifest.dependencies),
+    entry_point: manifest.entryPoint,
+    permissions: JSON.stringify(manifest.permissions),
+  };
+}
+
+function fromRow(row: Record<string, unknown>): PluginManifest {
+  return {
+    name: row.name as string,
+    version: row.version as string,
+    description: row.description as string,
+    author: row.author as string,
+    dependencies: JSON.parse(row.dependencies as string) as Record<string, string>,
+    entryPoint: row.entry_point as string,
+    permissions: JSON.parse(row.permissions as string) as string[],
+  };
+}
+
+export function createRegistry(): RegistryService {
+  const db = createDb();
+
+  return {
+    register(manifest: PluginManifest): void {
+      const row = toRow(manifest);
+      db.prepare(`
+        INSERT OR REPLACE INTO plugins (name, version, description, author, dependencies, entry_point, permissions)
+        VALUES (@name, @version, @description, @author, @dependencies, @entry_point, @permissions)
+      `).run(row);
+    },
+
+    get(name: string): PluginManifest | null {
+      const row = db.prepare('SELECT * FROM plugins WHERE name = ? ORDER BY version DESC LIMIT 1').get(name);
+      return row ? fromRow(row as Record<string, unknown>) : null;
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const row = db.prepare('SELECT * FROM plugins WHERE name = ? AND version = ?').get(name, version);
+      return row ? fromRow(row as Record<string, unknown>) : null;
+    },
+
+    list(): PluginManifest[] {
+      const rows = db.prepare('SELECT * FROM plugins ORDER BY name, version').all();
+      return (rows as Record<string, unknown>[]).map(fromRow);
+    },
+
+    search(query: string): PluginManifest[] {
+      const q = `%${query}%`;
+      const rows = db.prepare(`
+        SELECT * FROM plugins WHERE name LIKE ? OR description LIKE ?
+        ORDER BY name
+      `).all(q, q);
+      return (rows as Record<string, unknown>[]).map(fromRow);
+    },
+
+    remove(name: string, version: string): boolean {
+      const result = db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?').run(name, version);
+      return result.changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      const rows = db.prepare('SELECT version FROM plugins WHERE name = ? ORDER BY version').all(name);
+      return (rows as { version: string }[]).map(r => r.version);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const sets: string[] = [];
+      const params: unknown[] = [];
+
+      if (updates.description !== undefined) {
+        sets.push('description = ?');
+        params.push(updates.description);
+      }
+      if (updates.author !== undefined) {
+        sets.push('author = ?');
+        params.push(updates.author);
+      }
+      if (updates.dependencies !== undefined) {
+        sets.push('dependencies = ?');
+        params.push(JSON.stringify(updates.dependencies));
+      }
+      if (updates.entryPoint !== undefined) {
+        sets.push('entry_point = ?');
+        params.push(updates.entryPoint);
+      }
+      if (updates.permissions !== undefined) {
+        sets.push('permissions = ?');
+        params.push(JSON.stringify(updates.permissions));
+      }
+
+      if (sets.length > 0) {
+        params.push(name);
+        params.push(version);
+        db.prepare(`UPDATE plugins SET ${sets.join(', ')} WHERE name = ? AND version = ?`).run(...params);
+      }
+    },
+  };
+}
