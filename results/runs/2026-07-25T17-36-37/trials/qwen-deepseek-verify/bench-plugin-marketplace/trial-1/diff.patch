+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+export function createDepsService(): DepsService {
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      const manifest = registry.get(name);
+      if (!manifest) {
+        return { name, version: 'unknown', dependencies: [] };
+      }
+
+      const deps = Object.entries(manifest.dependencies).map(([depName, _range]) => {
+        const depManifest = registry.get(depName);
+        if (!depManifest) {
+          return { name: depName, version: 'unknown', dependencies: [] };
+        }
+
+        const childDeps = Object.entries(depManifest.dependencies).map(([childName, _childRange]) => {
+          const childManifest = registry.get(childName);
+          if (!childManifest) {
+            return { name: childName, version: 'unknown', dependencies: [] };
+          }
+
+          const grandchildDeps = Object.entries(childManifest.dependencies).map(([gName, _gRange]) => {
+            const gManifest = registry.get(gName);
+            if (!gManifest) {
+              return { name: gName, version: 'unknown', dependencies: [] };
+            }
+            return { name: gName, version: gManifest.version, dependencies: [] };
+          });
+
+          return { name: childName, version: childManifest.version, dependencies: grandchildDeps };
+        });
+
+        return { name: depName, version: depManifest.version, dependencies: childDeps };
+      });
+
+      return { name, version: manifest.version, dependencies: deps };
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const cycles: string[][] = [];
+      const visited = new Set<string>();
+      const stack = new Set<string>();
+
+      function dfs(node: string, path: string[]): void {
+        if (stack.has(node)) {
+          const cycleStart = path.indexOf(node);
+          if (cycleStart !== -1) {
+            cycles.push(path.slice(cycleStart));
+          }
+          return;
+        }
+
+        if (visited.has(node)) {
+          return;
+        }
+
+        const manifest = registry.get(node);
+        if (!manifest) {
+          visited.add(node);
+          return;
+        }
+
+        stack.add(node);
+        path.push(node);
+
+        for (const depName of Object.keys(manifest.dependencies)) {
+          dfs(depName, [...path]);
+        }
+
+        stack.delete(node);
+        visited.add(node);
+      }
+
+      dfs(name, []);
+
+      return cycles.length > 0 ? cycles : null;
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const result: string[] = [];
+      const visited = new Set<string>();
+      const inStack = new Set<string>();
+
+      function dfs(node: string): void {
+        if (inStack.has(node)) {
+          throw new Error(`Circular dependency detected involving ${node}`);
+        }
+        if (visited.has(node)) {
+          return;
+        }
+
+        const manifest = registry.get(node);
+        if (!manifest) {
+          visited.add(node);
+          result.push(node);
+          return;
+        }
+
+        inStack.add(node);
+
+        for (const depName of Object.keys(manifest.dependencies)) {
+          dfs(depName);
+        }
+
+        inStack.delete(node);
+        visited.add(node);
+        result.push(node);
+      }
+
+      dfs(name);
+      return result;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const deps = new Set<string>();
+      const visited = new Set<string>();
+
+      function collect(node: string): void {
+        if (visited.has(node)) {
+          return;
+        }
+        visited.add(node);
+
+        const manifest = registry.get(node);
+        if (!manifest) {
+          return;
+        }
+
+        for (const depName of Object.keys(manifest.dependencies)) {
+          deps.add(depName);
+          collect(depName);
+        }
+      }
+
+      collect(name);
+      return Array.from(deps);
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      const cycles = this.detectCycles(name, registry);
+      return cycles !== null && cycles.length > 0;
+    },
+  };
+}
