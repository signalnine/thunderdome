+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_q27_144_1","type":"tool_result","content":"1\timport { describe, it, expect } from 'vitest';\n2\timport { createResolver } from '../src/resolver/index.js';\n3\t\n4\tdescribe('Version Resolver', () => {\n5\t  const resolver = createResolver();\n6\t\n7\t  it('satisfies returns true for matching version', () => {\n8\t    expect(resolver.satisfies('1.2.3', '^1.0.0')).toBe(true);\n9\t  });\n10\t\n11\t  it('satisfies returns false for non-matching', () => {\n12\t    expect(resolver.satisfies('2.0.0', '^1.0.0')).toBe(false);\n13\t  });\n14\t\n15\t  it('resolve finds versions satisfying all constraints', () => {\n16\t    const constraints = [\n17\t      { name: 'foo', range: '^1.0.0' },\n18\t      { name: 'bar', range: '~2.1.0' },\n19\t    ];\n20\t    const available = {\n21\t      foo: ['1.0.0', '1.2.3', '2.0.0'],\n22\t      bar: ['2.0.0', '2.1.0', '2.1.5', '2.2.0'],\n23\t    };\n24\t    const result = resolver.resolve(constraints, available);\n25\t    expect(result).toHaveLength(2);\n26\t    expect(result[0].name).toBe('foo');\n27\t    expect(result[0].version).toBe('1.2.3');\n28\t    expect(result[1].name).toBe('bar');\n29\t    expect(result[1].version).toBe('2.1.5');\n30\t  });\n31\t\n32\t  it('resolve throws for unsatisfiable constraints', () => {\n33\t    const constraints = [{ name: 'foo', range: '^3.0.0' }];\n34\t    const available = { foo: ['1.0.0', '2.0.0'] };\n35\t    expect(() => resolver.resolve(constraints, available)).toThrow();\n36\t  });\n37\t\n38\t  it('maxSatisfying returns highest matching version', () => {\n39\t    const versions = ['1.0.0', '1.1.0', '1.2.0', '2.0.0'];\n40\t    expect(resolver.maxSatisfying(versions, '^1.0.0')).toBe('1.2.0');\n41\t  });\n42\t\n43\t  it('validRange returns true for valid ranges', () => {\n44\t    expect(resolver.validRange('^1.0.0')).toBe(true);\n45\t    expect(resolver.validRange('~2.3.0')).toBe(true);\n46\t    expect(resolver.validRange('>=1.0.0