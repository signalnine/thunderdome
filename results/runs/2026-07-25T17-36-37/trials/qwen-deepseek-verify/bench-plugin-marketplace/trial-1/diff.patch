+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+function createDb(): Database.Database {
+  const db = new Database(':memory:');
+  db.pragma('journal_mode = WAL');
+  db.exec(`
+    CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      plugin_name TEXT NOT NULL,
+      plugin_version TEXT NOT NULL,
+      user_id TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT NOT NULL DEFAULT '',
+      flagged INTEGER NOT NULL DEFAULT 0,
+      created_at TEXT NOT NULL
+    )
+  `);
+  return db;
+}
+
+function fromRow(row: Record<string, unknown>): Review {
+  return {
+    id: row.id as number,
+    pluginName: row.plugin_name as string,
+    pluginVersion: row.plugin_version as string,
+    userId: row.user_id as string,
+    rating: row.rating as number,
+    comment: row.comment as string,
+    flagged: row.flagged === 1,
+    createdAt: row.created_at as string,
+  };
+}
+
+export function createReviewSystem(): ReviewService {
+  const db = createDb();
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      const createdAt = new Date().toISOString();
+      db.prepare(`
+        INSERT INTO reviews (plugin_name, plugin_version, user_id, rating, comment, flagged, created_at)
+        VALUES (?, ?, ?, ?, ?, 0, ?)
+      `).run(review.pluginName, review.pluginVersion, review.userId, review.rating, review.comment, createdAt);
+
+      const row = db.prepare('SELECT * FROM reviews WHERE id = last_insert_rowid()').get();
+      return fromRow(row as Record<string, unknown>);
+    },
+
+    getReviews(pluginName: string): Review[] {
+      const rows = db.prepare('SELECT * FROM reviews WHERE plugin_name = ? ORDER BY created_at').all(pluginName);
+      return (rows as Record<string, unknown>[]).map(fromRow);
+    },
+
+    getAverageRating(pluginName: string): number {
+      const row = db.prepare(`
+        SELECT AVG(rating) as avg_rating FROM reviews
+        WHERE plugin_name = ? AND flagged = 0
+      `).get(pluginName);
+      const avg = (row as { avg_rating: number | null }).avg_rating;
+      return avg !== null ? Math.round(avg * 100) / 100 : 0;
+    },
+
+    flagReview(reviewId: number): void {
+      db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?').run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      const rows = db.prepare('SELECT * FROM reviews WHERE flagged = 1 ORDER BY created_at').all();
+      return (rows as Record<string, unknown>[]).map(fromRow);
+    },
+
+    removeReview(reviewId: number): boolean {
+      const result = db.prepare('DELETE FROM reviews WHERE id = ?').run(reviewId);
+      return result.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      const rows = db.prepare('SELECT * FROM reviews WHERE user_id = ? ORDER BY created_at').all(userId);
+      return (rows as Record<string, unknown>[]).map(fromRow);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = db.prepare('SELECT COUNT(*) as cnt FROM reviews WHERE plugin_name = ?').get(pluginName);
+      return (row as { cnt: number }).cnt;
+    },
+  };
+}
