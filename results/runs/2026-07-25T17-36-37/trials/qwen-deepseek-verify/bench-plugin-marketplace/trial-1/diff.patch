+import vm from 'vm';
+import type { SandboxResult, RunnerService } from '../types.js';
+
+function createContext(context?: Record<string, unknown>): vm.Context {
+  const ctx = context ? { ...context } : {};
+  return vm.createContext(ctx);
+}
+
+function wrapCode(code: string): string {
+  return `(function() { ${code} })()`;
+}
+
+function makeResult(success: boolean, output: unknown, duration: number, memoryUsed: number, error?: string): SandboxResult {
+  return { success, output, duration, memoryUsed, error };
+}
+
+export function createRunner(): RunnerService {
+  return {
+    async execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult> {
+      const start = Date.now();
+      const memBefore = process.memoryUsage().heapUsed;
+
+      try {
+        const ctx = createContext(context);
+        const wrapped = wrapCode(code);
+        const script = new vm.Script(wrapped);
+        const output = script.runInContext(ctx, { timeout: 5000 });
+        const duration = Date.now() - start;
+        const memAfter = process.memoryUsage().heapUsed;
+        return makeResult(true, output, duration, memAfter - memBefore);
+      } catch (err: unknown) {
+        const duration = Date.now() - start;
+        const memAfter = process.memoryUsage().heapUsed;
+        const message = err instanceof Error ? err.message : String(err);
+        return makeResult(false, undefined, duration, memAfter - memBefore, message);
+      }
+    },
+
+    async executeWithTimeout(code: string, timeoutMs: number, context?: Record<string, unknown>): Promise<SandboxResult> {
+      const start = Date.now();
+      const memBefore = process.memoryUsage().heapUsed;
+
+      try {
+        const ctx = createContext(context);
+        const wrapped = wrapCode(code);
+        const script = new vm.Script(wrapped);
+        const output = script.runInContext(ctx, { timeout: timeoutMs });
+        const duration = Date.now() - start;
+        const memAfter = process.memoryUsage().heapUsed;
+        return makeResult(true, output, duration, memAfter - memBefore);
+      } catch (err: unknown) {
+        const duration = Date.now() - start;
+        const memAfter = process.memoryUsage().heapUsed;
+        const message = err instanceof Error ? err.message : String(err);
+        return makeResult(false, undefined, duration, memAfter - memBefore, message);
+      }
+    },
+  };
+}
