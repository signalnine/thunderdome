foo: ['1.0.0', '1.2.3', '2.0.0'],\n      bar: ['2.0.0', '2.1.0', '2.1.5', '2.2.0'],\n    };\n    const result = resolver.resolve(constraints, available);\n    expect(result).toHaveLength(2);\n    expect(result[0].name).toBe('foo');\n    expect(result[0].version).toBe('1.2.3');\n    expect(result[1].name).toBe('bar');\n    expect(result[1].version).toBe('2.1.5');\n  });\n\n  it('resolve throws for unsatisfiable constraints', () => {\n    const constraints = [{ name: 'foo', range: '^3.0.0' }];\n    const available = { foo: ['1.0.0', '2.0.0'] };\n    expect(() => resolver.resolve(constraints, available)).toThrow();\n  });\n\n  it('maxSatisfying returns highest matching version', () => {\n    const versions = ['1.0.0', '1.1.0', '1.2.0', '2.0.0'];\n    expect(resolver.maxSatisfying(versions, '^1.0.0')).toBe('1.2.0');\n  });\n\n  it('validRange returns true for valid ranges', () => {\n    expect(resolver.validRange('^1.0.0')).toBe(true);\n    expect(resolver.validRange('~2.3.0')).toBe(true);\n    expect(resolver.validRange('>=1.0.0 <2.0.0')).toBe(true);\n  });\n\n  it('validRange returns false for invalid ranges', () => {\n    expect(resolver.validRange('not-a-range')).toBe(false);\n    expect(resolver.validRange('abc.def.ghi')).toBe(false);\n  });\n\n  it('resolve handles multiple plugins with dependencies', () => {\n    const constraints = [\n      { name: 'core', range: '^1.0.0' },\n      { name: 'utils', range: '^2.0.0' },\n      { name: 'logger', range: '>=1.5.0' },\n    ];\n    const available = {\n      core: ['1.0.0', '1.3.0', '2.0.0'],\n      utils: ['2.0.0', '2.1.0', '3.0.0'],\n      logger: ['1.0.0', '1.5.0', '1.9.0', '2.0.0'],\n    };\n    const result = resolver.resolve(constraints, available);\n    expect(result).toHaveLength(3);\n    expect(result.find(r => r.name === 'core')!.version).toBe('1.3.0');\n    expect(result.find(r => r.name === 'utils')!.version).toBe('2.1.0');\n    expect(result.find(r => r.name === 'logger')!.version).toBe('2.0.0');\n  });\n})