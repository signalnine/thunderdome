 Note[];\n      } else {\n        const stmt = db.prepare('SELECT * FROM notes ORDER BY created_at DESC');\n        notes = stmt.all() as Note[];\n      }\n\n      res.json({ notes });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search?q=<query> - Full-text search\n  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const q = req.query.q as string;\n      if (!q || q.trim() === '') {\n        throw new ValidationError('Search query parameter q is required');\n      }\n\n      const page = parseInt(req.query.page as string) || 1;\n      const perPage = 20;\n      const offset = (page - 1) * perPage;\n\n      // Escape special FTS5 characters except quotes for phrase search\n      const searchQuery = escapeFtsQuery(q);\n\n      // Get total count\n      const countStmt = db.prepare(`\n        SELECT COUNT(*) as total FROM notes_fts WHERE notes_fts MATCH ?\n      `);\n      const countRow = countStmt.get(searchQuery) as { total: number };\n      const total = countRow.total;\n\n      // Get ranked results with snippets\n      const searchStmt = db.prepare(`\n        SELECT notes.id, notes.title,\n               snippet(notes_fts, 0, '<mark>', '</mark>', '...', 10) as snippet,\n               rank\n        FROM notes_fts\n        JOIN notes ON notes.id = notes_fts.id\n        WHERE notes_fts MATCH ?\n        ORDER BY rank\n        LIMIT ? OFFSET ?\n      `);\n      const rows = searchStmt.all(searchQuery, perPage, offset);\n\n      const results: SearchResult[] = rows.map((row: any) => ({\n        id: row.id,\n        title: row.title,\n        snippet: row.snippet,\n        rank: row.rank,\n      }));\n\n      res.json({ results, total, page, perPage });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search/suggest?q=<prefix> - Autocomplete suggestions\n  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const q = req.query.q as string;\n      if (!q || q.trim() === '') {\n        throw new ValidationError('Suggest query parameter q is required');\n      }\n\n      const prefix = q.trim();\n\n      // Search for notes whose title or body starts with the prefix\n      const suggestStmt = db.prepare(`\n        SELECT DISTINCT notes.id, notes.title\n        FROM notes_fts\n        JOIN notes ON notes.id = notes_fts.id\n        WHERE notes_fts MATCH ?\n        ORDER BY rank\n        LIMIT 5\n      `);\n      const prefixQuery = `${prefix}*`;\n      const rows = suggestStmt.all(prefixQuery);\n\n      const results: SuggestResult[] = rows.map((row: any) => ({\n        id: row.id,\n        title: row.title,\n      }));\n\n      res.json({ results });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/:id - Get single note\n  router.get('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const stmt = db.prepare('SELECT * FROM notes WHERE id = ?');\n      const note = stmt.get(id) as Note | undefined;\n\n      if (!note) {\n        throw new NotFoundError('Note not found');\n      }\n\n      res.json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // POST /notes - Create note\n  router.post('/notes', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const input = req.body as NoteInput;\n\n      if (!input.title || input.title.trim() === '') {\n        throw new ValidationError('Title is required');\n      }\n      if (!input.body || input.body.trim() === '') {\n        throw new ValidationError('Body is required');\n      }\n\n      const tags = input.tags ? JSON.stringify(input.tags) : '[]';\n      const stmt = db.prepare(`\n        INSERT INTO notes (title, body, tags) VALUES (?, ?, ?)\n      `);\n      const result = stmt.run(input.title, input.body, tags);\n\n      const note = db.prepare('SELECT * FROM notes WHERE id = ?').get(result.lastInsertRowid) as Note;\n      res.status(201).json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // PUT /notes/:id - Update note\n  router.put('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      const input = req.body as Partial<NoteInput>;\n      const title = input.title ?? existing.title;\n      const body = input.body ?? existing.body;\n      const tags = input.tags ? JSON.stringify(input.tags) : existing.tags;\n\n      const stmt = db.prepare(`\n        UPDATE notes SET title = ?, body = ?, tags = ?, updated_at = datetime('now')\n        WHERE id = ?\n      `);\n      stmt.run(title, body, tags, id);\n\n      const note = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note;\n      res.json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // DELETE /notes/:id - Delete note\n  router.delete('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      db.prepare('DELETE FROM notes WHERE id = ?').run(id);\n      res.status(204).send();\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search?q=<query> - Full-text search\n  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const q = req.query.q as string;\n      if (!q || q.trim() === '') {\n        throw new ValidationError('Search query parameter q is required');\n      }\n\n      const page = parseInt(req.query.page as string) || 1;\n      const perPage = 20;\n      const offset = (page - 1) * perPage;\n\n      // Escape special FTS5 characters except quotes for phrase search\n      const searchQuery = escapeFtsQuery(q);\n\n      // Get total count\n      const countStmt = db.prepare(`\n        SELECT COUNT(*) as total FROM notes_fts WHERE notes_fts MATCH ?\n      `);\n      const countRow = countStmt.get(searchQuery) as { total: number };\n      const total = countRow.total;\n\n      // Get ranked results with snippets\n      const searchStmt = db.prepare(`\n        SELECT notes.id, notes.title,\n               snippet(notes_fts, 0, '<mark>', '</mark>', '...', 10) as snippet,\n               rank\n        FROM notes_fts\n        JOIN notes ON notes.id = notes_fts.id\n        WHERE notes_fts MATCH ?\n        ORDER BY rank\n        LIMIT ? OFFSET ?\n      `);\n      const rows = searchStmt.all(searchQuery, perPage, offset);\n\n      const results: SearchResult[] = rows.map((row: any) => ({\n        id: row.id,\n        title: row.title,\n        snippet: row.snippet,\n        rank: row.rank,\n      }));\n\n      res.json({ results, total, page, perPage });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search/suggest?q=<prefix> - Autocomplete suggestions\n  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const q = req.query.q as string;\n      if (!q || q.trim() === '') {\n        throw new ValidationError('Suggest query parameter q is required');\n      }\n\n      const prefix = q.trim();\n\n      // Search for notes whose title or body starts with the prefix\n      const suggestStmt = db.prepare(`\n        SELECT DISTINCT notes.id, notes.title\n        FROM notes_fts\n        JOIN notes ON notes.id = notes_fts.id\n        WHERE notes_fts MATCH ?\n        ORDER BY rank\n        LIMIT 5\n      `);\n      const prefixQuery = `${prefix}*`;\n      const rows = suggestStmt.all(prefixQuery);\n\n      const results: SuggestResult[] = rows.map((row: any) => ({\n        id: row.id,\n        title: row.title,\n      }));\n\n      res.json({ results });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  return router;\n}\n\nfunction escapeFtsQuery(query: string): string {\n  // Handle quoted phrases: keep them as-is\n  // Escape other FTS5 special characters\n  const result: string[] = [];\n  let i = 0;\n  while (i < query.length) {\n    if (query[i] === '\"') {\n      // Find the closing quote\n      let j = i + 1;\n      while (j < query.length && query[j] !== '\"') j++;\n      if (j < query.length) {\n        result.push(query.slice(i, j + 1));\n        i = j + 1;\n      } else {\n        // No closing quote, treat as literal\n        result.push('\"');\n        i++;\n      }\n    } else if ('-+~*()[]{}|'.includes(query[i])) {\n      // Escape special FTS5 operators\n      result.push('\\\\' + query[i]);\n      i++;\n    } else {\n      result.push(query[i]);\n      i++;\n    }\n  }\n  return result.join('');\n}\n","structuredPatch":[{"oldStart":199,"oldLines":87,"newStart":199,"newLines":6,"lines":["     }","   });"," ","-  // GET /notes/search?q=<query> - Full-text search","-  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {","-    try {","-      const q = req.query.q as string;","-      if (!q || q.trim() === '') {","-        throw new ValidationError('Search query parameter q is required');","-      }","-","-      const page = parseInt(req.query.page as string) || 1;","-      const perPage = 20;","-      const offset = (page - 1) * perPage;","-","-      // Escape special FTS5 characters except quotes for phrase search","-      const searchQuery = escapeFtsQuery(q);","-","-      // Get total count","-      const countStmt = db.prepare(`","-        SELECT COUNT(*) as total FROM notes_fts WHERE notes_fts MATCH ?","-      `);","-      const countRow = countStmt.get(searchQuery) as { total: number };","-      const total = countRow.total;","-","-      // Get ranked results wi