art, end);\n279\t      if (start > 0) snippet = '...' + snippet;\n280\t      if (end < body.length) snippet = snippet + '...';\n281\t      const regex = new RegExp(escapeRegex(term), 'gi');\n282\t      snippet = snippet.replace(regex, '<mark>$&</mark>');\n283\t      return snippet;\n284\t    }\n285\t  }\n286\t\n287\t  // Fallback: return a portion of the body\n288\t  const fallbackLen = 80;\n289\t  let snippet = body.slice(0, fallbackLen) + (body.length > fallbackLen ? '...' : '');\n290\t  for (const term of terms) {\n291\t    const regex = new RegExp(escapeRegex(term), 'gi');\n292\t    snippet = snippet.replace(regex, '<mark>$&</mark>');\n293\t  }\n294\t  return snippet;\n295\t}\n296\t\n297\tfunction extractSearchTerms(query: string): string[] {\n298\t  const terms: string[] = [];\n299\t  let i = 0;\n300\t  while (i < query.length) {\n301\t    if (query[i] === '\"') {\n302\t      let j = i + 1;\n303\t      while (j < query.length && query[j] !== '\"') j++;\n304\t      if (j < query.length) {\n305\t        terms.push(query.slice(i + 1, j));\n306\t        i = j + 1;\n307\t      } else {\n308\t        i++;\n309\t      }\n310\t    } else if (query[i] === ' ' || query[i] === '\\t') {\n311\t      i++;\n312\t    } else {\n313\t      let j = i;\n314\t      while (j < query.length && query[j] !== ' ' && query[j] !== '\\t' && query[j] !== '\"') j++;\n315\t      const word = query.slice(i, j);\n316\t      if (word.length > 0) {\n317\t        terms.push(word);\n318\t      }\n319\t      i = j;\n320\t    }\n321\t  }\n322\t  return terms;\n323\t}\n324\t\n325\tfunction escapeRegex(str: string): string {\n326\t  return str.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n327\t}\n328\t"}]},"parent_tool_use_id":null,"session_id":"59f9eebd-58f4-4d35-a29f-58b341732801","uuid":"e6931313-4c90-48d1-aac2-631f00640683","timestamp":"2026-07-25T17:57:00.050Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/routes.ts","content":"import { Router, Request, Response, NextFunction } from 'express';\nimport Database from 'better-sqlite3';\nimport { Note, NoteInput, SearchResult, SuggestResult } from './models.js';\nimport { NotFoundError, ValidationError } from './errors.js';\nimport { syncFts } from './db.js';\n\nexport function createRoutes(db: Database.Database): Router {\n  const router = Router();\n\n  // GET /notes - List all notes (with optional tag filter)\n  router.get('/notes', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const tag = req.query.tag as string | undefined;\n\n      let notes: Note[];\n      if (tag) {\n        const tagStmt = db.prepare(`\n          SELECT DISTINCT notes.* FROM notes, json_each(notes.tags)\n          WHERE json_each.value = ?\n          ORDER BY created_at DESC\n        `);\n        notes = tagStmt.all(tag) as Note[];\n      } else {\n        const stmt = db.prepare('SELECT * FROM notes ORDER BY created_at DESC');\n        notes = stmt.all() as Note[];\n      }\n\n      res.json({ notes });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search?q=<query> - Full-text search\n  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const q = req.query.q as string;\n      if (!q || q.trim() === '') {\n        throw new ValidationError('Search query parameter q is required');\n      }\n\n      const page = parseInt(req.query.page as string) || 1;\n      const perPage = 20;\n      const offset = (page - 1) * perPage;\n\n      const searchQuery = escapeFtsQuery(q);\n\n      let total = 0;\n      let results: SearchResult[] = [];\n\n      try {\n        // Get total count\n        const countStmt = db.prepare(`\n          SELECT COUNT(*) as total FROM notes_fts WHERE notes_fts MATCH ?\n        `);\n        const countRow = countStmt.get(searchQuery) as { total: number };\n        total = countRow.total;\n\n        // Get ranked results\n        const searchStmt = db.prepare(`\n          SELECT notes.id, notes.title, notes.body,\n                 rank\n          FROM notes_fts\n          JOIN notes ON notes.rowid = notes_fts.rowid\n          WHERE notes_fts MATCH ?\n          ORDER BY rank\n          LIMIT ? OFFSET ?\n        `);\n        const rows = searchStmt.all(searchQuery, perPage, offset);\n\n        results = rows.map((row: any) => {\n          const title = row.title;\n          const body = row.body;\n          const snippet = generateSnippet(title, body, q);\n          return {\n            id: row.id,\n            title: title,\n            snippet: snippet,\n            rank: row.rank,\n          };\n        });\n      } catch (searchErr) {\n        // If the query has invalid FTS5 syntax, return empty results\n        // rather than crashing\n        total = 0;\n        results = [];\n      }\n\n      res.json({ results, total, page, perPage });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search/suggest?q=<prefix> - Autocomplete suggestions\n  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const q = req.query.q as string;\n      if (!q || q.trim() === '') {\n        throw new ValidationError('Suggest query parameter q is required');\n      }\n\n      const prefix = q.trim();\n\n      const suggestStmt = db.prepare(`\n        SELECT DISTINCT notes.id, notes.title\n        FROM notes_fts\n        JOIN notes ON notes.rowid = notes_fts.rowid\n        WHERE notes_fts MATCH ?\n        ORDER BY rank\n        LIMIT 5\n      `);\n      const prefixQuery = `${prefix}*`;\n      const rows = suggestStmt.all(prefixQuery);\n\n      const results: SuggestResult[] = rows.map((row: any) => ({\n        id: row.id,\n        title: row.title,\n      }));\n\n      res.json({ results });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/:id - Get single note\n  router.get('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const stmt = db.prepare('SELECT * FROM notes WHERE id = ?');\n      const note = stmt.get(id) as Note | undefined;\n\n      if (!note) {\n        throw new NotFoundError('Note not found');\n      }\n\n      res.json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // POST /notes - Create note\n  router.post('/notes', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const input = req.body as NoteInput;\n\n      if (!input.title || input.title.trim() === '') {\n        throw new ValidationError('Title is required');\n      }\n      if (!input.body || input.body.trim() === '') {\n        throw new ValidationError('Body is required');\n      }\n\n      const tags = input.tags ? JSON.stringify(input.tags) : '[]';\n      const stmt = db.prepare(`\n        INSERT INTO notes (title, body, tags) VALUES (?, ?, ?)\n      `);\n      const result = stmt.run(input.title, input.body, tags);\n\n      // Sync FTS index\n      syncFts(db);\n\n      const note = db.prepare('SELECT * FROM notes WHERE id = ?').get(result.lastInsertRowid) as Note;\n      res.status(201).json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // PUT /notes/:id - Update note\n  router.put('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      const input = req.body as Partial<NoteInput>;\n      const title = input.title ?? existing.title;\n      const body = input.body ?? existing.body;\n      const tags = input.tags ? JSON.stringify(input.tags) : existing.tags;\n\n      const stmt = db.prepare(`\n        UPDATE notes SET title = ?, body = ?, tags = ?, updated_at = datetime('now')\n        WHERE id = ?\n      `);\n      stmt.run(title, body, tags, id);\n\n      // Sync FTS index\n      syncFts(db);\n\n      const note = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note;\n      res.json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // DELETE /notes/:id - Delete note\n  router.delete('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      db.prepare('DELETE FROM notes WHERE id = ?').run(id);\n\n      // Sync FTS index\n      syncFts(db);\n\n      res.status(204).send();\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  return router;\n}\n\nfunction escapeFtsQuery(query: string): string {\n  const result: string[] = [];\n  let i = 0;\n  while (i < query.length) {\n    if (query[i] === '\"') {\n      let j = i + 1;\n      while (j < query.length && query[j] !== '\"') j++;\n      if (j < query.length) {\n        result.push(query.slice(i, j + 1));\n        i = j + 1;\n      } else {\n        result.push('\"');\n        i++;\n      }\n    } else if ('-+~*()[]{}|&'.includes(query[i])) {\n      result.push('\\\\' + query[i]);\n      i++;\n    } else {\n      result.push(query[i]);\n      i++;\n    }\n  }\n  return result.join('');\n}\n\nfunction generateSnippet(title: string, body: string, query: string): string {\n  // Extract search terms from the query (handle quoted phrases)\n  const terms = extractSearchTerms(query);\n\n  // Try to find a match in the title first\n  for (const term of terms) {\n    const titleIdx = title.toLowerCase().indexOf(term.toLowerCase());\n    if (titleIdx >= 0) {\n      const start = Math.max(0, titleIdx - 20);\n      const end = Math.min(title.length, titleIdx + term.length + 20);\n      let snippet = title.slice(start, end);\n      if (start > 0) snippet = '...' + snippet;\n      if (end < title.length) snippet = snippet + '...';\n      // Highlight the term\n      const regex = new RegExp(escapeRegex(term), 'gi');\n      snippet = snippet.replace(regex, '<mark>$&</mark>');\n      return snippet;\n    }\n  }\n\n  // Try to find a match in the body\n  for (const term of terms) {\n    const bodyIdx = body.toLowerCase().indexOf(term.toLowerCase());\n    if (bodyIdx >= 0) {\n      const start = Math.max(0, bodyIdx - 30);\n      const end = Math.min(body.length, bodyIdx + term.length + 60);\n      let snippet = body.slice(start, end);\n      if (start > 0) snippet = '...' + snippet;\n      if (end < body.length) snippet = snippet + '...';\n      const regex = new RegExp(escapeRegex(term), 'gi');\n      snippet = snippet.replace(regex, '<mark>$&</mark>');\n      return snippet;\n    }\n  }\n\n  // Fallback: return a portion of the body\n  const fallbackLen = 80;\n  let snippet = body.slice(0, fallbackLen) + (body.length > fallbackLen ? '...' : '');\n  for (const term of terms) {\n    const regex = new RegExp(escapeRegex(term), 'gi');\n    snippet = snippet.replace(regex, '<mark>$&</mark>');\n  }\n  return snippet;\n}\n\nfunction extractSearchTerms(query: string): string[] {\n  const terms: string[] = [];\n  let i = 0;\n  while (i < query.length) {\n    if (query[i] === '\"') {\n      let j = i + 1;\n      while (j < query.length && query[j] !== '\"') j++;\n      if (j < query.length) {\n        terms.push(query.slice(i + 1, j));\n        i = j + 1;\n      } else {\n        i++;\n      }\n    } else if (query[i] === ' ' || query[i] === '\\t') {\n      i++;\n    } else {\n      let j = i;\n      while (j < query.length && query[j] !== ' ' && query[j] !== '\\t' && query[j] !== '\"') j++;\n      const word = query.slice(i, j);\n      if (word.length > 0) {\n        terms.push(word);\n      }\n      i = j;\n    }\n  }\n  return terms;\n}\n\nfunction escapeRegex(str: string): string {\n  return str.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n","numLines":328,"st