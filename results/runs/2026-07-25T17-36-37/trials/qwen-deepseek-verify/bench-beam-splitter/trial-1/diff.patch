+++ b/tests/beam-splitter.test.ts
@@ -0,0 +1,246 @@
+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index';
+
+describe('countBeamCells', () => {
+  it('counts visited cells with a single source and no splitters', () => {
+    const grid = [
+      ['S', '.', '.'],
+      ['.', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    // Beam goes: (0,0) -> (1,0) -> (2,0) -> exits
+    expect(countBeamCells(grid)).toBe(3);
+  });
+
+  it('counts visited cells with one splitter', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    // (0,1) -> (1,1) -> (2,1) splitter -> (3,0) and (3,2)
+    expect(countBeamCells(grid)).toBe(5);
+  });
+
+  it('counts visited cells with two splitters', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    // (0,1)->(1,1) splitter -> (2,0) splitter + (2,2) splitter
+    // (2,0) -> (3,-1) absorbed + (3,1)
+    // (2,2) -> (3,1) + (3,3)
+    // Visited: (0,1),(1,1),(2,0),(2,2),(3,1),(3,3) = 6
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('handles beam exiting from left edge', () => {
+    const grid = [
+      ['S', '.', '.'],
+      ['^', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    // (0,0)->(1,0) splitter -> (2,-1) absorbed + (2,1)
+    // Visited: (0,0),(1,0),(2,1) = 3
+    expect(countBeamCells(grid)).toBe(3);
+  });
+
+  it('handles beam exiting from right edge', () => {
+    const grid = [
+      ['.', '.', 'S'],
+      ['.', '.', '^'],
+      ['.', '.', '.'],
+    ];
+    // (0,2)->(1,2) splitter -> (2,1) + (2,3) absorbed
+    // Visited: (0,2),(1,2),(2,1) = 3
+    expect(countBeamCells(grid)).toBe(3);
+  });
+
+  it('handles multiple sources', () => {
+    const grid = [
+      ['S', '.', 'S'],
+      ['.', '.', '.'],
+      ['.', '^', '.'],
+      ['.', '.', '.'],
+    ];
+    // Source at (0,0): (0,0)->(1,0)->(2,0)->(3,0) = 4 cells
+    // Source at (0,2): (0,2)->(1,2)->(2,2)->(3,2) = 4 cells
+    // No splitter hit by either beam
+    expect(countBeamCells(grid)).toBe(8);
+  });
+
+  it('handles splitter on top row hit by diagonal beam', () => {
+    const grid = [
+      ['.', 'S', '.', '.'],
+      ['.', '.', '.', '.'],
+      ['^', '.', '^', '.'],
+      ['.', '.', '.', '.'],
+    ];
+    // (0,1)->(1,1)->(2,1) not a splitter -> (3,1)
+    // No splitters hit
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('handles cascading splitters', () => {
+    const grid = [
+      ['.', 'S', '.', '.'],
+      ['.', '^', '.', '.'],
+      ['^', '.', '^', '.'],
+      ['.', '.', '.', '.'],
+    ];
+    // (0,1)->(1,1) splitter -> (2,0) splitter + (2,2) splitter
+    // (2,0) splitter -> (3,-1) absorbed + (3,1)
+    // (2,2) splitter -> (3,1) + (3,3)
+    // Visited: (0,1),(1,1),(2,0),(2,2),(3,1),(3,3) = 6
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('handles empty grid', () => {
+    const grid: string[][] = [];
+    expect(countBeamCells(grid)).toBe(0);
+  });
+
+  it('handles single cell with source', () => {
+    const grid = [['S']];
+    // Source at (0,0), beam exits immediately
+    expect(countBeamCells(grid)).toBe(1);
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('counts paths with no splitters', () => {
+    const grid = [
+      ['S', '.', '.'],
+      ['.', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    // One beam, one path
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('counts paths with one splitter', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    // One split = 2 paths
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('counts paths with two splitters', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    // 2 splits = 4 paths
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('counts paths with cascading splitters', () => {
+    const grid = [
+      ['.', 'S', '.', '.'],
+      ['.', '^', '.', '.'],
+      ['^', '.', '^', '.'],
+      ['.', '.', '.', '.'],
+    ];
+    // (0,1)->(1,1) split -> (2,0) split + (2,2) split
+    // (2,0) split -> (3,-1) + (3,1) = 2 paths
+    // (2,2) split -> (3,1) + (3,3) = 2 paths
+    // Total: 4 paths
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('counts paths with multiple sources', () => {
+    const grid = [
+      ['S', '.', 'S'],
+      ['.', '.', '.'],
+      ['.', '^', '.'],
+      ['.', '.', '.'],
+    ];
+    // Source (0,0): goes down, no splitter hit -> 1 path
+    // Source (0,2): goes down, no splitter hit -> 1 path
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('counts paths with source hitting splitter directly', () => {
+    const grid = [
+      ['S', '.', '.'],
+      ['^', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    // (0,0)->(1,0) splitter -> (2,-1) + (2,1) = 2 paths
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('handles single cell with source', () => {
+    const grid = [['S']];
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('handles empty grid', () => {
+    const grid: string[][] = [];
+    expect(countBeamPaths(grid)).toBe(0n);
+  });
+
+  it('handles large number of splitters (performance)', () => {
+    // Build a grid where beams from a source hit many splitters.
+    // Layout: source at (0,1). Splitters form a diamond pattern.
+    // Row 1: splitter at col 1
+    // Row 2: splitters at col 0 and col 2
+    // Row 3: splitter at col 1 (hit by both branches)
+    //
+    // With 3 splitters:
+    // (0,1)->(1,1) split -> (2,0) split + (2,2) split
+    // (2,0) split -> (3,-1) exit + (3,1) split
+    // (2,2) split -> (3,1) split + (3,3) exit
+    // (3,1) split -> (4,0) exit + (4,2) exit
+    // Paths: 6 (not 8, because (3,1) is hit by both branches and paths merge)
+    const grid3: string[][] = [
+      ['.', 'S', '.', '.'],
+      ['.', '^', '.', '.'],
+      ['^', '.', '^', '.'],
+      ['.', '^', '.', '.'],
+      ['.', '.', '.', '.'],
+    ];
+    expect(countBeamPaths(grid3)).toBe(6n);
+
+    // For a larger test, build a grid with splitters on every other row
+    // in a widening pattern. Source at (0,0). Splitters at:
+    // (1,0), (2,0),(2,1), (3,0),(3,1),(3,2), (4,0)..(4,3), ...
+    // This creates a triangular arrangement where beams fan out
+    // and hit many splitters.
+    const numSplitters = 50;
+    const rows = numSplitters + 2;
+    const cols = numSplitters + 2;
+    const grid: string[][] = Array.from({ length: rows }, () =>
+      Array(cols).fill('.')
+    );
+    grid[0][0] = 'S';
+
+    // Place splitters: row k (k>=1) has splitters at cols 0..k-1
+    // This forms a triangle. A beam going down from (0,0) hits (1,0),
+    // splits to (2,-1) exit and (2,1). (2,1) is a splitter.
+    // From (2,1): (3,0) splitter and (3,2) splitter.
+    // This creates exponential growth.
+    for (let r = 1; r <= numSplitters; r++) {
+      for (let c = 0; c < r; c++) {
+        grid[r][c] = '^';
+      }
+    }
+
+    // Verify it runs fast (under 5 seconds for 200x200 with 50 splitters)
+    const start = Date.now();
+    const result = countBeamPaths(grid);
+    const elapsed = Date.now() - start;
+    expect(elapsed).toBeLessThan(5000);
+    // The result should be a large bigint (many paths)
+    expect(result).toBeGreaterThan(0n);
+  });
+});
