@@ -0,0 +1,179 @@
+/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ *
+ * Grid characters:
+ *   'S' — beam source (emits straight down)
+ *   '^' — splitter (splits beam into down-left and down-right)
+ *   '.' — empty cell (beam passes through)
+ */
+
+/** Direction: [rowDelta, colDelta] */
+type Direction = [number, number];
+
+const DOWN: Direction = [1, 0];
+const DOWN_LEFT: Direction = [1, -1];
+const DOWN_RIGHT: Direction = [1, 1];
+
+/**
+ * A beam state: position + direction.
+ */
+interface Beam {
+  row: number;
+  col: number;
+  dir: Direction;
+}
+
+/**
+ * Count the number of distinct cells visited by any beam.
+ * The source cell counts as visited. Splitter cells hit by beams count as visited.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+
+  const visited = new Set<string>();
+
+  // Find all sources and launch beams
+  const beams: Beam[] = [];
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') {
+      visited.add(`0,${c}`);
+      beams.push({ row: 0, col: c, dir: DOWN });
+    }
+  }
+
+  // BFS: process beams step by step
+  const queue = [...beams];
+
+  while (queue.length > 0) {
+    const beam = queue.shift()!;
+
+    // Move one step
+    const newRow = beam.row + beam.dir[0];
+    const newCol = beam.col + beam.dir[1];
+
+    // Check if out of bounds (absorbed)
+    if (newRow < 0 || newRow >= rows || newCol < 0 || newCol >= cols) {
+      continue;
+    }
+
+    // Mark cell as visited
+    visited.add(`${newRow},${newCol}`);
+
+    const cell = grid[newRow][newCol];
+
+    if (cell === '^') {
+      // Splitter: split into two diagonal beams
+      queue.push({ row: newRow, col: newCol, dir: DOWN_LEFT });
+      queue.push({ row: newRow, col: newCol, dir: DOWN_RIGHT });
+    } else {
+      // Continue in current direction
+      queue.push({ row: newRow, col: newCol, dir: beam.dir });
+    }
+  }
+
+  return visited.size;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths through the grid.
+ * Each split at a splitter creates two separate paths.
+ * Uses dynamic programming to avoid exponential enumeration.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+
+  // dp[row][col] = total number of paths arriving at (row, col)
+  // A path arriving at a splitter doubles (splits into 2).
+  // A path arriving at a non-splitter continues with the same count.
+  // When a path exits the grid, it contributes its count to the total.
+
+  // We process row by row. At each cell, we track the number of paths
+  // arriving there from above (downward) and from diagonals.
+
+  // For each cell, we need to know how many paths arrive from each direction.
+  // But since all beams only move downward (row always increases),
+  // we can process top to bottom.
+
+  // dp[row][col] = total paths that pass through (row, col)
+  // When a beam reaches a splitter, it splits: the paths arriving there
+  // each produce 2 outgoing paths.
+
+  // Approach: process row by row. For each cell, compute how many paths
+  // arrive there. If it's a splitter, those paths each split into 2.
+
+  // Let's think about it differently:
+  // - A path is a sequence of cells from source to exit.
+  // - At a splitter, one path becomes two.
+  // - We want to count total paths that exit the grid.
+
+  // dp[row][col] = number of paths that arrive at cell (row, col)
+  // For a source: dp = 1 (one path starts here)
+  // For a non-splitter: paths continue with same count
+  // For a splitter: paths arriving here each split into 2
+
+  // Process top to bottom. For each cell, accumulate paths from predecessors.
+
+  const dp: bigint[][] = Array.from({ length: rows }, () =>
+    Array(cols).fill(0n)
+  );
+
+  // Initialize sources
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') {
+      dp[0][c] = 1n;
+    }
+  }
+
+  let totalPaths = 0n;
+
+  // Process each row
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      const pathsHere = dp[r][c];
+      if (pathsHere === 0n) continue;
+
+      const cell = grid[r][c];
+
+      if (cell === '^') {
+        // Splitter: each path arriving here splits into two paths:
+        //   - one goes down-left (pathsHere paths)
+        //   - one goes down-right (pathsHere paths)
+        // Total outgoing: 2 * pathsHere, but each direction gets pathsHere.
+
+        // Down-left
+        const dlRow = r + 1;
+        const dlCol = c - 1;
+        if (dlRow < rows && dlCol >= 0 && dlCol < cols) {
+          dp[dlRow][dlCol] += pathsHere;
+        } else {
+          totalPaths += pathsHere;
+        }
+
+        // Down-right
+        const drRow = r + 1;
+        const drCol = c + 1;
+        if (drRow < rows && drCol >= 0 && drCol < cols) {
+          dp[drRow][drCol] += pathsHere;
+        } else {
+          totalPaths += pathsHere;
+        }
+      } else {
+        // Non-splitter: paths continue downward
+        const nextRow = r + 1;
+        const nextCol = c;
+        if (nextRow < rows && nextCol >= 0 && nextCol < cols) {
+          dp[nextRow][nextCol] += pathsHere;
+        } else {
+          // Exits grid
+          totalPaths += pathsHere;
+        }
+      }
+    }
+  }
+
+  return totalPaths;
+}
