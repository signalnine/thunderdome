+// ============================================================
+// Server — Express + WebSocket on the same port
+// ============================================================
+
+import express from 'express';
+import { createServer, type Server as HttpServer } from 'http';
+import { createDb, clearActiveConnections } from './db.js';
+import { createRoutes } from './routes.js';
+import { createWsServer } from './ws.js';
+import type { AppInstance } from './models.js';
+
+export function createApp(dbPath?: string): AppInstance {
+  const db = createDb(dbPath);
+  clearActiveConnections(db);
+
+  const app = express();
+  app.use(express.json());
+
+  const server: HttpServer = createServer(app);
+  const wss = createWsServer(server, db);
+
+  app.use('/', createRoutes(db));
+
+  const start = async (port?: number): Promise<number> => {
+    return new Promise((resolve) => {
+      server.listen(port ?? 0, () => {
+        const addr = server.address();
+        if (addr && typeof addr === 'object') {
+          resolve(addr.port);
+        } else {
+          resolve(0);
+        }
+      });
+    });
+  };
+
+  const stop = async (): Promise<void> => {
+    return new Promise((resolve) => {
+      // Close all WebSocket connections first
+      for (const client of wss.clients) {
+        client.close();
+      }
+      // Close the WebSocket server
+      wss.close(() => {
+        // Close the HTTP server
+        server.close(() => {
+          db.close();
+          resolve();
+        });
+      });
+    });
+  };
+
+  return { app, server, wss, db, start, stop };
+}
