+// ============================================================
+// Operational Transform
+// ============================================================
+
+import type { Operation, InsertOperation, DeleteOperation } from './models.js';
+
+/**
+ * Apply an operation to document content, returning the new content.
+ */
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    const ins = op as InsertOperation;
+    return content.slice(0, ins.position) + ins.text + content.slice(ins.position);
+  } else {
+    const del = op as DeleteOperation;
+    return content.slice(0, del.position) + content.slice(del.position + del.count);
+  }
+}
+
+/**
+ * Validate that an operation is within bounds of the current content.
+ */
+export function validateOperation(op: Operation, contentLength: number): boolean {
+  if (op.type === 'insert') {
+    const ins = op as InsertOperation;
+    return ins.position >= 0 && ins.position <= contentLength;
+  } else {
+    const del = op as DeleteOperation;
+    return del.position >= 0 && del.position + del.count <= contentLength;
+  }
+}
+
+/**
+ * Transform op1 against op2.
+ * op1 is the newer operation; op2 is the one that was already applied.
+ * Returns a new op1 that accounts for the effect of op2.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    const i1 = op1 as InsertOperation;
+    const i2 = op2 as InsertOperation;
+    // If op2 inserted before or at op1's position, shift op1's position
+    if (i2.position <= i1.position) {
+      return {
+        type: 'insert',
+        position: i1.position + i2.text.length,
+        text: i1.text,
+      };
+    }
+    return { ...op1 };
+  }
+
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    const i1 = op1 as InsertOperation;
+    const d2 = op2 as DeleteOperation;
+    if (d2.position <= i1.position) {
+      const shift = Math.min(i1.position - d2.position, d2.count);
+      return {
+        type: 'insert',
+        position: i1.position - shift,
+        text: i1.text,
+      };
+    }
+    return { ...op1 };
+  }
+
+  if (op1.type === 'delete' && op2.type === 'insert') {
+    const d1 = op1 as DeleteOperation;
+    const i2 = op2 as InsertOperation;
+    if (i2.position <= d1.position) {
+      return {
+        type: 'delete',
+        position: d1.position + i2.text.length,
+        count: d1.count,
+      };
+    }
+    return { ...op1 };
+  }
+
+  if (op1.type === 'delete' && op2.type === 'delete') {
+    const d1 = op1 as DeleteOperation;
+    const d2 = op2 as DeleteOperation;
+    if (d2.position + d2.count <= d1.position) {
+      // op2 deletes entirely before op1's range
+      return {
+        type: 'delete',
+        position: d1.position - d2.count,
+        count: d1.count,
+      };
+    }
+    if (d2.position >= d1.position + d1.count) {
+      // op2 deletes entirely after op1's range
+      return { ...op1 };
+    }
+    // Overlapping deletes
+    const overlapStart = Math.max(d1.position, d2.position);
+    const overlapEnd = Math.min(d1.position + d1.count, d2.position + d2.count);
+    const overlap = Math.max(0, overlapEnd - overlapStart);
+
+    if (d2.position <= d1.position) {
+      // op2 starts before or at op1
+      const beforeOverlap = Math.max(0, d2.count - (d1.position + d1.count - d2.position));
+      return {
+        type: 'delete',
+        position: d1.position - beforeOverlap,
+        count: d1.count - overlap,
+      };
+    } else {
+      // op2 starts inside op1's range
+      const beforeOverlap = d2.position - d1.position;
+      return {
+        type: 'delete',
+        position: d1.position,
+        count: beforeOverlap + Math.max(0, d2.count - (d1.position + d1.count - d2.position)),
+      };
+    }
+  }
+
+  return { ...op1 };
+}
+
