+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_5vsZQR7qqxlG3ncgM7xI4120","type":"tool_result","content":"1\t// ============================================================\n2\t// Database\n3\t// ============================================================\n4\t\n5\timport Database from 'better-sqlite3';\n6\timport { readFileSync } from 'fs';\n7\timport { resolve } from 'path';\n8\t\n9\texport function createDb(dbPath?: string): Database.Database {\n10\t  const db = new Database(dbPath || ':memory:');\n11\t  db.pragma('journal_mode = WAL');\n12\t  db.pragma('foreign_keys = ON');\n13\t\n14\t  const schema = readFileSync(resolve(__dirname, '..', 'schema.sql'), 'utf-8');\n15\t  db.exec(schema);\n16\t\n17\t  return db;\n18\t}\n19\t\n20\texport function initDocument(db: Database.Database, id: string, title: string, content: string): void {\n21\t  const now = new Date().toISOString();\n22\t  db.prepare(\n23\t    `INSERT INTO documents (id, title, content, created_at, updated_at) VALUES (?, ?, ?, ?, ?)`\n24\t  ).run(id, title, content, now, now);\n25\t\n26\t  db.prepare(\n27\t    `INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)`\n28\t  ).run(id, content);\n29\t}\n30\t\n31\texport function saveVersion(db: Database.Database, documentId: string, version: number, content: string, operationJson: string): void {\n32\t  db.prepare(\n33\t    `INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)`\n34\t  ).run(documentId, version, content, operationJson);\n35\t}\n36\t\n37\texport function updateDocumentContent(db: Database.Database, id: string, content: string): void {\n38\t  const now = new Date().toISOString();\n39\t  db.prepare(\n40\t    `UPDATE documents SET content = ?, updated_at = ? WHERE id = ?`\n41\t  ).run(content, now, id);\n42\t}\n43\t\n44\texport function getDocumentVersion(db: Database.Database, id: string): number {\n45\t  const row = db.prepare(\n46\t    `SELECT MAX(version) as maxVersion FROM versions WHERE document_id = ?`\n47\t  ).get(id) as { maxVersion: number | null };\n48\t  return row.maxVersion ?? 0;\n49\t}\n50\t\n51\texport function clearActiveConnections(db: Database.Database): void {\n52\t  db.prepare(`DELETE FROM active_connections`).run();\n53\t}\n54\t\n55\texport function addActiveConnection(db: Database.Database, id: string, documentId: string): void {\n56\t  const now = new Date().toISOString();\n57\t  db.prepare(\n58\t    `INSERT INTO active_connections (id, document_id, connected_at) VALUES (?, ?, ?)`\n59\t  ).run(id, documentId, now);\n60\t}\n61\t\n62\texport function removeActiveConnection(db: Database.Database, id: string): void {\n63\t  db.prepare(`DELETE FROM active_connections WHERE id = ?`).run(id);\n64\t}\n65\t\n66\t"}]},"parent_tool_use_id":null,"session_id":"9bd710e3-74a5-48f5-a868-8c46239118d5","uuid":"27a5161d-1225-4218-9d60-9591f51a68f0","timestamp":"2026-07-25T17:48:49.322Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/db.ts","content":"// ============================================================\n// Database\n// ============================================================\n\nimport Database from 'better-sqlite3';\nimport { readFileSync } from 'fs';\nimport { resolve } from 'path';\n\nexport function createDb(dbPath?: string): Database.Database {\n  const db = new Database(dbPath || ':memory:');\n  db.pragma('journal_mode = WAL');\n  db.pragma('foreign_keys = ON');\n\n  const schema = readFileSync(resolve(__dirname, '..', 'schema.sql'), 'utf-8');\n  db.exec(schema);\n\n  return db;\n}\n\nexport function initDocument(db: Database.Database, id: string, title: string, content: string): void {\n  const now = new Date().toISOString();\n  db.prepare(\n    `INSERT INTO documents (id, title, content, created_at, updated_at) VALUES (?, ?, ?, ?, ?)`\n  ).run(id, title, content, now, now);\n\n  db.prepare(\n    `INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)`\n  ).run(id, content);\n}\n\nexport function saveVersion(db: Database.Database, documentId: string, version: number, content: string, operationJson: string): void {\n  db.prepare(\n    `INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)`\n  ).run(documentId, version, content, operationJson);\n}\n\nexport function updateDocumentContent(db: Database.Database, id: string, content: string): void {\n  const now = new Date().toISOString();\n  db.prepare(\n    `UPDATE documents SET content = ?, updated_at = ? WHERE id = ?`\n  ).run(content, now, id);\n}\n\nexport function getDocumentVersion(db: Database.Database, id: string): number {\n  const row = db.prepare(\n    `SELECT MAX(version) as maxVersion FROM versions WHERE document_id = ?`\n  ).get(id) as { maxVersion: number | null };\n  return row.maxVersion ?? 0;\n}\n\nexport function clearActiveConnections(db: Database.Database): void {\n  db.prepare(`DELETE FROM active_connections`).run();\n}\n\nexport function addActiveConnection(db: Database.Database, id: string, documentId: string): void {\n  const now = new Date().toISOString();\n  db.prepare(\n    `INSERT INTO active_connections (id, document_id, connected_at) VALUES (?, ?, ?)`\n  ).run(id, documentId, now);\n}\n\nexport function removeActiveConnection(db: Database.Database, id: string): void {\n  db.prepare(`DELETE FROM active_connections WHERE id = ?`).run(id);\n}\n\n","numLines":66,"startLine":1,"totalLines":66}}}
