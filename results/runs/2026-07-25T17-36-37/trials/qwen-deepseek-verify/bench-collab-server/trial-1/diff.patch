+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_fuN8mfoChJlg947MCWbU4683","type":"tool_result","content":"1\timport { describe, it, expect, beforeAll, afterAll } from 'vitest';\n2\timport request from 'supertest';\n3\timport WebSocket from 'ws';\n4\timport { createApp, type AppInstance } from '../src/server.js';\n5\t\n6\t// ============================================================\n7\t// Test Helpers\n8\t// ============================================================\n9\t\n10\tinterface WsClient {\n11\t  ws: WebSocket;\n12\t  messages: Record<string, unknown>[];\n13\t}\n14\t\n15\tfunction createWsClient(port: number, docId: string): Promise<WsClient> {\n16\t  return new Promise((resolve, reject) => {\n17\t    const ws = new WebSocket(`ws://localhost:${port}/${docId}`);\n18\t    const messages: Record<string, unknown>[] = [];\n19\t    ws.on('message', (data) => {\n20\t      messages.push(JSON.parse(data.toString()));\n21\t    });\n22\t    ws.on('open', () => resolve({ ws, messages }));\n23\t    ws.on('error', reject);\n24\t  });\n25\t}\n26\t\n27\t/** Wait for the messages array to have at least `idx + 1` entries, then return messages[idx]. */\n28\tfunction waitForMsg(client: WsClient, idx: number, timeout = 3000): Promise<Record<string, unknown>> {\n29\t  return new Promise((resolve, reject) => {\n30\t    if (client.messages.length > idx) {\n31\t      resolve(client.messages[idx]);\n32\t      return;\n33\t    }\n34\t    const timer = setTimeout(\n35\t      () => reject(new Error(`Timed out waiting for message at index ${idx} (have ${client.messages.length})`)),\n36\t      timeout\n37\t    );\n38\t    const interval = setInterval(() => {\n39\t      if (client.messages.length > idx) {\n40\t        clearTimeout(timer);\n41\t        clearInterval(interval);\n42\t        resolve(client.messages[idx]);\n43\t      }\n44\t    }, 5);\n45\t  });\n46\t}\n47\t\n48\t\n49\tfunction delay(ms: number): Promise<void> {\n50\t  return new Promise((resolve) => setTimeout(resolve, ms));\n51\t}\n52\t\n53\tfunction sendOp(client: WsClient, operation: Record<string, unknown>, version?: number) {\n54\t  const msg: Record<string, unknown> = { type: 'operation', operation };\n55\t  if (version !== undefined) msg.version = version;\n56\t  client.ws.send(JSON.stringify(msg));\n57\t}\n58\t\n59\tfunction closeClient(client: WsClient): Promise<void> {\n60\t  return new Promise((resolve) => {\n61\t    if (client.ws.readyState === WebSocket.CLOSED || client.ws.readyState === WebSocket.CLOSING) {\n62\t      resolve();\n63\t      return;\n64\t    }\n65\t    client.ws.on('close', () => resolve());\n66\t    client.ws.close();\n67\t  });\n68\t}\n69\t\n70\t// ============================================================\n71\t// REST CRUD Tests\n72\t// ============================================================\n73\t\n74\tdescribe('REST CRUD', () => {\n75\t  let app: AppInstance;\n76\t\n77\t  beforeAll(async () => {\n78\t    app = createApp();\n79\t    await app.start(0);\n80\t  });\n81\t\n82\t  afterAll(async () => {\n83\t    await app.stop();\n84\t  });\n85\t\n86\t  it('POST /docs creates document with title', async () => {\n87\t    const res = await request(app.app).post('/docs').send({ title: 'Test Doc' });\n88\t    expect(res.status).toBe(201);\n89\t    expect(res.body.title).toBe('Test Doc');\n90\t  });\n91\t\n92\t  it('POST /docs returns id, title, content, timestamps', async () => {\n93\t    const res = await request(app.app).post('/docs').send({ title: 'Full Doc' });\n94\t    expect(res.body).toHaveProperty('id');\n95\t    expect(res.body).toHaveProperty('title');\n96\t    expect(res.body).toHaveProperty('content');\n97\t    expect(res.body).toHaveProperty('created_at');\n98\t    expect(res.body).toHaveProperty('updated_at');\n99\t  });\n100\t\n101\t  it('GET /docs lists all documents', async () => {\n102\t    const res = await request(app.app).get('/docs');\n103\t    expect(res.status).toBe(200);\n104\t    expect(Array.isArray(res.body)).toBe(true);\n105\t    expect(res.body.length).toBeGreaterThanOrEqual(2);\n106\t  });\n107\t\n108\t  it('GET /docs/:id returns specific document', async () => {\n109\t    const created = await request(app.app).post('/docs').send({ title: 'Specific' });\n110\t    const res = await request(app.app).get(`/docs/${created.body.id}`);\n111\t    expect(res.status).toBe(200);\n112\t    expect(res.body.title).toBe('Specific');\n113\t  });\n114\t\n115\t  it('GET /docs/:id returns 404 for non-existent', async () => {\n116\t    const res = await request(app.app).get('/docs/nonexistent-id');\n117\t    expect(res.status).toBe(404);\n118\t  });\n119\t\n120\t  it('PUT /docs/:id updates title', async () => {\n121\t    const created = await request(app.app).post('/docs').send({ title: 'Old Title' });\n122\t    const res = await request(app.app).put(`/docs/${created.body.id}`).send({ title: 'New Title' });\n123\t    expect(res.status).toBe(200);\n124\t    expect(res.body.title).toBe('New Title');\n125\t  });\n126\t\n127\t  it('DELETE /docs/:id removes document', async () => {\n128\t    const created = await request(app.app).post('/docs').send({ title: 'To Delete' });\n129\t    const res = await request(app.app).delete(`/docs/${created.body.id}`);\n130\t    expect(res.status).toBe(204);\n131\t    const check = await request(app.app).get(`/docs/${created.body.id}`);\n132\t    expect(check.status).toBe(404);\n133\t  });\n134\t\n135\t  it('DELETE /docs/:id returns 404 for non-existent', async () => {\n136\t    const res = await request(app.app).delete('/docs/nonexistent-id');\n137\t    expect(res.status).toBe(404);\n138\t  });\n139\t\n140\t  it('GET /docs/:id/versions lists version history', async () => {\n141\t    const created = await request(app.app).post('/docs').send({ title: 'Versioned' });\n142\t    const res = await request(app.app).get(`/docs/${created.body.id}/versions`);\n143\t    expect(res.status).toBe(200);\n144\t    expect(Array.isArray(res.body)).toBe(true);\n145\t    expect(res.body.length).toBeGreaterThanOrEqual(1);\n146\t    expect(res.body[0].version).toBe(0);\n147\t  });\n148\t\n149\t  it('GET /docs/:id/versions/:version returns specific version content', async () => {\n150\t    const created = await request(app.app).post('/docs').send({ title: 'Versioned2' });\n151\t    const res = await request(app.app).get(`/docs/${created.body.id}/versions/0`);\n152\t    expect(res.status).toBe(200);\n153\t    expect(res.body).toHaveProperty('content');\n154\t    expect(res.body.version).toBe(0);\n155\t  });\n156\t});\n157\t\n158\t// ============================================================\n159\t// WebSocket Lifecycle Tests\n160\t// ============================================================\n161\t\n162\tdescribe('WebSocket Lifecycle', () => {\n163\t  let app: AppInstance;\n164\t  let port: number;\n165\t  let docId: string;\n166\t\n167\t  beforeAll(async () => {\n168\t    app = createApp();\n169\t    port = await app.start(0);\n170\t    const res = await request(app.app).post('/docs').send({ title: 'WS Doc' });\n171\t    docId = res.body.id;\n172\t  });\n173\t\n174\t  afterAll(async () => {\n175\t    await app.stop();\n176\t  });\n177\t\n178\t  it('Client connects to ws://.../:docId', async () => {\n179\t    const client = await createWsClient(port, docId);\n180\t    expect(client.ws.readyState).toBe(WebSocket.OPEN);\n181\t    await waitForMsg(client, 0);\n182\t    await closeClient(client);\n183\t  });\n184\t\n185\t  it('Client receives current document content on connect', async () => {\n186\t    const client = await createWsClient(port, docId);\n187\t    const msg = await waitForMsg(client, 0);\n188\t    expect(msg.type).toBe('sync');\n189\t    expect(msg).toHaveProperty('content');\n190\t    expect(msg).toHaveProperty('version');\n191\t    await closeClient(client);\n192\t  });\n193\t\n194\t  it('Client sends edit operation and receives acknowledgment', async () => {\n195\t    const client = await createWsClient(port, docId);\n196\t    await waitForMsg(client, 0); // sync\n197\t    sendOp(client, { type: 'insert', position: 0, text: 'Hello' });\n198\t    const ack = await waitForMsg(client, 1);\n199\t    expect(ack.type).toBe('ack');\n200\t    expect(ack).toHaveProperty('version');\n201\t    await closeClient(client);\n202\t  });\n203\t\n204\t  it('Server broadcasts operation to other clients in same document', async () => {\n205\t    const c1 = await createWsClient(port, docId);\n206\t    await waitForMsg(c1, 0); // sync\n207\t    const c2 = await createWsClient(port, docId);\n208\t    await waitForMsg(c2, 0); // sync\n209\t\n210\t    sendOp(c1, { type: 'insert', position: 0, text: 'Broadcast' });\n211\t    await waitForMsg(c1, 1); // ack for c1\n212\t\n213\t    const broadcast = await waitForMsg(c2, 1); // broadcast for c2\n214\t    expect(broadcast.type).toBe('operation');\n215\t    expect(broadcast).toHaveProperty('operation');\n216\t\n217\t    await closeClient(c1);\n218\t    await closeClient(c2);\n219\t  });\n220\t\n221\t  it('Client does not receive own operations back as broadcast', async () => {\n222\t    const client = await createWsClient(port, docId);\n223\t    await waitForMsg(client, 0); // sync\n224\t\n225\t    sendOp(client, { type: 'insert', position: 0, text: 'Self' });\n226\t    const msg = await waitForMsg(client, 1);\n227\t    // Should get ack, not operation broadcast\n228\t    expect(msg.type).toBe('ack');\n229\t\n230\t    await closeClient(client);\n231\t  });\n232\t\n233\t  it('Client disconnects cleanly', async () => {\n234\t    const client = await createWsClient(port, docId);\n235\t    await waitForMsg(client, 0); // sync\n236\t    await closeClient(client);\n237\t    expect(client.ws.readyState).toBe(WebSocket.CLOSED);\n238\t  });\n239\t\n240\t  it('Multiple clients can join same document', async () => {\n241\t    const clients: WsClient[] = [];\n242\t    for (let i = 0; i < 3; i++) {\n243\t      const c = await createWsClient(port, docId);\n244\t      await waitForMsg(c, 0); // sync\n245\t      clients.push(c);\n246\t    }\n247\t    expect(clients.length).toBe(3);\n248\t    for (const c of clients) {\n249\t      expect(c.ws.readyState).toBe(WebSocket.OPEN);\n250\t      await closeClient(c);\n251\t    }\n252\t  });\n253\t\n254\t  it('Client joining different document does not receive other doc edits', async () => {\n255\t    const res2 = await request(app.app).post('/docs').send({ title: 'Other Doc' });\n256\t    const otherDocId = res2.body.id;\n257\t\n258\t    const c1 = await createWsClient(port, docId);\n259\t    await waitForMsg(c1, 0); // sync\n260\t    const c2 = await createWsClient(port, otherDocId);\n261\t    await waitForMsg(c2, 0); // sync\n262\t\n263\t    sendOp(c1, { type: 'insert', position: 0, text: 'Private' });\n264\t    await waitForMsg(c1, 1); // ack\n265\t\n266\t    // Give time for potential unwanted messages\n267\t    await delay(200);\n268\t\n269\t    // c2 should only have the sync message (index 0), nothing else\n270\t    expect(c2.messages.length).toBe(1);\n271\t\n272\t    await closeClient(c1);\n273\t    await closeClient(c2);\n274\t  });\n275\t});\n276\t\n277\t// ============================================================\n278\t// Single Client Editing Tests\n279\t// ============================================================\n280\t\n281\tdescribe('Single Client Editing', () => {\n282\t  let app: AppInstance;\n283\t  let port: number;\n284\t\n285\t  beforeAll(async () => {\n286\t    app = createApp();\n287\t    port = await app.start(0);\n288\t  });\n289\t\n290\t  afterAll(async () => {\n291\t    await app.stop();\n292\t  });\n293\t\n294\t  it('Insert at beginning of document', async () => {\n295\t    const res = await request(app.app).post('/docs').send({ title: 'Begin', content: 'World' });\n296\t    const docId = res.body.id;\n297\t    const client = await createWsClient(port, docId);\n298\t    await waitForMsg(client, 0); // sync\n299\t\n300\t    sendOp(client, { type: 'insert', position: 0, text: 'Hello ' });\n301\t    await waitForMsg(client, 1); // ack\n302\t\n303\t    const doc = await request(app.app).get(`/docs/${docId}`);\n304\t    expect(doc.body.content).toBe('Hello World');\n305\t\n306\t    await closeClient(client);\n307\t  });\n308\t\n309\t  it('Insert at end of document', async () => {\n310\t    const res = await request(app.app).post('/docs').send({ title: 'End', content: 'Hello' });\n311\t    const docId = res.body.id;\n312\t    const client = await createWsClient(port, docId);\n313\t    await waitForMsg(client, 0); // sync\n314\t\n315\t    sendOp(client, { type: 'insert', position: 5, text: ' World' });\n316\t    await waitForMsg(client, 1); // ack\n317\t\n318\t    const doc = await request(app.app).get(`/docs/${docId}`);\n319\t    expect(doc.body.content).toBe('Hello World');\n320\t\n321\t    await closeClient(client);\n322\t  });\n323\t\n324\t  it('Insert in middle of document', async () => {\n325\t    const res = await request(app.app).post('/docs').send({ title: 'Mid', content: 'Helo World' });\n326\t    const docId = res.body.id;\n327\t    const client = await createWsClient(port, docId);\n328\t    await waitForMsg(client, 0); // sync\n329\t\n330\t    sendOp(client, { type: 'insert', position: 3, text: 'l' });\n331\t    await waitForMsg(client, 1); // ack\n332\t\n333\t    const doc = await request(app.app).get(`/docs/${docId}`);\n334\t    expect(doc.body.content).toBe('Hello World');\n335\t\n336\t    await closeClient(client);\n337\t  });\n338\t\n339\t  it('Delete range from document', async () => {\n340\t    const res = await request(app.app).post('/docs').send({ title: 'Del', content: 'Hello Cruel World' });\n341\t    const docId = res.body.id;\n342\t    const client = await createWsClient(port, docId);\n343\t    await waitForMsg(client, 0); // sync\n344\t\n345\t    sendOp(client, { type: 'delete', position: 5, count: 6 });\n346\t    await waitForMsg(client, 1); // ack\n347\t\n348\t    const doc = await request(app.app).get(`/docs/${docId}`);\n349\t    expect(doc.body.content).toBe('Hello World');\n350\t\n351\t    await closeClient(client);\n352\t  });\n353\t\n354\t  it('Multiple sequential edits build up content correctly', async () => {\n355\t    const res = await request(app.app).post('/docs').send({ title: 'Sequential' });\n356\t    const docId = res.body.id;\n357\t    const client = await createWsClient(port, docId);\n358\t    await waitForMsg(client, 0); // sync (msg 0)\n359\t\n360\t    sendOp(client, { type: 'insert', position: 0, text: 'A' });\n361\t    await waitForMsg(client, 1); // ack (msg 1)\n362\t    sendOp(client, { type: 'insert', position: 1, text: 'B' });\n363\t    await waitForMsg(client, 2); // ack (msg 2)\n364\t    sendOp(client, { type: 'insert', position: 2, text: 'C' });\n365\t    await waitForMsg(client, 3); // ack (msg 3)\n366\t\n367\t    const doc = await request(app.app).get(`/docs/${docId}`);\n368\t    expect(doc.body.content).toBe('ABC');\n369\t\n370\t    await closeClient(client);\n371\t  });\n372\t\n373\t  it('Version is incremented after each edit', async () => {\n374\t    const res = await request(app.app).post('/docs').send({ title: 'Version' });\n375\t    const docId = res.body.id;\n376\t    const client = await createWsClient(port, docId);\n377\t    await waitForMsg(client, 0); // sync\n378\t\n379\t    sendOp(client, { type: 'insert', position: 0, text: 'A' });\n380\t    const ack1 = await waitForMsg(client, 1);\n381\t    sendOp(client, { type: 'insert', position: 1, text: 'B' });\n382\t    const ack2 = await waitForMsg(client, 2);\n383\t\n384\t    expect((ack2 as { version: number }).version).toBeGreaterThan(\n385\t      (ack1 as { version: number }).version\n386\t    );\n387\t\n388\t    await closeClient(client);\n389\t  });\n390\t});\n391\t\n392\t// ============================================================\n393\t// Two-Client Convergence Tests\n394\t// ============================================================\n395\t\n396\tdescribe('Two-Client Convergence', () => {\n397\t  let app: AppInstance;\n398\t  let port: number;\n399\t\n400\t  beforeAll(async () => {\n401\t    app = createApp();\n402\t    port = await app.start(0);\n403\t  });\n404\t\n405\t  afterAll(async () => {\n406\t    await app.stop();\n407\t  });\n408\t\n409\t  it('Two clients editing different positions converge to same content', async () => {\n410\t    const res = await request(app.app).post('/docs').send({ title: 'Converge', content: 'ABCDEF' });\n411\t    const docId = res.body.id;\n412\t\n413\t    const c1 = await createWsClient(port, docId);\n414\t    const sync1 = await waitForMsg(c1, 0);\n415\t    const c2 = await createWsClient(port, docId);\n416\t    await waitForMsg(c2, 0);\n417\t\n418\t    const version = (sync1 as { version: number }).version;\n419\t\n420\t    // Client 1 inserts at position 0\n421\t    sendOp(c1, { type: 'insert', position: 0, text: 'X' }, version);\n422\t    await waitForMsg(c1, 1); // ack\n423\t    await waitForMsg(c2, 1); // broadcast\n424\t\n425\t    // Client 2 inserts at position 7 (after \"X\" was added, \"XABCDEF\" is 7 chars, insert at end)\n426\t    sendOp(c2, { type: 'insert', position: 7, text: 'Y' }, version + 1);\n427\t    await waitForMsg(c2, 2); // ack\n428\t\n429\t    await delay(100);\n430\t    const doc = await request(app.app).get(`/docs/${docId}`);\n431\t    expect(doc.body.content).toBe('XABCDEFY');\n432\t\n433\t    await closeClient(c1);\n434\t    await closeClient(c2);\n435\t  });\n436\t\n437\t  it('Two clients inserting at same position both insertions preserved', async () => {\n438\t    const res = await request(app.app).post('/docs').send({ title: 'SamePos', content: '' });\n439\t    const docId = res.body.id;\n440\t\n441\t    const c1 = await createWsClient(port, docId);\n442\t    const sync1 = await waitForMsg(c1, 0);\n443\t    const c2 = await createWsClient(port, docId);\n444\t    await waitForMsg(c2, 0);\n445\t    const version = (sync1 as { version: number }).version;\n446\t\n447\t    // Both insert at position 0\n448\t    sendOp(c1, { type: 'insert', position: 0, text: 'A' }, version);\n449\t    await waitForMsg(c1, 1); // ack\n450\t    await waitForMsg(c2, 1); // broadcast\n451\t\n452\t    sendOp(c2, { type: 'insert', position: 0, text: 'B' }, version);\n453\t    await waitForMsg(c2, 2); // ack\n454\t\n455\t    await delay(100);\n456\t    const doc = await request(app.app).get(`/docs/${docId}`);\n457\t    expect(doc.body.content).toContain('A');\n458\t    expect(doc.body.content).toContain('B');\n459\t    expect(doc.body.content.length).toBe(2);\n460\t\n461\t    await closeClient(c1);\n462\t    await closeClient(c2);\n463\t  });\n464\t\n465\t  it('Client A inserts, Client B deletes: both changes applied', async () => {\n466\t    const res = await request(app.app).post('/docs').send({ title: 'InsertDelete', content: 'Hello World' });\n467\t    const docId = res.body.id;\n468\t\n469\t    const c1 = await createWsClient(port, docId);\n470\t    const sync1 = await waitForMsg(c1, 0);\n471\t    const c2 = await createWsClient(port, docId);\n472\t    await waitForMsg(c2, 0);\n473\t    const version = (sync1 as { version: number }).version;\n474\t\n475\t    // Client 1 inserts at beginning\n476\t    sendOp(c1, { type: 'insert', position: 0, text: 'Hey ' }, version);\n477\t    await waitForMsg(c1, 1); // ack\n478\t    await waitForMsg(c2, 1); // broadcast\n479\t\n480\t    // Client 2 deletes \"World\" (now at position 10 because \"Hey \" shifted it; \"Hey Hello World\")\n481\t    // After transform: \"Hey Hello World\" - delete at pos 10 count 5 = \"Hey Hello \"\n482\t    sendOp(c2, { type: 'delete', position: 10, count: 5 }, version + 1);\n483\t    await waitForMsg(c2, 2); // ack\n484\t\n485\t    await delay(100);\n486\t    const doc = await request(app.app).get(`/docs/${docId}`);\n487\t    expect(doc.body.content).toContain('Hey');\n488\t    expect(doc.body.content).not.toContain('World');\n489\t\n490\t    await closeClient(c1);\n491\t    await closeClient(c2);\n492\t  });\n493\t\n494\t  it('Rapid alternating edits from two clients converge', async () => {\n495\t    const res = await request(app.app).post('/docs').send({ title: 'Rapid', content: '' });\n496\t    const docId = res.body.id;\n497\t\n498\t    const c1 = await createWsClient(port, docId);\n499\t    await waitForMsg(c1, 0); // sync\n500\t    const c2 = await createWsClient(port, docId);\n501\t    await waitForMsg(c2, 0); // sync\n502\t\n503\t    // Alternating edits - each appends a char\n504\t    for (let i = 0; i < 5; i++) {\n505\t      sendOp(c1, { type: 'insert', position: i * 2, text: 'A' });\n506\t      await delay(50);\n507\t      sendOp(c2, { type: 'insert', position: i * 2 + 1, text: 'B' });\n508\t      await delay(50);\n509\t    }\n510\t\n511\t    await delay(500);\n512\t    const doc = await request(app.app).get(`/docs/${docId}`);\n513\t    // All 10 characters should be present\n514\t    expect(doc.body.content.length).toBe(10);\n515\t\n516\t    await closeClient(c1);\n517\t    await closeClient(c2);\n518\t  });\n519\t\n520\t  it('Both clients can fetch document and see identical content after sync', async () => {\n521\t    const res = await request(app.app).post('/docs').send({ title: 'Identical', content: 'Start' });\n522\t    const docId = res.body.id;\n523\t\n524\t    const c1 = await createWsClient(port, docId);\n525\t    await waitForMsg(c1, 0);\n526\t    const c2 = await createWsClient(port, docId);\n527\t    await waitForMsg(c2, 0);\n528\t\n529\t    sendOp(c1, { type: 'insert', position: 5, text: ' End' });\n530\t    await waitForMsg(c1, 1); // ack\n531\t    await waitForMsg(c2, 1); // broadcast\n532\t\n533\t    await delay(100);\n534\t    const doc1 = await request(app.app).get(`/docs/${docId}`);\n535\t    const doc2 = await request(app.app).get(`/docs/${docId}`);\n536\t    expect(doc1.body.content).toBe(doc2.body.content);\n537\t    expect(doc1.body.content).toBe('Start End');\n538\t\n539\t    await closeClient(c1);\n540\t    await closeClient(c2);\n541\t  });\n542\t\n543\t  it('Version history contains all operations in order', async () => {\n544\t    const res = await request(app.app).post('/docs').send({ title: 'History', content: '' });\n545\t    const docId = res.body.id;\n546\t\n547\t    const client = await createWsClient(port, docId);\n548\t    await waitForMsg(client, 0); // sync\n549\t\n550\t    sendOp(client, { type: 'insert', position: 0, text: 'A' });\n551\t    await waitForMsg(client, 1);\n552\t    sendOp(client, { type: 'insert', position: 1, text: 'B' });\n553\t    await waitForMsg(client, 2);\n554\t    sendOp(client, { type: 'insert', position: 2, text: 'C' });\n555\t    await waitForMsg(client, 3);\n556\t\n557\t    const versions = await request(app.app).get(`/docs/${docId}/versions`);\n558\t    expect(versions.body.length).toBeGreaterThanOrEqual(4); // version 0 + 3 edits\n559\t    for (let i = 1; i < versions.body.length; i++) {\n560\t      expect(versions.body[i].version).toBeGreaterThan(versions.body[i - 1].version);\n561\t    }\n562\t\n563\t    await closeClient(client);\n564\t  });\n565\t\n566\t  it('Concurrent edits do not lose data', async () => {\n567\t    const res = await request(app.app).post('/docs').send({ title: 'NoLoss', content: '' });\n568\t    const docId = res.body.id;\n569\t\n570\t    const c1 = await createWsClient(port, docId);\n571\t    const sync1 = await waitForMsg(c1, 0);\n572\t    const c2 = await createWsClient(port, docId);\n573\t    await waitForMsg(c2, 0);\n574\t    const version = (sync1 as { version: number }).version;\n575\t\n576\t    // Both send edits based on same initial version\n577\t    sendOp(c1, { type: 'insert', position: 0, text: 'FIRST' }, version);\n578\t    sendOp(c2, { type: 'insert', position: 0, text: 'SECOND' }, version);\n579\t\n580\t    // Wait for messages to settle\n581\t    await delay(500);\n582\t\n583\t    const doc = await request(app.app).get(`/docs/${docId}`);\n584\t    expect(doc.body.content).toContain('FIRST');\n585\t    expect(doc.body.content).toContain('SECOND');\n586\t\n587\t    await closeClient(c1);\n588\t    await closeClient(c2);\n589\t  });\n590\t\n591\t  it('Edit at end of document while other edits beginning', async () => {\n592\t    const res = await request(app.app).post('/docs').send({ title: 'EndBegin', content: 'MIDDLE' });\n593\t    const docId = res.body.id;\n594\t\n595\t    const c1 = await createWsClient(port, docId);\n596\t    const sync1 = await waitForMsg(c1, 0);\n597\t    const c2 = await createWsClient(port, docId);\n598\t    await waitForMsg(c2, 0);\n599\t    const version = (sync1 as { version: number }).version;\n600\t\n601\t    sendOp(c1, { type: 'insert', position: 0, text: 'START' }, version);\n602\t    await waitForMsg(c1, 1); // ack\n603\t    await waitForMsg(c2, 1); // broadcast\n604\t\n605\t    // After c1's edit, doc is \"STARTMIDDLE\" (11 chars)\n606\t    sendOp(c2, { type: 'insert', position: 11, text: 'END' }, version + 1);\n607\t    await waitForMsg(c2, 2); // ack\n608\t\n609\t    await delay(100);\n610\t    const doc = await request(app.app).get(`/docs/${docId}`);\n611\t    expect(doc.body.content).toBe('STARTMIDDLEEND');\n612\t\n613\t    await closeClient(c1);\n614\t    await closeClient(c2);\n615\t  });\n616\t});\n617\t\n618\t// ============================================================\n619\t// Stress Tests\n620\t// ============================================================\n621\t\n622\tdescribe('Stress Test', () => {\n623\t  let app: AppInstance;\n624\t  let port: number;\n625\t\n626\t  beforeAll(async () => {\n627\t    app = createApp();\n628\t    port = await app.start(0);\n629\t  });\n630\t\n631\t  afterAll(async () => {\n632\t    await app.stop();\n633\t  });\n634\t\n635\t  it('10 clients connect to same document simultaneously', async () => {\n636\t    const res = await request(app.app).post('/docs').send({ title: 'Stress' });\n637\t    const docId = res.body.id;\n638\t\n639\t    const clients: WsClient[] = [];\n640\t    for (let i = 0; i < 10; i++) {\n641\t      const c = await createWsClient(port, docId);\n642\t      await waitForMsg(c, 0); // sync\n643\t      clients.push(c);\n644\t    }\n645\t\n646\t    expect(clients.length).toBe(10);\n647\t    for (const c of clients) {\n648\t      expect(c.ws.readyState).toBe(WebSocket.OPEN);\n649\t    }\n650\t\n651\t    for (const c of clients) await closeClient(c);\n652\t  });\n653\t\n654\t  it('10 clients each send an edit, all edits present in final document', async () => {\n655\t    const res = await request(app.app).post('/docs').send({ title: 'StressEdit', content: '' });\n656\t    const docId = res.body.id;\n657\t\n658\t    const clients: WsClient[] = [];\n659\t    for (let i = 0; i < 10; i++) {\n660\t      const c = await createWsClient(port, docId);\n661\t      await waitForMsg(c, 0); // sync\n662\t      clients.push(c);\n663\t    }\n664\t\n665\t    // Each client sends a unique character sequentially\n666\t    for (let i = 0; i < 10; i++) {\n667\t      sendOp(clients[i], { type: 'insert', position: 0, text: String(i) });\n668\t      await delay(30);\n669\t    }\n670\t\n671\t    await delay(1000);\n672\t    const doc = await request(app.app).get(`/docs/${docId}`);\n673\t\n674\t    for (let i = 0; i < 10; i++) {\n675\t      expect(doc.body.content).toContain(String(i));\n676\t    }\n677\t\n678\t    for (const c of clients) await closeClient(c);\n679\t  });\n680\t\n681\t  it('Document content identical across all 10 clients after sync', async () => {\n682\t    const res = await request(app.app).post('/docs').send({ title: 'Sync10', content: '' });\n683\t    const docId = res.body.id;\n684\t\n685\t    const clients: WsClient[] = [];\n686\t    for (let i = 0; i < 10; i++) {\n687\t      const c = await createWsClient(port, docId);\n688\t      await waitForMsg(c, 0); // sync\n689\t      clients.push(c);\n690\t    }\n691\t\n692\t    // One client makes an edit\n693\t    sendOp(clients[0], { type: 'insert', position: 0, text: 'SHARED' });\n694\t    await delay(500);\n695\t\n696\t    for (const c of clients) await closeClient(c);\n697\t    await delay(100);\n698\t\n699\t    // All clients reconnect to get fresh state\n700\t    const contents: string[] = [];\n701\t    for (let i = 0; i < 10; i++) {\n702\t      const c = await createWsClient(port, docId);\n703\t      const sync = await waitForMsg(c, 0);\n704\t      contents.push((sync as { content: string }).content);\n705\t      await closeClient(c);\n706\t    }\n707\t\n708\t    for (const ct of contents) {\n709\t      expect(ct).toBe(contents[0]);\n710\t    }\n711\t    expect(contents[0]).toContain('SHARED');\n712\t  });\n713\t\n714\t  it('Server handles rapid-fire edits without crashing', async () => {\n715\t    const res = await request(app.app).post('/docs').send({ title: 'RapidFire', content: '' });\n716\t    const docId = res.body.id;\n717\t\n718\t    const client = await createWsClient(port, docId);\n719\t    await waitForMsg(client, 0); // sync\n720\t\n721\t    // Send 50 rapid edits\n722\t    for (let i = 0; i < 50; i++) {\n723\t      sendOp(client, { type: 'insert', position: i, text: 'x' });\n724\t    }\n725\t\n726\t    await delay(2000);\n727\t    const doc = await request(app.app).get(`/docs/${docId}`);\n728\t    expect(doc.body.content.length).toBe(50);\n729\t\n730\t    await closeClient(client);\n731\t  });\n732\t\n733\t  it('All clients can disconnect without error', async () => {\n734\t    const res = await request(app.app).post('/docs').send({ title: 'Disconnect' });\n735\t    const docId = res.body.id;\n736\t\n737\t    const clients: WsClient[] = [];\n738\t    for (let i = 0; i < 10; i++) {\n739\t      const c = await createWsClient(port, docId);\n740\t      await waitForMsg(c, 0);\n741\t      clients.push(c);\n742\t    }\n743\t\n744\t    // Disconnect all at once\n745\t    await Promise.all(clients.map((c) => closeClient(c)));\n746\t\n747\t    // Server should still be healthy\n748\t    const check = await request(app.app).get('/docs');\n749\t    expect(check.status).toBe(200);\n750\t  });\n751\t});\n752\t\n753\t// ============================================================\n754\t// Error Handling Tests\n755\t// ============================================================\n756\t\n757\tdescribe('Error Handling', () => {\n758\t  let app: AppInstance;\n759\t  let port: number;\n760\t\n761\t  beforeAll(async () => {\n762\t    app = createApp();\n763\t    port = await app.start(0);\n764\t  });\n765\t\n766\t  afterAll(async () => {\n767\t    await app.stop();\n768\t  });\n769\t\n770\t  it('Connecting to non-existent document returns error', async () => {\n771\t    const ws = new WebSocket(`ws://localhost:${port}/nonexistent-doc-id`);\n772\t    const messages: Record<string, unknown>[] = [];\n773\t    ws.on('message', (data) => messages.push(JSON.parse(data.toString())));\n774\t    await new Promise<void>((resolve) => ws.on('open', resolve));\n775\t\n776\t    // Wait for the error message\n777\t    await new Promise<void>((resolve) => {\n778\t      const interval = setInterval(() => {\n779\t        if (messages.length > 0) {\n780\t          clearInterval(interval);\n781\t          resolve();\n782\t        }\n783\t      }, 10);\n784\t      setTimeout(() => { clearInterval(interval); resolve(); }, 2000);\n785\t    });\n786\t\n787\t    expect(messages.length).toBeGreaterThan(0);\n788\t    expect(messages[0].type).toBe('error');\n789\t    expect(String(messages[0].message)).toContain('not found');\n790\t    await delay(100);\n791\t  });\n792\t\n793\t  it('Malformed operation JSON rejected', async () => {\n794\t    const res = await request(app.app).post('/docs').send({ title: 'ErrDoc' });\n795\t    const docId = res.body.id;\n796\t\n797\t    const client = await createWsClient(port, docId);\n798\t    await waitForMsg(client, 0); // sync\n799\t\n800\t    client.ws.send('not valid json{{{');\n801\t    const errMsg = await waitForMsg(client, 1);\n802\t    expect(errMsg.type).toBe('error');\n803\t\n804\t    await closeClient(client);\n805\t  });\n806\t\n807\t  it('Invalid operation type rejected', async () => {\n808\t    const res = await request(app.app).post('/docs').send({ title: 'ErrType' });\n809\t    const docId = res.body.id;\n810\t\n811\t    const client = await createWsClient(port, docId);\n812\t    await waitForMsg(client, 0); // sync\n813\t\n814\t    client.ws.send(JSON.stringify({ type: 'operation', operation: { type: 'replace', position: 0, text: 'x' } }));\n815\t    const errMsg = await waitForMsg(client, 1);\n816\t    expect(errMsg.type).toBe('error');\n817\t\n818\t    await closeClient(client);\n819\t  });\n820\t\n821\t  it('Operation with out-of-bounds position rejected', async () => {\n822\t    const res = await request(app.app).post('/docs').send({ title: 'ErrBounds', content: 'Hi' });\n823\t    const docId = res.body.id;\n824\t\n825\t    const client = await createWsClient(port, docId);\n826\t    await waitForMsg(client, 0); // sync\n827\t\n828\t    client.ws.send(JSON.stringify({ type: 'operation', operation: { type: 'delete', position: 0, count: 100 } }));\n829\t    const errMsg = await waitForMsg(client, 1);\n830\t    expect(errMsg.type).toBe('error');\n831\t\n832\t    await closeClient(client);\n833\t  });\n834\t\n835\t  it('Server remains stable after malformed input', async () => {\n836\t    const res = await request(app.app).post('/docs').send({ title: 'Stable' });\n837\t    const docId = res.body.id;\n838\t\n839\t    const client = await createWsClient(port, docId);\n840\t    await waitForMsg(client, 0); // sync\n841\t\n842\t    // Send garbage\n843\t    client.ws.send('garbage');\n844\t    const errMsg = await waitForMsg(client, 1);\n845\t    expect(errMsg.type).toBe('error');\n846\t\n847\t    // Server should still work\n848\t    const check = await request(app.app).get('/docs');\n849\t    expect(check.status).toBe(200);\n850\t\n851\t    // WS should still work\n852\t    sendOp(client, { type: 'insert', position: 0, text: 'OK' });\n853\t    const ack = await waitForMsg(client, 2);\n854\t    expect(ack.type).toBe('ack');\n855\t\n856\t    await closeClient(client);\n857\t  });\n858\t});\n859\t\n860\t// ============================================================\n861\t// Persistence Tests\n862\t// ============================================================\n863\t\n864\tdescribe('Persistence', () => {\n865\t  const dbPath = '/tmp/test-collab-persist-' + Date.now() + '.db';\n866\t\n867\t  it('Document survives server restart', async () => {\n868\t    const app1 = createApp(dbPath);\n869\t    await app1.start(0);\n870\t\n871\t    await request(app1.app).post('/docs').send({ title: 'Persistent', content: 'data' });\n872\t    const docs1 = await request(app1.app).get('/docs');\n873\t    expect(docs1.body.length).toBe(1);\n874\t\n875\t    await app1.stop();\n876\t\n877\t    const app2 = createApp(dbPath);\n878\t    await app2.start(0);\n879\t\n880\t    const docs2 = await request(app2.app).get('/docs');\n881\t    expect(docs2.body.length).toBe(1);\n882\t    expect(docs2.body[0].title).toBe('Persistent');\n883\t    expect(docs2.body[0].content).toBe('data');\n884\t\n885\t    await app2.stop();\n886\t  });\n887\t\n888\t  it('Edit history survives server restart', async () => {\n889\t    const app1 = createApp(dbPath);\n890\t    await app1.start(0);\n891\t\n892\t    const docs = await request(app1.app).get('/docs');\n893\t    const docId = docs.body[0].id;\n894\t    const versions1 = await request(app1.app).get(`/docs/${docId}/versions`);\n895\t\n896\t    await app1.stop();\n897\t\n898\t    const app2 = createApp(dbPath);\n899\t    await app2.start(0);\n900\t\n901\t    const versions2 = await request(app2.app).get(`/docs/${docId}/versions`);\n902\t    expect(versions2.body.length).toBe(versions1.body.length);\n903\t\n904\t    await app2.stop();\n905\t  });\n906\t\n907\t  it('Active connections cleared on restart', async () => {\n908\t    const app1 = createApp(dbPath);\n909\t    const port1 = await app1.start(0);\n910\t\n911\t    const docs = await request(app1.app).get('/docs');\n912\t    const docId = docs.body[0].id;\n913\t\n914\t    const client = await createWsClient(port1, docId);\n915\t    await waitForMsg(client, 0);\n916\t\n917\t    const connsBefore = app1.db.prepare('SELECT COUNT(*) as cnt FROM active_connections').get() as { cnt: number };\n918\t    expect(connsBefore.cnt).toBeGreaterThan(0);\n919\t\n920\t    await closeClient(client);\n921\t    await app1.stop();\n922\t\n923\t    const app2 = createApp(dbPath);\n924\t    await app2.start(0);\n925\t\n926\t    const connsAfter = app2.db.prepare('SELECT COUNT(*) as cnt FROM active_connections').get() as { cnt: number };\n927\t    expect(connsAfter.cnt).toBe(0);\n928\t\n929\t    await app2.stop();\n930\t  });\n931\t});\n932\t"}]},"parent_tool_use_id":null,"session_id":"9bd710e3-74a5-48f5-a868-8c46239118d5","uuid":"9890110a-cad3-4f1f-b303-df46c8459e20","timestamp":"2026-07-25T17:48:52.535Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/tests/collab.test.ts","content":"import { describe, it, expect, beforeAll, afterAll } from 'vitest';\nimport request from 'supertest';\nimport WebSocket from 'ws';\nimport { createApp, type AppInstance } from '../src/server.js';\n\n// ============================================================\n// Test Helpers\n// ============================================================\n\ninterface WsClient {\n  ws: WebSocket;\n  messages: Record<string, unknown>[];\n}\n\nfunction createWsClient(port: number, docId: string): Promise<WsClient> {\n  return new Promise((resolve, reject) => {\n    const ws = new WebSocket(`ws://localhost:${port}/${docId}`);\n    const messages: Record<string, unknown>[] = [];\n    ws.on('message', (data) => {\n      messages.push(JSON.parse(data.toString()));\n    });\n    ws.on('open', () => resolve({ ws, messages }));\n    ws.on('error', reject);\n  });\n}\n\n/** Wait for the messages array to have at least `idx + 1` entries, then return messages[idx]. */\nfunction waitForMsg(client: WsClient, idx: number, timeout = 3000): Promise<Record<string, unknown>> {\n  return new Promise((resolve, reject) => {\n    if (client.messages.length > idx) {\n      resolve(client.messages[idx]);\n      return;\n    }\n    const timer = setTimeout(\n      () => reject(new Error(`Timed out waiting for message at index ${idx} (have ${client.messages.length})`)),\n      timeout\n    );\n    const interval = setInterval(() => {\n      if (client.messages.length > idx) {\n        clearTimeout(timer);\n        clearInterval(interval);\n        resolve(client.messages[idx]);\n      }\n    }, 5);\n  });\n}\n\n\nfunction delay(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nfunction sendOp(client: WsClient, operation: Record<string, unknown>, version?: number) {\n  const msg: Record<string, unknown> = { type: 'operation', operation };\n  if (version !== undefined) msg.version = version;\n  client.ws.send(JSON.stringify(msg));\n}\n\nfunction closeClient(client: WsClient): Promise<void> {\n  return new Promise((resolve) => {\n    if (client.ws.readyState === WebSocket.CLOSED || client.ws.readyState === WebSocket.CLOSING) {\n      resolve();\n      return;\n    }\n    client.ws.on('close', () => resolve());\n    client.ws.close();\n  });\n}\n\n// ============================================================\n// REST CRUD Tests\n// ============================================================\n\ndescribe('REST CRUD', () => {\n  let app: AppInstance;\n\n  beforeAll(async () => {\n    app = createApp();\n    await app.start(0);\n  });\n\n  afterAll(async () => {\n    await app.stop();\n  });\n\n  it('POST /docs creates document with title', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Test Doc' });\n    expect(res.status).toBe(201);\n    expect(res.body.title).toBe('Test Doc');\n  });\n\n  it('POST /docs returns id, title, content, timestamps', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Full Doc' });\n    expect(res.body).toHaveProperty('id');\n    expect(res.body).toHaveProperty('title');\n    expect(res.body).toHaveProperty('content');\n    expect(res.body).toHaveProperty('created_at');\n    expect(res.body).toHaveProperty('updated_at');\n  });\n\n  it('GET /docs lists all documents', async () => {\n    const res = await request(app.app).get('/docs');\n    expect(res.status).toBe(200);\n    expect(Array.isArray(res.body)).toBe(true);\n    expect(res.body.length).toBeGreaterThanOrEqual(2);\n  });\n\n  it('GET /docs/:id returns specific document', async () => {\n    const created = await request(app.app).post('/docs').send({ title: 'Specific' });\n    const res = await request(app.app).get(`/docs/${created.body.id}`);\n    expect(res.status).toBe(200);\n    expect(res.body.title).toBe('Specific');\n  });\n\n  it('GET /docs/:id returns 404 for non-existent', async () => {\n    const res = await request(app.app).get('/docs/nonexistent-id');\n    expect(res.status).toBe(404);\n  });\n\n  it('PUT /docs/:id updates title', async () => {\n    const created = await request(app.app).post('/docs').send({ title: 'Old Title' });\n    const res = await request(app.app).put(`/docs/${created.body.id}`).send({ title: 'New Title' });\n    expect(res.status).toBe(200);\n    expect(res.body.title).toBe('New Title');\n  });\n\n  it('DELETE /docs/:id removes document', async () => {\n    const created = await request(app.app).post('/docs').send({ title: 'To Delete' });\n    const res = await request(app.app).delete(`/docs/${created.body.id}`);\n    expect(res.status).toBe(204);\n    const check = await request(app.app).get(`/docs/${created.body.id}`);\n    expect(check.status).toBe(404);\n  });\n\n  it('DELETE /docs/:id returns 404 for non-existent', async () => {\n    const res = await request(app.app).delete('/docs/nonexistent-id');\n    expect(res.status).toBe(404);\n  });\n\n  it('GET /docs/:id/versions lists version history', async () => {\n    const created = await request(app.app).post('/docs').send({ title: 'Versioned' });\n    const res = await request(app.app).get(`/docs/${created.body.id}/versions`);\n    expect(res.status).toBe(200);\n    expect(Array.isArray(res.body)).toBe(true);\n    expect(res.body.length).toBeGreaterThanOrEqual(1);\n    expect(res.body[0].version).toBe(0);\n  });\n\n  it('GET /docs/:id/versions/:version returns specific version content', async () => {\n    const created = await request(app.app).post('/docs').send({ title: 'Versioned2' });\n    const res = await request(app.app).get(`/docs/${created.body.id}/versions/0`);\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty('content');\n    expect(res.body.version).toBe(0);\n  });\n});\n\n// ============================================================\n// WebSocket Lifecycle Tests\n// ============================================================\n\ndescribe('WebSocket Lifecycle', () => {\n  let app: AppInstance;\n  let port: number;\n  let docId: string;\n\n  beforeAll(async () => {\n    app = createApp();\n    port = await app.start(0);\n    const res = await request(app.app).post('/docs').send({ title: 'WS Doc' });\n    docId = res.body.id;\n  });\n\n  afterAll(async () => {\n    await app.stop();\n  });\n\n  it('Client connects to ws://.../:docId', async () => {\n    const client = await createWsClient(port, docId);\n    expect(client.ws.readyState).toBe(WebSocket.OPEN);\n    await waitForMsg(client, 0);\n    await closeClient(client);\n  });\n\n  it('Client receives current document content on connect', async () => {\n    const client = await createWsClient(port, docId);\n    const msg = await waitForMsg(client, 0);\n    expect(msg.type).toBe('sync');\n    expect(msg).toHaveProperty('content');\n    expect(msg).toHaveProperty('version');\n    await closeClient(client);\n  });\n\n  it('Client sends edit operation and receives acknowledgment', async () => {\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n    sendOp(client, { type: 'insert', position: 0, text: 'Hello' });\n    const ack = await waitForMsg(client, 1);\n    expect(ack.type).toBe('ack');\n    expect(ack).toHaveProperty('version');\n    await closeClient(client);\n  });\n\n  it('Server broadcasts operation to other clients in same document', async () => {\n    const c1 = await createWsClient(port, docId);\n    await waitForMsg(c1, 0); // sync\n    const c2 = await createWsClient(port, docId);\n    await waitForMsg(c2, 0); // sync\n\n    sendOp(c1, { type: 'insert', position: 0, text: 'Broadcast' });\n    await waitForMsg(c1, 1); // ack for c1\n\n    const broadcast = await waitForMsg(c2, 1); // broadcast for c2\n    expect(broadcast.type).toBe('operation');\n    expect(broadcast).toHaveProperty('operation');\n\n    await closeClient(c1);\n    await closeClient(c2);\n  });\n\n  it('Client does not receive own operations back as broadcast', async () => {\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    sendOp(client, { type: 'insert', position: 0, text: 'Self' });\n    const msg = await waitForMsg(client, 1);\n    // Should get ack, not operation broadcast\n    expect(msg.type).toBe('ack');\n\n    await closeClient(client);\n  });\n\n  it('Client disconnects cleanly', async () => {\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n    await closeClient(client);\n    expect(client.ws.readyState).toBe(WebSocket.CLOSED);\n  });\n\n  it('Multiple clients can join same document', async () => {\n    const clients: WsClient[] = [];\n    for (let i = 0; i < 3; i++) {\n      const c = await createWsClient(port, docId);\n      await waitForMsg(c, 0); // sync\n      clients.push(c);\n    }\n    expect(clients.length).toBe(3);\n    for (const c of clients) {\n      expect(c.ws.readyState).toBe(WebSocket.OPEN);\n      await closeClient(c);\n    }\n  });\n\n  it('Client joining different document does not receive other doc edits', async () => {\n    const res2 = await request(app.app).post('/docs').send({ title: 'Other Doc' });\n    const otherDocId = res2.body.id;\n\n    const c1 = await createWsClient(port, docId);\n    await waitForMsg(c1, 0); // sync\n    const c2 = await createWsClient(port, otherDocId);\n    await waitForMsg(c2, 0); // sync\n\n    sendOp(c1, { type: 'insert', position: 0, text: 'Private' });\n    await waitForMsg(c1, 1); // ack\n\n    // Give time for potential unwanted messages\n    await delay(200);\n\n    // c2 should only have the sync message (index 0), nothing else\n    expect(c2.messages.length).toBe(1);\n\n    await closeClient(c1);\n    await closeClient(c2);\n  });\n});\n\n// ============================================================\n// Single Client Editing Tests\n// ============================================================\n\ndescribe('Single Client Editing', () => {\n  let app: AppInstance;\n  let port: number;\n\n  beforeAll(async () => {\n    app = createApp();\n    port = await app.start(0);\n  });\n\n  afterAll(async () => {\n    await app.stop();\n  });\n\n  it('Insert at beginning of document', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Begin', content: 'World' });\n    const docId = res.body.id;\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    sendOp(client, { type: 'insert', position: 0, text: 'Hello ' });\n    await waitForMsg(client, 1); // ack\n\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    expect(doc.body.content).toBe('Hello World');\n\n    await closeClient(client);\n  });\n\n  it('Insert at end of document', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'End', content: 'Hello' });\n    const docId = res.body.id;\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    sendOp(client, { type: 'insert', position: 5, text: ' World' });\n    await waitForMsg(client, 1); // ack\n\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    expect(doc.body.content).toBe('Hello World');\n\n    await closeClient(client);\n  });\n\n  it('Insert in middle of document', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Mid', content: 'Helo World' });\n    const docId = res.body.id;\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    sendOp(client, { type: 'insert', position: 3, text: 'l' });\n    await waitForMsg(client, 1); // ack\n\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    expect(doc.body.content).toBe('Hello World');\n\n    await closeClient(client);\n  });\n\n  it('Delete range from document', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Del', content: 'Hello Cruel World' });\n    const docId = res.body.id;\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    sendOp(client, { type: 'delete', position: 5, count: 6 });\n    await waitForMsg(client, 1); // ack\n\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    expect(doc.body.content).toBe('Hello World');\n\n    await closeClient(client);\n  });\n\n  it('Multiple sequential edits build up content correctly', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Sequential' });\n    const docId = res.body.id;\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync (msg 0)\n\n    sendOp(client, { type: 'insert', position: 0, text: 'A' });\n    await waitForMsg(client, 1); // ack (msg 1)\n    sendOp(client, { type: 'insert', position: 1, text: 'B' });\n    await waitForMsg(client, 2); // ack (msg 2)\n    sendOp(client, { type: 'insert', position: 2, text: 'C' });\n    await waitForMsg(client, 3); // ack (msg 3)\n\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    expect(doc.body.content).toBe('ABC');\n\n    await closeClient(client);\n  });\n\n  it('Version is incremented after each edit', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Version' });\n    const docId = res.body.id;\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    sendOp(client, { type: 'insert', position: 0, text: 'A' });\n    const ack1 = await waitForMsg(client, 1);\n    sendOp(client, { type: 'insert', position: 1, text: 'B' });\n    const ack2 = await waitForMsg(client, 2);\n\n    expect((ack2 as { version: number }).version).toBeGreaterThan(\n      (ack1 as { version: number }).version\n    );\n\n    await closeClient(client);\n  });\n});\n\n// ============================================================\n// Two-Client Convergence Tests\n// ============================================================\n\ndescribe('Two-Client Convergence', () => {\n  let app: AppInstance;\n  let port: number;\n\n  beforeAll(async () => {\n    app = createApp();\n    port = await app.start(0);\n  });\n\n  afterAll(async () => {\n    await app.stop();\n  });\n\n  it('Two clients editing different positions converge to same content', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Converge', content: 'ABCDEF' });\n    const docId = res.body.id;\n\n    const c1 = await createWsClient(port, docId);\n    const sync1 = await waitForMsg(c1, 0);\n    const c2 = await createWsClient(port, docId);\n    await waitForMsg(c2, 0);\n\n    const version = (sync1 as { version: number }).version;\n\n    // Client 1 inserts at position 0\n    sendOp(c1, { type: 'insert', position: 0, text: 'X' }, version);\n    await waitForMsg(c1, 1); // ack\n    await waitForMsg(c2, 1); // broadcast\n\n    // Client 2 inserts at position 7 (after \"X\" was added, \"XABCDEF\" is 7 chars, insert at end)\n    sendOp(c2, { type: 'insert', position: 7, text: 'Y' }, version + 1);\n    await waitForMsg(c2, 2); // ack\n\n    await delay(100);\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    expect(doc.body.content).toBe('XABCDEFY');\n\n    await closeClient(c1);\n    await closeClient(c2);\n  });\n\n  it('Two clients inserting at same position both insertions preserved', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'SamePos', content: '' });\n    const docId = res.body.id;\n\n    const c1 = await createWsClient(port, docId);\n    const sync1 = await waitForMsg(c1, 0);\n    const c2 = await createWsClient(port, docId);\n    await waitForMsg(c2, 0);\n    const version = (sync1 as { version: number }).version;\n\n    // Both insert at position 0\n    sendOp(c1, { type: 'insert', position: 0, text: 'A' }, version);\n    await waitForMsg(c1, 1); // ack\n    await waitForMsg(c2, 1); // broadcast\n\n    sendOp(c2, { type: 'insert', position: 0, text: 'B' }, version);\n    await waitForMsg(c2, 2); // ack\n\n    await delay(100);\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    expect(doc.body.content).toContain('A');\n    expect(doc.body.content).toContain('B');\n    expect(doc.body.content.length).toBe(2);\n\n    await closeClient(c1);\n    await closeClient(c2);\n  });\n\n  it('Client A inserts, Client B deletes: both changes applied', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'InsertDelete', content: 'Hello World' });\n    const docId = res.body.id;\n\n    const c1 = await createWsClient(port, docId);\n    const sync1 = await waitForMsg(c1, 0);\n    const c2 = await createWsClient(port, docId);\n    await waitForMsg(c2, 0);\n    const version = (sync1 as { version: number }).version;\n\n    // Client 1 inserts at beginning\n    sendOp(c1, { type: 'insert', position: 0, text: 'Hey ' }, version);\n    await waitForMsg(c1, 1); // ack\n    await waitForMsg(c2, 1); // broadcast\n\n    // Client 2 deletes \"World\" (now at position 10 because \"Hey \" shifted it; \"Hey Hello World\")\n    // After transform: \"Hey Hello World\" - delete at pos 10 count 5 = \"Hey Hello \"\n    sendOp(c2, { type: 'delete', position: 10, count: 5 }, version + 1);\n    await waitForMsg(c2, 2); // ack\n\n    await delay(100);\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    expect(doc.body.content).toContain('Hey');\n    expect(doc.body.content).not.toContain('World');\n\n    await closeClient(c1);\n    await closeClient(c2);\n  });\n\n  it('Rapid alternating edits from two clients converge', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Rapid', content: '' });\n    const docId = res.body.id;\n\n    const c1 = await createWsClient(port, docId);\n    await waitForMsg(c1, 0); // sync\n    const c2 = await createWsClient(port, docId);\n    await waitForMsg(c2, 0); // sync\n\n    // Alternating edits - each appends a char\n    for (let i = 0; i < 5; i++) {\n      sendOp(c1, { type: 'insert', position: i * 2, text: 'A' });\n      await delay(50);\n      sendOp(c2, { type: 'insert', position: i * 2 + 1, text: 'B' });\n      await delay(50);\n    }\n\n    await delay(500);\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    // All 10 characters should be present\n    expect(doc.body.content.length).toBe(10);\n\n    await closeClient(c1);\n    await closeClient(c2);\n  });\n\n  it('Both clients can fetch document and see identical content after sync', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Identical', content: 'Start' });\n    const docId = res.body.id;\n\n    const c1 = await createWsClient(port, docId);\n    await waitForMsg(c1, 0);\n    const c2 = await createWsClient(port, docId);\n    await waitForMsg(c2, 0);\n\n    sendOp(c1, { type: 'insert', position: 5, text: ' End' });\n    await waitForMsg(c1, 1); // ack\n    await waitForMsg(c2, 1); // broadcast\n\n    await delay(100);\n    const doc1 = await request(app.app).get(`/docs/${docId}`);\n    const doc2 = await request(app.app).get(`/docs/${docId}`);\n    expect(doc1.body.content).toBe(doc2.body.content);\n    expect(doc1.body.content).toBe('Start End');\n\n    await closeClient(c1);\n    await closeClient(c2);\n  });\n\n  it('Version history contains all operations in order', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'History', content: '' });\n    const docId = res.body.id;\n\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    sendOp(client, { type: 'insert', position: 0, text: 'A' });\n    await waitForMsg(client, 1);\n    sendOp(client, { type: 'insert', position: 1, text: 'B' });\n    await waitForMsg(client, 2);\n    sendOp(client, { type: 'insert', position: 2, text: 'C' });\n    await waitForMsg(client, 3);\n\n    const versions = await request(app.app).get(`/docs/${docId}/versions`);\n    expect(versions.body.length).toBeGreaterThanOrEqual(4); // version 0 + 3 edits\n    for (let i = 1; i < versions.body.length; i++) {\n      expect(versions.body[i].version).toBeGreaterThan(versions.body[i - 1].version);\n    }\n\n    await closeClient(client);\n  });\n\n  it('Concurrent edits do not lose data', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'NoLoss', content: '' });\n    const docId = res.body.id;\n\n    const c1 = await createWsClient(port, docId);\n    const sync1 = await waitForMsg(c1, 0);\n    const c2 = await createWsClient(port, docId);\n    await waitForMsg(c2, 0);\n    const version = (sync1 as { version: number }).version;\n\n    // Both send edits based on same initial version\n    sendOp(c1, { type: 'insert', position: 0, text: 'FIRST' }, version);\n    sendOp(c2, { type: 'insert', position: 0, text: 'SECOND' }, version);\n\n    // Wait for messages to settle\n    await delay(500);\n\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    expect(doc.body.content).toContain('FIRST');\n    expect(doc.body.content).toContain('SECOND');\n\n    await closeClient(c1);\n    await closeClient(c2);\n  });\n\n  it('Edit at end of document while other edits beginning', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'EndBegin', content: 'MIDDLE' });\n    const docId = res.body.id;\n\n    const c1 = await createWsClient(port, docId);\n    const sync1 = await waitForMsg(c1, 0);\n    const c2 = await createWsClient(port, docId);\n    await waitForMsg(c2, 0);\n    const version = (sync1 as { version: number }).version;\n\n    sendOp(c1, { type: 'insert', position: 0, text: 'START' }, version);\n    await waitForMsg(c1, 1); // ack\n    await waitForMsg(c2, 1); // broadcast\n\n    // After c1's edit, doc is \"STARTMIDDLE\" (11 chars)\n    sendOp(c2, { type: 'insert', position: 11, text: 'END' }, version + 1);\n    await waitForMsg(c2, 2); // ack\n\n    await delay(100);\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    expect(doc.body.content).toBe('STARTMIDDLEEND');\n\n    await closeClient(c1);\n    await closeClient(c2);\n  });\n});\n\n// ============================================================\n// Stress Tests\n// ============================================================\n\ndescribe('Stress Test', () => {\n  let app: AppInstance;\n  let port: number;\n\n  beforeAll(async () => {\n    app = createApp();\n    port = await app.start(0);\n  });\n\n  afterAll(async () => {\n    await app.stop();\n  });\n\n  it('10 clients connect to same document simultaneously', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Stress' });\n    const docId = res.body.id;\n\n    const clients: WsClient[] = [];\n    for (let i = 0; i < 10; i++) {\n      const c = await createWsClient(port, docId);\n      await waitForMsg(c, 0); // sync\n      clients.push(c);\n    }\n\n    expect(clients.length).toBe(10);\n    for (const c of clients) {\n      expect(c.ws.readyState).toBe(WebSocket.OPEN);\n    }\n\n    for (const c of clients) await closeClient(c);\n  });\n\n  it('10 clients each send an edit, all edits present in final document', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'StressEdit', content: '' });\n    const docId = res.body.id;\n\n    const clients: WsClient[] = [];\n    for (let i = 0; i < 10; i++) {\n      const c = await createWsClient(port, docId);\n      await waitForMsg(c, 0); // sync\n      clients.push(c);\n    }\n\n    // Each client sends a unique character sequentially\n    for (let i = 0; i < 10; i++) {\n      sendOp(clients[i], { type: 'insert', position: 0, text: String(i) });\n      await delay(30);\n    }\n\n    await delay(1000);\n    const doc = await request(app.app).get(`/docs/${docId}`);\n\n    for (let i = 0; i < 10; i++) {\n      expect(doc.body.content).toContain(String(i));\n    }\n\n    for (const c of clients) await closeClient(c);\n  });\n\n  it('Document content identical across all 10 clients after sync', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Sync10', content: '' });\n    const docId = res.body.id;\n\n    const clients: WsClient[] = [];\n    for (let i = 0; i < 10; i++) {\n      const c = await createWsClient(port, docId);\n      await waitForMsg(c, 0); // sync\n      clients.push(c);\n    }\n\n    // One client makes an edit\n    sendOp(clients[0], { type: 'insert', position: 0, text: 'SHARED' });\n    await delay(500);\n\n    for (const c of clients) await closeClient(c);\n    await delay(100);\n\n    // All clients reconnect to get fresh state\n    const contents: string[] = [];\n    for (let i = 0; i < 10; i++) {\n      const c = await createWsClient(port, docId);\n      const sync = await waitForMsg(c, 0);\n      contents.push((sync as { content: string }).content);\n      await closeClient(c);\n    }\n\n    for (const ct of contents) {\n      expect(ct).toBe(contents[0]);\n    }\n    expect(contents[0]).toContain('SHARED');\n  });\n\n  it('Server handles rapid-fire edits without crashing', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'RapidFire', content: '' });\n    const docId = res.body.id;\n\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    // Send 50 rapid edits\n    for (let i = 0; i < 50; i++) {\n      sendOp(client, { type: 'insert', position: i, text: 'x' });\n    }\n\n    await delay(2000);\n    const doc = await request(app.app).get(`/docs/${docId}`);\n    expect(doc.body.content.length).toBe(50);\n\n    await closeClient(client);\n  });\n\n  it('All clients can disconnect without error', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Disconnect' });\n    const docId = res.body.id;\n\n    const clients: WsClient[] = [];\n    for (let i = 0; i < 10; i++) {\n      const c = await createWsClient(port, docId);\n      await waitForMsg(c, 0);\n      clients.push(c);\n    }\n\n    // Disconnect all at once\n    await Promise.all(clients.map((c) => closeClient(c)));\n\n    // Server should still be healthy\n    const check = await request(app.app).get('/docs');\n    expect(check.status).toBe(200);\n  });\n});\n\n// ============================================================\n// Error Handling Tests\n// ============================================================\n\ndescribe('Error Handling', () => {\n  let app: AppInstance;\n  let port: number;\n\n  beforeAll(async () => {\n    app = createApp();\n    port = await app.start(0);\n  });\n\n  afterAll(async () => {\n    await app.stop();\n  });\n\n  it('Connecting to non-existent document returns error', async () => {\n    const ws = new WebSocket(`ws://localhost:${port}/nonexistent-doc-id`);\n    const messages: Record<string, unknown>[] = [];\n    ws.on('message', (data) => messages.push(JSON.parse(data.toString())));\n    await new Promise<void>((resolve) => ws.on('open', resolve));\n\n    // Wait for the error message\n    await new Promise<void>((resolve) => {\n      const interval = setInterval(() => {\n        if (messages.length > 0) {\n          clearInterval(interval);\n          resolve();\n        }\n      }, 10);\n      setTimeout(() => { clearInterval(interval); resolve(); }, 2000);\n    });\n\n    expect(messages.length).toBeGreaterThan(0);\n    expect(messages[0].type).toBe('error');\n    expect(String(messages[0].message)).toContain('not found');\n    await delay(100);\n  });\n\n  it('Malformed operation JSON rejected', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'ErrDoc' });\n    const docId = res.body.id;\n\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    client.ws.send('not valid json{{{');\n    const errMsg = await waitForMsg(client, 1);\n    expect(errMsg.type).toBe('error');\n\n    await closeClient(client);\n  });\n\n  it('Invalid operation type rejected', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'ErrType' });\n    const docId = res.body.id;\n\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    client.ws.send(JSON.stringify({ type: 'operation', operation: { type: 'replace', position: 0, text: 'x' } }));\n    const errMsg = await waitForMsg(client, 1);\n    expect(errMsg.type).toBe('error');\n\n    await closeClient(client);\n  });\n\n  it('Operation with out-of-bounds position rejected', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'ErrBounds', content: 'Hi' });\n    const docId = res.body.id;\n\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    client.ws.send(JSON.stringify({ type: 'operation', operation: { type: 'delete', position: 0, count: 100 } }));\n    const errMsg = await waitForMsg(client, 1);\n    expect(errMsg.type).toBe('error');\n\n    await closeClient(client);\n  });\n\n  it('Server remains stable after malformed input', async () => {\n    const res = await request(app.app).post('/docs').send({ title: 'Stable' });\n    const docId = res.body.id;\n\n    const client = await createWsClient(port, docId);\n    await waitForMsg(client, 0); // sync\n\n    // Send garbage\n    client.ws.send('garbage');\n    const errMsg = await waitForMsg(client, 1);\n    expect(errMsg.type).toBe('error');\n\n    // Server should still work\n    const check = await request(app.app).get('/docs');\n    expect(check.status).toBe(200);\n\n    // WS should still work\n    sendOp(client, { type: 'insert', position: 0, text: 'OK' });\n    const ack = await waitForMsg(client, 2);\n    expect(ack.type).toBe('ack');\n\n    await closeClient(client);\n  });\n});\n\n// ============================================================\n// Persistence Tests\n// ============================================================\n\ndescribe('Persistence', () => {\n  const dbPath = '/tmp/test-collab-persist-' + Date.now() + '.db';\n\n  it('Document survives server restart', async () => {\n    const app1 = createApp(dbPath);\n    await app1.start(0);\n\n    await request(app1.app).post('/docs').send({ title: 'Persistent', content: 'data' });\n    const docs1 = await request(app1.app).get('/docs');\n    expect(docs1.body.length).toBe(1);\n\n    await app1.stop();\n\n    const app2 = createApp(dbPath);\n    await app2.start(0);\n\n    const docs2 = await request(app2.app).get('/docs');\n    expect(docs2.body.length).toBe(1);\n    expect(docs2.body[0].title).toBe('Persistent');\n    expect(docs2.body[0].content).toBe('data');\n\n    await app2.stop();\n  });\n\n  it('Edit history survives server restart', async () => {\n    const app1 = createApp(dbPath);\n    await app1.start(0);\n\n    const docs = await request(app1.app).get('/docs');\n    const docId = docs.body[0].id;\n    const versions1 = await request(app1.app).get(`/docs/${docId}/versions`);\n\n    await app1.stop();\n\n    const app2 = createApp(dbPath);\n    await app2.start(0);\n\n    const versions2 = await request(app2.app).get(`/docs/${docId}/versions`);\n    expect(versions2.body.length).toBe(versions1.body.length);\n\n    await app2.stop();\n  });\n\n  it('Active connections cleared on restart', async () => {\n    const app1 = createApp(dbPath);\n    const port1 = await app1.start(0);\n\n    const docs = await request(app1.app).get('/docs');\n    const docId = docs.body[0].id;\n\n    const client = await createWsClient(port1, docId);\n    await waitForMsg(client, 0);\n\n    const connsBefore = app1.db.prepare('SELECT COUNT(*) as cnt FROM active_connections').get() as { cnt: number };\n    expect(connsBefore.cnt).toBeGreaterThan(0);\n\n    await closeClient(client);\n    await app1.stop();\n\n    const app2 = createApp(dbPath);\n    await app2.start(0);\n\n    const connsAfter = app2.db.prepare('SELECT COUNT(*) as cnt FROM active_connections').get() as { cnt: number };\n    expect(connsAfter.cnt).toBe(0);\n\n    await app2.stop();\n  });\n});\n","numLines":932,"startLine":1,"totalLines":932}}}
