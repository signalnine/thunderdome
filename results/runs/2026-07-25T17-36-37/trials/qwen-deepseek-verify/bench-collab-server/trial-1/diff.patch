rver = createServer(app);\n  const wss = createWsServer(server, db);\n\n  app.use('/', createRoutes(db));\n\n  const start = async (port?: number): Promise<number> => {\n    return new Promise((resolve) => {\n      server.listen(port ?? 0, () => {\n        const addr = server.address();\n        if (addr && typeof addr === 'object') {\n          resolve(addr.port);\n        } else {\n          resolve(0);\n        }\n      });\n    });\n  };\n\n  const stop = async (): Promise<void> => {\n    return new Promise((resolve) => {\n      // Close all WebSocket connections first\n      for (const client of wss.clients) {\n        client.close();\n      }\n      // Close the WebSocket server\n      wss.close(() => {\n        // Close the HTTP server\n        server.close(() => {\n          db.close();\n          resolve();\n        });\n      });\n    });\n  };\n\n  return { app, server, wss, db, start, stop };\n}\n","structuredPatch":[{"oldStart":4,"oldLines":7,"newStart":4,"newLines":6,"lines":[" "," import express from 'express';"," import { createServer, type Server as HttpServer } from 'http';","-import { WebSocketServer } from 'ws';"," import Database from 'better-sqlite3';"," import { createDb, clearActiveConnections } from './db.js';"," import { createRoutes } from './routes.js';"]}],"userModified":false,"replaceAll":false}}
