rsion, content, operation) VALUES (?, ?, ?, ?)`\n  ).run(documentId, version, content, operationJson);\n}\n\nexport function updateDocumentContent(db: Database.Database, id: string, content: string): void {\n  const now = new Date().toISOString();\n  db.prepare(\n    `UPDATE documents SET content = ?, updated_at = ? WHERE id = ?`\n  ).run(content, now, id);\n}\n\nexport function getDocumentVersion(db: Database.Database, id: string): number {\n  const row = db.prepare(\n    `SELECT MAX(version) as maxVersion FROM versions WHERE document_id = ?`\n  ).get(id) as { maxVersion: number | null };\n  return row.maxVersion ?? 0;\n}\n\nexport function clearActiveConnections(db: Database.Database): void {\n  db.prepare(`DELETE FROM active_connections`).run();\n}\n\nexport function addActiveConnection(db: Database.Database, id: string, documentId: string): void {\n  const now = new Date().toISOString();\n  db.prepare(\n    `INSERT INTO active_connections (id, document_id, connected_at) VALUES (?, ?, ?)`\n  ).run(id, documentId, now);\n}\n\nexport function removeActiveConnection(db: Database.Database, id: string): void {\n  db.prepare(`DELETE FROM active_connections WHERE id = ?`).run(id);\n}\n\n","structuredPatch":[{"oldStart":28,"oldLines":7,"newStart":28,"newLines":7,"lines":["   ).run(id, content);"," }"," ","-export function saveVersion(db: Database.Database, documentId: string, version: number, content: string, operationJson: string): void {","+export function saveVersion(db: Database.Database, documentId: string, version: number, content: string, operationJson: string | null): void {","   db.prepare(","     `INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)`","   ).run(documentId, version, content, operationJson);"]}],"userModified":false,"replaceAll":false}}
