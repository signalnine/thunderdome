+// ============================================================
+// Database
+// ============================================================
+
+import Database from 'better-sqlite3';
+import { readFileSync } from 'fs';
+import { resolve, dirname } from 'path';
+import { fileURLToPath } from 'url';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = dirname(__filename);
+
+export function createDb(dbPath?: string): Database.Database {
+  const db = new Database(dbPath || ':memory:');
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+
+  const schema = readFileSync(resolve(__dirname, '..', 'schema.sql'), 'utf-8');
+  db.exec(schema);
+
+  return db;
+}
+
+export function initDocument(db: Database.Database, id: string, title: string, content: string): void {
+  const now = new Date().toISOString();
+  db.prepare(
+    `INSERT INTO documents (id, title, content, created_at, updated_at) VALUES (?, ?, ?, ?, ?)`
+  ).run(id, title, content, now, now);
+
+  db.prepare(
+    `INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)`
+  ).run(id, content);
+}
+
+export function saveVersion(db: Database.Database, documentId: string, version: number, content: string, operationJson: string | null): void {
+  db.prepare(
+    `INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)`
+  ).run(documentId, version, content, operationJson);
+}
+
+export function updateDocumentContent(db: Database.Database, id: string, content: string): void {
+  const now = new Date().toISOString();
+  db.prepare(
+    `UPDATE documents SET content = ?, updated_at = ? WHERE id = ?`
+  ).run(content, now, id);
+}
+
+export function getDocumentVersion(db: Database.Database, id: string): number {
+  const row = db.prepare(
+    `SELECT MAX(version) as maxVersion FROM versions WHERE document_id = ?`
+  ).get(id) as { maxVersion: number | null };
+  return row.maxVersion ?? 0;
+}
+
+export function clearActiveConnections(db: Database.Database): void {
+  db.prepare(`DELETE FROM active_connections`).run();
+}
+
+export function addActiveConnection(db: Database.Database, id: string, documentId: string): void {
+  const now = new Date().toISOString();
+  db.prepare(
+    `INSERT INTO active_connections (id, document_id, connected_at) VALUES (?, ?, ?)`
+  ).run(id, documentId, now);
+}
+
+export function removeActiveConnection(db: Database.Database, id: string): void {
+  db.prepare(`DELETE FROM active_connections WHERE id = ?`).run(id);
+}
+
