 document\n  router.get('/docs/:id', (req: Request, res: Response) => {\n    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id);\n    if (!doc) {\n      return res.status(404).json({ error: 'Document not found' });\n    }\n    res.json(doc);\n  });\n\n  // PUT /docs/:id - Update document\n  router.put('/docs/:id', (req: Request, res: Response) => {\n    const existing = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id);\n    if (!existing) {\n      return res.status(404).json({ error: 'Document not found' });\n    }\n\n    const { title, content } = req.body;\n    const newTitle = title ?? existing.title;\n    const newContent = content ?? existing.content;\n\n    const now = new Date().toISOString();\n    db.prepare(\n      `UPDATE documents SET title = ?, content = ?, updated_at = ? WHERE id = ?`\n    ).run(newTitle, newContent, now, req.params.id);\n\n    // Save a version for the update\n    const row = db.prepare(\n      `SELECT MAX(version) as maxVersion FROM versions WHERE document_id = ?`\n    ).get(req.params.id) as { maxVersion: number | null };\n    const newVersion = (row.maxVersion ?? 0) + 1;\n    saveVersion(db, req.params.id, newVersion, newContent, null);\n\n    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id);\n    res.json(doc);\n  });\n\n  // DELETE /docs/:id - Delete document\n  router.delete('/docs/:id', (req: Request, res: Response) => {\n    const existing = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id);\n    if (!existing) {\n      return res.status(404).json({ error: 'Document not found' });\n    }\n    db.prepare('DELETE FROM documents WHERE id = ?').run(req.params.id);\n    res.status(204).send();\n  });\n\n  // GET /docs/:id/versions - List version history\n  router.get('/docs/:id/versions', (req: Request, res: Response) => {\n    const versions = db.prepare(\n      `SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC`\n    ).all(req.params.id);\n    res.json(versions);\n  });\n\n  // GET /docs/:id/versions/:version - Get specific version\n  router.get('/docs/:id/versions/:version', (req: Request, res: Response) => {\n    const version = db.prepare(\n      `SELECT * FROM versions WHERE document_id = ? AND version = ?`\n    ).get(req.params.id, parseInt(req.params.version, 10));\n    if (!version) {\n      return res.status(404).json({ error: 'Version not found' });\n    }\n    res.json(version);\n  });\n\n  return router;\n}\n\n","structuredPatch":[{"oldStart":2,"oldLines":10,"newStart":2,"newLines":11,"lines":[" // REST Routes"," // ============================================================"," ","-import type { Request, Response, Router } from 'express';","+import type { Request, Response } from 'express';","+import { Router } from 'express';"," import Database from 'better-sqlite3';"," import { randomUUID } from 'crypto';","-import { initDocument, saveVersion, updateDocumentContent } from './db';","+import { initDocument, saveVersion, updateDocumentContent } from './db.js';"," "," export function createRoutes(db: Database.Database): Router {","   const router = Router();"]}],"userModified":false,"replaceAll":false}}
