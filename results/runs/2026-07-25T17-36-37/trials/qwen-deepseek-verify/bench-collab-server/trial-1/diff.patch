tion send(ws: WebSocket, data: Record<string, unknown>): void {\n    if (ws.readyState === WebSocket.OPEN) {\n      ws.send(JSON.stringify(data));\n    }\n  }\n\n  function broadcastToRoom(docId: string, data: Record<string, unknown>, exclude?: WsClient): void {\n    const room = getRoom(docId);\n    for (const client of room) {\n      if (client !== exclude) {\n        send(client.ws, data);\n      }\n    }\n  }\n\n  wss.on('connection', (ws: WebSocket, req: IncomingMessage) => {\n    // Extract docId from URL path: /ws/:docId\n    const url = new URL(req.url!, `http://${req.headers.host}`);\n    const docId = url.pathname.replace(/^\\//, '');\n\n    // Check document exists\n    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(docId);\n    if (!doc) {\n      send(ws, { type: 'error', message: `Document ${docId} not found` });\n      ws.close();\n      return;\n    }\n\n    const client: WsClient = { ws, docId };\n    const room = getRoom(docId);\n    room.add(client);\n\n    // Track active connection\n    const connId = `${docId}:${Date.now()}:${Math.random()}`;\n    addActiveConnection(db, connId, docId);\n\n    // Send sync message with current state\n    const state = getDocState(docId);\n    send(ws, { type: 'sync', content: state.content, version: state.version });\n\n    ws.on('message', (data: Buffer) => {\n      let parsed: Record<string, unknown>;\n      try {\n        parsed = JSON.parse(data.toString());\n      } catch {\n        send(ws, { type: 'error', message: 'Invalid JSON' });\n        return;\n      }\n\n      if (parsed.type !== 'operation') {\n        send(ws, { type: 'error', message: 'Unknown message type' });\n        return;\n      }\n\n      const operation = parsed.operation as Operation;\n\n      // Validate operation type\n      if (operation.type !== 'insert' && operation.type !== 'delete') {\n        send(ws, { type: 'error', message: 'Invalid operation type' });\n        return;\n      }\n\n      // Get current state\n      const currentState = getDocState(docId);\n\n      // Validate operation bounds\n      if (!validateOperation(operation, currentState.content.length)) {\n        send(ws, { type: 'error', message: 'Operation out of bounds' });\n        return;\n      }\n\n      // If the client sent a version, transform the operation against\n      // operations that happened since that version\n      const clientVersion = typeof parsed.version === 'number' ? parsed.version : currentState.version;\n\n      let transformedOp = { ...operation } as Operation;\n\n      // Transform against all operations since the client's version\n      const opsSinceVersion = currentState.pendingOps.filter(\n        (_, i) => (currentState.version - currentState.pendingOps.length + i) > clientVersion\n      );\n\n      for (const priorOp of opsSinceVersion) {\n        transformedOp = transformOperation(transformedOp, priorOp);\n      }\n\n      // Apply the (possibly transformed) operation\n      const newContent = applyOperation(currentState.content, transformedOp);\n      const newVersion = currentState.version + 1;\n\n      // Update in-memory state\n      currentState.content = newContent;\n      currentState.version = newVersion;\n      currentState.pendingOps.push(transformedOp);\n\n      // Persist\n      updateDocumentContent(db, docId, newContent);\n      saveVersion(db, docId, newVersion, newContent, JSON.stringify(transformedOp));\n\n      // Acknowledge to sender\n      send(ws, { type: 'ack', version: newVersion });\n\n      // Broadcast to other clients in the room\n      broadcastToRoom(docId, { type: 'operation', operation: transformedOp }, client);\n    });\n\n    ws.on('close', () => {\n      room.delete(client);\n      removeActiveConnection(db, connId);\n    });\n  });\n\n  return wss;\n}\n\n"},"name":"Write","type":"tool_use"}],"id":"msg_q27_90","model":"qwopus-27b-mtp","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":477