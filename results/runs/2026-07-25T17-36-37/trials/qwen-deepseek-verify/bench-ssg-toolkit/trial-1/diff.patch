+{"type":"assistant","message":{"content":[{"id":"toolu_q27_282_0","input":{"file_path":"/workspace/src/plugins/rss-feed.ts","content":"import { Plugin, BuildContext, ContentFile } from '../core/types.js';\n\nfunction escapeXml(str: string): string {\n  return str\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&apos;');\n}\n\nfunction formatDate(dateStr: string): string {\n  const d = new Date(dateStr);\n  return d.toUTCString();\n}\n\nexport function createRssFeedPlugin(): Plugin {\n  return {\n    name: 'rss-feed',\n    version: '1.0.0',\n    dependencies: ['markdown-ext', 'taxonomy'],\n    hooks: {\n      afterBuild: (ctx: BuildContext) => {\n        const now = new Date().toUTCString();\n        const baseUrl = ctx.config.baseUrl;\n        const title = ctx.config.title;\n\n        // Get files sorted by date (newest first)\n        const files = [...ctx.files].sort((a, b) => {\n          const dateA = a.date ? new Date(a.date).getTime() : 0;\n          const dateB = b.date ? new Date(b.date).getTime() : 0;\n          return dateB - dateA;\n        });\n\n        // Get tag map for categories\n        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;\n\n        const items = files\n          .map((file) => {\n            const content = file.content;\n            const itemTags = file.tags || [];\n\n            let categories = '';\n            if (tagMap && itemTags.length > 0) {\n              for (const tag of itemTags) {\n                const normalized = tag.toLowerCase();\n                if (tagMap.has(normalized)) {\n                  categories += `<category>${escapeXml(normalized)}</category>\\n`;\n                }\n              }\n            }\n\n            const pubDate = file.date ? `<pubDate>${formatDate(file.date)}</pubDate>\\n` : '';\n\n            return `    <item>\n      <title>${escapeXml(file.title)}</title>\n      <link>${baseUrl}/${file.slug}.html</link>\n      <guid isPermaLink=\"true\">${baseUrl}/${file.slug}.html</guid>\n${pubDate}      <description><![CDATA[${content}]]></description>\n${categories}    </item>`;\n          })\n          .join('\\n\\n');\n\n        const feed = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rss version=\"2.0\">\n  <channel>\n    <title>${escapeXml(title)}</title>\n    <link>${baseUrl}</link>\n    <description>${escapeXml(title)}</description>\n    <lastBuildDate>${now}</lastBuildDate>\n${items}\n  </channel>\n</rss>`;\n\n        ctx.output.set('feed.xml', feed);\n      },\n    },\n  };\n}\n"},"name":"Write","type":"tool_use"}],"id":"msg_q27_282","model":"qwopus-27b-mtp","role":"assistant","stop_reason":null,"stop_sequence":null,"type":"message","usage":{"input_tokens":41695,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"43eb5763-18b8-440b-95b9-3b93933540f3","uuid":"4beb5885-3832-4bd1-a8e2-a48673f8fbc8"}
