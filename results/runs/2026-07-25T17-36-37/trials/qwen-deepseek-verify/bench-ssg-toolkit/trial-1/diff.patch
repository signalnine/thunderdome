ote.\\n[^2]: Second note.' });\n52\t    const result = await plugin.hooks.transformContent!(file, makeCtx());\n53\t    expect(result.content).toContain('<section class=\"footnotes\">');\n54\t    expect(result.content).toContain('<li id=\"fn-1\">First note.</li>');\n55\t    expect(result.content).toContain('<li id=\"fn-2\">Second note.</li>');\n56\t  });\n57\t\n58\t  it('converts :::note container to admonition div', async () => {\n59\t    const file = makeFile({ content: ':::note\\nThis is a note.\\n:::' });\n60\t    const result = await plugin.hooks.transformContent!(file, makeCtx());\n61\t    expect(result.content).toContain('<div class=\"admonition admonition-note\">');\n62\t    expect(result.content).toContain('This is a note.');\n63\t  });\n64\t\n65\t  it('converts :::warning container to admonition div', async () => {\n66\t    const file = makeFile({ content: ':::warning\\nBe careful!\\n:::' });\n67\t    const result = await plugin.hooks.transformContent!(file, makeCtx());\n68\t    expect(result.content).toContain('<div class=\"admonition admonition-warning\">');\n69\t    expect(result.content).toContain('Be careful!');\n70\t  });\n71\t\n72\t  it('converts :::tip container to admonition div', async () => {\n73\t    const file = makeFile({ content: ':::tip\\nHelpful hint.\\n:::' });\n74\t    const result = await plugin.hooks.transformContent!(file, makeCtx());\n75\t    expect(result.content).toContain('<div class=\"admonition admonition-tip\">');\n76\t    expect(result.content).toContain('Helpful hint.');\n77\t  });\n78\t\n79\t  it('preserves existing HTML in content', async () => {\n80\t    const file = makeFile({ content: '<div class=\"custom\">Already HTML</div>' });\n81\t    const result = await plugin.hooks.transformContent!(file, makeCtx());\n82\t    expect(result.content).toContain('Already HTML');\n83\t  });\n84\t\n85\t  it('handles empty content', async () => {\n86\t    const file = makeFile({ content: '' });\n87\t    const result = await plugin.hooks.