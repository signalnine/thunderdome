@@ -0,0 +1,40 @@
+import { Plugin, BuildContext } from '../core/types.js';
+
+function stripHtml(html: string): string {
+  // Remove HTML tags but keep text content
+  return html
+    .replace(/<[^>]+>/g, '')
+    .replace(/&nbsp;/g, ' ')
+    .replace(/&amp;/g, '&')
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;/g, "'")
+    .replace(/&apos;/g, "'")
+    .trim();
+}
+
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild: (ctx: BuildContext) => {
+        const entries = ctx.files.map((file) => {
+          const entry: Record<string, unknown> = {
+            slug: file.slug,
+            title: file.title,
+            content: stripHtml(file.content),
+          };
+          if (file.tags && file.tags.length > 0) {
+            entry.tags = file.tags;
+          }
+          return entry;
+        });
+
+        ctx.output.set('search-index.json', JSON.stringify(entries, null, 2));
+      },
+    },
+  };
+}
