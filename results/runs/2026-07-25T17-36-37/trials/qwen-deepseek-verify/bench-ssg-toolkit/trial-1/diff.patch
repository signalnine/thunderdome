@@ -0,0 +1,48 @@
+import { Plugin, BuildContext } from '../core/types.js';
+
+interface DevServerConfig {
+  port: number;
+  routes: Array<{ path: string; handler: string }>;
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild: (ctx: BuildContext) => {
+        const config: DevServerConfig = {
+          port: 3000,
+          routes: [],
+          assetPaths: [],
+          searchIndexPath: '',
+        };
+
+        // Collect content routes from output
+        for (const path of ctx.output.keys()) {
+          if (path === 'sitemap.xml' || path === 'feed.xml' || path === 'search-index.json') continue;
+          config.routes.push({ path: `/${path}`, handler: 'static' });
+        }
+
+        // Collect asset routes from asset manifest
+        const manifest = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;
+        if (manifest && manifest.assets.length > 0) {
+          config.assetPaths = [...manifest.assets];
+          for (const asset of manifest.assets) {
+            config.routes.push({ path: `/assets/${asset}`, handler: 'asset' });
+          }
+        }
+
+        // Set search index path if it exists
+        if (ctx.output.has('search-index.json')) {
+          config.searchIndexPath = '/search-index.json';
+        }
+
+        ctx.data.set('dev-server-config', config);
+      },
+    },
+  };
+}
