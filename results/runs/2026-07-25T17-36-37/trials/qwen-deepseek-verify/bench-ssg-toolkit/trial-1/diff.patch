+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,84 @@
+import { marked, MarkedOptions } from 'marked';
+import { Plugin, BuildContext, ContentFile } from '../core/types.js';
+
+function processMarkdown(content: string): string {
+  // Collect footnote definitions: [^1]: text
+  const footnoteRegex = /\[\^(\d+)\]:\s+(.+)$/gm;
+  const footnotes: { id: string; text: string }[] = [];
+  let match;
+  while ((match = footnoteRegex.exec(content)) !== null) {
+    footnotes.push({ id: match[1], text: match[2] });
+  }
+
+  // Remove footnote definitions from content before parsing
+  const contentWithoutDefs = content.replace(/\[\^(\d+)\]:\s+.+$/gm, '');
+
+  // Process admonition containers (:::type ... :::
+  const admonitionRegex = /:::([a-z]+)\n(.*?)\n:::/gs;
+  const admonitions: { type: string; text: string }[] = [];
+  let admonIdx = 0;
+
+  const contentWithAdmonitions = contentWithoutDefs.replace(admonitionRegex, (m, type, text) => {
+    const placeholder = `%%ADMONITION_${admonIdx}%%`;
+    admonitions.push({ type, text });
+    admonIdx++;
+    return placeholder;
+  });
+
+  // Configure marked with GFM
+  const options: MarkedOptions = {
+    gfm: true,
+    breaks: true,
+  };
+
+  // Parse the content
+  let html = marked.parse(contentWithAdmonitions, options) as string;
+
+  // Restore admonition containers
+  for (let i = 0; i < admonitions.length; i++) {
+    const { type, text } = admonitions[i];
+    const placeholder = `%%ADMONITION_${i}%%`;
+    const inner = marked.parse(text, options) as string;
+    html = html.replace(placeholder, `<div class="admonition admonition-${type}">${inner}</div>`);
+  }
+
+  // Process footnote references [^1] -> <sup><a href="#fn-1">1</a></sup>
+  html = html.replace(/\[\^(\d+)\]/g, '<sup><a href="#fn-$1">$1</a></sup>');
+
+  // If there are footnotes, append the footnote section
+  if (footnotes.length > 0) {
+    const footnoteItems = footnotes
+      .map((fn) => {
+        const inner = marked.parseInline(fn.text, options) as string;
+        return `<li id="fn-${fn.id}">${inner}</li>`;
+      })
+      .join('\n');
+    html += `<section class="footnotes"><ol>${footnoteItems}</ol></section>`;
+  }
+
+  return html;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, _ctx: BuildContext): ContentFile => {
+        // Only process if content looks like markdown (not already HTML)
+        const isMarkdown =
+          /\*\*|\[\^(\d+)\]|^:::[a-z]+\n/m.test(file.content) ||
+          !/<[a-z][^>]*>/i.test(file.content);
+
+        if (isMarkdown) {
+          return {
+            ...file,
+            content: processMarkdown(file.content),
+          };
+        }
+        return file;
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
