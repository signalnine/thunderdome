@@ -0,0 +1,49 @@
+import { Plugin, BuildContext, ContentFile } from '../core/types.js';
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext): ContentFile => {
+        // Rewrite relative URLs (./something) to /assets/something
+        // Match src="./..." and href="./..." separately to preserve the attribute name
+        const rewritten = file.content.replace(
+          /(src)="\.\/([^"\s]+)"/g,
+          (match, attr, filename) => {
+            let manifest = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;
+            if (!manifest) {
+              manifest = { assets: [] };
+              ctx.data.set('asset-manifest', manifest);
+            }
+            if (!manifest.assets.includes(filename)) {
+              manifest.assets.push(filename);
+            }
+            return `${attr}="/assets/${filename}"`;
+          }
+        );
+
+        const rewritten2 = rewritten.replace(
+          /(href)="\.\/([^"\s]+)"/g,
+          (match, attr, filename) => {
+            let manifest = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;
+            if (!manifest) {
+              manifest = { assets: [] };
+              ctx.data.set('asset-manifest', manifest);
+            }
+            if (!manifest.assets.includes(filename)) {
+              manifest.assets.push(filename);
+            }
+            return `${attr}="/assets/${filename}"`;
+          }
+        );
+
+        return {
+          ...file,
+          content: rewritten2,
+        };
+      },
+    },
+  };
+}
