ass=\"language-js\">let a = 1;</code></pre>' +\n56\t        '<p>Some text</p>' +\n57\t        '<pre><code class=\"language-py\">x = 2</code></pre>',\n58\t    });\n59\t    const result = await plugin.hooks.transformContent!(file, makeCtx());\n60\t    expect(result.content).toContain('data-language=\"js\"');\n61\t    expect(result.content).toContain('data-language=\"py\"');\n62\t  });\n63\t\n64\t  it('handles code block with no language specified', async () => {\n65\t    const file = makeFile({\n66\t      content: '<pre><code>plain code</code></pre>',\n67\t    });\n68\t    const result = await plugin.hooks.transformContent!(file, makeCtx());\n69\t    // Should not add highlighted class or data-language to blocks without language\n70\t    expect(result.content).toBe('<pre><code>plain code</code></pre>');\n71\t    expect(result.content).not.toContain('highlighted');\n72\t  });\n73\t\n74\t  it('adds highlighted class to processed blocks', async () => {\n75\t    const file = makeFile({\n76\t      content: '<pre><code class=\"language-rust\">fn main() {}</code></pre>',\n77\t    });\n78\t    const result = await plugin.hooks.transformContent!(file, makeCtx());\n79\t    expect(result.content).toContain('highlighted');\n80\t  });\n81\t\n82\t  it('preserves code block content', async () => {\n83\t    const file = makeFile({\n84\t      content: '<pre><code class=\"language-ts\">const x: number = 42;</code></pre>',\n85\t    });\n86\t    const result = await plugin.hooks.transformContent!(file, makeCtx());\n87\t    expect(result.content).toContain('const x: number = 42;');\n88\t  });\n89\t\n90\t  it('handles empty code blocks', async () => {\n91\t    const file = makeFile({\n92\t      content: '<pre><code class=\"language-js\"></code></pre>',\n93\t    });\n94\t    const result = await plugin.hooks.transformContent!(file, makeCtx());\n95\t    expect(result.content).toContain('data-language=\"js\"');\n96\t    expect(result.content).toContain('highlighted');\n97\t  });\n98\t\n99\t  