+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_q27_128_3","type":"tool_result","content":"1\t/**\n2\t * Authentication middleware using core permissions.\n3\t */\n4\t\n5\timport type { Request, Response, NextFunction } from 'express';\n6\timport { hasPermission, type Role, type Permission } from '@monorepo/core';\n7\t\n8\t/**\n9\t * Basic auth middleware that checks for a token header.\n10\t * In this benchmark, we use a simplified mock auth system.\n11\t */\n12\texport function authMiddleware(\n13\t  req: Request,\n14\t  res: Response,\n15\t  next: NextFunction\n16\t): void {\n17\t  const token = req.headers['authorization']?.replace('Bearer ', '');\n18\t\n19\t  // Allow requests with valid mock tokens or role headers\n20\t  if (token?.startsWith('mock-token-') || req.headers['x-user-role']) {\n21\t    next();\n22\t    return;\n23\t  }\n24\t\n25\t  res.status(401).json({ error: 'Authentication required' });\n26\t}\n27\t\n28\t/**\n29\t * Middleware factory to require a specific permission.\n30\t */\n31\texport function requirePermissionMiddleware(permission: Permission) {\n32\t  return (req: Request, res: Response, next: NextFunction): void => {\n33\t    const role = (req.headers['x-user-role'] as Role) || 'viewer';\n34\t\n35\t    if (!hasPermission(role, permission)) {\n36\t      res.status(403).json({\n37\t        error: `Permission '${permission}' required`,\n38\t      });\n39\t      return;\n40\t    }\n41\t\n42\t    next();\n43\t  };\n44\t}\n45\t"}]},"parent_tool_use_id":null,"session_id":"03ad1105-0fbc-44b5-8e65-e9071188429f","uuid":"13bbd9ec-2640-494a-849f-9bf00a1eefdc","timestamp":"2026-07-25T17:57:07.348Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/packages/api/src/middleware/auth.ts","content":"/**\n * Authentication middleware using core permissions.\n */\n\nimport type { Request, Response, NextFunction } from 'express';\nimport { hasPermission, type Role, type Permission } from '@monorepo/core';\n\n/**\n * Basic auth middleware that checks for a token header.\n * In this benchmark, we use a simplified mock auth system.\n */\nexport function authMiddleware(\n  req: Request,\n  res: Response,\n  next: NextFunction\n): void {\n  const token = req.headers['authorization']?.replace('Bearer ', '');\n\n  // Allow requests with valid mock tokens or role headers\n  if (token?.startsWith('mock-token-') || req.headers['x-user-role']) {\n    next();\n    return;\n  }\n\n  res.status(401).json({ error: 'Authentication required' });\n}\n\n/**\n * Middleware factory to require a specific permission.\n */\nexport function requirePermissionMiddleware(permission: Permission) {\n  return (req: Request, res: Response, next: NextFunction): void => {\n    const role = (req.headers['x-user-role'] as Role) || 'viewer';\n\n    if (!hasPermission(role, permission)) {\n      res.status(403).json({\n        error: `Permission '${permission}' required`,\n      });\n      return;\n    }\n\n    next();\n  };\n}\n","numLines":45,"startLine":1,"totalLines":45}}}
