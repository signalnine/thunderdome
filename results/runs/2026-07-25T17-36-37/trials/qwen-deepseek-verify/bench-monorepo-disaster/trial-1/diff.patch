+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_q27_128_8","type":"tool_result","content":"1\t/**\n2\t * Cleanup job.\n3\t * Removes stale data and performs maintenance tasks.\n4\t */\n5\t\n6\timport { getAllUsers } from '@monorepo/core';\n7\t\n8\texport interface CleanupResult {\n9\t  staleRecords: number;\n10\t  cleanedUp: number;\n11\t  duration: number;\n12\t}\n13\t\n14\texport async function cleanupJob(): Promise<CleanupResult> {\n15\t  const startTime = Date.now();\n16\t\n17\t  // Get all users to check for stale records\n18\t  const users = getAllUsers();\n19\t\n20\t  let staleRecords = 0;\n21\t  let cleanedUp = 0;\n22\t\n23\t  for (const user of users) {\n24\t    const createdDate = new Date(user.createdAt);\n25\t    const now = new Date();\n26\t    const daysSinceCreation =\n27\t      (now.getTime() - createdDate.getTime()) / (1000 * 60 * 60 * 24);\n28\t\n29\t    // Mark records older than 365 days as stale (simulation)\n30\t    if (daysSinceCreation > 365) {\n31\t      staleRecords++;\n32\t      // In a real app, we'd archive or delete\n33\t      cleanedUp++;\n34\t    }\n35\t  }\n36\t\n37\t  const duration = Date.now() - startTime;\n38\t\n39\t  console.log(\n40\t    `Cleanup complete: ${staleRecords} stale, ${cleanedUp} cleaned in ${duration}ms`\n41\t  );\n42\t\n43\t  return { staleRecords, cleanedUp, duration };\n44\t}\n45\t\n46\texport function getCleanupThresholdDays(): number {\n47\t  return 365;\n48\t}\n49\t"}]},"parent_tool_use_id":null,"session_id":"03ad1105-0fbc-44b5-8e65-e9071188429f","uuid":"f2b26b4e-f592-4b87-812f-775b289a535e","timestamp":"2026-07-25T17:57:07.844Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/packages/worker/src/jobs/cleanup.ts","content":"/**\n * Cleanup job.\n * Removes stale data and performs maintenance tasks.\n */\n\nimport { getAllUsers } from '@monorepo/core';\n\nexport interface CleanupResult {\n  staleRecords: number;\n  cleanedUp: number;\n  duration: number;\n}\n\nexport async function cleanupJob(): Promise<CleanupResult> {\n  const startTime = Date.now();\n\n  // Get all users to check for stale records\n  const users = getAllUsers();\n\n  let staleRecords = 0;\n  let cleanedUp = 0;\n\n  for (const user of users) {\n    const createdDate = new Date(user.createdAt);\n    const now = new Date();\n    const daysSinceCreation =\n      (now.getTime() - createdDate.getTime()) / (1000 * 60 * 60 * 24);\n\n    // Mark records older than 365 days as stale (simulation)\n    if (daysSinceCreation > 365) {\n      staleRecords++;\n      // In a real app, we'd archive or delete\n      cleanedUp++;\n    }\n  }\n\n  const duration = Date.now() - startTime;\n\n  console.log(\n    `Cleanup complete: ${staleRecords} stale, ${cleanedUp} cleaned in ${duration}ms`\n  );\n\n  return { staleRecords, cleanedUp, duration };\n}\n\nexport function getCleanupThresholdDays(): number {\n  return 365;\n}\n","numLines":49,"startLine":1,"totalLines":49}}}
