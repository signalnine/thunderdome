+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_q27_130_6","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach } from 'vitest';\n2\timport { Scheduler } from '../src/scheduler.js';\n3\t\n4\tdescribe('Scheduler', () => {\n5\t  let scheduler: Scheduler;\n6\t\n7\t  beforeEach(() => {\n8\t    scheduler = new Scheduler();\n9\t  });\n10\t\n11\t  it('registers a job', () => {\n12\t    scheduler.register('test', () => {}, 1000);\n13\t    const status = scheduler.getStatus();\n14\t    expect(status).toHaveLength(1);\n15\t    expect(status[0].name).toBe('test');\n16\t  });\n17\t\n18\t  it('runs a job once', async () => {\n19\t    let ran = false;\n20\t    scheduler.register('test', () => { ran = true; }, 1000);\n21\t    await scheduler.runOnce('test');\n22\t    expect(ran).toBe(true);\n23\t  });\n24\t\n25\t  it('tracks run count', async () => {\n26\t    scheduler.register('test', () => {}, 1000);\n27\t    await scheduler.runOnce('test');\n28\t    await scheduler.runOnce('test');\n29\t    const status = scheduler.getStatus();\n30\t    expect(status[0].runCount).toBe(2);\n31\t  });\n32\t\n33\t  it('throws for unknown job', async () => {\n34\t    await expect(scheduler.runOnce('nonexistent')).rejects.toThrow(\n35\t      \"Job 'nonexistent' not found\"\n36\t    );\n37\t  });\n38\t\n39\t  it('starts and stops', () => {\n40\t    scheduler.register('test', () => {}, 60000);\n41\t    scheduler.start();\n42\t    expect(scheduler.isRunning()).toBe(true);\n43\t    scheduler.stop();\n44\t    expect(scheduler.isRunning()).toBe(false);\n45\t  });\n46\t});\n47\t"}]},"parent_tool_use_id":null,"session_id":"03ad1105-0fbc-44b5-8e65-e9071188429f","uuid":"d6c57ffb-2609-4fe9-a1df-d6566cfb4aeb","timestamp":"2026-07-25T17:57:21.796Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/packages/worker/tests/scheduler.test.ts","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { Scheduler } from '../src/schedule