 catch (err) {\n66\t    if (err instanceof Error && err.message.includes('UNIQUE')) {\n67\t      res.status(409).json({ error: 'Email already exists' });\n68\t      return;\n69\t    }\n70\t    res.status(500).json({ error: 'Failed to create user' });\n71\t  }\n72\t});\n73\t\n74\t// Delete user by ID\n75\tusersRouter.delete('/:id', (req: Request, res: Response) => {\n76\t  try {\n77\t    const callerRole = (req.headers['x-user-role'] as Role) || 'viewer';\n78\t    if (!canManageUsers(callerRole)) {\n79\t      res.status(403).json({ error: 'Insufficient permissions' });\n80\t      return;\n81\t    }\n82\t\n83\t    const validation = validateUserId(req.params['id']!);\n84\t    if (!validation.success) {\n85\t      res.status(400).json({ errors: validation.errors });\n86\t      return;\n87\t    }\n88\t\n89\t    const user = getUserById(validation.data!);\n90\t    if (!user) {\n91\t      res.status(404).json({ error: 'User not found' });\n92\t      return;\n93\t    }\n94\t\n95\t    // In a real app, we'd delete here\n96\t    res.status(200).json({ message: 'User deleted', user });\n97\t  } catch (err) {\n98\t    res.status(500).json({ error: 'Failed to delete user' });\n99\t  }\n100\t});\n101\t"}]},"parent_tool_use_id":null,"session_id":"f76988f4-0b74-440a-b4af-1cfd74b87692","uuid":"3e05b430-93c8-4c64-a68d-776aeeac34aa","timestamp":"2026-07-25T18:20:36.925Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/packages/api/src/routes/users.ts","content":"/**\n * User CRUD routes.\n */\n\nimport { Router, type Request, type Response } from 'express';\nimport {\n  registerUser,\n  getUserById,\n  getAllUsers,\n  validateCreateUser,\n  validateUserId,\n  canManageUsers,\n  type Role,\n} from '@monorepo/core';\n\nexport const usersRouter = Router();\n\n// List all users\nusersRouter.get('/', (_req: Request, res: Response) => {\n  try {\n    const users = getAllUsers();\n    res.json({ users });\n  } catch (err) {\n    res.status(500).json({ error: 'Failed to fetch users' });\n  }\n});\n\n// Get user by ID\nusersRouter.get('/:id', (req: Request, res: Response) => {\n  try {\n    const validation = validateUserId(req.params['id']!);\n    if (!validation.success) {\n      res.status(400).json({ errors: validation.errors });\n      return;\n    }\n\n    const user = getUserById(validation.data!);\n    if (!user) {\n      res.status(404).json({ error: 'User not found' });\n      return;\n    }\n    res.json({ user });\n  } catch (err) {\n    res.status(500).json({ error: 'Failed to fetch user' });\n  }\n});\n\n// Create a new user\nusersRouter.post('/', (req: Request, res: Response) => {\n  try {\n    const callerRole = (req.headers['x-user-role'] as Role) || 'viewer';\n    if (!canManageUsers(callerRole)) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    const validation = validateCreateUser(req.body);\n    if (!validation.success) {\n      res.status(400).json({ errors: validation.errors });\n      return;\n    }\n\n    const user = registerUser(req.body);\n    res.status(201).json({ user });\n  } catch (err) {\n    if (err instanceof Error && err.message.includes('UNIQUE')) {\n      res.status(409).json({ error: 'Email already exists' });\n      return;\n    }\n    res.status(500).json({ error: 'Failed to create user' });\n  }\n});\n\n// Delete user by ID\nusersRouter.delete('/:id', (req: Request, res: Response) => {\n  try {\n    const callerRole = (req.headers['x-user-role'] as Role) || 'viewer';\n    if (!canManageUsers(callerRole)) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    const validation = validateUserId(req.params['id']!);\n    if (!validation.success) {\n      res.status(400).json({ errors: validation.errors });\n      return;\n    }\n\n    const user = getUserById(validation.data!);\n    if (!user) {\n      res.status(404).json({ error: 'User not found' });\n      return;\n    }\n\n    // In a real app, we'd delete here\n    res.status(200).json({ message: 'User deleted', user });\n  } catch (err) {\n    res.status(500).json({ error: 'Failed to delete user' });\n  }\n});\n","numLines":101,"startLine":1,"totalLines":101}}}
