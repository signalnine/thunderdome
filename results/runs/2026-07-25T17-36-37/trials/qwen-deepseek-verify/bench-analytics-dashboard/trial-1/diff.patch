mestamp, user_id, session_id });\n  } catch (e) {\n    next(e);\n  }\n});\n\n// POST /events/batch - Ingest multiple events\nrouter.post('/batch', (req: Request, res: Response, next: NextFunction) => {\n  try {\n    const authUser = (req as Record<string, unknown>).user as { id: string; tenantId: string };\n    const { events } = req.body;\n\n    if (!events || !Array.isArray(events) || events.length === 0) {\n      throw new AppError('VALIDATION_ERROR', 'Events array is required and must not be empty');\n    }\n\n    const tenant_id = authUser.tenantId;\n    const db = getDb();\n    const stmt = db.prepare(\n      'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'\n    );\n\n    const insertedEvents: Array<Record<string, unknown>> = [];\n\n    const insert = db.transaction(() => {\n      for (const event of events) {\n        const { name, properties, timestamp, user_id, session_id } = event;\n        const id = uuidv4();\n        const eventTimestamp = timestamp || new Date().toISOString();\n        const props = properties || {};\n\n        stmt.run(id, tenant_id, name, JSON.stringify(props), eventTimestamp, user_id || null, session_id || null);\n        insertedEvents.push({ id, tenant_id, name, properties: props, timestamp: eventTimestamp, user_id, session_id });\n      }\n    });\n\n    insert();\n\n    res.status(201).json({ inserted: insertedEvents.length, events: insertedEvents });\n  } catch (e) {\n    next(e);\n  }\n});\n\nexport default router;\n","structuredPatch":[{"oldStart":8,"oldLines":7,"newStart":8,"newLines":7,"lines":[" // POST /events - Ingest a single event"," router.post('/', (req: Request, res: Response, next: NextFunction) => {","   try {","-    const authUser = (req as Record<string, unknown>).user as { id: string; tenantId: string };","+    const authUser = (req as unknown as Record<string, unknown>).user as { id: string; tenantId: string };","     const { name, properties, 