ld list dashboards for tenant', async () => {\n55\t    const app = createTestApp('user1', 'tenant1');\n56\t    await request(app).post('/dashboards').send({ name: 'Dash 1' });\n57\t    await request(app).post('/dashboards').send({ name: 'Dash 2' });\n58\t\n59\t    const res = await request(app).get('/dashboards');\n60\t\n61\t    expect(res.status).toBe(200);\n62\t    expect(res.body).toHaveLength(2);\n63\t  });\n64\t\n65\t  it('should get dashboard by id with widgets', async () => {\n66\t    const app = createTestApp('user1', 'tenant1');\n67\t    const createRes = await request(app)\n68\t      .post('/dashboards')\n69\t      .send({ name: 'Dash' });\n70\t    const dashId = createRes.body.id;\n71\t\n72\t    const res = await request(app).get(`/dashboards/${dashId}`);\n73\t\n74\t    expect(res.status).toBe(200);\n75\t    expect(res.body.name).toBe('Dash');\n76\t    expect(res.body.widgets).toBeInstanceOf(Array);\n77\t  });\n78\t\n79\t  it('should update a dashboard', async () => {\n80\t    const app = createTestApp('user1', 'tenant1');\n81\t    const createRes = await request(app)\n82\t      .post('/dashboards')\n83\t      .send({ name: 'Old Name' });\n84\t    const dashId = createRes.body.id;\n85\t\n86\t    const res = await request(app)\n87\t      .patch(`/dashboards/${dashId}`)\n88\t      .send({ name: 'New Name' });\n89\t\n90\t    expect(res.status).toBe(200);\n91\t    expect(res.body.name).toBe('New Name');\n92\t  });\n93\t\n94\t  it('should delete a dashboard', async () => {\n95\t    const app = createTestApp('user1', 'tenant1');\n96\t    const createRes = await request(app)\n97\t      .post('/dashboards')\n98\t      .send({ name: 'To Delete' });\n99\t    const dashId = createRes.body.id;\n100\t\n101\t    const res = await request(app).delete(`/dashboards/${dashId}`);\n102\t    expect(res.status).toBe(204);\n103\t\n104\t    const getRes = await request(app).get(`/dashboards/${dashId}`);\n105\t    expect(getRes.status).toBe(404);\n106\t  });\n107\t\n108\t  it('should add a widget to a dashboard', async () => {\n109\t    const app = createTestApp('user1', 'tenant1');\n110\t    const createRes = await request(app)\n111\t      .post('/dashboards')\n112\t      .send({ name: 'Widget Dash' });\n113\t    const dashId = createRes.body.id;\n114\t\n115\t    const res = await request(app)\n116\t      .post(`/dashboards/${dashId}/widgets`)\n117\t      .send({\n118\t        type: 'counter',\n119\t        config: { event_name: 'page_view' },\n120\t        position_x: 0,\n121\t        position_y: 0,\n122\t        width: 2,\n123\t        height: 1,\n124\t      });\n125\t\n126\t    expect(res.status).toBe(201);\n127\t    expect(res.body.type).toBe('counter');\n128\t    expect(res.body.dashboard_id).toBe(dashId);\n129\t  });\n130\t});\n131\t"}]},"parent_tool_use_id":"toolu_q27_231_0","session_id":"9714418b-1780-40e8-918b-39371c875678","uuid":"97726965-0d08-43a8-8add-90467ffaac1a","timestamp":"2026-07-25T18:25:28.476Z","subagent_type":"general-purpose","task_description":"Read schema and project files"}
