+++ b/src/query/router.ts
@@ -0,0 +1,156 @@
+import { Router, Request, Response, NextFunction } from 'express';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const router = Router();
+
+function getAuthUser(req: Request): { id: string; tenantId: string } {
+  return (req as unknown as Record<string, unknown>).user as { id: string; tenantId: string };
+}
+
+// POST /query/count - Count events matching filter
+router.post('/count', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = getAuthUser(req);
+    const { event_name, start, end } = req.body;
+
+    if (!event_name) {
+      throw new AppError('VALIDATION_ERROR', 'event_name is required');
+    }
+
+    const db = getDb();
+    let query = 'SELECT COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?';
+    const params: Array<string> = [authUser.tenantId, event_name];
+
+    if (start) {
+      query += ' AND timestamp >= ?';
+      params.push(start);
+    }
+    if (end) {
+      query += ' AND timestamp <= ?';
+      params.push(end);
+    }
+
+    const result = db.prepare(query).get(...params) as { count: number };
+    res.status(200).json({ count: result.count });
+  } catch (e) {
+    next(e);
+  }
+});
+
+// POST /query/timeseries - Time-bucketed event counts
+router.post('/timeseries', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = getAuthUser(req);
+    const { event_name, bucket } = req.body;
+
+    if (!event_name) {
+      throw new AppError('VALIDATION_ERROR', 'event_name is required');
+    }
+
+    const db = getDb();
+
+    let bucketExpr: string;
+    switch (bucket) {
+      case 'hour':
+        bucketExpr = "strftime('%Y-%m-%dT%H:00:00Z', timestamp)";
+        break;
+      case 'day':
+        bucketExpr = "strftime('%Y-%m-%dT00:00:00Z', timestamp)";
+        break;
+      case 'week':
+        bucketExpr = "strftime('%Y-W%W', timestamp)";
+        break;
+      case 'month':
+        bucketExpr = "strftime('%Y-%m', timestamp)";
+        break;
+      default:
+        bucketExpr = "strftime('%Y-%m-%dT00:00:00Z', timestamp)";
+    }
+
+    const rows = db.prepare(
+      `SELECT ${bucketExpr} as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ? GROUP BY bucket ORDER BY bucket`
+    ).all(authUser.tenantId, event_name) as Array<{ bucket: string; count: number }>;
+
+    res.status(200).json({ data: rows });
+  } catch (e) {
+    next(e);
+  }
+});
+
+// POST /query/breakdown - Event counts grouped by property
+router.post('/breakdown', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = getAuthUser(req);
+    const { event_name, property_key } = req.body;
+
+    if (!event_name) {
+      throw new AppError('VALIDATION_ERROR', 'event_name is required');
+    }
+
+    const db = getDb();
+
+    // Extract a JSON property value using json_extract
+    const rows = db.prepare(
+      `SELECT json_extract(properties, '$.' || ?) as property_value, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ? GROUP BY property_value ORDER BY count DESC`
+    ).all(property_key, authUser.tenantId, event_name) as Array<{ property_value: string; count: number }>;
+
+    res.status(200).json({ data: rows });
+  } catch (e) {
+    next(e);
+  }
+});
+
+// POST /query/funnel - Multi-step funnel analysis
+router.post('/funnel', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = getAuthUser(req);
+    const { steps } = req.body;
+
+    if (!steps || !Array.isArray(steps) || steps.length === 0) {
+      throw new AppError('VALIDATION_ERROR', 'steps array is required');
+    }
+
+    const db = getDb();
+    const result: Array<{ step: string; count: number }> = [];
+
+    // Funnel: for each step, count distinct session_ids that have had all previous steps
+    for (let i = 0; i < steps.length; i++) {
+      const eventName = steps[i];
+
+      if (i === 0) {
+        // First step: count distinct sessions with this event
+        const row = db.prepare(
+          `SELECT COUNT(DISTINCT session_id) as count FROM events WHERE tenant_id = ? AND name = ? AND session_id IS NOT NULL`
+        ).get(authUser.tenantId, eventName) as { count: number };
+        result.push({ step: eventName, count: row.count });
+      } else {
+        // Subsequent steps: count distinct sessions that have this event AND all previous events
+        const previousSteps = steps.slice(0, i);
+        const placeholders = previousSteps.map(() => '?').join(', ');
+        const query = `
+          SELECT COUNT(DISTINCT e.session_id) as count
+          FROM events e
+          WHERE e.tenant_id = ?
+            AND e.name = ?
+            AND e.session_id IS NOT NULL
+            AND e.session_id IN (
+              SELECT session_id FROM events
+              WHERE tenant_id = ? AND name IN (${placeholders}) AND session_id IS NOT NULL
+              GROUP BY session_id
+              HAVING COUNT(DISTINCT name) = ?
+            )
+        `;
+        const params = [authUser.tenantId, eventName, authUser.tenantId, ...previousSteps, previousSteps.length];
+        const row = db.prepare(query).get(...params) as { count: number };
+        result.push({ step: eventName, count: row.count });
+      }
+    }
+
+    res.status(200).json({ steps: result });
+  } catch (e) {
+    next(e);
+  }
+});
+
+export default router;
