diff --git a/src/app.ts b/src/app.ts
new file mode 100644
index 0000000..183ed76
--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,75 @@
+import express from 'express';
+import jwt from 'jsonwebtoken';
+import { createMainDb } from './db';
+import { errorHandler } from './errors';
+import { publicRouter as usersPublicRouter, authRouter as usersAuthRouter } from './users/router';
+import ingestRouter from './ingest/router';
+import queryRouter from './query/router';
+import dashboardsRouter from './dashboards/router';
+import exportRouter from './export/router';
+
+const JWT_SECRET = process.env.JWT_SECRET || 'analytics-dashboard-secret';
+
+function authMiddleware(
+  req: express.Request,
+  _res: express.Response,
+  next: express.NextFunction
+): void {
+  const authHeader = req.headers.authorization;
+
+  if (!authHeader || !authHeader.startsWith('Bearer ')) {
+    const err = new Error('AUTH_ERROR');
+    err.message = 'AUTH_ERROR';
+    next(err);
+    return;
+  }
+
+  const token = authHeader.slice(7);
+
+  try {
+    const decoded = jwt.verify(token, JWT_SECRET) as { sub: string; tid: string };
+    (req as unknown as Record<string, unknown>).user = { id: decoded.sub, tenantId: decoded.tid };
+    next();
+  } catch {
+    const err = new Error('AUTH_ERROR');
+    err.message = 'AUTH_ERROR';
+    next(err);
+  }
+}
+
+export function createApp(): express.Application {
+  const app = express();
+
+  // Initialize database
+  const _db = createMainDb();
+
+  app.use(express.json());
+
+  // Public user routes (register, login) - before auth middleware
+  app.use('/users', usersPublicRouter);
+
+  // Authenticated routes
+  app.use(authMiddleware);
+  // Auth-protected user routes (me, role change)
+  app.use('/users', usersAuthRouter);
+  app.use('/events', ingestRouter);
+  app.use('/query', queryRouter);
+  app.use('/dashboards', dashboardsRouter);
+  app.use('/export', exportRouter);
+
+  // Error handler
+  app.use(errorHandler);
+
+  return app;
+}
+
+// Start server if run directly
+if (require.main === module) {
+  const app = createApp();
+  const PORT = process.env.PORT || 3000;
+  app.listen(PORT, () => {
+    console.log(`Server running on port ${PORT}`);
+  });
+}
+
+export default createApp;
diff --git a/src/dashboards/router.ts b/src/dashboards/router.ts
new file mode 100644
index 0000000..c33e628
--- /dev/null
+++ b/src/dashboards/router.ts
@@ -0,0 +1,219 @@
+import { Router, Request, Response, NextFunction } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const router = Router();
+
+function getAuthUser(req: Request): { id: string; tenantId: string } {
+  return (req as unknown as Record<string, unknown>).user as { id: string; tenantId: string };
+}
+
+// POST /dashboards - Create dashboard
+router.post('/', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = getAuthUser(req);
+    const { name, config } = req.body;
+
+    if (!name) {
+      throw new AppError('VALIDATION_ERROR', 'Dashboard name is required');
+    }
+
+    const id = uuidv4();
+    const tenant_id = authUser.tenantId;
+    const owner_id = authUser.id;
+    const cfg = config || {};
+
+    const db = getDb();
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, tenant_id, name, owner_id, JSON.stringify(cfg));
+
+    res.status(201).json({ id, tenant_id, name, owner_id, config: cfg });
+  } catch (e) {
+    next(e);
+  }
+});
+
+// GET /dashboards - List dashboards for tenant
+router.get('/', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = getAuthUser(req);
+    const db = getDb();
+    const rows = db.prepare(
+      'SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC'
+    ).all(authUser.tenantId) as Array<Record<string, unknown>>;
+
+    // Parse config JSON
+    for (const row of rows) {
+      if (typeof row.config === 'string') {
+        row.config = JSON.parse(row.config);
+      }
+    }
+
+    res.status(200).json(rows);
+  } catch (e) {
+    next(e);
+  }
+});
+
+// GET /dashboards/:id - Get dashboard by id with widgets
+router.get('/:id', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = getAuthUser(req);
+    const db = getDb();
+
+    const dashboard = db.prepare(
+      'SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE id = ? AND tenant_id = ?'
+    ).get(req.params.id, authUser.tenantId) as
+      | { id: string; tenant_id: string; name: string; owner_id: string; config: string; created_at: string; updated_at: string }
+      | undefined;
+
+    if (!dashboard) {
+      throw new AppError('NOT_FOUND');
+    }
+
+    const widgets = db.prepare(
+      'SELECT id, dashboard_id, type, config, position_x, position_y, width, height FROM widgets WHERE dashboard_id = ? ORDER BY position_y, position_x'
+    ).all(req.params.id) as Array<Record<string, unknown>>;
+
+    for (const w of widgets) {
+      if (typeof w.config === 'string') {
+        w.config = JSON.parse(w.config);
+      }
+    }
+
+    if (typeof dashboard.config === 'string') {
+      dashboard.config = JSON.parse(dashboard.config);
+    }
+
+    res.status(200).json({ ...dashboard, widgets });
+  } catch (e) {
+    next(e);
+  }
+});
+
+// PATCH /dashboards/:id - Update dashboard
+router.patch('/:id', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = getAuthUser(req);
+    const { name, config } = req.body;
+    const db = getDb();
+
+    const existing = db.prepare(
+      'SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?'
+    ).get(req.params.id, authUser.tenantId);
+
+    if (!existing) {
+      throw new AppError('NOT_FOUND');
+    }
+
+    const updates: string[] = [];
+    const params: Array<unknown> = [];
+
+    if (name !== undefined) {
+      updates.push('name = ?');
+      params.push(name);
+    }
+    if (config !== undefined) {
+      updates.push('config = ?');
+      params.push(JSON.stringify(config));
+    }
+
+    if (updates.length > 0) {
+      updates.push("updated_at = datetime('now')");
+      params.push(req.params.id, authUser.tenantId);
+      db.prepare(`UPDATE dashboards SET ${updates.join(', ')} WHERE id = ? AND tenant_id = ?`).run(...params);
+    }
+
+    const updated = db.prepare(
+      'SELECT id, tenant_id, name, owner_id, config, created_at, updated_at FROM dashboards WHERE id = ?'
+    ).get(req.params.id) as { id: string; tenant_id: string; name: string; owner_id: string; config: string; created_at: string; updated_at: string };
+
+    if (typeof updated.config === 'string') {
+      updated.config = JSON.parse(updated.config);
+    }
+
+    res.status(200).json(updated);
+  } catch (e) {
+    next(e);
+  }
+});
+
+// DELETE /dashboards/:id - Delete dashboard
+router.delete('/:id', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = getAuthUser(req);
+    const db = getDb();
+
+    const existing = db.prepare(
+      'SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?'
+    ).get(req.params.id, authUser.tenantId);
+
+    if (!existing) {
+      throw new AppError('NOT_FOUND');
+    }
+
+    db.prepare('DELETE FROM dashboards WHERE id = ? AND tenant_id = ?').run(req.params.id, authUser.tenantId);
+    res.status(204).send();
+  } catch (e) {
+    next(e);
+  }
+});
+
+// POST /dashboards/:id/widgets - Add widget
+router.post('/:id/widgets', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = getAuthUser(req);
+    const { type, config, position_x, position_y, width, height } = req.body;
+
+    if (!type) {
+      throw new AppError('VALIDATION_ERROR', 'Widget type is required');
+    }
+
+    const db = getDb();
+
+    // Verify dashboard exists and belongs to tenant
+    const dashboard = db.prepare(
+      'SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?'
+    ).get(req.params.id, authUser.tenantId);
+
+    if (!dashboard) {
+      throw new AppError('NOT_FOUND');
+    }
+
+    const id = uuidv4();
+    const cfg = config || {};
+
+    db.prepare(
+      'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+    ).run(id, req.params.id, type, JSON.stringify(cfg), position_x ?? 0, position_y ?? 0, width ?? 1, height ?? 1);
+
+    res.status(201).json({ id, dashboard_id: req.params.id, type, config: cfg, position_x: position_x ?? 0, position_y: position_y ?? 0, width: width ?? 1, height: height ?? 1 });
+  } catch (e) {
+    next(e);
+  }
+});
+
+// DELETE /dashboards/:id/widgets/:widgetId - Delete widget
+router.delete('/:id/widgets/:widgetId', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = getAuthUser(req);
+    const db = getDb();
+
+    const dashboard = db.prepare(
+      'SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?'
+    ).get(req.params.id, authUser.tenantId);
+
+    if (!dashboard) {
+      throw new AppError('NOT_FOUND');
+    }
+
+    db.prepare('DELETE FROM widgets WHERE id = ? AND dashboard_id = ?').run(req.params.widgetId, req.params.id);
+    res.status(204).send();
+  } catch (e) {
+    next(e);
+  }
+});
+
+export default router;
