zation', `Bearer ${tokenB}`);\n515\t\n516\t    expect(dashExportRes.status).toBe(404);\n517\t  });\n518\t});\n519\t\n520\t// Helper function to register a user and return their JWT token\n521\tasync function registerAndLogin(\n522\t  app: ReturnType<typeof createApp>,\n523\t  email: string,\n524\t  password: string,\n525\t  tenantId: string\n526\t): Promise<string> {\n527\t  await request(app)\n528\t    .post('/users')\n529\t    .send({ email, password, tenant_id: tenantId });\n530\t\n531\t  const loginRes = await request(app)\n532\t    .post('/users/login')\n533\t    .send({ email, password });\n534\t\n535\t  return loginRes.body.token;\n536\t}\n537\t"}]},"parent_tool_use_id":null,"session_id":"9714418b-1780-40e8-918b-39371c875678","uuid":"2b9641e1-28cd-4fe5-b19d-4822635ee544","timestamp":"2026-07-25T18:25:46.929Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/tests/integration.test.ts","content":"import { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport request from 'supertest';\nimport jwt from 'jsonwebtoken';\nimport Database from 'better-sqlite3';\nimport { createApp } from '../src/app';\nimport { setDb, createTestDb, closeDb } from '../src/db';\n\nconst TENANT_A = 'tenant-a';\nconst TENANT_B = 'tenant-b';\n\ndescribe('Integration Tests', () => {\n  let app: ReturnType<typeof createApp>;\n  let db: Database.Database;\n\n  beforeEach(() => {\n    db = createTestDb();\n    setDb(db);\n    app = createApp();\n  });\n\n  afterEach(() => {\n    closeDb();\n  });\n\n  // --- Register + Login Flow (2 tests) ---\n\n  it('should register a user and login successfully', async () => {\n    const regRes = await request(app)\n      .post('/users')\n      .send({ email: 'alice@test.com', password: 'secret123', tenant_id: TENANT_A });\n\n    expect(regRes.status).toBe(201);\n    expect(regRes.body.email).toBe('alice@test.com');\n\n    const loginRes = await request(app)\n      .post('/users/login')\n      .send({ email: 'alice@test.com', password: 'secret123' });\n\n    expect(loginRes.status).toBe(200);\n    expect(loginRes.body).toHaveProperty('token');\n    expect(loginRes.body.user.email).toBe('alice@test.com');\n  });\n\n  it('should return JWT with correct shape {sub, tid, iat, exp}', async () => {\n    await request(app)\n      .post('/users')\n      .send({ email: 'jwt@test.com', password: 'secret123', tenant_id: TENANT_A });\n\n    const loginRes = await request(app)\n      .post('/users/login')\n      .send({ email: 'jwt@test.com', password: 'secret123' });\n\n    const token = loginRes.body.token;\n    const decoded = jwt.decode(token) as Record<string, unknown>;\n\n    expect(decoded).toHaveProperty('sub');\n    expect(decoded).toHaveProperty('tid');\n    expect(decoded).toHaveProperty('iat');\n    expect(decoded).toHaveProperty('exp');\n    expect(decoded.tid).toBe(TENANT_A);\n  });\n\n  // --- Auth Error Format Consistency (2 tests) ---\n\n  it('should return consistent error format for missing auth', async () => {\n    const endpoints = [\n      { method: 'get' as const, url: '/users/me' },\n      { method: 'post' as const, url: '/events' },\n      { method: 'post' as const, url: '/query/count' },\n      { method: 'get' as const, url: '/dashboards' },\n      { method: 'get' as const, url: '/export/events?format=json' },\n    ];\n\n    for (const ep of endpoints) {\n      const res = await request(app)[ep.method](ep.url);\n      expect(res.status).toBe(401);\n      expect(res.body).toHaveProperty('error');\n      expect(res.body).toHaveProperty('code');\n      expect(typeof res.body.error).toBe('string');\n      expect(typeof res.body.code).toBe('string');\n    }\n  });\n\n  it('should return consistent error format for invalid token', async () => {\n    const endpoints = [\n      { method: 'get' as const, url: '/users/me' },\n      { method: 'post' as const, url: '/events' },\n      { method: 'get' as const, url: '/dashboards' },\n    ];\n\n    for (const ep of endpoints) {\n      con