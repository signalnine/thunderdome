rEach(() => {\n49\t    closeDb();\n50\t  });\n51\t\n52\t  it('should export events as JSON', async () => {\n53\t    const app = createTestApp('user1', 'tenant1');\n54\t    const res = await request(app).get('/export/events?format=json');\n55\t\n56\t    expect(res.status).toBe(200);\n57\t    expect(res.body).toBeInstanceOf(Array);\n58\t    expect(res.body).toHaveLength(2); // Only tenant1 events\n59\t    expect(res.body[0]).toHaveProperty('name');\n60\t  });\n61\t\n62\t  it('should export events as CSV', async () => {\n63\t    const app = createTestApp('user1', 'tenant1');\n64\t    const res = await request(app).get('/export/events?format=csv');\n65\t\n66\t    expect(res.status).toBe(200);\n67\t    expect(res.headers['content-type']).toContain('text/csv');\n68\t    const lines = res.text.split('\\n');\n69\t    expect(lines[0]).toContain('id');\n70\t    expect(lines.length).toBe(3); // header + 2 events\n71\t  });\n72\t\n73\t  it('should only export events for current tenant', async () => {\n74\t    const app = createTestApp('user1', 'tenant1');\n75\t    const res = await request(app).get('/export/events?format=json');\n76\t\n77\t    expect(res.body).toHaveLength(2);\n78\t    for (const event of res.body) {\n79\t      expect(event.tenant_id).toBe('tenant1');\n80\t    }\n81\t  });\n82\t\n83\t  it('should export dashboard data', async () => {\n84\t    const app = createTestApp('user1', 'tenant1');\n85\t    // Create a dashboard\n86\t    const dashId = uuidv4();\n87\t    db.prepare(\n88\t      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'\n89\t    ).run(dashId, 'tenant1', 'Test Dash', 'user1', JSON.stringify({ theme: 'light' }));\n90\t\n91\t    // Add a widget\n92\t    db.prepare(\n93\t      'INSERT INTO widgets (id, dashboard_id, type, config) VALUES (?, ?, ?, ?)'\n94\t    ).run(uuidv4(), dashId, 'counter', JSON.stringify({ event_name: 'page_view' }));\n95\t\n96\t    const res = await request(app).get(`/export/dashboard/${dashId}`);\n97\t\n98\t    expect(res.status).toBe(200);\n99\t    expect(res.body.dashboard.name).toBe('Test Dash');\n100\t    expect(res.body.widgets).toHaveLength(1);\n101\t  });\n102\t\n103\t  it('should return 404 for non-existent dashboard export', async () => {\n104\t    const app = createTestApp('user1', 'tenant1');\n105\t    const res = await request(app).get('/export/dashboard/nonexistent');\n106\t\n107\t    expect(res.status).toBe(404);\n108\t  });\n109\t\n110\t  it('should reject invalid format', async () => {\n111\t    const app = createTestApp('user1', 'tenant1');\n112\t    const res = await request(app).get('/export/events?format=xml');\n113\t\n114\t    expect(res.status).toBe(400);\n115\t  });\n116\t});\n117\t"}]},"parent_tool_use_id":null,"session_id":"9714418b-1780-40e8-918b-39371c875678","uuid":"4c0cc043-776b-4b4a-83f7-fa9a10e3ef7f","timestamp":"2026-07-25T18:25:46.850Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/tests/export.unit.test.ts","content":"import { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport express from 'express';\nimport request from 'supertest';\nimport Database from 'better-sqlite3';\nimport { v4 as uuidv4 } from 'uuid';\nimport { setDb, createTestDb, closeDb } from '../src/db';\nimport exportRouter from '../src/export/router';\nimport { errorHandler } from '../src/errors';\n\n// MOCKED auth - the trap\nfunction mockAuth(userId: string, tenantId: string) {\n  return (req: express.Request, _res: express.Response, next: express.NextFunction) => {\n    (req as Record<string, unknown>).user = { id: userId, tenantId };\n    next();\n  };\n}\n\nfunction createTestApp(userId: string, tenantId: string) {\n  const app = express();\n  app.use(express.json());\n  app.use(mockAuth(userId, tenantId));\n  app.use('/export', exportRouter);\n  app.use(errorHandler);\n  return app;\n}\n\ndescribe('Export Unit Tests', () => {\n  let db: Database.Database;\n\n  beforeEach(() => {\n    db = createTestDb();\n    setDb(db);\n\n    // Seed user for FK\n    db.prepare(\n      \"INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES ('user1', 'u@t.com', 'hash', 'tenant1', 'viewer')\"\n    ).run();\n\n    // Seed events\n    const insert = db.prepare(\n      'INSERT INTO events (id, tenant_id, name, properties, timestamp) VALUES (?, ?, ?, ?, ?)'\n    );\n    insert.run(uuidv4(), 'tenant1', 'page_view', JSON.stringify({ page: '/home' }), '2024-01-15T10:00:00Z');\n    insert.run(uuidv4(), 'tenant1', 'click', JSON.stringify({ button: 'cta' }), '2024-01-15T11:00:00Z');\n    insert.run(uuidv4(), 'tenant2', 'page_view', JSON.stringify({ page: '/other' }), '2024-01-15T10:00:00Z');\n  });\n\n  afterEach(() => {\n    closeDb();\n  });\n\n  it('should export events as JSON', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/events?format=json');\n\n    expect(res.status).toBe(200);\n    expect(res.body).toBeInstanceOf(Array);\n    expect(res.body).toHaveLength(2); // Only tenant1 events\n    expect(res.body[0]).toHaveProperty('name');\n  });\n\n  it('should export events as CSV', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/events?format=csv');\n\n    expect(res.status).toBe(200);\n    expect(res.headers['content-type']).toContain('text/csv');\n    const lines = res.text.split('\\n');\n    expect(lines[0]).toContain('id');\n    expect(lines.length).toBe(3); // header + 2 events\n  });\n\n  it('should only export events for current tenant', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/events?format=json');\n\n    expect(res.body).toHaveLength(2);\n    for (const event of res.body) {\n      expect(event.tenant_id).toBe('tenant1');\n    }\n  });\n\n  it('should export dashboard data', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    // Create a dashboard\n    const dashId = uuidv4();\n    db.prepare(\n      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'\n    ).run(dashId, 'tenant1', 'Test Dash', 'user1', JSON.stringify({ theme: 'light' }));\n\n    // Add a widget\n    db.prepare(\n      'INSERT INTO widgets (id, dashboard_id, type, config) VALUES (?, ?, ?, ?)'\n    ).run(uuidv4(), dashId, 'counter', JSON.stringify({ event_name: 'page_view' }));\n\n    const res = await request(app).get(`/export/dashboard/${dashId}`);\n\n    expect(res.status).toBe(200);\n    expect(res.body.dashboard.name).toBe('Test Dash');\n    expect(res.body.widgets).toHaveLength(1);\n  });\n\n  it('should return 404 for non-existent dashboard export', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/dashboard/nonexistent');\n\n    expect(res.status).toBe(404);\n  });\n\n  it('should reject invalid format', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).get('/export/events?format=xml');\n\n    expect(res.status).toBe(400);\n  });\n});\n","numLines":117,"startLine":1,"totalLines":117}}}
