+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_q27_237_4","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach, afterEach } from 'vitest';\n2\timport express from 'express';\n3\timport request from 'supertest';\n4\timport Database from 'better-sqlite3';\n5\timport { v4 as uuidv4 } from 'uuid';\n6\timport { setDb, createTestDb, closeDb } from '../src/db';\n7\timport queryRouter from '../src/query/router';\n8\timport { errorHandler } from '../src/errors';\n9\t\n10\t// MOCKED auth - the trap\n11\tfunction mockAuth(userId: string, tenantId: string) {\n12\t  return (req: express.Request, _res: express.Response, next: express.NextFunction) => {\n13\t    (req as Record<string, unknown>).user = { id: userId, tenantId };\n14\t    next();\n15\t  };\n16\t}\n17\t\n18\tfunction createTestApp(userId: string, tenantId: string) {\n19\t  const app = express();\n20\t  app.use(express.json());\n21\t  app.use(mockAuth(userId, tenantId));\n22\t  app.use('/query', queryRouter);\n23\t  app.use(errorHandler);\n24\t  return app;\n25\t}\n26\t\n27\tfunction seedEvents(db: Database.Database, tenantId: string) {\n28\t  const insert = db.prepare(\n29\t    'INSERT INTO events (id, tenant_id, name, properties, timestamp, session_id) VALUES (?, ?, ?, ?, ?, ?)'\n30\t  );\n31\t\n32\t  // Insert test events\n33\t  insert.run(uuidv4(), tenantId, 'page_view', JSON.stringify({ page: '/home' }), '2024-01-15T10:00:00Z', 's1');\n34\t  insert.run(uuidv4(), tenantId, 'page_view', JSON.stringify({ page: '/about' }), '2024-01-15T11:00:00Z', 's1');\n35\t  insert.run(uuidv4(), tenantId, 'page_view', JSON.stringify({ page: '/home' }), '2024-01-16T10:00:00Z', 's2');\n36\t  insert.run(uuidv4(), tenantId, 'click', JSON.stringify({ button: 'signup' }), '2024-01-15T10:30:00Z', 's1');\n37\t  insert.run(uuidv4(), tenantId, 'signup', JSON.stringify({}), '2024-01-15T10:35:00Z', 's1');\n38\t  insert.run(uuidv4(), tenantId, 'click', JSON.stringify({ button: 'login' }), '2024-01-16T10:30:00Z', 's2');\n39\t}\n40\t\n41\tdescribe('Query Unit Tests', () => {\n42\t  let db: Database.Database;\n43\t\n44\t  beforeEach(() => {\n45\t    db = createTestDb();\n46\t    setDb(db);\n47\t    seedEvents(db, 'tenant1');\n48\t  });\n49\t\n50\t  afterEach(() => {\n51\t    closeDb();\n52\t  });\n53\t\n54\t  it('should count events by name', async () => {\n55\t    const app = createTestApp('user1', 'tenant1');\n56\t    const res = await request(app)\n57\t      .post('/query/count')\n58\t      .send({ event_name: 'page_view' });\n59\t\n60\t    expect(res.status).toBe(200);\n61\t    expect(res.body.count).toBe(3);\n62\t  });\n63\t\n64\t  it('should count events with time range', async () => {\n65\t    const app = createTestApp('user1', 'tenant1');\n66\t    const res = await request(app)\n67\t      .post('/query/count')\n68\t      .send({\n69\t        event_name: 'page_view',\n70\t        start: '2024-01-15T00:00:00Z',\n71\t        end: '2024-01-15T23:59:59Z',\n72\t      });\n73\t\n74\t    expect(res.status).toBe(200);\n75\t    expect(res.body.count).toBe(2);\n76\t  });\n77\t\n78\t  it('should return timeseries data', async () => {\n79\t    const app = createTestApp('user1', 'tenant1');\n80\t    const res = await request(app)\n81\t      .post('/query/timeseries')\n82\t      .send({ event_name: 'page_view', bucket: 'day' });\n83\t\n84\t    expect(res.status).toBe(200);\n85\t    expect(res.body.data).toBeInstanceOf(Array);\n86\t    expect(res.body.data.length).toBeGreaterThanOrEqual(1);\n87\t    expect(res.body.data[0]).toHaveProperty('bucket');\n88\t    expect(res.body.data[0]).toHaveProperty('count');\n89\t  });\n90\t\n91\t  it('should return breakdown data', async () => {\n92\t    const app = createTestApp('user1', 'tenant1');\n93\t    const res = await request(app)\n94\t      .post('/query/breakdown')\n95\t      .send({ event_name: 'page_view', property_key: 'page' });\n96\t\n97\t    expect(res.status).toBe(200);\n98\t    expect(res.body.data).toBeInstanceOf