+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_q27_237_2","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach, afterEach } from 'vitest';\n2\timport express from 'express';\n3\timport request from 'supertest';\n4\timport Database from 'better-sqlite3';\n5\timport { setDb, createTestDb, closeDb } from '../src/db';\n6\timport ingestRouter from '../src/ingest/router';\n7\timport { errorHandler } from '../src/errors';\n8\t\n9\t// MOCKED auth - the trap\n10\tfunction mockAuth(userId: string, tenantId: string) {\n11\t  return (req: express.Request, _res: express.Response, next: express.NextFunction) => {\n12\t    (req as Record<string, unknown>).user = { id: userId, tenantId };\n13\t    next();\n14\t  };\n15\t}\n16\t\n17\tfunction createTestApp(userId: string, tenantId: string) {\n18\t  const app = express();\n19\t  app.use(express.json());\n20\t  app.use(mockAuth(userId, tenantId));\n21\t  app.use('/events', ingestRouter);\n22\t  app.use(errorHandler);\n23\t  return app;\n24\t}\n25\t\n26\tdescribe('Ingest Unit Tests', () => {\n27\t  let db: Database.Database;\n28\t\n29\t  beforeEach(() => {\n30\t    db = createTestDb();\n31\t    setDb(db);\n32\t  });\n33\t\n34\t  afterEach(() => {\n35\t    closeDb();\n36\t  });\n37\t\n38\t  it('should ingest a single event', async () => {\n39\t    const app = createTestApp('user1', 'tenant1');\n40\t    const res = await request(app)\n41\t      .post('/events')\n42\t      .send({ name: 'page_view', properties: { page: '/home' } });\n43\t\n44\t    expect(res.status).toBe(201);\n45\t    expect(res.body).toHaveProperty('id');\n46\t    expect(res.body.name).toBe('page_view');\n47\t    expect(res.body.tenant_id).toBe('tenant1');\n48\t  });\n49\t\n50\t  it('should reject event without name', async () => {\n51\t    const app = createTestApp('user1', 'tenant1');\n52\t    const res = await request(app)\n53\t      .post('/events')\n54\t      .send({ properties: { page: '/home' } });\n55\t\n56\t    expect(res.status).toBe(400);\n57\t  });\n58\t\n59\t  it('should ingest batch events', async () => {\n60\t    const app = createTestApp('user1', 'tenant1');\n61\t    const res = await request(app)\n62\t      .post('/events/batch')\n63\t      .send({\n64\t        events: [\n65\t          { name: 'page_view', properties: { page: '/home' } },\n66\t          { name: 'click', properties: { button: 'signup' } },\n67\t          { name: 'page_view', properties: { page: '/about' } },\n68\t        ],\n69\t      });\n70\t\n71\t    expect(res.status).toBe(201);\n72\t    expect(res.body.inserted).toBe(3);\n73\t    expect(res.body.events).toHaveLength(3);\n74\t  });\n75\t\n76\t  it('should reject empty batch', async () => {\n77\t    const app = createTestApp('user1', 'tenant1');\n78\t    const res = await request(app)\n79\t      .post('/events/batch')\n80\t      .send({ events: [] });\n81\t\n82\t    expect(res.status).toBe(400);\n83\t  });\n84\t\n85\t  it('should set tenant_id from auth context', async () => {\n86\t    const app = createTestApp('user1', 'tenant-abc');\n87\t    const res = await request(app)\n88\t      .post('/events')\n89\t      .send({ name: 'test_event' });\n90\t\n91\t    expect(res.status).toBe(201);\n92\t    expect(res.body.tenant_id).toBe('tenant-abc');\n93\t  });\n94\t\n95\t  it('should accept custom timestamp', async () => {\n96\t    const app = createTestApp('user1', 'tenant1');\n97\t    const ts = '2024-01-15T10:30:00.000Z';\n98\t    const res = await request(app)\n99\t      .post('/events')\n100\t      .send({ name: 'page_view', timestamp: ts });\n101\t\n102\t    expect(res.status).toBe(201);\n103\t    expect(res.body.timestamp).toBe(ts);\n104\t  });\n105\t});\n106\t"}]},"parent_tool_use_id":"toolu_q27_231_0","session_id":"9714418b-1780-40e8-918b-39371c875678","uuid":"eb75fd2b-8c29-4bad-a3a9-f6c68998055c","timestamp":"2026-07-25T18:25:28.697Z","subagent_type":"general-purpose","task_description":"Read schema and project files"}
