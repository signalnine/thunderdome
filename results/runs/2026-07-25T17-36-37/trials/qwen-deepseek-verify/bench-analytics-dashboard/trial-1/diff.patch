+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_q27_237_5","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach, afterEach } from 'vitest';\n2\timport express from 'express';\n3\timport request from 'supertest';\n4\timport Database from 'better-sqlite3';\n5\timport { setDb, createTestDb, closeDb } from '../src/db';\n6\timport usersRouter from '../src/users/router';\n7\timport { errorHandler } from '../src/errors';\n8\t\n9\t// MOCKED auth - the trap: this doesn't validate JWT format\n10\tfunction mockAuth(userId: string, tenantId: string) {\n11\t  return (req: express.Request, _res: express.Response, next: express.NextFunction) => {\n12\t    (req as Record<string, unknown>).user = { id: userId, tenantId };\n13\t    next();\n14\t  };\n15\t}\n16\t\n17\tfunction createPublicApp() {\n18\t  const app = express();\n19\t  app.use(express.json());\n20\t  app.use('/users', usersRouter);\n21\t  app.use(errorHandler);\n22\t  return app;\n23\t}\n24\t\n25\tfunction createAuthedApp(userId: string, tenantId: string) {\n26\t  const app = express();\n27\t  app.use(express.json());\n28\t  app.use(mockAuth(userId, tenantId));\n29\t  app.use('/users', usersRouter);\n30\t  app.use(errorHandler);\n31\t  return app;\n32\t}\n33\t\n34\tdescribe('Users Unit Tests', () => {\n35\t  let db: Database.Database;\n36\t\n37\t  beforeEach(() => {\n38\t    db = createTestDb();\n39\t    setDb(db);\n40\t  });\n41\t\n42\t  afterEach(() => {\n43\t    closeDb();\n44\t  });\n45\t\n46\t  it('should register a new user', async () => {\n47\t    const app = createPublicApp();\n48\t    const res = await request(app)\n49\t      .post('/users')\n50\t      .send({ email: 'test@example.com', password: 'pass123', tenant_id: 't1' });\n51\t\n52\t    expect(res.status).toBe(201);\n53\t    expect(res.body).toHaveProperty('id');\n54\t    expect(res.body.email).toBe('test@example.com');\n55\t    expect(res.body.tenant_id).toBe('t1');\n56\t    expect(res.body.role).toBe('viewer');\n57\t  });\n58\t\n59\t  it('should reject duplicate email registration', async () => {\n60\t    const app = createPublicApp();\n61\t    await request(app)\n62\t      .post('/users')\n63\t      .send({ email: 'dup@example.com', password: 'pass123', tenant_id: 't1' });\n64\t\n65\t    const res = await request(app)\n66\t      .post('/users')\n67\t      .send({ email: 'dup@example.com', password: 'pass456', tenant_id: 't1' });\n68\t\n69\t    expect(res.status).toBe(409);\n70\t  });\n71\t\n72\t  it('should login with correct credentials', async () => {\n73\t    const app = createPublicApp();\n74\t    await request(app)\n75\t      .post('/users')\n76\t      .send({ email: 'login@example.com', password: 'pass123', tenant_id: 't1' });\n77\t\n78\t    const res = await request(app)\n79\t      .post('/users/login')\n80\t      .send({ email: 'login@example.com', password: 'pass123' });\n81\t\n82\t    expect(res.status).toBe(200);\n83\t    expect(res.body).toHaveProperty('token');\n84\t    expect(res.body.user.email).toBe('login@example.com');\n85\t  });\n86\t\n87\t  it('should reject login with wrong password', async () => {\n88\t    const app = createPublicApp();\n89\t    await request(app)\n90\t      .post('/users')\n91\t      .send({ email: 'wrong@example.com', password: 'pass123', tenant_id: 't1' });\n92\t\n93\t    const res = await request(app)\n94\t      .post('/users/login')\n95\t      .send({ email: 'wrong@example.com', password: 'wrongpass' });\n96\t\n97\t    expect(res.status).toBe(401);\n98\t  });\n99\t\n100\t  it('should get user profile with mock auth', async () => {\n101\t    const publicApp = createPublicApp();\n102\t    const regRes = await request(publicApp)\n103\t      .post('/users')\n104\t      .send({ email: 'me@example.com', password: 'pass123', tenant_id: 't1' });\n105\t\n106\t    const userId = regRes.body.id;\n107\t    const authedApp = createAuthedApp(userId, 't1');\n108\t\n109\t    const res = await request(authedApp).get('/users/me');\n110\t\n111\t    expect(res.status).toBe(200);\n112\t    expect(res.body.email).toBe('me@example.com');\n113\t  });\n114\t\n115\t  it('should allow admin to change user role', async () => {\n116\t    const publicApp = createPublicApp();\n117\t    // Create admin user\n118\t    const adminRes = await request(publicApp)\n119\t      .post('/users')\n120\t      .send({ email: 'admin@example.com', password: 'pass123', tenant_id: 't1' });\n121\t    const adminId = adminRes.body.id;\n122\t    db.prepare('UPDATE users SET role = ? WHERE id = ?').run('admin', adminId);\n123\t\n124\t    // Create target user\n125\t    const targetRes = await request(publicApp)\n126\t      .post('/users')\n127\t      .send({ email: 'target@example.com', password: 'pass123', tenant_id: 't1' });\n128\t    const targetId = targetRes.body.id;\n129\t\n130\t    // Use admin mock auth\n131\t    const adminApp = createAuthedApp(adminId, 't1');\n132\t    const res = await request(adminApp)\n133\t      .patch(`/users/${targetId}/role`)\n134\t      .send({ role: 'editor' });\n135\t\n136\t    expect(res.status).toBe(200);\n137\t    expect(res.body.role).toBe('editor');\n138\t  });\n139\t});\n140\t"}]},"parent_tool_use_id":"toolu_q27_231_0","session_id":"9714418b-1780-40e8-918b-39371c875678","uuid":"b63bc2af-ea11-4cfd-ad75-2fc30400a1da","timestamp":"2026-07-25T18:25:28.940Z","subagent_type":"general-purpose","task_description":"Read schema and project files"}
