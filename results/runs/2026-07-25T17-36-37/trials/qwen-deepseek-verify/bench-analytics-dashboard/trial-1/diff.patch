@@ -0,0 +1,150 @@
+import bcrypt from 'bcrypt';
+import jwt from 'jsonwebtoken';
+import { v4 as uuidv4 } from 'uuid';
+import { Router, Request, Response, NextFunction } from 'express';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const JWT_SECRET = process.env.JWT_SECRET || 'analytics-dashboard-secret';
+const JWT_EXPIRY = '24h';
+
+// Public routes: POST /users, POST /users/login
+const publicRouter = Router();
+
+publicRouter.post('/', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { email, password, tenant_id } = req.body;
+
+    if (!email || !password || !tenant_id) {
+      throw new AppError('VALIDATION_ERROR', 'Missing required fields: email, password, tenant_id');
+    }
+
+    const id = uuidv4();
+    const password_hash = bcrypt.hashSync(password, 10);
+
+    const db = getDb();
+    const stmt = db.prepare(
+      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'
+    );
+
+    try {
+      stmt.run(id, email, password_hash, tenant_id, 'viewer');
+    } catch (e: unknown) {
+      const sqliteErr = e as { code?: string };
+      if (sqliteErr.code === 'SQLITE_CONSTRAINT_UNIQUE') {
+        throw new AppError('CONFLICT', 'Email already registered');
+      }
+      throw e;
+    }
+
+    res.status(201).json({ id, email, tenant_id, role: 'viewer' });
+  } catch (e) {
+    next(e);
+  }
+});
+
+publicRouter.post('/login', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { email, password } = req.body;
+
+    if (!email || !password) {
+      throw new AppError('VALIDATION_ERROR', 'Missing required fields: email, password');
+    }
+
+    const db = getDb();
+    const user = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as
+      | { id: string; email: string; password_hash: string; tenant_id: string; role: string }
+      | undefined;
+
+    if (!user) {
+      throw new AppError('AUTH_ERROR');
+    }
+
+    const valid = bcrypt.compareSync(password, user.password_hash);
+    if (!valid) {
+      throw new AppError('AUTH_ERROR');
+    }
+
+    const token = jwt.sign(
+      { sub: user.id, tid: user.tenant_id },
+      JWT_SECRET,
+      { expiresIn: JWT_EXPIRY }
+    );
+
+    res.status(200).json({
+      token,
+      user: { id: user.id, email: user.email, tenant_id: user.tenant_id, role: user.role },
+    });
+  } catch (e) {
+    next(e);
+  }
+});
+
+// Auth-protected routes: GET /users/me, PATCH /users/:id/role
+const authRouter = Router();
+
+authRouter.get('/me', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const user = (req as unknown as Record<string, unknown>).user as { id: string; tenantId: string };
+    const db = getDb();
+    const row = db.prepare('SELECT id, email, tenant_id, role, created_at FROM users WHERE id = ?').get(
+      user.id
+    ) as { id: string; email: string; tenant_id: string; role: string; created_at: string };
+
+    if (!row) {
+      throw new AppError('NOT_FOUND');
+    }
+
+    res.status(200).json(row);
+  } catch (e) {
+    next(e);
+  }
+});
+
+authRouter.patch('/:id/role', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const authUser = (req as unknown as Record<string, unknown>).user as { id: string; tenantId: string };
+    const { role } = req.body;
+    const targetId = req.params.id;
+
+    if (!role || !['admin', 'viewer', 'editor'].includes(role)) {
+      throw new AppError('VALIDATION_ERROR', 'Invalid or missing role');
+    }
+
+    const db = getDb();
+
+    const adminCheck = db.prepare('SELECT role FROM users WHERE id = ?').get(
+      authUser.id
+    ) as { role: string };
+
+    if (!adminCheck || adminCheck.role !== 'admin') {
+      throw new AppError('FORBIDDEN', 'Only admins can change roles');
+    }
+
+    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, targetId);
+
+    const updated = db.prepare('SELECT id, email, tenant_id, role FROM users WHERE id = ?').get(
+      targetId
+    ) as { id: string; email: string; tenant_id: string; role: string };
+
+    if (!updated) {
+      throw new AppError('NOT_FOUND');
+    }
+
+    res.status(200).json(updated);
+  } catch (e) {
+    next(e);
+  }
+});
+
+// Combined router for unit tests (all routes in one)
+const combinedRouter = Router();
+// Copy public routes
+combinedRouter.post('/', publicRouter.stack[0].handle);
+combinedRouter.post('/login', publicRouter.stack[1].handle);
+// Copy auth routes
+combinedRouter.get('/me', authRouter.stack[0].handle);
+combinedRouter.patch('/:id/role', authRouter.stack[1].handle);
+
+export { publicRouter, authRouter };
+export default combinedRouter;
