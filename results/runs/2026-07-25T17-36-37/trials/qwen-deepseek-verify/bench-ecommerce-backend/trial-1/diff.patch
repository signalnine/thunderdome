ice } from '../src/payment/index.js';\nimport { createNotificationService } from '../src/notifications/index.js';\nimport { createAnalyticsService } from '../src/analytics/index.js';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = dirname(__filename);\nconst srcDir = resolve(__dirname, '..', 'src');\n\nfunction sha256(filePath: string): string {\n  const content = readFileSync(filePath, 'utf-8');\n  return createHash('sha256').update(content).digest('hex');\n}\n\ndescribe('Integration Tests', () => {\n  let bus: EventBus;\n  let catalog: ReturnType<typeof createCatalogService>;\n  let inventory: ReturnType<typeof createInventoryService>;\n  let cart: ReturnType<typeof createCartService>;\n  let pricing: ReturnType<typeof createPricingService>;\n  let orders: ReturnType<typeof createOrderService>;\n  let payment: ReturnType<typeof createPaymentService>;\n  let notifications: ReturnType<typeof createNotificationService>;\n  let analytics: ReturnType<typeof createAnalyticsService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    catalog = createCatalogService(bus);\n    inventory = createInventoryService(bus);\n    cart = createCartService(bus);\n    pricing = createPricingService(bus);\n    orders = createOrderService(bus);\n    payment = createPaymentService(bus);\n    notifications = createNotificationService(bus);\n    analytics = createAnalyticsService(bus);\n  });\n\n  // 1-3: Product catalog CRUD through bus events\n  it('1. should create a product and emit product:created event', () => {\n    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n    expect(id).toBeDefined();\n    const log = bus.getLog();\n    const createEvents = log.filter(e => e.event === Events.PRODUCT_CREATED);\n    expect(createEvents).toHaveLength(1);\n    const payload = createEvents[0].payload as { productId: string; name: string };\n    expect(payload.productId).toBe(id);\n    expect(payload.name).toBe('Laptop');\n  });\n\n  it('2. should update a product and retrieve updated data', () => {\n    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n    catalog.updateProduct(id, { price: 899.99, name: 'Gaming Laptop' });\n    const product = catalog.getProduct(id);\n    expect(product!.price).toBe(899.99);\n    expect(product!.name).toBe('Gaming Laptop');\n  });\n\n  it('3. should remove a product and confirm deletion', () => {\n    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n    expect(catalog.removeProduct(id)).toBe(true);\n    expect(catalog.getProduct(id)).toBeNull();\n    expect(catalog.listProducts()).toHaveLength(0);\n  });\n\n  // 4-5: Inventory management with stock events\n  it('4. should set stock and emit inventory:updated event', () => {\n    inventory.setStock('p1', 100);\n    const log = bus.getLog();\n    const invEvents = log.filter(e => e.event === Events.INVENTORY_UPDATED);\n    expect(invEvents.length).toBeGreaterThanOrEqual(1);\n    const payload = invEvents[0].payload as { productId: string; quantity: number };\n    expect(payload.productId).toBe('p1');\n    expect(payload.quantity).toBe(100);\n  });\n\n  it('5. should reserve stock and reflect updated quantity', () => {\n    inventory.setStock('p1', 10);\n    const reserved = inventory.reserve('p1', 3);\n    expect(reserved).toBe(true);\n    expect(inventory.getStock('p1')).toBe(7);\n\n    const failedReserve = inventory.reserve('p1', 100);\n    expect(failedReserve).toBe(false);\n    expect(inventory.getStock('p1')).toBe(7);\n  });\n\n  // 6-7: Cart operations emitting cart events\n  it('6. should add items to cart and emit cart:updated event', () => {\n    const cartId = cart.createCart('user1');\n    cart.addItem(cartId, 'p1', 2);\n    const log = bus.getLog();\n    const cartEvents = log.filter(e => e.event === Events.CART_UPDATED);\n    expect(cartEvents).toHaveLength(1);\n    const payload = cartEvents[0].payload as { cartId: string; items: Array<{ productId: string; quantity: number }> };\n    expect(payload.cartId).toBe(cartId);\n    expect(payload.items).toHaveLength(1);\n  });\n\n  it('7. should update cart quantity and reflect in cart data', () => {\n    const cartId = cart.createCart('user1');\n    cart.addItem(cartId, 'p1', 2);\n    cart.updateQuantity(cartId, 'p1', 5);\n    const c = cart.getCart(cartId);\n    expect(c!.items[0].quantity).toBe(5);\n  });\n\n  // 8-9: Pricing calculation with discount codes\n  it('8. should calculate price with tax (10%)', () => {\n    const result = pricing.calculateTotal([\n      { productId: 'p1', quantity: 2, price: 50 },\n    ]);\n    expect(result.subtotal).toBe(100);\n    expect(result.tax).toBe(10);\n    expect(result.total).toBe(110);\n  });\n\n  it('9. should apply discount code and compute correct total', () => {\n    pricing.addDiscountCode('SAVE20', 20);\n    const result = pricing.calculateTotal(\n      [{ productId: 'p1', quantity: 1, price: 200 }],\n      'SAVE20',\n    );\n    expect(result.subtotal).toBe(200);\n    expect(result.discount).toBe(40);\n    // After discount: 160, tax: 16, total: 176\n    expect(result.tax).toBe(16);\n    expect(result.total).toBe(176);\n  });\n\n  // 10-12: Order creation and status transitions\n  it('10. should create an order with PENDING status', () => {\n    const orderId = orders.createOrder('user1', 'cart1', 150);\n    const order = orders.getOrder(orderId);\n    expect(order!.status).toBe(OrderStatus.PENDING);\n    expect(order!.total).toBe(150);\n  });\n\n  it('11. should transition order through status states', () => {\n    const orderId = orders.createOrder('user1', 'cart1', 150);\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.CONFIRMED);\n\n    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.SHIPPED);\n\n    orders.updateStatus(orderId, OrderStatus.DELIVERED);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.DELIVERED);\n  });\n\n  it('12. should emit order:status_changed events with correct previous status', () => {\n    const orderId = orders.createOrder('user1', 'cart1', 150);\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n\n    const log = bus.getLog();\n    const statusEvents = log.filter(e => e.event === Events.ORDER_STATUS_CHANGED);\n    expect(statusEvents).toHaveLength(2);\n\n    const first = statusEvents[0].payload as { previousStatus: string; status: string };\n    expect(first.previousStatus).toBe(OrderStatus.PENDING);\n    expect(first.status).toBe(OrderStatus.CONFIRMED);\n\n    const second = statusEvents[1].payload as { previousStatus: string; status: string };\n    expect(second.previousStatus).toBe(OrderStatus.CONFIRMED);\n    expect(second.status).toBe(OrderStatus.SHIPPED);\n  });\n\n  // 13-14: Payment processing (success and failure)\n  it('13. should process payment successfully and emit event', async () => {\n    const result = await payment.processPayment('order1', 99.99);\n    expect(result.status).toBe(PaymentStatus.SUCCESS);\n    expect(result.transactionId).toBeDefined();\n\n    const log = bus.getLog();\n    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n    expect(payEvents).toHaveLength(1);\n  });\n\n  it('14. should handle payment failure and emit failure event', async () => {\n    const failPayment = createPaymentService(bus, { simulateFailure: true });\n    const result = await failPayment.processPayment('order1', 99.99);\n    expect(result.status).toBe(PaymentStatus.FAILED);\n\n    const log = bus.getLog();\n    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n    const failEvent = payEvents.find(e => (e.payload as { status: string }).status === PaymentStatus.FAILED);\n    expect(failEvent).toBeDefined();\n  });\n\n  // 15-16: Notifications generated for order events\n  it('15. should send notification on order status change', async () => {\n    notifications.subscribe('user1');\n    const orderId = orders.createOrder('user1', 'cart1', 100);\n\n    // Wait for event propagation\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n\n    // Give async handlers a tick to resolve\n    await new Promise(resolve => setTimeout(resolve, 10));\n\n    const notifs = notifications.getNotifications('user1');\n    expect(notifs.length).toBeGreaterThanOrEqual(1);\n    expect(notifs.some(n => n.type === 'order_status')).toBe(true);\n  });\n\n  it('16. should send notification on payment processed', async () => {\n    notifications.subscribe('user1');\n    const orderId = orders.createOrder('user1', 'cart1', 100);\n\n    await payment.processPayment(orderId, 100);\n\n    await new Promise(resolve => setTimeout(resolve, 10));\n\n    const notifs = notifications.getNotifications('user1');\n    expect(notifs.some(n => n.type === 'payment')).toBe(true);\n  });\n\n  // 17-18: Analytics tracking events and computing metrics\n  it('17. should track event counts through the bus', async () => {\n    catalog.createProduct('Widget', 10, 'gadgets');\n    catalog.createProduct('Gizmo', 20, 'gadgets');\n\n    // Wait for async propagation\n    await new Promise(resolve => setTimeout(resolve, 10));\n\n    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBe(2);\n  });\n\n  it('18. should track revenue from successful payments', async () => {\n    const orderId = orders.createOrder('user1', 'cart1', 250);\n    await payment.processPayment(orderId, 250);\n\n    expect(analytics.getRevenue()).toBe(250);\n  });\n\n  // 19: Full checkout flow\n  it('19. should complete full checkout flow end-to-end', async () => {\n    // Subscribe for notifications\n    notifications.subscribe('user1');\n\n    // Create product\n    const productId = catalog.createProduct('Premium Widget', 49.99, 'gadgets');\n    expect(catalog.getProduct(productId)).not.toBeNull();\n\n    // Set stock\n    inventory.setStock(productId, 100);\n    expect(inventory.getStock(productId)).toBe(100);\n\n    // Add to cart\n    const cartId = cart.createCart('user1');\n    cart.addItem(cartId, productId, 2);\n    const cartData = cart.getCart(cartId);\n    expect(cartData!.items).toHaveLength(1);\n\n    // Calculate price\n    const priceResult = pricing.calculateTotal([\n      { productId, quantity: 2, price: 49.99 },\n    ]);\n    expect(priceResult.subtotal).toBe(99.98);\n    expect(priceResult.total).toBeGreaterThan(0);\n\n    // Reserve inventory\n    const reserved = inventory.reserve(productId, 2);\n    expect(reserved).toBe(true);\n    expect(inventory.getStock(productId)).toBe(98);\n\n    // Create order\n    const orderId = orders.createOrder('user1', cartId, priceResult.total);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.PENDING);\n\n    // Process payment\n    const payResult = await payment.processPayment(orderId, priceResult.total);\n    expect(payResult.status).toBe(PaymentStatus.SUCCESS);\n\n    // Update order status\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.CONFIRMED);\n\n    // Wait for async event propagation\n    await new Promise(resolve => setTimeout(resolve, 50));\n\n    // Verify notifications were sent\n    const notifs = notifications.getNotifications('user1');\n    expect(notifs.length).toBeGreaterThanOrEqual(1);\n\n    // Verify analytics tracked the events\n    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBeGreaterThanOrEqual(1);\n    expect(analytics.getEventCount(Events.ORDER_CREATED)).toBeGreaterThanOrEqual(1);\n    expect(analytics.getRevenue()).toBe(priceResult.total);\n\n    // Verify bus log has all expected events\n    const log = bus.getLog();\n    const eventTypes = new Set(log.map(e => e.event));\n    expect(eventTypes.has(Events.PRODUCT_CREATED)).toBe(true);\n    expect(eventTypes.has(Events.INVENTORY_UPDATED)).toBe(true);\n    expect(