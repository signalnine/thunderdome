0, category: 'gadgets' });\n    await bus.emit(Events.PRODUCT_CREATED, { productId: 'p2', name: 'Gizmo', price: 20, category: 'gadgets' });\n    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBe(2);\n  });\n\n  it('should return 0 for unknown event type', () => {\n    expect(analytics.getEventCount('unknown:event')).toBe(0);\n  });\n\n  it('should track revenue from successful payments', async () => {\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.SUCCESS, transactionId: 'tx1' });\n    expect(analytics.getRevenue()).toBe(100);\n  });\n\n  it('should not track revenue from failed payments', async () => {\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.FAILED, error: 'declined' });\n    expect(analytics.getRevenue()).toBe(0);\n  });\n\n  it('should compute conversion rate', async () => {\n    // Create 2 carts (via cart updated events with unique cart IDs)\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c1', userId: 'u1', items: [{ productId: 'p1', quantity: 1 }] });\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c2', userId: 'u2', items: [{ productId: 'p2', quantity: 1 }] });\n    // Create 1 order\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 50 });\n\n    expect(analytics.getConversionRate()).toBe(0.5);\n  });\n\n  it('should return top products by order quantity', async () => {\n    await bus.emit(Events.CART_UPDATED, {\n      cartId: 'c1', userId: 'u1',\n      items: [{ productId: 'p1', quantity: 5 }, { productId: 'p2', quantity: 2 }],\n    });\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });\n\n    const top = analytics.getTopProducts(2);\n    expect(top).toHaveLength(2