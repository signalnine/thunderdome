atus.SUCCESS, orderId });\n      await bus.emit(Events.PAYMENT_PROCESSED, { orderId, ...result });\n      return result;\n    },\n\n    async refund(transactionId: string): Promise<boolean> {\n      const tx = transactions.get(transactionId);\n      if (!tx || tx.status !== PaymentStatus.SUCCESS) return false;\n      tx.status = PaymentStatus.FAILED;\n      return true;\n    },\n  };\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":6,"lines":[" import { v4 as uuidv4 } from 'uuid';","-import { EventBus, PaymentService, PaymentStatus, Events } from '../types.js';","+import { EventBus } from '../bus.js';","+import { PaymentService, PaymentStatus, Events } from '../types.js';"," "," export interface PaymentServiceOptions {","   simulateFailure?: boolean;"]}],"userModified":false,"replaceAll":false}}
