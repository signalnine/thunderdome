_status', message: `Order ${p.orderId} status changed from ${p.previousStatus} to ${p.status}` });\n    }\n  });\n\n  // Listen for payment:processed\n  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {\n    const p = payload as { orderId: string; status: string; transactionId?: string; error?: string };\n    const userId = orderUserMap.get(p.orderId);\n    if (userId && subscribers.has(userId)) {\n      if (!notifications.has(userId)) {\n        notifications.set(userId, []);\n      }\n      const msg = p.status === 'success'\n        ? `Payment successful for order ${p.orderId}`\n        : `Payment ${p.status} for order ${p.orderId}`;\n      notifications.get(userId)!.push({\n        type: 'payment',\n        message: msg,\n        timestamp: Date.now(),\n      });\n      bus.emit(Events.NOTIFICATION_SENT, { userId, type: 'payment', message: msg });\n    }\n  });\n\n  return {\n    subscribe(userId: string): void {\n      subscribers.add(userId);\n      if (!notifications.has(userId)) {\n        notifications.set(userId, []);\n      }\n    },\n\n    getNotifications(userId: string): Array<{ type: string; message: string; timestamp: number }> {\n      return notifications.get(userId) ?? [];\n    },\n  };\n}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":5,"lines":["-import { EventBus, NotificationService, Events } from '../types.js';","+import { EventBus } from '../bus.js';","+import { NotificationService, Events } from '../types.js';"," "," export function createNotificationService(bus: EventBus): NotificationService {","   const subscribers = new Set<string>();"]}],"userModified":false,"replaceAll":false}}
