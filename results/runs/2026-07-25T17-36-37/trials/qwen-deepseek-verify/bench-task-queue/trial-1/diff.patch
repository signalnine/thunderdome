+      const resolve = this.shutdownResolve;
+      this.shutdownResolve = null;
+      resolve(this.shutdownResult);
+    }
+  }
+
+  // ---- Phase 8: Concurrency Control ----
+
+  setConcurrency(queueName: string, limit: number): void {
+    this.concurrency.set(queueName, limit);
+  }
+
+  getConcurrency(queueName: string): { current: number; max: number } {
+    const max = this.concurrency.get(queueName);
+    return {
+      current: this.countProcessing(queueName),
+      max: max ?? Infinity,
+    };
+  }
+
+  private countProcessing(queueName: string): number {
+    let count = 0;
+    for (const task of this.allTasks.values()) {
+      if (task.queueName === queueName && task.status === 'processing') {
+        count++;
+      }
+    }
+    return count;
+  }
+
+  // ---- Phase 9: Progress and Cancellation ----
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    const task = this.allTasks.get(taskId);
+    if (!task) return;
+
+    if (percent < 0 || percent > 100) {
+      throw new Error('Progress must be between 0 and 100');
+    }
+
+    const now = new Date();
+    task.progress = { percent, message, updatedAt: now };
+
+    const subscribers = this.progressSubscribers.get(taskId);
+    if (subscribers) {
+      for (const cb of subscribers) {
+        cb({ percent, message, updatedAt: now });
+      }
+    }
+  }
+
+  getProgress(taskId: string): { percent: number; message?: string; updatedAt: Date } | null {
+    const task = this.allTasks.get(taskId);
+    if (!task) return null;
+    return task.progress;
+  }
+
+  cancel(taskId: string): void {
+    const task = this.allTasks.get(taskId);
+    if (!task) return;
+
+    task.status = 'cancelled';
+
+    const queue = this.queues.get(task.queueName);
+    if (queue) {
+      const idx = queue.indexOf(task);
+      if (idx !== -1) {
+        queue.splice(idx, 1);
+      }
+    }
+  }
+
+  onProgress(taskId: string, callback: (info: { percent: number; message?: string; updatedAt: Date }) => void): () => void {
+    if (!this.progressSubscribers.has(taskId)) {
+      this.progressSubscribers.set(taskId, []);
+    }
+    this.progressSubscribers.get(taskId)!.push(callback);
+
+    return () => {
+      const subs = this.progressSubscribers.get(taskId);
+      if (subs) {
+        const idx = subs.indexOf(callback);
+        if (idx !== -1) {
+          subs.splice(idx, 1);
+        }
+      }
+    };
+  }
+
+  // ---- Phase 10: Recurring Tasks (Cron) ----
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {
+    const schedule: Schedule = {
+      id: generateId(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+    };
+    this.schedules.set(schedule.id, schedule);
+    return schedule;
+  }
+
+  unschedule(scheduleId: string): void {
+    const schedule = this.schedules.get(scheduleId);
+    if (schedule) {
+      schedule.active = false;
+    }
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const active = Array.from(this.schedules.values()).filter(s => s.active);
+    if (queueName) {
+      return active.filter(s => s.queueName === queueName);
+    }
+    return active;
+  }
+
+  tick(): void {
+    const now = new Date();
+    for (const schedule of this.schedules.values()) {
+      if (!schedule.active) continue;
+
+      const parsed = parseCron(schedule.cronExpression);
+
+      const key = `${schedule.id}:${now.getUTCFullYear()}-${now.getUTCMonth()}-${now.getUTCDate()}-${now.getUTCHours()}-${now.getUTCMinutes()}`;
+      if (this.lastCronFire.has(key)) continue;
+
+      if (isCronDue(parsed, now)) {
+        this.enqueue(schedule.queueName, schedule.taskTemplate);
+        this.lastCronFire.set(key, 1);
+      }
+    }
+  }
+
+  // ---- Phase 11: Middleware Pipeline ----
+
+  use(queueName: string, middleware: Middleware): void {
+    if (!this.middlewareStacks.has(queueName)) {
+      this.middlewareStacks.set(queueName, []);
+    }
+    this.middlewareStacks.get(queueName)!.push(middleware);
+  }
+
+  async process(queueName: string, handler: TaskHandler): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const middlewares = this.middlewareStacks.get(queueName) ?? [];
+
+    try {
+      let i = 0;
+      const next = async (): Promise<void> => {
+        i++;
+        if (i < middlewares.length) {
+          await middlewares[i](task, next);
+        } else {
+          await handler(task);
+        }
+      };
+
+      if (middlewares.length > 0) {
+        await middlewares[0](task, next);
+      } else {
+        await handler(task);
+      }
+    } catch (error) {
+      task.status = 'failed';
+      task.lastError = error;
+      task.failCount = (task.failCount || 0) + 1;
+
+      const retriesUsed = task.attempts - 1;
+      if (retriesUsed < task.maxRetries) {
+        const backoffDelay = task.backoffMs * Math.pow(2, retriesUsed);
+        const now = new Date();
+        task.availableAt = new Date(now.getTime() + backoffDelay);
+        task.status = 'pending';
+        const queue = this.queues.get(task.queueName);
+        if (queue) {
+          queue.push(task);
+        }
+      } else {
+        this.moveToDLQ(task);
+      }
+    }
+  }
+
+  // ---- Phase 12: Graceful Shutdown ----
+
+  onShutdown(callback: () => void): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  async shutdown(timeout: number = 30000): Promise<{ completed: number; cancelled: number; elapsed: number }> {
+    if (this.shutdownPromise) {
+      return this.shutdownPromise;
+    }
+
+    const startTime = Date.now();
+    this.shutdownStartTime = startTime;
+    this.isShuttingDown = true;
+
+    for (const cb of this.shutdownCallbacks) {
+      cb();
+    }
+
+    const processingTasks = Array.from(this.allTasks.values()).filter(
+      t => t.status === 'processing'
