= Math.floor(Math.random() * 256);\n  }\n  bytes[6] = (bytes[6] & 0x0f) | 0x40;\n  bytes[8] = (bytes[8] & 0x3f) | 0x80;\n  const hex = bytes.reduce((s, b) => s + b.toString(16).padStart(2, '0'), '');\n  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;\n}\n\n// Cron parser for simple expressions\nfunction parseCron(expr: string): { minutes: number[]; hours: number[]; days: number[]; months: number[]; weekdays: number[] } {\n  const parts = expr.trim().split(/\\s+/);\n  if (parts.length !== 5) {\n    throw new Error(`Invalid cron expression: ${expr}`);\n  }\n\n  const parseField = (field: string, min: number, max: number): number[] => {\n    if (field === '*') {\n      return Array.from({ length: max - min + 1 }, (_, i) => min + i);\n    }\n    if (field.startsWith('*/')) {\n      const step = parseInt(field.slice(2), 10);\n      const result: number[] = [];\n      for (let i = min; i <= max; i += step) {\n        result.push(i);\n      }\n      return result;\n    }\n    if (field.includes(',')) {\n      return field.split(',').map(s => parseInt(s.trim(), 10));\n    }\n    return [parseInt(field, 10)];\n  };\n\n  return {\n    minutes: parseField(parts[0], 0, 59),\n    hours: parseField(parts[1], 0, 23),\n    days: parseField(parts[2], 1, 31),\n    months: parseField(parts[3], 1, 12),\n    weekdays: parseField(parts[4], 0, 6),\n  };\n}\n\nfunction isCronDue(parsed: ReturnType<typeof parseCron>, now: Date): boolean {\n  return (\n    parsed.minutes.includes(now.getUTCMinutes()) &&\n    parsed.hours.includes(now.getUTCHours()) &&\n    parsed.days.includes(now.getUTCDate()) &&\n    parsed.months.includes(now.getUTCMonth() + 1) &&\n    parsed.weekdays.includes(now.getUTCDay())\n  );\n}\n\nexport class TaskQueue {\n  private queues: Map<string, Task[]> = new Map();\n  private allTasks: Map<string, Task> = new Map();\n  private dlq: Map<string, Task[]> = new Map();\n  private schedules: Map<string, Schedule> = new 