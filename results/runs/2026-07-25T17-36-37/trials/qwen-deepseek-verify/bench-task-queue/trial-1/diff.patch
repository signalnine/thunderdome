+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_q27_152_0","type":"tool_result","content":"1\t// Types\n2\t\n3\texport interface Task {\n4\t  id: string;\n5\t  payload: unknown;\n6\t  status: 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';\n7\t  createdAt: Date;\n8\t  queueName: string;\n9\t  priority: number;\n10\t  availableAt: Date;\n11\t  maxRetries: number;\n12\t  backoffMs: number;\n13\t  attempts: number;\n14\t  failCount: number;\n15\t  lastError: unknown;\n16\t  dependsOn: string[];\n17\t  progress: { percent: number; message?: string; updatedAt: Date } | null;\n18\t}\n19\t\n20\texport interface EnqueueOptions {\n21\t  priority?: number;\n22\t  delay?: number;\n23\t  runAt?: Date;\n24\t  maxRetries?: number;\n25\t  backoffMs?: number;\n26\t  dependsOn?: string[];\n27\t}\n28\t\n29\texport interface Schedule {\n30\t  id: string;\n31\t  queueName: string;\n32\t  cronExpression: string;\n33\t  taskTemplate: unknown;\n34\t  active: boolean;\n35\t}\n36\t\n37\texport type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;\n38\texport type TaskHandler = (task: Task) => Promise<void>;\n39\t\n40\t// UUID generator (simple v4-like)\n41\tfunction generateId(): string {\n42\t  const bytes = new Uint8Array(16);\n43\t  for (let i = 0; i < 16; i++) {\n44\t    bytes[i] = Math.floor(Math.random() * 256);\n45\t  }\n46\t  bytes[6] = (bytes[6] & 0x0f) | 0x40;\n47\t  bytes[8] = (bytes[8] & 0x3f) | 0x80;\n48\t  const hex = bytes.reduce((s, b) => s + b.toString(16).padStart(2, '0'), '');\n49\t  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;\n50\t}\n51\t\n52\t// Cron parser for simple expressions\n53\tfunction parseCron(expr: string): { minutes: number[]; hours: number[]; days: number[]; months: number[]; weekdays: number[] } {\n54\t  const parts = expr.trim().split(/\\s+/);\n55\t  if (parts.length !== 5) {\n56\t    throw new Error(`Invalid cron expression: ${expr}`);\n57\t  }\n58\t\n59\t  const parseField = (field: string, min: number, max: number): number[] => {\n60\t    if (field === '*') {\n61\t      return Array.from({ length: max - min + 1 }, (_, i) => min + i);\n62\t    }\n63\t    if (field.startsWith('*/')) {\n64\t      const step = parseInt(field.slice(2), 10);\n65\t      const result: number[] = [];\n66\t      for (let i = min; i <= max; i += step) {\n67\t        result.push(i);\n68\t      }\n69\t      return result;\n70\t    }\n71\t    if (field.includes(',')) {\n72\t      return field.split(',').map(s => parseInt(s.trim(), 10));\n73\t    }\n74\t    return [parseInt(field, 10)];\n75\t  };\n76\t\n77\t  return {\n78\t    minutes: parseField(parts[0], 0, 59),\n79\t    hours: parseField(parts[1], 0, 23),\n80\t    days: parseField(parts[2], 1, 31),\n81\t    months: parseField(parts[3], 1, 12),\n82\t    weekdays: parseField(parts[4], 0, 6),\n83\t  };\n84\t}\n85\t\n86\tfunction isCronDue(parsed: ReturnType<typeof parseCron>, now: Date): boolean {\n87\t  return (\n88\t    parsed.minutes.includes(now.getUTCMinutes()) &&\n89\t    parsed.hours.includes(now.getUTCHours()) &&\n90\t    parsed.days.includes(now.getUTCDate()) &&\n91\t    parsed.months.includes(now.getUTCMonth() + 1) &&\n92\t    parsed.weekdays.includes(now.getUTCDay())\n93\t  );\n94\t}\n95\t\n96\texport class TaskQueue {\n97\t  private queues: Map<string, Task[]> = new Map();\n98\t  private allTasks: Map<string, Task> = new Map();\n99\t  private dlq: Map<string, Task[]> = new Map();\n100\t  private schedules: Map<string, Schedule> = new Map();\n101\t  private concurrency: Map<string, number> = new Map();\n102\t  private progressSubscribers: Map<string, Array<(info: { percent: number; message?: string; updatedAt: Date }) => void>> = new Map();\n103\t  private shutdownCallbacks: Array<() => void> = [];\n104\t  private isShuttingDown: boolean = false;\n105\t  private shutdownPromise: Promise<{ completed: number; cancelled: number; elapsed: number }> | null = null;\n106\t  private middlewareStacks: Map<string, Middleware[]> = new Map();\n107\t  private lastCronFire: Map<string, number> = new Map();\n108\t\n109\t  constructor() {\n110\t    this.queues.set('default', []);\n111\t  }\n112\t\n113\t  // ---- Phase 1: Basic FIFO Queue ----\n114\t\n115\t  enqueue(queueName: string, payload: unknown, options?: EnqueueOptions): Task {\n116\t    if (this.isShuttingDown) {\n117\t      throw new Error('Cannot enqueue tasks after shutdown');\n118\t    }\n119\t\n120\t    const priority = options?.priority ?? 5;\n121\t    if (priority < 1 || priority > 10) {\n122\t      throw new Error(`Priority must be between 1 and 10, got ${priority}`);\n123\t    }\n124\t\n125\t    if (options?.dependsOn) {\n126\t      for (const depId of options.dependsOn) {\n127\t        if (!this.allTasks.has(depId)) {\n128\t          throw new Error(`Dependency task ${depId} does not exist`);\n129\t        }\n130\t      }\n131\t    }\n132\t\n133\t    const now = new Date();\n134\t    let availableAt: Date;\n135\t    if (options?.runAt) {\n136\t      availableAt = options.runAt;\n137\t    } else if (options?.delay) {\n138\t      availableAt = new Date(now.getTime() + options.delay);\n139\t    } else {\n140\t      availableAt = now;\n141\t    }\n142\t\n143\t    const task: Task = {\n144\t      id: generateId(),\n145\t      payload,\n146\t      status: 'pending',\n147\t      createdAt: now,\n148\t      queueName,\n149\t      priority,\n150\t      availableAt,\n151\t      maxRetries: options?.maxRetries ?? 3,\n152\t      backoffMs: options?.backoffMs ?? 1000,\n153\t      attempts: 0,\n154\t      failCount: 0,\n155\t      lastError: null,\n156\t      dependsOn: options?.dependsOn ?? [],\n157\t      progress: null,\n158\t    };\n159\t\n160\t    this.allTasks.set(task.id, task);\n161\t\n162\t    if (!this.queues.has(queueName)) {\n163\t      this.queues.set(queueName, []);\n164\t    }\n165\t    this.queues.get(queueName)!.push(task);\n166\t\n167\t    return task;\n168\t  }\n169\t\n170\t  dequeue(queueName: string): Task | null {\n171\t    const queue = this.queues.get(queueName);\n172\t    if (!queue || queue.length === 0) {\n173\t      return null;\n174\t    }\n175\t\n176\t    const maxConcurrent = this.concurrency.get(queueName);\n177\t    if (maxConcurrent !== undefined) {\n178\t      const currentProcessing = this.countProcessing(queueName);\n179\t      if (currentProcessing >= maxConcurrent) {\n180\t        return null;\n181\t      }\n182\t    }\n183\t\n184\t    const now = new Date();\n185\t\n186\t    const available: Task[] = [];\n187\t    for (const task of queue) {\n188\t      if (task.status !== 'pending') continue;\n189\t      if (task.availableAt.getTime() > now.getTime()) continue;\n190\t      if (!this.areDependenciesMet(task)) continue;\n191\t      available.push(task);\n192\t    }\n193\t\n194\t    if (available.length === 0) {\n195\t      return null;\n196\t    }\n197\t\n198\t    available.sort((a, b) => {\n199\t      const timeDiff = a.availableAt.getTime() - b.availableAt.getTime();\n200\t      if (timeDiff !== 0) return timeDiff;\n201\t      if (a.priority !== b.priority) return a.priority - b.priority;\n202\t      return a.createdAt.getTime() - b.createdAt.getTime();\n203\t    });\n204\t\n205\t    const chosen = available[0];\n206\t\n207\t    const idx = queue.indexOf(chosen);\n208\t    queue.splice(idx, 1);\n209\t\n210\t    chosen.status = 'processing';\n211\t    chosen.attempts = chosen.attempts + 1;\n212\t\n213\t    return chosen;\n214\t  }\n215\t\n216\t  size(): number {\n217\t    const queue = this.queues.get('default');\n218\t    if (!queue) return 0;\n219\t    return queue.filter(t => t.status === 'pending').length;\n220\t  }\n221\t\n222\t  // ---- Phase 2: Named Queues ----\n223\t\n224\t  listQueues(): string[] {\n225\t    return Array.from(this.queues.keys());\n226\t  }\n227\t\n228\t  queueSize(queueName: string): number {\n229\t    const queue = this.queues.get(queueName);\n230\t    if (!queue) return 0;\n231\t    return queue.filter(t => t.status === 'pending').length;\n232\t  }\n233\t\n234\t  // ---- Phase 5: Retry with Backoff ----\n235\t\n236\t  fail(taskId: string, error?: unknown): void {\n237\t    const task = this.allTasks.get(taskId);\n238\t    if (!task) return;\n239\t\n240\t    task.lastError = error ?? task.lastError;\n241\t    task.failCount = (task.failCount || 0) + 1;\n242\t\n243\t    const retriesUsed = task.attempts - 1;\n244\t    if (retriesUsed < task.maxRetries) {\n245\t      const backoffDelay = task.backoffMs * Math.pow(2, retriesUsed);\n246\t      const now = new Date();\n247\t      task.availableAt = new Date(now.getTime() + backoffDelay);\n248\t      task.status = 'pending';\n249\t\n250\t      const queue = this.queues.get(task.queueName);\n251\t      if (queue) {\n252\t        queue.push(task);\n253\t      }\n254\t    } else {\n255\t      task.status = 'failed';\n256\t      this.moveToDLQ(task);\n257\t    }\n258\t  }\n259\t\n260\t  complete(taskId: string): void {\n261\t    const task = this.allTasks.get(taskId);\n262\t    if (!task) return;\n263\t\n264\t    task.status = 'completed';\n265\t\n266\t    this.checkDependents(taskId);\n267\t  }\n268\t\n269\t  // ---- Phase 6: Dead Letter Queue ----\n270\t\n271\t  getDLQ(queueName: string): Task[] {\n272\t    return this.dlq.get(queueName) ?? [];\n273\t  }\n274\t\n275\t  retryDLQ(taskId: string): Task {\n276\t    let foundQueue: string | null = null;\n277\t    for (const [qName, tasks] of this.dlq.entries()) {\n278\t      const idx = tasks.findIndex(t => t.id === taskId);\n279\t      if (idx !== -1) {\n280\t        foundQueue = qName;\n281\t        tasks.splice(idx, 1);\n282\t        break;\n283\t      }\n284\t    }\n285\t\n286\t    if (!foundQueue) {\n287\t      throw new Error(`Task ${taskId} not found in DLQ`);\n288\t    }\n289\t\n290\t    const task = this.allTasks.get(taskId);\n291\t    if (!task) {\n292\t      throw new Error(`Task ${taskId} not found`);\n293\t    }\n294\t\n295\t    task.status = 'pending';\n296\t    task.attempts = 0;\n297\t    task.failCount = 0;\n298\t    task.availableAt = new Date();\n299\t\n300\t    const queue = this.queues.get(foundQueue);\n301\t    if (queue) {\n302\t      queue.push(task);\n303\t    }\n304\t\n305\t    return task;\n306\t  }\n307\t\n308\t  clearDLQ(queueName: string): void {\n309\t    this.dlq.set(queueName, []);\n310\t  }\n311\t\n312\t  private moveToDLQ(task: Task): void {\n313\t    if (!this.dlq.has(task.queueName)) {\n314\t      this.dlq.set(task.queueName, []);\n315\t    }\n316\t    this.dlq.get(task.queueName)!.push(task);\n317\t  }\n318\t\n319\t  // ---- Phase 7: Task Dependencies ----\n320\t\n321\t  getDependencies(taskId: string): Array<{ taskId: string; status: string }> {\n322\t    const task = this.allTasks.get(taskId);\n323\t    if (!task) {\n324\t      throw new Error(`Task ${taskId} not found`);\n325\t    }\n326\t\n327\t    return task.dependsOn.map(depId => {\n328\t      const depTask = this.allTasks.get(depId);\n329\t      return {\n330\t        taskId: depId,\n331\t        status: depTask?.status ?? 'unknown',\n332\t      };\n333\t    });\n334\t  }\n335\t\n336\t  private areDependenciesMet(task: Task): boolean {\n337\t    if (task.dependsOn.length === 0) return true;\n338\t    for (const depId of task.dependsOn) {\n339\t      const depTask = this.allTasks.get(depId);\n340\t      if (!depTask || depTask.status !== 'completed') {\n341\t        return false;\n342\t      }\n343\t    }\n344\t    return true;\n345\t  }\n346\t\n347\t  private checkDependents(completedTaskId: string): void {\n348\t    for (const task of this.allTasks.values()) {\n349\t      if (task.status === 'pending' && task.dependsOn.includes(completedTaskId)) {\n350\t        // Task may now be unblocked - dequeue will check areDependenciesMet\n351\t      }\n352\t    }\n353\t  }\n354\t\n355\t  // ---- Phase 8: Concurrency Control ----\n356\t\n357\t  setConcurrency(queueName: string, limit: number): void {\n358\t    this.concurrency.set(queueName, limit);\n359\t  }\n360\t\n361\t  getConcurrency(queueName: string): { current: number; max: number } {\n362\t    const max = this.concurrency.get(queueName);\n363\t    return {\n364\t      current: this.countProcessing(queueName),\n365\t      max: max ?? Infinity,\n366\t    };\n367\t  }\n368\t\n369\t  private countProcessing(queueName: string): number {\n370\t    let count = 0;\n371\t    for (const task of this.allTasks.values()) {\n372\t      if (task.queueName === queueName && task.status === 'processing') {\n373\t        count++;\n374\t      }\n375\t    }\n376\t    return count;\n377\t  }\n378\t\n379\t  // ---- Phase 9: Progress and Cancellation ----\n380\t\n381\t  updateProgress(taskId: string, percent: number, message?: string): void {\n382\t    const task = this.allTasks.get(taskId);\n383\t    if (!task) return;\n384\t\n385\t    if (percent < 0 || percent > 100) {\n386\t      throw new Error('Progress must be between 0 and 100');\n387\t    }\n388\t\n389\t    const now = new Date();\n390\t    task.progress = { percent, message, updatedAt: now };\n391\t\n392\t    const subscribers = this.progressSubscribers.get(taskId);\n393\t    if (subscribers) {\n394\t      for (const cb of subscribers) {\n395\t        cb({ percent, message, updatedAt: now });\n396\t      }\n397\t    }\n398\t  }\n399\t\n400\t  getProgress(taskId: string): { percent: number; message?: string; updatedAt: Date } | null {\n401\t    const task = this.allTasks.get(taskId);\n402\t    if (!task) return null;\n403\t    return task.progress;\n404\t  }\n405\t\n406\t  cancel(taskId: string): void {\n407\t    const task = this.allTasks.get(taskId);\n408\t    if (!task) return;\n409\t\n410\t    task.status = 'cancelled';\n411\t\n412\t    const queue = this.queues.get(task.queueName);\n413\t    if (queue) {\n414\t      const idx = queue.indexOf(task);\n415\t      if (idx !== -1) {\n416\t        queue.splice(idx, 1);\n417\t      }\n418\t    }\n419\t  }\n420\t\n421\t  onProgress(taskId: string, callback: (info: { percent: number; message?: string; updatedAt: Date }) => void): () => void {\n422\t    if (!this.progressSubscribers.has(taskId)) {\n423\t      this.progressSubscribers.set(taskId, []);\n424\t    }\n425\t    this.progressSubscribers.get(taskId)!.push(callback);\n426\t\n427\t    return () => {\n428\t      const subs = this.progressSubscribers.get(taskId);\n429\t      if (subs) {\n430\t        const idx = subs.indexOf(callback);\n431\t        if (idx !== -1) {\n432\t          subs.splice(idx, 1);\n433\t        }\n434\t      }\n435\t    };\n436\t  }\n437\t\n438\t  // ---- Phase 10: Recurring Tasks (Cron) ----\n439\t\n440\t  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {\n441\t    const schedule: Schedule = {\n442\t      id: generateId(),\n443\t      queueName,\n444\t      cronExpression,\n445\t      taskTemplate,\n446\t      active: true,\n447\t    };\n448\t    this.schedules.set(schedule.id, schedule);\n449\t    return schedule;\n450\t  }\n451\t\n452\t  unschedule(scheduleId: string): void {\n453\t    const schedule = this.schedules.get(scheduleId);\n454\t    if (schedule) {\n455\t      schedule.active = false;\n456\t    }\n457\t  }\n458\t\n459\t  listSchedules(queueName?: string): Schedule[] {\n460\t    const active = Array.from(this.schedules.values()).filter(s => s.active);\n461\t    if (queueName) {\n462\t      return active.filter(s => s.queueName === queueName);\n463\t    }\n464\t    return active;\n465\t  }\n466\t\n467\t  tick(): void {\n468\t    const now = new Date();\n469\t    for (const schedule of this.schedules.values()) {\n470\t      if (!schedule.active) continue;\n471\t\n472\t      const parsed = parseCron(schedule.cronExpression);\n473\t\n474\t      const key = `${schedule.id}:${now.getUTCFullYear()}-${now.getUTCMonth()}-${now.getUTCDate()}-${now.getUTCHours()}-${now.getUTCMinutes()}`;\n475\t      if (this.lastCronFire.has(key)) continue;\n476\t\n477\t      if (isCronDue(parsed, now)) {\n478\t        this.enqueue(schedule.queueName, schedule.taskTemplate);\n479\t        this.lastCronFire.set(key, 1);\n480\t      }\n481\t    }\n482\t  }\n483\t\n484\t  // ---- Phase 11: Middleware Pipeline ----\n485\t\n486\t  use(queueName: string, middleware: Middleware): void {\n487\t    if (!this.middlewareStacks.has(queueName)) {\n488\t      this.middlewareStacks.set(queueName, []);\n489\t    }\n490\t    this.middlewareStacks.get(queueName)!.push(middleware);\n491\t  }\n492\t\n493\t  async process(queueName: string, handler: TaskHandler): Promise<void> {\n494\t    const task = this.dequeue(queueName);\n495\t    if (!task) return;\n496\t\n497\t    const middlewares = this.middlewareStacks.get(queueName) ?? [];\n498\t\n499\t    try {\n500\t      let i = 0;\n501\t      const next = async (): Promise<void> => {\n502\t        i++;\n503\t        if (i < middlewares.length) {\n504\t          await middlewares[i](task, next);\n505\t        } else {\n506\t          await handler(task);\n507\t        }\n508\t      };\n509\t\n510\t      if (middlewares.length > 0) {\n511\t        await middlewares[0](task, next);\n512\t      } else {\n513\t        await handler(task);\n514\t      }\n515\t    } catch (error) {\n516\t      task.status = 'failed';\n517\t      task.lastError = error;\n518\t      task.failCount = (task.failCount || 0) + 1;\n519\t\n520\t      const retriesUsed = task.attempts - 1;\n521\t      if (retriesUsed < task.maxRetries) {\n522\t        const backoffDelay = task.backoffMs * Math.pow(2, retriesUsed);\n523\t        const now = new Date();\n524\t        task.availableAt = new Date(now.getTime() + backoffDelay);\n525\t        task.status = 'pending';\n526\t        const queue = this.queues.get(task.queueName);\n527\t        if (queue) {\n528\t          queue.push(task);\n529\t        }\n530\t      } else {\n531\t        this.moveToDLQ(task);\n532\t      }\n533\t    }\n534\t  }\n535\t\n536\t  // ---- Phase 12: Graceful Shutdown ----\n537\t\n538\t  onShutdown(callback: () => void): void {\n539\t    this.shutdownCallbacks.push(callback);\n540\t  }\n541\t\n542\t  async shutdown(timeout: number = 30000): Promise<{ completed: number; cancelled: number; elapsed: number }> {\n543\t    if (this.shutdownPromise) {\n544\t      return this.shutdownPromise;\n545\t    }\n546\t\n547\t    const startTime = Date.now();\n548\t    this.isShuttingDown = true;\n549\t\n550\t    for (const cb of this.shutdownCallbacks) {\n551\t      cb();\n552\t    }\n553\t\n554\t    const processingTasks = Array.from(this.allTasks.values()).filter(\n555\t      t => t.status === 'processing'\n556\t    );\n557\t\n558\t    if (processingTasks.length === 0) {\n559\t      const elapsed = Date.now() - startTime;\n560\t      const result = { completed: 0, cancelled: 0, elapsed };\n561\t      this.shutdownPromise = Promise.resolve(result);\n562\t      return result;\n563\t    }\n564\t\n565\t    const result = { completed: 0, cancelled: 0, elapsed: 0 };\n566\t\n567\t    const checkDone = (): boolean => {\n568\t      for (const task of processingTasks) {\n569\t        if (task.status === 'processing') {\n570\t          return false;\n571\t        }\n572\t      }\n573\t      return true;\n574\t    };\n575\t\n576\t    const promise = new Promise<{ completed: number; cancelled: number; elapsed: number }>((resolve) => {\n577\t      const pollInterval = setInterval(() => {\n578\t        if (checkDone()) {\n579\t          clearInterval(pollInterval);\n580\t          clearTimeout(timeoutTimer);\n581\t          for (const task of processingTasks) {\n582\t            if (task.status === 'completed') {\n583\t              result.completed++;\n584\t            }\n585\t          }\n586\t          result.elapsed = Date.now() - startTime;\n587\t          resolve(result);\n588\t        }\n589\t      }, 10);\n590\t\n591\t      const timeoutTimer = setTimeout(() => {\n592\t        clearInterval(pollInterval);\n593\t        for (const task of processingTasks) {\n594\t          if (task.status === 'processing') {\n595\t            task.status = 'cancelled';\n596\t            result.cancelled++;\n597\t          }\n598\t        }\n599\t        for (const task of processingTasks) {\n600\t          if (task.status === 'completed') {\n601\t            result.completed++;\n602\t          }\n603\t        }\n604\t        result.elapsed = Date.now() - startTime;\n605\t        resolve(result);\n606\t      }, timeout);\n607\t    });\n608\t\n609\t    this.shutdownPromise = promise;\n610\t    return promise;\n611\t  }\n612\t}\n613\t"}]},"parent_tool_use_id":null,"session_id":"f2d134c7-fc2f-4820-8837-9ae8f9637f0d","uuid":"47130c37-155d-42e1-adf5-58cd3298915e","timestamp":"2026-07-25T18:01:16.554Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/index.ts","content":"// Types\n\nexport interface Task {\n  id: string;\n  payload: unknown;\n  status: 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';\n  createdAt: Date;\n  queueName: string;\n  priority: number;\n  availableAt: Date;\n  maxRetries: number;\n  backoffMs: number;\n  attempts: number;\n  failCount: number;\n  lastError: unknown;\n  dependsOn: string[];\n  progress: { percent: number; message?: string; updatedAt: Date } | null;\n}\n\nexport interface EnqueueOptions {\n  priority?: number;\n  delay?: number;\n  runAt?: Date;\n  maxRetries?: number;\n  backoffMs?: number;\n  dependsOn?: string[];\n}\n\nexport interface Schedule {\n  id: string;\n  queueName: string;\n  cronExpression: string;\n  taskTemplate: unknown;\n  active: boolean;\n}\n\nexport type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;\nexport type TaskHandler = (task: Task) => Promise<void>;\n\n// UUID generator (simple v4-like)\nfunction generateId(): string {\n  const bytes = new Uint8Array(16);\n  for (let i = 0; i < 16; i++) {\n    bytes[i] = Math.floor(Math.random() * 256);\n  }\n  bytes[6] = (bytes[6] & 0x0f) | 0x40;\n  bytes[8] = (bytes[8] & 0x3f) | 0x80;\n  const hex = bytes.reduce((s, b) => s + b.toString(16).padStart(2, '0'), '');\n  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;\n}\n\n// Cron parser for simple expressions\nfunction parseCron(expr: string): { minutes: number[]; hours: number[]; days: number[]; months: number[]; weekdays: number[] } {\n  const parts = expr.trim().split(/\\s+/);\n  if (parts.length !== 5) {\n    throw new Error(`Invalid cron expression: ${expr}`);\n  }\n\n  const parseField = (field: string, min: number, max: number): number[] => {\n    if (field === '*') {\n      return Array.from({ length: max - min + 1 }, (_, i) => min + i);\n    }\n    if (field.startsWith('*/')) {\n      const step = parseInt(field.slice(2), 10);\n      const result: number[] = [];\n      for (let i = min; i <= max; i += step) {\n        result.push(i);\n      }\n      return result;\n    }\n    if (field.includes(',')) {\n      return field.split(',').map(s => parseInt(s.trim(), 10));\n    }\n    return [parseInt(field, 10)];\n  };\n\n  return {\n    minutes: parseField(parts[0], 0, 59),\n    hours: parseField(parts[1], 0, 23),\n    days: parseField(parts[2], 1, 31),\n    months: parseField(parts[3], 1, 12),\n    weekdays: parseField(parts[4], 0, 6),\n  };\n}\n\nfunction isCronDue(parsed: ReturnType<typeof parseCron>, now: Date): boolean {\n  return (\n    parsed.minutes.includes(now.getUTCMinutes()) &&\n    parsed.hours.includes(now.getUTCHours()) &&\n    parsed.days.includes(now.getUTCDate()) &&\n    parsed.months.includes(now.getUTCMonth() + 1) &&\n    parsed.weekdays.includes(now.getUTCDay())\n  );\n}\n\nexport class TaskQueue {\n  private queues: Map<string, Task[]> = new Map();\n  private allTasks: Map<string, Task> = new Map();\n  private dlq: Map<string, Task[]> = new Map();\n  private schedules: Map<string, Schedule> = new Map();\n  private concurrency: Map<string, number> = new Map();\n  private progressSubscribers: Map<string, Array<(info: { percent: number; message?: string; updatedAt: Date }) => void>> = new Map();\n  private shutdownCallbacks: Array<() => void> = [];\n  private isShuttingDown: boolean = false;\n  private shutdownPromise: Promise<{ completed: number; cancelled: number; elapsed: number }> | null = null;\n  private middlewareStacks: Map<string, Middleware[]> = new Map();\n  private lastCronFire: Map<string, number> = new Map();\n\n  constructor() {\n    this.queues.set('default', []);\n  }\n\n  // ---- Phase 1: Basic FIFO Queue ----\n\n  enqueue(queueName: string, payload: unknown, options?: EnqueueOptions): Task {\n    if (this.isShuttingDown) {\n      throw new Error('Cannot enqueue tasks after shutdown');\n    }\n\n    const priority = options?.priority ?? 5;\n    if (priority < 1 || priority > 10) {\n      throw new Error(`Priority must be between 1 and 10, got ${priority}`);\n    }\n\n    if (options?.dependsOn) {\n      for (const depId of options.dependsOn) {\n        if (!this.allTasks.has(depId)) {\n          throw new Error(`Dependency task ${depId} does not exist`);\n        }\n      }\n    }\n\n    const now = new Date();\n    let availableAt: Date;\n    if (options?.runAt) {\n      availableAt = options.runAt;\n    } else if (options?.delay) {\n      availableAt = new Date(now.getTime() + options.delay);\n    } else {\n      availableAt = now;\n    }\n\n    const task: Task = {\n      id: generateId(),\n      payload,\n      status: 'pending',\n      createdAt: now,\n      queueName,\n      priority,\n      availableAt,\n      maxRetries: options?.maxRetries ?? 3,\n      backoffMs: options?.backoffMs ?? 1000,\n      attempts: 0,\n      failCount: 0,\n      lastError: null,\n      dependsOn: options?.dependsOn ?? [],\n      progress: null,\n    };\n\n    this.allTasks.set(task.id, task);\n\n    if (!this.queues.has(queueName)) {\n      this.queues.set(queueName, []);\n    }\n    this.queues.get(queueName)!.push(task);\n\n    return task;\n  }\n\n  dequeue(queueName: string): Task | null {\n