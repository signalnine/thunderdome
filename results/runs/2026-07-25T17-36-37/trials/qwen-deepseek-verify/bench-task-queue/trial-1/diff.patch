scribe('Phase 3: Priority', () => {\n158\t  let queue: TaskQueue;\n159\t\n160\t  beforeEach(() => {\n161\t    queue = new TaskQueue();\n162\t  });\n163\t\n164\t  it('higher priority task is dequeued first', () => {\n165\t    queue.enqueue('work', { name: 'low' }, { priority: 8 });\n166\t    queue.enqueue('work', { name: 'high' }, { priority: 2 });\n167\t\n168\t    const task = queue.dequeue('work');\n169\t    expect(task!.payload).toEqual({ name: 'high' });\n170\t  });\n171\t\n172\t  it('same priority maintains FIFO order', () => {\n173\t    queue.enqueue('work', { order: 'first' }, { priority: 5 });\n174\t    queue.enqueue('work', { order: 'second' }, { priority: 5 });\n175\t    queue.enqueue('work', { order: 'third' }, { priority: 5 });\n176\t\n177\t    expect(queue.dequeue('work')!.payload).toEqual({ order: 'first' });\n178\t    expect(queue.dequeue('work')!.payload).toEqual({ order: 'second' });\n179\t    expect(queue.dequeue('work')!.payload).toEqual({ order: 'third' });\n180\t  });\n181\t\n182\t  it('default priority is 5', () => {\n183\t    const task = queue.enqueue('work', { test: true });\n184\t    expect(task.priority).toBe(5);\n185\t  });\n186\t\n187\t  it('priority 1 is dequeued before priority 10', () => {\n188\t    queue.enqueue('work', { name: 'lowest' }, { priority: 10 });\n189\t    queue.enqueue('work', { name: 'highest' }, { priority: 1 });\n190\t\n191\t    const task = queue.dequeue('work');\n192\t    expect(task!.payload).toEqual({ name: 'highest' });\n193\t  });\n194\t\n195\t  it('three different priorities dequeue in correct order', () => {\n196\t    queue.enqueue('work', { p: 'medium' }, { priority: 5 });\n197\t    queue.enqueue('work', { p: 'low' }, { priority: 9 });\n198\t    queue.enqueue('work', { p: 'high' }, { priority: 1 });\n199\t\n200\t    expect(queue.dequeue('work')!.payload).toEqual({ p: 'high' });\n201\t    expect(queue.dequeue('work')!.payload).toEqual({ p: 'medium' });\n202\t    expect(queue.dequeue('work')!.payload).toEqual({ p: 'low' });\n203\t  });\n204\t\n205\t  it('later enqueued high priority beats earlier low priority', () => {\n206\t    queue.enqueue('work', { name: 'first-low' }, { priority: 8 });\n207\t    queue.enqueue('work', { name: 'second-high' }, { priority: 2 });\n208\t\n209\t    const task = queue.dequeue('work');\n210\t    expect(task!.payload).toEqual({ name: 'second-high' });\n211\t  });\n212\t\n213\t  it('priority works independently per named queue', () => {\n214\t    queue.enqueue('queue-a', { name: 'a-low' }, { priority: 9 });\n215\t    queue.enqueue('queue-a', { name: 'a-high' }, { priority: 1 });\n216\t    queue.enqueue('queue-b', { name: 'b-only' }, { priority: 7 });\n217\t\n218\t    expect(queue.dequeue('queue-a')!.payload).toEqual({ name: 'a-high' });\n219\t    expect(queue.dequeue('queue-b')!.payload).toEqual({ name: 'b-only' });\n220\t  });\n221\t\n222\t  it('throws error for priority outside 1-10 range', () => {\n223\t    expect(() => queue.enqueue('work', {}, { priority: 0 })).toThrow();\n224\t    expect(() => queue.enqueue('work', {}, { priority: 11 })).toThrow();\n225\t    expect(() => queue.enqueue('work', {}, { priority: -1 })).toThrow();\n226\t  });\n227\t});\n228\t\n229\t=== phase-04.test.ts ===\n230\timport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\n231\timport { TaskQueue } from '../src/index.js';\n232\t\n233\tdescribe('Phase 4: Delayed/Scheduled Tasks', () => {\n234\t  let queue: TaskQueue;\n235\t\n236\t  beforeEach(() => {\n237\t    vi.useFakeTimers();\n238\t    queue = new TaskQueue();\n239\t  });\n240\t\n241\t  afterEach(() => {\n242\t    vi.useRealTimers();\n243\t  });\n244\t\n245\t  it('delayed task is not available immediately', () => {\n246\t    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n247\t    const task = queue.dequeue('work');\n248\t    expect(task).toBeNull();\n249\t  });\n250\t\n251\t  it('delayed task becomes available after delay period', () => {\n252\t    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n253\t\n254\t    vi.advanceTimersByTime(5000);\n255\t\n256\t    const task = queue.dequeue('work');\n257\t    expect(task).not.toBeNull();\n258\t    expect(task!.payload).toEqual({ delayed: true });\n259\t  });\n260\t\n261\t  it('runAt task is not available before the specified time', () => {\n262\t    const futureDate = new Date(Date.now() + 10000);\n263\t    queue.enqueue('work', { scheduled: true }, { runAt: futureDate });\n264\t\n265\t    const task = queue.dequeue('work');\n266\t    expect(task).toBeNull();\n267\t  });\n268\t\n269\t  it('runAt task becomes available at the specified time', () => {\n270\t    const futureDate = new Date(Date.now() + 10000);\n271\t    queue.enqueue('work', { scheduled: true }, { runAt: futureDate });\n272\t\n273\t    vi.advanceTimersByTime(10000);\n274\t\n275\t    const task = queue.dequeue('work');\n276\t    expect(task).not.toBeNull();\n277\t    expect(task!.payload).toEqual({ scheduled: true });\n278\t  });\n279\t\n280\t  it('non-delayed tasks dequeued before delayed tasks still waiting', () => {\n281\t    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n282\t    queue.enqueue('work', { immediate: true });\n283\t\n284\t    const task = queue.dequeue('work');\n285\t    expect(task!.payload).toEqual({ immediate: true });\n286\t  });\n287\t\n288\t  it('multiple delayed tasks ordered by availability time', () => {\n289\t    queue.enqueue('work', { name: 'later' }, { delay: 10000 });\n290\t    queue.enqueue('work', { name: 'sooner' }, { delay: 3000 });\n291\t\n292\t    vi.advanceTimersByTime(10000);\n293\t\n294\t    const first = queue.dequeue('work');\n295\t    const second = queue.dequeue('work');\n296\t\n297\t    expect(first!.payload).toEqual({ name: 'sooner' });\n298\t    expect(second!.payload).toEqual({ name: 'later' });\n299\t  });\n300\t\n301\t  it('delay works with named queues', () => {\n302\t    queue.enqueue('fast', { name: 'fast-delayed' }, { delay: 2000 });\n303\t    queue.enqueue('slow', { name: 'slow-delayed' }, { delay: 8000 });\n304\t\n305\t    vi.advanceTimersByTime(2000);\n306\t\n307\t    expect(queue.dequeue('fast')).not.toBeNull();\n308\t    expect(queue.dequeue('slow')).toBeNull();\n309\t\n310\t    vi.advanceTimersByTime(6000);\n311\t\n312\t    expect(queue.dequeue('slow')).not.toBeNull();\n313\t  });\n314\t});\n315\t\n316\t=== phase-05.test.ts ===\n317\timport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\n318\timport { TaskQueue } from '../src/index.js';\n319\t\n320\tdescribe('Phase 5: Retry with Backoff', () => {\n321\t  let queue: TaskQueue;\n322\t\n323\t  beforeEach(() => {\n324\t    vi.useFakeTimers();\n325\t    queue = new TaskQueue();\n326\t  });\n327\t\n328\t  afterEach(() => {\n329\t    vi.useRealTimers();\n330\t  });\n331\t\n332\t  it('fail marks a processing task as failed', () => {\n333\t    queue.enqueue('work', { job: 'test' }, { maxRetries: 0 });\n334\t    const task = queue.dequeue('work')!;\n335\t    queue.fail(task.id, 'something went wrong');\n336\t\n337\t    // With maxRetries: 0, no retry - task stays failed\n338\t    expect(task.status).toBe('failed');\n339\t  });\n340\t\n341\t  it('failed task is re-enqueued automatically when retries remain', () => {\n342\t    queue.enqueue('work', { job: 'retry-me' });\n343\t    const task = queue.dequeue('work')!;\n344\t    queue.fail(task.id, 'transient error');\n345\t\n346\t    // After backoff delay, task should be available again\n347\t    vi.advanceTimersByTime(1000); // first retry: 1000ms\n348\t    const retried = queue.dequeue('work');\n349\t    expect(retried).not.toBeNull();\n350\t    expect(retried!.id).toBe(task.id);\n351\t  });\n352\t\n353\t  it('task attempts count is incremented on each retry', () => {\n354\t    queue.enqueue('work', { job: 'count-attempts' });\n355\t    const task = queue.dequeue('work')!;\n356\t    expect(task.attempts).toBe(1);\n357\t\n358\t    queue.fail(task.id, 'error');\n359\t    vi.advanceTimersByTime(1000);\n360\t\n361\t    const retry1 = queue.dequeue('work')!;\n362\t    expect(retry1.attempts).toBe(2);\n363\t  });\n364\t\n365\t  it('backoff delay increases exponentially between retries', () => {\n366\t    queue.enqueue('work', { job: 'backoff-test' });\n367\t\n368\t    // First attempt\n369\t    const task = queue.dequeue('work')!;\n370\t    queue.fail(task.id, 'error 1');\n371\t\n372\t    // First retry after 1000ms (1000 * 2^0)\n373\t    vi.advanceTimersByTime(999);\n374\t    expect(queue.dequeue('work')).toBeNull();\n375\t    vi.advanceTimersByTime(1);\n376\t    expect(queue.dequeue('work')).not.toBeNull();\n377\t\n378\t    queue.fail(task.id, 'error 2');\n379\t\n380\t    // Second retry after 2000ms (1000 * 2^1)\n381\t    vi.advanceTimersByTime(1999);\n382\t    expect(queue.dequeue('work')).toBeNull();\n383\t    vi.advanceTimersByTime(1);\n384\t    expect(queue.dequeue('work')).not.toBeNull();\n385\t\n386\t    queue.fail(task.id, 'error 3');\n387\t\n388\t    // Third retry after 4000ms (1000 * 2^2)\n389\t    vi.advanceTimersByTime(3999);\n390\t    expect(queue.dequeue('work')).toBeNull();\n391\t    vi.advanceTimersByTime(1);\n392\t    expect(queue.dequeue('work')).not.toBeNull();\n393\t  });\n394\t\n395\t  it('respects maxRetries limit (default 3)', () => {\n396\t    queue.enqueue('work', { job: 'limited' });\n397\t\n398\t    for (let i = 0; i < 3; i++) {\n399\t      const task = queue.dequeue('work')!;\n400\t      expect(task).not.toBeNull();\n401\t      queue.fail(task.id, `error ${i + 1}`);\n402\t      vi.advanceTimersByTime(1000 * Math.pow(2, i));\n403\t    }\n404\t\n405\t    // Fourth attempt\n406\t    const lastAttempt = queue.dequeue('work')!;\n407\t    expect(lastAttempt).not.toBeNull();\n408\t    queue.fail(lastAttempt.id, 'final error');\n409\t\n410\t    // No more retries - should not re-appear\n411\t    vi.advanceTimersByTime(100000);\n412\t    expect(queue.dequeue('work')).toBeNull();\n413\t  });\n414\t\n415\t  it('accepts custom maxRetries option', () => {\n416\t    queue.enqueue('work', { job: 'custom' }, { maxRetries: 1 });\n417\t\n418\t    // First attempt\n419\t    const task = queue.dequeue('work')!;\n420\t    queue.fail(task.id, 'error 1');\n421\t    vi.advanceTimersByTime(1000);\n422\t\n423\t    // Second attempt (1 retry)\n424\t    const retry = queue.dequeue('work')!;\n425\t    expect(retry).not.toBeNull();\n426\t    queue.fail(retry.id, 'error 2');\n427\t\n428\t    // No more retries\n429\t    vi.advanceTimersByTime(100000);\n430\t    expect(queue.dequeue('work')).toBeNull();\n431\t  });\n432\t\n433\t  it('retry preserves the original queue name', () => {\n434\t    queue.enqueue('special-queue', { job: 'preserve-queue' });\n435\t    const task = queue.dequeue('special-queue')!;\n436\t    queue.fail(task.id, 'error');\n437\t    vi.advanceTimersByTime(1000);\n438\t\n439\t    // Should appear in the same queue\n440\t    const retried = queue.dequeue('special-queue');\n441\t    expect(retried).not.toBeNull();\n442\t    expect(retried!.id).toBe(task.id);\n443\t\n444\t    // Should not appear in other queues\n445\t    expect(queue.dequeue('default')).toBeNull();\n446\t  });\n447\t\n448\t  it('retry preserves the original priority', () => {\n449\t    queue.enqueue('work', { job: 'high-pri' }, { priority: 1 });\n450\t    queue.enqueue('work', { job: 'low-pri' }, { priority: 9 });\n451\t\n452\t    const highPri = queue.dequeue('work')!;\n453\t    expect(highPri.payload).toEqual({ job: 'high-pri' });\n454\t    queue.fail(highPri.id, 'error');\n455\t    vi.advanceTimersByTime(1000);\n456\t\n457\t    // The retried high-priority task should still come before low-priority\n458\t    const next = queue.dequeue('work')!;\n459\t    expect(next.payload).toEqual({ job: 'high-pri' });\n460\t  });\n461\t});\n462\t\n463\t=== phase-06.test.ts ===\n464\timport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\n465\timport { TaskQueue } from '../src/index.js';\n466\t\n467\tdescribe('Phase 6: Dead Letter Queue', () => {\n468\t  let queue: TaskQueue;\n469\t\n470\t  beforeEach(() => {\n471\t    vi.useFakeTimers();\n472\t    queue = new TaskQueue();\n473\t  });\n474\t\n475\t  afterEach(() => {\n476\t    vi.useRealTimers();\n477\t  });\n478\t\n479\t  it('task moves to DLQ after exhausting all retries', () => {\n480\t    queue.enqueue('work', { job: 'doomed' }, { maxRetries: 1 });\n481\t\n482\t    // First attempt\n483\t    const task = queue.dequeue('work')!;\n484\t    queue.fail(task.id, 'error 1');\n485\t    vi.advanceTimersByTime(1000);\n486\t\n487\t    // Second attempt (1 retry)\n488\t    const retry = queue.dequeue('work')!;\n489\t    queue.fail(retry.id, 'error 2');\n490\t\n491\t    // Should be in DLQ now\n492\t    const dlq = queue.getDLQ('work');\n493\t    expect(dlq.length).toBe(1);\n494\t    expect(dlq[0].id).toBe(task.id);\n495\t  });\n496\t\n497\t  it('getDLQ returns all dead-letter tasks for a queue', () => {\n498\t    queue.enqueue('work', { job: 'doomed1' }, { maxRetries: 0 });\n499\t    queue.enqueue('work', { job: 'doomed2' }, { maxRetries: 0 });\n500\t\n501\t    const t1 = queue.dequeue('work')!;\n502\t    queue.fail(t1.id, 'error');\n503\t    const t2 = queue.dequeue('work')!;\n504\t    queue.fail(t2.id, 'error');\n505\t\n506\t    const dlq = queue.getDLQ('work');\n507\t    expect(dlq.length).toBe(2);\n508\t  });\n509\t\n510\t  it('retryDLQ moves task back to its original queue', () => {\n511\t    queue.enqueue('emails', { job: 'retry-dlq' }, { maxRetries: 0 });\n512\t\n513\t    const task = queue.dequeue('emails')!;\n514\t    queue.fail(task.id, 'error');\n515\t\n516\t    expect(queue.getDLQ('emails').length).toBe(1);\n517\t\n518\t    const retried = queue.retryDLQ(task.id);\n519\t    expect(retried).not.toBeNull();\n520\t\n521\t    // DLQ should be empty now\n522\t    expect(queue.getDLQ('emails').length).toBe(0);\n523\t\n524\t    // Task should be back in the queue\n525\t    const dequeued = queue.dequeue('emails');\n526\t    expect(dequeued).not.toBeNull();\n527\t    expect(dequeued!.id).toBe(task.id);\n528\t  });\n529\t\n530\t  it('clearDLQ removes all DLQ tasks for a queue', () => {\n531\t    queue.enqueue('work', { job: 'clear1' }, { maxRetries: 0 });\n532\t    queue.enqueue('work', { job: 'clear2' }, { maxRetries: 0 });\n533\t\n534\t    const t1 = queue.dequeue('work')!;\n535\t    queue.fail(t1.id, 'error');\n536\t    const t2 = queue.dequeue('work')!;\n537\t    queue.fail(t2.id, 'error');\n538\t\n539\t    expect(queue.getDLQ('work').length).toBe(2);\n540\t    queue.clearDLQ('work');\n541\t    expect(queue.getDLQ('work').length).toBe(0);\n542\t  });\n543\t\n544\t  it('DLQ task retains original error information', () => {\n545\t    queue.enqueue('work', { job: 'error-info' }, { maxRetries: 0 });\n546\t\n547\t    const task = queue.dequeue('work')!;\n548\t    queue.fail(task.id, 'specific error message');\n549\t\n550\t    const dlq = queue.getDLQ('work');\n551\t    expect(dlq[0].lastError).toBe('specific error message');\n552\t  });\n553\t\n554\t  it('DLQ task tracks failure count', () => {\n555\t    queue.enqueue('work', { job: 'count-fails' }, { maxRetries: 2 });\n556\t\n557\t    // Fail through all retries\n558\t    for (let i = 0; i < 2; i++) {\n559\t      const task = queue.dequeue('work')!;\n560\t      queue.fail(task.id, `error ${i}`);\n561\t      vi.advanceTimersByTime(1000 * Math.pow(2, i));\n562\t    }\n563\t    const lastAttempt = queue.dequeue('work')!;\n564\t    queue.fail(lastAttempt.id, 'final error');\n565\t\n566\t    const dlq = queue.getDLQ('work');\n567\t    expect(dlq[0].failCount).toBe(3); // original + 2 retries = 3 failures\n568\t  });\n569\t\n570\t  it('retried DLQ task gets a fresh retry count', () => {\n571\t    queue.enqueue('work', { job: 'fresh-retries' }, { maxRetries: 1 });\n572\t\n573\t    // Exhaust retries\n574\t    const t1 = queue.dequeue('work')!;\n575\t    queue.fail(t1.id, 'error 1');\n576\t    vi.advanceTimersByTime(1000);\n577\t    const t2 = queue.dequeue('work')!;\n578\t    queue.fail(t2.id, 'error 2');\n579\t\n580\t    // Should be in DLQ\n581\t    expect(queue.getDLQ('work').length).toBe(1);\n582\t\n583\t    // Retry from DLQ\n584\t    queue.retryDLQ(t1.id);\n585\t    const retried = queue.dequeue('work')!;\n586\t    expect(retried).not.toBeNull();\n587\t    expect(retried.attempts).toBe(1); // fresh attempt count\n588\t\n589\t    // Should have fresh retries available\n590\t    queue.fail(retried.id, 'new error');\n591\t    vi.advanceTimersByTime(1000);\n592\t    const retry = queue.dequeue('work');\n593\t    expect(retry).not.toBeNull(); // can retry again\n594\t  });\n595\t});\n596\t\n597\t=== phase-07.test.ts ===\n598\timport { describe, it, expect, beforeEach } from 'vitest';\n599\timport { TaskQueue } from '../src/index.js';\n600\t\n601\tdescribe('Phase 7: Task Dependencies', () => {\n602\t  let queue: TaskQueue;\n603\t\n604\t  beforeEach(() => {\n605\t    queue = new TaskQueue();\n606\t  });\n607\t\n608\t  it('task with dependencies is not available until deps complete', () => {\n609\t    const dep = queue.enqueue('work', { name: 'dependency' });\n610\t    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n611\t\n612\t    // Dequeue should return the dependency first (no deps blocking it)\n613\t    const first = queue.dequeue('work');\n614\t    expect(first!.payload).toEqual({ name: 'dependency' });\n615\t\n616\t    // Dependent should not be available yet\n617\t    const second = queue.dequeue('work');\n618\t    expect(second).toBeNull();\n619\t  });\n620\t\n621\t  it('completing a dependency makes dependent task available', () => {\n622\t    const dep = queue.enqueue('work', { name: 'dependency' });\n623\t    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n624\t\n625\t    const task = queue.dequeue('work')!;\n626\t    queue.complete(task.id);\n627\t\n628\t    // Now the dependent should be available\n629\t    const dependent = queue.dequeue('work');\n630\t    expect(dependent).not.toBeNull();\n631\t    expect(dependent!.payload).toEqual({ name: 'dependent' });\n632\t  });\n633\t\n634\t  it('all dependencies must complete before dependent is available', () => {\n635\t    const dep1 = queue.enqueue('work', { name: 'dep1' });\n636\t    const dep2 = queue.enqueue('work', { name: 'dep2' });\n637\t    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep1.id, dep2.id] });\n638\t\n639\t    // Process dep1\n640\t    const task1 = queue.dequeue('work')!;\n641\t    queue.complete(task1.id);\n642\t\n643\t    // dep2 should be available but dependent should not\n644\t    const task2 = queue.dequeue('work')!;\n645\t    expect(task2.payload).toEqual({ name: 'dep2' });\n646\t\n647\t    // Dependent still blocked (dep2 not completed yet)\n648\t    expect(queue.dequeue('work')).toBeNull();\n649\t\n650\t    // Complete dep2\n651\t    queue.complete(task2.id);\n652\t\n653\t    // Now dependent is available\n654\t    const dependent = queue.dequeue('work');\n655\t    expect(dependent).not.toBeNull();\n656\t    expect(dependent!.payload).toEqual({ name: 'dependent' });\n657\t  });\n658\t\n659\t  it('circular dependency throws an error', () => {\n660\t    const a = queue.enqueue('work', { name: 'A' });\n661\t    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [a.id] });\n662\t\n663\t    // Trying to make A depend on B creates a cycle\n664\t    expect(() =>\n665\t      queue.enqueue('work', { name: 'C' }, { dependsOn: [b.id, a.id] })\n666\t    ).not.toThrow(); // C -> B -> A is fine, no cycle\n667\t\n668\t    // Direct cycle: X depends on Y, Y depends on X\n669\t    const x = queue.enqueue('work', { name: 'X' });\n670\t    queue.enqueue('work', { name: 'Y' }, { dependsOn: [x.id] });\n671\t\n672\t    // This should not throw since there's no actual circular dependency here\n673\t    // A true circular dependency:\n674\t    const m = queue.enqueue('work', { name: 'M' });\n675\t    const n = queue.enqueue('work', { name: 'N' }, { dependsOn: [m.id] });\n676\t    expect(() =>\n677\t      queue.enqueue('work', { name: 'O' }, { dependsOn: [n.id, m.id] })\n678\t    ).not.toThrow(); // O -> N -> M is fine\n679\t\n680\t    // Real cycle detection test\n681\t    const p = queue.enqueue('other', { name: 'P' });\n682\t    const _q2 = queue.enqueue('other', { name: 'Q' }, { dependsOn: [p.id] });\n683\t    // Cycle detection is verified above; with forward-only enqueue,\n684\t    // cycles can only be detected at enqueue time through transitive dep chains.\n685\t  });\n686\t\n687\t  it('getDependencies returns dependency info with statuses', () => {\n688\t    const dep1 = queue.enqueue('work', { name: 'dep1' });\n689\t    const dep2 = queue.enqueue('work', { name: 'dep2' });\n690\t    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n691\t      dependsOn: [dep1.id, dep2.id],\n692\t    });\n693\t\n694\t    const deps = queue.getDependencies(dependent.id);\n695\t    expect(deps).toHaveLength(2);\n696\t    expect(deps).toContainEqual({ taskId: dep1.id, status: 'pending' });\n697\t    expect(deps).toContainEqual({ taskId: dep2.id, status: 'pending' });\n698\t\n699\t    // After completing one\n700\t    const task = queue.dequeue('work')!;\n701\t    queue.complete(task.id);\n702\t\n703\t    const updatedDeps = queue.getDependencies(dependent.id);\n704\t    const completedDep = updatedDeps.find(d => d.taskId === dep1.id);\n705\t    expect(completedDep!.status).toBe('completed');\n706\t  });\n707\t\n708\t  it('cascading dependencies work correctly (A depends on B depends on C)', () => {\n709\t    const c = queue.enqueue('work', { name: 'C' });\n710\t    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [c.id] });\n711\t    const a = queue.enqueue('work', { name: 'A' }, { dependsOn: [b.id] });\n712\t\n713\t    // Only C is available\n714\t    const taskC = queue.dequeue('work')!;\n715\t    expect(taskC.payload).toEqual({ name: 'C' });\n716\t    expect(queue.dequeue('work')).toBeNull();\n717\t\n718\t    queue.complete(taskC.id);\n719\t\n720\t    // Now B is available\n721\t    const taskB = queue.dequeue('work')!;\n722\t    expect(taskB.payload).toEqual({ name: 'B' });\n723\t    expect(queue.dequeue('work')).toBeNull();\n724\t\n725\t    queue.complete(taskB.id);\n726\t\n727\t    // Now A is available\n728\t    const taskA = queue.dequeue('work')!;\n729\t    expect(taskA.payload).toEqual({ name: 'A' });\n730\t    expect(taskA.id).toBe(a.id);\n731\t  });\n732\t\n733\t  it('failed dependency does not auto-fail the dependent task', () => {\n734\t    const dep = queue.enqueue('work', { name: 'dep' }, { maxRetries: 0 });\n735\t    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n736\t      dependsOn: [dep.id],\n737\t    });\n738\t\n739\t    const task = queue.dequeue('work')!;\n740\t    queue.fail(task.id, 'dep failed');\n741\t\n742\t    // Dependent stays blocked (not failed)\n743\t    expect(dependent.status).toBe('pending');\n744\t    expect(queue.dequeue('work')).toBeNull();\n745\t  });\n746\t\n747\t  it('dependency on non-existent task throws an error', () => {\n748\t    expect(() =>\n749\t      queue.enqueue('work', { name: 'orphan' }, { dependsOn: ['nonexistent-id'] })\n750\t    ).toThrow();\n751\t  });\n752\t});\n753\t\n754\t=== phase-08.test.ts ===\n755\timport { describe, it, expect, beforeEach } from 'vitest';\n756\timport { TaskQueue } from '../src/index.js';\n757\t\n758\tdescribe('Phase 8: Concurrency Control', () => {\n759\t  let queue: TaskQueue;\n760\t\n761\t  beforeEach(() => {\n762\t    queue = new TaskQueue();\n763\t  });\n764\t\n765\t  it('setConcurrency limits the number of concurrent processing tasks', () => {\n766\t    queue.setConcurrency('work', 2);\n767\t    queue.enqueue('work', { job: 1 });\n768\t    queue.enqueue('work', { job: 2 });\n769\t    queue.enqueue('work', { job: 3 });\n770\t\n771\t    const t1 = queue.dequeue('work');\n772\t    const t2 = queue.dequeue('work');\n773\t    expect(t1).not.toBeNull();\n774\t    expect(t2).not.toBeNull();\n775\t\n776\t    // Third dequeue should return null (at limit)\n777\t    const t3 = queue.dequeue('work');\n778\t    expect(t3).toBeNull();\n779\t  });\n780\t\n781\t  it('dequeue returns null when at concurrency limit even if tasks available', () => {\n782\t    queue.setConcurrency('work', 1);\n783\t    queue.enqueue('work', { job: 'a' });\n784\t    queue.enqueue('work', { job: 'b' });\n785\t\n786\t    queue.dequeue('work'); // takes slot\n787\t    const second = queue.dequeue('work');\n788\t    expect(second).toBeNull();\n789\t  });\n790\t\n791\t  it('completing a task frees a concurrency slot', () => {\n792\t    queue.setConcurrency('work', 1);\n793\t    queue.enqueue('work', { job: 'first' });\n794\t    queue.enqueue('work', { job: 'second' });\n795\t\n796\t    const first = queue.dequeue('work')!;\n797\t    expect(queue.dequeue('work')).toBeNull(); // at limit\n798\t\n799\t    queue.complete(first.id);\n800\t\n801\t    const second = queue.dequeue('work');\n802\t    expect(second).not.toBeNull();\n803\t    expect(second!.payload).toEqual({ job: 'second' });\n804\t  });\n805\t\n806\t  it('getConcurrency returns current and max info', () => {\n807\t    queue.setConcurrency('work', 3);\n808\t    queue.enqueue('work', { job: 1 });\n809\t    queue.enqueue('work', { job: 2 });\n810\t\n811\t    const info1 = queue.getConcurrency('work');\n812\t    expect(info1.max).toBe(3);\n813\t    expect(info1.current).toBe(0);\n814\t\n815\t    queue.dequeue('work');\n816\t    const info2 = queue.getConcurrency('work');\n817\t    expect(info2.current).toBe(1);\n818\t\n819\t    queue.dequeue('work');\n820\t    const info3 = queue.getConcurrency('work');\n821\t    expect(info3.current).toBe(2);\n822\t  });\n823\t\n824\t  it('default concurrency is unlimited', () => {\n825\t    for (let i = 0; i < 100; i++) {\n826\t      queue.enqueue('work', { job: i });\n827\t    }\n828\t\n829\t    const tasks = [];\n830\t    for (let i = 0; i < 100; i++) {\n831\t      const t = queue.dequeue('work');\n832\t      if (!t) break;\n833\t      tasks.push(t);\n834\t    }\n835\t\n836\t    expect(tasks.length).toBe(100);\n837\t  });\n838\t\n839\t  it('concurrency limits are independent per queue', () => {\n840\t    queue.setConcurrency('queue-a', 1);\n841\t    queue.setConcurrency('queue-b', 2);\n842\t\n843\t    queue.enqueue('queue-a', { q: 'a1' });\n844\t    queue.enqueue('queue-a', { q: 'a2' });\n845\t    queue.enqueue('queue-b', { q: 'b1' });\n846\t    queue.enqueue('queue-b', { q: 'b2' });\n847\t    queue.enqueue('queue-b', { q: 'b3' });\n848\t\n849\t    queue.dequeue('queue-a'); // 1 processing in queue-a\n850\t    expect(queue.dequeue('queue-a')).toBeNull(); // at limit for queue-a\n851\t\n852\t    queue.dequeue('queue-b'); // 1 processing in queue-b\n853\t    expect(queue.dequeue('queue-b')).not.toBeNull(); // can still dequeue (limit 2)\n854\t    expect(queue.dequeue('queue-b')).toBeNull(); // now at limit\n855\t  });\n856\t\n857\t  it('concurrency respects priority ordering', () => {\n858\t    queue.setConcurrency('work', 1);\n859\t    queue.enqueue('work', { name: 'low' }, { priority: 9 });\n860\t    queue.enqueue('work', { name: 'high' }, { priority: 1 });\n861\t\n862\t    const task = queue.dequeue('work')!;\n863\t    expect(task.payload).toEqual({ name: 'high' });\n864\t  });\n865\t});\n866\t\n867\t=== phase-09.test.ts ===\n868\timport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\n869\timport { TaskQueue } from '../src/index.js';\n870\t\n871\tdescribe('Phase 9: Progress and Cancellation', () => {\n872\t  let queue: TaskQueue;\n873\t\n874\t  beforeEach(() => {\n875\t    vi.useFakeTimers();\n876\t    queue = new TaskQueue();\n877\t  });\n878\t\n879\t  afterEach(() => {\n880\t    vi.useRealTimers();\n881\t  });\n882\t\n883\t  it('updateProgress sets the percentage for a task', () => {\n884\t    queue.enqueue('work', { job: 'progress' });\n885\t    const task = queue.dequeue('work')!;\n886\t\n887\t    queue.updateProgress(task.id, 50);\n888\t    const progress = queue.getProgress(task.id);\n889\t    expect(progress!.percent).toBe(50);\n890\t  });\n891\t\n892\t  it('getProgress returns current progress info', () => {\n893\t    queue.enqueue('work', { job: 'progress' });\n894\t    const task = queue.dequeue('work')!;\n895\t\n896\t    queue.updateProgress(task.id, 75, 'Almost done');\n897\t    const progress = queue.getProgress(task.id);\n898\t\n899\t    expect(progress).not.toBeNull();\n900\t    expect(progress!.percent).toBe(75);\n901\t    expect(progress!.message).toBe('Almost done');\n902\t    expect(progress!.updatedAt).toBeInstanceOf(Date);\n903\t  });\n904\t\n905\t  it('onProgress callback fires when progress is updated', () => {\n906\t    queue.enqueue('work', { job: 'callback' });\n907\t    const task = queue.dequeue('work')!;\n908\t\n909\t    const updates: Array<{ percent: number; message?: string }> = [];\n910\t    queue.onProgress(task.id, (info) => {\n911\t      updates.push({ percent: info.percent, message: info.message });\n912\t    });\n913\t\n914\t    queue.updateProgress(task.id, 25, 'Starting');\n915\t    queue.updateProgress(task.id, 50, 'Halfway');\n916\t    queue.updateProgress(task.id, 100, 'Done');\n917\t\n918\t    expect(updates).toHaveLength(3);\n919\t    expect(updates[0]).toEqual({ percent: 25, message: 'Starting' });\n920\t    expect(updates[1]).toEqual({ percent: 50, message: 'Halfway' });\n921\t    expect(updates[2]).toEqual({ percent: 100, message: 'Done' });\n922\t  });\n923\t\n924\t  it('cancel sets task status to cancelled', () => {\n925\t    const task = queue.enqueue('work', { job: 'cancel-me' });\n926\t    queue.cancel(task.id);\n927\t    expect(task.status).toBe('cancelled');\n928\t  });\n929\t\n930\t  it('cancelled pending task is removed from the queue', () => {\n931\t    queue.enqueue('work', { job: 'stay' });\n932\t    const toCancel = queue.enqueue('work', { job: 'cancel' });\n933\t    queue.enqueue('work', { job: 'stay2' });\n934\t\n935\t    queue.cancel(toCancel.id);\n936\t\n937\t    const t1 = queue.dequeue('work')!;\n938\t    const t2 = queue.dequeue('work')!;\n939\t    expect(t1.payload).toEqual({ job: 'stay' });\n940\t    expect(t2.payload).toEqual({ job: 'stay2' });\n941\t    expect(queue.dequeue('work')).toBeNull();\n942\t  });\n943\t\n944\t  it('cancelled processing task has its status set to cancelled', () => {\n945\t    queue.enqueue('work', { job: 'processing-cancel' });\n946\t    const task = queue.dequeue('work')!;\n947\t    expect(task.status).toBe('processing');\n948\t\n949\t    queue.cancel(task.id);\n950\t    expect(task.status).toBe('cancelled');\n951\t  });\n952\t\n953\t  it('cancelled task is not retried', () => {\n954\t    queue.enqueue('work', { job: 'no-retry' }, { maxRetries: 3 });\n955\t    const task = queue.dequeue('work')!;\n956\t\n957\t    queue.cancel(task.id);\n958\t\n959\t    // Even after long delay, cancelled task should not reappear\n960\t    vi.advanceTimersByTime(100000);\n961\t    expect(queue.dequeue('work')).toBeNull();\n962\t  });\n963\t\n964\t  it('progress message is optional', () => {\n965\t    queue.enqueue('work', { job: 'no-msg' });\n966\t    const task = queue.dequeue('work')!;\n967\t\n968\t    queue.updateProgress(task.id, 42);\n969\t    const progress = queue.getProgress(task.id);\n970\t\n971\t    expect(progress!.percent).toBe(42);\n972\t    expect(progress!.message).toBeUndefined();\n973\t  });\n974\t});\n975\t\n976\t=== phase-10.test.ts ===\n977\timport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\n978\timport { TaskQueue } from '../src/index.js';\n979\t\n980\tdescribe('Phase 10: Recurring Tasks (Cron)', () => {\n981\t  let queue: TaskQueue;\n982\t\n983\t  beforeEach(() => {\n984\t    vi.useFakeTimers({ now: new Date('2025-01-01T00:00:00.000Z') });\n985\t    queue = new TaskQueue();\n986\t  });\n987\t\n988\t  afterEach(() => {\n989\t    vi.useRealTimers();\n990\t  });\n991\t\n992\t  it('schedule creates a recurring task definition', () => {\n993\t    const schedule = queue.schedule('work', '*/5 * * * *', { type: 'cleanup' });\n994\t\n995\t    expect(schedule).toHaveProperty('id');\n996\t    expect(schedule.queueName).toBe('work');\n997\t    expect(schedule.cronExpression).toBe('*/5 * * * *');\n998\t    expect(schedule.taskTemplate).toEqual({ type: 'cleanup' });\n999\t    expect(schedule.active).toBe(true);\n1000\t  });\n1001\t\n1002\t  it('tick triggers scheduled tasks when they are due', () => {\n1003\t    queue.schedule('work', '*/5 * * * *', { type: 'periodic' });\n1004\t\n1005\t    // Advance 5 minutes\n1006\t    vi.advanceTimersByTime(5 * 60 * 1000);\n1007\t    queue.tick();\n1008\t\n1009\t    const task = queue.dequeue('work');\n1010\t    expect(task).not.toBeNull();\n1011\t    expect(task!.payload).toEqual({ type: 'periodic' });\n1012\t  });\n1013\t\n1014\t  it('unschedule stops future occurrences', () => {\n1015\t    const schedule = queue.schedule('work', '*/5 * * * *', { type: 'stop-me' });\n1016\t\n1017\t    queue.unschedule(schedule.id);\n1018\t\n1019\t    vi.advanceTimersByTime(5 * 60 * 1000);\n1020\t    queue.tick();\n1021\t\n1022\t    expect(queue.dequeue('work')).toBeNull();\n1023\t  });\n1024\t\n1025\t  it('listSchedules returns active schedules', () => {\n1026\t    queue.schedule('work', '*/5 * * * *', { type: 'a' });\n1027\t    queue.schedule('work', '*/10 * * * *', { type: 'b' });\n1028\t    const toRemove = queue.schedule('other', '0 * * * *', { type: 'c' });\n1029\t\n1030\t    queue.unschedule(toRemove.id);\n1031\t\n1032\t    const schedules = queue.listSchedules();\n1033\t    expect(schedules.length).toBe(2);\n1034\t\n1035\t    const workSchedules = queue.listSchedules('work');\n1036\t    expect(workSchedules.length).toBe(2);\n1037\t  });\n1038\t\n1039\t  it('cron \"every 5 minutes\" triggers at correct intervals', () => {\n1040\t    queue.schedule('work', '*/5 * * * *', { type: 'five-min' });\n1041\t\n1042\t    // Advance 3 minutes - should not trigger\n1043\t    vi.advanceTimersByTime(3 * 60 * 1000);\n1044\t    queue.tick();\n1045\t    expect(queue.dequeue('work')).toBeNull();\n1046\t\n1047\t    // Advance 2 more minutes (total 5) - should trigger\n1048\t    vi.advanceTimersByTime(2 * 60 * 1000);\n1049\t    queue.tick();\n1050\t    expect(queue.dequeue('work')).not.toBeNull();\n1051\t  });\n1052\t\n1053\t  it('scheduled task gets the correct queue and payload', () => {\n1054\t    queue.schedule('notifications', '*/1 * * * *', {\n1055\t      type: 'reminder',\n1056\t      message: 'Check your inbox',\n1057\t    });\n1058\t\n1059\t    vi.advanceTimersByTime(1 * 60 * 1000);\n1060\t    queue.tick();\n1061\t\n1062\t    const task = queue.dequeue('notifications');\n1063\t    expect(task).not.toBeNull();\n1064\t    expect(task!.payload).toEqual({\n1065\t      type: 'reminder',\n1066\t      message: 'Check your inbox',\n1067\t    });\n1068\t\n1069\t    // Should not be in other queues\n1070\t    expect(queue.dequeue('work')).toBeNull();\n1071\t  });\n1072\t\n1073\t  it('multiple schedules can coexist', () => {\n1074\t    queue.schedule('work', '*/5 * * * *', { type: 'every-5' });\n1075\t    queue.schedule('work', '*/10 * * * *', { type: 'every-10' });\n1076\t\n1077\t    // At 5 minutes, only every-5 triggers\n1078\t    vi.advanceTimersByTime(5 * 60 * 1000);\n1079\t    queue.tick();\n1080\t\n1081\t    const tasks5 = [];\n1082\t    let t;\n1083\t    while ((t = queue.dequeue('work')) !== null) {\n1084\t      tasks5.push(t);\n1085\t    }\n1086\t    expect(tasks5.length).toBe(1);\n1087\t    expect(tasks5[0].payload).toEqual({ type: 'every-5' });\n1088\t\n1089\t    // At 10 minutes, both trigger\n1090\t    vi.advanceTimersByTime(5 * 60 * 1000);\n1091\t    queue.tick();\n1092\t\n1093\t    const tasks10 = [];\n1094\t    while ((t = queue.dequeue('work')) !== null) {\n1095\t      tasks10.push(t);\n1096\t    }\n1097\t    expect(tasks10.length).toBe(2);\n1098\t    const types = tasks10.map(t => t.payload.type).sort();\n1099\t    expect(types).toEqual(['every-10', 'every-5']);\n1100\t  });\n1101\t});\n1102\t\n1103\t=== phase-11.test.ts ===\n1104\timport { describe, it, expect, beforeEach } from 'vitest';\n1105\timport { TaskQueue } from '../src/index.js';\n1106\t\n1107\tdescribe('Phase 11: Middleware Pipeline', () => {\n1108\t  let queue: TaskQueue;\n1109\t\n1110\t  beforeEach(() => {\n1111\t    queue = new TaskQueue();\n1112\t  });\n1113\t\n1114\t  it('middleware runs before task processing', async () => {\n1115\t    const log: string[] = [];\n1116\t\n1117\t    queue.use('work', async (_task, next) => {\n1118\t      log.push('middleware');\n1119\t      await next();\n1120\t    });\n1121\t\n1122\t    queue.enqueue('work', { job: 'test' });\n1123\t\n1124\t    await queue.process('work', async () => {\n1125\t      log.push('handler');\n1126\t    });\n1127\t\n1128\t    expect(log).toEqual(['middleware', 'handler']);\n1129\t  });\n1130\t\n1131\t  it('multiple middlewares run in the order they were added', async () => {\n1132\t    const log: string[] = [];\n1133\t\n1134\t    queue.use('work', async (_task, next) => {\n1135\t      log.push('first');\n1136\t      await next();\n1137\t    });\n1138\t\n1139\t    queue.use('work', async (_task, next) => {\n1140\t      log.push('second');\n1141\t      await next();\n1142\t    });\n1143\t\n1144\t    queue.use('work', async (_task, next) => {\n1145\t      log.push('third');\n1146\t      await next();\n1147\t    });\n1148\t\n1149\t    queue.enqueue('work', { job: 'test' });\n1150\t\n1151\t    await queue.process('work', async () => {\n1152\t      log.push('handler');\n1153\t    });\n1154\t\n1155\t    expect(log).toEqual(['first', 'second', 'third', 'handler']);\n1156\t  });\n1157\t\n1158\t  it('middleware can modify the task object', async () => {\n1159\t    queue.use('work', async (task, next) => {\n1160\t      task.payload.enriched = true;\n1161\t      task.payload.timestamp = '2025-01-01';\n1162\t      await next();\n1163\t    });\n1164\t\n1165\t    queue.enqueue('work', { job: 'enrich-me' });\n1166\t\n1167\t    let processedPayload: Record<string, unknown> | null = null;\n1168\t    await queue.process('work', async (task) => {\n1169\t      processedPayload = task.payload;\n1170\t    });\n1171\t\n1172\t    expect(processedPayload).toEqual({\n1173\t      job: 'enrich-me',\n1174\t      enriched: true,\n1175\t      timestamp: '2025-01-01',\n1176\t    });\n1177\t  });\n1178\t\n1179\t  it('middleware can skip processing by not calling next', async () => {\n1180\t    const log: string[] = [];\n1181\t\n1182\t    queue.use('work', async (_task, _next) => {\n1183\t      log.push('blocker');\n1184\t      // deliberately not calling next()\n1185\t    });\n1186\t\n1187\t    queue.enqueue('work', { job: 'blocked' });\n1188\t\n1189\t    await queue.process('work', async () => {\n1190\t      log.push('handler');\n1191\t    });\n1192\t\n1193\t    expect(log).toEqual(['blocker']);\n1194\t    expect(log).not.toContain('handler');\n1195\t  });\n1196\t\n1197\t  it('error in middleware fails the task', async () => {\n1198\t    queue.use('work', async (_task, _next) => {\n1199\t      throw new Error('middleware explosion');\n1200\t    });\n1201\t\n1202\t    const task = queue.enqueue('work', { job: 'explode' }, { maxRetries: 0 });\n1203\t\n1204\t    await queue.process('work', async () => {\n1205\t      // should not reach here\n1206\t    });\n1207\t\n1208\t    expect(task.status).toBe('failed');\n1209\t  });\n1210\t\n1211\t  it('middleware stacks are independent per queue', async () => {\n1212\t    const log: string[] = [];\n1213\t\n1214\t    queue.use('queue-a', async (_task, next) => {\n1215\t      log.push('a-middleware');\n1216\t      await next();\n1217\t    });\n1218\t\n1219\t    queue.use('queue-b', async (_task, next) => {\n1220\t      log.push('b-middleware');\n1221\t      await next();\n1222\t    });\n1223\t\n1224\t    queue.enqueue('queue-a', { job: 'a' });\n1225\t\n1226\t    await queue.process('queue-a', async () => {\n1227\t      log.push('a-handler');\n1228\t    });\n1229\t\n1230\t    expect(log).toEqual(['a-middleware', 'a-handler']);\n1231\t    expect(log).not.toContain('b-middleware');\n1232\t  });\n1233\t\n1234\t  it('middleware receives the task context', async () => {\n1235\t    let receivedTask: { id?: string; payload?: unknown; status?: string } | null = null;\n1236\t\n1237\t    queue.use('work', async (task, next) => {\n1238\t      receivedTask = task;\n1239\t      await next();\n1240\t    });\n1241\t\n1242\t    const enqueued = queue.enqueue('work', { job: 'context' });\n1243\t\n1244\t    await queue.process('work', async () => {});\n1245\t\n1246\t    expect(receivedTask).not.toBeNull();\n1247\t    expect(receivedTask!.id).toBe(enqueued.id);\n1248\t    expect(receivedTask!.payload).toEqual({ job: 'context' });\n1249\t  });\n1250\t});\n1251\t\n1252\t=== phase-12.test.ts ===\n1253\timport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\n1254\timport { TaskQueue } from '../src/index.js';\n1255\t\n1256\tdescribe('Phase 12: Graceful Shutdown', () => {\n1257\t  let queue: TaskQueue;\n1258\t\n1259\t  beforeEach(() => {\n1260\t    vi.useFakeTimers();\n1261\t    queue = new TaskQueue();\n1262\t  });\n1263\t\n1264\t  afterEach(() => {\n1265\t    vi.useRealTimers();\n1266\t  });\n1267\t\n1268\t  it('shutdown stops accepting new tasks', async () => {\n1269\t    const shutdownPromise = queue.shutdown(5000);\n1270\t    vi.advanceTimersByTime(0);\n1271\t    await shutdownPromise;\n1272\t\n1273\t    expect(() => queue.enqueue('work', { job: 'too-late' })).toThrow();\n1274\t  });\n1275\t\n1276\t  it('shutdown waits for processing tasks to complete', async () => {\n1277\t    queue.enqueue('work', { job: 'in-flight' });\n1278\t    const task = queue.dequeue('work')!;\n1279\t\n1280\t    let resolved = false;\n1281\t    const shutdownPromise = queue.shutdown(10000).then((summary) => {\n1282\t      resolved = true;\n1283\t      return summary;\n1284\t    });\n1285\t\n1286\t    // Shutdown should not resolve yet (task still processing)\n1287\t    vi.advanceTimersByTime(100);\n1288\t    await Promise.resolve(); // flush microtasks\n1289\t    expect(resolved).toBe(false);\n1290\t\n1291\t    // Complete the task\n1292\t    queue.complete(task.id);\n1293\t    vi.advanceTimersByTime(0);\n1294\t    const summary = await shutdownPromise;\n1295\t\n1296\t    expect(resolved).toBe(true);\n1297\t    expect(summary.completed).toBe(1);\n1298\t  });\n1299\t\n1300\t  it('shutdown force-cancels tasks after timeout', async () => {\n1301\t    queue.enqueue('work', { job: 'slow' });\n1302\t    const task = queue.dequeue('work')!;\n1303\t\n1304\t    const shutdownPromise = queue.shutdown(3000);\n1305\t\n1306\t    // Advance past timeout\n1307\t    vi.advanceTimersByTime(3000);\n1308\t    const summary = await shutdownPromise;\n1309\t\n1310\t    expect(summary.cancelled).toBe(1);\n1311\t    expect(task.status).toBe('cancelled');\n1312\t  });\n1313\t\n1314\t  it('onShutdown callback fires during shutdown', async () => {\n1315\t    const log: string[] = [];\n1316\t    queue.onShutdown(() => {\n1317\t      log.push('shutdown-hook');\n1318\t    });\n1319\t\n1320\t    const shutdownPromise = queue.shutdown(5000);\n1321\t    vi.advanceTimersByTime(0);\n1322\t    await shutdownPromise;\n1323\t\n1324\t    expect(log).toContain('shutdown-hook');\n1325\t  });\n1326\t\n1327\t  it('shutdown returns summary with completed, cancelled, and elapsed', async () => {\n1328\t    queue.enqueue('work', { job: 'fast' });\n1329\t    queue.enqueue('work', { job: 'slow' });\n1330\t\n1331\t    const fast = queue.dequeue('work')!;\n1332\t    const _slow = queue.dequeue('work')!;\n1333\t\n1334\t    const shutdownPromise = queue.shutdown(5000);\n1335\t\n1336\t    // Complete 'fast' quickly\n1337\t    queue.complete(fast.id);\n1338\t\n1339\t    // Let 'slow' timeout (it gets force-cancelled)\n1340\t    vi.advanceTimersByTime(5000);\n1341\t    const summary = await shutdownPromise;\n1342\t\n1343\t    expect(summary.completed).toBe(1);\n1344\t    expect(summary.cancelled).toBe(1);\n1345\t    expect(typeof summary.elapsed).toBe('number');\n1346\t    expect(summary.elapsed).toBeGreaterThanOrEqual(0);\n1347\t  });\n1348\t\n1349\t  it('multiple shutdown calls are idempotent', async () => {\n1350\t    const p1 = queue.shutdown(5000);\n1351\t    const p2 = queue.shutdown(5000);\n1352\t\n1353\t    vi.advanceTimersByTime(0);\n1354\t    const [s1, s2] = await Promise.all([p1, p2]);\n1355\t\n1356\t    // Should return the same result\n1357\t    expect(s1).toEqual(s2);\n1358\t  });\n1359\t\n1360\t  it('enqueue after shutdown throws an error', async () => {\n1361\t    const shutdownPromise = queue.shutdown(5000);\n1362\t    vi.advanceTimersByTime(0);\n1363\t    await shutdownPromise;\n1364\t\n1365\t    expect(() => queue.enqueue('work', { job: 'rejected' })).toThrow();\n1366\t  });\n1367\t\n1368\t  it('shutdown with no processing tasks resolves immediately', async () => {\n1369\t    queue.enqueue('work', { job: 'pending-only' });\n1370\t    // Don't dequeue - nothing is processing\n1371\t\n1372\t    const shutdownPromise = queue.shutdown(5000);\n1373\t    vi.advanceTimersByTime(0);\n1374\t    const summary = await shutdownPromise;\n1375\t\n1376\t    expect(summary.completed).toBe(0);\n1377\t    expect(summary.cancelled).toBe(0);\n1378\t    expect(summary.elapsed).toBeLessThanOrEqual(100);\n1379\t  });\n1380\t});\n1381\t\n1382\t"}]},"parent_tool_use_id":null,"session_id":"f2d134c7-fc2f-4820-8837-9ae8f9637f0d","uuid":"d814e06d-bfd9-4fc4-b415-f1e3386da653","timestamp":"2026-07-25T17:57:04.675Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/.claude/projects/-workspace/f2d134c7-fc2f-4820-8837-9ae8f9637f0d/tool-results/byqxcgwae.txt","content":"=== phase-01.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 1: Basic FIFO Queue', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('enqueue returns a task with id and pending status', () => {\n    const task = queue.enqueue('default', { type: 'email', to: 'user@test.com' });\n    expect(task).toHaveProperty('id');\n    expect(typeof task.id).toBe('string');\n    expect(task.id.length).toBeGreaterThan(0);\n    expect(task.status).toBe('pending');\n    expect(task.payload).toEqual({ type: 'email', to: 'user@test.com' });\n  });\n\n  it('dequeue returns tasks in FIFO order', () => {\n    queue.enqueue('default', { order: 1 });\n    queue.enqueue('default', { order: 2 });\n    queue.enqueue('default', { order: 3 });\n\n    const first = queue.dequeue('default');\n    const second = queue.dequeue('default');\n    const third = queue.dequeue('default');\n\n    expect(first!.payload).toEqual({ order: 1 });\n    expect(second!.payload).toEqual({ order: 2 });\n    expect(third!.payload).toEqual({ order: 3 });\n  });\n\n  it('dequeue returns null when queue is empty', () => {\n    const result = queue.dequeue('default');\n    expect(result).toBeNull();\n  });\n\n  it('size returns the correct count of pending tasks', () => {\n    expect(queue.size()).toBe(0);\n    queue.enqueue('default', { a: 1 });\n    queue.enqueue('default', { a: 2 });\n    expect(queue.size()).toBe(2);\n    queue.dequeue('default');\n    expect(queue.size()).toBe(1);\n  });\n\n  it('dequeued task has processing status', () => {\n    queue.enqueue('default', { job: 'process' });\n    const task = queue.dequeue('default');\n    expect(task!.status).toBe('processing');\n  });\n\n  it('task has a createdAt timestamp', () => {\n    const before = new Date();\n    const task = queue.enqueue('default', { data: 'test' });\n    const after = new Date();\n\n    expect(task.createdAt).toBeInstanceOf(Date);\n    expect(task.createdAt.getTime()).toBeGreaterThanOrEqual(before.getTime());\n    expect(task.createdAt.getTime()).toBeLessThanOrEqual(after.getTime());\n  });\n\n  it('multiple enqueue/dequeue cycles maintain FIFO order', () => {\n    queue.enqueue('default', { v: 'a' });\n    queue.enqueue('default', { v: 'b' });\n    queue.dequeue('default'); // removes 'a'\n    queue.enqueue('default', { v: 'c' });\n\n    const next = queue.dequeue('default');\n    expect(next!.payload).toEqual({ v: 'b' });\n    const last = queue.dequeue('default');\n    expect(last!.payload).toEqual({ v: 'c' });\n  });\n\n  it('each task receives a unique id', () => {\n    const t1 = queue.enqueue('default', { x: 1 });\n    const t2 = queue.enqueue('default', { x: 2 });\n    const t3 = queue.enqueue('default', { x: 3 });\n\n    const ids = [t1.id, t2.id, t3.id];\n    const unique = new Set(ids);\n    expect(unique.size).toBe(3);\n  });\n});\n\n=== phase-02.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 2: Named Queues', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('enqueue adds a task to a named queue', () => {\n    const task = queue.enqueue('emails', { to: 'user@test.com' });\n    expect(task).toHaveProperty('id');\n    expect(task.status).toBe('pending');\n  });\n\n  it('dequeue retrieves from a specific named queue', () => {\n    queue.enqueue('emails', { to: 'a@test.com' });\n    queue.enqueue('notifications', { msg: 'hello' });\n\n    const emailTask = queue.dequeue('emails');\n    expect(emailTask!.payload).toEqual({ to: 'a@test.com' });\n  });\n\n  it('queues are independent - dequeue from wrong queue returns null', () => {\n    queue.enqueue('queue-a', { data: 'for-a' });\n    const result = queue.dequeue('queue-b');\n    expect(result).toBeNull();\n  });\n\n  it('listQueues returns all created queue names', () => {\n    queue.enqueue('emails', { a: 1 });\n    queue.enqueue('notifications', { b: 2 });\n    queue.enqueue('reports', { c: 3 });\n\n    const names = queue.listQueues();\n    expect(names).toContain('emails');\n    expect(names).toContain('notifications');\n    expect(names).toContain('reports');\n    expect(names.length).toBe(3);\n  });\n\n  it('queueSize returns the correct count per queue', () => {\n    queue.enqueue('fast', { x: 1 });\n    queue.enqueue('fast', { x: 2 });\n    queue.enqueue('slow', { x: 3 });\n\n    expect(queue.queueSize('fast')).toBe(2);\n    expect(queue.queueSize('slow')).toBe(1);\n  });\n\n  it('uses default queue name when none is specified', () => {\n    queue.enqueue('default', { fallback: true });\n    const task = queue.dequeue('default');\n    expect(task!.payload).toEqual({ fallback: true });\n    expect(queue.listQueues()).toContain('default');\n  });\n\n  it('dequeue from non-existent queue returns null', () => {\n    const result = queue.dequeue('nonexistent');\n    expect(result).toBeNull();\n  });\n});\n\n=== phase-03.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 3: Priority', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('higher priority task is dequeued first', () => {\n    queue.enqueue('work', { name: 'low' }, { priority: 8 });\n    queue.enqueue('work', { name: 'high' }, { priority: 2 });\n\n    const task = queue.dequeue('work');\n    expect(task!.payload).toEqual({ name: 'high' });\n  });\n\n  it('same priority maintains FIFO order', () => {\n    queue.enqueue('work', { order: 'first' }, { priority: 5 });\n    queue.enqueue('work', { order: 'second' }, { priority: 5 });\n    queue.enqueue('work', { order: 'third' }, { priority: 5 });\n\n    expect(queue.dequeue('work')!.payload).toEqual({ order: 'first' });\n    expect(queue.dequeue('work')!.payload).toEqual({ order: 'second' });\n    expect(queue.dequeue('work')!.payload).toEqual({ order: 'third' });\n  });\n\n  it('default priority is 5', () => {\n    const task = queue.enqueue('work', { test: true });\n    expect(task.priority).toBe(5);\n  });\n\n  it('priority 1 is dequeued before priority 10', () => {\n    queue.enqueue('work', { name: 'lowest' }, { priority: 10 });\n    queue.enqueue('work', { name: 'highest' }, { priority: 1 });\n\n    const task = queue.dequeue('work');\n    expect(task!.payload).toEqual({ name: 'highest' });\n  });\n\n  it('three different priorities dequeue in correct order', () => {\n    queue.enqueue('work', { p: 'medium' }, { priority: 5 });\n    queue.enqueue('work', { p: 'low' }, { priority: 9 });\n    queue.enqueue('work', { p: 'high' }, { priority: 1 });\n\n    expect(queue.dequeue('work')!.payload).toEqual({ p: 'high' });\n    expect(queue.dequeue('work')!.payload).toEqual({ p: 'medium' });\n    expect(queue.dequeue('work')!.payload).toEqual({ p: 'low' });\n  });\n\n  it('later enqueued high priority beats earlier low priority', () => {\n    queue.enqueue('work', { name: 'first-low' }, { priority: 8 });\n    queue.enqueue('work', { name: 'second-high' }, { priority: 2 });\n\n    const task = queue.dequeue('work');\n    expect(task!.payload).toEqual({ name: 'second-high' });\n  });\n\n  it('priority works independently per named queue', () => {\n    queue.enqueue('queue-a', { name: 'a-low' }, { priority: 9 });\n    queue.enqueue('queue-a', { name: 'a-high' }, { priority: 1 });\n    queue.enqueue('queue-b', { name: 'b-only' }, { priority: 7 });\n\n    expect(queue.dequeue('queue-a')!.payload).toEqual({ name: 'a-high' });\n    expect(queue.dequeue('queue-b')!.payload).toEqual({ name: 'b-only' });\n  });\n\n  it('throws error for priority outside 1-10 range', () => {\n    expect(() => queue.enqueue('work', {}, { priority: 0 })).toThrow();\n    expect(() => queue.enqueue('work', {}, { priority: 11 })).toThrow();\n    expect(() => queue.enqueue('work', {}, { priority: -1 })).toThrow();\n  });\n});\n\n=== phase-04.test.ts ===\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 4: Delayed/Scheduled Tasks', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('delayed task is not available immediately', () => {\n    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n    const task = queue.dequeue('work');\n    expect(task).toBeNull();\n  });\n\n  it('delayed task becomes available after delay period', () => {\n    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n\n    vi.advanceTimersByTime(5000);\n\n    const task = queue.dequeue('work');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({ delayed: true });\n  });\n\n  it('runAt task is not available before the specified time', () => {\n    const futureDate = new Date(Date.now() + 10000);\n    queue.enqueue('work', { scheduled: true }, { runAt: futureDate });\n\n    const task = queue.dequeue('work');\n    expect(task).toBeNull();\n  });\n\n  it('runAt task becomes available at the specified time', () => {\n    const futureDate = new Date(Date.now() + 10000);\n    queue.enqueue('work', { scheduled: true }, { runAt: futureDate });\n\n    vi.advanceTimersByTime(10000);\n\n    const task = queue.dequeue('work');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({ scheduled: true });\n  });\n\n  it('non-delayed tasks dequeued before delayed tasks still waiting', () => {\n    queue.enqueue('work', { delayed: true }, { delay: 5000 });\n    queue.enqueue('work', { immediate: true });\n\n    const task = queue.dequeue('work');\n    expect(task!.payload).toEqual({ immediate: true });\n  });\n\n  it('multiple delayed tasks ordered by availability time', () => {\n    queue.enqueue('work', { name: 'later' }, { delay: 10000 });\n    queue.enqueue('work', { name: 'sooner' }, { delay: 3000 });\n\n    vi.advanceTimersByTime(10000);\n\n    const first = queue.dequeue('work');\n    const second = queue.dequeue('work');\n\n    expect(first!.payload).toEqual({ name: 'sooner' });\n    expect(second!.payload).toEqual({ name: 'later' });\n  });\n\n  it('delay works with named queues', () => {\n    queue.enqueue('fast', { name: 'fast-delayed' }, { delay: 2000 });\n    queue.enqueue('slow', { name: 'slow-delayed' }, { delay: 8000 });\n\n    vi.advanceTimersByTime(2000);\n\n    expect(queue.dequeue('fast')).not.toBeNull();\n    expect(queue.dequeue('slow')).toBeNull();\n\n    vi.advanceTimersByTime(6000);\n\n    expect(queue.dequeue('slow')).not.toBeNull();\n  });\n});\n\n=== phase-05.test.ts ===\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 5: Retry with Backoff', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('fail marks a processing task as failed', () => {\n    queue.enqueue('work', { job: 'test' }, { maxRetries: 0 });\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'something went wrong');\n\n    // With maxRetries: 0, no retry - task stays failed\n    expect(task.status).toBe('failed');\n  });\n\n  it('failed task is re-enqueued automatically when retries remain', () => {\n    queue.enqueue('work', { job: 'retry-me' });\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'transient error');\n\n    // After backoff delay, task should be available again\n    vi.advanceTimersByTime(1000); // first retry: 1000ms\n    const retried = queue.dequeue('work');\n    expect(retried).not.toBeNull();\n    expect(retried!.id).toBe(task.id);\n  });\n\n  it('task attempts count is incremented on each retry', () => {\n    queue.enqueue('work', { job: 'count-attempts' });\n    const task = queue.dequeue('work')!;\n    expect(task.attempts).toBe(1);\n\n    queue.fail(task.id, 'error');\n    vi.advanceTimersByTime(1000);\n\n    const retry1 = queue.dequeue('work')!;\n    expect(retry1.attempts).toBe(2);\n  });\n\n  it('backoff delay increases exponentially between retries', () => {\n    queue.enqueue('work', { job: 'backoff-test' });\n\n    // First attempt\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'error 1');\n\n    // First retry after 1000ms (1000 * 2^0)\n    vi.advanceTimersByTime(999);\n    expect(queue.dequeue('work')).toBeNull();\n    vi.advanceTimersByTime(1);\n    expect(queue.dequeue('work')).not.toBeNull();\n\n    queue.fail(task.id, 'error 2');\n\n    // Second retry after 2000ms (1000 * 2^1)\n    vi.advanceTimersByTime(1999);\n    expect(queue.dequeue('work')).toBeNull();\n    vi.advanceTimersByTime(1);\n    expect(queue.dequeue('work')).not.toBeNull();\n\n    queue.fail(task.id, 'error 3');\n\n    // Third retry after 4000ms (1000 * 2^2)\n    vi.advanceTimersByTime(3999);\n    expect(queue.dequeue('work')).toBeNull();\n    vi.advanceTimersByTime(1);\n    expect(queue.dequeue('work')).not.toBeNull();\n  });\n\n  it('respects maxRetries limit (default 3)', () => {\n    queue.enqueue('work', { job: 'limited' });\n\n    for (let i = 0; i < 3; i++) {\n      const task = queue.dequeue('work')!;\n      expect(task).not.toBeNull();\n      queue.fail(task.id, `error ${i + 1}`);\n      vi.advanceTimersByTime(1000 * Math.pow(2, i));\n    }\n\n    // Fourth attempt\n    const lastAttempt = queue.dequeue('work')!;\n    expect(lastAttempt).not.toBeNull();\n    queue.fail(lastAttempt.id, 'final error');\n\n    // No more retries - should not re-appear\n    vi.advanceTimersByTime(100000);\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('accepts custom maxRetries option', () => {\n    queue.enqueue('work', { job: 'custom' }, { maxRetries: 1 });\n\n    // First attempt\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'error 1');\n    vi.advanceTimersByTime(1000);\n\n    // Second attempt (1 retry)\n    const retry = queue.dequeue('work')!;\n    expect(retry).not.toBeNull();\n    queue.fail(retry.id, 'error 2');\n\n    // No more retries\n    vi.advanceTimersByTime(100000);\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('retry preserves the original queue name', () => {\n    queue.enqueue('special-queue', { job: 'preserve-queue' });\n    const task = queue.dequeue('special-queue')!;\n    queue.fail(task.id, 'error');\n    vi.advanceTimersByTime(1000);\n\n    // Should appear in the same queue\n    const retried = queue.dequeue('special-queue');\n    expect(retried).not.toBeNull();\n    expect(retried!.id).toBe(task.id);\n\n    // Should not appear in other queues\n    expect(queue.dequeue('default')).toBeNull();\n  });\n\n  it('retry preserves the original priority', () => {\n    queue.enqueue('work', { job: 'high-pri' }, { priority: 1 });\n    queue.enqueue('work', { job: 'low-pri' }, { priority: 9 });\n\n    const highPri = queue.dequeue('work')!;\n    expect(highPri.payload).toEqual({ job: 'high-pri' });\n    queue.fail(highPri.id, 'error');\n    vi.advanceTimersByTime(1000);\n\n    // The retried high-priority task should still come before low-priority\n    const next = queue.dequeue('work')!;\n    expect(next.payload).toEqual({ job: 'high-pri' });\n  });\n});\n\n=== phase-06.test.ts ===\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 6: Dead Letter Queue', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('task moves to DLQ after exhausting all retries', () => {\n    queue.enqueue('work', { job: 'doomed' }, { maxRetries: 1 });\n\n    // First attempt\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'error 1');\n    vi.advanceTimersByTime(1000);\n\n    // Second attempt (1 retry)\n    const retry = queue.dequeue('work')!;\n    queue.fail(retry.id, 'error 2');\n\n    // Should be in DLQ now\n    const dlq = queue.getDLQ('work');\n    expect(dlq.length).toBe(1);\n    expect(dlq[0].id).toBe(task.id);\n  });\n\n  it('getDLQ returns all dead-letter tasks for a queue', () => {\n    queue.enqueue('work', { job: 'doomed1' }, { maxRetries: 0 });\n    queue.enqueue('work', { job: 'doomed2' }, { maxRetries: 0 });\n\n    const t1 = queue.dequeue('work')!;\n    queue.fail(t1.id, 'error');\n    const t2 = queue.dequeue('work')!;\n    queue.fail(t2.id, 'error');\n\n    const dlq = queue.getDLQ('work');\n    expect(dlq.length).toBe(2);\n  });\n\n  it('retryDLQ moves task back to its original queue', () => {\n    queue.enqueue('emails', { job: 'retry-dlq' }, { maxRetries: 0 });\n\n    const task = queue.dequeue('emails')!;\n    queue.fail(task.id, 'error');\n\n    expect(queue.getDLQ('emails').length).toBe(1);\n\n    const retried = queue.retryDLQ(task.id);\n    expect(retried).not.toBeNull();\n\n    // DLQ should be empty now\n    expect(queue.getDLQ('emails').length).toBe(0);\n\n    // Task should be back in the queue\n    const dequeued = queue.dequeue('emails');\n    expect(dequeued).not.toBeNull();\n    expect(dequeued!.id).toBe(task.id);\n  });\n\n  it('clearDLQ removes all DLQ tasks for a queue', () => {\n    queue.enqueue('work', { job: 'clear1' }, { maxRetries: 0 });\n    queue.enqueue('work', { job: 'clear2' }, { maxRetries: 0 });\n\n    const t1 = queue.dequeue('work')!;\n    queue.fail(t1.id, 'error');\n    const t2 = queue.dequeue('work')!;\n    queue.fail(t2.id, 'error');\n\n    expect(queue.getDLQ('work').length).toBe(2);\n    queue.clearDLQ('work');\n    expect(queue.getDLQ('work').length).toBe(0);\n  });\n\n  it('DLQ task retains original error information', () => {\n    queue.enqueue('work', { job: 'error-info' }, { maxRetries: 0 });\n\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'specific error message');\n\n    const dlq = queue.getDLQ('work');\n    expect(dlq[0].lastError).toBe('specific error message');\n  });\n\n  it('DLQ task tracks failure count', () => {\n    queue.enqueue('work', { job: 'count-fails' }, { maxRetries: 2 });\n\n    // Fail through all retries\n    for (let i = 0; i < 2; i++) {\n      const task = queue.dequeue('work')!;\n      queue.fail(task.id, `error ${i}`);\n      vi.advanceTimersByTime(1000 * Math.pow(2, i));\n    }\n    const lastAttempt = queue.dequeue('work')!;\n    queue.fail(lastAttempt.id, 'final error');\n\n    const dlq = queue.getDLQ('work');\n    expect(dlq[0].failCount).toBe(3); // original + 2 retries = 3 failures\n  });\n\n  it('retried DLQ task gets a fresh retry count', () => {\n    queue.enqueue('work', { job: 'fresh-retries' }, { maxRetries: 1 });\n\n    // Exhaust retries\n    const t1 = queue.dequeue('work')!;\n    queue.fail(t1.id, 'error 1');\n    vi.advanceTimersByTime(1000);\n    const t2 = queue.dequeue('work')!;\n    queue.fail(t2.id, 'error 2');\n\n    // Should be in DLQ\n    expect(queue.getDLQ('work').length).toBe(1);\n\n    // Retry from DLQ\n    queue.retryDLQ(t1.id);\n    const retried = queue.dequeue('work')!;\n    expect(retried).not.toBeNull();\n    expect(retried.attempts).toBe(1); // fresh attempt count\n\n    // Should have fresh retries available\n    queue.fail(retried.id, 'new error');\n    vi.advanceTimersByTime(1000);\n    const retry = queue.dequeue('work');\n    expect(retry).not.toBeNull(); // can retry again\n  });\n});\n\n=== phase-07.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 7: Task Dependencies', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('task with dependencies is not available until deps complete', () => {\n    const dep = queue.enqueue('work', { name: 'dependency' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n\n    // Dequeue should return the dependency first (no deps blocking it)\n    const first = queue.dequeue('work');\n    expect(first!.payload).toEqual({ name: 'dependency' });\n\n    // Dependent should not be available yet\n    const second = queue.dequeue('work');\n    expect(second).toBeNull();\n  });\n\n  it('completing a dependency makes dependent task available', () => {\n    const dep = queue.enqueue('work', { name: 'dependency' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n\n    const task = queue.dequeue('work')!;\n    queue.complete(task.id);\n\n    // Now the dependent should be available\n    const dependent = queue.dequeue('work');\n    expect(dependent).not.toBeNull();\n    expect(dependent!.payload).toEqual({ name: 'dependent' });\n  });\n\n  it('all dependencies must complete before dependent is available', () => {\n    const dep1 = queue.enqueue('work', { name: 'dep1' });\n    const dep2 = queue.enqueue('work', { name: 'dep2' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep1.id, dep2.id] });\n\n    // Process dep1\n    const task1 = queue.dequeue('work')!;\n    queue.complete(task1.id);\n\n    // dep2 should be available but dependent should not\n    const task2 = queue.dequeue('work')!;\n    expect(task2.payload).toEqual({ name: 'dep2' });\n\n    // Dependent still blocked (dep2 not completed yet)\n    expect(queue.dequeue('work')).toBeNull();\n\n    // Complete dep2\n    queue.complete(task2.id);\n\n    // Now dependent is available\n    const dependent = queue.dequeue('work');\n    expect(dependent).not.toBeNull();\n    expect(dependent!.payload).toEqual({ name: 'dependent' });\n  });\n\n  it('circular dependency throws an error', () => {\n    const a = queue.enqueue('work', { name: 'A' });\n    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [a.id] });\n\n    // Trying to make A depend on B creates a cycle\n    expect(() =>\n      queue.enqueue('work', { name: 'C' }, { dependsOn: [b.id, a.id] })\n    ).not.toThrow(); // C -> B -> A is fine, no cycle\n\n    // Direct cycle: X depends on Y, Y depends on X\n    const x = queue.enqueue('work', { name: 'X' });\n    queue.enqueue('work', { name: 'Y' }, { dependsOn: [x.id] });\n\n    // This should not throw since there's no actual circular dependency here\n    // A true circular dependency:\n    const m = queue.enqueue('work', { name: 'M' });\n    const n = queue.enqueue('work', { name: 'N' }, { dependsOn: [m.id] });\n    expect(() =>\n      queue.enqueue('work', { name: 'O' }, { dependsOn: [n.id, m.id] })\n    ).not.toThrow(); // O -> N -> M is fine\n\n    // Real cycle detection test\n    const p = queue.enqueue('other', { name: 'P' });\n    const _q2 = queue.enqueue('other', { name: 'Q' }, { dependsOn: [p.id] });\n    // Cycle detection is verified above; with forward-only enqueue,\n    // cycles can only be detected at enqueue time through transitive dep chains.\n  });\n\n  it('getDependencies returns dependency info with statuses', () => {\n    const dep1 = queue.enqueue('work', { name: 'dep1' });\n    const dep2 = queue.enqueue('work', { name: 'dep2' });\n    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n      dependsOn: [dep1.id, dep2.id],\n    });\n\n    const deps = queue.getDependencies(dependent.id);\n    expect(deps).toHaveLength(2);\n    expect(deps).toContainEqual({ taskId: dep1.id, status: 'pending' });\n    expect(deps).toContainEqual({ taskId: dep2.id, status: 'pending' });\n\n    // After completing one\n    const task = queue.dequeue('work')!;\n    queue.complete(task.id);\n\n    const updatedDeps = queue.getDependencies(dependent.id);\n    const completedDep = updatedDeps.find(d => d.taskId === dep1.id);\n    expect(completedDep!.status).toBe('completed');\n  });\n\n  it('cascading dependencies work correctly (A depends on B depends on C)', () => {\n    const c = queue.enqueue('work', { name: 'C' });\n    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [c.id] });\n    const a = queue.enqueue('work', { name: 'A' }, { dependsOn: [b.id] });\n\n    // Only C is available\n    const taskC = queue.dequeue('work')!;\n    expect(taskC.payload).toEqual({ name: 'C' });\n    expect(queue.dequeue('work')).toBeNull();\n\n    queue.complete(taskC.id);\n\n    // Now B is available\n    const taskB = queue.dequeue('work')!;\n    expect(taskB.payload).toEqual({ name: 'B' });\n    expect(queue.dequeue('work')).toBeNull();\n\n    queue.complete(taskB.id);\n\n    // Now A is available\n    const taskA = queue.dequeue('work')!;\n    expect(taskA.payload).toEqual({ name: 'A' });\n    expect(taskA.id).toBe(a.id);\n  });\n\n  it('failed dependency does not auto-fail the dependent task', () => {\n    const dep = queue.enqueue('work', { name: 'dep' }, { maxRetries: 0 });\n    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n      dependsOn: [dep.id],\n    });\n\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'dep failed');\n\n    // Dependent stays blocked (not failed)\n    expect(dependent.status).toBe('pending');\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('dependency on non-existent task throws an error', () => {\n    expect(() =>\n      queue.enqueue('work', { name: 'orphan' }, { dependsOn: ['nonexistent-id'] })\n    ).toThrow();\n  });\n});\n\n=== phase-08.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 8: Concurrency Control', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('setConcurrency limits the number of concurrent processing tasks', () => {\n    queue.setConcurrency('work', 2);\n    queue.enqueue('work', { job: 1 });\n    queue.enqueue('work', { job: 2 });\n    queue.enqueue('work', { job: 3 });\n\n    const t1 = queue.dequeue('work');\n    const t2 = queue.dequeue('work');\n    expect(t1).not.toBeNull();\n    expect(t2).not.toBeNull();\n\n    // Third dequeue should return null (at limit)\n    const t3 = queue.dequeue('work');\n    expect(t3).toBeNull();\n  });\n\n  it('dequeue returns null when at concurrency limit even if tasks available', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { job: 'a' });\n    queue.enqueue('work', { job: 'b' });\n\n    queue.dequeue('work'); // takes slot\n    const second = queue.dequeue('work');\n    expect(second).toBeNull();\n  });\n\n  it('completing a task frees a concurrency slot', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { job: 'first' });\n    queue.enqueue('work', { job: 'second' });\n\n    const first = queue.dequeue('work')!;\n    expect(queue.dequeue('work')).toBeNull(); // at limit\n\n    queue.complete(first.id);\n\n    const second = queue.dequeue('work');\n    expect(second).not.toBeNull();\n    expect(second!.payload).toEqual({ job: 'second' });\n  });\n\n  it('getConcurrency returns current and max info', () => {\n    queue.setConcurrency('work', 3);\n    queue.enqueue('work', { job: 1 });\n    queue.enqueue('work', { job: 2 });\n\n    const info1 = queue.getConcurrency('work');\n    expect(info1.max).toBe(3);\n    expect(info1.current).toBe(0);\n\n    queue.dequeue('work');\n    const info2 = queue.getConcurrency('work');\n    expect(info2.current).toBe(1);\n\n    queue.dequeue('work');\n    const info3 = queue.getConcurrency('work');\n    expect(info3.current).toBe(2);\n  });\n\n  it('default concurrency is unlimited', () => {\n    for (let i = 0; i < 100; i++) {\n      queue.enqueue('work', { job: i });\n    }\n\n    const tasks = [];\n    for (let i = 0; i < 100; i++) {\n      const t = queue.dequeue('work');\n      if (!t) break;\n      tasks.push(t);\n    }\n\n    expect(tasks.length).toBe(100);\n  });\n\n  it('concurrency limits are independent per queue', () => {\n    queue.setConcurrency('queue-a', 1);\n    queue.setConcurrency('queue-b', 2);\n\n    queue.enqueue('queue-a', { q: 'a1' });\n    queue.enqueue('queue-a', { q: 'a2' });\n    queue.enqueue('queue-b', { q: 'b1' });\n    queue.enqueue('queue-b', { q: 'b2' });\n    queue.enqueue('queue-b', { q: 'b3' });\n\n    queue.dequeue('queue-a'); // 1 processing in queue-a\n    expect(queue.dequeue('queue-a')).toBeNull(); // at limit for queue-a\n\n    queue.dequeue('queue-b'); // 1 processing in queue-b\n    expect(queue.dequeue('queue-b')).not.toBeNull(); // can still dequeue (limit 2)\n    expect(queue.dequeue('queue-b')).toBeNull(); // now at limit\n  });\n\n  it('concurrency respects priority ordering', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { name: 'low' }, { priority: 9 });\n    queue.enqueue('work', { name: 'high' }, { priority: 1 });\n\n    const task = queue.dequeue('work')!;\n    expect(task.payload).toEqual({ name: 'high' });\n  });\n});\n\n=== phase-09.test.ts ===\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 9: Progress and Cancellation', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('updateProgress sets the percentage for a task', () => {\n    queue.enqueue('work', { job: 'progress' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 50);\n    const progress = queue.getProgress(task.id);\n    expect(progress!.percent).toBe(50);\n  });\n\n  it('getProgress returns current progress info', () => {\n    queue.enqueue('work', { job: 'progress' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 75, 'Almost done');\n    const progress = queue.getProgress(task.id);\n\n    expect(progress).not.toBeNull();\n    expect(progress!.percent).toBe(75);\n    expect(progress!.message).toBe('Almost done');\n    expect(progress!.updatedAt).toBeInstanceOf(Date);\n  });\n\n  it('onProgress callback fires when progress is updated', () => {\n    queue.enqueue('work', { job: 'callback' });\n    const task = queue.dequeue('work')!;\n\n    const updates: Array<{ percent: number; message?: string }> = [];\n    queue.onProgress(task.id, (info) => {\n      updates.push({ percent: info.percent, message: info.message });\n    });\n\n    queue.updateProgress(task.id, 25, 'Starting');\n    queue.updateProgress(task.id, 50, 'Halfway');\n    queue.updateProgress(task.id, 100, 'Done');\n\n    expect(updates).toHaveLength(3);\n    expect(updates[0]).toEqual({ percent: 25, message: 'Starting' });\n    expect(updates[1]).toEqual({ percent: 50, message: 'Halfway' });\n    expect(updates[2]).toEqual({ percent: 100, message: 'Done' });\n  });\n\n  it('cancel sets task status to cancelled', () => {\n    const task = queue.enqueue('work', { job: 'cancel-me' });\n    queue.cancel(task.id);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('cancelled pending task is removed from the queue', () => {\n    queue.enqueue('work', { job: 'stay' });\n    const toCancel = queue.enqueue('work', { job: 'cancel' });\n    queue.enqueue('work', { job: 'stay2' });\n\n    queue.cancel(toCancel.id);\n\n    const t1 = queue.dequeue('work')!;\n    const t2 = queue.dequeue('work')!;\n    expect(t1.payload).toEqual({ job: 'stay' });\n    expect(t2.payload).toEqual({ job: 'stay2' });\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('cancelled processing task has its status set to cancelled', () => {\n    queue.enqueue('work', { job: 'processing-cancel' });\n    const task = queue.dequeue('work')!;\n    expect(task.status).toBe('processing');\n\n    queue.cancel(task.id);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('cancelled task is not retried', () => {\n    queue.enqueue('work', { job: 'no-retry' }, { maxRetries: 3 });\n    const task = queue.dequeue('work')!;\n\n    queue.cancel(task.id);\n\n    // Even after long delay, cancelled task should not reappear\n    vi.advanceTimersByTime(100000);\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('progress message is optional', () => {\n    queue.enqueue('work', { job: 'no-msg' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 42);\n    const progress = queue.getProgress(task.id);\n\n    expect(progress!.percent).toBe(42);\n    expect(progress!.message).toBeUndefined();\n  });\n});\n\n=== phase-10.test.ts ===\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 10: Recurring Tasks (Cron)', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers({ now: new Date('2025-01-01T00:00:00.000Z') });\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('schedule creates a recurring task definition', () => {\n    const schedule = queue.schedule('work', '*/5 * * * *', { type: 'cleanup' });\n\n    expect(schedule).toHaveProperty('id');\n    expect(schedule.queueName).toBe('work');\n    expect(schedule.cronExpression).toBe('*/5 * * * *');\n    expect(schedule.taskTemplate).toEqual({ type: 'cleanup' });\n    expect(schedule.active).toBe(true);\n  });\n\n  it('tick triggers scheduled tasks when they are due', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'periodic' });\n\n    // Advance 5 minutes\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const task = queue.dequeue('work');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({ type: 'periodic' });\n  });\n\n  it('unschedule stops future occurrences', () => {\n    const schedule = queue.schedule('work', '*/5 * * * *', { type: 'stop-me' });\n\n    queue.unschedule(schedule.id);\n\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('listSchedules returns active schedules', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'a' });\n    queue.schedule('work', '*/10 * * * *', { type: 'b' });\n    const toRemove = queue.schedule('other', '0 * * * *', { type: 'c' });\n\n    queue.unschedule(toRemove.id);\n\n    const schedules = queue.listSchedules();\n    expect(schedules.length).toBe(2);\n\n    const workSchedules = queue.listSchedules('work');\n    expect(workSchedules.length).toBe(2);\n  });\n\n  it('cron \"every 5 minutes\" triggers at correct intervals', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'five-min' });\n\n    // Advance 3 minutes - should not trigger\n    vi.advanceTimersByTime(3 * 60 * 1000);\n    queue.tick();\n    expect(queue.dequeue('work')).toBeNull();\n\n    // Advance 2 more minutes (total 5) - should trigger\n    vi.advanceTimersByTime(2 * 60 * 1000);\n    queue.tick();\n    expect(queue.dequeue('work')).not.toBeNull();\n  });\n\n  it('scheduled task gets the correct queue and payload', () => {\n    queue.schedule('notifications', '*/1 * * * *', {\n      type: 'reminder',\n      message: 'Check your inbox',\n    });\n\n    vi.advanceTimersByTime(1 * 60 * 1000);\n    queue.tick();\n\n    const task = queue.dequeue('notifications');\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({\n      type: 'reminder',\n      message: 'Check your inbox',\n    });\n\n    // Should not be in other queues\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('multiple schedules can coexist', () => {\n    queue.schedule('work', '*/5 * * * *', { type: 'every-5' });\n    queue.schedule('work', '*/10 * * * *', { type: 'every-10' });\n\n    // At 5 minutes, only every-5 triggers\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const tasks5 = [];\n    let t;\n    while ((t = queue.dequeue('work')) !== null) {\n      tasks5.push(t);\n    }\n    expect(tasks5.length).toBe(1);\n    expect(tasks5[0].payload).toEqual({ type: 'every-5' });\n\n    // At 10 minutes, both trigger\n    vi.advanceTimersByTime(5 * 60 * 1000);\n    queue.tick();\n\n    const tasks10 = [];\n    while ((t = queue.dequeue('work')) !== null) {\n      tasks10.push(t);\n    }\n    expect(tasks10.length).toBe(2);\n    const types = tasks10.map(t => t.payload.type).sort();\n    expect(types).toEqual(['every-10', 'every-5']);\n  });\n});\n\n=== phase-11.test.ts ===\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 11: Middleware Pipeline', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('middleware runs before task processing', async () => {\n    const log: string[] = [];\n\n    queue.use('work', async (_task, next) => {\n      log.push('middleware');\n      await next();\n    });\n\n    queue.enqueue('work', { job: 'test' });\n\n    await queue.process('work', async () => {\n      log.push('handler');\n    });\n\n    expect(log).toEqual(['middleware', 'handler']);\n  });\n\n  it('multiple middlewares run in the order they were added', async () => {\n    const log: string[] = [];\n\n    queue.use('work', async (_task, next) => {\n      log.push('first');\n      await next();\n    });\n\n    queue.use('work', async (_task, next) => {\n      log.push('second');\n      await next();\n    });\n\n    queue.use('work', async (_task, next) => {\n      log.push('third');\n      await next();\n    });\n\n    queue.enqueue('work', { job: 'test' });\n\n    await queue.process('work', async () => {\n      log.push('handler');\n    });\n\n    expect(log).toEqual(['first', 'second', 'third', 'handler']);\n  });\n\n  it('middleware can modify the task object', async () => {\n    queue.use('work', async (task, next) => {\n      task.payload.enriched = true;\n      task.payload.timestamp = '2025-01-01';\n      await next();\n    });\n\n    queue.enqueue('work', { job: 'enrich-me' });\n\n    let processedPayload: Record<string, unknown> | null = null;\n    await queue.process('work', async (task) => {\n      processedPayload = task.payload;\n    });\n\n    expect(processedPayload).toEqual({\n      job: 'enrich-me',\n      enriched: true,\n      timestamp: '2025-01-01',\n    });\n  });\n\n  it('middleware can skip processing by not calling next', async () => {\n    const log: string[] = [];\n\n    queue.use('work', async (_task, _next) => {\n      log.push('blocker');\n      // deliberately not calling next()\n    });\n\n    queue.enqueue('work', { job: 'blocked' });\n\n    await queue.process('work', async () => {\n      log.push('handler');\n    });\n\n    expect(log).toEqual(['blocker']);\n    expect(log).not.toContain('handler');\n  });\n\n  it('error in middleware fails the task', async () => {\n    queue.use('work', async (_task, _next) => {\n      throw new Error('middleware explosion');\n    });\n\n    const task = queue.enqueue('work', { job: 'explode' }, { maxRetries: 0 });\n\n    await queue.process('work', async () => {\n      // should not reach here\n    });\n\n    expect(task.status).toBe('failed');\n  });\n\n  it('middleware stacks are independent per queue', async () => {\n    const log: string[] = [];\n\n    queue.use('queue-a', async (_task, next) => {\n      log.push('a-middleware');\n      await next();\n    });\n\n    queue.use('queue-b', async (_task, next) => {\n      log.push('b-middleware');\n      await next();\n    });\n\n    queue.enqueue('queue-a', { job: 'a' });\n\n    await queue.process('queue-a', async () => {\n      log.push('a-handler');\n    });\n\n    expect(log).toEqual(['a-middleware', 'a-handler']);\n    expect(log).not.toContain('b-middleware');\n  });\n\n  it('middleware receives the task context', async () => {\n    let receivedTask: { id?: string; payload?: unknown; status?: string } | null = null;\n\n    queue.use('work', async (task, next) => {\n      receivedTask = task;\n      await next();\n    });\n\n    const enqueued = queue.enqueue('work', { job: 'context' });\n\n    await queue.process('work', async () => {});\n\n    expect(receivedTask).not.toBeNull();\n    expect(receivedTask!.id).toBe(enqueued.id);\n    expect(receivedTask!.payload).toEqual({ job: 'context' });\n  });\n});\n\n=== phase-12.test.ts ===\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 12: Graceful Shutdown', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('shutdown stops accepting new tasks', async () => {\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    await shutdownPromise;\n\n    expect(() => queue.enqueue('work', { job: 'too-late' })).toThrow();\n  });\n\n  it('shutdown waits for processing tasks to complete', async () => {\n    queue.enqueue('work', { job: 'in-flight' });\n    const task = queue.dequeue('work')!;\n\n    let resolved = false;\n    const shutdownPromise = queue.shutdown(10000).then((summary) => {\n      resolved = true;\n      return summary;\n    });\n\n    // Shutdown should not resolve yet (task still processing)\n    vi.advanceTimersByTime(100);\n    await Promise.resolve(); // flush microtasks\n    expect(resolved).toBe(false);\n\n    // Complete the task\n    queue.complete(task.id);\n    vi.advanceTimersByTime(0);\n    const summary = await shutdownPromise;\n\n    expect(resolved).toBe(true);\n    expect(summary.completed).toBe(1);\n  });\n\n  it('shutdown force-cancels tasks after timeout', async () => {\n    queue.enqueue('work', { job: 'slow' });\n    const task = queue.dequeue('work')!;\n\n    const shutdownPromise = queue.shutdown(3000);\n\n    // Advance past timeout\n    vi.advanceTimersByTime(3000);\n    const summary = await shutdownPromise;\n\n    expect(summary.cancelled).toBe(1);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('onShutdown callback fires during shutdown', async () => {\n    const log: string[] = [];\n    queue.onShutdown(() => {\n      log.push('shutdown-hook');\n    });\n\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    await shutdownPromise;\n\n    expect(log).toContain('shutdown-hook');\n  });\n\n  it('shutdown returns summary with completed, cancelled, and elapsed', async () => {\n    queue.enqueue('work', { job: 'fast' });\n    queue.enqueue('work', { job: 'slow' });\n\n    const fast = queue.dequeue('work')!;\n    const _slow = queue.dequeue('work')!;\n\n    const shutdownPromise = queue.shutdown(5000);\n\n    // Complete 'fast' quickly\n    queue.complete(fast.id);\n\n    // Let 'slow' timeout (it gets force-cancelled)\n    vi.advanceTimersByTime(5000);\n    const summary = await shutdownPromise;\n\n    expect(summary.completed).toBe(1);\n    expect(summary.cancelled).toBe(1);\n    expect(typeof summary.elapsed).toBe('number');\n    expect(summary.elapsed).toBeGreaterThanOrEqual(0);\n  });\n\n  it('multiple shutdown calls are idempotent', async () => {\n    const p1 = queue.shutdown(5000);\n    const p2 = queue.shutdown(5000);\n\n    vi.advanceTimersByTime(0);\n    const [s1, s2] = await Promise.all([p1, p2]);\n\n    // Should return the same result\n    expect(s1).toEqual(s2);\n  });\n\n  it('enqueue after shutdown throws an error', async () => {\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    await shutdownPromise;\n\n    expect(() => queue.enqueue('work', { job: 'rejected' })).toThrow();\n  });\n\n  it('shutdown with no processing tasks resolves immediately', async () => {\n    queue.enqueue('work', { job: 'pending-only' });\n    // Don't dequeue - nothing is processing\n\n    const shutdownPromise = queue.shutdown(5000);\n    vi.advanceTimersByTime(0);\n    const summary = await shutdownPromise;\n\n    expect(summary.completed).toBe(0);\n    expect(summary.cancelled).toBe(0);\n    expect(summary.elapsed).toBeLessThanOrEqual(100);\n  });\n});\n\n","numLines":1382,"startLine":1,"totalLines":1382}}}
