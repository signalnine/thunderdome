+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_6lwfh9dzCeIxUiDzaobF8390","type":"tool_result","content":"1\t// Types\n2\t\n3\texport interface Task {\n4\t  id: string;\n5\t  payload: unknown;\n6\t  status: 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';\n7\t  createdAt: Date;\n8\t  queueName: string;\n9\t  priority: number;\n10\t  availableAt: Date;\n11\t  maxRetries: number;\n12\t  backoffMs: number;\n13\t  attempts: number;\n14\t  failCount: number;\n15\t  lastError: unknown;\n16\t  dependsOn: string[];\n17\t  progress: { percent: number; message?: string; updatedAt: Date } | null;\n18\t}\n19\t\n20\texport interface EnqueueOptions {\n21\t  priority?: number;\n22\t  delay?: number;\n23\t  runAt?: Date;\n24\t  maxRetries?: number;\n25\t  backoffMs?: number;\n26\t  dependsOn?: string[];\n27\t}\n28\t\n29\texport interface Schedule {\n30\t  id: string;\n31\t  queueName: string;\n32\t  cronExpression: string;\n33\t  taskTemplate: unknown;\n34\t  active: boolean;\n35\t}\n36\t\n37\texport type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;\n38\texport type TaskHandler = (task: Task) => Promise<void>;\n39\t\n40\t// UUID generator (simple v4-like)\n41\tfunction generateId(): string {\n42\t  const bytes = new Uint8Array(16);\n43\t  for (let i = 0; i < 16; i++) {\n44\t    bytes[i] = Math.floor(Math.random() * 256);\n45\t  }\n46\t  bytes[6] = (bytes[6] & 0x0f) | 0x40;\n47\t  bytes[8] = (bytes[8] & 0x3f) | 0x80;\n48\t  const hex = bytes.reduce((s, b) => s + b.toString(16).padStart(2, '0'), '');\n49\t  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;\n50\t}\n51\t\n52\t// Cron parser for simple expressions\n53\tfunction parseCron(expr: string): { minutes: number[]; hours: number[]; days: number[]; months: number[]; weekdays: number[] } {\n54\t  const parts = expr.trim().split(/\\s+/);\n55\t  if (parts.length !== 5) {\n56\t    throw new Error(`Invalid cron expression: ${expr}`);\n57\t  }\n58\t\n59\t  const parseField = (field: string, min: number, max: number): number[] => {\n60\t    if (field === '*') {\n61\t      return Array.from({ length: max - min + 1 }, (_, i) => min + i);\n62\t    }\n63\t    if (field.startsWith('*/')) {\n64\t      const step = parseInt(field.slice(2), 10);\n65\t      const result: number[] = [];\n66\t      for (let i = min; i <= max; i += step) {\n67\t        result.push(i);\n68\t      }\n69\t      return result;\n70\t    }\n71\t    if (field.includes(',')) {\n72\t      return field.split(',').map(s => parseInt(s.trim(), 10));\n73\t    }\n74\t    return [parseInt(field, 10)];\n75\t  };\n76\t\n77\t  return {\n78\t    minutes: parseField(parts[0], 0, 59),\n79\t    hours: parseField(parts[1], 0, 23),\n80\t    days: parseField(parts[2], 1, 31),\n81\t    months: parseField(parts[3], 1, 12),\n82\t    weekdays: parseField(parts[4], 0, 6),\n83\t  };\n84\t}\n85\t\n86\tfunction isCronDue(parsed: ReturnType<typeof parseCron>, now: Date): boolean {\n87\t  return (\n88\t    parsed.minutes.includes(now.getUTCMinutes()) &&\n89\t    parsed.hours.includes(now.getUTCHours()) &&\n90\t    parsed.days.includes(now.getUTCDate()) &&\n91\t    parsed.months.includes(now.getUTCMonth() + 1) &&\n92\t    parsed.weekdays.includes(now.getUTCDay())\n93\t  );\n94\t}\n95\t\n96\texport class TaskQueue {\n97\t  private queues: Map<string, Task[]> = new Map();\n98\t  private allTasks: Map<string, Task> = new Map();\n99\t  private dlq: Map<string, Task[]> = new Map();\n100\t  private schedules: Map<string, Schedule> = new Map();\n101\t  private concurrency: Map<string, number> = new Map();\n102\t  private progressSubscribers: Map<string, Array<(info: { percent: number; message?: string; updatedAt: Date }) => void>> = new Map();\n103\t  private shutdownCallbacks: Array<() => void> = [];\n104\t  private isShuttingDown: boolean = false;\n105\t  private shutdownPromise: Promise<{ completed: number; cancelled: number; elapsed: number }> | null = null;\n106\t  private middlewareStacks: Map<string, Middleware[]> = new Map();\n107\t  private lastCronFire: Map<string, number> = new Map();\n108\t  private createdQueues: Set<string> = new Set();\n109\t  private shutdownResolve: ((result: { completed: number; cancelled: number; elapsed: number }) => void) | null = null;\n110\t  private shutdownProcessingTasks: Task[] = [];\n111\t  private shutdownResult: { completed: number; cancelled: number; elapsed: number } = { completed: 0, cancelled: 0, elapsed: 0 };\n112\t  private shutdownTimeoutTimer: ReturnType<typeof setTimeout> | null = null;\n113\t  private shutdownStartTime: number = 0;\n114\t\n115\t  constructor() {\n116\t    this.queues.set('default', []);\n117\t  }\n118\t\n119\t  // ---- Phase 1: Basic FIFO Queue ----\n120\t\n121\t  enqueue(queueName: string, payload: unknown, options?: EnqueueOptions): Task {\n122\t    if (this.isShuttingDown) {\n123\t      throw new Error('Cannot enqueue tasks after shutdown');\n124\t    }\n125\t\n126\t    const priority = options?.priority ?? 5;\n127\t    if (priority < 1 || priority > 10) {\n128\t      throw new Error(`Priority must be between 1 and 10, got ${priority}`);\n129\t    }\n130\t\n131\t    if (options?.dependsOn) {\n132\t      for (const depId of options.dependsOn) {\n133\t        if (!this.allTasks.has(depId)) {\n134\t          throw new Error(`Dependency task ${depId} does not exist`);\n135\t        }\n136\t      }\n137\t    }\n138\t\n139\t    const now = new Date();\n140\t    let availableAt: Date;\n141\t    if (options?.runAt) {\n142\t      availableAt = options.runAt;\n143\t    } else if (options?.delay) {\n144\t      availableAt = new Date(now.getTime() + options.delay);\n145\t    } else {\n146\t      availableAt = now;\n147\t    }\n148\t\n149\t    const task: Task = {\n150\t      id: generateId(),\n151\t      payload,\n152\t      status: 'pending',\n153\t      createdAt: now,\n154\t      queueName,\n155\t      priority,\n156\t      availableAt,\n157\t      maxRetries: options?.maxRetries ?? 3,\n158\t      backoffMs: options?.backoffMs ?? 1000,\n159\t      attempts: 0,\n160\t      failCount: 0,\n161\t      lastError: null,\n162\t      dependsOn: options?.dependsOn ?? [],\n163\t      progress: null,\n164\t    };\n165\t\n166\t    this.allTasks.set(task.id, task);\n167\t\n168\t    if (!this.queues.has(queueName)) {\n169\t      this.queues.set(queueName, []);\n170\t    }\n171\t    this.createdQueues.add(queueName);\n172\t    this.queues.get(queueName)!.push(task);\n173\t\n174\t    return task;\n175\t  }\n176\t\n177\t  dequeue(queueName: string): Task | null {\n178\t    const queue = this.queues.get(queueName);\n179\t    if (!queue || queue.length === 0) {\n180\t      return null;\n181\t    }\n182\t\n183\t    const maxConcurrent = this.concurrency.get(queueName);\n184\t    if (maxConcurrent !== undefined) {\n185\t      const currentProcessing = this.countProcessing(queueName);\n186\t      if (currentProcessing >= maxConcurrent) {\n187\t        return null;\n188\t      }\n189\t    }\n190\t\n191\t    const now = new Date();\n192\t\n193\t    const available: Task[] = [];\n194\t    for (const task of queue) {\n195\t      if (task.status !== 'pending') continue;\n196\t      if (task.availableAt.getTime() > now.getTime()) continue;\n197\t      if (!this.areDependenciesMet(task)) continue;\n198\t      available.push(task);\n199\t    }\n200\t\n201\t    if (available.length === 0) {\n202\t      return null;\n203\t    }\n204\t\n205\t    available.sort((a, b) => {\n206\t      if (a.priority !== b.priority) return a.priority - b.priority;\n207\t      const timeDiff = a.availableAt.getTime() - b.availableAt.getTime();\n208\t      if (timeDiff !== 0) return timeDiff;\n209\t      return a.createdAt.getTime() - b.createdAt.getTime();\n210\t    });\n211\t\n212\t    const chosen = available[0];\n213\t\n214\t    const idx = queue.indexOf(chosen);\n215\t    queue.splice(idx, 1);\n216\t\n217\t    chosen.status = 'processing';\n218\t    chosen.attempts = chosen.attempts + 1;\n219\t\n220\t    return chosen;\n221\t  }\n222\t\n223\t  size(): number {\n224\t    const queue = this.queues.get('default');\n225\t    if (!queue) return 0;\n226\t    return queue.filter(t => t.status === 'pending').length;\n227\t  }\n228\t\n229\t  // ---- Phase 2: Named Queues ----\n230\t\n231\t  listQueues(): string[] {\n232\t    return Array.from(this.createdQueues);\n233\t  }\n234\t\n235\t  queueSize(queueName: string): number {\n236\t    const queue = this.queues.get(queueName);\n237\t    if (!queue) return 0;\n238\t    return queue.filter(t => t.status === 'pending').length;\n239\t  }\n240\t\n241\t  // ---- Phase 5: Retry with Backoff ----\n242\t\n243\t  fail(taskId: string, error?: unknown): void {\n244\t    const task = this.allTasks.get(taskId);\n245\t    if (!task) return;\n246\t\n247\t    task.lastError = error ?? task.lastError;\n248\t    task.failCount = (task.failCount || 0) + 1;\n249\t\n250\t    const retriesUsed = task.attempts - 1;\n251\t    if (retriesUsed < task.maxRetries) {\n252\t      const backoffDelay = task.backoffMs * Math.pow(2, retriesUsed);\n253\t      const now = new Date();\n254\t      task.availableAt = new Date(now.getTime() + backoffDelay);\n255\t      task.status = 'pending';\n256\t\n257\t      const queue = this.queues.get(task.queueName);\n258\t      if (queue) {\n259\t        queue.push(task);\n260\t      }\n261\t    } else {\n262\t      task.status = 'failed';\n263\t      this.moveToDLQ(task);\n264\t    }\n265\t\n266\t    // If shutting down, check if all processing tasks are done\n267\t    if (this.isShuttingDown && this.shutdownResolve) {\n268\t      this.checkShutdownDone();\n269\t    }\n270\t  }\n271\t\n272\t  complete(taskId: string): void {\n273\t    const task = this.allTasks.get(taskId);\n274\t    if (!task) return;\n275\t\n276\t    task.status = 'completed';\n277\t\n278\t    this.checkDependents(taskId);\n279\t\n280\t    // If shutting down, check if all processing tasks are done\n281\t    if (this.isShuttingDown && this.shutdownResolve) {\n282\t      this.checkShutdownDone();\n283\t    }\n284\t  }\n285\t\n286\t  // ---- Phase 6: Dead Letter Queue ----\n287\t\n288\t  getDLQ(queueName: string): Task[] {\n289\t    return this.dlq.get(queueName) ?? [];\n290\t  }\n291\t\n292\t  retryDLQ(taskId: string): Task {\n293\t    let foundQueue: string | null = null;\n294\t    for (const [qName, tasks] of this.dlq.entries()) {\n295\t      const idx = tasks.findIndex(t => t.id === taskId);\n296\t      if (idx !== -1) {\n297\t        foundQueue = qName;\n298\t        tasks.splice(idx, 1);\n299\t        break;\n300\t      }\n301\t    }\n302\t\n303\t    if (!foundQueue) {\n304\t      throw new Error(`Task ${taskId} not found in DLQ`);\n305\t    }\n306\t\n307\t    const task = this.allTasks.get(taskId);\n308\t    if (!task) {\n309\t      throw new Error(`Task ${taskId} not found`);\n310\t    }\n311\t\n312\t    task.status = 'pending';\n313\t    task.attempts = 0;\n314\t    task.failCount = 0;\n315\t    task.availableAt = new Date();\n316\t\n317\t    const queue = this.queues.get(foundQueue);\n318\t    if (queue) {\n319\t      queue.push(task);\n320\t    }\n321\t\n322\t    return task;\n323\t  }\n324\t\n325\t  clearDLQ(queueName: string): void {\n326\t    this.dlq.set(queueName, []);\n327\t  }\n328\t\n329\t  private moveToDLQ(task: Task): void {\n330\t    if (!this.dlq.has(task.queueName)) {\n331\t      this.dlq.set(task.queueName, []);\n332\t    }\n333\t    this.dlq.get(task.queueName)!.push(task);\n334\t  }\n335\t\n336\t  // ---- Phase 7: Task Dependencies ----\n337\t\n338\t  getDependencies(taskId: string): Array<{ taskId: string; status: string }> {\n339\t    const task = this.allTasks.get(taskId);\n340\t    if (!task) {\n341\t      throw new Error(`Task ${taskId} not found`);\n342\t    }\n343\t\n344\t    return task.dependsOn.map(depId => {\n345\t      const depTask = this.allTasks.get(depId);\n346\t      return {\n347\t        taskId: depId,\n348\t        status: depTask?.status ?? 'unknown',\n349\t      };\n350\t    });\n351\t  }\n352\t\n353\t  private areDependenciesMet(task: Task): boolean {\n354\t    if (task.dependsOn.length === 0) return true;\n355\t    for (const depId of task.dependsOn) {\n356\t      const depTask = this.allTasks.get(depId);\n357\t      if (!depTask || depTask.status !== 'completed') {\n358\t        return false;\n359\t      }\n360\t    }\n361\t    return true;\n362\t  }\n363\t\n364\t  private checkDependents(completedTaskId: string): void {\n365\t    for (const task of this.allTasks.values()) {\n366\t      if (task.status === 'pending' && task.dependsOn.includes(completedTaskId)) {\n367\t        // Task may now be unblocked - dequeue will check areDependenciesMet\n368\t      }\n369\t    }\n370\t  }\n371\t\n372\t  private checkShutdownDone(): void {\n373\t    if (!this.shutdownResolve) return;\n374\t    if (this.shutdownProcessingTasks.length === 0) return;\n375\t\n376\t    const checkDone = (): boolean => {\n377\t      for (const task of this.shutdownProcessingTasks) {\n378\t        if (task.status === 'processing') {\n379\t          return false;\n380\t        }\n381\t      }\n382\t      return true;\n383\t    };\n384\t\n385\t    if (checkDone()) {\n386\t      if (this.shutdownTimeoutTimer) {\n387\t        clearTimeout(this.shutdownTimeoutTimer);\n388\t        this.shutdownTimeoutTimer = null;\n389\t      }\n390\t      for (const task of this.shutdownProcessingTasks) {\n391\t        if (task.status === 'completed') {\n392\t          this.shutdownResult.completed++;\n393\t        }\n394\t      }\n395\t      this.shutdownResult.elapsed = Date.now() - this.shutdownStartTime;\n396\t      const resolve = this.shutdownResolve;\n397\t      this.shutdownResolve = null;\n398\t      resolve(this.shutdownResult);\n399\t    }\n400\t  }\n401\t\n402\t  // ---- Phase 8: Concurrency Control ----\n403\t\n404\t  setConcurrency(queueName: string, limit: number): void {\n405\t    this.concurrency.set(queueName, limit);\n406\t  }\n407\t\n408\t  getConcurrency(queueName: string): { current: number; max: number } {\n409\t    const max = this.concurrency.get(queueName);\n410\t    return {\n411\t      current: this.countProcessing(queueName),\n412\t      max: max ?? Infinity,\n413\t    };\n414\t  }\n415\t\n416\t  private countProcessing(queueName: string): number {\n417\t    let count = 0;\n418\t    for (const task of this.allTasks.values()) {\n419\t      if (task.queueName === queueName && task.status === 'processing') {\n420\t        count++;\n421\t      }\n422\t    }\n423\t    return count;\n424\t  }\n425\t\n426\t  // ---- Phase 9: Progress and Cancellation ----\n427\t\n428\t  updateProgress(taskId: string, percent: number, message?: string): void {\n429\t    const task = this.allTasks.get(taskId);\n430\t    if (!task) return;\n431\t\n432\t    if (percent < 0 || percent > 100) {\n433\t      throw new Error('Progress must be between 0 and 100');\n434\t    }\n435\t\n436\t    const now = new Date();\n437\t    task.progress = { percent, message, updatedAt: now };\n438\t\n439\t    const subscribers = this.progressSubscribers.get(taskId);\n440\t    if (subscribers) {\n441\t      for (const cb of subscribers) {\n442\t        cb({ percent, message, updatedAt: now });\n443\t      }\n444\t    }\n445\t  }\n446\t\n447\t  getProgress(taskId: string): { percent: number; message?: string; updatedAt: Date } | null {\n448\t    const task = this.allTasks.get(taskId);\n449\t    if (!task) return null;\n450\t    return task.progress;\n451\t  }\n452\t\n453\t  cancel(taskId: string): void {\n454\t    const task = this.allTasks.get(taskId);\n455\t    if (!task) return;\n456\t\n457\t    task.status = 'cancelled';\n458\t\n459\t    const queue = this.queues.get(task.queueName);\n460\t    if (queue) {\n461\t      const idx = queue.indexOf(task);\n462\t      if (idx !== -1) {\n463\t        queue.splice(idx, 1);\n464\t      }\n465\t    }\n466\t  }\n467\t\n468\t  onProgress(taskId: string, callback: (info: { percent: number; message?: string; updatedAt: Date }) => void): () => void {\n469\t    if (!this.progressSubscribers.has(taskId)) {\n470\t      this.progressSubscribers.set(taskId, []);\n471\t    }\n472\t    this.progressSubscribers.get(taskId)!.push(callback);\n473\t\n474\t    return () => {\n475\t      const subs = this.progressSubscribers.get(taskId);\n476\t      if (subs) {\n477\t        const idx = subs.indexOf(callback);\n478\t        if (idx !== -1) {\n479\t          subs.splice(idx, 1);\n480\t        }\n481\t      }\n482\t    };\n483\t  }\n484\t\n485\t  // ---- Phase 10: Recurring Tasks (Cron) ----\n486\t\n487\t  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {\n488\t    const schedule: Schedule = {\n489\t      id: generateId(),\n490\t      queueName,\n491\t      cronExpression,\n492\t      taskTemplate,\n493\t      active: true,\n494\t    };\n495\t    this.schedules.set(schedule.id, schedule);\n496\t    return schedule;\n497\t  }\n498\t\n499\t  unschedule(scheduleId: string): void {\n500\t    const schedule = this.schedules.get(scheduleId);\n501\t    if (schedule) {\n502\t      schedule.active = false;\n503\t    }\n504\t  }\n505\t\n506\t  listSchedules(queueName?: string): Schedule[] {\n507\t    const active = Array.from(this.schedules.values()).filter(s => s.active);\n508\t    if (queueName) {\n509\t      return active.filter(s => s.queueName === queueName);\n510\t    }\n511\t    return active;\n512\t  }\n513\t\n514\t  tick(): void {\n515\t    const now = new Date();\n516\t    for (const schedule of this.schedules.values()) {\n517\t      if (!schedule.active) continue;\n518\t\n519\t      const parsed = parseCron(schedule.cronExpression);\n520\t\n521\t      const key = `${schedule.id}:${now.getUTCFullYear()}-${now.getUTCMonth()}-${now.getUTCDate()}-${now.getUTCHours()}-${now.getUTCMinutes()}`;\n522\t      if (this.lastCronFire.has(key)) continue;\n523\t\n524\t      if (isCronDue(parsed, now)) {\n525\t        this.enqueue(schedule.queueName, schedule.taskTemplate);\n526\t        this.lastCronFire.set(key, 1);\n527\t      }\n528\t    }\n529\t  }\n530\t\n531\t  // ---- Phase 11: Middleware Pipeline ----\n532\t\n533\t  use(queueName: string, middleware: Middleware): void {\n534\t    if (!this.middlewareStacks.has(queueName)) {\n535\t      this.middlewareStacks.set(queueName, []);\n536\t    }\n537\t    this.middlewareStacks.get(queueName)!.push(middleware);\n538\t  }\n539\t\n540\t  async process(queueName: string, handler: TaskHandler): Promise<void> {\n541\t    const task = this.dequeue(queueName);\n542\t    if (!task) return;\n543\t\n544\t    const middlewares = this.middlewareStacks.get(queueName) ?? [];\n545\t\n546\t    try {\n547\t      let i = 0;\n548\t      const next = async (): Promise<void> => {\n549\t        i++;\n550\t        if (i < middlewares.length) {\n551\t          await middlewares[i](task, next);\n552\t        } else {\n553\t          await handler(task);\n554\t        }\n555\t      };\n556\t\n557\t      if (middlewares.length > 0) {\n558\t        await middlewares[0](task, next);\n559\t      } else {\n560\t        await handler(task);\n561\t      }\n562\t    } catch (error) {\n563\t      task.status = 'failed';\n564\t      task.lastError = error;\n565\t      task.failCount = (task.failCount || 0) + 1;\n566\t\n567\t      const retriesUsed = task.attempts - 1;\n568\t      if (retriesUsed < task.maxRetries) {\n569\t        const backoffDelay = task.backoffMs * Math.pow(2, retriesUsed);\n570\t        const now = new Date();\n571\t        task.availableAt = new Date(now.getTime() + backoffDelay);\n572\t        task.status = 'pending';\n573\t        const queue = this.queues.get(task.queueName);\n574\t        if (queue) {\n575\t          queue.push(task);\n576\t        }\n577\t      } else {\n578\t        this.moveToDLQ(task);\n579\t      }\n580\t    }\n581\t  }\n582\t\n583\t  // ---- Phase 12: Graceful Shutdown ----\n584\t\n585\t  onShutdown(callback: () => void): void {\n586\t    this.shutdownCallbacks.push(callback);\n587\t  }\n588\t\n589\t  async shutdown(timeout: number = 30000): Promise<{ completed: number; cancelled: number; elapsed: number }> {\n590\t    if (this.shutdownPromise) {\n591\t      return this.shutdownPromise;\n592\t    }\n593\t\n594\t    const startTime = Date.now();\n595\t    this.shutdownStartTime = startTime;\n596\t    this.isShuttingDown = true;\n597\t\n598\t    for (const cb of this.shutdownCallbacks) {\n599\t      cb();\n600\t    }\n601\t\n602\t    const processingTasks = Array.from(this.allTasks.values()).filter(\n603\t      t => t.status === 'processing'\n604\t    );\n605\t\n606\t    if (processingTasks.length === 0) {\n607\t      const elapsed = Date.now() - startTime;\n608\t      const result = { completed: 0, cancelled: 0, elapsed };\n609\t      this.shutdownPromise = Promise.resolve(result);\n610\t      return result;\n611\t    }\n612\t\n613\t    this.shutdownProcessingTasks = processingTasks;\n614\t    this.shutdownResult = { completed: 0, cancelled: 0, elapsed: 0 };\n615\t\n616\t    const checkDone = (): boolean => {\n617\t      for (const task of this.shutdownProcessingTasks) {\n618\t        if (task.status === 'processing') {\n619\t          return false;\n620\t        }\n621\t      }\n622\t      return true;\n623\t    };\n624\t\n625\t    const resolveShutdown = () => {\n626\t      if (this.shutdownResolve) {\n627\t        for (const task of this.shutdownProcessingTasks) {\n628\t          if (task.status === 'completed') {\n629\t            this.shutdownResult.completed++;\n630\t          }\n631\t        }\n632\t        this.shutdownResult.elapsed = Date.now() - startTime;\n633\t        const resolve = this.shutdownResolve;\n634\t        this.shutdownResolve = null;\n635\t        resolve(this.shutdownResult);\n636\t      }\n637\t    };\n638\t\n639\t    const promise = new Promise<{ completed: number; cancelled: number; elapsed: number }>((resolve) => {\n640\t      this.shutdownResolve = resolve;\n641\t\n642\t      // Set up timeout for force-cancel\n643\t      this.shutdownTimeoutTimer = setTimeout(() => {\n644\t        for (const task of this.shutdownProcessingTasks) {\n645\t          if (task.status === 'processing') {\n646\t            task.status = 'cancelled';\n647\t            this.shutdownResult.cancelled++;\n648\t          }\n649\t        }\n650\t        for (const task of this.shutdownProcessingTasks) {\n651\t          if (task.status === 'completed') {\n652\t            this.shutdownResult.completed++;\n653\t          }\n654\t        }\n655\t        this.shutdownResult.elapsed = Date.now() - startTime;\n656\t        const resolve = this.shutdownResolve;\n657\t        this.shutdownResolve = null;\n658\t        if (resolve) resolve(this.shutdownResult);\n659\t      }, timeout);\n660\t\n661\t      // Check immediately if already done\n662\t      if (checkDone()) {\n663\t        resolveShutdown();\n664\t      }\n665\t    });\n666\t\n667\t    this.shutdownPromise = promise;\n668\t    return promise;\n669\t  }\n670\t}\n671\t"}]},"parent_tool_use_id":null,"session_id":"b5fbacb1-34c1-420d-b77d-10de274f043f","uuid":"f0018869-9fcf-4f3e-86ef-f6927044c112","timestamp":"2026-07-25T18:25:00.124Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/index.ts","content":"// Types\n\nexport interface Task {\n  id: string;\n  payload: unknown;\n  status: 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';\n  createdAt: Date;\n  queueName: string;\n  priority: number;\n  availableAt: Date;\n  maxRetries: number;\n  backoffMs: number;\n  attempts: number;\n  failCount: number;\n  lastError: unknown;\n  dependsOn: string[];\n  progress: { percent: number; message?: string; updatedAt: Date } | null;\n}\n\nexport interface EnqueueOptions {\n  priority?: number;\n  delay?: number;\n  runAt?: Date;\n  maxRetries?: number;\n  backoffMs?: number;\n  dependsOn?: string[];\n}\n\nexport interface Schedule {\n  id: string;\n  queueName: string;\n  cronExpression: string;\n  taskTemplate: unknown;\n  active: boolean;\n}\n\nexport type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;\nexport type TaskHandler = (task: Task) => Promise<void>;\n\n// UUID generator (simple v4-like)\nfunction generateId(): string {\n  const bytes = new Uint8Array(16);\n  for (let i = 0; i < 16; i++) {\n    bytes[i] = Math.floor(Math.random() * 256);\n  }\n  bytes[6] = (bytes[6] & 0x0f) | 0x40;\n  bytes[8] = (bytes[8] & 0x3f) | 0x80;\n  const hex = bytes.reduce((s, b) => s + b.toString(16).padStart(2, '0'), '');\n  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;\n}\n\n// Cron parser for simple expressions\nfunction parseCron(expr: string): { minutes: number[]; hours: number[]; days: number[]; months: number[]; weekdays: number[] } {\n  const parts = expr.trim().split(/\\s+/);\n  if (parts.length !== 5) {\n    throw new Error(`Invalid cron expression: ${expr}`);\n  }\n\n  const parseField = (field: string, min: number, max: number): number[] => {\n    if (field === '*') {\n      return Array.from({ length: max - min + 1 }, (_, i) => min + i);\n    }\n    if (field.startsWith('*/')) {\n      const step = parseInt(field.slice(2), 10);\n      const result: number[] = [];\n      for (let i = min; i <= max; i += step) {\n        result.push(i);\n      }\n      return result;\n    }\n    if (field.includes(',')) {\n      return field.split(',').map(s => parseInt(s.trim(), 10));\n    }\n    return [parseInt(field, 10)];\n  };\n\n  return {\n    minutes: parseField(parts[0], 0, 59),\n    hours: parseField(parts[1], 0, 23),\n    days: parseField(parts[2], 1, 31),\n    months: parseField(parts[3], 1, 12),\n    weekdays: parseField(parts[4], 0, 6),\n  };\n}\n\nfunction isCronDue(parsed: ReturnType<typeof parseCron>, now: Date): boolean {\n  return (\n    parsed.minutes.includes(now.getUTCMinutes()) &&\n    parsed.hours.includes(now.getUTCHours()) &&\n    parsed.days.includes(now.getUTCDate()) &&\n    parsed.months.includes(now.getUTCMonth() + 1) &&\n    parsed.weekdays.includes(now.getUTCDay())\n  );\n}\n\nexport class TaskQueue {\n  private queues: Map<string, Task[]> = new Map();\n  private allTasks: Map<string, Task> = new Map();\n  private dlq: Map<string, Task[]> = new Map();\n  private schedules: Map<string, Schedule> = new Map();\n  private concurrency: Map<string, number> = new Map();\n  private progressSubscribers: Map<string, Array<(info: { percent: number; message?: string; updatedAt: Date }) => void>> = new Map();\n  private shutdownCallbacks: Array<() => void> = [];\n  private isShuttingDown: boolean = false;\n  private shutdownPromise: Promise<{ completed: number; cancelled: number; elapsed: number }> | null = null;\n  private middlewareStacks: Map<string, Middleware[]> = new Map();\n  private lastCronFire: Map<string, number> = new Map();\n  private createdQueues: Set<string> = new Set();\n  private shutdownResolve: ((result: { completed: number; cancelled: number; elapsed: number }) => void) | null = null;\n  private shutdownProcessingTasks: Task[] = [];\n  private shutdownResult: { completed: number; cancelled: number; elapsed: number } = { completed: 0, cancelled: 0, elapsed: 0 };\n  private shutdownTimeoutTimer: ReturnType<typeof setTimeout> | null = null;\n  private shutdownStartTime: number = 0;\n\n  constructor() {\n    this.queues.set('default', []);\n  }\n\n  // ---- Phase 1: Basic FIFO Queue ----\n\n  enqueue(queueName: string, payload: unknown, options?: EnqueueOptions): Task {\n    if (this.isShuttingDown) {\n      throw new Error('Cannot enqueue tasks after shutdown');\n    }\n\n    const priority = options?.priority ?? 5;\n    if (priority < 1 || priority > 10) {\n      throw new Error(`Priority must be between 1 and 10, got ${priority}`);\n    }\n\n    if (options?.dependsOn) {\n      for (const depId of options.dependsOn) {\n        if (!this.allTasks.has(depId)) {\n          throw new Error(`Dependency task ${depId} does not exist`);\n        }\n      }\n    }\n\n    const now = new Date();\n    let availableAt: Date;\n    if (options?.runAt) {\n      availableAt = options.runAt;\n    } else if (options?.delay) {\n      availableAt = new Date(now.getTime() + options.delay);\n    } else {\n      availableAt = now;\n    }\n\n    const task: Task = {\n      id: generateId(),\n      payload,\n      status: 'pending',\n      createdAt: now,\n      queueName,\n      priority,\n      availableAt,\n      maxRetries: options?.maxRetries ?? 3,\n      backoffMs: options?.backoffMs ?? 1000,\n      attempts: 0,\n      failCount: 0,\n      lastError: null,\n      dependsOn: options?.dependsOn ?? [],\n      progress: null,\n    };\n\n    this.allTasks.set(task.id, task);\n\n    if (!this.queues.has(queueName)) {\n      this.queues.set(queueName, []);\n    }\n    this.createdQueues.add(queueName);\n    this.queues.get(queueName)!.push(task);\n\n    return task;\n  }\n\n  dequeue(queueName: string): Task | null {\n    const queue = this.queues.get(queueName);\n    if (!queue || queue.length === 0) {\n      return null;\n    }\n\n    const maxConcurrent = this.concurrency.get(queueName);\n    if (maxConcurrent !== undefined) {\n      const currentProcessing = this.countProcessing(queueName);\n      if (currentProcessing >= maxConcurrent) {\n        return null;\n      }\n    }\n\n    const now = new Date();\n\n    const available: Task[] = [];\n    for (const task of queue) {\n      if (task.status !== 'pending') continue;\n      if (task.availableAt.getTime() > now.getTime()) continue;\n      if (!this.areDependenciesMet(task)) continue;\n      available.push(task);\n    }\n\n    if (available.length === 0) {\n      return null;\n    }\n\n    available.sort((a, b) => {\n      if (a.priority !== b.priority) return a.priority - b.priority;\n      const timeDiff = a.availableAt.getTime() - b.availableAt.getTime();\n      if (timeDiff !== 0) return timeDiff;\n    