;\n        const now = new Date();\n        task.availableAt = new Date(now.getTime() + backoffDelay);\n        task.status = 'pending';\n        const queue = this.queues.get(task.queueName);\n        if (queue) {\n          queue.push(task);\n        }\n      } else {\n        this.moveToDLQ(task);\n      }\n    }\n  }\n\n  // ---- Phase 12: Graceful Shutdown ----\n\n  onShutdown(callback: () => void): void {\n    this.shutdownCallbacks.push(callback);\n  }\n\n  async shutdown(timeout: number = 30000): Promise<{ completed: number; cancelled: number; elapsed: number }> {\n    if (this.shutdownPromise) {\n      return this.shutdownPromise;\n    }\n\n    const startTime = Date.now();\n    this.isShuttingDown = true;\n\n    for (const cb of this.shutdownCallbacks) {\n      cb();\n    }\n\n    const processingTasks = Array.from(this.allTasks.values()).filter(\n      t => t.status === 'processing'\n    );\n\n    if (processingTasks.length === 0) {\n      const elapsed = Date.now() - startTime;\n      const result = { completed: 0, cancelled: 0, elapsed };\n      this.shutdownPromise = Promise.resolve(result);\n      return result;\n    }\n\n    const result = { completed: 0, cancelled: 0, elapsed: 0 };\n\n    const checkDone = (): boolean => {\n      for (const task of processingTasks) {\n        if (task.status === 'processing') {\n          return false;\n        }\n      }\n      return true;\n    };\n\n    const promise = new Promise<{ completed: number; cancelled: number; elapsed: number }>((resolve) => {\n      const pollInterval = setInterval(() => {\n        if (checkDone()) {\n          clearInterval(pollInterval);\n          clearTimeout(timeoutTimer);\n          for (const task of processingTasks) {\n            if (task.status === 'completed') {\n              result.completed++;\n            }\n          }\n          result.elapsed = Date.now() - startTime;\n          resolve(result);\n        }\n      }, 10);\n\n      const timeoutTimer = setTimeout(() => 