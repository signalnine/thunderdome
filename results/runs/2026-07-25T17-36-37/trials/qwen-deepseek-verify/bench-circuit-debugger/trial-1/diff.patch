 'XOR', in1: xi, in2: yi, out: ti });\n    gates.push({ op: 'XOR', in1: ti, in2: cPrev, out: zi });\n    gates.push({ op: 'AND', in1: xi, in2: yi, out: ai });\n    gates.push({ op: 'AND', in1: ti, in2: cPrev, out: bi });\n\n    if (i === N - 1) {\n      // Last bit: carry gate produces zN\n      gates.push({ op: 'OR', in1: ai, in2: bi, out: `z${String(N).padStart(2, '0')}` });\n    } else {\n      gates.push({ op: 'OR', in1: ai, in2: bi, out: ci });\n    }\n  }\n\n  return gates;\n}\n\n","structuredPatch":[{"oldStart":177,"oldLines":11,"newStart":177,"newLines":6,"lines":["   return `${g.op}:${inputs[0]}:${inputs[1]}`;"," }"," ","-/** Check if (a,b) is a permutation of (x,y) */","-function isPair(a: string, b: string, x: string, y: string): boolean {","-  return (a === x && b === y) || (a === y && b === x);","-}","-"," /**","  * Build a correct N-bit adder circuit.","  *"]}],"userModified":false,"replaceAll":false}}
