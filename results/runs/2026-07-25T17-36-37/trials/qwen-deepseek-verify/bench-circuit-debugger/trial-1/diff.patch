const wires: Record<string, number> = { ...inputs };\n\n  // Map: output wire -> gate index\n  const gateByOut = new Map<string, number>();\n  for (let i = 0; i < gates.length; i++) {\n    gateByOut.set(gates[i].out, i);\n  }\n\n  // Compute in-degree: how many producer gates must fire before this gate\n  const inDegree = new Array(gates.length).fill(0);\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    if (gateByOut.has(g.in1)) inDegree[i]++;\n    if (gateByOut.has(g.in2)) inDegree[i]++;\n  }\n\n  // Reverse adjacency: when a gate fires, which gates' in-degree decreases\n  const dependents = new Map<number, number[]>();\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    for (const wire of [g.in1, g.in2]) {\n      const producer = gateByOut.get(wire);\n      if (producer !== undefined) {\n        if (!dependents.has(producer)) dependents.set(producer, []);\n        dependents.get(producer)!.push(i);\n      }\n    }\n  }\n\n  // Topological sort (Kahn's algorithm)\n  const queue: number[] = [];\n  for (let i = 0; i < gates.length; i++) {\n    if (inDegree[i] === 0) queue.push(i);\n  }\n\n  const order: number[] = [];\n  while (queue.length > 0) {\n    const i = queue.shift()!;\n    order.push(i);\n    for (const dep of (dependents.get(i) ?? [])) {\n      inDegree[dep]--;\n      if (inDegree[dep] === 0) queue.push(dep);\n    }\n  }\n\n  // Evaluate gates in topological order\n  for (const i of order) {\n    const g = gates[i];\n    const v1 = wires[g.in1] ?? 0;\n    const v2 = wires[g.in2] ?? 0;\n    let result: number;\n    switch (g.op) {\n      case 'AND':\n        result = v1 & v2;\n        break;\n      case 'OR':\n        result = v1 | v2;\n        break;\n      case 'XOR':\n        result = v1 ^ v2;\n        break;\n    }\n    wires[g.out] = result;\n  }\n\n  return wires;\n}\n\n// ─── findSwappedWires ────────────────────────────────────────────────────────\n\n/**\n * Find the 8 wires involved in 4 swap pairs in a swapped adder circuit.\n *\n * Strategy: trace through the adder circuit structure, identifying each gate's\n * structural role by its position in the circuit graph. Compare the actual\n * output wire name with the expected name. Mismatches reveal the swapped wires.\n *\n * Key insight: gates are identified by their position in the graph, not by\n * their input wire names. This works even when output wires have been swapped,\n * because the graph structure is preserved.\n *\n * In a correct N-bit adder:\n *   Bit 0 (half adder):\n *     x00 XOR y00 -> z00          (sum bit 0)\n *     x00 AND y00 -> c00          (carry out 0)\n *   Bit i (i > 0):\n *     xi XOR yi -> ti              (partial sum)\n *     ti XOR c(i-1) -> zi          (final sum)\n *     xi AND yi -> ai              (generate)\n *     ti AND c(i-1) -> bi          (propagate)\n *     ai OR bi -> ci               (carry out)\n *   Last bit: carry gate produces zN (the MSB)\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  // Step 1: Determine the number of input bits (N)\n  let maxBit = 0;\n  for (const g of gates) {\n    for (const wire of [g.in1, g.in2]) {\n      const m = wire.match(/^x(\\d+)$/);\n      if (m) maxBit = Math.max(maxBit, parseInt(m[1], 10));\n      const m2 = wire.match(/^y(\\d+)$/);\n      if (m2) maxBit = Math.max(maxBit, parseInt(m2[1], 10));\n    }\n  }\n  const N = maxBit + 1; // number of input bits\n\n  // Step 2: Build a map of gate index by output wire\n  const gateByOut = new Map<string, number>();\n  for (let i = 0; i < gates.length; i++) {\n    gateByOut.set(gates[i].out, i);\n  }\n\n  // Build a map: for each wire, which gates use it as an input\n  const consumers = new Map<string, number[]>();\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    for (const wire of [g.in1, g.in2]) {\n      if (!consumers.has(wire)) consumers.set(wire, []);\n      consumers.get(wire)!.push(i);\n    }\n  }\n\n  // Step 3: Identify each gate's structural role and expected output wire\n  const expectedOut = new Map<number, string>();\n\n  // Bit 0: half adder\n  // x00 XOR y00 -> z00\n  // x00 AND y00 -> c00\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    if (g.op === 'XOR' && isPair(g.in1, g.in2, 'x00', 'y00')) {\n      expectedOut.set(i, 'z00');\n    } else if (g.op === 'AND' && isPair(g.in1, g.in2, 'x00', 'y00')) {\n      expectedOut.set(i, 'c00');\n    }\n  }\n\n  // Find the actual output wire of the carry gate for bit 0\n  let carryWire: string | undefined;\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    if (g.op === 'AND' && isPair(g.in1, g.in2, 'x00', 'y00')) {\n      carryWire = g.out;\n      break;\n    }\n  }\n  if (carryWire === undefined) {\n    throw new Error('Could not find c00 gate');\n  }\n\n  // Trace the carry chain from c00 through bits 1..N-1\n  for (let i = 1; i < N; i++) {\n    const xi = `x${String(i).padStart(2, '0')}`;\n    const yi = `y${String(i).padStart(2, '0')}`;\n    const tiName = `t${String(i).padStart(2, '0')}`;\n    const aiName = `a${String(i).padStart(2, '0')}`;\n    const biName = `b${String(i).padStart(2, '0')}`;\n    const ziName = `z${String(i).padStart(2, '0')}`;\n\n    // Partial sum gate: xi XOR yi -> ti\n    // Identified by inputs: xi, yi\n    const partialSumGate = findGate(gates, 'XOR', xi, yi);\n    if (partialSumGate === undefined) {\n      throw new Error(`Could not find partial sum gate for bit ${i}`);\n    }\n    const ti = gates[partialSumGate].out; // actual output wire\n    expectedOut.set(partialSumGate, tiName);\n\n    // Generate gate: xi AND yi -> ai\n    // Identified by inputs: xi, yi\n    const genGate = findGate(gates, 'AND', xi, yi);\n    if (genGate === undefined) {\n      throw new Error(`Could not find generate gate for bit ${i}`);\n    }\n    const ai = gates[genGate].out; // actual output wire\n    expectedOut.set(genGate, aiName);\n\n    // Sum gate: the XOR gate that takes ti as one input\n    // (the other input is the previous carry wire)\n    const sumGate = findGateWithInput(gates, 'XOR', ti);\n    if (sumGate === undefined) {\n      throw new Error(`Could not find sum gate for bit ${i}`);\n    }\n    expectedOut.set(sumGate, ziName);\n\n    // Propagate gate: the AND gate that takes ti as one input\n    // (the other input is the previous carry wire)\n    const propGate = findGateWithInput(gates, 'AND', ti);\n    if (propGate === undefined) {\n      throw new Error(`Could not find propagate gate for bit ${i}`);\n    }\n    const bi = gates[propGate].out; // actual output wire\n    expectedOut.set(propGate, biName);\n\n    // Carry gate: the OR gate that takes bi as one input\n    // (the other input is the generate output wire)\n    const carryGate = findGateWithInput(gates, 'OR', bi);\n    if (carryGate === undefined) {\n      throw new Error(`Could not find carry gate for bit ${i}`);\n    }\n    const ci = gates[carryGate].out; // actual output wire\n\n    // For the last bit, the carry gate produces zN (the MSB)\n    if (i === N - 1) {\n      expectedOut.set(carryGate, `z${String(N).padStart(2, '0')}`);\n    } else {\n      expectedOut.set(carryGate, `c${String(i).padStart(2, '0')}`);\n    }\n\n    // Update carry wire for next iteration\n    carryWire = ci;\n  }\n\n  // Step 4: Find wires where actual name differs from expected name\n  const swappedWires = new Set<string>();\n\n  for (const [gateIdx, expected] of expectedOut) {\n    const actual = gates[gateIdx].out;\n    if (actual !== expected) {\n      swappedWires.add(actual);\n      swappedWires.add(expected);\n    }\n  }\n\n  return [...swappedWires].sort();\n}\n\n// ─── helpers ─────────────────────────────────────────────────────────────────\n\n/** Check if (a,b) is a permutation of (x,y) */\nfunction isPair(a: string, b: string, x: string, y: string): boolean {\n  return (a === x && b === y) || (a === y && b === x);\n}\n\n/** Find a gate with the given operation and input pair */\nfunction findGate(\n  gates: Gate[],\n  op: Gate['op'],\n  w1: string,\n  w2: string,\n): number | undefined {\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    if (g.op === op && isPair(g.in1, g.in2, w1, w2)) {\n      return i;\n    }\n  }\n  return undefined;\n}\n\n/** Find a gate with the given operation that has the given wire as one of its inputs */\nfunction findGateWithInput(\n  gates: Gate[],\n  op: Gate['op'],\n  wire: string,\n): number | undefined {\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    if (g.op === op && (g.in1 === wire || g.in2 === wire)) {\n      return i;\n    }\n  }\n  return undefined;\n}\n","userModified":false}}
