+  });
+
+  it('finds two swap pairs', () => {
+    const gates = correct4BitAdder();
+    swapOut(gates, 'z01', 'a01');
+    swapOut(gates, 'z02', 'b02');
+
+    const result = findSwappedWires(gates);
+    expect(result).toEqual(['a01', 'b02', 'z01', 'z02']);
+  });
+
+  it('finds four swap pairs (8 wires)', () => {
+    const gates = correct4BitAdder();
+    swapOut(gates, 'z01', 'a01');
+    swapOut(gates, 'z02', 'b02');
+    swapOut(gates, 'c00', 'z00');
+    swapOut(gates, 't03', 'a03');
+
+    const result = findSwappedWires(gates);
+    expect(result).toEqual(['a01', 'a03', 'b02', 'c00', 't03', 'z00', 'z01', 'z02']);
+  });
+
+  it('finds swaps involving carry wires', () => {
+    const gates = correct4BitAdder();
+    swapOut(gates, 'c01', 'c02');
+    swapOut(gates, 'z01', 'z02');
+    swapOut(gates, 't01', 'a01');
+    swapOut(gates, 'b01', 'c00');
+
+    const result = findSwappedWires(gates);
+    expect(result).toEqual(['a01', 'b01', 'c00', 'c01', 'c02', 't01', 'z01', 'z02']);
+  });
+
+  it('finds swaps involving z04 (final carry)', () => {
+    const gates = correct4BitAdder();
+    // z04 is the output of the last carry gate (a03 OR b03)
+    // Swap z04 with z03
+    swapOut(gates, 'z04', 'z03');
+    swapOut(gates, 'z01', 'a01');
+    swapOut(gates, 'z02', 'b02');
+    swapOut(gates, 't01', 'c00');
+
+    const result = findSwappedWires(gates);
+    expect(result).toEqual(['a01', 'b02', 'c00', 't01', 'z01', 'z02', 'z03', 'z04']);
+  });
+
+  it('finds swaps with random wire names', () => {
+    const gates = correct4BitAdder();
+    swapOut(gates, 'z01', 'a01');
+    swapOut(gates, 'c00', 'z00');
+    swapOut(gates, 't02', 'b02');
+    swapOut(gates, 'z04', 'z03');
+
+    const result = findSwappedWires(gates);
+    expect(result).toEqual(['a01', 'b02', 'c00', 't02', 'z00', 'z01', 'z03', 'z04']);
+  });
+});
+
+// ─── helpers ─────────────────────────────────────────────────────────────────
+
+function correct4BitAdder(): Gate[] {
+  return [
+    // Bit 0: half adder
+    { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+    { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+
+    // Bit 1
+    { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },
+    { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },
+    { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },
+    { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },
+    { op: 'OR',  in1: 'a01', in2: 'b01', out: 'c01' },
+
+    // Bit 2
+    { op: 'XOR', in1: 'x02', in2: 'y02', out: 't02' },
+    { op: 'XOR', in1: 't02', in2: 'c01', out: 'z02' },
+    { op: 'AND', in1: 'x02', in2: 'y02', out: 'a02' },
+    { op: 'AND', in1: 't02', in2: 'c01', out: 'b02' },
+    { op: 'OR',  in1: 'a02', in2: 'b02', out: 'c02' },
+
+    // Bit 3 (last bit — carry gate produces z04, the MSB)
+    { op: 'XOR', in1: 'x03', in2: 'y03', out: 't03' },
+    { op: 'XOR', in1: 't03', in2: 'c02', out: 'z03' },
+    { op: 'AND', in1: 'x03', in2: 'y03', out: 'a03' },
+    { op: 'AND', in1: 't03', in2: 'c02', out: 'b03' },
+    { op: 'OR',  in1: 'a03', in2: 'b03', out: 'z04' },
+  ];
+}
+
+function swapOut(gates: Gate[], wire1: string, wire2: string): void {
+  const gate1 = gates.find(g => g.out === wire1);
+  const gate2 = gates.find(g => g.out === wire2);
+  if (!gate1 || !gate2) {
+    throw new Error(`Could not find gate with output ${wire1} or ${wire2}`);
+  }
+  const tmp = gate1.out;
+  gate1.out = gate2.out;
+  gate2.out = tmp;
+}
