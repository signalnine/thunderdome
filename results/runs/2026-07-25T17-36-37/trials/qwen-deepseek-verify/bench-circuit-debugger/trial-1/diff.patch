er[] = [];\n  while (queue.length > 0) {\n    const i = queue.shift()!;\n    order.push(i);\n    for (const dep of (dependents.get(i) ?? [])) {\n      inDegree[dep]--;\n      if (inDegree[dep] === 0) queue.push(dep);\n    }\n  }\n\n  // Evaluate gates in topological order\n  for (const i of order) {\n    const g = gates[i];\n    const v1 = wires[g.in1] ?? 0;\n    const v2 = wires[g.in2] ?? 0;\n    let result: number;\n    switch (g.op) {\n      case 'AND':\n        result = v1 & v2;\n        break;\n      case 'OR':\n        result = v1 | v2;\n        break;\n      case 'XOR':\n        result = v1 ^ v2;\n        break;\n    }\n    wires[g.out] = result;\n  }\n\n  return wires;\n}\n\n// ─── findSwappedWires ────────────────────────────────────────────────────────\n\n/**\n * Find the 8 wires involved in 4 swap pairs in a swapped adder circuit.\n *\n * Strategy: identify each gate's structural role in the adder, then compare\n * the actual output wire name with the expected wire name. Mismatches reveal\n * the swapped wires.\n *\n * In a correct N-bit adder:\n *   Bit 0 (half adder):\n *     x00 XOR y00 -> z00          (sum bit 0)\n *     x00 AND y00 -> c00          (carry out 0)\n *   Bit i (i > 0):\n *     xi XOR yi -> ti              (partial sum)\n *     ti XOR c(i-1) -> zi          (final sum)\n *     xi AND yi -> ai              (generate)\n *     ti AND c(i-1) -> bi          (propagate)\n *     ai OR bi -> ci               (carry out)\n *   Final carry:\n *     cN -> z(N+1)                (MSB of output)\n *\n * We identify gates by their structural role, then check if the output wire\n * name matches what it should be. The swapped wires are those where the\n * actual name differs from the expected name.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  // Step 1: Determine the number of input bits (N)\n  // Find the highest x/y bit index\n  let maxBit = 0;\n  for (const g of gates) {\n    for (const wire of [g.in1, g.in2]) {\n      const m = 