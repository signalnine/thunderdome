+{"type":"assistant","message":{"content":[{"id":"toolu_q27_546_0","input":{"file_path":"/workspace/src/index.test.ts","content":"import { describe, it, expect } from 'vitest';\nimport { simulate, findSwappedWires, Gate } from '../src/index';\n\ndescribe('simulate', () => {\n  it('simulates a simple AND gate', () => {\n    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];\n    expect(simulate(gates, { a: 1, b: 1 })).toHaveProperty('c', 1);\n    expect(simulate(gates, { a: 1, b: 0 })).toHaveProperty('c', 0);\n    expect(simulate(gates, { a: 0, b: 0 })).toHaveProperty('c', 0);\n  });\n\n  it('simulates a simple OR gate', () => {\n    const gates: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'c' }];\n    expect(simulate(gates, { a: 1, b: 1 })).toHaveProperty('c', 1);\n    expect(simulate(gates, { a: 1, b: 0 })).toHaveProperty('c', 1);\n    expect(simulate(gates, { a: 0, b: 0 })).toHaveProperty('c', 0);\n  });\n\n  it('simulates a simple XOR gate', () => {\n    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'c' }];\n    expect(simulate(gates, { a: 1, b: 1 })).toHaveProperty('c', 0);\n    expect(simulate(gates, { a: 1, b: 0 })).toHaveProperty('c', 1);\n    expect(simulate(gates, { a: 0, b: 1 })).toHaveProperty('c', 1);\n    expect(simulate(gates, { a: 0, b: 0 })).toHaveProperty('c', 0);\n  });\n\n  it('simulates chained gates', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'a', in2: 'b', out: 'c' },\n      { op: 'OR', in1: 'c', in2: 'd', out: 'e' },\n    ];\n    expect(simulate(gates, { a: 1, b: 1, d: 0 })).toHaveProperty('e', 1);\n    expect(simulate(gates, { a: 0, b: 1, d: 0 })).toHaveProperty('e', 0);\n  });\n\n  it('simulates a 4-bit adder correctly: 5 + 3 = 8', () => {\n    const gates = correct4BitAdder();\n    const inputs: Record<string, number> = {\n      x00: 1, x01: 0, x02: 1, x03: 0,\n      y00: 1, y01: 1, y02: 0, y03: 0,\n    };\n    const result = simulate(gates, inputs);\n    // 8 = 1000 in binary\n    expect(result.z00).toBe(0);\n    expect(result.z01).toBe(0);\n    expect(result.z02).toBe(0);\n    expect(result.z03).toBe(1);\n    expect(result.z04).toBe(0);\n  });\n\n  it('simulates 4-bit adder: 7 + 1 = 8', () => {\n    const gates = correct4BitAdder();\n    const inputs: Record<string, number> = {\n      x00: 1, x01: 1, x02: 1, x03: 0,\n      y00: 1, y01: 0, y02: 0, y03: 0,\n    };\n    const result = simulate(gates, inputs);\n    expect(result.z00).toBe(0);\n    expect(result.z01).toBe(0);\n    expect(result.z02).toBe(0);\n    expect(result.z03).toBe(1);\n    expect(result.z04).toBe(0);\n  });\n\n  it('simulates 4-bit adder: 15 + 1 = 16', () => {\n    const gates = correct4BitAdder();\n    const inputs: Record<string, number> = {\n      x00: 1, x01: 1, x02: 1, x03: 1,\n      y00: 1, y01: 0, y02: 0, y03: 0,\n    };\n    const result = simulate(gates, inputs);\n    expect(result.z00).toBe(0);\n    expect(result.z01).toBe(0);\n    expect(result.z02).toBe(0);\n    expect(result.z03).toBe(0);\n    expect(result.z04).toBe(1);\n  });\n\n  it('simulates 4-bit adder: 0 + 0 = 0', () => {\n    const gates = correct4BitAdder();\n    const inputs: Record<string, number> = {\n      x00: 0, x01: 0, x02: 0, x03: 0,\n      y00: 0, y01: 0, y02: 0, y03: 0,\n    };\n    const result = simulate(gates, inputs);\n    expect(result.z00).toBe(0);\n    expect(result.z01).toBe(0);\n    expect(result.z02).toBe(0);\n    expect(result.z03).toBe(0);\n    expect(result.z04).toBe(0);\n  });\n\n  it('simulates 4-bit adder: 1 + 1 = 2', () => {\n    const gates = correct4BitAdder();\n    const inputs: Record<string, number> = {\n      x00: 1, x01: 0, x02: 0, x03: 0,\n      y00: 1, y01: 0, y02: 0, y03: 0,\n    };\n    const result = simulate(gates, inputs);\n    expect(result.z00).toBe(0);\n    expect(result.z01).toBe(1);\n    expect(result.z02).toBe(0);\n    expect(result.z03).toBe(0);\n    expect(result.z04).toBe(0);\n  });\n});\n\ndescribe('findSwappedWires', () => {\n  it('finds no swaps in a co