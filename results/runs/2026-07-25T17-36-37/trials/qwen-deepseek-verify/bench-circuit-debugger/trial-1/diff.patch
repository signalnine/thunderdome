if (gateByOut.has(g.in2)) inDegree[i]++;\n  }\n\n  // Reverse adjacency: when a gate fires, which gates' in-degree decreases\n  const dependents = new Map<number, number[]>();\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    for (const wire of [g.in1, g.in2]) {\n      const producer = gateByOut.get(wire);\n      if (producer !== undefined) {\n        if (!dependents.has(producer)) dependents.set(producer, []);\n        dependents.get(producer)!.push(i);\n      }\n    }\n  }\n\n  // Topological sort (Kahn's algorithm)\n  const queue: number[] = [];\n  for (let i = 0; i < gates.length; i++) {\n    if (inDegree[i] === 0) queue.push(i);\n  }\n\n  const order: number[] = [];\n  while (queue.length > 0) {\n    const i = queue.shift()!;\n    order.push(i);\n    for (const dep of (dependents.get(i) ?? [])) {\n      inDegree[dep]--;\n      if (inDegree[dep] === 0) queue.push(dep);\n    }\n  }\n\n  // Evaluate gates in topological order\n  for (const i of order) {\n    const g = gates[i];\n    const v1 = wires[g.in1] ?? 0;\n    const v2 = wires[g.in2] ?? 0;\n    let result: number;\n    switch (g.op) {\n      case 'AND':\n        result = v1 & v2;\n        break;\n      case 'OR':\n        result = v1 | v2;\n        break;\n      case 'XOR':\n        result = v1 ^ v2;\n        break;\n    }\n    wires[g.out] = result;\n  }\n\n  return wires;\n}\n\n// ─── findSwappedWires ────────────────────────────────────────────────────────\n\n/**\n * Find the 8 wires involved in 4 swap pairs in a swapped adder circuit.\n *\n * Strategy: trace through the adder circuit structure, identifying each gate's\n * structural role. Compare the actual output wire name with the expected name.\n * Mismatches reveal the swapped wires.\n *\n * In a correct N-bit adder:\n *   Bit 0 (half adder):\n *     x00 XOR y00 -> z00          (sum bit 0)\n *     x00 AND y00 -> c00          (carry out 0)\n *   Bit i (i > 0, i < N-1):\n *     xi XOR yi -> ti              (partial sum)\n *    