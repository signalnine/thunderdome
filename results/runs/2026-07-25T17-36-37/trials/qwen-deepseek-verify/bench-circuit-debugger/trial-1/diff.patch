+// Circuit simulator and wire-swap debugger for logic gate circuits.
+
+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+// ─── simulate ────────────────────────────────────────────────────────────────
+
+/**
+ * Simulate a circuit by processing gates in dependency order.
+ * All circuits are acyclic, so a topological sort works.
+ */
+export function simulate(
+  gates: Gate[],
+  inputs: Record<string, number>,
+): Record<string, number> {
+  const wires: Record<string, number> = { ...inputs };
+
+  // Map: output wire -> gate index
+  const gateByOut = new Map<string, number>();
+  for (let i = 0; i < gates.length; i++) {
+    gateByOut.set(gates[i].out, i);
+  }
+
+  // Compute in-degree: how many producer gates must fire before this gate
+  const inDegree = new Array(gates.length).fill(0);
+  for (let i = 0; i < gates.length; i++) {
+    const g = gates[i];
+    if (gateByOut.has(g.in1)) inDegree[i]++;
+    if (gateByOut.has(g.in2)) inDegree[i]++;
+  }
+
+  // Reverse adjacency: when a gate fires, which gates' in-degree decreases
+  const dependents = new Map<number, number[]>();
+  for (let i = 0; i < gates.length; i++) {
+    const g = gates[i];
+    for (const wire of [g.in1, g.in2]) {
+      const producer = gateByOut.get(wire);
+      if (producer !== undefined) {
+        if (!dependents.has(producer)) dependents.set(producer, []);
+        dependents.get(producer)!.push(i);
+      }
+    }
+  }
+
+  // Topological sort (Kahn's algorithm)
+  const queue: number[] = [];
+  for (let i = 0; i < gates.length; i++) {
+    if (inDegree[i] === 0) queue.push(i);
+  }
+
+  const order: number[] = [];
+  while (queue.length > 0) {
+    const i = queue.shift()!;
+    order.push(i);
+    for (const dep of (dependents.get(i) ?? [])) {
+      inDegree[dep]--;
+      if (inDegree[dep] === 0) queue.push(dep);
+    }
+  }
+
+  // Evaluate gates in topological order
+  for (const i of order) {
+    const g = gates[i];
+    const v1 = wires[g.in1] ?? 0;
+    const v2 = wires[g.in2] ?? 0;
+    let result: number;
+    switch (g.op) {
+      case 'AND':
+        result = v1 & v2;
+        break;
+      case 'OR':
+        result = v1 | v2;
+        break;
+      case 'XOR':
+        result = v1 ^ v2;
+        break;
+    }
+    wires[g.out] = result;
+  }
+
+  return wires;
+}
+
+// ─── findSwappedWires ────────────────────────────────────────────────────────
+
+/**
+ * Find the 8 wires involved in 4 swap pairs in a swapped adder circuit.
+ *
+ * Simulation-based approach:
+ * 1. Build a correct N-bit adder circuit in memory (same N as the swapped one)
+ * 2. For each test input, simulate both circuits
+ * 3. For each gate, check if its output wire has the correct value
+ * 4. Gates with wrong values are the swapped ones
+ *
+ * The trick: in the swapped circuit, gate inputs (wire names) don't change,
+ * but output wire names have been exchanged. So a gate that should produce
+ * wire "a01" now produces wire "z01". When we simulate, the value that
+ * should be on "a01" ends up on "z01" instead.
+ *
+ * We identify swapped wires by comparing: for each gate in the swapped
+ * circuit, what value does it produce on its output wire? Then we check
+ * if that value matches what the correct circuit produces on the same
+ * wire name. If not, that wire is involved in a swap.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  // Step 1: Determine N (number of input bits)
+  let maxBit = 0;
+  for (const g of gates) {
+    for (const wire of [g.in1, g.in2]) {
+      const m = wire.match(/^x(\d+)$/);
+      if (m) maxBit = Math.max(maxBit, parseInt(m[1], 10));
+      const m2 = wire.match(/^y(\d+)$/);
+      if (m2) maxBit = Math.max(maxBit, parseInt(m2[1], 10));
+    }
+  }
+  const N = maxBit + 1;
+
+  // Step 2: Build a correct N-bit adder circuit
+  const correctGates = buildCorrectAdder(N);
+
+  // Step 3: For each gate in the swapped circuit, determine its structural
+  // role by matching it to the correct circuit. Gates are matched by their
+  // operation and input wire names.
+  //
+  // In the swapped circuit, gate inputs (wire names) are unchanged - only
+  // output wire names have been swapped. So we can match gates by (op, in1, in2).
+  //
+  // For each gate in the swapped circuit, find the corresponding gate in the
+  // correct circuit. The correct gate's output wire name tells us what the
+  // swapped gate's output wire SHOULD be.
+  //
+  // If the swapped gate's actual output differs from the expected output,
+  // both wires are involved in a swap.
+
+  // Build a map: (op, in1, in2) -> gate index in the correct circuit
+  const correctGateKey = new Map<string, number>();
+  for (let i = 0; i < correctGates.length; i++) {
+    const g = correctGates[i];
+    const key = gateKey(g);
+    correctGateKey.set(key, i);
+  }
+
+  // For each gate in the swapped circuit, find its expected output
+  const expectedOut = new Map<number, string>();
+  for (let i = 0; i < gates.length; i++) {
+    const g = gates[i];
+    const key = gateKey(g);
+    const correctIdx = correctGateKey.get(key);
+    if (correctIdx !== undefined) {
+      expectedOut.set(i, correctGates[correctIdx].out);
+    }
+  }
+
+  // Step 4: Find wires where actual name differs from expected name
+  const swappedWires = new Set<string>();
+
+  for (const [gateIdx, expected] of expectedOut) {
+    const actual = gates[gateIdx].out;
+    if (actual !== expected) {
+      swappedWires.add(actual);
+      swappedWires.add(expected);
+    }
+  }
+
+  return [...swappedWires].sort();
+}
+
+// ─── helpers ─────────────────────────────────────────────────────────────────
+
+/** Canonical key for a gate: operation + sorted inputs */
+function gateKey(g: Gate): string {
+  const inputs = [g.in1, g.in2].sort();
+  return `${g.op}:${inputs[0]}:${inputs[1]}`;
+}
+
+/**
+ * Build a correct N-bit adder circuit.
+ *
+ * Bit 0 (half adder):
+ *   x00 XOR y00 -> z00          (sum bit 0)
+ *   x00 AND y00 -> c00          (carry out 0)
+ *
+ * Bit i (i > 0):
+ *   xi XOR yi -> ti              (partial sum)
+ *   ti XOR c(i-1) -> zi          (final sum)
+ *   xi AND yi -> ai              (generate)
+ *   ti AND c(i-1) -> bi          (propagate)
+ *   ai OR bi -> ci               (carry out)
+ *
+ * Last bit: carry gate produces zN (the MSB)
+ */
+function buildCorrectAdder(N: number): Gate[] {
+  const gates: Gate[] = [];
+
+  // Bit 0: half adder
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+
+  // Bits 1..N-1
+  for (let i = 1; i < N; i++) {
+    const xi = `x${String(i).padStart(2, '0')}`;
+    const yi = `y${String(i).padStart(2, '0')}`;
+    const ti = `t${String(i).padStart(2, '0')}`;
+    const ai = `a${String(i).padStart(2, '0')}`;
+    const bi = `b${String(i).padStart(2, '0')}`;
+    const zi = `z${String(i).padStart(2, '0')}`;
+    const ci = `c${String(i).padStart(2, '0')}`;
+    const cPrev = `c${String(i - 1).padStart(2, '0')}`;
+
+    gates.push({ op: 'XOR', in1: xi, in2: yi, out: ti });
+    gates.push({ op: 'XOR', in1: ti, in2: cPrev, out: zi });
+    gates.push({ op: 'AND', in1: xi, in2: yi, out: ai });
+    gates.push({ op: 'AND', in1: ti, in2: cPrev, out: bi });
+
+    if (i === N - 1) {
+      // Last bit: carry gate produces zN
+      gates.push({ op: 'OR', in1: ai, in2: bi, out: `z${String(N).padStart(2, '0')}` });
+    } else {
+      gates.push({ op: 'OR', in1: ai, in2: bi, out: ci });
+    }
+  }
+
+  return gates;
+}
+
