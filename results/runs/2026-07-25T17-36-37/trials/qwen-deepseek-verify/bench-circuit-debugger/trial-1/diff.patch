t zNProducer = gateByOut.get(zN);"," ","+  // Check if zN is produced by a gate","+  const zNProducer = gateByOut.get(zN);","   if (zNProducer !== undefined) {","-    // zN is produced by a gate — check if it's the carry gate","-    // In this case, the gate that produces zN should be the carry gate","-    // for the last bit, and its expected output is zN.","-    // But we already set the carry gate's expected output to c(N-1).","-    // So if zN is produced by a different gate, that's a problem.","-","-    // Actually, if zN is produced by a gate, it might be that the circuit","-    // has an explicit gate for the final carry. Let me handle this case.","-    // The gate that produces zN should have the final carry as its input.","-    // But this is getting complicated.","-","-    // Let me just check: is the gate that produces zN the same as the carry","-    // gate for the last bit? If so, the expected output is zN, not c(N-1).","-    // If not, then zN is produced by a different gate, and we need to figure","-    // out what its expected output is.","-","-    // Actually, I think the simplest approach is: if zN is produced by a gate,","-    // then that gate's expected output is zN. We already have the carry gate","-    // for the last bit, which produces c(N-1). If zN is produced by a","-    // different gate, then that gate's expected output is zN.","-","-    // But this doesn't make sense — the carry gate for the last bit produces","-    // c(N-1), and zN is the final carry. They should be the same wire.","-","-    // I think the issue is: in the correct circuit, the carry gate for the","-    // last bit produces zN (not c(N-1)). So the expected output of the carry","-    // gate for the last bit is zN, not c(N-1).","-","-    // Let me reconsider: for bit N-1 (the last bit), the carry gate produces","-    // c(N-1), which IS zN. So the expected output of the carry gate for the","-    // last bit is zN.","-","-    // But I set it to c(N-1) in the loop. Let me fix this.","-","-    // Actually, I think the issue is simpler: for the last bit, the carry","-    // wire is zN. So the expected output of the carry gate for the last bit","-    // is zN, not c(N-1).","-","-    // Let me update the expected output for the last carry gate.","-    // The carry gate for bit N-1 should produce zN.","-    const lastCarryGate = expectedOut","-      .entries()","-      .find(([, v]) => v === `c${String(N - 1).padStart(2, '0')}`);","-    if (lastCarryGate) {","-      expectedOut.set(lastCarryGate[0], zN);","-    }","+    // zN is produced by a gate — this gate should produce the final carry","+    // Its expected output is zN","+    expectedOut.set(zNProducer, zN);","   }"," ","   // Step 4: Find wires where actual name differs from expected name"]},{"oldStart":439,"oldLines":6,"newStart":235,"newLines":23,"lines":[" "," // ─── helpers ─────────────────────────────────────────────────────────────────"," ","-function* range(n: number): IterableIterator<number> {","-  for (let i = 0; i < n; i++) yield i;","+/** Check if (a,b) is a permutation of (x,y) */","+function isPair(a: string, b: string, x: string, y: string): boolean {","+  return (a === x && b === y) || (a === y && b === x);"," }","+","+/** Find a gate with the given operation and input pair */","+function findGate(","+  gates: Gate[],","+  op: Gate['op'],","+  w1: string,","+  w2: string,","+): number | undefined {","+  for (let i = 0; i < gates.length; i++) {","+    const g = gates[i];","+    if (g.op === op && isPair(g.in1, g.in2, w1, w2)) {","+      return i;","+    }","+  }","+  return undefined;","+}"]}],"originalFile":"// Circuit simulator and wire-swap debugger for logic gate circuits.\n\nexport interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string;\n  in2: string;\n  out: string;\n}\n\n// ─── simulate ────────────────────────────────────────────────────────────────\n\n/**\n * Simulate a circuit by processing gates in dependency order.\n * All circuits are acyclic, so a topological sort works.\n */\nexport function simulate(\n  gates: Gate[],\n  inputs: Record<string, number>,\n): Record<string, number> {\n  // Start with input wire values\n  const wires: Record<string, number> = { ...inputs };\n\n  // Build adjacency: which gates produce which wires, and which gates consume which wires\n  const gateByOut = new Map<string, number>(); // wire -> gate index\n  for (let i = 0; i < gates.length; i++) {\n    gateByOut.set(gates[i].out, i);\n  }\n\n  // Compute in-degree (number of gates that must fire before this gate)\n  const inDegree = new Array(gates.length).fill(0);\n  // For each gate, count how many of its input wires are produced by other gates\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    if (gateByOut.has(g.in1)) inDegree[i]++;\n    if (gateByOut.has(g.in2)) inDegree[i]++;\n  }\n\n  // Reverse adjacency: when a gate fires, which gates' in-degree decreases\n  const dependents: Map<number, number[]> = new Map();\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    for (const wire of [g.in1, g.in2]) {\n      const producer = gateByOut.get(wire);\n      if (producer !== undefined) {\n        if (!dependents.has(producer)) dependents.set(producer, []);\n        dependents.get(producer)!.push(i);\n      }\n    }\n  }\n\n  // Topological sort (Kahn's algorithm)\n  const queue: number[] = [];\n  for (let i = 0; i < gates.length; i++) {\n    if (inDegree[i] === 0) queue.push(i);\n  }\n\n  const order: number[] = [];\n  while (queue.length > 0) {\n    const i = queue.shift()!;\n    order.push(i);\n    for (const dep of (dependents.get(i) ?? [])) {\n      inDegree[dep]--;\n      if (inDegree[dep] === 0) queue.push(dep);\n    }\n  }\n\n  // Evaluate gates in topological order\n  for (const i of order) {\n    const g = gates[i];\n    const v1 = wires[g.in1] ?? 0;\n    const v2 = wires[g.in2] ?? 0;\n    let result: number;\n    switch (g.op) {\n      case 'AND':\n        result = v1 & v2;\n        break;\n      case 'OR':\n        result = v1 | v2;\n        break;\n      case 'XOR':\n        result = v1 ^ v2;\n        break;\n    }\n    wires[g.out] = result;\n  }\n\n  return wires;\n}\n\n// ─── findSwappedWires ────────────────────────────────────────────────────────\n\n/**\n * Find the 8 wires involved in 4 swap pairs in a swapped adder circuit.\n *\n * Strategy: identify each gate's structural role in the adder, then compare\n * the actual output wire name with the expected wire name. Mismatches reveal\n * the swapped wires.\n *\n * In a correct N-bit adder:\n *   Bit 0 (half adder):\n *     x00 XOR y00 -> z00          (sum bit 0)\n *     x00 AND y00 -> c00          (carry out 0)\n *   Bit i (i > 0):\n *     xi XOR yi -> ti              (partial sum)\n *     ti XOR c(i-1) -> zi          (final sum)\n *     xi AND yi -> ai              (generate)\n *     ti AND c(i-1) -> bi          (propagate)\n *     ai OR bi -> ci               (carry out)\n *   Final carry:\n *     cN -> z(N+1)                (MSB of output)\n *\n * We identify gates by their structural role, then check if the output wire\n * name matches what it should be. The swapped wires are those where the\n * actual name differs from the expected name.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  // Step 1: Determine the number of input bits (N)\n  // Find the highest x/y bit index\n  let maxBit = 0;\n  for (const g of gates) {\n    for (const wire of [g.in1, g.in2]) {\n      const m = wire.match(/^x(\\d+)$/);\n      if (m) maxBit = Math.max(maxBit, parseInt(m[1], 10));\n      const m2 = wire.match(/^y(\\d+)$/);\n      if (m2) maxBit = Math.max(maxBit, parseInt(m2[1], 10));\n    }\n  }\n  const N = maxBit + 1; // number of input bits\n\n  // Step 2: Build a map of gate index by output wire\n  const gateByOut = new Map<string, number>();\n  for (let i = 0; i < gates.length; i++) {\n    gateByOut.set(gates[i].out, i);\n  }\n\n  // Step 3: Identify each gate's structural role and expected output wire\n  // We'll track: for each gate, what wire name it SHOULD have\n  const expectedOut = new Map<number, string>();\n\n  // Bit 0: half adder\n  // x00 XOR y00 -> z00\n  // x00 AND y00 -> c00\n  for (const i of range(gates.length)) {\n    const g = gates[i];\n    if (g.op === 'XOR' && g.in1 === 'x00' && g.in2 === 'y00') {\n      expectedOut.set(i, 'z00');\n    } else if (g.op === 'XOR' && g.in1 === 'y00' && g.in2 === 'x00') {\n      expectedOut.set(i, 'z00');\n    } else if (g.op === 'AND' && g.in1 === 'x00' && g.in2 === 'y00') {\n      expectedOut.set(i, 'c00');\n    } else if (g.op === 'AND' && g.in1 === 'y00' && g.in2 === 'x00') {\n      expectedOut.set(i, 'c00');\n    }\n  }\n\n  // For bits i > 0, we need to identify the carry chain.\n  // The carry chain is: c00 -> c01 -> c02 -> ... -> c(N-1)\n  // c00 is the output of x00 AND y00.\n  // ci is the output of ai OR bi, where:\n  //   ai = xi AND yi (generate)\n  //   bi = ti AND c(i-1) (propagate)\n  //   ti = xi XOR yi (partial sum)\n  //   zi = ti XOR c(i-1) (final sum)\n\n  // Strategy: trace the carry chain from c00.\n  // c00 is produced by x00 AND y00.\n  // For each bit i (1..N-1):\n  //   - Find the XOR gate with inputs xi, yi -> this is the partial sum gate (ti)\n  //   - Find the AND gate with inputs xi, yi -> this is the generate gate (ai)\n  //   - Find the AND gate with inputs ti, c(i-1) -> this is the propagate gate (bi)\n  //   - Find the OR gate with inputs ai, bi -> this is the carry gate (ci)\n  //   - Find the XOR gate with inputs ti, c(i-1) -> this is the sum gate (zi)\n\n  // We need to know which wire is c00 to start the chain.\n  // c00 is the output of x00 AND y00.\n  let carryWire = 'c00'; // the expected name; actual wire may differ\n\n  // But we need the ACTUAL wire name for c00 to trace the chain.\n  // Find the AND gate with x00, y00 inputs\n  let actualCarryWire: string | undefined;\n  for (const i of range(gates.length)) {\n    const g = gates[i];\