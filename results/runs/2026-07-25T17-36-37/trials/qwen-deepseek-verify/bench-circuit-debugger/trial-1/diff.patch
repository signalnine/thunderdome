+{"type":"assistant","message":{"content":[{"id":"toolu_q27_587_0","input":{"content":"// Circuit simulator and wire-swap debugger for logic gate circuits.\n\nexport interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string;\n  in2: string;\n  out: string;\n}\n\n// ─── simulate ────────────────────────────────────────────────────────────────\n\nexport function simulate(\n  gates: Gate[],\n  inputs: Record<string, number>,\n): Record<string, number> {\n  const wires: Record<string, number> = { ...inputs };\n\n  const gateByOut = new Map<string, number>();\n  for (let i = 0; i < gates.length; i++) {\n    gateByOut.set(gates[i].out, i);\n  }\n\n  const inDegree = new Array(gates.length).fill(0);\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    if (gateByOut.has(g.in1)) inDegree[i]++;\n    if (gateByOut.has(g.in2)) inDegree[i]++;\n  }\n\n  const dependents = new Map<number, number[]>();\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    for (const wire of [g.in1, g.in2]) {\n      const producer = gateByOut.get(wire);\n      if (producer !== undefined) {\n        if (!dependents.has(producer)) dependents.set(producer, []);\n        dependents.get(producer)!.push(i);\n      }\n    }\n  }\n\n  const queue: number[] = [];\n  for (let i = 0; i < gates.length; i++) {\n    if (inDegree[i] === 0) queue.push(i);\n  }\n\n  const order: number[] = [];\n  while (queue.length > 0) {\n    const i = queue.shift()!;\n    order.push(i);\n    for (const dep of (dependents.get(i) ?? [])) {\n      inDegree[dep]--;\n      if (inDegree[dep] === 0) queue.push(dep);\n    }\n  }\n\n  for (const i of order) {\n    const g = gates[i];\n    const v1 = wires[g.in1] ?? 0;\n    const v2 = wires[g.in2] ?? 0;\n    let result: number;\n    switch (g.op) {\n      case 'AND': result = v1 & v2; break;\n      case 'OR':  result = v1 | v2;  break;\n      case 'XOR': result = v1 ^ v2;  break;\n    }\n    wires[g.out] = result;\n  }\n\n  return wires;\n}\n\n// ─── findSwappedWires ────────────────────────────────────────────────────────\n\n/**\n * Find the 8 wires involved in 4 swap pairs in a swapped adder circuit.\n *\n * Approach: For each gate, determine its structural role by tracing through\n * the circuit graph. Gates that take x/y input wires can be identified directly.\n * From there, we trace through the circuit using the actual output wire names\n * to find dependent gates.\n *\n * For each bit i:\n *   - Partial sum gate: XOR(xi, yi) — identified by inputs\n *   - Generate gate: AND(xi, yi) — identified by inputs\n *   - Sum gate: XOR gate that takes partial_sum_wire AND carry_wire as inputs\n *   - Propagate gate: AND gate that takes partial_sum_wire AND carry_wire as inputs\n *   - Carry gate: OR gate that takes generate_wire AND propagate_wire as inputs\n *\n * The challenge: when wires are swapped, the carry gate's inputs are the\n * wire NAMES (not the structural roles). So OR(a01, b01) still has inputs\n * (a01, b01), but a01 might be produced by the sum gate instead of the\n * generate gate.\n *\n * Solution: identify the carry gate as the OR gate whose inputs are BOTH\n * produced by gates in the current bit's group. We identify the bit group\n * by starting from xi and yi and following the graph.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  // Determine the number of input bits (N)\n  let maxBit = 0;\n  for (const g of gates) {\n    for (const wire of [g.in1, g.in2]) {\n      const m = wire.match(/^x(\\d+)$/);\n      if (m) maxBit = Math.max(maxBit, parseInt(m[1], 10));\n      const m2 = wire.match(/^y(\\d+)$/);\n      if (m2) maxBit = Math.max(maxBit, parseInt(m2[1], 10));\n    }\n  }\n  const N = maxBit + 1;\n\n  // Build a map of gate index by output wire\n  const gateByOut = new Map<string, number>();\n  for (let i = 0; i < gates.length; i++) {\n    gateByOut.set(gates[i].out, i);\n  }\n\n  // Build a map: for each wire, which gates use it as an input\n  const consumers = new Map<string, number[]>();\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    for (const wire of [g.in1, g.in2]) {\n      if (!consumers.has(wire)) consumers.set(wire, []);\n      consumers.get(wire)!.push(i);\n    }\n  }\n\n  // Identify each gate's structural role and expected output wire\n  const expectedOut = new Map<number, string>();\n\n  // Bit 0: half adder\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    if (g.op === 'XOR' && isPair(g.in1, g.in2, 'x00', 'y00')) {\n      expectedOut.set(i, 'z00');\n    } else if (g.op === 'AND' && isPair(g.in1, g.in2, 'x00', 'y00')) {\n      expectedOut.set(i, 'c00');\n    }\n  }\n\n  // Find the actual output wire of the carry gate for bit 0\n  let carryWire: string | undefined;\n  for (let i = 0; i < gates.length; i++) {\n    const g = gates[i];\n    if (g.op === 'AND' && isPair(g.in1, g.in2, 'x00', 'y00')) {\n      carryWire = g.out;\n      break;\n    }\n  }\n  if (carryWire === undefined) {\n    throw new Error('Could not find c00 gate');\n  }\n\n  // For each bit i (1..N-1), identify gates by tracing through the graph\n  for (let i = 1; i < N; i++) {\n    const xi = `x${String(i).padStart(2, '0')}`;\n    const yi = `y${String(i).padStart(2, '0')}`;\n    const tiName = `t${String(i).padStart(2, '0')}`;\n    const aiName = `a${String(i).padStart(2, '0')}`;\n    const biName = `b${String(i).padStart(2, '0')}`;\n    const ziName = `z${String(i).padStart(2, '0')}`;\n\n    // Partial sum gate: XOR(xi, yi) — identified by inputs\n    const partialSumGate = findGate(gates, 'XOR', xi, yi);\n    if (partialSumGate === undefined) {\n      throw new Error(`Could not find partial sum gate for bit ${i}`);\n    }\n    const ti = gates[partialSumGate].out;\n    expectedOut.set(partialSumGate, tiName);\n\n    // Generate gate: AND(xi, yi) — identified by inputs\n    const genGate = findGate(gates, 'AND', xi, yi);\n    if (genGate === undefined) {\n      throw new Error(`Could not find generate gate for bit ${i}`);\n    }\n    const ai = gates[genGate].out;\n    expectedOut.set(genGate, aiName);\n\n    // Sum gate: XOR gate that takes ti as one input\n    // (the other input is the previous carry wire)\n    const sumGate = findGateWithInput(gates, 'XOR', ti);\n    if (sumGate === undefined) {\n      throw new Error(`Could not find sum gate for bit ${i}`);\n    }\n    expectedOut.set(sumGate, ziName);\n\n    // Propagate gate: AND gate that takes ti as one input\n    // (the other input is the previous carry wire)\n    const propGate = findGateWithInput(gates, 'AND', ti);\n    if (propGate === undefined) {\n      throw new Error(`Could not find propagate gate for bit ${i}`);\n    }\n    const bi = gates[propGate].out;\n    expectedOut.set(propGate, biName);\n\n    // Carry gate: OR gate that takes ai as one input\n    // (the other input is the propagate output)\n    // But ai might have been swapped, so we need a different approach.\n    // The carry gate is the OR gate that takes BOTH ai and bi as inputs.\n    // But ai and bi might have been swapped.\n    //\n    // Alternative: the carry gate is the OR gate that takes the generate\n    // output as one of its inputs. But the generate output wire name might\n    // have been swapped.\n    //\n    // Alternative: the carry gate is the OR gate that takes the propagate\n    // output as one of its inputs. But the propagate output wire name might\n    // have been swapped.\n    //\n    // Alternative: the carry gate is the ONLY OR gate in the current bit's\n    // group. So we can identify it as the OR gate that is in the current\n    // bit's group.\n    //\n    // How to define \"current bit's group\"? The gates that are reachable\n    // from xi and yi through the circuit graph, but not from xj and yj\n    // for j != i.\n    //\n    // Actually, a simpler approach: the carry gate is the OR gate whose\n    // inputs are both produced by gates in the current bit's group.\n    // We can identify the