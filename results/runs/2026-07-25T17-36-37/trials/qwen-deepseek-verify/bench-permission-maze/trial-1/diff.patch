 userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function (store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {","-  return getEffectiveResourceRole(store, resourceId, resourceType, userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function (store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {","-  return getEffectiveResourceRole(store, resourceId, resourceType, userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function (store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {","-  return getEffectiveResourceRole(store, resourceId, resourceType, userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function (store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {","-  return getEffectiveResourceRole(store, resourceId, resourceType, userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function (store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {","-  return getEffectiveResourceRole(store, resourceId, resourceType, userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function (store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {","-  return getEffectiveResourceRole(store, resourceId, resourceType, userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function (store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {","-  return getEffectiveResourceRole(store, resourceId, resourceType, userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function (store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {","-  return getEffectiveResourceRole(store, resourceId, resourceType, userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function (store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {","-  return getEffectiveResourceRole(store, resourceId, resourceType, userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function (store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {","-  return getEffectiveResourceRole(store, resourceId, resourceType, userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function (store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {","-  return getEffectiveResourceRole(store, resourceId, resourceType, userId);","-}","-","-// Get the effective role of a user on a resource considering all paths (alias)","-export function ","\\ No newline at end of file"]}],"originalFile":"export type Role = 'viewer' | 'editor' | 'owner';\n\nexport const ROLE_RANK: Record<Role, number> = {\n  viewer: 0,\n  editor: 1,\n  owner: 2,\n};\n\nexport interface User {\n  id: string;\n  username: string;\n  password: string;\n}\n\nexport interface AuthToken {\n  token: string;\n  userId: string;\n}\n\nexport interface Folder {\n  id: string;\n  name: string;\n  parentId: string | null;\n  ownerId: string;\n  createdAt: string;\n}\n\nexport interface Document {\n  id: string;\n  title: string;\n  content: string;\n  folderId: string;\n  ownerId: string;\n  createdAt: string;\n}\n\nexport interface Share {\n  id: string;\n  resourceId: string;\n  resourceType: 'folder' | 'document';\n  userId: string;\n  role: Role;\n  grantedBy: string;\n}\n\nexport interface ActivityLog {\n  id: string;\n  action: string;\n  userId: string;\n  resourceId: string;\n  resourceType: 'folder' | 'document';\n  timestamp: string;\n}\n\nexport interface Store {\n  users: Map<string, User>;\n  tokens: Map<string, AuthToken>;\n  folders: Map<string, Folder>;\n  documents: Map<string, Document>;\n  shares: Map<string, Share>;\n  activityLogs: ActivityLog[];\n  nextId: number;\n}\n\nexport function createStore(): Store {\n  return {\n    users: new Map(),\n    tokens: new Map(),\n    folders: new Map(),\n    documents: new Map(),\n    shares: new Map(),\n    activityLogs: [],\n    nextId: 1,\n  };\n}\n\nexport function nextId(store: Store): string {\n  return String(store.nextId++);\n}\n\nexport function now(): string {\n  return new Date().toISOString();\n}\n\nexport function higherRole(a: Role, b: Role): Role {\n  return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;\n}\n\nexport function roleAllows(role: Role, action: 'read' | 'write' | 'delete' | 'share'): boolean {\n  switch (action) {\n    case 'read':\n      return role !== 'none';\n    case 'write':\n      return role === 'editor' || role === 'owner';\n    case 'delete':\n      return role === 'owner';\n    case 'share':\n      return role === 'editor' || role === 'owner';\n  }\n}\n\n// Effective role: owner > editor > viewer > none\nexport type EffectiveRole = Role | 'none';\n\nexport function effectiveRole(role: Role | 'none'): number {\n  if (role === 'none') return -1;\n  return ROLE_RANK[role];\n}\n\nexport function bestRole(roles: EffectiveRole[]): EffectiveRole {\n  let best: EffectiveRole = 'none';\n  for (const r of roles) {\n    if (effectiveRole(r) > effectiveRole(best)) {\n      best = r;\n    }\n  }\n  return best;\n}\n\nexport function roleFromRank(rank: number): EffectiveRole {\n  if (rank < 0) return 'none';\n  if (rank <= ROLE_RANK.viewer) return 'viewer';\n  if (rank <= ROLE_RANK.editor) return 'editor';\n  return 'owner';\n}\n\nexport function addLog(store: Store, action: string, userId: string, resourceId: string, resourceType: 'folder' | 'document'): void {\n  store.activityLogs.push({\n    id: nextId(store),\n    action,\n    userId,\n    resourceId,\n    resourceType,\n    timestamp: now(),\n  });\n}\n\n// Get all ancestor folder IDs for a given folder\nexport function getAncestorFolderIds(store: Store, folderId: string): string[] {\n  const ancestors: string[] = [];\n  let current = store.folders.get(folderId);\n  while (current && current.parentId) {\n    ancestors.push(current.parentId);\n    current = store.folders.get(current.parentId);\n  }\n  return ancestors;\n}\n\n// Get all descendant folder IDs for a given folder\nexport function getDescendantFolderIds(store: Store, folderId: string): string[] {\n  const descendants: string[] = [];\n  const queue = [folderId];\n  while (queue.length > 0) {\n    const current = queue.shift()!;\n    for (const folder of store.folders.values()) {\n      if (folder.parentId === current) {\n        descendants.push(folder.id);\n        queue.push(folder.id);\n      }\n    }\n  }\n  return descendants;\n}\n\n// Check if a user has effective access to a folder\n// Returns the effective role (owner > editor > viewer > none)\nexport function getFolderEffectiveRole(store: Store, folderId: string, userId: string): EffectiveRole {\n  const folder = store.folders.get(folderId);\n  if (!folder) return 'none';\n\n  // Owner always has full access\n  if (folder.ownerId === userId) return 'owner';\n\n  // Check direct shares on this folder\n  const roles: EffectiveRole[] = [];\n  for (const share of store.shares.values()) {\n    if (share.resourceType === 'folder' && share.resourceId === folderId && share.userId === userId) {\n      roles.push(share.role);\n    }\n  }\n\n  // Check shares on ancestor folders (inherited)\n  const ancestors = getAncestorFolderIds(store, folderId);\n  for (const ancestorId of ancestors) {\n    for (const share of store.shares.values()) {\n      if (share.resourceType === 'folder' && share.resourceId === ancestorId && share.userId === userId) {\n        roles.push(share.role);\n      }\n    }\n  }\n\n  return bestRole(roles);\n}\n\n// Check if a user has effective access to a document\nexport function getDocumentEffectiveRole(store: Store, documentId: string, userId: string): EffectiveRole {\n  const doc = store.documents.get(documentId);\n  if (!doc) return 'none';\n\n  // Owner always has full access\n  if (doc.ownerId === userId) return 'owner';\n\n  const roles: EffectiveRole[] = [];\n\n  // Check direct shares on this document\n  for (const share of store.shares.values()) {\n    if (share.resourceType === 'document' && share.resourceId === documentId && share.userId === userId) {\n      roles.push(share.role);\n    }\n  }\n\n  // Check folder access (document inherits folder permissions)\n  const folderRole = getFolderEffectiveRole(store, doc.folderId, userId);\n  if (folderRole !== 'none') {\n    roles.push(folderRole);\n  }\n\n  return bestRole(roles);\n}\n\n// Check if a user has effective access to a folder for deletion\n// Owner can delete; also check if user is owner of all children\nexport function canDeleteFolder(store: Store, folderId: string, userId: string): boolean {\n  const folder = store.folders.get(folderId);\n  if (!folder) return false;\n  if (folder.ownerId === userId) return true;\n\n  const role = getFolderEffectiveRole(store, folderId, userId);\n  return role === 'owner';\n}\n\n// Check if a user can delete a document\nexport function canDeleteDocument(store: Store, documentId: string, userId: string): boolean {\n  const doc = store.documents.get(documentId);\n  if (!doc) return false;\n  if (doc.ownerId === userId) return true;\n\n  const role = getDocumentEffectiveRole(store, documentId, userId);\n  return role === 'owner';\n}\n\n// Check if a user can manage shares on a folder\nexport function canManageSharesFolder(store: Store, folderId: string, userId: string): boolean {\n  const folder = store.folders.get(folderId);\n  if (!folder) return false;\n  if (folder.ownerId === userId) return true;\n\n  const role = getFolderEffectiveRole(store, folderId, userId);\n  return role === 'editor' || role === 'owner';\n}\n\n// Check if a user can manage shares on a document\nexport function canManageSharesDocument(store: Store, documentId: string, userId: string): boolean {\n  const doc = store.documents.get(documentId);\n  if (!doc) return false;\n  if (doc.ownerId === userId) return true;\n\n  const role = getDocumentEffectiveRole(store, documentId, userId);\n  return role === 'editor' || role === 'owner';\n}\n\n// Get all shares for a resource\nexport function getSharesForResource(store: Store, resourceId: string, resourceType: 'folder' | 'document'): Share[] {\n  const result: Share[] = [];\n  for (const share of store.shares.values()) {\n    if (share.resourceId === resourceId && share.resourceType === resourceType) {\n      result.push(share);\n    }\n  }\n  return result;\n}\n\n// Get all documents in a folder\nexport function getDocumentsInFolder(store: Store, folderId: string): Document[] {\n  const result: Document[] = [];\n  for (const doc of store.documents.values()) {\n    if (doc.folderId === folderId) {\n      result.push(doc);\n    }\n  }\n  return result;\n}\n\n// Get all subfolders of a folder\nexport function getSubfolders(store: Store, folderId: string): Folder[] {\n  const result: Folder[] = [];\n  for (const folder of store.folders.values()) {\n    if (folder.parentId === folderId) {\n      result.push(folder);\n    }\n  }\n  return result;\n}\n\n// Get all root folders (no parent)\nexport function getRootFolders(store: Store): Folder[] {\n  const result: Folder[] = [];\n  for (const folder of store.folders.values()) {\n    if (folder.parentId === null) {\n      result.push(folder);\n    }\n  }\n  return result;\n}\n\n// Get user by username\nexport function getUserByUsername(store: Store, username: string): User | undefined {\n  for (const user of store.users.values()) {\n    if (user.username === username) {\n      return user;\n    }\n  }\n  return undefined;\n}\n\n// Get user by ID\nexport function getUserById(store: Store, userId: string): User | undefined {\n  return store.users.get(userId);\n}\n\n// Get all documents in a folder and its descendants\nexport function getAllDocumentsInFolderTree(store: Store, folderId: string): Document[] {\n  const folderIds = new Set<string>([folderId]);\n  const descendants = getDescendantFolderIds(store, folderId);\n  for (const d of descendants) {\n    folderIds.add(d);\n  }\n  const result: Document[] = [];\n  for (const doc of store.documents.values()) {\n    if (folderIds.has(doc.folderId)) {\n      result.push(doc);\n    }\n  }\n  return result;\n}\n\n// Get all folders in a folder tree\nexport function getAllFoldersInTree(store: Store, folderId: string): Folder[] {\n  const folderIds = new Set<string>([folderId]);\n  const descendants = getDescendantFolderIds(store, folderId);\n  for (const d of descendants) {\n    folderIds.add(d);\n  }\n  const result: Folder[] = [];\n  for (const folder of store.folders.values()) {\n    if (folderIds.has(folder.id)) {\n      result.push(folder);\n    }\n  }\n  return result;\n}\n\n// Delete all shares for a resource\nexport function deleteSharesForResource(store: Store, resourceId: string, resourceType: 'folder' | 'document'): void {\n  const toDelete: string[] = [];\n  for (const [id, share] of store.shares.entries()) {\n    if (share.resourceId === resourceId && share.resourceType === resourceType) {\n      toDelete.push(id);\n    }\n  }\n  for (const id of toDelete) {\n    store.shares.delete(id);\n  }\n}\n\n// Delete all shares for folders in a tree\nexport function deleteSharesForFolderTree(store: Store, folderId: string): void {\n  const folderIds = new Set<string>([folderId]);\n  const descendants = getDescendantFolderIds(store, folderId);\n  for (const d of descendants) {\n    folderIds.add(d);\n  }\n  const toDelete: string[] = [];\n  for (const [id, share] of store.shares.entries()) {\n    if (share.resourceType === 'folder' && folderIds.has(share.resourceId)) {\n      toDelete.push(id);\n    }\n    // Also delete document shares for documents in these folders\n    if (share.resourceType === 'document') {\n      const doc = store.documents.get(share.resourceId);\n      if (doc && folderIds.has(doc.folderId)) {\n        toDelete.push(id);\n      }\n    }\n  }\n  for (const id of toDelete) {\n    store.shares.delete(id);\n  }\n}\n\n// Delete all documents in a folder tree\nexport function deleteDocumentsInFolderTree(store: Store, folderId: string): void {\n  const folderIds = new Set<string>([folderId]);\n  const descendants = getDescendantFolderIds(store, folderId);\n  for (const d of descendants) {\n    folderIds.add(d);\n  }\n  const toDelete: string[] = [];\n  for (const [id, doc] of store.documents.entries()) {\n    if (folderIds.has(doc.folderId)) {\n      toDelete.push(id);\n    }\n  }\n  for (const id of toDelete) {\n    store.documents.delete(id);\n  }\n}\n\n// Delete all folders in a tree\nexport function deleteFoldersInTree(store: Store, folderId: string): void {\n  const folderIds = new Set<string>([folderId]);\n  const descendants = getDescendantFolderIds(store, folderId);\n  for (const d of descendants) {\n    folderIds.add(d);\n  }\n  for (const id of folderIds) {\n    store.folders.delete(id);\n  }\n}\n\n// Delete a folder and everything inside it\nexport function deleteFolderCascade(store: Store, folderId: string): void {\n  deleteSharesForFolderTree(store, folderId);\n  deleteDocumentsInFolderTree(store, folderId);\n  deleteFoldersInTree(store, folderId);\n}\n\n// Delete a document and its shares\nexport function deleteDocumentCascade(store: Store, documentId: string): void {\n  deleteSharesForResource(store, documentId, 'document');\n  store.documents.delete(documentId);\n}\n\n// Find a user by username (for sharing)\nexport function findUserByUsername(store: Store, username: string): User | undefined {\n  for (const user of store.users.values()) {\n    if (user.username === username) {\n      return user;\n    }\n  }\n  return undefined;\n}\n\n// Check if a share already exists for a user on a resource\nexport function findShare(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): Share | undefined {\n  for (const share of store.shares.values()) {\n    if (share.resourceId === resourceId && share.resourceType === resourceType && share.userId === userId) {\n      return share;\n    }\n  }\n  return undefined;\n}\n\n// Generate a random token string\nexport function generateToken(): string {\n  const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n  let result = '';\n  for (let i = 0; i < 32; i++) {\n    result += chars[Math.floor(Math.random() * chars.length)];\n  }\n  return result;\n}\n\n// Check if a folder has children (subfolders or documents)\nexport function folderHasChildren(store: Store, folderId: string): boolean {\n  for (const folder of store.folders.values()) {\n    if (folder.parentId === folderId) return true;\n  }\n  for (const doc of store.documents.values()) {\n    if (doc.folderId === folderId) return true;\n  }\n  return false;\n}\n\n// Check if a folder is a descendant of another folder\nexport function isDescendantOf(store: Store, potentialDescendantId: string, potentialAncestorId: string): boolean {\n  let current = store.folders.get(potentialDescendantId);\n  while (current && current.parentId) {\n    if (current.parentId === potentialAncestorId) return true;\n    current = store.folders.get(current.parentId);\n  }\n  return false;\n}\n\n// Get all activity logs for a user\nexport function getActivityLogsForUser(store: Store, userId: string): ActivityLog[] {\n  return store.activityLogs.filter(log => log.userId === userId);\n}\n\n// Get all activity logs for a resource\nexport function getActivityLogsForResource(store: Store, resourceId: string): ActivityLog[] {\n  return store.activityLogs.filter(log => log.resourceId === resourceId);\n}\n\n// Get all activity logs\nexport function getAllActivityLogs(store: Store): ActivityLog[] {\n  return store.activityLogs;\n}\n\n// Get activity logs with optional filters\nexport function getActivityLogs(store: Store, userId?: string, resourceId?: string): ActivityLog[] {\n  let logs = store.activityLogs;\n  if (userId) {\n    logs = logs.filter(log => log.userId === userId);\n  }\n  if (resourceId) {\n    logs = logs.filter(log => log.resourceId === resourceId);\n  }\n  return logs;\n}\n\n// Get all shares for a user\nexport function getSharesForUser(store: Store, userId: string): Share[] {\n  const result: Share[] = [];\n  for (const share of store.shares.values()) {\n    if (share.userId === userId) {\n      result.push(share);\n    }\n  }\n  return result;\n}\n\n// Get all folders owned by a user\nexport function getFoldersByOwner(store: Store, ownerId: string): Folder[] {\n  const result: Folder[] = [];\n  for (const folder of store.folders.values()) {\n    if (folder.ownerId === ownerId) {\n      result.push(folder);\n    }\n  }\n  return result;\n}\n\n// Get all documents owned by a user\nexport function getDocumentsByOwner(store: Store, ownerId: string): Document[] {\n  const result: Document[] = [];\n  for (const doc of store.documents.values()) {\n    if (doc.ownerId === ownerId) {\n      result.push(doc);\n    }\n  }\n  return result;\n}\n\n// Get all folders accessible by a user (owned + shared)\nexport function getAccessibleFolders(store: Store, userId: string): Folder[] {\n  const result: Folder[] = [];\n  const seen = new Set<string>();\n  for (const folder of store.folders.values()) {\n    if (seen.has(folder.id)) continue;\n    const role = getFolderEffectiveRole(store, folder.id, userId);\n    if (role !== 'none') {\n      result.push(folder);\n      seen.add(folder.id);\n    }\n  }\n  return result;\n}\n\n// Get all documents accessible by a user (owned + shared + folder-inherited)\nexport function getAccessibleDocuments(store: Store, userId: string): Document[] {\n  const result: Document[] = [];\n  const seen = new Set<string>();\n  for (const doc of store.documents.values()) {\n    if (seen.has(doc.id)) continue;\n    const role = getDocumentEffectiveRole(store, doc.id, userId);\n    if (role !== 'none') {\n      result.push(doc);\n      seen.add(doc.id);\n    }\n  }\n  return result;\n}\n\n// Get all folders that are children of a given folder\nexport function getChildFolders(store: Store, parentId: string): Folder[] {\n  const result: Folder[] = [];\n  for (const folder of store.folders.values()) {\n    if (folder.parentId === parentId) {\n      result.push(folder);\n    }\n  }\n  return result;\n}\n\n// Get all documents in a given folder\nexport function getDocumentsByFolder(store: Store, folderId: string): Document[] {\n  const result: Document[] = [];\n  for (const doc of store.documents.values()) {\n    if (doc.folderId === folderId) {\n      result.push(doc);\n    }\n  }\n  return result;\n}\n\n// Get the effective role of a user on a resource (folder or document)\nexport function getResourceEffectiveRole(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  if (resourceType === 'folder') {\n    return getFolderEffectiveRole(store, resourceId, userId);\n  }\n  return getDocumentEffectiveRole(store, resourceId, userId);\n}\n\n// Get the owner of a resource\nexport function getResourceOwner(store: Store, resourceId: string, resourceType: 'folder' | 'document'): string | undefined {\n  if (resourceType === 'folder') {\n    const folder = store.folders.get(resourceId);\n    return folder?.ownerId;\n  }\n  const doc = store.documents.get(resourceId);\n  return doc?.ownerId;\n}\n\n// Get the name/title of a resource\nexport function getResourceName(store: Store, resourceId: string, resourceType: 'folder' | 'document'): string | undefined {\n  if (resourceType === 'folder') {\n    const folder = store.folders.get(resourceId);\n    return folder?.name;\n  }\n  const doc = store.documents.get(resourceId);\n  return doc?.title;\n}\n\n// Check if a user can write to a resource\nexport function canWriteResource(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): boolean {\n  const role = getResourceEffectiveRole(store, resourceId, resourceType, userId);\n  return role === 'editor' || role === 'owner';\n}\n\n// Check if a user can read a resource\nexport function canReadResource(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): boolean {\n  const role = getResourceEffectiveRole(store, resourceId, resourceType, userId);\n  return role !== 'none';\n}\n\n// Check if a user can share a resource\nexport function canShareResource(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): boolean {\n  const role = getResourceEffectiveRole(store, resourceId, resourceType, userId);\n  return role === 'editor' || role === 'owner';\n}\n\n// Check if a user can delete a resource\nexport function canDeleteResource(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): boolean {\n  const role = getResourceEffectiveRole(store, resourceId, resourceType, userId);\n  return role === 'owner';\n}\n\n// Get the resource type for a given ID\nexport function getResourceType(store: Store, resourceId: string): 'folder' | 'document' | undefined {\n  if (store.folders.has(resourceId)) return 'folder';\n  if (store.documents.has(resourceId)) return 'document';\n  return undefined;\n}\n\n// Get the resource (folder or document) by ID\nexport function getResource(store: Store, resourceId: string): Folder | Document | undefined {\n  const folder = store.folders.get(resourceId);\n  if (folder) return folder;\n  return store.documents.get(resourceId);\n}\n\n// Get the parent folder of a folder\nexport function getParentFolder(store: Store, folderId: string): Folder | undefined {\n  const folder = store.folders.get(folderId);\n  if (!folder || !folder.parentId) return undefined;\n  return store.folders.get(folder.parentId);\n}\n\n// Get the folder that contains a document\nexport function getDocumentFolder(store: Store, documentId: string): Folder | undefined {\n  const doc = store.documents.get(documentId);\n  if (!doc) return undefined;\n  return store.folders.get(doc.folderId);\n}\n\n// Get the path of a folder (from root to the folder)\nexport function getFolderPath(store: Store, folderId: string): Folder[] {\n  const path: Folder[] = [];\n  let current = store.folders.get(folderId);\n  while (current) {\n    path.unshift(current);\n    if (!current.parentId) break;\n    current = store.folders.get(current.parentId);\n  }\n  return path;\n}\n\n// Get the path of a document (from root folder to the document)\nexport function getDocumentPath(store: Store, documentId: string): (Folder | Document)[] {\n  const path: (Folder | Document)[] = [];\n  const doc = store.documents.get(documentId);\n  if (!doc) return path;\n  const folderPath = getFolderPath(store, doc.folderId);\n  path.push(...folderPath);\n  path.push(doc);\n  return path;\n}\n\n// Get the effective role of a user on a folder considering all paths\nexport function getEffectiveFolderRole(store: Store, folderId: string, userId: string): EffectiveRole {\n  return getFolderEffectiveRole(store, folderId, userId);\n}\n\n// Get the effective role of a user on a document considering all paths\nexport function getEffectiveDocumentRole(store: Store, documentId: string, userId: string): EffectiveRole {\n  return getDocumentEffectiveRole(store, documentId, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths\nexport function getEffectiveResourceRole(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  if (resourceType === 'folder') {\n    return getEffectiveFolderRole(store, resourceId, userId);\n  }\n  return getEffectiveDocumentRole(store, resourceId, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUser(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  return getEffectiveResourceRole(store, resourceId, resourceType, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRole(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  return getEffectiveResourceRole(store, resourceId, resourceType, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUserOnResource(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  return getEffectiveResourceRole(store, resourceId, resourceType, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUserOnFolder(store: Store, folderId: string, userId: string): EffectiveRole {\n  return getEffectiveFolderRole(store, folderId, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUserOnDocument(store: Store, documentId: string, userId: string): EffectiveRole {\n  return getEffectiveDocumentRole(store, documentId, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUserOnResourceByType(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  return getEffectiveResourceRole(store, resourceId, resourceType, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUserOnResourceById(store: Store, resourceId: string, userId: string): EffectiveRole {\n  const resourceType = getResourceType(store, resourceId);\n  if (!resourceType) return 'none';\n  return getEffectiveResourceRole(store, resourceId, resourceType, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUserOnResourceByIdAndType(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  return getEffectiveResourceRole(store, resourceId, resourceType, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUserOnResourceByIdAndTypeAndUser(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  return getEffectiveResourceRole(store, resourceId, resourceType, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUserOnResourceByIdAndTypeAndUserAndStore(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  return getEffectiveResourceRole(store, resourceId, resourceType, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUserOnResourceByIdAndTypeAndUserAndStoreAndStore(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  return getEffectiveResourceRole(store, resourceId, resourceType, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUserOnResourceByIdAndTypeAndUserAndStoreAndStore