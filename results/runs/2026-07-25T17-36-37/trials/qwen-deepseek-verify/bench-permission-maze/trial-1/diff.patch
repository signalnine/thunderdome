ent', folderId);\n      expect(res.status).toBe(201);\n      expect(res.body.id).toBeDefined();\n      expect(res.body.title).toBe('My Doc');\n      expect(res.body.content).toBe('Some content');\n      expect(res.body.folderId).toBe(folderId);\n    });\n\n    it('should require title, content, and folderId', async () => {\n      const res = await request(app).post('/documents').set('Authorization', `Bearer ${token}`).send({ title: 'Doc' });\n      expect(res.status).toBe(400);\n    });\n\n    it('should reject document in nonexistent folder', async () => {\n      const res = await createDocument(app, token, 'Doc', 'Content', 'nonexistent');\n      expect(res.status).toBe(404);\n    });\n\n    it('should list documents', async () => {\n      await createDocument(app, token, 'Doc 1', 'Content 1', folderId);\n      await createDocument(app, token, 'Doc 2', 'Content 2', folderId);\n      const res = await request(app).get('/documents').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.length).toBe(2);\n    });\n\n    it('should get document by id', async () => {\n      const created = await createDocument(app, token, 'My Doc', 'Content', folderId);\n      const res = await request(app).get(`/documents/${created.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('My Doc');\n    });\n\n    it('should return 404 for nonexistent document', async () => {\n      const res = await request(app).get('/documents/999').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(404);\n    });\n\n    it('should update document', async () => {\n      const created = await createDocument(app, token, 'Old Title', 'Old Content', folderId);\n      const res = await request(app).put(`/documents/${created.body.id}`).set('Authorization', `Bearer ${token}`).send({ title: 'New Title', content: 'New Content' });\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('New Title');\n      expect(res.body.content).toBe('New Content');\n    });\n\n    it('should reject update by viewer', async () => {\n      await register(app, 'bob', 'pass456');\n      const doc = await createDocument(app, token, 'Shared Doc', 'Content', folderId);\n      await shareResource(app, token, doc.body.id, 'document', 'bob', 'viewer');\n      const bobToken = await getToken(app, 'bob', 'pass456');\n      const res = await request(app).put(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${bobToken}`).send({ title: 'Changed' });\n      expect(res.status).toBe(403);\n    });\n\n    it('should allow update by editor', async () => {\n      await register(app, 'bob', 'pass456');\n      const doc = await createDocument(app, token, 'Shared Doc', 'Content', folderId);\n      await shareResource(app, token, doc.body.id, 'document', 'bob', 'editor');\n      const bobToken = await getToken(app, 'bob', 'pass456');\n      const res = await request(app).put(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${bobToken}`).send({ title: 'Changed' });\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('Changed');\n    });\n\n    it('should delete document', async () => {\n      const created = await createDocument(app, token, 'To Delete', 'Content', folderId);\n      const res = await request(app).delete(`/documents/${created.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(204);\n      const getRes = await request(app).get(`/documents/${created.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(getRes.status).toBe(404);\n    });\n\n    it('should only allow owner to delete document', async () => {\n      await register(app, 'bob', 'pass456');\n      const doc = await createDocument(app, token, 'Alice Doc', 'Content', folderId);\n      await shareResource(app, token, doc.body.id, 'document', 'bob', 'editor');\n      const bobToken = await getToken(app, 'bob', '