re, folderId);\n  for (const d of descendants) {\n    folderIds.add(d);\n  }\n  const toDelete: string[] = [];\n  for (const [id, doc] of store.documents.entries()) {\n    if (folderIds.has(doc.folderId)) {\n      toDelete.push(id);\n    }\n  }\n  for (const id of toDelete) {\n    store.documents.delete(id);\n  }\n}\n\n// Delete all folders in a tree\nexport function deleteFoldersInTree(store: Store, folderId: string): void {\n  const folderIds = new Set<string>([folderId]);\n  const descendants = getDescendantFolderIds(store, folderId);\n  for (const d of descendants) {\n    folderIds.add(d);\n  }\n  for (const id of folderIds) {\n    store.folders.delete(id);\n  }\n}\n\n// Delete a folder and everything inside it\nexport function deleteFolderCascade(store: Store, folderId: string): void {\n  deleteSharesForFolderTree(store, folderId);\n  deleteDocumentsInFolderTree(store, folderId);\n  deleteFoldersInTree(store, folderId);\n}\n\n// Delete a document and its shares\nexport function deleteDocumentCascade(store: Store, documentId: string): void {\n  deleteSharesForResource(store, documentId, 'document');\n  store.documents.delete(documentId);\n}\n\n// Find a user by username (for sharing)\nexport function findUserByUsername(store: Store, username: string): User | undefined {\n  for (const user of store.users.values()) {\n    if (user.username === username) {\n      return user;\n    }\n  }\n  return undefined;\n}\n\n// Check if a share already exists for a user on a resource\nexport function findShare(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): Share | undefined {\n  for (const share of store.shares.values()) {\n    if (share.resourceId === resourceId && share.resourceType === resourceType && share.userId === userId) {\n      return share;\n    }\n  }\n  return undefined;\n}\n\n// Generate a random token string\nexport function generateToken(): string {\n  const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n  let result = '';\n  for (let i = 0; i < 32; i++) {\n    result += chars[Math.floor(Math.random() * chars.length)];\n  }\n  return result;\n}\n\n// Check if a folder has children (subfolders or documents)\nexport function folderHasChildren(store: Store, folderId: string): boolean {\n  for (const folder of store.folders.values()) {\n    if (folder.parentId === folderId) return true;\n  }\n  for (const doc of store.documents.values()) {\n    if (doc.folderId === folderId) return true;\n  }\n  return false;\n}\n\n// Check if a folder is a descendant of another folder\nexport function isDescendantOf(store: Store, potentialDescendantId: string, potentialAncestorId: string): boolean {\n  let current = store.folders.get(potentialDescendantId);\n  while (current && current.parentId) {\n    if (current.parentId === potentialAncestorId) return true;\n    current = store.folders.get(current.parentId);\n  }\n  return false;\n}\n\n// Get all activity logs for a user\nexport function getActivityLogsForUser(store: Store, userId: string): ActivityLog[] {\n  return store.activityLogs.filter(log => log.userId === userId);\n}\n\n// Get all activity logs for a resource\nexport function getActivityLogsForResource(store: Store, resourceId: string): ActivityLog[] {\n  return store.activityLogs.filter(log => log.resourceId === resourceId);\n}\n\n// Get all activity logs\nexport function getAllActivityLogs(store: Store): ActivityLog[] {\n  return store.activityLogs;\n}\n\n// Get activity logs with optional filters\nexport function getActivityLogs(store: Store, userId?: string, resourceId?: string): ActivityLog[] {\n  let logs = store.activityLogs;\n  if (userId) {\n    logs = logs.filter(log => log.userId === userId);\n  }\n  if (resourceId) {\n    logs = logs.filter(log => log.resourceId === resourceId);\n  }\n  return logs;\n}\n\n// Get all shares for a user\nexport function getSharesForUser(store: Store, userId: string): Share[] {\n  const result: Share[] = [];\n  for (const share of store.shares.values()) {\n    if (share.userId === userId) {\n      result.push(share);\n    }\n  }\n  return result;\n}\n\n// Get all folders owned by a user\nexport function getFoldersByOwner(store: Store, ownerId: string): Folder[] {\n  const result: Folder[] = [];\n  for (const folder of store.folders.values()) {\n    if (folder.ownerId === ownerId) {\n      result.push(folder);\n    }\n  }\n  return result;\n}\n\n// Get all documents owned by a user\nexport function getDocumentsByOwner(store: Store, ownerId: string): Document[] {\n  const result: Document[] = [];\n  for (const doc of store.documents.values()) {\n    if (doc.ownerId === ownerId) {\n      result.push(doc);\n    }\n  }\n  return result;\n}\n\n// Get all folders accessible by a user (owned + shared)\nexport function getAccessibleFolders(store: Store, userId: string): Folder[] {\n  const result: Folder[] = [];\n  const seen = new Set<string>();\n  for (const folder of store.folders.values()) {\n    if (seen.has(folder.id)) continue;\n    const role = getFolderEffectiveRole(store, folder.id, userId);\n    if (role !== 'none') {\n      result.push(folder);\n      seen.add(folder.id);\n    }\n  }\n  return result;\n}\n\n// Get all documents accessible by a user (owned + shared + folder-inherited)\nexport function getAccessibleDocuments(store: Store, userId: string): Document[] {\n  const result: Document[] = [];\n  const seen = new Set<string>();\n  for (const doc of store.documents.values()) {\n    if (seen.has(doc.id)) continue;\n    const role = getDocumentEffectiveRole(store, doc.id, userId);\n    if (role !== 'none') {\n      result.push(doc);\n      seen.add(doc.id);\n    }\n  }\n  return result;\n}\n\n// Get all folders that are children of a given folder\nexport function getChildFolders(store: Store, parentId: string): Folder[] {\n  const result: Folder[] = [];\n  for (const folder of store.folders.values()) {\n    if (folder.parentId === parentId) {\n      result.push(folder);\n    }\n  }\n  return result;\n}\n\n// Get all documents in a given folder\nexport function getDocumentsByFolder(store: Store, folderId: string): Document[] {\n  const result: Document[] = [];\n  for (const doc of store.documents.values()) {\n    if (doc.folderId === folderId) {\n      result.push(doc);\n    }\n  }\n  return result;\n}\n\n// Get the effective role of a user on a resource (folder or document)\nexport function getResourceEffectiveRole(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  if (resourceType === 'folder') {\n    return getFolderEffectiveRole(store, resourceId, userId);\n  }\n  return getDocumentEffectiveRole(store, resourceId, userId);\n}\n\n// Get the owner of a resource\nexport function getResourceOwner(store: Store, resourceId: string, resourceType: 'folder' | 'document'): string | undefined {\n  if (resourceType === 'folder') {\n    const folder = store.folders.get(resourceId);\n    return folder?.ownerId;\n  }\n  const doc = store.documents.get(resourceId);\n  return doc?.ownerId;\n}\n\n// Get the name/title of a resource\nexport function getResourceName(store: Store, resourceId: string, resourceType: 'folder' | 'document'): string | undefined {\n  if (resourceType === 'folder') {\n    const folder = store.folders.get(resourceId);\n    return folder?.name;\n  }\n  const doc = store.documents.get(resourceId);\n  return doc?.title;\n}\n\n// Check if a user can write to a resource\nexport function canWriteResource(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): boolean {\n  const role = getResourceEffectiveRole(store, resourceId, resourceType, userId);\n  return role === 'editor' || role === 'owner';\n}\n\n// Check if a user can read a resource\nexport function canReadResource(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): boolean {\n  const role = getResourceEffectiveRole(store, resourceId, resourceType, userId);\n  return role !== 'none';\n}\n\n// Check if a user can share a resource\nexport function canShareResource(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): boolean {\n  const role = getResourceEffectiveRole(store, resourceId, resourceType, userId);\n  return role === 'editor' || role === 'owner';\n}\n\n// Check if a user can delete a resource\nexport function canDeleteResource(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): boolean {\n  const role = getResourceEffectiveRole(store, resourceId, resourceType, userId);\n  return role === 'owner';\n}\n\n// Get the resource type for a given ID\nexport function getResourceType(store: Store, resourceId: string): 'folder' | 'document' | undefined {\n  if (store.folders.has(resourceId)) return 'folder';\n  if (store.documents.has(resourceId)) return 'document';\n  return undefined;\n}\n\n// Get the resource (folder or document) by ID\nexport function getResource(store: Store, resourceId: string): Folder | Document | undefined {\n  const folder = store.folders.get(resourceId);\n  if (folder) return folder;\n  return store.documents.get(resourceId);\n}\n\n// Get the parent folder of a folder\nexport function getParentFolder(store: Store, folderId: string): Folder | undefined {\n  const folder = store.folders.get(folderId);\n  if (!folder || !folder.parentId) return undefined;\n  return store.folders.get(folder.parentId);\n}\n\n// Get the folder that contains a document\nexport function getDocumentFolder(store: Store, documentId: string): Folder | undefined {\n  const doc = store.documents.get(documentId);\n  if (!doc) return undefined;\n  return store.folders.get(doc.folderId);\n}\n\n// Get the path of a folder (from root to the folder)\nexport function getFolderPath(store: Store, folderId: string): Folder[] {\n  const path: Folder[] = [];\n  let current = store.folders.get(folderId);\n  while (current) {\n    path.unshift(current);\n    if (!current.parentId) break;\n    current = store.folders.get(current.parentId);\n  }\n  return path;\n}\n\n// Get the path of a document (from root folder to the document)\nexport function getDocumentPath(store: Store, documentId: string): (Folder | Document)[] {\n  const path: (Folder | Document)[] = [];\n  const doc = store.documents.get(documentId);\n  if (!doc) return path;\n  const folderPath = getFolderPath(store, doc.folderId);\n  path.push(...folderPath);\n  path.push(doc);\n  return path;\n}\n\n// Get the effective role of a user on a folder considering all paths\nexport function getEffectiveFolderRole(store: Store, folderId: string, userId: string): EffectiveRole {\n  return getFolderEffectiveRole(store, folderId, userId);\n}\n\n// Get the effective role of a user on a document considering all paths\nexport function getEffectiveDocumentRole(store: Store, documentId: string, userId: string): EffectiveRole {\n  return getDocumentEffectiveRole(store, documentId, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths\nexport function getEffectiveResourceRole(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  if (resourceType === 'folder') {\n    return getEffectiveFolderRole(store, resourceId, userId);\n  }\n  return getEffectiveDocumentRole(store, resourceId, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRoleForUser(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  return getEffectiveResourceRole(store, resourceId, resourceType, userId);\n}\n\n// Get the effective role of a user on a resource considering all paths (alias)\nexport function getEffectiveRole(store: Store, resourceId: string, resourceType: 'folder' | 'document', userId: string): EffectiveRole {\n  return getEffectiveResourceRole(store, resourceId, resourceType, userId);\n}\n\n// Get