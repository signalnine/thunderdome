der = await createFolder(app, token, 'My Folder');\n      const doc = await createDocument(app, token, 'My Doc', 'Content', folder.body.id);\n      const res = await request(app).get('/activity').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      const docLog = res.body.find((l: { action: string }) => l.action === 'document_created' && l.resourceId === doc.body.id);\n      expect(docLog).toBeDefined();\n    });\n\n    it('should log document update', async () => {\n      const folder = await createFolder(app, token, 'My Folder');\n      const doc = await createDocument(app, token, 'My Doc', 'Content', folder.body.id);\n      await request(app).put(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${token}`).send({ title: 'Updated' });\n      const res = await request(app).get('/activity').set('Authorization', `Bearer ${token}`);\n      const updateLog = res.body.find((l: { action: string }) => l.action === 'document_updated' && l.resourceId === doc.body.id);\n      expect(updateLog).toBeDefined();\n    });\n\n    it('should log document deletion', async () => {\n      const folder = await createFolder(app, token, 'My Folder');\n      const doc = await createDocument(app, token, 'My Doc', 'Content', folder.body.id);\n      await request(app).delete(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${token}`);\n      const res = await request(app).get('/activity').set('Authorization', `Bearer ${token}`);\n      const deleteLog = res.body.find((l: { action: string }) => l.action === 'document_deleted' && l.resourceId === doc.body.id);\n      expect(deleteLog).toBeDefined();\n    });\n\n    it('should log folder update', async () => {\n      const folder = await createFolder(app, token, 'My Folder');\n      await request(app).put(`/folders/${folder.body.id}`).set('Authorization', `Bearer ${token}`).send({ name: 'Updated' });\n      const res = await request(app).get('/activity').set('Authorization', `Bearer ${token}`);\n