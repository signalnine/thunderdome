+{"type":"assistant","message":{"content":[{"id":"toolu_q27_555_0","input":{"file_path":"/workspace/tests/app.test.ts","content":"import request from 'supertest';\nimport { createApp } from '../src/app.js';\nimport { resetStore } from '../src/store.js';\n\nfunction register(app: ReturnType<typeof createApp>, username: string, password: string) {\n  return request(app).post('/auth/register').send({ username, password });\n}\n\nfunction login(app: ReturnType<typeof createApp>, username: string, password: string) {\n  return request(app).post('/auth/login').send({ username, password });\n}\n\nfunction getToken(app: ReturnType<typeof createApp>, username: string, password: string) {\n  return login(app, username, password).then(r => r.body.token);\n}\n\nfunction createFolder(app: ReturnType<typeof createApp>, token: string, name: string, parentId?: string) {\n  const body: Record<string, string> = { name };\n  if (parentId !== undefined) body.parentId = parentId;\n  return request(app).post('/folders').set('Authorization', `Bearer ${token}`).send(body);\n}\n\nfunction createDocument(app: ReturnType<typeof createApp>, token: string, title: string, content: string, folderId: string) {\n  return request(app).post('/documents').set('Authorization', `Bearer ${token}`).send({ title, content, folderId });\n}\n\nfunction shareResource(app: ReturnType<typeof createApp>, token: string, resourceId: string, resourceType: string, username: string, role: string) {\n  return request(app).post('/share').set('Authorization', `Bearer ${token}`).send({ resourceId, resourceType, username, role });\n}\n\ndescribe('Document Management API', () => {\n  let app: ReturnType<typeof createApp>;\n\n  beforeEach(() => {\n    resetStore();\n    app = createApp();\n  });\n\n  // ==================== Auth Tests ====================\n\n  describe('Authentication', () => {\n    it('should register a new user', async () => {\n      const res = await register(app, 'alice', 'pass123');\n      expect(res.status).toBe(201);\n      expect(res.body.id).toBeDefined();\n      expect(res.body.username).toBe('alice');\n    });\n\n    it('should reject duplicate username', async () => {\n      await register(app, 'alice', 'pass123');\n      const res = await register(app, 'alice', 'other');\n      expect(res.status).toBe(409);\n    });\n\n    it('should require username and password', async () => {\n      const res = await request(app).post('/auth/register').send({ username: 'alice' });\n      expect(res.status).toBe(400);\n    });\n\n    it('should login and return a token', async () => {\n      await register(app, 'alice', 'pass123');\n      const res = await login(app, 'alice', 'pass123');\n      expect(res.status).toBe(200);\n      expect(res.body.token).toBeDefined();\n      expect(res.body.userId).toBeDefined();\n      expect(res.body.username).toBe('alice');\n    });\n\n    it('should reject invalid login', async () => {\n      await register(app, 'alice', 'pass123');\n      const res = await login(app, 'alice', 'wrong');\n      expect(res.status).toBe(401);\n    });\n\n    it('should reject login for nonexistent user', async () => {\n      const res = await login(app, 'nobody', 'pass');\n      expect(res.status).toBe(401);\n    });\n\n    it('should protect routes without token', async () => {\n      const res = await request(app).get('/folders');\n      expect(res.status).toBe(401);\n    });\n\n    it('should reject invalid token', async () => {\n      const res = await request(app).get('/folders').set('Authorization', 'Bearer invalidtoken');\n      expect(res.status).toBe(401);\n    });\n\n    it('should get current user with /auth/me', async () => {\n      await register(app, 'alice', 'pass123');\n      const token = await getToken(app, 'alice', 'pass123');\n      const res = await request(app).get('/auth/me').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.username).toBe('alice');\n    });\n  });\n\n  // ==================== User Tests ====================\n\n  describe('Users', () => {\n    it('should list users', async () => {\n      await register(app, 'alice', 'pass123');\n      await register(app, 'bob', 'pass456');\n      const token = await getToken(app, 'alice', 'pass123');\n      const res = await request(app).get('/users').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.length).toBe(2);\n    });\n\n    it('should get user by id', async () => {\n      const regRes = await register(app, 'alice', 'pass123');\n      const token = await getToken(app, 'alice', 'pass123');\n      const res = await request(app).get(`/users/${regRes.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.username).toBe('alice');\n    });\n\n    it('should return 404 for nonexistent user', async () => {\n      await register(app, 'alice', 'pass123');\n      const token = await getToken(app, 'alice', 'pass123');\n      const res = await request(app).get('/users/999').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(404);\n    });\n  });\n\n  // ==================== Folder Tests ====================\n\n  describe('Folders', () => {\n    let token: string;\n\n    beforeEach(async () => {\n      await register(app, 'alice', 'pass123');\n      token = await getToken(app, 'alice', 'pass123');\n    });\n\n    it('should create a folder', async () => {\n      const res = await createFolder(app, token, 'My Folder');\n      expect(res.status).toBe(201);\n      expect(res.body.id).toBeDefined();\n      expect(res.body.name).toBe('My Folder');\n      expect(res.body.parentId).toBeNull();\n      expect(res.body.ownerId).toBe(token ? (await login(app, 'alice', 'pass123')).body.userId : '');\n    });\n\n    it('should require name', async () => {\n      const res = await request(app).post('/folders').set('Authorization', `Bearer ${token}`).send({});\n      expect(res.status).toBe(400);\n    });\n\n    it('should create a nested folder', async () => {\n      const parent = await createFolder(app, token, 'Parent');\n      const child = await createFolder(app, token, 'Child', parent.body.id);\n      expect(child.status).toBe(201);\n      expect(child.body.parentId).toBe(parent.body.id);\n    });\n\n    it('should reject nested folder with nonexistent parent', async () => {\n      const res = await createFolder(app, token, 'Child', 'nonexistent');\n      expect(res.status).toBe(404);\n    });\n\n    it('should list folders', async () => {\n      await createFolder(app, token, 'Folder 1');\n      await createFolder(app, token, 'Folder 2');\n      const res = await request(app).get('/folders').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.length).toBe(2);\n    });\n\n    it('should get folder by id', async () => {\n      const created = await createFolder(app, token, 'My Folder');\n      const res = await request(app).get(`/folders/${created.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.name).toBe('My Folder');\n    });\n\n    it('should return 404 for nonexistent folder', async () => {\n      const res = await request(app).get('/folders/999').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(404);\n    });\n\n    it('should update folder name', async () => {\n      const created = await createFolder(app, token, 'Old Name');\n      const res = await request(app).put(`/folders/${created.body.id}`).set('Authorization', `Bearer ${token}`).send({ name: 'New Name' });\n      expect(res.status).toBe(200);\n      expect(res.body.name).toBe('New Name');\n    });\n\n    it('should update folder parent', async () => {\n      const parent = await createFolder(app, token, 'Parent');\n      const child = await createFolder(app, token, 'Child');\n      const res = await request(app).put(`/folders/${child.body.id}`).set('Authorization', `Bearer ${token}`).send({ parentId: parent.body.id });\n      expect(res.status).toBe(200);\n      expect(res.body.parentId).toBe(parent.body.id);\n    });\n\n    it('should reject update by viewer', async () => {\n      await register(app, 'bob', 'pass456');\n      const folder = await createFolder(app, token, 'Shared');\n      await shareResource(app, token, folder.body.id, 'folder', 'bob', 'viewer');\n      const bobToken = await getToken(app, 'bob', 'pass456');\n      const res = await request(app).put(`/folders/${folder.body.id}`).set('Authorization', `Bearer ${bobToken}`).send({ name: 'Changed' });\n      expect(res.status).toBe(403);\n    });\n\n    it('should allow update by editor', async () => {\n      await register(app, 'bob', 'pass456');\n      const folder = await createFolder(app, token, 'Shared');\n      await shareResource(app, token, folder.body.id, 'folder', 'bob', 'editor');\n      const bobToken = await getToken(app, 'bob', 'pass456');\n      const res = await request(app).put(`/folders/${folder.body.id}`).set('Authorization', `Bearer ${bobToken}`).send({ name: 'Changed' });\n      expect(res.status).toBe(200);\n      expect(res.body.name).toBe('Changed');\n    });\n\n    it('should delete folder', async () => {\n      const created = await createFolder(app, token, 'To Delete');\n      const res = await request(app).delete(`/folders/${created.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(204);\n      const getRes = await request(app).get(`/folders/${created.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(getRes.status).toBe(404);\n    });\n\n    it('should only allow owner to delete folder', async () => {\n      await register(app, 'bob', 'pass456');\n      const folder = await createFolder(app, token, 'Alice Folder');\n      await shareResource(app, token, folder.body.id, 'folder', 'bob', 'editor');\n      const bobToken = await getToken(app, 'bob', 'pass456');\n      const res = await request(app).delete(`/folders/${folder.body.id}`).set('Authorization', `Bearer ${bobToken}`);\n      expect(res.status).toBe(403);\n    });\n\n    it('should cascade delete: folder with children', async () => {\n      const parent = await createFolder(app, token, 'Parent');\n      const child = await createFolder(app, token, 'Child', parent.body.id);\n      const doc = await createDocument(app, token, 'Doc', 'Content', parent.body.id);\n      await request(app).delete(`/folders/${parent.body.id}`).set('Authorization', `Bearer ${token}`);\n      // Child folder should be gone\n      const childRes = await request(app).get(`/folders/${child.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(childRes.status).toBe(404);\n      // Document should be gone\n      const docRes = await request(app).get(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(docRes.status).toBe(404);\n    });\n\n    it('should list child folders', async () => {\n      const parent = await createFolder(app, token, 'Parent');\n      await createFolder(app, token, 'Child 1', parent.body.id);\n      await createFolder(app, token, 'Child 2', parent.body.id);\n      const res = await request(app).get(`/folders?parentId=${parent.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.length).toBe(2);\n    });\n\n    it('should list documents in a folder', async () => {\n      const folder = await createFolder(app, token, 'My Folder');\n      await createDocument(app, token, 'Doc 1', 'Content 1', folder.body.id);\n      await createDocument(app, token, 'Doc 2', 'Content 2', folder.body.id);\n      const res = await request(app).get(`/folders/${folder.body.id}/documents`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.length).toBe(2);\n    });\n\n    it('should list shares on a folder', async () => {\n      await register(app, 'bob', 'pass456');\n      const folder = await createFolder(app, token, 'Shared');\n      await shareResource(app, token, folder.body.id, 'folder', 'bob', 'viewer');\n      const res = await request(app).get(`/folders/${folder.body.id}/shares`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.length).toBe(1);\n    });\n\n    it('should prevent circular parent reference', async () => {\n      const folder = await createFolder(app, token, 'Self');\n      const res = await request(app).put(`/folders/${folder.body.id}`).set('Authorization', `Bearer ${token}`).send({ parentId: folder.body.id });\n      expect(res.status).toBe(400);\n    });\n\n    it('should prevent moving folder into its own descendant', async () => {\n      const parent = await createFolder(app, token, 'Parent');\n      const child = await createFolder(app, token, 'Child', parent.body.id);\n      const res = await request(app).put(`/folders/${parent.body.id}`).set('Authorization', `Bearer ${token}`).send({ parentId: child.body.id });\n      expect(res.status).toBe(400);\n    });\n  });\n\n  // ==================== Document Tests ====================\n\n  describe('Documents', () => {\n    let token: string;\n    let folderId: string;\n\n    beforeEach(async () => {\n      await register(app, 'alice', 'pass123');\n      token = await getToken(app, 'alice', 'pass123');\n      const folder = await createFolder(app, token, 'My Folder');\n      folderId = folder.body.id;\n    });\n\n    it('should create a document', async () => {\n      const res = await createDocument(app, token, 'My Doc', 'Some content', folderId);\n      expect(res.status).toBe(201);\n      expect(res.body.id).toBeDefined();\n      expect(res.body.title).toBe('My Doc');\n      expect(res.body.content).toBe('Some content');\n      expect(res.body.folderId).toBe(folderId);\n    });\n\n    it('should require title, content, and folderId', async () => {\n      const res = await request(app).post('/documents').set('Authorization', `Bearer ${token}`).send({ title: 'Doc' });\n      expect(res.status).toBe(400);\n    });\n\n    it('should reject document in nonexistent folder', async () => {\n      const res = await createDocument(app, token, 'Doc', 'Content', 'nonexistent');\n      expect(res.status).toBe(404);\n    });\n\n    it('should list documents', async () => {\n      await createDocument(app, token, 'Doc 1', 'Content 1', folderId);\n      await createDocument(app, token, 'Doc 2', 'Content 2', folderId);\n      const res = await request(app).get('/documents').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.length).toBe(2);\n    });\n\n    it('should get document by id', async () => {\n      const created = await createDocument(app, token, 'My Doc', 'Content', folderId);\n      const res = await request(app).get(`/documents/${created.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('My Doc');\n    });\n\n    it('should return 404 for nonexistent document', async () => {\n      const res = await request(app).get('/documents/999').set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(404);\n    });\n\n    it('should update document', async () => {\n      const created = await createDocument(app, token, 'Old Title', 'Old Content', folderId);\n      const res = await request(app).put(`/documents/${created.body.id}`).set('Authorization', `Bearer ${token}`).send({ title: 'New Title', content: 'New Content' });\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('New Title');\n      expect(res.body.content).toBe('New Content');\n    });\n\n    it('should reject update by viewer', async () => {\n      await register(app, 'bob', 'pass456');\n      const doc = await createDocument(app, token, 'Shared Doc', 'Content', folderId);\n      await shareResource(app, token, doc.body.id, 'document', 'bob', 'viewer');\n      const bobToken = await getToken(app, 'bob', 'pass456');\n      const res = await request(app).put(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${bobToken}`).send({ title: 'Changed' });\n      expect(res.status).toBe(403);\n    });\n\n    it('should allow update by editor', async () => {\n      await register(app, 'bob', 'pass456');\n      const doc = await createDocument(app, token, 'Shared Doc', 'Content', folderId);\n      await shareResource(app, token, doc.body.id, 'document', 'bob', 'editor');\n      const bobToken = await getToken(app, 'bob', 'pass456');\n      const res = await request(app).put(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${bobToken}`).send({ title: 'Changed' });\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('Changed');\n    });\n\n    it('should delete document', async () => {\n      const created = await createDocument(app, token, 'To Delete', 'Content', folderId);\n      const res = await request(app).delete(`/documents/${created.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(204);\n      const getRes = await request(app).get(`/documents/${created.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(getRes.status).toBe(404);\n    });\n\n    it('should only allow owner to delete document', async () => {\n      await register(app, 'bob', 'pass456');\n      const doc = await createDocument(app, token, 'Alice Doc', 'Content', folderId);\n      await shareResource(app, token, doc.body.id, 'document', 'bob', 'editor');\n      const bobToken = await getToken(app, 'bob', 'pass456');\n      const res = await request(app).delete(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${bobToken}`);\n      expect(res.status).toBe(403);\n    });\n\n    it('should list shares on a document', async () => {\n      await register(app, 'bob', 'pass456');\n      const doc = await createDocument(app, token, 'Shared Doc', 'Content', folderId);\n      await shareResource(app, token, doc.body.id, 'document', 'bob', 'viewer');\n      const res = await request(app).get(`/documents/${doc.body.id}/shares`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.length).toBe(1);\n    });\n  });\n\n  // ==================== Sharing Tests ====================\n\n  describe('Sharing', () => {\n    let aliceToken: string;\n    let bobToken: string;\n\n    beforeEach(async () => {\n      await register(app, 'alice', 'pass123');\n      await register(app, 'bob', 'pass456');\n      aliceToken = await getToken(app, 'alice', 'pass123');\n      bobToken = await getToken(app, 'bob', 'pass456');\n    });\n\n    it('should share a folder with a user', async () => {\n      const folder = await createFolder(app, aliceToken, 'Shared Folder');\n      const res = await shareResource(app, aliceToken, folder.body.id, 'folder', 'bob', 'viewer');\n      expect(res.status).toBe(201);\n      expect(res.body.resourceId).toBe(folder.body.id);\n      expect(res.body.role).toBe('viewer');\n    });\n\n    it('should share a document with a user', async () => {\n      const folder = await createFolder(app, aliceToken, 'My Folder');\n      const doc = await createDocument(app, aliceToken, 'Shared Doc', 'Content', folder.body.id);\n      const res = await shareResource(app, aliceToken, doc.body.id, 'document', 'bob', 'editor');\n      expect(res.status).toBe(201);\n      expect(res.body.resourceId).toBe(doc.body.id);\n      expect(res.body.role).toBe('editor');\n    });\n\n    it('should require all share fields', async () => {\n      const folder = await createFolder(app, aliceToken, 'Folder');\n      const res = await request(app).post('/share').set('Authorization', `Bearer ${aliceToken}`).send({ resourceId: folder.body.id });\n      expect(res.status).toBe(400);\n    });\n\n    it('should reject invalid resource type', async () => {\n      const folder = await createFolder(app, aliceToken, 'Folder');\n      const res = await request(app).post('/share').set('Authorization', `Bearer ${aliceToken}`).send({ resourceId: folder.body.id, resourceType: 'invalid', username: 'bob', role: 'viewer' });\n      expect(res.status).toBe(400);\n    });\n\n    it('should reject invalid role', async () => {\n      const folder = await createFolder(app, aliceToken, 'Folder');\n      const res = await request(app).post('/share').set('Authorization', `Bearer ${aliceToken}`).send({ resourceId: folder.body.id, resourceType: 'folder', username: 'bob', role: 'admin' });\n      expect(res.status).toBe(400);\n    });\n\n    it('should reject share on nonexistent resource', async () => {\n      const res = await shareResource(app, aliceToken, 'nonexistent', 'folder', 'bob', 'viewer');\n      expect(res.status).toBe(404);\n    });\n\n    it('should reject share on nonexistent user', async () => {\n      const folder = await createFolder(app, aliceToken, 'Folder');\n      const res = await shareResource(app, aliceToken, folder.body.id, 'folder', 'nobody', 'viewer');\n      expect(res.status).toBe(404);\n    });\n\n    it('should reject share by viewer', async () => {\n      const folder = await createFolder(app, aliceToken, 'Folder');\n      await shareResource(app, aliceToken, folder.body.id, 'folder', 'bob', 'viewer');\n      const res = await shareResource(app, bobToken, folder.body.id, 'folder', 'alice', 'editor');\n      expect(res.status).toBe(403);\n    });\n\n    it('should allow share by editor', async () => {\n      const folder = await createFolder(app, aliceToken, 'Folder');\n      await shareResource(app, aliceToken, folder.body.id, 'folder', 'bob', 'editor');\n      const res = await shareResource(app, bobToken, folder.body.id, 'folder', 'alice', 'viewer');\n      expect(res.status).toBe(201);\n    });\n\n    it('should update existing share role', async () => {\n      const folder = await createFolder(app, aliceToken, 'Folder');\n      await shareResource(app, aliceToken, folder.body.id, 'folder', 'bob', 'viewer');\n      const res = await shareResource(app, aliceToken, folder.body.id, 'folder', 'bob', 'editor');\n      expect(res.status).toBe(200);\n      expect(res.body.role).toBe('editor');\n    });\n\n    it('should revoke a share', async () => {\n      const folder = await createFolder(app, aliceToken, 'Folder');\n      const shareRes = await shareResource(app, aliceToken, folder.body.id, 'folder', 'bob', 'viewer');\n      const res = await request(app).delete(`/share/${shareRes.body.id}`).set('Authorization', `Bearer ${aliceToken}`);\n      expect(res.status).toBe(204);\n    });\n\n    it('should reject revoke by unauthorized user', async () => {\n      const folder = await createFolder(app, aliceToken, 'Folder');\n      const shareRes = await shareResource(app, aliceToken, folder.body.id, 'folder', 'bob', 'viewer');\n      const res = await request(app).delete(`/share/${shareRes.body.id}`).set('Authorization', `Bearer ${bobToken}`);\n      expect(res.status).toBe(403);\n    });\n  });\n\n  // ==================== Permission Tests ====================\n\n  describe('Permissions', () => {\n    let aliceToken: string;\n    let bobToken: string;\n\n    beforeEach(async () => {\n      await register(app, 'alice', 'pass123');\n      await register(app, 'bob', 'pass456');\n      aliceToken = await getToken(app, 'alice', 'pass123');\n      bobToken = await getToken(app, 'bob', 'pass456');\n    });\n\n    it('viewer can read folder', async () => {\n      const folder = await createFolder(app, aliceToken, 'Shared');\n      await shareResource(app, aliceToken, folder.body.id, 'folder', 'bob', 'viewer');\n      const res = await request(app).get(`/folders/${folder.body.id}`).set('Authorization', `Bearer ${bobToken}`);\n      expect(res.status).toBe(200);\n    });\n\n    it('viewer cannot modify folder', async () => {\n      const folder = await createFolder(app, aliceToken, 'Shared');\n      await shareResource(app, aliceToken, folder.body.id, 'folder', 'bob', 'viewer');\n      const res = await request(app).put(`/folders/${folder.body.id}`).set('Authorization', `Bearer ${bobToken}`).send({ name: 'Changed' });\n      expect(res.status).toBe(403);\n    });\n\n    it('editor can read and modify folder', async () => {\n      const folder = await createFolder(app, aliceToken, 'Shared');\n      await shareResource(app, aliceToken, folder.body.id, 'folder', 'bob', 'editor');\n      const getRes = await request(app).get(`/folders/${folder.body.id}`).set('Authorization', `Bearer ${bobToken}`);\n      expect(getRes.status).toBe(200);\n      const putRes = await request(app).put(`/folders/${folder.body.id}`).set('Authorization', `Bearer ${bobToken}`).send({ name: 'Changed' });\n      expect(putRes.status).toBe(200);\n    });\n\n    it('editor cannot delete folder', async () => {\n      const folder = await createFolder(app, aliceToken, 'Shared');\n      await shareResource(app, aliceToken, folder.body.id, 'folder', 'bob', 'editor');\n      const res = await request(app).delete(`/folders/${folder.body.id}`).set('Authorization', `Bearer ${bobToken}`);\n      expect(res.status).toBe(403);\n    });\n\n    it('viewer can read document', async () => {\n      const folder = await createFolder(app, aliceToken, 'Folder');\n      const doc = await createDocument(app, aliceToken, 'Doc', 'Content', folder.body.id);\n      await shareResource(app, aliceToken, doc.body.id, 'document', 'bob', 'viewer');\n      const res = await request(app).get(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${bobToken}`);\n      expect(res.status).toBe(200);\n    });\n\n    it('viewer cannot modify document', async () => {\n      const folder = await createFolder(app, aliceToken, 'Folder');\n      const doc = await createDocument(app, aliceToken, 'Doc', 'Content', folder.body.id);\n      await shareResource(app, aliceToken, doc.body.id, 'document', 'bob', 'viewer');\n      const res = await request(app).put(`/documents/${doc.bo