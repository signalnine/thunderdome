ocument'): Share[] {\n  const result: Share[] = [];\n  for (const share of store.shares.values()) {\n    if (share.resourceId === resourceId && share.resourceType === resourceType) {\n      result.push(share);\n    }\n  }\n  return result;\n}\n\n// Get all documents in a folder\nexport function getDocumentsInFolder(store: Store, folderId: string): Document[] {\n  const result: Document[] = [];\n  for (const doc of store.documents.values()) {\n    if (doc.folderId === folderId) {\n      result.push(doc);\n    }\n  }\n  return result;\n}\n\n// Get all subfolders of a folder\nexport function getSubfolders(store: Store, folderId: string): Folder[] {\n  const result: Folder[] = [];\n  for (const folder of store.folders.values()) {\n    if (folder.parentId === folderId) {\n      result.push(folder);\n    }\n  }\n  return result;\n}\n\n// Get all root folders (no parent)\nexport function getRootFolders(store: Store): Folder[] {\n  const result: Folder[] = [];\n  for (const folder of store.folders.values()) {\n    if (folder.parentId === null) {\n      result.push(folder);\n    }\n  }\n  return result;\n}\n\n// Get user by username\nexport function getUserByUsername(store: Store, username: string): User | undefined {\n  for (const user of store.users.values()) {\n    if (user.username === username) {\n      return user;\n    }\n  }\n  return undefined;\n}\n\n// Get user by ID\nexport function getUserById(store: Store, userId: string): User | undefined {\n  return store.users.get(userId);\n}\n\n// Get all documents in a folder and its descendants\nexport function getAllDocumentsInFolderTree(store: Store, folderId: string): Document[] {\n  const folderIds = new Set<string>([folderId]);\n  const descendants = getDescendantFolderIds(store, folderId);\n  for (const d of descendants) {\n    folderIds.add(d);\n  }\n  const result: Document[] = [];\n  for (const doc of store.documents.values()) {\n    if (folderIds.has(doc.folderId)) {\n      result.push(doc);\n    }\n  }\n  return