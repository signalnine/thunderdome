s.status).toBe(404);\n    });\n\n    it('should only allow owner to delete folder', async () => {\n      await register(app, 'bob', 'pass456');\n      const folder = await createFolder(app, token, 'Alice Folder');\n      await shareResource(app, token, folder.body.id, 'folder', 'bob', 'editor');\n      const bobToken = await getToken(app, 'bob', 'pass456');\n      const res = await request(app).delete(`/folders/${folder.body.id}`).set('Authorization', `Bearer ${bobToken}`);\n      expect(res.status).toBe(403);\n    });\n\n    it('should cascade delete: folder with children', async () => {\n      const parent = await createFolder(app, token, 'Parent');\n      const child = await createFolder(app, token, 'Child', parent.body.id);\n      const doc = await createDocument(app, token, 'Doc', 'Content', parent.body.id);\n      await request(app).delete(`/folders/${parent.body.id}`).set('Authorization', `Bearer ${token}`);\n      // Child folder should be gone\n      const childRes = await request(app).get(`/folders/${child.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(childRes.status).toBe(404);\n      // Document should be gone\n      const docRes = await request(app).get(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(docRes.status).toBe(404);\n    });\n\n    it('should list child folders', async () => {\n      const parent = await createFolder(app, token, 'Parent');\n      await createFolder(app, token, 'Child 1', parent.body.id);\n      await createFolder(app, token, 'Child 2', parent.body.id);\n      const res = await request(app).get(`/folders?parentId=${parent.body.id}`).set('Authorization', `Bearer ${token}`);\n      expect(res.status).toBe(200);\n      expect(res.body.length).toBe(2);\n    });\n\n    it('should list documents in a folder', async () => {\n      const folder = await createFolder(app, token, 'My Folder');\n      await createDocument(app, token, 'Doc 1', 'Content 1', folder.body.id);\n      await