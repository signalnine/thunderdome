index 0000000..5b75500
--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,566 @@
+import express, { Request, Response, NextFunction } from 'express';
+import {
+  Role,
+  EffectiveRole,
+  User,
+  Folder,
+  Document,
+  Share,
+  nextId,
+  now,
+  generateToken,
+  addLog,
+  getFolderEffectiveRole,
+  getDocumentEffectiveRole,
+  getUserByUsername,
+  getUserById,
+  findUserByUsername,
+  findShare,
+  getSharesForResource,
+  deleteFolderCascade,
+  deleteDocumentCascade,
+  getActivityLogs,
+  getAccessibleFolders,
+  getAccessibleDocuments,
+  getDocumentsByFolder,
+  getChildFolders,
+} from './types.js';
+import { getStore } from './store.js';
+
+interface AuthRequest extends Request {
+  userId: string;
+  token: string;
+}
+
+export function createApp(): express.Express {
+  const app = express();
+
+  app.use(express.json());
+
+  // Auth middleware
+  function authMiddleware(req: Request, _res: Response, next: NextFunction) {
+    const authHeader = req.headers.authorization;
+    if (!authHeader || !authHeader.startsWith('Bearer ')) {
+      (_res as Response).status(401).json({ error: 'Authentication required' });
+      return;
+    }
+    const token = authHeader.slice(7);
+    const store = getStore();
+    const authToken = store.tokens.get(token);
+    if (!authToken) {
+      (_res as Response).status(401).json({ error: 'Invalid token' });
+      return;
+    }
+    (req as AuthRequest).userId = authToken.userId;
+    (req as AuthRequest).token = token;
+    next();
+  }
+
+  // ==================== Auth Routes ====================
+
+  // POST /auth/register
+  app.post('/auth/register', (req: Request, res: Response) => {
+    const { username, password } = req.body;
+    if (!username || !password) {
+      res.status(400).json({ error: 'Username and password are required' });
+      return;
+    }
+    const store = getStore();
+    const existing = getUserByUsername(store, username);
+    if (existing) {
+      res.status(409).json({ error: 'Username already exists' });
+      return;
+    }
+    const user: User = {
+      id: nextId(store),
+      username,
+      password,
+    };
+    store.users.set(user.id, user);
+    res.status(201).json({ id: user.id, username: user.username });
+  });
+
+  // POST /auth/login
+  app.post('/auth/login', (req: Request, res: Response) => {
+    const { username, password } = req.body;
+    if (!username || !password) {
+      res.status(400).json({ error: 'Username and password are required' });
+      return;
+    }
+    const store = getStore();
+    const user = getUserByUsername(store, username);
+    if (!user || user.password !== password) {
+      res.status(401).json({ error: 'Invalid credentials' });
+      return;
+    }
+    const token = generateToken();
+    store.tokens.set(token, { token, userId: user.id });
+    res.json({ token, userId: user.id, username: user.username });
+  });
+
+  // GET /auth/me
+  app.get('/auth/me', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const user = getUserById(store, (req as AuthRequest).userId);
+    if (!user) {
+      res.status(404).json({ error: 'User not found' });
+      return;
+    }
+    res.json({ id: user.id, username: user.username });
+  });
+
+  // ==================== User Routes ====================
+
+  // GET /users
+  app.get('/users', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const users = Array.from(store.users.values()).map((u: User) => ({
+      id: u.id,
+      username: u.username,
+    }));
+    res.json(users);
+  });
+
+  // GET /users/:id
+  app.get('/users/:id', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const user = getUserById(store, req.params.id);
+    if (!user) {
+      res.status(404).json({ error: 'User not found' });
+      return;
+    }
+    res.json({ id: user.id, username: user.username });
+  });
+
+  // ==================== Folder Routes ====================
+
+  // POST /folders
+  app.post('/folders', authMiddleware, (req: Request, res: Response) => {
+    const { name, parentId } = req.body;
+    if (!name) {
+      res.status(400).json({ error: 'Name is required' });
+      return;
+    }
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+
+    // If parentId is provided, check it exists and user has access
+    if (parentId !== undefined && parentId !== null) {
+      const parent = store.folders.get(parentId);
+      if (!parent) {
+        res.status(404).json({ error: 'Parent folder not found' });
+        return;
+      }
+      const parentRole = getFolderEffectiveRole(store, parentId, userId);
+      if (parentRole === 'none') {
+        res.status(403).json({ error: 'No access to parent folder' });
+        return;
+      }
+    }
+
+    const folder: Folder = {
+      id: nextId(store),
+      name,
+      parentId: parentId || null,
+      ownerId: userId,
+      createdAt: now(),
+    };
+    store.folders.set(folder.id, folder);
+    addLog(store, 'folder_created', userId, folder.id, 'folder');
+    res.status(201).json(folder);
+  });
+
+  // GET /folders
+  app.get('/folders', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const parentId = req.query.parentId as string | undefined;
+
+    if (parentId !== undefined) {
+      const folders = getChildFolders(store, parentId);
+      const accessible = folders.filter((f: Folder) => getFolderEffectiveRole(store, f.id, userId) !== 'none');
+      res.json(accessible);
+      return;
+    }
+
+    const folders = getAccessibleFolders(store, userId);
+    res.json(folders);
+  });
+
+  // GET /folders/:id
+  app.get('/folders/:id', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+    const role = getFolderEffectiveRole(store, folder.id, userId);
+    if (role === 'none') {
+      res.status(403).json({ error: 'No access to this folder' });
+      return;
+    }
+    res.json(folder);
+  });
+
+  // PUT /folders/:id
+  app.put('/folders/:id', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+    const role = getFolderEffectiveRole(store, folder.id, userId);
+    if (role === 'none' || role === 'viewer') {
+      res.status(403).json({ error: 'No permission to modify this folder' });
+      return;
+    }
+
+    const { name, parentId } = req.body;
+    if (name !== undefined) {
+      folder.name = name;
+    }
+    if (parentId !== undefined) {
+      if (parentId !== null) {
+        const parent = store.folders.get(parentId);
+        if (!parent) {
+          res.status(404).json({ error: 'Parent folder not found' });
+          return;
+        }
+        // Prevent circular references
+        if (parentId === folder.id) {
+          res.status(400).json({ error: 'Cannot set a folder as its own parent' });
+          return;
+        }
+        // Check if the new parent is a descendant of the current folder
+        let current = store.folders.get(parentId);
+        while (current) {
+          if (current.id === folder.id) {
+            res.status(400).json({ error: 'Cannot move a folder into its own descendant' });
+            return;
+          }
+          if (!current.parentId) break;
+          current = store.folders.get(current.parentId);
+        }
+      }
+      folder.parentId = parentId;
+    }
+
+    addLog(store, 'folder_updated', userId, folder.id, 'folder');
+    res.json(folder);
+  });
+
+  // DELETE /folders/:id
+  app.delete('/folders/:id', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+    if (folder.ownerId !== userId) {
+      res.status(403).json({ error: 'Only the owner can delete this folder' });
+      return;
+    }
+    addLog(store, 'folder_deleted', userId, folder.id, 'folder');
+    deleteFolderCascade(store, folder.id);
+    res.status(204).send();
+  });
+
+  // GET /folders/:id/documents
+  app.get('/folders/:id/documents', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+    const role = getFolderEffectiveRole(store, folder.id, userId);
+    if (role === 'none') {
+      res.status(403).json({ error: 'No access to this folder' });
+      return;
+    }
+    const documents = getDocumentsByFolder(store, folder.id);
+    const accessible = documents.filter((d: Document) => getDocumentEffectiveRole(store, d.id, userId) !== 'none');
+    res.json(accessible);
+  });
+
+  // GET /folders/:id/shares
+  app.get('/folders/:id/shares', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+    const role = getFolderEffectiveRole(store, folder.id, userId);
+    if (role === 'none') {
+      res.status(403).json({ error: 'No access to this folder' });
+      return;
+    }
+    const shares = getSharesForResource(store, folder.id, 'folder');
+    res.json(shares);
+  });
+
+  // ==================== Document Routes ====================
+
+  // POST /documents
+  app.post('/documents', authMiddleware, (req: Request, res: Response) => {
+    const { title, content, folderId } = req.body;
+    if (!title || !content || !folderId) {
+      res.status(400).json({ error: 'Title, content, and folderId are required' });
+      return;
+    }
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+
+    const folder = store.folders.get(folderId);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+    const folderRole = getFolderEffectiveRole(store, folderId, userId);
+    if (folderRole === 'none') {
+      res.status(403).json({ error: 'No access to this folder' });
+      return;
+    }
+
+    const document: Document = {
+      id: nextId(store),
+      title,
+      content,
+      folderId,
+      ownerId: userId,
+      createdAt: now(),
+    };
+    store.documents.set(document.id, document);
+    addLog(store, 'document_created', userId, document.id, 'document');
+    res.status(201).json(document);
+  });
+
+  // GET /documents
+  app.get('/documents', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const documents = getAccessibleDocuments(store, userId);
+    res.json(documents);
+  });
+
+  // GET /documents/:id
+  app.get('/documents/:id', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const document = store.documents.get(req.params.id);
+    if (!document) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const role = getDocumentEffectiveRole(store, document.id, userId);
+    if (role === 'none') {
+      res.status(403).json({ error: 'No access to this document' });
+      return;
+    }
+    res.json(document);
+  });
+
+  // PUT /documents/:id
+  app.put('/documents/:id', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const document = store.documents.get(req.params.id);
+    if (!document) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const role = getDocumentEffectiveRole(store, document.id, userId);
+    if (role === 'none' || role === 'viewer') {
+      res.status(403).json({ error: 'No permission to modify this document' });
+      return;
+    }
+
+    const { title, content } = req.body;
+    if (title !== undefined) {
+      document.title = title;
+    }
+    if (content !== undefined) {
+      document.content = content;
+    }
+
+    addLog(store, 'document_updated', userId, document.id, 'document');
+    res.json(document);
+  });
+
+  // DELETE /documents/:id
+  app.delete('/documents/:id', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const document = store.documents.get(req.params.id);
+    if (!document) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    if (document.ownerId !== userId) {
+      res.status(403).json({ error: 'Only the owner can delete this document' });
+      return;
+    }
+    addLog(store, 'document_deleted', userId, document.id, 'document');
+    deleteDocumentCascade(store, document.id);
+    res.status(204).send();
+  });
+
+  // GET /documents/:id/shares
+  app.get('/documents/:id/shares', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const document = store.documents.get(req.params.id);
+    if (!document) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const role = getDocumentEffectiveRole(store, document.id, userId);
+    if (role === 'none') {
+      res.status(403).json({ error: 'No access to this document' });
+      return;
+    }
+    const shares = getSharesForResource(store, document.id, 'document');
+    res.json(shares);
+  });
+
+  // ==================== Share Routes ====================
+
+  // POST /share
+  app.post('/share', authMiddleware, (req: Request, res: Response) => {
+    const { resourceId, resourceType, username, role } = req.body;
+    if (!resourceId || !resourceType || !username || !role) {
+      res.status(400).json({ error: 'resourceId, resourceType, username, and role are required' });
+      return;
+    }
+    if (!['folder', 'document'].includes(resourceType)) {
+      res.status(400).json({ error: 'resourceType must be folder or document' });
+      return;
+    }
+    if (!['viewer', 'editor', 'owner'].includes(role)) {
+      res.status(400).json({ error: 'role must be viewer, editor, or owner' });
+      return;
+    }
+
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+
+    // Check resource exists
+    let resourceRole: EffectiveRole;
+    if (resourceType === 'folder') {
+      const folder = store.folders.get(resourceId);
+      if (!folder) {
+        res.status(404).json({ error: 'Resource not found' });
+        return;
+      }
+      resourceRole = getFolderEffectiveRole(store, resourceId, userId);
+    } else {
+      const document = store.documents.get(resourceId);
+      if (!document) {
+        res.status(404).json({ error: 'Resource not found' });
+        return;
+      }
+      resourceRole = getDocumentEffectiveRole(store, resourceId, userId);
+    }
+
+    // Check user has permission to share
+    if (resourceRole === 'none' || resourceRole === 'viewer') {
+      res.status(403).json({ error: 'No permission to share this resource' });
+      return;
+    }
+
+    // Find target user
+    const targetUser = findUserByUsername(store, username);
+    if (!targetUser) {
+      res.status(404).json({ error: 'User not found' });
+      return;
+    }
+
+    // Check if share already exists
+    const existingShare = findShare(store, resourceId, resourceType as 'folder' | 'document', targetUser.id);
+    if (existingShare) {
+      // Update the existing share
+      existingShare.role = role as Role;
+      addLog(store, 'share_updated', userId, resourceId, resourceType as 'folder' | 'document');
+      res.json(existingShare);
+      return;
+    }
+
+    const share: Share = {
+      id: nextId(store),
+      resourceId,
+      resourceType: resourceType as 'folder' | 'document',
+      userId: targetUser.id,
+      role: role as Role,
+      grantedBy: userId,
+    };
+    store.shares.set(share.id, share);
+    addLog(store, 'share_granted', userId, resourceId, resourceType as 'folder' | 'document');
+    res.status(201).json(share);
+  });
+
+  // DELETE /share/:shareId
+  app.delete('/share/:shareId', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const share = store.shares.get(req.params.shareId);
+    if (!share) {
+      res.status(404).json({ error: 'Share not found' });
+      return;
+    }
+
+    // Check if user has permission to manage shares
+    let canManage = false;
+    if (share.resourceType === 'folder') {
+      const folder = store.folders.get(share.resourceId);
+      if (folder) {
+        canManage = folder.ownerId === userId || getFolderEffectiveRole(store, share.resourceId, userId) === 'editor';
+      }
+    } else {
+      const document = store.documents.get(share.resourceId);
+      if (document) {
+        canManage = document.ownerId === userId || getDocumentEffectiveRole(store, share.resourceId, userId) === 'editor';
+      }
+    }
+
+    if (!canManage) {
+      res.status(403).json({ error: 'No permission to manage shares on this resource' });
+      return;
+    }
+
+    store.shares.delete(share.id);
+    addLog(store, 'share_revoked', userId, share.resourceId, share.resourceType);
+    res.status(204).send();
+  });
+
+  // ==================== Activity Log Routes ====================
+
+  // GET /activity
+  app.get('/activity', authMiddleware, (req: Request, res: Response) => {
+    const store = getStore();
+    const userId = (req as AuthRequest).userId;
+    const user = getUserById(store, userId);
+    if (!user) {
+      res.status(404).json({ error: 'User not found' });
+      return;
+    }
+
+    const userIdFilter = req.query.userId as string | undefined;
+    const resourceIdFilter = req.query.resourceId as string | undefined;
+
+    const logs = getActivityLogs(store, userIdFilter || userId, resourceIdFilter);
+    res.json(logs);
+  });
+
+  return app;
+}
+
+export default createApp;
