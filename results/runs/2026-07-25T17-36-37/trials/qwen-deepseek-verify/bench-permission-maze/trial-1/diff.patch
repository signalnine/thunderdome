s.status).toBe(200);\n      // Bob cannot modify any level (viewer)\n      const putRes = await request(app).put(`/folders/${level2.body.id}`).set('Authorization', `Bearer ${bobToken}`).send({ name: 'Changed' });\n      expect(putRes.status).toBe(403);\n    });\n\n    it('document in nested folder is accessible via ancestor share', async () => {\n      const root = await createFolder(app, aliceToken, 'Root');\n      const child = await createFolder(app, aliceToken, 'Child', root.body.id);\n      const doc = await createDocument(app, aliceToken, 'Deep Doc', 'Content', child.body.id);\n      await shareResource(app, aliceToken, root.body.id, 'folder', 'bob', 'viewer');\n      const res = await request(app).get(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${bobToken}`);\n      expect(res.status).toBe(200);\n    });\n\n    it('cascade delete removes all nested resources and shares', async () => {\n      const root = await createFolder(app, aliceToken, 'Root');\n      const child = await createFolder(app, aliceToken, 'Child', root.body.id);\n      const doc = await createDocument(app, aliceToken, 'Doc', 'Content', child.body.id);\n      await shareResource(app, aliceToken, root.body.id, 'folder', 'bob', 'viewer');\n      // Delete root\n      await request(app).delete(`/folders/${root.body.id}`).set('Authorization', `Bearer ${aliceToken}`);\n      // Everything should be gone\n      const rootRes = await request(app).get(`/folders/${root.body.id}`).set('Authorization', `Bearer ${aliceToken}`);\n      expect(rootRes.status).toBe(404);\n      const childRes = await request(app).get(`/folders/${child.body.id}`).set('Authorization', `Bearer ${aliceToken}`);\n      expect(childRes.status).toBe(404);\n      const docRes = await request(app).get(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${aliceToken}`);\n      expect(docRes.status).toBe(404);\n    });\n\n    it('user can only see accessible resources', async () => {\n      const folder1 = await crea