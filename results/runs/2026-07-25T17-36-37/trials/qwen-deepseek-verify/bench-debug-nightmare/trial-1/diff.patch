+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_q27_344_0","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach } from 'vitest';\n2\timport { EventBus } from '../src/events/bus.js';\n3\timport { OrderRepository } from '../src/orders/repository.js';\n4\timport { OrderService } from '../src/orders/service.js';\n5\timport { InventoryRepository } from '../src/inventory/repository.js';\n6\timport { InventoryService } from '../src/inventory/service.js';\n7\timport { NotificationService } from '../src/notifications/service.js';\n8\timport { BillingService } from '../src/billing/service.js';\n9\t\n10\tdescribe('OrderService', () => {\n11\t  let bus: EventBus;\n12\t  let orderRepo: OrderRepository;\n13\t  let inventoryRepo: InventoryRepository;\n14\t  let inventoryService: InventoryService;\n15\t  let notifications: NotificationService;\n16\t  let billing: BillingService;\n17\t  let orderService: OrderService;\n18\t\n19\t  beforeEach(() => {\n20\t    bus = new EventBus();\n21\t    orderRepo = new OrderRepository();\n22\t    inventoryRepo = new InventoryRepository();\n23\t    inventoryService = new InventoryService(inventoryRepo, bus);\n24\t    notifications = new NotificationService();\n25\t    billing = new BillingService(bus, notifications);\n26\t\n27\t    inventoryService.registerHandlers();\n28\t    billing.registerHandlers();\n29\t\n30\t    orderService = new OrderService(orderRepo, bus, billing);\n31\t  });\n32\t\n33\t  it('creates an order and confirms it', async () => {\n34\t    inventoryService.setStock('SKU-1', 10);\n35\t    const order = await orderService.createOrder('O1', 'C1', [\n36\t      { productId: 'SKU-1', quantity: 2, unitPrice: 25 },\n37\t    ]);\n38\t    expect(order.status).toBe('confirmed');\n39\t    expect(order.total).toBe(55); // 50 + 10% tax\n40\t  });\n41\t\n42\t  it('reserves stock when order is created', async () => {\n43\t    inventoryService.setStock('SKU-1', 10);\n44\t    await orderService.c