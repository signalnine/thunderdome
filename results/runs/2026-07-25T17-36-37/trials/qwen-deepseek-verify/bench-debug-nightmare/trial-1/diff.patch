+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_ZVnQXfrFL21EtYiVFTP66343","type":"tool_result","content":"export type EventHandler = (data: unknown) => void | Promise<void>;\n\n// Module-level handler registry — shared across all EventBus instances\nconst globalHandlers: Map<string, EventHandler[]> = new Map();\n\nexport class EventBus {\n  on(event: string, handler: EventHandler): void {\n    const existing = globalHandlers.get(event) ?? [];\n    existing.push(handler);\n    globalHandlers.set(event, existing);\n  }\n\n  off(event: string, handler: EventHandler): void {\n    const existing = globalHandlers.get(event);\n    if (!existing) return;\n    globalHandlers.set(\n      event,\n      existing.filter((h) => h !== handler)\n    );\n  }\n\n  async emit(event: string, data: unknown): Promise<void> {\n    const handlers = globalHandlers.get(event) ?? [];\n    for (const handler of handlers) {\n      await handler(data);\n    }\n  }\n\n  clear(): void {\n    globalHandlers.clear();\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"2472f18c-5b72-46e2-b3ba-d40beceda4b2","uuid":"3ce8590b-e288-4cfd-bc6d-007e4e7b8009","timestamp":"2026-07-25T19:01:11.663Z","tool_use_result":{"stdout":"export type EventHandler = (data: unknown) => void | Promise<void>;\n\n// Module-level handler registry — shared across all EventBus instances\nconst globalHandlers: Map<string, EventHandler[]> = new Map();\n\nexport class EventBus {\n  on(event: string, handler: EventHandler): void {\n    const existing = globalHandlers.get(event) ?? [];\n    existing.push(handler);\n    globalHandlers.set(event, existing);\n  }\n\n  off(event: string, handler: EventHandler): void {\n    const existing = globalHandlers.get(event);\n    if (!existing) return;\n    globalHandlers.set(\n      event,\n      existing.filter((h) => h !== handler)\n    );\n  }\n\n  async emit(event: string, data: unknown): Promise<void> {\n    const handlers = globalHandlers.get(ev