n\n/**\n * Compute topological order of events based on prerequisites.\n * Events with no prerequisites come first.\n */\nfunction topologicalSort(events: Event[]): Event[] {\n  const eventMap = new Map<string, Event>();\n  for (const e of events) {\n    eventMap.set(e.id, e);\n  }\n\n  const inDegree = new Map<string, number>();\n  const dependents = new Map<string, string[]>();\n\n  for (const e of events) {\n    inDegree.set(e.id, (e.prerequisites ?? []).length);\n    for (const prereq of e.prerequisites ?? []) {\n      if (!dependents.has(prereq)) {\n        dependents.set(prereq, []);\n      }\n      dependents.get(prereq)!.push(e.id);\n    }\n  }\n\n  const queue: string[] = [];\n  for (const [id, deg] of inDegree) {\n    if (deg === 0) {\n      queue.push(id);\n    }\n  }\n\n  const result: Event[] = [];\n  while (queue.length > 0) {\n    const id = queue.shift()!;\n    result.push(eventMap.get(id)!);\n    for (const dep of dependents.get(id) ?? []) {\n      const newDeg = inDegree.get(dep)! - 1;\n      inDegree.set(dep, newDeg);\n      if (newDeg === 0) {\n        queue.push(dep);\n      }\n    }\n  }\n\n  return result;\n}\n\n/**\n * Find the earliest start time for an event in a given room,\n * considering existing assignments and prerequisite constraints.\n */\nfunction findEarliestStart(\n  event: Event,\n  room: Room,\n  assignments: Assignment[],\n  scheduledEndTimes: Map<string, number>,\n  gap: number,\n  startTime: number,\n  endTime: number\n): number | null {\n  const attendees = event.attendees ?? 1;\n  if (attendees > room.capacity) {\n    return null;\n  }\n\n  const duration = event.duration;\n  const eventEnd = startTime + duration;\n  if (eventEnd > endTime) {\n    return null;\n  }\n\n  // Collect all constraints on start time\n  let earliest = startTime;\n\n  // Prerequisite constraints: must start after all prerequisites end + gap\n  for (const prereqId of event.prerequisites ?? []) {\n    const prereqEnd = scheduledEndTimes.get(prereqId)