ptions);\n\n      expect(result.assignments).toHaveLength(1);\n      expect(result.assignments[0].roomId).toBe('r2');\n    });\n\n    it('does not violate constraints for preferred room', () => {\n      const rooms: Room[] = [\n        { id: 'r1', name: 'Room 1', capacity: 10 },\n        { id: 'r2', name: 'Room 2', capacity: 3 },\n      ];\n      const events: Event[] = [\n        { id: 'e1', name: 'Event 1', duration: 60, attendees: 5, preferredRoom: 'r2' },\n      ];\n\n      const result = schedule(events, rooms, defaultOptions);\n\n      expect(result.assignments).toHaveLength(1);\n      // r2 is too small, so it should go to r1\n      expect(result.assignments[0].roomId).toBe('r1');\n    });\n\n    it('honors preferred room when it does not conflict with other events', () => {\n      const events: Event[] = [\n        { id: 'e1', name: 'Event 1', duration: 60, preferredRoom: 'r1' },\n        { id: 'e2', name: 'Event 2', duration: 60, preferredRoom: 'r2' },\n      ];\n\n      const result = schedule(events, defaultRooms, defaultOptions);\n\n      expect(result.assignments).toHaveLength(2);\n\n      const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n      const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n\n      expect(a1.roomId).toBe('r1');\n      expect(a2.roomId).toBe('r2');\n    });\n  });\n\n  describe('unscheduled events', () => {\n    it('lists events that cannot be scheduled', () => {\n      const rooms: Room[] = [{ id: 'r1', name: 'Room 1', capacity: 10 }];\n      const options: ScheduleOptions = {\n        startTime: 540,\n        endTime: 600, // only 1 hour\n        gap: 15,\n      };\n      const events: Event[] = [\n        { id: 'e1', name: 'Event 1', duration: 30 },\n        { id: 'e2', name: 'Event 2', duration: 30 },\n        { id: 'e3', name: 'Event 3', duration: 30 },\n      ];\n\n      const result = schedule(events, rooms, options);\n\n      // e1: 540-570, e2: 585-615 (exceeds endTime), e3: can't fit\n      expect(result.assignments.length).toBeLessThan(3);\n      expect(result.unscheduled.length).toBeGreaterThan(0);\n    });\n\n    it('does not throw when some events cannot be scheduled', () => {\n      const rooms: Room[] = [\n        { id: 'r1', name: 'Room 1', capacity: 5 },\n      ];\n      const events: Event[] = [\n        { id: 'e1', name: 'Small Event', duration: 60, attendees: 3 },\n        { id: 'e2', name: 'Large Event', duration: 60, attendees: 100 },\n      ];\n\n      const result = schedule(events, rooms, defaultOptions);\n\n      expect(result.assignments).toHaveLength(1);\n      expect(result.unscheduled).toContain('e2');\n    });\n  });\n\n  describe('batch optimization', () => {\n    it('maximizes the number of scheduled events', () => {\n      const rooms: Room[] = [\n        { id: 'r1', name: 'Room 1', capacity: 10 },\n      ];\n      const options: ScheduleOptions = {\n        startTime: 540,\n        endTime: 720, // 3 hours\n        gap: 15,\n      };\n      const events: Event[] = [\n        { id: 'e1', name: 'Event 1', duration: 60 },\n        { id: 'e2', name: 'Event 2', duration: 60 },\n        { id: 'e3', name: 'Event 3', duration: 60 },\n        { id: 'e4', name: 'Event 4', duration: 60 },\n      ];\n\n      const result = schedule(events, rooms, options);\n\n      // 3 hours = 180 min; each event is 60 min + 15 min gap = 75 min per event\n      // 180 / 75 = 2.4, so at most 2 events fit with gaps, but 3 events: 60+15+60+15+60 = 210 > 180\n      // Actually: e1: 540-600, e2: 615-675, e3: 690-750 (exceeds 720)\n      // So only 2 events fit\n      expect(result.assignments.length).toBeGreaterThanOrEqual(2);\n    });\n\n    it('schedules events with prerequisites before independent events when needed', () => {\n      const rooms: Room[] = [\n        { id: 'r1', name: 'Room 1', capacity: 10 },\n      ];\n      const events: Event[] = [\n        { id: 'e1', name: 'Prereq', duration: 30 },\n        { id: 'e2', name: 'Dependent', duration: 30, prerequi