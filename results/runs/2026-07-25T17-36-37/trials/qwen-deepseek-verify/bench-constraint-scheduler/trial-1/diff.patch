+import { Event, Room, ScheduleOptions, Assignment, ScheduleResult } from './types.js';
+
+/**
+ * Detect cycles in the prerequisite graph using DFS.
+ * Throws if a cycle is found.
+ */
+function detectCycle(events: Event[]): void {
+  const eventMap = new Map<string, Event>();
+  for (const e of events) {
+    eventMap.set(e.id, e);
+  }
+
+  const WHITE = 0;
+  const GRAY = 1;
+  const BLACK = 2;
+  const color = new Map<string, number>();
+
+  for (const e of events) {
+    color.set(e.id, WHITE);
+  }
+
+  const dfs = (id: string): boolean => {
+    color.set(id, GRAY);
+    const event = eventMap.get(id);
+    if (!event) return false;
+    for (const prereq of event.prerequisites ?? []) {
+      if (prereq === id) {
+        throw new Error(`Prerequisite cycle detected: ${id} depends on itself`);
+      }
+      const c = color.get(prereq);
+      if (c === GRAY) {
+        throw new Error(`Prerequisite cycle detected involving ${id} and ${prereq}`);
+      }
+      if (c === WHITE) {
+        if (dfs(prereq)) {
+          throw new Error(`Prerequisite cycle detected involving ${id} and ${prereq}`);
+        }
+      }
+    }
+    color.set(id, BLACK);
+    return false;
+  };
+
+  for (const e of events) {
+    if (color.get(e.id) === WHITE) {
+      dfs(e.id);
+    }
+  }
+}
+
+/**
+ * Compute topological order of events based on prerequisites.
+ * Events with no prerequisites come first.
+ */
+function topologicalSort(events: Event[]): Event[] {
+  const eventMap = new Map<string, Event>();
+  for (const e of events) {
+    eventMap.set(e.id, e);
+  }
+
+  const inDegree = new Map<string, number>();
+  const dependents = new Map<string, string[]>();
+
+  for (const e of events) {
+    inDegree.set(e.id, (e.prerequisites ?? []).length);
+    for (const prereq of e.prerequisites ?? []) {
+      if (!dependents.has(prereq)) {
+        dependents.set(prereq, []);
+      }
+      dependents.get(prereq)!.push(e.id);
+    }
+  }
+
+  const queue: string[] = [];
+  for (const [id, deg] of inDegree) {
+    if (deg === 0) {
+      queue.push(id);
+    }
+  }
+
+  const result: Event[] = [];
+  while (queue.length > 0) {
+    const id = queue.shift()!;
+    result.push(eventMap.get(id)!);
+    for (const dep of dependents.get(id) ?? []) {
+      const newDeg = inDegree.get(dep)! - 1;
+      inDegree.set(dep, newDeg);
+      if (newDeg === 0) {
+        queue.push(dep);
+      }
+    }
+  }
+
+  return result;
+}
+
+/**
+ * Find the earliest start time for an event in a given room,
+ * considering existing assignments and prerequisite constraints.
+ */
+function findEarliestStart(
+  event: Event,
+  room: Room,
+  assignments: Assignment[],
+  scheduledEndTimes: Map<string, number>,
+  gap: number,
+  startTime: number,
+  endTime: number
+): number | null {
+  const attendees = event.attendees ?? 1;
+  if (attendees > room.capacity) {
+    return null;
+  }
+
+  const duration = event.duration;
+  const eventEnd = startTime + duration;
+  if (eventEnd > endTime) {
+    return null;
+  }
+
+  // Collect all constraints on start time
+  let earliest = startTime;
+
+  // Prerequisite constraints: must start after all prerequisites end + gap
+  for (const prereqId of event.prerequisites ?? []) {
+    const prereqEnd = scheduledEndTimes.get(prereqId);
+    if (prereqEnd === undefined) {
+      // Prerequisite not yet scheduled — can't schedule this event
+      return null;
+    }
+    const prereqConstraint = prereqEnd + gap;
+    if (prereqConstraint > earliest) {
+      earliest = prereqConstraint;
+    }
+  }
+
+  // Room conflict constraints: must not overlap with existing assignments in this room
+  const roomAssignments = assignments.filter(a => a.roomId === room.id);
+  for (const a of roomAssignments) {
+    // This event must either end before the existing event starts (with gap)
+    // or start after the existing event ends (with gap)
+    const existingEnd = a.endTime;
+    const existingStart = a.startTime;
+
+    // If earliest is before this event starts, check if we can fit before it
+    if (earliest + duration <= existingStart - gap) {
+      // Can fit before this event — no constraint from this assignment
+      continue;
+    }
+
+    // Must start after this event ends + gap
+    const afterConstraint = existingEnd + gap;
+    if (afterConstraint > earliest) {
+      earliest = afterConstraint;
+    }
+  }
+
+  // Check if the event fits within the time window
+  if (earliest + duration > endTime) {
+    return null;
+  }
+
+  return earliest;
+}
+
+/**
+ * Score a room for an event — preferred room gets priority.
+ * Among valid rooms, prefer smaller rooms (tighter fit) to save large rooms.
+ */
+function scoreRoom(
+  event: Event,
+  room: Room,
+  attendees: number
+): number {
+  if (attendees > room.capacity) {
+    return -Infinity; // invalid
+  }
+
+  let score = 0;
+
+  // Preferred room gets a large bonus
+  if (event.preferredRoom === room.id) {
+    score += 10000;
+  }
+
+  // Prefer tighter fit (smaller room that still fits)
+  score -= room.capacity;
+
+  return score;
+}
+
+/**
+ * Main scheduling function.
+ * Uses a constraint-aware greedy approach:
+ * 1. Detect cycles in prerequisites
+ * 2. Topologically sort events
+ * 3. For each event, find the best room and earliest slot
+ * 4. Events that can't be placed go to unscheduled
+ */
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions
+): ScheduleResult {
+  const gap = options.gap ?? 15;
+
+  // Step 1: Detect prerequisite cycles
+  detectCycle(events);
+
+  // Step 2: Topological sort
+  const sorted = topologicalSort(events);
+
+  // Identify events with missing prerequisites (prereq references nonexistent event)
+  const eventIds = new Set(events.map(e => e.id));
+  const missingPrereqEvents = new Set<string>();
+  for (const e of events) {
+    for (const prereq of e.prerequisites ?? []) {
+      if (!eventIds.has(prereq)) {
+        missingPrereqEvents.add(e.id);
+      }
+    }
+  }
+
+  // Step 3: Process events in topological order so prerequisites are scheduled first.
+  // Within each topological level, sort by constraint tightness for optimization.
+  const eventMap = new Map<string, Event>();
+  for (const e of events) {
+    eventMap.set(e.id, e);
+  }
+
+  // Compute topological levels (depth from root)
+  const levels = new Map<string, number>();
+  for (const e of sorted) {
+    if (missingPrereqEvents.has(e.id)) continue;
+    const prereqs = e.prerequisites ?? [];
+    if (prereqs.length === 0) {
+      levels.set(e.id, 0);
+    } else {
+      levels.set(e.id, Math.max(...prereqs.map(p => levels.get(p) ?? 0)) + 1);
+    }
+  }
+
+  // Group by level
+  const levelGroups = new Map<number, Event[]>();
+  for (const e of sorted) {
+    const level = levels.get(e.id)!;
+    if (!levelGroups.has(level)) {
+      levelGroups.set(level, []);
+    }
+    levelGroups.get(level)!.push(e);
+  }
+
+  // Sort within each level by constraint tightness
+  const sortedByConstraint: Event[] = [];
+  for (const [, group] of [...levelGroups.entries()].sort((a, b) => a[0] - b[0])) {
+    const sortedGroup = [...group].sort((a, b) => {
+      // Fewer valid rooms = more constrained
+      const aAttendees = a.attendees ?? 1;
+      const bAttendees = b.attendees ?? 1;
+      const aValidRooms = rooms.filter(r => r.capacity >= aAttendees).length;
+      const bValidRooms = rooms.filter(r => r.capacity >= bAttendees).length;
+      if (aValidRooms !== bValidRooms) return aValidRooms - bValidRooms;
+
+      // Longer duration = harder to fit
+      if (a.duration !== b.duration) return b.duration - a.duration;
+
+      return 0;
+    });
+    sortedByConstraint.push(...sortedGroup);
+  }
+
+  const assignments: Assignment[] = [];
+  const scheduledEndTimes = new Map<string, number>();
+  const unscheduled: string[] = [];
+
+  // Events with missing prerequisites cannot be scheduled
+  for (const id of missingPrereqEvents) {
+    unscheduled.push(id);
+  }
+
+  // Step 4: Schedule each event
+  for (const event of sortedByConstraint) {
+    // Skip events with missing prerequisites (already added to unscheduled)
+    if (missingPrereqEvents.has(event.id)) continue;
+
+    const attendees = event.attendees ?? 1;
+
+    // Find valid rooms sorted by score
+    const validRooms = rooms
+      .map(r => ({ room: r, score: scoreRoom(event, r, attendees) }))
+      .filter(r => r.score > -Infinity)
+      .sort((a, b) => b.score - a.score);
+
+    if (validRooms.length === 0) {
+      unscheduled.push(event.id);
+      continue;
+    }
+
+    // Try each room, find the earliest start time
+    let bestStart: number | null = null;
+    let bestRoom: Room | null = null;
+    let bestScore = -Infinity;
+
+    for (const { room, score } of validRooms) {
+      const start = findEarliestStart(
+        event,
+        room,
+        assignments,
+        scheduledEndTimes,
+        gap,
+        options.startTime,
+        options.endTime
+      );
+
+      if (start === null) continue;
+
+      // Prefer earlier start times; among same start, prefer higher room score
+      if (
+        bestStart === null ||
+        start < bestStart ||
+        (start === bestStart && score > bestScore)
+      ) {
+        bestStart = start;
+        bestRoom = room;
+        bestScore = score;
+      }
+    }
+
+    if (bestStart === null || bestRoom === null) {
+      unscheduled.push(event.id);
+      continue;
+    }
+
+    const assignment: Assignment = {
+      eventId: event.id,
+      roomId: bestRoom.id,
+      startTime: bestStart,
+      endTime: bestStart + event.duration,
+    };
+
+    assignments.push(assignment);
+    scheduledEndTimes.set(event.id, assignment.endTime);
+  }
+
+  return { assignments, unscheduled };
+}
