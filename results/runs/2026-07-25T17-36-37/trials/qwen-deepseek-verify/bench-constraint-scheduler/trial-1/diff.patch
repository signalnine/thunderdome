est slot\n * 4. Events that can't be placed go to unscheduled\n */\nexport function schedule(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions\n): ScheduleResult {\n  const gap = options.gap ?? 15;\n\n  // Step 1: Detect prerequisite cycles\n  detectCycle(events);\n\n  // Step 2: Topological sort\n  const sorted = topologicalSort(events);\n\n  // Identify events with missing prerequisites (prereq references nonexistent event)\n  const eventIds = new Set(events.map(e => e.id));\n  const missingPrereqEvents = new Set<string>();\n  for (const e of events) {\n    for (const prereq of e.prerequisites ?? []) {\n      if (!eventIds.has(prereq)) {\n        missingPrereqEvents.add(e.id);\n      }\n    }\n  }\n\n  // Step 3: Process events in topological order so prerequisites are scheduled first.\n  // Within each topological level, sort by constraint tightness for optimization.\n  const eventMap = new Map<string, Event>();\n  for (const e of events) {\n    eventMap.set(e.id, e);\n  }\n\n  // Compute topological levels (depth from root)\n  const levels = new Map<string, number>();\n  for (const e of sorted) {\n    if (missingPrereqEvents.has(e.id)) continue;\n    const prereqs = e.prerequisites ?? [];\n    if (prereqs.length === 0) {\n      levels.set(e.id, 0);\n    } else {\n      levels.set(e.id, Math.max(...prereqs.map(p => levels.get(p) ?? 0)) + 1);\n    }\n  }\n\n  // Group by level\n  const levelGroups = new Map<number, Event[]>();\n  for (const e of sorted) {\n    const level = levels.get(e.id)!;\n    if (!levelGroups.has(level)) {\n      levelGroups.set(level, []);\n    }\n    levelGroups.get(level)!.push(e);\n  }\n\n  // Sort within each level by constraint tightness\n  const sortedByConstraint: Event[] = [];\n  for (const [_level, group] of [...levelGroups.entries()].sort((a, b) => a[0] - b[0])) {\n    const sortedGroup = [...group].sort((a, b) => {\n      // Fewer valid rooms = more constrained\n      const aAttendees = a.attendees ?? 1;\n      const bAttendees = b.attendees ?? 1;\n      const aValidRooms = rooms.filter(r => r.capacity >= aAttendees).length;\n      const bValidRooms = rooms.filter(r => r.capacity >= bAttendees).length;\n      if (aValidRooms !== bValidRooms) return aValidRooms - bValidRooms;\n\n      // Longer duration = harder to fit\n      if (a.duration !== b.duration) return b.duration - a.duration;\n\n      return 0;\n    });\n    sortedByConstraint.push(...sortedGroup);\n  }\n\n  const assignments: Assignment[] = [];\n  const scheduledEndTimes = new Map<string, number>();\n  const unscheduled: string[] = [];\n\n  // Events with missing prerequisites cannot be scheduled\n  for (const id of missingPrereqEvents) {\n    unscheduled.push(id);\n  }\n\n  // Step 4: Schedule each event\n  for (const event of sortedByConstraint) {\n    // Skip events with missing prerequisites (already added to unscheduled)\n    if (missingPrereqEvents.has(event.id)) continue;\n\n    const attendees = event.attendees ?? 1;\n\n    // Find valid rooms sorted by score\n    const validRooms = rooms\n      .map(r => ({ room: r, score: scoreRoom(event, r, attendees) }))\n      .filter(r => r.score > -Infinity)\n      .sort((a, b) => b.score - a.score);\n\n    if (validRooms.length === 0) {\n      unscheduled.push(event.id);\n      continue;\n    }\n\n    // Try each room, find the earliest start time\n    let bestStart: number | null = null;\n    let bestRoom: Room | null = null;\n    let bestScore = -Infinity;\n\n    for (const { room, score } of validRooms) {\n      const start = findEarliestStart(\n        event,\n        room,\n        assignments,\n        scheduledEndTimes,\n        gap,\n        options.startTime,\n        options.endTime\n      );\n\n      if (start === null) continue;\n\n      // Prefer earlier start times; among same start, prefer higher room score\n      if (\n        bestStart === null ||\n        start < bestStart ||\n        (start === bestStart && score > bestScore)\n      ) {\n       