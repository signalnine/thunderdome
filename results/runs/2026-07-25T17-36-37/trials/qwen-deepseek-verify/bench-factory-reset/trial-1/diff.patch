+    for (let r = 0; r < n; r++) {
+      if (r !== row && aug[r][col] !== 0) {
+        const factor = aug[r][col];
+        for (let c = 0; c <= m; c++) {
+          aug[r][c] = (aug[r][c] - factor * aug[row][c]) % modulus;
+          if (aug[r][c] < 0) aug[r][c] += modulus;
+        }
+      }
+    }
+
+    pivotCol[row] = col;
+    pivotRow[col] = row;
+    row++;
+  }
+
+  // Check consistency
+  for (let r = row; r < n; r++) {
+    if (aug[r][m] !== 0) {
+      return null;
+    }
+  }
+
+  // Identify pivot and free columns
+  const pivotCols = new Set<number>();
+  for (let r = 0; r < row; r++) {
+    if (pivotCol[r] !== -1) {
+      pivotCols.add(pivotCol[r]);
+    }
+  }
+
+  const freeCols: number[] = [];
+  for (let c = 0; c < m; c++) {
+    if (!pivotCols.has(c)) {
+      freeCols.push(c);
+    }
+  }
+
+  const k = freeCols.length;
+
+  // Extract particular solution (free variables = 0)
+  const particular = new Array(m).fill(0);
+  for (let r = 0; r < row; r++) {
+    const pc = pivotCol[r];
+    if (pc !== -1) {
+      particular[pc] = aug[r][m];
+    }
+  }
+
+  // Extract null space basis vectors
+  const nullBasis: number[][] = [];
+  for (const fc of freeCols) {
+    const vec = new Array(m).fill(0);
+    vec[fc] = 1;
+    for (let r = 0; r < row; r++) {
+      const pc = pivotCol[r];
+      if (pc !== -1 && aug[r][fc] !== 0) {
+        vec[pc] = (modulus - aug[r][fc]) % modulus;
+      }
+    }
+    nullBasis.push(vec);
+  }
+
+  // Enumerate all combinations of null space vectors
+  // For each free variable, it can take values 0..modulus-1
+  // Total combinations: modulus^k
+  //
+  // For small k, enumerate with incremental updates.
+  // For larger k, use a two-phase approach:
+  //   Phase 1: find the minimum sum by optimizing pivot sums first
+  //   Phase 2: among solutions with that sum, find lexicographically smallest
+
+  const maxEnum = 50_000_000;
+  const totalCombinations = Math.pow(modulus, k);
+
+  if (totalCombinations <= maxEnum) {
+    // Enumerate with incremental updates
+    let best: number[] | null = null;
+    let bestSum = Infinity;
+
+    // Start with candidate = particular (t = [0, 0, ..., 0])
+    const candidate = [...particular];
+    const t = new Array(k).fill(0);
+
+    let done = false;
+    while (!done) {
+      const sum = candidate.reduce((s, v) => s + v, 0);
+
+      if (sum < bestSum) {
+        bestSum = sum;
+        best = candidate.slice();
+      } else if (sum === bestSum && best !== null) {
+        // Lexicographic comparison
+        let dominated = false;
+        for (let j = 0; j < m; j++) {
+          if (candidate[j] < best[j]) {
+            dominated = true;
+            break;
+          }
+          if (candidate[j] > best[j]) {
+            break;
+          }
+        }
+        if (dominated) {
+          best = candidate.slice();
+        }
+      }
+
+      // Increment t (like a counter in base modulus) with incremental candidate update
+      let carry = true;
+      for (let i = k - 1; i >= 0 && carry; i--) {
+        t[i]++;
+        if (t[i] >= modulus) {
+          t[i] = 0;
+          // When t[i] wraps from modulus-1 to 0, the contribution changes by
+          // -(modulus-1)*nullBasis[i] ≡ +nullBasis[i] (mod modulus).
+          for (let j = 0; j < m; j++) {
+            candidate[j] = (candidate[j] + nullBasis[i][j]) % modulus;
+          }
+        } else {
+          // candidate += nullBasis[i] (mod modulus)
+          for (let j = 0; j < m; j++) {
+            candidate[j] = (candidate[j] + nullBasis[i][j]) % modulus;
+          }
+          carry = false;
+        }
+      }
+      if (carry) { done = true; break; }
+    }
+
+    return best;
+  }
+
+  // For large k, use a two-phase approach
+  // Phase 1: For each pivot row r, the optimal s_r = particular[pivotCol[r]] (mod modulus)
+  // This makes all pivot positions 0.
+  // Solve: sum_i (t_i * aug[r][freeCols[i]]) = particular[pivotCol[r]] (mod modulus)
+  // for each pivot row r.
+  // Phase 2: Among solutions that achieve the optimal pivot sums,
+  // minimize the free positions and find lexicographically smallest.
+
+  // Build the constraint system: C * t = b (mod modulus)
+  // C is rank x k, b is rank-dimensional
+  const rank = row;
+  const C: number[][] = [];
+  const cTarget: number[] = [];
+  for (let r = 0; r < rank; r++) {
+    const pc = pivotCol[r];
+    if (pc === -1) continue;
+    const rowC: number[] = [];
+    for (let i = 0; i < k; i++) {
+      rowC.push(aug[r][freeCols[i]]);
+    }
+    C.push(rowC);
+    cTarget.push(aug[r][m]); // particular[pivotCol[r]] = aug[r][m]
+  }
+
+  // Solve C * t = cTarget (mod modulus) using Gaussian elimination
+  // This is a system of rank equations in k variables
+  const augC: number[][] = C.map((row, i) => [...row, cTarget[i]]);
+  const pivotColC = new Array(rank).fill(-1);
+  let rowC = 0;
+
+  for (let col = 0; col < k && rowC < rank; col++) {
+    let pivot = -1;
+    for (let r = rowC; r < rank; r++) {
+      if (augC[r][col] !== 0) {
+        pivot = r;
+        break;
+      }
+    }
+    if (pivot === -1) continue;
+
+    [augC[rowC], augC[pivot]] = [augC[pivot], augC[rowC]];
+
+    const inv = modInverse(augC[rowC][col]);
+    for (let c = 0; c <= k; c++) {
+      augC[rowC][c] = (augC[rowC][c] * inv) % modulus;
+    }
+
+    for (let r = 0; r < rank; r++) {
+      if (r !== rowC && augC[r][col] !== 0) {
+        const factor = augC[r][col];
+        for (let c = 0; c <= k; c++) {
+          augC[r][c] = (augC[r][c] - factor * augC[rowC][c]) % modulus;
+          if (augC[r][c] < 0) augC[r][c] += modulus;
+        }
+      }
+    }
+
+    pivotColC[rowC] = col;
+    rowC++;
+  }
+
+  // Check consistency
+  let consistent = true;
+  for (let r = rowC; r < rank; r++) {
+    if (augC[r][k] !== 0) {
+      consistent = false;
+      break;
+    }
+  }
+
+  if (consistent) {
+    // System is consistent. Find the solution that minimizes the free positions.
+    // The pivot positions will all be 0.
+    // For the free positions: x[freeCols[i]] = (particular[freeCols[i]] + t_i) % modulus
+    // We want t_i = (modulus - particular[freeCols[i]]) % modulus for each i.
+    // But this must satisfy C * t = cTarget.
+
+    // Identify pivot and free columns in the constraint system
+    const pivotColsC = new Set<number>();
+    for (let r = 0; r < rowC; r++) {
+      if (pivotColC[r] !== -1) {
+        pivotColsC.add(pivotColC[r]);
+      }
+    }
+
+    const freeColsC: number[] = [];
+    for (let c = 0; c < k; c++) {
+      if (!pivotColsC.has(c)) {
+        freeColsC.push(c);
+      }
+    }
+
+    const k2 = freeColsC.length; // dimension of null space of C
+
+    // Extract particular solution for C * t = cTarget (set free variables to 0)
+    const tParticular = new Array(k).fill(0);
+    for (let r = 0; r < rowC; r++) {
+      const pc = pivotColC[r];
+      if (pc !== -1) {
+        tParticular[pc] = augC[r][k];
+      }
+    }
+
+    // Extract null space of C
+    const nullBasisC: number[][] = [];
+    for (const fc of freeColsC) {
+      const vec = new Array(k).fill(0);
+      vec[fc] = 1;
+      for (let r = 0; r < rowC; r++) {
+        const pc = pivotColC[r];
+        if (pc !== -1 && augC[r][fc] !== 0) {
+          vec[pc] = (modulus - augC[r][fc]) % modulus;
+        }
+      }
+      nullBasisC.push(vec);
+    }
+
+    // Now enumerate over the null space of C
+    // General solution: t = tParticular + sum(z[i] * nullBasisC[i])
+    // where z[i] in [0, modulus-1]
+    // Total combinations: modulus^k2
+
+    const totalC = Math.pow(modulus, k2);
+
+    if (totalC <= maxEnum) {
+      // Enumerate
+      let best: number[] | null = null;
+      let bestSum = Infinity;
+
+      const z = new Array(k2).fill(0);
+      const t = [...tParticular];
+
+      let done = false;
+      while (!done) {
+        // Compute candidate from t
+        const candidate = new Array(m).fill(0);
+        for (let j = 0; j < m; j++) {
+          candidate[j] = particular[j];
+        }
+        for (let i = 0; i < k; i++) {
+          if (t[i] > 0) {
+            for (let j = 0; j < m; j++) {
+              candidate[j] = (candidate[j] + t[i] * nullBasis[i][j]) % modulus;
+            }
+          }
+        }
+
+        const sum = candidate.reduce((s, v) => s + v, 0);
+
+        if (sum < bestSum) {
+          bestSum = sum;
+          best = candidate;
+        } else if (sum === bestSum && best !== null) {
+          let dominated = false;
+          for (let j = 0; j < m; j++) {
+            if (candidate[j] < best[j]) {
+              dominated = true;
+              break;
+            }
+            if (candidate[j] > best[j]) {
+              break;
+            }
+          }
+          if (dominated) {
+            best = candidate;
+          }
+        }
+
+        // Increment z
+        let carry = true;
+        for (let i = k2 - 1; i >= 0 && carry; i--) {
+          z[i]++;
+          if (z[i] >= modulus) {
+            z[i] = 0;
+          } else {
+            carry = false;
+          }
+        }
+        if (carry) { done = true; break; }
+
+        // Update t: t = tParticular + sum(z[i] * nullBasisC[i])
+        for (let j = 0; j < k; j++) {
+          t[j] = tParticular[j];
+        }
+        for (let i = 0; i < k2; i++) {
+          if (z[i] > 0) {
+            for (let j = 0; j < k; j++) {
+              t[j] = (t[j] + z[i] * nullBasisC[i][j]) % modulus;
+            }
+          }
+        }
+      }
+
+      return best;
+    }
+
+    // If k2 is still too large, use the particular solution
+    // This gives a valid solution but may not be optimal
+    const candidate = new Array(m).fill(0);
+    for (let j = 0; j < m; j++) {
+      candidate[j] = particular[j];
+    }
+    for (let i = 0; i < k; i++) {
+      if (tParticular[i] > 0) {
+        for (let j = 0; j < m; j++) {
+          candidate[j] = (candidate[j] + tParticular[i] * nullBasis[i][j]) % modulus;
+        }
+      }
+    }
+    return candidate;
+  }
+
+  // System is inconsistent — can't make all pivot positions 0
+  // Fall back to enumeration if feasible, otherwise use greedy
+  // This case is rare in practice
+
+  // Try enumeration with the full null space
+  let best: number[] | null = null;
+  let bestSum = Infinity;
+
+  const t = new Array(k).fill(0);
+  const candidate = [...particular];
+
+  let done = false;
+  while (!done) {
+    const sum = candidate.reduce((s, v) => s + v, 0);
+
+    if (sum < bestSum) {
+      bestSum = sum;
+      best = candidate.slice();
+    } else if (sum === bestSum && best !== null) {
+      let dominated = false;
+      for (let j = 0; j < m; j++) {
+        if (candidate[j] < best[j]) {
+          dominated = true;
+          break;
+        }
+        if (candidate[j] > best[j]) {
+          break;
+        }
+      }
+      if (dominated) {
+        best = candidate.slice();
+      }
+    }
+
+    let carry = true;
+    for (let i = k - 1; i >= 0 && carry; i--) {
+      t[i]++;
+      if (t[i] >= modulus) {
+        t[i] = 0;
+        // When t[i] wraps from modulus-1 to 0, the contribution changes by
+        // -(modulus-1)*nullBasis[i] ≡ +nullBasis[i] (mod modulus).
+        for (let j = 0; j < m; j++) {
+          candidate[j] = (candidate[j] + nullBasis[i][j]) % modulus;
+        }
+      } else {
+        for (let j = 0; j < m; j++) {
+          candidate[j] = (candidate[j] + nullBasis[i][j]) % modulus;
+        }
+        carry = false;
+      }
+    }
+    if (carry) { done = true; break; }
+  }
+
+  return best;
+}
