+// Factory Reset: Button-toggle and Counter puzzles
+
+// ─── Part 1: Toggle Puzzle ───────────────────────────────────────────────────
+
+interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+/**
+ * Solve the toggle puzzle.
+ *
+ * This is a system of linear equations over GF(2).
+ * - N lights (variables: which lights to toggle)
+ * - M buttons (each button toggles a subset of lights)
+ * - Each button pressed 0 or 1 time
+ * - Find minimum number of button presses to reach target
+ *
+ * Approach:
+ * 1. Build augmented matrix [A | b] over GF(2)
+ * 2. Gaussian elimination to find a particular solution + null space
+ * 3. Enumerate null space combinations (2^k where k = null space dimension)
+ * 4. Pick the solution with minimum Hamming weight, then lexicographically smallest
+ */
+function solveToggle(machine: Machine): number[] | null {
+  const n = machine.target.length; // number of lights
+  const m = machine.buttons.length; // number of buttons
+
+  // Build matrix: n rows (lights), m columns (buttons)
+  // A[i][j] = 1 if button j toggles light i
+  const A: number[][] = [];
+  for (let i = 0; i < n; i++) {
+    const row = new Array(m).fill(0);
+    A.push(row);
+  }
+  for (let j = 0; j < m; j++) {
+    for (const light of machine.buttons[j]) {
+      A[light][j] = 1;
+    }
+  }
+
+  // Target vector b
+  const b: number[] = machine.target.map(v => (v ? 1 : 0));
+
+  // Augmented matrix: n rows, m+1 columns (last column is b)
+  const aug: number[][] = A.map((row, i) => [...row, b[i]]);
+
+  // Gaussian elimination over GF(2)
+  const pivotCol = new Array(n).fill(-1); // pivotCol[row] = column of pivot
+  const pivotRow = new Array(m).fill(-1); // pivotRow[col] = row that has pivot in this col
+  let row = 0;
+
+  for (let col = 0; col < m && row < n; col++) {
+    // Find pivot
+    let pivot = -1;
+    for (let r = row; r < n; r++) {
+      if (aug[r][col] === 1) {
+        pivot = r;
+        break;
+      }
+    }
+    if (pivot === -1) continue;
+
+    // Swap rows
+    [aug[row], aug[pivot]] = [aug[pivot], aug[row]];
+
+    // Eliminate
+    for (let r = 0; r < n; r++) {
+      if (r !== row && aug[r][col] === 1) {
+        for (let c = 0; c <= m; c++) {
+          aug[r][c] ^= aug[row][c];
+        }
+      }
+    }
+
+    pivotCol[row] = col;
+    pivotRow[col] = row;
+    row++;
+  }
+
+  // Check consistency: any row with all-zero LHS but nonzero RHS?
+  for (let r = row; r < n; r++) {
+    if (aug[r][m] === 1) {
+      return null; // inconsistent
+    }
+  }
+
+  // Identify pivot columns and free columns
+  const pivotCols = new Set<number>();
+  for (let r = 0; r < row; r++) {
+    if (pivotCol[r] !== -1) {
+      pivotCols.add(pivotCol[r]);
+    }
+  }
+
+  const freeCols: number[] = [];
+  for (let c = 0; c < m; c++) {
+    if (!pivotCols.has(c)) {
+      freeCols.push(c);
+    }
+  }
+
+  const k = freeCols.length; // null space dimension
+
+  // Extract particular solution (set all free variables to 0)
+  const particular = new Array(m).fill(0);
+  for (let r = 0; r < row; r++) {
+    const pc = pivotCol[r];
+    if (pc !== -1) {
+      particular[pc] = aug[r][m];
+    }
+  }
+
+  // Extract null space basis vectors
+  // For each free variable, set it to 1 and solve for pivot variables
+  const nullBasis: number[][] = [];
+  for (const fc of freeCols) {
+    const vec = new Array(m).fill(0);
+    vec[fc] = 1;
+    // For each pivot row, if the free column has a 1, the pivot variable = 1
+    for (let r = 0; r < row; r++) {
+      const pc = pivotCol[r];
+      if (pc !== -1 && aug[r][fc] === 1) {
+        vec[pc] = 1;
+      }
+    }
+    nullBasis.push(vec);
+  }
+
+  // Enumerate all 2^k combinations of null space vectors
+  // For each, XOR with particular solution to get a candidate
+  // Track the one with minimum Hamming weight, then lexicographically smallest
+
+  let best: number[] | null = null;
+  let bestWeight = Infinity;
+
+  for (let mask = 0; mask < (1 << k); mask++) {
+    // candidate = particular XOR (selected null basis vectors)
+    const candidate = [...particular];
+    for (let b = 0; b < k; b++) {
+      if (mask & (1 << b)) {
+        for (let c = 0; c < m; c++) {
+          candidate[c] ^= nullBasis[b][c];
+        }
+      }
+    }
+
+    const weight = candidate.reduce((s, v) => s + v, 0);
+
+    if (weight < bestWeight) {
+      bestWeight = weight;
+      best = candidate;
+    } else if (weight === bestWeight && best !== null) {
+      // Lexicographic comparison: compare the sorted lists of pressed button indices
+      if (isLexSmaller(candidate, best!)) {
+        best = candidate;
+      }
+    }
+  }
+
+  if (best === null) return null;
+
+  // Convert to sorted list of button indices
+  const result: number[] = [];
+  for (let i = 0; i < m; i++) {
+    if (best[i] === 1) {
+      result.push(i);
+    }
+  }
+  return result;
+}
+
+/**
+ * Check if candidate a is lexicographically smaller than b.
+ * Lexicographic comparison: compare the sorted lists of pressed button indices.
+ * [0,2] < [0,3] < [1,2] etc.
+ */
+function isLexSmaller(a: number[], b: number[]): boolean {
+  const aIndices: number[] = [];
+  const bIndices: number[] = [];
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] === 1) aIndices.push(i);
+  }
+  for (let i = 0; i < b.length; i++) {
+    if (b[i] === 1) bIndices.push(i);
+  }
+  const len = Math.min(aIndices.length, bIndices.length);
+  for (let i = 0; i < len; i++) {
+    if (aIndices[i] < bIndices[i]) return true;
+    if (aIndices[i] > bIndices[i]) return false;
+  }
+  return aIndices.length < bIndices.length;
+}
+
+// ─── Part 2: Counter Puzzle ──────────────────────────────────────────────────
+
+/**
+ * Solve the counter puzzle.
+ *
+ * This is a system of linear equations over Z_p (prime field).
+ * - N counters (each starts at 0, wraps at modulus)
+ * - M buttons (each increments a subset of counters by 1)
+ * - Each button can be pressed 0 to (modulus-1) times
+ * - Find minimum total presses to reach target
+ *
+ * Approach:
+ * 1. Build augmented matrix [A | b] over Z_p
+ * 2. Gaussian elimination to find particular solution + null space
+ * 3. Enumerate null space combinations to find minimum total presses
+ * 4. Tiebreak by lexicographic order of result array
+ */
+function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): number[] | null {
+  const n = lights.length; // number of counters
+  const m = buttons.length; // number of buttons
+
+  // Build matrix: n rows (counters), m columns (buttons)
+  // A[i][j] = 1 if button j increments counter i
+  const A: number[][] = [];
+  for (let i = 0; i < n; i++) {
+    const row = new Array(m).fill(0);
+    A.push(row);
+  }
+  for (let j = 0; j < m; j++) {
+    for (const counter of buttons[j]) {
+      A[counter][j] = 1;
+    }
+  }
+
+  // Target vector
+  const b = lights.slice();
+
+  // Augmented matrix: n rows, m+1 columns
+  const aug: number[][] = A.map((row, i) => [...row, b[i]]);
+
+  // Gaussian elimination over Z_p
+  const pivotCol = new Array(n).fill(-1);
+  const pivotRow = new Array(m).fill(-1);
+  let row = 0;
+
+  // Modular inverse using Fermat's little theorem (modulus is prime)
+  function modInverse(a: number): number {
+    let result = 1;
+    let base = ((a % modulus) + modulus) % modulus;
+    let exp = modulus - 2;
+    while (exp > 0) {
+      if (exp & 1) {
+        result = (result * base) % modulus;
+      }
+      base = (base * base) % modulus;
+      exp >>= 1;
+    }
+    return result;
+  }
+
+  for (let col = 0; col < m && row < n; col++) {
+    // Find pivot
+    let pivot = -1;
+    for (let r = row; r < n; r++) {
+      if (aug[r][col] !== 0) {
+        pivot = r;
+        break;
+      }
+    }
+    if (pivot === -1) continue;
+
