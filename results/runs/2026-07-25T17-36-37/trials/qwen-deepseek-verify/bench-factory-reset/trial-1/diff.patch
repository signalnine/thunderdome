n  for (let col = 0; col < k && rowC < rank; col++) {\n    let pivot = -1;\n    for (let r = rowC; r < rank; r++) {\n      if (augC[r][col] !== 0) {\n        pivot = r;\n        break;\n      }\n    }\n    if (pivot === -1) continue;\n\n    [augC[rowC], augC[pivot]] = [augC[pivot], augC[rowC]];\n\n    const inv = modInverse(augC[rowC][col]);\n    for (let c = 0; c <= k; c++) {\n      augC[rowC][c] = (augC[rowC][c] * inv) % modulus;\n    }\n\n    for (let r = 0; r < rank; r++) {\n      if (r !== rowC && augC[r][col] !== 0) {\n        const factor = augC[r][col];\n        for (let c = 0; c <= k; c++) {\n          augC[r][c] = (augC[r][c] - factor * augC[rowC][c]) % modulus;\n          if (augC[r][c] < 0) augC[r][c] += modulus;\n        }\n      }\n    }\n\n    pivotColC[rowC] = col;\n    rowC++;\n  }\n\n  // Check consistency\n  let consistent = true;\n  for (let r = rowC; r < rank; r++) {\n    if (augC[r][k] !== 0) {\n      consistent = false;\n      break;\n    }\n  }\n\n  if (consistent) {\n    // System is consistent. Find the solution that minimizes the free positions.\n    // The pivot positions will all be 0.\n    // For the free positions: x[freeCols[i]] = (particular[freeCols[i]] + t_i) % modulus\n    // We want t_i = (modulus - particular[freeCols[i]]) % modulus for each i.\n    // But this must satisfy C * t = cTarget.\n\n    // Identify pivot and free columns in the constraint system\n    const pivotColsC = new Set<number>();\n    for (let r = 0; r < rowC; r++) {\n      if (pivotColC[r] !== -1) {\n        pivotColsC.add(pivotColC[r]);\n      }\n    }\n\n    const freeColsC: number[] = [];\n    for (let c = 0; c < k; c++) {\n      if (!pivotColsC.has(c)) {\n        freeColsC.push(c);\n      }\n    }\n\n    const k2 = freeColsC.length; // dimension of null space of C\n\n    // Extract particular solution for C * t = cTarget (set free variables to 0)\n    const tParticular = new Array(k).fill(0);\n    for (let r = 0; r < rowC; r++) {\n      const pc = pivotColC[r];\n      if (pc !== -1) {\n        tParticular[pc] = augC[r][k];\n      }\n    }\n\n    // Extract null space of C\n    const nullBasisC: number[][] = [];\n    for (const fc of freeColsC) {\n      const vec = new Array(k).fill(0);\n      vec[fc] = 1;\n      for (let r = 0; r < rowC; r++) {\n        const pc = pivotColC[r];\n        if (pc !== -1 && augC[r][fc] !== 0) {\n          vec[pc] = (modulus - augC[r][fc]) % modulus;\n        }\n      }\n      nullBasisC.push(vec);\n    }\n\n    // Now enumerate over the null space of C\n    // General solution: t = tParticular + sum(z[i] * nullBasisC[i])\n    // where z[i] in [0, modulus-1]\n    // Total combinations: modulus^k2\n\n    const totalC = Math.pow(modulus, k2);\n\n    if (totalC <= maxEnum) {\n      // Enumerate\n      let best: number[] | null = null;\n      let bestSum = Infinity;\n\n      const z = new Array(k2).fill(0);\n      const t = [...tParticular];\n\n      let done = false;\n      while (!done) {\n        // Compute candidate from t\n        const candidate = new Array(m).fill(0);\n        for (let j = 0; j < m; j++) {\n          candidate[j] = particular[j];\n        }\n        for (let i = 0; i < k; i++) {\n          if (t[i] > 0) {\n            for (let j = 0; j < m; j++) {\n              candidate[j] = (candidate[j] + t[i] * nullBasis[i][j]) % modulus;\n            }\n          }\n        }\n\n        const sum = candidate.reduce((s, v) => s + v, 0);\n\n        if (sum < bestSum) {\n          bestSum = sum;\n          best = candidate;\n        } else if (sum === bestSum && best !== null) {\n          let dominated = false;\n          for (let j = 0; j < m; j++) {\n            if (candidate[j] < best[j]) {\n              dominated = true;\n              break;\n            }\n            if (candidate[j] > best[j]) {\n              break;\n            }\n          }\n          if (dominated) {\n            best = candidate;\n          }\n        }\n\n        // Increment z\n        let carry = true;\n        for (let i = k2 - 1; i >= 0 && carry; i--) {\n          z[i]++;\n          if (z[i] >= modulus) {\n            z[i] = 0;\n          } else {\n            carry = false;\n          }\n        }\n        if (carry) { done = true; break; }\n\n        // Update t: t = tParticular + sum(z[i] * nullBasisC[i])\n        for (let j = 0; j < k; j++) {\n          t[j] = tParticular[j];\n        }\n        for (let i = 0; i < k2; i++) {\n          if (z[i] > 0) {\n            for (let j = 0; j < k; j++) {\n              t[j] = (t[j] + z[i] * nullBasisC[i][j]) % modulus;\n            }\n          }\n        }\n      }\n\n      return best;\n    }\n\n    // If k2 is still too large, use the particular solution\n    // This gives a valid solution but may not be optimal\n    const candidate = new Array(m).fill(0);\n    for (let j = 0; j < m; j++) {\n      candidate[j] = particular[j];\n    }\n    for (let i = 0; i < k; i++) {\n      if (tParticular[i] > 0) {\n        for (let j = 0; j < m; j++) {\n          candidate[j] = (candidate[j] + tParticular[i] * nullBasis[i][j]) % modulus;\n        }\n      }\n    }\n    return candidate;\n  }\n\n  // System is inconsistent — can't make all pivot positions 0\n  // Fall back to enumeration if feasible, otherwise use greedy\n  // This case is rare in practice\n\n  // Try enumeration with the full null space\n  let best: number[] | null = null;\n  let bestSum = Infinity;\n\n  const t = new Array(k).fill(0);\n  const candidate = [...particular];\n\n  let done = false;\n  while (!done) {\n    const sum = candidate.reduce((s, v) => s + v, 0);\n\n    if (sum < bestSum) {\n      bestSum = sum;\n      best = candidate.slice();\n    } else if (sum === bestSum && best !== null) {\n      let dominated = false;\n      for (let j = 0; j < m; j++) {\n        if (candidate[j] < best[j]) {\n          dominated = true;\n          break;\n        }\n        if (candidate[j] > best[j]) {\n          break;\n        }\n      }\n      if (dominated) {\n        best = candidate.slice();\n      }\n    }\n\n    let carry = true;\n    for (let i = k - 1; i >= 0 && carry; i--) {\n      t[i]++;\n      if (t[i] >= modulus) {\n        t[i] = 0;\n      } else {\n        for (let j = 0; j < m; j++) {\n          candidate[j] = (candidate[j] + nullBasis[i][j]) % modulus;\n        }\n        carry = false;\n      }\n    }\n    if (carry) { done = true; break; }\n  }\n\n  return best;\n}\n\nexport { solveToggle, solveCounter, Machine };\n\n// ─── CLI ──────────────────────────────────────────────────────────────────────\n\nif (import.meta.url === `file://${process.argv[1]}`) {\n  console.log(\"Factory Reset Solver\");\n  console.log(\"Run: npm test\");\n}\n","numLines":680,"startLine":1,"totalLines":680}}}
