1]], 5);\n    expect(result).toEqual([0, 0, 1]);\n  });\n\n  it('wrap-around optimization', () => {\n    // 1 counter, 1 button, modulus 5\n    // Target: 4\n    // Press 4 times: 0→1→2→3→4 (4 presses)\n    // But pressing 4 times is the same as pressing -1 times mod 5\n    // Actually, pressing 4 times gives value 4, which is correct\n    // There's no \"negative\" pressing — minimum is 4\n    const result = solveCounter([4], [[0]], 5);\n    expect(result).toEqual([4]);\n  });\n\n  it('null space — multiple solutions, choose minimum', () => {\n    // 3 counters, 4 buttons, modulus 5\n    // Button 0: [0], Button 1: [1], Button 2: [2], Button 3: [0,1,2]\n    // Target: [3, 3, 3]\n    // Solution 1: [3, 3, 3, 0] = 9 total\n    // Solution 2: [0, 0, 0, 3] = 3 total — minimum!\n    const result = solveCounter([3, 3, 3], [[0], [1], [2], [0, 1, 2]], 5);\n    expect(result).toEqual([0, 0, 0, 3]);\n  });\n\n  it('null space with wrap-around benefit', () => {\n    // 1 counter, 2 buttons, modulus 5\n    // Button 0: [0], Button 1: [0]\n    // Target: [4]\n    // Solution 1: [4, 0] = 4 total\n    // Solution 2: [0, 4] = 4 total\n    // Solution 3: [3, 1] = 4 total\n    // Solution 4: [1, 3] = 4 total\n    // Solution 5: [2, 2] = 4 total\n    // Solution 6: [4, 0] = 4 total\n    // All have same total. Lexicographically smallest: [0, 4]\n    const result = solveCounter([4], [[0], [0]], 5);\n    expect(result).toEqual([0, 4]);\n  });\n\n  it('modulus 2 — same as toggle puzzle', () => {\n    // Modulus 2 is essentially the toggle puzzle\n    const result = solveCounter([1, 1], [[0], [1], [0, 1]], 2);\n    // Target [1,1], buttons [0],[1],[0,1]\n    // Solution [0,0,1] = 1 total (press button 2 once)\n    // Solution [1,1,0] = 2 total\n    expect(result).toEqual([0, 0, 1]);\n  });\n\n  it('larger modulus — 7', () => {\n    const result = solveCounter([3, 5], [[0], [1]], 7);\n    expect(result).toEqual([3, 5]);\n  });\n\n  it('verify solution correctness', () => {\n    const lights = [2, 3, 1];\n    const buttons = [[0, 1], [1, 2], [0, 2], [0, 1, 2]];\n    const modulus = 5;\n\n    const result = solveCounter(lights, buttons, modulus);\n    expect(result).not.toBeNull();\n\n    // Verify: simulate pressing the buttons\n    const counters = new Array(lights.length).fill(0);\n    for (let i = 0; i < result!.length; i++) {\n      for (let t = 0; t < result![i]; t++) {\n        for (const c of buttons[i]) {\n          counters[c] = (counters[c] + 1) % modulus;\n        }\n      }\n    }\n    expect(counters).toEqual(lights);\n  });\n\n  it('performance — 40 counters, 40 buttons, modulus 97', () => {\n    const n = 40;\n    const lights: number[] = [];\n    const buttons: number[][] = [];\n\n    // Identity-like: each button increments one counter\n    for (let i = 0; i < n; i++) {\n      lights.push((i * 7 + 3) % 97);\n      buttons.push([i]);\n    }\n\n    const result = solveCounter(lights, buttons, 97);\n    expect(result).not.toBeNull();\n\n    // Verify\n    const counters = new Array(n).fill(0);\n    for (let i = 0; i < result!.length; i++) {\n      for (let t = 0; t < result![i]; t++) {\n        for (const c of buttons[i]) {\n          counters[c] = (counters[c] + 1) % 97;\n        }\n      }\n    }\n    expect(counters).toEqual(lights);\n  });\n\n  it('performance — 40 counters, 40 buttons with null space', () => {\n    const n = 40;\n    const lights: number[] = [];\n    const buttons: number[][] = [];\n\n    // 39 identity buttons + 1 button that affects all\n    for (let i = 0; i < n - 1; i++) {\n      lights.push((i * 7 + 3) % 97);\n      buttons.push([i]);\n    }\n    lights.push(42);\n    buttons.push(Array.from({ length: n }, (_, i) => i));\n\n    const result = solveCounter(lights, buttons, 97);\n    expect(result).not.toBeNull();\n\n    // Verify\n    const counters = new Array(n).fill(0);\n    for (let i = 0; i < result!.length; i++) {\n      for (let t = 0; t < result![i]; t++) {\n        for (const c of buttons[i]) {\n      