% modulus;\n      }\n    }\n    nullBasis.push(vec);\n  }\n\n  // Enumerate all combinations of null space vectors\n  // For each free variable, it can take values 0..modulus-1\n  // Total combinations: modulus^k\n  //\n  // For small k, enumerate all possibilities.\n  // For larger k, use a greedy approach.\n\n  const maxEnum = 10_000_000;\n  const totalCombinations = Math.pow(modulus, k);\n\n  if (totalCombinations <= maxEnum) {\n    // Enumerate all possibilities\n    let best: number[] | null = null;\n    let bestSum = Infinity;\n\n    // Use iterative approach: t[0..k-1] each in [0, modulus-1]\n    const t = new Array(k).fill(0);\n\n    while (true) {\n      // Compute candidate = particular + sum(t[i] * nullBasis[i]) mod modulus\n      const candidate = [...particular];\n      for (let i = 0; i < k; i++) {\n        if (t[i] > 0) {\n          for (let j = 0; j < m; j++) {\n            candidate[j] = (candidate[j] + t[i] * nullBasis[i][j]) % modulus;\n          }\n        }\n      }\n\n      const sum = candidate.reduce((s, v) => s + v, 0);\n\n      if (sum < bestSum) {\n        bestSum = sum;\n        best = candidate;\n      } else if (sum === bestSum && best !== null) {\n        // Lexicographic comparison\n        let dominated = false;\n        for (let j = 0; j < m; j++) {\n          if (candidate[j] < best[j]) {\n            dominated = true;\n            break;\n          }\n          if (candidate[j] > best[j]) {\n            break;\n          }\n        }\n        if (dominated) {\n          best = candidate;\n        }\n      }\n\n      // Increment t (like a counter in base modulus)\n      let carry = true;\n      for (let i = k - 1; i >= 0 && carry; i--) {\n        t[i]++;\n        if (t[i] >= modulus) {\n          t[i] = 0;\n          carry = true;\n        } else {\n          carry = false;\n        }\n      }\n      if (carry) break; // overflow, done\n    }\n\n    return best;\n  }\n\n  // For large k, use a greedy approach\n  // Process free variables one at a time, optimizing each\n  let current = [...particular];\n\n  for (let i = 0; i < k; i++) {\n    const basis = nullBasis[i];\n\n    // Try all values of t_i\n    let bestCandidate = [...current];\n    let bestSum = bestCandidate.reduce((s, v) => s + v, 0);\n\n    for (let t = 1; t < modulus; t++) {\n      const candidate = [...current];\n      for (let j = 0; j < m; j++) {\n        candidate[j] = (candidate[j] + t * basis[j]) % modulus;\n      }\n\n      const sum = candidate.reduce((s, v) => s + v, 0);\n\n      if (sum < bestSum) {\n        bestSum = sum;\n        bestCandidate = candidate;\n      } else if (sum === bestSum) {\n        // Lexicographic comparison\n        let dominated = false;\n        for (let j = 0; j < m; j++) {\n          if (candidate[j] < bestCandidate[j]) {\n            dominated = true;\n            break;\n          }\n          if (candidate[j] > bestCandidate[j]) {\n            break;\n          }\n        }\n        if (dominated) {\n          bestCandidate = candidate;\n        }\n      }\n    }\n\n    current = bestCandidate;\n  }\n\n  return current;\n}\n\nexport { solveToggle, solveCounter, Machine };\n\n// ─── CLI ──────────────────────────────────────────────────────────────────────\n\nif (import.meta.url === `file://${process.argv[1]}`) {\n  console.log(\"Factory Reset Solver\");\n  console.log(\"Run: npm test\");\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
