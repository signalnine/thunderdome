llest\n */\nfunction solveToggle(machine: Machine): number[] | null {\n  const n = machine.target.length; // number of lights\n  const m = machine.buttons.length; // number of buttons\n\n  // Build matrix: n rows (lights), m columns (buttons)\n  // A[i][j] = 1 if button j toggles light i\n  const A: number[][] = [];\n  for (let i = 0; i < n; i++) {\n    const row = new Array(m).fill(0);\n    A.push(row);\n  }\n  for (let j = 0; j < m; j++) {\n    for (const light of machine.buttons[j]) {\n      A[light][j] = 1;\n    }\n  }\n\n  // Target vector b\n  const b: number[] = machine.target.map(v => (v ? 1 : 0));\n\n  // Augmented matrix: n rows, m+1 columns (last column is b)\n  const aug: number[][] = A.map((row, i) => [...row, b[i]]);\n\n  // Gaussian elimination over GF(2)\n  const pivotCol = new Array(n).fill(-1); // pivotCol[row] = column of pivot\n  const pivotRow = new Array(m).fill(-1); // pivotRow[col] = row that has pivot in this col\n  let row = 0;\n\n  for (let col = 0; col < m && row < n; col++) {\n    // Find pivot\n    let pivot = -1;\n    for (let r = row; r < n; r++) {\n      if (aug[r][col] === 1) {\n        pivot = r;\n        break;\n      }\n    }\n    if (pivot === -1) continue;\n\n    // Swap rows\n    [aug[row], aug[pivot]] = [aug[pivot], aug[row]];\n\n    // Eliminate\n    for (let r = 0; r < n; r++) {\n      if (r !== row && aug[r][col] === 1) {\n        for (let c = 0; c <= m; c++) {\n          aug[r][c] ^= aug[row][c];\n        }\n      }\n    }\n\n    pivotCol[row] = col;\n    pivotRow[col] = row;\n    row++;\n  }\n\n  // Check consistency: any row with all-zero LHS but nonzero RHS?\n  for (let r = row; r < n; r++) {\n    if (aug[r][m] === 1) {\n      return null; // inconsistent\n    }\n  }\n\n  // Identify pivot columns and free columns\n  const pivotCols = new Set<number>();\n  for (let r = 0; r < row; r++) {\n    if (pivotCol[r] !== -1) {\n      pivotCols.add(pivotCol[r]);\n    }\n  }\n\n  const freeCols: number[] = [];\n  for (let c = 0; 