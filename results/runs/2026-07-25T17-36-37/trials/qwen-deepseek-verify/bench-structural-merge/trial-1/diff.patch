+// ─── Public Types ────────────────────────────────────────────────────────────
+
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+export interface Conflict {
+  documentId: string;
+  path: string; // dot-separated JSON path, e.g. "a.b.c"
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  base: any;
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  ours: any;
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  theirs: any;
+}
+
+export interface MergeResult {
+  merged: Record<string, object>; // documentId -> merged content
+  conflicts: Conflict[];
+  applied: boolean; // true if merge was auto-applied (no conflicts)
+}
+
+// ─── Internal Types ──────────────────────────────────────────────────────────
+
+/** A snapshot of the entire store state at a point in time on a branch. */
+export interface BranchSnapshot {
+  /** The set of document IDs that exist on this branch. */
+  documentIds: Set<string>;
+  /** The content of each document. */
+  documents: Map<string, object>;
+}
+
+/** A versioned document stored on a branch. */
+export interface StoredDocument {
+  /** Current content on this branch. */
+  content: object;
+  /** Ordered list of versions (oldest first). */
+  versions: Version[];
+}
+
+/** The state of a single branch. */
+export interface BranchState {
+  /** Name of the branch. */
+  name: string;
+  /** The documents on this branch. */
+  documents: Map<string, StoredDocument>;
+  /** The branch this was created from (null for main). */
+  parentBranch: string | null;
+  /** Snapshot of the parent branch at the time of creation. */
+  parentSnapshot: BranchSnapshot | null;
+}
+
+// ─── DocumentStore Interface ─────────────────────────────────────────────────
+
+export interface DocumentStore {
+  // Document CRUD
+  create(id: string, content: object): void;
+  get(id: string): object;
+  update(id: string, content: object): void;
+  delete(id: string): void;
+
+  // Version history
+  getHistory(id: string): Version[];
+  getVersion(id: string, versionId: string): object;
+
+  // Branching
+  createBranch(name: string, fromBranch?: string): void;
+  switchBranch(name: string): void;
+  getBranch(): string;
+  listBranches(): string[];
+
+  // Merging
+  merge(sourceBranch: string): MergeResult;
+}
