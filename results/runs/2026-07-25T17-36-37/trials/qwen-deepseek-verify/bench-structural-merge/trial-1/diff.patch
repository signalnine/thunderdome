chBranch('feature');\n195\t      expect(store.get('doc1')).toEqual({ name: 'feature' });\n196\t    });\n197\t\n198\t    it('new documents on a branch are not visible on other branches', () => {\n199\t      store.createBranch('feature');\n200\t      store.switchBranch('feature');\n201\t      store.create('doc2', { name: 'feature-doc' });\n202\t\n203\t      store.switchBranch('main');\n204\t      expect(() => store.get('doc2')).toThrow('Document \"doc2\" does not exist');\n205\t    });\n206\t\n207\t    it('deletes on a branch are not visible on other branches', () => {\n208\t      store.create('doc1', { name: 'test' });\n209\t      store.createBranch('feature');\n210\t      store.switchBranch('feature');\n211\t      store.delete('doc1');\n212\t\n213\t      store.switchBranch('main');\n214\t      expect(store.get('doc1')).toEqual({ name: 'test' });\n215\t    });\n216\t\n217\t    it('lists all branches', () => {\n218\t      store.createBranch('feature1');\n219\t      store.createBranch('feature2');\n220\t      const branches = store.listBranches();\n221\t      expect(branches).toContain('main');\n222\t      expect(branches).toContain('feature1');\n223\t      expect(branches).toContain('feature2');\n224\t    });\n225\t\n226\t    it('branch inherits version history from parent', () => {\n227\t      store.create('doc1', { name: 'v1' });\n228\t      store.update('doc1', { name: 'v2' });\n229\t\n230\t      store.createBranch('feature');\n231\t      store.switchBranch('feature');\n232\t\n233\t      const history = store.getHistory('doc1');\n234\t      expect(history).toHaveLength(2);\n235\t      expect(history[0].content).toEqual({ name: 'v1' });\n236\t      expect(history[1].content).toEqual({ name: 'v2' });\n237\t    });\n238\t  });\n239\t\n240\t  // ─── Merging ──────────────────────────────────────────────────────────────\n241\t\n242\t  describe('Merging', () => {\n243\t    it('merges with no changes is a no-op', () => {\n244\t      store.create('doc1', { name: 'test' });