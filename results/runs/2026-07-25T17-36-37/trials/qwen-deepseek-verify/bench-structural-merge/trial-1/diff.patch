@@ -0,0 +1,389 @@
+import { Conflict, MergeResult } from './types.js';
+import { deepClone } from './utils.js';
+
+/**
+ * Three-way structural merge of two JSON objects against a common base.
+ *
+ * For each leaf path:
+ * - If only one side changed from base, take that change.
+ * - If both sides changed to the same value, no conflict.
+ * - If both sides changed to different values, it's a conflict.
+ *
+ * For object values, recurse into children.
+ * For non-object values (primitives, arrays), compare as atomic units.
+ */
+export function threeWayMerge(
+  base: Record<string, unknown>,
+  ours: Record<string, unknown>,
+  theirs: Record<string, unknown>,
+  documentId: string,
+  prefix: string = '',
+): { merged: Record<string, unknown>; conflicts: Conflict[] } {
+  const merged: Record<string, unknown> = {};
+  const conflicts: Conflict[] = [];
+
+  // Collect all keys from all three objects
+  const allKeys = new Set([
+    ...Object.keys(base),
+    ...Object.keys(ours),
+    ...Object.keys(theirs),
+  ]);
+
+  for (const key of allKeys) {
+    const path = prefix ? `${prefix}.${key}` : key;
+    const baseVal = base[key];
+    const oursVal = ours[key];
+    const theirsVal = theirs[key];
+
+    const inBase = key in base;
+    const inOurs = key in ours;
+    const inTheirs = key in theirs;
+
+    // Case: key only in ours (added on our branch)
+    if (!inBase && inOurs && !inTheirs) {
+      merged[key] = deepClone(oursVal);
+      continue;
+    }
+
+    // Case: key only in theirs (added on their branch)
+    if (!inBase && !inOurs && inTheirs) {
+      merged[key] = deepClone(theirsVal);
+      continue;
+    }
+
+    // Case: key in base and ours, but not theirs (deleted on their branch)
+    if (inBase && inOurs && !inTheirs) {
+      // Their branch deleted it; ours kept it
+      if (deepEqual(baseVal, oursVal)) {
+        // We didn't change it, they deleted it -> take deletion
+        continue;
+      }
+      // We changed it, they deleted it -> conflict
+      conflicts.push({
+        documentId,
+        path,
+        base: deepClone(baseVal),
+        ours: deepClone(oursVal),
+        theirs: undefined,
+      });
+      // For merged output, take ours (ours wins for display)
+      merged[key] = deepClone(oursVal);
+      continue;
+    }
+
+    // Case: key in base and theirs, but not ours (deleted on our branch)
+    if (inBase && !inOurs && inTheirs) {
+      if (deepEqual(baseVal, theirsVal)) {
+        // They didn't change it, we deleted it -> take deletion
+        continue;
+      }
+      // They changed it, we deleted it -> conflict
+      conflicts.push({
+        documentId,
+        path,
+        base: deepClone(baseVal),
+        ours: undefined,
+        theirs: deepClone(theirsVal),
+      });
+      // For merged output, take theirs (ours wins means we take ours=undefined)
+      merged[key] = undefined;
+      continue;
+    }
+
+    // Case: key in all three
+    if (inBase && inOurs && inTheirs) {
+      // Both unchanged from base
+      if (deepEqual(baseVal, oursVal) && deepEqual(baseVal, theirsVal)) {
+        merged[key] = deepClone(baseVal);
+        continue;
+      }
+
+      // Only ours changed
+      if (deepEqual(baseVal, theirsVal)) {
+        merged[key] = deepClone(oursVal);
+        continue;
+      }
+
+      // Only theirs changed
+      if (deepEqual(baseVal, oursVal)) {
+        merged[key] = deepClone(theirsVal);
+        continue;
+      }
+
+      // Both changed to the same value
+      if (deepEqual(oursVal, theirsVal)) {
+        merged[key] = deepClone(oursVal);
+        continue;
+      }
+
+      // Both changed to different values -> recurse if both are objects, else conflict
+      if (isObject(oursVal) && isObject(theirsVal) && isObject(baseVal)) {
+        const sub = threeWayMerge(
+          baseVal as Record<string, unknown>,
+          oursVal as Record<string, unknown>,
+          theirsVal as Record<string, unknown>,
+          documentId,
+          path,
+        );
+        merged[key] = sub.merged;
+        conflicts.push(...sub.conflicts);
+        continue;
+      }
+
+      // Conflict: both changed to different values
+      conflicts.push({
+        documentId,
+        path,
+        base: deepClone(baseVal),
+        ours: deepClone(oursVal),
+        theirs: deepClone(theirsVal),
+      });
+      // For merged output, take ours
+      merged[key] = deepClone(oursVal);
+      continue;
+    }
+
+    // Case: key in none of them (shouldn't happen, but handle gracefully)
+    if (!inBase && !inOurs && !inTheirs) {
+      continue;
+    }
+
+    // Case: key in base only (deleted on both branches)
+    if (inBase && !inOurs && !inTheirs) {
+      continue;
+    }
+  }
+
+  return { merged, conflicts };
+}
+
+/** Check if a value is a plain object (not null, not array). */
+function isObject(value: unknown): value is object {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+/** Deep equality check for JSON-serializable values. */
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (a === null || b === null) return a === b;
+  if (typeof a !== typeof b) return false;
+  if (typeof a !== 'object') return false;
+
+  if (Array.isArray(a) !== Array.isArray(b)) return false;
+
+  if (Array.isArray(a)) {
+    if ((a as unknown[]).length !== (b as unknown[]).length) return false;
+    for (let i = 0; i < a.length; i++) {
+      if (!deepEqual(a[i], (b as unknown[])[i])) return false;
+    }
+    return true;
+  }
+
+  const keysA = Object.keys(a as object);
+  const keysB = Object.keys(b as object);
+  if (keysA.length !== keysB.length) return false;
+  for (const key of keysA) {
+    if (!(key in (b as object))) return false;
+    if (!deepEqual((a as Record<string, unknown>)[key], (b as Record<string, unknown>)[key])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+/**
+ * Compute the common ancestor state between two branches.
+ *
+ * The common ancestor is the state at the point where the branches diverged.
+ * For a branch created from another branch, this is the snapshot taken at
+ * branch creation time.
+ */
+export function findCommonAncestor(
+  branchA: {
+    name: string;
+    parentBranch: string | null;
+    parentSnapshot: { documents: Map<string, object>; documentIds: Set<string> } | null;
+  },
+  branchB: {
+    name: string;
+    parentBranch: string | null;
+    parentSnapshot: { documents: Map<string, object>; documentIds: Set<string> } | null;
+  },
+): { documents: Map<string, object>; documentIds: Set<string> } {
+  // If branchA was created from branchB, the ancestor is branchA's parent snapshot
+  if (branchA.parentBranch === branchB.name) {
+    return {
+      documents: branchA.parentSnapshot!.documents,
+      documentIds: branchA.parentSnapshot!.documentIds,
+    };
+  }
+
+  // If branchB was created from branchA, the ancestor is branchB's parent snapshot
+  if (branchB.parentBranch === branchA.name) {
+    return {
+      documents: branchB.parentSnapshot!.documents,
+      documentIds: branchB.parentSnapshot!.documentIds,
+    };
+  }
+
+  // If both share the same parent, use that parent's snapshot
+  if (branchA.parentBranch === branchB.parentBranch) {
+    // Use the snapshot from whichever branch has it
+    const snapshot = branchA.parentSnapshot ?? branchB.parentSnapshot;
+    if (snapshot) {
+      return {
+        documents: snapshot.documents,
+        documentIds: snapshot.documentIds,
+      };
+    }
+  }
+
+  // Fallback: if one branch is main (root), the ancestor is the other branch's parent
+  if (branchA.parentBranch === null) {
+    // branchA is main; branchB was created from something
+    if (branchB.parentBranch === branchA.name) {
+      return {
+        documents: branchB.parentSnapshot!.documents,
+        documentIds: branchB.parentSnapshot!.documentIds,
+      };
+    }
+    // branchB is also a root or has a different parent
+    // Use empty ancestor (both branches started from scratch)
+    return { documents: new Map(), documentIds: new Set() };
+  }
+
+  if (branchB.parentBranch === null) {
+    if (branchA.parentBranch === branchB.name) {
+      return {
+        documents: branchA.parentSnapshot!.documents,
+        documentIds: branchA.parentSnapshot!.documentIds,
+      };
+    }
+    return { documents: new Map(), documentIds: new Set() };
+  }
+
+  // Default: empty ancestor
+  return { documents: new Map(), documentIds: new Set() };
+}
+
+/**
+ * Perform a merge of sourceBranch into the current branch.
+ */
+export function computeMerge(
+  currentBranchName: string,
+  sourceBranchName: string,
+  currentDocs: Map<string, { content: object }>,
+  sourceDocs: Map<string, { content: object }>,
+  ancestorDocs: Map<string, object>,
+  ancestorIds: Set<string>,
+): MergeResult {
+  const merged: Record<string, object> = {};
+  const allConflicts: Conflict[] = [];
+
+  // Collect all document IDs from all three states
+  const allDocIds = new Set([
+    ...currentDocs.keys(),
+    ...sourceDocs.keys(),
+    ...ancestorIds,
+  ]);
+
+  for (const docId of allDocIds) {
+    const inAncestor = ancestorIds.has(docId);
+    const inCurrent = currentDocs.has(docId);
+    const inSource = sourceDocs.has(docId);
+
+    const ancestorContent = inAncestor ? ancestorDocs.get(docId)! : {};
+    const currentContent = inCurrent ? deepClone(currentDocs.get(docId)!.content) : {};
+    const sourceContent = inSource ? deepClone(sourceDocs.get(docId)!.content) : {};
+
+    // If document only exists on current branch, take it
+    if (!inAncestor && inCurrent && !inSource) {
+      merged[docId] = deepClone(currentContent);
+      continue;
+    }
+
+    // If document only exists on source branch, take it
+    if (!inAncestor && !inCurrent && inSource) {
+      merged[docId] = deepClone(sourceContent);
+      continue;
+    }
+
+    // If document only exists on ancestor (deleted on both), skip
+    if (inAncestor && !inCurrent && !inSource) {
+      continue;
+    }
+
+    // If document was deleted on current but exists on source
+    if (inAncestor && !inCurrent && inSource) {
+      if (deepEqual(ancestorContent, sourceContent)) {
+        // Source didn't change it, we deleted it -> deletion wins
+        continue;
+      }
+      // Source changed it, we deleted it -> conflict at document level
+      allConflicts.push({
+        documentId: docId,
+        path: '',
+        base: deepClone(ancestorContent),
+        ours: undefined,
+        theirs: deepClone(sourceContent),
+      });
+      // For merged output, take ours (undefined = deleted)
+      continue;
+    }
+
+    // If document was deleted on source but exists on current
+    if (inAncestor && inCurrent && !inSource) {
+      if (deepEqual(ancestorContent, currentContent)) {
+        // Current didn't change it, source deleted it -> deletion wins
+        continue;
+      }
+      // Current changed it, source deleted it -> conflict at document level
+      allConflicts.push({
+        documentId: docId,
+        path: '',
+        base: deepClone(ancestorContent),
+        ours: deepClone(currentContent),
+        theirs: undefined,
+      });
+      // For merged output, take ours
+      merged[docId] = deepClone(currentContent);
+      continue;
+    }
+
+    // Document exists on ancestor and at least one of current/source
+    if (inAncestor) {
+      const result = threeWayMerge(
+        ancestorContent as Record<string, unknown>,
+        currentContent as Record<string, unknown>,
+        sourceContent as Record<string, unknown>,
+        docId,
+      );
+      merged[docId] = result.merged;
+      allConflicts.push(...result.conflicts);
+      continue;
+    }
+
+    // Document not in ancestor but in both current and source (both added independently)
+    if (!inAncestor && inCurrent && inSource) {
+      if (deepEqual(currentContent, sourceContent)) {
+        // Both added the same thing
+        merged[docId] = deepClone(currentContent);
+      } else {
+        // Both added different things -> conflict
+        allConflicts.push({
+          documentId: docId,
+          path: '',
+          base: undefined,
+          ours: deepClone(currentContent),
+          theirs: deepClone(sourceContent),
+        });
+        // For merged output, take ours
+        merged[docId] = deepClone(currentContent);
+      }
+    }
+  }
+
+  const applied = allConflicts.length === 0;
+
+  return { merged, conflicts: allConflicts, applied };
+}
