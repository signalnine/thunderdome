ncestor = findCommonAncestor(\n      { name: currentBranch.name, parentBranch: currentBranch.parentBranch, parentSnapshot: currentBranch.parentSnapshot },\n      { name: sourceBranch.name, parentBranch: sourceBranch.parentBranch, parentSnapshot: sourceBranch.parentSnapshot },\n    );\n\n    // Compute the merge\n    const result = computeMerge(\n      this.currentBranchName,\n      sourceBranchName,\n      currentBranch.documents,\n      sourceBranch.documents,\n      ancestor.documents,\n      ancestor.documentIds,\n    );\n\n    // If no conflicts, apply the merge to the current branch\n    if (result.applied) {\n      this.applyMerge(result.merged);\n    }\n\n    return result;\n  }\n\n  /** Apply the merged document contents to the current branch. */\n  private applyMerge(merged: Record<string, object>): void {\n    const branch = this.getCurrentBranch();\n\n    for (const [docId, content] of Object.entries(merged)) {\n      if (branch.documents.has(docId)) {\n        // Update existing document\n        const doc = branch.documents.get(docId)!;\n        const version: Version = {\n          id: generateVersionId(),\n          timestamp: Date.now(),\n          content: deepClone(content),\n        };\n        doc.content = deepClone(content);\n        doc.versions.push(version);\n      } else {\n        // Create new document from merge\n        const version: Version = {\n          id: generateVersionId(),\n          timestamp: Date.now(),\n          content: deepClone(content),\n        };\n        branch.documents.set(docId, {\n          content: deepClone(content),\n          versions: [version],\n        });\n      }\n    }\n\n    // Delete documents that are not in the merged result\n    for (const docId of branch.documents.keys()) {\n      if (!(docId in merged)) {\n        branch.documents.delete(docId);\n      }\n    }\n  }\n\n  // ─── Internal Helpers ─────────────────────────────────────────────────────\n\n  private getCurrentBranch(): BranchState {\n