\n    });\n\n    it('throws when creating a document with duplicate ID', () => {\n      store.create('doc1', { name: 'test' });\n      expect(() => store.create('doc1', { name: 'other' })).toThrow(\n        'Document \"doc1\" already exists',\n      );\n    });\n\n    it('gets a document', () => {\n      store.create('doc1', { name: 'test' });\n      expect(store.get('doc1')).toEqual({ name: 'test' });\n    });\n\n    it('throws when getting a non-existent document', () => {\n      expect(() => store.get('missing')).toThrow('Document \"missing\" does not exist');\n    });\n\n    it('updates a document', () => {\n      store.create('doc1', { name: 'test', value: 1 });\n      store.update('doc1', { name: 'test', value: 2 });\n      expect(store.get('doc1')).toEqual({ name: 'test', value: 2 });\n    });\n\n    it('throws when updating a non-existent document', () => {\n      expect(() => store.update('missing', { name: 'test' })).toThrow(\n        'Document \"missing\" does not exist',\n      );\n    });\n\n    it('deletes a document', () => {\n      store.create('doc1', { name: 'test' });\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow('Document \"doc1\" does not exist');\n    });\n\n    it('throws when deleting a non-existent document', () => {\n      expect(() => store.delete('missing')).toThrow('Document \"missing\" does not exist');\n    });\n\n    it('prevents mutation of stored documents', () => {\n      const content = { name: 'test', items: [1, 2, 3] };\n      store.create('doc1', content);\n      // Mutate the original\n      content.name = 'mutated';\n      content.items.push(4);\n      // Stored document should be unchanged\n      expect(store.get('doc1')).toEqual({ name: 'test', items: [1, 2, 3] });\n    });\n\n    it('prevents mutation of retrieved documents', () => {\n      store.create('doc1', { name: 'test', items: [1, 2, 3] });\n      const doc = store.get('doc1');\n      (doc as any).name = 'mutated';\n      (doc as any).items.push(4);\n      // Stored document should be unchanged\n      expect(store.get('doc1')).toEqual({ name: 'test', items: [1, 2, 3] });\n    });\n  });\n\n  // ─── Version History ──────────────────────────────────────────────────────\n\n  describe('Version History', () => {\n    it('tracks versions on create', () => {\n      store.create('doc1', { name: 'v1' });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(1);\n      expect(history[0].content).toEqual({ name: 'v1' });\n      expect(history[0].id).toBeDefined();\n      expect(typeof history[0].id).toBe('string');\n      expect(typeof history[0].timestamp).toBe('number');\n    });\n\n    it('tracks versions on update', () => {\n      store.create('doc1', { name: 'v1' });\n      store.update('doc1', { name: 'v2' });\n      store.update('doc1', { name: 'v3' });\n\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(3);\n      expect(history[0].content).toEqual({ name: 'v1' });\n      expect(history[1].content).toEqual({ name: 'v2' });\n      expect(history[2].content).toEqual({ name: 'v3' });\n    });\n\n    it('returns versions in chronological order', () => {\n      store.create('doc1', { step: 1 });\n      store.update('doc1', { step: 2 });\n\n      const history = store.getHistory('doc1');\n      expect(history[0].timestamp).toBeLessThanOrEqual(history[1].timestamp);\n    });\n\n    it('gets a specific version by ID', () => {\n      store.create('doc1', { name: 'v1' });\n      store.update('doc1', { name: 'v2' });\n\n      const history = store.getHistory('doc1');\n      const v1Content = store.getVersion('doc1', history[0].id);\n      expect(v1Content).toEqual({ name: 'v1' });\n\n      const v2Content = store.getVersion('doc1', history[1].id);\n      expect(v2Content).toEqual({ name: 'v2' });\n    });\n\n    it('throws when getting a non-existent version', () => {\n      store.create('doc1', { name: 'v1' });\n      expect(() => store.getVersion('doc1', 'nonexistent')).toThrow('Version \"nonexistent\" not found');\n    });\n\n    it('throws when getting history of a non-existent document', () => {\n      expect(() => store.getHistory('missing')).toThrow('Document \"missing\" does not exist');\n    });\n  });\n\n  // ─── Branching ────────────────────────────────────────────────────────────\n\n  describe('Branching', () => {\n    it('starts on main branch', () => {\n      expect(store.getBranch()).toBe('main');\n    });\n\n    it('creates a branch from current branch', () => {\n      store.create('doc1', { name: 'test' });\n      store.createBranch('feature');\n\n      expect(store.listBranches()).toContain('main');\n      expect(store.listBranches()).toContain('feature');\n    });\n\n    it('creates a branch from a specified branch', () => {\n      store.create('doc1', { name: 'test' });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { name: 'feature' });\n\n      // Create another branch from main\n      store.createBranch('feature2', 'main');\n      store.switchBranch('feature2');\n\n      // doc1 on feature2 should have the main version\n      expect(store.get('doc1')).toEqual({ name: 'test' });\n    });\n\n    it('throws when creating a branch with duplicate name', () => {\n      store.createBranch('feature');\n      expect(() => store.createBranch('feature')).toThrow('Branch \"feature\" already exists');\n    });\n\n    it('throws when creating a branch from non-existent branch', () => {\n      expect(() => store.createBranch('feature', 'nonexistent')).toThrow(\n        'Branch \"nonexistent\" does not exist',\n      );\n    });\n\n    it('switches branches', () => {\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(store.getBranch()).toBe('feature');\n    });\n\n    it('throws when switching to non-existent branch', () => {\n      expect(() => store.switchBranch('nonexistent')).toThrow('Branch \"nonexistent\" does not exist');\n    });\n\n    it('isolates changes between branches', () => {\n      store.create('doc1', { name: 'main' });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { name: 'feature' });\n\n      // Switch back to main\n      store.switchBranch('main');\n      expect(store.get('doc1')).toEqual({ name: 'main' });\n\n      // Feature branch should still have its version\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ name: 'feature' });\n    });\n\n    it('new documents on a branch are not visible on other branches', () => {\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc2', { name: 'feature-doc' });\n\n      store.switchBranch('main');\n      expect(() => store.get('doc2')).toThrow('Document \"doc2\" does not exist');\n    });\n\n    it('deletes on a branch are not visible on other branches', () => {\n      store.create('doc1', { name: 'test' });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.delete('doc1');\n\n      store.switchBranch('main');\n      expect(store.get('doc1')).toEqual({ name: 'test' });\n    });\n\n    it('lists all branches', () => {\n      store.createBranch('feature1');\n      store.createBranch('feature2');\n      const branches = store.listBranches();\n      expect(branches).toContain('main');\n      expect(branches).toContain('feature1');\n      expect(branches).toContain('feature2');\n    });\n\n    it('branch inherits version history from parent', () => {\n      store.create('doc1', { name: 'v1' });\n      store.update('doc1', { name: 'v2' });\n\n      store.createBranch('feature');\n      store.switchBranch('feature');\n\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(2);\n      expect(history[0].content).toEqual({ name: 'v1' });\n      expect(history[1].content).toEqual({ name: 'v2' });\n    });\n  });\n\n  // ─── Merging ──────────────────────────────────────────────────────────────\n\n  describe('Merging', () => {\n    it('merges with no changes is a no-op', () => {\n      store.create('doc1', { name: 'test' });\n      store.createBranch('feature');\n      store.switchBranch('main');\n\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(result.merged['doc1']).toEqual({ name: 'test' });\n    });\n\n    it('merges changes from feature to main (no conflict)', () => {\n      store.create('doc1', { name: 'test', value: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { name: 'test', value: 2 });\n\n      store.switchBranch('main');\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(store.get('doc1')).toEqual({ name: 'test', value: 2 });\n    });\n\n    it('merges changes to different documents on different branches', () => {\n      store.create('doc1', { name: 'doc1' });\n      store.create('doc2', { name: 'doc2' });\n\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { name: 'doc1-feature' });\n\n      store.switchBranch('main');\n      store.update('doc2', { name: 'doc2-main' });\n\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(store.get('doc1')).toEqual({ name: 'doc1-feature' });\n      expect(store.get('doc2')).toEqual({ name: 'doc2-main' });\n    });\n\n    it('detects conflict when both branches change the same field differently', () => {\n      store.create('doc1', { name: 'test', value: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { name: 'test', value: 2 });\n\n      store.switchBranch('main');\n      store.update('doc1', { name: 'test', value: 3 });\n\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(false);\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].documentId).toBe('doc1');\n      expect(result.conflicts[0].path).toBe('value');\n      expect(result.conflicts[0].base).toBe(1);\n      expect(result.conflicts[0].ours).toBe(3);\n      expect(result.conflicts[0].theirs).toBe(2);\n    });\n\n    it('does not apply merge when there are conflicts', () => {\n      store.create('doc1', { name: 'test', value: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { name: 'test', value: 2 });\n\n      store.switchBranch('main');\n      store.update('doc1', { name: 'test', value: 3 });\n\n      store.merge('feature');\n\n      // Main branch should still have value: 3\n      expect(store.get('doc1')).toEqual({ name: 'test', value: 3 });\n    });\n\n    it('no conflict when both branches change to the same value', () => {\n      store.create('doc1', { name: 'test', value: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { name: 'test', value: 2 });\n\n      store.switchBranch('main');\n      store.update('doc1', { name: 'test', value: 2 });\n\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(store.get('doc1')).toEqual({ name: 'test', value: 2 });\n    });\n\n    it('merges nested objects without conflict when changes are on different fields', () => {\n      store.create('doc1', { a: { x: 1, y: 1 }, b: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: { x: 2, y: 1 }, b: 1 });\n\n      store.switchBranch('main');\n      store.update('doc1', { a: { x: 1, y: 2 }, b: 1 });\n\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(store.get('doc1')).toEqual({ a: { x: 2, y: 2 }, b: 1 });\n    });\n\n    it('detects conflict in nested objects', () => {\n      store.create('doc1', { a: { x: 1, y: 1 } });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: { x: 2, y: 1 } });\n\n      store.switchBranch('main');\n      store.update('doc1', { a: { x: 3, y: 1 } });\n\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(false);\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].path).toBe('a.x');\n      expect(result.conflicts[0].base).toBe(1);\n      expect(result.conflicts[0].ours).toBe(3);\n      expect(result.conflicts[0].theirs).toBe(2);\n    });\n\n    it('merges new document added on feature branch', () => {\n      store.create('doc1', { name: 'test' });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc2', { name: 'new-doc' });\n\n      store.switchBranch('main');\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(store.get('doc2')).toEqual({ name: 'new-doc' });\n    });\n\n    it('merges document deleted on feature branch', () => {\n      store.create('doc1', { name: 'test' });\n      store.create('doc2', { name: 'to-delete' });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.delete('doc2');\n\n      store.switchBranch('main');\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(() => store.get('doc2')).toThrow('Document \"doc2\" does not exist');\n    });\n\n    it('conflict when one side deletes and other side modifies', () => {\n      store.create('doc1', { name: 'test', value: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.delete('doc1');\n\n      store.switchBranch('main');\n      store.update('doc1', { name: 'test', value: 2 });\n\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(false);\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].documentId).toBe('doc1');\n      expect(result.conflicts[0].path).toBe('');\n    });\n\n    it('merged field contains ours-wins resolution for display', () => {\n      store.create('doc1', { name: 'test', value: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { name: 'test', value: 2 });\n\n      store.switchBranch('main');\n      store.update('doc1', { name: 'test', value: 3 });\n\n      const result = store.merge('feature');\n\n      // merged should show ours-wins\n      expect(result.merged['doc1']).toEqual({ name: 'test', value: 3 });\n    });\n\n    it('throws when merging a branch into itself', () => {\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(() => store.merge('feature')).toThrow('Cannot merge a branch into itself');\n    });\n\n    it('throws when merging from non-existent branch', () => {\n      expect(() => store.merge('nonexistent')).toThrow('Source branch \"nonexistent\" does not exist');\n    });\n\n    it('merges new field added on feature branch', () => {\n      store.create('doc1', { name: 'test' });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { name: 'test', extra: 'field' });\n\n      store.switchBranch('main');\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(store.get('doc1')).toEqual({ name: 'test', extra: 'field' });\n    });\n\n    it('merges field deletion on feature branch', () => {\n      store.create('doc1', { name: 'test', extra: 'field' });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { name: 'test' });\n\n      store.switchBranch('main');\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(store.get('doc1')).toEqual({ name: 'test' });\n    });\n\n    it('handles arrays as atomic values', () => {\n      store.create('doc1', { items: [1, 2, 3] });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { items: [1, 2, 3, 4] });\n\n      store.switchBranch('main');\n      store.update('doc1', { items: [1, 2, 3, 5] });\n\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(false);\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].path).toBe('items');\n    });\n\n    it('handles deep nested conflicts', () => {\n      store.create('doc1', { a: { b: { c: 1, d: 1 } } });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: { b: { c: 2, d: 1 } } });\n\n      store.switchBranch('main');\n      store.update('doc1', { a: { b: { c: 3, d: 1 } } });\n\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(false);\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].path).toBe('a.b.c');\n    });\n\n    it('handles deep nested non-conflicting changes', () => {\n      store.create('doc1', { a: { b: { c: 1, d: 1 } } });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: { b: { c: 2, d: 1 } } });\n\n      store.switchBranch('main');\n      store.update('doc1', { a: { b: { c: 1, d: 2 } } });\n\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(store.get('doc1')).toEqual({ a: { b: { c: 2, d: 2 } } });\n    });\n\n    it('creates version on merge apply', () => {\n      store.create('doc1', { name: 'v1' });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { name: 'v2' });\n\n      store.switchBranch('main');\n      store.merge('feature');\n\n      const history = store.getHistory('doc1');\n      // v1 (create) + v2 (merge apply)\n      expect(history.length).toBeGreaterThanOrEqual(2);\n    });\n\n    it('handles merge with multiple documents and mixed changes', () => {\n      store.create('doc1', { name: 'doc1', value: 1 });\n      store.create('doc2', { name: 'doc2', value: 1 });\n      store.create('doc3', { name: 'doc3', value: 1 });\n\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      // Feature: change doc1, add doc4\n      store.update('doc1', { name: 'doc1', value: 2 });\n      store.create('doc4', { name: 'doc4', value: 1 });\n\n      store.switchBranch('main');\n      // Main: change doc2, delete doc3\n      store.update('doc2', { name: 'doc2', value: 2 });\n      store.delete('doc3');\n\n      const result = store.merge('feature');\n\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n\n      // doc1 should have feature's value\n      expect(store.get('doc1')).toEqual({ name: 'doc1', value: 2 });\n      // doc2 should have main's value\n      expect(store.get('doc2')).toEqual({ name: 'doc2', value: 2 });\n      // doc3 should be deleted\n      expect(() => store.get('doc3')).toThrow('Document \"doc3\" does not exist');\n      // doc4 should exist (from feature)\n      expect(store.get('doc4')).toEqual({ name: 'doc4', value: 1 });\n    });\n  });\n});\n","numLines":566,"startLine":1,"totalLines":566}}}
