+import { BranchSnapshot } from './types.js';
+
+/** Deep clone a JSON-serializable value. */
+export function deepClone<T>(value: T): T {
+  return structuredClone(value);
+}
+
+/** Generate a unique version ID. */
+let _versionCounter = 0;
+export function generateVersionId(): string {
+  _versionCounter += 1;
+  return `v${Date.now()}_${_versionCounter}`;
+}
+
+/** Take a snapshot of the current documents on a branch. */
+export function takeSnapshot(documents: Map<string, { content: object }>): BranchSnapshot {
+  const documentIds = new Set(documents.keys());
+  const docs = new Map<string, object>();
+  for (const [id, stored] of documents) {
+    docs.set(id, deepClone(stored.content));
+  }
+  return { documentIds, documents: docs };
+}
