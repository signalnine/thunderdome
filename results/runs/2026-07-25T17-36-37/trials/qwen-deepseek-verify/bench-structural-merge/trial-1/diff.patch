────\n\n  create(id: string, content: object): void {\n    const branch = this.getCurrentBranch();\n    if (branch.documents.has(id)) {\n      throw new Error(`Document \"${id}\" already exists on branch \"${this.currentBranchName}\"`);\n    }\n\n    const version: Version = {\n      id: generateVersionId(),\n      timestamp: Date.now(),\n      content: deepClone(content),\n    };\n\n    const stored: StoredDocument = {\n      content: deepClone(content),\n      versions: [version],\n    };\n\n    branch.documents.set(id, stored);\n  }\n\n  get(id: string): object {\n    const branch = this.getCurrentBranch();\n    const doc = branch.documents.get(id);\n    if (!doc) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.currentBranchName}\"`);\n    }\n    return deepClone(doc.content);\n  }\n\n  update(id: string, content: object): void {\n    const branch = this.getCurrentBranch();\n    const doc = branch.documents.get(id);\n    if (!doc) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.currentBranchName}\"`);\n    }\n\n    const version: Version = {\n      id: generateVersionId(),\n      timestamp: Date.now(),\n      content: deepClone(content),\n    };\n\n    doc.content = deepClone(content);\n    doc.versions.push(version);\n  }\n\n  delete(id: string): void {\n    const branch = this.getCurrentBranch();\n    if (!branch.documents.has(id)) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.currentBranchName}\"`);\n    }\n    branch.documents.delete(id);\n  }\n\n  // ─── Version History ──────────────────────────────────────────────────────\n\n  getHistory(id: string): Version[] {\n    const branch = this.getCurrentBranch();\n    const doc = branch.documents.get(id);\n    if (!doc) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.currentBranchName}\"`);\n    }\n    return doc.versions.map((v) => deepClone(v));\n  }\n\n  getVersion(id: string, versionId: string): object {\n    const branch = this.getCurrentBranch();\n    const doc = branch.documents.get(id);\n    if (!doc) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.currentBranchName}\"`);\n    }\n    const version = doc.versions.find((v) => v.id === versionId);\n    if (!version) {\n      throw new Error(\n        `Version \"${versionId}\" not found for document \"${id}\" on branch \"${this.currentBranchName}\"`,\n      );\n    }\n    return deepClone(version.content);\n  }\n\n  // ─── Branching ────────────────────────────────────────────────────────────\n\n  createBranch(name: string, fromBranch?: string): void {\n    if (this.branches.has(name)) {\n      throw new Error(`Branch \"${name}\" already exists`);\n    }\n\n    const sourceName = fromBranch ?? this.currentBranchName;\n    const sourceBranch = this.branches.get(sourceName);\n    if (!sourceBranch) {\n      throw new Error(`Branch \"${sourceName}\" does not exist`);\n    }\n\n    // Take a snapshot of the source branch at this point\n    const snapshot = takeSnapshot(sourceBranch.documents);\n\n    // Deep-clone the documents for the new branch\n    const documents = new Map<string, StoredDocument>();\n    for (const [id, stored] of sourceBranch.documents) {\n      documents.set(id, {\n        content: deepClone(stored.content),\n        versions: stored.versions.map((v) => deepClone(v)),\n      });\n    }\n\n    const newBranch: BranchState = {\n      name,\n      documents,\n      parentBranch: sourceName,\n      parentSnapshot: snapshot,\n    };\n\n    this.branches.set(name, newBranch);\n  }\n\n  switchBranch(name: string): void {\n    if (!this.branches.has(name)) {\n      throw new Error(`Branch \"${name}\" does not exist`);\n    }\n    this.currentBranchName = name;\n  }\n\n  getBranch(): string {\n    return this.currentBranchName;\n  }\n\n  listBranches(): string[] {\n    return Array.from(this.branches.keys());\n  }\n\n  // ─── Merging ──────────────────────────────────────────────────────────────\n\n  merge(sourceBranchName: string): MergeResult {\n    if (sourceBranchName === this.currentBranchName) {\n      throw new Error('Cannot merge a branch into itself');\n    }\n\n    const currentBranch = this.branches.get(this.currentBranchName);\n    const sourceBranch = this.branches.get(sourceBranchName);\n\n    if (!currentBranch) {\n      throw new Error(`Current branch \"${this.currentBranchName}\" does not exist`);\n    }\n    if (!sourceBranch) {\n      throw new Error(`Source branch \"${sourceBranchName}\" does not exist`);\n    }\n\n    // Find the common ancestor\n    const ancestor = findCommonAncestor(\n      { name: currentBranch.name, parentBranch: currentBranch.parentBranch, parentSnapshot: currentBranch.parentSnapshot },\n      { name: sourceBranch.name, parentBranch: sourceBranch.parentBranch, parentSnapshot: sourceBranch.parentSnapshot },\n    );\n\n    // Compute the merge\n    const result = computeMerge(\n      this.currentBranchName,\n      sourceBranchName,\n      currentBranch.documents,\n      sourceBranch.documents,\n      ancestor.documents,\n      ancestor.documentIds,\n    );\n\n    // If no conflicts, apply the merge to the current branch\n    if (result.applied) {\n      this.applyMerge(result.merged);\n    }\n\n    return result;\n  }\n\n  /** Apply the merged document contents to the current branch. */\n  private applyMerge(merged: Record<string, object>): void {\n    const branch = this.getCurrentBranch();\n\n    for (const [docId, content] of Object.entries(merged)) {\n      if (branch.documents.has(docId)) {\n        // Update existing document\n        const doc = branch.documents.get(docId)!;\n        const version: Version = {\n          id: generateVersionId(),\n          timestamp: Date.now(),\n          content: deepClone(content),\n        };\n        doc.content = deepClone(content);\n        doc.versions.push(version);\n      } else {\n        // Create new document from merge\n        const version: Version = {\n          id: generateVersionId(),\n          timestamp: Date.now(),\n          content: deepClone(content),\n        };\n        branch.documents.set(docId, {\n          content: deepClone(content),\n          versions: [version],\n        });\n      }\n    }\n\n    // Delete documents that are not in the merged result\n    for (const docId of branch.documents.keys()) {\n      if (!(docId in merged)) {\n        branch.documents.delete(docId);\n      }\n    }\n  }\n\n  // ─── Internal Helpers ─────────────────────────────────────────────────────\n\n  private getCurrentBranch(): BranchState {\n    const branch = this.branches.get(this.currentBranchName);\n    if (!branch) {\n      throw new Error(`Branch \"${this.currentBranchName}\" does not exist`);\n    }\n    return branch;\n  }\n}\n\nexport { DocumentStore as default };\n","structuredPatch":[{"oldStart":6,"oldLines":9,"newStart":6,"newLines":9,"lines":["   MergeResult,","   StoredDocument,","   Version,","-} from './types';","-import { deepClone, generateVersionId, takeSnapshot } from './utils';","-import { computeMerge, findCommonAncestor } from './merge';","+} from './types.js';","+import { deepClone, generateVersionId, takeSnapshot } from './utils.js';","+import { computeMerge, findCommonAncestor } from './merge.js';"," "," /**","  * In-memory versioned document store with branching and three-way merge."]}],"userModified":false,"replaceAll":false}}
