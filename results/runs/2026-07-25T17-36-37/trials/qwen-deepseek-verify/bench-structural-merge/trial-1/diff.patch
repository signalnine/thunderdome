: Conflict[] = [];\n\n  // Collect all document IDs from all three states\n  const allDocIds = new Set([\n    ...currentDocs.keys(),\n    ...sourceDocs.keys(),\n    ...ancestorIds,\n  ]);\n\n  for (const docId of allDocIds) {\n    const inAncestor = ancestorIds.has(docId);\n    const inCurrent = currentDocs.has(docId);\n    const inSource = sourceDocs.has(docId);\n\n    const ancestorContent = inAncestor ? ancestorDocs.get(docId)! : {};\n    const currentContent = inCurrent ? deepClone(currentDocs.get(docId)!.content) : {};\n    const sourceContent = inSource ? deepClone(sourceDocs.get(docId)!.content) : {};\n\n    // If document only exists on current branch, take it\n    if (!inAncestor && inCurrent && !inSource) {\n      merged[docId] = deepClone(currentContent);\n      continue;\n    }\n\n    // If document only exists on source branch, take it\n    if (!inAncestor && !inCurrent && inSource) {\n      merged[docId] = deepClone(sourceContent);\n      continue;\n    }\n\n    // If document only exists on ancestor (deleted on both), skip\n    if (inAncestor && !inCurrent && !inSource) {\n      continue;\n    }\n\n    // If document was deleted on current but exists on source\n    if (inAncestor && !inCurrent && inSource) {\n      if (deepEqual(ancestorContent, sourceContent)) {\n        // Source didn't change it, we deleted it -> deletion wins\n        continue;\n      }\n      // Source changed it, we deleted it -> conflict at document level\n      allConflicts.push({\n        documentId: docId,\n        path: '',\n        base: deepClone(ancestorContent),\n        ours: undefined,\n        theirs: deepClone(sourceContent),\n      });\n      // For merged output, take ours (undefined = deleted)\n      continue;\n    }\n\n    // If document was deleted on source but exists on current\n    if (inAncestor && inCurrent && !inSource) {\n      if (deepEqual(ancestorContent, currentContent)) {\n        // Current didn't change it, source deleted it -> deletion wins\n        continue;\n      }\n      // Current changed it, source deleted it -> conflict at document level\n      allConflicts.push({\n        documentId: docId,\n        path: '',\n        base: deepClone(ancestorContent),\n        ours: deepClone(currentContent),\n        theirs: undefined,\n      });\n      // For merged output, take ours\n      merged[docId] = deepClone(currentContent);\n      continue;\n    }\n\n    // Document exists on ancestor and at least one of current/source\n    if (inAncestor) {\n      const result = threeWayMerge(\n        ancestorContent as Record<string, unknown>,\n        currentContent as Record<string, unknown>,\n        sourceContent as Record<string, unknown>,\n        docId,\n      );\n      merged[docId] = result.merged;\n      allConflicts.push(...result.conflicts);\n      continue;\n    }\n\n    // Document not in ancestor but in both current and source (both added independently)\n    if (!inAncestor && inCurrent && inSource) {\n      if (deepEqual(currentContent, sourceContent)) {\n        // Both added the same thing\n        merged[docId] = deepClone(currentContent);\n      } else {\n        // Both added different things -> conflict\n        allConflicts.push({\n          documentId: docId,\n          path: '',\n          base: undefined,\n          ours: deepClone(currentContent),\n          theirs: deepClone(sourceContent),\n        });\n        // For merged output, take ours\n        merged[docId] = deepClone(currentContent);\n      }\n    }\n  }\n\n  const applied = allConflicts.length === 0;\n\n  return { merged, conflicts: allConflicts, applied };\n}\n","structuredPatch":[{"oldStart":199,"oldLines":8,"newStart":199,"newLines":16,"lines":["  * branch creation time.","  */"," export function findCommonAncestor(","-  branchA: { name: string; parentBranch: string | null; parentSnapshot: any },","-  branchB: { name: string; parentBranch: string | null; parentSnapshot: any },","+  branchA: {","+    name: string;","+    parent