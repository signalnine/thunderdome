ed: Record<string, unknown> = {};\n  const conflicts: Conflict[] = [];\n\n  // Collect all keys from all three objects\n  const allKeys = new Set([\n    ...Object.keys(base),\n    ...Object.keys(ours),\n    ...Object.keys(theirs),\n  ]);\n\n  for (const key of allKeys) {\n    const path = prefix ? `${prefix}.${key}` : key;\n    const baseVal = base[key];\n    const oursVal = ours[key];\n    const theirsVal = theirs[key];\n\n    const inBase = key in base;\n    const inOurs = key in ours;\n    const inTheirs = key in theirs;\n\n    // Case: key only in ours (added on our branch)\n    if (!inBase && inOurs && !inTheirs) {\n      merged[key] = deepClone(oursVal);\n      continue;\n    }\n\n    // Case: key only in theirs (added on their branch)\n    if (!inBase && !inOurs && inTheirs) {\n      merged[key] = deepClone(theirsVal);\n      continue;\n    }\n\n    // Case: key in base and ours, but not theirs (deleted on their branch)\n    if (inBase && inOurs && !inTheirs) {\n      // Their branch deleted it; ours kept it\n      if (deepEqual(baseVal, oursVal)) {\n        // We didn't change it, they deleted it -> take deletion\n        continue;\n      }\n      // We changed it, they deleted it -> conflict\n      conflicts.push({\n        documentId,\n        path,\n        base: deepClone(baseVal),\n        ours: deepClone(oursVal),\n        theirs: undefined,\n      });\n      // For merged output, take ours (ours wins for display)\n      merged[key] = deepClone(oursVal);\n      continue;\n    }\n\n    // Case: key in base and theirs, but not ours (deleted on our branch)\n    if (inBase && !inOurs && inTheirs) {\n      if (deepEqual(baseVal, theirsVal)) {\n        // They didn't change it, we deleted it -> take deletion\n        continue;\n      }\n      // They changed it, we deleted it -> conflict\n      conflicts.push({\n        documentId,\n        path,\n        base: deepClone(baseVal),\n        ours: undefined,\n        theirs: deepClone(theirsVal),\n      });\n      // For merged output, take theirs (ours wins means we take ours=undefined)\n      merged[key] = undefined;\n      continue;\n    }\n\n    // Case: key in all three\n    if (inBase && inOurs && inTheirs) {\n      // Both unchanged from base\n      if (deepEqual(baseVal, oursVal) && deepEqual(baseVal, theirsVal)) {\n        merged[key] = deepClone(baseVal);\n        continue;\n      }\n\n      // Only ours changed\n      if (deepEqual(baseVal, theirsVal)) {\n        merged[key] = deepClone(oursVal);\n        continue;\n      }\n\n      // Only theirs changed\n      if (deepEqual(baseVal, oursVal)) {\n        merged[key] = deepClone(theirsVal);\n        continue;\n      }\n\n      // Both changed to the same value\n      if (deepEqual(oursVal, theirsVal)) {\n        merged[key] = deepClone(oursVal);\n        continue;\n      }\n\n      // Both changed to different values -> recurse if both are objects, else conflict\n      if (isObject(oursVal) && isObject(theirsVal) && isObject(baseVal)) {\n        const sub = threeWayMerge(\n          baseVal as Record<string, unknown>,\n          oursVal as Record<string, unknown>,\n          theirsVal as Record<string, unknown>,\n          documentId,\n          path,\n        );\n        merged[key] = sub.merged;\n        conflicts.push(...sub.conflicts);\n        continue;\n      }\n\n      // Conflict: both changed to different values\n      conflicts.push({\n        documentId,\n        path,\n        base: deepClone(baseVal),\n        ours: deepClone(oursVal),\n        theirs: deepClone(theirsVal),\n      });\n      // For merged output, take ours\n      merged[key] = deepClone(oursVal);\n      continue;\n    }\n\n    // Case: key in none of them (shouldn't happen, but handle gracefully)\n    if (!inBase && !inOurs && !inTheirs) {\n      continue;\n    }\n\n    // Case: key in base only (deleted on both branches)\n    if (inBase && !inOurs && !inTheirs) {\n      continue;\n    }\n  }\n\n  return { merged, conflicts };\n}\n\n/** Check if a value is a plain object (not null, not array). */\nfunction isObject(value: unknown): value is object {\n  return value !== null && typeof value === 'object' && !Array.isArray(value);\n}\n\n/** Deep equality check for JSON-serializable values. */\nfunction deepEqual(a: unknown, b: unknown): boolean {\n  if (a === b) return true;\n  if (a === null || b === null) return a === b;\n  if (typeof a !== typeof b) return false;\n  if (typeof a !== 'object') return false;\n\n  if (Array.isArray(a) !== Array.isArray(b)) return false;\n\n  if (Array.isArray(a)) {\n    if ((a as unknown[]).length !== (b as unknown[]).length) return false;\n    for (let i = 0; i < a.length; i++) {\n      if (!deepEqual(a[i], (b as unknown[])[i])) return false;\n    }\n    return true;\n  }\n\n  const keysA = Object.keys(a as object);\n  const keysB = Object.keys(b as object);\n  if (keysA.length !== keysB.length) return false;\n  for (const key of keysA) {\n    if (!(key in (b as object))) return false;\n    if (!deepEqual((a as Record<string, unknown>)[key], (b as Record<string, unknown>)[key])) {\n      return false;\n    }\n  }\n  return true;\n}\n\n/**\n * Compute the common ancestor state between two branches.\n *\n * The common ancestor is the state at the point where the branches diverged.\n * For a branch created from another branch, this is the snapshot taken at\n * branch creation time.\n */\nexport function findCommonAncestor(\n  branchA: { name: string; parentBranch: string | null; parentSnapshot: any },\n  branchB: { name: string; parentBranch: string | null; parentSnapshot: any },\n): { documents: Map<string, object>; documentIds: Set<string> } {\n  // If branchA was created from branchB, the ancestor is branchA's parent snapshot\n  if (branchA.parentBranch === branchB.name) {\n    return {\n      documents: branchA.parentSnapshot!.documents,\n      documentIds: branchA.parentSnapshot!.documentIds,\n    };\n  }\n\n  // If branchB was created from branchA, the ance