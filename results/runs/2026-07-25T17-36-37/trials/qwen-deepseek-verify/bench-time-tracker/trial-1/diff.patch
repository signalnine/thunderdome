+import { mkdirSync, readFileSync, writeFileSync, existsSync } from 'fs';
+import { dirname } from 'path';
+
+export interface Entry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+interface PersistedData {
+  entries: Entry[];
+}
+
+export class TimeTracker {
+  private filePath: string;
+  private entries: Entry[];
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = this.load();
+  }
+
+  private load(): Entry[] {
+    if (!existsSync(this.filePath)) {
+      return [];
+    }
+    try {
+      const raw = readFileSync(this.filePath, 'utf-8');
+      const data: PersistedData = JSON.parse(raw);
+      return data.entries ?? [];
+    } catch {
+      return [];
+    }
+  }
+
+  private save(): void {
+    const dir = dirname(this.filePath);
+    if (!existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+    const data: PersistedData = { entries: this.entries };
+    writeFileSync(this.filePath, JSON.stringify(data, null, 2), 'utf-8');
+  }
+
+  start(taskName: string): Entry {
+    if (!taskName) {
+      throw new Error('Task name must not be empty');
+    }
+
+    // Auto-stop any currently running task
+    const active = this.getActiveTask();
+    if (active !== null) {
+      active.endTime = new Date().toISOString();
+    }
+
+    const entry: Entry = {
+      taskName,
+      startTime: new Date().toISOString(),
+      endTime: null,
+    };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  stop(): Entry {
+    const active = this.getActiveTask();
+    if (active === null) {
+      throw new Error('No task is currently running');
+    }
+    active.endTime = new Date().toISOString();
+    this.save();
+    return active;
+  }
+
+  getActiveTask(): Entry | null {
+    for (let i = this.entries.length - 1; i >= 0; i--) {
+      if (this.entries[i].endTime === null) {
+        return this.entries[i];
+      }
+    }
+    return null;
+  }
+
+  getLog(options?: { since?: Date }): Entry[] {
+    if (!options?.since) {
+      return this.entries;
+    }
+    const sinceMs = options.since.getTime();
+    return this.entries.filter((entry) => {
+      const startMs = new Date(entry.startTime).getTime();
+      // Include if started on or after since
+      if (startMs >= sinceMs) {
+        return true;
+      }
+      // Include if still running (endTime is null)
+      if (entry.endTime === null) {
+        return true;
+      }
+      // Include if endTime is on or after since (spanning the boundary)
+      const endMs = new Date(entry.endTime).getTime();
+      if (endMs >= sinceMs) {
+        return true;
+      }
+      return false;
+    });
+  }
+
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+    const now = Date.now();
+
+    for (const entry of this.entries) {
+      const startMs = new Date(entry.startTime).getTime();
+      let endMs: number;
+      if (entry.endTime === null) {
+        endMs = now;
+      } else {
+        endMs = new Date(entry.endTime).getTime();
+      }
+      const duration = endMs - startMs;
+      summary[entry.taskName] = (summary[entry.taskName] ?? 0) + duration;
+    }
+
+    return summary;
+  }
+}
