uateFormula, getFormulaDeps, parseFormula } from './formula';\n\n/** A cell entry: either a raw value or a formula string. */\ninterface CellEntry {\n  raw: string | number | boolean;\n  computed: string | number | boolean | null;\n  formula: string | null; // the formula string (without =) if it's a formula\n}\n\n/** Parse a raw value: if it's a quoted string, strip the quotes. */\nfunction parseRawValue(value: string | number | boolean): string | number | boolean {\n  if (typeof value === 'string' && value.startsWith('\"') && value.endsWith('\"') && value.length >= 2) {\n    return value.slice(1, -1);\n  }\n  return value;\n}\n\nexport class Spreadsheet {\n  private cells: Map<string, CellEntry> = new Map();\n  /** Forward deps: cell -> set of cells that depend on it. */\n  private dependents: Map<string, Set<string>> = new Map();\n\n  /** Set a cell's value. Can be a raw value or a formula string starting with '='. */\n  set(cell: string, value: string | number | boolean): void {\n    const normalized = cell.toUpperCase();\n\n    // If it's a formula, strip the leading =\n    let formula: string | null = null;\n    let raw: string | number | boolean = value;\n\n    if (typeof value === 'string' && value.startsWith('=')) {\n      formula = value.slice(1);\n      raw = value;\n    }\n\n    // Remove old dependencies for this cell\n    this.removeDeps(normalized);\n\n    // If it's a formula, compute dependencies and check for circular refs\n    if (formula !== null) {\n      const deps = getFormulaDeps(formula);\n\n      // Check for circular references\n      if (this.wouldCreateCycle(normalized, deps)) {\n        throw new Error(`Circular reference detected involving ${normalized}`);\n      }\n\n      // Register dependencies\n      for (const dep of deps) {\n        const depUpper = dep.toUpperCase();\n        if (!this.dependents.has(depUpper)) {\n          this.dependents.set(depUpper, new Set());\n        }\n        this.dependents.get(depUpper)!.add(normalized);\n      }\n    }\n\n    // Store the cell\n    const entry: CellEntry = {\n      raw,\n      computed: null,\n      formula,\n    };\n    this.cells.set(normalized, entry);\n\n    // Compute the value\n    this.computeCell(normalized);\n\n    // Propagate changes to dependents\n    this.propagate(normalized);\n  }\n\n  /** Get a cell's computed value. Returns null for empty cells. */\n  get(cell: string): string | number | boolean | null {\n    const normalized = cell.toUpperCase();\n    const entry = this.cells.get(normalized);\n    if (!entry) return null;\n    return entry.computed;\n  }\n\n  /** Get the display string for a cell's computed value. */\n  getDisplay(cell: string): string {\n    const normalized = cell.toUpperCase();\n    const entry = this.cells.get(normalized);\n    if (!entry) return '';\n    const val = entry.computed;\n    if (val === null) return '';\n    if (typeof val === 'string') return val;\n    if (typeof val === 'boolean') return val ? 'TRUE' : 'FALSE';\n    if (typeof val === 'number') {\n      if (Number.isInteger(val)) return String(val);\n      return String(val);\n    }\n    return String(val);\n  }\n\n  /** Get all non-empty cells as a Map from cell reference to computed value. */\n  getCells(): Map<string, any> {\n    const result = new Map<string, any>();\n    for (const [ref, entry] of this.cells) {\n      if (entry.computed !== null) {\n        result.set(ref, entry.computed);\n      }\n    }\n    return result;\n  }\n\n  // --- Internal methods ---\n\n  private computeCell(cell: string): void {\n    const entry = this.cells.get(cell);\n    if (!entry) return;\n\n    if (entry.formula !== null) {\n      // Evaluate the formula\n      const ctx = {\n        getCellValue: (ref: string) => {\n          const refUpper = ref.toUpperCase();\n          const depEntry = this.cells.get(refUpper);\n          if (!depEntry) return null;\n          return depEntry.computed;\n        },\n        collectDeps: (_ref: string) => {\n      