mber | boolean): void {\n    const normalized = cell.toUpperCase();\n\n    // If it's a formula, strip the leading =\n    let formula: string | null = null;\n    let raw: string | number | boolean = value;\n\n    if (typeof value === 'string' && value.startsWith('=')) {\n      formula = value.slice(1);\n      raw = value;\n    }\n\n    // Remove old dependencies for this cell\n    this.removeDeps(normalized);\n\n    // If it's a formula, compute dependencies and check for circular refs\n    if (formula !== null) {\n      const deps = getFormulaDeps(formula);\n\n      // Check for circular references\n      if (this.wouldCreateCycle(normalized, deps)) {\n        throw new Error(`Circular reference detected involving ${normalized}`);\n      }\n\n      // Register dependencies\n      for (const dep of deps) {\n        const depUpper = dep.toUpperCase();\n        if (!this.dependents.has(depUpper)) {\n          this.dependents.set(depUpper, new Set());\n        }\n        this.dependents.get(depUpper)!.add(normalized);\n      }\n    }\n\n    // Store the cell\n    const entry: CellEntry = {\n      raw,\n      computed: null,\n      formula,\n    };\n    this.cells.set(normalized, entry);\n\n    // Compute the value\n    this.computeCell(normalized);\n\n    // Propagate changes to dependents\n    this.propagate(normalized);\n  }\n\n  /** Get a cell's computed value. Returns null for empty cells. */\n  get(cell: string): string | number | boolean | null {\n    const normalized = cell.toUpperCase();\n    const entry = this.cells.get(normalized);\n    if (!entry) return null;\n    return entry.computed;\n  }\n\n  /** Get the display string for a cell's computed value. */\n  getDisplay(cell: string): string {\n    const normalized = cell.toUpperCase();\n    const entry = this.cells.get(normalized);\n    if (!entry) return '';\n    const val = entry.computed;\n    if (val === null) return '';\n    if (typeof val === 'string') return val;\n    if (typeof val === 'boolean') return val ? 'TRUE' : 'FALSE';\n    if (typeof val === 'number') {\n      if (Number.isInteger(val)) return String(val);\n      return String(val);\n    }\n    return String(val);\n  }\n\n  /** Get all non-empty cells as a Map from cell reference to computed value. */\n  getCells(): Map<string, any> {\n    const result = new Map<string, any>();\n    for (const [ref, entry] of this.cells) {\n      if (entry.computed !== null) {\n        result.set(ref, entry.computed);\n      }\n    }\n    return result;\n  }\n\n  // --- Internal methods ---\n\n  private computeCell(cell: string): void {\n    const entry = this.cells.get(cell);\n    if (!entry) return;\n\n    if (entry.formula !== null) {\n      // Evaluate the formula\n      const ctx = {\n        getCellValue: (ref: string) => {\n          const refUpper = ref.toUpperCase();\n          const depEntry = this.cells.get(refUpper);\n          if (!depEntry) return null;\n          return depEntry.computed;\n        },\n        collectDeps: (_ref: string) => {\n          // Dependencies are already tracked at set time\n        },\n      };\n      try {\n        entry.computed = evaluateFormula(entry.formula, ctx);\n      } catch (e) {\n        entry.computed = '#ERROR';\n      }\n    } else {\n      // Raw value: parse string literals (strip quotes)\n      entry.computed = parseRawValue(entry.raw);\n    }\n  }\n\n  private propagate(cell: string): void {\n    const deps = this.dependents.get(cell);\n    if (!deps) return;\n\n    // Use a queue to propagate transitively\n    const queue = Array.from(deps);\n    const visited = new Set<string>();\n\n    while (queue.length > 0) {\n      const dep = queue.shift()!;\n      if (visited.has(dep)) continue;\n      visited.add(dep);\n\n      this.computeCell(dep);\n\n      // Propagate further\n      const nextDeps = this.dependents.get(dep);\n      if (nextDeps) {\n        for (const next of nextDeps) {\n          if (!visited.has(next)) {\n            queue.push(next);\n          }\n        }\n      }\n    }\n  }\n\n  private removeDeps(cell: string): void {\n    // Remove this cell from the dependents list of all cells it depends on\n    // (i.e., if A1's formula references B1, remove A1 from B1's dependents set)\n    const entry = this.cells.get(cell);\n    if (entry && entry.formula !== null) {\n      const deps = getFormulaDeps(entry.formula);\n      for (const dep of deps) {\n        const depUpper = dep.toUpperCase();\n        const depSet = this.dependents.get(depUpper);\n        if (depSet) {\n          depSet.delete(cell);\n          if (depSet.size === 0) {\n            this.dependents.delete(depUpper);\n          }\n        }\n      }\n    }\n  }\n\n  /** Check if adding the given dependencies would create a cycle. */\n  private wouldCreateCycle(cell: string, deps: string[]): boolean {\n    // For each dependency, check if the cell is reachable from that dependency\n    // through the existing dependency graph\n    for (const dep of deps) {\n      const depUpper = dep.toUpperCase();\n      if (depUpper === cell) {\n        return true; // self-reference\n      }\n      if (this.canReach(depUpper, cell)) {\n        return true;\n      }\n    }\n    return false;\n  }\n\n  /** Check if 'target' is reachable from 'start' through the dependency graph. */\n  private canReach(start: string, target: string): boolean {\n    const visited = new Set<string>();\n    const queue: string[] = [start];\n\n    while (queue.length > 0) {\n      const current = queue.shift()!;\n      if (current === target) return true;\n      if (visited.has(current)) continue;\n      visited.add(current);\n\n      const deps = this.dependents.get(current);\n      if (deps) {\n        for (const dep of deps) {\n          if (!visited.has(dep)) {\n            queue.push(dep);\n          }\n        }\n      }\n    }\n    return false;\n  }\n}\n","structuredPatch":[{"oldStart":184,"oldLines":21,"newStart":184,"newLines":21,"lines":["   /** Check if adding the given