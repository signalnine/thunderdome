index 0000000..89ef248
--- /dev/null
+++ b/src/formula.ts
@@ -0,0 +1,581 @@
+import { parseCellRef, formatCellRef } from './cellRef.js';
+import { parseRange } from './range.js';
+
+// --- AST Node Types ---
+
+export type AstNode =
+  | AstLiteral
+  | AstCellRef
+  | AstBinaryOp
+  | AstUnaryMinus
+  | AstFunctionCall;
+
+interface AstLiteral {
+  type: 'literal';
+  value: number | string | boolean;
+}
+
+interface AstCellRef {
+  type: 'cellRef';
+  ref: string;
+}
+
+interface AstBinaryOp {
+  type: 'binary';
+  op: string;
+  left: AstNode;
+  right: AstNode;
+}
+
+interface AstUnaryMinus {
+  type: 'unaryMinus';
+  expr: AstNode;
+}
+
+interface AstFunctionCall {
+  type: 'function';
+  name: string;
+  args: AstNode[];
+}
+
+// --- Token Types ---
+
+type Token =
+  | { type: 'number'; value: number }
+  | { type: 'string'; value: string }
+  | { type: 'boolean'; value: boolean }
+  | { type: 'cellRef'; value: string }
+  | { type: 'range'; value: string }
+  | { type: 'op'; value: string }
+  | { type: 'lparen' }
+  | { type: 'rparen' }
+  | { type: 'comma' }
+  | { type: 'name'; value: string };
+
+// --- Lexer ---
+
+function* tokenize(input: string): Generator<Token> {
+  let pos = 0;
+  const len = input.length;
+
+  while (pos < len) {
+    // Skip whitespace
+    if (input[pos] === ' ') {
+      pos++;
+      continue;
+    }
+
+    // Number (integer or decimal)
+    if (/[0-9]/.test(input[pos])) {
+      let num = '';
+      while (pos < len && /[0-9.]/.test(input[pos])) {
+        num += input[pos++];
+      }
+      yield { type: 'number', value: parseFloat(num) };
+      continue;
+    }
+
+    // String literal
+    if (input[pos] === '"') {
+      pos++; // skip opening quote
+      let str = '';
+      while (pos < len && input[pos] !== '"') {
+        str += input[pos++];
+      }
+      if (pos < len) pos++; // skip closing quote
+      yield { type: 'string', value: str };
+      continue;
+    }
+
+    // Boolean
+    if (input[pos] === 't' && input.slice(pos, 4) === 'true') {
+      pos += 4;
+      yield { type: 'boolean', value: true };
+      continue;
+    }
+    if (input[pos] === 'f' && input.slice(pos, 5) === 'false') {
+      pos += 5;
+      yield { type: 'boolean', value: false };
+      continue;
+    }
+
+    // Cell reference or function name (starts with letter)
+    if (/[A-Z]/i.test(input[pos])) {
+      let name = '';
+      while (pos < len && /[A-Z0-9]/i.test(input[pos])) {
+        name += input[pos++];
+      }
+      // Check if this is a cell reference (letters followed by digits)
+      const cellMatch = name.match(/^([A-Z]+)(\d+)$/);
+      if (cellMatch) {
+        yield { type: 'cellRef', value: name };
+      } else {
+        yield { type: 'name', value: name.toUpperCase() };
+      }
+      continue;
+    }
+
+    // Operators
+    if (input[pos] === '<' && input[pos + 1] === '>') {
+      yield { type: 'op', value: '<>' };
+      pos += 2;
+      continue;
+    }
+    if (input[pos] === '<' && input[pos + 1] === '=') {
+      yield { type: 'op', value: '<=' };
+      pos += 2;
+      continue;
+    }
+    if (input[pos] === '>' && input[pos + 1] === '=') {
+      yield { type: 'op', value: '>=' };
+      pos += 2;
+      continue;
+    }
+    if ('<>=+-*/:'.includes(input[pos])) {
+      yield { type: 'op', value: input[pos] };
+      pos++;
+      continue;
+    }
+
+    // Parentheses
+    if (input[pos] === '(') {
+      yield { type: 'lparen' };
+      pos++;
+      continue;
+    }
+    if (input[pos] === ')') {
+      yield { type: 'rparen' };
+      pos++;
+      continue;
+    }
+
+    // Comma
+    if (input[pos] === ',') {
+      yield { type: 'comma' };
+      pos++;
+      continue;
+    }
+
+    throw new Error(`Unexpected character: ${input[pos]} at position ${pos}`);
+  }
+}
+
+// --- Parser ---
+
+class Parser {
+  private tokens: Token[];
+  private pos: number;
+
+  constructor(input: string) {
+    this.tokens = Array.from(tokenize(input));
+    this.pos = 0;
+  }
+
+  private peek(): Token {
+    return this.tokens[this.pos];
+  }
+
+  private consume(): Token {
+    return this.tokens[this.pos++];
+  }
+
+  private expect(type: string): Token {
+    const tok = this.consume();
+    if (tok.type !== type) {
+      throw new Error(`Expected ${type} but got ${tok.type}`);
+    }
+    return tok;
+  }
+
+  parse(): AstNode {
+    const node = this.parseExpression();
+    if (this.pos < this.tokens.length) {
+      throw new Error(`Unexpected token: ${JSON.stringify(this.tokens[this.pos])}`);
+    }
+    return node;
+  }
+
+  // Expression: addition/subtraction
+  private parseExpression(): AstNode {
+    let left = this.parseTerm();
+    while (
+      this.pos < this.tokens.length &&
+      this.peek().type === 'op'
+    ) {
+      const tok = this.peek();
+      if (tok.type === 'op' && (tok.value === '+' || tok.value === '-')) {
+        this.consume();
+        const right = this.parseTerm();
+        left = { type: 'binary', op: tok.value, left, right };
+      } else {
+        break;
+      }
+    }
+    return left;
+  }
+
+  // Term: multiplication/division
+  private parseTerm(): AstNode {
+    let left = this.parseComparison();
+    while (
+      this.pos < this.tokens.length &&
+      this.peek().type === 'op'
+    ) {
+      const tok = this.peek();
+      if (tok.type === 'op' && (tok.value === '*' || tok.value === '/')) {
+        this.consume();
+        const right = this.parseComparison();
+        left = { type: 'binary', op: tok.value, left, right };
+      } else {
+        break;
+      }
+    }
+    return left;
+  }
+
+  // Comparison: > < >= <= = <>
+  private parseComparison(): AstNode {
+    let left = this.parseUnary();
+    while (
+      this.pos < this.tokens.length &&
+      this.peek().type === 'op'
+    ) {
+      const tok = this.peek();
+      if (tok.type === 'op' && ['>', '<', '>=', '<=', '=', '<>'].includes(tok.value)) {
+        this.consume();
+        const right = this.parseUnary();
+        left = { type: 'binary', op: tok.value, left, right };
+      } else {
+        break;
+      }
+    }
+    return left;
+  }
+
+  // Unary: -expr
+  private parseUnary(): AstNode {
+    const tok = this.peek();
+    if (tok.type === 'op' && tok.value === '-') {
+      this.consume();
+      const expr = this.parseUnary();
+      return { type: 'unaryMinus', expr };
+    }
+    return this.parsePrimary();
+  }
+
+  // Primary: number, string, boolean, cellRef, range, (expr), functionCall
+  private parsePrimary(): AstNode {
+    const tok = this.peek();
+
+    if (tok.type === 'number') {
+      this.consume();
+      return { type: 'literal', value: tok.value };
+    }
+
+    if (tok.type === 'string') {
+      this.consume();
+      return { type: 'literal', value: tok.value };
+    }
+
+    if (tok.type === 'boolean') {
+      this.consume();
+      return { type: 'literal', value: tok.value };
+    }
+
+    if (tok.type === 'cellRef') {
+      this.consume();
+      // Check if followed by : (range)
+      if (
+        this.pos < this.tokens.length &&
+        this.peek().type === 'op' &&
+        this.peek().value === ':'
+      ) {
+        this.consume(); // consume :
+        const endTok = this.expect('cellRef');
+        return { type: 'cellRef', ref: `${tok.value}:${endTok.value}` };
+      }
+      return { type: 'cellRef', ref: tok.value };
+    }
+
+    if (tok.type === 'name') {
+      this.consume();
+      // Function call
+      if (this.peek().type === 'lparen') {
+        this.consume(); // consume (
+        const args = this.parseFunctionArgs();
+        this.expect('rparen');
+        return { type: 'function', name: tok.value, args };
+      }
+      throw new Error(`Unexpected name: ${tok.value}`);
+    }
+
+    if (tok.type === 'lparen') {
+      this.consume();
+      const expr = this.parseExpression();
+      this.expect('rparen');
+      return expr;
+    }
+
+    throw new Error(`Unexpected token: ${JSON.stringify(tok)}`);
+  }
+
+  private parseFunctionArgs(): AstNode[] {
+    const args: AstNode[] = [];
+    if (this.peek().type === 'rparen') {
+      return args;
+    }
+    args.push(this.parseExpression());
+    while (this.peek().type === 'comma') {
+      this.consume();
+      args.push(this.parseExpression());
+    }
+    return args;
+  }
+}
+
+// --- Parser entry point ---
+
+export function parseFormula(formula: string): AstNode {
+  const parser = new Parser(formula);
+  return parser.parse();
+}
+
+// --- Evaluator ---
+
+export interface EvalContext {
+  /** Get the computed value of a cell. */
+  getCellValue(ref: string): string | number | boolean | null;
+  /** Collect the cell references this evaluation depends on. */
+  collectDeps(ref: string): void;
+}
+
+function toNumber(val: string | number | boolean | null): number {
+  if (val === null || val === undefined) return 0;
+  if (typeof val === 'number') return val;
+  if (typeof val === 'boolean') return val ? 1 : 0;
+  if (typeof val === 'string') {
+    const n = parseFloat(val);
+    return isNaN(n) ? 0 : n;
+  }
+  return 0;
+}
+
+function toBool(val: string | number | boolean | null): boolean {
+  if (val === null || val === undefined) return false;
+  if (typeof val === 'boolean') return val;
+  if (typeof val === 'number') return val !== 0;
+  if (typeof val === 'string') return val !== '';
+  return false;
+}
+
+function compare(left: string | number | boolean | null, right: string | number | boolean | null): number {
+  const ln = toNumber(left);
+  const rn = toNumber(right);
+  if (ln < rn) return -1;
+  if (ln > rn) return 1;
+  return 0;
+}
+
+function evalBinaryOp(op: string, left: string | number | boolean | null, right: string | number | boolean | null): string | number | boolean {
+  switch (op) {
+    case '+': {
+      // If either is a string, concatenate
+      if (typeof left === 'string' || typeof right === 'string') {
+        return String(left ?? '') + String(right ?? '');
+      }
+      return toNumber(left) + toNumber(right);
+    }
+    case '-': return toNumber(left) - toNumber(right);
+    case '*': return toNumber(left) * toNumber(right);
+    case '/': {
+      const d = toNumber(right);
+      if (d === 0) return '#DIV/0!';
+      return toNumber(left) / d;
+    }
+    case '>': return toNumber(left) > toNumber(right);
+    case '<': return toNumber(left) < toNumber(right);
+    case '>=': return toNumber(left) >= toNumber(right);
+    case '<=': return toNumber(left) <= toNumber(right);
+    case '=': return compare(left, right) === 0;
+    case '<>': return compare(left, right) !== 0;
+    default: throw new Error(`Unknown operator: ${op}`);
+  }
+}
+
+function collectCellRefs(node: AstNode): string[] {
+  const refs: string[] = [];
+  collectRefsFromNode(node, refs);
+  return refs;
+}
+
+function collectRefsFromNode(node: AstNode, refs: string[]): void {
+  if (node.type === 'cellRef') {
+    // Could be a range like A1:C3
+    if (node.ref.includes(':')) {
+      const parts = node.ref.split(':');
+      const start = parseCellRef(parts[0]);
+      const end = parseCellRef(parts[1]);
+      const minCol = Math.min(start.col, end.col);
+      const maxCol = Math.max(start.col, end.col);
+      const minRow = Math.min(start.row, end.row);
+      const maxRow = Math.max(start.row, end.row);
+      for (let row = minRow; row <= maxRow; row++) {
+        for (let col = minCol; col <= maxCol; col++) {
+          refs.push(formatCellRef(col, row));
+        }
+      }
+    } else {
+      refs.push(node.ref);
+    }
+    return;
+  }
+  if (node.type === 'binary') {
+    collectRefsFromNode(node.left, refs);
+    collectRefsFromNode(node.right, refs);
+  } else if (node.type === 'unaryMinus') {
+    collectRefsFromNode(node.expr, refs);
+  } else if (node.type === 'function') {
+    for (const arg of node.args) {
+      collectRefsFromNode(arg, refs);
+    }
+  }
+}
+
+function evalNode(node: AstNode, ctx: EvalContext): string | number | boolean {
+  switch (node.type) {
+    case 'literal':
+      return node.value;
+
+    case 'cellRef': {
+      ctx.collectDeps(node.ref);
+      const val = ctx.getCellValue(node.ref);
+      if (val === null) return 0;
+      return val;
+    }
+
+    case 'unaryMinus': {
+      const val = evalNode(node.expr, ctx);
+      return -toNumber(val);
+    }
+
+    case 'binary': {
+      const left = evalNode(node.left, ctx);
+      const right = evalNode(node.right, ctx);
+      return evalBinaryOp(node.op, left, right);
+    }
+
+    case 'function': {
+      return evalFunction(node, ctx);
+    }
+
+    default:
+      throw new Error(`Unknown node type: ${(node as any).type}`);
+  }
+}
+
+function evalFunction(node: AstFunctionCall, ctx: EvalContext): string | number | boolean {
+  const name = node.name;
+
+  if (name === 'IF') {
+    if (node.args.length !== 3) {
+      throw new Error('IF requires 3 arguments');
+    }
+    const condition = evalNode(node.args[0], ctx);
+    // Collect deps from all branches so reactive updates work when condition changes
+    if (toBool(condition)) {
+      return evalNode(node.args[1], ctx);
+    } else {
+      return evalNode(node.args[2], ctx);
+    }
+  }
+
+  // Aggregate functions: SUM, AVERAGE, MIN, MAX, COUNT
+  if (['SUM', 'AVERAGE', 'MIN', 'MAX', 'COUNT'].includes(name)) {
+    // Collect all values from all args (could be cell refs, ranges, or literals)
+    const values = evalAggregateArgs(node.args, ctx);
+    return evalAggregate(name, values);
+  }
+
+  throw new Error(`Unknown function: ${name}`);
+}
+
+function evalAggregateArgs(args: AstNode[], ctx: EvalContext): (number | null)[] {
+  const values: (number | null)[] = [];
+  for (const arg of args) {
+    if (arg.type === 'cellRef') {
+      // Could be a range
+      if (arg.ref.includes(':')) {
+        const parts = arg.ref.split(':');
+        const start = parseCellRef(parts[0]);
+        const end = parseCellRef(parts[1]);
+        const minCol = Math.min(start.col, end.col);
+        const maxCol = Math.max(start.col, end.col);
+        const minRow = Math.min(start.row, end.row);
+        const maxRow = Math.max(start.row, end.row);
+        for (let row = minRow; row <= maxRow; row++) {
+          for (let col = minCol; col <= maxCol; col++) {
+            const ref = formatCellRef(col, row);
+            ctx.collectDeps(ref);
+            const val = ctx.getCellValue(ref);
+            if (val !== null && typeof val === 'number') {
+              values.push(val);
+            }
+          }
+        }
+      } else {
+        ctx.collectDeps(arg.ref);
+        const val = ctx.getCellValue(arg.ref);
+        if (val !== null && typeof val === 'number') {
+          values.push(val);
+        }
+      }
+    } else if (arg.type === 'literal' && typeof arg.value === 'number') {
+      values.push(arg.value);
+    } else {
+      const val = evalNode(arg, ctx);
+      if (typeof val === 'number') {
+        values.push(val);
+      }
+    }
+  }
+  return values;
+}
+
+function evalAggregate(name: string, values: (number | null)[]): number | string {
+  const nums = values.filter((v): v is number => v !== null);
+
+  switch (name) {
+    case 'SUM':
+      return nums.reduce((a, b) => a + b, 0);
+    case 'AVERAGE':
+      if (nums.length === 0) return '#DIV/0!';
+      return nums.reduce((a, b) => a + b, 0) / nums.length;
+    case 'MIN':
+      if (nums.length === 0) return 0;
+      return Math.min(...nums);
+    case 'MAX':
+      if (nums.length === 0) return 0;
+      return Math.max(...nums);
+    case 'COUNT':
+      return nums.length;
+    default:
+      throw new Error(`Unknown aggregate: ${name}`);
+  }
+}
+
+// --- Public API ---
+
+/** Evaluate a formula string given a context. Returns the computed value. */
+export function evaluateFormula(
+  formula: string,
+  ctx: EvalContext,
+): string | number | boolean {
+  const ast = parseFormula(formula);
+  return evalNode(ast, ctx);
+}
+
+/** Collect all cell references that a formula depends on. */
+export function getFormulaDeps(formula: string): string[] {
+  const ast = parseFormula(formula);
+  return collectCellRefs(ast);
+}
