e the value\n    this.computeCell(normalized);\n\n    // Propagate changes to dependents\n    this.propagate(normalized);\n  }\n\n  /** Get a cell's computed value. Returns null for empty cells. */\n  get(cell: string): string | number | boolean | null {\n    const normalized = cell.toUpperCase();\n    const entry = this.cells.get(normalized);\n    if (!entry) return null;\n    return entry.computed;\n  }\n\n  /** Get the display string for a cell's computed value. */\n  getDisplay(cell: string): string {\n    const normalized = cell.toUpperCase();\n    const entry = this.cells.get(normalized);\n    if (!entry) return '';\n    const val = entry.computed;\n    if (val === null) return '';\n    if (typeof val === 'string') return val;\n    if (typeof val === 'boolean') return val ? 'TRUE' : 'FALSE';\n    if (typeof val === 'number') {\n      if (Number.isInteger(val)) return String(val);\n      return String(val);\n    }\n    return String(val);\n  }\n\n  /** Get all non-empty cells as a Map from cell reference to computed value. */\n  getCells(): Map<string, any> {\n    const result = new Map<string, any>();\n    for (const [ref, entry] of this.cells) {\n      if (entry.computed !== null) {\n        result.set(ref, entry.computed);\n      }\n    }\n    return result;\n  }\n\n  // --- Internal methods ---\n\n  private computeCell(cell: string): void {\n    const entry = this.cells.get(cell);\n    if (!entry) return;\n\n    if (entry.formula !== null) {\n      // Evaluate the formula\n      const ctx = {\n        getCellValue: (ref: string) => {\n          const refUpper = ref.toUpperCase();\n          const depEntry = this.cells.get(refUpper);\n          if (!depEntry) return null;\n          return depEntry.computed;\n        },\n        collectDeps: (_ref: string) => {\n          // Dependencies are already tracked at set time\n        },\n      };\n      try {\n        entry.computed = evaluateFormula(entry.formula, ctx);\n      } catch (e) {\n        entry.compute