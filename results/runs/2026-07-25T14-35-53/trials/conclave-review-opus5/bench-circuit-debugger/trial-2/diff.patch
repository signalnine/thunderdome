new file mode 100644
index 0000000..03ce842
--- /dev/null
+++ b/tests/adder.ts
@@ -0,0 +1,101 @@
+import type { Gate } from '../src/types.js';
+
+export function lcg(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state / 4294967296;
+  };
+}
+
+const LETTERS = 'abcdefghijklmnopqrstuvwxyz';
+
+function nameGenerator(rand: () => number): () => string {
+  const used = new Set<string>();
+  return () => {
+    for (;;) {
+      let name = '';
+      for (let i = 0; i < 3; i++) name += LETTERS[Math.floor(rand() * 26)];
+      if (name[0] === 'x' || name[0] === 'y' || name[0] === 'z') continue;
+      if (used.has(name)) continue;
+      used.add(name);
+      return name;
+    }
+  };
+}
+
+export function bit(prefix: string, index: number): string {
+  return prefix + String(index).padStart(2, '0');
+}
+
+/** A structurally correct ripple-carry adder over `bits` input bits. */
+export function buildAdder(bits: number, rand: () => number): Gate[] {
+  const fresh = nameGenerator(rand);
+  const gates: Gate[] = [];
+
+  if (bits === 1) {
+    gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+    gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'z01' });
+    return shuffle(gates, rand);
+  }
+
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  let carry = fresh();
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: carry });
+
+  for (let b = 1; b < bits; b++) {
+    const partial = fresh();
+    const generate = fresh();
+    const propagate = fresh();
+    const nextCarry = b === bits - 1 ? bit('z', bits) : fresh();
+    gates.push({ op: 'XOR', in1: bit('x', b), in2: bit('y', b), out: partial });
+    gates.push({ op: 'XOR', in1: partial, in2: carry, out: bit('z', b) });
+    gates.push({ op: 'AND', in1: bit('x', b), in2: bit('y', b), out: generate });
+    gates.push({ op: 'AND', in1: partial, in2: carry, out: propagate });
+    gates.push({ op: 'OR', in1: generate, in2: propagate, out: nextCarry });
+    carry = nextCarry;
+  }
+
+  return shuffle(gates, rand);
+}
+
+export function shuffle<T>(items: T[], rand: () => number): T[] {
+  const copy = items.slice();
+  for (let i = copy.length - 1; i > 0; i--) {
+    const j = Math.floor(rand() * (i + 1));
+    [copy[i], copy[j]] = [copy[j], copy[i]];
+  }
+  return copy;
+}
+
+export function swapOutputs(gates: Gate[], pairs: Array<[string, string]>): Gate[] {
+  const rename = new Map<string, string>();
+  for (const [a, b] of pairs) {
+    rename.set(a, b);
+    rename.set(b, a);
+  }
+  return gates.map((gate) => {
+    const other = rename.get(gate.out);
+    return other === undefined ? gate : { ...gate, out: other };
+  });
+}
+
+export function addWithCircuit(
+  gates: Gate[],
+  bits: number,
+  x: bigint,
+  y: bigint,
+  simulate: (gates: Gate[], inputs: Record<string, number>) => Record<string, number>,
+): bigint {
+  const inputs: Record<string, number> = {};
+  for (let b = 0; b < bits; b++) {
+    inputs[bit('x', b)] = Number((x >> BigInt(b)) & 1n);
+    inputs[bit('y', b)] = Number((y >> BigInt(b)) & 1n);
+  }
+  const values = simulate(gates, inputs);
+  let result = 0n;
+  for (let b = 0; b <= bits; b++) {
+    if (values[bit('z', b)]) result |= 1n << BigInt(b);
+  }
+  return result;
+}
