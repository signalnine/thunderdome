  const a = pool.splice(Math.floor(rand() * pool.length), 1)[0];\n43\t      const b = pool.splice(Math.floor(rand() * pool.length), 1)[0];\n44\t      pairs.push([a, b]);\n45\t    }\n46\t    if (!pairs.every((pair) => isBroken(swapOutputs(correct, [pair]), bits, rand))) continue;\n47\t    const gates = swapOutputs(correct, pairs);\n48\t    if (!isBroken(gates, bits, rand)) continue;\n49\t    return { gates, swapped: pairs.flat().sort() };\n50\t  }\n51\t  throw new Error('could not construct a broken circuit');\n52\t}\n53\t\n54\tdescribe('findSwappedWires', () => {\n55\t  it('recovers the swap from a hand-built 4-bit example', () => {\n56\t    const rand = lcg(1);\n57\t    const correct = buildAdder(4, rand);\n58\t    const gates = swapOutputs(correct, [\n59\t      ['z00', 'z03'],\n60\t      ['z01', 'z02'],\n61\t      [correct[0].out, correct[1].out],\n62\t      [correct[2].out, correct[3].out],\n63\t    ]);\n64\t    const found = findSwappedWires(gates);\n65\t    expect(found).toHaveLength(8);\n66\t    expect(new Set(found).size).toBe(8);\n67\t    // Undoing the reported swaps must be possible; check the answer is the\n68\t    // exact wire set that was disturbed.\n69\t    const disturbed = new Set(\n70\t      gates.filter((g, i) => g.out !== correct[i].out).map((g) => g.out),\n71\t    );\n72\t    expect(new Set(found)).toEqual(disturbed);\n73\t  });\n74\t\n75\t  for (const bits of [8, 16, 24]) {\n76\t    it(`finds all four swaps in a ${bits}-bit adder`, () => {\n77\t      for (let seed = 1; seed <= 5; seed++) {\n78\t        const { gates, swapped } = makeBroken(bits, seed * 1000 + bits);\n79\t        expect(findSwappedWires(gates)).toEqual(swapped);\n80\t      }\n81\t    });\n82\t  }\n83\t\n84\t  it('handles a 45-bit adder well within the time limit', () => {\n85\t    const { gates, swapped } = makeBroken(45, 424242);\n86\t    expect(gates.length).toBeGreaterThan(215);\n87\t    const start = Date.now();\n88\t    const found = findSwappedWires(gates);\n89\t    const elapsed = Date.now() - start;\n90\t    expect(found).toEqual(swapped);\n91\t    expect(elapsed).toBeLessThan(5000);\n92\t  });\n93\t\n94\t  it('is fast across many 45-bit circuits', () => {\n95\t    const start = Date.now();\n96\t    for (let seed = 1; seed <= 10; seed++) {\n97\t      const { gates, swapped } = makeBroken(45, seed * 77);\n98\t      expect(findSwappedWires(gates)).toEqual(swapped);\n99\t    }\n100\t    expect(Date.now() - start).toBeLessThan(30000);\n101\t  });\n102\t\n103\t  it('finds swaps that touch the least and most significant outputs', () => {\n104\t    const rand = lcg(808);\n105\t    const bits = 12;\n106\t    const correct = buildAdder(bits, rand);\n107\t    const byRole = (op: Gate['op'], in1: string, in2: string): string =>\n108\t      correct.find((g) => g.op === op && ((g.in1 === in1 && g.in2 === in2) || (g.in1 === in2 && g.in2 === in1)))!.out;\n109\t    const swaps: Array<[string, string]> = [\n110\t      ['z00', byRole('AND', 'x00', 'y00')],\n111\t      [bit('z', bits), byRole('XOR', 'x07', 'y07')],\n112\t      [byRole('AND', 'x03', 'y03'), byRole('XOR', 'x03', 'y03')],\n113\t      ['z09', byRole('AND', 'x11', 'y11')],\n114\t    ];\n115\t    const found = findSwappedWires(swapOutputs(correct, swaps));\n116\t    expect(found).toEqual(swaps.flat().sort());\n117\t  });\n118\t\n119\t  it('returns a sorted array of unique wire names', () => {\n120\t    const { gates } = makeBroken(20, 31337);\n121\t    const found = findSwappedWires(gates);\n122\t    expect(found).toHaveLength(8);\n123\t    expect(found).toEqual([...found].sort());\n124\t    expect(new Set(found).size).toBe(8);\n125\t  });\n126\t\n127\t  it('reports nothing for a circuit with no x inputs', () => {\n128\t    expect(findSwappedWires([{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }])).toEqual([]);\n129\t  });\n130\t});\n131\t"}]},"parent_tool_use_id":"toolu_019dSHLWqJN2E7PDtWKnnwsn","session_id":"ab34c639-1ec9-4c37-9b19-3a4b962e5e9e","uuid":"79a1799b-5721-4f6a-886d-a8a8acf5fb10",