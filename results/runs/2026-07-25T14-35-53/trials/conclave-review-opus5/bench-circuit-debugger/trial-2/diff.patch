+++ b/src/reconstruct.ts
@@ -0,0 +1,268 @@
+import { bitWire } from './circuit.js';
+import type { Gate } from './types.js';
+
+/** Register bits are always written with two digits: `x00` .. `x44`. */
+const XY_WIRE = /^[xy]\d\d$/;
+
+export function isInputWire(wire: string): boolean {
+  return XY_WIRE.test(wire);
+}
+
+export function applySwaps(gates: Gate[], pairs: Array<[string, string]>): Gate[] {
+  const rename = new Map<string, string>();
+  for (const [a, b] of pairs) {
+    rename.set(a, b);
+    rename.set(b, a);
+  }
+  return gates.map((gate) => {
+    const replacement = rename.get(gate.out);
+    return replacement === undefined ? gate : { ...gate, out: replacement };
+  });
+}
+
+function inputKey(op: Gate['op'], a: string, b: string): string {
+  return a < b ? `${op}|${a}|${b}` : `${op}|${b}|${a}`;
+}
+
+/** A bit's final-sum XOR combines a partial sum with a carry, never x/y directly. */
+function isSumGate(gate: Gate): boolean {
+  return gate.op === 'XOR' && !isInputWire(gate.in1) && !isInputWire(gate.in2);
+}
+
+interface Index {
+  /** gate looked up by operation plus its (unordered) pair of input wires */
+  byInputs: Map<string, Gate>;
+  byOut: Map<string, Gate>;
+  /** the sum XOR reading a given wire, or null if more than one reads it */
+  sumByInput: Map<string, Gate | null>;
+  /** the carry OR reading a given wire, or null if more than one reads it */
+  carryByInput: Map<string, Gate | null>;
+  sumGates: Gate[];
+  orGates: Gate[];
+}
+
+function buildIndex(gates: Gate[]): Index {
+  const byInputs = new Map<string, Gate>();
+  const byOut = new Map<string, Gate>();
+  const sumByInput = new Map<string, Gate | null>();
+  const carryByInput = new Map<string, Gate | null>();
+  const sumGates: Gate[] = [];
+  const orGates: Gate[] = [];
+
+  for (const gate of gates) {
+    byInputs.set(inputKey(gate.op, gate.in1, gate.in2), gate);
+    byOut.set(gate.out, gate);
+    const sumLike = isSumGate(gate);
+    if (sumLike) sumGates.push(gate);
+    if (gate.op === 'OR') orGates.push(gate);
+    const target = sumLike ? sumByInput : gate.op === 'OR' ? carryByInput : undefined;
+    if (!target) continue;
+    for (const wire of [gate.in1, gate.in2]) {
+      target.set(wire, target.has(wire) ? null : gate);
+    }
+  }
+
+  return { byInputs, byOut, sumByInput, carryByInput, sumGates, orGates };
+}
+
+function otherInput(gate: Gate, wire: string): string {
+  return gate.in1 === wire ? gate.in2 : gate.in1;
+}
+
+type Pair = [string, string];
+
+/**
+ * Swaps that would let `gate` read both `first` and `second`, as a correct
+ * adder requires. Empty when it already does — which identifies `gate` as
+ * genuinely belonging at this position.
+ */
+function reconcile(gate: Gate, first: string, second: string): Pair[] {
+  const readsFirst = gate.in1 === first || gate.in2 === first;
+  const readsSecond = gate.in1 === second || gate.in2 === second;
+  if (readsFirst && readsSecond) return [];
+  if (readsSecond) return [[first, otherInput(gate, second)]];
+  if (readsFirst) return [[second, otherInput(gate, first)]];
+  // Both names moved; repair one now and let the next pass catch the other.
+  return [
+    [first, gate.in1],
+    [first, gate.in2],
+  ];
+}
+
+/**
+ * `ok` — the walk reached the top bit with everything in place.
+ * `options` — the walk found a mislabelled output; each option is a swap that
+ * would explain it, most plausible first.
+ * `stuck` — the circuit does not look like a ripple-carry adder here.
+ */
+type ScanResult = { kind: 'ok' } | { kind: 'options'; options: Pair[] } | { kind: 'stuck' };
+
+const OK: ScanResult = { kind: 'ok' };
+const STUCK: ScanResult = { kind: 'stuck' };
+
+function toResult(pairs: Pair[]): ScanResult {
+  const usable: Pair[] = [];
+  const seen = new Set<string>();
+  for (const [a, b] of pairs) {
+    const key = a < b ? `${a}|${b}` : `${b}|${a}`;
+    if (a === b || seen.has(key)) continue;
+    seen.add(key);
+    usable.push([a, b]);
+  }
+  return usable.length === 0 ? STUCK : { kind: 'options', options: usable };
+}
+
+/**
+ * Pick the gate that sits at a position from a shortlist of candidates: the one
+ * that already reads both wires the position feeds it. If none does, every
+ * candidate's repair becomes an option for the caller to try.
+ */
+function resolve(
+  candidates: Array<Gate | null | undefined>,
+  first: string,
+  second: string,
+  taken: Set<Gate>,
+): { gate: Gate } | { repairs: Pair[] } {
+  const repairs: Pair[] = [];
+  const seen = new Set<Gate>(taken);
+  for (const candidate of candidates) {
+    if (!candidate || seen.has(candidate)) continue;
+    seen.add(candidate);
+    const fixes = reconcile(candidate, first, second);
+    if (fixes.length === 0) return { gate: candidate };
+    repairs.push(...fixes);
+  }
+  return { repairs };
+}
+
+/**
+ * Walk the adder from bit 0 upwards and report the first place where a gate
+ * writes to the wrong wire.
+ *
+ * Only `out` fields are corrupted by a swap — the wire names gates *read* are
+ * untouched. So every gate can be located by its inputs, and the walk just
+ * checks that the gate found at each position writes the wire the next position
+ * expects to read. When names disagree it is not always clear which one moved,
+ * hence the list of options for the caller to try.
+ */
+function scan(gates: Gate[], bits: number): ScanResult {
+  const index = buildIndex(gates);
+  const halfSum = index.byInputs.get(inputKey('XOR', 'x00', 'y00'));
+  const halfCarry = index.byInputs.get(inputKey('AND', 'x00', 'y00'));
+  if (!halfSum || !halfCarry) return STUCK;
+  if (halfSum.out !== 'z00') return toResult([[halfSum.out, 'z00']]);
+
+  const top = bitWire('z', bits);
+  if (bits === 1) {
+    return halfCarry.out === top ? OK : toResult([[halfCarry.out, top]]);
+  }
+
+  let carry = halfCarry.out;
+  // Each gate belongs to exactly one bit, so once a position claims one it is
+  // out of the running for every later position.
+  const claimed = new Set<Gate>();
+
+  for (let bit = 1; bit < bits; bit++) {
+    const z = bitWire('z', bit);
+    const partial = index.byInputs.get(inputKey('XOR', bitWire('x', bit), bitWire('y', bit)));
+    const generate = index.byInputs.get(inputKey('AND', bitWire('x', bit), bitWire('y', bit)));
+    if (!partial || !generate) return STUCK;
+
+    // The bit's final-sum XOR reads the partial sum and the incoming carry, and
+    // writes zNN. Any of those three names can point at it; they disagree only
+    // when one of them has been swapped away. When all three are misleading,
+    // any sum-shaped XOR could be the one.
+    const namedByZ = index.byOut.get(z);
+    const sum = resolve(
+      [
+        namedByZ && isSumGate(namedByZ) ? namedByZ : null,
+        index.sumByInput.get(carry),
+        index.sumByInput.get(partial.out),
+        ...index.sumGates,
+      ],
+      partial.out,
+      carry,
+      claimed,
+    );
+    if (!('gate' in sum)) return toResult(sum.repairs);
+    if (sum.gate.out !== z) return toResult([[sum.gate.out, z]]);
+    claimed.add(sum.gate);
+
+    const propagate = index.byInputs.get(inputKey('AND', sum.gate.in1, sum.gate.in2));
+    if (!propagate) return STUCK;
+
+    // The carry OR reads the generated and the propagated carry. Its output
+    // name is only pinned down at the top bit, so its input names are the main
+    // handle — and when both of those have moved, every OR gate is a candidate.
+    const anchor = bit === bits - 1 ? index.byOut.get(top) : undefined;
+    const carryOut = resolve(
+      [
+        anchor?.op === 'OR' ? anchor : null,
+        index.carryByInput.get(propagate.out),
+        index.carryByInput.get(generate.out),
+        ...index.orGates,
+      ],
+      generate.out,
+      propagate.out,
+      claimed,
+    );
+    if (!('gate' in carryOut)) return toResult(carryOut.repairs);
+    claimed.add(carryOut.gate);
+
+    if (bit === bits - 1 && carryOut.gate.out !== top) {
+      return toResult([[carryOut.gate.out, top]]);
+    }
+    carry = carryOut.gate.out;
+  }
+
+  return OK;
+}
+
+const MAX_NODES = 200_000;
+/** How often to consult the clock, in visited nodes. */
+const CLOCK_INTERVAL = 256;
+
+/**
+ * Undo mislabelled outputs one at a time until the circuit is a textbook
+ * ripple-carry adder, backtracking whenever the walk guesses wrong. `accept`
+ * has the final say — the walk can run to completion on a circuit that still
+ * adds incorrectly if an earlier guess went the wrong way.
+ */
+export function reconstructSwaps(
+  gates: Gate[],
+  bits: number,
+  swapCount: number,
+  accept: (repaired: Gate[]) => boolean,
+  deadline = Infinity,
+): Pair[] | null {
+  if (bits < 1) return null;
+  let budget = MAX_NODES;
+  let expired = false;
+
+  // The swapped pairs are disjoint, so a wire that has been put back in place
+  // is never a candidate again.
+  const visit = (work: Gate[], pairs: Pair[], used: Set<string>): Pair[] | null => {
+    if (budget-- <= 0 || expired) return null;
+    if ((MAX_NODES - budget) % CLOCK_INTERVAL === 0 && Date.now() > deadline) {
+      expired = true;
+      return null;
+    }
+    const result = scan(work, bits);
+    if (result.kind === 'ok') {
+      return pairs.length === swapCount && accept(work) ? pairs : null;
+    }
+    if (result.kind === 'stuck' || pairs.length === swapCount) return null;
+    for (const option of result.options) {
+      if (used.has(option[0]) || used.has(option[1])) continue;
+      const found = visit(
+        applySwaps(work, [option]),
+        [...pairs, option],
+        new Set([...used, ...option]),
+      );
+      if (found) return found;
+    }
+    return null;
+  };
+
+  return visit(gates, [], new Set());
+}
