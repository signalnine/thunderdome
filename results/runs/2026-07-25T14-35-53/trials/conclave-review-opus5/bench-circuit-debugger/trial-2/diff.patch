+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FFeMPsfKxftNqCpPzSUhT4","type":"tool_result","content":"1\timport type { Gate } from './types.js';\n2\t\n3\tconst OP_AND = 0;\n4\tconst OP_OR = 1;\n5\tconst OP_XOR = 2;\n6\t\n7\tconst OP_CODE: Record<Gate['op'], number> = { AND: OP_AND, OR: OP_OR, XOR: OP_XOR };\n8\t\n9\t/** `x` -> `x00`, used for the conventional register wire names. */\n10\texport function bitWire(prefix: string, bit: number): string {\n11\t  return prefix + String(bit).padStart(2, '0');\n12\t}\n13\t\n14\t/**\n15\t * A compiled, index-based view of a circuit that is meant to be evaluated many\n16\t * thousands of times. Wire names are interned to integers and the gates are\n17\t * topologically sorted once up front, so a single evaluation is just a linear\n18\t * scan over typed arrays.\n19\t */\n20\texport class Circuit {\n21\t  /** false when the gate graph is cyclic or an expected x/y/z wire is absent */\n22\t  readonly usable: boolean;\n23\t\n24\t  private readonly ops: Uint8Array;\n25\t  private readonly inA: Int32Array;\n26\t  private readonly inB: Int32Array;\n27\t  private readonly outW: Int32Array;\n28\t  private readonly order: Int32Array;\n29\t  private readonly values: Uint8Array;\n30\t  private readonly xIds: Int32Array;\n31\t  private readonly yIds: Int32Array;\n32\t  private readonly zIds: Int32Array;\n33\t\n34\t  constructor(gates: Gate[], bits: number) {\n35\t    const ids = new Map<string, number>();\n36\t    const intern = (wire: string): number => {\n37\t      let id = ids.get(wire);\n38\t      if (id === undefined) {\n39\t        id = ids.size;\n40\t        ids.set(wire, id);\n41\t      }\n42\t      return id;\n43\t    };\n44\t\n45\t    const count = gates.length;\n46\t    this.ops = new Uint8Array(count);\n47\t    this.inA = new Int32Array(count);\n48\t    this.inB = new Int32Array(count);\n49\t    this.outW = new Int32Array(count);\n50\t    for (let i = 0; i < count; i++) {\n51\t      const gate = ga