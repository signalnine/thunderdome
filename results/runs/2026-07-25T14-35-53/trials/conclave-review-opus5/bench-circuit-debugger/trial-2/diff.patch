@@ -0,0 +1,135 @@
+import type { Gate } from './types.js';
+
+const OP_AND = 0;
+const OP_OR = 1;
+const OP_XOR = 2;
+
+const OP_CODE: Record<Gate['op'], number> = { AND: OP_AND, OR: OP_OR, XOR: OP_XOR };
+
+/** `x` -> `x00`: the conventional register wire names, always two digits. */
+export function bitWire(prefix: string, bit: number): string {
+  return prefix + String(bit).padStart(2, '0');
+}
+
+/**
+ * A compiled, index-based view of a circuit that is meant to be evaluated many
+ * thousands of times. Wire names are interned to integers and the gates are
+ * topologically sorted once up front, so a single evaluation is just a linear
+ * scan over typed arrays.
+ */
+export class Circuit {
+  /** false when the gate graph is cyclic or an expected x/y/z wire is absent */
+  readonly usable: boolean;
+
+  private readonly ops: Uint8Array;
+  private readonly inA: Int32Array;
+  private readonly inB: Int32Array;
+  private readonly outW: Int32Array;
+  private readonly order: Int32Array;
+  private readonly values: Uint8Array;
+  private readonly xIds: Int32Array;
+  private readonly yIds: Int32Array;
+  private readonly zIds: Int32Array;
+
+  constructor(gates: Gate[], bits: number) {
+    const ids = new Map<string, number>();
+    const intern = (wire: string): number => {
+      let id = ids.get(wire);
+      if (id === undefined) {
+        id = ids.size;
+        ids.set(wire, id);
+      }
+      return id;
+    };
+
+    const count = gates.length;
+    this.ops = new Uint8Array(count);
+    this.inA = new Int32Array(count);
+    this.inB = new Int32Array(count);
+    this.outW = new Int32Array(count);
+    for (let i = 0; i < count; i++) {
+      const gate = gates[i];
+      this.ops[i] = OP_CODE[gate.op];
+      this.inA[i] = intern(gate.in1);
+      this.inB[i] = intern(gate.in2);
+      this.outW[i] = intern(gate.out);
+    }
+
+    const wireCount = ids.size;
+    this.values = new Uint8Array(wireCount);
+
+    const producer = new Int32Array(wireCount).fill(-1);
+    for (let i = 0; i < count; i++) producer[this.outW[i]] = i;
+
+    // Kahn's algorithm over the gate graph. A gate reading its own output is a
+    // one-gate cycle, which Kahn cannot see, so it is caught here instead.
+    const indegree = new Int32Array(count);
+    const consumers: number[][] = Array.from({ length: count }, () => []);
+    let selfDriven = false;
+    for (let i = 0; i < count; i++) {
+      for (const wire of [this.inA[i], this.inB[i]]) {
+        const source = producer[wire];
+        if (source === i) {
+          selfDriven = true;
+        } else if (source >= 0) {
+          indegree[i]++;
+          consumers[source].push(i);
+        }
+      }
+    }
+    const order = new Int32Array(count);
+    let head = 0;
+    let tail = 0;
+    for (let i = 0; i < count; i++) if (indegree[i] === 0) order[tail++] = i;
+    while (head < tail) {
+      const gate = order[head++];
+      for (const next of consumers[gate]) {
+        if (--indegree[next] === 0) order[tail++] = next;
+      }
+    }
+    this.order = order;
+
+    this.xIds = new Int32Array(bits);
+    this.yIds = new Int32Array(bits);
+    this.zIds = new Int32Array(bits + 1);
+    let complete = true;
+    for (let b = 0; b < bits; b++) {
+      const x = ids.get(bitWire('x', b));
+      const y = ids.get(bitWire('y', b));
+      if (x === undefined || y === undefined) complete = false;
+      this.xIds[b] = x ?? -1;
+      this.yIds[b] = y ?? -1;
+    }
+    for (let b = 0; b <= bits; b++) {
+      const z = ids.get(bitWire('z', b));
+      if (z === undefined) complete = false;
+      this.zIds[b] = z ?? -1;
+    }
+
+    this.usable = complete && tail === count && !selfDriven;
+  }
+
+  /**
+   * Drive the x/y registers with the given bits and read back the z register.
+   * `zOut` must have room for `bits + 1` entries.
+   */
+  evaluate(xBits: Uint8Array, yBits: Uint8Array, zOut: Uint8Array): void {
+    const values = this.values;
+    values.fill(0);
+    for (let b = 0; b < this.xIds.length; b++) {
+      values[this.xIds[b]] = xBits[b];
+      values[this.yIds[b]] = yBits[b];
+    }
+
+    const { ops, inA, inB, outW, order } = this;
+    for (let i = 0; i < order.length; i++) {
+      const g = order[i];
+      const a = values[inA[g]];
+      const b = values[inB[g]];
+      const op = ops[g];
+      values[outW[g]] = op === OP_AND ? a & b : op === OP_OR ? a | b : a ^ b;
+    }
+
+    for (let b = 0; b < this.zIds.length; b++) zOut[b] = values[this.zIds[b]];
+  }
+}
