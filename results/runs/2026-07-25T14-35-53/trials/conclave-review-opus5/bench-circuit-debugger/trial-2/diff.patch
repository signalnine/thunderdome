+/** A single two-input logic gate. */
+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  /** input wire name */
+  in1: string;
+  /** input wire name */
+  in2: string;
+  /** output wire name */
+  out: string;
+}
+
+/** Wire values are always 0 or 1. */
+export type WireValues = Record<string, number>;
