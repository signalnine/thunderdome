@@ -0,0 +1,159 @@
+import { describe, expect, it } from 'vitest';
+import { findSwappedWires, simulate } from '../src/index.js';
+import type { Gate } from '../src/types.js';
+import { addWithCircuit, bit, buildAdder, lcg, swapOutputs } from './adder.js';
+
+/** True when the circuit fails to add for at least one probe value. */
+function isBroken(gates: Gate[], bits: number, rand: () => number): boolean {
+  const probes: Array<[bigint, bigint]> = [];
+  const all = (1n << BigInt(bits)) - 1n;
+  probes.push([all, 1n], [all, all], [0n, 0n]);
+  for (let b = 0; b < bits; b++) {
+    probes.push([1n << BigInt(b), 1n << BigInt(b)]);
+    probes.push([1n << BigInt(b), 0n]);
+    if (b > 0) probes.push([(1n << BigInt(b)) | (1n << BigInt(b - 1)), 1n << BigInt(b - 1)]);
+  }
+  for (let n = 0; n < 20; n++) {
+    let x = 0n;
+    let y = 0n;
+    for (let b = 0; b < bits; b++) {
+      if (rand() < 0.5) x |= 1n << BigInt(b);
+      if (rand() < 0.5) y |= 1n << BigInt(b);
+    }
+    probes.push([x, y]);
+  }
+  return probes.some(([x, y]) => addWithCircuit(gates, bits, x, y, simulate) !== x + y);
+}
+
+/**
+ * Pick four disjoint output pairs, each of which breaks the adder on its own.
+ * Pairs that are functionally invisible — the two inputs of one OR gate, say —
+ * are rejected, because no method could recover them.
+ */
+function makeBroken(bits: number, seed: number): { gates: Gate[]; swapped: string[] } {
+  const rand = lcg(seed);
+  const correct = buildAdder(bits, rand);
+  const outputs = correct.map((gate) => gate.out);
+
+  for (let attempt = 0; attempt < 500; attempt++) {
+    const pool = outputs.slice();
+    const pairs: Array<[string, string]> = [];
+    for (let i = 0; i < 4; i++) {
+      const a = pool.splice(Math.floor(rand() * pool.length), 1)[0];
+      const b = pool.splice(Math.floor(rand() * pool.length), 1)[0];
+      pairs.push([a, b]);
+    }
+    if (!pairs.every((pair) => isBroken(swapOutputs(correct, [pair]), bits, rand))) continue;
+    const gates = swapOutputs(correct, pairs);
+    if (!isBroken(gates, bits, rand)) continue;
+    return { gates, swapped: pairs.flat().sort() };
+  }
+  throw new Error('could not construct a broken circuit');
+}
+
+describe('findSwappedWires', () => {
+  it('recovers the swap from a hand-built 4-bit example', () => {
+    const rand = lcg(1);
+    const correct = buildAdder(4, rand);
+    const gates = swapOutputs(correct, [
+      ['z00', 'z03'],
+      ['z01', 'z02'],
+      [correct[0].out, correct[1].out],
+      [correct[2].out, correct[3].out],
+    ]);
+    const found = findSwappedWires(gates);
+    expect(found).toHaveLength(8);
+    expect(new Set(found).size).toBe(8);
+    // Undoing the reported swaps must be possible; check the answer is the
+    // exact wire set that was disturbed.
+    const disturbed = new Set(
+      gates.filter((g, i) => g.out !== correct[i].out).map((g) => g.out),
+    );
+    expect(new Set(found)).toEqual(disturbed);
+  });
+
+  for (const bits of [8, 16, 24]) {
+    it(`finds all four swaps in a ${bits}-bit adder`, () => {
+      for (let seed = 1; seed <= 5; seed++) {
+        const { gates, swapped } = makeBroken(bits, seed * 1000 + bits);
+        expect(findSwappedWires(gates)).toEqual(swapped);
+      }
+    });
+  }
+
+  it('handles a 45-bit adder well within the time limit', () => {
+    const { gates, swapped } = makeBroken(45, 424242);
+    expect(gates.length).toBeGreaterThan(215);
+    const start = Date.now();
+    const found = findSwappedWires(gates);
+    const elapsed = Date.now() - start;
+    expect(found).toEqual(swapped);
+    expect(elapsed).toBeLessThan(5000);
+  });
+
+  it('is fast across many 45-bit circuits', () => {
+    const start = Date.now();
+    for (let seed = 1; seed <= 10; seed++) {
+      const { gates, swapped } = makeBroken(45, seed * 77);
+      expect(findSwappedWires(gates)).toEqual(swapped);
+    }
+    expect(Date.now() - start).toBeLessThan(30000);
+  });
+
+  it('finds swaps that touch the least and most significant outputs', () => {
+    const rand = lcg(808);
+    const bits = 12;
+    const correct = buildAdder(bits, rand);
+    const byRole = (op: Gate['op'], in1: string, in2: string): string =>
+      correct.find((g) => g.op === op && ((g.in1 === in1 && g.in2 === in2) || (g.in1 === in2 && g.in2 === in1)))!.out;
+    const swaps: Array<[string, string]> = [
+      ['z00', byRole('AND', 'x00', 'y00')],
+      [bit('z', bits), byRole('XOR', 'x07', 'y07')],
+      [byRole('AND', 'x03', 'y03'), byRole('XOR', 'x03', 'y03')],
+      ['z09', byRole('AND', 'x11', 'y11')],
+    ];
+    const found = findSwappedWires(swapOutputs(correct, swaps));
+    expect(found).toEqual(swaps.flat().sort());
+  });
+
+  it('returns a sorted array of unique wire names', () => {
+    const { gates } = makeBroken(20, 31337);
+    const found = findSwappedWires(gates);
+    expect(found).toHaveLength(8);
+    expect(found).toEqual([...found].sort());
+    expect(new Set(found).size).toBe(8);
+  });
+
+  it('does not care which input wire is in1 and which is in2', () => {
+    const { gates, swapped } = makeBroken(18, 5150);
+    const flipped = gates.map((gate) => ({ ...gate, in1: gate.in2, in2: gate.in1 }));
+    expect(findSwappedWires(flipped)).toEqual(swapped);
+  });
+
+  it('reports nothing for a circuit with no x inputs', () => {
+    expect(findSwappedWires([{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }])).toEqual([]);
+  });
+
+  it('never reports more than eight wires, however odd the circuit', () => {
+    const rand = lcg(6060);
+    const cases: Gate[][] = [
+      // Too small to hold four swaps at all.
+      swapOutputs(buildAdder(1, rand), [['z00', 'z01']]),
+      swapOutputs(buildAdder(2, rand), [['z00', 'z02']]),
+      // An adder with unrelated extra gates bolted on.
+      [
+        ...buildAdder(10, rand),
+        { op: 'XOR', in1: 'x04', in2: 'y04', out: 'spare1' },
+        { op: 'AND', in1: 'spare1', in2: 'x00', out: 'spare2' },
+      ],
+      // Not an adder at all.
+      [{ op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' }],
+    ];
+    for (const gates of cases) {
+      const found = findSwappedWires(gates);
+      expect(found.length).toBeLessThanOrEqual(8);
+      expect(new Set(found).size).toBe(found.length);
+      expect(found).toEqual([...found].sort());
+    }
+  });
+});
