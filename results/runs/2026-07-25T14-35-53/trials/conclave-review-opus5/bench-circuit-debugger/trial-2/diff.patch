+import { describe, expect, it } from 'vitest';
+import { simulate } from '../src/index.js';
+import type { Gate } from '../src/types.js';
+import { addWithCircuit, buildAdder, lcg } from './adder.js';
+
+describe('simulate', () => {
+  it('applies each operation to a single gate', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'and' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'or' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'xor' },
+    ];
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, and: 0, or: 1, xor: 1 });
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, and: 1, or: 1, xor: 0 });
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, and: 0, or: 0, xor: 0 });
+  });
+
+  it('resolves gates given out of dependency order', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'mid', in2: 'd', out: 'end' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'mid' },
+    ];
+    const values = simulate(gates, { a: 0, b: 1, d: 1 });
+    expect(values.mid).toBe(1);
+    expect(values.end).toBe(1);
+  });
+
+  it('returns the supplied inputs alongside computed wires', () => {
+    const values = simulate([{ op: 'XOR', in1: 'p', in2: 'q', out: 'r' }], { p: 1, q: 1 });
+    expect(values).toEqual({ p: 1, q: 1, r: 0 });
+  });
+
+  it('handles a deep chain of dependencies', () => {
+    const gates: Gate[] = [];
+    for (let i = 0; i < 200; i++) {
+      gates.push({ op: 'XOR', in1: `w${i}`, in2: 'one', out: `w${i + 1}` });
+    }
+    const values = simulate(gates.slice().reverse(), { w0: 0, one: 1 });
+    expect(values.w200).toBe(0);
+    expect(values.w199).toBe(1);
+  });
+
+  it('keeps the result self-consistent when a wire has two drivers', () => {
+    const drivers: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'o' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'o' },
+      { op: 'XOR', in1: 'o', in2: 'a', out: 'p' },
+    ];
+    for (const gates of [drivers, [drivers[1], drivers[0], drivers[2]]]) {
+      const values = simulate(gates, { a: 1, b: 0 });
+      // Whichever driver wins, `p` must be derived from the reported `o`.
+      expect(values.p).toBe(values.o ^ 1);
+    }
+  });
+
+  it('lets caller-supplied values win over a gate driving the same wire', () => {
+    const values = simulate([{ op: 'AND', in1: 'a', in2: 'b', out: 'a' }], { a: 1, b: 0 });
+    expect(values.a).toBe(1);
+  });
+
+  it('leaves undriven wires out of the result', () => {
+    const values = simulate([{ op: 'AND', in1: 'a', in2: 'missing', out: 'o' }], { a: 1 });
+    expect(values).toEqual({ a: 1 });
+  });
+
+  it('matches the worked example from the task description', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+      { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },
+      { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },
+      { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },
+      { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },
+      { op: 'OR', in1: 'a01', in2: 'b01', out: 'z02' },
+    ];
+    // 3 + 1 == 4
+    const values = simulate(gates, { x00: 1, x01: 1, y00: 1, y01: 0 });
+    expect([values.z00, values.z01, values.z02]).toEqual([0, 0, 1]);
+  });
+
+  it('adds correctly for a generated 16-bit adder', () => {
+    const rand = lcg(7);
+    const gates = buildAdder(16, rand);
+    for (let trial = 0; trial < 100; trial++) {
+      const x = BigInt(Math.floor(rand() * 65536));
+      const y = BigInt(Math.floor(rand() * 65536));
+      expect(addWithCircuit(gates, 16, x, y, simulate)).toBe(x + y);
+    }
+  });
+});
