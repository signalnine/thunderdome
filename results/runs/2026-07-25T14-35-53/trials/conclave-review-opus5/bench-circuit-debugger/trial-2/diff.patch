@@ -0,0 +1,65 @@
+import type { Gate, WireValues } from './types.js';
+
+function apply(op: Gate['op'], a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+  }
+}
+
+/**
+ * Evaluate a combinational circuit.
+ *
+ * Gates fire as soon as both of their input wires hold a value, so the caller
+ * does not have to supply them in dependency order. Every wire that ends up
+ * with a value — supplied inputs included — appears in the result.
+ */
+export function simulate(gates: Gate[], inputs: WireValues): WireValues {
+  const values = new Map<string, number>();
+  for (const [wire, value] of Object.entries(inputs)) {
+    values.set(wire, value ? 1 : 0);
+  }
+
+  // wire name -> indices of gates that read it and are still waiting
+  const waitingOn = new Map<string, number[]>();
+  const missing = new Array<number>(gates.length).fill(0);
+  const ready: number[] = [];
+
+  for (let i = 0; i < gates.length; i++) {
+    const gate = gates[i];
+    let unresolved = 0;
+    for (const wire of [gate.in1, gate.in2]) {
+      if (values.has(wire)) continue;
+      unresolved++;
+      const waiters = waitingOn.get(wire);
+      if (waiters) waiters.push(i);
+      else waitingOn.set(wire, [i]);
+    }
+    missing[i] = unresolved;
+    if (unresolved === 0) ready.push(i);
+  }
+
+  while (ready.length > 0) {
+    const gate = gates[ready.pop() as number];
+    // A wire that already holds a value was driven by the caller's inputs or by
+    // an earlier gate, and its consumers have fired on that value. Keeping it
+    // is what makes the returned map self-consistent.
+    if (values.has(gate.out)) continue;
+    const value = apply(gate.op, values.get(gate.in1) as number, values.get(gate.in2) as number);
+    values.set(gate.out, value);
+    const waiters = waitingOn.get(gate.out);
+    if (!waiters) continue;
+    waitingOn.delete(gate.out);
+    for (const j of waiters) {
+      if (--missing[j] === 0) ready.push(j);
+    }
+  }
+
+  const result: WireValues = {};
+  for (const [wire, value] of values) result[wire] = value;
+  return result;
+}
