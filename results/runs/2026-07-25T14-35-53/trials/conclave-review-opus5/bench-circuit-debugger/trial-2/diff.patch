+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MFuPNDeK8QEoziGwMiiSUn","type":"tool_result","content":"1\timport type { Gate, WireValues } from './types.js';\n2\t\n3\tfunction apply(op: Gate['op'], a: number, b: number): number {\n4\t  switch (op) {\n5\t    case 'AND':\n6\t      return a & b;\n7\t    case 'OR':\n8\t      return a | b;\n9\t    case 'XOR':\n10\t      return a ^ b;\n11\t  }\n12\t}\n13\t\n14\t/**\n15\t * Evaluate a combinational circuit.\n16\t *\n17\t * Gates fire as soon as both of their input wires hold a value, so the caller\n18\t * does not have to supply them in dependency order. Every wire that ends up\n19\t * with a value — supplied inputs included — appears in the result.\n20\t */\n21\texport function simulate(gates: Gate[], inputs: WireValues): WireValues {\n22\t  const values = new Map<string, number>();\n23\t  for (const [wire, value] of Object.entries(inputs)) {\n24\t    values.set(wire, value ? 1 : 0);\n25\t  }\n26\t\n27\t  // wire name -> indices of gates that read it and are still waiting\n28\t  const waitingOn = new Map<string, number[]>();\n29\t  const missing = new Array<number>(gates.length).fill(0);\n30\t  const ready: number[] = [];\n31\t\n32\t  for (let i = 0; i < gates.length; i++) {\n33\t    const gate = gates[i];\n34\t    let unresolved = 0;\n35\t    for (const wire of [gate.in1, gate.in2]) {\n36\t      if (values.has(wire)) continue;\n37\t      unresolved++;\n38\t      const waiters = waitingOn.get(wire);\n39\t      if (waiters) waiters.push(i);\n40\t      else waitingOn.set(wire, [i]);\n41\t    }\n42\t    missing[i] = unresolved;\n43\t    if (unresolved === 0) ready.push(i);\n44\t  }\n45\t\n46\t  while (ready.length > 0) {\n47\t    const gate = gates[ready.pop() as number];\n48\t    const value = apply(gate.op, values.get(gate.in1) as number, values.get(gate.in2) as number);\n49\t    if (values.has(gate.out)) {\n50\t      // Wire already driven (by an input or a duplicate gate); record the new\n51\t      // value but do not re-propagate, since consumers have already fired.\n52\t      values.set(gate.out, value);\n53\t      continue;\n54\t    }\n55\t    values.set(gate.out, value);\n56\t    const waiters = waitingOn.get(gate.out);\n57\t    if (!waiters) continue;\n58\t    waitingOn.delete(gate.out);\n59\t    for (const j of waiters) {\n60\t      if (--missing[j] === 0) ready.push(j);\n61\t    }\n62\t  }\n63\t\n64\t  const result: WireValues = {};\n65\t  for (const [wire, value] of values) result[wire] = value;\n66\t  return result;\n67\t}\n68\t"}]},"parent_tool_use_id":"toolu_019dSHLWqJN2E7PDtWKnnwsn","session_id":"ab34c639-1ec9-4c37-9b19-3a4b962e5e9e","uuid":"545c324e-deba-407c-8cb9-ae1769002d69","timestamp":"2026-07-25T15:11:01.080Z","subagent_type":"conclave:code-reviewer","task_description":"Review circuit debugger"}
