 for the rest.\n  const accept = (repaired: Gate[]): boolean => addsCorrectly(repaired, bits, vectors);\n  const pairs = reconstructSwaps(gates, bits, SWAP_COUNT, accept, deadline / 2 + Date.now() / 2);\n  if (pairs) return pairs.flat().sort();\n\n  const suspects = structuralSuspects(gates, bits);\n  if (suspects.length === 2 * SWAP_COUNT && confirmSuspects(gates, bits, suspects, vectors)) {\n    return [...suspects].sort();\n  }\n\n  return searchRepair(gates, bits, vectors, deadline) ?? [...suspects].sort();\n}","originalFile":"import { Circuit, bitWire } from './circuit.js';\nimport { applySwaps, isInputWire, reconstructSwaps } from './reconstruct.js';\nimport type { Gate } from './types.js';\n\n/** One (x, y) stimulus together with the sum the adder is supposed to produce. */\ninterface Vector {\n  x: Uint8Array;\n  y: Uint8Array;\n  z: Uint8Array;\n  /** highest input bit index that is set — lets cheap searches skip wide vectors */\n  maxBit: number;\n}\n\nconst Z_WIRE = /^z\\d\\d$/;\n\nfunction isOutputWire(wire: string): boolean {\n  return Z_WIRE.test(wire);\n}\n\n/** Number of x/y input bits, derived from the highest `xNN` wire present. */\nexport function countInputBits(gates: Gate[]): number {\n  let highest = -1;\n  for (const gate of gates) {\n    for (const wire of [gate.in1, gate.in2]) {\n      if (wire[0] === 'x' && isInputWire(wire)) {\n        const bit = Number(wire.slice(1));\n        if (bit > highest) highest = bit;\n      }\n    }\n  }\n  return highest + 1;\n}\n\nfunction rippleSum(x: Uint8Array, y: Uint8Array): Uint8Array {\n  const bits = x.length;\n  const z = new Uint8Array(bits + 1);\n  let carry = 0;\n  for (let b = 0; b < bits; b++) {\n    const total = x[b] + y[b] + carry;\n    z[b] = total & 1;\n    carry = total > 1 ? 1 : 0;\n  }\n  z[bits] = carry;\n  return z;\n}\n\nfunction makeVector(x: Uint8Array, y: Uint8Array): Vector {\n  let maxBit = 0;\n  for (let b = 0; b < x.length; b++) {\n    if (x[b] || y[b]) maxBit = b;\n  }\n  return { x, y, z: rippleSum(x, y), maxBit };\n}\n\n/** Deterministic PRNG so results never depend on run-to-run randomness. */\nfunction lcg(seed: number): () => number {\n  let state = seed >>> 0;\n  return () => {\n    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;\n    return state / 4294967296;\n  };\n}\n\n/**\n * Stimuli that pin down every bit of a ripple-carry adder: each bit is driven\n * with all four input combinations, once with an incoming carry and once\n * without, plus whole-word patterns and a batch of pseudo-random words.\n */\nexport function buildVectors(bits: number): Vector[] {\n  const vectors: Vector[] = [];\n  const blank = (): Uint8Array => new Uint8Array(bits);\n\n  for (let b = 0; b < bits; b++) {\n    for (const carryIn of b === 0 ? [0] : [0, 1]) {\n      for (const xb of [0, 1]) {\n        for (const yb of [0, 1]) {\n          const x = blank();\n          const y = blank();\n          x[b] = xb;\n          y[b] = yb;\n          if (carryIn) {\n            x[b - 1] = 1;\n            y[b - 1] = 1;\n          }\n          vectors.push(makeVector(x, y));\n        }\n      }\n    }\n  }\n\n  const ones = new Uint8Array(bits).fill(1);\n  const one = blank();\n  one[0] = 1;\n  vectors.push(makeVector(ones.slice(), one));\n  vectors.push(makeVector(ones.slice(), ones.slice()));\n  vectors.push(makeVector(ones.slice(), blank()));\n\n  const rand = lcg(0x5eed1234);\n  for (let n = 0; n < 64; n++) {\n    const x = blank();\n    const y = blank();\n    for (let b = 0; b < bits; b++) {\n      x[b] = rand() < 0.5 ? 0 : 1;\n      y[b] = rand() < 0.5 ? 0 : 1;\n    }\n    vectors.push(makeVector(x, y));\n  }\n\n  return vectors;\n}\n\n/**\n * Lowest output bit the circuit gets wrong over the given stimuli, or -1 when\n * it behaves as a correct adder for all of them.\n */\nfunction lowestBadBit(circuit: Circuit, vectors: Vector[], bits: number): number {\n  if (!circuit.usable) return 0;\n  const actual = new Uint8Array(bits + 1);\n  let worst = bits + 1;\n  for (const vector of vectors) {\n    circuit.evaluate(vector.x, vector.y, actual);\n    for (let b = 0; b < worst; b++) {\n      if (actual[b] !== vector.z[b]) {\n        worst = b;\n        break;\n      }\n    }\n    if (worst === 0) return 0;\n  }\n  return worst === bits + 1 ? -1 : worst;\n}\n\nfunction addsCorrectly(gates: Gate[], bits: number, vectors: Vector[]): boolean {\n  return lowestBadBit(new Circuit(gates, bits), vectors, bits) === -1;\n}\n\n/**\n * Wires that cannot be doing the job a ripple-carry adder needs, judged purely\n * from local structure:\n *\n *  - every `zNN` except the most significant is the XOR of a partial sum and a\n *    carry (the MSB is the final carry, so it comes from an OR);\n *  - a XOR that does not drive a `zNN` must be a partial sum, so it reads\n *    `xNN`/`yNN` directly and must feed the bit's final-sum XOR;\n *  - an AND (other than the bit-0 half adder) generates a carry, so its output\n *    may only be consumed by an OR;\n *  - a carry (from an OR) feeds the next bit's XOR and AND, never another OR.\n *\n * These rules miss swaps between structurally interchangeable wires, so they\n * only back up the reconstruction walk.\n */\nfunction structuralSuspects(gates: Gate[], bits: number): string[] {\n  const suspects = new Set<string>();\n  const topZ = bitWire('z', bits);\n\n  const consumerOps = new Map<string, Set<Gate['op']>>();\n  for (const gate of gates) {\n    for (const wire of [gate.in1, gate.in2]) {\n      let ops = consumerOps.get(wire);\n      if (!ops) {\n        ops = new Set();\n        consumerOps.set(wire, ops);\n      }\n      ops.add(gate.op);\n    }\n  }\n  const consumersOf = (wire: string): Set<Gate['op']> => consumerOps.get(wire) ?? new Set();\n\n  for (const gate of gates) {\n    const fromInputs = isInputWire(gate.in1) && isInputWire(gate.in2);\n    const isHalfAdder = fromInputs && gate.in1.slice(1) === '00';\n\n    if (isOutputWire(gate.out)) {\n      if (gate.out === topZ) {\n        if (bits >= 2 && gate.op !== 'OR') suspects.add(gate.out);\n      } else if (gate.op !== 'XOR') {\n        suspects.add(gate.out);\n      } else if (gate.out === 'z00' ? !isHalfAdder : fromInputs) {\n        suspects.add(gate.out);\n      }\n      continue;\n    }\n\n    if (gate.op === 'XOR') {\n      if (!fromInputs || (!isHalfAdder && !consumersOf(gate.out).has('XOR'))) {\n        suspects.add(gate.out);\n      }\n    } else if (gate.op === 'AND') {\n      if (!isHalfAdder && [...consumersOf(gate.out)].some((op) => op !== 'OR')) {\n        suspects.add(gate.out);\n      }\n    } else if (consumersOf(gate.out).has('OR')) {\n      suspects.add(gate.out);\n    }\n  }\n\n  return [...suspects];\n}\n\n/** Every way to split `wires` into unordered pairs. */\nfunction perfectMatchings(wires: string[]): Array<Array<[string, string]>> {\n  if (wires.length === 0) return [[]];\n  const [first, ...rest] = wires;\n  const result: Array<Array<[string, string]>> = [];\n  for (let i = 0; i < rest.length; i++) {\n    const remaining = rest.slice(0, i).concat(rest.slice(i + 1));\n    for (const tail of perfectMatchings(remaining)) {\n      result.push([[first, rest[i]], ...tail]);\n    }\n  }\n  return result;\n}\n\n/**\n * Confirm a suspect set by finding a pairing of its members that turns the\n * circuit back into a working adder.\n */\nfunction confirmSuspects(\n  gates: Gate[],\n  bits: number,\n  suspects: string[],\n  vectors: Vector[],\n): boolean {\n  return perfectMatchings(suspects).some((pairing) =>\n    addsCorrectly(applySwaps(gates, pairing), bits, vectors),\n  );\n}\n\n/** Transitive fan-in of a wire, as the set of gate-output wire names. */\nfunction fanIn(gates: Gate[], wire: string): Set<string> {\n  const producer = new Map<string, Gate>();\n  for (const gate of gates) producer.set(gate.out, gate);\n  const seen = new Set<string>();\n  const stack = [wire];\n  while (stack.length > 0) {\n    const current = stack.pop() as string;\n    if (seen.has(current)) continue;\n    const gate = producer.get(current);\n    if (!gate) continue;\n    seen.add(current);\n    stack.push(gate.in1, gate.in2);\n  }\n  return seen;\n}\n\n/**\n * Last-resort search: at the lowest broken bit, try exchanging a wire from its\n * cone with any other gate output and keep the swaps that push the first\n * failure higher, backtracking over the most promising candidates.\n */\nfunction searchRepair(\n  gates: Gate[],\n  bits: number,\n  vectors: Vector[],\n  deadline: number,\n): string[] | null {\n  const allOutputs = gates.map((gate) => gate.out);\n\n  const explore = (current: Gate[], found: string[], depth: number): string[] | null => {\n    const bad = lowestBadBit(new Circuit(current, bits), vectors, bits);\n    if (bad === -1) return found.length === 8 ? [...found].sort() : null;\n    if (depth === 4 || Date.now() > deadline) return null;\n\n    const cheap = vectors.filter((vector) => vector.maxBit <= bad + 2);\n    const cone = fanIn(current, bitWire('z', bad));\n    const previous = bad > 0 ? fanIn(current, bitWire('z', bad - 1)) : new Set<string>();\n    const fresh = [...cone].filter((wire) => !previous.has(wire));\n\n    let options: Array<{ pair: [string, string]; score: number }> = [];\n    for (const sources of [fresh, [...cone], allOutputs]) {\n      const tried = new Set<string>();\n      for (const a of sources) {\n        for (const b of allOutputs) {\n          if (a === b) continue;\n          const key = a < b ? `${a}|${b}` : `${b}|${a}`;\n          if (tried.has(key)) continue;\n          tried.add(key);\n          const circuit = new Circuit(applySwaps(current, [[a, b]]), bits);\n          if (!circuit.usable) continue;\n          const score = lowestBadBit(circuit, cheap, bits);\n          if (score === -1 || score > bad) {\n            options.push({ pair: [a, b], score: score === -1 ? bits + 2 : score });\n          }\n        }\n        if (Date.now() > deadline) break;\n      }\n      if (options.length > 0 || Date.now() > deadline) break;\n    }\n\n    options.sort((left, right) => right.score - left.score);\n    options = options.slice(0, 8);\n    for (const option of options) {\n      const next = explore(\n        applySwaps(current, [option.pair]),\n        [...found, ...option.pair],\n        depth + 1,\n      );\n      if (next) return next;\n      if (Date.now() > deadline) break;\n    }\n    return null;\n  };\n\n  return explore(gates, [], 0);\n}\n\n/**\n * Identify the eight wires involved in the four output swaps that stop the\n * circuit from adding correctly.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  const bits = countInputBits(gates);\n  if (bits === 0) return [];\n  const vectors = buildVectors(bits);\n\n  const accept = (repaired: Gate[]): boolean => addsCorrectly(repaired, bits, vectors);\n  const pairs = reconstructSwaps(gates, bits, 4, accept);\n  if (pairs) return pairs.flat().sort();\n\n  const suspects = structuralSuspects(gates, bits);\n  if (suspects.length === 8 && confirmSuspects(gates, bits, suspects, vectors)) {\n    return [...suspects].sort();\n  }\n\n  const repaired = searchRepair(gates, bits, vectors, Date.now() + 3000);\n  if (repaired) return repaired;\n\n  return [...suspects].sort();\n}\n","structuredPatch":[{"oldStart":304,"oldLines":6,"newStart":304,"newLines":11,"lines":["   return explore(gates, [], 0);"," }"," ","+/** Four pairs of outputs are swapped, so eight wire names are wrong. */","+const SWAP_COUNT = 4;","+/** Leaves headroom under the five seconds the caller is allowed. */","+const TIME_BUDGET_MS = 4000;","+"," /**","  * Identify the eight wires involved in the four output swaps that stop the","  * circuit from adding correctly."]},{"oldStart":312,"oldLines":18,"newStart":317,"newLines":18,"lines":["   const bits = countInputBits(gates);","   if (bits === 0) return [];","   const vectors = buildVectors(bits);","+  const deadline = Date.now() + TIME_BUDGET_MS;"," ","+  // Reconstructing the adder gate