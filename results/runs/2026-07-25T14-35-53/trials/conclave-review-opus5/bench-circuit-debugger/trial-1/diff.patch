index 0000000..aa020bb
--- /dev/null
+++ b/src/circuit.ts
@@ -0,0 +1,260 @@
+import type { Gate, GateOp } from './types.js';
+
+export const OP_AND = 0;
+export const OP_OR = 1;
+export const OP_XOR = 2;
+
+const OP_CODES: Record<string, number> = { AND: OP_AND, OR: OP_OR, XOR: OP_XOR };
+
+export const X_WIRE = /^x(\d+)$/;
+export const Y_WIRE = /^y(\d+)$/;
+export const Z_WIRE = /^z(\d+)$/;
+
+/**
+ * A circuit flattened into typed arrays so the swap search can re-evaluate it
+ * tens of thousands of times without allocating.
+ *
+ * `out` is the only mutable wiring: swapping two entries models swapping two
+ * gates' output wires. `refresh` must be called afterwards to rebuild the
+ * producer map and evaluation order.
+ */
+export interface Circuit {
+  /** Number of X (and Y) input bits; the sum has `bits + 1` bits. */
+  bits: number;
+  gateCount: number;
+  wireCount: number;
+  op: Uint8Array;
+  in1: Int32Array;
+  in2: Int32Array;
+  out: Int32Array;
+  /** Wire index of each x/y/z bit, or -1 when the wire is absent. */
+  xIndex: Int32Array;
+  yIndex: Int32Array;
+  zIndex: Int32Array;
+  wireNames: string[];
+  /** Gate index producing each wire, or -1 for a primary input. */
+  producer: Int32Array;
+  /** Gates in evaluation order; only the first `orderLength` entries are valid. */
+  order: Int32Array;
+  orderLength: number;
+  /** False when the current wiring contains a cycle. */
+  acyclic: boolean;
+  // Static consumer adjacency in CSR form: consumers of wire w are
+  // consumerList[consumerStart[w] .. consumerStart[w + 1]).
+  consumerStart: Int32Array;
+  consumerList: Int32Array;
+  // Scratch buffers reused across evaluations.
+  values: Int8Array;
+  pending: Int32Array;
+  queue: Int32Array;
+}
+
+/** Flatten gates into a {@link Circuit}. Does not mutate `gates`. */
+export function compile(gates: Gate[]): Circuit {
+  const index = new Map<string, number>();
+  const wireNames: string[] = [];
+  const wireIndex = (name: string): number => {
+    const existing = index.get(name);
+    if (existing !== undefined) return existing;
+    const id = wireNames.length;
+    index.set(name, id);
+    wireNames.push(name);
+    return id;
+  };
+
+  const gateCount = gates.length;
+  const op = new Uint8Array(gateCount);
+  const in1 = new Int32Array(gateCount);
+  const in2 = new Int32Array(gateCount);
+  const out = new Int32Array(gateCount);
+
+  for (let i = 0; i < gateCount; i++) {
+    const gate = gates[i];
+    const code = OP_CODES[gate.op];
+    if (code === undefined) throw new Error(`Unknown gate operation: ${String(gate.op)}`);
+    op[i] = code;
+    in1[i] = wireIndex(gate.in1);
+    in2[i] = wireIndex(gate.in2);
+    out[i] = wireIndex(gate.out);
+  }
+
+  // Bit positions come from parsing the wire names actually present, so any
+  // zero-padding convention works.
+  const xAt = new Map<number, number>();
+  const yAt = new Map<number, number>();
+  const zAt = new Map<number, number>();
+  let maxX = -1;
+  let maxZ = -1;
+  for (let id = 0; id < wireNames.length; id++) {
+    const name = wireNames[id];
+    const x = X_WIRE.exec(name);
+    if (x !== null) {
+      const bit = Number(x[1]);
+      maxX = Math.max(maxX, bit);
+      xAt.set(bit, id);
+      continue;
+    }
+    const y = Y_WIRE.exec(name);
+    if (y !== null) {
+      yAt.set(Number(y[1]), id);
+      continue;
+    }
+    const z = Z_WIRE.exec(name);
+    if (z !== null) {
+      const bit = Number(z[1]);
+      maxZ = Math.max(maxZ, bit);
+      zAt.set(bit, id);
+    }
+  }
+  const bits = Math.max(maxX + 1, maxZ);
+
+  const wireCount = wireNames.length;
+  const xIndex = new Int32Array(bits).fill(-1);
+  const yIndex = new Int32Array(bits).fill(-1);
+  const zIndex = new Int32Array(bits + 1).fill(-1);
+  for (let bit = 0; bit < bits; bit++) {
+    xIndex[bit] = xAt.get(bit) ?? -1;
+    yIndex[bit] = yAt.get(bit) ?? -1;
+  }
+  for (let bit = 0; bit <= bits; bit++) {
+    zIndex[bit] = zAt.get(bit) ?? -1;
+  }
+
+  // Consumer adjacency (independent of the mutable `out` array).
+  const counts = new Int32Array(wireCount + 1);
+  for (let i = 0; i < gateCount; i++) {
+    counts[in1[i]]++;
+    counts[in2[i]]++;
+  }
+  const consumerStart = new Int32Array(wireCount + 1);
+  let total = 0;
+  for (let w = 0; w < wireCount; w++) {
+    consumerStart[w] = total;
+    total += counts[w];
+  }
+  consumerStart[wireCount] = total;
+  const consumerList = new Int32Array(total);
+  const cursor = consumerStart.slice(0, wireCount);
+  for (let i = 0; i < gateCount; i++) {
+    consumerList[cursor[in1[i]]++] = i;
+    consumerList[cursor[in2[i]]++] = i;
+  }
+
+  const circuit: Circuit = {
+    bits,
+    gateCount,
+    wireCount,
+    op,
+    in1,
+    in2,
+    out,
+    xIndex,
+    yIndex,
+    zIndex,
+    wireNames,
+    producer: new Int32Array(wireCount).fill(-1),
+    order: new Int32Array(gateCount),
+    orderLength: 0,
+    acyclic: false,
+    consumerStart,
+    consumerList,
+    values: new Int8Array(wireCount),
+    pending: new Int32Array(gateCount),
+    queue: new Int32Array(gateCount),
+  };
+  refresh(circuit);
+  return circuit;
+}
+
+/** Rebuild the producer map and topological order after `out` changed. */
+export function refresh(circuit: Circuit): boolean {
+  const { producer, out, in1, in2, pending, queue, order, consumerStart, consumerList } = circuit;
+  producer.fill(-1);
+  for (let i = 0; i < circuit.gateCount; i++) producer[out[i]] = i;
+
+  let head = 0;
+  let tail = 0;
+  for (let i = 0; i < circuit.gateCount; i++) {
+    // Inputs driven by another gate are the ones worth waiting for; anything
+    // else is a primary input and already available.
+    let awaited = 0;
+    if (producer[in1[i]] >= 0) awaited++;
+    if (producer[in2[i]] >= 0) awaited++;
+    pending[i] = awaited;
+    if (awaited === 0) queue[tail++] = i;
+  }
+
+  let emitted = 0;
+  while (head < tail) {
+    const gate = queue[head++];
+    order[emitted++] = gate;
+    const wire = out[gate];
+    const end = consumerStart[wire + 1];
+    for (let k = consumerStart[wire]; k < end; k++) {
+      const consumer = consumerList[k];
+      if (--pending[consumer] === 0) queue[tail++] = consumer;
+    }
+  }
+
+  circuit.orderLength = emitted;
+  circuit.acyclic = emitted === circuit.gateCount;
+  return circuit.acyclic;
+}
+
+/** Swap the output wires of two gates and rebuild the evaluation order. */
+export function swapOutputs(circuit: Circuit, gateA: number, gateB: number): boolean {
+  const tmp = circuit.out[gateA];
+  circuit.out[gateA] = circuit.out[gateB];
+  circuit.out[gateB] = tmp;
+  return refresh(circuit);
+}
+
+/** Written to `zOut` for an output bit the circuit never settles on. */
+export const UNKNOWN = 2;
+
+/**
+ * Evaluate the circuit for the given X/Y bit vectors, writing the `bits + 1`
+ * output bits into `zOut`.
+ *
+ * A cyclic wiring is evaluated as far as it goes: gates inside or downstream of
+ * a cycle never fire and their output bits come back as {@link UNKNOWN}. That
+ * matters during a repair search, where an intermediate wiring may be cyclic
+ * while the low bits under repair are still perfectly well defined.
+ */
+export function evaluate(circuit: Circuit, x: Uint8Array, y: Uint8Array, zOut: Uint8Array): void {
+  const { values, op, in1, in2, out, order, orderLength, xIndex, yIndex, zIndex, bits } = circuit;
+  const { producer, wireCount } = circuit;
+  for (let wire = 0; wire < wireCount; wire++) values[wire] = producer[wire] >= 0 ? -1 : 0;
+  for (let bit = 0; bit < bits; bit++) {
+    const xi = xIndex[bit];
+    if (xi >= 0) values[xi] = x[bit];
+    const yi = yIndex[bit];
+    if (yi >= 0) values[yi] = y[bit];
+  }
+  for (let k = 0; k < orderLength; k++) {
+    const gate = order[k];
+    const a = values[in1[gate]];
+    const b = values[in2[gate]];
+    const code = op[gate];
+    values[out[gate]] = code === OP_AND ? a & b : code === OP_OR ? a | b : a ^ b;
+  }
+  for (let bit = 0; bit <= bits; bit++) {
+    const zi = zIndex[bit];
+    zOut[bit] = zi >= 0 && values[zi] >= 0 ? values[zi] : UNKNOWN;
+  }
+}
+
+/** Apply the current wiring back onto a fresh gate list. */
+export function toGates(circuit: Circuit): Gate[] {
+  const ops: readonly GateOp[] = ['AND', 'OR', 'XOR'];
+  const gates: Gate[] = [];
+  for (let i = 0; i < circuit.gateCount; i++) {
+    gates.push({
+      op: ops[circuit.op[i]],
+      in1: circuit.wireNames[circuit.in1[i]],
+      in2: circuit.wireNames[circuit.in2[i]],
+      out: circuit.wireNames[circuit.out[i]],
+    });
+  }
+  return gates;
+}
diff --git a/src/findSwapped.ts b/src/findSwapped.ts
new file mode 100644
index 0000000..4deb57b
--- /dev/null
+++ b/src/findSwapped.ts
@@ -0,0 +1,292 @@
+import {
+  bitSettled,
+  buildTestSuite,
+  isCorrectAdder,
+  lowestFailingBit,
+  type TestSuite,
+} from './adder.js';
+import { compile, swapOutputs, toGates, type Circuit } from './circuit.js';
+import { reconstruct } from './reconstruct.js';
+import { structuralSuspects } from './structural.js';
+import type { Gate } from './types.js';
+
+/** Number of swapped pairs the circuit is known to contain. */
+const SWAP_COUNT = 4;
+
+/**
+ * Wall-clock budget shared by every strategy, comfortably inside the 5s
+ * requirement even allowing for a slow final verification.
+ */
+const TIME_BUDGET_MS = 2500;
+
+/** How convincing a candidate repair is. */
+enum Quality {
+  /** Still not an adder. */
+  Broken = 0,
+  /** Adds correctly, but the gate wiring is not the textbook shape. */
+  Functional = 1,
+  /** Adds correctly *and* every gate sits in its canonical role. */
+  Canonical = 2,
+}
+
+/**
+ * Grade the circuit as it is currently wired.
+ *
+ * Functional correctness alone can be ambiguous: a handful of wire names are
+ * interchangeable, so more than one repair may add correctly. The original
+ * circuit was a textbook ripple-carry adder, so a repair that also restores
+ * every structural invariant is the one that was intended.
+ */
+function grade(circuit: Circuit, suite: TestSuite, scratch: Uint8Array): Quality {
+  if (!circuit.acyclic) return Quality.Broken;
+  if (!isCorrectAdder(circuit, suite, scratch)) return Quality.Broken;
+  const suspects = structuralSuspects(toGates(circuit), circuit.bits);
+  return suspects.length === 0 ? Quality.Canonical : Quality.Functional;
+}
+
+interface Search {
+  circuit: Circuit;
+  suite: TestSuite;
+  scratch: Uint8Array;
+  used: Uint8Array;
+  chosen: number[];
+  /** Best functional-but-not-canonical repair seen so far, if any. */
+  fallback: number[] | null;
+  deadline: number;
+  /** Gate indices ordered so structurally suspicious gates are tried first. */
+  ranked: Int32Array;
+  coneMark: Uint8Array;
+  coneStack: Int32Array;
+}
+
+/** Gate indices that (transitively) feed `wire`, including its own producer. */
+function ancestorGates(search: Search, wire: number): number[] {
+  const { circuit, coneMark, coneStack } = search;
+  const gates: number[] = [];
+  if (wire < 0 || circuit.producer[wire] < 0) return gates;
+  coneMark.fill(0);
+  let top = 0;
+  const producer = circuit.producer[wire];
+  coneStack[top++] = producer;
+  coneMark[producer] = 1;
+  while (top > 0) {
+    const gate = coneStack[--top];
+    gates.push(gate);
+    const left = circuit.producer[circuit.in1[gate]];
+    if (left >= 0 && coneMark[left] === 0) {
+      coneMark[left] = 1;
+      coneStack[top++] = left;
+    }
+    const right = circuit.producer[circuit.in2[gate]];
+    if (right >= 0 && coneMark[right] === 0) {
+      coneMark[right] = 1;
+      coneStack[top++] = right;
+    }
+  }
+  return gates;
+}
+
+/**
+ * Repair the circuit one swap at a time, lowest broken output bit first.
+ *
+ * A ripple-carry adder is built up bit by bit, so the lowest z index that
+ * disagrees with x + y pins down where the damage starts. At least one gate of
+ * the swap responsible for it must sit in the cone feeding that bit — otherwise
+ * its wrong value could not reach the bit — so it suffices to pair each gate in
+ * that cone with every gate in the circuit, rather than trying all pairs. Only
+ * candidates that strictly raise the lowest broken bit are explored, which bounds
+ * the recursion to the four swaps we are looking for.
+ *
+ * Returns true once a canonical repair is found. A merely functional repair is
+ * remembered in `search.fallback` and the search continues, since the intended
+ * answer is the canonical one.
+ */
+function searchSwaps(search: Search, depth: number, lowest: number): boolean {
+  const { circuit, suite, scratch, used, chosen, ranked } = search;
+  if (lowest === suite.clean) {
+    const quality = grade(circuit, suite, scratch);
+    if (quality === Quality.Canonical) return true;
+    if (quality === Quality.Functional && search.fallback === null) {
+      search.fallback = [...chosen];
+    }
+    return false;
+  }
+  if (depth === SWAP_COUNT) return false;
+  if (Date.now() > search.deadline) return false;
+
+  const targetBit = Math.min(lowest, circuit.bits);
+  const cone = ancestorGates(search, circuit.zIndex[targetBit]);
+  const outer: number[] = [];
+  if (cone.length === 0) {
+    for (let i = 0; i < ranked.length; i++) outer.push(ranked[i]);
+  } else {
+    const inCone = new Uint8Array(circuit.gateCount);
+    for (const gate of cone) inCone[gate] = 1;
+    // Ranked order tries structurally suspicious gates first; they hit far more
+    // often than the rest.
+    for (let i = 0; i < ranked.length; i++) {
+      if (inCone[ranked[i]] === 1) outer.push(ranked[i]);
+    }
+  }
+
+  const tried = new Set<number>();
+  for (const a of outer) {
+    if (used[a] === 1) continue;
+    for (let i = 0; i < ranked.length; i++) {
+      const b = ranked[i];
+      if (b === a || used[b] === 1) continue;
+      const key = a < b ? a * circuit.gateCount + b : b * circuit.gateCount + a;
+      if (tried.has(key)) continue;
+      tried.add(key);
+
+      swapOutputs(circuit, a, b);
+      // Re-check just the broken bit first: eight evaluations instead of the
+      // whole suite, which is what keeps the candidate sweep affordable. Bits
+      // above it may still be broken, and the wiring may even be cyclic further
+      // up; both are fine at this stage.
+      if (lowest >= circuit.bits || bitSettled(circuit, suite, lowest, scratch)) {
+        const next = lowestFailingBit(circuit, suite, scratch);
+        if (next > lowest) {
+          used[a] = 1;
+          used[b] = 1;
+          chosen.push(a, b);
+          const done = searchSwaps(search, depth + 1, next);
+          if (done) return true;
+          chosen.length -= 2;
+          used[a] = 0;
+          used[b] = 0;
+        }
+      }
+      swapOutputs(circuit, a, b);
+      if (Date.now() > search.deadline) return false;
+    }
+  }
+  return false;
+}
+
+/**
+ * Try every way of pairing up `gateIndices` (even length) and stop at the first
+ * pairing whose swaps restore a canonical adder. Leaves the winning swaps
+ * applied; restores the original wiring when there is no winner.
+ */
+function matchPairs(
+  circuit: Circuit,
+  suite: TestSuite,
+  scratch: Uint8Array,
+  gateIndices: number[],
+  deadline: number,
+): boolean {
+  const remaining = [...gateIndices];
+  const recurse = (): boolean => {
+    if (Date.now() > deadline) return false;
+    if (remaining.length === 0) return grade(circuit, suite, scratch) === Quality.Canonical;
+    const a = remaining.shift() as number;
+    for (let i = 0; i < remaining.length; i++) {
+      const b = remaining[i];
+      remaining.splice(i, 1);
+      swapOutputs(circuit, a, b);
+      if (recurse()) return true;
+      swapOutputs(circuit, a, b);
+      remaining.splice(i, 0, b);
+    }
+    remaining.unshift(a);
+    return false;
+  };
+  return recurse();
+}
+
+/** Sorted, de-duplicated wire names from a list of swapped pairs. */
+function wiresOf(pairs: Array<[string, string]>): string[] {
+  return [...new Set(pairs.flat())].sort();
+}
+
+/**
+ * Shape an unverified guess like a real answer: at most four pairs' worth of
+ * wires, and an even count, so callers can always pair the result up.
+ */
+function asPairedGuess(wires: string[]): string[] {
+  const capped = wires.slice(0, SWAP_COUNT * 2);
+  return capped.length % 2 === 0 ? capped : capped.slice(0, -1);
+}
+
+/**
+ * Find the eight wires whose gate outputs were swapped in a broken binary adder.
+ *
+ * The primary strategy reconstructs the adder bit by bit to recover each gate's
+ * intended output wire directly (see {@link reconstruct}). Two independent
+ * fallbacks cover circuits it cannot unpick: structural rules that nominate
+ * suspects, and a simulation-driven repair search.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  if (gates.length === 0) return [];
+
+  const circuit = compile(gates);
+  const suite = buildTestSuite(circuit.bits);
+  const scratch = new Uint8Array(circuit.bits + 1);
+
+  if (grade(circuit, suite, scratch) !== Quality.Broken) return [];
+
+  // Insist on a textbook result first; settle for one that merely adds correctly
+  // if the circuit has quirks the structural rules do not expect. Each pass gets
+  // its own slice of the budget so a hopeless first pass cannot starve the rest.
+  const started = Date.now();
+  // The first pass is the one that resolves real circuits, so it gets the bulk
+  // of the time; the later strategies only matter for malformed input.
+  const slices = [
+    { bar: Quality.Canonical, until: started + TIME_BUDGET_MS * 0.6 },
+    { bar: Quality.Functional, until: started + TIME_BUDGET_MS * 0.85 },
+  ];
+  for (const { bar, until } of slices) {
+    const accept = (repaired: Gate[]): boolean =>
+      grade(compile(repaired), suite, scratch) >= bar;
+    const rebuilt = reconstruct(gates, circuit.bits, accept, until);
+    if (rebuilt !== null && rebuilt.pairs.length > 0) return wiresOf(rebuilt.pairs);
+  }
+
+  const suspects = structuralSuspects(gates, circuit.bits).sort();
+  const gateForWire = new Map<string, number>();
+  for (let i = 0; i < gates.length; i++) gateForWire.set(gates[i].out, i);
+  const suspectGates: number[] = [];
+  for (const wire of suspects) {
+    const gate = gateForWire.get(wire);
+    if (gate !== undefined) suspectGates.push(gate);
+  }
+
+  const deadline = started + TIME_BUDGET_MS;
+  if (
+    suspectGates.length === SWAP_COUNT * 2 &&
+    matchPairs(circuit, suite, scratch, suspectGates, deadline)
+  ) {
+    return suspects;
+  }
+
+  const suspectSet = new Set(suspectGates);
+  const ranked = new Int32Array(circuit.gateCount);
+  let cursor = 0;
+  for (const gate of suspectGates) ranked[cursor++] = gate;
+  for (let i = 0; i < circuit.gateCount; i++) {
+    if (!suspectSet.has(i)) ranked[cursor++] = i;
+  }
+
+  const search: Search = {
+    circuit,
+    suite,
+    scratch,
+    used: new Uint8Array(circuit.gateCount),
+    chosen: [],
+    fallback: null,
+    deadline,
+    ranked,
+    coneMark: new Uint8Array(circuit.gateCount),
+    coneStack: new Int32Array(circuit.gateCount),
+  };
+
+  const found = searchSwaps(search, 0, lowestFailingBit(circuit, suite, scratch))
+    ? search.chosen
+    : search.fallback;
+  if (found !== null) return found.map((gate) => gates[gate].out).sort();
+
+  // Nothing could be verified, so the circuit is not the adder we were promised.
+  // The structural suspects remain the best guess available.
+  return asPairedGuess(suspects);
+}
