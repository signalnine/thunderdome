index 0000000..0bd3fd8
--- /dev/null
+++ b/src/structural.ts
@@ -0,0 +1,102 @@
+import { X_WIRE, Y_WIRE, Z_WIRE } from './circuit.js';
+import type { Gate } from './types.js';
+
+interface WireKind {
+  /** Bit position for x/y/z wires, otherwise -1. */
+  bit: number;
+  isX: boolean;
+  isY: boolean;
+  isZ: boolean;
+}
+
+function classify(name: string): WireKind {
+  const x = X_WIRE.exec(name);
+  if (x !== null) return { bit: Number(x[1]), isX: true, isY: false, isZ: false };
+  const y = Y_WIRE.exec(name);
+  if (y !== null) return { bit: Number(y[1]), isX: false, isY: true, isZ: false };
+  const z = Z_WIRE.exec(name);
+  if (z !== null) return { bit: Number(z[1]), isX: false, isY: false, isZ: true };
+  return { bit: -1, isX: false, isY: false, isZ: false };
+}
+
+/** True when `ops` is exactly the given operations, which must be distinct. */
+function consumedBy(ops: Set<string>, ...expected: string[]): boolean {
+  if (ops.size !== expected.length) return false;
+  return expected.every((op) => ops.has(op));
+}
+
+/**
+ * Flag gate outputs that violate the shape of a ripple-carry adder.
+ *
+ * A correct adder wires gates together in only a few ways, so each rule below
+ * is a local invariant that no correct gate can break:
+ *
+ * - `z00` is `x00 XOR y00`; `zNN` in between is a XOR of a partial sum and a
+ *   carry; the top `z` bit is the final carry (an OR, or an AND for a one-bit
+ *   adder).
+ * - A partial sum (internal XOR) reads `xNN`/`yNN` of one bit and is consumed
+ *   by exactly one XOR (the sum) and one AND (carry propagate).
+ * - A carry term (internal AND) is consumed by exactly one OR, except the bit 0
+ *   carry, which acts as a carry and so is consumed by a XOR and an AND.
+ * - A carry (internal OR) is consumed by exactly one XOR and one AND.
+ *
+ * Note that a wire's consumers depend only on gates' *input* fields, which
+ * swapping outputs never touches — so these consumer profiles describe the
+ * role the wire was designed for, and comparing them against the gate that now
+ * drives the wire exposes the swap.
+ *
+ * The result is only a hypothesis: the caller must confirm it by pairing the
+ * suspects up and simulating.
+ */
+export function structuralSuspects(gates: Gate[], bits: number): string[] {
+  const consumerOps = new Map<string, Set<string>>();
+  const note = (wire: string, op: string): void => {
+    const set = consumerOps.get(wire);
+    if (set === undefined) consumerOps.set(wire, new Set([op]));
+    else set.add(op);
+  };
+  for (const gate of gates) {
+    note(gate.in1, gate.op);
+    note(gate.in2, gate.op);
+  }
+
+  const topBit = bits; // z index holding the final carry
+  const suspects = new Set<string>();
+
+  for (const gate of gates) {
+    const out = classify(gate.out);
+    const a = classify(gate.in1);
+    const b = classify(gate.in2);
+    const fromInputs = ((a.isX && b.isY) || (a.isY && b.isX)) && a.bit === b.bit;
+    const inputBit = fromInputs ? a.bit : -1;
+    const consumers = consumerOps.get(gate.out) ?? new Set<string>();
+
+    if (out.isZ) {
+      if (out.bit === topBit) {
+        const expected = bits <= 1 ? 'AND' : 'OR';
+        if (gate.op !== expected) suspects.add(gate.out);
+      } else if (gate.op !== 'XOR') {
+        suspects.add(gate.out);
+      } else if (out.bit === 0) {
+        if (inputBit !== 0) suspects.add(gate.out);
+      } else if (fromInputs) {
+        suspects.add(gate.out);
+      }
+      continue;
+    }
+
+    if (gate.op === 'XOR') {
+      if (inputBit < 1 || !consumedBy(consumers, 'XOR', 'AND')) suspects.add(gate.out);
+    } else if (gate.op === 'AND') {
+      if (fromInputs && inputBit === 0) {
+        if (!consumedBy(consumers, 'XOR', 'AND')) suspects.add(gate.out);
+      } else if (!consumedBy(consumers, 'OR')) {
+        suspects.add(gate.out);
+      }
+    } else if (!consumedBy(consumers, 'XOR', 'AND')) {
+      suspects.add(gate.out);
+    }
+  }
+
+  return [...suspects];
+}
