+/** Logic operation performed by a gate. */
+export type GateOp = 'AND' | 'OR' | 'XOR';
+
+/** A single two-input logic gate. */
+export interface Gate {
+  op: GateOp;
+  /** First input wire name. */
+  in1: string;
+  /** Second input wire name. */
+  in2: string;
+  /** Output wire name. */
+  out: string;
+}
