index 0000000..a6f2068
--- /dev/null
+++ b/tests/helpers/adderFixture.ts
@@ -0,0 +1,113 @@
+import type { Gate } from '../../src/types.js';
+
+/** Deterministic PRNG so failures are reproducible. */
+export function makeRandom(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (state * 1664525 + 1013904223) >>> 0;
+    return state / 0x100000000;
+  };
+}
+
+export function label(bit: number): string {
+  return String(bit).padStart(2, '0');
+}
+
+/**
+ * Build a correct `bits`-wide ripple-carry adder whose internal wires have
+ * random three-letter names, matching the shape described in the task.
+ */
+export function buildAdder(bits: number, random: () => number): Gate[] {
+  const alphabet = 'abcdefghijklmnopqrstuvwxyz';
+  const usedNames = new Set<string>();
+  const freshName = (): string => {
+    for (;;) {
+      let name = '';
+      for (let i = 0; i < 3; i++) name += alphabet[Math.floor(random() * 26)];
+      if (!usedNames.has(name)) {
+        usedNames.add(name);
+        return name;
+      }
+    }
+  };
+
+  const gates: Gate[] = [];
+  if (bits === 1) {
+    gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+    gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'z01' });
+    return gates;
+  }
+
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  let carry = freshName();
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: carry });
+
+  for (let bit = 1; bit < bits; bit++) {
+    const partial = freshName();
+    const generate = freshName();
+    const propagate = freshName();
+    gates.push({ op: 'XOR', in1: `x${label(bit)}`, in2: `y${label(bit)}`, out: partial });
+    gates.push({ op: 'XOR', in1: partial, in2: carry, out: `z${label(bit)}` });
+    gates.push({ op: 'AND', in1: `x${label(bit)}`, in2: `y${label(bit)}`, out: generate });
+    gates.push({ op: 'AND', in1: partial, in2: carry, out: propagate });
+    const nextCarry = bit === bits - 1 ? `z${label(bits)}` : freshName();
+    gates.push({ op: 'OR', in1: generate, in2: propagate, out: nextCarry });
+    carry = nextCarry;
+  }
+
+  // Shuffle: gate order must not matter.
+  for (let i = gates.length - 1; i > 0; i--) {
+    const j = Math.floor(random() * (i + 1));
+    const tmp = gates[i];
+    gates[i] = gates[j];
+    gates[j] = tmp;
+  }
+  return gates;
+}
+
+/** Add two bit vectors, returning `bits + 1` result bits (LSB first). */
+export function addBits(x: number[], y: number[], bits: number): number[] {
+  const z: number[] = [];
+  let carry = 0;
+  for (let bit = 0; bit < bits; bit++) {
+    const sum = (x[bit] ?? 0) + (y[bit] ?? 0) + carry;
+    z.push(sum & 1);
+    carry = sum >> 1;
+  }
+  z.push(carry);
+  return z;
+}
+
+export function inputsFor(x: number[], y: number[], bits: number): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  for (let bit = 0; bit < bits; bit++) {
+    inputs[`x${label(bit)}`] = x[bit] ?? 0;
+    inputs[`y${label(bit)}`] = y[bit] ?? 0;
+  }
+  return inputs;
+}
+
+export function randomBits(bits: number, random: () => number): number[] {
+  const out: number[] = [];
+  for (let bit = 0; bit < bits; bit++) out.push(random() < 0.5 ? 1 : 0);
+  return out;
+}
+
+/**
+ * Swap `count` disjoint pairs of gate output wires, returning the broken
+ * circuit and the sorted names of the wires involved.
+ */
+export function applySwaps(
+  gates: Gate[],
+  pairs: Array<[number, number]>,
+): { gates: Gate[]; wires: string[] } {
+  const broken = gates.map((gate) => ({ ...gate }));
+  const wires: string[] = [];
+  for (const [a, b] of pairs) {
+    wires.push(broken[a].out, broken[b].out);
+    const tmp = broken[a].out;
+    broken[a].out = broken[b].out;
+    broken[b].out = tmp;
+  }
+  return { gates: broken, wires: wires.sort() };
+}
diff --git a/tests/helpers/brokenAdder.ts b/tests/helpers/brokenAdder.ts
new file mode 100644
index 0000000..0bc90d0
--- /dev/null
+++ b/tests/helpers/brokenAdder.ts
@@ -0,0 +1,72 @@
+import { simulate } from '../../src/index.js';
+import type { Gate } from '../../src/types.js';
+import { addBits, applySwaps, buildAdder, inputsFor, label, makeRandom, randomBits } from './adderFixture.js';
+
+/** True when every gate settled (no cycle) and the circuit computes x + y. */
+export function addsCorrectly(gates: Gate[], bits: number, random: () => number): boolean {
+  const trials: Array<[number[], number[]]> = [
+    [new Array(bits).fill(1), new Array(bits).fill(1)],
+    [new Array(bits).fill(0), new Array(bits).fill(0)],
+    [new Array(bits).fill(1), [1, ...new Array(Math.max(0, bits - 1)).fill(0)]],
+  ];
+  for (let i = 0; i < 12; i++) trials.push([randomBits(bits, random), randomBits(bits, random)]);
+
+  for (const [x, y] of trials) {
+    const values = simulate(gates, inputsFor(x, y, bits));
+    for (const gate of gates) {
+      if (values[gate.out] === undefined) return false; // cycle: never settled
+    }
+    const expected = addBits(x, y, bits);
+    for (let bit = 0; bit <= bits; bit++) {
+      if (values[`z${label(bit)}`] !== expected[bit]) return false;
+    }
+  }
+  return true;
+}
+
+export interface BrokenAdder {
+  gates: Gate[];
+  /** Sorted names of the eight wires that were swapped. */
+  wires: string[];
+  bits: number;
+}
+
+/**
+ * Build a `bits`-wide adder with four disjoint output-wire swaps that leave the
+ * circuit acyclic but broken.
+ */
+export function makeBrokenAdder(bits: number, seed: number): BrokenAdder {
+  const random = makeRandom(seed);
+  const correct = buildAdder(bits, random);
+  if (correct.length < 8) throw new Error(`a ${bits}-bit adder has too few gates to swap 4 pairs`);
+  for (let attempt = 0; attempt < 500; attempt++) {
+    const picks: number[] = [];
+    const seen = new Set<number>();
+    while (picks.length < 8) {
+      const index = Math.floor(random() * correct.length);
+      if (seen.has(index)) continue;
+      seen.add(index);
+      picks.push(index);
+    }
+    const pairs: Array<[number, number]> = [
+      [picks[0], picks[1]],
+      [picks[2], picks[3]],
+      [picks[4], picks[5]],
+      [picks[6], picks[7]],
+    ];
+    // Every pair on its own must break the adder, otherwise it is undetectable
+    // (swapping the two carry terms feeding one OR changes nothing) and no
+    // solver could be expected to report it.
+    const detectable = pairs.every(
+      (pair) => !addsCorrectly(applySwaps(correct, [pair]).gates, bits, makeRandom(seed + 11)),
+    );
+    if (!detectable) continue;
+
+    const { gates, wires } = applySwaps(correct, pairs);
+    if (addsCorrectly(gates, bits, makeRandom(seed + 7))) continue; // faults cancelled out
+    const values = simulate(gates, inputsFor(randomBits(bits, random), randomBits(bits, random), bits));
+    if (gates.some((gate) => values[gate.out] === undefined)) continue; // cycle
+    return { gates, wires, bits };
+  }
+  throw new Error(`could not build a broken ${bits}-bit adder for seed ${seed}`);
+}
