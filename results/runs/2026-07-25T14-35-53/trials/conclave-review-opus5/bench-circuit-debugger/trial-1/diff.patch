diff --git a/src/reconstruct.ts b/src/reconstruct.ts
new file mode 100644
index 0000000..9e8ff5a
--- /dev/null
+++ b/src/reconstruct.ts
@@ -0,0 +1,354 @@
+import { X_WIRE, Y_WIRE } from './circuit.js';
+import type { Gate, GateOp } from './types.js';
+
+/** Upper bound on the number of swapped pairs, as stated by the problem. */
+const MAX_PAIRS = 4;
+
+/**
+ * Backstop against pathological backtracking on circuits that are not adders.
+ * The caller's deadline is the real bound; this just keeps a coarse clock from
+ * letting the walk run away.
+ */
+const NODE_BUDGET = 200_000;
+const VERIFY_BUDGET = 40;
+
+/** How often to consult the clock while backtracking. */
+const CLOCK_INTERVAL = 16;
+
+function isInputWire(name: string): boolean {
+  return X_WIRE.test(name) || Y_WIRE.test(name);
+}
+
+function bitName(prefix: string, bit: number): string {
+  return `${prefix}${String(bit).padStart(2, '0')}`;
+}
+
+/** Order-independent identity of a gate: its operation plus its input pair. */
+function gateKey(op: GateOp, in1: string, in2: string): string {
+  return in1 < in2 ? `${op}|${in1}|${in2}` : `${op}|${in2}|${in1}`;
+}
+
+/**
+ * A XOR/AND gate pair sharing the same two internal inputs: one bit's sum and
+ * carry-propagate gates. Their two common inputs are that bit's partial sum and
+ * its incoming carry, in unknown order.
+ */
+interface SumPair {
+  first: string;
+  second: string;
+  /** Gate that should emit `zNN`. */
+  sum: number;
+  /** Gate that should emit the carry-propagate term. */
+  propagate: number;
+}
+
+/** Mutable half of the walk: which gate emits which wire, and the swaps so far. */
+interface Wiring {
+  out: string[];
+  producer: Map<string, number>;
+  pairs: Array<[string, string]>;
+  /** Gates whose output wire has been pinned down. */
+  settled: Uint8Array;
+  /** Sum/propagate pairs already claimed by a lower bit. */
+  claimed: Set<SumPair>;
+}
+
+export interface Reconstruction {
+  /** Wire-name pairs that were exchanged. */
+  pairs: Array<[string, string]>;
+  /** The circuit with those exchanges undone. */
+  gates: Gate[];
+}
+
+/**
+ * Recover the intended output wire of every gate, and hence the swaps.
+ *
+ * Swapping output wires never touches any gate's *inputs*, so a gate's identity
+ * — its operation plus its pair of input wires — survives the damage intact.
+ * That is enough to rebuild the adder bit by bit. Each bit is a group of five
+ * gates with fixed expectations: the sum gate emits `zNN`, the partial sum comes
+ * from `xNN XOR yNN`, the carry-in comes from the previous bit's carry gate, and
+ * the two carry terms meet at one OR gate. Every violated expectation names both
+ * the wire that belongs there and the wire sitting in its place — that is one
+ * swap, and undoing it lets the walk continue.
+ *
+ * Which gates form bit `i` is itself deduced from three independent clues (the
+ * carry-in wire, the partial-sum wire and the `zNN` wire). A swap can corrupt a
+ * clue, so when they disagree each reading is tried in turn and contradictions
+ * further up the walk prune the wrong ones. `accept` decides whether a completed
+ * walk really produced an adder.
+ *
+ * Returns null if the circuit is not shaped like an adder, if the damage cannot
+ * be unpicked this way, or if `deadline` (a `Date.now()` value) passes first;
+ * the caller then falls back to searching.
+ */
+export function reconstruct(
+  input: Gate[],
+  bits: number,
+  accept: (gates: Gate[]) => boolean,
+  deadline: number,
+): Reconstruction | null {
+  if (bits < 1 || input.length === 0) return null;
+
+  // Invariant structure: operations and inputs are never touched by a swap.
+  const op = input.map((gate) => gate.op);
+  const in1 = input.map((gate) => gate.in1);
+  const in2 = input.map((gate) => gate.in2);
+  const byKey = new Map<string, number>();
+  const consumers = new Map<string, number[]>();
+  for (let i = 0; i < input.length; i++) {
+    byKey.set(gateKey(op[i], in1[i], in2[i]), i);
+    for (const wire of [in1[i], in2[i]]) {
+      const list = consumers.get(wire);
+      if (list === undefined) consumers.set(wire, [i]);
+      else if (!list.includes(i)) list.push(i);
+    }
+  }
+
+  // The two gates reading each pair of input bits.
+  const halfXor: number[] = [];
+  const halfAnd: number[] = [];
+  for (let bit = 0; bit < bits; bit++) {
+    const xor = byKey.get(gateKey('XOR', bitName('x', bit), bitName('y', bit)));
+    const and = byKey.get(gateKey('AND', bitName('x', bit), bitName('y', bit)));
+    if (xor === undefined || and === undefined) return null;
+    halfXor.push(xor);
+    halfAnd.push(and);
+  }
+
+  // The XOR/AND gate pairs that share internal inputs: one per bit above zero.
+  const sumPairs: SumPair[] = [];
+  const pairByWire = new Map<string, SumPair>();
+  for (let i = 0; i < input.length; i++) {
+    if (op[i] !== 'XOR' || isInputWire(in1[i]) || isInputWire(in2[i])) continue;
+    const propagate = byKey.get(gateKey('AND', in1[i], in2[i]));
+    if (propagate === undefined) continue;
+    const pair: SumPair = { first: in1[i], second: in2[i], sum: i, propagate };
+    sumPairs.push(pair);
+    pairByWire.set(in1[i], pair);
+    pairByWire.set(in2[i], pair);
+  }
+
+  let nodes = NODE_BUDGET;
+  let verifications = VERIFY_BUDGET;
+  let wanted: number | null = null;
+
+  /**
+   * False once the search has spent its allowance, of work or of time. Counted
+   * per candidate wiring considered, which is the unit of real cost here — each
+   * one copies the whole wiring.
+   */
+  const withinBudget = (): boolean => {
+    if (nodes-- <= 0) return false;
+    return nodes % CLOCK_INTERVAL !== 0 || Date.now() <= deadline;
+  };
+
+  const clone = (wiring: Wiring): Wiring => ({
+    out: wiring.out.slice(),
+    producer: new Map(wiring.producer),
+    pairs: wiring.pairs.map((pair): [string, string] => [pair[0], pair[1]]),
+    settled: wiring.settled.slice(),
+    claimed: new Set(wiring.claimed),
+  });
+
+  /**
+   * Make `gate` emit `wire`, exchanging with whichever gate holds it. Both gates
+   * end up settled: a swap has exactly two sides, so the wire displaced from
+   * `gate` is the one the other gate was supposed to emit all along.
+   */
+  const ensureOut = (wiring: Wiring, gate: number, wire: string): boolean => {
+    const current = wiring.out[gate];
+    if (current === wire) {
+      wiring.settled[gate] = 1;
+      return true;
+    }
+    const holder = wiring.producer.get(wire);
+    if (holder === undefined || holder === gate) return false;
+    if (wiring.settled[gate] === 1 || wiring.settled[holder] === 1) return false;
+    if (wiring.pairs.length === MAX_PAIRS) return false;
+    wiring.out[gate] = wire;
+    wiring.out[holder] = current;
+    wiring.producer.set(wire, gate);
+    wiring.producer.set(current, holder);
+    wiring.pairs.push([current, wire]);
+    wiring.settled[gate] = 1;
+    wiring.settled[holder] = 1;
+    return true;
+  };
+
+  /** The single OR gate reading `wire`, if there is exactly one. */
+  const orConsumerOf = (wire: string): number | undefined => {
+    const found = (consumers.get(wire) ?? []).filter((gate) => op[gate] === 'OR');
+    return found.length === 1 ? found[0] : undefined;
+  };
+
+  const orGates: number[] = [];
+  for (let i = 0; i < input.length; i++) {
+    if (op[i] === 'OR') orGates.push(i);
+  }
+
+  /** OR gates, those still emitting into an unclaimed sum pair first. */
+  const orderedOrGates = (wiring: Wiring): number[] => {
+    const plausible: number[] = [];
+    const rest: number[] = [];
+    for (const gate of orGates) {
+      const target = pairByWire.get(wiring.out[gate]);
+      if (target !== undefined && !wiring.claimed.has(target)) plausible.push(gate);
+      else rest.push(gate);
+    }
+    return [...plausible, ...rest];
+  };
+
+  /** Sum/propagate pairs that could be bit `bit`, most strongly indicated first. */
+  const candidatesFor = (wiring: Wiring, bit: number, carryGate: number): SumPair[] => {
+    const carryWire = wiring.out[carryGate];
+    const partialWire = wiring.out[halfXor[bit]];
+    const zWire = bitName('z', bit);
+    const scored: Array<{ pair: SumPair; score: number }> = [];
+    for (const pair of sumPairs) {
+      if (wiring.claimed.has(pair)) continue;
+      let score = 0;
+      if (pair.first === carryWire || pair.second === carryWire) score++;
+      if (pair.first === partialWire || pair.second === partialWire) score++;
+      if (wiring.out[pair.sum] === zWire) score++;
+      scored.push({ pair, score });
+    }
+    // Best-supported first. Unsupported pairs stay in the running — all three
+    // clues can be damaged at one bit — but only get tried once the plausible
+    // ones have been ruled out.
+    return scored.sort((a, b) => b.score - a.score).map((entry) => entry.pair);
+  };
+
+  /**
+   * Which of the pair's two wires is the partial sum and which is the carry-in.
+   * When neither wire is where it belongs both readings are viable, so both are
+   * offered; they report the same set of swapped wires but move different wires
+   * elsewhere in the circuit.
+   */
+  const splitsOf = (wiring: Wiring, bit: number, carryGate: number, pair: SumPair): string[] => {
+    const partialWire = wiring.out[halfXor[bit]];
+    const carryWire = wiring.out[carryGate];
+    if (partialWire === pair.first || partialWire === pair.second) return [partialWire];
+    if (carryWire === pair.first) return [pair.second];
+    if (carryWire === pair.second) return [pair.first];
+    return [pair.first, pair.second];
+  };
+
+  /** A way of settling one bit: the resulting wiring and its carry-out gate. */
+  interface Step {
+    wiring: Wiring;
+    carryGate: number;
+  }
+
+  /**
+   * Every way of pinning down bit `bit` given that its gates are `pair`, best
+   * first. Lazy: the last resort below enumerates every OR gate, and building
+   * those wirings is far too expensive to do unless they are actually needed.
+   */
+  const settleBit = function* (
+    base: Wiring,
+    bit: number,
+    carryGate: number,
+    pair: SumPair,
+  ): Generator<Step> {
+    for (const partial of splitsOf(base, bit, carryGate, pair)) {
+      if (!withinBudget()) return;
+      const carry = partial === pair.first ? pair.second : pair.first;
+      const wiring = clone(base);
+      if (!ensureOut(wiring, halfXor[bit], partial)) continue;
+      if (!ensureOut(wiring, carryGate, carry)) continue;
+      if (!ensureOut(wiring, pair.sum, bitName('z', bit))) continue;
+      wiring.claimed.add(pair);
+
+      // This bit's generate and propagate terms must meet at a single OR gate.
+      const generate = wiring.out[halfAnd[bit]];
+      const propagate = wiring.out[pair.propagate];
+      const direct = byKey.get(gateKey('OR', generate, propagate));
+      if (direct !== undefined) {
+        wiring.settled[halfAnd[bit]] = 1;
+        wiring.settled[pair.propagate] = 1;
+        yield { wiring, carryGate: direct };
+        continue;
+      }
+      // They do not, so at least one of the two terms is misplaced. Either the
+      // OR gate reading the generate term is this bit's carry gate and the
+      // propagate term is wrong, or the other way round.
+      const viaGenerate = orConsumerOf(generate);
+      if (viaGenerate !== undefined) {
+        const fixed = clone(wiring);
+        const other = in1[viaGenerate] === generate ? in2[viaGenerate] : in1[viaGenerate];
+        if (ensureOut(fixed, pair.propagate, other)) {
+          fixed.settled[halfAnd[bit]] = 1;
+          yield { wiring: fixed, carryGate: viaGenerate };
+        }
+      }
+      const viaPropagate = orConsumerOf(propagate);
+      if (viaPropagate !== undefined) {
+        const fixed = clone(wiring);
+        const other = in1[viaPropagate] === propagate ? in2[viaPropagate] : in1[viaPropagate];
+        if (ensureOut(fixed, halfAnd[bit], other)) {
+          fixed.settled[pair.propagate] = 1;
+          yield { wiring: fixed, carryGate: viaPropagate };
+        }
+      }
+      // Or *both* terms are misplaced, in which case neither points at the
+      // carry gate and every OR gate is a candidate for it. Carries feed the
+      // next bit's sum pair, so ones whose output lands in an unclaimed pair
+      // come first.
+      for (const candidate of orderedOrGates(wiring)) {
+        for (const [first, second] of [
+          [in1[candidate], in2[candidate]],
+          [in2[candidate], in1[candidate]],
+        ]) {
+          if (!withinBudget()) return;
+          const fixed = clone(wiring);
+          if (!ensureOut(fixed, halfAnd[bit], first)) continue;
+          if (!ensureOut(fixed, pair.propagate, second)) continue;
+          yield { wiring: fixed, carryGate: candidate };
+        }
+      }
+    }
+  };
+
+  const materialize = (wiring: Wiring): Gate[] =>
+    input.map((_, i) => ({ op: op[i], in1: in1[i], in2: in2[i], out: wiring.out[i] }));
+
+  const walk = (wiring: Wiring, bit: number, carryGate: number): Wiring | null => {
+    if (bit === bits) {
+      // The last carry is the most significant output bit.
+      const finished = clone(wiring);
+      if (!ensureOut(finished, carryGate, bitName('z', bits))) return null;
+      if (wanted !== null && finished.pairs.length !== wanted) return null;
+      if (verifications-- <= 0) return null;
+      return accept(materialize(finished)) ? finished : null;
+    }
+    for (const pair of candidatesFor(wiring, bit, carryGate)) {
+      for (const step of settleBit(wiring, bit, carryGate, pair)) {
+        const done = walk(step.wiring, bit + 1, step.carryGate);
+        if (done !== null) return done;
+      }
+    }
+    return null;
+  };
+
+  const attempt = (pairCount: number | null): Reconstruction | null => {
+    nodes = NODE_BUDGET;
+    verifications = VERIFY_BUDGET;
+    wanted = pairCount;
+    const start: Wiring = {
+      out: input.map((gate) => gate.out),
+      producer: new Map(input.map((gate, i) => [gate.out, i])),
+      pairs: [],
+      settled: new Uint8Array(input.length),
+      claimed: new Set(),
+    };
+    if (!ensureOut(start, halfXor[0], bitName('z', 0))) return null;
+    const solved = walk(start, 1, halfAnd[0]);
+    return solved === null ? null : { pairs: solved.pairs, gates: materialize(solved) };
+  };
+
+  // Prefer a repair with the stated number of swaps. Dense damage in a narrow
+  // adder can leave a shorter repair that also adds correctly, but the four-swap
+  // one is the damage that was actually done.
+  return attempt(MAX_PAIRS) ?? attempt(null);
+}
