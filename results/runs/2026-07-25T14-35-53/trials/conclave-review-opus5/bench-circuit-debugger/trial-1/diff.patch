new file mode 100644
index 0000000..06ed3e7
--- /dev/null
+++ b/src/simulate.ts
@@ -0,0 +1,104 @@
+import type { Gate, GateOp } from './types.js';
+
+function apply(op: GateOp, a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+    default: {
+      const bad: never = op;
+      throw new Error(`Unknown gate operation: ${String(bad)}`);
+    }
+  }
+}
+
+/**
+ * Evaluate a combinational circuit.
+ *
+ * Wires listed in `inputs` seed the simulation. Gates fire once both of their
+ * input wires hold a value, in dependency order, so gates may be supplied in any
+ * order. Where a wire is both seeded and driven by a gate the gate wins; the
+ * seed is only used as a fallback if the circuit never settles that wire, which
+ * can then unblock whatever was waiting downstream.
+ *
+ * Returns the settled value of every wire that could be resolved. Wires that can
+ * never resolve (missing inputs) are omitted. A wire driven by two gates is
+ * malformed input; the first gate to settle it wins, so the result stays
+ * self-consistent.
+ */
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const seeds = new Map<string, number>();
+  for (const [wire, value] of Object.entries(inputs)) seeds.set(wire, value ? 1 : 0);
+
+  const driven = new Set<string>();
+  for (const gate of gates) driven.add(gate.out);
+
+  const values = new Map<string, number>();
+  for (const [wire, value] of seeds) {
+    if (!driven.has(wire)) values.set(wire, value);
+  }
+
+  // Gates waiting on each unresolved wire. A gate appears twice when both of its
+  // inputs are the same wire, so the pending counter stays balanced.
+  const waiting = new Map<string, number[]>();
+  const pending = new Int32Array(gates.length);
+  const ready: number[] = [];
+
+  const addWaiter = (wire: string, gateIndex: number): void => {
+    const list = waiting.get(wire);
+    if (list === undefined) waiting.set(wire, [gateIndex]);
+    else list.push(gateIndex);
+  };
+
+  for (let i = 0; i < gates.length; i++) {
+    const gate = gates[i];
+    let awaited = 0;
+    if (!values.has(gate.in1)) {
+      awaited++;
+      addWaiter(gate.in1, i);
+    }
+    if (!values.has(gate.in2)) {
+      awaited++;
+      addWaiter(gate.in2, i);
+    }
+    pending[i] = awaited;
+    if (awaited === 0) ready.push(i);
+  }
+
+  /** Let go of the gates waiting on a wire that has just settled. */
+  const release = (wire: string): void => {
+    const waiters = waiting.get(wire);
+    if (waiters === undefined) return;
+    for (const waiter of waiters) {
+      if (--pending[waiter] === 0) ready.push(waiter);
+    }
+  };
+
+  const settle = (): void => {
+    while (ready.length > 0) {
+      const gate = gates[ready.pop() as number];
+      const a = values.get(gate.in1);
+      const b = values.get(gate.in2);
+      // A gate is only made ready once both of its inputs hold values.
+      if (a === undefined || b === undefined) continue;
+      if (values.has(gate.out)) continue; // already driven; keep the first value
+      values.set(gate.out, apply(gate.op, a, b));
+      release(gate.out);
+    }
+  };
+
+  settle();
+  for (const [wire, value] of seeds) {
+    if (values.has(wire)) continue;
+    values.set(wire, value);
+    release(wire);
+    settle();
+  }
+
+  const result: Record<string, number> = {};
+  for (const [wire, value] of values) result[wire] = value;
+  return result;
+}
