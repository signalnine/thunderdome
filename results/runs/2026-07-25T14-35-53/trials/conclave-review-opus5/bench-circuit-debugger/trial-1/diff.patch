+import { describe, expect, it } from 'vitest';
+import { simulate } from '../src/index.js';
+import type { Gate } from '../src/types.js';
+import { addBits, buildAdder, inputsFor, label, makeRandom, randomBits } from './helpers/adderFixture.js';
+
+describe('simulate', () => {
+  it('applies each operation', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'and' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'or' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'xor' },
+    ];
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, and: 1, or: 1, xor: 0 });
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, and: 0, or: 1, xor: 1 });
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, and: 0, or: 0, xor: 0 });
+  });
+
+  it('resolves gates in dependency order regardless of listing order', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'd', in2: 'e', out: 'f' },
+      { op: 'OR', in1: 'c', in2: 'x', out: 'e' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'c' },
+      { op: 'XOR', in1: 'c', in2: 'x', out: 'd' },
+    ];
+    const values = simulate(gates, { a: 1, b: 0, x: 0 });
+    expect(values).toEqual({ a: 1, b: 0, x: 0, c: 1, d: 1, e: 1, f: 1 });
+  });
+
+  it('handles a gate whose two inputs are the same wire', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'c' },
+      { op: 'AND', in1: 'c', in2: 'c', out: 'd' },
+    ];
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, c: 1, d: 1 });
+  });
+
+  it('treats non-zero seed values as 1 and keeps unused seeds', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1, spare: 0 })).toEqual({ a: 1, b: 1, spare: 0, c: 1 });
+  });
+
+  it('falls back to a seeded value when the gate driving that wire cannot fire', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'nope1', in2: 'nope2', out: 'c' },
+      { op: 'XOR', in1: 'c', in2: 'a', out: 'd' },
+      { op: 'OR', in1: 'd', in2: 'a', out: 'e' },
+    ];
+    // `c` never settles on its own, so the seed stands in and unblocks d and e.
+    expect(simulate(gates, { a: 1, c: 1 })).toEqual({ a: 1, c: 1, d: 0, e: 1 });
+  });
+
+  it('keeps the first value when two gates drive one wire', () => {
+    const gates: Gate[] = [
+      { op: 'OR', in1: 'a', in2: 'b', out: 'c' },
+      { op: 'AND', in1: 'a', in2: 'b', out: 'c' },
+      { op: 'XOR', in1: 'c', in2: 'zero', out: 'd' },
+    ];
+    const values = simulate(gates, { a: 1, b: 0, zero: 0 });
+    // Malformed input, but the result must at least agree with itself: d = c XOR 0.
+    expect(values.d).toBe(values.c);
+  });
+
+  it('omits wires that can never resolve', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'missing', out: 'c' },
+      { op: 'OR', in1: 'a', in2: 'a', out: 'd' },
+    ];
+    const values = simulate(gates, { a: 1 });
+    expect(values).toEqual({ a: 1, d: 1 });
+  });
+
+  it('returns an empty result for an empty circuit', () => {
+    expect(simulate([], {})).toEqual({});
+  });
+
+  it('lets a gate override a seeded value for its own output wire', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'c' },
+      { op: 'XOR', in1: 'c', in2: 'a', out: 'd' },
+    ];
+    const values = simulate(gates, { a: 1, b: 0, c: 1 });
+    expect(values).toEqual({ a: 1, b: 0, c: 0, d: 1 });
+  });
+
+  it('adds correctly across the documented 4-bit adder', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+      { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },
+      { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },
+      { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },
+      { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },
+      { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },
+      { op: 'XOR', in1: 'x02', in2: 'y02', out: 't02' },
+      { op: 'XOR', in1: 't02', in2: 'c01', out: 'z02' },
+      { op: 'AND', in1: 'x02', in2: 'y02', out: 'a02' },
+      { op: 'AND', in1: 't02', in2: 'c01', out: 'b02' },
+      { op: 'OR', in1: 'a02', in2: 'b02', out: 'c02' },
+      { op: 'XOR', in1: 'x03', in2: 'y03', out: 't03' },
+      { op: 'XOR', in1: 't03', in2: 'c02', out: 'z03' },
+      { op: 'AND', in1: 'x03', in2: 'y03', out: 'a03' },
+      { op: 'AND', in1: 't03', in2: 'c02', out: 'b03' },
+      { op: 'OR', in1: 'a03', in2: 'b03', out: 'z04' },
+    ];
+    for (let x = 0; x < 16; x++) {
+      for (let y = 0; y < 16; y++) {
+        const inputs: Record<string, number> = {};
+        for (let bit = 0; bit < 4; bit++) {
+          inputs[`x${label(bit)}`] = (x >> bit) & 1;
+          inputs[`y${label(bit)}`] = (y >> bit) & 1;
+        }
+        const values = simulate(gates, inputs);
+        let sum = 0;
+        for (let bit = 4; bit >= 0; bit--) sum = sum * 2 + values[`z${label(bit)}`];
+        expect(sum).toBe(x + y);
+      }
+    }
+  });
+
+  it('adds correctly across a wide generated adder', () => {
+    const bits = 45;
+    const random = makeRandom(99);
+    const gates = buildAdder(bits, random);
+    for (let trial = 0; trial < 25; trial++) {
+      const x = randomBits(bits, random);
+      const y = randomBits(bits, random);
+      const values = simulate(gates, inputsFor(x, y, bits));
+      const expected = addBits(x, y, bits);
+      for (let bit = 0; bit <= bits; bit++) {
+        expect(values[`z${label(bit)}`]).toBe(expected[bit]);
+      }
+    }
+  });
+});
