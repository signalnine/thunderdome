diff --git a/src/adder.ts b/src/adder.ts
new file mode 100644
index 0000000..833885f
--- /dev/null
+++ b/src/adder.ts
@@ -0,0 +1,164 @@
+import { evaluate, type Circuit } from './circuit.js';
+
+/** One input pattern plus the expected sum bits. */
+export interface TestVector {
+  x: Uint8Array;
+  y: Uint8Array;
+  /** Expected z bits, least significant first, length `bits + 1`. */
+  z: Uint8Array;
+}
+
+/** Test patterns grouped by the bit position they are designed to exercise. */
+export interface TestSuite {
+  bits: number;
+  /** `perBit[i]` isolates bit `i` under both carry-in polarities. */
+  perBit: TestVector[][];
+  /** Extra whole-word patterns that stress carry chains end to end. */
+  extra: TestVector[];
+  /**
+   * Sentinel returned by {@link lowestFailingBit} when every test passes: one
+   * past the most significant output bit, so it compares greater than any real
+   * failure position.
+   */
+  clean: number;
+}
+
+function expectedSum(x: Uint8Array, y: Uint8Array, bits: number): Uint8Array {
+  const z = new Uint8Array(bits + 1);
+  let carry = 0;
+  for (let bit = 0; bit < bits; bit++) {
+    const sum = x[bit] + y[bit] + carry;
+    z[bit] = sum & 1;
+    carry = sum >> 1;
+  }
+  z[bits] = carry;
+  return z;
+}
+
+function vector(x: Uint8Array, y: Uint8Array, bits: number): TestVector {
+  return { x, y, z: expectedSum(x, y, bits) };
+}
+
+/**
+ * Build the verification suite for a `bits`-wide adder.
+ *
+ * For every bit position we test all four (x, y) combinations with carry-in 0
+ * and carry-in 1 (carry-in is forced by filling the lower bits of x and setting
+ * y's bit 0). Any single-position fault therefore shows up in that position's
+ * group, which lets the search cheaply re-check just the bit it is repairing.
+ */
+export function buildTestSuite(bits: number): TestSuite {
+  const perBit: TestVector[][] = [];
+  for (let bit = 0; bit < bits; bit++) {
+    const group: TestVector[] = [];
+    const carries = bit === 0 ? [0] : [0, 1];
+    for (const carry of carries) {
+      for (let combo = 0; combo < 4; combo++) {
+        const x = new Uint8Array(bits);
+        const y = new Uint8Array(bits);
+        if (carry === 1) {
+          for (let lower = 0; lower < bit; lower++) x[lower] = 1;
+          y[0] = 1;
+        }
+        x[bit] = combo & 1;
+        y[bit] = (combo >> 1) & 1;
+        group.push(vector(x, y, bits));
+      }
+    }
+    perBit.push(group);
+  }
+
+  const extra: TestVector[] = [];
+  const ones = new Uint8Array(bits).fill(1);
+  const zeros = new Uint8Array(bits);
+  const one = new Uint8Array(bits);
+  if (bits > 0) one[0] = 1;
+  const evens = new Uint8Array(bits);
+  const odds = new Uint8Array(bits);
+  for (let bit = 0; bit < bits; bit++) {
+    if (bit % 2 === 0) evens[bit] = 1;
+    else odds[bit] = 1;
+  }
+  extra.push(vector(ones, ones, bits));
+  extra.push(vector(ones, one, bits));
+  extra.push(vector(ones, zeros, bits));
+  extra.push(vector(evens, odds, bits));
+  extra.push(vector(evens, evens, bits));
+  extra.push(vector(odds, odds, bits));
+
+  // Deterministic pseudo-random patterns: cheap insurance against faults that
+  // only surface for particular bit combinations.
+  let seed = 0x2f6e2b1;
+  const nextBit = (): number => {
+    // Math.imul keeps the multiply in 32-bit range; plain `*` would overflow
+    // the float mantissa and degenerate the sequence.
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return (seed >>> 17) & 1;
+  };
+  for (let trial = 0; trial < 40; trial++) {
+    const x = new Uint8Array(bits);
+    const y = new Uint8Array(bits);
+    for (let bit = 0; bit < bits; bit++) {
+      x[bit] = nextBit();
+      y[bit] = nextBit();
+    }
+    extra.push(vector(x, y, bits));
+  }
+
+  return { bits, perBit, extra, clean: bits + 1 };
+}
+
+/** Lowest z index that disagrees with the expected sum, or -1 if the vector passes. */
+function mismatch(circuit: Circuit, test: TestVector, scratch: Uint8Array): number {
+  evaluate(circuit, test.x, test.y, scratch);
+  for (let bit = 0; bit <= circuit.bits; bit++) {
+    if (scratch[bit] !== test.z[bit]) return bit;
+  }
+  return -1;
+}
+
+/**
+ * True when the patterns targeting `bit` produce correct output up to and
+ * including `bit`.
+ *
+ * Deliberately tolerant of mismatches *above* `bit`: during a repair search the
+ * higher bits are still expected to be broken, so demanding the whole word be
+ * correct would reject every partial fix.
+ */
+export function bitSettled(
+  circuit: Circuit,
+  suite: TestSuite,
+  bit: number,
+  scratch: Uint8Array,
+): boolean {
+  if (bit >= suite.perBit.length) return false;
+  for (const test of suite.perBit[bit]) {
+    const bad = mismatch(circuit, test, scratch);
+    if (bad !== -1 && bad <= bit) return false;
+  }
+  return true;
+}
+
+/**
+ * Lowest output bit position where the circuit disagrees with X + Y over the
+ * whole suite, or `suite.clean` when the circuit adds correctly.
+ */
+export function lowestFailingBit(circuit: Circuit, suite: TestSuite, scratch: Uint8Array): number {
+  let lowest = suite.clean;
+  for (const group of suite.perBit) {
+    for (const test of group) {
+      const bad = mismatch(circuit, test, scratch);
+      if (bad !== -1 && bad < lowest) lowest = bad;
+    }
+  }
+  for (const test of suite.extra) {
+    const bad = mismatch(circuit, test, scratch);
+    if (bad !== -1 && bad < lowest) lowest = bad;
+  }
+  return lowest;
+}
+
+/** True when the circuit adds correctly across the whole suite. */
+export function isCorrectAdder(circuit: Circuit, suite: TestSuite, scratch: Uint8Array): boolean {
+  return lowestFailingBit(circuit, suite, scratch) === suite.clean;
+}
