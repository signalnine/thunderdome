new file mode 100644
index 0000000..7095426
--- /dev/null
+++ b/tests/findSwappedWires.test.ts
@@ -0,0 +1,177 @@
+import { describe, expect, it } from 'vitest';
+import { findSwappedWires } from '../src/index.js';
+import type { Gate } from '../src/types.js';
+import { applySwaps, buildAdder, makeRandom } from './helpers/adderFixture.js';
+import { addsCorrectly, makeBrokenAdder } from './helpers/brokenAdder.js';
+
+/** Repair `gates` by swapping the reported wires back and confirm it adds. */
+function repairs(gates: Gate[], wires: string[], bits: number): boolean {
+  if (wires.length % 2 !== 0) return false;
+  const byWire = new Map<string, Gate>();
+  const repaired = gates.map((gate) => ({ ...gate }));
+  for (const gate of repaired) byWire.set(gate.out, gate);
+  const pool = [...wires];
+  const search = (): boolean => {
+    if (pool.length === 0) return addsCorrectly(repaired, bits, makeRandom(4242));
+    const first = pool.shift() as string;
+    for (let i = 0; i < pool.length; i++) {
+      const second = pool[i];
+      pool.splice(i, 1);
+      const left = byWire.get(first);
+      const right = byWire.get(second);
+      if (left !== undefined && right !== undefined) {
+        left.out = second;
+        right.out = first;
+        byWire.set(first, right);
+        byWire.set(second, left);
+        if (search()) return true;
+        left.out = first;
+        right.out = second;
+        byWire.set(first, left);
+        byWire.set(second, right);
+      }
+      pool.splice(i, 0, second);
+    }
+    pool.unshift(first);
+    return false;
+  };
+  return search();
+}
+
+describe('findSwappedWires', () => {
+  it('finds a swap that crosses a sum bit and a carry term', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+      { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },
+      { op: 'XOR', in1: 't01', in2: 'c00', out: 'a01' }, // swapped with a01
+      { op: 'AND', in1: 'x01', in2: 'y01', out: 'z01' }, // swapped with z01
+      { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },
+      { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },
+      { op: 'XOR', in1: 'x02', in2: 'y02', out: 't02' },
+      { op: 'XOR', in1: 't02', in2: 'c01', out: 'z02' },
+      { op: 'AND', in1: 'x02', in2: 'y02', out: 'b02' }, // swapped with b02
+      { op: 'AND', in1: 't02', in2: 'c01', out: 'a02' }, // swapped with a02
+      { op: 'OR', in1: 'a02', in2: 'b02', out: 'c02' },
+      { op: 'XOR', in1: 'x03', in2: 'y03', out: 't03' },
+      { op: 'XOR', in1: 't03', in2: 'c02', out: 'b03' }, // swapped with b03
+      { op: 'AND', in1: 'x03', in2: 'y03', out: 'a03' },
+      { op: 'AND', in1: 't03', in2: 'c02', out: 'z03' }, // swapped with z03
+      { op: 'OR', in1: 'a03', in2: 'b03', out: 'c03' },
+      { op: 'XOR', in1: 'x04', in2: 'y04', out: 't04' },
+      { op: 'XOR', in1: 't04', in2: 'c03', out: 'z04' },
+      { op: 'AND', in1: 'x04', in2: 'y04', out: 'a04' },
+      { op: 'AND', in1: 't04', in2: 'c03', out: 'b04' },
+      { op: 'OR', in1: 'a04', in2: 'b04', out: 'z05' },
+    ];
+    // a02/b02 feed the same OR, so that swap is invisible; the remaining three
+    // are real faults and must be reported.
+    const found = findSwappedWires(gates);
+    expect(found).toContain('z01');
+    expect(found).toContain('a01');
+    expect(found).toContain('z03');
+    expect(found).toContain('b03');
+    expect(repairs(gates, found, 5)).toBe(true);
+  });
+
+  it('returns an empty array for a correct adder', () => {
+    const gates = buildAdder(8, makeRandom(5));
+    expect(findSwappedWires(gates)).toEqual([]);
+  });
+
+  it('returns an empty array for an empty circuit', () => {
+    expect(findSwappedWires([])).toEqual([]);
+  });
+
+  it('handles a one-bit adder, whose top bit is an AND rather than an OR', () => {
+    const correct: Gate[] = [
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'z01' },
+    ];
+    expect(findSwappedWires(correct)).toEqual([]);
+    const swapped: Gate[] = [
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z01' },
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' },
+    ];
+    expect(findSwappedWires(swapped)).toEqual(['z00', 'z01']);
+  });
+
+  it.each([4, 5, 6, 8, 12, 20, 32, 45])('recovers four swaps in a %i-bit adder', (bits) => {
+    for (let seed = 1; seed <= 6; seed++) {
+      const broken = makeBrokenAdder(bits, seed * 1000 + bits);
+      const found = findSwappedWires(broken.gates);
+      expect(found, `bits=${bits} seed=${seed}`).toEqual(broken.wires);
+    }
+  });
+
+  it('always returns a set of wires that repairs the circuit', () => {
+    const bits = 45;
+    for (let seed = 1; seed <= 5; seed++) {
+      const broken = makeBrokenAdder(bits, seed * 31 + 3);
+      const found = findSwappedWires(broken.gates);
+      expect(found.length).toBe(8);
+      expect([...found].sort()).toEqual(found);
+      expect(repairs(broken.gates, found, bits), `seed=${seed}`).toBe(true);
+    }
+  });
+
+  it('handles a 45-bit circuit in well under five seconds', () => {
+    const broken = makeBrokenAdder(45, 777);
+    const started = Date.now();
+    const found = findSwappedWires(broken.gates);
+    const elapsed = Date.now() - started;
+    expect(found).toEqual(broken.wires);
+    expect(elapsed).toBeLessThan(5000);
+  });
+
+  it.each([
+    ['partial sums', (gate: Gate) => gate.op === 'XOR' && /^[xy]\d\d$/.test(gate.in1)],
+    ['carry generators', (gate: Gate) => gate.op === 'AND' && /^[xy]\d\d$/.test(gate.in1)],
+    ['sum outputs', (gate: Gate) => gate.op === 'XOR' && /^z\d\d$/.test(gate.out)],
+    ['carries', (gate: Gate) => gate.op === 'OR'],
+  ])('recovers swaps between two %s, which look alike structurally', (_label, matches) => {
+    const bits = 30;
+    const random = makeRandom(8642);
+    const correct = buildAdder(bits, random);
+    const candidates = correct
+      .map((gate, index) => ({ gate, index }))
+      .filter(({ gate }) => matches(gate) && !gate.in1.endsWith('00'))
+      .map(({ index }) => index);
+    const pairs: Array<[number, number]> = [
+      [candidates[0], candidates[9]],
+      [candidates[2], candidates[14]],
+      [candidates[4], candidates[19]],
+      [candidates[6], candidates[24]],
+    ];
+    const { gates, wires } = applySwaps(correct, pairs);
+    expect(findSwappedWires(gates)).toEqual(wires);
+  });
+
+  it('tolerates a circuit carrying a gate that is not part of the adder', () => {
+    const broken = makeBrokenAdder(12, 6012);
+    const padded: Gate[] = [...broken.gates, { op: 'OR', in1: 'x00', in2: 'y00', out: 'spare' }];
+    expect(findSwappedWires(padded)).toEqual(broken.wires);
+  });
+
+  it('works when the swaps are far apart in the carry chain', () => {
+    const bits = 40;
+    const random = makeRandom(2024);
+    const correct = buildAdder(bits, random);
+    const partialSums = correct
+      .map((gate, index) => ({ gate, index }))
+      .filter(({ gate }) => gate.op === 'XOR' && gate.in1.startsWith('x'))
+      .map(({ index }) => index);
+    const carryTerms = correct
+      .map((gate, index) => ({ gate, index }))
+      .filter(({ gate }) => gate.op === 'AND' && gate.in1.startsWith('x'))
+      .map(({ index }) => index);
+    const pairs: Array<[number, number]> = [
+      [partialSums[1], carryTerms[1]],
+      [partialSums[10], carryTerms[10]],
+      [partialSums[25], carryTerms[25]],
+      [partialSums[37], carryTerms[37]],
+    ];
+    const { gates, wires } = applySwaps(correct, pairs);
+    expect(findSwappedWires(gates)).toEqual(wires);
+  });
+});
