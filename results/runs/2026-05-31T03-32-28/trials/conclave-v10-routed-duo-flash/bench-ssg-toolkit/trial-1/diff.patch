    await plugin.hooks.afterBuild!(ctx);\n56\t    expect(ctx.output.has('tags/javascript.html')).toBe(true);\n57\t    expect(ctx.output.get('tags/javascript.html')).toContain('Post 1');\n58\t  });\n59\t\n60\t  it('handles files with no tags', async () => {\n61\t    const files = [\n62\t      makeFile({ slug: 'post-1', title: 'Post 1' }),\n63\t    ];\n64\t    const ctx = makeCtx(files);\n65\t    await plugin.hooks.beforeBuild!(ctx);\n66\t    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n67\t    expect(tagMap.size).toBe(0);\n68\t  });\n69\t\n70\t  it('handles files with multiple tags', async () => {\n71\t    const files = [\n72\t      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['js', 'node', 'web'] }),\n73\t    ];\n74\t    const ctx = makeCtx(files);\n75\t    await plugin.hooks.beforeBuild!(ctx);\n76\t    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n77\t    expect(tagMap.size).toBe(3);\n78\t    expect(tagMap.has('js')).toBe(true);\n79\t    expect(tagMap.has('node')).toBe(true);\n80\t    expect(tagMap.has('web')).toBe(true);\n81\t  });\n82\t\n83\t  it('tag pages list all files with that tag', async () => {\n84\t    const files = [\n85\t      makeFile({ slug: 'post-1', title: 'First Post', tags: ['tech'] }),\n86\t      makeFile({ slug: 'post-2', title: 'Second Post', tags: ['tech'] }),\n87\t    ];\n88\t    const ctx = makeCtx(files);\n89\t    await plugin.hooks.beforeBuild!(ctx);\n90\t    await plugin.hooks.afterBuild!(ctx);\n91\t    const tagPage = ctx.output.get('tags/tech.html')!;\n92\t    expect(tagPage).toContain('First Post');\n93\t    expect(tagPage).toContain('Second Post');\n94\t  });\n95\t\n96\t  it('stores tag map in ctx.data', async () => {\n97\t    const files = [\n98\t      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['alpha'] }),\n99\t    ];\n100\t    const ctx = makeCtx(files);\n101\t    await plugin.hooks.beforeBuild!(ctx);\n102\t    expect(ctx.data.has('taxonomy-tags')).toBe(true);\n103\t  });\n104\t\n105\t  it('handles empty file list', async () => {\n106\t    const ctx = makeCtx([]);\n107\t    await plugin.hooks.beforeBuild!(ctx);\n108\t    await plugin.hooks.afterBuild!(ctx);\n109\t    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n110\t    expect(tagMap.size).toBe(0);\n111\t  });\n112\t\n113\t  it('tags are case-normalized to lowercase', async () => {\n114\t    const files = [\n115\t      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['JavaScript'] }),\n116\t      makeFile({ slug: 'post-2', title: 'Post 2', tags: ['JAVASCRIPT'] }),\n117\t    ];\n118\t    const ctx = makeCtx(files);\n119\t    await plugin.hooks.beforeBuild!(ctx);\n120\t    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n121\t    expect(tagMap.has('javascript')).toBe(true);\n122\t    expect(tagMap.get('javascript')).toHaveLength(2);\n123\t    expect(tagMap.has('JavaScript')).toBe(false);\n124\t    expect(tagMap.has('JAVASCRIPT')).toBe(false);\n125\t  });\n126\t});\n127\t"}]},"parent_tool_use_id":"call_00_Kg0B5iSyKdDcJUhzPHyF6788","session_id":"7d81e0f7-0d71-4a98-96b9-b54623e63d49","uuid":"e888e615-6f1d-4bc5-9d88-1b2ff05d693c","timestamp":"2026-05-31T04:10:37.557Z","subagent_type":"Explore","task_description":"Explore codebase structure"}
