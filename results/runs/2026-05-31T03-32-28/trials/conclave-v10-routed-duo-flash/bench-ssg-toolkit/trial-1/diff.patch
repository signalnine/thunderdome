c () => {\n53\t    const file = makeFile({ content: '<img src=\"https://cdn.example.com/image.png\">' });\n54\t    const ctx = makeCtx();\n55\t    const result = await plugin.hooks.transformContent!(file, ctx);\n56\t    expect(result.content).toContain('src=\"https://cdn.example.com/image.png\"');\n57\t  });\n58\t\n59\t  it('generates asset manifest in ctx.data', async () => {\n60\t    const file = makeFile({ content: '<img src=\"./photo.jpg\">' });\n61\t    const ctx = makeCtx();\n62\t    await plugin.hooks.transformContent!(file, ctx);\n63\t    const manifest = ctx.data.get('asset-manifest') as { assets: string[] };\n64\t    expect(manifest).toBeDefined();\n65\t    expect(manifest.assets).toContain('photo.jpg');\n66\t  });\n67\t\n68\t  it('handles files with no asset references', async () => {\n69\t    const file = makeFile({ content: '<p>No assets here</p>' });\n70\t    const ctx = makeCtx();\n71\t    const result = await plugin.hooks.transformContent!(file, ctx);\n72\t    expect(result.content).toBe('<p>No assets here</p>');\n73\t  });\n74\t\n75\t  it('handles multiple assets in one file', async () => {\n76\t    const file = makeFile({\n77\t      content: '<img src=\"./a.png\"><img src=\"./b.jpg\"><a href=\"./c.pdf\">link</a>',\n78\t    });\n79\t    const ctx = makeCtx();\n80\t    await plugin.hooks.transformContent!(file, ctx);\n81\t    const manifest = ctx.data.get('asset-manifest') as { assets: string[] };\n82\t    expect(manifest.assets).toContain('a.png');\n83\t    expect(manifest.assets).toContain('b.jpg');\n84\t    expect(manifest.assets).toContain('c.pdf');\n85\t  });\n86\t\n87\t  it('asset manifest includes all discovered assets', async () => {\n88\t    const ctx = makeCtx();\n89\t    const file1 = makeFile({ content: '<img src=\"./one.png\">' });\n90\t    const file2 = makeFile({ content: '<img src=\"./two.png\">' });\n91\t    await plugin.hooks.transformContent!(file1, ctx);\n92\t    await plugin.hooks.transformContent!(file2, ctx);\n93\t    const manifest = ctx.data.get('asset-manifest') as { assets: string[] };\n94\t    expect(manifest.assets).toHaveLength(2);\n95\t    expect(manifest.assets).toContain('one.png');\n96\t    expect(manifest.assets).toContain('two.png');\n97\t  });\n98\t\n99\t  it('does not double-process already-rewritten URLs', async () => {\n100\t    const file = makeFile({ content: '<img src=\"/assets/image.png\">' });\n101\t    const ctx = makeCtx();\n102\t    const result = await plugin.hooks.transformContent!(file, ctx);\n103\t    expect(result.content).toBe('<img src=\"/assets/image.png\">');\n104\t    const manifest = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;\n105\t    expect(!manifest || manifest.assets.length === 0).toBe(true);\n106\t  });\n107\t});\n108\t"}]},"parent_tool_use_id":"call_00_Kg0B5iSyKdDcJUhzPHyF6788","session_id":"7d81e0f7-0d71-4a98-96b9-b54623e63d49","uuid":"684bd07f-a53c-4007-90f9-f4d6c53c2f71","timestamp":"2026-05-31T04:10:36.406Z","subagent_type":"Explore","task_description":"Explore codebase structure"}
