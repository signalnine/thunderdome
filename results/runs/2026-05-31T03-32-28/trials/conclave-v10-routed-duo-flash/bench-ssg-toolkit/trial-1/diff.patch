+import type { Plugin, BuildContext } from '../core/types.js';
+
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const index: Array<{
+          slug: string;
+          title: string;
+          content: string;
+          tags?: string[];
+        }> = [];
+
+        for (const file of ctx.files) {
+          // Strip HTML tags from content to get plain text
+          const plainText = file.content.replace(/<[^>]*>/g, '');
+
+          const entry: {
+            slug: string;
+            title: string;
+            content: string;
+            tags?: string[];
+          } = {
+            slug: file.slug,
+            title: file.title,
+            content: plainText,
+          };
+
+          if (file.tags && file.tags.length > 0) {
+            entry.tags = [...file.tags];
+          }
+
+          index.push(entry);
+        }
+
+        ctx.output.set('search-index.json', JSON.stringify(index));
+      },
+    },
+  };
+}
