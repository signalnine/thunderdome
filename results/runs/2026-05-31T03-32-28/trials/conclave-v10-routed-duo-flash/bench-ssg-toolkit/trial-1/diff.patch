   }));\n102\t    const ctx = await engine.build([makeFile({ content: 'hello' })]);\n103\t    expect(ctx.files[0].content).toBe('HELLO');\n104\t  });\n105\t\n106\t  it('calls plugin afterBuild hook', async () => {\n107\t    const engine = new BuildEngine(testConfig);\n108\t    let called = false;\n109\t    engine.registerPlugin(makePlugin({\n110\t      hooks: {\n111\t        afterBuild: () => { called = true; },\n112\t      },\n113\t    }));\n114\t    await engine.build([]);\n115\t    expect(called).toBe(true);\n116\t  });\n117\t\n118\t  it('executes plugins in dependency order', () => {\n119\t    const engine = new BuildEngine(testConfig);\n120\t    engine.registerPlugin(makePlugin({ name: 'b', dependencies: ['a'] }));\n121\t    engine.registerPlugin(makePlugin({ name: 'a', dependencies: [] }));\n122\t    const order = engine.resolvePluginOrder();\n123\t    expect(order.map(p => p.name)).toEqual(['a', 'b']);\n124\t  });\n125\t\n126\t  it('throws on circular dependency', () => {\n127\t    const engine = new BuildEngine(testConfig);\n128\t    engine.registerPlugin(makePlugin({ name: 'a', dependencies: ['b'] }));\n129\t    engine.registerPlugin(makePlugin({ name: 'b', dependencies: ['a'] }));\n130\t    expect(() => engine.resolvePluginOrder()).toThrow('Circular dependency');\n131\t  });\n132\t\n133\t  it('throws on missing dependency', () => {\n134\t    const engine = new BuildEngine(testConfig);\n135\t    engine.registerPlugin(makePlugin({ name: 'a', dependencies: ['missing'] }));\n136\t    expect(() => engine.resolvePluginOrder()).toThrow('Missing dependency');\n137\t  });\n138\t\n139\t  it('applies multiple plugins transformContent in order', async () => {\n140\t    const engine = new BuildEngine(testConfig);\n141\t    engine.registerPlugin(makePlugin({\n142\t      name: 'first',\n143\t      hooks: {\n144\t        transformContent: (file) => ({\n145\t          ...file,\n146\t          content: file.content + ' [first]',\n147\t        }),\n148\t      },\n149\t    })