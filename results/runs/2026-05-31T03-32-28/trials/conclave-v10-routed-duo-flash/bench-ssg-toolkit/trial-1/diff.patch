@@ -0,0 +1,36 @@
+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, ctx: BuildContext): ContentFile {
+        const content = file.content;
+
+        // Match src="./..." and href="./..." relative paths
+        const pattern = /(src|href)="\.\/([^"]+)"/g;
+        const assets: string[] = [];
+        const rewritten = content.replace(pattern, (_match, attr: string, path: string) => {
+          assets.push(path);
+          return `${attr}="/assets/${path}"`;
+        });
+
+        // Accumulate into existing manifest (per-context) or create new
+        const existing = ctx.data.get('asset-manifest') as
+          | { assets: string[] }
+          | undefined;
+        const allAssets = existing ? [...existing.assets] : [];
+        for (const asset of assets) {
+          if (!allAssets.includes(asset)) {
+            allAssets.push(asset);
+          }
+        }
+        ctx.data.set('asset-manifest', { assets: allAssets });
+
+        return { ...file, content: rewritten };
+      },
+    },
+  };
+}
