@@ -0,0 +1,79 @@
+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const { config } = ctx;
+
+        // Build a lookup of slug → tags from taxonomy data
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+        const slugToTags = new Map<string, string[]>();
+        if (tagMap) {
+          for (const [tag, files] of tagMap.entries()) {
+            for (const file of files) {
+              const existing = slugToTags.get(file.slug) || [];
+              if (!existing.includes(tag)) {
+                existing.push(tag);
+              }
+              slugToTags.set(file.slug, existing);
+            }
+          }
+        }
+
+        // Sort files by date descending (newest first); files without dates go last
+        const sorted = [...ctx.files].sort((a, b) => {
+          if (!a.date && !b.date) return 0;
+          if (!a.date) return 1;
+          if (!b.date) return -1;
+          return b.date.localeCompare(a.date);
+        });
+
+        let feed = '<?xml version="1.0" encoding="UTF-8"?>\n';
+        feed += '<rss version="2.0">\n';
+        feed += '  <channel>\n';
+        feed += `    <title>${escapeXml(config.title)}</title>\n`;
+        feed += `    <link>${escapeXml(config.baseUrl)}</link>\n`;
+        feed += `    <description>${escapeXml(config.title)}</description>\n`;
+
+        for (const file of sorted) {
+          feed += '    <item>\n';
+          feed += `      <title>${escapeXml(file.title)}</title>\n`;
+          feed += `      <link>${config.baseUrl}/${file.slug}.html</link>\n`;
+          feed += `      <guid>${config.baseUrl}/${file.slug}.html</guid>\n`;
+          if (file.date) {
+            feed += `      <pubDate>${file.date}</pubDate>\n`;
+          }
+          feed += `      <description><![CDATA[${file.content}]]></description>\n`;
+
+          // Add category tags
+          const fileTags = slugToTags.get(file.slug);
+          if (fileTags) {
+            for (const tag of fileTags) {
+              feed += `      <category>${escapeXml(tag)}</category>\n`;
+            }
+          }
+
+          feed += '    </item>\n';
+        }
+
+        feed += '  </channel>\n';
+        feed += '</rss>';
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
+
+function escapeXml(str: string): string {
+  return str
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
