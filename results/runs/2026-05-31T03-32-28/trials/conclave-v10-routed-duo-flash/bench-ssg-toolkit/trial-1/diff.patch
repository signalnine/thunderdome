\n51\\t    const ctx: BuildContext = {\\n52\\t      config: this.config,\\n53\\t      files: [...files],\\n54\\t      output: new Map(),\\n55\\t      assets: new Map(),\\n56\\t      data: new Map(),\\n57\\t    };\\n58\\t\\n59\\t    const orderedPlugins = this.resolvePluginOrder();\\n60\\t\\n61\\t    // beforeBuild hooks\\n62\\t    for (const plugin of orderedPlugins) {\\n63\\t      if (plugin.hooks.beforeBuild) {\\n64\\t        await plugin.hooks.beforeBuild(ctx);\\n65\\t      }\\n66\\t    }\\n67\\t\\n68\\t    // transformContent hooks (applied to each file in plugin order)\\n69\\t    for (const plugin of orderedPlugins) {\\n70\\t      if (plugin.hooks.transformContent) {\\n71\\t        const transformed: ContentFile[] = [];\\n72\\t        for (const file of ctx.files) {\\n73\\t          transformed.push(await plugin.hooks.transformContent(file, ctx));\\n74\\t        }\\n75\\t        ctx.files = transformed;\\n76\\t      }\\n77\\t    }\\n78\\t\\n79\\t    // Render templates\\n80\\t    for (const file of ctx.files) {\\n81\\t      const templateName = file.template || 'default';\\n82\\t      const template = this.templates.get(templateName);\\n83\\t      if (template) {\\n84\\t        const rendered = template.render(file.content, {\\n85\\t          title: file.title,\\n86\\t          slug: file.slug,\\n87\\t          date: file.date,\\n88\\t          tags: file.tags,\\n89\\t          ...file.metadata,\\n90\\t          siteTitle: this.config.title,\\n91\\t          baseUrl: this.config.baseUrl,\\n92\\t        });\\n93\\t        ctx.output.set(`${file.slug}.html`, rendered);\\n94\\t      } else {\\n95\\t        ctx.output.set(`${file.slug}.html`, file.content);\\n96\\t      }\\n97\\t    }\\n98\\t\\n99\\t    // afterBuild hooks\\n100\\t    for (const plugin of orderedPlugins) {\\n101\\t      if (plugin.hooks.afterBuild) {\\n102\\t        await plugin.hooks.afterBuild(ctx);\\n103\\t      }\\n104\\t    }\\n105\\t\\n106\\t    return ctx;\\n107\\t  }\\n108\\t\\n109\\t  getP