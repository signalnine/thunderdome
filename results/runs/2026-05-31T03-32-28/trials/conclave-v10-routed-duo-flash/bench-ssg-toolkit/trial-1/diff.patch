+import { marked } from 'marked';
+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      async transformContent(file: ContentFile, _ctx: BuildContext): Promise<ContentFile> {
+        const content = file.content || '';
+        if (!content) {
+          return { ...file, content: '' };
+        }
+
+        // 1. Handle admonition containers :::note, :::warning, :::tip
+        let processed = content.replace(
+          /:::(\w+)\n([\s\S]*?):::/g,
+          (_match, type: string, body: string) => {
+            return `<div class="admonition admonition-${type}">\n${body.trim()}\n</div>`;
+          }
+        );
+
+        // 2. Extract footnote definitions
+        const footnotes: Array<{ id: string; num: string; text: string }> = [];
+        const defRegex = /^\[(\^\d+)\]:\s*(.+)$/gm;
+        let match: RegExpExecArray | null;
+        while ((match = defRegex.exec(processed)) !== null) {
+          footnotes.push({ id: match[1], num: match[1].replace('^', ''), text: match[2] });
+        }
+        processed = processed.replace(defRegex, '');
+
+        // 3. Replace footnote references with superscript links
+        processed = processed.replace(/\[\^(\d+)\]/g, (_match, num: string) => {
+          return `<sup><a href="#fn-${num}">${num}</a></sup>`;
+        });
+
+        // 4. Parse markdown to HTML
+        let html = await marked.parse(processed);
+
+        // 5. Append footnote section
+        if (footnotes.length > 0) {
+          html += '\n<section class="footnotes">\n<ol>\n';
+          for (const fn of footnotes) {
+            html += `<li id="fn-${fn.num}">${fn.text}</li>\n`;
+          }
+          html += '</ol>\n</section>';
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
