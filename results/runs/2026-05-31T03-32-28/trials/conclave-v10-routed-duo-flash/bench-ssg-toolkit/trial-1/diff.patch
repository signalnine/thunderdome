+}
+
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const config: DevServerConfig = {
+          port: 3000,
+          routes: [],
+          assetPaths: [],
+          searchIndexPath: '',
+        };
+
+        // Asset paths from asset-pipeline manifest
+        const manifest = ctx.data.get('asset-manifest') as
+          | { assets: string[] }
+          | undefined;
+        if (manifest && Array.isArray(manifest.assets)) {
+          config.assetPaths = manifest.assets;
+          for (const asset of manifest.assets) {
+            config.routes.push({
+              path: `/assets/${asset}`,
+              handler: 'asset',
+            });
+          }
+        }
+
+        // Search index path from output
+        if (ctx.output.has('search-index.json')) {
+          config.searchIndexPath = '/search-index.json';
+        }
+
+        // Content routes for each HTML file in output
+        for (const key of ctx.output.keys()) {
+          if (key.endsWith('.html')) {
+            config.routes.push({
+              path: `/${key}`,
+              handler: 'static',
+            });
+          }
+        }
+
+        ctx.data.set('dev-server-config', config);
+      },
+    },
+  };
+}
