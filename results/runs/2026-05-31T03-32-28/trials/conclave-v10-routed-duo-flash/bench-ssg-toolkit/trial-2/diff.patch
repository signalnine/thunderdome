+import { Plugin } from '../core/types.js';
+import { marked } from 'marked';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file) => {
+        if (!file.content) {
+          return { ...file, content: '' };
+        }
+
+        let content = file.content;
+
+        // Process admonition containers (:::type ... :::)
+        content = content.replace(
+          /:::(\w+)\n([\s\S]*?):::/g,
+          (_, type, text) => {
+            return `<div class="admonition admonition-${type}">\n${text.trim()}\n</div>`;
+          }
+        );
+
+        // Extract footnote definitions [^n]: text
+        const footnotes: Array<{ id: number; text: string }> = [];
+        content = content.replace(
+          /\[\^(\d+)\]:\s*(.+)/g,
+          (_, id, text) => {
+            footnotes.push({ id: parseInt(id, 10), text: text.trim() });
+            return '';
+          }
+        );
+
+        // Replace footnote references [^n] with sup links
+        content = content.replace(
+          /\[\^(\d+)\]/g,
+          (_, id) => {
+            return `<sup><a href="#fn-${id}">${id}</a></sup>`;
+          }
+        );
+
+        // Convert markdown to HTML
+        const html = marked.parse(content, { async: false }) as string;
+
+        // Append footnotes section if any
+        if (footnotes.length > 0) {
+          const footnoteItems = footnotes
+            .sort((a, b) => a.id - b.id)
+            .map((fn) => `<li id="fn-${fn.id}">${fn.text}</li>`)
+            .join('\n');
+          return {
+            ...file,
+            content: html + `\n<section class="footnotes">\n${footnoteItems}\n</section>`,
+          };
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
