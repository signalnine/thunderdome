@@ -0,0 +1,62 @@
+import { Plugin } from '../core/types.js';
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx) => {
+        const { config, files } = ctx;
+        const baseUrl = config.baseUrl.replace(/\/$/, '');
+
+        // Sort files by date, newest first (files without dates at end)
+        const sorted = [...files].sort((a, b) => {
+          if (!a.date && !b.date) return 0;
+          if (!a.date) return 1;
+          if (!b.date) return -1;
+          return b.date.localeCompare(a.date);
+        });
+
+        const items = sorted
+          .map((file) => {
+            const title = escapeXml(file.title);
+            const link = `${baseUrl}/${file.slug}.html`;
+            const description = `<![CDATA[${file.content}]]>`;
+            const pubDate = file.date ? `\n      <pubDate>${escapeXml(file.date)}</pubDate>` : '';
+            const categories = (file.tags || [])
+              .map((tag) => `\n      <category>${escapeXml(tag)}</category>`)
+              .join('');
+
+            return `    <item>
+      <title>${title}</title>
+      <link>${link}</link>
+      <description>${description}</description>${pubDate}${categories}
+    </item>`;
+          })
+          .join('\n');
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(config.title)}</title>
+    <link>${baseUrl}</link>
+    <description>${escapeXml(config.title)}</description>
+${items}
+  </channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
+
+function escapeXml(str: string): string {
+  return str
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
