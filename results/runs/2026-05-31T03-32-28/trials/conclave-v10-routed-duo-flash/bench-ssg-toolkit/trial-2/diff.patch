@@ -0,0 +1,32 @@
+import { Plugin } from '../core/types.js';
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file) => {
+        let content = file.content;
+
+        // Process <pre> blocks to add language annotations
+        content = content.replace(
+          /<pre>([\s\S]*?)<\/pre>/g,
+          (match, inner) => {
+            const langMatch = inner.match(/<code\s+class="language-(\w+)"/);
+            if (!langMatch) return match;
+
+            const lang = langMatch[1];
+            const modified = inner.replace(
+              /<code\s+class="language-\w+"/,
+              `<code class="language-${lang} highlighted"`
+            );
+            return `<pre data-language="${lang}">${modified}</pre>`;
+          }
+        );
+
+        return { ...file, content };
+      },
+    },
+  };
+}
