+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index.js';
+
+// ---------------------------------------------------------------------------
+// Helper: build grid from a string. Rows separated by newline or commas.
+// ---------------------------------------------------------------------------
+function grid(strings: TemplateStringsArray): string[][] {
+  const s = strings.raw[0].trim();
+  return s.split('\n').map((line) => line.trim().split(/\s+/));
+}
+
+describe('countBeamCells', () => {
+  // Criterion: Empty grid
+  it('returns 0 for empty grid', () => {
+    expect(countBeamCells([])).toBe(0);
+  });
+
+  // Criterion: Zero-column grid
+  it('returns 0 for grid with 0 columns', () => {
+    expect(countBeamCells([[]])).toBe(0);
+  });
+
+  // Criterion: Single cell S — beam exits immediately
+  it('counts source cell (single cell grid)', () => {
+    expect(countBeamCells([['S']])).toBe(1);
+  });
+
+  // Criterion: Source beam moves straight down
+  it('counts cells visited by straight-down beam', () => {
+    const g: string[][] = [
+      ['.', 'S', '.'],
+      ['.', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    // S at (0,1), visits (0,1),(1,1),(2,1) → 3
+    expect(countBeamCells(g)).toBe(3);
+  });
+
+  // Criterion: Single splitter example from spec
+  it('handles single splitter (spec example)', () => {
+    const g = grid`
+      . S . . .
+      . . . . .
+      . ^ . . .
+      . . . . .
+    `;
+    // Visited: (0,1),(1,1),(2,1),(3,0),(3,2) → 5
+    expect(countBeamCells(g)).toBe(5);
+  });
+
+  // Criterion: Two splitters in series (spec example)
+  it('handles two splitters (spec example)', () => {
+    const g = grid`
+      . S . . .
+      . ^ . . .
+      ^ . ^ . .
+      . . . . .
+    `;
+    // Visited: (0,1),(1,1),(2,0),(2,2),(3,1),(3,3) → 6
+    expect(countBeamCells(g)).toBe(6);
+  });
+
+  // Criterion: Multiple beams same cell counted once
+  it('counts overlapping cells only once', () => {
+    // Two splitters both sending beams to (3,1)
+    const g = grid`
+      . S . . .
+      . ^ . . .
+      ^ . ^ . .
+      . . . . .
+    `;
+    // Verify (3,1) counted once — count is 6 as above
+    expect(countBeamCells(g)).toBe(6);
+  });
+
+  // Criterion: No splitters
+  it('works with no splitters', () => {
+    const g: string[][] = [
+      ['S'],
+      ['.'],
+      ['.'],
+      ['.'],
+      ['.'],
+    ];
+    expect(countBeamCells(g)).toBe(5);
+  });
+
+  // Criterion: S at top-left corner
+  it('handles S at top-left', () => {
+    const g: string[][] = [
+      ['S'],
+      ['.'],
+      ['.'],
+    ];
+    expect(countBeamCells(g)).toBe(3);
+  });
+
+  // Criterion: Multiple splitters in chain
+  it('counts cells with 3 splitters in chain', () => {
+    // Ensure each branch is covered
+    const g = grid`
+      . . S . .
+      . . ^ . .
+      . ^ . ^ .
+      ^ . . . ^
+      . . . . .
+    `;
+    // S at (0,2)→(1,2)^→(2,1)^,(2,3)^→(3,0)^,(3,2),(3,2),(3,4)^
+    // (2,1)^→(3,0)^,(3,2)
+    // (2,3)^→(3,2),(3,4)^
+    // (3,0)^→(4,-1)abs,(4,1)
+    // (3,2)→(4,1),(4,3) [from left, from right — same cell]
+    // (3,4)^→(4,3),(4,5)abs
+    // So cells: (0,2),(1,2),(2,1),(2,3),(3,0),(3,2),(3,4),(4,1),(4,3)
+    // Also (2,1)→(3,0) and (2,3)→(3,4) are splitter visits
+    // Plus (3,2) visited from multiple branches
+    expect(countBeamCells(g)).toBe(9);
+  });
+
+  // Criterion: Bounday absorption — left edge
+  it('counts cells when beam hits left edge', () => {
+    const g = grid`
+      S . .
+      ^ . .
+      . . .
+    `;
+    // S (0,0)→(1,0)^→(2,-1)abs,(2,1)
+    // Cells: (0,0),(1,0),(2,1) → 3
+    expect(countBeamCells(g)).toBe(3);
+  });
+});
+
+describe('countBeamPaths', () => {
+  // Criterion: Empty grid
+  it('returns 0n for empty grid', () => {
+    expect(countBeamPaths([])).toBe(0n);
+  });
+
+  // Criterion: Zero-column grid
+  it('returns 0n for grid with 0 columns', () => {
+    expect(countBeamPaths([[]])).toBe(0n);
+  });
+
+  // Criterion: Returns bigint
+  it('returns a bigint', () => {
+    const result = countBeamPaths([['S']]);
+    expect(typeof result).toBe('bigint');
+  });
+
+  // Criterion: Single cell S — beam exits immediately
+  it('single cell beam exits immediately', () => {
+    expect(countBeamPaths([['S']])).toBe(1n);
+  });
+
+  // Criterion: Source beam moves straight down, no splitters
+  it('straight down path with no splitters', () => {
+    const g: string[][] = [
+      ['S'],
+      ['.'],
+      ['.'],
+      ['.'],
+    ];
+    expect(countBeamPaths(g)).toBe(1n);
+  });
+
+  // Criterion: Single splitter (spec example)
+  it('single splitter produces 2 paths', () => {
+    const g = grid`
+      . S . . .
+      . . . . .
+      . ^ . . .
+      . . . . .
+    `;
+    expect(countBeamPaths(g)).toBe(2n);
+  });
+
+  // Criterion: Two splitters (spec example) — 4 paths
+  it('two splitters produce 4 paths', () => {
+    const g = grid`
+      . S . . .
+      . ^ . . .
+      ^ . ^ . .
+      . . . . .
+    `;
+    // 4 total paths as per spec (all 4 exit, including (3,-1))
+    expect(countBeamPaths(g)).toBe(4n);
+  });
+
+  // Criterion: Three splitters in a tree produce 6 paths
+  it('three splitters produce 6 paths', () => {
+    // Layout: S at (0,2), ^ at (1,2), ^ at (2,1), ^ at (2,3), rows 0-4
+    // Traced by hand: 6 distinct exit paths
+    const g2 = grid`
+      . . S . .
+      . . ^ . .
+      . ^ . ^ .
+      ^ . . . ^
+      . . . . .
+    `;
+    expect(countBeamPaths(g2)).toBe(6n);
+  });
+
+  // Criterion: 2^K paths with K splitters in a clean chain
+  it('produces exactly 2^K paths for K splitters in a cascading tree', () => {
+    // Design a grid where each beam hits K splitters before exiting
+    // Use stagger pattern: one splitter per row, offset by 1 each time
+    const buildKiteGrid = (k: number): string[][] => {
+      const rows = k + 2;
+      const cols = 2 * k + 1;
+      const g: string[][] = Array.from({ length: rows }, () =>
+        Array.from({ length: cols }, () => '.')
+      );
+      // S at row 0, center
+      g[0][k] = 'S';
+      // Splitters at rows 1..k, columns k, k-1, k+1, k-2, k+2, etc.
+      // Actually let's do: splitter at row i, column k (for i=1..k)
+      // Then add empty rows at bottom
+      for (let i = 1; i <= k; i++) {
+        g[i][k] = '^';
+      }
+      // But with this layout, splitters are in same column — beam goes down to first splitter,
+      // splits to DL and DR, which go to (2,k-1) and (2,k+1) — NOT the splitter at (2,k)
+      // So this doesn't form a chain.
+
+      // Instead, use a chain where each splitter feeds into two splitters in the next row
+      // For K splitters total, we want 2^K paths — so splitter_i leads to 2 splitter_{i+1}s.
+      // But that's a binary tree, not a chain. Different concept.
+
+      // For a CHAIN of K splitters (each beam hits K splitters = 2^K paths):
+      // Put splitters at alternating columns so both branches go through them
+      // Row 1: ^ at col k
+      // Row 2: ^ at col k-1 and ^ at col k+1
+      // Row 3: ^ at col k-2, ^ at col k, ^ at col k+2
+      // but this only gives 2^2 = 4 paths for 3 rows of splitters
+
+      // Actually each path goes through one splitter per row.
+      // With 1 splitter row: 2^1 = 2 paths
+      // With 2 splitter rows: 2^2 = 4 paths
+      // With 3 splitter rows: 2^3 = 8 paths
+
+      // Row 1: ^ at col k
+      // Each beam from row 1 splitter goes to row 2. The DL beam lands at (2, k-1),
+      // the DR beam lands at (2, k+1).
+      // Put ^ at both (2, k-1) and (2, k+1).
+      // From (2, k-1)^: DL→(3,k-2), DR→(3,k)
+      // From (2, k+1)^: DL→(3,k), DR→(3,k+2)
+      // Put ^ at (3,k-2), (3,k), (3,k+2)
+      // Continue pattern.
+
+      return g;
+    };
+
+    // For K=1: 2 paths
+    const g1 = grid`
+      . S .
+      . ^ .
+      . . .
+    `;
+    expect(countBeamPaths(g1)).toBe(2n);
+
+    // For K=2 (2 splitters per beam = 4 paths):
+    const g2 = grid`
+      . . S . .
+      . . ^ . .
+      . ^ . ^ .
+      . . . . .
+    `;
+    expect(countBeamPaths(g2)).toBe(4n);
+  });
+
+  // Criterion: Splitter at left edge
+  it('handles splitter at left edge', () => {
+    const g = grid`
+      S . .
+      ^ . .
+      . . .
+    `;
+    // S(0,0)→(1,0)^→(2,-1)abs, (2,1)→(3,1)out
+    // 2 paths
+    expect(countBeamPaths(g)).toBe(2n);
+  });
+
+  // Criterion: Splitter at right edge
+  it('handles splitter at right edge', () => {
+    const g = grid`
+      . . S
+      . . ^
+      . . .
+    `;
+    // S(0,2)→(1,2)^→(2,1),(2,3)abs
+    // 2 paths
+    expect(countBeamPaths(g)).toBe(2n);
+  });
+
+  // Criterion: No S in grid (edge case — no beam)
+  it('returns 0n when no S found', () => {
+    const g: string[][] = [
+      ['.', '.'],
+      ['.', '.'],
+    ];
+    expect(countBeamPaths(g)).toBe(0n);
+  });
+
+  // Criterion: countBeamPaths also returns 0n for no-S
+  it('countBeamCells returns 0 when no S found', () => {
+    const g: string[][] = [
+      ['.', '.'],
+      ['.', '.'],
+    ];
+    expect(countBeamCells(g)).toBe(0);
+  });
+
+  // Criterion: Splitters always split regardless of incoming direction
+  it('splits regardless of incoming direction', () => {
+    // A single ^ always splits — rule #6 says splitters always split
+    // regardless of the beam's incoming direction.
+    // Place S above a ^:
+    const g = grid`
+      . S .
+      . ^ .
+      . . .
+    `;
+    expect(countBeamPaths(g)).toBe(2n);
+  });
+});
+
+describe('Large / performance', () => {
+  it('handles 200x200 grid with 50 splitters in under 5s', () => {
+    const rows = 200;
+    const cols = 200;
+    const g: string[][] = Array.from({ length: rows }, () =>
+      Array(cols).fill('.')
+    );
+    // Place S at top
+    g[0][100] = 'S';
+    // Place splitters in a pattern that creates fan-out
+    let splitterCount = 0;
+    for (let r = 1; r < rows && splitterCount < 50; r += 2) {
+      for (let c = 100 - splitterCount; c <= 100 + splitterCount && splitterCount < 50; c += 4) {
+        if (c >= 0 && c < cols) {
+          g[r][c] = '^';
+          splitterCount++;
+        }
+      }
+    }
+
+    const start = Date.now();
+    const cells = countBeamCells(g);
+    const paths = countBeamPaths(g);
+    const elapsed = Date.now() - start;
+
+    expect(elapsed).toBeLessThan(5000);
+    expect(cells).toBeGreaterThan(0);
+    expect(paths).toBeGreaterThan(0n);
+  });
+});
