) =>\n      Array(cols).fill('.')\n    );\n    // Place S at top\n    g[0][100] = 'S';\n    // Place splitters in a pattern that creates fan-out\n    let splitterCount = 0;\n    for (let r = 1; r < rows && splitterCount < 50; r += 2) {\n      for (let c = 100 - splitterCount; c <= 100 + splitterCount && splitterCount < 50; c += 4) {\n        if (c >= 0 && c < cols) {\n          g[r][c] = '^';\n          splitterCount++;\n        }\n      }\n    }\n\n    const start = Date.now();\n    const cells = countBeamCells(g);\n    const paths = countBeamPaths(g);\n    const elapsed = Date.now() - start;\n\n    expect(elapsed).toBeLessThan(5000);\n    expect(cells).toBeGreaterThan(0);\n    expect(paths).toBeGreaterThan(0n);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
