+// ---------------------------------------------------------------------------
+// Beam Splitter — 2D grid beam propagation simulator
+// ---------------------------------------------------------------------------
+
+const enum Dir {
+  DOWN = 0,
+  DOWN_LEFT = 1,
+  DOWN_RIGHT = 2,
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+/**
+ * Find the source cell (row 0 only). Returns [row, col] or null.
+ */
+function findSource(grid: string[][]): [number, number] | null {
+  if (grid.length === 0) return null;
+  const top = grid[0];
+  if (top.length === 0) return null;
+  for (let c = 0; c < top.length; c++) {
+    if (top[c] === 'S') return [0, c];
+  }
+  return null;
+}
+
+/**
+ * True if (r,c) is within the grid bounds.
+ */
+function inBounds(rows: number, cols: number, r: number, c: number): boolean {
+  return r >= 0 && r < rows && c >= 0 && c < cols;
+}
+
+/**
+ * Compute the next cell coordinates for a given direction.
+ */
+function nextCell(r: number, c: number, d: Dir): [number, number] {
+  return [r + 1, c + (d === Dir.DOWN ? 0 : d === Dir.DOWN_LEFT ? -1 : 1)];
+}
+
+// ---------------------------------------------------------------------------
+// Public API
+// ---------------------------------------------------------------------------
+
+/**
+ * Count the number of distinct cells visited by any beam.
+ *
+ * Uses DP on the DAG (row always increases so no cycles) to find all
+ * reachable (r,c,d) states, marking visited cells along the way.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+  if (cols === 0) return 0;
+
+  const source = findSource(grid);
+  if (!source) return 0;
+  const [sr, sc] = source;
+
+  // reachable[r][c][d] — whether a beam can arrive at (r,c) with direction d
+  const reachable: boolean[][][] = Array.from({ length: rows }, () =>
+    Array.from({ length: cols }, () => [false, false, false]),
+  );
+
+  const visited = new Set<number>();
+
+  reachable[sr][sc][Dir.DOWN] = true;
+
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      for (let d = Dir.DOWN; d <= Dir.DOWN_RIGHT; d++) {
+        if (!reachable[r][c][d]) continue;
+
+        visited.add(r * cols + c);
+
+        if (grid[r][c] === '^') {
+          // Splitter — always splits into down-left and down-right
+          for (const nd of [Dir.DOWN_LEFT, Dir.DOWN_RIGHT]) {
+            const [nr, nc] = nextCell(r, c, nd);
+            if (inBounds(rows, cols, nr, nc)) {
+              reachable[nr][nc][nd] = true;
+            }
+          }
+        } else {
+          // Continue in current direction
+          const [nr, nc] = nextCell(r, c, d as Dir);
+          if (inBounds(rows, cols, nr, nc)) {
+            reachable[nr][nc][d] = true;
+          }
+        }
+      }
+    }
+  }
+
+  return visited.size;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths.
+ *
+ * Since the grid is a DAG (row always increases) we can use DP:
+ *   dp[r][c][d] = number of paths reaching cell (r,c) with direction d.
+ *
+ * Process rows in order and propagate counts forward. Paths that exit the
+ * grid are added to the running total.
+ *
+ * This handles up to 2^K paths without enumerating them by using BigInt and
+ * running in O(rows × cols × 3) time.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+  if (cols === 0) return 0n;
+
+  const source = findSource(grid);
+  if (!source) return 0n;
+  const [sr, sc] = source;
+
+  // dp[r][c][d] — BigInt path counts for each state
+  const dp: bigint[][][] = Array.from({ length: rows }, () =>
+    Array.from({ length: cols }, () => [0n, 0n, 0n]),
+  );
+
+  dp[sr][sc][Dir.DOWN] = 1n;
+  let total: bigint = 0n;
+
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      for (let d = Dir.DOWN; d <= Dir.DOWN_RIGHT; d++) {
+        const count = dp[r][c][d];
+        if (count === 0n) continue;
+
+        if (grid[r][c] === '^') {
+          // Split into down-left and down-right
+          for (const nd of [Dir.DOWN_LEFT, Dir.DOWN_RIGHT]) {
+            const [nr, nc] = nextCell(r, c, nd);
+            if (inBounds(rows, cols, nr, nc)) {
+              dp[nr][nc][nd] += count;
+            } else {
+              total += count;
+            }
+          }
+        } else {
+          // Continue in current direction
+          const [nr, nc] = nextCell(r, c, d as Dir);
+          if (inBounds(rows, cols, nr, nc)) {
+            dp[nr][nc][d] += count;
+          } else {
+            total += count;
+          }
+        }
+      }
+    }
+  }
+
+  return total;
+}
