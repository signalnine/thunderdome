ct(countBeamCells(grid)).toBe(3);\n  });\n\n  // Behavior: multiple rows of splitters - chain\n  it('handles a chain of splitters', () => {\n    // . S . . .\n    // . ^ . . .\n    // . . ^ . .\n    // . . . . .\n    //\n    // (0,1)→(1,1)=^→(2,0) and (2,2)\n    // (2,0)=.→(3,-1) out\n    // (2,2)=^→(3,1) and (3,3)\n    // (3,1)=.→(4,2) ... wait, grid is 4 rows\n    // (3,1) and (3,3) on row 3, last row, continue down→out\n    const grid = [\n      ['.', 'S', '.', '.', '.'],\n      ['.', '^', '.', '.', '.'],\n      ['.', '.', '^', '.', '.'],\n      ['.', '.', '.', '.', '.'],\n    ];\n    // Cells: (0,1),(1,1),(2,0),(2,2),(3,1),(3,3) => 6? No, let me trace again.\n    // Actually, (2,2) is ^, check: (2,2) is '^'. So (2,0) is '.', (2,2) is '^'.\n    // Visited: S at (0,1), then (1,1)=^, then from ^: (2,0) and (2,2)\n    // (2,0)=.: continue down-left → (3,-1) out, not visited.\n    //   Wait, (2,0) is visited (it's where the beam lands).\n    // (2,2)=^: split → (3,1) down-left and (3,3) down-right. Wait no.\n    //   ^ at (2,2): split → (3,1) and (3,3)\n    // (3,1)=.: continue down-left → out of bounds\n    // (3,3)=.: continue down-right → out of bounds\n    //\n    // Cells visited: (0,1),(1,1),(2,0),(2,2),(3,1),(3,3) => 6\n    expect(countBeamCells(grid)).toBe(6);\n  });\n\n  // Behavior: Source with splitter immediately below\n  it('handles splitter directly below source', () => {\n    const grid = [\n      ['S', '.'],\n      ['^', '.'],\n    ];\n    // (0,0)=S, (1,0)=^ → split → (2,-1) out and (2,1) out\n    // Cells: (0,0),(1,0) => 2\n    expect(countBeamCells(grid)).toBe(2);\n  });\n\n  // Behavior: Large grid performance (200x200 with 50 splitters)\n  it('handles a 200x200 grid with 50 splitters in under 5 seconds', () => {\n    const rows = 200, cols = 200;\n    const grid: string[][] = Array.from({ length: rows }, () =>\n      Array.from({ length: cols }, () => '.')\n    );\n    grid[0][100] = 'S';\n    // Place 50 splitters in a pattern\n    for (let i = 