not (4,0).\n    //\n    // The down-left beam from (2,1)^ goes to (3,0). Then continues to (4,-1).\n    // The down-right beam goes to (3,2). Then continues to (4,3).\n    //\n    // So a diagonal beam from a split always continues diagonal.\n    // For it to hit a ^, the ^ must be at (row+1, col±1) from the beam's current position.\n    //\n    // Example for down-left hitting ^:\n    // . S . . .\n    // . . . . .\n    // . ^ . . .\n    // . . . . .\n    // . . . . .\n    // . ^ . . .  ← this ^ would be at (5,0), beam goes (2,1)→(3,0)→(4,-1). Never reaches (5,0).\n    //\n    // Hmm. Actually: from (2,1)^ → (3,0) and (3,2)\n    // (3,0)→(4,-1) leaves the grid.\n    //\n    // I need to put the ^ where the diagonal beam actually lands.\n    // Down-left from (r,c) goes to (r+1, c-1). So from (3,0), down-left goes to (4,-1) out.\n    //\n    // From (2,1)^, the down-right goes to (3,2). Then (3,2)→(4,3).\n    // If I put ^ at (3,2), the down-right beam from (2,1) would hit it.\n    // But wait, the beam from (2,1)^ creates NEW beams at (3,2). The beam arrives at (3,2)\n    // going down-right (it's a down-right split). So at (3,2), if it's ^, it splits.\n    //\n    // . S . . . .\n    // . . . . . .\n    // . ^ . . . .\n    // . . ^ . . .  ← down-right beam from (2,1)^ arrives at (3,2)=^\n    // . . . . . .\n    //\n    // (2,1)=^ → (3,0)=. (down-left) and (3,2)=^ (down-right)\n    // At (3,2)=^: split → (4,1) down-left and (4,3) down-right\n    // At (3,0)=.: continue down-left → (4,-1) out\n    //\n    // This demonstrates both directions hitting ^: (2,1) receives down-going beam and splits.\n    // (3,2) receives down-right beam and splits.\n    // Both splits produce correct diagonal outputs.\n    const grid = [\n      ['.', 'S', '.', '.', '.'],\n      ['.', '.', '.', '.', '.'],\n      ['.', '^', '.', '.', '.'],\n      ['.', '.', '^', '.', '.'],\n      ['.', '.', '.', '.', '.'],\n    ];\n    // Paths from (2,1)=^: → (3,0) and (3,2)=^\n    // From (3,2)=^: → (4,1) and (4,3)\n    // From (3,0): → (4,-1) out = 1 path\n    // From (4,1): → (5,2) out = 1 path (continuing down-right from (4,1))\n    // From (4,3): → (5,4) out = 1 path\n    // Total: 3 paths\n    // Wait: row count = 5, rows = 5. Row indices 0-4.\n    // (4,1)→(5,2) out of bounds, yes\n    // (4,3)→(5,4) out of bounds, yes\n    // Total = 3 paths\n    expect(countBeamPaths(grid)).toBe(3n);\n  });\n\n  // Performance test for countBeamPaths\n  it('handles a 200x200 grid with 50 splitters in under 5 seconds', () => {\n    const rows = 200, cols = 200;\n    const grid: string[][] = Array.from({ length: rows }, () =>\n      Array.from({ length: cols }, () => '.')\n    );\n    grid[0][100] = 'S';\n    for (let i = 0; i < 50; i++) {\n      const r = 10 + i * 3;\n      const c = 100 + (i % 10) * 2 - 10;\n      if (r < rows && c >= 0 && c < cols) {\n        grid[r][c] = '^';\n      }\n    }\n    const start = Date.now();\n    const result = countBeamPaths(grid);\n    const elapsed = Date.now() - start;\n    expect(elapsed).toBeLessThan(5000);\n    expect(typeof result).toBe('bigint');\n    expect(result).toBeGreaterThan(0n);\n  });\n\n  // Edge: Source on far left column\n  it('handles source on leftmost column', () => {\n    const grid = [\n      ['S', '.', '.'],\n      ['.', '.', '.'],\n      ['.', '^', '.'],\n      ['.', '.', '.'],\n    ];\n    // (0,0)→(1,0)→(2,0)=.→(3,-1)... wait ^ is at (2,1). Beam goes straight down to (1,0), (2,0).\n    // (2,0)=., continue down to (3,0)→(4,0) out...\n    // Actually path is just 1 (straight down). ^ at (2,1) is not hit.\n    expect(countBeamPaths(grid)).toBe(1n);\n  });\n\n  // Edge: Source on far right column\n  it('handles source on rightmost column', () => {\n    const grid = [\n      ['.', '.', 'S'],\n      ['.', '.', '.'],\n      ['.', '.', '.'],\n    ];\n    expect(countBeamPaths(grid)).toBe(1n);\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":130,"cache_creation_input_tokens":0,"cache_re