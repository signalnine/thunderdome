+// Direction constants
+const DIR_DOWN = 0;
+const DIR_DOWN_LEFT = 1;
+const DIR_DOWN_RIGHT = 2;
+
+const DR: readonly number[] = [1, 1, 1];
+const DC: readonly number[] = [0, -1, 1];
+
+function findSource(grid: string[][]): number {
+  if (grid.length === 0) return -1;
+  const cols = grid[0].length;
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') return c;
+  }
+  return -1;
+}
+
+/**
+ * Count the number of distinct cells visited by any beam.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+
+  const srcCol = findSource(grid);
+  if (srcCol < 0) return 0;
+
+  // visited[r][c][dir] — whether we've processed state (r,c,dir)
+  const visited: boolean[][][] = Array.from({ length: rows }, () =>
+    Array.from({ length: cols }, () => [false, false, false])
+  );
+
+  const cellVisited: boolean[][] = Array.from({ length: rows }, () =>
+    Array(cols).fill(false)
+  );
+
+  // BFS/DFS queue of (r, c, dir)
+  const queue: [number, number, number][] = [];
+
+  // Start at source going down
+  visited[0][srcCol][DIR_DOWN] = true;
+  cellVisited[0][srcCol] = true;
+  queue.push([0, srcCol, DIR_DOWN]);
+
+  let head = 0;
+  while (head < queue.length) {
+    const [r, c, dir] = queue[head++];
+
+    if (grid[r][c] === '^') {
+      // Splitter: emits down-left and down-right, regardless of incoming direction
+      for (const newDir of [DIR_DOWN_LEFT, DIR_DOWN_RIGHT]) {
+        const nr = r + DR[newDir];
+        const nc = c + DC[newDir];
+        if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
+          if (!visited[nr][nc][newDir]) {
+            visited[nr][nc][newDir] = true;
+            cellVisited[nr][nc] = true;
+            queue.push([nr, nc, newDir]);
+          }
+        }
+      }
+    } else {
+      // Empty cell or source: continue in same direction
+      const nr = r + DR[dir];
+      const nc = c + DC[dir];
+      if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
+        if (!visited[nr][nc][dir]) {
+          visited[nr][nc][dir] = true;
+          cellVisited[nr][nc] = true;
+          queue.push([nr, nc, dir]);
+        }
+      }
+    }
+  }
+
+  let count = 0;
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      if (cellVisited[r][c]) count++;
+    }
+  }
+  return count;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+
+  const srcCol = findSource(grid);
+  if (srcCol < 0) return 0n;
+
+  // dp[r][c][dir] — number of beams arriving at (r,c) going in direction dir
+  const dp: bigint[][][] = Array.from({ length: rows }, () =>
+    Array.from({ length: cols }, () => [0n, 0n, 0n])
+  );
+
+  dp[0][srcCol][DIR_DOWN] = 1n;
+  let totalPaths = 0n;
+
+  for (let r = 0; r < rows; r++) {
+    for (let c = 0; c < cols; c++) {
+      for (let dir = 0; dir < 3; dir++) {
+        const count = dp[r][c][dir];
+        if (count === 0n) continue;
+
+        if (grid[r][c] === '^') {
+          // Splitter: emits down-left and down-right
+          for (const newDir of [DIR_DOWN_LEFT, DIR_DOWN_RIGHT]) {
+            const nr = r + DR[newDir];
+            const nc = c + DC[newDir];
+            if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
+              dp[nr][nc][newDir] += count;
+            } else {
+              totalPaths += count;
+            }
+          }
+        } else {
+          // Empty cell or source: continue in same direction
+          const nr = r + DR[dir];
+          const nc = c + DC[dir];
+          if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
+            dp[nr][nc][dir] += count;
+          } else {
+            totalPaths += count;
+          }
+        }
+      }
+    }
+  }
+
+  return totalPaths;
+}
