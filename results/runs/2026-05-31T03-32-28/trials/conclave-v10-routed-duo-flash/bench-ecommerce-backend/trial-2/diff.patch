@@ -0,0 +1,68 @@
+import { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+import type { InventoryService } from '../types.js';
+
+interface StockInfo {
+  quantity: number;
+  threshold: number;
+  lastAboveThreshold: boolean;
+}
+
+export function createInventoryService(bus: EventBus): InventoryService {
+  const stock = new Map<string, StockInfo>();
+
+  function getOrCreate(productId: string): StockInfo {
+    if (!stock.has(productId)) {
+      stock.set(productId, { quantity: 0, threshold: 0, lastAboveThreshold: true });
+    }
+    return stock.get(productId)!;
+  }
+
+  function checkLowStock(productId: string, info: StockInfo): void {
+    const isLow = info.quantity < info.threshold;
+    if (isLow && info.lastAboveThreshold) {
+      bus.emit(Events.LOW_STOCK_ALERT, {
+        productId,
+        currentQuantity: info.quantity,
+        threshold: info.threshold,
+      });
+    }
+    info.lastAboveThreshold = !isLow;
+  }
+
+  return {
+    setStock(productId: string, quantity: number): void {
+      const info = getOrCreate(productId);
+      info.quantity = quantity;
+      bus.emit(Events.INVENTORY_UPDATED, { productId, quantity });
+      checkLowStock(productId, info);
+    },
+
+    getStock(productId: string): number {
+      return stock.get(productId)?.quantity ?? 0;
+    },
+
+    reserve(productId: string, quantity: number): boolean {
+      const info = stock.get(productId);
+      if (!info || info.quantity < quantity) {
+        return false;
+      }
+      info.quantity -= quantity;
+      bus.emit(Events.INVENTORY_UPDATED, { productId, quantity: info.quantity });
+      checkLowStock(productId, info);
+      return true;
+    },
+
+    release(productId: string, quantity: number): void {
+      const info = getOrCreate(productId);
+      info.quantity += quantity;
+      bus.emit(Events.INVENTORY_UPDATED, { productId, quantity: info.quantity });
+      checkLowStock(productId, info);
+    },
+
+    setLowStockThreshold(productId: string, threshold: number): void {
+      const info = getOrCreate(productId);
+      info.threshold = threshold;
+    },
+  };
+}
diff --git a/src/notifications/index.ts b/src/notifications/index.ts
new file mode 100644
index 0000000..f4e900c
--- /dev/null
+++ b/src/notifications/index.ts
@@ -0,0 +1,65 @@
+import { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+import type {
+  NotificationService,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+} from '../types.js';
+
+interface Notification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribedUsers = new Set<string>();
+  const notifications = new Map<string, Notification[]>();
+  const orderOwners = new Map<string, string>();
+
+  function addNotification(userId: string, type: string, message: string): void {
+    if (!subscribedUsers.has(userId)) return;
+    if (!notifications.has(userId)) {
+      notifications.set(userId, []);
+    }
+    const notif: Notification = { type, message, timestamp: Date.now() };
+    notifications.get(userId)!.push(notif);
+    bus.emit(Events.NOTIFICATION_SENT, { userId, type, message });
+  }
+
+  // Track which user owns which order
+  bus.on(Events.ORDER_CREATED, (payload: unknown) => {
+    const event = payload as OrderCreatedEvent;
+    orderOwners.set(event.orderId, event.userId);
+    addNotification(event.userId, 'order_created', `Order ${event.orderId} created for $${event.total}`);
+  });
+
+  // Listen for order status changes
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload: unknown) => {
+    const event = payload as OrderStatusChangedEvent;
+    const userId = orderOwners.get(event.orderId);
+    if (userId) {
+      addNotification(userId, 'order_status_changed', `Order ${event.orderId} changed from ${event.previousStatus} to ${event.status}`);
+    }
+  });
+
+  // Listen for payment events
+  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {
+    const event = payload as PaymentProcessedEvent;
+    const userId = orderOwners.get(event.orderId);
+    if (userId) {
+      addNotification(userId, 'payment_processed', `Payment for order ${event.orderId}: ${event.status}`);
+    }
+  });
+
+  return {
+    subscribe(userId: string): void {
+      subscribedUsers.add(userId);
+    },
+
+    getNotifications(userId: string) {
+      return notifications.get(userId) ?? [];
+    },
+  };
+}
