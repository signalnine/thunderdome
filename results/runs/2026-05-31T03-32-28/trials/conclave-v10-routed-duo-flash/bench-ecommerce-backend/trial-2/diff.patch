 from '../src/inventory/index.js';\nimport { createCartService } from '../src/cart/index.js';\nimport { createPricingService } from '../src/pricing/index.js';\nimport { createOrderService } from '../src/orders/index.js';\nimport { createPaymentService } from '../src/payment/index.js';\nimport { createNotificationService } from '../src/notifications/index.js';\nimport { createAnalyticsService } from '../src/analytics/index.js';\n\ndescribe('Catalog Service', () => {\n  let bus: EventBus;\n  let catalog: CatalogService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    catalog = createCatalogService(bus);\n  });\n\n  it('C1: createProduct returns a unique string productId', () => {\n    const id1 = catalog.createProduct('Widget', 9.99, 'gadgets');\n    const id2 = catalog.createProduct('Gadget', 19.99, 'gadgets');\n    expect(id1).toBeTypeOf('string');\n    expect(id1).not.toBe(id2);\n  });\n\n  it('C2: createProduct emits product:created event', () => {\n    catalog.createProduct('Widget', 9.99, 'gadgets');\n    const log = bus.getLog();\n    const event = log.find(e => e.event === Events.PRODUCT_CREATED);\n    expect(event).toBeDefined();\n    const payload = event!.payload as ProductCreatedEvent;\n    expect(payload.productId).toBeTypeOf('string');\n    expect(payload.name).toBe('Widget');\n    expect(payload.price).toBe(9.99);\n    expect(payload.category).toBe('gadgets');\n  });\n\n  it('C3: getProduct returns the correct product', () => {\n    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\n    const product = catalog.getProduct(id);\n    expect(product).toEqual({ id, name: 'Widget', price: 9.99, category: 'gadgets' });\n  });\n\n  it('C4: getProduct with non-existent id returns null', () => {\n    expect(catalog.getProduct('nonexistent')).toBeNull();\n  });\n\n  it('C5: listProducts returns all products', () => {\n    catalog.createProduct('Widget', 9.99, 'gadgets');\n    catalog.createProduct('Gadget', 19.99, 'gadgets');\n    catalog.createProduct('Book', 5.99, 'media');\n    expect(catalog.listProducts()).toHaveLength(3);\n  });\n\n  it('C6: listProducts filters by category', () => {\n    catalog.createProduct('Widget', 9.99, 'gadgets');\n    catalog.createProduct('Gadget', 19.99, 'gadgets');\n    catalog.createProduct('Book', 5.99, 'media');\n    const gadgets = catalog.listProducts('gadgets');\n    expect(gadgets).toHaveLength(2);\n    gadgets.forEach(p => expect(p.category).toBe('gadgets'));\n  });\n\n  it('C7: searchProducts matches name case-insensitively', () => {\n    catalog.createProduct('Widget', 9.99, 'gadgets');\n    catalog.createProduct('Gadget', 19.99, 'gadgets');\n    catalog.createProduct('Book', 5.99, 'media');\n    expect(catalog.searchProducts('widget')).toHaveLength(1);\n    expect(catalog.searchProducts('get')).toHaveLength(2);\n    expect(catalog.searchProducts('xyz')).toHaveLength(0);\n  });\n\n  it('C8: updateProduct partially updates', () => {\n    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\n    catalog.updateProduct(id, { price: 14.99 });\n    const product = catalog.getProduct(id);\n    expect(product!.price).toBe(14.99);\n    expect(product!.name).toBe('Widget');\n    expect(product!.category).toBe('gadgets');\n  });\n\n  it('C9: removeProduct removes and returns true', () => {\n    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\n    const result = catalog.removeProduct(id);\n    expect(result).toBe(true);\n    expect(catalog.getProduct(id)).toBeNull();\n  });\n\n  it('C10: removeProduct with non-existent id returns false', () => {\n    expect(catalog.removeProduct('nonexistent')).toBe(false);\n  });\n});\n\ndescribe('Inventory Service', () => {\n  let bus: EventBus;\n  let inventory: InventoryService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    inventory = createInventoryService(bus);\n  });\n\n  it('I1: setStock sets the stock level', () => {\n    inventory.setStock('prod-1', 10);\n    expect(inventory.getStock('prod-1')).toBe(10);\n  });\n\n  it('I2: setStock emits inventory:updated event', () => {\n    inventory.setStock('prod-1', 10);\n    const log = bus.getLog();\n    const event = log.find(e => e.event === Events.INVENTORY_UPDATED);\n    expect(event).toBeDefined();\n    const payload = event!.payload as InventoryUpdatedEvent;\n    expect(payload.productId).toBe('prod-1');\n    expect(payload.quantity).toBe(10);\n  });\n\n  it('I3: getStock for unset product returns 0', () => {\n    expect(inventory.getStock('unknown')).toBe(0);\n  });\n\n  it('I4: reserve with sufficient stock returns true and reduces stock', () => {\n    inventory.setStock('prod-1', 10);\n    const result = inventory.reserve('prod-1', 3);\n    expect(result).toBe(true);\n    expect(inventory.getStock('prod-1')).toBe(7);\n  });\n\n  it('I5: reserve with insufficient stock returns false', () => {\n    inventory.setStock('prod-1', 2);\n    const result = inventory.reserve('prod-1', 5);\n    expect(result).toBe(false);\n    expect(inventory.getStock('prod-1')).toBe(2);\n  });\n\n  it('I6: release increases stock', () => {\n    inventory.setStock('prod-1', 10);\n    inventory.reserve('prod-1', 3);\n    inventory.release('prod-1', 2);\n    expect(inventory.getStock('prod-1')).toBe(9);\n  });\n\n  it('I7-I8: setStock below threshold emits low_stock alert', () => {\n    inventory.setLowStockThreshold('prod-1', 5);\n    inventory.setStock('prod-1', 3);\n    const log = bus.getLog();\n    const alert = log.find(e => e.event === Events.LOW_STOCK_ALERT);\n    expect(alert).toBeDefined();\n    const payload = alert!.payload as LowStockAlertEvent;\n    expect(payload.productId).toBe('prod-1');\n    expect(payload.currentQuantity).toBe(3);\n    expect(payload.threshold).toBe(5);\n  });\n\n  it('I9: multiple low-stock alerts fire when repeatedly crossing below threshold', () => {\n    inventory.setLowStockThreshold('prod-1', 5);\n    inventory.setStock('prod-1', 3);\n    inventory.setStock('prod-1', 10);  // back above\n    inventory.setStock('prod-1', 2);   // below again\n    const alerts = bus.getLog().filter(e => e.event === Events.LOW_STOCK_ALERT);\n    expect(alerts).toHaveLength(2);\n  });\n\n  it('reserve below threshold emits low_stock alert', () => {\n    inventory.setLowStockThreshold('prod-1', 5);\n    inventory.setStock('prod-1', 10);\n    bus.clear();\n    inventory.reserve('prod-1', 6);\n    const alert = bus.getLog().find(e => e.event === Events.LOW_STOCK_ALERT);\n    expect(alert).toBeDefined();\n  });\n});\n\ndescribe('Cart Service', () => {\n  let bus: EventBus;\n  let cart: CartService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    cart = createCartService(bus);\n  });\n\n  it('CA1: createCart returns unique string cartId', () => {\n    const id1 = cart.createCart('user-1');\n    const id2 = cart.createCart('user-2');\n    expect(id1).toBeTypeOf('string');\n    expect(id1).not.toBe(id2);\n  });\n\n  it('CA2: getCart returns cart with correct structure', () => {\n    const cartId = cart.createCart('user-1');\n    const result = cart.getCart(cartId);\n    expect(result).not.toBeNull();\n    expect(result!.id).toBe(cartId);\n    expect(result!.userId).toBe('user-1');\n    expect(result!.items).toEqual([]);\n  });\n\n  it('CA3: getCart for non-existent id returns null', () => {\n    expect(cart.getCart('nonexistent')).toBeNull();\n  });\n\n  it('CA4: addItem adds item to cart', () => {\n    const cartId = cart.createCart('user-1');\n    cart.addItem(cartId, 'prod-1', 2);\n    const result = cart.getCart(cartId);\n    expect(result!.items).toHaveLength(1);\n    expect(result!.items[0]).toEqual({ productId: 'prod-1', quantity: 2 });\n  });\n\n  it('CA5: adding same productId consolidates quantities', () => {\n    const cartId = cart.createCart('user-1');\n    cart.addItem(cartId, 'prod-1', 2);\n    cart.addItem(cartId, 'prod-1', 3);\n    const result = cart.getCart(cartId);\n    expect(result!.items).toHaveLength(1);\n    expect(result!.items[0].quantity).toBe(5);\n  });\n\n  it('CA6: removeItem removes item line', () => {\n    const cartId = cart.createCart('user-1');\n    cart.addItem(cartId, 'prod-1', 2);\n    cart.addItem(cartId, 'prod-2', 1);\n    cart.removeItem(cartId, 'prod-1');\n    const result = cart.getCart(cartId);\n    expect(result!.items).toHaveLength(1);\n    expect(result!.items[0].productId).toBe('prod-2');\n  });\n\n  it('CA7: updateQuantity updates quantity', () => {\n    const cartId = cart.createCart('user-1');\n    cart.addItem(cartId, 'prod-1', 2);\n    cart.updateQuantity(cartId, 'prod-1', 5);\n    const result = cart.getCart(cartId);\n    expect(result!.items[0].quantity).toBe(5);\n  });\n\n  it('CA8: updateQuantity to 0 removes item', () => {\n    const cartId = cart.createCart('user-1');\n    cart.addItem(cartId, 'prod-1', 2);\n    cart.updateQuantity(cartId, 'prod-1', 0);\n    const result = cart.getCart(cartId);\n    expect(result!.items).toHaveLength(0);\n  });\n\n  it('CA9: clearCart empties items', () => {\n    const cartId = cart.createCart('user-1');\n    cart.addItem(cartId, 'prod-1', 2);\n    cart.addItem(cartId, 'prod-2', 3);\n    cart.clearCart(cartId);\n    const result = cart.getCart(cartId);\n    expect(result!.items).toEqual([]);\n  });\n\n  it('CA10: cart operations emit cart:updated event', () => {\n    const cartId = cart.createCart('user-1');\n    bus.clear();\n    cart.addItem(cartId, 'prod-1', 2);\n    const log = bus.getLog();\n    const event = log.find(e => e.event === Events.CART_UPDATED);\n    expect(event).toBeDefined();\n    const payload = event!.payload as CartUpdatedEvent;\n    expect(payload.cartId).toBe(cartId);\n    expect(payload.items).toContainEqual({ productId: 'prod-1', quantity: 2 });\n  });\n});\n\ndescribe('Pricing Service', () => {\n  let bus: EventBus;\n  let pricing: PricingService;\n  let catalog: CatalogService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    pricing = createPricingService(bus);\n    catalog = createCatalogService(bus);\n  });\n\n  it('P1: calculateTotal computes correct subtotal', () => {\n    const result = pricing.calculateTotal([\n      { productId: 'p1', quantity: 2, price: 10 },\n      { productId: 'p2', quantity: 3, price: 5 },\n    ]);\n    expect(result.subtotal).toBe(35); // 2*10 + 3*5\n  });\n\n  it('P2-P3: Tax is 10% of subtotal (after discount), total = subtotal - discount + tax', () => {\n    const result = pricing.calculateTotal([\n      { productId: 'p1', quantity: 2, price: 10 },\n    ]);\n    expect(result.subtotal).toBe(20);\n    expect(result.discount).toBe(0);\n    expect(result.tax).toBe(2); // 10% of 20\n    expect(result.total).toBe(22); // 20 + 2\n  });\n\n  it('P4: addDiscountCode and apply discount', () => {\n    pricing.addDiscountCode('SAVE10', 10);\n    const result = pricing.calculateTotal([\n      { productId: 'p1', quantity: 2, price: 10 },\n    ], 'SAVE10');\n    expect(result.subtotal).toBe(20);\n    expect(result.discount).toBe(2); // 10% of 20\n    expect(result.tax).toBe(1.8); // 10% of (20-2)\n    expect(result.total).toBe(19.8); // 20 - 2 + 1.8\n  });\n\n  it('P5: Unknown discount code gives zero discount', () => {\n    const result = pricing.calculateTotal([\n      { productId: 'p1', quantity: 1, price: 100 },\n    ], 'INVALID');\n    expect(result.discount).toBe(0);\n    expect(result.tax).toBe(10);\n    expect(result.total).toBe(110);\n  });\n\n  it('P6-P7: getPrice returns price from product:created event', () => {\n    catalog.createProduct('Widget', 9.99, 'gadgets');\n    // Pricing service listens for product:created and tracks prices\n    expect(pricing.getPrice(catalog.listProducts()[0].id)).toBe(9.99);\n  });\n\n  it('P8: Empty items => all zeros', () => {\n    const result = pricing.calculateTotal([]);\n    expect(result).toEqual({ subtotal: 0, discount: 0, tax: 0, total: 0 });\n  });\n});\n\ndescribe('Orders Service', () => {\n  let bus: EventBus;\n  let orders: OrderService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    orders = createOrderService(bus);\n  });\n\n  it('O1-O2-O3: createOrder returns id, status is pending, emits event', () => {\n    const orderId = orders.createOrder('user-1', 'cart-1', 59.99);\n    expect(orderId).toBeTypeOf('string');\n\n    const order = orders.getOrder(orderId);\n    expect(order).not.toBeNull();\n    expect(order!.status).toBe(OrderStatus.PENDING);\n    expect(order!.userId).toBe('user-1');\n    expect(order!.total).toBe(59.99);\n\n    const log = bus.getLog();\n    const event = log.find(e => e.event === Events.ORDER_CREATED)!.payload as OrderCreatedEvent;\n    expect(event.orderId).toBe(orderId);\n    expect(event.userId).toBe('user-1');\n    expect(event.cartId).toBe('cart-1');\n    expect(event.total).toBe(59.99);\n  });\n\n  it('O4: getOrder returns correct structure', () => {\n    const orderId = orders.createOrder('user-1', 'cart-1', 29.99);\n    const result = orders.getOrder(orderId);\n    expect(result).toEqual({\n      id: orderId,\n      userId: 'user-1',\n      status: OrderStatus.PENDING,\n      total: 29.99,\n    });\n  });\n\n  it('O5: getOrder for non-existent id returns null', () => {\n    expect(orders.getOrder('nonexistent')).toBeNull();\n  });\n\n  it('O6-O7: updateStatus changes status and emits event with previousStatus', () => {\n    const orderId = orders.createOrder('user-1', 'cart-1', 49.99);\n    bus.clear();\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.CONFIRMED);\n\n    const event = bus.getLog().find(e => e.event === Events.ORDER_STATUS_CHANGED)!.payload as OrderStatusChangedEvent;\n    expect(event.orderId).toBe(orderId);\n    expect(event.status).toBe(OrderStatus.CONFIRMED);\n    expect(event.previousStatus).toBe(OrderStatus.PENDING);\n  });\n\n  it('O8: listOrders filters by userId', () => {\n    orders.createOrder('user-1', 'cart-1', 10);\n    orders.createOrder('user-1', 'cart-2', 20);\n    orders.createOrder('user-2', 'cart-3', 30);\n\n    const user1Orders = orders.listOrders('user-1');\n    expect(user1Orders).toHaveLength(2);\n    user1Orders.forEach(o => expect(o.id).toBeTypeOf('string'));\n  });\n\n  it('O9: can cancel from any state', () => {\n    const orderId = orders.createOrder('user-1', 'cart-1', 100);\n    orders.updateStatus(orderId, OrderStatus.CANCELLED);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.CANCELLED);\n  });\n});\n\ndescribe('Payment Service', () => {\n  let bus: EventBus;\n  let payment: PaymentService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n  });\n\n  it('PA1-PA2: processPayment with default options succeeds and emits event', async () => {\n    payment = createPaymentService(bus);\n    const result = await payment.processPayment('order-1', 100);\n    expect(result.status).toBe(PaymentStatus.SUCCESS);\n    expect(result.transactionId).toBeTypeOf('string');\n\n    const event = bus.getLog().find(e => e.event === Events.PAYMENT_PROCESSED)!.payload as PaymentProcessedEvent;\n    expect(event.orderId).toBe('order-1');\n    expect(event.status).toBe(PaymentStatus.SUCCESS);\n    expect(event.transactionId).toBe(result.transactionId);\n  });\n\n  it('PA3: processPayment with failure mode', async () => {\n    payment = createPaymentService(bus, { mode: 'fail' });\n    const result = await payment.processPayment('order-2', 100);\n    expect(result.status).toBe(PaymentStatus.FAILED);\n    expect(result.transactionId).toBeUndefined();\n    expect(result.error).toBeTypeOf('string');\n  });\n\n  it('PA4: processPayment with timeout mode', async () => {\n    payment = createPaymentService(bus, { mode: 'timeout' });\n    const result = await payment.processPayment('order-3', 100);\n    expect(result.status).toBe(PaymentStatus.TIMEOUT);\n    expect(result.transactionId).toBeUndefined();\n  });\n\n  it('PA5: refund for known transaction returns true', async () => {\n    payment = createPaymentService(bus);\n    const result = await payment.processPayment('order-1', 50);\n    const refundResult = await payment.refund(result.transactionId!);\n    expect(refundResult).toBe(true);\n  });\n\n  it('PA6: refund for unknown transaction returns false', async () => {\n    payment = createPaymentService(bus);\n    const refundResult = await payment.refund('unknown-tx');\n    expect(refundResult).toBe(false);\n  });\n});\n\ndescribe('Notifications Service', () => {\n  let bus: EventBus;\n  let notifications: NotificationService;\n  let orders: OrderService;\n  let payment: PaymentService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    notifications = createNotificationService(bus);\n    orders = createOrderService(bus);\n    payment = createPaymentService(bus);\n  });\n\n  it('N1: subscribe registers user, getNotifications returns empty initially', () => {\n    notifications.subscribe('user-1');\n    const msgs = notifications.getNotifications('user-1');\n    expect(msgs).toEqual([]);\n  });\n\n  it('N2: order created for subscribed user generates notification', () => {\n    notifications.subscribe('user-1');\n    const orderId = orders.createOrder('user-1', 'cart-1', 49.99);\n    const msgs = notifications.getNotifications('user-1');\n    expect(msgs.length).toBeGreaterThanOrEqual(1);\n    expect(msgs.some(m => m.type === 'order_created')).toBe(true);\n  });\n\n  it('N3: order status change for subscribed user generates notification', () => {\n    notifications.subscribe('user-1');\n    const orderId = orders.createOrder('user-1', 'cart-1', 49.99);\n    // Clear first notification, then update status\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n    const msgs = notifications.getNotifications('user-1');\n    expect(msgs.some(m => m.type === 'order_status_changed')).toBe(true);\n  });\n\n  it('N4: payment processed for subscribed user generates notification', async () => {\n    notifications.subscribe('user-1');\n    const orderId = orders.createOrder('user-1', 'cart-1', 49.99);\n    await payment.processPayment(orderId, 49.99);\n    const msgs = notifications.getNotifications('user-1');\n    expect(msgs.some(m => m.type === 'payment_processed')).toBe(true);\n  });\n\n  it('N5: non-subscribed user gets empty notifications', () => {\n    const orderId = orders.createOrder('user-2', 'cart-2', 10);\n    const msgs = notifications.getNotifications('user-2');\n    expect(msgs).toEqual([]);\n  });\n\n  it('N6: notification:sent event emitted', () => {\n    notifications.subscribe('user-1');\n    orders.createOrder('user-1', 'cart-1', 49.99);\n    const event = bus.getLog().find(e => e.event === Events.NOTIFICATION_SENT)!.payload as NotificationSentEvent;\n    expect(event.userId).toBe('user-1');\n    expect(event.type).toBeTypeOf('string');\n    expect(event.message).toBeTypeOf('string');\n  });\n});\n\ndescribe('Analytics Service', () => {\n  let bus: EventBus;\n  let analytics: AnalyticsService;\n  let catalog: CatalogService;\n  let cart: CartService;\n  let orders: OrderService;\n  let payment: PaymentService;\n  let inventory: InventoryService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    analytics = createAnalyticsService(bus);\n    catalog = createCatalogService(bus);\n    inventory = createInventoryService(bus);\n    cart = createCartService(bus);\n    orders = createOrderService(bus);\n    payment = createPaymentService(bus);\n  });\n\n  it('A1: getEventCount returns count by type', () => {\n    catalog.createProduct('Widget', 9.99, 'gadgets');\n    catalog.createProduct('Gadget', 19.99, 'gadgets');\n    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBe(2);\n    expect(analytics.getEventCount('nonexistent')).toBe(0);\n  });\n\n  it('A2-A3: getRevenue returns sum of successful payment totals', async () => {\n    // Create products so pricing has prices\n    const p1 = catalog.createProduct('Item1', 10, 'cat');\n    const p2 = catalog.createProduct('Item2', 20, 'cat');\n\n    const cartId = cart.createCart('user-1');\n    cart.addItem(cartId, p1, 1)