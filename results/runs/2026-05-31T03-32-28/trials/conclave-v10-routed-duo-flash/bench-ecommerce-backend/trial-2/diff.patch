@@ -0,0 +1,49 @@
+import { EventBus } from '../bus.js';
+import { Events, PaymentStatus } from '../types.js';
+import type { PaymentService } from '../types.js';
+import { v4 as uuid } from 'uuid';
+
+interface PaymentOptions {
+  mode?: 'success' | 'fail' | 'timeout';
+  delayMs?: number;
+}
+
+export function createPaymentService(bus: EventBus, options?: PaymentOptions): PaymentService {
+  const mode = options?.mode ?? 'success';
+  const delayMs = options?.delayMs ?? 10;
+  const transactions = new Set<string>();
+
+  return {
+    async processPayment(orderId: string, _amount: number) {
+      await new Promise(resolve => setTimeout(resolve, delayMs));
+
+      if (mode === 'timeout') {
+        const result = { status: PaymentStatus.TIMEOUT as const };
+        bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: PaymentStatus.TIMEOUT });
+        return result;
+      }
+
+      if (mode === 'fail') {
+        const result = { status: PaymentStatus.FAILED as const, error: 'Payment declined' };
+        bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: PaymentStatus.FAILED, error: 'Payment declined' });
+        return result;
+      }
+
+      // success
+      const transactionId = uuid();
+      transactions.add(transactionId);
+      const result = { status: PaymentStatus.SUCCESS as const, transactionId };
+      bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: PaymentStatus.SUCCESS, transactionId });
+      return result;
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      await new Promise(resolve => setTimeout(resolve, delayMs));
+      if (transactions.has(transactionId)) {
+        transactions.delete(transactionId);
+        return true;
+      }
+      return false;
+    },
+  };
+}
