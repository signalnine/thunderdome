ber>();\n\n  // Listen for ALL events to count by type\n  // We intercept before the event bus by wrapping emit? No, we can listen per event.\n  // Instead, let's listen to individual events we care about for counting.\n  // For getEventCount(eventType), we need to track arbitrary event types.\n  // We'll listen on the bus for all events by hooking into each known event type.\n\n  function incrementCount(eventType: string): void {\n    eventCounts.set(eventType, (eventCounts.get(eventType) ?? 0) + 1);\n  }\n\n  const knownEvents = Object.values(Events);\n  for (const evt of knownEvents) {\n    bus.on(evt, () => {\n      incrementCount(evt);\n    });\n  }\n\n  // Track unique carts\n  bus.on(Events.CART_UPDATED, (payload: unknown) => {\n    const event = payload as CartUpdatedEvent;\n    uniqueCarts.add(event.cartId);\n\n    // Track product quantities for top products\n    for (const item of event.items) {\n      const current = productQuantities.get(item.productId) ?? 0;\n      productQuantities.set(item.productId, current + item.quantity);\n    }\n  });\n\n  // Track orders and their totals; also track carts from orders\n  bus.on(Events.ORDER_CREATED, (payload: unknown) => {\n    const event = payload as OrderCreatedEvent;\n    orderCount++;\n    orderTotals.set(event.orderId, event.total);\n    uniqueCarts.add(event.cartId);\n  });\n\n  // Track revenue from successful payments\n  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {\n    const event = payload as PaymentProcessedEvent;\n    if (event.status === PaymentStatus.SUCCESS) {\n      const total = orderTotals.get(event.orderId) ?? 0;\n      revenue += total;\n    }\n  });\n\n  return {\n    getEventCount(eventType: string): number {\n      return eventCounts.get(eventType) ?? 0;\n    },\n\n    getRevenue(): number {\n      return revenue;\n    },\n\n    getConversionRate(): number {\n      if (uniqueCarts.size === 0) return 0;\n      return orderCount / uniqueCarts.size;\n    },\n\n    getTopProducts(limit: number) {\n      return Array.from(productQuantities.entries())\n        .map(([productId, count]) => ({ productId, count }))\n        .sort((a, b) => b.count - a.count)\n        .slice(0, limit);\n    },\n  };\n}\n","structuredPatch":[{"oldStart":34,"oldLines":13,"newStart":34,"newLines":17,"lines":[" ","   // Track unique carts","   bus.on(Events.CART_UPDATED, (payload: unknown) => {","-    const event = payload as CartUpdatedEvent;","-    uniqueCarts.add(event.cartId);","+    try {","+      const event = payload as CartUpdatedEvent;","+      uniqueCarts.add(event.cartId);"," ","-    // Track product quantities for top products","-    for (const item of event.items) {","-      const current = productQuantities.get(item.productId) ?? 0;","-      productQuantities.set(item.productId, current + item.quantity);","+      // Track product quantities for top products","+      for (const item of event.items) {","+        const current = productQuantities.get(item.productId) ?? 0;","+        productQuantities.set(item.productId, current + item.quantity);","+      }","+    } catch (e) {","+      console.error('CART_UPDATED handler error:', e);","     }","   });"," "]}],"userModified":false,"replaceAll":false}}
