+
+  it('CA7: updateQuantity updates quantity', () => {
+    const cartId = cart.createCart('user-1');
+    cart.addItem(cartId, 'prod-1', 2);
+    cart.updateQuantity(cartId, 'prod-1', 5);
+    const result = cart.getCart(cartId);
+    expect(result!.items[0].quantity).toBe(5);
