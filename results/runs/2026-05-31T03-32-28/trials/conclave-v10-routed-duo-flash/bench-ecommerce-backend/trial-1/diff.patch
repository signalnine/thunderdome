diff --git a/src/analytics/index.ts b/src/analytics/index.ts
new file mode 100644
index 0000000..7d03a11
--- /dev/null
+++ b/src/analytics/index.ts
@@ -0,0 +1,91 @@
+import { EventBus } from '../bus.js';
+import {
+  AnalyticsService,
+  CartUpdatedEvent,
+  Events,
+  OrderCreatedEvent,
+  PaymentProcessedEvent,
+  PaymentStatus,
+} from '../types.js';
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const orderTotalByOrderId = new Map<string, number>();
+  const cartItemsByCartId = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const productOrderCounts = new Map<string, number>();
+  const uniqueCarts = new Set<string>();
+  let orderCount = 0;
+  let revenue = 0;
+
+  function countEvent(eventType: string): void {
+    eventCounts.set(eventType, (eventCounts.get(eventType) ?? 0) + 1);
+  }
+
+  // Single combined handler per event type so all work runs synchronously
+  // within bus.emit (which awaits handlers in a loop — only the first handler
+  // per event runs before the first yield).
+
+  bus.on(Events.PRODUCT_CREATED, () => { countEvent(Events.PRODUCT_CREATED); });
+  bus.on(Events.INVENTORY_UPDATED, () => { countEvent(Events.INVENTORY_UPDATED); });
+  bus.on(Events.LOW_STOCK_ALERT, () => { countEvent(Events.LOW_STOCK_ALERT); });
+  bus.on(Events.PRICE_CALCULATED, () => { countEvent(Events.PRICE_CALCULATED); });
+  bus.on(Events.ORDER_STATUS_CHANGED, () => { countEvent(Events.ORDER_STATUS_CHANGED); });
+  bus.on(Events.NOTIFICATION_SENT, () => { countEvent(Events.NOTIFICATION_SENT); });
+
+  // Combine counting with domain logic for events that need both
+  bus.on(Events.CART_UPDATED, (payload: unknown) => {
+    countEvent(Events.CART_UPDATED);
+    const event = payload as CartUpdatedEvent;
+    uniqueCarts.add(event.cartId);
+    cartItemsByCartId.set(event.cartId, event.items);
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload: unknown) => {
+    countEvent(Events.ORDER_CREATED);
+    const event = payload as OrderCreatedEvent;
+    orderCount++;
+    orderTotalByOrderId.set(event.orderId, event.total);
+
+    // Track products ordered from the cart
+    const cartItems = cartItemsByCartId.get(event.cartId);
+    if (cartItems) {
+      for (const item of cartItems) {
+        const current = productOrderCounts.get(item.productId) ?? 0;
+        productOrderCounts.set(item.productId, current + item.quantity);
+      }
+    }
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {
+    countEvent(Events.PAYMENT_PROCESSED);
+    const event = payload as PaymentProcessedEvent;
+    if (event.status === PaymentStatus.SUCCESS) {
+      const total = orderTotalByOrderId.get(event.orderId);
+      if (total !== undefined) {
+        revenue += total;
+      }
+    }
+  });
+
+  return {
+    getEventCount(eventType: string): number {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue(): number {
+      return revenue;
+    },
+
+    getConversionRate(): number {
+      if (uniqueCarts.size === 0) return 0;
+      return orderCount / uniqueCarts.size;
+    },
+
+    getTopProducts(limit: number): Array<{ productId: string; count: number }> {
+      return Array.from(productOrderCounts.entries())
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count)
+        .slice(0, limit);
+    },
+  };
+}
diff --git a/src/cart/index.ts b/src/cart/index.ts
new file mode 100644
index 0000000..a2fd369
--- /dev/null
+++ b/src/cart/index.ts
@@ -0,0 +1,72 @@
+import { EventBus } from '../bus.js';
+import { CartService, CartUpdatedEvent, Events } from '../types.js';
+import { v4 as uuid } from 'uuid';
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: Map<string, number>; // productId -> quantity
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  function emitCartUpdate(cart: Cart): void {
+    const items = Array.from(cart.items.entries()).map(([productId, quantity]) => ({ productId, quantity }));
+    const payload: CartUpdatedEvent = { cartId: cart.id, userId: cart.userId, items };
+    bus.emit(Events.CART_UPDATED, payload);
+  }
+
+  return {
+    createCart(userId: string): string {
+      const id = uuid();
+      carts.set(id, { id, userId, items: new Map() });
+      emitCartUpdate(carts.get(id)!);
+      return id;
+    },
+
+    addItem(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        throw new Error(`Cart ${cartId} not found`);
+      }
+      const current = cart.items.get(productId) ?? 0;
+      cart.items.set(productId, current + quantity);
+      emitCartUpdate(cart);
+    },
+
+    removeItem(cartId: string, productId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        throw new Error(`Cart ${cartId} not found`);
+      }
+      cart.items.delete(productId);
+      emitCartUpdate(cart);
+    },
+
+    getCart(cartId: string) {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      const items = Array.from(cart.items.entries()).map(([productId, quantity]) => ({ productId, quantity }));
+      return { id: cart.id, userId: cart.userId, items };
+    },
+
+    clearCart(cartId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        throw new Error(`Cart ${cartId} not found`);
+      }
+      cart.items.clear();
+      emitCartUpdate(cart);
+    },
+
+    updateQuantity(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        throw new Error(`Cart ${cartId} not found`);
+      }
+      cart.items.set(productId, quantity);
+      emitCartUpdate(cart);
+    },
+  };
+}
