+++ b/src/payment/index.ts
@@ -0,0 +1,53 @@
+import { EventBus } from '../bus.js';
+import { Events, PaymentProcessedEvent, PaymentService, PaymentStatus } from '../types.js';
+import { v4 as uuid } from 'uuid';
+
+export interface PaymentSimulationOptions {
+  mode?: 'success' | 'failure' | 'timeout';
+  delayMs?: number;
+}
+
+export function createPaymentService(bus: EventBus, options?: PaymentSimulationOptions): PaymentService {
+  const config = {
+    mode: options?.mode ?? 'success' as 'success' | 'failure' | 'timeout',
+    delayMs: options?.delayMs ?? 50,
+  };
+
+  const transactions = new Map<string, { orderId: string; amount: number }>();
+
+  async function simulatePayment(orderId: string, amount: number): Promise<{ status: PaymentStatus; transactionId?: string; error?: string }> {
+    await new Promise(resolve => setTimeout(resolve, config.delayMs));
+
+    if (config.mode === 'failure') {
+      return { status: PaymentStatus.FAILED, error: 'Payment failed' };
+    }
+    if (config.mode === 'timeout') {
+      return { status: PaymentStatus.TIMEOUT, error: 'Payment timed out' };
+    }
+
+    // success mode
+    const transactionId = uuid();
+    transactions.set(transactionId, { orderId, amount });
+    return { status: PaymentStatus.SUCCESS, transactionId };
+  }
+
+  return {
+    async processPayment(orderId: string, amount: number) {
+      const result = await simulatePayment(orderId, amount);
+      const payload: PaymentProcessedEvent = {
+        orderId,
+        status: result.status,
+        transactionId: result.transactionId,
+        error: result.error,
+      };
+      bus.emit(Events.PAYMENT_PROCESSED, payload);
+      return result;
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      const txn = transactions.get(transactionId);
+      if (!txn) return false;
+      return true;
+    },
+  };
+}
