@@ -0,0 +1,59 @@
+import { EventBus } from '../bus.js';
+import { Events, OrderCreatedEvent, OrderService, OrderStatus, OrderStatusChangedEvent } from '../types.js';
+import { v4 as uuid } from 'uuid';
+
+interface Order {
+  id: string;
+  userId: string;
+  status: OrderStatus;
+  total: number;
+}
+
+const VALID_TRANSITIONS: Record<OrderStatus, OrderStatus[]> = {
+  [OrderStatus.PENDING]: [OrderStatus.CONFIRMED, OrderStatus.CANCELLED],
+  [OrderStatus.CONFIRMED]: [OrderStatus.SHIPPED],
+  [OrderStatus.SHIPPED]: [OrderStatus.DELIVERED],
+  [OrderStatus.DELIVERED]: [],
+  [OrderStatus.CANCELLED]: [],
+};
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, Order>();
+
+  return {
+    createOrder(userId: string, cartId: string, total: number): string {
+      const id = uuid();
+      orders.set(id, { id, userId, status: OrderStatus.PENDING, total });
+      const createdPayload: OrderCreatedEvent = { orderId: id, userId, cartId, total };
+      bus.emit(Events.ORDER_CREATED, createdPayload);
+      return id;
+    },
+
+    getOrder(orderId: string) {
+      const order = orders.get(orderId);
+      if (!order) return null;
+      return { id: order.id, userId: order.userId, status: order.status, total: order.total };
+    },
+
+    updateStatus(orderId: string, status: OrderStatus): void {
+      const order = orders.get(orderId);
+      if (!order) {
+        throw new Error(`Order ${orderId} not found`);
+      }
+      const allowed = VALID_TRANSITIONS[order.status];
+      if (!allowed.includes(status)) {
+        throw new Error(`Cannot transition order ${orderId} from ${order.status} to ${status}`);
+      }
+      const previousStatus = order.status;
+      order.status = status;
+      const payload: OrderStatusChangedEvent = { orderId, status, previousStatus };
+      bus.emit(Events.ORDER_STATUS_CHANGED, payload);
+    },
+
+    listOrders(userId: string) {
+      return Array.from(orders.values())
+        .filter(o => o.userId === userId)
+        .map(o => ({ id: o.id, status: o.status, total: o.total }));
+    },
+  };
+}
