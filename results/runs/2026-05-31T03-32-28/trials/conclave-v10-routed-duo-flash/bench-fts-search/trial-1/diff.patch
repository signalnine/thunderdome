+  // Create FTS5 virtual table for full-text search (standalone, no content=)
+  // NOTE: We cannot use the FTS5 delete mechanism due to a SQLite build issue,
+  // so we rebuild the index on updates and deletes.
+  db.exec(`
+    CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts USING fts5(
+      title, body
+    )
+  `);
+
+  // Triggers to keep FTS index in sync with notes table
+  // On insert: simply add the new row to the FTS index
+  db.exec(`
+    CREATE TRIGGER IF NOT EXISTS notes_ai AFTER INSERT ON notes BEGIN
+      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);
+    END
+  `);
+
+  // On delete: rebuild the entire FTS index from the notes table
+  // (avoids broken FTS5 delete mechanism in this SQLite build)
+  db.exec(`
+    CREATE TRIGGER IF NOT EXISTS notes_ad AFTER DELETE ON notes BEGIN
+      DELETE FROM notes_fts;
+      INSERT INTO notes_fts(rowid, title, body) SELECT id, title, body FROM notes;
+    END
+  `);
+
+  // On update: rebuild the entire FTS index from the notes table
+  db.exec(`
+    CREATE TRIGGER IF NOT EXISTS notes_au AFTER UPDATE ON notes BEGIN
+      DELETE FROM notes_fts;
+      INSERT INTO notes_fts(rowid, title, body) SELECT id, title, body FROM notes;
+    END
+  `);
+
