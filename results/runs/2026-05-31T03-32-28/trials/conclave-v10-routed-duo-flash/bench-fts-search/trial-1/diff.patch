+/**
+ * Build a safe FTS5 query from user input.
+ * - If the input is already a double-quoted phrase, pass it through.
+ * - Otherwise, quote each term individually to prevent FTS5 syntax errors
+ *   from special characters (e.g., &, <, >, +, /).
+ */
+function buildFtsQuery(input: string): string {
+  const trimmed = input.trim();
+  // Already a phrase query — pass through as-is
+  if (trimmed.startsWith('"') && trimmed.endsWith('"') && trimmed.length >= 2) {
+    return trimmed;
+  }
+  // Quote each whitespace-separated term
+  return trimmed
+    .split(/\s+/)
+    .filter(Boolean)
+    .map(term => `"${term.replace(/"/g, '""')}"`)
+    .join(' ');
+}
