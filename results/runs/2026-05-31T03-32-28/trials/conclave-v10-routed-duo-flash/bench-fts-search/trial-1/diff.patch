+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_rxUQiYfyKO7gcmFaQJsK6917","type":"tool_result","content":"1\timport { Router, Request, Response, NextFunction } from 'express';\n2\timport Database from 'better-sqlite3';\n3\timport { Note, NoteInput, SearchResult, SuggestResult } from './models.js';\n4\timport { NotFoundError, ValidationError } from './errors.js';\n5\t\n6\t/**\n7\t * Build a safe FTS5 query from user input.\n8\t * - If the input is already a double-quoted phrase, pass it through.\n9\t * - Otherwise, quote each term individually to prevent FTS5 syntax errors\n10\t *   from special characters (e.g., &, <, >, +, /).\n11\t */\n12\tfunction buildFtsQuery(input: string): string {\n13\t  const trimmed = input.trim();\n14\t  // Already a phrase query — pass through as-is\n15\t  if (trimmed.startsWith('\"') && trimmed.endsWith('\"') && trimmed.length >= 2) {\n16\t    return trimmed;\n17\t  }\n18\t  // Quote each whitespace-separated term\n19\t  return trimmed\n20\t    .split(/\\s+/)\n21\t    .filter(Boolean)\n22\t    .map(term => `\"${term.replace(/\"/g, '\"\"')}\"`)\n23\t    .join(' ');\n24\t}\n25\t\n26\texport function createRoutes(db: Database.Database): Router {\n27\t  const router = Router();\n28\t\n29\t  // GET /notes - List all notes (with optional tag filter)\n30\t  router.get('/notes', (req: Request, res: Response, next: NextFunction) => {\n31\t    try {\n32\t      const tag = req.query.tag as string | undefined;\n33\t\n34\t      let notes: Note[];\n35\t      if (tag) {\n36\t        // Use a join with json_each for tag filtering\n37\t        const tagStmt = db.prepare(`\n38\t          SELECT DISTINCT notes.* FROM notes, json_each(notes.tags)\n39\t          WHERE json_each.value = ?\n40\t          ORDER BY created_at DESC\n41\t        `);\n42\t        notes = tagStmt.all(tag) as Note[];\n43\t      } else {\n44\t        const stmt = db.prepare('SELECT * FROM notes ORDER BY created_at DESC');\n45\t        notes = stmt.all() as