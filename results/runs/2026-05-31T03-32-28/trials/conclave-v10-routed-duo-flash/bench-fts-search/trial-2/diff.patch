+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_SNZZqgMUJmhjdKLJVOO57186","type":"tool_result","content":"1\timport { Router, Request, Response, NextFunction } from 'express';\n2\timport Database from 'better-sqlite3';\n3\timport { Note, NoteInput, SearchResult, SuggestResult } from './models.js';\n4\timport { NotFoundError, ValidationError } from './errors.js';\n5\t\n6\texport function createRoutes(db: Database.Database): Router {\n7\t  const router = Router();\n8\t\n9\t  // GET /notes - List all notes (with optional tag filter)\n10\t  router.get('/notes', (req: Request, res: Response, next: NextFunction) => {\n11\t    try {\n12\t      const tag = req.query.tag as string | undefined;\n13\t\n14\t      let notes: Note[];\n15\t      if (tag) {\n16\t        // Use a join with json_each for tag filtering\n17\t        const tagStmt = db.prepare(`\n18\t          SELECT DISTINCT notes.* FROM notes, json_each(notes.tags)\n19\t          WHERE json_each.value = ?\n20\t          ORDER BY created_at DESC\n21\t        `);\n22\t        notes = tagStmt.all(tag) as Note[];\n23\t      } else {\n24\t        const stmt = db.prepare('SELECT * FROM notes ORDER BY created_at DESC');\n25\t        notes = stmt.all() as Note[];\n26\t      }\n27\t\n28\t      res.json({ notes });\n29\t    } catch (err) {\n30\t      next(err);\n31\t    }\n32\t  });\n33\t\n34\t  // GET /notes/search - Full-text search\n35\t  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {\n36\t    try {\n37\t      const q = req.query.q as string | undefined;\n38\t      if (!q || q.trim() === '') {\n39\t        throw new ValidationError('Query parameter q is required');\n40\t      }\n41\t\n42\t      const page = Math.max(1, parseInt(req.query.page as string) || 1);\n43\t      const perPage = 20;\n44\t      const offset = (page - 1) * perPage;\n45\t      const query = q.trim();\n46\t\n47\t      try {\n48\t        // Count total matching results\n49\t        const countStmt = db.prepare(\n50\t          'SELECT COUNT(*) as total FROM notes_fts WHERE notes_fts MATCH ?'\n51\t        );\n52\t        const { total } = countStmt.get(query) as { total: number };\n53\t\n54\t        // Get paginated results with BM25 ranking and snippet highlighting\n55\t        const searchStmt = db.prepare(`\n56\t          SELECT\n57\t            notes.id,\n58\t            notes.title,\n59\t            snippet(notes_fts, -1, '<mark>', '</mark>', '...', 32) as snippet,\n60\t            bm25(notes_fts) as rank\n61\t          FROM notes_fts\n62\t          JOIN notes ON notes_fts.rowid = notes.id\n63\t          WHERE notes_fts MATCH ?\n64\t          ORDER BY rank\n65\t          LIMIT ? OFFSET ?\n66\t        `);\n67\t        const results = searchStmt.all(query, perPage, offset) as SearchResult[];\n68\t\n69\t        res.json({ results, total, page, perPage });\n70\t      } catch {\n71\t        // If FTS5 query fails (e.g., special chars causing syntax errors),\n72\t        // return empty results gracefully\n73\t        res.json({ results: [], total: 0, page, perPage });\n74\t      }\n75\t    } catch (err) {\n76\t      next(err);\n77\t    }\n78\t  });\n79\t\n80\t  // GET /notes/search/suggest - Autocomplete suggestion\n81\t  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {\n82\t    try {\n83\t      const q = req.query.q as string | undefined;\n84\t      if (!q || q.trim() === '') {\n85\t        throw new ValidationError('Query parameter q is required');\n86\t      }\n87\t\n88\t      const prefix = q.trim();\n89\t      // Sanitize prefix for FTS5: keep alphanumeric, spaces, apostrophes\n90\t      const sanitized = prefix.replace(/[^\\w\\s']/g, ' ').replace(/\\s+/g, ' ').trim();\n91\t\n92\t      try {\n93\t        const suggestStmt = db.prepare(`\n94\t          SELECT DISTINCT notes.id, notes.title\n95\t          FROM notes_fts\n96\t          JOIN notes ON notes_fts.rowid = notes.id\n97\t          WHERE notes_fts MATCH