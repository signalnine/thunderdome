M notes_fts WHERE rowid = old.id;\n      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);\n    END\n  `);","originalFile":"import Database from 'better-sqlite3';\n\nexport function createDatabase(path?: string): Database.Database {\n  const db = path ? new Database(path) : new Database(':memory:');\n\n  db.pragma('journal_mode = WAL');\n  db.pragma('foreign_keys = ON');\n\n  // Create notes table\n  db.exec(`\n    CREATE TABLE IF NOT EXISTS notes (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      title TEXT NOT NULL,\n      body TEXT NOT NULL,\n      tags TEXT DEFAULT '[]',\n      created_at TEXT DEFAULT (datetime('now')),\n      updated_at TEXT DEFAULT (datetime('now'))\n    )\n  `);\n\n  // Create FTS5 virtual table for full-text search\n  db.exec(`\n    CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts USING fts5(\n      title, body, content=notes, content_rowid=id\n    )\n  `);\n\n  // Triggers to keep FTS index in sync\n  db.exec(`\n    CREATE TRIGGER IF NOT EXISTS notes_ai AFTER INSERT ON notes BEGIN\n      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);\n    END\n  `);\n\n  db.exec(`\n    CREATE TRIGGER IF NOT EXISTS notes_ad AFTER DELETE ON notes BEGIN\n      INSERT INTO notes_fts(notes_fts, rowid) VALUES('delete', old.id);\n    END\n  `);\n\n  db.exec(`\n    CREATE TRIGGER IF NOT EXISTS notes_au AFTER UPDATE ON notes BEGIN\n      INSERT INTO notes_fts(notes_fts, rowid) VALUES('delete', old.id);\n      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);\n    END\n  `);\n\n  return db;\n}\n\nexport function seedDatabase(db: Database.Database): void {\n  const insert = db.prepare(`\n    INSERT INTO notes (title, body, tags) VALUES (?, ?, ?)\n  `);\n\n  const notes = getSeedNotes();\n\n  const insertMany = db.transaction((items: { title: string; body: string; tags: string }[]) => {\n    for (const item of items) {\n      insert.run(item.title, item.body, item.tags);\n    }\n  });\n\n  insertMany(notes);\n}\n\nfunction getSeedNotes(): { title: string; body: string; tags: string }[] {\n  return [\n    {\n      title: 'Getting Started with TypeScript',\n      body: 'TypeScript is a typed superset of JavaScript that compiles to plain JavaScript. It adds optional static typing and class-based object-oriented programming to the language. TypeScript is designed for development of large applications and transcompiles to JavaScript.',\n      tags: JSON.stringify(['programming', 'typescript', 'javascript']),\n    },\n    {\n      title: 'Introduction to Python Programming',\n      body: 'Python is a high-level, interpreted programming language known for its simplicity and readability. It supports multiple programming paradigms including procedural, object-oriented, and functional programming. Python is widely used in web development, data science, and automation.',\n      tags: JSON.stringify(['programming', 'python']),\n    },\n    {\n      title: 'Understanding Database Indexing',\n      body: 'Database indexing is a data structure technique used to quickly locate and access data in a database. Indexes are created using columns that are frequently searched against. Without an index, the database must scan every row to find relevant data, which becomes slow for large tables.',\n      tags: JSON.stringify(['database', 'performance']),\n    },\n    {\n      title: 'Homemade Pasta Recipe',\n      body: 'Making fresh pasta at home is surprisingly simple. You need flour, eggs, salt, and olive oil. Mix the ingredients to form a dough, knead for 10 minutes until smooth, rest for 30 minutes, then roll out and cut into your desired shape. Cook in boiling salted water for 2-3 minutes.',\n      tags: JSON.stringify(['cooking', 'recipes', 'italian']),\n    },\n    {\n      title: 'Classic Chocolate Chip Cookies',\n      body: 'The perfect chocolate chip cookie requires butter, sugar, brown sugar, eggs, vanilla extract, flour, baking soda, salt, and chocolate chips. Cream the butter and sugars, add eggs and vanilla, mix in dry ingredients, fold in chocolate chips, and bake at 375°F for 9-11 minutes.',\n      tags: JSON.stringify(['cooking', 'recipes', 'baking']),\n    },\n    {\n      title: 'Travel Guide: Tokyo Japan',\n      body: 'Tokyo is a fascinating blend of ultramodern and traditional. Visit the ancient Senso-ji temple, explore the bustling streets of Shibuya, enjoy fresh sushi at Tsukiji fish market, and experience the tranquility of Meiji Shrine. The best time to visit is during cherry blossom season in spring.',\n      tags: JSON.stringify(['travel', 'japan', 'asia']),\n    },\n    {\n      title: 'Exploring Paris France',\n      body: 'Paris, the City of Light, offers world-class museums like the Louvre, iconic landmarks like the Eiffel Tower, charming neighborhoods like Montmartre, and exquisite cuisine. Stroll along the Seine, visit Notre-Dame Cathedral, and enjoy croissants at a sidewalk cafe.',\n      tags: JSON.stringify(['travel', 'france', 'europe']),\n    },\n    {\n      title: 'Quantum Computing Basics',\n      body: 'Quantum computing leverages quantum mechanical phenomena like superposition and entanglement to process information. Unlike classical bits that are either 0 or 1, quantum bits (qubits) can exist in multiple states simultaneously. This enables quantum computers to solve certain problems exponentially faster.',\n      tags: JSON.stringify(['science', 'computing', 'physics']),\n    },\n    {\n      title: 'The Solar System Overview',\n      body: 'Our solar system consists of the Sun and everything that orbits it, including eight planets, dwarf planets, moons, asteroids, and comets. The inner planets (Mercury, Venus, Earth, Mars) are rocky, while the outer planets (Jupiter, Saturn, Uranus, Neptune) are gas or ice giants.',\n      tags: JSON.stringify(['science', 'astronomy', 'space']),\n    },\n    {\n      title: 'Learning Guitar for Beginners',\n      body: 'Starting guitar requires