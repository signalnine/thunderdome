--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,86 @@
+// ── In-Memory Data Store ─────────────────────────────────────────────────────
+
+import type { User, Folder, Document, Share, ActivityEntry, AuthToken } from './types.js';
+
+export class Store {
+  users = new Map<string, User>();
+  folders = new Map<string, Folder>();
+  documents = new Map<string, Document>();
+  shares = new Map<string, Share>(); // key: `${resourceType}:${resourceId}:${userId}`
+  activityLog: ActivityEntry[] = [];
+  tokens = new Map<string, AuthToken>(); // token -> AuthToken
+  private idCounter = 0;
+
+  /** Generate a simple unique ID */
+  generateId(): string {
+    this.idCounter++;
+    return `id_${Date.now()}_${this.idCounter}_${Math.random().toString(36).slice(2, 8)}`;
+  }
+
+  /** Get full list of parent folder IDs (root-most first) */
+  getFolderAncestors(folderId: string): string[] {
+    const ancestors: string[] = [];
+    let current = this.folders.get(folderId);
+    while (current && current.parentId) {
+      ancestors.unshift(current.parentId);
+      current = this.folders.get(current.parentId) ?? undefined;
+    }
+    return ancestors;
+  }
+
+  /** Collect all descendant folder IDs (recursive) */
+  getDescendantFolderIds(folderId: string): Set<string> {
+    const ids = new Set<string>();
+    const queue = [folderId];
+    while (queue.length > 0) {
+      const current = queue.pop()!;
+      for (const [, folder] of this.folders) {
+        if (folder.parentId === current && !ids.has(folder.id)) {
+          ids.add(folder.id);
+          queue.push(folder.id);
+        }
+      }
+    }
+    return ids;
+  }
+
+  /** Find documents in a given folder */
+  getDocumentsInFolder(folderId: string): Document[] {
+    return Array.from(this.documents.values()).filter(d => d.folderId === folderId);
+  }
+
+  /** Delete a folder and all its descendants (folders + documents) */
+  deleteFolderTree(folderId: string): void {
+    const descendantFolders = this.getDescendantFolderIds(folderId);
+    descendantFolders.add(folderId);
+
+    // Delete all documents in these folders
+    for (const [, doc] of this.documents) {
+      if (descendantFolders.has(doc.folderId)) {
+        this.documents.delete(doc.id);
+        // Also delete shares for this document
+        for (const [key, share] of this.shares) {
+          if (share.resourceType === 'document' && share.resourceId === doc.id) {
+            this.shares.delete(key);
+          }
+        }
+      }
+    }
+
+    // Delete all descendant folders
+    for (const fId of descendantFolders) {
+      // Delete shares for this folder
+      for (const [key, share] of this.shares) {
+        if (share.resourceType === 'folder' && share.resourceId === fId) {
+          this.shares.delete(key);
+        }
+      }
+      this.folders.delete(fId);
+    }
+  }
+}
+
+/** Singleton store created per app instance */
+export function createStore(): Store {
+  return new Store();
+}
