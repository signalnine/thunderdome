+// ── Activity Log Routes ──────────────────────────────────────────────────────
+
+import { Router } from 'express';
+import type { Store } from '../store.js';
+import { authMiddleware } from '../auth.js';
+
+export function activityRoutes(store: Store): Router {
+  const router = Router();
+  const auth = authMiddleware(store);
+
+  // GET /activity -- get activity log
+  router.get('/', auth, (_req, res) => {
+    // Return a shallow copy, oldest first
+    res.json([...store.activityLog]);
+  });
+
+  return router;
+}
