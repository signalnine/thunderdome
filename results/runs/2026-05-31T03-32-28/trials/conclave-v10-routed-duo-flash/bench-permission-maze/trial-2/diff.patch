@@ -0,0 +1,149 @@
+// ── Document Routes ──────────────────────────────────────────────────────────
+
+import { Router } from 'express';
+import type { Store } from '../store.js';
+import { authMiddleware } from '../auth.js';
+import { getDocumentPermission, hasFolderAccess, hasDocumentAccess } from '../permissions.js';
+
+export function documentRoutes(store: Store): Router {
+  const router = Router();
+  const auth = authMiddleware(store);
+
+  // POST /folders/:folderId/documents -- create a document
+  router.post('/folders/:folderId/documents', auth, (req, res) => {
+    const userId = req.userId!;
+    const { folderId } = req.params;
+    const { title, content } = req.body;
+
+    if (!title || content === undefined) {
+      res.status(400).json({ error: 'Title and content are required' });
+      return;
+    }
+
+    const folder = store.folders.get(folderId);
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+
+    // Must have editor access on the folder to create documents
+    if (!hasFolderAccess(store, folderId, userId, 'editor')) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+
+    const id = store.generateId();
+    const createdAt = new Date().toISOString();
+    const doc = {
+      id,
+      title,
+      content,
+      folderId,
+      ownerId: userId,
+      createdAt,
+    };
+
+    store.documents.set(id, doc);
+
+    store.activityLog.push({
+      id: store.generateId(),
+      actionType: 'DOCUMENT_CREATE',
+      userId,
+      targetType: 'document',
+      targetId: id,
+      timestamp: createdAt,
+    });
+
+    res.status(201).json(doc);
+  });
+
+  // GET /documents/:id -- get a document
+  router.get('/documents/:id', auth, (req, res) => {
+    const userId = req.userId!;
+    const doc = store.documents.get(req.params.id);
+
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+
+    if (!hasDocumentAccess(store, doc.id, userId, 'viewer')) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+
+    res.json(doc);
+  });
+
+  // PATCH /documents/:id -- update a document
+  router.patch('/documents/:id', auth, (req, res) => {
+    const userId = req.userId!;
+    const doc = store.documents.get(req.params.id);
+
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+
+    // Owner or editor can update
+    if (!hasDocumentAccess(store, doc.id, userId, 'editor')) {
+      res.status(403).json({ error: 'Access denied: editor or owner required' });
+      return;
+    }
+
+    const { title, content } = req.body;
+    if (title !== undefined) doc.title = title;
+    if (content !== undefined) doc.content = content;
+
+    store.activityLog.push({
+      id: store.generateId(),
+      actionType: 'DOCUMENT_UPDATE',
+      userId,
+      targetType: 'document',
+      targetId: doc.id,
+      timestamp: new Date().toISOString(),
+    });
+
+    res.json(doc);
+  });
+
+  // DELETE /documents/:id -- delete a document
+  router.delete('/documents/:id', auth, (req, res) => {
+    const userId = req.userId!;
+    const doc = store.documents.get(req.params.id);
+
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+
+    // Only owner can delete
+    const perm = getDocumentPermission(store, doc.id, userId);
+    if (!perm.isOwner) {
+      res.status(403).json({ error: 'Only the owner can delete this document' });
+      return;
+    }
+
+    // Remove any shares for this document
+    for (const [key, share] of store.shares) {
+      if (share.resourceType === 'document' && share.resourceId === doc.id) {
+        store.shares.delete(key);
+      }
+    }
+
+    store.documents.delete(doc.id);
+
+    store.activityLog.push({
+      id: store.generateId(),
+      actionType: 'DOCUMENT_DELETE',
+      userId,
+      targetType: 'document',
+      targetId: doc.id,
+      timestamp: new Date().toISOString(),
+    });
+
+    res.status(204).send();
+  });
+
+  return router;
+}
diff --git a/src/routes/folders.ts b/src/routes/folders.ts
new file mode 100644
index 0000000..0338c1e
--- /dev/null
+++ b/src/routes/folders.ts
@@ -0,0 +1,184 @@
+// ── Folder Routes ────────────────────────────────────────────────────────────
+
+import { Router } from 'express';
+import type { Store } from '../store.js';
+import { authMiddleware } from '../auth.js';
+import { getFolderPermission, hasFolderAccess } from '../permissions.js';
+
+export function folderRoutes(store: Store): Router {
+  const router = Router();
+  const auth = authMiddleware(store);
+
+  // POST /folders -- create a folder
+  router.post('/', auth, (req, res) => {
+    const userId = req.userId!;
+    const { name, parentId } = req.body;
+
+    if (!name) {
+      res.status(400).json({ error: 'Folder name is required' });
+      return;
+    }
+
+    // Check parent exists
+    if (parentId) {
+      const parent = store.folders.get(parentId);
+      if (!parent) {
+        res.status(404).json({ error: 'Parent folder not found' });
+        return;
+      }
+      // User must have access to the parent folder to create a child
+      if (!hasFolderAccess(store, parentId, userId, 'editor')) {
+        res.status(403).json({ error: 'Access denied' });
+        return;
+      }
+    }
+
+    const id = store.generateId();
+    const createdAt = new Date().toISOString();
+    const folder = {
+      id,
+      name,
+      parentId: parentId ?? null,
+      ownerId: userId,
+      createdAt,
+    };
+
+    store.folders.set(id, folder);
+
+    store.activityLog.push({
+      id: store.generateId(),
+      actionType: 'FOLDER_CREATE',
+      userId,
+      targetType: 'folder',
+      targetId: id,
+      timestamp: createdAt,
+    });
+
+    res.status(201).json(folder);
+  });
+
+  // GET /folders/:id -- get a folder
+  router.get('/:id', auth, (req, res) => {
+    const userId = req.userId!;
+    const folder = store.folders.get(req.params.id);
+
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+
+    // Check access
+    if (!hasFolderAccess(store, folder.id, userId, 'viewer')) {
+      res.status(403).json({ error: 'Access denied' });
+      return;
+    }
+
+    // Gather children
+    const subfolders = Array.from(store.folders.values())
+      .filter(f => f.parentId === folder.id);
+
+    const documents = Array.from(store.documents.values())
+      .filter(d => d.folderId === folder.id);
+
+    res.json({
+      ...folder,
+      subfolders,
+      documents,
+    });
+  });
+
+  // PATCH /folders/:id -- update a folder
+  router.patch('/:id', auth, (req, res) => {
+    const userId = req.userId!;
+    const folder = store.folders.get(req.params.id);
+
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+
+    // Only owner can update
+    const perm = getFolderPermission(store, folder.id, userId);
+    if (!perm.isOwner) {
+      res.status(403).json({ error: 'Only the owner can update this folder' });
+      return;
+    }
+
+    const { name } = req.body;
+    if (name !== undefined) {
+      folder.name = name;
+    }
+
+    store.activityLog.push({
+      id: store.generateId(),
+      actionType: 'FOLDER_UPDATE',
+      userId,
+      targetType: 'folder',
+      targetId: folder.id,
+      timestamp: new Date().toISOString(),
+    });
+
+    res.json(folder);
+  });
+
+  // DELETE /folders/:id -- delete a folder recursively
+  router.delete('/:id', auth, (req, res) => {
+    const userId = req.userId!;
+    const folder = store.folders.get(req.params.id);
+
+    if (!folder) {
+      res.status(404).json({ error: 'Folder not found' });
+      return;
+    }
+
+    // Only owner can delete
+    const perm = getFolderPermission(store, folder.id, userId);
+    if (!perm.isOwner) {
+      res.status(403).json({ error: 'Only the owner can delete this folder' });
+      return;
+    }
+
+    // Log all deletions
+    const descendantFolders = store.getDescendantFolderIds(folder.id);
+    descendantFolders.add(folder.id);
+
+    for (const fId of descendantFolders) {
+      // Log documents in this folder
+      for (const doc of store.getDocumentsInFolder(fId)) {
+        store.activityLog.push({
+          id: store.generateId(),
+          actionType: 'DOCUMENT_DELETE',
+          userId,
+          targetType: 'document',
+          targetId: doc.id,
+          timestamp: new Date().toISOString(),
+        });
+      }
+      if (fId !== folder.id) {
+        store.activityLog.push({
+          id: store.generateId(),
+          actionType: 'FOLDER_DELETE',
+          userId,
+          targetType: 'folder',
+          targetId: fId,
+          timestamp: new Date().toISOString(),
+        });
+      }
+    }
+
+    store.activityLog.push({
+      id: store.generateId(),
+      actionType: 'FOLDER_DELETE',
+      userId,
+      targetType: 'folder',
+      targetId: folder.id,
+      timestamp: new Date().toISOString(),
+    });
+
+    store.deleteFolderTree(folder.id);
+
+    res.status(204).send();
+  });
+
+  return router;
+}
diff --git a/src/routes/share.ts b/src/routes/share.ts
new file mode 100644
index 0000000..8dc1c02
--- /dev/null
+++ b/src/routes/share.ts
@@ -0,0 +1,149 @@
+// ── Share Routes ─────────────────────────────────────────────────────────────
+
+import { Router } from 'express';
+import type { Store } from '../store.js';
+import type { Role, ResourceType } from '../types.js';
+import { authMiddleware } from '../auth.js';
+import { canShare, getFolderPermission, getDocumentPermission } from '../permissions.js';
+
+const VALID_ROLES: Role[] = ['viewer', 'editor', 'owner'];
+
+export function shareRoutes(store: Store): Router {
+  const router = Router();
+  const auth = authMiddleware(store);
+
+  // POST /share/:resourceType/:resourceId -- share a resource
+  router.post('/:resourceType/:resourceId', auth, (req, res) => {
+    const userId = req.userId!;
+    const { resourceType, resourceId } = req.params;
+    const { userId: targetUserId, role } = req.body;
+
+    // Validate resourceType
+    if (resourceType !== 'folder' && resourceType !== 'document') {
+      res.status(400).json({ error: 'Invalid resource type. Must be "folder" or "document"' });
+      return;
+    }
+
+    // Validate role
+    if (!role || !VALID_ROLES.includes(role)) {
+      res.status(400).json({ error: 'Invalid role. Must be one of: viewer, editor, owner' });
+      return;
+    }
+
+    // Validate target user exists
+    const targetUser = store.users.get(targetUserId);
+    if (!targetUser) {
+      res.status(404).json({ error: 'Target user not found' });
+      return;
+    }
+
+    // Can't share with yourself
+    if (targetUserId === userId) {
+      res.status(400).json({ error: 'Cannot share a resource with yourself' });
+      return;
+    }
+
+    // Check resource exists and user can share
+    if (resourceType === 'folder') {
+      const folder = store.folders.get(resourceId);
+      if (!folder) {
+        res.status(404).json({ error: 'Folder not found' });
+        return;
+      }
+      if (!canShare(store, 'folder', resourceId, userId)) {
+        res.status(403).json({ error: 'Access denied: editor or owner required to share' });
+        return;
+      }
+    } else {
+      const doc = store.documents.get(resourceId);
+      if (!doc) {
+        res.status(404).json({ error: 'Document not found' });
+        return;
+      }
+      if (!canShare(store, 'document', resourceId, userId)) {
+        res.status(403).json({ error: 'Access denied: editor or owner required to share' });
+        return;
+      }
+    }
+
+    // Create or update share
+    const shareKey = `${resourceType}:${resourceId}:${targetUserId}`;
+    const share = {
+      resourceType: resourceType as ResourceType,
+      resourceId,
+      userId: targetUserId,
+      role: role as Role,
+      sharedBy: userId,
+    };
+    store.shares.set(shareKey, share);
+
+    store.activityLog.push({
+      id: store.generateId(),
+      actionType: 'SHARE_CREATE',
+      userId,
+      targetType: resourceType,
+      targetId: resourceId as string,
+      timestamp: new Date().toISOString(),
+    });
+
+    res.json(share);
+  });
+
+  // DELETE /share/:resourceType/:resourceId/:userId -- remove a share
+  router.delete('/:resourceType/:resourceId/:targetUserId', auth, (req, res) => {
+    const userId = req.userId!;
+    const { resourceType, resourceId, targetUserId } = req.params;
+
+    if (resourceType !== 'folder' && resourceType !== 'document') {
+      res.status(400).json({ error: 'Invalid resource type' });
+      return;
+    }
+
+    // Check that the requesting user is the owner of the resource
+    let isOwner = false;
+    if (resourceType === 'folder') {
+      const folder = store.folders.get(resourceId);
+      if (!folder) {
+        res.status(404).json({ error: 'Folder not found' });
+        return;
+      }
+      const perm = getFolderPermission(store, resourceId, userId);
+      isOwner = perm.isOwner;
+    } else {
+      const doc = store.documents.get(resourceId);
+      if (!doc) {
+        res.status(404).json({ error: 'Document not found' });
+        return;
+      }
+      const perm = getDocumentPermission(store, resourceId, userId);
+      isOwner = perm.isOwner;
+    }
+
+    if (!isOwner) {
+      res.status(403).json({ error: 'Only the owner can remove shares' });
+      return;
+    }
+
+    const shareKey = `${resourceType}:${resourceId}:${targetUserId}`;
+    const existing = store.shares.get(shareKey);
+    if (!existing) {
+      res.status(404).json({ error: 'Share not found' });
+      return;
+    }
+
+    store.shares.delete(shareKey);
+
+    store.activityLog.push({
+      id: store.generateId(),
+      actionType: 'SHARE_REMOVE',
+      userId,
+      targetType: resourceType,
+      targetId: resourceId as string,
+      timestamp: new Date().toISOString(),
+    });
+
+    res.status(204).send();
+  });
+
+  return router;
+}
