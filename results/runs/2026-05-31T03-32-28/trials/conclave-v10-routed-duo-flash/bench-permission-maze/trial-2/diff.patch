@@ -0,0 +1,31 @@
+// ── Authentication Middleware ─────────────────────────────────────────────────
+
+import type { Request, Response, NextFunction } from 'express';
+import type { Store } from './store.js';
+
+// Extend Express Request to include userId
+declare module 'express-serve-static-core' {
+  interface Request {
+    userId?: string;
+  }
+}
+
+export function authMiddleware(store: Store) {
+  return (req: Request, res: Response, next: NextFunction): void => {
+    const authHeader = req.headers.authorization;
+    if (!authHeader || !authHeader.startsWith('Bearer ')) {
+      res.status(401).json({ error: 'Authentication required' });
+      return;
+    }
+
+    const token = authHeader.slice(7);
+    const tokenData = store.tokens.get(token);
+    if (!tokenData) {
+      res.status(401).json({ error: 'Invalid or expired token' });
+      return;
+    }
+
+    req.userId = tokenData.userId;
+    next();
+  };
+}
diff --git a/src/permissions.ts b/src/permissions.ts
new file mode 100644
index 0000000..da320ca
--- /dev/null
+++ b/src/permissions.ts
@@ -0,0 +1,127 @@
+// ── Permission Resolution ────────────────────────────────────────────────────
+
+import type { Store } from './store.js';
+import type { Role } from './types.js';
+import { roleLevel, maxRole } from './types.js';
+
+export interface EffectivePermission {
+  role: Role | null;
+  isOwner: boolean;
+}
+
+/**
+ * Get the effective permission for a user on a specific folder.
+ * Checks: direct ownership → folder shares → parent folder shares (inherited).
+ */
+export function getFolderPermission(
+  store: Store,
+  folderId: string,
+  userId: string
+): EffectivePermission {
+  const folder = store.folders.get(folderId);
+  if (!folder) {
+    return { role: null, isOwner: false };
+  }
+
+  // Owner check
+  if (folder.ownerId === userId) {
+    return { role: 'owner', isOwner: true };
+  }
+
+  let effectiveRole: Role | null = null;
+
+  // Check all ancestor folders + the folder itself for shares
+  const ancestors = store.getFolderAncestors(folderId);
+  const allFolderIds = [...ancestors, folderId];
+
+  for (const fId of allFolderIds) {
+    const shareKey = `folder:${fId}:${userId}`;
+    const share = store.shares.get(shareKey);
+    if (share) {
+      effectiveRole = effectiveRole ? maxRole(effectiveRole, share.role) : share.role;
+    }
+  }
+
+  return { role: effectiveRole, isOwner: false };
+}
+
+/**
+ * Get the effective permission for a user on a specific document.
+ * Checks: document ownership → direct document shares → folder permission.
+ */
+export function getDocumentPermission(
+  store: Store,
+  documentId: string,
+  userId: string
+): EffectivePermission {
+  const doc = store.documents.get(documentId);
+  if (!doc) {
+    return { role: null, isOwner: false };
+  }
+
+  // Owner check
+  if (doc.ownerId === userId) {
+    return { role: 'owner', isOwner: true };
+  }
+
+  let effectiveRole: Role | null = null;
+
+  // Direct document share
+  const docShareKey = `document:${documentId}:${userId}`;
+  const docShare = store.shares.get(docShareKey);
+  if (docShare) {
+    effectiveRole = docShare.role;
+  }
+
+  // Folder permission (inherited)
+  const folderPerm = getFolderPermission(store, doc.folderId, userId);
+  if (folderPerm.role) {
+    effectiveRole = effectiveRole ? maxRole(effectiveRole, folderPerm.role) : folderPerm.role;
+  }
+
+  return { role: effectiveRole, isOwner: false };
+}
+
+/**
+ * Check if a user has at least the given role on a folder.
+ */
+export function hasFolderAccess(
+  store: Store,
+  folderId: string,
+  userId: string,
+  minimumRole: Role
+): boolean {
+  const perm = getFolderPermission(store, folderId, userId);
+  if (!perm.role) return false;
+  return roleLevel(perm.role) >= roleLevel(minimumRole);
+}
+
+/**
+ * Check if a user has at least the given role on a document.
+ */
+export function hasDocumentAccess(
+  store: Store,
+  documentId: string,
+  userId: string,
+  minimumRole: Role
+): boolean {
+  const perm = getDocumentPermission(store, documentId, userId);
+  if (!perm.role) return false;
+  return roleLevel(perm.role) >= roleLevel(minimumRole);
+}
+
+/**
+ * Check if a user can share a resource (must be owner or editor).
+ */
+export function canShare(
+  store: Store,
+  resourceType: 'folder' | 'document',
+  resourceId: string,
+  userId: string
+): boolean {
+  if (resourceType === 'folder') {
+    return hasFolderAccess(store, resourceId, userId, 'editor');
+  } else {
+    return hasDocumentAccess(store, resourceId, userId, 'editor');
+  }
+}
