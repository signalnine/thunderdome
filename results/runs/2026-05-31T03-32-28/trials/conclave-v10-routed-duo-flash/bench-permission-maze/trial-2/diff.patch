oBe('document');\n      expect(res.body.role).toBe('editor');\n    });\n\n    it('4.3 should reject invalid role', async () => {\n      const folder = await request(app)\n        .post('/folders')\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ name: 'Folder' });\n\n      const res = await request(app)\n        .post(`/share/folder/${folder.body.id}`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ userId: userB.userId, role: 'admin' });\n\n      expect(res.status).toBe(400);\n    });\n\n    it('4.4 should reject sharing with non-existent user', async () => {\n      const folder = await request(app)\n        .post('/folders')\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ name: 'Folder' });\n\n      const res = await request(app)\n        .post(`/share/folder/${folder.body.id}`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ userId: 'nonexistent', role: 'viewer' });\n\n      expect(res.status).toBe(404);\n    });\n\n    it('4.5 viewer cannot share a resource', async () => {\n      const folder = await request(app)\n        .post('/folders')\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ name: 'Folder' });\n\n      // Share folder with userB as viewer\n      await request(app)\n        .post(`/share/folder/${folder.body.id}`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ userId: userB.userId, role: 'viewer' });\n\n      // UserB tries to share with userC\n      const res = await request(app)\n        .post(`/share/folder/${folder.body.id}`)\n        .set('Authorization', `Bearer ${userB.token}`)\n        .send({ userId: userC.userId, role: 'viewer' });\n\n      expect(res.status).toBe(403);\n    });\n\n    it('4.6 folder share inheritance: viewer can read documents', async () => {\n      const folder = await request(app)\n        .post('/folders')\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ name: 'Folder' });\n\n      const doc = await request(app)\n        .post(`/folders/${folder.body.id}/documents`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ title: 'Inherited Doc', content: 'secret' });\n\n      // Share folder with userB as viewer\n      await request(app)\n        .post(`/share/folder/${folder.body.id}`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ userId: userB.userId, role: 'viewer' });\n\n      // UserB can read the document\n      const res = await request(app)\n        .get(`/documents/${doc.body.id}`)\n        .set('Authorization', `Bearer ${userB.token}`);\n      expect(res.status).toBe(200);\n    });\n\n    it('4.7 most permissive role when shared multiple ways', async () => {\n      const folder = await request(app)\n        .post('/folders')\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ name: 'Folder' });\n\n      const doc = await request(app)\n        .post(`/folders/${folder.body.id}/documents`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ title: 'Doc', content: 'content' });\n\n      // Share folder as viewer, document as editor\n      await request(app)\n        .post(`/share/folder/${folder.body.id}`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ userId: userB.userId, role: 'viewer' });\n\n      await request(app)\n        .post(`/share/document/${doc.body.id}`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ userId: userB.userId, role: 'editor' });\n\n      // UserB should be able to update (editor permission)\n      const res = await request(app)\n        .patch(`/documents/${doc.body.id}`)\n        .set('Authorization', `Bearer ${userB.token}`)\n        .send({ title: 'Updated by Editor' });\n      expect(res.status).toBe(200);\n    });\n\n    it('4.8 viewer on folder cannot update documents', async () => {\n      const folder = await request(app)\n        .post