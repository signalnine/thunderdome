ion', `Bearer ${userA.token}`)\n        .send({ name: 'Folder' });\n\n      const doc = await request(app)\n        .post(`/folders/${folder.body.id}/documents`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ title: 'Original', content: 'content' });\n\n      await request(app)\n        .patch(`/documents/${doc.body.id}`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ title: 'Updated' });\n\n      const res = await request(app)\n        .get('/activity')\n        .set('Authorization', `Bearer ${userA.token}`);\n\n      const entry = res.body.find((e: ActivityEntry) =>\n        e.actionType === 'DOCUMENT_UPDATE' && e.targetId === doc.body.id\n      );\n      expect(entry).toBeDefined();\n    });\n\n    it('5.4 should log document deletion', async () => {\n      const folder = await request(app)\n        .post('/folders')\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ name: 'Folder' });\n\n      const doc = await request(app)\n        .post(`/folders/${folder.body.id}/documents`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ title: 'Delete Me', content: 'bye' });\n\n      await request(app)\n        .delete(`/documents/${doc.body.id}`)\n        .set('Authorization', `Bearer ${userA.token}`);\n\n      const res = await request(app)\n        .get('/activity')\n        .set('Authorization', `Bearer ${userA.token}`);\n\n      const entry = res.body.find((e: ActivityEntry) =>\n        e.actionType === 'DOCUMENT_DELETE' && e.targetId === doc.body.id\n      );\n      expect(entry).toBeDefined();\n    });\n\n    it('5.5 should log share creation and removal', async () => {\n      const folder = await request(app)\n        .post('/folders')\n        .set('Authorization', `Bearer ${userA.token}`)\n        .send({ name: 'Folder' });\n\n      await request(app)\n        .post(`/share/folder/${folder.body.id}`)\n        .set('Authorization', `Bearer ${userA.token}`)\n        .s