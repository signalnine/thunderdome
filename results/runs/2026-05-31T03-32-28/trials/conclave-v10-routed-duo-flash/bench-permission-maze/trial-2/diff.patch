@@ -0,0 +1,66 @@
+// ── Types ──────────────────────────────────────────────────────────────────
+
+export type Role = 'viewer' | 'editor' | 'owner';
+export type ResourceType = 'folder' | 'document';
+export type ActionType = 'DOCUMENT_CREATE' | 'DOCUMENT_UPDATE' | 'DOCUMENT_DELETE' | 'FOLDER_CREATE' | 'FOLDER_UPDATE' | 'FOLDER_DELETE' | 'SHARE_CREATE' | 'SHARE_REMOVE' | 'USER_REGISTER';
+
+export interface User {
+  id: string;
+  username: string;
+  password: string; // plain text (in-memory only, no persistence)
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: string;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: string;
+}
+
+export interface Share {
+  resourceType: ResourceType;
+  resourceId: string;
+  userId: string;
+  role: Role;
+  sharedBy: string;
+}
+
+export interface ActivityEntry {
+  id: string;
+  actionType: ActionType;
+  userId: string;
+  targetType: string;
+  targetId: string;
+  timestamp: string;
+}
+
+export interface AuthToken {
+  userId: string;
+  token: string;
+}
+
+// ── Role hierarchy ──────────────────────────────────────────────────────────
+
+const ROLE_LEVELS: Record<Role, number> = {
+  viewer: 0,
+  editor: 1,
+  owner: 2,
+};
+
+export function roleLevel(role: Role): number {
+  return ROLE_LEVELS[role];
+}
+
+export function maxRole(a: Role, b: Role): Role {
+  return roleLevel(a) >= roleLevel(b) ? a : b;
+}
