atus(400).json({ error: 'Username and password are required' });\n      return;\n    }\n\n    // Find user\n    let foundUser = null;\n    for (const [, user] of store.users) {\n      if (user.username === username && user.password === password) {\n        foundUser = user;\n        break;\n      }\n    }\n\n    if (!foundUser) {\n      res.status(401).json({ error: 'Invalid credentials' });\n      return;\n    }\n\n    // Generate token\n    const token = crypto.randomBytes(32).toString('hex');\n    store.tokens.set(token, { userId: foundUser.id, token });\n\n    res.status(200).json({\n      token,\n      userId: foundUser.id,\n      username: foundUser.username,\n    });\n  });\n\n  return router;\n}\n","structuredPatch":[{"oldStart":3,"oldLines":7,"newStart":3,"newLines":6,"lines":[" import { Router } from 'express';"," import crypto from 'crypto';"," import type { Store } from '../store.js';","-import type { ActivityEntry } from '../types.js';"," "," export function authRoutes(store: Store): Router {","   const router = Router();"]}],"userModified":false,"replaceAll":false}}
