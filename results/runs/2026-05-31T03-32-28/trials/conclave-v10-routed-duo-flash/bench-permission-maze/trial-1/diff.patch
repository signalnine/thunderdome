t: 'Secret', folderId: folder.body.id });\n\n      // Alice shares folder with Bob as viewer\n      await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          username: 'bob',\n          role: 'viewer',\n        });\n\n      // Bob can read the document through inherited folder permission\n      const res = await request\n        .get(`/documents/${doc.body.id}`)\n        .set('Authorization', `Bearer ${bobToken}`);\n      expect(res.status).toBe(200);\n      expect(res.body.title).toBe('InnerDoc');\n    });\n\n    it('should use most permissive role when multiple paths exist', async () => {\n      // Alice creates a folder and a document inside it\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Folder' });\n\n      const doc = await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'Doc', content: 'Text', folderId: folder.body.id });\n\n      // Alice shares folder with Bob as viewer\n      await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          username: 'bob',\n          role: 'viewer',\n        });\n\n      // Alice also shares the document with Bob as editor\n      await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'document',\n          resourceId: doc.body.id,\n          username: 'bob',\n          role: 'editor',\n        });\n\n      // Bob should be able to update the document (editor access, not just viewer)\n      const res = await request\n        .put(`/documents/${doc.body.id}`)\n        .set('Authorization', `Bearer ${bobToken}`)\n       