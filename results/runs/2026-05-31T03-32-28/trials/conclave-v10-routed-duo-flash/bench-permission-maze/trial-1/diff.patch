horization', `Bearer ${aliceToken}`)\n        .send({ name: 'OldName' });\n\n      const res = await request\n        .put(`/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'NewName' });\n\n      expect(res.status).toBe(200);\n      expect(res.body.name).toBe('NewName');\n    });\n\n    it('should return 403 when non-editor tries to update folder', async () => {\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Private' });\n\n      const res = await request\n        .put(`/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bobToken}`)\n        .send({ name: 'Hacked' });\n      expect(res.status).toBe(403);\n    });\n\n    it('should delete a folder as owner', async () => {\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'ToDelete' });\n\n      const res = await request\n        .delete(`/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${aliceToken}`);\n      expect(res.status).toBe(204);\n\n      // Verify it's gone\n      const getRes = await request\n        .get(`/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${aliceToken}`);\n      expect(getRes.status).toBe(404);\n    });\n\n    it('should return 403 when non-owner tries to delete folder', async () => {\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Private' });\n\n      const res = await request\n        .delete(`/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bobToken}`);\n      expect(res.status).toBe(403);\n    });\n  });\n\n  // ─── Documents ────────────────────────────────────────────────────\n\n  describe('Documents', () => {\n    let folderId: string;\n\n    beforeEach(async () => {\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'DocsFolder' });\n      folderId = folder.body.id;\n    });\n\n    it('should create a document in a folder', async () => {\n      const res = await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'MyDoc', content: 'Hello World', folderId });\n\n      expect(res.status).toBe(201);\n      expect(res.body).toHaveProperty('id');\n      expect(res.body.title).toBe('MyDoc');\n      expect(res.body.content).toBe('Hello World');\n      expect(res.body.folderId).toBe(folderId);\n      expect(res.body.ownerId).toBe(aliceId);\n    });\n\n    it('should reject document creation without title or folderId', async () => {\n      const res1 = await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ content: 'Text', folderId });\n      expect(res1.status).toBe(400);\n\n      const res2 = await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'MyDoc', content: 'Text' });\n      expect(res2.status).toBe(400);\n    });\n\n    it('should reject document creation in non-existent folder', async () => {\n      const res = await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'Doc', content: 'Text', folderId: 'nonexistent' });\n      expect(res.status).toBe(404);\n    });\n\n    it('should reject document creation in folder without editor access', async () => {\n      const res = await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${bobToken}`)\n        .send({ title: 'Doc', content: 'Text', folderId });\n      expect(res.status).toBe(403);\n    });\n\n    it('should get a document', async () => {\n      const doc = await request\n        .post('/documents')\n        .set('