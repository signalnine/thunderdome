n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Child', parentId: parentId });\n      const childId = child.body.id;\n\n      const doc1 = await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'Doc1', content: 'Text', folderId: parentId });\n\n      const doc2 = await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'Doc2', content: 'Text', folderId: childId });\n\n      // Share the folder with Bob\n      await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: parentId,\n          username: 'bob',\n          role: 'viewer',\n        });\n\n      // Delete the parent folder\n      const delRes = await request\n        .delete(`/folders/${parentId}`)\n        .set('Authorization', `Bearer ${aliceToken}`);\n      expect(delRes.status).toBe(204);\n\n      // Parent folder is gone\n      const getParent = await request\n        .get(`/folders/${parentId}`)\n        .set('Authorization', `Bearer ${aliceToken}`);\n      expect(getParent.status).toBe(404);\n\n      // Child folder is gone\n      const getChild = await request\n        .get(`/folders/${childId}`)\n        .set('Authorization', `Bearer ${aliceToken}`);\n      expect(getChild.status).toBe(404);\n\n      // Documents are gone\n      const getDoc1 = await request\n        .get(`/documents/${doc1.body.id}`)\n        .set('Authorization', `Bearer ${aliceToken}`);\n      expect(getDoc1.status).toBe(404);\n\n      const getDoc2 = await request\n        .get(`/documents/${doc2.body.id}`)\n        .set('Authorization', `Bearer ${aliceToken}`);\n      expect(getDoc2.status).toBe(404);\n    });\n  });\n\n  // ─── Edge Cases ───────────────────────────────────────────────────\n\n  describe('Edge Cases', () => {\n    it('should return 403 when viewer tries to edit a document', async () => {\n      // Alice creates folder + document\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Folder' });\n\n      const doc = await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'Doc', content: 'Text', folderId: folder.body.id });\n\n      // Alice shares folder with Bob as viewer\n      await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          username: 'bob',\n          role: 'viewer',\n        });\n\n      // Bob tries to update the doc -- should fail (viewer, not editor)\n      const res = await request\n        .put(`/documents/${doc.body.id}`)\n        .set('Authorization', `Bearer ${bobToken}`)\n        .send({ title: 'Hacked' });\n      expect(res.status).toBe(403);\n    });\n\n    it('should allow creator to always access own resources', async () => {\n      // Alice creates a folder (no explicit sharing needed)\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'MyFolder' });\n\n      // Alice can read, edit, delete as owner\n      const getRes = await request\n        .get(`/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${aliceToken}`);\n      expect(getRes.status).toBe(200);\n\n      const putRes = await request\n        .put(`/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Renamed' });\n      expect(putRes.status).toBe(200);\n\n      const delRes = await request\n        .delete(`/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${aliceToken}`);\n      expect(delRes.status).toBe(204);\n    });\n  });\n});\n","structuredPatch":[],"