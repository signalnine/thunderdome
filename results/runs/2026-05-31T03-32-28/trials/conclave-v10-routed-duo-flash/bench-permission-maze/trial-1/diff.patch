Bob');\n    });\n\n    it('should allow editor to share a resource', async () => {\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Folder' });\n\n      const doc = await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'Doc', content: 'Text', folderId: folder.body.id });\n\n      // Alice shares folder with Bob as editor\n      await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          username: 'bob',\n          role: 'editor',\n        });\n\n      // Bob (editor) can now share the document with Charlie\n      const res = await request\n        .post('/share')\n        .set('Authorization', `Bearer ${bobToken}`)\n        .send({\n          resourceType: 'document',\n          resourceId: doc.body.id,\n          username: 'charlie',\n          role: 'viewer',\n        });\n\n      expect(res.status).toBe(201);\n    });\n  });\n\n  // ─── Activity Log ──────────────────────────────────────────────────\n\n  describe('Activity Log', () => {\n    it('should return activity log entries', async () => {\n      // Do some actions\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Folder' });\n\n      await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'Doc', content: 'Text', folderId: folder.body.id });\n\n      // Get activity log\n      const res = await request\n        .get('/activity')\n        .set('Authorization', `Bearer ${aliceToken}`);\n\n      expect(res.status).toBe(200);\n      expect(Array.isArray(res.body)).toBe(true);\n      expect(res.body.length).toBeGreaterThanOrEqual(2);\n\n      // Check structure\n   