rd: string): string {\n  return crypto.createHash('sha256').update(password).digest('hex');\n}\n\nfunction generateToken(): string {\n  return crypto.randomBytes(32).toString('hex');\n}\n\nfunction generateId(): string {\n  return crypto.randomUUID();\n}\n\nfunction compareRoles(a: Role | null, b: Role | null): number {\n  const aVal = a ? ROLE_HIERARCHY[a] : 0;\n  const bVal = b ? ROLE_HIERARCHY[b] : 0;\n  return aVal - bVal;\n}\n\n/**\n * Get the effective role a user has on a resource, considering:\n * - Direct ownership always grants 'owner'\n * - Direct permissions on the resource\n * - Inherited permissions from parent folders (up the tree)\n */\nfunction getEffectiveRole(\n  store: Store,\n  userId: string,\n  resourceType: 'folder' | 'document',\n  resourceId: string,\n  visited?: Set<string>,\n): Role | null {\n  const visitedSet = visited ?? new Set<string>();\n  const cacheKey = `${resourceType}:${resourceId}`;\n  if (visitedSet.has(cacheKey)) {\n    return null; // cycle guard\n  }\n  visitedSet.add(cacheKey);\n\n  const resource =\n    resourceType === 'folder'\n      ? (store.folders.get(resourceId) as Folder | undefined)\n      : (store.documents.get(resourceId) as Document | undefined);\n\n  if (!resource) return null;\n\n  // Owner automatically gets owner role\n  if (resource.ownerId === userId) return 'owner';\n\n  let maxLevel = 0;\n\n  // Check direct permissions\n  for (const perm of store.permissions.values()) {\n    if (\n      perm.resourceType === resourceType &&\n      perm.resourceId === resourceId &&\n      perm.userId === userId\n    ) {\n      const level = ROLE_HIERARCHY[perm.role];\n      if (level > maxLevel) maxLevel = level;\n    }\n  }\n\n  // Check inheritance from parent folder\n  const parentId =\n    resourceType === 'document'\n      ? (resource as Document).folderId\n      : (resource as Folder).parentId;\n\n  if (parentId) {\n    const parentRole = getEffectiveRole(store, userId, 'folder', parentId, visitedSet);\n    if (parentRole) {\n      const level = ROLE_HIERARCHY[parentRole];\n      if (level > maxLevel) maxLevel = level;\n    }\n  }\n\n  if (maxLevel >= 3) return 'owner';\n  if (maxLevel >= 2) return 'editor';\n  if (maxLevel >= 1) return 'viewer';\n  return null;\n}\n\n/**\n * Check if the effective role meets the required minimum role.\n */\nfunction hasMinRole(\n  store: Store,\n  userId: string,\n  resourceType: 'folder' | 'document',\n  resourceId: string,\n  minimum: Role,\n): boolean {\n  const effective = getEffectiveRole(store, userId, resourceType, resourceId);\n  return compareRoles(effective, minimum) >= 0;\n}\n\nfunction logActivity(\n  store: Store,\n  actionType: string,\n  userId: string,\n  username: string,\n  targetType: string,\n  targetId: string,\n  details: Record<string, unknown> = {},\n): void {\n  const entry: ActivityLog = {\n    id: generateId(),\n    actionType,\n    userId,\n    username,\n    targetType,\n    targetId,\n    details,\n    timestamp: new Date(),\n  };\n  store.activities.set(entry.id, entry);\n}\n\n// ─── Auth Middleware ─────────────────────────────────────────────────\n\ndeclare global {\n  namespace Express {\n    interface Request {\n      user?: { id: string; username: string };\n    }\n  }\n}\n\nfunction authMiddleware(store: Store) {\n  return (req: Request, res: Response, next: NextFunction): void => {\n    const authHeader = req.headers.authorization;\n    if (!authHeader || !authHeader.startsWith('Bearer ')) {\n      res.status(401).json({ error: 'Authentication required' });\n      return;\n    }\n    const token = authHeader.slice(7);\n    const userId = store.tokens.get(token);\n    if (!userId) {\n      res.status(401).json({ error: 'Invalid or expired token' });\n      return;\n    }\n    const user = store.users.get(userId);\n    if (!user) {\n      res.status(401).json({ error: 'User not found' });\n      return;\n    }\n    req.user = { id: user.id, username: user.username };\n    next();\n  };\n}\n\n// ─── Cascade Delete ──────────────────────────────────────────────────\n\nfunction deleteFolderCascade(\n  store: Store,\n  folderId: string,\n  userId: string,\n  username: string,\n): void {\n  // Delete documents in this folder\n  for (const [docId, doc] of store.documents) {\n    if (doc.folderId === folderId) {\n      // Delete document permissions\n      for (const [permId, perm] of store.permissions) {\n        if (perm.resourceType === 'document' && perm.resourceId === docId) {\n          store.permissions.delete(permId);\n        }\n      }\n      store.documents.delete(docId);\n      logActivity(store, 'document_deleted', userId, username, 'document', docId, {\n        title: doc.title,\n        folderId: doc.folderId,\n      });\n    }\n  }\n\n  // Recursively delete sub-folders\n  for (const [subId, subFolder] of store.folders) {\n    if (subFolder.parentId === folderId) {\n      deleteFolderCascade(store, subId, userId, username);\n    }\n  }\n\n  // Delete folder permissions\n  for (const [permId, perm] of store.permissions) {\n    if (perm.resourceType === 'folder' && perm.resourceId === folderId) {\n      store.permissions.delete(permId);\n    }\n  }\n\n  const folder = store.folders.get(folderId);\n  if (folder) {\n    logActivity(store, 'folder_deleted', userId, username, 'folder', folderId, {\n      name: folder.name,\n    });\n  }\n  store.folders.delete(folderId);\n}\n\n// ─── Response builders ───────────────────────────────────────────────\n\nfunction buildFolderResponse(\n  store: Store,\n  folder: Folder,\n  userId: string,\n): FolderResponse {\n  // Child folders the user can see (has at least viewer)\n  const childFolders: FolderChildResponse[] = [];\n  for (const f of store.folders.values()) {\n    if (f.parentId === folder.id && hasMinRole(store, userId, 'folder', f.id, 'viewer')) {\n      childFolders.push({\n        id: f.id,\n        name: f.name,\n        parentId: f.parentId,\n        createdAt: f.createdAt,\n        updatedAt: f.updatedAt,\n      });\n    }\n  }\n\n  // Documents the user can see\n  const childDocs: DocumentChildResponse[] = [];\n  for (const d of store.documents.values()) {\n    if (d.folderId === folder.id && hasMinRole(store, userId, 'document', d.id, 'viewer')) {\n      childDocs.push({\n        id: d.id,\n        title: d.title,\n        content: d.content,\n        folderId: d.folderId,\n        createdAt: d.createdAt,\n        updatedAt: d.updatedAt,\n      });\n    }\n  }\n\n  return {\n    id: folder.id,\n    name: folder.name,\n    parentId: folder.parentId,\n    ownerId: folder.ownerId,\n    createdAt: folder.createdAt,\n    updatedAt: folder.updatedAt,\n    children: {\n      folders: childFolders,\n      documents: childDocs,\n    },\n  };\n}\n\n// ─── createApp ───────────────────────────────────────────────────────\n\nexport function createApp() {\n  const store = createStore();\n\n  const app = express();\n  app.use(express.json());\n\n  // ─── Auth Routes ──────────────────────────────────────────────────\n\n  app.post('/auth/register', (req: Request, res: Response): void => {\n    const { username, password } = req.body;\n\n    if (!username || !password || typeof username !== 'string' || typeof password !== 'string') {\n      res.status(400).json({ error: 'Username and password are required' });\n      return;\n    }\n\n    // Check for duplicate username\n    for (const user of store.users.values()) {\n      if (user.username === username) {\n        res.status(409).json({ error: 'Username already exists' });\n        return;\n      }\n    }\n\n    const id = generateId();\n    const passwordHash = hashPassword(password);\n    const user: User = { id, username, passwordHash };\n    store.users.set(id, user);\n\n    const token = generateToken();\n    store.tokens.set(token, id);\n\n    logActivity(store, 'user_registered', id, username, 'user', id, { username });\n\n    res.status(201).json({ id, username, token });\n  });\n\n  app.post('/auth/login', (req: Request, res: Response): void => {\n    const { username, password } = req.body;\n\n    if (!username || !password || typeof username !== 'string' || typeof password !== 'string') {\n      res.status(400).json({ error: 'Username and password are required' });\n      return;\n    }\n\n    // Find user by username\n    let foundUser: User | undefined;\n    for (const user of store.users.values()) {\n      if (user.username === username) {\n        foundUser = user;\n        break;\n      }\n    }\n\n    if (!foundUser) {\n      res.status(401).json({ error: 'Invalid username or password' });\n      return;\n    }\n\n    const passwordHash = hashPassword(password);\n    if (foundUser.passwordHash !== passwordHash) {\n      res.status(401).json({ error: 'Invalid username or password' });\n      return;\n    }\n\n    const token = generateToken();\n    store.tokens.set(token, foundUser.id);\n\n    res.status(200).json({ token });\n  });\n\n  // ─── Auth middleware for all following routes ─────────────────────\n\n  const auth = authMiddleware(store);\n\n  // ─── Folder Routes ────────────────────────────────────────────────\n\n  app.post('/folders', auth, (req: Request, res: Response): void => {\n    const { name, parentId } = req.body;\n    const userId = req.user!.id;\n    const username = req.user!.username;\n\n    if (!name || typeof name !== 'string') {\n      res.status(400).json({ error: 'Folder name is required' });\n      return;\n    }\n\n    if (parentId) {\n      if (typeof parentId !== 'string' || !store.folders.has(parentId)) {\n        res.status(404).json({ error: 'Parent folder not found' });\n        return;\n      }\n      // Check user has editor+ on parent folder to create sub-folder\n      if (!hasMinRole(store, userId, 'folder', parentId, 'editor')) {\n        res.status(403).json({ error: 'Insufficient permissions to create folder here' });\n        return;\n      }\n    }\n\n    const id = generateId();\n    const now = new Date();\n    const folder: Folder = {\n      id,\n      name,\n      parentId: parentId ?? null,\n      ownerId: userId,\n      createdAt: now,\n      updatedAt: now,\n    };\n    store.folders.set(id, folder);\n\n    logActivity(store, 'folder_created', userId, username, 'folder', id, {\n      name,\n      parentId: folder.parentId,\n    });\n\n    res.status(201).json(folder);\n  });\n\n  app.get('/folders', auth, (req: Request, res: Response): void => {\n    const userId = req.user!.id;\n    // List root-level accessible folders\n    const rootFolders: FolderResponse[] = [];\n    for (const folder of store.folders.values()) {\n      if (folder.parentId === null && hasMinRole(store, userId, 'folder', folder.id, 'viewer')) {\n        rootFolders.push(buildFolderResponse(store, folder, userId));\n      }\n    }\n    res.json(rootFolders);\n  });\n\n  app.get('/folders/:id', auth, (req: Request, res: Response): void => {\n    const userId = req.user!.id;\n    const folder = store.folders.get(req.params.id);\n\n    if (!folder) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n\n    if (!hasMinRole(store, userId, 'folder', folder.id, 'viewer')) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    res.json(buildFolderResponse(store, folder, userId));\n  });\n\n  app.put('/folders/:id', auth, (req: Request, res: Response): void => {\n    const userId = req.user!.id;\n    const username = req.user!.username;\n    const { name } = req.body;\n    const folder = store.folders.get(req.params.id);\n\n    if (!folder) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n\n    if (!hasMinRole(store, userId, 'folder', folder.id, 'editor')) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    if (!name || typeof name !== 'string') {\n      res.status(400).json({ error: 'Folder name is required' });\n      return;\n    }\n\n    folder.name = name;\n    folder.updatedAt = new Date();\n\n    logActivity(store, 'folder_updated', userId, username, 'folder', folder.id, {\n      name,\n    });\n\n    res.json(folder);\n  });\n\n  app.delete('/folders/:id', auth, (req: Request, res: Response): void => {\n    const userId = req.user!.id;\n    const username = req.user!.username;\n    const folder = store.folders.get(req.params.id);\n\n    if (!folder) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n\n    if (!hasMinRole(store, userId, 'folder', folder.id, 'owner')) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    deleteFolderCascade(store, folder.id, userId, username);\n\n    res.status(204).send();\n  });\n\n  // ─── Document Routes ──────────────────────────────────────────────\n\n  app.post('/documents', auth, (req: Request, res: Response): void => {\n    const { title, content, folderId } = req.body;\n    const userId = req.user!.id;\n    const username = req.user!.username;\n\n    if (!title || typeof title !== 'string') {\n      res.status(400).json({ error: 'Document title is required' });\n      return;\n    }\n\n    if (!folderId || typeof folderId !== 'string') {\n      res.status(400).json({ error: 'Folder ID is required' });\n      return;\n    }\n\n    if (!store.folders.has(folderId)) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n\n    if (!hasMinRole(store, userId, 'folder', folderId, 'editor')) {\n      res.status(403).json({ error: 'Insufficient permissions to create document in this folder' });\n      return;\n    }\n\n    const id = generateId();\n    const now = new Date();\n    const doc: Document = {\n      id,\n      title,\n      content: content ?? '',\n      folderId,\n      ownerId: userId,\n      createdAt: now,\n      updatedAt: now,\n    };\n    store.documents.set(id, doc);\n\n    logActivity(store, 'document_created', userId, username, 'document', id, {\n      title,\n      folderId,\n    });\n\n    res.status(201).json(doc);\n  });\n\n  app.get('/documents/:id', auth, (req: Request, res: Response): void => {\n    const userId = req.user!.id;\n    const doc = store.documents.get(req.params.id);\n\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n\n    if (!hasMinRole(store, userId, 'document', doc.id, 'viewer')) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    res.json(doc);\n  });\n\n  app.put('/documents/:id', auth, (req: Request, res: Response): void => {\n    const userId = req.user!.id;\n    const username = req.user!.username;\n    const { title, content } = req.body;\n    const doc = store.documents.get(req.params.id);\n\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n\n    if (!hasMinRole(store, userId, 'document', doc.id, 'editor')) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    if (title !== undefined) {\n      if (typeof title !== 'string' || title.length === 0) {\n        res.status(400).json({ error: 'Title must be a non-empty string' });\n        return;\n      }\n      doc.title = title;\n    }\n\n    if (content !== undefined) {\n      if (typeof content !== 'string') {\n        res.status(400).json({ error: 'Content must be a string' });\n        return;\n      }\n      doc.content = content;\n    }\n\n    doc.updatedAt = new Date();\n\n    logActivity(store, 'document_updated', userId, username, 'document', doc.id, {\n      title: doc.title,\n    });\n\n    res.json(doc);\n  });\n\n  app.delete('/documents/:id', auth, (req: Request, res: Response): void => {\n    const userId = req.user!.id;\n    const username = req.user!.username;\n    const doc = store.documents.get(req.params.id);\n\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n\n    if (!hasMinRole(store, userId, 'document', doc.id, 'owner')) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    // Delete associated permissions\n    for (const [permId, perm] of store.permissions) {\n      if (perm.resourceType === 'document' && perm.resourceId === doc.id) {\n        store.permissions.delete(permId);\n      }\n    }\n\n    logActivity(store, 'document_deleted', userId, username, 'document', doc.id, {\n      title: doc.title,\n    });\n\n    store.documents.delete(doc.id);\n\n    res.status(204).send();\n  });\n\n  // ─── Share Route ─────────────────────────────────────────────────\n\n  app.post('/share', auth, (req: Request, res: Response): void => {\n    const { resourceType, resourceId, username, role } = req.body;\n    const userId = req.user!.id;\n    const sharerUsername = req.user!.username;\n\n    // Validate resourceType\n    if (resourceType !== 'folder' && resourceType !== 'document') {\n      res.status(400).json({ error: 'resourceType must be \"folder\" or \"document\"' });\n      return;\n    }\n\n    // Validate role\n    if (!role || !['viewer', 'editor', 'owner'].includes(role)) {\n      res.status(400).json({ error: 'role must be \"viewer\", \"editor\", or \"owner\"' });\n      return;\n    }\n\n    // Check resource exists\n    const resource =\n      resourceType === 'folder'\n        ? store.folders.get(resourceId)\n        : store.documents.get(resourceId);\n\n    if (!resource) {\n      res.status(404).json({ error: 'Resource not found' });\n      return;\n    }\n\n    // Find target user\n    let targetUser: User | undefined;\n    for (const u of store.users.values()) {\n      if (u.username === username) {\n        targetUser = u;\n        break;\n      }\n    }\n\n    if (!targetUser) {\n      res.status(404).json({ error: 'User not found' });\n      return;\n    }\n\n    // Check sharer has editor+ on the resource\n    if (!hasMinRole(store, userId, resourceType, resourceId, 'editor')) {\n      res.status(403).json({ error: 'Insufficient permissions to share this resource' });\n      return;\n    }\n\n    // Check for existing permission and update or create\n    let existingPerm: Permission | undefined;\n    for (const perm of store.permissions.values()) {\n      if (\n        perm.resourceType === resourceType &&\n        perm.resourceId === resourceId &&\n        perm.userId === targetUser.id\n      ) {\n        existingPerm = perm;\n        break;\n      }\n    }\n\n    let permission: Permission;\n    if (existingPerm) {\n      existingPerm.role = role as Role;\n      permission = existingPerm;\n    } else {\n      const permId = generateId();\n      permission = {\n        id: permId,\n        resourceType: resourceType as 'folder' | 'document',\n        resourceId,\n        userId: targetUser.id,\n        role: role as Role,\n      };\n      store.permissions.set(permission.id, permission);\n    }\n\n    logActivity(store, 'share_created', userId, sharerUsername, 'share', permission.id, {\n      resourceType,\n      resourceId,\n      targetUserId: targetUser.id,\n      targetUsername: targetUser.username,\n      role,\n    });\n\n    res.status(201).json(permission);\n  });\n\n  // ─── Activity Route ──────────────────────────────────────────────\n\n  app.get('/activity', auth, (_req: Request, res: Response): void => {\n    const activities = Array.from(store.activities.values())\n      .sort((a, b) => b.timestamp.getTime() - a.timestamp.getTime());\n\n    res.json(activities);\n  });\n\n  return app;\n}\n","structuredPatch":[{"oldStart":158,"oldLines":7,"newStart":158,"newLines":10,"lines":[" "," // ─── Auth Middleware ─────────────────────────────────────────────────"," ","+// Extend Express Request to include authenticated user.","+// eslint-disable-next-line @typescript-eslint/no-namespace"," declare global {","+  // eslint-disable-next-line @typescript-eslint/no-namespace","   namespace Express {","     interface Request {","       user