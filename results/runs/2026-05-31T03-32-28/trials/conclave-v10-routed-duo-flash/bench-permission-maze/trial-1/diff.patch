ray(res.body)).toBe(true);\n      expect(res.body.length).toBeGreaterThanOrEqual(2);\n\n      // Check structure\n      const folderCreation = res.body.find((e: { actionType: string }) => e.actionType === 'folder_created');\n      expect(folderCreation).toBeDefined();\n      expect(folderCreation).toHaveProperty('userId', aliceId);\n      expect(folderCreation).toHaveProperty('username', 'alice');\n      expect(folderCreation).toHaveProperty('targetType', 'folder');\n      expect(folderCreation).toHaveProperty('targetId');\n      expect(folderCreation).toHaveProperty('timestamp');\n\n      // Should be sorted newest first\n      const timestamps = res.body.map((e: { timestamp: string }) => new Date(e.timestamp).getTime());\n      for (let i = 1; i < timestamps.length; i++) {\n        expect(timestamps[i - 1]).toBeGreaterThanOrEqual(timestamps[i]);\n      }\n    });\n\n    it('should log sharing events', async () => {\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Folder' });\n\n      await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          username: 'bob',\n          role: 'viewer',\n        });\n\n      const res = await request\n        .get('/activity')\n        .set('Authorization', `Bearer ${aliceToken}`);\n\n      const shareEntry = res.body.find((e: { actionType: string }) => e.actionType === 'share_created');\n      expect(shareEntry).toBeDefined();\n    });\n  });\n\n  // ─── Cascade Delete ───────────────────────────────────────────────\n\n  describe('Cascade Delete', () => {\n    it('should cascade delete folder with all nested content', async () => {\n      // Create a folder hierarchy\n      const parent = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 