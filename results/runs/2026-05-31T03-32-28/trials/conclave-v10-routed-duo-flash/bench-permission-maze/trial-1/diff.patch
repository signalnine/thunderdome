n', `Bearer ${aliceToken}`)\n        .send({ title: 'Doc', content: 'Text', folderId: folder.body.id });\n\n      const res = await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'document',\n          resourceId: doc.body.id,\n          username: 'bob',\n          role: 'editor',\n        });\n\n      expect(res.status).toBe(201);\n      expect(res.body.role).toBe('editor');\n    });\n\n    it('should reject sharing non-existent resource', async () => {\n      const res = await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: 'nonexistent',\n          username: 'bob',\n          role: 'viewer',\n        });\n      expect(res.status).toBe(404);\n    });\n\n    it('should reject sharing with non-existent user', async () => {\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Folder' });\n\n      const res = await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          username: 'nonexistent',\n          role: 'viewer',\n        });\n      expect(res.status).toBe(404);\n    });\n\n    it('should reject sharing without editor permission on resource', async () => {\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Private' });\n\n      const res = await request\n        .post('/share')\n        .set('Authorization', `Bearer ${bobToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          username: 'charlie',\n          role: 'viewer',\n        });\n      expect(res.status).toBe(403);\n    });\n\n    it('should reject sharing with invalid role', async () => {\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Folder' });\n\n      const res = await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          username: 'bob',\n          role: 'superadmin',\n        });\n      expect(res.status).toBe(400);\n    });\n\n    it('should allow viewer to read a shared folder', async () => {\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'SharedFolder' });\n\n      await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          username: 'bob',\n          role: 'viewer',\n        });\n\n      const res = await request\n        .get(`/folders/${folder.body.id}`)\n        .set('Authorization', `Bearer ${bobToken}`);\n      expect(res.status).toBe(200);\n    });\n\n    it('should inherit folder permissions to documents inside it', async () => {\n      // Alice creates a folder and a document inside it\n      const folder = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'SharedFolder' });\n\n      const doc = await request\n        .post('/documents')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ title: 'InnerDoc', content: 'Secret', folderId: folder.body.id });\n\n      // Alice shares folder with Bob as viewer\n      await request\n        .post('/share')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({\n          resourceType: 'folder',\n          resourceId: folder.body.id,\n          username: 'bob',\n          role: 'viewer',\n  