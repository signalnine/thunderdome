+export interface User {
+  id: string;
+  username: string;
+  passwordHash: string;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+export interface Permission {
+  id: string;
+  resourceType: 'folder' | 'document';
+  resourceId: string;
+  userId: string;
+  role: Role;
+}
+
+export interface ActivityLog {
+  id: string;
+  actionType: string;
+  userId: string;
+  username: string;
+  targetType: string;
+  targetId: string;
+  details: Record<string, unknown>;
+  timestamp: Date;
+}
+
+export type Role = 'viewer' | 'editor' | 'owner';
+
+export interface FolderResponse {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: Date;
+  updatedAt: Date;
+  children: {
+    folders: FolderChildResponse[];
+    documents: DocumentChildResponse[];
+  };
+}
+
+export interface FolderChildResponse {
+  id: string;
+  name: string;
+  parentId: string | null;
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+export interface DocumentChildResponse {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  createdAt: Date;
+  updatedAt: Date;
+}
