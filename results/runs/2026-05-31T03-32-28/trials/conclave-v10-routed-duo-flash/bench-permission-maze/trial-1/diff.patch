rty('username', 'dave');\n      expect(res.body).toHaveProperty('token');\n      expect(typeof res.body.token).toBe('string');\n    });\n\n    it('should reject registration with missing fields', async () => {\n      const res1 = await request\n        .post('/auth/register')\n        .send({ username: 'dave' });\n      expect(res1.status).toBe(400);\n\n      const res2 = await request\n        .post('/auth/register')\n        .send({ password: 'secret' });\n      expect(res2.status).toBe(400);\n\n      const res3 = await request\n        .post('/auth/register')\n        .send({});\n      expect(res3.status).toBe(400);\n    });\n\n    it('should reject duplicate username', async () => {\n      const res = await request\n        .post('/auth/register')\n        .send({ username: 'alice', password: 'another' });\n      expect(res.status).toBe(409);\n    });\n\n    it('should login with valid credentials', async () => {\n      const res = await request\n        .post('/auth/login')\n        .send({ username: 'alice', password: 'password123' });\n\n      expect(res.status).toBe(200);\n      expect(res.body).toHaveProperty('token');\n      expect(typeof res.body.token).toBe('string');\n    });\n\n    it('should reject login with wrong username', async () => {\n      const res = await request\n        .post('/auth/login')\n        .send({ username: 'nonexistent', password: 'password123' });\n      expect(res.status).toBe(401);\n    });\n\n    it('should reject login with wrong password', async () => {\n      const res = await request\n        .post('/auth/login')\n        .send({ username: 'alice', password: 'wrongpassword' });\n      expect(res.status).toBe(401);\n    });\n  });\n\n  // ─── Auth Middleware ───────────────────────────────────────────────\n\n  describe('Auth Middleware', () => {\n    it('should reject requests without auth header', async () => {\n      const res = await request.post('/folders').send({ name: 'Test' });\n      expect(res.status).toBe(401);\n    });\n\n    it('should reject requests with invalid token', async () => {\n      const res = await request\n        .post('/folders')\n        .set('Authorization', 'Bearer invalidtoken123')\n        .send({ name: 'Test' });\n      expect(res.status).toBe(401);\n    });\n\n    it('should reject requests with malformed auth header', async () => {\n      const res = await request\n        .post('/folders')\n        .set('Authorization', 'Invalid')\n        .send({ name: 'Test' });\n      expect(res.status).toBe(401);\n    });\n\n    it('should allow authenticated requests', async () => {\n      const res = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'TestFolder' });\n      expect(res.status).toBe(201);\n    });\n  });\n\n  // ─── Folders ──────────────────────────────────────────────────────\n\n  describe('Folders', () => {\n    it('should create a root folder', async () => {\n      const res = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'MyFolder' });\n\n      expect(res.status).toBe(201);\n      expect(res.body).toHaveProperty('id');\n      expect(res.body).toHaveProperty('name', 'MyFolder');\n      expect(res.body).toHaveProperty('parentId', null);\n      expect(res.body).toHaveProperty('ownerId', aliceId);\n      expect(res.body).toHaveProperty('createdAt');\n      expect(res.body).toHaveProperty('updatedAt');\n    });\n\n    it('should reject folder creation without name', async () => {\n      const res = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({});\n      expect(res.status).toBe(400);\n    });\n\n    it('should create a nested folder', async () => {\n      const parent = await request\n        .post('/folders')\n        .set('Authorization', `Bearer ${aliceToken}`)\n        .send({ name: 'Parent' });\n\n      const child = await request\n    