ion', `Bearer ${aliceToken}`);\n      expect(delRes.status).toBe(204);\n    });\n  });\n});\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":6,"lines":[" import { describe, it, expect, beforeEach } from 'vitest';"," import supertest from 'supertest';","-import { createApp } from '../src/index.js';","+import { createApp } from '../src/index.ts';"," "," describe('Document Management API', () => {","   let app: ReturnType<typeof createApp>;"]}],"userModified":false,"replaceAll":false}}
