+
+    it('should return 403 when non-owner tries to delete document', async () => {
+      const doc = await request
+        .post('/documents')
+        .set('Authorization', `Bearer ${aliceToken}`)
+        .send({ title: 'MyDoc', content: 'Hello', folderId });
+
+      const res = await request
+        .delete(`/documents/${doc.body.id}`)
+        .set('Authorization', `Bearer ${bobToken}`);
+      expect(res.status).toBe(403);
+    });
+  });
+
+  // ─── Sharing & Permissions ────────────────────────────────────────
+
+  describe('Sharing & Permissions', () => {
+    it('should share a folder with another user', async () => {
+      const folder = await request
+        .post('/folders')
+        .set('Authorization', `Bearer ${aliceToken}`)
+        .send({ name: 'SharedFolder' });
+
+      const res = await request
+        .post('/share')
+        .set('Authorization', `Bearer ${aliceToken}`)
+        .send({
+          resourceType: 'folder',
+          resourceId: folder.body.id,
