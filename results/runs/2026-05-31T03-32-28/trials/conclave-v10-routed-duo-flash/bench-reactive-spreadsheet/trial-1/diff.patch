+import { describe, it, expect } from 'vitest';
+import { DepGraph } from './depGraph.js';
+
+describe('DepGraph', () => {
+  it('tracks simple dependencies', () => {
+    const g = new DepGraph();
+    g.setDependencies('B1', ['A1']);
+    expect(g.getDependents('A1')).toEqual(['B1']);
+  });
+
+  it('returns empty dependents for a cell with no dependents', () => {
+    const g = new DepGraph();
+    expect(g.getDependents('A1')).toEqual([]);
+  });
+
+  it('updates dependencies when re-set', () => {
+    const g = new DepGraph();
+    g.setDependencies('C1', ['A1']);
+    g.setDependencies('C1', ['B1']);
+    expect(g.getDependents('A1')).toEqual([]);
+    expect(g.getDependents('B1')).toEqual(['C1']);
+  });
+
+  it('allows valid dependencies', () => {
+    const g = new DepGraph();
+    expect(() => g.setDependencies('B1', ['A1'])).not.toThrow();
+    expect(() => g.setDependencies('C1', ['B1'])).not.toThrow();
+  });
+
+  it('detects direct cycle (A1 depends on B1, B1 depends on A1)', () => {
+    const g = new DepGraph();
+    g.setDependencies('A1', ['B1']);
+    expect(() => g.setDependencies('B1', ['A1'])).toThrow(/circular/i);
+  });
+
+  it('detects indirect cycle through multiple cells', () => {
+    const g = new DepGraph();
+    g.setDependencies('A1', ['B1']);
+    g.setDependencies('B1', ['C1']);
+    expect(() => g.setDependencies('C1', ['A1'])).toThrow(/circular/i);
+  });
+
+  it('detects self-referencing cycle', () => {
+    const g = new DepGraph();
+    expect(() => g.setDependencies('A1', ['A1'])).toThrow(/circular/i);
+  });
+
+  it('detects deeper indirect cycle', () => {
+    const g = new DepGraph();
+    g.setDependencies('A1', ['B1']);
+    g.setDependencies('B1', ['C1']);
+    g.setDependencies('C1', ['D1']);
+    expect(() => g.setDependencies('D1', ['A1'])).toThrow(/circular/i);
+  });
+
+  it('provides topological order for recomputation', () => {
+    const g = new DepGraph();
+    g.setDependencies('B1', ['A1']);
+    g.setDependencies('C1', ['B1']);
+    g.setDependencies('D1', ['A1']);
+
+    const order = g.getRecomputeOrder(['A1']);
+    // A1 should be first (changed), then B1 and D1 (direct dependents), then C1 (transitive)
+    expect(order.indexOf('A1')).toBeLessThan(order.indexOf('B1'));
+    expect(order.indexOf('A1')).toBeLessThan(order.indexOf('D1'));
+    expect(order.indexOf('B1')).toBeLessThan(order.indexOf('C1'));
+    expect(order.indexOf('D1')).toBeLessThan(order.indexOf('C1'));
+  });
+
+  it('returns only changed cells when no dependents', () => {
+    const g = new DepGraph();
+    g.setDependencies('B1', ['A1']);
+    const order = g.getRecomputeOrder(['C1']);
+    expect(order).toEqual(['C1']);
+  });
+
+  it('handles multiple root changes', () => {
+    const g = new DepGraph();
+    g.setDependencies('B1', ['A1']);
+    g.setDependencies('C1', ['A1']);
+    g.setDependencies('D1', ['B1']);
+
+    const order = g.getRecomputeOrder(['A1', 'C1']);
+    expect(order).toContain('A1');
+    expect(order).toContain('B1');
+    expect(order).toContain('C1');
+    expect(order).toContain('D1');
+    // A1 before B1 before D1
+    expect(order.indexOf('A1')).toBeLessThan(order.indexOf('B1'));
+    expect(order.indexOf('B1')).toBeLessThan(order.indexOf('D1'));
+  });
+
+  it('clears outgoing dependencies when clearing a cell', () => {
+    const g = new DepGraph();
+    g.setDependencies('B1', ['A1']);
+    g.clearDependencies('B1');
+    expect(g.getDependents('A1')).toEqual([]);
+  });
+
+  it('provides correct recompute order for complex DAG', () => {
+    const g = new DepGraph();
+    // A1 -> B1 -> C1 -> D1
+    // A1 -> E1
+    g.setDependencies('B1', ['A1']);
+    g.setDependencies('C1', ['B1']);
+    g.setDependencies('D1', ['C1']);
+    g.setDependencies('E1', ['A1']);
+
+    const order = g.getRecomputeOrder(['A1']);
+    expect(order.indexOf('A1')).toBeLessThan(order.indexOf('B1'));
+    expect(order.indexOf('A1')).toBeLessThan(order.indexOf('E1'));
+    expect(order.indexOf('B1')).toBeLessThan(order.indexOf('C1'));
+    expect(order.indexOf('C1')).toBeLessThan(order.indexOf('D1'));
+  });
+
+  it('handles a diamond dependency', () => {
+    const g = new DepGraph();
+    // A1 -> B1, A1 -> C1, B1 -> D1, C1 -> D1
+    g.setDependencies('B1', ['A1']);
+    g.setDependencies('C1', ['A1']);
+    g.setDependencies('D1', ['B1', 'C1']);
+
+    const order = g.getRecomputeOrder(['A1']);
+    // B1 and C1 must come before D1
+    expect(order.indexOf('B1')).toBeLessThan(order.indexOf('D1'));
+    expect(order.indexOf('C1')).toBeLessThan(order.indexOf('D1'));
+  });
+});
