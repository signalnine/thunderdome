+import { describe, it, expect } from 'vitest';
+import { expandRange } from './range.js';
+
+describe('expandRange', () => {
+  it('expands column range A1:A5', () => {
+    const cells = expandRange('A1:A5');
+    expect(cells).toEqual(['A1', 'A2', 'A3', 'A4', 'A5']);
+  });
+
+  it('expands row range A1:C1', () => {
+    const cells = expandRange('A1:C1');
+    expect(cells).toEqual(['A1', 'B1', 'C1']);
+  });
+
+  it('expands block range A1:C3', () => {
+    const cells = expandRange('A1:C3');
+    expect(cells).toEqual([
+      'A1', 'B1', 'C1',
+      'A2', 'B2', 'C2',
+      'A3', 'B3', 'C3',
+    ]);
+  });
+
+  it('expands block range from low to high columns and rows', () => {
+    const cells = expandRange('A1:C3');
+    expect(cells).toHaveLength(9);
+  });
+
+  it('handles single cell range A1:A1', () => {
+    const cells = expandRange('A1:A1');
+    expect(cells).toEqual(['A1']);
+  });
+
+  it('handles reverse column range A5:A1', () => {
+    const cells = expandRange('A5:A1');
+    expect(cells).toEqual(['A1', 'A2', 'A3', 'A4', 'A5']);
+  });
+
+  it('handles reverse row range C1:A1', () => {
+    const cells = expandRange('C1:A1');
+    expect(cells).toEqual(['A1', 'B1', 'C1']);
+  });
+
+  it('handles reverse block range C3:A1', () => {
+    const cells = expandRange('C3:A1');
+    expect(cells).toEqual([
+      'A1', 'B1', 'C1',
+      'A2', 'B2', 'C2',
+      'A3', 'B3', 'C3',
+    ]);
+  });
+
+  it('handles multi-letter columns in range AA1:AB3', () => {
+    const cells = expandRange('AA1:AB3');
+    expect(cells).toEqual([
+      'AA1', 'AB1',
+      'AA2', 'AB2',
+      'AA3', 'AB3',
+    ]);
+  });
+
+  it('handles multi-digit rows in range A10:A12', () => {
+    const cells = expandRange('A10:A12');
+    expect(cells).toEqual(['A10', 'A11', 'A12']);
+  });
+
+  it('expands a full block B2:D4 correctly', () => {
+    const cells = expandRange('B2:D4');
+    expect(cells).toEqual([
+      'B2', 'C2', 'D2',
+      'B3', 'C3', 'D3',
+      'B4', 'C4', 'D4',
+    ]);
+  });
+
+  it('throws on invalid range format', () => {
+    expect(() => expandRange('invalid')).toThrow();
+  });
+});
