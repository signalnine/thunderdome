+++ b/src/index.ts
@@ -0,0 +1,169 @@
+import type { ASTNode, CellValue } from './types.js';
+import { parseFormula } from './formulaParser.js';
+import { evaluate } from './evaluator.js';
+import { DepGraph } from './depGraph.js';
+import { expandRange } from './range.js';
+
+interface CellContent {
+  raw: string | number | boolean;
+  value: CellValue;
+  formula: boolean;
+}
+
+/**
+ * Walk the AST and collect all cell references, expanding ranges.
+ */
+function extractCellRefs(node: ASTNode): string[] {
+  const refs = new Set<string>();
+
+  function walk(n: ASTNode): void {
+    switch (n.type) {
+      case 'number':
+      case 'string':
+      case 'boolean':
+        break;
+      case 'cellRef':
+        refs.add(n.ref);
+        break;
+      case 'range':
+        for (const cell of expandRange(`${n.start}:${n.end}`)) {
+          refs.add(cell);
+        }
+        break;
+      case 'binaryOp':
+        walk(n.left);
+        walk(n.right);
+        break;
+      case 'functionCall':
+        for (const arg of n.args) {
+          walk(arg);
+        }
+        break;
+    }
+  }
+
+  walk(node);
+  return Array.from(refs);
+}
+
+export class Spreadsheet {
+  private cells: Map<string, CellContent> = new Map();
+  private depGraph: DepGraph = new DepGraph();
+
+  set(cell: string, value: string | number | boolean): void {
+    const key = cell.toUpperCase();
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      this.setFormula(key, value);
+    } else {
+      this.setValue(key, value);
+    }
+  }
+
+  private setFormula(key: string, formulaValue: string): void {
+    const formulaStr = formulaValue.substring(1).trim();
+
+    // Empty formula — treat as clearing or storing empty
+    if (!formulaStr) {
+      this.cells.delete(key);
+      this.depGraph.clearDependencies(key);
+      return;
+    }
+
+    const ast = parseFormula(formulaStr);
+    const refs = extractCellRefs(ast);
+
+    // Remove old formula's dependency edges
+    this.depGraph.clearDependencies(key);
+
+    // Set up new dependency edges (may throw on cycle)
+    // Important: we clear first, then set, so there's no stale edges
+    this.depGraph.setDependencies(key, refs);
+
+    // Evaluate the formula
+    const evalResult = evaluate(ast, (ref) => {
+      const content = this.cells.get(ref);
+      return content ? content.value : null;
+    });
+    const computedValue = Array.isArray(evalResult) ? null : evalResult as CellValue;
+
+    this.cells.set(key, {
+      raw: formulaValue,
+      value: computedValue,
+      formula: true,
+    });
+
+    // Recompute all transitive dependents
+    this.recomputeDependents(key);
+  }
+
+  private setValue(key: string, raw: string | number | boolean): void {
+    // Remove any old formula dependencies
+    this.depGraph.clearDependencies(key);
+
+    const computedValue = raw as CellValue;
+    this.cells.set(key, {
+      raw,
+      value: computedValue,
+      formula: false,
+    });
+
+    // Recompute all transitive dependents
+    this.recomputeDependents(key);
+  }
+
+  /**
+   * Recompute all cells that depend on the changed cell, in topological order.
+   */
+  private recomputeDependents(changedCell: string): void {
+    const order = this.depGraph.getRecomputeOrder([changedCell]);
+
+    // Skip index 0 (the changed cell itself — already updated)
+    for (let i = 1; i < order.length; i++) {
+      const cell = order[i];
+      const content = this.cells.get(cell);
+
+      if (content && content.formula && typeof content.raw === 'string') {
+        const formulaStr = content.raw.substring(1).trim();
+        if (formulaStr) {
+          try {
+            const ast = parseFormula(formulaStr);
+            const newEval = evaluate(ast, (ref) => {
+              const c = this.cells.get(ref);
+              return c ? c.value : null;
+            });
+            const newValue = Array.isArray(newEval) ? null : newEval as CellValue;
+            this.cells.set(cell, { ...content, value: newValue });
+          } catch {
+            // If evaluation fails, keep the old value
+          }
+        }
+      }
+    }
+  }
+
+  get(cell: string): CellValue {
+    const key = cell.toUpperCase();
+    const content = this.cells.get(key);
+    return content ? content.value : null;
+  }
+
+  getDisplay(cell: string): string {
+    const value = this.get(cell);
+    if (value === null || value === undefined) {
+      return '';
+    }
+    if (typeof value === 'boolean') {
+      return value ? 'true' : 'false';
+    }
+    return String(value);
+  }
+
+  getCells(): Map<string, CellValue> {
+    const result = new Map<string, CellValue>();
+    for (const [key, content] of this.cells) {
+      result.set(key, content.value);
+    }
+    return result;
+  }
+}
