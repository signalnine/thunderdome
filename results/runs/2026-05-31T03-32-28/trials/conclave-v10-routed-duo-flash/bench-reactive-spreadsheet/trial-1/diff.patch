+import type { ASTNode } from './types.js';
+
+export type Token =
+  | { type: 'number'; value: number }
+  | { type: 'string'; value: string }
+  | { type: 'boolean'; value: boolean }
+  | { type: 'cellRef'; value: string }
+  | { type: 'identifier'; value: string }
+  | { type: 'plus' }
+  | { type: 'minus' }
+  | { type: 'star' }
+  | { type: 'slash' }
+  | { type: 'gt' }
+  | { type: 'lt' }
+  | { type: 'gte' }
+  | { type: 'lte' }
+  | { type: 'eq' }
+  | { type: 'ne' }
+  | { type: 'lparen' }
+  | { type: 'rparen' }
+  | { type: 'comma' }
+  | { type: 'colon' }
+  | { type: 'eof' };
+
+// -------- Lexer ----------
+
+export function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+
+  while (i < input.length) {
+    // Skip whitespace
+    if (/\s/.test(input[i])) {
+      i++;
+      continue;
+    }
+
+    // String literals
+    if (input[i] === '"') {
+      i++; // skip opening quote
+      let str = '';
+      while (i < input.length && input[i] !== '"') {
+        str += input[i];
+        i++;
+      }
+      if (i < input.length) {
+        i++; // skip closing quote
+      }
+      tokens.push({ type: 'string', value: str });
+      continue;
+    }
+
+    // Numbers (including decimals)
+    if (/\d/.test(input[i])) {
+      let num = '';
+      while (i < input.length && /\d/.test(input[i])) {
+        num += input[i];
+        i++;
+      }
+      if (i < input.length && input[i] === '.') {
+        num += '.';
+        i++;
+        while (i < input.length && /\d/.test(input[i])) {
+          num += input[i];
+          i++;
+        }
+      }
+      tokens.push({ type: 'number', value: parseFloat(num) });
+      continue;
+    }
+
+    // Letters (identifiers or cell references)
+    if (/[A-Za-z]/.test(input[i])) {
+      let word = '';
+      while (i < input.length && /[A-Za-z0-9]/.test(input[i])) {
+        word += input[i];
+        i++;
+      }
+
+      // Check for boolean literals
+      if (word === 'true') {
+        tokens.push({ type: 'boolean', value: true });
+        continue;
+      }
+      if (word === 'false') {
+        tokens.push({ type: 'boolean', value: false });
+        continue;
+      }
+
+      // Check if it's a cell reference (letters followed by digits)
+      if (/^[A-Za-z]+\d+$/.test(word)) {
+        tokens.push({ type: 'cellRef', value: word.toUpperCase() });
+        continue;
+      }
+
+      // Otherwise it's an identifier (function name)
+      tokens.push({ type: 'identifier', value: word.toUpperCase() });
+      continue;
+    }
+
+    // Multi-character operators
+    if (input[i] === '>') {
+      if (i + 1 < input.length && input[i + 1] === '=') {
+        tokens.push({ type: 'gte' });
+        i += 2;
+        continue;
+      }
+      tokens.push({ type: 'gt' });
+      i++;
+      continue;
+    }
+
+    if (input[i] === '<') {
+      if (i + 1 < input.length && input[i + 1] === '=') {
+        tokens.push({ type: 'lte' });
+        i += 2;
+        continue;
+      }
+      if (i + 1 < input.length && input[i + 1] === '>') {
+        tokens.push({ type: 'ne' });
+        i += 2;
+        continue;
+      }
+      tokens.push({ type: 'lt' });
+      i++;
+      continue;
+    }
+
+    // Single-character tokens
+    switch (input[i]) {
+      case '+': tokens.push({ type: 'plus' }); break;
+      case '-': tokens.push({ type: 'minus' }); break;
+      case '*': tokens.push({ type: 'star' }); break;
+      case '/': tokens.push({ type: 'slash' }); break;
+      case '(': tokens.push({ type: 'lparen' }); break;
+      case ')': tokens.push({ type: 'rparen' }); break;
+      case ',': tokens.push({ type: 'comma' }); break;
+      case ':': tokens.push({ type: 'colon' }); break;
+      case '=': tokens.push({ type: 'eq' }); break;
+      default: throw new Error(`Unexpected character: ${input[i]}`);
+    }
+    i++;
+  }
+
+  tokens.push({ type: 'eof' });
+  return tokens;
+}
+
+// -------- Parser ----------
+
+class Parser {
+  private tokens: Token[];
+  private pos: number;
+
+  constructor(tokens: Token[]) {
+    this.tokens = tokens;
+    this.pos = 0;
+  }
+
+  private peek(): Token {
+    return this.tokens[this.pos];
+  }
+
+  private consume(): Token {
+    return this.tokens[this.pos++];
+  }
+
+  private expect(type: Token['type']): Token {
+    const token = this.peek();
+    if (token.type !== type) {
+      throw new Error(`Expected ${type} but got ${token.type}`);
+    }
+    return this.consume();
+  }
+
+  parse(): ASTNode {
+    const result = this.expression();
+    if (this.peek().type !== 'eof') {
+      throw new Error(`Unexpected token after expression: ${this.peek().type}`);
+    }
+    return result;
+  }
+
+  private expression(): ASTNode {
+    return this.comparison();
+  }
+
+  private comparison(): ASTNode {
+    let left = this.addition();
+
+    while (
+      this.peek().type === 'gt' || this.peek().type === 'lt' ||
+      this.peek().type === 'gte' || this.peek().type === 'lte' ||
+      this.peek().type === 'eq' || this.peek().type === 'ne'
+    ) {
+      const opToken = this.consume();
+      const opMap: Record<string, string> = {
+        gt: '>', lt: '<', gte: '>=', lte: '<=', eq: '=', ne: '<>',
+      };
+      const op = opMap[opToken.type];
+      const right = this.addition();
+      left = { type: 'binaryOp', op, left, right };
+    }
+
+    return left;
+  }
+
+  private addition(): ASTNode {
+    let left = this.multiplication();
+
+    while (this.peek().type === 'plus' || this.peek().type === 'minus') {
+      const opToken = this.consume();
+      const op = opToken.type === 'plus' ? '+' : '-';
+      const right = this.multiplication();
+      left = { type: 'binaryOp', op, left, right };
+    }
+
+    return left;
+  }
+
+  private multiplication(): ASTNode {
+    let left = this.unary();
+
+    while (this.peek().type === 'star' || this.peek().type === 'slash') {
+      const opToken = this.consume();
+      const op = opToken.type === 'star' ? '*' : '/';
+      const right = this.unary();
+      left = { type: 'binaryOp', op, left, right };
+    }
+
+    return left;
+  }
+
+  private unary(): ASTNode {
+    if (this.peek().type === 'minus') {
+      this.consume(); // consume '-'
+      const right = this.unary();
+      // Treat unary minus as 0 - value
+      return { type: 'binaryOp', op: '-', left: { type: 'number', value: 0 }, right };
+    }
+    return this.primary();
+  }
+
+  private primary(): ASTNode {
+    const token = this.peek();
+
+    if (token.type === 'number') {
+      this.consume();
+      return { type: 'number', value: token.value };
+    }
+
+    if (token.type === 'string') {
+      this.consume();
+      return { type: 'string', value: token.value };
+    }
+
+    if (token.type === 'boolean') {
+      this.consume();
+      return { type: 'boolean', value: token.value };
+    }
+
+    if (token.type === 'cellRef') {
+      const refVal = token.value; // narrow type before consuming
+      this.consume();
+      // Check for range: cellRef : cellRef
+      if (this.peek().type === 'colon') {
+        this.consume(); // consume ':'
+        const endToken = this.expect('cellRef');
+        const endVal = (endToken as Extract<Token, { type: 'cellRef' }>).value;
+        return { type: 'range', start: refVal, end: endVal };
+      }
+      return { type: 'cellRef', ref: refVal };
+    }
+
+    if (token.type === 'identifier') {
+      this.consume();
+      const name = token.value;
+      this.expect('lparen');
+      const args: ASTNode[] = [];
+
+      if (this.peek().type !== 'rparen') {
+        args.push(this.expression());
+        while (this.peek().type === 'comma') {
+          this.consume();
+          args.push(this.expression());
+        }
+      }
+
+      this.expect('rparen');
+      return { type: 'functionCall', name, args };
+    }
+
+    if (token.type === 'lparen') {
+      this.consume();
+      const expr = this.expression();
+      this.expect('rparen');
+      return expr;
+    }
+
+    throw new Error(`Unexpected token: ${token.type}`);
+  }
+}
+
+export function parseFormula(input: string): ASTNode {
+  if (!input || input.trim().length === 0) {
+    throw new Error('Empty formula');
+  }
+  const tokens = tokenize(input);
+  const parser = new Parser(tokens);
+  return parser.parse();
+}
