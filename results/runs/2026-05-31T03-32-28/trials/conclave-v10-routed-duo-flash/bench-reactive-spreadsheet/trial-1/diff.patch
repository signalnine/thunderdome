', () => {\n  it('evaluates number literals', () => {\n    expect(evalFormula('42')).toBe(42);\n    expect(evalFormula('3.14')).toBe(3.14);\n  });\n\n  it('evaluates string literals', () => {\n    expect(evalFormula('\"hello\"')).toBe('hello');\n  });\n\n  it('evaluates boolean literals', () => {\n    expect(evalFormula('true')).toBe(true);\n    expect(evalFormula('false')).toBe(false);\n  });\n\n  it('evaluates cell references', () => {\n    const getValue = getGetValue({ A1: 10 });\n    expect(evalFormula('A1', getValue)).toBe(10);\n  });\n\n  it('returns null for empty cell references', () => {\n    expect(evalFormula('A1')).toBeNull();\n  });\n\n  it('evaluates addition', () => {\n    const getValue = getGetValue({ A1: 10, A2: 20 });\n    expect(evalFormula('A1+A2', getValue)).toBe(30);\n  });\n\n  it('evaluates subtraction', () => {\n    expect(evalFormula('10-3')).toBe(7);\n  });\n\n  it('evaluates multiplication', () => {\n    expect(evalFormula('3*4')).toBe(12);\n  });\n\n  it('evaluates division', () => {\n    expect(evalFormula('10/2')).toBe(5);\n  });\n\n  it('respects operator precedence', () => {\n    expect(evalFormula('1+2*3')).toBe(7);\n    expect(evalFormula('2*3+1')).toBe(7);\n  });\n\n  it('respects parentheses', () => {\n    expect(evalFormula('(1+2)*3')).toBe(9);\n  });\n\n  it('evaluates chained arithmetic', () => {\n    expect(evalFormula('1+2+3')).toBe(6);\n    expect(evalFormula('10-3-2')).toBe(5);\n    expect(evalFormula('2*3*4')).toBe(24);\n  });\n\n  describe('comparison operators', () => {\n    it('evaluates >', () => {\n      expect(evalFormula('5>3')).toBe(true);\n      expect(evalFormula('3>5')).toBe(false);\n    });\n\n    it('evaluates <', () => {\n      expect(evalFormula('3<5')).toBe(true);\n      expect(evalFormula('5<3')).toBe(false);\n    });\n\n    it('evaluates >=', () => {\n      expect(evalFormula('5>=3')).toBe(true);\n      expect(evalFormula('5>=5')).toBe(true);\n      expect(evalFormula('3>=5')).toBe(false);\n    });\n\n