diff --git a/src/cellRef.test.ts b/src/cellRef.test.ts
new file mode 100644
index 0000000..5471473
--- /dev/null
+++ b/src/cellRef.test.ts
@@ -0,0 +1,128 @@
+import { describe, it, expect } from 'vitest';
+import { parseCellRef, cellRefToString, colToLetters, lettersToCol } from './cellRef.js';
+
+describe('cellRef', () => {
+  describe('parseCellRef', () => {
+    it('parses A1', () => {
+      expect(parseCellRef('A1')).toEqual({ col: 0, row: 0 });
+    });
+
+    it('parses B2', () => {
+      expect(parseCellRef('B2')).toEqual({ col: 1, row: 1 });
+    });
+
+    it('parses Z100', () => {
+      expect(parseCellRef('Z100')).toEqual({ col: 25, row: 99 });
+    });
+
+    it('parses AA1', () => {
+      expect(parseCellRef('AA1')).toEqual({ col: 26, row: 0 });
+    });
+
+    it('parses AZ1', () => {
+      expect(parseCellRef('AZ1')).toEqual({ col: 51, row: 0 });
+    });
+
+    it('parses BA1', () => {
+      expect(parseCellRef('BA1')).toEqual({ col: 52, row: 0 });
+    });
+
+    it('parses ZZ999', () => {
+      expect(parseCellRef('ZZ999')).toEqual({ col: 701, row: 998 });
+    });
+
+    it('parses AAA1', () => {
+      expect(parseCellRef('AAA1')).toEqual({ col: 702, row: 0 });
+    });
+
+    it('parses single letter A', () => {
+      expect(parseCellRef('A1').col).toBe(0);
+    });
+
+    it('parses single letter Z', () => {
+      expect(parseCellRef('Z1').col).toBe(25);
+    });
+  });
+
+  describe('colToLetters', () => {
+    it('converts 0 to A', () => {
+      expect(colToLetters(0)).toBe('A');
+    });
+
+    it('converts 25 to Z', () => {
+      expect(colToLetters(25)).toBe('Z');
+    });
+
+    it('converts 26 to AA', () => {
+      expect(colToLetters(26)).toBe('AA');
+    });
+
+    it('converts 51 to AZ', () => {
+      expect(colToLetters(51)).toBe('AZ');
+    });
+
+    it('converts 52 to BA', () => {
+      expect(colToLetters(52)).toBe('BA');
+    });
+
+    it('converts 701 to ZZ', () => {
+      expect(colToLetters(701)).toBe('ZZ');
+    });
+
+    it('converts 702 to AAA', () => {
+      expect(colToLetters(702)).toBe('AAA');
+    });
+  });
+
+  describe('lettersToCol', () => {
+    it('converts A to 0', () => {
+      expect(lettersToCol('A')).toBe(0);
+    });
+
+    it('converts Z to 25', () => {
+      expect(lettersToCol('Z')).toBe(25);
+    });
+
+    it('converts AA to 26', () => {
+      expect(lettersToCol('AA')).toBe(26);
+    });
+
+    it('converts AZ to 51', () => {
+      expect(lettersToCol('AZ')).toBe(51);
+    });
+
+    it('converts BA to 52', () => {
+      expect(lettersToCol('BA')).toBe(52);
+    });
+
+    it('converts ZZ to 701', () => {
+      expect(lettersToCol('ZZ')).toBe(701);
+    });
+
+    it('converts AAA to 702', () => {
+      expect(lettersToCol('AAA')).toBe(702);
+    });
+  });
+
+  describe('cellRefToString', () => {
+    it('converts {col:0,row:0} to A1', () => {
+      expect(cellRefToString({ col: 0, row: 0 })).toBe('A1');
+    });
+
+    it('converts {col:1,row:1} to B2', () => {
+      expect(cellRefToString({ col: 1, row: 1 })).toBe('B2');
+    });
+
+    it('converts {col:25,row:99} to Z100', () => {
+      expect(cellRefToString({ col: 25, row: 99 })).toBe('Z100');
+    });
+
+    it('converts {col:26,row:0} to AA1', () => {
+      expect(cellRefToString({ col: 26, row: 0 })).toBe('AA1');
+    });
+
+    it('converts {col:701,row:998} to ZZ999', () => {
+      expect(cellRefToString({ col: 701, row: 998 })).toBe('ZZ999');
+    });
+  });
+});
diff --git a/src/cellRef.ts b/src/cellRef.ts
new file mode 100644
index 0000000..7a0b31b
--- /dev/null
+++ b/src/cellRef.ts
@@ -0,0 +1,34 @@
+import type { CellRef } from './types.js';
+
+export function parseCellRef(ref: string): CellRef {
+  const match = ref.match(/^([A-Za-z]+)(\d+)$/);
+  if (!match) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  const col = lettersToCol(match[1].toUpperCase());
+  const row = parseInt(match[2], 10) - 1;
+  return { col, row };
+}
+
+export function cellRefToString(ref: CellRef): string {
+  return `${colToLetters(ref.col)}${ref.row + 1}`;
+}
+
+export function lettersToCol(letters: string): number {
+  let col = 0;
+  for (let i = 0; i < letters.length; i++) {
+    col = col * 26 + (letters.charCodeAt(i) - 65 + 1);
+  }
+  return col - 1;
+}
+
+export function colToLetters(col: number): string {
+  let result = '';
+  let n = col + 1;
+  while (n > 0) {
+    n--;
+    result = String.fromCharCode(65 + (n % 26)) + result;
+    n = Math.floor(n / 26);
+  }
+  return result;
+}
