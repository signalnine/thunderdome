+import { describe, it, expect } from 'vitest';
+import type { CellValue } from './types.js';
+import { evaluate } from './evaluator.js';
+import { parseFormula } from './formulaParser.js';
+
+function evalFormula(formula: string, getValue: (ref: string) => CellValue = () => null) {
+  const ast = parseFormula(formula);
+  return evaluate(ast, getValue);
+}
+
+function getGetValue(values: Record<string, CellValue>): (ref: string) => CellValue {
+  return (ref: string) => values[ref] ?? null;
+}
+
+describe('evaluate', () => {
+  it('evaluates number literals', () => {
+    expect(evalFormula('42')).toBe(42);
+    expect(evalFormula('3.14')).toBe(3.14);
+  });
+
+  it('evaluates string literals', () => {
+    expect(evalFormula('"hello"')).toBe('hello');
+  });
+
+  it('evaluates boolean literals', () => {
+    expect(evalFormula('true')).toBe(true);
+    expect(evalFormula('false')).toBe(false);
+  });
+
+  it('evaluates cell references', () => {
+    const getValue = getGetValue({ A1: 10 });
+    expect(evalFormula('A1', getValue)).toBe(10);
+  });
+
+  it('returns null for empty cell references', () => {
+    expect(evalFormula('A1')).toBeNull();
+  });
+
+  it('evaluates addition', () => {
+    const getValue = getGetValue({ A1: 10, A2: 20 });
+    expect(evalFormula('A1+A2', getValue)).toBe(30);
+  });
+
+  it('evaluates subtraction', () => {
+    expect(evalFormula('10-3')).toBe(7);
+  });
+
+  it('evaluates multiplication', () => {
+    expect(evalFormula('3*4')).toBe(12);
+  });
+
+  it('evaluates division', () => {
+    expect(evalFormula('10/2')).toBe(5);
+  });
+
+  it('respects operator precedence', () => {
+    expect(evalFormula('1+2*3')).toBe(7);
+    expect(evalFormula('2*3+1')).toBe(7);
+  });
+
+  it('respects parentheses', () => {
+    expect(evalFormula('(1+2)*3')).toBe(9);
+  });
+
+  it('evaluates chained arithmetic', () => {
+    expect(evalFormula('1+2+3')).toBe(6);
+    expect(evalFormula('10-3-2')).toBe(5);
+    expect(evalFormula('2*3*4')).toBe(24);
+  });
+
+  describe('comparison operators', () => {
+    it('evaluates >', () => {
+      expect(evalFormula('5>3')).toBe(true);
+      expect(evalFormula('3>5')).toBe(false);
+    });
+
+    it('evaluates <', () => {
+      expect(evalFormula('3<5')).toBe(true);
+      expect(evalFormula('5<3')).toBe(false);
+    });
+
+    it('evaluates >=', () => {
+      expect(evalFormula('5>=3')).toBe(true);
+      expect(evalFormula('5>=5')).toBe(true);
+      expect(evalFormula('3>=5')).toBe(false);
+    });
+
+    it('evaluates <=', () => {
+      expect(evalFormula('3<=5')).toBe(true);
+      expect(evalFormula('5<=5')).toBe(true);
+      expect(evalFormula('5<=3')).toBe(false);
+    });
+
+    it('evaluates = (equality)', () => {
+      expect(evalFormula('5=5')).toBe(true);
+      expect(evalFormula('5=3')).toBe(false);
+      expect(evalFormula('"hi"="hi"')).toBe(true);
+      expect(evalFormula('"hi"="ho"')).toBe(false);
+    });
+
+    it('evaluates <> (inequality)', () => {
+      expect(evalFormula('5<>3')).toBe(true);
+      expect(evalFormula('5<>5')).toBe(false);
+    });
+  });
+
+  describe('SUM function', () => {
+    it('sums a column range', () => {
+      const getValue = getGetValue({ A1: 1, A2: 2, A3: 3, A4: 4, A5: 5 });
+      expect(evalFormula('SUM(A1:A5)', getValue)).toBe(15);
+    });
+
+    it('sums a row range', () => {
+      const getValue = getGetValue({ A1: 10, B1: 20, C1: 30 });
+      expect(evalFormula('SUM(A1:C1)', getValue)).toBe(60);
+    });
+
+    it('sums a block range', () => {
+      const getValue = getGetValue({ A1: 1, B1: 2, A2: 3, B2: 4 });
+      expect(evalFormula('SUM(A1:B2)', getValue)).toBe(10);
+    });
+
+    it('treats empty cells as 0 in SUM', () => {
+      const getValue = getGetValue({ A1: 10, A3: 30 });
+      expect(evalFormula('SUM(A1:A3)', getValue)).toBe(40);
+    });
+
+    it('returns 0 for empty range', () => {
+      const getValue = getGetValue({});
+      expect(evalFormula('SUM(A1:A3)', getValue)).toBe(0);
+    });
+  });
+
+  describe('AVERAGE function', () => {
+    it('averages a column range', () => {
+      const getValue = getGetValue({ A1: 1, A2: 2, A3: 3, A4: 4, A5: 5 });
+      expect(evalFormula('AVERAGE(A1:A5)', getValue)).toBe(3);
+    });
+
+    it('averages only numeric values, ignoring non-numeric', () => {
+      const getValue = getGetValue({ A1: 10, A2: 'hello', A3: 20 });
+      expect(evalFormula('AVERAGE(A1:A3)', getValue)).toBe(15);
+    });
+
+    it('returns 0 when no numeric values in range', () => {
+      const getValue = getGetValue({});
+      expect(evalFormula('AVERAGE(A1:A3)', getValue)).toBe(0);
+    });
+  });
+
+  describe('MIN function', () => {
+    it('finds minimum in range', () => {
+      const getValue = getGetValue({ A1: 3, A2: 7, A3: 1, A4: 9, A5: 4 });
+      expect(evalFormula('MIN(A1:A5)', getValue)).toBe(1);
+    });
+
+    it('returns Infinity for empty range', () => {
+      const getValue = getGetValue({});
+      expect(evalFormula('MIN(A1:A3)', getValue)).toBe(Infinity);
+    });
+  });
+
+  describe('MAX function', () => {
+    it('finds maximum in range', () => {
+      const getValue = getGetValue({ A1: 3, A2: 7, A3: 1, A4: 9, A5: 4 });
+      expect(evalFormula('MAX(A1:A5)', getValue)).toBe(9);
+    });
+
+    it('returns -Infinity for empty range', () => {
+      const getValue = getGetValue({});
+      expect(evalFormula('MAX(A1:A3)', getValue)).toBe(-Infinity);
+    });
+  });
+
+  describe('COUNT function', () => {
+    it('counts numeric values in range', () => {
+      const getValue = getGetValue({ A1: 10, A2: '"hello"', A3: 30, A4: 'true' });
+      expect(evalFormula('COUNT(A1:A4)', getValue)).toBe(2);
+    });
+
+    it('returns 0 for empty range', () => {
+      const getValue = getGetValue({});
+      expect(evalFormula('COUNT(A1:A3)', getValue)).toBe(0);
+    });
+  });
+
+  describe('IF function', () => {
+    it('returns true value when condition is true', () => {
+      expect(evalFormula('IF(5>3,"big","small")')).toBe('big');
+    });
+
+    it('returns false value when condition is false', () => {
+      expect(evalFormula('IF(3>5,"big","small")')).toBe('small');
+    });
+
+    it('works with cell references in condition', () => {
+      const getValue = getGetValue({ A1: 10 });
+      expect(evalFormula('IF(A1>5,"yes","no")', getValue)).toBe('yes');
+    });
+
+    it('works with cell references in true/false branches', () => {
+      const getValue = getGetValue({ B1: 100, C1: 200 });
+      expect(evalFormula('IF(true,B1,C1)', getValue)).toBe(100);
+    });
+
+    it('evaluates boolean conditions directly', () => {
+      expect(evalFormula('IF(true,"y","n")')).toBe('y');
+      expect(evalFormula('IF(false,"y","n")')).toBe('n');
+    });
+  });
+
+  describe('combined formulas', () => {
+    it('combines SUM with other arithmetic', () => {
+      const getValue = getGetValue({ A1: 10, A2: 20, B1: 5 });
+      expect(evalFormula('SUM(A1:A2)+B1', getValue)).toBe(35);
+    });
+
+    it('uses IF with SUM', () => {
+      const getValue = getGetValue({ A1: 1, A2: 1, A3: 1 });
+      expect(evalFormula('IF(SUM(A1:A3)>5,"high","low")', getValue)).toBe('low');
+      const getValue2 = getGetValue({ A1: 3, A2: 2, A3: 1 });
+      expect(evalFormula('IF(SUM(A1:A3)>5,"high","low")', getValue2)).toBe('high');
+      const getValue3 = getGetValue({ A1: 10, A2: 2, A3: 1 });
+      expect(evalFormula('IF(SUM(A1:A3)>5,"high","low")', getValue3)).toBe('high');
+    });
+
+    it('evaluates unary minus', () => {
+      expect(evalFormula('-5')).toBe(-5);
+    });
+  });
+});
