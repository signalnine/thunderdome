@@ -0,0 +1,180 @@
+import type { ASTNode, CellValue, EvalResult } from './types.js';
+import { expandRange } from './range.js';
+
+export type CellResolver = (ref: string) => CellValue;
+
+export function evaluate(ast: ASTNode, getCellValue: CellResolver): EvalResult {
+  switch (ast.type) {
+    case 'number':
+      return ast.value;
+    case 'string':
+      return ast.value;
+    case 'boolean':
+      return ast.value;
+    case 'cellRef': {
+      const val = getCellValue(ast.ref);
+      return val;
+    }
+    case 'range': {
+      // Evaluate a range by expanding it and returning values
+      const cells = expandRange(`${ast.start}:${ast.end}`);
+      return cells.map(c => getCellValue(c));
+    }
+    case 'binaryOp': {
+      const left = evaluate(ast.left, getCellValue);
+      const right = evaluate(ast.right, getCellValue);
+
+      // Convert nulls to 0 for arithmetic
+      const lNum = (left === null || left === undefined) ? 0 : left;
+      const rNum = (right === null || right === undefined) ? 0 : right;
+
+      switch (ast.op) {
+        case '+': return asNumber(lNum) + asNumber(rNum);
+        case '-': return asNumber(lNum) - asNumber(rNum);
+        case '*': return asNumber(lNum) * asNumber(rNum);
+        case '/': return asNumber(lNum) / asNumber(rNum);
+        case '>': return asNumber(lNum) > asNumber(rNum);
+        case '<': return asNumber(lNum) < asNumber(rNum);
+        case '>=': return asNumber(lNum) >= asNumber(rNum);
+        case '<=': return asNumber(lNum) <= asNumber(rNum);
+        case '=': {
+          // Strict equality first, then numeric fallback if one is a number
+          if (left === right) return true;
+          if (typeof left === 'number' || typeof right === 'number') {
+            return asNumber(left) === asNumber(right);
+          }
+          return false;
+        }
+        case '<>': {
+          if (left === right) return false;
+          if (typeof left === 'number' || typeof right === 'number') {
+            return asNumber(left) !== asNumber(right);
+          }
+          return true;
+        }
+        default:
+          throw new Error(`Unknown operator: ${ast.op}`);
+      }
+    }
+    case 'functionCall': {
+      return evaluateFunction(ast.name, ast.args, getCellValue);
+    }
+    default:
+      throw new Error(`Unknown AST node type: ${(ast as { type: string }).type}`);
+  }
+}
+
+function asNumber(val: unknown): number {
+  if (typeof val === 'number') return val;
+  if (val === true) return 1;
+  if (val === false) return 0;
+  if (val === null || val === undefined) return 0;
+  const n = Number(val);
+  return isNaN(n) ? 0 : n;
+}
+
+function getRangeValues(rangeResult: EvalResult): CellValue[] {
+  if (Array.isArray(rangeResult)) {
+    return rangeResult;
+  }
+  if (rangeResult === null || rangeResult === undefined) {
+    return [];
+  }
+  return [rangeResult];
+}
+
+function evaluateFunction(
+  name: string,
+  args: ASTNode[],
+  getCellValue: CellResolver
+): CellValue {
+  // Evaluate all arguments
+  const evaluatedArgs = args.map(a => evaluate(a, getCellValue));
+
+  switch (name) {
+    case 'SUM': {
+      let total = 0;
+      for (const arg of evaluatedArgs) {
+        const values = getRangeValues(arg);
+        for (const v of values) {
+          if (typeof v === 'number') {
+            total += v;
+          }
+        }
+      }
+      return total;
+    }
+    case 'AVERAGE': {
+      let total = 0;
+      let count = 0;
+      for (const arg of evaluatedArgs) {
+        const values = getRangeValues(arg);
+        for (const v of values) {
+          if (typeof v === 'number') {
+            total += v;
+            count++;
+          }
+        }
+      }
+      return count > 0 ? total / count : 0;
+    }
+    case 'MIN': {
+      let min = Infinity;
+      for (const arg of evaluatedArgs) {
+        const values = getRangeValues(arg);
+        for (const v of values) {
+          if (typeof v === 'number' && v < min) {
+            min = v;
+          }
+        }
+      }
+      return min;
+    }
+    case 'MAX': {
+      let max = -Infinity;
+      for (const arg of evaluatedArgs) {
+        const values = getRangeValues(arg);
+        for (const v of values) {
+          if (typeof v === 'number' && v > max) {
+            max = v;
+          }
+        }
+      }
+      return max;
+    }
+    case 'COUNT': {
+      let count = 0;
+      for (const arg of evaluatedArgs) {
+        const values = getRangeValues(arg);
+        for (const v of values) {
+          if (typeof v === 'number') {
+            count++;
+          }
+        }
+      }
+      return count;
+    }
+    case 'IF': {
+      if (evaluatedArgs.length < 3) {
+        throw new Error('IF requires 3 arguments');
+      }
+      const condition = evaluatedArgs[0];
+      // Convert condition to boolean
+      let condBool: boolean;
+      if (typeof condition === 'boolean') {
+        condBool = condition;
+      } else if (typeof condition === 'number') {
+        condBool = condition !== 0;
+      } else if (typeof condition === 'string') {
+        condBool = condition !== '';
+      } else {
+        condBool = false;
+      }
+      const trueVal = evaluatedArgs[1];
+      const falseVal = evaluatedArgs[2];
+      return condBool ? (Array.isArray(trueVal) ? null : trueVal) : (Array.isArray(falseVal) ? null : falseVal);
+    }
+    default:
+      throw new Error(`Unknown function: ${name}`);
+  }
+}
