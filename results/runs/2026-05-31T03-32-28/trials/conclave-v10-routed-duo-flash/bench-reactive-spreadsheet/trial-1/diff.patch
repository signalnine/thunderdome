new file mode 100644
index 0000000..e8cb071
--- /dev/null
+++ b/src/depGraph.ts
@@ -0,0 +1,155 @@
+export class DepGraph {
+  // dependsOn[A] = [B, C] means cell A references cells B and C
+  private dependsOn: Map<string, string[]> = new Map();
+  // dependents[X] = [Y, Z] means X is referenced by Y and Z (inverse of dependsOn)
+  private dependents: Map<string, Set<string>> = new Map();
+
+  setDependencies(cell: string, deps: string[]): void {
+    // Remove old edges
+    const oldDeps = this.dependsOn.get(cell) || [];
+    for (const oldDep of oldDeps) {
+      this.dependents.get(oldDep)?.delete(cell);
+    }
+
+    // Add new edges
+    this.dependsOn.set(cell, deps);
+    for (const dep of deps) {
+      if (!this.dependents.has(dep)) {
+        this.dependents.set(dep, new Set());
+      }
+      this.dependents.get(dep)!.add(cell);
+    }
+
+    // Check for cycles
+    if (this.hasCycle(cell)) {
+      // Rollback
+      this.dependsOn.set(cell, oldDeps);
+      for (const dep of deps) {
+        this.dependents.get(dep)?.delete(cell);
+      }
+      for (const oldDep of oldDeps) {
+        if (!this.dependents.has(oldDep)) {
+          this.dependents.set(oldDep, new Set());
+        }
+        this.dependents.get(oldDep)!.add(cell);
+      }
+      throw new Error(`Circular reference detected for cell ${cell}`);
+    }
+  }
+
+  /**
+   * Clear what this cell depends on (its outgoing formula edges).
+   * Does NOT clear what depends on this cell — those edges are about other cells' formulas.
+   */
+  clearDependencies(cell: string): void {
+    const deps = this.dependsOn.get(cell) || [];
+    for (const dep of deps) {
+      this.dependents.get(dep)?.delete(cell);
+    }
+    this.dependsOn.delete(cell);
+  }
+
+  getDependents(cell: string): string[] {
+    return Array.from(this.dependents.get(cell) || []);
+  }
+
+  getRecomputeOrder(changedCells: string[]): string[] {
+    // Collect all affected cells (changed + their transitive dependents)
+    const affected = new Set<string>(changedCells);
+    const queue = [...changedCells];
+
+    while (queue.length > 0) {
+      const cell = queue.shift()!;
+      const deps = this.dependents.get(cell);
+      if (deps) {
+        for (const dep of deps) {
+          if (!affected.has(dep)) {
+            affected.add(dep);
+            queue.push(dep);
+          }
+        }
+      }
+    }
+
+    // Topological sort using Kahn's algorithm on the affected subgraph
+    // Build subgraph edges: for each affected cell, count how many of its
+    // dependencies are in the affected set (these are "incoming" edges)
+    const inDegree = new Map<string, number>();
+    for (const cell of affected) {
+      inDegree.set(cell, 0);
+    }
+
+    for (const cell of affected) {
+      const deps = this.dependsOn.get(cell) || [];
+      for (const dep of deps) {
+        if (affected.has(dep)) {
+          // cell depends on dep, so there's an edge dep -> cell
+          // cell has an incoming edge from dep
+          inDegree.set(cell, (inDegree.get(cell) || 0) + 1);
+        }
+      }
+    }
+
+    // Start with cells that have no dependencies within the affected set
+    const ready: string[] = [];
+    for (const cell of affected) {
+      if (inDegree.get(cell) === 0) {
+        // For changed cells, they should be first
+        if (changedCells.includes(cell)) {
+          ready.unshift(cell);
+        } else {
+          ready.push(cell);
+        }
+      }
+    }
+
+    const order: string[] = [];
+
+    while (ready.length > 0) {
+      // Prioritize processing changed cells first within the same level
+      const cell = ready.shift()!;
+      order.push(cell);
+
+      // Decrease in-degree for dependents of this cell
+      const deps = this.dependents.get(cell);
+      if (deps) {
+        for (const dep of deps) {
+          if (affected.has(dep)) {
+            const newDegree = (inDegree.get(dep) || 1) - 1;
+            inDegree.set(dep, newDegree);
+            if (newDegree === 0) {
+              ready.push(dep);
+            }
+          }
+        }
+      }
+    }
+
+    return order;
+  }
+
+  private hasCycle(startCell: string): boolean {
+    // DFS from startCell following dependsOn edges
+    // If we encounter startCell again, there's a cycle
+    const visited = new Set<string>();
+    const stack = [startCell];
+
+    while (stack.length > 0) {
+      const cell = stack.pop()!;
+      if (cell !== startCell && visited.has(cell)) continue;
+      visited.add(cell);
+
+      const deps = this.dependsOn.get(cell);
+      if (deps) {
+        for (const dep of deps) {
+          if (dep === startCell) return true;
+          if (!visited.has(dep)) {
+            stack.push(dep);
+          }
+        }
+      }
+    }
+
+    return false;
+  }
+}
