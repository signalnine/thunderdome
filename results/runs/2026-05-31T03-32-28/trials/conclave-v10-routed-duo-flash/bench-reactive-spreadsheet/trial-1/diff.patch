rses comparison (<>)', () => {\n    expect(parseFormula('A1<>5')).toEqual(binOp('<>', ref('A1'), n(5)));\n  });\n\n  it('parses function call with no args', () => {\n    const ast = parseFormula('SUM()');\n    expect(ast).toEqual(func('SUM'));\n  });\n\n  it('parses function call with one arg', () => {\n    const ast = parseFormula('SUM(A1:A5)');\n    expect(ast).toEqual(func('SUM', range('A1', 'A5')));\n  });\n\n  it('parses IF function', () => {\n    const ast = parseFormula('IF(A1>5,\"big\",\"small\")');\n    expect(ast).toEqual(\n      func('IF',\n        binOp('>', ref('A1'), n(5)),\n        s('big'),\n        s('small')\n      )\n    );\n  });\n\n  it('parses nested function calls', () => {\n    const ast = parseFormula('SUM(A1:A5)+MAX(B1:B3)');\n    expect(ast).toEqual(\n      binOp('+',\n        func('SUM', range('A1', 'A5')),\n        func('MAX', range('B1', 'B3'))\n      )\n    );\n  });\n\n  it('parses unary minus', () => {\n    const ast = parseFormula('-5');\n    expect(ast).toEqual(binOp('-', n(0), n(5)));\n  });\n\n  it('parses complex expression with parentheses and arithmetic', () => {\n    const ast = parseFormula('(A1+B1)*2');\n    expect(ast).toEqual(binOp('*', binOp('+', ref('A1'), ref('B1')), n(2)));\n  });\n\n  it('parses negative cell reference', () => {\n    const ast = parseFormula('-A1');\n    expect(ast).toEqual(binOp('-', n(0), ref('A1')));\n  });\n\n  it('handles whitespace in formulas', () => {\n    expect(parseFormula(' 1 + 2 ')).toEqual(binOp('+', n(1), n(2)));\n  });\n\n  it('throws on unbalanced parentheses', () => {\n    expect(() => parseFormula('(1+2')).toThrow();\n  });\n\n  it('throws on empty formula', () => {\n    expect(() => parseFormula('')).toThrow();\n  });\n\n  it('parses AVERAGE function', () => {\n    expect(parseFormula('AVERAGE(A1:A3)')).toEqual(func('AVERAGE', range('A1', 'A3')));\n  });\n\n  it('parses MIN function', () => {\n    expect(parseFormula('MIN(A1:A3)')).toEqual(func('MIN', range('A1', 'A3')));\n  });\n