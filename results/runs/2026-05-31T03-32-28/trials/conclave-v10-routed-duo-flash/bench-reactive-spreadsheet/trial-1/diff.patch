+  describe('get and set', () => {
+    it('stores and retrieves a number', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 42);
+      expect(sheet.get('A1')).toBe(42);
+    });
+
+    it('stores and retrieves a string', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 'hello');
+      expect(sheet.get('A1')).toBe('hello');
+    });
+
+    it('stores and retrieves a boolean', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', true);
+      expect(sheet.get('A1')).toBe(true);
+    });
+
+    it('returns null for empty cells', () => {
+      const sheet = new Spreadsheet();
+      expect(sheet.get('Z99')).toBeNull();
+    });
+
+    it('stores and evaluates a formula', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 10);
+      sheet.set('A2', 20);
+      sheet.set('A3', '=A1+A2');
+      expect(sheet.get('A3')).toBe(30);
+    });
+
+    it('returns display string for values', () => {
+      const sheet = new Spreadsheet();
