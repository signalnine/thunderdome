@@ -0,0 +1,242 @@
+import { parseFormula, evaluate, extractCellRefs, ASTNode } from './formula.js';
+import { normalizeCellRef } from './reference.js';
+
+interface CellData {
+  raw: string | number | boolean;
+  formula?: string; // the formula string without '=' prefix (if it's a formula)
+  ast?: ASTNode;    // parsed AST (if it's a formula)
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  computedValue: any;
+}
+
+export class Spreadsheet {
+  private cells: Map<string, CellData> = new Map();
+  // For each cell, the set of cells that directly depend on it (its dependents)
+  private dependents: Map<string, Set<string>> = new Map();
+  // For each formula cell, the set of cells it depends on (its precedents)
+  private dependencies: Map<string, Set<string>> = new Map();
+
+  /**
+   * Set a cell's value. Can be a raw value or a formula string starting with '='.
+   */
+  set(cell: string, value: string | number | boolean): void {
+    const key = normalizeCellRef(cell);
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      this.setFormula(key, value.slice(1));
+    } else {
+      this.setRawValue(key, value);
+    }
+  }
+
+  /**
+   * Get a cell's computed value. Returns null for empty cells.
+   */
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  get(cell: string): any {
+    const key = normalizeCellRef(cell);
+    const data = this.cells.get(key);
+    if (!data) return null;
+    return data.computedValue;
+  }
+
+  /**
+   * Get the display string for a cell's computed value.
+   */
+  getDisplay(cell: string): string {
+    const key = normalizeCellRef(cell);
+    const data = this.cells.get(key);
+    if (!data) return '';
+    const val = data.computedValue;
+    if (val === null || val === undefined) return '';
+    return String(val);
+  }
+
+  /**
+   * Get all non-empty cells as a Map from cell reference to computed value.
+   */
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  getCells(): Map<string, any> {
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const result = new Map<string, any>();
+    for (const [key, data] of this.cells) {
+      if (data.computedValue !== null && data.computedValue !== undefined) {
+        result.set(key, data.computedValue);
+      }
+    }
+    return result;
+  }
+
+  private setRawValue(key: string, value: string | number | boolean): void {
+    // Clean up old dependencies if this cell previously had a formula
+    this.removeDependencies(key);
+
+    this.cells.set(key, {
+      raw: value,
+      computedValue: value,
+    });
+
+    // Recompute all dependents
+    this.recomputeDependents(key);
+  }
+
+  private setFormula(key: string, formula: string): void {
+    // Parse the formula
+    const ast = parseFormula(formula);
+
+    // Extract cell references from the formula
+    const refs = extractCellRefs(ast);
+
+    // Check for circular references before updating anything
+    if (this.wouldCreateCycle(key, refs)) {
+      throw new Error(`Circular reference detected for cell ${key}`);
+    }
+
+    // Clean up old dependencies if this cell previously had a formula
+    this.removeDependencies(key);
+
+    // Set up new dependencies
+    const depSet = new Set<string>(refs);
+    this.dependencies.set(key, depSet);
+    for (const ref of refs) {
+      if (!this.dependents.has(ref)) {
+        this.dependents.set(ref, new Set());
+      }
+      this.dependents.get(ref)!.add(key);
+    }
+
+    // Store the cell and compute its value
+    const computedValue = this.evaluateFormula(ast);
+    this.cells.set(key, {
+      raw: '=' + formula,
+      formula,
+      ast,
+      computedValue,
+    });
+
+    // Recompute all dependents
+    this.recomputeDependents(key);
+  }
+
+  /**
+   * Remove all dependency tracking for a cell (used when overwriting).
+   */
+  private removeDependencies(key: string): void {
+    const oldDeps = this.dependencies.get(key);
+    if (oldDeps) {
+      for (const dep of oldDeps) {
+        const depSet = this.dependents.get(dep);
+        if (depSet) {
+          depSet.delete(key);
+          if (depSet.size === 0) {
+            this.dependents.delete(dep);
+          }
+        }
+      }
+      this.dependencies.delete(key);
+    }
+  }
+
+  /**
+   * Check if setting cell `key` with dependencies on `refs` would create a cycle.
+   * Starting from the new refs, follow each cell's dependencies to see if we
+   * can reach `key` — if so, it would be a cycle.
+   */
+  private wouldCreateCycle(key: string, refs: string[]): boolean {
+    const visited = new Set<string>();
+    const stack = [...refs];
+
+    while (stack.length > 0) {
+      const ref = stack.pop()!;
+      if (ref === key) return true;
+      if (visited.has(ref)) continue;
+      visited.add(ref);
+
+      // Follow the dependency chain: what does this cell depend on?
+      const deps = this.dependencies.get(ref);
+      if (deps) {
+        for (const dep of deps) {
+          if (!visited.has(dep)) {
+            stack.push(dep);
+          }
+        }
+      }
+    }
+
+    return false;
+  }
+
+  /**
+   * Recompute all cells that (transitively) depend on the given cell.
+   * Uses a topological order to avoid redundant recomputation.
+   */
+  private recomputeDependents(key: string): void {
+    // Collect all cells that need recomputation, in topological order
+    const order = this.topologicalOrder(key);
+
+    for (const cellKey of order) {
+      if (cellKey === key) continue; // already handled by caller
+      this.recomputeCell(cellKey);
+    }
+  }
+
+  /**
+   * Compute a topological ordering of all cells that depend (transitively)
+   * on the given cell. This ensures each cell is recomputed after all its
+   * dependencies have been recomputed.
+   *
+   * Uses post-order DFS + reverse to get correct computation order
+   * (dependents closest to the changed cell first).
+   */
+  private topologicalOrder(startKey: string): string[] {
+    const visited = new Set<string>();
+    const result: string[] = [];
+
+    // Post-order DFS from startKey's dependents
+    const dfs = (node: string) => {
+      if (visited.has(node)) return;
+      visited.add(node);
+      const deps = this.dependents.get(node);
+      if (deps) {
+        // Sort for deterministic order
+        const sorted = Array.from(deps).sort();
+        for (const dep of sorted) {
+          dfs(dep);
+        }
+      }
+      result.push(node);
+    };
+
+    dfs(startKey);
+    // Post-order gives leaves first. Reverse so closest dependents come first.
+    result.reverse();
+    return result;
+  }
+
+  /**
+   * Recompute a single cell's value from its formula or raw value.
+   */
+  private recomputeCell(key: string): void {
+    const data = this.cells.get(key);
+    if (!data) return;
+
+    if (data.formula && data.ast) {
+      // Re-evaluate formula with current values
+      data.computedValue = this.evaluateFormula(data.ast);
+    }
+    // Raw values don't need recomputation
+  }
+
+  /**
+   * Evaluate a formula AST, looking up cell values from the current state.
+   */
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  private evaluateFormula(ast: ASTNode): any {
+    return evaluate(ast, (ref: string) => {
+      const normalizedRef = normalizeCellRef(ref);
+      const data = this.cells.get(normalizedRef);
+      if (!data) return null;
+      return data.computedValue;
+    });
+  }
+}
