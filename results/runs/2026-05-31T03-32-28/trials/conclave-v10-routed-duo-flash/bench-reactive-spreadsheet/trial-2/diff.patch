n, comma, or colon,\n * then = is likely a comparison. Otherwise, at the start it's the formula prefix.\n * Since we strip the leading = for parsing, this mainly handles cases inside expressions.\n * For our purposes, after we've stripped the leading =, any = is a comparison.\n */\nfunction isComparisonContext(input: string, i: number): boolean {\n  // At position 0 after stripping =, we need to check if there's another = before\n  // For simplicity: any = in the expression is treated as comparison\n  // The leading = is stripped by the caller\n  return true;\n}\n\n// ===== AST =====\n\nexport enum ASTNodeType {\n  Number = 'Number',\n  String = 'String',\n  Boolean = 'Boolean',\n  CellRef = 'CellRef',\n  Range = 'Range',\n  BinaryOp = 'BinaryOp',\n  UnaryOp = 'UnaryOp',\n  FunctionCall = 'FunctionCall',\n}\n\nexport interface ASTNode {\n  type: ASTNodeType;\n  value?: any;\n  left?: ASTNode;\n  right?: ASTNode;\n  operator?: string;\n  operand?: ASTNode;\n  args?: ASTNode[];\n  start?: string;\n  end?: string;\n}\n\n// ===== Parser =====\n\nconst EOF_TOKEN: Token = { type: TokenType.EOF, value: null, raw: '' };\n\nclass Parser {\n  private tokens: Token[];\n  private pos: number;\n\n  constructor(tokens: Token[]) {\n    this.tokens = tokens;\n    this.pos = 0;\n  }\n\n  private isAtEnd(): boolean {\n    return this.pos >= this.tokens.length;\n  }\n\n  private peek(): Token {\n    if (this.isAtEnd()) return EOF_TOKEN;\n    return this.tokens[this.pos];\n  }\n\n  private consume(): Token {\n    if (this.isAtEnd()) return EOF_TOKEN;\n    return this.tokens[this.pos++];\n  }\n\n  private expect(type: TokenType): Token {\n    const token = this.peek();\n    if (token.type !== type) {\n      throw new Error(`Expected ${type} but got ${token.type} (${token.raw})`);\n    }\n    return this.consume();\n  }\n\n  parse(): ASTNode {\n    return this.expression();\n  }\n\n  private expression(): ASTNode {\n    // First try comparison\n    let left = this.addition();\n\n    // C