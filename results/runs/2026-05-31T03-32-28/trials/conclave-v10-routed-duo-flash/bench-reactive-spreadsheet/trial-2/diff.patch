+
+describe('cellRefToString', () => {
+  it('converts {col:0,row:1} to A1', () => {
+    expect(cellRefToString({ col: 0, row: 1 })).toBe('A1');
+  });
+
+  it('converts {col:26,row:1} to AA1', () => {
+    expect(cellRefToString({ col: 26, row: 1 })).toBe('AA1');
+  });
+
+  it('converts {col:701,row:100} to ZZ100', () => {
+    expect(cellRefToString({ col: 701, row: 100 })).toBe('ZZ100');
+  });
+
+  it('roundtrips with parseCellRef', () => {
+    const refs = ['A1', 'Z99', 'AA1', 'AZ1', 'BA1', 'ZZ1', 'AAA1'];
+    for (const ref of refs) {
+      expect(cellRefToString(parseCellRef(ref))).toBe(ref.toUpperCase());
+    }
+  });
+});
+
+describe('parseRange', () => {
+  it('parses a column range A1:A5', () => {
+    const cells = parseRange('A1:A5');
+    expect(cells.map(c => cellRefToString(c))).toEqual(['A1', 'A2', 'A3', 'A4', 'A5']);
+  });
+
+  it('parses a row range A1:C1', () => {
+    const cells = parseRange('A1:C1');
+    expect(cells.map(c => cellRefToString(c))).toEqual(['A1', 'B1', 'C1']);
+  });
+
+  it('parses a block range A1:C3', () => {
+    const cells = parseRange('A1:C3');
+    expect(cells.map(c => cellRefToString(c))).toEqual([
+      'A1', 'B1', 'C1',
+      'A2', 'B2', 'C2',
+      'A3', 'B3', 'C3',
+    ]);
+  });
+
+  it('parses range with lowercase', () => {
+    const cells = parseRange('a1:a3');
+    expect(cells.map(c => cellRefToString(c))).toEqual(['A1', 'A2', 'A3']);
+  });
+
+  it('parses AA1:AB2 range', () => {
+    const cells = parseRange('AA1:AB2');
+    expect(cells.map(c => cellRefToString(c))).toEqual(['AA1', 'AB1', 'AA2', 'AB2']);
+  });
+
+  it('handles single cell range A1:A1', () => {
+    const cells = parseRange('A1:A1');
+    expect(cells.map(c => cellRefToString(c))).toEqual(['A1']);
+  });
+
+  it('throws on invalid range', () => {
+    expect(() => parseRange('A1')).toThrow();
+  });
+});
