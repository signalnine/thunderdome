--- /dev/null
+++ b/src/reference.ts
@@ -0,0 +1,84 @@
+export interface CellRef {
+  col: number; // 0-indexed
+  row: number; // 1-indexed
+}
+
+/**
+ * Convert a numeric column index to column letters (0 => A, 25 => Z, 26 => AA, etc.)
+ */
+export function indexToCol(index: number): string {
+  let result = '';
+  let n = index;
+  while (n >= 0) {
+    result = String.fromCharCode((n % 26) + 65) + result;
+    n = Math.floor(n / 26) - 1;
+  }
+  return result;
+}
+
+/**
+ * Convert column letters to a numeric index (A => 0, Z => 25, AA => 26, etc.)
+ */
+export function colToIndex(col: string): number {
+  let result = 0;
+  for (let i = 0; i < col.length; i++) {
+    result = result * 26 + (col.charCodeAt(i) - 64);
+  }
+  return result - 1;
+}
+
+/**
+ * Parse a cell reference like "A1", "B2", "AA1" into {col, row}.
+ * Throws on invalid input.
+ */
+export function parseCellRef(ref: string): CellRef {
+  const match = ref.match(/^([A-Za-z]+)(\d+)$/);
+  if (!match) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  return {
+    col: colToIndex(match[1].toUpperCase()),
+    row: parseInt(match[2], 10),
+  };
+}
+
+/**
+ * Convert a CellRef back to a string like "A1".
+ */
+export function cellRefToString(ref: CellRef): string {
+  return `${indexToCol(ref.col)}${ref.row}`;
+}
+
+/**
+ * Normalize a cell reference to uppercase form (e.g., "a1" => "A1").
+ */
+export function normalizeCellRef(ref: string): string {
+  return cellRefToString(parseCellRef(ref));
+}
+
+/**
+ * Parse a range like "A1:A5" into an array of CellRefs.
+ * Supports column ranges (A1:A5), row ranges (A1:C1), and block ranges (A1:C3).
+ */
+export function parseRange(range: string): CellRef[] {
+  const parts = range.split(':');
+  if (parts.length !== 2) {
+    throw new Error(`Invalid range: ${range}`);
+  }
+
+  const start = parseCellRef(parts[0]);
+  const end = parseCellRef(parts[1]);
+
+  const colMin = Math.min(start.col, end.col);
+  const colMax = Math.max(start.col, end.col);
+  const rowMin = Math.min(start.row, end.row);
+  const rowMax = Math.max(start.row, end.row);
+
+  const cells: CellRef[] = [];
+  for (let row = rowMin; row <= rowMax; row++) {
+    for (let col = colMin; col <= colMax; col++) {
+      cells.push({ col, row });
+    }
+  }
+  return cells;
+}
