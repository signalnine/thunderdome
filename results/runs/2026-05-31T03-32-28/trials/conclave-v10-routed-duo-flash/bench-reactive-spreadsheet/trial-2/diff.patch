onst tokens = tokenize('42');\n    expect(tokens).toHaveLength(1);\n    expect(tokens[0].type).toBe(TokenType.Number);\n    expect(tokens[0].value).toBe(42);\n  });\n\n  it('tokenizes decimal numbers', () => {\n    const tokens = tokenize('3.14');\n    expect(tokens[0].value).toBe(3.14);\n  });\n\n  it('tokenizes strings', () => {\n    const tokens = tokenize('\"hello\"');\n    expect(tokens[0].type).toBe(TokenType.String);\n    expect(tokens[0].value).toBe('hello');\n  });\n\n  it('tokenizes booleans', () => {\n    const tokens = tokenize('true');\n    expect(tokens[0].type).toBe(TokenType.Boolean);\n    expect(tokens[0].value).toBe(true);\n  });\n\n  it('tokenizes cell references', () => {\n    const tokens = tokenize('A1');\n    expect(tokens[0].type).toBe(TokenType.CellRef);\n    expect(tokens[0].value).toBe('A1');\n  });\n\n  it('tokenizes operators', () => {\n    const tokens = tokenize('+');\n    expect(tokens[0].type).toBe(TokenType.Plus);\n  });\n\n  it('tokenizes comparison operators', () => {\n    expect(tokenize('>')[0].type).toBe(TokenType.Gt);\n    expect(tokenize('<')[0].type).toBe(TokenType.Lt);\n    expect(tokenize('>=')[0].type).toBe(TokenType.Gte);\n    expect(tokenize('<=')[0].type).toBe(TokenType.Lte);\n    expect(tokenize('<>')[0].type).toBe(TokenType.Neq);\n    expect(tokenize('=')[0].type).toBe(TokenType.Eq);\n  });\n\n  it('tokenizes complex expression', () => {\n    const tokens = tokenize('=A1+B2*3');\n    // =, A1, +, B2, *, 3\n    expect(tokens.some(t => t.value === 'A1')).toBe(true);\n    expect(tokens.some(t => t.value === 'B2')).toBe(true);\n  });\n\n  it('tokenizes function call', () => {\n    const tokens = tokenize('SUM(A1:A5)');\n    expect(tokens[0].type).toBe(TokenType.Function);\n    expect(tokens[0].value).toBe('SUM');\n    expect(tokens[1].type).toBe(TokenType.ParenOpen);\n  });\n\n  it('tokenizes range operator with colon', () => {\n    const tokens = tokenize('A1:A5');\n    expect(tokens[1].type).toBe(TokenType.Colon);\n  });\n});\n\ndescribe('parseFormula', () => {\n  it('parses a number literal', () => {\n    const ast = parseFormula('42');\n    expect(ast.type).toBe(ASTNodeType.Number);\n    expect(ast.value).toBe(42);\n  });\n\n  it('parses a decimal number', () => {\n    const ast = parseFormula('3.14');\n    expect(ast.type).toBe(ASTNodeType.Number);\n    expect(ast.value).toBe(3.14);\n  });\n\n  it('parses a string literal', () => {\n    const ast = parseFormula('\"hello\"');\n    expect(ast.type).toBe(ASTNodeType.String);\n    expect(ast.value).toBe('hello');\n  });\n\n  it('parses a boolean literal', () => {\n    const ast = parseFormula('true');\n    expect(ast.type).toBe(ASTNodeType.Boolean);\n    expect(ast.value).toBe(true);\n  });\n\n  it('parses a cell reference', () => {\n    const ast = parseFormula('A1');\n    expect(ast.type).toBe(ASTNodeType.CellRef);\n    expect(ast.value).toBe('A1');\n  });\n\n  it('parses addition', () => {\n    const ast = parseFormula('1+2');\n    expect(ast.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.operator).toBe('+');\n  });\n\n  it('parses multiplication with precedence (1+2*3)', () => {\n    const ast = parseFormula('1+2*3');\n    expect(ast.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.operator).toBe('+');\n    // left should be 1, right should be 2*3\n    expect(ast.left.type).toBe(ASTNodeType.Number);\n    expect(ast.left.value).toBe(1);\n    expect(ast.right.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.right.operator).toBe('*');\n  });\n\n  it('parses parentheses (1+2)*3', () => {\n    const ast = parseFormula('(1+2)*3');\n    expect(ast.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.operator).toBe('*');\n    expect(ast.left.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.left.operator).toBe('+');\n  });\n\n  it('parses comparison operators', () => {\n    const ast = parseFormula('5>3');\n    expect(ast.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.operator).toBe('>');\n  });\n\n  it('parses function call SUM(A1:A5)', () => {\n    const ast = parseFormula('SUM(A1:A5)');\n    expect(ast.type).toBe(ASTNodeType.FunctionCall);\n    expect(ast.value).toBe('SUM');\n    expect(ast.args).toHaveLength(1);\n    expect(ast.args[0].type).toBe(ASTNodeType.Range);\n    expect(ast.args[0].start).toBe('A1');\n    expect(ast.args[0].end).toBe('A5');\n  });\n\n  it('parses IF function with three arguments', () => {\n    const ast = parseFormula('IF(A1>0, \"yes\", \"no\")');\n    expect(ast.type).toBe(ASTNodeType.FunctionCall);\n    expect(ast.value).toBe('IF');\n    expect(ast.args).toHaveLength(3);\n  });\n\n  it('parses complex expression =A1+B2*3', () => {\n    // parse with = prefix\n    const expr = '=A1+B2*3';\n    const formula = expr.startsWith('=') ? expr.slice(1) : expr;\n    const ast = parseFormula(formula);\n    expect(ast.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.operator).toBe('+');\n  });\n\n  it('parses AVERAGE(B1:B10)', () => {\n    const ast = parseFormula('AVERAGE(B1:B10)');\n    expect(ast.type).toBe(ASTNodeType.FunctionCall);\n    expect(ast.value).toBe('AVERAGE');\n  });\n\n  it('parses MIN and MAX', () => {\n    const minAst = parseFormula('MIN(A1:A5)');\n    expect(minAst.value).toBe('MIN');\n\n    const maxAst = parseFormula('MAX(A1:A5)');\n    expect(maxAst.value).toBe('MAX');\n  });\n\n  it('parses COUNT', () => {\n    const ast = parseFormula('COUNT(A1:A5)');\n    expect(ast.value).toBe('COUNT');\n  });\n\n  it('parses negative numbers', () => {\n    const ast = parseFormula('-5');\n    expect(ast.type).toBe(ASTNodeType.UnaryOp);\n    expect(ast.operator).toBe('-');\n    expect(ast.operand.value).toBe(5);\n  });\n});\n\ndescribe('extractCellRefs', () => {\n  it('extracts single cell reference', () => {\n    const ast = parseFormula('A1+5');\n    const refs = extractCellRefs(ast);\n    expect(refs).toEqual(['A1']);\n  });\n\n  it('extracts multiple cell references', () => {\n    const ast = parseFormula('A1+B2*C3');\n    const refs = extractCellRefs(ast);\n    expect(refs).toEqual(['A1', 'B2', 'C3']);\n  });\n\n  it('extracts cell references from function ranges', () => {\n    const ast = parseFormula('SUM(A1:A5)');\n    const refs = extractCellRefs(ast);\n    expect(refs).toContain('A1');\n    expect(refs).toContain('A2');\n    expect(refs).toContain('A5');\n    expect(refs.length).toBe(5);\n  });\n\n  it('extracts cell references from IF condition', () => {\n    const ast = parseFormula('IF(A1>0, B1, C1)');\n    const refs = extractCellRefs(ast);\n    expect(refs).toContain('A1');\n    expect(refs).toContain('B1');\n    expect(refs).toContain('C1');\n  });\n});\n\ndescribe('evaluate', () => {\n  const mockLookup = (ref: string): any => {\n    const map: Record<string, any> = {\n      'A1': 10,\n      'A2': 20,\n      'A3': 30,\n      'B1': 5,\n      'C1': 'hello',\n    };\n    return map[ref] ?? null;\n  };\n\n  it('evaluates number literal', () => {\n    const ast = parseFormula('42');\n    expect(evaluate(ast, mockLookup)).toBe(42);\n  });\n\n  it('evaluates string literal', () => {\n    const ast = parseFormula('\"hello\"');\n    expect(evaluate(ast, mockLookup)).toBe('hello');\n  });\n\n  it('evaluates boolean literal', () => {\n    const ast = parseFormula('true');\n    expect(evaluate(ast, mockLookup)).toBe(true);\n  });\n\n  it('evaluates cell reference', () => {\n    const ast = parseFormula('A1');\n    expect(evaluate(ast, mockLookup)).toBe(10);\n  });\n\n  it('evaluates empty cell reference as 0 in arithmetic', () => {\n    const ast = parseFormula('Z99+5');\n    expect(evaluate(ast, mockLookup)).toBe(5);\n  });\n\n  it('evaluates addition', () => {\n    const ast = parseFormula('A1+A2');\n    expect(evaluate(ast, mockLookup)).toBe(30);\n  });\n\n  it('evaluates subtraction', () => {\n    const ast = parseFormula('A2-A1');\n    expect(evaluate(ast, mockLookup)).toBe(10);\n  });\n\n  it('evaluates multiplication', () => {\n    const ast = parseFormula('A1*B1');\n    expect(evaluate(ast, mockLookup)).toBe(50);\n  });\n\n  it('evaluates division', () => {\n    const ast = parseFormula('A3/B1');\n    expect(evaluate(ast, mockLookup)).toBe(6);\n  });\n\n  it('respects operator precedence', () => {\n    const ast = parseFormula('1+2*3');\n    expect(evaluate(ast, mockLookup)).toBe(7);\n  });\n\n  it('respects parentheses', () => {\n    const ast = parseFormula('(1+2)*3');\n    expect(evaluate(ast, mockLookup)).toBe(9);\n  });\n\n  it('evaluates comparison >', () => {\n    const ast = parseFormula('5>3');\n    expect(evaluate(ast, mockLookup)).toBe(true);\n  });\n\n  it('evaluates comparison <', () => {\n    const ast = parseFormula('5<3');\n    expect(evaluate(ast, mockLookup)).toBe(false);\n  });\n\n  it('evaluates >=', () => {\n    expect(evaluate(parseFormula('5>=5'), mockLookup)).toBe(true);\n    expect(evaluate(parseFormula('5>=4'), mockLookup)).toBe(true);\n    expect(evaluate(parseFormula('4>=5'), mockLookup)).toBe(false);\n  });\n\n  it('evaluates <=', () => {\n    expect(evaluate(parseFormula('5<=5'), mockLookup)).toBe(true);\n    expect(evaluate(parseFormula('4<=5'), mockLookup)).toBe(true);\n    expect(evaluate(parseFormula('5<=4'), mockLookup)).toBe(false);\n  });\n\n  it('evaluates <> (not equal)', () => {\n    expect(evaluate(parseFormula('5<>3'), mockLookup)).toBe(true);\n    expect(evaluate(parseFormula('5<>5'), mockLookup)).toBe(false);\n  });\n\n  it('evaluates = comparison', () => {\n    expect(evaluate(parseFormula('5=5'), mockLookup)).toBe(true);\n    expect(evaluate(parseFormula('5=3'), mockLookup)).toBe(false);\n  });\n\n  it('evaluates SUM function', () => {\n    const ast = parseFormula('SUM(A1:A3)');\n    expect(evaluate(ast, mockLookup)).toBe(60);\n  });\n\n  it('evaluates AVERAGE function', () => {\n    const ast = parseFormula('AVERAGE(A1:A3)');\n    expect(evaluate(ast, mockLookup)).toBe(20);\n  });\n\n  it('evaluates MIN function', () => {\n    const ast = parseFormula('MIN(A1:A3)');\n    expect(evaluate(ast, mockLookup)).toBe(10);\n  });\n\n  it('evaluates MAX function', () => {\n    const ast = parseFormula('MAX(A1:A3)');\n    expect(evaluate(ast, mockLookup)).toBe(30);\n  });\n\n  it('evaluates COUNT function', () => {\n    const ast = parseFormula('COUNT(A1:A3)');\n    expect(evaluate(ast, mockLookup)).toBe(3);\n  });\n\n  it('ignores non-numeric cells in COUNT', () => {\n    // C1 = 'hello' (not numeric)\n    const ast = parseFormula('COUNT(A1:C1)');\n    expect(evaluate(ast, mockLookup)).toBe(2); // A1=10, B1=5, C1=\"hello\" -> 2 numeric\n  });\n\n  it('ignores non-numeric cells in SUM', () => {\n    const ast = parseFormula('SUM(A1:C1)');\n    // A1=10, B1=5, C1=\"hello\" -> SUM of numeric = 15\n    // Wait, C1 is looked up as 'hello' which is not numeric for SUM\n    // But the mock returns 'hello' for C1, which is not a number\n    // Actually, SUM only sums numbers. 'hello' is a string, so it should be ignored.\n    expect(evaluate(ast, mockLookup)).toBe(15);\n  });\n\n  it('evaluates IF with true condition', () => {\n    const ast = parseFormula('IF(1>0, \"yes\", \"no\")');\n    expect(evaluate(ast, mockLookup)).toBe('yes');\n  });\n\n  it('evaluates IF with false condition', () => {\n    const ast = parseFormula('IF(1<0, \"yes\", \"no\")');\n    expect(evaluate(ast, mockLookup)).toBe('no');\n  });\n\n  it('evaluates IF with cell reference condition', () => {\n    const ast = parseFormula('IF(A1>15, \"big\", \"small\")');\n    expect(evaluate(ast, mockLookup)).toBe('small');\n  });\n\n  it('evaluates IF with boolean literal condition', () => {\n    expect(evaluate(parseFormula('IF(true, 10, 20)'), mockLookup)).toBe(10);\n    expect(evaluate(parseFormula('IF(false, 10, 20)'), mockLookup)).toBe(20);\n  });\n\n  it('handles division by zero', () => {\n    const ast = parseFormula('5/0');\n    const result = evaluate(ast, mockLookup);\n    expect(typeof result).toBe('number');\n  });\n\n  it('evaluates unary minus', () => {\n    const ast = parseFormula('-5');\n    expect(evaluate(ast, mockLo