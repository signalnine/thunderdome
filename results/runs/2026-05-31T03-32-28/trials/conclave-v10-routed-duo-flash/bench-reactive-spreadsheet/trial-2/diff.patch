t tokens = tokenize('=A1+B2*3');\n    // =, A1, +, B2, *, 3\n    expect(tokens.some(t => t.value === 'A1')).toBe(true);\n    expect(tokens.some(t => t.value === 'B2')).toBe(true);\n  });\n\n  it('tokenizes function call', () => {\n    const tokens = tokenize('SUM(A1:A5)');\n    expect(tokens[0].type).toBe(TokenType.Function);\n    expect(tokens[0].value).toBe('SUM');\n    expect(tokens[1].type).toBe(TokenType.ParenOpen);\n  });\n\n  it('tokenizes range operator with colon', () => {\n    const tokens = tokenize('A1:A5');\n    expect(tokens[1].type).toBe(TokenType.Colon);\n  });\n});\n\ndescribe('parseFormula', () => {\n  it('parses a number literal', () => {\n    const ast = parseFormula('42');\n    expect(ast.type).toBe(ASTNodeType.Number);\n    expect(ast.value).toBe(42);\n  });\n\n  it('parses a decimal number', () => {\n    const ast = parseFormula('3.14');\n    expect(ast.type).toBe(ASTNodeType.Number);\n    expect(ast.value).toBe(3.14);\n  });\n\n  it('parses a string literal', () => {\n    const ast = parseFormula('\"hello\"');\n    expect(ast.type).toBe(ASTNodeType.String);\n    expect(ast.value).toBe('hello');\n  });\n\n  it('parses a boolean literal', () => {\n    const ast = parseFormula('true');\n    expect(ast.type).toBe(ASTNodeType.Boolean);\n    expect(ast.value).toBe(true);\n  });\n\n  it('parses a cell reference', () => {\n    const ast = parseFormula('A1');\n    expect(ast.type).toBe(ASTNodeType.CellRef);\n    expect(ast.value).toBe('A1');\n  });\n\n  it('parses addition', () => {\n    const ast = parseFormula('1+2');\n    expect(ast.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.operator).toBe('+');\n  });\n\n  it('parses multiplication with precedence (1+2*3)', () => {\n    const ast = parseFormula('1+2*3');\n    expect(ast.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.operator).toBe('+');\n    // left should be 1, right should be 2*3\n    expect(ast.left.type).toBe(ASTNodeType.Number);\n    expect(ast.left.value).toBe(1);\n    expect(ast.right.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.right.operator).toBe('*');\n  });\n\n  it('parses parentheses (1+2)*3', () => {\n    const ast = parseFormula('(1+2)*3');\n    expect(ast.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.operator).toBe('*');\n    expect(ast.left.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.left.operator).toBe('+');\n  });\n\n  it('parses comparison operators', () => {\n    const ast = parseFormula('5>3');\n    expect(ast.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.operator).toBe('>');\n  });\n\n  it('parses function call SUM(A1:A5)', () => {\n    const ast = parseFormula('SUM(A1:A5)');\n    expect(ast.type).toBe(ASTNodeType.FunctionCall);\n    expect(ast.value).toBe('SUM');\n    expect(ast.args).toHaveLength(1);\n    expect(ast.args[0].type).toBe(ASTNodeType.Range);\n    expect(ast.args[0].start).toBe('A1');\n    expect(ast.args[0].end).toBe('A5');\n  });\n\n  it('parses IF function with three arguments', () => {\n    const ast = parseFormula('IF(A1>0, \"yes\", \"no\")');\n    expect(ast.type).toBe(ASTNodeType.FunctionCall);\n    expect(ast.value).toBe('IF');\n    expect(ast.args).toHaveLength(3);\n  });\n\n  it('parses complex expression =A1+B2*3', () => {\n    // parse with = prefix\n    const expr = '=A1+B2*3';\n    const formula = expr.startsWith('=') ? expr.slice(1) : expr;\n    const ast = parseFormula(formula);\n    expect(ast.type).toBe(ASTNodeType.BinaryOp);\n    expect(ast.operator).toBe('+');\n  });\n\n  it('parses AVERAGE(B1:B10)', () => {\n    const ast = parseFormula('AVERAGE(B1:B10)');\n    expect(ast.type).toBe(ASTNodeType.FunctionCall);\n    expect(ast.value).toBe('AVERAGE');\n  });\n\n  it('parses MIN and MAX', () => {\n    const minAst = parseFormula('MIN(A1:A5)');\n    expect(minAst.value).toBe('MIN');\n\n    const maxAst = parseFormula('MAX(A1:A5)');\n    expect(maxAst.value).toBe('MAX');\n  });\n\n  it('parses COUNT', () => {\n    const ast = parseFormula('COUNT(A1:A5)');\n    expect(ast.value).