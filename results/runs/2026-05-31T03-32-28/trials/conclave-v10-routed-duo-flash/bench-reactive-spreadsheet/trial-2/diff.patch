diff --git a/src/edge-cases.test.ts b/src/edge-cases.test.ts
new file mode 100644
index 0000000..be2e8c6
--- /dev/null
+++ b/src/edge-cases.test.ts
@@ -0,0 +1,218 @@
+import { describe, it, expect } from 'vitest';
+import { Spreadsheet } from './index.js';
+
+/**
+ * Additional edge case tests covering remaining contract criteria.
+ */
+describe('Spreadsheet edge cases', () => {
+  describe('comparison operators in formulas', () => {
+    it('evaluates >= in formula', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', '=5>=5');
+      expect(sheet.get('A1')).toBe(true);
+      sheet.set('A2', '=4>=5');
+      expect(sheet.get('A2')).toBe(false);
+    });
+
+    it('evaluates <= in formula', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', '=5<=5');
+      expect(sheet.get('A1')).toBe(true);
+      sheet.set('A2', '=6<=5');
+      expect(sheet.get('A2')).toBe(false);
+    });
+
+    it('evaluates <> (not equal) in formula', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', '=5<>3');
+      expect(sheet.get('A1')).toBe(true);
+      sheet.set('A2', '=5<>5');
+      expect(sheet.get('A2')).toBe(false);
+    });
+
+    it('evaluates = comparison in formula', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', '=5=5');
+      expect(sheet.get('A1')).toBe(true);
+      sheet.set('A2', '=5=3');
+      expect(sheet.get('A2')).toBe(false);
+    });
+  });
+
+  describe('unary minus in formulas', () => {
+    it('evaluates -5', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', '=-5');
+      expect(sheet.get('A1')).toBe(-5);
+    });
+
+    it('evaluates -A1', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 10);
+      sheet.set('B1', '=-A1');
+      expect(sheet.get('B1')).toBe(-10);
+    });
+  });
+
+  describe('division by zero in formulas', () => {
+    it('does not throw on division by zero', () => {
+      const sheet = new Spreadsheet();
+      expect(() => {
+        sheet.set('A1', '=1/0');
+      }).not.toThrow();
+      const result = sheet.get('A1');
+      expect(typeof result).toBe('number');
+    });
+  });
+
+  describe('overwriting', () => {
+    it('formula to raw value removes dependencies', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 10);
+      sheet.set('B1', '=A1+1');
+      expect(sheet.get('B1')).toBe(11);
+
+      sheet.set('B1', 100);
+      expect(sheet.get('B1')).toBe(100);
+
+      // Changing A1 no longer affects B1
+      sheet.set('A1', 50);
+      expect(sheet.get('B1')).toBe(100);
+    });
+
+    it('raw value to formula', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 10);
+      sheet.set('B1', '=A1+5');
+      expect(sheet.get('B1')).toBe(15);
+
+      sheet.set('A1', 20);
+      expect(sheet.get('B1')).toBe(25);
+    });
+
+    it('formula to different formula', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 10);
+      sheet.set('A2', 20);
+      sheet.set('B1', '=A1+1');
+      expect(sheet.get('B1')).toBe(11);
+
+      sheet.set('B1', '=A2+1');
+      expect(sheet.get('B1')).toBe(21);
+
+      // Changing A1 no longer affects B1
+      sheet.set('A1', 100);
+      expect(sheet.get('B1')).toBe(21);
+    });
+  });
+
+  describe('empty cells', () => {
+    it('referencing empty cell in arithmetic gives 0', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', '=B1+5');
+      expect(sheet.get('A1')).toBe(5);
+    });
+
+    it('referencing empty cell in SUM ignores it', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 10);
+      sheet.set('A3', 30);
+      sheet.set('B1', '=SUM(A1:A3)');
+      expect(sheet.get('B1')).toBe(40);
+    });
+
+    it('getDisplay returns empty string for empty cell', () => {
+      const sheet = new Spreadsheet();
+      expect(sheet.getDisplay('ZZ999')).toBe('');
+    });
+  });
+
+  describe('case sensitivity', () => {
+    it('set with lowercase, get with uppercase', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('aa1', 42);
+      expect(sheet.get('AA1')).toBe(42);
+    });
+
+    it('formula with lowercase refs works', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 5);
+      sheet.set('A2', 10);
+      sheet.set('B1', '=a1+a2');
+      expect(sheet.get('B1')).toBe(15);
+    });
+  });
+
+  describe('getCells', () => {
+    it('returns only non-null values', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 10);
+      sheet.set('A2', false);
+      sheet.set('A3', 'hello');
+      const cells = sheet.getCells();
+      expect(cells.size).toBe(3);
+    });
+
+    it('returns computed values for formulas', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 5);
+      sheet.set('B1', '=A1*2');
+      const cells = sheet.getCells();
+      expect(cells.get('B1')).toBe(10);
+    });
+  });
+
+  describe('direct self-reference cycle', () => {
+    it('throws on A1 = A1', () => {
+      const sheet = new Spreadsheet();
+      expect(() => {
+        sheet.set('A1', '=A1');
+      }).toThrow(/circular/i);
+    });
+
+    it('throws on A1 = A1+1', () => {
+      const sheet = new Spreadsheet();
+      expect(() => {
+        sheet.set('A1', '=A1+1');
+      }).toThrow(/circular/i);
+    });
+  });
+
+  describe('re-evaluation after multiple changes', () => {
+    it('multiple intermediate updates work correctly', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', 1);
+      sheet.set('B1', '=A1*2');
+      sheet.set('C1', '=B1+1');
+      expect(sheet.get('C1')).toBe(3);
+
+      sheet.set('A1', 5);
+      expect(sheet.get('B1')).toBe(10);
+      expect(sheet.get('C1')).toBe(11);
+
+      sheet.set('A1', 10);
+      expect(sheet.get('B1')).toBe(20);
+      expect(sheet.get('C1')).toBe(21);
+    });
+  });
+
+  describe('complex expressions', () => {
+    it('chained arithmetic', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', '=1+2+3+4');
+      expect(sheet.get('A1')).toBe(10);
+    });
+
+    it('mixed operators with precedence', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', '=1+2*3+4');
+      expect(sheet.get('A1')).toBe(11);
+    });
+
+    it('nested parentheses', () => {
+      const sheet = new Spreadsheet();
+      sheet.set('A1', '=((1+2)*3)');
+      expect(sheet.get('A1')).toBe(9);
+    });
+  });
+});
