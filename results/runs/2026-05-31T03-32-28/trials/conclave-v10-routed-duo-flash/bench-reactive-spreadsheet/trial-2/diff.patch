t all non-empty cells as a Map from cell reference to computed value.\n   */\n  getCells(): Map<string, any> {\n    const result = new Map<string, any>();\n    for (const [key, data] of this.cells) {\n      if (data.computedValue !== null && data.computedValue !== undefined) {\n        result.set(key, data.computedValue);\n      }\n    }\n    return result;\n  }\n\n  private setRawValue(key: string, value: string | number | boolean): void {\n    // Clean up old dependencies if this cell previously had a formula\n    this.removeDependencies(key);\n\n    this.cells.set(key, {\n      raw: value,\n      computedValue: value,\n    });\n\n    // Recompute all dependents\n    this.recomputeDependents(key);\n  }\n\n  private setFormula(key: string, formula: string): void {\n    // Parse the formula\n    const ast = parseFormula(formula);\n\n    // Extract cell references from the formula\n    const refs = extractCellRefs(ast);\n\n    // Check for circular references before updating anything\n    if (this.wouldCreateCycle(key, refs)) {\n      throw new Error(`Circular reference detected for cell ${key}`);\n    }\n\n    // Clean up old dependencies if this cell previously had a formula\n    this.removeDependencies(key);\n\n    // Set up new dependencies\n    const depSet = new Set<string>(refs);\n    this.dependencies.set(key, depSet);\n    for (const ref of refs) {\n      if (!this.dependents.has(ref)) {\n        this.dependents.set(ref, new Set());\n      }\n      this.dependents.get(ref)!.add(key);\n    }\n\n    // Store the cell and compute its value\n    const computedValue = this.evaluateFormula(ast, key);\n    this.cells.set(key, {\n      raw: '=' + formula,\n      formula,\n      ast,\n      computedValue,\n    });\n\n    // Recompute all dependents\n    this.recomputeDependents(key);\n  }\n\n  /**\n   * Remove all dependency tracking for a cell (used when overwriting).\n   */\n  private removeDependencies(key: string): void {\n    const oldDeps = this.dependencies.get(key);\n    if (oldDeps) {\n      for (const dep of oldDeps) {\n        const depSet = this.dependents.get(dep);\n        if (depSet) {\n          depSet.delete(key);\n          if (depSet.size === 0) {\n            this.dependents.delete(dep);\n          }\n        }\n      }\n      this.dependencies.delete(key);\n    }\n  }\n\n  /**\n   * Check if setting cell `key` with dependencies on `refs` would create a cycle.\n   */\n  private wouldCreateCycle(key: string, refs: string[]): boolean {\n    // Use DFS to see if we can reach `key` from any of the `refs`\n    // (following the dependent graph)\n    const visited = new Set<string>();\n    const stack = [...refs];\n\n    while (stack.length > 0) {\n      const ref = stack.pop()!;\n      if (ref === key) return true;\n      if (visited.has(ref)) continue;\n      visited.add(ref);\n\n      // Check direct dependents of this ref\n      const deps = this.dependents.get(ref);\n      if (deps) {\n        for (const dep of deps) {\n          if (!visited.has(dep)) {\n            stack.push(dep);\n          }\n        }\n      }\n    }\n\n    return false;\n  }\n\n  /**\n   * Recompute all cells that (transitively) depend on the given cell.\n   * Uses a topological order to avoid redundant recomputation.\n   */\n  private recomputeDependents(key: string): void {\n    // Collect all cells that need recomputation, in topological order\n    const order = this.topologicalOrder(key);\n\n    for (const cellKey of order) {\n      if (cellKey === key) continue; // already handled by caller\n      this.recomputeCell(cellKey);\n    }\n  }\n\n  /**\n   * Compute a topological ordering of all cells that depend (transitively)\n   * on the given cell. This ensures each cell is recomputed after all its\n   * dependencies have been recomputed.\n   */\n  private topologicalOrder(startKey: string): string[] {\n    const visited = new Set<string>();\n    const result: string[] = [];\n\n    // Post-order DFS from startKey's dependents\n    c