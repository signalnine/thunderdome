, raw: '>' }); i++; continue; }\n    if (input[i] === '<') { tokens.push({ type: TokenType.Lt, value: '<', raw: '<' }); i++; continue; }\n\n    // Identifiers: cell references, booleans, function names\n    if (/[A-Za-z]/.test(input[i])) {\n      let ident = '';\n      while (i < input.length && /[A-Za-z0-9]/.test(input[i])) {\n        ident += input[i];\n        i++;\n      }\n\n      const upper = ident.toUpperCase();\n      if (upper === 'TRUE') {\n        tokens.push({ type: TokenType.Boolean, value: true, raw: ident });\n      } else if (upper === 'FALSE') {\n        tokens.push({ type: TokenType.Boolean, value: false, raw: ident });\n      } else if (['SUM', 'AVERAGE', 'MIN', 'MAX', 'COUNT', 'IF'].includes(upper)) {\n        tokens.push({ type: TokenType.Function, value: upper, raw: ident });\n      } else {\n        // Check if it looks like a cell reference (letters followed by digits)\n        const cellMatch = ident.match(/^([A-Za-z]+)(\\d+)$/);\n        if (cellMatch) {\n          tokens.push({ type: TokenType.CellRef, value: ident.toUpperCase(), raw: ident });\n        } else {\n          // Treat as a reference to a named cell (could be a missing cell, let's try parsing it)\n          // For robustness, treat anything that matches letter+number pattern as CellRef\n          // Otherwise it's an error - but we'll be lenient\n          tokens.push({ type: TokenType.CellRef, value: ident.toUpperCase(), raw: ident });\n        }\n      }\n      continue;\n    }\n\n    // Skip unknown characters (shouldn't happen with valid input)\n    i++;\n  }\n\n  return tokens;\n}\n\n/**\n * Determine if a '=' at position i is a comparison operator (not part of a formula prefix).\n * We check context: if the previous non-space token was an operator, paren, comma, or colon,\n * then = is likely a comparison. Otherwise, at the start it's the formula prefix.\n * Since we strip the leading = for parsing, this mainly handles cases inside expressions.\n * For our purposes, aft