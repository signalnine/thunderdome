+import { parseRange, cellRefToString } from './reference.js';
+
+// ===== Tokenizer =====
+
+export enum TokenType {
+  Number = 'Number',
+  String = 'String',
+  Boolean = 'Boolean',
+  CellRef = 'CellRef',
+  Plus = 'Plus',
+  Minus = 'Minus',
+  Star = 'Star',
+  Slash = 'Slash',
+  ParenOpen = 'ParenOpen',
+  ParenClose = 'ParenClose',
+  Comma = 'Comma',
+  Colon = 'Colon',
+  Gt = 'Gt',
+  Lt = 'Lt',
+  Gte = 'Gte',
+  Lte = 'Lte',
+  Eq = 'Eq',
+  Neq = 'Neq',
+  Function = 'Function',
+  EOF = 'EOF',
+}
+
+export interface Token {
+  type: TokenType;
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  value: any;
+  raw: string;
+}
+
+/**
+ * Tokenize a formula expression string (without the leading =).
+ */
+export function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+
+  while (i < input.length) {
+    // Skip whitespace
+    if (/\s/.test(input[i])) {
+      i++;
+      continue;
+    }
+
+    // String literals
+    if (input[i] === '"') {
+      let str = '';
+      i++; // skip opening quote
+      while (i < input.length && input[i] !== '"') {
+        str += input[i];
+        i++;
+      }
+      if (i < input.length) i++; // skip closing quote
+      tokens.push({ type: TokenType.String, value: str, raw: `"${str}"` });
+      continue;
+    }
+
+    // Number literals
+    if (/[0-9]/.test(input[i])) {
+      let num = '';
+      while (i < input.length && /[0-9.]/.test(input[i])) {
+        num += input[i];
+        i++;
+      }
+      tokens.push({ type: TokenType.Number, value: parseFloat(num), raw: num });
+      continue;
+    }
+
+    // Two-character operators: >=, <=, <>, != (treat != as <>)
+    if (i + 1 < input.length) {
+      const twoChar = input[i] + input[i + 1];
+      if (twoChar === '>=') {
+        tokens.push({ type: TokenType.Gte, value: '>=', raw: '>=' });
+        i += 2;
+        continue;
+      }
+      if (twoChar === '<=') {
+        tokens.push({ type: TokenType.Lte, value: '<=', raw: '<=' });
+        i += 2;
+        continue;
+      }
+      if (twoChar === '<>') {
+        tokens.push({ type: TokenType.Neq, value: '<>', raw: '<>' });
+        i += 2;
+        continue;
+      }
+    }
+
+    // Single-character operators
+    if (input[i] === '+') { tokens.push({ type: TokenType.Plus, value: '+', raw: '+' }); i++; continue; }
+    if (input[i] === '-') { tokens.push({ type: TokenType.Minus, value: '-', raw: '-' }); i++; continue; }
+    if (input[i] === '*') { tokens.push({ type: TokenType.Star, value: '*', raw: '*' }); i++; continue; }
+    if (input[i] === '/') { tokens.push({ type: TokenType.Slash, value: '/', raw: '/' }); i++; continue; }
+    if (input[i] === '(') { tokens.push({ type: TokenType.ParenOpen, value: '(', raw: '(' }); i++; continue; }
+    if (input[i] === ')') { tokens.push({ type: TokenType.ParenClose, value: ')', raw: ')' }); i++; continue; }
+    if (input[i] === ',') { tokens.push({ type: TokenType.Comma, value: ',', raw: ',' }); i++; continue; }
+    if (input[i] === ':') { tokens.push({ type: TokenType.Colon, value: ':', raw: ':' }); i++; continue; }
+    if (input[i] === '=' && isComparisonContext(input, i)) {
+      tokens.push({ type: TokenType.Eq, value: '=', raw: '=' });
+      i++;
+      continue;
+    }
+    if (input[i] === '>') { tokens.push({ type: TokenType.Gt, value: '>', raw: '>' }); i++; continue; }
+    if (input[i] === '<') { tokens.push({ type: TokenType.Lt, value: '<', raw: '<' }); i++; continue; }
+
+    // Identifiers: cell references, booleans, function names
+    if (/[A-Za-z]/.test(input[i])) {
+      let ident = '';
+      while (i < input.length && /[A-Za-z0-9]/.test(input[i])) {
+        ident += input[i];
+        i++;
+      }
+
+      const upper = ident.toUpperCase();
+      if (upper === 'TRUE') {
+        tokens.push({ type: TokenType.Boolean, value: true, raw: ident });
+      } else if (upper === 'FALSE') {
+        tokens.push({ type: TokenType.Boolean, value: false, raw: ident });
+      } else if (['SUM', 'AVERAGE', 'MIN', 'MAX', 'COUNT', 'IF'].includes(upper)) {
+        tokens.push({ type: TokenType.Function, value: upper, raw: ident });
+      } else {
+        // Check if it looks like a cell reference (letters followed by digits)
+        const cellMatch = ident.match(/^([A-Za-z]+)(\d+)$/);
+        if (cellMatch) {
+          tokens.push({ type: TokenType.CellRef, value: ident.toUpperCase(), raw: ident });
+        } else {
+          // For robustness, treat anything matching letter+number as CellRef
+          tokens.push({ type: TokenType.CellRef, value: ident.toUpperCase(), raw: ident });
+        }
+      }
+      continue;
+    }
+
+    // Skip unknown characters (shouldn't happen with valid input)
+    i++;
+  }
+
+  return tokens;
+}
+
+/**
+ * Determine if a '=' at position i is a comparison operator.
+ * Since the leading = is stripped before parsing, any remaining = is a comparison.
+ */
+function isComparisonContext(_input: string, _i: number): boolean {
+  return true;
+}
+
+// ===== AST =====
+
+export enum ASTNodeType {
+  Number = 'Number',
+  String = 'String',
+  Boolean = 'Boolean',
+  CellRef = 'CellRef',
+  Range = 'Range',
+  BinaryOp = 'BinaryOp',
+  UnaryOp = 'UnaryOp',
+  FunctionCall = 'FunctionCall',
+}
+
+export interface ASTNode {
+  type: ASTNodeType;
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  value?: any;
+  left?: ASTNode;
+  right?: ASTNode;
+  operator?: string;
+  operand?: ASTNode;
+  args?: ASTNode[];
+  start?: string;
+  end?: string;
+}
+
+// ===== Parser =====
+
+const EOF_TOKEN: Token = { type: TokenType.EOF, value: null, raw: '' };
+
+class Parser {
+  private tokens: Token[];
+  private pos: number;
+
+  constructor(tokens: Token[]) {
+    this.tokens = tokens;
+    this.pos = 0;
+  }
+
+  private isAtEnd(): boolean {
+    return this.pos >= this.tokens.length;
+  }
+
+  private peek(): Token {
+    if (this.isAtEnd()) return EOF_TOKEN;
+    return this.tokens[this.pos];
+  }
+
+  private consume(): Token {
+    if (this.isAtEnd()) return EOF_TOKEN;
+    return this.tokens[this.pos++];
+  }
+
+  private expect(type: TokenType): Token {
+    const token = this.peek();
+    if (token.type !== type) {
+      throw new Error(`Expected ${type} but got ${token.type} (${token.raw})`);
+    }
+    return this.consume();
+  }
+
+  parse(): ASTNode {
+    return this.expression();
+  }
+
+  private expression(): ASTNode {
+    const left = this.addition();
+
+    // Check for comparison operators
+    if (this.peek().type === TokenType.Eq ||
+        this.peek().type === TokenType.Neq ||
+        this.peek().type === TokenType.Gt ||
+        this.peek().type === TokenType.Lt ||
+        this.peek().type === TokenType.Gte ||
+        this.peek().type === TokenType.Lte) {
+      const op = this.consume();
+      const right = this.addition();
+      return {
+        type: ASTNodeType.BinaryOp,
+        operator: op.value,
+        left,
+        right,
+      };
+    }
+
+    return left;
+  }
+
+  private addition(): ASTNode {
+    let left = this.term();
+
+    while (this.peek().type === TokenType.Plus || this.peek().type === TokenType.Minus) {
+      const op = this.consume();
+      const right = this.term();
+      left = {
+        type: ASTNodeType.BinaryOp,
+        operator: op.value,
+        left,
+        right,
+      };
+    }
+
+    return left;
+  }
+
+  private term(): ASTNode {
+    let left = this.unary();
+
+    while (this.peek().type === TokenType.Star || this.peek().type === TokenType.Slash) {
+      const op = this.consume();
+      const right = this.unary();
+      left = {
+        type: ASTNodeType.BinaryOp,
+        operator: op.value,
+        left,
+        right,
+      };
+    }
+
+    return left;
+  }
+
+  private unary(): ASTNode {
+    if (this.peek().type === TokenType.Minus) {
+      this.consume();
+      const operand = this.unary();
+      return {
+        type: ASTNodeType.UnaryOp,
+        operator: '-',
+        operand,
+      };
+    }
+    return this.primary();
+  }
+
+  private primary(): ASTNode {
+    const token = this.peek();
+
+    // Number literal
+    if (token.type === TokenType.Number) {
+      this.consume();
+      return { type: ASTNodeType.Number, value: token.value };
+    }
+
+    // String literal
+    if (token.type === TokenType.String) {
+      this.consume();
+      return { type: ASTNodeType.String, value: token.value };
+    }
+
+    // Boolean literal
+    if (token.type === TokenType.Boolean) {
+      this.consume();
+      return { type: ASTNodeType.Boolean, value: token.value };
+    }
+
+    // Cell reference
+    if (token.type === TokenType.CellRef) {
+      this.consume();
+      // Check if followed by : for a range
+      if (this.peek().type === TokenType.Colon) {
+        this.consume(); // consume ':'
+        const endToken = this.expect(TokenType.CellRef);
+        return {
+          type: ASTNodeType.Range,
+          start: token.value,
+          end: endToken.value,
+        };
+      }
+      return { type: ASTNodeType.CellRef, value: token.value };
+    }
+
+    // Function call
+    if (token.type === TokenType.Function) {
+      return this.functionCall();
+    }
+
+    // Parenthesized expression
+    if (token.type === TokenType.ParenOpen) {
+      this.consume(); // '('
+      const node = this.expression();
+      this.expect(TokenType.ParenClose);
+      return node;
+    }
+
+    throw new Error(`Unexpected token: ${token.type} (${token.raw})`);
+  }
+
+  private functionCall(): ASTNode {
+    const token = this.consume(); // function name
+    this.expect(TokenType.ParenOpen);
+
+    const args: ASTNode[] = [];
+    while (this.peek().type !== TokenType.ParenClose && !this.isAtEnd()) {
+      // Check if the argument is a range (two cell refs with colon)
+      if (this.peek().type === TokenType.CellRef) {
+        const savedPos = this.pos;
+        const firstRef = this.consume();
+        if (this.peek().type === TokenType.Colon) {
+          this.consume();
+          if (this.peek().type === TokenType.CellRef) {
+            const secondRef = this.consume();
+            args.push({
+              type: ASTNodeType.Range,
+              start: firstRef.value,
+              end: secondRef.value,
+            });
+            if (this.peek().type === TokenType.Comma) {
+              this.consume();
+            }
+            continue;
+          }
+        }
+        // Not a range, backtrack
+        this.pos = savedPos;
+      }
+      args.push(this.expression());
+
+      if (this.peek().type === TokenType.Comma) {
+        this.consume();
+      }
+    }
+
+    this.expect(TokenType.ParenClose);
+    return {
+      type: ASTNodeType.FunctionCall,
+      value: token.value,
+      args,
+    };
+  }
+}
+
+/**
+ * Parse a formula expression string (without leading =) into an AST.
+ */
+export function parseFormula(input: string): ASTNode {
+  const trimmed = input.trim();
+  const tokens = tokenize(trimmed);
+  const parser = new Parser(tokens);
+  return parser.parse();
+}
+
+// ===== Evaluator =====
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export type CellLookup = (ref: string) => any;
+
+/**
+ * Evaluate an AST node to get the computed value.
+ */
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export function evaluate(node: ASTNode, lookup: CellLookup): any {
+  switch (node.type) {
+    case ASTNodeType.Number:
+      return node.value;
+
+    case ASTNodeType.String:
+      return node.value;
+
+    case ASTNodeType.Boolean:
+      return node.value;
+
+    case ASTNodeType.CellRef: {
+      const val = lookup(node.value);
+      return val !== null && val !== undefined ? val : 0;
+    }
+
+    case ASTNodeType.Range: {
+      const cells = parseRange(`${node.start}:${node.end}`);
+      return cells.map(c => {
+        const ref = cellRefToString(c);
+        const val = lookup(ref);
+        return val !== null && val !== undefined ? val : 0;
+      });
+    }
+
+    case ASTNodeType.UnaryOp:
+      if (node.operator === '-') {
+        const val = evaluate(node.operand!, lookup);
+        if (typeof val === 'number') return -val;
+        return -Number(val);
+      }
+      throw new Error(`Unknown unary operator: ${node.operator}`);
+
+    case ASTNodeType.BinaryOp: {
+      const left = evaluate(node.left!, lookup);
+      const right = evaluate(node.right!, lookup);
+      return applyBinaryOp(node.operator!, left, right);
+    }
+
+    case ASTNodeType.FunctionCall: {
+      return evaluateFunction(node.value!, node.args!, lookup);
+    }
+
+    default:
+      throw new Error(`Unknown AST node type: ${node.type}`);
+  }
+}
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+function applyBinaryOp(op: string, left: any, right: any): any {
+  const leftNum = typeof left === 'number' ? left : Number(left);
+  const rightNum = typeof right === 'number' ? right : Number(right);
+
+  switch (op) {
+    case '+': return leftNum + rightNum;
+    case '-': return leftNum - rightNum;
+    case '*': return leftNum * rightNum;
+    case '/': return leftNum / rightNum;
+    case '>': return leftNum > rightNum;
+    case '<': return leftNum < rightNum;
+    case '>=': return leftNum >= rightNum;
+    case '<=': return leftNum <= rightNum;
+    case '=': return leftNum === rightNum;
+    case '<>': return leftNum !== rightNum;
+    default: throw new Error(`Unknown operator: ${op}`);
+  }
+}
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+function evaluateFunction(name: string, args: ASTNode[], lookup: CellLookup): any {
+  switch (name) {
+    case 'SUM': {
+      const values = resolveNumericArgs(args, lookup);
+      return values.reduce((sum, v) => sum + v, 0);
+    }
+    case 'AVERAGE': {
+      const values = resolveNumericArgs(args, lookup);
+      if (values.length === 0) return 0;
+      return values.reduce((sum, v) => sum + v, 0) / values.length;
+    }
+    case 'MIN': {
+      const values = resolveNumericArgs(args, lookup);
+      if (values.length === 0) return 0;
+      return Math.min(...values);
+    }
+    case 'MAX': {
+      const values = resolveNumericArgs(args, lookup);
+      if (values.length === 0) return 0;
+      return Math.max(...values);
+    }
+    case 'COUNT': {
+      const values = resolveArgs(args, lookup);
+      return values.filter(v => typeof v === 'number' && !isNaN(v)).length;
+    }
+    case 'IF': {
+      if (args.length < 3) throw new Error('IF requires 3 arguments');
+      const condition = evaluate(args[0], lookup);
+      const isTruthy = typeof condition === 'boolean' ? condition :
+                       typeof condition === 'number' ? condition !== 0 :
+                       condition === true;
+      return evaluate(isTruthy ? args[1] : args[2], lookup);
+    }
+    default:
+      throw new Error(`Unknown function: ${name}`);
+  }
+}
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+function resolveArgs(args: ASTNode[], lookup: CellLookup): any[] {
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const values: any[] = [];
+  for (const arg of args) {
+    if (arg.type === ASTNodeType.Range) {
+      const rangeValues = evaluate(arg, lookup);
+      if (Array.isArray(rangeValues)) {
+        values.push(...rangeValues);
+      } else {
+        values.push(rangeValues);
+      }
+    } else {
+      values.push(evaluate(arg, lookup));
+    }
+  }
+  return values;
+}
+
+function resolveNumericArgs(args: ASTNode[], lookup: CellLookup): number[] {
+  return resolveArgs(args, lookup).filter((v): v is number => typeof v === 'number' && !isNaN(v));
+}
+
+// ===== Cell Reference Extraction =====
+
+/**
+ * Extract all cell references from an AST for dependency tracking.
+ * This expands ranges into individual cell references.
+ */
+export function extractCellRefs(node: ASTNode): string[] {
+  const refs = new Set<string>();
+
+  function walk(n: ASTNode) {
+    switch (n.type) {
+      case ASTNodeType.CellRef:
+        refs.add(n.value);
+        break;
+
+      case ASTNodeType.Range: {
+        const cells = parseRange(`${n.start}:${n.end}`);
+        for (const c of cells) {
+          refs.add(cellRefToString(c));
+        }
+        break;
+      }
+
+      case ASTNodeType.BinaryOp:
+        if (n.left) walk(n.left);
+        if (n.right) walk(n.right);
+        break;
+
+      case ASTNodeType.UnaryOp:
+        if (n.operand) walk(n.operand);
+        break;
+
+      case ASTNodeType.FunctionCall:
+        if (n.args) n.args.forEach(walk);
+        break;
+
+      // Literals don't contain references
+    }
+  }
+
+  walk(node);
+  return Array.from(refs);
+}
