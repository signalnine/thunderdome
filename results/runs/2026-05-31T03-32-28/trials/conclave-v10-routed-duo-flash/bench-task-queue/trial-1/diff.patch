1000 });\n247\t    // Non-delayed with low priority (10)\n248\t    queue.add({ normal: true }, { priority: 10 });\n249\t\n250\t    // Non-delayed should be returned first (despite lower priority)\n251\t    expect(queue.getNext()!.payload).toEqual({ normal: true });\n252\t  });\n253\t\n254\t  it('Q4.5: Delayed tasks available simultaneously ordered by priority then FIFO', async () => {\n255\t    const now = Date.now();\n256\t    const future = new Date(now + 50);\n257\t\n258\t    queue.add({ low: true }, { priority: 10, runAt: future });\n259\t    queue.add({ high: true }, { priority: 1, runAt: future });\n260\t    queue.add({ mid: true }, { priority: 5, runAt: future });\n261\t\n262\t    await new Promise(resolve => setTimeout(resolve, 100));\n263\t\n264\t    expect(queue.getNext()!.payload).toEqual({ high: true });\n265\t    expect(queue.getNext()!.payload).toEqual({ mid: true });\n266\t    expect(queue.getNext()!.payload).toEqual({ low: true });\n267\t  });\n268\t\n269\t  it('Q4.6: Task object has availableAt field', () => {\n270\t    const task = queue.add({}, { delay: 5000 });\n271\t    expect(task).toHaveProperty('availableAt');\n272\t    expect(task.availableAt).toBeInstanceOf(Date);\n273\t    expect(task.availableAt!.getTime()).toBeGreaterThan(Date.now());\n274\t\n275\t    const immediateTask = queue.add({});\n276\t    expect(immediateTask.availableAt).toBeNull();\n277\t  });\n278\t\n279\t  it('Q4.7: Delays work correctly with named queues', async () => {\n280\t    queue.add('fast', { msg: 'instant' });\n281\t    queue.add('slow', { msg: 'delayed' }, { delay: 100 });\n282\t\n283\t    expect(queue.getNext('fast')!.payload).toEqual({ msg: 'instant' });\n284\t    expect(queue.getNext('slow')).toBeNull();\n285\t\n286\t    await new Promise(resolve => setTimeout(resolve, 150));\n287\t    expect(queue.getNext('slow')!.payload).toEqual({ msg: 'delayed' });\n288\t  });\n289\t});\n290\t\n291\t// ===========================================================================\n292\t// Phase 5: Retry with Backoff\n293\t// ===========================================================================\n294\tdescribe('Phase 5 - Retry with Backoff', () => {\n295\t  let queue: TaskQueue;\n296\t\n297\t  beforeEach(() => {\n298\t    queue = new TaskQueue();\n299\t  });\n300\t\n301\t  it('Q5.1: complete() marks a processing task as completed', () => {\n302\t    const task = queue.add({});\n303\t    queue.getNext();\n304\t    queue.complete(task.id);\n305\t    expect(task.status).toBe('completed');\n306\t  });\n307\t\n308\t  it('Q5.2: fail() re-queues if retries remain, marks failed otherwise', async () => {\n309\t    // Task with 1 retry\n310\t    const task = queue.add({}, { retries: 1 });\n311\t    queue.getNext();\n312\t    queue.fail(task.id, new Error('oops'));\n313\t\n314\t    // Should be re-queued with delay\n315\t    expect(task.retryCount).toBe(1);\n316\t    expect(task.status).toBe('pending');\n317\t\n318\t    // After retry delay expires, it becomes available\n319\t    await vi.advanceTimersByTimeAsync(2000);\n320\t\n321\t    queue.getNext();\n322\t    queue.fail(task.id, new Error('oops again'));\n323\t    expect(task.retryCount).toBe(2);\n324\t    expect(task.status).toBe('failed');\n325\t  });\n326\t\n327\t  it('Q5.3: Default max retries is 3, configurable per task', () => {\n328\t    const defaultTask = queue.add({});\n329\t    expect(defaultTask.retriesMax).toBe(3);\n330\t\n331\t    const customTask = queue.add({}, { retries: 0 });\n332\t    expect(customTask.retriesMax).toBe(0);\n333\t  });\n334\t\n335\t  it('Q5.4: Backoff is baseDelay * 2^(attempt-1)', () => {\n336\t    vi.useFakeTimers();\n337\t    const task = queue.add({}, { retries: 3, retryDelay: 1000 });\n338\t    queue.getNext();\n339\t\n340\t    // First failure → backoff = 1000 * 2^0 = 1000ms\n341\t    queue.fail(task.id, 'err');\n342\t    const afterFirst = task.availableAt!.getTime() - Date.now();\n343\t    expect(afterFirst).toBeGreaterThanOrEqual(900);\n344\t    expect(afterFirst).toBeLessThanOrEqual(1100);\n345\t\n346\t    // Move past first backoff\n347\t    vi.advanceTimersByTime(2000);\n348\t    queue.getNext();\n349\t    // Second failure → backoff = 1000 * 2^1 = 2000ms\n350\t    queue.fail(task.id, 'err');\n351\t    const afterSecond = task.availableAt!.getTime() - Date.now();\n352\t    expect(afterSecond).toBeGreaterThanOrEqual(1900);\n353\t    expect(afterSecond).toBeLessThanOrEqual(2100);\n354\t\n355\t    vi.useRealTimers();\n356\t  });\n357\t\n358\t  it('Q5.5: Task tracks attempts count', () => {\n359\t    const task = queue.add({}, { retries: 2 });\n360\t    expect(task.attempts).toBe(0);\n361\t    queue.getNext();\n362\t    expect(task.attempts).toBe(1);\n363\t    queue.fail(task.id, 'err');\n364\t\n365\t    // After retry, get it again\n366\t    expect(task.attempts).toBe(1); // doesn't auto-increment on fail\n367\t  });\n368\t\n369\t  it('Q5.6: Retried tasks keep their original queue and priority', () => {\n370\t    const task = queue.add('myqueue', { x: 1 }, { priority: 3, retries: 1 });\n371\t    queue.getNext('myqueue');\n372\t    queue.fail(task.id, 'err');\n373\t\n374\t    // After retry delay, it should be available in same queue\n375\t    expect(task.queueName).toBe('myqueue');\n376\t    expect(task.priority).toBe(3);\n377\t  });\n378\t\n379\t  it('Q5.7: Exhausted retries → status is \"failed\"', () => {\n380\t    const task = queue.add({}, { retries: 0 });\n381\t    queue.getNext();\n382\t    queue.fail(task.id, 'last error');\n383\t    expect(task.status).toBe('failed');\n384\t    expect(task.error).toBe('last error');\n385\t  });\n386\t});\n387\t\n388\t// ===========================================================================\n389\t// Phase 6: Dead Letter Queue\n390\t// ===========================================================================\n391\tdescribe('Phase 6 - Dead Letter Queue', () => {\n392\t  let queue: TaskQueue;\n393\t\n394\t  beforeEach(() => {\n395\t    queue = new TaskQueue();\n396\t  });\n397\t\n398\t  it('Q6.1: Task with exhausted retries moves to dead letter queue', () => {\n399\t    const task = queue.add('email', { msg: 'fail' }, { retries: 0 });\n400\t    queue.getNext('email');\n401\t    queue.fail(task.id, 'permanent error');\n402\t\n403\t    const dlq = queue.getDeadLetterTasks('email');\n404\t    expect(dlq).toHaveLength(1);\n405\t    expect(dlq[0].id).toBe(task.id);\n406\t    expect(dlq[0].error).toBe('permanent error');\n407\t  });\n408\t\n409\t  it('Q6.2: getDeadLetterTasks returns all dead-lettered tasks', () => {\n410\t    const t1 = queue.add('q', { a: 1 }, { retries: 0 });\n411\t    const t2 = queue.add('q', { b: 2 }, { retries: 0 });\n412\t    queue.getNext('q');\n413\t    queue.fail(t1.id, 'err1');\n414\t    queue.getNext('q');\n415\t    queue.fail(t2.id, 'err2');\n416\t\n417\t    expect(queue.getDeadLetterTasks('q')).toHaveLength(2);\n418\t  });\n419\t\n420\t  it('Q6.3: Dead-lettered tasks retain error and retry info', () => {\n421\t    const task = queue.add('test', { x: 1 }, { retries: 1, retryDelay: 100 });\n422\t    queue.getNext('test');\n423\t    queue.fail(task.id, 'first fail');\n424\t    // Wait for retry\n425\t    const dlq = queue.getDeadLetterTasks('test');\n426\t    expect(dlq).toHaveLength(0); // still has retries\n427\t\n428\t    // After retry fails again\n429\t    // Using real timers; let's just retry immediately by adjusting availableAt manually\n430\t    // Actually let's use fake timers\n431\t  });\n432\t\n433\t  it('Q6.4: retryDeadLetterTask moves task back to original queue', () => {\n434\t    const task = queue.add('myq', { data: 1 }, { retries: 0 });\n435\t    queue.getNext('myq');\n436\t    queue.fail(task.id, 'fail');\n437\t\n438\t    expect(queue.getDeadLetterTasks('myq')).toHaveLength(1);\n439\t\n440\t    queue.retryDeadLetterTask('myq', task.id);\n441\t    expect(queue.getDeadLetterTasks('myq')).toHaveLength(0);\n442\t    expect(queue.waiting('myq')).toBe(1);\n443\t  });\n444\t\n445\t  it('Q6.5: clearDeadLetterTasks removes all DLQ tasks', () => {\n446\t    const task = queue.add('q', { data: 1 }, { retries: 0 });\n447\t    queue.getNext('q');\n448\t    queue.fail(task.id, 'err');\n449\t\n450\t    expect(queue.getDeadLetterTasks('q')).toHaveLength(1);\n451\t    queue.clearDeadLetterTasks('q');\n452\t    expect(queue.getDeadLetterTasks('q')).toHaveLength(0);\n453\t  });\n454\t\n455\t  it('Q6.6: Each queue has its own independent DLQ', () => {\n456\t    const a = queue.add('qa', { x: 1 }, { retries: 0 });\n457\t    const b = queue.add('qb', { y: 2 }, { retries: 0 });\n458\t    queue.getNext('qa');\n459\t    queue.fail(a.id, 'fail a');\n460\t    queue.getNext('qb');\n461\t    queue.fail(b.id, 'fail b');\n462\t\n463\t    expect(queue.getDeadLetterTasks('qa')).toHaveLength(1);\n464\t    expect(queue.getDeadLetterTasks('qb')).toHaveLength(1);\n465\t    expect(queue.getDeadLetterTasks('qa')[0].payload).toEqual({ x: 1 });\n466\t  });\n467\t});\n468\t\n469\t// ===========================================================================\n470\t// Phase 7: Task Dependencies\n471\t// ===========================================================================\n472\tdescribe('Phase 7 - Task Dependencies', () => {\n473\t  let queue: TaskQueue;\n474\t\n475\t  beforeEach(() => {\n476\t    queue = new TaskQueue();\n477\t  });\n478\t\n479\t  it('Q7.1: Tasks with dependsOn are blocked until dependencies complete', () => {\n480\t    const dep = queue.add({ setup: true });\n481\t    const dependent = queue.add({ later: true }, { dependsOn: [dep.id] });\n482\t\n483\t    expect(dependent.status).toBe('waiting');\n484\t    expect(queue.getNext()).toBeNull(); // dependent is blocked, no other tasks\n485\t  });\n486\t\n487\t  it('Q7.2: Blocked tasks are not returned by getNext', () => {\n488\t    const a = queue.add({ a: 1 });\n489\t    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n490\t\n491\t    // Only 'a' should be available\n492\t    expect(queue.getNext()!.id).toBe(a.id);\n493\t    expect(queue.getNext()).toBeNull();\n494\t  });\n495\t\n496\t  it('Q7.3: When dependency completes, blocked task becomes available', () => {\n497\t    const a = queue.add({ a: 1 });\n498\t    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n499\t\n500\t    queue.getNext(); // get a\n501\t    queue.complete(a.id);\n502\t\n503\t    // b should now be available\n504\t    expect(queue.getNext()!.id).toBe(b.id);\n505\t  });\n506\t\n507\t  it('Q7.4: Circular dependencies throw', () => {\n508\t    const a = queue.add({ a: 1 });\n509\t    // B depends on A\n510\t    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n511\t    // A should not be able to depend on B\n512\t    expect(() => queue.add({ c: 3 }, { dependsOn: [b.id] })).toThrow();\n513\t  });\n514\t\n515\t  it('Q7.5: Depending on non-existent task throws', () => {\n516\t    expect(() => {\n517\t      queue.add({ bad: true }, { dependsOn: ['non-existent-id'] });\n518\t    }).toThrow();\n519\t  });\n520\t\n521\t  it('Q7.6: A failed dependency does not auto-fail dependents', () => {\n522\t    const a = queue.add({ a: 1 }, { retries: 0 });\n523\t    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n524\t\n525\t    // Use independent complete/fail approach: get a, fail it\n526\t    expect(queue.getNext()!.id).toBe(a.id);\n527\t    queue.fail(a.id, 'boom');\n528\t\n529\t    // b should still be blocked (waiting)\n530\t    expect(queue.getNext()).toBeNull();\n531\t    expect(b.status).toBe('waiting');\n532\t  });\n533\t\n534\t  it('Q7.7: getTask returns task with dependencies and dependents', () => {\n535\t    const dep = queue.add({ dep: true });\n536\t    const task = queue.add({ main: true }, { dependsOn: [dep.id] });\n537\t\n538\t    const fetched = queue.getTask(task.id);\n539\t    expect(fetched).not.toBeNull();\n540\t    expect(fetched!.dependencies).toContain(dep.id);\n541\t    expect(fetched!.dependents).toEqual([]);\n542\t\n543\t    const depFetched = queue.getTask(dep.id);\n544\t    expect(depFetched!.dependents).toContain(task.id);\n545\t  });\n546\t});\n547\t\n548\t// ===========================================================================\n549\t// Phase 8: Concurrency Control\n550\t// ===========================================================================\n551\tdescribe('Phase 8 - Concurrency Control', () => {\n552\t  let queue: TaskQueue;\n553\t\n554\t  beforeEach(() => {\n555\t    queue = new TaskQueue();\n556\t  });\n557\t\n558\t  it('Q8.1: setConcurrency limits processing tasks', () => {\n559\t    queue.setConcurrency('default', 2);\n560\t    queue.add({ a: 1 });\n561\t    queue.add({ b: 2 });\n562\t    queue.add({ c: 3 });\n563\t\n564\t    expect(queue.getNext()).not.toBeNull();\n565\t    expect(queue.getNext()).not.toBeNull();\n566\t    // Limit reached\n567\t    expect(queue.getNext()).toBeNull();\n568\t  });\n569\t\n570\t  it('Q8.2: Default concurrency is unlimited', () => {\n571\t    queue.add({ a: 1 });\n572\t    queue.add({ b: 2 });\n573\t    queue.add({ c: 3 });\n574\t\n575\t    expect(queue.getNext()).not.toBeNull();\n576\t    expect(queue.getNext()).not.toBeNull();\n577\t    expect(queue.getNext()).not.toBeNull();\n578\t  });\n579\t\n580\t  it('Q8.3: getNext returns null when concurrency reached', () => {\n581\t    queue.setConcurrency('default', 1);\n582\t    queue.add({ a: 1 });\n583\t    queue.add({ b: 2 });\n584\t\n585\t    expect(queue.getNext()).not.toBeNull();\n586\t    expect(queue.getNext()).toBeNull();\n587\t    expect(queue.waiting()).toBe(1); // still has pending\n588\t  });\n589\t\n590\t  it('Q8.4: Completing/failing a task frees a slot', () => {\n591\t    queue.setConcurrency('default', 1);\n592\t    const a = queue.add({ a: 1 });\n593\t    const b = queue.add({ b: 2 });\n594\t\n595\t    const first = queue.getNext()!;\n596\t    expect(first.id).toBe(a.id);\n597\t    expect(queue.getNext()).toBeNull();\n598\t\n599\t    queue.complete(a.id);\n600\t    expect(queue.getNext()!.id).toBe(b.id);\n601\t  });\n602\t\n603\t  it('Q8.5: getConcurrency returns the limit', () => {\n604\t    queue.setConcurrency('test', 5);\n605\t    expect(queue.getConcurrency('test')).toBe(5);\n606\t    expect(queue.getConcurrency('non-existent')).toBeNull();\n607\t  });\n608\t\n609\t  it('Q8.6: getActiveCount returns number of processing tasks', () => {\n610\t    queue.setConcurrency('default', 3);\n611\t    queue.add({ a: 1 });\n612\t    queue.add({ b: 2 });\n613\t\n614\t    expect(queue.getActiveCount('default')).toBe(0);\n615\t    queue.getNext();\n616\t    expect(queue.getActiveCount('default')).toBe(1);\n617\t    queue.getNext();\n618\t    expect(queue.getActiveCount('default')).toBe(2);\n619\t    queue.complete(queue.getTask('')?.id || '');\n620\t  });\n621\t\n622\t  it('Q8.7: Concurrency respects priority ordering', () => {\n623\t    queue.setConcurrency('default', 1);\n624\t    queue.add({ low: true }, { priority: 10 });\n625\t    queue.add({ high: true }, { priority: 1 });\n626\t\n627\t    // Should get the high priority task first\n628\t    expect(queue.getNext()!.payload).toEqual({ high: true });\n629\t  });\n630\t});\n631\t\n632\t// ===========================================================================\n633\t// Phase 9: Progress Tracking and Cancellation\n634\t// ===========================================================================\n635\tdescribe('Phase 9 - Progress Tracking and Cancellation', () => {\n636\t  let queue: TaskQueue;\n637\t\n638\t  beforeEach(() => {\n639\t    queue = new TaskQueue();\n640\t  });\n641\t\n642\t  it('Q9.1: reportProgress updates a processing task progress', () => {\n643\t    const task = queue.add({});\n644\t    queue.getNext();\n645\t    queue.reportProgress(task.id, 50, 'halfway there');\n646\t\n647\t    expect(task.progress).toBe(50);\n648\t    expect(task.progressMessage).toBe('halfway there');\n649\t  });\n650\t\n651\t  it('Q9.2: getTask returns progress info', () => {\n652\t    const task = queue.add({});\n653\t    queue.getNext();\n654\t    queue.reportProgress(task.id, 75);\n655\t\n656\t    const fetched = queue.getTask(task.id);\n657\t    expect(fetched!.progress).toBe(75);\n658\t    expect(fetched!.progressMessage).toBe('');\n659\t  });\n660\t\n661\t  it('Q9.3: onProgress subscribes to progress updates', () => {\n662\t    const task = queue.add({});\n663\t    queue.getNext();\n664\t\n665\t    const updates: Array<{ pct: number; msg?: string }> = [];\n666\t    queue.onProgress(task.id, (pct, msg) => {\n667\t      updates.push({ pct, msg });\n668\t    });\n669\t\n670\t    queue.reportProgress(task.id, 25, 'quarter');\n671\t    queue.reportProgress(task.id, 50, 'half');\n672\t    queue.reportProgress(task.id, 75);\n673\t\n674\t    expect(updates).toHaveLength(3);\n675\t    expect(updates[0]).toEqual({ pct: 25, msg: 'quarter' });\n676\t    expect(updates[1]).toEqual({ pct: 50, msg: 'half' });\n677\t    expect(updates[2]).toEqual({ pct: 75, msg: undefined });\n678\t  });\n679\t\n680\t  it('Q9.4: Unsubscribing stops progress updates', () => {\n681\t    const task = queue.add({});\n682\t    queue.getNext();\n683\t\n684\t    const updates: number[] = [];\n685\t    const unsubscribe = queue.onProgress(task.id, (pct) => {\n686\t      updates.push(pct);\n687\t    });\n688\t\n689\t    queue.reportProgress(task.id, 25);\n690\t    expect(updates).toHaveLength(1);\n691\t\n692\t    unsubscribe();\n693\t\n694\t    queue.reportProgress(task.id, 50);\n695\t    expect(updates).toHaveLength(1); // no new update\n696\t  });\n697\t\n698\t  it('Q9.5: cancel sets cancelled status', () => {\n699\t    const pending = queue.add({ pending: true });\n700\t    const processing = queue.add({ processing: true });\n701\t\n702\t    queue.getNext(); // gets the processing one (pending was first)\n703\t\n704\t    queue.cancel(pending.id);\n705\t    expect(pending.status).toBe('cancelled');\n706\t\n707\t    queue.cancel(processing.id);\n708\t    expect(processing.status).toBe('cancelled');\n709\t  });\n710\t\n711\t  it('Q9.6: Cancelled pending tasks are removed from queue', () => {\n712\t    const task = queue.add({});\n713\t    queue.cancel(task.id);\n714\t    expect(queue.getNext()).toBeNull();\n715\t    expect(queue.waiting()).toBe(0);\n716\t  });\n717\t\n718\t  it('Q9.7: Cancelled processing tasks have status updated', () => {\n719\t    const task = queue.add({});\n720\t    queue.getNext();\n721\t    expect(task.status).toBe('processing');\n722\t\n723\t    queue.cancel(task.id);\n724\t    expect(task.status).toBe('cancelled');\n725\t  });\n726\t\n727\t  it('Q9.8: Cancelled tasks are never retried', () => {\n728\t    const task = queue.add({}, { retries: 3 });\n729\t    queue.getNext();\n730\t\n731\t    queue.cancel(task.id);\n732\t    // Even if we try to fail it, it stays cancelled\n733\t    queue.fail(task.id, 'should not retry');\n734\t    expect(task.status).toBe('cancelled');\n735\t    expect(task.retryCount).toBe(0);\n736\t  });\n737\t});\n738\t\n739\t// ===========================================================================\n740\t// Phase 10: Recurring Tasks\n741\t// ===========================================================================\n742\tdescribe('Phase 10 - Recurring Tasks', () => {\n743\t  let queue: TaskQueue;\n744\t\n745\t  beforeEach(() => {\n746\t    queue = new TaskQueue();\n747\t  });\n748\t\n749\t  it('Q10.1: addSchedule creates a schedule and returns an ID', () => {\n750\t    const id = queue.addSchedule('*/5 * * * *', 'email', { type: 'reminder' });\n751\t    expect(id).toBeDefined();\n752\t    expect(typeof id).toBe('string');\n753\t  });\n754\t\n755\t  it('Q10.3: listSchedules returns active schedules', () => {\n756\t    queue.addSchedule('*/5 * * * *', 'q', { a: 1 });\n757\t    queue.addSchedule('0 * * * *', 'q', { b: 2 });\n758\t\n759\t    expect(queue.listSchedules()).toHaveLength(2);\n760\t  });\n761\t\n762\t  it('Q10.4: removeSchedule stops a schedule', () => {\n763\t    const id = queue.addSchedule('*/5 * * * *', 'q', {});\n764\t    expect(queue.listSchedules()).toHaveLength(1);\n765\t\n766\t    queue.removeSchedule(id);\n767\t    expect(queue.listSchedules()).toHaveLength(0);\n768\t  });\n769\t\n770\t  it('Q10.5: checkSchedules enqueues tasks for due schedules', () => {\n771\t    const schedId = queue.addSchedule('*/5 * * * *', 'test-queue', { recurring: true });\n772\t\n773\t    queue.checkSchedules();\n774\t    const schedule = queue.listSchedules().find(s => s.id === schedId);\n775\t    expect(schedule!.lastRun).not.toBeNull();\n776\t\n777\t    // A task should have been added to the queue\n778\t    expect(queue.waiting('test-queue')).toBe(1);\n779\t    const task = queue.getNext('test-queue');\n780\t    expect(task!.payload).toEqual({ recurring: true });\n781\t  });\n782\t\n783\t  it('Q10.6: Enqueued tasks are regular tasks', () => {\n784\t    queue.addSchedule('*/5 * * * *', 'q', { recurring: true });\n785\t    queue.checkSchedules();\n786\t\n787\t    const task = queue.getNext('q');\n788\t    expect(task!.id).toBeDefined();\n789\t    expect(task!.status).toBe('processing');\n790\t    expect(task!.payload).toEqual({ recurring: true });\n791\t  });\n792\t\n793\t  it('Q10.7: addSchedule returns unique schedule IDs', () => {\n794\t    const a = queue.addSchedule('*/5 * * * *', 'q1', {});\n795\t    const b = queue.addSchedule('*/5 * * * *', 'q2', {});\n796\t    expect(a).not.toBe(b);\n797\t  });\n798\t\n799\t  it('Q10.8: Removed schedule no longer enqueues tasks', () => {\n800\t    const id = queue.addSchedule('*/5 * * * *', 'q', {});\n801\t    queue.removeSchedule(id);\n802\t\n803\t    queue.checkSchedules();\n804\t    expect(queue.waiting('q')).toBe(0);\n805\t  });\n806\t\n807\t  it('Supports 0 * * * * (hourly) cron', () => {\n808\t    expect(() => queue.addSchedule('0 * * * *', 'q', {})).not.toThrow();\n809\t  });\n810\t\n811\t  it('Supports 0 0 * * * (daily) cron', () => {\n812\t    expect(() => queue.addSchedule('0 0 * * *', 'q', {})).not.toThrow();\n813\t  });\n814\t\n815\t  it('Rejects unsupported cron expressions', () => {\n816\t    expect(() => queue.addSchedule('* * * * *', 'q', {})).toThrow();\n817\t    expect(() => queue.addSchedule('0 0 1 * *', 'q', {})).toThrow();\n818\t  });\n819\t});\n820\t\n821\t// ===========================================================================\n822\t// Phase 11: Middleware Pipeline\n823\t// ===========================================================================\n824\tdescribe('Phase 11 - Middleware Pipeline', () => {\n825\t  let queue: TaskQueue;\n826\t\n827\t  beforeEach(() => {\n828\t    queue = new TaskQueue();\n829\t  });\n830\t\n831\t  it('Q11.1: use registers middleware on a queue', () => {\n832\t    expect(() => {\n833\t      queue.use('test', async (_task, next) => { await next(); });\n834\t    }).not.toThrow();\n835\t  });\n836\t\n837\t  it('Q11.3: Middleware runs in order then handler', async () => {\n838\t    const order: string[] = [];\n839\t\n840\t    queue.use('test', async (_task, next) => {\n841\t      order.push('mw1-before');\n842\t      await next();\n843\t      order.push('mw1-after');\n844\t    });\n845\t    queue.use('test', async (_task, next) => {\n846\t      order.push('mw2-before');\n847\t      await next();\n848\t      order.push('mw2-after');\n849\t    });\n850\t    queue.process('test', async (_task) => {\n851\t      order.push('handler');\n852\t    });\n853\t\n854\t    queue.add('test', {});\n855\t    const task = queue.getNext('test')!;\n856\t    await queue.runTask(task.id);\n857\t\n858\t    expect(order).toEqual(['mw1-before', 'mw2-before', 'handler', 'mw2-after', 'mw1-after']);\n859\t  });\n860\t\n861\t  it('Q11.5: If middleware does not call next, handler is skipped', async () => {\n862\t    const order: string[] = [];\n863\t\n864\t    queue.use('test', async (_task, _next) => {\n865\t      order.push('mw1');\n866\t      // deliberately not calling next\n867\t    });\n868\t    queue.process('test', async (_task) => {\n869\t      order.push('handler');\n870\t    });\n871\t\n872\t    queue.add('test', {});\n873\t    const task = queue.getNext('test')!;\n874\t    await queue.runTask(task.id);\n875\t    expect(order).toEqual(['mw1']);\n876\t  });\n877\t\n878\t  it('Q11.6: Middleware can modify the task payload', async () => {\n879\t    queue.use('test', async (task, next) => {\n880\t      (task.payload as Record<string, unknown>).modified = true;\n881\t      await next();\n882\t    });\n883\t    queue.process('test', async (task) => {\n884\t      expect((task.payload as Record<string, unknown>).modified).toBe(true);\n885\t    });\n886\t\n887\t    queue.add('test', { original: true });\n888\t    const task = queue.getNext('test')!;\n889\t    await queue.runTask(task.id);\n890\t    expect(queue.getTask(task.id)!.status).toBe('completed');\n891\t  });\n892\t\n893\t  it('Q11.7: Middleware that throws marks task as failed', async () => {\n894\t    queue.use('test', async (_task, _next) => {\n895\t      throw new Error('middleware failure');\n896\t    });\n897\t    queue.process('test', async (_task) => {\n898\t      // should not reach here\n899\t    });\n900\t\n901\t    queue.add('test', {});\n902\t    const task = queue.getNext('test')!;\n903\t    await queue.runTask(task.id);\n904\t    expect(task.status).toBe('failed');\n905\t  });\n906\t\n907\t  it('Q11.8: Each queue has its own middleware stack', async () => {\n908\t    const order: string[] = [];\n909\t\n910\t    queue.use('q1', async (_task, next) => {\n911\t      order.push('q1-mw');\n912\t      await next();\n913\t    });\n914\t    queue.use('q2', async (_task, next) => {\n915\t      order.push('q2-mw');\n916\t      await next();\n917\t    });\n918\t    queue.process('q1', async (_task) => {\n919\t      order.push('q1-handler');\n920\t    });\n921\t    queue.process('q2', async (_task) => {\n922\t      order.push('q2-handler');\n923\t    });\n924\t\n925\t    queue.add('q1', {});\n926\t    queue.add('q2', {});\n927\t\n928\t    await queue.runTask(queue.getNext('q1')!.id);\n929\t    await queue.runTask(queue.getNext('q2')!.id);\n930\t\n931\t    expect(order).toEqual(['q1-mw', 'q1-handler', 'q2-mw', 'q2-handler']);\n932\t  });\n933\t});\n934\t\n935\t// ===========================================================================\n936\t// Phase 12: Graceful Shutdown\n937\t// ===========================================================================\n938\tdescribe('Phase 12 - Graceful Shutdown', () => {\n939\t  let queue: TaskQueue;\n940\t\n941\t  beforeEach(() => {\n942\t    queue = new TaskQueue();\n943\t  });\n944\t\n945\t  it('Q12.2: After shutdown, add() throws', async () => {\n946\t    await queue.shutdown();\n947\t    expect(() => queue.add({})).toThrow();\n948\t  });\n949\t\n950\t  it('Q12.3: Shutdown waits for processing tasks', async () => {\n951\t    queue.add({});\n952\t    queue.getNext(); // now processing\n953\t\n954\t    // Complete the task after a short delay\n955\t    setTimeout(() => {\n956\t      queue.complete(queue.listQueues().length > 0 ? '' : ''); // find task\n957\t    }, 50);\n958\t    // This is inherently racy — let's do it differently\n959\t    // Actually let's not rely on timers being precise\n960\t  });\n961\t\n962\t  it('Q12.5: onShutdown callbacks run during shutdown', async () => {\n963\t    const calls: string[] = [];\n964\t    queue.onShutdown(() => { calls.push('cb1'); });\n965\t    queue.onShutdown(() => { calls.push('cb2'); });\n966\t\n967\t    await queue.shutdown();\n968\t    expect(calls).toEqual(['cb1', 'cb2']);\n969\t  });\n970\t\n971\t  it('Q12.6: shutdown returns ShutdownResult', async () => {\n972\t    const result = await queue.shutdown();\n973\t    expect(result).toHaveProperty('completed');\n974\t    expect(result).toHaveProperty('cancelled');\n975\t    expect(result).toHaveProperty('duration');\n976\t    expect(typeof result.completed).toBe('number');\n977\t    expect(typeof result.cancelled).toBe('number');\n978\t    expect(typeof result.duration).toBe('number');\n979\t  });\n980\t\n981\t  it('Q12.7: Multiple shutdown calls return the same result', async () => {\n982\t    const first = await queue.shutdown();\n983\t    const second = await queue.shutdown();\n984\t    expect(first).toBe(second);\n985\t  });\n986\t\n987\t  it('Q12.8: Shutdown with no processing tasks completes immediately', async () => {\n988\t    const start = Date.now();\n989\t    await queue.shutdown();\n990\t    const elapsed = Date.now() - start;\n991\t    expect(elapsed).toBeLessThan(500); // should be near-instant\n992\t  });\n993\t\n994\t  it('Q12.4: Processing tasks exceeding timeout are force-cancelled', async () => {\n995\t    const slow = queue.add({});\n996\t    queue.getNext(); // now processing - never completes\n997\t\n998\t    const result = await queue.shutdown({ timeout: 100 });\n999\t    // The task should have been cancelled\n1000\t    expect(slow.status).toBe('cancelled');\n1001\t    expect(result.cancelled).toBeGreaterThanOrEqual(0); // at least the slow one\n1002\t  });\n1003\t});\n1004\t\n1005\t// ===========================================================================\n1006\t// Integration: Cross-phase interaction tests\n1007\t// ===========================================================================\n1008\tdescribe('Integration - Cross-Phase Interactions', () => {\n1009\t  let queue: TaskQueue;\n1010\t\n1011\t  beforeEach(() => {\n1012\t    queue = new TaskQueue();\n1013\t  });\n1014\t\n1015\t  it('Priority + Named queues + Delays work together', async () => {\n1016\t    queue.add('high-delay', { x: 1 }, { priority: 1, delay: 100 });\n1017\t    queue.add('low-instant', { y: 2 }, { priority: 10 });\n1018\t\n1019\t    // Instant task should come first\n1020\t    expect(queue.getNext('low-instant')!.payload).toEqual({ y: 2 });\n1021\t    expect(queue.getNext('high-delay')).toBeNull();\n1022\t\n1023\t    await new Promise(resolve => setTimeout(resolve, 150));\n1024\t    expect(queue.getNext('high-delay')!.payload).toEqual({ x: 1 });\n1025\t  });\n1026\t\n1027\t  it('Priority + Concurrency: highest priority within limit', () => {\n1028\t    queue.setConcurrency('default', 1);\n1029\t    queue.add({ low: true }, { priority: 10 });\n1030\t    queue.add({ high: true }, { priority: 1 });\n1031\t    queue.add({ mid: true }, { priority: 5 });\n1032\t\n1033\t    expect(queue.getNext()!.payload).toEqual({ high: true });\n1034\t  });\n1035\t\n1036\t  it('Complete + Dependency chain works linearly', () => {\n1037\t    const a = queue.add({ a: 1 });\n1038\t    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n1039\t    const c = queue.add({ c: 3 }, { dependsOn: [b.id] });\n1040\t\n1041\t    // Only a is available\n1042\t    expect(queue.getNext()!.id).toBe(a.id);\n1043\t    queue.complete(a.id);\n1044\t\n1045\t    // Now b is available\n1046\t    expect(queue.getNext()!.id).toBe(b.id);\n1047\t    queue.complete(b.id);\n1048\t\n1049\t    // Now c is available\n1050\t    expect(queue.getNext()!.id).toBe(c.id);\n1051\t  });\n1052\t\n1053\t  it('Retry + DLQ + Retry from DLQ', () => {\n1054\t    // Task that fails once, gets retried, fails again, goes to DLQ, then retried from DLQ\n1055\t    const task = queue.add('q', { data: 1 }, { retries: 1, retryDelay: 10 });\n1056\t\n1057\t    // First attempt — fail\n1058\t    queue.getNext('q');\n1059\t    queue.fail(task.id, 'first fail');\n1060\t    expect(task.status).toBe('pending');\n1061\t    expect(task.retryCount).toBe(1);\n1062\t\n1063\t    // Second attempt — fail (no more retries)\n1064\t    // Task should be available now with minimal backoff\n1065\t    // We need to handle the timing — the retry delay is 10*2^0=10ms\n1066\t    // After 10ms it's available\n1067\t  });\n1068\t\n1069\t  it('Cancel prevents retry', () => {\n1070\t    const task = queue.add({}, { retries: 3 });\n1071\t    queue.getNext();\n1072\t    queue.cancel(task.id);\n1073\t    queue.fail(task.id, 'should not retry');\n1074\t    expect(task.status).toBe('cancelled');\n1075\t    expect(task.retryCount).toBe(0);\n1076\t  });\n1077\t\n1078\t  it('Middleware + Completion status', async () => {\n1079\t    let mwRan = false;\n1080\t    queue.use('test', async (t, next) => {\n1081\t      mwRan = true;\n1082\t      await next();\n1083\t    });\n1084\t    queue.process('test', async (_t) => {\n1085\t      // does work\n1086\t    });\n1087\t\n1088\t    queue.add('test', {});\n1089\t    const task = queue.getNext('test')!;\n1090\t    await queue.runTask(task.id);\n1091\t    expect(mwRan).toBe(true);\n1092\t    expect(queue.getTask(task.id)!.status).toBe('completed');\n1093\t  });\n1094\t});\n1095\t"}]},"parent_tool_use_id":null,"session_id":"e732de07-d204-4074-ada0-6507b7164e45","uuid":"89c9ecf4-5fc5-4bbd-96e7-33c4efbac5bb","timestamp":"2026-05-31T03:56:40.760Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/tests/task-queue.test.ts","content":"import { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/task-queue.js';\n\n// ===========================================================================\n// Phase 1: Basic FIFO Queue\n// ===========================================================================\ndescribe('Phase 1 - Basic FIFO Queue', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q1.2: add() returns a task object with id, payload, status, createdAt', () => {\n    const task = queue.add({ hello: 'world' });\n    expect(task).toHaveProperty('id');\n    expect(typeof task.id).toBe('string');\n    expect(task.payload).toEqual({ hello: 'world' });\n    expect(task).toHaveProperty('status');\n    expect(task).toHaveProperty('createdAt');\n    expect(task.createdAt).toBeInstanceOf(Date);\n  });\n\n  it('Q1.3: New tasks start with status \"pending\"', () => {\n    const task = queue.add({ x: 1 });\n    expect(task.status).toBe('pending');\n  });\n\n  it('Q1.4: Each task has a unique id', () => {\n    const a = queue.add({});\n    const b = queue.add({});\n    expect(a.id).not.toBe(b.id);\n  });\n\n  it('Q1.5: getNext() returns the oldest pending task and sets status to \"processing\"', () => {\n    const task = queue.add({ val: 1 });\n    const retrieved = queue.getNext();\n    expect(retrieved).not.toBeNull();\n    expect(retrieved!.id).toBe(task.id);\n    expect(retrieved!.status).toBe('processing');\n    // Original task object should also have updated status\n    expect(task.status).toBe('processing');\n  });\n\n  it('Q1.6: getNext() returns null when queue is empty', () => {\n    expect(queue.getNext()).toBeNull();\n    queue.add({});\n    queue.getNext();\n    expect(queue.getNext()).toBeNull();\n  });\n\n  it('Q1.7: waiting() returns count of pending tasks', () => {\n    expect(queue.waiting()).toBe(0);\n    queue.add({ a: 1 });\n    expect(queue.waiting()).toBe(1);\n    queue.add({ b: 2 });\n    expect(queue.waiting()).toBe(2);\n    queue.getNext();\n    expect(queue.waiting()).toBe(1);\n  });\n\n  it('Q1.8: Tasks are returned in FIFO order', () => {\n    const a = queue.add({ order: 1 });\n    const b = queue.add({ order: 2 });\n    const c = queue.add({ order: 3 });\n\n    expect(queue.getNext()!.id).toBe(a.id);\n    expect(queue.getNext()!.id).toBe(b.id);\n    expect(queue.getNext()!.id).toBe(c.id);\n    expect(queue.getNext()).toBeNull();\n  });\n});\n\n// ===========================================================================\n// Phase 2: Named Queues\n// ===========================================================================\ndescribe('Phase 2 - Named Queues', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q2.1: add(payload) without queue name uses the default queue', () => {\n    const task = queue.add({ x: 1 });\n    expect(task.queueName).toBe('default');\n    expect(queue.getNext()!.id).toBe(task.id);\n  });\n\n  it('Q2.2: add(\"name\", payload) adds to the named queue', () => {\n    const task = queue.add('email', { to: 'user@test.com' });\n    expect(task.queueName).toBe('email');\n  });\n\n  it('Q2.3: Named queues operate independently', () => {\n    queue.add('a', { msg: 'from a' });\n    queue.add('b', { msg: 'from b' });\n\n    const aTask = queue.getNext('a');\n    expect(aTask!.payload).toEqual({ msg: 'from a' });\n\n    const bTask = queue.getNext('b');\n    expect(bTask!.payload).toEqual({ msg: 'from b' });\n  });\n\n  it('Q2.4: Queues are created implicitly when first task is added', () => {\n    expect(queue.listQueues()).not.toContain('auto-created');\n    queue.add('auto-created', {});\n    expect(queue.listQueues()).toContain('auto-created');\n  });\n\n  it('Q2.5: listQueues() returns all queue names', () => {\n    queue.add('alpha', {});\n    queue.add('beta', {});\n    queue.add('default', {}); // adds to default\n    const names = queue.listQueues();\n    expect(names).toContain('alpha');\n    expect(names).toContain('beta');\n    expect(names).toContain('default');\n  });\n\n  it('Q2.6: getNext() from non-existent or empty queue returns null', () => {\n    expect(queue.getNext('no-such-queue')).toBeNull();\n    queue.add('empty-now', {});\n    queue.getNext('empty-now');\n    expect(queue.getNext('empty-now')).toBeNull();\n  });\n\n  it('Q2.7: Phase 1 syntax still works (backward compatible)', () => {\n    const task = queue.add({ compat: true });\n    expect(task.id).toBeDefined();\n    const retrieved = queue.getNext();\n    expect(retrieved!.id).toBe(task.id);\n    expect(queue.waiting()).toBe(0);\n  });\n});\n\n// ===========================================================================\n// Phase 3: Priority\n// ===========================================================================\ndescribe('Phase 3 - Priority', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q3.1: Default priority is 5', () => {\n    const task = queue.add({});\n    expect(task.priority).toBe(5);\n  });\n\n  it('Q3.2: Priority range is 1-10', () => {\n    const low = queue.add({}, { priority: 10 });\n    expect(low.priority).toBe(10);\n    const high = queue.add({}, { priority: 1 });\n    expect(high.priority).toBe(1);\n  });\n\n  it('Q3.3: Higher-priority (lower number) tasks are returned first', () => {\n    queue.add({ id: 'normal' }, { priority: 5 });\n    queue.add({ id: 'urgent' }, { priority: 1 });\n    queue.add({ id: 'low' }, { priority: 10 });\n\n    expect(queue.getNext()!.payload).toEqual({ id: 'urgent' });\n    expect(queue.getNext()!.payload).toEqual({ id: 'normal' });\n    expect(queue.getNext()!.payload).toEqual({ id: 'low' });\n  });\n\n  it('Q3.4: Same-priority tasks are FIFO', () => {\n    const a = queue.add({ order: 1 }, { priority: 5 });\n    const b = queue.add({ order: 2 }, { priority: 5 });\n    const c = queue.add({ order: 3 }, { priority: 5 });\n\n    expect(queue.getNext()!.id).toBe(a.id);\n    expect(queue.getNext()!.id).toBe(b.id);\n    expect(queue.getNext()!.id).toBe(c.id);\n  });\n\n  it('Q3.5: Invalid priority values throw', () => {\n    expect(() => queue.add({}, { priority: 0 })).toThrow();\n    expect(() => queue.add({}, { priority: 11 })).toThrow();\n    expect(() => queue.add({}, { priority: 1.5 })).toThrow();\n    // Valid values should not throw\n    expect(() => queue.add({}, { priority: 1 })).not.toThrow();\n    expect(() => queue.add({}, { priority: 10 })).not.toThrow();\n  });\n\n  it('Q3.6: Priority operates per-queue', () => {\n    queue.add('q1', { id: 'urgent' }, { priority: 1 });\n    queue.add('q2', { id: 'normal' }, { priority: 5 });\n\n    expect(queue.getNext('q1')!.payload).toEqual({ id: 'urgent' });\n    // q2 should still have its normal task\n    expect(queue.getNext('q2')!.payload).toEqual({ id: 'normal' });\n  });\n\n  it('Q3.7: Task object exposes priority', () => {\n    const task = queue.add({}, { priority: 3 });\n    expect(task.priority).toBe(3);\n  });\n});\n\n// ===========================================================================\n// Phase 4: Delayed Tasks\n// ===========================================================================\ndescribe('Phase 4 - Delayed Tasks', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q4.1: add with delay creates a task that is not available until after the delay', async () => {\n    queue.add({ normal: true });\n    queue.add({ delayed: true }, { delay: 100 });\n    // Initially, only the normal task is returned\n    expect(queue.getNext()!.payload).toEqual({ normal: true });\n    // Delayed task should not be available yet\n    expect(queue.getNext()).toBeNull();\n\n    // Wait for delay to pass\n    await new Promise(resolve => setTimeout(resolve, 150));\n    expect(queue.getNext()!.payload).toEqual({ delayed: true });\n  });\n\n  it('Q4.2: add with runAt creates a task that becomes available at that date', async () => {\n    const future = new Date(Date.now() + 100);\n    queue.add({ scheduled: true }, { runAt: future });\n\n    expect(queue.getNext()).toBeNull();\n\n    await new Promise(resolve => setTimeout(resolve, 150));\n    expect(queue.getNext()!.payload).toEqual({ scheduled: true });\n  });\n\n  it('Q4.3: Delayed tasks appear in waiting() count even when not yet available', () => {\n    queue.add({ immediate: true });\n    queue.add({ delayed: true }, { delay: 5000 });\n\n    expect(queue.waiting()).toBe(2);\n  });\n\n  it('Q4.4: Non-delayed tasks preferred over unavailable delayed tasks regardless of priority', () => {\n    // Delayed with high priority (1)\n    queue.add({ important: true }, { priority: 1, delay: 1000 });\n    // Non-delayed with low priority (10)\n    queue.add({ normal: true }, { priority: 10 });\n\n    // Non-delayed should be returned first (despite lower priority)\n    expect(queue.getNext()!.payload).toEqual({ normal: true });\n  });\n\n  it('Q4.5: Delayed tasks available simultaneously ordered by priority then FIFO', async () => {\n    const now = Date.now();\n    const future = new Date(now + 50);\n\n    queue.add({ low: true }, { priority: 10, runAt: future });\n    queue.add({ high: true }, { priority: 1, runAt: future });\n    queue.add({ mid: true }, { priority: 5, runAt: future });\n\n    await new Promise(resolve => setTimeout(resolve, 100));\n\n    expect(queue.getNext()!.payload).toEqual({ high: true });\n    expect(queue.getNext()!.payload).toEqual({ mid: true });\n    expect(queue.getNext()!.payload).toEqual({ low: true });\n  });\n\n  it('Q4.6: Task object has availableAt field', () => {\n    const task = queue.add({}, { delay: 5000 });\n    expect(task).toHaveProperty('availableAt');\n    expect(task.availableAt).toBeInstanceOf(Date);\n    expect(task.availableAt!.getTime()).toBeGreaterThan(Date.now());\n\n    const immediateTask = queue.add({});\n    expect(immediateTask.availableAt).toBeNull();\n  });\n\n  it('Q4.7: Delays work correctly with named queues', async () => {\n    queue.add('fast', { msg: 'instant' });\n    queue.add('slow', { msg: 'delayed' }, { delay: 100 });\n\n    expect(queue.getNext('fast')!.payload).toEqual({ msg: 'instant' });\n    expect(queue.getNext('slow')).toBeNull();\n\n    await new Promise(resolve => setTimeout(resolve, 150));\n    expect(queue.getNext('slow')!.payload).toEqual({ msg: 'delayed' });\n  });\n});\n\n// ===========================================================================\n// Phase 5: Retry with Backoff\n// ===========================================================================\ndescribe('Phase 5 - Retry with Backoff', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q5.1: complete() marks a processing task as completed', () => {\n    const task = queue.add({});\n    queue.getNext();\n    queue.complete(task.id);\n    expect(task.status).toBe('completed');\n  });\n\n  it('Q5.2: fail() re-queues if retries remain, marks failed otherwise', async () => {\n    // Task with 1 retry\n    const task = queue.add({}, { retries: 1 });\n    queue.getNext();\n    queue.fail(task.id, new Error('oops'));\n\n    // Should be re-queued with delay\n    expect(task.retryCount).toBe(1);\n    expect(task.status).toBe('pending');\n\n    // After retry delay expires, it becomes available\n    await vi.advanceTimersByTimeAsync(2000);\n\n    queue.getNext();\n    queue.fail(task.id, new Error('oops again'));\n    expect(task.retryCount).toBe(2);\n    expect(task.status).toBe('failed');\n  });\n\n  it('Q5.3: Default max retries is 3, configurable per task', () => {\n    const defaultTask = queue.add({});\n    expect(defaultTask.retriesMax).toBe(3);\n\n    const customTask = queue.add({}, { retries: 0 });\n    expect(customTask.retriesMax).toBe(0);\n  });\n\n  it('Q5.4: Backoff is baseDelay * 2^(attempt-1)', () => {\n    vi.useFakeTimers();\n    const task = queue.add({}, { retries: 3, retryDelay: 1000 });\n    queue.getNext();\n\n    // First failure → backoff = 1000 * 2^0 = 1000ms\n    queue.fail(task.id, 'err');\n    const afterFirst = task.availableAt!.getTime() - Date.now();\n    expect(afterFirst).toBeGreaterThanOrEqual(900);\n    expect(afterFirst).toBeLessThanOrEqual(1100);\n\n    // Move past first backoff\n    vi.advanceTimersByTime(2000);\n    queue.getNext();\n    // Second failure → backoff = 1000 * 2^1 = 2000ms\n    queue.fail(task.id, 'err');\n    const afterSecond = task.availableAt!.getTime() - Date.now();\n    expect(afterSecond).toBeGreaterThanOrEqual(1900);\n    expect(afterSecond).toBeLessThanOrEqual(2100);\n\n    vi.useRealTimers();\n  });\n\n  it('Q5.5: Task tracks attempts count', () => {\n    const task = queue.add({}, { retries: 2 });\n    expect(task.attempts).toBe(0);\n    queue.getNext();\n    expect(task.attempts).toBe(1);\n    queue.fail(task.id, 'err');\n\n    // After retry, get it again\n    expect(task.attempts).toBe(1); // doesn't auto-increment on fail\n  });\n\n  it('Q5.6: Retried tasks keep their original queue and priority', () => {\n    const task = queue.add('myqueue', { x: 1 }, { priority: 3, retries: 1 });\n    queue.getNext('myqueue');\n    queue.fail(task.id, 'err');\n\n    // After retry delay, it should be available in same queue\n    expect(task.queueName).toBe('myqueue');\n    expect(task.priority).toBe(3);\n  });\n\n  it('Q5.7: Exhausted retries → status is \"failed\"', () => {\n    const task = queue.add({}, { retries: 0 });\n    queue.getNext();\n    queue.fail(task.id, 'last error');\n    expect(task.status).toBe('failed');\n    expect(task.error).toBe('last error');\n  });\n});\n\n// ===========================================================================\n// Phase 6: Dead Letter Queue\n// ===========================================================================\ndescribe('Phase 6 - Dead Letter Queue', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q6.1: Task with exhausted retries moves to dead letter queue', () => {\n    const task = queue.add('email', { msg: 'fail' }, { retries: 0 });\n    queue.getNext('email');\n    queue.fail(task.id, 'permanent error');\n\n    const dlq = queue.getDeadLetterTasks('email');\n    expect(dlq).toHaveLength(1);\n    expect(dlq[0].id).toBe(task.id);\n    expect(dlq[0].error).toBe('permanent error');\n  });\n\n  it('Q6.2: getDeadLetterTasks returns all dead-lettered tasks', () => {\n    const t1 = queue.add('q', { a: 1 }, { retries: 0 });\n    const t2 = queue.add('q', { b: 2 }, { retries: 0 });\n    queue.getNext('q');\n    queue.fail(t1.id, 'err1');\n    queue.getNext('q');\n    queue.fail(t2.id, 'err2');\n\n    expect(queue.getDeadLetterTasks('q')).toHaveLength(2);\n  });\n\n  it('Q6.3: Dead-lettered tasks retain error and retry info', () => {\n    const task = queue.add('test', { x: 1 }, { retries: 1, retryDelay: 100 });\n    queue.getNext('test');\n    queue.fail(task.id, 'first fail');\n    // Wait for retry\n    const dlq = queue.getDeadLetterTasks('test');\n    expect(dlq).toHaveLength(0); // still has retries\n\n    // After retry fails again\n    // Using real timers; let's just retry immediately by adjusting availableAt manually\n    // Actually let's use fake timers\n  });\n\n  it('Q6.4: retryDeadLetterTask moves task back to original queue', () => {\n    const task = queue.add('myq', { data: 1 }, { retries: 0 });\n    queue.getNext('myq');\n    queue.fail(task.id, 'fail');\n\n    expect(queue.getDeadLetterTasks('myq')).toHaveLength(1);\n\n    queue.retryDeadLetterTask('myq', task.id);\n    expect(queue.getDeadLetterTasks('myq')).toHaveLength(0);\n    expect(queue.waiting('myq')).toBe(1);\n  });\n\n  it('Q6.5: clearDeadLetterTasks removes all DLQ tasks', () => {\n    const task = queue.add('q', { data: 1 }, { retries: 0 });\n    queue.getNext('q');\n    queue.fail(task.id, 'err');\n\n    expect(queue.getDeadLetterTasks('q')).toHaveLength(1);\n    queue.clearDeadLetterTasks('q');\n    expect(queue.getDeadLetterTasks('q')).toHaveLength(0);\n  });\n\n  it('Q6.6: Each queue has its own independent DLQ', () => {\n    const a = queue.add('qa', { x: 1 }, { retries: 0 });\n    const b = queue.add('qb', { y: 2 }, { retries: 0 });\n    queue.getNext('qa');\n    queue.fail(a.id, 'fail a');\n    queue.getNext('qb');\n    queue.fail(b.id, 'fail b');\n\n    expect(queue.getDeadLetterTasks('qa')).toHaveLength(1);\n    expect(queue.getDeadLetterTasks('qb')).toHaveLength(1);\n    expect(queue.getDeadLetterTasks('qa')[0].payload).toEqual({ x: 1 });\n  });\n});\n\n// ===========================================================================\n// Phase 7: Task Dependencies\n// ===========================================================================\ndescribe('Phase 7 - Task Dependencies', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q7.1: Tasks with dependsOn are blocked until dependencies complete', () => {\n    const dep = queue.add({ setup: true });\n    const dependent = queue.add({ later: true }, { dependsOn: [dep.id] });\n\n    expect(dependent.status).toBe('waiting');\n    expect(queue.getNext()).toBeNull(); // dependent is blocked, no other tasks\n  });\n\n  it('Q7.2: Blocked tasks are not returned by getNext', () => {\n    const a = queue.add({ a: 1 });\n    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n\n    // Only 'a' should be available\n    expect(queue.getNext()!.id).toBe(a.id);\n    expect(queue.getNext()).toBeNull();\n  });\n\n  it('Q7.3: When dependency completes, blocked task becomes available', () => {\n    const a = queue.add({ a: 1 });\n    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n\n    queue.getNext(); // get a\n    queue.complete(a.id);\n\n    // b should now be available\n    expect(queue.getNext()!.id).toBe(b.id);\n  });\n\n  it('Q7.4: Circular dependencies throw', () => {\n    const a = queue.add({ a: 1 });\n    // B depends on A\n    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n    // A should not be able to depend on B\n    expect(() => queue.add({ c: 3 }, { dependsOn: [b.id] })).toThrow();\n  });\n\n  it('Q7.5: Depending on non-existent task throws', () => {\n    expect(() => {\n      queue.add({ bad: true }, { dependsOn: ['non-existent-id'] });\n    }).toThrow();\n  });\n\n  it('Q7.6: A failed dependency does not auto-fail dependents', () => {\n    const a = queue.add({ a: 1 }, { retries: 0 });\n    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n\n    // Use independent complete/fail approach: get a, fail it\n    expect(queue.getNext()!.id).toBe(a.id);\n    queue.fail(a.id, 'boom');\n\n    // b should still be blocked (waiting)\n    expect(queue.getNext()).toBeNull();\n    expect(b.status).toBe('waiting');\n  });\n\n  it('Q7.7: getTask returns task with dependencies and dependents', () => {\n    const dep = queue.add({ dep: true });\n    const task = queue.add({ main: true }, { dependsOn: [dep.id] });\n\n    const fetched = queue.getTask(task.id);\n    expect(fetched).not.toBeNull();\n    expect(fetched!.dependencies).toContain(dep.id);\n    expect(fetched!.dependents).toEqual([]);\n\n    const depFetched = queue.getTask(dep.id);\n    expect(depFetched!.dependents).toContain(task.id);\n  });\n});\n\n// ===========================================================================\n// Phase 8: Concurrency Control\n// ===========================================================================\ndescribe('Phase 8 - Concurrency Control', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q8.1: setConcurrency limits processing tasks', () => {\n    queue.setConcurrency('default', 2);\n    queue.add({ a: 1 });\n    queue.add({ b: 2 });\n    queue.add({ c: 3 });\n\n    expect(queue.getNext()).not.toBeNull();\n    expect(queue.getNext()).not.toBeNull();\n    // Limit reached\n    expect(queue.getNext()).toBeNull();\n  });\n\n  it('Q8.2: Default concurrency is unlimited', () => {\n    queue.add({ a: 1 });\n    queue.add({ b: 2 });\n    queue.add({ c: 3 });\n\n    expect(queue.getNext()).not.toBeNull();\n    expect(queue.getNext()).not.toBeNull();\n    expect(queue.getNext()).not.toBeNull();\n  });\n\n  it('Q8.3: getNext returns null when concurrency reached', () => {\n    queue.setConcurrency('default', 1);\n    queue.add({ a: 1 });\n    queue.add({ b: 2 });\n\n    expect(queue.getNext()).not.toBeNull();\n    expect(queue.getNext()).toBeNull();\n    expect(queue.waiting()).toBe(1); // still has pending\n  });\n\n  it('Q8.4: Completing/failing a task frees a slot', () => {\n    queue.setConcurrency('default', 1);\n    const a = queue.add({ a: 1 });\n    const b = queue.add({ b: 2 });\n\n    const first = queue.getNext()!;\n    expect(first.id).toBe(a.id);\n    expect(queue.getNext()).toBeNull();\n\n    queue.complete(a.id);\n    expect(queue.getNext()!.id).toBe(b.id);\n  });\n\n  it('Q8.5: getConcurrency returns the limit', () => {\n    queue.setConcurrency('test', 5);\n    expect(queue.getConcurrency('test')).toBe(5);\n    expect(queue.getConcurrency('non-existent')).toBeNull();\n  });\n\n  it('Q8.6: getActiveCount returns number of processing tasks', () => {\n    queue.setConcurrency('default', 3);\n    queue.add({ a: 1 });\n    queue.add({ b: 2 });\n\n    expect(queue.getActiveCount('default')).toBe(0);\n    queue.getNext();\n    expect(queue.getActiveCount('default')).toBe(1);\n    queue.getNext();\n    expect(queue.getActiveCount('default')).toBe(2);\n    queue.complete(queue.getTask('')?.id || '');\n  });\n\n  it('Q8.7: Concurrency respects priority ordering', () => {\n    queue.setConcurrency('default', 1);\n    queue.add({ low: true }, { priority: 10 });\n    queue.add({ high: true }, { priority: 1 });\n\n    // Should get the high priority task first\n    expect(queue.getNext()!.payload).toEqual({ high: true });\n  });\n});\n\n// ===========================================================================\n// Phase 9: Progress Tracking and Cancellation\n// ===========================================================================\ndescribe('Phase 9 - Progress Tracking and Cancellation', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q9.1: reportProgress updates a processing task progress', () => {\n    const task = queue.add({});\n    queue.getNext();\n    queue.reportProgress(task.id, 50, 'halfway there');\n\n    expect(task.progress).toBe(50);\n    expect(task.progressMessage).toBe('halfway there');\n  });\n\n  it('Q9.2: getTask returns progress info', () => {\n    const task = queue.add({});\n    queue.getNext();\n    queue.reportProgress(task.id, 75);\n\n    const fetched = queue.getTask(task.id);\n    expect(fetched!.progress).toBe(75);\n    expect(fetched!.progressMessage).toBe('');\n  });\n\n  it('Q9.3: onProgress subscribes to progress updates', () => {\n    const task = queue.add({});\n    queue.getNext();\n\n    const updates: Array<{ pct: number; msg?: string }> = [];\n    queue.onProgress(task.id, (pct, msg) => {\n      updates.push({ pct, msg });\n    });\n\n    queue.reportProgress(task.id, 25, 'quarter');\n    queue.reportProgress(task.id, 50, 'half');\n    queue.reportProgress(task.id, 75);\n\n    expect(updates).toHaveLength(3);\n    expect(updates[0]).toEqual({ pct: 25, msg: 'quarter' });\n    expect(updates[1]).toEqual({ pct: 50, msg: 'half' });\n    expect(updates[2]).toEqual({ pct: 75, msg: undefined });\n  });\n\n  it('Q9.4: Unsubscribing stops progress updates', () => {\n    const task = queue.add({});\n    queue.getNext();\n\n    const updates: number[] = [];\n    const unsubscribe = queue.onProgress(task.id, (pct) => {\n      updates.push(pct);\n    });\n\n    queue.reportProgress(task.id, 25);\n    expect(updates).toHaveLength(1);\n\n    unsubscribe();\n\n    queue.reportProgress(task.id, 50);\n    expect(updates).toHaveLength(1); // no new update\n  });\n\n  it('Q9.5: cancel sets cancelled status', () => {\n    const pending = queue.add({ pending: true });\n    const processing = queue.add({ processing: true });\n\n    queue.getNext(); // gets the processing one (pending was first)\n\n    queue.cancel(pending.id);\n    expect(pending.status).toBe('cancelled');\n\n    queue.cancel(processing.id);\n    expect(processing.status).toBe('cancelled');\n  });\n\n  it('Q9.6: Cancelled pending tasks are removed from queue', () => {\n    const task = queue.add({});\n    queue.cancel(task.id);\n    expect(queue.getNext()).toBeNull();\n    expect(queue.waiting()).toBe(0);\n  });\n\n  it('Q9.7: Cancelled processing tasks have status updated', () => {\n    const task = queue.add({});\n    queue.getNext();\n    expect(task.status).toBe('processing');\n\n    queue.cancel(task.id);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('Q9.8: Cancelled tasks are never retried', () => {\n    const task = queue.add({}, { retries: 3 });\n    queue.getNext();\n\n    queue.cancel(task.id);\n    // Even if we try to fail it, it stays cancelled\n    queue.fail(task.id, 'should not retry');\n    expect(task.status).toBe('cancelled');\n    expect(task.retryCount).toBe(0);\n  });\n});\n\n// ===========================================================================\n// Phase 10: Recurring Tasks\n// ===========================================================================\ndescribe('Phase 10 - Recurring Tasks', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q10.1: addSchedule creates a schedule and returns an ID', () => {\n    const id = queue.addSchedule('*/5 * * * *', 'email', { type: 'reminder' });\n    expect(id).toBeDefined();\n    expect(typeof id).toBe('string');\n  });\n\n  it('Q10.3: listSchedules returns active schedules', () => {\n    queue.addSchedule('*/5 * * * *', 'q', { a: 1 });\n    queue.addSchedule('0 * * * *', 'q', { b: 2 });\n\n    expect(queue.listSchedules()).toHaveLength(2);\n  });\n\n  it('Q10.4: removeSchedule stops a schedule', () => {\n    const id = queue.addSchedule('*/5 * * * *', 'q', {});\n    expect(queue.listSchedules()).toHaveLength(1);\n\n    queue.removeSchedule(id);\n    expect(queue.listSchedules()).toHaveLength(0);\n  });\n\n  it('Q10.5: checkSchedules enqueues tasks for due schedules', () => {\n    const schedId = queue.addSchedule('*/5 * * * *', 'test-queue', { recurring: true });\n\n    queue.checkSchedules();\n    const schedule = queue.listSchedules().find(s => s.id === schedId);\n    expect(schedule!.lastRun).not.toBeNull();\n\n    // A task should have been added to the queue\n    expect(queue.waiting('test-queue')).toBe(1);\n    const task = queue.getNext('test-queue');\n    expect(task!.payload).toEqual({ recurring: true });\n  });\n\n  it('Q10.6: Enqueued tasks are regular tasks', () => {\n    queue.addSchedule('*/5 * * * *', 'q', { recurring: true });\n    queue.checkSchedules();\n\n    const task = queue.getNext('q');\n    expect(task!.id).toBeDefined();\n    expect(task!.status).toBe('processing');\n    expect(task!.payload).toEqual({ recurring: true });\n  });\n\n  it('Q10.7: addSchedule returns unique schedule IDs', () => {\n    const a = queue.addSchedule('*/5 * * * *', 'q1', {});\n    const b = queue.addSchedule('*/5 * * * *', 'q2', {});\n    expect(a).not.toBe(b);\n  });\n\n  it('Q10.8: Removed schedule no longer enqueues tasks', () => {\n    const id = queue.addSchedule('*/5 * * * *', 'q', {});\n    queue.removeSchedule(id);\n\n    queue.checkSchedules();\n    expect(queue.waiting('q')).toBe(0);\n  });\n\n  it('Supports 0 * * * * (hourly) cron', () => {\n    expect(() => queue.addSchedule('0 * * * *', 'q', {})).not.toThrow();\n  });\n\n  it('Supports 0 0 * * * (daily) cron', () => {\n    expect(() => queue.addSchedule('0 0 * * *', 'q', {})).not.toThrow();\n  });\n\n  it('Rejects unsupported cron expressions', () => {\n    expect(() => queue.addSchedule('* * * * *', 'q', {})).toThrow();\n    expect(() => queue.addSchedule('0 0 1 * *', 'q', {})).toThrow();\n  });\n});\n\n// ===========================================================================\n// Phase 11: Middleware Pipeline\n// ===========================================================================\ndescribe('Phase 11 - Middleware Pipeline', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q11.1: use registers middleware on a queue', () => {\n    expect(() => {\n      queue.use('test', async (_task, next) => { await next(); });\n    }).not.toThrow();\n  });\n\n  it('Q11.3: Middleware runs in order then handler', async () => {\n    const order: string[] = [];\n\n    queue.use('test', async (_task, next) => {\n      order.push('mw1-before');\n      await next();\n      order.push('mw1-after');\n    });\n    queue.use('test', async (_task, next) => {\n      order.push('mw2-before');\n      await next();\n      order.push('mw2-after');\n    });\n    queue.process('test', async (_task) => {\n      order.push('handler');\n    });\n\n    queue.add('test', {});\n    const task = queue.getNext('test')!;\n    await queue.runTask(task.id);\n\n    expect(order).toEqual(['mw1-before', 'mw2-before', 'handler', 'mw2-after', 'mw1-after']);\n  });\n\n  it('Q11.5: If middleware does not call next, handler is skipped', async () => {\n    const order: string[] = [];\n\n    queue.use('test', async (_task, _next) => {\n      order.push('mw1');\n      // deliberately not calling next\n    });\n    queue.process('test', async (_task) => {\n      order.push('handler');\n    });\n\n    queue.add('test', {});\n    const task = queue.getNext('test')!;\n    await queue.runTask(task.id);\n    expect(order).toEqual(['mw1']);\n  });\n\n  it('Q11.6: Middleware can modify the task payload', async () => {\n    queue.use('test', async (task, next) => {\n      (task.payload as Record<string, unknown>).modified = true;\n      await next();\n    });\n    queue.process('test', async (task) => {\n      expect((task.payload as Record<string, unknown>).modified).toBe(true);\n    });\n\n    queue.add('test', { original: true });\n    const task = queue.getNext('test')!;\n    await queue.runTask(task.id);\n    expect(queue.getTask(task.id)!.status).toBe('completed');\n  });\n\n  it('Q11.7: Middleware that throws marks task as failed', async () => {\n    queue.use('test', async (_task, _next) => {\n      throw new Error('middleware failure');\n    });\n    queue.process('test', async (_task) => {\n      // should not reach here\n    });\n\n    queue.add('test', {});\n    const task = queue.getNext('test')!;\n    await queue.runTask(task.id);\n    expect(task.status).toBe('failed');\n  });\n\n  it('Q11.8: Each queue has its own middleware stack', async () => {\n    const order: string[] = [];\n\n    queue.use('q1', async (_task, next) => {\n      order.push('q1-mw');\n      await next();\n    });\n    queue.use('q2', async (_task, next) => {\n      order.push('q2-mw');\n      await next();\n    });\n    queue.process('q1', async (_task) => {\n      order.push('q1-handler');\n    });\n    queue.process('q2', async (_task) => {\n      order.push('q2-handler');\n    });\n\n    queue.add('q1', {});\n    queue.add('q2', {});\n\n    await queue.runTask(queue.getNext('q1')!.id);\n    await queue.runTask(queue.getNext('q2')!.id);\n\n    expect(order).toEqual(['q1-mw', 'q1-handler', 'q2-mw', 'q2-handler']);\n  });\n});\n\n// ===========================================================================\n// Phase 12: Graceful Shutdown\n// ===========================================================================\ndescribe('Phase 12 - Graceful Shutdown', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q12.2: After shutdown, add() throws', async () => {\n    await queue.shutdown();\n    expect(() => queue.add({})).toThrow();\n  });\n\n  it('Q12.3: Shutdown waits for processing tasks', async () => {\n    queue.add({});\n    queue.getNext(); // now processing\n\n    // Complete the task after a short delay\n    setTimeout(() => {\n      queue.complete(queue.listQueues().length > 0 ? '' : ''); // find task\n    }, 50);\n    // This is inherently racy — let's do it differently\n    // Actually let's not rely on timers being precise\n  });\n\n  it('Q12.5: onShutdown callbacks run during shutdown', async () => {\n    const calls: string[] = [];\n    queue.onShutdown(() => { calls.push('cb1'); });\n    queue.onShutdown(() => { calls.push('cb2'); });\n\n    await queue.shutdown();\n    expect(calls).toEqual(['cb1', 'cb2']);\n  });\n\n  it('Q12.6: shutdown returns ShutdownResult', async () => {\n    const result = await queue.shutdown();\n    expect(result).toHaveProperty('completed');\n    expect(result).toHaveProperty('cancelled');\n    expect(result).toHaveProperty('duration');\n    expect(typeof result.completed).toBe('number');\n    expect(typeof result.cancelled).toBe('number');\n    expect(typeof result.duration).toBe('number');\n  });\n\n  it('Q12.7: Multiple shutdown calls return the same result', async () => {\n    const first = await queue.shutdown();\n    const second = await queue.shutdown();\n    expect(first).toBe(second);\n  });\n\n  it('Q12.8: Shutdown with no processing tasks completes immediately', async () => {\n    const start = Date.now();\n    await queue.shutdown();\n    const elapsed = Date.now() - start;\n    expect(elapsed).toBeLessThan(500); // should be near-instant\n  });\n\n  it('Q12.4: Processing tasks exceeding timeout are force-cancelled', async () => {\n    const slow = queue.add({});\n    queue.getNext(); // now processing - never completes\n\n    const result = await queue.shutdown({ timeout: 100 });\n    // The task should have been cancelled\n    expect(slow.status).toBe('cancelled');\n    expect(result.cancelled).toBeGreaterThanOrEqual(0); // at least the slow one\n  });\n});\n\n// ===========================================================================\n// Integration: Cross-phase interaction tests\n// ===========================================================================\ndescribe('Integration - Cross-Phase Interactions', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Priority + Named queues + Delays work together', async () => {\n    queue.add('high-delay', { x: 1 }, { priority: 1, delay: 100 });\n    queue.add('low-instant', { y: 2 }, { priority: 10 });\n\n    // Instant task should come first\n    expect(queue.getNext('low-instant')!.payload).toEqual({ y: 2 });\n    expect(queue.getNext('high-delay')).toBeNull();\n\n    await new Promise(resolve => setTimeout(resolve, 150));\n    expect(queue.getNext('high-delay')!.payload).toEqual({ x: 1 });\n  });\n\n  it('Priority + Concurrency: highest priority within limit', () => {\n    queue.setConcurrency('default', 1);\n    queue.add({ low: true }, { priority: 10 });\n    queue.add({ high: true }, { priority: 1 });\n    queue.add({ mid: true }, { priority: 5 });\n\n    expect(queue.getNext()!.payload).toEqual({ high: true });\n  });\n\n  it('Complete + Dependency chain works linearly', () => {\n    const a = queue.add({ a: 1 });\n    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n    const c = queue.add({ c: 3 }, { dependsOn: [b.id] });\n\n    // Only a is available\n    expect(queue.getNext()!.id).toBe(a.id);\n    queue.complete(a.id);\n\n    // Now b is available\n    expect(queue.getNext()!.id).toBe(b.id);\n    queue.complete(b.id);\n\n    // Now c is available\n    expect(queue.getNext()!.id).toBe(c.id);\n  });\n\n  it('Retry + DLQ + Retry from DLQ', () => {\n    // Task that fails once, gets retried, fails again, goes to DLQ, then retried from DLQ\n    const task = queue.add('q', { data: 1 }, { retries: 1, retryDelay: 10 });\n\n    // First attempt — fail\n    queue.getNext('q');\n    queue.fail(task.id, 'first fail');\n    expect(task.status).toBe('pending');\n    expect(task.retryCount).toBe(1);\n\n    // Second attempt — fail (no more retries)\n    // Task should be available now with minimal backoff\n    // We need to handle the timing — the retry delay is 10*2^0=10ms\n    // After 10ms it's available\n  });\n\n  it('Cancel prevents retry', () => {\n    const task = queue.add({}, { retries: 3 });\n    queue.getNext();\n    queue.cancel(task.id);\n    queue.fail(task.id, 'should not retry');\n    expect(task.status).toBe('cancelled');\n    expect(task.retryCount).toBe(0);\n  });\n\n  it('Middleware + Completion status', async () => {\n    let mwRan = false;\n    queue.use('test', async (t, next) => {\n      mwRan = true;\n      await next();\n    });\n    queue.process('test', async (_t) => {\n      // does work\n    });\n\n    queue.add('test', {});\n    const task = queue.getNext('test')!;\n    await queue.runTask(task.id);\n    expect(mwRan).toBe(true);\n    expect(queue.getTask(task.id)!.status).toBe('completed');\n  });\n});\n","numLines":1095,"startLine":1,"totalLines":1095}}}
