ueues.set(name, q);\n    }\n    return q;\n  }\n\n  private getQueue(name: string): QueueState | undefined {\n    return this.queues.get(name);\n  }\n\n  private nextId(): string {\n    return crypto.randomUUID();\n  }\n\n  /** Insert a pending task ID into the sorted list.\n   *  Sort key: (availableAt ?? min-date) ASC, priority ASC, createdAt ASC.\n   *  This way non-delayed tasks (availableAt=null) come first within same priority,\n   *  and among delayed tasks, earlier-available comes first.\n   */\n  private insertPending(q: QueueState, taskId: string): void {\n    const task = q.tasks.get(taskId)!;\n    const key = (t: Task) =>\n      `${String(t.availableAt ? t.availableAt.getTime() : 0).padStart(20, '0')}_${String(t.priority).padStart(2, '0')}_${String(t.createdAt.getTime()).padStart(20, '0')}`;\n    const taskKey = key(task);\n    let lo = 0;\n    let hi = q.pendingOrder.length;\n    while (lo < hi) {\n      const mid = (lo + hi) >>> 1;\n      const midKey = key(q.tasks.get(q.pendingOrder[mid])!);\n      if (midKey < taskKey) lo = mid + 1;\n      else hi = mid;\n    }\n    q.pendingOrder.splice(lo, 0, taskId);\n  }\n\n  /** Remove a pending task ID from the ordered list (stable). */\n  private removePending(q: QueueState, taskId: string): void {\n    const idx = q.pendingOrder.indexOf(taskId);\n    if (idx !== -1) q.pendingOrder.splice(idx, 1);\n  }\n\n  /** Find the first eligible task from pendingOrder. */\n  private findNextEligible(q: QueueState): Task | null {\n    if (q.pendingOrder.length === 0) return null;\n\n    // Concurrency check\n    const limit = q.concurrency;\n    if (limit !== null && q.processing.size >= limit) return null;\n\n    const now = Date.now();\n    for (const id of q.pendingOrder) {\n      const task = q.tasks.get(id)!;\n      // Skip if waiting on dependencies\n      if (task.dependencies.length > 0) continue;\n      // Skip if not yet available\n      if (task.availableAt && task.availableAt.getTime() > now) continue;\n      // Found an eligible task\n      return task;\n    }\n    return null;\n  }\n\n  /** Check blocked tasks whose dependencies may have just resolved. */\n  private unblockDependents(q: QueueState, completedTaskId: string): void {\n    // No need to scan — when a task completes, we just let findNextEligible\n    // skip past tasks with unresolved deps. The unblocking is passive.\n    // However we need to update the dependency lists.\n    for (const [, task] of q.tasks) {\n      const idx = task.dependencies.indexOf(completedTaskId);\n      if (idx !== -1) {\n        task.dependencies.splice(idx, 1);\n      }\n    }\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 1-2: Basic queue + Named queues\n  // -----------------------------------------------------------------------\n\n  /**\n   * Add a task to a queue.\n   *\n   * Signatures:\n   *   add(payload)\n   *   add(payload, options)\n   *   add(queueName, payload, options?)\n   */\n  add<T = unknown>(queueNameOrPayload: string | T, payloadOrOptions?: T | TaskOptions, maybeOptions?: TaskOptions): Task<T> {\n    if (this._shuttingDown) {\n      throw new Error('Cannot add tasks: system is shutting down');\n    }\n\n    let queueName: string;\n    let payload: T;\n    let options: TaskOptions | undefined;\n\n    if (typeof queueNameOrPayload === 'string' && arguments.length >= 2) {\n      // add('name', payload, options?)\n      queueName = queueNameOrPayload;\n      payload = payloadOrOptions as T;\n      options = maybeOptions;\n    } else {\n      // add(payload, options?)\n      queueName = 'default';\n      payload = queueNameOrPayload as T;\n      options = payloadOrOptions as TaskOptions | undefined;\n    }\n\n    // Validate priority\n    const priority = options?.priority ?? 5;\n    if (priority < 1 || priority > 10 || !Number.isInteger(priority)) {\n      throw new Error(`Priority must be an integer between 1 and 10, got ${priority}`);\n    }\n\n    // Validate dependencies\n    const dependsOn = options?.dependsOn ?? [];\n    if (dependsOn.length > 0) {\n      // Check every dependency exists\n      for (const depId of dependsOn) {\n        let found = false;\n        for (const [, q] of this.queues) {\n          if (q.tasks.has(depId)) { found = true; break; }\n        }\n        if (!found) {\n          throw new Error(`Cannot depend on non-existent task: ${depId}`);\n        }\n      }\n      // Check for circular dependencies\n      this.detectCycle(dependsOn, queueName);\n    }\n\n    const now = new Date();\n    let availableAt: Date | null = null;\n    if (options?.delay && options.delay > 0) {\n      availableAt = new Date(now.getTime() + options.delay);\n    }\n    if (options?.runAt) {\n      availableAt = options.runAt;\n    }\n\n    const q = this.getOrCreateQueue(queueName);\n\n    const task: Task<T> = {\n      id: this.nextId(),\n      payload,\n      status: dependsOn.length > 0 ? 'waiting' as TaskStatus : 'pending' as TaskStatus,\n      createdAt: now,\n      priority,\n      availableAt,\n      retriesMax: options?.retries ?? 3,\n      retryCount: 0,\n      retryBackoff: options?.retryDelay ?? 1000,\n      error: null,\n      dependencies: [...dependsOn],\n      dependents: [],\n      progress: 0,\n      progressMessage: '',\n      queueName,\n      attempts: 0,\n    };\n\n    q.tasks.set(task.id, task);\n\n    // Register this task as a dependent on its dependencies\n    for (const depId of dependsOn) {\n      for (const [, otherQ] of this.queues) {\n        const depTask = otherQ.tasks.get(depId);\n        if (depTask) {\n          depTask.dependents.push(task.id);\n          break;\n        }\n      }\n    }\n\n    // If not waiting on deps, add to pending order\n    if (task.status === 'pending') {\n      this.insertPending(q, task.id);\n    }\n\n    return task;\n  }\n\n  /**\n   * Get the next available task from a queue.\n   * Returns null if none available.\n   */\n  getNext<T = unknown>(queueName?: string): Task<T> | null {\n    const name = queueName ?? 'default';\n    const q = this.getQueue(name);\n    if (!q) return null;\n\n    const task = this.findNextEligible(q);\n    if (!task) return null;\n\n    // Remove from pending and mark as processing\n    this.removePending(q, task.id);\n    q.processing.add(task.id);\n    task.status = 'processing';\n    task.attempts++;\n    return task as Task<T>;\n  }\n\n  /**\n   * Number of tasks waiting (pending) in a queue.\n   */\n  waiting(queueName?: string): number {\n    const name = queueName ?? 'default';\n    const q = this.getQueue(name);\n    if (!q) return 0;\n\n    const now = Date.now();\n    let count = 0;\n    for (const id of q.pendingOrder) {\n      const task = q.tasks.get(id)!;\n      if (task.dependencies.length > 0) continue;\n      if (task.availableAt && task.availableAt.getTime() > now) continue;\n      count++;\n    }\n    return count;\n  }\n\n  /**\n   * List all queue names.\n   */\n  listQueues(): string[] {\n    return Array.from(this.queues.keys());\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 5: Retry with backoff\n  // -----------------------------------------------------------------------\n\n  /**\n   * Mark a processing task as completed.\n   */\n  complete(taskId: string): void {\n    for (const [, q] of this.queues) {\n      const task = q.tasks.get(taskId);\n      if (!task || task.status !== 'processing') continue;\n\n      task.status = 'completed';\n      task.progress = 100;\n      q.processing.delete(taskId);\n\n      // Unblock dependents\n      this.unblockDependents(q, taskId);\n\n      // Check all queues for now-unblocked tasks\n      this.checkDependencyResolution(taskId);\n\n      return;\n    }\n  }\n\n  /**\n   * Mark a processing task as failed. If retries remain, re-queue with backoff.\n   */\n  fail(taskId: string, error?: Error | string): void {\n    for (const [, q] of this.queues) {\n      const task = q.tasks.get(taskId);\n      if (!task || (task.status !== 'processing' && task.status !== 'pending')) continue;\n      if (task.status === 'cancelled') return; // cancelled tasks are never retried\n\n      const errMsg = error instanceof Error ? error.message : (error ?? 'Unknown error');\n      task.error = errMsg;\n      task.retryCount++;\n      q.processing.delete(taskId);\n\n      // If cancelled, don't retry\n      if (task.status === 'cancelled') return;\n\n      if (task.retryCount <= task.retriesMax) {\n        // Re-queue with backoff\n        const backoff = task.retryBackoff * Math.pow(2, task.retryCount - 1);\n        task.availableAt = new Date(Date.now() + backoff);\n        task.status = 'pending';\n        this.insertPending(q, task.id);\n        // Check if any dependents should be unblocked (they remain blocked for failed deps per spec)\n      } else {\n        // No retries left → move to dead letter\n        task.status = 'failed';\n        q.deadLetter.push({ ...task });\n      }\n      return;\n    }\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 6: Dead letter queue\n  // -----------------------------------------------------------------------\n\n  getDeadLetterTasks(queueName?: string): Task[] {\n    const name = queueName ?? 'default';\n    const q = this.getQueue(name);\n    if (!q) return [];\n    return [...q.deadLetter];\n  }\n\n  retryDeadLetterTask(queueName: string, taskId: string): void {\n    const q = this.getQueue(queueName);\n    if (!q) throw new Error(`Queue \"${queueName}\" does not exist`);\n\n    const idx = q.deadLetter.findIndex(t => t.id === taskId);\n    if (idx === -1) throw new Error(`Task \"${taskId}\" not found in dead letter queue for \"${queueName}\"`);\n\n    const deadTask = q.deadLetter[idx];\n    q.deadLetter.splice(idx, 1);\n\n    // Re-create as a fresh task\n    const newTask: Task = {\n      ...deadTask,\n      status: 'pending',\n      retryCount: 0,\n      attempts: 0,\n      error: null,\n      availableAt: null,\n      createdAt: new Date(),\n    };\n    q.tasks.set(newTask.id, newTask);\n    this.insertPending(q, newTask.id);\n  }\n\n  clearDeadLetterTasks(queueName: string): void {\n    const q = this.getQueue(queueName);\n    if (!q) return;\n    q.deadLetter = [];\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 7: Dependency detection (cycle checking)\n  // -----------------------------------------------------------------------\n\n  private detectCycle(dependsOn: string[], _queueName: string): void {\n    // Build a reverse map: which tasks are we checking deps for?\n    // Actually we need to check if adding these deps would create a cycle.\n    // Walk the dependency graph from each depId — if any path leads back to\n    // a newer task that depends on any of these depIds, it's a cycle.\n    // This is called before the new task is added, so we check if there's\n    // already a chain from any dependency to any of our depIds.\n    //\n    // Simpler approach: collect all possible paths and check for cycles.\n    const visited = new Set<string>();\n    const stack = [...dependsOn];\n\n    while (stack.length > 0) {\n      const currentId = stack.pop()!;\n      if (visited.has(currentId)) continue;\n      visited.add(currentId);\n\n      // Find the task\n      for (const [, q] of this.queues) {\n        const t = q.tasks.get(currentId);\n        if (t) {\n          // Check if any of our direct dependsOn appears in THIS task's dependents\n          // or if any of our dependsOn depends on our new task transitively\n          for (const dep of t.dependencies) {\n            if (dependsOn.includes(dep)) {\n              throw new Error('Circular dependency detected');\n            }\n            stack.push(dep);\n          }\n          break;\n        }\n      }\n    }\n  }\n\n  private checkDependencyResolution(_completedTaskId: string): void {\n    // After a task completes, check if any waiting tasks in any queue\n    // now have all their dependencies resolved\n    for (const [, q] of this.queues) {\n      for (const [, task] of q.tasks) {\n        if (task.status === 'waiting' && task.dependencies.length === 0) {\n          task.status = 'pending';\n          this.insertPending(q, task.id);\n        }\n      }\n    }\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 8: Concurrency\n  // -----------------------------------------------------------------------\n\n  setConcurrency(queueName: string, limit: number | null): void {\n    if (limit !== null && (limit < 1 || !Number.isInteger(limit))) {\n      throw new Error('Concurrency limit must be a positive integer or null');\n    }\n    const q = this.getOrCreateQueue(queueName);\n    q.concurrency = limit;\n  }\n\n  getConcurrency(queueName: string): number | null {\n    const q = this.getQueue(queueName);\n    if (!q) return null;\n    return q.concurrency;\n  }\n\n  getActiveCount(queueName: string): number {\n    const q = this.getQueue(queueName);\n    if (!q) return 0;\n    return q.processing.size;\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 9: Progress tracking & cancellation\n  // -----------------------------------------------------------------------\n\n  reportProgress(taskId: string, percentage: number, message?: string): void {\n    if (percentage < 0 || percentage > 100 || !Number.isInteger(percentage)) {\n      throw new Error('Progress percentage must be an integer between 0 and 100');\n    }\n\n    for (const [, q] of this.queues) {\n      const task = q.tasks.get(taskId);\n      if (!task || task.status !== 'processing') continue;\n\n      task.progress = percentage;\n      task.progressMessage = message ?? '';\n\n      // Notify subscribers\n      const subs = this.progressSubs.get(taskId);\n      if (subs) {\n        for (const cb of subs) {\n          try { cb(percentage, message); } catch { /* swallow */ }\n        }\n      }\n      return;\n    }\n  }\n\n  onProgress(taskId: string, callback: ProgressCallback): () => void {\n    if (!this.progressSubs.has(taskId)) {\n      this.progressSubs.set(taskId, new Set());\n    }\n    this.progressSubs.get(taskId)!.add(callback);\n\n    return () => {\n      const subs = this.progressSubs.get(taskId);\n      if (subs) {\n        subs.delete(callback);\n        if (subs.size === 0) this.progressSubs.delete(taskId);\n      }\n    };\n  }\n\n  cancel(taskId: string): void {\n    for (const [, q] of this.queues) {\n      const task = q.tasks.get(taskId);\n      if (!task) continue;\n      if (task.status === 'pending') {\n        this.removePending(q, taskId);\n        task.status = 'cancelled';\n        return;\n      }\n      if (task.status === 'processing') {\n        task.status = 'cancelled';\n        q.processing.delete(taskId);\n        return;\n      }\n      if (task.status === 'waiting') {\n        task.status = 'cancelled';\n        return;\n      }\n      // Already completed/failed — no-op\n      return;\n    }\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 10: Recurring tasks\n  // -----------------------------------------------------------------------\n\n  addSchedule(cron: string, queueName: string, payload: unknown): string {\n    // Validate cron expression by parsing it\n    parseCron(cron);\n\n    // Ensure queue exists\n    this.getOrCreateQueue(queueName);\n\n    const id = this.nextId();\n    const schedule: Schedule = {\n      id,\n      cron,\n      queueName,\n      payload,\n      createdAt: new Date(),\n      lastRun: null,\n    };\n    this.schedules.set(id, schedule);\n    return id;\n  }\n\n  removeSchedule(id: string): void {\n    this.schedules.delete(id);\n  }\n\n  listSchedules(): Schedule[] {\n    return Array.from(this.schedules.values());\n  }\n\n  /**\n   * Evaluate all schedules and enqueue tasks for any that are due.\n   * This is the manual \"tick\" for testing.\n   */\n  checkSchedules(): void {\n    const now = new Date();\n\n    for (const [, sched] of this.schedules) {\n      const parsed = parseCron(sched.cron);\n      const lastRun = sched.lastRun;\n\n      // Determine if this schedule is due\n      let due = false;\n\n      if (parsed.kind === 'every-n-minutes') {\n        if (lastRun === null) {\n          // First run — schedule was created, so it's due if enough time has passed\n          // For the initial check, we consider it due immediately.\n          due = true;\n        } else {\n          const elapsed = now.getTime() - lastRun.getTime();\n          if (elapsed >= parsed.interval * 60_000) {\n            due = true;\n          }\n        }\n      }\n\n      if (due) {\n        // Determine how many intervals have elapsed (for catching up)\n        let intervalsElapsed = 1;\n        if (lastRun !== null && parsed.kind === 'every-n-minutes') {\n          const elapsed = now.getTime() - lastRun.getTime();\n          intervalsElapsed = Math.floor(elapsed / (parsed.interval * 60_000));\n          if (intervalsElapsed < 1) intervalsElapsed = 1;\n        }\n\n        // Enqueue tasks (only the latest one, not catching up all missed — simpler)\n        this.add(sched.queueName, sched.payload);\n        sched.lastRun = new Date(now.getTime());\n      }\n    }\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 11: Middleware\n  // -----------------------------------------------------------------------\n\n  use(queueName: string, middlewareFn: MiddlewareFn): void {\n    const q = this.getOrCreateQueue(queueName);\n    q.middleware.push(middlewareFn);\n  }\n\n  process(queueName: string, handler: ProcessHandler): void {\n    const q = this.getOrCreateQueue(queueName);\n    q.handler = handler;\n  }\n\n  /**\n   * Run a task through the middleware pipeline and handler.\n   * Call this after getNext()