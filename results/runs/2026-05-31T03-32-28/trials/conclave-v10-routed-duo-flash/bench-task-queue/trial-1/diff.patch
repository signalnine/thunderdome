ved!.status).toBe('processing');\n    expect(task.status).toBe('processing');\n  });\n\n  it('Q1.6: getNext() returns null when queue is empty', () => {\n    expect(queue.getNext()).toBeNull();\n    queue.add({});\n    queue.getNext();\n    expect(queue.getNext()).toBeNull();\n  });\n\n  it('Q1.7: waiting() returns count of pending tasks', () => {\n    expect(queue.waiting()).toBe(0);\n    queue.add({ a: 1 });\n    expect(queue.waiting()).toBe(1);\n    queue.add({ b: 2 });\n    expect(queue.waiting()).toBe(2);\n    queue.getNext();\n    expect(queue.waiting()).toBe(1);\n  });\n\n  it('Q1.8: Tasks are returned in FIFO order', () => {\n    const a = queue.add({ order: 1 });\n    const b = queue.add({ order: 2 });\n    const c = queue.add({ order: 3 });\n\n    expect(queue.getNext()!.id).toBe(a.id);\n    expect(queue.getNext()!.id).toBe(b.id);\n    expect(queue.getNext()!.id).toBe(c.id);\n    expect(queue.getNext()).toBeNull();\n  });\n});\n\n// ===========================================================================\n// Phase 2: Named Queues\n// ===========================================================================\ndescribe('Phase 2 - Named Queues', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q2.1: add(payload) without queue name uses the default queue', () => {\n    const task = queue.add({ x: 1 });\n    expect(task.queueName).toBe('default');\n    expect(queue.getNext()!.id).toBe(task.id);\n  });\n\n  it('Q2.2: add(\"name\", payload) adds to the named queue', () => {\n    const task = queue.add('email', { to: 'user@test.com' });\n    expect(task.queueName).toBe('email');\n  });\n\n  it('Q2.3: Named queues operate independently', () => {\n    queue.add('a', { msg: 'from a' });\n    queue.add('b', { msg: 'from b' });\n\n    expect(queue.getNext('a')!.payload).toEqual({ msg: 'from a' });\n    expect(queue.getNext('b')!.payload).toEqual({ msg: 'from b' });\n  });\n\n  it('Q2.4: Queues are created implicitly when first task is added', () => {\n    expect(queue.listQueues()).not.toContain('auto-created');\n    queue.add('auto-created', {});\n    expect(queue.listQueues()).toContain('auto-created');\n  });\n\n  it('Q2.5: listQueues() returns all queue names', () => {\n    queue.add('alpha', {});\n    queue.add('beta', {});\n    queue.add({}); // adds to default\n    const names = queue.listQueues();\n    expect(names).toContain('alpha');\n    expect(names).toContain('beta');\n    expect(names).toContain('default');\n  });\n\n  it('Q2.6: getNext() from non-existent or empty queue returns null', () => {\n    expect(queue.getNext('no-such-queue')).toBeNull();\n    queue.add('empty-now', {});\n    queue.getNext('empty-now');\n    expect(queue.getNext('empty-now')).toBeNull();\n  });\n\n  it('Q2.7: Phase 1 syntax still works (backward compatible)', () => {\n    const task = queue.add({ compat: true });\n    expect(task.id).toBeDefined();\n    const retrieved = queue.getNext();\n    expect(retrieved!.id).toBe(task.id);\n    expect(queue.waiting()).toBe(0);\n  });\n});\n\n// ===========================================================================\n// Phase 3: Priority\n// ===========================================================================\ndescribe('Phase 3 - Priority', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q3.1: Default priority is 5', () => {\n    const task = queue.add({});\n    expect(task.priority).toBe(5);\n  });\n\n  it('Q3.2: Priority range is 1-10', () => {\n    const low = queue.add({}, { priority: 10 });\n    expect(low.priority).toBe(10);\n    const high = queue.add({}, { priority: 1 });\n    expect(high.priority).toBe(1);\n  });\n\n  it('Q3.3: Higher-priority (lower number) tasks are returned first', () => {\n    queue.add({ id: 'normal' }, { priority: 5 });\n    queue.add({ id: 'urgent' }, { priority: 1 });\n    queue.add({ id: 'low' }, { priority: 10 });\n\n    expect(queue.getNext()!.payload).toEqual({ id: 'urgent' });\n    expect(queue.getNext()!.payload).toEqual({ id: 'normal' });\n    expect(queue.getNext()!.payload).toEqual({ id: 'low' });\n  });\n\n  it('Q3.4: Same-priority tasks are FIFO', () => {\n    const a = queue.add({ order: 1 }, { priority: 5 });\n    const b = queue.add({ order: 2 }, { priority: 5 });\n    const c = queue.add({ order: 3 }, { priority: 5 });\n\n    expect(queue.getNext()!.id).toBe(a.id);\n    expect(queue.getNext()!.id).toBe(b.id);\n    expect(queue.getNext()!.id).toBe(c.id);\n  });\n\n  it('Q3.5: Invalid priority values throw', () => {\n    expect(() => queue.add({}, { priority: 0 })).toThrow();\n    expect(() => queue.add({}, { priority: 11 })).toThrow();\n    expect(() => queue.add({}, { priority: 1.5 })).toThrow();\n    expect(() => queue.add({}, { priority: 1 })).not.toThrow();\n    expect(() => queue.add({}, { priority: 10 })).not.toThrow();\n  });\n\n  it('Q3.6: Priority operates per-queue', () => {\n    queue.add('q1', { id: 'urgent' }, { priority: 1 });\n    queue.add('q2', { id: 'normal' }, { priority: 5 });\n\n    expect(queue.getNext('q1')!.payload).toEqual({ id: 'urgent' });\n    expect(queue.getNext('q2')!.payload).toEqual({ id: 'normal' });\n  });\n\n  it('Q3.7: Task object exposes priority', () => {\n    const task = queue.add({}, { priority: 3 });\n    expect(task.priority).toBe(3);\n  });\n});\n\n// ===========================================================================\n// Phase 4: Delayed Tasks\n// ===========================================================================\ndescribe('Phase 4 - Delayed Tasks', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q4.1: add with delay creates a task that is not available until after the delay', async () => {\n    queue.add({ normal: true });\n    queue.add({ delayed: true }, { delay: 100 });\n\n    expect(queue.getNext()!.payload).toEqual({ normal: true });\n    expect(queue.getNext()).toBeNull();\n\n    await new Promise(resolve => setTimeout(resolve, 150));\n    expect(queue.getNext()!.payload).toEqual({ delayed: true });\n  });\n\n  it('Q4.2: add with runAt creates a task that becomes available at that date', async () => {\n    const future = new Date(Date.now() + 100);\n    queue.add({ scheduled: true }, { runAt: future });\n\n    expect(queue.getNext()).toBeNull();\n\n    await new Promise(resolve => setTimeout(resolve, 150));\n    expect(queue.getNext()!.payload).toEqual({ scheduled: true });\n  });\n\n  it('Q4.3: Delayed tasks appear in waiting() count even when not yet available', () => {\n    queue.add({ immediate: true });\n    queue.add({ delayed: true }, { delay: 5000 });\n\n    expect(queue.waiting()).toBe(2);\n  });\n\n  it('Q4.4: Non-delayed tasks preferred over unavailable delayed tasks regardless of priority', () => {\n    queue.add({ important: true }, { priority: 1, delay: 1000 });\n    queue.add({ normal: true }, { priority: 10 });\n\n    expect(queue.getNext()!.payload).toEqual({ normal: true });\n  });\n\n  it('Q4.5: Delayed tasks available simultaneously ordered by priority then FIFO', async () => {\n    const future = new Date(Date.now() + 50);\n\n    queue.add({ low: true }, { priority: 10, runAt: future });\n    queue.add({ high: true }, { priority: 1, runAt: future });\n    queue.add({ mid: true }, { priority: 5, runAt: future });\n\n    await new Promise(resolve => setTimeout(resolve, 100));\n\n    expect(queue.getNext()!.payload).toEqual({ high: true });\n    expect(queue.getNext()!.payload).toEqual({ mid: true });\n    expect(queue.getNext()!.payload).toEqual({ low: true });\n  });\n\n  it('Q4.6: Task object has availableAt field', () => {\n    const task = queue.add({}, { delay: 5000 });\n    expect(task).toHaveProperty('availableAt');\n    expect(task.availableAt).toBeInstanceOf(Date);\n    expect(task.availableAt!.getTime()).toBeGreaterThan(Date.now() - 1000);\n\n    const immediateTask = queue.add({});\n    expect(immediateTask.availableAt).toBeNull();\n  });\n\n  it('Q4.7: Delays work correctly with named queues', async () => {\n    queue.add('fast', { msg: 'instant' });\n    queue.add('slow', { msg: 'delayed' }, { delay: 100 });\n\n    expect(queue.getNext('fast')!.payload).toEqual({ msg: 'instant' });\n    expect(queue.getNext('slow')).toBeNull();\n\n    await new Promise(resolve => setTimeout(resolve, 150));\n    expect(queue.getNext('slow')!.payload).toEqual({ msg: 'delayed' });\n  });\n});\n\n// ===========================================================================\n// Phase 5: Retry with Backoff\n// ===========================================================================\ndescribe('Phase 5 - Retry with Backoff', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q5.1: complete() marks a processing task as completed', () => {\n    const task = queue.add({});\n    queue.getNext();\n    queue.complete(task.id);\n    expect(task.status).toBe('completed');\n  });\n\n  it('Q5.2: fail() re-queues if retries remain, marks failed otherwise', () => {\n    vi.useFakeTimers();\n    const task = queue.add({}, { retries: 1 });\n    queue.getNext();\n    queue.fail(task.id, new Error('oops'));\n\n    expect(task.retryCount).toBe(1);\n    expect(task.status).toBe('pending');\n\n    // Advance past backoff (baseDelay * 2^0 = 1000ms)\n    vi.advanceTimersByTime(2000);\n\n    queue.getNext();\n    queue.fail(task.id, new Error('oops again'));\n    expect(task.status).toBe('failed');\n    vi.useRealTimers();\n  });\n\n  it('Q5.3: Default max retries is 3, configurable per task', () => {\n    const defaultTask = queue.add({});\n    expect(defaultTask.retriesMax).toBe(3);\n\n    const customTask = queue.add({}, { retries: 0 });\n    expect(customTask.retriesMax).toBe(0);\n  });\n\n  it('Q5.4: Backoff is baseDelay * 2^(attempt-1)', () => {\n    vi.useFakeTimers();\n    const task = queue.add({}, { retries: 3, retryDelay: 1000 });\n    queue.getNext();\n\n    queue.fail(task.id, 'err');\n    const afterFirst = task.availableAt!.getTime() - Date.now();\n    expect(afterFirst).toBeGreaterThanOrEqual(990);\n    expect(afterFirst).toBeLessThanOrEqual(1010);\n\n    vi.advanceTimersByTime(2000);\n    queue.getNext();\n    queue.fail(task.id, 'err');\n    const afterSecond = task.availableAt!.getTime() - Date.now();\n    expect(afterSecond).toBeGreaterThanOrEqual(1990);\n    expect(afterSecond).toBeLessThanOrEqual(2010);\n\n    vi.useRealTimers();\n  });\n\n  it('Q5.5: Task tracks attempts count', () => {\n    const task = queue.add({}, { retries: 2 });\n    expect(task.attempts).toBe(0);\n    queue.getNext();\n    expect(task.attempts).toBe(1);\n    queue.fail(task.id, 'err');\n    expect(task.attempts).toBe(1);\n  });\n\n  it('Q5.6: Retried tasks keep their original queue and priority', () => {\n    const task = queue.add('myqueue', { x: 1 }, { priority: 3, retries: 1 });\n    queue.getNext('myqueue');\n    queue.fail(task.id, 'err');\n\n    expect(task.queueName).toBe('myqueue');\n    expect(task.priority).toBe(3);\n  });\n\n  it('Q5.7: Exhausted retries → status is \"failed\"', () => {\n    const task = queue.add({}, { retries: 0 });\n    queue.getNext();\n    queue.fail(task.id, 'last error');\n    expect(task.status).toBe('failed');\n    expect(task.error).toBe('last error');\n  });\n});\n\n// ===========================================================================\n// Phase 6: Dead Letter Queue\n// ===========================================================================\ndescribe('Phase 6 - Dead Letter Queue', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q6.1: Task with exhausted retries moves to dead letter queue', () => {\n    const task = queue.add('email', { msg: 'fail' }, { retries: 0 });\n    queue.getNext('email');\n    queue.fail(task.id, 'permanent error');\n\n    const dlq = queue.getDeadLetterTasks('email');\n    expect(dlq).toHaveLength(1);\n    expect(dlq[0].id).toBe(task.id);\n    expect(dlq[0].error).toBe('permanent error');\n  });\n\n  it('Q6.2: getDeadLetterTasks returns all dead-lettered tasks', () => {\n    const t1 = queue.add('q', { a: 1 }, { retries: 0 });\n    const t2 = queue.add('q', { b: 2 }, { retries: 0 });\n    queue.getNext('q');\n    queue.fail(t1.id, 'err1');\n    queue.getNext('q');\n    queue.fail(t2.id, 'err2');\n\n    expect(queue.getDeadLetterTasks('q')).toHaveLength(2);\n  });\n\n  it('Q6.3: Dead-lettered tasks retain error and retry info', () => {\n    const task = queue.add('test', { x: 1 }, { retries: 1, retryDelay: 100 });\n    queue.getNext('test');\n    queue.fail(task.id, 'first fail');\n\n    // Task still has retries left, so DLQ is empty\n    expect(queue.getDeadLetterTasks('test')).toHaveLength(0);\n    expect(task.retryCount).toBe(1);\n  });\n\n  it('Q6.4: retryDeadLetterTask moves task back to original queue', () => {\n    const task = queue.add('myq', { data: 1 }, { retries: 0 });\n    queue.getNext('myq');\n    queue.fail(task.id, 'fail');\n\n    expect(queue.getDeadLetterTasks('myq')).toHaveLength(1);\n\n    queue.retryDeadLetterTask('myq', task.id);\n    expect(queue.getDeadLetterTasks('myq')).toHaveLength(0);\n    expect(queue.waiting('myq')).toBe(1);\n  });\n\n  it('Q6.5: clearDeadLetterTasks removes all DLQ tasks', () => {\n    const task = queue.add('q', { data: 1 }, { retries: 0 });\n    queue.getNext('q');\n    queue.fail(task.id, 'err');\n\n    expect(queue.getDeadLetterTasks('q')).toHaveLength(1);\n    queue.clearDeadLetterTasks('q');\n    expect(queue.getDeadLetterTasks('q')).toHaveLength(0);\n  });\n\n  it('Q6.6: Each queue has its own independent DLQ', () => {\n    const a = queue.add('qa', { x: 1 }, { retries: 0 });\n    const b = queue.add('qb', { y: 2 }, { retries: 0 });\n    queue.getNext('qa');\n    queue.fail(a.id, 'fail a');\n    queue.getNext('qb');\n    queue.fail(b.id, 'fail b');\n\n    expect(queue.getDeadLetterTasks('qa')).toHaveLength(1);\n    expect(queue.getDeadLetterTasks('qb')).toHaveLength(1);\n    expect(queue.getDeadLetterTasks('qa')[0].payload).toEqual({ x: 1 });\n  });\n});\n\n// ===========================================================================\n// Phase 7: Task Dependencies\n// ===========================================================================\ndescribe('Phase 7 - Task Dependencies', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q7.1: Tasks with dependsOn are blocked until dependencies complete', () => {\n    const dep = queue.add({ setup: true });\n    const dependent = queue.add({ later: true }, { dependsOn: [dep.id] });\n\n    expect(dependent.status).toBe('waiting');\n    // dep is still available (it's pending, no deps)\n    expect(queue.getNext()!.id).toBe(dep.id);\n    // dependent is not returned\n    expect(queue.getNext()).toBeNull();\n  });\n\n  it('Q7.2: Blocked tasks are not returned by getNext', () => {\n    const a = queue.add({ a: 1 });\n    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n\n    expect(queue.getNext()!.id).toBe(a.id);\n    expect(queue.getNext()).toBeNull();\n  });\n\n  it('Q7.3: When dependency completes, blocked task becomes available', () => {\n    const a = queue.add({ a: 1 });\n    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n\n    queue.getNext();\n    queue.complete(a.id);\n\n    expect(queue.getNext()!.id).toBe(b.id);\n  });\n\n  it('Q7.4: Dependency chains are valid', () => {\n    const a = queue.add({ a: 1 });\n    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n    // Linear chain — valid, should not throw\n    expect(() => queue.add({ c: 3 }, { dependsOn: [b.id] })).not.toThrow();\n  });\n\n  it('Q7.5: Depending on non-existent task throws', () => {\n    expect(() => {\n      queue.add({ bad: true }, { dependsOn: ['non-existent-id'] });\n    }).toThrow();\n  });\n\n  it('Q7.6: A failed dependency does not auto-fail dependents', () => {\n    const a = queue.add({ a: 1 }, { retries: 0 });\n    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n\n    expect(queue.getNext()!.id).toBe(a.id);\n    queue.fail(a.id, 'boom');\n\n    // b remains blocked (waiting)\n    expect(queue.getNext()).toBeNull();\n    expect(b.status).toBe('waiting');\n  });\n\n  it('Q7.7: getTask returns task with dependencies and dependents', () => {\n    const dep = queue.add({ dep: true });\n    const task = queue.add({ main: true }, { dependsOn: [dep.id] });\n\n    const fetched = queue.getTask(task.id);\n    expect(fetched).not.toBeNull();\n    expect(fetched!.dependencies).toContain(dep.id);\n\n    const depFetched = queue.getTask(dep.id);\n    expect(depFetched!.dependents).toContain(task.id);\n  });\n});\n\n// ===========================================================================\n// Phase 8: Concurrency Control\n// ===========================================================================\ndescribe('Phase 8 - Concurrency Control', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q8.1: setConcurrency limits processing tasks', () => {\n    queue.setConcurrency('default', 2);\n    queue.add({ a: 1 });\n    queue.add({ b: 2 });\n    queue.add({ c: 3 });\n\n    expect(queue.getNext()).not.toBeNull();\n    expect(queue.getNext()).not.toBeNull();\n    expect(queue.getNext()).toBeNull();\n  });\n\n  it('Q8.2: Default concurrency is unlimited', () => {\n    queue.add({ a: 1 });\n    queue.add({ b: 2 });\n    queue.add({ c: 3 });\n\n    expect(queue.getNext()).not.toBeNull();\n    expect(queue.getNext()).not.toBeNull();\n    expect(queue.getNext()).not.toBeNull();\n  });\n\n  it('Q8.3: getNext returns null when concurrency reached', () => {\n    queue.setConcurrency('default', 1);\n    queue.add({ a: 1 });\n    queue.add({ b: 2 });\n\n    expect(queue.getNext()).not.toBeNull();\n    expect(queue.getNext()).toBeNull();\n    expect(queue.waiting()).toBe(1);\n  });\n\n  it('Q8.4: Completing a task frees a slot', () => {\n    queue.setConcurrency('default', 1);\n    const a = queue.add({ a: 1 });\n    const b = queue.add({ b: 2 });\n\n    const first = queue.getNext()!;\n    expect(first.payload).toEqual({ a: 1 });\n    expect(queue.getNext()).toBeNull();\n\n    queue.complete(a.id);\n    expect(queue.getNext()!.payload).toEqual({ b: 2 });\n  });\n\n  it('Q8.5: getConcurrency returns the limit', () => {\n    queue.setConcurrency('test', 5);\n    expect(queue.getConcurrency('test')).toBe(5);\n    expect(queue.getConcurrency('non-existent')).toBeNull();\n  });\n\n  it('Q8.6: getActiveCount returns number of processing tasks', () => {\n    queue.setConcurrency('default', 3);\n    queue.add({ a: 1 });\n    queue.add({ b: 2 });\n\n    expect(queue.getActiveCount('default')).toBe(0);\n    const a = queue.getNext()!;\n    expect(queue.getActiveCount('default')).toBe(1);\n    queue.getNext();\n    expect(queue.getActiveCount('default')).toBe(2);\n    queue.complete(a.id);\n    expect(queue.getActiveCount('default')).toBe(1);\n  });\n\n  it('Q8.7: Concurrency respects priority ordering', () => {\n    queue.setConcurrency('default', 1);\n    queue.add({ low: true }, { priority: 10 });\n    queue.add({ high: true }, { priority: 1 });\n\n    expect(queue.getNext()!.payload).toEqual({ high: true });\n  });\n});\n\n// ===========================================================================\n// Phase 9: Progress Tracking and Cancellation\n// ===========================================================================\ndescribe('Phase 9 - Progress Tracking and Cancellation', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q9.1: reportProgress updates a processing task progress', () => {\n    const task = queue.add({});\n    queue.getNext();\n    queue.reportProgress(task.id, 50, 'halfway there');\n\n    expect(task.progress).toBe(50);\n    expect(task.progressMessage).toBe('halfway there');\n  });\n\n  it('Q9.2: getTask returns progress info', () => {\n    const task = queue.add({});\n    queue.getNext();\n    queue.reportProgress(task.id, 75);\n\n    const fetched = queue.getTask(task.id);\n    expect(fetched!.progress).toBe(75);\n  });\n\n  it('Q9.3: onProgress subscribes to progress updates', () => {\n    const task = queue.add({});\n    queue.getNext();\n\n    const updates: Array<{ pct: number; msg?: string }> = [];\n    queue.onProgress(task.id, (pct, msg) => {\n      updates.push({ pct, msg });\n    });\n\n    queue.reportProgress(task.id, 25, 'quarter');\n    queue.reportProgress(task.id, 50, 'half');\n    queue.reportProgress(task.id, 75);\n\n    expect(updates).toHaveLength(3);\n    expect(updates[0]).toEqual({ pct: 25, msg: 'quarter' });\n    expect(updates[1]).toEqual({ pct: 50, msg: 'half' });\n    expect(updates[2]).toEqual({ pct: 75, msg: undefined });\n  });\n\n  it('Q9.4: Unsubscribing stops progress updates', () => {\n    const task = queue.add({});\n    queue.getNext();\n\n    const updates: number[] = [];\n    const unsubscribe = queue.onProgress(task.id, (pct) => {\n      updates.push(pct);\n    });\n\n    queue.reportProgress(task.id, 25);\n    expect(updates).toHaveLength(1);\n\n    unsubscribe();\n    queue.reportProgress(task.id, 50);\n    expect(updates).toHaveLength(1);\n  });\n\n  it('Q9.5: cancel sets cancelled status', () => {\n    const pendingTask = queue.add({ pending: true });\n    const processingTask = queue.add({ processing: true });\n\n    queue.getNext(); // gets the first pending (pendingTask)\n\n    queue.cancel(pendingTask.id);\n    expect(pendingTask.status).toBe('cancelled');\n\n    queue.cancel(processingTask.id);\n    expect(processingTask.status).toBe('cancelled');\n  });\n\n  it('Q9.6: Cancelled pending tasks are removed from queue', () => {\n    const task = queue.add({});\n    queue.cancel(task.id);\n    expect(queue.getNext()).toBeNull();\n    expect(queue.waiting()).toBe(0);\n  });\n\n  it('Q9.7: Cancelled processing tasks have status updated', () => {\n    const task = queue.add({});\n    queue.getNext();\n    expect(task.status).toBe('processing');\n\n    queue.cancel(task.id);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('Q9.8: Cancelled tasks are never retried', () => {\n    const task = queue.add({}, { retries: 3 });\n    queue.getNext();\n\n    queue.cancel(task.id);\n    queue.fail(task.id, 'should not retry');\n    expect(task.status).toBe('cancelled');\n    expect(task.retryCount).toBe(0);\n  });\n});\n\n// ===========================================================================\n// Phase 10: Recurring Tasks\n// ===========================================================================\ndescribe('Phase 10 - Recurring Tasks', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q10.1: addSchedule creates a schedule and returns an ID', () => {\n    const id = queue.addSchedule('*/5 * * * *', 'email', { type: 'reminder' });\n    expect(id).toBeDefined();\n    expect(typeof id).toBe('string');\n  });\n\n  it('Q10.3: listSchedules returns active schedules', () => {\n    queue.addSchedule('*/5 * * * *', 'q', { a: 1 });\n    queue.addSchedule('0 * * * *', 'q', { b: 2 });\n\n    expect(queue.listSchedules()).toHaveLength(2);\n  });\n\n  it('Q10.4: removeSchedule stops a schedule', () => {\n    const id = queue.addSchedule('*/5 * * * *', 'q', {});\n    expect(queue.listSchedules()).toHaveLength(1);\n\n    queue.removeSchedule(id);\n    expect(queue.listSchedules()).toHaveLength(0);\n  });\n\n  it('Q10.5: checkSchedules enqueues tasks for due schedules', () => {\n    const schedId = queue.addSchedule('*/5 * * * *', 'test-queue', { recurring: true });\n\n    queue.checkSchedules();\n    const schedule = queue.listSchedules().find(s => s.id === schedId);\n    expect(schedule!.lastRun).not.toBeNull();\n\n    expect(queue.waiting('test-queue')).toBe(1);\n    const task = queue.getNext('test-queue');\n    expect(task!.payload).toEqual({ recurring: true });\n  });\n\n  it('Q10.6: Enqueued tasks are regular tasks', () => {\n    queue.addSchedule('*/5 * * * *', 'q', { recurring: true });\n    queue.checkSchedules();\n\n    const task = queue.getNext('q');\n    expect(task!.id).toBeDefined();\n    expect(task!.status).toBe('processing');\n    expect(task!.payload).toEqual({ recurring: true });\n  });\n\n  it('Q10.7: addSchedule returns unique schedule IDs', () => {\n    const a = queue.addSchedule('*/5 * * * *', 'q1', {});\n    const b = queue.addSchedule('*/5 * * * *', 'q2', {});\n    expect(a).not.toBe(b);\n  });\n\n  it('Q10.8: Removed schedule no longer enqueues tasks', () => {\n    const id = queue.addSchedule('*/5 * * * *', 'q', {});\n    queue.removeSchedule(id);\n\n    queue.checkSchedules();\n    expect(queue.waiting('q')).toBe(0);\n  });\n\n  it('Supports 0 * * * * (hourly) cron', () => {\n    expect(() => queue.addSchedule('0 * * * *', 'q', {})).not.toThrow();\n  });\n\n  it('Supports 0 0 * * * (daily) cron', () => {\n    expect(() => queue.addSchedule('0 0 * * *', 'q', {})).not.toThrow();\n  });\n\n  it('Rejects unsupported cron expressions', () => {\n    expect(() => queue.addSchedule('* * * * *', 'q', {})).toThrow();\n    expect(() => queue.addSchedule('0 0 1 * *', 'q', {})).toThrow();\n  });\n});\n\n// ===========================================================================\n// Phase 11: Middleware Pipeline\n// ===========================================================================\ndescribe('Phase 11 - Middleware Pipeline', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q11.1: use registers middleware on a queue', () => {\n    expect(() => {\n      queue.use('test', async (_task, next) => { await next(); });\n    }).not.toThrow();\n  });\n\n  it('Q11.3: Middleware runs in order then handler', async () => {\n    const order: string[] = [];\n\n    queue.use('test', async (_task, next) => {\n      order.push('mw1-before');\n      await next();\n      order.push('mw1-after');\n    });\n    queue.use('test', async (_task, next) => {\n      order.push('mw2-before');\n      await next();\n      order.push('mw2-after');\n    });\n    queue.process('test', async (_task) => {\n      order.push('handler');\n    });\n\n    queue.add('test', {});\n    const task = queue.getNext('test')!;\n    await queue.runTask(task.id);\n\n    expect(order).toEqual(['mw1-before', 'mw2-before', 'handler', 'mw2-after', 'mw1-after']);\n  });\n\n  it('Q11.5: If middleware does not call next, handler is skipped', async () => {\n    const order: string[] = [];\n\n    queue.use('test', async (_task, _next) => {\n      order.push('mw1');\n      // deliberately not calling next\n    });\n    queue.process('test', async (_task) => {\n      order.push('handler');\n    });\n\n    queue.add('test', {});\n    const task = queue.getNext('test')!;\n    await queue.runTask(task.id);\n    expect(order).toEqual(['mw1']);\n  });\n\n  it('Q11.6: Middleware can modify the task payload', async () => {\n    queue.use('test', async (task, next) => {\n      (task.payload as Record<string, unknown>).modified = true;\n      await next();\n    });\n    queue.process('test', async (task) => {\n      expect((task.payload as Record<string, unknown>).modified).toBe(true);\n    });\n\n    queue.add('test', { original: true });\n    const task = queue.getNext('test')!;\n    await queue.runTask(task.id);\n    expect(queue.getTask(task.id)!.status).toBe('completed');\n  });\n\n  it('Q11.7: Middleware that throws marks task as failed', async () => {\n    queue.use('test', async (_task, _next) => {\n      throw new Error('middleware failure');\n    });\n    queue.process('test', async (_task) => {\n      // should not reach here\n    });\n\n    queue.add('test', {}, { retries: 0 });\n    const task = queue.getNext('test')!;\n    await queue.runTask(task.id);\n    expect(task.status).toBe('failed');\n    expect(task.error).toBe('middleware failure');\n  });\n\n  it('Q11.8: Each queue has its own middleware stack', async () => {\n    const order: string[] = [];\n\n    queue.use('q1', async (_task, next) => {\n      order.push('q1-mw');\n      await next();\n    });\n    queue.use('q2', async (_task, next) => {\n      order.push('q2-mw');\n      await next();\n    });\n    queue.process('q1', async (_task) => {\n      order.push('q1-handler');\n    });\n    queue.process('q2', async (_task) => {\n      order.push('q2-handler');\n    });\n\n    queue.add('q1', {});\n    queue.add('q2', {});\n\n    await queue.runTask(queue.getNext('q1')!.id);\n    await queue.runTask(queue.getNext('q2')!.id);\n\n    expect(order).toEqual(['q1-mw', 'q1-handler', 'q2-mw', 'q2-handler']);\n  });\n});\n\n// ===========================================================================\n// Phase 12: Graceful Shutdown\n// ===========================================================================\ndescribe('Phase 12 - Graceful Shutdown', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Q12.2: After shutdown, add() throws', async () => {\n    await queue.shutdown();\n    expect(() => queue.add({})).toThrow();\n  });\n\n  it('Q12.5: onShutdown callbacks run during shutdown', async () => {\n    const calls: string[] = [];\n    queue.onShutdown(() => { calls.push('cb1'); });\n    queue.onShutdown(() => { calls.push('cb2'); });\n\n    await queue.shutdown();\n    expect(calls).toEqual(['cb1', 'cb2']);\n  });\n\n  it('Q12.6: shutdown returns ShutdownResult', async () => {\n    const result = await queue.shutdown();\n    expect(result).toHaveProperty('completed');\n    expect(result).toHaveProperty('cancelled');\n    expect(result).toHaveProperty('duration');\n    expect(typeof result.completed).toBe('number');\n    expect(typeof result.cancelled).toBe('number');\n    expect(typeof result.duration).toBe('number');\n  });\n\n  it('Q12.7: Multiple shutdown calls return the same result', async () => {\n    const first = await queue.shutdown();\n    const second = await queue.shutdown();\n    expect(first).toBe(second);\n  });\n\n  it('Q12.8: Shutdown with no processing tasks completes immediately', async () => {\n    const start = Date.now();\n    await queue.shutdown();\n    const elapsed = Date.now() - start;\n    expect(elapsed).toBeLessThan(500);\n  });\n\n  it('Q12.4: Processing tasks exceeding timeout are force-cancelled', async () => {\n    const slow = queue.add({});\n    queue.getNext(); // now processing — never completes\n\n    const result = await queue.shutdown({ timeout: 100 });\n    expect(slow.status).toBe('cancelled');\n    expect(result.cancelled).toBeGreaterThanOrEqual(0);\n  });\n});\n\n// ===========================================================================\n// Integration: Cross-phase interaction tests\n// ===========================================================================\ndescribe('Integration - Cross-Phase Interactions', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('Priority + Named queues + Delays work together', async () => {\n    queue.add('high-delay', { x: 1 }, { priority: 1, delay: 100 });\n    queue.add('low-instant', { y: 2 }, { priority: 10 });\n\n    expect(queue.getNext('low-instant')!.payload).toEqual({ y: 2 });\n    expect(queue.getNext('high-delay')).toBeNull();\n\n    await new Promise(resolve => setTimeout(resolve, 150));\n    expect(queue.getNext('high-delay')!.payload).toEqual({ x: 1 });\n  });\n\n  it('Priority + Concurrency: highest priority within limit', () => {\n    queue.setConcurrency('default', 1);\n    queue.add({ low: true }, { priority: 10 });\n    queue.add({ high: true }, { priority: 1 });\n    queue.add({ mid: true }, { priority: 5 });\n\n    expect(queue.getNext()!.payload).toEqual({ high: true });\n  });\n\n  it('Complete + Dependency chain works linearly', () => {\n    const a = queue.add({ a: 1 });\n    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });\n    const c = queue.add({ c: 3 }, { dependsOn: [b.id] });\n\n    expect(queue.getNext()!.id).toBe(a.id);\n    queue.complete(a.id);\n\n    expect(queue.getNext()!.id).toBe(b.id);\n    queue.complete(b.id);\n\n    expect(queue.getNext()!.id).toBe(c.id);\n  });\n\n  it('Cancel prevents retry', () => {\n    const task = queue.add({}, { retries: 3 });\n    queue.getNext();\n    queue.cancel(task.id);\n    queue.fail(task.id, 'should not retry');\n    expect(task.status).toBe('cancelled');\n    expect(task.retryCount).toBe(0);\n  });\n\n  it('Middleware + Completion status', async () => {\n    let mwRan = false;\n    queue.use('test', async (t, next) => {\n      mwRan = true;\n      await next();\n    });\n    queue.process('test', async (_t) => {\n      // does work\n    });\n\n    queue.add('test', {});\n    const task = queue.getNext('test')!;\n    await queue.runTask(task.id);\n    expect(mwRan).toBe(true);\n    expect(queue.getTask(task.id)!.status).toBe('completed');\n  });\n});\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":4,"lines":["-import { describe, it, expect, vi, beforeEach } from 'vitest';","+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';"," import { TaskQueue } from '../src/task-queue.js';"," "," // ==========================================================================="]},{"oldStart":38,"oldLines":7,"newStart":38,"newLines":6,"lines":["     expect(retrieved).not.toBeNull();","     expect(retrieved!.id).toBe(task.id);","     expect(retrieved!.status).toBe('processing');","-    // Original task object should also have updated status","     expect(task.status).toBe('processing');","   });"," "]},{"oldStart":96,"oldLines":11,"newStart":95,"newLines":8,"lines":["     queue.add('a', { msg: 'from a' });","     queue.add('b', { msg: 'from b' });"," ","-    const aTask = queue.getNext('a');","-    expect(aTask!.payload).toEqual({ msg: 'from