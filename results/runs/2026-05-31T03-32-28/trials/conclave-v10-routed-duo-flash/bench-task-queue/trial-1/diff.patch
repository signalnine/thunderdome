+// ===========================================================================
+// Phase 11: Middleware Pipeline
+// ===========================================================================
+describe('Phase 11 - Middleware Pipeline', () => {
+  let queue: TaskQueue;
+
+  beforeEach(() => {
+    queue = new TaskQueue();
+  });
+
+  it('Q11.1: use registers middleware on a queue', () => {
+    expect(() => {
+      queue.use('test', async (_task, next) => { await next(); });
+    }).not.toThrow();
+  });
+
+  it('Q11.3: Middleware runs in order then handler', async () => {
+    const order: string[] = [];
+
+    queue.use('test', async (_task, next) => {
+      order.push('mw1-before');
+      await next();
+      order.push('mw1-after');
+    });
+    queue.use('test', async (_task, next) => {
+      order.push('mw2-before');
+      await next();
+      order.push('mw2-after');
+    });
+    queue.process('test', async (_task) => {
+      order.push('handler');
+    });
+
+    queue.add('test', {});
+    const task = queue.getNext('test')!;
+    await queue.runTask(task.id);
+
+    expect(order).toEqual(['mw1-before', 'mw2-before', 'handler', 'mw2-after', 'mw1-after']);
+  });
+
+  it('Q11.5: If middleware does not call next, handler is skipped', async () => {
+    const order: string[] = [];
+
+    queue.use('test', async (_task, _next) => {
+      order.push('mw1');
+      // deliberately not calling next
+    });
+    queue.process('test', async (_task) => {
+      order.push('handler');
+    });
+
+    queue.add('test', {});
+    const task = queue.getNext('test')!;
+    await queue.runTask(task.id);
+    expect(order).toEqual(['mw1']);
+  });
+
+  it('Q11.6: Middleware can modify the task payload', async () => {
+    queue.use('test', async (task, next) => {
+      (task.payload as Record<string, unknown>).modified = true;
+      await next();
+    });
+    queue.process('test', async (task) => {
+      expect((task.payload as Record<string, unknown>).modified).toBe(true);
+    });
+
+    queue.add('test', { original: true });
+    const task = queue.getNext('test')!;
+    await queue.runTask(task.id);
+    expect(queue.getTask(task.id)!.status).toBe('completed');
+  });
+
+  it('Q11.7: Middleware that throws marks task as failed', async () => {
+    queue.use('test', async (_task, _next) => {
+      throw new Error('middleware failure');
+    });
+    queue.process('test', async (_task) => {
+      // should not reach here
+    });
+
+    queue.add('test', {}, { retries: 0 });
+    const task = queue.getNext('test')!;
+    await queue.runTask(task.id);
+    expect(task.status).toBe('failed');
+    expect(task.error).toBe('middleware failure');
+  });
+
+  it('Q11.8: Each queue has its own middleware stack', async () => {
+    const order: string[] = [];
+
+    queue.use('q1', async (_task, next) => {
+      order.push('q1-mw');
+      await next();
+    });
+    queue.use('q2', async (_task, next) => {
+      order.push('q2-mw');
+      await next();
+    });
+    queue.process('q1', async (_task) => {
+      order.push('q1-handler');
+    });
+    queue.process('q2', async (_task) => {
+      order.push('q2-handler');
+    });
+
+    queue.add('q1', {});
+    queue.add('q2', {});
+
+    await queue.runTask(queue.getNext('q1')!.id);
+    await queue.runTask(queue.getNext('q2')!.id);
+
+    expect(order).toEqual(['q1-mw', 'q1-handler', 'q2-mw', 'q2-handler']);
+  });
+});
