+// ===========================================================================
+// Integration: Cross-phase interaction tests
+// ===========================================================================
+describe('Integration - Cross-Phase Interactions', () => {
+  let queue: TaskQueue;
+
+  beforeEach(() => {
+    queue = new TaskQueue();
+  });
+
+  it('Priority + Named queues + Delays work together', async () => {
+    queue.add('high-delay', { x: 1 }, { priority: 1, delay: 100 });
+    queue.add('low-instant', { y: 2 }, { priority: 10 });
+
+    expect(queue.getNext('low-instant')!.payload).toEqual({ y: 2 });
+    expect(queue.getNext('high-delay')).toBeNull();
+
+    await new Promise(resolve => setTimeout(resolve, 150));
+    expect(queue.getNext('high-delay')!.payload).toEqual({ x: 1 });
+  });
+
+  it('Priority + Concurrency: highest priority within limit', () => {
+    queue.setConcurrency('default', 1);
+    queue.add({ low: true }, { priority: 10 });
+    queue.add({ high: true }, { priority: 1 });
+    queue.add({ mid: true }, { priority: 5 });
+
+    expect(queue.getNext()!.payload).toEqual({ high: true });
+  });
+
+  it('Complete + Dependency chain works linearly', () => {
+    const a = queue.add({ a: 1 });
+    const b = queue.add({ b: 2 }, { dependsOn: [a.id] });
+    const c = queue.add({ c: 3 }, { dependsOn: [b.id] });
+
+    expect(queue.getNext()!.id).toBe(a.id);
+    queue.complete(a.id);
+
+    expect(queue.getNext()!.id).toBe(b.id);
+    queue.complete(b.id);
+
+    expect(queue.getNext()!.id).toBe(c.id);
+  });
+
+  it('Cancel prevents retry', () => {
+    const task = queue.add({}, { retries: 3 });
+    queue.getNext();
+    queue.cancel(task.id);
+    queue.fail(task.id, 'should not retry');
+    expect(task.status).toBe('cancelled');
+    expect(task.retryCount).toBe(0);
+  });
+
+  it('Middleware + Completion status', async () => {
+    let mwRan = false;
+    queue.use('test', async (t, next) => {
+      mwRan = true;
+      await next();
+    });
+    queue.process('test', async (_t) => {
+      // does work
+    });
+
+    queue.add('test', {});
+    const task = queue.getNext('test')!;
+    await queue.runTask(task.id);
+    expect(mwRan).toBe(true);
+    expect(queue.getTask(task.id)!.status).toBe('completed');
+  });
+});
