+// =========================================================================
+// Integration: Cross-phase interactions
+// =========================================================================
+
+describe('Cross-phase Integration', () => {
+  let q: TaskQueueSystem;
+
+  beforeEach(() => {
+    q = new TaskQueueSystem();
+  });
+
+  it('should combine priority, named queues, and delays', () => {
+    q.add('urgent-email', { queue: 'email', priority: 1 });
+    q.add('later-email', { queue: 'email', priority: 5, delay: 5000 });
+    q.add('normal-email', { queue: 'email', priority: 5 });
+
+    // Urgent first, then normal, then later (but later is delayed, so null)
+    expect(q.getNext('email')!.payload).toBe('urgent-email');
+    expect(q.getNext('email')!.payload).toBe('normal-email');
+    expect(q.getNext('email')).toBeNull();
+  });
+
+  it('should combine dependencies with retry', () => {
+    const dep = q.add('producer', { maxRetries: 2, backoffDelay: 10 });
+    const task = q.add('consumer', { dependsOn: [dep.id] });
+
+    // Process and fail the dependency
+    q.getNext();
+    q.fail(dep.id, new Error('transient'));
+
+    // Dependency retries (1 <= 2), consumer stays blocked
+    expect(dep.status).toBe('pending');
+    expect(task.status).toBe('blocked');
+
+    // Dependency retry succeeds
+    dep.availableAt = new Date(Date.now() - 10);
+    q.getNext();
+    q.complete(dep.id);
+
+    // Consumer should now be unblocked
+    expect(task.status).toBe('pending');
+  });
+
+  it('should combine middleware with concurrency and progress', async () => {
+    q.setConcurrency(1);
+    q.use((t, next) => {
+      (t.payload as Record<string, unknown>).middlewareRan = true;
+      next();
+    });
+
+    const order: string[] = [];
+    q.process(async (t) => {
+      order.push('handler');
+      // Report progress before completing
+      q.reportProgress(t.id, 50, 'mid');
+      expect(q.getProgress(t.id)!.progress).toBe(50);
+      q.complete(t.id);
+    });
+
+    const task = q.add({ data: 'test' });
+    q.getNext();
+    await q.processTask(task.id);
+
+    expect((task.payload as Record<string, unknown>).middlewareRan).toBe(true);
+    expect(order).toEqual(['handler']);
+    expect(task.status).toBe('completed');
+  });
+
+  it('should combine recurring tasks with dependencies', () => {
+    q.add('seed');
+
+    // Schedule uses a cron that matches every minute
+    q.addSchedule('gen', '* * * * *', { generated: true });
+
+    // Consume the seed task so only the tick task remains
+    q.getNext();
+
+    q.tick();
+
+    // The tick task should be enqueued as a regular task, independent from dependencies
+    expect(q.getWaitingCount()).toBe(1);
+    const tickTask = q.getNext();
+    expect(tickTask!.payload).toEqual({ generated: true });
+  });
+
+  it('should handle full lifecycle: add -> process -> complete -> dependents unblocked', () => {
+    q.add('producer', { queue: 'staging', priority: 1 });
+    q.add('backup', { queue: 'staging', priority: 5 });
+
+    const stagingIn = q.add('staging-ready', { queue: 'prod', dependsOn: [] });
+    // Just test basic lifecycle completeness
+    const prodTask = q.add('deploy', { queue: 'prod', priority: 1 });
+
+    expect(q.getNext('staging')!.priority).toBe(1);
+    expect(q.getNext('staging')!.priority).toBe(5);
+    expect(q.getNext('prod')!.id).toBe(prodTask.id);
+  });
+});
