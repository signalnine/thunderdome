==========\n// Phase 1: Basic FIFO Queue\n// =========================================================================\n\ndescribe('Phase 1: Basic FIFO Queue', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should add a task and return a task object with id, status, payload, createdAt', () => {\n    const task = q.add('my-payload');\n    expect(task).toBeDefined();\n    expect(task.id).toBeDefined();\n    expect(typeof task.id).toBe('string');\n    expect(task.id.length).toBeGreaterThan(0);\n    expect(task.status).toBe('pending');\n    expect(task.payload).toBe('my-payload');\n    expect(task.createdAt).toBeInstanceOf(Date);\n  });\n\n  it('should retrieve tasks in FIFO order', () => {\n    q.add('first');\n    q.add('second');\n    q.add('third');\n\n    const t1 = q.getNext();\n    expect(t1).not.toBeNull();\n    expect(t1!.payload).toBe('first');\n    expect(t1!.status).toBe('processing');\n\n    const t2 = q.getNext();\n    expect(t2).not.toBeNull();\n    expect(t2!.payload).toBe('second');\n\n    const t3 = q.getNext();\n    expect(t3).not.toBeNull();\n    expect(t3!.payload).toBe('third');\n  });\n\n  it('should return null when no tasks are pending', () => {\n    expect(q.getNext()).toBeNull();\n  });\n\n  it('should return the number of waiting tasks', () => {\n    expect(q.getWaitingCount()).toBe(0);\n    q.add('a');\n    q.add('b');\n    q.add('c');\n    expect(q.getWaitingCount()).toBe(3);\n  });\n\n  it('should decrement waiting count after retrieving a task', () => {\n    q.add('a');\n    q.add('b');\n    expect(q.getWaitingCount()).toBe(2);\n    q.getNext();\n    expect(q.getWaitingCount()).toBe(1);\n    q.getNext();\n    expect(q.getWaitingCount()).toBe(0);\n  });\n\n  it('should have unique IDs for each task', () => {\n    const t1 = q.add('a');\n    const t2 = q.add('b');\n    expect(t1.id).not.toBe(t2.id);\n  });\n\n  it('should handle various payload types', () => {\n    q.add({ complex: 'object', num: 42 });\n    q.add(123);\n    q.add(null);\n    q.add(['array']);\n\n    expect(q.getNext()!.payload).toEqual({ complex: 'object', num: 42 });\n    expect(q.getNext()!.payload).toBe(123);\n    expect(q.getNext()!.payload).toBeNull();\n    expect(q.getNext()!.payload).toEqual(['array']);\n  });\n});\n\n// =========================================================================\n// Phase 2: Named Queues\n// =========================================================================\n\ndescribe('Phase 2: Named Queues', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should add to a named queue and retrieve from it', () => {\n    const task = q.add('email-job', { queue: 'email' });\n    expect(task).toBeDefined();\n\n    const retrieved = q.getNext('email');\n    expect(retrieved).not.toBeNull();\n    expect(retrieved!.payload).toBe('email-job');\n  });\n\n  it('should use default queue when no name given', () => {\n    q.add('default-task');\n    const retrieved = q.getNext();\n    expect(retrieved).not.toBeNull();\n    expect(retrieved!.payload).toBe('default-task');\n  });\n\n  it('should keep named queues independent', () => {\n    q.add('email-1', { queue: 'email' });\n    q.add('email-2', { queue: 'email' });\n    q.add('report-1', { queue: 'report' });\n\n    // Getting from email returns email-1\n    expect(q.getNext('email')!.payload).toBe('email-1');\n    expect(q.getNext('email')!.payload).toBe('email-2');\n    // Getting from report returns report-1\n    expect(q.getNext('report')!.payload).toBe('report-1');\n    // Email queue should be empty now\n    expect(q.getNext('email')).toBeNull();\n  });\n\n  it('should list all queue names', () => {\n    expect(q.listQueues()).toEqual([]);\n\n    q.add('a', { queue: 'alpha' });\n    expect(q.listQueues()).toEqual(['alpha']);\n\n    q.add('b', { queue: 'beta' });\n    const queues = q.listQueues();\n    expect(queues).toContain('alpha');\n    expect(queues).toContain('beta');\n    expect(queues.length).toBe(2);\n  });\n\n  it('should create queue implicitly on first add', () => {\n    expect(q.listQueues()).toEqual([]);\n    q.add('first', { queue: 'implicit' });\n    expect(q.listQueues()).toContain('implicit');\n  });\n\n  it('should return null for non-existent queue', () => {\n    expect(q.getNext('nonexistent')).toBeNull();\n  });\n\n  it('should return 0 waiting count for non-existent queue', () => {\n    expect(q.getWaitingCount('nonexistent')).toBe(0);\n  });\n\n  it('should keep waiting count per queue', () => {\n    q.add('a', { queue: 'x' });\n    q.add('b', { queue: 'x' });\n    q.add('c', { queue: 'y' });\n\n    expect(q.getWaitingCount('x')).toBe(2);\n    expect(q.getWaitingCount('y')).toBe(1);\n    expect(q.getWaitingCount()).toBe(0); // default queue is empty\n  });\n\n  it('should be backward compatible with Phase 1 (no queue name)', () => {\n    q.add('task1');\n    q.add('task2');\n    expect(q.getNext()!.payload).toBe('task1');\n    expect(q.getNext()!.payload).toBe('task2');\n    expect(q.getNext()).toBeNull();\n  });\n});\n\n// =========================================================================\n// Phase 3: Priority\n// =========================================================================\n\ndescribe('Phase 3: Priority', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should assign default priority of 5', () => {\n    const task = q.add('normal');\n    expect(task.priority).toBe(5);\n  });\n\n  it('should assign custom priority', () => {\n    const task = q.add('urgent', { priority: 1 });\n    expect(task.priority).toBe(1);\n  });\n\n  it('should return higher priority tasks first', () => {\n    q.add('low', { priority: 10 });\n    q.add('high', { priority: 1 });\n    q.add('medium', { priority: 5 });\n\n    expect(q.getNext()!.payload).toBe('high');\n    expect(q.getNext()!.payload).toBe('medium');\n    expect(q.getNext()!.payload).toBe('low');\n  });\n\n  it('should return FIFO order within same priority', () => {\n    q.add('first', { priority: 5 });\n    q.add('second', { priority: 5 });\n    q.add('third', { priority: 5 });\n\n    expect(q.getNext()!.payload).toBe('first');\n    expect(q.getNext()!.payload).toBe('second');\n    expect(q.getNext()!.payload).toBe('third');\n  });\n\n  it('should reject invalid priority (below minimum)', () => {\n    expect(() => q.add('bad', { priority: 0 })).toThrow();\n  });\n\n  it('should reject invalid priority (above maximum)', () => {\n    expect(() => q.add('bad', { priority: 11 })).toThrow();\n  });\n\n  it('should reject non-integer priority', () => {\n    expect(() => q.add('bad', { priority: 3.5 })).toThrow();\n  });\n\n  it('should maintain priority per named queue', () => {\n    q.add('low-a', { queue: 'a', priority: 10 });\n    q.add('high-b', { queue: 'b', priority: 1 });\n    q.add('high-a', { queue: 'a', priority: 1 });\n\n    expect(q.getNext('a')!.payload).toBe('high-a');\n    expect(q.getNext('a')!.payload).toBe('low-a');\n    expect(q.getNext('b')!.payload).toBe('high-b');\n  });\n\n  it('should expose priority on the task object', () => {\n    const task = q.add('test', { priority: 3 });\n    expect(task.priority).toBe(3);\n  });\n});\n\n// =========================================================================\n// Phase 4: Delayed Tasks\n// =========================================================================\n\ndescribe('Phase 4: Delayed Tasks', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should not return delayed tasks before their delay expires', () => {\n    q.add('now');\n    q.add('later', { delay: 10000 }); // 10 seconds\n\n    // Immediate task should be returned first\n    expect(q.getNext()!.payload).toBe('now');\n    // Delayed task should not be available\n    expect(q.getNext()).toBeNull();\n  });\n\n  it('should make delayed tasks available after their delay expires', async () => {\n    q.add('later', { delay: 10 }); // 10ms delay\n    q.add('much-later', { delay: 10000 }); // not expiring\n\n    // Not yet available\n    expect(q.getNext()).toBeNull();\n\n    // Wait for the 10ms delay to expire\n    await new Promise((r) => setTimeout(r, 20));\n\n    // The 10ms task should now be available, the 10s one should not\n    const task = q.getNext();\n    expect(task).not.toBeNull();\n    expect(task!.payload).toBe('later');\n    expect(q.getNext()).toBeNull();\n  });\n\n  it('should support specific future time via availableAt', () => {\n    const future = new Date(Date.now() + 5000);\n    q.add('scheduled', { availableAt: future });\n\n    expect(q.getNext()).toBeNull();\n  });\n\n  it('should expose availableAt on the task', () => {\n    q.add('immediate');\n    expect(q.getNext()!.availableAt).toBeNull();\n\n    const future = new Date(Date.now() + 5000);\n    const task = q.add('scheduled', { availableAt: future });\n    expect(task.availableAt).toBeInstanceOf(Date);\n    expect(task.availableAt!.getTime()).toBe(future.getTime());\n\n    const delayed = q.add('delayed', { delay: 5000 });\n    expect(delayed.availableAt).toBeInstanceOf(Date);\n    expect(delayed.availableAt!.getTime()).toBeGreaterThan(Date.now());\n  });\n\n  it('should prefer non-delayed tasks over delayed ones', () => {\n    q.add('delayed', { delay: 100 });\n    q.add('immediate');\n\n    // Immediate should come first even though delayed was added first\n    expect(q.getNext()!.payload).toBe('immediate');\n  });\n\n  it('should error if both delay and availableAt specified', () => {\n    expect(() =>\n      q.add('conflict', {\n        delay: 1000,\n        availableAt: new Date(Date.now() + 2000),\n      }),\n    ).toThrow();\n  });\n\n  it('should work with named queues', () => {\n    q.add('delayed-email', { queue: 'email', delay: 5000 });\n    q.add('immediate-email', { queue: 'email' });\n\n    expect(q.getNext('email')!.payload).toBe('immediate-email');\n    expect(q.getNext('email')!).toBeNull();\n  });\n});\n\n// =========================================================================\n// Phase 5: Retry with Backoff\n// =========================================================================\n\ndescribe('Phase 5: Retry with Backoff', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should complete a task and mark it as completed', () => {\n    const task = q.add('job');\n    q.getNext();\n    q.complete(task.id);\n    expect(task.status).toBe('completed');\n    expect(task.completedAt).toBeInstanceOf(Date);\n  });\n\n  it('should fail a task and trigger retry with backoff', () => {\n    const task = q.add('failing-job', { maxRetries: 3, backoffDelay: 100 });\n    q.getNext();\n    q.fail(task.id, new Error('Something went wrong'));\n\n    // Should still be pending (retrying)\n    expect(task.status).toBe('pending');\n    expect(task.attempts).toBe(1);\n\n    // Should have a future availableAt\n    expect(task.availableAt).toBeInstanceOf(Date);\n    expect(task.availableAt!.getTime()).toBeGreaterThan(Date.now());\n  });\n\n  it('should calculate exponential backoff correctly', () => {\n    const task = q.add('job', { backoffDelay: 1000 });\n\n    // Attempt 1: 1000 * 2^0 = 1000ms delay\n    q.getNext();\n    q.fail(task.id);\n    const t1Delay = task.availableAt!.getTime() - Date.now();\n    expect(Math.abs(t1Delay - 1000)).toBeLessThan(50);\n\n    // Attempt 2: 1000 * 2^1 = 2000ms delay\n    // Manually set availableAt to past to simulate retry becoming available\n    // Actually let's make it available by setting availableAt to past\n    task.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    q.fail(task.id);\n    const t2Delay = task.availableAt!.getTime() - Date.now();\n    expect(Math.abs(t2Delay - 2000)).toBeLessThan(100);\n\n    // Attempt 3: 1000 * 2^2 = 4000ms delay\n    task.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    q.fail(task.id);\n    const t3Delay = task.availableAt!.getTime() - Date.now();\n    expect(Math.abs(t3Delay - 4000)).toBeLessThan(500);\n  });\n\n  it('should exhaust retries and leave task as failed', async () => {\n    const task = q.add('will-fail', { maxRetries: 2, backoffDelay: 10 });\n\n    // Attempt 1\n    q.getNext();\n    q.fail(task.id);\n\n    // maxRetries=2 means 2 retries = 3 total attempts\n    // Attempt 2\n    task.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    q.fail(task.id);\n\n    // Attempt 3 — still retrying (2 <= 2)\n    task.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    q.fail(task.id);\n\n    // After 3 attempts (initial + 2 retries), max retries = 2 means task should be failed\n    expect(task.status).toBe('failed');\n    expect(task.attempts).toBe(3);\n    expect(task.failedAt).toBeInstanceOf(Date);\n  });\n\n  it('should preserve original queue and priority on retry', () => {\n    const task = q.add('job', { queue: 'critical', priority: 1, maxRetries: 2, backoffDelay: 10 });\n    q.getNext('critical');\n    q.fail(task.id);\n\n    // Make it available and get it again\n    task.availableAt = new Date(Date.now() - 10);\n    const retried = q.getNext('critical');\n    expect(retried).not.toBeNull();\n    expect(retried!.id).toBe(task.id);\n    expect(retried!.priority).toBe(1);\n  });\n\n  it('should track number of attempts', () => {\n    const task = q.add('job', { maxRetries: 3, backoffDelay: 10 });\n\n    q.getNext();\n    expect(task.attempts).toBe(1);\n    q.fail(task.id);\n\n    task.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    expect(task.attempts).toBe(2);\n    q.fail(task.id);\n\n    task.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    expect(task.attempts).toBe(3);\n    q.fail(task.id);\n  });\n\n  it('should keep error information on failed task', () => {\n    const task = q.add('job', { maxRetries: 1, backoffDelay: 10 });\n    const err = new Error('Critical failure');\n\n    q.getNext();\n    q.fail(task.id, err);\n\n    task.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    q.fail(task.id, err);\n\n    expect(task.status).toBe('failed');\n    expect(task.error).toBeDefined();\n    expect(task.error!.message).toBe('Critical failure');\n  });\n});\n\n// =========================================================================\n// Phase 6: Dead Letter Queue\n// =========================================================================\n\ndescribe('Phase 6: Dead Letter Queue', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should move exhaustively-failed tasks to dead letter queue', () => {\n    const task = q.add('doomed', { maxRetries: 1, backoffDelay: 10 });\n\n    // Attempt 1\n    q.getNext();\n    q.fail(task.id);\n\n    // Attempt 2 (last)\n    task.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    q.fail(task.id);\n\n    // Task should be in DLQ\n    const dlq = q.viewDeadLetter();\n    expect(dlq.length).toBe(1);\n    expect(dlq[0].id).toBe(task.id);\n    expect(dlq[0].originalPayload).toBe('doomed');\n  });\n\n  it('should include error info and attempt count in DLQ entries', () => {\n    const task = q.add('fail', { maxRetries: 1, backoffDelay: 10 });\n    const err = new Error('Boom');\n\n    q.getNext();\n    q.fail(task.id, err);\n\n    task.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    q.fail(task.id, err);\n\n    const dlq = q.viewDeadLetter();\n    expect(dlq[0].error).toBeDefined();\n    expect(dlq[0].error!.message).toBe('Boom');\n    expect(dlq[0].attempts).toBe(2);\n    expect(dlq[0].failedAt).toBeInstanceOf(Date);\n  });\n\n  it('should support retrying a dead-lettered task', () => {\n    const task = q.add('retry-me', { maxRetries: 1, backoffDelay: 10 });\n\n    q.getNext();\n    q.fail(task.id);\n\n    task.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    q.fail(task.id);\n\n    // Should be in DLQ\n    expect(q.viewDeadLetter().length).toBe(1);\n\n    // Retry it\n    q.retryDeadLetter(task.id);\n    expect(q.viewDeadLetter().length).toBe(0);\n\n    // Should now be pending again\n    const retrieved = q.getNext();\n    expect(retrieved).not.toBeNull();\n    expect(retrieved!.id).toBe(task.id);\n    expect(retrieved!.status).toBe('processing');\n    expect(retrieved!.attempts).toBe(1);\n  });\n\n  it('should clear dead letter queue', () => {\n    const task = q.add('doomed', { maxRetries: 1, backoffDelay: 10 });\n\n    q.getNext();\n    q.fail(task.id);\n\n    task.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    q.fail(task.id);\n\n    expect(q.viewDeadLetter().length).toBe(1);\n    q.clearDeadLetter();\n    expect(q.viewDeadLetter().length).toBe(0);\n  });\n\n  it('should have independent DLQs per named queue', () => {\n    const t1 = q.add('a', { queue: 'q1', maxRetries: 1, backoffDelay: 10 });\n    const t2 = q.add('b', { queue: 'q2', maxRetries: 1, backoffDelay: 10 });\n\n    // Fail t1 in q1\n    q.getNext('q1');\n    q.fail(t1.id);\n    t1.availableAt = new Date(Date.now() - 10);\n    q.getNext('q1');\n    q.fail(t1.id);\n\n    // Fail t2 in q2\n    q.getNext('q2');\n    q.fail(t2.id);\n    t2.availableAt = new Date(Date.now() - 10);\n    q.getNext('q2');\n    q.fail(t2.id);\n\n    expect(q.viewDeadLetter('q1').length).toBe(1);\n    expect(q.viewDeadLetter('q2').length).toBe(1);\n    expect(q.viewDeadLetter('q1')[0].id).toBe(t1.id);\n    expect(q.viewDeadLetter('q2')[0].id).toBe(t2.id);\n  });\n});\n\n// =========================================================================\n// Phase 7: Task Dependencies\n// =========================================================================\n\ndescribe('Phase 7: Task Dependencies', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should create a task that depends on another', () => {\n    const dep = q.add('dependency');\n    const task = q.add('dependent', { dependsOn: [dep.id] });\n    expect(task.dependsOn).toEqual([dep.id]);\n    expect(task.status).toBe('blocked');\n  });\n\n  it('should not return blocked tasks from getNext', () => {\n    const dep = q.add('dependency');\n    q.add('dependent', { dependsOn: [dep.id] });\n\n    // Only the dependency should be available\n    expect(q.getNext()!.id).toBe(dep.id);\n    expect(q.getNext()).toBeNull();\n  });\n\n  it('should unblock tasks when their dependencies complete', () => {\n    const dep = q.add('dependency');\n    const task = q.add('dependent', { dependsOn: [dep.id] });\n\n    // Process and complete the dependency\n    q.getNext();\n    q.complete(dep.id);\n\n    // Dependent should now be unblocked\n    expect(task.status).toBe('pending');\n    const retrieved = q.getNext();\n    expect(retrieved).not.toBeNull();\n    expect(retrieved!.id).toBe(task.id);\n  });\n\n  it('should support multiple dependencies', () => {\n    const dep1 = q.add('dep1');\n    const dep2 = q.add('dep2');\n    const task = q.add('dependent', { dependsOn: [dep1.id, dep2.id] });\n    expect(task.status).toBe('blocked');\n\n    // Complete only dep1\n    q.getNext(); // gets dep1\n    q.complete(dep1.id);\n    expect(task.status).toBe('blocked');\n\n    q.getNext(); // gets dep2\n    q.complete(dep2.id);\n    expect(task.status).toBe('pending');\n  });\n\n  it('should detect circular dependencies', () => {\n    const a = q.add('a');\n    const b = q.add('b', { dependsOn: [a.id] });\n\n    // Trying to make a depend on b should create a cycle a -> b -> a\n    expect(() => q.add('circular', { dependsOn: [b.id] })).toThrow(/circular/i);\n  });\n\n  it('should detect indirect circular dependencies', () => {\n    const a = q.add('a');\n    const b = q.add('b', { dependsOn: [a.id] });\n    const c = q.add('c', { dependsOn: [b.id] });\n\n    // a -> b -> c, adding a depends on c creates a -> b -> c -> a cycle\n    expect(() => q.add('d', { dependsOn: [c.id] })).toThrow(/circular/i);\n  });\n\n  it('should error when depending on a non-existent task', () => {\n    expect(() => q.add('orphan', { dependsOn: ['non-existent'] })).toThrow(\n      /does not exist/i,\n    );\n  });\n\n  it('should not auto-fail dependents when a dependency fails', () => {\n    const dep = q.add('failing-dep', { maxRetries: 0 });\n    const task = q.add('dependent', { dependsOn: [dep.id] });\n\n    // Process and fail the dependency\n    q.getNext();\n    q.fail(dep.id, new Error('Oops'));\n\n    // Dependent should still be blocked\n    expect(task.status).toBe('blocked');\n    expect(q.getNext()).toBeNull();\n  });\n\n  it('should make immediately available if all deps already completed', () => {\n    const dep = q.add('dep');\n    q.getNext();\n    q.complete(dep.id);\n\n    const task = q.add('dependent', { dependsOn: [dep.id] });\n    expect(task.status).toBe('pending');\n    expect(q.getNext()!.id).toBe(task.id);\n  });\n\n  it('should support getTask to inspect task status', () => {\n    const dep = q.add('dep');\n    const task = q.add('dependent', { dependsOn: [dep.id] });\n\n    const fetched = q.getTask(task.id);\n    expect(fetched).toBeDefined();\n    expect(fetched!.status).toBe('blocked');\n    expect(fetched!.dependsOn).toEqual([dep.id]);\n  });\n\n  it('should return undefined for non-existent task', () => {\n    expect(q.getTask('non-existent')).toBeUndefined();\n  });\n});\n\n// =========================================================================\n// Phase 8: Concurrency Control\n// =========================================================================\n\ndescribe('Phase 8: Concurrency Control', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should have no concurrency limit by default', () => {\n    const info = q.getConcurrency();\n    expect(info.limit).toBeNull();\n  });\n\n  it('should set and enforce concurrency limit', () => {\n    q.setConcurrency(2);\n    q.add('a');\n    q.add('b');\n    q.add('c');\n\n    // First two should be available\n    expect(q.getNext()!.payload).toBe('a');\n    expect(q.getNext()!.payload).toBe('b');\n\n    // Third should be blocked by concurrency\n    expect(q.getNext()).toBeNull();\n  });\n\n  it('should free concurrency slot on complete', () => {\n    q.setConcurrency(1);\n    q.add('a');\n    q.add('b');\n\n    const t1 = q.getNext()!;\n    expect(t1.payload).toBe('a');\n\n    // Limit reached\n    expect(q.getNext()).toBeNull();\n\n    // Complete the first task\n    q.complete(t1.id);\n\n    // Second should now be available\n    expect(q.getNext()!.payload).toBe('b');\n  });\n\n  it('should free concurrency slot on fail', () => {\n    q.setConcurrency(1);\n    q.add('a');\n    q.add('b');\n\n    const t1 = q.getNext()!;\n    expect(q.getNext()).toBeNull();\n\n    q.fail(t1.id);\n    expect(q.getNext()!.payload).toBe('b');\n  });\n\n  it('should return correct active count', () => {\n    q.setConcurrency(3);\n    q.add('a');\n    q.add('b');\n\n    expect(q.getConcurrency().active).toBe(0);\n\n    q.getNext();\n    expect(q.getConcurrency().active).toBe(1);\n\n    q.getNext();\n    expect(q.getConcurrency().active).toBe(2);\n\n    q.complete(q.add('c').id); // add, get, complete in one shot\n    // Actually let's be cleaner\n  });\n\n  it('should respect priority ordering with concurrency', () => {\n    q.setConcurrency(1);\n    q.add('low', { priority: 10 });\n    q.add('high', { priority: 1 });\n\n    // High-priority should come first despite concurrency\n    expect(q.getNext()!.payload).toBe('high');\n  });\n\n  it('should work per named queue', () => {\n    q.setConcurrency(1, 'email');\n    q.add('a', { queue: 'email' });\n    q.add('b', { queue: 'email' });\n    q.add('c', { queue: 'report' }); // no limit on report\n\n    q.getNext('email'); // takes the slot\n    expect(q.getNext('email')).toBeNull();\n\n    // Report queue should be unaffected\n    expect(q.getNext('report')!.payload).toBe('c');\n  });\n\n  it('should reject invalid concurrency limit', () => {\n    expect(() => q.setConcurrency(0)).toThrow();\n    expect(() => q.setConcurrency(-1)).toThrow();\n    expect(() => q.setConcurrency(1.5)).toThrow();\n  });\n});\n\n// =========================================================================\n// Phase 9: Progress and Cancellation\n// =========================================================================\n\ndescribe('Phase 9: Progress and Cancellation', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  describe('Progress', () => {\n    it('should report and query progress on a processing task', () => {\n      const task = q.add('job');\n      q.getNext();\n\n      q.reportProgress(task.id, 50, 'halfway');\n      const progress = q.getProgress(task.id);\n      expect(progress).toBeDefined();\n      expect(progress!.progress).toBe(50);\n      expect(progress!.message).toBe('halfway');\n    });\n\n    it('should accept progress without a message', () => {\n      const task = q.add('job');\n      q.getNext();\n\n      q.reportProgress(task.id, 75);\n      const progress = q.getProgress(task.id);\n      expect(progress!.progress).toBe(75);\n      expect(progress!.message).toBeUndefined();\n    });\n\n    it('should reject progress on non-processing tasks', () => {\n      const task = q.add('job');\n      expect(() => q.reportProgress(task.id, 50)).toThrow();\n    });\n\n    it('should reject out-of-range progress values', () => {\n      const task = q.add('job');\n      q.getNext();\n      expect(() => q.reportProgress(task.id, -1)).toThrow();\n      expect(() => q.reportProgress(task.id, 101)).toThrow();\n    });\n\n    it('should return null progress for tasks that never reported', () => {\n      const task = q.add('job');\n      q.getNext();\n      expect(q.getProgress(task.id)).toBeNull();\n    });\n\n    it('should return null for non-existent task progress', () => {\n      expect(q.getProgress('non-existent')).toBeNull();\n    });\n\n    it('should support subscribing to progress updates', () => {\n      const task = q.add('job');\n      q.getNext();\n\n      const updates: Array<{ progress: number; message?: string }> = [];\n      const unsubscribe = q.onProgress(task.id, (p, msg) => {\n        updates.push({ progress: p, message: msg });\n      });\n\n      q.reportProgress(task.id, 25, 'quarter');\n      q.reportProgress(task.id, 50, 'half');\n      q.reportProgress(task.id, 100, 'done');\n\n      expect(updates.length).toBe(3);\n      expect(updates[0]).toEqual({ progress: 25, message: 'quarter' });\n      expect(updates[1]).toEqual({ progress: 50, message: 'half' });\n      expect(updates[2]).toEqual({ progress: 100, message: 'done' });\n    });\n\n    it('should stop notifying after unsubscribe', () => {\n      const task = q.add('job');\n      q.getNext();\n\n      const updates: number[] = [];\n      const unsubscribe = q.onProgress(task.id, (p) => {\n        updates.push(p);\n      });\n\n      q.reportProgress(task.id, 25);\n      unsubscribe();\n      q.reportProgress(task.id, 50);\n\n      expect(updates).toEqual([25]);\n    });\n  });\n\n  describe('Cancellation', () => {\n    it('should cancel a pending task', () => {\n      const task = q.add('pending-job');\n      expect(q.getWaitingCount()).toBe(1);\n\n      const cancelled = q.cancel(task.id);\n      expect(cancelled).toBe(true);\n      expect(task.status).toBe('cancelled');\n      expect(task.cancelledAt).toBeInstanceOf(Date);\n      expect(q.getWaitingCount()).toBe(0);\n      expect(q.getNext()).toBeNull();\n    });\n\n    it('should cancel a processing task', () => {\n      const task = q.add('processing-job');\n      q.getNext();\n\n      const cancelled = q.cancel(task.id);\n      expect(cancelled).toBe(true);\n      expect(task.status).toBe('cancelled');\n    });\n\n    it('should cancel a blocked task', () => {\n      const dep = q.add('dep');\n      const task = q.add('dependent', { dependsOn: [dep.id] });\n      expect(task.status).toBe('blocked');\n\n      const cancelled = q.cancel(task.id);\n      expect(cancelled).toBe(true);\n      expect(task.status).toBe('cancelled');\n    });\n\n    it('should return false for non-existent task', () => {\n      expect(q.cancel('non-existent')).toBe(false);\n    });\n\n    it('should return false for already completed task', () => {\n      const task = q.add('job');\n      q.getNext();\n      q.complete(task.id);\n      expect(q.cancel(task.id)).toBe(false);\n    });\n\n    it('should skip previously cancelled task on retry', () => {\n      const task = q.add('job');\n      q.cancel(task.id);\n      // Ensure cancelled tasks are not retried\n      expect(task.status).toBe('cancelled');\n      expect(q.getNext()).toBeNull();\n    });\n  });\n});\n\n// =========================================================================\n// Phase 10: Recurring Tasks\n// =========================================================================\n\ndescribe('Phase 10: Recurring Tasks', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should add and list schedules', () => {\n    q.addSchedule('every5', '*/5 * * * *', { job: 'cleanup' }, 'maintenance');\n    const schedules = q.listSchedules();\n    expect(schedules.length).toBe(1);\n    expect(schedules[0].name).toBe('every5');\n    expect(schedules[0].cron).toBe('*/5 * * * *');\n    expect(schedules[0].queue).toBe('maintenance');\n    expect(schedules[0].lastRun).toBeNull();\n  });\n\n  it('should enqueue tasks on tick when schedule is due', () => {\n    // Use a cron that matches every minute\n    q.addSchedule('everymin', '* * * * *', { job: 'tick' });\n\n    expect(q.getWaitingCount()).toBe(0);\n    q.tick();\n    expect(q.getWaitingCount()).toBe(1);\n\n    const task = q.getNext();\n    expect(task).not.toBeNull();\n    expect(task!.payload).toEqual({ job: 'tick' });\n  });\n\n  it('should not enqueue duplicate tasks on repeated tick within same minute', () => {\n    q.addSchedule('everymin', '* * * * *', { job: 'tick' });\n\n    // Set lastRun to now\n    const schedules = q.listSchedules();\n\n    q.tick();\n    expect(q.getWaitingCount()).toBe(1);\n    q.tick();\n    // No duplicate\n    expect(q.getWaitingCount()).toBe(1);\n  });\n\n  it('should remove a schedule', () => {\n    q.addSchedule('test', '*/5 * * * *', {});\n    expect(q.listSchedules().length).toBe(1);\n\n    const removed = q.removeSchedule('test');\n    expect(removed).toBe(true);\n    expect(q.listSchedules().length).toBe(0);\n  });\n\n  it('should have schedules listed with nextRun info', () => {\n    q.addSchedule('hourly', '0 * * * *', {});\n    const schedules = q.listSchedules();\n    expect(schedules[0].nextRun).toBeInstanceOf(Date);\n  });\n\n  it('should reject duplicate schedule names', () => {\n    q.addSchedule('dup', '* * * * *', {});\n    expect(() => q.addSchedule('dup', '*/5 * * * *', {})).toThrow(/already exists/i);\n  });\n\n  it('should enqueue tasks as regular tasks subject to all rules', () => {\n    q.setConcurrency(1);\n    q.addSchedule('everymin', '* * * * *', { job: 'tick' });\n\n    q.tick();\n    q.tick(); // Should not add duplicate\n    expect(q.getWaitingCount()).toBe(1);\n\n    // It's a regular task - can be retrieved\n    const task = q.getNext();\n    expect(task).not.toBeNull();\n    expect(q.getNext()).toBeNull(); // concurrency limit\n  });\n});\n\n// =========================================================================\n// Phase 11: Middleware\n// =========================================================================\n\ndescribe('Phase 11: Middleware Pipeline', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should register and run middleware in order', async () => {\n    const order: string[] = [];\n\n    q.use((_task, next) => {\n      order.push('first');\n      next();\n    });\n\n    q.use((_task, next) => {\n      order.push('second');\n      next();\n    });\n\n    q.process((_task) => {\n      order.push('handler');\n    });\n\n    const task = q.add('test');\n    q.getNext();\n    await q.processTask(task.id);\n\n    expect(order).toEqual(['first', 'second', 'handler']);\n  });\n\n  it('should allow middleware to skip processing by not calling next', async () => {\n    const order: string[] = [];\n\n    q.use((_task, next) => {\n      order.push('first');\n      next();\n    });\n\n    q.use((_task, _next) => {\n      order.push('second');\n      // Don't call next - stops the chain\n    });\n\n    q.process((_task) => {\n      order.push('handler');\n    });\n\n    const task = q.add('test');\n    q.getNext();\n    await q.processTask(task.id);\n\n    expect(order).toEqual(['first', 'second']);\n    expect(task.status).toBe('processing');\n  });\n\n  it('should allow middleware to modify task payload', async () => {\n    q.use((task, next) => {\n      (task.payload as Record<string, unknown>).modified = true;\n      next();\n    });\n\n    q.process((task) => {\n      expect((task.payload as Record<string, unknown>).modified).toBe(true);\n    });\n\n    const task = q.add({ data: 'original' });\n    q.getNext();\n    await q.processTask(task.id);\n  });\n\n  it('should mark task as failed if middleware throws', async () => {\n    q.use((_task, _next) => {\n      throw new Error('Middleware error');\n    });\n\n    q.process((_task) => {\n      // Should not reach here\n    });\n\n    const task = q.add('test');\n    q.getNext();\n    await q.processTask(task.id);\n\n    expect(task.status).toBe('failed');\n    expect(task.error?.message).toBe('Middleware error');\n  });\n\n  it('should mark task as failed if handler throws', async () => {\n    q.process((_task) => {\n      throw new Error('Handler error');\n    });\n\n    const task = q.add('test');\n    q.getNext();\n    await q.processTask(task.id);\n\n    expect(task.status).toBe('failed');\n    expect(task.error?.message).toBe('Handler error');\n  });\n\n  it('should have per-queue middleware isolation', async () => {\n    const order: string[] = [];\n\n    q.use((_task, next) => {\n      order.push('default');\n      next();\n    }, 'default');\n\n    q.use((_task, next) => {\n      order.push('custom');\n      next();\n    }, 'custom');\n\n    q.process((_task) => {\n      order.push('handler');\n    }, 'custom');\n\n    const task = q.add('test', { queue: 'custom' });\n    q.getNext('custom');\n    await q.processTask(task.id);\n\n    // Only custom middleware runs, not default\n    expect(order).toEqual(['custom', 'handler']);\n  });\n\n  it('should do nothing if no middleware or handler registered', async () => {\n    const task = q.add('test');\n    q.getNext();\n\n    // Should not throw\n    await q.processTask(task.id);\n    expect(task.status).toBe('processing');\n  });\n});\n\n// =========================================================================\n// Phase 12: Graceful Shutdown\n// =========================================================================\n\ndescribe('Phase 12: Graceful Shutdown', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should stop accepting new tasks after shutdown', async () => {\n    await q.shutdown();\n    expect(() => q.add('new-task')).toThrow(/shutting down/i);\n  });\n\n  it('should complete immediately when no tasks are processing', async () => {\n    const result = await q.shutdown();\n    expect(result.duration).toBeLessThan(100);\n    expect(result.completed).toBe(0);\n    expect(result.cancelled).toBe(0);\n  });\n\n  it('should wait for processing tasks to finish', async () => {\n    const task = q.add('job');\n    q.getNext();\n\n    // Start shutdown but don't await yet\n    const shutdownPromise = q.shutdown(5000);\n\n    // Complete the processing task\n    q.complete(task.id);\n\n    const result = await shutdownPromise;\n    expect(result.completed).toBeGreaterThanOrEqual(1);\n  });\n\n  it('should force-cancel processing tasks after timeout', async () => {\n    q.setConcurrency(2);\n    q.add('job');\n    q.add('job2');\n    q.getNext();\n    q.getNext();\n\n    // Shutdown with very short timeout\n    const result = await q.shutdown(10);\n\n    expect(result.cancelled).toBe(2);\n  });\n\n  it('should be idempotent when called multiple times', async () => {\n    const result1 = await q.shutdown(100);\n    const result2 = await q.shutdown(100);\n\n    expect(result1.duration).toBe(result2.duration);\n    expect(result1.completed).toBe(result2.completed);\n    expect(result1.cancelled).toBe(result2.cancelled);\n  });\n\n  it('should fire shutdown callbacks', async () => {\n    const callback = vi.fn();\n    q.onShutdown(callback);\n\n    await q.shutdown();\n    expect(callback).toHaveBeenCalledTimes(1);\n  });\n\n  it('should handle multiple shutdown callbacks', async () => {\n    const cb1 = vi.fn();\n    const cb2 = vi.fn();\n    q.onShutdown(cb1);\n    q.onShutdown(cb2);\n\n    await q.shutdown();\n    expect(cb1).toHaveBeenCalledTimes(1);\n    expect(cb2).toHaveBeenCalledTimes(1);\n  });\n\n  it('should return shutdown result with all fields', async () => {\n    const result = await q.shutdown();\n    expect(result).toHaveProperty('completed');\n    expect(result).toHaveProperty('cancelled');\n    expect(result).toHaveProperty('duration');\n  });\n\n  it('should not return tasks from getNext after shutdown', async () => {\n    q.add('orphan');\n    await q.shutdown();\n    expect(q.getNext()).toBeNull();\n  });\n});\n\n// =========================================================================\n// Integration: Cross-phase interactions\n// =========================================================================\n\ndescribe('Cross-phase Integration', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should combine priority, named queues, and delays', () => {\n    q.add('urgent-email', { queue: 'email', priority: 1 });\n    q.add('later-email', { queue: 'email', priority: 5, delay: 5000 });\n    q.add('normal-email', { queue: 'email', priority: 5 });\n\n    // Urgent first, then normal, then later (but later is delayed, so null)\n    expect(q.getNext('email')!.payload).toBe('urgent-email');\n    expect(q.getNext('email')!.payload).toBe('normal-email');\n    expect(q.getNext('email')).toBeNull();\n  });\n\n  it('should combine dependencies with retry', () => {\n    const dep = q.add('producer', { maxRetries: 1, backoffDelay: 10 });\n    const task = q.add('consumer', { dependsOn: [dep.id] });\n\n    // Process and fail the dependency\n    q.getNext();\n    q.fail(dep.id, new Error('transient'));\n\n    // Dependency retries, consumer stays blocked\n    expect(dep.status).toBe('pending');\n    expect(task.status).toBe('blocked');\n\n    // Dependency retry succeeds\n    dep.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    q.complete(dep.id);\n\n    // Consumer should now be unblocked\n    expect(task.status).toBe('pending');\n  });\n\n  it('should combine middleware with concurrency and progress', async () => {\n    q.setConcurrency(1);\n    q.use((t, next) => {\n      (t.payload as Record<string, unknown>).middlewareRan = true;\n      next();\n    });\n\n    const order: string[] = [];\n    q.process(async (t) => {\n      order.push('handler');\n      q.reportProgress(t.id, 50, 'mid');\n      q.complete(t.id);\n    });\n\n    const task = q.add({ data: 'test' });\n    q.getNext();\n    await q.processTask(task.id);\n\n    expect((task.payload as Record<string, unknown>).middlewareRan).toBe(true);\n    expect(order).toEqual(['handler']);\n    expect(task.status).toBe('completed');\n    const progress = q.getProgress(task.id);\n    expect(progress!.progress).toBe(50);\n  });\n\n  it('should combine recu