+
+  it('should move exhaustively-failed tasks to dead letter queue', () => {
+    const task = q.add('doomed', { maxRetries: 1, backoffDelay: 10 });
+
+    // Attempt 1
+    q.getNext();
+    q.fail(task.id);
+
+    // Attempt 2 (still has retry: 1 <= 1)
+    task.availableAt = new Date(Date.now() - 10);
+    q.getNext();
+    q.fail(task.id);
+
+    // No more retries
+    expect(task.status).toBe('failed');
+
+    // Task should be in DLQ
+    const dlq = q.viewDeadLetter();
+    expect(dlq.length).toBe(1);
+    expect(dlq[0].id).toBe(task.id);
+    expect(dlq[0].originalPayload).toBe('doomed');
+  });
+
+  it('should include error info and attempt count in DLQ entries', () => {
+    const task = q.add('fail', { maxRetries: 1, backoffDelay: 10 });
+    const err = new Error('Boom');
+
+    q.getNext();
+    q.fail(task.id, err);
+
+    task.availableAt = new Date(Date.now() - 10);
+    q.getNext();
+    q.fail(task.id, err);
+
+    const dlq = q.viewDeadLetter();
+    expect(dlq[0].error).toBeDefined();
+    expect(dlq[0].error!.message).toBe('Boom');
+    expect(dlq[0].attempts).toBe(2);
+    expect(dlq[0].failedAt).toBeInstanceOf(Date);
+  });
+
+  it('should support retrying a dead-lettered task', () => {
+    const task = q.add('retry-me', { maxRetries: 1, backoffDelay: 10 });
+
+    q.getNext();
+    q.fail(task.id);
+
+    task.availableAt = new Date(Date.now() - 10);
+    q.getNext();
+    q.fail(task.id);
+
+    // Should be in DLQ
+    expect(q.viewDeadLetter().length).toBe(1);
+
+    // Retry it
+    q.retryDeadLetter(task.id);
+    expect(q.viewDeadLetter().length).toBe(0);
+
+    // Should now be pending again
+    const retrieved = q.getNext();
+    expect(retrieved).not.toBeNull();
+    expect(retrieved!.id).toBe(task.id);
+    expect(retrieved!.status).toBe('processing');
+    expect(retrieved!.attempts).toBe(1);
+  });
+
+  it('should clear dead letter queue', () => {
