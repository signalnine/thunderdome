+describe('Edge Cases', () => {
+  let q: TaskQueueSystem;
+
+  beforeEach(() => {
+    q = new TaskQueueSystem();
+  });
+
+  it('should handle zero retries', () => {
+    const task = q.add('no-retry', { maxRetries: 0 });
+    q.getNext();
+    q.fail(task.id, new Error('fail'));
+    expect(task.status).toBe('failed');
+  });
+
+  it('should handle empty payload', () => {
+    const task = q.add(undefined);
+    expect(task).toBeDefined();
+    expect(task.payload).toBeUndefined();
+  });
+
+  it('should handle tasks with delay of 0', () => {
+    const task = q.add('zero-delay', { delay: 0 });
+    expect(task.availableAt).toBeInstanceOf(Date);
+    // Should be immediately available (or close to it)
+    expect(q.getNext()!.payload).toBe('zero-delay');
+  });
+
+  it('should maintain large numbers of tasks', () => {
+    for (let i = 0; i < 100; i++) {
+      q.add(`task-${i}`);
+    }
+    expect(q.getWaitingCount()).toBe(100);
+
+    for (let i = 0; i < 100; i++) {
+      const task = q.getNext();
+      expect(task!.payload).toBe(`task-${i}`);
+    }
+    expect(q.getNext()).toBeNull();
+  });
+
+  it('should mix priorities with large batch', () => {
+    for (let i = 0; i < 50; i++) {
+      q.add(`low-${i}`, { priority: 10 });
+      q.add(`high-${i}`, { priority: 1 });
+    }
+
+    // First 50 should be all high priority
+    for (let i = 0; i < 50; i++) {
+      expect(q.getNext()!.payload).toBe(`high-${i}`);
+    }
+    // Next 50 should be all low priority (FIFO within priority)
+    for (let i = 0; i < 50; i++) {
+      expect(q.getNext()!.payload).toBe(`low-${i}`);
+    }
+  });
+
+  it('should clean up queue-specific things when cancelling a dependent task', () => {
+    const dep = q.add('dep');
+    const task = q.add('dependent', { dependsOn: [dep.id] });
+
+    // Cancel the dependent
+    q.cancel(task.id);
+    expect(task.status).toBe('cancelled');
+
+    // Complete the dependency
+    q.getNext();
+    q.complete(dep.id);
+
+    // The cancelled dependent should not appear
+    expect(q.getNext()).toBeNull();
+  });
+
+  it('should provide independent shutdown per instance', async () => {
+    const q1 = new TaskQueueSystem();
+    const q2 = new TaskQueueSystem();
+
+    q1.add('a');
+    q2.add('b');
+
+    await q1.shutdown();
+
+    // q1 should reject new tasks
+    expect(() => q1.add('c')).toThrow();
+
+    // q2 should still accept tasks
+    q2.add('d');
+    expect(q2.getNext()!.payload).toBe('b');
+    expect(q2.getNext()!.payload).toBe('d');
+  });
+});
