@@ -0,0 +1,110 @@
+/**
+ * Simple cron expression parser and checker.
+ * Supports a subset of cron expressions with 5 fields:
+ *   minute, hour, day-of-month, month, day-of-week
+ */
+
+export interface ParsedCron {
+  minute: number[];
+  hour: number[];
+  dayOfMonth: number[];
+  month: number[];
+  dayOfWeek: number[];
+}
+
+/**
+ * Parse a cron expression into its field components.
+ */
+export function parseCron(expression: string): ParsedCron {
+  const parts = expression.trim().split(/\s+/);
+  if (parts.length !== 5) {
+    throw new Error(
+      `Invalid cron expression: "${expression}". Expected 5 fields, got ${parts.length}.`,
+    );
+  }
+
+  return {
+    minute: parseField(parts[0], 0, 59),
+    hour: parseField(parts[1], 0, 23),
+    dayOfMonth: parseField(parts[2], 1, 31),
+    month: parseField(parts[3], 1, 12),
+    dayOfWeek: parseField(parts[4], 0, 6),
+  };
+}
+
+/**
+ * Parse a single cron field.
+ */
+function parseField(field: string, min: number, max: number): number[] {
+  // Handle step values: */N
+  if (field.startsWith('*/')) {
+    const step = parseInt(field.slice(2), 10);
+    if (isNaN(step) || step < 1) {
+      throw new Error(
+        `Invalid cron step value: "${field}". Step must be >= 1.`,
+      );
+    }
+    const values: number[] = [];
+    for (let i = min; i <= max; i += step) {
+      values.push(i);
+    }
+    return values;
+  }
+
+  // Handle wildcard
+  if (field === '*') {
+    const values: number[] = [];
+    for (let i = min; i <= max; i++) {
+      values.push(i);
+    }
+    return values;
+  }
+
+  // Handle single value
+  const num = parseInt(field, 10);
+  if (isNaN(num) || num < min || num > max) {
+    throw new Error(
+      `Invalid cron field value: "${field}". Expected ${min}-${max}.`,
+    );
+  }
+  return [num];
+}
+
+/**
+ * Check if a parsed cron expression matches the given date.
+ */
+export function matchesCron(parsed: ParsedCron, date: Date): boolean {
+  return (
+    parsed.minute.includes(date.getMinutes()) &&
+    parsed.hour.includes(date.getHours()) &&
+    parsed.dayOfMonth.includes(date.getDate()) &&
+    parsed.month.includes(date.getMonth() + 1) && // cron months are 1-based
+    parsed.dayOfWeek.includes(date.getDay())
+  );
+}
+
+/**
+ * Get the next matching time after the given date for a cron expression.
+ */
+export function getNextMatch(
+  parsed: ParsedCron,
+  after: Date,
+): Date {
+  // Start checking from the next minute
+  const candidate = new Date(after.getTime() + 60000);
+  candidate.setSeconds(0);
+  candidate.setMilliseconds(0);
+
+  // Check up to 2 years ahead (safety limit)
+  const limit = new Date(after);
+  limit.setFullYear(limit.getFullYear() + 2);
+
+  while (candidate <= limit) {
+    if (matchesCron(parsed, candidate)) {
+      return candidate;
+    }
+    candidate.setMinutes(candidate.getMinutes() + 1);
+  }
+
+  throw new Error('No matching cron time found within 2 years');
+}
