.status).toBe('cancelled');\n\n    // Complete the dependency\n    q.getNext();\n    q.complete(dep.id);\n\n    // The cancelled dependent should not appear\n    expect(q.getNext()).toBeNull();\n  });\n\n  it('should provide independent shutdown per instance', async () => {\n    const q1 = new TaskQueueSystem();\n    const q2 = new TaskQueueSystem();\n\n    q1.add('a');\n    q2.add('b');\n\n    await q1.shutdown();\n\n    // q1 should reject new tasks\n    expect(() => q1.add('c')).toThrow();\n\n    // q2 should still accept tasks\n    q2.add('d');\n    expect(q2.getNext()!.payload).toBe('b');\n    expect(q2.getNext()!.payload).toBe('d');\n  });\n});\n","structuredPatch":[{"oldStart":1342,"oldLines":6,"newStart":1342,"newLines":9,"lines":["     // Schedule uses a cron that matches every minute","     q.addSchedule('gen', '* * * * *', { generated: true });"," ","+    // Consume the seed task so only the tick task remains","+    q.getNext();","+","     q.tick();"," ","     // The tick task should be enqueued as a regular task, independent from dependencies"]}],"userModified":false,"replaceAll":false}}
