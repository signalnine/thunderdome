ync () => {\n    q.add('orphan');\n    await q.shutdown();\n    expect(q.getNext()).toBeNull();\n  });\n});\n\n// =========================================================================\n// Integration: Cross-phase interactions\n// =========================================================================\n\ndescribe('Cross-phase Integration', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQueueSystem();\n  });\n\n  it('should combine priority, named queues, and delays', () => {\n    q.add('urgent-email', { queue: 'email', priority: 1 });\n    q.add('later-email', { queue: 'email', priority: 5, delay: 5000 });\n    q.add('normal-email', { queue: 'email', priority: 5 });\n\n    // Urgent first, then normal, then later (but later is delayed, so null)\n    expect(q.getNext('email')!.payload).toBe('urgent-email');\n    expect(q.getNext('email')!.payload).toBe('normal-email');\n    expect(q.getNext('email')).toBeNull();\n  });\n\n  it('should combine dependencies with retry', () => {\n    const dep = q.add('producer', { maxRetries: 1, backoffDelay: 10 });\n    const task = q.add('consumer', { dependsOn: [dep.id] });\n\n    // Process and fail the dependency\n    q.getNext();\n    q.fail(dep.id, new Error('transient'));\n\n    // Dependency retries, consumer stays blocked\n    expect(dep.status).toBe('pending');\n    expect(task.status).toBe('blocked');\n\n    // Dependency retry succeeds\n    dep.availableAt = new Date(Date.now() - 10);\n    q.getNext();\n    q.complete(dep.id);\n\n    // Consumer should now be unblocked\n    expect(task.status).toBe('pending');\n  });\n\n  it('should combine middleware with concurrency and progress', async () => {\n    q.setConcurrency(1);\n    q.use((t, next) => {\n      (t.payload as Record<string, unknown>).middlewareRan = true;\n      next();\n    });\n\n    const order: string[] = [];\n    q.process(async (t) => {\n      order.push('handler');\n      q.reportProgress(t.id, 50, 'mid');\n      q.complete