+describe('Phase 12: Graceful Shutdown', () => {
+  let q: TaskQueueSystem;
+
+  beforeEach(() => {
+    q = new TaskQueueSystem();
+  });
+
+  it('should stop accepting new tasks after shutdown', async () => {
+    await q.shutdown();
+    expect(() => q.add('new-task')).toThrow(/shutting down/i);
+  });
+
+  it('should complete immediately when no tasks are processing', async () => {
+    const result = await q.shutdown();
+    expect(result.duration).toBeLessThan(100);
+    expect(result.completed).toBe(0);
+    expect(result.cancelled).toBe(0);
+  });
+
+  it('should wait for processing tasks to finish', async () => {
+    const task = q.add('job');
+    q.getNext();
+
+    // Start shutdown but don't await yet
+    const shutdownPromise = q.shutdown(5000);
+
+    // Complete the processing task
+    q.complete(task.id);
+
+    const result = await shutdownPromise;
+    expect(result.completed).toBeGreaterThanOrEqual(1);
+  });
+
+  it('should force-cancel processing tasks after timeout', async () => {
+    q.setConcurrency(2);
+    q.add('job');
+    q.add('job2');
+    q.getNext();
+    q.getNext();
+
+    // Shutdown with very short timeout
+    const result = await q.shutdown(10);
+
+    expect(result.cancelled).toBe(2);
+  });
+
+  it('should be idempotent when called multiple times', async () => {
+    const result1 = await q.shutdown(100);
+    const result2 = await q.shutdown(100);
+
+    expect(result1.duration).toBe(result2.duration);
+    expect(result1.completed).toBe(result2.completed);
+    expect(result1.cancelled).toBe(result2.cancelled);
+  });
+
+  it('should fire shutdown callbacks', async () => {
+    const callback = vi.fn();
+    q.onShutdown(callback);
+
+    await q.shutdown();
+    expect(callback).toHaveBeenCalledTimes(1);
+  });
+
+  it('should handle multiple shutdown callbacks', async () => {
+    const cb1 = vi.fn();
+    const cb2 = vi.fn();
+    q.onShutdown(cb1);
+    q.onShutdown(cb2);
+
+    await q.shutdown();
+    expect(cb1).toHaveBeenCalledTimes(1);
+    expect(cb2).toHaveBeenCalledTimes(1);
+  });
+
+  it('should return shutdown result with all fields', async () => {
+    const result = await q.shutdown();
+    expect(result).toHaveProperty('completed');
+    expect(result).toHaveProperty('cancelled');
+    expect(result).toHaveProperty('duration');
+  });
+
+  it('should not return tasks from getNext after shutdown', async () => {
+    q.add('orphan');
+    await q.shutdown();
+    expect(q.getNext()).toBeNull();
+  });
+});
