QueueMap.get(taskId);\n543\t    if (!queueName) throw new Error(`Task \"${taskId}\" not found.`);\n544\t\n545\t    const q = this.getQueue(queueName);\n546\t    if (!q) throw new Error(`Queue \"${queueName}\" not found.`);\n547\t\n548\t    // Look in active tasks\n549\t    const task =\n550\t      q.activeTasks.get(taskId) ?? q.tasks.find((t) => t.id === taskId);\n551\t    if (!task) throw new Error(`Task \"${taskId}\" not found.`);\n552\t\n553\t    if (task.status !== 'processing') {\n554\t      throw new Error(\n555\t        `Cannot report progress on a task with status \"${task.status}\".`,\n556\t      );\n557\t    }\n558\t\n559\t    task.progress = progress;\n560\t    task.progressMessage = message ?? null;\n561\t\n562\t    // Notify subscribers\n563\t    const subscribers = q.progressSubscribers.get(taskId);\n564\t    if (subscribers) {\n565\t      for (const cb of subscribers) {\n566\t        try {\n567\t          cb(progress, message);\n568\t        } catch {\n569\t          // Swallow subscriber errors\n570\t        }\n571\t      }\n572\t    }\n573\t  }\n574\t\n575\t  getProgress(taskId: string): TaskProgress | null {\n576\t    const queueName = this.taskQueueMap.get(taskId);\n577\t    if (!queueName) return null;\n578\t\n579\t    const q = this.getQueue(queueName);\n580\t    if (!q) return null;\n581\t\n582\t    const task =\n583\t      q.activeTasks.get(taskId) ?? q.tasks.find((t) => t.id === taskId);\n584\t    if (!task || task.progress === null) return null;\n585\t\n586\t    return {\n587\t      progress: task.progress,\n588\t      ...(task.progressMessage ? { message: task.progressMessage } : {}),\n589\t    };\n590\t  }\n591\t\n592\t  onProgress(\n593\t    taskId: string,\n594\t    callback: ProgressCallback,\n595\t  ): () => void {\n596\t    const queueName = this.taskQueueMap.get(taskId);\n597\t    if (!queueName) throw new Error(`Task \"${taskId}\" not found.`);\n598\t\n599\t    const q = this.getOrCreateQueue(queueName);\n600\t\n601\t    let subs = 