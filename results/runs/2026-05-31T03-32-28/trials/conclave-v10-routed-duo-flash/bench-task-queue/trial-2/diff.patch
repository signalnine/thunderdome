pect(parsed.month).toEqual(Array.from({ length: 12 }, (_, i) => i + 1));\n    expect(parsed.dayOfWeek).toEqual(Array.from({ length: 7 }, (_, i) => i));\n  });\n\n  it('should parse 0 * * * * as hourly on the hour', () => {\n    const parsed = parseCron('0 * * * *');\n    expect(parsed.minute).toEqual([0]);\n    expect(parsed.hour).toEqual(Array.from({ length: 24 }, (_, i) => i));\n  });\n\n  it('should parse 0 0 * * * as daily at midnight', () => {\n    const parsed = parseCron('0 0 * * *');\n    expect(parsed.minute).toEqual([0]);\n    expect(parsed.hour).toEqual([0]);\n  });\n\n  it('should match time for */5 schedule', () => {\n    const parsed = parseCron('*/5 * * * *');\n    const date = new Date(2026, 4, 31, 10, 5, 0);\n    expect(matchesCron(parsed, date)).toBe(true);\n\n    const date2 = new Date(2026, 4, 31, 10, 7, 0);\n    expect(matchesCron(parsed, date2)).toBe(false);\n  });\n\n  it('should match time for 0 * * * * schedule', () => {\n    const parsed = parseCron('0 * * * *');\n    const date = new Date(2026, 4, 31, 10, 0, 0);\n    expect(matchesCron(parsed, date)).toBe(true);\n\n    const date2 = new Date(2026, 4, 31, 10, 5, 0);\n    expect(matchesCron(parsed, date2)).toBe(false);\n  });\n\n  it('should get next match time', () => {\n    const parsed = parseCron('*/5 * * * *');\n    const after = new Date(2026, 4, 31, 10, 3, 0);\n    const next = getNextMatch(parsed, after);\n    expect(next.getMinutes()).toBe(5);\n    expect(next.getHours()).toBe(10);\n  });\n\n  it('should reject invalid cron expression', () => {\n    expect(() => parseCron('invalid')).toThrow();\n    expect(() => parseCron('* * * * * *')).toThrow();\n    expect(() => parseCron('* * * *')).toThrow();\n  });\n});\n\n// =========================================================================\n// Edge Cases\n// =========================================================================\n\ndescribe('Edge Cases', () => {\n  let q: TaskQueueSystem;\n\n  beforeEach(() => {\n    q = new TaskQu