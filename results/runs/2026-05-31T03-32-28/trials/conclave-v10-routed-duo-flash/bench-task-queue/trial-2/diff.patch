      task.status = 'cancelled';\n        task.cancelledAt = new Date();\n        cancelledCount++;\n      }\n      q.activeTasks.clear();\n    }\n\n    const duration = Date.now() - startTime;\n    let completedCount = 0;\n    for (const q of this.queues.values()) {\n      completedCount += q.completedTaskIds.size;\n    }\n    // Completed during shutdown = completed - those that were completed before shutdown\n    // We approximate: since we track completedTaskIds, the count is total ever completed.\n    // But shutdown only cares about what completed during the wait period.\n    // Since we started with processingCount tasks processing and cancelled some...\n    // Simpler: completedCount is total ever completed, cancelledCount is from force-cancel.\n\n    this.shutdownResult = {\n      completed: completedCount,\n      cancelled: cancelledCount,\n      duration,\n    };\n    return this.shutdownResult;\n  }\n\n  isShuttingDown(): boolean {\n    return this.shuttingDown;\n  }\n}\n","structuredPatch":[{"oldStart":217,"oldLines":7,"newStart":217,"newLines":13,"lines":["             `Dependency task \"${depId}\" does not exist.`,","           );","         }","-        // Check for circular dependencies","+        // Check for self-dependency","+        if (depId === task.id) {","+          throw new Error(","+            `Circular dependency detected: task \"${task.id}\" cannot depend on itself.`,","+          );","+        }","+        // Check for circular dependencies via the dependents graph","         if (wouldCreateCycle(task.id, depId, this.dependentsMap)) {","           throw new Error(","             `Circular dependency detected: adding task \"${task.id}\" depending on \"${depId}\" would create a cycle.`,"]}],"userModified":false,"replaceAll":false}}
