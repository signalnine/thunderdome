>= q.concurrencyLimit\n269\t    ) {\n270\t      return null;\n271\t    }\n272\t\n273\t    const now = new Date();\n274\t\n275\t    // Find the first available task among pending (not delayed, not blocked)\n276\t    // Sort candidates by priority (asc), then availableAt (asc nulls first), then createdAt (asc)\n277\t    const candidates = q.tasks.filter(\n278\t      (t) =>\n279\t        t.status === 'pending' &&\n280\t        t.dependsOn.length === 0 &&\n281\t        (!t.availableAt || t.availableAt <= now),\n282\t    );\n283\t\n284\t    if (candidates.length === 0) return null;\n285\t\n286\t    candidates.sort((a, b) => {\n287\t      // Priority first (lower number = higher priority)\n288\t      if (a.priority !== b.priority) return a.priority - b.priority;\n289\t\n290\t      // Then by availability time (null = immediately available)\n291\t      const aAvail = a.availableAt?.getTime() ?? 0;\n292\t      const bAvail = b.availableAt?.getTime() ?? 0;\n293\t      if (aAvail !== bAvail) return aAvail - bAvail;\n294\t\n295\t      // Then FIFO\n296\t      return a.createdAt.getTime() - b.createdAt.getTime();\n297\t    });\n298\t\n299\t    const task = candidates[0];\n300\t\n301\t    // Remove from pending queue, start processing\n302\t    task.status = 'processing';\n303\t    task.attempts++;\n304\t    q.activeTasks.set(task.id, task);\n305\t\n306\t    // Remove from tasks array\n307\t    const idx = q.tasks.indexOf(task);\n308\t    if (idx !== -1) q.tasks.splice(idx, 1);\n309\t\n310\t    return task;\n311\t  }\n312\t\n313\t  getWaitingCount(queueName?: string): number {\n314\t    const name = queueName ?? DEFAULT_QUEUE;\n315\t    const q = this.getQueue(name);\n316\t    if (!q) return 0;\n317\t\n318\t    const now = new Date();\n319\t    return q.tasks.filter(\n320\t      (t) =>\n321\t        t.status === 'pending' &&\n322\t        (!t.availableAt || t.availableAt <= now) &&\n323\t        t.dependsOn.length === 0,\n324\t    ).length;\n325\t  }\n326\t\n327\t  listQueues(): string[] {\n328\t    return Array.from(this.queues.keys());\n329\t  }\n330\t\n331\t  // -----------------------------------------------------------------------\n332\t  // Phase 5: complete / fail\n333\t  // -----------------------------------------------------------------------\n334\t\n335\t  complete(taskId: string): void {\n336\t    const queueName = this.taskQueueMap.get(taskId);\n337\t    if (!queueName) throw new Error(`Task \"${taskId}\" not found.`);\n338\t\n339\t    const q = this.getQueue(queueName);\n340\t    if (!q) throw new Error(`Queue \"${queueName}\" not found.`);\n341\t\n342\t    const task = q.activeTasks.get(taskId);\n343\t    if (!task) throw new Error(`Task \"${taskId}\" is not currently processing.`);\n344\t\n345\t    task.status = 'completed';\n346\t    task.completedAt = new Date();\n347\t    q.activeTasks.delete(taskId);\n348\t    q.completedTaskIds.add(taskId);\n349\t\n350\t    // Unblock dependents\n351\t    this.checkDependents(taskId, queueName);\n352\t  }\n353\t\n354\t  fail(taskId: string, error?: Error): void {\n355\t    const queueName = this.taskQueueMap.get(taskId);\n356\t    if (!queueName) throw new Error(`Task \"${taskId}\" not found.`);\n357\t\n358\t    const q = this.getQueue(queueName);\n359\t    if (!q) throw new Error(`Queue \"${queueName}\" not found.`);\n360\t\n361\t    const task = q.activeTasks.get(taskId);\n362\t    if (!task) throw new Error(`Task \"${taskId}\" is not currently processing.`);\n363\t\n364\t    q.activeTasks.delete(taskId);\n365\t\n366\t    if (task.attempts < task.maxRetries) {\n367\t      // Retry with backoff\n368\t      const delay = task.backoffDelay * Math.pow(2, task.attempts - 1);\n369\t      task.availableAt = new Date(Date.now() + delay);\n370\t      task.status = 'pending';\n371\t      task.error = error ?? null;\n372\t      q.tasks.push(task);\n373\t    } else {\n374\t      // No more retries — move to dead letter queue\n375\t      task.status = 'failed';\n376\t      task.error = error ?? task.error;\n377\t      task.failedAt = new Date();\n378\t\n379\t      // Add to DLQ\n380\t      q.deadLetter.push({\n381\t        id: task.id,\n382\t        originalPayload: task.payload,\n383\t        priority: task.priority,\n384\t        error: task.error,\n385\t        attempts: task.attempts,\n386\t        failedAt: task.failedAt,\n387\t        originalQueue: queueName,\n388\t      });\n389\t    }\n390\t  }\n391\t\n392\t  // -----------------------------------------------------------------------\n393\t  // Phase 6: Dead Letter Queue\n394\t  // -----------------------------------------------------------------------\n395\t\n396\t  viewDeadLetter(queueName?: string): DeadLetterEntry[] {\n397\t    const name = queueName ?? DEFAULT_QUEUE;\n398\t    const q = this.getQueue(name);\n399\t    if (!q) return [];\n400\t    return [...q.deadLetter];\n401\t  }\n402\t\n403\t  retryDeadLetter(taskId: string, queueName?: string): void {\n404\t    const name = queueName ?? DEFAULT_QUEUE;\n405\t    const q = this.getQueue(name);\n406\t    if (!q) throw new Error(`Queue \"${name}\" not found.`);\n407\t\n408\t    const idx = q.deadLetter.findIndex((d) => d.id === taskId);\n409\t    if (idx === -1) throw new Error(`Task \"${taskId}\" not found in dead letter queue.`);\n410\t\n411\t    const entry = q.deadLetter[idx];\n412\t    q.deadLetter.splice(idx, 1);\n413\t\n414\t    // Create a fresh task\n415\t    const task: Task = {\n416\t      id: entry.id,\n417\t      status: 'pending',\n418\t      payload: entry.originalPayload,\n419\t      priority: entry.priority,\n420\t      createdAt: new Date(),\n421\t      availableAt: null,\n422\t      maxRetries: DEFAULT_MAX_RETRIES,\n423\t      backoffDelay: DEFAULT_BACKOFF_DELAY,\n424\t      attempts: 0,\n425\t      error: null,\n426\t      dependsOn: [],\n427\t      progress: null,\n428\t      progressMessage: null,\n429\t      completedAt: null,\n430\t      failedAt: null,\n431\t      cancelledAt: null,\n432\t    };\n433\t\n434\t    q.tasks.push(task);\n435\t    this.taskQueueMap.set(task.id, name);\n436\t  }\n437\t\n438\t  clearDeadLetter(queueName?: string): void {\n439\t    const name = queueName ?? DEFAULT_QUEUE;\n440\t    const q = this.getQueue(name);\n441\t    if (!q) return;\n442\t    q.deadLetter = [];\n443\t  }\n444\t\n445\t  // -----------------------------------------------------------------------\n446\t  // Phase 7: Dependency helpers\n447\t  // -----------------------------------------------------------------------\n448\t\n449\t  getTask(taskId: string): Task | undefined {\n450\t    const queueName = this.taskQueueMap.get(taskId);\n451\t    if (!queueName) return undefined;\n452\t\n453\t    const q = this.getQueue(queueName);\n454\t    if (!q) return undefined;\n455\t\n456\t    // Check active tasks\n457\t    const active = q.activeTasks.get(taskId);\n458\t    if (active) return active;\n459\t\n460\t    // Check pending/blocked tasks\n461\t    const pending = q.tasks.find((t) => t.id === taskId);\n462\t    if (pending) return pending;\n463\t\n464\t    // Check if completed\n465\t    if (q.completedTaskIds.has(taskId)) {\n466\t      // We can't return the actual task, but we return a minimal representation\n467\t      return {\n468\t        id: taskId,\n469\t        status: 'completed',\n470\t        payload: null,\n471\t        priority: 0,\n472\t        createdAt: new Date(0),\n473\t        availableAt: null,\n474\t        maxRetries: 0,\n475\t        backoffDelay: 0,\n476\t        attempts: 0,\n477\t        error: null,\n478\t        dependsOn: [],\n479\t        progress: null,\n480\t        progressMessage: null,\n481\t        completedAt: null,\n482\t        failedAt: null,\n483\t        cancelledAt: null,\n484\t      } as Task;\n485\t    }\n486\t\n487\t    return undefined;\n488\t  }\n489\t\n490\t  private checkDependents(completedTaskId: string, queueName: string): void {\n491\t    const dependentIds = this.dependentsMap.get(completedTaskId);\n492\t    if (!dependentIds || dependent