+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_l31JwPqAaSNd6a7EhBgC1259","type":"tool_result","content":"1\timport * as crypto from 'node:crypto';\n2\timport {\n3\t  type Task,\n4\t  type AddOptions,\n5\t  type DeadLetterEntry,\n6\t  type MiddlewareFn,\n7\t  type ProcessHandler,\n8\t  type ProgressCallback,\n9\t  type CronSchedule,\n10\t  type ConcurrencyInfo,\n11\t  type TaskProgress,\n12\t  type ShutdownResult,\n13\t  type ShutdownCallback,\n14\t} from './types.js';\n15\timport { parseCron, matchesCron } from './cron.js';\n16\t\n17\t// ---------------------------------------------------------------------------\n18\t// Internal per-queue state\n19\t// ---------------------------------------------------------------------------\n20\t\n21\tinterface QueueState {\n22\t  /** All tasks that are pending, blocked, or newly-arrived delayed tasks. */\n23\t  tasks: Task[];\n24\t  /** Active (processing) tasks indexed by ID. */\n25\t  activeTasks: Map<string, Task>;\n26\t  /** Set of completed task IDs (for dependency resolution). */\n27\t  completedTaskIds: Set<string>;\n28\t  /** Dead letter entries for this queue. */\n29\t  deadLetter: DeadLetterEntry[];\n30\t  /** Concurrency limit (null = unlimited). */\n31\t  concurrencyLimit: number | null;\n32\t  /** Middleware registered for this queue. */\n33\t  middleware: MiddlewareFn[];\n34\t  /** Handler registered for this queue. */\n35\t  handler: ProcessHandler | null;\n36\t  /** Progress subscribers: taskId → Set of callbacks. */\n37\t  progressSubscribers: Map<string, Set<ProgressCallback>>;\n38\t}\n39\t\n40\t// ---------------------------------------------------------------------------\n41\t// Defaults\n42\t// ---------------------------------------------------------------------------\n43\t\n44\tconst DEFAULT_QUEUE = 'default';\n45\tconst DEFAULT_PRIORITY = 5;\n46\tconst MIN_PRIORITY = 1;\n47\tconst MAX_PRIORITY = 10;\n48\tconst DEFAULT_MAX_RETRIES = 3;\n49\tconst DEFAULT_BACKOFF_DELAY = 1000;\n50\t\n51\t// ---------------------------------------------------------------------------\n52\t// Helpers\n53\t// ---------------------------------------------------------------------------\n54\t\n55\tfunction generateId(): string {\n56\t  return crypto.randomUUID();\n57\t}\n58\t\n59\tfunction createTask(payload: unknown, options?: AddOptions): Task {\n60\t  const now = new Date();\n61\t  let availableAt: Date | null = null;\n62\t\n63\t  if (options?.delay !== undefined && options?.availableAt !== undefined) {\n64\t    throw new Error(\n65\t      'Cannot specify both \"delay\" and \"availableAt\" for a task.',\n66\t    );\n67\t  }\n68\t\n69\t  if (options?.delay !== undefined) {\n70\t    if (typeof options.delay !== 'number' || options.delay < 0) {\n71\t      throw new Error('Delay must be a non-negative number.');\n72\t    }\n73\t    availableAt = new Date(now.getTime() + options.delay);\n74\t  } else if (options?.availableAt !== undefined) {\n75\t    if (!(options.availableAt instanceof Date) || isNaN(options.availableAt.getTime())) {\n76\t      throw new Error('availableAt must be a valid Date.');\n77\t    }\n78\t    availableAt = new Date(options.availableAt);\n79\t  }\n80\t\n81\t  const priority = options?.priority ?? DEFAULT_PRIORITY;\n82\t  if (!Number.isInteger(priority) || priority < MIN_PRIORITY || priority > MAX_PRIORITY) {\n83\t    throw new Error(\n84\t      `Priority must be an integer between ${MIN_PRIORITY} and ${MAX_PRIORITY}. Got ${priority}.`,\n85\t    );\n86\t  }\n87\t\n88\t  const maxRetries = options?.maxRetries ?? DEFAULT_MAX_RETRIES;\n89\t  if (!Number.isInteger(maxRetries) || maxRetries < 0) {\n90\t    throw new Error('maxRetries must be a non-negative integer.');\n91\t  }\n92\t\n93\t  const backoffDelay = options?.backoffDelay ?? DEFAULT_BACKOFF_DELAY;\n94\t  if (typeof backoffDelay !== 'number' || backoffDelay < 0) {\n95\t    throw new Error('backoffDelay must be a non-negative number.');\n96\t  }\n97\t\n98\t  return {\n99\t    id: generateId(),\n100\t    status: 'pending',\n101\t    payload,\n102\t    priority,\n103\t    createdAt: now,\n104\t    availableAt,\n105\t    maxRetries,\n106\t    backoffDelay,\n107\t    attempts: 0,\n108\t    error: null,\n109\t    dependsOn: options?.dependsOn ?? [],\n110\t    progress: null,\n111\t    progressMessage: null,\n112\t    completedAt: null,\n113\t    failedAt: null,\n114\t    cancelledAt: null,\n115\t  };\n116\t}\n117\t\n118\t// ---------------------------------------------------------------------------\n119\t// Circular dependency detection\n120\t// ---------------------------------------------------------------------------\n121\t\n122\t/**\n123\t * Check if adding a dependency from `dependentId → dependsOnId` would create\n124\t * a cycle in the dependency graph.\n125\t */\n126\tfunction wouldCreateCycle(\n127\t  dependentId: string,\n128\t  dependsOnId: string,\n129\t  // Map of taskId → set of taskIds that depend on it\n130\t  dependentsMap: Map<string, Set<string>>,\n131\t): boolean {\n132\t  // BFS/DFS from dependsOnId following dependents edges: if we reach\n133\t  // dependentId, there's a cycle.\n134\t  const visited = new Set<string>();\n135\t  const stack = [dependsOnId];\n136\t\n137\t  while (stack.length > 0) {\n138\t    const current = stack.pop()!;\n139\t    if (current === dependentId) return true;\n140\t    if (visited.has(current)) continue;\n141\t    visited.add(current);\n142\t\n143\t    const deps = dependentsMap.get(current);\n144\t    if (deps) {\n145\t      for (const dep of deps) {\n146\t        stack.push(dep);\n147\t      }\n148\t    }\n149\t  }\n150\t\n151\t  return false;\n152\t}\n153\t\n154\t// ---------------------------------------------------------------------------\n155\t// Main Queue System\n156\t// ---------------------------------------------------------------------------\n157\t\n158\texport class TaskQueueSystem {\n159\t  private queues: Map<string, QueueState> = new Map();\n160\t  // Dependents map: taskId → Set of task IDs that depend on this task\n161\t  // We store this globally because dependencies can span within a queue.\n162\t  private dependentsMap: Map<string, Set<string>> = new Map();\n163\t  // Track all task IDs and which queue they belong to\n164\t  private taskQueueMap: Map<string, string> = new Map();\n165\t  // Shutdown state\n166\t  private shuttingDown = false;\n167\t  private shutdownResult: ShutdownResult | null = null;\n168\t  private shutdownCallbacks: ShutdownCallback[] = [];\n169\t  // Cron schedules\n170\t  private schedules: Map<string, CronSchedule> = new Map();\n171\t\n172\t  // -----------------------------------------------------------------------\n173\t  // Queue management helpers\n174\t  // -----------------------------------------------------------------------\n175\t\n176\t  private getOrCreateQueue(name: string): QueueState {\n177\t    let q = this.queues.get(name);\n178\t    if (!q) {\n179\t      q = {\n180\t        tasks: [],\n181\t        activeTasks: new Map(),\n182\t        completedTaskIds: new Set(),\n183\t        deadLetter: [],\n184\t        concurrencyLimit: null,\n185\t        middleware: [],\n186\t        handler: null,\n187\t        progressSubscribers: new Map(),\n188\t      };\n189\t      this.queues.set(name, q);\n190\t    }\n191\t    return q;\n192\t  }\n193\t\n194\t  private getQueue(name: string): QueueState | undefined {\n195\t    return this.queues.get(name);\n196\t  }\n197\t\n198\t  // -----------------------------------------------------------------------\n199\t  // Phase 1-4: add, getNext, getWaitingCount\n200\t  // -----------------------------------------------------------------------\n201\t\n202\t  add(payload: unknown, options?: AddOptions): Task {\n203\t    if (this.shuttingDown) {\n204\t      throw new Error('System is shutting down. Cannot accept new tasks.');\n205\t    }\n206\t\n207\t    const queueName = options?.queue ?? DEFAULT_QUEUE;\n208\t    const task = createTask(payload, options);\n209\t\n210\t    // Handle