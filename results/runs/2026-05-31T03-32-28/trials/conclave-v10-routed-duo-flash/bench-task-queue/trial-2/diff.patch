   const queueName = this.taskQueueMap.get(taskId);\n    if (!queueName) throw new Error(`Task \"${taskId}\" not found.`);\n\n    const q = this.getQueue(queueName);\n    if (!q) throw new Error(`Queue \"${queueName}\" not found.`);\n\n    const task = q.activeTasks.get(taskId);\n    if (!task) {\n      // Could be in tasks array (pending)\n      const pending = q.tasks.find((t) => t.id === taskId);\n      if (pending) {\n        throw new Error(`Task \"${taskId}\" has not been fetched for processing yet (status: ${pending.status}).`);\n      }\n      throw new Error(`Task \"${taskId}\" is not currently processing.`);\n    }\n\n    if (q.middleware.length === 0 && !q.handler) {\n      // No middleware or handler — nothing to do\n      return;\n    }\n\n    // Build the middleware chain\n    const chain = [...q.middleware];\n    const handler = q.handler;\n\n    if (!handler && chain.length === 0) return;\n\n    let middlewareIndex = 0;\n    let nextCalled = false;\n\n    const runNext = async (): Promise<void> => {\n      if (middlewareIndex < chain.length) {\n        const fn = chain[middlewareIndex];\n        middlewareIndex++;\n        nextCalled = false;\n        try {\n          await fn(task, () => {\n            nextCalled = true;\n          });\n          // If the middleware didn't call next, stop here\n          if (nextCalled) {\n            await runNext();\n          }\n        } catch (err) {\n          // Middleware threw — fail the task\n          task.error = err instanceof Error ? err : new Error(String(err));\n          this.fail(task.id, task.error);\n          return;\n        }\n      } else if (handler) {\n        // All middleware done, run handler\n        try {\n          await handler(task);\n        } catch (err) {\n          task.error = err instanceof Error ? err : new Error(String(err));\n          this.fail(task.id, task.error);\n        }\n      }\n    };\n\n    await runNext();\n  }\n\n  // ------------------------------------------