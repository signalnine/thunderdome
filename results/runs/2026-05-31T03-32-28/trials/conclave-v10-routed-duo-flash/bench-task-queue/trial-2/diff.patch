.delete(taskId);\n    q.completedTaskIds.add(taskId);\n\n    // Unblock dependents\n    this.checkDependents(taskId, queueName);\n  }\n\n  fail(taskId: string, error?: Error): void {\n    const queueName = this.taskQueueMap.get(taskId);\n    if (!queueName) throw new Error(`Task \"${taskId}\" not found.`);\n\n    const q = this.getQueue(queueName);\n    if (!q) throw new Error(`Queue \"${queueName}\" not found.`);\n\n    const task = q.activeTasks.get(taskId);\n    if (!task) throw new Error(`Task \"${taskId}\" is not currently processing.`);\n\n    q.activeTasks.delete(taskId);\n\n    if (task.attempts < task.maxRetries) {\n      // Retry with backoff\n      const delay = task.backoffDelay * Math.pow(2, task.attempts - 1);\n      task.availableAt = new Date(Date.now() + delay);\n      task.status = 'pending';\n      task.error = error ?? null;\n      q.tasks.push(task);\n    } else {\n      // No more retries — move to dead letter queue\n      task.status = 'failed';\n      task.error = error ?? task.error;\n      task.failedAt = new Date();\n\n      // Add to DLQ\n      q.deadLetter.push({\n        id: task.id,\n        originalPayload: task.payload,\n        priority: task.priority,\n        error: task.error,\n        attempts: task.attempts,\n        failedAt: task.failedAt,\n        originalQueue: queueName,\n      });\n    }\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 6: Dead Letter Queue\n  // -----------------------------------------------------------------------\n\n  viewDeadLetter(queueName?: string): DeadLetterEntry[] {\n    const name = queueName ?? DEFAULT_QUEUE;\n    const q = this.getQueue(name);\n    if (!q) return [];\n    return [...q.deadLetter];\n  }\n\n  retryDeadLetter(taskId: string, queueName?: string): void {\n    const name = queueName ?? DEFAULT_QUEUE;\n    const q = this.getQueue(name);\n    if (!q) throw new Error(`Queue \"${name}\" not found.`);\n\n    const idx = q.deadLetter.findIndex((d) => d.id === taskId);\n    if (idx === -1) throw new Error(`Task \"${taskId}\" not found in dead letter queue.`);\n\n    const entry = q.deadLetter[idx];\n    q.deadLetter.splice(idx, 1);\n\n    // Create a fresh task\n    const task: Task = {\n      id: entry.id,\n      status: 'pending',\n      payload: entry.originalPayload,\n      priority: entry.priority,\n      createdAt: new Date(),\n      availableAt: null,\n      maxRetries: DEFAULT_MAX_RETRIES,\n      backoffDelay: DEFAULT_BACKOFF_DELAY,\n      attempts: 0,\n      error: null,\n      dependsOn: [],\n      progress: null,\n      progressMessage: null,\n      completedAt: null,\n      failedAt: null,\n      cancelledAt: null,\n    };\n\n    q.tasks.push(task);\n    this.taskQueueMap.set(task.id, name);\n  }\n\n  clearDeadLetter(queueName?: string): void {\n    const name = queueName ?? DEFAULT_QUEUE;\n    const q = this.getQueue(name);\n    if (!q) return;\n    q.deadLetter = [];\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 7: Dependency helpers\n  // -----------------------------------------------------------------------\n\n  getTask(taskId: string): Task | undefined {\n    const queueName = this.taskQueueMap.get(taskId);\n    if (!queueName) return undefined;\n\n    const q = this.getQueue(queueName);\n    if (!q) return undefined;\n\n    // Check active tasks\n    const active = q.activeTasks.get(taskId);\n    if (active) return active;\n\n    // Check pending/blocked tasks\n    const pending = q.tasks.find((t) => t.id === taskId);\n    if (pending) return pending;\n\n    // Check if completed\n    if (q.completedTaskIds.has(taskId)) {\n      // We can't return the actual task, but we return a minimal representation\n      return {\n        id: taskId,\n        status: 'completed',\n        payload: null,\n        priority: 0,\n        createdAt: new Date(0),\n        availableAt: null,\n        maxRetries: 0,\n        backoffDelay: 0,\n        attempts: 0,\n        error: null,\n        dependsOn: [],\n        progress: null,\n        progressMessage: null,\n        completedAt: null,\n        failedAt: null,\n        cancelledAt: null,\n      } as Task;\n    }\n\n    return undefined;\n  }\n\n  private checkDependents(completedTaskId: string, queueName: string): void {\n    const dependentIds = this.dependentsMap.get(completedTaskId);\n    if (!dependentIds || dependentIds.size === 0) return;\n\n    const q = this.getQueue(queueName);\n    if (!q) return;\n\n    for (const depId of dependentIds) {\n      const task = q.tasks.find((t) => t.id === depId);\n      if (!task || task.status !== 'blocked') continue;\n\n      // Check if all dependencies are now completed\n      const allDone = task.dependsOn.every((dId) =>\n        q.completedTaskIds.has(dId),\n      );\n\n      if (allDone) {\n        task.status = 'pending';\n      }\n    }\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 8: Concurrency\n  // -----------------------------------------------------------------------\n\n  setConcurrency(limit: number, queueName?: string): void {\n    if (typeof limit !== 'number' || limit < 1 || !Number.isInteger(limit)) {\n      throw new Error('Concurrency limit must be a positive integer.');\n    }\n\n    const name = queueName ?? DEFAULT_QUEUE;\n    const q = this.getOrCreateQueue(name);\n    q.concurrencyLimit = limit;\n  }\n\n  getConcurrency(queueName?: string): ConcurrencyInfo {\n    const name = queueName ?? DEFAULT_QUEUE;\n    const q = this.getQueue(name);\n    if (!q) return { limit: null, active: 0 };\n    return { limit: q.concurrencyLimit, active: q.activeTasks.size };\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 9: Progress and Cancellation\n  // -----------------------------------------------------------------------\n\n  reportProgress(taskId: string, progress: number, message?: string): void {\n    if (typeof progress !== 'number' || progress < 0 || progress > 100) {\n      throw new Error('Progress must be a number between 0 and 100.');\n    }\n\n    const queueName = this.taskQueueMap.get(taskId);\n    if (!queueName) throw new Error(`Task \"${taskId}\" not found.`);\n\n    const q = this.getQueue(queueName);\n    if (!q) throw new Error(`Queue \"${queueName}\" not found.`);\n\n    // Look in active tasks\n    const task =\n      q.activeTasks.get(taskId) ?? q.tasks.find((t) => t.id === taskId);\n    if (!task) throw new Error(`Task \"${taskId}\" not found.`);\n\n    if (task.status !== 'processing') {\n      throw new Error(\n        `Cannot report progress on a task with status \"${task.status}\".`,\n      );\n    }\n\n    task.progress = progress;\n    task.progressMessage = message ?? null;\n\n    // Notify subscribers\n    const subscribers = q.progressSubscribers.get(taskId);\n    if (subscribers) {\n      for (const cb of subscribers) {\n        try {\n          cb(progress, message);\n        } catch {\n          // Swallow subscriber errors\n        }\n      }\n    }\n  }\n\n  getProgress(taskId: string): TaskProgress | null {\n    const queueName = this.taskQueueMap.get(taskId);\n    if (!queueName) return null;\n\n    const q = this.getQueue(queueName);\n    if (!q) return null;\n\n    const task =\n      q.activeTasks.get(taskId) ?? q.tasks.find((t) => t.id === taskId);\n    if (!task || task.progress === null) return null;\n\n    return {\n      progress: task.progress,\n      ...(task.progressMessage ? { message: task.progressMessage } : {}),\n    };\n  }\n\n  onProgress(\n    taskId: string,\n    callback: ProgressCallback,\n  ): () => void {\n    const queueName = this.taskQueueMap.get(taskId);\n    if (!queueName) throw new Error(`Task \"${taskId}\" not found.`);\n\n    const q = this.getOrCreateQueue(queueName);\n\n    let subs = q.progressSubscribers.get(taskId);\n    if (!subs) {\n      subs = new Set();\n      q.progressSubscribers.set(taskId, subs);\n    }\n\n    subs.add(callback);\n\n    return () => {\n      subs?.delete(callback);\n      if (subs?.size === 0) {\n        q.progressSubscribers.delete(taskId);\n      }\n    };\n  }\n\n  cancel(taskId: string): boolean {\n    const queueName = this.taskQueueMap.get(taskId);\n    if (!queueName) return false;\n\n    const q = this.getQueue(queueName);\n    if (!q) return false;\n\n    // Check pending/blocked tasks\n    const idx = q.tasks.findIndex((t) => t.id === taskId);\n    if (idx !== -1) {\n      const task = q.tasks[idx];\n      task.status = 'cancelled';\n      task.cancelledAt = new Date();\n      q.tasks.splice(idx, 1);\n      return true;\n    }\n\n    // Check active tasks\n    const active = q.activeTasks.get(taskId);\n    if (active) {\n      active.status = 'cancelled';\n      active.cancelledAt = new Date();\n      q.activeTasks.delete(taskId);\n\n      // Clean up from dependents map so dependents are unblocked (they won't wait for cancelled tasks)\n      // Actually, the spec says cancelled tasks are never retried. Dependents remain blocked.\n      return true;\n    }\n\n    return false;\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 10: Recurring / Cron\n  // -----------------------------------------------------------------------\n\n  addSchedule(\n    name: string,\n    expression: string,\n    payload: unknown,\n    queueName?: string,\n  ): void {\n    // Validate cron expression\n    parseCron(expression);\n\n    if (this.schedules.has(name)) {\n      throw new Error(`Schedule \"${name}\" already exists.`);\n    }\n\n    const queue = queueName ?? DEFAULT_QUEUE;\n    // Ensure queue exists\n    this.getOrCreateQueue(queue);\n\n    this.schedules.set(name, {\n      name,\n      expression,\n      queue,\n      payload,\n      lastRun: null,\n    });\n  }\n\n  removeSchedule(name: string): boolean {\n    return this.schedules.delete(name);\n  }\n\n  listSchedules() {\n    retu