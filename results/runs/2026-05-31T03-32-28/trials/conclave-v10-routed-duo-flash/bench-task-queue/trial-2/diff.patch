+{"type":"assistant","message":{"id":"586ee3f4-84de-4d8c-abd2-e2b8e748a797","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{"type":"tool_use","id":"call_00_NS3CD42unaK3q5h1zgIE1179","name":"Write","input":{"file_path":"/workspace/src/task-queue-system.ts","content":"import * as crypto from 'node:crypto';\nimport {\n  type Task,\n  type TaskStatus,\n  type AddOptions,\n  type DeadLetterEntry,\n  type MiddlewareFn,\n  type ProcessHandler,\n  type ProgressCallback,\n  type CronSchedule,\n  type ConcurrencyInfo,\n  type TaskProgress,\n  type ShutdownResult,\n  type ShutdownCallback,\n} from './types.js';\nimport { parseCron, matchesCron } from './cron.js';\n\n// ---------------------------------------------------------------------------\n// Internal per-queue state\n// ---------------------------------------------------------------------------\n\ninterface QueueState {\n  /** All tasks that are pending, blocked, or newly-arrived delayed tasks. */\n  tasks: Task[];\n  /** Active (processing) tasks indexed by ID. */\n  activeTasks: Map<string, Task>;\n  /** Set of completed task IDs (for dependency resolution). */\n  completedTaskIds: Set<string>;\n  /** Dead letter entries for this queue. */\n  deadLetter: DeadLetterEntry[];\n  /** Concurrency limit (null = unlimited). */\n  concurrencyLimit: number | null;\n  /** Middleware registered for this queue. */\n  middleware: MiddlewareFn[];\n  /** Handler registered for this queue. */\n  handler: ProcessHandler | null;\n  /** Progress subscribers: taskId → Set of callbacks. */\n  progressSubscribers: Map<string, Set<ProgressCallback>>;\n}\n\n// ---------------------------------------------------------------------------\n// Defaults\n// ---------------------------------------------------------------------------\n\nconst DEFAULT_QUEUE = 'default';\nconst DEFAULT_PRIORITY = 5;\nconst MIN_PRIORITY = 1;\nconst MAX_PRIORITY = 10;\nconst DEFAULT_MAX_RETRIES = 3;\nconst DEFAULT_BACKOFF_DELAY = 1000;\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\nfunction generateId(): string {\n  return crypto.randomUUID();\n}\n\nfunction createTask(payload: unknown, options?: AddOptions): Task {\n  const now = new Date();\n  let availableAt: Date | null = null;\n\n  if (options?.delay !== undefined && options?.availableAt !== undefined) {\n    throw new Error(\n      'Cannot specify both \"delay\" and \"availableAt\" for a task.',\n    );\n  }\n\n  if (options?.delay !== undefined) {\n    if (typeof options.delay !== 'number' || options.delay < 0) {\n      throw new Error('Delay must be a non-negative number.');\n    }\n    availableAt = new Date(now.getTime() + options.delay);\n  } else if (options?.availableAt !== undefined) {\n    if (!(options.availableAt instanceof Date) || isNaN(options.availableAt.getTime())) {\n      throw new Error('availableAt must be a valid Date.');\n    }\n    availableAt = new Date(options.availableAt);\n  }\n\n  const priority = options?.priority ?? DEFAULT_PRIORITY;\n  if (!Number.isInteger(priority) || priority < MIN_PRIORITY || priority > MAX_PRIORITY) {\n    throw new Error(\n      `Priority must be an integer between ${MIN_PRIORITY} and ${MAX_PRIORITY}. Got ${priority}.`,\n    );\n  }\n\n  const maxRetries = options?.maxRetries ?? DEFAULT_MAX_RETRIES;\n  if (!Number.isInteger(maxRetries) || maxRetries < 0) {\n    throw new Error('maxRetries must be a non-negative integer.');\n  }\n\n  const backoffDelay = options?.backoffDelay ?? DEFAULT_BACKOFF_DELAY;\n  if (typeof backoffDelay !== 'number' || backoffDelay < 0) {\n    throw new Error('backoffDelay must be a non-negative number.');\n  }\n\n  return {\n    id: generateId(),\n    status: 'pending',\n    payload,\n    priority,\n    createdAt: now,\n    availableAt,\n    maxRetries,\n    backoffDelay,\n    attempts: 0,\n    error: null,\n    dependsOn: options?.dependsOn ?? [],\n    progress: null,\n    progressMessage: null,\n    completedAt: null,\n    failedAt: null,\n    cancelledAt: null,\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Circular dependency detection\n// ---------------------------------------------------------------------------\n\n/**\n * Check if adding a dependency from `dependentId → dependsOnId` would create\n * a cycle in the dependency graph.\n */\nfunction wouldCreateCycle(\n  dependentId: string,\n  dependsOnId: string,\n  // Map of taskId → set of taskIds that depend on it\n  dependentsMap: Map<string, Set<string>>,\n): boolean {\n  // BFS/DFS from dependsOnId following dependents edges: if we reach\n  // dependentId, there's a cycle.\n  const visited = new Set<string>();\n  const stack = [dependsOnId];\n\n  while (stack.length > 0) {\n    const current = stack.pop()!;\n    if (current === dependentId) return true;\n    if (visited.has(current)) continue;\n    visited.add(current);\n\n    const deps = dependentsMap.get(current);\n    if (deps) {\n      for (const dep of deps) {\n        stack.push(dep);\n      }\n    }\n  }\n\n  return false;\n}\n\n// ---------------------------------------------------------------------------\n// Main Queue System\n// ---------------------------------------------------------------------------\n\nexport class TaskQueueSystem {\n  private queues: Map<string, QueueState> = new Map();\n  // Dependents map: taskId → Set of task IDs that depend on this task\n  // We store this globally because dependencies can span within a queue.\n  private dependentsMap: Map<string, Set<string>> = new Map();\n  // Track all task IDs and which queue they belong to\n  private taskQueueMap: Map<string, string> = new Map();\n  // Shutdown state\n  private shuttingDown = false;\n  private shutdownResult: ShutdownResult | null = null;\n  private shutdownCallbacks: ShutdownCallback[] = [];\n  // Cron schedules\n  private schedules: Map<string, CronSchedule> = new Map();\n\n  // -----------------------------------------------------------------------\n  // Queue management helpers\n  // -----------------------------------------------------------------------\n\n  private getOrCreateQueue(name: string): QueueState {\n    let q = this.queues.get(name);\n    if (!q) {\n      q = {\n        tasks: [],\n        activeTasks: new Map(),\n        completedTaskIds: new Set(),\n        deadLetter: [],\n        concurrencyLimit: null,\n        middleware: [],\n        handler: null,\n        progressSubscribers: new Map(),\n      };\n      this.queues.set(name, q);\n    }\n    return q;\n  }\n\n  private getQueue(name: string): QueueState | undefined {\n    return this.queues.get(name);\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 1-4: add, getNext, getWaitingCount\n  // -----------------------------------------------------------------------\n\n  add(payload: unknown, options?: AddOptions): Task {\n    if (this.shuttingDown) {\n      throw new Error('System is shutting down. Cannot accept new tasks.');\n    }\n\n    const queueName = options?.queue ?? DEFAULT_QUEUE;\n    const task = createTask(payload, options);\n\n    // Handle dependencies\n    if (task.dependsOn.length > 0) {\n      // Verify all dependencies exist\n      for (const depId of task.dependsOn) {\n        const depQueue = this.taskQueueMap.get(depId);\n        if (!depQueue) {\n          throw new Error(\n            `Dependency task \"${depId}\" does not exist.`,\n          );\n        }\n        // Check for circular dependencies\n        if (wouldCreateCycle(task.id, depId, this.dependentsMap)) {\n          throw new Error(\n            `Circular dependency detected: adding task \"${task.id}\" depending on \"${depId}\" would create a cycle.`,\n          );\n        }\n      }\n\n      // Check if all dependencies are already completed\n      const q = this.getOrCreateQueue(queueName);\n      const allCompleted = task.dependsOn.every((depId) =>\n        q.completedTaskIds.has(depId),\n      );\n\n      if (allCompleted) {\n        task.status = 'pending';\n      } else {\n        task.status = 'blocked';\n      }\n\n      // Register dependents\n      for (const depId of task.dependsOn) {\n        let deps = this.dependentsMap.get(depId);\n        if (!deps) {\n          deps = new Set();\n          this.dependentsMap.set(depId, deps);\n        }\n        deps.add(task.id);\n      }\n    }\n\n    const q = this.getOrCreateQueue(queueName);\n    q.tasks.push(task);\n    this.taskQueueMap.set(task.id, queueName);\n\n    return task;\n  }\n\n  getNext(queueName?: string): Task | null {\n    if (this.shuttingDown) return null;\n\n    const name = queueName ?? DEFAULT_QUEUE;\n    const q = this.getQueue(name);\n    if (!q) return null;\n\n    // Check concurrency limit\n    if (\n      q.concurrencyLimit !== null &&\n      q.activeTasks.size >= q.concurrencyLimit\n    ) {\n      return null;\n    }\n\n    const now = new Date();\n\n    // Find the first available task among pending (not delayed, not blocked)\n    // Sort candidates by priority (asc), then availableAt (asc nulls first), then createdAt (asc)\n    const candidates = q.tasks.filter(\n      (t) =>\n        t.status === 'pending' &&\n        t.dependsOn.length === 0 &&\n        (!t.availableAt || t.availableAt <= now),\n    );\n\n    if (candidates.length === 0) return null;\n\n    candidates.sort((a, b) => {\n      // Priority first (lower number = higher priority)\n      if (a.priority !== b.priority) return a.priority - b.priority;\n\n      // Then by availability time (null = immediately available)\n      const aAvail = a.availableAt?.getTime() ?? 0;\n      const bAvail = b.availableAt?.getTime() ?? 0;\n      if (aAvail !== bAvail) return aAvail - bAvail;\n\n      // Then FIFO\n      return a.createdAt.getTime() - b.createdAt.getTime();\n    });\n\n    const task = candidates[0];\n\n    // Remove from pending queue, start processing\n    task.status = 'processing';\n    task.attempts++;\n    q.activeTasks.set(task.id, task);\n\n    // Remove from tasks array\n    const idx = q.tasks.indexOf(task);\n    if (idx !== -1) q.tasks.splice(idx, 1);\n\n    return task;\n  }\n\n  getWaitingCount(queueName?: string): number {\n    const name = queueName ?? DEFAULT_QUEUE;\n    const q = this.getQueue(name);\n    if (!q) return 0;\n\n    const now = new Date();\n    return q.tasks.filter(\n      (t) =>\n        t.status === 'pending' &&\n        (!t.availableAt || t.availableAt <= now) &&\n        t.dependsOn.length === 0,\n    );\n  }\n\n  listQueues(): string[] {\n    return Array.from(this.queues.keys());\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 5: complete / fail\n  // -----------------------------------------------------------------------\n\n  complete(taskId: string): void {\n    const queueName = this.taskQueueMap.get(taskId);\n    if (!queueName) throw new Error(`Task \"${taskId}\" not found.`);\n\n    const q = this.getQueue(queueName);\n    if (!q) throw new Error(`Queue \"${queueName}\" not found.`);\n\n    const task = q.activeTasks.get(taskId);\n    if (!task) throw new Error(`Task \"${taskId}\" is not currently processing.`);\n\n    task.status = 'completed';\n    task.completedAt = new Date();\n    q.activeTasks.delete(taskId);\n    q.completedTaskIds.add(taskId);\n\n    // Unblock dependents\n    this.checkDependents(taskId, queueName);\n  }\n\n  fail(taskId: string, error?: Error): void {\n    const queueName = this.taskQueueMap.get(taskId);\n    if (!queueName) throw new Error(`Task \"${taskId}\" not found.`);\n\n    const q = this.getQueue(queueName);\n    if (!q) throw new Error(`Queue \"${queueName}\" not found.`);\n\n    const task = q.activeTasks.get(taskId);\n    if (!task) throw new Error(`Task \"${taskId}\" is not currently processing.`);\n\n    q.activeTasks.delete(taskId);\n\n    if (task.attempts < task.maxRetries) {\n      // Retry with backoff\n      const delay = task.backoffDelay * Math.pow(2, task.attempts - 1);\n      task.availableAt = new Date(Date.now() + delay);\n      task.status = 'pending';\n      task.error = error ?? null;\n      q.tasks.push(task);\n    } else {\n      // No more retries — move to dead letter queue\n      task.status = 'failed';\n      task.error = error ?? task.error;\n      task.failedAt = new Date();\n\n      // Add to DLQ\n      q.deadLetter.push({\n        id: task.id,\n        originalPayload: task.payload,\n        priority: task.priority,\n        error: task.error,\n        attempts: task.attempts,\n        failedAt: task.failedAt,\n        originalQueue: queueName,\n      });\n    }\n  }\n\n  // -----------------------------------------------------------------------\n  // Phase 6: Dead Letter Queue\n  // -----------------------------------------------------------------------\n\n  viewDeadLetter(queueName?: string): DeadLetterEntry[] {\n    const name = queueName ?? DEFAULT_QUEUE;\n    const q = this.getQueue(name);\n    if (!q) return [];\n    return [...q.deadLetter];\n  }\n\n  retryDeadLetter(taskId: string, queueName?: string): void {\n    const name = queueName ?? DEFAULT_QUEUE;\n    const q = this.getQueue(name);\n    if (!q) throw new Error(`Queue \"${name}\" not found.`);\n\n    const idx = q.deadLetter.findIndex((d) => d.id === taskId);\n    if (idx === -1) throw new Error(`Task \"${taskId}\" not found in dead letter queue.`);\n\n    const entry = q.deadLetter[idx];\n    q.deadLetter.splice(idx, 1);\n\n    // Create a fresh task\n    const task: Task = {\n      id: entry.id,\n      status: 'pending',\n      payload: entry.originalPayload,\n      priority: entry.priority,\n      createdAt: new Date(),\n      availableAt: null,\n      maxRetries: DEFAULT_MAX_RETRIES,\n      backoffDelay: DEFAULT_BACKOFF_DELAY,\n      attempts: 0,\n      error: null,\n      dependsOn: [],\n      progress: null,\n      progressM