exists on branch \"${this.currentBranchName}\"`);\n    }\n\n    const clonedContent = deepClone(content);\n    const version = this.createVersion(id, clonedContent);\n\n    docs.set(id, {\n      content: clonedContent,\n      deleted: false,\n      currentVersionId: version.id,\n    });\n\n    this.addToBranchHistory(id, version);\n  }\n\n  get(id: string): object {\n    const doc = this.getDocOrThrow(id);\n    return deepClone(doc.content!);\n  }\n\n  update(id: string, content: object): void {\n    const doc = this.getDocOrThrow(id);\n    const clonedContent = deepClone(content);\n    const version = this.createVersion(id, clonedContent);\n\n    doc.content = clonedContent;\n    doc.currentVersionId = version.id;\n\n    this.addToBranchHistory(id, version);\n  }\n\n  delete(id: string): void {\n    const docs = this.getCurrentDocs();\n    const doc = docs.get(id);\n\n    if (!doc || doc.deleted) {\n      throw new Error(`Document \"${id}\" not found on branch \"${this.currentBranchName}\"`);\n    }\n\n    doc.deleted = true;\n    doc.content = null;\n    // Note: delete does NOT create a version\n  }\n\n  getHistory(id: string): Version[] {\n    const history = this.getCurrentHistory();\n    const docHistory = history.get(id);\n    if (!docHistory) {\n      throw new Error(`Document \"${id}\" not found on branch \"${this.currentBranchName}\"`);\n    }\n    // Return chronological order (oldest first) — already stored in order\n    return docHistory.map(v => ({\n      id: v.id,\n      timestamp: v.timestamp,\n      content: deepClone(v.content),\n    }));\n  }\n\n  getVersion(id: string, versionId: string): object {\n    const docVersions = this.docVersionsForHistory.get(id);\n    if (!docVersions) {\n      throw new Error(`Document \"${id}\" not found`);\n    }\n\n    const version = this.versions.get(versionId);\n    if (!version || version.docId !== id) {\n      throw new Error(`Version \"${versionId}\" not found for document \"${id}\"`);\n    }\n\n    return deepClone(version.content);\n  }\n\n  createBranch(name: string, fromBranch?: string): void {\n    if (this.branchDocs.has(name)) {\n      throw new Error(`Branch \"${name}\" already exists`);\n    }\n\n    const sourceBranch = fromBranch ?? this.currentBranchName;\n    if (!this.branchDocs.has(sourceBranch)) {\n      throw new Error(`Source branch \"${sourceBranch}\" does not exist`);\n    }\n\n    const sourceDocs = this.branchDocs.get(sourceBranch)!;\n    const sourceHistory = this.branchHistory.get(sourceBranch)!;\n\n    // Deep clone document state\n    const newDocs: Map<string, DocState> = new Map();\n    for (const [docId, state] of sourceDocs) {\n      newDocs.set(docId, {\n        content: state.content ? deepClone(state.content) as object : null,\n        deleted: state.deleted,\n        currentVersionId: state.currentVersionId,\n      });\n    }\n    this.branchDocs.set(name, newDocs);\n\n    // Deep clone history\n    const newHistory: Map<string, Version[]> = new Map();\n    for (const [docId, versions] of sourceHistory) {\n      newHistory.set(docId, versions.map(v => ({\n        id: v.id,\n        timestamp: v.timestamp,\n        content: deepClone(v.content),\n      })));\n    }\n    this.branchHistory.set(name, newHistory);\n\n    // Record branch point (snapshot of parent at creation time)\n    const snapshot: Map<string, DocState> = new Map();\n    for (const [docId, state] of sourceDocs) {\n      snapshot.set(docId, {\n        content: state.content ? deepClone(state.content) as object : null,\n        deleted: state.deleted,\n        currentVersionId: state.currentVersionId,\n      });\n    }\n    this.branchPoints.set(name, { parent: sourceBranch, snapshot });\n  }\n\n  switchBranch(name: string): void {\n    if (!this.branchDocs.has(name)) {\n      throw new Error(`Branch \"${name}\" does not exist`);\n    }\n    this.currentBranchName = name;\n  }\n\n  getBranch(): string {\n    return this.currentBranchName;\n  }\n\n  listBranches(): string[] {\n    return Array.from(this.branchDocs.keys());\n  }\n\n  merge(sourceBranch: string): MergeResult {\n    if (sourceBranch === this.currentBranchName) {\n      return { merged: {}, conflicts: [], applied: true };\n    }\n\n    const targetBranch = this.currentBranchName;\n\n    if (!this.branchDocs.has(sourceBranch)) {\n      throw new Error(`Branch \"${sourceBranch}\" does not exist`);\n    }\n\n    const sourceDocs = this.branchDocs.get(sourceBranch)!;\n    const targetDocs = this.branchDocs.get(targetBranch)!;\n\n    // Find the common ancestor state\n    const baseSnapshot = this.findBaseSnapshot(sourceBranch, targetBranch);\n\n    // Collect all document IDs from source and target (non-deleted)\n    const allDocIds = new Set<string>();\n    for (const [docId, state] of sourceDocs) {\n      if (!state.deleted) allDocIds.add(docId);\n    }\n    for (const [docId, state] of targetDocs) {\n      if (!state.deleted) allDocIds.add(docId);\n    }\n\n    const merged: Record<string, object> = {};\n    const conflicts: Conflict[] = [];\n    const docsToDelete: string[] = [];\n    let hasConflicts = false;\n\n    for (const docId of allDocIds) {\n      const ourState = targetDocs.get(docId);\n      const theirState = sourceDocs.get(docId);\n      const baseState = baseSnapshot.get(docId);\n\n      const baseContent = baseState?.content ?? undefined;\n      const ourContent = ourState?.content ?? undefined;\n      const theirContent = theirState?.content ?? undefined;\n\n      const oursDeleted = ourState?.deleted ?? true;\n      const theirsDeleted = theirState?.deleted ?? true;\n\n      // Determine if a document existed in the base (common ancestor)\n      const docExistsInBase = baseState !== undefined && !baseState.deleted;\n\n      if (!docExistsInBase) {\n        // Document didn't exist in base or was deleted before branching\n        // Check if it was created on either branch\n        const oursCreated = ourState && !ourState.deleted;\n        const theirsCreated = theirState && !theirState.deleted;\n\n        if (oursCreated && theirsCreated) {\n          // Both created it — compare directly (no base to merge from)\n          if (!deepEqual(ourContent, theirContent)) {\n            // Both created with different content — conflict\n            conflicts.push({\n              documentId: docId,\n              path: '',\n              base: undefined,\n              ours: ourContent!,\n              theirs: theirContent!,\n            });\n            hasConflicts = true;\n            merged[docId] = deepClone(ourContent) as object;\n          } else {\n            // Same content — no conflict\n            merged[docId] = deepClone(ourContent ?? theirContent) as object;\n          }\n        } else if (oursCreated) {\n          // Only we created it\n          merged[docId] = deepClone(ourContent) as object;\n        } else if (theirsCreated) {\n          // Only they created it\n          merged[docId] = deepClone(theirContent) as object;\n        }\n        // If neither created it (both deleted), nothing to report\n        continue;\n      }\n\n      // Document exists in base — check for changes\n\n      // Both sides deleted it\n      if (oursDeleted && theirsDeleted) {\n        // No conflict — both deleted. Nothing to include in merged.\n        continue;\n      }\n\n      // We deleted, they modified or kept\n      if (oursDeleted && !theirsDeleted) {\n        // We deleted, they didn't. If they also changed the content, that's a conflict.\n        const theirsChanged = !deepEqual(theirContent, baseContent);\n        if (theirsChanged) {\n          // Conflict: we deleted, they modified\n          conflicts.push({\n            documentId: docId,\n            path: '',\n            base: baseContent!,\n            ours: undefined, // deleted\n            theirs: theirContent!,\n          });\n          hasConflicts = true;\n        }\n        // Either way, merged result reflects our deletion (nothing added to merged)\n        continue;\n      }\n\n      // They deleted, we modified or kept\n      if (!oursDeleted && theirsDeleted) {\n        const oursChanged = !deepEqual(ourContent, baseContent);\n        if (oursChanged) {\n          // Conflict: we modified, they deleted\n          conflicts.push({\n            documentId: docId,\n            path: '',\n            base: baseContent!,\n            ours: ourContent!,\n            theirs: undefined, // deleted\n          });\n          hasConflicts = true;\n          merged[docId] = deepClone(ourContent) as object;\n        } else {\n          // We didn't change it, so their deletion is accepted\n          docsToDelete.push(docId);\n        }\n        continue;\n      }\n\n      // Both not deleted — perform three-way merge on the document content\n\n      // First check if either side actually changed the document\n      const oursChanged = !deepEqual(ourContent, baseContent);\n      const theirsChanged = !deepEqual(theirContent, baseContent);\n\n      if (!oursChanged && !theirsChanged) {\n        // Neither side changed it — skip\n        continue;\n      }\n\n      const tempConflicts: Conflict[] = [];\n      const mergedContent = threeWayMerge(\n        baseContent,\n        ourContent,\n        theirContent,\n        '',\n        tempConflicts,\n      );\n\n      // Assign documentId to any conflicts generated\n      for (const c of tempConflicts) {\n        c.documentId = docId;\n      }\n\n      if (tempConflicts.length > 0) {\n        hasConflicts = true;\n        conflicts.push(...tempConflicts);\n      }\n\n      merged[docId] = deepClone(mergedContent) as object;\n    }\n\n    // Apply merge if no conflicts\n    if (!hasConflicts) {\n      this.applyMerge(targetBranch, sourceBranch, merged, docsToDelete);\n      return { merged, conflicts: [], applied: true };\n    }\n\n    return { merged, conflicts, applied: false };\n  }\n\n  private getCurrentDocs(): Map<string, DocState> {\n    return this.branchDocs.get(this.currentBranchName)!;\n  }\n\n  private getCurrentHistory(): Map<string, Version[]> {\n    return this.branchHistory.get(this.currentBranchName)!;\n  }\n\n  private getDocOrThrow(id: string): DocState {\n    const docs = this.getCurrentDocs();\n    const doc = docs.get(id);\n    if (!doc || doc.deleted) {\n      throw new Error(`Document \"${id}\" not found on branch \"${this.currentBranchName}\"`);\n    }\n    return doc;\n  }\n\n  private createVersion(docId: string, content: object): InternalVersion {\n    this.versionCounter++;\n    const id = `v${this.versionCounter}`;\n    const timestamp = Date.now();\n    const version: InternalVersion = { id, timestamp, docId, content };\n    this.versions.set(id, version);\n\n    // Also track in document-level global history\n    let docVersions = this.docVersionsForHistory.get(docId);\n    if (!docVersions) {\n      docVersions = [];\n      this.docVersionsForHistory.set(docId, docVersions);\n    }\n    docVersions.push(version);\n\n    return version;\n  }\n\n  private addToBranchHistory(docId: string, version: InternalVersion): void {\n    const history = this.getCurrentHistory();\n    let docHistory = history.get(docId);\n    if (!docHistory) {\n      docHistory = [];\n      history.set(docId, docHistory);\n    }\n    docHistory.push({\n      id: version.id,\n      timestamp: version.timestamp,\n      content: version.content,\n    });\n  }\n\n  private findBaseSnapshot(sourceBranch: string, targetBranch: string): Map<string, DocState> {\n    // Case 1: target is direct parent of source\n    const sourceBp = this.branchPoints.get(sourceBranch);\n    if (sourceBp?.parent === targetBranch) {\n      return sourceBp.snapshot;\n    }\n\n    // Case 2: source is direct parent of target\n    const targetBp = this.branchPoints.get(targetBranch);\n    if (targetBp?.parent === sourceBranch) {\n      return targetBp.snapshot;\n    }\n\n    // Case 3: both share a common ancestor — walk up from source to find target or a branch that is an ancestor of target\n    const sourceAncestors = this.getAncestorChain(sourceBranch);\n    const targetAncestors = this.getAncestorChain(targetBranch);\n\n    // Find the LCA by checking which ancestor of source is also an ancestor of target\n    for (let i = 0; i < sourceAncestors.length; i++) {\n      const ancestor = sourceAncestors[i];\n      if (targetAncestors.includes(ancestor)) {\n        // Found LCA. Get the snapshot from the branch that was created FROM the LCA.\n        // That's the child of the LCA in the source chain (or target chain, whichever is closest)\n        if (i > 0) {\n          const childOfLca = sourceAncestors[i - 1];\n          const childBp = this.branchPoints.get(childOfLca);\n          if (childBp) return childBp.snapshot;\n        }\n        // If LCA is the branch itself (for one side), use the other side's branch point\n        const targetIdx = targetAncestors.indexOf(ancestor);\n        if (targetIdx > 0) {\n          const childOfLca = targetAncestors[targetIdx - 1];\n          const childBp = this.branchPoints.get(childOfLca);\n          if (childBp) return childBp.snapshot;\n        }\n        // LCA is both branches themselves — they're the same branch, shouldn't happen\n        return new Map();\n      }\n    }\n\n    // Fallback: return empty (no common ancestor found)\n    return new Map();\n  }\n\n  private getAncestorChain(branch: string): string[] {\n    const chain: string[] = [];\n    let current: string | undefined = branch;\n    while (current) {\n      chain.push(current);\n      const bp = this.branchPoints.get(current);\n      current = bp?.parent;\n    }\n    return chain;\n  }\n\n  private applyMerge(targetBranch: string, sourceBranch: string, merged: Record<string, object>, docsToDelete: string[]): void {\n    const targetDocs = this.branchDocs.get(targetBranch)!;\n\n    for (const [docId, content] of Object.entries(merged)) {\n      targetDocs.set(docId, {\n        content: deepClone(content),\n        deleted: false,\n        currentVersionId: null,\n      });\n    }\n\n    // Apply deletions from the merge\n    for (const docId of docsToDelete) {\n      const doc = targetDocs.get(docId);\n      if (doc && !doc.deleted) {\n        doc.deleted = true;\n        doc.content = null;\n      }\n    }\n  }\n}\n\nexport * from './types.js';\n","numLines":479,"startLine":1,"totalLines":479}}}
