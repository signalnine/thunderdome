 }\n        } else if (oursCreated) {","originalFile":"import { Version, MergeResult, Conflict, DocumentStore as IDocumentStore } from './types.js';\nimport { deepClone, deepEqual, threeWayMerge } from './utils.js';\n\ninterface DocState {\n  content: object | null;\n  deleted: boolean;\n  currentVersionId: string | null;\n}\n\ninterface BranchPoint {\n  parent: string;\n  snapshot: Map<string, DocState>;\n}\n\ninterface InternalVersion {\n  id: string;\n  timestamp: number;\n  docId: string;\n  content: object;\n}\n\nexport class DocumentStore implements IDocumentStore {\n  private versionCounter = 0;\n  private versions: Map<string, InternalVersion> = new Map();\n  private docVersionsForHistory: Map<string, InternalVersion[]> = new Map();\n\n  // Per-branch document state: branchName -> docId -> DocState\n  private branchDocs: Map<string, Map<string, DocState>> = new Map();\n\n  // Per-branch version history: branchName -> docId -> Version[]\n  private branchHistory: Map<string, Map<string, Version[]>> = new Map();\n\n  // Branch point tracking: branchName -> BranchPoint\n  private branchPoints: Map<string, BranchPoint> = new Map();\n\n  private currentBranchName: string = 'main';\n\n  constructor() {\n    this.branchDocs.set('main', new Map());\n    this.branchHistory.set('main', new Map());\n  }\n\n  create(id: string, content: object): void {\n    const docs = this.getCurrentDocs();\n    const existing = docs.get(id);\n\n    if (existing && !existing.deleted) {\n      throw new Error(`Document \"${id}\" already exists on branch \"${this.currentBranchName}\"`);\n    }\n\n    const clonedContent = deepClone(content);\n    const version = this.createVersion(id, clonedContent);\n\n    docs.set(id, {\n      content: clonedContent,\n      deleted: false,\n      currentVersionId: version.id,\n    });\n\n    this.addToBranchHistory(id, version);\n  }\n\n  get(id: string): object {\n    const doc = this.getDocOrThrow(id);\n    return deepClone(doc.content!);\n  }\n\n  update(id: string, content: object): void {\n    const doc = this.getDocOrThrow(id);\n    const clonedContent = deepClone(content);\n    const version = this.createVersion(id, clonedContent);\n\n    doc.content = clonedContent;\n    doc.currentVersionId = version.id;\n\n    this.addToBranchHistory(id, version);\n  }\n\n  delete(id: string): void {\n    const docs = this.getCurrentDocs();\n    const doc = docs.get(id);\n\n    if (!doc || doc.deleted) {\n      throw new Error(`Document \"${id}\" not found on branch \"${this.currentBranchName}\"`);\n    }\n\n    doc.deleted = true;\n    doc.content = null;\n    // Note: delete does NOT create a version\n  }\n\n  getHistory(id: string): Version[] {\n    const history = this.getCurrentHistory();\n    const docHistory = history.get(id);\n    if (!docHistory) {\n      throw new Error(`Document \"${id}\" not found on branch \"${this.currentBranchName}\"`);\n    }\n    // Return chronological order (oldest first) — already stored in order\n    return docHistory.map(v => ({\n      id: v.id,\n      timestamp: v.timestamp,\n      content: deepClone(v.content),\n    }));\n  }\n\n  getVersion(id: string, versionId: string): object {\n    const docVersions = this.docVersionsForHistory.get(id);\n    if (!docVersions) {\n      throw new Error(`Document \"${id}\" not found`);\n    }\n\n    const version = this.versions.get(versionId);\n    if (!version || version.docId !== id) {\n      throw new Error(`Version \"${versionId}\" not found for document \"${id}\"`);\n    }\n\n    return deepClone(version.content);\n  }\n\n  createBranch(name: string, fromBranch?: string): void {\n    if (this.branchDocs.has(name)) {\n      throw new Error(`Branch \"${name}\" already exists`);\n    }\n\n    const sourceBranch = fromBranch ?? this.currentBranchName;\n    if (!this.branchDocs.has(sourceBranch)) {\n      throw new Error(`Source branch \"${sourceBranch}\" does not exist`);\n    }\n\n    const sourceDocs = this.branchDocs.get(sourceBranch)!;\n    const sourceHistory = this.branchHistory.get(sourceBranch)!;\n\n    // Deep clone document state\n    const newDocs: Map<string, DocState> = new Map();\n    for (const [docId, state] of sourceDocs) {\n      newDocs.set(docId, {\n        content: state.content ? deepClone(state.content) as object : null,\n        deleted: state.deleted,\n        currentVersionId: state.currentVersionId,\n      });\n    }\n    this.branchDocs.set(name, newDocs);\n\n    // Deep clone history\n    const newHistory: Map<string, Version[]> = new Map();\n    for (const [docId, versions] of sourceHistory) {\n      newHistory.set(docId, versions.map(v => ({\n        id: v.id,\n        timestamp: v.timestamp,\n        content: deepClone(v.content),\n      })));\n    }\n    this.branchHistory.set(name, newHistory);\n\n    // Record branch point (snapshot of parent at creation time)\n    const snapshot: Map<string, DocState> = new Map();\n    for (const [docId, state] of sourceDocs) {\n      snapshot.set(docId, {\n        content: state.content ? deepClone(state.content) as object : null,\n        deleted: state.deleted,\n        currentVersionId: state.currentVersionId,\n      });\n    }\n    this.branchPoints.set(name, { parent: sourceBranch, snapshot });\n  }\n\n  switchBranch(name: string): void {\n    if (!this.branchDocs.has(name)) {\n      throw new Error(`Branch \"${name}\" does not exist`);\n    }\n    this.currentBranchName = name;\n  }\n\n  getBranch(): string {\n    return this.currentBranchName;\n  }\n\n  listBranches(): string[] {\n    return Array.from(this.branchDocs.keys());\n  }\n\n  merge(sourceBranch: string): MergeResult {\n    if (sourceBranch === this.currentBranchName) {\n      return { merged: {}, conflicts: [], applied: true };\n    }\n\n    const targetBranch = this.currentBranchName;\n\n    if (!this.branchDocs.has(sourceBranch)) {\n      throw new Error(`Branch \"${sourceBranch}\" does not exist`);\n    }\n\n    const sourceDocs = this.branchDocs.get(sourceBranch