+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_hc2fqK8V2PIt8JluvMQ55027","type":"tool_result","content":"1\timport { Version, MergeResult, Conflict, DocumentStore as IDocumentStore } from './types.js';\n2\timport { deepClone, deepEqual, threeWayMerge } from './utils.js';\n3\t\n4\tinterface DocState {\n5\t  content: object | null;\n6\t  deleted: boolean;\n7\t  currentVersionId: string | null;\n8\t}\n9\t\n10\tinterface BranchPoint {\n11\t  parent: string;\n12\t  snapshot: Map<string, DocState>;\n13\t}\n14\t\n15\tinterface InternalVersion {\n16\t  id: string;\n17\t  timestamp: number;\n18\t  docId: string;\n19\t  content: object;\n20\t}\n21\t\n22\texport class DocumentStore implements IDocumentStore {\n23\t  private versionCounter = 0;\n24\t  private versions: Map<string, InternalVersion> = new Map();\n25\t  private docVersionsForHistory: Map<string, InternalVersion[]> = new Map();\n26\t\n27\t  // Per-branch document state: branchName -> docId -> DocState\n28\t  private branchDocs: Map<string, Map<string, DocState>> = new Map();\n29\t\n30\t  // Per-branch version history: branchName -> docId -> Version[]\n31\t  private branchHistory: Map<string, Map<string, Version[]>> = new Map();\n32\t\n33\t  // Branch point tracking: branchName -> BranchPoint\n34\t  private branchPoints: Map<string, BranchPoint> = new Map();\n35\t\n36\t  private currentBranchName: string = 'main';\n37\t\n38\t  constructor() {\n39\t    this.branchDocs.set('main', new Map());\n40\t    this.branchHistory.set('main', new Map());\n41\t  }\n42\t\n43\t  create(id: string, content: object): void {\n44\t    const docs = this.getCurrentDocs();\n45\t    const existing = docs.get(id);\n46\t\n47\t    if (existing && !existing.deleted) {\n48\t      throw new Error(`Document \"${id}\" already exists on branch \"${this.currentBranchName}\"`);\n49\t    }\n50\t\n51\t    const clonedContent = deepClone(content);\n52\t    const version = this.createVersion(id, clonedContent);\n53\t\n54\t    docs.set(id, {\n55\t      content: clonedContent,\n56\t      deleted: false,\n57\t      currentVersionId: version.id,\n58\t    });\n59\t\n60\t    this.addToBranchHistory(id, version);\n61\t  }\n62\t\n63\t  get(id: string): object {\n64\t    const doc = this.getDocOrThrow(id);\n65\t    return deepClone(doc.content!);\n66\t  }\n67\t\n68\t  update(id: string, content: object): void {\n69\t    const doc = this.getDocOrThrow(id);\n70\t    const clonedContent = deepClone(content);\n71\t    const version = this.createVersion(id, clonedContent);\n72\t\n73\t    doc.content = clonedContent;\n74\t    doc.currentVersionId = version.id;\n75\t\n76\t    this.addToBranchHistory(id, version);\n77\t  }\n78\t\n79\t  delete(id: string): void {\n80\t    const docs = this.getCurrentDocs();\n81\t    const doc = docs.get(id);\n82\t\n83\t    if (!doc || doc.deleted) {\n84\t      throw new Error(`Document \"${id}\" not found on branch \"${this.currentBranchName}\"`);\n85\t    }\n86\t\n87\t    doc.deleted = true;\n88\t    doc.content = null;\n89\t    // Note: delete does NOT create a version\n90\t  }\n91\t\n92\t  getHistory(id: string): Version[] {\n93\t    const history = this.getCurrentHistory();\n94\t    const docHistory = history.get(id);\n95\t    if (!docHistory) {\n96\t      throw new Error(`Document \"${id}\" not found on branch \"${this.currentBranchName}\"`);\n97\t    }\n98\t    // Return chronological order (oldest first) — already stored in order\n99\t    return docHistory.map(v => ({\n100\t      id: v.id,\n101\t      timestamp: v.timestamp,\n102\t      content: deepClone(v.content),\n103\t    }));\n104\t  }\n105\t\n106\t  getVersion(id: string, versionId: string): object {\n107\t    const docVersions = this.docVersionsForHistory.get(id);\n108\t    if (!docVersions) {\n109\t      throw new Error(`Document \"${id}\" not found`);\n110\t    }\n111\t\n112\t    const version = this.versions.get(versionId);\n113\t    if (!version || version.docId !== id) {\n114\t      throw new Error(`Version \"${versionId}\" not found for document \"${id}\"`);\n115\t    }\n116\t\n117\t    return deepClone(version.content);\n118\t  }\n119\t\n120\t  createBranch(name: string, fromBranch?: string): void {\n121\t    if (this.branchDocs.has(name)) {\n122\t      throw new Error(`Branch \"${name}\" already exists`);\n123\t    }\n124\t\n125\t    const sourceBranch = fromBranch ?? this.currentBranchName;\n126\t    if (!this.branchDocs.has(sourceBranch)) {\n127\t      throw new Error(`Source branch \"${sourceBranch}\" does not exist`);\n128\t    }\n129\t\n130\t    const sourceDocs = this.branchDocs.get(sourceBranch)!;\n131\t    const sourceHistory = this.branchHistory.get(sourceBranch)!;\n132\t\n133\t    // Deep clone document state\n134\t    const newDocs: Map<string, DocState> = new Map();\n135\t    for (const [docId, state] of sourceDocs) {\n136\t      newDocs.set(docId, {\n137\t        content: state.content ? deepClone(state.content) as object : null,\n138\t        deleted: state.deleted,\n139\t        currentVersionId: state.currentVersionId,\n140\t      });\n141\t    }\n142\t    this.branchDocs.set(name, newDocs);\n143\t\n144\t    // Deep clone history\n145\t    const newHistory: Map<string, Version[]> = new Map();\n146\t    for (const [docId, versions] of sourceHistory) {\n147\t      newHistory.set(docId, versions.map(v => ({\n148\t        id: v.id,\n149\t        timestamp: v.timestamp,\n150\t        content: deepClone(v.content),\n151\t      })));\n152\t    }\n153\t    this.branchHistory.set(name, newHistory);\n154\t\n155\t    // Record branch point (snapshot of parent at creation time)\n156\t    const snapshot: Map<string, DocState> = new Map();\n157\t    for (const [docId, state] of sourceDocs) {\n158\t      snapshot.set(docId, {\n159\t        content: state.content ? deepClone(state.content) as object : null,\n160\t        deleted: state.deleted,\n161\t        currentVersionId: state.currentVersionId,\n162\t      });\n163\t    }\n164\t    this.branchPoints.set(name, { parent: sourceBranch, snapshot });\n165\t  }\n166\t\n167\t  switchBranch(name: string): void {\n168\t    if (!this.branchDocs.has(name)) {\n169\t      throw new Error(`Branch \"${name}\" does not exist`);\n170\t    }\n171\t    this.currentBranchName = name;\n172\t  }\n173\t\n174\t  getBranch(): string {\n175\t    return this.currentBranchName;\n176\t  }\n177\t\n178\t  listBranches(): string[] {\n179\t    return Array.from(this.branchDocs.keys());\n180\t  }\n181\t\n182\t  merge(sourceBranch: string): MergeResult {\n183\t    if (sourceBranch === this.currentBranchName) {\n184\t      return { merged: {}, conflicts: [], applied: true };\n185\t    }\n186\t\n187\t    const targetBranch = this.currentBranchName;\n188\t\n189\t    if (!this.branchDocs.has(sourceBranch)) {\n190\t      throw new Error(`Branch \"${sourceBranch}\" does not exist`);\n191\t    }\n192\t\n193\t    const sourceDocs = this.branchDocs.get(sourceBranch)!;\n194\t    const targetDocs = this.branchDocs.get(targetBranch)!;\n195\t\n196\t    // Find the common ancestor state\n197\t    const baseSnapshot = this.findBaseSnapshot(sourceBranch, targetBranch);\n198\t\n199\t    // Collect all document IDs from source and target (non-deleted)\n200\t    const allDocIds = new Set<string>();\n201\t    for (const [docId, state] of sourceDocs) {\n202\t      if (!state.deleted) allDocIds.add(docId);\n203\t    }\n204\t    for (const [docId, state] of targetDocs) {\n205\t      if (!state.deleted) allDocIds.add(docId);\n206\t    }\n207\t\n208\t    const merged: Record<string, object> = {};\n209\t    const conflicts: Conflict[] = [];\n210\t    const docsToDelete: string[] = [];\n211\t    let hasConflicts = false;\n212\t\n213\t    for (const docId of allDocIds) {\n214\t      const ourState = targetDocs.get(docId);\n215\t      const theirState = sourceDocs.get(docId);\n216\t      const baseState = baseSnapshot.get(docId);\n217\t\n218\t      const baseContent = baseState?.content ?? undefined;\n219\t      const ourConten