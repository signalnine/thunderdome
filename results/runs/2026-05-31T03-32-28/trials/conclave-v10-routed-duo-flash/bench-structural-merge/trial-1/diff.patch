);\n      expect(result.conflicts[0].path).toBe('a.b.c');\n    });\n  });\n\n  // ===== 6. Merging — Multiple Documents =====\n\n  describe('Merging — Multiple Documents', () => {\n    it('should merge different documents cleanly across branches', () => {\n      store.create('doc1', { a: 1 });\n      store.create('doc2', { b: 2 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 99 });\n      store.switchBranch('feature');\n      store.update('doc2', { b: 99 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(store.get('doc1')).toEqual({ a: 99 });\n      expect(store.get('doc2')).toEqual({ b: 99 });\n    });\n  });\n\n  // ===== 7. Edge Cases =====\n\n  describe('Edge Cases', () => {\n    it('should merge empty source branch', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('empty-feature');\n      const result = store.merge('empty-feature');\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('should handle array fields as whole values', () => {\n      store.create('doc1', { arr: [1, 2] });\n      store.createBranch('feature');\n      store.update('doc1', { arr: [1, 2, 3] });\n      store.switchBranch('feature');\n      store.update('doc1', { arr: [1, 2] });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      // Main changed arr to [1,2,3], feature didn't change from base\n      // Since theirs (feature) === base, take ours: [1,2,3]\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ arr: [1, 2, 3] });\n    });\n\n    it('should handle null field values', () => {\n      store.create('doc1', { a: null });\n      store.createBranch('feature');\n      store.update('doc1', { a: 1 });\n      store.switchBranch('feature');\n      // Keep a=null on feature (no change)\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      // Main changed a to 1, feature kept null = base = null\n      // Only ours changed -> take ours: a=1\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('should prevent cross-branch mutation through clones', () => {\n      store.create('doc1', { a: { b: 1 } });\n      store.createBranch('feature');\n      const onMain = store.get('doc1') as Record<string, any>;\n      onMain.a.b = 99;\n      store.switchBranch('feature');\n      const onFeature = store.get('doc1') as Record<string, any>;\n      expect(onFeature.a.b).toBe(1);\n    });\n  });\n\n  // ===== 8. Merge Edge Cases =====\n\n  describe('Merge Edge Cases', () => {\n    it('should handle merge of current branch into itself', () => {\n      const result = store.merge('main');\n      expect(result.applied).toBe(true);\n      expect(result.merged).toEqual({});\n      expect(result.conflicts).toEqual([]);\n    });\n\n    it('should merge from a branch that off a non-main branch', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 2 });\n      store.createBranch('subfeature');\n      store.switchBranch('subfeature');\n      store.update('doc1', { a: 3 });\n      store.switchBranch('feature');\n      const result = store.merge('subfeature');\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 3 });\n    });\n\n    it('should merge from a branch created with fromBranch', () => {\n      store.create('doc1', { a: 1 });\n      store.create('doc2', { b: 2 });\n      store.createBranch('feature', 'main');\n      store.switchBranch('feature');\n      store.create('doc3', { c: 3 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(store.get('doc3')).toEqual({ c: 3 });\n    });\n\n    it('should throw merge for nonexistent branch', () => {\n      expect(() => store.merge('nonexistent')).toThrow();\n    });\n\n    it('should handle both branches modifying different fields', () => {\n      store.create('doc1', { a: 1, b: 2 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 99, b: 2 });\n      store.switchBranch('feature');\n      store.update('doc1', { a: 1, b: 99 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 99, b: 99 });\n    });\n\n    it('should conflict when both add same new field with different values', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 1, b: 2 });\n      store.switchBranch('feature');\n      store.update('doc1', { a: 1, b: 3 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(false);\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].path).toBe('b');\n    });\n\n    it('should merge when both add different new fields', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 1, b: 2 });\n      store.switchBranch('feature');\n      store.update('doc1', { a: 1, c: 3 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 1, b: 2, c: 3 });\n    });\n\n    it('should handle deeply nested multi-field merge without conflict', () => {\n      store.create('doc1', { a: { b: { c: 1, d: 2 }, e: 3 } });\n      store.createBranch('feature');\n      store.update('doc1', { a: { b: { c: 99, d: 2 }, e: 3 } });\n      store.switchBranch('feature');\n      store.update('doc1', { a: { b: { c: 1, d: 99 }, e: 3 } });\n 