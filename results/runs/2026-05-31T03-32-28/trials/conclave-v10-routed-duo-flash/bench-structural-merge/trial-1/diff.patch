.create('newdoc', { y: 2 });\n      const result = store.merge('feature');\n      expect(result.applied).toBe(false);\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].documentId).toBe('newdoc');\n      expect(result.conflicts[0].ours).toEqual({ y: 2 });\n      expect(result.conflicts[0].theirs).toEqual({ x: 1 });\n    });\n\n    it('should not double-report conflicts when both create same document', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('newdoc', { x: 1 });\n      store.switchBranch('main');\n      store.create('newdoc', { y: 2 });\n      const result = store.merge('feature');\n      // Should have exactly 1 conflict, not 2\n      expect(result.conflicts).toHaveLength(1);\n    });","originalFile":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { DocumentStore } from '../src/index.js';\n\ndescribe('DocumentStore', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  // ===== 1. Document CRUD =====\n\n  describe('CRUD', () => {\n    it('should create and get a document', () => {\n      store.create('doc1', { a: 1 });\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('should throw on create with duplicate ID', () => {\n      store.create('doc1', { a: 1 });\n      expect(() => store.create('doc1', { a: 2 })).toThrow(/already exists/i);\n    });\n\n    it('should allow re-creating a document after deletion', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      store.create('doc1', { b: 2 });\n      expect(store.get('doc1')).toEqual({ b: 2 });\n    });\n\n    it('should return a deep clone from get()', () => {\n      store.create('doc1', { a: { b: 1 } });\n      const obj = store.get('doc1') as Record<string, any>;\n      obj.a.b = 99;\n      expect((store.get('doc1') as Record<string, any>).a.b).toBe(1);\n    });\n\n    it('should throw get() if not found', () => {\n      expect(() => store.get('nonexistent')).toThrow(/not found/i);\n    });\n\n    it('should throw get() if deleted', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow(/not found/i);\n    });\n\n    it('should update content', () => {\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { b: 2 });\n      expect(store.get('doc1')).toEqual({ b: 2 });\n    });\n\n    it('should throw update() if not found', () => {\n      expect(() => store.update('nonexistent', { a: 1 })).toThrow(/not found/i);\n    });\n\n    it('should throw update() if deleted', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.update('doc1', { b: 2 })).toThrow(/not found/i);\n    });\n\n    it('should delete a document', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow(/not found/i);\n    });\n\n    it('should throw delete() if not found', () => {\n      expect(() => store.delete('nonexistent')).toThrow(/not found/i);\n    });\n\n    it('should throw delete() if already deleted', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.delete('doc1')).toThrow(/not found/i);\n    });\n\n    it('should deep clone content on create', () => {\n      const obj = { a: { b: 1 } };\n      store.create('doc1', obj);\n      obj.a.b = 99;\n      expect((store.get('doc1') as Record<string, any>).a.b).toBe(1);\n    });\n\n    it('should deep clone content on update', () => {\n      store.create('doc1', { a: 1 });\n      const obj = { b: { c: 2 } };\n      store.update('doc1', obj);\n      obj.b.c = 99;\n      expect((store.get('doc1') as Record<string, any>).b.c).toBe(2);\n    });\n  });\n\n  // ===== 2. Version History =====\n\n  describe('Version History', () => {\n    it('should generate a version on create', () => {\n      store.create('doc1', { a: 1 });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(1);\n      expect(history[0].content).toEqual({ a: 1 });\n    });\n\n    it('should generate versions on each update', () => {\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { b: 2 });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(2);\n    });\n\n    it('should NOT generate a version on delete', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(1);\n    });\n\n    it('should return versions in chronological order (oldest first)', () => {\n      store.create('doc1', { v: 1 });\n      store.update('doc1', { v: 2 });\n      store.update('doc1', { v: 3 });\n      const history = store.getHistory('doc1');\n      expect(history[0].content).toEqual({ v: 1 });\n      expect(history[1].content).toEqual({ v: 2 });\n      expect(history[2].content).toEqual({ v: 3 });\n    });\n\n    it('should have id, timestamp, content on each version', () => {\n      store.create('doc1', { a: 1 });\n      const v = store.getHistory('doc1')[0];\n      expect(typeof v.id).toBe('string');\n      expect(typeof v.timestamp).toBe('number');\n      expect(v.timestamp).toBeGreaterThan(0);\n      expect(typeof v.content).toBe('object');\n    });\n\n    it('should have unique version IDs', () => {\n      store.create('doc1', { a: 1 });\n      store.create('doc2', { b: 2 });\n      store.update('doc1', { c: 3 });\n      const h1 = store.getHistory('doc1');\n      const h2 = store.getHistory('doc2');\n      const ids = [...h1, ...h2].map(v => v.id);\n      expect(new Set(ids).size).toBe(ids.length);\n    });\n\n    it('should return specific version content via getVersion', () => {\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { b: 2 });\n      const h = store.getHistory('doc1');\n      const v1 = store.getVersion('doc1', h[0].id);\n      expect(v1).toEqual({ a: 1 });\n      const v2 = store.getVersion('doc1', h[1].id);\n      expect(v2).toEqual({ b: 2 });\n    });\n\n    it('should deep clone getVersion result', () => {\n      store.create('doc1', { a: { b: 1 } });\n      const h = store.getHistory('doc1');\n      const v = store.getVersion('doc1', h[0].id) as Record<string, any>;\n      v.a.b = 99;\n      const v2 = store.getVersion('doc1', h[0].id) as Record<string, any>;\n      expect(v2.a.b).toBe(1);\n    });\n\n    it('should throw getVersion with bad version ID', () => {\n      store.create('doc1', { a: 1 });\n      expect(() => store.getVersion('doc1', 'nonexistent')).toThrow();\n    });\n\n    it('should throw getVersion with bad document ID', () => {\n      expect(() => store.getVersion('nonexistent', 'v1')).toThrow();\n    });\n\n    it('should isolate version history across branches', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { b: 2 });\n      store.switchBranch('main');\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(1);\n      expect(history[0].content).toEqual({ a: 1 });\n    });\n  });\n\n  // ===== 3. Branching =====\n\n  describe('Branching', () => {\n    it('should start with main branch', () => {\n      expect(store.getBranch()).toBe('main');\n    });\n\n    it('should create a branch from current state', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('should create a branch from specified branch', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature', 'main');\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('should isolate CRUD after switchBranch', () => {\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc1', { a: 1 });\n      store.switchBranch('main');\n      expect(() => store.get('doc1')).toThrow();\n    });\n\n    it('should isolate updates across branches', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { b: 2 });\n      store.switchBranch('main');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('should isolate deletes across branches', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.delete('doc1');\n      store.switchBranch('main');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('should list all branches', () => {\n      expect(store.listBranches()).toEqual(['main']);\n      store.createBranch('feature1');\n      store.createBranch('feature2');\n      const branches = store.listBranches();\n      expect(branches).toContain('main');\n      expect(branches).toContain('feature1');\n      expect(branches).toContain('feature2');\n    });\n\n    it('should get current branch name', () => {\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(store.getBranch()).toBe('feature');\n    });\n\n    it('should throw switchBranch for nonexistent branch', () => {\n      expect(() => store.switchBranch('nonexistent')).toThrow();\n    });\n\n    it('should throw createBranch for existing branch', () => {\n      expect(() => store.createBranch('main')).toThrow();\n    });\n\n    it('should create branch from non-main branch', () => {\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc1', { a: 1 });\n      store.createBranch('subfeature');\n      store.switchBranch('subfeature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n  });\n\n  // ===== 4. Merging — Basic =====\n\n  describe('Merging — Basic', () => {\n    it('should return no-op when merging with no changes', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(result.merged).toEqual({});\n      expect(result.conflicts).toEqual([]);\n    });\n\n    it('should pick up changes from source branch', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 2 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 2 });\n    });\n\n    it('should auto-apply merge with no conflicts', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 2 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 2 });\n    });\n\n    it('should not modify source branch after merge', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 2 });\n      store.switchBranch('main');\n      store.merge('feature');\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 2 });\n    });\n\n    it('should add new documents from source', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc2', { b: 2 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(store.get('doc2')).toEqual({ b: 2 });\n    });\n\n    it('should propagate deletions from source', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.delete('doc1');\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(() => store.get('doc1')).toThrow();\n    });\n  });\n\n  // ===== 5. Merging — Three-Way Structural =====\n\n  describe('Merging — Three-Way Structural', () => {\n    it('should take the only-changed-side value', () => {\n      store.create('doc1', { a: 1, b: 2 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 1, b: 99 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 1, b: 99 });\n      expect(result.conflicts).toHaveLength(0);\n    });\n\n    it('should handle both sides changing same field to same value (no conflict)', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 99 });\n      store.switchBranch('feature');\n      store.update('doc1', { a: 99 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 99 });\n      expect(result.conflicts).toHaveLength(0);\n    });\n\n    it('should report conflict when both change same field to different values', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 2 });\n      store.switchBranch('feature');\n      store.update('doc1', { a: 3 });\n      store.switchBranch('main');\n      const result = store.merge('feature');\n      expect(result.applied).toBe(false);\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].documentId).toBe('do