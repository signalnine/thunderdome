ches were created (for merge-base resolution) */\n  private branchRecords: Map<string, BranchRecord> = new Map();\n\n  /** The currently active branch name */\n  private activeBranch = 'main';\n\n  /** Global counter for version IDs */\n  private versionCounter = 0;\n\n  constructor() {\n    this.branches.set('main', new Map());\n    this.branchRecords.set('main', {\n      name: 'main',\n      parent: null,\n      forkBase: new Map(),\n    });\n  }\n\n  // ── Document CRUD ──────────────────────────────────────────────────────\n\n  create(id: string, content: Record<string, unknown>): void {\n    const branch = this.getActiveBranchState();\n    if (branch.has(id)) {\n      const doc = branch.get(id)!;\n      if (!doc.deleted) {\n        throw new Error(`Document \"${id}\" already exists on branch \"${this.activeBranch}\"`);\n      }\n      // If it was deleted, we \"resurrect\" it\n    }\n\n    const cloned = deepClone(content);\n    const version = this.createVersion(cloned);\n\n    branch.set(id, {\n      content: cloned,\n      versions: [version],\n      deleted: false,\n    });\n  }\n\n  get(id: string): Record<string, unknown> {\n    const doc = this.getExistingDocument(id);\n    return deepClone(doc.content!);\n  }\n\n  update(id: string, content: Record<string, unknown>): void {\n    const doc = this.getExistingDocument(id);\n    const cloned = deepClone(content);\n    const version = this.createVersion(cloned);\n\n    doc.content = cloned;\n    doc.versions.push(version);\n    doc.deleted = false;\n  }\n\n  delete(id: string): void {\n    const doc = this.getExistingDocument(id);\n    doc.deleted = true;\n    doc.content = null;\n  }\n\n  // ── Version History ────────────────────────────────────────────────────\n\n  getHistory(id: string): Version[] {\n    const doc = this.getDocumentOrThrow(id);\n    return doc.versions.map(v => ({\n      id: v.id,\n      timestamp: v.timestamp,\n      content: deepClone(v.content),\n    }));\n  }\n\n  getVersion(id: string, versionId: string): Record<string, unknown> {\n    const doc = this.getDocumentOrThrow(id);\n    const version = doc.versions.find(v => v.id === versionId);\n    if (!version) {\n      throw new Error(`Version \"${versionId}\" not found for document \"${id}\"`);\n    }\n    return deepClone(version.content as Record<string, unknown>);\n  }\n\n  // ── Branching ──────────────────────────────────────────────────────────\n\n  createBranch(name: string, fromBranch?: string): void {\n    if (this.branchRecords.has(name)) {\n      throw new Error(`Branch \"${name}\" already exists`);\n    }\n\n    const source = fromBranch ?? this.activeBranch;\n    if (!this.branchRecords.has(source)) {\n      throw new Error(`Source branch \"${source}\" does not exist`);\n    }\n\n    const sourceState = this.branches.get(source)!;\n\n    // Deep clone all documents from source branch\n    const newBranchState = new Map<string, DocumentState>();\n    const forkBase = new Map<string, ForkDocumentState>();\n\n    for (const [docId, docState] of sourceState) {\n      newBranchState.set(docId, {\n        content: deepClone(docState.content),\n        versions: docState.versions.map(v => ({\n          id: v.id,\n          timestamp: v.timestamp,\n          content: deepClone(v.content),\n        })),\n        deleted: docState.deleted,\n      });\n\n      forkBase.set(docId, {\n        content: deepClone(docState.content),\n        deleted: docState.deleted,\n      });\n    }\n\n    this.branches.set(name, newBranchState);\n    this.branchRecords.set(name, {\n      name,\n      parent: source,\n      forkBase,\n    });\n  }\n\n  switchBranch(name: string): void {\n    if (!this.branchRecords.has(name)) {\n      throw new Error(`Branch \"${name}\" does not exist`);\n    }\n    this.activeBranch = name;\n  }\n\n  getBranch(): string {\n    return this.activeBranch;\n  }\n\n  listBranches(): string[] {\n    return Array.from(this.branchRecords.keys());\n  }\n\n  // ── Merging ────────────────────────────────────────────────────────────\n\n  merge(sourceBranch: string): MergeResult {\n    if (!this.branchRecords.has(sourceBranch)) {\n      throw new Error(`Source branch \"${sourceBranch}\" does not exist`);\n    }\n\n    if (sourceBranch === this.activeBranch) {\n      // Merging same branch — no-op\n      const merged: Record<string, unknown> = {};\n      const targetState = this.getActiveBranchState();\n      for (const [docId, doc] of targetState) {\n        if (!doc.deleted) {\n          merged[docId] = deepClone(doc.content!);\n        }\n      }\n      return { merged, conflicts: [], applied: true };\n    }\n\n    // Find the merge base (common ancestor state)\n    const baseSnapshot = this.findMergeBase(this.activeBranch, sourceBranch);\n\n    // Get current state of target (ours) and source (theirs)\n    const targetState = this.getActiveBranchState();\n    const sourceState = this.branches.get(sourceBranch)!;\n\n    // Collect all document IDs from base, target, and source\n    const allDocIds = new Set<string>();\n    const addIds = (state: Map<string, unknown>) => {\n      for (const id of state.keys()) {\n        allDocIds.add(id);\n      }\n    };\n    addIds(baseSnapshot as Map<string, unknown>);\n    stateToIds(targetState);\n    stateToIds(sourceState);\n\n    const allConflicts: Conflict[] = [];\n    const merged: Record<string, unknown> = {};\n\n    for (const docId of allDocIds) {\n      const baseDoc = baseSnapshot.get(docId) ?? null;\n      const targetDoc = targetState.get(docId) ?? null;\n      const sourceDoc = sourceState.get(docId) ?? null;\n\n      const baseContent = baseDoc?.deleted ? null : (baseDoc?.content ?? null);\n      const oursContent = targetDoc?.deleted ? null : (targetDoc?.content ?? null);\n      const theirsContent = sourceDoc?.deleted ? null : (sourceDoc?.content ?? null);\n\n      // Document doesn't exist in any meaningful state\n      if (baseContent === null && oursContent === null && theirsContent === null) {\n        // Not a real document, skip\n        continue;\n      }\n\n      // Only exists in base (deleted on both branches)\n      if (baseContent !== null && oursContent === null && theirsContent === null) {\n        // Both deleted, no conflict\n        continue;\n      }\n\n      // Document exists on only one branch (created or only-remaining)\n      if (baseContent === null && oursContent !== null && theirsContent === null) {\n        merged[docId] = deepClone(oursContent);\n        continue;\n      }\n      if (baseContent === null && oursContent === null && theirsContent !== null) {\n        merged[docId] = deepClone(theirsContent);\n        continue;\n      }\n\n      // Document created independently on both branches\n      if (baseContent === null && oursContent !== null && theirsContent !== null) {\n        if (deepEqual(oursContent, theirsContent)) {\n          merged[docId] = deepClone(oursContent);\n        } else {\n          // Conflict — created on both sides with different content\n          allConflicts.push({\n            documentId: docId,\n            path: '',\n            base: null,\n            ours: deepClone(oursContent),\n            theirs: deepClone(theirsContent),\n          });\n          merged[docId] = deepClone(oursContent); // ours wins in merged\n        }\n        continue;\n      }\n\n      // Exists in base and may exist on one or both branches — do field-level merge\n      if (baseContent !== null) {\n        const context: MergeContext = {\n          documentId: docId,\n          baseContent,\n          oursContent: oursContent ?? null,\n          theirsContent: theirsContent ?? null,\n        };\n\n        const fieldResult: MergeFieldResult = threeWayMerge(context);\n\n        if (fieldResult.merged !== null) {\n          merged[docId] = fieldResult.merged;\n        }\n        // If merged is null, the document was deleted — don't add it\n\n        // Fix up conflict paths (they start empty for top-level)\n        for (const conflict of fieldResult.conflicts) {\n          if (conflict.path === '') {\n            // Top-level conflict — it already has documentId, path is whole doc\n            // Actually the path from mergeObjects is already correct\n          }\n          allConflicts.push(conflict);\n        }\n      }\n    }\n\n    const applied = allConflicts.length === 0;\n\n    if (applied) {\n      // Apply merged documents to the current branch\n      const newTargetState = new Map<string, DocumentState>();\n      const targetVersions = new Map<string, Version[]>();\n\n      // Collect existing versions from target\n      for (const [docId, doc] of targetState) {\n        targetVersions.set(docId, [...doc.versions]);\n      }\n\n      // Apply merged content\n      for (const [docId, content] of Object.entries(merged)) {\n        const version = this.createVersion(content as Record<string, unknown>);\n        const existingVersions = targetVersions.get(docId) ?? [];\n\n        newTargetState.set(docId, {\n          content: deepClone(content as Record<string, unknown>),\n          versions: [...existingVersions, version],\n          deleted: false,\n        });\n      }\n\n      // Handle documents that were in target but got deleted in merge\n      for (const [docId, doc] of targetState) {\n        if (!(docId in merged) && !doc.deleted) {\n          // The merge resulted in deletion of this doc\n          const existingVersions = targetVersions.get(docId) ?? [];\n          newTargetState.set(docId, {\n            content: null,\n            versions: existingVersions,\n            deleted: true,\n          });\n        }\n      }\n\n      this.branches.set(this.activeBranch, newTargetState);\n\n      // Update the source branch's fork base so future merges compute the\n      // correct common ancestor (the merged state, not the original fork)\n      const sourceRecord = this.branchRecords.get(sourceBranch)!;\n      const newForkBase = new Map<string, ForkDocumentState>();\n      for (const [docId, docState] of newTargetState) {\n        newForkBase.set(docId, {\n          content: deepClone(docState.content),\n          deleted: docState.deleted,\n        });\n      }\n      sourceRecord.parent = this.activeBranch;\n      sourceRecord.forkBase = newForkBase;\n    }\n\n    return { merged, conflicts: allConflicts, applied };\n  }\n\n  // ── Private Helpers ────────────────────────────────────────────────────\n\n  private getActiveBranchState(): Map<string, DocumentState> {\n    return this.branches.get(this.activeBranch)!;\n  }\n\n  /** Get a document — throws if it doesn't exist, BUT allows deleted documents */\n  private getDocumentOrThrow(id: string): DocumentState {\n    const branchState = this.getActiveBranchState();\n    const doc = branchState.get(id);\n    if (!doc) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.activeBranch}\"`);\n    }\n    return doc;\n  }\n\n  /** Get a document — throws if it doesn't exist OR was deleted */\n  private getExistingDocument(id: string): DocumentState {\n    const doc = this.getDocumentOrThrow(id);\n    if (doc.deleted) {\n      throw new Error(`Document \"${id}\" has been deleted on branch \"${this.activeBranch}\"`);\n    }\n    return doc;\n  }\n\n  private createVersion(content: Record<string, unknown> | null): Version {\n    this.versionCounter++;\n    return {\n      id: `v${this.versionCounter}`,\n      timestamp: Date.now(),\n      content: deepClone(content),\n    };\n  }\n\n  /**\n   * Find the common ancestor state (merge base) of two branches.\n   *\n   * Walks the parent chain from both branches to find the most recent\n   * common ancestor branch, then uses the fork base of the earliest fork\n   * from that ancestor as the merge base.\n   */\n  private findMergeBase(\n    branchA: string,\n    branchB: string\n  ): Map<string, ForkDocumentState> {\n    // Build ancestor chains\n    const chainA = this.getAncestorChain(branchA);\n    const chainB = this.getAncestorChain(branchB);\n\n    // If one is the direct ancestor of the other, use the child's forkBase\n    if (chainA.includes(branchB)) {\n      // branchB is ancestor of branchA\n      // Find the first child of branchB in chainA\n      for (let i = 0; i < chainA.length - 1; i++) {\n        if (chainA[i + 1] === branchB) {\n          const record = this.branchRecords.get(chainA[i])!;\n          return new Map(record.forkBase);\n        }\n      }\n      // Shouldn't reach here, but fallback\n      const record = this.branchRecords.get(branchA)!;\n      return new Map(record.forkBase);\n    }\n\n    if (chainB.includes(branchA)) {\n      for (let i = 0; i < chainB.length - 1; i++) {\n        if (chainB[i + 1] === branchA) {\n          const record = this.branchRecords.get(chainB[i])!;\n          return new Map(record.forkBase);\n        }\n      }\n      const record = this.branchRecords.get(branchB)!;\n      return new Map(record.forkBase);\n    }\n\n    // Find the most recent common ancestor (MRCA)\n    for (const a of chainA) {\n      if (chainB.includes(a)) {\n        // a is the MRCA\n        // Find which branch is the first fork from a on each chain\n        let earliestChild: string | null = null;\n\n        for (let i = 0; i < chainA.length - 1; i++) {\n          if (chainA[i + 1] === a) {\n            earliestChild = chainA[i];\n            break;\n          }\n        }\n\n        if (earliestChild === null) {\n          for (let i = 0; i < chainB.length - 1; i++) {\n            if (chainB[i + 1] === a) {\n              earliestChild = chainB[i];\n              break;\n            }\n          }\n        }\n\n        if (earliestChild !== null) {\n          const record = this.branchRecords.get(earliestChild)!;\n          return new Map(record.forkBase);\n        }\n\n        // If we get here, both are the MRCA itself (shouldn't happen)\n        return new Map(this.branchRecords.get(a)!.forkBase);\n      }\n    }\n\n    // Fallback: return empty base\n    return new Map();\n  }\n\n  /**\n   * Build the ancestor chain from a branch up to main.\n   * Returns [branch, parent, grandparent, ..., \"main\"]\n   */\n  private getAncestorChain(name: string): string[] {\n    const chain: string[] = [];\n    let current: string | null = name;\n    while (current !== null) {\n      chain.push(current);\n      const record = this.branchRecords.get(current);\n      current = record?.parent ?? null;\n    }\n    return chain;\n  }\n}\n","structuredPatch":[{"oldStart":209,"oldLines":8,"newStart":209,"newLines":8,"lines":["       }","     };","     addIds(baseSnapshot as Map<string, unknown>);","-    stateToIds(targetState);","-    stateToIds(sourceState);","+    addIds(targetState as Map<string, unknown>);","+    addIds(sourceState as Map<string, unknown>);"," ","     const allConflicts: Conflict[] = [];","     const merged: Record<string, unknown> = {};"]}],"userModified":false,"replaceAll":false}}
