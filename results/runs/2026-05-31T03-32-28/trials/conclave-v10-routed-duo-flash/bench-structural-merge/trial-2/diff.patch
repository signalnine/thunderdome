loned versions', () => {\n      store.create('doc1', { nested: { x: 1 } });\n      const history = store.getHistory('doc1');\n      (history[0].content as Record<string, unknown>).nested = { x: 999 };\n      expect(store.getVersion('doc1', history[0].id)).toEqual({ nested: { x: 1 } });\n    });\n  });\n\n  describe('getVersion', () => {\n    it('returns document content at a specific version', () => {\n      store.create('doc1', { v: 1 });\n      store.update('doc1', { v: 2 });\n      const history = store.getHistory('doc1');\n      expect(store.getVersion('doc1', history[0].id)).toEqual({ v: 1 });\n      expect(store.getVersion('doc1', history[1].id)).toEqual({ v: 2 });\n    });\n\n    it('throws if version does not exist for that document', () => {\n      store.create('doc1', { v: 1 });\n      expect(() => store.getVersion('doc1', 'nonexistent')).toThrow();\n    });\n\n    it('throws if document does not exist', () => {\n      expect(() => store.getVersion('nonexistent', 'v1')).toThrow();\n    });\n\n    it('returns a deep clone', () => {\n      store.create('doc1', { nested: { x: 1 } });\n      const history = store.getHistory('doc1');\n      const version = store.getVersion('doc1', history[0].id);\n      version.nested = { x: 999 };\n      expect(store.getVersion('doc1', history[0].id)).toEqual({ nested: { x: 1 } });\n    });\n  });\n});\n\ndescribe('Branching', () => {\n  let store: IDocumentStore;\n\n  beforeEach(() => {\n    store = createStore();\n  });\n\n  it('starts on branch \"main\" by default', () => {\n    expect(store.getBranch()).toBe('main');\n  });\n\n  describe('createBranch', () => {\n    it('creates a new branch from current branch state', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('creates from specified branch with fromBranch parameter', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature', 'main');\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('new branch starts with all documents from source', () => {\n      store.create('doc1', { a: 1 });\n      store.create('doc2', { b: 2 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n      expect(store.get('doc2')).toEqual({ b: 2 });\n    });\n\n    it('does NOT switch to the new branch', () => {\n      store.createBranch('feature');\n      expect(store.getBranch()).toBe('main');\n    });\n\n    it('throws if branch name already exists', () => {\n      expect(() => store.createBranch('main')).toThrow();\n    });\n  });\n\n  describe('switchBranch', () => {\n    it('changes the active branch', () => {\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(store.getBranch()).toBe('feature');\n    });\n\n    it('CRUD operations apply to the switched branch', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { b: 2 });\n      expect(store.get('doc1')).toEqual({ b: 2 });\n      store.switchBranch('main');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('throws if branch does not exist', () => {\n      expect(() => store.switchBranch('nonexistent')).toThrow();\n    });\n  });\n\n  describe('Branch isolation', () => {\n    it('changes on one branch are not visible on other branches', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { b: 2 });\n      store.switchBranch('main');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('documents created on branch A do not appear on branch B', () => {\n      store.createBranch('feature');\n      store.switchBranch('feature');\n    