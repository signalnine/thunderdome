 throw new Error(`Version \"${versionId}\" not found for document \"${id}\"`);\n116\t    }\n117\t    return deepClone(version.content as Record<string, unknown>);\n118\t  }\n119\t\n120\t  // ── Branching ──────────────────────────────────────────────────────────\n121\t\n122\t  createBranch(name: string, fromBranch?: string): void {\n123\t    if (this.branchRecords.has(name)) {\n124\t      throw new Error(`Branch \"${name}\" already exists`);\n125\t    }\n126\t\n127\t    const source = fromBranch ?? this.activeBranch;\n128\t    if (!this.branchRecords.has(source)) {\n129\t      throw new Error(`Source branch \"${source}\" does not exist`);\n130\t    }\n131\t\n132\t    const sourceState = this.branches.get(source)!;\n133\t\n134\t    // Deep clone all documents from source branch\n135\t    const newBranchState = new Map<string, DocumentState>();\n136\t    const forkBase = new Map<string, ForkDocumentState>();\n137\t\n138\t    for (const [docId, docState] of sourceState) {\n139\t      newBranchState.set(docId, {\n140\t        content: deepClone(docState.content),\n141\t        versions: docState.versions.map(v => ({\n142\t          id: v.id,\n143\t          timestamp: v.timestamp,\n144\t          content: deepClone(v.content),\n145\t        })),\n146\t        deleted: docState.deleted,\n147\t      });\n148\t\n149\t      forkBase.set(docId, {\n150\t        content: deepClone(docState.content),\n151\t        deleted: docState.deleted,\n152\t      });\n153\t    }\n154\t\n155\t    this.branches.set(name, newBranchState);\n156\t    this.branchRecords.set(name, {\n157\t      name,\n158\t      parent: source,\n159\t      forkBase,\n160\t    });\n161\t  }\n162\t\n163\t  switchBranch(name: string): void {\n164\t    if (!this.branchRecords.has(name)) {\n165\t      throw new Error(`Branch \"${name}\" does not exist`);\n166\t    }\n167\t    this.activeBranch = name;\n168\t  }\n169\t\n170\t  getBranch(): string {\n171\t    return this.activeBranch;\n172\t  }\n173\t\n174\t  listBranc