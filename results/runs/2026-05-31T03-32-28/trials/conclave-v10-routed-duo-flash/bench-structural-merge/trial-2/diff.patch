+{"type":"assistant","message":{"id":"90e4b699-d3e6-4630-845f-a37a6f49e5d6","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{"type":"tool_use","id":"call_00_E02I2COTyqZpUPOCtOeX6523","name":"Write","input":{"file_path":"/workspace/tests/document-store.test.ts","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { DocumentStoreImpl as DocumentStore } from '../src/index.js';\nimport type { DocumentStore as IDocumentStore } from '../src/types.js';\n\n// Helper to create a fresh store for each test\nfunction createStore(): IDocumentStore {\n  return new DocumentStore();\n}\n\ndescribe('Document CRUD', () => {\n  let store: IDocumentStore;\n\n  beforeEach(() => {\n    store = createStore();\n  });\n\n  describe('create', () => {\n    it('stores a document with given content on current branch', () => {\n      store.create('doc1', { name: 'test', value: 42 });\n      expect(store.get('doc1')).toEqual({ name: 'test', value: 42 });\n    });\n\n    it('deep-clones content on create', () => {\n      const content = { nested: { a: 1, b: 2 } };\n      store.create('doc1', content);\n      content.nested.a = 999;\n      expect(store.get('doc1')).toEqual({ nested: { a: 1, b: 2 } });\n    });\n\n    it('throws if document ID already exists on the current branch', () => {\n      store.create('doc1', { a: 1 });\n      expect(() => store.create('doc1', { b: 2 })).toThrow();\n    });\n\n    it('does NOT throw if same ID exists on a different branch', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc1', { b: 2 }); // should not throw since on different branch\n      expect(() => store.create('doc1', { c: 3 })).toThrow(); // but duplicate on same branch should\n    });\n\n    it('generates a version on create', () => {\n      store.create('doc1', { a: 1 });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(1);\n    });\n  });\n\n  describe('get', () => {\n    it('returns the current content', () => {\n      store.create('doc1', { name: 'test' });\n      expect(store.get('doc1')).toEqual({ name: 'test' });\n    });\n\n    it('returns a deep clone', () => {\n      store.create('doc1', { nested: { a: 1 } });\n      const retrieved = store.get('doc1');\n      retrieved.nested.a = 999;\n      expect(store.get('doc1')).toEqual({ nested: { a: 1 } });\n    });\n\n    it('throws if document does not exist', () => {\n      expect(() => store.get('nonexistent')).toThrow();\n    });\n\n    it('throws if document was deleted', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow();\n    });\n  });\n\n  describe('update', () => {\n    it('replaces document content', () => {\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { b: 2 });\n      expect(store.get('doc1')).toEqual({ b: 2 });\n    });\n\n    it('deep-clones content on update', () => {\n      store.create('doc1', { a: 1 });\n      const content = { nested: { x: 10 } };\n      store.update('doc1', content);\n      content.nested.x = 999;\n      expect(store.get('doc1')).toEqual({ nested: { x: 10 } });\n    });\n\n    it('throws if document does not exist', () => {\n      expect(() => store.update('nonexistent', { a: 1 })).toThrow();\n    });\n\n    it('throws if document was deleted', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.update('doc1', { b: 2 })).toThrow();\n    });\n\n    it('generates a version on update', () => {\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { b: 2 });\n      expect(store.getHistory('doc1')).toHaveLength(2);\n    });\n  });\n\n  describe('delete', () => {\n    it('removes the document on the current branch', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow();\n    });\n\n    it('throws if document does not exist', () => {\n      expect(() => store.delete('nonexistent')).toThrow();\n    });\n\n    it('throws if document already deleted', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.delete('doc1')).toThrow();\n    });\n\n    it('does not affect other branches', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow();\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('does not generate a version', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      // Should still only have the create version\n      expect(store.getHistory('doc1')).toHaveLength(1);\n    });\n  });\n});\n\ndescribe('Version History', () => {\n  let store: IDocumentStore;\n\n  beforeEach(() => {\n    store = createStore();\n  });\n\n  describe('Version creation', () => {\n    it('every create generates a version', () => {\n      store.create('doc1', { v: 1 });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(1);\n      expect(history[0].content).toEqual({ v: 1 });\n    });\n\n    it('every update generates a version', () => {\n      store.create('doc1', { v: 1 });\n      store.update('doc1', { v: 2 });\n      store.update('doc1', { v: 3 });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(3);\n    });\n\n    it('each version has a unique id', () => {\n      store.create('doc1', { v: 1 });\n      store.update('doc1', { v: 2 });\n      store.update('doc1', { v: 3 });\n      const history = store.getHistory('doc1');\n      const ids = history.map(v => v.id);\n      expect(new Set(ids).size).toBe(3);\n    });\n\n    it('each version has a timestamp number', () => {\n      store.create('doc1', { v: 1 });\n      const history = store.getHistory('doc1');\n      expect(typeof history[0].timestamp).toBe('number');\n      expect(history[0].timestamp).toBeGreaterThan(0);\n    });\n\n    it('each version stores the full document content', () => {\n      store.create('doc1', { a: 1, b: 2 });\n      store.update('doc1', { a: 10, b: 2 });\n      const history = store.getHistory('doc1');\n      expect(history[0].content).toEqual({ a: 1, b: 2 });\n      expect(history[1].content).toEqual({ a: 10, b: 2 });\n    });\n  });\n\n  describe('getHistory', () => {\n    it('returns versions in chronological order (oldest first)', () => {\n      store.create('doc1', { v: 1 });\n      store.update('doc1', { v: 2 });\n      store.update('doc1', { v: 3 });\n      const history = store.getHistory('doc1');\n      expect(history[0].content).toEqual({ v: 1 });\n      expect(history[1].content).toEqual({ v: 2 });\n      expect(history[2].content).toEqual({ v: 3 });\n      expect(history[0].timestamp).toBeLessThanOrEqual(history[1].timestamp);\n      expect(history[1].timestamp).toBeLessThanOrEqual(history[2].timestamp);\n    });\n\n    it('returns versions only for the current branch', () => {\n      store.create('doc1', { v: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { v: 2 });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(2); // create + update on feature\n    });\n\n    it('throws if document does not exist', () => {\n      expect(() => store.getHistory('nonexistent')).toThrow();\n    });\n\n    it('throws if document was deleted', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.getHistory('doc1')).toThrow();\n    });\n\n    it('returns deep-cloned versions', () => {\n      store.create('doc1', { nested: { x: 1 } });\n      const history = store.getHistory('doc1');\n      (history[0].content as Record<string, unknown>).nested = { x: 999 };\n      expect(store.getVersion('doc1', history[0].id)).toEqual({ nested: { x: 1 } });\n    });\n  });\n\n  describe('getVersion', () => {\n    it('returns document content at a specific version', () => {\n      store.create('doc1', { v: 1 });\n      store.update('doc1', { v: 2 });\n      const history = store.getHistory('doc1');\n      expect(store.getVersion('doc1', history[0].id)).toEqual({ v: 1 });\n      expect(store.getVersion('doc1', history[1].id)).toEqual({ v: 2 });\n    });\n\n    it('throws if version does not exist for that document', () => {\n      store.create('doc1', { v: 1 });\n      expect(() => store.getVersion('doc1', 'nonexistent')).toThrow();\n    });\n\n    it('throws if document does not exist', () => {\n      expect(() => store.getVersion('nonexistent', 'v1')).toThrow();\n    });\n\n    it('returns a deep clone', () => {\n      store.create('doc1', { nested: { x: 1 } });\n      const history = store.getHistory('doc1');\n      const version = store.getVersion('doc1', history[0].id);\n      version.nested = { x: 999 };\n      expect(store.getVersion('doc1', history[0].id)).toEqual({ nested: { x: 1 } });\n    });\n  });\n});\n\ndescribe('Branching', () => {\n  let store: IDocumentStore;\n\n  beforeEach(() => {\n    store = createStore();\n  });\n\n  it('starts on branch \"main\" by default', () => {\n    expect(store.getBranch()).toBe('main');\n  });\n\n  describe('createBranch', () => {\n    it('creates a new branch from current branch state', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('creates from specified branch with fromBranch parameter', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature', 'main');\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('new branch starts with all documents from source', () => {\n      store.create('doc1', { a: 1 });\n      store.create('doc2', { b: 2 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n      expect(store.get('doc2')).toEqual({ b: 2 });\n    });\n\n    it('does NOT switch to the new branch', () => {\n      store.createBranch('feature');\n      expect(store.getBranch()).toBe('main');\n    });\n\n    it('throws if branch name already exists', () => {\n      expect(() => store.createBranch('main')).toThrow();\n    });\n  });\n\n  describe('switchBranch', () => {\n    it('changes the active branch', () => {\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(store.getBranch()).toBe('feature');\n    });\n\n    it('CRUD operations apply to the switched branch', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { b: 2 });\n      expect(store.get('doc1')).toEqual({ b: 2 });\n      store.switchBranch('main');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('throws if branch does not exist', () => {\n      expect(() => store.switchBranch('nonexistent')).toThrow();\n    });\n  });\n\n  describe('Branch isolation', () => {\n    it('changes on one branch are not visible on other branches', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { b: 2 });\n      store.switchBranch('main');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('documents created on branch A do not appear on branch B', () => {\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc1', { a: 1 });\n      store.switchBranch('main');\n      expect(() => store.get('doc1')).toThrow();\n    });\n\n    it('deleted documents on branch A still exist on branch B', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.delete('doc1');\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n  });\n\n  describe('getBranch / listBranches', () => {\n    it('getBranch returns current branch name', () => {\n      expect(store.getBranch()).toBe('main');\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      expect(store.getBranch()).toBe('feature');\n    });\n\n    it('listBranches returns all branch names', () => {\n      store.createBranch('feature');\n      store.createBranch('bugfix');\n      const branches = store.listBranches();\n      expect(branches).toContain('main');\n      expect(branches).toContain('feature');\n      expect(branches).toContain('bugfix');\n    });\n\n    it('listBranches returns a new array (not internal reference)', () => {\n      const branches = store.listBranches();\n      branches.push('hacked');\n      expect(store.listBranches()).not.toContain('hacked');\n    });\n  });\n});\n\ndescribe('Three-Way Merge', () => {\n  describe('Common ancestor', () => {\n    it('finds the common ancestor as the fork point', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1, b: 2 });\n      store.createBranch('feature');\n      // Main changes a\n      store.update('doc1', { a: 100, b: 2 });\n      // Feature changes b\n      store.switchBranch('feature');\n      store.update('doc1', { a: 1, b: 200 });\n\n      const result = store.merge('main');\n      // Should merge cleanly: a came from main, b from feature\n      // (actually depends on target vs source — merging main INTO feature)\n      expect(result.applied).toBe(true);\n      // Actually let me reconsider... merging 'main' (source) into 'feature' (current, target)\n      // Base: {a:1, b:2}, Ours(feature): {a:1, b:200}, Theirs(main): {a:100, b:2}\n      // a: only main changed -> take main's {a:100}\n      // b: only feature changed -> take feature's {b:200}\n      expect(result.merged['doc1']).toEqual({ a: 100, b: 200 });\n    });\n  });\n\n  describe('No conflicts — auto-applied', () => {\n    it('if only one side changed a field, take that change', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1, b: 2 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 100, b: 2 });\n      store.switchBranch('feature');\n      store.update('doc1', { a: 1, b: 200 });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(result.merged['doc1']).toEqual({ a: 100, b: 200 });\n    });\n\n    it('if both sides changed same field to same value, no conflict', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 42 });\n      store.switchBranch('feature');\n      store.update('doc1', { a: 42 });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(result.merged['doc1']).toEqual({ a: 42 });\n    });\n\n    it('when no conflicts, merge is applied to target branch', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 100 });\n      store.switchBranch('feature');\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(true);\n      expect(store.get('doc1')).toEqual({ a: 100 });\n    });\n\n    it('when no conflicts, conflicts array is empty', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 100 });\n      store.switchBranch('feature');\n\n      const result = store.merge('main');\n      expect(result.conflicts).toEqual([]);\n    });\n  });\n\n  describe('With conflicts — not applied', () => {\n    it('when there are conflicts, applied is false', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 100 });\n      store.switchBranch('feature');\n      store.update('doc1', { a: 200 });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(false);\n    });\n\n    it('when there are conflicts, current branch is NOT modified', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 100 });\n      store.switchBranch('feature');\n      store.update('doc1', { a: 200 });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(false);\n      expect(store.get('doc1')).toEqual({ a: 200 }); // feature's version unchanged\n    });\n\n    it('conflicts have correct documentId, path, base, ours, theirs', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 100 });\n      store.switchBranch('feature');\n      store.update('doc1', { a: 200 });\n\n      const result = store.merge('main');\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].documentId).toBe('doc1');\n      expect(result.conflicts[0].path).toBe('a');\n      expect(result.conflicts[0].base).toBe(1);\n      expect(result.conflicts[0].ours).toBe(200); // feature (current)\n      expect(result.conflicts[0].theirs).toBe(100); // main (source)\n    });\n\n    it('path is dot-separated for nested fields', () => {\n      const store = createStore();\n      store.create('doc1', { nested: { x: 1, y: 2 } });\n      store.createBranch('feature');\n      store.update('doc1', { nested: { x: 999, y: 2 } });\n      store.switchBranch('feature');\n      store.update('doc1', { nested: { x: 1, y: 888 } });\n\n      const result = store.merge('main');\n      // x: ours=999 vs theirs=1 (base=1) — wait, base.x=1, ours.x=999, theirs.x=1\n      // base.x === theirs.x, so ONLY ours changed -> no conflict\n      // y: ours=888 vs theirs=2 (base=2) — base.y===theirs.y, only ours changed -> no conflict\n      // So this should merge cleanly! Let me test conflicting nested fields differently.\n      expect(result.applied).toBe(true);\n      expect(result.merged['doc1']).toEqual({ nested: { x: 999, y: 888 } });\n    });\n\n    it('conflict on same nested field with different values', () => {\n      const store = createStore();\n      store.create('doc1', { nested: { x: 1, y: 2 } });\n      store.createBranch('feature');\n      store.update('doc1', { nested: { x: 100, y: 2 } });\n      store.switchBranch('feature');\n      store.update('doc1', { nested: { x: 200, y: 2 } });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(false);\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].documentId).toBe('doc1');\n      expect(result.conflicts[0].path).toBe('nested.x');\n      expect(result.conflicts[0].base).toBe(1);\n      expect(result.conflicts[0].ours).toBe(200);\n      expect(result.conflicts[0].theirs).toBe(100);\n    });\n\n    it('merged field shows ours-wins for conflict resolution', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1, b: 2 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 100, b: 2 });\n      store.switchBranch('feature');\n      store.update('doc1', { a: 200, b: 999 });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(false);\n      // a: conflict, ours wins -> a:200\n      // b: only feature changed -> b:999\n      expect(result.merged['doc1']).toEqual({ a: 200, b: 999 });\n    });\n  });\n\n  describe('No-op merge', () => {\n    it('merging identical branches produces no changes', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(true);\n      expect(result.conflicts).toHaveLength(0);\n      expect(result.merged['doc1']).toEqual({ a: 1 });\n    });\n  });\n\n  describe('Structural merge', () => {\n    it('different nested keys of same parent merge cleanly', () => {\n      const store = createStore();\n      store.create('doc1', { a: { x: 1, y: 2 } });\n      store.createBranch('feature');\n      store.update('doc1', { a: { x: 999, y: 2 } });\n      store.switchBranch('feature');\n      store.update('doc1', { a: { x: 1, y: 888 } });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(true);\n      expect(result.merged['doc1']).toEqual({ a: { x: 999, y: 888 } });\n    });\n\n    it('same nested field to different values produces conflict at that path', () => {\n      const store = createStore();\n      store.create('doc1', { a: { b: { c: 1 } } });\n      store.createBranch('feature');\n      store.update('doc1', { a: { b: { c: 100 } } });\n      store.switchBranch('feature');\n      store.update('doc1', { a: { b: { c: 200 } } });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(false);\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].path).toBe('a.b.c');\n    });\n\n    it('arrays are treated as leaf values (compared by value equality)', () => {\n      const store = createStore();\n      store.create('doc1', { items: [1, 2, 3] });\n      store.createBranch('feature');\n      store.update('doc1', { items: [4, 5, 6] });\n      store.switchBranch('feature');\n      store.update('doc1', { items: [7, 8, 9] });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(false);\n      expect(result.conflicts).toHaveLength(1);\n      expect(result.conflicts[0].path).toBe('items');\n    });\n\n    it('arrays with same values on both sides have no conflict', () => {\n      const store = createStore();\n      store.create('doc1', { items: [1, 2, 3] });\n      store.createBranch('feature');\n      store.update('doc1', { items: [4, 5, 6] });\n      store.switchBranch('feature');\n      store.update('doc1', { items: [4, 5, 6] });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(true);\n      expect(result.merged['doc1']).toEqual({ items: [4, 5, 6] });\n    });\n  });\n\n  describe('Multi-document merge', () => {\n    it('changes to different documents merge cleanly with no conflicts', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.create('doc2', { b: 2 });\n      store.create('doc3', { c: 3 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 100 });\n      store.switchBranch('feature');\n      store.update('doc2', { b: 200 });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(true);\n      expect(result.merged['doc1']).toEqual({ a: 100 });\n      expect(result.merged['doc2']).toEqual({ b: 200 });\n      expect(result.merged['doc3']).toEqual({ c: 3 });\n    });\n  });\n\n  describe('Deletion during merge', () => {\n    it('if one side deletes and the other does not change, deletion wins', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.delete('doc1');\n      store.switchBranch('feature');\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(true);\n      // Document should be deleted on feature branch\n      expect(() => store.get('doc1')).toThrow();\n    });\n\n    it('if one side deletes and the other modifies, it is a conflict', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 999 });\n      store.switchBranch('feature');\n      store.delete('doc1');\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(false);\n      expect(result.conflicts.length).toBeGreaterThan(0);\n      // Current branch should remain unchanged\n      expect(() => store.get('doc1')).toThrow(); // still deleted on feature\n    });\n\n    it('if both sides delete, no conflict', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.delete('doc1');\n      store.switchBranch('feature');\n      store.delete('doc1');\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(true);\n      expect(() => store.get('doc1')).toThrow();\n    });\n  });\n\n  describe('New documents on branches', () => {\n    it('a document created on one branch (not in base/other) is taken as-is', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc2', { b: 2 });\n\n      const result = store.merge('main');\n      expect(result.applied).toBe(true);\n      expect(result.merged['doc2']).toEqual({ b: 2 });\n    });\n\n    it('a document created independently on both branches with different content is a conflict', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.create('doc2', { from: 'feature' });\n      store.switchBranch('main');\n      store.create('doc2', { from: 'main' });\n\n      const result = store.merge('feature');\n      expect(result.applied).toBe(false);\n      expect(result.conflicts.length).toBeGreaterThan(0);\n    });\n  });\n\n  describe('Merging preserves versions on target', () => {\n    it('after a successful merge, a new version is created for merged documents', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 100 });\n      store.switchBranch('feature');\n\n      const historyBefore = store.getHistory('doc1').length;\n      store.merge('main');\n      const historyAfter = store.getHistory('doc1').length;\n      expect(historyAfter).toBe(historyBefore + 1);\n    });\n\n    it('after successful merge, merged content is retrievable via get()', () => {\n      const store = createStore();\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.update('doc1', { a: 100 });\n      store.switchBranch('feature');\n\n      store.merge('main');\n      expect(store.get('doc1')).toEqual({ a: 100 });\n    });\n  });\n});\n\ndescribe('Edge Cases', () => {\n  let store: IDocumentStore;\n\n  beforeEach(() => {\n    store = createStore();\n  });\n\n  it('creating with empty object works', () => {\n    store.create('doc1', {});\n    expect(store.get('doc1')).toEqual({});\n  });\n\n  it('updating to empty object works', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', {});\n    expect(store.get('doc1')).toEqual({});\n  });\n\n  it('deeply nested objects (5+ levels) are handled correctly', () => {\n    const deep = { a: { b: { c: { d: { e: 42 } } } } };\n    store.create('doc1', deep);\n    expect(store.get('doc1')).toEqual({ a: { b: { c: { d: { e: 42 } } } } });\n  });\n\n  it('deep clone preserves deep nesting', () => {\n    const deep = { l1: { l2: { l3: { l4: { value: 'deep' } } } } };\n    store.create('doc1', deep);\n    const retrieved = store.get('doc1');\n    (retrieved as Record<string, unknown>).l1 = { hacked: true };\n    expect(store.get('doc1')).toEqual(deep);\n  });\n\n  it('documents can contain arrays as field values', () => {\n    store.create('doc1', { items: [1, 2, 3], nested: { tags: ['a', 'b'] } });\n    expect(store.get('doc1')).toEqual({ items: [1, 2, 3], nested: { tags: ['a', 'b'] } });\n  });\n\n  it('arrays are deep-cloned correctly', () => {\n    const content = { items: [1, 2, { x: 3 }] };\n    store.create('doc1', content);\n    content.items.push(4);\n    expect(store.get('doc1')).toEqual({ items: [1, 2, { x: 3 }] });\n  });\n\n  it('fields can have null values', () => {\n    store.create('doc1', { a: null, b: 1 });\n    expect(store.get('doc1')).toEqual({ a: null, b: 1 });\n  });\n\n  it('null fields are deep-cloned correctly', () => {\n    store.create('doc1', { a: null });\n    const retrieved = store.get('doc1');\n    retrieved.a = 'changed';\n    expect(store.get('doc1')).toEqual({ a: null });\n  });\n\n  it('multiple updates create multiple versions', () => {\n    store.create('doc1', { v: 1 });\n    for (let i = 2; i <= 5; i++) {\n      store.update('doc1', { v: i });\n    }\n    const history = store.getHistory('doc1');\n    expect(history).toHaveLength(5);\n    expect((history[4].content as Record<string, unknown>).v).toBe(5);\n  });\n\n  it('each version preserves content at that point in time', () => {\n    store.create('doc1', { v: 1 });\n    store.update('doc1', { v: 2 });\n    store.update('doc1', { v: 3 });\n    const history = store.getHistory('doc1');\n    expect(store.getVersion('doc1', history[0].id)).toEqual({ v: 1 });\n    expect(store.getVersion('doc1', history[1].id)).toEqual({ v: 2 });\n    expect(store.getVersion('doc1', history[2].id)).toEqual({ v: 3 });\n  });\n\n  it('createBranch with fromBranch parameter works correctly', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 999 });\n    store.createBranch('subfeature', 'feature');\n    store.switchBranch('subfeature');\n    expect(store.get('doc1')).toEqual({ a: 999 });\n  });\n\n  it('fast-forward merge when target has no changes since fork', () => {\n    const store = createStore();\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 42 });\n    store.switchBranch('main');\n\n    // Main hasn't changed since fork. Merge feature into main.\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(store.get('doc1')).toEqual({ a: 42 });\n  });\n\n  it('version IDs are unique across the store', () => {\n    store.create('doc1', { a: 1 });\n    store.create('doc2', { b: 2 });\n    const h1 = store.getHistory('doc1');\n    const h2 = store.getHistory('doc2');\n    expect(h1[0].id).not.toBe(h2[0].id);\n  });\n\n  it('getHistory returns array for deleted document on a branch where it still exists', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.delete('doc1');\n    // doc1 is deleted on main, but exists on feature\n    store.switchBranch('feature');\n    const history = store.getHistory('doc1');\n    expect(history).toHaveLength(1);\n  });\n\n  it('merge with multiple documents where some conflict and some do not', () => {\n    const store = createStore();\n    store.create('doc1', { a: 1 });\n    store.create('doc2', { b: 2 });\n    store.createBranch('feature');\n    store.update('doc1', { a: 100 });\n    store.update('doc2', { b: 200 });\n    store.switchBranch('feature');\n    store.update('doc1', { a: 999 });\n    // doc2 not changed on feature\n\n    const result = store.merge('main');\n    // doc1.a: conflict (ours=999, theirs=100, base=1)\n    // doc2.b: only main changed (b=200) -> should be 200 on merge\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toHaveLength(1);\n    expect(result.conflicts[0].documentId).toBe('doc1');\n    // merged field shows ours-wins for doc1.a and theirs for doc2.b\n    expect(result.merged['doc1']).toEqual({ a: 999 }); // ours wins\n    expect(result.merged['doc2']).toEqual({ b: 200 });\n  });\n\n  it('repeated merges work correctly', () => {\n    const store = createStore();\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 42 });\n    store.switchBranch('main');\n\n    // First merge\n    let result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(store.get('doc1')).toEqual({ a: 42 });\n\n    // Now make more changes on feature\n    store.switchBranch('feature');\n    store.update('doc1', { a: 100 });\n    store.switchBranch('main');\n\n    // Second merge\n    result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(store.get('doc1')).toEqual({ a: 100 });\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":160,"cache_creation_input_tokens":0,"cache_read_input_tokens":29824,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"94236fb2-ffb3-401b-aa1c-e9c2a4c9ed0b","uuid":"ac43f9a4-f168-48cd-a976-9603273db562"}
