n    it('deep-clones content on update', () => {\n      store.create('doc1', { a: 1 });\n      const content = { nested: { x: 10 } };\n      store.update('doc1', content);\n      content.nested.x = 999;\n      expect(store.get('doc1')).toEqual({ nested: { x: 10 } });\n    });\n\n    it('throws if document does not exist', () => {\n      expect(() => store.update('nonexistent', { a: 1 })).toThrow();\n    });\n\n    it('throws if document was deleted', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.update('doc1', { b: 2 })).toThrow();\n    });\n\n    it('generates a version on update', () => {\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { b: 2 });\n      expect(store.getHistory('doc1')).toHaveLength(2);\n    });\n  });\n\n  describe('delete', () => {\n    it('removes the document on the current branch', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow();\n    });\n\n    it('throws if document does not exist', () => {\n      expect(() => store.delete('nonexistent')).toThrow();\n    });\n\n    it('throws if document already deleted', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      expect(() => store.delete('doc1')).toThrow();\n    });\n\n    it('does not affect other branches', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow();\n      store.switchBranch('feature');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('does not generate a version', () => {\n      store.create('doc1', { a: 1 });\n      store.delete('doc1');\n      // Should still only have the create version\n      expect(store.getHistory('doc1')).toHaveLength(1);\n    });\n  });\n});\n\ndescribe('Version History', () => {\n  let store: IDocumentStore;\n\n  beforeEach(() => {\n    store = createStore();\n  });\n\n  describe('Version creation', () => {\n    it('every create generates a version', () => {\n      store.create('doc1', { v: 1 });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(1);\n      expect(history[0].content).toEqual({ v: 1 });\n    });\n\n    it('every update generates a version', () => {\n      store.create('doc1', { v: 1 });\n      store.update('doc1', { v: 2 });\n      store.update('doc1', { v: 3 });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(3);\n    });\n\n    it('each version has a unique id', () => {\n      store.create('doc1', { v: 1 });\n      store.update('doc1', { v: 2 });\n      store.update('doc1', { v: 3 });\n      const history = store.getHistory('doc1');\n      const ids = history.map(v => v.id);\n      expect(new Set(ids).size).toBe(3);\n    });\n\n    it('each version has a timestamp number', () => {\n      store.create('doc1', { v: 1 });\n      const history = store.getHistory('doc1');\n      expect(typeof history[0].timestamp).toBe('number');\n      expect(history[0].timestamp).toBeGreaterThan(0);\n    });\n\n    it('each version stores the full document content', () => {\n      store.create('doc1', { a: 1, b: 2 });\n      store.update('doc1', { a: 10, b: 2 });\n      const history = store.getHistory('doc1');\n      expect(history[0].content).toEqual({ a: 1, b: 2 });\n      expect(history[1].content).toEqual({ a: 10, b: 2 });\n    });\n  });\n\n  describe('getHistory', () => {\n    it('returns versions in chronological order (oldest first)', () => {\n      store.create('doc1', { v: 1 });\n      store.update('doc1', { v: 2 });\n      store.update('doc1', { v: 3 });\n      const history = store.getHistory('doc1');\n      expect(history[0].content).toEqual({ v: 1 });\n      expect(history[1].content).toEqual({ v: 2 });\n      expect(history[2].content).toEqual({ v: 3 });\n      expect(history[0].timestamp).toBeLessThanOrEqual(history[1].timest