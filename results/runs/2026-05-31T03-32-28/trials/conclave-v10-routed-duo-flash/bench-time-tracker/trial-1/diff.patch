@@ -0,0 +1,34 @@
+/**
+ * A recorded time entry.
+ */
+export interface TimeEntry {
+  /** The task name */
+  name: string;
+  /** Start timestamp (ms since epoch) */
+  start: number;
+  /** Stop timestamp (ms since epoch), undefined if still running */
+  stop?: number;
+}
+
+/**
+ * Options for filtering entries by date range.
+ */
+export interface DateRange {
+  /** Earliest start time (inclusive) */
+  start?: Date;
+  /** Latest start time (inclusive) */
+  end?: Date;
+}
+
+/**
+ * Options for creating a TimeTracker.
+ */
+export interface TimeTrackerOptions {
+  /** Path to the JSON file used for persistence */
+  filePath: string;
+}
+
+/**
+ * Summary of total time spent per task name (in milliseconds).
+ */
+export type TimeSummary = Record<string, number>;
