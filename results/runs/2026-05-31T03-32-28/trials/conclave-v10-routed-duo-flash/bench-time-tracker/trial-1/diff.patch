+import { readFileSync, writeFileSync, existsSync, mkdirSync } from 'fs';
+import { dirname } from 'path';
+import type { TimeEntry, DateRange, TimeSummary, TimeTrackerOptions } from './types.js';
+
+/**
+ * TimeTracker — a simple time tracking utility.
+ *
+ * - Start and stop named timers
+ * - Persist entries to a JSON file
+ * - Query entries by date range
+ * - Summarize time per task
+ */
+export class TimeTracker {
+  private entries: TimeEntry[] = [];
+  private readonly filePath: string;
+
+  constructor(options: TimeTrackerOptions) {
+    this.filePath = options.filePath;
+    this.load();
+  }
+
+  /**
+   * Start a named timer. If a timer is already running, it is automatically stopped.
+   * @param name — The task name (must not be empty or whitespace-only)
+   */
+  start(name: string): void {
+    if (name.trim().length === 0) {
+      throw new Error('Timer name must not be empty');
+    }
+
+    // Auto-stop the currently running entry, if any
+    const running = this.getRunningEntry();
+    if (running) {
+      running.stop = Date.now();
+    }
+
+    this.entries.push({
+      name,
+      start: Date.now(),
+    });
+
+    this.save();
+  }
+
+  /**
+   * Stop the currently running timer.
+   * @throws {Error} if no timer is running
+   */
+  stop(): void {
+    const running = this.getRunningEntry();
+    if (!running) {
+      throw new Error('No timer is currently running');
+    }
+    running.stop = Date.now();
+    this.save();
+  }
+
+  /**
+   * Get all time entries, optionally filtered by date range.
+   * @param range — Optional date range filter (filters by start time)
+   */
+  getEntries(range?: DateRange): TimeEntry[] {
+    let result = this.entries;
+
+    if (range) {
+      if (range.start) {
+        const startMs = range.start.getTime();
+        result = result.filter(e => e.start >= startMs);
+      }
+      if (range.end) {
+        const endMs = range.end.getTime();
+        result = result.filter(e => e.start <= endMs);
+      }
+    }
+
+    return [...result];
+  }
+
+  /**
+   * Get a summary of total time spent per task name (in milliseconds).
+   * Running tasks use the current time for their duration.
+   */
+  getSummary(): TimeSummary {
+    const summary: TimeSummary = {};
+    const now = Date.now();
+
+    for (const entry of this.entries) {
+      const duration = (entry.stop ?? now) - entry.start;
+      summary[entry.name] = (summary[entry.name] ?? 0) + duration;
+    }
+
+    return summary;
+  }
+
+  // ---- Private helpers ----
+
+  /**
+   * Find the entry that has no stop time (currently running).
+   */
+  private getRunningEntry(): TimeEntry | undefined {
+    return this.entries.find(e => e.stop === undefined);
+  }
+
+  /**
+   * Load entries from the JSON file (if it exists).
+   */
+  private load(): void {
+    if (existsSync(this.filePath)) {
+      const raw = readFileSync(this.filePath, 'utf-8');
+      const data = JSON.parse(raw) as { entries: TimeEntry[] };
+      this.entries = data.entries ?? [];
+    }
+  }
+
+  /**
+   * Save entries to the JSON file (creates parent directories if needed).
+   */
+  private save(): void {
+    const dir = dirname(this.filePath);
+    if (!existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+    writeFileSync(this.filePath, JSON.stringify({ entries: this.entries }, null, 2), 'utf-8');
+  }
+}
