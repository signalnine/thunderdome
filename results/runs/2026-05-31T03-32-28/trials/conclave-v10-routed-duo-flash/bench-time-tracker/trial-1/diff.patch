--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,199 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { createTracker } from './index.js';
+import { existsSync, unlinkSync, rmSync } from 'fs';
+import { join } from 'path';
+import { tmpdir } from 'os';
+
+function sleep(ms: number): Promise<void> {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+function getTempFile(): string {
+  return join(tmpdir(), `time-tracker-test-${Date.now()}-${Math.random().toString(36).slice(2)}.json`);
+}
+
+describe('TimeTracker', () => {
+  let testFile: string;
+
+  beforeEach(() => {
+    testFile = getTempFile();
+  });
+
+  afterEach(() => {
+    try { unlinkSync(testFile); } catch { /* ok */ }
+  });
+
+  describe('start / stop', () => {
+    it('C3: should stop a running timer', () => {
+      const tracker = createTracker({ filePath: testFile });
+      tracker.start('work');
+      tracker.stop();
+      const entries = tracker.getEntries();
+      expect(entries).toHaveLength(1);
+      expect(entries[0].name).toBe('work');
+      expect(entries[0].start).toBeTypeOf('number');
+      expect(entries[0].stop).toBeTypeOf('number');
+      expect(entries[0].stop! >= entries[0].start).toBe(true);
+    });
+
+    it('C2: starting a new timer stops the previous', () => {
+      const tracker = createTracker({ filePath: testFile });
+      tracker.start('work');
+      tracker.start('break');
+      const entries = tracker.getEntries();
+      expect(entries).toHaveLength(2);
+      expect(entries[0].name).toBe('work');
+      expect(entries[0].stop).toBeTypeOf('number');
+      expect(entries[1].name).toBe('break');
+      expect(entries[1].stop).toBeUndefined();
+    });
+
+    it('C4: stopping when nothing is running throws', () => {
+      const tracker = createTracker({ filePath: testFile });
+      expect(() => tracker.stop()).toThrow();
+    });
+
+    it('C5: starting with empty name throws', () => {
+      const tracker = createTracker({ filePath: testFile });
+      expect(() => tracker.start('')).toThrow();
+      expect(() => tracker.start('   ')).toThrow();
+    });
+
+    it('C11: unicode names work', () => {
+      const tracker = createTracker({ filePath: testFile });
+      tracker.start('🚀 launch');
+      tracker.stop();
+      tracker.start('日本語');
+      tracker.stop();
+      const entries = tracker.getEntries();
+      expect(entries[0].name).toBe('🚀 launch');
+      expect(entries[1].name).toBe('日本語');
+    });
+  });
+
+  describe('querying', () => {
+    it('C8: getEntries returns all entries', () => {
+      const tracker = createTracker({ filePath: testFile });
+      tracker.start('a');
+      tracker.stop();
+      tracker.start('b');
+      tracker.stop();
+      expect(tracker.getEntries()).toHaveLength(2);
+    });
+
+    it('C9: getEntries filters by date range', () => {
+      const tracker = createTracker({ filePath: testFile });
+
+      // Create entry with explicit timestamps
+      tracker.start('past');
