it('C2: starting a new timer stops the previous', () => {\n      const tracker = createTracker({ filePath: testFile });\n      tracker.start('work');\n      tracker.start('break');\n      const entries = tracker.getEntries();\n      expect(entries).toHaveLength(2);\n      expect(entries[0].name).toBe('work');\n      expect(entries[0].stop).toBeTypeOf('number');\n      expect(entries[1].name).toBe('break');\n      expect(entries[1].stop).toBeUndefined();\n    });\n\n    it('C4: stopping when nothing is running throws', () => {\n      const tracker = createTracker({ filePath: testFile });\n      expect(() => tracker.stop()).toThrow();\n    });\n\n    it('C5: starting with empty name throws', () => {\n      const tracker = createTracker({ filePath: testFile });\n      expect(() => tracker.start('')).toThrow();\n      expect(() => tracker.start('   ')).toThrow();\n    });\n\n    it('C11: unicode names work', () => {\n      const tracker = createTracker({ filePath: testFile });\n      tracker.start('🚀 launch');\n      tracker.stop();\n      tracker.start('日本語');\n      tracker.stop();\n      const entries = tracker.getEntries();\n      expect(entries[0].name).toBe('🚀 launch');\n      expect(entries[1].name).toBe('日本語');\n    });\n  });\n\n  describe('querying', () => {\n    it('C8: getEntries returns all entries', () => {\n      const tracker = createTracker({ filePath: testFile });\n      tracker.start('a');\n      tracker.stop();\n      tracker.start('b');\n      tracker.stop();\n      expect(tracker.getEntries()).toHaveLength(2);\n    });\n\n    it('C9: getEntries filters by date range', () => {\n      const tracker = createTracker({ filePath: testFile });\n      const now = Date.now();\n\n      // Create entry with explicit timestamps\n      tracker.start('past');\n      // We can't manipulate time easily, so let's test the range filter\n      // by creating entries at known times and filtering\n      tracker.stop();\n\n      const allEntries = tracker.getEntries();\