ndex of the running entry (one with no stop time). */\n  #runningIndex(): number {\n    return this.#entries.findIndex(e => e.stop === undefined);\n  }\n\n  /** Validate that the task name is not empty or whitespace-only. */\n  #assertValidName(name: string): void {\n    if (name.trim().length === 0) {\n      throw new Error('Task name must not be empty');\n    }\n  }\n\n  /** Get sub-ms precise duration for an entry. */\n  #getDuration(entry: TimeEntry, index: number): number {\n    const startMs = this.#startTimes.get(index) ?? entry.start.getTime();\n    const endMs = this.#stopTimes.get(index) ?? performance.now();\n    return endMs - startMs;\n  }\n\n  // -- Public API ----------------------------------------------------------\n\n  start(name: string): TimeEntry {\n    this.#assertValidName(name);\n\n    // Auto-stop any running timer\n    const runningIdx = this.#runningIndex();\n    if (runningIdx !== -1) {\n      const now = new Date();\n      this.#entries[runningIdx].stop = now;\n      this.#stopTimes.set(runningIdx, performance.now());\n    }\n\n    const idx = this.#nextIndex++;\n    const entry: TimeEntry = {\n      name,\n      start: new Date(),\n    };\n    this.#entries.push(entry);\n    this.#startTimes.set(idx, performance.now());\n    this.#save();\n    return entry;\n  }\n\n  stop(): TimeEntry {\n    const runningIdx = this.#runningIndex();\n    if (runningIdx === -1) {\n      throw new Error('No timer is currently running');\n    }\n\n    this.#entries[runningIdx].stop = new Date();\n    this.#stopTimes.set(runningIdx, performance.now());\n    this.#save();\n    return this.#entries[runningIdx];\n  }\n\n  getLog(options?: { since?: Date }): TimeEntry[] {\n    let entries = this.#entries;\n\n    if (options?.since !== undefined) {\n      const sinceTime = options.since.getTime();\n      // Include entries that started >= since, OR that are still running\n      entries = entries.filter(\n        e => e.stop === undefined || e.start.getTime() >= sinceTime,\n      );\n    }\n\n    return entries;\n  }\n\n  getSummary(): Record<string, number> {\n    const summary: Record<string, number> = {};\n\n    for (let i = 0; i < this.#entries.length; i++) {\n      const entry = this.#entries[i];\n      const duration = Math.max(0, this.#getDuration(entry, i));\n      summary[entry.name] = (summary[entry.name] ?? 0) + duration;\n    }\n\n    return summary;\n  }\n\n  getActiveTask(): string | null {\n    const runningIdx = this.#runningIndex();\n    return runningIdx === -1 ? null : this.#entries[runningIdx].name;\n  }\n}\n\n// ---------------------------------------------------------------------------\n// Public factory\n// ---------------------------------------------------------------------------\n\nexport function createTracker(options?: CreateTrackerOptions): TimeTracker {\n  return new TimeTrackerImpl(options ?? {});\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":870,"cache_creation_input_tokens":0,"cache_read_input_tokens":39552,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"64107302-44f9-46af-96b4-4a35f4633892","uuid":"99351c9f-1e4a-4912-ab3f-58c419993b70"}
