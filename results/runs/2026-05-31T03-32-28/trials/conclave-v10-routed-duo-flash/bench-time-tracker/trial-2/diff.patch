+import { readFileSync, writeFileSync, mkdirSync } from 'fs';
+import { dirname, resolve } from 'path';
+
+// ---------------------------------------------------------------------------
+// Types
+// ---------------------------------------------------------------------------
+
+export interface TimeEntry {
+  name: string;
+  start: Date;
+  stop?: Date;
+}
+
+export interface TimeTracker {
+  /** Start a named timer. Auto-stops any running timer. Throws on empty name. */
+  start(name: string): TimeEntry;
+
+  /** Stop the running timer. Throws if nothing is running. Returns the stopped entry. */
+  stop(): TimeEntry;
+
+  /** Return all entries, optionally filtered by start date >= `since`. */
+  getLog(options?: { since?: Date }): TimeEntry[];
+
+  /** Return total ms per task name (floating-point sub-ms precision). Running tasks use the current time. */
+  getSummary(): Record<string, number>;
+
+  /** Return the current running task name, or `null` if idle. */
+  getActiveTask(): string | null;
+}
+
+export interface CreateTrackerOptions {
+  /** Path to the JSON persistence file (default: `./time-tracker.json`). */
+  dbPath?: string;
+}
+
+// ---------------------------------------------------------------------------
+// Internal storage format
+// ---------------------------------------------------------------------------
+
+interface StoredEntry {
+  name: string;
+  start: string; // ISO 8601
+  startMs: number; // performance.now() at start
+  stop?: string; // ISO 8601
+  stopMs?: number; // performance.now() at stop
+}
+
+interface Store {
+  entries: StoredEntry[];
+}
+
+// ---------------------------------------------------------------------------
+// Implementation
+// ---------------------------------------------------------------------------
+
+class TimeTrackerImpl implements TimeTracker {
+  #dbPath: string;
+  #entries: TimeEntry[];
+  #startTimes: Map<number, number> = new Map(); // entry index → performance.now()
+  #stopTimes: Map<number, number> = new Map();  // entry index → performance.now()
+  #nextIndex = 0;
+
+  constructor(options: CreateTrackerOptions) {
+    this.#dbPath = resolve(options.dbPath ?? './time-tracker.json');
+    this.#entries = [];
+
+    // Load existing data from disk synchronously
+    try {
+      const raw = readFileSync(this.#dbPath, 'utf-8');
+      const store: Store = JSON.parse(raw) as Store;
+      for (let i = 0; i < store.entries.length; i++) {
+        const e = store.entries[i];
+        this.#entries.push({
+          name: e.name,
+          start: new Date(e.start),
+          ...(e.stop ? { stop: new Date(e.stop) } : {}),
+        });
+        if (e.startMs !== undefined) {
+          this.#startTimes.set(i, e.startMs);
+        }
+        if (e.stopMs !== undefined) {
+          this.#stopTimes.set(i, e.stopMs);
+        }
+      }
+      this.#nextIndex = store.entries.length;
+    } catch (err: unknown) {
+      // File doesn't exist yet — that's fine, start fresh
+      if ((err as NodeJS.ErrnoException).code !== 'ENOENT') {
+        throw err;
+      }
+    }
+  }
+
+  /** Persist current state to disk, creating parent directories if needed. */
+  #save(): void {
+    mkdirSync(dirname(this.#dbPath), { recursive: true });
+    const storedEntries: StoredEntry[] = this.#entries.map((e, i) => ({
+      name: e.name,
+      start: e.start.toISOString(),
+      startMs: this.#startTimes.get(i) ?? e.start.getTime(),
+      ...(e.stop ? { stop: e.stop.toISOString(), stopMs: this.#stopTimes.get(i) ?? e.stop.getTime() } : {}),
+    }));
+    const store: Store = { entries: storedEntries };
+    writeFileSync(this.#dbPath, JSON.stringify(store, null, 2), 'utf-8');
+  }
+
+  /** Find the index of the running entry (one with no stop time). */
+  #runningIndex(): number {
+    return this.#entries.findIndex(e => e.stop === undefined);
+  }
+
+  /** Validate that the task name is not empty or whitespace-only. */
+  #assertValidName(name: string): void {
+    if (name.trim().length === 0) {
+      throw new Error('Task name must not be empty');
+    }
+  }
+
+  /** Get sub-ms precise duration for an entry. */
+  #getDuration(entry: TimeEntry, index: number): number {
+    const startMs = this.#startTimes.get(index) ?? entry.start.getTime();
+    const endMs = this.#stopTimes.get(index) ?? performance.now();
+    return endMs - startMs;
+  }
+
+  // -- Public API ----------------------------------------------------------
+
+  start(name: string): TimeEntry {
+    this.#assertValidName(name);
+
+    // Auto-stop any running timer
+    const runningIdx = this.#runningIndex();
+    if (runningIdx !== -1) {
+      const now = new Date();
+      this.#entries[runningIdx].stop = now;
+      this.#stopTimes.set(runningIdx, performance.now());
+    }
+
+    const idx = this.#nextIndex++;
+    const entry: TimeEntry = {
+      name,
+      start: new Date(),
+    };
+    this.#entries.push(entry);
+    this.#startTimes.set(idx, performance.now());
+    this.#save();
+    return entry;
+  }
+
+  stop(): TimeEntry {
+    const runningIdx = this.#runningIndex();
+    if (runningIdx === -1) {
+      throw new Error('No timer is currently running');
+    }
+
+    this.#entries[runningIdx].stop = new Date();
+    this.#stopTimes.set(runningIdx, performance.now());
+    this.#save();
+    return this.#entries[runningIdx];
+  }
+
+  getLog(options?: { since?: Date }): TimeEntry[] {
+    let entries = this.#entries;
+
+    if (options?.since !== undefined) {
+      const sinceTime = options.since.getTime();
+      // Include entries that started >= since, OR that are still running
+      entries = entries.filter(
+        e => e.stop === undefined || e.start.getTime() >= sinceTime,
+      );
+    }
+
+    return entries;
+  }
+
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+
+    for (let i = 0; i < this.#entries.length; i++) {
+      const entry = this.#entries[i];
+      const duration = Math.max(0, this.#getDuration(entry, i));
+      summary[entry.name] = (summary[entry.name] ?? 0) + duration;
+    }
+
+    return summary;
+  }
+
+  getActiveTask(): string | null {
+    const runningIdx = this.#runningIndex();
+    return runningIdx === -1 ? null : this.#entries[runningIdx].name;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Public factory
+// ---------------------------------------------------------------------------
+
+export function createTracker(options?: CreateTrackerOptions): TimeTracker {
+  return new TimeTrackerImpl(options ?? {});
+}
