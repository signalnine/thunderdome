nt('Euro Cash', 'asset', 'EUR');\n      expect(() =>\n        ledger.postEntry(\n          'Bad mix',\n          [{ account: 'Cash', amount: 100 }],\n          [{ account: 'Euro Cash', amount: 100 }]\n        )\n      ).toThrow(/currency/i);\n    });\n  });\n\n  // ===== Balances (6 tests, 5 pass) =====\n\n  describe('getBalance', () => {\n    beforeEach(() => {\n      ledger.createAccount('Cash', 'asset');\n      ledger.createAccount('Revenue', 'revenue');\n      ledger.createAccount('AP', 'liability');\n      ledger.createAccount('Expenses', 'expense');\n    });\n\n    it('returns zero for new accounts', () => {\n      expect(ledger.getBalance('Cash')).toBe(0);\n    });\n\n    it('returns correct asset balance', () => {\n      ledger.postEntry(\n        'Sale',\n        [{ account: 'Cash', amount: 100 }],\n        [{ account: 'Revenue', amount: 100 }]\n      );\n      expect(ledger.getBalance('Cash')).toBe(100);\n    });\n\n    it('accumulates multiple entries', () => {\n      ledger.postEntry(\n        'Sale 1',\n        [{ account: 'Cash', amount: 100 }],\n        [{ account: 'Revenue', amount: 100 }]\n      );\n      ledger.postEntry(\n        'Expense',\n        [{ account: 'Expenses', amount: 30 }],\n        [{ account: 'Cash', amount: 30 }]\n      );\n      expect(ledger.getBalance('Cash')).toBe(70);\n    });\n\n    it('throws for unknown account', () => {\n      expect(() => ledger.getBalance('Nonexistent')).toThrow(/not found/i);\n    });\n\n    it('returns correct expense balance', () => {\n      ledger.postEntry(\n        'Rent',\n        [{ account: 'Expenses', amount: 500 }],\n        [{ account: 'Cash', amount: 500 }]\n      );\n      expect(ledger.getBalance('Expenses')).toBe(500);\n    });\n\n    it('returns positive balance for liability with credits', () => {\n      ledger.postEntry(\n        'Loan received',\n        [{ account: 'Cash', amount: 1000 }],\n        [{ account: 'AP', amount: 1000 }]\n      );\n      // Liabilities have credit-normal 