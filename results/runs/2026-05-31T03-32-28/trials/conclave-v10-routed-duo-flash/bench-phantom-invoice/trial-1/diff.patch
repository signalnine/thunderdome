nt and 8% tax', () => {\n165\t    // subtotal=400, 25% discount => 300, 8% tax => 324\n166\t    const total = calculateInvoiceTotal(400, 0.25, 0.08);\n167\t    expect(total).toBe(324);\n168\t  });\n169\t\n170\t  it('applies discount correctly', () => {\n171\t    expect(applyDiscount(200, 0.15)).toBe(170);\n172\t  });\n173\t\n174\t  it('handles zero tax rate', () => {\n175\t    const total = calculateInvoiceTotal(500, 0.2, 0);\n176\t    expect(total).toBe(400);\n177\t  });\n178\t\n179\t  it('handles zero subtotal', () => {\n180\t    const total = calculateInvoiceTotal(0, 0.1, 0.08);\n181\t    expect(total).toBe(0);\n182\t  });\n183\t\n184\t  it('generates invoice with correct total', () => {\n185\t    const id = generateInvoice(db, {\n186\t      customer_id: 'cust-1',\n187\t      date: '2024-05-10',\n188\t      discount_rate: 0,\n189\t      tax_rate: 0.08,\n190\t      line_items: [\n191\t        { description: 'Service', quantity: 1, unit_price: 1000 },\n192\t      ],\n193\t    });\n194\t    const invoice = getInvoiceById(db, id);\n195\t    // 1000 * 1.0 * 1.08 = 1080\n196\t    expect(invoice!.total).toBe(1080);\n197\t  });\n198\t\n199\t  it('generates invoice with multiple line items and discount', () => {\n200\t    const id = generateInvoice(db, {\n201\t      customer_id: 'cust-2',\n202\t      date: '2024-07-20',\n203\t      discount_rate: 0.15,\n204\t      tax_rate: 0,\n205\t      line_items: [\n206\t        { description: 'Product A', quantity: 10, unit_price: 50 },\n207\t        { description: 'Product B', quantity: 5, unit_price: 100 },\n208\t      ],\n209\t    });\n210\t    const invoice = getInvoiceById(db, id);\n211\t    // subtotal = 500 + 500 = 1000\n212\t    // discounted = 1000 * 0.85 = 850\n213\t    // total = 850 * 1.0 = 850\n214\t    expect(invoice!.total).toBe(850);\n215\t  });\n216\t});\n217\t\n218\t// ─── Date Range Queries (7 tests) ──────────────────────────────────\n219\t\n220\tdescribe('Date Range Queries', () => {\n221\t  beforeEach(() => {\n2