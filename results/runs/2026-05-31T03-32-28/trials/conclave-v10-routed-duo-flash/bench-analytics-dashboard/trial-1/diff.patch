+{"type":"assistant","message":{"id":"f6802171-a0f7-46f6-939a-9e29e83d6e05","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{"type":"tool_use","id":"call_00_2nrgcItr1kuM6V4k3CyL4480","name":"Write","input":{"file_path":"/workspace/src/routes/auth.ts","content":"import { Router, Request, Response, NextFunction } from 'express';\nimport { randomUUID } from 'node:crypto';\nimport { scryptSync, randomBytes, timingSafeEqual } from 'node:crypto';\nimport { getDb } from '../db.js';\nimport { User, UserResponse } from '../types.js';\nimport { signToken, authenticate } from '../middleware/auth.js';\nimport { createBadRequest, createUnauthorized, createForbidden, createNotFound } from '../middleware/error.js';\n\nconst router = Router();\n\nfunction hashPassword(password: string): string {\n  const salt = randomBytes(16).toString('hex');\n  const hash = scryptSync(password, salt, 64).toString('hex');\n  return `${salt}:${hash}`;\n}\n\nfunction verifyPassword(password: string, storedHash: string): boolean {\n  const [salt, hash] = storedHash.split(':');\n  const derivedHash = scryptSync(password, salt, 64).toString('hex');\n  // Use timingSafeEqual to prevent timing attacks\n  const buf1 = Buffer.from(hash);\n  const buf2 = Buffer.from(derivedHash);\n  if (buf1.length !== buf2.length) return false;\n  return timingSafeEqual(buf1, buf2);\n}\n\nfunction toUserResponse(user: User): UserResponse {\n  return {\n    id: user.id,\n    email: user.email,\n    tenant_id: user.tenant_id,\n    role: user.role,\n    created_at: user.created_at,\n  };\n}\n\n// POST /api/auth/register\nrouter.post('/register', (req: Request, res: Response, next: NextFunction) => {\n  try {\n    const { email, password, tenant_id } = req.body;\n\n    if (!email || !password) {\n      next(createBadRequest('Email and password are required'));\n      return;\n    }\n\n    if (typeof email !== 'string' || typeof password !== 'string') {\n      next(createBadRequest('Email and password must be strings'));\n      return;\n    }\n\n    if (password.length < 6) {\n      next(createBadRequest('Password must be at least 6 characters'));\n      return;\n    }\n\n    if (!email.includes('@')) {\n      next(createBadRequest('Invalid email format'));\n      return;\n    }\n\n    const db = getDb();\n\n    // Check if email already exists\n    const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(email);\n    if (existing) {\n      next(createBadRequest('Email already registered'));\n      return;\n    }\n\n    const id = randomUUID();\n    const effectiveTenantId = tenant_id ?? randomUUID();\n    const passwordHash = hashPassword(password);\n\n    // First user in a tenant gets admin, others get viewer\n    const existingUsersInTenant = db.prepare('SELECT COUNT(*) as count FROM users WHERE tenant_id = ?').get(effectiveTenantId) as { count: number };\n    const role = existingUsersInTenant.count === 0 ? 'admin' : 'viewer';\n\n    db.prepare(\n      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'\n    ).run(id, email, passwordHash, effectiveTenantId, role);\n\n    const user = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as User;\n    const token = signToken({ sub: user.id, tid: user.tenant_id, role: user.role });\n\n    res.status(201).json({ user: toUserResponse(user), token });\n  } catch (err) {\n    next(err);\n  }\n});\n\n// POST /api/auth/login\nrouter.post('/login', (req: Request, res: Response, next: NextFunction) => {\n  try {\n    const { email, password } = req.body;\n\n    if (!email || !password) {\n      next(createBadRequest('Email and password are required'));\n      return;\n    }\n\n    const db = getDb();\n    const user = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as User | undefined;\n\n    if (!user || !verifyPassword(password, user.password_hash)) {\n      next(createUnauthorized('Invalid email or password'));\n      return;\n    }\n\n    const token = signToken({ sub: user.id, tid: user.tenant_id, role: user.role });\n\n    res.json({ user: toUserResponse(user), token });\n  } catch (err) {\n    next(err);\n  }\n});\n\n// GET /api/auth/me\nrouter.get('/me', authenticate, (req: Request, res: Response, next: NextFunction) => {\n  try {\n    const db = getDb();\n    const user = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as User | undefined;\n\n    if (!user) {\n      next(createNotFound('User not found'));\n      return;\n    }\n\n    res.json({ user: toUserResponse(user) });\n  } catch (err) {\n    next(err);\n  }\n});\n\n// PUT /api/auth/users/:id/role\nrouter.put('/users/:id/role', authenticate, (req: Request, res: Response, next: NextFunction) => {\n  try {\n    // Only admins can change roles\n    if (req.user!.role !== 'admin') {\n      next(createForbidden('Only admins can change roles'));\n      return;\n    }\n\n    const { id } = req.params;\n    const { role } = req.body;\n\n    if (!role || !['admin', 'editor', 'viewer'].includes(role)) {\n      next(createBadRequest('Role must be one of: admin, editor, viewer'));\n      return;\n    }\n\n    const db = getDb();\n    const targetUser = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as User | undefined;\n\n    if (!targetUser) {\n      next(createNotFound('User not found'));\n      return;\n    }\n\n    // Must be in same tenant\n    if (targetUser.tenant_id !== req.user!.tenant_id) {\n      next(createNotFound('User not found'));\n      return;\n    }\n\n    // Cannot change own role\n    if (targetUser.id === req.user!.id) {\n      next(createForbidden('Cannot change your own role'));\n      return;\n    }\n\n    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, id);\n\n    const updatedUser = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as User;\n    res.json({ user: toUserResponse(updatedUser) });\n  } catch (err) {\n    next(err);\n  }\n});\n\nexport default router;\n"}}],"stop_reason":null,"st