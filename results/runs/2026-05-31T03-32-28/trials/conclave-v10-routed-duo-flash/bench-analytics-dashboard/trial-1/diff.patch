ROM events WHERE tenant_id = ? ORDER BY timestamp ASC'\n    ).all(req.user!.tenant_id) as Array<Record<string, unknown>>;\n\n    if (format === 'csv') {\n      const columns = ['id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'];\n      const csv = toCsv(events, columns);\n      res.setHeader('Content-Type', 'text/csv');\n      res.setHeader('Content-Disposition', 'attachment; filename=\"events.csv\"');\n      res.send(csv);\n    } else {\n      res.setHeader('Content-Type', 'application/json');\n      res.setHeader('Content-Disposition', 'attachment; filename=\"events.json\"');\n      res.json(events);\n    }\n  } catch (err) {\n    next(err);\n  }\n});\n\n// GET /api/exports/dashboards/:id?format=json|csv\nrouter.get('/dashboards/:id', (req: Request, res: Response, next: NextFunction) => {\n  try {\n    const format = (req.query.format as string) ?? 'json';\n    const db = getDb();\n\n    const dashboard = db.prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?').get(req.params.id, req.user!.tenant_id) as Record<string, unknown> | undefined;\n\n    if (!dashboard) {\n      next(createNotFound('Dashboard not found'));\n      return;\n    }\n\n    // Get widgets for this dashboard\n    const widgets = db.prepare('SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y, position_x').all(req.params.id);\n\n    const exportData = { dashboard, widgets };\n\n    if (format === 'csv') {\n      // For CSV, output dashboard fields then widget rows\n      const dashColumns = ['id', 'name', 'config', 'created_at', 'updated_at'];\n      const widgetColumns = ['id', 'type', 'config', 'position_x', 'position_y', 'width', 'height'];\n\n      const dashCsv = toCsv([dashboard as Record<string, unknown>], dashColumns);\n      const widgetCsv = toCsv(widgets as Array<Record<string, unknown>>, widgetColumns);\n\n      res.setHeader('Content-Type', 'text/csv');\n      res.setHeader('Content-Disposition', 'attachment; filename=\"dashboard.csv\"');\n      res.send(`# Dashboard\\n${dashCsv}\\n\\n# Widgets\\n${widgetCsv}`);\n    } else {\n      res.setHeader('Content-Type', 'application/json');\n      res.setHeader('Content-Disposition', 'attachment; filename=\"dashboard.json\"');\n      res.json(exportData);\n    }\n  } catch (err) {\n    next(err);\n  }\n});\n\nexport default router;\n","structuredPatch":[{"oldStart":1,"oldLines":8,"newStart":1,"newLines":7,"lines":[" import { Router, Request, Response, NextFunction } from 'express';"," import { getDb } from '../db.js';"," import { authenticate } from '../middleware/auth.js';","-import { createBadRequest, createNotFound } from '../middleware/error.js';","-import { Event } from '../types.js';","+import { createNotFound } from '../middleware/error.js';"," "," const router = Router();"," "]}],"userModified":false,"replaceAll":false}}
