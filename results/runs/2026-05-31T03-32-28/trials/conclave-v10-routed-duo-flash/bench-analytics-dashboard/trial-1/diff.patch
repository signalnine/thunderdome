+++ b/src/routes/queries.ts
@@ -0,0 +1,125 @@
+import { Router, Request, Response, NextFunction } from 'express';
+import { getDb } from '../db.js';
+import { authenticate } from '../middleware/auth.js';
+import { createBadRequest } from '../middleware/error.js';
+
+const router = Router();
+
+// All query routes require authentication
+router.use(authenticate);
+
+// GET /api/queries/count - Count events matching filter
+router.get('/count', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { name, startDate, endDate } = req.query;
+    const db = getDb();
+
+    let sql = 'SELECT COUNT(*) as count FROM events WHERE tenant_id = ?';
+    const params: unknown[] = [req.user!.tenant_id];
+
+    if (name && typeof name === 'string') {
+      sql += ' AND name = ?';
+      params.push(name);
+    }
+
+    if (startDate && typeof startDate === 'string') {
+      sql += ' AND timestamp >= ?';
+      params.push(startDate);
+    }
+
+    if (endDate && typeof endDate === 'string') {
+      sql += ' AND timestamp <= ?';
+      params.push(endDate);
+    }
+
+    const result = db.prepare(sql).get(...params) as { count: number };
+    res.json({ count: result.count });
+  } catch (err) {
+    next(err);
+  }
+});
+
+// GET /api/queries/timeseries - Timeseries bucketed counts
+router.get('/timeseries', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { name, startDate, endDate, bucket } = req.query;
+
+    if (!name || typeof name !== 'string') {
+      next(createBadRequest('name query parameter is required'));
+      return;
+    }
+
+    const bucketSize = (bucket as string) ?? 'day';
+
+    let dateFormat: string;
+    if (bucketSize === 'hour') {
+      dateFormat = '%Y-%m-%d %H:00:00';
+    } else if (bucketSize === 'minute') {
+      dateFormat = '%Y-%m-%d %H:%M:00';
+    } else {
+      dateFormat = '%Y-%m-%d';
+    }
+
+    const db = getDb();
+    let sql = `SELECT strftime('${dateFormat}', timestamp) as date, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?`;
+    const params: unknown[] = [req.user!.tenant_id, name];
+
+    if (startDate && typeof startDate === 'string') {
+      sql += ' AND timestamp >= ?';
+      params.push(startDate);
+    }
+
+    if (endDate && typeof endDate === 'string') {
+      sql += ' AND timestamp <= ?';
+      params.push(endDate);
+    }
+
+    sql += " GROUP BY strftime('" + dateFormat + "', timestamp) ORDER BY date ASC";
+
+    const results = db.prepare(sql).all(...params) as Array<{ date: string; count: number }>;
+    res.json(results);
+  } catch (err) {
+    next(err);
+  }
+});
+
+// GET /api/queries/breakdown - Breakdown by property value
+router.get('/breakdown', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { name, property, startDate, endDate } = req.query;
+
+    if (!name || typeof name !== 'string') {
+      next(createBadRequest('name query parameter is required'));
+      return;
+    }
+
+    if (!property || typeof property !== 'string') {
+      next(createBadRequest('property query parameter is required'));
+      return;
+    }
+
+    const db = getDb();
+    // Use json_extract to extract the property value from the properties JSON
+    let sql = `SELECT json_extract(properties, '$.${property}') as value, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?`;
+    const params: unknown[] = [req.user!.tenant_id, name];
+
+    if (startDate && typeof startDate === 'string') {
+      sql += ' AND timestamp >= ?';
+      params.push(startDate);
+    }
+
+    if (endDate && typeof endDate === 'string') {
+      sql += ' AND timestamp <= ?';
+      params.push(endDate);
+    }
+
+    sql += ' GROUP BY json_extract(properties, \'$.' + property + '\') ORDER BY count DESC';
+
+    const results = db.prepare(sql).all(...params) as Array<{ value: unknown; count: number }>;
+    res.json(results);
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
