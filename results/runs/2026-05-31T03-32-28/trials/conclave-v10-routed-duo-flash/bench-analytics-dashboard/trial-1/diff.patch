tFunction) => {\n  try {\n    const { events } = req.body;\n\n    if (!Array.isArray(events) || events.length === 0) {\n      next(createBadRequest('Events must be a non-empty array'));\n      return;\n    }\n\n    const db = getDb();\n    const insert = db.prepare(\n      'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'\n    );\n\n    const ids: string[] = [];\n\n    const insertMany = db.transaction((eventList: Array<{ name: string; properties?: Record<string, unknown>; timestamp?: string; session_id?: string }>) => {\n      for (const event of eventList) {\n        if (!event.name || typeof event.name !== 'string') {\n          throw createBadRequest('Each event must have a name string');\n        }\n\n        const id = randomUUID();\n        const propsJson = event.properties ? JSON.stringify(event.properties) : '{}';\n        const eventTimestamp = event.timestamp ?? new Date().toISOString();\n\n        insert.run(id, req.user!.tenant_id, event.name, propsJson, eventTimestamp, req.user!.id, event.session_id ?? null);\n        ids.push(id);\n      }\n    });\n\n    insertMany(events);\n\n    res.status(201).json({ ids });\n  } catch (err) {\n    next(err);\n  }\n});\n\nexport default router;\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1617,"cache_creation_input_tokens":0,"cache_read_input_tokens":31232,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0824a419-2aa7-4301-a54e-df3478f41e45","uuid":"81cb82c9-fc09-42ad-95a0-97308708838b"}
