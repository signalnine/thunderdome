res.body.token;\n    adminUser = res.body.user;\n  });\n\n  it('POST /api/auth/register - second user in tenant gets viewer role', async () => {\n    const res = await request(app)\n      .post('/api/auth/register')\n      .send({ email: 'viewer@test.com', password: 'password123', tenant_id: adminUser.tenant_id })\n      .expect(201);\n\n    expect(res.body.user.role).toBe('viewer');\n    viewerToken = res.body.token;\n    viewerUser = res.body.user;\n  });\n\n  it('POST /api/auth/register - rejects duplicate email', async () => {\n    await request(app)\n      .post('/api/auth/register')\n      .send({ email: 'admin@test.com', password: 'password123' })\n      .expect(400);\n  });\n\n  it('POST /api/auth/register - rejects missing fields', async () => {\n    await request(app)\n      .post('/api/auth/register')\n      .send({ email: 'test@test.com' })\n      .expect(400);\n\n    await request(app)\n      .post('/api/auth/register')\n      .send({ password: 'password123' })\n      .expect(400);\n  });\n\n  it('POST /api/auth/register - rejects short password', async () => {\n    await request(app)\n      .post('/api/auth/register')\n      .send({ email: 'short@test.com', password: '12345' })\n      .expect(400);\n  });\n\n  it('POST /api/auth/login - authenticates and returns token', async () => {\n    const res = await request(app)\n      .post('/api/auth/login')\n      .send({ email: 'admin@test.com', password: 'password123' })\n      .expect(200);\n\n    expect(res.body).toHaveProperty('user');\n    expect(res.body).toHaveProperty('token');\n    expect(res.body.user.email).toBe('admin@test.com');\n  });\n\n  it('POST /api/auth/login - rejects wrong password', async () => {\n    await request(app)\n      .post('/api/auth/login')\n      .send({ email: 'admin@test.com', password: 'wrongpassword' })\n      .expect(401);\n  });\n\n  it('POST /api/auth/login - rejects non-existent email', async () => {\n    await request(app)\n      .post('/api/auth/login')\n      .send({ email: 'nobody@test.com', password: 'password123' })\n      .expect(401);\n  });\n\n  it('GET /api/auth/me - returns authenticated user', async () => {\n    const res = await request(app)\n      .get('/api/auth/me')\n      .set('Authorization', `Bearer ${adminToken}`)\n      .expect(200);\n\n    expect(res.body.user.email).toBe('admin@test.com');\n  });\n\n  it('GET /api/auth/me - returns 401 without auth', async () => {\n    const res = await request(app)\n      .get('/api/auth/me')\n      .expect(401);\n\n    expect(res.body).toHaveProperty('error');\n    expect(res.body).toHaveProperty('code');\n  });\n\n  it('GET /api/auth/me - returns 401 with invalid token', async () => {\n    const res = await request(app)\n      .get('/api/auth/me')\n      .set('Authorization', 'Bearer invalid-token')\n      .expect(401);\n\n    expect(res.body).toHaveProperty('error');\n    expect(res.body).toHaveProperty('code');\n  });\n\n  it('PUT /api/auth/users/:id/role - admin can change role', async () => {\n    const res = await request(app)\n      .put(`/api/auth/users/${viewerUser.id}/role`)\n      .set('Authorization', `Bearer ${adminToken}`)\n      .send({ role: 'editor' })\n      .expect(200);\n\n    expect(res.body.user.role).toBe('editor');\n  });\n\n  it('PUT /api/auth/users/:id/role - non-admin gets 403', async () => {\n    await request(app)\n      .put(`/api/auth/users/${adminUser.id}/role`)\n      .set('Authorization', `Bearer ${viewerToken}`)\n      .send({ role: 'viewer' })\n      .expect(403);\n  });\n\n  it('PUT /api/auth/users/:id/role - cannot change own role', async () => {\n    await request(app)\n      .put(`/api/auth/users/${adminUser.id}/role`)\n      .set('Authorization', `Bearer ${adminToken}`)\n      .send({ role: 'viewer' })\n      .expect(403);\n  });\n\n  it('PUT /api/auth/users/:id/role - validates role value', async () => {\n    await request(app)\n      .put(`/api/auth/users/${viewerUser.id}/role`)\n      .set('Authorization', `Bearer ${adminToken