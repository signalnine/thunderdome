@@ -0,0 +1,90 @@
+import { Router, Request, Response, NextFunction } from 'express';
+import { randomUUID } from 'node:crypto';
+import { getDb } from '../db.js';
+import { authenticate } from '../middleware/auth.js';
+import { createBadRequest } from '../middleware/error.js';
+
+const router = Router();
+
+// All event routes require authentication
+router.use(authenticate);
+
+// POST /api/events - Ingest single event
+router.post('/', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { name, properties, timestamp, session_id } = req.body;
+
+    if (!name || typeof name !== 'string') {
+      next(createBadRequest('Event name is required and must be a string'));
+      return;
+    }
+
+    const id = randomUUID();
+    const db = getDb();
+    const propsJson = properties ? JSON.stringify(properties) : '{}';
+
+    // Validate properties is a valid JSON object if provided
+    if (properties !== undefined && properties !== null) {
+      try {
+        JSON.stringify(properties);
+      } catch {
+        next(createBadRequest('Properties must be valid JSON'));
+        return;
+      }
+    }
+
+    const eventTimestamp = timestamp ?? new Date().toISOString();
+
+    db.prepare(
+      'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    ).run(id, req.user!.tenant_id, name, propsJson, eventTimestamp, req.user!.id, session_id ?? null);
+
+    const event = db.prepare('SELECT * FROM events WHERE id = ?').get(id);
+
+    res.status(201).json(event);
+  } catch (err) {
+    next(err);
+  }
+});
+
+// POST /api/events/batch - Ingest batch events
+router.post('/batch', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const { events } = req.body;
+
+    if (!Array.isArray(events) || events.length === 0) {
+      next(createBadRequest('Events must be a non-empty array'));
+      return;
+    }
+
+    const db = getDb();
+    const insert = db.prepare(
+      'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    );
+
+    const ids: string[] = [];
+
+    const insertMany = db.transaction((eventList: Array<{ name: string; properties?: Record<string, unknown>; timestamp?: string; session_id?: string }>) => {
+      for (const event of eventList) {
+        if (!event.name || typeof event.name !== 'string') {
+          throw createBadRequest('Each event must have a name string');
+        }
+
+        const id = randomUUID();
+        const propsJson = event.properties ? JSON.stringify(event.properties) : '{}';
+        const eventTimestamp = event.timestamp ?? new Date().toISOString();
+
+        insert.run(id, req.user!.tenant_id, event.name, propsJson, eventTimestamp, req.user!.id, event.session_id ?? null);
+        ids.push(id);
+      }
+    });
+
+    insertMany(events);
+
+    res.status(201).json({ ids });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
diff --git a/src/routes/exports.ts b/src/routes/exports.ts
new file mode 100644
index 0000000..dc00138
--- /dev/null
+++ b/src/routes/exports.ts
@@ -0,0 +1,92 @@
+import { Router, Request, Response, NextFunction } from 'express';
+import { getDb } from '../db.js';
+import { authenticate } from '../middleware/auth.js';
+import { createNotFound } from '../middleware/error.js';
+
+const router = Router();
+
+// All export routes require authentication
+router.use(authenticate);
+
+function escapeCsvField(value: unknown): string {
+  const str = value === null || value === undefined ? '' : String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n') || str.includes('\r')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+function toCsv(rows: Array<Record<string, unknown>>, columns: string[]): string {
+  const header = columns.map(escapeCsvField).join(',');
+  const lines = rows.map(row =>
+    columns.map(col => escapeCsvField(row[col])).join(',')
+  );
+  return [header, ...lines].join('\n');
+}
+
+// GET /api/exports/events?format=json|csv
+router.get('/events', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const format = (req.query.format as string) ?? 'json';
+    const db = getDb();
+
+    const events = db.prepare(
+      'SELECT id, name, properties, timestamp, user_id, session_id FROM events WHERE tenant_id = ? ORDER BY timestamp ASC'
+    ).all(req.user!.tenant_id) as Array<Record<string, unknown>>;
+
+    if (format === 'csv') {
+      const columns = ['id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'];
+      const csv = toCsv(events, columns);
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', 'attachment; filename="events.csv"');
+      res.send(csv);
+    } else {
+      res.setHeader('Content-Type', 'application/json');
+      res.setHeader('Content-Disposition', 'attachment; filename="events.json"');
+      res.json(events);
+    }
+  } catch (err) {
+    next(err);
+  }
+});
+
+// GET /api/exports/dashboards/:id?format=json|csv
+router.get('/dashboards/:id', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const format = (req.query.format as string) ?? 'json';
+    const db = getDb();
+
+    const dashboard = db.prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?').get(req.params.id, req.user!.tenant_id) as Record<string, unknown> | undefined;
+
+    if (!dashboard) {
+      next(createNotFound('Dashboard not found'));
+      return;
+    }
+
+    // Get widgets for this dashboard
+    const widgets = db.prepare('SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y, position_x').all(req.params.id);
+
+    const exportData = { dashboard, widgets };
+
+    if (format === 'csv') {
+      // For CSV, output dashboard fields then widget rows
+      const dashColumns = ['id', 'name', 'config', 'created_at', 'updated_at'];
+      const widgetColumns = ['id', 'type', 'config', 'position_x', 'position_y', 'width', 'height'];
+
+      const dashCsv = toCsv([dashboard as Record<string, unknown>], dashColumns);
+      const widgetCsv = toCsv(widgets as Array<Record<string, unknown>>, widgetColumns);
+
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', 'attachment; filename="dashboard.csv"');
+      res.send(`# Dashboard\n${dashCsv}\n\n# Widgets\n${widgetCsv}`);
+    } else {
+      res.setHeader('Content-Type', 'application/json');
+      res.setHeader('Content-Disposition', 'attachment; filename="dashboard.json"');
+      res.json(exportData);
+    }
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
diff --git a/src/routes/queries.ts b/src/routes/queries.ts
new file mode 100644
