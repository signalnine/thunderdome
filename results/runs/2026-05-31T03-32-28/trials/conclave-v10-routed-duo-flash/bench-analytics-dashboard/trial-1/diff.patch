ect(entry).toHaveProperty('count');\n    }\n  });\n\n  it('GET /api/queries/breakdown - requires name and property', async () => {\n    await request(app)\n      .get('/api/queries/breakdown')\n      .set('Authorization', `Bearer ${adminToken}`)\n      .expect(400);\n\n    await request(app)\n      .get('/api/queries/breakdown?name=page_view')\n      .set('Authorization', `Bearer ${adminToken}`)\n      .expect(400);\n  });\n\n  it('GET /api/queries/breakdown - requires auth', async () => {\n    await request(app)\n      .get('/api/queries/breakdown?name=page_view&property=url')\n      .expect(401);\n  });\n\n  it('tenant isolation - other tenant sees no events', async () => {\n    const other = await request(app)\n      .post('/api/auth/register')\n      .send({ email: 'query-other@test.com', password: 'password123' });\n\n    const res = await request(app)\n      .get('/api/queries/count')\n      .set('Authorization', `Bearer ${other.body.token}`)\n      .expect(200);\n\n    expect(res.body.count).toBe(0);\n  });\n});\n\ndescribe('Dashboard Configuration', () => {\n  let adminToken: string;\n  let secondTenantToken: string;\n  let dashboardId: string;\n  let widgetId: string;\n\n  beforeAll(async () => {\n    const admin = await request(app)\n      .post('/api/auth/register')\n      .send({ email: 'dash-admin@test.com', password: 'password123' });\n\n    adminToken = admin.body.token;\n\n    const other = await request(app)\n      .post('/api/auth/register')\n      .send({ email: 'dash-other@test.com', password: 'password123' });\n\n    secondTenantToken = other.body.token;\n  });\n\n  it('POST /api/dashboards - creates a dashboard', async () => {\n    const res = await request(app)\n      .post('/api/dashboards')\n      .set('Authorization', `Bearer ${adminToken}`)\n      .send({ name: 'My Dashboard', config: { theme: 'dark' } })\n      .expect(201);\n\n    expect(res.body).toHaveProperty('id');\n    expect(res.body.name).toBe('My Dashboard');\n    expect(res.body