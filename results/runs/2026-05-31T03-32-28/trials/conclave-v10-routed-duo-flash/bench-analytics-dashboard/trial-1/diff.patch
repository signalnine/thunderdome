   .expect(200);\n\n    expect(res.body.name).toBe('Updated Dashboard');\n  });\n\n  it('DELETE /api/dashboards/:id - deletes dashboard', async () => {\n    // Create a dashboard to delete\n    const createRes = await request(app)\n      .post('/api/dashboards')\n      .set('Authorization', `Bearer ${adminToken}`)\n      .send({ name: 'To Delete' })\n      .expect(201);\n\n    const deleteId = createRes.body.id;\n\n    await request(app)\n      .delete(`/api/dashboards/${deleteId}`)\n      .set('Authorization', `Bearer ${adminToken}`)\n      .expect(204);\n\n    // Verify it's gone\n    await request(app)\n      .get(`/api/dashboards/${deleteId}`)\n      .set('Authorization', `Bearer ${adminToken}`)\n      .expect(404);\n  });\n\n  describe('Widgets', () => {\n    it('POST /api/dashboards/:id/widgets - creates widget', async () => {\n      const res = await request(app)\n        .post(`/api/dashboards/${dashboardId}/widgets`)\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({\n          type: 'counter',\n          config: { eventName: 'page_view' },\n          position_x: 0,\n          position_y: 0,\n          width: 2,\n          height: 1,\n        })\n        .expect(201);\n\n      expect(res.body).toHaveProperty('id');\n      expect(res.body.type).toBe('counter');\n      widgetId = res.body.id;\n    });\n\n    it('POST /api/dashboards/:id/widgets - requires valid type', async () => {\n      await request(app)\n        .post(`/api/dashboards/${dashboardId}/widgets`)\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({ type: 'invalid' })\n        .expect(400);\n    });\n\n    it('PUT /api/dashboards/:dashboard_id/widgets/:widget_id - updates widget', async () => {\n      const res = await request(app)\n        .put(`/api/dashboards/${dashboardId}/widgets/${widgetId}`)\n        .set('Authorization', `Bearer ${adminToken}`)\n        .send({ type: 'timeseries', width: 3 })\n        .expect(200);\n\n      expect(res.body.type).