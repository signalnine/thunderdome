@@ -0,0 +1,95 @@
+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db.js';
+import { requireAuth } from '../middleware/auth.js';
+
+const router = Router();
+
+// Validate an event body
+function validateEvent(body: Record<string, unknown>): string | null {
+  if (!body.name || typeof body.name !== 'string') {
+    return 'Event name is required and must be a string';
+  }
+  if (body.properties !== undefined) {
+    if (typeof body.properties !== 'object' || body.properties === null || Array.isArray(body.properties)) {
+      return 'Properties must be a JSON object';
+    }
+  }
+  if (body.timestamp !== undefined && typeof body.timestamp !== 'string') {
+    return 'Timestamp must be a string';
+  }
+  return null;
+}
+
+// POST /api/events - Ingest a single event
+router.post('/', requireAuth, (req: Request, res: Response) => {
+  const validationError = validateEvent(req.body);
+  if (validationError) {
+    res.status(400).json({ error: validationError, code: 400 });
+    return;
+  }
+
+  const { name, properties, timestamp, session_id: sessionId } = req.body;
+  const db = getDb();
+  const id = uuidv4();
+  const tenantId = req.user!.tenantId;
+  const userId = req.user!.id;
+  const propertiesStr = properties ? JSON.stringify(properties) : '{}';
+  const ts = timestamp || new Date().toISOString();
+
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  ).run(id, tenantId, name, propertiesStr, ts, userId, sessionId || null);
+
+  const event = db.prepare('SELECT * FROM events WHERE id = ?').get(id) as Record<string, unknown>;
+  res.status(201).json({
+    id: event.id,
+    name: event.name,
+    tenant_id: event.tenant_id,
+    properties: JSON.parse(event.properties as string),
+    timestamp: event.timestamp,
+    user_id: event.user_id,
+    session_id: event.session_id,
+  });
+});
+
+// POST /api/events/batch - Ingest multiple events
+router.post('/batch', requireAuth, (req: Request, res: Response) => {
+  const { events } = req.body;
+
+  if (!Array.isArray(events) || events.length === 0) {
+    res.status(400).json({ error: 'Events must be a non-empty array', code: 400 });
+    return;
+  }
+
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+  const userId = req.user!.id;
+
+  const insert = db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  );
+
+  const insertMany = db.transaction((eventList: Record<string, unknown>[]) => {
+    for (const event of eventList) {
+      const validationError = validateEvent(event);
+      if (validationError) {
+        throw new Error(validationError);
+      }
+      const id = uuidv4();
+      const propertiesStr = event.properties ? JSON.stringify(event.properties) : '{}';
+      const ts = event.timestamp || new Date().toISOString();
+      insert.run(id, tenantId, event.name, propertiesStr, ts, userId, event.session_id || null);
+    }
+  });
+
+  try {
+    insertMany(events);
+    res.status(201).json({ count: events.length });
+  } catch (err) {
+    const message = err instanceof Error ? err.message : 'Invalid event data';
+    res.status(400).json({ error: message, code: 400 });
+  }
+});
+
+export default router;
diff --git a/src/routes/export.ts b/src/routes/export.ts
new file mode 100644
