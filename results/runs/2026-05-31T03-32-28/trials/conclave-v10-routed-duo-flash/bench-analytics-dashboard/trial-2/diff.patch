p,\n        event.user_id || '',\n        event.session_id || '',\n      ].join(','));\n    }\n    res.set('Content-Type', 'text/csv');\n    res.set('Content-Disposition', 'attachment; filename=\"events.csv\"');\n    res.send(csvRows.join('\\n'));\n  } else {\n    res.json(events);\n  }\n});\n\n// GET /api/export/dashboard/:id - Export a dashboard with its widgets\nrouter.get('/dashboard/:id', requireAuth, (req: Request, res: Response) => {\n  const { format } = req.query;\n  const db = getDb();\n  const tenantId = req.user!.tenantId;\n  const { id } = req.params;\n\n  const dashboard = db.prepare(\n    'SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?'\n  ).get(id, tenantId) as Record<string, unknown> | undefined;\n\n  if (!dashboard) {\n    res.status(404).json({ error: 'Dashboard not found', code: 404 });\n    return;\n  }\n\n  const widgets = db.prepare(\n    'SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y ASC, position_x ASC'\n  ).all(id) as Array<Record<string, unknown>>;\n\n  const data = {\n    id: dashboard.id,\n    tenant_id: dashboard.tenant_id,\n    name: dashboard.name,\n    owner_id: dashboard.owner_id,\n    config: JSON.parse(dashboard.config as string),\n    created_at: dashboard.created_at,\n    updated_at: dashboard.updated_at,\n    widgets: widgets.map((w) => ({\n      id: w.id,\n      type: w.type,\n      config: JSON.parse(w.config as string),\n      position_x: w.position_x,\n      position_y: w.position_y,\n      width: w.width,\n      height: w.height,\n    })),\n  };\n\n  const fmt = format === 'csv' ? 'csv' : 'json';\n\n  if (fmt === 'csv') {\n    // CSV export: flatten dashboard and widgets into separate sections\n    const lines: string[] = [];\n    // Section 1: dashboard info\n    lines.push('section,dashboard');\n    lines.push(`id,${data.id}`);\n    lines.push(`name,${data.name}`);\n    lines.push(`created_at,${data.created_at}`);\n    lines.push(`updated_at,${data.updated_at}`);\n    lines.push('');\n    // Section 2: widgets\n    if (data.widgets.length > 0) {\n      lines.push('section,widgets');\n      lines.push('id,type,config,position_x,position_y,width,height');\n      for (const w of data.widgets) {\n        const configStr = JSON.stringify(w.config).replace(/\"/g, '\"\"');\n        lines.push([\n          w.id,\n          w.type,\n          `\"${configStr}\"`,\n          w.position_x,\n          w.position_y,\n          w.width,\n          w.height,\n        ].join(','));\n      }\n    }\n    res.set('Content-Type', 'text/csv');\n    res.set('Content-Disposition', 'attachment; filename=\"dashboard.csv\"');\n    res.send(lines.join('\\n'));\n  } else {\n    res.json(data);\n  }\n});\n\nexport default router;\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":129,"cache_creation_input_tokens":0,"cache_read_input_tokens":37504,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c3f5ec65-2dc7-451b-98c9-46382140dcc9","uuid":"f1dde205-b3ab-4a52-8c7d-f5c2b2f5beb4"}
