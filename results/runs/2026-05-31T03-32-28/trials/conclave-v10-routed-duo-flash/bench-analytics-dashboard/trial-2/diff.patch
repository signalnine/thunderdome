+import { Router, Request, Response } from 'express';
+import { getDb } from '../db.js';
+import { requireAuth } from '../middleware/auth.js';
+
+const router = Router();
+
+const VALID_INTERVALS = ['hour', 'day', 'week', 'month'] as const;
+type Interval = typeof VALID_INTERVALS[number];
+
+function getIntervalFormat(interval: Interval): string {
+  switch (interval) {
+    case 'hour': return '%Y-%m-%dT%H:00:00';
+    case 'day': return '%Y-%m-%d';
+    case 'week': return '%Y-%W';
+    case 'month': return '%Y-%m';
+  }
+}
+
+function getDateColumn(interval: Interval): string {
+  const fmt = getIntervalFormat(interval);
+  return `strftime('${fmt}', timestamp)`;
+}
+
+// GET /api/queries/count
+router.get('/count', requireAuth, (req: Request, res: Response) => {
+  const { name, from, to } = req.query;
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+
+  let sql = 'SELECT COUNT(*) as count FROM events WHERE tenant_id = ?';
+  const params: (string | number)[] = [tenantId];
+
+  if (name && typeof name === 'string') {
+    sql += ' AND name = ?';
+    params.push(name);
+  }
+  if (from && typeof from === 'string') {
+    sql += ' AND timestamp >= ?';
+    params.push(from);
+  }
+  if (to && typeof to === 'string') {
+    sql += ' AND timestamp <= ?';
+    params.push(to);
+  }
+
+  const row = db.prepare(sql).get(...params) as { count: number };
+  res.json({ count: row.count });
+});
+
+// GET /api/queries/timeseries
+router.get('/timeseries', requireAuth, (req: Request, res: Response) => {
+  const { name, from, to } = req.query;
+  let { interval } = req.query;
+
+  if (!interval || !VALID_INTERVALS.includes(interval as Interval)) {
+    interval = 'day';
+  }
+
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+  const dateCol = getDateColumn(interval as Interval);
+
+  let sql = `SELECT ${dateCol} as date, COUNT(*) as count FROM events WHERE tenant_id = ?`;
+  const params: (string | number)[] = [tenantId];
+
+  if (name && typeof name === 'string') {
+    sql += ' AND name = ?';
+    params.push(name);
+  }
+  if (from && typeof from === 'string') {
+    sql += ' AND timestamp >= ?';
+    params.push(from);
+  }
+  if (to && typeof to === 'string') {
+    sql += ' AND timestamp <= ?';
+    params.push(to);
+  }
+
+  sql += ' GROUP BY date ORDER BY date ASC';
+
+  const rows = db.prepare(sql).all(...params) as Array<{ date: string; count: number }>;
+  res.json(rows);
+});
+
+// GET /api/queries/breakdown
+router.get('/breakdown', requireAuth, (req: Request, res: Response) => {
+  const { name, from, to } = req.query;
+  let { property } = req.query;
+
+  property = Array.isArray(property) ? property[0] : property;
+
+  if (!property || typeof property !== 'string') {
+    res.status(400).json({ error: 'Property parameter is required', code: 400 });
+    return;
+  }
+
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+
+  let sql = `SELECT json_extract(properties, '$."${property}"') as value, COUNT(*) as count FROM events WHERE tenant_id = ? AND json_extract(properties, '$."${property}"') IS NOT NULL`;
+  const params: (string | number)[] = [tenantId];
+
+  if (name && typeof name === 'string') {
+    sql += ' AND name = ?';
+    params.push(name);
+  }
+  if (from && typeof from === 'string') {
+    sql += ' AND timestamp >= ?';
+    params.push(from);
+  }
+  if (to && typeof to === 'string') {
+    sql += ' AND timestamp <= ?';
+    params.push(to);
+  }
+
+  sql += ' GROUP BY value ORDER BY count DESC';
+
+  const rows = db.prepare(sql).all(...params) as Array<{ value: string | null; count: number }>;
+  res.json(rows);
+});
+
+export default router;
