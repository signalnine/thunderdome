+++ b/src/routes/export.ts
@@ -0,0 +1,142 @@
+import { Router, Request, Response } from 'express';
+import { getDb } from '../db.js';
+import { requireAuth } from '../middleware/auth.js';
+
+const router = Router();
+
+// GET /api/export/events - Export events as JSON or CSV
+router.get('/events', requireAuth, (req: Request, res: Response) => {
+  const { format, name, from, to } = req.query;
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+
+  let sql = 'SELECT id, name, properties, timestamp, user_id, session_id FROM events WHERE tenant_id = ?';
+  const params: (string | number)[] = [tenantId];
+
+  if (name && typeof name === 'string') {
+    sql += ' AND name = ?';
+    params.push(name);
+  }
+  if (from && typeof from === 'string') {
+    sql += ' AND timestamp >= ?';
+    params.push(from);
+  }
+  if (to && typeof to === 'string') {
+    sql += ' AND timestamp <= ?';
+    params.push(to);
+  }
+
+  sql += ' ORDER BY timestamp ASC';
+
+  const rows = db.prepare(sql).all(...params) as Array<Record<string, unknown>>;
+
+  const events = rows.map((r) => ({
+    id: r.id,
+    name: r.name,
+    properties: JSON.parse(r.properties as string),
+    timestamp: r.timestamp,
+    user_id: r.user_id,
+    session_id: r.session_id,
+  }));
+
+  const fmt = format === 'csv' ? 'csv' : 'json';
+
+  if (fmt === 'csv') {
+    const headers = ['id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'];
+    const csvRows = [headers.join(',')];
+    for (const event of events) {
+      const propsStr = JSON.stringify(event.properties).replace(/"/g, '""');
+      csvRows.push([
+        event.id,
+        `"${(event.name as string).replace(/"/g, '""')}"`,
+        `"${propsStr}"`,
+        event.timestamp,
+        event.user_id || '',
+        event.session_id || '',
+      ].join(','));
+    }
+    res.set('Content-Type', 'text/csv');
+    res.set('Content-Disposition', 'attachment; filename="events.csv"');
+    res.send(csvRows.join('\n'));
+  } else {
+    res.json(events);
+  }
+});
+
+// GET /api/export/dashboard/:id - Export a dashboard with its widgets
+router.get('/dashboard/:id', requireAuth, (req: Request, res: Response) => {
+  const { format } = req.query;
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+  const { id } = req.params;
+
+  const dashboard = db.prepare(
+    'SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(id, tenantId) as Record<string, unknown> | undefined;
+
+  if (!dashboard) {
+    res.status(404).json({ error: 'Dashboard not found', code: 404 });
+    return;
+  }
+
+  const widgets = db.prepare(
+    'SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y ASC, position_x ASC'
+  ).all(id) as Array<Record<string, unknown>>;
+
+  const data = {
+    id: dashboard.id,
+    tenant_id: dashboard.tenant_id,
+    name: dashboard.name,
+    owner_id: dashboard.owner_id,
+    config: JSON.parse(dashboard.config as string),
+    created_at: dashboard.created_at,
+    updated_at: dashboard.updated_at,
+    widgets: widgets.map((w) => ({
+      id: w.id,
+      type: w.type,
+      config: JSON.parse(w.config as string),
+      position_x: w.position_x,
+      position_y: w.position_y,
+      width: w.width,
+      height: w.height,
+    })),
+  };
+
+  const fmt = format === 'csv' ? 'csv' : 'json';
+
+  if (fmt === 'csv') {
+    // CSV export: flatten dashboard and widgets into separate sections
+    const lines: string[] = [];
+    // Section 1: dashboard info
+    lines.push('section,dashboard');
+    lines.push(`id,${data.id}`);
+    lines.push(`name,${data.name}`);
+    lines.push(`created_at,${data.created_at}`);
+    lines.push(`updated_at,${data.updated_at}`);
+    lines.push('');
+    // Section 2: widgets
+    if (data.widgets.length > 0) {
+      lines.push('section,widgets');
+      lines.push('id,type,config,position_x,position_y,width,height');
+      for (const w of data.widgets) {
+        const configStr = JSON.stringify(w.config).replace(/"/g, '""');
+        lines.push([
+          w.id,
+          w.type,
+          `"${configStr}"`,
+          w.position_x,
+          w.position_y,
+          w.width,
+          w.height,
+        ].join(','));
+      }
+    }
+    res.set('Content-Type', 'text/csv');
+    res.set('Content-Disposition', 'attachment; filename="dashboard.csv"');
+    res.send(lines.join('\n'));
+  } else {
+    res.json(data);
+  }
+});
+
+export default router;
