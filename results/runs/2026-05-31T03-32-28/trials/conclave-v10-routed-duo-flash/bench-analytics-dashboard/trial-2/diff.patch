+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db.js';
+import { requireAuth } from '../middleware/auth.js';
+
+const router = Router();
+
+// POST /api/dashboards - Create a dashboard
+router.post('/', requireAuth, (req: Request, res: Response) => {
+  const { name, config } = req.body;
+
+  if (!name || typeof name !== 'string') {
+    res.status(400).json({ error: 'Dashboard name is required and must be a string', code: 400 });
+    return;
+  }
+
+  if (config !== undefined && (typeof config !== 'object' || config === null || Array.isArray(config))) {
+    res.status(400).json({ error: 'Config must be a JSON object', code: 400 });
+    return;
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  const tenantId = req.user!.tenantId;
+  const ownerId = req.user!.id;
+  const configStr = config ? JSON.stringify(config) : '{}';
+
+  db.prepare(
+    'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'
+  ).run(id, tenantId, name, ownerId, configStr);
+
+  const dashboard = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as Record<string, unknown>;
+  res.status(201).json({
+    id: dashboard.id,
+    tenant_id: dashboard.tenant_id,
+    name: dashboard.name,
+    owner_id: dashboard.owner_id,
+    config: JSON.parse(dashboard.config as string),
+    created_at: dashboard.created_at,
+    updated_at: dashboard.updated_at,
+  });
+});
+
+// GET /api/dashboards - List dashboards for the tenant
+router.get('/', requireAuth, (req: Request, res: Response) => {
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+
+  const dashboards = db.prepare(
+    'SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC'
+  ).all(tenantId) as Array<Record<string, unknown>>;
+
+  res.json(dashboards.map((d) => ({
+    id: d.id,
+    tenant_id: d.tenant_id,
+    name: d.name,
+    owner_id: d.owner_id,
+    config: JSON.parse(d.config as string),
+    created_at: d.created_at,
+    updated_at: d.updated_at,
+  })));
+});
+
+// GET /api/dashboards/:id - Get a single dashboard with widgets
+router.get('/:id', requireAuth, (req: Request, res: Response) => {
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+  const { id } = req.params;
+
+  const dashboard = db.prepare(
+    'SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(id, tenantId) as Record<string, unknown> | undefined;
+
+  if (!dashboard) {
+    res.status(404).json({ error: 'Dashboard not found', code: 404 });
+    return;
+  }
+
+  const widgets = db.prepare(
+    'SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y ASC, position_x ASC'
+  ).all(id) as Array<Record<string, unknown>>;
+
+  res.json({
+    id: dashboard.id,
+    tenant_id: dashboard.tenant_id,
+    name: dashboard.name,
+    owner_id: dashboard.owner_id,
+    config: JSON.parse(dashboard.config as string),
+    created_at: dashboard.created_at,
+    updated_at: dashboard.updated_at,
+    widgets: widgets.map((w) => ({
+      id: w.id,
+      dashboard_id: w.dashboard_id,
+      type: w.type,
+      config: JSON.parse(w.config as string),
+      position_x: w.position_x,
+      position_y: w.position_y,
+      width: w.width,
+      height: w.height,
+    })),
+  });
+});
+
+// PUT /api/dashboards/:id - Update a dashboard
+router.put('/:id', requireAuth, (req: Request, res: Response) => {
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+  const { id } = req.params;
+  const { name, config } = req.body;
+
+  const existing = db.prepare(
+    'SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(id, tenantId) as Record<string, unknown> | undefined;
+
+  if (!existing) {
+    res.status(404).json({ error: 'Dashboard not found', code: 404 });
+    return;
+  }
+
+  if (name !== undefined && typeof name !== 'string') {
+    res.status(400).json({ error: 'Name must be a string', code: 400 });
+    return;
+  }
+
+  if (config !== undefined && (typeof config !== 'object' || config === null || Array.isArray(config))) {
+    res.status(400).json({ error: 'Config must be a JSON object', code: 400 });
+    return;
+  }
+
+  const updatedName = name ?? existing.name;
+  const updatedConfig = config ? JSON.stringify(config) : existing.config;
+  const now = new Date().toISOString();
+
+  db.prepare(
+    'UPDATE dashboards SET name = ?, config = ?, updated_at = ? WHERE id = ?'
+  ).run(updatedName, updatedConfig, now, id);
+
+  const updated = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as Record<string, unknown>;
+  res.json({
+    id: updated.id,
+    tenant_id: updated.tenant_id,
+    name: updated.name,
+    owner_id: updated.owner_id,
+    config: JSON.parse(updated.config as string),
+    created_at: updated.created_at,
+    updated_at: updated.updated_at,
+  });
+});
+
+// DELETE /api/dashboards/:id - Delete a dashboard
+router.delete('/:id', requireAuth, (req: Request, res: Response) => {
+  const db = getDb();
+  const tenantId = req.user!.tenantId;
+  const { id } = req.params;
+
+  const existing = db.prepare(
+    'SELECT id FROM dashboards WHERE id = ? AND tenant_id = ?'
+  ).get(id, tenantId);
+
+  if (!existing) {
+    res.status(404).json({ error: 'Dashboard not found', code: 404 });
+    return;
+  }
+
+  db.prepare('DELETE FROM dashboards WHERE id = ?').run(id);
+  res.status(204).send();
+});
+
+export default router;
