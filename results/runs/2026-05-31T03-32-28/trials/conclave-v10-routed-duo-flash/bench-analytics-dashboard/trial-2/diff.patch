nt_id: tenantId, role },\n  });\n});\n\n// POST /api/auth/login\nrouter.post('/login', (req: Request, res: Response) => {\n  const { email, password } = req.body;\n\n  if (!email || !password) {\n    res.status(400).json({ error: 'Email and password are required', code: 400 });\n    return;\n  }\n\n  if (typeof email !== 'string' || typeof password !== 'string') {\n    res.status(400).json({ error: 'Email and password must be strings', code: 400 });\n    return;\n  }\n\n  const db = getDb();\n  const user = db.prepare(\n    'SELECT id, email, password_hash, tenant_id, role FROM users WHERE email = ?'\n  ).get(email) as { id: string; email: string; password_hash: string; tenant_id: string; role: string } | undefined;\n\n  if (!user || !verifyPassword(password, user.password_hash)) {\n    res.status(401).json({ error: 'Invalid email or password', code: 401 });\n    return;\n  }\n\n  const token = generateToken(user.id, user.tenant_id, user.role);\n\n  res.json({\n    token,\n    user: { id: user.id, email: user.email, tenant_id: user.tenant_id, role: user.role },\n  });\n});\n\n// GET /api/auth/profile\nrouter.get('/profile', requireAuth, (req: Request, res: Response) => {\n  const db = getDb();\n  const user = db.prepare(\n    'SELECT id, email, tenant_id, role, created_at FROM users WHERE id = ?'\n  ).get(req.user!.id) as { id: string; email: string; tenant_id: string; role: string; created_at: string };\n\n  if (!user) {\n    res.status(404).json({ error: 'User not found', code: 404 });\n    return;\n  }\n\n  res.json({\n    user: {\n      id: user.id,\n      email: user.email,\n      tenant_id: user.tenant_id,\n      role: user.role,\n      created_at: user.created_at,\n    },\n  });\n});\n\nexport default router;\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":163,"cache_creation_input_tokens":0,"cache_read_input_tokens":32000,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c3f5