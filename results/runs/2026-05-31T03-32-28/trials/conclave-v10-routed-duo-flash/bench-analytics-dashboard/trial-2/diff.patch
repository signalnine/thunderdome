@@ -0,0 +1,106 @@
+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db.js';
+import { hashPassword, verifyPassword } from '../utils/hash.js';
+import { generateToken, requireAuth } from '../middleware/auth.js';
+
+const router = Router();
+
+// POST /api/auth/register
+router.post('/register', (req: Request, res: Response) => {
+  const { email, password, tenant_id: tenantId } = req.body;
+
+  if (!email || !password || !tenantId) {
+    res.status(400).json({ error: 'Email, password, and tenant_id are required', code: 400 });
+    return;
+  }
+
+  if (typeof email !== 'string' || typeof password !== 'string' || typeof tenantId !== 'string') {
+    res.status(400).json({ error: 'Email, password, and tenant_id must be strings', code: 400 });
+    return;
+  }
+
+  const db = getDb();
+
+  // Check for duplicate email
+  const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(email);
+  if (existing) {
+    res.status(409).json({ error: 'A user with this email already exists', code: 409 });
+    return;
+  }
+
+  // Determine role: first user in tenant becomes admin
+  const existingTenantUsers = db.prepare('SELECT COUNT(*) as count FROM users WHERE tenant_id = ?').get(tenantId) as { count: number };
+  const role = existingTenantUsers.count === 0 ? 'admin' : 'viewer';
+
+  const id = uuidv4();
+  const passwordHash = hashPassword(password);
+
+  db.prepare(
+    'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'
+  ).run(id, email, passwordHash, tenantId, role);
+
+  const token = generateToken(id, tenantId, role);
+
+  res.status(201).json({
+    token,
+    user: { id, email, tenant_id: tenantId, role },
+  });
+});
+
+// POST /api/auth/login
+router.post('/login', (req: Request, res: Response) => {
+  const { email, password } = req.body;
+
+  if (!email || !password) {
+    res.status(400).json({ error: 'Email and password are required', code: 400 });
+    return;
+  }
+
+  if (typeof email !== 'string' || typeof password !== 'string') {
+    res.status(400).json({ error: 'Email and password must be strings', code: 400 });
+    return;
+  }
+
+  const db = getDb();
+  const user = db.prepare(
+    'SELECT id, email, password_hash, tenant_id, role FROM users WHERE email = ?'
+  ).get(email) as { id: string; email: string; password_hash: string; tenant_id: string; role: string } | undefined;
+
+  if (!user || !verifyPassword(password, user.password_hash)) {
+    res.status(401).json({ error: 'Invalid email or password', code: 401 });
+    return;
+  }
+
+  const token = generateToken(user.id, user.tenant_id, user.role);
+
+  res.json({
+    token,
+    user: { id: user.id, email: user.email, tenant_id: user.tenant_id, role: user.role },
+  });
+});
+
+// GET /api/auth/profile
+router.get('/profile', requireAuth, (req: Request, res: Response) => {
+  const db = getDb();
+  const user = db.prepare(
+    'SELECT id, email, tenant_id, role, created_at FROM users WHERE id = ?'
+  ).get(req.user!.id) as { id: string; email: string; tenant_id: string; role: string; created_at: string };
+
+  if (!user) {
+    res.status(404).json({ error: 'User not found', code: 404 });
+    return;
+  }
+
+  res.json({
+    user: {
+      id: user.id,
+      email: user.email,
+      tenant_id: user.tenant_id,
+      role: user.role,
+      created_at: user.created_at,
+    },
+  });
+});
+
+export default router;
