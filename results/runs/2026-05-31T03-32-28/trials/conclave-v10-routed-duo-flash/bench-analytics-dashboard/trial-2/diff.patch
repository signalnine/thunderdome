n        });\n\n      expect(res.status).toBe(201);\n      expect(res.body.properties).toEqual({ url: '/home', browser: 'Chrome' });\n      expect(res.body.timestamp).toBe('2024-01-15T10:00:00Z');\n    });\n\n    it('returns 401 without auth', async () => {\n      const res = await request(app)\n        .post('/api/events')\n        .send({ name: 'page_view' });\n\n      expect(res.status).toBe(401);\n    });\n\n    it('returns 400 without name', async () => {\n      const token = await setupTenant('event3@test.com', 't-events3');\n\n      const res = await request(app)\n        .post('/api/events')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ properties: { a: 1 } });\n\n      expect(res.status).toBe(400);\n      expect(res.body).toMatchObject({ error: expect.any(String), code: 400 });\n    });\n\n    it('returns 400 for non-object properties', async () => {\n      const token = await setupTenant('event4@test.com', 't-events4');\n\n      const res = await request(app)\n        .post('/api/events')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ name: 'test', properties: 'not-an-object' });\n\n      expect(res.status).toBe(400);\n    });\n\n    it('automatically associates events with the user tenant', async () => {\n      const token = await setupTenant('event-tenant@test.com', 't-specific');\n\n      const evt = await request(app)\n        .post('/api/events')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ name: 'test_event' });\n\n      expect(evt.body.tenant_id).toBe('t-specific');\n    });\n  });\n\n  describe('POST /api/events/batch', () => {\n    async function setupTenant(email: string, tenant: string) {\n      const reg = await request(app)\n        .post('/api/auth/register')\n        .send({ email, password: 'password123', tenant_id: tenant });\n      return reg.body.token;\n    }\n\n    it('ingests a batch of events', async () => {\n      const token = await setupTenant('batch@test.com', 't-batch');\n\n      const res = await request(app)\n        .post('/api/events/batch')\n        .set('Authorization', `Bearer ${token}`)\n        .send({\n          events: [\n            { name: 'page_view', properties: { url: '/a' } },\n            { name: 'page_view', properties: { url: '/b' } },\n            { name: 'click', properties: { button: 'submit' } },\n          ],\n        });\n\n      expect(res.status).toBe(201);\n      expect(res.body).toEqual({ count: 3 });\n    });\n\n    it('returns 400 for empty array', async () => {\n      const token = await setupTenant('batch2@test.com', 't-batch2');\n\n      const res = await request(app)\n        .post('/api/events/batch')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ events: [] });\n\n      expect(res.status).toBe(400);\n    });\n\n    it('returns 400 for invalid event in batch', async () => {\n      const token = await setupTenant('batch3@test.com', 't-batch3');\n\n      const res = await request(app)\n        .post('/api/events/batch')\n        .set('Authorization', `Bearer ${token}`)\n        .send({\n          events: [\n            { name: 'valid' },\n            { properties: { no: 'name' } },\n          ],\n        });\n\n      expect(res.status).toBe(400);\n    });\n  });\n\n  // ─── Query Engine ─────────────────────────────────────────────────────\n\n  describe('Query Engine', () => {\n    async function setupTenant(email: string, tenant: string) {\n      const reg = await request(app)\n        .post('/api/auth/register')\n        .send({ email, password: 'password123', tenant_id: tenant });\n      return reg.body.token;\n    }\n\n    async function ingestEvents(token: string, events: Array<Record<string, unknown>>) {\n      await request(app)\n        .post('/api/events/batch')\n        .set('Authorization', `Bearer ${token}`)\n        .send({ events });\n    }\n\n    describe('GET /api/queries/count', () => {\n      it('counts all events matching a name', async () => {\n        const token = await setupTenant('qcount@test.com', 't-qcount');\n        await ingestEvents(token, [\n          { name: 'page_view' },\n          { name: 'page_view' },\n          { name: 'page_view' },\n          { name: 'click' },\n          { name: 'click' },\n        ]);\n\n        const res = await request(app)\n          .get('/api/queries/count?name=page_view')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(200);\n        expect(res.body).toEqual({ count: 3 });\n      });\n\n      it('returns 0 when no events match', async () => {\n        const token = await setupTenant('qcount2@test.com', 't-qcount2');\n\n        const res = await request(app)\n          .get('/api/queries/count?name=nonexistent')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(200);\n        expect(res.body).toEqual({ count: 0 });\n      });\n\n      it('respects tenant isolation', async () => {\n        const token1 = await setupTenant('qiso1@test.com', 't-qiso1');\n        const token2 = await setupTenant('qiso2@test.com', 't-qiso2');\n\n        await ingestEvents(token1, [\n          { name: 'page_view' },\n          { name: 'page_view' },\n        ]);\n        await ingestEvents(token2, [\n          { name: 'page_view' },\n        ]);\n\n        const res1 = await request(app)\n          .get('/api/queries/count?name=page_view')\n          .set('Authorization', `Bearer ${token1}`);\n        expect(res1.body.count).toBe(2);\n\n        const res2 = await request(app)\n          .get('/api/queries/count?name=page_view')\n          .set('Authorization', `Bearer ${token2}`);\n        expect(res2.body.count).toBe(1);\n      });\n\n      it('accepts from/to date filters', async () => {\n        const token = await setupTenant('qcount3@test.com', 't-qcount3');\n        await ingestEvents(token, [\n          { name: 'page_view', timestamp: '2024-01-01T00:00:00Z' },\n          { name: 'page_view', timestamp: '2024-01-15T00:00:00Z' },\n          { name: 'page_view', timestamp: '2024-02-01T00:00:00Z' },\n        ]);\n\n        const res = await request(app)\n          .get('/api/queries/count?name=page_view&from=2024-01-01&to=2024-01-31')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.body.count).toBe(2);\n      });\n    });\n\n    describe('GET /api/queries/timeseries', () => {\n      it('buckets events by day', async () => {\n        const token = await setupTenant('qts1@test.com', 't-qts1');\n        await ingestEvents(token, [\n          { name: 'page_view', timestamp: '2024-01-01T10:00:00Z' },\n          { name: 'page_view', timestamp: '2024-01-01T15:00:00Z' },\n          { name: 'page_view', timestamp: '2024-01-02T10:00:00Z' },\n        ]);\n\n        const res = await request(app)\n          .get('/api/queries/timeseries?name=page_view&interval=day')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(200);\n        expect(res.body).toEqual([\n          { date: '2024-01-01', count: 2 },\n          { date: '2024-01-02', count: 1 },\n        ]);\n      });\n\n      it('buckets events by hour', async () => {\n        const token = await setupTenant('qts2@test.com', 't-qts2');\n        await ingestEvents(token, [\n          { name: 'page_view', timestamp: '2024-01-01T09:00:00Z' },\n          { name: 'page_view', timestamp: '2024-01-01T09:30:00Z' },\n          { name: 'page_view', timestamp: '2024-01-01T10:00:00Z' },\n        ]);\n\n        const res = await request(app)\n          .get('/api/queries/timeseries?name=page_view&interval=hour')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(200);\n        expect(res.body).toEqual([\n          { date: '2024-01-01T09:00:00', count: 2 },\n          { date: '2024-01-01T10:00:00', count: 1 },\n        ]);\n      });\n\n      it('buckets events by month', async () => {\n        const token = await setupTenant('qts3@test.com', 't-qts3');\n        await ingestEvents(token, [\n          { name: 'page_view', timestamp: '2024-01-01T00:00:00Z' },\n          { name: 'page_view', timestamp: '2024-02-01T00:00:00Z' },\n          { name: 'page_view', timestamp: '2024-02-15T00:00:00Z' },\n        ]);\n\n        const res = await request(app)\n          .get('/api/queries/timeseries?name=page_view&interval=month')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(200);\n        expect(res.body).toEqual([\n          { date: '2024-01', count: 1 },\n          { date: '2024-02', count: 2 },\n        ]);\n      });\n\n      it('respects from/to filters', async () => {\n        const token = await setupTenant('qts4@test.com', 't-qts4');\n        await ingestEvents(token, [\n          { name: 'page_view', timestamp: '2024-01-01T00:00:00Z' },\n          { name: 'page_view', timestamp: '2024-01-15T00:00:00Z' },\n          { name: 'page_view', timestamp: '2024-02-01T00:00:00Z' },\n        ]);\n\n        const res = await request(app)\n          .get('/api/queries/timeseries?name=page_view&interval=day&from=2024-01-10&to=2024-01-20')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.body).toEqual([\n          { date: '2024-01-15', count: 1 },\n        ]);\n      });\n    });\n\n    describe('GET /api/queries/breakdown', () => {\n      it('groups events by a property value', async () => {\n        const token = await setupTenant('qbd1@test.com', 't-qbd1');\n        await ingestEvents(token, [\n          { name: 'page_view', properties: { url: '/home' } },\n          { name: 'page_view', properties: { url: '/home' } },\n          { name: 'page_view', properties: { url: '/about' } },\n          { name: 'page_view', properties: { url: '/contact' } },\n        ]);\n\n        const res = await request(app)\n          .get('/api/queries/breakdown?name=page_view&property=url')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(200);\n        // Ordered by count descending\n        expect(res.body[0]).toMatchObject({ value: '/home', count: 2 });\n        expect(res.body[1]).toMatchObject({ value: '/about', count: 1 });\n        expect(res.body[2]).toMatchObject({ value: '/contact', count: 1 });\n      });\n\n      it('returns 400 when property parameter is missing', async () => {\n        const token = await setupTenant('qbd2@test.com', 't-qbd2');\n\n        const res = await request(app)\n          .get('/api/queries/breakdown?name=page_view')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(400);\n      });\n    });\n  });\n\n  // ─── Dashboard Configuration ──────────────────────────────────────────\n\n  describe('Dashboard CRUD', () => {\n    async function setupTenant(email: string, tenant: string) {\n      const reg = await request(app)\n        .post('/api/auth/register')\n        .send({ email, password: 'password123', tenant_id: tenant });\n      return reg.body.token;\n    }\n\n    describe('POST /api/dashboards', () => {\n      it('creates a dashboard', async () => {\n        const token = await setupTenant('dash@test.com', 't-dash');\n\n        const res = await request(app)\n          .post('/api/dashboards')\n          .set('Authorization', `Bearer ${token}`)\n          .send({ name: 'My Dashboard', config: { theme: 'dark' } });\n\n        expect(res.status).toBe(201);\n        expect(res.body).toMatchObject({\n          name: 'My Dashboard',\n          tenant_id: 't-dash',\n          config: { theme: 'dark' },\n        });\n        expect(res.body).toHaveProperty('id');\n        expect(res.body).toHaveProperty('created_at');\n        expect(res.body).toHaveProperty('updated_at');\n      });\n\n      it('returns 400 without name', async () => {\n        const token = await setupTenant('dash2@test.com', 't-dash2');\n\n        const res = await request(app)\n          .post('/api/dashboards')\n          .set('Authorization', `Bearer ${token}`)\n          .send({});\n\n        expect(res.status).toBe(400);\n      });\n    });\n\n    describe('GET /api/dashboards', () => {\n      it('lists dashboards for tenant', async () => {\n        const token = await setupTenant('dash3@test.com', 't-dash3');\n\n        await request(app)\n          .post('/api/dashboards')\n          .set('Authorization', `Bearer ${token}`)\n          .send({ name: 'Dash 1' });\n        await request(app)\n          .post('/api/dashboards')\n          .set('Authorization', `Bearer ${token}`)\n          .send({ name: 'Dash 2' });\n\n        const res = await request(app)\n          .get('/api/dashboards')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(200);\n        expect(res.body).toHaveLength(2);\n        expect(res.body.map((d: Record<string, unknown>) => d.name)).toContain('Dash 1');\n        expect(res.body.map((d: Record<string, unknown>) => d.name)).toContain('Dash 2');\n      });\n\n      it('enforces tenant isolation', async () => {\n        const token1 = await setupTenant('dash4@test.com', 't-dash4a');\n        const token2 = await setupTenant('dash5@test.com', 't-dash4b');\n\n        await request(app)\n          .post('/api/dashboards')\n          .set('Authorization', `Bearer ${token1}`)\n          .send({ name: 'Tenant A Dash' });\n\n        const res = await request(app)\n          .get('/api/dashboards')\n          .set('Authorization', `Bearer ${token2}`);\n\n        expect(res.status).toBe(200);\n        expect(res.body).toHaveLength(0);\n      });\n    });\n\n    describe('GET /api/dashboards/:id', () => {\n      it('returns a dashboard with widgets', async () => {\n        const token = await setupTenant('dash6@test.com', 't-dash6');\n\n        const create = await request(app)\n          .post('/api/dashboards')\n          .set('Authorization', `Bearer ${token}`)\n          .send({ name: 'Single Dash' });\n\n        const res = await request(app)\n          .get(`/api/