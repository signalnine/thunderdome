st create = await request(app)\n          .post('/api/dashboards')\n          .set('Authorization', `Bearer ${token}`)\n          .send({ name: 'Single Dash' });\n\n        const res = await request(app)\n          .get(`/api/dashboards/${create.body.id}`)\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(200);\n        expect(res.body.name).toBe('Single Dash');\n        expect(res.body).toHaveProperty('widgets');\n        expect(Array.isArray(res.body.widgets)).toBe(true);\n      });\n\n      it('returns 404 for unknown dashboard', async () => {\n        const token = await setupTenant('dash7@test.com', 't-dash7');\n\n        const res = await request(app)\n          .get('/api/dashboards/nonexistent-id')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(404);\n      });\n\n      it('returns 404 for dashboard from another tenant', async () => {\n        const token1 = await setupTenant('dash8@test.com', 't-dash8a');\n        const token2 = await setupTenant('dash9@test.com', 't-dash8b');\n\n        const create = await request(app)\n          .post('/api/dashboards')\n          .set('Authorization', `Bearer ${token1}`)\n          .send({ name: 'Secret Dash' });\n\n        const res = await request(app)\n          .get(`/api/dashboards/${create.body.id}`)\n          .set('Authorization', `Bearer ${token2}`);\n\n        expect(res.status).toBe(404);\n      });\n    });\n\n    describe('PUT /api/dashboards/:id', () => {\n      it('updates a dashboard name', async () => {\n        const token = await setupTenant('dash10@test.com', 't-dash10');\n\n        const create = await request(app)\n          .post('/api/dashboards')\n          .set('Authorization', `Bearer ${token}`)\n          .send({ name: 'Original' });\n\n        const res = await request(app)\n          .put(`/api/dashboards/${create.body.id}`)\n          .set('Authorization', `Bearer ${token}`)\n          .send({ name: 'Updated', config: { layout: 'grid' } });\n\n        expect(res.status).toBe(200);\n        expect(res.body.name).toBe('Updated');\n        expect(res.body.config).toEqual({ layout: 'grid' });\n      });\n\n      it('returns 404 for dashboard from another tenant', async () => {\n        const token1 = await setupTenant('dash11@test.com', 't-dash11a');\n        const token2 = await setupTenant('dash12@test.com', 't-dash11b');\n\n        const create = await request(app)\n          .post('/api/dashboards')\n          .set('Authorization', `Bearer ${token1}`)\n          .send({ name: 'Secret' });\n\n        const res = await request(app)\n          .put(`/api/dashboards/${create.body.id}`)\n          .set('Authorization', `Bearer ${token2}`)\n          .send({ name: 'Hacked' });\n\n        expect(res.status).toBe(404);\n      });\n    });\n\n    describe('DELETE /api/dashboards/:id', () => {\n      it('deletes a dashboard', async () => {\n        const token = await setupTenant('dash13@test.com', 't-dash13');\n\n        const create = await request(app)\n          .post('/api/dashboards')\n          .set('Authorization', `Bearer ${token}`)\n          .send({ name: 'To Delete' });\n\n        const res = await request(app)\n          .delete(`/api/dashboards/${create.body.id}`)\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(204);\n      });\n\n      it('returns 404 for unknown dashboard', async () => {\n        const token = await setupTenant('dash14@test.com', 't-dash14');\n\n        const res = await request(app)\n          .delete('/api/dashboards/nonexistent-id')\n          .set('Authorization', `Bearer ${token}`);\n\n        expect(res.status).toBe(404);\n      });\n\n      it('returns 404 for dashboard from another tenant', async () => {\n        const token1 = await setupTenant('dash15@test.com', 't-dash15a');\n        const token2 = await setupTenant('dash16@test.com', 't-dash15b');\n\n        const create = await request(app)\n      