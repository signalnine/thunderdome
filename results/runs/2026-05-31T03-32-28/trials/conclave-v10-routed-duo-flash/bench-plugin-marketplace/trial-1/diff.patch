t(obj: unknown): obj is PluginManifest {\n  if (typeof obj !== 'object' || obj === null) return false;\n  const m = obj as Record<string, unknown>;\n  return (\n    typeof m.name === 'string' &&\n    typeof m.version === 'string' &&\n    typeof m.description === 'string' &&\n    typeof m.author === 'string' &&\n    typeof m.entryPoint === 'string' &&\n    typeof m.dependencies === 'object' &&\n    m.dependencies !== null &&\n    !Array.isArray(m.dependencies) &&\n    Array.isArray(m.permissions) &&\n    m.permissions.every((p: unknown) => typeof p === 'string')\n  );\n}\n\nexport const createRegistry = (): RegistryService => {\n  const db = getDb();\n\n  const insertStmt = db.prepare(`\n    INSERT OR REPLACE INTO plugins (name, version, description, author, entryPoint, dependencies, permissions)\n    VALUES (@name, @version, @description, @author, @entryPoint, @dependencies, @permissions)\n  `);\n\n  const getStmt = db.prepare(`\n    SELECT * FROM plugins WHERE name = ? ORDER BY version DESC LIMIT 1\n  `);\n\n  const getVersionStmt = db.prepare(`\n    SELECT * FROM plugins WHERE name = ? AND version = ?\n  `);\n\n  const listStmt = db.prepare(`SELECT * FROM plugins ORDER BY name, version`);\n\n  const searchStmt = db.prepare(`\n    SELECT * FROM plugins WHERE name LIKE ? OR description LIKE ? ORDER BY name, version\n  `);\n\n  const removeStmt = db.prepare(`DELETE FROM plugins WHERE name = ? AND version = ?`);\n\n  const listVersionsStmt = db.prepare(`\n    SELECT version FROM plugins WHERE name = ? ORDER BY version DESC\n  `);\n\n  const updateStmt = db.prepare(`\n    UPDATE plugins SET\n      description = @description,\n      author = @author,\n      entryPoint = @entryPoint,\n      dependencies = @dependencies,\n      permissions = @permissions\n    WHERE name = @name AND version = @version\n  `);\n\n  const register = (manifest: PluginManifest): void => {\n    insertStmt.run({\n      name: manifest.name,\n      version: manifest.version,\n      description: manifest.description,\n      author: manifest.author,\n      entryPoint: manifest.entryPoint,\n      dependencies: JSON.stringify(manifest.dependencies),\n      permissions: JSON.stringify(manifest.permissions),\n    });\n  };\n\n  const get = (name: string): PluginManifest | null => {\n    const row = getStmt.get(name) as Record<string, unknown> | undefined;\n    if (!row) return null;\n    return parseManifest(row as Parameters<typeof parseManifest>[0]);\n  };\n\n  const getVersion = (name: string, version: string): PluginManifest | null => {\n    const row = getVersionStmt.get(name, version) as Record<string, unknown> | undefined;\n    if (!row) return null;\n    return parseManifest(row as Parameters<typeof parseManifest>[0]);\n  };\n\n  const list = (): PluginManifest[] => {\n    const rows = listStmt.all() as Record<string, unknown>[];\n    return rows.map(r => parseManifest(r as Parameters<typeof parseManifest>[0]));\n  };\n\n  const search = (query: string): PluginManifest[] => {\n    const pattern = `%${query}%`;\n    const rows = searchStmt.all(pattern, pattern) as Record<string, unknown>[];\n    return rows.map(r => parseManifest(r as Parameters<typeof parseManifest>[0]));\n  };\n\n  const remove = (name: string, version: string): boolean => {\n    const result = removeStmt.run(name, version);\n    return result.changes > 0;\n  };\n\n  const listVersions = (name: string): string[] => {\n    const rows = listVersionsStmt.all(name) as { version: string }[];\n    return rows.map(r => r.version);\n  };\n\n  const update = (name: string, version: string, updates: Partial<PluginManifest>): void => {\n    const existing = getVersion(name, version);\n    if (!existing) return;\n    const merged = { ...existing, ...updates };\n    updateStmt.run({\n      name: merged.name,\n      version: merged.version,\n      description: merged.description,\n      author: merged.author,\n      entryPoint: merged.entryPoint,\n      dependencies: JSON.stringify(merged.dependencies),