Manifest = (overrides: Partial<PluginManifest> = {}): PluginManifest => ({\n  name: 'test-plugin',\n  version: '1.0.0',\n  description: 'A test plugin',\n  author: 'test-author',\n  entryPoint: 'console.log(\"hello\")',\n  dependencies: {},\n  permissions: [],\n  ...overrides,\n});\n\ndescribe('Plugin Registry', () => {\n  it('should register and retrieve a plugin', () => {\n    const registry = createRegistry();\n    const manifest = createTestManifest();\n    registry.register(manifest);\n    const result = registry.get('test-plugin');\n    expect(result).not.toBeNull();\n    expect(result!.name).toBe('test-plugin');\n    expect(result!.version).toBe('1.0.0');\n    expect(result!.description).toBe('A test plugin');\n    expect(result!.author).toBe('test-author');\n  });\n\n  it('should return null for non-existent plugin', () => {\n    const registry = createRegistry();\n    expect(registry.get('nonexistent')).toBeNull();\n  });\n\n  it('should get a specific version of a plugin', () => {\n    const registry = createRegistry();\n    registry.register(createTestManifest({ name: 'pkg', version: '1.0.0' }));\n    registry.register(createTestManifest({ name: 'pkg', version: '2.0.0' }));\n    const v1 = registry.getVersion('pkg', '1.0.0');\n    expect(v1).not.toBeNull();\n    expect(v1!.version).toBe('1.0.0');\n    const v2 = registry.getVersion('pkg', '2.0.0');\n    expect(v2!.version).toBe('2.0.0');\n  });\n\n  it('should return null for non-existent version', () => {\n    const registry = createRegistry();\n    expect(registry.getVersion('nonexistent', '1.0.0')).toBeNull();\n  });\n\n  it('get() returns the latest version', () => {\n    const registry = createRegistry();\n    registry.register(createTestManifest({ name: 'pkg', version: '1.0.0' }));\n    registry.register(createTestManifest({ name: 'pkg', version: '2.0.0' }));\n    const result = registry.get('pkg');\n    expect(result!.version).toBe('2.0.0');\n  });\n\n  it('list() returns all registered entries', () => {\n    const registry = createRegistry();\n    registry.register(createTestManifest({ name: 'a', version: '1.0.0' }));\n    registry.register(createTestManifest({ name: 'a', version: '2.0.0' }));\n    registry.register(createTestManifest({ name: 'b', version: '1.0.0' }));\n    const all = registry.list();\n    expect(all.length).toBe(3);\n  });\n\n  it('search() matches name case-insensitively', () => {\n    const registry = createRegistry();\n    registry.register(createTestManifest({ name: 'HelloWorld', description: 'Does stuff' }));\n    const results = registry.search('hello');\n    expect(results.length).toBe(1);\n    expect(results[0].name).toBe('HelloWorld');\n  });\n\n  it('search() matches description case-insensitively', () => {\n    const registry = createRegistry();\n    registry.register(createTestManifest({ name: 'my-plugin', description: 'Awesome Plugin for X' }));\n    const results = registry.search('awesome');\n    expect(results.length).toBe(1);\n  });\n\n  it('search() returns empty array for no matches', () => {\n    const registry = createRegistry();\n    registry.register(createTestManifest({ name: 'pkg', description: 'stuff' }));\n    expect(registry.search('xyz')).toEqual([]);\n  });\n\n  it('remove() removes a specific version and returns true', () => {\n    const registry = createRegistry();\n    registry.register(createTestManifest({ name: 'pkg', version: '1.0.0' }));\n    expect(registry.remove('pkg', '1.0.0')).toBe(true);\n    expect(registry.getVersion('pkg', '1.0.0')).toBeNull();\n  });\n\n  it('remove() returns false for non-existent plugin', () => {\n    const registry = createRegistry();\n    expect(registry.remove('nonexistent', '1.0.0')).toBe(false);\n  });\n\n  it('remove() only removes the specified version', () => {\n    const registry = createRegistry();\n    registry.register(createTestManifest({ name: 'pkg', version: '1.0.0' }));\n    registry.register(createTestManifest({ name: 'pkg', version: '2.0.0' }));\n    registry.remove('pkg', '1.0.0');\n    expect(registry.getVersion('pkg', '2.0.0')).not.toBeNull();\n    expect(registry.getVersion('pkg', '1.0.0')).toBeNull();\n  });\n\n  it('listVersions() returns versions sorted descending', () => {\n    const registry = createRegistry();\n    registry.register(createTestManifest({ name: 'pkg', version: '1.0.0' }));\n    registry.register(createTestManifest({ name: 'pkg', version: '2.0.0' }));\n    registry.register(createTestManifest({ name: 'pkg', version: '1.5.0' }));\n    const versions = registry.listVersions('pkg');\n    expect(versions).toEqual(['2.0.0', '1.5.0', '1.0.0']);\n  });\n\n  it('listVersions() returns empty array for non-existent plugin', () => {\n    const registry = createRegistry();\n    expect(registry.listVersions('nonexistent')).toEqual([]);\n  });\n\n  it('update() merges partial updates', () => {\n    const registry = createRegistry();\n    registry.register(createTestManifest({ name: 'pkg', version: '1.0.0', description: 'original' }));\n    registry.update('pkg', '1.0.0', { description: 'updated' });\n    const result = registry.getVersion('pkg', '1.0.0');\n    expect(result!.description).toBe('updated');\n    // Other fields preserved\n    expect(result!.author).toBe('test-author');\n  });\n\n  it('update() does nothing for non-existent plugin', () => {\n    const registry = createRegistry();\n    // Should not throw\n    registry.update('nonexistent', '1.0.0', { description: 'new' });\n  });\n\n  it('supports multiple versions of same plugin', () => {\n    const registry = createRegistry();\n    registry.register(createTestManifest({ name: 'multi', version: '1.0.0' }));\n    registry.register(createTestManifest({ name: 'multi', version: '2.0.0' }));\n    const versions = registry.listVersions('multi');\n    expect(versions.length).toBe(2);\n    expect(versions).toContain('1.0.0');\n    expect(versions).toContain('2.0.0');\n  });\n\n  it('handles register with all fields populated', () => {\n    const registry = createRegistry();\n    registry.register({\n      name: 'full',\n      version: '1.0.0',\n      description: 'full plugin',\n      author: 'author1',\n      entryPoint: 'index.js',\n      dependencies: { depA: '^1.0.0', depB: '~2.0.0' },\n      permissions: ['read', 'write'],\n    });\n    const result = registry.get('full');\n    expect(result!.dependencies).toEqual({ depA: '^1.0.0', depB: '~2.0.0' });\n    expect(result!.permissions).toEqual(['read', 'write']);\n  });\n});\n","userModified":false}}
