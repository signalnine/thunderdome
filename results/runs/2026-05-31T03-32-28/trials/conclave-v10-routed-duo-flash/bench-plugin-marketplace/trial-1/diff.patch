+import semver from 'semver';
+import type { ResolverService, VersionConstraint, ResolvedVersion } from './types.js';
+
+export const createResolver = (): ResolverService => {
+  const resolve = (
+    constraints: VersionConstraint[],
+    available: Record<string, string[]>,
+  ): ResolvedVersion[] => {
+    const results: ResolvedVersion[] = [];
+
+    for (const constraint of constraints) {
+      const versions = available[constraint.name];
+      if (!versions || versions.length === 0) continue;
+
+      const matched = maxSatisfying(versions, constraint.range);
+      if (matched !== null) {
+        results.push({
+          name: constraint.name,
+          version: matched,
+          satisfies: constraint.range,
+        });
+      }
+    }
+
+    return results;
+  };
+
+  const satisfies = (version: string, range: string): boolean => {
+    return semver.satisfies(version, range);
+  };
+
+  const maxSatisfying = (versions: string[], range: string): string | null => {
+    return semver.maxSatisfying(versions, range);
+  };
+
+  const validRange = (range: string): boolean => {
+    return semver.validRange(range) !== null;
+  };
+
+  return { resolve, satisfies, maxSatisfying, validRange };
+};
