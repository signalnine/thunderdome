@@ -0,0 +1,144 @@
+import type { DependencyNode, DepsService, RegistryService } from './types.js';
+
+export const createDeps = (): DepsService => {
+  const buildTree = (name: string, registry: RegistryService): DependencyNode => {
+    const manifest = registry.get(name);
+    if (!manifest) {
+      return { name, version: 'unknown', dependencies: [] };
+    }
+
+    const deps: DependencyNode[] = [];
+    for (const [depName] of Object.entries(manifest.dependencies)) {
+      const depManifest = registry.get(depName);
+      if (depManifest) {
+        deps.push(buildTree(depName, registry));
+      } else {
+        deps.push({ name: depName, version: 'unknown', dependencies: [] });
+      }
+    }
+
+    return {
+      name: manifest.name,
+      version: manifest.version,
+      dependencies: deps,
+    };
+  };
+
+  /**
+   * Detect cycles in the dependency graph.
+   * Returns array of cycles (each cycle is a path from node back to itself),
+   * or null if no cycles found.
+   */
+  const detectCycles = (name: string, registry: RegistryService): string[][] | null => {
+    const visited = new Set<string>();
+    const recursionStack = new Set<string>();
+    const cycles: string[][] = [];
+    const path: string[] = [];
+
+    const dfs = (currentName: string): void => {
+      if (recursionStack.has(currentName)) {
+        // Found a cycle — extract the cycle path
+        const cycleStart = path.indexOf(currentName);
+        const cycle = [...path.slice(cycleStart), currentName];
+        cycles.push(cycle);
+        return;
+      }
+
+      if (visited.has(currentName)) return;
+
+      visited.add(currentName);
+      recursionStack.add(currentName);
+      path.push(currentName);
+
+      const manifest = registry.get(currentName);
+      if (manifest) {
+        for (const depName of Object.keys(manifest.dependencies)) {
+          dfs(depName);
+        }
+      }
+
+      path.pop();
+      recursionStack.delete(currentName);
+    };
+
+    dfs(name);
+
+    return cycles.length > 0 ? cycles : null;
+  };
+
+  const hasCircularDependency = (name: string, registry: RegistryService): boolean => {
+    return detectCycles(name, registry) !== null;
+  };
+
+  /**
+   * Produce a topological ordering (dependencies first).
+   * Throws if a cycle is detected.
+   */
+  const topologicalSort = (name: string, registry: RegistryService): string[] => {
+    const cycles = detectCycles(name, registry);
+    if (cycles) {
+      throw new Error(
+        `Circular dependency detected: ${cycles[0].join(' -> ')}`,
+      );
+    }
+
+    const visited = new Set<string>();
+    const result: string[] = [];
+
+    const dfs = (currentName: string): void => {
+      if (visited.has(currentName)) return;
+      visited.add(currentName);
+
+      const manifest = registry.get(currentName);
+      if (manifest) {
+        for (const depName of Object.keys(manifest.dependencies)) {
+          dfs(depName);
+        }
+      }
+
+      result.push(currentName);
+    };
+
+    dfs(name);
+
+    return result;
+  };
+
+  /**
+   * Flatten all transitive dependencies into a unique list.
+   */
+  const flattenDependencies = (name: string, registry: RegistryService): string[] => {
+    const visited = new Set<string>();
+    const result: string[] = [];
+    const manifest = registry.get(name);
+    if (!manifest) return [];
+
+    const dfs = (currentName: string): void => {
+      if (visited.has(currentName)) return;
+      visited.add(currentName);
+
+      // Only add if it's not the root
+      if (currentName !== name) {
+        result.push(currentName);
+      }
+
+      const currentManifest = registry.get(currentName);
+      if (currentManifest) {
+        for (const depName of Object.keys(currentManifest.dependencies)) {
+          dfs(depName);
+        }
+      }
+    };
+
+    dfs(name);
+    return result;
+  };
+
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency,
+  };
+};
