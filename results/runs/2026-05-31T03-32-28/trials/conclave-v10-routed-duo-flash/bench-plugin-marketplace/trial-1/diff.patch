+import vm from 'vm';
+import type { RunnerService, SandboxResult } from './types.js';
+
+export const createRunner = (): RunnerService => {
+  const execute = async (
+    code: string,
+    context?: Record<string, unknown>,
+  ): Promise<SandboxResult> => {
+    return executeWithTimeout(code, 0, context);
+  };
+
+  const executeWithTimeout = async (
+    code: string,
+    timeoutMs: number,
+    context?: Record<string, unknown>,
+  ): Promise<SandboxResult> => {
+    const startTime = performance.now();
+    const startMemory = process.memoryUsage().heapUsed;
+
+    try {
+      const sandbox: Record<string, unknown> = {};
+
+      // Copy context variables into the sandbox
+      if (context) {
+        for (const [key, value] of Object.entries(context)) {
+          sandbox[key] = value;
+        }
+      }
+
+      vm.createContext(sandbox);
+
+      const script = new vm.Script(code);
+
+      const options: vm.RunningScriptOptions = {};
+      if (timeoutMs > 0) {
+        options.timeout = timeoutMs;
+      }
+
+      const output = script.runInContext(sandbox, options);
+
+      const duration = performance.now() - startTime;
+      const memoryUsed = process.memoryUsage().heapUsed - startMemory;
+
+      return {
+        success: true,
+        output,
+        duration,
+        memoryUsed: Math.max(0, memoryUsed),
+      };
+    } catch (err) {
+      const duration = performance.now() - startTime;
+
+      let errorMessage: string;
+      if (err instanceof Error) {
+        errorMessage = err.message;
+      } else {
+        errorMessage = String(err);
+      }
+
+      // Strip "Error: " prefix if present (vm module may prefix it)
+      if (errorMessage.startsWith('Error: ')) {
+        errorMessage = errorMessage.slice(7);
+      }
+
+      // Normalize timeout messages
+      if (errorMessage.toLowerCase().includes('timed out') || errorMessage.toLowerCase().includes('timeout')) {
+        errorMessage = 'Timeout';
+      }
+
+      return {
+        success: false,
+        output: null,
+        duration,
+        memoryUsed: 0,
+        error: errorMessage,
+      };
+    }
+  };
+
+  return { execute, executeWithTimeout };
+};
