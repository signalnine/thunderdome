;\n    });\n\n    it('returns the exact match when available', () => {\n      expect(resolver.maxSatisfying(['1.0.0', '1.0.1'], '1.0.0')).toBe('1.0.0');\n    });\n\n    it('returns null for empty versions array', () => {\n      expect(resolver.maxSatisfying([], '^1.0.0')).toBeNull();\n    });\n  });\n\n  describe('resolve', () => {\n    it('resolves constraints against available versions', () => {\n      const constraints = [\n        { name: 'a', range: '^1.0.0' },\n        { name: 'b', range: '~2.1.0' },\n      ];\n      const available = {\n        a: ['1.0.0', '1.5.0'],\n        b: ['2.0.0', '2.1.0', '2.1.3'],\n      };\n      const result = resolver.resolve(constraints, available);\n      expect(result).toEqual([\n        { name: 'a', version: '1.5.0', satisfies: '^1.0.0' },\n        { name: 'b', version: '2.1.3', satisfies: '~2.1.0' },\n      ]);\n    });\n\n    it('returns empty array for empty constraints', () => {\n      expect(resolver.resolve([], {})).toEqual([]);\n    });\n\n    it('omits unsatisfiable constraints gracefully', () => {\n      const constraints = [\n        { name: 'a', range: '^3.0.0' },\n        { name: 'b', range: '^1.0.0' },\n      ];\n      const available = {\n        a: ['1.0.0', '2.0.0'],\n        b: ['1.0.0', '1.5.0'],\n      };\n      const result = resolver.resolve(constraints, available);\n      expect(result.length).toBe(1);\n      expect(result[0].name).toBe('b');\n    });\n\n    it('returns empty array when no versions available', () => {\n      const constraints = [{ name: 'a', range: '^1.0.0' }];\n      expect(resolver.resolve(constraints, { a: [] })).toEqual([]);\n    });\n\n    it('returns empty array when package not in available', () => {\n      const constraints = [{ name: 'a', range: '^1.0.0' }];\n      expect(resolver.resolve(constraints, {})).toEqual([]);\n    });\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":3135,"cache_creation_input_tokens":0,"cache_read_input_tokens":63360,"o