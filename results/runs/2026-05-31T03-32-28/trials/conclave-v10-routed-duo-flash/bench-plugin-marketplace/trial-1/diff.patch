olves dependency versions', async () => {\n    const m = createMarketplace();\n    // Pre-register a dependency\n    m.registry.register(makeManifest('dep-a', '1.0.0'));\n    m.registry.register(makeManifest('dep-a', '1.5.0'));\n    const result = await m.installPlugin(makeManifest('consumer', '1.0.0', { 'dep-a': '^1.0.0' }));\n    expect(result.resolved.length).toBe(1);\n    expect(result.resolved[0].name).toBe('dep-a');\n  });\n\n  it('installPlugin executes entryPoint code', async () => {\n    const m = createMarketplace();\n    const result = await m.installPlugin(makeManifest('exec-test', '1.0.0', {}, '1 + 2'));\n    expect(result.result.success).toBe(true);\n    expect(result.result.output).toBe(3);\n  });\n\n  it('installPlugin reports sandbox execution result', async () => {\n    const m = createMarketplace();\n    const result = await m.installPlugin(makeManifest('result-test', '1.0.0'));\n    expect(result.result).toHaveProperty('success');\n    expect(result.result).toHaveProperty('output');\n    expect(result.result).toHaveProperty('duration');\n    expect(result.result).toHaveProperty('memoryUsed');\n  });\n\n  it('installPlugin rejects circular dependencies', async () => {\n    const m = createMarketplace();\n    m.registry.register(makeManifest('circ-b', '1.0.0', { 'circ-a': '^1.0.0' }));\n    await expect(\n      m.installPlugin(makeManifest('circ-a', '1.0.0', { 'circ-b': '^1.0.0' })),\n    ).rejects.toThrow('Circular dependency');\n  });\n\n  it('installPlugin can handle a plugin with dependencies and execution', async () => {\n    const m = createMarketplace();\n    m.registry.register(makeManifest('lib-a', '2.0.0', {}, '\"lib-a-version\"'));\n    const result = await m.installPlugin(\n      makeManifest('app', '1.0.0', { 'lib-a': '^2.0.0' }, '42'),\n    );\n    expect(result.resolved.length).toBe(1);\n    expect(result.resolved[0].version).toBe('2.0.0');\n    expect(result.result.success).toBe(true);\n    expect(result.result.output).toBe(42);\n  });\n});\n","userModified":false}}
