+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from './types.js';
+
+const dbInstances = new Map<string, Database.Database>();
+
+function getDb(dbPath: string): Database.Database {
+  let db = dbInstances.get(dbPath);
+  if (!db) {
+    db = new Database(dbPath);
+    db.pragma('journal_mode = WAL');
+    db.exec(`
+      CREATE TABLE IF NOT EXISTS reviews (
+        id INTEGER PRIMARY KEY AUTOINCREMENT,
+        pluginName TEXT NOT NULL,
+        pluginVersion TEXT NOT NULL,
+        userId TEXT NOT NULL,
+        rating INTEGER NOT NULL CHECK(rating >= 1 AND rating <= 5),
+        comment TEXT NOT NULL DEFAULT '',
+        flagged INTEGER NOT NULL DEFAULT 0,
+        createdAt TEXT NOT NULL DEFAULT (datetime('now'))
+      )
+    `);
+    db.exec(`
+      CREATE UNIQUE INDEX IF NOT EXISTS idx_reviews_user_plugin_version
+      ON reviews(pluginName, pluginVersion, userId)
+    `);
+    dbInstances.set(dbPath, db);
+  }
+  return db;
+}
+
+export function closeReviewDb(dbPath?: string): void {
+  if (dbPath) {
+    const db = dbInstances.get(dbPath);
+    if (db) {
+      db.close();
+      dbInstances.delete(dbPath);
+    }
+  } else {
+    for (const [, db] of dbInstances) {
+      db.close();
+    }
+    dbInstances.clear();
+  }
+}
+
+export function resetReviewDb(dbPath?: string): void {
+  if (dbPath) {
+    const db = dbInstances.get(dbPath);
+    if (db) {
+      db.exec('DELETE FROM reviews');
+    }
+  } else {
+    for (const db of dbInstances.values()) {
+      db.exec('DELETE FROM reviews');
+    }
+  }
+}
+
+function rowToReview(row: Record<string, unknown>): Review {
+  return {
+    id: row.id as number,
+    pluginName: row.pluginName as string,
+    pluginVersion: row.pluginVersion as string,
+    userId: row.userId as string,
+    rating: row.rating as number,
+    comment: row.comment as string,
+    flagged: Boolean(row.flagged),
+    createdAt: row.createdAt as string,
+  };
+}
+
+export const createReviewService = (dbPath: string = 'reviews.db'): ReviewService => {
+  const db = getDb(dbPath);
+
+  const insertStmt = db.prepare(`
+    INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment)
+    VALUES (@pluginName, @pluginVersion, @userId, @rating, @comment)
+  `);
+
+  const getByPluginStmt = db.prepare(`
+    SELECT * FROM reviews WHERE pluginName = ? AND flagged = 0 ORDER BY createdAt DESC
+  `);
+
+  const getAvgStmt = db.prepare(`
+    SELECT AVG(CAST(rating AS REAL)) as avg FROM reviews WHERE pluginName = ? AND flagged = 0
+  `);
+
+  const getReviewStmt = db.prepare(`SELECT * FROM reviews WHERE id = ?`);
+
+  const getFlaggedStmt = db.prepare(`
+    SELECT * FROM reviews WHERE flagged = 1 ORDER BY createdAt DESC
+  `);
+
+  const getByUserStmt = db.prepare(`
+    SELECT * FROM reviews WHERE userId = ? ORDER BY createdAt DESC
+  `);
+
+  const getCountStmt = db.prepare(`
+    SELECT COUNT(*) as count FROM reviews WHERE pluginName = ? AND flagged = 0
+  `);
+
+  const removeStmt = db.prepare(`DELETE FROM reviews WHERE id = ?`);
+
+  const addReview = (review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review => {
+    try {
+      const result = insertStmt.run({
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment,
+      });
+
+      const inserted = getReviewStmt.get(result.lastInsertRowid) as Record<string, unknown>;
+      return rowToReview(inserted);
+    } catch {
+      // Duplicate unique constraint (same user+plugin+version)
+      return null as unknown as Review;
+    }
+  };
+
+  const getReviews = (pluginName: string): Review[] => {
+    const rows = getByPluginStmt.all(pluginName) as Record<string, unknown>[];
+    return rows.map(rowToReview);
+  };
+
+  const getAverageRating = (pluginName: string): number => {
+    const row = getAvgStmt.get(pluginName) as { avg: number | null };
+    if (row.avg === null) return 0;
+    return Math.round(row.avg * 10) / 10;
+  };
+
+  const flagReview = (reviewId: number): void => {
+    db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?').run(reviewId);
+  };
+
+  const getFlaggedReviews = (): Review[] => {
+    const rows = getFlaggedStmt.all() as Record<string, unknown>[];
+    return rows.map(rowToReview);
+  };
+
+  const removeReview = (reviewId: number): boolean => {
+    const result = removeStmt.run(reviewId);
+    return result.changes > 0;
+  };
+
+  const getReviewsByUser = (userId: string): Review[] => {
+    const rows = getByUserStmt.all(userId) as Record<string, unknown>[];
+    return rows.map(rowToReview);
+  };
+
+  const getReviewCount = (pluginName: string): number => {
+    const row = getCountStmt.get(pluginName) as { count: number };
+    return row.count;
+  };
+
+  return {
+    addReview,
+    getReviews,
+    getAverageRating,
+    flagReview,
+    getFlaggedReviews,
+    removeReview,
+    getReviewsByUser,
+    getReviewCount,
+  };
+};
