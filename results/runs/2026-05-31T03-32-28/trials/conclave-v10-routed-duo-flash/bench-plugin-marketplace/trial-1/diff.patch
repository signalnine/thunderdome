nt: 'great' });\n    reviews.addReview({ pluginName: 'pkg', pluginVersion: '1.0.0', userId: 'u2', rating: 4, comment: 'nice' });\n    const r3 = reviews.addReview({ pluginName: 'pkg', pluginVersion: '1.0.0', userId: 'u3', rating: 1, comment: 'bad' });\n    reviews.flagReview(r3.id);\n    const avg = reviews.getAverageRating('pkg');\n    expect(avg).toBe(4.5); // (5 + 4) / 2\n  });\n\n  it('getAverageRating returns 0 when no non-flagged reviews', () => {\n    const reviews = createReviewService();\n    expect(reviews.getAverageRating('empty')).toBe(0);\n  });\n\n  it('flagReview marks a review as flagged', () => {\n    const reviews = createReviewService();\n    const r = reviews.addReview({ pluginName: 'pkg', pluginVersion: '1.0.0', userId: 'u1', rating: 3, comment: 'ok' });\n    reviews.flagReview(r.id);\n    const flagged = reviews.getFlaggedReviews();\n    expect(flagged.length).toBe(1);\n    expect(flagged[0].id).toBe(r.id);\n  });\n\n  it('getFlaggedReviews returns all flagged reviews', () => {\n    const reviews = createReviewService();\n    const r1 = reviews.addReview({ pluginName: 'a', pluginVersion: '1.0.0', userId: 'u1', rating: 3, comment: 'ok' });\n    const r2 = reviews.addReview({ pluginName: 'b', pluginVersion: '1.0.0', userId: 'u2', rating: 2, comment: 'bad' });\n    reviews.flagReview(r1.id);\n    reviews.flagReview(r2.id);\n    expect(reviews.getFlaggedReviews().length).toBe(2);\n  });\n\n  it('removeReview deletes a review and returns true', () => {\n    const reviews = createReviewService();\n    const r = reviews.addReview({ pluginName: 'pkg', pluginVersion: '1.0.0', userId: 'u1', rating: 3, comment: 'ok' });\n    expect(reviews.removeReview(r.id)).toBe(true);\n    expect(reviews.getReviewCount('pkg')).toBe(0);\n  });\n\n  it('removeReview returns false for non-existent review', () => {\n    const reviews = createReviewService();\n    expect(reviews.removeReview(99999)).toBe(false);\n  });\n\n  it('getReviewsByUser returns all reviews by a user