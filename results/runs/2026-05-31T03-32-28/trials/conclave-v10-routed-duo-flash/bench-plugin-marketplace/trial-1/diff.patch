, '1.0.0'));\n      const deps = createDeps();\n      const tree = deps.buildTree('a', registry);\n      expect(tree.name).toBe('a');\n      expect(tree.dependencies.length).toBe(2);\n      const bNode = tree.dependencies.find(n => n.name === 'b')!;\n      expect(bNode).toBeDefined();\n      expect(bNode.dependencies.length).toBe(1);\n      expect(bNode.dependencies[0].name).toBe('c');\n    });\n  });\n\n  describe('detectCycles', () => {\n    it('returns null for acyclic graph', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0' }));\n      registry.register(makeManifest('b', '1.0.0', { c: '^1.0.0' }));\n      registry.register(makeManifest('c', '1.0.0'));\n      const deps = createDeps();\n      expect(deps.detectCycles('a', registry)).toBeNull();\n    });\n\n    it('detects a direct cycle', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0' }));\n      registry.register(makeManifest('b', '1.0.0', { a: '^1.0.0' }));\n      const deps = createDeps();\n      const cycles = deps.detectCycles('a', registry);\n      expect(cycles).not.toBeNull();\n      expect(cycles!.length).toBeGreaterThanOrEqual(1);\n    });\n\n    it('detects an indirect cycle A -> B -> C -> A', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0' }));\n      registry.register(makeManifest('b', '1.0.0', { c: '^1.0.0' }));\n      registry.register(makeManifest('c', '1.0.0', { a: '^1.0.0' }));\n      const deps = createDeps();\n      const cycles = deps.detectCycles('a', registry);\n      expect(cycles).not.toBeNull();\n    });\n\n    it('detects a self-cycle', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { a: '^1.0.0' }));\n      const deps = createDeps();\n      const cycles = deps.detectCycles('a', registry);\n      expect(cycles).not.toBeNull();\n    });\n  });\n\n  describe('hasCircularDependency', () => {\n    it('returns false for acyclic graph', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0' }));\n      registry.register(makeManifest('b', '1.0.0'));\n      const deps = createDeps();\n      expect(deps.hasCircularDependency('a', registry)).toBe(false);\n    });\n\n    it('returns true for cyclic graph', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0' }));\n      registry.register(makeManifest('b', '1.0.0', { a: '^1.0.0' }));\n      const deps = createDeps();\n      expect(deps.hasCircularDependency('a', registry)).toBe(true);\n    });\n  });\n\n  describe('topologicalSort', () => {\n    it('returns dependencies before dependents', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0', c: '^1.0.0' }));\n      registry.register(makeManifest('b', '1.0.0', { c: '^1.0.0' }));\n      registry.register(makeManifest('c', '1.0.0'));\n      const deps = createDeps();\n      const order = deps.topologicalSort('a', registry);\n      expect(order.indexOf('c')).toBeLessThan(order.indexOf('b'));\n      expect(order.indexOf('b')).toBeLessThan(order.indexOf('a'));\n    });\n\n    it('works for a linear chain', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0' }));\n      registry.register(makeManifest('b', '1.0.0', { c: '^1.0.0' }));\n      registry.register(makeManifest('c', '1.0.0'));\n      const deps = createDeps();\n      const order = deps.topologicalSort('a', registry);\n      expect(order).toEqual(['c', 'b', 'a']);\n    });\n\n    it('throws on circular dependency', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0' }));\n      registry.register(makeManifest('b', '1.0.0', { a: '^1.0.0' }));\n      const deps = createDeps();\n      expect(() => deps.topologicalSort('a', registry)).toThrow('Circular dependency');\n    });\n  });\n\n  describe('flattenDependencies', () => {\n    it('returns all transitive dependency names', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0', c: '^1.0.0' }));\n      registry.register(makeManifest('b', '1.0.0', { d: '^1.0.0' }));\n      registry.register(makeManifest('c', '1.0.0'));\n      registry.register(makeManifest('d', '1.0.0'));\n      const deps = createDeps();\n      const flat = deps.flattenDependencies('a', registry);\n      expect(flat.sort()).toEqual(['b', 'c', 'd']);\n    });\n\n    it('returns unique names only (no duplicates)', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0' }));\n      registry.register(makeManifest('b', '1.0.0', { c: '^1.0.0' }));\n      registry.register(makeManifest('c', '1.0.0'));\n      const deps = createDeps();\n      const flat = deps.flattenDependencies('a', registry);\n      expect(flat).toEqual(['b', 'c']);\n    });\n\n    it('returns empty array for plugin with no deps', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0'));\n      const deps = createDeps();\n      expect(deps.flattenDependencies('a', registry)).toEqual([]);\n    });\n\n    it('handles diamond dependencies', () => {\n      const registry = createRegistry(TEST_DB);\n      resetDb(TEST_DB);\n      registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0', c: '^1.0.0' }));\n      registry.register(makeManifest('b', '1.0.0', { d: '^1.0.0' }));\n      registry.register(makeManifest('c', '1.0.0', { d: '^1.0.0' }));\n      registry.register(makeManifest('d', '1.0.0'));\n      const deps = createDeps();\n      const flat = deps.flattenDependencies('a', registry);\n      const dCount = flat.filter(name => name === 'd').length;\n      expect(dCount).toBe(1);\n    });\n  });\n});\n","structuredPatch":[{"oldStart":1,"oldLines":8,"newStart":1,"newLines":10,"lines":["-import { describe, it, expect } from 'vitest';","-import { createRegistry } from '../src/registry.js';","+import { describe, it, expect, beforeAll, afterAll } from 'vitest';","+import { createRegistry, closeDb, resetDb } from '../src/registry.js';"," import { createDeps } from '../src/deps.js';"," import type { PluginManifest } from '../src/types.js';"," ","+const TEST_DB = 'deps-test.db';","+"," function makeManifest(name: string, version: string, deps: Record<string, string> = {}): PluginManifest {","   return {","     name,"]},{"oldStart":16,"oldLines":9,"newStart":18,"newLines":18,"lines":[" }"," "," describe('Dependency Graph', () => {","+  beforeAll(() => {","+    closeDb(TEST_DB);","+  });","+","+  afterAll(() => {","+    closeDb(TEST_DB);","+  });","+","   describe('buildTree', () => {","     it('builds a tree for a plugin with no deps', () => {","-      const registry = createRegistry();","+      const registry = createRegistry(TEST_DB);","+      resetDb(TEST_DB);","       registry.register(makeManifest('root', '1.0.0'));","       const deps = createDeps();","       const tree = deps.buildTree('root', registry);"]},{"oldStart":28,"oldLines":7,"newStart":39,"newLines":8,"lines":["     });"," ","     it('builds a tree with nested dependencies', () => {","-      const registry = createRegistry();","+      const registry = createRegistry(TEST_DB);","+      resetDb(TEST_DB);","       registry.register(makeManifest('a', '1.0.0', { b: '^1.0.0', c: '^1.0.0' }));","    