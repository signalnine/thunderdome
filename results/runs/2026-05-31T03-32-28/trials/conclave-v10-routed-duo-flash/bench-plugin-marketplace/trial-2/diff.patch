@@ -0,0 +1,110 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+export function createReviewService(): ReviewService {
+  const db = new Database(':memory:');
+
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL CHECK(rating >= 1 AND rating <= 5),
+      comment TEXT NOT NULL DEFAULT '',
+      flagged INTEGER NOT NULL DEFAULT 0,
+      createdAt TEXT NOT NULL
+    )
+  `);
+
+  const insertStmt = db.prepare(
+    'INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt) VALUES (?, ?, ?, ?, ?, 0, ?)'
+  );
+  const getByPluginStmt = db.prepare(
+    'SELECT * FROM reviews WHERE pluginName = ? AND flagged = 0 ORDER BY createdAt DESC'
+  );
+  const getFlaggedStmt = db.prepare('SELECT * FROM reviews WHERE flagged = 1');
+  const getByUserStmt = db.prepare(
+    'SELECT * FROM reviews WHERE userId = ? ORDER BY createdAt DESC'
+  );
+  const flagStmt = db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');
+  const removeStmt = db.prepare('DELETE FROM reviews WHERE id = ?');
+  const avgRatingStmt = db.prepare(
+    'SELECT AVG(rating) as avg FROM reviews WHERE pluginName = ? AND flagged = 0'
+  );
+  const countStmt = db.prepare(
+    'SELECT COUNT(*) as cnt FROM reviews WHERE pluginName = ? AND flagged = 0'
+  );
+  const lastIdStmt = db.prepare('SELECT last_insert_rowid() as id');
+
+  const rowToReview = (row: Record<string, unknown>): Review => ({
+    id: row.id as number,
+    pluginName: row.pluginName as string,
+    pluginVersion: row.pluginVersion as string,
+    userId: row.userId as string,
+    rating: row.rating as number,
+    comment: row.comment as string,
+    flagged: (row.flagged as number) === 1,
+    createdAt: row.createdAt as string,
+  });
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      const createdAt = new Date().toISOString();
+      insertStmt.run(
+        review.pluginName,
+        review.pluginVersion,
+        review.userId,
+        review.rating,
+        review.comment,
+        createdAt,
+      );
+      const id = (lastIdStmt.get() as Record<string, unknown>).id as number;
+      return {
+        id,
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment,
+        flagged: false,
+        createdAt,
+      };
+    },
+
+    getReviews(pluginName: string): Review[] {
+      const rows = getByPluginStmt.all(pluginName);
+      return (rows as Record<string, unknown>[]).map(rowToReview);
+    },
+
+    getAverageRating(pluginName: string): number {
+      const row = avgRatingStmt.get(pluginName) as Record<string, unknown>;
+      if (!row || row.avg === null) return 0;
+      return Math.round((row.avg as number) * 10) / 10;
+    },
+
+    flagReview(reviewId: number): void {
+      flagStmt.run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      const rows = getFlaggedStmt.all();
+      return (rows as Record<string, unknown>[]).map(rowToReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      const info = removeStmt.run(reviewId);
+      return info.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      const rows = getByUserStmt.all(userId);
+      return (rows as Record<string, unknown>[]).map(rowToReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = countStmt.get(pluginName) as Record<string, unknown>;
+      return row.cnt as number;
+    },
+  };
+}
