@@ -0,0 +1,57 @@
+import vm from 'vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+export function createRunner(): RunnerService {
+  const execute = async (
+    code: string,
+    context?: Record<string, unknown>,
+  ): Promise<SandboxResult> => {
+    return executeWithTimeout(code, 5000, context);
+  };
+
+  const executeWithTimeout = async (
+    code: string,
+    timeoutMs: number,
+    context?: Record<string, unknown>,
+  ): Promise<SandboxResult> => {
+    const start = process.hrtime.bigint();
+    const memoryBefore = process.memoryUsage().heapUsed;
+
+    try {
+      const sandbox = { ...context, module: {} as { exports: unknown } };
+      const ctx = vm.createContext(sandbox);
+      const script = new vm.Script(code);
+
+      const result = script.runInContext(ctx, { timeout: timeoutMs });
+
+      const memoryAfter = process.memoryUsage().heapUsed;
+      const durationNs = process.hrtime.bigint() - start;
+      const durationMs = Number(durationNs) / 1_000_000;
+
+      return {
+        success: true,
+        output: result,
+        duration: durationMs,
+        memoryUsed: Math.max(0, memoryAfter - memoryBefore),
+      };
+    } catch (err: unknown) {
+      const memoryAfter = process.memoryUsage().heapUsed;
+      const durationNs = process.hrtime.bigint() - start;
+      const durationMs = Number(durationNs) / 1_000_000;
+      const message = err instanceof Error ? err.message : String(err);
+
+      // Check if the error is a timeout
+      const isTimeout = message.includes('timed out');
+
+      return {
+        success: false,
+        output: undefined,
+        duration: durationMs,
+        memoryUsed: Math.max(0, memoryAfter - memoryBefore),
+        error: isTimeout ? 'Script execution timed out' : message,
+      };
+    }
+  };
+
+  return { execute, executeWithTimeout };
+}
