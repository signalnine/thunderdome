@@ -0,0 +1,157 @@
+import type { DependencyNode, RegistryService, DepsService } from '../types.js';
+
+export function createDepsService(): DepsService {
+  function buildTree(name: string, registry: RegistryService): DependencyNode {
+    const manifest = registry.get(name);
+    if (!manifest) {
+      return { name, version: '', dependencies: [] };
+    }
+
+    const seen = new Set<string>();
+
+    function build(
+      depName: string,
+      depVersion: string,
+      deps: Record<string, string>,
+    ): DependencyNode {
+      const key = `${depName}@${depVersion}`;
+      if (seen.has(key)) {
+        return { name: depName, version: depVersion, dependencies: [] };
+      }
+      seen.add(key);
+
+      const currentNode: DependencyNode = {
+        name: depName,
+        version: depVersion,
+        dependencies: [],
+      };
+
+      for (const childName of Object.keys(deps)) {
+        const child = registry.get(childName);
+        if (child) {
+          currentNode.dependencies.push(
+            build(child.name, child.version, child.dependencies),
+          );
+        }
+      }
+
+      return currentNode;
+    }
+
+    return build(manifest.name, manifest.version, manifest.dependencies);
+  }
+
+  function detectCycles(
+    name: string,
+    registry: RegistryService,
+  ): string[][] | null {
+    const manifest = registry.get(name);
+    if (!manifest) return null;
+
+    const cycles: string[][] = [];
+    const visited = new Set<string>();
+    const recStack = new Set<string>();
+    const path: string[] = [];
+
+    function dfs(currentName: string, currentVersion: string): void {
+      const key = `${currentName}@${currentVersion}`;
+      visited.add(key);
+      recStack.add(key);
+      path.push(currentName);
+
+      const depManifest = registry.getVersion(currentName, currentVersion);
+      if (depManifest) {
+        for (const depName of Object.keys(depManifest.dependencies)) {
+          const dep = registry.get(depName);
+          if (!dep) continue;
+          const depKey = `${depName}@${dep.version}`;
+
+          if (!visited.has(depKey)) {
+            dfs(depName, dep.version);
+          } else if (recStack.has(depKey)) {
+            // Found a cycle - extract the cycle path
+            const cycleStart = path.indexOf(depName);
+            if (cycleStart !== -1) {
+              cycles.push([...path.slice(cycleStart), depName]);
+            }
+          }
+        }
+      }
+
+      recStack.delete(key);
+      path.pop();
+    }
+
+    dfs(name, manifest.version);
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  function topologicalSort(
+    name: string,
+    registry: RegistryService,
+  ): string[] {
+    const manifest = registry.get(name);
+    if (!manifest) return [];
+
+    const visited = new Set<string>();
+    const order: string[] = [];
+
+    function dfs(currentName: string): void {
+      if (visited.has(currentName)) return;
+      visited.add(currentName);
+
+      const depManifest = registry.get(currentName);
+      if (depManifest) {
+        for (const depName of Object.keys(depManifest.dependencies)) {
+          dfs(depName);
+        }
+      }
+      order.push(currentName);
+    }
+
+    dfs(name);
+    return order;
+  }
+
+  function flattenDependencies(
+    name: string,
+    registry: RegistryService,
+  ): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>();
+
+    function collect(currentName: string): void {
+      const depManifest = registry.get(currentName);
+      if (!depManifest) return;
+
+      for (const depName of Object.keys(depManifest.dependencies)) {
+        const dep = registry.get(depName);
+        if (!dep) continue;
+        const depKey = `${depName}@${dep.version}`;
+        if (!visited.has(depKey)) {
+          visited.add(depKey);
+          result.push(depKey);
+          collect(depName);
+        }
+      }
+    }
+
+    collect(name);
+    return result;
+  }
+
+  function hasCircularDependency(
+    name: string,
+    registry: RegistryService,
+  ): boolean {
+    return detectCycles(name, registry) !== null;
+  }
+
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency,
+  };
+}
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..07bca28
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,86 @@
+import { createRegistry } from './registry/index.js';
+import { createResolver } from './resolver/index.js';
+import { createRunner } from './runner/index.js';
+import { createReviewService } from './reviews/index.js';
+import { createDepsService } from './deps/index.js';
+import type {
+  PluginManifest,
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+  ResolvedVersion,
+  SandboxResult,
+} from './types.js';
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(
+    manifest: PluginManifest,
+  ): Promise<{ resolved: ResolvedVersion[]; result: SandboxResult }>;
+}
+
+export function createMarketplace(): Marketplace {
+  const registry = createRegistry();
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviewService();
+  const deps = createDepsService();
+
+  async function installPlugin(
+    manifest: PluginManifest,
+  ): Promise<{ resolved: ResolvedVersion[]; result: SandboxResult }> {
+    // 1. Validate required fields
+    if (!manifest.name || !manifest.version || !manifest.entryPoint) {
+      throw new Error('Invalid manifest: name, version, and entryPoint are required');
+    }
+
+    // 2. Register the plugin
+    registry.register(manifest);
+
+    // 3. Resolve dependency versions
+    const constraints = Object.entries(manifest.dependencies).map(
+      ([name, range]) => ({ name, range }),
+    );
+    const available: Record<string, string[]> = {};
+    for (const [depName] of Object.entries(manifest.dependencies)) {
+      const versions = registry.listVersions(depName);
+      if (versions.length > 0) {
+        available[depName] = versions;
+      }
+    }
+    const resolved = resolver.resolve(constraints, available);
+
+    // 4. Check for circular dependencies
+    if (deps.hasCircularDependency(manifest.name, registry)) {
+      throw new Error('Circular dependency detected');
+    }
+
+    // 5. Execute entry point with deps in context
+    const contextDeps: Record<string, unknown> = {};
+    for (const r of resolved) {
+      const depManifest = registry.getVersion(r.name, r.version);
+      if (depManifest) {
+        contextDeps[r.name] = depManifest;
+      }
+    }
+
+    const result = await runner.execute(manifest.entryPoint, contextDeps);
+
+    return { resolved, result };
+  }
+
+  return {
+    registry,
+    resolver,
+    runner,
+    reviews,
+    deps,
+    installPlugin,
+  };
+}
