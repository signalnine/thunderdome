\n  it('should return null for non-existent plugin', () => {\n    expect(registry.get('nonexistent')).toBeNull();\n  });\n\n  it('should return null for non-existent version', () => {\n    expect(registry.getVersion('test-plugin', '9.9.9')).toBeNull();\n  });\n\n  it('should list all versions', () => {\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.register(makeManifest({ version: '2.0.0' }));\n    registry.register(makeManifest({ version: '1.5.0' }));\n    const versions = registry.listVersions('test-plugin');\n    expect(versions).toEqual(['1.0.0', '1.5.0', '2.0.0']);\n  });\n\n  it('should list all manifests', () => {\n    registry.register(makeManifest({ name: 'a', version: '1.0.0' }));\n    registry.register(makeManifest({ name: 'b', version: '1.0.0' }));\n    const list = registry.list();\n    expect(list).toHaveLength(2);\n  });\n\n  it('should search by name case-insensitively', () => {\n    registry.register(makeManifest({ name: 'MyPlugin', version: '1.0.0' }));\n    const results = registry.search('myplugin');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('MyPlugin');\n  });\n\n  it('should search by description', () => {\n    registry.register(makeManifest({ description: 'Handles authentication' }));\n    const results = registry.search('authentication');\n    expect(results).toHaveLength(1);\n  });\n\n  it('should return empty array when search has no matches', () => {\n    registry.register(makeManifest());\n    const results = registry.search('xyznonexistent');\n    expect(results).toEqual([]);\n  });\n\n  it('should remove a specific version', () => {\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.register(makeManifest({ version: '2.0.0' }));\n    const removed = registry.remove('test-plugin', '1.0.0');\n    expect(removed).toBe(true);\n    expect(registry.getVersion('test-plugin', '1.0.0')).toBeNull();\n    expect(registry.get('test-plugin')!.version).toBe('2.0.0');\n  });\n\n  it('should return false when removing non-existent version', () => {\n    expect(registry.remove('nonexistent', '1.0.0')).toBe(false);\n  });\n\n  it('should update fields of a plugin', () => {\n    registry.register(makeManifest());\n    registry.update('test-plugin', '1.0.0', { description: 'Updated' });\n    const result = registry.get('test-plugin');\n    expect(result!.description).toBe('Updated');\n  });\n\n  it('should throw on update for non-existent plugin', () => {\n    expect(() => registry.update('nonexistent', '1.0.0', {})).toThrow();\n  });\n\n  it('should return empty versions list for unknown plugin', () => {\n    expect(registry.listVersions('nonexistent')).toEqual([]);\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":81,"cache_creation_input_tokens":0,"cache_read_input_tokens":27264,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"63e6badb-979c-4c2b-91de-049631b45e28","uuid":"a3dc35ae-94fc-4887-aa49-3dc17b678d21"}
