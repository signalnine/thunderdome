atedAt DESC'\n  );\n  const flagStmt = db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');\n  const removeStmt = db.prepare('DELETE FROM reviews WHERE id = ?');\n  const avgRatingStmt = db.prepare(\n    'SELECT AVG(rating) as avg FROM reviews WHERE pluginName = ? AND flagged = 0'\n  );\n  const countStmt = db.prepare(\n    'SELECT COUNT(*) as cnt FROM reviews WHERE pluginName = ? AND flagged = 0'\n  );\n  const lastIdStmt = db.prepare('SELECT last_insert_rowid() as id');\n\n  const rowToReview = (row: Record<string, unknown>): Review => ({\n    id: row.id as number,\n    pluginName: row.pluginName as string,\n    pluginVersion: row.pluginVersion as string,\n    userId: row.userId as string,\n    rating: row.rating as number,\n    comment: row.comment as string,\n    flagged: (row.flagged as number) === 1,\n    createdAt: row.createdAt as string,\n  });\n\n  return {\n    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {\n      const createdAt = new Date().toISOString();\n      insertStmt.run(\n        review.pluginName,\n        review.pluginVersion,\n        review.userId,\n        review.rating,\n        review.comment,\n        createdAt,\n      );\n      const id = (lastIdStmt.get() as Record<string, unknown>).id as number;\n      return {\n        id,\n        pluginName: review.pluginName,\n        pluginVersion: review.pluginVersion,\n        userId: review.userId,\n        rating: review.rating,\n        comment: review.comment,\n        flagged: false,\n        createdAt,\n      };\n    },\n\n    getReviews(pluginName: string): Review[] {\n      const rows = getByPluginStmt.all(pluginName);\n      return (rows as Record<string, unknown>[]).map(rowToReview);\n    },\n\n    getAverageRating(pluginName: string): number {\n      const row = avgRatingStmt.get(pluginName) as Record<string, unknown>;\n      if (!row || row.avg === null) return 0;\n      return Math.round((row.avg as number) * 10) / 10;\n    },\n\n    flagReview(revie