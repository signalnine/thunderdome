         sendError(ws, 'Failed to apply operation');\n211\t          return;\n212\t        }\n213\t\n214\t        const result = db.applyOperation(docId, transformedOp, newContent);\n215\t        if (!result) {\n216\t          sendError(ws, 'Failed to persist operation');\n217\t          return;\n218\t        }\n219\t\n220\t        // Broadcast to ALL connected clients (including sender)\n221\t        broadcastOp(docId, result.version, transformedOp);\n222\t      });\n223\t\n224\t      ws.on('error', () => {\n225\t        // Socket error — just clean up\n226\t      });\n227\t    });\n228\t\n229\t    // ── Broadcast helper ───────────────────────────────────\n230\t\n231\t    function broadcastOp(docId: string, version: number, op: Op): void {\n232\t      if (!wss) return;\n233\t      const msg: ServerMessage = { type: 'op', version, op };\n234\t      const raw = JSON.stringify(msg);\n235\t\n236\t      wss.clients.forEach((client) => {\n237\t        // Only send to clients on the same doc\n238\t        if (\n239\t          client.readyState === WebSocket.OPEN &&\n240\t          (client as any)._docId === docId\n241\t        ) {\n242\t          client.send(raw);\n243\t        }\n244\t      });\n245\t    }\n246\t\n247\t    // Tag new connections with their docId for broadcast filtering\n248\t    const origHandler = wss.on;\n249\t    wss.on = ((event: string, handler: (...args: any[]) => void) => {\n250\t      if (event !== 'connection') {\n251\t        return origHandler.call(wss, event, handler);\n252\t      }\n253\t\n254\t      origHandler.call(wss, 'connection', (ws: WebSocket, req: any) => {\n255\t        const url = new URL(req.url ?? '/', `http://${req.headers?.host ?? 'localhost'}`);\n256\t        const match = url.pathname.match(/^\\/ws\\/(.+)$/);\n257\t        if (match) {\n258\t          (ws as any)._docId = match[1];\n259\t        }\n260\t        handler(ws, req);\n261\t      });\n262\t\n263\t      return wss;\n264\t    }) as any;\n265\t  }\n266\t\n267\t  // ── Server lifecycle ─────────────────────────────────────\n268\t\n269\t  return {\n270\t    app,\n271\t    async start(port?: number): Promise<number> {\n272\t      return new Promise((resolve) => {\n273\t        httpServer = createServer(app);\n274\t        setupWebSocket(httpServer);\n275\t        httpServer.listen(port ?? 0, () => {\n276\t          const addr = httpServer!.address();\n277\t          const actualPort =\n278\t            typeof addr === 'string' ? parseInt(addr, 10) : addr!.port;\n279\t          resolve(actualPort);\n280\t        });\n281\t      });\n282\t    },\n283\t    async stop(): Promise<void> {\n284\t      // Close all WebSocket connections\n285\t      if (wss) {\n286\t        wss.clients.forEach((client) => {\n287\t          client.close(1001, 'Server shutting down');\n288\t        });\n289\t        wss.close();\n290\t        wss = null;\n291\t      }\n292\t\n293\t      // Close HTTP server\n294\t      if (httpServer) {\n295\t        return new Promise((resolve) => {\n296\t          httpServer!.close(() => {\n297\t            httpServer = null;\n298\t            resolve();\n299\t          });\n300\t        });\n301\t      }\n302\t\n303\t      db.close();\n304\t    },\n305\t  };\n306\t}\n307\t\n308\t// ── Helpers ────────────────────────────────────────────────\n309\t\n310\tfunction sendError(ws: WebSocket, message: string): void {\n311\t  if (ws.readyState === WebSocket.OPEN) {\n312\t    ws.send(JSON.stringify({ type: 'error', message } satisfies ServerMessage));\n313\t  }\n314\t}\n315\t\n316\tfunction isValidOp(op: unknown): op is Op {\n317\t  if (!op || typeof op !== 'object') return false;\n318\t  const o = op as Record<string, unknown>;\n319\t  if (o.type !== 'insert' && o.type !== 'delete') return false;\n320\t  if (typeof o.pos !== 'number' || !Number.isInteger(o.pos) || o.pos < 0)\n321\t    return false;\n322\t\n323\t  if (o.type === 'insert') {\n324\t    return typeof o.text === 'string' && o.text.length > 0;\n325\t  }\n326\t\n327\t