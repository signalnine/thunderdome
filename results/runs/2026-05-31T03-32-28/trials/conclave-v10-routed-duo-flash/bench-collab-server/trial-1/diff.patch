t edits on same document preserve all content', () => {\n    const content = 'hello';\n    // A inserts at pos 0, B inserts at pos 5 — both should be present\n    const { via12, via21 } = applyBoth(content, insert(0, 'A:'), insert(5, ':B'));\n    expect(via12).toBe(via21);\n    expect(via12).toBe('A:hello:B');\n  });\n\n  it('overlapping deletes preserve non-deleted content', () => {\n    const content = 'abcdefgh';\n    // A deletes \"bcd\" (1,3), B deletes \"ef\" (4,2)\n    const { via12, via21 } = applyBoth(content, del(1, 3), del(4, 2));\n    expect(via12).toBe(via21);\n    expect(via12).toBe('agh');\n  });\n\n  it('insert at same position: both preserved', () => {\n    const content = '[]';\n    const { via12, via21 } = applyBoth(content, insert(1, 'A'), insert(1, 'B'));\n    expect(via12).toBe(via21);\n    expect(via12.length).toBe(4); // '[', 'A', 'B', ']'\n    expect(via12).toContain('A');\n    expect(via12).toContain('B');\n  });\n});\n","structuredPatch":[{"oldStart":121,"oldLines":11,"newStart":121,"newLines":11,"lines":["     expect(result).toEqual(del(2, 2)); // 4 - 2 = 2","   });"," ","-  it('delete overlapping at end: trim length', () => {","+  it('delete overlapping at end: entirely subsumed becomes no-op', () => {","     // op1 deletes \"bc\" (pos 1, len 2), op2 deletes \"bcd\" (pos 1, len 3)","-    // op1's \"c\" is in the overlap, so only \"b\" survives","+    // op1's entire range is within op2's range → no-op after op2","     const result = transform(del(1, 2), del(1, 3));","-    expect(result).toEqual(del(1, 1)); // overlap trimmed","+    expect(result).toBeNull();","   });"," ","   it('delete overlapping at start: shift position and trim', () => {"]}],"userModified":false,"replaceAll":false}}
