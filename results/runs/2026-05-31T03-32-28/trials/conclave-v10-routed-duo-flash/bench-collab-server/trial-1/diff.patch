@@ -0,0 +1,317 @@
+import express from 'express';
+import { createServer, type Server } from 'node:http';
+import { WebSocketServer, WebSocket } from 'ws';
+import type { CollabServer, Op, ClientMessage, ServerMessage } from './types.js';
+import { DocDatabase } from './db.js';
+import { apply, transform } from './ot.js';
+
+export function createApp(dbPath?: string): CollabServer {
+  const app = express();
+  let httpServer: Server | null = null;
+  let wss: WebSocketServer | null = null;
+
+  // ── Middleware ────────────────────────────────────────────
+
+  app.use(express.json());
+
+  // ── Database ──────────────────────────────────────────────
+
+  const db = new DocDatabase(dbPath);
+
+  // ── Document routes ──────────────────────────────────────
+
+  app.post('/documents', (req, res) => {
+    const { title } = req.body;
+    if (!title || typeof title !== 'string' || title.trim().length === 0) {
+      res.status(400).json({ message: 'title is required' });
+      return;
+    }
+    const doc = db.createDocument(title.trim());
+    res.status(201).json(doc);
+  });
+
+  app.get('/documents', (_req, res) => {
+    const docs = db.listDocuments();
+    res.json(docs);
+  });
+
+  app.get('/documents/:id', (req, res) => {
+    const doc = db.getDocument(req.params.id);
+    if (!doc) {
+      res.status(404).json({ message: 'Document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  app.put('/documents/:id', (req, res) => {
+    const { title, content } = req.body;
+    if (title !== undefined && typeof title !== 'string') {
+      res.status(400).json({ message: 'title must be a string' });
+      return;
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      res.status(400).json({ message: 'content must be a string' });
+      return;
+    }
+
+    const result = db.updateDocument(req.params.id, {
+      title,
+      content,
+    });
+    if (!result) {
+      res.status(404).json({ message: 'Document not found' });
+      return;
+    }
+    res.json(result.document);
+  });
+
+  app.delete('/documents/:id', (req, res) => {
+    const deleted = db.deleteDocument(req.params.id);
+    if (!deleted) {
+      res.status(404).json({ message: 'Document not found' });
+      return;
+    }
+    res.status(204).end();
+  });
+
+  app.get('/documents/:id/versions', (req, res) => {
+    const doc = db.getDocument(req.params.id);
+    if (!doc) {
+      res.status(404).json({ message: 'Document not found' });
+      return;
+    }
+    const versions = db.getVersions(req.params.id);
+    res.json(versions);
+  });
+
+  // ── WebSocket ────────────────────────────────────────────
+
+  function setupWebSocket(server: Server): void {
+    wss = new WebSocketServer({ server });
+
+    wss.on('connection', (ws, req) => {
+      // Parse docId from URL path: /ws/:docId
+      const url = new URL(req.url ?? '/', `http://${req.headers.host ?? 'localhost'}`);
+      const match = url.pathname.match(/^\/ws\/(.+)$/);
+
+      if (!match) {
+        sendError(ws, 'Invalid WebSocket path — use /ws/:docId');
+        ws.close(4000, 'Invalid path');
+        return;
+      }
+
+      const docId = match[1];
+
+      // Tag the socket for broadcast filtering
+      (ws as unknown as Record<string, unknown>)._docId = docId;
+
+      const doc = db.getDocument(docId);
+
+      if (!doc) {
+        sendError(ws, `Document ${docId} not found`);
+        ws.close(4004, 'Document not found');
+        return;
+      }
+
+      const currentVersion = db.getVersionOrThrow(docId);
+
+      // Send init message
+      const initMsg: ServerMessage = {
+        type: 'init',
+        docId,
+        content: doc.content,
+        version: currentVersion,
+      };
+      ws.send(JSON.stringify(initMsg));
+
+      // Listen for messages
+      ws.on('message', (data) => {
+        let parsed: ClientMessage;
+        try {
+          const raw = JSON.parse(data.toString());
+          parsed = raw as ClientMessage;
+        } catch {
+          sendError(ws, 'Invalid JSON');
+          return;
+        }
+
+        if (parsed.type !== 'op') {
+          sendError(ws, `Unknown message type: ${(parsed as unknown as Record<string, unknown>).type}`);
+          return;
+        }
+
+        const { version: clientVersion, op } = parsed;
+
+        if (!isValidOp(op)) {
+          sendError(ws, `Invalid operation: ${JSON.stringify(op)}`);
+          return;
+        }
+
+        // Fetch current document state
+        const currentDoc = db.getDocument(docId);
+        if (!currentDoc) {
+          sendError(ws, 'Document not found');
+          return;
+        }
+
+        // Validate operation bounds against current content
+        const contentLen = currentDoc.content.length;
+        if (op.type === 'insert' && (op.pos < 0 || op.pos > contentLen)) {
+          sendError(ws, `Insert position ${op.pos} out of bounds [0, ${contentLen}]`);
+          return;
+        }
+        if (op.type === 'delete') {
+          if (op.pos < 0 || op.pos + op.length > contentLen) {
+            sendError(
+              ws,
+              `Delete at ${op.pos}, length ${op.length} out of bounds for content length ${contentLen}`,
+            );
+            return;
+          }
+          if (op.length <= 0) {
+            sendError(ws, 'Delete length must be positive');
+            return;
+          }
+        }
+        if (op.type === 'insert' && op.text.length === 0) {
+          sendError(ws, 'Insert text must not be empty');
+          return;
+        }
+
+        // ── Operational Transform ─────────────────────────
+        let transformedOp: Op | null = op;
+        const currentVer = db.getVersionOrThrow(docId);
+
+        if (clientVersion < currentVer) {
+          const intervening = db.getOperationsSince(docId, clientVersion);
+          for (const interv of intervening) {
+            if (transformedOp === null) break;
+            transformedOp = transform(transformedOp, interv.operation);
+          }
+        } else if (clientVersion > currentVer) {
+          sendError(
+            ws,
+            `Version ${clientVersion} is ahead of server version ${currentVer}`,
+          );
+          return;
+        }
+
+        if (transformedOp === null) {
+          // Operation had no net effect after transformation — silently drop
+          return;
+        }
+
+        // Apply the transformed operation
+        let newContent: string;
+        try {
+          newContent = apply(currentDoc.content, transformedOp);
+        } catch {
+          sendError(ws, 'Failed to apply operation');
+          return;
+        }
+
+        const result = db.applyOperation(docId, transformedOp, newContent);
+        if (!result) {
+          sendError(ws, 'Failed to persist operation');
+          return;
+        }
+
+        // Broadcast to ALL connected clients (including sender)
+        broadcastOp(docId, result.version, transformedOp);
+      });
+
+      ws.on('error', () => {
+        // Socket error — nothing to clean up
+      });
+    });
+
+    // ── Broadcast helper ───────────────────────────────────
+
+    function broadcastOp(docId: string, version: number, op: Op): void {
+      if (!wss) return;
+      const msg: ServerMessage = { type: 'op', version, op };
+      const raw = JSON.stringify(msg);
+
+      wss.clients.forEach((client) => {
+        if (
+          client.readyState === WebSocket.OPEN &&
+          (client as unknown as Record<string, unknown>)._docId === docId
+        ) {
+          client.send(raw);
+        }
+      });
+    }
+  }
+
+  // ── Server lifecycle ─────────────────────────────────────
+
+  return {
+    app,
+    async start(port?: number): Promise<number> {
+      return new Promise((resolve, reject) => {
+        try {
+          httpServer = createServer(app);
+          setupWebSocket(httpServer);
+          httpServer.listen(port ?? 0, () => {
+            const addr = httpServer!.address();
+            const actualPort =
+              typeof addr === 'string' ? parseInt(addr, 10) : addr!.port;
+            resolve(actualPort);
+          });
+        } catch (err) {
+          reject(err);
+        }
+      });
+    },
+    async stop(): Promise<void> {
+      // Close all WebSocket connections
+      if (wss) {
+        wss.clients.forEach((client) => {
+          client.close(1001, 'Server shutting down');
+        });
+        wss.close();
+        wss = null;
+      }
+
+      // Close HTTP server
+      if (httpServer) {
+        return new Promise((resolve) => {
+          httpServer!.close(() => {
+            httpServer = null;
+            db.close();
+            resolve();
+          });
+        });
+      }
+
+      db.close();
+    },
+  };
+}
+
+// ── Helpers ────────────────────────────────────────────────
+
+function sendError(ws: WebSocket, message: string): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify({ type: 'error', message } satisfies ServerMessage));
+  }
+}
+
+function isValidOp(op: unknown): op is Op {
+  if (!op || typeof op !== 'object') return false;
+  const o = op as Record<string, unknown>;
+  if (o.type !== 'insert' && o.type !== 'delete') return false;
+  if (typeof o.pos !== 'number' || !Number.isInteger(o.pos) || o.pos < 0)
+    return false;
+
+  if (o.type === 'insert') {
+    return typeof o.text === 'string' && o.text.length > 0;
+  }
+
+  return (
+    typeof o.length === 'number' &&
+    Number.isInteger(o.length) &&
+    o.length > 0
+  );
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..da61158
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,68 @@
+// ── Operations ──────────────────────────────────────────────
+
+export type InsertOp = {
+  type: 'insert';
+  pos: number;
+  text: string;
+};
+
+export type DeleteOp = {
+  type: 'delete';
+  pos: number;
+  length: number;
+};
+
+export type Op = InsertOp | DeleteOp;
+
+// ── Document types ─────────────────────────────────────────
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface VersionEntry {
+  id: number;
+  documentId: string;
+  version: number;
+  content: string;
+  operation: string | null; // JSON-serialized Op
+  createdAt: string;
+}
+
+// ── WebSocket protocol messages ────────────────────────────
+
+export interface InitMessage {
+  type: 'init';
+  docId: string;
+  content: string;
+  version: number;
+}
+
+export interface OpMessage {
+  type: 'op';
+  version: number;
+  op: Op;
+}
+
+export interface ErrorMessage {
+  type: 'error';
+  message: string;
+}
+
+/** Client-to-server incoming message */
+export type ClientMessage = OpMessage;
+
+/** Server-to-client outgoing message */
+export type ServerMessage = InitMessage | OpMessage | ErrorMessage;
+
+// ── App factory return type ────────────────────────────────
+
+export interface CollabServer {
+  app: import('express').Express;
+  start: (port?: number) => Promise<number>;
+  stop: () => Promise<void>;
+}
