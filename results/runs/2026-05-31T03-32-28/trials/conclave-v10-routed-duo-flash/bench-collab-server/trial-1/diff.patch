w();\n  });\n});\n\n// ── transform ──────────────────────────────────────────────\n\ndescribe('transform', () => {\n  // Insert vs Insert\n  it('insert before another insert: no shift needed', () => {\n    const result = transform(insert(0, 'A'), insert(3, 'B'));\n    expect(result).toEqual(insert(0, 'A'));\n  });\n\n  it('insert after another insert: shift right by first length', () => {\n    const result = transform(insert(3, 'A'), insert(1, 'BB'));\n    expect(result).toEqual(insert(5, 'A')); // 3 + 2 = 5\n  });\n\n  it('insert at same position: lexicographic tie-breaker (first)', () => {\n    // \"A\" < \"B\" so op1 goes first, no shift\n    const result = transform(insert(2, 'A'), insert(2, 'B'));\n    expect(result).toEqual(insert(2, 'A'));\n  });\n\n  it('insert at same position: lexicographic tie-breaker (second)', () => {\n    // \"Z\" > \"A\" so op2 goes first, shift op1 right\n    const result = transform(insert(2, 'Z'), insert(2, 'A'));\n    expect(result).toEqual(insert(3, 'Z'));\n  });\n\n  // Insert vs Delete\n  it('insert before delete: no shift', () => {\n    const result = transform(insert(0, 'X'), del(1, 2));\n    expect(result).toEqual(insert(0, 'X'));\n  });\n\n  it('insert after delete: shift left', () => {\n    const result = transform(insert(5, 'X'), del(1, 2));\n    expect(result).toEqual(insert(3, 'X'));\n  });\n\n  it('insert inside deleted range: move to deletion point', () => {\n    const result = transform(insert(3, 'X'), del(2, 4));\n    expect(result).toEqual(insert(2, 'X'));\n  });\n\n  // Delete vs Insert\n  it('delete before insert: no shift', () => {\n    const result = transform(del(0, 2), insert(5, 'X'));\n    expect(result).toEqual(del(0, 2));\n  });\n\n  it('delete after insert: shift right', () => {\n    const result = transform(del(3, 2), insert(1, 'XX'));\n    expect(result).toEqual(del(5, 2)); // 3 + 2 = 5\n  });\n\n  // Delete vs Delete\n  it('delete entirely before other delete: no shift', () => {\n    const result = transform(del(0, 2), del(3, 2));\n    expect(result).toEqual(del(0, 2));\n  });\n\n  it('delete entirely after other delete: shift left', () => {\n    const result = transform(del(4, 2), del(1, 2));\n    expect(result).toEqual(del(2, 2)); // 4 - 2 = 2\n  });\n\n  it('delete overlapping at end: trim length', () => {\n    // op1 deletes \"bc\" (pos 1, len 2), op2 deletes \"bcd\" (pos 1, len 3)\n    // op1's \"c\" is in the overlap, so only \"b\" survives\n    const result = transform(del(1, 2), del(1, 3));\n    expect(result).toEqual(del(1, 1)); // overlap trimmed\n  });\n\n  it('delete overlapping at start: shift position and trim', () => {\n    // op1 deletes \"cde\" (pos 2, len 3), op2 deletes \"bcd\" (pos 1, len 3)\n    // overlap is \"cd\" (pos 2-3 in original), op1 extends past overlap to \"e\"\n    const result = transform(del(2, 3), del(1, 3));\n    expect(result).toEqual(del(1, 1)); // only \"e\" survives, shifted to position 1\n  });\n\n  it('delete entirely within other delete: becomes null', () => {\n    const result = transform(del(2, 1), del(1, 3));\n    expect(result).toBeNull();\n  });\n\n  it('concurrent inserts at same position with same text: deterministic', () => {\n    // With the tie-breaker, one goes first, the other shifts\n    const r1 = transform(insert(0, 'a'), insert(0, 'a'));\n    const r2 = transform(insert(0, 'a'), insert(0, 'a'));\n    // Both should produce the same result regardless of ordering\n    expect(r1).toEqual(r2);\n  });\n});\n\n// ── Convergence property: A;B' == B;A' ────────────────────\n\ndescribe('OT convergence', () => {\n  function applyBoth(content: string, op1: Op, op2: Op): { via12: string; via21: string } {\n    // Apply op1 then transformed op2\n    const op2prime = transform(op2, op1);\n    const step1 = apply(content, op1);\n    const via12 = op2prime ? apply(step1, op2prime) : step1;\n\n    // Apply op2 then transformed op1\n    const op1prime = transform(op1, op2);\n    const step2 = apply(content, op2);\n    const via21 = op1prime ? apply(step2, op1prime) : step2;\n\n    return { via12, via21 };\n  }\n\n  it('two concurrent inserts converge', () => {\n    const { via12, via21 } = applyBoth('hello', insert(2, 'XY'), insert(0, 'Z'));\n    expect(via12).toBe(via21);\n    // Both insertions must be present\n    expect(via12).toContain('XY');\n    expect(via12).toContain('Z');\n  });\n\n  it('two concurrent deletes converge', () => {\n    const { via12, via21 } = applyBoth('hello world', del(0, 5), del(6, 5));\n    expect(via12).toBe(via21);\n  });\n\n  it('insert and delete converge', () => {\n    const { via12, via21 } = applyBoth('abcde', insert(2, 'XYZ'), del(0, 2));\n    expect(via12).toBe(via21);\n    // The insert should still be present\n    expect(via12).toContain('XYZ');\n  });\n\n  it('three concurrent operations all converge', () => {\n    // Still converge with 3 ops\n    const { via12, via21 } = applyBoth('test', insert(0, 'A'), insert(2, 'B'));\n    expect(via12).toBe(via21);\n\n    const r2 = applyBoth('test', del(0, 2), insert(0, 'X'));\n    expect(r2.via12).toBe(r2.via21);\n  });\n\n  it('concurrent edits on same document preserve all content', () => {\n    const content = 'hello';\n    // A inserts at pos 0, B inserts at pos 5 — both should be present\n    const { via12, via21 } = applyBoth(content, insert(0, 'A:'), insert(5, ':B'));\n    expect(via12).toBe(via21);\n    expect(via12).toBe('A:hello:B');\n  });\n\n  it('overlapping deletes preserve non-deleted content', () => {\n    const content = 'abcdefgh';\n    // A deletes \"bcd\" (1,3), B deletes \"ef\" (4,2)\n    const { via12, via21 } = applyBoth(content, del(1, 3), del(4, 2));\n    expect(via12).toBe(via21);\n    expect(via12).toBe('agh');\n  });\n\n  it('insert at same position: both preserved', () => {\n    const content = '[]';\n    const { via12, via21 } = applyBoth(content, insert(1, 'A'), insert(1, 'B'));\n    expect(via12).toBe(via21);\n    expect(via12.length).toBe(4); // '[', 'A', 'B', ']'\n 