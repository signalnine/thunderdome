os) || o.pos < 0)\n    return false;\n\n  if (o.type === 'insert') {\n    return typeof o.text === 'string' && o.text.length > 0;\n  }\n\n  return (\n    typeof o.length === 'number' &&\n    Number.isInteger(o.length) &&\n    o.length > 0\n  );\n}\n","structuredPatch":[{"oldStart":237,"oldLines":7,"newStart":237,"newLines":7,"lines":["       wss.clients.forEach((client) => {","         if (","           client.readyState === WebSocket.OPEN &&","-          (client as Record<string, unknown>)._docId === docId","+          (client as unknown as Record<string, unknown>)._docId === docId","         ) {","           client.send(raw);","         }"]}],"userModified":false,"replaceAll":false}}
