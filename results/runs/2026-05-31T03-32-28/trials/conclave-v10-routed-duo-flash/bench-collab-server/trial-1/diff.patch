--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,293 @@
+import Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+import type { Document, VersionEntry, Op } from './types.js';
+
+export class DocDatabase {
+  private db: Database.Database;
+
+  constructor(dbPath?: string) {
+    this.db = new Database(dbPath ?? ':memory:');
+    this.db.pragma('journal_mode = WAL');
+    this.db.pragma('foreign_keys = ON');
+    this.initSchema();
+  }
+
+  private initSchema(): void {
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS documents (
+        id TEXT PRIMARY KEY,
+        title TEXT NOT NULL,
+        content TEXT NOT NULL DEFAULT '',
+        created_at TEXT NOT NULL DEFAULT (datetime('now')),
+        updated_at TEXT NOT NULL DEFAULT (datetime('now'))
+      );
+
+      CREATE TABLE IF NOT EXISTS versions (
+        id INTEGER PRIMARY KEY AUTOINCREMENT,
+        document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+        version INTEGER NOT NULL,
+        content TEXT NOT NULL,
+        operation TEXT,
+        created_at TEXT NOT NULL DEFAULT (datetime('now')),
+        UNIQUE(document_id, version)
+      );
+    `);
+  }
+
+  // ── Documents ────────────────────────────────────────────
+
+  createDocument(title: string): Document {
+    const id = randomUUID();
+    const now = new Date().toISOString();
+
+    const stmt = this.db.prepare(`
+      INSERT INTO documents (id, title, content, created_at, updated_at)
+      VALUES (?, ?, '', ?, ?)
+    `);
+    stmt.run(id, title, now, now);
+
+    // Create initial version (version 1)
+    const versionStmt = this.db.prepare(`
+      INSERT INTO versions (document_id, version, content, operation, created_at)
+      VALUES (?, 1, '', NULL, ?)
+    `);
+    versionStmt.run(id, now);
+
+    return { id, title, content: '', createdAt: now, updatedAt: now };
+  }
+
+  listDocuments(): Document[] {
+    const rows = this.db
+      .prepare(
+        `SELECT id, title, content, created_at, updated_at FROM documents ORDER BY created_at DESC`,
+      )
+      .all() as Array<{
+      id: string;
+      title: string;
+      content: string;
+      created_at: string;
+      updated_at: string;
+    }>;
+
+    return rows.map(mapRowToDocument);
+  }
+
+  getDocument(id: string): Document | null {
+    const row = this.db
+      .prepare(
+        `SELECT id, title, content, created_at, updated_at FROM documents WHERE id = ?`,
+      )
+      .get(id) as
+      | { id: string; title: string; content: string; created_at: string; updated_at: string }
+      | undefined;
+
+    if (!row) return null;
+
+    // Also record this as an active connection
+    this.recordConnection(id);
+
+    return mapRowToDocument(row);
+  }
+
+  updateDocument(
+    id: string,
+    fields: { title?: string; content?: string },
+  ): { document: Document; version: number } | null {
+    const existing = this.getDocument(id);
+    if (!existing) return null;
+
+    const newTitle = fields.title ?? existing.title;
+    const newContent = fields.content ?? existing.content;
+    const now = new Date().toISOString();
+
+    // Get the current latest version
+    const latestVersion = this.db
+      .prepare(
+        `SELECT MAX(version) as maxVer FROM versions WHERE document_id = ?`,
+      )
+      .get(id) as { maxVer: number | null };
+
+    const nextVersion = (latestVersion?.maxVer ?? 0) + 1;
+
+    const updateDoc = this.db.prepare(`
+      UPDATE documents SET title = ?, content = ?, updated_at = ? WHERE id = ?
+    `);
+
+    const insertVersion = this.db.prepare(`
+      INSERT INTO versions (document_id, version, content, operation, created_at)
+      VALUES (?, ?, ?, ?, ?)
+    `);
+
+    const txn = this.db.transaction(() => {
+      updateDoc.run(newTitle, newContent, now, id);
+      insertVersion.run(
+        id,
+        nextVersion,
+        newContent,
+        JSON.stringify({
+          type: 'update',
+          title: fields.title ?? undefined,
+          content: fields.content ?? undefined,
+        }),
+        now,
+      );
+    });
+
+    txn();
+
+    return {
+      document: {
+        id,
+        title: newTitle,
+        content: newContent,
+        createdAt: existing.createdAt,
+        updatedAt: now,
+      },
+      version: nextVersion,
+    };
+  }
+
+  deleteDocument(id: string): boolean {
+    const existing = this.getDocument(id);
+    if (!existing) return false;
+
+    this.db.prepare(`DELETE FROM documents WHERE id = ?`).run(id);
+    return true;
+  }
+
+  // ── Versions ─────────────────────────────────────────────
+
+  getVersions(documentId: string): VersionEntry[] {
+    const rows = this.db
+      .prepare(
+        `SELECT id, document_id, version, content, operation, created_at
+         FROM versions WHERE document_id = ? ORDER BY version ASC`,
+      )
+      .all(documentId) as Array<{
+      id: number;
+      document_id: string;
+      version: number;
+      content: string;
+      operation: string | null;
+      created_at: string;
+    }>;
+
+    return rows.map((r) => ({
+      id: r.id,
+      documentId: r.document_id,
+      version: r.version,
+      content: r.content,
+      operation: r.operation,
+      createdAt: r.created_at,
+    }));
+  }
+
+  getOperationsSince(
+    documentId: string,
+    fromVersion: number,
+  ): Array<{ version: number; operation: Op }> {
+    const rows = this.db
+      .prepare(
+        `SELECT version, operation FROM versions
+         WHERE document_id = ? AND version > ? AND operation IS NOT NULL
+         ORDER BY version ASC`,
+      )
+      .all(documentId, fromVersion) as Array<{
+      version: number;
+      operation: string;
+    }>;
+
+    return rows
+      .filter((r) => r.operation !== null)
+      .map((r) => ({
+        version: r.version,
+        operation: JSON.parse(r.operation) as Op,
+      }));
+  }
+
+  /**
+   * Apply an operation to the document and record the new version.
+   * Returns the new document state.
+   */
+  applyOperation(
+    docId: string,
+    op: Op,
+    newContent: string,
+  ): { version: number } | null {
+    const existing = this.getDocument(docId);
+    if (!existing) return null;
+
+    const now = new Date().toISOString();
+
+    const latestVersion = this.db
+      .prepare(
+        `SELECT MAX(version) as maxVer FROM versions WHERE document_id = ?`,
+      )
+      .get(docId) as { maxVer: number | null };
+
+    const nextVersion = (latestVersion?.maxVer ?? 0) + 1;
+
+    const txn = this.db.transaction(() => {
+      this.db
+        .prepare(`UPDATE documents SET content = ?, updated_at = ? WHERE id = ?`)
+        .run(newContent, now, docId);
+
+      this.db
+        .prepare(
+          `INSERT INTO versions (document_id, version, content, operation, created_at)
+           VALUES (?, ?, ?, ?, ?)`,
+        )
+        .run(docId, nextVersion, newContent, JSON.stringify(op), now);
+    });
+
+    txn();
+    return { version: nextVersion };
+  }
+
+  getVersionOrThrow(docId: string): number {
+    const row = this.db
+      .prepare(
+        `SELECT MAX(version) as maxVer FROM versions WHERE document_id = ?`,
+      )
+      .get(docId) as { maxVer: number | null };
+    return row?.maxVer ?? 0;
+  }
+
+  // ── Connection tracking ─────────────────────────────────
+
+  private recordConnection(_docId: string): void {
+    // Tracked for compatibility with schema, no-op for now
+  }
+
+  // ── Cleanup ──────────────────────────────────────────────
+
+  close(): void {
+    this.db.close();
+  }
+}
+
+// ── Helpers ────────────────────────────────────────────────
+
+function mapRowToDocument(row: {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}): Document {
+  return {
+    id: row.id,
+    title: row.title,
+    content: row.content,
+    createdAt: row.created_at,
+    updatedAt: row.updated_at,
+  };
+}
+
+/**
+ * Escape SQL identifier — wraps in double-quotes, doubling any embedded quotes.
+ * Only use for dynamic identifiers, never for values.
+ */
+export function escId(id: string): string {
+  return `"${id.replace(/"/g, '""')}"`;
+}
