@@ -0,0 +1,131 @@
+import type { Op, InsertOp, DeleteOp } from './types.js';
+
+/**
+ * Apply an operation to a string, returning the new string.
+ * Throws on invalid positions.
+ */
+export function apply(content: string, op: Op): string {
+  if (op.type === 'insert') {
+    if (op.pos < 0 || op.pos > content.length) {
+      throw new Error(
+        `Insert position ${op.pos} out of bounds [0, ${content.length}]`,
+      );
+    }
+    return content.slice(0, op.pos) + op.text + content.slice(op.pos);
+  }
+
+  // delete
+  if (op.pos < 0 || op.pos + op.length > content.length) {
+    throw new Error(
+      `Delete at ${op.pos}, length ${op.length} out of bounds for content length ${content.length}`,
+    );
+  }
+  return content.slice(0, op.pos) + content.slice(op.pos + op.length);
+}
+
+/**
+ * Transform operation `op1` against operation `op2`.
+ *
+ * Both `op1` and `op2` are assumed to apply to the **same** document state.
+ * Returns a new operation `op1'` such that:
+ *
+ *   apply(apply(state, op2), op1') === apply(apply(state, op1), op2')
+ */
+export function transform(op1: Op, op2: Op): Op | null {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    return transformInsertInsert(op1, op2);
+  }
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    return transformInsertDelete(op1, op2);
+  }
+  if (op1.type === 'delete' && op2.type === 'insert') {
+    return transformDeleteInsert(op1, op2);
+  }
+  // Both must be delete at this point
+  return transformDeleteDelete(op1 as DeleteOp, op2 as DeleteOp);
+}
+
+// ── Private helpers ────────────────────────────────────────
+
+function transformInsertInsert(op1: InsertOp, op2: InsertOp): InsertOp {
+  // When inserts happen at the same position, we use a tie-breaker:
+  // the insert whose text sorts earlier comes first.
+  if (op1.pos < op2.pos || (op1.pos === op2.pos && op1.text < op2.text)) {
+    return { ...op1 };
+  }
+  // op1 must be applied after op2, so shift its position
+  return { ...op1, pos: op1.pos + op2.text.length };
+}
+
+function transformInsertDelete(op1: InsertOp, op2: DeleteOp): InsertOp {
+  const dEnd = op2.pos + op2.length;
+
+  if (op1.pos <= op2.pos) {
+    // Insert is entirely before the deleted range — no shift
+    return { ...op1 };
+  }
+  if (op1.pos >= dEnd) {
+    // Insert is entirely after the deleted range — shift left
+    return { ...op1, pos: op1.pos - op2.length };
+  }
+  // Insert is **inside** the deleted range — move to the deletion start
+  return { ...op1, pos: op2.pos };
+}
+
+function transformDeleteInsert(op1: DeleteOp, op2: InsertOp): DeleteOp {
+  if (op1.pos < op2.pos) {
+    // Delete is entirely before the insert — no shift
+    return { ...op1 };
+  }
+  // Delete is at or after the insert — shift right
+  return { ...op1, pos: op1.pos + op2.text.length };
+}
+
+function transformDeleteDelete(op1: DeleteOp, op2: DeleteOp): DeleteOp | null {
+  const d1Start = op1.pos;
+  const d1End = op1.pos + op1.length;
+  const d2Start = op2.pos;
+  const d2End = op2.pos + op2.length;
+
+  // op1 is entirely before op2 — no shift
+  if (d1End <= d2Start) {
+    return { ...op1 };
+  }
+  // op1 is entirely after op2 — shift left
+  if (d1Start >= d2End) {
+    return { ...op1, pos: op1.pos - op2.length };
+  }
+
+  // Partial overlap
+  const overlapStart = Math.max(d1Start, d2Start);
+  const overlapEnd = Math.min(d1End, d2End);
+  const overlapLen = Math.max(0, overlapEnd - overlapStart);
+
+  // op1 overlaps at the end (op1 starts before op2 but extends into op2's range)
+  if (d1Start < d2Start) {
+    // Only the non-overlapping prefix survives
+    return { ...op1, length: op1.length - overlapLen };
+  }
+
+  // op1 overlaps at the start (op1 starts within op2's range but extends beyond)
+  if (d1End > d2End) {
+    const newPos = d2Start;
+    const newLen = op1.length - overlapLen;
+    return { pos: newPos, length: newLen, type: 'delete' };
+  }
+
+  // op1 is entirely within op2's range — becomes a no-op
+  return null;
+}
+
+/**
+ * Compose two operations that were applied sequentially.
+ * Returns a single operation that has the same net effect as applying
+ * `first` then `second`.
+ */
+export function compose(first: Op, second: Op): Op {
+  // Return the second operation transformed against the first.
+  // If the second became a no-op, the net effect is just `first`.
+  const transformed = transform(second, first);
+  return transformed ?? first;
+}
