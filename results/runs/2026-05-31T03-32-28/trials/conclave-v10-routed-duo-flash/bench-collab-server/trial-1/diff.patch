ocuments')\n      .expect(200);\n\n    expect(Array.isArray(res.body)).toBe(true);\n    expect(res.body.length).toBe(2);\n  });\n\n  it('gets a document by ID via GET /documents/:id', async () => {\n    const created = await request(server.app)\n      .post('/documents')\n      .send({ title: 'Test' });\n\n    const res = await request(server.app)\n      .get(`/documents/${created.body.id}`)\n      .expect(200);\n\n    expect(res.body.id).toBe(created.body.id);\n    expect(res.body.title).toBe('Test');\n  });\n\n  it('returns 404 for unknown doc via GET /documents/:id', async () => {\n    await request(server.app)\n      .get('/documents/nonexistent-id')\n      .expect(404);\n  });\n\n  it('updates a document via PUT /documents/:id', async () => {\n    const created = await request(server.app)\n      .post('/documents')\n      .send({ title: 'Original' });\n\n    const res = await request(server.app)\n      .put(`/documents/${created.body.id}`)\n      .send({ title: 'Updated', content: 'Hello World' })\n      .expect(200);\n\n    expect(res.body.title).toBe('Updated');\n    expect(res.body.content).toBe('Hello World');\n    expect(res.body.updatedAt).not.toBe(created.body.updatedAt);\n  });\n\n  it('updates only title via PUT /documents/:id', async () => {\n    const created = await request(server.app)\n      .post('/documents')\n      .send({ title: 'Original' });\n\n    const res = await request(server.app)\n      .put(`/documents/${created.body.id}`)\n      .send({ title: 'Only Title' })\n      .expect(200);\n\n    expect(res.body.title).toBe('Only Title');\n    expect(res.body.content).toBe('');\n  });\n\n  it('deletes a document via DELETE /documents/:id', async () => {\n    const created = await request(server.app)\n      .post('/documents')\n      .send({ title: 'Delete Me' });\n\n    await request(server.app)\n      .delete(`/documents/${created.body.id}`)\n      .expect(204);\n\n    await request(server.app)\n      .get(`/documents/${created.body.id}`)\n      .expect(404);\n  });\n\n  it('returns 404 for deleting unknown doc', async () => {\n    await request(server.app)\n      .delete('/documents/nonexistent')\n      .expect(404);\n  });\n\n  // ── Versions ───────────────────────────────────────────\n\n  it('creates version history on document creation', async () => {\n    const created = await request(server.app)\n      .post('/documents')\n      .send({ title: 'Versions' });\n\n    const res = await request(server.app)\n      .get(`/documents/${created.body.id}/versions`)\n      .expect(200);\n\n    expect(Array.isArray(res.body)).toBe(true);\n    expect(res.body.length).toBe(1);\n    expect(res.body[0].version).toBe(1);\n    expect(res.body[0].content).toBe('');\n  });\n\n  it('adds version entries on update', async () => {\n    const created = await request(server.app)\n      .post('/documents')\n      .send({ title: 'Versions' });\n\n    await request(server.app)\n      .put(`/documents/${created.body.id}`)\n      .send({ content: 'V2' });\n\n    const res = await request(server.app)\n      .get(`/documents/${created.body.id}/versions`)\n      .expect(200);\n\n    expect(res.body.length).toBe(2);\n    expect(res.body[0].version).toBe(1);\n    expect(res.body[1].version).toBe(2);\n    expect(res.body[1].content).toBe('V2');\n  });\n\n  it('returns 404 for versions of unknown doc', async () => {\n    await request(server.app)\n      .get('/documents/nonexistent/versions')\n      .expect(404);\n  });\n});\n\n// ── WebSocket ──────────────────────────────────────────────\n\ndescribe('WebSocket', () => {\n  let server: CollabServer;\n  let port: number;\n  let docId: string;\n\n  beforeEach(async () => {\n    server = createApp();\n    port = await server.start(0);\n\n    const res = await request(server.app)\n      .post('/documents')\n      .send({ title: 'Collab' });\n    docId = res.body.id;\n  });\n\n  afterEach(async () => {\n    await server.stop();\n  });\n\n  it('connects and receives init message', async () => {\n    const ws = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n\n    const msg = await new Promise<any>((resolve, reject) => {\n      ws.on('message', (data) => {\n        try {\n          resolve(JSON.parse(data.toString()));\n        } catch (e) {\n          reject(e);\n        }\n        ws.close();\n      });\n      ws.on('error', reject);\n    });\n\n    expect(msg.type).toBe('init');\n    expect(msg.docId).toBe(docId);\n    expect(msg.content).toBe('');\n    expect(typeof msg.version).toBe('number');\n  });\n\n  it('rejects connection to unknown document', async () => {\n    const ws = new WebSocket(`ws://localhost:${port}/ws/nonexistent`);\n\n    const close = await new Promise<any>((resolve) => {\n      ws.on('close', (code, reason) => {\n        resolve({ code, reason: reason.toString() });\n      });\n    });\n\n    expect(close.code).toBe(4004);\n  });\n\n  it('returns error for invalid WebSocket path', async () => {\n    const ws = new WebSocket(`ws://localhost:${port}/badpath`);\n\n    const close = await new Promise<any>((resolve) => {\n      ws.on('close', (code) => resolve(code));\n    });\n\n    expect(close).toBe(4000);\n  });\n\n  it('broadcasts operations to other clients on same document', async () => {\n    const ws1 = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    await waitForMessage(ws1); // wait for init\n\n    const ws2 = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    await waitForMessage(ws2); // wait for init\n\n    // Send an insert from ws1\n    ws1.send(JSON.stringify({\n      type: 'op',\n      version: 1,\n      op: { type: 'insert', pos: 0, text: 'Hello' },\n    }));\n\n    // ws2 should receive the broadcast\n    const msg2 = await waitForMessage(ws2);\n    expect(msg2.type).toBe('op');\n    expect(msg2.op.type).toBe('insert');\n    expect(msg2.op.text).toBe('Hello');\n\n    ws1.close();\n    ws2.close();\n  });\n\n  it('sender also receives the broadcast', async () => {\n    const ws = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    await waitForMessage(ws); // init\n\n    // Wait a tick to ensure subscription is ready\n    await sleep(50);\n\n    ws.send(JSON.stringify({\n      type: 'op',\n      version: 1,\n      op: { type: 'insert', pos: 0, text: 'Hi' },\n    }));\n\n    // Sender should also get the broadcast\n    const msg = await waitForMessage(ws);\n    expect(msg.type).toBe('op');\n    expect(msg.op.text).toBe('Hi');\n\n    ws.close();\n  });\n\n  it('rejects invalid JSON', async () => {\n    const ws = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    await waitForMessage(ws); // init\n\n    ws.send('not json');\n\n    const msg = await waitForMessage(ws);\n    expect(msg.type).toBe('error');\n\n    ws.close();\n  });\n\n  it('rejects operations with negative position', async () => {\n    const ws = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    await waitForMessage(ws); // init\n\n    ws.send(JSON.stringify({\n      type: 'op',\n      version: 1,\n      op: { type: 'insert', pos: -1, text: 'x' },\n    }));\n\n    const msg = await waitForMessage(ws);\n    expect(msg.type).toBe('error');\n\n    ws.close();\n  });\n\n  it('rejects delete past end of content', async () => {\n    const ws = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    await waitForMessage(ws); // init\n\n    ws.send(JSON.stringify({\n      type: 'op',\n      version: 1,\n      op: { type: 'delete', pos: 0, length: 100 },\n    }));\n\n    const msg = await waitForMessage(ws);\n    expect(msg.type).toBe('error');\n\n    ws.close();\n  });\n\n  it('rejects insert with empty text', async () => {\n    const ws = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    await waitForMessage(ws);\n\n    ws.send(JSON.stringify({\n      type: 'op',\n      version: 1,\n      op: { type: 'insert', pos: 0, text: '' },\n    }));\n\n    const msg = await waitForMessage(ws);\n    expect(msg.type).toBe('error');\n    ws.close();\n  });\n\n  it('rejects delete with zero length', async () => {\n    const ws = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    await waitForMessage(ws);\n\n    ws.send(JSON.stringify({\n      type: 'op',\n      version: 1,\n      op: { type: 'delete', pos: 0, length: 0 },\n    }));\n\n    const msg = await waitForMessage(ws);\n    expect(msg.type).toBe('error');\n    ws.close();\n  });\n\n  it('handles rapid operations without crashing', async () => {\n    const ws = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    await waitForMessage(ws); // init\n\n    // Set up a persistent listener that pushes to an array\n    const messages: any[] = [];\n    ws.on('message', (data) => {\n      try {\n        messages.push(JSON.parse(data.toString()));\n      } catch {\n        // ignore parse errors\n      }\n    });\n\n    // Send 20 ops in rapid succession\n    for (let i = 0; i < 20; i++) {\n      ws.send(JSON.stringify({\n        type: 'op',\n        version: 1 + i,\n        op: { type: 'insert', pos: i, text: String.fromCharCode(65 + i) },\n      }));\n    }\n\n    // Wait for all broadcasts\n    const deadline = Date.now() + 8000;\n    while (messages.length < 20 && Date.now() < deadline) {\n      await sleep(100);\n    }\n\n    expect(messages.length).toBe(20);\n    expect(messages.every((m: any) => m.type === 'op')).toBe(true);\n\n    // Check the doc content via REST\n    const res = await request(server.app)\n      .get(`/documents/${docId}`)\n      .expect(200);\n\n    // 20 characters were inserted\n    expect(res.body.content.length).toBe(20);\n\n    ws.close();\n  });\n\n  it('client disconnect does not affect other clients', async () => {\n    const ws1 = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    await waitForMessage(ws1); // init\n\n    const ws2 = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    await waitForMessage(ws2); // init\n\n    // Insert some text from ws1 first (so ws2 has content > version 1)\n    ws1.send(JSON.stringify({\n      type: 'op', version: 1,\n      op: { type: 'insert', pos: 0, text: 'Base ' },\n    }));\n    await waitForMessage(ws1); // broadcast to ws1\n    await waitForMessage(ws2); // broadcast to ws2\n\n    // Close ws1\n    ws1.close();\n    await sleep(100);\n\n    // ws2 should still work\n    ws2.send(JSON.stringify({\n      type: 'op', version: 2,\n      op: { type: 'insert', pos: 5, text: 'content' },\n    }));\n\n    const msg = await waitForMessage(ws2);\n    expect(msg.type).toBe('op');\n\n    ws2.close();\n  });\n});\n\n// ── Concurrent editing ─────────────────────────────────────\n\ndescribe('Concurrent editing', () => {\n  it('two clients editing same document: both edits preserved', async () => {\n    const server = createApp();\n    const port = await server.start(0);\n\n    // Create a document with some initial content\n    const res = await request(server.app)\n      .post('/documents')\n      .send({ title: 'Concurrent' });\n    const docId = res.body.id;\n\n    // Insert base content via REST\n    await request(server.app)\n      .put(`/documents/${docId}`)\n      .send({ content: 'hello' });\n\n    // Connect two WebSocket clients\n    const wsA = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n    const wsB = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n\n    // Wait for both init messages\n    await Promise.all([waitForMessage(wsA), waitForMessage(wsB)]);\n\n    // Set up persistent listeners for both clients\n    const msgsA: any[] = [];\n    const msgsB: any[] = [];\n    wsA.on('message', (d: any) => { try { msgsA.push(JSON.parse(d.toString())); } catch {} });\n    wsB.on('message', (d: any) => { try { msgsB.push(JSON.parse(d.toString())); } catch {} });\n\n    await sleep(200);\n\n    // Both clients send operations concurrently\n    wsA.send(JSON.stringify({ type: 'op', version: 2, op: { type: 'insert', pos: 0, text: 'A-' } }));\n    wsB.send(JSON.stringify({ type: 'op', version: 2, op: { type: 'insert', pos: 7, text: '-B' } }));\n\n    // Wait for operations to propagate\n    await sleep(1000);\n\n    const doc = await request(server.app)\n      .get(`/documents/${docId}`);\n\n    const content = doc.body.content;\n    expect(content).toContain('A-');\n    expect(content).toContain('-B');\n\n    wsA.close();\n    wsB.close();\n    await server.stop();\n  });\n\n  it('three clients converge to same document state', async () => {\n    const server = createApp();\n    const port = await server.start(0);\n\n    const res = await request(server.app)\n      .post('/documents')\n      .send({ title: 'Three-way' });\n    const docId = res.body.id;\n\n    // Connect three clients\n    const clients = await Promise.all(\n      [1, 2, 3].map(async () => {\n        const ws = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n        await waitForMessage(ws);\n        return ws;\n      }),\n    );\n\n    await sleep(100);\n\n    // Each client sends 5 inserts at various positions\n    const inserts = [\n      [{ pos: 0, text: 'a' }, { pos: 1, text: 'b' }, { pos: 2, text: 'c' }],\n      [{ pos: 0, text: 'x' }, { pos: 1, text: 'y' }, { pos: 2, text: 'z' }],\n      [{ pos: 0, text: '1' }, { pos: 1, text: '2' }, { pos: 2, text: '3' }],\n    ];\n\n    for (let round = 0; round < 3; round++) {\n      const version = 1 + round * 3;\n      for (let c = 0; c < 3; c++) {\n        const client = clients[c];\n        const op = inserts[c][round];\n        client.send(JSON.stringify({\n          type: 'op',\n          version: version,\n          op: { type: 'insert', pos: op.pos, text: op.text },\n        }));\n      }\n      await sleep(200);\n    }\n\n    // Let everything settle\n    await sleep(500);\n\n    // Check final state via REST\n    const doc = await request(server.app)\n      .get(`/documents/${docId}`);\n    const content = doc.body.content;\n\n    // All 9 characters should be present\n    expect(content.length).toBe(9);\n    for (const text of ['a', 'b', 'c', 'x', 'y', 'z', '1', '2', '3']) {\n      expect(content).toContain(text);\n    }\n\n    clients.forEach((c) => c.close());\n    await server.stop();\n  });\n\n  it('10 concurrent clients converge without corruption', async () => {\n    const server = createApp();\n    const port = await server.start(0);\n\n    const res = await request(server.app)\n      .post('/documents')\n      .send({ title: '10-client stress test' });\n    const docId = res.body.id;\n\n    // Connect 10 clients\n    const clients: WebSocket[] = [];\n    for (let i = 0; i < 10; i++) {\n      const ws = new WebSocket(`ws://localhost:${port}/ws/${docId}`);\n      await waitForMessage(ws);\n      clients.push(ws);\n    }\n\n    await sleep(200);\n\n    // Each client sends 10 sequential insert operations\n    const totalOps = 100;\n    for (let i = 0; i < 10; i++) {\n      for (let c = 0; c < 10; c++) {\n        const version = 1 + i * 10 + c;\n        const client = clients[c];\n        const char = String.fromCharCode(65 + c); // A-J\n        client.send(JSON.stringify({\n          type: 'op',\n          version,\n          op: { type: 'insert', pos: i * 10 + c, text: char },\n        }));\n      }\n      await sleep(300);\n    }\n\n    // Let everything settle\n    await sleep(1000);\n\n    // Check final state via REST\n    const doc = await request(server.app)\n      .get(`/documents/${docId}`);\n    const content = doc.body.content;\n\n    // All 100 characters present\n    expect(content.length).toBe(totalOps);\n\n    // Verify no corruption via version history\n    const versionsRes = await request(server.app)\n      .get(`/documents/${docId}/versions`);\n    const versions = versionsRes.body;\n\n    // The latest version should match the current content\n    const latestVersion = versions[versions.length - 1];\n    expect(latestVersion.content).toBe(content);\n\n    clients.forEach((c) => c.close());\n    await server.stop();\n  });\n});\n\n// ── Persistence ────────────────────────────────────────────\n\ndescribe('Persistence', () => {\n  it('documents persist across server restarts', async () => {\n    const dbPath = `/tmp/test-collab-${Date.now()}.db`;\n\n    // Create and stop\n    const server1 = createApp(dbPath);\n    const port1 = await server1.start(0);\n\n    const res = await request(server1.app)\n      .post('/documents')\n      .send({ title: 'Persist Test' });\n    const docId = res.body.id;\n\n    await request(server1.app)\n      .put(`/documents/${docId}`)\n      .send({ content: 'Persisted content' });\n\n    await server1.stop();\n\n    // Re-create with same DB\n    const server2 = createApp(dbPath);\n    const port2 = await server2.start(0);\n\n    const res2 = await request(server2.app)\n      .get(`/documents/${docId}`)\n      .expect(200);\n\n    expect(res2.body.title).toBe('Persist Test');\n    expect(res2.body.content).toBe('Persisted content');\n\n    // Version history also persists\n    const versionsRes = await request(server2.app)\n      .get(`/documents/${docId}/versions`)\n      .expect(200);\n\n    expect(versionsRes.body.length).toBeGreaterThanOrEqual(2);\n\n    await server2.stop();\n\n    // Cleanup\n    try {\n      require('fs').unlinkSync(dbPath);\n    } catch { /* ignore */ }\n  });\n});\n\n// ── Server lifecycle ──────────────────────────────────────\n\ndescribe('Server lifecycle', () => {\n  it('createApp returns expected interface', () => {\n    const s = createApp();\n    expect(s).toHaveProperty('app');\n    expect(s).toHaveProperty('start');\n    expect(s).toHaveProperty('stop');\n    expect(typeof s.start).toBe('function');\n    expect(typeof s.stop).toBe('function');\n  });\n\n  it('start returns a port number', async () => {\n    const s = createApp();\n    const port = await s.start(0);\n    expect(typeof port).toBe('number');\n    expect(port).toBeGreaterThan(0);\n    await s.stop();\n  });\n\n  it('start() without port uses random port', async () => {\n    const s = createApp();\n    const port = await s.start();\n    expect(port).toBeGreaterThan(0);\n    await s.stop();\n  });\n\n  it('stop on fresh server does not throw', async () => {\n    const s = createApp();\n    await expect(s.stop()).resolves.not.toThrow();\n  });\n\n  it('stop stops the server from listening', async () => {\n    const s = createApp();\n    await s.start(0);\n    await s.stop();\n\n    // Should not be listening anymore\n    const s2 = createApp();\n    const port2 = await s2.start(0);\n\n    await expect(\n      request(s2.app).get(`/documents`),\n    ).resolves.not.toThrow();\n\n    await s2.stop();\n  });\n\n  it('multiple createApp instances coexist', async () => {\n    const s1 = createApp();\n    const s2 = createApp();\n\n    const p1 = await s1.start(0);\n    const p2 = await s2.start(0);\n\n    expect(p1).toBeGreaterThan(0);\n    expect(p2).toBeGreaterThan(0);\n    expect(p1).not.toBe(p2);\n\n    const res1 = await request(s1.app)\n      .post('/documents')\n      .send({ title: 'S1' })\n      .expect(201);\n\n    const res2 = await request(s2.app)\n      .post('/documents')\n      .send({ title: 'S2' })\n      .expect(201);\n\n    expect(res1.body.id).not.toBe(res2.body.id);\n\n    await s1.stop();\n    await s2.stop();\n  });\n});\n\n// ── Helpers ────────────────────────────────────────────────\n\nfunction waitForMessage(ws: WebSocket): Promise<any> {\n  return new Promise((resolve, reject) => {\n    ws.once('message', (data) => {\n      try {\n        resolve(JSON.parse(data.toString()));\n      } catch (e) {\n        reject(e);\n      }\n    });\n    ws.once('error', reject);\n    // Set a timeout to prevent hanging\n    setTimeout(() => reject(new Error('Timeout waiting for message')), 5000);\n  });\n}\n\nfunction sleep(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n","structuredPatch":[{"oldStart":471,"oldLines":9,"newStart":471,"newLines":16,"lines":[" ","     await sleep(200);"," ","-    // Both clients send operations concurrently","-    wsA.send(JSON.str