+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import request from 'supertest';
+import WebSocket from 'ws';
+import { createApp } from '../src/server.js';
+import type { CollabServer } from '../src/types.js';
+
+describe('REST API', () => {
+  let server: CollabServer;
+  let port: number;
+  let baseUrl: string;
+
+  beforeEach(async () => {
+    server = createApp();
+    port = await server.start(0);
+    baseUrl = `http://localhost:${port}`;
+  });
+
+  afterEach(async () => {
+    await server.stop();
+  });
+
+  // ── CRUD ────────────────────────────────────────────────
+
+  it('creates a document via POST /documents', async () => {
+    const res = await request(server.app)
+      .post('/documents')
+      .send({ title: 'My Doc' })
+      .expect(201);
+
+    expect(res.body).toHaveProperty('id');
+    expect(res.body.title).toBe('My Doc');
+    expect(res.body.content).toBe('');
+    expect(res.body).toHaveProperty('createdAt');
+    expect(res.body).toHaveProperty('updatedAt');
+  });
+
+  it('rejects POST /documents without title', async () => {
+    const res = await request(server.app)
+      .post('/documents')
+      .send({})
+      .expect(400);
+
+    expect(res.body.message).toContain('title');
+  });
+
+  it('rejects POST /documents with empty title', async () => {
+    const res = await request(server.app)
+      .post('/documents')
+      .send({ title: '   ' })
+      .expect(400);
+
+    expect(res.body.message).toContain('title');
+  });
+
+  it('lists documents via GET /documents', async () => {
+    await request(server.app)
+      .post('/documents')
+      .send({ title: 'Doc A' });
+
+    await request(server.app)
+      .post('/documents')
+      .send({ title: 'Doc B' });
+
+    const res = await request(server.app)
+      .get('/documents')
+      .expect(200);
+
+    expect(Array.isArray(res.body)).toBe(true);
+    expect(res.body.length).toBe(2);
+  });
+
+  it('gets a document by ID via GET /documents/:id', async () => {
+    const created = await request(server.app)
+      .post('/documents')
+      .send({ title: 'Test' });
+
+    const res = await request(server.app)
+      .get(`/documents/${created.body.id}`)
+      .expect(200);
+
+    expect(res.body.id).toBe(created.body.id);
+    expect(res.body.title).toBe('Test');
+  });
+
+  it('returns 404 for unknown doc via GET /documents/:id', async () => {
+    await request(server.app)
+      .get('/documents/nonexistent-id')
+      .expect(404);
+  });
+
+  it('updates a document via PUT /documents/:id', async () => {
+    const created = await request(server.app)
+      .post('/documents')
+      .send({ title: 'Original' });
+
+    const res = await request(server.app)
+      .put(`/documents/${created.body.id}`)
+      .send({ title: 'Updated', content: 'Hello World' })
+      .expect(200);
+
+    expect(res.body.title).toBe('Updated');
+    expect(res.body.content).toBe('Hello World');
+    expect(res.body.updatedAt).not.toBe(created.body.updatedAt);
+  });
+
+  it('updates only title via PUT /documents/:id', async () => {
+    const created = await request(server.app)
+      .post('/documents')
+      .send({ title: 'Original' });
+
+    const res = await request(server.app)
+      .put(`/documents/${created.body.id}`)
+      .send({ title: 'Only Title' })
+      .expect(200);
+
+    expect(res.body.title).toBe('Only Title');
+    expect(res.body.content).toBe('');
+  });
+
+  it('deletes a document via DELETE /documents/:id', async () => {
+    const created = await request(server.app)
+      .post('/documents')
+      .send({ title: 'Delete Me' });
+
+    await request(server.app)
+      .delete(`/documents/${created.body.id}`)
+      .expect(204);
+
+    await request(server.app)
+      .get(`/documents/${created.body.id}`)
+      .expect(404);
+  });
+
