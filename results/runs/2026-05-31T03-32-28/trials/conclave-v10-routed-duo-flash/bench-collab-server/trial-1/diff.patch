.json(doc);\n50\t  });\n51\t\n52\t  // PUT /documents/:id — update document title/content\n53\t  app.put('/documents/:id', (req, res) => {\n54\t    const { title, content } = req.body;\n55\t    if (title !== undefined && typeof title !== 'string') {\n56\t      res.status(400).json({ message: 'title must be a string' });\n57\t      return;\n58\t    }\n59\t    if (content !== undefined && typeof content !== 'string') {\n60\t      res.status(400).json({ message: 'content must be a string' });\n61\t      return;\n62\t    }\n63\t\n64\t    const result = db.updateDocument(req.params.id, {\n65\t      title,\n66\t      content,\n67\t    });\n68\t    if (!result) {\n69\t      res.status(404).json({ message: 'Document not found' });\n70\t      return;\n71\t    }\n72\t    res.json(result.document);\n73\t  });\n74\t\n75\t  // DELETE /documents/:id — delete a document\n76\t  app.delete('/documents/:id', (req, res) => {\n77\t    const deleted = db.deleteDocument(req.params.id);\n78\t    if (!deleted) {\n79\t      res.status(404).json({ message: 'Document not found' });\n80\t      return;\n81\t    }\n82\t    res.status(204).end();\n83\t  });\n84\t\n85\t  // GET /documents/:id/versions — get version history\n86\t  app.get('/documents/:id/versions', (req, res) => {\n87\t    const doc = db.getDocument(req.params.id);\n88\t    if (!doc) {\n89\t      res.status(404).json({ message: 'Document not found' });\n90\t      return;\n91\t    }\n92\t    const versions = db.getVersions(req.params.id);\n93\t    res.json(versions);\n94\t  });\n95\t\n96\t  // ── WebSocket ────────────────────────────────────────────\n97\t\n98\t  function setupWebSocket(server: Server): void {\n99\t    wss = new WebSocketServer({ server, path: undefined });\n100\t\n101\t    wss.on('connection', (ws, req) => {\n102\t      // Parse docId from URL path: /ws/:docId\n103\t      const url = new URL(req.url ?? '/', `http://${req.headers.host ?? 'localhost'}`);\n104\t      const match = url.pathname.match(/^\\/ws\\/(.+)$/);