ssage: 'Document not found' });\n      return;\n    }\n    res.json(doc);\n  });\n\n  app.put('/documents/:id', (req, res) => {\n    const { title, content } = req.body;\n    if (title !== undefined && typeof title !== 'string') {\n      res.status(400).json({ message: 'title must be a string' });\n      return;\n    }\n    if (content !== undefined && typeof content !== 'string') {\n      res.status(400).json({ message: 'content must be a string' });\n      return;\n    }\n\n    const result = db.updateDocument(req.params.id, {\n      title,\n      content,\n    });\n    if (!result) {\n      res.status(404).json({ message: 'Document not found' });\n      return;\n    }\n    res.json(result.document);\n  });\n\n  app.delete('/documents/:id', (req, res) => {\n    const deleted = db.deleteDocument(req.params.id);\n    if (!deleted) {\n      res.status(404).json({ message: 'Document not found' });\n      return;\n    }\n    res.status(204).end();\n  });\n\n  app.get('/documents/:id/versions', (req, res) => {\n    const doc = db.getDocument(req.params.id);\n    if (!doc) {\n      res.status(404).json({ message: 'Document not found' });\n      return;\n    }\n    const versions = db.getVersions(req.params.id);\n    res.json(versions);\n  });\n\n  // ── WebSocket ────────────────────────────────────────────\n\n  function setupWebSocket(server: Server): void {\n    wss = new WebSocketServer({ server });\n\n    wss.on('connection', (ws, req) => {\n      // Parse docId from URL path: /ws/:docId\n      const url = new URL(req.url ?? '/', `http://${req.headers.host ?? 'localhost'}`);\n      const match = url.pathname.match(/^\\/ws\\/(.+)$/);\n\n      if (!match) {\n        sendError(ws, 'Invalid WebSocket path — use /ws/:docId');\n        ws.close(4000, 'Invalid path');\n        return;\n      }\n\n      const docId = match[1];\n\n      // Tag the socket for broadcast filtering\n      (ws as unknown as Record<string, unknown>)._docId = docId;\n\n      const doc = db.getDocument(docId);\n\n      if (!doc) {\n        sendError(ws, `Document ${docId} not found`);\n        ws.close(4004, 'Document not found');\n        return;\n      }\n\n      const currentVersion = db.getVersionOrThrow(docId);\n\n      // Send init message\n      const initMsg: ServerMessage = {\n        type: 'init',\n        docId,\n        content: doc.content,\n        version: currentVersion,\n      };\n      ws.send(JSON.stringify(initMsg));\n\n      // Listen for messages\n      ws.on('message', (data) => {\n        let parsed: ClientMessage;\n        try {\n          const raw = JSON.parse(data.toString());\n          parsed = raw as ClientMessage;\n        } catch {\n          sendError(ws, 'Invalid JSON');\n          return;\n        }\n\n        if (parsed.type !== 'op') {\n          sendError(ws, `Unknown message type: ${(parsed as unknown as Record<string, unknown>).type}`);\n          return;\n        }\n\n        const { version: clientVersion, op } = parsed;\n\n        if (!isValidOp(op)) {\n          sendError(ws, `Invalid operation: ${JSON.stringify(op)}`);\n          return;\n        }\n\n        // Fetch current document state\n        const currentDoc = db.getDocument(docId);\n        if (!currentDoc) {\n          sendError(ws, 'Document not found');\n          return;\n        }\n\n        // Validate operation bounds against current content\n        const contentLen = currentDoc.content.length;\n        if (op.type === 'insert' && (op.pos < 0 || op.pos > contentLen)) {\n          sendError(ws, `Insert position ${op.pos} out of bounds [0, ${contentLen}]`);\n          return;\n        }\n        if (op.type === 'delete') {\n          if (op.pos < 0 || op.pos + op.length > contentLen) {\n            sendError(\n              ws,\n              `Delete at ${op.pos}, length ${op.length} out of bounds for content length ${contentLen}`,\n            );\n            return;\n          }\n          if (op.length <= 0) {\n            sendError(ws, 'Delete length must be positive');\n            return;\n          }\n        }\n        if (op.type === 'insert' && op.text.length === 0) {\n          sendError(ws, 'Insert text must not be empty');\n          return;\n        }\n\n        // ── Operational Transform ─────────────────────────\n        let transformedOp: Op | null = op;\n        const currentVer = db.getVersionOrThrow(docId);\n\n        if (clientVersion < currentVer) {\n          const intervening = db.getOperationsSince(docId, clientVersion);\n          for (const interv of intervening) {\n            if (transformedOp === null) break;\n            transformedOp = transform(transformedOp, interv.operation);\n          }\n        } else if (clientVersion > currentVer) {\n          sendError(\n            ws,\n            `Version ${clientVersion} is ahead of server version ${currentVer}`,\n          );\n          return;\n        }\n\n        if (transformedOp === null) {\n          // Operation became a no-op — still broadcast to acknowledge\n          broadcastOp(docId, currentVer + 1, op);\n          return;\n        }\n\n        // Apply the transformed operation\n        let newContent: string;\n        try {\n          newContent = apply(currentDoc.content, transformedOp);\n        } catch {\n          sendError(ws, 'Failed to apply operation');\n          return;\n        }\n\n        const result = db.applyOperation(docId, transformedOp, newContent);\n        if (!result) {\n          sendError(ws, 'Failed to persist operation');\n          return;\n        }\n\n        // Broadcast to ALL connected clients (including sender)\n        broadcastOp(docId, result.version, transformedOp);\n      });\n\n      ws.on('error', () => {\n        // Socket error — nothing to clean up\n      });\n    });\n\n    // ── Broadcast helper ───────────────────────────────────\n\n    function broadcastOp(docId: string, version: number, op: Op): void {\n      if (!wss) return;\n      const msg: ServerMessage = { type: 'op