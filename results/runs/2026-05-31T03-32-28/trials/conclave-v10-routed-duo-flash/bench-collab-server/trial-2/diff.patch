t bOut: Op = [];\n\n  let i = 0, j = 0;\n\n  while (i < aComps.length && j < bComps.length) {\n    const ca = aComps[i];\n    const cb = bComps[j];\n\n    if (ca.type === 'retain' && cb.type === 'retain') {\n      const minCount = Math.min(ca.count, cb.count);\n      aOut.push(rmain(ca, minCount));\n      bOut.push(rmain(cb, minCount));\n      if (ca.count === minCount) i++; else { ca.count -= minCount; }\n      if (cb.count === minCount) j++; else { cb.count -= minCount; }\n    } else if (ca.type === 'retain' && cb.type === 'insert') {\n      aOut.push(cb); // A retains past B's insert → output B's insert for A\n      bOut.push(cb); // B's insert stays\n      j++;\n    } else if (ca.type === 'insert' && cb.type === 'retain') {\n      aOut.push(ca); // A's insert stays\n      bOut.push(ca); // B retains past A's insert → output A's insert for B\n      i++;\n    } else if (ca.type === 'insert' && cb.type === 'insert') {\n      // Both insert at the same position\n      // Use clientId as tiebreaker (from the original atomic operations)\n      if (a.clientId <= b.clientId) {\n        aOut.push(ca);\n        bOut.push(ca);\n        aOut.push(cb);\n        bOut.push(cb);\n      } else {\n        aOut.push(cb);\n        bOut.push(cb);\n        aOut.push(ca);\n        bOut.push(ca);\n      }\n      i++;\n      j++;\n    } else if (ca.type === 'delete' && cb.type === 'retain') {\n      // A deletes, B retains → A's delete stays, B's retain is consumed by delete\n      const minCount = Math.min(ca.count, cb.count);\n      // A outputs delete\n      aOut.push({ type: 'delete', count: minCount });\n      // B's retain is consumed (the deleted chars are skipped for B too)\n      bOut.push({ type: 'retain', count: minCount });\n      if (ca.count === minCount) i++; else { ca.count -= minCount; }\n      if (cb.count === minCount) j++; else { cb.count -= minCount; }\n    } else if (ca.type === 'retain' && cb.type === 'delete') {\n      // A retains, B deletes → symmetric\n      c