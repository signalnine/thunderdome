ed;\n    return row ?? null;\n  }\n\n  listDocuments(): Document[] {\n    const stmt = this.db.prepare('SELECT * FROM documents ORDER BY updated_at DESC');\n    return stmt.all() as Document[];\n  }\n\n  updateDocument(id: string, title?: string, content?: string): Document | null {\n    const doc = this.getDocument(id);\n    if (!doc) return null;\n\n    const newTitle = title ?? doc.title;\n    const newContent = content ?? doc.content;\n    const now = new Date().toISOString();\n\n    const stmt = this.db.prepare(\n      'UPDATE documents SET title = ?, content = ?, updated_at = ? WHERE id = ?'\n    );\n    stmt.run(newTitle, newContent, now, id);\n\n    return this.getDocument(id);\n  }\n\n  deleteDocument(id: string): boolean {\n    const doc = this.getDocument(id);\n    if (!doc) return false;\n    const stmt = this.db.prepare('DELETE FROM documents WHERE id = ?');\n    stmt.run(id);\n    return true;\n  }\n\n  // ---- Version History ----\n\n  addVersion(docId: string, version: number, content: string, operation: string | null): void {\n    const stmt = this.db.prepare(\n      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'\n    );\n    stmt.run(docId, version, content, operation);\n  }\n\n  getVersions(docId: string): Version[] {\n    const stmt = this.db.prepare(\n      'SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC'\n    );\n    return stmt.all(docId) as Version[];\n  }\n\n  getLatestVersion(docId: string): number {\n    const stmt = this.db.prepare(\n      'SELECT MAX(version) as max_version FROM versions WHERE document_id = ?'\n    );\n    const row = stmt.get(docId) as { max_version: number | null } | undefined;\n    return row?.max_version ?? 0;\n  }\n\n  // ---- Active Connections ----\n\n  addConnection(id: string, docId: string): void {\n    const now = new Date().toISOString();\n    const stmt = this.db.prepare(\n      'INSERT OR REPLACE INTO active_connections (id, document_id, connected_at) VALUES (?, ?, ?)'\n    );\n    stmt.run(id, docId, now);\n  }\n\n  removeConnection(id: string): void {\n    const stmt = this.db.prepare('DELETE FROM active_connections WHERE id = ?');\n    stmt.run(id);\n  }\n\n  getConnectionCount(docId: string): number {\n    const stmt = this.db.prepare(\n      'SELECT COUNT(*) as count FROM active_connections WHERE document_id = ?'\n    );\n    const row = stmt.get(docId) as { count: number };\n    return row.count;\n  }\n}\n","structuredPatch":[{"oldStart":6,"oldLines":8,"newStart":6,"newLines":6,"lines":[" "," const __dirname = dirname(fileURLToPath(import.meta.url));"," ","-let dbCounter = 0;","-"," export class DocDatabase {","   private db: Database.Database;"," "]}],"userModified":false,"replaceAll":false}}
