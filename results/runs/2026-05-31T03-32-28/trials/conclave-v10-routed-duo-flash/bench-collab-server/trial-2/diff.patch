@@ -0,0 +1,60 @@
+export interface InsertOp {
+  type: 'insert';
+  pos: number;
+  text: string;
+  clientId: string;
+}
+
+export interface DeleteOp {
+  type: 'delete';
+  pos: number;
+  length: number;
+  clientId: string;
+}
+
+export type Operation = InsertOp | DeleteOp;
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface Version {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+export interface WSMessage {
+  type: string;
+  [key: string]: unknown;
+}
+
+export interface SyncMessage extends WSMessage {
+  type: 'sync';
+  content: string;
+  version: number;
+}
+
+export interface OperationMessage extends WSMessage {
+  type: 'operation';
+  op: Operation;
+  version: number;
+  clientId?: string;
+}
+
+export interface ErrorMessage extends WSMessage {
+  type: 'error';
+  message: string;
+}
+
+export interface AckMessage extends WSMessage {
+  type: 'ack';
+  version: number;
+}
