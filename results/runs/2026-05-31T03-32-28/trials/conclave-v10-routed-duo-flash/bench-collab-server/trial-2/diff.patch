ribe('transform: insert vs insert', () => {\n  it('should keep inserts at different positions unchanged', () => {\n    const a: Operation = { type: 'insert', pos: 0, text: 'A', clientId: CLIENT_A };\n    const b: Operation = { type: 'insert', pos: 1, text: 'B', clientId: CLIENT_B };\n    const [aPrime, bPrime] = transform(a, b);\n    expect(aPrime).not.toBeNull();\n    expect(bPrime).not.toBeNull();\n    // a pos 0 < b pos 1, so a unchanged, b shifts right by 1\n    expect(aPrime!.pos).toBe(0);\n    expect(bPrime!.pos).toBe(2);\n  });\n\n  it('should handle same position with clientId ordering (A < B)', () => {\n    const a: Operation = { type: 'insert', pos: 0, text: 'A', clientId: 'a' };\n    const b: Operation = { type: 'insert', pos: 0, text: 'B', clientId: 'b' };\n    const [aPrime, bPrime] = transform(a, b);\n    expect(aPrime).not.toBeNull();\n    expect(bPrime).not.toBeNull();\n    // 'a' < 'b', so a stays at 0, b shifts to 1\n    expect(aPrime!.pos).toBe(0);\n    expect(bPrime!.pos).toBe(1);\n  });\n\n  it('should handle same position with clientId ordering (B < A)', () => {\n    const a: Operation = { type: 'insert', pos: 0, text: 'A', clientId: 'z' };\n    const b: Operation = { type: 'insert', pos: 0, text: 'B', clientId: 'a' };\n    const [aPrime, bPrime] = transform(a, b);\n    expect(aPrime).not.toBeNull();\n    expect(bPrime).not.toBeNull();\n    // 'a' < 'z', so b stays at 0, a shifts to 1\n    expect(bPrime!.pos).toBe(0);\n    expect(aPrime!.pos).toBe(1);\n  });\n\n  it('should converge (insert vs insert)', () => {\n    const S = 'hello';\n    const a: Operation = { type: 'insert', pos: 2, text: 'AA', clientId: CLIENT_A };\n    const b: Operation = { type: 'insert', pos: 4, text: 'BB', clientId: CLIENT_B };\n    const [aPrime, bPrime] = transform(a, b);\n    expect(aPrime).not.toBeNull();\n    expect(bPrime).not.toBeNull();\n    const r1 = applyOperation(applyOperation(S, a), bPrime!);\n    const r2 = applyOperation(applyOperation(S, b), aPrime!);\n    expect(r1).toBe(r2);\n  });\n});\n\ndescribe('transform: insert vs delete', () => {\n  it('should shift delete position right when inserting before it', () => {\n    const S = 'hello world';\n    const ins: Operation = { type: 'insert', pos: 0, text: '!!', clientId: CLIENT_A };\n    const del: Operation = { type: 'delete', pos: 5, length: 5, clientId: CLIENT_B };\n    const [insPrime, delPrime] = transform(ins, del);\n    expect(insPrime).not.toBeNull();\n    expect(delPrime).not.toBeNull();\n    // insert at 0 pushes content right, delete at 5 → 7\n    expect(insPrime!.pos).toBe(0);\n    expect((delPrime as Operation).pos).toBe(7);\n  });\n\n  it('should shift insert position left when deleting before it', () => {\n    const S = 'hello world';\n    const del: Operation = { type: 'delete', pos: 0, length: 5, clientId: CLIENT_A };\n    const ins: Operation = { type: 'insert', pos: 6, text: '!!', clientId: CLIENT_B };\n    const [delPrime, insPrime] = transform(del, ins);\n    // del at 0 stays, ins at 6 shifts to 1 (after deletion of 0..5)\n    expect(insPrime).not.toBeNull();\n    expect(delPrime).not.toBeNull();\n    expect((delPrime as Operation).pos).toBe(0);\n    expect((insPrime as Operation).pos).toBe(1);\n  });\n\n  it('should handle insert at same position as delete start', () => {\n    const S = 'hello';\n    const ins: Operation = { type: 'insert', pos: 2, text: 'XX', clientId: CLIENT_A };\n    const del: Operation = { type: 'delete', pos: 2, length: 2, clientId: CLIENT_B };\n    const [insPrime, delPrime] = transform(ins, del);\n    expect(insPrime).not.toBeNull();\n    expect(delPrime).not.toBeNull();\n    const r1 = applyOperation(applyOperation(S, ins), delPrime!);\n    const r2 = applyOperation(applyOperation(S, del), insPrime!);\n    expect(r1).toBe(r2);\n  });\n\n  it('should converge (insert vs delete)', () => {\n    const S = 'abcdef';\n    const a: Operation = { type: 'insert', pos: 3, text: 'XYZ', clientId: CLIENT_A };\n    const b: Operati