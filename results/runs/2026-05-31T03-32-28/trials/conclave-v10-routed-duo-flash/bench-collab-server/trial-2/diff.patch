ype).toBe('insert');\n\n    // Client 1 should NOT have received their own broadcast (only ack)\n    const opsForClient1 = ws1Messages.filter((m: any) => m.type === 'operation');\n    expect(opsForClient1.length).toBe(0);\n\n    ws1.close();\n    ws2.close();\n  });\n\n  it('should handle concurrent edits from multiple clients (convergence)', async () => {\n    port = await startServer();\n\n    // Create document\n    const createRes = await fetch(apiUrl('/documents'), {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'Convergence Test' }),\n    });\n    const doc = await createRes.json();\n\n    // Set initial content\n    await fetch(apiUrl(`/documents/${doc.id}`), {\n      method: 'PUT',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ content: 'abcde' }),\n    });\n\n    // Connect three clients\n    const clients = [new WebSocket(wsUrl(doc.id)), new WebSocket(wsUrl(doc.id)), new WebSocket(wsUrl(doc.id))];\n    const clientMessages = clients.map(() => [] as unknown[]);\n\n    await Promise.all(clients.map((ws) => new Promise<void>((resolve) => ws.on('open', () => resolve()))));\n\n    clients.forEach((ws, i) => {\n      ws.on('message', (data) => clientMessages[i].push(JSON.parse(data.toString())));\n    });\n\n    // Wait for all syncs\n    await new Promise<void>((resolve, reject) => {\n      const check = () => {\n        if (clientMessages.every((msgs) => msgs.some((m: any) => m.type === 'sync'))) {\n          resolve();\n        } else {\n          setTimeout(check, 10);\n        }\n      };\n      check();\n      setTimeout(() => reject(new Error('Timeout waiting for syncs')), 2000);\n    });\n\n    const syncs = clientMessages.map((msgs) => msgs.find((m: any) => m.type === 'sync') as any);\n\n    // Each client sends an operation concurrently\n    const edits = [\n      { type: 'insert', pos: 5, text: 'XYZ', clientId: 'c1' },\n      { type: 'delete', 