index 0000000..b825f28
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,217 @@
+/**
+ * Operational Transform (OT) for collaborative text editing.
+ *
+ * Uses a position-based model with simple atomic operations:
+ * - Insert(pos, text): insert text at position pos
+ * - Delete(pos, length): delete 'length' characters starting at pos
+ *
+ * The transform function handles all concurrent-operation edge cases:
+ * - insert vs insert: tiebreak by clientId
+ * - insert vs delete: adjust positions based on relative ordering
+ * - delete vs delete: handle overlaps correctly by reducing lengths
+ */
+
+import type { Operation, InsertOp, DeleteOp } from './types.js';
+
+/**
+ * Apply an operation to a string and return the result.
+ */
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    if (op.pos < 0 || op.pos > content.length) {
+      throw new Error(
+        `Insert position ${op.pos} out of bounds for content of length ${content.length}`
+      );
+    }
+    return content.slice(0, op.pos) + op.text + content.slice(op.pos);
+  } else {
+    if (op.pos < 0 || op.pos + op.length > content.length) {
+      throw new Error(
+        `Delete position ${op.pos} length ${op.length} out of bounds for content of length ${content.length}`
+      );
+    }
+    return content.slice(0, op.pos) + content.slice(op.pos + op.length);
+  }
+}
+
+/**
+ * Transform two concurrent operations (both relative to the same base document).
+ * Returns [op1_prime, op2_prime] such that applying them in either order
+ * (op1 then op2_prime, or op2 then op1_prime) yields the same result.
+ *
+ * Either result can be null, meaning the operation has no effect.
+ */
+export function transform(
+  op1: Operation,
+  op2: Operation
+): [Operation | null, Operation | null] {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    return transformInsIns(op1, op2);
+  }
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    return transformInsDel(op1, op2);
+  }
+  if (op1.type === 'delete' && op2.type === 'insert') {
+    const [iPrime, dPrime] = transformInsDel(op2, op1);
+    return [dPrime, iPrime];
+  }
+  if (op1.type === 'delete' && op2.type === 'delete') {
+    return transformDelDel(op1, op2);
+  }
+  // Should never reach here
+  throw new Error('Unhandled operation combination');
+}
+
+/**
+ * Transform insert(A) against insert(B).
+ * If at same position, the operation with smaller clientId goes first.
+ */
+function transformInsIns(
+  a: InsertOp,
+  b: InsertOp
+): [InsertOp, InsertOp] {
+  if (a.pos < b.pos || (a.pos === b.pos && a.clientId < b.clientId)) {
+    return [
+      { ...a },
+      { ...b, pos: b.pos + a.text.length },
+    ];
+  } else {
+    return [
+      { ...a, pos: a.pos + b.text.length },
+      { ...b },
+    ];
+  }
+}
+
+/**
+ * Transform insert(I) against delete(D).
+ * Three cases:
+ * 1. Insert before delete range: insert stays, delete shifts right by insert length
+ * 2. Insert within delete range: insert shifts to delete start, delete unchanged
+ * 3. Insert after delete range: insert shifts left by delete length, delete unchanged
+ */
+function transformInsDel(
+  ins: InsertOp,
+  del: DeleteOp
+): [InsertOp, DeleteOp] {
+  const delEnd = del.pos + del.length;
+
+  if (ins.pos <= del.pos) {
+    // Insert before delete range
+    return [
+      { ...ins },
+      { ...del, pos: del.pos + ins.text.length },
+    ];
+  } else if (ins.pos >= delEnd) {
+    // Insert after delete range
+    return [
+      { ...ins, pos: ins.pos - del.length },
+      { ...del },
+    ];
+  } else {
+    // Insert within delete range
+    return [
+      { ...ins, pos: del.pos },
+      { ...del },
+    ];
+  }
+}
+
+/**
+ * Transform delete(A) against delete(B).
+ * Six cases:
+ * 1. A entirely before B (no overlap): A unchanged, B shifts left
+ * 2. B entirely before A (no overlap): A shifts left, B unchanged
+ * 3. A contains B: A shortens, B unchanged
+ * 4. B contains A: A becomes null, B shortens
+ * 5. Partial overlap (A on left): both reduce
+ * 6. Partial overlap (B on left): both reduce
+ */
+function transformDelDel(
+  a: DeleteOp,
+  b: DeleteOp
+): [DeleteOp | null, DeleteOp | null] {
+  const aEnd = a.pos + a.length;
+  const bEnd = b.pos + b.length;
+
+  // Case 1: A entirely before B, no overlap
+  if (aEnd <= b.pos) {
+    return [
+      { ...a },
+      { ...b, pos: b.pos - a.length },
+    ];
+  }
+
+  // Case 2: B entirely before A, no overlap
+  if (bEnd <= a.pos) {
+    return [
+      { ...a, pos: a.pos - b.length },
+      { ...b },
+    ];
+  }
+
+  // Case 3: A contains B (or same start but A extends further)
+  if (a.pos <= b.pos && aEnd >= bEnd) {
+    const newLen = a.length - b.length;
+    if (newLen <= 0) {
+      // Identical ranges or B fully covers A's range
+      return [null, { ...b }];
+    }
+    return [
+      { ...a, length: newLen },
+      null,
+    ];
+  }
+
+  // Case 4: B contains A (or same start but B extends further)
+  if (b.pos <= a.pos && bEnd >= aEnd) {
+    const newLen = b.length - a.length;
+    if (newLen <= 0) {
+      return [{ ...a }, null];
+    }
+    return [
+      null,
+      { ...b, length: newLen },
+    ];
+  }
+
+  // Case 5: Partial overlap, A starts before B
+  // Diagram: A=[a.pos, aEnd) and B=[b.pos, bEnd), a.pos < b.pos < aEnd < bEnd
+  if (a.pos < b.pos && aEnd > b.pos && aEnd < bEnd) {
+    const overlap = aEnd - b.pos;
+    return [
+      { ...a, length: a.length - overlap },
+      { ...b, pos: b.pos - (a.length - overlap), length: b.length - overlap },
+    ];
+  }
+
+  // Case 6: Partial overlap, B starts before A
+  // Diagram: B=[b.pos, bEnd) and A=[a.pos, aEnd), b.pos < a.pos < bEnd < aEnd
+  if (b.pos < a.pos && bEnd > a.pos && bEnd < aEnd) {
+    const overlap = bEnd - a.pos;
+    return [
+      { ...a, pos: a.pos - (b.length - overlap), length: a.length - overlap },
+      { ...b, length: b.length - overlap },
+    ];
+  }
+
+  // Fallback (should not reach)
+  return [{ ...a }, { ...b }];
+}
+
+/**
+ * Transform an operation against a list of prior operations (in order).
+ * Returns the transformed operation, or null if it becomes a no-op.
+ */
+export function transformAgainst(
+  op: Operation,
+  against: Operation[]
+): Operation | null {
+  let result: Operation | null = op;
+  for (const other of against) {
+    if (result === null) return null;
+    const [prime] = transform(result, other);
+    result = prime;
+  }
+  return result;
+}
