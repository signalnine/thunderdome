   aOut.push({ type: 'delete', count: minCount });\n      bOut.push({ type: 'delete', count: minCount });\n      if (ca.count === minCount) i++; else { ca.count -= minCount; }\n      if (cb.count === minCount) j++; else { cb.count -= minCount; }\n    }\n  }\n\n  // Flush remaining components\n  while (i < aComps.length) {\n    aOut.push(aComps[i]);\n    // If A has retains or inserts after B finished, they can be dropped for B\n    // (B is shorter or consumed)\n    if (aComps[i].type === 'retain' || aComps[i].type === 'insert') {\n      i++;\n    } else {\n      i++;\n    }\n  }\n  while (j < bComps.length) {\n    bOut.push(bComps[j]);\n    j++;\n  }\n\n  // Convert back to atomic operations\n  const aResult = simplifyAndConvert(aOut, a.clientId);\n  const bResult = simplifyAndConvert(bOut, b.clientId);\n\n  return [aResult, bResult];\n}\n\nfunction rmain(c: Retain, count: number): Retain {\n  return { type: 'retain', count };\n}\n\n/**\n * Simplify a component array by merging adjacent components of the same type,\n * then attempt to convert back to a single atomic operation.\n * Returns null for no-ops.\n */\nfunction simplifyAndConvert(comps: Op, clientId: string): Operation | null {\n  if (comps.length === 0) return null;\n\n  // Merge adjacent same-type components\n  const simplified: Op = [];\n  for (const comp of comps) {\n    const last = simplified[simplified.length - 1];\n    if (last && last.type === comp.type && last.type !== 'insert') {\n      if (comp.type === 'retain') {\n        last.count += (comp as Retain).count;\n      } else if (comp.type === 'delete') {\n        last.count += (comp as Delete).count;\n      }\n    } else if (last && last.type === 'insert' && comp.type === 'insert') {\n      // Merge adjacent inserts\n      last.text += (comp as Insert).text;\n    } else {\n      simplified.push({ ...comp });\n    }\n  }\n\n  // Convert to atomic operation\n  return fromComponents(simplified, clientId);\n}\n\n/**\n * Transform an atomic operation against a list of prior operations (in order).\n * Returns the transformed operation, or null if it becomes a no-op.\n */\nexport function transformAgainst(op: Operation, against: Operation[]): Operation | null {\n  let result: Operation | null = op;\n  for (const other of against) {\n    if (result === null) return null;\n    const [prime] = transform(result, other);\n    result = prime;\n  }\n  return result;\n}\n","userModified":false}}
