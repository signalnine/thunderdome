xpect(r1).toBe(r2);\n  });\n});\n\ndescribe('transform: insert vs delete', () => {\n  it('should converge when inserting before delete', () => {\n    const S = 'hello world';\n    const ins: Operation = { type: 'insert', pos: 0, text: '!!', clientId: CLIENT_A };\n    const del: Operation = { type: 'delete', pos: 5, length: 5, clientId: CLIENT_B };\n    const [insPrime, delPrime] = transform(ins, del);\n    const r1 = applyOp(applyOperation(S, ins), delPrime);\n    const r2 = applyOp(applyOperation(S, del), insPrime);\n    expect(r1).toBe(r2);\n    expect(r1).toBe('!!hello ');\n  });\n\n  it('should converge when inserting after delete', () => {\n    const S = 'hello world';\n    const del: Operation = { type: 'delete', pos: 0, length: 5, clientId: CLIENT_A };\n    const ins: Operation = { type: 'insert', pos: 6, text: '!!', clientId: CLIENT_B };\n    const [delPrime, insPrime] = transform(del, ins);\n    const r1 = applyOp(applyOperation(S, del), insPrime);\n    const r2 = applyOp(applyOperation(S, ins), delPrime);\n    expect(r1).toBe(r2);\n    expect(r1).toBe(' world!!');\n  });\n\n  it('should converge with insert at delete start', () => {\n    const S = 'hello';\n    const ins: Operation = { type: 'insert', pos: 2, text: 'XX', clientId: CLIENT_A };\n    const del: Operation = { type: 'delete', pos: 2, length: 2, clientId: CLIENT_B };\n    const [insPrime, delPrime] = transform(ins, del);\n    const r1 = applyOp(applyOperation(S, ins), delPrime);\n    const r2 = applyOp(applyOperation(S, del), insPrime);\n    expect(r1).toBe(r2);\n  });\n\n  it('should converge (insert vs delete comprehensive)', () => {\n    const S = 'abcdef';\n    const ins: Operation = { type: 'insert', pos: 3, text: 'XYZ', clientId: CLIENT_A };\n    const del: Operation = { type: 'delete', pos: 0, length: 2, clientId: CLIENT_B };\n    const [insPrime, delPrime] = transform(ins, del);\n    const r1 = applyOp(applyOperation(S, ins), delPrime);\n    const r2 = applyOp(applyOperation(S, del), ins