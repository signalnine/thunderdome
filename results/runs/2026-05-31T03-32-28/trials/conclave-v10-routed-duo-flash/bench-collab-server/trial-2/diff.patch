ent[];\n\n// ---- Convert atomic operations to/from components ----\n\nexport function toOp(op: Operation): Op {\n  if (op.type === 'insert') {\n    const components: Op = [];\n    if (op.pos > 0) components.push({ type: 'retain', count: op.pos });\n    components.push({ type: 'insert', text: op.text });\n    return components;\n  } else {\n    const components: Op = [];\n    if (op.pos > 0) components.push({ type: 'retain', count: op.pos });\n    components.push({ type: 'delete', count: op.length });\n    return components;\n  }\n}\n\n/**\n * Attempt to convert a component-based Op back to a simple atomic Operation.\n * Returns null if the Op is a no-op or too complex.\n * An Op is \"simple\" if it has at most one retain and one non-retain component.\n */\nexport function toAtomicOp(comps: Op, clientId: string): Operation | null {\n  if (comps.length === 0) return null;\n\n  let pos = 0;\n  let seenAction = false;\n  let result: Operation | null = null;\n\n  for (const c of comps) {\n    if (c.type === 'retain') {\n      if (seenAction) {\n        // Multiple actions separated by retains → complex, can't be atomic\n        return null;\n      }\n      pos += c.count;\n    } else if (c.type === 'insert') {\n      if (seenAction) {\n        // Multiple actions → complex\n        return null;\n      }\n      seenAction = true;\n      result = { type: 'insert', pos, text: c.text, clientId } as InsertOp;\n    } else {\n      if (seenAction) {\n        return null;\n      }\n      seenAction = true;\n      result = { type: 'delete', pos, length: c.count, clientId } as DeleteOp;\n    }\n  }\n\n  return result;\n}\n\n// ---- Apply component operation to a string ----\n\nexport function applyOp(content: string, comps: Op): string {\n  const parts: string[] = [];\n  let idx = 0;\n\n  for (const comp of comps) {\n    if (comp.type === 'retain') {\n      if (idx + comp.count > content.length) {\n        throw new Error(\n          `Retain ${comp.count} exceeds remaining content length ${content.length - idx}`\n        );\n      }\n      parts.push(content.slice(idx, idx + comp.count));\n      idx += comp.count;\n    } else if (comp.type === 'insert') {\n      parts.push(comp.text);\n    } else {\n      // delete\n      if (idx + comp.count > content.length) {\n        throw new Error(\n          `Delete ${comp.count} exceeds remaining content length ${content.length - idx}`\n        );\n      }\n      idx += comp.count;\n    }\n  }\n\n  // Append any remaining content not covered by the operation\n  if (idx < content.length) {\n    parts.push(content.slice(idx));\n  }\n\n  return parts.join('');\n}\n\n/**\n * Apply a simple atomic Operation to a string.\n */\nexport function applyOperation(content: string, op: Operation): string {\n  return applyOp(content, toOp(op));\n}\n\n// ---- Simplify Op by merging adjacent components of same type ----\n\nexport function simplify(comps: Op): Op {\n  if (comps.length <= 1) return comps;\n  const result: Op = [];\n  for (const comp of comps) {\n    const last = result[result.length - 1];\n    if (!last) {\n      result.push({ ...comp });\n      continue;\n    }\n    if (last.type === comp.type && comp.type !== 'insert') {\n      (last as RetainComp | DeleteComp).count += (comp as RetainComp | DeleteComp).count;\n    } else if (last.type === 'insert' && comp.type === 'insert') {\n      last.text += (comp as InsertComp).text;\n    } else {\n      result.push({ ...comp });\n    }\n  }\n  return result;\n}\n\n// ---- Transform two operations (both relative to the same base string) ----\n\n/**\n * Transform operation A against operation B.\n * Returns [A', B'] such that apply(apply(S, A), B') === apply(apply(S, B), A').\n */\nexport function transform(a: Operation, b: Operation): [Op, Op] {\n  const aComps = toOp(a);\n  const bComps = toOp(b);\n  return transformOps(aComps, bComps, a.clientId, b.clientId);\n}\n\n/**\n * Transform two component-based Ops.\n */\nexport function transformOps(\n  aComps: Op,\n  bComps: Op,\n  aClientId: string,\n  bClientId: string\n): [Op, Op] {\n  const aOut: Op = [];\n  const bOut: Op = [];\n\n  // Track remaining counts for current components\n  let aIdx = 0, bIdx = 0;\n  let aRemaining = aComps.length > 0 ? aComps[0] : null;\n  let bRemaining = bComps.length > 0 ? bComps[0] : null;\n\n  function advanceA() {\n    aIdx++;\n    aRemaining = aIdx < aComps.length ? aComps[aIdx] : null;\n  }\n  function advanceB() {\n    bIdx++;\n    bRemaining = bIdx < bComps.length ? bComps[bIdx] : null;\n  }\n  function aCount(c: Component): number {\n    return c.type === 'insert' ? c.text.length : (c as RetainComp | DeleteComp).count;\n  }\n  function takeA(n: number) {\n    if (!aRemaining || aRemaining.type === 'insert') return;\n    aRemaining.count -= n;\n    if (aRemaining.count <= 0) advanceA();\n  }\n  function takeB(n: number) {\n    if (!bRemaining || bRemaining.type === 'insert') return;\n    bRemaining.count -= n;\n    if (bRemaining.count <= 0) advanceB();\n  }\n\n  while (aRemaining && bRemaining) {\n    const ca = aRemaining;\n    const cb = bRemaining;\n\n    // retain vs retain\n    if (ca.type === 'retain' && cb.type === 'retain') {\n      const n = Math.min(ca.count, cb.count);\n      aOut.push({ type: 'retain', count: n });\n      bOut.push({ type: 'retain', count: n });\n      takeA(n);\n      takeB(n);\n    }\n    // retain vs insert\n    else if (ca.type === 'retain' && cb.type === 'insert') {\n      const n = cb.text.length;\n      aOut.push({ type: 'retain', count: n });\n      bOut.push({ type: 'insert', text: cb.text });\n      takeA(n);\n      advanceB(); // insert is consumed entirely\n    }\n    // insert vs retain\n    else if (ca.type === 'insert' && cb.type === 'retain') {\n      const n = ca.text.length;\n      aOut.push({ type: 'insert', text: ca.text });\n      bOut.push({ type: 'retain', count: n });\n      advanceA();\n      takeB(n);\n    }\n    // insert vs insert\n    else if (ca.type === 'insert' && cb.type === 'insert') {\n      if (aClientId <= bClientId) {\n        aOut.push({ type: 'insert', text: ca.text });\n        bOut.push({ type: 'insert', text: ca.text });\n        aOut.push({ type: 'insert', text: cb.text });\n        bOut.push({ type: 'insert', text: cb.text });\n      } else {\n        aOut.push({ type: 'insert', text: cb.text });\n        bOut.push({ type: 'insert', text: cb.text });\n        aOut.push({ type: 'insert', text: ca.text });\n        bOut.push({ type: 'insert', text: ca.text });\n      }\n      advanceA();\n      advanceB();\n    }\n    // delete vs delete\n    else if (ca.type === 'delete' && cb.type === 'delete') {\n      const n = Math.min(ca.count, cb.count);\n      aOut.push({ type: 'delete', count: n });\n      bOut.push({ type: 'delete', count: n });\n      takeA(n);\n      takeB(n);\n    }\n    // delete vs retain\n    else if (ca.type === 'delete' && cb.type === 'retain') {\n      const n = Math.min(ca.count, cb.count);\n      aOut.push({ type: 'delete', count: n });\n      bOut.push({ type: 'retain', count: n });\n      takeA(n);\n      takeB(n);\n    }\n    // retain vs delete\n    else if (ca.type === 'retain' && cb.type === 'delete') {\n      const n = Math.min(ca.count, cb.count);\n      aOut.push({ type: 'retain', count: n });\n      bOut.push({ type: 'delete', count: n });\n      takeA(n);\n      takeB(n);\n    }\n    // insert vs delete\n    else if (ca.type === 'insert' && cb.type === 'delete') {\n      // Insert passes through; delete passes through\n      aOut.push({ type: 'insert', text: ca.text });\n      bOut.push({ type: 'insert', text: ca.text });\n      advanceA();\n    }\n    // delete vs insert\n    else if (ca.type === 'delete' && cb.type === 'insert') {\n      aOut.push({ type: 'insert', text: cb.text });\n      bOut.push({ type: 'insert', text: cb.text });\n      advanceB();\n    }\n  }\n\n  // Flush remaining components\n  while (aRemaining) {\n    aOut.push({ ...aRemaining });\n    advanceA();\n  }\n  while (bRemaining) {\n    bOut.push({ ...bRemaining });\n    advanceB();\n  }\n\n  return [simplify(aOut), simplify(bOut)];\n}\n\n/**\n * Transform an atomic operation against a list of prior atomic operations (in order).\n * Returns the transformed component-based Op.\n */\nexport function transformAgainst(op: Operation, against: Operation[]): Op {\n  let result: Op = toOp(op);\n  for (const other of against) {\n    const [prime] = transformOps(result, toOp(other), op.clientId, other.clientId);\n    result = prime;\n  }\n  return result;\n}\n","userModified":false}}
