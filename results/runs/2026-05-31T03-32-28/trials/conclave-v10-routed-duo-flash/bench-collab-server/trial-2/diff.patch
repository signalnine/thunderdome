type: 'delete', pos: 4, length: 3, clientId: CLIENT_A },","+      b: { type: 'delete', pos: 2, length: 3, clientId: CLIENT_B } },","+    { S: 'test', a: { type: 'insert', pos: 2, text: '!!', clientId: CLIENT_A },","+      b: { type: 'insert', pos: 2, text: '@@', clientId: CLIENT_B } },","+    { S: 'xyz', a: { type: 'delete', pos: 0, length: 1, clientId: CLIENT_A },","+      b: { type: 'delete', pos: 1, length: 1, clientId: CLIENT_B } },","+    { S: 'abcdef', a: { type: 'insert', pos: 3, text: 'XY', clientId: CLIENT_A },","+      b: { type: 'delete', pos: 1, length: 4, clientId: CLIENT_B } },","+    { S: 'hello', a: { type: 'insert', pos: 5, text: '!', clientId: CLIENT_A },","+      b: { type: 'insert', pos: 0, text: '>', clientId: CLIENT_B } },","   ];"," ","   for (const { S, a, b } of CASES) {","     it(`should converge for ops on \"${S}\"`, () => {","       const [aPrime, bPrime] = transform(a, b);","-      if (aPrime === null && bPrime === null) {","-        // Both no-ops, result should be S after applying a then bPrime or vice versa","-        const r1 = applyOperation(S, a);","-        const r2 = applyOperation(S, b);","-        expect(r1).toBe(r2);","-      } else if (aPrime === null) {","-        const r1 = applyOperation(S, bPrime!);","-        const r2 = applyOperation(S, b);","-        expect(r1).toBe(r2);","-      } else if (bPrime === null) {","-        const r1 = applyOperation(S, a);","-        const r2 = applyOperation(applyOperation(S, b), aPrime);","-        expect(r1).toBe(r2);","-      } else {","-        const r1 = applyOperation(applyOperation(S, a), bPrime);","-        const r2 = applyOperation(applyOperation(S, b), aPrime);","-        expect(r1).toBe(r2);","-      }","+      const r1 = applyOp(applyOperation(S, a), bPrime);","+      const r2 = applyOp(applyOperation(S, b), aPrime);","+      expect(r1).toBe(r2);","     });","   }"," });"," "," describe('transform: return type', () => {","-  it('should return a tuple of two operations or nulls', () => {","+  it('should return a tuple of two component arrays', () => {","     const a: Operation = { type: 'insert', pos: 0, text: 'x', clientId: CLIENT_A };","     const b: Operation = { type: 'insert', pos: 1, text: 'y', clientId: CLIENT_B };","     const result = transform(a, b);","     expect(Array.isArray(result)).toBe(true);","     expect(result.length).toBe(2);","+    expect(Array.isArray(result[0])).toBe(true);","+    expect(Array.isArray(result[1])).toBe(true);","   });"," });","+","+describe('transformAgainst', () => {","+  it('should transform through multiple intervening operations', () => {","+    const { transformAgainst } = require('../src/ot.js');","+    const S = 'abc';","+    const op: Operation = { type: 'insert', pos: 1, text: 'X', clientId: CLIENT_A };","+    const against: Operation[] = [","+      { type: 'delete', pos: 0, length: 1, clientId: CLIENT_B },","+    ];","+    const result = transformAgainst(op, against);","+    // After delete(0,1): \"bc\". Insert(1,'X') → transform → insert(0,'X') → \"Xbc\"","+    const applied = applyOp(S, result);","+    expect(applied).toBe(applyOperation(applyOperation(S, against[0]), op));","+  });","+});"]}],"originalFile":"import { describe, it, expect } from 'vitest';\nimport { applyOperation, transform } from '../src/ot.js';\nimport type { Operation } from '../src/types.js';\n\nconst CLIENT_A = 'client-a';\nconst CLIENT_B = 'client-b';\n\ndescribe('applyOperation', () => {\n  it('should insert text at position 0 in empty string', () => {\n    const op: Operation = { type: 'insert', pos: 0, text: 'hello', clientId: CLIENT_A };\n    expect(applyOperation('', op)).toBe('hello');\n  });\n\n  it('should insert text in the middle', () => {\n    const op: Operation = { type: 'insert', pos: 5, text: ' world', clientId: CLIENT_A };\n    expect(applyOperation('hello', op)).toBe('hello world');\n  });\n\n  it('should insert text at the end', () => {\n    const op: Operation = { type: 'insert', pos: 5, text: '!', clientId: CLIENT_A };\n    expect(applyOperation('hello', op)).toBe('hello!');\n  });\n\n  it('should reject insert beyond content length', () => {\n    const op: Operation = { type: 'insert', pos: 10, text: 'x', clientId: CLIENT_A };\n    expect(() => applyOperation('hello', op)).toThrow();\n  });\n\n  it('should delete text at position', () => {\n    const op: Operation = { type: 'delete', pos: 0, length: 2, clientId: CLIENT_A };\n    expect(applyOperation('hello', op)).toBe('llo');\n  });\n\n  it('should delete text in the middle', () => {\n    const op: Operation = { type: 'delete', pos: 1, length: 3, clientId: CLIENT_A };\n    expect(applyOperation('hello', op)).toBe('ho');\n  });\n\n  it('should reject delete extending past end', () => {\n    const op: Operation = { type: 'delete', pos: 3, length: 5, clientId: CLIENT_A };\n    expect(() => applyOperation('hello', op)).toThrow();\n  });\n});\n\ndescribe('transform: insert vs insert', () => {\n  it('should keep inserts at different positions unchanged', () => {\n    const a: Operation = { type: 'insert', pos: 0, text: 'A', clientId: CLIENT_A };\n    const b: Operation = { type: 'insert', pos: 1, text: 'B', clientId: CLIENT_B };\n    const [aPrime, bPrime] = transform(a, b);\n    expect(aPrime).not.toBeNull();\n    expect(bPrime).not.toBeNull();\n    // a pos 0 < b pos 1, so a unchanged, b shifts right by 1\n    expect(aPrime!.pos).toBe(0);\n    expect(bPrime!.pos).toBe(2);\n  });\n\n  it('should handle same position with clientId ordering (A < B)', () => {\n    const a: Operation = { type: 'insert', pos: 0, text: 'A', clientId: 'a' };\n    const b: Operation = { type: 'insert', pos: 0, text: 'B', clientId: 'b' };\n    const [aPrime, bPrime] = transform(a, b);\n    expect(aPrime).not.toBeNull();\n    expect(bPrime).not.toBeNull();\n    // 'a' < 'b', so a stays at 0, b shifts to 1\n    expect(aPrime!.pos).toBe(0);\n    expect(bPrime!.pos).toBe(1);\n  });\n\n  it('should handle same position with clientId ordering (B < A)', () => {\n    const a: Operation = { type: 'insert', pos: 0, text: 'A', clientId: 'z' };\n    const b: Operation = { type: 'insert', pos: 0, text: 'B', clientId: 'a' };\n    const [aPrime, bPrime] = transform(a, b);\n    expect(aPrime).not.toBeNull();\n    expect(bPrime).not.toBeNull();\n    // 'a' < 'z', so b stays at 0, a shifts to 1\n    expect(bPrime!.pos).toBe(0);\n    expect(aPrime!.pos).toBe(1);\n  });\n\n  it('should converge (insert vs insert)', () => {\n    const S = 'hello';\n    const a: Operation = { type: 'insert', pos: 2, text: 'AA', clientId: CLIENT_A };\n    const b: Operation = { type: 'insert', pos: 4, text: 'BB', clientId: CLIENT_B };\n    const [aPrime, bPrime] = transform(a, b);\n    expect(aPrime).not.toBeNull();\n    expect(bPrime).not.toBeNull();\n    const r1 = applyOperation(applyOperation(S, a), bPrime!);\n    const r2 = applyOperation(applyOperation(S, b), aPrime!);\n    expect(r1).toBe(r2);\n  });\n});\n\ndescribe('transform: insert vs delete', () => {\n  it('should shift delete position right when inserting before it', () => {\n    const S = 'hello world';\n    const ins: Operation = { type: 'insert', pos: 0, text: '!!', clientId: CLIENT_A };\n    const del: Operation = { type: 'delete', pos: 5, length: 5, clientId: CLIENT_B };\n    const [insPrime, delPrime] = transform(ins, del);\n    expect(insPrime).not.toBeNull();\n    expect(delPrime).not.toBeNull();\n    // insert at 0 pushes content right, delete at 5 → 7\n    expect(insPrime!.pos).toBe(0);\n    expect((delPrime as Operation).pos).toBe(7);\n  });\n\n  it('should shift insert position left when deleting before it', () => {\n    const S = 'hello world';\n    const del: Operation = { type: 'delete', pos: 0, length: 5, clientId: CLIENT_A };\n    const ins: Operation = { type: 'insert', pos: 6, text: '!!', clientId: CLIENT_B };\n    const [delPrime, insPrime] = transform(del, ins);\n    // del at 0 stays, ins at 6 shifts to 1 (after deletion of 0..5)\n    expect(insPrime)