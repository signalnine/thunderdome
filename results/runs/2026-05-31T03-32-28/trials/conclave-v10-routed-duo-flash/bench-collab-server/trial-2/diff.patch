+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { DocDatabase } from '../src/db.js';
+
+describe('DocDatabase', () => {
+  let db: DocDatabase;
+
+  beforeEach(() => {
+    db = new DocDatabase(':memory:');
+  });
+
+  afterEach(() => {
+    db.close();
+  });
+
+  describe('Document CRUD', () => {
+    it('should create a document', () => {
+      const doc = db.createDocument('Test Doc');
+      expect(doc.id).toBeTruthy();
+      expect(doc.title).toBe('Test Doc');
+      expect(doc.content).toBe('');
+      expect(doc.created_at).toBeTruthy();
+      expect(doc.updated_at).toBeTruthy();
+    });
+
+    it('should get a document by id', () => {
+      const created = db.createDocument('My Doc');
+      const fetched = db.getDocument(created.id);
+      expect(fetched).not.toBeNull();
+      expect(fetched!.title).toBe('My Doc');
+    });
+
+    it('should return null for non-existent document', () => {
+      const doc = db.getDocument('non-existent-id');
+      expect(doc).toBeNull();
+    });
+
+    it('should list all documents', () => {
+      db.createDocument('Doc 1');
+      db.createDocument('Doc 2');
+      const docs = db.listDocuments();
+      expect(docs.length).toBe(2);
+    });
+
+    it('should update a document', () => {
+      const created = db.createDocument('Original');
+      const updated = db.updateDocument(created.id, 'Updated', 'new content');
+      expect(updated).not.toBeNull();
+      expect(updated!.title).toBe('Updated');
+      expect(updated!.content).toBe('new content');
+    });
+
+    it('should return null when updating non-existent doc', () => {
+      const result = db.updateDocument('bad-id', 'Title');
+      expect(result).toBeNull();
+    });
+
+    it('should delete a document', () => {
+      const created = db.createDocument('To Delete');
+      const deleted = db.deleteDocument(created.id);
+      expect(deleted).toBe(true);
+      expect(db.getDocument(created.id)).toBeNull();
+    });
+
+    it('should return false when deleting non-existent doc', () => {
+      expect(db.deleteDocument('bad-id')).toBe(false);
+    });
+  });
+
+  describe('Version History', () => {
+    it('should add and retrieve versions', () => {
+      const doc = db.createDocument('Versioned');
+      db.addVersion(doc.id, 1, 'initial content', JSON.stringify({ type: 'insert', pos: 0, text: 'initial content' }));
+      db.addVersion(doc.id, 2, 'updated content', JSON.stringify({ type: 'insert', pos: 7, text: 'updated ' }));
+
+      const versions = db.getVersions(doc.id);
+      expect(versions.length).toBe(2);
+      expect(versions[0].version).toBe(1);
+      expect(versions[0].content).toBe('initial content');
+      expect(versions[1].version).toBe(2);
+    });
+
+    it('should get latest version number (0 for new doc)', () => {
+      const doc = db.createDocument('Fresh');
+      expect(db.getLatestVersion(doc.id)).toBe(0);
+    });
+
+    it('should get latest version number', () => {
+      const doc = db.createDocument('Versioned');
+      db.addVersion(doc.id, 1, 'v1', null);
+      db.addVersion(doc.id, 2, 'v2', null);
+      expect(db.getLatestVersion(doc.id)).toBe(2);
+    });
+  });
+
+  describe('Active Connections', () => {
+    it('should add and remove connections', () => {
+      const doc = db.createDocument('Collab');
+      db.addConnection('conn-1', doc.id);
+      expect(db.getConnectionCount(doc.id)).toBe(1);
+
+      db.addConnection('conn-2', doc.id);
+      expect(db.getConnectionCount(doc.id)).toBe(2);
+
+      db.removeConnection('conn-1');
+      expect(db.getConnectionCount(doc.id)).toBe(1);
+
+      db.removeConnection('conn-2');
+      expect(db.getConnectionCount(doc.id)).toBe(0);
+    });
+  });
+});
