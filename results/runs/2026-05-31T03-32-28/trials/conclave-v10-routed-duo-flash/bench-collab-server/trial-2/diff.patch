throw new Error(\n          `Delete ${comp.count} exceeds remaining content length ${content.length - idx}`\n        );\n      }\n      idx += comp.count;\n    }\n  }\n\n  if (idx !== content.length) {\n    throw new Error(\n      `Operation didn't cover entire content: consumed ${idx} of ${content.length} characters`\n    );\n  }\n\n  return result;\n}\n\n/**\n * Apply a simple atomic Operation to a string.\n * Internally converts to component-based and applies.\n */\nexport function applyOperation(content: string, op: Operation): string {\n  return applyOp(content, toComponents(op));\n}\n\n// ---- Transform ----\n\n/**\n * Transform operation A against operation B (both relative to the same base string).\n * Returns [A', B'] such that:\n *   apply(apply(S, A), B') === apply(apply(S, B), A')\n *\n * This is the standard OT transform for component-based operations.\n * Each component of A is transformed against each component of B in lockstep.\n */\nexport function transform(\n  a: Operation,\n  b: Operation\n): [Operation | null, Operation | null] {\n  const aComps = toComponents(a);\n  const bComps = toComponents(b);\n\n  const aOut: Op = [];\n  const bOut: Op = [];\n\n  let i = 0, j = 0;\n\n  while (i < aComps.length && j < bComps.length) {\n    const ca = aComps[i];\n    const cb = bComps[j];\n\n    if (ca.type === 'retain' && cb.type === 'retain') {\n      const minCount = Math.min(ca.count, cb.count);\n      aOut.push(rmain(ca, minCount));\n      bOut.push(rmain(cb, minCount));\n      if (ca.count === minCount) i++; else { ca.count -= minCount; }\n      if (cb.count === minCount) j++; else { cb.count -= minCount; }\n    } else if (ca.type === 'retain' && cb.type === 'insert') {\n      aOut.push(cb); // A retains past B's insert → output B's insert for A\n      bOut.push(cb); // B's insert stays\n      j++;\n    } else if (ca.type === 'insert' && cb.type === 'retain') {\n      aOut.push(ca); // A's insert stays\n      bOut.push(ca); // B retains past A's insert