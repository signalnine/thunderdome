d = applyOp(S, result);","-    expect(applied).toBe(applyOperation(applyOperation(S, against[0]), op));","+    expect(result).not.toBeNull();","+    // After delete(0,1) on \"abc\" → \"bc\". Insert(1,'X') → transforms to insert(0,'X') on \"bc\" → \"Xbc\"","+    const r1 = applyOperation(applyOperation(S, against[0]), result!);","+    const r2 = applyOperation(applyOperation(S, op), against[0]);","+    expect(r1).toBe(r2);","   });"," });"]}],"originalFile":"import { describe, it, expect } from 'vitest';\nimport { applyOperation, applyOp, transform, transformAgainst, toAtomicOp } from '../src/ot.js';\nimport type { Operation } from '../src/types.js';\n\nconst CLIENT_A = 'client-a';\nconst CLIENT_B = 'client-b';\n\ndescribe('applyOperation', () => {\n  it('should insert text at position 0 in empty string', () => {\n    const op: Operation = { type: 'insert', pos: 0, text: 'hello', clientId: CLIENT_A };\n    expect(applyOperation('', op)).toBe('hello');\n  });\n\n  it('should insert text in the middle', () => {\n    const op: Operation = { type: 'insert', pos: 5, text: ' world', clientId: CLIENT_A };\n    expect(applyOperation('hello', op)).toBe('hello world');\n  });\n\n  it('should insert text at the end', () => {\n    const op: Operation = { type: 'insert', pos: 5, text: '!', clientId: CLIENT_A };\n    expect(applyOperation('hello', op)).toBe('hello!');\n  });\n\n  it('should reject insert beyond content length', () => {\n    const op: Operation = { type: 'insert', pos: 10, text: 'x', clientId: CLIENT_A };\n    expect(() => applyOperation('hello', op)).toThrow();\n  });\n\n  it('should delete text at beginning', () => {\n    const op: Operation = { type: 'delete', pos: 0, length: 2, clientId: CLIENT_A };\n    expect(applyOperation('hello', op)).toBe('llo');\n  });\n\n  it('should delete text in the middle', () => {\n    const op: Operation = { type: 'delete', pos: 1, length: 3, clientId: CLIENT_A };\n    expect(applyOperation('hello', op)).toBe('ho');\n  });\n\n  it('should reject delete extending past end', () => {\n    const op: Operation = { type: 'delete', pos: 3, length: 5, clientId: CLIENT_A };\n    expect(() => applyOperation('hello', op)).toThrow();\n  });\n});\n\ndescribe('transform: insert vs insert', () => {\n  it('should keep inserts at different positions unchanged', () => {\n    const a: Operation = { type: 'insert', pos: 0, text: 'A', clientId: CLIENT_A };\n    const b: Operation = { type: 'insert', pos: 1, text: 'B', clientId: CLIENT_B };\n    const [aPrime, bPrime] = transform(a, b);\n    // A at pos 0, B at pos 1: A before B, so A stays, B shifts right\n    const r1 = applyOp(applyOperation('', a), bPrime);\n    const r2 = applyOp(applyOperation('', b), aPrime);\n    expect(r1).toBe(r2);\n    expect(r1).toBe('AB');\n  });\n\n  it('should handle same position with clientId ordering (A < B)', () => {\n    const a: Operation = { type: 'insert', pos: 0, text: 'A', clientId: 'a' };\n    const b: Operation = { type: 'insert', pos: 0, text: 'B', clientId: 'b' };\n    const [aPrime, bPrime] = transform(a, b);\n    const r1 = applyOp(applyOperation('', a), bPrime);\n    const r2 = applyOp(applyOperation('', b), aPrime);\n    expect(r1).toBe(r2);\n    // 'a' < 'b', so A first then B\n    expect(r1).toBe('AB');\n  });\n\n  it('should handle same position with clientId ordering (B < A)', () => {\n    const a: Operation = { type: 'insert', pos: 0, text: 'A', clientId: 'z' };\n    const b: Operation = { type: 'insert', pos: 0, text: 'B', clientId: 'a' };\n    const [aPrime, bPrime] = transform(a, b);\n    const r1 = applyOp(applyOperation('', a), bPrime);\n    const r2 = applyOp(applyOperation('', b), aPrime);\n    expect(r1).toBe(r2);\n    // 'a' < 'z', so B first then A\n    expect(r1).toBe('BA');\n  });\n\n  it('should converge (insert vs insert)', () => {\n    const S = 'hello';\n    const a: Operation = { type: 'insert', pos: 2, text: 'AA', clientId: CLIENT_A };\n    const b: Operation = { type: 'insert', pos: 4, text: 'BB', clientId: CLIENT_B };\n    const [aPrime, bPrime] = transform(a, b);\n    const r1 = applyOp(applyOperation(S, a), bPrime);\n    const r2 = applyOp(applyOperation(S, b), aPrime);\n    expect(r1).toBe(r2);\n  });\n});\n\ndescribe('transform: insert vs delete', () => {\n  it('should converge when inserting before delete', () => {\n    const S = 'hello world';\n    const ins: Operation = { type: 'insert', pos: 0, text: '!!', clientId: CLIENT_A };\n    const del: Operation = { type: 'delete', pos: 5, length: 5, clientId: CLIENT_B };\n    const [insPrime, delPrime] = transform(ins, del);\n    const r1 = applyOp(applyOperation(S, ins), delPrime);\n    const r2 = applyOp(applyOperation(S, del), insPrime);\n    expect(r1).toBe(r2);\n    expect(r1).toBe('!!hello ');\n  });\n\n  it('should converge when inserting after delete', () => {\n    const S = 'hello world';\n    const del: Operation = { type: 'delete', pos: 0, length: 5, clientId: CLIENT_A };\n    const ins: Operation = { type: 'insert', pos: 6, text: '!!', clientId: CLIENT_B };\n    const [delPrime, insPrime] = transform(del, ins);\n    const r1 = applyOp(applyOperation(S, del), insPrime);\n    const r2 = applyOp(applyOperation(S, ins), delPrime);\n    expect(r1).toBe(r2);\n    expect(r1).toBe(' world!!');\n  });\n\n  it('should converge with insert at delete start', () => {\n    const S = 'hello';\n    const ins: Operation = { type: 'insert', pos: 2, text: 'XX', clientId: CLIENT_A };\n    const del: Operation = { type: 'delete', pos: 2, length: 2, clientId: CLIENT_B };\n    const [insPrime, delPrime] = transform(ins, del);\n    const r1 = applyOp(applyOperation(S, ins), delPrime);\n    const r2 = applyOp(applyOperation(S, del), insPrime);\n    expect(r1).toBe(r2);\n  });\n\n  it('should converge (insert vs delete comprehensive)', () => {\n    const S = 'abcdef';\n    const ins: Operation = { type: 'insert', pos: 3, text: 'XYZ', clientId: CLIENT_A };\n    const del: Operation = { type: 'delete', pos: 0, length: 2, clientId: CLIENT_B };\n    const [insPrime, delPrime] = transform(ins, del);\n    const r1 = applyOp(applyOperation(S, ins), delPrime);\n    const r2 = applyOp(applyOperation(S, del), insPrime);\n    expect(r1).toBe(r2);\n  });\n});\n\ndescribe('transform: delete vs delete (no overlap)', () => {\n  it('should handle delete before delete (no overlap)', () => {\n    const S = 'abcdefgh';\n    const a: Operation = { type: 'delete', pos: 0, length: 2, clientId: CLIENT_A };\n    const b: Operation = { type: 'delete', pos: 4, length: 2, clientId: CLIENT_B };\n    const [aPrime, bPrime] = transform(a, b);\n    const r1 = applyOp(applyOperation(S, a), bPrime);\n    const r2 = applyOp(applyOperation(S, b), aPrime);\n    expect(r1).toBe(r2);\n    expect(r1).toBe('cdef');\n  });\n});\n\ndescribe('transform: delete vs delete (overlap)', () => {\n  it('should handle one containing the other', () => {\n    const S = 'hello world';\n    // A deletes [2, 7) = \"llo w\"\n    const a: Operation = { type: 'delete', pos: 2, length: 5, clientId: CLIENT_A };\n    // B deletes [3, 5) = \"lo\"\n    const b: Operation = { type: 'delete', pos: 3, length: 2, clientId: CLIENT_B };\n    const [aPrime, bPrime] = transform(a, b);\n    const r1 = applyOp(applyOperation(S, a), bPrime);\n    const r2 = applyOp(applyOperation(S, b), aPrime);\n    expect(r1).toBe(r2);\n    // Both deletions should result in \"heorld\"\n    expect(r1).toBe('heorld');\n  });\n\n  it('should handle identical deletes', () => {\n    const S = 'hello';\n    const a: Operation = { type: 'delete', pos: 1, length: 2, clientId: CLIENT_A };\n    const b: Operation = { type: 'delete', pos: 1, length: 2, clientId: CLIENT_B };\n    const [aPrime, bPrime] = transform(a, b);\n    const r1 = applyOp(applyOperation(S, a), bPrime);\n    const r2 = applyOp(applyOperation(S, b), aPrime);\n    expect(r1).toBe(r2);\n    expect(r1).toBe('hlo');\n  });\n\n  it('should handle partial overlap (A starts first, extends into B)', () => {\n    const S = 'hello world';\n    // A deletes [2, 5) = \"llo \"\n    const a: Operation = { type: 'delete', pos: 2, length: 3, clientId: CLIENT_A };\n    // B deletes [4, 7) = \"o w\"\n    const b: Operation = { type: 'delete', pos: 4, length: 3, clientId: CLIENT_B };\n    const [aPrime, bPrime] = transform(a, b);\n    const r1 = applyOp(applyOperation(S, a), bPrime);\n    const r2 = applyOp(applyOperation(S, b), aPrime);\n    expect(r1).toBe(r2);\n  });\n\n  it('should converge with partial overlap (B starts first)', () => {\n    const S = 'abcdefghij';\n    const a: Operation = { type: 'delete', pos: 5, length: 3, clientId: CLIENT_A };\n    const b: Operation = { type: 'delete', pos: 2, length: 4, clientId: CLIENT_B };\n    const [aPrime, bPrime] = transform(a, b);\n    const r1 = applyOp(applyOperation(S, a), bPrime);\n    const r2 = applyOp(applyOperation(S, b), aPrime);\n    expect(r1).toBe(r2);\n  });\n});\n\ndescribe('transform: convergence property - comprehensive', () => {\n  const CASES: { S: string; a: Operation; b: Operation }[] = [\n    { S: 'abc', a: { type: 'insert', pos: 0, text: 'X', clientId: CLIENT_A },\n      b: { type: 'insert', pos: 1, text: 'Y', clientId: CLIENT_B } },\n    { S: 'abc', a: { type: 'insert', pos: 1, text: 'X', clientId: CLIENT_A },\n      b: { type: 'delete', pos: 0, length: 2, clientId: CLIENT_B } },\n    { S: 'abc', a: { type: 'delete', pos: 0, length: 1, clientId: CLIENT_A },\n      b: { type: 'insert', pos: 2, text: 'Z', clientId: CLIENT_B } },\n    { S: 'hello world', a: { type: 'delete', pos: 2, length: 3, clientId: CLIENT_A },\n      b: { type: 'delete', pos: 4, length: 3, clientId: CLIENT_B } },\n    { S: 'hello world', a: { type: 'delete', pos: 4, length: 3, clientId: CLIENT_A },\n      b: { type: 'delete', pos: 2, length: 3, clientId: CLIENT_B } },\n    { S: 'test', a: { type: 'insert', pos: 2, text: '!!', clientId: CLIENT_A },\n      b: { type: 'insert', pos: 2, text: '@@', clientId: CLIENT_B } },\n    { S: 'xyz', a: { type: 'delete', pos: 0, length: 1, clientId: CLIENT_A },\n      b: { type: 'delete', pos: 1, length: 1, clientId: CLIENT_B } },\n    { S: 'abcdef', a: { type: 'insert', pos: 3, text: 'XY', clientId: CLIENT_A },\n      b: { type: 'delete', pos: 1, length: 4, clientId: CLIENT_B } },\n    { S: 'hello', a: { type: 'insert', pos: 5, text: '!', clientId: CLIENT_A },\n      b: { type: 'insert', pos: 0, text: '>', clientId: CLIENT_B } },\n  ];\n\n  for (const { S, a, b } of CASES) {\n    it(`should converge for ops on \"${S}\"`, () => {\n      const [aPrime, bPrime] = transform(a, b);\n      const r1 = applyOp(applyOperation(S, a), bPrime);\n      const r2 = applyOp(applyOperation(S, b), aPrime);\n      expect(r1).toBe(r2);\n    });\n  }\n});\n\ndescribe('transform: return type', () => {\n  it('should return a tuple of two component arrays', () => {\n    const a: Operation = { type: 'insert', pos: 0, text: 'x', clientId: CLIENT_A };\n    const b: Operation = { type: 'insert', pos: 1, text: 'y', clientId: CLIENT_B };\n    const result = transform(a, b);\n    expect(Array.isArray(result)).toBe(true);\n    expect(result.length).toBe(2);\n    expect(Array.isArray(result[0])).toBe(true);\n    expect(Array.isArray(result[1])).toBe(true);\n  });\n});\n\ndescribe('transformAgainst', () => {\n  it('should transform through multiple intervening operations', () => {\n    const S = 'abc';\n    const op: Operation = { type: 'insert', pos: 1, text: 'X', clientId: CLIENT_A };\n    const against: Operation[] = [\n      { type: 'delete', pos: 0, length: 1, clientId: CLIENT_B },\n    ];\n    const result = transformAgainst(op, against);\n    // After delete(0,1): \"bc\". Insert(1,'X') → transform → insert(0,'X') → \"Xbc\"\n    const applied = applyOp(S, result);\n    expect(applied).toBe(applyOperation(applyOperation(S, against[0]), op));\n  });\n});\n","userModified":false}}
