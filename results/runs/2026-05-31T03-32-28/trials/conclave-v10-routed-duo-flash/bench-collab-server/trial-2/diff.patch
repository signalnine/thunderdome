--- /dev/null
+++ b/src/wsHandler.ts
@@ -0,0 +1,261 @@
+import { WebSocket, WebSocketServer } from 'ws';
+import type { Server } from 'http';
+import type { DocDatabase } from './db.js';
+import type { Operation } from './types.js';
+import { applyOperation, transform } from './ot.js';
+
+interface DocRoom {
+  docId: string;
+  clients: Map<string, WsClient>;
+}
+
+interface WsClient {
+  ws: WebSocket;
+  connId: string;
+  docId: string;
+}
+
+export class CollabWSServer {
+  private wss: WebSocketServer;
+  private rooms: Map<string, DocRoom> = new Map();
+  private db: DocDatabase;
+
+  constructor(server: Server, db: DocDatabase) {
+    this.db = db;
+
+    // Create WebSocketServer with noServer mode (we handle upgrades manually)
+    this.wss = new WebSocketServer({ noServer: true });
+
+    // Handle upgrades on the HTTP server for paths starting with /document/
+    server.on('upgrade', (request, socket, head) => {
+      const url = request.url ?? '';
+      if (url.startsWith('/document/')) {
+        this.wss.handleUpgrade(request, socket, head, (ws) => {
+          this.wss.emit('connection', ws, request);
+        });
+      } else {
+        socket.destroy();
+      }
+    });
+
+    this.wss.on('connection', (ws, req) => {
+      this.handleConnection(ws, req);
+    });
+  }
+
+  private handleConnection(ws: WebSocket, req: import('http').IncomingMessage): void {
+    const url = req.url ?? '';
+    const docId = url.replace('/document/', '').split('?')[0];
+
+    if (!docId) {
+      ws.close(4000, 'Document ID required');
+      return;
+    }
+
+    // Verify document exists
+    const doc = this.db.getDocument(docId);
+    if (!doc) {
+      ws.close(4004, 'Document not found');
+      return;
+    }
+
+    const connId = crypto.randomUUID();
+
+    // Track connection
+    this.db.addConnection(connId, docId);
+
+    // Add to room
+    let room = this.rooms.get(docId);
+    if (!room) {
+      room = { docId, clients: new Map() };
+      this.rooms.set(docId, room);
+    }
+    const client: WsClient = { ws, connId, docId };
+    room.clients.set(connId, client);
+
+    const version = this.db.getLatestVersion(docId);
+
+    // Send initial sync
+    this.send(ws, {
+      type: 'sync',
+      content: doc.content,
+      version,
+    });
+
+    // Handle messages
+    ws.on('message', (data) => {
+      try {
+        const message = JSON.parse(data.toString());
+
+        if (message.type === 'operation') {
+          this.handleOperation(client, message);
+        }
+      } catch {
+        this.send(ws, { type: 'error', message: 'Invalid message format' });
+      }
+    });
+
+    // Handle close
+    ws.on('close', () => {
+      try { this.db.removeConnection(connId); } catch { /* DB may be closed */ }
+      room?.clients.delete(connId);
+      if (room && room.clients.size === 0) {
+        this.rooms.delete(docId);
+      }
+    });
+
+    ws.on('error', () => {
+      try { this.db.removeConnection(connId); } catch { /* DB may be closed */ }
+      room?.clients.delete(connId);
+    });
+  }
+
+  private handleOperation(
+    client: WsClient,
+    message: { type: string; op: Operation; version: number }
+  ): void {
+    const { op, version: clientVersion } = message;
+
+    // Validate operation fields
+    if (!op || !op.type) {
+      this.send(client.ws, { type: 'error', message: 'Invalid operation' });
+      return;
+    }
+
+    const doc = this.db.getDocument(client.docId);
+    if (!doc) {
+      this.send(client.ws, { type: 'error', message: 'Document not found' });
+      return;
+    }
+
+    const currentVersion = this.db.getLatestVersion(client.docId);
+
+    let transformedOp: Operation | null = op;
+    const currentContent = doc.content;
+
+    // If client version is stale, transform through intervening operations
+    if (clientVersion < currentVersion) {
+      const interveningOps = this.getInterveningOps(
+        client.docId,
+        clientVersion,
+        currentVersion
+      );
+      for (const other of interveningOps) {
+        if (transformedOp === null) break;
+        const [prime] = transform(transformedOp, other);
+        transformedOp = prime;
+      }
+    }
+
+    if (transformedOp === null) {
+      // Operation is a no-op after transformation
+      this.send(client.ws, { type: 'ack', version: currentVersion });
+      return;
+    }
+
+    // Validate the transformed operation can be applied
+    try {
+      if (transformedOp.type === 'insert') {
+        if (transformedOp.pos < 0 || transformedOp.pos > currentContent.length) {
+          this.send(client.ws, {
+            type: 'error',
+            message: 'Insert position out of bounds',
+          });
+          return;
+        }
+      } else if (transformedOp.type === 'delete') {
+        if (
+          transformedOp.pos < 0 ||
+          transformedOp.pos + transformedOp.length > currentContent.length
+        ) {
+          this.send(client.ws, {
+            type: 'error',
+            message: 'Delete range out of bounds',
+          });
+          return;
+        }
+      }
+    } catch {
+      this.send(client.ws, { type: 'error', message: 'Invalid operation' });
+      return;
+    }
+
+    // Apply operation
+    let newContent: string;
+    try {
+      newContent = applyOperation(currentContent, transformedOp);
+    } catch {
+      this.send(client.ws, { type: 'error', message: 'Failed to apply operation' });
+      return;
+    }
+
+    const newVersion = currentVersion + 1;
+
+    // Store version and update document
+    this.db.addVersion(
+      client.docId,
+      newVersion,
+      newContent,
+      JSON.stringify(transformedOp)
+    );
+    this.db.updateDocument(client.docId, undefined, newContent);
+
+    // Send acknowledgement to sender
+    this.send(client.ws, { type: 'ack', version: newVersion });
+
+    // Broadcast to all OTHER clients in the room
+    const room = this.rooms.get(client.docId);
+    if (room) {
+      const broadcast = {
+        type: 'operation',
+        op: transformedOp,
+        version: newVersion,
+        clientId: client.connId,
+      };
+      for (const [otherId, otherClient] of room.clients) {
+        if (otherId !== client.connId && otherClient.ws.readyState === WebSocket.OPEN) {
+          this.send(otherClient.ws, broadcast);
+        }
+      }
+    }
+  }
+
+  private getInterveningOps(
+    docId: string,
+    fromVersion: number,
+    toVersion: number
+  ): Operation[] {
+    const versions = this.db.getVersions(docId);
+    const ops: Operation[] = [];
+    for (const v of versions) {
+      if (v.version > fromVersion && v.version <= toVersion && v.operation) {
+        try {
+          const parsed = JSON.parse(v.operation);
+          if (parsed && parsed.type) {
+            ops.push(parsed as Operation);
+          }
+        } catch {
+          // Skip unparseable operations
+        }
+      }
+    }
+    return ops;
+  }
+
+  private send(ws: WebSocket, data: unknown): void {
+    if (ws.readyState === WebSocket.OPEN) {
+      ws.send(JSON.stringify(data));
+    }
+  }
+
+  close(): void {
+    // Close all connections
+    for (const room of this.rooms.values()) {
+      for (const client of room.clients.values()) {
+        client.ws.close();
+      }
+    }
+    this.rooms.clear();
+    this.wss.close();
+  }
+}
