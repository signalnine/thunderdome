@@ -0,0 +1,68 @@
+import express from 'express';
+import { createServer, type Server } from 'http';
+import type { Application } from 'express';
+import { DocDatabase } from './db.js';
+import { createRouter } from './routes.js';
+import { CollabWSServer } from './wsHandler.js';
+
+export interface AppInstance {
+  app: Application;
+  start: (port?: number) => Promise<number>;
+  stop: () => Promise<void>;
+}
+
+export function createApp(dbPath?: string): AppInstance {
+  const db = new DocDatabase(dbPath);
+  const app = express();
+  let server: Server | null = null;
+  let wsServer: CollabWSServer | null = null;
+  let started = false;
+
+  // Middleware
+  app.use(express.json());
+
+  // API routes
+  app.use('/api', createRouter(db));
+
+  // Health check
+  app.get('/health', (_req, res) => {
+    res.json({ status: 'ok' });
+  });
+
+  async function start(port?: number): Promise<number> {
+    if (started) {
+      throw new Error('Server already started');
+    }
+
+    return new Promise((resolve) => {
+      server = createServer(app);
+
+      // Create WebSocket server (it hooks into the HTTP server)
+      wsServer = new CollabWSServer(server, db);
+
+      const listenPort = port ?? 0;
+      server.listen(listenPort, () => {
+        const addr = server!.address();
+        const actualPort = typeof addr === 'object' && addr ? addr.port : listenPort;
+        started = true;
+        resolve(actualPort);
+      });
+    });
+  }
+
+  async function stop(): Promise<void> {
+    if (!started || !server) return;
+
+    return new Promise((resolve) => {
+      wsServer?.close();
+
+      server!.close(() => {
+        db.close();
+        started = false;
+        resolve();
+      });
+    });
+  }
+
+  return { app, start, stop };
+}
