@@ -0,0 +1,250 @@
+import { describe, it, expect } from 'vitest';
+import { solveToggle, solveCounter } from './index.js';
+
+function verifyToggle(target: boolean[], buttons: number[][], pressed: number[]): boolean {
+  const state = new Array(target.length).fill(false);
+  for (const b of pressed) {
+    for (const light of buttons[b]) {
+      state[light] = !state[light];
+    }
+  }
+  return state.every((v, i) => v === target[i]);
+}
+
+function verifyCounter(target: number[], buttons: number[][], modulus: number, presses: number[]): boolean {
+  const state = new Array(target.length).fill(0);
+  for (let b = 0; b < presses.length; b++) {
+    for (const counter of buttons[b]) {
+      state[counter] = (state[counter] + presses[b]) % modulus;
+    }
+  }
+  return state.every((v, i) => v === target[i]);
+}
+
+describe('solveToggle', () => {
+  it('C1: basic single-button solution', () => {
+    const result = solveToggle({
+      target: [true, true, false],
+      buttons: [[0, 1], [1, 2]],
+    });
+    expect(result).toEqual([0]);
+    expect(verifyToggle([true, true, false], [[0, 1], [1, 2]], result!)).toBe(true);
+  });
+
+  it('C2: multi-button solution', () => {
+    const result = solveToggle({
+      target: [true, false, true],
+      buttons: [[0, 1], [1, 2]],
+    });
+    expect(result).toEqual([0, 1]);
+    expect(verifyToggle([true, false, true], [[0, 1], [1, 2]], result!)).toBe(true);
+  });
+
+  it('C3: no solution returns null (from task example)', () => {
+    const result = solveToggle({
+      target: [true, true, false, true],
+      buttons: [[0, 1], [1, 2, 3], [0, 3]],
+    });
+    expect(result).toBeNull();
+  });
+
+  it('C4: minimum presses', () => {
+    const result = solveToggle({
+      target: [true, false, false],
+      buttons: [[0], [0, 1], [1]],
+    });
+    expect(result).toEqual([0]);
+    expect(verifyToggle([true, false, false], [[0], [0, 1], [1]], result!)).toBe(true);
+  });
+
+  it('C5: lexicographic tiebreaker', () => {
+    const result = solveToggle({
+      target: [true],
+      buttons: [[0], [0]],
+    });
+    expect(result).toEqual([0]);
+  });
+
+  it('C6: all-off target', () => {
+    const result = solveToggle({
+      target: [false, false, false],
+      buttons: [[0, 1], [1, 2]],
+    });
+    expect(result).toEqual([]);
+  });
+
+  it('C7: large instance (40 buttons, 40 lights)', () => {
+    const n = 40;
+    const buttons: number[][] = [];
+    for (let i = 0; i < n; i++) {
+      buttons.push([i]);
+    }
+    const target = new Array(n).fill(true);
+
+    const start = performance.now();
+    const result = solveToggle({ target, buttons });
+    const elapsed = performance.now() - start;
+
+    expect(elapsed).toBeLessThan(5000);
+    expect(result).not.toBeNull();
+    expect(result!.length).toBe(40);
+    expect(verifyToggle(target, buttons, result!)).toBe(true);
+  });
+
+  it('C8: toggling is commutative / order independent', () => {
+    const target: boolean[] = [true, true, true];
+    const buttons: number[][] = [[0, 1], [1, 2], [0, 2]];
+    const result = solveToggle({ target, buttons });
+    if (result) {
+      expect(verifyToggle(target, buttons, result)).toBe(true);
+    }
+  });
+
+  it('handles empty buttons', () => {
+    const result = solveToggle({
+      target: [true],
+      buttons: [],
+    });
+    expect(result).toBeNull();
+  });
+
+  it('handles empty target', () => {
+    const result = solveToggle({
+      target: [],
+      buttons: [],
+    });
+    expect(result).toEqual([]);
+  });
+
+  it('identity-like: each button controls one light', () => {
+    const result = solveToggle({
+      target: [true, false, true, false, true],
+      buttons: [[0], [1], [2], [3], [4]],
+    });
+    expect(result).toEqual([0, 2, 4]);
+  });
+
+  it('multiple valid solutions - picks minimum then lex smallest', () => {
+    const result = solveToggle({
+      target: [true, true],
+      buttons: [[0, 1], [0], [1]],
+    });
+    expect(result).toEqual([0]);
+  });
+
+  it('large with free variables', () => {
+    const buttons: number[][] = [];
+    const n = 20;
+    for (let i = 0; i < n; i++) {
+      buttons.push([i % 10]);
+    }
+    const target = new Array(10).fill(false);
+    target[0] = true;
+
+    const start = performance.now();
+    const result = solveToggle({ target, buttons });
+    const elapsed = performance.now() - start;
+
+    expect(elapsed).toBeLessThan(5000);
+    expect(result).not.toBeNull();
+    expect(verifyToggle(target, buttons, result!)).toBe(true);
+    expect(result!.length).toBe(1);
+  });
+});
+
+describe('solveCounter', () => {
+  it('C9: basic counter solution', () => {
+    const result = solveCounter([1, 1], [[0], [1]], 5);
+    expect(result).toEqual([1, 1]);
+    expect(verifyCounter([1, 1], [[0], [1]], 5, result!)).toBe(true);
+  });
+
+  it('C10: no counter solution returns null', () => {
+    const result = solveCounter([1, 2], [[0, 1]], 5);
+    expect(result).toBeNull();
+  });
+
+  it('C11: minimum total presses', () => {
+    const result = solveCounter([2], [[0], [0]], 5);
+    expect(result).not.toBeNull();
+    expect(verifyCounter([2], [[0], [0]], 5, result!)).toBe(true);
+    const sum = result!.reduce((a, b) => a + b, 0);
+    expect(sum).toBe(2);
+  });
+
+  it('C12: lexicographic tiebreaker for counters', () => {
+    const result = solveCounter([1], [[0], [0]], 5);
+    expect(result).toEqual([0, 1]);
+  });
+
+  it('C13: all-zero target', () => {
+    const result = solveCounter([0, 0, 0], [[0, 1], [1, 2]], 7);
+    expect(result).toEqual([0, 0]);
+  });
+
+  it('C14: modular arithmetic wrapping', () => {
+    const result = solveCounter([0], [[0]], 3);
+    expect(result).toEqual([0]);
+
+    const result2 = solveCounter([2], [[0]], 3);
+    expect(result2).toEqual([2]);
+    expect(verifyCounter([2], [[0]], 3, result2!)).toBe(true);
+  });
+
+  it('C15: large counter instance (40 buttons, 40 counters, mod 97)', () => {
+    const n = 40;
+    const buttons: number[][] = [];
+    for (let i = 0; i < n; i++) {
+      buttons.push([i]);
+    }
+    const target = new Array(n).fill(0).map((_, i) => (i * 3 + 1) % 97);
+
+    const start = performance.now();
+    const result = solveCounter(target, buttons, 97);
+    const elapsed = performance.now() - start;
+
+    expect(elapsed).toBeLessThan(5000);
+    expect(result).not.toBeNull();
+    expect(verifyCounter(target, buttons, 97, result!)).toBe(true);
+  });
+
+  it('C16: various prime moduli', () => {
+    for (const mod of [2, 3, 5, 7, 11, 97]) {
+      const result = solveCounter([1], [[0]], mod);
+      expect(result).toEqual([1]);
+    }
+  });
+
+  it('mod 2 behaves like toggle', () => {
+    const result = solveCounter([1, 0, 1], [[0, 1], [1, 2]], 2);
+    expect(result).not.toBeNull();
+    expect(verifyCounter([1, 0, 1], [[0, 1], [1, 2]], 2, result!)).toBe(true);
+  });
+
+  it('handles overlapping buttons', () => {
+    const result = solveCounter([2, 3], [[0, 1], [0, 1]], 5);
+    expect(result).toBeNull();
+  });
+
+  it('uses modular inverse correctly', () => {
+    const result = solveCounter([3], [[0]], 7);
+    expect(result).toEqual([3]);
+    expect(verifyCounter([3], [[0]], 7, result!)).toBe(true);
+  });
+
+  it('complex multi-button solution', () => {
+    const result = solveCounter(
+      [1, 2, 3],
+      [[0, 1], [1, 2], [0, 2]],
+      5
+    );
+    if (result) {
+      expect(verifyCounter([1, 2, 3], [[0, 1], [1, 2], [0, 2]], 5, result)).toBe(true);
+    }
+  });
+
+  it('prefers smaller first element in lex order', () => {
+    const result = solveCounter([0, 0], [[0], [1]], 3);
+    expect(result).toEqual([0, 0]);
+  });
+});
