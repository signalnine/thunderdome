@@ -0,0 +1,245 @@
+export interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+export function solveToggle(machine: Machine): number[] | null {
+  const { target, buttons } = machine;
+  const n = target.length;
+  const m = buttons.length;
+
+  const targetVec = target.map(t => t ? 1 : 0);
+
+  const matrix: number[][] = [];
+  for (let row = 0; row < n; row++) {
+    const r = new Array(m).fill(0);
+    for (let col = 0; col < m; col++) {
+      if (buttons[col].includes(row)) {
+        r[col] = 1;
+      }
+    }
+    matrix.push([...r, targetVec[row]]);
+  }
+
+  const pivotCol: number[] = [];
+  const pivotRow: number[] = new Array(m).fill(-1);
+  let row = 0;
+
+  for (let col = 0; col < m && row < n; col++) {
+    let found = -1;
+    for (let r = row; r < n; r++) {
+      if (matrix[r][col] === 1) {
+        found = r;
+        break;
+      }
+    }
+    if (found === -1) continue;
+
+    [matrix[row], matrix[found]] = [matrix[found], matrix[row]];
+
+    for (let r = 0; r < n; r++) {
+      if (r !== row && matrix[r][col] === 1) {
+        for (let c = 0; c <= m; c++) {
+          matrix[r][c] ^= matrix[row][c];
+        }
+      }
+    }
+
+    pivotCol.push(col);
+    pivotRow[col] = row;
+    row++;
+  }
+
+  for (let r = row; r < n; r++) {
+    if (matrix[r][m] === 1) return null;
+  }
+
+  const freeVars: number[] = [];
+  for (let col = 0; col < m; col++) {
+    if (pivotRow[col] === -1) freeVars.push(col);
+  }
+
+  let bestSolution: number[] | null = null;
+  let bestCount = Infinity;
+
+  const numFree = freeVars.length;
+  const totalCombinations = 1 << numFree;
+
+  for (let mask = 0; mask < totalCombinations; mask++) {
+    const solution = new Array(m).fill(0);
+
+    for (let i = 0; i < numFree; i++) {
+      solution[freeVars[i]] = (mask >> i) & 1;
+    }
+
+    for (let i = pivotCol.length - 1; i >= 0; i--) {
+      const col = pivotCol[i];
+      const r = pivotRow[col];
+      let val = matrix[r][m];
+      for (let c = col + 1; c < m; c++) {
+        val ^= matrix[r][c] & solution[c];
+      }
+      solution[col] = val;
+    }
+
+    const count = solution.reduce((a: number, b: number) => a + b, 0);
+    if (count < bestCount) {
+      bestCount = count;
+      bestSolution = solution;
+    } else if (count === bestCount && bestSolution) {
+      const indices = solution.map((v: number, i: number) => v ? i : -1).filter((i: number) => i >= 0);
+      const bestIndices = bestSolution.map((v: number, i: number) => v ? i : -1).filter((i: number) => i >= 0);
+      if (lexSmaller(indices, bestIndices)) {
+        bestSolution = solution;
+      }
+    }
+  }
+
+  if (!bestSolution) return null;
+  return bestSolution.map((v: number, i: number) => v ? i : -1).filter((i: number) => i >= 0);
+}
+
+function lexSmaller(a: number[], b: number[]): boolean {
+  const len = Math.max(a.length, b.length);
+  for (let i = 0; i < len; i++) {
+    const ai = i < a.length ? a[i] : Infinity;
+    const bi = i < b.length ? b[i] : Infinity;
+    if (ai < bi) return true;
+    if (ai > bi) return false;
+  }
+  return false;
+}
+
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): number[] | null {
+  const n = lights.length;
+  const m = buttons.length;
+
+  const matrix: number[][] = [];
+  for (let row = 0; row < n; row++) {
+    const r = new Array(m).fill(0);
+    for (let col = 0; col < m; col++) {
+      if (buttons[col].includes(row)) {
+        r[col] = 1;
+      }
+    }
+    matrix.push([...r, lights[row] % modulus]);
+  }
+
+  const pivotCol: number[] = [];
+  const pivotRow: number[] = new Array(m).fill(-1);
+  let row = 0;
+
+  for (let col = 0; col < m && row < n; col++) {
+    let found = -1;
+    for (let r = row; r < n; r++) {
+      if (matrix[r][col] !== 0) {
+        found = r;
+        break;
+      }
+    }
+    if (found === -1) continue;
+
+    [matrix[row], matrix[found]] = [matrix[found], matrix[row]];
+
+    const inv = modInverse(matrix[row][col], modulus);
+    for (let c = 0; c <= m; c++) {
+      matrix[row][c] = (matrix[row][c] * inv) % modulus;
+    }
+
+    for (let r = 0; r < n; r++) {
+      if (r !== row && matrix[r][col] !== 0) {
+        const factor = matrix[r][col];
+        for (let c = 0; c <= m; c++) {
+          matrix[r][c] = ((matrix[r][c] - factor * matrix[row][c]) % modulus + modulus) % modulus;
+        }
+      }
+    }
+
+    pivotCol.push(col);
+    pivotRow[col] = row;
+    row++;
+  }
+
+  for (let r = row; r < n; r++) {
+    if (matrix[r][m] !== 0) return null;
+  }
+
+  const freeVars: number[] = [];
+  for (let col = 0; col < m; col++) {
+    if (pivotRow[col] === -1) freeVars.push(col);
+  }
+
+  let bestSolution: number[] | null = null;
+  let bestSum = Infinity;
+
+  const numFree = freeVars.length;
+
+  function enumerate(idx: number, assignment: number[]): void {
+    if (idx === numFree) {
+      const solution = new Array(m).fill(0);
+
+      for (let i = 0; i < numFree; i++) {
+        solution[freeVars[i]] = assignment[i];
+      }
+
+      for (let i = pivotCol.length - 1; i >= 0; i--) {
+        const col = pivotCol[i];
+        const r = pivotRow[col];
+        let val = matrix[r][m];
+        for (let c = col + 1; c < m; c++) {
+          val = ((val - matrix[r][c] * solution[c]) % modulus + modulus) % modulus;
+        }
+        solution[col] = val;
+      }
+
+      const sum = solution.reduce((a: number, b: number) => a + b, 0);
+      if (sum < bestSum || (sum === bestSum && bestSolution && lexSmallerArr(solution, bestSolution))) {
+        bestSum = sum;
+        bestSolution = [...solution];
+      }
+      return;
+    }
+
+    for (let v = 0; v < modulus; v++) {
+      assignment[idx] = v;
+      enumerate(idx + 1, assignment);
+    }
+  }
+
+  if (numFree <= 6 || (numFree <= 4 && modulus <= 97)) {
+    enumerate(0, new Array(numFree).fill(0));
+  } else {
+    const solution = new Array(m).fill(0);
+    for (let i = pivotCol.length - 1; i >= 0; i--) {
+      const col = pivotCol[i];
+      const r = pivotRow[col];
+      solution[col] = matrix[r][m];
+    }
+    bestSolution = solution;
+  }
+
+  return bestSolution;
+}
+
+function lexSmallerArr(a: number[], b: number[]): boolean {
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] < b[i]) return true;
+    if (a[i] > b[i]) return false;
+  }
+  return false;
+}
+
+function modInverse(a: number, mod: number): number {
+  let [old_r, r] = [a % mod, mod];
+  let [old_s, s] = [1, 0];
+  while (r !== 0) {
+    const q = Math.floor(old_r / r);
+    [old_r, r] = [r, old_r - q * r];
+    [old_s, s] = [s, old_s - q * s];
+  }
+  return ((old_s % mod) + mod) % mod;
+}
