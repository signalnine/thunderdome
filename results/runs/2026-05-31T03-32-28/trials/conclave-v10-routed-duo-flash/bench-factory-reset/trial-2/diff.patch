[0, 1], [1, 2]], result!)).toBe(true);\n  });\n\n  it(\"C5: minimum presses\", () => {\n    // 1-press solution exists: button 0 toggles all 3\n    const result = solveToggle({\n      target: [true, true, true],\n      buttons: [[0, 1, 2], [0], [1], [2]],\n    });\n    expect(result).toEqual([0]);\n    expect(result!.length).toBe(1);\n  });\n\n  it(\"C6: lexicographic tiebreak\", () => {\n    // Two single-press solutions: button 0 or button 1 (identical)\n    const result = solveToggle({\n      target: [true, true],\n      buttons: [[0, 1], [0, 1]],\n    });\n    expect(result).toEqual([0]);\n  });\n\n  it(\"C7: no solution returns null (from task example)\", () => {\n    expect(\n      solveToggle({\n        target: [true, true, false, true],\n        buttons: [[0, 1], [1, 2, 3], [0, 3]],\n      })\n    ).toBeNull();\n  });\n\n  it(\"C8: order invariance\", () => {\n    const target: boolean[] = [true, false, true];\n    const buttons = [[0, 1], [1, 2]];\n    const result = solveToggle({ target, buttons });\n    if (result) {\n      // Verify both orderings produce same result\n      const state1 = [false, false, false];\n      for (const bi of result) {\n        for (const li of buttons[bi]) state1[li] = !state1[li];\n      }\n      const state2 = [false, false, false];\n      for (const bi of [...result].reverse()) {\n        for (const li of buttons[bi]) state2[li] = !state2[li];\n      }\n      expect(state1).toEqual(state2);\n    }\n  });\n\n  it(\"C9: performance 40x40\", () => {\n    const n = 40;\n    const target = Array.from({ length: n }, (_, i) => i % 2 === 0);\n    const buttons = Array.from({ length: n }, (_, i) => [i]);\n    const start = performance.now();\n    const result = solveToggle({ target, buttons });\n    expect(performance.now() - start).toBeLessThan(5000);\n    expect(result).not.toBeNull();\n    expect(verifyToggle(target, buttons, result!)).toBe(true);\n  });\n\n  it(\"C10: edge - empty everything\", () => {\n    expect(solveToggle({ target: [], buttons: [] })).toEqual([]);\n  });\n\n  it(\"C10: edge - single light, no buttons\", () => {\n    expect(solveToggle({ target: [true], buttons: [] })).toBeNull();\n  });\n\n  it(\"sorted ascending output\", () => {\n    const result = solveToggle({\n      target: [true, true, true],\n      buttons: [[2], [0], [1]],\n    });\n    expect(result).not.toBeNull();\n    for (let i = 1; i < result!.length; i++) {\n      expect(result![i]).toBeGreaterThan(result![i - 1]);\n    }\n  });\n});\n\ndescribe(\"Contract verification: solveCounter\", () => {\n  it(\"C1: basic counting\", () => {\n    const result = solveCounter([2], [[0]], 5);\n    expect(result).toEqual([2]);\n    expect(verifyCounter([2], [[0]], result!, 5)).toBe(true);\n  });\n\n  it(\"C2: all zero target\", () => {\n    expect(solveCounter([0, 0], [[0], [1]], 3)).toEqual([0, 0]);\n  });\n\n  it(\"C3: modular arithmetic wrapping\", () => {\n    // mod 5, target [0] with button [0]\n    // Pressing 0 times gives 0. That's the trivial case.\n    // mod 5, target [4]: press 4 times\n    expect(solveCounter([4], [[0]], 5)).toEqual([4]);\n    expect(verifyCounter([4], [[0]], [4], 5)).toBe(true);\n  });\n\n  it(\"C4: multiple presses\", () => {\n    const result = solveCounter([3, 3], [[0, 1]], 5);\n    expect(result).toEqual([3]);\n    expect(verifyCounter([3, 3], [[0, 1]], result!, 5)).toBe(true);\n  });\n\n  it(\"C5: minimum total presses\", () => {\n    // 1 counter, mod 5, target [3]\n    // Buttons: [0], [0] (two buttons that both increment counter 0)\n    // Solutions: (a, b) where (a+b) mod 5 = 3\n    // (0,3)=3, (1,2)=3, (2,1)=3, (3,0)=3, (4,4)=8\n    // Min total = 3\n    const result = solveCounter([3], [[0], [0]], 5);\n    expect(result!.reduce((a, b) => a + b, 0)).toBe(3);\n  });\n\n  it(\"C6: lexicographic tiebreak\", () => {\n    // From C5, multiple solutions with total 3: (0,3), (1,2), (2,1), (3,0)\n    // Lex smallest: (0, 3)\n    const result = solveCounter([3], [[0], [0]], 5);\n    expect(result).toEqual([0, 3]);\n  });\n\n  it(\"C7: no solution\", () => {\n    expect(solveCounter([1, 2], [[0, 1]], 3)).toBeNull();\n  });\n\n  it(\"C8: prime modulus GF arithmetic\", () => {\n    // mod 97, system with unique solution\n    const result = solveCounter([50, 30], [[0], [1]], 97);\n    expect(result).toEqual([50, 30]);\n  });\n\n  it(\"C9: performance 40x40 mod 97\", () => {\n    const n = 40;\n    const mod = 97;\n    const target = Array.from({ length: n }, (_, i) => (i * 13 + 7) % mod);\n    const buttons = Array.from({ length: n }, (_, i) => [i]);\n    const start = performance.now();\n    const result = solveCounter(target, buttons, mod);\n    expect(performance.now() - start).toBeLessThan(5000);\n    expect(result).not.toBeNull();\n    expect(verifyCounter(target, buttons, result!, mod)).toBe(true);\n  });\n\n  it(\"C10: modulus 2 equivalence to toggle\", () => {\n    const result = solveCounter([1, 1, 0], [[0, 1], [1, 2]], 2);\n    expect(result).not.toBeNull();\n    expect(verifyCounter([1, 1, 0], [[0, 1], [1, 2]], result!, 2)).toBe(true);\n    expect(result!.every((v) => v === 0 || v === 1)).toBe(true);\n  });\n\n  it(\"result values in range 0..modulus-1\", () => {\n    const mod = 7;\n    const result = solveCounter([5, 3], [[0, 1], [0]], mod);\n    if (result) {\n      for (const v of result) {\n        expect(v).toBeGreaterThanOrEqual(0);\n        expect(v).toBeLessThan(mod);\n      }\n    }\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":154,"cache_read_input_tokens":79120,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":154},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6e54efef-ed84-4c07-b549-610a106bffe5","uuid":"3d8c18f4-5426-40a0-b564-12fd86bad3b4","request_id":"req_011Cba6qZY86tdC5