+import { describe, it, expect } from "vitest";
+import { solveToggle, solveCounter } from "./index.js";
+
+function verifyToggle(
+  target: boolean[],
+  buttons: number[][],
+  pressed: number[]
+): boolean {
+  const state = Array(target.length).fill(false);
+  for (const bi of pressed) {
+    for (const li of buttons[bi]) {
+      if (li < target.length) state[li] = !state[li];
+    }
+  }
+  return state.every((v, i) => v === target[i]);
+}
+
+function verifyCounter(
+  target: number[],
+  buttons: number[][],
+  presses: number[],
+  mod: number
+): boolean {
+  const state = Array(target.length).fill(0);
+  for (let bi = 0; bi < buttons.length; bi++) {
+    for (const ci of buttons[bi]) {
+      if (ci < target.length) state[ci] = (state[ci] + presses[bi]) % mod;
+    }
+  }
+  return state.every((v, i) => v === target[i]);
+}
+
+describe("Contract verification: solveToggle", () => {
+  it("C1: basic toggle semantics", () => {
+    const result = solveToggle({
+      target: [true, false],
+      buttons: [[0]],
+    });
+    expect(result).toEqual([0]);
+    expect(verifyToggle([true, false], [[0]], result!)).toBe(true);
+  });
+
+  it("C2: all off target returns empty", () => {
+    expect(solveToggle({ target: [false, false], buttons: [[0], [1]] })).toEqual([]);
+  });
