+    expect(result).toEqual([0, 0]);
+  });
+
+  it("handles modulus 2 (equivalent to toggle)", () => {
+    // Same as toggle basically
+    const result = solveCounter([1, 1, 0], [[0, 1], [1, 2]], 2);
+    // Button 0 pressed 1 time: counters [1, 1, 0]
+    expect(result).toEqual([1, 0]);
+  });
+
+  it("handles performance with 40 buttons, 40 counters, mod 97", () => {
+    const n = 40;
+    const mod = 97;
+    const target = Array.from({ length: n }, (_, i) => (i + 1) % mod);
+    const buttons = Array.from({ length: n }, (_, i) => [i]);
+    const start = performance.now();
+    const result = solveCounter(target, buttons, mod);
+    const elapsed = performance.now() - start;
+    expect(elapsed).toBeLessThan(5000);
+    expect(result).toEqual(target);
+  });
+
+  it("handles empty buttons with non-zero target", () => {
+    const result = solveCounter([1], [], 3);
+    expect(result).toBeNull();
+  });
+
+  it("handles empty buttons with zero target", () => {
+    const result = solveCounter([0, 0], [], 3);
+    expect(result).toEqual([]);
+  });
+
+  it("handles overlapping buttons for counter", () => {
+    // 3 counters, mod 5, target [2, 2, 0]
+    // Button 0: [0, 1] — adds 1 to counter 0 and 1
+    // Button 1: [1, 2] — adds 1 to counter 1 and 2
+    // Press button 0 twice: [2, 2, 0] ✓
+    const result = solveCounter([2, 2, 0], [[0, 1], [1, 2]], 5);
+    expect(result).toEqual([2, 0]);
+  });
+
+  it("optimizes for minimum total with modular inverse", () => {
+    // 1 counter, mod 5, target [4]
+    // Button 0: [0]
+    // Press 4 times = total 4
+    // But pressing 4 times is the only way (mod 5), since -1 mod 5 = 4
+    const result = solveCounter([4], [[0]], 5);
+    expect(result).toEqual([4]);
+  });
+});
