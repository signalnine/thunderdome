@@ -0,0 +1,311 @@
+export interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+function modInverse(a: number, mod: number): number {
+  let [old_r, r] = [((a % mod) + mod) % mod, mod];
+  let [old_s, s] = [1, 0];
+  while (r !== 0) {
+    const q = Math.floor(old_r / r);
+    [old_r, r] = [r, old_r - q * r];
+    [old_s, s] = [s, old_s - q * s];
+  }
+  return ((old_s % mod) + mod) % mod;
+}
+
+interface GEResult {
+  particular: number[];
+  nullBasis: number[][];
+}
+
+function gaussianElimination(
+  matrix: number[][],
+  target: number[],
+  mod: number,
+  numVars: number
+): GEResult | null {
+  const numRows = target.length;
+
+  const aug: number[][] = [];
+  for (let i = 0; i < numRows; i++) {
+    const row = new Array(numVars + 1);
+    for (let j = 0; j < numVars; j++) {
+      row[j] = ((matrix[i][j] ?? 0) % mod + mod) % mod;
+    }
+    row[numVars] = ((target[i] % mod) + mod) % mod;
+    aug.push(row);
+  }
+
+  const pivotCols: number[] = [];
+  let r = 0;
+  for (let c = 0; c < numVars && r < numRows; c++) {
+    let pr = -1;
+    for (let i = r; i < numRows; i++) {
+      if (aug[i][c] !== 0) {
+        pr = i;
+        break;
+      }
+    }
+    if (pr === -1) continue;
+
+    [aug[r], aug[pr]] = [aug[pr], aug[r]];
+
+    const inv = modInverse(aug[r][c], mod);
+    for (let j = c; j <= numVars; j++) {
+      aug[r][j] = (aug[r][j] * inv) % mod;
+    }
+
+    for (let i = 0; i < numRows; i++) {
+      if (i === r || aug[i][c] === 0) continue;
+      const f = aug[i][c];
+      for (let j = c; j <= numVars; j++) {
+        aug[i][j] = ((aug[i][j] - f * aug[r][j]) % mod + mod) % mod;
+      }
+    }
+
+    pivotCols.push(c);
+    r++;
+  }
+
+  for (let i = r; i < numRows; i++) {
+    if (aug[i][numVars] !== 0) return null;
+  }
+
+  const pivotSet = new Set(pivotCols);
+  const freeVars: number[] = [];
+  for (let j = 0; j < numVars; j++) {
+    if (!pivotSet.has(j)) freeVars.push(j);
+  }
+
+  const particular = new Array(numVars).fill(0);
+  for (let i = 0; i < pivotCols.length; i++) {
+    particular[pivotCols[i]] = aug[i][numVars];
+  }
+
+  const nullBasis: number[][] = [];
+  for (const fv of freeVars) {
+    const vec = new Array(numVars).fill(0);
+    vec[fv] = 1;
+    for (let i = 0; i < pivotCols.length; i++) {
+      vec[pivotCols[i]] = (mod - aug[i][fv]) % mod;
+    }
+    nullBasis.push(vec);
+  }
+
+  return { particular, nullBasis };
+}
+
+function buildMatrix(
+  numRows: number,
+  numCols: number,
+  buttons: number[][]
+): number[][] {
+  const matrix: number[][] = Array.from({ length: numRows }, () =>
+    new Array(numCols).fill(0)
+  );
+  for (let j = 0; j < numCols; j++) {
+    for (const i of buttons[j]) {
+      if (i < numRows) matrix[i][j] = 1;
+    }
+  }
+  return matrix;
+}
+
+function ctz(n: number): number {
+  if (n === 0) return 32;
+  let c = 0;
+  while ((n & 1) === 0) {
+    n >>= 1;
+    c++;
+  }
+  return c;
+}
+
+export function solveToggle(machine: Machine): number[] | null {
+  const { target, buttons } = machine;
+  const n = target.length;
+  const m = buttons.length;
+
+  if (target.every((t) => !t)) return [];
+
+  const matrix = buildMatrix(n, m, buttons);
+  const targetVec = target.map((t) => (t ? 1 : 0));
+
+  const ge = gaussianElimination(matrix, targetVec, 2, m);
+  if (!ge) return null;
+
+  const { particular, nullBasis } = ge;
+  const k = nullBasis.length;
+
+  let best = [...particular];
+  let bestWeight = best.reduce((s, v) => s + v, 0);
+
+  if (k > 0 && k <= 25) {
+    const current = [...particular];
+    let w = bestWeight;
+
+    const basisOnes: number[][] = nullBasis.map((v) => {
+      const ones: number[] = [];
+      for (let j = 0; j < m; j++) if (v[j] === 1) ones.push(j);
+      return ones;
+    });
+
+    for (let i = 1; i < (1 << k); i++) {
+      const bit = ctz(i);
+      for (const j of basisOnes[bit]) {
+        if (current[j] === 1) {
+          current[j] = 0;
+          w--;
+        } else {
+          current[j] = 1;
+          w++;
+        }
+      }
+
+      if (w < bestWeight || (w === bestWeight && isLexLargerVec(current, best, m))) {
+        bestWeight = w;
+        best = [...current];
+      }
+    }
+  } else if (k > 25) {
+    const current = [...best];
+    let w = bestWeight;
+    let improved = true;
+    while (improved) {
+      improved = false;
+      for (let b = 0; b < k; b++) {
+        let newW = w;
+        for (let j = 0; j < m; j++) {
+          if (nullBasis[b][j] === 1) {
+            if (current[j] === 1) newW--;
+            else newW++;
+          }
+        }
+        if (newW < w) {
+          for (let j = 0; j < m; j++) {
+            if (nullBasis[b][j] === 1) current[j] ^= 1;
+          }
+          w = newW;
+          improved = true;
+        }
+      }
+    }
+    bestWeight = w;
+    best = [...current];
+  }
+
+  const pressed: number[] = [];
+  for (let i = 0; i < m; i++) {
+    if (best[i] === 1) pressed.push(i);
+  }
+  return pressed;
+}
+
+function isLexLargerVec(a: number[], b: number[], len: number): boolean {
+  for (let i = 0; i < len; i++) {
+    if (a[i] > b[i]) return true;
+    if (a[i] < b[i]) return false;
+  }
+  return false;
+}
+
+function isLexSmallerVec(a: number[], b: number[], len: number): boolean {
+  for (let i = 0; i < len; i++) {
+    if (a[i] < b[i]) return true;
+    if (a[i] > b[i]) return false;
+  }
+  return false;
+}
+
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): number[] | null {
+  const n = lights.length;
+  const m = buttons.length;
+
+  if (lights.every((v) => v === 0)) return new Array(m).fill(0);
+
+  const matrix = buildMatrix(n, m, buttons);
+
+  const ge = gaussianElimination(matrix, lights, modulus, m);
+  if (!ge) return null;
+
+  const { particular, nullBasis } = ge;
+  const k = nullBasis.length;
+
+  if (k === 0) return particular;
+
+  let totalCombos = 1;
+  let overflow = false;
+  for (let i = 0; i < k; i++) {
+    totalCombos *= modulus;
+    if (totalCombos > 1e7) {
+      overflow = true;
+      break;
+    }
+  }
+
+  if (!overflow) {
+    let bestSum = particular.reduce((s, v) => s + v, 0);
+    let bestSol = [...particular];
+
+    for (let combo = 1; combo < totalCombos; combo++) {
+      const sol = [...particular];
+      let temp = combo;
+      for (let f = k - 1; f >= 0; f--) {
+        const alpha = temp % modulus;
+        temp = Math.floor(temp / modulus);
+        if (alpha === 0) continue;
+        for (let j = 0; j < m; j++) {
+          if (nullBasis[f][j] === 0) continue;
+          sol[j] = (sol[j] + alpha * nullBasis[f][j]) % modulus;
+        }
+      }
+      const total = sol.reduce((s, v) => s + v, 0);
+      if (
+        total < bestSum ||
+        (total === bestSum && isLexSmallerVec(sol, bestSol, m))
+      ) {
+        bestSum = total;
+        bestSol = sol;
+      }
+    }
+
+    return bestSol;
+  }
+
+  const current = [...particular];
+  for (let f = 0; f < k; f++) {
+    let bestAlpha = 0;
+    let bestTotal = current.reduce((s, v) => s + v, 0);
+    const bestVec = [...current];
+
+    for (let alpha = 1; alpha < modulus; alpha++) {
+      const trial = [...current];
+      for (let j = 0; j < m; j++) {
+        if (nullBasis[f][j] === 0) continue;
+        trial[j] = (trial[j] + alpha * nullBasis[f][j]) % modulus;
+      }
+      const total = trial.reduce((s, v) => s + v, 0);
+      if (
+        total < bestTotal ||
+        (total === bestTotal && isLexSmallerVec(trial, bestVec, m))
+      ) {
+        bestTotal = total;
+        bestAlpha = alpha;
+      }
+    }
+
+    if (bestAlpha > 0) {
+      for (let j = 0; j < m; j++) {
+        if (nullBasis[f][j] === 0) continue;
+        current[j] = (current[j] + bestAlpha * nullBasis[f][j]) % modulus;
+      }
+    }
+  }
+
+  return current;
+}
