+{"type":"assistant","message":{"id":"102e488e-0ea8-4b0e-8e0f-f5144db8a088","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{"type":"tool_use","id":"call_00_vGJBQj3bY8FqRimv0Clc4369","name":"Write","input":{"file_path":"/workspace/src/index.ts","content":"// ─── Types ───────────────────────────────────────────────────────────────────\n\nexport interface Event {\n  id: string;\n  name: string;\n  duration: number;       // in minutes\n  attendees?: number;     // number of people attending (default: 1)\n  prerequisites?: string[]; // event IDs that must finish before this starts\n  preferredRoom?: string; // room ID preference (hint, not hard constraint)\n}\n\nexport interface Room {\n  id: string;\n  name: string;\n  capacity: number;       // max attendees\n}\n\nexport interface ScheduleOptions {\n  startTime: number;      // minutes from midnight\n  endTime: number;        // minutes from midnight\n  gap?: number;           // minimum gap between events (default: 15)\n}\n\nexport interface Assignment {\n  eventId: string;\n  roomId: string;\n  startTime: number;      // minutes from midnight\n  endTime: number;        // minutes from midnight\n}\n\nexport interface ScheduleResult {\n  assignments: Assignment[];\n  unscheduled: string[];  // event IDs that could not be scheduled\n}\n\n// ─── Cycle Detection ─────────────────────────────────────────────────────────\n\n/**\n * Detects cycles in the prerequisite graph.\n * Throws an error if a cycle is found (including self-references).\n * Non-existent prerequisite references are ignored.\n */\nfunction detectCycle(events: Event[]): void {\n  const eventIds = new Set(events.map(e => e.id));\n\n  // Build adjacency: for each event, list of valid prerequisite event IDs\n  const adj = new Map<string, string[]>();\n  for (const e of events) {\n    const prereqs = (e.prerequisites ?? []).filter(p => eventIds.has(p));\n    adj.set(e.id, prereqs);\n  }\n\n  // DFS with three colors: 0 = unvisited, 1 = in-progress, 2 = done\n  const color = new Map<string, number>();\n  for (const e of events) color.set(e.id, 0);\n\n  function dfs(u: string): void {\n    color.set(u, 1);\n    for (const v of adj.get(u) ?? []) {\n      if (color.get(v) === 1) {\n        throw new Error(\n          `Prerequisite cycle detected involving event \"${u}\" and event \"${v}\"`,\n        );\n      }\n      if (color.get(v) === 0) {\n        dfs(v);\n      }\n    }\n    color.set(u, 2);\n  }\n\n  for (const e of events) {\n    if (color.get(e.id) === 0) {\n      dfs(e.id);\n    }\n  }\n}\n\n// ─── Topological Levels ──────────────────────────────────────────────────────\n\n/**\n * Computes topological levels for each event using DP.\n * Level 0 = no prerequisites (or only unknown ones).\n * Level N = at least one prerequisite at level N-1, all prerequisites at level < N.\n */\nfunction computeLevels(events: Event[]): Map<string, number> {\n  const eventIds = new Set(events.map(e => e.id));\n  const memo = new Map<string, number>();\n\n  function getLevel(id: string): number {\n    const cached = memo.get(id);\n    if (cached !== undefined) return cached;\n\n    const event = events.find(e => e.id === id)!;\n    const prereqs = (event.prerequisites ?? []).filter(p => eventIds.has(p));\n\n    if (prereqs.length === 0) {\n      memo.set(id, 0);\n      return 0;\n    }\n\n    const maxPrereqLevel = Math.max(...prereqs.map(p => getLevel(p)));\n    const level = maxPrereqLevel + 1;\n    memo.set(id, level);\n    return level;\n  }\n\n  const levels = new Map<string, number>();\n  for (const e of events) {\n    levels.set(e.id, getLevel(e.id));\n  }\n  return levels;\n}\n\n// ─── Room Slot Finding ──────────────────────────────────────────────────────\n\n/**\n * For a given room, finds the earliest time slot where the event fits,\n * respecting existing assignments, the global gap, and prerequisite end times.\n */\nfunction findEarliestSlotInRoom(\n  event: Event,\n  roomId: string,\n  roomAssignments: Map<string, Assignment[]>,\n  allAssignments: Assignment[],\n  options: ScheduleOptions,\n): { start: number } | null {\n  const gap = options.gap ?? 15;\n  const duration = event.duration;\n  const existing = (roomAssignments.get(roomId) ?? [])\n    .slice()\n    .sort((a, b) => a.startTime - b.startTime);\n\n  // Earliest this event can start due to prerequisite constraints\n  const prereqIds = event.prerequisites ?? [];\n  const prereqEndTimes = prereqIds\n    .map(id => allAssignments.find(a => a.eventId === id)?.endTime)\n    .filter((t): t is number => t !== undefined);\n\n  const earliestAllowed = Math.max(\n    options.startTime,\n    ...prereqEndTimes.map(t => t + gap),\n  );\n\n  // Build available windows for this room\n  const windows: Array<{ start: number; end: number }> = [];\n\n  if (existing.length === 0) {\n    windows.push({ start: options.startTime, end: options.endTime });\n  } else {\n    // Before the first scheduled event\n    windows.push({ start: options.startTime, end: existing[0].startTime - gap });\n\n    // Between scheduled events\n    for (let i = 0; i < existing.length - 1; i++) {\n      windows.push({\n        start: existing[i].endTime + gap,\n        end: existing[i + 1].startTime - gap,\n      });\n    }\n\n    // After the last scheduled event\n    windows.push({\n      start: existing[existing.length - 1].endTime + gap,\n      end: options.endTime,\n    });\n  }\n\n  // Find the first window where the event fits\n  for (const win of windows) {\n    if (win.end < win.start) continue;\n    const start = Math.max(earliestAllowed, win.start);\n    if (start + duration <= win.end) {\n      return { start };\n    }\n  }\n\n  return null;\n}\n\n// ─── Best Slot Across All Rooms ──────────────────────────────────────────────\n\n/**\n * Finds the best (earliest) room assignment for an event.\n * Tries the preferred room first if specified, then picks the earliest slot\n * across all compatible rooms.\n */\nfunction findBestSlot(\n  event: Event,\n  rooms: Room[],\n  roomAssignments: Map<string, Assignment[]>,\n  allAssignments: Assignment[],\n  options: ScheduleOptions,\n): Assignment | null {\n  const compatibleRooms = rooms.filter(\n    r => r.capacity >= (event.attendees ?? 1),\n  );\n\n  if (compatibleRooms.length === 0) return null;\n\n  // If preferred room is specified and compatible, try it first\n  if (event.preferredRoom) {\n    const prefRoom = compatibleRooms.find(r => r.id === event.preferredRoom);\n    if (prefRoom) {\n      const slot = findEarliestSlotInRoom(\n        event,\n        prefRoom.id,\n        roomAssignments,\n        allAssignments,\n        options,\n      );\n      if (slot) {\n        return {\n          eventId: event.id,\n          roomId: prefRoom.id,\n          startTime: slot.start,\n          endTime: slot.start + event.duration,\n        };\n      }\n    }\n  }\n\n  // Try all other compatible rooms (skip preferred if already tried above)\n  let best: { roomId: string; start: number } | null = null;\n\n  for (const room of compatibleRooms) {\n    if (event.preferredRoom && room.id === event.preferredRoom) continue;\n\n    const slot = findEarliestSlotInRoom(\n      event,\n      room.id,\n      roomAssignments,\n      allAssignments,\n      options,\n    );\n    if (slot && (!best || slot.start < best.start)) {\n      best = { roomId: room.id, start: slot.start };\n    }\n  }\n\n  if (best) {\n    return {\n      eventId: event.id,\n      roomId: best.roomId,\n      startTime: best.start,\n      endTime: best.start + event.duration,\n    };\n  }\n\n  return null;\n}\n\n// ─── Public API ──────────────────────────────────────────────────────────────\n\n/**\n * Assigns events to rooms within a time window, respecting:\n *  - Room capacity limits\n *  - Time window boundaries\n *  - Gap between events in the same room\n *  - Prerequisite ordering\n *  - Room preferences (as hints)\n *\n * @throws Error if the prerequisite graph contains a cycle.\n */\nexport function schedule(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions,\n): ScheduleResult {\n  // Handle edge cases\n  if (events.length === 0) {\n    return { assignments: [], unscheduled: [] };\n  }\n\n  if (rooms.length === 0) {\n    return {\n      assignments: [],\n      unscheduled: events.map(e => e.id),\n    };\n  }\n\n  // Validate prerequisite graph for cycles\n  detectCycle(events);\n\n  // Compute topological levels for ordering\n  const levels = computeLevels(events);\n\n  // Sort events: by topological level (lower first), then by constrainedness\n  const sortedEvents = [...events].sort((a, b) => {\n    const la = levels.get(a.id) ?? 0;\n    const lb = levels.get(b.id) ?? 0;\n    if (la !== lb) return la - lb;\n\n    // Within same level: fewer compatible rooms = more constrained = place first\n    const aRoomCount = rooms.filter(\n      r => r.capacity >= (a.attendees ?? 1),\n    ).length;\n    const bRoomCount = rooms.filter(\n      r => r.capacity >= (b.attendees ?? 1),\n    ).length;\n    if (aRoomCount !== bRoomCount) return aRoomCount - bRoomCount;\n\n    // Longer events are harder to place, so schedule them first\n    if (a.duration !== b.duration) return b.duration - a.duration;\n\n    // Stable tiebreaker\n    return a.id.localeCompare(b.id);\n  });\n\n  const assignments: Assignment[] = [];\n  const unscheduled: string[] = [];\n  const roomAssignments = new Map<string, Assignment[]>();\n\n  for (const event of sortedEvents) {\n    const slot = findBestSlot(\n      event,\n      rooms,\n      roomAssignments,\n      assignments,\n      options,\n    );\n    if (slot) {\n      assignments.push(slot);\n      const existing = roomAssignments.get(slot.roomId) ?? [];\n      existing.push(slot);\n      roomAssignments.set(slot.roomId, existing);\n    } else {\n      unscheduled.push(event.id);\n    }\n  }\n\n  return { assignments, unscheduled };\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":148,"