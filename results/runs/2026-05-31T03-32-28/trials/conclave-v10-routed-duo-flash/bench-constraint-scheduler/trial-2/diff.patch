s: Room[], options: ScheduleOptions): ScheduleResult {\n  // 1. Handle empty inputs\n  if (events.length === 0) return { assignments: [], unscheduled: [] };\n  \n  // 2. Detect cycles\n  detectCycle(events);\n  \n  // 3. Compute topological levels\n  const levels = computeLevels(events);\n  \n  // 4. Sort events by level then by constrainedness\n  const sortedEvents = [...events].sort((a, b) => {\n    const levelDiff = (levels.get(a.id) || 0) - (levels.get(b.id) || 0);\n    if (levelDiff !== 0) return levelDiff;\n    // Within same level: more constrained first (fewer compatible rooms)\n    const aRooms = rooms.filter(r => r.capacity >= (a.attendees || 1)).length;\n    const bRooms = rooms.filter(r => r.capacity >= (b.attendees || 1)).length;\n    if (aRooms !== bRooms) return aRooms - bRooms;\n    // Then longer duration first (harder to place)\n    if (a.duration !== b.duration) return b.duration - a.duration;\n    return a.id.localeCompare(b.id);\n  });\n  \n  // 5. Assign events\n  const assignments: Assignment[] = [];\n  const unscheduled: string[] = [];\n  const roomAssignments = new Map<string, Assignment[]>(); // roomId -> assignments\n  \n  for (const event of sortedEvents) {\n    const slot = findBestSlot(event, rooms, roomAssignments, assignments, options);\n    if (slot) {\n      assignments.push(slot);\n      if (!roomAssignments.has(slot.roomId)) {\n        roomAssignments.set(slot.roomId, []);\n      }\n      roomAssignments.get(slot.roomId)!.push(slot);\n    } else {\n      unscheduled.push(event.id);\n    }\n  }\n  \n  return { assignments, unscheduled };\n}\n```\n\nFor `findBestSlot`, I need to:\n1. Find compatible rooms (capacity >= attendees)\n2. If event has preferredRoom and it's compatible, try it first\n3. For each compatible room, find the earliest valid slot\n4. Consider prerequisite constraints\n5. Pick the best (earliest) slot\n\nLet me think about `findEarliestSlotInRoom`:\n\n```typescript\nfunction findEarliestSlotInRoom(\n  event: Even