s: Event[]): Event[] {\n  const visited = new Set<string>();\n  const result: Event[] = [];\n  const eventMap = new Map(events.map(e => [e.id, e]));\n  \n  function dfs(eventId: string) {\n    if (visited.has(eventId)) return;\n    visited.add(eventId);\n    for (const prereqId of eventMap.get(eventId)?.prerequisites ?? []) {\n      if (eventMap.has(prereqId)) {\n        dfs(prereqId);\n      }\n    }\n    const event = eventMap.get(eventId)!;\n    result.push(event);\n  }\n  \n  for (const event of events) {\n    if (!visited.has(event.id)) {\n      dfs(event.id);\n    }\n  }\n  \n  return result;\n}\n\nexport function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {\n  // Cycle detection\n  if (detectCycle(events)) {\n    throw new Error('Prerequisite graph contains a cycle');\n  }\n  \n  const gap = options.gap ?? 15;\n  const roomMap = new Map(rooms.map(r => [r.id, r]));\n  \n  // Topological sort for prerequisite ordering\n  const sortedEvents = topologicalSort(events);\n  \n  const scheduled: ScheduledEvent[] = [];\n  const unscheduled: string[] = [];\n  \n  for (const event of sortedEvents) {\n    const attendees = event.attendees ?? 1;\n    \n    // Find compatible rooms\n    const compatibleRooms = rooms.filter(r => r.capacity >= attendees);\n    \n    if (compatibleRooms.length === 0) {\n      unscheduled.push(event.id);\n      continue;\n    }\n    \n    // Sort: preferred room first, then by capacity ascending\n    const sortedRooms = [...compatibleRooms].sort((a, b) => {\n      if (event.preferredRoom) {\n        if (a.id === event.preferredRoom) return -1;\n        if (b.id === event.preferredRoom) return 1;\n      }\n      return a.capacity - b.capacity;\n    });\n    \n    // Determine the earliest start time based on prerequisites\n    let earliestStart = options.startTime;\n    if (event.prerequisites && event.prerequisites.length > 0) {\n      for (const prereqId of event.prerequisites) {\n        const prereqAs