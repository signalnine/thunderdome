+// Advanced: Gaps between events at window edges
+// ==============================
+describe('Window edge gaps', () => {
+  it('respects gap from previous event to end of window', () => {
+    // One 60-min event. Gap=30. Window=540-630 (90min).
+    // Event can be 540-600, leaving 30min gap to end of window
+    const event = makeEvent({ id: 'e1', duration: 60 });
+    const room = makeRoom({ id: 'r1' });
+    // With gap=30 after this event (600+30=630), it still fits
+    const result = schedule([event], [room], { startTime: 540, endTime: 630, gap: 30 });
+
+    expect(result.assignments).toHaveLength(1);
+    expect(result.assignments[0].startTime).toBe(540);
+    expect(result.assignments[0].endTime).toBe(600);
+
+    // Now try with gap=30 but window=540-600 (60min)
+    // Event is 60min but needs 60+30=90 with gap. Since it's the only event, no gap applies.
+    // Actually wait: gap is BETWEEN events, not at the window edge. So this should work.
+    const result2 = schedule([event], [room], { startTime: 540, endTime: 600, gap: 30 });
+    expect(result2.assignments).toHaveLength(1);
+  });
+});
