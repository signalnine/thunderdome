gical sort ─────────────────────────────────────────────────────────\nfunction topologicalSort(events: Event[]): Event[] {\n  const visited = new Set<string>();\n  const result: Event[] = [];\n  const eventMap = new Map(events.map((e) => [e.id, e]));\n\n  function dfs(eventId: string): void {\n    if (visited.has(eventId)) return;\n    visited.add(eventId);\n    for (const prereqId of eventMap.get(eventId)?.prerequisites ?? []) {\n      if (eventMap.has(prereqId)) {\n        dfs(prereqId);\n      }\n    }\n    result.push(eventMap.get(eventId)!);\n  }\n\n  for (const ev of events) {\n    if (!visited.has(ev.id)) dfs(ev.id);\n  }\n\n  return result;\n}\n\n// ── Scheduler ────────────────────────────────────────────────────────────────\n\nexport function schedule(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions,\n): ScheduleResult {\n  // 1. Cycle detection – throw on any prerequisite cycle\n  if (hasCycle(events)) {\n    throw new Error('Prerequisite graph contains a cycle');\n  }\n\n  const gap = options.gap ?? 15;\n  const roomMap = new Map(rooms.map((r) => [r.id, r]));\n\n  // 2. Topological sort (prerequisite ordering)\n  const sorted = topologicalSort(events);\n\n  const scheduled: ScheduledEvent[] = [];\n  const unscheduled: string[] = [];\n  const scheduledIds = new Set<string>();\n\n  // 3. Greedy scheduling loop\n  for (const event of sorted) {\n    const attendees = event.attendees ?? 1;\n\n    // ── Prerequisite check: all prerequisites must be scheduled ──\n    const prereqs = event.prerequisites ?? [];\n    let prereqsSatisfied = true;\n    let earliestStart = options.startTime;\n\n    for (const prereqId of prereqs) {\n      // Prerequisite references an event not in the list? Can't satisfy.\n      if (!roomMap.has(prereqId) && !events.find((e) => e.id === prereqId)) {\n        prereqsSatisfied = false;\n        break;\n      }\n      // Prerequisite exists but wasn't scheduled? Can't proceed.\n      if (!scheduledIds.has(prereqId)) {\n        // If it's not scheduled AND it's not in the events list, it can't be satisfied\n        // If it is in the events list but wasn't scheduled, it means it failed earlier\n        prereqsSatisfied = false;\n        break;\n      }\n      const prereqAssignment = scheduled.find((s) => s.eventId === prereqId)!;\n      earliestStart = Math.max(earliestStart, prereqAssignment.endTime + gap);\n    }\n\n    if (!prereqsSatisfied) {\n      unscheduled.push(event.id);\n      continue;\n    }\n\n    // ── Find compatible rooms ──\n    const compatibleRooms = rooms.filter((r) => r.capacity >= attendees);\n\n    if (compatibleRooms.length === 0) {\n      unscheduled.push(event.id);\n      continue;\n    }\n\n    // Sort rooms: preferred first, then by capacity ascending (smallest fit first)\n    const sortedRooms = [...compatibleRooms].sort((a, b) => {\n      if (event.preferredRoom) {\n        if (a.id === event.preferredRoom && b.id !== event.preferredRoom) return -1;\n        if (b.id === event.preferredRoom && a.id !== event.preferredRoom) return 1;\n      }\n      return a.capacity - b.capacity;\n    });\n\n    let bestAssignment: ScheduledEvent | null = null;\n\n    for (const room of sortedRooms) {\n      const placement = findPlacement(\n        event,\n        room,\n        scheduled.filter((s) => s.roomId === room.id),\n        earliestStart,\n        options,\n        gap,\n      );\n      if (placement) {\n        bestAssignment = { eventId: event.id, roomId: room.id, ...placement };\n        break; // First viable room wins (preferred room prioritized by sort)\n      }\n    }\n\n    if (bestAssignment) {\n      scheduled.push(bestAssignment);\n      scheduledIds.add(event.id);\n    } else {\n      unscheduled.push(event.id);\n    }\n  }\n\n  return {\n    assignments: scheduled.map((s) => ({\n      eventId: s.eventId,\n      roomId: s.roomId,\n      startTime: s.startTime,\n      endTime: s.endTime,\n    })),\n    unscheduled,\n  };\n}\n\n// ── Placement finder ─────────────────────────────────────────────────────────\n// Finds the earliest valid time slot for an event in a given room.\n\ninterface Placement {\n  startTime: number;\n  endTime: number;\n}\n\nfunction findPlacement(\n  event: Event,\n  room: Room,\n  existing: ScheduledEvent[],\n  earliestStart: number,\n  options: ScheduleOptions,\n  gap: number,\n): Placement | null {\n  const duration = event.duration;\n  const sorted = [...existing].sort((a, b) => a.startTime - b.startTime);\n\n  // Collect candidate start times\n  const candidates = new Set<number>();\n\n  // Candidate 1: the earliest possible start time (clamped to window start)\n  const earliestPossible = Math.max(earliestStart, options.startTime);\n  if (earliestPossible + duration <= options.endTime) {\n    candidates.add(earliestPossible);\n  }\n\n  // Candidates 2: right after each existing event (plus gap)\n  for (const ev of sorted) {\n    const after = Math.max(ev.endTime + gap, earliestStart, options.startTime);\n    if (after + duration <= options.endTime) {\n      candidates.add(after);\n    }\n  }\n\n  // Also consider inserting before each existing event\n  // Only if it's earlier than what we've tried already\n  if (sorted.length > 0) {\n    const beforeFirst = Math.max(earliestStart, options.startTime);\n    if (beforeFirst + duration + gap <= sorted[0].startTime) {\n      candidates.add(beforeFirst);\n    }\n  }\n\n  // Sort candidates ascending and try each\n  const sortedCandidates = [...candidates].sort((a, b) => a - b);\n\n  for (const start of sortedCandidates) {\n    const end = start + duration;\n\n    // Verify time window (already enforced during candidate generation, but be safe)\n    if (start < options.startTime || end > options.endTime) continue;\n\n    // Verify gap constraints with all existing events in this room\n    let valid = true;\n    for (const ev of sorted) {\n      // Two intervals [start, end) and [ev.startTime, ev.endTime)\n      // Conflict if they are 