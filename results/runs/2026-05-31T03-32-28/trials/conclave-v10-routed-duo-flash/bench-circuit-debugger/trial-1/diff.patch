+import { describe, it, expect } from 'vitest';
+import { simulate, findSwappedWires, Gate } from './index.js';
+
+// Helper: generate a correct N-bit ripple-carry adder
+function generateAdder(bits: number): Gate[] {
+  const gates: Gate[] = [];
+  const pad = (n: number) => String(n).padStart(2, '0');
+
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: `c00` });
+
+  for (let i = 1; i < bits; i++) {
+    const p = pad(i);
+    const prevCarry = `c${pad(i - 1)}`;
+    gates.push({ op: 'XOR', in1: `x${p}`, in2: `y${p}`, out: `t${p}` });
+    gates.push({ op: 'XOR', in1: `t${p}`, in2: prevCarry, out: `z${p}` });
+    gates.push({ op: 'AND', in1: `x${p}`, in2: `y${p}`, out: `a${p}` });
+    gates.push({ op: 'AND', in1: `t${p}`, in2: prevCarry, out: `b${p}` });
+    const carryOut = i === bits - 1 ? `z${pad(bits)}` : `c${p}`;
+    gates.push({ op: 'OR', in1: `a${p}`, in2: `b${p}`, out: carryOut });
+  }
+
+  return gates;
+}
+
+// Helper: apply output wire swaps to a circuit
+function applySwaps(gates: Gate[], swaps: [string, string][]): Gate[] {
+  const result = gates.map(g => ({ ...g }));
+  for (const [w1, w2] of swaps) {
+    const g1 = result.find(g => g.out === w1)!;
+    const g2 = result.find(g => g.out === w2)!;
+    g1.out = w2;
+    g2.out = w1;
+  }
+  return result;
+}
+
+// Helper: create input record for an adder
+function makeInputs(bits: number, x: number, y: number): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  const pad = (n: number) => String(n).padStart(2, '0');
+  for (let i = 0; i < bits; i++) {
+    inputs[`x${pad(i)}`] = (x >> i) & 1;
+    inputs[`y${pad(i)}`] = (y >> i) & 1;
+  }
+  return inputs;
+}
+
+// Helper: extract Z register value from wire values
+function getZ(values: Record<string, number>, bits: number): number {
+  let result = 0;
+  const pad = (n: number) => String(n).padStart(2, '0');
+  for (let i = 0; i <= bits; i++) {
+    const wire = `z${pad(i)}`;
+    if (values[wire]) {
+      result |= (1 << i);
+    }
+  }
+  return result;
+}
+
+describe('simulate', () => {
+  it('should compute AND gate correctly', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 })).toMatchObject({ a: 1, b: 1, c: 1 });
+    expect(simulate(gates, { a: 1, b: 0 })).toMatchObject({ c: 0 });
+    expect(simulate(gates, { a: 0, b: 1 })).toMatchObject({ c: 0 });
+    expect(simulate(gates, { a: 0, b: 0 })).toMatchObject({ c: 0 });
+  });
+
+  it('should compute OR gate correctly', () => {
+    const gates: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 })).toMatchObject({ c: 1 });
+    expect(simulate(gates, { a: 1, b: 0 })).toMatchObject({ c: 1 });
+    expect(simulate(gates, { a: 0, b: 1 })).toMatchObject({ c: 1 });
+    expect(simulate(gates, { a: 0, b: 0 })).toMatchObject({ c: 0 });
+  });
+
+  it('should compute XOR gate correctly', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 })).toMatchObject({ c: 0 });
+    expect(simulate(gates, { a: 1, b: 0 })).toMatchObject({ c: 1 });
+    expect(simulate(gates, { a: 0, b: 1 })).toMatchObject({ c: 1 });
+    expect(simulate(gates, { a: 0, b: 0 })).toMatchObject({ c: 0 });
+  });
+
+  it('should handle chained gates in dependency order', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'mid' },
+      { op: 'OR', in1: 'mid', in2: 'c', out: 'result' },
+    ];
+    expect(simulate(gates, { a: 1, b: 1, c: 0 })).toMatchObject({ mid: 1, result: 1 });
+    expect(simulate(gates, { a: 0, b: 1, c: 0 })).toMatchObject({ mid: 0, result: 0 });
+    expect(simulate(gates, { a: 0, b: 0, c: 1 })).toMatchObject({ mid: 0, result: 1 });
+  });
+
+  it('should handle gates listed in reverse dependency order', () => {
+    const gates: Gate[] = [
+      { op: 'OR', in1: 'mid', in2: 'c', out: 'result' },
+      { op: 'AND', in1: 'a', in2: 'b', out: 'mid' },
+    ];
+    expect(simulate(gates, { a: 1, b: 1, c: 0 })).toMatchObject({ mid: 1, result: 1 });
+  });
+
+  it('should simulate a correct 4-bit adder: 5 + 3 = 8', () => {
+    const gates = generateAdder(4);
+    const inputs = makeInputs(4, 5, 3);
+    const values = simulate(gates, inputs);
+    expect(getZ(values, 4)).toBe(8);
+  });
+
+  it('should simulate a correct 4-bit adder: 15 + 15 = 30', () => {
+    const gates = generateAdder(4);
+    const inputs = makeInputs(4, 15, 15);
+    const values = simulate(gates, inputs);
+    expect(getZ(values, 4)).toBe(30);
+  });
+
+  it('should simulate a correct 4-bit adder: 0 + 0 = 0', () => {
+    const gates = generateAdder(4);
+    const inputs = makeInputs(4, 0, 0);
+    const values = simulate(gates, inputs);
+    expect(getZ(values, 4)).toBe(0);
+  });
+
+  it('should simulate a correct 8-bit adder', () => {
+    const gates = generateAdder(8);
+    const pairs = [[100, 200], [255, 255], [0, 0], [1, 1], [128, 127]];
+    for (const [x, y] of pairs) {
+      const values = simulate(gates, makeInputs(8, x, y));
+      expect(getZ(values, 8)).toBe(x + y);
+    }
+  });
+
+  it('should return values for all wires including inputs', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    const result = simulate(gates, { a: 1, b: 0 });
+    expect(result).toHaveProperty('a', 1);
+    expect(result).toHaveProperty('b', 0);
+    expect(result).toHaveProperty('c', 0);
+  });
+});
+
+describe('findSwappedWires', () => {
