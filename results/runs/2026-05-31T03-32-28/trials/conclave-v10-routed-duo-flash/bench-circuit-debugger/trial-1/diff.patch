+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values: Record<string, number> = { ...inputs };
+
+  const gateByOutput = new Map<string, Gate>();
+  for (const gate of gates) {
+    gateByOutput.set(gate.out, gate);
+  }
+
+  function evaluate(wire: string): number {
+    if (wire in values) return values[wire];
+    const gate = gateByOutput.get(wire);
+    if (!gate) throw new Error(`No value for wire ${wire}`);
+    const a = evaluate(gate.in1);
+    const b = evaluate(gate.in2);
+    let result: number;
+    switch (gate.op) {
+      case 'AND': result = a & b; break;
+      case 'OR':  result = a | b; break;
+      case 'XOR': result = a ^ b; break;
+    }
+    values[wire] = result;
+    return result;
+  }
+
+  for (const gate of gates) {
+    evaluate(gate.out);
+  }
+
+  return values;
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  const gs: Gate[] = gates.map(g => ({ ...g }));
+  const swapped: string[] = [];
+
+  const byOutput = new Map<string, Gate>();
+  const byInputsOp = new Map<string, Gate>();
+
+  function sortedKey(op: string, a: string, b: string): string {
+    return a < b ? `${op}|${a}|${b}` : `${op}|${b}|${a}`;
+  }
+
+  function buildIndices(): void {
+    byOutput.clear();
+    byInputsOp.clear();
+    for (const g of gs) {
+      byOutput.set(g.out, g);
+      byInputsOp.set(sortedKey(g.op, g.in1, g.in2), g);
+    }
+  }
+
+  function find(op: string, a: string, b: string): Gate | undefined {
+    return byInputsOp.get(sortedKey(op, a, b));
+  }
+
+  function usedBy(wire: string, op: string): Gate[] {
+    return gs.filter(g => g.op === op && (g.in1 === wire || g.in2 === wire));
+  }
+
+  function otherInput(gate: Gate, known: string): string {
+    return gate.in1 === known ? gate.in2 : gate.in1;
+  }
+
+  function swapOutputs(w1: string, w2: string): void {
+    const g1 = byOutput.get(w1)!;
+    const g2 = byOutput.get(w2)!;
+    g1.out = w2;
+    g2.out = w1;
+    byOutput.set(w1, g2);
+    byOutput.set(w2, g1);
+  }
+
+  function doSwap(w1: string, w2: string): void {
+    swapped.push(w1, w2);
+    swapOutputs(w1, w2);
+  }
+
+  function undoSwap(): void {
+    const w2 = swapped.pop()!;
+    const w1 = swapped.pop()!;
+    swapOutputs(w1, w2);
+  }
+
+  function isXYWire(w: string): boolean {
+    return /^[xy]\d+$/.test(w);
+  }
+
+  let maxBit = 0;
+  for (const g of gs) {
+    for (const w of [g.in1, g.in2]) {
+      const m = w.match(/^x(\d+)$/);
+      if (m) maxBit = Math.max(maxBit, parseInt(m[1]));
+    }
+  }
+  const N = maxBit + 1;
+  const pad = (n: number) => String(n).padStart(2, '0');
+  const lastZ = `z${pad(N)}`;
+
+  buildIndices();
+
+  let carry = '';
+
+  for (let i = 0; i < N; i++) {
+    const xi = `x${pad(i)}`;
+    const yi = `y${pad(i)}`;
+    const zi = `z${pad(i)}`;
+
+    if (i === 0) {
+      const xorG = find('XOR', xi, yi)!;
+      if (xorG.out !== zi) {
+        doSwap(xorG.out, zi);
+      }
+      carry = find('AND', xi, yi)!.out;
+      continue;
+    }
+
+    let partial = find('XOR', xi, yi)!.out;
+
+    // Find sum gate: XOR(partial, carry) -> zi
+    let sumGate = find('XOR', partial, carry);
+
+    if (!sumGate) {
+      // Strategy 1: carry is wrong (from a previous bit's output swap)
+      // Use partial (reliable — comes directly from XOR(xi, yi)) to find the correct sum gate
+      const xorWithPartial = usedBy(partial, 'XOR')
+        .filter(g => !isXYWire(g.in1) && !isXYWire(g.in2));
+
+      for (const candidate of xorWithPartial) {
+        const expectedCarry = otherInput(candidate, partial);
+        if (expectedCarry === carry) continue;
+        // Skip if candidate is clearly for a different bit (outputs z_j where j != i)
+        if (/^z\d+$/.test(candidate.out) && candidate.out !== zi) continue;
+        doSwap(carry, expectedCarry);
+        carry = expectedCarry;
+        sumGate = candidate;
+        break;
+      }
+
+      // Strategy 2: partial is wrong
+      if (!sumGate) {
+        const xorWithCarry = usedBy(carry, 'XOR')
+          .filter(g => !isXYWire(g.in1) && !isXYWire(g.in2));
+
+        for (const candidate of xorWithCarry) {
+          const expectedPartial = otherInput(candidate, carry);
+          if (expectedPartial === partial) continue;
+          if (/^z\d+$/.test(candidate.out) && candidate.out !== zi) continue;
+          doSwap(partial, expectedPartial);
+          partial = find('XOR', xi, yi)!.out;
+          sumGate = find('XOR', partial, carry);
+          break;
+        }
+      }
+    }
+
+    if (sumGate && sumGate.out !== zi) {
+      doSwap(sumGate.out, zi);
+    }
+
+    // Compute carry for this bit
+    partial = find('XOR', xi, yi)!.out;
+    const gen = find('AND', xi, yi)!.out;
+    const propGate = find('AND', partial, carry);
+
+    if (!propGate) continue;
+
+    const prop = propGate.out;
+    let carryGate = find('OR', gen, prop);
+
+    if (!carryGate) {
+      // Primary: determine expected carry via forward reference to next bit
+      let expectedCarry: string | undefined;
+      if (i < N - 1) {
+        const nextP = pad(i + 1);
+        const nextPartialGate = find('XOR', `x${nextP}`, `y${nextP}`);
+        if (nextPartialGate) {
+          const nextPartial = nextPartialGate.out;
+          const nextSumCandidates = usedBy(nextPartial, 'XOR')
+            .filter(g => !isXYWire(g.in1) && !isXYWire(g.in2));
+          if (nextSumCandidates.length === 1) {
+            expectedCarry = otherInput(nextSumCandidates[0], nextPartial);
+          }
+        }
+      } else {
+        expectedCarry = lastZ;
+      }
+
+      if (expectedCarry) {
+        const orGate = byOutput.get(expectedCarry);
+        if (orGate && orGate.op === 'OR') {
+          const inputs = new Set([orGate.in1, orGate.in2]);
+          if (!inputs.has(gen) && inputs.has(prop)) {
+            doSwap(gen, otherInput(orGate, prop));
+          } else if (inputs.has(gen) && !inputs.has(prop)) {
+            doSwap(prop, otherInput(orGate, gen));
+          }
+          carry = expectedCarry;
+          carryGate = orGate;
+        }
+      }
+
+      // Fallback: usedBy approach with verification
+      if (!carryGate) {
+        let fixed = false;
+
+        const orWithGen = usedBy(gen, 'OR');
+        if (orWithGen.length === 1) {
+          const expectedProp = otherInput(orWithGen[0], gen);
+          doSwap(prop, expectedProp);
+          const newGen = find('AND', xi, yi)!.out;
+          const newProp = find('AND', partial, carry)!.out;
+          carryGate = find('OR', newGen, newProp);
+          if (carryGate) {
+            fixed = true;
+          } else {
+            undoSwap();
+          }
+        }
+
+        if (!fixed) {
+          const orWithProp = usedBy(prop, 'OR');
+          if (orWithProp.length === 1) {
+            const expectedGen = otherInput(orWithProp[0], prop);
+            doSwap(gen, expectedGen);
+            const newGen = find('AND', xi, yi)!.out;
+            const newProp = find('AND', partial, carry)!.out;
+            carryGate = find('OR', newGen, newProp);
+            if (!carryGate) {
+              undoSwap();
+            }
+          }
+        }
+      }
+    }
+
+    if (carryGate) {
+      carry = carryGate.out;
+
+      // Verify carry against next bit's expected input
+      if (i < N - 1) {
+        const nextP = pad(i + 1);
+        const nextPartialGate = find('XOR', `x${nextP}`, `y${nextP}`);
+        if (nextPartialGate) {
+          const nextPartial = nextPartialGate.out;
+          const nextSumCandidates = usedBy(nextPartial, 'XOR')
+            .filter(g => !isXYWire(g.in1) && !isXYWire(g.in2));
+          if (nextSumCandidates.length === 1) {
+            const expectedCarry = otherInput(nextSumCandidates[0], nextPartial);
+            if (carry !== expectedCarry) {
+              doSwap(carry, expectedCarry);
+              carry = expectedCarry;
+            }
+          }
+        }
+      }
+    }
+  }
+
+  if (carry !== lastZ && byOutput.has(lastZ)) {
+    doSwap(carry, lastZ);
+  }
+
+  return [...new Set(swapped)].sort();
+}
