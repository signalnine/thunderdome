ate) throw new Error(`No value for wire ${wire}`);\n    const a = evaluate(gate.in1);\n    const b = evaluate(gate.in2);\n    let result: number;\n    switch (gate.op) {\n      case 'AND': result = a & b; break;\n      case 'OR':  result = a | b; break;\n      case 'XOR': result = a ^ b; break;\n    }\n    values[wire] = result;\n    return result;\n  }\n\n  for (const gate of gates) {\n    evaluate(gate.out);\n  }\n\n  return values;\n}\n\nexport function findSwappedWires(gates: Gate[]): string[] {\n  const gs: Gate[] = gates.map(g => ({ ...g }));\n  const swapped: string[] = [];\n\n  const byOutput = new Map<string, Gate>();\n  const byInputsOp = new Map<string, Gate>();\n\n  function sortedKey(op: string, a: string, b: string): string {\n    return a < b ? `${op}|${a}|${b}` : `${op}|${b}|${a}`;\n  }\n\n  function buildIndices(): void {\n    byOutput.clear();\n    byInputsOp.clear();\n    for (const g of gs) {\n      byOutput.set(g.out, g);\n      byInputsOp.set(sortedKey(g.op, g.in1, g.in2), g);\n    }\n  }\n\n  function find(op: string, a: string, b: string): Gate | undefined {\n    return byInputsOp.get(sortedKey(op, a, b));\n  }\n\n  function usedBy(wire: string, op: string): Gate[] {\n    return gs.filter(g => g.op === op && (g.in1 === wire || g.in2 === wire));\n  }\n\n  function otherInput(gate: Gate, known: string): string {\n    return gate.in1 === known ? gate.in2 : gate.in1;\n  }\n\n  function swapOutputs(w1: string, w2: string): void {\n    const g1 = byOutput.get(w1)!;\n    const g2 = byOutput.get(w2)!;\n    g1.out = w2;\n    g2.out = w1;\n    byOutput.set(w1, g2);\n    byOutput.set(w2, g1);\n  }\n\n  function doSwap(w1: string, w2: string): void {\n    swapped.push(w1, w2);\n    swapOutputs(w1, w2);\n  }\n\n  function undoSwap(): void {\n    const w2 = swapped.pop()!;\n    const w1 = swapped.pop()!;\n    swapOutputs(w1, w2);\n  }\n\n  function isXYWire(w: string): boolean {\n    return /^[xy]\\d+$/.test(w);\n  }\n\n  let maxBit = 0;\n  for (const g of