@@ -0,0 +1,109 @@
+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const wires: Record<string, number> = { ...inputs };
+
+  const pending = new Set(gates);
+  let progress = true;
+  while (pending.size > 0 && progress) {
+    progress = false;
+    for (const gate of pending) {
+      if (wires[gate.in1] === undefined || wires[gate.in2] === undefined) continue;
+      const a = wires[gate.in1];
+      const b = wires[gate.in2];
+      if (gate.op === 'AND') wires[gate.out] = a & b;
+      else if (gate.op === 'OR') wires[gate.out] = a | b;
+      else wires[gate.out] = a ^ b;
+      pending.delete(gate);
+      progress = true;
+    }
+  }
+
+  return wires;
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  const swapped = new Set<string>();
+
+  const maxZ = Math.max(
+    ...gates.filter(g => g.out.startsWith('z')).map(g => parseInt(g.out.slice(1)))
+  );
+  const n = maxZ;
+  const finalZ = `z${String(n).padStart(2, '0')}`;
+
+  const producedBy = new Map<string, Gate>();
+  for (const g of gates) producedBy.set(g.out, g);
+
+  const consumedBy = new Map<string, Gate[]>();
+  for (const g of gates) {
+    for (const w of [g.in1, g.in2]) {
+      let list = consumedBy.get(w);
+      if (!list) { list = []; consumedBy.set(w, list); }
+      list.push(g);
+    }
+  }
+
+  const isXY = (w: string) => w.startsWith('x') || w.startsWith('y');
+  const hasXYInput = (g: Gate) => isXY(g.in1) || isXY(g.in2);
+  const isBit0 = (g: Gate) =>
+    (g.in1 === 'x00' || g.in1 === 'y00') && (g.in2 === 'x00' || g.in2 === 'y00');
+
+  // Rule 1: z wires (z01..z[N-1]) must come from non-input XOR
+  for (let i = 1; i < n; i++) {
+    const zw = `z${String(i).padStart(2, '0')}`;
+    const gate = producedBy.get(zw);
+    if (gate && (gate.op !== 'XOR' || hasXYInput(gate))) {
+      swapped.add(zw);
+    }
+  }
+
+  // Rule 1b: z[N] must come from OR
+  const finalGate = producedBy.get(finalZ);
+  if (finalGate && finalGate.op !== 'OR') {
+    swapped.add(finalZ);
+  }
+
+  // Rule 2: Non-input XOR output must be a z wire
+  for (const g of gates) {
+    if (g.op === 'XOR' && !hasXYInput(g) && !g.out.startsWith('z')) {
+      swapped.add(g.out);
+    }
+  }
+
+  // Rule 3: Input-XOR (not bit 0) output consumed by OR → swapped
+  for (const g of gates) {
+    if (g.op === 'XOR' && hasXYInput(g) && !isBit0(g)) {
+      const consumers = consumedBy.get(g.out) || [];
+      if (consumers.some(c => c.op === 'OR')) {
+        swapped.add(g.out);
+      }
+    }
+  }
+
+  // Rule 4: Input-AND (not bit 0) output consumed by non-input XOR → swapped
+  for (const g of gates) {
+    if (g.op === 'AND' && hasXYInput(g) && !isBit0(g)) {
+      const consumers = consumedBy.get(g.out) || [];
+      if (consumers.some(c => c.op === 'XOR' && !hasXYInput(c))) {
+        swapped.add(g.out);
+      }
+    }
+  }
+
+  // Rule 5: Non-input AND output consumed by non-input XOR → swapped
+  for (const g of gates) {
+    if (g.op === 'AND' && !hasXYInput(g)) {
+      const consumers = consumedBy.get(g.out) || [];
+      if (consumers.some(c => c.op === 'XOR' && !hasXYInput(c))) {
+        swapped.add(g.out);
+      }
+    }
+  }
+
+  return [...swapped].sort();
+}
