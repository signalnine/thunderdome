art(2, '0');\n}\n\nfunction buildCorrectAdder(n: number): Gate[] {\n  const gates: Gate[] = [];\n\n  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });\n  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });\n  let carry = 'c00';\n\n  for (let i = 1; i < n; i++) {\n    const p = pad(i);\n    const t = `t${p}`, a = `a${p}`, b = `b${p}`, c = `c${p}`;\n    gates.push({ op: 'XOR', in1: `x${p}`, in2: `y${p}`, out: t });\n    gates.push({ op: 'XOR', in1: t, in2: carry, out: `z${p}` });\n    gates.push({ op: 'AND', in1: `x${p}`, in2: `y${p}`, out: a });\n    gates.push({ op: 'AND', in1: t, in2: carry, out: b });\n    gates.push({ op: 'OR', in1: a, in2: b, out: c });\n    carry = c;\n  }\n\n  // Rename last carry to z[n]\n  const finalZ = `z${pad(n)}`;\n  for (const g of gates) {\n    if (g.out === carry) g.out = finalZ;\n    if (g.in1 === carry) g.in1 = finalZ;\n    if (g.in2 === carry) g.in2 = finalZ;\n  }\n\n  return gates;\n}\n\nfunction applySwaps(gates: Gate[], pairs: [string, string][]): Gate[] {\n  const swapMap = new Map<string, string>();\n  for (const [a, b] of pairs) {\n    swapMap.set(a, b);\n    swapMap.set(b, a);\n  }\n  return gates.map((g) => ({\n    ...g,\n    out: swapMap.get(g.out) ?? g.out,\n  }));\n}\n\nfunction makeInputs(n: number, x: bigint, y: bigint): Record<string, number> {\n  const inputs: Record<string, number> = {};\n  for (let i = 0; i < n; i++) {\n    const p = pad(i);\n    inputs[`x${p}`] = Number((x >> BigInt(i)) & 1n);\n    inputs[`y${p}`] = Number((y >> BigInt(i)) & 1n);\n  }\n  return inputs;\n}\n\nfunction readZ(wires: Record<string, number>, n: number): bigint {\n  let result = 0n;\n  for (let i = 0; i <= n; i++) {\n    const p = pad(i);\n    const bit = wires[`z${p}`];\n    if (bit) result |= BigInt(bit) << BigInt(i);\n  }\n  return result;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":80,"cache_read_input_