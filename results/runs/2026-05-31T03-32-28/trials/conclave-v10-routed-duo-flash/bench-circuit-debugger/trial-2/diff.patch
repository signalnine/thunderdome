@@ -0,0 +1,171 @@
+import { describe, it, expect } from 'vitest';
+import { simulate, findSwappedWires } from '../src/index.js';
+import type { Gate } from '../src/index.js';
+
+describe('simulate', () => {
+  it('single AND gate: both 1 → 1', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    const result = simulate(gates, { a: 1, b: 1 });
+    expect(result).toMatchObject({ a: 1, b: 1, c: 1 });
+  });
+
+  it('single AND gate: one 0 → 0', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(0);
+    expect(simulate(gates, { a: 0, b: 1 }).c).toBe(0);
+    expect(simulate(gates, { a: 0, b: 0 }).c).toBe(0);
+  });
+
+  it('OR gate', () => {
+    const gates: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(1);
+    expect(simulate(gates, { a: 0, b: 1 }).c).toBe(1);
+    expect(simulate(gates, { a: 1, b: 1 }).c).toBe(1);
+    expect(simulate(gates, { a: 0, b: 0 }).c).toBe(0);
+  });
+
+  it('XOR gate', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(1);
+    expect(simulate(gates, { a: 0, b: 1 }).c).toBe(1);
+    expect(simulate(gates, { a: 1, b: 1 }).c).toBe(0);
+    expect(simulate(gates, { a: 0, b: 0 }).c).toBe(0);
+  });
+
+  it('chain of dependent gates (out of order)', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 't', in2: 'c', out: 'out' },
+      { op: 'AND', in1: 'a', in2: 'b', out: 't' },
+    ];
+    const result = simulate(gates, { a: 1, b: 1, c: 1 });
+    expect(result.t).toBe(1);
+    expect(result.out).toBe(0);
+  });
+
+  it('simulates a correct 4-bit adder', () => {
+    const gates = buildCorrectAdder(4);
+    const inputs = makeInputs(4, 3n, 5n);
+    const result = simulate(gates, inputs);
+    expect(readZ(result, 4)).toBe(8n);
+  });
+
+  it('simulates a correct 8-bit adder', () => {
+    const gates = buildCorrectAdder(8);
+    const inputs = makeInputs(8, 200n, 100n);
+    const result = simulate(gates, inputs);
+    expect(readZ(result, 8)).toBe(300n);
+  });
+});
+
+describe('findSwappedWires', () => {
+  it('detects z ↔ a swap in 8-bit adder', () => {
+    const gates = buildCorrectAdder(8);
+    const swapped = applySwaps(gates, [
+      ['z03', 'a03'],
+      ['z05', 'b02'],
+      ['t04', 'a06'],
+      ['t07', 'b05'],
+    ]);
+    const result = findSwappedWires(swapped);
+    expect(result).toEqual(['a03', 'a06', 'b02', 'b05', 't04', 't07', 'z03', 'z05'].sort());
+  });
+
+  it('returns sorted array of 8 wires', () => {
+    const gates = buildCorrectAdder(10);
+    const swapped = applySwaps(gates, [
+      ['z02', 'a04'],
+      ['z06', 'b03'],
+      ['t05', 'a07'],
+      ['t09', 'b08'],
+    ]);
+    const result = findSwappedWires(swapped);
+    expect(result.length).toBe(8);
+    expect(result).toEqual([...result].sort());
+  });
+
+  it('fixing found swaps makes adder work', () => {
+    const n = 10;
+    const gates = buildCorrectAdder(n);
+    const pairs: [string, string][] = [
+      ['z02', 'a04'],
+      ['z06', 'b03'],
+      ['t05', 'a07'],
+      ['t09', 'b08'],
+    ];
+    const swapped = applySwaps(gates, pairs);
+    const found = findSwappedWires(swapped);
+    expect(found.length).toBe(8);
+
+    // Verify the original (unswapped) adder works
+    const inputs = makeInputs(n, 500n, 523n);
+    const correctResult = simulate(gates, inputs);
+    expect(readZ(correctResult, n)).toBe(1023n);
+  });
+});
+
+// ─── Helpers ──────────────────────────────────────────────────────────────────
+
+function pad(i: number): string {
+  return String(i).padStart(2, '0');
+}
+
+function buildCorrectAdder(n: number): Gate[] {
+  const gates: Gate[] = [];
+
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+  let carry = 'c00';
+
+  for (let i = 1; i < n; i++) {
+    const p = pad(i);
+    const t = `t${p}`, a = `a${p}`, b = `b${p}`, c = `c${p}`;
+    gates.push({ op: 'XOR', in1: `x${p}`, in2: `y${p}`, out: t });
+    gates.push({ op: 'XOR', in1: t, in2: carry, out: `z${p}` });
+    gates.push({ op: 'AND', in1: `x${p}`, in2: `y${p}`, out: a });
+    gates.push({ op: 'AND', in1: t, in2: carry, out: b });
+    gates.push({ op: 'OR', in1: a, in2: b, out: c });
+    carry = c;
+  }
+
+  // Rename last carry to z[n]
+  const finalZ = `z${pad(n)}`;
+  for (const g of gates) {
+    if (g.out === carry) g.out = finalZ;
+    if (g.in1 === carry) g.in1 = finalZ;
+    if (g.in2 === carry) g.in2 = finalZ;
+  }
+
+  return gates;
+}
+
+function applySwaps(gates: Gate[], pairs: [string, string][]): Gate[] {
+  const swapMap = new Map<string, string>();
+  for (const [a, b] of pairs) {
+    swapMap.set(a, b);
+    swapMap.set(b, a);
+  }
+  return gates.map((g) => ({
+    ...g,
+    out: swapMap.get(g.out) ?? g.out,
+  }));
+}
+
+function makeInputs(n: number, x: bigint, y: bigint): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < n; i++) {
+    const p = pad(i);
+    inputs[`x${p}`] = Number((x >> BigInt(i)) & 1n);
+    inputs[`y${p}`] = Number((y >> BigInt(i)) & 1n);
+  }
+  return inputs;
+}
+
+function readZ(wires: Record<string, number>, n: number): bigint {
+  let result = 0n;
+  for (let i = 0; i <= n; i++) {
+    const p = pad(i);
+    const bit = wires[`z${p}`];
+    if (bit) result |= BigInt(bit) << BigInt(i);
+  }
+  return result;
+}
