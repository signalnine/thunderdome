diff --git a/src/bits.ts b/src/bits.ts
new file mode 100644
index 0000000..31bc091
--- /dev/null
+++ b/src/bits.ts
@@ -0,0 +1,64 @@
+/** Small helpers for the fixed-width bitsets used by the toggle solver. */
+
+/** Number of 32-bit words needed to hold `n` bits (at least one). */
+export function wordsFor(n: number): number {
+  return Math.max(1, (n + 31) >>> 5);
+}
+
+export function popcount32(x: number): number {
+  let v = x - ((x >>> 1) & 0x55555555);
+  v = (v & 0x33333333) + ((v >>> 2) & 0x33333333);
+  v = (v + (v >>> 4)) & 0x0f0f0f0f;
+  return Math.imul(v, 0x01010101) >>> 24;
+}
+
+/** Index of the lowest set bit. Undefined for 0. */
+export function ctz32(x: number): number {
+  return 31 - Math.clz32(x & -x);
+}
+
+export function getBit(bits: Uint32Array, i: number): number {
+  return (bits[i >>> 5] >>> (i & 31)) & 1;
+}
+
+export function setBit(bits: Uint32Array, i: number): void {
+  bits[i >>> 5] |= 1 << (i & 31);
+}
+
+export function popcountBits(bits: Uint32Array): number {
+  let total = 0;
+  for (let i = 0; i < bits.length; i++) total += popcount32(bits[i]);
+  return total;
+}
+
+export function xorInto(dst: Uint32Array, src: Uint32Array): void {
+  for (let i = 0; i < dst.length; i++) dst[i] ^= src[i];
+}
+
+/**
+ * True when the index list described by `a` is lexicographically smaller than
+ * the one described by `b`. Both are read as ascending index lists, so the
+ * winner is whichever set contains the lowest index the other one lacks.
+ * Only meaningful for sets of equal size (the caller compares sizes first).
+ */
+export function lexLessWord(a: number, b: number): boolean {
+  const diff = (a ^ b) >>> 0;
+  if (diff === 0) return false;
+  const lowest = diff & -diff;
+  return (a & lowest) !== 0;
+}
+
+/** Bitset version of {@link lexLessWord}. */
+export function lexLessBits(a: Uint32Array, b: Uint32Array): boolean {
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] !== b[i]) return lexLessWord(a[i], b[i]);
+  }
+  return false;
+}
+
+/** Expand a bitset into the ascending list of set indices. */
+export function bitsToIndices(bits: Uint32Array, limit: number): number[] {
+  const out: number[] = [];
+  for (let i = 0; i < limit; i++) if (getBit(bits, i)) out.push(i);
+  return out;
+}
diff --git a/src/counter.ts b/src/counter.ts
new file mode 100644
index 0000000..ac503a4
--- /dev/null
+++ b/src/counter.ts
@@ -0,0 +1,584 @@
+/**
+ * Part 2: counters instead of lights. Button `i` increments each counter it
+ * touches by one, counters wrap at a prime modulus, and a button may be pressed
+ * 0..modulus-1 times. Finding *a* press vector is a linear system over the
+ * field Z_p; finding the *cheapest* one is a minimum-weight coset problem,
+ * which is what most of this file is about.
+ */
+
+/** How many complete solutions we are willing to enumerate exhaustively. */
+const ENUMERATION_LIMIT = 4_000_000;
+
+/** Independent local-search runs used to bound the deepening search. */
+const SEED_RESTARTS = 10;
+
+/** Sweeps of dual ascent used to build the search's lower bounds. */
+const DUAL_SWEEPS = 4;
+
+/**
+ * Wall-clock ceiling for the deepening search, comfortably inside the 5s
+ * contract. Minimum-weight search over a huge coset is NP-hard in general, so on
+ * an instance that neither collapses, enumerates, nor has a cheap solution we
+ * return the best solution local search found instead of running forever. Any
+ * instance whose optimum is small enough to reach is answered exactly.
+ */
+const SEARCH_BUDGET_MS = 2500;
+
+/** A system whose buttons all have distinct, non-empty counter sets. */
+interface System {
+  buttonCount: number;
+  counterCount: number;
+  /** Counter indices touched by each button, deduplicated and ascending. */
+  buttonCounters: number[][];
+  /** Target value of each counter, reduced into 0..p-1. */
+  target: Int32Array;
+}
+
+/** Multiplicative inverses mod a prime `p`, indexed 1..p-1 (slot 0 unused). */
+function inverseTable(p: number): Int32Array {
+  const inv = new Int32Array(p);
+  for (let a = 1; a < p; a++) {
+    for (let b = 1; b < p; b++) {
+      if ((a * b) % p === 1) {
+        inv[a] = b;
+        break;
+      }
+    }
+  }
+  return inv;
+}
+
+interface Reduced {
+  /** Solution with every free variable set to 0, one entry per button. */
+  particular: Int32Array;
+  /** Null-space basis vectors, one per free variable. */
+  basis: Int32Array[];
+}
+
+/** Row-reduce the system mod `p`; `null` means the target is unreachable. */
+function reduce(system: System, p: number, inv: Int32Array): Reduced | null {
+  const { buttonCount: m, counterCount, buttonCounters, target } = system;
+  const width = m + 1;
+  const rhs = m;
+
+  const rows: Int32Array[] = [];
+  for (let counter = 0; counter < counterCount; counter++) {
+    const row = new Int32Array(width);
+    row[rhs] = target[counter];
+    rows.push(row);
+  }
+  for (let button = 0; button < m; button++) {
+    for (const counter of buttonCounters[button]) rows[counter][button] = 1;
+  }
+
+  const pivotCols: number[] = [];
+  let rank = 0;
+  for (let col = 0; col < m && rank < counterCount; col++) {
+    let sel = -1;
+    for (let r = rank; r < counterCount; r++) {
+      if (rows[r][col] !== 0) {
+        sel = r;
+        break;
+      }
+    }
+    if (sel < 0) continue;
+    const tmp = rows[rank];
+    rows[rank] = rows[sel];
+    rows[sel] = tmp;
+
+    const pivot = rows[rank];
+    const scale = inv[pivot[col]];
+    if (scale !== 1) {
+      for (let w = 0; w < width; w++) pivot[w] = (pivot[w] * scale) % p;
+    }
+    // Free columns left of `col` can still be nonzero, so the whole row has to
+    // take part in the update.
+    for (let r = 0; r < counterCount; r++) {
+      if (r === rank) continue;
+      const factor = rows[r][col];
+      if (factor === 0) continue;
+      const row = rows[r];
+      for (let w = 0; w < width; w++) {
+        row[w] = (row[w] - factor * pivot[w]) % p;
+        if (row[w] < 0) row[w] += p;
+      }
+    }
+    pivotCols.push(col);
+    rank++;
+  }
+
+  for (let r = rank; r < counterCount; r++) {
+    if (rows[r][rhs] !== 0) return null;
+  }
+
+  const particular = new Int32Array(m);
+  for (let r = 0; r < rank; r++) particular[pivotCols[r]] = rows[r][rhs];
+
+  const isPivot = new Uint8Array(m);
+  for (const col of pivotCols) isPivot[col] = 1;
+  const basis: Int32Array[] = [];
+  for (let col = 0; col < m; col++) {
+    if (isPivot[col]) continue;
+    const vec = new Int32Array(m);
+    vec[col] = 1;
+    for (let r = 0; r < rank; r++) {
+      const coeff = rows[r][col];
+      if (coeff !== 0) vec[pivotCols[r]] = (p - coeff) % p;
+    }
+    basis.push(vec);
+  }
+
+  return { particular, basis };
+}
+
+function pressTotal(x: Int32Array): number {
+  let sum = 0;
+  for (let i = 0; i < x.length; i++) sum += x[i];
+  return sum;
+}
+
+/** True when `a` sorts before `b`: fewer presses first, then lexicographic. */
+function better(a: Int32Array, aSum: number, b: Int32Array, bSum: number): boolean {
+  if (aSum !== bSum) return aSum < bSum;
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] !== b[i]) return a[i] < b[i];
+  }
+  return false;
+}
+
+/** Add one basis vector into `x`, all mod `p`. */
+function addVector(x: Int32Array, vec: Int32Array, p: number): void {
+  for (let i = 0; i < x.length; i++) {
+    const sum = x[i] + vec[i];
+    x[i] = sum >= p ? sum - p : sum;
+  }
+}
+
+/**
+ * Visit every point of the solution space in mixed-radix order, moving by a
+ * single basis vector per step. Used when p^k is small enough to enumerate.
+ */
+function searchExhaustive(reduced: Reduced, p: number, combos: number): Int32Array {
+  const { particular, basis } = reduced;
+  const k = basis.length;
+  const cur = Int32Array.from(particular);
+  let best = Int32Array.from(cur);
+  let bestSum = pressTotal(cur);
+
+  const digits = new Int32Array(k);
+  for (let step = 1; step < combos; step++) {
+    // Advance the odometer. Rolling a digit from p-1 back to 0 is also a single
+    // basis-vector addition, so every carry is one more add.
+    for (let j = 0; j < k; j++) {
+      digits[j] = digits[j] + 1 === p ? 0 : digits[j] + 1;
+      addVector(cur, basis[j], p);
+      if (digits[j] !== 0) break;
+    }
+    const sum = pressTotal(cur);
+    if (better(cur, sum, best, bestSum)) {
+      best = Int32Array.from(cur);
+      bestSum = sum;
+    }
+  }
+  return best;
+}
+
+/** Deterministic 32-bit LCG, so results never depend on Math.random. */
+function makeRandom(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state;
+  };
+}
+
+/**
+ * Upper bound for the deepening search: coordinate descent over the free
+ * coefficients, restarted from several random points in the solution space.
+ * Moving one coefficient is a single scaled basis-vector addition, so a whole
+ * sweep costs O(k * p * m).
+ */
+function seedSolution(reduced: Reduced, p: number): { sol: Int32Array; sum: number } {
+  const { particular, basis } = reduced;
+  const k = basis.length;
+  const m = particular.length;
+  const random = makeRandom(0x9e3779b9);
+
+  let best: Int32Array = Int32Array.from(particular);
+  let bestSum = pressTotal(best);
+
+  const coeffs = new Int32Array(k);
+  const cur = new Int32Array(m);
+  const trial = new Int32Array(m);
+  const winner = new Int32Array(m);
+
+  for (let restart = 0; restart < SEED_RESTARTS; restart++) {
+    cur.set(particular);
+    for (let j = 0; j < k; j++) {
+      const value = restart === 0 ? 0 : random() % p;
+      coeffs[j] = value;
+      if (value !== 0) {
+        const vec = basis[j];
+        for (let i = 0; i < m; i++) cur[i] = (cur[i] + value * vec[i]) % p;
+      }
+    }
+    let curSum = pressTotal(cur);
+
+    let improved = true;
+    while (improved) {
+      improved = false;
+      for (let j = 0; j < k; j++) {
+        const vec = basis[j];
+        const original = coeffs[j];
+        let winnerValue = original;
+        let winnerSum = curSum;
+        let found = false;
+        for (let value = 0; value < p; value++) {
+          if (value === original) continue;
+          const delta = value - original + (value < original ? p : 0);
+          for (let i = 0; i < m; i++) trial[i] = (cur[i] + delta * vec[i]) % p;
+          const sum = pressTotal(trial);
+          if (better(trial, sum, found ? winner : cur, winnerSum)) {
+            winner.set(trial);
+            winnerValue = value;
+            winnerSum = sum;
+            found = true;
+          }
+        }
+        if (found) {
+          coeffs[j] = winnerValue;
+          cur.set(winner);
+          curSum = winnerSum;
+          improved = true;
+        }
+      }
+    }
+
+    if (better(cur, curSum, best, bestSum)) {
+      best = Int32Array.from(cur);
+      bestSum = curSum;
+    }
+  }
+
+  return { sol: best, sum: bestSum };
+}
+
+/**
+ * Lower-bound weights, one vector per suffix of the button list.
+ *
+ * Any press vector that still has to raise counter `c` by `r_c` satisfies
+ * `sum over available buttons touching c of x_j >= r_c`. So for weights `y >= 0`
+ * where every available button's touched counters sum to at most 1, the total
+ * remaining presses are at least `y . r`. Those weights are built greedily
+ * (dual ascent on the covering LP), cheapest counters first.
+ */
+function dualWeights(cols: Uint8Array[], counterCount: number, m: number): Float64Array[] {
+  const perSuffix: Float64Array[] = [];
+  for (let from = 0; from <= m; from++) {
+    const y = new Float64Array(counterCount);
+    const slack = new Float64Array(m);
+    for (let j = from; j < m; j++) slack[j] = 1;
+
+    const touches = new Int32Array(counterCount);
+    for (let j = from; j < m; j++) {
+      for (let r = 0; r < counterCount; r++) if (cols[j][r]) touches[r]++;
+    }
+    const order: number[] = [];
+    for (let r = 0; r < counterCount; r++) if (touches[r] > 0) order.push(r);
+    order.sort((a, b) => touches[a] - touches[b] || a - b);
+
+    for (let sweep = 0; sweep < DUAL_SWEEPS; sweep++) {
+      let changed = false;
+      for (const r of order) {
+        let room = Infinity;
+        for (let j = from; j < m; j++) {
+          if (cols[j][r] && slack[j] < room) room = slack[j];
+        }
+        if (room === Infinity || room <= 1e-12) continue;
+        y[r] += room;
+        for (let j = from; j < m; j++) {
+          if (cols[j][r]) slack[j] = Math.max(0, slack[j] - room);
+        }
+        changed = true;
+      }
+      if (!changed) break;
+    }
+    perSuffix.push(y);
+  }
+  return perSuffix;
+}
+
+/**
+ * Iterative deepening on the press total, used when the solution space is too
+ * large to enumerate.
+ *
+ * Each pass explores only what could still total `threshold` or less, in index
+ * order with the smallest press count tried first - so the pass visits press
+ * vectors in lexicographic order and the first complete solution it reaches is
+ * the lexicographically smallest one within the threshold. Failed passes jump
+ * the threshold to the smallest total any pruned branch could reach, so the
+ * first pass that succeeds returns the true optimum: no cheaper solution exists,
+ * and none lexicographically smaller shares its total.
+ *
+ * Searching by increasing total (rather than keeping an incumbent and pruning
+ * against it) is what makes this practical: a cheap solution is found while the
+ * threshold is still small enough to keep the tree tiny, instead of the search
+ * sinking its whole budget into the first subtree.
+ *
+ * Two prunes do the work: the covering lower bound described on
+ * {@link dualWeights}, together with the trivial "counter `c` needs at least
+ * `r_c` more presses"; and the requirement that the residual lie in the span of
+ * the columns that are still available.
+ */
+function searchIterativeDeepening(
+  system: System,
+  reduced: Reduced,
+  p: number,
+  inv: Int32Array,
+): Int32Array {
+  const { buttonCount: m, counterCount: nc, buttonCounters, target } = system;
+
+  const cols: Uint8Array[] = [];
+  for (let button = 0; button < m; button++) {
+    const col = new Uint8Array(nc);
+    for (const counter of buttonCounters[button]) col[counter] = 1;
+    cols.push(col);
+  }
+
+  // Echelon basis of the column span, grown from the last button backwards, so
+  // the first `spanSize[i]` vectors span exactly the columns i..m-1.
+  const spanVecs: Int32Array[] = [];
+  const spanPivots: number[] = [];
+  const spanSize = new Int32Array(m + 1);
+  for (let i = m - 1; i >= 0; i--) {
+    const vec = new Int32Array(nc);
+    for (let r = 0; r < nc; r++) vec[r] = cols[i][r];
+    for (let j = 0; j < spanVecs.length; j++) {
+      const coeff = vec[spanPivots[j]];
+      if (coeff === 0) continue;
+      const basisVec = spanVecs[j];
+      for (let r = 0; r < nc; r++) {
+        vec[r] = (vec[r] - coeff * basisVec[r]) % p;
+        if (vec[r] < 0) vec[r] += p;
+      }
+    }
+    let pivot = -1;
+    for (let r = 0; r < nc; r++) {
+      if (vec[r] !== 0) {
+        pivot = r;
+        break;
+      }
+    }
+    if (pivot >= 0) {
+      const scale = inv[vec[pivot]];
+      if (scale !== 1) {
+        for (let r = 0; r < nc; r++) vec[r] = (vec[r] * scale) % p;
+      }
+      spanVecs.push(vec);
+      spanPivots.push(pivot);
+    }
+    spanSize[i] = spanVecs.length;
+  }
+
+  const scratch = new Int32Array(nc);
+  const reachable = (from: number, residual: Int32Array): boolean => {
+    scratch.set(residual);
+    const size = spanSize[from];
+    for (let j = 0; j < size; j++) {
+      const coeff = scratch[spanPivots[j]];
+      if (coeff === 0) continue;
+      const vec = spanVecs[j];
+      for (let r = 0; r < nc; r++) {
+        scratch[r] = (scratch[r] - coeff * vec[r]) % p;
+        if (scratch[r] < 0) scratch[r] += p;
+      }
+    }
+    for (let r = 0; r < nc; r++) if (scratch[r] !== 0) return false;
+    return true;
+  };
+
+  const weights = dualWeights(cols, nc, m);
+
+  /** Lower bound on the presses still needed to clear `residual`. */
+  const remainingBound = (depth: number, residual: Int32Array): number => {
+    const y = weights[depth];
+    let largest = 0;
+    let covering = 0;
+    for (let r = 0; r < nc; r++) {
+      const value = residual[r];
+      if (value > largest) largest = value;
+      covering += y[r] * value;
+    }
+    const rounded = Math.ceil(covering - 1e-9);
+    return rounded > largest ? rounded : largest;
+  };
+
+  // Local search gives a solution to fall back on and caps the deepening.
+  const seed = seedSolution(reduced, p);
+  const ceiling = seed.sum;
+
+  const deadline = Date.now() + SEARCH_BUDGET_MS;
+  let sinceClockCheck = 0;
+  let outOfTime = false;
+
+  const cur = new Int32Array(m);
+  let solution: Int32Array | null = null;
+  let threshold = 0;
+  let nextThreshold = Infinity;
+  // One residual buffer per depth: only a single frame per depth is ever live.
+  const buffers: Int32Array[] = [];
+  for (let i = 0; i <= m; i++) buffers.push(new Int32Array(nc));
+
+  /** Explore everything that could still total `threshold` or less. */
+  const dfs = (depth: number, residual: Int32Array, sum: number): boolean => {
+    if (++sinceClockCheck >= 2048) {
+      sinceClockCheck = 0;
+      if (Date.now() > deadline) outOfTime = true;
+    }
+    if (outOfTime) return false;
+
+    const lower = remainingBound(depth, residual);
+    const floorSum = sum + lower;
+    if (floorSum > threshold) {
+      if (floorSum < nextThreshold) nextThreshold = floorSum;
+      return false;
+    }
+    if (lower === 0) {
+      // Residual cleared: leaving every remaining button alone is both the
+      // cheapest and the lexicographically smallest way to finish.
+      const answer = new Int32Array(m);
+      for (let j = 0; j < depth; j++) answer[j] = cur[j];
+      solution = answer;
+      return true;
+    }
+    if (depth === m) return false;
+    if (!reachable(depth, residual)) return false;
+
+    const col = cols[depth];
+    const child = buffers[depth];
+    child.set(residual);
+    for (let presses = 0; presses < p; presses++) {
+      const nextSum = sum + presses;
+      if (nextSum > threshold) {
+        if (nextSum < nextThreshold) nextThreshold = nextSum;
+        break;
+      }
+      if (presses > 0) {
+        for (let r = 0; r < nc; r++) {
+          if (col[r] === 0) continue;
+          child[r] = child[r] === 0 ? p - 1 : child[r] - 1;
+        }
+      }
+      cur[depth] = presses;
+      if (dfs(depth + 1, child, nextSum)) return true;
+      if (outOfTime) return false;
+    }
+    cur[depth] = 0;
+    return false;
+  };
+
+  const root = Int32Array.from(target);
+  threshold = remainingBound(0, root);
+  while (threshold <= ceiling) {
+    nextThreshold = Infinity;
+    cur.fill(0);
+    if (dfs(0, root, 0) && solution !== null) return solution;
+    // Nothing totals `threshold` or less, so jump straight to the smallest
+    // total any pruned branch could still reach.
+    if (outOfTime || nextThreshold === Infinity) break;
+    threshold = nextThreshold;
+  }
+  return seed.sol;
+}
+
+/** Solve a system whose buttons are already distinct and non-empty. */
+function solveSystem(system: System, p: number, inv: Int32Array): Int32Array | null {
+  const reduced = reduce(system, p, inv);
+  if (reduced === null) return null;
+  const k = reduced.basis.length;
+  if (k === 0) return reduced.particular;
+  const combos = p ** k;
+  return combos <= ENUMERATION_LIMIT
+    ? searchExhaustive(reduced, p, combos)
+    : searchIterativeDeepening(system, reduced, p, inv);
+}
+
+/**
+ * Find how many times to press each button so the counters reach `lights`,
+ * minimizing the total number of presses (ties broken lexicographically), or
+ * `null` when the target is unreachable.
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const rawButtons = buttons ?? [];
+  const rawTarget = lights ?? [];
+  const buttonCount = rawButtons.length;
+
+  if (!Number.isInteger(modulus) || modulus < 1) return null;
+  if (modulus === 1) {
+    // Every counter is permanently 0, so nothing ever needs pressing.
+    return new Array<number>(buttonCount).fill(0);
+  }
+  const p = modulus;
+
+  // Deduplicate each button's counter list and learn how many counters exist.
+  // A counter mentioned by a button but missing from `lights` still has to end
+  // at 0, so it takes part in the system.
+  let counterCount = rawTarget.length;
+  const perButton: number[][] = [];
+  for (const raw of rawButtons) {
+    const seen = new Set<number>();
+    for (const idx of raw ?? []) {
+      if (!Number.isInteger(idx) || idx < 0) continue;
+      seen.add(idx);
+      if (idx + 1 > counterCount) counterCount = idx + 1;
+    }
+    perButton.push([...seen].sort((a, b) => a - b));
+  }
+
+  const target = new Int32Array(counterCount);
+  for (let i = 0; i < rawTarget.length; i++) {
+    const raw = Number(rawTarget[i]);
+    const value = Number.isFinite(raw) ? Math.trunc(raw) : 0;
+    target[i] = ((value % p) + p) % p;
+  }
+
+  // Buttons with the same counter set are interchangeable: only the total of
+  // their presses matters. Collapse each such family into one unknown, which
+  // shrinks the solution space enormously on degenerate inputs. A family whose
+  // total is `v` costs `v` presses at best, spent entirely on one member, and
+  // the lexicographically smallest way to do that is to press the *last* one.
+  // Buttons that touch nothing are simply never pressed.
+  const families = new Map<string, number[]>();
+  for (let button = 0; button < buttonCount; button++) {
+    const counters = perButton[button];
+    if (counters.length === 0) continue;
+    const key = counters.join(',');
+    const family = families.get(key);
+    if (family === undefined) families.set(key, [button]);
+    else family.push(button);
+  }
+
+  // Ordering the unknowns by the button that carries them keeps lexicographic
+  // comparisons on the collapsed system equivalent to the original ones.
+  const carriers = [...families.values()].map((family) => family[family.length - 1]);
+  carriers.sort((a, b) => a - b);
+
+  const system: System = {
+    buttonCount: carriers.length,
+    counterCount,
+    buttonCounters: carriers.map((button) => perButton[button]),
+    target,
+  };
+
+  const inv = inverseTable(p);
+  const solved = solveSystem(system, p, inv);
+  if (solved === null) return null;
+
+  const result = new Array<number>(buttonCount).fill(0);
+  for (let i = 0; i < carriers.length; i++) result[carriers[i]] = solved[i];
+  return result;
+}
