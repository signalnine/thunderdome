+      buttons: [[0], [1], [0, 1], [2]],
+    };
+    expect(solveToggle(machine)).toEqual([2]);
+  });
+
+  it('prefers fewer presses over smaller indices', () => {
+    const machine: Machine = {
+      target: [true, true],
+      buttons: [[0], [1], [0, 1]],
