+import { describe, expect, it } from 'vitest';
+import { solveToggle } from '../src/index.js';
+import type { Machine } from '../src/index.js';
+
+/** Apply a set of button presses and report the resulting light state. */
+function applyPresses(machine: Machine, presses: number[]): boolean[] {
+  const lights = machine.target.map(() => false);
+  for (const button of presses) {
+    for (const light of machine.buttons[button]) lights[light] = !lights[light];
+  }
+  return lights;
+}
+
+/** Reference solver: try every subset of buttons. Only for tiny instances. */
+function bruteForce(machine: Machine): number[] | null {
+  const m = machine.buttons.length;
+  let best: number[] | null = null;
+  for (let mask = 0; mask < 1 << m; mask++) {
+    const presses: number[] = [];
+    for (let i = 0; i < m; i++) if ((mask >>> i) & 1) presses.push(i);
+    const result = applyPresses(machine, presses);
+    if (!result.every((v, i) => v === machine.target[i])) continue;
+    if (best === null || presses.length < best.length) {
+      best = presses;
+      continue;
+    }
+    if (presses.length === best.length) {
+      for (let i = 0; i < presses.length; i++) {
+        if (presses[i] !== best[i]) {
+          if (presses[i] < best[i]) best = presses;
+          break;
+        }
+      }
+    }
+  }
+  return best;
+}
+
+function makeRandom(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state / 4294967296;
+  };
+}
