+import type { Machine } from './types.js';
+import {
+  bitsToIndices,
+  ctz32,
+  getBit,
+  lexLessBits,
+  lexLessWord,
+  popcount32,
+  popcountBits,
+  setBit,
+  wordsFor,
+  xorInto,
+} from './bits.js';
+
+/**
+ * Normalized view of a machine: one light-mask per button plus the target mask.
+ * Duplicate light indices inside a button are collapsed (a button toggles a
+ * *set* of lights), and any light a button mentions beyond `target.length` is
+ * still tracked — such a light starts off and must end off.
+ */
+interface Normalized {
+  buttonCount: number;
+  lightCount: number;
+  /** Light indices toggled by each button, deduplicated and ascending. */
+  buttonLights: number[][];
+  target: boolean[];
+}
+
+function normalize(machine: Machine): Normalized {
+  const rawTarget = machine?.target ?? [];
+  const rawButtons = machine?.buttons ?? [];
+  let lightCount = rawTarget.length;
+  const buttonLights: number[][] = [];
+
+  for (const raw of rawButtons) {
+    const seen = new Set<number>();
+    for (const idx of raw ?? []) {
+      if (!Number.isInteger(idx) || idx < 0) continue;
+      seen.add(idx);
+      if (idx + 1 > lightCount) lightCount = idx + 1;
+    }
+    buttonLights.push([...seen].sort((a, b) => a - b));
+  }
+
+  return {
+    buttonCount: rawButtons.length,
+    lightCount,
+    buttonLights,
+    target: rawTarget.map((v) => Boolean(v)),
+  };
+}
+
+/** Result of Gaussian elimination on the GF(2) system `A x = target`. */
+interface Reduced {
+  /** Solution with every free variable set to 0. */
+  particular: Uint32Array;
+  /** Null-space basis vectors, one per free variable. */
+  basis: Uint32Array[];
+}
+
+/**
+ * Row-reduce the system "for each light, the XOR of the buttons touching it
+ * equals the target". Returns `null` when the system is inconsistent.
+ */
+function reduce(n: Normalized): Reduced | null {
+  const { buttonCount: m, lightCount, buttonLights, target } = n;
+  const rowWords = wordsFor(m + 1);
+  const rhs = m; // the augmented column lives right after the coefficients
+
+  const rows: Uint32Array[] = [];
+  for (let light = 0; light < lightCount; light++) {
+    const row = new Uint32Array(rowWords);
+    if (target[light]) setBit(row, rhs);
+    rows.push(row);
+  }
+  for (let button = 0; button < m; button++) {
+    for (const light of buttonLights[button]) setBit(rows[light], button);
+  }
+
+  const pivotCols: number[] = [];
+  let rank = 0;
+  for (let col = 0; col < m && rank < lightCount; col++) {
+    let sel = -1;
+    for (let r = rank; r < lightCount; r++) {
+      if (getBit(rows[r], col)) {
+        sel = r;
+        break;
+      }
+    }
+    if (sel < 0) continue;
+    const tmp = rows[rank];
+    rows[rank] = rows[sel];
+    rows[sel] = tmp;
+    const pivot = rows[rank];
+    for (let r = 0; r < lightCount; r++) {
+      if (r !== rank && getBit(rows[r], col)) xorInto(rows[r], pivot);
+    }
+    pivotCols.push(col);
+    rank++;
+  }
+
+  // Rows below the rank have no coefficients left; a set RHS means "0 = 1".
+  for (let r = rank; r < lightCount; r++) {
+    if (getBit(rows[r], rhs)) return null;
+  }
+
+  const solutionWords = wordsFor(m);
+  const particular = new Uint32Array(solutionWords);
+  for (let r = 0; r < rank; r++) {
+    if (getBit(rows[r], rhs)) setBit(particular, pivotCols[r]);
+  }
+
+  const isPivot = new Uint8Array(m);
+  for (const col of pivotCols) isPivot[col] = 1;
+  const basis: Uint32Array[] = [];
+  for (let col = 0; col < m; col++) {
+    if (isPivot[col]) continue;
+    const vec = new Uint32Array(solutionWords);
+    setBit(vec, col);
+    for (let r = 0; r < rank; r++) {
+      if (getBit(rows[r], col)) setBit(vec, pivotCols[r]);
+    }
+    basis.push(vec);
+  }
+
+  return { particular, basis };
+}
+
+/**
+ * Walk the whole solution space (particular solution XOR every combination of
+ * null-space basis vectors) in Gray-code order, keeping the best candidate.
+ * Costs 2^k steps, so callers only pick this when k is small.
+ */
+function searchNullSpace(reduced: Reduced, buttonCount: number): number[] {
+  const { particular, basis } = reduced;
+  const cur = Uint32Array.from(particular);
+  const best = Uint32Array.from(particular);
+  let bestCount = popcountBits(cur);
+
+  const combos = 2 ** basis.length;
+  for (let i = 1; i < combos; i++) {
+    xorInto(cur, basis[ctz32(i)]);
+    const count = popcountBits(cur);
+    if (count < bestCount || (count === bestCount && lexLessBits(cur, best))) {
+      bestCount = count;
+      best.set(cur);
+    }
+  }
+  return bitsToIndices(best, buttonCount);
+}
+
+/**
+ * Map key for a light mask. Numbers are used when the mask provably fits in a
+ * double's exact integer range; wider masks fall back to a string key. The two
+ * key spaces never collide because Map treats numbers and strings distinctly.
+ */
+function maskKey(mask: Uint32Array): number | string {
+  if (mask.length === 1) return mask[0] >>> 0;
+  if (mask.length === 2 && mask[1] >>> 0 < 0x200000) {
+    return (mask[1] >>> 0) * 4294967296 + (mask[0] >>> 0);
+  }
+  let key = '';
+  for (let i = 0; i < mask.length; i++) key += (mask[i] >>> 0).toString(36) + '.';
+  return key;
+}
+
+/**
+ * Meet in the middle: split the buttons into two halves, tabulate the best
+ * subset of the second half for every light mask it can produce, then scan the
+ * first half looking for the complement. Costs 2^ceil(M/2) instead of 2^M.
+ */
+function searchMeetInMiddle(n: Normalized): number[] | null {
+  const { buttonCount: m, lightCount, buttonLights, target } = n;
+  const lightWords = wordsFor(lightCount);
+
+  const buttonMasks: Uint32Array[] = [];
+  for (let button = 0; button < m; button++) {
+    const mask = new Uint32Array(lightWords);
+    for (const light of buttonLights[button]) setBit(mask, light);
+    buttonMasks.push(mask);
+  }
+  const targetMask = new Uint32Array(lightWords);
+  for (let light = 0; light < lightCount; light++) {
+    if (target[light]) setBit(targetMask, light);
+  }
+
+  const lowCount = m >>> 1;
+  const highCount = m - lowCount;
+  const scale = 2 ** highCount; // packs (count, subset) into one exact double
+
+  // Second half: for every reachable mask keep the cheapest subset, breaking
+  // ties toward the lexicographically smaller index list.
+  const table = new Map<number | string, number>();
+  const highMask = new Uint32Array(lightWords);
+  let highBits = 0;
+  const remember = (): void => {
+    const key = maskKey(highMask);
+    const count = popcount32(highBits);
+    const prev = table.get(key);
+    if (prev === undefined) {
+      table.set(key, count * scale + highBits);
+      return;
+    }
+    const prevCount = Math.floor(prev / scale);
+    const prevBits = prev - prevCount * scale;
+    if (count < prevCount || (count === prevCount && lexLessWord(highBits, prevBits))) {
+      table.set(key, count * scale + highBits);
+    }
+  };
+  remember();
+  const highCombos = 2 ** highCount;
+  for (let i = 1; i < highCombos; i++) {
+    const bit = ctz32(i);
+    xorInto(highMask, buttonMasks[lowCount + bit]);
+    highBits ^= 1 << bit;
+    remember();
+  }
+
+  // First half: look up the mask that completes the target.
+  const lowMask = new Uint32Array(lightWords);
+  const needed = new Uint32Array(lightWords);
+  let lowBits = 0;
+  let found = false;
+  let bestCount = 0;
+  let bestLow = 0;
+  let bestHigh = 0;
+  const lowCombos = 2 ** lowCount;
+  for (let i = 0; i < lowCombos; i++) {
+    if (i > 0) {
+      const bit = ctz32(i);
+      xorInto(lowMask, buttonMasks[bit]);
+      lowBits ^= 1 << bit;
+    }
+    for (let w = 0; w < lightWords; w++) needed[w] = lowMask[w] ^ targetMask[w];
+    const packed = table.get(maskKey(needed));
+    if (packed === undefined) continue;
+    const highSubsetCount = Math.floor(packed / scale);
+    const highSubset = packed - highSubsetCount * scale;
+    const count = popcount32(lowBits) + highSubsetCount;
+    const better =
+      !found ||
+      count < bestCount ||
+      (count === bestCount &&
+        (lowBits !== bestLow
+          ? lexLessWord(lowBits, bestLow)
+          : lexLessWord(highSubset, bestHigh)));
+    if (better) {
+      found = true;
+      bestCount = count;
+      bestLow = lowBits;
+      bestHigh = highSubset;
+    }
+  }
+  if (!found) return null;
+
+  const result: number[] = [];
+  for (let i = 0; i < lowCount; i++) if ((bestLow >>> i) & 1) result.push(i);
+  for (let i = 0; i < highCount; i++) if ((bestHigh >>> i) & 1) result.push(lowCount + i);
+  return result;
+}
+
+/**
+ * Find the smallest set of buttons whose combined toggles produce the target
+ * light configuration, or `null` if no set does.
+ *
+ * Order of presses is irrelevant and pressing a button twice cancels out, so
+ * this is a minimum-weight solution of a linear system over GF(2). Elimination
+ * gives the full solution space; if it is small we enumerate it directly,
+ * otherwise we meet in the middle over the buttons.
+ */
+export function solveToggle(machine: Machine): number[] | null {
+  const n = normalize(machine);
+  const reduced = reduce(n);
+  if (reduced === null) return null;
+
+  const free = reduced.basis.length;
+  const halfExponent = n.buttonCount >>> 1;
+  if (free <= Math.max(20, halfExponent)) {
+    return searchNullSpace(reduced, n.buttonCount);
+  }
+  return searchMeetInMiddle(n);
+}
