@@ -0,0 +1,325 @@
+import { describe, expect, it } from 'vitest';
+import { solveCounter } from '../src/index.js';
+
+/** Apply press counts and report the resulting counter values. */
+function applyPresses(
+  counterCount: number,
+  buttons: number[][],
+  presses: number[],
+  modulus: number,
+): number[] {
+  const counters = new Array<number>(counterCount).fill(0);
+  for (let b = 0; b < buttons.length; b++) {
+    for (const counter of buttons[b]) {
+      counters[counter] = (counters[counter] + presses[b]) % modulus;
+    }
+  }
+  return counters;
+}
+
+/** Reference solver: try every press vector. Only for tiny instances. */
+function bruteForce(lights: number[], buttons: number[][], modulus: number): number[] | null {
+  const m = buttons.length;
+  const presses = new Array<number>(m).fill(0);
+  let best: number[] | null = null;
+  const total = modulus ** m;
+  for (let code = 0; code < total; code++) {
+    let rest = code;
+    for (let i = 0; i < m; i++) {
+      presses[i] = rest % modulus;
+      rest = Math.floor(rest / modulus);
+    }
+    const result = applyPresses(lights.length, buttons, presses, modulus);
+    if (!result.every((v, i) => v === lights[i])) continue;
+    if (best === null) {
+      best = [...presses];
+      continue;
+    }
+    const sum = presses.reduce((a, b) => a + b, 0);
+    const bestSum = best.reduce((a, b) => a + b, 0);
+    if (sum < bestSum) {
+      best = [...presses];
+    } else if (sum === bestSum) {
+      for (let i = 0; i < m; i++) {
+        if (presses[i] !== best[i]) {
+          if (presses[i] < best[i]) best = [...presses];
+          break;
+        }
+      }
+    }
+  }
+  return best;
+}
+
+/**
+ * Exact minimum number of presses, found by breadth-first search over counter
+ * states (each press is one unit-cost edge). Feasible whenever p^N is small,
+ * independently of how many buttons there are.
+ */
+function minPressesByBfs(lights: number[], buttons: number[][], modulus: number): number | null {
+  const n = lights.length;
+  const encode = (state: number[]): number => {
+    let code = 0;
+    for (let i = n - 1; i >= 0; i--) code = code * modulus + state[i];
+    return code;
+  };
+  const total = modulus ** n;
+  const dist = new Int32Array(total).fill(-1);
+  const start = encode(new Array<number>(n).fill(0));
+  const goal = encode(lights);
+  dist[start] = 0;
+  let frontier = [start];
+  while (frontier.length > 0) {
+    const next: number[] = [];
+    for (const code of frontier) {
+      if (code === goal) return dist[code];
+      const state: number[] = [];
+      let rest = code;
+      for (let i = 0; i < n; i++) {
+        state.push(rest % modulus);
+        rest = Math.floor(rest / modulus);
+      }
+      for (const button of buttons) {
+        const moved = [...state];
+        for (const counter of button) moved[counter] = (moved[counter] + 1) % modulus;
+        const encoded = encode(moved);
+        if (dist[encoded] !== -1) continue;
+        dist[encoded] = dist[code] + 1;
+        next.push(encoded);
+      }
+    }
+    frontier = next;
+  }
+  return dist[goal] === -1 ? null : dist[goal];
+}
+
+function makeRandom(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state / 4294967296;
+  };
+}
+
+describe('solveCounter', () => {
+  it('returns all zeros when the target is already met', () => {
+    expect(solveCounter([0, 0], [[0], [1]], 5)).toEqual([0, 0]);
+  });
+
+  it('solves a single counter', () => {
+    expect(solveCounter([3], [[0]], 5)).toEqual([3]);
+  });
+
+  it('wraps around when that is cheaper', () => {
+    // Reaching 4 mod 5 on both counters costs 4 presses of button 2 rather than
+    // 4 + 4 presses of the single-counter buttons.
+    expect(solveCounter([4, 4], [[0], [1], [0, 1]], 5)).toEqual([0, 0, 4]);
+  });
+
+  it('returns null when the target is unreachable', () => {
+    expect(solveCounter([1, 2], [[0, 1]], 5)).toBeNull();
+  });
+
+  it('returns null when a counter cannot be touched', () => {
+    expect(solveCounter([0, 1], [[0]], 7)).toBeNull();
+  });
+
+  it('breaks ties toward the lexicographically smallest press vector', () => {
+    // Buttons 0 and 1 are interchangeable, so [0,3] beats [3,0] and [1,2].
+    expect(solveCounter([3], [[0], [0]], 5)).toEqual([0, 3]);
+  });
+
+  it('ignores duplicate counter indices inside one button', () => {
+    expect(solveCounter([2], [[0, 0]], 7)).toEqual([2]);
+  });
+
+  it('requires counters beyond the target array to end at zero', () => {
+    expect(solveCounter([1], [[0, 3]], 5)).toBeNull();
+  });
+
+  it('handles an empty button list', () => {
+    expect(solveCounter([0, 0], [], 7)).toEqual([]);
+    expect(solveCounter([1], [], 7)).toBeNull();
+  });
+
+  it('works with modulus 2 like a toggle puzzle', () => {
+    expect(solveCounter([1, 1, 0], [[0, 1], [1, 2], [2]], 2)).toEqual([1, 0, 0]);
+  });
+
+  it('agrees with brute force on random small systems', () => {
+    const random = makeRandom(4242);
+    const moduli = [2, 3, 5, 7];
+    for (let trial = 0; trial < 300; trial++) {
+      const modulus = moduli[Math.floor(random() * moduli.length)];
+      const counters = 1 + Math.floor(random() * 3);
+      const buttonCount = 1 + Math.floor(random() * 4);
+      const buttons: number[][] = [];
+      for (let b = 0; b < buttonCount; b++) {
+        const set = new Set<number>();
+        for (let c = 0; c < counters; c++) if (random() < 0.5) set.add(c);
+        buttons.push([...set]);
+      }
+      const lights: number[] = [];
+      for (let c = 0; c < counters; c++) lights.push(Math.floor(random() * modulus));
+
+      const label = JSON.stringify({ lights, buttons, modulus });
+      const actual = solveCounter(lights, buttons, modulus);
+      expect(actual, label).toEqual(bruteForce(lights, buttons, modulus));
+      if (actual !== null) {
+        expect(applyPresses(counters, buttons, actual, modulus), label).toEqual(lights);
+      }
+    }
+  });
+
+  it('agrees with brute force when the branch-and-bound path is forced', () => {
+    // Many duplicated buttons and a large modulus push p^k past the
+    // enumeration limit, so this exercises the search fallback.
+    const random = makeRandom(77);
+    for (let trial = 0; trial < 40; trial++) {
+      const modulus = 97;
+      const buttons: number[][] = [];
+      const pool: number[][] = [[0], [1], [0, 1]];
+      for (let b = 0; b < 6; b++) buttons.push([...pool[Math.floor(random() * pool.length)]]);
+      const lights = [Math.floor(random() * modulus), Math.floor(random() * modulus)];
+      const label = JSON.stringify({ lights, buttons, modulus });
+      const actual = solveCounter(lights, buttons, modulus);
+      const expectedSum = minPressesByBfs(lights, buttons, modulus);
+      if (expectedSum === null) {
+        expect(actual, label).toBeNull();
+        continue;
+      }
+      expect(actual, label).not.toBeNull();
+      expect(applyPresses(2, buttons, actual as number[], modulus), label).toEqual(lights);
+      const bestSum = (actual as number[]).reduce((a, b) => a + b, 0);
+      expect(bestSum, label).toBe(expectedSum);
+      for (const presses of actual as number[]) {
+        expect(presses, label).toBeGreaterThanOrEqual(0);
+        expect(presses, label).toBeLessThan(modulus);
+      }
+    }
+  });
+
+  it('solves a 40x40 mod 97 system quickly', () => {
+    const size = 40;
+    const modulus = 97;
+    const random = makeRandom(31337);
+    const buttons: number[][] = [];
+    for (let b = 0; b < size; b++) {
+      const set = new Set<number>([b]);
+      for (let c = 0; c < size; c++) if (random() < 0.25) set.add(c);
+      buttons.push([...set].sort((a, b2) => a - b2));
+    }
+    const presses: number[] = [];
+    for (let b = 0; b < size; b++) presses.push(Math.floor(random() * modulus));
+    const lights = applyPresses(size, buttons, presses, modulus);
+
+    const started = Date.now();
+    const solution = solveCounter(lights, buttons, modulus);
+    expect(Date.now() - started).toBeLessThan(5000);
+    expect(solution).not.toBeNull();
