+import { describe, expect, it } from 'vitest';
+import { solveToggle } from '../src/index.js';
+import type { Machine } from '../src/index.js';
+
+/** Apply a set of button presses and report the resulting light states. */
+function applyToggle(machine: Machine, presses: number[]): boolean[] {
+  const lights = machine.target.map(() => false);
+  for (const button of presses) {
+    for (const light of machine.buttons[button]) {
+      lights[light] = !lights[light];
+    }
+  }
+  return lights;
+}
+
+/** Reference solver: enumerate every subset. Only usable for tiny machines. */
+function bruteForceToggle(machine: Machine): number[] | null {
+  const m = machine.buttons.length;
+  let best: number[] | null = null;
+  for (let mask = 0; mask < 1 << m; mask++) {
+    const presses: number[] = [];
+    for (let i = 0; i < m; i++) if (mask & (1 << i)) presses.push(i);
+    const result = applyToggle(machine, presses);
+    if (!result.every((v, i) => v === machine.target[i])) continue;
+    if (best === null || isSmaller(presses, best)) best = presses;
+  }
+  return best;
+}
+
+function isSmaller(a: number[], b: number[]): boolean {
+  if (a.length !== b.length) return a.length < b.length;
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] !== b[i]) return a[i] < b[i];
+  }
+  return false;
+}
+
+/** Deterministic PRNG so failures are reproducible. */
+function makeRandom(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state / 4294967296;
+  };
+}
+
+describe('solveToggle', () => {
+  it('returns an empty set when every light is already off', () => {
+    expect(solveToggle({ target: [false, false], buttons: [[0], [1]] })).toEqual([]);
+  });
+
+  it('handles a machine with no buttons', () => {
+    expect(solveToggle({ target: [], buttons: [] })).toEqual([]);
+    expect(solveToggle({ target: [false], buttons: [] })).toEqual([]);
+    expect(solveToggle({ target: [true], buttons: [] })).toBeNull();
+  });
+
+  it('rejects the unsolvable example from the specification', () => {
+    const machine: Machine = {
+      target: [true, true, false, true],
+      buttons: [
+        [0, 1],
+        [1, 2, 3],
+        [0, 3],
+      ],
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it('finds the single required button', () => {
+    const machine: Machine = {
+      target: [true, true, false, false],
+      buttons: [[0], [0, 1], [2, 3]],
+    };
+    expect(solveToggle(machine)).toEqual([1]);
+  });
+
+  it('prefers fewer presses over more', () => {
+    const machine: Machine = {
+      target: [true, true, true],
+      buttons: [[0], [1], [2], [0, 1, 2]],
+    };
+    expect(solveToggle(machine)).toEqual([3]);
+  });
+
+  it('breaks ties towards the lexicographically smallest index set', () => {
+    // Buttons 0 and 3 are identical, as are buttons 1 and 2.
+    const machine: Machine = {
+      target: [true, false, true],
+      buttons: [[0], [2], [2], [0]],
+    };
+    expect(solveToggle(machine)).toEqual([0, 1]);
+  });
+
+  it('ignores a light toggled twice by the same button', () => {
+    const machine: Machine = {
+      target: [false, true],
+      buttons: [[0, 0, 1]],
+    };
+    expect(solveToggle(machine)).toEqual([0]);
+  });
+
+  it('matches brute force on random small machines', () => {
+    const random = makeRandom(20260725);
+    for (let trial = 0; trial < 400; trial++) {
+      const lights = 1 + Math.floor(random() * 6);
+      const buttonCount = 1 + Math.floor(random() * 9);
+      const buttons: number[][] = [];
+      for (let b = 0; b < buttonCount; b++) {
+        const wired: number[] = [];
+        for (let l = 0; l < lights; l++) if (random() < 0.5) wired.push(l);
+        buttons.push(wired);
+      }
+      const target: boolean[] = [];
+      for (let l = 0; l < lights; l++) target.push(random() < 0.5);
