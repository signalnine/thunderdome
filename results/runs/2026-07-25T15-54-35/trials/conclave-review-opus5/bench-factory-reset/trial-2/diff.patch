+import { solveModular } from './modular.js';
+import { solveToggle } from './toggle.js';
+import type { Machine } from './types.js';
+
+export type { Machine };
+export { solveToggle };
+
+/**
+ * Counter variant of the toggle puzzle: buttons increment counters that wrap at
+ * `modulus`, and each button may be pressed 0..modulus-1 times.
+ *
+ * Counter indices outside the target array are ignored, and a counter listed
+ * twice by one button is incremented twice per press.
+ *
+ * @param lights   target value of each counter (each counter starts at 0)
+ * @param buttons  `buttons[i]` lists the counter indices button `i` increments
+ * @param modulus  prime modulus the counters wrap at
+ * @returns press counts per button, minimising the total number of presses
+ *          (ties broken lexicographically), or `null` when unsolvable
+ * @throws if `modulus` is not a prime integer
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  return solveModular(lights ?? [], buttons ?? [], modulus);
+}
+
+export default { solveToggle, solveCounter };
diff --git a/src/modular.ts b/src/modular.ts
