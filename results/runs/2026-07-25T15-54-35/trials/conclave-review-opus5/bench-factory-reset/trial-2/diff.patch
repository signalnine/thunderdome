+/**
+ * Helpers for 64-bit vectors stored as a pair of 32-bit words (`lo`, `hi`).
+ *
+ * The solvers work with up to 64 buttons / 64 equations, which does not fit in
+ * a single JavaScript bitwise integer, so vectors are kept as two Int32 words.
+ */
+
+/** Number of set bits in a 32-bit word. */
+export function popcount32(x: number): number {
+  let v = x - ((x >> 1) & 0x55555555);
+  v = (v & 0x33333333) + ((v >> 2) & 0x33333333);
+  v = (v + (v >> 4)) & 0x0f0f0f0f;
+  return (Math.imul(v, 0x01010101) >> 24) & 0x3f;
+}
+
+/** Number of set bits across a (lo, hi) word pair. */
+export function popcount64(lo: number, hi: number): number {
+  return popcount32(lo) + popcount32(hi);
+}
+
+/** Test bit `index` (0..63) of a (lo, hi) word pair. */
+export function testBit(lo: number, hi: number, index: number): boolean {
+  return index < 32
+    ? (lo & (1 << index)) !== 0
+    : (hi & (1 << (index - 32))) !== 0;
+}
+
+/** Index of the lowest set bit of a non-zero 32-bit word. */
+export function lowestBitIndex32(x: number): number {
+  return 31 - Math.clz32(x & -x);
+}
