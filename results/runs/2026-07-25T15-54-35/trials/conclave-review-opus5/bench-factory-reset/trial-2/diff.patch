@@ -0,0 +1,10 @@
+/**
+ * A machine with N lights (all initially off) and M buttons.
+ * Pressing a button toggles every light it is wired to.
+ */
+export interface Machine {
+  /** Desired state for each light. Lights are indexed by position. */
+  target: boolean[];
+  /** `buttons[i]` lists the light indices toggled by button `i`. */
+  buttons: number[][];
+}
diff --git a/tests/counter.test.ts b/tests/counter.test.ts
new file mode 100644
index 0000000..b0556d4
--- /dev/null
+++ b/tests/counter.test.ts
@@ -0,0 +1,355 @@
+import { describe, expect, it } from 'vitest';
+import { solveCounter } from '../src/index.js';
+
+/** Apply press counts and report the resulting counter values. */
+function applyPresses(
+  counterCount: number,
+  buttons: number[][],
+  presses: number[],
+  modulus: number,
+): number[] {
+  const counters = new Array<number>(counterCount).fill(0);
+  for (let b = 0; b < buttons.length; b++) {
+    for (const c of buttons[b]) counters[c] = (counters[c] + presses[b]) % modulus;
+  }
+  return counters;
+}
+
+/** Reference solver: enumerate every press vector. Only usable for tiny inputs. */
+function bruteForceCounter(
+  target: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const m = buttons.length;
+  const presses = new Array<number>(m).fill(0);
+  let best: number[] | null = null;
+
+  const visit = (index: number): void => {
+    if (index === m) {
+      const result = applyPresses(target.length, buttons, presses, modulus);
+      if (!result.every((v, i) => v === target[i])) return;
+      if (best === null || isSmaller(presses, best)) best = presses.slice();
+      return;
+    }
+    for (let v = 0; v < modulus; v++) {
+      presses[index] = v;
+      visit(index + 1);
+    }
+    presses[index] = 0;
+  };
+  visit(0);
+  return best;
+}
+
+/**
+ * Independent exact reference: eliminate with pivots in the *lowest* columns
+ * (the opposite convention to the implementation), then enumerate every
+ * assignment of the free variables. Returns undefined when the coset is larger
+ * than `budget`, so callers can skip instances it cannot handle.
+ */
+function exactCounter(
+  target: number[],
+  buttons: number[][],
+  p: number,
+  budget: number,
+): number[] | null | undefined {
+  const n = target.length;
+  const m = buttons.length;
+  const a: number[][] = Array.from({ length: n }, () => new Array<number>(m).fill(0));
+  const b = target.map((v) => ((v % p) + p) % p);
+  for (let j = 0; j < m; j++) for (const c of buttons[j]) a[c][j] = (a[c][j] + 1) % p;
+
+  const inverse = (v: number): number => {
+    for (let i = 1; i < p; i++) if ((v * i) % p === 1) return i;
+    throw new Error('not invertible');
+  };
+  const pivotCol: number[] = [];
+  let rank = 0;
+  for (let col = 0; col < m && rank < n; col++) {
+    let pivot = -1;
+    for (let row = rank; row < n; row++) if (a[row][col]) { pivot = row; break; }
+    if (pivot < 0) continue;
+    [a[pivot], a[rank]] = [a[rank], a[pivot]];
+    [b[pivot], b[rank]] = [b[rank], b[pivot]];
+    const inv = inverse(a[rank][col]);
+    for (let j = 0; j < m; j++) a[rank][j] = (a[rank][j] * inv) % p;
+    b[rank] = (b[rank] * inv) % p;
+    for (let row = 0; row < n; row++) {
+      if (row === rank || !a[row][col]) continue;
+      const f = a[row][col];
+      for (let j = 0; j < m; j++) a[row][j] = ((a[row][j] - f * a[rank][j]) % p + p) % p;
+      b[row] = ((b[row] - f * b[rank]) % p + p) % p;
+    }
+    pivotCol.push(col);
+    rank++;
+  }
+  for (let row = rank; row < n; row++) if (b[row]) return null;
+
+  const isPivot = new Array<boolean>(m).fill(false);
+  for (const col of pivotCol) isPivot[col] = true;
+  const free: number[] = [];
+  for (let col = 0; col < m; col++) if (!isPivot[col]) free.push(col);
+  if (p ** free.length > budget) return undefined;
+
+  const x = new Array<number>(m).fill(0);
+  const assignment = new Array<number>(free.length).fill(0);
+  let best: number[] | null = null;
+  const visit = (index: number): void => {
+    if (index === free.length) {
+      for (let k = 0; k < free.length; k++) x[free[k]] = assignment[k];
+      for (let e = 0; e < rank; e++) {
+        let v = b[e];
+        for (let k = 0; k < free.length; k++) {
+          v = ((v - a[e][free[k]] * assignment[k]) % p + p) % p;
+        }
+        x[pivotCol[e]] = v;
+      }
+      if (best === null || isSmaller(x, best)) best = x.slice();
+      return;
+    }
+    for (let v = 0; v < p; v++) {
+      assignment[index] = v;
+      visit(index + 1);
+    }
+    assignment[index] = 0;
+  };
+  visit(0);
+  return best;
+}
+
+function isSmaller(a: number[], b: number[]): boolean {
+  const sumA = a.reduce((x, y) => x + y, 0);
+  const sumB = b.reduce((x, y) => x + y, 0);
+  if (sumA !== sumB) return sumA < sumB;
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] !== b[i]) return a[i] < b[i];
+  }
+  return false;
+}
+
+function makeRandom(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
+    return state / 4294967296;
+  };
+}
+
+describe('solveCounter', () => {
+  it('returns all zeros when every counter is already at its target', () => {
+    expect(solveCounter([0, 0, 0], [[0], [1, 2]], 5)).toEqual([0, 0]);
+  });
+
+  it('handles a system with no buttons', () => {
+    expect(solveCounter([0, 0], [], 7)).toEqual([]);
+    expect(solveCounter([1, 0], [], 7)).toBeNull();
+  });
+
+  it('solves a simple independent system', () => {
+    expect(solveCounter([3, 4], [[0], [1]], 5)).toEqual([3, 4]);
+  });
+
+  it('uses wrap-around when it needs fewer presses', () => {
