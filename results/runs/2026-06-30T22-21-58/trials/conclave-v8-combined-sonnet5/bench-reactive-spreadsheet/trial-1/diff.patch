diff --git a/src/cellRef.ts b/src/cellRef.ts
new file mode 100644
index 0000000..ea14b52
--- /dev/null
+++ b/src/cellRef.ts
@@ -0,0 +1,64 @@
+const CELL_REF_PATTERN = /^([A-Za-z]+)([0-9]+)$/;
+
+export interface ParsedRef {
+  col: number;
+  row: number;
+}
+
+export function colToIndex(letters: string): number {
+  let index = 0;
+  const upper = letters.toUpperCase();
+  for (let i = 0; i < upper.length; i++) {
+    index = index * 26 + (upper.charCodeAt(i) - 64);
+  }
+  return index;
+}
+
+export function indexToCol(n: number): string {
+  let result = '';
+  let value = n;
+  while (value > 0) {
+    const remainder = (value - 1) % 26;
+    result = String.fromCharCode(65 + remainder) + result;
+    value = Math.floor((value - 1) / 26);
+  }
+  return result;
+}
+
+export function parseCellRef(ref: string): ParsedRef {
+  const match = CELL_REF_PATTERN.exec(ref);
+  if (!match) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  const row = parseInt(match[2], 10);
+  if (row < 1) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  return { col: colToIndex(match[1]), row };
+}
+
+export function normalizeCellRef(ref: string): string {
+  const { col, row } = parseCellRef(ref);
+  return `${indexToCol(col)}${row}`;
+}
+
+export function isCellRef(token: string): boolean {
+  return CELL_REF_PATTERN.test(token);
+}
+
+export function expandRange(start: string, end: string): string[] {
+  const a = parseCellRef(start);
+  const b = parseCellRef(end);
+  const minCol = Math.min(a.col, b.col);
+  const maxCol = Math.max(a.col, b.col);
+  const minRow = Math.min(a.row, b.row);
+  const maxRow = Math.max(a.row, b.row);
+
+  const refs: string[] = [];
+  for (let row = minRow; row <= maxRow; row++) {
+    for (let col = minCol; col <= maxCol; col++) {
+      refs.push(`${indexToCol(col)}${row}`);
+    }
+  }
+  return refs;
+}
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..43a015b
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,191 @@
+import { AstNode, CellValue } from './types.js';
+import { expandRange } from './cellRef.js';
+
+export interface EvalContext {
+  getCellValue(ref: string): CellValue | null;
+}
+
+const NUMERIC_FUNCTIONS = new Set(['SUM', 'AVERAGE', 'MIN', 'MAX', 'COUNT']);
+
+export function evaluate(node: AstNode, ctx: EvalContext): CellValue | null {
+  switch (node.type) {
+    case 'Number':
+      return node.value;
+    case 'String':
+      return node.value;
+    case 'Boolean':
+      return node.value;
+    case 'CellRef':
+      return ctx.getCellValue(node.ref);
+    case 'Range':
+      throw new Error('A range cannot be used outside of a function');
+    case 'UnaryOp': {
+      const operand = toNumber(evaluate(node.operand, ctx));
+      return node.op === '-' ? -operand : operand;
+    }
+    case 'BinaryOp':
+      return evaluateBinary(node.op, evaluate(node.left, ctx), evaluate(node.right, ctx));
+    case 'FuncCall':
+      return evaluateFuncCall(node, ctx);
+    default:
+      throw new Error('Unknown formula node');
+  }
+}
+
+function evaluateBinary(op: string, left: CellValue | null, right: CellValue | null): CellValue {
+  switch (op) {
+    case '+':
+      return toNumber(left) + toNumber(right);
+    case '-':
+      return toNumber(left) - toNumber(right);
+    case '*':
+      return toNumber(left) * toNumber(right);
+    case '/': {
+      const divisor = toNumber(right);
+      if (divisor === 0) {
+        throw new Error('Division by zero');
+      }
+      return toNumber(left) / divisor;
+    }
+    case '>':
+    case '<':
+    case '>=':
+    case '<=':
+      return compareOrdered(op, left, right);
+    case '=':
+      return looseEqual(left, right);
+    case '<>':
+      return !looseEqual(left, right);
+    default:
+      throw new Error(`Unknown operator '${op}'`);
+  }
+}
+
+function compareOrdered(op: string, left: CellValue | null, right: CellValue | null): boolean {
+  let l: number | string;
+  let r: number | string;
+  if (typeof left === 'string' && typeof right === 'string') {
+    l = left;
+    r = right;
+  } else {
+    l = toNumber(left);
+    r = toNumber(right);
+  }
+  switch (op) {
+    case '>':
+      return l > r;
+    case '<':
+      return l < r;
+    case '>=':
+      return l >= r;
+    case '<=':
+      return l <= r;
+    default:
+      throw new Error(`Unknown comparison operator '${op}'`);
+  }
+}
+
+function looseEqual(left: CellValue | null, right: CellValue | null): boolean {
+  if (left === null || right === null) {
+    return left === right;
+  }
+  if (typeof left === typeof right) {
+    return left === right;
+  }
+  return toNumber(left) === toNumber(right);
+}
+
+function toNumber(value: CellValue | null): number {
+  if (value === null) return 0;
+  if (typeof value === 'number') return value;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+  const parsed = parseFloat(value);
+  if (Number.isNaN(parsed)) {
+    throw new Error(`Cannot convert '${value}' to a number`);
+  }
+  return parsed;
+}
+
+function evaluateFuncCall(node: Extract<AstNode, { type: 'FuncCall' }>, ctx: EvalContext): CellValue | null {
+  const { name, args } = node;
+
+  if (name === 'IF') {
+    if (args.length !== 3) {
+      throw new Error('IF requires exactly 3 arguments');
+    }
+    const condition = evaluate(args[0], ctx);
+    return condition ? evaluate(args[1], ctx) : evaluate(args[2], ctx);
+  }
+
+  if (NUMERIC_FUNCTIONS.has(name)) {
+    const values: number[] = [];
+    for (const arg of args) {
+      collectNumericValues(arg, ctx, values);
+    }
+    switch (name) {
+      case 'SUM':
+        return values.reduce((a, b) => a + b, 0);
+      case 'AVERAGE':
+        if (values.length === 0) throw new Error('AVERAGE requires at least one numeric value');
+        return values.reduce((a, b) => a + b, 0) / values.length;
+      case 'MIN':
+        if (values.length === 0) throw new Error('MIN requires at least one numeric value');
+        return Math.min(...values);
+      case 'MAX':
+        if (values.length === 0) throw new Error('MAX requires at least one numeric value');
+        return Math.max(...values);
+      case 'COUNT':
+        return values.length;
+      default:
+        throw new Error(`Unknown function '${name}'`);
+    }
+  }
+
+  throw new Error(`Unknown function '${name}'`);
+}
+
+function collectNumericValues(node: AstNode, ctx: EvalContext, out: number[]): void {
+  if (node.type === 'Range') {
+    for (const ref of expandRange(node.start, node.end)) {
+      const value = ctx.getCellValue(ref);
+      if (typeof value === 'number') out.push(value);
+    }
+    return;
+  }
+  if (node.type === 'CellRef') {
+    const value = ctx.getCellValue(node.ref);
+    if (typeof value === 'number') out.push(value);
+    return;
+  }
+  const value = evaluate(node, ctx);
+  if (typeof value === 'number') out.push(value);
+}
+
+export function collectDependencies(node: AstNode): Set<string> {
+  const refs = new Set<string>();
+  visit(node);
+  return refs;
+
+  function visit(n: AstNode): void {
+    switch (n.type) {
+      case 'CellRef':
+        refs.add(n.ref);
+        break;
+      case 'Range':
+        for (const ref of expandRange(n.start, n.end)) refs.add(ref);
+        break;
+      case 'BinaryOp':
+        visit(n.left);
+        visit(n.right);
+        break;
+      case 'UnaryOp':
+        visit(n.operand);
+        break;
+      case 'FuncCall':
+        n.args.forEach(visit);
+        break;
+      default:
+        break;
+    }
+  }
+}
