--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,149 @@
+import { CellData, CellValue } from './types.js';
+import { normalizeCellRef } from './cellRef.js';
+import { parseFormula } from './parser.js';
+import { collectDependencies, evaluate } from './evaluator.js';
+
+export class Spreadsheet {
+  private cells = new Map<string, CellData>();
+
+  set(cell: string, value: string | number | boolean): void {
+    const ref = normalizeCellRef(cell);
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      const formula = parseFormula(value.slice(1));
+      const dependencies = collectDependencies(formula);
+
+      if (this.wouldCreateCycle(ref, dependencies)) {
+        throw new Error(`Circular reference detected involving ${ref}`);
+      }
+
+      this.setDependencies(ref, dependencies);
+      const data = this.getOrCreateCell(ref);
+      data.formula = formula;
+      data.isSet = true;
+      this.computeCellValue(ref);
+    } else {
+      this.setDependencies(ref, new Set());
+      const data = this.getOrCreateCell(ref);
+      data.formula = null;
+      data.value = value;
+      data.isSet = true;
+    }
+
+    this.recomputeDependents(ref);
+  }
+
+  get(cell: string): CellValue | null {
+    const ref = normalizeCellRef(cell);
+    const data = this.cells.get(ref);
+    if (!data || !data.isSet) return null;
+    return data.value;
+  }
+
+  getDisplay(cell: string): string {
+    const value = this.get(cell);
+    if (value === null) return '';
+    return String(value);
+  }
+
+  getCells(): Map<string, CellValue | null> {
+    const result = new Map<string, CellValue | null>();
+    for (const [ref, data] of this.cells) {
+      if (data.isSet) {
+        result.set(ref, data.value);
+      }
+    }
+    return result;
+  }
+
+  private getOrCreateCell(ref: string): CellData {
+    let data = this.cells.get(ref);
+    if (!data) {
+      data = { formula: null, dependencies: new Set(), dependents: new Set(), value: null, isSet: false };
+      this.cells.set(ref, data);
+    }
+    return data;
+  }
+
+  private setDependencies(ref: string, newDeps: Set<string>): void {
+    const data = this.getOrCreateCell(ref);
+    for (const oldDep of data.dependencies) {
+      if (!newDeps.has(oldDep)) {
+        this.cells.get(oldDep)?.dependents.delete(ref);
+      }
+    }
+    for (const newDep of newDeps) {
+      this.getOrCreateCell(newDep).dependents.add(ref);
+    }
+    data.dependencies = newDeps;
+  }
+
+  private wouldCreateCycle(ref: string, newDeps: Set<string>): boolean {
+    const visited = new Set<string>();
+    const stack = [...newDeps];
+    while (stack.length > 0) {
+      const current = stack.pop() as string;
+      if (current === ref) return true;
+      if (visited.has(current)) continue;
+      visited.add(current);
+      const deps = this.cells.get(current)?.dependencies;
+      if (deps) {
+        for (const d of deps) stack.push(d);
+      }
+    }
+    return false;
+  }
+
+  private computeCellValue(ref: string): void {
+    const data = this.cells.get(ref);
+    if (!data || !data.formula) return;
+    data.value = evaluate(data.formula, {
+      getCellValue: (cellRef: string) => this.get(cellRef),
+    });
+  }
+
+  private recomputeDependents(startRef: string): void {
+    const affected = new Set<string>();
+    const queue = [startRef];
+    while (queue.length > 0) {
+      const current = queue.shift() as string;
+      const dependents = this.cells.get(current)?.dependents ?? new Set<string>();
+      for (const dependent of dependents) {
+        if (!affected.has(dependent)) {
+          affected.add(dependent);
+          queue.push(dependent);
+        }
+      }
+    }
+
+    if (affected.size === 0) return;
+
+    const inDegree = new Map<string, number>();
+    for (const ref of affected) {
+      const deps = this.cells.get(ref)?.dependencies ?? new Set<string>();
+      let count = 0;
+      for (const d of deps) {
+        if (affected.has(d)) count++;
+      }
+      inDegree.set(ref, count);
+    }
+
+    const ready: string[] = [...affected].filter((ref) => inDegree.get(ref) === 0);
+    const order: string[] = [];
+    while (ready.length > 0) {
+      const ref = ready.shift() as string;
+      order.push(ref);
+      const dependents = this.cells.get(ref)?.dependents ?? new Set<string>();
+      for (const dependent of dependents) {
+        if (!affected.has(dependent)) continue;
+        const newDegree = (inDegree.get(dependent) ?? 0) - 1;
+        inDegree.set(dependent, newDegree);
+        if (newDegree === 0) ready.push(dependent);
+      }
+    }
+
+    for (const ref of order) {
+      this.computeCellValue(ref);
+    }
+  }
+}
