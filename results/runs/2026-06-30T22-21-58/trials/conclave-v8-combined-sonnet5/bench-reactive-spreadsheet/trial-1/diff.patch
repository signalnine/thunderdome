+++ b/src/parser.ts
@@ -0,0 +1,248 @@
+import { AstNode } from './types.js';
+import { isCellRef, normalizeCellRef } from './cellRef.js';
+
+type TokenType = 'NUMBER' | 'STRING' | 'IDENT' | 'OP' | 'COMPARE' | 'LPAREN' | 'RPAREN' | 'COMMA' | 'COLON' | 'EOF';
+
+interface Token {
+  type: TokenType;
+  value: string;
+}
+
+function tokenize(expr: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+  while (i < expr.length) {
+    const c = expr[i];
+
+    if (/\s/.test(c)) {
+      i++;
+      continue;
+    }
+
+    if (c === '"') {
+      let j = i + 1;
+      let str = '';
+      while (j < expr.length && expr[j] !== '"') {
+        str += expr[j];
+        j++;
+      }
+      if (j >= expr.length) {
+        throw new Error('Unterminated string literal in formula');
+      }
+      tokens.push({ type: 'STRING', value: str });
+      i = j + 1;
+      continue;
+    }
+
+    if (/[0-9]/.test(c) || (c === '.' && /[0-9]/.test(expr[i + 1] ?? ''))) {
+      let j = i;
+      while (j < expr.length && /[0-9.]/.test(expr[j])) j++;
+      tokens.push({ type: 'NUMBER', value: expr.slice(i, j) });
+      i = j;
+      continue;
+    }
+
+    if (/[A-Za-z_]/.test(c)) {
+      let j = i;
+      while (j < expr.length && /[A-Za-z0-9_]/.test(expr[j])) j++;
+      tokens.push({ type: 'IDENT', value: expr.slice(i, j) });
+      i = j;
+      continue;
+    }
+
+    if (c === '>' || c === '<') {
+      if (expr[i + 1] === '=') {
+        tokens.push({ type: 'COMPARE', value: c + '=' });
+        i += 2;
+      } else if (c === '<' && expr[i + 1] === '>') {
+        tokens.push({ type: 'COMPARE', value: '<>' });
+        i += 2;
+      } else {
+        tokens.push({ type: 'COMPARE', value: c });
+        i += 1;
+      }
+      continue;
+    }
+
+    if (c === '=') {
+      tokens.push({ type: 'COMPARE', value: '=' });
+      i++;
+      continue;
+    }
+
+    if (c === '+' || c === '-' || c === '*' || c === '/') {
+      tokens.push({ type: 'OP', value: c });
+      i++;
+      continue;
+    }
+
+    if (c === '(') {
+      tokens.push({ type: 'LPAREN', value: c });
+      i++;
+      continue;
+    }
+
+    if (c === ')') {
+      tokens.push({ type: 'RPAREN', value: c });
+      i++;
+      continue;
+    }
+
+    if (c === ',') {
+      tokens.push({ type: 'COMMA', value: c });
+      i++;
+      continue;
+    }
+
+    if (c === ':') {
+      tokens.push({ type: 'COLON', value: c });
+      i++;
+      continue;
+    }
+
+    throw new Error(`Unexpected character '${c}' in formula`);
+  }
+  tokens.push({ type: 'EOF', value: '' });
+  return tokens;
+}
+
+class Parser {
+  private tokens: Token[];
+  private pos = 0;
+
+  constructor(tokens: Token[]) {
+    this.tokens = tokens;
+  }
+
+  private peek(): Token {
+    return this.tokens[this.pos];
+  }
+
+  private advance(): Token {
+    return this.tokens[this.pos++];
+  }
+
+  private expect(type: TokenType): Token {
+    const token = this.peek();
+    if (token.type !== type) {
+      throw new Error(`Expected ${type} but found '${token.value || token.type}' in formula`);
+    }
+    return this.advance();
+  }
+
+  parse(): AstNode {
+    const node = this.parseComparison();
+    this.expect('EOF');
+    return node;
+  }
+
+  private parseComparison(): AstNode {
+    let left = this.parseAdditive();
+    while (this.peek().type === 'COMPARE') {
+      const op = this.advance().value;
+      const right = this.parseAdditive();
+      left = { type: 'BinaryOp', op, left, right };
+    }
+    return left;
+  }
+
+  private parseAdditive(): AstNode {
+    let left = this.parseMultiplicative();
+    while (this.peek().type === 'OP' && (this.peek().value === '+' || this.peek().value === '-')) {
+      const op = this.advance().value;
+      const right = this.parseMultiplicative();
+      left = { type: 'BinaryOp', op, left, right };
+    }
+    return left;
+  }
+
+  private parseMultiplicative(): AstNode {
+    let left = this.parseUnary();
+    while (this.peek().type === 'OP' && (this.peek().value === '*' || this.peek().value === '/')) {
+      const op = this.advance().value;
+      const right = this.parseUnary();
+      left = { type: 'BinaryOp', op, left, right };
+    }
+    return left;
+  }
+
+  private parseUnary(): AstNode {
+    if (this.peek().type === 'OP' && (this.peek().value === '-' || this.peek().value === '+')) {
+      const op = this.advance().value;
+      const operand = this.parseUnary();
+      return { type: 'UnaryOp', op, operand };
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): AstNode {
+    const token = this.peek();
+
+    if (token.type === 'NUMBER') {
+      this.advance();
+      return { type: 'Number', value: parseFloat(token.value) };
+    }
+
+    if (token.type === 'STRING') {
+      this.advance();
+      return { type: 'String', value: token.value };
+    }
+
+    if (token.type === 'LPAREN') {
+      this.advance();
+      const node = this.parseComparison();
+      this.expect('RPAREN');
+      return node;
+    }
+
+    if (token.type === 'IDENT') {
+      const upper = token.value.toUpperCase();
+      const next = this.tokens[this.pos + 1];
+
+      if (next && next.type === 'LPAREN') {
+        this.advance();
+        this.advance();
+        const args: AstNode[] = [];
+        if (this.peek().type !== 'RPAREN') {
+          args.push(this.parseComparison());
+          while (this.peek().type === 'COMMA') {
+            this.advance();
+            args.push(this.parseComparison());
+          }
+        }
+        this.expect('RPAREN');
+        return { type: 'FuncCall', name: upper, args };
+      }
+
+      if (upper === 'TRUE' || upper === 'FALSE') {
+        this.advance();
+        return { type: 'Boolean', value: upper === 'TRUE' };
+      }
+
+      if (isCellRef(token.value)) {
+        this.advance();
+        const start = normalizeCellRef(token.value);
+        if (this.peek().type === 'COLON') {
+          this.advance();
+          const endToken = this.expect('IDENT');
+          if (!isCellRef(endToken.value)) {
+            throw new Error(`Invalid range end reference: ${endToken.value}`);
+          }
+          const end = normalizeCellRef(endToken.value);
+          return { type: 'Range', start, end };
+        }
+        return { type: 'CellRef', ref: start };
+      }
+
+      throw new Error(`Unknown identifier '${token.value}' in formula`);
+    }
+
+    throw new Error(`Unexpected token '${token.value || token.type}' in formula`);
+  }
+}
+
+export function parseFormula(expr: string): AstNode {
+  const tokens = tokenize(expr);
+  const parser = new Parser(tokens);
+  return parser.parse();
+}
