@@ -0,0 +1,323 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import { Spreadsheet } from './index.js';
+
+describe('basic values', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('returns null for empty cells', () => {
+    expect(sheet.get('A1')).toBeNull();
+    expect(sheet.getDisplay('A1')).toBe('');
+  });
+
+  it('stores and retrieves a number', () => {
+    sheet.set('A1', 42);
+    expect(sheet.get('A1')).toBe(42);
+    expect(sheet.getDisplay('A1')).toBe('42');
+  });
+
+  it('stores and retrieves a string', () => {
+    sheet.set('A1', 'hello');
+    expect(sheet.get('A1')).toBe('hello');
+    expect(sheet.getDisplay('A1')).toBe('hello');
+  });
+
+  it('stores and retrieves a boolean', () => {
+    sheet.set('A1', true);
+    expect(sheet.get('A1')).toBe(true);
+    expect(sheet.getDisplay('A1')).toBe('true');
+  });
+
+  it('normalizes lower-case cell references', () => {
+    sheet.set('a1', 5);
+    expect(sheet.get('A1')).toBe(5);
+    expect(sheet.get('a1')).toBe(5);
+  });
+
+  it('supports multi-letter columns', () => {
+    sheet.set('AA1', 7);
+    expect(sheet.get('AA1')).toBe(7);
+  });
+});
+
+describe('formulas: arithmetic', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+  });
+
+  it('adds cells', () => {
+    sheet.set('A3', '=A1+A2');
+    expect(sheet.get('A3')).toBe(30);
+  });
+
+  it('subtracts, multiplies, divides', () => {
+    sheet.set('B1', '=A2-A1');
+    sheet.set('B2', '=A2*A1');
+    sheet.set('B3', '=A2/A1');
+    expect(sheet.get('B1')).toBe(10);
+    expect(sheet.get('B2')).toBe(200);
+    expect(sheet.get('B3')).toBe(2);
+  });
+
+  it('respects operator precedence and parentheses', () => {
+    sheet.set('B1', '=A1+A2*2');
+    sheet.set('B2', '=(A1+A2)*2');
+    expect(sheet.get('B1')).toBe(50);
+    expect(sheet.get('B2')).toBe(60);
+  });
+
+  it('supports unary minus', () => {
+    sheet.set('B1', '=-A1+5');
+    expect(sheet.get('B1')).toBe(-5);
+  });
+
+  it('supports literal-only formulas', () => {
+    sheet.set('B1', '=3.5*2');
+    expect(sheet.get('B1')).toBe(7);
+  });
+
+  it('throws on division by zero', () => {
+    sheet.set('A1', 0);
+    expect(() => sheet.set('B1', '=A2/A1')).toThrow();
+  });
+});
+
+describe('reactive updates', () => {
+  it('propagates a direct dependency', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 5);
+    sheet.set('B1', '=A1+1');
+    expect(sheet.get('B1')).toBe(6);
+    sheet.set('A1', 10);
+    expect(sheet.get('B1')).toBe(11);
+  });
+
+  it('propagates transitively through a chain', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1+1');
+    sheet.set('C1', '=B1+1');
+    sheet.set('D1', '=C1+1');
+    expect(sheet.get('D1')).toBe(4);
+    sheet.set('A1', 10);
+    expect(sheet.get('B1')).toBe(11);
+    expect(sheet.get('C1')).toBe(12);
+    expect(sheet.get('D1')).toBe(13);
+  });
+
+  it('updates a diamond-shaped dependency graph correctly', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 2);
+    sheet.set('B1', '=A1*2');
+    sheet.set('C1', '=A1*3');
+    sheet.set('D1', '=B1+C1');
+    expect(sheet.get('D1')).toBe(10);
+    sheet.set('A1', 5);
+    expect(sheet.get('B1')).toBe(10);
+    expect(sheet.get('C1')).toBe(15);
+    expect(sheet.get('D1')).toBe(25);
+  });
+
+  it('recomputes when a formula cell is replaced with a literal', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 5);
+    sheet.set('B1', '=A1+1');
+    expect(sheet.get('B1')).toBe(6);
+    sheet.set('B1', 100);
+    sheet.set('A1', 999);
+    expect(sheet.get('B1')).toBe(100);
+  });
+
+  it('drops stale dependency edges when a formula changes', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', 2);
+    sheet.set('C1', '=A1');
+    sheet.set('C1', '=B1');
+    sheet.set('A1', 999);
+    expect(sheet.get('C1')).toBe(2);
+    sheet.set('B1', 50);
+    expect(sheet.get('C1')).toBe(50);
+  });
+});
+
+describe('functions', () => {
+  let sheet: Spreadsheet;
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('A2', 2);
+    sheet.set('A3', 3);
+    sheet.set('A4', 4);
+    sheet.set('A5', 5);
+  });
+
+  it('SUM over a column range', () => {
+    sheet.set('B1', '=SUM(A1:A5)');
+    expect(sheet.get('B1')).toBe(15);
+  });
+
+  it('AVERAGE over a range', () => {
+    sheet.set('B1', '=AVERAGE(A1:A5)');
+    expect(sheet.get('B1')).toBe(3);
+  });
+
+  it('MIN and MAX over a range', () => {
+    sheet.set('B1', '=MIN(A1:A5)');
+    sheet.set('B2', '=MAX(A1:A5)');
+    expect(sheet.get('B1')).toBe(1);
+    expect(sheet.get('B2')).toBe(5);
+  });
+
+  it('COUNT counts numeric values only', () => {
+    sheet.set('A6', 'not a number');
+    sheet.set('B1', '=COUNT(A1:A6)');
+    expect(sheet.get('B1')).toBe(5);
+  });
+
+  it('supports row ranges', () => {
+    sheet.set('C1', 10);
+    sheet.set('D1', 20);
+    sheet.set('E1', 30);
+    sheet.set('F1', '=SUM(C1:E1)');
+    expect(sheet.get('F1')).toBe(60);
+  });
+
+  it('supports block ranges', () => {
+    sheet.set('A1', 1);
+    sheet.set('B1', 2);
+    sheet.set('A2', 3);
+    sheet.set('B2', 4);
+    sheet.set('C1', '=SUM(A1:B2)');
+    expect(sheet.get('C1')).toBe(10);
+  });
+
+  it('IF returns the true branch when condition holds', () => {
+    sheet.set('B1', '=IF(A1>30, "big", "small")');
+    sheet.set('A1', 50);
+    expect(sheet.get('B1')).toBe('big');
+  });
+
+  it('IF returns the false branch otherwise', () => {
+    sheet.set('A1', 10);
+    sheet.set('B1', '=IF(A1>30, "big", "small")');
+    expect(sheet.get('B1')).toBe('small');
+  });
+
+  it('supports comparison operators', () => {
+    sheet.set('B1', '=IF(A1>=1, 1, 0)');
+    sheet.set('B2', '=IF(A1<=0, 1, 0)');
+    sheet.set('B3', '=IF(A1=1, 1, 0)');
+    sheet.set('B4', '=IF(A1<>1, 1, 0)');
+    expect(sheet.get('B1')).toBe(1);
+    expect(sheet.get('B2')).toBe(0);
+    expect(sheet.get('B3')).toBe(1);
+    expect(sheet.get('B4')).toBe(0);
+  });
+
+  it('nests function calls and arithmetic', () => {
+    sheet.set('B1', '=SUM(A1:A3) + MAX(A4:A5)');
+    expect(sheet.get('B1')).toBe((1 + 2 + 3) + 5);
+  });
+});
+
+describe('IF branch reactivity (whole-formula dependency tracking)', () => {
+  it('recomputes even when only the untaken branch cell changes', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('B1', 100);
+    sheet.set('C1', 200);
+    sheet.set('D1', '=IF(A1>30, B1, C1)');
+    expect(sheet.get('D1')).toBe(200);
+    sheet.set('C1', 999);
+    expect(sheet.get('D1')).toBe(999);
+  });
+});
+
+describe('circular reference detection', () => {
+  it('throws on direct self-reference', () => {
+    const sheet = new Spreadsheet();
+    expect(() => sheet.set('A1', '=A1+1')).toThrow();
+  });
+
+  it('throws on a two-cell cycle', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=B1');
+    expect(() => sheet.set('B1', '=A1')).toThrow();
+  });
+
+  it('throws on an indirect multi-cell cycle', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=B1');
+    sheet.set('B1', '=C1');
+    expect(() => sheet.set('C1', '=A1')).toThrow();
+  });
+
+  it('does not throw for a non-circular diamond reference', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1');
+    sheet.set('C1', '=A1');
+    expect(() => sheet.set('D1', '=B1+C1')).not.toThrow();
+  });
+
+  it('leaves the sheet state unchanged after a rejected circular set', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=B1');
+    sheet.set('B1', 5);
+    expect(sheet.get('A1')).toBe(5);
+    expect(() => sheet.set('B1', '=A1')).toThrow();
+    // B1's prior value/formula should remain untouched
+    expect(sheet.get('A1')).toBe(5);
+  });
+});
+
+describe('getCells', () => {
+  it('returns only non-empty cells with computed values', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('A3', '=A1+A2');
+
+    const cells = sheet.getCells();
+    expect(cells.size).toBe(3);
+    expect(cells.get('A1')).toBe(10);
+    expect(cells.get('A2')).toBe(20);
+    expect(cells.get('A3')).toBe(30);
+    expect(cells.has('Z9')).toBe(false);
+  });
+
+  it('reflects updates after recomputation', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1*10');
+    sheet.set('A1', 2);
+    expect(sheet.getCells().get('B1')).toBe(20);
+  });
+});
+
+describe('end-to-end example from the spec', () => {
+  it('matches the documented walkthrough', () => {
+    const sheet = new Spreadsheet();
+
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('A3', '=A1+A2');
+    expect(sheet.get('A3')).toBe(30);
+    expect(sheet.getDisplay('A3')).toBe('30');
+
+    sheet.set('A1', 50);
+    expect(sheet.get('A3')).toBe(70);
+
+    sheet.set('B1', '=SUM(A1:A2)');
+    expect(sheet.get('B1')).toBe(70);
+
+    sheet.set('C1', '=IF(A1>30, "big", "small")');
+    expect(sheet.get('C1')).toBe('big');
+  });
+});
