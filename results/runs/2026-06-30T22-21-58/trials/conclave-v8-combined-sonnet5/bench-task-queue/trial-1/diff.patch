+{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_01Jx2PbW8jp3AvyCrdPngjQj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01R2DWkByxj6JdXcrBYD2AzX","name":"Write","input":{"file_path":"/workspace/src/index.ts","content":"import { randomUUID } from 'node:crypto';\n\nexport type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';\n\nexport interface Task {\n  id: string;\n  queueName: string;\n  payload: unknown;\n  status: TaskStatus;\n  createdAt: Date;\n  availableAt: Date;\n  priority: number;\n  attempts: number;\n  maxRetries: number;\n  backoffMs: number;\n  dependsOn: string[];\n  lastError?: string;\n  failCount: number;\n  seq: number;\n}\n\nexport interface EnqueueOptions {\n  priority?: number;\n  delay?: number;\n  runAt?: Date;\n  maxRetries?: number;\n  backoffMs?: number;\n  dependsOn?: string[];\n}\n\nexport interface ProgressInfo {\n  percent: number;\n  message?: string;\n  updatedAt: Date;\n}\n\nexport type ProgressCallback = (info: ProgressInfo) => void;\n\nexport interface ConcurrencyInfo {\n  current: number;\n  max: number;\n}\n\nexport interface Schedule {\n  id: string;\n  queueName: string;\n  cronExpression: string;\n  taskTemplate: unknown;\n  active: boolean;\n}\n\nexport type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;\n\nexport type TaskHandler = (task: Task) => Promise<void>;\n\nexport interface ShutdownSummary {\n  completed: number;\n  cancelled: number;\n  elapsed: number;\n}\n\nexport type ShutdownCallback = () => void;\n\ninterface QueueInternal {\n  name: string;\n  pending: Map<string, Task>;\n  dlq: Task[];\n  concurrencyLimit: number;\n  processingCount: number;\n  middlewares: Middleware[];\n}\n\ninterface ScheduleInternal extends Schedule {\n  lastFiredMinuteKey: number;\n}\n\ninterface ShutdownTracking {\n  remaining: Set<string>;\n  completedCount: number;\n  cancelledCount: number;\n  resolved: boolean;\n  start: number;\n  timer: ReturnType<typeof setTimeout>;\n  checkDone: () => void;\n}\n\nexport class TaskQueue {\n  private queues = new Map<string, QueueInternal>();\n  private tasksById = new Map<string, Task>();\n  private seqCounter = 0;\n\n  private progress = new Map<string, ProgressInfo>();\n  private progressListeners = new Map<string, Set<ProgressCallback>>();\n\n  private schedules = new Map<string, ScheduleInternal>();\n\n  private shuttingDown = false;\n  private shutdownPromise: Promise<ShutdownSummary> | null = null;\n  private shutdownTracking: ShutdownTracking | null = null;\n  private shutdownCallbacks: ShutdownCallback[] = [];\n\n  // ---------------------------------------------------------------------\n  // Phase 1/2/3/4/5/6/7: enqueue / dequeue\n  // ---------------------------------------------------------------------\n\n  enqueue(queueName: string, payload?: unknown, options?: EnqueueOptions): Task;\n  enqueue(payload: unknown): Task;\n  enqueue(...args: unknown[]): Task {\n    let queueName: string;\n    let payload: unknown;\n    let options: EnqueueOptions | undefined;\n\n    if (args.length <= 1) {\n      queueName = 'default';\n      payload = args[0];\n    } else {\n      queueName = args[0] as string;\n      payload = args[1];\n      options = args[2] as EnqueueOptions | undefined;\n    }\n\n    return this.enqueueInternal(queueName, payload, options ?? {});\n  }\n\n  private enqueueInternal(queueName: string, payload: unknown, options: EnqueueOptions): Task {\n    if (this.shuttingDown) {\n      throw new Error('Cannot enqueue: queue is shutting down');\n    }\n\n    const priority = options.priority ?? 5;\n    if (priority < 1 || priority > 10) {\n      throw new Error('priority must be between 1 and 10');\n    }\n\n    const dependsOn = options.dependsOn ?? [];\n    for (const depId of dependsOn) {\n      if (!this.tasksById.has(depId)) {\n        throw new Error(`Dependency task not found: ${depId}`);\n      }\n    }\n\n    const id = randomUUID();\n    if (dependsOn.length > 0 && this.detectCycle(id, dependsOn)) {\n      throw new Error('Circular dependency detected');\n    }\n\n    const now = Date.now();\n    let availableAt = new Date(now);\n    if (options.runAt) {\n      availableAt = new Date(options.runAt.getTime());\n    } else if (options.delay) {\n      availableAt = new Date(now + options.delay);\n    }\n\n    const q = this.getOrCreateQueue(queueName);\n    const task: Task = {\n      id,\n      queueName,\n      payload,\n      status: 'pending',\n      createdAt: new Date(now),\n      availableAt,\n      priority,\n      attempts: 0,\n      maxRetries: options.maxRetries ?? 3,\n      backoffMs: options.backoffMs ?? 1000,\n      dependsOn,\n      failCount: 0,\n      seq: this.seqCounter++,\n    };\n\n    this.tasksById.set(id, task);\n    q.pending.set(id, task);\n    return task;\n  }\n\n  dequeue(queueName: string = 'default'): Task | null {\n    const q = this.queues.get(queueName);\n    if (!q) return null;\n    if (q.processingCount >= q.concurrencyLimit) return null;\n\n    const now = Date.now();\n    let best: Task | null = null;\n\n    for (const task of q.pending.values()) {\n      if (task.availableAt.getTime() > now) continue;\n      if (task.dependsOn.length > 0) {\n        const blocked = task.dependsOn.some((depId) => {\n          const dep = this.tasksById.get(depId);\n          return !dep || dep.status !== 'completed';\n        });\n        if (blocked) continue;\n      }\n      if (!best || this.compareTasks(task, best) < 0) {\n        best = task;\n      }\n    }\n\n    if (!best) return null;\n\n    q.pending.delete(best.id);\n    best.status = 'processing';\n    best.attempts += 1;\n    q.processingCount += 1;\n    return best;\n  }\n\n  size(queueName: string = 'default'): number {\n    return this.queueSize(queueName);\n  }\n\n  listQueues(): string[] {\n    return [...this.queues.keys()];\n  }\n\n  queueSize(queueName: string): number {\n    const q = this.queues.get(queueName);\n    return q ? q.pending.size : 0;\n  }\n\n  private compareTasks(a: Task, b: Task): number {\n    if (a.priority !== b.priority) return a.priority - b.priority;\n    const diff = a.availableAt.getTime() - b.availableAt.getTime();\n    if (diff !== 0) return diff;\n    return a.seq - b.seq;\n  }\n\n  private detectCycle(newId: string, dependsOn: string[]): boolean {\n    const stack = [...dependsOn];\n    const visited = new Set<string>();\n    while (stack.length > 0) {\n      const current = stack.pop();\n      if (current === undefined) continue;\n      if (current === newId) return true;\n      if (visited.has(current)) continue;\n      visited.add(current);\n      const t = this.tasksById.get(current);\n      if (t) {\n        for (const d of t.dependsOn) stack.push(d);\n      }\n    }\n    return false;\n  }\n\n  private getOrCreateQueue(name: string): QueueInternal {\n    let q = this.queues.get(name);\n    if (!q) {\n      q = {\n        name,\n        pending: new Map(),\n        dlq: [],\n        concurrencyLimit: Infinity,\n        processingCount: 0,\n        middlewares: [],\n      };\n      this.queues.set(name, q);\n    }\n    return q;\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 5/6: fail / complete / DLQ\n  // ---------------------------------------------------------------------\n\n  fail(taskId: string, error?: string): void {\n    const task = this.tasksById.get(taskId);\n    if (!task || task.status !== 'processing') return;\n\n    const q = this.queues.get(task.queueName);\n    if (q) q.processingCount = Math.max(0, q.processingCount - 1);\n\n    task.failCount += 1;\n    task.lastError = error;\n\n    if (task.attempts <= task.maxRetries) {\n      const backoff = task.backoffMs * Math.pow(2, task.attempts - 1);\n      task.status = 'pending';\n      task.availableAt = new Date(Date.now() + backoff);\n      if (q) q.pending.set(task.id, task);\n      this.notifyTaskSettled(task.id, 'pending');\n    } else {\n      task.status = 'failed';\n      if (q) q.dlq.push(task);\n      this.notifyTaskSettled(task.id, 'failed');\n    }\n  }\n\n  complete(taskId: string): void {\n    const task = this.tasksById.get(taskId);\n    if (!task || task.status !== 'processing') return;\n\n    const q = this.queues.get(task.queueName);\n    if (q) q.processingCount = Math.max(0, q.processingCount - 1);\n\n    task.status = 'completed';\n    this.notifyTaskSettled(task.id, 'completed');\n  }\n\n  getDLQ(queueName: string): Task[] {\n    const q = this.queues.get(queueName);\n    return q ? [...q.dlq] : [];\n  }\n\n  retryDLQ(taskId: string): Task | null {\n    const task = this.tasksById.get(taskId);\n    if (!task) return null;\n    const q = this.queues.get(task.queueName);\n    if (!q) return null;\n\n    const idx = q.dlq.findIndex((t) => t.id === taskId);\n    if (idx === -1) return null;\n\n    q.dlq.splice(idx, 1);\n    task.attempts = 0;\n    task.status = 'pending';\n    task.availableAt = new Date();\n    q.pending.set(task.id, task);\n    return task;\n  }\n\n  clearDLQ(queueName: string): void {\n    const q = this.queues.get(queueName);\n    if (q) q.dlq = [];\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 7: Dependencies\n  // ---------------------------------------------------------------------\n\n  getDependencies(taskId: string): Array<{ taskId: string; status: TaskStatus }> {\n    const task = this.tasksById.get(taskId);\n    if (!task) return [];\n    return task.dependsOn.map((depId) => {\n      const dep = this.tasksById.get(depId);\n      return { taskId: depId, status: dep ? dep.status : ('failed' as TaskStatus) };\n    });\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 8: Concurrency\n  // ---------------------------------------------------------------------\n\n  setConcurrency(queueName: string, limit: number): void {\n    const q = this.getOrCr