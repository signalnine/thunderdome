+import { randomUUID } from 'node:crypto';
+
+export type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';
+
+export interface Task {
+  id: string;
+  queueName: string;
+  payload: unknown;
+  status: TaskStatus;
+  createdAt: Date;
+  availableAt: Date;
+  priority: number;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  dependsOn: string[];
+  lastError?: string;
+  failCount: number;
+  seq: number;
+}
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type ProgressCallback = (info: ProgressInfo) => void;
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: unknown;
+  active: boolean;
+}
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+
+export type TaskHandler = (task: Task) => Promise<void>;
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+export type ShutdownCallback = () => void;
+
+interface QueueInternal {
+  name: string;
+  pending: Map<string, Task>;
+  dlq: Task[];
+  concurrencyLimit: number;
+  processingCount: number;
+  middlewares: Middleware[];
+}
+
+interface ScheduleInternal extends Schedule {
+  lastFiredMinuteKey: number;
+}
+
+interface ShutdownTracking {
+  remaining: Set<string>;
+  completedCount: number;
+  cancelledCount: number;
+  resolved: boolean;
+  start: number;
+  timer: ReturnType<typeof setTimeout>;
+  checkDone: () => void;
+}
+
+export class TaskQueue {
+  private queues = new Map<string, QueueInternal>();
+  private tasksById = new Map<string, Task>();
+  private seqCounter = 0;
+
+  private progress = new Map<string, ProgressInfo>();
+  private progressListeners = new Map<string, Set<ProgressCallback>>();
+
+  private schedules = new Map<string, ScheduleInternal>();
+
+  private shuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private shutdownTracking: ShutdownTracking | null = null;
+  private shutdownCallbacks: ShutdownCallback[] = [];
+
+  // ---------------------------------------------------------------------
+  // Phase 1/2/3/4/5/6/7: enqueue / dequeue
+  // ---------------------------------------------------------------------
+
+  enqueue(queueName: string, payload?: unknown, options?: EnqueueOptions): Task;
+  enqueue(payload: unknown): Task;
+  enqueue(...args: unknown[]): Task {
+    let queueName: string;
+    let payload: unknown;
+    let options: EnqueueOptions | undefined;
+
+    if (args.length <= 1) {
+      queueName = 'default';
+      payload = args[0];
+    } else {
+      queueName = args[0] as string;
+      payload = args[1];
+      options = args[2] as EnqueueOptions | undefined;
+    }
+
+    return this.enqueueInternal(queueName, payload, options ?? {});
+  }
+
+  private enqueueInternal(queueName: string, payload: unknown, options: EnqueueOptions): Task {
+    if (this.shuttingDown) {
+      throw new Error('Cannot enqueue: queue is shutting down');
+    }
+
+    const priority = options.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error('priority must be between 1 and 10');
+    }
+
+    const dependsOn = options.dependsOn ?? [];
+    for (const depId of dependsOn) {
+      if (!this.tasksById.has(depId)) {
+        throw new Error(`Dependency task not found: ${depId}`);
+      }
+    }
+
+    const id = randomUUID();
+    if (dependsOn.length > 0 && this.detectCycle(id, dependsOn)) {
+      throw new Error('Circular dependency detected');
+    }
+
+    const now = Date.now();
+    let availableAt = new Date(now);
+    if (options.runAt) {
+      availableAt = new Date(options.runAt.getTime());
+    } else if (options.delay) {
+      availableAt = new Date(now + options.delay);
+    }
+
+    const q = this.getOrCreateQueue(queueName);
+    const task: Task = {
+      id,
+      queueName,
+      payload,
+      status: 'pending',
+      createdAt: new Date(now),
+      availableAt,
+      priority,
+      attempts: 0,
+      maxRetries: options.maxRetries ?? 3,
+      backoffMs: options.backoffMs ?? 1000,
+      dependsOn,
+      failCount: 0,
+      seq: this.seqCounter++,
+    };
+
+    this.tasksById.set(id, task);
+    q.pending.set(id, task);
+    return task;
+  }
+
+  dequeue(queueName: string = 'default'): Task | null {
+    const q = this.queues.get(queueName);
+    if (!q) return null;
+    if (q.processingCount >= q.concurrencyLimit) return null;
+
+    const now = Date.now();
+    let best: Task | null = null;
+
+    for (const task of q.pending.values()) {
+      if (task.availableAt.getTime() > now) continue;
+      if (task.dependsOn.length > 0) {
+        const blocked = task.dependsOn.some((depId) => {
+          const dep = this.tasksById.get(depId);
+          return !dep || dep.status !== 'completed';
+        });
+        if (blocked) continue;
+      }
+      if (!best || this.compareTasks(task, best) < 0) {
+        best = task;
+      }
+    }
+
+    if (!best) return null;
+
+    q.pending.delete(best.id);
+    best.status = 'processing';
+    best.attempts += 1;
+    q.processingCount += 1;
+    return best;
+  }
+
+  size(queueName: string = 'default'): number {
+    return this.queueSize(queueName);
+  }
+
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  queueSize(queueName: string): number {
+    const q = this.queues.get(queueName);
+    return q ? q.pending.size : 0;
+  }
+
+  private compareTasks(a: Task, b: Task): number {
+    if (a.priority !== b.priority) return a.priority - b.priority;
+    const diff = a.availableAt.getTime() - b.availableAt.getTime();
+    if (diff !== 0) return diff;
+    return a.seq - b.seq;
+  }
+
+  private detectCycle(newId: string, dependsOn: string[]): boolean {
+    const stack = [...dependsOn];
+    const visited = new Set<string>();
+    while (stack.length > 0) {
+      const current = stack.pop();
+      if (current === undefined) continue;
+      if (current === newId) return true;
+      if (visited.has(current)) continue;
+      visited.add(current);
+      const t = this.tasksById.get(current);
+      if (t) {
+        for (const d of t.dependsOn) stack.push(d);
+      }
+    }
+    return false;
+  }
+
+  private getOrCreateQueue(name: string): QueueInternal {
+    let q = this.queues.get(name);
+    if (!q) {
+      q = {
+        name,
+        pending: new Map(),
+        dlq: [],
+        concurrencyLimit: Infinity,
+        processingCount: 0,
+        middlewares: [],
+      };
+      this.queues.set(name, q);
+    }
+    return q;
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 5/6: fail / complete / DLQ
+  // ---------------------------------------------------------------------
+
+  fail(taskId: string, error?: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    const q = this.queues.get(task.queueName);
+    if (q) q.processingCount = Math.max(0, q.processingCount - 1);
+
+    task.failCount += 1;
+    task.lastError = error;
+
+    if (task.attempts <= task.maxRetries) {
+      const backoff = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + backoff);
+      if (q) q.pending.set(task.id, task);
+      this.notifyTaskSettled(task.id, 'pending');
+    } else {
+      task.status = 'failed';
+      if (q) q.dlq.push(task);
+      this.notifyTaskSettled(task.id, 'failed');
+    }
+  }
+
+  complete(taskId: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    const q = this.queues.get(task.queueName);
+    if (q) q.processingCount = Math.max(0, q.processingCount - 1);
+
+    task.status = 'completed';
+    this.notifyTaskSettled(task.id, 'completed');
+  }
+
+  getDLQ(queueName: string): Task[] {
+    const q = this.queues.get(queueName);
+    return q ? [...q.dlq] : [];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    const task = this.tasksById.get(taskId);
+    if (!task) return null;
+    const q = this.queues.get(task.queueName);
+    if (!q) return null;
+
+    const idx = q.dlq.findIndex((t) => t.id === taskId);
+    if (idx === -1) return null;
+
+    q.dlq.splice(idx, 1);
+    task.attempts = 0;
+    task.status = 'pending';
+    task.availableAt = new Date();
+    q.pending.set(task.id, task);
+    return task;
+  }
+
+  clearDLQ(queueName: string): void {
+    const q = this.queues.get(queueName);
+    if (q) q.dlq = [];
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 7: Dependencies
+  // ---------------------------------------------------------------------
+
+  getDependencies(taskId: string): Array<{ taskId: string; status: TaskStatus }> {
+    const task = this.tasksById.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map((depId) => ({
+      taskId: depId,
+      status: this.tasksById.get(depId)!.status,
+    }));
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 8: Concurrency
+  // ---------------------------------------------------------------------
+
+  setConcurrency(queueName: string, limit: number): void {
+    const q = this.getOrCreateQueue(queueName);
+    q.concurrencyLimit = limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const q = this.queues.get(queueName);
+    if (!q) return { current: 0, max: Infinity };
+    return { current: q.processingCount, max: q.concurrencyLimit };
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 9: Progress and Cancellation
+  // ---------------------------------------------------------------------
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error('progress percent must be between 0 and 100');
+    }
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    this.progress.set(taskId, info);
+
+    const listeners = this.progressListeners.get(taskId);
+    if (listeners) {
+      for (const cb of listeners) cb(info);
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progress.get(taskId) ?? null;
+  }
+
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    let listeners = this.progressListeners.get(taskId);
+    if (!listeners) {
+      listeners = new Set();
+      this.progressListeners.set(taskId, listeners);
+    }
+    listeners.add(callback);
+    return () => {
+      listeners?.delete(callback);
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task) return;
+    if (task.status === 'completed' || task.status === 'failed' || task.status === 'cancelled') {
+      return;
+    }
+
+    const q = this.queues.get(task.queueName);
+    if (task.status === 'processing' && q) {
+      q.processingCount = Math.max(0, q.processingCount - 1);
+    }
+    if (task.status === 'pending' && q) {
+      q.pending.delete(task.id);
+    }
+
+    task.status = 'cancelled';
+    this.notifyTaskSettled(task.id, 'cancelled');
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 10: Recurring Tasks (Cron)
+  // ---------------------------------------------------------------------
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {
+    const id = randomUUID();
+    const sched: ScheduleInternal = {
+      id,
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+      lastFiredMinuteKey: -1,
+    };
+    this.schedules.set(id, sched);
+    return { id, queueName, cronExpression, taskTemplate, active: true };
+  }
+
+  unschedule(scheduleId: string): void {
+    const sched = this.schedules.get(scheduleId);
+    if (sched) sched.active = false;
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    return [...this.schedules.values()]
+      .filter((s) => s.active && (!queueName || s.queueName === queueName))
+      .map((s) => ({
+        id: s.id,
+        queueName: s.queueName,
+        cronExpression: s.cronExpression,
+        taskTemplate: s.taskTemplate,
+        active: s.active,
+      }));
+  }
+
+  tick(): void {
+    const now = Date.now();
+    const minuteKey = Math.floor(now / 60000);
+    const date = new Date(now);
+
+    for (const sched of this.schedules.values()) {
+      if (!sched.active) continue;
+      if (sched.lastFiredMinuteKey === minuteKey) continue;
+      if (this.cronMatches(sched.cronExpression, date)) {
+        this.enqueueInternal(sched.queueName, sched.taskTemplate, {});
+        sched.lastFiredMinuteKey = minuteKey;
+      }
+    }
+  }
+
+  private cronMatches(expr: string, date: Date): boolean {
+    const parts = expr.trim().split(/\s+/);
+    const minuteField = parts[0] ?? '*';
+    const hourField = parts[1] ?? '*';
+    return (
+      this.cronFieldMatches(minuteField, date.getUTCMinutes()) &&
+      this.cronFieldMatches(hourField, date.getUTCHours())
+    );
+  }
+
+  private cronFieldMatches(field: string, value: number): boolean {
+    if (field === '*') return true;
+    if (field.startsWith('*/')) {
+      const n = parseInt(field.slice(2), 10);
+      return n > 0 && value % n === 0;
+    }
+    const n = parseInt(field, 10);
+    return value === n;
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 11: Middleware Pipeline
+  // ---------------------------------------------------------------------
+
+  use(queueName: string, middleware: Middleware): void {
+    const q = this.getOrCreateQueue(queueName);
+    q.middlewares.push(middleware);
+  }
+
+  async process(queueName: string, handler: TaskHandler): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const q = this.queues.get(queueName);
+    const middlewares = q ? q.middlewares : [];
+    let handlerRan = false;
+
+    const run = async (index: number): Promise<void> => {
+      if (index < middlewares.length) {
+        await middlewares[index](task, () => run(index + 1));
+      } else {
+        handlerRan = true;
+        await handler(task);
+      }
+    };
+
+    try {
+      await run(0);
+      if (handlerRan && task.status === 'processing') {
+        this.complete(task.id);
+      }
+    } catch (err) {
+      if (task.status === 'processing') {
+        this.fail(task.id, err instanceof Error ? err.message : String(err));
+      }
+    }
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 12: Graceful Shutdown
+  // ---------------------------------------------------------------------
+
+  onShutdown(callback: ShutdownCallback): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  shutdown(timeout: number = 30000): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+
+    this.shuttingDown = true;
+    const start = Date.now();
+
+    for (const cb of this.shutdownCallbacks) cb();
+
+    const processingIds: string[] = [];
+    for (const task of this.tasksById.values()) {
+      if (task.status === 'processing') processingIds.push(task.id);
+    }
+
+    if (processingIds.length === 0) {
+      this.shutdownPromise = Promise.resolve({
+        completed: 0,
+        cancelled: 0,
+        elapsed: Date.now() - start,
+      });
+      return this.shutdownPromise;
+    }
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      const tracking: ShutdownTracking = {
+        remaining: new Set(processingIds),
+        completedCount: 0,
+        cancelledCount: 0,
+        resolved: false,
+        start,
+        timer: undefined as unknown as ReturnType<typeof setTimeout>,
+        checkDone: () => {},
+      };
+
+      tracking.checkDone = () => {
+        if (tracking.resolved || tracking.remaining.size > 0) return;
+        tracking.resolved = true;
+        clearTimeout(tracking.timer);
+        resolve({
+          completed: tracking.completedCount,
+          cancelled: tracking.cancelledCount,
+          elapsed: Date.now() - start,
+        });
+      };
+
+      tracking.timer = setTimeout(() => {
+        if (tracking.resolved) return;
+        tracking.resolved = true;
+        for (const id of tracking.remaining) {
+          const t = this.tasksById.get(id);
+          if (t && t.status === 'processing') {
+            const q = this.queues.get(t.queueName);
+            if (q) q.processingCount = Math.max(0, q.processingCount - 1);
+            t.status = 'cancelled';
+            tracking.cancelledCount += 1;
+          }
+        }
+        tracking.remaining.clear();
+        resolve({
+          completed: tracking.completedCount,
+          cancelled: tracking.cancelledCount,
+          elapsed: Date.now() - start,
+        });
+      }, timeout);
+
+      this.shutdownTracking = tracking;
+    });
+
+    return this.shutdownPromise;
+  }
+
+  private notifyTaskSettled(taskId: string, finalStatus: TaskStatus | 'pending'): void {
+    const tracking = this.shutdownTracking;
+    if (!tracking || tracking.resolved || !tracking.remaining.has(taskId)) return;
+
+    tracking.remaining.delete(taskId);
+    if (finalStatus === 'completed') tracking.completedCount += 1;
+    else if (finalStatus === 'cancelled') tracking.cancelledCount += 1;
+    tracking.checkDone();
+  }
+}
