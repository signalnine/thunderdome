+++ b/tests/helpers.ts
@@ -0,0 +1,22 @@
+import request from 'supertest';
+import type { Express } from 'express';
+
+export async function registerAndLogin(
+  app: Express,
+  username: string,
+  password = 'password123',
+): Promise<{ id: string; username: string; token: string }> {
+  const registerRes = await request(app).post('/auth/register').send({ username, password });
+  if (registerRes.status !== 201) {
+    throw new Error(`register failed: ${registerRes.status} ${JSON.stringify(registerRes.body)}`);
+  }
+  const loginRes = await request(app).post('/auth/login').send({ username, password });
+  if (loginRes.status !== 200) {
+    throw new Error(`login failed: ${loginRes.status} ${JSON.stringify(loginRes.body)}`);
+  }
+  return { id: registerRes.body.id, username, token: loginRes.body.token };
+}
+
+export function auth(token: string): { Authorization: string } {
+  return { Authorization: `Bearer ${token}` };
+}
