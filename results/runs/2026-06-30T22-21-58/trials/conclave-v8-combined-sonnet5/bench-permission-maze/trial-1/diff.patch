s).toBe(201);\n    expect(res.body.ownerId).toBe(alice.id);\n    expect(res.body.folderId).toBe(folder.id);\n  });\n\n  it('rejects document creation by a viewer-only user', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const bob = await registerAndLogin(app, 'bob');\n    const folder = await makeFolder(alice.token);\n    await request(app)\n      .post(`/folders/${folder.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: bob.id, role: 'viewer' });\n    const res = await request(app)\n      .post(`/folders/${folder.id}/documents`)\n      .set(auth(bob.token))\n      .send({ title: 'Doc', content: 'hello' });\n    expect(res.status).toBe(403);\n  });\n\n  it('rejects document creation in a nonexistent folder', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const res = await request(app)\n      .post('/folders/does-not-exist/documents')\n      .set(auth(alice.token))\n      .send({ title: 'Doc', content: 'hello' });\n    expect(res.status).toBe(404);\n  });\n\n  it('gets a document as viewer, 403 with no access, 404 nonexistent', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const bob = await registerAndLogin(app, 'bob');\n    const carol = await registerAndLogin(app, 'carol');\n    const folder = await makeFolder(alice.token);\n    const doc = await request(app)\n      .post(`/folders/${folder.id}/documents`)\n      .set(auth(alice.token))\n      .send({ title: 'Doc', content: 'hello' });\n\n    await request(app)\n      .post(`/documents/${doc.body.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: bob.id, role: 'viewer' });\n\n    const okRes = await request(app).get(`/documents/${doc.body.id}`).set(auth(bob.token));\n    expect(okRes.status).toBe(200);\n\n    const forbidden = await request(app).get(`/documents/${doc.body.id}`).set(auth(carol.token));\n    expect(forbidden.status).toBe(403);\n\n    const notFound = await request(app).get('/documents/does-not-exist').set(auth(alice.token));\n    expect(notFound.status).toBe(404);\n  });\n\n  it('updates a document as editor, rejects viewer-only, updates updatedAt', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const bob = await registerAndLogin(app, 'bob');\n    const folder = await makeFolder(alice.token);\n    const doc = await request(app)\n      .post(`/folders/${folder.id}/documents`)\n      .set(auth(alice.token))\n      .send({ title: 'Doc', content: 'hello' });\n\n    await request(app)\n      .post(`/documents/${doc.body.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: bob.id, role: 'viewer' });\n\n    const viewerEdit = await request(app)\n      .put(`/documents/${doc.body.id}`)\n      .set(auth(bob.token))\n      .send({ content: 'hacked' });\n    expect(viewerEdit.status).toBe(403);\n\n    const edit = await request(app)\n      .put(`/documents/${doc.body.id}`)\n      .set(auth(alice.token))\n      .send({ content: 'updated' });\n    expect(edit.status).toBe(200);\n    expect(edit.body.content).toBe('updated');\n    expect(edit.body.updatedAt).not.toBe(doc.body.updatedAt);\n  });\n\n  it('deletes a document as owner, rejects editor-only', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const bob = await registerAndLogin(app, 'bob');\n    const folder = await makeFolder(alice.token);\n    const doc = await request(app)\n      .post(`/folders/${folder.id}/documents`)\n      .set(auth(alice.token))\n      .send({ title: 'Doc', content: 'hello' });\n\n    await request(app)\n      .post(`/documents/${doc.body.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: bob.id, role: 'editor' });\n\n    const editorDelete = await request(app).delete(`/documents/${doc.body.id}`).set(auth(bob.token));\n    expect(editorDelete.status).toBe(403);\n\n    const ownerDelete = await request(app).delete(`/documents/${doc.body.id}`).set(auth(alice.token));\n    expect(ownerDelete.status).toBe(204);\n\n    const getAfter = await request(app).get(`/documents/${doc.body.id}`).set(auth(alice.token));\n    expect(getAfter.status).toBe(404);\n  });\n\n  it('inherits permission from parent folder without a direct document share', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const bob = await registerAndLogin(app, 'bob');\n    const folder = await makeFolder(alice.token);\n    const doc = await request(app)\n      .post(`/folders/${folder.id}/documents`)\n      .set(auth(alice.token))\n      .send({ title: 'Doc', content: 'hello' });\n\n    await request(app)\n      .post(`/folders/${folder.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: bob.id, role: 'editor' });\n\n    const getRes = await request(app).get(`/documents/${doc.body.id}`).set(auth(bob.token));\n    expect(getRes.status).toBe(200);\n\n    const editRes = await request(app)\n      .put(`/documents/${doc.body.id}`)\n      .set(auth(bob.token))\n      .send({ content: 'edited via folder inheritance' });\n    expect(editRes.status).toBe(200);\n  });\n});\n","structuredPatch":[{"oldStart":97,"oldLines":6,"newStart":97,"newLines":7,"lines":["       .send({ content: 'hacked' });","     expect(viewerEdit.status).toBe(403);"," ","+    await new Promise((resolve) => setTimeout(resolve, 5));","     const edit = await request(app)","       .put(`/documents/${doc.body.id}`)","       .set(auth(alice.token))"]}],"userModified":false,"replaceAll":false}}
