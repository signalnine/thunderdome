+++ b/src/cascade.ts
@@ -0,0 +1,15 @@
+import type { Store } from './store.js';
+
+export function cascadeDeleteFolder(store: Store, folderId: string): void {
+  for (const document of [...store.documents.values()]) {
+    if (document.folderId === folderId) {
+      store.documents.delete(document.id);
+    }
+  }
+  for (const folder of [...store.folders.values()]) {
+    if (folder.parentId === folderId) {
+      cascadeDeleteFolder(store, folder.id);
+    }
+  }
+  store.folders.delete(folderId);
+}
