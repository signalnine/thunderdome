+import { describe, expect, it, beforeEach } from 'vitest';
+import request from 'supertest';
+import type { Express } from 'express';
+import { createApp } from '../src/app.js';
+import { registerAndLogin } from './helpers.js';
+
+describe('auth', () => {
+  let app: Express;
+
+  beforeEach(() => {
+    app = createApp();
+  });
+
+  it('registers a new user', async () => {
+    const res = await request(app).post('/auth/register').send({ username: 'alice', password: 'secret' });
+    expect(res.status).toBe(201);
+    expect(res.body).toMatchObject({ username: 'alice' });
+    expect(res.body.id).toBeTypeOf('string');
+    expect(res.body.password).toBeUndefined();
+    expect(res.body.passwordHash).toBeUndefined();
+  });
+
+  it('rejects registration missing username or password', async () => {
+    const res1 = await request(app).post('/auth/register').send({ password: 'secret' });
+    expect(res1.status).toBe(400);
+    const res2 = await request(app).post('/auth/register').send({ username: 'bob' });
+    expect(res2.status).toBe(400);
+  });
+
+  it('rejects duplicate username', async () => {
+    await request(app).post('/auth/register').send({ username: 'carol', password: 'secret' });
+    const res = await request(app).post('/auth/register').send({ username: 'carol', password: 'other' });
+    expect(res.status).toBe(409);
+  });
+
+  it('logs in with correct credentials and returns a token', async () => {
+    await request(app).post('/auth/register').send({ username: 'dave', password: 'secret' });
+    const res = await request(app).post('/auth/login').send({ username: 'dave', password: 'secret' });
+    expect(res.status).toBe(200);
+    expect(res.body.token).toBeTypeOf('string');
+  });
+
+  it('rejects login with wrong password or unknown user', async () => {
+    await request(app).post('/auth/register').send({ username: 'erin', password: 'secret' });
+    const wrongPw = await request(app).post('/auth/login').send({ username: 'erin', password: 'nope' });
+    expect(wrongPw.status).toBe(401);
+    const unknown = await request(app).post('/auth/login').send({ username: 'ghost', password: 'x' });
+    expect(unknown.status).toBe(401);
+  });
+
+  it('rejects protected routes without a token', async () => {
+    const res = await request(app).post('/folders').send({ name: 'Root' });
+    expect(res.status).toBe(401);
+  });
+
+  it('rejects protected routes with an invalid token', async () => {
+    const res = await request(app)
+      .post('/folders')
+      .set('Authorization', 'Bearer bogus-token')
+      .send({ name: 'Root' });
+    expect(res.status).toBe(401);
