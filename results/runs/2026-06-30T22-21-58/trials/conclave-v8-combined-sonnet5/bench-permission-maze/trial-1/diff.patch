@@ -0,0 +1,26 @@
+import type { Document, Folder } from './types.js';
+
+export function serializeFolder(folder: Folder): Record<string, unknown> {
+  return {
+    id: folder.id,
+    name: folder.name,
+    parentId: folder.parentId,
+    ownerId: folder.ownerId,
+    shares: Object.fromEntries(folder.shares),
+    createdAt: folder.createdAt,
+    updatedAt: folder.updatedAt,
+  };
+}
+
+export function serializeDocument(document: Document): Record<string, unknown> {
+  return {
+    id: document.id,
+    title: document.title,
+    content: document.content,
+    folderId: document.folderId,
+    ownerId: document.ownerId,
+    shares: Object.fromEntries(document.shares),
+    createdAt: document.createdAt,
+    updatedAt: document.updatedAt,
+  };
+}
