@@ -0,0 +1,24 @@
+import { randomUUID } from 'node:crypto';
+import type { ActivityEntry, Document, Folder, User } from './types.js';
+
+export class Store {
+  users = new Map<string, User>();
+  usersByUsername = new Map<string, string>();
+  tokens = new Map<string, string>();
+  folders = new Map<string, Folder>();
+  documents = new Map<string, Document>();
+  activity: ActivityEntry[] = [];
+
+  reset(): void {
+    this.users.clear();
+    this.usersByUsername.clear();
+    this.tokens.clear();
+    this.folders.clear();
+    this.documents.clear();
+    this.activity = [];
+  }
+}
+
+export function newId(): string {
+  return randomUUID();
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..bc57608
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,71 @@
+export type Role = 'viewer' | 'editor' | 'owner';
+
+export const ROLE_RANK: Record<Role, number> = {
+  viewer: 1,
+  editor: 2,
+  owner: 3,
+};
+
+export function isRole(value: unknown): value is Role {
+  return value === 'viewer' || value === 'editor' || value === 'owner';
+}
+
+export function maxRole(a: Role | null, b: Role | null): Role | null {
+  if (!a) return b;
+  if (!b) return a;
+  return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;
+}
+
+export function roleAtLeast(role: Role | null, required: Role): boolean {
+  if (!role) return false;
+  return ROLE_RANK[role] >= ROLE_RANK[required];
+}
+
+export interface User {
+  id: string;
+  username: string;
+  passwordHash: string;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  shares: Map<string, Role>;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  shares: Map<string, Role>;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export type ActivityAction =
+  | 'folder.create'
+  | 'folder.update'
+  | 'folder.delete'
+  | 'document.create'
+  | 'document.update'
+  | 'document.delete'
+  | 'share.create'
+  | 'share.revoke';
+
+export type TargetType = 'folder' | 'document';
+
+export interface ActivityEntry {
+  id: string;
+  action: ActivityAction;
+  actorId: string;
+  targetType: TargetType;
+  targetId: string;
+  timestamp: string;
+  details?: Record<string, unknown>;
+}
