+import { describe, expect, it, beforeEach } from 'vitest';
+import request from 'supertest';
+import type { Express } from 'express';
+import { createApp } from '../src/app.js';
+import { registerAndLogin, auth } from './helpers.js';
+
+describe('activity log', () => {
+  let app: Express;
+
+  beforeEach(() => {
+    app = createApp();
+  });
+
+  it('requires auth', async () => {
+    const res = await request(app).get('/activity');
+    expect(res.status).toBe(401);
+  });
+
+  it('logs document creation, update, deletion, and sharing with required fields', async () => {
+    const alice = await registerAndLogin(app, 'alice');
+    const bob = await registerAndLogin(app, 'bob');
+    const folder = await request(app).post('/folders').set(auth(alice.token)).send({ name: 'Root' });
+    const doc = await request(app)
+      .post(`/folders/${folder.body.id}/documents`)
+      .set(auth(alice.token))
+      .send({ title: 'Doc', content: 'hi' });
+    await request(app)
+      .put(`/documents/${doc.body.id}`)
+      .set(auth(alice.token))
+      .send({ content: 'updated' });
+    await request(app)
+      .post(`/documents/${doc.body.id}/share`)
+      .set(auth(alice.token))
+      .send({ userId: bob.id, role: 'viewer' });
+    await request(app).delete(`/documents/${doc.body.id}`).set(auth(alice.token));
+
+    const res = await request(app).get('/activity').set(auth(alice.token));
+    expect(res.status).toBe(200);
+    const actions = res.body.map((e: { action: string }) => e.action);
+    expect(actions).toContain('document.create');
+    expect(actions).toContain('document.update');
+    expect(actions).toContain('document.delete');
+    expect(actions).toContain('share.create');
+
+    for (const entry of res.body) {
+      expect(entry).toHaveProperty('action');
+      expect(entry).toHaveProperty('actorId');
+      expect(entry).toHaveProperty('targetType');
+      expect(entry).toHaveProperty('targetId');
+      expect(entry).toHaveProperty('timestamp');
+      expect(entry.actorId).toBe(alice.id);
+    }
+  });
+
+  it('returns entries most-recent-first', async () => {
+    const alice = await registerAndLogin(app, 'alice');
+    const folder = await request(app).post('/folders').set(auth(alice.token)).send({ name: 'Root' });
+    const doc1 = await request(app)
+      .post(`/folders/${folder.body.id}/documents`)
+      .set(auth(alice.token))
+      .send({ title: 'Doc1', content: 'a' });
+    await new Promise((resolve) => setTimeout(resolve, 5));
+    const doc2 = await request(app)
+      .post(`/folders/${folder.body.id}/documents`)
+      .set(auth(alice.token))
+      .send({ title: 'Doc2', content: 'b' });
+
+    const res = await request(app).get('/activity').set(auth(alice.token));
+    const ids = res.body.map((e: { targetId: string }) => e.targetId);
+    expect(ids.indexOf(doc2.body.id)).toBeLessThan(ids.indexOf(doc1.body.id));
+  });
+});
