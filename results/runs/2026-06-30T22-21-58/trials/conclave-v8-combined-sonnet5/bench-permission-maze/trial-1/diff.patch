@@ -0,0 +1,110 @@
+import { Router } from 'express';
+import type { Store } from '../store.js';
+import { newId } from '../store.js';
+import type { AuthedRequest } from '../auth.js';
+import { requireAuth } from '../auth.js';
+import { getFolderRole, isDescendantFolder } from '../permissions.js';
+import { roleAtLeast } from '../types.js';
+import { BadRequestError, ForbiddenError, NotFoundError } from '../errors.js';
+import { logActivity } from '../activity.js';
+import { serializeFolder } from '../serialize.js';
+import { cascadeDeleteFolder } from '../cascade.js';
+
+export function folderRoutes(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  router.post('/folders', (req: AuthedRequest, res) => {
+    const userId = req.userId as string;
+    const { name, parentId } = req.body as { name?: unknown; parentId?: unknown };
+    if (typeof name !== 'string' || name.trim() === '') {
+      throw new BadRequestError('name is required');
+    }
+    let parent: string | null = null;
+    if (parentId !== undefined && parentId !== null) {
+      if (typeof parentId !== 'string') throw new BadRequestError('parentId must be a string');
+      const parentFolder = store.folders.get(parentId);
+      if (!parentFolder) throw new NotFoundError('parent folder not found');
+      if (!roleAtLeast(getFolderRole(store, parentId, userId), 'editor')) {
+        throw new ForbiddenError('insufficient permission on parent folder');
+      }
+      parent = parentId;
+    }
+    const id = newId();
+    const now = new Date().toISOString();
+    store.folders.set(id, {
+      id,
+      name,
+      parentId: parent,
+      ownerId: userId,
+      shares: new Map(),
+      createdAt: now,
+      updatedAt: now,
+    });
+    logActivity(store, 'folder.create', userId, 'folder', id);
+    res.status(201).json(serializeFolder(store.folders.get(id)!));
+  });
+
+  router.get('/folders/:id', (req: AuthedRequest, res) => {
+    const userId = req.userId as string;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) throw new NotFoundError('folder not found');
+    if (!roleAtLeast(getFolderRole(store, folder.id, userId), 'viewer')) {
+      throw new ForbiddenError('insufficient permission');
+    }
+    res.status(200).json(serializeFolder(folder));
+  });
+
+  router.put('/folders/:id', (req: AuthedRequest, res) => {
+    const userId = req.userId as string;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) throw new NotFoundError('folder not found');
+    if (!roleAtLeast(getFolderRole(store, folder.id, userId), 'editor')) {
+      throw new ForbiddenError('insufficient permission');
+    }
+    const { name, parentId } = req.body as { name?: unknown; parentId?: unknown };
+    if (name === undefined && parentId === undefined) {
+      throw new BadRequestError('nothing to update');
+    }
+    if (name !== undefined) {
+      if (typeof name !== 'string' || name.trim() === '') {
+        throw new BadRequestError('name must be a non-empty string');
+      }
+      folder.name = name;
+    }
+    if (parentId !== undefined) {
+      if (parentId === null) {
+        folder.parentId = null;
+      } else {
+        if (typeof parentId !== 'string') throw new BadRequestError('parentId must be a string');
+        if (parentId === folder.id) throw new BadRequestError('folder cannot be its own parent');
+        const newParent = store.folders.get(parentId);
+        if (!newParent) throw new NotFoundError('parent folder not found');
+        if (isDescendantFolder(store, folder.id, parentId)) {
+          throw new BadRequestError('cannot move folder into its own descendant');
+        }
+        if (!roleAtLeast(getFolderRole(store, parentId, userId), 'editor')) {
+          throw new ForbiddenError('insufficient permission on target parent folder');
+        }
+        folder.parentId = parentId;
+      }
+    }
+    folder.updatedAt = new Date().toISOString();
+    logActivity(store, 'folder.update', userId, 'folder', folder.id);
+    res.status(200).json(serializeFolder(folder));
+  });
+
+  router.delete('/folders/:id', (req: AuthedRequest, res) => {
+    const userId = req.userId as string;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) throw new NotFoundError('folder not found');
+    if (!roleAtLeast(getFolderRole(store, folder.id, userId), 'owner')) {
+      throw new ForbiddenError('insufficient permission');
+    }
+    cascadeDeleteFolder(store, folder.id);
+    logActivity(store, 'folder.delete', userId, 'folder', folder.id);
+    res.status(204).send();
+  });
+
+  return router;
+}
diff --git a/src/routes/share.routes.ts b/src/routes/share.routes.ts
new file mode 100644
index 0000000..67a7efe
--- /dev/null
+++ b/src/routes/share.routes.ts
@@ -0,0 +1,86 @@
+import { Router } from 'express';
+import type { Store } from '../store.js';
+import type { AuthedRequest } from '../auth.js';
+import { requireAuth } from '../auth.js';
+import { getDocumentRole, getFolderRole } from '../permissions.js';
+import { isRole, roleAtLeast } from '../types.js';
+import type { Role, TargetType } from '../types.js';
+import { BadRequestError, ForbiddenError, NotFoundError } from '../errors.js';
+import { logActivity } from '../activity.js';
+import { serializeDocument, serializeFolder } from '../serialize.js';
+
+function getResource(store: Store, type: TargetType, id: string) {
+  return type === 'folder' ? store.folders.get(id) : store.documents.get(id);
+}
+
+function getRole(store: Store, type: TargetType, id: string, userId: string): Role | null {
+  return type === 'folder'
+    ? getFolderRole(store, id, userId)
+    : getDocumentRole(store, id, userId);
+}
+
+function serialize(type: TargetType, resource: ReturnType<typeof getResource>) {
+  if (!resource) return resource;
+  return type === 'folder'
+    ? serializeFolder(resource as Parameters<typeof serializeFolder>[0])
+    : serializeDocument(resource as Parameters<typeof serializeDocument>[0]);
+}
+
+function shareHandler(store: Store, type: TargetType) {
+  return (req: AuthedRequest, res: import('express').Response): void => {
+    const userId = req.userId as string;
+    const resource = getResource(store, type, req.params.id);
+    if (!resource) throw new NotFoundError(`${type} not found`);
+    const requesterRole = getRole(store, type, resource.id, userId);
+    if (!roleAtLeast(requesterRole, 'editor')) {
+      throw new ForbiddenError('insufficient permission to share');
+    }
+    const { userId: targetUserId, role } = req.body as { userId?: unknown; role?: unknown };
+    if (typeof targetUserId !== 'string' || targetUserId.trim() === '') {
+      throw new BadRequestError('userId is required');
+    }
+    if (!isRole(role)) {
+      throw new BadRequestError('role must be one of viewer, editor, owner');
+    }
+    if (!store.users.has(targetUserId)) {
+      throw new NotFoundError('target user not found');
+    }
+    if (role === 'owner' && requesterRole !== 'owner') {
+      throw new ForbiddenError('only an owner can grant owner role');
+    }
+    resource.shares.set(targetUserId, role);
+    logActivity(store, 'share.create', userId, type, resource.id, { targetUserId, role });
+    res.status(200).json(serialize(type, resource));
+  };
+}
+
+function unshareHandler(store: Store, type: TargetType) {
+  return (req: AuthedRequest, res: import('express').Response): void => {
+    const userId = req.userId as string;
+    const resource = getResource(store, type, req.params.id);
+    if (!resource) throw new NotFoundError(`${type} not found`);
+    const requesterRole = getRole(store, type, resource.id, userId);
+    if (!roleAtLeast(requesterRole, 'owner')) {
+      throw new ForbiddenError('only an owner can revoke access');
+    }
+    const targetUserId = req.params.userId;
+    if (!resource.shares.has(targetUserId)) {
+      throw new NotFoundError('share not found');
+    }
+    resource.shares.delete(targetUserId);
+    logActivity(store, 'share.revoke', userId, type, resource.id, { targetUserId });
+    res.status(204).send();
+  };
+}
+
+export function shareRoutes(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  router.post('/folders/:id/share', shareHandler(store, 'folder'));
+  router.post('/documents/:id/share', shareHandler(store, 'document'));
+  router.delete('/folders/:id/share/:userId', unshareHandler(store, 'folder'));
+  router.delete('/documents/:id/share/:userId', unshareHandler(store, 'document'));
+
+  return router;
+}
