+import { Router } from 'express';
+import type { Store } from '../store.js';
+import type { AuthedRequest } from '../auth.js';
+import { requireAuth } from '../auth.js';
+import { getDocumentRole, getFolderRole } from '../permissions.js';
+import { roleAtLeast } from '../types.js';
+
+export function activityRoutes(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  router.get('/activity', (req: AuthedRequest, res) => {
+    const userId = req.userId as string;
+    const visible = store.activity.filter((entry) => {
+      if (entry.actorId === userId) return true;
+      const role =
+        entry.targetType === 'folder'
+          ? getFolderRole(store, entry.targetId, userId)
+          : getDocumentRole(store, entry.targetId, userId);
+      return roleAtLeast(role, 'viewer');
+    });
+    const sorted = [...visible].sort((a, b) => (a.timestamp < b.timestamp ? 1 : -1));
+    res.status(200).json(sorted);
+  });
+
+  return router;
+}
