+import { Router } from 'express';
+import type { Store } from '../store.js';
+import { newId } from '../store.js';
+import type { AuthedRequest } from '../auth.js';
+import { requireAuth } from '../auth.js';
+import { getDocumentRole, getFolderRole } from '../permissions.js';
+import { roleAtLeast } from '../types.js';
+import { BadRequestError, ForbiddenError, NotFoundError } from '../errors.js';
+import { logActivity } from '../activity.js';
+import { serializeDocument } from '../serialize.js';
+
+export function documentRoutes(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  router.post('/folders/:folderId/documents', (req: AuthedRequest, res) => {
+    const userId = req.userId as string;
+    const folder = store.folders.get(req.params.folderId);
+    if (!folder) throw new NotFoundError('folder not found');
+    if (!roleAtLeast(getFolderRole(store, folder.id, userId), 'editor')) {
+      throw new ForbiddenError('insufficient permission on folder');
+    }
+    const { title, content } = req.body as { title?: unknown; content?: unknown };
+    if (typeof title !== 'string' || title.trim() === '') {
+      throw new BadRequestError('title is required');
+    }
+    if (typeof content !== 'string') {
+      throw new BadRequestError('content is required');
+    }
+    const id = newId();
+    const now = new Date().toISOString();
+    store.documents.set(id, {
+      id,
+      title,
+      content,
+      folderId: folder.id,
+      ownerId: userId,
+      shares: new Map(),
+      createdAt: now,
+      updatedAt: now,
+    });
+    logActivity(store, 'document.create', userId, 'document', id);
+    res.status(201).json(serializeDocument(store.documents.get(id)!));
+  });
+
+  router.get('/documents/:id', (req: AuthedRequest, res) => {
+    const userId = req.userId as string;
+    const document = store.documents.get(req.params.id);
+    if (!document) throw new NotFoundError('document not found');
+    if (!roleAtLeast(getDocumentRole(store, document.id, userId), 'viewer')) {
+      throw new ForbiddenError('insufficient permission');
+    }
+    res.status(200).json(serializeDocument(document));
+  });
+
+  router.put('/documents/:id', (req: AuthedRequest, res) => {
+    const userId = req.userId as string;
+    const document = store.documents.get(req.params.id);
+    if (!document) throw new NotFoundError('document not found');
+    if (!roleAtLeast(getDocumentRole(store, document.id, userId), 'editor')) {
+      throw new ForbiddenError('insufficient permission');
+    }
+    const { title, content } = req.body as { title?: unknown; content?: unknown };
+    if (title === undefined && content === undefined) {
+      throw new BadRequestError('nothing to update');
+    }
+    if (title !== undefined) {
+      if (typeof title !== 'string' || title.trim() === '') {
+        throw new BadRequestError('title must be a non-empty string');
+      }
+      document.title = title;
+    }
+    if (content !== undefined) {
+      if (typeof content !== 'string') throw new BadRequestError('content must be a string');
+      document.content = content;
+    }
+    document.updatedAt = new Date().toISOString();
+    logActivity(store, 'document.update', userId, 'document', document.id);
+    res.status(200).json(serializeDocument(document));
+  });
+
+  router.delete('/documents/:id', (req: AuthedRequest, res) => {
+    const userId = req.userId as string;
+    const document = store.documents.get(req.params.id);
+    if (!document) throw new NotFoundError('document not found');
+    if (!roleAtLeast(getDocumentRole(store, document.id, userId), 'owner')) {
+      throw new ForbiddenError('insufficient permission');
+    }
+    store.documents.delete(document.id);
+    logActivity(store, 'document.delete', userId, 'document', document.id);
+    res.status(204).send();
+  });
+
+  return router;
+}
