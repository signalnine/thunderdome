);\n    expect(res.status).toBe(200);\n    expect(res.body.shares[bob.id]).toBe('editor');\n  });\n\n  it('a viewer-only user cannot share', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const bob = await registerAndLogin(app, 'bob');\n    const carol = await registerAndLogin(app, 'carol');\n    const folder = await makeFolder(alice.token);\n    await request(app)\n      .post(`/folders/${folder.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: bob.id, role: 'viewer' });\n    const res = await request(app)\n      .post(`/folders/${folder.id}/share`)\n      .set(auth(bob.token))\n      .send({ userId: carol.id, role: 'viewer' });\n    expect(res.status).toBe(403);\n  });\n\n  it('an editor can grant viewer/editor but not owner role', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const bob = await registerAndLogin(app, 'bob');\n    const carol = await registerAndLogin(app, 'carol');\n    const folder = await makeFolder(alice.token);\n    await request(app)\n      .post(`/folders/${folder.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: bob.id, role: 'editor' });\n\n    const grantViewer = await request(app)\n      .post(`/folders/${folder.id}/share`)\n      .set(auth(bob.token))\n      .send({ userId: carol.id, role: 'viewer' });\n    expect(grantViewer.status).toBe(200);\n\n    const grantOwner = await request(app)\n      .post(`/folders/${folder.id}/share`)\n      .set(auth(bob.token))\n      .send({ userId: carol.id, role: 'owner' });\n    expect(grantOwner.status).toBe(403);\n  });\n\n  it('rejects an invalid role string', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const bob = await registerAndLogin(app, 'bob');\n    const folder = await makeFolder(alice.token);\n    const res = await request(app)\n      .post(`/folders/${folder.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: bob.id, role: 'superadmin' });\n    expect(res.status).toBe(400);\n  });\n\n  it('rejects sharing with a nonexistent target user', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const folder = await makeFolder(alice.token);\n    const res = await request(app)\n      .post(`/folders/${folder.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: 'ghost-user', role: 'viewer' });\n    expect(res.status).toBe(404);\n  });\n\n  it('effective permission is the most permissive across multiple paths', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const bob = await registerAndLogin(app, 'bob');\n    const folder = await makeFolder(alice.token);\n    const doc = await request(app)\n      .post(`/folders/${folder.id}/documents`)\n      .set(auth(alice.token))\n      .send({ title: 'Doc', content: 'hi' });\n\n    await request(app)\n      .post(`/folders/${folder.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: bob.id, role: 'viewer' });\n    await request(app)\n      .post(`/documents/${doc.body.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: bob.id, role: 'editor' });\n\n    const editRes = await request(app)\n      .put(`/documents/${doc.body.id}`)\n      .set(auth(bob.token))\n      .send({ content: 'edited because effective role is editor' });\n    expect(editRes.status).toBe(200);\n  });\n\n  it('owner can revoke access via DELETE share', async () => {\n    const alice = await registerAndLogin(app, 'alice');\n    const bob = await registerAndLogin(app, 'bob');\n    const folder = await makeFolder(alice.token);\n    await request(app)\n      .post(`/folders/${folder.id}/share`)\n      .set(auth(alice.token))\n      .send({ userId: bob.id, role: 'viewer' });\n\n    const before = await request(app).get(`/folders/${folder.id}`).set(auth(bob.token));\n    expect(before.status).toBe(200);\n\n    const revoke = await request(app)\n      .delete(`/folders/${folder.id}/share/${bob.id}`)\n      .set(auth(alice.token));\n   