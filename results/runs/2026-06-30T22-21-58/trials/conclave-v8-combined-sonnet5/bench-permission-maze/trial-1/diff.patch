+++ b/src/permissions.ts
@@ -0,0 +1,46 @@
+import type { Store } from './store.js';
+import type { Document, Folder, Role } from './types.js';
+import { maxRole } from './types.js';
+
+export function getFolderRole(store: Store, folderId: string, userId: string): Role | null {
+  const folder = store.folders.get(folderId);
+  if (!folder) return null;
+  return resolveFolderRole(store, folder, userId);
+}
+
+function resolveFolderRole(store: Store, folder: Folder, userId: string): Role | null {
+  let role: Role | null = null;
+  if (folder.ownerId === userId) role = maxRole(role, 'owner');
+  const directShare = folder.shares.get(userId) ?? null;
+  role = maxRole(role, directShare);
+  if (folder.parentId) {
+    const parentRole = getFolderRole(store, folder.parentId, userId);
+    role = maxRole(role, parentRole);
+  }
+  return role;
+}
+
+export function getDocumentRole(store: Store, documentId: string, userId: string): Role | null {
+  const document = store.documents.get(documentId);
+  if (!document) return null;
+  return resolveDocumentRole(store, document, userId);
+}
+
+function resolveDocumentRole(store: Store, document: Document, userId: string): Role | null {
+  let role: Role | null = null;
+  if (document.ownerId === userId) role = maxRole(role, 'owner');
+  const directShare = document.shares.get(userId) ?? null;
+  role = maxRole(role, directShare);
+  const folderRole = getFolderRole(store, document.folderId, userId);
+  role = maxRole(role, folderRole);
+  return role;
+}
+
+export function isDescendantFolder(store: Store, ancestorId: string, candidateId: string): boolean {
+  let current = store.folders.get(candidateId);
+  while (current?.parentId) {
+    if (current.parentId === ancestorId) return true;
+    current = store.folders.get(current.parentId);
+  }
+  return false;
+}
