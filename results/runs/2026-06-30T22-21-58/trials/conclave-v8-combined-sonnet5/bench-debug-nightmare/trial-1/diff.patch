      { productId: 'SKU-1', quantity: 3, unitPrice: 10 },\n    ]);\n    const stock = inventoryService.getStock('SKU-1');\n    expect(stock?.available).toBe(7);\n    expect(stock?.reserved).toBe(3);\n  });\n\n  it('cancels a confirmed order', async () => {\n    inventoryService.setStock('SKU-1', 10);\n    await orderService.createOrder('O1', 'C1', [\n      { productId: 'SKU-1', quantity: 2, unitPrice: 10 },\n    ]);\n    const cancelled = await orderService.cancelOrder('O1', 'changed mind');\n    expect(cancelled?.status).toBe('cancelled');\n  });\n\n  it('releases stock when order is cancelled', async () => {\n    inventoryService.setStock('SKU-1', 10);\n    await orderService.createOrder('O1', 'C1', [\n      { productId: 'SKU-1', quantity: 4, unitPrice: 10 },\n    ]);\n    await orderService.cancelOrder('O1', 'changed mind');\n    const stock = inventoryService.getStock('SKU-1');\n    expect(stock?.available).toBe(10);\n    expect(stock?.reserved).toBe(0);\n  });\n\n  it('refuses to cancel a non-confirmed order', async () => {\n    inventoryService.setStock('SKU-1', 10);\n    await orderService.createOrder('O1', 'C1', [\n      { productId: 'SKU-1', quantity: 1, unitPrice: 10 },\n    ]);\n    await orderService.cancelOrder('O1', 'first cancel');\n    // Try to cancel again — already cancelled\n    const result = await orderService.cancelOrder('O1', 'second cancel');\n    expect(result).toBeUndefined();\n  });\n\n  it('refunds a cancelled order within 30 days', async () => {\n    inventoryService.setStock('SKU-1', 10);\n    await orderService.createOrder('O1', 'C1', [\n      { productId: 'SKU-1', quantity: 1, unitPrice: 100 },\n    ]);\n    await orderService.cancelOrder('O1', 'not needed');\n    const refunded = await orderService.refundOrder('O1');\n    expect(refunded?.status).toBe('refunded');\n  });\n\n  it('allows refund on exactly day 30', async () => {\n    inventoryService.setStock('SKU-1', 10);\n    await orderService.createOrder('O1', 'C1', [\n      { productId: 'SKU-1', quantity: 1, unitPrice: 100 },\n    ]);\n    // Manually backdate the order to exactly 30 days ago\n    const thirtyDaysMs = 30 * 24 * 60 * 60 * 1000;\n    orderRepo.update('O1', { createdAt: Date.now() - thirtyDaysMs });\n    await orderService.cancelOrder('O1', 'late cancel');\n    const refunded = await orderService.refundOrder('O1');\n    expect(refunded?.status).toBe('refunded');\n  });\n\n  it('rejects refund after 30-day window', async () => {\n    inventoryService.setStock('SKU-1', 10);\n    await orderService.createOrder('O1', 'C1', [\n      { productId: 'SKU-1', quantity: 1, unitPrice: 100 },\n    ]);\n    // Backdate to 31 days ago\n    const thirtyOneDaysMs = 31 * 24 * 60 * 60 * 1000;\n    orderRepo.update('O1', { createdAt: Date.now() - thirtyOneDaysMs });\n    await orderService.cancelOrder('O1', 'very late');\n    await expect(orderService.refundOrder('O1')).rejects.toThrow('Refund window expired');\n  });\n});\n\ndescribe('OrderRepository', () => {\n  let repo: OrderRepository;\n\n  beforeEach(() => {\n    repo = new OrderRepository();\n  });\n\n  it('creates and retrieves an order', () => {\n    const order = repo.create({\n      id: 'O1',\n      customerId: 'C1',\n      items: [],\n      status: 'pending',\n      total: 0,\n      discount: 0,\n      taxRate: 0.1,\n      createdAt: Date.now(),\n      updatedAt: Date.now(),\n    });\n    expect(repo.findById('O1')).toEqual(order);\n  });\n\n  it('updates order preserves other fields', () => {\n    repo.create({\n      id: 'O1',\n      customerId: 'C1',\n      items: [{ productId: 'A', quantity: 1, unitPrice: 10 }],\n      status: 'pending',\n      total: 10,\n      discount: 0,\n      taxRate: 0.1,\n      createdAt: 1000,\n      updatedAt: 1000,\n      notes: 'rush delivery',\n    });\n    const updated = repo.update('O1', { status: 'confirmed' });\n    expect(updated?.status).toBe('confirmed');\n    expect(updated?.customerId).toBe('C1');\n    expect(updated?.notes).toBe('rush deliv