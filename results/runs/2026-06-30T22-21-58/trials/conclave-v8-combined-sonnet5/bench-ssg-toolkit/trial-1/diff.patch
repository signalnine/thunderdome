@@ -0,0 +1,84 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+interface Footnote {
+  num: number;
+  text: string;
+}
+
+function extractFootnoteDefinitions(text: string): { text: string; definitions: Map<string, string> } {
+  const definitions = new Map<string, string>();
+  const stripped = text.replace(/^\[\^([^\]]+)\]:\s*(.+)$/gm, (_match, id: string, body: string) => {
+    definitions.set(id, body.trim());
+    return '';
+  });
+  return { text: stripped, definitions };
+}
+
+function processFootnoteRefs(text: string, definitions: Map<string, string>): { text: string; footnotes: Footnote[] } {
+  const numbering = new Map<string, number>();
+  const footnotes: Footnote[] = [];
+  let nextNum = 1;
+
+  const replaced = text.replace(/\[\^([^\]]+)\]/g, (_match, id: string) => {
+    let num = numbering.get(id);
+    if (num === undefined) {
+      num = nextNum++;
+      numbering.set(id, num);
+      footnotes.push({ num, text: definitions.get(id) || '' });
+    }
+    return `<sup><a href="#fn-${num}">${num}</a></sup>`;
+  });
+
+  return { text: replaced, footnotes };
+}
+
+function processAdmonitions(text: string): { text: string; placeholders: Map<string, string> } {
+  const placeholders = new Map<string, string>();
+  let idx = 0;
+
+  const replaced = text.replace(/:::(note|warning|tip)\n([\s\S]*?):::/g, (_match, type: string, body: string) => {
+    const placeholder = `ADMONITIONPLACEHOLDER${idx++}`;
+    const innerHtml = marked.parse(body.trim()) as string;
+    placeholders.set(placeholder, `<div class="admonition admonition-${type}">${innerHtml}</div>`);
+    return `\n\n${placeholder}\n\n`;
+  });
+
+  return { text: replaced, placeholders };
+}
+
+function renderFootnoteSection(footnotes: Footnote[]): string {
+  const items = footnotes
+    .sort((a, b) => a.num - b.num)
+    .map(f => `<li id="fn-${f.num}">${f.text}</li>`)
+    .join('\n');
+  return `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        const { text: withoutDefs, definitions } = extractFootnoteDefinitions(file.content);
+        const { text: withFootnoteRefs, footnotes } = processFootnoteRefs(withoutDefs, definitions);
+        const { text: withPlaceholders, placeholders } = processAdmonitions(withFootnoteRefs);
+
+        let html = marked.parse(withPlaceholders) as string;
+
+        for (const [placeholder, divHtml] of placeholders) {
+          html = html.replace(new RegExp(`<p>\\s*${placeholder}\\s*</p>`), divHtml);
+          html = html.replace(placeholder, divHtml);
+        }
+
+        if (footnotes.length > 0) {
+          html += renderFootnoteSection(footnotes);
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
new file mode 100644
