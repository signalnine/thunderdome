+import { BuildContext, Plugin } from '../core/types.js';
+
+function isSitemapEntry(key: string): boolean {
+  return key.endsWith('.html') || key === 'feed.xml';
+}
+
+export function createSitemapPlugin(): Plugin {
+  return {
+    name: 'sitemap',
+    version: '1.0.0',
+    dependencies: ['taxonomy', 'rss-feed'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const urls = [...ctx.output.keys()]
+          .filter(isSitemapEntry)
+          .map(key => `<url><loc>${ctx.config.baseUrl}/${key}</loc></url>`)
+          .join('\n');
+
+        const xml = `<?xml version="1.0" encoding="UTF-8"?>
+<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
+${urls}
+</urlset>`;
+
+        ctx.output.set('sitemap.xml', xml);
+      },
+    },
+  };
+}
