+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,49 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+const ASSET_ATTR_REGEX = /(src|href)="([^"]+)"/g;
+
+function isAlreadyHandled(url: string): boolean {
+  return /^https?:\/\//.test(url) || url.startsWith('/assets/');
+}
+
+function toAssetPath(url: string): string {
+  return url.replace(/^\.\//, '');
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext): ContentFile => {
+        const discovered: string[] = [];
+
+        const content = file.content.replace(ASSET_ATTR_REGEX, (match, attr: string, url: string) => {
+          if (isAlreadyHandled(url)) {
+            return match;
+          }
+          const assetPath = toAssetPath(url);
+          discovered.push(assetPath);
+          return `${attr}="/assets/${assetPath}"`;
+        });
+
+        if (discovered.length > 0) {
+          const manifest = (ctx.data.get('asset-manifest') as AssetManifest | undefined) || { assets: [] };
+          for (const asset of discovered) {
+            if (!manifest.assets.includes(asset)) {
+              manifest.assets.push(asset);
+            }
+          }
+          ctx.data.set('asset-manifest', manifest);
+        }
+
+        return { ...file, content };
+      },
+    },
+  };
+}
