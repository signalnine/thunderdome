+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function stripHtml(html: string): string {
+  return html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
+}
+
+interface SearchIndexEntry {
+  slug: string;
+  title: string;
+  content: string;
+  tags?: string[];
+}
+
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const index: SearchIndexEntry[] = ctx.files.map((file: ContentFile) => ({
+          slug: file.slug,
+          title: file.title,
+          content: stripHtml(file.content),
+          ...(file.tags ? { tags: file.tags } : {}),
+        }));
+        ctx.output.set('search-index.json', JSON.stringify(index));
+      },
+    },
+  };
+}
