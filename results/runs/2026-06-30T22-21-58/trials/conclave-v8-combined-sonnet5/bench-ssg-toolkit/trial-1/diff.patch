--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,48 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function rfc822(dateStr: string): string {
+  return new Date(dateStr).toUTCString();
+}
+
+function renderItem(file: ContentFile, baseUrl: string): string {
+  const link = `${baseUrl}/${file.slug}.html`;
+  const pubDate = file.date ? `\n<pubDate>${rfc822(file.date)}</pubDate>` : '';
+  const categories = (file.tags || []).map(tag => `\n<category>${tag}</category>`).join('');
+  return `<item>
+<title>${file.title}</title>
+<link>${link}</link>
+<guid>${link}</guid>${pubDate}
+<description><![CDATA[${file.content}]]></description>${categories}
+</item>`;
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const sorted = [...ctx.files].sort((a, b) => {
+          const aTime = a.date ? new Date(a.date).getTime() : 0;
+          const bTime = b.date ? new Date(b.date).getTime() : 0;
+          return bTime - aTime;
+        });
+
+        const items = sorted.map(file => renderItem(file, ctx.config.baseUrl)).join('\n');
+
+        const xml = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+<channel>
+<title>${ctx.config.title}</title>
+<link>${ctx.config.baseUrl}</link>
+<description>${ctx.config.title}</description>
+${items}
+</channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', xml);
+      },
+    },
+  };
+}
