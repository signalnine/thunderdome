hor, dependencies = @dependencies,\n         entryPoint = @entryPoint, permissions = @permissions WHERE name = @name AND version = @version`\n      ).run({\n        name,\n        version,\n        description: merged.description,\n        author: merged.author,\n        dependencies: JSON.stringify(merged.dependencies),\n        entryPoint: merged.entryPoint,\n        permissions: JSON.stringify(merged.permissions),\n      });\n    },\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":631,"cache_read_input_tokens":49787,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":631},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"309069a7-0990-4b6a-9234-4057e4617e1b","uuid":"a0a31cdd-abf5-4080-a334-0a3ab76ead8b","request_id":"req_011CcaEFCqPJQMfj4LooNh4P"}
