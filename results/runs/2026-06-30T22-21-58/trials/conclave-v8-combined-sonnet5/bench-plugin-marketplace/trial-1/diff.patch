+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+function buildNode(name: string, registry: RegistryService, ancestors: Set<string>): DependencyNode {
+  const manifest = registry.get(name);
+  const version = manifest?.version ?? '';
+
+  if (ancestors.has(name)) {
+    return { name, version, dependencies: [] };
+  }
+
+  const nextAncestors = new Set(ancestors).add(name);
+  const dependencies = manifest
+    ? Object.keys(manifest.dependencies).map(dep => buildNode(dep, registry, nextAncestors))
+    : [];
+
+  return { name, version, dependencies };
+}
+
+function dfsCycles(
+  name: string,
+  registry: RegistryService,
+  path: string[],
+  onStack: Set<string>,
+  visited: Set<string>,
+  cycles: string[][]
+): void {
+  if (onStack.has(name)) {
+    const idx = path.indexOf(name);
+    cycles.push([...path.slice(idx), name]);
+    return;
+  }
+  if (visited.has(name)) {
+    return;
+  }
+
+  const manifest = registry.get(name);
+  path.push(name);
+  onStack.add(name);
+
+  if (manifest) {
+    for (const dep of Object.keys(manifest.dependencies)) {
+      dfsCycles(dep, registry, path, onStack, visited, cycles);
+    }
+  }
+
+  onStack.delete(name);
+  path.pop();
+  visited.add(name);
+}
+
+function topoDfs(name: string, registry: RegistryService, visited: Set<string>, order: string[]): void {
+  if (visited.has(name)) {
+    return;
+  }
+  visited.add(name);
+  const manifest = registry.get(name);
+  if (manifest) {
+    for (const dep of Object.keys(manifest.dependencies)) {
+      topoDfs(dep, registry, visited, order);
+    }
+  }
+  order.push(name);
+}
+
+function flattenDfs(name: string, registry: RegistryService, visited: Set<string>, result: string[]): void {
+  if (visited.has(name)) {
+    return;
+  }
+  visited.add(name);
+  result.push(name);
+  const manifest = registry.get(name);
+  if (manifest) {
+    for (const dep of Object.keys(manifest.dependencies)) {
+      flattenDfs(dep, registry, visited, result);
+    }
+  }
+}
+
+export function createDepsService(): DepsService {
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      return buildNode(name, registry, new Set());
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const cycles: string[][] = [];
+      dfsCycles(name, registry, [], new Set(), new Set(), cycles);
+      return cycles.length > 0 ? cycles : null;
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const visited = new Set<string>();
+      const order: string[] = [];
+      topoDfs(name, registry, visited, order);
+      return order;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const visited = new Set<string>([name]);
+      const result: string[] = [];
+      const manifest = registry.get(name);
+      if (manifest) {
+        for (const dep of Object.keys(manifest.dependencies)) {
+          flattenDfs(dep, registry, visited, result);
+        }
+      }
+      return result;
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return this.detectCycles(name, registry) !== null;
+    },
+  };
+}
