@@ -0,0 +1,199 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import { createDocumentStore } from '../src/index.js';
+import type { DocumentStore } from '../src/types.js';
+
+describe('Merging', () => {
+  let store: DocumentStore;
+
+  beforeEach(() => {
+    store = createDocumentStore();
+    store.create('doc1', { a: 1, b: { c: 2, d: 3 } });
+    store.createBranch('feature');
+  });
+
+  it('is a no-op fast-forward when neither branch changed', () => {
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged).toEqual({});
+  });
+
+  it('auto-applies a change made only on the source branch', () => {
+    store.switchBranch('feature');
+    store.update('doc1', { a: 1, b: { c: 99, d: 3 } });
+    store.switchBranch('main');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged.doc1).toEqual({ a: 1, b: { c: 99, d: 3 } });
+    expect(store.get('doc1')).toEqual({ a: 1, b: { c: 99, d: 3 } });
+  });
+
+  it('keeps a change made only on the target branch', () => {
+    store.update('doc1', { a: 1, b: { c: 2, d: 77 } });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged.doc1).toEqual({ a: 1, b: { c: 2, d: 77 } });
+    expect(store.get('doc1')).toEqual({ a: 1, b: { c: 2, d: 77 } });
+  });
+
+  it('does not conflict when both branches make the identical change', () => {
+    store.update('doc1', { a: 1, b: { c: 2, d: 100 } });
+    store.switchBranch('feature');
+    store.update('doc1', { a: 1, b: { c: 2, d: 100 } });
+    store.switchBranch('main');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged.doc1).toEqual({ a: 1, b: { c: 2, d: 100 } });
+  });
+
+  it('reports a conflict when both branches change the same field differently', () => {
+    store.update('doc1', { a: 1, b: { c: 'ours', d: 3 } });
+    store.switchBranch('feature');
+    store.update('doc1', { a: 1, b: { c: 'theirs', d: 3 } });
+    store.switchBranch('main');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts).toHaveLength(1);
+    expect(result.conflicts[0]).toMatchObject({
+      documentId: 'doc1',
+      path: 'b.c',
+      base: 2,
+      ours: 'ours',
+      theirs: 'theirs',
+    });
+  });
+
+  it('leaves the target branch unchanged when there are conflicts', () => {
+    store.update('doc1', { a: 1, b: { c: 'ours', d: 3 } });
+    store.switchBranch('feature');
+    store.update('doc1', { a: 1, b: { c: 'theirs', d: 3 } });
+    store.switchBranch('main');
+
+    store.merge('feature');
+    expect(store.get('doc1')).toEqual({ a: 1, b: { c: 'ours', d: 3 } });
+  });
+
+  it('reports nested dot-separated paths for conflicts', () => {
+    store.create('doc2', { x: { y: { z: 1 } } });
+    store.createBranch('feature2');
+
+    store.update('doc2', { x: { y: { z: 'ours' } } });
+    store.switchBranch('feature2');
+    store.update('doc2', { x: { y: { z: 'theirs' } } });
+    store.switchBranch('main');
+
+    const result = store.merge('feature2');
+    expect(result.conflicts.find((c) => c.documentId === 'doc2')).toMatchObject({
+      path: 'x.y.z',
+      base: 1,
+      ours: 'ours',
+      theirs: 'theirs',
+    });
+  });
+
+  it('merges non-conflicting fields alongside a conflicting field in the same document', () => {
+    store.update('doc1', { a: 'ours-change', b: { c: 'conflict-ours', d: 3 } });
+    store.switchBranch('feature');
+    store.update('doc1', { a: 'ours-change', b: { c: 'conflict-theirs', d: 'theirs-change' } });
+    store.switchBranch('main');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts).toHaveLength(1);
+    expect(result.conflicts[0].path).toBe('b.c');
+    // merged shows ours resolution, but the non-conflicting theirs-only change to b.d is incorporated
+    expect(result.merged.doc1).toEqual({
+      a: 'ours-change',
+      b: { c: 'conflict-ours', d: 'theirs-change' },
+    });
+  });
+
+  it('handles multiple independent documents changed on different branches with no conflicts', () => {
+    store.create('doc2', { v: 'base2' });
+    store.createBranch('feature3');
+
+    store.update('doc1', { a: 'main-change', b: { c: 2, d: 3 } });
+    store.switchBranch('feature3');
+    store.update('doc2', { v: 'feature-change2' });
+    store.switchBranch('main');
+
+    const result = store.merge('feature3');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(store.get('doc1')).toEqual({ a: 'main-change', b: { c: 2, d: 3 } });
+    expect(store.get('doc2')).toEqual({ v: 'feature-change2' });
+  });
+
+  it('conflicts when a document is independently created with the same id on both branches', () => {
+    store.switchBranch('feature');
+    store.create('newdoc', { from: 'feature' });
+    store.switchBranch('main');
+    store.create('newdoc', { from: 'main' });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    const conflict = result.conflicts.find((c) => c.documentId === 'newdoc');
+    expect(conflict).toBeDefined();
+    expect(conflict?.ours).toEqual({ from: 'main' });
+    expect(conflict?.theirs).toEqual({ from: 'feature' });
+  });
+
+  it('applies a deletion made on the source branch when target is unchanged', () => {
+    store.switchBranch('feature');
+    store.delete('doc1');
+    store.switchBranch('main');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(() => store.get('doc1')).toThrow();
+  });
+
+  it('conflicts when one branch deletes a document the other branch modified', () => {
+    store.switchBranch('feature');
+    store.delete('doc1');
+    store.switchBranch('main');
+    store.update('doc1', { a: 'changed', b: { c: 2, d: 3 } });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts.some((c) => c.documentId === 'doc1')).toBe(true);
+    // target unchanged after a conflicting merge
+    expect(store.get('doc1')).toEqual({ a: 'changed', b: { c: 2, d: 3 } });
+  });
+
+  it('throws when merging from a nonexistent branch', () => {
+    expect(() => store.merge('nonexistent')).toThrow();
+  });
+
+  it('does not conflict when both branches delete the same document', () => {
+    store.delete('doc1');
+    store.switchBranch('feature');
+    store.delete('doc1');
+    store.switchBranch('main');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(() => store.get('doc1')).toThrow();
+  });
+
+  it('does not conflict when both branches independently create the same id with identical content', () => {
+    store.switchBranch('feature');
+    store.create('twin', { same: true });
+    store.switchBranch('main');
+    store.create('twin', { same: true });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged.twin).toEqual({ same: true });
+  });
+});
