+++ b/src/index.ts
@@ -0,0 +1,262 @@
+import { randomUUID } from 'node:crypto';
+import { deepClone, deepEqual } from './clone.js';
+import { mergeValue, type FieldConflict } from './diff3.js';
+import type { Conflict, DocumentStore, MergeResult, Version } from './types.js';
+
+export type { DocumentStore, Version, Conflict, MergeResult } from './types.js';
+
+interface VersionRecord {
+  id: string;
+  timestamp: number;
+  content: object;
+  parentVersionId: string | null;
+}
+
+interface Branch {
+  name: string;
+  parent: string | null;
+  // docId -> active version id, or null if the document was deleted on this branch.
+  heads: Map<string, string | null>;
+  // docId -> most recent version id this branch ever pointed to (kept across deletes
+  // so re-creation continues the same history chain and merges can find common ancestors).
+  lastVersion: Map<string, string>;
+}
+
+const MAIN_BRANCH = 'main';
+
+export class DocumentStoreImpl implements DocumentStore {
+  private versions = new Map<string, Map<string, VersionRecord>>();
+  private branches = new Map<string, Branch>();
+  private currentBranchName = MAIN_BRANCH;
+
+  constructor() {
+    this.branches.set(MAIN_BRANCH, {
+      name: MAIN_BRANCH,
+      parent: null,
+      heads: new Map(),
+      lastVersion: new Map(),
+    });
+  }
+
+  create(id: string, content: object): void {
+    const branch = this.currentBranch();
+    if (branch.heads.get(id)) {
+      throw new Error(`Document "${id}" already exists on branch "${branch.name}"`);
+    }
+    const parentVersionId = branch.lastVersion.get(id) ?? null;
+    const versionId = this.recordVersion(id, content, parentVersionId);
+    branch.heads.set(id, versionId);
+    branch.lastVersion.set(id, versionId);
+  }
+
+  get(id: string): object {
+    const branch = this.currentBranch();
+    const versionId = branch.heads.get(id);
+    if (!versionId) {
+      throw new Error(`Document "${id}" not found on branch "${branch.name}"`);
+    }
+    return deepClone(this.versionRecord(id, versionId).content);
+  }
+
+  update(id: string, content: object): void {
+    const branch = this.currentBranch();
+    const versionId = branch.heads.get(id);
+    if (!versionId) {
+      throw new Error(`Document "${id}" not found on branch "${branch.name}"`);
+    }
+    const newVersionId = this.recordVersion(id, content, versionId);
+    branch.heads.set(id, newVersionId);
+    branch.lastVersion.set(id, newVersionId);
+  }
+
+  delete(id: string): void {
+    const branch = this.currentBranch();
+    if (!branch.heads.get(id)) {
+      throw new Error(`Document "${id}" not found on branch "${branch.name}"`);
+    }
+    branch.heads.set(id, null);
+  }
+
+  getHistory(id: string): Version[] {
+    const branch = this.currentBranch();
+    const startVersionId = branch.heads.get(id) ?? branch.lastVersion.get(id);
+    if (!startVersionId) {
+      throw new Error(`Document "${id}" not found on branch "${branch.name}"`);
+    }
+    const docVersions = this.versions.get(id)!;
+    const chain: Version[] = [];
+    let cursor: string | null = startVersionId;
+    while (cursor) {
+      const record: VersionRecord = docVersions.get(cursor)!;
+      chain.push({ id: record.id, timestamp: record.timestamp, content: deepClone(record.content) });
+      cursor = record.parentVersionId;
+    }
+    return chain.reverse();
+  }
+
+  getVersion(id: string, versionId: string): object {
+    return deepClone(this.versionRecord(id, versionId).content);
+  }
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const sourceName = fromBranch ?? this.currentBranchName;
+    const source = this.branches.get(sourceName);
+    if (!source) {
+      throw new Error(`Branch "${sourceName}" not found`);
+    }
+    this.branches.set(name, {
+      name,
+      parent: sourceName,
+      heads: new Map(source.heads),
+      lastVersion: new Map(source.lastVersion),
+    });
+  }
+
+  switchBranch(name: string): void {
+    if (!this.branches.has(name)) {
+      throw new Error(`Branch "${name}" not found`);
+    }
+    this.currentBranchName = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranchName;
+  }
+
+  listBranches(): string[] {
+    return Array.from(this.branches.keys());
+  }
+
+  merge(sourceBranchName: string): MergeResult {
+    const target = this.currentBranch();
+    const source = this.branches.get(sourceBranchName);
+    if (!source) {
+      throw new Error(`Branch "${sourceBranchName}" not found`);
+    }
+
+    const docIds = new Set<string>([...target.lastVersion.keys(), ...source.lastVersion.keys()]);
+
+    const merged: Record<string, object> = {};
+    const conflicts: Conflict[] = [];
+    const plans = new Map<string, unknown>();
+
+    for (const docId of docIds) {
+      const targetActiveVersionId = target.heads.get(docId) ?? null;
+      const sourceActiveVersionId = source.heads.get(docId) ?? null;
+      const targetChainVersionId = targetActiveVersionId ?? target.lastVersion.get(docId) ?? null;
+      const sourceChainVersionId = sourceActiveVersionId ?? source.lastVersion.get(docId) ?? null;
+
+      const baseVersionId = this.findCommonAncestor(docId, targetChainVersionId, sourceChainVersionId);
+
+      const baseContent = baseVersionId ? deepClone(this.versionRecord(docId, baseVersionId).content) : undefined;
+      const oursContent = targetActiveVersionId
+        ? deepClone(this.versionRecord(docId, targetActiveVersionId).content)
+        : undefined;
+      const theirsContent = sourceActiveVersionId
+        ? deepClone(this.versionRecord(docId, sourceActiveVersionId).content)
+        : undefined;
+
+      if (deepEqual(oursContent, baseContent) && deepEqual(theirsContent, baseContent)) {
+        continue;
+      }
+
+      const docConflicts: FieldConflict[] = [];
+      const result = mergeValue('', baseContent, oursContent, theirsContent, docConflicts);
+
+      for (const c of docConflicts) {
+        conflicts.push({ documentId: docId, path: c.path, base: c.base, ours: c.ours, theirs: c.theirs });
+      }
+
+      if (result !== undefined) {
+        merged[docId] = result as object;
+      }
+      plans.set(docId, result);
+    }
+
+    const applied = conflicts.length === 0;
+
+    if (applied) {
+      for (const [docId, result] of plans) {
+        this.applyMergePlan(target, docId, result);
+      }
+    }
+
+    return { merged, conflicts, applied };
+  }
+
+  private currentBranch(): Branch {
+    return this.branches.get(this.currentBranchName)!;
+  }
+
+  private versionRecord(id: string, versionId: string): VersionRecord {
+    const record = this.versions.get(id)?.get(versionId);
+    if (!record) {
+      throw new Error(`Version "${versionId}" not found for document "${id}"`);
+    }
+    return record;
+  }
+
+  private recordVersion(id: string, content: object, parentVersionId: string | null): string {
+    let docVersions = this.versions.get(id);
+    if (!docVersions) {
+      docVersions = new Map();
+      this.versions.set(id, docVersions);
+    }
+    const record: VersionRecord = {
+      id: randomUUID(),
+      timestamp: Date.now(),
+      content: deepClone(content),
+      parentVersionId,
+    };
+    docVersions.set(record.id, record);
+    return record.id;
+  }
+
+  private findCommonAncestor(id: string, versionIdA: string | null, versionIdB: string | null): string | null {
+    if (!versionIdA || !versionIdB) return null;
+    const docVersions = this.versions.get(id);
+    if (!docVersions) return null;
+
+    const ancestorsOfA = new Set<string>();
+    let cursor: string | null = versionIdA;
+    while (cursor) {
+      ancestorsOfA.add(cursor);
+      cursor = docVersions.get(cursor)?.parentVersionId ?? null;
+    }
+
+    cursor = versionIdB;
+    while (cursor) {
+      if (ancestorsOfA.has(cursor)) return cursor;
+      cursor = docVersions.get(cursor)?.parentVersionId ?? null;
+    }
+    return null;
+  }
+
+  private applyMergePlan(target: Branch, docId: string, result: unknown): void {
+    const currentVersionId = target.heads.get(docId) ?? null;
+
+    if (result === undefined) {
+      if (currentVersionId) {
+        target.heads.set(docId, null);
+      }
+      return;
+    }
+
+    const currentContent = currentVersionId ? this.versionRecord(docId, currentVersionId).content : undefined;
+    if (currentVersionId && deepEqual(currentContent, result)) {
+      return;
+    }
+
+    const parentVersionId = currentVersionId ?? target.lastVersion.get(docId) ?? null;
+    const newVersionId = this.recordVersion(docId, result as object, parentVersionId);
+    target.heads.set(docId, newVersionId);
+    target.lastVersion.set(docId, newVersionId);
+  }
+}
+
+export function createDocumentStore(): DocumentStore {
+  return new DocumentStoreImpl();
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..f63cfe2
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,36 @@
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+export interface Conflict {
+  documentId: string;
+  path: string;
+  base: unknown;
+  ours: unknown;
+  theirs: unknown;
+}
+
+export interface MergeResult {
+  merged: Record<string, object>;
+  conflicts: Conflict[];
+  applied: boolean;
+}
+
+export interface DocumentStore {
+  create(id: string, content: object): void;
+  get(id: string): object;
+  update(id: string, content: object): void;
+  delete(id: string): void;
+
+  getHistory(id: string): Version[];
+  getVersion(id: string, versionId: string): object;
+
+  createBranch(name: string, fromBranch?: string): void;
+  switchBranch(name: string): void;
+  getBranch(): string;
+  listBranches(): string[];
+
+  merge(sourceBranch: string): MergeResult;
+}
diff --git a/tests/branching.test.ts b/tests/branching.test.ts
new file mode 100644
index 0000000..124a5e0
--- /dev/null
+++ b/tests/branching.test.ts
@@ -0,0 +1,74 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import { createDocumentStore } from '../src/index.js';
+import type { DocumentStore } from '../src/types.js';
+
+describe('Branching', () => {
+  let store: DocumentStore;
+
+  beforeEach(() => {
+    store = createDocumentStore();
+  });
+
+  it('defaults to the main branch', () => {
+    expect(store.getBranch()).toBe('main');
+  });
+
+  it('lists main as the only branch initially', () => {
+    expect(store.listBranches()).toEqual(['main']);
+  });
+
+  it('creates a branch from the current branch state', () => {
+    store.create('doc1', { v: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    expect(store.get('doc1')).toEqual({ v: 1 });
+  });
+
+  it('creates a branch from an explicit source branch', () => {
+    store.create('doc1', { v: 'main-1' });
+    store.createBranch('a');
+    store.switchBranch('a');
+    store.update('doc1', { v: 'a-1' });
+
+    // branch 'c' should come from main, not from 'a' (the current branch)
+    store.createBranch('c', 'main');
+    store.switchBranch('c');
+    expect(store.get('doc1')).toEqual({ v: 'main-1' });
+  });
+
+  it('lists all created branches', () => {
+    store.createBranch('a');
+    store.createBranch('b');
+    expect(store.listBranches().sort()).toEqual(['a', 'b', 'main']);
+  });
+
+  it('isolates changes between branches', () => {
+    store.create('doc1', { v: 'base' });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { v: 'feature-change' });
+
+    store.switchBranch('main');
+    expect(store.get('doc1')).toEqual({ v: 'base' });
+
+    store.switchBranch('feature');
+    expect(store.get('doc1')).toEqual({ v: 'feature-change' });
+  });
+
+  it('does not leak documents created on one branch to another', () => {
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.create('only-on-feature', { v: 1 });
+
+    store.switchBranch('main');
+    expect(() => store.get('only-on-feature')).toThrow();
+  });
+
+  it('throws when creating a branch from a nonexistent source branch', () => {
+    expect(() => store.createBranch('x', 'nonexistent')).toThrow();
+  });
+
+  it('throws when switching to a nonexistent branch', () => {
+    expect(() => store.switchBranch('nonexistent')).toThrow();
+  });
+});
diff --git a/tests/crud.test.ts b/tests/crud.test.ts
new file mode 100644
index 0000000..6063b30
--- /dev/null
+++ b/tests/crud.test.ts
@@ -0,0 +1,122 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import { createDocumentStore } from '../src/index.js';
+import type { DocumentStore } from '../src/types.js';
+
+describe('CRUD', () => {
+  let store: DocumentStore;
+
+  beforeEach(() => {
+    store = createDocumentStore();
+  });
+
+  it('creates and retrieves a document', () => {
+    store.create('doc1', { name: 'Alice' });
+    expect(store.get('doc1')).toEqual({ name: 'Alice' });
+  });
+
+  it('throws when creating a document with an existing id', () => {
+    store.create('doc1', { name: 'Alice' });
+    expect(() => store.create('doc1', { name: 'Bob' })).toThrow();
+  });
+
+  it('throws when getting an unknown document', () => {
+    expect(() => store.get('nope')).toThrow();
+  });
+
+  it('throws when getting a deleted document', () => {
+    store.create('doc1', { name: 'Alice' });
+    store.delete('doc1');
+    expect(() => store.get('doc1')).toThrow();
+  });
+
+  it('updates a document and reflects the new content', () => {
+    store.create('doc1', { name: 'Alice' });
+    store.update('doc1', { name: 'Bob' });
+    expect(store.get('doc1')).toEqual({ name: 'Bob' });
+  });
+
+  it('throws when updating an unknown document', () => {
+    expect(() => store.update('nope', { a: 1 })).toThrow();
+  });
+
+  it('throws when deleting an unknown document', () => {
+    expect(() => store.delete('nope')).toThrow();
+  });
+
+  it('allows recreating a document after it was deleted', () => {
+    store.create('doc1', { v: 1 });
+    store.delete('doc1');
+    store.create('doc1', { v: 2 });
+    expect(store.get('doc1')).toEqual({ v: 2 });
+  });
+
+  it('deep clones content on create so external mutation does not affect the store', () => {
+    const content = { nested: { a: 1 } };
+    store.create('doc1', content);
+    content.nested.a = 999;
+    expect(store.get('doc1')).toEqual({ nested: { a: 1 } });
+  });
+
+  it('deep clones content on get so mutating the result does not affect the store', () => {
+    store.create('doc1', { nested: { a: 1 } });
+    const got = store.get('doc1') as { nested: { a: number } };
+    got.nested.a = 999;
+    expect(store.get('doc1')).toEqual({ nested: { a: 1 } });
+  });
+});
+
+describe('Version History', () => {
+  let store: DocumentStore;
+
+  beforeEach(() => {
+    store = createDocumentStore();
+  });
+
+  it('creates a version on create and on each update', () => {
+    store.create('doc1', { v: 1 });
+    store.update('doc1', { v: 2 });
+    store.update('doc1', { v: 3 });
+    expect(store.getHistory('doc1')).toHaveLength(3);
+  });
+
+  it('versions have id, timestamp, and content', () => {
+    store.create('doc1', { v: 1 });
+    const [version] = store.getHistory('doc1');
+    expect(typeof version.id).toBe('string');
+    expect(version.id.length).toBeGreaterThan(0);
+    expect(typeof version.timestamp).toBe('number');
+    expect(version.content).toEqual({ v: 1 });
+  });
+
+  it('returns history oldest first', () => {
+    store.create('doc1', { v: 1 });
+    store.update('doc1', { v: 2 });
+    store.update('doc1', { v: 3 });
+    const history = store.getHistory('doc1');
+    expect(history.map((v) => v.content)).toEqual([{ v: 1 }, { v: 2 }, { v: 3 }]);
+    for (let i = 1; i < history.length; i++) {
+      expect(history[i].timestamp).toBeGreaterThanOrEqual(history[i - 1].timestamp);
+    }
+  });
+
+  it('versions have unique ids', () => {
+    store.create('doc1', { v: 1 });
+    store.update('doc1', { v: 2 });
+    const ids = store.getHistory('doc1').map((v) => v.id);
+    expect(new Set(ids).size).toBe(ids.length);
+  });
+
+  it('getVersion returns content at a specific point in history, unaffected by later updates', () => {
+    store.create('doc1', { v: 1 });
+    const [firstVersion] = store.getHistory('doc1');
+    store.update('doc1', { v: 2 });
+    store.update('doc1', { v: 3 });
+    expect(store.getVersion('doc1', firstVersion.id)).toEqual({ v: 1 });
+    expect(store.get('doc1')).toEqual({ v: 3 });
+  });
+
+  it('throws when getting an unknown version', () => {
+    store.create('doc1', { v: 1 });
+    expect(() => store.getVersion('doc1', 'bogus-version-id')).toThrow();
+  });
+});
