diff --git a/src/clone.ts b/src/clone.ts
new file mode 100644
index 0000000..cf0b4a4
--- /dev/null
+++ b/src/clone.ts
@@ -0,0 +1,31 @@
+export function deepClone<T>(value: T): T {
+  if (value === undefined || value === null) return value;
+  return JSON.parse(JSON.stringify(value)) as T;
+}
+
+export function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (typeof a !== typeof b) return false;
+  if (a === null || b === null) return false;
+  if (typeof a !== 'object' || typeof b !== 'object') return false;
+
+  const aIsArray = Array.isArray(a);
+  const bIsArray = Array.isArray(b);
+  if (aIsArray !== bIsArray) return false;
+
+  if (aIsArray && bIsArray) {
+    if (a.length !== b.length) return false;
+    return a.every((item, i) => deepEqual(item, b[i]));
+  }
+
+  const aObj = a as Record<string, unknown>;
+  const bObj = b as Record<string, unknown>;
+  const aKeys = Object.keys(aObj);
+  const bKeys = Object.keys(bObj);
+  if (aKeys.length !== bKeys.length) return false;
+  return aKeys.every((key) => Object.prototype.hasOwnProperty.call(bObj, key) && deepEqual(aObj[key], bObj[key]));
+}
+
+export function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
diff --git a/src/diff3.ts b/src/diff3.ts
new file mode 100644
index 0000000..1f747de
--- /dev/null
+++ b/src/diff3.ts
@@ -0,0 +1,46 @@
+import { deepEqual, isPlainObject } from './clone.js';
+
+export interface FieldConflict {
+  path: string;
+  base: unknown;
+  ours: unknown;
+  theirs: unknown;
+}
+
+/**
+ * Three-way structural merge of a single value (recursing through plain
+ * objects). Conflicts are resolved in favor of `ours` in the returned value,
+ * and also collected in `conflicts`.
+ */
+export function mergeValue(
+  path: string,
+  base: unknown,
+  ours: unknown,
+  theirs: unknown,
+  conflicts: FieldConflict[],
+): unknown {
+  if (isPlainObject(base) && isPlainObject(ours) && isPlainObject(theirs)) {
+    const keys = new Set([...Object.keys(base), ...Object.keys(ours), ...Object.keys(theirs)]);
+    const result: Record<string, unknown> = {};
+    for (const key of keys) {
+      const childPath = path ? `${path}.${key}` : key;
+      const merged = mergeValue(childPath, base[key], ours[key], theirs[key], conflicts);
+      if (merged !== undefined) {
+        result[key] = merged;
+      }
+    }
+    return result;
+  }
+
+  if (deepEqual(ours, theirs)) return ours;
+
+  const oursChanged = !deepEqual(base, ours);
+  const theirsChanged = !deepEqual(base, theirs);
+
+  if (oursChanged && !theirsChanged) return ours;
+  if (theirsChanged && !oursChanged) return theirs;
+  if (!oursChanged && !theirsChanged) return ours;
+
+  conflicts.push({ path, base, ours, theirs });
+  return ours;
+}
