+import Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import type { DocumentRecord, VersionRecord, Operation } from './models.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+
+export function createConnection(dbPath = ':memory:'): Database.Database {
+  const db = new Database(dbPath);
+  db.pragma('foreign_keys = ON');
+  const schemaPath = path.join(__dirname, '..', 'schema.sql');
+  const schema = fs.readFileSync(schemaPath, 'utf-8');
+  db.exec(schema);
+  return db;
+}
+
+export function generateId(): string {
+  return randomUUID();
+}
+
+export function createDocument(db: Database.Database, title: string, content: string): DocumentRecord {
+  const id = generateId();
+  db.prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?)').run(id, title, content);
+  db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)').run(
+    id,
+    content
+  );
+  return getDocument(db, id) as DocumentRecord;
+}
+
+export function listDocuments(db: Database.Database): DocumentRecord[] {
+  return db.prepare('SELECT * FROM documents ORDER BY created_at ASC').all() as DocumentRecord[];
+}
+
+export function getDocument(db: Database.Database, id: string): DocumentRecord | undefined {
+  return db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as DocumentRecord | undefined;
+}
+
+export function updateDocumentMeta(
+  db: Database.Database,
+  id: string,
+  updates: { title?: string; content?: string }
+): DocumentRecord | undefined {
+  const existing = getDocument(db, id);
+  if (!existing) return undefined;
+
+  const title = updates.title ?? existing.title;
+  const content = updates.content ?? existing.content;
+  db.prepare("UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?").run(
+    title,
+    content,
+    id
+  );
+  return getDocument(db, id);
+}
+
+export function deleteDocument(db: Database.Database, id: string): boolean {
+  const result = db.prepare('DELETE FROM documents WHERE id = ?').run(id);
+  return result.changes > 0;
+}
+
+export function getCurrentVersionNumber(db: Database.Database, documentId: string): number {
+  const row = db.prepare('SELECT MAX(version) as maxVersion FROM versions WHERE document_id = ?').get(
+    documentId
+  ) as { maxVersion: number | null };
+  return row.maxVersion ?? 0;
+}
+
+export function listVersions(db: Database.Database, documentId: string): VersionRecord[] {
+  return db.prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC').all(
+    documentId
+  ) as VersionRecord[];
+}
+
+export function getVersion(db: Database.Database, documentId: string, version: number): VersionRecord | undefined {
+  return db.prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?').get(
+    documentId,
+    version
+  ) as VersionRecord | undefined;
+}
+
+export function getOperationsSince(db: Database.Database, documentId: string, sinceVersion: number): Operation[] {
+  const rows = db
+    .prepare('SELECT operation FROM versions WHERE document_id = ? AND version > ? ORDER BY version ASC')
+    .all(documentId, sinceVersion) as { operation: string | null }[];
+  return rows.filter((row) => row.operation !== null).map((row) => JSON.parse(row.operation as string) as Operation);
+}
+
+export function applyAndStoreOperation(
+  db: Database.Database,
+  documentId: string,
+  newContent: string,
+  operation: Operation
+): number {
+  const nextVersion = getCurrentVersionNumber(db, documentId) + 1;
+  const insertVersion = db.prepare(
+    'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+  );
+  const updateDoc = db.prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?");
+  const txn = db.transaction(() => {
+    insertVersion.run(documentId, nextVersion, newContent, JSON.stringify(operation));
+    updateDoc.run(newContent, documentId);
+  });
+  txn();
+  return nextVersion;
+}
+
+export function addActiveConnection(db: Database.Database, connectionId: string, documentId: string): void {
+  db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(connectionId, documentId);
+}
+
+export function removeActiveConnection(db: Database.Database, connectionId: string): void {
+  db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);
+}
+
+export function clearActiveConnections(db: Database.Database): void {
+  db.exec('DELETE FROM active_connections');
+}
