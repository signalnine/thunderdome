index 0000000..7040b52
--- /dev/null
+++ b/src/ws.ts
@@ -0,0 +1,125 @@
+import { WebSocketServer, WebSocket } from 'ws';
+import { randomUUID } from 'node:crypto';
+import type { Server } from 'node:http';
+import type Database from 'better-sqlite3';
+import * as store from './db.js';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+import type { Operation } from './models.js';
+
+interface RoomClient {
+  ws: WebSocket;
+  connectionId: string;
+}
+
+function sendJson(ws: WebSocket, payload: Record<string, unknown>): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify(payload));
+  }
+}
+
+function isRawOperation(value: unknown): value is Operation {
+  if (typeof value !== 'object' || value === null) return false;
+  const candidate = value as Record<string, unknown>;
+  return candidate.type === 'insert' || candidate.type === 'delete';
+}
+
+export function attachWebSocketServer(server: Server, db: Database.Database): WebSocketServer {
+  const wss = new WebSocketServer({ noServer: true });
+  const rooms = new Map<string, Set<RoomClient>>();
+
+  server.on('upgrade', (request, socket, head) => {
+    const url = new URL(request.url ?? '/', 'http://localhost');
+    const docId = decodeURIComponent(url.pathname.replace(/^\//, ''));
+    wss.handleUpgrade(request, socket, head, (ws) => {
+      wss.emit('connection', ws, docId);
+    });
+  });
+
+  wss.on('connection', (ws: WebSocket, docId: string) => {
+    const doc = store.getDocument(db, docId);
+    if (!doc) {
+      sendJson(ws, { type: 'error', message: `Document not found: ${docId}` });
+      ws.close();
+      return;
+    }
+
+    const connectionId = randomUUID();
+    store.addActiveConnection(db, connectionId, docId);
+
+    let room = rooms.get(docId);
+    if (!room) {
+      room = new Set();
+      rooms.set(docId, room);
+    }
+    const client: RoomClient = { ws, connectionId };
+    room.add(client);
+
+    const version = store.getCurrentVersionNumber(db, docId);
+    sendJson(ws, { type: 'sync', content: doc.content, version });
+
+    ws.on('message', (data) => {
+      let parsed: unknown;
+      try {
+        parsed = JSON.parse(data.toString());
+      } catch {
+        sendJson(ws, { type: 'error', message: 'Malformed JSON' });
+        return;
+      }
+
+      if (typeof parsed !== 'object' || parsed === null) {
+        sendJson(ws, { type: 'error', message: 'Malformed message' });
+        return;
+      }
+
+      const message = parsed as { type?: unknown; operation?: unknown; version?: unknown };
+      if (message.type !== 'operation') {
+        sendJson(ws, { type: 'error', message: 'Unsupported message type' });
+        return;
+      }
+
+      if (!isRawOperation(message.operation)) {
+        sendJson(ws, { type: 'error', message: 'Invalid operation type' });
+        return;
+      }
+      const rawOp = message.operation;
+
+      const currentVersion = store.getCurrentVersionNumber(db, docId);
+      const clientVersion = typeof message.version === 'number' ? message.version : currentVersion;
+      const opsSince = store.getOperationsSince(db, docId, clientVersion);
+
+      let transformedOp: Operation = rawOp;
+      for (const pastOp of opsSince) {
+        transformedOp = transformOperation(transformedOp, pastOp);
+      }
+
+      const currentDoc = store.getDocument(db, docId);
+      const currentContent = currentDoc ? currentDoc.content : '';
+
+      if (!validateOperation(transformedOp, currentContent.length)) {
+        sendJson(ws, { type: 'error', message: 'Operation out of bounds' });
+        return;
+      }
+
+      const newContent = applyOperation(currentContent, transformedOp);
+      const newVersion = store.applyAndStoreOperation(db, docId, newContent, transformedOp);
+
+      sendJson(ws, { type: 'ack', version: newVersion, operation: transformedOp });
+
+      for (const other of room as Set<RoomClient>) {
+        if (other.ws !== ws) {
+          sendJson(other.ws, { type: 'operation', operation: transformedOp, version: newVersion });
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      room?.delete(client);
+      if (room && room.size === 0) {
+        rooms.delete(docId);
+      }
+      store.removeActiveConnection(db, connectionId);
+    });
+  });
+
+  return wss;
+}
