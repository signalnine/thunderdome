@@ -0,0 +1,84 @@
+import { Router } from 'express';
+import type Database from 'better-sqlite3';
+import * as store from './db.js';
+
+export function createRoutes(db: Database.Database): Router {
+  const router = Router();
+
+  router.post('/docs', (req, res) => {
+    const body = (req.body ?? {}) as { title?: unknown; content?: unknown };
+    if (typeof body.title !== 'string' || body.title.trim() === '') {
+      res.status(400).json({ error: 'title is required' });
+      return;
+    }
+    const content = typeof body.content === 'string' ? body.content : '';
+    const doc = store.createDocument(db, body.title, content);
+    res.status(201).json(doc);
+  });
+
+  router.get('/docs', (_req, res) => {
+    res.json(store.listDocuments(db));
+  });
+
+  router.get('/docs/:id', (req, res) => {
+    const doc = store.getDocument(db, req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  router.put('/docs/:id', (req, res) => {
+    const body = (req.body ?? {}) as { title?: unknown; content?: unknown };
+    const updates: { title?: string; content?: string } = {};
+    if (typeof body.title === 'string') updates.title = body.title;
+    if (typeof body.content === 'string') updates.content = body.content;
+
+    const doc = store.updateDocumentMeta(db, req.params.id, updates);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  router.delete('/docs/:id', (req, res) => {
+    const deleted = store.deleteDocument(db, req.params.id);
+    if (!deleted) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    res.status(204).end();
+  });
+
+  router.get('/docs/:id/versions', (req, res) => {
+    const doc = store.getDocument(db, req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    res.json(store.listVersions(db, req.params.id));
+  });
+
+  router.get('/docs/:id/versions/:version', (req, res) => {
+    const versionNumber = Number(req.params.version);
+    if (!Number.isInteger(versionNumber)) {
+      res.status(400).json({ error: 'invalid version' });
+      return;
+    }
+    const doc = store.getDocument(db, req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    const version = store.getVersion(db, req.params.id, versionNumber);
+    if (!version) {
+      res.status(404).json({ error: 'version not found' });
+      return;
+    }
+    res.json(version);
+  });
+
+  return router;
+}
