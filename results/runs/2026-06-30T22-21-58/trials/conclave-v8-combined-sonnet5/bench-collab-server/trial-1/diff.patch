ansformPosition(op1.position, op2, false);\n  const end = transformPosition(end1, op2, true);\n  return { type: 'delete', position: start, count: Math.max(0, end - start) };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":357,"cache_read_input_tokens":76033,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":357},"output_tokens":59,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"27c691c9-2ae9-43f9-89ca-1812bb2f6558","uuid":"53fcb7cf-52e6-448b-bdd5-4f2d3dbef045","request_id":"req_011CcaEL8SMe2o3DkfbvTz1Z"}
