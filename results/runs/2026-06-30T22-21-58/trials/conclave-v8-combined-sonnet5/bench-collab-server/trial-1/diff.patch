--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,48 @@
+import type { Operation } from './models.js';
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+export function validateOperation(op: Operation, contentLength: number): boolean {
+  if (!op || (op.type !== 'insert' && op.type !== 'delete')) return false;
+  if (!Number.isInteger(op.position) || op.position < 0 || op.position > contentLength) return false;
+
+  if (op.type === 'insert') {
+    return typeof op.text === 'string';
+  }
+
+  if (!Number.isInteger(op.count) || op.count < 0) return false;
+  return op.position + op.count <= contentLength;
+}
+
+/**
+ * Transform a single position against an already-applied operation.
+ * `preferLeft` decides tie-breaking when pos === op.position for an insert:
+ * true keeps pos in place, false shifts it past the inserted text.
+ */
+function transformPosition(pos: number, op: Operation, preferLeft: boolean): number {
+  if (op.type === 'insert') {
+    if (pos < op.position || (pos === op.position && preferLeft)) return pos;
+    return pos + op.text.length;
+  }
+
+  if (pos <= op.position) return pos;
+  if (pos >= op.position + op.count) return pos - op.count;
+  return op.position;
+}
+
+/** Transform op1 so it applies correctly to content that already has op2 applied. */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert') {
+    return { ...op1, position: transformPosition(op1.position, op2, false) };
+  }
+
+  const end1 = op1.position + op1.count;
+  const start = transformPosition(op1.position, op2, false);
+  const end = transformPosition(end1, op2, true);
+  return { type: 'delete', position: start, count: Math.max(0, end - start) };
+}
