@@ -0,0 +1,82 @@
+type Direction = 0 | 1 | 2; // 0 = down, 1 = down-left, 2 = down-right
+
+const DOWN: Direction = 0;
+const DOWN_LEFT: Direction = 1;
+const DOWN_RIGHT: Direction = 2;
+const COL_DELTA: Record<Direction, number> = { 0: 0, 1: -1, 2: 1 };
+
+interface SimulationResult {
+  visitedCellCount: number;
+  exitPaths: bigint;
+}
+
+function findSourceColumn(grid: string[][]): number {
+  const topRow = grid[0] ?? [];
+  return topRow.indexOf('S');
+}
+
+function simulate(grid: string[][]): SimulationResult {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  const sourceCol = findSourceColumn(grid);
+
+  if (rows === 0 || cols === 0 || sourceCol === -1) {
+    return { visitedCellCount: 0, exitPaths: 0n };
+  }
+
+  let visitedCellCount = 0;
+  let exitPaths = 0n;
+
+  // currentRow[c] holds the count of beams arriving at (r, c) for each pending direction.
+  let currentRow: [bigint, bigint, bigint][] = Array.from({ length: cols }, () => [0n, 0n, 0n]);
+  currentRow[sourceCol][DOWN] = 1n;
+
+  const addBeam = (
+    nextRow: [bigint, bigint, bigint][],
+    targetRow: number,
+    targetCol: number,
+    direction: Direction,
+    count: bigint,
+  ): void => {
+    if (targetRow < 0 || targetRow >= rows || targetCol < 0 || targetCol >= cols) {
+      exitPaths += count;
+      return;
+    }
+    nextRow[targetCol][direction] += count;
+  };
+
+  for (let r = 0; r < rows; r++) {
+    const nextRow: [bigint, bigint, bigint][] = Array.from({ length: cols }, () => [0n, 0n, 0n]);
+
+    for (let c = 0; c < cols; c++) {
+      const counts = currentRow[c];
+      if (counts[0] === 0n && counts[1] === 0n && counts[2] === 0n) continue;
+
+      visitedCellCount++;
+
+      if (grid[r][c] === '^') {
+        const total = counts[0] + counts[1] + counts[2];
+        addBeam(nextRow, r + 1, c - 1, DOWN_LEFT, total);
+        addBeam(nextRow, r + 1, c + 1, DOWN_RIGHT, total);
+      } else {
+        for (const direction of [DOWN, DOWN_LEFT, DOWN_RIGHT] as Direction[]) {
+          const count = counts[direction];
+          if (count === 0n) continue;
+          addBeam(nextRow, r + 1, c + COL_DELTA[direction], direction, count);
+        }
+      }
+    }
+
+    currentRow = nextRow;
+  }
+
+  return { visitedCellCount, exitPaths };
+}
+
+export function countBeamCells(grid: string[][]): number {
+  return simulate(grid).visitedCellCount;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  return simulate(grid).exitPaths;
+}
