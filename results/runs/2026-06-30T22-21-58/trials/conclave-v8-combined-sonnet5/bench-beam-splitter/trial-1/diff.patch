+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index.js';
+
+describe('countBeamCells / countBeamPaths', () => {
+  it('straight beam with no splitters travels to the bottom row', () => {
+    const grid = [
+      ['.', 'S', '.'],
+      ['.', '.', '.'],
+      ['.', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(4);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('source on the only (bottom) row exits immediately', () => {
+    const grid = [['.', 'S', '.']];
+    expect(countBeamCells(grid)).toBe(1);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('matches TASK.md example 1: single mid-grid splitter', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(5);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('matches TASK.md example 2: two splitters, one branch absorbed off the edge', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(6);
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('splitter at the left edge: the down-left branch exits without visiting a cell', () => {
+    const grid = [
+      ['S', '.', '.'],
+      ['^', '.', '.'],
+      ['.', '.', '.'],
+    ];
+    // (0,0) S -> (1,0) splitter -> DL exits immediately (col -1), DR -> (2,1) -> exits at row 3
+    expect(countBeamCells(grid)).toBe(3);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('splitter on the last row: both branches exit immediately but still count as 2 paths', () => {
+    const grid = [
+      ['S', '.'],
+      ['^', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(2);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('two beams converge on the same non-splitter cell: cell counts once, paths still sum', () => {
+    const grid = [
+      ['.', '.', 'S', '.', '.'],
+      ['.', '.', '^', '.', '.'],
+      ['.', '^', '.', '^', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    // source splits once (x2), each branch hits a splitter (x2 each) => 4 total paths
+    // (3,0), (3,2)x2 merged, (3,4) visited => 7 distinct cells
+    expect(countBeamCells(grid)).toBe(7);
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('two beams converge on the same splitter cell: it re-splits the merged total', () => {
+    const grid = [
+      ['.', '.', 'S', '.', '.'],
+      ['.', '.', '^', '.', '.'],
+      ['.', '^', '.', '^', '.'],
+      ['.', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    // 2 of the 4 post-row2 paths converge into the row3 splitter and double again (4),
+    // the other 2 (off to the sides) exit directly => 4 + 2 = 6 total paths
+    expect(countBeamCells(grid)).toBe(9);
+    expect(countBeamPaths(grid)).toBe(6n);
+  });
+
+  it('countBeamPaths always returns a bigint', () => {
+    const grid = [['S']];
+    const result = countBeamPaths(grid);
+    expect(typeof result).toBe('bigint');
+  });
+
+  it('produces exact bigint path counts beyond Number.MAX_SAFE_INTEGER (2^60)', () => {
+    const splitterRows = 60;
+    const rows = splitterRows + 1;
+    const cols = 200;
+    const sourceCol = 100;
+    const grid: string[][] = Array.from({ length: rows }, () => Array(cols).fill('.'));
+    grid[0][sourceCol] = 'S';
+    for (let r = 1; r <= splitterRows; r++) {
+      grid[r] = Array(cols).fill('^');
+    }
+    const expected = 2n ** BigInt(splitterRows);
+    expect(expected).toBeGreaterThan(BigInt(Number.MAX_SAFE_INTEGER));
+    expect(countBeamPaths(grid)).toBe(expected);
+  });
+
+  it('handles a 200x200 grid with 50 splitter rows in well under 5 seconds', () => {
+    const rows = 200;
+    const cols = 200;
+    const sourceCol = 100;
+    const grid: string[][] = Array.from({ length: rows }, () => Array(cols).fill('.'));
+    grid[0][sourceCol] = 'S';
+    for (let r = 1; r <= 50; r++) {
+      grid[r] = Array(cols).fill('^');
+    }
+    const start = Date.now();
+    const cells = countBeamCells(grid);
+    const paths = countBeamPaths(grid);
+    const elapsed = Date.now() - start;
+    expect(elapsed).toBeLessThan(5000);
+    expect(cells).toBeGreaterThan(0);
+    expect(paths).toBe(2n ** 50n);
+  });
+
+  it('does not mutate the input grid', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    const before = JSON.stringify(grid);
+    countBeamCells(grid);
+    countBeamPaths(grid);
+    expect(JSON.stringify(grid)).toBe(before);
+  });
+});
