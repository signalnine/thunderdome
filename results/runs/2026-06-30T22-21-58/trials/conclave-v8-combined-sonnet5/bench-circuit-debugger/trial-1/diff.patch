+++ b/src/index.ts
@@ -0,0 +1,120 @@
+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+const OPS: Record<Gate['op'], (a: number, b: number) => number> = {
+  AND: (a, b) => a & b,
+  OR: (a, b) => a | b,
+  XOR: (a, b) => a ^ b,
+};
+
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values: Record<string, number> = { ...inputs };
+  const consumers = new Map<string, Gate[]>();
+  const pendingCount = new Map<Gate, number>();
+
+  for (const g of gates) {
+    let count = 0;
+    for (const wire of [g.in1, g.in2]) {
+      if (!(wire in values)) {
+        count++;
+        if (!consumers.has(wire)) consumers.set(wire, []);
+        consumers.get(wire)!.push(g);
+      }
+    }
+    pendingCount.set(g, count);
+  }
+
+  const queue: Gate[] = gates.filter((g) => pendingCount.get(g) === 0);
+
+  while (queue.length > 0) {
+    const g = queue.shift()!;
+    values[g.out] = OPS[g.op](values[g.in1], values[g.in2]);
+
+    const affected = consumers.get(g.out);
+    if (affected) {
+      for (const cg of affected) {
+        const remaining = pendingCount.get(cg)! - 1;
+        pendingCount.set(cg, remaining);
+        if (remaining === 0) queue.push(cg);
+      }
+    }
+  }
+
+  return values;
+}
+
+function bitNum(wire: string): number {
+  return parseInt(wire.slice(1), 10);
+}
+
+function isXY(wire: string): boolean {
+  return wire.startsWith('x') || wire.startsWith('y');
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  const bad = new Set<string>();
+
+  const consumers = new Map<string, Gate[]>();
+  for (const g of gates) {
+    for (const wire of [g.in1, g.in2]) {
+      if (!consumers.has(wire)) consumers.set(wire, []);
+      consumers.get(wire)!.push(g);
+    }
+  }
+
+  let maxZ = '';
+  let maxZNum = -1;
+  for (const g of gates) {
+    if (g.out.startsWith('z') && bitNum(g.out) > maxZNum) {
+      maxZNum = bitNum(g.out);
+      maxZ = g.out;
+    }
+  }
+
+  const involvesX00OrY00 = (g: Gate) =>
+    g.in1 === 'x00' || g.in2 === 'x00' || g.in1 === 'y00' || g.in2 === 'y00';
+
+  for (const g of gates) {
+    const { op, in1, in2, out } = g;
+
+    // Rule 1: every z output (except the final carry) must come from XOR.
+    if (out.startsWith('z') && op !== 'XOR' && out !== maxZ) {
+      bad.add(out);
+    }
+
+    // Rule 2: an XOR gate must either take x/y as direct inputs, or output
+    // directly to a z wire. Otherwise it's a misplaced intermediate gate.
+    if (op === 'XOR' && !out.startsWith('z') && !(isXY(in1) && isXY(in2))) {
+      bad.add(out);
+    }
+
+    // Rule 3: an AND gate (other than the bit-0 carry generator) must
+    // always feed into an OR gate (carry propagate/generate combination).
+    if (op === 'AND' && !involvesX00OrY00(g)) {
+      const feedsOr = (consumers.get(out) ?? []).some((c) => c.op === 'OR');
+      if (!feedsOr) bad.add(out);
+    }
+
+    // Rule 4: an XOR gate taking x/y directly (other than bit 0) produces a
+    // partial sum, which must never feed directly into an OR gate.
+    if (op === 'XOR' && isXY(in1) && isXY(in2) && !involvesX00OrY00(g)) {
+      const feedsOr = (consumers.get(out) ?? []).some((c) => c.op === 'OR');
+      if (feedsOr) bad.add(out);
+    }
+
+    // Rule 5: an OR gate (other than the final carry-out) must feed into
+    // exactly one XOR gate and one AND gate of the next bit.
+    if (op === 'OR' && out !== maxZ) {
+      const outConsumers = consumers.get(out) ?? [];
+      const xorCount = outConsumers.filter((c) => c.op === 'XOR').length;
+      const andCount = outConsumers.filter((c) => c.op === 'AND').length;
+      if (xorCount !== 1 || andCount !== 1) bad.add(out);
+    }
+  }
+
+  return [...bad].sort();
+}
