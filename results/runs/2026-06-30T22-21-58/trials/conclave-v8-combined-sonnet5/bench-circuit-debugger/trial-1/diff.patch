diff --git a/src/index.test.ts b/src/index.test.ts
new file mode 100644
index 0000000..306d69c
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,202 @@
+import { describe, it, expect } from 'vitest';
+import { simulate, findSwappedWires, Gate } from './index.js';
+
+function pad(n: number): string {
+  return n.toString().padStart(2, '0');
+}
+
+/**
+ * Builds a correct N-bit ripple-carry adder following the structure
+ * described in the task spec (half adder for bit 0, full adder for
+ * bits 1..N-1, final carry routed directly to z(N)).
+ */
+function buildAdder(n: number): Gate[] {
+  const gates: Gate[] = [];
+  const carryName = (i: number) => (i === n - 1 ? `z${pad(n)}` : `c${pad(i)}`);
+
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: carryName(0) });
+
+  for (let i = 1; i < n; i++) {
+    const xi = `x${pad(i)}`;
+    const yi = `y${pad(i)}`;
+    const ti = `t${pad(i)}`;
+    const cPrev = carryName(i - 1);
+    const zi = `z${pad(i)}`;
+    const ai = `a${pad(i)}`;
+    const bi = `b${pad(i)}`;
+    const ci = carryName(i);
+
+    gates.push({ op: 'XOR', in1: xi, in2: yi, out: ti });
+    gates.push({ op: 'XOR', in1: ti, in2: cPrev, out: zi });
+    gates.push({ op: 'AND', in1: xi, in2: yi, out: ai });
+    gates.push({ op: 'AND', in1: ti, in2: cPrev, out: bi });
+    gates.push({ op: 'OR', in1: ai, in2: bi, out: ci });
+  }
+
+  return gates;
+}
+
+function bitsToValue(values: Record<string, number>, prefix: string, n: number): number {
+  let result = 0;
+  for (let i = n - 1; i >= 0; i--) {
+    result = result * 2 + (values[`${prefix}${pad(i)}`] ?? 0);
+  }
+  return result;
+}
+
+function valueToInputs(prefix: string, n: number, value: number): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < n; i++) {
+    inputs[`${prefix}${pad(i)}`] = Math.floor(value / 2 ** i) % 2;
+  }
+  return inputs;
+}
+
+function swapOutputs(gates: Gate[], wireA: string, wireB: string): Gate[] {
+  return gates.map((g) => {
+    if (g.out === wireA) return { ...g, out: wireB };
+    if (g.out === wireB) return { ...g, out: wireA };
+    return g;
+  });
+}
+
+describe('simulate', () => {
+  it('returns the given inputs unchanged in the output map', () => {
+    const result = simulate([], { x00: 1 });
+    expect(result.x00).toBe(1);
+  });
+
+  it('computes a single AND gate correctly for all 4 input combos', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 0, b: 0 }).c).toBe(0);
+    expect(simulate(gates, { a: 0, b: 1 }).c).toBe(0);
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(0);
+    expect(simulate(gates, { a: 1, b: 1 }).c).toBe(1);
+  });
+
+  it('computes a single OR gate correctly for all 4 input combos', () => {
+    const gates: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 0, b: 0 }).c).toBe(0);
+    expect(simulate(gates, { a: 0, b: 1 }).c).toBe(1);
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(1);
+    expect(simulate(gates, { a: 1, b: 1 }).c).toBe(1);
+  });
+
+  it('computes a single XOR gate correctly for all 4 input combos', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 0, b: 0 }).c).toBe(0);
+    expect(simulate(gates, { a: 0, b: 1 }).c).toBe(1);
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(1);
+    expect(simulate(gates, { a: 1, b: 1 }).c).toBe(0);
+  });
+
+  it('resolves gates in dependency order regardless of array order', () => {
+    // shuffled: the gate consuming `mid` appears before the gate producing it
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'mid', in2: 'b', out: 'out' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'mid' },
+    ];
+    const result = simulate(gates, { a: 1, b: 1 });
+    expect(result.mid).toBe(0);
+    expect(result.out).toBe(0);
+
+    const result2 = simulate(gates, { a: 1, b: 0 });
+    expect(result2.mid).toBe(1);
+    expect(result2.out).toBe(0);
+  });
+
+  it('handles the 4-bit example adder and produces correct z-bits', () => {
+    const gates = buildAdder(4);
+    for (const [x, y] of [
+      [0, 0],
+      [5, 3],
+      [15, 15],
+      [1, 14],
+      [9, 9],
+    ]) {
+      const inputs = { ...valueToInputs('x', 4, x), ...valueToInputs('y', 4, y) };
+      const result = simulate(gates, inputs);
+      const z = bitsToValue(result, 'z', 5);
+      expect(z).toBe(x + y);
+    }
+  });
+
+  it('returns values for every wire that appears, not just z bits', () => {
+    const gates = buildAdder(4);
+    const inputs = { ...valueToInputs('x', 4, 5), ...valueToInputs('y', 4, 3) };
+    const result = simulate(gates, inputs);
+    expect(result.c00).toBeDefined();
+    expect(result.t01).toBeDefined();
+    expect(result.a01).toBeDefined();
+  });
+
+  it('works for a large 45-bit adder circuit within a reasonable time', () => {
+    const gates = buildAdder(45);
+    const x = 123456789012;
+    const y = 987654321098;
+    const inputs = { ...valueToInputs('x', 45, x), ...valueToInputs('y', 45, y) };
+
+    const start = Date.now();
+    const result = simulate(gates, inputs);
+    const elapsed = Date.now() - start;
+
+    const z = bitsToValue(result, 'z', 46);
+    expect(z).toBe(x + y);
+    expect(elapsed).toBeLessThan(2000);
+  });
+});
+
+describe('findSwappedWires', () => {
+  it('returns no false positives for a correct unswapped adder of varying sizes', () => {
+    for (const n of [1, 4, 8, 45]) {
+      const gates = buildAdder(n);
+      expect(findSwappedWires(gates)).toEqual([]);
+    }
+  });
+
+  it('detects a single swapped pair (z output XOR swapped with internal AND)', () => {
+    const gates = buildAdder(8);
+    const swapped = swapOutputs(gates, 'z03', 'a03');
+    const result = findSwappedWires(swapped);
+    expect(result).toEqual(['a03', 'z03']);
+  });
+
+  it('correctly identifies the final carry-out z-bit as exempt from the XOR rule', () => {
+    // z(n) is produced by an OR gate by construction; an unmodified adder
+    // must not flag it even though its op is OR, not XOR.
+    const gates = buildAdder(8);
+    const result = findSwappedWires(gates);
+    expect(result).not.toContain('z08');
+  });
+
+  it('detects 4 independent swapped pairs (8 wires) in a 45-bit adder', () => {
+    let gates = buildAdder(45);
+    // structurally-distinguishable swap types, spread across distant bits
+    // so they cannot interact with each other.
+    const pairs: [string, string][] = [
+      ['z05', 'a05'],
+      ['z15', 'b15'],
+      ['z25', 'c25'],
+      ['z35', 'a35'],
+    ];
+    for (const [w1, w2] of pairs) {
+      gates = swapOutputs(gates, w1, w2);
+    }
+
+    const start = Date.now();
+    const result = findSwappedWires(gates);
+    const elapsed = Date.now() - start;
+
+    const expected = pairs.flat().sort();
+    expect(result).toEqual(expected);
+    expect(elapsed).toBeLessThan(2000);
+  });
+
+  it('returns a sorted array', () => {
+    const gates = buildAdder(20);
+    const swapped = swapOutputs(gates, 'z10', 'a10');
+    const result = findSwappedWires(swapped);
+    expect(result).toEqual([...result].sort());
+  });
+});
