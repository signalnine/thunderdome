+import { Note, NoteInput, SearchResult, SuggestResult } from './models.js';
 import { NotFoundError, ValidationError } from './errors.js';
 
+const SEARCH_PER_PAGE = 20;
+const SUGGEST_LIMIT = 5;
+
+// Builds a safe FTS5 MATCH query from raw user input by treating every
+// quoted phrase or bare word as a literal phrase token. This avoids FTS5
+// query-syntax errors from special characters (e.g. `(`, `:`, `"`)  while
+// still preserving phrase semantics for quoted input like `"chocolate chip"`.
+function buildFtsQuery(raw: string): string {
+  const tokens: string[] = [];
+  const tokenRegex = /"([^"]*)"|(\S+)/g;
+  let match: RegExpExecArray | null;
+
+  while ((match = tokenRegex.exec(raw)) !== null) {
+    const phrase = (match[1] ?? match[2] ?? '').trim();
+    if (phrase) {
+      tokens.push(`"${phrase.replace(/"/g, '""')}"`);
+    }
+  }
+
+  return tokens.join(' ');
+}
+
+// Like buildFtsQuery, but turns the final token into a prefix match so
+// partial words (autocomplete-style) match, e.g. "getting" -> "getting*".
+function buildPrefixFtsQuery(raw: string): string {
+  const words = raw.trim().split(/\s+/).filter(Boolean);
+  if (words.length === 0) return '';
+
+  const tokens = words.map((word, i) => {
+    const escaped = word.replace(/"/g, '""');
+    const suffix = i === words.length - 1 ? '*' : '';
+    return `"${escaped}${suffix}"`;
+  });
+
+  return tokens.join(' ');
+}
+
 export function createRoutes(db: Database.Database): Router {
   const router = Router();
 
+  // GET /notes/search - Full-text search across title and body
+  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {
+    try {
+      const q = (req.query.q as string | undefined) ?? '';
+      if (!q.trim()) {
+        throw new ValidationError('q parameter is required');
+      }
+
+      const page = Math.max(1, parseInt(req.query.page as string, 10) || 1);
+      const offset = (page - 1) * SEARCH_PER_PAGE;
+      const ftsQuery = buildFtsQuery(q);
+
+      if (!ftsQuery) {
+        res.json({ results: [], total: 0, page, perPage: SEARCH_PER_PAGE });
+        return;
+      }
+
+      try {
+        const countStmt = db.prepare(
+          'SELECT COUNT(*) as total FROM notes_fts WHERE notes_fts MATCH ?'
+        );
+        const { total } = countStmt.get(ftsQuery) as { total: number };
+
+        const searchStmt = db.prepare(`
+          SELECT
+            notes_fts.rowid AS id,
+            notes.title AS title,
+            snippet(notes_fts, -1, '<mark>', '</mark>', '...', 10) AS snippet,
+            bm25(notes_fts) AS rank
+          FROM notes_fts
+          JOIN notes ON notes.id = notes_fts.rowid
+          WHERE notes_fts MATCH ?
+          ORDER BY rank ASC
+          LIMIT ? OFFSET ?
+        `);
+        const results = searchStmt.all(ftsQuery, SEARCH_PER_PAGE, offset) as SearchResult[];
+
+        res.json({ results, total, page, perPage: SEARCH_PER_PAGE });
+      } catch {
+        // Malformed FTS5 query syntax that slipped past sanitization - treat as no match.
+        res.json({ results: [], total: 0, page, perPage: SEARCH_PER_PAGE });
+      }
+    } catch (err) {
+      next(err);
+    }
+  });
+
+  // GET /notes/search/suggest - Autocomplete by title/body prefix
+  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {
+    try {
+      const q = (req.query.q as string | undefined) ?? '';
+      if (!q.trim()) {
+        throw new ValidationError('q parameter is required');
+      }
+
+      const ftsQuery = buildPrefixFtsQuery(q);
+      if (!ftsQuery) {
+        res.json({ results: [] });
+        return;
+      }
+
+      try {
+        const stmt = db.prepare(`
+          SELECT notes_fts.rowid AS id, notes.title AS title
