+function createFtsIndex(db: Database.Database): void {
+  db.exec(`
+    CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts USING fts5(
+      title, body, content='notes', content_rowid='id'
+    )
+  `);
+
+  // Keep the FTS index in sync with the notes table for inserts/updates/deletes
+  // that happen outside the route handlers (e.g. seed script, tests).
+  db.exec(`
+    CREATE TRIGGER IF NOT EXISTS notes_fts_ai AFTER INSERT ON notes BEGIN
+      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);
+    END;
+  `);
+  db.exec(`
+    CREATE TRIGGER IF NOT EXISTS notes_fts_ad AFTER DELETE ON notes BEGIN
+      INSERT INTO notes_fts(notes_fts, rowid, title, body) VALUES ('delete', old.id, old.title, old.body);
+    END;
+  `);
+  db.exec(`
+    CREATE TRIGGER IF NOT EXISTS notes_fts_au AFTER UPDATE ON notes BEGIN
+      INSERT INTO notes_fts(notes_fts, rowid, title, body) VALUES ('delete', old.id, old.title, old.body);
+      INSERT INTO notes_fts(rowid, title, body) VALUES (new.id, new.title, new.body);
+    END;
+  `);
+
+  // Backfill in case notes already existed (e.g. reopening a pre-FTS database file).
+  const { ftsCount } = db.prepare('SELECT COUNT(*) as ftsCount FROM notes_fts').get() as {
+    ftsCount: number;
+  };
+  const { notesCount } = db.prepare('SELECT COUNT(*) as notesCount FROM notes').get() as {
+    notesCount: number;
+  };
+  if (ftsCount === 0 && notesCount > 0) {
+    db.exec('INSERT INTO notes_fts(rowid, title, body) SELECT id, title, body FROM notes');
+  }
+}
