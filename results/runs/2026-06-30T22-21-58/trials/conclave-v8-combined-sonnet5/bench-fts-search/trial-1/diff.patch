+          JOIN notes ON notes.id = notes_fts.rowid
+          WHERE notes_fts MATCH ?
+          ORDER BY bm25(notes_fts) ASC
+          LIMIT ?
+        `);
+        const results = stmt.all(ftsQuery, SUGGEST_LIMIT) as SuggestResult[];
+        res.json({ results });
+      } catch {
+        res.json({ results: [] });
+      }
+    } catch (err) {
+      next(err);
+    }
+  });
+
