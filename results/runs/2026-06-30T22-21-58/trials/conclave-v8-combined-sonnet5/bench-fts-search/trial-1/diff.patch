owid, title, body) VALUES (new.id, new.title, new.body);\n    END;\n  `);\n\n  // Backfill in case notes already existed (e.g. reopening a pre-FTS database file).\n  const { ftsCount } = db.prepare('SELECT COUNT(*) as ftsCount FROM notes_fts').get() as {\n    ftsCount: number;\n  };\n  const { notesCount } = db.prepare('SELECT COUNT(*) as notesCount FROM notes').get() as {\n    notesCount: number;\n  };\n  if (ftsCount === 0 && notesCount > 0) {\n    db.exec('INSERT INTO notes_fts(rowid, title, body) SELECT id, title, body FROM notes');\n  }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1041,"cache_read_input_tokens":61293,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1041},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fd2ad19a-a6ea-44fb-b6f9-5ab38f84bd5c","uuid":"92f5d06d-c42a-4769-8ba9-445d5299509b","request_id":"req_011CcaE6tWb5TNSTX9cGDQjk"}
