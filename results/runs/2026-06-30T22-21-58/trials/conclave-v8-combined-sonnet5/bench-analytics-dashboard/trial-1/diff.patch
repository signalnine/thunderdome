+import { Router, type Request, type Response } from 'express';
+import { getDb } from '../db';
+import { ValidationError, NotFoundError } from '../errors';
+
+const router = Router();
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+const EVENT_COLUMNS = ['id', 'tenant_id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'] as const;
+
+function toEventDTO(row: EventRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: JSON.parse(row.properties) as Record<string, unknown>,
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+function toDashboardDTO(row: DashboardRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    owner_id: row.owner_id,
+    config: JSON.parse(row.config) as Record<string, unknown>,
+    created_at: row.created_at,
+    updated_at: row.updated_at,
+  };
+}
+
+function toWidgetDTO(row: WidgetRow) {
+  return {
+    id: row.id,
+    dashboard_id: row.dashboard_id,
+    type: row.type,
+    config: JSON.parse(row.config) as Record<string, unknown>,
+    position_x: row.position_x,
+    position_y: row.position_y,
+    width: row.width,
+    height: row.height,
+  };
+}
+
+function csvEscape(value: unknown): string {
+  const str = value === null || value === undefined ? '' : String(value);
+  if (/[",\n]/.test(str)) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+function eventsToCsv(rows: EventRow[]): string {
+  const header = EVENT_COLUMNS.join(',');
+  const lines = rows.map((row) =>
+    EVENT_COLUMNS.map((col) => csvEscape(col === 'properties' ? row.properties : row[col])).join(',')
+  );
+  return [header, ...lines].join('\n');
+}
+
+router.get('/events', (req: Request, res: Response) => {
+  const format = req.query.format as string | undefined;
+
+  if (format !== 'json' && format !== 'csv') {
+    throw new ValidationError('format must be json or csv');
+  }
+
+  const db = getDb();
+  const rows = db
+    .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp')
+    .all(req.user!.tenantId) as EventRow[];
+
+  if (format === 'json') {
+    res.status(200).json(rows.map(toEventDTO));
+    return;
+  }
+
+  res.status(200).type('text/csv').send(eventsToCsv(rows));
+});
+
+router.get('/dashboard/:id', (req: Request, res: Response) => {
+  const db = getDb();
+  const dashboard = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(req.params.id, req.user!.tenantId) as DashboardRow | undefined;
+
+  if (!dashboard) {
+    throw new NotFoundError('Dashboard not found');
+  }
+
+  const widgets = db
+    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+    .all(dashboard.id) as WidgetRow[];
+
+  res.status(200).json({
+    dashboard: toDashboardDTO(dashboard),
+    widgets: widgets.map(toWidgetDTO),
+  });
+});
+
+export default router;
