ht: row.height,\n  };\n}\n\nfunction csvEscape(value: unknown): string {\n  const str = value === null || value === undefined ? '' : String(value);\n  if (/[\",\\n]/.test(str)) {\n    return `\"${str.replace(/\"/g, '\"\"')}\"`;\n  }\n  return str;\n}\n\nfunction eventsToCsv(rows: EventRow[]): string {\n  const header = EVENT_COLUMNS.join(',');\n  const lines = rows.map((row) =>\n    EVENT_COLUMNS.map((col) => csvEscape(col === 'properties' ? row.properties : row[col])).join(',')\n  );\n  return [header, ...lines].join('\\n');\n}\n\nrouter.get('/events', (req: Request, res: Response) => {\n  const format = req.query.format as string | undefined;\n\n  if (format !== 'json' && format !== 'csv') {\n    throw new ValidationError('format must be json or csv');\n  }\n\n  const db = getDb();\n  const rows = db\n    .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp')\n    .all(req.user!.tenantId) as EventRow[];\n\n  if (format === 'json') {\n    res.status(200).json(rows.map(toEventDTO));\n    return;\n  }\n\n  res.status(200).type('text/csv').send(eventsToCsv(rows));\n});\n\nrouter.get('/dashboard/:id', (req: Request, res: Response) => {\n  const db = getDb();\n  const dashboard = db\n    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')\n    .get(req.params.id, req.user!.tenantId) as DashboardRow | undefined;\n\n  if (!dashboard) {\n    throw new NotFoundError('Dashboard not found');\n  }\n\n  const widgets = db\n    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')\n    .all(dashboard.id) as WidgetRow[];\n\n  res.status(200).json({\n    dashboard: toDashboardDTO(dashboard),\n    widgets: widgets.map(toWidgetDTO),\n  });\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":90,"cache_read_input_tokens":83701,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":90},"output_tokens":4,