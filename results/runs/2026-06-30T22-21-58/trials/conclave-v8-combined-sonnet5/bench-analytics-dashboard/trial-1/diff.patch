+import { Router, type Request, type Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ValidationError } from '../errors';
+
+const router = Router();
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface IncomingEvent {
+  name?: string;
+  properties?: Record<string, unknown>;
+  timestamp?: string;
+  session_id?: string;
+}
+
+function toEventDTO(row: EventRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: JSON.parse(row.properties) as Record<string, unknown>,
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+function insertEvent(tenantId: string, userId: string, event: IncomingEvent): EventRow {
+  if (!event.name) {
+    throw new ValidationError('Event name is required');
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  const properties = JSON.stringify(event.properties ?? {});
+
+  const columns = ['id', 'tenant_id', 'name', 'properties', 'user_id', 'session_id'];
+  const values: unknown[] = [id, tenantId, event.name, properties, userId, event.session_id ?? null];
+
+  if (event.timestamp) {
+    columns.push('timestamp');
+    values.push(event.timestamp);
+  }
+
+  const placeholders = columns.map(() => '?').join(', ');
+  db.prepare(`INSERT INTO events (${columns.join(', ')}) VALUES (${placeholders})`).run(...values);
+
+  return db.prepare('SELECT * FROM events WHERE id = ?').get(id) as EventRow;
+}
+
+router.post('/', (req: Request, res: Response) => {
+  const event = req.body as IncomingEvent;
+  const row = insertEvent(req.user!.tenantId, req.user!.id, event);
+  res.status(201).json(toEventDTO(row));
+});
+
+router.post('/batch', (req: Request, res: Response) => {
+  const { events } = req.body as { events?: IncomingEvent[] };
+
+  if (!events || !Array.isArray(events) || events.length === 0) {
+    throw new ValidationError('events must be a non-empty array');
+  }
+
+  const rows = events.map((event) => insertEvent(req.user!.tenantId, req.user!.id, event));
+  res.status(201).json({ inserted: rows.length, events: rows.map(toEventDTO) });
+});
+
+export default router;
