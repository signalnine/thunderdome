@@ -0,0 +1,150 @@
+import { Router, type Request, type Response } from 'express';
+import { getDb } from '../db';
+import { ValidationError } from '../errors';
+
+const router = Router();
+
+const BUCKET_FORMATS: Record<string, string> = {
+  hour: '%Y-%m-%d %H:00',
+  day: '%Y-%m-%d',
+  week: '%Y-%W',
+  month: '%Y-%m',
+};
+
+interface CountBody {
+  event_name?: string;
+  start?: string;
+  end?: string;
+}
+
+interface TimeseriesBody {
+  event_name?: string;
+  bucket?: string;
+}
+
+interface BreakdownBody {
+  event_name?: string;
+  property_key?: string;
+}
+
+interface FunnelBody {
+  steps?: string[];
+}
+
+router.post('/count', (req: Request, res: Response) => {
+  const { event_name: eventName, start, end } = req.body as CountBody;
+
+  if (!eventName) {
+    throw new ValidationError('event_name is required');
+  }
+
+  const db = getDb();
+  const conditions = ['tenant_id = ?', 'name = ?'];
+  const params: unknown[] = [req.user!.tenantId, eventName];
+
+  if (start) {
+    conditions.push('timestamp >= ?');
+    params.push(start);
+  }
+  if (end) {
+    conditions.push('timestamp <= ?');
+    params.push(end);
+  }
+
+  const row = db
+    .prepare(`SELECT COUNT(*) as count FROM events WHERE ${conditions.join(' AND ')}`)
+    .get(...params) as { count: number };
+
+  res.status(200).json({ count: row.count });
+});
+
+router.post('/timeseries', (req: Request, res: Response) => {
+  const { event_name: eventName, bucket } = req.body as TimeseriesBody;
+
+  if (!eventName) {
+    throw new ValidationError('event_name is required');
+  }
+
+  const bucketKey = bucket ?? 'day';
+  const format = BUCKET_FORMATS[bucketKey];
+  if (!format) {
+    throw new ValidationError(`bucket must be one of ${Object.keys(BUCKET_FORMATS).join(', ')}`);
+  }
+
+  const db = getDb();
+  const rows = db
+    .prepare(
+      `SELECT strftime('${format}', timestamp) as bucket, COUNT(*) as count
+       FROM events WHERE tenant_id = ? AND name = ?
+       GROUP BY bucket ORDER BY bucket`
+    )
+    .all(req.user!.tenantId, eventName) as { bucket: string; count: number }[];
+
+  res.status(200).json({ data: rows });
+});
+
+router.post('/breakdown', (req: Request, res: Response) => {
+  const { event_name: eventName, property_key: propertyKey } = req.body as BreakdownBody;
+
+  if (!eventName || !propertyKey) {
+    throw new ValidationError('event_name and property_key are required');
+  }
+
+  const db = getDb();
+  const rows = db
+    .prepare(
+      `SELECT json_extract(properties, '$.' || ?) as property_value, COUNT(*) as count
+       FROM events WHERE tenant_id = ? AND name = ?
+       GROUP BY property_value ORDER BY count DESC`
+    )
+    .all(propertyKey, req.user!.tenantId, eventName) as { property_value: string; count: number }[];
+
+  res.status(200).json({ data: rows });
+});
+
+router.post('/funnel', (req: Request, res: Response) => {
+  const { steps } = req.body as FunnelBody;
+
+  if (!steps || !Array.isArray(steps) || steps.length === 0) {
+    throw new ValidationError('steps must be a non-empty array');
+  }
+
+  const db = getDb();
+  const placeholders = steps.map(() => '?').join(', ');
+  const rows = db
+    .prepare(
+      `SELECT session_id, name, timestamp, rowid as rid FROM events
+       WHERE tenant_id = ? AND name IN (${placeholders}) AND session_id IS NOT NULL
+       ORDER BY session_id, timestamp, rid`
+    )
+    .all(req.user!.tenantId, ...steps) as { session_id: string; name: string; timestamp: string }[];
+
+  const eventsBySession = new Map<string, { name: string; timestamp: string }[]>();
+  for (const row of rows) {
+    const list = eventsBySession.get(row.session_id) ?? [];
+    list.push({ name: row.name, timestamp: row.timestamp });
+    eventsBySession.set(row.session_id, list);
+  }
+
+  const stepCounts = new Array(steps.length).fill(0) as number[];
+
+  for (const sessionEvents of eventsBySession.values()) {
+    let cursor = 0;
+    for (let i = 0; i < steps.length; i++) {
+      const match = sessionEvents.find(
+        (e, idx) => e.name === steps[i] && idx >= cursor
+      );
+      if (!match) {
+        break;
+      }
+      stepCounts[i]++;
+      cursor = sessionEvents.indexOf(match) + 1;
+    }
+  }
+
+  res.status(200).json({
+    steps: steps.map((name, i) => ({ name, count: stepCounts[i] })),
+  });
+});
+
+export default router;
