+import { Router, type Request, type Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ValidationError, NotFoundError } from '../errors';
+
+const router = Router();
+
+const VALID_WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+function toDashboardDTO(row: DashboardRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    owner_id: row.owner_id,
+    config: JSON.parse(row.config) as Record<string, unknown>,
+    created_at: row.created_at,
+    updated_at: row.updated_at,
+  };
+}
+
+function toWidgetDTO(row: WidgetRow) {
+  return {
+    id: row.id,
+    dashboard_id: row.dashboard_id,
+    type: row.type,
+    config: JSON.parse(row.config) as Record<string, unknown>,
+    position_x: row.position_x,
+    position_y: row.position_y,
+    width: row.width,
+    height: row.height,
+  };
+}
+
+function findDashboard(tenantId: string, id: string): DashboardRow {
+  const db = getDb();
+  const dashboard = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(id, tenantId) as DashboardRow | undefined;
+
+  if (!dashboard) {
+    throw new NotFoundError('Dashboard not found');
+  }
+  return dashboard;
+}
+
+router.post('/', (req: Request, res: Response) => {
+  const { name, config } = req.body as { name?: string; config?: Record<string, unknown> };
+
+  if (!name) {
+    throw new ValidationError('name is required');
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  db.prepare(
+    'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'
+  ).run(id, req.user!.tenantId, name, req.user!.id, JSON.stringify(config ?? {}));
+
+  const dashboard = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+  res.status(201).json(toDashboardDTO(dashboard));
+});
+
+router.get('/', (req: Request, res: Response) => {
+  const db = getDb();
+  const rows = db
+    .prepare('SELECT * FROM dashboards WHERE tenant_id = ?')
+    .all(req.user!.tenantId) as DashboardRow[];
+
+  res.status(200).json(rows.map(toDashboardDTO));
+});
+
+router.get('/:id', (req: Request, res: Response) => {
+  const dashboard = findDashboard(req.user!.tenantId, req.params.id);
+  const db = getDb();
+  const widgets = db
+    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+    .all(dashboard.id) as WidgetRow[];
+
+  res.status(200).json({ ...toDashboardDTO(dashboard), widgets: widgets.map(toWidgetDTO) });
+});
+
+router.patch('/:id', (req: Request, res: Response) => {
+  const dashboard = findDashboard(req.user!.tenantId, req.params.id);
+  const { name, config } = req.body as { name?: string; config?: Record<string, unknown> };
+
+  const db = getDb();
+  db.prepare(
+    "UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?"
+  ).run(
+    name ?? dashboard.name,
+    config !== undefined ? JSON.stringify(config) : dashboard.config,
+    dashboard.id
+  );
+
+  const updated = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(dashboard.id) as DashboardRow;
+  res.status(200).json(toDashboardDTO(updated));
+});
+
+router.delete('/:id', (req: Request, res: Response) => {
+  const dashboard = findDashboard(req.user!.tenantId, req.params.id);
+  const db = getDb();
+  db.prepare('DELETE FROM dashboards WHERE id = ?').run(dashboard.id);
+  res.status(204).send();
+});
+
+router.post('/:id/widgets', (req: Request, res: Response) => {
+  const dashboard = findDashboard(req.user!.tenantId, req.params.id);
+  const {
+    type,
+    config,
+    position_x: positionX,
+    position_y: positionY,
+    width,
+    height,
+  } = req.body as {
+    type?: string;
+    config?: Record<string, unknown>;
+    position_x?: number;
+    position_y?: number;
+    width?: number;
+    height?: number;
+  };
+
+  if (!type || !VALID_WIDGET_TYPES.includes(type)) {
+    throw new ValidationError(`type must be one of ${VALID_WIDGET_TYPES.join(', ')}`);
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  db.prepare(
+    `INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height)
+     VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
+  ).run(
+    id,
+    dashboard.id,
+    type,
+    JSON.stringify(config ?? {}),
+    positionX ?? 0,
+    positionY ?? 0,
+    width ?? 1,
+    height ?? 1
+  );
+
+  const widget = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as WidgetRow;
+  res.status(201).json(toWidgetDTO(widget));
+});
+
+router.delete('/:id/widgets/:widgetId', (req: Request, res: Response) => {
+  const dashboard = findDashboard(req.user!.tenantId, req.params.id);
+  const db = getDb();
+  const widget = db
+    .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')
+    .get(req.params.widgetId, dashboard.id) as WidgetRow | undefined;
+
+  if (!widget) {
+    throw new NotFoundError('Widget not found');
+  }
+
+  db.prepare('DELETE FROM widgets WHERE id = ?').run(widget.id);
+  res.status(204).send();
+});
+
+export default router;
