+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U5Fp9bmTF2b917LF7hbejo","type":"tool_result","content":"1\t/**\n2\t * Worker entry point.\n3\t * Runs background jobs on a schedule.\n4\t */\n5\t\n6\timport { Scheduler } from './scheduler.js';\n7\timport { syncJob } from './jobs/sync.js';\n8\timport { cleanupJob } from './jobs/cleanup.js';\n9\t\n10\texport function createWorker(): Scheduler {\n11\t  const scheduler = new Scheduler();\n12\t\n13\t  // Register jobs\n14\t  scheduler.register('sync', syncJob, 60_000); // Every 60 seconds\n15\t  scheduler.register('cleanup', async () => { await cleanupJob(); }, 300_000); // Every 5 minutes\n16\t\n17\t  return scheduler;\n18\t}\n19\t\n20\t// Start worker if run directly\n21\tconst isMainModule = process.argv[1]?.includes('worker/dist/index.js');\n22\tif (isMainModule) {\n23\t  console.log('Starting worker...');\n24\t  const worker = createWorker();\n25\t  worker.start();\n26\t\n27\t  process.on('SIGINT', () => {\n28\t    console.log('Shutting down worker...');\n29\t    worker.stop();\n30\t    process.exit(0);\n31\t  });\n32\t}\n33\t"}]},"parent_tool_use_id":null,"session_id":"f3ee865a-3286-4ed7-8803-4148283ec4cf","uuid":"1c0f6867-47f2-4ceb-b18f-dfe55b5f80a7","timestamp":"2026-06-30T22:24:13.044Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/packages/worker/src/index.ts","content":"/**\n * Worker entry point.\n * Runs background jobs on a schedule.\n */\n\nimport { Scheduler } from './scheduler.js';\nimport { syncJob } from './jobs/sync.js';\nimport { cleanupJob } from './jobs/cleanup.js';\n\nexport function createWorker(): Scheduler {\n  const scheduler = new Scheduler();\n\n  // Register jobs\n  scheduler.register('sync', syncJob, 60_000); // Every 60 seconds\n  scheduler.register('cleanup', async () => { await cleanupJob(); }, 300_000); // Every 5 minutes\n\n  return scheduler;\n}\n\n// Start worker if run directly\nconst isMainModule = process.argv[1]?.includes('worker/dist/index.js');\nif (isMainModule) {\n  console.log('Starting worker...');\n  const worker = createWorker();\n  worker.start();\n\n  process.on('SIGINT', () => {\n    console.log('Shutting down worker...');\n    worker.stop();\n    process.exit(0);\n  });\n}\n","numLines":33,"startLine":1,"totalLines":33}}}
