idget', 9.99, 'gadgets');\n51\t    catalog.createProduct('Red Gizmo', 19.99, 'electronics');\n52\t\n53\t    const results = catalog.searchProducts('widget');\n54\t    expect(results).toHaveLength(1);\n55\t    expect(results[0].name).toBe('Blue Widget');\n56\t\n57\t    const catResults = catalog.searchProducts('electronics');\n58\t    expect(catResults).toHaveLength(1);\n59\t  });\n60\t\n61\t  it('should update and remove products', () => {\n62\t    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\n63\t    catalog.updateProduct(id, { price: 14.99 });\n64\t    expect(catalog.getProduct(id)!.price).toBe(14.99);\n65\t\n66\t    const removed = catalog.removeProduct(id);\n67\t    expect(removed).toBe(true);\n68\t    expect(catalog.getProduct(id)).toBeNull();\n69\t\n70\t    const removedAgain = catalog.removeProduct(id);\n71\t    expect(removedAgain).toBe(false);\n72\t  });\n73\t});\n74\t"}]},"parent_tool_use_id":null,"session_id":"0bc20c2e-2e6c-4ea3-8dc3-15b7865d2c9f","uuid":"94a4d72b-bbc4-4af5-a283-762c4b266386","timestamp":"2026-06-30T22:28:43.641Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/tests/catalog.test.ts","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/bus.js';\nimport { createCatalogService } from '../src/catalog/index.js';\n\ndescribe('CatalogService (unit)', () => {\n  let bus: EventBus;\n  let catalog: ReturnType<typeof createCatalogService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    catalog = createCatalogService(bus);\n  });\n\n  it('should create a product and return its id', () => {\n    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\n    expect(id).toBeDefined();\n    expect(typeof id).toBe('string');\n  });\n\n  it('should retrieve a product by id', () => {\n    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\n    const product = catalog.getProduct(id);\n    expect(product).not.toBeNull();\n    expect(product!.name).toBe('Widget');\n    expect(product!.price).toBe(9.99);\n    expect(product!.category).toBe('gadgets');\n  });\n\n  it('should return null for non-existent product', () => {\n    const product = catalog.getProduct('non-existent');\n    expect(product).toBeNull();\n  });\n\n  it('should list products filtered by category', () => {\n    catalog.createProduct('Widget', 9.99, 'gadgets');\n    catalog.createProduct('Gizmo', 19.99, 'gadgets');\n    catalog.createProduct('Book', 12.99, 'books');\n\n    const gadgets = catalog.listProducts('gadgets');\n    expect(gadgets).toHaveLength(2);\n\n    const books = catalog.listProducts('books');\n    expect(books).toHaveLength(1);\n\n    const all = catalog.listProducts();\n    expect(all).toHaveLength(3);\n  });\n\n  it('should search products by name or category', () => {\n    catalog.createProduct('Blue Widget', 9.99, 'gadgets');\n    catalog.createProduct('Red Gizmo', 19.99, 'electronics');\n\n    const results = catalog.searchProducts('widget');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('Blue Widget');\n\n    const catResults = catalog.searchProducts('electronics');\n    expect(catResults).toHaveLength(1);\n  });\n\n  it('should update and remove products', () => {\n    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\n    catalog.updateProduct(id, { price: 14.99 });\n    expect(catalog.getProduct(id)!.price).toBe(14.99);\n\n    const removed = catalog.removeProduct(id);\n    expect(removed).toBe(true);\n    expect(catalog.getProduct(id)).toBeNull();\n\n    const removedAgain = catalog.removeProduct(id);\n    expect(removedAgain).toBe(false);\n  });\n});\n","numLines":74,"startLine":1,"totalLines":74}}}
