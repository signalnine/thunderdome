rtItems.get(event.cartId) ?? [];\n    for (const item of items) {\n      productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);\n    }\n  });\n\n  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {\n    track(Events.ORDER_STATUS_CHANGED);\n    void (payload as OrderStatusChangedEvent);\n  });\n\n  bus.on(Events.PAYMENT_PROCESSED, (payload) => {\n    track(Events.PAYMENT_PROCESSED);\n    const event = payload as PaymentProcessedEvent;\n    if (event.status === PaymentStatus.SUCCESS) {\n      revenue += orderTotals.get(event.orderId) ?? 0;\n    }\n  });\n\n  bus.on(Events.NOTIFICATION_SENT, () => {\n    track(Events.NOTIFICATION_SENT);\n  });\n\n  bus.on(Events.ANALYTICS_EVENT, () => {\n    track(Events.ANALYTICS_EVENT);\n  });\n\n  return {\n    getEventCount(eventType: string): number {\n      return eventCounts.get(eventType) ?? 0;\n    },\n\n    getRevenue(): number {\n      return revenue;\n    },\n\n    getConversionRate(): number {\n      if (cartIds.size === 0) return 0;\n      return orderCount / cartIds.size;\n    },\n\n    getTopProducts(limit: number) {\n      return [...productCounts.entries()]\n        .map(([productId, count]) => ({ productId, count }))\n        .sort((a, b) => b.count - a.count)\n        .slice(0, limit);\n    },\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":995,"cache_read_input_tokens":63115,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":995},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0bc20c2e-2e6c-4ea3-8dc3-15b7865d2c9f","uuid":"d9d382ea-3e42-4f5e-9a9a-e8a6678e3db8","request_id":"req_011CcaEbqT6pKajdHAicSfMK"}
