@@ -0,0 +1,100 @@
+import { EventBus } from '../bus.js';
+import {
+  AnalyticsService,
+  Events,
+  CartUpdatedEvent,
+  OrderCreatedEvent,
+  PaymentProcessedEvent,
+  PaymentStatus,
+} from '../types.js';
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const orderTotals = new Map<string, number>();
+  const cartItems = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const cartIds = new Set<string>();
+  const productCounts = new Map<string, number>();
+  let revenue = 0;
+  let orderCount = 0;
+
+  function track(eventType: string): void {
+    eventCounts.set(eventType, (eventCounts.get(eventType) ?? 0) + 1);
+  }
+
+  bus.on(Events.PRODUCT_CREATED, () => {
+    track(Events.PRODUCT_CREATED);
+  });
+
+  bus.on(Events.INVENTORY_UPDATED, () => {
+    track(Events.INVENTORY_UPDATED);
+  });
+
+  bus.on(Events.LOW_STOCK_ALERT, () => {
+    track(Events.LOW_STOCK_ALERT);
+  });
+
+  bus.on(Events.CART_UPDATED, (payload) => {
+    track(Events.CART_UPDATED);
+    const event = payload as CartUpdatedEvent;
+    cartIds.add(event.cartId);
+    cartItems.set(event.cartId, event.items.map((item) => ({ ...item })));
+  });
+
+  bus.on(Events.PRICE_CALCULATED, () => {
+    track(Events.PRICE_CALCULATED);
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    track(Events.ORDER_CREATED);
+    const event = payload as OrderCreatedEvent;
+    orderCount += 1;
+    orderTotals.set(event.orderId, event.total);
+
+    const items = cartItems.get(event.cartId) ?? [];
+    for (const item of items) {
+      productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+    }
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, () => {
+    track(Events.ORDER_STATUS_CHANGED);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    track(Events.PAYMENT_PROCESSED);
+    const event = payload as PaymentProcessedEvent;
+    if (event.status === PaymentStatus.SUCCESS) {
+      revenue += orderTotals.get(event.orderId) ?? 0;
+    }
+  });
+
+  bus.on(Events.NOTIFICATION_SENT, () => {
+    track(Events.NOTIFICATION_SENT);
+  });
+
+  bus.on(Events.ANALYTICS_EVENT, () => {
+    track(Events.ANALYTICS_EVENT);
+  });
+
+  return {
+    getEventCount(eventType: string): number {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue(): number {
+      return revenue;
+    },
+
+    getConversionRate(): number {
+      if (cartIds.size === 0) return 0;
+      return orderCount / cartIds.size;
+    },
+
+    getTopProducts(limit: number) {
+      return [...productCounts.entries()]
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count)
+        .slice(0, limit);
+    },
+  };
+}
