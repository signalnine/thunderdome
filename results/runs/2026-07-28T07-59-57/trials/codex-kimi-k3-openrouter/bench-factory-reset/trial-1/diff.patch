@@ -0,0 +1,452 @@
+/**
+ * Factory Reset: button puzzle solvers.
+ *
+ * Part 1 (solveToggle): lights toggle over GF(2); each button is 0/1 presses.
+ * Part 2 (solveCounter): counters increment mod p (prime); each button may be
+ * pressed 0..p-1 times.
+ *
+ * Both reduce to a linear system A x = b over GF(p). We fully row-reduce A,
+ * express pivot unknowns in terms of the free unknowns, and enumerate the free
+ * space (small for the given constraints) minimizing (total presses, then
+ * lexicographic order). For very large free spaces we switch to a
+ * branch-and-bound search that visits assignments in lexicographic order.
+ */
+
+export interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+interface ReducedSystem {
+  solvable: boolean;
+  rank: number;
+  pivotCols: number[];
+  freeCols: number[];
+  /** pivotRow[j] = r means pivot column j is solved by matrix row r. */
+  pivotRow: Int32Array;
+  /** pivotFactor[j] = inverse of the pivot entry for pivot column j. */
+  pivotFactor: Int32Array;
+  /** Row-reduced (n x m) coefficient matrix. */
+  coeffs: Uint8Array[];
+  /** Row-reduced right-hand side. */
+  rhs: Int32Array;
+}
+
+/**
+ * Fully reduces the system defined by `columns` (columns[j] = field values for
+ * each row) and `rhs`, over GF(modulus).
+ */
+function reduceSystem(
+  n: number,
+  columns: number[][],
+  rhs: number[],
+  modulus: number,
+): ReducedSystem {
+  const m = columns.length;
+  const coeffs: Uint8Array[] = new Array(n);
+  for (let i = 0; i < n; i++) {
+    const row = new Uint8Array(m);
+    for (let j = 0; j < m; j++) {
+      const v = columns[j][i] % modulus;
+      row[j] = v < 0 ? v + modulus : v;
+    }
+    coeffs[i] = row;
+  }
+  const rhsArr = new Int32Array(n);
+  for (let i = 0; i < n; i++) {
+    const v = rhs[i] % modulus;
+    rhsArr[i] = v < 0 ? v + modulus : v;
+  }
+
+  const pivotRow = new Int32Array(m).fill(-1);
+  const pivotFactor = new Int32Array(m).fill(0);
+  const pivotCols: number[] = [];
+  const freeCols: number[] = [];
+  let rank = 0;
+
+  for (let j = 0; j < m; j++) {
+    let sel = -1;
+    for (let i = rank; i < n; i++) {
+      if (coeffs[i][j] !== 0) {
+        sel = i;
+        break;
+      }
+    }
+    if (sel === -1) {
+      freeCols.push(j);
+      continue;
+    }
+    if (sel !== rank) {
+      const tmpRow = coeffs[rank];
+      coeffs[rank] = coeffs[sel];
+      coeffs[sel] = tmpRow;
+      const tmpRhs = rhsArr[rank];
+      rhsArr[rank] = rhsArr[sel];
+      rhsArr[sel] = tmpRhs;
+    }
+    const a = coeffs[rank][j];
+    let inv = 1;
+    if (a !== 1) {
+      while ((inv * a) % modulus !== 1) inv++;
+      // Normalize the pivot row so the pivot entry becomes 1.
+      const pivot = coeffs[rank];
+      for (let k = 0; k < m; k++) {
+        if (pivot[k] !== 0) pivot[k] = (pivot[k] * inv) % modulus;
+      }
+      rhsArr[rank] = (rhsArr[rank] * inv) % modulus;
+    }
+    for (let i = 0; i < n; i++) {
+      if (i === rank) continue;
+      const factor = coeffs[i][j];
+      if (factor === 0) continue;
+      const target = coeffs[i];
+      const source = coeffs[rank];
+      for (let k = 0; k < m; k++) {
+        target[k] = (target[k] + (modulus - factor) * source[k]) % modulus;
+      }
+      rhsArr[i] = (rhsArr[i] + (modulus - factor) * rhsArr[rank]) % modulus;
+    }
+    pivotRow[j] = rank;
+    pivotFactor[j] = 1; // pivot rows are normalized to a leading 1
+    pivotCols.push(j);
+    rank++;
+  }
+
+  let solvable = true;
+  for (let i = rank; i < n; i++) {
+    if (rhsArr[i] !== 0) {
+      solvable = false;
+      break;
+    }
+  }
+
+  return {
+    solvable,
+    rank,
+    pivotCols,
+    freeCols,
+    pivotRow,
+    pivotFactor,
+    coeffs,
+    rhs: rhsArr,
+  };
+}
+
+/** Modulo that always returns a value in [0, p). */
+function pmod(value: number, p: number): number {
+  const r = value % p;
+  return r < 0 ? r + p : r;
+}
+
+/** Lexicographic comparison by button index order. */
+function lexCompare(a: Int32Array, b: Int32Array): number {
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] !== b[i]) return a[i] - b[i];
+  }
+  return 0;
+}
+
+/**
+ * Solves A x = b over GF(modulus) minimizing (total presses, lexicographic),
+ * where column j corresponds to button j.
+ *
+ * Strategy: fully row-reduce the system, expressing pivot unknowns in terms
+ * of the free unknowns. Small free spaces are enumerated exhaustively.
+ * Large free spaces are handled by a branch and bound (free columns ordered
+ * so pivot rows become determined early, values tried cheapest-first), seeded
+ * with a strong incumbent from coordinate-descent local search. The search is
+ * exact when it finishes within a generous time budget; if the budget ever
+ * elapses, the best valid solution found so far is returned.
+ */
+function solveMinWeight(
+  n: number,
+  columns: number[][],
+  rhs: number[],
+  modulus: number,
+): number[] | null {
+  const m = columns.length;
+  if (m === 0) {
+    for (let i = 0; i < n; i++) {
+      if (pmod(rhs[i], modulus) !== 0) return null;
+    }
+    return [];
+  }
+
+  const sys = reduceSystem(n, columns, rhs, modulus);
+  if (!sys.solvable) return null;
+
+  const freeCols = sys.freeCols;
+  const f = freeCols.length;
+  const pivots = sys.pivotCols;
+  const candidate = new Int32Array(m);
+
+  // Pivot value of column j given free values fv (indexed by free position).
+  const pivotValueOf = (j: number, fv: Int32Array, posOfFree: Map<number, number>): number => {
+    const row = sys.coeffs[sys.pivotRow[j]];
+    let acc = sys.rhs[sys.pivotRow[j]];
+    for (const k of freeCols) {
+      const c = row[k];
+      if (c !== 0) acc -= c * fv[posOfFree.get(k)!];
+    }
+    return pmod(acc * sys.pivotFactor[j], modulus);
+  };
+
+  const posOfFree = new Map<number, number>();
+  for (let s = 0; s < f; s++) posOfFree.set(freeCols[s], s);
+
+  const applyFree = (fv: Int32Array, out: Int32Array): void => {
+    for (let s = 0; s < f; s++) out[freeCols[s]] = fv[s];
+    for (const j of pivots) out[j] = pivotValueOf(j, fv, posOfFree);
+  };
+
+  if (f === 0) {
+    applyFree(new Int32Array(0), candidate);
+    return Array.from(candidate);
+  }
+
+  // Estimate enumeration size; stop early once it clearly exceeds budget.
+  const ENUM_BUDGET = 4_000_000;
+  let enumSize = 1;
+  let enumerable = f <= 21;
+  if (enumerable) {
+    for (let i = 0; i < f; i++) {
+      enumSize *= modulus;
+      if (enumSize > ENUM_BUDGET) {
+        enumerable = false;
+        break;
+      }
+    }
+  }
+
+  const best = new Int32Array(m).fill(modulus - 1);
+  let bestSum = m * (modulus - 1) + 1;
+
+  if (enumerable) {
+    const fv = new Int32Array(f);
+    for (;;) {
+      applyFree(fv, candidate);
+      let sum = 0;
+      for (let j = 0; j < m; j++) sum += candidate[j];
+      if (sum < bestSum || (sum === bestSum && lexCompare(candidate, best) < 0)) {
+        best.set(candidate);
+        bestSum = sum;
+      }
+      let s = f - 1;
+      while (s >= 0) {
+        fv[s]++;
+        if (fv[s] < modulus) break;
+        fv[s] = 0;
+        s--;
+      }
+      if (s < 0) break;
+    }
+    return Array.from(best);
+  }
+
+  // ----- Large free space: incumbent + exact branch and bound -----
+
+  // affectedPivots[s] = [pivotCol, coefficient] pairs touched by free col s.
+  const affectedPivots: [number, number][][] = new Array(f);
+  for (let s = 0; s < f; s++) affectedPivots[s] = [];
+  for (const j of pivots) {
+    const row = sys.coeffs[sys.pivotRow[j]];
+    for (let s = 0; s < f; s++) {
+      const c = row[freeCols[s]];
+      if (c !== 0) affectedPivots[s].push([j, c]);
+    }
+  }
+
+  const currentFv = new Int32Array(f);
+  const currentX = new Int32Array(m);
+  applyFree(currentFv, currentX);
+  let currentSum = 0;
+  for (let j = 0; j < m; j++) currentSum += currentX[j];
+
+  // Coordinate-descent local search to seed a strong incumbent.
+  const localImprove = (): void => {
+    let improved = true;
+    let guard = 0;
+    while (improved && guard++ < 200) {
+      improved = false;
+      for (let s = 0; s < f; s++) {
+        const affected = affectedPivots[s];
+        const oldV = currentFv[s];
+        let bestV = oldV;
+        let bestDelta = 0;
+        for (let v = 0; v < modulus; v++) {
+          if (v === oldV) continue;
+          let delta = v - oldV;
+          for (const [j, c] of affected) {
+            const xj = pmod(
+              currentX[j] - sys.pivotFactor[j] * c * (v - oldV),
+              modulus,
+            );
+            delta += xj - currentX[j];
+          }
+          if (delta < bestDelta) {
+            bestDelta = delta;
+            bestV = v;
+          }
+        }
+        if (bestV !== oldV) {
+          for (const [j, c] of affected) {
+            currentX[j] = pmod(
+              currentX[j] - sys.pivotFactor[j] * c * (bestV - oldV),
+              modulus,
+            );
+          }
+          currentFv[s] = bestV;
+          currentSum += bestDelta;
+          improved = true;
+        }
+      }
+    }
+  };
+  localImprove();
+  for (let s = 0; s < f; s++) best[freeCols[s]] = currentFv[s];
+  for (const j of pivots) best[j] = currentX[j];
+  bestSum = currentSum;
+
+  // Branch and bound. Free columns are ordered so pivot rows close early.
+  const coverage = new Int32Array(f);
+  for (let s = 0; s < f; s++) coverage[s] = affectedPivots[s].length;
+  const order = new Int32Array(f);
+  for (let s = 0; s < f; s++) order[s] = s;
+  order.sort((a, b) => (coverage[b] - coverage[a]) || (freeCols[a] - freeCols[b]));
+
+  const unassignedCount = new Int32Array(m);
+  const runningAcc = new Int32Array(m);
+  const closedValue = new Int32Array(m);
+  let baseSum = 0;
+  for (const j of pivots) {
+    const row = sys.coeffs[sys.pivotRow[j]];
+    let count = 0;
+    for (const k of freeCols) if (row[k] !== 0) count++;
+    unassignedCount[j] = count;
+    if (count === 0) {
+      closedValue[j] = pmod(sys.rhs[sys.pivotRow[j]] * sys.pivotFactor[j], modulus);
+      baseSum += closedValue[j];
+    }
+  }
+
+  const freeAssign = new Int32Array(f);
+  const solution = new Int32Array(m);
+  // Time-bounded exact search: returns the incumbent if the budget elapses.
+  const TIME_BUDGET_MS = 2000;
+  const searchStart = Date.now();
+  let nodes = 0;
+
+  const dfs = (t: number, partialSum: number): void => {
+    if (partialSum > bestSum) return;
+    nodes++;
+    if ((nodes & 0xfff) === 0 && Date.now() - searchStart > TIME_BUDGET_MS) return;
+    if (t === f) {
+      for (let s = 0; s < f; s++) solution[freeCols[s]] = freeAssign[s];
+      for (const j of pivots) solution[j] = closedValue[j];
+      if (
+        partialSum < bestSum ||
+        (partialSum === bestSum && lexCompare(solution, best) < 0)
+      ) {
+        best.set(solution);
+        bestSum = partialSum;
+      }
+      return;
+    }
+    const s = order[t];
+    const affected = affectedPivots[s];
+    // Compute each value's incremental cost, then explore cheapest first so
+    // strong incumbents are found early and sum pruning bites hard.
+    const costs = new Int32Array(modulus);
+    const closedValuesAt: [number, number][][] = new Array(modulus);
+    for (let v = 0; v < modulus; v++) {
+      let added = v;
+      const closedPairs: [number, number][] = [];
+      for (const [j, c] of affected) {
+        runningAcc[j] += c * v;
+        unassignedCount[j]--;
+        if (unassignedCount[j] === 0) {
+          const value = pmod(
+            (sys.rhs[sys.pivotRow[j]] - runningAcc[j]) * sys.pivotFactor[j],
+            modulus,
+          );
+          added += value;
+          closedPairs.push([j, value]);
+        }
+      }
+      for (const [j, c] of affected) {
+        runningAcc[j] -= c * v;
+        unassignedCount[j]++;
+      }
+      costs[v] = added;
+      closedValuesAt[v] = closedPairs;
+    }
+    const values = new Int32Array(modulus);
+    for (let v = 0; v < modulus; v++) values[v] = v;
+    values.sort((a, b) => costs[a] - costs[b] || a - b);
+    for (let vi = 0; vi < modulus; vi++) {
+      const v = values[vi];
+      if (partialSum + costs[v] > bestSum) continue;
+      if ((nodes & 0xfff) === 0 && Date.now() - searchStart > TIME_BUDGET_MS) break;
+      freeAssign[s] = v;
+      for (const [j, value] of closedValuesAt[v]) closedValue[j] = value;
+      for (const [j, c] of affected) {
+        runningAcc[j] += c * v;
+        unassignedCount[j]--;
+      }
+      dfs(t + 1, partialSum + costs[v]);
+      for (const [j, c] of affected) {
+        runningAcc[j] -= c * v;
+        unassignedCount[j]++;
+      }
+    }
+  };
+  dfs(0, baseSum);
+
+  return Array.from(best);
+}
+
+/**
+ * Part 1: minimum set of buttons to press so all lights match `target`.
+ * Buttons toggle lights over GF(2). Returns sorted button indices, or null.
+ */
+export function solveToggle(machine: Machine): number[] | null {
+  const n = machine.target.length;
+  const columns = machine.buttons.map((b) => {
+    const col = new Array<number>(n).fill(0);
+    for (const light of b) {
+      if (light >= 0 && light < n) col[light] = 1;
+    }
+    return col;
+  });
+  const rhs = machine.target.map((t) => (t ? 1 : 0));
+  const solution = solveMinWeight(n, columns, rhs, 2);
+  if (solution === null) return null;
+  const result: number[] = [];
+  for (let j = 0; j < solution.length; j++) {
+    if (solution[j] === 1) result.push(j);
+  }
+  return result;
+}
+
+/**
+ * Part 2: press counts (0..modulus-1 per button) so counters hit `lights`
+ * modulo the prime `modulus`. Returns press counts per button, or null.
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const n = lights.length;
+  const columns = buttons.map((b) => {
+    const col = new Array<number>(n).fill(0);
+    for (const counter of b) {
+      if (counter >= 0 && counter < n) {
+        col[counter] = (col[counter] + 1) % modulus;
+      }
+    }
+    return col;
+  });
+  const rhs = lights.map((v) => pmod(v, modulus));
+  return solveMinWeight(n, columns, rhs, modulus);
+}
