+// Shared types and Express request augmentation.
+
+// Authenticated principal attached to each request by the auth middleware
+// (or by the mock auth used in unit tests). Shape: { id, tenantId }.
+export interface AuthUser {
+  id: string;
+  tenantId: string;
+}
+
+declare global {
+  // eslint-disable-next-line @typescript-eslint/no-namespace
+  namespace Express {
+    interface Request {
+      user?: AuthUser;
+    }
+  }
+}
+
+export {};
diff --git a/src/users/router.ts b/src/users/router.ts
new file mode 100644
index 0000000..1f49e8e
--- /dev/null
+++ b/src/users/router.ts
@@ -0,0 +1,133 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { badRequest, conflict, forbidden, notFound, unauthorized } from '../errors';
+import { hashPassword, verifyPassword, signToken, requireUser } from '../auth';
+
+interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: string;
+  created_at: string;
+}
+
+const VALID_ROLES = ['admin', 'viewer', 'editor'];
+
+// Public-facing user shape (never includes the password hash).
+function publicUser(row: UserRow) {
+  return {
+    id: row.id,
+    email: row.email,
+    tenant_id: row.tenant_id,
+    role: row.role,
+    created_at: row.created_at,
+  };
+}
+
+const router = Router();
+
+// POST /users — register a new user.
+router.post('/', (req, res) => {
+  const { email, password, tenant_id } = req.body ?? {};
+  if (typeof email !== 'string' || !email) {
+    throw badRequest('email is required');
+  }
+  if (typeof password !== 'string' || !password) {
+    throw badRequest('password is required');
+  }
+  if (typeof tenant_id !== 'string' || !tenant_id) {
+    throw badRequest('tenant_id is required');
+  }
+
+  const db = getDb();
+  const existing = db
+    .prepare('SELECT id FROM users WHERE email = ?')
+    .get(email);
+  if (existing) {
+    throw conflict('A user with that email already exists');
+  }
+
+  const id = uuidv4();
+  try {
+    db.prepare(
+      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, email, hashPassword(password), tenant_id, 'viewer');
+  } catch (err) {
+    if (err instanceof Error && /UNIQUE/i.test(err.message)) {
+      throw conflict('A user with that email already exists');
+    }
+    throw err;
+  }
+
+  const row = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow;
+  res.status(201).json(publicUser(row));
+});
+
+// POST /users/login — authenticate and return a JWT.
+router.post('/login', (req, res) => {
+  const { email, password } = req.body ?? {};
+  if (typeof email !== 'string' || typeof password !== 'string') {
+    throw badRequest('email and password are required');
+  }
+
+  const db = getDb();
+  const row = db
+    .prepare('SELECT * FROM users WHERE email = ?')
+    .get(email) as UserRow | undefined;
+
+  if (!row || !verifyPassword(password, row.password_hash)) {
+    throw unauthorized('Invalid email or password', 'INVALID_CREDENTIALS');
+  }
+
+  const token = signToken(row.id, row.tenant_id);
+  res.status(200).json({ token, user: publicUser(row) });
+});
+
+// GET /users/me — current user's profile.
+router.get('/me', (req, res) => {
+  const { id } = requireUser(req);
+  const db = getDb();
+  const row = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as
+    | UserRow
+    | undefined;
+  if (!row) {
+    throw notFound('User not found', 'USER_NOT_FOUND');
+  }
+  res.status(200).json(publicUser(row));
+});
+
+// PATCH /users/:id/role — change a user's role (admin only).
+router.patch('/:id/role', (req, res) => {
+  const actor = requireUser(req);
+  const db = getDb();
+
+  const actorRow = db.prepare('SELECT * FROM users WHERE id = ?').get(actor.id) as
+    | UserRow
+    | undefined;
+  if (!actorRow || actorRow.role !== 'admin') {
+    throw forbidden('Only admins can change user roles');
+  }
+
+  const { role } = req.body ?? {};
+  if (typeof role !== 'string' || !VALID_ROLES.includes(role)) {
+    throw badRequest(`role must be one of: ${VALID_ROLES.join(', ')}`);
+  }
+
+  // Scope to the actor's tenant so admins cannot modify users in other tenants.
+  const target = db
+    .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')
+    .get(req.params.id, actor.tenantId) as UserRow | undefined;
+  if (!target) {
+    throw notFound('User not found', 'USER_NOT_FOUND');
+  }
+
+  db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);
+  const updated = db
+    .prepare('SELECT * FROM users WHERE id = ?')
+    .get(target.id) as UserRow;
+  res.status(200).json(publicUser(updated));
+});
+
+export default router;
diff --git a/tests/hardening.test.ts b/tests/hardening.test.ts
new file mode 100644
index 0000000..1538a13
--- /dev/null
+++ b/tests/hardening.test.ts
@@ -0,0 +1,116 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import express from 'express';
+import request from 'supertest';
+import { v4 as uuidv4 } from 'uuid';
+import Database from 'better-sqlite3';
+import { setDb, createTestDb, closeDb } from '../src/db';
+import { createApp } from '../src/app';
+import queryRouter from '../src/query/router';
+import ingestRouter from '../src/ingest/router';
+import dashboardsRouter from '../src/dashboards/router';
+import { errorHandler } from '../src/errors';
+
+function mockAuth(userId: string, tenantId: string) {
+  return (req: express.Request, _res: express.Response, next: express.NextFunction) => {
+    (req as Record<string, unknown>).user = { id: userId, tenantId };
+    next();
+  };
+}
+function authedApp(mount: string, router: express.Router) {
+  const app = express();
+  app.use(express.json());
+  app.use(mockAuth('user1', 'tenant1'));
+  app.use(mount, router);
+  app.use(errorHandler);
+  return app;
+}
+
+describe('Fix verification', () => {
+  let db: Database.Database;
+  beforeEach(() => {
+    db = createTestDb();
+    setDb(db);
+    db.prepare(
+      "INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES ('user1','u@t.com','h','tenant1','viewer')"
+    ).run();
+  });
+  afterEach(() => closeDb());
+
+  it('#1 count: ms-precision events at second-aligned boundary are included', async () => {
+    const ins = db.prepare('INSERT INTO events (id,tenant_id,name,timestamp) VALUES (?,?,?,?)');
+    ins.run(uuidv4(), 'tenant1', 'pv', '2026-06-26T00:00:00.000Z');
+    ins.run(uuidv4(), 'tenant1', 'pv', '2026-06-26T10:00:00.500Z');
+    ins.run(uuidv4(), 'tenant1', 'pv', '2026-06-26T23:59:58.000Z');
+    const res = await request(authedApp('/query', queryRouter))
+      .post('/query/count')
+      .send({ event_name: 'pv', start: '2026-06-26T00:00:00Z', end: '2026-06-26T23:59:59Z' });
+    expect(res.body.count).toBe(3); // lexicographic compare would have dropped the .000Z midnight one
+  });
+
+  it('#5 count: empty-string end bound is treated as unbounded', async () => {
+    db.prepare('INSERT INTO events (id,tenant_id,name,timestamp) VALUES (?,?,?,?)').run(
+      uuidv4(), 'tenant1', 'pv', '2024-01-15T10:00:00Z'
+    );
+    const res = await request(authedApp('/query', queryRouter))
+      .post('/query/count')
+      .send({ event_name: 'pv', end: '' });
+    expect(res.body.count).toBe(1); // not silently zeroed
+  });
+
+  it('#2 malformed JSON body returns 400 with stable code, not 500', async () => {
+    const res = await request(createApp())
+      .post('/users')
+      .set('Content-Type', 'application/json')
+      .send('{ bad json');
+    expect(res.status).toBe(400);
+    expect(typeof res.body.code).toBe('string');
+    expect(res.body.code).not.toBe('INTERNAL_ERROR');
+  });
+
+  it('#4 batch ingest with a null item returns 400, not 500', async () => {
+    const res = await request(authedApp('/events', ingestRouter))
+      .post('/events/batch')
+      .send({ events: [{ name: 'a' }, null] });
+    expect(res.status).toBe(400);
+    // atomic: nothing persisted
+    const n = db.prepare('SELECT COUNT(*) AS c FROM events').get() as { c: number };
+    expect(n.c).toBe(0);
+  });
+
+  it('#6 breakdown with malformed property_key returns 400, not 500', async () => {
+    db.prepare('INSERT INTO events (id,tenant_id,name,properties) VALUES (?,?,?,?)').run(
+      uuidv4(), 'tenant1', 'pv', JSON.stringify({ page: '/home' })
+    );
+    const res = await request(authedApp('/query', queryRouter))
+      .post('/query/breakdown')
+      .send({ event_name: 'pv', property_key: '[0]' });
+    expect(res.status).toBe(400);
+  });
+
+  it('#8 breakdown keeps JSON booleans distinct from integer 1/0', async () => {
+    const ins = db.prepare('INSERT INTO events (id,tenant_id,name,properties) VALUES (?,?,?,?)');
+    ins.run(uuidv4(), 'tenant1', 'e', JSON.stringify({ v: true }));
+    ins.run(uuidv4(), 'tenant1', 'e', JSON.stringify({ v: 1 }));
+    ins.run(uuidv4(), 'tenant1', 'e', JSON.stringify({ v: 1 }));
+    const res = await request(authedApp('/query', queryRouter))
+      .post('/query/breakdown')
+      .send({ event_name: 'e', property_key: 'v' });
+    const values = res.body.data.map((d: { property_value: unknown }) => d.property_value);
+    expect(values).toContain('true'); // boolean not merged into 1
+    const numEntry = res.body.data.find((d: { property_value: unknown }) => d.property_value === 1);
+    expect(numEntry.count).toBe(2); // the two numeric 1s, not 3
+  });
+
+  it('#3 widget Update (PATCH) works', async () => {
+    const dash = await request(authedApp('/dashboards', dashboardsRouter))
+      .post('/dashboards').send({ name: 'D' });
+    const w = await request(authedApp('/dashboards', dashboardsRouter))
+      .post(`/dashboards/${dash.body.id}/widgets`).send({ type: 'counter', config: {} });
+    const res = await request(authedApp('/dashboards', dashboardsRouter))
+      .patch(`/dashboards/${dash.body.id}/widgets/${w.body.id}`)
+      .send({ type: 'timeseries', width: 4 });
+    expect(res.status).toBe(200);
+    expect(res.body.type).toBe('timeseries');
+    expect(res.body.width).toBe(4);
+  });
+});
