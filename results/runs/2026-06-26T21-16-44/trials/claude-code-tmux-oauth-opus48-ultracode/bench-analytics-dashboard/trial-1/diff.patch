diff --git a/src/app.ts b/src/app.ts
new file mode 100644
index 0000000..3d4f234
--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,49 @@
+import express from 'express';
+import type { Request, Response, NextFunction } from 'express';
+import './types';
+import { authMiddleware } from './auth';
+import { errorHandler } from './errors';
+import usersRouter from './users/router';
+import ingestRouter from './ingest/router';
+import queryRouter from './query/router';
+import dashboardsRouter from './dashboards/router';
+import exportRouter from './export/router';
+
+// Routes that must be reachable without authentication.
+function isPublic(req: Request): boolean {
+  return (
+    req.method === 'POST' && (req.path === '/users' || req.path === '/users/login')
+  );
+}
+
+export function createApp(): express.Express {
+  const app = express();
+  app.use(express.json());
+
+  // Apply real JWT auth to everything except the public registration/login routes.
+  app.use((req: Request, res: Response, next: NextFunction) => {
+    if (isPublic(req)) {
+      next();
+      return;
+    }
+    authMiddleware(req, res, next);
+  });
+
+  app.use('/users', usersRouter);
+  app.use('/events', ingestRouter);
+  app.use('/query', queryRouter);
+  app.use('/dashboards', dashboardsRouter);
+  app.use('/export', exportRouter);
+
+  app.use(errorHandler);
+  return app;
+}
+
+// Start a server when executed directly (not when imported by tests).
+if (require.main === module) {
+  const port = Number(process.env.PORT) || 3000;
+  createApp().listen(port, () => {
+    // eslint-disable-next-line no-console
+    console.log(`Analytics dashboard API listening on :${port}`);
+  });
+}
diff --git a/src/auth.ts b/src/auth.ts
new file mode 100644
index 0000000..8f00f3b
--- /dev/null
+++ b/src/auth.ts
@@ -0,0 +1,79 @@
+import { randomBytes, scryptSync, timingSafeEqual } from 'crypto';
+import jwt from 'jsonwebtoken';
+import type { Request, Response, NextFunction } from 'express';
+import { unauthorized } from './errors';
+import type { AuthUser } from './types';
+
+// Secret used to sign/verify JWTs. Overridable via env for real deployments.
+const JWT_SECRET: string = process.env.JWT_SECRET || 'bench-t8-dev-secret';
+const TOKEN_TTL = '24h';
+
+// --- Password hashing (scrypt, no external dependency) ---
+
+export function hashPassword(password: string): string {
+  const salt = randomBytes(16);
+  const derived = scryptSync(password, salt, 64);
+  return `${salt.toString('hex')}:${derived.toString('hex')}`;
+}
+
+export function verifyPassword(password: string, stored: string): boolean {
+  const [saltHex, hashHex] = stored.split(':');
+  if (!saltHex || !hashHex) return false;
+  const salt = Buffer.from(saltHex, 'hex');
+  const expected = Buffer.from(hashHex, 'hex');
+  const derived = scryptSync(password, salt, 64);
+  if (derived.length !== expected.length) return false;
+  return timingSafeEqual(derived, expected);
+}
+
+// --- JWT ---
+
+interface TokenClaims {
+  sub: string;
+  tid: string;
+}
+
+// Sign a token whose decoded payload is { sub, tid, iat, exp }.
+export function signToken(userId: string, tenantId: string): string {
+  const claims: TokenClaims = { sub: userId, tid: tenantId };
+  return jwt.sign(claims, JWT_SECRET, { expiresIn: TOKEN_TTL });
+}
+
+export function verifyToken(token: string): AuthUser {
+  const payload = jwt.verify(token, JWT_SECRET) as Partial<TokenClaims>;
+  if (!payload.sub || !payload.tid) {
+    throw new Error('Malformed token claims');
+  }
+  return { id: payload.sub, tenantId: payload.tid };
+}
+
+// --- Auth middleware (used by the real app, not the unit tests) ---
+
+// Validates the Bearer JWT and attaches req.user = { id, tenantId }.
+// Both missing and invalid credentials yield 401 with code AUTH_ERROR.
+export function authMiddleware(
+  req: Request,
+  _res: Response,
+  next: NextFunction
+): void {
+  const header = req.headers.authorization;
+  if (!header || !header.startsWith('Bearer ')) {
+    next(unauthorized('Missing or malformed Authorization header'));
+    return;
+  }
+  const token = header.slice('Bearer '.length).trim();
+  try {
+    req.user = verifyToken(token);
+    next();
+  } catch {
+    next(unauthorized('Invalid or expired token'));
+  }
+}
+
+// Helper: read the authenticated user or throw 401 if absent.
+export function requireUser(req: Request): AuthUser {
+  if (!req.user) {
+    throw unauthorized('Authentication required');
+  }
+  return req.user;
+}
diff --git a/src/dashboards/router.ts b/src/dashboards/router.ts
new file mode 100644
index 0000000..6c279bb
--- /dev/null
+++ b/src/dashboards/router.ts
@@ -0,0 +1,224 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import type Database from 'better-sqlite3';
+import { getDb } from '../db';
+import { badRequest, notFound } from '../errors';
+import { requireUser } from '../auth';
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+const WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];
+
+function parseJson(text: string): Record<string, unknown> {
+  try {
+    const parsed = JSON.parse(text);
+    return parsed && typeof parsed === 'object' ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+function dashboardView(row: DashboardRow) {
+  return { ...row, config: parseJson(row.config) };
+}
+
+function widgetView(row: WidgetRow) {
+  return { ...row, config: parseJson(row.config) };
+}
+
+// Load a dashboard scoped to the tenant, or throw 404.
+function loadDashboard(
+  db: Database.Database,
+  id: string,
+  tenantId: string
+): DashboardRow {
+  const row = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(id, tenantId) as DashboardRow | undefined;
+  if (!row) {
+    throw notFound('Dashboard not found', 'DASHBOARD_NOT_FOUND');
+  }
+  return row;
+}
+
+const router = Router();
+
+// POST /dashboards — create.
+router.post('/', (req, res) => {
+  const { id: ownerId, tenantId } = requireUser(req);
+  const { name, config } = req.body ?? {};
+  if (typeof name !== 'string' || !name) {
+    throw badRequest('name is required');
+  }
+
+  const id = uuidv4();
+  const db = getDb();
+  db.prepare(
+    'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'
+  ).run(id, tenantId, name, ownerId, JSON.stringify(config ?? {}));
+
+  const row = db
+    .prepare('SELECT * FROM dashboards WHERE id = ?')
+    .get(id) as DashboardRow;
+  res.status(201).json(dashboardView(row));
+});
+
+// GET /dashboards — list for the current tenant.
+router.get('/', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const rows = getDb()
+    .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at ASC, id ASC')
+    .all(tenantId) as DashboardRow[];
+  res.status(200).json(rows.map(dashboardView));
+});
+
+// GET /dashboards/:id — single dashboard with its widgets.
+router.get('/:id', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const db = getDb();
+  const dashboard = loadDashboard(db, req.params.id, tenantId);
+  const widgets = db
+    .prepare('SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y ASC, position_x ASC, id ASC')
+    .all(dashboard.id) as WidgetRow[];
+  res.status(200).json({ ...dashboardView(dashboard), widgets: widgets.map(widgetView) });
+});
+
+// PATCH /dashboards/:id — update name and/or config.
+router.patch('/:id', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const db = getDb();
+  const existing = loadDashboard(db, req.params.id, tenantId);
+
+  const { name, config } = req.body ?? {};
+  const nextName = typeof name === 'string' && name ? name : existing.name;
+  const nextConfig =
+    config !== undefined ? JSON.stringify(config) : existing.config;
+
+  db.prepare(
+    'UPDATE dashboards SET name = ?, config = ?, updated_at = ? WHERE id = ?'
+  ).run(nextName, nextConfig, new Date().toISOString(), existing.id);
+
+  const row = db
+    .prepare('SELECT * FROM dashboards WHERE id = ?')
+    .get(existing.id) as DashboardRow;
+  res.status(200).json(dashboardView(row));
+});
+
+// DELETE /dashboards/:id — remove dashboard (widgets cascade).
+router.delete('/:id', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const db = getDb();
+  const existing = loadDashboard(db, req.params.id, tenantId);
+  db.prepare('DELETE FROM dashboards WHERE id = ?').run(existing.id);
+  res.status(204).end();
+});
+
+// POST /dashboards/:id/widgets — add a widget.
+router.post('/:id/widgets', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const db = getDb();
+  const dashboard = loadDashboard(db, req.params.id, tenantId);
+
+  const { type, config, position_x, position_y, width, height } = req.body ?? {};
+  if (typeof type !== 'string' || !WIDGET_TYPES.includes(type)) {
+    throw badRequest(`widget type must be one of: ${WIDGET_TYPES.join(', ')}`);
+  }
+
+  const id = uuidv4();
+  db.prepare(
+    `INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height)
+     VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
+  ).run(
+    id,
+    dashboard.id,
+    type,
+    JSON.stringify(config ?? {}),
+    Number.isInteger(position_x) ? position_x : 0,
+    Number.isInteger(position_y) ? position_y : 0,
+    Number.isInteger(width) ? width : 1,
+    Number.isInteger(height) ? height : 1
+  );
+
+  const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as WidgetRow;
+  res.status(201).json(widgetView(row));
+});
+
+// PATCH /dashboards/:id/widgets/:widgetId — update a widget.
+router.patch('/:id/widgets/:widgetId', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const db = getDb();
+  const dashboard = loadDashboard(db, req.params.id, tenantId);
+
+  const widget = db
+    .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')
+    .get(req.params.widgetId, dashboard.id) as WidgetRow | undefined;
+  if (!widget) {
+    throw notFound('Widget not found', 'WIDGET_NOT_FOUND');
+  }
+
+  const { type, config, position_x, position_y, width, height } = req.body ?? {};
+  if (type !== undefined && (typeof type !== 'string' || !WIDGET_TYPES.includes(type))) {
+    throw badRequest(`widget type must be one of: ${WIDGET_TYPES.join(', ')}`);
+  }
+
+  const next = {
+    type: typeof type === 'string' ? type : widget.type,
+    config: config !== undefined ? JSON.stringify(config) : widget.config,
+    position_x: Number.isInteger(position_x) ? position_x : widget.position_x,
+    position_y: Number.isInteger(position_y) ? position_y : widget.position_y,
+    width: Number.isInteger(width) ? width : widget.width,
+    height: Number.isInteger(height) ? height : widget.height,
+  };
+
+  db.prepare(
+    `UPDATE widgets SET type = ?, config = ?, position_x = ?, position_y = ?, width = ?, height = ? WHERE id = ?`
+  ).run(
+    next.type,
+    next.config,
+    next.position_x,
+    next.position_y,
+    next.width,
+    next.height,
+    widget.id
+  );
+
+  const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(widget.id) as WidgetRow;
+  res.status(200).json(widgetView(row));
+});
+
+// DELETE /dashboards/:id/widgets/:widgetId — remove a widget.
+router.delete('/:id/widgets/:widgetId', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const db = getDb();
+  const dashboard = loadDashboard(db, req.params.id, tenantId);
+
+  const widget = db
+    .prepare('SELECT id FROM widgets WHERE id = ? AND dashboard_id = ?')
+    .get(req.params.widgetId, dashboard.id) as { id: string } | undefined;
+  if (!widget) {
+    throw notFound('Widget not found', 'WIDGET_NOT_FOUND');
+  }
+  db.prepare('DELETE FROM widgets WHERE id = ?').run(widget.id);
+  res.status(204).end();
+});
+
+export default router;
diff --git a/src/db.ts b/src/db.ts
new file mode 100644
index 0000000..0ac6541
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,92 @@
+import Database from 'better-sqlite3';
+
+// The schema is embedded here (rather than read from schema.sql at runtime) so
+// that it works identically whether running from source (vitest) or from the
+// compiled dist/ output. It mirrors schema.sql exactly.
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS users (
+  id TEXT PRIMARY KEY,
+  email TEXT NOT NULL UNIQUE,
+  password_hash TEXT NOT NULL,
+  tenant_id TEXT NOT NULL,
+  role TEXT NOT NULL DEFAULT 'viewer' CHECK(role IN ('admin', 'viewer', 'editor')),
+  created_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+
+CREATE TABLE IF NOT EXISTS events (
+  id TEXT PRIMARY KEY,
+  tenant_id TEXT NOT NULL,
+  name TEXT NOT NULL,
+  properties TEXT NOT NULL DEFAULT '{}',
+  timestamp TEXT NOT NULL DEFAULT (datetime('now')),
+  user_id TEXT,
+  session_id TEXT
+);
+
+CREATE TABLE IF NOT EXISTS dashboards (
+  id TEXT PRIMARY KEY,
+  tenant_id TEXT NOT NULL,
+  name TEXT NOT NULL,
+  owner_id TEXT NOT NULL,
+  config TEXT NOT NULL DEFAULT '{}',
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  updated_at TEXT NOT NULL DEFAULT (datetime('now')),
+  FOREIGN KEY (owner_id) REFERENCES users(id)
+);
+
+CREATE TABLE IF NOT EXISTS widgets (
+  id TEXT PRIMARY KEY,
+  dashboard_id TEXT NOT NULL,
+  type TEXT NOT NULL CHECK(type IN ('counter', 'timeseries', 'breakdown', 'funnel')),
+  config TEXT NOT NULL DEFAULT '{}',
+  position_x INTEGER NOT NULL DEFAULT 0,
+  position_y INTEGER NOT NULL DEFAULT 0,
+  width INTEGER NOT NULL DEFAULT 1,
+  height INTEGER NOT NULL DEFAULT 1,
+  FOREIGN KEY (dashboard_id) REFERENCES dashboards(id) ON DELETE CASCADE
+);
+
+CREATE INDEX IF NOT EXISTS idx_events_tenant ON events(tenant_id);
+CREATE INDEX IF NOT EXISTS idx_events_name ON events(name);
+CREATE INDEX IF NOT EXISTS idx_events_timestamp ON events(timestamp);
+CREATE INDEX IF NOT EXISTS idx_dashboards_tenant ON dashboards(tenant_id);
+CREATE INDEX IF NOT EXISTS idx_users_tenant ON users(tenant_id);
+`;
+
+let currentDb: Database.Database | null = null;
+
+// Apply the schema and enable foreign-key enforcement (needed for the
+// widgets -> dashboards ON DELETE CASCADE and owner_id references).
+function initDb(db: Database.Database): Database.Database {
+  db.pragma('foreign_keys = ON');
+  db.exec(SCHEMA);
+  return db;
+}
+
+// Create a fresh in-memory database with the schema applied. Does NOT set it as
+// the active database; callers use setDb() for that.
+export function createTestDb(): Database.Database {
+  return initDb(new Database(':memory:'));
+}
+
+// Set the active database used by request handlers via getDb().
+export function setDb(db: Database.Database): void {
+  currentDb = db;
+}
+
+// Return the active database, lazily creating a file-backed one if none has been
+// set (e.g. when the app is run normally rather than under test).
+export function getDb(): Database.Database {
+  if (!currentDb) {
+    currentDb = initDb(new Database(process.env.DB_PATH || 'analytics.db'));
+  }
+  return currentDb;
+}
+
+// Close and clear the active database (used in test teardown).
+export function closeDb(): void {
+  if (currentDb) {
+    currentDb.close();
+    currentDb = null;
+  }
+}
diff --git a/src/errors.ts b/src/errors.ts
new file mode 100644
index 0000000..5f30fad
--- /dev/null
+++ b/src/errors.ts
@@ -0,0 +1,66 @@
+import type { Request, Response, NextFunction } from 'express';
+
+// Application error carrying an HTTP status and a stable machine-readable code.
+// Handlers throw these synchronously; Express forwards them to errorHandler.
+export class ApiError extends Error {
+  constructor(
+    public readonly status: number,
+    public readonly code: string,
+    message: string
+  ) {
+    super(message);
+    this.name = 'ApiError';
+  }
+}
+
+// Convenience constructors for common cases.
+export const badRequest = (message: string, code = 'BAD_REQUEST'): ApiError =>
+  new ApiError(400, code, message);
+export const unauthorized = (message: string, code = 'AUTH_ERROR'): ApiError =>
+  new ApiError(401, code, message);
+export const forbidden = (message: string, code = 'FORBIDDEN'): ApiError =>
+  new ApiError(403, code, message);
+export const notFound = (message: string, code = 'NOT_FOUND'): ApiError =>
+  new ApiError(404, code, message);
+export const conflict = (message: string, code = 'CONFLICT'): ApiError =>
+  new ApiError(409, code, message);
+
+// Read a numeric HTTP status off an arbitrary thrown value (e.g. body-parser
+// attaches status/statusCode on malformed-JSON or payload-too-large errors).
+function statusFromError(err: unknown): number | undefined {
+  if (err && typeof err === 'object') {
+    const obj = err as { status?: unknown; statusCode?: unknown };
+    if (typeof obj.status === 'number') return obj.status;
+    if (typeof obj.statusCode === 'number') return obj.statusCode;
+  }
+  return undefined;
+}
+
+// Express error-handling middleware. Always responds with { error, code }.
+// Must keep the 4-arg signature for Express to treat it as an error handler.
+export function errorHandler(
+  err: unknown,
+  _req: Request,
+  res: Response,
+  // eslint-disable-next-line @typescript-eslint/no-unused-vars
+  _next: NextFunction
+): void {
+  if (err instanceof ApiError) {
+    res.status(err.status).json({ error: err.message, code: err.code });
+    return;
+  }
+
+  const message = err instanceof Error ? err.message : 'Internal server error';
+
+  // Honor client-error statuses framework middleware attaches (e.g. a 400 from
+  // express.json() on a malformed body, or 413 on an oversized payload) so a
+  // client fault is not reported as a 500.
+  const status = statusFromError(err);
+  if (status !== undefined && status >= 400 && status < 500) {
+    const code = status === 413 ? 'PAYLOAD_TOO_LARGE' : 'BAD_REQUEST';
+    res.status(status).json({ error: message, code });
+    return;
+  }
+
+  res.status(500).json({ error: message, code: 'INTERNAL_ERROR' });
+}
