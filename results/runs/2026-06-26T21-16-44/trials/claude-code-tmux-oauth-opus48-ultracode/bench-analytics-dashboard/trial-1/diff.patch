new file mode 100644
index 0000000..9895aaf
--- /dev/null
+++ b/src/export/router.ts
@@ -0,0 +1,116 @@
+import { Router } from 'express';
+import { getDb } from '../db';
+import { badRequest, notFound } from '../errors';
+import { requireUser } from '../auth';
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+const EVENT_COLUMNS: (keyof EventRow)[] = [
+  'id',
+  'tenant_id',
+  'name',
+  'properties',
+  'timestamp',
+  'user_id',
+  'session_id',
+];
+
+function parseJson(text: string): Record<string, unknown> {
+  try {
+    const parsed = JSON.parse(text);
+    return parsed && typeof parsed === 'object' ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+// RFC-4180-style CSV field escaping.
+function csvField(value: unknown): string {
+  const s = value === null || value === undefined ? '' : String(value);
+  if (/[",\n\r]/.test(s)) {
+    return `"${s.replace(/"/g, '""')}"`;
+  }
+  return s;
+}
+
+const router = Router();
+
+// GET /export/events?format=csv|json — export the tenant's events.
+router.get('/events', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const format = typeof req.query.format === 'string' ? req.query.format : 'json';
+  if (format !== 'json' && format !== 'csv') {
+    throw badRequest("format must be 'csv' or 'json'", 'INVALID_FORMAT');
+  }
+
+  const rows = getDb()
+    .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp ASC, rowid ASC')
+    .all(tenantId) as EventRow[];
+
+  if (format === 'csv') {
+    const header = EVENT_COLUMNS.join(',');
+    const lines = rows.map((row) =>
+      EVENT_COLUMNS.map((col) => csvField(row[col])).join(',')
+    );
+    const csv = [header, ...lines].join('\n');
+    res.status(200).type('text/csv').send(csv);
+    return;
+  }
+
+  res
+    .status(200)
+    .json(rows.map((row) => ({ ...row, properties: parseJson(row.properties) })));
+});
+
+// GET /export/dashboard/:id — export a dashboard with its widgets.
+router.get('/dashboard/:id', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const db = getDb();
+
+  const dashboard = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(req.params.id, tenantId) as DashboardRow | undefined;
+  if (!dashboard) {
+    throw notFound('Dashboard not found', 'DASHBOARD_NOT_FOUND');
+  }
+
+  const widgets = db
+    .prepare('SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y ASC, position_x ASC, id ASC')
+    .all(dashboard.id) as WidgetRow[];
+
+  res.status(200).json({
+    dashboard: { ...dashboard, config: parseJson(dashboard.config) },
+    widgets: widgets.map((w) => ({ ...w, config: parseJson(w.config) })),
+  });
+});
+
+export default router;
diff --git a/src/ingest/router.ts b/src/ingest/router.ts
new file mode 100644
index 0000000..9099c10
--- /dev/null
+++ b/src/ingest/router.ts
@@ -0,0 +1,95 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import type Database from 'better-sqlite3';
+import { getDb } from '../db';
+import { badRequest } from '../errors';
+import { requireUser } from '../auth';
+
+interface EventInput {
+  name?: unknown;
+  properties?: unknown;
+  timestamp?: unknown;
+  session_id?: unknown;
+  user_id?: unknown;
+}
+
+interface StoredEvent {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: Record<string, unknown>;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+// Validate and normalize a single event payload, then persist it.
+function insertEvent(
+  db: Database.Database,
+  tenantId: string,
+  actorId: string,
+  raw: unknown
+): StoredEvent {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+    throw badRequest('each event must be an object');
+  }
+  const input = raw as EventInput;
+  if (typeof input.name !== 'string' || !input.name) {
+    throw badRequest('event name is required');
+  }
+  const id = uuidv4();
+  const properties =
+    input.properties && typeof input.properties === 'object'
+      ? (input.properties as Record<string, unknown>)
+      : {};
+  const timestamp =
+    typeof input.timestamp === 'string' && input.timestamp
+      ? input.timestamp
+      : new Date().toISOString();
+  const sessionId =
+    typeof input.session_id === 'string' ? input.session_id : null;
+  const userId =
+    typeof input.user_id === 'string' ? input.user_id : actorId;
+
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  ).run(id, tenantId, input.name, JSON.stringify(properties), timestamp, userId, sessionId);
+
+  return {
+    id,
+    tenant_id: tenantId,
+    name: input.name,
+    properties,
+    timestamp,
+    user_id: userId,
+    session_id: sessionId,
+  };
+}
+
+const router = Router();
+
+// POST /events — ingest a single event.
+router.post('/', (req, res) => {
+  const { id: actorId, tenantId } = requireUser(req);
+  const event = insertEvent(getDb(), tenantId, actorId, req.body ?? {});
+  res.status(201).json(event);
+});
+
+// POST /events/batch — ingest many events atomically.
+router.post('/batch', (req, res) => {
+  const { id: actorId, tenantId } = requireUser(req);
+  const events = (req.body ?? {}).events;
+  if (!Array.isArray(events) || events.length === 0) {
+    throw badRequest('events must be a non-empty array');
+  }
+
+  const db = getDb();
+  const insertAll = db.transaction((items: EventInput[]) =>
+    items.map((item) => insertEvent(db, tenantId, actorId, item))
+  );
+  const inserted = insertAll(events);
+
+  res.status(201).json({ inserted: inserted.length, events: inserted });
+});
+
+export default router;
diff --git a/src/query/router.ts b/src/query/router.ts
new file mode 100644
index 0000000..16b2e20
--- /dev/null
+++ b/src/query/router.ts
@@ -0,0 +1,216 @@
+import { Router } from 'express';
+import { getDb } from '../db';
+import { badRequest } from '../errors';
+import { requireUser } from '../auth';
+
+const router = Router();
+
+// A parsed, optional [start, end] time window in epoch milliseconds. Comparing
+// parsed instants (rather than raw ISO strings) keeps the filter correct across
+// mixed-precision timestamps, e.g. '2024-01-15T10:00:00Z' vs '...10:00:00.500Z'.
+interface TimeRange {
+  startMs: number | null;
+  endMs: number | null;
+  hasBound: boolean;
+}
+
+// Parse a single bound. Empty / non-string / unparseable values mean "no bound".
+function parseBound(value: unknown): number | null {
+  if (typeof value !== 'string' || !value) return null;
+  const ms = Date.parse(value);
+  return Number.isNaN(ms) ? null : ms;
+}
+
+function parseRange(start: unknown, end: unknown): TimeRange {
+  const startMs = parseBound(start);
+  const endMs = parseBound(end);
+  return { startMs, endMs, hasBound: startMs !== null || endMs !== null };
+}
+
+function inRange(timestamp: string, range: TimeRange): boolean {
+  const ms = Date.parse(timestamp);
+  if (Number.isNaN(ms)) return false;
+  if (range.startMs !== null && ms < range.startMs) return false;
+  if (range.endMs !== null && ms > range.endMs) return false;
+  return true;
+}
+
+// Resolve the time-bucket key for a single ISO timestamp. Works by string
+// slicing on the canonical ISO format, so it is independent of the SQLite
+// build's date-function behavior.
+function bucketKey(timestamp: string, bucket: string): string {
+  switch (bucket) {
+    case 'hour':
+      return `${timestamp.slice(0, 13)}:00`;
+    case 'week': {
+      const d = new Date(timestamp);
+      // ISO week: Thursday-anchored.
+      const tmp = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()));
+      const day = tmp.getUTCDay() || 7;
+      tmp.setUTCDate(tmp.getUTCDate() + 4 - day);
+      const yearStart = new Date(Date.UTC(tmp.getUTCFullYear(), 0, 1));
+      const week = Math.ceil(((tmp.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
+      return `${tmp.getUTCFullYear()}-W${String(week).padStart(2, '0')}`;
+    }
+    case 'month':
+      return timestamp.slice(0, 7);
+    case 'day':
+    default:
+      return timestamp.slice(0, 10);
+  }
+}
+
+// POST /query/count — number of matching events.
+router.post('/count', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const { event_name, start, end } = req.body ?? {};
+  if (typeof event_name !== 'string' || !event_name) {
+    throw badRequest('event_name is required');
+  }
+
+  const range = parseRange(start, end);
+  const db = getDb();
+
+  // Fast path: no time window -> aggregate in SQL.
+  if (!range.hasBound) {
+    const row = db
+      .prepare('SELECT COUNT(*) AS count FROM events WHERE tenant_id = ? AND name = ?')
+      .get(tenantId, event_name) as { count: number };
+    res.status(200).json({ count: row.count });
+    return;
+  }
+
+  const rows = db
+    .prepare('SELECT timestamp FROM events WHERE tenant_id = ? AND name = ?')
+    .all(tenantId, event_name) as { timestamp: string }[];
+  const count = rows.filter((r) => inRange(r.timestamp, range)).length;
+  res.status(200).json({ count });
+});
+
+// POST /query/timeseries — event counts bucketed over time.
+router.post('/timeseries', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const { event_name, bucket, start, end } = req.body ?? {};
+  if (typeof event_name !== 'string' || !event_name) {
+    throw badRequest('event_name is required');
+  }
+  const bucketSize = typeof bucket === 'string' ? bucket : 'day';
+  const range = parseRange(start, end);
+
+  const rows = getDb()
+    .prepare('SELECT timestamp FROM events WHERE tenant_id = ? AND name = ?')
+    .all(tenantId, event_name) as { timestamp: string }[];
+
+  const counts = new Map<string, number>();
+  for (const r of rows) {
+    if (range.hasBound && !inRange(r.timestamp, range)) continue;
+    const key = bucketKey(r.timestamp, bucketSize);
+    counts.set(key, (counts.get(key) ?? 0) + 1);
+  }
+
+  const data = [...counts.entries()]
+    .sort((a, b) => (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0))
+    .map(([b, count]) => ({ bucket: b, count }));
+
+  res.status(200).json({ data });
+});
+
+// POST /query/breakdown — counts grouped by a JSON property value.
+router.post('/breakdown', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const { event_name, property_key } = req.body ?? {};
+  if (typeof event_name !== 'string' || !event_name) {
+    throw badRequest('event_name is required');
+  }
+  if (typeof property_key !== 'string' || !property_key) {
+    throw badRequest('property_key is required');
+  }
+
+  const path = `$.${property_key}`;
+  let rows: { property_value: string | number | null; count: number }[];
+  try {
+    // Use json_type to keep JSON booleans distinct from the integers 1/0 that
+    // json_extract would otherwise coerce them into. String/number values pass
+    // through json_extract unchanged.
+    rows = getDb()
+      .prepare(
+        `SELECT CASE json_type(properties, ?)
+                  WHEN 'true' THEN 'true'
+                  WHEN 'false' THEN 'false'
+                  ELSE json_extract(properties, ?)
+                END AS property_value,
+                COUNT(*) AS count
+         FROM events
+         WHERE tenant_id = ? AND name = ?
+         GROUP BY property_value
+         ORDER BY count DESC, property_value ASC`
+      )
+      .all(path, path, tenantId, event_name) as typeof rows;
+  } catch {
+    // A malformed property_key yields an invalid JSON path; report it as a
+    // client error rather than a 500.
+    throw badRequest('property_key is not a valid JSON property path', 'INVALID_PROPERTY_KEY');
+  }
+
+  const data = rows
+    .filter((r) => r.property_value !== null)
+    .map((r) => ({ property_value: r.property_value, count: r.count }));
+
+  res.status(200).json({ data });
+});
+
+// POST /query/funnel — per-session multi-step conversion analysis.
+router.post('/funnel', (req, res) => {
+  const { tenantId } = requireUser(req);
+  const { steps } = req.body ?? {};
+  if (!Array.isArray(steps) || steps.length === 0) {
+    throw badRequest('steps must be a non-empty array');
+  }
+  if (!steps.every((s) => typeof s === 'string' && s)) {
+    throw badRequest('every funnel step must be a non-empty string');
+  }
+
+  const placeholders = steps.map(() => '?').join(', ');
+  const rows = getDb()
+    .prepare(
+      `SELECT session_id, name FROM events
+       WHERE tenant_id = ? AND name IN (${placeholders})
+       ORDER BY timestamp ASC, rowid ASC`
+    )
+    .all(tenantId, ...steps) as { session_id: string | null; name: string }[];
+
+  // Group event names per session, preserving chronological order.
+  const sessions = new Map<string, string[]>();
+  for (const r of rows) {
+    const key = r.session_id ?? `__nosession__:${sessions.size}`;
+    const list = sessions.get(key) ?? [];
+    list.push(r.name);
+    sessions.set(key, list);
+  }
+
+  // Greedily match the step sequence within each session; record how deep it got.
+  const reached = new Array<number>(steps.length).fill(0);
+  for (const names of sessions.values()) {
+    let depth = 0;
+    for (const name of names) {
+      if (depth < steps.length && name === steps[depth]) {
+        depth += 1;
+      }
+    }
+    for (let i = 0; i < depth; i += 1) {
+      reached[i] += 1;
+    }
+  }
+
+  const firstCount = reached[0] || 0;
+  const result = steps.map((name: string, i: number) => ({
+    step: i + 1,
+    name,
+    count: reached[i],
+    conversion_rate: firstCount === 0 ? 0 : reached[i] / firstCount,
+  }));
+
+  res.status(200).json({ steps: result });
+});
+
+export default router;
