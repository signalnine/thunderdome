new file mode 100644
index 0000000..d1c1364
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,113 @@
+export type Direction = 'down' | 'left' | 'right';
+
+interface Beam {
+  row: number;
+  col: number;
+  dir: Direction;
+}
+
+const DELTAS: Record<Direction, [number, number]> = {
+  down: [1, 0],
+  left: [1, -1],
+  right: [1, 1],
+};
+
+function findSource(grid: string[][]): { row: number; col: number } | null {
+  for (let col = 0; col < grid[0].length; col++) {
+    if (grid[0][col] === 'S') {
+      return { row: 0, col };
+    }
+  }
+  return null;
+}
+
+export function countBeamCells(grid: string[][]): number {
+  if (grid.length === 0 || grid[0].length === 0) {
+    return 0;
+  }
+
+  const source = findSource(grid);
+  if (!source) {
+    return 0;
+  }
+
+  const rows = grid.length;
+  const cols = grid[0].length;
+  const visited = new Set<number>();
+  const seen = new Set<number>();
+  const queue: Beam[] = [{ ...source, dir: 'down' as Direction }];
+
+  const cellKey = (r: number, c: number): number => r * cols + c;
+  const stateKey = (r: number, c: number, d: Direction): number =>
+    (r * cols + c) * 3 + (d === 'down' ? 0 : d === 'left' ? 1 : 2);
+
+  visited.add(cellKey(source.row, source.col));
+
+  while (queue.length > 0) {
+    const { row, col, dir } = queue.pop() as Beam;
+    const sKey = stateKey(row, col, dir);
+    if (seen.has(sKey)) continue;
+    seen.add(sKey);
+
+    const isSplitter = grid[row][col] === '^';
+    const nextDirs: Direction[] = isSplitter ? ['left', 'right'] : [dir];
+
+    for (const nextDir of nextDirs) {
+      const [dr, dc] = DELTAS[nextDir];
+      const nr = row + dr;
+      const nc = col + dc;
+      if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
+        continue;
+      }
+      visited.add(cellKey(nr, nc));
+      queue.push({ row: nr, col: nc, dir: nextDir });
+    }
+  }
+
+  return visited.size;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  if (grid.length === 0 || grid[0].length === 0) {
+    return 0n;
+  }
+
+  const source = findSource(grid);
+  if (!source) {
+    return 0n;
+  }
+
+  const rows = grid.length;
+  const cols = grid[0].length;
+  const memo = new Map<number, bigint>();
+  const UNSET = -1n;
+
+  const stateKey = (r: number, c: number, d: Direction): number =>
+    (r * cols + c) * 3 + (d === 'down' ? 0 : d === 'left' ? 1 : 2);
+
+  const count = (row: number, col: number, dir: Direction): bigint => {
+    if (row < 0 || row >= rows || col < 0 || col >= cols) {
+      return 1n;
+    }
+
+    const key = stateKey(row, col, dir);
+    const cached = memo.get(key);
+    if (cached !== undefined) {
+      return cached;
+    }
+    memo.set(key, UNSET);
+
+    let result: bigint;
+    if (grid[row][col] === '^') {
+      result = count(row + 1, col - 1, 'left') + count(row + 1, col + 1, 'right');
+    } else {
+      const [dr, dc] = DELTAS[dir];
+      result = count(row + dr, col + dc, dir);
+    }
+
+    memo.set(key, result);
+    return result;
+  };
+
+  return count(source.row, source.col, 'down');
+}
diff --git a/tests/beam.test.ts b/tests/beam.test.ts
new file mode 100644
index 0000000..86e3c73
--- /dev/null
+++ b/tests/beam.test.ts
@@ -0,0 +1,143 @@
+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index.js';
+
+function g(...rows: string[]): string[][] {
+  return rows.map((r) => Array.from(r).filter((c) => c !== ' '));
+}
+
+describe('countBeamCells', () => {
+  it('example 1: single splitter', () => {
+    const grid = g(
+      '.S...',
+      '.....',
+      '.^...',
+      '.....',
+    );
+    expect(countBeamCells(grid)).toBe(5);
+  });
+
+  it('example 2: two splitters', () => {
+    const grid = g(
+      '.S...',
+      '.^...',
+      '^.^..',
+      '.....',
+    );
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('no source', () => {
+    expect(countBeamCells(g('.....', '.....'))).toBe(0);
+  });
+
+  it('source only, no splitters', () => {
+    const grid = g('.S.', '...', '...');
+    expect(countBeamCells(grid)).toBe(3);
+  });
+
+  it('empty grid', () => {
+    expect(countBeamCells([])).toBe(0);
+  });
+
+  it('beam exits via bottom (no splitter)', () => {
+    const grid = g('.S.', '...');
+    expect(countBeamCells(grid)).toBe(2);
+  });
+
+  it('splitter at bottom row sends both out', () => {
+    const grid = g('.S.', '.^.');
+    expect(countBeamCells(grid)).toBe(3);
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('example 1: 2 paths', () => {
+    const grid = g(
+      '.S...',
+      '.....',
+      '.^...',
+      '.....',
+    );
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('example 2: 4 paths', () => {
+    const grid = g(
+      '.S...',
+      '.^...',
+      '^.^..',
+      '.....',
+    );
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('no source -> 0', () => {
+    expect(countBeamPaths(g('.....', '.....'))).toBe(0n);
+  });
+
+  it('no splitter, single path', () => {
+    const grid = g('.S.', '...', '...');
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('three splitters in chain -> 2^3 = 8 paths', () => {
+    const grid = g(
+      '.S.........',
+      '.^.........',
+      '...^.......',
+      '.....^.....',
+    );
+    expect(countBeamPaths(grid)).toBe(8n);
+  });
+
+  it('merging beams do not double count shared downstream paths incorrectly', () => {
+    // Two splitters converge back to same column then re-split
+    const grid = g(
+      '.S.....',
+      '.^.....',
+      '^.^....',
+      '...^...',
+      '.....^.',
+      '.......',
+    );
+    // Manual: top split -> 2. Each hits splitter at row2 (cols 0 and 2).
+    // Row2 col0 splitter: left out (1 path), right to (3,1)
+    // Row2 col2 splitter: left to (3,1), right to (3,3)
+    // So 2 paths reach (3,1), 1 reaches (3,3). (3,1) is splitter.
+    // (3,1) splitter: 2 paths * 2 = 4 paths out of (3,1). Plus (3,3) splitter -> 2 paths.
+    // Total = 4 + 2 = 6.
+    expect(countBeamPaths(grid)).toBe(6n);
+  });
+
+  it('large path count via bigint: zigzag splitters', () => {
+    // Place splitters in a zigzag so beams recombine into a single splitter chain.
+    // Pattern: S at col, splitters alternate to keep a chain going.
+    // Simpler: a single splitter with both branches recombining requires special geometry;
+    // instead build a 'V' chain: each splitter's two children both hit the same next splitter.
+    // Wide grid, splitters arranged so down-left+down-right of splitter at (r,c) both land on (r+1,c-1) and (r+1,c+1),
+    // which won't both be the same cell. So instead test pure doubling via independent chains is hard.
+    // Use the figure-8: splitter at col c with children landing on two splitters at row+1 (cols c-1, c+1),
+    // whose outer children exit and inner children both land on a shared splitter at (row+2, c).
+    // Chain of length L -> 2^L leaves.
+    const L = 5;
+    const width = 2 * L + 3;
+    const rows: string[][] = [];
+    const top: string[] = Array(width).fill('.');
+    top[2] = 'S';
+    rows.push([...top]);
+    let activeCol = 2;
+    for (let i = 0; i < L; i++) {
+      const r1 = Array(width).fill('.');
+      r1[activeCol] = '^';
+      rows.push(r1);
+      // Next row: two splitters at activeCol-1 and activeCol+1
+      const r2 = Array(width).fill('.');
+      r2[activeCol - 1] = '^';
+      r2[activeCol + 1] = '^';
+      rows.push(r2);
+      // activeCol stays the same (both inner children converge at activeCol)
+    }
+    // After L iterations we have L "V" stages -> each stage doubles paths: 2^L leaves out the bottom.
+    expect(countBeamPaths(rows)).toBe(2n ** BigInt(L));
+  });
+});
