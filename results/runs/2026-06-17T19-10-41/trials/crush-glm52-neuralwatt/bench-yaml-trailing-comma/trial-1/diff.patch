+
+describe('trailing comma in flow collections', () => {
+  const seq = new YAML.YAMLSeq()
+  seq.items = [new Scalar(1), new Scalar(2)]
+  const seqDoc = new YAML.Document()
+  seqDoc.value = seq
+
+  test('flow seq single line: no trailing comma', () => {
+    seq.flow = true
+    expect(seqDoc.toString({ trailingComma: true })).toBe('[ 1, 2 ]\n')
+  })
+
+  test('flow seq multiline: trailing comma when enabled', () => {
+    seq.flow = true
+    const out = seqDoc.toString({ trailingComma: true, lineWidth: 0 })
+    expect(out).toBe('[\n  1,\n  2,\n]\n')
+  })
+
+  test('flow seq multiline: no trailing comma by default', () => {
+    seq.flow = true
+    const out = seqDoc.toString({ lineWidth: 0 })
+    expect(out).toBe('[\n  1,\n  2\n]\n')
+  })
+
+  test('flow map multiline: trailing comma when enabled', () => {
+    const map = new YAML.YAMLMap()
+    map.items = [
+      new Pair(new Scalar('a'), new Scalar(1)),
+      new Pair(new Scalar('b'), new Scalar(2))
+    ]
+    map.flow = true
+    const doc = new YAML.Document()
+    doc.value = map
+    const out = doc.toString({ trailingComma: true, lineWidth: 0 })
+    expect(out).toBe('{\n  a: 1,\n  b: 2,\n}\n')
+  })
+
+  test('single-line flow not modified by lineWidth wrapping', () => {
+    seq.flow = true
+    expect(seqDoc.toString({ trailingComma: true, lineWidth: 80 })).toBe(
+      '[ 1, 2 ]\n'
+    )
+  })
+})
