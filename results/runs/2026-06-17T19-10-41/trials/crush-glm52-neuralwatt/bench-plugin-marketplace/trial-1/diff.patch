@@ -0,0 +1,103 @@
+import type { DepsService, RegistryService, DependencyNode } from '../types.js';
+
+export function createDepsService(): DepsService {
+  function getDependencies(name: string, registry: RegistryService): string[] {
+    const manifest = registry.get(name);
+    if (!manifest) {
+      return [];
+    }
+    return Object.keys(manifest.dependencies);
+  }
+
+  function buildTree(name: string, registry: RegistryService): DependencyNode {
+    const manifest = registry.get(name);
+    if (!manifest) {
+      return { name, version: '', dependencies: [] };
+    }
+    const depNames = Object.keys(manifest.dependencies);
+    const children: DependencyNode[] = depNames.map(dep => buildTree(dep, registry));
+    return {
+      name,
+      version: manifest.version,
+      dependencies: children,
+    };
+  }
+
+  function detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const cycles: string[][] = [];
+    const visited = new Set<string>();
+    const stack: string[] = [];
+    const onStack = new Set<string>();
+
+    function dfs(node: string): void {
+      if (onStack.has(node)) {
+        const cycleStart = stack.indexOf(node);
+        const cycle = stack.slice(cycleStart);
+        cycle.push(node);
+        cycles.push(cycle);
+        return;
+      }
+      if (visited.has(node)) {
+        return;
+      }
+      visited.add(node);
+      onStack.add(node);
+      stack.push(node);
+
+      const deps = getDependencies(node, registry);
+      for (const dep of deps) {
+        dfs(dep);
+      }
+
+      stack.pop();
+      onStack.delete(node);
+    }
+
+    dfs(name);
+
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  function hasCircularDependency(name: string, registry: RegistryService): boolean {
+    return detectCycles(name, registry) !== null;
+  }
+
+  function topologicalSort(name: string, registry: RegistryService): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>();
+    const visiting = new Set<string>();
+
+    function visit(node: string): void {
+      if (visited.has(node)) {
+        return;
+      }
+      if (visiting.has(node)) {
+        return;
+      }
+      visiting.add(node);
+      const deps = getDependencies(node, registry);
+      for (const dep of deps) {
+        visit(dep);
+      }
+      visiting.delete(node);
+      visited.add(node);
+      result.push(node);
+    }
+
+    visit(name);
+    return result;
+  }
+
+  function flattenDependencies(name: string, registry: RegistryService): string[] {
+    const sorted = topologicalSort(name, registry);
+    return sorted.filter(n => n !== name);
+  }
+
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency,
+  };
+}
