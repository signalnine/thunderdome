+import vm from 'node:vm';
+import crypto from 'node:crypto';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT = 5000;
+
+export function createRunner(): RunnerService {
+  function execute(code: string, context: Record<string, unknown> = {}, timeoutMs: number = DEFAULT_TIMEOUT): Promise<SandboxResult> {
+    return new Promise((resolve) => {
+      const start = Date.now();
+      const sandbox: Record<string, unknown> = { ...context };
+      sandbox.global = sandbox;
+      sandbox.console = console;
+
+      const scriptId = crypto.randomUUID();
+      const wrappedCode = `(function() { ${code} })()`;
+
+      let result: SandboxResult;
+      try {
+        const script = new vm.Script(wrappedCode, { filename: `plugin-${scriptId}.js` });
+        const contextObj = vm.createContext(sandbox);
+        const output = script.runInContext(contextObj, {
+          timeout: timeoutMs,
+          displayErrors: true,
+        });
+        const memoryUsed = process.memoryUsage().heapUsed;
+        result = {
+          success: true,
+          output,
+          duration: Date.now() - start,
+          memoryUsed,
+        };
+      } catch (err: unknown) {
+        const message = err instanceof Error ? err.message : String(err);
+        result = {
+          success: false,
+          output: undefined,
+          duration: Date.now() - start,
+          memoryUsed: process.memoryUsage().heapUsed,
+          error: message,
+        };
+      }
+      resolve(result);
+    });
+  }
+
+  return {
+    execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult> {
+      return execute(code, context ?? {}, DEFAULT_TIMEOUT);
+    },
+
+    executeWithTimeout(code: string, timeoutMs: number, context?: Record<string, unknown>): Promise<SandboxResult> {
+      return execute(code, context ?? {}, timeoutMs);
+    },
+  };
+}
