+import Database from 'better-sqlite3';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+interface PluginRow {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies: string;
+  entryPoint: string;
+  permissions: string;
+  created_at: string;
+}
+
+export function createRegistry(db?: Database.Database): RegistryService {
+  const database = db ?? new Database(':memory:');
+
+  database.exec(`
+    CREATE TABLE IF NOT EXISTS plugins (
+      name TEXT NOT NULL,
+      version TEXT NOT NULL,
+      description TEXT NOT NULL,
+      author TEXT NOT NULL,
+      dependencies TEXT NOT NULL,
+      entryPoint TEXT NOT NULL,
+      permissions TEXT NOT NULL,
+      created_at TEXT NOT NULL,
+      PRIMARY KEY (name, version)
+    );
+  `);
+
+  const insertStmt = database.prepare(
+    `INSERT INTO plugins (name, version, description, author, dependencies, entryPoint, permissions, created_at)
+     VALUES (@name, @version, @description, @author, @dependencies, @entryPoint, @permissions, @createdAt)`
+  );
+
+  const getByNameStmt = database.prepare(
+    `SELECT * FROM plugins WHERE name = ? ORDER BY version DESC LIMIT 1`
+  );
+
+  const getVersionStmt = database.prepare(
+    `SELECT * FROM plugins WHERE name = ? AND version = ?`
+  );
+
+  const listStmt = database.prepare(`SELECT * FROM plugins ORDER BY name, version`);
+
+  const listVersionsStmt = database.prepare(
+    `SELECT version FROM plugins WHERE name = ? ORDER BY version DESC`
+  );
+
+  const searchStmt = database.prepare(
+    `SELECT * FROM plugins WHERE name LIKE ? OR description LIKE ? ORDER BY name, version DESC`
+  );
+
+  const removeStmt = database.prepare(
+    `DELETE FROM plugins WHERE name = ? AND version = ?`
+  );
+
+  const updateStmt = database.prepare(
+    `UPDATE plugins SET description = @description, author = @author, dependencies = @dependencies, entryPoint = @entryPoint, permissions = @permissions WHERE name = @name AND version = @version`
+  );
+
+  function rowToManifest(row: PluginRow): PluginManifest {
+    return {
+      name: row.name,
+      version: row.version,
+      description: row.description,
+      author: row.author,
+      dependencies: JSON.parse(row.dependencies) as Record<string, string>,
+      entryPoint: row.entryPoint,
+      permissions: JSON.parse(row.permissions) as string[],
+    };
+  }
+
+  return {
+    register(manifest: PluginManifest): void {
+      insertStmt.run({
+        name: manifest.name,
+        version: manifest.version,
+        description: manifest.description,
+        author: manifest.author,
+        dependencies: JSON.stringify(manifest.dependencies),
+        entryPoint: manifest.entryPoint,
+        permissions: JSON.stringify(manifest.permissions),
+        createdAt: new Date().toISOString(),
+      });
+    },
+
+    get(name: string): PluginManifest | null {
+      const row = getByNameStmt.get(name) as PluginRow | undefined;
+      return row ? rowToManifest(row) : null;
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const row = getVersionStmt.get(name, version) as PluginRow | undefined;
+      return row ? rowToManifest(row) : null;
+    },
+
+    list(): PluginManifest[] {
+      return (listStmt.all() as PluginRow[]).map(rowToManifest);
+    },
+
+    search(query: string): PluginManifest[] {
+      const pattern = `%${query}%`;
+      return (searchStmt.all(pattern, pattern) as PluginRow[]).map(rowToManifest);
+    },
+
+    remove(name: string, version: string): boolean {
+      const info = removeStmt.run(name, version);
+      return info.changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      return (listVersionsStmt.all(name) as { version: string }[]).map(r => r.version);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const current = getVersionStmt.get(name, version) as PluginRow | undefined;
+      if (!current) {
+        return;
+      }
+      const merged: PluginManifest = {
+        name: current.name,
+        version: current.version,
+        description: updates.description ?? current.description,
+        author: updates.author ?? current.author,
+        dependencies: updates.dependencies ?? JSON.parse(current.dependencies) as Record<string, string>,
+        entryPoint: updates.entryPoint ?? current.entryPoint,
+        permissions: updates.permissions ?? JSON.parse(current.permissions) as string[],
+      };
+      updateStmt.run({
+        name: merged.name,
+        version: merged.version,
+        description: merged.description,
+        author: merged.author,
+        dependencies: JSON.stringify(merged.dependencies),
+        entryPoint: merged.entryPoint,
+        permissions: JSON.stringify(merged.permissions),
+      });
+    },
+  };
+}
