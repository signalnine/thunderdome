+      title,
+      body,
+      content='notes',
+      content_rowid='id'
+    )
+  `);
+
+  // Seed the FTS index for any pre-existing rows (e.g. when attaching to a
+  // populated database). Cheap when the notes table is empty.
+  db.exec(`
+    INSERT INTO notes_fts (rowid, title, body)
+    SELECT id, title, body FROM notes
+    WHERE NOT EXISTS (SELECT 1 FROM notes_fts WHERE notes_fts.rowid = notes.id)
+  `);
+
+  // Keep FTS index synchronized with the notes table via triggers.
+  db.exec(`
+    CREATE TRIGGER IF NOT EXISTS notes_ai AFTER INSERT ON notes BEGIN
+      INSERT INTO notes_fts (rowid, title, body) VALUES (new.id, new.title, new.body);
+    END;
+    CREATE TRIGGER IF NOT EXISTS notes_ad AFTER DELETE ON notes BEGIN
+      INSERT INTO notes_fts (notes_fts, rowid, title, body) VALUES ('delete', old.id, old.title, old.body);
