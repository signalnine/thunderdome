+/**
+ * Build a safe FTS5 MATCH expression from a raw user query.
+ *
+ * FTS5 syntax reserves several characters (`"`, `*`, `(`, `)`, `-`, `+`, `AND`,
+ * `OR`, `NOT`, etc.). Untrusted input can either throw a syntax error or match
+ * unexpected documents. This helper extracts the user's intent:
+ *   - Quoted phrases (`"chocolate chip"`) are preserved as FTS5 phrase queries.
+ *   - Bare words are converted to prefix queries (`word*`) so partial matches
+ *     (e.g. "learn" matching "learning") work for autocomplete-style lookups.
+ *   - Strips any leftover control characters.
+ *
+ * Returns null when no usable tokens remain (caller should 400).
+ */
+function buildFtsQuery(raw: string): string | null {
+  const trimmed = raw.trim();
+  if (!trimmed) return null;
+
+  const tokens: string[] = [];
+  // Match either a quoted phrase or a contiguous run of word characters.
+  const parts = trimmed.match(/"[^"]+"|\S+/g) ?? [];
+  for (const part of parts) {
+    if (part.startsWith('"') && part.endsWith('"') && part.length >= 2) {
+      const phrase = part.slice(1, -1).trim();
+      if (phrase) tokens.push(`"${phrase}"`);
+      continue;
+    }
+    // Strip characters that are unsafe in FTS5 query syntax outside of
+    // quoted phrases. Keep alphanumerics, underscores, and hyphens so
+    // identifiers and hyphenated terms still match.
+    const cleaned = part.replace(/[^\p{L}\p{N}_-]/gu, '');
+    if (cleaned) tokens.push(`${cleaned}*`);
+  }
+  return tokens.length > 0 ? tokens.join(' ') : null;
+}
