+  // LIKE matches the inner text rather than the literal quote characters.
+  const cleaned = rawQuery.trim().replace(/^"|"$/g, '');
+  const like = `%${cleaned}%`;
+  const stmt = db.prepare(`
+    SELECT id, title, body FROM notes
+    WHERE title LIKE ? OR body LIKE ?
+    ORDER BY id
+  `);
+  const matches = stmt.all(like, like) as { id: number; title: string; body: string }[];
+
+  const rows: SearchResult[] = matches.map((m) => ({
+    id: m.id,
+    title: m.title,
+    snippet: buildLikeSnippet(m.body, cleaned),
+    rank: 0,
+  }));
+  return { rows, total: rows.length };
