@@ -0,0 +1,101 @@
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'fs';
+import { dirname } from 'path';
+
+export interface Entry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+export class TimeTracker {
+  private filePath: string;
+  private entries: Entry[];
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = this.load();
+  }
+
+  private load(): Entry[] {
+    if (!existsSync(this.filePath)) {
+      return [];
+    }
+    const raw = readFileSync(this.filePath, 'utf-8');
+    if (raw.trim() === '') {
+      return [];
+    }
+    return JSON.parse(raw) as Entry[];
+  }
+
+  private save(): void {
+    const dir = dirname(this.filePath);
+    if (!existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+    writeFileSync(this.filePath, JSON.stringify(this.entries), 'utf-8');
+  }
+
+  start(taskName: string): Entry {
+    if (taskName === '') {
+      throw new Error('taskName must not be empty');
+    }
+
+    const activeIndex = this.entries.findIndex(e => e.endTime === null);
+    if (activeIndex !== -1) {
+      this.entries[activeIndex].endTime = new Date().toISOString();
+    }
+
+    const entry: Entry = {
+      taskName,
+      startTime: new Date().toISOString(),
+      endTime: null,
+    };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  stop(): Entry {
+    const activeIndex = this.entries.findIndex(e => e.endTime === null);
+    if (activeIndex === -1) {
+      throw new Error('No task is currently running');
+    }
+    this.entries[activeIndex].endTime = new Date().toISOString();
+    const stopped = this.entries[activeIndex];
+    this.save();
+    return stopped;
+  }
+
+  getActiveTask(): Entry | null {
+    const active = this.entries.find(e => e.endTime === null);
+    return active ?? null;
+  }
+
+  getLog(options?: { since?: Date }): Entry[] {
+    let entries = [...this.entries];
+    if (options?.since) {
+      const sinceMs = options.since.getTime();
+      entries = entries.filter(e => {
+        if (e.endTime === null) {
+          return true;
+        }
+        const startMs = new Date(e.startTime).getTime();
+        const endMs = new Date(e.endTime).getTime();
+        return startMs >= sinceMs || endMs >= sinceMs;
+      });
+    }
+    return entries;
+  }
+
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+    const now = Date.now();
+    for (const entry of this.entries) {
+      const startMs = new Date(entry.startTime).getTime();
+      const endMs = entry.endTime === null ? now : new Date(entry.endTime).getTime();
+      const duration = endMs - startMs;
+      summary[entry.taskName] = (summary[entry.taskName] ?? 0) + duration;
+    }
+    return summary;
+  }
+}
