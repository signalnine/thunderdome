+import { describe, it, expect } from 'vitest';
+import { solveToggle, solveCounter, type Machine } from '../src/index.js';
+
+function applyToggle(target: boolean[], buttons: number[][], pressIndices: number[]): boolean[] {
+  const lights = new Array(target.length).fill(false);
+  for (const bi of pressIndices) {
+    for (const lightIdx of buttons[bi]) {
+      lights[lightIdx] = !lights[lightIdx];
+    }
+  }
+  return lights;
+}
+
+function applyCounter(targets: number[], buttons: number[][], presses: number[], modulus: number): number[] {
+  const counters = new Array(targets.length).fill(0);
+  for (let b = 0; b < buttons.length; b++) {
+    for (let k = 0; k < presses[b]; k++) {
+      for (const idx of buttons[b]) {
+        counters[idx] = (counters[idx] + 1) % modulus;
+      }
+    }
+  }
+  return counters;
+}
+
+describe('solveToggle - example from task', () => {
+  const machine: Machine = {
+    target: [true, true, false, true],
+    buttons: [[0, 1], [1, 2, 3], [0, 3]],
+  };
+  it('returns null (no solution)', () => {
+    expect(solveToggle(machine)).toBeNull();
+  });
+});
+
+describe('solveToggle - basic', () => {
+  it('trivially solvable with one button', () => {
+    const machine: Machine = {
+      target: [true, false],
+      buttons: [[0], [1]],
+    };
+    const r = solveToggle(machine);
+    expect(r).toEqual([0]);
+  });
+
+  it('picks fewer presses (prefer single button over two)', () => {
+    const machine: Machine = {
+      target: [true, true],
+      buttons: [[0, 1], [0], [1]],
+    };
+    const r = solveToggle(machine);
+    expect(r).toEqual([0]);
+  });
+
+  it('returns empty array when target is all off', () => {
+    const machine: Machine = {
+      target: [false, false, false],
+      buttons: [[0, 1], [2]],
+    };
+    const r = solveToggle(machine);
+    expect(r).toEqual([]);
+  });
+
+  it('returns [] when no buttons and target all off', () => {
+    const machine: Machine = { target: [], buttons: [] };
+    expect(solveToggle(machine)).toEqual([]);
+  });
+
+  it('returns null when no buttons but target non-empty', () => {
+    const machine: Machine = { target: [true], buttons: [] };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it('full press needed', () => {
+    const machine: Machine = {
+      target: [true, true, true],
+      buttons: [[0], [1], [2]],
+    };
+    expect(solveToggle(machine)).toEqual([0, 1, 2]);
+  });
+
+  it('validates solution correctness on random-ish instance', () => {
+    const machine: Machine = {
+      target: [true, false, true, true, false],
+      buttons: [[0, 2], [1, 4], [3], [0, 3, 4], [2, 3]],
+    };
+    const r = solveToggle(machine);
+    expect(r).not.toBeNull();
+    const lights = applyToggle(machine.target, machine.buttons, r!);
+    expect(lights).toEqual(machine.target.map((t) => !!t));
+  });
+
+  it('handles duplicate/redundant buttons (free vars) choosing fewest presses', () => {
+    const machine: Machine = {
+      target: [true],
+      buttons: [[0], [0]],
+    };
+    const r = solveToggle(machine);
+    expect(r).toEqual([0]);
+  });
+
+  it('lexicographically smallest set on tie (fewest presses dominates)', () => {
+    const machine: Machine = {
+      target: [true, true],
+      buttons: [[0], [1], [0, 1]],
+    };
+    const r = solveToggle(machine)!;
+    expect(applyToggle(machine.target, machine.buttons, r)).toEqual([true, true]);
+    expect(r.length).toBe(1);
+    expect(r).toEqual([2]);
+  });
+});
+
