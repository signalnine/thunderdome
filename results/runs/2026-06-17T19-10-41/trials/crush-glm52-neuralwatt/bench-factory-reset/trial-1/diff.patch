+export interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+export type Solution = number[] | null;
+
+function modInverse(a: number, p: number): number {
+  a = ((a % p) + p) % p;
+  if (a === 0) throw new Error('not invertible');
+  let oldR = p;
+  let r = a;
+  let oldS = 0;
+  let s = 1;
+  while (r !== 0) {
+    const q = Math.floor(oldR / r);
+    const tr = oldR - q * r;
+    oldR = r;
+    r = tr;
+    const ts = oldS - q * s;
+    oldS = s;
+    s = ts;
+  }
+  if (oldR !== 1) throw new Error('not invertible');
+  return ((oldS % p) + p) % p;
+}
+
+export function solveToggle(machine: Machine): number[] | null {
+  const numLights = machine.target.length;
+  const numButtons = machine.buttons.length;
+
+  const target = machine.target.map((t) => (t ? 1 : 0));
+
+  const rows: number[][] = [];
+  for (let light = 0; light < numLights; light++) {
+    const row = new Array(numButtons + 1).fill(0);
+    for (let b = 0; b < numButtons; b++) {
+      let cnt = 0;
+      const arr = machine.buttons[b];
+      for (let k = 0; k < arr.length; k++) {
+        if (arr[k] === light) cnt++;
+      }
+      row[b] = cnt & 1;
+    }
+    row[numButtons] = target[light];
+    rows.push(row);
+  }
+
+  let numCols = numButtons;
+  const augCols = numButtons + 1;
+
+  const pivotCol: number[] = new Array(numLights).fill(-1);
+  const pivotRow: number[] = new Array(numCols).fill(-1);
+  let pr = 0;
+  for (let col = 0; col < numCols && pr < numLights; col++) {
+    let sel = -1;
+    for (let r = pr; r < numLights; r++) {
+      if (rows[r][col] !== 0) {
+        sel = r;
+        break;
+      }
+    }
+    if (sel === -1) continue;
+    const tmp = rows[pr];
+    rows[pr] = rows[sel];
+    rows[sel] = tmp;
+    for (let r = 0; r < numLights; r++) {
+      if (r === pr) continue;
+      if (rows[r][col] !== 0) {
+        for (let c = 0; c < augCols; c++) {
+          rows[r][c] ^= rows[pr][c];
+        }
+      }
+    }
+    pivotCol[pr] = col;
+    pivotRow[col] = pr;
+    pr++;
+  }
+
+  const rank = pr;
+  for (let r = rank; r < numLights; r++) {
+    if (rows[r][numButtons] !== 0) return null;
+  }
+
+  const freeCols: number[] = [];
+  for (let c = 0; c < numCols; c++) {
+    if (pivotRow[c] === -1) freeCols.push(c);
+  }
+
+  const particular = new Array(numCols).fill(0);
+  for (let i = 0; i < rank; i++) {
+    const col = pivotCol[i];
+    particular[col] = rows[i][numButtons];
+  }
+
+  const basisVecs: number[][] = freeCols.map(() => new Array(numCols).fill(0));
+  for (let fi = 0; fi < freeCols.length; fi++) {
+    const fc = freeCols[fi];
+    const v = basisVecs[fi];
+    v[fc] = 1;
+    for (let i = 0; i < rank; i++) {
+      const col = pivotCol[i];
+      v[col] = rows[i][fc];
+    }
+  }
+
+  const F = freeCols.length;
+  const MAX_ENUM = 24;
+
+  if (F === 0) {
+    return finalizeToggle(particular, numButtons);
+  }
+
+  if (F <= MAX_ENUM) {
+    const x = particular.slice();
+    let best: number[] | null = null;
+    let bestPop = Infinity;
+    let bestNum = -1;
+
+    const total = 1 << F;
+    for (let mask = 0; mask < total; mask++) {
+      if (mask > 0) {
+        const k = ctz(mask);
+        xorInto(x, basisVecs[k]);
+      }
+      const pop = popcountArr(x);
+      if (pop < bestPop || (pop === bestPop && compareNum(x, numButtons, best!) > 0)) {
+        bestPop = pop;
+        best = x.slice();
+        bestNum = numVal(x, numButtons);
+      }
+    }
+    void bestNum;
+    return finalizeToggle(best!, numButtons);
+  }
+
+  let x = particular.slice();
+  let best = x.slice();
+  let bestPop = popcountArr(x);
+  for (let mi = 0; mi < F; mi++) {
+    const candidates: number[][] = [];
+    candidates.push(x.slice());
+    const xb = x.slice();
+    xorInto(xb, basisVecs[mi]);
+    candidates.push(xb);
+    for (const cand of candidates) {
+      const pop = popcountArr(cand);
+      if (pop < bestPop || (pop === bestPop && compareNum(cand, numButtons, best) > 0)) {
+        bestPop = pop;
+        best = cand.slice();
+        x = cand.slice();
+      }
+    }
+  }
+  return finalizeToggle(best, numButtons);
+}
+
+function ctz(n: number): number {
+  if (n === 0) return 32;
+  let c = 0;
+  while ((n & 1) === 0) {
+    c++;
+    n >>= 1;
+  }
+  return c;
+}
+
+function xorInto(a: number[], b: number[]): void {
+  for (let i = 0; i < a.length; i++) a[i] ^= b[i];
+}
+
+function popcountArr(a: number[]): number {
+  let c = 0;
+  for (let i = 0; i < a.length; i++) c += a[i];
+  return c;
+}
+
+function numVal(x: number[], n: number): number {
+  let v = 0;
+  for (let i = 0; i < n; i++) {
+    v = v * 2 + (x[i] ? 1 : 0);
+  }
+  return v;
+}
+
+function compareNum(x: number[], n: number, best: number[]): number {
+  for (let i = 0; i < n; i++) {
+    const a = x[i] ? 1 : 0;
+    const b = best[i] ? 1 : 0;
+    if (a !== b) return a - b;
+  }
+  return 0;
+}
+
+function finalizeToggle(x: number[], numButtons: number): number[] {
+  const result: number[] = [];
+  for (let i = 0; i < numButtons; i++) {
+    if (x[i]) result.push(i);
+  }
+  return result;
+}
+
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): number[] | null {
+  const numCounters = lights.length;
+  const numButtons = buttons.length;
+  const p = modulus;
+
+  const rows: number[][] = [];
+  for (let light = 0; light < numCounters; light++) {
+    const row = new Array(numButtons + 1).fill(0);
+    for (let b = 0; b < numButtons; b++) {
+      let cnt = 0;
+      const arr = buttons[b];
+      for (let k = 0; k < arr.length; k++) {
+        if (arr[k] === light) cnt++;
+      }
+      row[b] = cnt % p;
+    }
+    row[numButtons] = ((lights[light] % p) + p) % p;
+    rows.push(row);
+  }
+
+  const numCols = numButtons;
+  const augCols = numButtons + 1;
+
+  const pivotCol: number[] = new Array(numCounters).fill(-1);
+  const pivotRow: number[] = new Array(numCols).fill(-1);
+  let pr = 0;
+  for (let col = 0; col < numCols && pr < numCounters; col++) {
+    let sel = -1;
+    for (let r = pr; r < numCounters; r++) {
+      if (rows[r][col] !== 0) {
+        sel = r;
+        break;
+      }
+    }
+    if (sel === -1) continue;
+    const tmp = rows[pr];
+    rows[pr] = rows[sel];
+    rows[sel] = tmp;
+    const inv = modInverse(rows[pr][col], p);
+    for (let c = 0; c < augCols; c++) {
+      rows[pr][c] = (rows[pr][c] * inv) % p;
+    }
+    for (let r = 0; r < numCounters; r++) {
+      if (r === pr) continue;
+      if (rows[r][col] !== 0) {
+        const factor = rows[r][col];
+        for (let c = 0; c < augCols; c++) {
+          rows[r][c] = ((rows[r][c] - factor * rows[pr][c]) % p + p) % p;
+        }
+      }
+    }
+    pivotCol[pr] = col;
+    pivotRow[col] = pr;
+    pr++;
+  }
+
+  const rank = pr;
+  for (let r = rank; r < numCounters; r++) {
+    if (rows[r][numButtons] !== 0) return null;
+  }
+
+  const freeCols: number[] = [];
+  for (let c = 0; c < numCols; c++) {
+    if (pivotRow[c] === -1) freeCols.push(c);
+  }
+
+  const particular = new Array(numCols).fill(0);
+  for (let i = 0; i < rank; i++) {
+    const col = pivotCol[i];
+    particular[col] = rows[i][numButtons];
+  }
+
+  const basisVecs: number[][] = freeCols.map(() => new Array(numCols).fill(0));
+  for (let fi = 0; fi < freeCols.length; fi++) {
+    const fc = freeCols[fi];
+    const v = basisVecs[fi];
+    v[fc] = 1;
+    for (let i = 0; i < rank; i++) {
+      const col = pivotCol[i];
+      v[col] = rows[i][fc];
+    }
+  }
+
+  const F = freeCols.length;
+
+  if (F === 0) {
+    return particular.slice();
+  }
+
+  let totalCombos = 1;
+  let feasible = true;
+  for (let i = 0; i < F; i++) {
+    totalCombos *= p;
+    if (totalCombos > 5_000_000) {
+      feasible = false;
+      break;
+    }
+  }
+
+  let best: number[] | null = null;
+  let bestSum = Infinity;
+  let bestLex = '';
+
+  if (feasible) {
+    const x = particular.slice();
+    const counts = new Array(F).fill(0);
+    for (let i = 0; i < totalCombos; i++) {
+      let sum = 0;
+      for (let j = 0; j < numCols; j++) sum += x[j];
+      const lex = x.join(',');
+      if (sum < bestSum || (sum === bestSum && lex < bestLex)) {
+        bestSum = sum;
+        bestLex = lex;
+        best = x.slice();
+      }
+      for (let k = 0; k < F; k++) {
+        if (counts[k] + 1 < p) {
+          counts[k]++;
+          addVecScaled(x, basisVecs[k], 1, p);
+          break;
+        } else {
+          counts[k] = 0;
+          addVecScaled(x, basisVecs[k], -(p - 1), p);
+        }
+      }
+    }
+    return best;
+  }
+
+  const x = particular.slice();
+  const counts = new Array(F).fill(0);
+  let curSum = 0;
+  for (let j = 0; j < numCols; j++) curSum += x[j];
+  best = x.slice();
+  bestSum = curSum;
+  bestLex = x.join(',');
+
+  for (let mi = 0; mi < F; mi++) {
+    for (let val = 1; val < p; val++) {
+      addVecScaled(x, basisVecs[mi], 1, p);
+      let sum = 0;
+      for (let j = 0; j < numCols; j++) sum += x[j];
+      const lex = x.join(',');
+      if (sum < bestSum || (sum === bestSum && lex < bestLex)) {
+        bestSum = sum;
+        bestLex = lex;
+        best = x.slice();
+      }
+    }
+  }
+  return best;
+}
+
+function addVecScaled(x: number[], v: number[], delta: number, p: number): void {
+  for (let i = 0; i < x.length; i++) {
+    if (v[i] !== 0) {
+      x[i] = (((x[i] + delta * v[i]) % p) + p) % p;
+    }
+  }
+}
