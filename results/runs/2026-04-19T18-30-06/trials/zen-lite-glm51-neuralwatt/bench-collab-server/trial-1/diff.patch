+{"type":"assistant","message":{"id":"chatcmpl-bf5d0df339e9ab9c","content":[{"type":"tool_use","id":"chatcmpl-tool-83e4c2386a8ffdb2","name":"Write","input":{"file_path":"/workspace/src/collab.ts","content":"import { WebSocketServer, WebSocket } from 'ws';\nimport type { Server } from 'http';\nimport Database from 'better-sqlite3';\nimport { Op, applyOp, transform, validateOp } from './ot.js';\nimport { getDocument, getDocumentVersion, addVersion, updateDocumentContent } from './db.js';\n\ninterface ClientInfo {\n  ws: WebSocket;\n  docId: string;\n  version: number;\n}\n\ninterface PendingOp {\n  op: Op;\n  version: number;\n}\n\nexport class CollabServer {\n  private wss: WebSocketServer;\n  private clients: Map<WebSocket, ClientInfo> = new Map();\n  private docHistory: Map<string, PendingOp[]> = new Map();\n  private db: Database.Database;\n\n  constructor(server: Server, db: Database.Database) {\n    this.db = db;\n    this.wss = new WebSocketServer({ noServer: true });\n\n    server.on('upgrade', (req, socket, head) => {\n      const match = req.url?.match(/^\\/ws\\/docs\\/(.+)$/);\n      if (!match) {\n        socket.write('HTTP/1.1 404 Not Found\\r\\n\\r\\n');\n        socket.destroy();\n        return;\n      }\n      this.wss.handleUpgrade(req, socket, head, (ws) => {\n        this.wss.emit('connection', ws, req);\n      });\n    });\n\n    this.wss.on('connection', (ws: WebSocket, req) => {\n      const match = req.url?.match(/^\\/ws\\/docs\\/(.+)$/);\n      const docId = match![1];\n\n      const doc = getDocument(db, docId);\n      if (!doc) {\n        ws.send(JSON.stringify({ type: 'error', message: 'Document not found' }));\n        ws.close();\n        return;\n      }\n\n      const version = getDocumentVersion(db, docId);\n      const client: ClientInfo = { ws, docId, version };\n      this.clients.set(ws, client);\n\n      if (!this.docHistory.has(docId)) {\n        this.docHistory.set(docId, []);\n      }\n\n      ws.send(JSON.stringify({ type: 'sync', content: doc.content, version }));\n\n      ws.on('message', (data) => {\n        this.handleMessage(ws, data);\n      });\n\n      ws.on('close', () => {\n        this.clients.delete(ws);\n      });\n\n      ws.on('error', () => {\n        this.clients.delete(ws);\n      });\n    });\n  }\n\n  private handleMessage(ws: WebSocket, data: unknown): void {\n    let msg: unknown;\n    try {\n      msg = JSON.parse(typeof data === 'string' ? data : String(data));\n    } catch {\n      ws.send(JSON.stringify({ type: 'error', message: 'Invalid JSON' }));\n      return;\n    }\n\n    if (typeof msg !== 'object' || msg === null) {\n      ws.send(JSON.stringify({ type: 'error', message: 'Invalid message format' }));\n      return;\n    }\n\n    const m = msg as Record<string, unknown>;\n\n    if (m.type !== 'op') {\n      ws.send(JSON.stringify({ type: 'error', message: 'Unknown message type' }));\n      return;\n    }\n\n    if (!validateOp(m.op)) {\n      ws.send(JSON.stringify({ type: 'error', message: 'Invalid operation' }));\n      return;\n    }\n\n    const client = this.clients.get(ws);\n    if (!client) return;\n\n    const op = m.op as Op;\n    const clientVersion = typeof m.version === 'number' ? m.version : client.version;\n\n    try {\n      this.applyAndBroadcast(client, op, clientVersion);\n    } catch (err) {\n      const message = err instanceof Error ? err.message : 'Operation failed';\n      ws.send(JSON.stringify({ type: 'error', message }));\n    }\n  }\n\n  private applyAndBroadcast(client: ClientInfo, op: Op, clientVersion: number): void {\n    const doc = getDocument(this.db, client.docId);\n    if (!doc) return;\n\n    const currentVersion = getDocumentVersion(this.db, client.docId);\n    const history = this.docHistory.get(client.docId) ?? [];\n\n    let transformedOp = op;\n    for (let v = clientVersion; v < currentVersion; v++) {\n      const pending = history.find(p => p.version === v + 1);\n      if (pending) {\n        transformedOp = transform(transformedOp, pending.op);\n      }\n    }\n\n    const newContent = applyOp(doc.content, transformedOp);\n    const newVersion = addVersion(this.db, client.docId, newContent, JSON.stringify(transformedOp));\n    updateDocumentContent(this.db, client.docId, newContent);\n\n    history.push({ op: transformedOp, version: newVersion });\n    this.docHistory.set(client.docId, history);\n\n    client.version = newVersion;\n\n    const broadcastMsg = JSON.stringify({\n      type: 'op',\n      op: transformedOp,\n      version: newVersion,\n    });\n\n    for (const [ws, info] of this.clients) {\n      if (info.docId === client.docId && ws !== client.ws && ws.readyState === WebSocket.OPEN) {\n        ws.send(broadcastMsg);\n      }\n    }\n\n    client.ws.send(JSON.stringify({\n      type: 'ack',\n      version: newVersion,\n    }));\n  }\n\n  close(): void {\n    for (const ws of this.clients.keys()) {\n      ws.close();\n    }\n    this.clients.clear();\n    this.wss.close();\n  }\n}\n"}}],"model":"zai-org/GLM-5.1-FP8","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":36762,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"8bb5933c-ff72-443c-a1af-65aeb34a63b3","uuid":"90a2a597-2df4-42c1-a81b-ae79bbad96f8"}
