y(apply(content, op1), op2')\n *\n * op1 is the operation to transform, op2 is the one already applied.\n * Both are applied to the same base document state.\n */\nexport function transform(op1: Op, op2: Op): Op {\n  // insert vs insert\n  if (op1.type === 'insert' && op2.type === 'insert') {\n    if (op1.pos < op2.pos || (op1.pos === op2.pos && op1.text <= op2.text)) {\n      return op1; // op1 stays before op2\n    }\n    return { type: 'insert', pos: op1.pos + op2.text.length, text: op1.text };\n  }\n\n  // insert vs delete\n  if (op1.type === 'insert' && op2.type === 'delete') {\n    if (op1.pos <= op2.pos) {\n      return op1; // insert is before the deleted region\n    }\n    if (op1.pos >= op2.pos + op2.length) {\n      return { type: 'insert', pos: op1.pos - op2.length, text: op1.text };\n    }\n    // insert is inside the deleted region - place it at the delete start\n    return { type: 'insert', pos: op2.pos, text: op1.text };\n  }\n\n  // delete vs insert\n  if (op1.type === 'delete' && op2.type === 'insert') {\n    if (op1.pos >= op2.pos) {\n      return { type: 'delete', pos: op1.pos + op2.text.length, length: op1.length };\n    }\n    if (op1.pos + op1.length <= op2.pos) {\n      return op1; // delete is entirely before the insert\n    }\n    // delete spans the insert point - split into two deletes\n    const beforeInsert = op2.pos - op1.pos;\n    const afterInsert = op1.length - beforeInsert;\n    // We can only return one op, so shift the delete to cover both regions\n    return { type: 'delete', pos: op1.pos, length: op1.length + op2.text.length };\n  }\n\n  // delete vs delete\n  if (op1.type === 'delete' && op2.type === 'delete') {\n    const s1 = op1.pos;\n    const e1 = op1.pos + op1.length;\n    const s2 = op2.pos;\n    const e2 = op2.pos + op2.length;\n\n    // op1 is entirely before op2\n    if (e1 <= s2) {\n      return { type: 'delete', pos: op1.pos, length: op1.length };\n    }\n\n    // op1 is entirely after op2\n    if (s1 >= e2) {\n      return { type: 'delete', pos: op1.pos - op2.length, length: op1.length };\n    }\n\n    // Overlapping deletes\n    const overlapStart = Math.max(s1, s2);\n    const overlapEnd = Math.min(e1, e2);\n    const overlap = overlapEnd - overlapStart;\n\n    const newLength = op1.length - overlap;\n    if (newLength <= 0) {\n      // op1 is entirely contained in op2's deleted region\n      return { type: 'delete', pos: 0, length: 0 }; // no-op\n    }\n\n    const newPos = s1 < s2 ? s1 : s1 - (e2 - s2 - overlap);\n    return { type: 'delete', pos: Math.max(0, newPos), length: newLength };\n  }\n\n  return op1;\n}\n\nexport function validateOp(op: unknown): op is Op {\n  if (typeof op !== 'object' || op === null) return false;\n  const o = op as Record<string, unknown>;\n  if (o.type === 'insert') {\n    return typeof o.pos === 'number' && typeof o.text === 'string' && o.pos >= 0;\n  }\n  if (o.type === 'delete') {\n    return typeof o.pos === 'number' && typeof o.length === 'number' && o.pos >= 0 && o.length >= 0;\n  }\n  return false;\n}\n","structuredPatch":[{"oldStart":69,"oldLines":10,"newStart":69,"newLines":7,"lines":["     if (op1.pos + op1.length <= op2.pos) {","       return op1; // delete is entirely before the insert","     }","-    // delete spans the insert point - split into two deletes","-    const beforeInsert = op2.pos - op1.pos;","-    const afterInsert = op1.length - beforeInsert;","-    // We can only return one op, so shift the delete to cover both regions","+    // delete spans the insert point - expand delete to include inserted text","     return { type: 'delete', pos: op1.pos, length: op1.length + op2.text.length };","   }"," "]}],"userModified":false,"replaceAll":false}}
