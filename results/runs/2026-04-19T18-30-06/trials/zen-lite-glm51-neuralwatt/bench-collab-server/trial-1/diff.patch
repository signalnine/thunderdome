index 0000000..7a5b73a
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,120 @@
+import Database from 'better-sqlite3';
+
+export interface DocumentRow {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface VersionRow {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+export function initDb(db: Database.Database): void {
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS documents (
+      id TEXT PRIMARY KEY,
+      title TEXT NOT NULL,
+      content TEXT NOT NULL DEFAULT '',
+      created_at TEXT NOT NULL DEFAULT (datetime('now')),
+      updated_at TEXT NOT NULL DEFAULT (datetime('now'))
+    );
+
+    CREATE TABLE IF NOT EXISTS versions (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+      version INTEGER NOT NULL,
+      content TEXT NOT NULL,
+      operation TEXT,
+      created_at TEXT NOT NULL DEFAULT (datetime('now')),
+      UNIQUE(document_id, version)
+    );
+  `);
+}
+
+export function createDocument(db: Database.Database, id: string, title: string, content: string = ''): DocumentRow {
+  const now = new Date().toISOString();
+  db.prepare(
+    `INSERT INTO documents (id, title, content, created_at, updated_at) VALUES (?, ?, ?, ?, ?)`
+  ).run(id, title, content, now, now);
+
+  // Record initial version
+  db.prepare(
+    `INSERT INTO versions (document_id, version, content, operation) VALUES (?, 1, ?, NULL)`
+  ).run(id, content);
+
+  return getDocument(db, id)!;
+}
+
+export function getDocument(db: Database.Database, id: string): DocumentRow | undefined {
+  return db.prepare(`SELECT * FROM documents WHERE id = ?`).get(id) as DocumentRow | undefined;
+}
+
+export function listDocuments(db: Database.Database): DocumentRow[] {
+  return db.prepare(`SELECT * FROM documents ORDER BY updated_at DESC`).all() as DocumentRow[];
+}
+
+export function updateDocument(db: Database.Database, id: string, title?: string, content?: string): DocumentRow | undefined {
+  const doc = getDocument(db, id);
+  if (!doc) return undefined;
+
+  const newTitle = title ?? doc.title;
+  const newContent = content ?? doc.content;
+  const now = new Date().toISOString();
+
+  db.prepare(
+    `UPDATE documents SET title = ?, content = ?, updated_at = ? WHERE id = ?`
+  ).run(newTitle, newContent, now, id);
+
+  return getDocument(db, id);
+}
+
+export function deleteDocument(db: Database.Database, id: string): boolean {
+  const result = db.prepare(`DELETE FROM documents WHERE id = ?`).run(id);
+  return result.changes > 0;
+}
+
+export function getDocumentVersion(db: Database.Database, docId: string): number {
+  const row = db.prepare(
+    `SELECT MAX(version) as v FROM versions WHERE document_id = ?`
+  ).get(docId) as { v: number | null };
+  return row.v ?? 0;
+}
+
+export function addVersion(db: Database.Database, docId: string, content: string, operation: string): number {
+  const currentVersion = getDocumentVersion(db, docId);
+  const newVersion = currentVersion + 1;
+  db.prepare(
+    `INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)`
+  ).run(docId, newVersion, content, operation);
+  return newVersion;
+}
+
+export function getVersions(db: Database.Database, docId: string): VersionRow[] {
+  return db.prepare(
+    `SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC`
+  ).all(docId) as VersionRow[];
+}
+
+export function getVersion(db: Database.Database, docId: string, version: number): VersionRow | undefined {
+  return db.prepare(
+    `SELECT * FROM versions WHERE document_id = ? AND version = ?`
+  ).get(docId, version) as VersionRow | undefined;
+}
+
+export function updateDocumentContent(db: Database.Database, id: string, content: string): void {
+  const now = new Date().toISOString();
+  db.prepare(
+    `UPDATE documents SET content = ?, updated_at = ? WHERE id = ?`
+  ).run(content, now, id);
+}
