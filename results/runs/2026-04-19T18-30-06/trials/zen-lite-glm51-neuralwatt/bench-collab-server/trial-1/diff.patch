→\n   221→    const getRes = await apiFetch('/docs/d1');\n   222→    expect(getRes.status).toBe(404);\n   223→  });\n   224→\n   225→  it('should return 404 when deleting nonexistent document', async () => {\n   226→    const res = await apiFetch('/docs/nope', { method: 'DELETE' });\n   227→    expect(res.status).toBe(404);\n   228→  });\n   229→\n   230→  it('should track version history', async () => {\n   231→    await apiFetch('/docs', {\n   232→      method: 'POST',\n   233→      headers: { 'Content-Type': 'application/json' },\n   234→      body: JSON.stringify({ id: 'v1', title: 'Versions', content: 'v1' }),\n   235→    });\n   236→    const res = await apiFetch('/docs/v1/versions');\n   237→    expect(res.status).toBe(200);\n   238→    const body = await res.json();\n   239→    expect(body).toHaveLength(1);\n   240→    expect(body[0].version).toBe(1);\n   241→  });\n   242→\n   243→  it('should get a specific version', async () => {\n   244→    await apiFetch('/docs', {\n   245→      method: 'POST',\n   246→      headers: { 'Content-Type': 'application/json' },\n   247→      body: JSON.stringify({ id: 'v2', title: 'V2', content: 'initial' }),\n   248→    });\n   249→    const res = await apiFetch('/docs/v2/versions/1');\n   250→    expect(res.status).toBe(200);\n   251→    const body = await res.json();\n   252→    expect(body.content).toBe('initial');\n   253→  });\n   254→\n   255→  it('should default content to empty string', async () => {\n   256→    const res = await apiFetch('/docs', {\n   257→      method: 'POST',\n   258→      headers: { 'Content-Type': 'application/json' },\n   259→      body: JSON.stringify({ id: 'empty', title: 'Empty' }),\n   260→    });\n   261→    const body = await res.json();\n   262→    expect(body.content).toBe('');\n   263→  });\n   264→});\n   265→\n   266→describe('WebSocket collaboration', () => {\n   267→  let app: ReturnType<typeof createApp>;\n   268→  let port: number;\n   269→  let wsUrl: string;\n   270→  let baseUrl: string;\n   271→\n   272→  beforeEach(async () => {\n   273→    app = createApp();\n   274→    port = app.start();\n   275→    wsUrl = `ws://localhost:${port}`;\n   276→    baseUrl = `http://localhost:${port}`;\n   277→    await new Promise((r) => setTimeout(r, 50));\n   278→  });\n   279→\n   280→  afterEach(async () => {\n   281→    await app.stop();\n   282→  });\n   283→\n   284→  async function createDoc(id: string, title: string, content = '') {\n   285→    await fetch(`${baseUrl}/api/docs`, {\n   286→      method: 'POST',\n   287→      headers: { 'Content-Type': 'application/json' },\n   288→      body: JSON.stringify({ id, title, content }),\n   289→    });\n   290→  }\n   291→\n   292→  function connectWs(docId: string): Promise<{ ws: WebSocket; syncMsg: unknown }> {\n   293→    return new Promise((resolve, reject) => {\n   294→      const ws = new WebSocket(`${wsUrl}/ws/docs/${docId}`);\n   295→      ws.on('error', reject);\n   296→      ws.once('message', (data) => {\n   297→        const syncMsg = JSON.parse(data.toString());\n   298→        resolve({ ws, syncMsg });\n   299→      });\n   300→    });\n   301→  }\n   302→\n   303→  function waitForMessage(ws: WebSocket, timeout = 3000): Promise<unknown> {\n   304→    return new Promise((resolve, reject) => {\n   305→      const timer = setTimeout(() => reject(new Error('Message timeout')), timeout);\n   306→      ws.once('message', (data) => {\n   307→        clearTimeout(timer);\n   308→        resolve(JSON.parse(data.toString()));\n   309→      });\n   310→    });\n   311→  }\n   312→\n   313→  it('should send sync message on connect', async () => {\n   314→    await createDoc('ws1', 'WS Test', 'hello');\n   315→    const { ws, syncMsg } = await connectWs('ws1');\n   316→    expect(syncMsg).toEqual({ type: 'sync', content: 'hello', version: 1 });\n   317→    ws.close();\n   318→  });\n   319→\n   320→  it('should reject connection to nonexistent document', async () => {\n   321→    const ws = new WebSocket(`${wsUrl}/ws/docs/nonexistent`);\n   322→    const msg = await new Promise<unknown>((resolve) => {\n   323→      ws.once('message', (data) => resolve(JSON.parse(data.toString())));\n   324→    });\n   325→    expect(msg).toHaveProperty('type', 'error');\n   326→    ws.close();\n   327→  });\n   328→\n   329→  it('should apply insert operation and broadcast', async () => {\n   330→    await createDoc('ws2', 'WS2', 'ab');\n   331→    const { ws: ws1 } = await connectWs('ws2');\n   332→    const { ws: ws2 } = await connectWs('ws2');\n   333→\n   334→    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: 'X' }, version: 1 }));\n   335→\n   336→    // ws1 should get ack\n   337→    const ack = await waitForMessage(ws1);\n   338→    expect(ack).toHaveProperty('type', 'ack');\n   339→\n   340→    // ws2 should get broadcast\n   341→    const broadcast = await waitForMessage(ws2);\n   342→    expect(broadcast).toHaveProperty('type', 'op');\n   343→\n   344→    // Verify document state via REST\n   345→    const res = await fetch(`${baseUrl}/api/docs/ws2`);\n   346→    const body = await res.json();\n   347→    expect(body.content).toBe('aXb');\n   348→\n   349→    ws1.close();\n   350→    ws2.close();\n   351→  });\n   352→\n   353→  it('should apply delete operation', async () => {\n   354→    await createDoc('ws3', 'WS3', 'abc');\n   355→    const { ws } = await connectWs('ws3');\n   356→\n   357→    ws.send(JSON.stringify({ type: 'op', op: { type: 'delete', pos: 1, length: 1 }, version: 1 }));\n   358→    await waitForMessage(ws); // ack\n   359→\n   360→    const res = await fetch(`${baseUrl}/api/docs/ws3`);\n   361→    const body = await res.json();\n   362→    expect(body.content).toBe('ac');\n   363→\n   364→    ws.close();\n   365→  });\n   366→\n   367→  it('should reject invalid operations', async () => {\n   368→    await createDoc('ws4', 'WS4', 'abc');\n   369→    const { ws } = await connectWs('ws4');\n   370→\n   371→    ws.send(JSON.stringify({ type: 'op', op: { type: 'bad' } }));\n   372→    const err = await waitForMessage(ws);\n   373→    expect(err).toHaveProperty('type', 'error');\n   374→\n   375→    ws.close();\n   376→  });\n   377→\n   378→  it('should reject invalid JSON', async () => {\n   379→    await createDoc('ws5', 'WS5', 'abc');\n   380→    const { ws } = await connectWs('ws5');\n   381→\n   382→    ws.send('not json');\n   383→    const err = await waitForMessage(ws);\n   384→    expect(err).toHaveProperty('type', 'error');\n   385→\n   386→    ws.close();\n   387→  });\n   388→\n   389→  it('should handle concurrent edits with OT', async () => {\n   390→    await createDoc('ws6', 'WS6', 'ab');\n   391→    const { ws: ws1 } = await connectWs('ws6');\n   392→    const { ws: ws2 } = await connectWs('ws6');\n   393→\n   394→    // Both send insert at same position/version concurrently\n   395→    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: '1' }, version: 1 }));\n   396→    ws2.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: '2' }, version: 1 }));\n   397→\n   398→    // Wait for acks and broadcasts\n   399→    await waitForMessage(ws1); // ack for ws1's op\n   400→    await waitForMessage(ws2); // broadcast of ws1's op to ws2\n   401→\n   402→    // ws2's op needs to be transformed\n   403→    const msgs1: unknown[] = [];\n   404→    const msgs2: unknown[] = [];\n   405→    await new Promise<void>((resolve) => {\n   406→      let count = 0;\n   407→      const done = () => { if (++count >= 2) resolve(); };\n   408→      ws1.once('message', (d) => { msgs1.push(JSON.parse(d.toString())); done(); });\n   409→      ws2.once('message', (d) => { msgs2.push(JSON.parse(d.toString())); done(); });\n   410→    });\n   411→\n   412→    // Verify convergence via REST - both inserts should be preserved\n   413→    const res = await fetch(`${baseUrl}/api/docs/ws6`);\n   414→    const body = await res.json();\n   415→    const content = body.content;\n   416→    expect(content).toContain('1');\n   417→    expect(content).toContain('2');\n   418→    expect(content.length).toBe(4);\n   419→\n   420→    ws1.close();\n   421→    ws2.close();\n   422→  });\n   423→\n   424→  it('should handle 10 concurrent clients', async () => {\n   425→    await createDoc('ws7', 'WS7', '');\n   426→    const clients: WebSocket[] = [];\n   427→    for (let i = 0; i < 10; i++) {\n   428→      const { ws } = await connectWs('ws7');\n   429→      clients.push(ws);\n   430→    }\n   431→\n   432→    // Each client sends an insert\n   433→    for (let i = 0; i < 10; i++) {\n   434→      clients[i].send(JSON.stringify({\n   435→        type: 'op',\n   436→        op: { type: 'insert', pos: 0, text: String(i) },\n   437→        version: 1,\n   438→      }));\n   439→    }\n   440→\n   441→    // Wait for all operations to propagate\n   442→    await new Promise((resolve) => setTimeout(resolve, 1000));\n   443→\n   444→    // Verify all characters are present in the document\n   445→    const res = await fetch(`${baseUrl}/api/docs/ws7`);\n   446→    const body = await res.json();\n   447→    const content = body.content;\n   448→    for (let i = 0; i < 10; i++) {\n   449→      expect(content).toContain(String(i));\n   450→    }\n   451→    expect(content.length).toBe(10);\n   452→\n   453→    for (const ws of clients) {\n   454→      ws.close();\n   455→    }\n   456→  });\n   457→});\n   458→\n   459→describe('Persistence', () => {\n   460→  it('should persist documents across restarts', async () => {\n   461→    const dbPath = `/tmp/test-persist-${Date.now()}.db`;\n   462→    const app1 = createApp(dbPath);\n   463→    const port1 = app1.start();\n   464→\n   465→    await fetch(`http://localhost:${port1}/api/docs`, {\n   466→      method: 'POST',\n   467→      headers: { 'Content-Type': 'application/json' },\n   468→      body: JSON.stringify({ id: 'persist', title: 'Persist', content: 'data' }),\n   469→    });\n   470→    await app1.stop();\n   471→\n   472→    const app2 = createApp(dbPath);\n   473→    const port2 = app2.start();\n   474→\n   475→    const res = await fetch(`http://localhost:${port2}/api/docs/persist`);\n   476→    expect(res.status).toBe(200);\n   477→    const body = await res.json();\n   478→    expect(body.content).toBe('data');\n   479→\n   480→    await app2.stop();\n   481→  });\n   482→});\n   483→"}]},"parent_tool_use_id":null,"session_id":"8bb5933c-ff72-443c-a1af-65aeb34a63b3","uuid":"1bdf1faa-2625-495d-b24d-4036fbab672d","tool_use_result":{"type":"update","filePath":"/workspace/tests/server.test.ts","content":"import { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport { WebSocket } from 'ws';\nimport { createApp } from '../src/server.js';\nimport { applyOp, transform, validateOp } from '../src/ot.js';\nimport type { Op } from '../src/ot.js';\n\ndescribe('OT module', () => {\n  describe('applyOp', () => {\n    it('should insert text at position', () => {\n      expect(applyOp('', { type: 'insert', pos: 0, text: 'hello' })).toBe('hello');\n      expect(applyOp('hello', { type: 'insert', pos: 5, text: ' world' })).toBe('hello world');\n      expect(applyOp('heworld', { type: 'insert', pos: 2, text: 'llo ' })).toBe('hello world');\n    });\n\n    it('should delete text at position', () => {\n      expect(applyOp('hello', { type: 'delete', pos: 0, length: 5 })).toBe('');\n      expect(applyOp('hello world', { type: 'delete', pos: 5, length: 6 })).toBe('hello');\n      expect(applyOp('hello', { type: 'delete', pos: 2, length: 1 })).toBe('helo');\n    });\n\n    it('should reject invalid operations', () => {\n      expect(() => applyOp('hi', { type: 'insert', pos: 5, text: 'x' })).toThrow();\n      expect(() => applyOp('hi', { type: 'delete', pos: 0, length: 5 })).toThrow();\n      expect(() => applyOp('hi', { type: 'insert', pos: -1, text: 'x' })).toThrow();\n    });\n  });\n\n  describe('transform', () => {\n    it('should transform insert vs insert (left before right)', () => {\n      const op1: Op = { type: 'insert', pos: 2, text: 'A' };\n      const op2: Op = { type: 'insert', pos: 5, text: 'B' };\n      const t = transform(op1, op2);\n      expect(t).toEqual({ type: 'insert', pos: 2, text: 'A' });\n    });\n\n    it('should transform insert vs insert (right before left)', () => {\n      const op1: Op = { type: 'insert', pos: 5, text: 'B' };\n      const op2: Op = { type: 'insert', pos: 2, text: 'A' };\n      const t = transform(op1, op2);\n      expect(t).toEqual({ type: 'insert', pos: 6, text: 'B' });\n    });\n\n    it('should transform insert vs delete', () => {\n      const op1: Op = { type: 'insert', pos: 7, text: 'X' };\n      const op2: Op = { type: 'delete', pos: 2, length: 3 };\n      const t = transform(op1, op2);\n      expect(t).toEqual({ type: 'insert', pos: 4, text: 'X' });\n    });\n\n    it('should transform delete vs insert', () => {\n      const op1: Op = { type: 'delete', pos: 5, length: 2 };\n      const op2: Op = { type: 'insert', pos: 2, text: 'AB' };\n      const t = transform(op1, op2);\n      expect(t).toEqual({ type: 'delete', pos: 7, length: 2 });\n    });\n\n    it('should transform delete vs delete (non-overlapping)', () => {\n      const op1: Op = { type: 'delete', pos: 0, length: 2 };\n      const op2: Op = { type: 'delete', pos: 5, length: 2 };\n      const t = transform(op1, op2);\n      expect(t).toEqual({ type: 'delete', pos: 0, length: 2 });\n    });\n\n    it('should preserve convergence: insert vs insert', () => {\n      const base = 'hello';\n      const op1: Op = { type: 'insert', pos: 2, text: 'A' };\n      const op2: Op = { type: 'insert', pos: 4, text: 'B' };\n      const t1 = transform(op1, op2);\n      const t2 = transform(op2, op1);\n      expect(applyOp(applyOp(base, op2), t1)).toBe(applyOp(applyOp(base, op1), t2));\n    });\n\n    it('should preserve convergence: insert vs delete', () => {\n      const base = 'hello world';\n      const op1: Op = { type: 'insert', pos: 6, text: 'X' };\n      const op2: Op = { type: 'delete', pos: 2, length: 4 };\n      const t1 = transform(op1, op2);\n      const t2 = transform(op2, op1);\n      expect(applyOp(applyOp(base, op2), t1)).toBe(applyOp(applyOp(base, op1), t2));\n    });\n  });\n\n  describe('validateOp', () => {\n    it('should accept valid operations', () => {\n      expect(validateOp({ type: 'insert', pos: 0, text: 'hi' })).toBe(true);\n      expect(validateOp({ type: 'delete', pos: 0, length: 2 })).toBe(true);\n    });\n\n    it('should reject invalid operations', () => {\n      expect(validateOp(null)).toBe(false);\n      expect(validateOp({})).toBe(false);\n      expect(validateOp({ type: 'insert' })).toBe(false);\n      expect(validateOp({ type: 'delete', pos: -1, length: 1 })).toBe(false);\n      expect(validateOp({ type: 'unknown' })).toBe(false);\n    });\n  });\n});\n\ndescribe('REST API', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n  let baseUrl: string;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start();\n    baseUrl = `http://localhost:${port}`;\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  async function apiFetch(path: string, options?: RequestInit): Promise<Response> {\n    return fetch(`${baseUrl}/api${path}`, options);\n  }\n\n  it('should create a document', async () => {\n    const res = await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'doc1', title: 'Test Doc', content: 'hello' }),\n    });\n    expect(res.status).toBe(201);\n    const body = await res.json();\n    expect(body.id).toBe('doc1');\n    expect(body.title).toBe('Test Doc');\n    expect(body.content).toBe('hello');\n  });\n\n  it('should reject creating a document without id or title', async () => {\n    const res = await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'No ID' }),\n    });\n    expect(res.status).toBe(400);\n\n    const res2 = await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'no-title' }),\n    });\n    expect(res2.status).toBe(400);\n  });\n\n  it('should reject duplicate document id', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'dup', title: 'First' }),\n    });\n    const res = await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'dup', title: 'Second' }),\n    });\n    expect(res.status).toBe(409);\n  });\n\n  it('should list documents', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'a', title: 'A' }),\n    });\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'b', title: 'B' }),\n    });\n    const res = await apiFetch('/docs');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body).toHaveLength(2);\n  });\n\n  it('should get a document', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'x', title: 'X', content: 'content' }),\n    });\n    const res = await apiFetch('/docs/x');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.content).toBe('content');\n  });\n\n  it('should return 404 for missing document', async () => {\n    const res = await apiFetch('/docs/nonexistent');\n    expect(res.status).toBe(404);\n  });\n\n  it('should update a document', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'u1', title: 'Old', content: 'old' }),\n    });\n    const res = await apiFetch('/docs/u1', {\n      method: 'PUT',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'New', content: 'new' }),\n    });\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.title).toBe('New');\n    expect(body.content).toBe('new');\n  });\n\n  it('should delete a document', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'd1', title: 'Delete Me' }),\n    });\n    const res = await apiFetch('/docs/d1', { method: 'DELETE' });\n    expect(res.status).toBe(204);\n\n    const getRes = await apiFetch('/docs/d1');\n    expect(getRes.status).toBe(404);\n  });\n\n  it('should return 404 when deleting nonexistent document', async () => {\n    const res = await apiFetch('/docs/nope', { method: 'DELETE' });\n    expect(res.status).toBe(404);\n  });\n\n  it('should track version history', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'v1', title: 'Versions', content: 'v1' }),\n    });\n    const res = await apiFetch('/docs/v1/versions');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body).toHaveLength(1);\n    expect(body[0].version).toBe(1);\n  });\n\n  it('should get a specific version', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'v2', title: 'V2', content: 'initial' }),\n    });\n    const res = await apiFetch('/docs/v2/versions/1');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.content).toBe('initial');\n  });\n\n  it('should default content to empty string', async () => {\n    const res = await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'empty', title: 'Empty' }),\n    });\n    const body = await res.json();\n    expect(body.content).toBe('');\n  });\n});\n\ndescribe('WebSocket collaboration', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n  let wsUrl: string;\n  let baseUrl: string;\n\n  beforeEach(async () => {\n    app = createApp();\n    port = app.start();\n    wsUrl = `ws://localhost:${port}`;\n    baseUrl = `http://localhost:${port}`;\n    await new Promise((r) => setTimeout(r, 50));\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  async function createDoc(id: string, title: string, content = '') {\n    await fetch(`${baseUrl}/api/docs`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id, title, content }),\n    });\n  }\n\n  function connectWs(docId: string): Promise<{ ws: WebSocket; syncMsg: unknown }> {\n    return new Promise((resolve, reject) => {\n      const ws = new WebSocket(`${wsUrl}/ws/docs/${docId}`);\n      ws.on('error', reject);\n      ws.once('message', (data) => {\n        const syncMsg = JSON.parse(data.toString());\n        resolve({ ws, syncMsg });\n      });\n    });\n  }\n\n  function waitForMessage(ws: WebSocket, timeout = 3000): Promise<unknown> {\n    return new Promise((resolve, reject) => {\n      const timer = setTimeout(() => reject(new Error('Message timeout')), timeout);\n      ws.once('message', (data) => {\n        clearTimeout(timer);\n        resolve(JSON.parse(data.toString()));\n      });\n    });\n  }\n\n  it('should send sync message on connect', async () => {\n    await createDoc('ws1', 'WS Test', 'hello');\n    const { ws, syncMsg } = await connectWs('ws1');\n    expect(syncMsg).toEqual({ type: 'sync', content: 'hello', version: 1 });\n    ws.close();\n  });\n\n  it('should reject connection to nonexistent document', async () => {\n    const ws = new WebSocket(`${wsUrl}/ws/docs/nonexistent`);\n    const msg = await new Promise<unknown>((resolve) => {\n      ws.once('message', (data) => resolve(JSON.parse(data.toString())));\n    });\n    expect(msg).toHaveProperty('type', 'error');\n    ws.close();\n  });\n\n  it('should apply insert operation and broadcast', async () => {\n    await createDoc('ws2', 'WS2', 'ab');\n    const { ws: ws1 } = await connectWs('ws2');\n    const { ws: ws2 } = await connectWs('ws2');\n\n    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: 'X' }, version: 1 }));\n\n    // ws1 should get ack\n    const ack = await waitForMessage(ws1);\n    expect(ack).toHaveProperty('type', 'ack');\n\n    // ws2 should get broadcast\n    const broadcast = await waitForMessage(ws2);\n    expect(broadcast).toHaveProperty('type', 'op');\n\n    // Verify document state via REST\n    const res = await fetch(`${baseUrl}/api/docs/ws2`);\n    const body = await res.json();\n    expect(body.content).toBe('aXb');\n\n    ws1.close();\n    ws2.close();\n  });\n\n  it('should apply delete operation', async () => {\n    await createDoc('ws3', 'WS3', 'abc');\n    const { ws } = await connectWs('ws3');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'delete', pos: 1, length: 1 }, version: 1 }));\n    await waitForMessage(ws); // ack\n\n    const res = await fetch(`${baseUrl}/api/docs/ws3`);\n    const body = await res.json();\n    expect(body.content).toBe('ac');\n\n    ws.close();\n  });\n\n  it('should reject invalid operations', async () => {\n    await createDoc('ws4', 'WS4', 'abc');\n    const { ws } = await connectWs('ws4');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'bad' } }));\n    const err = await waitForMessage(ws);\n    expect(err).toHaveProperty('type', 'error');\n\n    ws.close();\n  });\n\n  it('should reject invalid JSON', async () => {\n    await createDoc('ws5', 'WS5', 'abc');\n    const { ws } = await connectWs('ws5');\n\n    ws.send('not json');\n    const err = await waitForMessage(ws);\n    expect(err).toHaveProperty('type', 'error');\n\n    ws.close();\n  });\n\n  it('should handle concurrent edits with OT', async () => {\n    await createDoc('ws6', 'WS6', 'ab');\n    const { ws: ws1 } = await connectWs('ws6');\n    const { ws: ws2 } = await connectWs('ws6');\n\n    // Both send insert at same position/version concurrently\n    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: '1' }, version: 1 }));\n    ws2.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: '2' }, version: 1 }));\n\n    // Wait for acks and broadcasts\n    await waitForMessage(ws1); // ack for ws1's op\n    await waitForMessage(ws2); // broadcast of ws1's op to ws2\n\n    // ws2's op needs to be transformed\n    const msgs1: unknown[] = [];\n    const msgs2: unknown[] = [];\n    await new Promise<void>((resolve) => {\n      let count = 0;\n      const done = () => { if (++count >= 2) resolve(); };\n      ws1.once('message', (d) => { msgs1.push(JSON.parse(d.toString())); done(); });\n      ws2.once('message', (d) => { msgs2.push(JSON.parse(d.toString())); done(); });\n    });\n\n    // Verify convergence via REST - both inserts should be preserved\n    const res = await fetch(`${baseUrl}/api/docs/ws6`);\n    const body = await res.json();\n    const content = body.content;\n    expect(content).toContain('1');\n    expect(content).toContain('2');\n    expect(content.length).toBe(4);\n\n    ws1.close();\n    ws2.close();\n  });\n\n  it('should handle 10 concurrent clients', async () => {\n    await createDoc('ws7', 'WS7', '');\n    const clients: WebSocket[] = [];\n    for (let i = 0; i < 10; i++) {\n      const { ws } = await connectWs('ws7');\n      clients.push(ws);\n    }\n\n    // Each client sends an insert\n    for (let i = 0; i < 10; i++) {\n      clients[i].send(JSON.stringify({\n        type: 'op',\n        op: { type: 'insert', pos: 0, text: String(i) },\n        version: 1,\n      }));\n    }\n\n    // Wait for all operations to propagate\n    await new Promise((resolve) => setTimeout(resolve, 1000));\n\n    // Verify all characters are present in the document\n    const res = await fetch(`${baseUrl}/api/docs/ws7`);\n    const body = await res.json();\n    const content = body.content;\n    for (let i = 0; i < 10; i++) {\n      expect(content).toContain(String(i));\n    }\n    expect(content.length).toBe(10);\n\n    for (const ws of clients) {\n      ws.close();\n    }\n  });\n});\n\ndescribe('Persistence', () => {\n  it('should persist documents across restarts', async () => {\n    const dbPath = `/tmp/test-persist-${Date.now()}.db`;\n    const app1 = createApp(dbPath);\n    const port1 = app1.start();\n\n    await fetch(`http://localhost:${port1}/api/docs`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'persist', title: 'Persist', content: 'data' }),\n    });\n    await app1.stop();\n\n    const app2 = createApp(dbPath);\n    const port2 = app2.start();\n\n    const res = await fetch(`http://localhost:${port2}/api/docs/persist`);\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.content).toBe('data');\n\n    await app2.stop();\n  });\n});\n","structuredPatch":[{"oldStart":312,"oldLines":30,"newStart":312,"newLines":24,"lines":[" ","   it('should send sync message on connect', async () => {","     await createDoc('ws1', 'WS Test', 'hello');","-    const ws = await connectWs('ws1');","-","-    // Debug: check if ws is working","-    const msgs = (ws as any).__messages as Buffer[];","-    console.log('Messages received during connect:', msgs.length, msgs.map(m => m.toString()));","-","-    const msg = await waitForMessage(ws);","-    expect(msg).toEqual({ type: 'sync', content: 'hello', version: 1 });","+    const { ws, syncMsg } =