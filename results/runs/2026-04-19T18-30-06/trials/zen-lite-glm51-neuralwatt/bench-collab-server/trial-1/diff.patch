\n    await app2.stop();\n  });\n});","originalFile":"import { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport { WebSocket } from 'ws';\nimport { createApp } from '../src/server.js';\nimport { applyOp, transform, validateOp } from '../src/ot.js';\nimport type { Op } from '../src/ot.js';\n\ndescribe('OT module', () => {\n  describe('applyOp', () => {\n    it('should insert text at position', () => {\n      expect(applyOp('', { type: 'insert', pos: 0, text: 'hello' })).toBe('hello');\n      expect(applyOp('hello', { type: 'insert', pos: 5, text: ' world' })).toBe('hello world');\n      expect(applyOp('heworld', { type: 'insert', pos: 2, text: 'llo ' })).toBe('hello world');\n    });\n\n    it('should delete text at position', () => {\n      expect(applyOp('hello', { type: 'delete', pos: 0, length: 5 })).toBe('');\n      expect(applyOp('hello world', { type: 'delete', pos: 5, length: 6 })).toBe('hello');\n      expect(applyOp('hello', { type: 'delete', pos: 2, length: 1 })).toBe('helo');\n    });\n\n    it('should reject invalid operations', () => {\n      expect(() => applyOp('hi', { type: 'insert', pos: 5, text: 'x' })).toThrow();\n      expect(() => applyOp('hi', { type: 'delete', pos: 0, length: 5 })).toThrow();\n      expect(() => applyOp('hi', { type: 'insert', pos: -1, text: 'x' })).toThrow();\n    });\n  });\n\n  describe('transform', () => {\n    it('should transform insert vs insert (left before right)', () => {\n      const op1: Op = { type: 'insert', pos: 2, text: 'A' };\n      const op2: Op = { type: 'insert', pos: 5, text: 'B' };\n      const t = transform(op1, op2);\n      expect(t).toEqual({ type: 'insert', pos: 2, text: 'A' });\n    });\n\n    it('should transform insert vs insert (right before left)', () => {\n      const op1: Op = { type: 'insert', pos: 5, text: 'B' };\n      const op2: Op = { type: 'insert', pos: 2, text: 'A' };\n      const t = transform(op1, op2);\n      expect(t).toEqual({ type: 'insert', pos: 6, text: 'B' });\n    });\n\n    it('should transform insert vs delete', () => {\n      const op1: Op = { type: 'insert', pos: 7, text: 'X' };\n      const op2: Op = { type: 'delete', pos: 2, length: 3 };\n      const t = transform(op1, op2);\n      expect(t).toEqual({ type: 'insert', pos: 4, text: 'X' });\n    });\n\n    it('should transform delete vs insert', () => {\n      const op1: Op = { type: 'delete', pos: 5, length: 2 };\n      const op2: Op = { type: 'insert', pos: 2, text: 'AB' };\n      const t = transform(op1, op2);\n      expect(t).toEqual({ type: 'delete', pos: 7, length: 2 });\n    });\n\n    it('should transform delete vs delete (non-overlapping)', () => {\n      const op1: Op = { type: 'delete', pos: 0, length: 2 };\n      const op2: Op = { type: 'delete', pos: 5, length: 2 };\n      const t = transform(op1, op2);\n      expect(t).toEqual({ type: 'delete', pos: 0, length: 2 });\n    });\n\n    it('should preserve convergence: insert vs insert', () => {\n      const base = 'hello';\n      const op1: Op = { type: 'insert', pos: 2, text: 'A' };\n      const op2: Op = { type: 'insert', pos: 4, text: 'B' };\n      const t1 = transform(op1, op2);\n      const t2 = transform(op2, op1);\n      expect(applyOp(applyOp(base, op2), t1)).toBe(applyOp(applyOp(base, op1), t2));\n    });\n\n    it('should preserve convergence: insert vs delete', () => {\n      const base = 'hello world';\n      const op1: Op = { type: 'insert', pos: 6, text: 'X' };\n      const op2: Op = { type: 'delete', pos: 2, length: 4 };\n      const t1 = transform(op1, op2);\n      const t2 = transform(op2, op1);\n      expect(applyOp(applyOp(base, op2), t1)).toBe(applyOp(applyOp(base, op1), t2));\n    });\n  });\n\n  describe('validateOp', () => {\n    it('should accept valid operations', () => {\n      expect(validateOp({ type: 'insert', pos: 0, text: 'hi' })).toBe(true);\n      expect(validateOp({ type: 'delete', pos: 0, length: 2 })).toBe(true);\n    });\n\n    it('should reject invalid operations', () => {\n      expect(validateOp(null)).toBe(false);\n      expect(validateOp({})).toBe(false);\n      expect(validateOp({ type: 'insert' })).toBe(false);\n      expect(validateOp({ type: 'delete', pos: -1, length: 1 })).toBe(false);\n      expect(validateOp({ type: 'unknown' })).toBe(false);\n    });\n  });\n});\n\ndescribe('REST API', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n  let baseUrl: string;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start();\n    baseUrl = `http://localhost:${port}`;\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  async function apiFetch(path: string, options?: RequestInit): Promise<Response> {\n    return fetch(`${baseUrl}/api${path}`, options);\n  }\n\n  it('should create a document', async () => {\n    const res = await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'doc1', title: 'Test Doc', content: 'hello' }),\n    });\n    expect(res.status).toBe(201);\n    const body = await res.json();\n    expect(body.id).toBe('doc1');\n    expect(body.title).toBe('Test Doc');\n    expect(body.content).toBe('hello');\n  });\n\n  it('should reject creating a document without id or title', async () => {\n    const res = await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'No ID' }),\n    });\n    expect(res.status).toBe(400);\n\n    const res2 = await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'no-title' }),\n    });\n    expect(res2.status).toBe(400);\n  });\n\n  it('should reject duplicate document id', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'dup', title: 'First' }),\n    });\n    const res = await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'dup', title: 'Second' }),\n    });\n    expect(res.status).toBe(409);\n  });\n\n  it('should list documents', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'a', title: 'A' }),\n    });\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'b', title: 'B' }),\n    });\n    const res = await apiFetch('/docs');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body).toHaveLength(2);\n  });\n\n  it('should get a document', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'x', title: 'X', content: 'content' }),\n    });\n    const res = await apiFetch('/docs/x');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.content).toBe('content');\n  });\n\n  it('should return 404 for missing document', async () => {\n    const res = await apiFetch('/docs/nonexistent');\n    expect(res.status).toBe(404);\n  });\n\n  it('should update a document', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'u1', title: 'Old', content: 'old' }),\n    });\n    const res = await apiFetch('/docs/u1', {\n      method: 'PUT',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title: 'New', content: 'new' }),\n    });\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.title).toBe('New');\n    expect(body.content).toBe('new');\n  });\n\n  it('should delete a document', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'd1', title: 'Delete Me' }),\n    });\n    const res = await apiFetch('/docs/d1', { method: 'DELETE' });\n    expect(res.status).toBe(204);\n\n    const getRes = await apiFetch('/docs/d1');\n    expect(getRes.status).toBe(404);\n  });\n\n  it('should return 404 when deleting nonexistent document', async () => {\n    const res = await apiFetch('/docs/nope', { method: 'DELETE' });\n    expect(res.status).toBe(404);\n  });\n\n  it('should track version history', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'v1', title: 'Versions', content: 'v1' }),\n    });\n    const res = await apiFetch('/docs/v1/versions');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body).toHaveLength(1);\n    expect(body[0].version).toBe(1);\n  });\n\n  it('should get a specific version', async () => {\n    await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'v2', title: 'V2', content: 'initial' }),\n    });\n    const res = await apiFetch('/docs/v2/versions/1');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.content).toBe('initial');\n  });\n\n  it('should default content to empty string', async () => {\n    const res = await apiFetch('/docs', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id: 'empty', title: 'Empty' }),\n    });\n    const body = await res.json();\n    expect(body.content).toBe('');\n  });\n});\n\ndescribe('WebSocket collaboration', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n  let wsUrl: string;\n  let baseUrl: string;\n\n  beforeEach(async () => {\n    app = createApp();\n    port = app.start();\n    wsUrl = `ws://localhost:${port}`;\n    baseUrl = `http://localhost:${port}`;\n    await new Promise((r) => setTimeout(r, 50));\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  async function createDoc(id: string, title: string, content = '') {\n    await fetch(`${baseUrl}/api/docs`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ id, title, content }),\n    });\n  }\n\n  function connectWs(docId: string): Promise<WebSocket> {\n    return new Promise((resolve, reject) => {\n      const ws = new WebSocket(`${wsUrl}/ws/docs/${docId}`);\n      ws.on('open', () => resolve(ws));\n      ws.on('error', reject);\n    });\n  }\n\n  function waitForMessage(ws: WebSocket, timeout = 3000): Promise<unknown> {\n    return new Promise((resolve, reject) => {\n      const timer = setTimeout(() => reject(new Error('Message timeout')), timeout);\n      ws.once('message', (data) => {\n        clearTimeout(timer);\n        resolve(JSON.parse(data.toString()));\n      });\n    });\n  }\n\n  it('should send sync message on connect', async () => {\n    await createDoc('ws1', 'WS Test', 'hello');\n    const ws = await connectWs('ws1');\n    const msg = await waitForMessage(ws);\n    expect(msg).toEqual({ type: 'sync', content: 'hello', version: 1 });\n    ws.close();\n  });\n\n  it('should reject connection to nonexistent document', async () => {\n    const ws = new WebSocket(`${wsUrl}/ws/docs/nonexistent`);\n    const msg = await waitForMessage(ws);\n    expect(msg).toHaveProperty('type', 'error');\n    ws.close();\n  });\n\n  it('should apply insert operation and broadcast', async () => {\n    await createDoc('ws2', 'WS2', 'ab');\n    const ws1 = await connectWs('ws2');\n    await waitForMessage(ws1); // sync\n    const ws2 = await connectWs('ws2');\n    await waitForMessage(ws2); // sync\n\n    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: 'X' }, version: 1 }));\n\n    // ws1 should get ack\n    const ack = await waitForMessage(ws1);\n    expect(ack).toHaveProperty('type', 'ack');\n\n    // ws2 should get broadcast\n    const broadcast = await waitForMessage(ws2);\n    expect(broadcast).toHaveProperty('type', 'op');\n\n    // Verify document state via REST\n    const res = await fetch(`${baseUrl}/api/docs/ws2`);\n    const body = await res.json();\n    expect(body.content).toBe('aXb');\n\n    ws1.close();\n    ws2.close();\n  });\n\n  it('should apply delete operation', async () => {\n    await createDoc('ws3', 'WS3', 'abc');\n    const ws = await connectWs('ws3');\n    await waitForMessage(ws); // sync\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'delete', pos: 1, length: 1 }, version: 1 }));\n    await waitForMessage(ws); // ack\n\n    const res = await fetch(`${baseUrl}/api/docs/ws3`);\n    const body = await res.json();\n    expect(body.content).toBe('ac');\n\n    ws.close();\n  });\n\n  it('should reject invalid operations', async () => {\n    await createDoc('ws4', 'WS4', 'abc');\n    const ws = await connectWs('ws4');\n    await waitForMessage(ws); // sync\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'bad' } }));\n    const err = await waitForMessage(ws);\n    expect(err).toHaveProperty('type', 'error');\n\n    ws.close();\n  });\n\n  it('should reject invalid JSON', async () => {\n    await createDoc('ws5', 'WS5', 'abc');\n    const ws = await connectWs('ws5');\n    await waitForMessage(ws); // sync\n\n    ws.send('not json');\n    const err = await waitForMessage(ws);\n    expect(err).toHaveProperty('type', 'error');\n\n    ws.close();\n  });\n\n  it('should handle concurrent edits with OT', async () => {\n    await createDoc('ws6', 'WS6', 'ab');\n    const ws1 = await connectWs('ws6');\n    await waitForMessage(ws1); // sync\n    const ws2 = await connectWs('ws6');\n    await waitForMessage(ws2); // sync\n\n    // Both send insert at same position/version concurrently\n    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: '1' }, version: 1 }));\n    ws2.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: '2' }, version: 1 }));\n\n    // Wait for acks and broadcasts\n    await waitForMessage(ws1); // ack for ws1's op\n    await waitForMessage(ws2); // broadcast of ws1's op to ws2\n\n    // ws2's op needs to be transformed\n    const msgs1: unknown[] = [];\n    const msgs2: unknown[] = [];\n    await new Promise<void>((resolve) => {\n      let count = 0;\n      const done = () => { if (++count >= 2) resolve(); };\n      ws1.once('message', (d) => { msgs1.push(JSON.parse(d.toString())); done(); });\n      ws2.once('message', (d) => { msgs2.push(JSON.parse(d.toString())); done(); });\n    });\n\n    // Verify convergence via REST - both inserts should be preserved\n    const res = await fetch(`${baseUrl}/api/docs/ws6`);\n    const body = await res.json();\n    const content = body.content;\n    expect(content).toContain('1');\n    expect(content).toContain('2');\n    expect(content.length).toBe(4);\n\n    ws1.close();\n    ws2.close();\n  });\n\n  it('should handle 10 concurrent clients', async () => {\n    await createDoc('ws7', 'WS7', '');\n    const clients: WebSocket[] = [];\n    for (let i = 0; i < 10; i++) {\n      const ws = await connectWs('ws7');\n      await waitForMessage(ws); // sync\n      clients.push(ws);\n    }\n\n    // Each client sends an insert\n    for (let i = 0; i < 10; i++) {\n      clients[i].send(JSON.stringify({\n        type: 'op',\n        op: { type: 'insert', pos: 0, text: String(i) },\n        version: 1,\n      }));\n    }\n\n    // Wait for all operations to propagate\n    await new Promise((resolve) => setTimeout(resolve, 1000));\n\n    // Verify all characters are present in the document\n    const res = await fetch(`${baseUrl}/api/docs/ws7`);\n    const body = await res.json();\n    const content = body.content;\n    for (let i = 0; i < 10; i++) {\n      expect(content).toContain(String(i));\n   