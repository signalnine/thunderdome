+++ b/src/types.ts
@@ -0,0 +1,32 @@
+/** Public types for the versioned document store. */
+
+/** A single point-in-time snapshot of a document's content. */
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+/**
+ * A field-level disagreement discovered during a three-way merge.
+ * `path` is a dot-separated JSON path (empty string for a whole-document
+ * conflict, e.g. modify-vs-delete of the document itself).
+ */
+export interface Conflict {
+  documentId: string;
+  path: string;
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  base: any;
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  ours: any;
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  theirs: any;
+}
+
+export interface MergeResult {
+  /** documentId -> resulting content (conflicts resolved in favour of "ours"). */
+  merged: Record<string, object>;
+  conflicts: Conflict[];
+  /** true if the merge had no conflicts and was applied to the current branch. */
+  applied: boolean;
+}
