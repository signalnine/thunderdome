+import { describe, it, expect } from 'vitest';
+import { DocumentStore } from '../src/index';
+
+describe('CRUD', () => {
+  it('creates and gets a document', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+
