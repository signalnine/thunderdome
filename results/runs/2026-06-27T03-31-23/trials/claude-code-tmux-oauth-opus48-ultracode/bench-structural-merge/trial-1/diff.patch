@@ -0,0 +1,348 @@
+/**
+ * In-memory versioned document store with three-way structural merge —
+ * "Git for JSON documents".
+ *
+ * The model is a commit DAG. Each branch is a pointer to a head commit, and each
+ * commit holds a full snapshot of every document (content objects are shared by
+ * reference between commits and only ever cloned at the public boundary, so the
+ * snapshots are cheap and immutable). This makes branch isolation, version
+ * history, and the three-way merge base all fall out of ordinary graph queries.
+ */
+import type { Conflict, MergeResult, Version } from './types.js';
+import { deepClone, deepEqual, isPlainObject } from './util.js';
+import { ABSENT, mergeValue } from './merge.js';
+
+export type { Conflict, MergeResult, Version } from './types.js';
+
+/** Tombstone marking a document deleted on a branch (distinct from "never existed"). */
+const DELETED = Symbol('deleted');
+type DocValue = object | typeof DELETED;
+
+interface Commit {
+  id: string;
+  /** Monotonic creation order — also a valid topological numbering of the DAG. */
+  seq: number;
+  timestamp: number;
+  parents: string[];
+  docs: Map<string, DocValue>;
+  /** documentId -> versionId for "set" versions (create/update/merge) born here. */
+  versions: Map<string, string>;
+}
+
+export class DocumentStore {
+  private commits = new Map<string, Commit>();
+  private branches = new Map<string, string>();
+  private versionIndex = new Map<string, { commitId: string; documentId: string }>();
+  private current: string;
+  private seqCounter = 0;
+  private versionCounter = 0;
+
+  constructor() {
+    const root = this.newCommit([], new Map());
+    this.branches.set('main', root.id);
+    this.current = 'main';
+  }
+
+  // ---------------------------------------------------------------- internals
+
+  private newCommit(parents: string[], docs: Map<string, DocValue>): Commit {
+    const seq = this.seqCounter++;
+    const commit: Commit = {
+      id: `c${seq}`,
+      seq,
+      timestamp: Date.now(),
+      parents,
+      docs,
+      versions: new Map(),
+    };
+    this.commits.set(commit.id, commit);
+    return commit;
+  }
+
+  private headId(): string {
+    return this.branches.get(this.current)!;
+  }
+
+  private head(): Commit {
+    return this.commits.get(this.headId())!;
+  }
+
+  private requireBranch(name: string): string {
+    const head = this.branches.get(name);
+    if (head === undefined) throw new Error(`Branch not found: ${name}`);
+    return head;
+  }
+
+  private isLive(value: DocValue | undefined): value is object {
+    return value !== undefined && value !== DELETED;
+  }
+
+  private recordVersion(commit: Commit, documentId: string): void {
+    const versionId = `v${this.versionCounter++}`;
+    commit.versions.set(documentId, versionId);
+    this.versionIndex.set(versionId, { commitId: commit.id, documentId });
+  }
+
+  /** Apply a single-document change as a new commit on the current branch. */
+  private commitChange(documentId: string, value: DocValue, isVersion: boolean): void {
+    const parent = this.head();
+    const docs = new Map(parent.docs);
+    docs.set(documentId, value);
+    const commit = this.newCommit([parent.id], docs);
+    if (isVersion) this.recordVersion(commit, documentId);
+    this.branches.set(this.current, commit.id);
+  }
+
+  /** All commits reachable from `startId` (inclusive) via parent edges. */
+  private ancestry(startId: string): Commit[] {
+    const seen = new Set<string>();
+    const stack = [startId];
+    const out: Commit[] = [];
+    while (stack.length > 0) {
+      const id = stack.pop()!;
+      if (seen.has(id)) continue;
+      seen.add(id);
+      const commit = this.commits.get(id)!;
+      out.push(commit);
+      for (const parent of commit.parents) stack.push(parent);
+    }
+    return out;
+  }
+
+  /**
+   * Maximal common ancestors of two commits — the common ancestors not dominated
+   * (i.e. not an ancestor of) another common ancestor. A simple fork yields exactly
+   * one (the fork point); a criss-cross history (two independent merges of the same
+   * pair of commits) yields several incomparable ones.
+   */
+  private maximalCommonAncestors(aId: string, bId: string): string[] {
+    const ancestorsOfA = new Set(this.ancestry(aId).map((c) => c.id));
+    const common = this.ancestry(bId)
+      .filter((c) => ancestorsOfA.has(c.id))
+      .map((c) => c.id);
+    const commonSet = new Set(common);
+    const dominated = new Set<string>();
+    for (const id of common) {
+      for (const ancestor of this.ancestry(id)) {
+        if (ancestor.id !== id && commonSet.has(ancestor.id)) dominated.add(ancestor.id);
+      }
+    }
+    return common
+      .filter((id) => !dominated.has(id))
+      .sort((x, y) => this.commits.get(x)!.seq - this.commits.get(y)!.seq);
+  }
+
+  /**
+   * The three-way merge base *state*. With a single common ancestor this is simply
+   * that commit's snapshot; with several (a criss-cross) it is a recursively merged
+   * "virtual" base, mirroring git's recursive merge strategy. The root commit is a
+   * common ancestor of everything, so there is always at least one base.
+   */
+  private mergeBaseState(aId: string, bId: string): Map<string, DocValue> {
+    const bases = this.maximalCommonAncestors(aId, bId);
+    let accId = bases[0];
+    for (let i = 1; i < bases.length; i++) {
+      accId = this.virtualMerge(accId, bases[i]);
+    }
+    return this.commits.get(accId)!.docs;
+  }
+
+  /**
+   * Merge two ancestor commits into a synthetic virtual-base commit, resolving any
+   * ties in favour of the a-side. The synthetic commit is never referenced by a
+   * branch, so it stays invisible to history/ancestry queries on real branches.
+   */
+  private virtualMerge(aId: string, bId: string): string {
+    const baseState = this.mergeBaseState(aId, bId);
+    const a = this.commits.get(aId)!;
+    const b = this.commits.get(bId)!;
+    const documentIds = new Set<string>([
+      ...baseState.keys(),
+      ...a.docs.keys(),
+      ...b.docs.keys(),
+    ]);
+    const merged = new Map<string, DocValue>();
+    const sink: Conflict[] = [];
+    for (const documentId of documentIds) {
+      const result = mergeValue(
+        this.stateInput(baseState, documentId),
+        this.stateInput(a.docs, documentId),
+        this.stateInput(b.docs, documentId),
+        documentId,
+        '',
+        sink,
+      );
+      if (result !== ABSENT) {
+        merged.set(documentId, deepClone(result) as object);
+      } else if (this.isLive(baseState.get(documentId)) || a.docs.has(documentId)) {
+        merged.set(documentId, DELETED);
+      }
+    }
+    return this.newCommit([aId, bId], merged).id;
+  }
+
+  /** A document's content for merge purposes (deletions/absences map to ABSENT). */
+  private stateInput(state: Map<string, DocValue>, documentId: string): unknown {
+    const value = state.get(documentId);
+    if (value === undefined || value === DELETED) return ABSENT;
+    return value;
+  }
+
+  /** The live document set of a commit, deep-cloned for external use. */
+  private snapshot(commit: Commit): Record<string, object> {
+    const out: Record<string, object> = {};
+    for (const [documentId, value] of commit.docs) {
+      if (this.isLive(value)) out[documentId] = deepClone(value);
+    }
+    return out;
+  }
+
+  // ----------------------------------------------------------------- CRUD
+
+  create(id: string, content: object): void {
+    if (!isPlainObject(content)) {
+      throw new Error('Document content must be a plain object');
+    }
+    if (this.isLive(this.head().docs.get(id))) {
+      throw new Error(`Document already exists: ${id}`);
+    }
+    this.commitChange(id, deepClone(content), true);
+  }
+
+  get(id: string): object {
+    const value = this.head().docs.get(id);
+    if (!this.isLive(value)) throw new Error(`Document not found: ${id}`);
+    return deepClone(value);
+  }
+
+  update(id: string, content: object): void {
+    if (!isPlainObject(content)) {
+      throw new Error('Document content must be a plain object');
+    }
+    if (!this.isLive(this.head().docs.get(id))) {
+      throw new Error(`Document not found: ${id}`);
+    }
+    this.commitChange(id, deepClone(content), true);
+  }
+
+  delete(id: string): void {
+    if (!this.isLive(this.head().docs.get(id))) {
+      throw new Error(`Document not found: ${id}`);
+    }
+    this.commitChange(id, DELETED, false);
+  }
+
+  // ------------------------------------------------------------ version history
+
+  getHistory(id: string): Version[] {
+    const versions = this.ancestry(this.headId())
+      .filter((commit) => commit.versions.has(id))
+      .sort((a, b) => a.seq - b.seq)
+      .map((commit) => ({
+        id: commit.versions.get(id)!,
+        timestamp: commit.timestamp,
+        content: deepClone(commit.docs.get(id) as object),
+      }));
+    if (versions.length === 0) throw new Error(`Document not found: ${id}`);
+    return versions;
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const entry = this.versionIndex.get(versionId);
+    if (!entry || entry.documentId !== id) {
+      throw new Error(`Version not found: ${versionId}`);
+    }
+    // Only versions reachable from the current branch are visible.
+    const visible = this.ancestry(this.headId()).some((c) => c.id === entry.commitId);
+    if (!visible) throw new Error(`Version not found: ${versionId}`);
+    const content = this.commits.get(entry.commitId)!.docs.get(id);
+    if (!this.isLive(content)) throw new Error(`Version not found: ${versionId}`);
+    return deepClone(content);
+  }
+
+  // ----------------------------------------------------------------- branching
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) throw new Error(`Branch already exists: ${name}`);
+    const sourceHead = this.requireBranch(fromBranch ?? this.current);
+    this.branches.set(name, sourceHead);
+  }
+
+  switchBranch(name: string): void {
+    this.requireBranch(name);
+    this.current = name;
+  }
+
+  getBranch(): string {
+    return this.current;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  // ------------------------------------------------------------------- merging
+
+  merge(sourceBranch: string): MergeResult {
+    const sourceHeadId = this.requireBranch(sourceBranch);
+    const ours = this.head();
+    const theirs = this.commits.get(sourceHeadId)!;
+    const base = this.mergeBase(ours.id, theirs.id);
+
+    // Source has nothing the current branch lacks — no-op.
+    if (base.id === theirs.id) {
+      return { merged: this.snapshot(ours), conflicts: [], applied: true };
+    }
+    // Current branch has no divergent commits — fast-forward to source.
+    if (base.id === ours.id) {
+      this.branches.set(this.current, theirs.id);
+      return { merged: this.snapshot(theirs), conflicts: [], applied: true };
+    }
+
+    const documentIds = new Set<string>([
+      ...base.docs.keys(),
+      ...ours.docs.keys(),
+      ...theirs.docs.keys(),
+    ]);
+
+    const conflicts: Conflict[] = [];
+    const merged: Record<string, object> = {};
+    const mergedDocs = new Map<string, DocValue>();
+
+    for (const documentId of documentIds) {
+      const result = mergeValue(
+        this.docInput(base, documentId),
+        this.docInput(ours, documentId),
+        this.docInput(theirs, documentId),
+        documentId,
+        '',
+        conflicts,
+      );
+      if (result !== ABSENT) {
+        merged[documentId] = result as object;
+        mergedDocs.set(documentId, deepClone(result) as object);
+      } else if (ours.docs.has(documentId) || base.docs.has(documentId)) {
+        // Document existed before but is gone after the merge — keep a tombstone.
+        mergedDocs.set(documentId, DELETED);
+      }
+    }
+
+    if (conflicts.length > 0) {
+      // Conflicts are not auto-applied; the current branch is left untouched.
+      return { merged, conflicts, applied: false };
+    }
+
+    const commit = this.newCommit([ours.id, theirs.id], mergedDocs);
+    for (const [documentId, value] of mergedDocs) {
+      if (value === DELETED) continue;
+      const before = ours.docs.get(documentId);
+      if (!this.isLive(before) || !deepEqual(before, value)) {
+        this.recordVersion(commit, documentId);
+      }
+    }
+    this.branches.set(this.current, commit.id);
+    return { merged, conflicts: [], applied: true };
+  }
+}
+
+export default DocumentStore;
