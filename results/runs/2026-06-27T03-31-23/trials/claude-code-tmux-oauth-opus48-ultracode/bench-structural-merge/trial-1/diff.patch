@@ -0,0 +1,75 @@
+/** Recursive three-way structural merge of a single JSON value. */
+import type { Conflict } from './types.js';
+import { deepClone, deepEqual, isPlainObject } from './util.js';
+
+/** Sentinel meaning "this key / document does not exist on this side". */
+export const ABSENT = Symbol('absent');
+
+type Maybe = unknown;
+
+function isAbsent(value: Maybe): boolean {
+  return value === ABSENT;
+}
+
+/** Equality that also understands the ABSENT sentinel (absent === absent). */
+function eq(a: Maybe, b: Maybe): boolean {
+  if (isAbsent(a) || isAbsent(b)) return a === b;
+  return deepEqual(a, b);
+}
+
+function cloneMaybe(value: Maybe): Maybe {
+  return isAbsent(value) ? ABSENT : deepClone(value);
+}
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+function publicValue(value: Maybe): any {
+  return isAbsent(value) ? undefined : deepClone(value);
+}
+
+/**
+ * Three-way merge of `base`/`ours`/`theirs` at `path`. Returns the merged value
+ * (or ABSENT if the field/document should not exist in the result) and pushes any
+ * conflicts onto `conflicts`. Conflicts are resolved in favour of "ours".
+ */
+export function mergeValue(
+  base: Maybe,
+  ours: Maybe,
+  theirs: Maybe,
+  documentId: string,
+  path: string,
+  conflicts: Conflict[],
+): Maybe {
+  // Both sides agree (same change, or neither changed) — no conflict.
+  if (eq(ours, theirs)) return cloneMaybe(ours);
+  // Only "theirs" changed relative to base — take theirs.
+  if (eq(ours, base)) return cloneMaybe(theirs);
+  // Only "ours" changed relative to base — take ours.
+  if (eq(theirs, base)) return cloneMaybe(ours);
+
+  // Both sides changed differently. If both are objects, merge field by field.
+  if (isPlainObject(ours) && isPlainObject(theirs)) {
+    const baseObj = isPlainObject(base) ? base : undefined;
+    const result: Record<string, unknown> = {};
+    const keys = new Set<string>([...Object.keys(ours), ...Object.keys(theirs)]);
+    for (const key of keys) {
+      const b: Maybe =
+        baseObj && Object.prototype.hasOwnProperty.call(baseObj, key) ? baseObj[key] : ABSENT;
+      const o: Maybe = Object.prototype.hasOwnProperty.call(ours, key) ? ours[key] : ABSENT;
+      const t: Maybe = Object.prototype.hasOwnProperty.call(theirs, key) ? theirs[key] : ABSENT;
+      const childPath = path ? `${path}.${key}` : key;
+      const mergedChild = mergeValue(b, o, t, documentId, childPath, conflicts);
+      if (!isAbsent(mergedChild)) result[key] = mergedChild;
+    }
+    return result;
+  }
+
+  // Scalars, arrays, or a type mismatch where both sides changed → conflict.
+  conflicts.push({
+    documentId,
+    path,
+    base: publicValue(base),
+    ours: publicValue(ours),
+    theirs: publicValue(theirs),
+  });
+  return cloneMaybe(ours);
+}
