: number }>;\n      status?: string;\n    };\n\n    if (eventWithItems.status !== 'cancelled') return;\n\n    if (eventWithItems.items) {\n      for (const item of eventWithItems.items) {\n        this.repo.release(item.productId, item.quantity);\n      }\n    }\n\n    await this.eventBus.emit(ORDER_EVENTS.STOCK_RELEASED, {\n      orderId: event.orderId,\n      timestamp: Date.now(),\n    });\n  }\n\n  setStock(productId: string, quantity: number): void {\n    this.repo.setStock(productId, quantity);\n  }\n\n  getStock(productId: string) {\n    return this.repo.getStock(productId);\n  }\n}\nexport interface StockRecord {\n  productId: string;\n  available: number;\n  reserved: number;\n}\n\nexport class InventoryRepository {\n  private store: Map<string, StockRecord> = new Map();\n\n  setStock(productId: string, available: number): void {\n    const existing = this.store.get(productId);\n    this.store.set(productId, {\n      productId,\n      available,\n      reserved: existing?.reserved ?? 0,\n    });\n  }\n\n  getStock(productId: string): StockRecord | undefined {\n    const record = this.store.get(productId);\n    return record ? { ...record } : undefined;\n  }\n\n  reserve(productId: string, quantity: number): boolean {\n    const record = this.store.get(productId);\n    if (!record || record.available < quantity) return false;\n    record.available -= quantity;\n    record.reserved += quantity;\n    return true;\n  }\n\n  release(productId: string, quantity: number): boolean {\n    const record = this.store.get(productId);\n    if (!record || record.reserved < quantity) return false;\n    record.reserved -= quantity;\n    record.available += quantity;\n    return true;\n  }\n\n  clear(): void {\n    this.store.clear();\n  }\n}\nimport { EventBus } from '../events/bus.js';\nimport { ORDER_EVENTS } from '../events/types.js';\nimport { NotificationService } from '../notifications/service.js';\nimport { calculateOrderTotal } from './calculator.js';\nimport { OrderItem } from '../orders/repository.js';\n\nexport interface PaymentRecord {\n  orderId: string;\n  amount: number;\n  method: string;\n  status: 'charged' | 'refunded';\n  processedAt: number;\n}\n\nexport class BillingService {\n  private payments: Map<string, PaymentRecord> = new Map();\n\n  constructor(\n    private eventBus: EventBus,\n    private notificationService: NotificationService\n  ) {}\n\n  registerHandlers(): void {\n    this.eventBus.on(ORDER_EVENTS.STOCK_RESERVED, this.handleStockReserved.bind(this));\n    this.eventBus.on(ORDER_EVENTS.REFUNDED, this.handleRefund);\n  }\n\n  private async handleStockReserved(data: unknown): Promise<void> {\n    const event = data as { orderId: string; items: OrderItem[] };\n    // Payment would be charged here in a real system\n    await this.eventBus.emit(ORDER_EVENTS.PAYMENT_CHARGED, {\n      orderId: event.orderId,\n      amount: 0, // Actual amount set by order service\n      paymentMethod: 'card',\n      timestamp: Date.now(),\n    });\n  }\n\n  async chargePayment(\n    orderId: string,\n    items: OrderItem[],\n    discountPercent: number,\n    taxRate: number,\n    paymentMethod: string\n  ): Promise<PaymentRecord> {\n    const breakdown = calculateOrderTotal(items, discountPercent, taxRate);\n\n    const record: PaymentRecord = {\n      orderId,\n      amount: breakdown.total,\n      method: paymentMethod,\n      status: 'charged',\n      processedAt: Date.now(),\n    };\n\n    this.payments.set(orderId, record);\n    this.notificationService.sendConfirmation(orderId, breakdown.total);\n    return record;\n  }\n\n  private async handleRefund(data: unknown): Promise<void> {\n    const event = data as { orderId: string; amount: number };\n    const payment = this.payments.get(event.orderId);\n    if (payment) {\n      payment.status = 'refunded';\n      this.notificationService.sendRefundNotice(event.orderId, event.amount);\n    }\n  }\n\n  async issueRefund(orderId: string, amount: number): Promise<PaymentRecord | undefined> {\n    const payment = this.payments.get(orderId);\n    if (!payment) return undefined;\n\n    payment.status = 'refunded';\n\n    await this.eventBus.emit(ORDER_EVENTS.REFUNDED, {\n      orderId,\n      amount,\n      timestamp: Date.now(),\n    });\n\n    return { ...payment };\n  }\n\n  getPayment(orderId: string): PaymentRecord | undefined {\n    const p = this.payments.get(orderId);\n    return p ? { ...p } : undefined;\n  }\n\n  clear(): void {\n    this.payments.clear();\n  }\n}\nimport { OrderItem } from '../orders/repository.js';\n\nexport interface PriceBreakdown {\n  subtotal: number;\n  discountAmount: number;\n  taxAmount: number;\n  total: number;\n}\n\nexport function calculateOrderTotal(\n  items: OrderItem[],\n  discountPercent: number,\n  taxRate: number\n): PriceBreakdown {\n  const subtotal = items.reduce(\n    (sum, item) => sum + item.unitPrice * item.quantity,\n    0\n  );\n\n  const discountAmount = Math.round(subtotal * (discountPercent / 100) * 100) / 100;\n  const afterDiscount = Math.round((subtotal - discountAmount) * 100) / 100;\n  const taxAmount = Math.round(afterDiscount * taxRate * 100) / 100;\n  const total = afterDiscount + taxAmount;\n\n  return {\n    subtotal: Math.round(subtotal * 100) / 100,\n    discountAmount: Math.round(discountAmount * 100) / 100,\n    taxAmount: Math.round(taxAmount * 100) / 100,\n    total,\n  };\n}\n","exit_code":0,"status":"completed"}}
