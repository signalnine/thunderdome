@@ -0,0 +1,125 @@
+import { Router, type Request, type Response } from 'express';
+import { randomUUID } from 'node:crypto';
+import type Database from 'better-sqlite3';
+import type { Document, Version } from './models.js';
+
+export function createRouter(db: Database.Database): Router {
+  const router = Router();
+
+  router.post('/docs', (req: Request, res: Response) => {
+    const { title, content } = req.body ?? {};
+    if (typeof title !== 'string' || title.length === 0) {
+      res.status(400).json({ error: 'title is required' });
+      return;
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      res.status(400).json({ error: 'content must be a string' });
+      return;
+    }
+
+    const id = randomUUID();
+    const initialContent = content ?? '';
+
+    const create = db.transaction(() => {
+      db.prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?)').run(
+        id,
+        title,
+        initialContent
+      );
+      db.prepare(
+        'INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)'
+      ).run(id, initialContent);
+    });
+    create();
+
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Document;
+    res.status(201).json(doc);
+  });
+
+  router.get('/docs', (_req: Request, res: Response) => {
+    const docs = db
+      .prepare('SELECT * FROM documents ORDER BY created_at ASC, id ASC')
+      .all() as Document[];
+    res.status(200).json(docs);
+  });
+
+  router.get('/docs/:id', (req: Request, res: Response) => {
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id) as
+      | Document
+      | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.status(200).json(doc);
+  });
+
+  router.put('/docs/:id', (req: Request, res: Response) => {
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id) as
+      | Document
+      | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+
+    const { title } = req.body ?? {};
+    if (title !== undefined && (typeof title !== 'string' || title.length === 0)) {
+      res.status(400).json({ error: 'title must be a non-empty string' });
+      return;
+    }
+
+    const nextTitle = title ?? doc.title;
+    db.prepare("UPDATE documents SET title = ?, updated_at = datetime('now') WHERE id = ?").run(
+      nextTitle,
+      req.params.id
+    );
+    const updated = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id) as Document;
+    res.status(200).json(updated);
+  });
+
+  router.delete('/docs/:id', (req: Request, res: Response) => {
+    const doc = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    db.prepare('DELETE FROM documents WHERE id = ?').run(req.params.id);
+    res.status(204).end();
+  });
+
+  router.get('/docs/:id/versions', (req: Request, res: Response) => {
+    const doc = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const versions = db
+      .prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC')
+      .all(req.params.id) as Version[];
+    res.status(200).json(versions);
+  });
+
+  router.get('/docs/:id/versions/:version', (req: Request, res: Response) => {
+    const doc = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const versionNumber = Number(req.params.version);
+    if (!Number.isInteger(versionNumber) || versionNumber < 0) {
+      res.status(400).json({ error: 'version must be a non-negative integer' });
+      return;
+    }
+    const version = db
+      .prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?')
+      .get(req.params.id, versionNumber) as Version | undefined;
+    if (!version) {
+      res.status(404).json({ error: 'Version not found' });
+      return;
+    }
+    res.status(200).json(version);
+  });
+
+  return router;
+}
