+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface Version {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+export interface InsertOperation {
+  type: 'insert';
+  position: number;
+  text: string;
+}
+
+export interface DeleteOperation {
+  type: 'delete';
+  position: number;
+  count: number;
+}
+
+export type Operation = InsertOperation | DeleteOperation;
diff --git a/src/ot.ts b/src/ot.ts
new file mode 100644
index 0000000..70f65cb
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,99 @@
+import type { Operation } from './models.js';
+
+/**
+ * Apply an operation to document content, returning the new content.
+ */
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+/**
+ * Transform op1 against op2, where both were conceived against the same base
+ * state and op2 has already been applied. Returns the op1 equivalent that can
+ * be applied to the post-op2 state.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op2.type === 'insert') {
+    const shift = op2.text.length;
+    // Tie at the same insert position: op2 is ordered first, so op1 moves
+    // after op2's inserted text.
+    if (op1.position >= op2.position) {
+      return { ...op1, position: op1.position + shift };
+    }
+    return { ...op1 };
+  }
+
+  // op2 is a delete of [op2.position, op2.position + op2.count).
+  const delStart = op2.position;
+  const delEnd = op2.position + op2.count;
+
+  if (op1.type === 'insert') {
+    if (op1.position <= delStart) return { ...op1 };
+    if (op1.position >= delEnd) return { ...op1, position: op1.position - op2.count };
+    return { ...op1, position: delStart };
+  }
+
+  // op1 is a delete of [op1.position, op1.position + op1.count).
+  const start = op1.position;
+  const end = op1.position + op1.count;
+
+  if (end <= delStart) return { ...op1 };
+  if (start >= delEnd) return { ...op1, position: op1.position - op2.count };
+
+  // Overlapping ranges: the overlap was already removed by op2.
+  const overlap = Math.min(end, delEnd) - Math.max(start, delStart);
+  return {
+    type: 'delete',
+    position: Math.min(start, delStart),
+    count: op1.count - overlap,
+  };
+}
+
+/**
+ * Validate that an operation is well-formed and within the bounds of a
+ * document of the given length. Throws an Error describing the problem.
+ */
+export function validateOperation(op: unknown, contentLength: number): Operation {
+  if (op === null || typeof op !== 'object') {
+    throw new Error('Operation must be an object');
+  }
+  const candidate = op as Record<string, unknown>;
+
+  if (candidate.type !== 'insert' && candidate.type !== 'delete') {
+    throw new Error(`Invalid operation type: ${String(candidate.type)}`);
+  }
+  if (
+    typeof candidate.position !== 'number' ||
+    !Number.isInteger(candidate.position) ||
+    candidate.position < 0
+  ) {
+    throw new Error('Operation position must be a non-negative integer');
+  }
+
+  if (candidate.type === 'insert') {
+    if (typeof candidate.text !== 'string' || candidate.text.length === 0) {
+      throw new Error('Insert operation requires non-empty text');
+    }
+    if (candidate.position > contentLength) {
+      throw new Error(`Insert position ${candidate.position} out of bounds (length ${contentLength})`);
+    }
+    return { type: 'insert', position: candidate.position, text: candidate.text };
+  }
+
+  if (
+    typeof candidate.count !== 'number' ||
+    !Number.isInteger(candidate.count) ||
+    candidate.count <= 0
+  ) {
+    throw new Error('Delete operation requires a positive count');
+  }
+  if (candidate.position + candidate.count > contentLength) {
+    throw new Error(
+      `Delete range [${candidate.position}, ${candidate.position + candidate.count}) out of bounds (length ${contentLength})`
+    );
+  }
+  return { type: 'delete', position: candidate.position, count: candidate.count };
+}
