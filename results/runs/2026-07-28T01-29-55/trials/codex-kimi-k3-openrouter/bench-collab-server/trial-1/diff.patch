new file mode 100644
index 0000000..f05977a
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,62 @@
+import express, { type Express } from 'express';
+import { createServer, type Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import type Database from 'better-sqlite3';
+import { createDatabase } from './db.js';
+import { createRouter } from './routes.js';
+import { CollabWebSocketServer } from './ws.js';
+
+export interface AppInstance {
+  app: Express;
+  server: Server;
+  wss: CollabWebSocketServer;
+  db: Database.Database;
+  start: (port?: number) => Promise<number>;
+  stop: () => Promise<void>;
+}
+
+export function createApp(dbPath?: string): AppInstance {
+  const db = createDatabase(dbPath);
+
+  const app = express();
+  app.use(express.json());
+  app.use(createRouter(db));
+
+  const server = createServer(app);
+  const wss = new CollabWebSocketServer(db);
+  wss.attach(server);
+
+  return {
+    app,
+    server,
+    wss,
+    db,
+    start(port: number = 3000): Promise<number> {
+      return new Promise((resolve, reject) => {
+        const onError = (error: Error) => reject(error);
+        server.once('error', onError);
+        server.listen(port, () => {
+          server.removeListener('error', onError);
+          const address = server.address() as AddressInfo;
+          resolve(address.port);
+        });
+      });
+    },
+    stop(): Promise<void> {
+      return new Promise((resolve, reject) => {
+        for (const client of wss.wss.clients) {
+          client.terminate();
+        }
+        wss.close();
+        server.close((error) => {
+          if (error) {
+            reject(error);
+            return;
+          }
+          db.close();
+          resolve();
+        });
+      });
+    },
+  };
+}
diff --git a/src/ws.ts b/src/ws.ts
new file mode 100644
index 0000000..2227787
--- /dev/null
+++ b/src/ws.ts
@@ -0,0 +1,223 @@
+import { WebSocketServer, WebSocket } from 'ws';
+import type { Server } from 'node:http';
+import type { IncomingMessage } from 'node:http';
+import type { Duplex } from 'node:stream';
+import { randomUUID } from 'node:crypto';
+import type Database from 'better-sqlite3';
+import type { Document, Operation } from './models.js';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+
+interface PendingOperation {
+  version: number;
+  operation: Operation;
+}
+
+interface DocumentState {
+  version: number;
+  content: string;
+  pending: PendingOperation[];
+  clients: Map<WebSocket, string>;
+}
+
+export class CollabWebSocketServer {
+  readonly wss: WebSocketServer;
+  private readonly db: Database.Database;
+  private readonly states = new Map<string, DocumentState>();
+
+  constructor(db: Database.Database) {
+    this.db = db;
+    this.wss = new WebSocketServer({ noServer: true });
+  }
+
+  attach(server: Server): void {
+    server.on('upgrade', (request: IncomingMessage, socket: Duplex, head: Buffer) => {
+      const docId = decodeURIComponent((request.url ?? '/').split('?')[0].replace(/^\/+/, ''));
+      if (!docId) {
+        socket.write('HTTP/1.1 404 Not Found\r\n\r\n');
+        socket.destroy();
+        return;
+      }
+      this.wss.handleUpgrade(request, socket, head, (ws) => {
+        this.handleConnection(ws, docId);
+      });
+    });
+  }
+
+  close(): void {
+    for (const ws of this.wss.clients) {
+      ws.terminate();
+    }
+    this.wss.close();
+  }
+
+  private handleConnection(ws: WebSocket, docId: string): void {
+    const doc = this.db.prepare('SELECT * FROM documents WHERE id = ?').get(docId) as
+      | Document
+      | undefined;
+    if (!doc) {
+      ws.send(JSON.stringify({ type: 'error', message: `Document ${docId} not found` }));
+      ws.close();
+      return;
+    }
+
+    let state = this.states.get(docId);
+    if (!state) {
+      const row = this.db
+        .prepare('SELECT MAX(version) AS v FROM versions WHERE document_id = ?')
+        .get(docId) as { v: number | null };
+      state = { version: row.v ?? 0, content: doc.content, pending: [], clients: new Map() };
+      this.states.set(docId, state);
+    }
+
+    const connectionId = randomUUID();
+    try {
+      this.db
+        .prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)')
+        .run(connectionId, docId);
+    } catch {
+      ws.send(JSON.stringify({ type: 'error', message: 'Failed to register connection' }));
+      ws.close();
+      return;
+    }
+    state.clients.set(ws, connectionId);
+
+    ws.send(JSON.stringify({ type: 'sync', content: state.content, version: state.version }));
+
+    // Serialize message handling per connection so that rapid-fire messages
+    // never interleave their DB writes, and later messages always observe
+    // the state left behind by earlier ones.
+    let queue = Promise.resolve();
+    ws.on('message', (data) => {
+      queue = queue
+        .then(() => this.handleMessage(ws, docId, connectionId, data.toString()))
+        .catch(() => {
+          // keep the queue alive
+        });
+    });
+
+    ws.on('close', () => {
+      const st = this.states.get(docId);
+      if (st) {
+        st.clients.delete(ws);
+        if (st.clients.size === 0) {
+          this.states.delete(docId);
+        }
+      }
+      this.db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);
+    });
+  }
+
+  private async handleMessage(
+    ws: WebSocket,
+    docId: string,
+    connectionId: string,
+    raw: string
+  ): Promise<void> {
+    let message: Record<string, unknown>;
+    try {
+      const parsed: unknown = JSON.parse(raw);
+      if (parsed === null || typeof parsed !== 'object') {
+        throw new Error('not an object');
+      }
+      message = parsed as Record<string, unknown>;
+    } catch {
+      this.sendError(ws, 'Malformed message: expected JSON object');
+      return;
+    }
+
+    if (message.type !== 'operation') {
+      this.sendError(ws, `Unknown message type: ${String(message.type)}`);
+      return;
+    }
+
+    try {
+      // Re-read current state each time so queued messages never act on
+      // stale content.
+      const state = this.states.get(docId);
+      let version: number;
+      let content: string;
+      if (state) {
+        version = state.version;
+        content = state.content;
+      } else {
+        const row = this.db
+          .prepare(
+            'SELECT d.content AS content, COALESCE(MAX(v.version), 0) AS version ' +
+              'FROM documents d LEFT JOIN versions v ON v.document_id = d.id WHERE d.id = ? ' +
+              'GROUP BY d.id'
+          )
+          .get(docId) as { content: string; version: number } | undefined;
+        if (!row) {
+          this.sendError(ws, `Document ${docId} not found`);
+          return;
+        }
+        version = row.version;
+        content = row.content;
+      }
+
+      // Transform against operations applied since the client's base version.
+      let op = validateOperation(message.operation, content.length);
+      const baseVersion =
+        typeof message.version === 'number' && Number.isInteger(message.version)
+          ? message.version
+          : version;
+      if (baseVersion > version || baseVersion < 0) {
+        this.sendError(ws, `Invalid base version ${baseVersion} (current version is ${version})`);
+        return;
+      }
+      for (const entry of state?.pending ?? []) {
+        if (entry.version > baseVersion) {
+          op = transformOperation(op, entry.operation);
+        }
+      }
+
+      op = validateOperation(op, content.length);
+
+      const nextContent = applyOperation(content, op);
+      const nextVersion = version + 1;
+
+      const commit = this.db.transaction(() => {
+        this.db
+          .prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?")
+          .run(nextContent, docId);
+        this.db
+          .prepare(
+            'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+          )
+          .run(docId, nextVersion, nextContent, JSON.stringify(op));
+      });
+      commit();
+
+      if (state) {
+        state.version = nextVersion;
+        state.content = nextContent;
+        state.pending.push({ version: nextVersion, operation: op });
+        // Keep history bounded; transforms only need the tail.
+        if (state.pending.length > 1000) {
+          state.pending.splice(0, state.pending.length - 1000);
+        }
+      }
+
+      ws.send(JSON.stringify({ type: 'ack', version: nextVersion }));
+
+      const broadcast = JSON.stringify({
+        type: 'operation',
+        operation: op,
+        version: nextVersion,
+      });
+      for (const [client, clientId] of state?.clients ?? []) {
+        if (clientId !== connectionId && client.readyState === WebSocket.OPEN) {
+          client.send(broadcast);
+        }
+      }
+    } catch (error) {
+      this.sendError(ws, error instanceof Error ? error.message : 'Operation failed');
+    }
+  }
+
+  private sendError(ws: WebSocket, message: string): void {
+    if (ws.readyState === WebSocket.OPEN) {
+      ws.send(JSON.stringify({ type: 'error', message }));
+    }
+  }
+}
