', role: 'hacker' });\n    expect(invalid.valid).toBe(false);\n    expect(invalid.errors).toBeDefined();\n  });\n});\nimport { describe, it, expect } from 'vitest';\nimport {\n  validateCreateUser,\n  validateUserId,\n  userFiltersSchema,\n} from '../src/validation.js';\n\ndescribe('Validation', () => {\n  it('validates a correct user input', () => {\n    const result = validateCreateUser({\n      name: 'Alice',\n      email: 'alice@example.com',\n      role: 'admin',\n    });\n    expect(result.success).toBe(true);\n    expect(result.data).toEqual({\n      name: 'Alice',\n      email: 'alice@example.com',\n      role: 'admin',\n    });\n  });\n\n  it('rejects invalid email', () => {\n    const result = validateCreateUser({\n      name: 'Alice',\n      email: 'not-an-email',\n      role: 'admin',\n    });\n    expect(result.success).toBe(false);\n    expect(result.errors).toContain('Invalid email address');\n  });\n\n  it('uses z.pipe() to coerce string user ID to number', () => {\n    const result = validateUserId('42');\n    expect(result.success).toBe(true);\n    expect(result.data).toBe(42);\n  });\n\n  it('rejects non-numeric user ID via z.pipe()', () => {\n    const result = validateUserId('abc');\n    expect(result.success).toBe(false);\n  });\n\n  it('parses user filters with string-to-number coercion via z.pipe()', () => {\n    const result = userFiltersSchema.safeParse({\n      role: 'admin',\n      limit: '50',\n      offset: '10',\n    });\n    expect(result.success).toBe(true);\n    if (result.success) {\n      expect(result.data.limit).toBe(50);\n      expect(result.data.offset).toBe(10);\n    }\n  });\n});\nimport { describe, it, expect } from 'vitest';\nimport {\n  hasPermission,\n  getAllPermissions,\n  canManageUsers,\n  canWrite,\n  canDelete,\n  requirePermission,\n} from '../src/permissions.js';\n\ndescribe('Permissions', () => {\n  it('admin has all permissions', () => {\n    expect(hasPermission('admin', 'read')).toBe(true);\n    expect(hasPermission('admin', 'write')).toBe(true);\n    expect(hasPermission('admin', 'delete')).toBe(true);\n    expect(hasPermission('admin', 'manage_users')).toBe(true);\n    expect(hasPermission('admin', 'view_reports')).toBe(true);\n  });\n\n  it('viewer can only read', () => {\n    expect(hasPermission('viewer', 'read')).toBe(true);\n    expect(hasPermission('viewer', 'write')).toBe(false);\n    expect(hasPermission('viewer', 'delete')).toBe(false);\n  });\n\n  it('returns all permissions for a role', () => {\n    const perms = getAllPermissions('user');\n    expect(perms).toContain('read');\n    expect(perms).toContain('write');\n    expect(perms).not.toContain('delete');\n  });\n\n  it('canManageUsers is true only for admin', () => {\n    expect(canManageUsers('admin')).toBe(true);\n    expect(canManageUsers('user')).toBe(false);\n    expect(canManageUsers('viewer')).toBe(false);\n  });\n\n  it('canWrite is true for admin and user', () => {\n    expect(canWrite('admin')).toBe(true);\n    expect(canWrite('user')).toBe(true);\n    expect(canWrite('viewer')).toBe(false);\n  });\n\n  it('canDelete is true only for admin', () => {\n    expect(canDelete('admin')).toBe(true);\n    expect(canDelete('user')).toBe(false);\n  });\n\n  it('requirePermission throws when permission is missing', () => {\n    expect(() => requirePermission('viewer', 'write')).toThrow(\n      \"Role 'viewer' does not have permission 'write'\"\n    );\n  });\n});\n","exit_code":0,"status":"completed"}}
