@@ -0,0 +1,43 @@
+import type { NextFunction, Request, Response } from 'express';
+import jwt from 'jsonwebtoken';
+import { unauthorized } from '../errors';
+
+export const JWT_SECRET = process.env.JWT_SECRET || 'analytics-dashboard-secret';
+export const TOKEN_TTL_SECONDS = 60 * 60 * 24;
+
+export interface AuthUser {
+  id: string;
+  tenantId: string;
+}
+
+export function getAuthUser(req: Request): AuthUser | undefined {
+  return (req as unknown as Record<string, unknown>).user as AuthUser | undefined;
+}
+
+export function requireAuth(req: Request, _res: Response, next: NextFunction): void {
+  const header = req.headers.authorization;
+  if (!header || !header.startsWith('Bearer ')) {
+    next(unauthorized('Missing or malformed Authorization header'));
+    return;
+  }
+
+  const token = header.slice('Bearer '.length).trim();
+  if (!token) {
+    next(unauthorized('Missing token'));
+    return;
+  }
+
+  try {
+    const payload = jwt.verify(token, JWT_SECRET) as Record<string, unknown>;
+    const sub = payload.sub;
+    const tid = payload.tid;
+    if (typeof sub !== 'string' || typeof tid !== 'string') {
+      next(unauthorized('Invalid token payload'));
+      return;
+    }
+    (req as unknown as Record<string, unknown>).user = { id: sub, tenantId: tid };
+    next();
+  } catch {
+    next(unauthorized('Invalid or expired token'));
+  }
+}
