@@ -0,0 +1,21 @@
+import crypto from 'crypto';
+
+export function hashPassword(password: string): string {
+  const salt = crypto.randomBytes(16).toString('hex');
+  const hash = crypto.scryptSync(password, salt, 64).toString('hex');
+  return `${salt}:${hash}`;
+}
+
+export function verifyPassword(password: string, stored: string): boolean {
+  const parts = stored.split(':');
+  if (parts.length !== 2) {
+    return false;
+  }
+  const [salt, hash] = parts;
+  const candidate = crypto.scryptSync(password, salt, 64);
+  const expected = Buffer.from(hash, 'hex');
+  if (candidate.length !== expected.length) {
+    return false;
+  }
+  return crypto.timingSafeEqual(candidate, expected);
+}
diff --git a/src/query/router.ts b/src/query/router.ts
new file mode 100644
index 0000000..735e7c5
--- /dev/null
+++ b/src/query/router.ts
@@ -0,0 +1,260 @@
+import { Router } from 'express';
+import { getDb } from '../db';
+import { badRequest, unauthorized } from '../errors';
+import { getAuthUser } from '../auth/middleware';
+
+interface Filter {
+  key: string;
+  value: unknown;
+}
+
+interface BaseQuery {
+  event_name: string;
+  start?: string;
+  end?: string;
+  filters?: Filter[];
+}
+
+const BUCKET_FORMATS: Record<string, string> = {
+  hour: '%Y-%m-%dT%H:00:00Z',
+  day: '%Y-%m-%d',
+  week: '%Y-W%W',
+  month: '%Y-%m',
+};
+
+function parseBaseQuery(body: unknown, requireEventName = true): BaseQuery {
+  if (typeof body !== 'object' || body === null) {
+    throw badRequest('Request body must be an object');
+  }
+  const b = body as Record<string, unknown>;
+
+  let eventName = '';
+  if (b.event_name !== undefined) {
+    if (typeof b.event_name !== 'string' || b.event_name.trim() === '') {
+      throw badRequest('event_name must be a non-empty string');
+    }
+    eventName = b.event_name.trim();
+  } else if (requireEventName) {
+    throw badRequest('event_name is required');
+  }
+
+  const query: BaseQuery = { event_name: eventName };
+
+  if (b.start !== undefined) {
+    if (typeof b.start !== 'string') throw badRequest('start must be a string');
+    query.start = b.start;
+  }
+  if (b.end !== undefined) {
+    if (typeof b.end !== 'string') throw badRequest('end must be a string');
+    query.end = b.end;
+  }
+
+  if (b.filters !== undefined) {
+    if (!Array.isArray(b.filters)) throw badRequest('filters must be an array');
+    query.filters = b.filters.map((f) => {
+      if (typeof f !== 'object' || f === null || typeof (f as Record<string, unknown>).key !== 'string') {
+        throw badRequest('each filter must have a key');
+      }
+      const filter = f as Record<string, unknown>;
+      return { key: filter.key as string, value: filter.value };
+    });
+  }
+
+  return query;
+}
+
+function buildWhere(
+  tenantId: string,
+  query: BaseQuery
+): { clause: string; params: unknown[] } {
+  const conditions = ['tenant_id = ?'];
+  const params: unknown[] = [tenantId];
+
+  if (query.event_name) {
+    conditions.push('name = ?');
+    params.push(query.event_name);
+  }
+  if (query.start) {
+    conditions.push('timestamp >= ?');
+    params.push(query.start);
+  }
+  if (query.end) {
+    conditions.push('timestamp <= ?');
+    params.push(query.end);
+  }
+  if (query.filters) {
+    for (const filter of query.filters) {
+      conditions.push("json_extract(properties, '$.' || ?) = ?");
+      params.push(filter.key, filter.value);
+    }
+  }
+
+  return { clause: conditions.join(' AND '), params };
+}
+
+const router = Router();
+
+router.post('/count', (req, res, next) => {
+  try {
+    const authUser = getAuthUser(req);
+    if (!authUser) throw unauthorized('Authentication required');
+
+    const query = parseBaseQuery(req.body);
+    const { clause, params } = buildWhere(authUser.tenantId, query);
+    const db = getDb();
+    const row = db.prepare(`SELECT COUNT(*) AS count FROM events WHERE ${clause}`).get(...params) as {
+      count: number;
+    };
+    res.status(200).json({ count: row.count });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/timeseries', (req, res, next) => {
+  try {
+    const authUser = getAuthUser(req);
+    if (!authUser) throw unauthorized('Authentication required');
+
+    const body = req.body as Record<string, unknown>;
+    const bucket = typeof body?.bucket === 'string' && body.bucket in BUCKET_FORMATS ? body.bucket : 'day';
+    if (body?.bucket !== undefined && !(typeof body.bucket === 'string' && body.bucket in BUCKET_FORMATS)) {
+      throw badRequest('bucket must be one of: hour, day, week, month');
+    }
+
+    const query = parseBaseQuery(req.body);
+    const { clause, params } = buildWhere(authUser.tenantId, query);
+    const format = BUCKET_FORMATS[bucket];
+
+    const db = getDb();
+    const rows = db
+      .prepare(
+        `SELECT strftime('${format}', timestamp) AS bucket, COUNT(*) AS count
+         FROM events WHERE ${clause}
+         GROUP BY bucket ORDER BY bucket ASC`
+      )
+      .all(...params) as Array<{ bucket: string; count: number }>;
+
+    res.status(200).json({ data: rows });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/breakdown', (req, res, next) => {
+  try {
+    const authUser = getAuthUser(req);
+    if (!authUser) throw unauthorized('Authentication required');
+
+    const body = req.body as Record<string, unknown>;
+    if (typeof body?.property_key !== 'string' || body.property_key.trim() === '') {
+      throw badRequest('property_key is required');
+    }
+    const propertyKey = body.property_key.trim();
+
+    const query = parseBaseQuery(req.body);
+    const { clause, params } = buildWhere(authUser.tenantId, query);
+
+    const db = getDb();
+    const rows = db
+      .prepare(
+        `SELECT json_extract(properties, '$.' || ?) AS property_value, COUNT(*) AS count
+         FROM events WHERE ${clause}
+         GROUP BY property_value ORDER BY count DESC`
+      )
+      .all(propertyKey, ...params) as Array<{ property_value: unknown; count: number }>;
+
+    const data = rows
+      .filter((r) => r.property_value !== null && r.property_value !== undefined)
+      .map((r) => ({
+        property_value:
+          typeof r.property_value === 'object' ? JSON.stringify(r.property_value) : r.property_value,
+        count: r.count,
+      }));
+
+    res.status(200).json({ data });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/funnel', (req, res, next) => {
+  try {
+    const authUser = getAuthUser(req);
+    if (!authUser) throw unauthorized('Authentication required');
+
+    const body = req.body as Record<string, unknown>;
+    if (!Array.isArray(body?.steps) || body.steps.length === 0) {
+      throw badRequest('steps must be a non-empty array of event names');
+    }
+    const steps: string[] = body.steps.map((s: unknown) => {
+      if (typeof s !== 'string' || s.trim() === '') {
+        throw badRequest('each step must be a non-empty string');
+      }
+      return s.trim();
+    });
+
+    const query = parseBaseQuery(req.body, false);
+    const db = getDb();
+
+    const conditions = ['tenant_id = ?'];
+    const params: unknown[] = [authUser.tenantId];
+    if (query.start) {
+      conditions.push('timestamp >= ?');
+      params.push(query.start);
+    }
+    if (query.end) {
+      conditions.push('timestamp <= ?');
+      params.push(query.end);
+    }
+
+    const rows = db
+      .prepare(
+        `SELECT name, session_id, MIN(timestamp) AS first_at
+         FROM events WHERE ${conditions.join(' AND ')} AND session_id IS NOT NULL AND name IN (${steps
+           .map(() => '?')
+           .join(', ')})
+         GROUP BY name, session_id`
+      )
+      .all(...params, ...steps) as Array<{ name: string; session_id: string; first_at: string }>;
+
+    const sessionSteps = new Map<string, Map<string, string>>();
+    for (const row of rows) {
+      let stepMap = sessionSteps.get(row.session_id);
+      if (!stepMap) {
+        stepMap = new Map();
+        sessionSteps.set(row.session_id, stepMap);
+      }
+      const existing = stepMap.get(row.name);
+      if (!existing || row.first_at < existing) {
+        stepMap.set(row.name, row.first_at);
+      }
+    }
+
+    const stepResults = steps.map((name, index) => ({ step: index + 1, name, count: 0 }));
+
+    for (const stepMap of sessionSteps.values()) {
+      let lastTime: string | null = null;
+      for (let i = 0; i < steps.length; i++) {
+        const time = stepMap.get(steps[i]);
+        if (time === undefined || (lastTime !== null && time < lastTime)) {
+          break;
+        }
+        stepResults[i].count += 1;
+        lastTime = time;
+      }
+    }
+
+    const base = stepResults[0].count;
+    const stepsOut = stepResults.map((s) => ({
+      ...s,
+      conversion: base > 0 ? s.count / base : 0,
+    }));
+
+    res.status(200).json({ steps: stepsOut });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
