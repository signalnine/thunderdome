+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { badRequest, unauthorized } from '../errors';
+import { getAuthUser } from '../auth/middleware';
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+function serializeEvent(row: EventRow) {
+  let properties: unknown = {};
+  try {
+    properties = JSON.parse(row.properties);
+  } catch {
+    properties = {};
+  }
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties,
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+function nowIso(): string {
+  return new Date().toISOString();
+}
+
+interface EventInput {
+  name: string;
+  properties: Record<string, unknown>;
+  timestamp: string;
+  session_id?: string;
+}
+
+function parseEventInput(raw: unknown): EventInput {
+  if (typeof raw !== 'object' || raw === null) {
+    throw badRequest('Event must be an object');
+  }
+  const body = raw as Record<string, unknown>;
+
+  if (typeof body.name !== 'string' || body.name.trim() === '') {
+    throw badRequest('Event name is required');
+  }
+
+  let properties: Record<string, unknown> = {};
+  if (body.properties !== undefined) {
+    if (typeof body.properties !== 'object' || body.properties === null || Array.isArray(body.properties)) {
+      throw badRequest('properties must be an object');
+    }
+    properties = body.properties as Record<string, unknown>;
+  }
+
+  let timestamp = nowIso();
+  if (body.timestamp !== undefined) {
+    if (typeof body.timestamp !== 'string' || body.timestamp.trim() === '') {
+      throw badRequest('timestamp must be a string');
+    }
+    timestamp = body.timestamp;
+  }
+
+  let sessionId: string | undefined;
+  if (body.session_id !== undefined) {
+    if (typeof body.session_id !== 'string') {
+      throw badRequest('session_id must be a string');
+    }
+    sessionId = body.session_id;
+  }
+
+  return { name: body.name.trim(), properties, timestamp, session_id: sessionId };
+}
+
+function insertEvent(input: EventInput, tenantId: string, userId: string): EventRow {
+  const db = getDb();
+  const id = uuidv4();
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  ).run(
+    id,
+    tenantId,
+    input.name,
+    JSON.stringify(input.properties),
+    input.timestamp,
+    userId,
+    input.session_id ?? null
+  );
+  return db.prepare('SELECT * FROM events WHERE id = ?').get(id) as EventRow;
+}
+
+const router = Router();
+
+router.post('/', (req, res, next) => {
+  try {
+    const authUser = getAuthUser(req);
+    if (!authUser) {
+      throw unauthorized('Authentication required');
+    }
+
+    const input = parseEventInput(req.body);
+    const row = insertEvent(input, authUser.tenantId, authUser.id);
+    res.status(201).json(serializeEvent(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/batch', (req, res, next) => {
+  try {
+    const authUser = getAuthUser(req);
+    if (!authUser) {
+      throw unauthorized('Authentication required');
+    }
+
+    const events = req.body?.events;
+    if (!Array.isArray(events) || events.length === 0) {
+      throw badRequest('events must be a non-empty array');
+    }
+    if (events.length > 1000) {
+      throw badRequest('batch size exceeds limit of 1000 events');
+    }
+
+    const inputs = events.map((e) => parseEventInput(e));
+    const db = getDb();
+    const rows: EventRow[] = [];
+    const insertMany = db.transaction(() => {
+      for (const input of inputs) {
+        rows.push(insertEvent(input, authUser.tenantId, authUser.id));
+      }
+    });
+    insertMany();
+
+    res.status(201).json({
+      inserted: rows.length,
+      events: rows.map(serializeEvent),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
