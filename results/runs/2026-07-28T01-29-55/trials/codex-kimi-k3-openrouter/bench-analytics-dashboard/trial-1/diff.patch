   .send({ email: 'dup@example.com', password: 'pass123', tenant_id: 't1' });\n\n    const res = await request(app)\n      .post('/users')\n      .send({ email: 'dup@example.com', password: 'pass456', tenant_id: 't1' });\n\n    expect(res.status).toBe(409);\n  });\n\n  it('should login with correct credentials', async () => {\n    const app = createPublicApp();\n    await request(app)\n      .post('/users')\n      .send({ email: 'login@example.com', password: 'pass123', tenant_id: 't1' });\n\n    const res = await request(app)\n      .post('/users/login')\n      .send({ email: 'login@example.com', password: 'pass123' });\n\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveProperty('token');\n    expect(res.body.user.email).toBe('login@example.com');\n  });\n\n  it('should reject login with wrong password', async () => {\n    const app = createPublicApp();\n    await request(app)\n      .post('/users')\n      .send({ email: 'wrong@example.com', password: 'pass123', tenant_id: 't1' });\n\n    const res = await request(app)\n      .post('/users/login')\n      .send({ email: 'wrong@example.com', password: 'wrongpass' });\n\n    expect(res.status).toBe(401);\n  });\n\n  it('should get user profile with mock auth', async () => {\n    const publicApp = createPublicApp();\n    const regRes = await request(publicApp)\n      .post('/users')\n      .send({ email: 'me@example.com', password: 'pass123', tenant_id: 't1' });\n\n    const userId = regRes.body.id;\n    const authedApp = createAuthedApp(userId, 't1');\n\n    const res = await request(authedApp).get('/users/me');\n\n    expect(res.status).toBe(200);\n    expect(res.body.email).toBe('me@example.com');\n  });\n\n  it('should allow admin to change user role', async () => {\n    const publicApp = createPublicApp();\n    // Create admin user\n    const adminRes = await request(publicApp)\n      .post('/users')\n      .send({ email: 'admin@example.com', password: 'pass123', tenant_id: 't1' });\n    const adminId = adminRes.body.id;\n    db.prepare('UPDATE users SET role = ? WHERE id = ?').run('admin', adminId);\n\n    // Create target user\n    const targetRes = await request(publicApp)\n      .post('/users')\n      .send({ email: 'target@example.com', password: 'pass123', tenant_id: 't1' });\n    const targetId = targetRes.body.id;\n\n    // Use admin mock auth\n    const adminApp = createAuthedApp(adminId, 't1');\n    const res = await request(adminApp)\n      .patch(`/users/${targetId}/role`)\n      .send({ role: 'editor' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.role).toBe('editor');\n  });\n});\n","exit_code":0,"status":"completed"}}
