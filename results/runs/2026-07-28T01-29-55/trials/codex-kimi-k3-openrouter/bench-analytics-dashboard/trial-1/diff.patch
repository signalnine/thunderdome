@@ -0,0 +1,289 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { badRequest, notFound, unauthorized } from '../errors';
+import { getAuthUser } from '../auth/middleware';
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+const WIDGET_TYPES = new Set(['counter', 'timeseries', 'breakdown', 'funnel']);
+
+function parseJsonConfig(raw: string): unknown {
+  try {
+    return JSON.parse(raw);
+  } catch {
+    return {};
+  }
+}
+
+function serializeDashboard(row: DashboardRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    owner_id: row.owner_id,
+    config: parseJsonConfig(row.config),
+    created_at: row.created_at,
+    updated_at: row.updated_at,
+  };
+}
+
+function serializeWidget(row: WidgetRow) {
+  return {
+    id: row.id,
+    dashboard_id: row.dashboard_id,
+    type: row.type,
+    config: parseJsonConfig(row.config),
+    position_x: row.position_x,
+    position_y: row.position_y,
+    width: row.width,
+    height: row.height,
+  };
+}
+
+function parseConfig(raw: unknown): Record<string, unknown> {
+  if (raw === undefined) return {};
+  if (typeof raw !== 'object' || raw === null || Array.isArray(raw)) {
+    throw badRequest('config must be an object');
+  }
+  return raw as Record<string, unknown>;
+}
+
+function requireUser(req: Parameters<typeof getAuthUser>[0]) {
+  const user = getAuthUser(req);
+  if (!user) throw unauthorized('Authentication required');
+  return user;
+}
+
+const router = Router();
+
+router.post('/', (req, res, next) => {
+  try {
+    const user = requireUser(req);
+    const { name } = req.body ?? {};
+    if (typeof name !== 'string' || name.trim() === '') {
+      throw badRequest('name is required');
+    }
+    const config = parseConfig(req.body?.config);
+
+    const db = getDb();
+    const id = uuidv4();
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, user.tenantId, name.trim(), user.id, JSON.stringify(config));
+
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+    res.status(201).json(serializeDashboard(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/', (req, res, next) => {
+  try {
+    const user = requireUser(req);
+    const db = getDb();
+    const rows = db
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at ASC')
+      .all(user.tenantId) as DashboardRow[];
+    res.status(200).json(rows.map(serializeDashboard));
+  } catch (err) {
+    next(err);
+  }
+});
+
+function loadDashboard(id: string, tenantId: string): DashboardRow {
+  const db = getDb();
+  const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow | undefined;
+  if (!row || row.tenant_id !== tenantId) {
+    throw notFound('Dashboard not found');
+  }
+  return row;
+}
+
+router.get('/:id', (req, res, next) => {
+  try {
+    const user = requireUser(req);
+    const row = loadDashboard(req.params.id, user.tenantId);
+    const db = getDb();
+    const widgets = db
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y ASC, position_x ASC')
+      .all(row.id) as WidgetRow[];
+    res.status(200).json({ ...serializeDashboard(row), widgets: widgets.map(serializeWidget) });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.patch('/:id', (req, res, next) => {
+  try {
+    const user = requireUser(req);
+    const row = loadDashboard(req.params.id, user.tenantId);
+
+    const updates: string[] = [];
+    const params: unknown[] = [];
+
+    if (req.body?.name !== undefined) {
+      if (typeof req.body.name !== 'string' || req.body.name.trim() === '') {
+        throw badRequest('name must be a non-empty string');
+      }
+      updates.push('name = ?');
+      params.push(req.body.name.trim());
+    }
+    if (req.body?.config !== undefined) {
+      const config = parseConfig(req.body.config);
+      updates.push('config = ?');
+      params.push(JSON.stringify(config));
+    }
+
+    if (updates.length === 0) {
+      throw badRequest('No fields to update');
+    }
+
+    updates.push("updated_at = datetime('now')");
+    const db = getDb();
+    db.prepare(`UPDATE dashboards SET ${updates.join(', ')} WHERE id = ?`).run(...params, row.id);
+
+    const updated = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(row.id) as DashboardRow;
+    res.status(200).json(serializeDashboard(updated));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.delete('/:id', (req, res, next) => {
+  try {
+    const user = requireUser(req);
+    const row = loadDashboard(req.params.id, user.tenantId);
+    const db = getDb();
+    db.prepare('DELETE FROM widgets WHERE dashboard_id = ?').run(row.id);
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(row.id);
+    res.status(204).send();
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/:id/widgets', (req, res, next) => {
+  try {
+    const user = requireUser(req);
+    const dashboard = loadDashboard(req.params.id, user.tenantId);
+
+    const { type } = req.body ?? {};
+    if (typeof type !== 'string' || !WIDGET_TYPES.has(type)) {
+      throw badRequest('type must be one of: counter, timeseries, breakdown, funnel');
+    }
+    const config = parseConfig(req.body?.config);
+
+    const numField = (value: unknown, fallback: number, fieldName: string): number => {
+      if (value === undefined) return fallback;
+      if (typeof value !== 'number' || !Number.isFinite(value)) {
+        throw badRequest(`${fieldName} must be a number`);
+      }
+      return value;
+    };
+
+    const positionX = numField(req.body?.position_x, 0, 'position_x');
+    const positionY = numField(req.body?.position_y, 0, 'position_y');
+    const width = numField(req.body?.width, 1, 'width');
+    const height = numField(req.body?.height, 1, 'height');
+
+    const db = getDb();
+    const id = uuidv4();
+    db.prepare(
+      'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+    ).run(id, dashboard.id, type, JSON.stringify(config), positionX, positionY, width, height);
+
+    const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as WidgetRow;
+    res.status(201).json(serializeWidget(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.patch('/:id/widgets/:widgetId', (req, res, next) => {
+  try {
+    const user = requireUser(req);
+    const dashboard = loadDashboard(req.params.id, user.tenantId);
+    const db = getDb();
+    const widget = db
+      .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')
+      .get(req.params.widgetId, dashboard.id) as WidgetRow | undefined;
+    if (!widget) {
+      throw notFound('Widget not found');
+    }
+
+    const updates: string[] = [];
+    const params: unknown[] = [];
+
+    if (req.body?.type !== undefined) {
+      if (typeof req.body.type !== 'string' || !WIDGET_TYPES.has(req.body.type)) {
+        throw badRequest('type must be one of: counter, timeseries, breakdown, funnel');
+      }
+      updates.push('type = ?');
+      params.push(req.body.type);
+    }
+    if (req.body?.config !== undefined) {
+      updates.push('config = ?');
+      params.push(JSON.stringify(parseConfig(req.body.config)));
+    }
+    for (const field of ['position_x', 'position_y', 'width', 'height'] as const) {
+      if (req.body?.[field] !== undefined) {
+        if (typeof req.body[field] !== 'number' || !Number.isFinite(req.body[field])) {
+          throw badRequest(`${field} must be a number`);
+        }
+        updates.push(`${field} = ?`);
+        params.push(req.body[field]);
+      }
+    }
+
+    if (updates.length === 0) {
+      throw badRequest('No fields to update');
+    }
+
+    db.prepare(`UPDATE widgets SET ${updates.join(', ')} WHERE id = ?`).run(...params, widget.id);
+    const updated = db.prepare('SELECT * FROM widgets WHERE id = ?').get(widget.id) as WidgetRow;
+    res.status(200).json(serializeWidget(updated));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.delete('/:id/widgets/:widgetId', (req, res, next) => {
+  try {
+    const user = requireUser(req);
+    const dashboard = loadDashboard(req.params.id, user.tenantId);
+    const db = getDb();
+    const widget = db
+      .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')
+      .get(req.params.widgetId, dashboard.id) as WidgetRow | undefined;
+    if (!widget) {
+      throw notFound('Widget not found');
+    }
+    db.prepare('DELETE FROM widgets WHERE id = ?').run(widget.id);
+    res.status(204).send();
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
