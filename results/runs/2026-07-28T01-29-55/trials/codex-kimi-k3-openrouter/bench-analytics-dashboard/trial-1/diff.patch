+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+function parseJson(raw: string): unknown {
+  try {
+    return JSON.parse(raw);
+  } catch {
+    return {};
+  }
+}
+
+function serializeEvent(row: EventRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: parseJson(row.properties),
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+function csvEscape(value: unknown): string {
+  if (value === null || value === undefined) return '';
+  const str = String(value);
+  if (/[",\n\r]/.test(str)) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+const router = Router();
+
+router.get('/events', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    if (!user) throw unauthorized('Authentication required');
+
+    const format = typeof req.query.format === 'string' ? req.query.format : 'json';
+    if (format !== 'json' && format !== 'csv') {
+      throw badRequest('format must be csv or json');
+    }
+
+    const db = getDb();
+    const conditions = ['tenant_id = ?'];
+    const params: unknown[] = [user.tenantId];
+
+    if (typeof req.query.name === 'string' && req.query.name !== '') {
+      conditions.push('name = ?');
+      params.push(req.query.name);
+    }
+    if (typeof req.query.start === 'string' && req.query.start !== '') {
+      conditions.push('timestamp >= ?');
+      params.push(req.query.start);
+    }
+    if (typeof req.query.end === 'string' && req.query.end !== '') {
+      conditions.push('timestamp <= ?');
+      params.push(req.query.end);
+    }
+
+    const rows = db
+      .prepare(`SELECT * FROM events WHERE ${conditions.join(' AND ')} ORDER BY timestamp ASC`)
+      .all(...params) as EventRow[];
+
+    if (format === 'json') {
+      res.status(200).json(rows.map(serializeEvent));
+      return;
+    }
+
+    const header = 'id,tenant_id,name,properties,timestamp,user_id,session_id';
+    const lines = rows.map((row) =>
+      [
+        csvEscape(row.id),
+        csvEscape(row.tenant_id),
+        csvEscape(row.name),
+        csvEscape(row.properties),
+        csvEscape(row.timestamp),
+        csvEscape(row.user_id),
+        csvEscape(row.session_id),
+      ].join(',')
+    );
+
+    res.setHeader('Content-Type', 'text/csv');
+    res.setHeader('Content-Disposition', 'attachment; filename="events.csv"');
+    res.status(200).send([header, ...lines].join('\n'));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/dashboard/:id', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    if (!user) throw unauthorized('Authentication required');
+
+    const db = getDb();
+    const dashboard = db
+      .prepare('SELECT * FROM dashboards WHERE id = ?')
+      .get(req.params.id) as DashboardRow | undefined;
+
+    if (!dashboard || dashboard.tenant_id !== user.tenantId) {
+      throw notFound('Dashboard not found');
+    }
+
+    const widgets = db
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y ASC, position_x ASC')
+      .all(dashboard.id) as WidgetRow[];
+
+    res.status(200).json({
+      dashboard: {
+        id: dashboard.id,
+        tenant_id: dashboard.tenant_id,
+        name: dashboard.name,
+        owner_id: dashboard.owner_id,
+        config: parseJson(dashboard.config),
+        created_at: dashboard.created_at,
+        updated_at: dashboard.updated_at,
+      },
+      widgets: widgets.map((w) => ({
+        id: w.id,
+        dashboard_id: w.dashboard_id,
+        type: w.type,
+        config: parseJson(w.config),
+        position_x: w.position_x,
+        position_y: w.position_y,
+        width: w.width,
+        height: w.height,
+      })),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
