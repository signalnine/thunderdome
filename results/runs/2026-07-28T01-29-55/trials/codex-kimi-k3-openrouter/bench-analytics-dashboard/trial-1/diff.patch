e;\n\n  beforeEach(() => {\n    db = createTestDb();\n    setDb(db);\n    seedEvents(db, 'tenant1');\n  });\n\n  afterEach(() => {\n    closeDb();\n  });\n\n  it('should count events by name', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app)\n      .post('/query/count')\n      .send({ event_name: 'page_view' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.count).toBe(3);\n  });\n\n  it('should count events with time range', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app)\n      .post('/query/count')\n      .send({\n        event_name: 'page_view',\n        start: '2024-01-15T00:00:00Z',\n        end: '2024-01-15T23:59:59Z',\n      });\n\n    expect(res.status).toBe(200);\n    expect(res.body.count).toBe(2);\n  });\n\n  it('should return timeseries data', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app)\n      .post('/query/timeseries')\n      .send({ event_name: 'page_view', bucket: 'day' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.data).toBeInstanceOf(Array);\n    expect(res.body.data.length).toBeGreaterThanOrEqual(1);\n    expect(res.body.data[0]).toHaveProperty('bucket');\n    expect(res.body.data[0]).toHaveProperty('count');\n  });\n\n  it('should return breakdown data', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app)\n      .post('/query/breakdown')\n      .send({ event_name: 'page_view', property_key: 'page' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.data).toBeInstanceOf(Array);\n    expect(res.body.data.length).toBeGreaterThanOrEqual(1);\n    // /home appears twice, /about once\n    const homeEntry = res.body.data.find(\n      (d: { property_value: string; count: number }) => d.property_value === '/home'\n    );\n    expect(homeEntry).toBeDefined();\n    expect(homeEntry.count).toBe(2);\n  });\n\n  it('should return funnel data', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app)\n      .post('/query/funnel')\n      .send({ steps: ['page_view', 'click', 'signup'] });\n\n    expect(res.status).toBe(200);\n    expect(res.body.steps).toHaveLength(3);\n    // First step should have more or equal users than subsequent steps\n    expect(res.body.steps[0].count).toBeGreaterThanOrEqual(\n      res.body.steps[1].count\n    );\n  });\n\n  it('should reject query without event_name', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app).post('/query/count').send({});\n\n    expect(res.status).toBe(400);\n  });\n});\n","exit_code":0,"status":"completed"}}
