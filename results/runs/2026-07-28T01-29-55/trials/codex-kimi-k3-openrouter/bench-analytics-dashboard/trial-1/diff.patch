+++ b/src/users/router.ts
@@ -0,0 +1,142 @@
+import { Router } from 'express';
+import jwt from 'jsonwebtoken';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { badRequest, conflict, forbidden, notFound, unauthorized } from '../errors';
+import { getAuthUser, JWT_SECRET, TOKEN_TTL_SECONDS } from '../auth/middleware';
+import { hashPassword, verifyPassword } from '../passwords';
+
+interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: string;
+  created_at: string;
+}
+
+function publicUser(row: UserRow) {
+  return {
+    id: row.id,
+    email: row.email,
+    tenant_id: row.tenant_id,
+    role: row.role,
+    created_at: row.created_at,
+  };
+}
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const VALID_ROLES = new Set(['admin', 'viewer', 'editor']);
+
+const router = Router();
+
+router.post('/', (req, res, next) => {
+  try {
+    const { email, password, tenant_id } = req.body ?? {};
+
+    if (typeof email !== 'string' || !EMAIL_RE.test(email)) {
+      throw badRequest('A valid email is required');
+    }
+    if (typeof password !== 'string' || password.length === 0) {
+      throw badRequest('password is required');
+    }
+    if (typeof tenant_id !== 'string' || tenant_id.trim() === '') {
+      throw badRequest('tenant_id is required');
+    }
+
+    const db = getDb();
+    const normalizedEmail = email.trim().toLowerCase();
+    const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(normalizedEmail);
+    if (existing) {
+      throw conflict('Email already registered');
+    }
+
+    const id = uuidv4();
+    const passwordHash = hashPassword(password);
+    db.prepare(
+      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, normalizedEmail, passwordHash, tenant_id, 'viewer');
+
+    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow;
+    res.status(201).json(publicUser(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/login', (req, res, next) => {
+  try {
+    const { email, password } = req.body ?? {};
+    if (typeof email !== 'string' || typeof password !== 'string') {
+      throw badRequest('email and password are required');
+    }
+
+    const db = getDb();
+    const row = db
+      .prepare('SELECT * FROM users WHERE email = ?')
+      .get(email.trim().toLowerCase()) as UserRow | undefined;
+
+    if (!row || !verifyPassword(password, row.password_hash)) {
+      throw unauthorized('Invalid email or password');
+    }
+
+    const token = jwt.sign({ sub: row.id, tid: row.tenant_id }, JWT_SECRET, {
+      expiresIn: TOKEN_TTL_SECONDS,
+    });
+
+    res.status(200).json({ token, user: publicUser(row) });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/me', (req, res, next) => {
+  try {
+    const authUser = getAuthUser(req);
+    if (!authUser) {
+      throw unauthorized('Authentication required');
+    }
+
+    const db = getDb();
+    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(authUser.id) as UserRow | undefined;
+    if (!row) {
+      throw notFound('User not found');
+    }
