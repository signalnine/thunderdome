+{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'cat /workspace/src/services/billing.ts /workspace/src/services/reporting.ts'","aggregated_output":"import type Database from 'better-sqlite3';\nimport type { InvoiceCreateInput, Invoice, LineItem } from '../models/invoice.js';\nimport { createInvoice } from '../db/queries.js';\n\n/**\n * Calculate the total for an invoice given subtotal, discount rate, and tax rate.\n *\n * Formula: subtotal * (1 - discountRate) * (1 + taxRate)\n *   - First apply the discount to get the discounted subtotal\n *   - Then apply tax on the discounted amount\n */\nexport function calculateInvoiceTotal(\n  subtotal: number,\n  discountRate: number,\n  taxRate: number,\n): number {\n  const discounted = subtotal * (1 - discountRate);\n  const total = discounted + subtotal * taxRate;\n  return Math.round(total * 100) / 100;\n}\n\n/**\n * Apply a discount to a subtotal.\n */\nexport function applyDiscount(subtotal: number, discountRate: number): number {\n  return Math.round(subtotal * (1 - discountRate) * 100) / 100;\n}\n\n/**\n * Calculate subtotal from line items.\n */\nexport function calculateSubtotal(lineItems: LineItem[]): number {\n  return lineItems.reduce((sum, item) => sum + item.quantity * item.unit_price, 0);\n}\n\n/**\n * Generate an invoice from input data, calculating subtotal and total.\n */\nexport function generateInvoice(\n  db: Database.Database,\n  input: InvoiceCreateInput,\n): number {\n  const subtotal = calculateSubtotal(input.line_items);\n  const total = calculateInvoiceTotal(subtotal, input.discount_rate, input.tax_rate);\n\n  const invoice: Invoice & { line_items: LineItem[] } = {\n    customer_id: input.customer_id,\n    date: input.date,\n    subtotal,\n    discount_rate: input.discount_rate,\n    tax_rate: input.tax_rate,\n    total,\n    status: input.status || 'draft',\n    line_items: input.line_items,\n  };\n\n  return createInvoice(db, invoice);\n}\nimport type Database from 'better-sqlite3';\nimport type { Invoice, InvoiceSummary, CustomerReport } from '../models/invoice.js';\n\n/**\n * Generate a monthly revenue report for a given year.\n * Groups invoices by their UTC month and aggregates totals.\n */\nexport function getMonthlyReport(\n  db: Database.Database,\n  year: number,\n): InvoiceSummary[] {\n  const startDate = `${year}-01-01`;\n  const endDate = `${year}-12-31`;\n\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE date >= ? AND date <= ?\n    ORDER BY date ASC\n  `);\n\n  const invoices = stmt.all(startDate, endDate) as Invoice[];\n\n  // Group invoices by month\n  const monthlyMap = new Map<number, { count: number; total: number }>();\n\n  for (const inv of invoices) {\n    const d = new Date(inv.date + 'T00:00:00Z');\n    const month = d.getMonth() + 1; // 1-indexed\n\n    const current = monthlyMap.get(month) || { count: 0, total: 0 };\n    current.count += 1;\n    current.total += inv.total;\n    monthlyMap.set(month, current);\n  }\n\n  // Convert to array of summaries\n  const summaries: InvoiceSummary[] = [];\n  for (const [month, data] of monthlyMap) {\n    summaries.push({\n      month,\n      year,\n      count: data.count,\n      total_revenue: Math.round(data.total * 100) / 100,\n    });\n  }\n\n  return summaries.sort((a, b) => a.month - b.month);\n}\n\n/**\n * Generate a report for a specific customer.\n */\nexport function getCustomerReport(\n  db: Database.Database,\n  customerId: string,\n): CustomerReport {\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE customer_id = ?\n  `);\n\n  const invoices = stmt.all(customerId) as Invoice[];\n\n  const totalSpent = invoices.reduce((sum, inv) => sum + inv.total, 0);\n\n  return {\n    customer_id: customerId,\n    invoice_count: invoices.length,\n    total_spent: Math.round(totalSpent * 100) / 100,\n    average_invoice: invoices.length > 0\n      ? Math.round((totalSpent / invoices.length) * 100) / 100\n      : 0,\n  };\n}\n\n/**\n * Get total revenue for a date period.\n */\nexport function getRevenueByPeriod(\n  db: Database.Database,\n  start: string,\n  end: string,\n): { total: number; count: number } {\n  const stmt = db.prepare(`\n    SELECT COALESCE(SUM(total), 0) as total, COUNT(*) as count\n    FROM invoices\n    WHERE date >= ? AND date <= ?\n  `);\n\n  const result = stmt.get(start, end) as { total: number; count: number };\n  return {\n    total: Math.round(result.total * 100) / 100,\n    count: result.count,\n  };\n}\n","exit_code":0,"status":"completed"}}
