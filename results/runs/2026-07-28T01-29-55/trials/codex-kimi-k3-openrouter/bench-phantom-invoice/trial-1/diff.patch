nth, 0)); // last day of the month\n  return {\n    start: formatDate(start),\n    end: formatDate(end),\n  };\n}\n\n/**\n * Check if a date string falls within a range (inclusive).\n */\nexport function isDateInRange(date: string, start: string, end: string): boolean {\n  return date >= start && date <= end;\n}\nexport interface LineItem {\n  id?: number;\n  invoice_id?: number;\n  description: string;\n  quantity: number;\n  unit_price: number;\n}\n\nexport interface Invoice {\n  id?: number;\n  customer_id: string;\n  date: string; // ISO date string YYYY-MM-DD\n  subtotal: number;\n  discount_rate: number; // 0.0 to 1.0\n  tax_rate: number; // 0.0 to 1.0\n  total: number;\n  status: 'draft' | 'sent' | 'paid' | 'cancelled';\n  line_items?: LineItem[];\n}\n\nexport interface InvoiceCreateInput {\n  customer_id: string;\n  date: string;\n  discount_rate: number;\n  tax_rate: number;\n  status?: 'draft' | 'sent' | 'paid' | 'cancelled';\n  line_items: LineItem[];\n}\n\nexport interface InvoiceSummary {\n  month: number;\n  year: number;\n  count: number;\n  total_revenue: number;\n}\n\nexport interface CustomerReport {\n  customer_id: string;\n  invoice_count: number;\n  total_spent: number;\n  average_invoice: number;\n}\nimport Database from 'better-sqlite3';\n\nexport function createDatabase(filename: string = ':memory:'): Database.Database {\n  const db = new Database(filename);\n\n  db.pragma('journal_mode = WAL');\n\n  db.exec(`\n    CREATE TABLE IF NOT EXISTS invoices (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      customer_id TEXT NOT NULL,\n      date TEXT NOT NULL,\n      subtotal REAL NOT NULL,\n      discount_rate REAL NOT NULL DEFAULT 0,\n      tax_rate REAL NOT NULL DEFAULT 0,\n      total REAL NOT NULL,\n      status TEXT NOT NULL DEFAULT 'draft'\n    );\n\n    CREATE TABLE IF NOT EXISTS line_items (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      invoice_id INTEGER NOT NULL,\n      description TEXT NOT NULL,\n      quantity INTEGER NOT NULL,\n      unit_price REAL NOT NULL,\n      FOREIGN KEY (invoice_id) REFERENCES invoices(id)\n    );\n  `);\n\n  return db;\n}\n","exit_code":0,"status":"completed"}}
