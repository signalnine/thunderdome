+const DIRS = [
+  [1, -1],
+  [1, 0],
+  [1, 1],
+] as const;
+
+const DIR_DL = 0;
+const DIR_DOWN = 1;
+const DIR_DR = 2;
+
+function parseGrid(grid: string[][]): {
+  rows: number;
+  cols: number;
+  splitter: Uint8Array;
+  sources: number[];
+} {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  const splitter = new Uint8Array(rows * cols);
+  const sources: number[] = [];
+  for (let r = 0; r < rows; r++) {
+    const row = grid[r];
+    for (let c = 0; c < cols; c++) {
+      const ch = row[c];
+      if (ch === '^') {
+        splitter[r * cols + c] = 1;
+      } else if (ch === 'S') {
+        sources.push(r * cols + c);
+      }
+    }
+  }
+  return { rows, cols, splitter, sources };
+}
+
+export function countBeamCells(grid: string[][]): number {
+  const { rows, cols, splitter, sources } = parseGrid(grid);
+  if (rows === 0 || cols === 0) return 0;
+
+  const visitedCells = new Uint8Array(rows * cols);
+  const visitedStates = new Uint8Array(rows * cols * 3);
+  const stack: number[] = [];
+  let count = 0;
+
+  for (const src of sources) {
+    if (!visitedCells[src]) {
+      visitedCells[src] = 1;
+      count++;
+    }
+    stack.push(src * 3 + DIR_DOWN);
+  }
+
+  while (stack.length > 0) {
+    const state = stack.pop()!;
+    if (visitedStates[state]) continue;
+    visitedStates[state] = 1;
+
+    const cell = (state / 3) | 0;
+    const dir = state % 3;
+    const r = (cell / cols) | 0;
+    const c = cell % cols;
+    const nr = r + 1;
+
+    if (splitter[cell]) {
+      if (nr >= rows) continue;
+      for (const nc of [c - 1, c + 1]) {
+        if (nc < 0 || nc >= cols) continue;
+        const ncell = nr * cols + nc;
+        if (!visitedCells[ncell]) {
+          visitedCells[ncell] = 1;
+          count++;
+        }
+        const ndir = nc === c - 1 ? DIR_DL : DIR_DR;
+        stack.push(ncell * 3 + ndir);
+      }
+    } else {
+      if (nr >= rows) continue;
+      const nc = c + DIRS[dir][1];
+      if (nc < 0 || nc >= cols) continue;
+      const ncell = nr * cols + nc;
+      if (!visitedCells[ncell]) {
+        visitedCells[ncell] = 1;
+        count++;
+      }
+      stack.push(ncell * 3 + dir);
+    }
+  }
+
+  return count;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  const { rows, cols, splitter, sources } = parseGrid(grid);
+  if (rows === 0 || cols === 0) return 0n;
+
+  const memo = new Map<number, bigint>();
+
+  const pathsFrom = (state: number): bigint => {
+    const cached = memo.get(state);
+    if (cached !== undefined) return cached;
+
+    const cell = (state / 3) | 0;
+    const dir = state % 3;
+    const r = (cell / cols) | 0;
+    const c = cell % cols;
+    const nr = r + 1;
+    let total: bigint;
+
+    if (splitter[cell]) {
+      total = 0n;
+      if (nr < rows && c - 1 >= 0) total += pathsFrom((nr * cols + c - 1) * 3 + DIR_DL);
+      else total += 1n;
+      if (nr < rows && c + 1 < cols) total += pathsFrom((nr * cols + c + 1) * 3 + DIR_DR);
+      else total += 1n;
+    } else if (nr >= rows) {
+      total = 1n;
+    } else {
+      const nc = c + DIRS[dir][1];
+      if (nc < 0 || nc >= cols) total = 1n;
+      else total = pathsFrom((nr * cols + nc) * 3 + dir);
+    }
+
+    memo.set(state, total);
+    return total;
+  };
+
+  let result = 0n;
+  for (const src of sources) {
+    result += pathsFrom(src * 3 + DIR_DOWN);
+  }
+  return result;
+}
