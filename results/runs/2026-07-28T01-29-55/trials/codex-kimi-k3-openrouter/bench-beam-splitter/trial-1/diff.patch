+import { describe, expect, it } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index';
+
+function toGrid(rows: string[]): string[][] {
+  return rows.map((r) => r.split(''));
+}
+
+describe('spec examples', () => {
+  const grid1 = toGrid([
+    '.S...',
+    '.....',
+    '.^...',
+    '.....',
+  ]);
+
+  it('counts cells for single splitter', () => {
+    expect(countBeamCells(grid1)).toBe(5);
+  });
+
+  it('counts paths for single splitter', () => {
+    expect(countBeamPaths(grid1)).toBe(2n);
+  });
+
+  const grid2 = toGrid([
+    '.S...',
+    '.^...',
+    '^.^..',
+    '.....',
+  ]);
+
+  it('counts cells for two downstream splitters', () => {
+    expect(countBeamCells(grid2)).toBe(6);
+  });
+
+  it('counts paths for two downstream splitters', () => {
+    expect(countBeamPaths(grid2)).toBe(4n);
+  });
+});
+
+describe('countBeamCells', () => {
+  it('counts a straight beam with no splitters', () => {
+    const grid = toGrid([
+      '.S.',
+      '...',
+      '...',
+    ]);
+    expect(countBeamCells(grid)).toBe(3);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('returns 0 for an empty grid', () => {
+    expect(countBeamCells([])).toBe(0);
+    expect(countBeamPaths([])).toBe(0n);
+  });
+
+  it('handles a grid with no source', () => {
+    const grid = toGrid([
+      '...',
+      '.^.',
+    ]);
+    expect(countBeamCells(grid)).toBe(0);
+    expect(countBeamPaths(grid)).toBe(0n);
+  });
+
+  it('counts a source on the only row that exits immediately', () => {
+    const grid = toGrid(['.S.']);
+    expect(countBeamCells(grid)).toBe(1);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('counts a splitter directly below the source', () => {
+    const grid = toGrid([
+      '.S.',
+      '.^.',
+      '...',
+    ]);
+    // (0,1) S, (1,1) ^, then (2,0) and (2,2)
+    expect(countBeamCells(grid)).toBe(4);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('does not count off-grid beams', () => {
+    const grid = toGrid([
+      'S..',
+      '^..',
+      '...',
+    ]);
+    // (0,0) S, (1,0) ^ splits to (2,-1) absorbed and (2,1)
+    expect(countBeamCells(grid)).toBe(3);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('splits beams arriving diagonally at a splitter', () => {
+    const grid = toGrid([
+      '.S...',
+      '.^...',
+      '..^..',
+      '.....',
+    ]);
+    // (0,1) -> (1,1)^ -> DR beam hits (2,2)^ -> (3,1),(3,3);
+    // DL beam (2,0) exits at (3,-1). Cells: (0,1),(1,1),(2,0),(2,2),(3,1),(3,3)
+    expect(countBeamCells(grid)).toBe(6);
+    expect(countBeamPaths(grid)).toBe(3n);
+  });
+
+  it('counts shared cells once', () => {
+    const grid = toGrid([
+      'S.S',
+      '^.^',
+      '...',
+    ]);
+    // Left: (0,0),(1,0)^,(2,1). Right: (0,2),(1,2)^,(2,1). (2,3) is off-grid.
+    // Distinct: (0,0),(0,2),(1,0),(1,2),(2,1)
+    expect(countBeamCells(grid)).toBe(5);
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('splits a beam hitting a splitter on the last row', () => {
+    const grid = toGrid([
+      'S.',
+      '..',
+      '^.',
+    ]);
+    // (0,0) -> (1,0) -> (2,0)^; both branches exit the bottom.
+    expect(countBeamCells(grid)).toBe(3);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+});
+
+describe('countBeamPaths', () => {
+  // Builds a triangle of splitters: level i (row i) has splitters at columns
+  // C-i+1, C-i+3, ..., C+i-1, so every beam hits exactly one splitter per
+  // level and the path count is exactly 2^K after K levels.
+  function splitterTriangle(k: number): string[][] {
+    const cols = 2 * k + 1;
+    const grid: string[][] = [];
+    for (let r = 0; r <= k + 1; r++) {
+      grid.push(new Array<string>(cols).fill('.'));
+    }
+    grid[0][k] = 'S';
+    for (let i = 1; i <= k; i++) {
+      for (let c = k - i + 1; c <= k + i - 1; c += 2) {
+        grid[i][c] = '^';
+      }
+    }
+    return grid;
+  }
+
+  it('doubles paths with each splitter level', () => {
+    for (let k = 1; k <= 10; k++) {
+      expect(countBeamPaths(splitterTriangle(k))).toBe(1n << BigInt(k));
+    }
+  });
+
+  it('handles multiple sources', () => {
+    const grid = toGrid([
+      'S.S',
+      '...',
+    ]);
+    expect(countBeamPaths(grid)).toBe(2n);
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('matches brute force on randomized grids', () => {
+    const rng = mulberry32(42);
+    for (let trial = 0; trial < 200; trial++) {
+      const rows = 2 + Math.floor(rng() * 5);
+      const cols = 2 + Math.floor(rng() * 5);
+      const grid: string[][] = [];
+      for (let r = 0; r < rows; r++) {
+        const row: string[] = [];
+        for (let c = 0; c < cols; c++) {
+          const roll = rng();
+          row.push(roll < 0.15 ? '^' : '.');
+        }
+        grid.push(row);
+      }
+      grid[0][Math.floor(rng() * cols)] = 'S';
+      expect(countBeamPaths(grid)).toBe(bruteForcePaths(grid));
+      expect(countBeamCells(grid)).toBe(bruteForceCells(grid));
+    }
+  });
+
+  it('handles a dense 200x200 grid with 50 splitters quickly', () => {
+    const size = 200;
+    const rng = mulberry32(7);
+    const grid: string[][] = [];
+    for (let r = 0; r < size; r++) {
+      grid.push(new Array<string>(size).fill('.'));
+    }
+    grid[0][size / 2] = 'S';
+    let placed = 0;
+    while (placed < 50) {
+      const r = 1 + Math.floor(rng() * (size - 1));
+      const c = Math.floor(rng() * size);
+      if (grid[r][c] === '.') {
+        grid[r][c] = '^';
+        placed++;
+      }
+    }
+    const start = performance.now();
+    const paths = countBeamPaths(grid);
+    const cells = countBeamCells(grid);
+    const elapsed = performance.now() - start;
+    expect(elapsed).toBeLessThan(5000);
+    expect(paths).toBeGreaterThan(0n);
+    expect(cells).toBeGreaterThan(0);
+  });
+
+  it('returns a bigint with huge splitter counts', () => {
+    const paths = countBeamPaths(splitterTriangle(60));
+    expect(typeof paths).toBe('bigint');
+    expect(paths).toBe(1n << 60n);
+  });
+});
+
+type Dir = 0 | 1 | 2;
+const DELTAS: Record<Dir, [number, number]> = {
+  0: [1, -1],
+  1: [1, 0],
+  2: [1, 1],
+};
+
+function bruteForcePaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  let count = 0n;
+  const walk = (r: number, c: number, d: Dir): void => {
+    let cr = r;
+    let cc = c;
+    let dir = d;
+    for (;;) {
+      const [dr, dc] = DELTAS[dir];
+      const nr = cr + dr;
+      const nc = cc + dc;
+      if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
+        count += 1n;
+        return;
+      }
+      if (grid[nr][nc] === '^') {
+        walk(nr, nc, 0);
+        walk(nr, nc, 2);
+        return;
+      }
+      cr = nr;
+      cc = nc;
+      dir = dir;
+    }
+  };
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') walk(0, c, 1);
+  }
+  return count;
+}
+
+function bruteForceCells(grid: string[][]): number {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  const seen = new Set<string>();
+  const walk = (r: number, c: number, d: Dir): void => {
+    let cr = r;
+    let cc = c;
+    let dir = d;
+    seen.add(`${cr},${cc}`);
+    for (;;) {
+      const [dr, dc] = DELTAS[dir];
+      const nr = cr + dr;
+      const nc = cc + dc;
+      if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) return;
+      seen.add(`${nr},${nc}`);
+      if (grid[nr][nc] === '^') {
+        walk(nr, nc, 0);
+        walk(nr, nc, 2);
+        return;
+      }
+      cr = nr;
+      cc = nc;
+    }
+  };
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') walk(0, c, 1);
+  }
+  return seen.size;
+}
+
+function mulberry32(seed: number): () => number {
+  let a = seed;
+  return () => {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
