 /''^z'\"\\\\d+\"'$/.test(w);\n\nconst zz = (bit: number) => `z${String(bit).padStart(2, '\"'0')}\"'`;\n\n/**\n * Find the 8 wires involved in the 4 swapped output pairs.\n *\n * Key observation: swapping gate outputs only permutes the `out` labels —\n * every gate'\"'s (op, in1, in2) still matches the canonical ripple-carry\n * adder exactly, and gate input references are immune to swaps. So instead\n * of simulating, we walk the adder structurally from bit 0 upward using\n * input references as ground truth:\n *\n *  - bit 0 is a half adder: XOR(x00,y00) -> z00, AND(x00,y00) -> carry\n *  - bit k is a full adder whose \\\"twin pair\\\" (an XOR and an AND sharing the\n *    input set {partial, carry-in}) anchors everything:\n *      twin XOR  -> z_k            (the sum bit)\n *      twin AND  -> propagate      (feeds the carry OR)\n *      AND(x_k,y_k) -> generate    (the other carry OR input)\n *      OR(generate, propagate) -> carry out\n *  - the final carry is the most significant z bit.\n *\n * Whenever a wire's actual producer differs from the gate that should\n * produce it, the mismatch pinpoints a swapped pair. Each repair swaps the\n * two labels in an in-memory producer map — restoring the intended state\n * permanently — and records both wires. Runs in O(gates x bits): far below\n * the time limit even at 45 input bits.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  if (gates.length === 0) return [];\n\n  // Mutable model of the circuit: wire name -> gate that produces it.\n  const producer = new Map<string, Gate>();\n  // Current output wire of every gate (identity-keyed), so swaps never\n  // touch the caller's gate objects.\n  const currentOut = new Map<Gate, string>();\n  // Gates indexed by (op, sorted inputs) for canonical lookups.\n  const bySignature = new Map<string, Gate>();\n\n  const signature = (op: Gate['op'], a: string, b: string) =>\n    \"'`${op}:${a < b ? `${a}|${b}` : `${b}|${a}`}`;\n\n  for (const gate of gates)