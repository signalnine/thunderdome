=> /''^z'\"\\\\d+\"'$/.test(w);\n\nconst zz = (bit: number) => `z${String(bit).padStart(2, '\"'0')}\"'`;\n\n/**\n * Find the 8 wires involved in the 4 swapped output pairs.\n *\n * Key observation: swapping gate outputs only permutes the `out` labels —\n * every gate'\"'s (op, in1, in2) still matches the canonical ripple-carry\n * adder exactly, and gate input references are immune to swaps. So instead\n * of simulating, we walk the adder structurally from bit 0 upward using\n * input references as ground truth:\n *\n *  - bit 0 is a half adder: XOR(x00,y00) -> z00, AND(x00,y00) -> carry\n *  - bit k is a full adder whose \\\"twin pair\\\" (an XOR and an AND sharing the\n *    input set {partial, carry-in}) anchors everything:\n *      twin XOR  -> z_k            (the sum bit)\n *      twin AND  -> propagate      (feeds the carry OR)\n *      AND(x_k,y_k) -> generate    (the other carry OR input)\n *      OR(generate, propagate) -> carry out\n *  - the final carry is the most significant z bit.\n *\n * Whenever a wire's actual producer differs from the gate that should\n * produce it, the mismatch pinpoints a swapped pair. Each repair swaps the\n * two labels in an in-memory producer map — restoring the intended state\n * permanently — and records both wires. Runs in O(gates x bits): far below\n * the time limit even at 45 input bits.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  if (gates.length === 0) return [];\n\n  // Mutable model of the circuit: wire name -> gate that produces it.\n  const producer = new Map<string, Gate>();\n  // Current output wire of every gate (identity-keyed), so swaps never\n  // touch the caller's gate objects.\n  const currentOut = new Map<Gate, string>();\n  // Gates indexed by (op, sorted inputs) for canonical lookups.\n  const bySignature = new Map<string, Gate>();\n\n  const signature = (op: Gate['op'], a: string, b: string) =>\n    \"'`${op}:${a < b ? `${a}|${b}` : `${b}|${a}`}`;\n\n  for (const gate of gates) {\n    producer.set(gate.out, gate);\n    currentOut.set(gate, gate.out);\n    bySignature.set(signature(gate.op, gate.in1, gate.in2), gate);\n  }\n\n  const swapped = new Set<string>();\n\n  /** Exchange the outputs of the gates currently producing `a` and `b`. */\n  const repairSwap = (a: string, b: string) => {\n    if (a === b) return;\n    const gateA = producer.get(a);\n    const gateB = producer.get(b);\n    if (!gateA || !gateB || gateA === gateB) return;\n    producer.set(a, gateB);\n    producer.set(b, gateA);\n    currentOut.set(gateA, b);\n    currentOut.set(gateB, a);\n    swapped.add(a);\n    swapped.add(b);\n  };\n\n  /** The gate whose inputs are exactly {a, b} with the given op. */\n  const findGate = (op: Gate['\"'op'], a: string, b: string): Gate | undefined =>\n    bySignature.get(signature(op, a, b));\n\n  /**\n   * Ensure \"'`wire` is produced by `gate`; if the gate currently drives a\n   * different output, that pair of outputs was exchanged — repair it.\n   */\n  const expectOutput = (wire: string, gate: Gate | undefined) => {\n    if (!gate) return;\n    const actual = currentOut.get(gate)!;\n    if (actual !== wire) repairSwap(actual, wire);\n  };\n\n  /**\n   * Ensure `wire` is produced by the gate with signature (op, a, b).\n   * Returns that gate, or undefined if the circuit has no such gate.\n   */\n  const expectGate = (\n    wire: string,\n    op: Gate['\"'op'],\n    a: string,\n    b: string,\n  ): Gate | undefined => {\n    const gate = findGate(op, a, b);\n    expectOutput(wire, gate);\n    return gate;\n  };\n\n  const bits = Array.from(\n    new Set(\n      gates\n        .filter((g) => isX(g.in1) && isY(g.in2))\n        .map((g) => parseInt(g.in1.slice(1), 10)),\n    ),\n  ).sort((a, b) => a - b);\n  const numBits = bits.length > 0 ? Math.max(...bits) + 1 : 0;\n\n  let carry: string | null = null;\n\n  for (let bit = 0; bit < numBits; bit++) {\n    const xx = \"'`x${String(bit).padStart(2, '\"'0')}\"'`;\n    const yy = `y${String(bit).padStart(2, '\"'0')}\"'`;\n\n    if (bit === 0) {\n      // Half adder.\n      expectGate(zz(0), '\"'XOR', xx, yy);\n      const and0 = findGate('AND', xx, yy);\n      carry = and0 ? currentOut.get(and0)\"'! : null;\n      continue;\n    }\n\n    // Partial sum and generate for this bit.\n    const xor1 = findGate('\"'XOR', xx, yy);\n    const and1 = findGate('AND', xx, yy);\n    if (\"'!xor1 || !and1 || carry === null) break;\n    let partial = currentOut.get(xor1)!;\n    const generate = currentOut.get(and1)!;\n\n    // Anchor: the twin pair {XOR, AND} over {partial, carry-in}. One of the\n    // two twin inputs is the incoming carry; the other is the intended\n    // partial — which may currently live on the wrong wire if the partial\n    // was swapped away.\n    let twinXor = findGate('\"'XOR', partial, carry);\n    let twinAnd = findGate('AND', partial, carry);\n\n    if (\"'!twinXor && !twinAnd) {\n      // The incoming carry wire is not consumed by any twin: its intended\n      // consumer was swapped away. Find any full-adder twin pair and adopt\n      // its non-carry input as the real partial; the wire currently holding\n      // that name is our carry'\"'s swap partner.\n      for (const gate of gates) {\n        if (gate.op \"'!== '\"'XOR') continue;\n        if (isX(gate.in1) || isY(gate.in1) || isX(gate.in2) || isY(gate.in2)) continue;\n        const other = findGate('AND', gate.in1, gate.in2);\n        if (\"'!other) continue;\n        // This is some full adder'\"'s twin pair. Its inputs are an intended\n        // partial and an intended carry-in. Exactly one of them matches the\n        // wire our xor1/and1 currently drive.\n        const candidates = [gate.in1, gate.in2];\n        const match = candidates.find((w) => w === partial || w === carry);\n        if (\"'!match) continue;\n        const intended = candidates.find((w) => w !== match)!;\n        if (match === carry) {\n          // carry was swapped with the intended partial nam