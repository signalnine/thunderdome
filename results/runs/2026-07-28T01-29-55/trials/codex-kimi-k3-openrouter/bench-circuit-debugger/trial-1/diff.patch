+      // Swap consecutive carries plus two other scattered pairs.
+      let mutated = swapOutputs(gates, `c${pad(k)}`, `c${pad(k + 1)}`);
+      mutated = swapOutputs(mutated, `t${pad(k + 1)}`, `z${pad(k + 2)}`);
+      mutated = swapOutputs(mutated, `a${pad(k + 1)}`, `b${pad(k + 2)}`);
+      mutated = swapOutputs(mutated, `z${pad(k)}`, `c${pad(k + 2)}`);
+      const expected = [
+        `c${pad(k)}`,
+        `c${pad(k + 1)}`,
+        `c${pad(k + 2)}`,
+        `t${pad(k + 1)}`,
+        `z${pad(k)}`,
+        `z${pad(k + 2)}`,
+        `a${pad(k + 1)}`,
+        `b${pad(k + 2)}`,
+      ].sort();
+      expect(findSwappedWires(mutated), `carries at bits ${k}-${k + 2}`).toEqual(expected);
+    }
+  });
+
+  it('works with random (non-semantic) internal wire names', () => {
+    // Mimic the real puzzle: internal wires have meaningless 3-letter names.
+    const rand = rng(2468);
+    const name = () =>
+      String.fromCharCode(
+        97 + Math.floor(rand() * 26),
+        97 + Math.floor(rand() * 26),
+        97 + Math.floor(rand() * 26),
+      );
+    const bits = 10;
+    const gates = buildAdder(bits);
+    const renames = new Map<string, string>();
+    const used = new Set(gates.map((g) => g.out));
+    for (const gate of gates) {
+      if (/^[abc]\d+$/.test(gate.out)) {
+        let fresh = name();
+        while (used.has(fresh)) fresh = name();
+        renames.set(gate.out, fresh);
+        used.add(fresh);
+      }
+    }
+    const renamed = gates.map((g) => ({
+      op: g.op,
+      in1: renames.get(g.in1) ?? g.in1,
+      in2: renames.get(g.in2) ?? g.in2,
+      out: renames.get(g.out) ?? g.out,
+    }));
+    const wires = renamed.map((g) => g.out);
+    const chosen = randomDistinct(wires, 8, rand);
+    let mutated = renamed;
+    for (let p = 0; p < 4; p++) {
+      mutated = swapOutputs(mutated, chosen[2 * p], chosen[2 * p + 1]);
+    }
+    expect(findSwappedWires(mutated)).toEqual([...chosen].sort());
+  });
+
+  it('runs well under the time limit at 45 bits', () => {
+    const rand = rng(13579);
+    const gates = buildAdder(45);
+    const wires = gates.map((g) => g.out);
+    const chosen = randomDistinct(wires, 8, rand);
+    let mutated = gates;
+    for (let p = 0; p < 4; p++) {
+      mutated = swapOutputs(mutated, chosen[2 * p], chosen[2 * p + 1]);
+    }
+    const start = performance.now();
+    for (let i = 0; i < 1000; i++) findSwappedWires(mutated);
+    const elapsed = performance.now() - start;
+    expect(elapsed / 1000).toBeLessThan(50); // milliseconds per solve
+  });
+});
