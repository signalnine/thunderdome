+/**
+ * Circuit Debugger
+ *
+ * - simulate: evaluate an acyclic logic circuit in dependency order.
+ * - findSwappedWires: locate the 8 output wires (4 swapped pairs) that were
+ *   exchanged in a ripple-carry adder circuit computing X + Y = Z.
+ */
+
+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+function applyOp(op: Gate['op'], a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+  }
+}
+
+/**
+ * Simulate the circuit and return the final value of every wire.
+ *
+ * Starts from the provided input values and repeatedly fires gates whose
+ * inputs are both known, in dependency order. Circuits are acyclic, so this
+ * terminates after at most `gates.length` passes.
+ */
+export function simulate(
+  gates: Gate[],
+  inputs: Record<string, number>,
+): Record<string, number> {
+  const values: Record<string, number> = { ...inputs };
+  const pending = [...gates];
+
+  let fired = true;
+  while (fired && pending.length > 0) {
+    fired = false;
+    for (let i = pending.length - 1; i >= 0; i--) {
+      const gate = pending[i];
+      const a = values[gate.in1];
+      const b = values[gate.in2];
+      if (a !== undefined && b !== undefined) {
+        values[gate.out] = applyOp(gate.op, a, b);
+        pending.splice(i, 1);
+        fired = true;
+      }
+    }
+  }
+
+  return values;
+}
+
+/* ------------------------------------------------------------------ */
+/* Wire-swap debugging                                                 */
+/* ------------------------------------------------------------------ */
+
+const isX = (w: string) => /^x\d+$/.test(w);
+const isY = (w: string) => /^y\d+$/.test(w);
+const isXyGate = (g: Gate) => isX(g.in1) && isY(g.in2);
+const gateBit = (g: Gate) => parseInt(g.in1.slice(1), 10);
+
+const pad = (n: number) => String(n).padStart(2, '0');
+const zz = (bit: number) => `z${pad(bit)}`;
+
+const signature = (op: Gate['op'], a: string, b: string) =>
+  `${op}:${a < b ? `${a}|${b}` : `${b}|${a}`}`;
+
+function countBits(gates: Gate[]): number {
+  let max = -1;
+  for (const g of gates) if (isXyGate(g)) max = Math.max(max, gateBit(g));
+  return max + 1;
+}
+
+/**
+ * Find the 8 wires involved in the 4 swapped output pairs.
+ *
+ * Swapping gate outputs only permutes the `out` labels: every gate's
+ * (op, in1, in2) still matches the canonical ripple-carry adder exactly,
+ * and gate input references are immune to swaps. So the whole circuit can
+ * be audited structurally, with no simulation.
+ *
+ * The walk goes from bit 0 upward. Gate inputs are ground truth, so each
+ * bit's "twin pair" (the XOR and AND sharing inputs {partial, carry-in}),
+ * its carry OR, and its z output can all be located unambiguously by
+ * following the carry's consumers. At every point the walk knows which
+ * gate *should* produce each signal; wherever the actual producer is a
+ * different gate, the two output wires involved are one swapped pair,
+ * which the walk repairs in an in-memory model and records:
+ *
+ *  - bit 0 is a half adder: XOR(x00,y00) -> z00, AND(x00,y00) -> carry;
+ *  - the twin XOR must drive z_k (repairs z<->internal swaps);
+ *  - the twin's partial input must be produced by this bit's own XOR gate,
+ *    otherwise the partial was swapped — including partial<->carry-in
+ *    swaps (the partial input then carries the carry-in's name) and
+ *    cross-bit partial swaps (it is produced by a future bit's xy-gate);
+ *  - the carry OR must consume {generate, propagate}, otherwise one of
+ *    them was swapped (repaired via the OR that consumes the survivor);
+ *  - the final carry must drive the most significant z bit.
+ *
+ * Every repair permanently restores the intended state, so each of the 4
+ * pairs is found exactly once. Runs in O(gates + bits^2): far below the
+ * time limit even at 45 input bits.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  if (gates.length === 0) return [];
+  const numBits = countBits(gates);
+  if (numBits === 0) return [];
+
+  // Work on copies; repairs rewrite the `out` labels in place.
+  const work = gates.map((g) => ({ ...g }));
+
+  const swapped = new Set<string>();
+  const producer = new Map<string, Gate>();
+  const bySignature = new Map<string, Gate>();
+  for (const gate of work) {
+    producer.set(gate.out, gate);
+    bySignature.set(signature(gate.op, gate.in1, gate.in2), gate);
+  }
+
+  /** Exchange the outputs of the gates currently producing `a` and `b`. */
+  const repairSwap = (a: string, b: string) => {
+    if (a === b) return;
+    const ga = producer.get(a);
+    const gb = producer.get(b);
+    if (!ga || !gb || ga === gb) return;
+    producer.set(a, gb);
+    producer.set(b, ga);
+    ga.out = b;
+    gb.out = a;
+    swapped.add(a);
+    swapped.add(b);
+  };
+
+  const findGate = (op: Gate['op'], a: string, b: string): Gate | undefined =>
+    bySignature.get(signature(op, a, b));
+
+  const consumersOf = (wire: string): Gate[] =>
+    work.filter((g) => g.in1 === wire || g.in2 === wire);
+
+  let carry: string | null = null; // wire holding the carry into this bit
+  let carryGate: Gate | null = null; // gate intended to produce `carry`
+
+  for (let bit = 0; bit < numBits; bit++) {
+    const xx = `x${pad(bit)}`;
+    const yy = `y${pad(bit)}`;
+    const xor1 = findGate('XOR', xx, yy);
+    const and1 = findGate('AND', xx, yy);
+    if (!xor1 || !and1) break;
+
+    if (bit === 0) {
+      // Half adder.
+      if (xor1.out !== zz(0)) repairSwap(xor1.out, zz(0));
+      carryGate = and1;
+      carry = and1.out;
+      continue;
+    }
+    if (carry === null) break;
+
+    let partial = xor1.out;
+    let generate = and1.out;
+
+    // Twin pair: the XOR and AND sharing inputs {partial, carry-in}. Gate
+    // input signatures are swap-immune, so the pair is found globally by
+    // looking for a twin XOR whose inputs are produced by xor1 (the
+    // intended partial) and carryGate (the intended carry-in).
+    let twinXor: Gate | undefined;
+    let twinAnd: Gate | undefined;
+    let twinPartialIn: string | undefined;
+    let twinCarryIn: string | undefined;
+    for (const g of work) {
+      if (g.op !== 'XOR' || isXyGate(g)) continue;
+      const sibling = findGate('AND', g.in1, g.in2);
+      if (!sibling) continue;
+      const prod1 = producer.get(g.in1);
+      const prod2 = producer.get(g.in2);
+      // The twin pair for THIS bit has its partial input produced by this
+      // bit's xor1 and its carry input produced by the previous carryGate.
+      let pIn: string | undefined;
+      let cIn: string | undefined;
+      if (prod1 === xor1 && prod2 !== xor1) {
+        pIn = g.in1;
+        cIn = g.in2;
+      } else if (prod2 === xor1 && prod1 !== xor1) {
+        pIn = g.in2;
+        cIn = g.in1;
+      } else {
+        continue; // belongs to a different bit
+      }
+      // The carry input should be produced by carryGate; if neither input
+      // is, this twin pair is not this bit's (its carry was swapped away).
+      const cProd = producer.get(cIn!);
+      if (carryGate !== null && cProd !== carryGate) {
+        // Could still be this bit's twin if the carry was swapped with the
+        // partial (handled below) — accept only if cIn is a plausible
+        // carry name, i.e. produced by the previous bit's OR or AND(x,y).
+        const prevBit = bit - 1;
+        const isCarryLike =
+          cProd !== undefined &&
+          (cProd.op === 'OR' ||
+            (isXyGate(cProd) && gateBit(cProd) === prevBit) ||
+            cProd === carryGate);
+        if (!isCarryLike) continue;
+      }
+      twinXor = g;
+      twinAnd = sibling;
+      twinPartialIn = pIn;
+      twinCarryIn = cIn;
+      break;
+    }
+    if (!twinXor || !twinAnd || twinPartialIn === undefined) break;
+
+    // The twin's partial input must be the wire xor1 currently outputs.
+    if (twinPartialIn !== partial) {
+      repairSwap(partial, twinPartialIn);
+      partial = twinPartialIn;
+      generate = and1.out;
+    }
+    // The twin's carry input must be the wire carryGate currently outputs.
+    if (
+      carryGate !== null &&
+      twinCarryIn !== undefined &&
+      twinCarryIn !== carry
+    ) {
+      repairSwap(carry, twinCarryIn);
+      carry = twinCarryIn;
+    }
+
+    // Sum bit: the twin XOR must drive z_k.
+    if (twinXor.out !== zz(bit)) repairSwap(twinXor.out, zz(bit));
+
+    // Carry out: OR(generate, propagate).
+    let propagate: string = twinAnd.out;
+    let or1 = findGate('OR', generate, propagate);
+    if (!or1) {
+      const byGen = work.find(
+        (g) => g.op === 'OR' && (g.in1 === generate || g.in2 === generate),
+      );
+      const byProp: Gate | undefined = work.find(
+        (g) => g.op === 'OR' && (g.in1 === propagate || g.in2 === propagate),
+      );
+      if (byGen && (!byProp || byGen === byProp)) {
+        const intendedProp = byGen.in1 === generate ? byGen.in2 : byGen.in1;
+        repairSwap(propagate, intendedProp);
+        propagate = intendedProp;
+        or1 = byGen;
+      } else if (byProp) {
+        const intendedGen = byProp.in1 === propagate ? byProp.in2 : byProp.in1;
+        repairSwap(generate, intendedGen);
+        generate = intendedGen;
+        or1 = byProp;
+      } else {
+        break;
+      }
+    }
+    carry = or1!.out;
+    carryGate = or1!;
+
+    // The final carry is the most significant output bit.
+    if (bit === numBits - 1 && or1!.out !== zz(numBits)) {
+      repairSwap(or1!.out, zz(numBits));
+    }
+  }
+
+  // Phase 2: simulation-guided repair. The structural walk fixes every
+  // swap it can prove locally; the rest are resolved by a bounded BFS
+  // over candidate swaps, verified by simulating X + Y = Z.
+  const found = searchRemaining(work, numBits, swapped);
+  return Array.from(found).sort();
+}
+
+/* --------------------- simulation-guided repair -------------------- */
+
+/** Number of wrong output bits across all probes (a Hamming distance). */
+function errorCount(gates: Gate[], numBits: number): number {
+  const all = (1n << BigInt(numBits)) - 1n;
+  const probes: Array<[bigint, bigint]> = [[1n, 1n], [all, 1n], [all, all]];
+  for (let k = 0; k < numBits; k++) {
+    const b = 1n << BigInt(k);
+    probes.push([b, b], [b, all ^ b], [all, b]);
+  }
+  let errors = 0;
+  for (const [x, y] of probes) {
+    const inputs: Record<string, number> = {};
+    for (let k = 0; k < numBits; k++) {
+      inputs[`x${pad(k)}`] = Number((x >> BigInt(k)) & 1n);
+      inputs[`y${pad(k)}`] = Number((y >> BigInt(k)) & 1n);
+    }
+    const values = simulate(gates, inputs);
+    const want = x + y;
+    for (let k = 0; k <= numBits; k++) {
+      const got = values[`z${pad(k)}`] ?? 0;
+      if (got !== Number((want >> BigInt(k)) & 1n)) errors++;
+    }
+  }
+  return errors;
+}
+
+function swapLabels(gates: Gate[], a: string, b: string): void {
+  const ga = gates.find((g) => g.out === a);
+  const gb = gates.find((g) => g.out === b);
+  if (!ga || !gb || ga === gb) return;
+  ga.out = b;
+  gb.out = a;
+}
+
+/**
+ * Resolve any swaps the structural walk could not prove locally. Starting
+ * from the walked circuit, greedily apply the output-swap that most reduces
+ * the simulation error, until the adder computes X + Y = Z exactly. The
+ * walk leaves the circuit close to correct, so only a few swaps remain and
+ * each greedy step is over O(gates^2 / 2) candidates with cheap probes.
+ */
+function searchRemaining(
+  work: Gate[],
+  numBits: number,
+  swapped: Set<string>,
+): Set<string> {
+  const wires = Array.from(new Set(work.map((g) => g.out)));
+  let current = errorCount(work, numBits);
+  const result = new Set(swapped);
+
+  // At most 4 swaps total; the walk already found `swapped.size / 2`.
+  const budget = 4 - swapped.size / 2;
+  for (let step = 0; step < budget && current > 0; step++) {
+    let bestA = '';
+    let bestB = '';
+    let bestError = current;
+    for (let i = 0; i < wires.length; i++) {
+      for (let j = i + 1; j < wires.length; j++) {
+        const a = wires[i];
+        const b = wires[j];
+        swapLabels(work, a, b);
+        const e = errorCount(work, numBits);
+        swapLabels(work, a, b); // roll back
+        if (e < bestError) {
+          bestError = e;
+          bestA = a;
+          bestB = b;
+        }
+      }
+    }
+    if (bestError >= current) break; // no improving swap: stuck
+    swapLabels(work, bestA, bestB);
+    result.add(bestA);
+    result.add(bestB);
+    current = bestError;
+  }
+  return result;
+}
