+{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/src/index.ts << 'EOF'\n/**\n * Circuit Debugger\n *\n * - simulate: evaluate an acyclic logic circuit in dependency order.\n * - findSwappedWires: locate the 8 output wires (4 swapped pairs) that were\n *   exchanged in a ripple-carry adder circuit computing X + Y = Z.\n */\n\nexport interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string;\n  in2: string;\n  out: string;\n}\n\nfunction applyOp(op: Gate['op'], a: number, b: number): number {\n  switch (op) {\n    case 'AND':\n      return a & b;\n    case 'OR':\n      return a | b;\n    case 'XOR':\n      return a \"'^ b;\n  }\n}\n\n/**\n * Simulate the circuit and return the final value of every wire.\n *\n * Starts from the provided input values and repeatedly fires gates whose\n * inputs are both known, in dependency order. Circuits are acyclic, so this\n * terminates after at most `gates.length` passes.\n */\nexport function simulate(\n  gates: Gate[],\n  inputs: Record<string, number>,\n): Record<string, number> {\n  const values: Record<string, number> = { ...inputs };\n  const pending = [...gates];\n\n  let fired = true;\n  while (fired && pending.length > 0) {\n    fired = false;\n    for (let i = pending.length - 1; i >= 0; i--) {\n      const gate = pending[i];\n      const a = values[gate.in1];\n      const b = values[gate.in2];\n      if (a !== undefined && b !== undefined) {\n        values[gate.out] = applyOp(gate.op, a, b);\n        pending.splice(i, 1);\n        fired = true;\n      }\n    }\n  }\n\n  return values;\n}\n\n/* ------------------------------------------------------------------ */\n/* Wire-swap debugging                                                 */\n/* ------------------------------------------------------------------ */\n\nconst isX = (w: string) => /''^x'\"\\\\d+\"'$/.test(w);\nconst isY = (w: string) => /''^y'\"\\\\d+\"'$/.test(w);\n\nconst zz = (bit: number) => `z${String(bit).padStart(2, '\"'0')}\"'`;\n\n/**\n * Find the 8 wires involved in the 4 swapped output pairs.\n *\n * Key observation: swapping gate outputs only permutes the `out` labels.\n * Every gate'\"'s (op, in1, in2) still matches the canonical ripple-carry\n * adder exactly, and gate input references are immune to swaps — so the\n * intended role of every signal can be recovered structurally, with no\n * simulation at all.\n *\n * We walk the adder from bit 0 upward maintaining the full intended\n * variable set of each bit — partial (x XOR y), generate (x AND y),\n * propagate (partial AND carry-in), and the carry — plus the actual wire\n * names currently holding them:\n *\n *  - bit 0 is a half adder: XOR(x00,y00) -> z00, AND(x00,y00) -> carry;\n *  - bit k anchors on the \\\"twin pair\\\": an XOR and an AND gate that share\n *    the input set {partial, carry-in}. The twin XOR drives z_k, the twin\n *    AND drives propagate, and OR(generate, propagate) drives the carry;\n *  - a partial <-> carry-in swap moves the whole twin pair, which is\n *    detected because the other input of the twins must be the output of\n *    this bit's (or a future bit's) own XOR/AND gates;\n *  - the final carry is the most significant z bit.\n *\n * Whenever a wire's actual producer differs from the gate that should\n * produce it, the mismatch pinpoints one swapped pair. Each repair swaps\n * the two labels in an in-memory model — restoring the intended state\n * permanently — and records both wires. Runs in O(gates + bits\"'^2): far\n * below the time limit even at 45 input bits.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  if (gates.length === 0) return [];\n\n  // Mutable model of the circuit: wire name -> gate that produces it.\n  const producer = new Map<string, Gate>();\n  // Current output wire of every gate (identity-keyed), so repairs never\n  // touch the caller'\"'s gate objects.\n  const currentOut = new Map<Gate, string>();\n  // Canonical gates indexed by (op, sorted inputs).\n  const bySignature = new Map<string, Gate>();\n\n  const signature = (op: Gate['op'], a: string, b: string) =>\n    \"'`${op}:${a < b ? `${a}|${b}` : `${b}|${a}`}`;\n\n  for (const gate of gates) {\n    producer.set(gate.out, gate);\n    currentOut.set(gate, gate.out);\n    bySignature.set(signature(gate.op, gate.in1, gate.in2), gate);\n  }\n\n  const swapped = new Set<string>();\n\n  /** Exchange the outputs of the gates currently producing `a` and `b`. */\n  const repairSwap = (a: string, b: string) => {\n    if (a === b) return;\n    const gateA = producer.get(a);\n    const gateB = producer.get(b);\n    if (!gateA || !gateB || gateA === gateB) return;\n    producer.set(a, gateB);\n    producer.set(b, gateA);\n    currentOut.set(gateA, b);\n    currentOut.set(gateB, a);\n    swapped.add(a);\n    swapped.add(b);\n  };\n\n  /** The gate whose inputs are exactly {a, b} with the given op. */\n  const findGate = (op: Gate['\"'op'], a: string, b: string): Gate | undefined =>\n    bySignature.get(signature(op, a, b));\n\n  /** Gates consuming \"'`wire` as an input. */\n  const consumersOf = (wire: string): Gate[] =>\n    gates.filter((g) => g.in1 === wire || g.in2 === wire);\n\n  /**\n   * Ensure `wire` is produced by `gate`; if that gate currently drives a\n   * different output, the two outputs were exchanged — repair and record.\n   */\n  const expectOutput = (wire: string, gate: Gate | undefined) => {\n    if (!gate) return;\n    const actual = currentOut.get(gate)!;\n    if (actual !== wire) repairSwap(actual, wire);\n  };\n\n  /** Ensure the gate with signature (op, a, b) produces `wire`. */\n  const expectGate = (\n    wire: string,\n    op: Gate['\"'op'],\n    a: string,\n    b: string,\n  ): Gate | undefined => {\n    const gate = findGate(op, a, b);\n    expectOutput(wire, gate);\n    return gate;\n  };\n\n  const bits = Array.from(\n    new Set(\n      gates\n        .filter((g) => isX(g.in1) && isY(g.in2))\n        .map((g) => parseInt(g.in1.slice(1), 10)),\n    ),\n  ).sort((a, b) => a - b);\n  const numBits = bits.length > 0 ? Math.max(...bits) + 1 : 0;\n\n  /** The intended role set carried between bits. */\n  let carry: string | null = null; // carry into the current bit\n  let carryGate: Gate | null = null; // gate intended to produce \"'`carry`\n  let pendingTwinXor: Gate | null = null; // this bit'\"'s twin XOR gate\n  let pendingTwinAnd: Gate | null = null; // this bit's twin AND gate\n\n  for (let bit = 0; bit < numBits; bit++) {\n    const xx = \"'`x${String(bit).padStart(2, '\"'0')}\"'`;\n    const yy = `y${String(bit).padStart(2, '\"'0')}\"'`;\n\n    if (bit === 0) {\n      // Half adder.\n      expectGate(zz(0), '\"'XOR', xx, yy);\n      const and0 = findGate('AND', xx, yy);\n      if (\"'!and0) break;\n      carry = currentOut.get(and0)!;\n      carryGate = and0;\n      continue;\n    }\n\n    const xor1 = findGate('\"'XOR', xx, yy);\n    const and1 = findGate('AND', xx, yy);\n    if (\"'!xor1 || !and1 || carry === null || carryGate === null) break;\n\n    // Intended variables for this bit, and the wires currently holding them.\n    let partial = currentOut.get(xor1)!;\n    let generate = currentOut.get(and1)!;\n\n    if (pendingTwinXor && pendingTwinAnd) {\n      // The twins were already adopted while resolving a partial<->carry\n      // swap at the previous bit; their carry-in input is `carry` and the\n      // other input is the intended partial (now confirmed by xor1).\n      const inputs = [pendingTwinXor.in1, pendingTwinXor.in2];\n      const intendedPartial = inputs.find((w) => w !== carry)!;\n      if (intendedPartial !== partial) {\n        repairSwap(partial, intendedPartial);\n        partial = intendedPartial;\n      }\n    } else {\n      let twinXor = findGate('\"'XOR', partial, carry);\n      let twinAnd = findGate('AND', partial, carry);\n\n      if (\"'!twinXor && !twinAnd) {\n        // The incoming carry has no twin consumer: its intended consumer\n        // gates had their outputs swapped away. Find whichever canonical\n        // full-adder piece consumes the carry and reconstruct from there.\n        const consumer = consumersOf(carry).find(\n          (g) =>\n            g !== xor1 &&\n            g !== and1 &&\n            (g.op === '\"'XOR' || g.op === 'AND') &&\n            \"'!(isX(g.in1) && isY(g.in2)) &&\n            (isX(g.in1) || isX(g.in2) || isY(g.in1) || isY(g.in2)\n              ? false\n              : true),\n        );\n        const twin = consumersOf(carry).find(\n          (g) =>\n            (g.op === '\"'XOR' || g.op === 'AND') &&\n            \"'!(isX(g.in1) && isY(g.in2)) &&\n            g !== xor1 &&\n            g !== and1,\n        );\n        const anchor = consumer ?? twin;\n        if (!anchor) break;\n        const other = anchor.in1 === carry ? anchor.in2 : anchor.in1;\n        if (other === partial) {\n          // partial <-> carry swap: the twins live on {old partial name,\n          // old carry name} — but we only found one of them. The sibling\n          // twin has the same input set, so look it up directly.\n          // (Handled by the generic branch below.)\n        }\n        // The wire holding the intended partial/generate name is produced\n        // by some gate; the twins'\"' other input names that intended wire.\n        repairSwap(partial, other);\n        // If the intended partial name is currently produced by an xy-gate\n        // of a FUTURE bit, the whole twin pair moved there: the previous\n        // bit's partial was swapped with a future partial.\n        const futureProducer = producer.get(other);\n        if (\n          futureProducer &&\n          isX(futureProducer.in1) &&\n          isY(futureProducer.in2) &&\n          parseInt(futureProducer.in1.slice(1), 10) > bit\n        ) {\n          // Defer: the previous bit's twins are reachable once we know the\n          // future partial; for now just re-read local state.\n        }