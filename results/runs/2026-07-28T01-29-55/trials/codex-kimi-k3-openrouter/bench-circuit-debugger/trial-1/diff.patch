+{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/src/index.ts << 'EOF'\n/**\n * Circuit Debugger\n *\n * - simulate: evaluate an acyclic logic circuit in dependency order.\n * - findSwappedWires: locate the 8 output wires (4 swapped pairs) that were\n *   exchanged in a ripple-carry adder circuit computing X + Y = Z.\n */\n\nexport interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string;\n  in2: string;\n  out: string;\n}\n\nfunction applyOp(op: Gate['op'], a: number, b: number): number {\n  switch (op) {\n    case 'AND':\n      return a & b;\n    case 'OR':\n      return a | b;\n    case 'XOR':\n      return a \"'^ b;\n  }\n}\n\n/**\n * Simulate the circuit and return the final value of every wire.\n *\n * Starts from the provided input values and repeatedly fires gates whose\n * inputs are both known, in dependency order. Circuits are acyclic, so this\n * terminates after at most `gates.length` passes.\n */\nexport function simulate(\n  gates: Gate[],\n  inputs: Record<string, number>,\n): Record<string, number> {\n  const values: Record<string, number> = { ...inputs };\n  const pending = [...gates];\n\n  let fired = true;\n  while (fired && pending.length > 0) {\n    fired = false;\n    for (let i = pending.length - 1; i >= 0; i--) {\n      const gate = pending[i];\n      const a = values[gate.in1];\n      const b = values[gate.in2];\n      if (a !== undefined && b !== undefined) {\n        values[gate.out] = applyOp(gate.op, a, b);\n        pending.splice(i, 1);\n        fired = true;\n      }\n    }\n  }\n\n  return values;\n}\n\n/* ------------------------------------------------------------------ */\n/* Wire-swap debugging                                                 */\n/* ------------------------------------------------------------------ */\n\nconst isX = (w: string) => /''^x'\"\\\\d+\"'$/.test(w);\nconst isY = (w: string) => /''^y'\"\\\\d+\"'$/.test(w);\nconst isXyGate = (g: Gate)