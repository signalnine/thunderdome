+import { describe, expect, it } from 'vitest';
+import { findSwappedWires, simulate, type Gate } from '../src/index.js';
+
+/* ------------------------------------------------------------------ */
+/* Helpers                                                             */
+/* ------------------------------------------------------------------ */
+
+const pad = (n: number) => String(n).padStart(2, '0');
+
+/** Build the canonical ripple-carry adder for `bits` input bits. */
+function buildAdder(bits: number): Gate[] {
+  const gates: Gate[] = [];
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+  for (let k = 1; k < bits; k++) {
+    const xx = `x${pad(k)}`;
+    const yy = `y${pad(k)}`;
+    const t = `t${pad(k)}`;
+    const a = `a${pad(k)}`;
+    const b = `b${pad(k)}`;
+    const cPrev = `c${pad(k - 1)}`;
+    const c = `c${pad(k)}`;
+    const z = `z${pad(k)}`;
+    gates.push({ op: 'XOR', in1: xx, in2: yy, out: t });
+    gates.push({ op: 'XOR', in1: t, in2: cPrev, out: z });
+    gates.push({ op: 'AND', in1: xx, in2: yy, out: a });
+    gates.push({ op: 'AND', in1: t, in2: cPrev, out: b });
+    gates.push({ op: 'OR', in1: a, in2: b, out: c });
+  }
+  // Final carry becomes the MSB of Z; model it by renaming the last carry.
+  const lastCarry = gates.findIndex((g) => g.out === `c${pad(bits - 1)}`);
+  gates[lastCarry] = { ...gates[lastCarry], out: `z${pad(bits)}` };
+  return gates;
+}
+
+/** Deterministic PRNG (mulberry32). */
+function rng(seed: number) {
+  let s = seed >>> 0;
+  return () => {
+    s = (s + 0x6d2b79f5) >>> 0;
+    let t = s;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+/** Swap the `out` fields of two gates (the swap operation being debugged). */
+function swapOutputs(gates: Gate[], wireA: string, wireB: string): Gate[] {
+  const result = gates.map((g) => ({ ...g }));
+  const a = result.find((g) => g.out === wireA);
+  const b = result.find((g) => g.out === wireB);
+  if (!a || !b) throw new Error(`cannot swap ${wireA} <-> ${wireB}`);
+  [a.out, b.out] = [b.out, a.out];
+  return result;
+}
+
+function randomDistinct<T>(items: T[], count: number, rand: () => number): T[] {
+  const pool = [...items];
+  const picked: T[] = [];
+  for (let i = 0; i < count; i++) {
+    picked.push(pool.splice(Math.floor(rand() * pool.length), 1)[0]);
+  }
+  return picked;
+}
+
+function inputsFor(bits: number, x: bigint, y: bigint): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  for (let k = 0; k < bits; k++) {
+    inputs[`x${pad(k)}`] = Number((x >> BigInt(k)) & 1n);
+    inputs[`y${pad(k)}`] = Number((y >> BigInt(k)) & 1n);
+  }
+  return inputs;
+}
+
+function zValue(values: Record<string, number>, bits: number): bigint {
+  let z = 0n;
+  for (let k = 0; k <= bits; k++) {
+    if (values[`z${pad(k)}`]) z |= 1n << BigInt(k);
+  }
+  return z;
+}
