\"\\\\d+\"'$/.test(w);\nconst isY = (w: string) => /''^y'\"\\\\d+\"'$/.test(w);\nconst isZ = (w: string) => /''^z'\"\\\\d+\"'$/.test(w);\n\ninterface GateLike {\n  op: Gate['\"'op'];\n  in1: string;\n  in2: string;\n}\n\n/**\n * Given the producer gates of two wires, decide which is the \\\"full adder\\\"\n * gate: \"'`partial XOR carry` or `generate OR propagate` — one that consumes\n * either another full-adder signal (recursively) or a partial/gate signal.\n * Used to resolve which of two candidates is the carry and which is the\n * partial sum, without any simulation.\n */\nfunction fullAdderScore(\n  gl: GateLike | undefined,\n  producer: Map<string, GateLike>,\n  depth: number,\n): number {\n  if (!gl || depth <= 0) return 0;\n  let score = 0;\n  for (const input of [gl.in1, gl.in2]) {\n    const child = producer.get(input);\n    if (!child) continue; // raw x/y inputs contribute nothing\n    if (child.op === '\"'XOR' && isX(child.in1) && isY(child.in1)) {\n      // A \\\"partial\\\" signal consumed with an unknown sibling: this gate is\n      // the second half-add of a fresh bit, not a full adder.\n      score -= 1;\n    } else if (child.op === 'AND' && isX(child.in1) && isY(child.in1)) {\n      score += 1; // generate signal -> we are likely the carry OR\n    } else if (child.op === gl.op && fullAdderScore(child, producer, depth - 1) > 0) {\n      score += 2; // consumes a previous full-adder signal -> strong evidence\n    }\n  }\n  return score;\n}\n\n/**\n * Find the 8 wires involved in the 4 swapped output pairs.\n *\n * Strategy: never simulate. Walk the adder structurally from bit 0 upward\n * exactly like a correct ripple-carry adder, and at every point where the\n * circuit disagrees with the expected shape, the disagreement identifies the\n * two wires whose outputs were exchanged. Correct the model in memory and\n * keep going — each swap is caught when the walk first reaches it, so this\n * runs in O(gates) time regardless of circuit size.\n */\ne