+import { it } from 'vitest';
+import { findSwappedWires, simulate, type Gate } from '/workspace/src/index.js';
+const pad = (n: number) => String(n).padStart(2, '0');
+function buildAdder(bits: number): Gate[] {
+  const gates: Gate[] = [];
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+  for (let k = 1; k < bits; k++) {
+    gates.push({ op: 'XOR', in1: `x${pad(k)}`, in2: `y${pad(k)}`, out: `t${pad(k)}` });
+    gates.push({ op: 'XOR', in1: `t${pad(k)}`, in2: `c${pad(k-1)}`, out: `z${pad(k)}` });
+    gates.push({ op: 'AND', in1: `x${pad(k)}`, in2: `y${pad(k)}`, out: `a${pad(k)}` });
+    gates.push({ op: 'AND', in1: `t${pad(k)}`, in2: `c${pad(k-1)}`, out: `b${pad(k)}` });
+    gates.push({ op: 'OR', in1: `a${pad(k)}`, in2: `b${pad(k)}`, out: `c${pad(k)}` });
+  }
+  const last = gates.findIndex((g) => g.out === `c${pad(bits-1)}`);
+  gates[last] = { ...gates[last], out: `z${pad(bits)}` };
+  return gates;
+}
+function swapOutputs(gates: Gate[], a: string, b: string): Gate[] {
+  const r = gates.map((g) => ({ ...g }));
+  const ga = r.find((g) => g.out === a)!; const gb = r.find((g) => g.out === b)!;
+  [ga.out, gb.out] = [gb.out, ga.out]; return r;
+}
+function correct(gates: Gate[], bits: number): boolean {
+  const lim = 1 << bits;
+  for (let x = 0; x < lim; x++) for (let y = 0; y < lim; y++) {
+    const inp: Record<string, number> = {};
+    for (let k = 0; k < bits; k++) { inp[`x${pad(k)}`] = (x>>k)&1; inp[`y${pad(k)}`] = (y>>k)&1; }
+    const v = simulate(gates, inp);
+    let z = 0; for (let k = 0; k <= bits; k++) if (v[`z${pad(k)}`]) z |= 1<<k;
+    if (z !== x+y) return false;
+  }
+  return true;
+}
+it('survey single swaps', () => {
+  const gates = buildAdder(4);
+  const wires = gates.map((g) => g.out);
+  const misses: string[] = [];
+  const wrong: string[] = [];
+  for (let i = 0; i < wires.length; i++) for (let j = i+1; j < wires.length; j++) {
+    const sw = swapOutputs(gates, wires[i], wires[j]);
+    const found = findSwappedWires(sw);
+    const expected = [wires[i], wires[j]].sort().join(',');
+    const ok = found.join(',') === expected;
+    if (!ok) {
+      const invis = correct(sw, 4);
+      (invis ? misses : wrong).push(`${wires[i]}<->${wires[j]} (found:${found.join(',') || 'none'})${invis ? ' [INVISIBLE]' : ' [VISIBLE-but-wrong]'}`);
+    }
+  }
+  console.log('total pairs:', wires.length*(wires.length-1)/2);
+  console.log('INVISIBLE (skip-ok):', misses.length);
+  console.log('VISIBLE-BUT-WRONG (real bugs):', wrong.length);
+  for (const w of wrong.slice(0, 30)) console.log('  ', w);
+});
