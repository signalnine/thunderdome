1 : 0;\n\n  let carry: string | null = null; // wire holding the carry into this bit\n\n  for (let bit = 0; bit < numBits; bit++) {\n    const xx = \"'`x${String(bit).padStart(2, '\"'0')}\"'`;\n    const yy = `y${String(bit).padStart(2, '\"'0')}\"'`;\n\n    if (bit === 0) {\n      // Half adder: XOR(x00,y00) -> z00, AND(x00,y00) -> carry.\n      expectGate(zz(0), '\"'XOR', xx, yy);\n      const and0 = findGate('AND', xx, yy);\n      carry = and0 ? currentOut.get(and0)\"'! : null;\n      continue;\n    }\n\n    const xor1 = findGate('\"'XOR', xx, yy);\n    const and1 = findGate('AND', xx, yy);\n    if (\"'!xor1 || !and1 || carry === null) break;\n\n    let partial = currentOut.get(xor1)!;\n    let generate = currentOut.get(and1)!;\n\n    // --- Twin pair: follow the carry'\"'s consumers ---\n    const anchor = consumersOf(carry).find(\n      (g) =>\n        \"'!isXyGate(g) &&\n        (g.op === '\"'XOR' || g.op === 'AND') &&\n        findGate(g.op === 'XOR' ? 'AND' : 'XOR', g.in1, g.in2),\n    );\n    if (\"'!anchor) break; // carry has no full-adder consumer: non-canonical\n    let twinXor = anchor.op === '\"'XOR' ? anchor : findGate('XOR', anchor.in1, anchor.in2)\"'!;\n    let twinAnd = anchor.op === '\"'AND' ? anchor : findGate('AND', anchor.in1, anchor.in2)\"'!;\n    let other = anchor.in1 === carry ? anchor.in2 : anchor.in1;\n\n    // --- The other twin input must be this bit'\"'s intended partial ---\n    if (other \"'!== partial) {\n      const intendedProducer = producer.get(other);\n      if (intendedProducer === and1) {\n        // and1 outputs the partial name: generate<->partial swap.\n        repairSwap(partial, other);\n        partial = other;\n        generate = currentOut.get(and1)!;\n      } else if (intendedProducer && isXyGate(intendedProducer) && gateBit(intendedProducer) > bit) {\n        // The intended partial name is a future bit'\"'s partial: cross-bit\n        // partial swap (the whole twin pair moved to the future names).\n        repairSwap(partial, other);\n        partial = other;\n      } else {\n        // partial<->carry-in swap: the twins live on the swapped names and\n        // \"'`carry` is actually the intended partial name (produced by xor1).\n        const carryProducer = producer.get(carry);\n        if (carryProducer === xor1) {\n          repairSwap(carry, partial);\n          carry = partial;\n          partial = currentOut.get(xor1)!;\n          other = partial;\n          twinXor = findGate('\"'XOR', partial, carry) ?? twinXor;\n          twinAnd = findGate('AND', partial, carry) ?? twinAnd;\n        } else {\n          // Unknown shape; repair the most likely pair and move on.\n          repairSwap(partial, other);\n          partial = other;\n        }\n      }\n    }\n\n    // --- Sum bit: the twin XOR must drive z_k ---\n    expectOutput(zz(bit), twinXor);\n\n    // --- Carry out: OR(generate, propagate) ---\n    let propagate = currentOut.get(twinAnd)\"'!;\n    let or1 = findGate('\"'OR', generate, propagate);\n    if (\"'!or1) {\n      const byGen = gates.find(\n        (g) => g.op === '\"'OR' && (g.in1 === generate || g.in2 === generate),\n      );\n      if (byGen) {\n        const intendedProp = byGen.in1 === generate ? byGen.in2 : byGen.in1;\n        repairSwap(propagate, intendedProp);\n        propagate = intendedProp;\n        or1 = byGen;\n      } else {\n        const byProp = gates.find(\n          (g) => g.op === 'OR' && (g.in1 === propagate || g.in2 === propagate),\n        );\n        if (\"'!byProp) break;\n        const intendedGen = byProp.in1 === propagate ? byProp.in2 : byProp.in1;\n        repairSwap(generate, intendedGen);\n        generate = intendedGen;\n        or1 = byProp;\n      }\n    }\n\n    // --- Carry validation: the carry must feed the next bit'\"'s twins ---\n    carry = currentOut.get(or1)\"'!;\n    if (bit < numBits - 1) {\n      const nextAnchor = consumersOf(carry).find(\n        (g) =>\n          !isXyGate(g) &&\n          (g.op === '\"