+{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/tests/circuit.test.ts << 'EOF'\nimport { describe, expect, it } from 'vitest';\nimport { findSwappedWires, simulate, type Gate } from '../src/index.js';\n\n/* ------------------------------------------------------------------ */\n/* Helpers                                                             */\n/* ------------------------------------------------------------------ */\n\nconst pad = (n: number) => String(n).padStart(2, '0');\n\n/** Build the canonical ripple-carry adder for \"'`bits` input bits. */\nfunction buildAdder(bits: number): Gate[] {\n  const gates: Gate[] = [];\n  gates.push({ op: '\"'XOR', in1: 'x00', in2: 'y00', out: 'z00' });\n  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });\n  for (let k = 1; k < bits; k++) {\n    const xx = \"'`x${pad(k)}`;\n    const yy = `y${pad(k)}`;\n    const t = `t${pad(k)}`;\n    const a = `a${pad(k)}`;\n    const b = `b${pad(k)}`;\n    const cPrev = `c${pad(k - 1)}`;\n    const c = `c${pad(k)}`;\n    const z = `z${pad(k)}`;\n    gates.push({ op: '\"'XOR', in1: xx, in2: yy, out: t });\n    gates.push({ op: 'XOR', in1: t, in2: cPrev, out: z });\n    gates.push({ op: 'AND', in1: xx, in2: yy, out: a });\n    gates.push({ op: 'AND', in1: t, in2: cPrev, out: b });\n    gates.push({ op: 'OR', in1: a, in2: b, out: c });\n  }\n  gates.push({ op: 'BUF', in1: \"'`c${pad(bits - 1)}`, in2: `c${pad(bits - 1)}`, out: '\"'' } as never);\n  gates.pop();\n  // Final carry becomes the MSB of Z; model it by renaming the last carry.\n  const lastCarry = gates.findIndex((g) => g.out === \"'`c${pad(bits - 1)}`);\n  gates[lastCarry] = { ...gates[lastCarry], out: `z${pad(bits)}` };\n  return gates;\n}\n\n/** Deterministic PRNG (mulberry32). */\nfunction rng(seed: number) {\n  let s = seed >>> 0;\n  return () => {\n    s = (s + 0x6d2b79f5) >>> 0;\n    let t = s;\n    t = Math.imul(t ''^ (t >>> 15), t | 1);\n    t ''^= t + Math.imul(t ''^ (t >>> 7), t | 61);\n    return ((t ''^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\n/** Swap the `out` fields of two gates (the swap operation being debugged). */\nfunction swapOutputs(gates: Gate[], wireA: string, wireB: string): Gate[] {\n  const result = gates.map((g) => ({ ...g }));\n  const a = result.find((g) => g.out === wireA);\n  const b = result.find((g) => g.out === wireB);\n  if (!a || !b) throw new Error(`cannot swap ${wireA} <-> ${wireB}`);\n  [a.out, b.out] = [b.out, a.out];\n  return result;\n}\n\nfunction randomDistinct<T>(items: T[], count: number, rand: () => number): T[] {\n  const pool = [...items];\n  const picked: T[] = [];\n  for (let i = 0; i < count; i++) {\n    picked.push(pool.splice(Math.floor(rand() * pool.length), 1)[0]);\n  }\n  return picked;\n}\n\nfunction inputsFor(bits: number, x: bigint, y: bigint): Record<string, number> {\n  const inputs: Record<string, number> = {};\n  for (let k = 0; k < bits; k++) {\n    inputs[`x${pad(k)}`] = Number((x >> BigInt(k)) & 1n);\n    inputs[`y${pad(k)}`] = Number((y >> BigInt(k)) & 1n);\n  }\n  return inputs;\n}\n\nfunction zValue(values: Record<string, number>, bits: number): bigint {\n  let z = 0n;\n  for (let k = 0; k <= bits; k++) {\n    if (values[`z${pad(k)}`]) z |= 1n << BigInt(k);\n  }\n  return z;\n}\n\n/* ------------------------------------------------------------------ */\n/* simulate                                                            */\n/* ------------------------------------------------------------------ */\n\ndescribe('\"'simulate', () => {\n  it('evaluates individual gate operations', () => {\n    const ops: Array<[Gate['op'], number, number, number]> = [\n      ['AND', 0, 0, 0],\n      ['AND', 1, 0, 0],\n      ['AND', 1, 1, 1],\n      ['OR', 0, 0, 0],\n      ['OR', 1, 0, 1],\n      ['OR', 0, 1, 1],\n      ['XOR', 0, 0, 0],\n      ['XOR', 1, 0, 1],\n      ['XOR', 1, 1, 0],\n    ];\n    for (const [op, a, b, expected] of ops) {\n      const out = simulate([{ op, in1: 'p', in2: 'q', out: 'r' }], { p: a, q: b });\n      expect(out.r).toBe(expected);\n    }\n  });\n\n  it('resolves dependencies regardless of gate order', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'mid', in2: 'b', out: 'out' },\n      { op: 'OR', in1: 'a', in2: 'b', out: 'mid' },\n    ];\n    expect(simulate(gates, { a: 0, b: 1 })).toEqual({ a: 0, b: 1, mid: 1, out: 1 });\n  });\n\n  it('computes X + Y = Z on the canonical 4-bit adder', () => {\n    const gates = buildAdder(4);\n    for (let x = 0; x < 16; x++) {\n      for (let y = 0; y < 16; y++) {\n        const values = simulate(gates, inputsFor(4, BigInt(x), BigInt(y)));\n        expect(zValue(values, 4)).toBe(BigInt(x + y));\n      }\n    }\n  });\n\n  it('computes X + Y = Z on a 45-bit adder', () => {\n    const gates = buildAdder(45);\n    const cases: Array<[bigint, bigint]> = [\n      [0n, 0n],\n      [1n, 1n],\n      [(1n << 44n) - 1n, 1n],\n      [(1n << 44n) - 1n, (1n << 44n) - 1n],\n      [0x123456789abcn, 0x0fedcba98765n],\n    ];\n    for (const [x, y] of cases) {\n      const values = simulate(gates, inputsFor(45, x, y));\n      expect(zValue(values, 45)).toBe(x + y);\n    }\n  });\n\n  it('keeps extra input values in the output', () => {\n    const values = simulate([], { spare: 1 });\n    expect(values).toEqual({ spare: 1 });\n  });\n});\n\n/* ------------------------------------------------------------------ */\n/* findSwappedWires                                                    */\n/* ------------------------------------------------------------------ */\n\ndescribe('findSwappedWires', () => {\n  it('returns an empty array for a correct adder', () => {\n    expect(findSwappedWires(buildAdder(4))).toEqual([]);\n    expect(findSwappedWires(buildAdder(45))).toEqual([]);\n  });\n\n  it('finds a z01 <-> a01 style swap (z wire with internal wire)', () => {\n    const swapped = swapOutputs(buildAdder(4), 'z01', 'a01');\n    expect(findSwappedWires(swapped)).toE