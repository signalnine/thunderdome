'spam',\n    });\n    reviews.flagReview(review.id);\n    const flagged = reviews.getFlaggedReviews();\n    expect(flagged).toHaveLength(1);\n    expect(flagged[0].flagged).toBe(true);\n  });\n\n  it('getFlaggedReviews returns only flagged', () => {\n    const r1 = reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u1', rating: 1, comment: 'bad' });\n    reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u2', rating: 5, comment: 'good' });\n    reviews.flagReview(r1.id);\n    const flagged = reviews.getFlaggedReviews();\n    expect(flagged).toHaveLength(1);\n    expect(flagged[0].id).toBe(r1.id);\n  });\n\n  it('removeReview deletes review', () => {\n    const review = reviews.addReview({\n      pluginName: 'p',\n      pluginVersion: '1.0.0',\n      userId: 'u1',\n      rating: 3,\n      comment: 'meh',\n    });\n    expect(reviews.removeReview(review.id)).toBe(true);\n    expect(reviews.getReviews('p')).toHaveLength(0);\n  });\n\n  it('getReviewsByUser returns user reviews', () => {\n    reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'alice', rating: 5, comment: 'love it' });\n    reviews.addReview({ pluginName: 'p2', pluginVersion: '1.0.0', userId: 'alice', rating: 4, comment: 'nice' });\n    reviews.addReview({ pluginName: 'p1', pluginVersion: '1.0.0', userId: 'bob', rating: 3, comment: 'ok' });\n    const aliceReviews = reviews.getReviewsByUser('alice');\n    expect(aliceReviews).toHaveLength(2);\n    aliceReviews.forEach(r => expect(r.userId).toBe('alice'));\n  });\n\n  it('getReviewCount returns correct count', () => {\n    reviews.addReview({ pluginName: 'counter', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'a' });\n    reviews.addReview({ pluginName: 'counter', pluginVersion: '1.0.0', userId: 'u2', rating: 4, comment: 'b' });\n    reviews.addReview({ pluginName: 'counter', pluginVersion: '1.1.0', userId: 'u3', rating: 3, comment: 'c' });\n    expect(reviews.getReviewCount('counter')).toBe(3);\n  });\n});\nimport { describe, it, expect } from 'vitest';\nimport { createDepsService } from '../src/deps/index.js';\nimport { createRegistry } from '../src/registry/index.js';\nimport type { PluginManifest } from '../src/types.js';\n\nfunction makeManifest(name: string, deps: Record<string, string> = {}): PluginManifest {\n  return {\n    name,\n    version: '1.0.0',\n    description: `Plugin ${name}`,\n    author: 'tester',\n    dependencies: deps,\n    entryPoint: 'return true;',\n    permissions: [],\n  };\n}\n\ndescribe('Dependency Graph', () => {\n  const depsService = createDepsService();\n\n  it('buildTree creates correct dependency tree', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('A', { B: '^1.0.0' }));\n    registry.register(makeManifest('B', { C: '^1.0.0' }));\n    registry.register(makeManifest('C'));\n\n    const tree = depsService.buildTree('A', registry);\n    expect(tree.name).toBe('A');\n    expect(tree.dependencies).toHaveLength(1);\n    expect(tree.dependencies[0].name).toBe('B');\n    expect(tree.dependencies[0].dependencies).toHaveLength(1);\n    expect(tree.dependencies[0].dependencies[0].name).toBe('C');\n  });\n\n  it('detectCycles finds circular dependencies', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('X', { Y: '^1.0.0' }));\n    registry.register(makeManifest('Y', { X: '^1.0.0' }));\n\n    const cycles = depsService.detectCycles('X', registry);\n    expect(cycles).not.toBeNull();\n    expect(cycles!.length).toBeGreaterThan(0);\n    // The cycle should contain both X and Y\n    const flatCycle = cycles!.flat();\n    expect(flatCycle).toContain('X');\n    expect(flatCycle).toContain('Y');\n  });\n\n  it('detectCycles returns null for no cycles', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('A', { B: '^1.0.0' }));\n    registry.register(makeManifest('B'));\n\n    const cycles = depsService.detectCycles('A', registry);\n    expect(cycles).toBeNull();\n  });\n\n  it('topologicalSort returns correct order', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('A', { B: '^1.0.0', C: '^1.0.0' }));\n    registry.register(makeManifest('B', { C: '^1.0.0' }));\n    registry.register(makeManifest('C'));\n\n    const sorted = depsService.topologicalSort('A', registry);\n    expect(sorted.indexOf('C')).toBeLessThan(sorted.indexOf('B'));\n    expect(sorted.indexOf('B')).toBeLessThan(sorted.indexOf('A'));\n  });\n\n  it('flattenDependencies returns all transitive deps', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('root', { mid: '^1.0.0' }));\n    registry.register(makeManifest('mid', { leaf: '^1.0.0' }));\n    registry.register(makeManifest('leaf'));\n\n    const deps = depsService.flattenDependencies('root', registry);\n    expect(deps).toContain('mid');\n    expect(deps).toContain('leaf');\n    expect(deps).not.toContain('root');\n  });\n\n  it('hasCircularDependency returns true for cycles', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('A', { B: '^1.0.0' }));\n    registry.register(makeManifest('B', { A: '^1.0.0' }));\n\n    expect(depsService.hasCircularDependency('A', registry)).toBe(true);\n  });\n\n  it('hasCircularDependency returns false for acyclic', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('A', { B: '^1.0.0' }));\n    registry.register(makeManifest('B'));\n\n    expect(depsService.hasCircularDependency('A', registry)).toBe(false);\n  });\n\n  it('topologicalSort handles diamond dependencies', () => {\n    const registry = createRegistry();\n    // A -> B, A -> C, B -> D, C -> D (diamond)\n    registry.register(makeManifest('A', { B: '^1.0.0', C: '^1.0.0' }));\n    registry.register(makeManifest('B', { D: '^1.0.0' }));\n    registry.register(makeManifest('C', { D: '^1.0.0' }));\n    registry.register(makeManifest('D'));\n\n    const sorted = depsService.topologicalSort('A', registry);\n    expect(sorted).toHaveLength(4);\n    // D must come before B and C, and A must be last\n    expect(sorted.indexOf('D')).toBeLessThan(sorted.indexOf('B'));\n    expect(sorted.indexOf('D')).toBeLessThan(sorted.indexOf('C'));\n    expect(sorted.indexOf('A')).toBe(sorted.length - 1);\n  });\n});\n","exit_code":0,"status":"completed"}}
