@@ -0,0 +1,103 @@
+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+const MAX_TREE_DEPTH = 64;
+
+function dependencyNames(name: string, registry: RegistryService): string[] {
+  const manifest = registry.get(name);
+  if (!manifest) {
+    return [];
+  }
+  return Object.keys(manifest.dependencies);
+}
+
+export function createDepsService(): DepsService {
+  function buildTreeNode(
+    name: string,
+    registry: RegistryService,
+    visiting: ReadonlySet<string>,
+    depth: number
+  ): DependencyNode {
+    const manifest = registry.get(name);
+    const node: DependencyNode = {
+      name,
+      version: manifest?.version ?? '',
+      dependencies: [],
+    };
+    if (!manifest || depth >= MAX_TREE_DEPTH || visiting.has(name)) {
+      return node;
+    }
+    const nextVisiting = new Set(visiting);
+    nextVisiting.add(name);
+    node.dependencies = Object.keys(manifest.dependencies).map((depName) =>
+      buildTreeNode(depName, registry, nextVisiting, depth + 1)
+    );
+    return node;
+  }
+
+  function findCycles(name: string, registry: RegistryService): string[][] {
+    const cycles: string[][] = [];
+    const state = new Map<string, 'visiting' | 'done'>();
+    const path: string[] = [];
+
+    function visit(current: string): void {
+      state.set(current, 'visiting');
+      path.push(current);
+      for (const dep of dependencyNames(current, registry)) {
+        const depState = state.get(dep);
+        if (depState === 'visiting') {
+          const startIndex = path.indexOf(dep);
+          cycles.push([...path.slice(startIndex), dep]);
+        } else if (depState !== 'done') {
+          visit(dep);
+        }
+      }
+      path.pop();
+      state.set(current, 'done');
+    }
+
+    visit(name);
+    return cycles;
+  }
+
+  function collectPostOrder(name: string, registry: RegistryService): string[] {
+    const visited = new Set<string>();
+    const order: string[] = [];
+
+    function visit(current: string): void {
+      if (visited.has(current)) {
+        return;
+      }
+      visited.add(current);
+      for (const dep of dependencyNames(current, registry)) {
+        visit(dep);
+      }
+      order.push(current);
+    }
+
+    visit(name);
+    return order;
+  }
+
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      return buildTreeNode(name, registry, new Set(), 0);
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const cycles = findCycles(name, registry);
+      return cycles.length > 0 ? cycles : null;
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      return collectPostOrder(name, registry);
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      return collectPostOrder(name, registry).filter((entry) => entry !== name);
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return findCycles(name, registry).length > 0;
+    },
+  };
+}
