+{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /workspace/src && cat > /workspace/src/registry/index.ts << 'EOF'\nimport Database from 'better-sqlite3';\nimport type { PluginManifest, RegistryService } from '../types.js';\n\ninterface PluginRow {\n  name: string;\n  version: string;\n  data: string;\n}\n\nfunction rowToManifest(row: PluginRow): PluginManifest {\n  return JSON.parse(row.data) as PluginManifest;\n}\n\nexport function createRegistry(dbPath: string = ':memory:'): RegistryService {\n  const db = new Database(dbPath);\n  db.pragma('journal_mode = WAL');\n  db.exec(\"'`\n    CREATE TABLE IF NOT EXISTS plugins (\n      name TEXT NOT NULL,\n      version TEXT NOT NULL,\n      data TEXT NOT NULL,\n      PRIMARY KEY (name, version)\n    )\n  `);\n\n  const insertStmt = db.prepare(\n    '\"'INSERT OR REPLACE INTO plugins (name, version, data) VALUES (?, ?, ?)'\n  );\n  const selectLatestStmt = db.prepare(\n    'SELECT * FROM plugins WHERE name = ? ORDER BY rowid DESC LIMIT 1'\n  );\n  const selectVersionStmt = db.prepare(\n    'SELECT * FROM plugins WHERE name = ? AND version = ?'\n  );\n  const selectAllStmt = db.prepare('SELECT * FROM plugins');\n  const searchStmt = db.prepare(\n    'SELECT * FROM plugins WHERE name LIKE ? OR data LIKE ?'\n  );\n  const deleteStmt = db.prepare(\n    'DELETE FROM plugins WHERE name = ? AND version = ?'\n  );\n  const versionsStmt = db.prepare(\n    'SELECT version FROM plugins WHERE name = ?'\n  );\n\n  return {\n    register(manifest: PluginManifest): void {\n      insertStmt.run(manifest.name, manifest.version, JSON.stringify(manifest));\n    },\n\n    get(name: string): PluginManifest | null {\n      const row = selectLatestStmt.get(name) as PluginRow | undefined;\n      return row ? rowToManifest(row) : null;\n    },\n\n    getVersion(name: string, version: string): PluginManifest | null {\n      const row = selectVersionStmt.get(name, version) as PluginRow | 