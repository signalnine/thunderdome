+++ b/src/runner/index.ts
@@ -0,0 +1,51 @@
+import vm from 'node:vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 1000;
+
+export function createRunner(): RunnerService {
+  async function run(
+    code: string,
+    timeoutMs: number,
+    context?: Record<string, unknown>
+  ): Promise<SandboxResult> {
+    const start = process.hrtime.bigint();
+    const sandbox: Record<string, unknown> = { ...(context ?? {}) };
+    const vmContext = vm.createContext(sandbox);
+
+    try {
+      const script = new vm.Script(`(function () {\n${code}\n})()`);
+      const output = script.runInContext(vmContext, { timeout: timeoutMs });
+      const duration = Number(process.hrtime.bigint() - start) / 1e6;
+      return {
+        success: true,
+        output,
+        duration,
+        memoryUsed: process.memoryUsage().heapUsed,
+      };
+    } catch (err) {
+      const duration = Number(process.hrtime.bigint() - start) / 1e6;
+      return {
+        success: false,
+        output: undefined,
+        duration,
+        memoryUsed: process.memoryUsage().heapUsed,
+        error: err instanceof Error ? err.message : String(err),
+      };
+    }
+  }
+
+  return {
+    execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult> {
+      return run(code, DEFAULT_TIMEOUT_MS, context);
+    },
+
+    executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context?: Record<string, unknown>
+    ): Promise<SandboxResult> {
+      return run(code, timeoutMs, context);
+    },
+  };
+}
