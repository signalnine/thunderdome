expect(resolver.validRange('not-a-range')).toBe(false);\n    expect(resolver.validRange('abc.def.ghi')).toBe(false);\n  });\n\n  it('resolve handles multiple plugins with dependencies', () => {\n    const constraints = [\n      { name: 'core', range: '^1.0.0' },\n      { name: 'utils', range: '^2.0.0' },\n      { name: 'logger', range: '>=1.5.0' },\n    ];\n    const available = {\n      core: ['1.0.0', '1.3.0', '2.0.0'],\n      utils: ['2.0.0', '2.1.0', '3.0.0'],\n      logger: ['1.0.0', '1.5.0', '1.9.0', '2.0.0'],\n    };\n    const result = resolver.resolve(constraints, available);\n    expect(result).toHaveLength(3);\n    expect(result.find(r => r.name === 'core')!.version).toBe('1.3.0');\n    expect(result.find(r => r.name === 'utils')!.version).toBe('2.1.0');\n    expect(result.find(r => r.name === 'logger')!.version).toBe('2.0.0');\n  });\n});\nimport { describe, it, expect } from 'vitest';\nimport { createRunner } from '../src/runner/index.js';\n\ndescribe('Sandboxed Runner', () => {\n  const runner = createRunner();\n\n  it('execute runs simple code and returns result', async () => {\n    const result = await runner.execute('return 2 + 3;');\n    expect(result.success).toBe(true);\n    expect(result.output).toBe(5);\n  });\n\n  it('execute provides context variables', async () => {\n    const result = await runner.execute('return x * y;', { x: 6, y: 7 });\n    expect(result.success).toBe(true);\n    expect(result.output).toBe(42);\n  });\n\n  it('executeWithTimeout kills long-running code', async () => {\n    const result = await runner.executeWithTimeout('while(true) {}', 100);\n    expect(result.success).toBe(false);\n    expect(result.error).toBeDefined();\n  });\n\n  it('execute captures output in result', async () => {\n    const result = await runner.execute('return { message: \"hello\" };');\n    expect(result.success).toBe(true);\n    expect(result.output).toEqual({ message: 'hello' });\n  });\n\n  it('execute reports duration', async () => {\n    const result = await runner.execute('return 1;');\n    expect(result.duration).toBeGreaterThanOrEqual(0);\n    expect(typeof result.duration).toBe('number');\n  });\n\n  it('execute catches runtime errors', async () => {\n    const result = await runner.execute('throw new Error(\"boom\");');\n    expect(result.success).toBe(false);\n    expect(result.error).toContain('boom');\n  });\n\n  it('execute isolates between runs (no shared state)', async () => {\n    await runner.execute('var leaked = 42;');\n    const result = await runner.execute('return typeof leaked;');\n    expect(result.success).toBe(true);\n    expect(result.output).toBe('undefined');\n  });\n\n  it('executeWithTimeout returns error on timeout', async () => {\n    const result = await runner.executeWithTimeout(\n      'var i = 0; while(true) { i++; }',\n      50\n    );\n    expect(result.success).toBe(false);\n    expect(result.error).toBeDefined();\n    expect(result.duration).toBeGreaterThan(0);\n  });\n});\n","exit_code":0,"status":"completed"}}
