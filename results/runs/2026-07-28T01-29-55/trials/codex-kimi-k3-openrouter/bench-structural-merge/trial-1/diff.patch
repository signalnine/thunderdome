+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function diffValues(base: unknown, changed: unknown): Delta {
+  if (deepEqual(base, changed)) return { kind: 'noop' };
+  if (isPlainObject(base) && isPlainObject(changed)) {
+    const fields = new Map<string, Delta>();
+    for (const key of Object.keys(changed)) {
+      const sub: Delta = Object.prototype.hasOwnProperty.call(base, key)
+        ? diffValues(base[key], changed[key])
+        : { kind: 'value', value: deepClone(changed[key]) };
+      if (sub.kind !== 'noop') fields.set(key, sub);
+    }
+    for (const key of Object.keys(base)) {
+      if (!Object.prototype.hasOwnProperty.call(changed, key)) {
+        fields.set(key, { kind: 'remove' });
+      }
+    }
+    return fields.size === 0 ? { kind: 'noop' } : { kind: 'object', fields };
+  }
+  return { kind: 'value', value: deepClone(changed) };
+}
+
+function applyDelta(base: unknown, delta: Delta): unknown {
+  switch (delta.kind) {
+    case 'noop':
+      return deepClone(base);
+    case 'value':
+      return delta.value === DELETE ? DELETE : deepClone(delta.value);
+    case 'remove':
+      return DELETE;
+    case 'object': {
