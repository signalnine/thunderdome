esult = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(store.get('doc1')).toEqual({ meta: { a: 2, b: 2 } });\n  });\n\n  it('handles add/remove field merges without conflicts', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { a: 1, b: 2 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 1 });\n    store.switchBranch('main');\n    store.update('doc1', { a: 1, b: 2, c: 3 });\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(store.get('doc1')).toEqual({ a: 1, c: 3 });\n  });\n\n  it('conflicts when one side removes a field the other changes', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { a: 1, b: 2 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 1 });\n    store.switchBranch('main');\n    store.update('doc1', { a: 1, b: 5 });\n    const result = store.merge('feature');\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toEqual([\n      { documentId: 'doc1', path: 'b', base: 2, ours: 5, theirs: undefined },\n    ]);\n    expect(store.get('doc1')).toEqual({ a: 1, b: 5 });\n  });\n\n  it('is a no-op when nothing changed on either side', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n    expect(result.merged['doc1']).toEqual({ a: 1 });\n    expect(store.getHistory('doc1')).toHaveLength(1);\n  });\n\n  it('merging back a branch with no new changes does not add versions', () => {\n    const store = new DocumentStore();\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('main');\n    store.update('doc1', { a: 2 });\n    const result = store.merge('feature');\n    expect(