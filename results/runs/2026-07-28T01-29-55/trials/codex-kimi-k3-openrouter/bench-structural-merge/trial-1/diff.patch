+    sourceName: string,
+  ): Map<string, Record<string, unknown> | null> {
+    const base = new Map<string, Record<string, unknown> | null>();
+    const oursBranch = this.branches.get(ourName)!;
+    const theirsBranch = this.branches.get(sourceName)!;
+    const docIds = new Set<string>([...oursBranch.docs.keys(), ...theirsBranch.docs.keys()]);
+    for (const docId of docIds) {
+      const ourVersions = oursBranch.docs.get(docId)?.versions ?? [];
+      const theirVersions = theirsBranch.docs.get(docId)?.versions ?? [];
+      if (ourVersions.length === 0 || theirVersions.length === 0) {
+        base.set(docId, null);
+        continue;
+      }
+      // The common ancestor is the latest version whose id appears in both
+      // branches' histories. Shared ids arise from branching (copied history)
+      // and from clean merges (folded-in history).
+      const ourIds = new Set(ourVersions.map((entry) => entry.id));
+      let ancestor: VersionEntry | null = null;
+      for (let i = theirVersions.length - 1; i >= 0; i--) {
+        if (ourIds.has(theirVersions[i].id)) {
+          ancestor = theirVersions[i];
+          break;
+        }
+      }
+      base.set(docId, ancestor ? deepClone(ancestor.content) : null);
+    }
+    return base;
+  }
+
+  private nextVersionId(): string {
+    this.versionCounter += 1;
+    return `v${this.versionCounter}`;
+  }
+
+  private activeBranch(): BranchState {
+    const branch = this.branches.get(this.current);
+    if (!branch) throw new Error(`Branch "${this.current}" does not exist`);
+    return branch;
+  }
+
+  private liveDoc(branch: BranchState, id: string): DocEntry {
+    const doc = branch.docs.get(id);
+    if (!doc || !doc.alive) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    return doc;
+  }
+
+  private currentContentOf(doc: DocEntry): Record<string, unknown> {
+    const latest = doc.versions[doc.versions.length - 1];
+    return latest ? latest.content : {};
+  }
+}
+
+export function createDocumentStore(): DocumentStore {
+  return new DocumentStore();
+}
+
+export default DocumentStore;
