nguage-py\">x = 2</code></pre>',\n    });\n    const result = await plugin.hooks.transformContent!(file, makeCtx());\n    expect(result.content).toContain('data-language=\"js\"');\n    expect(result.content).toContain('data-language=\"py\"');\n  });\n\n  it('handles code block with no language specified', async () => {\n    const file = makeFile({\n      content: '<pre><code>plain code</code></pre>',\n    });\n    const result = await plugin.hooks.transformContent!(file, makeCtx());\n    // Should not add highlighted class or data-language to blocks without language\n    expect(result.content).toBe('<pre><code>plain code</code></pre>');\n    expect(result.content).not.toContain('highlighted');\n  });\n\n  it('adds highlighted class to processed blocks', async () => {\n    const file = makeFile({\n      content: '<pre><code class=\"language-rust\">fn main() {}</code></pre>',\n    });\n    const result = await plugin.hooks.transformContent!(file, makeCtx());\n    expect(result.content).toContain('highlighted');\n  });\n\n  it('preserves code block content', async () => {\n    const file = makeFile({\n      content: '<pre><code class=\"language-ts\">const x: number = 42;</code></pre>',\n    });\n    const result = await plugin.hooks.transformContent!(file, makeCtx());\n    expect(result.content).toContain('const x: number = 42;');\n  });\n\n  it('handles empty code blocks', async () => {\n    const file = makeFile({\n      content: '<pre><code class=\"language-js\"></code></pre>',\n    });\n    const result = await plugin.hooks.transformContent!(file, makeCtx());\n    expect(result.content).toContain('data-language=\"js\"');\n    expect(result.content).toContain('highlighted');\n  });\n\n  it('does not modify inline code', async () => {\n    const file = makeFile({\n      content: '<p>Use <code>console.log()</code> for debugging.</p>',\n    });\n    const result = await plugin.hooks.transformContent!(file, makeCtx());\n    expect(result.content).toBe('<p>Use <code>console.log()</code> for debugging.</p>');\n    expect(result.content).not.toContain('highlighted');\n  });\n});\nimport { describe, it, expect } from 'vitest';\nimport { createTaxonomyPlugin } from '../../src/plugins/taxonomy.js';\nimport { BuildContext, ContentFile, SiteConfig } from '../../src/core/types.js';\n\nconst testConfig: SiteConfig = {\n  title: 'Test Site',\n  baseUrl: 'https://example.com',\n  outputDir: './dist',\n  contentDir: './content',\n  templateDir: './templates',\n};\n\nfunction makeCtx(files: ContentFile[] = []): BuildContext {\n  return {\n    config: testConfig,\n    files,\n    output: new Map(),\n    assets: new Map(),\n    data: new Map(),\n  };\n}\n\nfunction makeFile(overrides: Partial<ContentFile> = {}): ContentFile {\n  return {\n    slug: 'test',\n    title: 'Test',\n    content: '<p>content</p>',\n    metadata: {},\n    ...overrides,\n  };\n}\n\ndescribe('taxonomy plugin', () => {\n  const plugin = createTaxonomyPlugin();\n\n  it('builds tag index from file tags', async () => {\n    const files = [\n      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['javascript', 'node'] }),\n      makeFile({ slug: 'post-2', title: 'Post 2', tags: ['javascript'] }),\n    ];\n    const ctx = makeCtx(files);\n    await plugin.hooks.beforeBuild!(ctx);\n    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n    expect(tagMap).toBeDefined();\n    expect(tagMap.get('javascript')).toHaveLength(2);\n    expect(tagMap.get('node')).toHaveLength(1);\n  });\n\n  it('generates tag listing pages in ctx.output', async () => {\n    const files = [\n      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['javascript'] }),\n    ];\n    const ctx = makeCtx(files);\n    await plugin.hooks.beforeBuild!(ctx);\n    await plugin.hooks.afterBuild!(ctx);\n    expect(ctx.output.has('tags/javascript.html')).toBe(true);\n    expect(ctx.output.get('tags/javascript.html')).toContain('Post 1');\n  });\n\n  it('handles files with no tags', async () => {\n    const files = [\n      makeFile({ slug: 'post-1', title: 'Post 1' }),\n    ];\n    const ctx = makeCtx(files);\n    await plugin.hooks.beforeBuild!(ctx);\n    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n    expect(tagMap.size).toBe(0);\n  });\n\n  it('handles files with multiple tags', async () => {\n    const files = [\n      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['js', 'node', 'web'] }),\n    ];\n    const ctx = makeCtx(files);\n    await plugin.hooks.beforeBuild!(ctx);\n    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n    expect(tagMap.size).toBe(3);\n    expect(tagMap.has('js')).toBe(true);\n    expect(tagMap.has('node')).toBe(true);\n    expect(tagMap.has('web')).toBe(true);\n  });\n\n  it('tag pages list all files with that tag', async () => {\n    const files = [\n      makeFile({ slug: 'post-1', title: 'First Post', tags: ['tech'] }),\n      makeFile({ slug: 'post-2', title: 'Second Post', tags: ['tech'] }),\n    ];\n    const ctx = makeCtx(files);\n    await plugin.hooks.beforeBuild!(ctx);\n    await plugin.hooks.afterBuild!(ctx);\n    const tagPage = ctx.output.get('tags/tech.html')!;\n    expect(tagPage).toContain('First Post');\n    expect(tagPage).toContain('Second Post');\n  });\n\n  it('stores tag map in ctx.data', async () => {\n    const files = [\n      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['alpha'] }),\n    ];\n    const ctx = makeCtx(files);\n    await plugin.hooks.beforeBuild!(ctx);\n    expect(ctx.data.has('taxonomy-tags')).toBe(true);\n  });\n\n  it('handles empty file list', async () => {\n    const ctx = makeCtx([]);\n    await plugin.hooks.beforeBuild!(ctx);\n    await plugin.hooks.afterBuild!(ctx);\n    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n    expect(tagMap.size).toBe(0);\n  });\n\n  it('tags are case-normalized to lowercase', async () => {\n    const files = [\n      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['JavaScript'] }),\n      makeFile({ slug: 'post-2', title: 'Post 2', tags: ['JAVASCRIPT'] }),\n    ];\n    const ctx = makeCtx(files);\n    await plugin.hooks.beforeBuild!(ctx);\n    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n    expect(tagMap.has('javascript')).toBe(true);\n    expect(tagMap.get('javascript')).toHaveLength(2);\n    expect(tagMap.has('JavaScript')).toBe(false);\n    expect(tagMap.has('JAVASCRIPT')).toBe(false);\n  });\n});\n","exit_code":0,"status":"completed"}}
