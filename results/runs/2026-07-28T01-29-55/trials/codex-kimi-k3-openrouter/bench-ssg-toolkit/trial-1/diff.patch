+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,42 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+const ASSET_ATTR_RE = /\b(src|href)="(\.\.?\/)([^"#?]+)([?#][^"]*)?"/g;
+
+function isSkippableUrl(url: string): boolean {
+  return (
+    url.startsWith('http://') ||
+    url.startsWith('https://') ||
+    url.startsWith('//') ||
+    url.startsWith('/') ||
+    url.startsWith('#') ||
+    url.startsWith('data:') ||
+    url.startsWith('mailto:')
+  );
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, ctx: BuildContext): ContentFile {
+        if (!file.content) return file;
+        const content = file.content.replace(
+          ASSET_ATTR_RE,
+          (match, attr: string, prefix: string, path: string, suffix: string | undefined) => {
+            const fullUrl = prefix + path + (suffix ?? '');
+            if (isSkippableUrl(fullUrl)) return match;
+            const manifest = (ctx.data.get('asset-manifest') as { assets: string[] } | undefined) ?? { assets: [] };
+            if (!manifest.assets.includes(path)) {
+              manifest.assets.push(path);
+            }
+            ctx.data.set('asset-manifest', manifest);
+            return `${attr}="/assets/${path}${suffix ?? ''}"`;
+          }
+        );
+        return { ...file, content };
+      },
+    },
+  };
+}
