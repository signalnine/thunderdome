@@ -0,0 +1,84 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+const ADMONITION_OPEN_RE = /^:::(note|warning|tip)\s*$/;
+
+function transformAdmonitions(content: string): string {
+  const lines = content.split('\n');
+  const out: string[] = [];
+  let inAdmonition = false;
+  for (const line of lines) {
+    if (!inAdmonition) {
+      const open = ADMONITION_OPEN_RE.exec(line);
+      if (open) {
+        out.push(`<div class="admonition admonition-${open[1]}">`);
+        inAdmonition = true;
+        continue;
+      }
+      out.push(line);
+    } else {
+      if (line.trim() === ':::') {
+        out.push('</div>');
+        inAdmonition = false;
+        continue;
+      }
+      out.push(line);
+    }
+  }
+  return out.join('\n');
+}
+
+interface FootnoteTransformResult {
+  html: string;
+  footnotes: Map<string, string>;
+}
+
+function transformFootnotes(content: string): FootnoteTransformResult {
+  const footnotes = new Map<string, string>();
+  const lines = content.split('\n');
+  const kept: string[] = [];
+  for (const line of lines) {
+    const match = /^\[\^([^\]]+)\]:\s*(.*)$/.exec(line);
+    if (match) {
+      footnotes.set(match[1], match[2]);
+    } else {
+      kept.push(line);
+    }
+  }
+  let html = marked.parse(kept.join('\n'), { async: false });
+  for (const id of footnotes.keys()) {
+    const ref = new RegExp(`\\[\\^${escapeRegex(id)}\\]`, 'g');
+    html = html.replace(ref, `<sup><a href="#fn-${id}">${id}</a></sup>`);
+  }
+  return { html, footnotes };
+}
+
+function escapeRegex(value: string): string {
+  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+}
+
+function renderFootnoteSection(footnotes: Map<string, string>): string {
+  if (footnotes.size === 0) return '';
+  const items = [...footnotes.entries()]
+    .map(([id, text]) => `<li id="fn-${id}">${text}</li>`)
+    .join('\n');
+  return `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile): ContentFile {
+        if (!file.content) {
+          return { ...file, content: '' };
+        }
+        const withAdmonitions = transformAdmonitions(file.content);
+        const { html, footnotes } = transformFootnotes(withAdmonitions);
+        return { ...file, content: html + renderFootnoteSection(footnotes) };
+      },
+    },
+  };
+}
