@@ -0,0 +1,72 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
+
+function toRfc822(date: string): string {
+  const parsed = new Date(date);
+  return Number.isNaN(parsed.getTime()) ? date : parsed.toUTCString();
+}
+
+function byDateDesc(a: ContentFile, b: ContentFile): number {
+  const aTime = a.date ? new Date(a.date).getTime() : 0;
+  const bTime = b.date ? new Date(b.date).getTime() : 0;
+  return bTime - aTime;
+}
+
+function renderItem(file: ContentFile, ctx: BuildContext, tagsBySlug: Map<string, string[]>): string {
+  const lines: string[] = [
+    '  <item>',
+    `    <title>${escapeXml(file.title)}</title>`,
+    `    <link>${ctx.config.baseUrl}/${file.slug}.html</link>`,
+  ];
+  if (file.date) {
+    lines.push(`    <pubDate>${toRfc822(file.date)}</pubDate>`);
+  }
+  for (const tag of tagsBySlug.get(file.slug) ?? []) {
+    lines.push(`    <category>${escapeXml(tag)}</category>`);
+  }
+  lines.push(`    <description><![CDATA[${file.content}]]></description>`);
+  lines.push('  </item>');
+  return lines.join('\n');
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+        const tagsBySlug = new Map<string, string[]>();
+        if (tagMap) {
+          for (const [tag, files] of tagMap) {
+            for (const file of files) {
+              const list = tagsBySlug.get(file.slug) ?? [];
+              if (!list.includes(tag)) list.push(tag);
+              tagsBySlug.set(file.slug, list);
+            }
+          }
+        }
+        const sorted = [...ctx.files].sort(byDateDesc);
+        const items = sorted.map((file) => renderItem(file, ctx, tagsBySlug)).join('\n');
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+<channel>
+  <title>${escapeXml(ctx.config.title)}</title>
+  <link>${ctx.config.baseUrl}</link>
+  <description>${escapeXml(ctx.config.title)}</description>
+${items}
+</channel>
+</rss>`;
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
