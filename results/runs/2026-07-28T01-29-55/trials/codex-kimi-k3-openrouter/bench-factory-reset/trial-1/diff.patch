+  }
+
+  const inv = modInverses(p);
+  const pivotCols: number[] = [];
+  let rank = 0;
+  for (let col = 0; col < m && rank < n; col++) {
+    let pivotRow = -1;
+    for (let r = rank; r < n; r++) {
+      if (mat[r][col] !== 0) {
+        pivotRow = r;
+        break;
+      }
+    }
+    if (pivotRow === -1) continue;
+    const swap = mat[rank];
+    mat[rank] = mat[pivotRow];
+    mat[pivotRow] = swap;
+    const scale = inv[mat[rank][col]];
+    for (let c = 0; c < width; c++) mat[rank][c] = (mat[rank][c] * scale) % p;
+    for (let r = 0; r < n; r++) {
+      if (r === rank) continue;
+      const factor = mat[r][col];
+      if (factor === 0) continue;
+      for (let c = 0; c < width; c++) {
+        let v = mat[r][c] - factor * mat[rank][c];
+        v %= p;
+        if (v < 0) v += p;
+        mat[r][c] = v === 0 ? 0 : v; // avoid -0
+      }
+    }
+    pivotCols.push(col);
+    rank++;
+  }
+  for (let r = rank; r < n; r++) {
+    if (mat[r][m] !== 0) return null;
+  }
+
+  const pivotOfCol = new Array<number>(m).fill(-1);
+  for (let r = 0; r < rank; r++) pivotOfCol[pivotCols[r]] = r;
+  const freeCols: number[] = [];
+  for (let c = 0; c < m; c++) {
+    if (pivotOfCol[c] === -1) freeCols.push(c);
+  }
+
+  const x0 = new Array<number>(m).fill(0);
+  for (let r = 0; r < rank; r++) x0[pivotCols[r]] = mat[r][m];
+  const basis = freeCols.map((f) => {
+    const v = new Array<number>(m).fill(0);
+    v[f] = 1;
+    for (let r = 0; r < rank; r++) v[pivotCols[r]] = mod(-mat[r][f], p);
+    return v;
+  });
+  const fCount = freeCols.length;
+  if (fCount === 0) return x0;
+
+  const thinned = thinBasis(basis, p);
+  if (powCap(p, fCount, ENUM_SPACE_LIMIT) <= ENUM_SPACE_LIMIT) {
+    return enumerateFree(x0, thinned, p);
+  }
+  // For prime moduli up to 97 and at most 40 free variables, any space too
+  // big to enumerate outright is searchable exactly by meet-in-the-middle
+  // over the button set: p^(M/2) stays within budget for p <= 13, and for
+  // p >= 17 the thinned null space is small enough that a pruned enumeration
+  // stays within its node budget (the minimum-weight solution is far below
+  // the average member of the affine space).
+  if (powCap(p, Math.ceil(m / 2), MITM_SUBSET_LIMIT) > MITM_SUBSET_LIMIT) {
+    const pruned = enumerateFreePruned(x0, thinned, p, PRUNE_NODE_LIMIT);
+    if (pruned !== null) return pruned;
+  }
+  return counterByMitm(buttons, moddedLights, p);
+}
+
+const ENUM_SPACE_LIMIT = 2_000_000;
+const MITM_SUBSET_LIMIT = 1_500_000;
+const PRUNE_NODE_LIMIT = 3_000_000;
+
+function assertValidIndices(buttons: number[][], size: number): void {
+  for (const btn of buttons) {
+    for (const l of btn) {
+      if (!Number.isInteger(l) || l < 0 || l >= size) {
+        throw new RangeError(`index ${l} out of range [0, ${size})`);
+      }
+    }
+  }
+}
+
+function mod(v: number, p: number): number {
+  const r = v % p;
+  if (r === 0) return 0; // normalize -0
+  return r < 0 ? r + p : r;
+}
+
+function isPrime(p: number): boolean {
+  if (p < 2) return false;
+  for (let d = 2; d * d <= p; d++) {
+    if (p % d === 0) return false;
+  }
+  return true;
+}
+
+function modInverses(p: number): number[] {
+  const inv = new Array<number>(p).fill(0);
+  for (let a = 1; a < p; a++) {
+    let oldR = a;
+    let r = p;
+    let oldS = 1;
+    let s = 0;
+    while (r !== 0) {
+      const q = Math.floor(oldR / r);
+      [oldR, r] = [r, oldR - q * r];
+      [oldS, s] = [s, oldS - q * s];
+    }
+    inv[a] = mod(oldS, p);
+  }
+  return inv;
+}
+
+function powCap(base: number, exp: number, cap: number): number {
+  let value = 1;
+  for (let i = 0; i < exp; i++) {
+    value *= base;
+    if (value > cap) return value;
+  }
+  return value;
+}
+
+/**
+ * Reduces a null-space basis over GF(p) so no vector has a pivot position
+ * from the original row echelon form, by adding earlier vectors (whose free
+ * coordinates are then reset to zero). Spans shrink or stay equal, and the
+ * basis often becomes much sparser, which keeps enumeration fast.
+ */
+function thinBasis(basis: number[][], p: number): number[][] {
+  const f = basis.length;
+  const m = basis[0].length;
+  const v = basis.map((vec) => vec.slice());
+  for (let j = 0; j < f; j++) {
+    for (let i = j + 1; i < f; i++) {
+      const a = v[i][j];
+      if (a === 0) continue;
+      for (let k = 0; k < m; k++) {
+        v[i][k] = mod(v[i][k] - a * v[j][k], p);
+      }
+    }
+  }
+  return v;
+}
+
+/**
+ * Weight-guided DFS over the free-variable space with sound residual
+ * pruning. Free variables are processed in ascending button-index order
+ * (after thinning, later positions in each vector are its own free slot),
+ * which makes partial solutions lexicographically ordered, so the first
+ * minimum-weight leaf found is the lexicographically smallest answer.
+ * Returns null when the node budget is exhausted before the space is fully
+ * explored.
+ */
+function enumerateFreePruned(
+  x0: number[],
+  basis: number[][],
+  p: number,
+  nodeLimit: number
+): number[] | null {
+  const m = x0.length;
+  const fCount = basis.length;
+
+  const suffixGain = new Array<number>(fCount + 1).fill(0);
+  for (let i = fCount - 1; i >= 0; i--) {
+    let gain = 0;
+    for (let k = 0; k < m; k++) {
+      if (basis[i][k] !== 0) gain += p - 1;
+    }
+    suffixGain[i] = suffixGain[i + 1] + gain;
+  }
+
+  let nodes = 0;
+  let exhausted = false;
+  let bestX: number[] | null = null;
+  let bestWeight = Infinity;
+  const cur = x0.slice();
+  let curWeight = sum(x0);
+
+  const dfs = (i: number): void => {
+    if (exhausted) return;
+    if (i === fCount) {
+      if (
+        curWeight < bestWeight ||
+        (curWeight === bestWeight && bestX !== null && lexLess(cur, bestX)) ||
+        bestX === null
+      ) {
+        bestWeight = curWeight;
+        bestX = cur.slice();
+      }
+      return;
+    }
+    if (curWeight - suffixGain[i + 1] > bestWeight) return;
+    nodes++;
+    if (nodes > nodeLimit) {
+      exhausted = true;
+      return;
+    }
+    const v = basis[i];
+    const saved = cur.slice();
+    const savedWeight = curWeight;
+    for (let t = 0; t < p; t++) {
+      if (t > 0) {
+        for (let k = 0; k < m; k++) {
+          if (v[k] === 0) continue;
+          const nv = cur[k] + v[k];
+          const wrapped = nv >= p ? nv - p : nv;
+          curWeight += wrapped - cur[k];
+          cur[k] = wrapped;
+        }
+      }
+      dfs(i + 1);
+      if (exhausted) {
+        for (let k = 0; k < m; k++) cur[k] = saved[k];
+        curWeight = savedWeight;
+        return;
+      }
+    }
+    for (let k = 0; k < m; k++) cur[k] = saved[k];
+    curWeight = savedWeight;
+  };
+  dfs(0);
+  return exhausted ? null : bestX;
+}
+
+function sum(values: number[]): number {
+  let total = 0;
+  for (const v of values) total += v;
+  return total;
+}
+
+function lexLess(a: number[], b: number[]): boolean {
+  const len = Math.min(a.length, b.length);
+  for (let i = 0; i < len; i++) {
+    if (a[i] !== b[i]) return a[i] < b[i];
+  }
+  return a.length < b.length;
+}
+
+function popcount(x: bigint): number {
+  let count = 0;
+  let v = x;
+  while (v !== 0n) {
+    v &= v - 1n;
+    count++;
+  }
+  return count;
+}
+
+/** Fewer bits set wins; ties broken by lexicographic order of the ascending index set. */
+function betterSelection(a: bigint, b: bigint): boolean {
+  const wa = popcount(a);
+  const wb = popcount(b);
+  if (wa !== wb) return wa < wb;
+  let x = a;
+  let y = b;
+  while (x !== 0n) {
+    const la = x & -x;
+    const lb = y & -y;
+    if (la !== lb) return la < lb;
+    x ^= la;
+    y ^= lb;
+  }
+  return false;
+}
+
+function selectionToIndices(sel: bigint): number[] {
+  const out: number[] = [];
+  let v = sel;
+  let i = 0;
+  while (v !== 0n) {
+    if ((v & 1n) !== 0n) out.push(i);
+    v >>= 1n;
+    i++;
+  }
+  return out;
+}
+
+function enumerateFree(x0: number[], basis: number[][], p: number): number[] {
+  const m = x0.length;
+  const fCount = basis.length;
+  const cur = x0.slice();
+  let weight = sum(x0);
+  let bestX: number[] | null = null;
+  let bestWeight = Infinity;
+
+  const consider = (): void => {
+    if (weight > bestWeight) return;
+    if (weight === bestWeight && bestX !== null && !lexLess(cur, bestX)) return;
+    bestWeight = weight;
+    bestX = cur.slice();
+  };
+
+  consider();
+  const total = powCap(p, fCount, Number.MAX_SAFE_INTEGER);
+  const digits = new Array<number>(fCount).fill(0);
+  for (let count = 1; count < total; count++) {
+    // Odometer increment: bump the least significant free variable.
+    let fi = 0;
+    for (;;) {
+      const v = basis[fi];
+      for (let i = 0; i < m; i++) {
+        if (v[i] === 0) continue;
+        const nv = cur[i] + v[i];
+        const wrapped = nv >= p ? nv - p : nv;
+        weight += wrapped - cur[i];
+        cur[i] = wrapped;
+      }
+      if (digits[fi] + 1 < p) {
+        digits[fi]++;
+        break;
+      }
+      digits[fi] = 0; // wrapped back to 0; carry into the next variable
+      fi++;
+    }
+    consider();
+  }
+  if (bestX === null) throw new Error("enumerateFree: solution space was unexpectedly empty");
+  return bestX;
+}
+
+function counterByMitm(buttons: number[][], target: number[], p: number): number[] | null {
+  const m = buttons.length;
+  const n = target.length;
+  const mid = m >> 1;
+  const leftCount = mid;
+  const rightCount = m - mid;
+  const pBig = BigInt(p);
+  const width = Math.max(n, m) + 1;
+  const pPow: bigint[] = [1n];
+  for (let i = 1; i <= width; i++) pPow.push(pPow[i - 1] * pBig);
+
+  const cols = buttons.map((btn) => {
+    const effect = new Array<number>(n).fill(0);
+    for (const l of btn) effect[l] = (effect[l] + 1) % p;
+    return effect;
+  });
+
+  const keyOf = (counters: number[]): bigint => {
+    let key = 0n;
+    for (let i = n - 1; i >= 0; i--) key = key * pBig + BigInt(counters[i]);
+    return key;
+  };
+  const packValue = (enc: bigint, w: number): bigint => (enc << 12n) | BigInt(w);
+  const unpackWeight = (packed: bigint): number => Number(packed & 4095n);
+  const unpackEnc = (packed: bigint): bigint => packed >> 12n;
+
+  const digitAt = (enc: bigint, j: number): number => Number((enc / pPow[j]) % pBig);
+  const pressBetter = (encA: bigint, wA: number, encB: bigint, wB: number, count: number): boolean => {
+    if (wA !== wB) return wA < wB;
+    for (let j = 0; j < count; j++) {
+      const da = digitAt(encA, j);
+      const db = digitAt(encB, j);
+      if (da !== db) return da < db;
+    }
+    return false;
+  };
+
+  const bestRight = new Map<bigint, bigint>();
+  const counters = new Array<number>(n).fill(0);
+  const digits = new Array<number>(rightCount).fill(0);
+  let enc = 0n;
+  let weight = 0;
+  bestRight.set(keyOf(counters), packValue(enc, weight));
+  const rightTotal = powCap(p, rightCount, Number.MAX_SAFE_INTEGER);
+  for (let count = 1; count < rightTotal; count++) {
+    let j = 0;
+    for (;;) {
+      const col = cols[mid + j];
+      for (let i = 0; i < n; i++) {
+        const v = counters[i] + col[i];
+        counters[i] = v >= p ? v - p : v;
+      }
+      if (digits[j] + 1 < p) {
+        digits[j]++;
+        weight++;
+        enc += pPow[j];
+        break;
+      }
+      digits[j] = 0;
+      weight -= p - 1;
+      enc -= BigInt(p - 1) * pPow[j];
+      j++;
+    }
+    const key = keyOf(counters);
+    const current = bestRight.get(key);
+    if (
+      current === undefined ||
+      pressBetter(enc, weight, unpackEnc(current), unpackWeight(current), rightCount)
+    ) {
+      bestRight.set(key, packValue(enc, weight));
+    }
+  }
+
+  const need = target.slice();
+  const leftDigits = new Array<number>(leftCount).fill(0);
+  let leftEnc = 0n;
+  let leftWeight = 0;
+  let bestWeight = Infinity;
+  let bestLeft = 0n;
+  let bestRightEnc = 0n;
+  let found = false;
+  const probe = (): void => {
+    const right = bestRight.get(keyOf(need));
+    if (right === undefined) return;
+    const totalWeight = leftWeight + unpackWeight(right);
+    const rightEnc = unpackEnc(right);
+    if (
+      !found ||
+      totalWeight < bestWeight ||
+      (totalWeight === bestWeight &&
+        ((): boolean => {
+          for (let j = 0; j < leftCount; j++) {
+            const da = digitAt(leftEnc, j);
+            const db = digitAt(bestLeft, j);
+            if (da !== db) return da < db;
+          }
+          for (let j = 0; j < rightCount; j++) {
+            const da = digitAt(rightEnc, j);
+            const db = digitAt(bestRightEnc, j);
+            if (da !== db) return da < db;
+          }
+          return false;
+        })())
+    ) {
+      found = true;
+      bestWeight = totalWeight;
+      bestLeft = leftEnc;
+      bestRightEnc = rightEnc;
+    }
+  };
+  probe();
+  const leftTotal = powCap(p, leftCount, Number.MAX_SAFE_INTEGER);
+  for (let count = 1; count < leftTotal; count++) {
+    let j = 0;
+    for (;;) {
+      const col = cols[j];
+      for (let i = 0; i < n; i++) {
+        const v = need[i] - col[i];
+        need[i] = v < 0 ? v + p : v;
+      }
+      if (leftDigits[j] + 1 < p) {
+        leftDigits[j]++;
+        leftWeight++;
+        leftEnc += pPow[j];
+        break;
+      }
+      leftDigits[j] = 0;
+      leftWeight -= p - 1;
+      leftEnc -= BigInt(p - 1) * pPow[j];
+      j++;
+    }
+    probe();
+  }
+
+  if (!found) return null;
+  const result = new Array<number>(m).fill(0);
+  for (let j = 0; j < leftCount; j++) result[j] = digitAt(bestLeft, j);
+  for (let j = 0; j < rightCount; j++) result[mid + j] = digitAt(bestRightEnc, j);
+  return result;
+}
