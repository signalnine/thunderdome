+function applyToggle(machine: Machine, presses: number[]): boolean[] {
+  const state = machine.target.map(() => false);
+  for (const b of presses) {
+    for (const l of machine.buttons[b]) state[l] = !state[l];
+  }
+  return state;
+}
+
+function bruteToggle(machine: Machine): number[] | null {
+  const m = machine.buttons.length;
+  let best: number[] | null = null;
+  for (let s = 0; s < 2 ** m; s++) {
+    const picks: number[] = [];
+    for (let i = 0; i < m; i++) {
+      if (s & (1 << i)) picks.push(i);
+    }
+    const state = applyToggle(machine, picks);
+    if (!state.every((v, i) => v === machine.target[i])) continue;
+    if (
+      best === null ||
+      picks.length < best.length ||
+      (picks.length === best.length && lexCompare(picks, best) < 0)
+    ) {
+      best = picks;
+    }
+  }
+  return best;
