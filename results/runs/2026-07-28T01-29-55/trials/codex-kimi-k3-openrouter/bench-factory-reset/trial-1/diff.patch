+  const counters = lights.map(() => 0);
+  for (let i = 0; i < buttons.length; i++) {
+    for (const l of buttons[i]) counters[l] = (counters[l] + x[i]) % modulus;
+  }
+  return counters;
+}
+
+function bruteCounter(lights: number[], buttons: number[][], p: number): number[] | null {
+  const m = buttons.length;
+  let best: number[] | null = null;
+  const x = new Array<number>(m).fill(0);
+  const total = p ** m;
+  for (let s = 0; s < total; s++) {
+    const counters = applyCounter(lights, buttons, p, x);
+    if (counters.every((v, i) => v === lights[i])) {
+      const w = x.reduce((a, b) => a + b, 0);
+      if (
+        best === null ||
+        w < best.reduce((a, b) => a + b, 0) ||
+        (w === best.reduce((a, b) => a + b, 0) && lexCompare(x, best) < 0)
+      ) {
+        best = x.slice();
+      }
+    }
+    let j = 0;
+    while (j < m) {
+      x[j]++;
+      if (x[j] < p) break;
+      x[j] = 0;
+      j++;
+    }
+  }
+  return best;
