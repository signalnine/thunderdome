+export interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+/**
+ * Part 1: each button may be pressed at most once; pressing toggles its
+ * lights. Returns the minimum set of button indices (sorted ascending) whose
+ * combined toggling turns all lights from off to the target state, breaking
+ * ties by lexicographic order of the sorted set, or null when unreachable.
+ *
+ * Meet-in-the-middle over GF(2): both halves of the buttons are enumerated
+ * (~2^(M/2) subsets); the right half keeps only the best subset per reached
+ * light-state, and each left subset probes for its complement.
+ */
+export function solveToggle(machine: Machine): number[] | null {
+  const { target, buttons } = machine;
+  const m = buttons.length;
+  const n = target.length;
+  assertValidIndices(buttons, n);
+  if (m > 44) {
+    throw new RangeError(`too many buttons (${m}); meet-in-the-middle supports at most 44`);
+  }
+
+  const lightMasks = buttons.map((btn) => {
+    let mask = 0n;
+    for (const l of btn) mask ^= 1n << BigInt(l);
+    return mask;
+  });
+  let targetMask = 0n;
+  for (let i = 0; i < n; i++) {
+    if (target[i]) targetMask |= 1n << BigInt(i);
+  }
+
+  const mid = m >> 1;
+  const leftCount = mid;
+  const rightCount = m - mid;
+
+  const bestRight = new Map<bigint, bigint>();
+  const rightSize = 2 ** rightCount;
+  const rightState = new Array<bigint>(rightSize);
+  const rightSel = new Array<bigint>(rightSize);
+  rightState[0] = 0n;
+  rightSel[0] = 0n;
+  bestRight.set(0n, 0n);
+  for (let s = 1; s < rightSize; s++) {
+    const lsb = s & -s;
+    const bit = 31 - Math.clz32(lsb);
+    const prev = s ^ lsb;
+    const state = rightState[prev] ^ lightMasks[mid + bit];
+    const sel = rightSel[prev] | (1n << BigInt(mid + bit));
+    rightState[s] = state;
+    rightSel[s] = sel;
+    const current = bestRight.get(state);
+    if (current === undefined || betterSelection(sel, current)) {
+      bestRight.set(state, sel);
+    }
+  }
+
+  let best: bigint | null = null;
+  const leftSize = 2 ** leftCount;
+  const leftState = new Array<bigint>(leftSize);
+  const leftSel = new Array<bigint>(leftSize);
+  leftState[0] = 0n;
+  leftSel[0] = 0n;
+  const probe = (state: bigint, sel: bigint): void => {
+    const right = bestRight.get(targetMask ^ state);
+    if (right === undefined) return;
+    const combined = sel | right;
+    if (best === null || betterSelection(combined, best)) best = combined;
+  };
+  probe(0n, 0n);
+  for (let s = 1; s < leftSize; s++) {
+    const lsb = s & -s;
+    const bit = 31 - Math.clz32(lsb);
+    const prev = s ^ lsb;
+    const state = leftState[prev] ^ lightMasks[bit];
+    const sel = leftSel[prev] | (1n << BigInt(bit));
+    leftState[s] = state;
+    leftSel[s] = sel;
+    probe(state, sel);
+  }
+
+  return best === null ? null : selectionToIndices(best);
+}
+
+/**
+ * Part 2: each button may be pressed 0..modulus-1 times; pressing increments
+ * its counters by 1 (wrapping at the prime modulus). Returns the press counts
+ * per button minimizing the total number of presses, breaking ties by
+ * lexicographic order of the result array, or null when unreachable.
+ *
+ * The system is solved over GF(p) via reduced row echelon form, giving
+ * x = x0 + sum(t_f * v_f) over the free variables. Small free spaces are
+ * enumerated exactly over a thinned (weight-reduced) null-space basis;
+ * otherwise an exact dynamic program over counter states is used when p^N is
+ * small, or an exact meet-in-the-middle over the button set when p^(M/2) is
+ * affordable. As a last resort the thinned enumeration runs unbudgeted.
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): number[] | null {
+  const n = lights.length;
+  const m = buttons.length;
+  const p = modulus;
+  if (!Number.isInteger(p) || p < 2 || !isPrime(p)) {
+    throw new RangeError(`modulus must be a prime >= 2, got ${p}`);
+  }
