rvals.findIndex(\n      (interval) =>\n        interval.start === placement.start && interval.end === placement.end,\n    );\n    if (at >= 0) {\n      intervals.splice(at, 1);\n    }\n    state.scheduledCount--;\n  };\n\n  // Events that cannot fit even in an empty schedule.\n  const staticallyInfeasible = new Set<number>();\n  for (let index = 0; index < solved.length; index++) {\n    const entry = solved[index];\n    if (\n      entry.roomOptions.length === 0 ||\n      entry.earliestByPrereqs + entry.event.duration > windowEnd\n    ) {\n      staticallyInfeasible.add(index);\n    }\n  }\n\n  // --- phase 1: greedy most-constrained-first pass ----------------------------\n\n  const greedyPass = (): State => {\n    const state: State = {\n      placed: new Map(),\n      busy: new Map(),\n      scheduledCount: 0,\n    };\n    const remaining = new Set<number>();\n    for (let index = 0; index < solved.length; index++) {\n      if (!staticallyInfeasible.has(index)) {\n        remaining.add(index);\n      }\n    }\n\n    while (remaining.size > 0) {\n      let bestIndex = -1;\n      let bestPlacement: Placement | null = null;\n      let bestSlack = Infinity;\n      let bestDuration = -Infinity;\n\n      for (const index of remaining) {\n        const entry = solved[index];\n        const prereqsPlaced = entry.prerequisites.every((prereqId) =>\n          state.placed.has(indexById.get(prereqId)!),\n        );\n        if (!prereqsPlaced) {\n          continue;\n        }\n        const placement = findPlacementFor(state, index);\n        if (placement === null) {\n          continue;\n        }\n        const slack = placement.start - earliestAllowed(state, index);\n        if (\n          slack < bestSlack ||\n          (slack === bestSlack && entry.event.duration > bestDuration)\n        ) {\n          bestIndex = index;\n          bestPlacement = placement;\n          bestSlack = slack;\n          bestDuration = entry.event.duration;\n        }\n      }\n\n      if (bestIndex === -1 || bestPlacement === null) {\n        break; // the rest is blocked by unplaced prerequisites or rooms\n      }\n      applyPlacement(state, bestIndex, bestPlacement);\n      remaining.delete(bestIndex);\n    }\n    return state;\n  };\n\n  // --- phase 2: retry leftovers after everything else is placed ---------------\n\n  const retryLeftovers = (state: State): void => {\n    let improved = true;\n    while (improved) {\n      improved = false;\n      for (let index = 0; index < solved.length; index++) {\n        if (state.placed.has(index) || staticallyInfeasible.has(index)) {\n          continue;\n        }\n        const entry = solved[index];\n        const prereqsPlaced = entry.prerequisites.every((prereqId) =>\n          state.placed.has(indexById.get(prereqId)!),\n        );\n        if (!prereqsPlaced) {\n          continue;\n        }\n        const placement = findPlacementFor(state, index);\n        if (placement) {\n          applyPlacement(state, index, placement);\n          improved = true;\n        }\n      }\n    }\n  };\n\n  // --- phase 3: limited backtracking search -----------------------------------\n\n  const deadline = Date.now() + SEARCH_TIME_BUDGET_MS;\n\n  const search = (initial: State): State => {\n    let best: State = {\n      placed: new Map(initial.placed),\n      busy: cloneBusy(initial.busy),\n      scheduledCount: initial.scheduledCount,\n    };\n\n    const stack: Array<{ state: State; nextIndex: number }> = [\n      { state: initial, nextIndex: 0 },\n    ];\n\n    while (stack.length > 0) {\n      if (Date.now() > deadline) {\n        break;\n      }\n      const frame = stack[stack.length - 1];\n      const { state } = frame;\n\n      if (state.scheduledCount > best.scheduledCount) {\n        best = {\n          placed: new Map(state.placed),\n          busy: cloneBusy(state.busy),\n          scheduledCount: state.scheduledCount,\n        };\n      }\n\n      // Advance to the next unplaced event.\n      whil