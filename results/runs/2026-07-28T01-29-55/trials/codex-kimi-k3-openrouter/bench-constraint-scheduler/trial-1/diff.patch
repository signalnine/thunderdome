  for (const prereqId of event.prerequisites ?? []) {\n      solved.get(prereqId)!.dependents.push(event.id);\n    }\n  }\n\n  return ordered.map((event) => solved.get(event.id)!);\n}\n\nexport function schedule(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions,\n): ScheduleResult {\n  const windowStart = options.startTime;\n  const windowEnd = options.endTime;\n  const gap = options.gap ?? DEFAULT_GAP;\n\n  if (windowEnd < windowStart) {\n    throw new Error(\n      `Invalid time window: endTime (${windowEnd}) is before startTime (${windowStart})`,\n    );\n  }\n  if (gap < 0) {\n    throw new Error(`Invalid gap: ${gap} (must be >= 0)`);\n  }\n  for (const event of events) {\n    if (event.duration <= 0) {\n      throw new Error(\n        `Event \"${event.id}\" has invalid duration ${event.duration} (must be > 0)`,\n      );\n    }\n  }\n\n  const config: SchedulerConfig = { windowStart, windowEnd, gap };\n  const solved = prepareEvents(events, rooms, config);\n  const indexById = new Map(solved.map((entry, index) => [entry.event.id, index]));\n\n  const cloneBusy = (busy: Map<string, Interval[]>): Map<string, Interval[]> => {\n    const copy = new Map<string, Interval[]>();\n    for (const [roomId, intervals] of busy) {\n      copy.set(roomId, intervals.slice());\n    }\n    return copy;\n  };\n\n  const insertInterval = (intervals: Interval[], start: number, end: number) => {\n    let position = intervals.length;\n    while (position > 0 && intervals[position - 1].start > start) {\n      position--;\n    }\n    intervals.splice(position, 0, { start, end });\n  };\n\n  const roomBusyList = (state: State, roomId: string): Interval[] => {\n    let intervals = state.busy.get(roomId);\n    if (!intervals) {\n      intervals = [];\n      state.busy.set(roomId, intervals);\n    }\n    return intervals;\n  };\n\n  const earliestAllowed = (state: State, index: number): number => {\n    let earliest = solved[index].earliestByPrereqs;\n    for (const prereq