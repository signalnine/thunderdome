+describe('batch optimization', () => {
+  it('does not let a greedy first-fit starve later events', () => {
+    // One room, 4-hour window (240 min usable with gaps).
+    // e1 (120) placed at 540 would leave only 105 min — enough for one 60
+    // but not two more 90s. An optimal schedule picks the two 90s + one 60:
+    // 90+15+90+15+60 = 270 > 240, so actually two 90s = 195, or 90+60+60...
+    // Verify it schedules 3 events when naive order would get fewer.
+    const events: Event[] = [
+      { id: 'big', name: 'Big', duration: 150 },
+      { id: 'm1', name: 'M1', duration: 60 },
+      { id: 'm2', name: 'M2', duration: 60 },
+      { id: 'm3', name: 'M3', duration: 60 },
+    ];
+    const options = opts({ startTime: 540, endTime: 780 }); // 240 min
+    const result = schedule(events, rooms(10), options);
+    assertValidSchedule(events, rooms(10), options, result);
+    // Optimal: three 60s (60+15+60+15+60 = 210) beats big+one 60 (225 -> 2 events)
+    expect(result.assignments.length).toBe(3);
+    expect(result.unscheduled).toEqual(['big']);
+  });
+
+  it('uses spare rooms to schedule more events', () => {
+    const events: Event[] = Array.from({ length: 6 }, (_, i) => ({
+      id: `e${i}`,
+      name: `E${i}`,
+      duration: 200,
+    }));
+    const roomList = rooms(10, 10, 10);
+    const options = opts({ startTime: 540, endTime: 1020 });
+    const result = schedule(events, roomList, options);
+    assertValidSchedule(events, roomList, options, result);
+    // each room fits 2 (200+15+200 = 415 <= 480), so all 6 fit
+    expect(result.unscheduled).toEqual([]);
+  });
+
+  it('maximizes scheduled count when rooms are heterogeneous', () => {
+    const events: Event[] = [
+      { id: 'vip', name: 'VIP', duration: 240, attendees: 90 },
+      { id: 's1', name: 'S1', duration: 240, attendees: 5 },
+      { id: 's2', name: 'S2', duration: 240, attendees: 5 },
+    ];
+    const roomList = rooms(10, 100);
+    const options = opts({ startTime: 540, endTime: 780 }); // 240 min: one event per room
+    const result = schedule(events, roomList, options);
+    assertValidSchedule(events, roomList, options, result);
+    // Optimal: vip in big room + one small in small room = 2 scheduled
+    expect(result.assignments).toHaveLength(2);
+    expect(result.unscheduled).toHaveLength(1);
+  });
+
+  it('schedules a realistic conference day', () => {
+    const events: Event[] = [
+      { id: 'keynote', name: 'Keynote', duration: 60, attendees: 200 },
+      { id: 'talk-a', name: 'Talk A', duration: 45, attendees: 50, prerequisites: ['keynote'] },
+      { id: 'talk-b', name: 'Talk B', duration: 45, attendees: 30, prerequisites: ['keynote'] },
+      { id: 'workshop', name: 'Workshop', duration: 120, attendees: 20, prerequisites: ['talk-a'] },
+      { id: 'panel', name: 'Panel', duration: 60, attendees: 80, prerequisites: ['talk-b'] },
+      { id: 'networking', name: 'Networking', duration: 30, attendees: 200, prerequisites: ['panel', 'workshop'] },
+      { id: 'yoga', name: 'Yoga', duration: 30, attendees: 15, preferredRoom: 'small' },
+    ];
+    const roomList: Room[] = [
+      { id: 'hall', name: 'Main Hall', capacity: 250 },
+      { id: 'mid', name: 'Mid Room', capacity: 60 },
+      { id: 'small', name: 'Small Room', capacity: 20 },
+    ];
+    const options = opts({ startTime: 540, endTime: 1080 });
+    const result = schedule(events, roomList, options);
+    assertValidSchedule(events, roomList, options, result);
+    expect(result.unscheduled).toEqual([]);
+    const byId = new Map(result.assignments.map((a) => [a.eventId, a]));
+    expect(byId.get('keynote')!.roomId).toBe('hall');
+    expect(byId.get('yoga')!.roomId).toBe('small');
+    expect(byId.get('networking')!.roomId).toBe('hall');
+  });
+});
