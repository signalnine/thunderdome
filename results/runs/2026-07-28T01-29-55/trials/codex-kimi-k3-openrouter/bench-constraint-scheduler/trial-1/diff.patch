f (at >= 0) {\n      intervals.splice(at, 1);\n    }\n    state.scheduledCount--;\n  };\n\n  // --- feasibility ------------------------------------------------------------\n\n  // Quick check: event cannot fit even in an empty schedule.\n  const staticallyInfeasible = new Set<number>();\n  for (let index = 0; index < solved.length; index++) {\n    const entry = solved[index];\n    if (\n      entry.roomOptions.length === 0 ||\n      entry.earliestByPrereqs + entry.event.duration > windowEnd\n    ) {\n      staticallyInfeasible.add(index);\n    }\n  }\n\n  // --- phase 1: greedy most-constrained-first pass ----------------------------\n\n  const greedyPass = (): State => {\n    const state: State = {\n      placed: new Map(),\n      busy: new Map(),\n      scheduledCount: 0,\n    };\n    const remaining = new Set<number>();\n    for (let index = 0; index < solved.length; index++) {\n      if (!staticallyInfeasible.has(index)) {\n        remaining.add(index);\n      }\n    }\n\n    while (remaining.size > 0) {\n      let bestIndex = -1;\n      let bestPlacement: Placement | null = null;\n      let bestSlack = Infinity;\n      let bestDuration = -Infinity;\n\n      for (const index of remaining) {\n        const entry = solved[index];\n        const prereqsPlaced = entry.prerequisites.every((prereqId) =>\n          state.placed.has(indexById.get(prereqId)!),\n        );\n        if (!prereqsPlaced) {\n          continue;\n        }\n        const placement = findEarliestPlacement(state, index);\n        if (placement === null) {\n          continue;\n        }\n        const slack = placement.start - earliestAllowed(state, index);\n        if (\n          slack < bestSlack ||\n          (slack === bestSlack && entry.event.duration > bestDuration)\n        ) {\n          bestIndex = index;\n          bestPlacement = placement;\n          bestSlack = slack;\n          bestDuration = entry.event.duration;\n        }\n      }\n\n      if (bestIndex === -1 || bestPlacement