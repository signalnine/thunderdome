+import {
+  Event,
+  Room,
+  ScheduleOptions,
+  ScheduleResult,
+} from './types.js';
+import { schedule } from './scheduler.js';
+
+export { schedule };
+export type {
+  Assignment,
+  Event,
+  Room,
+  ScheduleOptions,
+  ScheduleResult,
+} from './types.js';
+
+export class Scheduler {
+  schedule(
+    events: Event[],
+    rooms: Room[],
+    options: ScheduleOptions,
+  ): ScheduleResult {
+    return schedule(events, rooms, options);
+  }
+}
+
+export function createScheduler(): Scheduler {
+  return new Scheduler();
+}
+
+export default schedule;
diff --git a/src/scheduler.ts b/src/scheduler.ts
new file mode 100644
index 0000000..981da48
--- /dev/null
+++ b/src/scheduler.ts
@@ -0,0 +1,533 @@
+import {
+  Assignment,
+  Event,
+  Room,
+  ScheduleOptions,
+  ScheduleResult,
+} from './types.js';
+
+const DEFAULT_GAP = 15;
+const SEARCH_TIME_BUDGET_BASE_MS = 2000;
+const SEARCH_TIME_BUDGET_PER_EVENT_MS = 250;
+const SEARCH_TIME_BUDGET_MAX_MS = 10000;
+
+interface SchedulerConfig {
+  windowStart: number;
+  windowEnd: number;
+  gap: number;
+}
+
+interface SolvedEvent {
+  event: Event;
+  attendees: number;
+  prerequisites: string[];
+  earliestByPrereqs: number; // earliest start ignoring room contention
+  roomOptions: Room[]; // capacity-eligible rooms, preferred first
+}
+
+interface Placement {
+  roomIndex: number;
+  start: number;
+  end: number;
+}
+
+interface Interval {
+  start: number;
+  end: number;
+}
+
+interface State {
+  placed: Map<number, Placement>;
+  busy: Map<string, Interval[]>; // per room id, sorted by start
+  scheduledCount: number;
+}
+
+function topologicalOrder(events: Event[]): Event[] {
+  const byId = new Map<string, Event>();
+  for (const event of events) {
+    if (byId.has(event.id)) {
+      throw new Error(`Duplicate event id: "${event.id}"`);
+    }
+    byId.set(event.id, event);
+  }
+
+  const indegree = new Map<string, number>();
+  const dependents = new Map<string, string[]>();
+  for (const event of events) {
+    indegree.set(event.id, 0);
+    dependents.set(event.id, []);
+  }
+  for (const event of events) {
+    for (const prereqId of event.prerequisites ?? []) {
+      if (!byId.has(prereqId)) {
+        throw new Error(
+          `Event "${event.id}" lists unknown prerequisite "${prereqId}"`,
+        );
+      }
+      indegree.set(event.id, (indegree.get(event.id) ?? 0) + 1);
+      dependents.get(prereqId)!.push(event.id);
+    }
+  }
+
+  const queue = events
+    .filter((event) => indegree.get(event.id) === 0)
+    .map((event) => event.id);
+  const order: Event[] = [];
+  while (queue.length > 0) {
+    const id = queue.shift()!;
+    order.push(byId.get(id)!);
+    for (const dependentId of dependents.get(id) ?? []) {
+      const remaining = indegree.get(dependentId)! - 1;
+      indegree.set(dependentId, remaining);
+      if (remaining === 0) {
+        queue.push(dependentId);
+      }
+    }
+  }
+
+  if (order.length !== events.length) {
+    const cycleIds = events
+      .filter((event) => indegree.get(event.id)! > 0)
+      .map((event) => event.id);
+    throw new Error(
+      `Prerequisite cycle detected involving event(s): ${cycleIds.join(', ')}`,
+    );
+  }
+  return order;
+}
+
+function prepareEvents(
+  events: Event[],
+  rooms: Room[],
+  config: SchedulerConfig,
+): SolvedEvent[] {
+  const { windowStart, gap } = config;
+  const roomById = new Map(rooms.map((room) => [room.id, room]));
+
+  const sortedRooms = [...rooms].sort((a, b) => a.capacity - b.capacity);
+  const ordered = topologicalOrder(events);
+  const solved = new Map<string, SolvedEvent>();
+
+  for (const event of ordered) {
+    const attendees = event.attendees ?? 1;
+    const prerequisites = event.prerequisites ?? [];
+
+    let earliestByPrereqs = windowStart;
+    for (const prereqId of prerequisites) {
+      const prereq = solved.get(prereqId)!;
+      earliestByPrereqs = Math.max(
+        earliestByPrereqs,
+        prereq.earliestByPrereqs + prereq.event.duration + gap,
+      );
+    }
+
+    const preferred = event.preferredRoom
+      ? roomById.get(event.preferredRoom)
+      : undefined;
+    const eligible = sortedRooms.filter(
+      (room) => room.capacity >= attendees && room.id !== preferred?.id,
+    );
+    const roomOptions =
+      preferred && preferred.capacity >= attendees
+        ? [preferred, ...eligible]
+        : eligible;
+
+    solved.set(event.id, {
+      event,
+      attendees,
+      prerequisites,
+      earliestByPrereqs,
+      roomOptions,
+    });
+  }
+
+  return ordered.map((event) => solved.get(event.id)!);
+}
+
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const windowStart = options.startTime;
+  const windowEnd = options.endTime;
+  const gap = options.gap ?? DEFAULT_GAP;
+
+  if (windowEnd < windowStart) {
+    throw new Error(
+      `Invalid time window: endTime (${windowEnd}) is before startTime (${windowStart})`,
+    );
+  }
+  if (gap < 0) {
+    throw new Error(`Invalid gap: ${gap} (must be >= 0)`);
+  }
+  for (const event of events) {
+    if (event.duration <= 0) {
+      throw new Error(
+        `Event "${event.id}" has invalid duration ${event.duration} (must be > 0)`,
+      );
+    }
+  }
+
+  const config: SchedulerConfig = { windowStart, windowEnd, gap };
+  const solved = prepareEvents(events, rooms, config);
+  const indexById = new Map(
+    solved.map((entry, index) => [entry.event.id, index]),
+  );
+
+  const insertInterval = (intervals: Interval[], start: number, end: number) => {
+    let position = intervals.length;
+    while (position > 0 && intervals[position - 1].start > start) {
+      position--;
+    }
+    intervals.splice(position, 0, { start, end });
+  };
+
+  const roomBusyList = (state: State, roomId: string): Interval[] => {
+    let intervals = state.busy.get(roomId);
+    if (!intervals) {
+      intervals = [];
+      state.busy.set(roomId, intervals);
+    }
+    return intervals;
+  };
+
+  const earliestAllowed = (state: State, index: number): number => {
+    let earliest = solved[index].earliestByPrereqs;
+    for (const prereqId of solved[index].prerequisites) {
+      const placement = state.placed.get(indexById.get(prereqId)!);
+      if (placement) {
+        earliest = Math.max(earliest, placement.end + gap);
+      }
+    }
+    return earliest;
+  };
+
+  const applyPlacement = (state: State, index: number, placement: Placement) => {
+    state.placed.set(index, placement);
+    const room = solved[index].roomOptions[placement.roomIndex];
+    insertInterval(roomBusyList(state, room.id), placement.start, placement.end);
+    state.scheduledCount++;
+  };
+
+  const unplace = (state: State, index: number) => {
+    const placement = state.placed.get(index);
+    if (!placement) {
+      return;
+    }
+    state.placed.delete(index);
+    const room = solved[index].roomOptions[placement.roomIndex];
+    const intervals = state.busy.get(room.id)!;
+    const at = intervals.findIndex(
+      (interval) =>
+        interval.start === placement.start && interval.end === placement.end,
+    );
+    intervals.splice(at, 1);
+    state.scheduledCount--;
+  };
+
+  // Earliest feasible slot for `index` within one specific room, honoring the
+  // gap on both sides of every existing booking in that room.
+  const findPlacementInRoom = (
+    state: State,
+    index: number,
+    roomIndex: number,
+  ): Placement | null => {
+    const entry = solved[index];
+    const room = entry.roomOptions[roomIndex];
+    const intervals = state.busy.get(room.id) ?? [];
+    let start = earliestAllowed(state, index);
+    for (const interval of intervals) {
+      if (start + entry.event.duration + gap <= interval.start) {
+        break; // fits before this booking with the required gap
+      }
+      start = Math.max(start, interval.end + gap);
+    }
+    const end = start + entry.event.duration;
+    if (end > windowEnd) {
+      return null;
+    }
+    return { roomIndex, start, end };
+  };
+
+  // Best placement across eligible rooms. Normally the earliest start wins
+  // (ties keep the preferred room, which is first in roomOptions); with
+  // `minimizeEnd` the earliest end wins instead.
+  const findPlacementFor = (
+    state: State,
+    index: number,
+    minimizeEnd = false,
+  ): Placement | null => {
+    let best: Placement | null = null;
+    for (let roomIndex = 0; roomIndex < solved[index].roomOptions.length; roomIndex++) {
+      const candidate = findPlacementInRoom(state, index, roomIndex);
+      if (!candidate) {
+        continue;
+      }
+      const better =
+        best === null ||
+        (minimizeEnd
+          ? candidate.end < best.end
+          : candidate.start < best.start);
+      if (better) {
+        best = candidate;
+      }
+    }
+    return best;
+  };
+
+  // Events that cannot fit even in an otherwise empty schedule.
+  const staticallyInfeasible = new Set<number>();
+  for (let index = 0; index < solved.length; index++) {
+    const entry = solved[index];
+    if (
+      entry.roomOptions.length === 0 ||
+      entry.earliestByPrereqs + entry.event.duration > windowEnd
+    ) {
+      staticallyInfeasible.add(index);
+    }
+  }
+
+  const prereqsPlaced = (state: State, index: number): boolean =>
+    solved[index].prerequisites.every((prereqId) =>
+      state.placed.has(indexById.get(prereqId)!),
+    );
+
+  // --- phase 1: greedy most-constrained-first pass --------------------------
+
+  const greedyPass = (): State => {
+    const state: State = {
+      placed: new Map(),
+      busy: new Map(),
+      scheduledCount: 0,
+    };
+    const remaining = new Set<number>();
+    for (let index = 0; index < solved.length; index++) {
+      if (!staticallyInfeasible.has(index)) {
+        remaining.add(index);
+      }
+    }
+
+    while (remaining.size > 0) {
+      let bestIndex = -1;
+      let bestPlacement: Placement | null = null;
+      let bestSlack = Infinity;
+      let bestDuration = -Infinity;
+
+      for (const index of remaining) {
+        if (!prereqsPlaced(state, index)) {
+          continue;
+        }
+        const placement = findPlacementFor(state, index);
+        if (placement === null) {
+          continue;
+        }
+        const slack = placement.start - earliestAllowed(state, index);
+        if (
+          slack < bestSlack ||
+          (slack === bestSlack && solved[index].event.duration > bestDuration)
+        ) {
+          bestIndex = index;
+          bestPlacement = placement;
+          bestSlack = slack;
+          bestDuration = solved[index].event.duration;
+        }
+      }
+
+      if (bestIndex === -1 || bestPlacement === null) {
+        break; // the rest is blocked by unplaced prerequisites or rooms
+      }
+      applyPlacement(state, bestIndex, bestPlacement);
+      remaining.delete(bestIndex);
+    }
+    return state;
+  };
+
+  // --- phase 2: retry leftovers once everything else is placed ---------------
+
+  const retryLeftovers = (state: State): void => {
+    let improved = true;
+    while (improved) {
+      improved = false;
+      for (let index = 0; index < solved.length; index++) {
+        if (state.placed.has(index) || staticallyInfeasible.has(index)) {
+          continue;
+        }
+        if (!prereqsPlaced(state, index)) {
+          continue;
+        }
+        const placement = findPlacementFor(state, index);
+        if (placement) {
+          applyPlacement(state, index, placement);
+          improved = true;
+        }
+      }
+    }
+  };
+
+  // --- phase 3: bounded branch-and-bound over placement choices --------------
+
+  const searchBudgetMs = Math.min(
+    SEARCH_TIME_BUDGET_MAX_MS,
+    SEARCH_TIME_BUDGET_BASE_MS + solved.length * SEARCH_TIME_BUDGET_PER_EVENT_MS,
+  );
+  const deadline = Date.now() + searchBudgetMs;
+
+  const search = (seed: State): State => {
+    let bestPlaced = new Map(seed.placed);
+    let bestCount = seed.scheduledCount;
+
+    const state: State = { placed: new Map(), busy: new Map(), scheduledCount: 0 };
+    const skipped = new Set<number>();
+
+    const dfs = (cursor: number): void => {
+      if (Date.now() > deadline) {
+        return;
+      }
+      if (state.scheduledCount > bestCount) {
+        bestCount = state.scheduledCount;
+        bestPlaced = new Map(state.placed);
+      }
+
+      let index = cursor;
+      while (
+        index < solved.length &&
+        (state.placed.has(index) ||
+          skipped.has(index) ||
+          staticallyInfeasible.has(index))
+      ) {
+        index++;
+      }
+      if (index >= solved.length) {
+        return;
+      }
+
+      // Bound: give up if placing every remaining event still cannot beat best.
+      let undecided = 0;
+      for (let j = index; j < solved.length; j++) {
+        if (
+          !state.placed.has(j) &&
+          !skipped.has(j) &&
+          !staticallyInfeasible.has(j)
+        ) {
+          undecided++;
+        }
+      }
+      if (state.scheduledCount + undecided <= bestCount) {
+        return;
+      }
+
+      if (prereqsPlaced(state, index)) {
+        const choices: Placement[] = [];
+        for (
+          let roomIndex = 0;
+          roomIndex < solved[index].roomOptions.length;
+          roomIndex++
+        ) {
+          const placement = findPlacementInRoom(state, index, roomIndex);
+          if (placement) {
+            choices.push(placement);
+          }
+        }
+        choices.sort((a, b) => a.start - b.start || a.roomIndex - b.roomIndex);
+        for (const placement of choices) {
+          applyPlacement(state, index, placement);
+          dfs(index + 1);
+          unplace(state, index);
+          if (Date.now() > deadline) {
+            return;
+          }
+        }
+      }
+
+      skipped.add(index);
+      dfs(index + 1);
+      skipped.delete(index);
+    };
+
+    dfs(0);
+
+    // Rebuild a consistent state from the best placement set found.
+    const rebuilt: State = {
+      placed: new Map(),
+      busy: new Map(),
+      scheduledCount: 0,
+    };
+    const entries = [...bestPlaced.entries()].sort((a, b) => a[0] - b[0]);
+    for (const [index, placement] of entries) {
+      applyPlacement(rebuilt, index, placement);
+    }
+    return rebuilt;
+  };
+
+  // --- run phases --------------------------------------------------------------
+
+  const greedy = greedyPass();
+  retryLeftovers(greedy);
+
+  let finalState = greedy;
+  const feasibleTarget = solved.length - staticallyInfeasible.size;
+  if (greedy.scheduledCount < feasibleTarget) {
+    const searched = search(greedy);
+    retryLeftovers(searched);
+    if (searched.scheduledCount >= finalState.scheduledCount) {
+      finalState = searched;
+    }
+  }
+
+  // --- compaction: re-place everything as early as possible --------------------
+
+  const compact = (state: State): State => {
+    const compacted: State = {
+      placed: new Map(),
+      busy: new Map(),
+      scheduledCount: 0,
+    };
+    const remaining = new Set(state.placed.keys());
+    while (remaining.size > 0) {
+      let progressed = false;
+      for (const index of [...remaining]) {
+        const prereqsReady = solved[index].prerequisites.every(
+          (prereqId) => !remaining.has(indexById.get(prereqId)!),
+        );
+        if (!prereqsReady) {
+          continue;
+        }
+        const placement = findPlacementFor(compacted, index, true);
+        if (placement) {
+          applyPlacement(compacted, index, placement);
+        }
+        remaining.delete(index);
+        progressed = true;
+      }
+      if (!progressed) {
+        break;
+      }
+    }
+    // Compaction is heuristic; never lose placements because of it.
+    return compacted.scheduledCount >= state.scheduledCount ? compacted : state;
+  };
+
+  finalState = compact(finalState);
+
+  // --- build result ------------------------------------------------------------
+
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+  for (let index = 0; index < solved.length; index++) {
+    const placement = finalState.placed.get(index);
+    if (placement) {
+      const room = solved[index].roomOptions[placement.roomIndex];
+      assignments.push({
+        eventId: solved[index].event.id,
+        roomId: room.id,
+        startTime: placement.start,
+        endTime: placement.end,
+      });
+    } else {
+      unscheduled.push(solved[index].event.id);
+    }
+  }
+
+  return { assignments, unscheduled };
+}
