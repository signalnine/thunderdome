+{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /workspace/tests && cat > /workspace/tests/scheduler.test.ts << 'EOF'\nimport { describe, expect, it } from 'vitest';\nimport createScheduler, {\n  Scheduler,\n  createScheduler,\n  schedule,\n} from '../src/index.js';\nimport type {\n  Assignment,\n  Event,\n  Room,\n  ScheduleOptions,\n  ScheduleResult,\n} from '../src/index.js';\n\nconst rooms = (...capacities: number[]): Room[] =>\n  capacities.map((capacity, i) => ({\n    id: \"'`room-${i}`,\n    name: `Room ${i}`,\n    capacity,\n  }));\n\nconst opts = (overrides: Partial<ScheduleOptions> = {}): ScheduleOptions => ({\n  startTime: 540,\n  endTime: 1020,\n  ...overrides,\n});\n\n// Validates every hard constraint of the produced schedule.\nfunction assertValidSchedule(\n  events: Event[],\n  roomList: Room[],\n  options: ScheduleOptions,\n  result: ScheduleResult,\n) {\n  const gap = options.gap ?? 15;\n  const eventById = new Map(events.map((event) => [event.id, event]));\n  const roomById = new Map(roomList.map((room) => [room.id, room]));\n  const assignmentByEvent = new Map<string, Assignment>();\n\n  for (const assignment of result.assignments) {\n    const event = eventById.get(assignment.eventId);\n    const room = roomById.get(assignment.roomId);\n    expect(event, `unknown event ${assignment.eventId}`).toBeDefined();\n    expect(room, `unknown room ${assignment.roomId}`).toBeDefined();\n    expect(assignmentByEvent.has(assignment.eventId)).toBe(false);\n\n    // time window\n    expect(assignment.startTime).toBeGreaterThanOrEqual(options.startTime);\n    expect(assignment.endTime).toBeLessThanOrEqual(options.endTime);\n    // duration\n    expect(assignment.endTime - assignment.startTime).toBe(event!.duration);\n    // capacity\n    expect(room!.capacity).toBeGreaterThanOrEqual(event!.attendees ?? 1);\n\n    assignmentByEvent.set(assignment.eventId, assignment);\n  }\n\n  // every event is either assigned or unscheduled, exactly once\n  expect(result.assignments.length + result.unscheduled.length).toBe(\n    events.length,\n  );\n  for (const id of result.unscheduled) {\n    expect(assignmentByEvent.has(id)).toBe(false);\n  }\n\n  // room gaps\n  const byRoom = new Map<string, Assignment[]>();\n  for (const assignment of result.assignments) {\n    const list = byRoom.get(assignment.roomId) ?? [];\n    list.push(assignment);\n    byRoom.set(assignment.roomId, list);\n  }\n  for (const list of byRoom.values()) {\n    list.sort((a, b) => a.startTime - b.startTime);\n    for (let i = 1; i < list.length; i++) {\n      expect(\n        list[i].startTime - list[i - 1].endTime,\n        `gap violated in room between ${list[i - 1].eventId} and ${list[i].eventId}`,\n      ).toBeGreaterThanOrEqual(gap);\n    }\n  }\n\n  // prerequisites\n  for (const event of events) {\n    const assignment = assignmentByEvent.get(event.id);\n    if (!assignment) {\n      continue;\n    }\n    for (const prereqId of event.prerequisites ?? []) {\n      const prereq = assignmentByEvent.get(prereqId);\n      expect(\n        prereq,\n        `scheduled event ${event.id} has unscheduled prerequisite ${prereqId}`,\n      ).toBeDefined();\n      expect(assignment.startTime).toBeGreaterThanOrEqual(\n        prereq!.endTime + gap,\n      );\n    }\n  }\n}\n\ndescribe('\"'exports', () => {\n  it('exposes named, default, class, and factory APIs', () => {\n    expect(typeof schedule).toBe('function');\n    expect(createScheduler).toBe(schedule);\n    const scheduler = new Scheduler();\n    expect(typeof scheduler.schedule).toBe('function');\n    expect(createScheduler()).toBeInstanceOf(Scheduler);\n  });\n});\n\ndescribe('basic scheduling', () => {\n  it('schedules a single event at the window start', () => {\n    const result = schedule(\n      [{ id: 'a', name: 'A', duration: 60 }],\n      rooms(10),\n      opts(),\n    );\n    expect(result.unscheduled).toEqual([]);\n    expect(result.assignments).toEqual([\n      { eventId: 'a', roomId: 'room-0', startTime: 540, endTime: 600 },\n    ]);\n  });\n\n  it('stacks events in one room with the default 15 minute gap', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60 },\n      { id: 'c', name: 'C', duration: 30 },\n    ];\n    const result = schedule(events, rooms(10), opts());\n    assertValidSchedule(events, rooms(10), opts(), result);\n    expect(result.unscheduled).toEqual([]);\n    const byId = new Map(result.assignments.map((a) => [a.eventId, a]));\n    expect(byId.get('a')\"'!.startTime).toBe(540);\n    expect(byId.get('\"'b')\"'!.startTime).toBe(615);\n    expect(byId.get('\"'c')\"'!.startTime).toBe(690);\n  });\n\n  it('\"'respects a custom gap', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 30 },\n      { id: 'b', name: 'B', duration: 30 },\n    ];\n    const options = opts({ gap: 5 });\n    const result = schedule(events, rooms(10), options);\n    assertValidSchedule(events, rooms(10), options, result);\n    const byId = new Map(result.assignments.map((a) => [a.eventId, a]));\n    expect(byId.get('b')\"'!.startTime).toBe(575);\n  });\n\n  it('\"'uses multiple rooms in parallel', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 120 },\n      { id: 'b', name: 'B', duration: 120 },\n    ];\n    const roomList = rooms(10, 20);\n    const result = schedule(events, roomList, opts());\n    assertValidSchedule(events, roomList, opts(), result);\n    expect(result.unscheduled).toEqual([]);\n    expect(new Set(result.assignments.map((a) => a.roomId)).size).toBe(2);\n  });\n\n  it('handles empty input', () => {\n    expect(schedule([], rooms(10), opts())).toEqual({\n      assignments: [],\n      unscheduled: [],\n    });\n    expect(schedule([], [], opts())).toEqual({\n      assignments: [],\n      unscheduled: [],\n    });\n  });\n});\n\ndescribe('capacity', () => {\n  it('rejects events that exceed every room capacity', () => {\n    const events: Event[] = [\n      { id: 'big', name: 'Big', duration: 60, attendees: 50 },\n    ];\n    const result = schedule(events, rooms(10), opts());\n    expect(result.assignments).toEqual([]);\n    expect(result.unscheduled).toEqual(['big']);\n  });\n\n  it('routes large events to large rooms and small events to small rooms', () => {\n    const events: Event[] = [\n      { id: 'small', name: 'Small', duration: 60, attendees: 5 },\n      { id: 'large', name: 'Large', duration: 60, attendees: 100 },\n    ];\n    const roomList = rooms(10, 200);\n    const result = schedule(events, roomList, opts());\n    assertValidSchedule(events, roomList, opts(), result);\n    const byId = new Map(result.assignments.map((a) => [a.eventId, a]));\n    expect(byId.get('large')\"'!.roomId).toBe('\"'room-1');\n    expect(byId.get('small')\"'!.roomId).toBe('\"'room-0');\n  });\n\n  it('defaults attendees to 1', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 30 }];\n    const result = schedule(events, rooms(1), opts());\n    expect(result.unscheduled).toEqual([]);\n  });\n});\n\ndescribe('time window', () => {\n  it('does not schedule events that cannot fit in the window', () => {\n    const events: Event[] = [\n      { id: 'long', name: 'Long', duration: 600 },\n    ];\n    const result = schedule(events, rooms(10), opts());\n    expect(result.unscheduled).toEqual(['long']);\n  });\n\n  it('packs as many events as fit into a short window', () => {\n    const events: Event[] = [1, 2, 3, 4].map((i) => ({\n      id: \"'`e${i}`,\n      name: `E${i}`,\n      duration: 60,\n    }));\n    const options = opts({ startTime: 540, endTime: 720 }); // 3 hours\n    const result = schedule(events, rooms(10), options);\n    assertValidSchedule(events, rooms(10), options, result);\n    // 60 + 15 + 60 + 15 + 60 = 210 > 180, so only 2 fit\n    expect(result.assignments).toHaveLength(2);\n    expect(result.unscheduled).toHaveLength(2);\n  });\n});\n\ndescribe('\"'prerequisites', () => {\n  it('orders a simple chain with gaps', () => {\n    const events: Event[] = [\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n      { id: 'a', name: 'A', duration: 60 },\n    ];\n    const result = schedule(events, rooms(10), opts());\n    assertValidSchedule(events, rooms(10), opts(), result);\n    const byId = new Map(result.assignments.map((a) => [a.eventId, a]));\n    expect(byId.get('a')\"'!.startTime).toBe(540);\n    expect(byId.get('\"'b')\"'!.startTime).toBe(615);\n  });\n\n  it('\"'handles diamond dependencies', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 30 },\n      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 30, prerequisites: ['a'] },\n      { id: 'd', name: 'D', duration: 30, prerequisites: ['b', 'c'] },\n    ];\n    const result = schedule(events, rooms(10), opts());\n    assertValidSchedule(events, rooms(10), opts(), result);\n    expect(result.unscheduled).toEqual([]);\n  });\n\n  it('parallelizes independent branches across rooms', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 60, prerequisites: ['a'] },\n    ];\n    const roomList = rooms(10, 10);\n    const result = schedule(events, roomList, opts());\n    assertValidSchedule(events, roomList, opts(), result);\n    const byId = new Map(result.assignments.map((a) => [a.eventId, a]));\n    expect(byId.get('b')\"'!.startTime).toBe(615);\n    expect(byId.get('\"'c')\"'!.startTime).toBe(615);\n  });\n\n  it('\"'keeps dependents unscheduled when a prerequisite cannot fit', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 600 },\n      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },\n    ];\n    const result = schedule(events, rooms(10), opts());\n    expect(result.unscheduled).toContain('a');\n    expect(result.unscheduled).toContain('b');\n  });\n\n  it('unschedules the tail of a chain that overruns the window', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 200 },\n      { id: 'b', name: 'B', duration: 200, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 200, prerequisites: ['b'] },\n    ];\n    const options = opts({ startTime: 540, endTime: 1000 });\n    const result = schedule(events, rooms(10), options);\n    assertValidSchedule(events, rooms(10), options, result);\n    // a: 540-740, b: 755-955, c: 970-1170 exceeds 1000\n    expect(result.unscheduled).toEqual(['c']);\n  });\n\n  it('applies the gap between prerequisite events even across rooms', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n    ];\n    const roomList = rooms(10, 10);\n    const options = opts({ gap: 30 });\n    const result = schedule(events, roomList, options);\n    assertValidSchedule(events, roomList, options, result);\n    const byId = new Map(result.assignments.map((a) => [a.eventId, a]));\n    expect(byId.get('b')\"'!.startTime).toBe(630);\n  });\n});\n\ndescribe('\"'cycles', () => {\n  it('throws on a self-reference', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 30, prerequisites: ['a'] },\n    ];\n    expect(() => schedule(events, rooms(10), opts())).toThrow(/cycle/i);\n  });\n\n  it('throws on a two-event cycle', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 30, prerequisites: ['b'] },\n      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },\n    ];\n    expect(() => schedule(events, rooms(10), opts())).toThrow(/cycle/i);\n  });\n\n  it('throws on a longer cycle', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 30, prerequisites: ['c'] },\n      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 30, prerequisites: ['b'] },\n    ];\n    expect(() => schedule(events, rooms(10), opts())).toThrow(/cycle/i);\n  });\n\n  it('throws on unknown prerequisite references', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 30, prerequisites: ['ghost'] },\n    ];\n    expect(() => schedule(events, rooms(10), opts())).toThrow(\n      /unknown prerequisite/i,\n    );\n  });\n});\n\ndescribe('preferred rooms', () => {\n  it('honors the preference when free', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, preferredRoom: 'room-1' },\n    ];\n    const roomList = rooms(10, 10);\n    const result = schedule(events, roomList, opts());\n    expect(result.assignments[0].roomId).toBe('room-1');\n  });\n\n  it('falls back to another room when the preferred one is too small', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, attendees: 50, preferredRoom: 'room-0' },\n    ];\n    const roomList = rooms(10, 100);\n    const result = schedule(events, roomList, opts());\n    assertValidSchedule(events, roomList, opts(), result);\n    expect(result.assignments[0].roomId).toBe('room-1');\n  });\n\n  it('falls back when the preferred room is occupied', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 120, preferredRoom: 'room-0' },\n      { id: 'b', name: 'B', duration: 120, preferredRoom: 'room-0' },\n    ];\n    const roomList = rooms(10, 10);\n    const result = schedule(events, roomList, opts());\n    assertValidSchedule(events, roomList, opts(), result);\n    expect(result.unscheduled).toEqual([]);\n    const byId = new Map(result.assignments.map((a) => [a.eventId, a]));\n    expect(byId.get('a')\"'!.roomId).toBe('\"'room-0');\n    expect(byId.get('b')\"'!.roomId).toBe('\"'room-1');\n  });\n\n  it('ignores unknown preferred room ids', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, preferredRoom: 'nope' },\n    ];\n    const result = schedule(events, rooms(10), opts());\n    expect(result.unscheduled).toEqual([]);\n  });\n});\n\ndescribe('batch optimization', () => {\n  it('does not let a greedy first-fit starve later events', () => {\n    // One room, 4-hour window (240 min usable with gaps).\n    // e1 (120) placed at 540 would leave only 105 min — enough for one 60\n    // but not two more 90s. An optimal schedule picks the two 90s + one 60:\n    // 90+15+90+15+60 = 270 > 240, so actually two 90s = 195, or 90+60+60...\n    // Verify it schedules 3 events when naive order would get fewer.\n    const events: Event[] = [\n      { id: 'big', name: 'Big', duration: 150 },\n      { id: 'm1', name: 'M1', duration: 60 },\n      { id: 'm2', name: 'M2', duration: 60 },\n      { id: 'm3', name: 'M3', duration: 60 },\n    ];\n    const options = opts({ startTime: 540, endTime: 780 }); // 240 min\n    const result = schedule(events, rooms(10), options);\n    assertValidSchedule(events, rooms(10), options, result);\n    // Optimal: three 60s (60+15+60+15+60 = 210) beats big+one 60 (225 -> 2 events)\n    expect(result.assignments.length).toBe(3);\n    expect(result.unscheduled).toEqual(['big']);\n  });\n\n  it('uses spare rooms to schedule more events', () => {\n    const events: Event[] = Array.from({ length: 6 }, (_, i) => ({\n      id: \"'`e${i}`,\n      name: `E${i}`,\n      duration: 200,\n    }));\n    const roomList = rooms(10, 10, 10);\n    const options = opts({ startTime: 540, endTime: 1020 });\n    const result = schedule(events, roomList, options);\n    assertValidSchedule(events, roomList, options, result);\n    // each room fits 2 (200+15+200 = 415 <= 480), so all 6 fit\n    expect(result.unscheduled).toEqual([]);\n  });\n\n  it('\"'maximizes scheduled count when rooms are heterogeneous', () => {\n    const events: Event[] = [\n      { id: 'vip', name: 'VIP', duration: 240, attendees: 90 },\n      { id: 's1', name: 'S1', duration: 240, attendees: 5 },\n      { id: 's2', name: 'S2', duration: 240, attendees: 5 },\n    ];\n    const roomList = rooms(10, 100);\n    const options = opts({ startTime: 540, endTime: 780 }); // 240 min: one event per room\n    const result = schedule(events, roomList, options);\n    assertValidSchedule(events, roomList, options, result);\n    // Optimal: vip in big room + one small in small room = 2 scheduled\n    expect(result.assignments).toHaveLength(2);\n    expect(result.unscheduled).toHaveLength(1);\n  });\n\n  it('schedules a realistic conference day', () => {\n    const events: Event[] = [\n      { id: 'keynote', name: 'Keynote', duration: 60, attendees: 200 },\n      { id: 'talk-a', name: 'Talk A', duration: 45, attendees: 50, prerequisites: ['keynote'] },\n      { id: 'talk-b', name: 'Talk B', duration: 45, attendees: 30, prerequisites: ['keynote'] },\n      { id: 'workshop', name: 'Workshop', duration: 120, attendees: 20, prerequisites: ['talk-a'] },\n      { id: 'panel', name: 'Panel', duration: 60, attendees: 80, prerequisites: ['talk-b'] },\n      { id: 'networking', name: 'Networking', duration: 30, attendees: 200, prerequisites: ['panel', 'workshop'] },\n      { id: 'yoga', name: 'Yoga', duration: 30, attendees: 15, preferredRoom: 'small' },\n    ];\n    const roomList: Room[] = [\n      { id: 'hall', name: 'Main Hall', capacity: 250 },\n      { id: 'mid', name: 'Mid Room', capacity: 60 },\n      { id: 'small', name: 'Small Room', capacity: 20 },\n    ];\n    const options = opts({ startTime: 540, endTime: 1080 });\n    const result = schedule(events, roomList, options);\n    assertValidSchedule(events, roomList, options, result);\n    expect(result.unscheduled).toEqual([]);\n    const byId = new Map(result.assignments.map((a) => [a.eventId, a]));\n    expect(byId.get('keynote')\"'!.roomId).toBe('\"'hall');\n    expect(byId.get('yoga')\"'!.roomId).toBe('\"'small');\n    expect(byId.get('networking')\"'!.roomId).toBe('\"'hall');\n  });\n});\n\ndescribe('validation', () => {\n  it('throws on inverted time windows', () => {\n    expect(() =>\n      schedule([], rooms(10), opts({ startTime: 600, endTime: 540 })),\n    ).toThrow(/time window/i);\n  });\n\n  it('throws on non-positive durations', () => {\n    expect(() =>\n      schedule([{ id: 'a', name: 'A', duration: 0 }], rooms(10), opts()),\n    ).toThrow(/duration/i);\n  });\n\n  it('throws on duplicate event ids', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 30 },\n      { id: 'a', name: 'A2', duration: 30 },\n    ];\n    expect(() => schedule(events, rooms(10), opts())).toThrow(/duplicate/i);\n  });\n});\nEOF\ncd /workspace && npx vitest run 2>&1 | tail -40\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
