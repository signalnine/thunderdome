+{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat /workspace/tests/tracker.test.ts'","aggregated_output":"import { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport { TimeTracker } from '../src/index.js';\nimport { mkdtempSync, rmSync, existsSync } from 'fs';\nimport { join } from 'path';\nimport { tmpdir } from 'os';\n\nlet tempDir: string;\nlet filePath: string;\n\nbeforeEach(() => {\n  tempDir = mkdtempSync(join(tmpdir(), 'tracker-test-'));\n  filePath = join(tempDir, 'tracker.json');\n});\n\nafterEach(() => {\n  rmSync(tempDir, { recursive: true, force: true });\n});\n\ndescribe('TimeTracker', () => {\n  // 1. start(\"task name\") creates an active entry with start time\n  it('start() creates an active entry with start time', () => {\n    const tracker = new TimeTracker(filePath);\n    const entry = tracker.start('my task');\n    expect(entry.taskName).toBe('my task');\n    expect(entry.startTime).toBeTruthy();\n    expect(new Date(entry.startTime).getTime()).not.toBeNaN();\n    expect(entry.endTime).toBeNull();\n  });\n\n  // 2. stop() sets end time on active entry\n  it('stop() sets end time on active entry', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('my task');\n    const stopped = tracker.stop();\n    expect(stopped.endTime).toBeTruthy();\n    expect(new Date(stopped.endTime!).getTime()).not.toBeNaN();\n  });\n\n  // 3. Starting a new task while one is running auto-stops the previous one\n  it('starting a new task auto-stops the previous one', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('task 1');\n    const entry2 = tracker.start('task 2');\n    const log = tracker.getLog();\n    const task1 = log.find(e => e.taskName === 'task 1');\n    expect(task1).toBeDefined();\n    expect(task1!.endTime).toBeTruthy();\n    expect(entry2.taskName).toBe('task 2');\n    expect(entry2.endTime).toBeNull();\n  });\n\n  // 4. stop() when nothing is running throws/returns error\n  it('stop() when nothing is running throws an error', () => {\n    const tracker = new TimeTracker(filePath);\n    expect(() => tracker.stop()).toThrow();\n  });\n\n  // 5. getLog() returns all entries\n  it('getLog() returns all entries', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('task 1');\n    tracker.stop();\n    tracker.start('task 2');\n    tracker.stop();\n    const log = tracker.getLog();\n    expect(log).toHaveLength(2);\n    expect(log[0].taskName).toBe('task 1');\n    expect(log[1].taskName).toBe('task 2');\n  });\n\n  // 6. getLog({ since: date }) filters to entries starting on or after that date\n  it('getLog({ since }) filters entries starting on or after that date', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('old task');\n    tracker.stop();\n\n    // Manually modify the first entry to be old\n    const log = tracker.getLog();\n    const oldDate = new Date('2020-01-01T00:00:00.000Z');\n    log[0].startTime = oldDate.toISOString();\n    log[0].endTime = new Date('2020-01-01T01:00:00.000Z').toISOString();\n\n    // Create a new tracker to write the modified data\n    // Instead, let's use a different approach: start tasks at known times\n    const tracker2 = new TimeTracker(filePath);\n    tracker2.start('new task');\n    tracker2.stop();\n\n    const since = new Date(Date.now() - 1000); // 1 second ago\n    const filtered = tracker2.getLog({ since });\n    // The 'new task' should be included, the manually-dated one depends on timing\n    expect(filtered.length).toBeGreaterThanOrEqual(1);\n    expect(filtered.some(e => e.taskName === 'new task')).toBe(true);\n  });\n\n  // 7. getLog({ since }) includes entries that span the boundary (started before, still running)\n  it('getLog({ since }) includes running entries started before the since date', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('spanning task');\n    // Task is still running (no endTime), started now\n    // A running task started before the since date but still active should be included\n    // The spec says: includes entries that span the boundary (started before, still running after)\n    // So a running task with no endTime should be included if it's still active\n    const since = new Date(Date.now() + 60000); // 1 minute from now\n    const filtered = tracker.getLog({ since });\n    expect(filtered.some(e => e.taskName === 'spanning task')).toBe(true);\n  });\n\n  // 8. getSummary() returns object keyed by task name with total duration in ms\n  it('getSummary() returns object keyed by task name with total duration in ms', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('coding');\n    // Small delay to ensure non-zero duration\n    const startTime = Date.now();\n    while (Date.now() - startTime < 10) { /* busy wait */ }\n    tracker.stop();\n    const summary = tracker.getSummary();\n    expect(summary).toHaveProperty('coding');\n    expect(typeof summary['coding']).toBe('number');\n    expect(summary['coding']).toBeGreaterThanOrEqual(0);\n  });\n\n  // 9. getSummary() combines multiple entries for the same task name\n  it('getSummary() combines multiple entries for the same task name', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('coding');\n    const s1 = Date.now();\n    while (Date.now() - s1 < 10) { /* busy wait */ }\n    tracker.stop();\n    tracker.start('coding');\n    const s2 = Date.now();\n    while (Date.now() - s2 < 10) { /* busy wait */ }\n    tracker.stop();\n    const summary = tracker.getSummary();\n    expect(Object.keys(summary)).toHaveLength(1);\n    expect(summary['coding']).toBeGreaterThanOrEqual(0);\n  });\n\n  // 10. Persistence: save to file, create new instance with same file, data preserved\n  it('persists data across instances', () => {\n    const tracker1 = new TimeTracker(filePath);\n    tracker1.start('persisted task');\n    tracker1.stop();\n\n    const tracker2 = new TimeTracker(filePath);\n    const log = tracker2.getLog();\n    expect(log).toHaveLength(1);\n    expect(log[0].taskName).toBe('persisted task');\n  });\n\n  // 11. Empty name throws error\n  it('start() with empty name throws an error', () => {\n    const tracker = new TimeTracker(filePath);\n    expect(() => tracker.start('')).toThrow();\n  });\n\n  // 12. Unicode task names work\n  it('supports unicode task names', () => {\n    const tracker = new TimeTracker(filePath);\n    const entry = tracker.start('コーディング 🚀');\n    expect(entry.taskName).toBe('コーディング 🚀');\n    tracker.stop();\n    const log = tracker.getLog();\n    expect(log[0].taskName).toBe('コーディング 🚀');\n  });\n\n  // 13. getActiveTask() returns current task or null\n  it('getActiveTask() returns current task or null', () => {\n    const tracker = new TimeTracker(filePath);\n    expect(tracker.getActiveTask()).toBeNull();\n    tracker.start('active task');\n    const active = tracker.getActiveTask();\n    expect(active).not.toBeNull();\n    expect(active!.taskName).toBe('active task');\n    tracker.stop();\n    expect(tracker.getActiveTask()).toBeNull();\n  });\n\n  // 14. Multiple start/stop cycles accumulate correctly\n  it('multiple start/stop cycles accumulate correctly', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('task A');\n    tracker.stop();\n    tracker.start('task B');\n    tracker.stop();\n    tracker.start('task A');\n    tracker.stop();\n    const log = tracker.getLog();\n    expect(log).toHaveLength(3);\n    const summary = tracker.getSummary();\n    expect(summary).toHaveProperty('task A');\n    expect(summary).toHaveProperty('task B');\n  });\n\n  // 15. Log entries have correct shape (taskName, startTime, endTime)\n  it('log entries have correct shape', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('shaped task');\n    tracker.stop();\n    const log = tracker.getLog();\n    const entry = log[0];\n    expect(entry).toHaveProperty('taskName');\n    expect(entry).toHaveProperty('startTime');\n    expect(entry).toHaveProperty('endTime');\n    expect(typeof entry.taskName).toBe('string');\n    expect(typeof entry.startTime).toBe('string');\n    expect(typeof entry.endTime).toBe('string');\n  });\n\n  // 16. Summary durations are positive numbers\n  it('summary durations are positive numbers', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('positive task');\n    const s = Date.now();\n    while (Date.now() - s < 5) { /* busy wait */ }\n    tracker.stop();\n    const summary = tracker.getSummary();\n    expect(summary['positive task']).toBeGreaterThanOrEqual(0);\n    expect(typeof summary['positive task']).toBe('number');\n  });\n\n  // 17. Since filter with future date returns empty array\n  it('getLog({ since }) with future date returns empty array', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('past task');\n    tracker.stop();\n    const futureDate = new Date(Date.now() + 86400000); // tomorrow\n    const filtered = tracker.getLog({ since: futureDate });\n    expect(filtered).toHaveLength(0);\n  });\n\n  // 18. Since filter with old date returns all entries\n  it('getLog({ since }) with old date returns all entries', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('task 1');\n    tracker.stop();\n    tracker.start('task 2');\n    tracker.stop();\n    const oldDate = new Date('2000-01-01');\n    const filtered = tracker.getLog({ since: oldDate });\n    expect(filtered).toHaveLength(2);\n  });\n\n  // 19. Stop returns the stopped entry\n  it('stop() returns the stopped entry', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('stoppable task');\n    const stopped = tracker.stop();\n    expect(stopped.taskName).toBe('stoppable task');\n    expect(stopped.endTime).toBeTruthy();\n  });\n\n  // 20. Auto-stop returns/logs the auto-stopped task info\n  it('auto-stop returns the new entry and the previous task is stopped', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('first task');\n    const newEntry = tracker.start('second task');\n    expect(newEntry.taskName).toBe('second task');\n    const log = tracker.getLog();\n    const first = log.find(e => e.taskName === 'first task');\n    expect(first!.endTime).toBeTruthy();\n  });\n\n  // 21. Concurrent start calls don't corrupt data\n  it('rapid sequential start calls do not corrupt data', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('rapid 1');\n    tracker.start('rapid 2');\n    tracker.start('rapid 3');\n    const log = tracker.getLog();\n    expect(log).toHaveLength(3);\n    const active = log.filter(e => e.endTime === null);\n    expect(active).toHaveLength(1);\n    expect(active[0].taskName).toBe('rapid 3');\n  });\n\n  // 22. Summary with no entries returns empty object\n  it('getSummary() with no entries returns empty object', () => {\n    const tracker = new TimeTracker(filePath);\n    const summary = tracker.getSummary();\n    expect(summary).toEqual({});\n  });\n\n  // 23. Log with no entries returns empty array\n  it('getLog() with no entries returns empty array', () => {\n    const tracker = new TimeTracker(filePath);\n    const log = tracker.getLog();\n    expect(log).toEqual([]);\n  });\n\n  // 24. File is created if it doesn't exist\n  it('creates the data file if it does not exist', () => {\n    const newPath = join(tempDir, 'nonexistent.json');\n    expect(existsSync(newPath)).toBe(false);\n    const tracker = new TimeTracker(newPath);\n    tracker.start('creation test');\n    tracker.stop();\n    expect(existsSync(newPath)).toBe(true);\n  });\n\n  // 25. File path is configurable\n  it('file path is configurable', () => {\n    const customPath = join(tempDir, 'custom', 'path', 'data.json');\n    const tracker = new TimeTracker(customPath);\n    tracker.start('custom path task');\n    tracker.stop();\n    expect(existsSync(customPath)).toBe(true);\n\n    const tracker2 = new TimeTracker(customPath);\n    const log = tracker2.getLog();\n    expect(log).toHaveLength(1);\n    expect(log[0].taskName).toBe('custom path task');\n  });\n});\n","exit_code":0,"status":"completed"}}
