+import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+
+export interface Entry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+export interface LogOptions {
+  since?: Date;
+}
+
+export class TimeTracker {
+  private readonly filePath: string;
+  private entries: Entry[];
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = this.load();
+  }
+
+  start(taskName: string): Entry {
+    if (taskName.length === 0) {
+      throw new Error('Task name must not be empty');
+    }
+    const active = this.findActive();
+    if (active !== undefined) {
+      active.endTime = new Date().toISOString();
+    }
+    const entry: Entry = {
+      taskName,
+      startTime: new Date().toISOString(),
+      endTime: null,
+    };
+    this.entries.push(entry);
+    this.save();
+    return { ...entry };
+  }
+
+  stop(): Entry {
+    const active = this.findActive();
+    if (active === undefined) {
+      throw new Error('No task is currently running');
+    }
+    active.endTime = new Date().toISOString();
+    this.save();
+    return { ...active };
+  }
+
+  getActiveTask(): Entry | null {
+    const active = this.findActive();
+    return active === undefined ? null : { ...active };
+  }
+
+  getLog(options?: LogOptions): Entry[] {
+    const since = options?.since;
+    return this.entries
+      .filter((entry) => {
+        if (since === undefined) {
+          return true;
+        }
+        const sinceTime = since.getTime();
+        if (entry.endTime === null) {
+          return true;
+        }
+        return (
+          new Date(entry.startTime).getTime() >= sinceTime ||
+          new Date(entry.endTime).getTime() >= sinceTime
+        );
+      })
+      .map((entry) => ({ ...entry }));
+  }
+
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+    const now = Date.now();
+    for (const entry of this.entries) {
+      const start = new Date(entry.startTime).getTime();
+      const end = entry.endTime === null ? now : new Date(entry.endTime).getTime();
+      const duration = end - start;
+      summary[entry.taskName] = (summary[entry.taskName] ?? 0) + duration;
+    }
+    return summary;
+  }
+
+  private findActive(): Entry | undefined {
+    for (let index = this.entries.length - 1; index >= 0; index -= 1) {
+      if (this.entries[index].endTime === null) {
+        return this.entries[index];
+      }
+    }
+    return undefined;
+  }
+
+  private load(): Entry[] {
+    if (!existsSync(this.filePath)) {
+      return [];
+    }
+    const raw = readFileSync(this.filePath, 'utf8');
+    if (raw.trim().length === 0) {
+      return [];
+    }
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) {
+      return [];
+    }
+    return parsed as Entry[];
+  }
+
+  private save(): void {
+    mkdirSync(dirname(this.filePath), { recursive: true });
+    const tmpPath = `${this.filePath}.tmp`;
+    writeFileSync(tmpPath, JSON.stringify(this.entries, null, 2), 'utf8');
+    renameSync(tmpPath, this.filePath);
+  }
