+++ b/src/cart/index.ts
@@ -0,0 +1,98 @@
+import { EventBus } from '../bus.js';
+import { CartService, CartUpdatedEvent, Events } from '../types.js';
+
+interface CartItem {
+  productId: string;
+  quantity: number;
+}
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: CartItem[];
+}
+
+let nextCartNumber = 1;
+
+function generateCartId(): string {
+  return `cart_${nextCartNumber++}_${Math.random().toString(36).slice(2, 10)}`;
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  function publishUpdate(cart: Cart): void {
+    const event: CartUpdatedEvent = {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: cart.items.map((item) => ({ ...item })),
+    };
+    void bus.emit(Events.CART_UPDATED, event);
+  }
+
+  function snapshot(cart: Cart): Cart {
+    return {
+      id: cart.id,
+      userId: cart.userId,
+      items: cart.items.map((item) => ({ ...item })),
+    };
+  }
+
+  return {
+    createCart(userId: string): string {
+      const cart: Cart = { id: generateCartId(), userId, items: [] };
+      carts.set(cart.id, cart);
+      return cart.id;
+    },
+
+    addItem(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        return;
+      }
+      const existing = cart.items.find((item) => item.productId === productId);
+      if (existing) {
+        existing.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      publishUpdate(cart);
+    },
+
+    removeItem(cartId: string, productId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        return;
+      }
+      cart.items = cart.items.filter((item) => item.productId !== productId);
+      publishUpdate(cart);
+    },
+
+    getCart(cartId: string): Cart | null {
+      const cart = carts.get(cartId);
+      return cart ? snapshot(cart) : null;
+    },
+
+    clearCart(cartId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        return;
+      }
+      cart.items = [];
+      publishUpdate(cart);
+    },
+
+    updateQuantity(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        return;
+      }
+      const existing = cart.items.find((item) => item.productId === productId);
+      if (!existing) {
+        return;
+      }
+      existing.quantity = quantity;
+      publishUpdate(cart);
+    },
+  };
+}
