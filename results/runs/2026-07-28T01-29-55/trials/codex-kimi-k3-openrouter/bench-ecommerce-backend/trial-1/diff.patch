@@ -0,0 +1,84 @@
+import { EventBus } from '../bus.js';
+import {
+  Events,
+  PaymentProcessedEvent,
+  PaymentService,
+  PaymentStatus,
+} from '../types.js';
+
+export interface PaymentServiceOptions {
+  simulateFailure?: boolean;
+  simulateTimeout?: boolean;
+  processingDelayMs?: number;
+}
+
+interface Transaction {
+  id: string;
+  orderId: string;
+  amount: number;
+  status: PaymentStatus;
+  refunded: boolean;
+}
+
+let nextTransactionNumber = 1;
+
+function generateTransactionId(): string {
+  return `tx_${nextTransactionNumber++}_${Math.random().toString(36).slice(2, 10)}`;
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export function createPaymentService(
+  bus: EventBus,
+  options: PaymentServiceOptions = {},
+): PaymentService {
+  const transactions = new Map<string, Transaction>();
+  const processingDelayMs = options.processingDelayMs ?? 10;
+
+  return {
+    async processPayment(
+      orderId: string,
+      amount: number,
+    ): Promise<{ status: PaymentStatus; transactionId?: string; error?: string }> {
+      await delay(processingDelayMs);
+
+      let result: { status: PaymentStatus; transactionId?: string; error?: string };
+
+      if (options.simulateTimeout) {
+        result = { status: PaymentStatus.TIMEOUT, error: 'Payment processing timed out' };
+      } else if (options.simulateFailure) {
+        result = { status: PaymentStatus.FAILED, error: 'Payment was declined' };
+      } else {
+        const transaction: Transaction = {
+          id: generateTransactionId(),
+          orderId,
+          amount,
+          status: PaymentStatus.SUCCESS,
+          refunded: false,
+        };
+        transactions.set(transaction.id, transaction);
+        result = { status: PaymentStatus.SUCCESS, transactionId: transaction.id };
+      }
+
+      const event: PaymentProcessedEvent = {
+        orderId,
+        status: result.status,
+        transactionId: result.transactionId,
+        error: result.error,
+      };
+      await bus.emit(Events.PAYMENT_PROCESSED, event);
+      return result;
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      const transaction = transactions.get(transactionId);
+      if (!transaction || transaction.status !== PaymentStatus.SUCCESS || transaction.refunded) {
+        return false;
+      }
+      transaction.refunded = true;
+      return true;
+    },
+  };
+}
