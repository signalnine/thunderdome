t).toBeNull();\\n  });\\n\\n  it('should list products filtered by category', () => {\\n    catalog.createProduct('Widget', 9.99, 'gadgets');\\n    catalog.createProduct('Gizmo', 19.99, 'gadgets');\\n    catalog.createProduct('Book', 12.99, 'books');\\n\\n    const gadgets = catalog.listProducts('gadgets');\\n    expect(gadgets).toHaveLength(2);\\n\\n    const books = catalog.listProducts('books');\\n    expect(books).toHaveLength(1);\\n\\n    const all = catalog.listProducts();\\n    expect(all).toHaveLength(3);\\n  });\\n\\n  it('should search products by name or category', () => {\\n    catalog.createProduct('Blue Widget', 9.99, 'gadgets');\\n    catalog.createProduct('Red Gizmo', 19.99, 'electronics');\\n\\n    const results = catalog.searchProducts('widget');\\n    expect(results).toHaveLength(1);\\n    expect(results[0].name).toBe('Blue Widget');\\n\\n    const catResults = catalog.searchProducts('electronics');\\n    expect(catResults).toHaveLength(1);\\n  });\\n\\n  it('should update and remove products', () => {\\n    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\\n    catalog.updateProduct(id, { price: 14.99 });\\n    expect(catalog.getProduct(id)!.price).toBe(14.99);\\n\\n    const removed = catalog.removeProduct(id);\\n    expect(removed).toBe(true);\\n    expect(catalog.getProduct(id)).toBeNull();\\n\\n    const removedAgain = catalog.removeProduct(id);\\n    expect(removedAgain).toBe(false);\\n  });\\n});\\nimport { describe, it, expect, beforeEach } from 'vitest';\\nimport { EventBus } from '../src/bus.js';\\nimport { createInventoryService } from '../src/inventory/index.js';\\n\\ndescribe('InventoryService (unit)', () => {\\n  let bus: EventBus;\\n  let inventory: ReturnType<typeof createInventoryService>;\\n\\n  beforeEach(() => {\\n    bus = new EventBus();\\n    inventory = createInventoryService(bus);\\n  });\\n\\n  it('should set and get stock for a product', () => {\\n    inventory.setStock('p1', 100);\\n    expect(inventory.getStock('p1')).toBe(100);\\n  });\\n\\n  it('should return 0 for unknown product stock', () => {\\n    expect(inventory.getStock('unknown')).toBe(0);\\n  });\\n\\n  it('should reserve stock when sufficient', () => {\\n    inventory.setStock('p1', 10);\\n    const result = inventory.reserve('p1', 3);\\n    expect(result).toBe(true);\\n    expect(inventory.getStock('p1')).toBe(7);\\n  });\\n\\n  it('should fail to reserve when insufficient stock', () => {\\n    inventory.setStock('p1', 2);\\n    const result = inventory.reserve('p1', 5);\\n    expect(result).toBe(false);\\n    expect(inventory.getStock('p1')).toBe(2);\\n  });\\n\\n  it('should release reserved stock', () => {\\n    inventory.setStock('p1', 10);\\n    inventory.reserve('p1', 3);\\n    inventory.release('p1', 3);\\n    expect(inventory.getStock('p1')).toBe(10);\\n  });\\n\\n  it('should emit inventory updated events', () => {\\n    inventory.setStock('p1', 50);\\n    const log = bus.getLog();\\n    expect(log.length).toBeGreaterThan(0);\\n    expect(log[0].event).toBe('inventory:updated');\\n  });\\n});\\nimport { describe, it, expect, beforeEach } from 'vitest';\\nimport { EventBus } from '../src/bus.js';\\nimport { createCartService } from '../src/cart/index.js';\\n\\ndescribe('CartService (unit)', () => {\\n  let bus: EventBus;\\n  let cart: ReturnType<typeof createCartService>;\\n\\n  beforeEach(() => {\\n    bus = new EventBus();\\n    cart = createCartService(bus);\\n  });\\n\\n  it('should create a cart and return its id', () => {\\n    const id = cart.createCart('user1');\\n    expect(id).toBeDefined();\\n    expect(typeof id).toBe('string');\\n  });\\n\\n  it('should add items to a cart', () => {\\n    const id = cart.createCart('user1');\\n    cart.addItem(id, 'p1', 2);\\n    const c = cart.getCart(id);\\n    expect(c).not.toBeNull();\\n    expect(c!.items).toHaveLength(1);\\n    expect(c!.items[0].productId).toBe('p1');\\n    expect(c!.items[0].quantity).toBe(2);\\n  });\\n\\n  it('should merge 