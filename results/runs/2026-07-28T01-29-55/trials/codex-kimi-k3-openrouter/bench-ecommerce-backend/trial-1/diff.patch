new file mode 100644
index 0000000..757eb6f
--- /dev/null
+++ b/src/notifications/index.ts
@@ -0,0 +1,80 @@
+import { EventBus } from '../bus.js';
+import {
+  Events,
+  NotificationService,
+  NotificationSentEvent,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+} from '../types.js';
+
+interface Notification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const notificationsByUser = new Map<string, Notification[]>();
+  const orderUsers = new Map<string, string>();
+
+  function deliver(userId: string, type: string, message: string): void {
+    if (!subscribers.has(userId)) {
+      return;
+    }
+    const notification: Notification = { type, message, timestamp: Date.now() };
+    const existing = notificationsByUser.get(userId);
+    if (existing) {
+      existing.push(notification);
+    } else {
+      notificationsByUser.set(userId, [notification]);
+    }
+    const event: NotificationSentEvent = { userId, type, message };
+    void bus.emit(Events.NOTIFICATION_SENT, event);
+  }
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const event = payload as OrderCreatedEvent;
+    orderUsers.set(event.orderId, event.userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    const event = payload as OrderStatusChangedEvent;
+    const userId = orderUsers.get(event.orderId);
+    if (userId === undefined) {
+      return;
+    }
+    deliver(
+      userId,
+      'order_status',
+      `Order ${event.orderId} status changed from ${event.previousStatus} to ${event.status}`,
+    );
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const event = payload as PaymentProcessedEvent;
+    const userId = orderUsers.get(event.orderId);
+    if (userId === undefined) {
+      return;
+    }
+    const message =
+      event.status === 'success'
+        ? `Payment for order ${event.orderId} processed successfully`
+        : `Payment for order ${event.orderId} ended with status ${event.status}`;
+    deliver(userId, 'payment', message);
+  });
+
+  return {
+    subscribe(userId: string): void {
+      subscribers.add(userId);
+      if (!notificationsByUser.has(userId)) {
+        notificationsByUser.set(userId, []);
+      }
+    },
+
+    getNotifications(userId: string): Notification[] {
+      return [...(notificationsByUser.get(userId) ?? [])];
+    },
+  };
+}
