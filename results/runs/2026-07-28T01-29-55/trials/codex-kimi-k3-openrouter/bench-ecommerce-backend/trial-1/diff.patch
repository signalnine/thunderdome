+import { EventBus } from '../bus.js';
+import {
+  AnalyticsEvent,
+  AnalyticsService,
+  CartUpdatedEvent,
+  Events,
+  OrderCreatedEvent,
+  PaymentProcessedEvent,
+  PaymentStatus,
+} from '../types.js';
+
+const TRACKED_EVENTS = [
+  Events.PRODUCT_CREATED,
+  Events.INVENTORY_UPDATED,
+  Events.LOW_STOCK_ALERT,
+  Events.CART_UPDATED,
+  Events.PRICE_CALCULATED,
+  Events.ORDER_CREATED,
+  Events.ORDER_STATUS_CHANGED,
+  Events.PAYMENT_PROCESSED,
+  Events.NOTIFICATION_SENT,
+] as const;
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const cartItems = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const orderTotals = new Map<string, number>();
+  const orderCarts = new Map<string, string>();
+  let revenue = 0;
+
+  function countEvent(eventType: string, data: Record<string, unknown>): void {
+    eventCounts.set(eventType, (eventCounts.get(eventType) ?? 0) + 1);
+    const analyticsEvent: AnalyticsEvent = {
+      event: eventType,
+      data,
+      timestamp: Date.now(),
+    };
+    void bus.emit(Events.ANALYTICS_EVENT, analyticsEvent);
+  }
+
+  bus.on(Events.CART_UPDATED, (payload) => {
+    const event = payload as CartUpdatedEvent;
+    cartItems.set(
+      event.cartId,
+      event.items.map((item) => ({ ...item })),
+    );
+    countEvent(Events.CART_UPDATED, payload as Record<string, unknown>);
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const event = payload as OrderCreatedEvent;
+    orderTotals.set(event.orderId, event.total);
+    orderCarts.set(event.orderId, event.cartId);
+    countEvent(Events.ORDER_CREATED, payload as Record<string, unknown>);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const event = payload as PaymentProcessedEvent;
+    if (event.status === PaymentStatus.SUCCESS) {
+      revenue += orderTotals.get(event.orderId) ?? 0;
+    }
+    countEvent(Events.PAYMENT_PROCESSED, payload as Record<string, unknown>);
+  });
+
+  for (const eventType of TRACKED_EVENTS) {
+    if (
+      eventType === Events.CART_UPDATED ||
+      eventType === Events.ORDER_CREATED ||
+      eventType === Events.PAYMENT_PROCESSED
+    ) {
+      continue;
+    }
+    bus.on(eventType, (payload) => {
+      countEvent(eventType, (payload ?? {}) as Record<string, unknown>);
+    });
+  }
+
+  return {
+    getEventCount(eventType: string): number {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue(): number {
+      return revenue;
+    },
+
+    getConversionRate(): number {
+      const cartsCreated = cartItems.size;
+      if (cartsCreated === 0) {
+        return 0;
+      }
+      return orderTotals.size / cartsCreated;
+    },
+
+    getTopProducts(limit: number): Array<{ productId: string; count: number }> {
+      const totals = new Map<string, number>();
+      for (const cartId of orderCarts.values()) {
+        const items = cartItems.get(cartId);
+        if (!items) {
+          continue;
+        }
+        for (const item of items) {
+          totals.set(item.productId, (totals.get(item.productId) ?? 0) + item.quantity);
+        }
+      }
+      return [...totals.entries()]
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count)
+        .slice(0, limit);
+    },
+  };
+}
