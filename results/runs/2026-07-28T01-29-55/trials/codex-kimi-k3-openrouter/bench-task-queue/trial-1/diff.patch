+  let candidate = Math.floor(fromMs / MINUTE_MS) * MINUTE_MS + MINUTE_MS;
+  // Scan up to ~8 days of minutes, which covers every supported expression.
+  for (let i = 0; i < 12000; i++) {
+    if (cronMatches(parsed, new Date(candidate))) {
+      return candidate;
+    }
+    candidate += MINUTE_MS;
+  }
+  throw new Error('Unable to compute next cron occurrence');
+}
