+  id: string;
+  queueName: string;
+  payload: any;
+  status: TaskStatus;
+  priority: number;
+  createdAt: Date;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  failCount: number;
+  lastError?: any;
+  dependsOn: string[];
+}
+
