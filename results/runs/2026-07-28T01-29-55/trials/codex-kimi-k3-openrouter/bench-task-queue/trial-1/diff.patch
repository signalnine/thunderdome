+  }
+
+  retryDLQ(taskId: string): Task | null {
+    const task = this.tasks.get(taskId);
+    if (!task) {
+      return null;
+    }
+    const queue = this.getQueue(task.queueName);
+    const index = queue.dlq.indexOf(task);
+    if (index === -1) {
+      return null;
+    }
+    queue.dlq.splice(index, 1);
+    task.status = 'pending';
+    task.attempts = 0;
+    task.availableAt = new Date();
+    queue.pending.push(task);
+    return task;
+  }
+
+  clearDLQ(queueName: string): void {
