+
+function cronMatches(parsed: ParsedCron, date: Date): boolean {
+  const minute = date.getMinutes();
+  const minuteOk =
+    'every' in parsed.minute ? minute % parsed.minute.every === 0 : minute === parsed.minute.at;
+  const hourOk = parsed.hour === null || date.getHours() === parsed.hour;
+  return minuteOk && hourOk;
+}
