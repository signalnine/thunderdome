+{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'cat /workspace/tests/phase-08.test.ts /workspace/tests/phase-09.test.ts'","aggregated_output":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 8: Concurrency Control', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('setConcurrency limits the number of concurrent processing tasks', () => {\n    queue.setConcurrency('work', 2);\n    queue.enqueue('work', { job: 1 });\n    queue.enqueue('work', { job: 2 });\n    queue.enqueue('work', { job: 3 });\n\n    const t1 = queue.dequeue('work');\n    const t2 = queue.dequeue('work');\n    expect(t1).not.toBeNull();\n    expect(t2).not.toBeNull();\n\n    // Third dequeue should return null (at limit)\n    const t3 = queue.dequeue('work');\n    expect(t3).toBeNull();\n  });\n\n  it('dequeue returns null when at concurrency limit even if tasks available', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { job: 'a' });\n    queue.enqueue('work', { job: 'b' });\n\n    queue.dequeue('work'); // takes slot\n    const second = queue.dequeue('work');\n    expect(second).toBeNull();\n  });\n\n  it('completing a task frees a concurrency slot', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { job: 'first' });\n    queue.enqueue('work', { job: 'second' });\n\n    const first = queue.dequeue('work')!;\n    expect(queue.dequeue('work')).toBeNull(); // at limit\n\n    queue.complete(first.id);\n\n    const second = queue.dequeue('work');\n    expect(second).not.toBeNull();\n    expect(second!.payload).toEqual({ job: 'second' });\n  });\n\n  it('getConcurrency returns current and max info', () => {\n    queue.setConcurrency('work', 3);\n    queue.enqueue('work', { job: 1 });\n    queue.enqueue('work', { job: 2 });\n\n    const info1 = queue.getConcurrency('work');\n    expect(info1.max).toBe(3);\n    expect(info1.current).toBe(0);\n\n    queue.dequeue('work');\n    const info2 = queue.getConcurrency('work');\n    expect(info2.current).toBe(1);\n\n    queue.dequeue('work');\n    const info3 = queue.getConcurrency('work');\n    expect(info3.current).toBe(2);\n  });\n\n  it('default concurrency is unlimited', () => {\n    for (let i = 0; i < 100; i++) {\n      queue.enqueue('work', { job: i });\n    }\n\n    const tasks = [];\n    for (let i = 0; i < 100; i++) {\n      const t = queue.dequeue('work');\n      if (!t) break;\n      tasks.push(t);\n    }\n\n    expect(tasks.length).toBe(100);\n  });\n\n  it('concurrency limits are independent per queue', () => {\n    queue.setConcurrency('queue-a', 1);\n    queue.setConcurrency('queue-b', 2);\n\n    queue.enqueue('queue-a', { q: 'a1' });\n    queue.enqueue('queue-a', { q: 'a2' });\n    queue.enqueue('queue-b', { q: 'b1' });\n    queue.enqueue('queue-b', { q: 'b2' });\n    queue.enqueue('queue-b', { q: 'b3' });\n\n    queue.dequeue('queue-a'); // 1 processing in queue-a\n    expect(queue.dequeue('queue-a')).toBeNull(); // at limit for queue-a\n\n    queue.dequeue('queue-b'); // 1 processing in queue-b\n    expect(queue.dequeue('queue-b')).not.toBeNull(); // can still dequeue (limit 2)\n    expect(queue.dequeue('queue-b')).toBeNull(); // now at limit\n  });\n\n  it('concurrency respects priority ordering', () => {\n    queue.setConcurrency('work', 1);\n    queue.enqueue('work', { name: 'low' }, { priority: 9 });\n    queue.enqueue('work', { name: 'high' }, { priority: 1 });\n\n    const task = queue.dequeue('work')!;\n    expect(task.payload).toEqual({ name: 'high' });\n  });\n});\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 9: Progress and Cancellation', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('updateProgress sets the percentage for a task', () => {\n    queue.enqueue('work', { job: 'progress' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 50);\n    const progress = queue.getProgress(task.id);\n    expect(progress!.percent).toBe(50);\n  });\n\n  it('getProgress returns current progress info', () => {\n    queue.enqueue('work', { job: 'progress' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 75, 'Almost done');\n    const progress = queue.getProgress(task.id);\n\n    expect(progress).not.toBeNull();\n    expect(progress!.percent).toBe(75);\n    expect(progress!.message).toBe('Almost done');\n    expect(progress!.updatedAt).toBeInstanceOf(Date);\n  });\n\n  it('onProgress callback fires when progress is updated', () => {\n    queue.enqueue('work', { job: 'callback' });\n    const task = queue.dequeue('work')!;\n\n    const updates: Array<{ percent: number; message?: string }> = [];\n    queue.onProgress(task.id, (info) => {\n      updates.push({ percent: info.percent, message: info.message });\n    });\n\n    queue.updateProgress(task.id, 25, 'Starting');\n    queue.updateProgress(task.id, 50, 'Halfway');\n    queue.updateProgress(task.id, 100, 'Done');\n\n    expect(updates).toHaveLength(3);\n    expect(updates[0]).toEqual({ percent: 25, message: 'Starting' });\n    expect(updates[1]).toEqual({ percent: 50, message: 'Halfway' });\n    expect(updates[2]).toEqual({ percent: 100, message: 'Done' });\n  });\n\n  it('cancel sets task status to cancelled', () => {\n    const task = queue.enqueue('work', { job: 'cancel-me' });\n    queue.cancel(task.id);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('cancelled pending task is removed from the queue', () => {\n    queue.enqueue('work', { job: 'stay' });\n    const toCancel = queue.enqueue('work', { job: 'cancel' });\n    queue.enqueue('work', { job: 'stay2' });\n\n    queue.cancel(toCancel.id);\n\n    const t1 = queue.dequeue('work')!;\n    const t2 = queue.dequeue('work')!;\n    expect(t1.payload).toEqual({ job: 'stay' });\n    expect(t2.payload).toEqual({ job: 'stay2' });\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('cancelled processing task has its status set to cancelled', () => {\n    queue.enqueue('work', { job: 'processing-cancel' });\n    const task = queue.dequeue('work')!;\n    expect(task.status).toBe('processing');\n\n    queue.cancel(task.id);\n    expect(task.status).toBe('cancelled');\n  });\n\n  it('cancelled task is not retried', () => {\n    queue.enqueue('work', { job: 'no-retry' }, { maxRetries: 3 });\n    const task = queue.dequeue('work')!;\n\n    queue.cancel(task.id);\n\n    // Even after long delay, cancelled task should not reappear\n    vi.advanceTimersByTime(100000);\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('progress message is optional', () => {\n    queue.enqueue('work', { job: 'no-msg' });\n    const task = queue.dequeue('work')!;\n\n    queue.updateProgress(task.id, 42);\n    const progress = queue.getProgress(task.id);\n\n    expect(progress!.percent).toBe(42);\n    expect(progress!.message).toBeUndefined();\n  });\n});\n","exit_code":0,"status":"completed"}}
