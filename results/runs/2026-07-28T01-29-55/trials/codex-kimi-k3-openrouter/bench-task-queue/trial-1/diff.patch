+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+export type TaskHandler = (task: Task) => Promise<void> | void;
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: any;
+  active: boolean;
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: string;
+}
+
+interface QueueState {
+  pending: Task[];
+  processing: Set<Task>;
+  dlq: Task[];
+  concurrencyMax: number;
+  middleware: Middleware[];
+  created: boolean;
+}
+
+interface ParsedCron {
+  minute: { every: number } | { at: number };
+  hour: number | null;
+}
+
+interface InternalSchedule extends Schedule {
+  parsed: ParsedCron;
+  nextDue: number;
+}
+
+const MINUTE_MS = 60 * 1000;
+
+function parseCron(expression: string): ParsedCron {
+  const parts = expression.trim().split(/\s+/);
+  if (parts.length !== 5) {
+    throw new Error(`Unsupported cron expression: ${expression}`);
+  }
+  const [minuteField, hourField, domField, monthField, dowField] = parts;
+  if (domField !== '*' || monthField !== '*' || dowField !== '*') {
+    throw new Error(`Unsupported cron expression: ${expression}`);
+  }
+
+  let minute: ParsedCron['minute'];
+  if (minuteField.startsWith('*/')) {
+    const step = Number(minuteField.slice(2));
+    if (!Number.isInteger(step) || step <= 0 || step > 59) {
+      throw new Error(`Unsupported cron expression: ${expression}`);
+    }
+    minute = { every: step };
+  } else if (/^\d+$/.test(minuteField)) {
+    minute = { at: Number(minuteField) };
+  } else {
+    throw new Error(`Unsupported cron expression: ${expression}`);
+  }
+
+  let hour: number | null;
+  if (hourField === '*') {
+    hour = null;
+  } else if (/^\d+$/.test(hourField)) {
+    hour = Number(hourField);
+  } else {
+    throw new Error(`Unsupported cron expression: ${expression}`);
+  }
+
+  return { minute, hour };
