+import { describe, it, expect } from 'vitest';
+import { simulate, findSwappedWires, Gate } from './index.js';
+
+function buildCorrectAdder(numBits: number): Gate[] {
+  const pad = (n: number) => String(n).padStart(2, '0');
+  const gates: Gate[] = [];
+
+  // Bit 0: half adder
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: `c00` });
+
+  // Bits 1 through numBits-1: full adders
+  for (let i = 1; i < numBits; i++) {
+    const xi = `x${pad(i)}`;
+    const yi = `y${pad(i)}`;
+    const zi = `z${pad(i)}`;
+    const ti = `t${pad(i)}`;
+    const ai = `a${pad(i)}`;
+    const bi = `b${pad(i)}`;
+    const ci = `c${pad(i)}`;
+    const carryIn = `c${pad(i - 1)}`;
+
+    gates.push({ op: 'XOR', in1: xi, in2: yi, out: ti });
+    gates.push({ op: 'XOR', in1: ti, in2: carryIn, out: zi });
+    gates.push({ op: 'AND', in1: xi, in2: yi, out: ai });
+    gates.push({ op: 'AND', in1: ti, in2: carryIn, out: bi });
+    gates.push({ op: 'OR', in1: ai, in2: bi, out: ci });
+  }
+
+  // Final carry becomes z_max
+  gates[gates.length - 1] = {
+    ...gates[gates.length - 1],
+    out: `z${pad(numBits)}`,
+  };
+
+  return gates;
+}
+
+function swapWires(gates: Gate[], swaps: Array<[string, string]>): Gate[] {
+  return gates.map(g => {
+    let out = g.out;
+    for (const [a, b] of swaps) {
+      if (out === a) out = b;
+      else if (out === b) out = a;
+    }
+    return { ...g, out };
+  });
+}
+
+describe('findSwappedWires larger circuits', () => {
+  it('finds swaps in a 10-bit adder', () => {
+    const correct = buildCorrectAdder(10);
+    const swaps: Array<[string, string]> = [
+      ['z01', 'a01'],
+      ['z03', 'b03'],
+      ['z05', 't05'],
+      ['c00', 'z10'],
+    ];
+    const swapped = swapWires(correct, swaps);
+    const result = findSwappedWires(swapped);
+    expect(result.sort()).toEqual(['a01', 'b03', 'c00', 't05', 'z01', 'z03', 'z05', 'z10'].sort());
+  });
+
+  it('finds swaps in a 24-bit adder', () => {
+    const correct = buildCorrectAdder(24);
+    const swaps: Array<[string, string]> = [
+      ['z02', 'a02'],
+      ['z10', 'b10'],
+      ['z15', 't15'],
+      ['c00', 'z24'],
+    ];
+    const swapped = swapWires(correct, swaps);
+    const result = findSwappedWires(swapped);
+    expect(result.sort()).toEqual(['a02', 'b10', 'c00', 't15', 'z02', 'z10', 'z15', 'z24'].sort());
+  });
+
+  it('finds swaps in a 45-bit adder within time limit', () => {
+    const correct = buildCorrectAdder(45);
+    const swaps: Array<[string, string]> = [
+      ['z05', 'a05'],
+      ['z12', 'b12'],
+      ['z25', 't25'],
+      ['c00', 'z45'],
+    ];
+    const swapped = swapWires(correct, swaps);
+
+    const start = Date.now();
+    const result = findSwappedWires(swapped);
+    const elapsed = Date.now() - start;
+
+    expect(result.sort()).toEqual(['a05', 'b12', 'c00', 't25', 'z05', 'z12', 'z25', 'z45'].sort());
+    expect(elapsed).toBeLessThan(5000);
+  });
+
+  it('finds swaps between internal wires in a 45-bit adder', () => {
+    const correct = buildCorrectAdder(45);
+    // More challenging: swaps between internal wires, not just z-wires
+    const swaps: Array<[string, string]> = [
+      ['a10', 'b11'],  // internal <-> internal
+      ['z05', 't06'],  // z <-> internal
+      ['z20', 'a20'],  // z <-> gen
+      ['z35', 'b35'],  // z <-> prop
+    ];
+    const swapped = swapWires(correct, swaps);
+
+    const start = Date.now();
+    const result = findSwappedWires(swapped);
+    const elapsed = Date.now() - start;
+
+    const expected = ['a10', 'a20', 'b11', 'b35', 't06', 'z05', 'z20', 'z35'].sort();
+    expect(result.sort()).toEqual(expected);
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
