+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const wires: Record<string, number> = { ...inputs };
+  const remaining = [...gates];
+  let progress = true;
+  while (remaining.length > 0 && progress) {
+    progress = false;
+    for (let i = remaining.length - 1; i >= 0; i--) {
+      const g = remaining[i];
+      if (g.in1 in wires && g.in2 in wires) {
+        const a = wires[g.in1];
+        const b = wires[g.in2];
+        if (g.op === 'AND') wires[g.out] = a & b;
+        else if (g.op === 'OR') wires[g.out] = a | b;
+        else wires[g.out] = a ^ b;
+        remaining.splice(i, 1);
+        progress = true;
+      }
+    }
+  }
+  return wires;
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  const producerOf = new Map<string, Gate>();
+  for (const g of gates) {
+    producerOf.set(g.out, g);
+  }
+
+  let maxZ = -1;
+  for (const g of gates) {
+    if (g.out.startsWith('z')) {
+      const n = parseInt(g.out.slice(1), 10);
+      if (n > maxZ) maxZ = n;
+    }
+  }
+
+  const numBits = maxZ;
+  const pad = (n: number) => String(n).padStart(2, '0');
+  const isZWire = (w: string) => /^z\d+$/.test(w);
+  const isXYWire = (w: string) => /^[xy]\d+$/.test(w);
+
+  // Step 1: Find structurally suspicious wires using adder rules.
+  // In a correct adder:
+  //   XOR(xi, yi) for i=0 -> z00
+  //   XOR(xi, yi) for i>0 -> internal wire (NOT z)
+  //   XOR(non-x/y, non-x/y) -> zi (IS z-wire)
+  //   AND(...) -> internal wire (NOT z, except z_max could be AND for single-bit)
+  //   OR(...) -> internal wire (NOT z, except z_max)
+  //
+  // Violations identify swapped output wires.
+
+  const suspicious = new Set<string>();
+
+  for (const g of gates) {
+    const bothXY = isXYWire(g.in1) && isXYWire(g.in2);
+    const sameBit = (() => {
+      const m1 = g.in1.match(/^[xy](\d+)$/);
+      const m2 = g.in2.match(/^[xy](\d+)$/);
+      return m1 && m2 && m1[1] === m2[1] ? parseInt(m1[1]) : -1;
+    })();
+
+    if (g.op === 'XOR') {
+      if (bothXY && sameBit === 0) {
+        if (g.out !== 'z00') {
+          suspicious.add('z00');
+          suspicious.add(g.out);
+        }
+      } else if (bothXY && sameBit > 0) {
+        // XOR(xi, yi) for i>0 should NOT output z-wire
+        if (isZWire(g.out)) suspicious.add(g.out);
+      } else if (!bothXY) {
+        // XOR with internal inputs should output z-wire
+        if (!isZWire(g.out)) suspicious.add(g.out);
+      }
+    } else if (g.op === 'AND') {
+      if (isZWire(g.out)) suspicious.add(g.out);
+    } else if (g.op === 'OR') {
+      if (isZWire(g.out) && g.out !== `z${pad(maxZ)}`) suspicious.add(g.out);
+    }
+  }
+
+  // Also check: z-wires produced by wrong gate types
+  for (let i = 0; i <= maxZ; i++) {
+    const zi = `z${pad(i)}`;
+    const g = producerOf.get(zi);
+    if (!g) continue;
+    if (i === 0) {
+      if (g.op !== 'XOR' || !isXYWire(g.in1) || !isXYWire(g.in2)) suspicious.add(zi);
+    } else if (i < maxZ) {
+      if (g.op !== 'XOR') suspicious.add(zi);
+      else if (isXYWire(g.in1) && isXYWire(g.in2)) suspicious.add(zi);
+    }
+  }
+
+  if (suspicious.size === 8) {
+    return [...suspicious].sort();
+  }
+
+  // Step 2: If structural rules didn't find exactly 8, use iterative brute force
+  // to find the remaining swaps. Start with known suspicious wires.
+
+  const allOutputWires = gates.map(g => g.out);
+  const xAllOnes = (1n << BigInt(numBits)) - 1n;
+
+  const swapOutputs = (gs: Gate[], w1: string, w2: string): Gate[] =>
+    gs.map(g => {
+      if (g.out === w1) return { ...g, out: w2 };
+      if (g.out === w2) return { ...g, out: w1 };
+      return g;
+    });
+
+  const getZValue = (result: Record<string, number>): bigint => {
+    let val = 0n;
+    for (let i = 0; i <= maxZ; i++) {
+      if (result[`z${pad(i)}`] === 1) val |= 1n << BigInt(i);
+    }
+    return val;
+  };
+
+  const buildInputs = (x: bigint, y: bigint): Record<string, number> => {
+    const inputs: Record<string, number> = {};
+    for (let i = 0; i < numBits; i++) {
+      inputs[`x${pad(i)}`] = Number((x >> BigInt(i)) & 1n);
+      inputs[`y${pad(i)}`] = Number((y >> BigInt(i)) & 1n);
+    }
+    return inputs;
+  };
+
+  // Generate test cases
+  const testCases: Array<[bigint, bigint]> = [
+    [xAllOnes, 0n],
+    [0n, xAllOnes],
+    [xAllOnes, xAllOnes],
+    [0n, 0n],
+  ];
+  for (let i = 0; i < Math.min(numBits, 10); i++) {
+    testCases.push([1n << BigInt(i), 0n]);
+    testCases.push([1n << BigInt(i), 1n << BigInt(i)]);
+  }
+
+  // Quick check: does the circuit already produce correct results?
+  const isCorrect = (gs: Gate[]): boolean => {
+    for (const [x, y] of testCases) {
+      const result = simulate(gs, buildInputs(x, y));
+      if (getZValue(result) !== x + y) return false;
+    }
+    return true;
+  };
+
+  // If we have suspicious wires, try to find correct pairings among them
+  // plus some additional wires from all output wires
+  if (suspicious.size >= 4 && suspicious.size <= 12) {
+    const suspiciousArr = [...suspicious];
+    const nonSuspicious = allOutputWires.filter(w => !suspicious.has(w));
+    const missing = 8 - suspicious.size;
+
+    // Try adding `missing` wires from non-suspicious, then try all pairings
+    if (missing <= 4) {
+      const combos = combinations(nonSuspicious, missing);
+      for (const extra of combos) {
+        const candidateWires = [...suspiciousArr, ...extra];
+        if (candidateWires.length !== 8) continue;
+        if (tryAllPairings(gates, candidateWires, isCorrect, swapOutputs)) {
+          return candidateWires.sort();
+        }
+      }
+    }
+  }
+
+  // Full iterative brute force
+  const countFails = (gs: Gate[]): number => {
+    let fails = 0;
+    for (const [x, y] of testCases) {
+      const result = simulate(gs, buildInputs(x, y));
+      if (getZValue(result) !== x + y) fails++;
+    }
+    return fails;
+  };
+
+  let currentGates = [...gates];
+  const foundSwaps: string[] = [];
+
+  for (let round = 0; round < 4; round++) {
+    let bestSwap: [string, string] | null = null;
+    let bestFails = Infinity;
+
+    for (let i = 0; i < allOutputWires.length; i++) {
+      if (foundSwaps.includes(allOutputWires[i])) continue;
+      for (let j = i + 1; j < allOutputWires.length; j++) {
+        if (foundSwaps.includes(allOutputWires[j])) continue;
+
+        const swapped = swapOutputs(currentGates, allOutputWires[i], allOutputWires[j]);
+        const fails = countFails(swapped);
+        if (fails < bestFails) {
+          bestFails = fails;
+          bestSwap = [allOutputWires[i], allOutputWires[j]];
+          if (fails === 0) break;
+        }
+      }
+      if (bestFails === 0) break;
+    }
+
+    if (bestSwap) {
+      currentGates = swapOutputs(currentGates, bestSwap[0], bestSwap[1]);
+      foundSwaps.push(bestSwap[0], bestSwap[1]);
+    }
+  }
+
+  return [...new Set(foundSwaps)].sort();
+}
+
+function tryAllPairings(
+  gates: Gate[],
+  wires: string[],
+  isCorrect: (gs: Gate[]) => boolean,
+  swapOutputs: (gs: Gate[], w1: string, w2: string) => Gate[]
+): boolean {
+  const n = wires.length;
+  if (n !== 8) return false;
+
+  const used = new Array(n).fill(false);
+  const pairs: Array<[number, number]> = [];
+
+  const solve = (): boolean => {
+    const first = used.indexOf(false);
+    if (first === -1) {
+      let gs = [...gates];
+      for (const [a, b] of pairs) {
+        gs = swapOutputs(gs, wires[a], wires[b]);
+      }
+      return isCorrect(gs);
+    }
+    used[first] = true;
+    for (let j = first + 1; j < n; j++) {
+      if (used[j]) continue;
+      used[j] = true;
+      pairs.push([first, j]);
+      if (solve()) return true;
+      pairs.pop();
+      used[j] = false;
+    }
+    used[first] = false;
+    return false;
+  };
+
+  return solve();
+}
+
+function* combinations<T>(arr: T[], k: number): Generator<T[]> {
+  if (k === 0) { yield []; return; }
+  if (arr.length < k) return;
+  for (let i = 0; i <= arr.length - k; i++) {
+    for (const rest of combinations(arr.slice(i + 1), k - 1)) {
+      yield [arr[i], ...rest];
+    }
+  }
+}
