h non-x/y inputs SHOULD output z-wires\n\n  const suspicious: string[] = [];\n\n  for (const g of gates) {\n    const bothXY = isXYWire(g.in1) && isXYWire(g.in2);\n\n    if (g.op === 'XOR') {\n      if (bothXY) {\n        // XOR(xi, yi) gate\n        const bitMatch1 = g.in1.match(/^[xy](\\d+)$/);\n        const bitMatch2 = g.in2.match(/^[xy](\\d+)$/);\n        if (bitMatch1 && bitMatch2 && bitMatch1[1] === bitMatch2[1]) {\n          const bit = parseInt(bitMatch1[1], 10);\n          if (bit === 0) {\n            // XOR(x00, y00) should output z00\n            if (g.out !== 'z00') {\n              suspicious.push('z00', g.out);\n            }\n          } else {\n            // XOR(xi, yi) for i>0 should NOT output a z-wire\n            if (isZWire(g.out)) {\n              suspicious.push(g.out);\n            }\n          }\n        }\n      } else {\n        // XOR with non-x/y inputs: should output a z-wire (it's the sum gate)\n        if (!isZWire(g.out)) {\n          suspicious.push(g.out);\n        }\n      }\n    } else if (g.op === 'AND') {\n      // AND gates should NOT output z-wires\n      if (isZWire(g.out) && g.out !== `z${pad(maxZ)}`) {\n        suspicious.push(g.out);\n      }\n    } else if (g.op === 'OR') {\n      // OR gates should NOT output z-wires (except z_max)\n      if (isZWire(g.out) && g.out !== `z${pad(maxZ)}`) {\n        suspicious.push(g.out);\n      }\n    }\n  }\n\n  // Also check: z-wires produced by wrong gates\n  for (let i = 0; i <= maxZ; i++) {\n    const zi = `z${pad(i)}`;\n    const g = producerOf.get(zi);\n    if (!g) continue;\n\n    if (i === 0) {\n      // z00 should be produced by XOR(x00, y00)\n      if (g.op !== 'XOR' || !isXYWire(g.in1) || !isXYWire(g.in2)) {\n        suspicious.push(zi);\n      }\n    } else if (i === maxZ) {\n      // z_max should be produced by OR (carry) - could also be AND for special cases\n      // We'll be lenient here\n    } else {\n      // zi should be produced by XOR with non-x/y inputs\n      if (g.op !== 'XOR') {\n        suspicious.push(zi);\n      }\n    }\n  }\n\n  const unique = [...new Set(suspicious)];\n  if (unique.length === 8) {\n    return unique.sort();\n  }\n\n  // If we don't have exactly 8, fall back to brute-force search\n  // Use the suspicious wires as candidates to narrow the search\n  return findSwappedByBruteForce(gates, maxZ, unique);\n}\n\nfunction findSwappedByBruteForce(\n  gates: Gate[],\n  maxZ: number,\n  candidateWires: string[]\n): string[] {\n  const numBits = maxZ;\n  const pad = (n: number) => String(n).padStart(2, '0');\n  const xAllOnes = (1n << BigInt(numBits)) - 1n;\n\n  const swapOutputs = (gs: Gate[], w1: string, w2: string): Gate[] =>\n    gs.map(g => {\n      if (g.out === w1) return { ...g, out: w2 };\n      if (g.out === w2) return { ...g, out: w1 };\n      return g;\n    });\n\n  const getZValue = (result: Record<string, number>): bigint => {\n    let val = 0n;\n    for (let i = 0; i <= maxZ; i++) {\n      if (result[`z${pad(i)}`] === 1) val |= 1n << BigInt(i);\n    }\n    return val;\n  };\n\n  const buildInputs = (x: bigint, y: bigint): Record<string, number> => {\n    const inputs: Record<string, number> = {};\n    for (let i = 0; i < numBits; i++) {\n      inputs[`x${pad(i)}`] = Number((x >> BigInt(i)) & 1n);\n      inputs[`y${pad(i)}`] = Number((y >> BigInt(i)) & 1n);\n    }\n    return inputs;\n  };\n\n  // Generate test cases that exercise different bits\n  const testCases: Array<{ x: bigint; y: bigint; expected: bigint }> = [];\n  testCases.push({ x: xAllOnes, y: 0n, expected: xAllOnes });\n  testCases.push({ x: 0n, y: xAllOnes, expected: xAllOnes });\n  testCases.push({ x: xAllOnes, y: xAllOnes, expected: xAllOnes * 2n });\n  testCases.push({ x: 0n, y: 0n, expected: 0n });\n  for (let i = 0; i < Math.min(numBits, 15); i++) {\n    testCases.push({ x: 1n << BigInt(i), y: 0n, expected: 1n << BigInt(i) });\n    testCases.push({ x: 1n << BigInt(i), y: 1n << BigInt(i), expected: 1n << BigInt(i + 1) });\n  }\n\n  const countFails = (gs: Gate[]): number => {\n    let fails = 0;\n    for (const tc of testCases) {\n      const result = simulate(gs, buildInputs(tc.x, tc.y));\n      if (getZValue(result) !== tc.expected) fails++;\n    }\n    return fails;\n  };\n\n  // If we have candidate wires from structural analysis, use them\n  // Otherwise, use all output wires\n  const allOutputWires = gates.map(g => g.out);\n\n  // Strategy: try all pairs among candidate wires first,\n  // then fall back to all pairs if needed\n  let currentGates = [...gates];\n  const foundSwaps: string[] = [];\n\n  const tryFindSwap = (gs: Gate[], excluded: string[]): [string, string] | null => {\n    // First try among candidate wires\n    const candidates = candidateWires.length > 0 ? candidateWires : allOutputWires;\n    let bestSwap: [string, string] | null = null;\n    let bestFails = Infinity;\n\n    for (let i = 0; i < candidates.length; i++) {\n      if (excluded.includes(candidates[i])) continue;\n      for (let j = i + 1; j < allOutputWires.length; j++) {\n        const w1 = candidates[i];\n        const w2 = allOutputWires[j];\n        if (w1 === w2 || excluded.includes(w2)) continue;\n\n        const swapped = swapOutputs(gs, w1, w2);\n        const fails = countFails(swapped);\n        if (fails < bestFails) {\n          bestFails = fails;\n          bestSwap = [w1, w2];\n          if (fails === 0) return bestSwap;\n        }\n      }\n    }\n    return bestSwap;\n  };\n\n  for (let round = 0; round < 4; round++) {\n    const swap = tryFindSwap(currentGates, foundSwaps);\n    if (swap) {\n      currentGates = swapOutputs(currentGates, swap[0], swap[1]);\n      foundSwaps.push(swap[0], swap[1]);\n    }\n  }\n\n  return [...new Set(foundSwaps)].sort();\n}\n","structuredPatch":[{"oldStart":28,"oldLines":7,"newStart":28,"newLines":7,"lines":[" }"," "," export function findSwappedWires(gates: Gate[]): string[] {","-  // Build a map from output wire -> producing gate","+  // Build maps","   