@@ -0,0 +1,230 @@
+import { describe, it, expect } from 'vitest';
+import { solveToggle, solveCounter, Machine } from '../src/index.js';
+
+/* ------------------------- brute-force oracles ------------------------- */
+
+function bruteToggle(machine: Machine): number[] | null {
+  const N = machine.target.length;
+  const M = machine.buttons.length;
+  let best: number[] | null = null;
+  const lexLess = (a: number[], b: number[]): boolean => {
+    for (let i = 0; i < Math.min(a.length, b.length); i++) {
+      if (a[i] !== b[i]) return a[i] < b[i];
+    }
+    return a.length < b.length;
+  };
+  for (let mask = 0; mask < 1 << M; mask++) {
+    const state = new Array<boolean>(N).fill(false);
+    const pressed: number[] = [];
+    for (let j = 0; j < M; j++) {
+      if (mask & (1 << j)) {
+        pressed.push(j);
+        for (const l of machine.buttons[j]) state[l] = !state[l];
+      }
+    }
+    let ok = true;
+    for (let l = 0; l < N; l++) if (state[l] !== machine.target[l]) { ok = false; break; }
+    if (!ok) continue;
+    if (
+      best === null ||
+      pressed.length < best.length ||
+      (pressed.length === best.length && lexLess(pressed, best))
+    ) {
+      best = pressed;
+    }
+  }
+  return best;
+}
+
+function bruteCounter(lights: number[], buttons: number[][], p: number): number[] | null {
+  const N = lights.length;
+  const M = buttons.length;
+  let best: number[] | null = null;
+  const presses = new Array<number>(M).fill(0);
+  let result: number[] | null = null;
+  const lexLess = (a: number[], b: number[]): boolean => {
+    for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return a[i] < b[i];
+    return false;
+  };
+  const rec = (idx: number): void => {
+    if (idx === M) {
+      const state = new Array<number>(N).fill(0);
+      for (let j = 0; j < M; j++) for (const c of buttons[j]) state[c] = (state[c] + presses[j]) % p;
+      for (let c = 0; c < N; c++) if (state[c] !== ((lights[c] % p) + p) % p) return;
+      const sum = presses.reduce((a, b) => a + b, 0);
+      const bestSum = best ? best.reduce((a, b) => a + b, 0) : Infinity;
+      if (best === null || sum < bestSum || (sum === bestSum && lexLess(presses, best))) {
+        best = presses.slice();
+        result = best;
+      }
+      return;
+    }
+    for (let v = 0; v < p; v++) {
+      presses[idx] = v;
+      rec(idx + 1);
+    }
+    presses[idx] = 0;
+  };
+  rec(0);
+  return result;
+}
+
+/* ------------------------------ helpers -------------------------------- */
+
+let seed = 12345;
+function rng(): number {
+  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+  return seed / 0x7fffffff;
+}
+function randInt(n: number): number {
+  return Math.floor(rng() * n);
+}
+
+/* ------------------------------- tests --------------------------------- */
+
+describe('solveToggle', () => {
+  it('returns null for the unsatisfiable TASK example', () => {
+    const machine: Machine = {
+      target: [true, true, false, true],
+      buttons: [[0, 1], [1, 2, 3], [0, 3]],
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it('empty target needs no presses', () => {
+    expect(solveToggle({ target: [false, false], buttons: [[0], [1]] })).toEqual([]);
+  });
+
+  it('finds a simple solution', () => {
+    // light0 on, light1 on; button0->{0}, button1->{1}
+    expect(solveToggle({ target: [true, true], buttons: [[0], [1]] })).toEqual([0, 1]);
+  });
+
+  it('prefers fewer presses', () => {
+    // button2 alone sets both lights; cheaper than button0+button1
+    const m: Machine = { target: [true, true], buttons: [[0], [1], [0, 1]] };
+    expect(solveToggle(m)).toEqual([2]);
+  });
+
+  it('matches brute force on random small instances', () => {
+    for (let t = 0; t < 400; t++) {
+      const N = 1 + randInt(8);
+      const M = 1 + randInt(10);
+      const buttons: number[][] = [];
+      for (let j = 0; j < M; j++) {
+        const s: number[] = [];
+        for (let l = 0; l < N; l++) if (rng() < 0.5) s.push(l);
+        buttons.push(s);
+      }
+      const target = Array.from({ length: N }, () => rng() < 0.5);
+      const machine = { target, buttons };
+      const got = solveToggle(machine);
+      const exp = bruteToggle(machine);
+      if (exp === null) {
+        expect(got).toBeNull();
+      } else {
+        expect(got).not.toBeNull();
+        expect(got!.length).toBe(exp.length);
+        expect(got).toEqual(exp);
+      }
+    }
+  });
+});
+
+describe('solveCounter', () => {
+  it('handles a unique mod-5 solution', () => {
+    // counter0 = b0; want counter0 = 3
+    expect(solveCounter([3], [[0]], 5)).toEqual([3]);
+  });
+
+  it('null when impossible', () => {
+    // no buttons but a non-zero target
+    expect(solveCounter([2], [], 5)).toBeNull();
+  });
+
+  it('minimizes total presses', () => {
+    // counter0: b0+b1 ; counter1: b1 ; want [0,3] mod5
+    // b1=3, b0 = -3 = 2 mod5 -> total 5 ; or other combos; brute checks
+    const lights = [0, 3];
+    const buttons = [[0], [0, 1]];
+    expect(solveCounter(lights, buttons, 5)).toEqual(bruteCounter(lights, buttons, 5));
+  });
+
+  it('matches brute force on random small instances', () => {
+    const primes = [2, 3, 5, 7];
+    for (let t = 0; t < 300; t++) {
+      const p = primes[randInt(primes.length)];
+      const N = 1 + randInt(4);
+      const M = 1 + randInt(5);
+      const buttons: number[][] = [];
+      for (let j = 0; j < M; j++) {
+        const s: number[] = [];
+        for (let c = 0; c < N; c++) if (rng() < 0.5) s.push(c);
+        buttons.push(s);
+      }
+      const lights = Array.from({ length: N }, () => randInt(p));
+      const got = solveCounter(lights, buttons, p);
+      const exp = bruteCounter(lights, buttons, p);
+      if (exp === null) {
+        expect(got).toBeNull();
+      } else {
+        expect(got).not.toBeNull();
+        // verify it actually solves
+        const state = new Array<number>(N).fill(0);
+        for (let j = 0; j < M; j++) for (const c of buttons[j]) state[c] = (state[c] + got![j]) % p;
+        for (let c = 0; c < N; c++) expect(state[c]).toBe(lights[c]);
+        const sumGot = got!.reduce((a, b) => a + b, 0);
+        const sumExp = (exp as number[]).reduce((a, b) => a + b, 0);
+        expect(sumGot).toBe(sumExp);
+        expect(got).toEqual(exp);
+      }
+    }
+  });
+});
+
+describe('performance / scale', () => {
+  it('solves a 40x40 toggle system quickly', () => {
+    const N = 40;
+    const M = 40;
+    const buttons: number[][] = [];
+    for (let j = 0; j < M; j++) {
+      const s: number[] = [];
+      for (let l = 0; l < N; l++) if (rng() < 0.5) s.push(l);
+      buttons.push(s);
+    }
+    // build a satisfiable target by pressing a known subset
+    const truth = Array.from({ length: M }, () => rng() < 0.3);
+    const target = new Array<boolean>(N).fill(false);
+    for (let j = 0; j < M; j++) if (truth[j]) for (const l of buttons[j]) target[l] = !target[l];
+    const start = Date.now();
+    const got = solveToggle({ target, buttons });
+    expect(Date.now() - start).toBeLessThan(5000);
+    expect(got).not.toBeNull();
+    // verify correctness
+    const state = new Array<boolean>(N).fill(false);
+    for (const j of got!) for (const l of buttons[j]) state[l] = !state[l];
+    expect(state).toEqual(target);
+  });
+
+  it('solves a 40x40 counter system mod 97 quickly', () => {
+    const N = 40;
+    const M = 40;
+    const p = 97;
+    const buttons: number[][] = [];
+    for (let j = 0; j < M; j++) {
+      const s: number[] = [];
+      for (let c = 0; c < N; c++) if (rng() < 0.5) s.push(c);
+      buttons.push(s);
+    }
+    const truth = Array.from({ length: M }, () => randInt(p));
+    const lights = new Array<number>(N).fill(0);
+    for (let j = 0; j < M; j++) for (const c of buttons[j]) lights[c] = (lights[c] + truth[j]) % p;
+    const start = Date.now();
+    const got = solveCounter(lights, buttons, p);
+    expect(Date.now() - start).toBeLessThan(5000);
+    expect(got).not.toBeNull();
+    const state = new Array<number>(N).fill(0);
+    for (let j = 0; j < M; j++) for (const c of buttons[j]) state[c] = (state[c] + got![j]) % p;
+    for (let c = 0; c < N; c++) expect(state[c]).toBe(lights[c]);
+  });
+});
