+/**
+ * Factory Reset — button-toggle puzzle solvers.
+ *
+ * Part 1 (solveToggle) is a system of linear equations over GF(2): each button
+ * is a 0/1 variable, each light an equation, and we want the minimum-weight
+ * solution (fewest button presses), breaking ties by lexicographically smallest
+ * set of button indices.
+ *
+ * Part 2 (solveCounter) is the same idea over GF(p) for prime p: each button is
+ * pressed 0..p-1 times, each counter an equation, and we minimize the total
+ * number of presses, breaking ties by lexicographically smallest press array.
+ *
+ * Both reduce the system with Gaussian elimination, then search the affine
+ * solution space (particular solution + null space). Finding the true minimum
+ * over a coset is exponential in the null-space dimension k, so we enumerate
+ * that space directly. Random 40x40 systems are almost always (near) full rank,
+ * giving a tiny k; the elimination collapses the problem before any search.
+ */
+
+export interface Machine {
+  target: boolean[]; // desired state for each light (all start off)
+  buttons: number[][]; // buttons[i] = array of light indices toggled by button i
+}
+
+/* ------------------------------- Part 1 -------------------------------- */
+
+function popcount32(x: number): number {
+  x = x - ((x >>> 1) & 0x55555555);
+  x = (x & 0x33333333) + ((x >>> 2) & 0x33333333);
+  x = (x + (x >>> 4)) & 0x0f0f0f0f;
+  return (Math.imul(x, 0x01010101) >>> 24) & 0xff;
+}
+
+function ctz32(x: number): number {
+  // index of lowest set bit; x must be non-zero
+  return 31 - Math.clz32(x & -x);
+}
+
+/**
+ * Find the minimum set of buttons to press so the lights match `target`.
+ * Returns ascending button indices, or null if unsatisfiable.
+ */
+export function solveToggle(machine: Machine): number[] | null {
+  const N = machine.target.length;
+  const M = machine.buttons.length;
+
+  // Build one equation per light. Bits 0..M-1 hold button coefficients; bit M
+  // holds the right-hand side (target). Rows are bigints (M <= 40).
+  const RHS = BigInt(M);
+  const rows: bigint[] = new Array(N);
+  for (let l = 0; l < N; l++) rows[l] = machine.target[l] ? 1n << RHS : 0n;
+  for (let j = 0; j < M; j++) {
+    const bit = 1n << BigInt(j);
+    for (const l of machine.buttons[j]) {
+      if (l >= 0 && l < N) rows[l] ^= bit; // toggling twice cancels (parity)
+    }
+  }
+
+  // Reduce to reduced row echelon form over the coefficient columns.
+  const pivotCols: number[] = [];
+  let pivot = 0;
+  for (let col = 0; col < M && pivot < N; col++) {
+    const colBit = 1n << BigInt(col);
+    let sel = -1;
+    for (let r = pivot; r < N; r++) {
+      if (rows[r] & colBit) {
+        sel = r;
+        break;
+      }
+    }
+    if (sel === -1) continue;
+    [rows[pivot], rows[sel]] = [rows[sel], rows[pivot]];
+    for (let r = 0; r < N; r++) {
+      if (r !== pivot && rows[r] & colBit) rows[r] ^= rows[pivot];
+    }
+    pivotCols.push(col);
+    pivot++;
+  }
+
+  // Inconsistent if any row has no coefficients but a set right-hand side.
+  const coeffMask = (1n << BigInt(M)) - 1n;
+  for (let r = 0; r < N; r++) {
+    if ((rows[r] & coeffMask) === 0n && rows[r] >> RHS & 1n) return null;
+  }
+
+  const isPivot = new Array<boolean>(M).fill(false);
+  for (const c of pivotCols) isPivot[c] = true;
+  const freeCols: number[] = [];
+  for (let c = 0; c < M; c++) if (!isPivot[c]) freeCols.push(c);
+  const k = freeCols.length;
+
+  // Solutions are represented as two 32-bit limbs (bits 0..31 and 32..M-1).
+  const setBit = (limbs: { lo: number; hi: number }, col: number): void => {
+    if (col < 32) limbs.lo |= 1 << col;
+    else limbs.hi |= 1 << (col - 32);
+  };
+
+  // Particular solution: all free variables 0, so each pivot equals its RHS.
+  const part = { lo: 0, hi: 0 };
+  for (let i = 0; i < pivotCols.length; i++) {
+    if (rows[i] >> RHS & 1n) setBit(part, pivotCols[i]);
+  }
+
+  // Null-space basis: set one free variable to 1; dependent pivots follow.
+  const basis: { lo: number; hi: number; weight: number }[] = [];
+  for (const f of freeCols) {
+    const v = { lo: 0, hi: 0 };
+    setBit(v, f);
+    const fBit = 1n << BigInt(f);
+    for (let i = 0; i < pivotCols.length; i++) {
+      if (rows[i] & fBit) setBit(v, pivotCols[i]);
+    }
+    basis.push({ lo: v.lo >>> 0, hi: v.hi >>> 0, weight: popcount32(v.lo) + popcount32(v.hi) });
+  }
+
+  // Returns true if (curLo,curHi) is the lexicographically smaller index set:
+  // the set containing the smallest differing index is smaller.
+  const isSmaller = (curLo: number, curHi: number, bestLo: number, bestHi: number): boolean => {
+    const dLo = (curLo ^ bestLo) >>> 0;
+    if (dLo !== 0) return (curLo & (dLo & -dLo)) !== 0;
+    const dHi = (curHi ^ bestHi) >>> 0;
+    if (dHi !== 0) return (curHi & (dHi & -dHi)) !== 0;
+    return false;
+  };
+
+  let curLo = part.lo >>> 0;
+  let curHi = part.hi >>> 0;
+  let pop = popcount32(curLo) + popcount32(curHi);
+  let bestLo = curLo;
+  let bestHi = curHi;
+  let bestPop = pop;
+
+  // Enumerate the 2^k coset via Gray code: each step flips exactly one basis
+  // vector, so we update the running weight incrementally.
+  const total = 2 ** k;
+  for (let i = 1; i < total; i++) {
+    const g = basis[ctz32(i)];
+    const overlap = popcount32((curLo & g.lo) >>> 0) + popcount32((curHi & g.hi) >>> 0);
+    pop += g.weight - 2 * overlap;
+    curLo = (curLo ^ g.lo) >>> 0;
+    curHi = (curHi ^ g.hi) >>> 0;
+    if (pop < bestPop || (pop === bestPop && isSmaller(curLo, curHi, bestLo, bestHi))) {
+      bestPop = pop;
+      bestLo = curLo;
+      bestHi = curHi;
+    }
+  }
+
+  const result: number[] = [];
+  for (let c = 0; c < M; c++) {
+    const bit = c < 32 ? bestLo & (1 << c) : bestHi & (1 << (c - 32));
+    if (bit) result.push(c);
+  }
+  return result;
+}
+
+/* ------------------------------- Part 2 -------------------------------- */
+
+function modPow(base: number, exp: number, mod: number): number {
+  let result = 1;
+  base %= mod;
+  while (exp > 0) {
+    if (exp & 1) result = (result * base) % mod;
+    base = (base * base) % mod;
+    exp >>>= 1;
+  }
+  return result;
+}
+
+function modInverse(a: number, p: number): number {
+  // p is prime, so a^(p-2) is the inverse (a not divisible by p).
+  return modPow(((a % p) + p) % p, p - 2, p);
+}
+
+/**
+ * Solve the counter variant over GF(p). Returns press counts per button
+ * minimizing total presses (then lexicographically smallest), or null.
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const p = modulus;
+  const N = lights.length;
+  const M = buttons.length;
+
+  // Augmented matrix: N counter equations, M button coefficients + RHS column.
+  const A: number[][] = new Array(N);
+  for (let r = 0; r < N; r++) {
+    A[r] = new Array(M + 1).fill(0);
+    A[r][M] = ((lights[r] % p) + p) % p;
+  }
+  for (let j = 0; j < M; j++) {
+    for (const c of buttons[j]) {
+      if (c >= 0 && c < N) A[c][j] = (A[c][j] + 1) % p; // press adds 1 per occurrence
+    }
+  }
+
+  const pivotCols: number[] = [];
+  let pivot = 0;
+  for (let col = 0; col < M && pivot < N; col++) {
+    let sel = -1;
+    for (let r = pivot; r < N; r++) {
+      if (A[r][col] % p !== 0) {
+        sel = r;
+        break;
+      }
+    }
+    if (sel === -1) continue;
+    [A[pivot], A[sel]] = [A[sel], A[pivot]];
+    const inv = modInverse(A[pivot][col], p);
+    for (let c = col; c <= M; c++) A[pivot][c] = (A[pivot][c] * inv) % p;
+    for (let r = 0; r < N; r++) {
+      if (r !== pivot && A[r][col] % p !== 0) {
+        const factor = A[r][col];
+        for (let c = col; c <= M; c++) {
+          A[r][c] = ((A[r][c] - factor * A[pivot][c]) % p + p) % p;
+        }
+      }
+    }
+    pivotCols.push(col);
+    pivot++;
+  }
+
+  // Inconsistent if a row has all-zero coefficients but a non-zero RHS.
+  for (let r = 0; r < N; r++) {
+    let allZero = true;
+    for (let c = 0; c < M; c++) {
+      if (A[r][c] % p !== 0) {
+        allZero = false;
+        break;
+      }
+    }
+    if (allZero && A[r][M] % p !== 0) return null;
+  }
+
+  const isPivot = new Array<boolean>(M).fill(false);
+  for (const c of pivotCols) isPivot[c] = true;
+  const freeCols: number[] = [];
+  for (let c = 0; c < M; c++) if (!isPivot[c]) freeCols.push(c);
+  const k = freeCols.length;
+  const rank = pivotCols.length;
+
+  // Reorder free variables so the odometer's hottest digit (position 0, which
+  // increments on nearly every step) has the fewest dependent pivots. This
+  // minimises the dominant inner loop; it does not affect which solution is
+  // chosen, since lexicographic comparison uses original column positions.
+  const nnz = (col: number): number => {
+    let n = 0;
+    for (let i = 0; i < rank; i++) if (A[i][col] % p !== 0) n++;
+    return n;
+  };
+  freeCols.sort((a, b) => nnz(a) - nnz(b) || a - b);
+
+  // Per free variable, the sparse list of dependent pivots and coefficients.
+  const colPivot: Int32Array[] = new Array(k);
+  const colCoef: Int32Array[] = new Array(k);
+  for (let t = 0; t < k; t++) {
+    const pv: number[] = [];
+    const cf: number[] = [];
+    for (let i = 0; i < rank; i++) {
+      const c = A[i][freeCols[t]] % p;
+      if (c !== 0) {
+        pv.push(i);
+        cf.push(c);
+      }
+    }
+    colPivot[t] = Int32Array.from(pv);
+    colCoef[t] = Int32Array.from(cf);
+  }
+
+  // Column lookup for lexicographic comparison without materialising arrays.
+  const colKind = new Int32Array(M); // 0 => free, 1 => pivot
+  const pivotOfCol = new Int32Array(M).fill(-1);
+  const freeOfCol = new Int32Array(M).fill(-1);
+  for (let i = 0; i < rank; i++) pivotOfCol[pivotCols[i]] = i;
+  for (let t = 0; t < k; t++) freeOfCol[freeCols[t]] = t;
+  for (let c = 0; c < M; c++) colKind[c] = freeOfCol[c] >= 0 ? 0 : 1;
+
+  // Running state: free values, derived pivot residues, and the two sums.
+  const freeVals = new Int32Array(k);
+  const pivotVals = new Int32Array(rank);
+  let pivotSum = 0;
+  for (let i = 0; i < rank; i++) {
+    pivotVals[i] = A[i][M] % p;
+    pivotSum += pivotVals[i];
+  }
+  let freeSum = 0;
+
+  let bestTotal = Infinity;
+  let bestFree = new Int32Array(k);
+  let bestPivot = new Int32Array(rank);
+
+  const consider = (total: number): void => {
+    if (total > bestTotal) return;
+    if (total < bestTotal) {
+      bestTotal = total;
+      bestFree = freeVals.slice();
+      bestPivot = pivotVals.slice();
+      return;
+    }
+    // Tie on total presses: keep the lexicographically smaller press array.
+    for (let c = 0; c < M; c++) {
+      const cur = colKind[c] === 0 ? freeVals[freeOfCol[c]] : pivotVals[pivotOfCol[c]];
+      const best = colKind[c] === 0 ? bestFree[freeOfCol[c]] : bestPivot[pivotOfCol[c]];
+      if (cur !== best) {
+        if (cur < best) {
+          bestFree = freeVals.slice();
+          bestPivot = pivotVals.slice();
+        }
+        return;
+      }
+    }
+  };
+
+  consider(freeSum + pivotSum); // all-zero free assignment
+  const pm1 = p - 1;
+  if (k > 0) {
+    // Odometer over [0,p-1]^k with incremental pivot updates. The common step
+    // increments digit 0 (delta +1); carries (rare) wrap higher digits to 0.
+    for (;;) {
+      let pos = 0;
+      while (pos < k && freeVals[pos] === pm1) {
+        const pv = colPivot[pos];
+        const cf = colCoef[pos];
+        for (let q = 0; q < pv.length; q++) {
+          const i = pv[q];
+          const old = pivotVals[i];
+          let np = (old + cf[q] * pm1) % p; // delta = -(p-1)
+          if (np >= p) np -= p;
+          pivotSum += np - old;
+          pivotVals[i] = np;
+        }
+        freeSum -= pm1;
+        freeVals[pos] = 0;
+        pos++;
+      }
+      if (pos === k) break; // exhausted all assignments
+      const pv = colPivot[pos];
+      const cf = colCoef[pos];
+      for (let q = 0; q < pv.length; q++) {
+        const i = pv[q];
+        const old = pivotVals[i];
+        let np = old - cf[q]; // delta = +1
+        if (np < 0) np += p;
+        pivotSum += np - old;
+        pivotVals[i] = np;
+      }
+      freeSum += 1;
+      freeVals[pos]++;
+      consider(freeSum + pivotSum);
+    }
+  }
+
+  const result = new Array<number>(M).fill(0);
+  for (let t = 0; t < k; t++) result[freeCols[t]] = bestFree[t];
+  for (let i = 0; i < rank; i++) result[pivotCols[i]] = bestPivot[i];
+  return result;
+}
