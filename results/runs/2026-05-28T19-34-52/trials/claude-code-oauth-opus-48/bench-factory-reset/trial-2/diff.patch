+
+describe('solveCounter', () => {
+  it('basic single counter', () => {
+    expect(solveCounter([3], [[0]], 5)).toEqual([3]);
+  });
+
+  it('no solution returns null', () => {
+    // counter 0 target 1 but no button touches it
+    expect(solveCounter([1], [[]], 5)).toBeNull();
+  });
+
+  it('randomized vs brute force (small)', () => {
+    const rng = rngFactory(7);
+    const primes = [2, 3, 5, 7];
+    for (let t = 0; t < 300; t++) {
+      const n = 1 + Math.floor(rng() * 3);
+      const m = 1 + Math.floor(rng() * 4);
+      const mod = primes[Math.floor(rng() * primes.length)];
+      const buttons: number[][] = [];
+      for (let b = 0; b < m; b++) {
+        const set: number[] = [];
+        for (let c = 0; c < n; c++) if (rng() < 0.5) set.push(c);
+        buttons.push(set);
+      }
+      const lights: number[] = [];
+      for (let c = 0; c < n; c++) lights.push(Math.floor(rng() * mod));
+      const got = solveCounter(lights, buttons, mod);
+      const exp = bruteCounter(lights, buttons, mod);
+      expect(got).toEqual(exp);
+      if (got) {
+        const counters = new Array(n).fill(0);
+        for (let b = 0; b < m; b++) for (const c of buttons[b]) counters[c] = (counters[c] + got[b]) % mod;
+        expect(counters).toEqual(lights.map((v) => ((v % mod) + mod) % mod));
+      }
+    }
+  });
+
+  it('handles larger modulus unique solution', () => {
+    const n = 10;
+    const buttons = Array.from({ length: n }, (_, i) => [i]);
+    const lights = Array.from({ length: n }, (_, i) => (i * 13) % 97);
+    expect(solveCounter(lights, buttons, 97)).toEqual(lights);
+  });
+
+  it('prefers fewer total presses with wraparound', () => {
+    // mod 5, two buttons both increment counter 0. target 0.
+    // options summing to 0 mod 5: (0,0) total 0 best.
+    expect(solveCounter([0], [[0], [0]], 5)).toEqual([0, 0]);
+  });
+});
