+// Factory Reset: button-toggle / counter puzzles solved via linear algebra.
+//
+// Part 1 (solveToggle) is a linear system over GF(2): each button is a 0/1
+// variable, lights are equations, "toggle" is XOR. We want the minimum-weight
+// (fewest buttons) solution, tie-broken by lexicographically smallest sorted
+// index set.
+//
+// Part 2 (solveCounter) is a linear system over GF(p) (p prime): each button is
+// pressed 0..p-1 times, counters are equations mod p. We want the solution with
+// minimum total presses, tie-broken by lexicographically smallest result array.
+
+export interface Machine {
+  target: boolean[]; // desired state for each light (all start off)
+  buttons: number[][]; // buttons[i] = array of light indices toggled by button i
+}
+
+// ---------------------------------------------------------------------------
+// GF(2) helpers (Part 1)
+// ---------------------------------------------------------------------------
+
+function popcount(x: bigint): number {
+  let n = 0;
+  while (x > 0n) {
+    x &= x - 1n;
+    n++;
+  }
+  return n;
+}
+
+// Compare two button-index sets (encoded as bitmasks) by the lexicographic
+// order of their ascending index lists. Returns negative if `a` sorts before
+// `b`, positive if after, 0 if equal.
+//
+// The list with the smaller element at the first point of divergence wins, which
+// means: at the lowest bit where the masks differ, whichever mask *has* that bit
+// owns the smaller index there and is therefore lexicographically smaller.
+function compareIndexMasks(a: bigint, b: bigint): number {
+  const diff = a ^ b;
+  if (diff === 0n) return 0;
+  const lowest = diff & -diff;
+  return (a & lowest) !== 0n ? -1 : 1;
+}
+
+function maskToIndices(mask: bigint): number[] {
+  const out: number[] = [];
+  let i = 0;
+  while (mask > 0n) {
+    if (mask & 1n) out.push(i);
+    mask >>= 1n;
+    i++;
+  }
+  return out;
+}
+
+interface GF2System {
+  consistent: boolean;
+  particular: bigint; // a solution (button-space bitmask), free vars = 0
+  kernel: bigint[]; // basis of the solution-space kernel (button-space)
+}
+
+// Row-reduce the GF(2) system A x = b where columns are buttons and rows are
+// lights. Returns a particular solution plus a kernel basis, or marks the system
+// inconsistent.
+function gf2Solve(numButtons: number, rows: { coef: bigint; rhs: number }[]): GF2System {
+  const work = rows.map((r) => ({ coef: r.coef, rhs: r.rhs }));
+  const pivotCol: number[] = []; // pivotCol[r] = column of pivot in reduced row r
+  const pivotRows: { coef: bigint; rhs: number }[] = [];
+
+  let pr = 0;
+  for (let col = 0; col < numButtons && pr < work.length; col++) {
+    const bit = 1n << BigInt(col);
+    let sel = -1;
+    for (let r = pr; r < work.length; r++) {
+      if (work[r].coef & bit) {
+        sel = r;
+        break;
+      }
+    }
+    if (sel === -1) continue;
+    [work[pr], work[sel]] = [work[sel], work[pr]];
+    for (let r = 0; r < work.length; r++) {
+      if (r !== pr && work[r].coef & bit) {
+        work[r].coef ^= work[pr].coef;
+        work[r].rhs ^= work[pr].rhs;
+      }
+    }
+    pivotCol[pr] = col;
+    pr++;
+  }
+
+  // Rows beyond the rank must have zero rhs, else inconsistent.
+  for (let r = pr; r < work.length; r++) {
+    if (work[r].coef === 0n && work[r].rhs === 1) {
+      return { consistent: false, particular: 0n, kernel: [] };
+    }
+  }
+
+  const pivotSet = new Set<number>();
+  for (let r = 0; r < pr; r++) {
+    pivotRows[r] = work[r];
+    pivotSet.add(pivotCol[r]);
+  }
+
+  // Particular solution: free vars = 0, pivot var = its row's rhs.
+  let particular = 0n;
+  for (let r = 0; r < pr; r++) {
+    if (pivotRows[r].rhs === 1) particular |= 1n << BigInt(pivotCol[r]);
+  }
+
+  // Kernel basis: one vector per free column.
+  const kernel: bigint[] = [];
+  for (let f = 0; f < numButtons; f++) {
+    if (pivotSet.has(f)) continue;
+    const fbit = 1n << BigInt(f);
+    let vec = fbit;
+    for (let r = 0; r < pr; r++) {
+      if (pivotRows[r].coef & fbit) vec |= 1n << BigInt(pivotCol[r]);
+    }
+    kernel.push(vec);
+  }
+
+  return { consistent: true, particular, kernel };
+}
+
+// Track the best (min-weight, then lex-smallest) candidate seen.
+class BestToggle {
+  weight = Infinity;
+  mask = 0n;
+  found = false;
+  consider(mask: bigint, weight: number): void {
+    if (!this.found || weight < this.weight) {
+      this.weight = weight;
+      this.mask = mask;
+      this.found = true;
+    } else if (weight === this.weight && compareIndexMasks(mask, this.mask) < 0) {
+      this.mask = mask;
+    }
+  }
+}
+
+// Enumerate the full solution space (2^k) via Gray code when the kernel is small.
+function enumerateKernel(sys: GF2System, best: BestToggle): void {
+  const k = sys.kernel.length;
+  let x = sys.particular;
+  best.consider(x, popcount(x));
+  const total = 1 << k;
+  for (let i = 1; i < total; i++) {
+    // Gray code: the bit that flips going from i-1 to i is the lowest set bit of i.
+    let t = i;
+    let bit = 0;
+    while ((t & 1) === 0) {
+      t >>= 1;
+      bit++;
+    }
+    x ^= sys.kernel[bit];
+    best.consider(x, popcount(x));
+  }
+}
+
+// Meet-in-the-middle over the raw buttons, used when the kernel is too large to
+// enumerate directly. Splits the M buttons into two halves and combines.
+function mitmToggle(buttonVecs: bigint[], target: bigint, best: BestToggle): void {
+  const m = buttonVecs.length;
+  const sizeA = m >> 1;
+  const sizeB = m - sizeA;
+
+  // For each reachable light-vector from the second half, remember the lightest
+  // (then lex-smallest) local button set.
+  const map = new Map<bigint, { weight: number; mask: bigint }>();
+  {
+    let vec = 0n; // light-space xor of selected B buttons
+    let mask = 0n; // local button mask (bits 0..sizeB-1)
+    let weight = 0;
+    const record = (): void => {
+      const prev = map.get(vec);
+      if (
+        prev === undefined ||
+        weight < prev.weight ||
+        (weight === prev.weight && compareIndexMasks(mask, prev.mask) < 0)
+      ) {
+        map.set(vec, { weight, mask });
+      }
+    };
+    record();
+    const totalB = 1 << sizeB;
+    for (let i = 1; i < totalB; i++) {
+      let t = i;
+      let bit = 0;
+      while ((t & 1) === 0) {
+        t >>= 1;
+        bit++;
+      }
+      vec ^= buttonVecs[sizeA + bit];
+      const bbit = 1n << BigInt(bit);
+      if (mask & bbit) {
+        mask ^= bbit;
+        weight--;
+      } else {
+        mask |= bbit;
+        weight++;
+      }
+      record();
+    }
+  }
+
+  // Enumerate first half, look up the complement.
+  {
+    let vec = 0n;
+    let mask = 0n; // local == global index for A (buttons 0..sizeA-1)
+    let weight = 0;
+    const probe = (): void => {
+      const need = target ^ vec;
+      const entry = map.get(need);
+      if (entry === undefined) return;
+      const combined = mask | (entry.mask << BigInt(sizeA));
+      best.consider(combined, weight + entry.weight);
+    };
+    probe();
+    const totalA = 1 << sizeA;
+    for (let i = 1; i < totalA; i++) {
+      let t = i;
+      let bit = 0;
+      while ((t & 1) === 0) {
+        t >>= 1;
+        bit++;
+      }
+      vec ^= buttonVecs[bit];
+      const abit = 1n << BigInt(bit);
+      if (mask & abit) {
+        mask ^= abit;
+        weight--;
+      } else {
+        mask |= abit;
+        weight++;
+      }
+      probe();
+    }
+  }
+}
+
+export function solveToggle(machine: Machine): number[] | null {
+  const numLights = machine.target.length;
+  const numButtons = machine.buttons.length;
+
+  // Build the GF(2) system, one row (equation) per light.
+  const rows: { coef: bigint; rhs: number }[] = [];
+  for (let light = 0; light < numLights; light++) {
+    rows.push({ coef: 0n, rhs: machine.target[light] ? 1 : 0 });
+  }
+  for (let b = 0; b < numButtons; b++) {
+    const bit = 1n << BigInt(b);
+    for (const light of machine.buttons[b]) {
+      // Toggling the same light twice from one press cancels (parity).
+      rows[light].coef ^= bit;
+    }
+  }
+
+  const sys = gf2Solve(numButtons, rows);
+  if (!sys.consistent) return null;
+
+  const best = new BestToggle();
+  const k = sys.kernel.length;
+  if (k <= 20) {
+    enumerateKernel(sys, best);
+  } else {
+    // Fall back to meet-in-the-middle over the buttons.
+    const buttonVecs: bigint[] = [];
+    for (let b = 0; b < numButtons; b++) {
+      let v = 0n;
+      for (const light of machine.buttons[b]) v ^= 1n << BigInt(light);
+      buttonVecs.push(v);
+    }
+    let target = 0n;
+    for (let light = 0; light < numLights; light++) {
+      if (machine.target[light]) target |= 1n << BigInt(light);
+    }
+    mitmToggle(buttonVecs, target, best);
+  }
+
+  if (!best.found) return null;
+  return maskToIndices(best.mask);
+}
+
+// ---------------------------------------------------------------------------
+// GF(p) helpers (Part 2)
+// ---------------------------------------------------------------------------
+
+function modInverse(a: number, p: number): number {
+  // Extended Euclid; p is prime so gcd(a, p) = 1 for a !== 0.
+  let [oldR, r] = [((a % p) + p) % p, p];
+  let [oldS, s] = [1, 0];
+  while (r !== 0) {
+    const q = Math.floor(oldR / r);
+    [oldR, r] = [r, oldR - q * r];
+    [oldS, s] = [s, oldS - q * s];
+  }
+  return ((oldS % p) + p) % p;
+}
+
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): number[] | null {
+  const p = modulus;
+  const numCounters = lights.length;
+  const numButtons = buttons.length;
+
+  // Augmented matrix: numCounters rows, numButtons + 1 columns.
+  const mat: number[][] = [];
+  for (let c = 0; c < numCounters; c++) {
+    mat.push(new Array(numButtons + 1).fill(0));
+    mat[c][numButtons] = ((lights[c] % p) + p) % p;
+  }
+  for (let b = 0; b < numButtons; b++) {
+    for (const c of buttons[b]) {
+      mat[c][b] = (mat[c][b] + 1) % p;
+    }
+  }
+
+  // RREF over GF(p).
+  const pivotCol: number[] = [];
+  let pr = 0;
+  for (let col = 0; col < numButtons && pr < numCounters; col++) {
+    let sel = -1;
+    for (let r = pr; r < numCounters; r++) {
+      if (mat[r][col] !== 0) {
+        sel = r;
+        break;
+      }
+    }
+    if (sel === -1) continue;
+    [mat[pr], mat[sel]] = [mat[sel], mat[pr]];
+    const inv = modInverse(mat[pr][col], p);
+    for (let j = col; j <= numButtons; j++) {
+      mat[pr][j] = (mat[pr][j] * inv) % p;
+    }
+    for (let r = 0; r < numCounters; r++) {
+      if (r !== pr && mat[r][col] !== 0) {
+        const factor = mat[r][col];
+        for (let j = col; j <= numButtons; j++) {
+          mat[r][j] = (mat[r][j] - factor * mat[pr][j]) % p;
+          if (mat[r][j] < 0) mat[r][j] += p;
+        }
+      }
+    }
+    pivotCol[pr] = col;
+    pr++;
+  }
+
+  for (let r = pr; r < numCounters; r++) {
+    if (mat[r][numButtons] !== 0) return null; // 0 = nonzero
+  }
+
+  const isPivot = new Array(numButtons).fill(false);
+  for (let r = 0; r < pr; r++) isPivot[pivotCol[r]] = true;
+  const freeCols: number[] = [];
+  for (let b = 0; b < numButtons; b++) if (!isPivot[b]) freeCols.push(b);
+
+  // Particular solution: free vars = 0, pivot var = row rhs.
+  const particular = new Array(numButtons).fill(0);
+  for (let r = 0; r < pr; r++) particular[pivotCol[r]] = mat[r][numButtons];
+
+  // Kernel basis: for free col f, x_f = 1 and x_pivot = -coef(row, f).
+  const kernel: number[][] = [];
+  for (const f of freeCols) {
+    const vec = new Array(numButtons).fill(0);
+    vec[f] = 1;
+    for (let r = 0; r < pr; r++) {
+      const v = mat[r][f];
+      if (v !== 0) vec[pivotCol[r]] = (p - v) % p;
+    }
+    kernel.push(vec);
+  }
+
+  // Search for the min-total-press solution over the affine solution space.
+  const x = particular.slice();
+  let bestTotal = Infinity;
+  let bestX: number[] | null = null;
+  const k = freeCols.length;
+
+  const sumOf = (arr: number[]): number => arr.reduce((acc, v) => acc + v, 0);
+  const lexLess = (a: number[], b: number[]): boolean => {
+    for (let i = 0; i < a.length; i++) {
+      if (a[i] !== b[i]) return a[i] < b[i];
+    }
+    return false;
+  };
+
+  // Depth-first branch & bound over free variables. Each free var's value adds
+  // directly to the total (it is its own coordinate in x), giving a valid lower
+  // bound for pruning. Values are tried ascending so the first leaf is the
+  // all-zero-free (particular) solution, seeding a bound quickly.
+  const dfs = (depth: number, freeSum: number): void => {
+    if (depth === k) {
+      const total = sumOf(x);
+      if (total < bestTotal) {
+        bestTotal = total;
+        bestX = x.slice();
+      } else if (total === bestTotal && bestX !== null && lexLess(x, bestX)) {
+        bestX = x.slice();
+      }
+      return;
+    }
+    const vec = kernel[depth];
+    const col = freeCols[depth];
+    const saved = x.slice();
+    for (let v = 0; v < p; v++) {
+      if (freeSum + v > bestTotal) break; // ascending: no smaller total ahead
+      if (v > 0) {
+        for (let i = 0; i < numButtons; i++) {
+          if (vec[i] !== 0) {
+            x[i] += vec[i];
+            if (x[i] >= p) x[i] -= p;
+          }
+        }
+      }
+      x[col] = v; // exact (vec[col] === 1), guards against accumulation error
+      dfs(depth + 1, freeSum + v);
+    }
+    for (let i = 0; i < numButtons; i++) x[i] = saved[i];
+  };
+
+  dfs(0, 0);
+
+  return bestX;
+}
diff --git a/tests/solver.test.ts b/tests/solver.test.ts
new file mode 100644
index 0000000..ae12968
--- /dev/null
+++ b/tests/solver.test.ts
@@ -0,0 +1,188 @@
+import { describe, it, expect } from 'vitest';
+import { solveToggle, solveCounter, Machine } from '../src/index.js';
+
+// ---------------------------------------------------------------------------
+// Brute-force references for small instances
+// ---------------------------------------------------------------------------
+
+function bruteToggle(machine: Machine): number[] | null {
+  const n = machine.target.length;
+  const m = machine.buttons.length;
+  let best: number[] | null = null;
+  const cmp = (a: number[], b: number[]): number => {
+    if (a.length !== b.length) return a.length - b.length;
+    for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return a[i] - b[i];
+    return 0;
+  };
+  for (let s = 0; s < 1 << m; s++) {
+    const lights = new Array(n).fill(false);
+    const picks: number[] = [];
+    for (let b = 0; b < m; b++) {
+      if (s & (1 << b)) {
+        picks.push(b);
+        for (const l of machine.buttons[b]) lights[l] = !lights[l];
+      }
+    }
+    let ok = true;
+    for (let l = 0; l < n; l++) if (lights[l] !== machine.target[l]) { ok = false; break; }
+    if (!ok) continue;
+    if (best === null || cmp(picks, best) < 0) best = picks;
+  }
+  return best;
+}
+
+function bruteCounter(lights: number[], buttons: number[][], mod: number): number[] | null {
+  const n = lights.length;
+  const m = buttons.length;
+  let best: number[] | null = null;
+  const press = new Array(m).fill(0);
+  const cmpTotal = (a: number[]): number => a.reduce((x, y) => x + y, 0);
+  const lexLess = (a: number[], b: number[]): boolean => {
+    for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return a[i] < b[i];
+    return false;
+  };
+  const rec = (i: number): void => {
+    if (i === m) {
+      const counters = new Array(n).fill(0);
+      for (let b = 0; b < m; b++) {
+        for (const c of buttons[b]) counters[c] = (counters[c] + press[b]) % mod;
+      }
+      for (let c = 0; c < n; c++) if (counters[c] !== ((lights[c] % mod) + mod) % mod) return;
+      if (best === null) { best = press.slice(); return; }
+      const t = cmpTotal(press), bt = cmpTotal(best);
+      if (t < bt || (t === bt && lexLess(press, best))) best = press.slice();
+      return;
+    }
+    for (let v = 0; v < mod; v++) {
+      press[i] = v;
+      rec(i + 1);
+    }
+    press[i] = 0;
+  };
+  rec(0);
+  return best;
+}
+
+function rngFactory(seed: number) {
+  let s = seed >>> 0;
+  return () => {
+    s = (s * 1664525 + 1013904223) >>> 0;
+    return s / 0x100000000;
+  };
+}
