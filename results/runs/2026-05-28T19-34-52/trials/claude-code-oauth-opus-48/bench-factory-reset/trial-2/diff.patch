+// Part 1
+// ---------------------------------------------------------------------------
+
+describe('solveToggle', () => {
+  it('matches the spec example (no solution)', () => {
+    const machine: Machine = {
+      target: [true, true, false, true],
+      buttons: [[0, 1], [1, 2, 3], [0, 3]],
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it('returns empty array when target is already off', () => {
+    expect(solveToggle({ target: [false, false], buttons: [[0], [1]] })).toEqual([]);
+  });
+
+  it('randomized vs brute force (small)', () => {
+    const rng = rngFactory(42);
+    for (let t = 0; t < 400; t++) {
+      const n = 1 + Math.floor(rng() * 6);
+      const m = 1 + Math.floor(rng() * 8);
+      const buttons: number[][] = [];
+      for (let b = 0; b < m; b++) {
+        const set: number[] = [];
+        for (let l = 0; l < n; l++) if (rng() < 0.5) set.push(l);
+        buttons.push(set);
+      }
+      const target: boolean[] = [];
+      for (let l = 0; l < n; l++) target.push(rng() < 0.5);
+      const machine = { target, buttons };
+      const got = solveToggle(machine);
+      const exp = bruteToggle(machine);
+      expect(got).toEqual(exp);
+      if (got) {
+        // validate it actually achieves the target
+        const lights = new Array(n).fill(false);
+        for (const b of got) for (const l of buttons[b]) lights[l] = !lights[l];
+        expect(lights).toEqual(target);
+      }
+    }
+  });
+
+  it('handles the MITM fallback path (large kernel)', () => {
+    // 30 buttons all identical -> huge kernel; target reachable by one press.
+    const m = 30;
+    const buttons = Array.from({ length: m }, () => [0]);
+    const machine: Machine = { target: [true], buttons };
+    const got = solveToggle(machine);
+    expect(got).toEqual([0]); // one button, lex smallest index
+  });
+
+  it('large unique-ish system within time', () => {
+    // identity-style: button i toggles light i -> unique solution
+    const m = 40;
+    const buttons = Array.from({ length: m }, (_, i) => [i]);
+    const target = Array.from({ length: m }, (_, i) => i % 3 === 0);
+    const expected = target.map((v, i) => (v ? i : -1)).filter((i) => i >= 0);
+    expect(solveToggle({ target, buttons })).toEqual(expected);
+  });
+});
