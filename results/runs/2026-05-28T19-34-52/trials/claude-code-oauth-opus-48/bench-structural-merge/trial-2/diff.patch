+import { describe, it, expect } from 'vitest';
+import { DocumentStore } from './index.js';
+
+describe('CRUD', () => {
+  it('creates and gets a document', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    expect(s.get('a')).toEqual({ x: 1 });
+  });
+
+  it('throws on duplicate create', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    expect(() => s.create('a', { x: 2 })).toThrow();
+  });
+
+  it('throws on get of missing / deleted doc', () => {
+    const s = new DocumentStore();
+    expect(() => s.get('a')).toThrow();
+    s.create('a', { x: 1 });
+    s.delete('a');
+    expect(() => s.get('a')).toThrow();
+  });
+
+  it('update replaces content and throws if missing', () => {
+    const s = new DocumentStore();
+    expect(() => s.update('a', { x: 1 })).toThrow();
+    s.create('a', { x: 1 });
+    s.update('a', { x: 2, y: 3 });
+    expect(s.get('a')).toEqual({ x: 2, y: 3 });
+  });
+
+  it('delete throws if missing', () => {
+    const s = new DocumentStore();
+    expect(() => s.delete('a')).toThrow();
+  });
+
+  it('deep clones on storage and retrieval', () => {
+    const s = new DocumentStore();
+    const input = { nested: { v: 1 }, arr: [1, 2] };
+    s.create('a', input);
+    input.nested.v = 999;
+    expect(s.get('a')).toEqual({ nested: { v: 1 }, arr: [1, 2] });
+    const got = s.get('a') as { nested: { v: number } };
+    got.nested.v = 5;
+    expect(s.get('a')).toEqual({ nested: { v: 1 }, arr: [1, 2] });
+  });
+});
+
+describe('version history', () => {
+  it('records a version per create/update, chronological', () => {
+    const s = new DocumentStore();
+    s.create('a', { v: 1 });
+    s.update('a', { v: 2 });
+    s.update('a', { v: 3 });
+    const h = s.getHistory('a');
+    expect(h.length).toBe(3);
+    expect(h.map((v) => v.content)).toEqual([{ v: 1 }, { v: 2 }, { v: 3 }]);
+    expect(new Set(h.map((v) => v.id)).size).toBe(3);
+    for (const v of h) expect(typeof v.timestamp).toBe('number');
+  });
+
+  it('getVersion returns content at a version', () => {
+    const s = new DocumentStore();
+    s.create('a', { v: 1 });
+    s.update('a', { v: 2 });
+    const h = s.getHistory('a');
+    expect(s.getVersion('a', h[0].id)).toEqual({ v: 1 });
+    expect(s.getVersion('a', h[1].id)).toEqual({ v: 2 });
+    expect(() => s.getVersion('a', 'nope')).toThrow();
+  });
+});
+
+describe('branching', () => {
+  it('default branch is main', () => {
+    const s = new DocumentStore();
+    expect(s.getBranch()).toBe('main');
+    expect(s.listBranches()).toContain('main');
+  });
+
+  it('branches are isolated', () => {
+    const s = new DocumentStore();
+    s.create('a', { v: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { v: 2 });
+    expect(s.get('a')).toEqual({ v: 2 });
+    s.switchBranch('main');
+    expect(s.get('a')).toEqual({ v: 1 });
+  });
+
+  it('createBranch from a specified branch', () => {
+    const s = new DocumentStore();
+    s.create('a', { v: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { v: 2 });
+    s.switchBranch('main');
+    s.createBranch('feature2', 'feature');
+    s.switchBranch('feature2');
+    expect(s.get('a')).toEqual({ v: 2 });
+  });
+
+  it('throws on duplicate branch / missing switch', () => {
+    const s = new DocumentStore();
+    expect(() => s.createBranch('main')).toThrow();
+    expect(() => s.switchBranch('nope')).toThrow();
+  });
+});
+
+describe('merge', () => {
+  it('fast-forwards when only source changed', () => {
+    const s = new DocumentStore();
+    s.create('a', { v: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { v: 2 });
+    s.switchBranch('main');
+    const r = s.merge('feature');
+    expect(r.applied).toBe(true);
+    expect(r.conflicts).toEqual([]);
+    expect(r.merged.a).toEqual({ v: 2 });
+    expect(s.get('a')).toEqual({ v: 2 });
+  });
+
+  it('no-op merge when nothing changed', () => {
+    const s = new DocumentStore();
+    s.create('a', { v: 1 });
+    s.createBranch('feature');
+    const r = s.merge('feature');
+    expect(r.applied).toBe(true);
+    expect(r.conflicts).toEqual([]);
+    expect(r.merged.a).toEqual({ v: 1 });
+  });
+
+  it('merges disjoint field changes with no conflict', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1, y: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 1, y: 2 });
+    s.switchBranch('main');
+    s.update('a', { x: 9, y: 1 });
+    const r = s.merge('feature');
+    expect(r.conflicts).toEqual([]);
+    expect(r.applied).toBe(true);
+    expect(s.get('a')).toEqual({ x: 9, y: 2 });
+  });
+
+  it('no conflict when both sides set the same value', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 5 });
+    s.switchBranch('main');
+    s.update('a', { x: 5 });
+    const r = s.merge('feature');
+    expect(r.conflicts).toEqual([]);
+    expect(r.applied).toBe(true);
+    expect(s.get('a')).toEqual({ x: 5 });
+  });
+
+  it('reports a conflict when both change the same field differently', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 2 });
+    s.switchBranch('main');
+    s.update('a', { x: 3 });
+    const r = s.merge('feature');
+    expect(r.applied).toBe(false);
+    expect(r.conflicts).toEqual([
+      { documentId: 'a', path: 'x', base: 1, ours: 3, theirs: 2 },
+    ]);
+    // current branch unchanged
+    expect(s.get('a')).toEqual({ x: 3 });
+    // merged shows resolution in favour of ours
+    expect(r.merged.a).toEqual({ x: 3 });
+  });
+
+  it('handles nested paths in conflicts', () => {
+    const s = new DocumentStore();
+    s.create('a', { a: { b: { c: 1 } } });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { a: { b: { c: 2 } } });
+    s.switchBranch('main');
+    s.update('a', { a: { b: { c: 3 } } });
+    const r = s.merge('feature');
+    expect(r.conflicts[0].path).toBe('a.b.c');
+  });
+
+  it('merges nested objects field-wise without conflict', () => {
+    const s = new DocumentStore();
+    s.create('a', { meta: { author: 'x', tags: 1 }, body: 'hi' });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { meta: { author: 'x', tags: 2 }, body: 'hi' });
+    s.switchBranch('main');
+    s.update('a', { meta: { author: 'y', tags: 1 }, body: 'hi' });
+    const r = s.merge('feature');
+    expect(r.conflicts).toEqual([]);
+    expect(s.get('a')).toEqual({ meta: { author: 'y', tags: 2 }, body: 'hi' });
+  });
+
+  it('treats arrays as atomic values', () => {
+    const s = new DocumentStore();
+    s.create('a', { list: [1, 2] });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { list: [1, 2, 3] });
+    s.switchBranch('main');
+    s.update('a', { list: [9] });
+    const r = s.merge('feature');
+    expect(r.applied).toBe(false);
+    expect(r.conflicts[0]).toMatchObject({ path: 'list', base: [1, 2], ours: [9], theirs: [1, 2, 3] });
+  });
+
+  it('merges independent documents cleanly', () => {
+    const s = new DocumentStore();
+    s.create('a', { v: 1 });
+    s.create('b', { v: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { v: 2 });
+    s.switchBranch('main');
+    s.update('b', { v: 2 });
+    const r = s.merge('feature');
+    expect(r.conflicts).toEqual([]);
+    expect(s.get('a')).toEqual({ v: 2 });
+    expect(s.get('b')).toEqual({ v: 2 });
+  });
+
+  it('brings in a document created only on source', () => {
+    const s = new DocumentStore();
+    s.create('a', { v: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.create('b', { v: 1 });
+    s.switchBranch('main');
+    const r = s.merge('feature');
+    expect(r.conflicts).toEqual([]);
+    expect(s.get('b')).toEqual({ v: 1 });
+  });
+
+  it('propagates a deletion from source', () => {
+    const s = new DocumentStore();
+    s.create('a', { v: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.delete('a');
+    s.switchBranch('main');
+    const r = s.merge('feature');
+    expect(r.conflicts).toEqual([]);
+    expect(r.applied).toBe(true);
+    expect(r.merged.a).toBeUndefined();
+    expect(() => s.get('a')).toThrow();
+  });
+
+  it('conflicts on delete-vs-modify', () => {
+    const s = new DocumentStore();
+    s.create('a', { v: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.delete('a');
+    s.switchBranch('main');
+    s.update('a', { v: 2 });
+    const r = s.merge('feature');
+    expect(r.applied).toBe(false);
+    expect(r.conflicts.length).toBe(1);
+    expect(s.get('a')).toEqual({ v: 2 });
+  });
+
+  it('does not apply any change when there are conflicts', () => {
+    const s = new DocumentStore();
+    s.create('a', { x: 1 });
+    s.create('b', { y: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { x: 2 });
+    s.update('b', { y: 100 });
+    s.switchBranch('main');
+    s.update('a', { x: 3 });
+    const r = s.merge('feature');
+    expect(r.applied).toBe(false);
+    // b's clean change must NOT have been applied since the merge had a conflict
+    expect(s.get('b')).toEqual({ y: 1 });
+  });
+
+  it('add/add same id with disjoint fields merges cleanly', () => {
+    const s = new DocumentStore();
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.create('a', { x: 1 });
+    s.switchBranch('main');
+    s.create('a', { y: 2 });
+    const r = s.merge('feature');
+    expect(r.conflicts).toEqual([]);
+    expect(s.get('a')).toEqual({ y: 2, x: 1 });
+  });
+
+  it('throws when merging a missing branch', () => {
+    const s = new DocumentStore();
+    expect(() => s.merge('nope')).toThrow();
+  });
+
+  it('repeated merge after applying is idempotent', () => {
+    const s = new DocumentStore();
+    s.create('a', { v: 1 });
+    s.createBranch('feature');
+    s.switchBranch('feature');
+    s.update('a', { v: 2 });
+    s.switchBranch('main');
+    s.merge('feature');
+    const r2 = s.merge('feature');
+    expect(r2.conflicts).toEqual([]);
+    expect(s.get('a')).toEqual({ v: 2 });
+  });
+});
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..d41be19
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,376 @@
+/**
+ * In-memory versioned document store with three-way structural merge.
+ * "Git for JSON documents."
+ */
+
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+export interface Conflict {
+  documentId: string;
+  path: string; // dot-separated JSON path, e.g. "a.b.c" ("" for whole-document conflicts)
+  base: unknown;
+  ours: unknown;
+  theirs: unknown;
+}
+
+export interface MergeResult {
+  merged: Record<string, object>; // documentId -> merged content
+  conflicts: Conflict[];
+  applied: boolean; // true if merge was auto-applied (no conflicts)
+}
+
+// ---------------------------------------------------------------------------
+// Internal types
+// ---------------------------------------------------------------------------
+
+/** Global registry entry for a single version. */
+interface VersionRecord {
+  id: string;
+  seq: number; // monotonically increasing creation order
+  timestamp: number;
+  content: object;
+}
+
+/** Per-branch, per-document state. */
+interface DocState {
+  head: string | null; // current version id (null when deleted/absent)
+  history: string[]; // this document's own versions, chronological
+  ancestors: Set<string>; // every version id in this document's ancestry (for merge base finding)
+  deleted: boolean;
+}
+
+interface Branch {
+  name: string;
+  docs: Map<string, DocState>;
+}
+
+// ---------------------------------------------------------------------------
+// JSON helpers
+// ---------------------------------------------------------------------------
+
+function clone<T>(value: T): T {
+  return structuredClone(value);
+}
+
+function isPlainObject(v: unknown): v is Record<string, unknown> {
+  return typeof v === 'object' && v !== null && !Array.isArray(v);
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (a === null || b === null) return false;
+  if (typeof a !== typeof b) return false;
+  if (typeof a !== 'object') return false;
+
+  const aArr = Array.isArray(a);
+  const bArr = Array.isArray(b);
+  if (aArr !== bArr) return false;
+
+  if (aArr) {
+    const aList = a as unknown[];
+    const bList = b as unknown[];
+    if (aList.length !== bList.length) return false;
+    for (let i = 0; i < aList.length; i++) {
+      if (!deepEqual(aList[i], bList[i])) return false;
+    }
+    return true;
+  }
+
+  const aObj = a as Record<string, unknown>;
+  const bObj = b as Record<string, unknown>;
+  const aKeys = Object.keys(aObj);
+  const bKeys = Object.keys(bObj);
+  if (aKeys.length !== bKeys.length) return false;
+  for (const k of aKeys) {
+    if (!Object.prototype.hasOwnProperty.call(bObj, k)) return false;
+    if (!deepEqual(aObj[k], bObj[k])) return false;
+  }
+  return true;
+}
+
+/**
+ * Recursive three-way merge of two JSON values against a common base.
+ *
+ * `undefined` represents an absent key / absent document. Arrays are treated
+ * as atomic (opaque) leaf values -- they are never merged element-wise.
+ *
+ * Returns the merged value (possibly `undefined`, meaning "not present").
+ * Discovered conflicts are pushed into `conflicts`; on a leaf conflict the
+ * value resolves in favour of `ours`.
+ */
+function mergeValue(
+  base: unknown,
+  ours: unknown,
+  theirs: unknown,
+  documentId: string,
+  path: string,
+  conflicts: Conflict[],
+): unknown {
+  // No difference between the two branches.
+  if (deepEqual(ours, theirs)) return ours;
+  // Only "theirs" changed relative to base -> take theirs.
+  if (deepEqual(ours, base)) return theirs;
+  // Only "ours" changed relative to base -> keep ours.
+  if (deepEqual(theirs, base)) return ours;
+
+  // Both sides changed differently. If both are plain objects, merge per key.
+  if (isPlainObject(ours) && isPlainObject(theirs)) {
+    const baseObj = isPlainObject(base) ? base : {};
+    const result: Record<string, unknown> = {};
+    const keys = new Set<string>([
+      ...Object.keys(baseObj),
+      ...Object.keys(ours),
+      ...Object.keys(theirs),
+    ]);
+    for (const key of keys) {
+      const childPath = path ? `${path}.${key}` : key;
+      const mergedChild = mergeValue(baseObj[key], ours[key], theirs[key], documentId, childPath, conflicts);
+      if (mergedChild !== undefined) {
+        result[key] = mergedChild;
+      }
+    }
+    return result;
+  }
+
+  // Leaf conflict (or modify/delete) -- resolve in favour of ours.
+  conflicts.push({ documentId, path, base, ours, theirs });
+  return ours;
+}
+
+// ---------------------------------------------------------------------------
+// DocumentStore
+// ---------------------------------------------------------------------------
+
+export class DocumentStore {
+  private branches = new Map<string, Branch>();
+  private versions = new Map<string, VersionRecord>();
+  private current = 'main';
+  private seqCounter = 0;
+
+  constructor() {
+    this.branches.set('main', { name: 'main', docs: new Map() });
+  }
+
+  // --- internal helpers ---------------------------------------------------
+
+  private currentBranch(): Branch {
+    return this.branches.get(this.current)!;
+  }
+
+  private newVersion(content: object): string {
+    const seq = ++this.seqCounter;
+    const id = `v${seq}`;
+    this.versions.set(id, { id, seq, timestamp: Date.now(), content: clone(content) });
+    return id;
+  }
+
+  /** Current content of a doc state, or `undefined` if absent/deleted. */
+  private contentOf(ds: DocState | undefined): object | undefined {
+    if (!ds || ds.deleted || ds.head === null) return undefined;
+    return clone(this.versions.get(ds.head)!.content);
+  }
+
+  /** Common-ancestor content of two doc states, or `undefined` if none. */
+  private baseContent(a: DocState | undefined, b: DocState | undefined): object | undefined {
+    if (!a || !b) return undefined;
+    let best: VersionRecord | undefined;
+    for (const id of a.ancestors) {
+      if (!b.ancestors.has(id)) continue;
+      const rec = this.versions.get(id)!;
+      if (!best || rec.seq > best.seq) best = rec;
+    }
+    return best ? clone(best.content) : undefined;
+  }
+
+  // --- document CRUD ------------------------------------------------------
+
+  create(id: string, content: object): void {
+    const branch = this.currentBranch();
+    const existing = branch.docs.get(id);
+    if (existing && !existing.deleted) {
+      throw new Error(`Document "${id}" already exists on branch "${this.current}"`);
+    }
+    const vid = this.newVersion(content);
+    if (existing) {
+      // Re-create over a tombstone: preserve prior ancestry.
+      existing.history.push(vid);
+      existing.ancestors.add(vid);
+      existing.head = vid;
+      existing.deleted = false;
+    } else {
+      branch.docs.set(id, {
+        head: vid,
+        history: [vid],
+        ancestors: new Set([vid]),
+        deleted: false,
+      });
+    }
+  }
+
+  get(id: string): object {
+    const ds = this.currentBranch().docs.get(id);
+    if (!ds || ds.deleted || ds.head === null) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.current}"`);
+    }
+    return clone(this.versions.get(ds.head)!.content);
+  }
+
+  update(id: string, content: object): void {
+    const ds = this.currentBranch().docs.get(id);
+    if (!ds || ds.deleted) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.current}"`);
+    }
+    const vid = this.newVersion(content);
+    ds.history.push(vid);
+    ds.ancestors.add(vid);
+    ds.head = vid;
+  }
+
+  delete(id: string): void {
+    const ds = this.currentBranch().docs.get(id);
+    if (!ds || ds.deleted) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.current}"`);
+    }
+    ds.deleted = true;
+    ds.head = null;
+  }
+
+  // --- version history ----------------------------------------------------
+
+  getHistory(id: string): Version[] {
+    const ds = this.currentBranch().docs.get(id);
+    if (!ds) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.current}"`);
+    }
+    return ds.history.map((vid) => {
+      const rec = this.versions.get(vid)!;
+      return { id: rec.id, timestamp: rec.timestamp, content: clone(rec.content) };
+    });
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const ds = this.currentBranch().docs.get(id);
+    if (!ds) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.current}"`);
+    }
+    if (!ds.history.includes(versionId)) {
+      throw new Error(`Version "${versionId}" not found for document "${id}"`);
+    }
+    return clone(this.versions.get(versionId)!.content);
+  }
+
+  // --- branching ----------------------------------------------------------
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const sourceName = fromBranch ?? this.current;
+    const source = this.branches.get(sourceName);
+    if (!source) {
+      throw new Error(`Branch "${sourceName}" does not exist`);
+    }
+    const docs = new Map<string, DocState>();
+    for (const [id, ds] of source.docs) {
+      docs.set(id, {
+        head: ds.head,
+        history: [...ds.history],
+        ancestors: new Set(ds.ancestors),
+        deleted: ds.deleted,
