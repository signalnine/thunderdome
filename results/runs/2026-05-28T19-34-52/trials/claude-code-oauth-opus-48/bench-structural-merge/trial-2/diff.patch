+    const docIds = new Set<string>([...ours.docs.keys(), ...theirs.docs.keys()]);
+    for (const id of docIds) {
+      const oursDs = ours.docs.get(id);
+      const theirsDs = theirs.docs.get(id);
+      const base = this.baseContent(oursDs, theirsDs);
+      const o = this.contentOf(oursDs);
+      const t = this.contentOf(theirsDs);
