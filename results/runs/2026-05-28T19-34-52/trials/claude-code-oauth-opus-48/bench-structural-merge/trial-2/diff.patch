ssing switch', () => {\n    const s = new DocumentStore();\n    expect(() => s.createBranch('main')).toThrow();\n    expect(() => s.switchBranch('nope')).toThrow();\n  });\n});\n\ndescribe('merge', () => {\n  it('fast-forwards when only source changed', () => {\n    const s = new DocumentStore();\n    s.create('a', { v: 1 });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.update('a', { v: 2 });\n    s.switchBranch('main');\n    const r = s.merge('feature');\n    expect(r.applied).toBe(true);\n    expect(r.conflicts).toEqual([]);\n    expect(r.merged.a).toEqual({ v: 2 });\n    expect(s.get('a')).toEqual({ v: 2 });\n  });\n\n  it('no-op merge when nothing changed', () => {\n    const s = new DocumentStore();\n    s.create('a', { v: 1 });\n    s.createBranch('feature');\n    const r = s.merge('feature');\n    expect(r.applied).toBe(true);\n    expect(r.conflicts).toEqual([]);\n    expect(r.merged.a).toEqual({ v: 1 });\n  });\n\n  it('merges disjoint field changes with no conflict', () => {\n    const s = new DocumentStore();\n    s.create('a', { x: 1, y: 1 });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.update('a', { x: 1, y: 2 });\n    s.switchBranch('main');\n    s.update('a', { x: 9, y: 1 });\n    const r = s.merge('feature');\n    expect(r.conflicts).toEqual([]);\n    expect(r.applied).toBe(true);\n    expect(s.get('a')).toEqual({ x: 9, y: 2 });\n  });\n\n  it('no conflict when both sides set the same value', () => {\n    const s = new DocumentStore();\n    s.create('a', { x: 1 });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.update('a', { x: 5 });\n    s.switchBranch('main');\n    s.update('a', { x: 5 });\n    const r = s.merge('feature');\n    expect(r.conflicts).toEqual([]);\n    expect(r.applied).toBe(true);\n    expect(s.get('a')).toEqual({ x: 5 });\n  });\n\n  it('reports a conflict when both change the same field differently', () => {\n    const s = new DocumentStore();\n    s.create('a', { x: 1 });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.update('a', { x: 2 });\n    s.switchBranch('main');\n    s.update('a', { x: 3 });\n    const r = s.merge('feature');\n    expect(r.applied).toBe(false);\n    expect(r.conflicts).toEqual([\n      { documentId: 'a', path: 'x', base: 1, ours: 3, theirs: 2 },\n    ]);\n    // current branch unchanged\n    expect(s.get('a')).toEqual({ x: 3 });\n    // merged shows resolution in favour of ours\n    expect(r.merged.a).toEqual({ x: 3 });\n  });\n\n  it('handles nested paths in conflicts', () => {\n    const s = new DocumentStore();\n    s.create('a', { a: { b: { c: 1 } } });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.update('a', { a: { b: { c: 2 } } });\n    s.switchBranch('main');\n    s.update('a', { a: { b: { c: 3 } } });\n    const r = s.merge('feature');\n    expect(r.conflicts[0].path).toBe('a.b.c');\n  });\n\n  it('merges nested objects field-wise without conflict', () => {\n    const s = new DocumentStore();\n    s.create('a', { meta: { author: 'x', tags: 1 }, body: 'hi' });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.update('a', { meta: { author: 'x', tags: 2 }, body: 'hi' });\n    s.switchBranch('main');\n    s.update('a', { meta: { author: 'y', tags: 1 }, body: 'hi' });\n    const r = s.merge('feature');\n    expect(r.conflicts).toEqual([]);\n    expect(s.get('a')).toEqual({ meta: { author: 'y', tags: 2 }, body: 'hi' });\n  });\n\n  it('treats arrays as atomic values', () => {\n    const s = new DocumentStore();\n    s.create('a', { list: [1, 2] });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.update('a', { list: [1, 2, 3] });\n    s.switchBranch('main');\n    s.update('a', { list: [9] });\n    const r = s.merge('feature');\n    expect(r.applied).toBe(false);\n    expect(r.conflicts[0]).toMatchObject({ path: 'list', base: [1, 2], ours: [9], theirs: [1, 2, 3] });\n  });\n\n  it('merges independent documents cleanly', () => {\n    const s = new DocumentStore();\n    s.create('a', { v: 1 });\n    s.create('b', { v: 1 });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.update('a', { v: 2 });\n    s.switchBranch('main');\n    s.update('b', { v: 2 });\n    const r = s.merge('feature');\n    expect(r.conflicts).toEqual([]);\n    expect(s.get('a')).toEqual({ v: 2 });\n    expect(s.get('b')).toEqual({ v: 2 });\n  });\n\n  it('brings in a document created only on source', () => {\n    const s = new DocumentStore();\n    s.create('a', { v: 1 });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.create('b', { v: 1 });\n    s.switchBranch('main');\n    const r = s.merge('feature');\n    expect(r.conflicts).toEqual([]);\n    expect(s.get('b')).toEqual({ v: 1 });\n  });\n\n  it('propagates a deletion from source', () => {\n    const s = new DocumentStore();\n    s.create('a', { v: 1 });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.delete('a');\n    s.switchBranch('main');\n    const r = s.merge('feature');\n    expect(r.conflicts).toEqual([]);\n    expect(r.applied).toBe(true);\n    expect(r.merged.a).toBeUndefined();\n    expect(() => s.get('a')).toThrow();\n  });\n\n  it('conflicts on delete-vs-modify', () => {\n    const s = new DocumentStore();\n    s.create('a', { v: 1 });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.delete('a');\n    s.switchBranch('main');\n    s.update('a', { v: 2 });\n    const r = s.merge('feature');\n    expect(r.applied).toBe(false);\n    expect(r.conflicts.length).toBe(1);\n    expect(s.get('a')).toEqual({ v: 2 });\n  });\n\n  it('does not apply any change when there are conflicts', () => {\n    const s = new DocumentStore();\n    s.create('a', { x: 1 });\n    s.create('b', { y: 1 });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.update('a', { x: 2 });\n    s.update('b', { y: 100 });\n    s.switchBranch('main');\n    s.update('a', { x: 3 });\n    const r = s.merge('feature');\n    expect(r.applied).toBe(false);\n    // b's clean change must NOT have been applied since the merge had a conflict\n    expect(s.get('b')).toEqual({ y: 1 });\n  });\n\n  it('add/add same id with disjoint fields merges cleanly', () => {\n    const s = new DocumentStore();\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.create('a', { x: 1 });\n    s.switchBranch('main');\n    s.create('a', { y: 2 });\n    const r = s.merge('feature');\n    expect(r.conflicts).toEqual([]);\n    expect(s.get('a')).toEqual({ y: 2, x: 1 });\n  });\n\n  it('throws when merging a missing branch', () => {\n    const s = new DocumentStore();\n    expect(() => s.merge('nope')).toThrow();\n  });\n\n  it('repeated merge after applying is idempotent', () => {\n    const s = new DocumentStore();\n    s.create('a', { v: 1 });\n    s.createBranch('feature');\n    s.switchBranch('feature');\n    s.update('a', { v: 2 });\n    s.switchBranch('main');\n    s.merge('feature');\n    const r2 = s.merge('feature');\n    expect(r2.conflicts).toEqual([]);\n    expect(s.get('a')).toEqual({ v: 2 });\n  });\n});\n","structuredPatch":[{"oldStart":41,"oldLines":7,"newStart":41,"newLines":7,"lines":["     s.create('a', input);","     input.nested.v = 999;","     expect(s.get('a')).toEqual({ nested: { v: 1 }, arr: [1, 2] });","-    const got = s.get('a') as any;","+    const got = s.get('a') as { nested: { v: number } };","     got.nested.v = 5;","     expect(s.get('a')).toEqual({ nested: { v: 1 }, arr: [1, 2] });","   });"]}],"userModified":false,"replaceAll":false}}
