+/**
+ * In-memory versioned document store with three-way structural merge.
+ * "Git for JSON documents."
+ */
+
+/**
+ * A JSON-compatible value. Documents are arbitrary JSON, so we intentionally
+ * allow `any` here rather than threading a recursive union through every helper
+ * and forcing casts at each access. This matches the public API in the spec.
+ */
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export type JSONValue = any;
+
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+export interface Conflict {
+  documentId: string;
+  path: string; // dot-separated JSON path, e.g. "a.b.c" ("" for whole-document conflicts)
+  base: JSONValue;
+  ours: JSONValue;
+  theirs: JSONValue;
+}
+
+export interface MergeResult {
+  merged: Record<string, object>; // documentId -> merged content
+  conflicts: Conflict[];
+  applied: boolean;
+}
+
+// ----------------------------------------------------------------------------
+// Internal value helpers
+// ----------------------------------------------------------------------------
+
+function isPlainObject(x: unknown): x is Record<string, JSONValue> {
+  return typeof x === 'object' && x !== null && !Array.isArray(x);
+}
+
+function deepClone<T>(value: T): T {
+  if (value === null || typeof value !== 'object') return value;
+  if (Array.isArray(value)) return value.map((v) => deepClone(v)) as unknown as T;
+  const out: Record<string, JSONValue> = {};
+  for (const key of Object.keys(value as Record<string, JSONValue>)) {
+    out[key] = deepClone((value as Record<string, JSONValue>)[key]);
+  }
+  return out as T;
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (a === null || b === null) return a === b;
+  if (typeof a !== 'object' || typeof b !== 'object') return false;
+
+  const aIsArr = Array.isArray(a);
+  const bIsArr = Array.isArray(b);
+  if (aIsArr !== bIsArr) return false;
+
+  if (aIsArr && bIsArr) {
+    if (a.length !== b.length) return false;
+    for (let i = 0; i < a.length; i++) {
+      if (!deepEqual(a[i], b[i])) return false;
+    }
+    return true;
+  }
+
+  const ao = a as Record<string, JSONValue>;
+  const bo = b as Record<string, JSONValue>;
+  const aKeys = Object.keys(ao);
+  const bKeys = Object.keys(bo);
+  if (aKeys.length !== bKeys.length) return false;
+  for (const key of aKeys) {
+    if (!Object.prototype.hasOwnProperty.call(bo, key)) return false;
+    if (!deepEqual(ao[key], bo[key])) return false;
+  }
+  return true;
+}
+
+// ----------------------------------------------------------------------------
+// Internal storage types
+// ----------------------------------------------------------------------------
+
+interface StoredVersion {
+  id: string;
+  timestamp: number;
+  content: object;
+  parentId: string | null;
+}
+
+interface DocEntry {
+  tipVersionId: string; // tip of this document's version chain on this branch
+  deleted: boolean; // tombstone: doc existed (chain available) but is currently removed
+}
+
+interface Branch {
+  name: string;
+  docs: Map<string, DocEntry>;
+}
+
+const DEFAULT_BRANCH = 'main';
+
+// ----------------------------------------------------------------------------
+// DocumentStore
+// ----------------------------------------------------------------------------
+
+export class DocumentStore {
+  private versions = new Map<string, StoredVersion>();
+  private branches = new Map<string, Branch>();
+  private currentBranch: string;
+  private versionCounter = 0;
+
+  constructor() {
+    this.branches.set(DEFAULT_BRANCH, { name: DEFAULT_BRANCH, docs: new Map() });
+    this.currentBranch = DEFAULT_BRANCH;
+  }
+
+  // --- internal helpers ---
+
+  private branch(name: string): Branch {
+    const b = this.branches.get(name);
+    if (!b) throw new Error(`Branch "${name}" does not exist`);
+    return b;
+  }
+
+  private cur(): Branch {
+    return this.branch(this.currentBranch);
+  }
+
+  private newVersion(content: object, parentId: string | null): StoredVersion {
+    const id = `v${++this.versionCounter}`;
+    const v: StoredVersion = {
+      id,
+      timestamp: Date.now(),
+      content: deepClone(content),
+      parentId,
+    };
+    this.versions.set(id, v);
+    return v;
+  }
+
+  /** Set of version ids along a document's chain from tip back to root. */
+  private chainSet(tipId: string): Set<string> {
+    const set = new Set<string>();
+    let cur: string | null = tipId;
+    while (cur) {
+      if (set.has(cur)) break; // safety against cycles
+      set.add(cur);
+      cur = this.versions.get(cur)?.parentId ?? null;
+    }
+    return set;
+  }
+
+  /** Lowest common ancestor version id of two chains, or null if none shared. */
+  private lca(tipA: string, tipB: string): string | null {
+    const a = this.chainSet(tipA);
+    let cur: string | null = tipB;
+    while (cur) {
+      if (a.has(cur)) return cur;
+      cur = this.versions.get(cur)?.parentId ?? null;
+    }
+    return null;
+  }
+
+  // --- Document CRUD ---
+
+  create(id: string, content: object): void {
+    const b = this.cur();
+    const existing = b.docs.get(id);
+    if (existing && !existing.deleted) {
+      throw new Error(`Document "${id}" already exists on branch "${b.name}"`);
+    }
+    // If a tombstone exists, chain onto its history; otherwise start fresh.
+    const parentId = existing ? existing.tipVersionId : null;
+    const v = this.newVersion(content, parentId);
+    b.docs.set(id, { tipVersionId: v.id, deleted: false });
+  }
+
+  get(id: string): object {
+    const b = this.cur();
+    const entry = b.docs.get(id);
+    if (!entry || entry.deleted) {
+      throw new Error(`Document "${id}" does not exist on branch "${b.name}"`);
+    }
+    return deepClone(this.versions.get(entry.tipVersionId)!.content);
+  }
+
+  update(id: string, content: object): void {
+    const b = this.cur();
+    const entry = b.docs.get(id);
+    if (!entry || entry.deleted) {
+      throw new Error(`Document "${id}" does not exist on branch "${b.name}"`);
+    }
+    const v = this.newVersion(content, entry.tipVersionId);
+    entry.tipVersionId = v.id;
+  }
+
+  delete(id: string): void {
+    const b = this.cur();
+    const entry = b.docs.get(id);
+    if (!entry || entry.deleted) {
+      throw new Error(`Document "${id}" does not exist on branch "${b.name}"`);
+    }
+    entry.deleted = true; // keep tip as tombstone for merge ancestry
+  }
+
+  // --- Version history ---
+
+  getHistory(id: string): Version[] {
+    const b = this.cur();
+    const entry = b.docs.get(id);
+    if (!entry) {
+      throw new Error(`Document "${id}" does not exist on branch "${b.name}"`);
+    }
+    const out: Version[] = [];
+    let cur: string | null = entry.tipVersionId;
+    while (cur) {
+      const v: StoredVersion = this.versions.get(cur)!;
+      out.push({ id: v.id, timestamp: v.timestamp, content: deepClone(v.content) });
+      cur = v.parentId;
+    }
+    out.reverse(); // chronological: oldest first
+    return out;
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const b = this.cur();
+    const entry = b.docs.get(id);
+    if (!entry) {
+      throw new Error(`Document "${id}" does not exist on branch "${b.name}"`);
+    }
+    // versionId must belong to this document's chain on the current branch.
+    if (!this.chainSet(entry.tipVersionId).has(versionId)) {
+      throw new Error(`Version "${versionId}" not found for document "${id}"`);
+    }
+    return deepClone(this.versions.get(versionId)!.content);
+  }
+
+  // --- Branching ---
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const source = this.branch(fromBranch ?? this.currentBranch);
+    const docs = new Map<string, DocEntry>();
+    for (const [docId, entry] of source.docs) {
+      docs.set(docId, { tipVersionId: entry.tipVersionId, deleted: entry.deleted });
+    }
+    this.branches.set(name, { name, docs });
+  }
+
+  switchBranch(name: string): void {
+    this.branch(name); // throws if missing
+    this.currentBranch = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  // --- Merging ---
+
+  merge(sourceBranch: string): MergeResult {
+    const ours = this.cur();
+    const theirs = this.branch(sourceBranch);
+    if (theirs.name === ours.name) {
+      throw new Error('Cannot merge a branch into itself');
+    }
+
+    const conflicts: Conflict[] = [];
+    const merged: Record<string, object> = {};
+    // Plan of changes to apply to the current branch if there are no conflicts.
+    const plan = new Map<string, { present: boolean; content?: object }>();
+
+    const docIds = new Set<string>([...ours.docs.keys(), ...theirs.docs.keys()]);
+
+    for (const docId of docIds) {
+      const oursEntry = ours.docs.get(docId);
+      const theirsEntry = theirs.docs.get(docId);
+
+      // Base (common ancestor) content, if both branches share a version chain.
+      let baseContent: object | undefined;
+      let baseExists = false;
+      if (oursEntry && theirsEntry) {
+        const lcaId = this.lca(oursEntry.tipVersionId, theirsEntry.tipVersionId);
+        if (lcaId) {
+          baseExists = true;
+          baseContent = this.versions.get(lcaId)!.content;
+        }
+      }
+
+      const oursPresent = !!oursEntry && !oursEntry.deleted;
+      const theirsPresent = !!theirsEntry && !theirsEntry.deleted;
+      const oursContent = oursPresent
+        ? this.versions.get(oursEntry!.tipVersionId)!.content
+        : undefined;
+      const theirsContent = theirsPresent
+        ? this.versions.get(theirsEntry!.tipVersionId)!.content
+        : undefined;
+
+      const resolved = this.mergeDocument(
+        docId,
+        baseExists,
+        baseContent,
+        oursPresent,
+        oursContent,
+        theirsPresent,
+        theirsContent,
+        conflicts,
+      );
+
+      plan.set(docId, resolved);
+      if (resolved.present) merged[docId] = deepClone(resolved.content!);
+    }
+
+    const applied = conflicts.length === 0;
+    if (applied) {
+      this.applyPlan(ours, plan);
+    }
+
+    return { merged, conflicts, applied };
+  }
+
+  /**
+   * Resolve a single document across base/ours/theirs.
+   * Returns the final presence + content for the merged result and pushes any conflicts.
+   */
+  private mergeDocument(
+    documentId: string,
+    baseExists: boolean,
+    baseContent: object | undefined,
+    oursPresent: boolean,
+    oursContent: object | undefined,
+    theirsPresent: boolean,
+    theirsContent: object | undefined,
+    conflicts: Conflict[],
+  ): { present: boolean; content?: object } {
+    if (!baseExists) {
+      // No common ancestor: independent add/add (or one-sided add).
+      if (oursPresent && theirsPresent) {
+        const merged = this.mergeObjects(
+          documentId,
+          {},
+          oursContent as Record<string, JSONValue>,
+          theirsContent as Record<string, JSONValue>,
+          '',
+          conflicts,
+        );
+        return { present: true, content: merged };
+      }
+      if (oursPresent) return { present: true, content: deepClone(oursContent!) };
+      if (theirsPresent) return { present: true, content: deepClone(theirsContent!) };
+      return { present: false };
+    }
+
+    // Base exists: classic three-way decisions.
+    const oursChanged = !oursPresent || !deepEqual(oursContent, baseContent);
+    const theirsChanged = !theirsPresent || !deepEqual(theirsContent, baseContent);
+
+    if (!oursChanged && !theirsChanged) {
+      return { present: true, content: deepClone(baseContent!) };
+    }
+    if (oursChanged && !theirsChanged) {
+      return oursPresent ? { present: true, content: deepClone(oursContent!) } : { present: false };
+    }
+    if (!oursChanged && theirsChanged) {
+      return theirsPresent
+        ? { present: true, content: deepClone(theirsContent!) }
+        : { present: false };
+    }
+
+    // Both sides changed.
+    if (!oursPresent && !theirsPresent) {
+      return { present: false }; // both deleted -> no conflict
+    }
+    if (!oursPresent || !theirsPresent) {
+      // delete/modify conflict at the document level; merged keeps ours.
+      conflicts.push({
+        documentId,
+        path: '',
+        base: deepClone(baseContent),
+        ours: oursPresent ? deepClone(oursContent) : null,
+        theirs: theirsPresent ? deepClone(theirsContent) : null,
+      });
+      return oursPresent ? { present: true, content: deepClone(oursContent!) } : { present: false };
+    }
+
+    // Both present and modified: structural field merge.
+    const merged = this.mergeObjects(
+      documentId,
+      (isPlainObject(baseContent) ? baseContent : {}) as Record<string, JSONValue>,
+      oursContent as Record<string, JSONValue>,
+      theirsContent as Record<string, JSONValue>,
+      '',
+      conflicts,
+    );
+    return { present: true, content: merged };
+  }
+
+  private mergeObjects(
+    documentId: string,
+    base: Record<string, JSONValue>,
+    ours: Record<string, JSONValue>,
+    theirs: Record<string, JSONValue>,
+    basePath: string,
+    conflicts: Conflict[],
+  ): Record<string, JSONValue> {
+    const result: Record<string, JSONValue> = {};
+    const keys = new Set<string>([
+      ...Object.keys(base ?? {}),
+      ...Object.keys(ours ?? {}),
+      ...Object.keys(theirs ?? {}),
+    ]);
+    for (const key of keys) {
+      const path = basePath ? `${basePath}.${key}` : key;
+      const field = this.mergeField(
+        documentId,
+        base ? base[key] : undefined,
+        ours ? ours[key] : undefined,
+        theirs ? theirs[key] : undefined,
+        path,
+        conflicts,
+      );
+      if (field.present) result[key] = field.value;
+    }
+    return result;
+  }
+
+  private mergeField(
+    documentId: string,
+    base: JSONValue,
+    ours: JSONValue,
+    theirs: JSONValue,
+    path: string,
+    conflicts: Conflict[],
+  ): { present: boolean; value?: JSONValue } {
+    if (deepEqual(ours, theirs)) {
+      // Same on both sides (covers both-absent and both-changed-identically).
+      return ours === undefined ? { present: false } : { present: true, value: deepClone(ours) };
+    }
+
+    const oursChanged = !deepEqual(ours, base);
+    const theirsChanged = !deepEqual(theirs, base);
+
+    if (oursChanged && !theirsChanged) {
+      return ours === undefined ? { present: false } : { present: true, value: deepClone(ours) };
+    }
+    if (!oursChanged && theirsChanged) {
+      return theirs === undefined ? { present: false } : { present: true, value: deepClone(theirs) };
+    }
+
+    // Both sides changed and they differ.
+    if (isPlainObject(ours) && isPlainObject(theirs)) {
+      const merged = this.mergeObjects(
+        documentId,
+        isPlainObject(base) ? base : {},
+        ours,
+        theirs,
+        path,
+        conflicts,
+      );
+      return { present: true, value: merged };
+    }
+
+    // Atomic conflict (primitives, arrays, or object-vs-non-object).
+    conflicts.push({
+      documentId,
+      path,
+      base: deepClone(base),
+      ours: deepClone(ours),
+      theirs: deepClone(theirs),
+    });
+    // merged resolves in favor of ours.
+    return ours === undefined ? { present: false } : { present: true, value: deepClone(ours) };
+  }
+
+  /** Apply the conflict-free merge result to a branch, creating versions as needed. */
+  private applyPlan(branch: Branch, plan: Map<string, { present: boolean; content?: object }>): void {
+    for (const [docId, target] of plan) {
+      const entry = branch.docs.get(docId);
+      const livePresent = !!entry && !entry.deleted;
+
+      if (target.present) {
+        if (!livePresent) {
+          // create (recreate over tombstone keeps chain; else fresh)
+          const parentId = entry ? entry.tipVersionId : null;
+          const v = this.newVersion(target.content!, parentId);
+          branch.docs.set(docId, { tipVersionId: v.id, deleted: false });
+        } else if (!deepEqual(target.content, this.versions.get(entry!.tipVersionId)!.content)) {
+          const v = this.newVersion(target.content!, entry!.tipVersionId);
+          entry!.tipVersionId = v.id;
+        }
+        // else unchanged: leave as-is
+      } else if (livePresent) {
+        entry!.deleted = true; // merge-driven deletion
+      }
+    }
+  }
+}
+
+export default DocumentStore;
