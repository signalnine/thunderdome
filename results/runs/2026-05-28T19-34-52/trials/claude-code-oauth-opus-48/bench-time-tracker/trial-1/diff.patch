@@ -0,0 +1,46 @@
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { dirname } from 'node:path';
+import type { TimeEntry } from './types.js';
+
+/**
+ * Reads time entries from the given JSON file.
+ * Returns an empty array if the file does not exist yet.
+ */
+export async function loadEntries(filePath: string): Promise<TimeEntry[]> {
+  let raw: string;
+  try {
+    raw = await readFile(filePath, 'utf8');
+  } catch (err) {
+    if (isNotFound(err)) {
+      return [];
+    }
+    throw err;
+  }
+
+  if (raw.trim() === '') {
+    return [];
+  }
+
+  const parsed: unknown = JSON.parse(raw);
+  if (!Array.isArray(parsed)) {
+    throw new Error(`Invalid time tracker data in ${filePath}: expected an array`);
+  }
+  return parsed as TimeEntry[];
+}
+
+/**
+ * Writes time entries to the given JSON file, creating parent directories as needed.
+ */
+export async function saveEntries(filePath: string, entries: TimeEntry[]): Promise<void> {
+  await mkdir(dirname(filePath), { recursive: true });
+  await writeFile(filePath, JSON.stringify(entries, null, 2), 'utf8');
+}
+
+function isNotFound(err: unknown): boolean {
+  return (
+    typeof err === 'object' &&
+    err !== null &&
+    'code' in err &&
+    (err as { code?: string }).code === 'ENOENT'
+  );
+}
diff --git a/src/tracker.test.ts b/src/tracker.test.ts
new file mode 100644
index 0000000..942bc51
--- /dev/null
+++ b/src/tracker.test.ts
@@ -0,0 +1,110 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { mkdtemp, rm, readFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { TimeTracker } from './index.js';
+
+let dir: string;
+let filePath: string;
+
+beforeEach(async () => {
+  dir = await mkdtemp(join(tmpdir(), 'tt-'));
+  filePath = join(dir, 'nested', 'data.json');
+});
+
+afterEach(async () => {
+  await rm(dir, { recursive: true, force: true });
+});
+
+describe('TimeTracker', () => {
+  it('starts and stops a timer, persisting to disk', async () => {
+    const tracker = await TimeTracker.create({ filePath });
+    await tracker.start('writing');
+    await tracker.stop();
+
+    const entries = tracker.getEntries();
+    expect(entries).toHaveLength(1);
+    expect(entries[0].task).toBe('writing');
+    expect(entries[0].stop).not.toBeNull();
+
+    // File and parent dirs were created.
+    const raw = await readFile(filePath, 'utf8');
+    expect(JSON.parse(raw)).toHaveLength(1);
+  });
+
+  it('auto-stops the previous timer when a new one starts', async () => {
+    const tracker = await TimeTracker.create({ filePath });
+    await tracker.start('a');
+    await tracker.start('b');
+
+    const entries = tracker.getEntries();
+    expect(entries).toHaveLength(2);
+    expect(entries[0].stop).not.toBeNull();
+    expect(entries[1].stop).toBeNull();
+    expect(tracker.getRunningEntry()?.task).toBe('b');
+  });
+
+  it('persists across sessions', async () => {
+    const t1 = await TimeTracker.create({ filePath });
+    await t1.start('task');
+    await t1.stop();
+
+    const t2 = await TimeTracker.create({ filePath });
+    expect(t2.getEntries()).toHaveLength(1);
+  });
+
+  it('throws on empty task name', async () => {
+    const tracker = await TimeTracker.create({ filePath });
+    await expect(tracker.start('')).rejects.toThrow();
+    await expect(tracker.start('   ')).rejects.toThrow();
+  });
+
+  it('throws when stopping with nothing running', async () => {
+    const tracker = await TimeTracker.create({ filePath });
+    await expect(tracker.stop()).rejects.toThrow();
+  });
+
+  it('filters entries by date range', async () => {
+    const tracker = await TimeTracker.create({ filePath });
+    await tracker.start('x');
+    await tracker.stop();
+
+    const all = tracker.getEntries();
+    const start = all[0].start;
+
+    expect(tracker.getEntries({ from: start, to: start })).toHaveLength(1);
+    expect(tracker.getEntries({ from: start + 1 })).toHaveLength(0);
+    expect(tracker.getEntries({ to: start - 1 })).toHaveLength(0);
+  });
+
+  it('summarizes total time per task', async () => {
+    const tracker = await TimeTracker.create({ filePath });
+    await tracker.start('a');
+    await tracker.start('b');
+    await tracker.start('a');
+    await tracker.stop();
+
+    const summary = tracker.getSummary();
+    expect(Object.keys(summary).sort()).toEqual(['a', 'b']);
+    expect(summary.a).toBeGreaterThanOrEqual(0);
+  });
+
+  it('counts running tasks up to the current time in the summary', async () => {
+    const tracker = await TimeTracker.create({ filePath });
+    await tracker.start('running');
+    const summary = tracker.getSummary();
+    expect(summary.running).toBeGreaterThanOrEqual(0);
+    expect(tracker.getRunningEntry()).toBeDefined();
+  });
+
+  it('supports unicode and emoji task names', async () => {
+    const tracker = await TimeTracker.create({ filePath });
+    const name = '日本語 タスク 🚀✅';
+    await tracker.start(name);
+    await tracker.stop();
+
+    const reloaded = await TimeTracker.create({ filePath });
+    expect(reloaded.getEntries()[0].task).toBe(name);
+    expect(reloaded.getSummary()[name]).toBeGreaterThanOrEqual(0);
+  });
+});
