+/**
+ * Tracks time spent on named tasks, persisting entries to a JSON file.
+ *
+ * Use {@link TimeTracker.create} to construct an instance, which loads any
+ * existing data from disk before returning.
+ */
+export class TimeTracker {
+  private readonly filePath: string;
+  private entries: TimeEntry[];
+
+  private constructor(filePath: string, entries: TimeEntry[]) {
+    this.filePath = filePath;
+    this.entries = entries;
+  }
+
+  /**
+   * Creates a tracker, loading any previously persisted entries from disk.
+   */
+  static async create(options: TimeTrackerOptions): Promise<TimeTracker> {
+    const entries = await loadEntries(options.filePath);
+    return new TimeTracker(options.filePath, entries);
+  }
+
+  /**
+   * Starts a new timer for the given task. If another timer is already
+   * running, it is stopped automatically before the new one begins.
+   *
+   * @throws if the task name is empty or only whitespace.
+   */
+  async start(task: string): Promise<TimeEntry> {
+    if (task.trim() === '') {
+      throw new Error('Cannot start a timer with an empty task name');
+    }
+
+    const now = Date.now();
+    const running = this.getRunningEntry();
+    if (running) {
+      running.stop = now;
+    }
+
+    const entry: TimeEntry = { task, start: now, stop: null };
+    this.entries.push(entry);
+    await this.persist();
+    return entry;
+  }
+
+  /**
+   * Stops the currently running timer.
+   *
+   * @throws if no timer is currently running.
+   */
+  async stop(): Promise<TimeEntry> {
+    const running = this.getRunningEntry();
+    if (!running) {
+      throw new Error('Cannot stop: no timer is currently running');
+    }
+    running.stop = Date.now();
+    await this.persist();
+    return running;
+  }
+
+  /**
+   * Returns the currently running entry, or undefined if none is running.
+   */
+  getRunningEntry(): TimeEntry | undefined {
+    return this.entries.find((e) => e.stop === null);
+  }
+
+  /**
+   * Returns all recorded entries, optionally filtered by date range.
+   *
+   * An entry matches a range if its start time falls within the (inclusive)
+   * bounds. Either bound may be omitted to leave that side unbounded.
+   */
+  getEntries(range?: DateRange): TimeEntry[] {
+    if (!range) {
+      return [...this.entries];
+    }
+    const from = toMillis(range.from, Number.NEGATIVE_INFINITY);
+    const to = toMillis(range.to, Number.POSITIVE_INFINITY);
+    return this.entries.filter((e) => e.start >= from && e.start <= to);
+  }
+
+  /**
+   * Returns a summary mapping each task name to the total time spent on it,
+   * in milliseconds. Entries with the same name are summed. Running entries
+   * count up to the current time.
+   *
+   * @param range optional date range to restrict which entries are summarized.
+   */
+  getSummary(range?: DateRange): Summary {
+    const now = Date.now();
+    const summary: Summary = {};
+    for (const entry of this.getEntries(range)) {
+      const end = entry.stop ?? now;
+      const duration = Math.max(0, end - entry.start);
+      summary[entry.task] = (summary[entry.task] ?? 0) + duration;
+    }
+    return summary;
+  }
+
+  private async persist(): Promise<void> {
+    await saveEntries(this.filePath, this.entries);
+  }
+}
+
+function toMillis(value: Date | number | undefined, fallback: number): number {
+  if (value === undefined) {
+    return fallback;
+  }
+  return value instanceof Date ? value.getTime() : value;
+}
