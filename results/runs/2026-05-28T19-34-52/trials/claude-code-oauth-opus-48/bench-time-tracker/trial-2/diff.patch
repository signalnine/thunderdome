+import { mkdirSync, readFileSync, writeFileSync, existsSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import type { Summary, TimeEntry, TimeTrackerOptions } from './types.js';
+
+const DEFAULT_FILE = 'time-entries.json';
+
+/** Normalize a `Date` or epoch-millisecond number into epoch milliseconds. */
+function toMillis(value: Date | number): number {
+  return value instanceof Date ? value.getTime() : value;
+}
+
+/**
+ * Tracks named timers and persists recorded entries to a JSON file.
+ *
+ * Only one timer can run at a time: starting a new timer automatically stops
+ * the one currently running. All mutations are persisted immediately so data
+ * survives between sessions.
+ */
+export class TimeTracker {
+  private readonly filePath: string;
+  private entries: TimeEntry[];
+
+  constructor(options: TimeTrackerOptions = {}) {
+    this.filePath = resolve(options.filePath ?? DEFAULT_FILE);
+    this.entries = this.load();
+  }
+
+  /**
+   * Start a new timer for `task`. If a timer is already running it is stopped
+   * first. Returns the newly created entry.
+   *
+   * @throws if `task` is empty or only whitespace.
+   */
+  start(task: string, now: number = Date.now()): TimeEntry {
+    if (task.trim().length === 0) {
+      throw new Error('Cannot start a timer with an empty task name.');
+    }
+
+    const running = this.running();
+    if (running) {
+      running.stop = now;
+    }
+
+    const entry: TimeEntry = { task, start: now, stop: null };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  /**
+   * Stop the currently running timer. Returns the stopped entry.
+   *
+   * @throws if no timer is running.
+   */
+  stop(now: number = Date.now()): TimeEntry {
+    const running = this.running();
+    if (!running) {
+      throw new Error('Cannot stop: no timer is currently running.');
+    }
+    running.stop = now;
+    this.save();
+    return running;
+  }
+
+  /** The currently running entry, or `undefined` if nothing is running. */
+  running(): TimeEntry | undefined {
+    return this.entries.find((e) => e.stop === null);
+  }
+
+  /** Return a copy of all recorded entries. */
+  getEntries(): TimeEntry[] {
+    return this.entries.map((e) => ({ ...e }));
+  }
+
+  /**
+   * Return entries that started within the inclusive range `[from, to]`.
+   * Either bound may be a `Date` or epoch milliseconds.
+   */
+  getEntriesInRange(from: Date | number, to: Date | number): TimeEntry[] {
+    const start = toMillis(from);
+    const end = toMillis(to);
+    return this.entries
+      .filter((e) => e.start >= start && e.start <= end)
+      .map((e) => ({ ...e }));
+  }
+
+  /**
+   * Summarize total time spent per task name, in milliseconds. Entries sharing
+   * a task name are summed. A running entry's duration is measured up to `now`.
+   */
+  summary(now: number = Date.now()): Summary {
+    const totals: Summary = {};
+    for (const entry of this.entries) {
+      const end = entry.stop ?? now;
+      const duration = Math.max(0, end - entry.start);
+      totals[entry.task] = (totals[entry.task] ?? 0) + duration;
+    }
+    return totals;
+  }
+
+  /** Load entries from disk, returning an empty list if the file is absent. */
+  private load(): TimeEntry[] {
+    if (!existsSync(this.filePath)) {
+      return [];
+    }
+    const raw = readFileSync(this.filePath, 'utf8').trim();
+    if (raw.length === 0) {
+      return [];
+    }
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) {
+      throw new Error(`Corrupt data file: expected an array in ${this.filePath}`);
+    }
+    return parsed as TimeEntry[];
+  }
+
+  /** Persist entries to disk, creating parent directories as needed. */
+  private save(): void {
+    mkdirSync(dirname(this.filePath), { recursive: true });
+    writeFileSync(this.filePath, JSON.stringify(this.entries, null, 2), 'utf8');
+  }
+}
