+/**
+ * A single recorded time entry.
+ *
+ * Timestamps are stored as Unix epoch milliseconds so they serialize cleanly
+ * to JSON and survive round-tripping between sessions.
+ */
+export interface TimeEntry {
+  /** The name of the task being tracked. May contain unicode / emoji. */
+  task: string;
+  /** When the timer was started, as epoch milliseconds. */
+  start: number;
+  /** When the timer was stopped, as epoch milliseconds, or `null` if still running. */
+  stop: number | null;
+}
+
+/** Options for configuring a {@link TimeTracker}. */
+export interface TimeTrackerOptions {
+  /**
+   * Path to the JSON file used to persist entries. The file and any parent
+   * directories are created automatically when data is first saved.
+   *
+   * Defaults to `time-entries.json` in the current working directory.
+   */
+  filePath?: string;
+}
+
+/**
+ * A summary mapping each task name to the total time spent on it, in
+ * milliseconds. Entries that share a task name are summed together.
+ */
+export type Summary = Record<string, number>;
