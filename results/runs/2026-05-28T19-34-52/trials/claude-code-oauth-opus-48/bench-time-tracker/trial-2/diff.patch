diff --git a/src/tracker.test.ts b/src/tracker.test.ts
new file mode 100644
index 0000000..061358b
--- /dev/null
+++ b/src/tracker.test.ts
@@ -0,0 +1,92 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { mkdtempSync, rmSync, existsSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { TimeTracker } from './index.js';
+
+let dir: string;
+let file: string;
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'tt-'));
+  file = join(dir, 'nested', 'entries.json');
+});
+
+afterEach(() => {
+  rmSync(dir, { recursive: true, force: true });
+});
+
+describe('TimeTracker', () => {
+  it('starts and stops a timer', () => {
+    const t = new TimeTracker({ filePath: file });
+    t.start('write code', 1000);
+    const stopped = t.stop(3000);
+    expect(stopped).toEqual({ task: 'write code', start: 1000, stop: 3000 });
+    expect(t.running()).toBeUndefined();
+  });
+
+  it('auto-stops the previous timer when a new one starts', () => {
+    const t = new TimeTracker({ filePath: file });
+    t.start('a', 1000);
+    t.start('b', 2000);
+    const entries = t.getEntries();
+    expect(entries).toHaveLength(2);
+    expect(entries[0]).toEqual({ task: 'a', start: 1000, stop: 2000 });
+    expect(entries[1]).toEqual({ task: 'b', start: 2000, stop: null });
+  });
+
+  it('throws on empty task name', () => {
+    const t = new TimeTracker({ filePath: file });
+    expect(() => t.start('')).toThrow();
+    expect(() => t.start('   ')).toThrow();
+  });
+
+  it('throws when stopping with nothing running', () => {
+    const t = new TimeTracker({ filePath: file });
+    expect(() => t.stop()).toThrow();
+  });
+
+  it('persists across instances and creates parent dirs', () => {
+    expect(existsSync(file)).toBe(false);
+    const a = new TimeTracker({ filePath: file });
+    a.start('task', 1000);
+    a.stop(2000);
+    expect(existsSync(file)).toBe(true);
+
+    const b = new TimeTracker({ filePath: file });
+    expect(b.getEntries()).toEqual([{ task: 'task', start: 1000, stop: 2000 }]);
+  });
+
+  it('filters entries by date range', () => {
+    const t = new TimeTracker({ filePath: file });
+    t.start('a', 1000);
+    t.start('b', 5000);
+    t.start('c', 9000);
+    const inRange = t.getEntriesInRange(2000, 6000);
+    expect(inRange.map((e) => e.task)).toEqual(['b']);
+    expect(t.getEntriesInRange(new Date(0), new Date(10000))).toHaveLength(3);
+  });
+
+  it('summarizes time per task, summing duplicates', () => {
+    const t = new TimeTracker({ filePath: file });
+    t.start('a', 0);
+    t.start('b', 100);
+    t.start('a', 300);
+    t.stop(700);
+    expect(t.summary()).toEqual({ a: 100 + 400, b: 200 });
+  });
+
+  it('uses current time for running tasks in summary', () => {
+    const t = new TimeTracker({ filePath: file });
+    t.start('a', 1000);
+    expect(t.summary(4000)).toEqual({ a: 3000 });
+  });
+
+  it('supports unicode and emoji task names', () => {
+    const t = new TimeTracker({ filePath: file });
+    t.start('café ☕ 作業 🚀', 0);
+    t.stop(500);
+    const reloaded = new TimeTracker({ filePath: file });
+    expect(reloaded.summary()).toEqual({ 'café ☕ 作業 🚀': 500 });
+  });
+});
