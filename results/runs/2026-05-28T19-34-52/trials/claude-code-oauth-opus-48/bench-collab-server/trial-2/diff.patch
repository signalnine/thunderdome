new file mode 100644
index 0000000..d0b7a90
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,157 @@
+import Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+
+export interface DocumentRow {
+  id: string;
+  title: string;
+  content: string;
+  version: number;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface VersionRow {
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS documents (
+  id TEXT PRIMARY KEY,
+  title TEXT NOT NULL,
+  content TEXT NOT NULL DEFAULT '',
+  version INTEGER NOT NULL DEFAULT 0,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  updated_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+
+CREATE TABLE IF NOT EXISTS versions (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  version INTEGER NOT NULL,
+  content TEXT NOT NULL,
+  operation TEXT,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  UNIQUE(document_id, version)
+);
+`;
+
+/**
+ * Thin persistence layer over SQLite. Holds the authoritative document content,
+ * a monotonically increasing version counter per document, and a full version
+ * history. All writes are synchronous (better-sqlite3) which keeps the OT apply
+ * loop simple and free of races.
+ */
+export class Db {
+  private db: Database.Database;
+
+  constructor(path = ':memory:') {
+    this.db = new Database(path);
+    this.db.pragma('journal_mode = WAL');
+    this.db.pragma('foreign_keys = ON');
+    this.db.exec(SCHEMA);
+  }
+
+  createDocument(title: string, content = ''): DocumentRow {
+    const id = randomUUID();
+    const insertDoc = this.db.prepare(
+      'INSERT INTO documents (id, title, content, version) VALUES (?, ?, ?, 0)',
+    );
+    const insertVersion = this.db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)',
+    );
+    this.db.transaction(() => {
+      insertDoc.run(id, title, content);
+      insertVersion.run(id, content);
+    })();
+    return this.getDocument(id)!;
+  }
+
+  getDocument(id: string): DocumentRow | undefined {
+    return this.db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as
+      | DocumentRow
+      | undefined;
+  }
+
+  listDocuments(): DocumentRow[] {
+    return this.db
+      .prepare('SELECT * FROM documents ORDER BY updated_at DESC')
+      .all() as DocumentRow[];
+  }
+
+  /** Update title and/or content directly (full replace), recording a version. */
+  updateDocument(
+    id: string,
+    fields: { title?: string; content?: string },
+  ): DocumentRow | undefined {
+    const existing = this.getDocument(id);
+    if (!existing) return undefined;
+
+    const title = fields.title ?? existing.title;
+    const content = fields.content ?? existing.content;
+    const contentChanged = fields.content !== undefined && fields.content !== existing.content;
+    const newVersion = contentChanged ? existing.version + 1 : existing.version;
+
+    this.db.transaction(() => {
+      this.db
+        .prepare(
+          "UPDATE documents SET title = ?, content = ?, version = ?, updated_at = datetime('now') WHERE id = ?",
+        )
+        .run(title, content, newVersion, id);
+      if (contentChanged) {
+        this.db
+          .prepare(
+            'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)',
+          )
+          .run(id, newVersion, content, JSON.stringify({ type: 'replace' }));
+      }
+    })();
+
+    return this.getDocument(id);
+  }
+
+  deleteDocument(id: string): boolean {
+    const result = this.db.prepare('DELETE FROM documents WHERE id = ?').run(id);
+    // Versions are removed via ON DELETE CASCADE (foreign_keys pragma is on).
+    return result.changes > 0;
+  }
+
+  getVersions(id: string): VersionRow[] {
+    return this.db
+      .prepare(
+        'SELECT version, content, operation, created_at FROM versions WHERE document_id = ? ORDER BY version ASC',
+      )
+      .all(id) as VersionRow[];
+  }
+
+  /**
+   * Commit a new version produced by a collaborative operation: bump the
+   * document's content/version and append a history row. Used by the WebSocket
+   * collaboration layer.
+   */
+  commitOperation(
+    id: string,
+    version: number,
+    content: string,
+    operation: unknown,
+  ): void {
+    this.db.transaction(() => {
+      this.db
+        .prepare(
+          "UPDATE documents SET content = ?, version = ?, updated_at = datetime('now') WHERE id = ?",
+        )
+        .run(content, version, id);
+      this.db
+        .prepare(
+          'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)',
+        )
+        .run(id, version, content, JSON.stringify(operation));
+    })();
+  }
+
+  close(): void {
+    this.db.close();
+  }
+}
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..434a52f
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,19 @@
+import { createApp } from './server.js';
+
+// Standalone entry point: run the collaboration server directly.
+const dbPath = process.env.DB_PATH ?? 'collab.db';
+const server = createApp(dbPath);
+
+const port = Number(process.env.PORT ?? 3000);
+server.start(port).then((actual) => {
+  // eslint-disable-next-line no-console
+  console.log(`Collaboration server listening on http://localhost:${actual}`);
+});
+
+for (const signal of ['SIGINT', 'SIGTERM'] as const) {
+  process.on(signal, () => {
+    server.stop().then(() => process.exit(0));
+  });
+}
+
+export { createApp };
diff --git a/src/ot.ts b/src/ot.ts
new file mode 100644
index 0000000..33a1076
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,140 @@
+// Operational Transform for plain-text documents.
+//
+// Operations are character-position based:
+//   - insert: { type: 'insert', pos, text }
+//   - delete: { type: 'delete', pos, length }
+//
+// The server maintains an authoritative document and version counter. Clients
+// send ops tagged with the base version they were generated against. The server
+// transforms each incoming op against every op that has been applied since that
+// base version, then applies and broadcasts it. Because the server applies all
+// ops in a single total order and rebroadcasts in that order, every client that
+// applies the broadcast stream converges to the same content.
+
+export type InsertOp = { type: 'insert'; pos: number; text: string };
+export type DeleteOp = { type: 'delete'; pos: number; length: number };
+export type Operation = InsertOp | DeleteOp;
+
+export class OpError extends Error {}
+
+/**
+ * Validate that an untrusted value is a structurally well-formed operation.
+ * Throws OpError with a human-readable message on failure.
+ */
+export function validateOp(value: unknown): Operation {
+  if (typeof value !== 'object' || value === null) {
+    throw new OpError('operation must be an object');
+  }
+  const op = value as Record<string, unknown>;
+
+  if (op.type === 'insert') {
+    if (!Number.isInteger(op.pos) || (op.pos as number) < 0) {
+      throw new OpError('insert.pos must be a non-negative integer');
+    }
+    if (typeof op.text !== 'string') {
+      throw new OpError('insert.text must be a string');
+    }
+    if (op.text.length === 0) {
+      throw new OpError('insert.text must not be empty');
+    }
+    return { type: 'insert', pos: op.pos as number, text: op.text };
+  }
+
+  if (op.type === 'delete') {
+    if (!Number.isInteger(op.pos) || (op.pos as number) < 0) {
+      throw new OpError('delete.pos must be a non-negative integer');
+    }
+    if (!Number.isInteger(op.length) || (op.length as number) <= 0) {
+      throw new OpError('delete.length must be a positive integer');
+    }
+    return { type: 'delete', pos: op.pos as number, length: op.length as number };
+  }
+
+  throw new OpError(`unknown operation type: ${String(op.type)}`);
+}
+
+/**
+ * Apply an operation to a document string. Positions are clamped to valid
+ * bounds so that a transformed op can never index outside the document.
+ */
+export function apply(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    const pos = clamp(op.pos, 0, content.length);
+    return content.slice(0, pos) + op.text + content.slice(pos);
+  }
+  const pos = clamp(op.pos, 0, content.length);
+  const end = clamp(pos + op.length, pos, content.length);
+  return content.slice(0, pos) + content.slice(end);
+}
+
+/**
+ * Transform operation `a` so that it can be applied *after* operation `b`,
+ * where `a` and `b` were both generated against the same prior document state
+ * (i.e. they are concurrent). Returns the adjusted version of `a`.
+ *
+ * `tieBreakAFirst` decides ordering when two inserts target the same position:
+ * when true, `a` keeps its position (lands to the left of `b`); when false,
+ * `a` is shifted right of `b`. Both insertions are always preserved.
+ */
+export function transform(a: Operation, b: Operation, tieBreakAFirst: boolean): Operation {
+  if (a.type === 'insert' && b.type === 'insert') {
+    if (a.pos < b.pos || (a.pos === b.pos && tieBreakAFirst)) {
+      return a;
+    }
+    return { ...a, pos: a.pos + b.text.length };
+  }
+
+  if (a.type === 'insert' && b.type === 'delete') {
+    if (a.pos <= b.pos) return a;
+    if (a.pos >= b.pos + b.length) return { ...a, pos: a.pos - b.length };
+    // Insertion point fell inside the deleted range: collapse to the deletion start.
+    return { ...a, pos: b.pos };
+  }
+
+  if (a.type === 'delete' && b.type === 'insert') {
+    if (b.pos <= a.pos) return { ...a, pos: a.pos + b.text.length };
+    if (b.pos >= a.pos + a.length) return a;
+    // The insertion landed inside the range we're deleting. We must never drop a
+    // concurrent insertion, and a single contiguous delete cannot remove the
+    // original characters on both sides while skipping the inserted text. So we
+    // shrink the delete to only the original characters before the insertion
+    // point; the inserted text (and any original chars after it) survive.
+    return { ...a, length: b.pos - a.pos };
+  }
+
+  // delete vs delete
+  const ad = a as DeleteOp;
+  const bd = b as DeleteOp;
+  const aStart = ad.pos;
+  const aEnd = ad.pos + ad.length;
+  const bStart = bd.pos;
+  const bEnd = bd.pos + bd.length;
+
+  const charsDeletedBeforeA = Math.max(0, Math.min(bEnd, aStart) - bStart);
+  const overlap = Math.max(0, Math.min(aEnd, bEnd) - Math.max(aStart, bStart));
+  const newPos = aStart - charsDeletedBeforeA;
+  const newLength = ad.length - overlap;
+
+  return { type: 'delete', pos: newPos, length: newLength };
+}
+
+/**
+ * Transform an incoming op against a sequence of already-applied concurrent ops
+ * (those applied after the op's base version), producing the op to apply now.
+ * Returns null if the op becomes a no-op (e.g. a delete fully subsumed by
+ * another delete).
+ */
+export function transformAgainst(op: Operation, applied: Operation[]): Operation | null {
+  let cur: Operation = op;
+  for (const prior of applied) {
+    // The incoming op is treated as "second"; prior server ops win ties so that
+    // ordering stays consistent with the order the server already committed.
+    cur = transform(cur, prior, false);
+    if (cur.type === 'delete' && cur.length <= 0) return null;
+  }
+  return cur;
+}
+
+function clamp(n: number, lo: number, hi: number): number {
+  return Math.max(lo, Math.min(hi, n));
+}
diff --git a/src/server.ts b/src/server.ts
new file mode 100644
index 0000000..67c4520
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,315 @@
+import express, { type Express, type Request, type Response } from 'express';
+import { createServer, type Server } from 'node:http';
+import { WebSocketServer, WebSocket } from 'ws';
+import { Db } from './db.js';
+import {
+  apply,
+  transformAgainst,
+  validateOp,
+  OpError,
+  type Operation,
+} from './ot.js';
+
+export interface CollabServer {
+  app: Express;
+  start(port?: number): Promise<number>;
+  stop(): Promise<void>;
+}
+
+/**
+ * An in-memory collaboration room for a single document. Holds the authoritative
+ * content and version while at least one client is connected. The version is the
+ * count of committed operations; each committed op records the resulting state
+ * so concurrent ops (those based on an older version) can be transformed.
+ */
+interface Room {
+  docId: string;
+  content: string;
+  version: number;
+  /** History of committed ops indexed by the version they produced. history[v] is the op that took version v-1 -> v. */
+  history: Operation[];
+  clients: Set<WebSocket>;
+}
+
+export function createApp(dbPath?: string): CollabServer {
+  const db = new Db(dbPath);
+  const app = express();
+  app.use(express.json({ limit: '5mb' }));
+
+  const httpServer: Server = createServer(app);
+  const wss = new WebSocketServer({ noServer: true });
+  const rooms = new Map<string, Room>();
+
+  // ---- REST API -----------------------------------------------------------
+
+  app.post('/documents', (req: Request, res: Response) => {
+    const { title, content } = req.body ?? {};
+    if (typeof title !== 'string' || title.length === 0) {
+      return res.status(400).json({ error: 'title is required and must be a non-empty string' });
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    const doc = db.createDocument(title, content ?? '');
+    res.status(201).json(doc);
+  });
+
+  app.get('/documents', (_req: Request, res: Response) => {
+    res.json(db.listDocuments());
+  });
+
+  app.get('/documents/:id', (req: Request, res: Response) => {
+    const doc = currentDoc(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    res.json(doc);
+  });
+
+  app.put('/documents/:id', (req: Request, res: Response) => {
+    const { title, content } = req.body ?? {};
+    if (title !== undefined && (typeof title !== 'string' || title.length === 0)) {
+      return res.status(400).json({ error: 'title must be a non-empty string' });
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    // If the document is being edited live, route the update through the room so
+    // in-memory state and connected clients stay consistent.
+    const room = rooms.get(req.params.id);
+    if (room && content !== undefined) {
+      if (!db.getDocument(req.params.id)) {
+        return res.status(404).json({ error: 'document not found' });
+      }
+      room.content = content;
+      room.version += 1;
+      // Record a full replace as a "delete everything + insert" is unnecessary;
+      // a sync is broadcast instead so clients reset to the new content. The
+      // history slot is filled with an empty insert so version indexing stays
+      // contiguous (concurrent ops based on older versions just re-sync).
+      room.history[room.version] = { type: 'insert', pos: 0, text: '' };
+      db.commitOperation(req.params.id, room.version, content, { type: 'replace' });
+      if (title !== undefined) db.updateDocument(req.params.id, { title });
+      broadcast(room, null, {
+        type: 'sync',
+        docId: room.docId,
+        content: room.content,
+        version: room.version,
+      });
+      return res.json(currentDoc(req.params.id));
+    }
+    const doc = db.updateDocument(req.params.id, { title, content });
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    res.json(doc);
+  });
+
+  app.delete('/documents/:id', (req: Request, res: Response) => {
+    const room = rooms.get(req.params.id);
+    if (room) {
+      for (const ws of room.clients) ws.close(4004, 'document deleted');
+      rooms.delete(req.params.id);
+    }
+    const ok = db.deleteDocument(req.params.id);
+    if (!ok) return res.status(404).json({ error: 'document not found' });
+    res.status(204).end();
+  });
+
+  app.get('/documents/:id/versions', (req: Request, res: Response) => {
+    const doc = db.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    const versions = db.getVersions(req.params.id).map((v) => ({
+      ...v,
+      operation: v.operation ? JSON.parse(v.operation) : null,
+    }));
+    res.json(versions);
+  });
+
+  // Return the freshest view of a document: live room state if active, else DB.
+  function currentDoc(id: string) {
+    const doc = db.getDocument(id);
+    if (!doc) return undefined;
+    const room = rooms.get(id);
+    if (room) {
+      return { ...doc, content: room.content, version: room.version };
+    }
+    return doc;
+  }
+
+  // ---- WebSocket collaboration -------------------------------------------
+
+  httpServer.on('upgrade', (request, socket, head) => {
+    const url = new URL(request.url ?? '/', 'http://localhost');
+    const docId = parseDocId(url.pathname);
+    if (!docId) {
+      socket.write('HTTP/1.1 400 Bad Request\r\n\r\n');
+      socket.destroy();
+      return;
+    }
+    const doc = db.getDocument(docId);
+    if (!doc) {
+      socket.write('HTTP/1.1 404 Not Found\r\n\r\n');
+      socket.destroy();
+      return;
+    }
+    wss.handleUpgrade(request, socket, head, (ws) => {
+      wss.emit('connection', ws, request, docId);
+    });
+  });
+
+  wss.on('connection', (ws: WebSocket, _request: unknown, docId: string) => {
+    const room = getOrCreateRoom(docId);
+    if (!room) {
+      ws.close(4004, 'document not found');
+      return;
+    }
+    room.clients.add(ws);
+
+    send(ws, {
+      type: 'sync',
+      docId: room.docId,
+      content: room.content,
+      version: room.version,
+    });
+
+    ws.on('message', (data) => handleMessage(room, ws, data));
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      if (room.clients.size === 0) rooms.delete(room.docId);
+    });
+    ws.on('error', () => {
+      room.clients.delete(ws);
+    });
+  });
+
+  function getOrCreateRoom(docId: string): Room | null {
+    const existing = rooms.get(docId);
+    if (existing) return existing;
+    const doc = db.getDocument(docId);
+    if (!doc) return null;
+    const room: Room = {
+      docId,
+      content: doc.content,
+      version: doc.version,
+      history: [],
+      clients: new Set(),
+    };
+    rooms.set(docId, room);
+    return room;
+  }
+
+  function handleMessage(room: Room, ws: WebSocket, data: unknown): void {
+    let msg: Record<string, unknown>;
+    try {
+      msg = JSON.parse(String(data));
+    } catch {
+      return send(ws, { type: 'error', error: 'invalid JSON' });
+    }
+
+    if (msg.type !== 'op') {
+      return send(ws, { type: 'error', error: `unsupported message type: ${String(msg.type)}` });
+    }
+
+    // Base version the client generated this op against. Defaults to current
+    // (no concurrent ops) when omitted.
+    const baseVersion =
+      typeof msg.version === 'number' && Number.isInteger(msg.version)
+        ? msg.version
+        : room.version;
+
+    if (baseVersion < 0 || baseVersion > room.version) {
+      return send(ws, { type: 'error', error: `invalid base version: ${baseVersion}` });
+    }
+
+    let op: Operation;
+    try {
+      op = validateOp(msg.op);
+    } catch (err) {
+      const message = err instanceof OpError ? err.message : 'invalid operation';
+      return send(ws, { type: 'error', error: message });
+    }
+
+    // Transform against every op committed since the client's base version.
+    const concurrent = room.history.slice(baseVersion + 1, room.version + 1);
+    const transformed = transformAgainst(op, concurrent);
+
+    if (!transformed) {
+      // Op was fully subsumed (e.g. text already deleted by a concurrent op).
+      return send(ws, { type: 'ack', version: room.version });
+    }
+
+    const newContent = apply(room.content, transformed);
+    const newVersion = room.version + 1;
+
+    try {
+      // Persist first; only mutate in-memory state once the write succeeds so a
+      // persistence failure can never leave the room diverged from the database.
+      db.commitOperation(room.docId, newVersion, newContent, transformed);
+    } catch {
+      return send(ws, { type: 'error', error: 'failed to persist operation' });
+    }
+
+    room.content = newContent;
+    room.version = newVersion;
+    room.history[newVersion] = transformed;
+
+    // Broadcast the committed op (in total order) to every client, including the
+    // originator, so all clients applying the stream converge to room.content.
+    broadcast(room, null, {
+      type: 'op',
+      docId: room.docId,
+      op: transformed,
+      version: room.version,
+    });
+  }
+
+  function broadcast(room: Room, except: WebSocket | null, payload: unknown): void {
+    const data = JSON.stringify(payload);
+    for (const client of room.clients) {
+      if (client === except) continue;
+      if (client.readyState === WebSocket.OPEN) client.send(data);
+    }
+  }
+
+  // ---- lifecycle ----------------------------------------------------------
+
+  function start(port = 0): Promise<number> {
+    return new Promise((resolve, reject) => {
+      httpServer.once('error', reject);
+      httpServer.listen(port, () => {
+        const addr = httpServer.address();
+        const actual = typeof addr === 'object' && addr ? addr.port : port;
+        httpServer.removeListener('error', reject);
+        resolve(actual);
+      });
+    });
+  }
+
+  function stop(): Promise<void> {
+    return new Promise((resolve) => {
+      for (const room of rooms.values()) {
+        for (const ws of room.clients) ws.terminate();
+      }
+      rooms.clear();
+      wss.close(() => {
+        httpServer.close(() => {
+          db.close();
+          resolve();
+        });
+      });
+    });
+  }
+
+  return { app, start, stop };
+}
+
+function parseDocId(pathname: string): string | null {
+  // Accept /ws/:id, /documents/:id/ws, or /:id
+  const parts = pathname.split('/').filter(Boolean);
+  if (parts.length === 0) return null;
+  if (parts[0] === 'ws' && parts[1]) return decodeURIComponent(parts[1]);
+  if (parts[0] === 'documents' && parts[1]) return decodeURIComponent(parts[1]);
+  if (parts.length === 1) return decodeURIComponent(parts[0]);
+  return null;
+}
+
+function send(ws: WebSocket, payload: unknown): void {
+  if (ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify(payload));
+}
