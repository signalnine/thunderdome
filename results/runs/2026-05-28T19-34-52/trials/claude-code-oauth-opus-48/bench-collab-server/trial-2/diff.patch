+describe('WebSocket collaboration', () => {
+  it('sends a sync message with current content on connect', async () => {
+    const id = await createDoc('Sync', 'initial content');
+    const client = new TestClient(id);
+    await client.ready();
+    await client.waitForVersion(0);
+    expect(client.content).toBe('initial content');
+    expect(client.version).toBe(0);
+    client.close();
+  });
+
+  it('broadcasts edits to other connected clients', async () => {
+    const id = await createDoc('Broadcast', 'abc');
+    const a = new TestClient(id);
+    const b = new TestClient(id);
+    await Promise.all([a.ready(), b.ready()]);
+    await Promise.all([a.waitForVersion(0), b.waitForVersion(0)]);
+
+    a.send({ type: 'insert', pos: 3, text: 'def' }, 0);
+    await Promise.all([a.waitForVersion(1), b.waitForVersion(1)]);
+
+    expect(a.content).toBe('abcdef');
+    expect(b.content).toBe('abcdef');
+    a.close();
+    b.close();
+  });
+
+  it('rejects malformed operations without crashing', async () => {
+    const id = await createDoc('Bad', 'abc');
+    const client = new TestClient(id);
+    await client.ready();
+    await client.waitForVersion(0);
+
+    client.sendRaw('not json');
+    client.sendRaw({ type: 'op', op: { type: 'frobnicate' } });
+    client.sendRaw({ type: 'op', op: { type: 'insert', pos: -5, text: 'x' } });
+    client.sendRaw({ type: 'mystery' });
+
+    await new Promise((r) => setTimeout(r, 200));
+    expect(client.errors.length).toBeGreaterThanOrEqual(4);
+
+    // Still alive and functional after bad input.
+    client.send({ type: 'insert', pos: 3, text: 'd' }, 0);
+    await client.waitForVersion(1);
+    expect(client.content).toBe('abcd');
+    client.close();
+  });
+
+  it('rejects ws connection to unknown document', async () => {
