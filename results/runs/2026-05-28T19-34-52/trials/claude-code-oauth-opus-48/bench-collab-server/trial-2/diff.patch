+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { rmSync } from 'node:fs';
+import { WebSocket } from 'ws';
+import request from 'supertest';
+import { createApp, type CollabServer } from '../src/server.js';
+import { apply, type Operation } from '../src/ot.js';
+
+let server: CollabServer;
+let port: number;
+let baseUrl: string;
+
+beforeEach(async () => {
+  server = createApp(':memory:');
+  port = await server.start(0);
+  baseUrl = `http://localhost:${port}`;
+});
+
+afterEach(async () => {
+  await server.stop();
+});
+
+// A minimal collaboration client: tracks document state purely from the server
+// message stream (sync + ordered op broadcasts), exactly as a real client would.
+class TestClient {
+  ws: WebSocket;
+  content = '';
+  version = -1;
+  errors: string[] = [];
+  private waiters: Array<{ v: number; resolve: () => void }> = [];
+
+  constructor(docId: string) {
+    this.ws = new WebSocket(`ws://localhost:${port}/ws/${docId}`);
+    this.ws.on('message', (data) => {
+      const msg = JSON.parse(String(data));
+      if (msg.type === 'sync') {
+        this.content = msg.content;
+        this.version = msg.version;
+      } else if (msg.type === 'op') {
+        this.content = apply(this.content, msg.op as Operation);
+        this.version = msg.version;
+      } else if (msg.type === 'error') {
+        this.errors.push(msg.error);
+      }
+      this.checkWaiters();
+    });
+  }
+
+  private checkWaiters() {
+    this.waiters = this.waiters.filter((w) => {
+      if (this.version >= w.v) {
+        w.resolve();
+        return false;
+      }
+      return true;
+    });
+  }
+
+  ready(): Promise<void> {
+    return new Promise((resolve) => {
+      if (this.ws.readyState === WebSocket.OPEN) resolve();
+      else this.ws.once('open', () => resolve());
+    });
+  }
+
+  waitForVersion(v: number, timeoutMs = 5000): Promise<void> {
+    return new Promise((resolve, reject) => {
+      if (this.version >= v) return resolve();
+      const timer = setTimeout(
+        () => reject(new Error(`timeout waiting for version ${v} (at ${this.version})`)),
+        timeoutMs,
+      );
+      this.waiters.push({
+        v,
+        resolve: () => {
+          clearTimeout(timer);
+          resolve();
+        },
+      });
+    });
+  }
+
+  send(op: Operation, baseVersion: number) {
+    this.ws.send(JSON.stringify({ type: 'op', op, version: baseVersion }));
+  }
+
+  sendRaw(payload: unknown) {
+    this.ws.send(typeof payload === 'string' ? payload : JSON.stringify(payload));
+  }
+
+  close() {
+    this.ws.close();
+  }
+}
+
+async function createDoc(title: string, content = ''): Promise<string> {
+  const res = await request(baseUrl).post('/documents').send({ title, content });
+  expect(res.status).toBe(201);
+  return res.body.id;
+}
+
+describe('REST API', () => {
+  it('creates, reads, lists, updates and deletes documents', async () => {
+    const create = await request(baseUrl)
+      .post('/documents')
+      .send({ title: 'Doc', content: 'hello' });
+    expect(create.status).toBe(201);
+    expect(create.body).toMatchObject({ title: 'Doc', content: 'hello', version: 0 });
+    const id = create.body.id;
+
+    const get = await request(baseUrl).get(`/documents/${id}`);
+    expect(get.status).toBe(200);
+    expect(get.body.content).toBe('hello');
+
+    const list = await request(baseUrl).get('/documents');
+    expect(list.status).toBe(200);
+    expect(list.body).toHaveLength(1);
+
+    const put = await request(baseUrl)
+      .put(`/documents/${id}`)
+      .send({ title: 'Renamed', content: 'goodbye' });
+    expect(put.status).toBe(200);
+    expect(put.body.title).toBe('Renamed');
+    expect(put.body.content).toBe('goodbye');
+    expect(put.body.version).toBe(1);
+
+    const del = await request(baseUrl).delete(`/documents/${id}`);
+    expect(del.status).toBe(204);
+
+    const after = await request(baseUrl).get(`/documents/${id}`);
+    expect(after.status).toBe(404);
+  });
+
+  it('validates input', async () => {
