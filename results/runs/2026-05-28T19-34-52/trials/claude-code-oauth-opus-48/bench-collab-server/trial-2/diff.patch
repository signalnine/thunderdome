+describe('conflict resolution / convergence', () => {
+  it('preserves all concurrent insertions at the same position (10 clients)', async () => {
+    const id = await createDoc('Concurrent', '');
+    const N = 10;
+    const clients = Array.from({ length: N }, () => new TestClient(id));
+    await Promise.all(clients.map((c) => c.ready()));
+    await Promise.all(clients.map((c) => c.waitForVersion(0)));
+
+    // Every client inserts its own distinct character at position 0, all based
+    // on the same starting version. Nothing may be dropped.
+    clients.forEach((c, i) => c.send({ type: 'insert', pos: 0, text: String(i) }, 0));
+
+    await Promise.all(clients.map((c) => c.waitForVersion(N)));
+
+    // All clients converge to identical content...
+    const reference = clients[0].content;
+    for (const c of clients) expect(c.content).toBe(reference);
+
+    // ...which contains every insertion...
+    expect(reference.length).toBe(N);
+    for (let i = 0; i < N; i++) expect(reference).toContain(String(i));
+
+    // ...and matches the authoritative persisted state.
+    const rest = await request(baseUrl).get(`/documents/${id}`);
+    expect(rest.body.content).toBe(reference);
+    expect(rest.body.version).toBe(N);
+
+    clients.forEach((c) => c.close());
+  });
+
+  it('converges under interleaved inserts and deletes from many clients', async () => {
+    const id = await createDoc('Mixed', 'The quick brown fox');
+    const N = 6;
+    const clients = Array.from({ length: N }, () => new TestClient(id));
+    await Promise.all(clients.map((c) => c.ready()));
+    await Promise.all(clients.map((c) => c.waitForVersion(0)));
+
+    // A deterministic mix of concurrent ops, all based on version 0.
+    const ops: Operation[] = [
+      { type: 'insert', pos: 0, text: '>>' },
+      { type: 'insert', pos: 19, text: '!!' },
+      { type: 'delete', pos: 4, length: 5 }, // "quick"
+      { type: 'insert', pos: 10, text: 'XYZ' },
+      { type: 'delete', pos: 0, length: 3 }, // "The"
+      { type: 'insert', pos: 9, text: '_' },
+    ];
+    clients.forEach((c, i) => c.send(ops[i], 0));
+
+    await Promise.all(clients.map((c) => c.waitForVersion(N)));
+
+    const reference = clients[0].content;
+    for (const c of clients) expect(c.content).toBe(reference);
+
+    const rest = await request(baseUrl).get(`/documents/${id}`);
+    expect(rest.body.content).toBe(reference);
+
+    clients.forEach((c) => c.close());
+  });
+});
