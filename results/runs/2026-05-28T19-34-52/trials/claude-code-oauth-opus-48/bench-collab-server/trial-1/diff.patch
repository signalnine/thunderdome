leanup of temp db files.\nprocess.on('exit', () => {\n  for (const f of dbFiles) {\n    try {\n      rmSync(f, { force: true });\n      rmSync(`${f}-wal`, { force: true });\n      rmSync(`${f}-shm`, { force: true });\n    } catch {\n      /* ignore */\n    }\n  }\n});\n","structuredPatch":[{"oldStart":113,"oldLines":23,"newStart":113,"newLines":23,"lines":["     const { body: doc } = await http(port, 'POST', '/documents', { title: 'T', content: 'abc' });"," ","     const a = await connect(port, doc.id);","-    const syncA = await nextMessage(a);","+    const syncA = await a.next();","     expect(syncA.type).toBe('sync');","     expect(syncA.content).toBe('abc');"," ","     const b = await connect(port, doc.id);","-    await nextMessage(b); // sync","+    await b.next(); // sync"," ","     // A inserts at end; both A and B should receive the op broadcast.","-    const recvA = nextMessage(a);","-    const recvB = nextMessage(b);","-    a.send(JSON.stringify({ type: 'op', baseVersion: syncA.version, op: { type: 'insert', pos: 3, text: 'd' } }));","+    const recvA = a.next();","+    const recvB = b.next();","+    a.ws.send(JSON.stringify({ type: 'op', baseVersion: syncA.version, op: { type: 'insert', pos: 3, text: 'd' } }));","     const [ma, mb] = await Promise.all([recvA, recvB]);","     expect(ma.type).toBe('op');","     expect(mb.type).toBe('op');"," ","-    a.close();","-    b.close();","+    a.ws.close();","+    b.ws.close();"," ","     // Authoritative content persisted.","     const after = await http(port, 'GET', `/documents/${doc.id}`);"]}],"userModified":false,"replaceAll":false}}
