+import { describe, it, expect, afterEach } from 'vitest';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { rmSync } from 'node:fs';
+import WebSocket from 'ws';
+import { createApp, type CollabServer } from './server.js';
+
+let server: CollabServer | undefined;
+const dbFiles: string[] = [];
+
+afterEach(async () => {
+  if (server) await server.stop();
+  server = undefined;
+});
+
+function tmpDb(): string {
+  const f = join(tmpdir(), `collab-${randomUUID()}.db`);
+  dbFiles.push(f);
+  return f;
+}
+
+async function http(port: number, method: string, path: string, body?: unknown) {
+  const res = await fetch(`http://127.0.0.1:${port}${path}`, {
+    method,
+    headers: { 'content-type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const text = await res.text();
+  return { status: res.status, body: text ? JSON.parse(text) : undefined };
+}
+
+// A buffering test client: messages are queued as they arrive so callers never
+// miss one to a listener-attach race (the server sends `sync` immediately).
+interface TestClient {
+  ws: WebSocket;
+  next(): Promise<Record<string, unknown>>;
+}
+
+function connect(port: number, docId: string): Promise<TestClient> {
+  return new Promise((resolve, reject) => {
+    const ws = new WebSocket(`ws://127.0.0.1:${port}/documents/${docId}/ws`);
+    const queue: Record<string, unknown>[] = [];
+    let waiter: ((m: Record<string, unknown>) => void) | undefined;
+    ws.on('message', (data) => {
+      const m = JSON.parse(data.toString());
+      if (waiter) {
+        waiter(m);
+        waiter = undefined;
+      } else {
+        queue.push(m);
+      }
+    });
+    ws.once('error', reject);
+    ws.once('open', () =>
+      resolve({
+        ws,
+        next: () =>
+          new Promise((res) => {
+            const queued = queue.shift();
+            if (queued) res(queued);
+            else waiter = res;
+          }),
+      }),
+    );
+  });
+}
+
+describe('REST API', () => {
+  it('supports full CRUD + version history', async () => {
+    server = createApp(tmpDb());
+    const port = await server.start(0);
+
+    // Create
+    const created = await http(port, 'POST', '/documents', { title: 'Doc', content: 'hello' });
+    expect(created.status).toBe(201);
+    const id = created.body.id;
+    expect(created.body.title).toBe('Doc');
+
+    // Read
+    const got = await http(port, 'GET', `/documents/${id}`);
+    expect(got.body.content).toBe('hello');
+
+    // List
+    const list = await http(port, 'GET', '/documents');
+    expect(list.body.length).toBe(1);
+
+    // Update (content change => new version)
+    const updated = await http(port, 'PUT', `/documents/${id}`, { content: 'hello world' });
+    expect(updated.body.content).toBe('hello world');
+
+    const versions = await http(port, 'GET', `/documents/${id}/versions`);
+    expect(versions.body.length).toBeGreaterThanOrEqual(2);
+
+    // Delete
+    const del = await http(port, 'DELETE', `/documents/${id}`);
+    expect(del.status).toBe(204);
+    expect((await http(port, 'GET', `/documents/${id}`)).status).toBe(404);
+  });
+
+  it('rejects invalid create', async () => {
+    server = createApp(tmpDb());
+    const port = await server.start(0);
+    expect((await http(port, 'POST', '/documents', {})).status).toBe(400);
+    expect((await http(port, 'POST', '/documents', { title: 5 })).status).toBe(400);
+  });
+});
+
+describe('WebSocket collaboration', () => {
+  it('syncs on connect and broadcasts edits', async () => {
+    server = createApp(tmpDb());
+    const port = await server.start(0);
+    const { body: doc } = await http(port, 'POST', '/documents', { title: 'T', content: 'abc' });
+
+    const a = await connect(port, doc.id);
+    const syncA = await a.next();
+    expect(syncA.type).toBe('sync');
+    expect(syncA.content).toBe('abc');
+
+    const b = await connect(port, doc.id);
+    await b.next(); // sync
+
+    // A inserts at end; both A and B should receive the op broadcast.
+    const recvA = a.next();
+    const recvB = b.next();
+    a.ws.send(JSON.stringify({ type: 'op', baseVersion: syncA.version, op: { type: 'insert', pos: 3, text: 'd' } }));
+    const [ma, mb] = await Promise.all([recvA, recvB]);
+    expect(ma.type).toBe('op');
+    expect(mb.type).toBe('op');
+
+    a.ws.close();
+    b.ws.close();
+
+    // Authoritative content persisted.
+    const after = await http(port, 'GET', `/documents/${doc.id}`);
+    expect(after.body.content).toBe('abcd');
+  });
+
+  it('rejects malformed operations without crashing', async () => {
+    server = createApp(tmpDb());
+    const port = await server.start(0);
+    const { body: doc } = await http(port, 'POST', '/documents', { title: 'T', content: 'abc' });
+    const a = await connect(port, doc.id);
+    await a.next(); // sync
+
+    const err1 = a.next();
+    a.ws.send('not json');
+    expect((await err1).type).toBe('error');
+
+    const err2 = a.next();
+    a.ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 999, text: 'x' } }));
+    expect((await err2).type).toBe('error');
+
+    const err3 = a.next();
+    a.ws.send(JSON.stringify({ type: 'bogus' }));
+    expect((await err3).type).toBe('error');
+
+    // Server is still alive and accepts a valid op afterwards.
+    const ok = a.next();
+    a.ws.send(JSON.stringify({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 3, text: 'd' } }));
+    expect((await ok).type).toBe('op');
+
+    a.ws.close();
+  });
+
+  it('10 concurrent clients converge without corruption', async () => {
+    server = createApp(tmpDb());
+    const port = await server.start(0);
+    const { body: doc } = await http(port, 'POST', '/documents', { title: 'T', content: '' });
+
+    const N = 10;
+    const clients: TestClient[] = [];
+    const versions: number[] = [];
+    for (let i = 0; i < N; i++) {
+      const c = await connect(port, doc.id);
+      const sync = await c.next();
+      versions[i] = sync.version as number;
+      clients.push(c);
+    }
+
+    // Each client appends its own marker at position 0 concurrently. With OT,
+    // all insertions must be preserved (none silently dropped). Every client
+    // should observe all N op broadcasts.
+    let received = 0;
+    const done = new Promise<void>((resolve) => {
+      for (const c of clients) {
+        c.ws.on('message', (data) => {
+          const m = JSON.parse(data.toString());
+          if (m.type === 'op') {
+            received++;
+            if (received >= N * N) resolve();
+          }
+        });
+      }
+    });
+
+    for (let i = 0; i < N; i++) {
+      clients[i].ws.send(
+        JSON.stringify({ type: 'op', baseVersion: versions[i], op: { type: 'insert', pos: 0, text: String.fromCharCode(65 + i) } }),
+      );
+    }
+
+    await done;
+    for (const c of clients) c.ws.close();
+
+    const after = await http(port, 'GET', `/documents/${doc.id}`);
+    // All 10 distinct characters preserved.
+    expect((after.body.content as string).length).toBe(N);
+    for (let i = 0; i < N; i++) {
+      expect(after.body.content).toContain(String.fromCharCode(65 + i));
+    }
+  });
+});
+
+describe('persistence across restart', () => {
+  it('reloads documents and versions from disk', async () => {
+    const db = tmpDb();
+    server = createApp(db);
+    let port = await server.start(0);
+    const { body: doc } = await http(port, 'POST', '/documents', { title: 'Persisted', content: 'v0' });
+
+    // Make an edit over WebSocket so a version is committed.
+    const c = await connect(port, doc.id);
+    const sync = await c.next();
+    const recv = c.next();
+    c.ws.send(JSON.stringify({ type: 'op', baseVersion: sync.version, op: { type: 'insert', pos: 2, text: '!' } }));
+    await recv;
+    c.ws.close();
+    await server.stop();
+
+    // Restart against the same file.
+    server = createApp(db);
+    port = await server.start(0);
+    const got = await http(port, 'GET', `/documents/${doc.id}`);
+    expect(got.body.content).toBe('v0!');
+    const versions = await http(port, 'GET', `/documents/${doc.id}/versions`);
+    expect(versions.body.length).toBeGreaterThanOrEqual(2);
+  });
+});
+
+// Best-effort cleanup of temp db files.
+process.on('exit', () => {
+  for (const f of dbFiles) {
+    try {
+      rmSync(f, { force: true });
+      rmSync(`${f}-wal`, { force: true });
+      rmSync(`${f}-shm`, { force: true });
+    } catch {
+      /* ignore */
+    }
+  }
+});
diff --git a/src/server.ts b/src/server.ts
new file mode 100644
index 0000000..92ee51a
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,279 @@
+import express, { type Express, type Request, type Response } from 'express';
+import { createServer, type Server } from 'node:http';
+import { WebSocketServer, WebSocket } from 'ws';
+import { Store } from './db.js';
+import { apply, transformAgainst, validateOp, type Op } from './ot.js';
+
+interface ServerMessage {
+  type: 'sync' | 'op' | 'error' | 'ack';
+  [key: string]: unknown;
+}
+
+// A DocRoom holds the in-memory authoritative state for one document while at
+// least one client is connected: current content, version, the history of ops
+// applied since the room opened (used to transform stale incoming ops), and the
+// set of connected sockets.
+class DocRoom {
+  content: string;
+  version: number;
+  baseVersion: number;
+  history: Op[][] = [];
+  clients = new Set<WebSocket>();
+
+  constructor(content: string, version: number) {
+    this.content = content;
+    this.version = version;
+    this.baseVersion = version;
+  }
+
+  /** Ops applied since `fromVersion` (clamped to what the room still remembers). */
+  opsSince(fromVersion: number): Op[] {
+    const start = Math.max(0, fromVersion - this.baseVersion);
+    return this.history.slice(start).flat();
+  }
+
+  broadcast(message: ServerMessage): void {
+    const data = JSON.stringify(message);
+    for (const ws of this.clients) {
+      if (ws.readyState === WebSocket.OPEN) ws.send(data);
+    }
+  }
+}
+
+export interface CollabServer {
+  app: Express;
+  start(port?: number): Promise<number>;
+  stop(): Promise<void>;
+}
+
+export function createApp(dbPath = ':memory:'): CollabServer {
+  const store = new Store(dbPath);
+  const app = express();
+  app.use(express.json({ limit: '5mb' }));
+
+  // ---- REST API -----------------------------------------------------------
+
+  app.post('/documents', (req: Request, res: Response) => {
+    const { title, content } = req.body ?? {};
+    if (typeof title !== 'string' || title.length === 0) {
+      return res.status(400).json({ error: 'title is required and must be a non-empty string' });
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    const doc = store.createDocument(title, content ?? '');
+    res.status(201).json(doc);
+  });
+
+  app.get('/documents', (_req: Request, res: Response) => {
+    res.json(store.listDocuments());
+  });
+
+  app.get('/documents/:id', (req: Request, res: Response) => {
+    const doc = store.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    res.json(doc);
+  });
+
+  app.get('/documents/:id/versions', (req: Request, res: Response) => {
+    const doc = store.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    res.json(store.listVersions(req.params.id));
+  });
+
+  app.put('/documents/:id', (req: Request, res: Response) => {
+    const doc = store.getDocument(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'document not found' });
+    const { title, content } = req.body ?? {};
+    if (title !== undefined && (typeof title !== 'string' || title.length === 0)) {
+      return res.status(400).json({ error: 'title must be a non-empty string' });
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      return res.status(400).json({ error: 'content must be a string' });
+    }
+    const newTitle = title ?? doc.title;
+    const newContent = content ?? doc.content;
+
+    if (content !== undefined && content !== doc.content) {
+      // A whole-content replacement commits a new version. If a live room is
+      // editing this doc, resync it so clients don't diverge.
+      const room = rooms.get(req.params.id);
+      const nextVersion = (room ? room.version : store.latestVersion(req.params.id)) + 1;
+      store.commitVersion(req.params.id, nextVersion, newContent, JSON.stringify({ type: 'replace' }));
+      if (room) {
+        room.content = newContent;
+        room.version = nextVersion;
+        room.baseVersion = nextVersion;
+        room.history = [];
+        room.broadcast({ type: 'sync', documentId: req.params.id, content: newContent, version: nextVersion });
+      }
+    }
+    if (newTitle !== doc.title) {
+      store.setTitle(req.params.id, newTitle);
+    }
+    res.json(store.getDocument(req.params.id));
+  });
+
+  app.delete('/documents/:id', (req: Request, res: Response) => {
+    const room = rooms.get(req.params.id);
+    if (room) {
+      for (const ws of room.clients) ws.close(4004, 'document deleted');
+      rooms.delete(req.params.id);
+    }
+    const deleted = store.deleteDocument(req.params.id);
+    if (!deleted) return res.status(404).json({ error: 'document not found' });
+    res.status(204).end();
+  });
+
+  // ---- WebSocket collaboration -------------------------------------------
+
+  const httpServer: Server = createServer(app);
+  const wss = new WebSocketServer({ noServer: true });
+  const rooms = new Map<string, DocRoom>();
+  let clientCounter = 0;
+
+  function getRoom(docId: string): DocRoom {
+    let room = rooms.get(docId);
+    if (!room) {
+      const doc = store.getDocument(docId)!;
+      room = new DocRoom(doc.content, store.latestVersion(docId));
+      rooms.set(docId, room);
+    }
+    return room;
+  }
+
+  httpServer.on('upgrade', (req, socket, head) => {
+    // Expected path: /documents/:id/ws
+    const url = new URL(req.url ?? '', 'http://localhost');
+    const match = url.pathname.match(/^\/documents\/([^/]+)\/ws$/);
+    if (!match) {
+      socket.destroy();
+      return;
+    }
+    const docId = decodeURIComponent(match[1]);
+    if (!store.getDocument(docId)) {
+      socket.destroy();
+      return;
+    }
+    wss.handleUpgrade(req, socket, head, (ws) => {
+      wss.emit('connection', ws, req, docId);
+    });
+  });
+
+  wss.on('connection', (ws: WebSocket, _req: unknown, docId: string) => {
+    const room = getRoom(docId);
+    const clientId = `c${++clientCounter}`;
+    room.clients.add(ws);
+
+    // Initial sync: hand the client the authoritative content + version.
+    ws.send(
+      JSON.stringify({ type: 'sync', documentId: docId, content: room.content, version: room.version, clientId }),
+    );
+
+    ws.on('message', (raw) => {
+      let parsed: unknown;
+      try {
+        parsed = JSON.parse(raw.toString());
+      } catch {
+        ws.send(JSON.stringify({ type: 'error', message: 'invalid JSON' }));
+        return;
+      }
+      handleMessage(ws, room, docId, clientId, parsed);
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      if (room.clients.size === 0) rooms.delete(docId);
+    });
+
+    ws.on('error', () => {
+      room.clients.delete(ws);
+    });
+  });
+
+  function handleMessage(
+    ws: WebSocket,
+    room: DocRoom,
+    docId: string,
+    clientId: string,
+    parsed: unknown,
+  ): void {
+    if (typeof parsed !== 'object' || parsed === null) {
+      ws.send(JSON.stringify({ type: 'error', message: 'message must be an object' }));
+      return;
+    }
+    const msg = parsed as Record<string, unknown>;
+    if (msg.type !== 'op') {
+      ws.send(JSON.stringify({ type: 'error', message: `unknown message type: ${String(msg.type)}` }));
+      return;
+    }
+
+    const baseVersion = typeof msg.baseVersion === 'number' ? msg.baseVersion : room.version;
+
+    // Transform against everything applied since the client's base version,
+    // then validate+apply each resulting op to the authoritative content.
+    let transformed: Op[];
+    try {
+      const rawOp = validateOp(msg.op, Number.MAX_SAFE_INTEGER); // structural check first
+      transformed = transformAgainst(rawOp, room.opsSince(baseVersion));
+    } catch (err) {
+      ws.send(JSON.stringify({ type: 'error', message: (err as Error).message }));
+      return;
+    }
+
+    let content = room.content;
+    try {
+      for (const op of transformed) {
+        validateOp(op, content.length); // bounds check against live content
+        content = apply(content, op);
+      }
+    } catch (err) {
+      ws.send(JSON.stringify({ type: 'error', message: (err as Error).message }));
+      return;
+    }
+
+    room.content = content;
+    room.version += 1;
+    room.history.push(transformed);
+
+    try {
+      store.commitVersion(docId, room.version, content, JSON.stringify(transformed));
+    } catch (err) {
+      ws.send(JSON.stringify({ type: 'error', message: `persistence failed: ${(err as Error).message}` }));
+      return;
+    }
+
+    // Everyone (including the author) applies the same server-ordered ops.
+    room.broadcast({ type: 'op', documentId: docId, version: room.version, ops: transformed, author: clientId });
+  }
+
+  // ---- Lifecycle ----------------------------------------------------------
+
+  function start(port = 0): Promise<number> {
+    return new Promise((resolve, reject) => {
+      httpServer.once('error', reject);
+      httpServer.listen(port, () => {
+        const addr = httpServer.address();
+        const actualPort = typeof addr === 'object' && addr ? addr.port : port;
+        resolve(actualPort);
+      });
+    });
+  }
+
+  function stop(): Promise<void> {
+    return new Promise((resolve) => {
+      for (const room of rooms.values()) {
+        for (const ws of room.clients) ws.terminate();
+      }
+      rooms.clear();
+      wss.close(() => {
+        httpServer.close(() => {
+          store.close();
+          resolve();
+        });
+      });
+    });
+  }
+
+  return { app, start, stop };
+}
