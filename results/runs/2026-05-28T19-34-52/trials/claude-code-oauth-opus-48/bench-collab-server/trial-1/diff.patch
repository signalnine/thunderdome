new file mode 100644
index 0000000..0791323
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,124 @@
+import Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS documents (
+  id TEXT PRIMARY KEY,
+  title TEXT NOT NULL,
+  content TEXT NOT NULL DEFAULT '',
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  updated_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+
+CREATE TABLE IF NOT EXISTS versions (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  version INTEGER NOT NULL,
+  content TEXT NOT NULL,
+  operation TEXT,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  UNIQUE(document_id, version)
+);
+`;
+
+export interface DocumentRow {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface VersionRow {
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+export class Store {
+  private db: Database.Database;
+
+  constructor(path = ':memory:') {
+    this.db = new Database(path);
+    this.db.pragma('journal_mode = WAL');
+    this.db.pragma('foreign_keys = ON');
+    this.db.exec(SCHEMA);
+  }
+
+  createDocument(title: string, content = ''): DocumentRow {
+    const id = randomUUID();
+    this.db
+      .prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?)')
+      .run(id, title, content);
+    // Record the initial state as version 0.
+    this.db
+      .prepare(
+        'INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)',
+      )
+      .run(id, content);
+    return this.getDocument(id)!;
+  }
+
+  getDocument(id: string): DocumentRow | undefined {
+    return this.db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as
+      | DocumentRow
+      | undefined;
+  }
+
+  listDocuments(): DocumentRow[] {
+    return this.db
+      .prepare('SELECT * FROM documents ORDER BY created_at DESC')
+      .all() as DocumentRow[];
+  }
+
+  setTitle(id: string, title: string): void {
+    this.db
+      .prepare("UPDATE documents SET title = ?, updated_at = datetime('now') WHERE id = ?")
+      .run(title, id);
+  }
+
+  deleteDocument(id: string): boolean {
+    const info = this.db.prepare('DELETE FROM documents WHERE id = ?').run(id);
+    return info.changes > 0;
+  }
+
+  /** Latest persisted version number for a document (0 if only the initial state). */
+  latestVersion(id: string): number {
+    const row = this.db
+      .prepare('SELECT MAX(version) AS v FROM versions WHERE document_id = ?')
+      .get(id) as { v: number | null };
+    return row.v ?? 0;
+  }
+
+  listVersions(id: string): VersionRow[] {
+    return this.db
+      .prepare(
+        'SELECT version, content, operation, created_at FROM versions WHERE document_id = ? ORDER BY version ASC',
+      )
+      .all(id) as VersionRow[];
+  }
+
+  /**
+   * Persist a new committed version: updates the document's current content and
+   * appends a versions row. Done in a transaction so restarts never see a torn
+   * write.
+   */
+  commitVersion(id: string, version: number, content: string, operation: string): void {
+    const tx = this.db.transaction(() => {
+      this.db
+        .prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?")
+        .run(content, id);
+      this.db
+        .prepare(
+          'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)',
+        )
+        .run(id, version, content, operation);
+    });
+    tx();
+  }
+
+  close(): void {
+    this.db.close();
+  }
+}
diff --git a/src/ot.test.ts b/src/ot.test.ts
new file mode 100644
index 0000000..9e7e36f
--- /dev/null
+++ b/src/ot.test.ts
@@ -0,0 +1,73 @@
+import { describe, it, expect } from 'vitest';
+import { apply, transformAgainst, validateOp, type Op } from './ot.js';
+
+describe('apply', () => {
+  it('inserts text', () => {
+    expect(apply('hello', { type: 'insert', pos: 5, text: ' world' })).toBe('hello world');
+  });
+  it('deletes text', () => {
+    expect(apply('hello world', { type: 'delete', pos: 5, len: 6 })).toBe('hello');
+  });
+});
+
+describe('validateOp', () => {
+  it('rejects out-of-range insert', () => {
+    expect(() => validateOp({ type: 'insert', pos: 99, text: 'x' }, 3)).toThrow();
+  });
+  it('rejects out-of-range delete', () => {
+    expect(() => validateOp({ type: 'delete', pos: 0, len: 99 }, 3)).toThrow();
+  });
+  it('rejects unknown type and malformed input', () => {
+    expect(() => validateOp({ type: 'nope' }, 3)).toThrow();
+    expect(() => validateOp(null, 3)).toThrow();
+    expect(() => validateOp({ type: 'insert', pos: 1.5, text: 'x' }, 3)).toThrow();
+  });
+});
+
+describe('transform convergence', () => {
+  // Apply op `a` (based on a shared base) after op `b` was already committed,
+  // and verify it matches applying `b` then the transformed `a`.
+  function converge(base: string, a: Op, b: Op): string {
+    // Server order: b first, then a transformed against b.
+    let s = apply(base, b);
+    for (const t of transformAgainst(a, [b])) s = apply(s, t);
+    return s;
+  }
+
+  it('preserves both concurrent insertions at the same position', () => {
+    const base = 'abc';
+    const a: Op = { type: 'insert', pos: 1, text: 'X' };
+    const b: Op = { type: 'insert', pos: 1, text: 'Y' };
+    const result = converge(base, a, b);
+    expect(result).toContain('X');
+    expect(result).toContain('Y');
+    expect(result.length).toBe(5);
+  });
+
+  it('insert inside a concurrent delete survives (delete splits)', () => {
+    const base = 'abcdef';
+    const del: Op = { type: 'delete', pos: 1, len: 4 }; // remove bcde
+    const ins: Op = { type: 'insert', pos: 3, text: 'XY' }; // based on base, inside del range
+    // Server applies delete first, then transformed insert.
+    let s = apply(base, del); // "af"
+    for (const t of transformAgainst(ins, [del])) s = apply(s, t);
+    expect(s).toContain('XY');
+    // Now the reverse order on a fresh client view should converge too.
+    let s2 = apply(base, ins); // "abcXYdef"
+    for (const t of transformAgainst(del, [ins])) s2 = apply(s2, t);
+    expect(s2).toContain('XY');
+    expect(s2).toBe(s);
+  });
+
+  it('concurrent deletes do not over-delete', () => {
+    const base = 'abcdef';
+    const d1: Op = { type: 'delete', pos: 1, len: 3 }; // bcd
+    const d2: Op = { type: 'delete', pos: 2, len: 3 }; // cde
+    let s = apply(base, d1); // "aef"
+    for (const t of transformAgainst(d2, [d1])) s = apply(s, t);
+    let s2 = apply(base, d2); // "abf"
+    for (const t of transformAgainst(d1, [d2])) s2 = apply(s2, t);
+    expect(s).toBe(s2);
+    expect(s).toBe('af');
+  });
+});
diff --git a/src/ot.ts b/src/ot.ts
new file mode 100644
index 0000000..dbbca94
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,151 @@
+// Operational Transform for plain-text collaborative editing.
+//
+// Two operation types are supported:
+//   - insert: place `text` at character position `pos`
+//   - delete: remove `len` characters starting at `pos`
+//
+// The server is the single source of truth. A client sends an op tagged with
+// the document version it was based on; the server transforms that op against
+// every op applied since that version, applies the result to the authoritative
+// content, and broadcasts the transformed op. Because every client applies the
+// exact same server-ordered sequence of ops to the same synced base content,
+// all clients converge to identical state and no insertion is ever dropped.
+
+export interface InsertOp {
+  type: 'insert';
+  pos: number;
+  text: string;
+}
+
+export interface DeleteOp {
+  type: 'delete';
+  pos: number;
+  len: number;
+}
+
+export type Op = InsertOp | DeleteOp;
+
+/** Validate that an unknown value is a structurally well-formed operation. */
+export function validateOp(value: unknown, contentLength: number): Op {
+  if (typeof value !== 'object' || value === null) {
+    throw new Error('operation must be an object');
+  }
+  const op = value as Record<string, unknown>;
+  if (op.type === 'insert') {
+    if (typeof op.pos !== 'number' || !Number.isInteger(op.pos)) {
+      throw new Error('insert.pos must be an integer');
+    }
+    if (typeof op.text !== 'string') {
+      throw new Error('insert.text must be a string');
+    }
+    if (op.pos < 0 || op.pos > contentLength) {
+      throw new Error(`insert.pos ${op.pos} out of range [0, ${contentLength}]`);
+    }
+    if (op.text.length === 0) {
+      throw new Error('insert.text must be non-empty');
+    }
+    return { type: 'insert', pos: op.pos, text: op.text };
+  }
+  if (op.type === 'delete') {
+    if (typeof op.pos !== 'number' || !Number.isInteger(op.pos)) {
+      throw new Error('delete.pos must be an integer');
+    }
+    if (typeof op.len !== 'number' || !Number.isInteger(op.len)) {
+      throw new Error('delete.len must be an integer');
+    }
+    if (op.len <= 0) {
+      throw new Error('delete.len must be positive');
+    }
+    if (op.pos < 0 || op.pos + op.len > contentLength) {
+      throw new Error(
+        `delete range [${op.pos}, ${op.pos + op.len}) out of bounds [0, ${contentLength}]`,
+      );
+    }
+    return { type: 'delete', pos: op.pos, len: op.len };
+  }
+  throw new Error(`unknown operation type: ${String(op.type)}`);
+}
+
+/** Apply an operation to content, returning the new content. */
+export function apply(content: string, op: Op): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.pos) + op.text + content.slice(op.pos);
+  }
+  return content.slice(0, op.pos) + content.slice(op.pos + op.len);
+}
+
+// transform1(a, b): transform op `a` so that it can be applied *after* op `b`,
+// given that both were originally produced against the same base state and `b`
+// has already been applied. Returns 0, 1, or 2 ops (a delete spanning an insert
+// must split in order to preserve the inserted text).
+function transform1(a: Op, b: Op): Op[] {
+  if (a.type === 'insert' && b.type === 'insert') {
+    // Tie on equal position: `b` is already applied, so `a` goes after it.
+    if (a.pos < b.pos) return [a];
+    return [{ type: 'insert', pos: a.pos + b.text.length, text: a.text }];
+  }
+
+  if (a.type === 'insert' && b.type === 'delete') {
+    if (a.pos <= b.pos) return [a];
+    if (a.pos >= b.pos + b.len) {
+      return [{ type: 'insert', pos: a.pos - b.len, text: a.text }];
+    }
+    // Insertion point fell inside the deleted range -> collapse to its start.
+    return [{ type: 'insert', pos: b.pos, text: a.text }];
+  }
+
+  if (a.type === 'delete' && b.type === 'insert') {
+    const bLen = b.text.length;
+    if (b.pos <= a.pos) {
+      return [{ type: 'delete', pos: a.pos + bLen, len: a.len }];
+    }
+    if (b.pos >= a.pos + a.len) return [a];
+    // Insert landed strictly inside the deletion -> split around it so the
+    // newly inserted text survives. The two resulting deletes are applied in
+    // sequence, so the higher-position segment must come first; otherwise the
+    // first delete would shift the coordinates of the second.
+    const leftLen = b.pos - a.pos;
+    const rightLen = a.len - leftLen;
+    const ops: Op[] = [];
+    if (rightLen > 0) ops.push({ type: 'delete', pos: b.pos + bLen, len: rightLen });
+    if (leftLen > 0) ops.push({ type: 'delete', pos: a.pos, len: leftLen });
+    return ops;
+  }
+
+  // delete vs delete
+  const aDel = a as DeleteOp;
+  const bDel = b as DeleteOp;
+  const aStart = aDel.pos;
+  const aEnd = aDel.pos + aDel.len;
+  const bStart = bDel.pos;
+  const bEnd = bDel.pos + bDel.len;
+
+  if (bEnd <= aStart) {
+    return [{ type: 'delete', pos: aStart - bDel.len, len: aDel.len }];
+  }
+  if (aEnd <= bStart) return [a];
+
+  // Overlap: remove the already-deleted overlap from `a`.
+  const overlap = Math.min(aEnd, bEnd) - Math.max(aStart, bStart);
+  const newLen = aDel.len - overlap;
+  if (newLen <= 0) return [];
+  const charsDeletedBeforeA = Math.max(0, Math.min(bEnd, aStart) - bStart);
+  const newPos = aStart - charsDeletedBeforeA;
+  return [{ type: 'delete', pos: newPos, len: newLen }];
+}
+
+/**
+ * Transform a client op against the ordered list of ops applied since the
+ * client's base version. A single op may fan out into several ops.
+ */
+export function transformAgainst(op: Op, against: Op[]): Op[] {
+  let current: Op[] = [op];
+  for (const b of against) {
+    const next: Op[] = [];
+    for (const c of current) {
+      next.push(...transform1(c, b));
+    }
+    current = next;
+  }
+  return current;
+}
