lve) => {\n      for (const room of rooms.values()) {\n        for (const ws of room.clients) ws.terminate();\n      }\n      rooms.clear();\n      wss.close(() => {\n        httpServer.close(() => {\n          store.close();\n          resolve();\n        });\n      });\n    });\n  }\n\n  return { app, start, stop };\n}\n","structuredPatch":[{"oldStart":160,"oldLines":7,"newStart":160,"newLines":7,"lines":["     });","   });"," ","-  wss.on('connection', (ws: WebSocket, _req, docId: string) => {","+  wss.on('connection', (ws: WebSocket, _req: unknown, docId: string) => {","     const room = getRoom(docId);","     const clientId = `c${++clientCounter}`;","     room.clients.add(ws);"]}],"userModified":false,"replaceAll":false}}
