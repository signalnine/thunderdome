r at position 0 concurrently. With OT,\n    // all insertions must be preserved (none silently dropped). Every client\n    // should observe all N op broadcasts.\n    let received = 0;\n    const done = new Promise<void>((resolve) => {\n      for (const c of clients) {\n        c.ws.on('message', (data) => {\n          const m = JSON.parse(data.toString());\n          if (m.type === 'op') {\n            received++;\n            if (received >= N * N) resolve();\n          }\n        });\n      }\n    });\n\n    for (let i = 0; i < N; i++) {\n      clients[i].ws.send(\n        JSON.stringify({ type: 'op', baseVersion: versions[i], op: { type: 'insert', pos: 0, text: String.fromCharCode(65 + i) } }),\n      );\n    }\n\n    await done;\n    for (const c of clients) c.ws.close();","originalFile":"import { describe, it, expect, afterEach } from 'vitest';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { randomUUID } from 'node:crypto';\nimport { rmSync } from 'node:fs';\nimport WebSocket from 'ws';\nimport { createApp, type CollabServer } from './server.js';\n\nlet server: CollabServer | undefined;\nconst dbFiles: string[] = [];\n\nafterEach(async () => {\n  if (server) await server.stop();\n  server = undefined;\n});\n\nfunction tmpDb(): string {\n  const f = join(tmpdir(), `collab-${randomUUID()}.db`);\n  dbFiles.push(f);\n  return f;\n}\n\nasync function http(port: number, method: string, path: string, body?: unknown) {\n  const res = await fetch(`http://127.0.0.1:${port}${path}`, {\n    method,\n    headers: { 'content-type': 'application/json' },\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  const text = await res.text();\n  return { status: res.status, body: text ? JSON.parse(text) : undefined };\n}\n\n// A buffering test client: messages are queued as they arrive so callers never\n// miss one to a listener-attach race (the server sends `sync` immediately).\ninterface TestClient {\n  ws: WebSocket;\n  next(): Promise<Record<string, unknown>>;\n}\n\nfunction connect(port: number, docId: string): Promise<TestClient> {\n  return new Promise((resolve, reject) => {\n    const ws = new WebSocket(`ws://127.0.0.1:${port}/documents/${docId}/ws`);\n    const queue: Record<string, unknown>[] = [];\n    let waiter: ((m: Record<string, unknown>) => void) | undefined;\n    ws.on('message', (data) => {\n      const m = JSON.parse(data.toString());\n      if (waiter) {\n        waiter(m);\n        waiter = undefined;\n      } else {\n        queue.push(m);\n      }\n    });\n    ws.once('error', reject);\n    ws.once('open', () =>\n      resolve({\n        ws,\n        next: () =>\n          new Promise((res) => {\n            const queued = queue.shift();\n            if (queued) res(queued);\n            else waiter = res;\n          }),\n      }),\n    );\n  });\n}\n\ndescribe('REST API', () => {\n  it('supports full CRUD + version history', async () => {\n    server = createApp(tmpDb());\n    const port = await server.start(0);\n\n    // Create\n    const created = await http(port, 'POST', '/documents', { title: 'Doc', content: 'hello' });\n    expect(created.status).toBe(201);\n    const id = created.body.id;\n    expect(created.body.title).toBe('Doc');\n\n    // Read\n    const got = await http(port, 'GET', `/documents/${id}`);\n    expect(got.body.content).toBe('hello');\n\n    // List\n    const list = await http(port, 'GET', '/documents');\n    expect(list.body.length).toBe(1);\n\n    // Update (content change => new version)\n    const updated = await http(port, 'PUT', `/documents/${id}`, { content: 'hello world' });\n    expect(updated.body.content).toBe('hello world');\n\n    const versions = await http(port, 'GET', `/documents/${id}/versions`);\n    expect(versions.body.length).toBeGreaterThanOrEqual(2);\n\n    // Delete\n    const del = await http(port, 'DELETE', `/documents/${id}`);\n    expect(del.status).toBe(204);\n    expect((await http(port, 'GET', `/documents/${id}`)).status).toBe(404);\n  });\n\n  it('rejects invalid create', async () => {\n    server = createApp(tmpDb());\n    const port = await server.start(0);\n    expect((await http(port, 'POST', '/documents', {})).status).toBe(400);\n    expect((await http(port, 'POST', '/documents', { title: 5 })).status).toBe(400);\n  });\n});\n\ndescribe('WebSocket collaboration', () => {\n  it('syncs on connect and broadcasts edits', async () => {\n    server = createApp(tmpDb());\n    const port = await server.start(0);\n    const { body: doc } = await http(port, 'POST', '/documents', { title: 'T', content: 'abc' });\n\n    const a = await connect(port, doc.id);\n    const syncA = await a.next();\n    expect(syncA.type).toBe('sync');\n    expect(syncA.content).toBe('abc');\n\n    const b = await connect(port, doc.id);\n    await b.next(); // sync\n\n    // A inserts at end; both A and B should receive the op broadcast.\n    const recvA = a.next();\n    const recvB = b.next();\n    a.ws.send(JSON.stringify({ type: 'op', baseVersion: syncA.version, op: { type: 'insert', pos: 3, text: 'd' } }));\n    const [ma, mb] = await Promise.all([recvA, recvB]);\n    expect(ma.type).toBe('op');\n    expect(mb.type).toBe('op');\n\n    a.ws.close();\n    b.ws.close();\n\n    // Authoritative content persisted.\n    const after = await http(port, 'GET', `/documents/${doc.id}`);\n    expect(after.body.content).toBe('abcd');\n  });\n\n  it('rejects malformed operations without crashing', async () => {\n    server = createApp(tmpDb());\n    const port = await server.start(0);\n    const { body: doc } = await http(port, 'POST', '/documents', { title: 'T', content: 'abc' });\n    const a = await connect(port, doc.id);\n    await a.next(); // sync\n\n    const err1 = a.next();\n    a.ws.send('not json');\n    expect((await err1).type).toBe('error');\n\n    const err2 = a.next();\n    a.ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 999, text: 'x' } }));\n    expect((await err2).type).toBe('error');\n\n    const err3 = a.next();\n    a.ws.send(JSON.stringify({ type: 'bogus' }));\n    expect((await err3).type).toBe('error');\n\n    // Server is still alive and accepts a valid op afterwards.\n    const ok = a.next();\n    a.ws.send(JSON.stringify({ type: 'op', baseVersion: 0, op: { type: 'insert', pos: 3, text: 'd' } }));\n    expect((await ok).type).toBe('op');\n\n    a.ws.close();\n  });\n\n  it('10 concurrent clients converge without corruption', async () => {\n    server = createApp(tmpDb());\n    const port = await server.start(0);\n    const { body: doc } = await http(port, 'POST', '/documents', { title: 'T', content: '' });\n\n    const N = 10;\n    const clients: WebSocket[] = [];\n    const versions: number[] = [];\n    for (let i = 0; i < N; i++) {\n      const ws = await connect(port, doc.id);\n      const sync = await nextMessage(ws);\n      versions[i] = sync.version as number;\n      clients.push(ws);\n    }\n\n    // Each client appends its own marker at position 0 concurrently. With OT,\n    // all insertions must be preserved (none silently dropped).\n    let received = 0;\n    const expected = N; // one op per client\n    const done = new Promise<void>((resolve) => {\n      for (const ws of clients) {\n        ws.on('message', (data) => {\n          const m = JSON.parse(data.toString());\n          if (m.type === 'op') {\n            received++;\n            if (received >= expected * N) resolve(); // each op seen by each client\n          }\n        });\n      }\n    });\n\n    for (let i = 0; i < N; i++) {\n      clients[i].send(\n        JSON.stringify({ type: 'op', baseVersion: versions[i], op: { type: 'insert', pos: 0, text: String.fromCharCode(65 + i) } }),\n      );\n    }\n\n    await done;\n    for (const ws of clients) ws.close();\n\n    const after = await http(port, 'GET', `/documents/${doc.id}`);\n    // All 10 distinct characters preserved.\n    expect((after.body.content as string).length).toBe(N);\n    for (let i = 0; i < N; i++) {\n      expect(after.body.content).toContain(String.fromCharCode(65 + i));\n    }\n  });\n});\n\ndescribe('persistence across restart', () => {\n  it('reloads documents and versions from disk', async () => {\n    const db = tmpDb();\n    server = createApp(db);\n    let port = await server.start(0);\n    const { body: doc } = await http(port, 'POST', '/documents', { title: 'Persisted', content: 'v0' });\n\n    // Make an edit over WebSocket so a version is committed.\n    const ws = await connect(port, doc.id);\n    const sync = await nextMessage(ws);\n    const recv = nextMessage(ws);\n    ws.send(JSON.stringify({ type: 'op', baseVersion: sync.version, op: { type: 'insert', pos: 2, text: '!' } }));\n    await recv;\n    ws.close();\n    await server.stop();\n\n    // Restart against the same file.\n    server = createApp(db);\n    port = await server.start(0);\n    const got = await http(port, 'GET', `/documents/${doc.id}`);\n    expect(got.body.content).toBe('v0!');\n    const versions = await http(port, 'GET', `/documents/${doc.id}/versions`);\n    expect(versions.body.length).toBeGreaterThanOrEqual(2);\n  });\n});\n\n// Best-effort cleanup of temp db files.\nprocess.on('exit', () => {\n  for (const f of dbFiles) {\n    try {\n      rmSync(f, { force: true });\n      rmSync(`${f}-wal`, { force: true });\n      rmSync(`${f}-shm`, { force: true });\n    } catch {\n      /* ignore */\n    }\n  }\n});\n","structuredPatch":[{"oldStart":169,"oldLines":39,"newStart":169,"newLines":39,"lines":["     const { body: doc } = await http(port, 'POST', '/documents', { title: 'T', content: '' });"," ","     const N = 10;","-    const clients: WebSocket[] = [];","+    const clients: TestClient[] = [];","     const versions: number[] = [];","     for (let i = 0; i < N; i++) {","-      const ws = await connect(port, doc.id);","-      const sync = await nextMessage(ws);","+      const c = await connect(port, doc.id);","+      const sync = await c.next();","       v