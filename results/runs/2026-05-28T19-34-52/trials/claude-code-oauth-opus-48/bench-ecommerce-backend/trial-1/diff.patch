new file mode 100644
index 0000000..94f3dda
--- /dev/null
+++ b/src/analytics/index.ts
@@ -0,0 +1,69 @@
+import { EventBus } from '../bus.js';
+import {
+  AnalyticsService,
+  PaymentStatus,
+  Events,
+  CartUpdatedEvent,
+  OrderCreatedEvent,
+  PaymentProcessedEvent,
+} from '../types.js';
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const orderTotals = new Map<string, number>();
+  const cartItems = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const uniqueCarts = new Set<string>();
+  const productCounts = new Map<string, number>();
+  let orderCount = 0;
+  let revenue = 0;
+
+  // Count every known event type.
+  for (const eventName of Object.values(Events)) {
+    bus.on(eventName, () => {
+      eventCounts.set(eventName, (eventCounts.get(eventName) ?? 0) + 1);
+    });
+  }
+
+  bus.on(Events.CART_UPDATED, (payload) => {
+    const { cartId, items } = payload as CartUpdatedEvent;
+    uniqueCarts.add(cartId);
+    cartItems.set(cartId, items);
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const { orderId, cartId, total } = payload as OrderCreatedEvent;
+    orderCount += 1;
+    orderTotals.set(orderId, total);
+    for (const item of cartItems.get(cartId) ?? []) {
+      productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+    }
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const { orderId, status } = payload as PaymentProcessedEvent;
+    if (status === PaymentStatus.SUCCESS) {
+      revenue += orderTotals.get(orderId) ?? 0;
+    }
+  });
+
+  return {
+    getEventCount(eventType) {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue() {
+      return revenue;
+    },
+
+    getConversionRate() {
+      if (uniqueCarts.size === 0) return 0;
+      return orderCount / uniqueCarts.size;
+    },
+
+    getTopProducts(limit) {
+      return Array.from(productCounts, ([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count)
+        .slice(0, limit);
+    },
+  };
+}
diff --git a/src/cart/index.ts b/src/cart/index.ts
new file mode 100644
index 0000000..d054fe7
--- /dev/null
+++ b/src/cart/index.ts
@@ -0,0 +1,73 @@
+import { randomUUID } from 'node:crypto';
+import { EventBus } from '../bus.js';
+import { CartService, Events, CartUpdatedEvent } from '../types.js';
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: Map<string, number>;
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  function emitUpdate(cart: Cart): void {
+    const payload: CartUpdatedEvent = {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: Array.from(cart.items, ([productId, quantity]) => ({ productId, quantity })),
+    };
+    void bus.emit(Events.CART_UPDATED, payload);
+  }
+
+  return {
+    createCart(userId) {
+      const id = randomUUID();
+      const cart: Cart = { id, userId, items: new Map() };
+      carts.set(id, cart);
+      emitUpdate(cart);
+      return id;
+    },
+
+    addItem(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart || quantity <= 0) return;
+      cart.items.set(productId, (cart.items.get(productId) ?? 0) + quantity);
+      emitUpdate(cart);
+    },
+
+    removeItem(cartId, productId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      if (cart.items.delete(productId)) emitUpdate(cart);
+    },
+
+    updateQuantity(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      if (quantity <= 0) {
+        cart.items.delete(productId);
+      } else {
+        cart.items.set(productId, quantity);
+      }
+      emitUpdate(cart);
+    },
+
+    clearCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items.clear();
+      emitUpdate(cart);
+    },
+
+    getCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      return {
+        id: cart.id,
+        userId: cart.userId,
+        items: Array.from(cart.items, ([productId, quantity]) => ({ productId, quantity })),
+      };
+    },
+  };
+}
