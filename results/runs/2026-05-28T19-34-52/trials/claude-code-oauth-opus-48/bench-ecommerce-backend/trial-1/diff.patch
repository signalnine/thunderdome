+++ b/src/payment/index.ts
@@ -0,0 +1,63 @@
+import { randomUUID } from 'node:crypto';
+import { EventBus } from '../bus.js';
+import { PaymentService, PaymentStatus, Events, PaymentProcessedEvent } from '../types.js';
+
+export interface PaymentOptions {
+  /** Forces the outcome of every processed payment. Defaults to 'success'. */
+  mode?: 'success' | 'failure' | 'timeout';
+  /** Artificial delay (ms) before a payment resolves. */
+  delayMs?: number;
+  /** Delay (ms) used to simulate a timeout outcome. */
+  timeoutMs?: number;
+}
+
+interface Transaction {
+  transactionId: string;
+  orderId: string;
+  amount: number;
+  refunded: boolean;
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentOptions = {}): PaymentService {
+  const { mode = 'success', delayMs = 0, timeoutMs = 0 } = options;
+  const transactions = new Map<string, Transaction>();
+
+  return {
+    async processPayment(orderId, amount) {
+      let result: { status: PaymentStatus; transactionId?: string; error?: string };
+
+      if (mode === 'failure') {
+        if (delayMs > 0) await delay(delayMs);
+        result = { status: PaymentStatus.FAILED, error: 'Payment declined' };
+      } else if (mode === 'timeout') {
+        await delay(timeoutMs > 0 ? timeoutMs : delayMs);
+        result = { status: PaymentStatus.TIMEOUT, error: 'Payment timed out' };
+      } else {
+        if (delayMs > 0) await delay(delayMs);
+        const transactionId = randomUUID();
+        transactions.set(transactionId, { transactionId, orderId, amount, refunded: false });
+        result = { status: PaymentStatus.SUCCESS, transactionId };
+      }
+
+      const payload: PaymentProcessedEvent = {
+        orderId,
+        status: result.status,
+        transactionId: result.transactionId,
+        error: result.error,
+      };
+      await bus.emit(Events.PAYMENT_PROCESSED, payload);
+      return result;
+    },
+
+    async refund(transactionId) {
+      const transaction = transactions.get(transactionId);
+      if (!transaction || transaction.refunded) return false;
+      transaction.refunded = true;
+      return true;
+    },
+  };
+}
