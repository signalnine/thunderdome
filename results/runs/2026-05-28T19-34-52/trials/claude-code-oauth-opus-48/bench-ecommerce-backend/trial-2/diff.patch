@@ -0,0 +1,61 @@
+import { randomUUID } from 'node:crypto';
+import {
+  EventBus,
+} from '../bus.js';
+import {
+  OrderService,
+  OrderStatus,
+  Events,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+} from '../types.js';
+
+interface Order {
+  id: string;
+  userId: string;
+  cartId: string;
+  status: OrderStatus;
+  total: number;
+}
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, Order>();
+
+  return {
+    createOrder(userId: string, cartId: string, total: number): string {
+      const id = randomUUID();
+      orders.set(id, { id, userId, cartId, status: OrderStatus.PENDING, total });
+
+      const payload: OrderCreatedEvent = { orderId: id, userId, cartId, total };
+      void bus.emit(Events.ORDER_CREATED, payload);
+
+      return id;
+    },
+
+    getOrder(orderId: string): { id: string; userId: string; status: OrderStatus; total: number } | null {
+      const order = orders.get(orderId);
+      if (!order) {
+        return null;
+      }
+      return { id: order.id, userId: order.userId, status: order.status, total: order.total };
+    },
+
+    updateStatus(orderId: string, status: OrderStatus): void {
+      const order = orders.get(orderId);
+      if (!order || order.status === status) {
+        return;
+      }
+      const previousStatus = order.status;
+      order.status = status;
+
+      const payload: OrderStatusChangedEvent = { orderId, status, previousStatus };
+      void bus.emit(Events.ORDER_STATUS_CHANGED, payload);
+    },
+
+    listOrders(userId: string): Array<{ id: string; status: OrderStatus; total: number }> {
+      return [...orders.values()]
+        .filter((order) => order.userId === userId)
+        .map((order) => ({ id: order.id, status: order.status, total: order.total }));
+    },
+  };
+}
