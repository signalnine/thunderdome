@@ -0,0 +1,68 @@
+import { randomUUID } from 'node:crypto';
+import { EventBus } from '../bus.js';
+import { CatalogService, Events, ProductCreatedEvent } from '../types.js';
+
+interface Product {
+  id: string;
+  name: string;
+  price: number;
+  category: string;
+}
+
+export function createCatalogService(bus: EventBus): CatalogService {
+  const products = new Map<string, Product>();
+
+  return {
+    createProduct(name: string, price: number, category: string): string {
+      const id = randomUUID();
+      const product: Product = { id, name, price, category };
+      products.set(id, product);
+
+      const payload: ProductCreatedEvent = { productId: id, name, price, category };
+      void bus.emit(Events.PRODUCT_CREATED, payload);
+
+      return id;
+    },
+
+    getProduct(productId: string): Product | null {
+      const product = products.get(productId);
+      return product ? { ...product } : null;
+    },
+
+    listProducts(category?: string): Product[] {
+      const all = [...products.values()];
+      const filtered = category === undefined ? all : all.filter((p) => p.category === category);
+      return filtered.map((p) => ({ ...p }));
+    },
+
+    searchProducts(query: string): Product[] {
+      const needle = query.toLowerCase();
+      return [...products.values()]
+        .filter(
+          (p) =>
+            p.name.toLowerCase().includes(needle) || p.category.toLowerCase().includes(needle),
+        )
+        .map((p) => ({ ...p }));
+    },
+
+    updateProduct(productId: string, updates: Partial<{ name: string; price: number; category: string }>): void {
+      const product = products.get(productId);
+      if (!product) {
+        return;
+      }
+      if (updates.name !== undefined) {
+        product.name = updates.name;
+      }
+      if (updates.price !== undefined) {
+        product.price = updates.price;
+      }
+      if (updates.category !== undefined) {
+        product.category = updates.category;
+      }
+    },
+
+    removeProduct(productId: string): boolean {
+      return products.delete(productId);
+    },
+  };
+}
