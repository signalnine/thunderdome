diff --git a/tests/smoke.test.ts b/tests/smoke.test.ts
new file mode 100644
index 0000000..b1752be
--- /dev/null
+++ b/tests/smoke.test.ts
@@ -0,0 +1,98 @@
+import { describe, it, expect } from 'vitest';
+import { EventBus } from '../src/bus.js';
+import {
+  createCatalogService,
+  createInventoryService,
+  createCartService,
+  createPricingService,
+  createOrderService,
+  createPaymentService,
+  createNotificationService,
+  createAnalyticsService,
+} from '../src/index.js';
+import { OrderStatus, PaymentStatus, Events } from '../src/types.js';
+
+describe('e-commerce backend', () => {
+  it('runs a full happy-path flow', async () => {
+    const bus = new EventBus();
+    const catalog = createCatalogService(bus);
+    const inventory = createInventoryService(bus);
+    const cart = createCartService(bus);
+    const pricing = createPricingService(bus);
+    const orders = createOrderService(bus);
+    const payment = createPaymentService(bus);
+    const notifications = createNotificationService(bus);
+    const analytics = createAnalyticsService(bus);
+
+    const userId = 'user-1';
+    notifications.subscribe(userId);
+
+    const p1 = catalog.createProduct('Widget', 10, 'tools');
+    const p2 = catalog.createProduct('Gadget', 25, 'tools');
+    expect(catalog.getProduct(p1)?.name).toBe('Widget');
+    expect(catalog.listProducts('tools')).toHaveLength(2);
+    expect(catalog.searchProducts('wid')).toHaveLength(1);
+
+    // pricing learned prices from product:created events
+    expect(pricing.getPrice(p1)).toBe(10);
+
+    inventory.setStock(p1, 5);
+    inventory.setLowStockThreshold(p1, 3);
+    expect(inventory.reserve(p1, 2)).toBe(true);
+    expect(inventory.getStock(p1)).toBe(3);
+    expect(inventory.reserve(p1, 100)).toBe(false);
+
+    const cartId = cart.createCart(userId);
+    cart.addItem(cartId, p1, 1);
+    cart.addItem(cartId, p1, 2); // consolidates -> qty 3
+    cart.addItem(cartId, p2, 1);
+    expect(cart.getCart(cartId)?.items.find((i) => i.productId === p1)?.quantity).toBe(3);
+
+    pricing.addDiscountCode('SAVE10', 10);
+    const totals = pricing.calculateTotal(
+      [
+        { productId: p1, quantity: 3, price: 10 },
+        { productId: p2, quantity: 1, price: 25 },
+      ],
+      'SAVE10',
+    );
+    expect(totals.subtotal).toBe(55);
+    expect(totals.discount).toBe(5.5);
+    expect(totals.tax).toBe(4.95); // (55-5.5)*0.1
+    expect(totals.total).toBe(54.45);
+
+    const orderId = orders.createOrder(userId, cartId, totals.total);
+    expect(orders.getOrder(orderId)?.status).toBe(OrderStatus.PENDING);
+    orders.updateStatus(orderId, OrderStatus.CONFIRMED);
+    orders.updateStatus(orderId, OrderStatus.SHIPPED);
+    expect(orders.getOrder(orderId)?.status).toBe(OrderStatus.SHIPPED);
+    expect(orders.listOrders(userId)).toHaveLength(1);
+
+    const result = await payment.processPayment(orderId, totals.total);
+    expect(result.status).toBe(PaymentStatus.SUCCESS);
+    expect(result.transactionId).toBeDefined();
+    expect(await payment.refund(result.transactionId!)).toBe(true);
+    expect(await payment.refund(result.transactionId!)).toBe(false); // already refunded
+
+    // notifications recorded for subscribed user
+    const notes = notifications.getNotifications(userId);
+    expect(notes.length).toBeGreaterThan(0);
+    expect(notes.some((n) => n.type === 'payment')).toBe(true);
+
+    // analytics
+    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBe(2);
+    expect(analytics.getRevenue()).toBe(totals.total);
+    expect(analytics.getConversionRate()).toBe(1); // 1 order / 1 cart
