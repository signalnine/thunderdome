--- /dev/null
+++ b/src/payment/index.ts
@@ -0,0 +1,72 @@
+import { randomUUID } from 'node:crypto';
+import { EventBus } from '../bus.js';
+import { PaymentService, PaymentStatus, Events, PaymentProcessedEvent } from '../types.js';
+
+export interface PaymentOptions {
+  /** Forces the outcome of every processed payment. Defaults to 'success'. */
+  mode?: 'success' | 'failure' | 'timeout';
+  /** Artificial delay (ms) before a payment resolves. Defaults to 0. */
+  latencyMs?: number;
+  /** Error message used for 'failure'/'timeout' outcomes. */
+  errorMessage?: string;
+}
+
+interface Transaction {
+  transactionId: string;
+  orderId: string;
+  amount: number;
+  refunded: boolean;
+}
+
+function delay(ms: number): Promise<void> {
+  if (ms <= 0) {
+    return Promise.resolve();
+  }
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentOptions = {}): PaymentService {
+  const { mode = 'success', latencyMs = 0, errorMessage } = options;
+  const transactions = new Map<string, Transaction>();
+
+  return {
+    async processPayment(
+      orderId: string,
+      amount: number,
+    ): Promise<{ status: PaymentStatus; transactionId?: string; error?: string }> {
+      await delay(latencyMs);
+
+      let result: { status: PaymentStatus; transactionId?: string; error?: string };
+
+      if (mode === 'success') {
+        const transactionId = randomUUID();
+        transactions.set(transactionId, { transactionId, orderId, amount, refunded: false });
+        result = { status: PaymentStatus.SUCCESS, transactionId };
+      } else if (mode === 'failure') {
+        result = { status: PaymentStatus.FAILED, error: errorMessage ?? 'Payment failed' };
+      } else {
+        result = { status: PaymentStatus.TIMEOUT, error: errorMessage ?? 'Payment timed out' };
+      }
+
+      const payload: PaymentProcessedEvent = {
+        orderId,
+        status: result.status,
+        transactionId: result.transactionId,
+        error: result.error,
+      };
+      void bus.emit(Events.PAYMENT_PROCESSED, payload);
+
+      return result;
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      await delay(latencyMs);
+      const transaction = transactions.get(transactionId);
+      if (!transaction || transaction.refunded) {
+        return false;
+      }
+      transaction.refunded = true;
+      return true;
+    },
+  };
+}
diff --git a/src/pricing/index.ts b/src/pricing/index.ts
new file mode 100644
index 0000000..f1871fd
--- /dev/null
+++ b/src/pricing/index.ts
@@ -0,0 +1,54 @@
+import { EventBus } from '../bus.js';
+import { PricingService, Events, ProductCreatedEvent } from '../types.js';
+
+const TAX_RATE = 0.1;
+
+function round2(value: number): number {
+  return Math.round(value * 100) / 100;
+}
+
+export function createPricingService(bus: EventBus): PricingService {
+  const discountCodes = new Map<string, number>();
+  const prices = new Map<string, number>();
+
+  bus.on(Events.PRODUCT_CREATED, (payload) => {
+    const event = payload as ProductCreatedEvent;
+    prices.set(event.productId, event.price);
+  });
+
+  return {
+    calculateTotal(
+      items: Array<{ productId: string; quantity: number; price: number }>,
+      discountCode?: string,
+    ): { subtotal: number; discount: number; tax: number; total: number } {
+      const subtotal = items.reduce((sum, item) => sum + item.price * item.quantity, 0);
+
+      let discount = 0;
+      if (discountCode !== undefined) {
+        const percentage = discountCodes.get(discountCode);
+        if (percentage !== undefined) {
+          discount = subtotal * (percentage / 100);
+        }
+      }
+
+      const taxable = subtotal - discount;
+      const tax = taxable * TAX_RATE;
+      const total = taxable + tax;
+
+      return {
+        subtotal: round2(subtotal),
+        discount: round2(discount),
+        tax: round2(tax),
+        total: round2(total),
+      };
+    },
+
+    addDiscountCode(code: string, percentage: number): void {
+      discountCodes.set(code, percentage);
+    },
+
+    getPrice(productId: string): number {
+      return prices.get(productId) ?? 0;
+    },
+  };
+}
