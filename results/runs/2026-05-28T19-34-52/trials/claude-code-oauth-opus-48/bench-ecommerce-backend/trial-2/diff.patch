+++ b/src/inventory/index.ts
@@ -0,0 +1,59 @@
+import { EventBus } from '../bus.js';
+import { InventoryService, Events, InventoryUpdatedEvent, LowStockAlertEvent } from '../types.js';
+
+export function createInventoryService(bus: EventBus): InventoryService {
+  const stock = new Map<string, number>();
+  const thresholds = new Map<string, number>();
+
+  function emitUpdated(productId: string, quantity: number): void {
+    const payload: InventoryUpdatedEvent = { productId, quantity };
+    void bus.emit(Events.INVENTORY_UPDATED, payload);
+  }
+
+  function checkLowStock(productId: string, quantity: number): void {
+    const threshold = thresholds.get(productId);
+    if (threshold !== undefined && quantity < threshold) {
+      const payload: LowStockAlertEvent = { productId, currentQuantity: quantity, threshold };
+      void bus.emit(Events.LOW_STOCK_ALERT, payload);
+    }
+  }
+
+  return {
+    setStock(productId: string, quantity: number): void {
+      stock.set(productId, quantity);
+      emitUpdated(productId, quantity);
+      checkLowStock(productId, quantity);
+    },
+
+    getStock(productId: string): number {
+      return stock.get(productId) ?? 0;
+    },
+
+    reserve(productId: string, quantity: number): boolean {
+      const current = stock.get(productId) ?? 0;
+      if (quantity <= 0 || current < quantity) {
+        return false;
+      }
+      const remaining = current - quantity;
+      stock.set(productId, remaining);
+      emitUpdated(productId, remaining);
+      checkLowStock(productId, remaining);
+      return true;
+    },
+
+    release(productId: string, quantity: number): void {
+      if (quantity <= 0) {
+        return;
+      }
+      const current = stock.get(productId) ?? 0;
+      const updated = current + quantity;
+      stock.set(productId, updated);
+      emitUpdated(productId, updated);
+    },
+
+    setLowStockThreshold(productId: string, threshold: number): void {
+      thresholds.set(productId, threshold);
+      checkLowStock(productId, stock.get(productId) ?? 0);
+    },
+  };
+}
diff --git a/src/notifications/index.ts b/src/notifications/index.ts
new file mode 100644
index 0000000..890bb85
--- /dev/null
+++ b/src/notifications/index.ts
@@ -0,0 +1,74 @@
+import { EventBus } from '../bus.js';
+import {
+  NotificationService,
+  Events,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+  NotificationSentEvent,
+} from '../types.js';
+
+interface Notification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const notifications = new Map<string, Notification[]>();
+  const orderOwners = new Map<string, string>();
+
+  function record(userId: string, type: string, message: string): void {
+    if (!subscribers.has(userId)) {
+      return;
+    }
+    const entry: Notification = { type, message, timestamp: Date.now() };
+    const list = notifications.get(userId);
+    if (list) {
+      list.push(entry);
+    } else {
+      notifications.set(userId, [entry]);
+    }
+
+    const payload: NotificationSentEvent = { userId, type, message };
+    void bus.emit(Events.NOTIFICATION_SENT, payload);
+  }
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const event = payload as OrderCreatedEvent;
+    orderOwners.set(event.orderId, event.userId);
+    record(event.userId, 'order', `Order ${event.orderId} created`);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    const event = payload as OrderStatusChangedEvent;
+    const userId = orderOwners.get(event.orderId);
+    if (userId === undefined) {
+      return;
+    }
+    record(userId, 'order', `Order ${event.orderId} status changed to ${event.status}`);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const event = payload as PaymentProcessedEvent;
+    const userId = orderOwners.get(event.orderId);
+    if (userId === undefined) {
+      return;
+    }
+    record(userId, 'payment', `Payment for order ${event.orderId}: ${event.status}`);
+  });
+
+  return {
+    subscribe(userId: string): void {
+      subscribers.add(userId);
+      if (!notifications.has(userId)) {
+        notifications.set(userId, []);
+      }
+    },
+
+    getNotifications(userId: string): Notification[] {
+      return (notifications.get(userId) ?? []).map((n) => ({ ...n }));
+    },
+  };
+}
