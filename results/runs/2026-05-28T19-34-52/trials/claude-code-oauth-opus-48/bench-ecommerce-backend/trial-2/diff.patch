new file mode 100644
index 0000000..9073d1a
--- /dev/null
+++ b/src/cart/index.ts
@@ -0,0 +1,94 @@
+import { randomUUID } from 'node:crypto';
+import { EventBus } from '../bus.js';
+import { CartService, Events, CartUpdatedEvent } from '../types.js';
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: Array<{ productId: string; quantity: number }>;
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  function emitUpdated(cart: Cart): void {
+    const payload: CartUpdatedEvent = {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: cart.items.map((item) => ({ ...item })),
+    };
+    void bus.emit(Events.CART_UPDATED, payload);
+  }
+
+  return {
+    createCart(userId: string): string {
+      const id = randomUUID();
+      carts.set(id, { id, userId, items: [] });
+      return id;
+    },
+
+    addItem(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart || quantity <= 0) {
+        return;
+      }
+      const existing = cart.items.find((item) => item.productId === productId);
+      if (existing) {
+        existing.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      emitUpdated(cart);
+    },
+
+    removeItem(cartId: string, productId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        return;
+      }
+      const before = cart.items.length;
+      cart.items = cart.items.filter((item) => item.productId !== productId);
+      if (cart.items.length !== before) {
+        emitUpdated(cart);
+      }
+    },
+
+    getCart(cartId: string): Cart | null {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        return null;
+      }
+      return {
+        id: cart.id,
+        userId: cart.userId,
+        items: cart.items.map((item) => ({ ...item })),
+      };
+    },
+
+    clearCart(cartId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        return;
+      }
+      cart.items = [];
+      emitUpdated(cart);
+    },
+
+    updateQuantity(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) {
+        return;
+      }
+      const existing = cart.items.find((item) => item.productId === productId);
+      if (!existing) {
+        return;
+      }
+      if (quantity <= 0) {
+        cart.items = cart.items.filter((item) => item.productId !== productId);
+      } else {
+        existing.quantity = quantity;
+      }
+      emitUpdated(cart);
+    },
+  };
+}
