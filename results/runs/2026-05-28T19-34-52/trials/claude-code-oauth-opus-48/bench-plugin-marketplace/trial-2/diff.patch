+{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01XQqKy5qBvw4oC9HPdp4Z9C","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PQcpFbtQxxFfk3fXfhUjbL","name":"Write","input":{"file_path":"/workspace/tests/marketplace.test.ts","content":"import { describe, it, expect } from 'vitest';\nimport type { PluginManifest } from '../src/types.js';\nimport { createRegistry } from '../src/registry/index.js';\nimport { createResolver } from '../src/resolver/index.js';\nimport { createRunner } from '../src/runner/index.js';\nimport { createReviews } from '../src/reviews/index.js';\nimport { createDeps } from '../src/deps/index.js';\nimport { createMarketplace } from '../src/index.js';\n\nfunction manifest(\n  name: string,\n  version: string,\n  deps: Record<string, string> = {},\n  extra: Partial<PluginManifest> = {},\n): PluginManifest {\n  return {\n    name,\n    version,\n    description: `${name} plugin`,\n    author: 'tester',\n    dependencies: deps,\n    entryPoint: 'output = 1 + 1;',\n    permissions: [],\n    ...extra,\n  };\n}\n\ndescribe('registry', () => {\n  it('registers, looks up versions and returns latest from get()', () => {\n    const r = createRegistry();\n    r.register(manifest('a', '1.0.0'));\n    r.register(manifest('a', '2.1.0'));\n    r.register(manifest('a', '1.5.0'));\n\n    expect(r.get('a')?.version).toBe('2.1.0');\n    expect(r.getVersion('a', '1.5.0')?.version).toBe('1.5.0');\n    expect(r.getVersion('a', '9.9.9')).toBeNull();\n    expect(r.get('missing')).toBeNull();\n    expect(r.listVersions('a').sort()).toEqual(['1.0.0', '1.5.0', '2.1.0']);\n    expect(r.listVersions('missing')).toEqual([]);\n  });\n\n  it('lists all, searches, removes, updates', () => {\n    const r = createRegistry();\n    r.register(manifest('alpha', '1.0.0'));\n    r.register(manifest('beta', '1.0.0'));\n\n    expect(r.list()).toHaveLength(2);\n    expect(r.search('alpha').map((m) => m.name)).toContain('alpha');\n    expect(r.search('plugin')).toHaveLength(2); // matches descriptions\n\n    expect(r.remove('alpha', '1.0.0')).toBe(true);\n    expect(r.remove('alpha', '1.0.0')).toBe(false);\n    expect(r.get('alpha')).toBeNull();\n\n    r.update('beta', '1.0.0', { author: 'someone-else' });\n    expect(r.getVersion('beta', '1.0.0')?.author).toBe('someone-else');\n    // no-op on missing\n    expect(() => r.update('beta', '9.9.9', { author: 'x' })).not.toThrow();\n  });\n});\n\ndescribe('resolver', () => {\n  it('satisfies / maxSatisfying / validRange', () => {\n    const r = createResolver();\n    expect(r.satisfies('1.2.3', '^1.0.0')).toBe(true);\n    expect(r.satisfies('2.0.0', '^1.0.0')).toBe(false);\n    expect(r.satisfies('garbage', '^1.0.0')).toBe(false);\n    expect(r.maxSatisfying(['1.0.0', '1.5.0', '2.0.0'], '^1.0.0')).toBe('1.5.0');\n    expect(r.maxSatisfying(['2.0.0'], '^1.0.0')).toBeNull();\n    expect(r.validRange('^1.0.0')).toBe(true);\n    expect(r.validRange('not-a-range')).toBe(false);\n  });\n\n  it('resolves constraints, skipping unsatisfiable ones', () => {\n    const r = createResolver();\n    const resolved = r.resolve(\n      [\n        { name: 'a', range: '^1.0.0' },\n        { name: 'b', range: '^5.0.0' }, // no satisfying version\n        { name: 'c', range: '^2.0.0' }, // not available at all\n      ],\n      {\n        a: ['1.0.0', '1.4.2', '2.0.0'],\n        b: ['1.0.0'],\n      },\n    );\n    expect(resolved).toEqual([{ name: 'a', version: '1.4.2', satisfies: '^1.0.0' }]);\n  });\n});\n\ndescribe('runner', () => {\n  it('executes code and returns the completion value', async () => {\n    const runner = createRunner();\n    const res = await runner.execute('output = 21 * 2; output;', {});\n    expect(res.success).toBe(true);\n    expect(res.output).toBe(42);\n    expect(typeof res.duration).toBe('number');\n    expect(typeof res.memoryUsed).toBe('number');\n  });\n\n  it('passes context variables into the sandbox', async () => {\n    const runner = createRunner();\n    const res = await runner.execute('a + b;', { a: 3, b: 4 });\n    expect(res.success).toBe(true);\n    expect(res.output).toBe(7);\n  });\n\n  it('captures errors without rejecting', async () => {\n    const runner = createRunner();\n    const res = await runner.execute('throw new Error(\"boom\");');\n    expect(res.success).toBe(false);\n    expect(res.error).toContain('boom');\n  });\n\n  it('enforces timeouts on runaway code', async () => {\n    const runner = createRunner();\n    const res = await runner.executeWithTimeout('while (true) {}', 50);\n    expect(res.success).toBe(false);\n    expect(res.error).toMatch(/timed out/i);\n  });\n});\n\ndescribe('reviews', () => {\n  it('adds reviews and excludes flagged from averages', () => {\n    const rv = createReviews();\n    const a = rv.addReview({\n      pluginName: 'p',\n      pluginVersion: '1.0.0',\n      userId: 'u1',\n      rating: 5,\n      comment: 'great',\n    });\n    expect(a.id).toBeGreaterThan(0);\n    expect(a.flagged).toBe(false);\n    expect(a.createdAt).toBeTruthy();\n\n    rv.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u2', rating: 1, comment: 'spam' });\n    expect(rv.getAverageRating('p')).toBe(3); // (5 + 1) / 2\n\n    const flagged = rv.getReviews('p').find((r) => r.rating === 1)!;\n    rv.flagReview(flagged.id);\n    expect(rv.getAverageRating('p')).toBe(5); // flagged excluded\n    expect(rv.getFlaggedReviews()).toHaveLength(1);\n  });\n\n  it('queries by user, counts, removes, and handles empty averages', () => {\n    const rv = createReviews();\n    expect(rv.getAverageRating('none')).toBe(0);\n    rv.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u1', rating: 4, comment: 'x' });\n    rv.addReview({ pluginName: 'q', pluginVersion: '1.0.0', userId: 'u1', rating: 2, comment: 'y' });\n    expect(rv.getReviewsByUser('u1')).toHaveLength(2);\n    expect(rv.getReviewCount('p')).toBe(1);\n    const id = rv.getReviews('p')[0].id;\n    expect(rv.removeReview(id)).toBe(true);\n    expect(rv.removeReview(99999)).toBe(false);\n    expect(rv.getReviewCount('p')).toBe(0);\n  });\n});\n\ndescribe('deps', () => {\n  function depRegistry() {\n    const r = createRegistry();\n    r.register(manifest('a', '1.0.0', { b: '^1.0.0', c: '^1.0.0' }));\n    r.register(manifest('b', '1.0.0', { d: '^1.0.0' }));\n    r.register(manifest('c', '1.0.0', { d: '^1.0.0' }));\n    r.register(manifest('d', '1.0.0', {}));\n    return r;\n  }\n\n  it('builds a dependency tree', () => {\n    const deps = createDeps();\n    const tree = deps.buildTree('a', depRegistry());\n    expect(tree.name).toBe('a');\n    expect(tree.dependencies.map((n) => n.name).sort()).toEqual(['b', 'c']);\n  });\n\n  it('flattens transitive dependencies excluding the root', () => {\n    const deps = createDeps();\n    const flat = deps.flattenDependencies('a', depRegistry()).sort();\n    expect(flat).toEqual(['b', 'c', 'd']);\n  });\n\n  it('topologically sorts dependencies before dependents', () => {\n    const deps = createDeps();\n    const order = deps.topologicalSort('a', depRegistry());\n    expect(order).toContain('a');\n    expect(order).toContain('d');\n    expect(order.indexOf('d')).toBeLessThan(order.indexOf('b'));\n    expect(order.indexOf('b')).toBeLessThan(order.indexOf('a'));\n  });\n\n  it('detects circular dependencies', () => {\n    const r = createRegistry();\n    r.register(manifest('x', '1.0.0', { y: '^1.0.0' }));\n    r.register(manifest('y', '1.0.0', { x: '^1.0.0' }));\n    const deps = createDeps();\n    expect(deps.hasCircularDependency('x', r)).toBe(true);\n    expect(deps.detectCycles('x', r)).not.toBeNull();\n\n    expect(deps.hasCircularDependency('a', depRegistry())).toBe(false);\n    expect(deps.detectCycles('a', depRegistry())).toBeNull();\n  });\n});\n\ndescribe('marketplace integration', () => {\n  it('installs a plugin: registers, resolves deps, runs entry point', async () => {\n    const mp = createMarketplace();\n    mp.registry.register(manifest('dep', '1.2.0'));\n\n    const result = await mp.installPlugin(\n      manifest('main', '1.0.0', { dep: '^1.0.0' }, { entryPoint: 'output = ctx * 10; output;' }),\n      { ctx: 5 },\n    );\n\n    expect(mp.registry.get('main')?.version).toBe('1.0.0');\n    expect(result.resolved).toEqual([{ name: 'dep', version: '1.2.0', satisfies: '^1.0.0' }]);\n    expect(result.execution.success).toBe(true);\n    expect(result.execution.output).toBe(50);\n  });\n\n  it('rejects manifests missing required fields', async () => {\n    const mp = createMarketplace();\n    const bad = manifest('bad', '1.0.0');\n    // @ts-expect-error intentionally break the contract for the test\n    bad.entryPoint = '';\n    await expect(mp.installPlugin(bad)).rejects.toThrow(/entryPoint/i);\n  });\n\n  it('rejects plugins with circular dependencies', async () => {\n    const mp = createMarketplace();\n    mp.registry.register(manifest('p2', '1.0.0', { p1: '^1.0.0' }));\n    await expect(\n      mp.installPlugin(manifest('p1', '1.0.0', { p2: '^1.0.0' })),\n    ).rejects.toThrow(/circular/i);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2624,"cache_read_input_tokens":40896,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2624},"output_tokens":7,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2c92c4f0-a47c-4dc1-9889-e1b15fdbf985","uuid":"3df52d98-8452-43be-978e-8c07a135d43f","request_id":"req_011CbVZnCyA33ERHT2ezKGb9"}
