@@ -0,0 +1,53 @@
+import vm from 'node:vm';
+import { performance } from 'node:perf_hooks';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+export function createRunner(): RunnerService {
+  function buildSandbox(context: Record<string, unknown>): Record<string, unknown> {
+    const noop = (): void => {};
+    return {
+      ...context,
+      console: {
+        log: noop,
+        info: noop,
+        warn: noop,
+        error: noop,
+        debug: noop,
+      },
+    };
+  }
+
+  async function executeWithTimeout(
+    code: string,
+    timeoutMs: number,
+    context: Record<string, unknown> = {},
+  ): Promise<SandboxResult> {
+    const sandbox = buildSandbox(context);
+
+    const heapBefore = process.memoryUsage().heapUsed;
+    const start = performance.now();
+
+    try {
+      const output: unknown = vm.runInNewContext(code, sandbox, { timeout: timeoutMs });
+      const duration = performance.now() - start;
+      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - heapBefore);
+      return { success: true, output, duration, memoryUsed };
+    } catch (err: unknown) {
+      const duration = performance.now() - start;
+      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - heapBefore);
+      const error = err instanceof Error ? err.message : String(err);
+      return { success: false, output: undefined, duration, memoryUsed, error };
+    }
+  }
+
+  async function execute(
+    code: string,
+    context?: Record<string, unknown>,
+  ): Promise<SandboxResult> {
+    return executeWithTimeout(code, DEFAULT_TIMEOUT_MS, context);
+  }
+
+  return { execute, executeWithTimeout };
+}
