+++ b/src/registry/index.ts
@@ -0,0 +1,86 @@
+import semver from 'semver';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+export function createRegistry(): RegistryService {
+  // name -> version -> manifest
+  const plugins = new Map<string, Map<string, PluginManifest>>();
+
+  function register(manifest: PluginManifest): void {
+    let versions = plugins.get(manifest.name);
+    if (!versions) {
+      versions = new Map<string, PluginManifest>();
+      plugins.set(manifest.name, versions);
+    }
+    versions.set(manifest.version, manifest);
+  }
+
+  function get(name: string): PluginManifest | null {
+    const versions = plugins.get(name);
+    if (!versions || versions.size === 0) {
+      return null;
+    }
+    const sorted = semver.rsort([...versions.keys()]);
+    const latest = sorted[0];
+    return versions.get(latest) ?? null;
+  }
+
+  function getVersion(name: string, version: string): PluginManifest | null {
+    return plugins.get(name)?.get(version) ?? null;
+  }
+
+  function list(): PluginManifest[] {
+    const result: PluginManifest[] = [];
+    for (const versions of plugins.values()) {
+      for (const manifest of versions.values()) {
+        result.push(manifest);
+      }
+    }
+    return result;
+  }
+
+  function search(query: string): PluginManifest[] {
+    const needle = query.toLowerCase();
+    return list().filter(
+      (manifest) =>
+        manifest.name.toLowerCase().includes(needle) ||
+        manifest.description.toLowerCase().includes(needle),
+    );
+  }
+
+  function remove(name: string, version: string): boolean {
+    const versions = plugins.get(name);
+    if (!versions) {
+      return false;
+    }
+    const existed = versions.delete(version);
+    if (existed && versions.size === 0) {
+      plugins.delete(name);
+    }
+    return existed;
+  }
+
+  function listVersions(name: string): string[] {
+    const versions = plugins.get(name);
+    return versions ? [...versions.keys()] : [];
+  }
+
+  function update(name: string, version: string, updates: Partial<PluginManifest>): void {
+    const versions = plugins.get(name);
+    const existing = versions?.get(version);
+    if (!versions || !existing) {
+      return;
+    }
+    versions.set(version, { ...existing, ...updates });
+  }
+
+  return {
+    register,
+    get,
+    getVersion,
+    list,
+    search,
+    remove,
+    listVersions,
+    update,
+  };
+}
