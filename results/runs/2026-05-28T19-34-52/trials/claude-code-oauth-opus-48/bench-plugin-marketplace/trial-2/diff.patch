index 0000000..0f855f4
--- /dev/null
+++ b/src/deps/index.ts
@@ -0,0 +1,138 @@
+import type {
+  DependencyNode,
+  RegistryService,
+  PluginManifest,
+  DepsService,
+} from '../types.js';
+
+interface ResolvedManifest {
+  version: string;
+  children: string[];
+}
+
+function resolve(name: string, registry: RegistryService): ResolvedManifest {
+  const manifest: PluginManifest | null = registry.get(name);
+  if (manifest === null) {
+    return { version: '', children: [] };
+  }
+  return {
+    version: manifest.version,
+    children: Object.keys(manifest.dependencies),
+  };
+}
+
+export function createDeps(): DepsService {
+  function buildTree(name: string, registry: RegistryService): DependencyNode {
+    const build = (current: string, path: Set<string>): DependencyNode => {
+      const { version, children } = resolve(current, registry);
+      const node: DependencyNode = { name: current, version, dependencies: [] };
+      if (path.has(current)) {
+        // Already on the current path: stop to avoid infinite recursion.
+        return node;
+      }
+      path.add(current);
+      for (const child of children) {
+        node.dependencies.push(build(child, path));
+      }
+      path.delete(current);
+      return node;
+    };
+    return build(name, new Set<string>());
+  }
+
+  function detectCycles(
+    name: string,
+    registry: RegistryService,
+  ): string[][] | null {
+    const cycles: string[][] = [];
+    const seen = new Set<string>();
+    const path: string[] = [];
+    const onPath = new Set<string>();
+
+    const visit = (current: string): void => {
+      if (onPath.has(current)) {
+        const start = path.indexOf(current);
+        const cycle = path.slice(start).concat(current);
+        const key = cycle.join('->');
+        if (!seen.has(key)) {
+          seen.add(key);
+          cycles.push(cycle);
+        }
+        return;
+      }
+      path.push(current);
+      onPath.add(current);
+      const { children } = resolve(current, registry);
+      for (const child of children) {
+        visit(child);
+      }
+      path.pop();
+      onPath.delete(current);
+    };
+
+    visit(name);
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  function hasCircularDependency(
+    name: string,
+    registry: RegistryService,
+  ): boolean {
+    const cycles = detectCycles(name, registry);
+    return cycles !== null && cycles.length > 0;
+  }
+
+  function topologicalSort(
+    name: string,
+    registry: RegistryService,
+  ): string[] {
+    const order: string[] = [];
+    const visited = new Set<string>();
+
+    const visit = (current: string): void => {
+      if (visited.has(current)) {
+        return;
+      }
+      visited.add(current);
+      const { children } = resolve(current, registry);
+      for (const child of children) {
+        visit(child);
+      }
+      // Post-order: dependencies appended before the dependent.
+      order.push(current);
+    };
+
+    visit(name);
+    return order;
+  }
+
+  function flattenDependencies(
+    name: string,
+    registry: RegistryService,
+  ): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>([name]);
+
+    const visit = (current: string): void => {
+      const { children } = resolve(current, registry);
+      for (const child of children) {
+        if (!visited.has(child)) {
+          visited.add(child);
+          result.push(child);
+          visit(child);
+        }
+      }
+    };
+
+    visit(name);
+    return result;
+  }
+
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency,
+  };
+}
