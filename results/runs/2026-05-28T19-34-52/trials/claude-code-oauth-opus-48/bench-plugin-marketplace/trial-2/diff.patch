+++ b/src/resolver/index.ts
@@ -0,0 +1,53 @@
+import { satisfies, maxSatisfying, validRange } from 'semver';
+import type {
+  ResolverService,
+  VersionConstraint,
+  ResolvedVersion,
+} from '../types.js';
+
+export function createResolver(): ResolverService {
+  return {
+    resolve(
+      constraints: VersionConstraint[],
+      available: Record<string, string[]>,
+    ): ResolvedVersion[] {
+      const resolved: ResolvedVersion[] = [];
+      for (const constraint of constraints) {
+        const versions = available[constraint.name] ?? [];
+        const best = this.maxSatisfying(versions, constraint.range);
+        if (best !== null) {
+          resolved.push({
+            name: constraint.name,
+            version: best,
+            satisfies: constraint.range,
+          });
+        }
+      }
+      return resolved;
+    },
+
+    satisfies(version: string, range: string): boolean {
+      try {
+        return satisfies(version, range);
+      } catch {
+        return false;
+      }
+    },
+
+    maxSatisfying(versions: string[], range: string): string | null {
+      try {
+        return maxSatisfying(versions, range);
+      } catch {
+        return null;
+      }
+    },
+
+    validRange(range: string): boolean {
+      try {
+        return validRange(range) !== null;
+      } catch {
+        return false;
+      }
+    },
+  };
+}
