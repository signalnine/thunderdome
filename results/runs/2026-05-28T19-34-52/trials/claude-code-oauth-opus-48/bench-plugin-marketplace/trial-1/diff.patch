+import { createReviewService } from './reviews.js';
+import type { ReviewService } from '../types.js';
+
+function makeReview(overrides: Partial<{
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+}> = {}) {
+  return {
+    pluginName: 'foo',
+    pluginVersion: '1.0.0',
+    userId: 'alice',
+    rating: 5,
+    comment: 'great',
+    ...overrides,
+  };
+}
+
+describe('ReviewService', () => {
+  let service: ReviewService;
+
+  beforeEach(() => {
+    service = createReviewService();
+  });
+
+  it('addReview returns full review with generated id, flagged false, createdAt', () => {
+    const r = service.addReview(makeReview());
+    expect(r.id).toBeGreaterThan(0);
+    expect(r.flagged).toBe(false);
+    expect(typeof r.createdAt).toBe('string');
+    expect(new Date(r.createdAt).toISOString()).toBe(r.createdAt);
+    expect(r.pluginName).toBe('foo');
+    expect(r.rating).toBe(5);
+  });
+
+  it('assigns increasing ids', () => {
+    const a = service.addReview(makeReview());
+    const b = service.addReview(makeReview());
+    expect(b.id).toBeGreaterThan(a.id);
+  });
+
+  it('getReviews returns reviews for a plugin with boolean flagged', () => {
+    service.addReview(makeReview({ pluginName: 'foo' }));
+    service.addReview(makeReview({ pluginName: 'bar' }));
+    const foo = service.getReviews('foo');
+    expect(foo).toHaveLength(1);
+    expect(foo[0].pluginName).toBe('foo');
+    expect(foo[0].flagged).toBe(false);
+    expect(typeof foo[0].flagged).toBe('boolean');
+  });
+
+  it('getReviews returns empty array for unknown plugin', () => {
+    expect(service.getReviews('nope')).toEqual([]);
+  });
+
+  it('getAverageRating averages non-flagged reviews', () => {
+    service.addReview(makeReview({ rating: 4 }));
+    service.addReview(makeReview({ rating: 2 }));
+    expect(service.getAverageRating('foo')).toBe(3);
+  });
+
+  it('getAverageRating returns 0 when no reviews', () => {
+    expect(service.getAverageRating('foo')).toBe(0);
+  });
+
+  it('getAverageRating excludes flagged reviews', () => {
+    const a = service.addReview(makeReview({ rating: 1 }));
+    service.addReview(makeReview({ rating: 5 }));
+    service.flagReview(a.id);
+    expect(service.getAverageRating('foo')).toBe(5);
+  });
+
+  it('getAverageRating returns 0 when all reviews flagged', () => {
+    const a = service.addReview(makeReview({ rating: 1 }));
+    service.flagReview(a.id);
+    expect(service.getAverageRating('foo')).toBe(0);
+  });
+
+  it('flagReview sets flagged true and surfaces in getFlaggedReviews', () => {
+    const a = service.addReview(makeReview());
+    service.flagReview(a.id);
+    const flagged = service.getFlaggedReviews();
+    expect(flagged).toHaveLength(1);
+    expect(flagged[0].id).toBe(a.id);
+    expect(flagged[0].flagged).toBe(true);
+    expect(service.getReviews('foo')[0].flagged).toBe(true);
+  });
+
+  it('getFlaggedReviews returns only flagged', () => {
+    service.addReview(makeReview());
+    const b = service.addReview(makeReview());
+    service.flagReview(b.id);
+    const flagged = service.getFlaggedReviews();
+    expect(flagged.map((r) => r.id)).toEqual([b.id]);
+  });
+
+  it('removeReview deletes and returns true, false when missing', () => {
+    const a = service.addReview(makeReview());
+    expect(service.removeReview(a.id)).toBe(true);
+    expect(service.getReviews('foo')).toHaveLength(0);
+    expect(service.removeReview(a.id)).toBe(false);
+    expect(service.removeReview(9999)).toBe(false);
+  });
+
+  it('getReviewsByUser returns reviews for that user', () => {
+    service.addReview(makeReview({ userId: 'alice' }));
+    service.addReview(makeReview({ userId: 'bob' }));
+    service.addReview(makeReview({ userId: 'alice' }));
+    const alice = service.getReviewsByUser('alice');
+    expect(alice).toHaveLength(2);
+    expect(alice.every((r) => r.userId === 'alice')).toBe(true);
+  });
+
+  it('getReviewCount counts all reviews flagged or not', () => {
+    const a = service.addReview(makeReview());
+    service.addReview(makeReview());
+    service.flagReview(a.id);
+    expect(service.getReviewCount('foo')).toBe(2);
+    expect(service.getReviewCount('bar')).toBe(0);
+  });
+});
