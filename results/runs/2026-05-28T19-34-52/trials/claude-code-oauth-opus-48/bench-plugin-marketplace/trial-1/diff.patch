--- /dev/null
+++ b/src/registry/registry.ts
@@ -0,0 +1,107 @@
+import type { PluginManifest, RegistryService } from '../types.js';
+import semver from 'semver';
+
+export function createRegistry(): RegistryService {
+  // Map<name, Map<version, PluginManifest>>
+  const catalog = new Map<string, Map<string, PluginManifest>>();
+
+  function register(manifest: PluginManifest): void {
+    let versions = catalog.get(manifest.name);
+    if (!versions) {
+      versions = new Map<string, PluginManifest>();
+      catalog.set(manifest.name, versions);
+    }
+    versions.set(manifest.version, manifest);
+  }
+
+  function get(name: string): PluginManifest | null {
+    const versions = catalog.get(name);
+    if (!versions || versions.size === 0) {
+      return null;
+    }
+    let highest: string | null = null;
+    for (const version of versions.keys()) {
+      if (highest === null || semver.gt(version, highest)) {
+        highest = version;
+      }
+    }
+    if (highest === null) {
+      return null;
+    }
+    return versions.get(highest) ?? null;
+  }
+
+  function getVersion(name: string, version: string): PluginManifest | null {
+    const versions = catalog.get(name);
+    if (!versions) {
+      return null;
+    }
+    return versions.get(version) ?? null;
+  }
+
+  function list(): PluginManifest[] {
+    const result: PluginManifest[] = [];
+    for (const versions of catalog.values()) {
+      for (const manifest of versions.values()) {
+        result.push(manifest);
+      }
+    }
+    return result;
+  }
+
+  function search(query: string): PluginManifest[] {
+    const needle = query.toLowerCase();
+    return list().filter(
+      (m) =>
+        m.name.toLowerCase().includes(needle) ||
+        m.description.toLowerCase().includes(needle),
+    );
+  }
+
+  function remove(name: string, version: string): boolean {
+    const versions = catalog.get(name);
+    if (!versions) {
+      return false;
+    }
+    const existed = versions.delete(version);
+    if (versions.size === 0) {
+      catalog.delete(name);
+    }
+    return existed;
+  }
+
+  function listVersions(name: string): string[] {
+    const versions = catalog.get(name);
+    if (!versions) {
+      return [];
+    }
+    return Array.from(versions.keys());
+  }
+
+  function update(
+    name: string,
+    version: string,
+    updates: Partial<PluginManifest>,
+  ): void {
+    const versions = catalog.get(name);
+    if (!versions) {
+      return;
+    }
+    const existing = versions.get(version);
+    if (!existing) {
+      return;
+    }
+    versions.set(version, { ...existing, ...updates });
+  }
+
+  return {
+    register,
+    get,
+    getVersion,
+    list,
+    search,
+    remove,
+    listVersions,
+    update,
+  };
+}
