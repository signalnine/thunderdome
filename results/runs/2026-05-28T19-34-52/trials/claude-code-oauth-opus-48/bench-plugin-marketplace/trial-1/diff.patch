+import type { PluginManifest } from '../types.js';
+import { createRegistry } from './registry.js';
+
+function makeManifest(
+  overrides: Partial<PluginManifest> = {},
+): PluginManifest {
+  return {
+    name: 'alpha',
+    version: '1.0.0',
+    description: 'Alpha plugin',
+    author: 'tester',
+    dependencies: {},
+    entryPoint: 'index.js',
+    permissions: [],
+    ...overrides,
+  };
+}
+
+describe('RegistryService', () => {
+  describe('register / getVersion', () => {
+    it('stores a manifest retrievable by exact version', () => {
+      const reg = createRegistry();
+      const m = makeManifest();
+      reg.register(m);
+      expect(reg.getVersion('alpha', '1.0.0')).toEqual(m);
+    });
+
+    it('overwrites an existing name+version', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ description: 'old' }));
+      reg.register(makeManifest({ description: 'new' }));
+      expect(reg.getVersion('alpha', '1.0.0')?.description).toBe('new');
+      expect(reg.listVersions('alpha')).toEqual(['1.0.0']);
+    });
+
+    it('keeps multiple versions of the same plugin', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ version: '1.0.0' }));
+      reg.register(makeManifest({ version: '2.0.0' }));
+      expect(reg.getVersion('alpha', '1.0.0')).not.toBeNull();
+      expect(reg.getVersion('alpha', '2.0.0')).not.toBeNull();
+    });
+
+    it('returns null for unknown version', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest());
+      expect(reg.getVersion('alpha', '9.9.9')).toBeNull();
+      expect(reg.getVersion('missing', '1.0.0')).toBeNull();
+    });
+  });
+
+  describe('get (highest semver)', () => {
+    it('returns the highest semver version', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ version: '1.2.0' }));
+      reg.register(makeManifest({ version: '2.0.0' }));
+      reg.register(makeManifest({ version: '1.10.0' }));
+      expect(reg.get('alpha')?.version).toBe('2.0.0');
+    });
+
+    it('compares numerically not lexically', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ version: '1.9.0' }));
+      reg.register(makeManifest({ version: '1.10.0' }));
+      expect(reg.get('alpha')?.version).toBe('1.10.0');
+    });
+
+    it('handles prerelease ordering', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ version: '1.0.0-alpha' }));
+      reg.register(makeManifest({ version: '1.0.0' }));
+      expect(reg.get('alpha')?.version).toBe('1.0.0');
+    });
+
+    it('returns null when no versions exist', () => {
+      const reg = createRegistry();
+      expect(reg.get('nope')).toBeNull();
+    });
+  });
+
+  describe('list', () => {
+    it('returns a flat array of all versions of all plugins', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ name: 'alpha', version: '1.0.0' }));
+      reg.register(makeManifest({ name: 'alpha', version: '2.0.0' }));
+      reg.register(makeManifest({ name: 'beta', version: '1.0.0' }));
+      const all = reg.list();
+      expect(all).toHaveLength(3);
+      const keys = all.map((m) => `${m.name}@${m.version}`).sort();
+      expect(keys).toEqual(['alpha@1.0.0', 'alpha@2.0.0', 'beta@1.0.0']);
+    });
+
+    it('returns empty array when nothing registered', () => {
+      expect(createRegistry().list()).toEqual([]);
+    });
+  });
+
+  describe('search', () => {
+    it('matches name case-insensitively', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ name: 'AlphaTool' }));
+      reg.register(makeManifest({ name: 'beta' }));
+      const found = reg.search('alphatool');
+      expect(found).toHaveLength(1);
+      expect(found[0].name).toBe('AlphaTool');
+    });
+
+    it('matches description case-insensitively', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ name: 'x', description: 'Does Cool Things' }));
+      reg.register(makeManifest({ name: 'y', description: 'boring' }));
+      const found = reg.search('cool');
+      expect(found.map((m) => m.name)).toEqual(['x']);
+    });
+
+    it('returns all matching versions', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ name: 'alpha', version: '1.0.0' }));
+      reg.register(makeManifest({ name: 'alpha', version: '2.0.0' }));
+      expect(reg.search('alpha')).toHaveLength(2);
+    });
+
+    it('returns empty array on no match', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest());
+      expect(reg.search('zzz')).toEqual([]);
+    });
+  });
+
+  describe('remove', () => {
+    it('removes an exact version and returns true', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ version: '1.0.0' }));
+      reg.register(makeManifest({ version: '2.0.0' }));
+      expect(reg.remove('alpha', '1.0.0')).toBe(true);
+      expect(reg.getVersion('alpha', '1.0.0')).toBeNull();
+      expect(reg.listVersions('alpha')).toEqual(['2.0.0']);
+    });
+
+    it('returns false when version missing', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest());
+      expect(reg.remove('alpha', '9.9.9')).toBe(false);
+      expect(reg.remove('ghost', '1.0.0')).toBe(false);
+    });
+
+    it('cleans up plugin entry when last version removed', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ version: '1.0.0' }));
+      expect(reg.remove('alpha', '1.0.0')).toBe(true);
+      expect(reg.listVersions('alpha')).toEqual([]);
+      expect(reg.get('alpha')).toBeNull();
+    });
+  });
+
+  describe('listVersions', () => {
+    it('returns registered version strings', () => {
+      const reg = createRegistry();
+      reg.register(makeManifest({ version: '1.0.0' }));
+      reg.register(makeManifest({ version: '2.1.0' }));
+      expect(reg.listVersions('alpha').sort()).toEqual(['1.0.0', '2.1.0']);
