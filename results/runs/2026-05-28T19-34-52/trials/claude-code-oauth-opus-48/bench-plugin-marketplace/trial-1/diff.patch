+++ b/src/reviews/reviews.ts
@@ -0,0 +1,119 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+function rowToReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged === 1,
+    createdAt: row.createdAt,
+  };
+}
+
+export function createReviewService(dbPath = ':memory:'): ReviewService {
+  const db = new Database(dbPath);
+
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT,
+      pluginVersion TEXT,
+      userId TEXT,
+      rating INTEGER,
+      comment TEXT,
+      flagged INTEGER,
+      createdAt TEXT
+    )
+  `);
+
+  const insertStmt = db.prepare(
+    `INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+     VALUES (@pluginName, @pluginVersion, @userId, @rating, @comment, 0, @createdAt)`
+  );
+  const getByPluginStmt = db.prepare(
+    `SELECT * FROM reviews WHERE pluginName = ? ORDER BY id`
+  );
+  const avgStmt = db.prepare(
+    `SELECT AVG(rating) AS avg FROM reviews WHERE pluginName = ? AND flagged = 0`
+  );
+  const flagStmt = db.prepare(`UPDATE reviews SET flagged = 1 WHERE id = ?`);
+  const flaggedStmt = db.prepare(`SELECT * FROM reviews WHERE flagged = 1 ORDER BY id`);
+  const removeStmt = db.prepare(`DELETE FROM reviews WHERE id = ?`);
+  const byUserStmt = db.prepare(`SELECT * FROM reviews WHERE userId = ? ORDER BY id`);
+  const countStmt = db.prepare(
+    `SELECT COUNT(*) AS count FROM reviews WHERE pluginName = ?`
+  );
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      const createdAt = new Date().toISOString();
+      const info = insertStmt.run({
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment,
+        createdAt,
+      });
+      return {
+        id: Number(info.lastInsertRowid),
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment,
+        flagged: false,
+        createdAt,
+      };
+    },
+
+    getReviews(pluginName: string): Review[] {
+      const rows = getByPluginStmt.all(pluginName) as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    getAverageRating(pluginName: string): number {
+      const result = avgStmt.get(pluginName) as { avg: number | null };
+      return result.avg ?? 0;
+    },
+
+    flagReview(reviewId: number): void {
+      flagStmt.run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      const rows = flaggedStmt.all() as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      const info = removeStmt.run(reviewId);
+      return info.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      const rows = byUserStmt.all(userId) as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const result = countStmt.get(pluginName) as { count: number };
+      return result.count;
+    },
+  };
+}
