+import type {
+  DepsService,
+  DependencyNode,
+  RegistryService,
+} from '../types.js';
+
+export function createDepsService(): DepsService {
+  function buildNode(
+    name: string,
+    registry: RegistryService,
+    path: Set<string>,
+  ): DependencyNode {
+    const manifest = registry.get(name);
+    if (manifest === null) {
+      return { name, version: 'unknown', dependencies: [] };
+    }
+
+    const version = manifest.version || '0.0.0';
+    const depNames = Object.keys(manifest.dependencies ?? {});
+
+    // Cycle guard: if this name is already on the current path, return a leaf.
+    if (path.has(name)) {
+      return { name, version, dependencies: [] };
+    }
+
+    const nextPath = new Set(path);
+    nextPath.add(name);
+
+    const dependencies: DependencyNode[] = depNames.map((depName) =>
+      buildNode(depName, registry, nextPath),
+    );
+
+    return { name, version, dependencies };
+  }
+
+  function buildTree(name: string, registry: RegistryService): DependencyNode {
+    return buildNode(name, registry, new Set<string>());
+  }
+
+  function detectCycles(
+    name: string,
+    registry: RegistryService,
+  ): string[][] | null {
+    const cycles: string[][] = [];
+    const seenCycles = new Set<string>();
+
+    function dfs(current: string, path: string[]): void {
+      const idx = path.indexOf(current);
+      if (idx !== -1) {
+        // Found a cycle: from first occurrence to here, closing the loop.
+        const cycle = [...path.slice(idx), current];
+        const key = cycle.join(' ');
+        if (!seenCycles.has(key)) {
+          seenCycles.add(key);
+          cycles.push(cycle);
+        }
+        return;
+      }
+
+      const manifest = registry.get(current);
+      if (manifest === null) {
+        return;
+      }
+
+      const depNames = Object.keys(manifest.dependencies ?? {});
+      const nextPath = [...path, current];
+      for (const depName of depNames) {
+        dfs(depName, nextPath);
+      }
+    }
+
+    dfs(name, []);
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  function hasCircularDependency(
+    name: string,
+    registry: RegistryService,
+  ): boolean {
+    const cycles = detectCycles(name, registry);
+    return cycles !== null && cycles.length > 0;
+  }
+
+  function topologicalSort(
+    name: string,
+    registry: RegistryService,
+  ): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>();
+
+    function dfs(current: string): void {
+      if (visited.has(current)) {
+        return;
+      }
+      visited.add(current);
+
+      const manifest = registry.get(current);
+      const depNames =
+        manifest === null ? [] : Object.keys(manifest.dependencies ?? {});
+      for (const depName of depNames) {
+        dfs(depName);
+      }
+
+      // Post-order: dependencies appended before the dependent.
+      result.push(current);
+    }
+
+    dfs(name);
+    return result;
+  }
+
+  function flattenDependencies(
+    name: string,
+    registry: RegistryService,
+  ): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>();
+
+    function dfs(current: string): void {
+      const manifest = registry.get(current);
+      const depNames =
+        manifest === null ? [] : Object.keys(manifest.dependencies ?? {});
+      for (const depName of depNames) {
+        if (!visited.has(depName)) {
+          visited.add(depName);
+          result.push(depName);
+          dfs(depName);
+        }
+      }
+    }
+
+    dfs(name);
+    // Exclude the root itself if it was reached transitively (cycle).
+    return result.filter((n) => n !== name);
+  }
+
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency,
+  };
+}
