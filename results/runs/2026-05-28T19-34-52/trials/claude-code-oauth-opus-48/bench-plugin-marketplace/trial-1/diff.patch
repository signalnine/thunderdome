 = await mp.installPlugin(\n      manifest({ name: 'app', dependencies: { lib: '^1.0.0' } }),\n    );\n    const lib = result.resolved.find((r) => r.name === 'lib');\n    expect(lib?.version).toBe('1.5.0');\n  });\n\n  it('rejects plugins with circular dependencies', async () => {\n    const mp = createMarketplace();\n    mp.registry.register(manifest({ name: 'a', dependencies: { b: '^1.0.0' } }));\n    mp.registry.register(manifest({ name: 'b', dependencies: { a: '^1.0.0' } }));\n    await expect(\n      mp.installPlugin(manifest({ name: 'a', dependencies: { b: '^1.0.0' } })),\n    ).rejects.toThrow(/circular/i);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":1759,"cache_read_input_tokens":34338,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1759},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ce3a8e9b-ec25-43f5-a87a-fb4762a666b1","uuid":"77c9ff88-9f71-4198-9f77-b73ec3967c45","request_id":"req_011CbVZb4VsHW5RwRa65x6RS"}
