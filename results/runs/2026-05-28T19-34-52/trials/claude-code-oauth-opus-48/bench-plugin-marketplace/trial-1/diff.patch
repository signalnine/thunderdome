@@ -0,0 +1,41 @@
+import vm from 'node:vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT = 1000;
+
+export function createRunner(): RunnerService {
+  async function executeWithTimeout(
+    code: string,
+    timeoutMs: number,
+    context: Record<string, unknown> = {},
+  ): Promise<SandboxResult> {
+    const sandbox: Record<string, unknown> = { ...context };
+    const vmContext = vm.createContext(sandbox);
+    const script = new vm.Script(code);
+
+    const startHeap = process.memoryUsage().heapUsed;
+    const start = Date.now();
+
+    try {
+      const output = script.runInContext(vmContext, { timeout: timeoutMs });
+      const duration = Date.now() - start;
+      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - startHeap);
+      return { success: true, output, duration, memoryUsed };
+    } catch (err: unknown) {
+      const duration = Date.now() - start;
+      const memoryUsed = Math.max(0, process.memoryUsage().heapUsed - startHeap);
+      const message =
+        err instanceof Error ? err.message : String((err as { message?: unknown })?.message ?? err);
+      return { success: false, output: undefined, duration, memoryUsed, error: message };
+    }
+  }
+
+  async function execute(
+    code: string,
+    context: Record<string, unknown> = {},
+  ): Promise<SandboxResult> {
+    return executeWithTimeout(code, DEFAULT_TIMEOUT, context);
+  }
+
+  return { execute, executeWithTimeout };
+}
