+import type {
+  PluginManifest,
+  ResolvedVersion,
+  SandboxResult,
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+  VersionConstraint,
+} from './types.js';
+
+import { createRegistry } from './registry/registry.js';
+import { createResolver } from './resolver/resolver.js';
+import { createRunner } from './runner/runner.js';
+import { createReviewService } from './reviews/reviews.js';
+import { createDepsService } from './deps/deps.js';
+
+export interface InstallResult {
+  manifest: PluginManifest;
+  resolved: ResolvedVersion[];
+  execution: SandboxResult;
+}
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest): Promise<InstallResult>;
+}
+
+export interface MarketplaceOptions {
+  dbPath?: string;
+}
+
+export function createMarketplace(options: MarketplaceOptions = {}): Marketplace {
+  const registry = createRegistry();
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviewService(options.dbPath);
+  const deps = createDepsService();
+
+  async function installPlugin(manifest: PluginManifest): Promise<InstallResult> {
+    // 1. Validate required fields.
+    if (!manifest || typeof manifest !== 'object') {
+      throw new Error('Invalid manifest: expected an object');
+    }
+    if (!manifest.name) {
+      throw new Error('Invalid manifest: missing required field "name"');
+    }
+    if (!manifest.version) {
+      throw new Error('Invalid manifest: missing required field "version"');
+    }
+    if (!manifest.entryPoint) {
+      throw new Error('Invalid manifest: missing required field "entryPoint"');
+    }
+
+    // 2. Register the plugin in the catalog.
+    registry.register(manifest);
+
+    // 3. Resolve dependency versions against what is available in the registry.
+    const dependencies = manifest.dependencies ?? {};
+    const constraints: VersionConstraint[] = Object.entries(dependencies).map(
+      ([name, range]) => ({ name, range }),
+    );
+    const available: Record<string, string[]> = {};
+    for (const { name } of constraints) {
+      available[name] = registry.listVersions(name);
+    }
+    const resolved = resolver.resolve(constraints, available);
+
+    // 4. Reject if there is a circular dependency.
+    if (deps.hasCircularDependency(manifest.name, registry)) {
+      throw new Error(
+        `Cannot install "${manifest.name}": circular dependency detected`,
+      );
+    }
+
+    // 5. Execute the plugin's entry point in the sandbox.
+    const execution = await runner.execute(manifest.entryPoint);
+
+    // 6. Return the resolved dependency versions and sandbox execution result.
+    return { manifest, resolved, execution };
+  }
+
+  return { registry, resolver, runner, reviews, deps, installPlugin };
+}
+
+export type {
+  PluginManifest,
+  VersionConstraint,
+  ResolvedVersion,
+  Review,
+  DependencyNode,
+  SandboxResult,
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+} from './types.js';
