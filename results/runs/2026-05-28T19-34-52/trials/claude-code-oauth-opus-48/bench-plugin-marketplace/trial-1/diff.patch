+    author: '',
+    dependencies: deps,
+    entryPoint: 'index.js',
+    permissions: [],
+  };
+}
+
+// Minimal in-memory registry sufficient for DepsService (only get is used).
+function makeRegistry(manifests: PluginManifest[]): RegistryService {
+  const map = new Map<string, PluginManifest>();
+  for (const m of manifests) {
+    map.set(m.name, m);
+  }
+  return {
+    register(m: PluginManifest): void {
+      map.set(m.name, m);
+    },
+    get(name: string): PluginManifest | null {
+      return map.get(name) ?? null;
+    },
+    getVersion(name: string, version: string): PluginManifest | null {
+      const m = map.get(name);
+      return m && m.version === version ? m : null;
+    },
+    list(): PluginManifest[] {
+      return [...map.values()];
+    },
+    search(): PluginManifest[] {
+      return [];
+    },
+    remove(name: string): boolean {
+      return map.delete(name);
+    },
+    listVersions(name: string): string[] {
+      const m = map.get(name);
+      return m ? [m.version] : [];
+    },
+    update(): void {
+      // not used
+    },
+  };
+}
+
+describe('DepsService.buildTree', () => {
+  it('builds a nested tree with version and dependencies', () => {
+    const registry = makeRegistry([
+      manifest('a', { b: '^1.0.0', c: '^1.0.0' }, '2.0.0'),
+      manifest('b', { d: '^1.0.0' }),
+      manifest('c'),
+      manifest('d'),
+    ]);
+    const deps = createDepsService();
+    const tree = deps.buildTree('a', registry);
+
+    expect(tree.name).toBe('a');
+    expect(tree.version).toBe('2.0.0');
+    expect(tree.dependencies.map((n) => n.name).sort()).toEqual(['b', 'c']);
+
+    const b = tree.dependencies.find((n) => n.name === 'b')!;
+    expect(b.dependencies.map((n) => n.name)).toEqual(['d']);
+  });
+
+  it('returns unknown version and empty deps for a missing plugin', () => {
+    const registry = makeRegistry([]);
+    const deps = createDepsService();
+    const tree = deps.buildTree('ghost', registry);
+    expect(tree).toEqual({ name: 'ghost', version: 'unknown', dependencies: [] });
+  });
+
+  it('uses 0.0.0 when manifest version is empty', () => {
+    const registry = makeRegistry([manifest('a', {}, '')]);
+    const deps = createDepsService();
+    const tree = deps.buildTree('a', registry);
+    expect(tree.version).toBe('0.0.0');
+  });
+
+  it('terminates on a cycle, including the repeat as a leaf', () => {
+    const registry = makeRegistry([
+      manifest('a', { b: '^1.0.0' }),
+      manifest('b', { a: '^1.0.0' }),
+    ]);
+    const deps = createDepsService();
+    const tree = deps.buildTree('a', registry);
+
+    expect(tree.name).toBe('a');
+    const b = tree.dependencies[0];
+    expect(b.name).toBe('b');
+    const aLeaf = b.dependencies[0];
+    expect(aLeaf.name).toBe('a');
+    expect(aLeaf.dependencies).toEqual([]);
+  });
+});
+
+describe('DepsService.detectCycles', () => {
+  it('returns null when there are no cycles', () => {
+    const registry = makeRegistry([
+      manifest('a', { b: '^1.0.0' }),
+      manifest('b', { c: '^1.0.0' }),
+      manifest('c'),
+    ]);
+    const deps = createDepsService();
+    expect(deps.detectCycles('a', registry)).toBeNull();
+  });
+
+  it('detects a direct cycle', () => {
+    const registry = makeRegistry([
+      manifest('a', { b: '^1.0.0' }),
+      manifest('b', { a: '^1.0.0' }),
+    ]);
+    const deps = createDepsService();
+    const cycles = deps.detectCycles('a', registry);
+    expect(cycles).not.toBeNull();
+    expect(cycles).toContainEqual(['a', 'b', 'a']);
+  });
+
+  it('detects a self cycle', () => {
+    const registry = makeRegistry([manifest('a', { a: '^1.0.0' })]);
+    const deps = createDepsService();
+    const cycles = deps.detectCycles('a', registry);
+    expect(cycles).toContainEqual(['a', 'a']);
+  });
+});
+
+describe('DepsService.hasCircularDependency', () => {
+  it('is true when a cycle exists', () => {
+    const registry = makeRegistry([
+      manifest('a', { b: '^1.0.0' }),
+      manifest('b', { a: '^1.0.0' }),
+    ]);
+    const deps = createDepsService();
+    expect(deps.hasCircularDependency('a', registry)).toBe(true);
+  });
+
+  it('is false for an acyclic graph', () => {
+    const registry = makeRegistry([
+      manifest('a', { b: '^1.0.0' }),
+      manifest('b'),
+    ]);
+    const deps = createDepsService();
+    expect(deps.hasCircularDependency('a', registry)).toBe(false);
+  });
+});
+
+describe('DepsService.topologicalSort', () => {
+  it('orders dependencies before dependents and includes the root', () => {
+    const registry = makeRegistry([
+      manifest('a', { b: '^1.0.0', c: '^1.0.0' }),
+      manifest('b', { d: '^1.0.0' }),
+      manifest('c', { d: '^1.0.0' }),
+      manifest('d'),
+    ]);
+    const deps = createDepsService();
+    const order = deps.topologicalSort('a', registry);
+
+    expect(order).toContain('a');
+    expect(order).toContain('d');
+    const idx = (n: string) => order.indexOf(n);
+    expect(idx('d')).toBeLessThan(idx('b'));
+    expect(idx('d')).toBeLessThan(idx('c'));
+    expect(idx('b')).toBeLessThan(idx('a'));
+    expect(idx('c')).toBeLessThan(idx('a'));
+    expect(new Set(order).size).toBe(order.length);
+  });
+
+  it('does not infinite-loop on a cycle', () => {
+    const registry = makeRegistry([
+      manifest('a', { b: '^1.0.0' }),
+      manifest('b', { a: '^1.0.0' }),
+    ]);
+    const deps = createDepsService();
+    const order = deps.topologicalSort('a', registry);
+    expect(order).toContain('a');
+    expect(order).toContain('b');
+    expect(new Set(order).size).toBe(order.length);
+  });
+});
+
+describe('DepsService.flattenDependencies', () => {
+  it('returns unique transitive deps excluding the root', () => {
+    const registry = makeRegistry([
+      manifest('a', { b: '^1.0.0', c: '^1.0.0' }),
+      manifest('b', { d: '^1.0.0' }),
+      manifest('c', { d: '^1.0.0' }),
+      manifest('d'),
+    ]);
+    const deps = createDepsService();
+    const flat = deps.flattenDependencies('a', registry);
+    expect(flat.sort()).toEqual(['b', 'c', 'd']);
+    expect(flat).not.toContain('a');
+  });
+
+  it('is cycle-safe and excludes the root', () => {
+    const registry = makeRegistry([
+      manifest('a', { b: '^1.0.0' }),
+      manifest('b', { a: '^1.0.0' }),
+    ]);
+    const deps = createDepsService();
+    const flat = deps.flattenDependencies('a', registry);
+    expect(flat).toEqual(['b']);
+  });
+
+  it('returns empty for a leaf plugin', () => {
+    const registry = makeRegistry([manifest('a')]);
+    const deps = createDepsService();
+    expect(deps.flattenDependencies('a', registry)).toEqual([]);
+  });
+});
