+import { describe, it, expect } from 'vitest';
+import { createMarketplace } from './index.js';
+import type { PluginManifest } from './types.js';
+
+function manifest(overrides: Partial<PluginManifest> = {}): PluginManifest {
+  return {
+    name: 'demo',
+    version: '1.0.0',
+    description: 'a demo plugin',
+    author: 'tester',
+    dependencies: {},
+    entryPoint: '1 + 1',
+    permissions: [],
+    ...overrides,
+  };
+}
+
+describe('createMarketplace', () => {
+  it('exposes all five capabilities', () => {
+    const mp = createMarketplace();
+    expect(mp.registry).toBeDefined();
+    expect(mp.resolver).toBeDefined();
+    expect(mp.runner).toBeDefined();
+    expect(mp.reviews).toBeDefined();
+    expect(mp.deps).toBeDefined();
+  });
+
+  it('installs a simple plugin and runs its entry point', async () => {
+    const mp = createMarketplace();
+    const result = await mp.installPlugin(manifest({ entryPoint: '40 + 2' }));
+    expect(result.execution.success).toBe(true);
+    expect(result.execution.output).toBe(42);
+    expect(mp.registry.getVersion('demo', '1.0.0')).not.toBeNull();
+  });
+
+  it('rejects manifests missing required fields', async () => {
+    const mp = createMarketplace();
+    await expect(
+      mp.installPlugin(manifest({ name: '' })),
+    ).rejects.toThrow(/name/);
+    await expect(
+      mp.installPlugin(manifest({ entryPoint: '' })),
+    ).rejects.toThrow(/entryPoint/);
+  });
+
+  it('resolves dependency versions against the registry', async () => {
+    const mp = createMarketplace();
+    mp.registry.register(manifest({ name: 'lib', version: '1.2.0' }));
+    mp.registry.register(manifest({ name: 'lib', version: '1.5.0' }));
+    const result = await mp.installPlugin(
+      manifest({ name: 'app', dependencies: { lib: '^1.0.0' } }),
+    );
+    const lib = result.resolved.find((r) => r.name === 'lib');
+    expect(lib?.version).toBe('1.5.0');
+  });
+
+  it('rejects plugins with circular dependencies', async () => {
+    const mp = createMarketplace();
+    mp.registry.register(manifest({ name: 'a', dependencies: { b: '^1.0.0' } }));
+    mp.registry.register(manifest({ name: 'b', dependencies: { a: '^1.0.0' } }));
+    await expect(
+      mp.installPlugin(manifest({ name: 'a', dependencies: { b: '^1.0.0' } })),
+    ).rejects.toThrow(/circular/i);
+  });
+});
