+import { createRunner } from './runner.js';
+
+describe('RunnerService', () => {
+  it('evaluates a simple expression and returns the value', async () => {
+    const runner = createRunner();
+    const result = await runner.execute('1 + 2');
+    expect(result.success).toBe(true);
+    expect(result.output).toBe(3);
+    expect(result.error).toBeUndefined();
+    expect(typeof result.duration).toBe('number');
+    expect(result.duration).toBeGreaterThanOrEqual(0);
+    expect(result.memoryUsed).toBeGreaterThanOrEqual(0);
+  });
+
+  it('passes context variables as sandbox globals', async () => {
+    const runner = createRunner();
+    const result = await runner.execute('x * y', { x: 6, y: 7 });
+    expect(result.success).toBe(true);
