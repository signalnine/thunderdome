throw new Error('Invalid manifest: missing required field \"entryPoint\"');\n    }\n\n    // 2. Register the plugin in the catalog.\n    registry.register(manifest);\n\n    // 3. Resolve dependency versions against what is available in the registry.\n    const dependencies = manifest.dependencies ?? {};\n    const constraints: VersionConstraint[] = Object.entries(dependencies).map(\n      ([name, range]) => ({ name, range }),\n    );\n    const available: Record<string, string[]> = {};\n    for (const { name } of constraints) {\n      available[name] = registry.listVersions(name);\n    }\n    const resolved = resolver.resolve(constraints, available);\n\n    // 4. Reject if there is a circular dependency.\n    if (deps.hasCircularDependency(manifest.name, registry)) {\n      throw new Error(\n        `Cannot install \"${manifest.name}\": circular dependency detected`,\n      );\n    }\n\n    // 5. Execute the plugin's entry point in the sandbox.\n    const execution = await runner.execute(manifest.entryPoint);\n\n    // 6. Return the resolved dependency versions and sandbox execution result.\n    return { manifest, resolved, execution };\n  }\n\n  return { registry, resolver, runner, reviews, deps, installPlugin };\n}\n\nexport type {\n  PluginManifest,\n  VersionConstraint,\n  ResolvedVersion,\n  Review,\n  DependencyNode,\n  SandboxResult,\n  RegistryService,\n  ResolverService,\n  RunnerService,\n  ReviewService,\n  DepsService,\n} from './types.js';\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":668,"cache_read_input_tokens":33670,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":668},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ce3a8e9b-ec25-43f5-a87a-fb4762a666b1","uuid":"972de6bd-2932-46a3-8a71-aa0f2dbd8591","request_i