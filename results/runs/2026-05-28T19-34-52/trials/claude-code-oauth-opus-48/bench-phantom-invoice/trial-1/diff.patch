+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015q8KLXNCgaYk9kCU4hJeJ1","type":"tool_result","content":"===== src/services/reporting.ts =====\n     1\timport type Database from 'better-sqlite3';\n     2\timport type { Invoice, InvoiceSummary, CustomerReport } from '../models/invoice.js';\n     3\t\n     4\t/**\n     5\t * Generate a monthly revenue report for a given year.\n     6\t * Groups invoices by their UTC month and aggregates totals.\n     7\t */\n     8\texport function getMonthlyReport(\n     9\t  db: Database.Database,\n    10\t  year: number,\n    11\t): InvoiceSummary[] {\n    12\t  const startDate = `${year}-01-01`;\n    13\t  const endDate = `${year}-12-31`;\n    14\t\n    15\t  const stmt = db.prepare(`\n    16\t    SELECT * FROM invoices\n    17\t    WHERE date >= ? AND date <= ?\n    18\t    ORDER BY date ASC\n    19\t  `);\n    20\t\n    21\t  const invoices = stmt.all(startDate, endDate) as Invoice[];\n    22\t\n    23\t  // Group invoices by month\n    24\t  const monthlyMap = new Map<number, { count: number; total: number }>();\n    25\t\n    26\t  for (const inv of invoices) {\n    27\t    const d = new Date(inv.date + 'T00:00:00Z');\n    28\t    const month = d.getMonth() + 1; // 1-indexed\n    29\t\n    30\t    const current = monthlyMap.get(month) || { count: 0, total: 0 };\n    31\t    current.count += 1;\n    32\t    current.total += inv.total;\n    33\t    monthlyMap.set(month, current);\n    34\t  }\n    35\t\n    36\t  // Convert to array of summaries\n    37\t  const summaries: InvoiceSummary[] = [];\n    38\t  for (const [month, data] of monthlyMap) {\n    39\t    summaries.push({\n    40\t      month,\n    41\t      year,\n    42\t      count: data.count,\n    43\t      total_revenue: Math.round(data.total * 100) / 100,\n    44\t    });\n    45\t  }\n    46\t\n    47\t  return summaries.sort((a, b) => a.month - b.month);\n    48\t}\n    49\t\n    50\t/**\n    51\t * Generate a report for a specific customer.\n    52\t */\n    53\texport function getCustomerReport(\n    54\t  db: Database.Database,\n    55\t  customerId: string,\n    56\t): CustomerReport {\n    57\t  const stmt = db.prepare(`\n    58\t    SELECT * FROM invoices\n    59\t    WHERE customer_id = ?\n    60\t  `);\n    61\t\n    62\t  const invoices = stmt.all(customerId) as Invoice[];\n    63\t\n    64\t  const totalSpent = invoices.reduce((sum, inv) => sum + inv.total, 0);\n    65\t\n    66\t  return {\n    67\t    customer_id: customerId,\n    68\t    invoice_count: invoices.length,\n    69\t    total_spent: Math.round(totalSpent * 100) / 100,\n    70\t    average_invoice: invoices.length > 0\n    71\t      ? Math.round((totalSpent / invoices.length) * 100) / 100\n    72\t      : 0,\n    73\t  };\n    74\t}\n    75\t\n    76\t/**\n    77\t * Get total revenue for a date period.\n    78\t */\n    79\texport function getRevenueByPeriod(\n    80\t  db: Database.Database,\n    81\t  start: string,\n    82\t  end: string,\n    83\t): { total: number; count: number } {\n    84\t  const stmt = db.prepare(`\n    85\t    SELECT COALESCE(SUM(total), 0) as total, COUNT(*) as count\n    86\t    FROM invoices\n    87\t    WHERE date >= ? AND date <= ?\n    88\t  `);\n    89\t\n    90\t  const result = stmt.get(start, end) as { total: number; count: number };\n    91\t  return {\n    92\t    total: Math.round(result.total * 100) / 100,\n    93\t    count: result.count,\n    94\t  };\n    95\t}\n===== src/services/billing.ts =====\n     1\timport type Database from 'better-sqlite3';\n     2\timport type { InvoiceCreateInput, Invoice, LineItem } from '../models/invoice.js';\n     3\timport { createInvoice } from '../db/queries.js';\n     4\t\n     5\t/**\n     6\t * Calculate the total for an invoice given subtotal, discount rate, and tax rate.\n     7\t *\n     8\t * Formula: subtotal * (1 - discountRate) * (1 + taxRate)\n     9\t *   - First apply the discount to get the discounted subtotal\n    10\t *   - Then apply tax on the discounted amount\n    11\t */\n    12\texport function calculateInvoiceTotal(\n    13\t  subtotal: number,\n    14\t  discountRate: number,\n    15\t  taxRate: number,\n    16\t): number {\n    17\t  const discounted = subtotal * (1 - discountRate);\n    18\t  const total = discounted + subtotal * taxRate;\n    19\t  return Math.round(total * 100) / 100;\n    20\t}\n    21\t\n    22\t/**\n    23\t * Apply a discount to a subtotal.\n    24\t */\n    25\texport function applyDiscount(subtotal: number, discountRate: number): number {\n    26\t  return Math.round(subtotal * (1 - discountRate) * 100) / 100;\n    27\t}\n    28\t\n    29\t/**\n    30\t * Calculate subtotal from line items.\n    31\t */\n    32\texport function calculateSubtotal(lineItems: LineItem[]): number {\n    33\t  return lineItems.reduce((sum, item) => sum + item.quantity * item.unit_price, 0);\n    34\t}\n    35\t\n    36\t/**\n    37\t * Generate an invoice from input data, calculating subtotal and total.\n    38\t */\n    39\texport function generateInvoice(\n    40\t  db: Database.Database,\n    41\t  input: InvoiceCreateInput,\n    42\t): number {\n    43\t  const subtotal = calculateSubtotal(input.line_items);\n    44\t  const total = calculateInvoiceTotal(subtotal, input.discount_rate, input.tax_rate);\n    45\t\n    46\t  const invoice: Invoice & { line_items: LineItem[] } = {\n    47\t    customer_id: input.customer_id,\n    48\t    date: input.date,\n    49\t    subtotal,\n    50\t    discount_rate: input.discount_rate,\n    51\t    tax_rate: input.tax_rate,\n    52\t    total,\n    53\t    status: input.status || 'draft',\n    54\t    line_items: input.line_items,\n    55\t  };\n    56\t\n    57\t  return createInvoice(db, invoice);\n    58\t}\n===== src/db/connection.ts =====\n     1\timport Database from 'better-sqlite3';\n     2\t\n     3\texport function createDatabase(filename: string = ':memory:'): Database.Database {\n     4\t  const db = new Database(filename);\n     5\t\n     6\t  db.pragma('journal_mode = WAL');\n     7\t\n     8\t  db.exec(`\n     9\t    CREATE TABLE IF NOT EXISTS invoices (\n    10\t      id INTEGER PRIMARY KEY AUTOINCREMENT,\n    11\t      customer_id TEXT NOT NULL,\n    12\t      date TEXT NOT NULL,\n    13\t      subtotal REAL NOT NULL,\n    14\t      discount_rate REAL NOT NULL DEFAULT 0,\n    15\t      tax_rate REAL NOT NULL DEFAULT 0,\n    16\t      total REAL NOT NULL,\n    17\t      status TEXT NOT NULL DEFAULT 'draft'\n    18\t    );\n    19\t\n    20\t    CREATE TABLE IF NOT EXISTS line_items (\n    21\t      id INTEGER PRIMARY KEY AUTOINCREMENT,\n    22\t      invoice_id INTEGER NOT NULL,\n    23\t      description TEXT NOT NULL,\n    24\t      quantity INTEGER NOT NULL,\n    25\t      unit_price REAL NOT NULL,\n    26\t      FOREIGN KEY (invoice_id) REFERENCES invoices(id)\n    27\t    );\n    28\t  `);\n    29\t\n    30\t  return db;\n    31\t}\n===== src/db/queries.ts =====\n     1\timport type Database from 'better-sqlite3';\n     2\timport type { Invoice, LineItem } from '../models/invoice.js';\n     3\t\n     4\t/**\n     5\t * Retrieve invoices within a date range (inclusive on both ends).\n     6\t */\n     7\texport function getInvoicesByDateRange(\n     8\t  db: Database.Database,\n     9\t  startDate: string,\n    10\t  endDate: string,\n    11\t): Invoice[] {\n    12\t  const stmt = db.prepare(`\n    13\t    SELECT * FROM invoices\n    14\t    WHERE date >= ? AND date < ?\n    15\t    ORDER BY date ASC\n    16\t  `);\n    17\t  return stmt.all(startDate, endDate) as Invoice[];\n    18\t}\n    19\t\n    20\t/**\n    21\t * Retrieve a single invoice by ID, including its line items.\n    22\t */\n    23\texport function getInvoiceById(\n    24\t  db: Database.Database,\n    25\t  id: number,\n    26\t): (Invoice & { line_items: LineItem[] }) | undefined {\n    27\t  const invoiceStmt = db.prepare('SELECT * FROM invoices WHERE id = ?');\n    28\t  const invoice = invoiceStmt.get(id) as 