nst app = express();\n    12\t  const db = createDatabase(dbPath);\n    13\t\n    14\t  app.use(express.json());\n    15\t\n    16\t  // List invoices by date range\n    17\t  app.get('/invoices', (req: Request, res: Response) => {\n    18\t    const { start, end } = req.query;\n    19\t    if (!start || !end) {\n    20\t      res.status(400).json({ error: 'start and end query parameters required' });\n    21\t      return;\n    22\t    }\n    23\t    const invoices = getInvoicesByDateRange(db, start as string, end as string);\n    24\t    res.json(invoices);\n    25\t  });\n    26\t\n    27\t  // Get invoice by ID\n    28\t  app.get('/invoices/:id', (req: Request, res: Response) => {\n    29\t    const id = parseInt(req.params.id, 10);\n    30\t    if (isNaN(id)) {\n    31\t      res.status(400).json({ error: 'Invalid invoice ID' });\n    32\t      return;\n    33\t    }\n    34\t    const invoice = getInvoiceById(db, id);\n    35\t    if (!invoice) {\n    36\t      res.status(404).json({ error: 'Invoice not found' });\n    37\t      return;\n    38\t    }\n    39\t    res.json(invoice);\n    40\t  });\n    41\t\n    42\t  // Create invoice\n    43\t  app.post('/invoices', (req: Request, res: Response) => {\n    44\t    const input = req.body as InvoiceCreateInput;\n    45\t    if (!input.customer_id || !input.date || !input.line_items?.length) {\n    46\t      res.status(400).json({ error: 'customer_id, date, and line_items required' });\n    47\t      return;\n    48\t    }\n    49\t    const id = generateInvoice(db, input);\n    50\t    const invoice = getInvoiceById(db, id);\n    51\t    res.status(201).json(invoice);\n    52\t  });\n    53\t\n    54\t  // Monthly report\n    55\t  app.get('/reports/monthly', (req: Request, res: Response) => {\n    56\t    const year = parseInt(req.query.year as string, 10);\n    57\t    if (isNaN(year)) {\n    58\t      res.status(400).json({ error: 'year query parameter required' });\n    59\t      return;\n    60\t    }\n   