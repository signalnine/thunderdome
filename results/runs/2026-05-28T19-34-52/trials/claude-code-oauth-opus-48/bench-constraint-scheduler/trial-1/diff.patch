ooms([['r1', 10]]), opts());\n    expect(res.assignments).toHaveLength(2);\n    expect(res.assignments.map((a) => a.eventId).sort()).toEqual(['y', 'z']);\n    expect(res.unscheduled).toEqual(['hog']);\n  });","originalFile":"import { describe, it, expect } from 'vitest';\nimport {\n  schedule,\n  createScheduler,\n  Scheduler,\n  type Event,\n  type Room,\n  type ScheduleOptions,\n  type Assignment,\n} from '../src/index.js';\n\nconst rooms = (specs: Array<[string, number]>): Room[] =>\n  specs.map(([id, capacity]) => ({ id, name: id, capacity }));\n\nconst opts = (overrides: Partial<ScheduleOptions> = {}): ScheduleOptions => ({\n  startTime: 540, // 9:00\n  endTime: 1020, // 17:00\n  gap: 15,\n  ...overrides,\n});\n\nconst byId = (assignments: Assignment[]): Map<string, Assignment> =>\n  new Map(assignments.map((a) => [a.eventId, a]));\n\ndescribe('basic scheduling', () => {\n  it('schedules a single event', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 60 }];\n    const res = schedule(events, rooms([['r1', 10]]), opts());\n    expect(res.unscheduled).toEqual([]);\n    expect(res.assignments).toHaveLength(1);\n    const a = res.assignments[0];\n    expect(a.eventId).toBe('a');\n    expect(a.roomId).toBe('r1');\n    expect(a.endTime - a.startTime).toBe(60);\n    expect(a.startTime).toBeGreaterThanOrEqual(540);\n    expect(a.endTime).toBeLessThanOrEqual(1020);\n  });\n\n  it('schedules multiple events into one room respecting the gap', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60 },\n    ];\n    const res = schedule(events, rooms([['r1', 10]]), opts({ gap: 15 }));\n    expect(res.unscheduled).toEqual([]);\n    const m = byId(res.assignments);\n    const a = m.get('a')!;\n    const b = m.get('b')!;\n    const [first, second] = a.startTime <= b.startTime ? [a, b] : [b, a];\n    expect(second.startTime - first.endTime).toBeGreaterThanOrEqual(15);\n  });\n\n  it('uses multiple rooms in parallel when available', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 480 },\n      { id: 'b', name: 'B', duration: 480 },\n    ];\n    const res = schedule(events, rooms([['r1', 10], ['r2', 10]]), opts());\n    expect(res.unscheduled).toEqual([]);\n    const m = byId(res.assignments);\n    expect(m.get('a')!.roomId).not.toBe(m.get('b')!.roomId);\n  });\n});\n\ndescribe('room capacity', () => {\n  it('does not place an event in a room that is too small', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 60, attendees: 50 }];\n    const res = schedule(events, rooms([['small', 10], ['big', 100]]), opts());\n    expect(res.assignments[0].roomId).toBe('big');\n  });\n\n  it('marks an event unscheduled when no room is large enough', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 60, attendees: 200 }];\n    const res = schedule(events, rooms([['r1', 10]]), opts());\n    expect(res.unscheduled).toEqual(['a']);\n    expect(res.assignments).toEqual([]);\n  });\n\n  it('treats missing attendees as 1', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 60 }];\n    const res = schedule(events, rooms([['r1', 1]]), opts());\n    expect(res.assignments).toHaveLength(1);\n  });\n});\n\ndescribe('time window', () => {\n  it('keeps all events within the window', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 120 },\n      { id: 'b', name: 'B', duration: 120 },\n      { id: 'c', name: 'C', duration: 120 },\n    ];\n    const res = schedule(events, rooms([['r1', 10]]), opts({ startTime: 600, endTime: 1000 }));\n    for (const a of res.assignments) {\n      expect(a.startTime).toBeGreaterThanOrEqual(600);\n      expect(a.endTime).toBeLessThanOrEqual(1000);\n    }\n  });\n\n  it('marks an event unscheduled when it cannot fit in the window', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 600 }];\n    const res = schedule(events, rooms([['r1', 10]]), opts({ startTime: 540, endTime: 1020 }));\n    expect(res.unscheduled).toEqual(['a']);\n  });\n});\n\ndescribe('room gap', () => {\n  it('defaults the gap to 15 minutes', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60 },\n    ];\n    const res = schedule(events, rooms([['r1', 10]]), {\n      startTime: 540,\n      endTime: 720,\n    });\n    const m = byId(res.assignments);\n    const a = m.get('a')!;\n    const b = m.get('b')!;\n    const [first, second] = a.startTime <= b.startTime ? [a, b] : [b, a];\n    expect(second.startTime - first.endTime).toBeGreaterThanOrEqual(15);\n  });\n\n  it('respects a custom gap', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60 },\n    ];\n    const res = schedule(events, rooms([['r1', 10]]), opts({ gap: 30 }));\n    const m = byId(res.assignments);\n    const a = m.get('a')!;\n    const b = m.get('b')!;\n    const gap = Math.abs(\n      a.startTime <= b.startTime ? b.startTime - a.endTime : a.startTime - b.endTime,\n    );\n    expect(gap).toBeGreaterThanOrEqual(30);\n  });\n});\n\ndescribe('prerequisites', () => {\n  it('orders a prerequisite before its dependent with a gap', () => {\n    const events: Event[] = [\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n      { id: 'a', name: 'A', duration: 60 },\n    ];\n    const res = schedule(events, rooms([['r1', 10], ['r2', 10]]), opts({ gap: 15 }));\n    expect(res.unscheduled).toEqual([]);\n    const m = byId(res.assignments);\n    expect(m.get('a')!.endTime + 15).toBeLessThanOrEqual(m.get('b')!.startTime);\n  });\n\n  it('applies the prerequisite gap even across different rooms', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60 },\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n    ];\n    const res = schedule(events, rooms([['r1', 10], ['r2', 10]]), opts({ gap: 20 }));\n    const m = byId(res.assignments);\n    expect(m.get('b')!.startTime - m.get('a')!.endTime).toBeGreaterThanOrEqual(20);\n  });\n\n  it('handles a prerequisite chain', () => {\n    const events: Event[] = [\n      { id: 'c', name: 'C', duration: 60, prerequisites: ['b'] },\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n      { id: 'a', name: 'A', duration: 60 },\n    ];\n    const res = schedule(events, rooms([['r1', 10]]), opts());\n    expect(res.unscheduled).toEqual([]);\n    const m = byId(res.assignments);\n    expect(m.get('a')!.endTime).toBeLessThanOrEqual(m.get('b')!.startTime);\n    expect(m.get('b')!.endTime).toBeLessThanOrEqual(m.get('c')!.startTime);\n  });\n\n  it('leaves a dependent unscheduled when its prerequisite cannot be placed', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, attendees: 999 }, // never fits\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n    ];\n    const res = schedule(events, rooms([['r1', 10]]), opts());\n    expect(res.unscheduled.sort()).toEqual(['a', 'b']);\n  });\n\n  it('leaves a dependent unscheduled when its prerequisite is unknown', () => {\n    const events: Event[] = [\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['ghost'] },\n    ];\n    const res = schedule(events, rooms([['r1', 10]]), opts());\n    expect(res.unscheduled).toEqual(['b']);\n  });\n});\n\ndescribe('preferred room', () => {\n  it('honors a preferred room when feasible', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, preferredRoom: 'r2' },\n    ];\n    const res = schedule(events, rooms([['r1', 10], ['r2', 10]]), opts());\n    expect(res.assignments[0].roomId).toBe('r2');\n  });\n\n  it('falls back to another room when the preferred one cannot be used', () => {\n    const events: Event[] = [\n      // Fills r1 for the whole window.\n      { id: 'block', name: 'Block', duration: 480, preferredRoom: 'r1' },\n      { id: 'a', name: 'A', duration: 480, preferredRoom: 'r1' },\n    ];\n    const res = schedule(events, rooms([['r1', 10], ['r2', 10]]), opts());\n    expect(res.unscheduled).toEqual([]);\n    const m = byId(res.assignments);\n    expect(new Set([m.get('block')!.roomId, m.get('a')!.roomId])).toEqual(\n      new Set(['r1', 'r2']),\n    );\n  });\n\n  it('prefers placement count over honoring a preference', () => {\n    // Two events both prefer r1 but only one fits there for the full window;\n    // the other must move to r2 rather than be dropped.\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 480, preferredRoom: 'r1' },\n      { id: 'b', name: 'B', duration: 480, preferredRoom: 'r1' },\n    ];\n    const res = schedule(events, rooms([['r1', 10], ['r2', 10]]), opts());\n    expect(res.unscheduled).toEqual([]);\n  });\n});\n\ndescribe('prerequisite cycles', () => {\n  it('throws on a direct cycle', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, prerequisites: ['b'] },\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n    ];\n    expect(() => schedule(events, rooms([['r1', 10]]), opts())).toThrow();\n  });\n\n  it('throws on a self-reference', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, prerequisites: ['a'] },\n    ];\n    expect(() => schedule(events, rooms([['r1', 10]]), opts())).toThrow();\n  });\n\n  it('throws on an indirect cycle', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 60, prerequisites: ['c'] },\n      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 60, prerequisites: ['b'] },\n    ];\n    expect(() => schedule(events, rooms([['r1', 10]]), opts())).toThrow();\n  });\n});\n\ndescribe('batch optimization (maximization)', () => {\n  it('maximizes placements where naive ordering would fail', () => {\n    // r1 capacity 100, r2 capacity 5. A big event (80 people) can only go in\n    // r1. Two small events fit anywhere. Window only fits two 480-min events\n    // total across the two rooms... arrange so greedy-by-input could waste r1.\n    const events: Event[] = [\n      { id: 'small1', name: 'S1', duration: 480, attendees: 3 },\n      { id: 'big', name: 'Big', duration: 480, attendees: 80 },\n      { id: 'small2', name: 'S2', duration: 480, attendees: 3 },\n    ];\n    // r1 holds the big one, r2 holds one small one; the other small is dropped.\n    const res = schedule(events, rooms([['r1', 100], ['r2', 5]]), opts());\n    // Big must be scheduled (only r1 fits it); exactly 2 events fit.\n    expect(res.assignments.map((a) => a.eventId)).toContain('big');\n    expect(res.assignments).toHaveLength(2);\n    expect(res.unscheduled).toHaveLength(1);\n  });\n\n  it('schedules as many as possible and reports the rest', () => {\n    const events: Event[] = Array.from({ length: 5 }, (_, i) => ({\n      id: `e${i}`,\n      name: `E${i}`,\n      duration: 200,\n    }));\n    // Window 540..1020 = 480 min. Per room: 200 + 15 + 200 = 415 fits two.\n    const res = schedule(events, rooms([['r1', 10]]), opts());\n    expect(res.assignments).toHaveLength(2);\n    expect(res.unscheduled).toHaveLength(3);\n  });\n\n  it('produces a valid, non-overlapping schedule under load', () => {\n    const events: Event[] = Array.from({ length: 8 }, (_, i) => ({\n      id: `e${i}`,\n      name: `E${i}`,\n      duration: 90,\n    }));\n    const res = schedule(events, rooms([['r1', 10], ['r2', 10]]), opts());\n    // Verify no overlaps within a room.\n    const perRoom = new Map<string, Assignment[]>();\n    for (const a of res.assignments) {\n      const list = perRoom.get(a.roomId) ?? [];\n      list.push(a);\n      perRoom.set(a.roomId, list);\n    }\n    for (const list of perRoom.values()) {\n      list.sort((x, y) => x.startTime - y.startTime);\n      for (let i = 1; i < list.length; i++) {\n        expect(list[i].startTime - list[i - 1].endTime).toBeGreaterThanOrEqual(15);\n      }\n    }\n  });\n});\n\ndescribe('edge cases', () => {\n  it('handles an empty event list', () => {\n    const res = schedule([], rooms([['r1', 10]]), opts());\n    expect(res).toEqual({ assignments: [], unscheduled: [] });\n  });\n\n  it('returns everything unscheduled when there are no rooms', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 60 }];\n    const res = schedule(events, [], opts());\n    expect(res.unscheduled).toEqual(['a']);\n  });\n});\n\ndescribe('factory and class APIs', () => {\n  it('works via createScheduler', () => {\n    const s = createScheduler(rooms([['r1', 10]]), opts());\n    const res = s.schedule([{ id: 'a', name: 'A', duration: 60 }]);\n    expect(res.assignments).toHaveLength(1);\n  });\n\n  it('works via the Scheduler class', () => {\n    const s = new Scheduler(rooms([['r1', 10]]), opts());\n    const res = s.schedule([{ id: 'a', name: 'A', duration: 60 }]);\n    expect(res.assignments).toHaveLength(1);\n  });\n});\n","structuredPatch":[{"oldStart":252,"oldLines":21,"newStart":252,"newLines":19,"lines":[" });"," "," describe('batch optimization (maximization)', () => {","-  it('maximizes placements where naive ordering would fail', () => {","-    // r1 capacity 100, r2 capacity 5. A big event (80 people) can only go in","-    // r1. Two small events fit anywhere. Window only fits two 480-min events","-    // total across the two rooms... arrange so greedy-by-input could waste r1.","+  it('maximizes placements where naive in-order placement would fail', () => {","+    // One room, 480-min window. Placing the day-filling event first (as a","+    // naive greedy would, following input order) yields only 1 placement.","+    // The optimum skips it and fits the two shorter events => 2 placements.","     const events: Event[] = [","-      { id: 'small1', name: 'S1', duration: 480, attendees: 3 },","-      { id: 'big', name: 'Big', duration: 480, attendees: 8