@@ -0,0 +1,297 @@
+/**
+ * Constraint-based event scheduler.
+ *
+ * Assigns events to rooms within a time window while respecting:
+ *   - room capacity vs. event attendees
+ *   - the global [startTime, endTime] window
+ *   - a minimum gap between events sharing a room
+ *   - prerequisite ordering (a prerequisite must finish, plus a gap, before
+ *     its dependent may start)
+ *   - preferred-room hints (honored when it does not cost a placement)
+ *
+ * Scheduling is performed as a single batch and the number of successfully
+ * placed events is maximized via depth-first branch-and-bound search.
+ */
+
+export interface Event {
+  id: string;
+  name: string;
+  duration: number;
+  attendees?: number;
+  prerequisites?: string[];
+  preferredRoom?: string;
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number;
+}
+
+export interface ScheduleOptions {
+  startTime: number;
+  endTime: number;
+  gap?: number;
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[];
+}
+
+const DEFAULT_GAP = 15;
+
+interface Interval {
+  start: number;
+  end: number;
+}
+
+/** A candidate placement of an event: a room and the start time within it. */
+interface Placement {
+  roomId: string;
+  start: number;
+  preferred: boolean;
+}
+
+/**
+ * Detect a cycle in the prerequisite graph (including self-references) and
+ * return events in a topological order (every prerequisite precedes the
+ * events that depend on it). Prerequisite IDs that do not correspond to a
+ * known event are ignored for ordering purposes — such events simply can
+ * never satisfy their prerequisites and end up unscheduled.
+ */
+function topologicalOrder(events: Event[]): Event[] {
+  const byId = new Map<string, Event>();
+  for (const e of events) byId.set(e.id, e);
+
+  const WHITE = 0;
+  const GRAY = 1;
+  const BLACK = 2;
+  const color = new Map<string, number>();
+  for (const e of events) color.set(e.id, WHITE);
+
+  const order: Event[] = [];
+
+  const visit = (event: Event): void => {
+    color.set(event.id, GRAY);
+    for (const prereqId of event.prerequisites ?? []) {
+      if (prereqId === event.id) {
+        throw new Error(`Prerequisite cycle detected involving event "${event.id}"`);
+      }
+      const prereq = byId.get(prereqId);
+      if (!prereq) continue; // unknown prerequisite — not a cycle
+      const c = color.get(prereqId);
+      if (c === GRAY) {
+        throw new Error(`Prerequisite cycle detected involving event "${prereqId}"`);
+      }
+      if (c === WHITE) visit(prereq);
+    }
+    color.set(event.id, BLACK);
+    order.push(event);
+  };
+
+  for (const e of events) {
+    if (color.get(e.id) === WHITE) visit(e);
+  }
+  return order;
+}
+
+/**
+ * Find the earliest feasible start time for an event of `duration` minutes in
+ * `room`, no earlier than `earliest`, given the room's already-placed
+ * intervals. Returns null when no slot fits inside the time window.
+ */
+function earliestSlot(
+  intervals: Interval[],
+  earliest: number,
+  duration: number,
+  endTime: number,
+  gap: number,
+): number | null {
+  // Candidate start times: the earliest allowed time, and just after every
+  // existing interval (respecting the gap). The earliest of these that fits
+  // without conflict is optimal.
+  const candidates = [earliest];
+  for (const iv of intervals) {
+    const after = iv.end + gap;
+    if (after >= earliest) candidates.push(after);
+  }
+  candidates.sort((a, b) => a - b);
+
+  for (const start of candidates) {
+    const end = start + duration;
+    if (start < earliest) continue;
+    if (end > endTime) continue; // and every later candidate is also too late
+    if (fits(intervals, start, end, gap)) return start;
+  }
+  return null;
+}
+
+/** True when [start, end] can coexist with all intervals given the gap. */
+function fits(intervals: Interval[], start: number, end: number, gap: number): boolean {
+  for (const iv of intervals) {
+    const before = end + gap <= iv.start;
+    const after = start >= iv.end + gap;
+    if (!before && !after) return false;
+  }
+  return true;
+}
+
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const { startTime, endTime } = options;
+  const gap = options.gap ?? DEFAULT_GAP;
+
+  // Validate the prerequisite graph and obtain a dependency-respecting order.
+  const order = topologicalOrder(events);
+  const n = order.length;
+
+  // Per-room working state: the intervals currently occupied.
+  const roomIntervals = new Map<string, Interval[]>();
+  for (const r of rooms) roomIntervals.set(r.id, []);
+
+  // Placement decisions for the current search path, keyed by event id.
+  const placed = new Map<string, Assignment>();
+
+  // Best solution found so far.
+  let bestAssignments: Assignment[] = [];
+  let bestCount = -1;
+  let bestPreferred = -1;
+
+  // Node budget guards against pathological blow-up; the greedy-quality first
+  // solution found is always retained.
+  let nodeBudget = 500_000;
+
+  const attendeesOf = (e: Event): number => e.attendees ?? 1;
+
+  /** Compute candidate placements for `event`, preferred room slot first. */
+  const candidatePlacements = (event: Event): Placement[] => {
+    // Earliest start permitted by prerequisites and the window.
+    let earliest = startTime;
+    for (const p of event.prerequisites ?? []) {
+      const a = placed.get(p);
+      if (!a) return []; // prerequisite not placed -> cannot place this event
+      earliest = Math.max(earliest, a.endTime + gap);
+    }
+
+    const need = attendeesOf(event);
+    const placements: Placement[] = [];
+    for (const room of rooms) {
+      if (room.capacity < need) continue;
+      const slot = earliestSlot(
+        roomIntervals.get(room.id)!,
+        earliest,
+        event.duration,
+        endTime,
+        gap,
+      );
+      if (slot === null) continue;
+      placements.push({
+        roomId: room.id,
+        start: slot,
+        preferred: event.preferredRoom === room.id,
+      });
+    }
+
+    // Try the preferred room first, then by earliest start time. This makes
+    // the first full solution honor preferences and pack tightly.
+    placements.sort((x, y) => {
+      if (x.preferred !== y.preferred) return x.preferred ? -1 : 1;
+      return x.start - y.start;
+    });
+    return placements;
+  };
+
+  const recordIfBest = (): void => {
+    const count = placed.size;
+    if (count < bestCount) return;
+    let preferredCount = 0;
+    for (const a of placed.values()) {
+      const ev = events.find((e) => e.id === a.eventId);
+      if (ev?.preferredRoom === a.roomId) preferredCount++;
+    }
+    if (count > bestCount || preferredCount > bestPreferred) {
+      bestCount = count;
+      bestPreferred = preferredCount;
+      bestAssignments = [...placed.values()].map((a) => ({ ...a }));
+    }
+  };
+
+  const search = (i: number): void => {
+    if (nodeBudget <= 0) return;
+    nodeBudget--;
+
+    // Branch-and-bound: even placing every remaining event cannot beat the
+    // current best, so prune.
+    if (placed.size + (n - i) < bestCount) return;
+
+    if (i === n) {
+      recordIfBest();
+      return;
+    }
+
+    const event = order[i];
+
+    // Option A: place the event (preferred room first, then earliest slot).
+    const placements = candidatePlacements(event);
+    for (const pl of placements) {
+      const assignment: Assignment = {
+        eventId: event.id,
+        roomId: pl.roomId,
+        startTime: pl.start,
+        endTime: pl.start + event.duration,
+      };
+      const intervals = roomIntervals.get(pl.roomId)!;
+      intervals.push({ start: assignment.startTime, end: assignment.endTime });
+      placed.set(event.id, assignment);
+
+      search(i + 1);
+
+      placed.delete(event.id);
+      intervals.pop();
+      if (nodeBudget <= 0) return;
+    }
+
+    // Option B: skip the event (leave it unscheduled).
+    search(i + 1);
+  };
+
+  search(0);
+
+  const scheduledIds = new Set(bestAssignments.map((a) => a.eventId));
+  const unscheduled = events.filter((e) => !scheduledIds.has(e.id)).map((e) => e.id);
+
+  // Stable, readable ordering of the output.
+  bestAssignments.sort((a, b) =>
+    a.startTime - b.startTime || a.roomId.localeCompare(b.roomId),
+  );
+
+  return { assignments: bestAssignments, unscheduled };
+}
+
+export class Scheduler {
+  constructor(
+    private readonly rooms: Room[],
+    private readonly options: ScheduleOptions,
+  ) {}
+
+  schedule(events: Event[]): ScheduleResult {
+    return schedule(events, this.rooms, this.options);
+  }
+}
+
+export function createScheduler(rooms: Room[], options: ScheduleOptions): Scheduler {
+  return new Scheduler(rooms, options);
+}
+
+export default schedule;
