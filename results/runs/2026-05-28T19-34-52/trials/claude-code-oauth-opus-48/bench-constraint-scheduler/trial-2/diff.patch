diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..b3eb5fd
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,33 @@
+import { schedule } from './scheduler.js';
+import type {
+  Event,
+  Room,
+  ScheduleOptions,
+  ScheduleResult,
+  Assignment,
+} from './scheduler.js';
+
+export { schedule };
+export default schedule;
+export type { Event, Room, ScheduleOptions, ScheduleResult, Assignment };
+
+/**
+ * Class-based wrapper around {@link schedule} for callers that prefer an
+ * object-oriented entry point.
+ */
+export class Scheduler {
+  schedule(
+    events: Event[],
+    rooms: Room[],
+    options: ScheduleOptions,
+  ): ScheduleResult {
+    return schedule(events, rooms, options);
+  }
+}
+
+/**
+ * Factory returning an object exposing the {@link schedule} function.
+ */
+export function createScheduler(): Scheduler {
+  return new Scheduler();
+}
diff --git a/src/scheduler.test.ts b/src/scheduler.test.ts
new file mode 100644
index 0000000..cfac0d5
--- /dev/null
+++ b/src/scheduler.test.ts
@@ -0,0 +1,235 @@
+import { describe, it, expect } from 'vitest';
+import { schedule, Scheduler, createScheduler } from './index.js';
+import type { Event, Room, ScheduleOptions, ScheduleResult } from './index.js';
+
+const ROOMS: Room[] = [
+  { id: 'r1', name: 'Room 1', capacity: 10 },
+  { id: 'r2', name: 'Room 2', capacity: 50 },
+];
+
+const WINDOW: ScheduleOptions = { startTime: 540, endTime: 1020 }; // 9:00–17:00
+
+/** Validates a result against the core constraints. */
+function assertValid(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  result: ScheduleResult,
+): void {
+  const gap = options.gap ?? 15;
+  const byId = new Map(events.map((e) => [e.id, e]));
+  const roomById = new Map(rooms.map((r) => [r.id, r]));
+  const placed = new Map(result.assignments.map((a) => [a.eventId, a]));
+
+  // Every event accounted for exactly once.
+  const all = new Set([
+    ...result.assignments.map((a) => a.eventId),
+    ...result.unscheduled,
+  ]);
+  expect(all.size).toBe(events.length);
+  expect(result.assignments.length + result.unscheduled.length).toBe(
+    events.length,
+  );
+
+  for (const a of result.assignments) {
+    const event = byId.get(a.eventId)!;
+    const room = roomById.get(a.roomId)!;
+    // duration
+    expect(a.endTime - a.startTime).toBe(event.duration);
+    // window
+    expect(a.startTime).toBeGreaterThanOrEqual(options.startTime);
+    expect(a.endTime).toBeLessThanOrEqual(options.endTime);
+    // capacity
+    expect(event.attendees ?? 1).toBeLessThanOrEqual(room.capacity);
+    // prerequisites
+    for (const p of event.prerequisites ?? []) {
+      const pa = placed.get(p);
+      expect(pa, `prereq ${p} of ${a.eventId} must be scheduled`).toBeDefined();
+      expect(pa!.endTime + gap).toBeLessThanOrEqual(a.startTime);
+    }
+  }
+
+  // No overlap (with gap) within a room.
+  const byRoom = new Map<string, typeof result.assignments>();
+  for (const a of result.assignments) {
+    if (!byRoom.has(a.roomId)) byRoom.set(a.roomId, []);
+    byRoom.get(a.roomId)!.push(a);
+  }
+  for (const list of byRoom.values()) {
+    const sorted = [...list].sort((x, y) => x.startTime - y.startTime);
+    for (let i = 1; i < sorted.length; i++) {
+      expect(sorted[i].startTime).toBeGreaterThanOrEqual(
+        sorted[i - 1].endTime + gap,
+      );
+    }
+  }
+}
+
+describe('schedule', () => {
+  it('schedules a single event', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 60 }];
+    const result = schedule(events, ROOMS, WINDOW);
+    expect(result.unscheduled).toEqual([]);
+    expect(result.assignments).toHaveLength(1);
+    assertValid(events, ROOMS, WINDOW, result);
+  });
+
+  it('respects room capacity', () => {
+    const events: Event[] = [
+      { id: 'big', name: 'Big', duration: 60, attendees: 40 },
+    ];
+    const rooms: Room[] = [{ id: 'small', name: 'Small', capacity: 10 }];
+    const result = schedule(events, rooms, WINDOW);
+    expect(result.unscheduled).toContain('big');
+    expect(result.assignments).toHaveLength(0);
+  });
+
+  it('places a large event into a room with enough capacity', () => {
+    const events: Event[] = [
+      { id: 'big', name: 'Big', duration: 60, attendees: 40 },
+    ];
+    const result = schedule(events, ROOMS, WINDOW);
+    expect(result.unscheduled).toEqual([]);
+    expect(result.assignments[0].roomId).toBe('r2');
+  });
+
+  it('keeps events within the time window', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 600 }, // 10h > 8h window
+    ];
+    const result = schedule(events, ROOMS, WINDOW);
+    expect(result.unscheduled).toContain('a');
+  });
+
+  it('enforces gaps between events in the same room', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60 },
+      { id: 'b', name: 'B', duration: 60 },
+    ];
+    const rooms: Room[] = [{ id: 'r1', name: 'Room 1', capacity: 10 }];
+    const opts: ScheduleOptions = { startTime: 540, endTime: 720, gap: 30 };
+    const result = schedule(events, rooms, opts);
+    assertValid(events, rooms, opts, result);
+  });
+
+  it('respects prerequisites ordering with gap', () => {
+    const events: Event[] = [
+      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },
+      { id: 'a', name: 'A', duration: 60 },
+    ];
+    const result = schedule(events, ROOMS, WINDOW);
+    expect(result.unscheduled).toEqual([]);
+    const a = result.assignments.find((x) => x.eventId === 'a')!;
+    const b = result.assignments.find((x) => x.eventId === 'b')!;
+    expect(a.endTime + 15).toBeLessThanOrEqual(b.startTime);
+    assertValid(events, ROOMS, WINDOW, result);
+  });
+
+  it('does not schedule an event whose prerequisite cannot be scheduled', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60, attendees: 999 },
+      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },
+    ];
+    const result = schedule(events, ROOMS, WINDOW);
+    expect(result.unscheduled).toContain('a');
+    expect(result.unscheduled).toContain('b');
+  });
+
+  it('treats a missing prerequisite as unschedulable', () => {
+    const events: Event[] = [
+      { id: 'b', name: 'B', duration: 60, prerequisites: ['ghost'] },
+    ];
+    const result = schedule(events, ROOMS, WINDOW);
+    expect(result.unscheduled).toContain('b');
+  });
+
+  it('honors preferred room when possible', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60, preferredRoom: 'r2' },
+    ];
+    const result = schedule(events, ROOMS, WINDOW);
+    expect(result.assignments[0].roomId).toBe('r2');
+  });
+
+  it('ignores preferred room when it would prevent scheduling', () => {
+    const events: Event[] = [
+      // prefers small room but needs the big one
+      { id: 'a', name: 'A', duration: 60, attendees: 40, preferredRoom: 'r1' },
+    ];
+    const result = schedule(events, ROOMS, WINDOW);
+    expect(result.assignments[0].roomId).toBe('r2');
+  });
+
+  it('throws on a self-referential prerequisite', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60, prerequisites: ['a'] },
+    ];
+    expect(() => schedule(events, ROOMS, WINDOW)).toThrow();
+  });
+
+  it('throws on a prerequisite cycle', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60, prerequisites: ['c'] },
+      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },
+      { id: 'c', name: 'C', duration: 60, prerequisites: ['b'] },
+    ];
+    expect(() => schedule(events, ROOMS, WINDOW)).toThrow();
+  });
+
+  it('maximizes the number of scheduled events', () => {
+    // Three 3h events into a single 8h room: only 2 fit with 15m gaps
+    // (180 + 15 + 180 = 375 <= 480, third would need 570).
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 180 },
+      { id: 'b', name: 'B', duration: 180 },
+      { id: 'c', name: 'C', duration: 180 },
+    ];
+    const rooms: Room[] = [{ id: 'r', name: 'R', capacity: 10 }];
+    const result = schedule(events, rooms, WINDOW);
+    expect(result.assignments).toHaveLength(2);
+    expect(result.unscheduled).toHaveLength(1);
+    assertValid(events, rooms, WINDOW, result);
+  });
+
+  it('chooses placements that allow more events to fit', () => {
+    // A small-capacity room and a large one. A big event must take the large
+    // room; a tiny event could fit anywhere. The scheduler must place the big
+    // event in the large room so the tiny one can also be scheduled.
+    const events: Event[] = [
+      { id: 'big', name: 'Big', duration: 60, attendees: 40 },
+      { id: 'tiny', name: 'Tiny', duration: 60, attendees: 5 },
+    ];
+    const rooms: Room[] = [
+      { id: 'small', name: 'Small', capacity: 10 },
+      { id: 'large', name: 'Large', capacity: 50 },
+    ];
+    const opts: ScheduleOptions = { startTime: 540, endTime: 620 }; // only one slot each
+    const result = schedule(events, rooms, opts);
+    expect(result.unscheduled).toEqual([]);
+    assertValid(events, rooms, opts, result);
+  });
+
+  it('handles an empty event list', () => {
+    const result = schedule([], ROOMS, WINDOW);
+    expect(result).toEqual({ assignments: [], unscheduled: [] });
+  });
+
+  it('schedules a chain of prerequisites', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 60 },
+      { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },
+      { id: 'c', name: 'C', duration: 60, prerequisites: ['b'] },
+    ];
+    const result = schedule(events, ROOMS, WINDOW);
+    expect(result.unscheduled).toEqual([]);
+    assertValid(events, ROOMS, WINDOW, result);
+  });
+
+  it('works via the Scheduler class and factory', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 60 }];
+    const fromClass = new Scheduler().schedule(events, ROOMS, WINDOW);
+    const fromFactory = createScheduler().schedule(events, ROOMS, WINDOW);
+    expect(fromClass.assignments).toHaveLength(1);
+    expect(fromFactory.assignments).toHaveLength(1);
+  });
+});
diff --git a/src/scheduler.ts b/src/scheduler.ts
new file mode 100644
index 0000000..e30f85a
--- /dev/null
+++ b/src/scheduler.ts
@@ -0,0 +1,343 @@
+export interface Event {
+  id: string;
+  name: string;
+  duration: number; // in minutes
+  attendees?: number; // number of people attending (default: 1)
+  prerequisites?: string[]; // event IDs that must finish before this starts
+  preferredRoom?: string; // room ID preference (hint, not hard constraint)
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number; // max attendees
+}
+
+export interface ScheduleOptions {
+  startTime: number; // minutes from midnight (e.g., 540 = 9:00 AM)
+  endTime: number; // minutes from midnight (e.g., 1020 = 5:00 PM)
+  gap?: number; // minimum gap in minutes between events in same room (default: 15)
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number; // minutes from midnight
+  endTime: number; // minutes from midnight
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[]; // event IDs that could not be scheduled
+}
+
+interface Interval {
+  start: number;
+  end: number;
+}
+
+const DEFAULT_GAP = 15;
+const DEFAULT_ATTENDEES = 1;
+const MAX_ITERATIONS = 500_000;
+
+/**
+ * Detects cycles in the prerequisite graph (including self-references).
+ * Throws if a cycle is found. Only considers prerequisites that reference
+ * events present in the input.
+ */
+function detectCycles(events: Event[], byId: Map<string, Event>): void {
+  // 0 = unvisited, 1 = in progress, 2 = done
+  const state = new Map<string, number>();
+
+  const visit = (id: string, stack: string[]): void => {
+    const current = state.get(id) ?? 0;
+    if (current === 2) return;
+    if (current === 1) {
+      const cycleStart = stack.indexOf(id);
+      const cycle = stack.slice(cycleStart).concat(id).join(' -> ');
+      throw new Error(`Prerequisite cycle detected: ${cycle}`);
+    }
+    state.set(id, 1);
+    stack.push(id);
+    const event = byId.get(id);
+    if (event?.prerequisites) {
+      for (const prereq of event.prerequisites) {
+        // Only follow edges to events that actually exist; a missing
+        // prerequisite can't form a cycle but will still block scheduling.
+        if (byId.has(prereq)) {
+          visit(prereq, stack);
+        }
+      }
+    }
+    stack.pop();
+    state.set(id, 2);
+  };
+
+  for (const event of events) {
+    visit(event.id, []);
+  }
+}
+
+/**
+ * Produces an ordering in which every event appears after all of its
+ * (existing) prerequisites. Among events that are simultaneously available,
+ * the most constrained ones are emitted first to give the search a strong
+ * greedy baseline.
+ */
+function topologicalOrder(events: Event[], byId: Map<string, Event>): Event[] {
+  const indegree = new Map<string, number>();
+  const dependents = new Map<string, string[]>();
+  const descendantCount = new Map<string, number>();
+
+  for (const event of events) {
+    indegree.set(event.id, 0);
+    dependents.set(event.id, []);
+  }
+  for (const event of events) {
+    const prereqs = event.prerequisites ?? [];
+    for (const prereq of prereqs) {
+      if (byId.has(prereq)) {
+        indegree.set(event.id, (indegree.get(event.id) ?? 0) + 1);
+        dependents.get(prereq)!.push(event.id);
+      }
+    }
+  }
+
+  // Count transitive descendants so that events unblocking many others are
+  // prioritized.
+  const countDescendants = (id: string, seen: Set<string>): number => {
+    let total = 0;
+    for (const dep of dependents.get(id) ?? []) {
+      if (!seen.has(dep)) {
+        seen.add(dep);
+        total += 1 + countDescendants(dep, seen);
+      }
+    }
+    return total;
+  };
+  for (const event of events) {
+    descendantCount.set(event.id, countDescendants(event.id, new Set()));
+  }
+
+  const constraintRank = (event: Event): number => {
+    const attendees = event.attendees ?? DEFAULT_ATTENDEES;
+    const descendants = descendantCount.get(event.id) ?? 0;
+    // Higher means schedule earlier.
+    return descendants * 100000 + attendees * 1000 + event.duration;
+  };
+
+  const available = events.filter((e) => (indegree.get(e.id) ?? 0) === 0);
+  const order: Event[] = [];
+  const remaining = new Set(events.map((e) => e.id));
+
+  while (available.length > 0) {
+    available.sort((a, b) => constraintRank(b) - constraintRank(a));
+    const next = available.shift()!;
+    order.push(next);
+    remaining.delete(next.id);
+    for (const dep of dependents.get(next.id) ?? []) {
+      const deg = (indegree.get(dep) ?? 0) - 1;
+      indegree.set(dep, deg);
+      if (deg === 0) {
+        available.push(byId.get(dep)!);
+      }
+    }
+  }
+
+  // Any leftover (should not happen after cycle detection) appended as-is.
+  for (const event of events) {
+    if (remaining.has(event.id)) order.push(event);
+  }
+
+  return order;
+}
+
+/**
+ * Finds the earliest start time at which the event can be placed in the given
+ * room without violating the time window or gap constraints relative to the
+ * events already scheduled in that room. Returns null when no slot exists.
+ */
+function earliestFeasibleStart(
+  duration: number,
+  earliest: number,
+  intervals: Interval[],
+  gap: number,
+  windowEnd: number,
+): number | null {
+  let candidate = earliest;
+  // intervals are kept sorted by start time.
+  for (const interval of intervals) {
+    // Does the event fit entirely before this interval (with gap)?
+    if (candidate + duration + gap <= interval.start) {
+      if (candidate + duration <= windowEnd) return candidate;
+      return null;
+    }
+    // Otherwise it must start after this interval finishes (plus gap).
+    if (interval.end + gap > candidate) {
+      candidate = interval.end + gap;
+    }
+  }
+  if (candidate + duration <= windowEnd) return candidate;
+  return null;
+}
+
+function insertInterval(intervals: Interval[], interval: Interval): void {
+  let lo = 0;
+  let hi = intervals.length;
+  while (lo < hi) {
+    const mid = (lo + hi) >> 1;
+    if (intervals[mid].start < interval.start) lo = mid + 1;
+    else hi = mid;
+  }
+  intervals.splice(lo, 0, interval);
+}
+
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const gap = options.gap ?? DEFAULT_GAP;
+  const { startTime, endTime } = options;
+
+  const byId = new Map<string, Event>();
+  for (const event of events) {
+    if (byId.has(event.id)) {
+      throw new Error(`Duplicate event id: ${event.id}`);
+    }
+    byId.set(event.id, event);
+  }
+
+  // Throws on any cycle (including self-references).
+  detectCycles(events, byId);
+
+  if (events.length === 0) {
+    return { assignments: [], unscheduled: [] };
+  }
+
+  const order = topologicalOrder(events, byId);
+
+  // Per-room sorted interval lists, mutated during the search.
+  const roomIntervals = new Map<string, Interval[]>();
+  for (const room of rooms) roomIntervals.set(room.id, []);
+
+  const placement = new Map<string, Assignment>();
+  const scheduled = new Set<string>();
+
+  let bestCount = -1;
+  let bestPrefScore = -1;
+  let bestAssignments: Assignment[] = [];
+  let iterations = 0;
+
+  const recordBest = (): void => {
+    let prefScore = 0;
+    for (const assignment of placement.values()) {
+      const event = byId.get(assignment.eventId)!;
+      if (event.preferredRoom && event.preferredRoom === assignment.roomId) {
+        prefScore++;
+      }
+    }
+    const count = placement.size;
+    if (count > bestCount || (count === bestCount && prefScore > bestPrefScore)) {
+      bestCount = count;
+      bestPrefScore = prefScore;
+      bestAssignments = Array.from(placement.values()).map((a) => ({ ...a }));
+    }
+  };
+
+  const recurse = (index: number): void => {
+    if (iterations >= MAX_ITERATIONS) {
+      recordBest();
+      return;
+    }
+    iterations++;
+
+    if (index === order.length) {
+      recordBest();
+      return;
+    }
+
+    // Branch-and-bound: prune if even scheduling every remaining event can't
+    // beat the best solution found so far.
+    const upperBound = placement.size + (order.length - index);
+    if (upperBound < bestCount) return;
+
+    const event = order[index];
+    const attendees = event.attendees ?? DEFAULT_ATTENDEES;
+
+    // The event can only be placed if all of its prerequisites were scheduled.
+    let prereqEarliest = startTime;
+    let prereqsScheduled = true;
+    for (const prereq of event.prerequisites ?? []) {
+      const prereqAssignment = placement.get(prereq);
+      if (!prereqAssignment) {
+        prereqsScheduled = false;
+        break;
+      }
+      prereqEarliest = Math.max(prereqEarliest, prereqAssignment.endTime + gap);
+    }
+
+    if (prereqsScheduled && event.duration > 0) {
+      type Candidate = { room: Room; start: number };
+      const candidates: Candidate[] = [];
+      for (const room of rooms) {
+        if (room.capacity < attendees) continue;
+        const intervals = roomIntervals.get(room.id)!;
+        const start = earliestFeasibleStart(
+          event.duration,
+          prereqEarliest,
+          intervals,
+          gap,
+          endTime,
+        );
+        if (start !== null) {
+          candidates.push({ room, start });
+        }
+      }
+
+      // Try the preferred room first, then earliest start, to honor
+      // preferences and pack tightly.
+      candidates.sort((a, b) => {
+        const aPref = event.preferredRoom === a.room.id ? 0 : 1;
+        const bPref = event.preferredRoom === b.room.id ? 0 : 1;
+        if (aPref !== bPref) return aPref - bPref;
+        return a.start - b.start;
+      });
+
+      for (const candidate of candidates) {
+        const assignment: Assignment = {
+          eventId: event.id,
+          roomId: candidate.room.id,
+          startTime: candidate.start,
+          endTime: candidate.start + event.duration,
+        };
+        const intervals = roomIntervals.get(candidate.room.id)!;
+        const interval: Interval = { start: assignment.startTime, end: assignment.endTime };
+        insertInterval(intervals, interval);
+        placement.set(event.id, assignment);
+        scheduled.add(event.id);
+
+        recurse(index + 1);
+
+        scheduled.delete(event.id);
+        placement.delete(event.id);
+        const idx = intervals.indexOf(interval);
+        if (idx !== -1) intervals.splice(idx, 1);
+      }
+    }
+
+    // Skip branch: leave this event unscheduled.
+    recurse(index + 1);
+  };
+
+  recurse(0);
+
+  const scheduledIds = new Set(bestAssignments.map((a) => a.eventId));
+  const unscheduled = events
+    .map((e) => e.id)
+    .filter((id) => !scheduledIds.has(id));
+
+  return { assignments: bestAssignments, unscheduled };
+}
+
+export default schedule;
