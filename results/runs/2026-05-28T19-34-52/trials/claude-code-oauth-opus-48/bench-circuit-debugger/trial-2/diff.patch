der circuit.\n *\n * The circuit is a ripple-carry adder. Each bit i (>0) is a full adder:\n *   xi XOR yi -> p     (partial sum)\n *   xi AND yi -> g     (generate carry)\n *   p  XOR ci -> zi    (final sum, ci = carry in)\n *   p  AND ci -> pr    (propagate carry)\n *   g  OR  pr -> co    (carry out)\n * Bit 0 is a half adder (x00 XOR y00 -> z00, x00 AND y00 -> carry), and the\n * most-significant z wire is the final carry-out (an OR gate).\n *\n * A correct adder obeys a small set of structural rules. Each wire-swap breaks\n * at least one of them, so the wires violating these rules are exactly the\n * swapped ones. This is O(gates) and needs no enumeration of swap combinations.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  // Highest-numbered z wire is the final carry-out bit.\n  let maxZ = '';\n  for (const g of gates) {\n    if (isOutput(g.out) && g.out > maxZ) maxZ = g.out;\n  }\n\n  // For each wire, record the set of gate ops that consume it as an input.\n  const consumerOps = new Map<string, Set<Gate['op']>>();\n  for (const g of gates) {\n    for (const wire of [g.in1, g.in2]) {\n      let s = consumerOps.get(wire);\n      if (!s) consumerOps.set(wire, (s = new Set()));\n      s.add(g.op);\n    }\n  }\n  const feeds = (wire: string, op: Gate['op']): boolean =>\n    consumerOps.get(wire)?.has(op) ?? false;\n\n  const faulty = new Set<string>();\n\n  for (const g of gates) {\n    const bit = isInput(g.in1) ? g.in1.slice(1) : null;\n    const xyInputs = isInput(g.in1) && isInput(g.in2);\n\n    // Rule 1: every z output comes from an XOR gate, except the top z bit\n    // (final carry-out) which comes from an OR gate.\n    if (isOutput(g.out)) {\n      if (g.out === maxZ) {\n        if (g.op !== 'OR') faulty.add(g.out);\n      } else if (g.op !== 'XOR') {\n        faulty.add(g.out);\n      }\n    }\n\n    // Rule 2: an XOR gate either takes raw x/y inputs (partial sum) or writes\n    // a z output (final sum). An XOR feeding an internal