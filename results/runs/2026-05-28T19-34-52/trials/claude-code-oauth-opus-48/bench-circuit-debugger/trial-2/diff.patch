;\n\n  it('recovers two swaps that corrupt the same output bit', () => {\n    // Bit 9's full adder has its final-sum wire (z09) swapped with a distant\n    // wire AND its carry-in corrupted by a second swap, so no single swap fixes\n    // bit 9 — exercises the two-swap repair path.\n    const N = 16;\n    const gates = buildAdder(N);\n    const byOut = (o: string) => gates.findIndex((g) => g.out === o);\n    const doSwap = (a: string, b: string) => {\n      const i = byOut(a);\n      const j = byOut(b);\n      const t = gates[i].out;\n      gates[i].out = gates[j].out;\n      gates[j].out = t;\n    };\n    // z09 (bit-9 final sum) <-> z12's propagate; bit-8 propagate <-> z11.\n    const fsum9 = `z09`;\n    // Identify bit-12 propagate and bit-8 propagate by structure.\n    const prop = (bit: number) => {\n      const p = gates.find(\n        (g) => g.op === 'XOR' && g.in1 === `x${bit2(bit)}`,\n      )!.out;\n      return gates.find((g) => g.op === 'AND' && (g.in1 === p || g.in2 === p))!\n        .out;\n    };\n    const expected = [fsum9, prop(12), prop(8), `z11`].sort();\n    doSwap(fsum9, prop(12));\n    doSwap(prop(8), `z11`);\n    const found = findSwappedWires(gates);\n    expect(found).toEqual(expected);\n  });\n\n  it('handles 45-bit circuits within time budget', () => {\n    const rng = makeRng(999);\n    const N = 45;\n    const gates = buildAdder(N);\n    const pairs = pickSwaps(gates, N, rng);\n    expect(pairs.length).toBe(4);\n    const expected = applySwaps(gates, pairs);\n    const start = Date.now();\n    const found = findSwappedWires(gates);\n    const elapsed = Date.now() - start;\n    expect(found).toEqual(expected);\n    expect(elapsed).toBeLessThan(5000);","originalFile":"import { describe, it, expect } from 'vitest';\nimport { simulate, findSwappedWires, type Gate } from './index.js';\n\n// ---- Build a correct ripple-carry adder of N input bits ----------------------\n\nconst bit2 = (n: number): string => n.toString().padStart(2, '0');\n\nlet nameCounter = 0;\nconst freshName = (): string => {\n  // Deterministic non-conventional wire names: aa, ab, ... then padded.\n  const n = nameCounter++;\n  const a = String.fromCharCode(97 + Math.floor(n / 26) % 26);\n  const b = String.fromCharCode(97 + (n % 26));\n  return `w${a}${b}${Math.floor(n / 676)}`;\n};\n\nfunction buildAdder(N: number): Gate[] {\n  nameCounter = 0;\n  const gates: Gate[] = [];\n  let carry: string | null = null;\n\n  for (let i = 0; i < N; i++) {\n    const x = `x${bit2(i)}`;\n    const y = `y${bit2(i)}`;\n    const z = `z${bit2(i)}`;\n\n    if (i === 0) {\n      gates.push({ op: 'XOR', in1: x, in2: y, out: z });\n      carry = freshName();\n      gates.push({ op: 'AND', in1: x, in2: y, out: carry });\n      continue;\n    }\n\n    const partial = freshName();\n    const generate = freshName();\n    const propagate = freshName();\n    const nextCarry = freshName();\n\n    gates.push({ op: 'XOR', in1: x, in2: y, out: partial });\n    gates.push({ op: 'XOR', in1: partial, in2: carry!, out: z });\n    gates.push({ op: 'AND', in1: x, in2: y, out: generate });\n    gates.push({ op: 'AND', in1: partial, in2: carry!, out: propagate });\n    gates.push({ op: 'OR', in1: generate, in2: propagate, out: nextCarry });\n    carry = nextCarry;\n  }\n\n  // Final carry becomes the most significant z bit.\n  // Re-route: the last OR gate already wrote `carry`; rename it to z(N).\n  const top = `z${bit2(N)}`;\n  const last = gates[gates.length - 1];\n  last.out = top;\n  return gates;\n}\n\n// Simple deterministic PRNG for reproducible swap selection.\nfunction makeRng(seed: number): () => number {\n  let s = seed >>> 0;\n  return () => {\n    s = (s * 1664525 + 1013904223) >>> 0;\n    return s / 0x100000000;\n  };\n}\n\nfunction adderInputs(N: number, x: bigint, y: bigint): Record<string, number> {\n  const inputs: Record<string, number> = {};\n  for (let i = 0; i < N; i++) {\n    inputs[`x${bit2(i)}`] = Number((x >> BigInt(i)) & 1n);\n    inputs[`y${bit2(i)}`] = Number((y >> BigInt(i)) & 1n);\n  }\n  return inputs;\n}\n\nfunction readZ(N: number, values: Record<string, number>): bigint {\n  let z = 0n;\n  for (let i = 0; i <= N; i++) {\n    z |= BigInt(values[`z${bit2(i)}`] ?? 0) << BigInt(i);\n  }\n  return z;\n}\n\ndescribe('simulate', () => {\n  it('applies AND/OR/XOR in dependency order', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'a', in2: 'b', out: 'c' },\n      { op: 'XOR', in1: 'c', in2: 'd', out: 'e' },\n      { op: 'OR', in1: 'a', in2: 'd', out: 'f' },\n    ];\n    const v = simulate(gates, { a: 1, b: 1, d: 0 });\n    expect(v.c).toBe(1);\n    expect(v.e).toBe(1);\n    expect(v.f).toBe(1);\n  });\n\n  it('handles gates given out of dependency order', () => {\n    const gates: Gate[] = [\n      { op: 'XOR', in1: 'c', in2: 'd', out: 'e' }, // depends on c (defined later)\n      { op: 'AND', in1: 'a', in2: 'b', out: 'c' },\n    ];\n    const v = simulate(gates, { a: 1, b: 1, d: 1 });\n    expect(v.c).toBe(1);\n    expect(v.e).toBe(0);\n  });\n\n  it('a correct adder computes X + Y', () => {\n    const N = 8;\n    const gates = buildAdder(N);\n    const v = simulate(gates, adderInputs(N, 123n, 200n));\n    expect(readZ(N, v)).toBe(323n);\n  });\n});\n\ndescribe('findSwappedWires', () => {\n  it('returns [] for a correct adder (no swaps)', () => {\n    // (A correct adder has no faulty wires.)\n    const gates = buildAdder(8);\n    expect(findSwappedWires(gates)).toEqual([]);\n  });\n\n  function applySwaps(gates: Gate[], pairs: [number, number][]): string[] {\n    const swapped: string[] = [];\n    for (const [i, j] of pairs) {\n      const tmp = gates[i].out;\n      gates[i].out = gates[j].out;\n      gates[j].out = tmp;\n      swapped.push(gates[i].out, gates[j].out);\n    }\n    return swapped.sort();\n  }\n\n  // Lowest output bit at which `gates` mis-computes X + Y, sampled over many\n  // random N-bit inputs, or Infinity if none observed.\n  function lowestWrongBit(gates: Gate[], N: number, rng: () => number): number {\n    const mask = (1n << BigInt(N)) - 1n;\n    let lowest = Infinity;\n    for (let t = 0; t < 300; t++) {\n      const x = BigInt(Math.floor(rng() * 1e9)) & mask;\n      const y = BigInt(Math.floor(rng() * 1e9)) & mask;\n      const diff = readZ(N, simulate(gates, adderInputs(N, x, y))) ^ (x + y);\n      if (diff !== 0n) {\n        let b = 0;\n        let d = diff;\n        while ((d & 1n) === 0n) {\n          d >>= 1n;\n          b++;\n        }\n        if (b < lowest) lowest = b;\n      }\n    }\n    return lowest;\n  }\n\n  // Pick 4 disjoint pairs of gates whose outputs, when swapped, each break the\n  // adder at a *distinct* lowest bit. This models the well-posed instances a\n  // real benchmark generates (each fault localizes to its own bit), guaranteeing\n  // a unique repair — unlike arbitrary swaps, which can be ambiguous.\n  function pickSwaps(\n    gates: Gate[],\n    N: number,\n    rng: () => number,\n  ): [number, number][] {\n    const used = new Set<number>();\n    const takenBits = new Set<number>();\n    const pairs: [number, number][] = [];\n    let guard = 0;\n    while (pairs.length < 4 && guard++ < 20000) {\n      const i = Math.floor(rng() * gates.length);\n      const j = Math.floor(rng() * gates.length);\n      if (i === j || used.has(i) || used.has(j)) continue;\n      const trial = gates.map((g) => ({ ...g }));\n      const t = trial[i].out;\n      trial[i].out = trial[j].out;\n      trial[j].out = t;\n      const wb = lowestWrongBit(trial, N, rng);\n      if (!Number.isFinite(wb) || takenBits.has(wb)) continue;\n      used.add(i);\n      used.add(j);\n      takenBits.add(wb);\n      pairs.push([i, j]);\n    }\n    return pairs;\n  }\n\n  it('recovers swapped wires across many random 16-bit circuits', () => {\n    for (let seed = 1; seed <= 50; seed++) {\n      const rng = makeRng(seed);\n      const gates = buildAdder(16);\n      const pairs = pickSwaps(gates, rng);\n      if (pairs.length < 4) continue; // rare: couldn't find 4 breaking swaps\n      const expected = applySwaps(gates, pairs);\n      const found = findSwappedWires(gates);\n      expect(found, `seed ${seed}`).toEqual(expected);\n    }\n  });\n\n  it('handles 45-bit circuits within time budget', () => {\n    const rng = makeRng(999);\n    const gates = buildAdder(45);\n    const pairs = pickSwaps(gates, rng);\n    const expected = applySwaps(gates, pairs);\n    const start = Date.now();\n    const found = findSwappedWires(gates);\n    const elapsed = Date.now() - start;\n    expect(found).toEqual(expected);\n    expect(elapsed).toBeLessThan(5000);\n  });\n});\n","structuredPatch":[{"oldStart":181,"oldLines":21,"newStart":181,"newLines":58,"lines":["   }"," ","   it('recovers swapped wires across many random 16-bit circuits', () => {","-    for (let seed = 1; seed <= 50; seed++) {","+    let checked = 0;","+    for (let seed = 1; seed <= 60; seed++) {","       const rng = makeRng(seed);","-      const gates = buildAdder(16);","-      const pairs = pickSwaps(gates, rng);","-      if (pairs.length < 4) continue; // rare: couldn't find 4 breaking swaps","+      const N = 16;","+      const gates = buildAdder(N);","+      const pairs = pickSwaps(gates, N, rng);","+      if (pairs.length < 4) continue; // rare: couldn't place 4 distinct faults","       const expected = applySwaps(gates, pairs);","       const found = findSwappedWires(gates);","       expect(found, `seed ${seed}`).toEqual(expected);","+      checked++;","     }","+    expect(checked).toBeGreaterThan(40);","   });"," ","+  it('recovers two swaps that corrupt the same output bit', () => {","+    // Bit 9's full adder has its final-sum wire (z09) swapped with a distant","+    // wire AND its carry-in corrupted by a second swap, so no single swap fixes","+    // bit 9 — exercises the two-swap repair path.","+    const N = 16;","+    const gates = buildAdder(N);","+    const byOut = (o: string) => gates.findIndex((g) => g.out === o);","+