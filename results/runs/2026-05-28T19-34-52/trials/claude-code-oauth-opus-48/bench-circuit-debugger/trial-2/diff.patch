n the time budget at 45 bits.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  // ---- Index wires and gates into flat typed arrays for fast evaluation ----\n  const wireId = new Map<string, number>();\n  const wireName: string[] = [];\n  const intern = (name: string): number => {\n    let id = wireId.get(name);\n    if (id === undefined) {\n      id = wireName.length;\n      wireId.set(name, id);\n      wireName.push(name);\n    }\n    return id;\n  };\n\n  const M = gates.length;\n  const gateOp = new Int8Array(M);\n  const gateIn1 = new Int32Array(M);\n  const gateIn2 = new Int32Array(M);\n  // currentOut[g] = wire id this gate currently writes (mutated by swaps).\n  const currentOut = new Int32Array(M);\n  for (let g = 0; g < M; g++) {\n    gateOp[g] = opFrom(gates[g].op);\n    gateIn1[g] = intern(gates[g].in1);\n    gateIn2[g] = intern(gates[g].in2);\n    currentOut[g] = intern(gates[g].out);\n  }\n\n  const W = wireName.length;\n  // producer[w] = index of the gate driving wire w, or -1 for primary inputs.\n  const producer = new Int32Array(W).fill(-1);\n  for (let g = 0; g < M; g++) producer[currentOut[g]] = g;\n\n  // ---- Determine the bit width N from the x inputs present ----\n  let N = 0;\n  for (const [name] of wireId) {\n    if (name[0] === 'x') {\n      const idx = Number(name.slice(1));\n      if (Number.isFinite(idx) && idx + 1 > N) N = idx + 1;\n    }\n  }\n\n  const zId: number[] = [];\n  const xId: number[] = [];\n  const yId: number[] = [];\n  const bitBig: bigint[] = [];\n  for (let i = 0; i <= N; i++) {\n    zId.push(wireId.get(`z${bit2(i)}`) ?? -1);\n    xId.push(wireId.get(`x${bit2(i)}`) ?? -1);\n    yId.push(wireId.get(`y${bit2(i)}`) ?? -1);\n    bitBig.push(BigInt(i));\n  }\n\n  // ---- Memoized evaluator (order independent, detects cycles) ----\n  const inputVal = new Int8Array(W); // values of x/y wires for current vector\n  const memo = new Int8Array(W);\n  const stamp = new Int32Array(W).fill(-1); // memo validity p