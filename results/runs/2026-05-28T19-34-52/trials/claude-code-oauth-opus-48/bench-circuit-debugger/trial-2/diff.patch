  if (f < baseline) promising.push({ gi, gj, f });\n      }\n    }\n    promising.sort((p, q) => p.f - q.f);\n\n    let evals = 0;\n    for (const { gi, gj } of promising) {\n      swap(gi, gj);\n      const cone2 = new Set(candidateGates(b, true));\n      for (const gk of high) {\n        if (gk === gi || gk === gj || !cone2.has(gk)) continue;\n        for (const gl of high) {\n          if (gl === gk || gl === gi || gl === gj) continue;\n          swap(gk, gl);\n          evals++;\n          // Bit b correct after both swaps means the pair completes the repair\n          // (greedy advances to the next wrong bit from here).\n          const fixed = isBitCorrect(b);\n          swap(gk, gl);\n          if (fixed) {\n            swap(gi, gj); // restore first swap before returning\n            return [[gi, gj], [gk, gl]];\n          }\n          if (evals >= TWO_SWAP_EVAL_CAP) {\n            swap(gi, gj);\n            return null;\n          }\n        }\n      }\n      swap(gi, gj); // restore first swap\n    }\n    return null;\n  };\n\n  // ---- Greedy repair: undo swaps until the adder is correct ----\n  const swappedWires: string[] = [];\n  let swapsUsed = 0;\n  while (swapsUsed < 4) {\n    const b = lowestWrongBit();\n    if (b < 0) break; // already correct\n    computeInfluence();\n\n    let [bestI, bestJ] = singleSearch(b, candidateGates(b, false), frozen);\n    if (bestI < 0) [bestI, bestJ] = singleSearch(b, candidateGates(b, true), frozen);\n\n    if (bestI >= 0) {\n      swappedWires.push(wireName[currentOut[bestI]], wireName[currentOut[bestJ]]);\n      swap(bestI, bestJ);\n      frozen.add(bestI).add(bestJ);\n      swapsUsed++;\n      continue;\n    }\n\n    // Single swap stalled — try repairing two overlapping swaps at once.\n    if (swapsUsed <= 2) {\n      const pair = twoSwapSearch(b);\n      if (pair) {\n        const [[gi, gj], [gk, gl]] = pair;\n        swappedWires.push(wireName[currentOut[gi]], wireName[currentOut[gj]]);\n        swap(gi, gj);\