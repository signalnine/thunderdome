>= b) promising.push([gi, gj]); // didn't break lower bits\n      }\n      if (promising.length >= FIRST_SWAP_CAP) break;\n    }\n    for (const [gi, gj] of promising) {\n      swap(gi, gj);\n      computeInfluence();\n      const avoid = new Set([gi, gj]);\n      const [gk, gl, gain] = singleSearch(b, candidateGates(b, true), avoid);\n      swap(gi, gj); // restore\n      if (gk >= 0 && gain > b) return [[gi, gj], [gk, gl]];\n    }\n    return null;\n  };\n\n  // ---- Greedy repair: undo swaps until the adder is correct ----\n  const swappedWires: string[] = [];\n  let swapsUsed = 0;\n  while (swapsUsed < 4) {\n    const b = lowestWrongBit();\n    if (b < 0) break; // already correct\n    computeInfluence();\n\n    let [bestI, bestJ] = singleSearch(b, candidateGates(b, false));\n    if (bestI < 0) [bestI, bestJ] = singleSearch(b, candidateGates(b, true));\n\n    if (bestI >= 0) {\n      swappedWires.push(wireName[currentOut[bestI]], wireName[currentOut[bestJ]]);\n      swap(bestI, bestJ);\n      swapsUsed++;\n      continue;\n    }\n\n    // Single swap stalled — try repairing two overlapping swaps at once.\n    if (swapsUsed <= 2) {\n      const pair = twoSwapSearch(b);\n      if (pair) {\n        const [[gi, gj], [gk, gl]] = pair;\n        swappedWires.push(wireName[currentOut[gi]], wireName[currentOut[gj]]);\n        swap(gi, gj);\n        swappedWires.push(wireName[currentOut[gk]], wireName[currentOut[gl]]);\n        swap(gk, gl);\n        swapsUsed += 2;\n        continue;\n      }\n    }\n    break; // no improving repair found\n  }\n\n  return swappedWires.sort();\n}\n","structuredPatch":[{"oldStart":288,"oldLines":13,"newStart":288,"newLines":19,"lines":["   // b: enumerate a first swap that doesn't break any already-correct lower bit,","   // then look for a second swap that completes the repair. Bounded and only","   // reached when single-swap repair stalls.","+  // Each gate participates in at most one swap, so once a gate is committed to a","+  // repa