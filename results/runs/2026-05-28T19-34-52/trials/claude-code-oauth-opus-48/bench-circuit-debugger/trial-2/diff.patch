 const last = gates[gates.length - 1];\n  last.out = top;\n  return gates;\n}\n\n// Simple deterministic PRNG for reproducible swap selection.\nfunction makeRng(seed: number): () => number {\n  let s = seed >>> 0;\n  return () => {\n    s = (s * 1664525 + 1013904223) >>> 0;\n    return s / 0x100000000;\n  };\n}\n\nfunction adderInputs(N: number, x: bigint, y: bigint): Record<string, number> {\n  const inputs: Record<string, number> = {};\n  for (let i = 0; i < N; i++) {\n    inputs[`x${bit2(i)}`] = Number((x >> BigInt(i)) & 1n);\n    inputs[`y${bit2(i)}`] = Number((y >> BigInt(i)) & 1n);\n  }\n  return inputs;\n}\n\nfunction readZ(N: number, values: Record<string, number>): bigint {\n  let z = 0n;\n  for (let i = 0; i <= N; i++) {\n    z |= BigInt(values[`z${bit2(i)}`] ?? 0) << BigInt(i);\n  }\n  return z;\n}\n\ndescribe('simulate', () => {\n  it('applies AND/OR/XOR in dependency order', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'a', in2: 'b', out: 'c' },\n      { op: 'XOR', in1: 'c', in2: 'd', out: 'e' },\n      { op: 'OR', in1: 'a', in2: 'd', out: 'f' },\n    ];\n    const v = simulate(gates, { a: 1, b: 1, d: 0 });\n    expect(v.c).toBe(1);\n    expect(v.e).toBe(1);\n    expect(v.f).toBe(1);\n  });\n\n  it('handles gates given out of dependency order', () => {\n    const gates: Gate[] = [\n      { op: 'XOR', in1: 'c', in2: 'd', out: 'e' }, // depends on c (defined later)\n      { op: 'AND', in1: 'a', in2: 'b', out: 'c' },\n    ];\n    const v = simulate(gates, { a: 1, b: 1, d: 1 });\n    expect(v.c).toBe(1);\n    expect(v.e).toBe(0);\n  });\n\n  it('a correct adder computes X + Y', () => {\n    const N = 8;\n    const gates = buildAdder(N);\n    const v = simulate(gates, adderInputs(N, 123n, 200n));\n    expect(readZ(N, v)).toBe(323n);\n  });\n});\n\ndescribe('findSwappedWires', () => {\n  it('returns [] for a correct adder (no swaps)', () => {\n    // (A correct adder has no faulty wires.)\n    const gates = buildAdder(8);\n    expect(findSwap