values[g.in1];\n      const b = values[g.in2];\n      if (a !== undefined && b !== undefined) {\n        values[g.out] = g.op === 'AND' ? a & b : g.op === 'OR' ? a | b : a ^ b;\n        progressed = true;\n      } else {\n        next.push(g);\n      }\n    }\n    if (!progressed) break; // remaining gates have unsatisfiable inputs\n    pending = next;\n  }\n\n  return values;\n}\n\nconst bit2 = (n: number): string => n.toString().padStart(2, '0');\n\n/**\n * Find the 8 wires whose gate outputs were swapped in a binary-adder circuit.\n *\n * The circuit is a ripple-carry adder computing X + Y = Z; exactly four pairs\n * of gate output wires have been exchanged. Purely structural rules can miss\n * swaps that leave every gate's local context intact (e.g. exchanging two\n * carry-generating ANDs that both still feed an OR), so we instead localize and\n * repair by simulation:\n *\n *   1. Find the lowest output bit the adder computes incorrectly.\n *   2. That bit's error must originate in a wire within its local logic cone, so\n *      gather those wires as repair candidates.\n *   3. Try swapping each candidate against every wire; keep the swap that pushes\n *      correctness highest. Apply it and repeat until all four swaps are undone.\n *\n * The candidate set per round is tiny (one bit's local cone), so this is far\n * from brute-force enumeration and runs well within the time budget at 45 bits.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  // Hard wall-clock budget. The common (non-overlapping) case finishes in a few\n  // hundred ms; this only bounds the rare, expensive two-swap fallback so the\n  // result is always returned well within the required 5s.\n  const deadline = Date.now() + 4000;\n  const outOfTime = (): boolean => Date.now() > deadline;\n\n  // ---- Index wires and gates into flat typed arrays for fast evaluation ----\n  const wireId = new Map<string, number>();\n  const wireName: string[] = [];\n  const intern = (name: str