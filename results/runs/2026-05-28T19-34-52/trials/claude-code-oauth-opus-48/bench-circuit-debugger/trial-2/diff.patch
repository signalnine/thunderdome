 let epoch = 0;\n\n  // Returns 0/1, or -1 if a cycle was hit (an illegal intermediate circuit).\n  const evalWire = (w: number): number => {\n    const g = producer[w];\n    if (g < 0) return inputVal[w];\n    if (stamp[w] === epoch) return memo[w];\n    if (inProgress[w]) return -1;\n    inProgress[w] = 1;\n    const a = evalWire(gateIn1[g]);\n    const b = evalWire(gateIn2[g]);\n    inProgress[w] = 0;\n    if (a < 0 || b < 0) return -1;\n    const op = gateOp[g];\n    const v = op === OP_AND ? a & b : op === OP_OR ? a | b : a ^ b;\n    memo[w] = v;\n    stamp[w] = epoch;\n    return v;\n  };\n\n  const setInputs = (x: bigint, y: bigint): void => {\n    for (let i = 0; i < N; i++) {\n      const sh = bitBig[i];\n      if (xId[i] >= 0) inputVal[xId[i]] = Number((x >> sh) & 1n);\n      if (yId[i] >= 0) inputVal[yId[i]] = Number((y >> sh) & 1n);\n    }\n  };\n\n  // ---- Targeted test vectors per output bit ----\n  // For each bit, exercise (x_i, y_i) over carry-in 0 and 1, plus a ripple that\n  // generates a carry all the way to bit i. With lower bits already verified\n  // correct, these deterministically expose any fault in bit i's full adder.\n  const battery: { x: bigint; y: bigint }[][] = [];\n  for (let i = 0; i <= N; i++) {\n    const vecs: { x: bigint; y: bigint }[] = [];\n    const bit = i < N ? 1n << BigInt(i) : 0n;\n    // carry-in = 0 (all lower bits zero)\n    vecs.push({ x: 0n, y: 0n });\n    if (i < N) {\n      vecs.push({ x: bit, y: 0n });\n      vecs.push({ x: 0n, y: bit });\n      vecs.push({ x: bit, y: bit });\n    }\n    // carry-in = 1 (generate a carry from bit i-1)\n    if (i >= 1) {\n      const lo = 1n << BigInt(i - 1);\n      vecs.push({ x: lo, y: lo });\n      if (i < N) {\n        vecs.push({ x: lo | bit, y: lo });\n        vecs.push({ x: lo, y: lo | bit });\n        vecs.push({ x: lo | bit, y: lo | bit });\n      }\n    }\n    // ripple: 0b11..1 + 1 carries up to bit i\n    if (i >= 1) vecs.push({ x: (1n << BigInt(i)) - 1n, y: 1n });\n    battery.push(vecs);\n  }\n\n  // Deterministic full-width random vectors, checked at every bit. The targeted\n  // vectors alone can be satisfied by an incorrect repair that merely happens to\n  // match for those specific carry contexts; random vectors exercise each bit\n  // under arbitrary carries so a wrong repair fails at its own bit rather than\n  // masquerading as correct. A fixed LCG keeps this reproducible.\n  const mask = (1n << BigInt(N)) - 1n;\n  const randVecs: { x: bigint; y: bigint }[] = [];\n  let lcg = 0x9e3779b9n;\n  const nextRand = (): bigint => {\n    let v = 0n;\n    for (let k = 0; k < N; k += 30) {\n      lcg = (lcg * 6364136223846793005n + 1442695040888963407n) & 0xffffffffffffffffn;\n      v = (v << 30n) | ((lcg >> 17n) & 0x3fffffffn);\n    }\n    return v & mask;\n  };\n  for (let r = 0; r < 48; r++) randVecs.push({ x: nextRand(), y: nextRand() });\n\n  // Lowest bit index >= startBit that the current circuit computes incorrectly,\n  // or -1 if every bit startBit..N is correct. Callers pass startBit when lower\n  // bits are known to be unaffected by a swap.\n  const lowestWrongBit = (startBit = 0): number => {\n    for (let i = startBit; i <= N; i++) {\n      const z = zId[i];\n      if (z < 0) continue;\n      const sh = bitBig[i];\n      for (const { x, y } of battery[i]) {\n        setInputs(x, y);\n        epoch++;\n        if (evalWire(z) !== Number(((x + y) >> sh) & 1n)) return i;\n      }\n      for (const { x, y } of randVecs) {\n        setInputs(x, y);\n        epoch++;\n        if (evalWire(z) !== Number(((x + y) >> sh) & 1n)) return i;\n      }\n    }\n    return -1;\n  };\n\n  // Number of test vectors (targeted + random) for which output bit b is wrong.\n  // Used to detect partial progress when two swaps jointly corrupt one bit.\n  const failuresAtBit = (b: number): number => {\n    const z = zId[b];\n    if (z < 0) return 0;\n    const sh = bitBig[b];\n    let count = 0;\n    for (const { x, y } of battery[b]) {\n      setInputs(x, y);\n      epoch++;\n      if (evalWire(z) !== Number(((x + y) >> sh) & 1n)) count++;\n    }\n    for (const { x, y } of randVecs) {\n      setInputs(x, y);\n      epoch++;\n      if (evalWire(z) !== Number(((x + y) >> sh) & 1n)) count++;\n    }\n    return count;\n  };\n\n  // ---- Swap helpers (exchange the output wires of two gates) ----\n  const swap = (gi: number, gj: number): void => {\n    const oi = currentOut[gi];\n    const oj = currentOut[gj];\n    currentOut[gi] = oj;\n    currentOut[gj] = oi;\n    producer[oi] = gj;\n    producer[oj] = gi;\n  };\n\n  // ---- Fan-in cone (set of gate output wire ids feeding a wire) ----\n  const coneOf = (root: number, into: Set<number>): void => {\n    const g = producer[root];\n    if (g < 0 || into.has(root)) return;\n    into.add(root);\n    coneOf(gateIn1[g], into);\n    coneOf(gateIn2[g], into);\n  };\n\n  // influenceFloor[w] = lowest output bit whose cone contains wire w (or N+1).\n  // A swap touching only wires with floor >= b cannot change any bit below b.\n  const influenceFloor = new Int32Array(W).fill(N + 1);\n  const computeInfluence = (): void => {\n    influenceFloor.fill(N + 1);\n    for (let i = 0; i <= N; i++) {\n      if (zId[i] < 0) continue;\n      const cone = new Set<number>();\n      coneOf(zId[i], cone);\n      for (const w of cone) if (i < influenceFloor[w]) influenceFloor[w] = i;\n    }\n  };\n\n  // Build the local repair-candidate gates for bit b. `wide` includes the whole\n  // fan-in cone; the narrow form drops wires already exercised by correct lower\n  // bits (a much smaller set that suffices for the common case).\n  const candidateGates = (b: number, wide: boolean): number[] => {\n    const cone = new Set<number>();\n    coneOf(zId[b], cone);\n    if (b + 1 <= N && zId[b + 1] >= 0) coneOf(zId[b + 1], cone);\n    const below = new Set<number>();\n    if (!wide && b - 1 >= 0 && zId[b - 1] >= 0) coneOf(zId[b - 1], below);\n    const gatesOut: number[] = [];\n    for (const