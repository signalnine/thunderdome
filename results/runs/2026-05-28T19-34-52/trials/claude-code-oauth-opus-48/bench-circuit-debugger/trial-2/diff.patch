 failuresAtBit(b);\n        swap(gi, gj);\n        if (f < baseline) promising.push({ gi, gj, f });\n      }\n    }\n    promising.sort((p, q) => p.f - q.f);\n\n    let evals = 0;\n    for (const { gi, gj } of promising) {","originalFile":"export interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string; // input wire name\n  in2: string; // input wire name\n  out: string; // output wire name\n}\n\nconst OP_AND = 0;\nconst OP_OR = 1;\nconst OP_XOR = 2;\n\nconst opFrom = (op: Gate['op']): number =>\n  op === 'AND' ? OP_AND : op === 'OR' ? OP_OR : OP_XOR;\n\n/**\n * Simulate a combinational logic circuit.\n *\n * Gates are fired in dependency order: a gate fires once both of its input\n * wires have known values. All provided circuits are acyclic, so repeatedly\n * sweeping the gate list until no further progress is made resolves every wire.\n */\nexport function simulate(\n  gates: Gate[],\n  inputs: Record<string, number>,\n): Record<string, number> {\n  const values: Record<string, number> = { ...inputs };\n\n  let pending = gates.slice();\n  while (pending.length > 0) {\n    const next: Gate[] = [];\n    let progressed = false;\n    for (const g of pending) {\n      const a = values[g.in1];\n      const b = values[g.in2];\n      if (a !== undefined && b !== undefined) {\n        values[g.out] = g.op === 'AND' ? a & b : g.op === 'OR' ? a | b : a ^ b;\n        progressed = true;\n      } else {\n        next.push(g);\n      }\n    }\n    if (!progressed) break; // remaining gates have unsatisfiable inputs\n    pending = next;\n  }\n\n  return values;\n}\n\nconst bit2 = (n: number): string => n.toString().padStart(2, '0');\n\n/**\n * Find the 8 wires whose gate outputs were swapped in a binary-adder circuit.\n *\n * The circuit is a ripple-carry adder computing X + Y = Z; exactly four pairs\n * of gate output wires have been exchanged. Purely structural rules can miss\n * swaps that leave every gate's local context intact (e.g. exchanging two\n * carry-generating ANDs that both still feed an OR), so we instead localize and\n * repair by simulation:\n *\n *   1. Find the lowest output bit the adder computes incorrectly.\n *   2. That bit's error must originate in a wire within its local logic cone, so\n *      gather those wires as repair candidates.\n *   3. Try swapping each candidate against every wire; keep the swap that pushes\n *      correctness highest. Apply it and repeat until all four swaps are undone.\n *\n * The candidate set per round is tiny (one bit's local cone), so this is far\n * from brute-force enumeration and runs well within the time budget at 45 bits.\n */\nexport function findSwappedWires(gates: Gate[]): string[] {\n  // ---- Index wires and gates into flat typed arrays for fast evaluation ----\n  const wireId = new Map<string, number>();\n  const wireName: string[] = [];\n  const intern = (name: string): number => {\n    let id = wireId.get(name);\n    if (id === undefined) {\n      id = wireName.length;\n      wireId.set(name, id);\n      wireName.push(name);\n    }\n    return id;\n  };\n\n  const M = gates.length;\n  const gateOp = new Int8Array(M);\n  const gateIn1 = new Int32Array(M);\n  const gateIn2 = new Int32Array(M);\n  // currentOut[g] = wire id this gate currently writes (mutated by swaps).\n  const currentOut = new Int32Array(M);\n  for (let g = 0; g < M; g++) {\n    gateOp[g] = opFrom(gates[g].op);\n    gateIn1[g] = intern(gates[g].in1);\n    gateIn2[g] = intern(gates[g].in2);\n    currentOut[g] = intern(gates[g].out);\n  }\n\n  const W = wireName.length;\n  // producer[w] = index of the gate driving wire w, or -1 for primary inputs.\n  const producer = new Int32Array(W).fill(-1);\n  for (let g = 0; g < M; g++) producer[currentOut[g]] = g;\n\n  // ---- Determine the bit width N from the x inputs present ----\n  let N = 0;\n  for (const [name] of wireId) {\n    if (name[0] === 'x') {\n      const idx = Number(name.slice(1));\n      if (Number.isFinite(idx) && idx + 1 > N) N = idx + 1;\n    }\n  }\n\n  const zId: number[] = [];\n  const xId: number[] = [];\n  const yId: number[] = [];\n  const bitBig: bigint[] = [];\n  for (let i = 0; i <= N; i++) {\n    zId.push(wireId.get(`z${bit2(i)}`) ?? -1);\n    xId.push(wireId.get(`x${bit2(i)}`) ?? -1);\n    yId.push(wireId.get(`y${bit2(i)}`) ?? -1);\n    bitBig.push(BigInt(i));\n  }\n\n  // ---- Memoized evaluator (order independent, detects cycles) ----\n  const inputVal = new Int8Array(W); // values of x/y wires for current vector\n  const memo = new Int8Array(W);\n  const stamp = new Int32Array(W).fill(-1); // memo validity per evaluation epoch\n  const inProgress = new Uint8Array(W);\n  let epoch = 0;\n\n  // Returns 0/1, or -1 if a cycle was hit (an illegal intermediate circuit).\n  const evalWire = (w: number): number => {\n    const g = producer[w];\n    if (g < 0) return inputVal[w];\n    if (stamp[w] === epoch) return memo[w];\n    if (inProgress[w]) return -1;\n    inProgress[w] = 1;\n    const a = evalWire(gateIn1[g]);\n    const b = evalWire(gateIn2[g]);\n    inProgress[w] = 0;\n    if (a < 0 || b < 0) return -1;\n    const op = gateOp[g];\n    const v = op === OP_AND ? a & b : op === OP_OR ? a | b : a ^ b;\n    memo[w] = v;\n    stamp[w] = epoch;\n    return v;\n  };\n\n  const setInputs = (x: bigint, y: bigint): void => {\n    for (let i = 0; i < N; i++) {\n      const sh = bitBig[i];\n      if (xId[i] >= 0) inputVal[xId[i]] = Number((x >> sh) & 1n);\n      if (yId[i] >= 0) inputVal[yId[i]] = Number((y >> sh) & 1n);\n    }\n  };\n\n  // ---- Targeted test vectors per output bit ----\n  // For each bit, exercise (x_i, y_i) over carry-in 0 and 1, plus a ripple that\n  // generates a carry all the way to bit i. With lower bits already verified\n  // correct, these deterministically expose any fault in bit i's full adder.\n  const battery: { x: bigint; y: bigint }[][] = [];\n  for (let i = 0; i <= N; i++) {\n    const vecs: { x: bigint; y: bigint }[] = [];\n    const bit = i < N ? 1n << BigInt(i) : 0n;\n    // carry-in = 0 (all lower bits zero)\n    vecs.push({ x: 0n, y: 0n });\n    if (i < N) {\n      vecs.push({ x: bit, y: 0n });\n      vecs.push({ x: 0n, y: bit });\n      vecs.push({ x: bit, y: bit });\n    }\n    // carry-in = 1 (generate a carry from bit i-1)\n    if (i >= 1) {\n      const lo = 1n << BigInt(i - 1);\n      vecs.push({ x: lo, y: lo });\n      if (i < N) {\n        vecs.push({ x: lo | bit, y: lo });\n        vecs.push({ x: lo, y: lo | bit });\n        vecs.push({ x: lo | bit, y: lo | bit });\n      }\n    }\n    // ripple: 0b11..1 + 1 carries up to bit i\n    if (i >= 1) vecs.push({ x: (1n << BigInt(i)) - 1n, y: 1n });\n    battery.push(vecs);\n  }\n\n  // Deterministic full-width random vectors, checked at every bit. The targeted\n  // vectors alone can be satisfied by an incorrect repair that merely happens to\n  // match for those specific carry contexts; random vectors exercise each bit\n  // under arbitrary carries so a wrong repair fails at its own bit rather than\n  // masquerading as correct. A fixed LCG keeps this reproducible.\n  const mask = (1n << BigInt(N)) - 1n;\n  const randVecs: { x: bigint; y: bigint }[] = [];\n  let lcg = 0x9e3779b9n;\n  const nextRand = (): bigint => {\n    let v = 0n;\n    for (let k = 0; k < N; k += 30) {\n      lcg = (lcg * 6364136223846793005n + 1442695040888963407n) & 0xffffffffffffffffn;\n      v = (v << 30n) | ((lcg >> 17n) & 0x3fffffffn);\n    }\n    return v & mask;\n  };\n  for (let r = 0; r < 48; r++) randVecs.push({ x: nextRand(), y: nextRand() });\n\n  // Lowest bit index >= startBit that the current circuit computes incorrectly,\n  // or -1 if every bit startBit..N is correct. Callers pass startBit when lower\n  // bits are known to be unaffected by a swap.\n  const lowestWrongBit = (startBit = 0): number => {\n    for (let i = startBit; i <= N; i++) {\n      const z = zId[i];\n      if (z < 0) continue;\n      const sh = bitBig[i];\n      for (const { x, y } of battery[i]) {\n        setInputs(x, y);\n        epoch++;\n        if (evalWire(z) !== Number(((x + y) >> sh) & 1n)) return i;\n      }\n      for (const { x, y } of randVecs) {\n        setInputs(x, y);\n        epoch++;\n        if (evalWire(z) !== Number(((x + y) >> sh) & 1n)) return i;\n      }\n    }\n    return -1;\n  };\n\n  // Number of test vectors (targeted + random) for which output bit b is wrong.\n  // Used to detect partial progress when two swaps jointly corrupt one bit.\n  const failuresAtBit = (b: number): number => {\n    const z = zId[b];\n    if (z < 0) return 0;\n    const sh = bitBig[b];\n    let count = 0;\n    for (const { x, y } of battery[b]) {\n      setInputs(x, y);\n      epoch++;\n      if (evalWire(z) !== Number(((x + y) >> sh) & 1n)) count++;\n    }\n    for (const { x, y } of randVecs) {\n      setInputs(x, y);\n      epoch++;\n      if (evalWire(z) !== Number(((x + y) >> sh) & 1n)) count++;\n    }\n    return count;\n  };\n\n  // ---- Swap helpers (exchange the output wires of two gates) ----\n  const swap = (gi: number, gj: number): void => {\n    const oi = currentOut[gi];\n    const oj = currentOut[gj];\n    currentOut[gi] = oj;\n    currentOut[gj] = oi;\n    producer[oi] = gj;\n    producer[oj] = gi;\n  };\n\n  // ---- Fan-in cone (set of gate output wire ids feeding a wire) ----\n  const coneOf = (root: number, into: Set<number>): void => {\n    const g = producer[root];\n    if (g < 0 || into.has(root)) return;\n    into.add(root);\n    coneOf(gateIn1[g], into);\n    coneOf(gateIn2[g], into);\n  };\n\n  // influenceFloor[w] = lowest output bit whose cone contains wire w (or N+1).\n  // A swap touching only wires with floor >= b cannot change any bit below b.\n  const influenceFloor = new Int32Array(W).fill(N + 1);\n  const computeInfluence = (): void => {\n    influenceFloor.fill(N + 1);\n    for (let i = 0; i <= N; i++) {\n      if (zId[i] < 0) continue;\n      const cone = new Set<number>();\n      coneOf(zId[i], cone);\n      for (const w of cone) if (i < influenceFloor[w]) influenceFloor[w] = i;\n    }\n  };\n\n  // Build the local repair-candidate gates for bit b. `wide` includes the whole\n  // fan-in cone; the narrow form drops wires already exercised by correct lower\n  // bits (a much smaller set that suffices for the common case).\n  const candidateGates = (b: number, wide: boolean): number[] => {\n    const cone = new Set<number>();\n    coneOf(zId[b], cone);\n    if (b + 1 <= N && zId[b + 1] >= 0) coneOf(zId[b + 1], cone);\n    const below = new Set<number>();\n    if (!wide && b - 1 >= 0 && zId[b - 1] >= 0) coneOf(zId[b - 1], below);\n    const gatesOut: number[] = [];\n    for (const w of cone) {\n      if (below.has(w)) continue;\n      const g = producer[w];\n      if (g >= 0) gatesOut.push(g);\n    }\n    return gatesOut;\n  };\n\n  // Best single swap (one endpoint among localGates) that raises the lowest\n  // wrong bit above b. Returns [gi, gj, newLowestWrongBit]; gi<0 if none.\n  const singleSearch = (\n    b: number,\n    localGates: number[],\n    avoid?: Set<number>,\n  ): [number, number, number] => {\n    let gain = b; // require strict improvement over current b\n    let bi = -1;\n    let bj = -1;\n    for (const gi of localGates) {\n      if (avoid?.has(gi)) continue;\n      for (let gj = 0; gj < M; gj++) {\n        if (gj === gi || avoid?.has(gj)) continue;\n        // Bits below the lower influence floor of the two swapped wires keep\n        // their (correct) values, so the scan can start there.\n        const floor = Math.min(\n          influenceFloor[currentOut[gi]],\n          influenceFloor[currentOut[gj]],\n        );\n        const start = floor < b ? floor : b;\n        swap(gi, gj);\n        let nb = lowestWrongBit(start);\n        swap(gi, gj); // restore\n        if (nb < 0) nb = N + 1; // fully correct\n        if (nb > gain) {\n          gain = nb;\n          bi = gi;\n          bj = gj;\n        }\n      }\n    }\n    return [bi, bj, gain];\n  };\n\n  // When two distinct swaps both corrupt the lowest wrong bit, no single swap\n  // can fix it. Search for a pair of swaps that together push correctness past\n  // b: enumerate a first swap that doesn't break any already-correct lower bit,\n  // then look for a second swap that completes the repair. Bounded and only\n  // reached when single-swap repair stalls.\n  // Each gate participates in at most one swap, so once a gate is committed to a\n  // repair it is frozen and excluded from later searches. This also prevents the\n  // greedy from thrashing (re-swapping wires it already moved).\n  const frozen = new Set<number>();\n\n  // Hard cap on candidate evaluations in the (rare) two-swap fallback, so it can\n  // never exceed the time budget. If a repair isn't found within the cap we give\n  // up gracefully rather than stall.\n  const TWO_SWAP_EVAL_CAP = 150_000;\n  const twoSwapSearch = (b: number): [[number, number], [number, number]] | null => {\n    // Since b is the lowest wrong bit, every swap touching it has both endpoints\n    // influencing only bits >= b (a lower-influencing endpoint would make some\n    // bit below b wrong). That bounds the candidate set to \"high\" gates.\n    const high: number[] = [];\n    for (let g = 0; g < M; g++) {\n      if (!frozen.has(g) && influenceFloor[currentOut[g]] >= b) high.push(g);\n    }\n    const inConeB = new Set(candidateGates(b, true));\n    const local = high.filter((g) => inConeB.has(g)); // affects bit b directly\n\n    // First swap: one that makes partial progress (strictly fewer failing\n    // vectors at bit b). When two swaps jointly corrupt bit b, undoing either\n    // typically fixes some carry contexts even while others remain wrong.\n    const baseline = failuresAtBit(b);\n    const FIRST_CAP = 64;\n    const promising: [number, number][] = [];\n    for (const gi of local) {\n      for (const gj of high) {\n        if (gj === gi) continue;\n        swap(gi, gj); // cannot break bits < b (all endpoints influence >= b)