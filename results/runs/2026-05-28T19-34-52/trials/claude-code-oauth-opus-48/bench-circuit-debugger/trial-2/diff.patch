ber((x >> sh) & 1n);\n      if (yId[i] >= 0) inputVal[yId[i]] = Number((y >> sh) & 1n);\n    }\n  };\n\n  // ---- Targeted test vectors per output bit ----\n  // For each bit, exercise (x_i, y_i) over carry-in 0 and 1, plus a ripple that\n  // generates a carry all the way to bit i. With lower bits already verified\n  // correct, these deterministically expose any fault in bit i's full adder.\n  const battery: { x: bigint; y: bigint }[][] = [];\n  for (let i = 0; i <= N; i++) {\n    const vecs: { x: bigint; y: bigint }[] = [];\n    const bit = i < N ? 1n << BigInt(i) : 0n;\n    // carry-in = 0 (all lower bits zero)\n    vecs.push({ x: 0n, y: 0n });\n    if (i < N) {\n      vecs.push({ x: bit, y: 0n });\n      vecs.push({ x: 0n, y: bit });\n      vecs.push({ x: bit, y: bit });\n    }\n    // carry-in = 1 (generate a carry from bit i-1)\n    if (i >= 1) {\n      const lo = 1n << BigInt(i - 1);\n      vecs.push({ x: lo, y: lo });\n      if (i < N) {\n        vecs.push({ x: lo | bit, y: lo });\n        vecs.push({ x: lo, y: lo | bit });\n        vecs.push({ x: lo | bit, y: lo | bit });\n      }\n    }\n    // ripple: 0b11..1 + 1 carries up to bit i\n    if (i >= 1) vecs.push({ x: (1n << BigInt(i)) - 1n, y: 1n });\n    battery.push(vecs);\n  }\n\n  // Lowest bit index that the current circuit computes incorrectly, or -1 if\n  // every bit 0..N is correct across the targeted battery.\n  const lowestWrongBit = (): number => {\n    for (let i = 0; i <= N; i++) {\n      const z = zId[i];\n      for (const { x, y } of battery[i]) {\n        setInputs(x, y);\n        epoch++;\n        const got = z >= 0 ? evalWire(z) : -1;\n        const want = Number(((x + y) >> BigInt(i)) & 1n);\n        if (got !== want) return i;\n      }\n    }\n    return -1;\n  };\n\n  // ---- Swap helpers (exchange the output wires of two gates) ----\n  const swap = (gi: number, gj: number): void => {\n    const oi = currentOut[gi];\n    const oj = currentOut[gj];\n    currentOut[gi] = oj;\n    currentOut[gj] = oi;\n    producer[oi] = gj;\n    producer[oj] = gi;\n  };\n\n  // ---- Fan-in cone (set of gate output wire ids feeding a wire) ----\n  const coneOf = (root: number, into: Set<number>): void => {\n    const g = producer[root];\n    if (g < 0 || into.has(root)) return;\n    into.add(root);\n    coneOf(gateIn1[g], into);\n    coneOf(gateIn2[g], into);\n  };\n\n  // ---- Greedy repair: undo one swap per round ----\n  const swappedWires: string[] = [];\n  for (let round = 0; round < 4; round++) {\n    const b = lowestWrongBit();\n    if (b < 0) break; // already correct\n\n    // Candidate wires: bit b's local cone, minus everything already-correct\n    // below it. One endpoint of the responsible swap lives here.\n    const coneB = new Set<number>();\n    coneOf(zId[b], coneB);\n    if (b + 1 <= N && zId[b + 1] >= 0) coneOf(zId[b + 1], coneB);\n    const coneBelow = new Set<number>();\n    if (b - 1 >= 0 && zId[b - 1] >= 0) coneOf(zId[b - 1], coneBelow);\n\n    const localGates: number[] = [];\n    for (const w of coneB) {\n      if (coneBelow.has(w)) continue;\n      const g = producer[w];\n      if (g >= 0) localGates.push(g);\n    }\n\n    let bestGain = b; // require strict improvement over current b\n    let bestI = -1;\n    let bestJ = -1;\n    for (const gi of localGates) {\n      for (let gj = 0; gj < M; gj++) {\n        if (gj === gi) continue;\n        swap(gi, gj);\n        let nb = lowestWrongBit();\n        swap(gi, gj); // restore\n        if (nb < 0) nb = N + 1; // fully correct\n        if (nb > bestGain) {\n          bestGain = nb;\n          bestI = gi;\n          bestJ = gj;\n        }\n      }\n    }\n\n    if (bestI < 0) break; // no improving swap found\n    swappedWires.push(wireName[currentOut[bestI]], wireName[currentOut[bestJ]]);\n    swap(bestI, bestJ); // commit the repair\n  }\n\n  return swappedWires.sort();\n}\n","structuredPatch":[{"oldStart":190,"oldLines":7,"newStart":190,"newLines":7,"lines":["         setInputs(x, y);","   