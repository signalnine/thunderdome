@@ -0,0 +1,49 @@
+/**
+ * A deliberately tiny cron implementation supporting only the three patterns
+ * required by the queue:
+ *
+ *   - `every N minutes` via the form star-slash-N (on minutes divisible by N)
+ *   - `0 * * * *`    — every hour on the hour
+ *   - `0 0 * * *`    — every day at midnight
+ *
+ * Times are computed in the local timezone.
+ */
+
+const EVERY_N_MINUTES = /^\*\/(\d+) \* \* \* \*$/;
+
+/** Throws if the expression is not one of the supported patterns. */
+export function validateCron(expr: string): void {
+  lastFireTime(expr, 0);
+}
+
+/**
+ * Returns the most recent instant at or before `now` (ms) at which the given
+ * cron expression fires. Throws for unsupported expressions.
+ */
+export function lastFireTime(expr: string, now: number): number {
+  const everyN = EVERY_N_MINUTES.exec(expr);
+  if (everyN) {
+    const n = Number(everyN[1]);
+    if (!Number.isInteger(n) || n <= 0) {
+      throw new Error(`Invalid cron interval in expression: ${expr}`);
+    }
+    const d = new Date(now);
+    d.setSeconds(0, 0);
+    d.setMinutes(Math.floor(d.getMinutes() / n) * n);
+    return d.getTime();
+  }
+
+  if (expr === '0 * * * *') {
+    const d = new Date(now);
+    d.setMinutes(0, 0, 0);
+    return d.getTime();
+  }
+
+  if (expr === '0 0 * * *') {
+    const d = new Date(now);
+    d.setHours(0, 0, 0, 0);
+    return d.getTime();
+  }
+
+  throw new Error(`Unsupported cron expression: ${expr}`);
+}
