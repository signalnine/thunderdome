+describe('Phase 7: dependencies', () => {
+  it('blocks tasks until dependencies complete', () => {
+    const q = new TaskQueue();
+    const dep = q.add('dep');
+    const child = q.add('child', { dependencies: [dep.id] });
+
+    expect(child.status).toBe('blocked');
+    expect(q.getNext()?.id).toBe(dep.id); // child is blocked
+    expect(q.getNext()).toBeNull();
+
+    const status = q.getDependencyStatus(child.id);
+    expect(status.blocked).toBe(true);
+    expect(status.pending).toEqual([dep.id]);
+
+    q.complete(dep.id);
+    expect(child.status).toBe('pending');
+    expect(q.getDependencyStatus(child.id).blocked).toBe(false);
+    expect(q.getNext()?.id).toBe(child.id);
+  });
+
+  it('rejects non-existent and circular dependencies', () => {
+    const q = new TaskQueue();
+    expect(() => q.add('x', { dependencies: ['ghost'] })).toThrow();
+  });
+
+  it('keeps dependents blocked when a dependency fails', () => {
+    const q = new TaskQueue();
+    const dep = q.add('dep', { maxRetries: 0 });
+    const child = q.add('child', { dependencies: [dep.id] });
+    q.getNext();
+    q.fail(dep.id);
+    expect(dep.status).toBe('failed');
+    expect(child.status).toBe('blocked');
+  });
+
+  it('treats already-completed dependencies as resolved', () => {
+    const q = new TaskQueue();
+    const dep = q.add('dep');
+    q.getNext();
+    q.complete(dep.id);
+    const child = q.add('child', { dependencies: [dep.id] });
+    expect(child.status).toBe('pending');
+  });
+});
+
+describe('Phase 8: concurrency control', () => {
+  it('limits simultaneous processing and respects priority', () => {
+    const q = new TaskQueue();
+    q.setConcurrency('work', 1);
+    const hi = q.add('hi', { priority: 1, queue: 'work' });
+    q.add('lo', { priority: 9, queue: 'work' });
+
+    expect(q.getConcurrency('work')).toEqual({ limit: 1, active: 0 });
+    expect(q.getNext('work')?.id).toBe(hi.id);
+    expect(q.getConcurrency('work').active).toBe(1);
+    // limit reached
+    expect(q.getNext('work')).toBeNull();
+
+    q.complete(hi.id);
+    expect(q.getConcurrency('work').active).toBe(0);
+    expect(q.getNext('work')?.payload).toBe('lo');
+  });
+
+  it('defaults to unlimited', () => {
+    const q = new TaskQueue();
+    q.add('a');
+    q.add('b');
+    expect(q.getConcurrency().limit).toBeNull();
+    expect(q.getNext()).not.toBeNull();
+    expect(q.getNext()).not.toBeNull();
+  });
+});
+
+describe('Phase 9: progress and cancellation', () => {
+  it('reports and queries progress with listeners', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.getNext();
+    const seen: number[] = [];
+    const unsub = q.onProgress(t.id, (p) => seen.push(p.percent));
+    q.setProgress(t.id, 50, 'half');
+    expect(q.getProgress(t.id)).toEqual({ percent: 50, message: 'half' });
+    unsub();
+    q.setProgress(t.id, 75);
+    expect(seen).toEqual([50]);
+    expect(() => q.setProgress(t.id, 150)).toThrow();
+  });
+
+  it('cancels pending tasks (removed) and processing tasks (never retried)', () => {
+    const q = new TaskQueue();
+    const pending = q.add('p');
+    const other = q.add('o');
+    q.cancel(pending.id);
+    expect(pending.status).toBe('cancelled');
+    expect(q.getNext()?.id).toBe(other.id);
+
+    const proc = q.add('proc', { maxRetries: 5 });
+    q.getNext();
+    void proc;
+    // Most recently added & pulled is `proc`? pull explicitly:
+    const t = q.getTask(proc.id)!;
+    q.cancel(t.id);
+    expect(t.status).toBe('cancelled');
+    // fail after cancel must not retry
+    q.fail(t.id, new Error('late'));
+    expect(t.status).toBe('cancelled');
+  });
+});
