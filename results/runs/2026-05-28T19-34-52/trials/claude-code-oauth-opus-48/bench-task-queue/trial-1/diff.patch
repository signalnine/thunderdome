+{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_0193UMWJXdrP58kML3GPLBwF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013WhmnWccrbBctSoQsKxHzv","name":"Write","input":{"file_path":"/workspace/tests/queue.test.ts","content":"import { describe, it, expect, vi } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\n/** Helper: a queue with a controllable logical clock. */\nfunction withClock(start = 0) {\n  const state = { now: start };\n  const queue = new TaskQueue({ clock: () => state.now });\n  return { queue, advance: (ms: number) => (state.now += ms), set: (n: number) => (state.now = n), state };\n}\n\ndescribe('Phase 1: basic FIFO', () => {\n  it('adds and retrieves tasks in FIFO order', () => {\n    const q = new TaskQueue();\n    const a = q.add({ n: 1 });\n    const b = q.add({ n: 2 });\n    expect(a.id).not.toBe(b.id);\n    expect(a.status).toBe('pending');\n    expect(typeof a.createdAt).toBe('number');\n    expect(q.size()).toBe(2);\n\n    const first = q.getNext();\n    expect(first?.id).toBe(a.id);\n    expect(first?.status).toBe('processing');\n    expect(q.size()).toBe(1);\n\n    const second = q.getNext();\n    expect(second?.id).toBe(b.id);\n    expect(q.getNext()).toBeNull();\n  });\n\n  it('returns null on empty queue', () => {\n    expect(new TaskQueue().getNext()).toBeNull();\n  });\n});\n\ndescribe('Phase 2: named queues', () => {\n  it('keeps queues independent and lists them', () => {\n    const q = new TaskQueue();\n    q.add('a', { queue: 'emails' });\n    q.add('b', { queue: 'images' });\n    q.add('c'); // default\n\n    expect(q.size('emails')).toBe(1);\n    expect(q.size('images')).toBe(1);\n    expect(q.size()).toBe(1);\n    expect(q.listQueues().sort()).toEqual(['default', 'emails', 'images']);\n\n    expect(q.getNext('emails')?.payload).toBe('a');\n    expect(q.getNext('emails')).toBeNull();\n    expect(q.getNext('images')?.payload).toBe('b');\n  });\n\n  it('returns null for non-existent queue', () => {\n    expect(new TaskQueue().getNext('nope')).toBeNull();\n    expect(new TaskQueue().size('nope')).toBe(0);\n  });\n});\n\ndescribe('Phase 3: priority', () => {\n  it('returns higher priority (lower number) first, FIFO within priority', () => {\n    const q = new TaskQueue();\n    q.add('low', { priority: 8 });\n    const hi1 = q.add('hi1', { priority: 1 });\n    const mid = q.add('mid'); // default 5\n    const hi2 = q.add('hi2', { priority: 1 });\n\n    expect(q.getNext()?.id).toBe(hi1.id);\n    expect(q.getNext()?.id).toBe(hi2.id);\n    expect(q.getNext()?.payload).toBe('mid');\n    void mid;\n    expect(q.getNext()?.payload).toBe('low');\n  });\n\n  it('rejects invalid priorities', () => {\n    const q = new TaskQueue();\n    expect(() => q.add('x', { priority: 0 })).toThrow();\n    expect(() => q.add('x', { priority: 11 })).toThrow();\n    expect(() => q.add('x', { priority: 2.5 })).toThrow();\n  });\n\n  it('exposes priority on the task', () => {\n    expect(new TaskQueue().add('x', { priority: 3 }).priority).toBe(3);\n    expect(new TaskQueue().add('x').priority).toBe(5);\n  });\n});\n\ndescribe('Phase 4: delayed tasks', () => {\n  it('does not return delayed tasks until available', () => {\n    const { queue: q, advance } = withClock();\n    const delayed = q.add('later', { delay: 1000 });\n    const now = q.add('now');\n    expect(delayed.status).toBe('delayed');\n    expect(delayed.availableAt).toBe(1000);\n\n    // Non-delayed preferred; delayed not yet available.\n    expect(q.getNext()?.id).toBe(now.id);\n    expect(q.getNext()).toBeNull();\n\n    advance(1000);\n    expect(delayed.status).toBe('pending');\n    expect(q.getNext()?.id).toBe(delayed.id);\n  });\n\n  it('supports absolute availableAt and orders by availability then priority', () => {\n    const { queue: q, set } = withClock(0);\n    const t1 = q.add('a', { availableAt: 500, priority: 5 });\n    const t2 = q.add('b', { availableAt: 200, priority: 5 });\n    set(1000);\n    // Both available; t2 became available earlier so it wins the tie.\n    expect(q.getNext()?.id).toBe(t2.id);\n    expect(q.getNext()?.id).toBe(t1.id);\n  });\n});\n\ndescribe('Phase 5: retry with backoff', () => {\n  it('retries with exponential backoff and tracks attempts', () => {\n    const { queue: q, advance, state } = withClock(0);\n    const t = q.add('job', { maxRetries: 2, baseDelay: 1000 });\n\n    let task = q.getNext();\n    expect(task?.id).toBe(t.id);\n    expect(t.attempts).toBe(1);\n    q.fail(t.id, new Error('boom'));\n    expect(t.status).toBe('delayed');\n    expect(t.availableAt).toBe(1000); // base * 2^0\n\n    advance(1000);\n    task = q.getNext();\n    expect(t.attempts).toBe(2);\n    q.fail(t.id);\n    expect(t.availableAt).toBe(state.now + 2000); // base * 2^1\n\n    advance(2000);\n    task = q.getNext();\n    expect(t.attempts).toBe(3);\n    q.fail(t.id, new Error('final'));\n    expect(t.status).toBe('failed');\n    expect(t.error?.message).toBe('final');\n  });\n\n  it('completes tasks and frees them', () => {\n    const q = new TaskQueue();\n    const t = q.add('x');\n    q.getNext();\n    q.complete(t.id, 42);\n    expect(t.status).toBe('completed');\n    expect(t.result).toBe(42);\n  });\n});\n\ndescribe('Phase 6: dead letter queue', () => {\n  it('moves exhausted tasks to DLQ and can restore them', () => {\n    const { queue: q, advance } = withClock(0);\n    const t = q.add('job', { maxRetries: 0, queue: 'work' });\n    q.getNext('work');\n    q.fail(t.id, new Error('dead'));\n\n    expect(t.status).toBe('failed');\n    const dlq = q.getDeadLetter('work');\n    expect(dlq.map((x) => x.id)).toEqual([t.id]);\n    expect(dlq[0].error?.message).toBe('dead');\n\n    q.retryDeadLetter(t.id);\n    expect(q.getDeadLetter('work')).toHaveLength(0);\n    expect(t.attempts).toBe(0);\n    advance(0);\n    expect(q.getNext('work')?.id).toBe(t.id);\n  });\n\n  it('clears the DLQ and keeps DLQs per-queue', () => {\n    const q = new TaskQueue();\n    const a = q.add('a', { maxRetries: 0, queue: 'q1' });\n    const b = q.add('b', { maxRetries: 0, queue: 'q2' });\n    q.getNext('q1');\n    q.fail(a.id);\n    q.getNext('q2');\n    q.fail(b.id);\n    expect(q.getDeadLetter('q1')).toHaveLength(1);\n    expect(q.getDeadLetter('q2')).toHaveLength(1);\n    q.clearDeadLetter('q1');\n    expect(q.getDeadLetter('q1')).toHaveLength(0);\n    expect(q.getDeadLetter('q2')).toHaveLength(1);\n  });\n});\n\ndescribe('Phase 7: dependencies', () => {\n  it('blocks tasks until dependencies complete', () => {\n    const q = new TaskQueue();\n    const dep = q.add('dep');\n    const child = q.add('child', { dependencies: [dep.id] });\n\n    expect(child.status).toBe('blocked');\n    expect(q.getNext()?.id).toBe(dep.id); // child is blocked\n    expect(q.getNext()).toBeNull();\n\n    const status = q.getDependencyStatus(child.id);\n    expect(status.blocked).toBe(true);\n    expect(status.pending).toEqual([dep.id]);\n\n    q.complete(dep.id);\n    expect(child.status).toBe('pending');\n    expect(q.getDependencyStatus(child.id).blocked).toBe(false);\n    expect(q.getNext()?.id).toBe(child.id);\n  });\n\n  it('rejects non-existent and circular dependencies', () => {\n    const q = new TaskQueue();\n    expect(() => q.add('x', { dependencies: ['ghost'] })).toThrow();\n  });\n\n  it('keeps dependents blocked when a dependency fails', () => {\n    const q = new TaskQueue();\n    const dep = q.add('dep', { maxRetries: 0 });\n    const child = q.add('child', { dependencies: [dep.id] });\n    q.getNext();\n    q.fail(dep.id);\n    expect(dep.status).toBe('failed');\n    expect(child.status).toBe('blocked');\n  });\n\n  it('treats already-completed dependencies as resolved', () => {\n    const q = new TaskQueue();\n    const dep = q.add('dep');\n    q.getNext();\n    q.complete(dep.id);\n    const child = q.add('child', { dependencies: [dep.id] });\n    expect(child.status).toBe('pending');\n  });\n});\n\ndescribe('Phase 8: concurrency control', () => {\n  it('limits simultaneous processing and respects priority', () => {\n    const q = new TaskQueue();\n    q.setConcurrency('work', 1);\n    const hi = q.add('hi', { priority: 1, queue: 'work' });\n    q.add('lo', { priority: 9, queue: 'work' });\n\n    expect(q.getConcurrency('work')).toEqual({ limit: 1, active: 0 });\n    expect(q.getNext('work')?.id).toBe(hi.id);\n    expect(q.getConcurrency('work').active).toBe(1);\n    // limit reached\n    expect(q.getNext('work')).toBeNull();\n\n    q.complete(hi.id);\n    expect(q.getConcurrency('work').active).toBe(0);\n    expect(q.getNext('work')?.payload).toBe('lo');\n  });\n\n  it('defaults to unlimited', () => {\n    const q = new TaskQueue();\n    q.add('a');\n    q.add('b');\n    expect(q.getConcurrency().limit).toBeNull();\n    expect(q.getNext()).not.toBeNull();\n    expect(q.getNext()).not.toBeNull();\n  });\n});\n\ndescribe('Phase 9: progress and cancellation', () => {\n  it('reports and queries progress with listeners', () => {\n    const q = new TaskQueue();\n    const t = q.add('x');\n    q.getNext();\n    const seen: number[] = [];\n    const unsub = q.onProgress(t.id, (p) => seen.push(p.percent));\n    q.setProgress(t.id, 50, 'half');\n    expect(q.getProgress(t.id)).toEqual({ percent: 50, message: 'half' });\n    unsub();\n    q.setProgress(t.id, 75);\n    expect(seen).toEqual([50]);\n    expect(() => q.setProgress(t.id, 150)).toThrow();\n  });\n\n  it('cancels pending tasks (removed) and processing tasks (never retried)', () => {\n    const q = new TaskQueue();\n    const pending = q.add('p');\n    const other = q.add('o');\n    q.cancel(pending.id);\n    expect(pending.status).toBe('cancelled');\n    expect(q.getNext()?.id).toBe(other.id);\n\n    const proc = q.add('proc', { maxRetries: 5 });\n    q.getNext();\n    void proc;\n    // Most recently added & pulled is `proc`? pull explicitly:\n    const t = q.getTask(proc.id)!;\n    q.cancel(t.id);\n    expect(t.status).toBe('cancelled');\n    // fail after cancel must not retry\n    q.fail(t.id, new Error('late'));\n    expect(t.status).toBe('cancelled');\n  });\n});\n\ndescribe('Phase 10: recurring tasks', () => {\n  it('enqueues tasks when schedules are due via tick', () => {\n    const { queue: q, set } = withClock(0);\n    const id = q.schedule('*/5 * * * *', 'cron', { kind: 'beat' });\n    expect(q.listSchedules().map((s) => s.id)).toContain(id);\n\n    // Not yet a new boundary.\n    set(60_000); // 1 minute\n    expect(q.tick()).toHaveLength(0);\n\n    set(5 * 60_000); // 5 minutes -> boundary crossed\n    const created = q.tick();\n    expect(created).toHaveLength(1);\n    expect(q.size('cron')).toBe(1);\n    expect(created[0].payload).toEqual({ kind: 'beat' });\n\n    // Removing stops future occurrences.\n    q.removeSchedule(id);\n    set(10 * 60_000);\n    expect(q.tick()).toHaveLength(0);\n  });\n\n  it('supports hourly and daily expressions', () => {\n    const { queue: q, set } = withClock(0);\n    q.schedule('0 * * * *', 'hourly', 'h');\n    set(60 * 60_000); // 1 hour\n    expect(q.tick()).toHaveLength(1);\n  });\n});\n\ndescribe('Phase 11: middleware pipeline', () => {\n  it('runs middleware in order then the handler', async () => {\n    const q = new TaskQueue();\n    const order: string[] = [];\n    q.use('p', async (task, next) => {\n      order.push('mw1-before');\n      (task.metadata as Record<string, unknown>).tagged = true;\n      await next();\n      order.push('mw1-after');\n    });\n    q.use('p', async (_task, next) => {\n      order.push('mw2');\n      await next();\n    });\n    q.setHandler('p', (task) => {\n      order.push('handler');\n      return (task.payload as { v: number }).v * 2;\n    });\n\n    const t = q.add({ v: 21 }, { queue: 'p' });\n    const done = await q.process('p');\n    expect(done?.id).toBe(t.id);\n    expect(t.status).toBe('completed');\n    expect(t.result).toBe(42);\n    expect(t.metadata.tagged).toBe(true);\n    expect(order).toEqual(['mw1-before', 'mw2', 'handler', 'mw1-after']);\n  });\n\n  it('skips the handler if middleware does not call next', async () => {\n    const q = new TaskQueue();\n    let handlerRan = false;\n    q.use('p', async () => {\n      /* does not call next */\n    });\n    q.setHandler('p', () => {\n      handlerRan = true;\n    });\n    const t = q.add('x', { queue: 'p' });\n    await q.process('p');\n    expect(handlerRan).toBe(false);\n    expect(t.status).toBe('completed');\n  });\n\n  it('fails the task if middleware or handler throws', async () => {\n    const q = new TaskQueue();\n    q.setHandler('p', () => {\n      throw new Error('handler failed');\n    });\n    const t = q.add('x', { queue: 'p', maxRetries: 0 });\n    await q.process('p');\n    expect(t.status).toBe('failed');\n    expect(t.error?.message).toBe('handler failed');\n  });\n\n  it('process returns null when nothing is available', async () => {\n    expect(await new TaskQueue().process()).toBeNull();\n  });\n});\n\ndescribe('Phase 12: graceful shutdown', () => {\n  it('stops accepting tasks and completes immediately when idle', async () => {\n    const q = new TaskQueue();\n    const cb = vi.fn();\n    q.onShutdown(cb);\n    const summary = await q.shutdown();\n    expect(cb).toHaveBeenCalledOnce();\n    expect(summary.completed).toBe(0);\n    expect(summary.forceCancelled).toBe(0);\n    expect(() => q.add('x')).toThrow();\n    expect(q.isAccepting).toBe(false);\n  });\n\n  it('waits for in-flight tasks and reports completion', async () => {\n    const q = new TaskQueue();\n    let resolveHandler!: () => void;\n    q.setHandler('p', () =>\n      new Promise<void>((resolve) => {\n        resolveHandler = resolve;\n      }),\n    );\n    q.add('x', { queue: 'p' });\n    const running = q.process('p');\n    const shutdownP = q.shutdown({ timeout: 5000 });\n    resolveHandler();\n    await running;\n    const summary = await shutdownP;\n    expect(summary.completed).toBe(1);\n    expect(summary.