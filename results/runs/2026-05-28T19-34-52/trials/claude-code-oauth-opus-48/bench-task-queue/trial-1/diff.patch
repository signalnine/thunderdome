+describe('Phase 12: graceful shutdown', () => {
+  it('stops accepting tasks and completes immediately when idle', async () => {
+    const q = new TaskQueue();
+    const cb = vi.fn();
+    q.onShutdown(cb);
+    const summary = await q.shutdown();
+    expect(cb).toHaveBeenCalledOnce();
+    expect(summary.completed).toBe(0);
+    expect(summary.forceCancelled).toBe(0);
+    expect(() => q.add('x')).toThrow();
+    expect(q.isAccepting).toBe(false);
+  });
+
+  it('waits for in-flight tasks and reports completion', async () => {
+    const q = new TaskQueue();
+    let resolveHandler!: () => void;
+    q.setHandler('p', () =>
+      new Promise<void>((resolve) => {
+        resolveHandler = resolve;
+      }),
+    );
+    q.add('x', { queue: 'p' });
+    const running = q.process('p');
+    const shutdownP = q.shutdown({ timeout: 5000 });
+    resolveHandler();
+    await running;
+    const summary = await shutdownP;
+    expect(summary.completed).toBe(1);
+    expect(summary.forceCancelled).toBe(0);
+  });
+
+  it('force-cancels tasks that exceed the timeout', async () => {
+    const q = new TaskQueue();
+    q.setHandler('p', (_t, ctx) =>
+      new Promise<void>((resolve) => {
+        // Never resolves on its own; respects abort.
+        ctx.signal.addEventListener('abort', () => resolve());
+      }),
+    );
+    q.add('x', { queue: 'p' });
+    void q.process('p');
+    const summary = await q.shutdown({ timeout: 50 });
+    expect(summary.forceCancelled).toBe(1);
+  });
+
+  it('is safe to call multiple times', async () => {
+    const q = new TaskQueue();
+    const s1 = q.shutdown();
+    const s2 = q.shutdown();
+    expect(await s1).toBe(await s2);
+  });
+});
