+describe('Phase 11: middleware pipeline', () => {
+  it('runs middleware in order then the handler', async () => {
+    const q = new TaskQueue();
+    const order: string[] = [];
+    q.use('p', async (task, next) => {
+      order.push('mw1-before');
+      (task.metadata as Record<string, unknown>).tagged = true;
+      await next();
+      order.push('mw1-after');
+    });
+    q.use('p', async (_task, next) => {
+      order.push('mw2');
+      await next();
+    });
+    q.setHandler('p', (task) => {
+      order.push('handler');
+      return (task.payload as { v: number }).v * 2;
+    });
+
+    const t = q.add({ v: 21 }, { queue: 'p' });
+    const done = await q.process('p');
+    expect(done?.id).toBe(t.id);
+    expect(t.status).toBe('completed');
+    expect(t.result).toBe(42);
+    expect(t.metadata.tagged).toBe(true);
+    expect(order).toEqual(['mw1-before', 'mw2', 'handler', 'mw1-after']);
+  });
+
+  it('skips the handler if middleware does not call next', async () => {
+    const q = new TaskQueue();
+    let handlerRan = false;
+    q.use('p', async () => {
+      /* does not call next */
+    });
+    q.setHandler('p', () => {
+      handlerRan = true;
+    });
+    const t = q.add('x', { queue: 'p' });
+    await q.process('p');
+    expect(handlerRan).toBe(false);
+    expect(t.status).toBe('completed');
+  });
+
+  it('fails the task if middleware or handler throws', async () => {
+    const q = new TaskQueue();
+    q.setHandler('p', () => {
+      throw new Error('handler failed');
+    });
+    const t = q.add('x', { queue: 'p', maxRetries: 0 });
+    await q.process('p');
+    expect(t.status).toBe('failed');
+    expect(t.error?.message).toBe('handler failed');
+  });
+
+  it('process returns null when nothing is available', async () => {
+    expect(await new TaskQueue().process()).toBeNull();
+  });
+});
