+describe('Phase 10: recurring tasks', () => {
+  it('enqueues tasks when schedules are due via tick', () => {
+    const { queue: q, set } = withClock(0);
+    const id = q.schedule('*/5 * * * *', 'cron', { kind: 'beat' });
+    expect(q.listSchedules().map((s) => s.id)).toContain(id);
+
+    // Not yet a new boundary.
+    set(60_000); // 1 minute
+    expect(q.tick()).toHaveLength(0);
+
+    set(5 * 60_000); // 5 minutes -> boundary crossed
+    const created = q.tick();
+    expect(created).toHaveLength(1);
+    expect(q.size('cron')).toBe(1);
+    expect(created[0].payload).toEqual({ kind: 'beat' });
+
+    // Removing stops future occurrences.
+    q.removeSchedule(id);
+    set(10 * 60_000);
+    expect(q.tick()).toHaveLength(0);
+  });
+
+  it('supports hourly and daily expressions', () => {
+    const { queue: q, set } = withClock(0);
+    q.schedule('0 * * * *', 'hourly', 'h');
+    set(60 * 60_000); // 1 hour
+    expect(q.tick()).toHaveLength(1);
+  });
+});
