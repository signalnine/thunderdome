@@ -0,0 +1,94 @@
+import type { TaskError, TaskProgress, TaskStatus } from './types.js';
+
+/** Internal config used by the manager to construct a task. */
+export interface TaskInit {
+  id: string;
+  payload: unknown;
+  queue: string;
+  priority: number;
+  createdAt: number;
+  availableAt: number;
+  maxRetries: number;
+  baseDelay: number;
+  dependencies: string[];
+  seq: number;
+  clock: () => number;
+}
+
+/**
+ * A unit of work in the queue.
+ *
+ * `status` is a computed property. While a task is waiting it is reported as
+ * `blocked` (unresolved dependencies), `delayed` (not yet available), or
+ * `pending` (ready). Once it is pulled, completed, failed, or cancelled, the
+ * settled state is stored in `_settled` and reported directly.
+ */
+export class Task<T = unknown> {
+  readonly id: string;
+  payload: T;
+  readonly queue: string;
+  priority: number;
+  readonly createdAt: number;
+  /** Timestamp at which this task becomes available for processing. */
+  availableAt: number;
+  /** Number of processing attempts made so far. */
+  attempts = 0;
+  maxRetries: number;
+  baseDelay: number;
+  readonly dependencies: string[];
+  /** Dependencies that have not yet completed. */
+  readonly pendingDependencies: Set<string>;
+  error?: TaskError;
+  result?: unknown;
+  progress: TaskProgress = { percent: 0 };
+  /** Arbitrary metadata that middleware may attach. */
+  metadata: Record<string, unknown> = {};
+  /** Sequence number used as a stable FIFO tie-breaker. */
+  readonly seq: number;
+  /** AbortController wired up while the task is processing. */
+  abort?: AbortController;
+
+  /**
+   * Settled/active state. `null` means the task is waiting, in which case the
+   * public {@link status} is derived from time and dependencies.
+   */
+  _settled: 'processing' | 'completed' | 'failed' | 'cancelled' | null = null;
+
+  private readonly clock: () => number;
+
+  constructor(init: TaskInit) {
+    this.id = init.id;
+    this.payload = init.payload as T;
+    this.queue = init.queue;
+    this.priority = init.priority;
+    this.createdAt = init.createdAt;
+    this.availableAt = init.availableAt;
+    this.maxRetries = init.maxRetries;
+    this.baseDelay = init.baseDelay;
+    this.dependencies = [...init.dependencies];
+    this.pendingDependencies = new Set();
+    this.seq = init.seq;
+    this.clock = init.clock;
+  }
+
+  get status(): TaskStatus {
+    if (this._settled !== null) return this._settled;
+    if (this.pendingDependencies.size > 0) return 'blocked';
+    if (this.availableAt > this.clock()) return 'delayed';
+    return 'pending';
+  }
+
+  /** Whether the task is waiting and can be pulled for processing now. */
+  isReady(now: number): boolean {
+    return (
+      this._settled === null &&
+      this.pendingDependencies.size === 0 &&
+      this.availableAt <= now
+    );
+  }
+
+  /** Whether the task is in one of the waiting states. */
+  isWaiting(): boolean {
+    return this._settled === null;
+  }
+}
