diff --git a/tests/queue.test.ts b/tests/queue.test.ts
new file mode 100644
index 0000000..1cc4c94
--- /dev/null
+++ b/tests/queue.test.ts
@@ -0,0 +1,435 @@
+import { describe, it, expect, vi } from 'vitest';
+import { TaskQueue } from '../src/index.js';
+
+/** Helper: a queue with a controllable logical clock. */
+function withClock(start = 0) {
+  const state = { now: start };
+  const queue = new TaskQueue({ clock: () => state.now });
+  return { queue, advance: (ms: number) => (state.now += ms), set: (n: number) => (state.now = n), state };
+}
+
+describe('Phase 1: basic FIFO', () => {
+  it('adds and retrieves tasks in FIFO order', () => {
+    const q = new TaskQueue();
+    const a = q.add({ n: 1 });
+    const b = q.add({ n: 2 });
+    expect(a.id).not.toBe(b.id);
+    expect(a.status).toBe('pending');
+    expect(typeof a.createdAt).toBe('number');
+    expect(q.size()).toBe(2);
+
+    const first = q.getNext();
+    expect(first?.id).toBe(a.id);
+    expect(first?.status).toBe('processing');
+    expect(q.size()).toBe(1);
+
+    const second = q.getNext();
+    expect(second?.id).toBe(b.id);
+    expect(q.getNext()).toBeNull();
+  });
+
+  it('returns null on empty queue', () => {
+    expect(new TaskQueue().getNext()).toBeNull();
+  });
+});
+
+describe('Phase 2: named queues', () => {
+  it('keeps queues independent and lists them', () => {
+    const q = new TaskQueue();
+    q.add('a', { queue: 'emails' });
+    q.add('b', { queue: 'images' });
+    q.add('c'); // default
+
+    expect(q.size('emails')).toBe(1);
+    expect(q.size('images')).toBe(1);
+    expect(q.size()).toBe(1);
+    expect(q.listQueues().sort()).toEqual(['default', 'emails', 'images']);
+
+    expect(q.getNext('emails')?.payload).toBe('a');
+    expect(q.getNext('emails')).toBeNull();
+    expect(q.getNext('images')?.payload).toBe('b');
+  });
+
+  it('returns null for non-existent queue', () => {
+    expect(new TaskQueue().getNext('nope')).toBeNull();
+    expect(new TaskQueue().size('nope')).toBe(0);
+  });
+});
+
+describe('Phase 3: priority', () => {
+  it('returns higher priority (lower number) first, FIFO within priority', () => {
+    const q = new TaskQueue();
+    q.add('low', { priority: 8 });
+    const hi1 = q.add('hi1', { priority: 1 });
+    const mid = q.add('mid'); // default 5
+    const hi2 = q.add('hi2', { priority: 1 });
+
+    expect(q.getNext()?.id).toBe(hi1.id);
+    expect(q.getNext()?.id).toBe(hi2.id);
+    expect(q.getNext()?.payload).toBe('mid');
+    void mid;
+    expect(q.getNext()?.payload).toBe('low');
+  });
+
+  it('rejects invalid priorities', () => {
+    const q = new TaskQueue();
+    expect(() => q.add('x', { priority: 0 })).toThrow();
+    expect(() => q.add('x', { priority: 11 })).toThrow();
+    expect(() => q.add('x', { priority: 2.5 })).toThrow();
+  });
+
+  it('exposes priority on the task', () => {
+    expect(new TaskQueue().add('x', { priority: 3 }).priority).toBe(3);
+    expect(new TaskQueue().add('x').priority).toBe(5);
+  });
+});
+
+describe('Phase 4: delayed tasks', () => {
+  it('does not return delayed tasks until available', () => {
+    const { queue: q, advance } = withClock();
+    const delayed = q.add('later', { delay: 1000 });
+    const now = q.add('now');
+    expect(delayed.status).toBe('delayed');
+    expect(delayed.availableAt).toBe(1000);
+
+    // Non-delayed preferred; delayed not yet available.
+    expect(q.getNext()?.id).toBe(now.id);
+    expect(q.getNext()).toBeNull();
+
+    advance(1000);
+    expect(delayed.status).toBe('pending');
+    expect(q.getNext()?.id).toBe(delayed.id);
+  });
+
+  it('supports absolute availableAt and orders by availability then priority', () => {
+    const { queue: q, set } = withClock(0);
+    const t1 = q.add('a', { availableAt: 500, priority: 5 });
+    const t2 = q.add('b', { availableAt: 200, priority: 5 });
+    set(1000);
+    // Both available; t2 became available earlier so it wins the tie.
+    expect(q.getNext()?.id).toBe(t2.id);
+    expect(q.getNext()?.id).toBe(t1.id);
+  });
+});
+
+describe('Phase 5: retry with backoff', () => {
+  it('retries with exponential backoff and tracks attempts', () => {
+    const { queue: q, advance, state } = withClock(0);
+    const t = q.add('job', { maxRetries: 2, baseDelay: 1000 });
+
+    let task = q.getNext();
+    expect(task?.id).toBe(t.id);
+    expect(t.attempts).toBe(1);
+    q.fail(t.id, new Error('boom'));
+    expect(t.status).toBe('delayed');
+    expect(t.availableAt).toBe(1000); // base * 2^0
+
+    advance(1000);
+    task = q.getNext();
+    expect(t.attempts).toBe(2);
+    q.fail(t.id);
+    expect(t.availableAt).toBe(state.now + 2000); // base * 2^1
+
+    advance(2000);
+    task = q.getNext();
+    expect(t.attempts).toBe(3);
+    q.fail(t.id, new Error('final'));
+    expect(t.status).toBe('failed');
+    expect(t.error?.message).toBe('final');
+  });
+
+  it('completes tasks and frees them', () => {
+    const q = new TaskQueue();
+    const t = q.add('x');
+    q.getNext();
+    q.complete(t.id, 42);
+    expect(t.status).toBe('completed');
+    expect(t.result).toBe(42);
+  });
+});
+
+describe('Phase 6: dead letter queue', () => {
+  it('moves exhausted tasks to DLQ and can restore them', () => {
+    const { queue: q, advance } = withClock(0);
+    const t = q.add('job', { maxRetries: 0, queue: 'work' });
+    q.getNext('work');
+    q.fail(t.id, new Error('dead'));
+
+    expect(t.status).toBe('failed');
+    const dlq = q.getDeadLetter('work');
+    expect(dlq.map((x) => x.id)).toEqual([t.id]);
+    expect(dlq[0].error?.message).toBe('dead');
+
+    q.retryDeadLetter(t.id);
+    expect(q.getDeadLetter('work')).toHaveLength(0);
+    expect(t.attempts).toBe(0);
+    advance(0);
+    expect(q.getNext('work')?.id).toBe(t.id);
+  });
+
+  it('clears the DLQ and keeps DLQs per-queue', () => {
+    const q = new TaskQueue();
+    const a = q.add('a', { maxRetries: 0, queue: 'q1' });
+    const b = q.add('b', { maxRetries: 0, queue: 'q2' });
+    q.getNext('q1');
+    q.fail(a.id);
+    q.getNext('q2');
+    q.fail(b.id);
+    expect(q.getDeadLetter('q1')).toHaveLength(1);
+    expect(q.getDeadLetter('q2')).toHaveLength(1);
+    q.clearDeadLetter('q1');
+    expect(q.getDeadLetter('q1')).toHaveLength(0);
+    expect(q.getDeadLetter('q2')).toHaveLength(1);
+  });
+});
