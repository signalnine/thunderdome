+++ b/src/taskQueue.ts
@@ -0,0 +1,633 @@
+import { randomUUID } from 'node:crypto';
+import { lastFireTime, validateCron } from './cron.js';
+import { Task } from './task.js';
+import type {
+  AddOptions,
+  ConcurrencyStatus,
+  DependencyStatus,
+  Handler,
+  Middleware,
+  NextFn,
+  ProgressListener,
+  ScheduleInfo,
+  ShutdownCallback,
+  ShutdownOptions,
+  ShutdownSummary,
+  TaskError,
+} from './types.js';
+
+export const DEFAULT_QUEUE = 'default';
+
+const DEFAULT_PRIORITY = 5;
+const DEFAULT_MAX_RETRIES = 3;
+const DEFAULT_BASE_DELAY = 1000;
+const DEFAULT_SHUTDOWN_TIMEOUT = 30000;
+
+/** Internal per-queue state. */
+class InternalQueue {
+  waiting: Task[] = [];
+  processing = new Set<Task>();
+  deadLetter: Task[] = [];
+  middleware: Middleware[] = [];
+  handler?: Handler;
+  /** Max simultaneous processing tasks; `null` means unlimited. */
+  concurrency: number | null = null;
+
+  constructor(readonly name: string) {}
+}
+
+interface Schedule {
+  id: string;
+  cron: string;
+  queue: string;
+  template: unknown;
+  options: AddOptions;
+  lastRun: number;
+}
+
+export interface TaskQueueOptions {
+  /** Injectable clock for deterministic testing of delays and scheduling. */
+  clock?: () => number;
+}
+
+/**
+ * An in-memory, dependency-free task queue supporting named queues, priority,
+ * delays, retries with backoff, dead-letter handling, dependencies, concurrency
+ * limits, progress/cancellation, recurring schedules, a middleware pipeline,
+ * and graceful shutdown.
+ */
+export class TaskQueue {
+  private readonly queues = new Map<string, InternalQueue>();
+  private readonly tasks = new Map<string, Task>();
+  /** Reverse dependency edges: dependency id -> set of dependent task ids. */
+  private readonly dependents = new Map<string, Set<string>>();
+  private readonly progressListeners = new Map<string, Set<ProgressListener>>();
+  private readonly schedules = new Map<string, Schedule>();
+  private readonly shutdownCallbacks = new Set<ShutdownCallback>();
+  private readonly inFlight = new Set<Promise<unknown>>();
+
+  private readonly clock: () => number;
+  private seqCounter = 0;
+
+  private accepting = true;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+
+  constructor(options: TaskQueueOptions = {}) {
+    this.clock = options.clock ?? Date.now;
+  }
+
+  private now(): number {
+    return this.clock();
+  }
+
+  // --- Queue management -----------------------------------------------------
+
+  private getOrCreateQueue(name: string): InternalQueue {
+    let q = this.queues.get(name);
+    if (!q) {
+      q = new InternalQueue(name);
+      this.queues.set(name, q);
+    }
+    return q;
+  }
+
+  /** Lists the names of all queues that currently exist. */
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  // --- Adding tasks (Phase 1-7) --------------------------------------------
+
+  /**
+   * Adds a task with the given payload and options. Returns the created task.
+   * Throws if the system is shutting down.
+   */
+  add<T = unknown>(payload: T, options: AddOptions = {}): Task<T> {
+    if (!this.accepting) {
+      throw new Error('Cannot add tasks: the queue is shutting down.');
+    }
+
+    const queueName = options.queue ?? DEFAULT_QUEUE;
+    const priority = options.priority ?? DEFAULT_PRIORITY;
+    if (!Number.isInteger(priority) || priority < 1 || priority > 10) {
+      throw new Error(`Priority must be an integer from 1 to 10, got: ${priority}`);
+    }
+
+    const maxRetries = options.maxRetries ?? DEFAULT_MAX_RETRIES;
+    if (!Number.isInteger(maxRetries) || maxRetries < 0) {
+      throw new Error(`maxRetries must be a non-negative integer, got: ${maxRetries}`);
+    }
+
+    const baseDelay = options.baseDelay ?? DEFAULT_BASE_DELAY;
+    if (baseDelay < 0) {
+      throw new Error(`baseDelay must be non-negative, got: ${baseDelay}`);
+    }
+
+    const now = this.now();
+    let availableAt = now;
+    if (options.availableAt !== undefined) {
+      availableAt = options.availableAt;
+    } else if (options.delay !== undefined) {
+      if (options.delay < 0) {
+        throw new Error(`delay must be non-negative, got: ${options.delay}`);
+      }
+      availableAt = now + options.delay;
+    }
+
+    const dependencies = options.dependencies ?? [];
+    this.validateDependencies(dependencies);
+
+    const queue = this.getOrCreateQueue(queueName);
+    const task = new Task<T>({
+      id: randomUUID(),
+      payload,
+      queue: queueName,
+      priority,
+      createdAt: now,
+      availableAt,
+      maxRetries,
+      baseDelay,
+      dependencies,
+      seq: this.seqCounter++,
+      clock: this.clock,
+    });
+
+    // Wire up dependency tracking: only count not-yet-completed dependencies.
+    for (const depId of dependencies) {
+      const dep = this.tasks.get(depId);
+      if (!dep || dep.status !== 'completed') {
+        task.pendingDependencies.add(depId);
+      }
+      let set = this.dependents.get(depId);
+      if (!set) {
+        set = new Set();
+        this.dependents.set(depId, set);
+      }
+      set.add(task.id);
+    }
+
+    this.tasks.set(task.id, task);
+    queue.waiting.push(task);
+    return task;
+  }
+
+  private validateDependencies(dependencies: string[]): void {
+    for (const depId of dependencies) {
+      if (!this.tasks.has(depId)) {
+        throw new Error(`Cannot depend on non-existent task: ${depId}`);
+      }
+    }
+    // Cycle detection over the dependency graph, treating the new task as a
+    // node that depends on `dependencies`. Since the new task has no id yet it
+    // cannot be referenced, but we still guard the existing graph + the new
+    // edges defensively.
+    const visiting = new Set<string>();
+    const visited = new Set<string>();
+    const visit = (id: string): void => {
+      if (visited.has(id)) return;
+      if (visiting.has(id)) {
+        throw new Error(`Circular dependency detected involving task: ${id}`);
+      }
+      visiting.add(id);
+      const task = this.tasks.get(id);
+      if (task) {
+        for (const dep of task.dependencies) visit(dep);
+      }
+      visiting.delete(id);
+      visited.add(id);
+    };
+    for (const depId of dependencies) visit(depId);
+  }
+
+  // --- Retrieval (Phase 1-4, 8) --------------------------------------------
+
+  /**
+   * Returns the next ready task from the given queue, transitioning it to the
+   * processing state, or `null` if none is available (empty, all delayed or
+   * blocked, or the concurrency limit has been reached).
+   */
+  getNext(queueName: string = DEFAULT_QUEUE): Task | null {
+    const queue = this.queues.get(queueName);
+    if (!queue) return null;
+
+    if (queue.concurrency !== null && queue.processing.size >= queue.concurrency) {
+      return null;
+    }
+
+    const task = this.pickReady(queue);
+    if (!task) return null;
+
+    const idx = queue.waiting.indexOf(task);
+    queue.waiting.splice(idx, 1);
+    queue.processing.add(task);
+    task._settled = 'processing';
+    task.attempts++;
+    return task;
+  }
+
+  /** Finds the best ready task in a queue, or null. */
+  private pickReady(queue: InternalQueue): Task | null {
+    const now = this.now();
+    let best: Task | null = null;
+    for (const task of queue.waiting) {
+      if (!task.isReady(now)) continue;
+      if (best === null || this.compare(task, best) < 0) {
+        best = task;
+      }
+    }
+    return best;
+  }
+
+  /** Ordering: priority asc, then availability time asc, then FIFO (seq asc). */
+  private compare(a: Task, b: Task): number {
+    if (a.priority !== b.priority) return a.priority - b.priority;
+    if (a.availableAt !== b.availableAt) return a.availableAt - b.availableAt;
+    return a.seq - b.seq;
+  }
+
+  /** Number of tasks currently waiting in the given queue. */
+  size(queueName: string = DEFAULT_QUEUE): number {
+    return this.queues.get(queueName)?.waiting.length ?? 0;
+  }
+
+  /** Looks up a task by id, or returns undefined. */
+  getTask(taskId: string): Task | undefined {
+    return this.tasks.get(taskId);
+  }
+
+  // --- Completion / failure / retry (Phase 5-6) ----------------------------
+
+  /** Marks a processing task as completed. No-op if the task is not processing. */
+  complete(taskId: string, result?: unknown): void {
+    const task = this.requireTask(taskId);
+    if (task._settled !== 'processing') return;
+
+    const queue = this.getOrCreateQueue(task.queue);
+    queue.processing.delete(task);
+    task._settled = 'completed';
+    task.result = result;
+    this.resolveDependents(task.id);
+  }
+
+  /**
+   * Marks a processing task as failed. If retries remain, the task is re-queued
+   * with exponential backoff; otherwise it is moved to the dead letter queue.
+   * No-op if the task is not processing (e.g. it was cancelled).
+   */
+  fail(taskId: string, error?: unknown): void {
+    const task = this.requireTask(taskId);
+    if (task._settled !== 'processing') return;
+
+    const queue = this.getOrCreateQueue(task.queue);
+    queue.processing.delete(task);
+    task.error = toTaskError(error);
+
+    if (task.attempts <= task.maxRetries) {
+      // Schedule a retry. The just-failed attempt number drives the backoff:
+      // attempt 1 -> base * 2^0, attempt 2 -> base * 2^1, ...
+      const delay = task.baseDelay * 2 ** (task.attempts - 1);
+      task.availableAt = this.now() + delay;
+      task._settled = null;
+      queue.waiting.push(task);
+    } else {
+      task._settled = 'failed';
+      queue.deadLetter.push(task);
+    }
+  }
+
+  private resolveDependents(completedId: string): void {
+    const set = this.dependents.get(completedId);
+    if (!set) return;
+    for (const dependentId of set) {
+      this.tasks.get(dependentId)?.pendingDependencies.delete(completedId);
+    }
+  }
+
+  // --- Dead letter queue (Phase 6) -----------------------------------------
+
+  /** Returns the dead-lettered tasks for a queue. */
+  getDeadLetter(queueName: string = DEFAULT_QUEUE): Task[] {
+    return this.queues.get(queueName)?.deadLetter.slice() ?? [];
+  }
+
+  /**
+   * Moves a dead-lettered task back into its original queue for a fresh round
+   * of retries. Throws if the task is not in a dead letter queue.
+   */
+  retryDeadLetter(taskId: string): Task {
+    const task = this.requireTask(taskId);
+    const queue = this.getOrCreateQueue(task.queue);
+    const idx = queue.deadLetter.indexOf(task);
+    if (idx < 0) {
+      throw new Error(`Task is not in a dead letter queue: ${taskId}`);
+    }
+    queue.deadLetter.splice(idx, 1);
+    task.attempts = 0;
+    task.error = undefined;
+    task.availableAt = this.now();
+    task._settled = null;
+    queue.waiting.push(task);
+    return task;
+  }
+
+  /** Clears all dead-lettered tasks for a queue. */
+  clearDeadLetter(queueName: string = DEFAULT_QUEUE): void {
+    const queue = this.queues.get(queueName);
+    if (queue) queue.deadLetter = [];
+  }
+
+  // --- Dependencies (Phase 7) ----------------------------------------------
+
+  /** Returns a snapshot of a task's dependency resolution state. */
+  getDependencyStatus(taskId: string): DependencyStatus {
+    const task = this.requireTask(taskId);
+    const completed = task.dependencies.filter((d) => !task.pendingDependencies.has(d));
+    const pending = [...task.pendingDependencies];
+    return {
+      dependencies: [...task.dependencies],
+      completed,
+      pending,
+      blocked: pending.length > 0,
+    };
+  }
+
+  // --- Concurrency (Phase 8) -----------------------------------------------
+
+  /** Sets the max concurrency for a queue; `null` means unlimited. */
+  setConcurrency(queueName: string, limit: number | null): void {
+    if (limit !== null && (!Number.isInteger(limit) || limit < 0)) {
+      throw new Error(`Concurrency limit must be a non-negative integer or null, got: ${limit}`);
+    }
+    this.getOrCreateQueue(queueName).concurrency = limit;
+  }
+
+  /** Returns the concurrency limit and active count for a queue. */
+  getConcurrency(queueName: string = DEFAULT_QUEUE): ConcurrencyStatus {
+    const queue = this.queues.get(queueName);
+    return {
+      limit: queue?.concurrency ?? null,
+      active: queue?.processing.size ?? 0,
+    };
+  }
+
+  // --- Progress & cancellation (Phase 9) -----------------------------------
+
+  /** Reports progress (0-100) for a task, notifying any listeners. */
+  setProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error(`Progress must be between 0 and 100, got: ${percent}`);
+    }
+    const task = this.requireTask(taskId);
+    task.progress = message === undefined ? { percent } : { percent, message };
+    const listeners = this.progressListeners.get(taskId);
+    if (listeners) {
+      for (const listener of listeners) listener(task.progress, task);
+    }
+  }
+
+  /** Returns a task's current progress. */
+  getProgress(taskId: string): { percent: number; message?: string } {
+    return { ...this.requireTask(taskId).progress };
+  }
+
+  /** Subscribes to progress updates for a task. Returns an unsubscribe function. */
+  onProgress(taskId: string, listener: ProgressListener): () => void {
+    let set = this.progressListeners.get(taskId);
+    if (!set) {
+      set = new Set();
+      this.progressListeners.set(taskId, set);
+    }
+    set.add(listener);
+    return () => {
+      set?.delete(listener);
+    };
+  }
+
+  /**
+   * Cancels a pending or processing task. Pending tasks are removed from the
+   * queue; processing tasks are aborted. Cancelled tasks are never retried.
+   */
+  cancel(taskId: string): void {
+    const task = this.requireTask(taskId);
+    const queue = this.getOrCreateQueue(task.queue);
+
+    if (task.isWaiting()) {
+      const idx = queue.waiting.indexOf(task);
+      if (idx >= 0) queue.waiting.splice(idx, 1);
+      task._settled = 'cancelled';
+      return;
+    }
+
+    if (task._settled === 'processing') {
+      queue.processing.delete(task);
+      task._settled = 'cancelled';
+      task.abort?.abort();
+      return;
+    }
+
+    throw new Error(`Cannot cancel a task in status: ${task.status}`);
+  }
+
+  // --- Recurring schedules (Phase 10) --------------------------------------
+
+  /**
+   * Creates a recurring schedule that enqueues a task on the given queue each
+   * time the cron expression fires (evaluated via {@link tick}). Returns the
+   * schedule id.
+   */
+  schedule(cron: string, queueName: string, template: unknown, options: AddOptions = {}): string {
+    validateCron(cron);
+    const now = this.now();
+    const id = randomUUID();
+    this.schedules.set(id, {
+      id,
+      cron,
+      queue: queueName,
+      template,
+      options,
+      // Anchor to the most recent fire time so it only fires on the *next* boundary.
+      lastRun: lastFireTime(cron, now),
+    });
+    return id;
+  }
+
+  /** Removes a schedule, stopping future occurrences. */
+  removeSchedule(id: string): boolean {
+    return this.schedules.delete(id);
+  }
+
+  /** Lists active schedules. */
+  listSchedules(): ScheduleInfo[] {
+    return [...this.schedules.values()].map((s) => ({
+      id: s.id,
+      cron: s.cron,
+      queue: s.queue,
+    }));
+  }
+
+  /**
+   * Evaluates all schedules and enqueues a task for any that are due since
+   * their last run. Returns the tasks that were enqueued.
+   */
+  tick(now: number = this.now()): Task[] {
+    const created: Task[] = [];
+    if (!this.accepting) return created;
+    for (const schedule of this.schedules.values()) {
+      const fire = lastFireTime(schedule.cron, now);
+      if (fire > schedule.lastRun) {
+        const task = this.add(schedule.template, {
+          ...schedule.options,
+          queue: schedule.queue,
+        });
+        schedule.lastRun = fire;
+        created.push(task);
+      }
+    }
+    return created;
+  }
+
+  // --- Middleware & processing (Phase 11) ----------------------------------
+
+  /** Registers middleware for a queue. Middleware run in registration order. */
+  use(queueName: string, middleware: Middleware): void {
+    this.getOrCreateQueue(queueName).middleware.push(middleware);
+  }
+
+  /** Registers the handler for a queue, invoked after all middleware. */
+  setHandler(queueName: string, handler: Handler): void {
+    this.getOrCreateQueue(queueName).handler = handler;
+  }
+
+  /**
+   * Pulls the next ready task from a queue and processes it through the
+   * middleware pipeline and handler, completing or failing it automatically.
+   * Returns the processed task, or `null` if nothing was available.
+   */
+  async process(queueName: string = DEFAULT_QUEUE): Promise<Task | null> {
+    const task = this.getNext(queueName);
+    if (!task) return null;
+    const queue = this.getOrCreateQueue(queueName);
+    const promise = this.runTask(queue, task);
+    this.inFlight.add(promise);
+    void promise.finally(() => this.inFlight.delete(promise));
+    return promise;
+  }
+
+  private async runTask(queue: InternalQueue, task: Task): Promise<Task> {
+    task.abort = new AbortController();
+    const ctx = { signal: task.abort.signal };
+    try {
+      let reachedHandler = false;
+      const dispatch = async (index: number): Promise<void> => {
+        if (index < queue.middleware.length) {
+          const next: NextFn = () => dispatch(index + 1);
+          await queue.middleware[index](task, next);
+          return;
+        }
+        reachedHandler = true;
+        if (queue.handler) {
+          task.result = await queue.handler(task, ctx);
+        }
+      };
+      await dispatch(0);
+      // If a middleware short-circuited (never called next), the task is
+      // considered skipped and completed without running the handler.
+      void reachedHandler;
+      this.complete(task.id, task.result);
+    } catch (err) {
+      this.fail(task.id, err);
+    }
+    return task;
+  }
+
+  // --- Graceful shutdown (Phase 12) ----------------------------------------
+
+  /** Registers a callback to run during shutdown. Returns an unsubscribe function. */
+  onShutdown(callback: ShutdownCallback): () => void {
+    this.shutdownCallbacks.add(callback);
+    return () => {
+      this.shutdownCallbacks.delete(callback);
+    };
+  }
+
+  /** Whether the queue is still accepting new tasks. */
+  get isAccepting(): boolean {
+    return this.accepting;
+  }
+
+  /**
+   * Initiates an orderly shutdown: stops accepting tasks, runs shutdown
+   * callbacks, waits for in-flight tasks up to `timeout`, force-cancels any
+   * stragglers, and returns a summary. Safe to call multiple times — repeated
+   * calls return the same result.
+   */
+  shutdown(options: ShutdownOptions = {}): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+    this.shutdownPromise = this.doShutdown(options);
+    return this.shutdownPromise;
+  }
+
+  private async doShutdown(options: ShutdownOptions): Promise<ShutdownSummary> {
+    const timeout = options.timeout ?? DEFAULT_SHUTDOWN_TIMEOUT;
+    const start = Date.now();
+    this.accepting = false;
+
+    for (const callback of this.shutdownCallbacks) {
+      await callback();
+    }
+    if (options.onShutdown) {
+      await options.onShutdown();
+    }
+
+    // Snapshot the tasks that are processing when shutdown begins.
+    const initiallyProcessing = this.collectProcessing();
+
+    if (this.inFlight.size > 0) {
+      await Promise.race([
+        Promise.allSettled([...this.inFlight]),
+        new Promise<void>((resolve) => setTimeout(resolve, timeout)),
+      ]);
+    }
+
+    // Force-cancel anything still processing after the timeout.
+    let forceCancelled = 0;
+    for (const task of this.collectProcessing()) {
+      const queue = this.getOrCreateQueue(task.queue);
+      queue.processing.delete(task);
+      task._settled = 'cancelled';
+      task.abort?.abort();
+      forceCancelled++;
+    }
+
+    const completed = initiallyProcessing.filter((t) => t.status === 'completed').length;
+
+    return {
+      completed,
+      forceCancelled,
+      durationMs: Date.now() - start,
+    };
+  }
+
+  private collectProcessing(): Task[] {
+    const result: Task[] = [];
+    for (const queue of this.queues.values()) {
+      for (const task of queue.processing) result.push(task);
+    }
+    return result;
+  }
+
+  // --- Helpers --------------------------------------------------------------
+
+  private requireTask(taskId: string): Task {
+    const task = this.tasks.get(taskId);
+    if (!task) throw new Error(`No such task: ${taskId}`);
+    return task;
+  }
+}
+
+function toTaskError(error: unknown): TaskError {
+  if (error instanceof Error) {
+    return { message: error.message, name: error.name, stack: error.stack };
+  }
+  return { message: String(error) };
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..b17e9d6
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,107 @@
+import type { Task } from './task.js';
+
+/**
+ * Lifecycle status of a task.
+ *
+ * The first three (`pending`, `delayed`, `blocked`) are all "waiting" states —
+ * the task has not yet been pulled for processing. They are derived from the
+ * task's availability time and outstanding dependencies. The remaining states
+ * are settled/active states stored explicitly on the task.
+ */
+export type TaskStatus =
+  | 'pending'
+  | 'delayed'
+  | 'blocked'
+  | 'processing'
+  | 'completed'
+  | 'failed'
+  | 'cancelled';
+
+/** Normalised error information retained on a task that has failed. */
+export interface TaskError {
+  message: string;
+  name?: string;
+  stack?: string;
+}
+
+/** Progress report for a running task. */
+export interface TaskProgress {
+  percent: number;
+  message?: string;
+}
+
+/** Options accepted when adding a task to the queue. */
+export interface AddOptions {
+  /** Target queue name. Defaults to the default queue. */
+  queue?: string;
+  /** Priority from 1 (highest) to 10 (lowest). Defaults to 5. */
+  priority?: number;
+  /** Relative delay in milliseconds before the task becomes available. */
+  delay?: number;
+  /** Absolute timestamp (ms) at which the task becomes available. */
+  availableAt?: number;
+  /** Maximum number of automatic retries after the first attempt. Defaults to 3. */
+  maxRetries?: number;
+  /** Base backoff delay in milliseconds. Defaults to 1000. */
+  baseDelay?: number;
+  /** Task IDs that must complete before this task becomes available. */
+  dependencies?: string[];
+}
+
+/** A snapshot of a task's dependency resolution state. */
+export interface DependencyStatus {
+  dependencies: string[];
+  completed: string[];
+  pending: string[];
+  blocked: boolean;
+}
+
+/** Current concurrency configuration and usage for a queue. */
+export interface ConcurrencyStatus {
+  /** Maximum simultaneous processing tasks, or `null` for unlimited. */
+  limit: number | null;
+  /** How many tasks are currently processing. */
+  active: number;
+}
+
+/** A listener notified whenever a task's progress changes. */
+export type ProgressListener = (progress: TaskProgress, task: Task) => void;
+
+/** Function passed to middleware to advance to the next middleware/handler. */
+export type NextFn = () => Promise<void>;
+
+/** Middleware intercepts a task before it reaches the handler. */
+export type Middleware = (task: Task, next: NextFn) => void | Promise<void>;
+
+/** Context supplied to a handler, including the cancellation signal. */
+export interface HandlerContext {
+  signal: AbortSignal;
+}
+
+/** A per-queue processing function, invoked after all middleware have run. */
+export type Handler = (task: Task, ctx: HandlerContext) => unknown | Promise<unknown>;
+
+/** A callback invoked during graceful shutdown. */
+export type ShutdownCallback = () => void | Promise<void>;
+
+/** Options controlling graceful shutdown. */
+export interface ShutdownOptions {
+  /** Max time (ms) to wait for in-flight tasks before force-cancelling. Defaults to 30000. */
+  timeout?: number;
+  /** A one-off callback to run during this shutdown, alongside any registered callbacks. */
+  onShutdown?: ShutdownCallback;
+}
+
+/** Summary returned once shutdown completes. */
+export interface ShutdownSummary {
+  completed: number;
+  forceCancelled: number;
+  durationMs: number;
+}
+
+/** Public view of a recurring schedule. */
+export interface ScheduleInfo {
+  id: string;
+  cron: string;
+  queue: string;
+}
