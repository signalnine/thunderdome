,\n    11\t  validateUserId,\n    12\t  canManageUsers,\n    13\t  type Role,\n    14\t} from '@monorepo/core';\n    15\t\n    16\texport const usersRouter = Router();\n    17\t\n    18\t// List all users\n    19\tusersRouter.get('/', (_req: Request, res: Response) => {\n    20\t  try {\n    21\t    const users = getAllUsers();\n    22\t    res.json({ users });\n    23\t  } catch (err) {\n    24\t    res.status(500).json({ error: 'Failed to fetch users' });\n    25\t  }\n    26\t});\n    27\t\n    28\t// Get user by ID\n    29\tusersRouter.get('/:id', (req: Request, res: Response) => {\n    30\t  try {\n    31\t    const validation = validateUserId(req.params['id']!);\n    32\t    if (!validation.success) {\n    33\t      res.status(400).json({ errors: validation.errors });\n    34\t      return;\n    35\t    }\n    36\t\n    37\t    const user = getUserById(validation.data!);\n    38\t    if (!user) {\n    39\t      res.status(404).json({ error: 'User not found' });\n    40\t      return;\n    41\t    }\n    42\t    res.json({ user });\n    43\t  } catch (err) {\n    44\t    res.status(500).json({ error: 'Failed to fetch user' });\n    45\t  }\n    46\t});\n    47\t\n    48\t// Create a new user\n    49\tusersRouter.post('/', (req: Request, res: Response) => {\n    50\t  try {\n    51\t    const callerRole = (req.headers['x-user-role'] as Role) || 'viewer';\n    52\t    if (!canManageUsers(callerRole)) {\n    53\t      res.status(403).json({ error: 'Insufficient permissions' });\n    54\t      return;\n    55\t    }\n    56\t\n    57\t    const validation = validateCreateUser(req.body);\n    58\t    if (!validation.success) {\n    59\t      res.status(400).json({ errors: validation.errors });\n    60\t      return;\n    61\t    }\n    62\t\n    63\t    const user = createUser(req.body);\n    64\t    res.status(201).json({ user });\n    65\t  } catch (err) {\n    66\t    if (err instanceof Error && err.message.includes('UNIQUE')) {\n    67\t      res.status(409).jso