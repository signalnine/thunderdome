@@ -0,0 +1,104 @@
+import Database from 'better-sqlite3';
+import { SearchResult, SuggestResult } from './models.js';
+
+export const PER_PAGE = 20;
+const SUGGEST_LIMIT = 5;
+
+// Extract word tokens (unicode letters/numbers) from arbitrary user input.
+function extractWords(text: string): string[] {
+  return text.match(/[\p{L}\p{N}]+/gu) ?? [];
+}
+
+/**
+ * Build a safe FTS5 MATCH expression from raw user input.
+ *
+ * Each term and quoted phrase is re-emitted as a double-quoted FTS5 string,
+ * which neutralizes the FTS5 query syntax (operators, special characters)
+ * so arbitrary user input cannot produce a syntax error. Quoted phrases in
+ * the input (e.g. "exact phrase") are preserved as phrase queries.
+ *
+ * Returns an empty string when the input contains no searchable tokens.
+ */
+export function buildMatchQuery(q: string): string {
+  const tokens: string[] = [];
+
+  // Pull out quoted phrases first, replacing them so their words aren't
+  // double-counted as loose terms below.
+  const remaining = q.replace(/"([^"]*)"/g, (_match, phrase: string) => {
+    const words = extractWords(phrase);
+    if (words.length > 0) {
+      tokens.push(`"${words.join(' ')}"`);
+    }
+    return ' ';
+  });
+
+  for (const word of extractWords(remaining)) {
+    tokens.push(`"${word}"`);
+  }
+
+  return tokens.join(' ');
+}
+
+/**
+ * Build a prefix MATCH expression for autocomplete. All but the final token
+ * are matched exactly; the final token becomes a prefix query (`"term"*`).
+ */
+export function buildPrefixQuery(q: string): string {
+  const words = extractWords(q);
+  if (words.length === 0) {
+    return '';
+  }
+
+  return words
+    .map((word, i) => (i === words.length - 1 ? `"${word}"*` : `"${word}"`))
+    .join(' ');
+}
+
+export function searchNotes(
+  db: Database.Database,
+  q: string,
+  page: number
+): { results: SearchResult[]; total: number } {
+  const match = buildMatchQuery(q);
+  if (match === '') {
+    return { results: [], total: 0 };
+  }
+
+  const offset = (page - 1) * PER_PAGE;
+
+  const results = db
+    .prepare(
+      `SELECT rowid AS id,
+              title,
+              snippet(notes_fts, -1, '<mark>', '</mark>', '...', 15) AS snippet,
+              bm25(notes_fts) AS rank
+       FROM notes_fts
+       WHERE notes_fts MATCH ?
+       ORDER BY rank
+       LIMIT ? OFFSET ?`
+    )
+    .all(match, PER_PAGE, offset) as SearchResult[];
+
+  const { total } = db
+    .prepare('SELECT COUNT(*) AS total FROM notes_fts WHERE notes_fts MATCH ?')
+    .get(match) as { total: number };
+
+  return { results, total };
+}
+
+export function suggestNotes(db: Database.Database, q: string): SuggestResult[] {
+  const match = buildPrefixQuery(q);
+  if (match === '') {
+    return [];
+  }
+
+  return db
+    .prepare(
+      `SELECT rowid AS id, title
+       FROM notes_fts
+       WHERE notes_fts MATCH ?
+       ORDER BY bm25(notes_fts)
+       LIMIT ?`
+    )
+    .all(match, SUGGEST_LIMIT) as SuggestResult[];
+}
