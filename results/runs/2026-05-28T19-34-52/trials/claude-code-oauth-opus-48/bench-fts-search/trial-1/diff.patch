}\"*` : `\"${word}\"`))\n    .join(' ');\n}\n\nexport function searchNotes(\n  db: Database.Database,\n  q: string,\n  page: number\n): { results: SearchResult[]; total: number } {\n  const match = buildMatchQuery(q);\n  if (match === '') {\n    return { results: [], total: 0 };\n  }\n\n  const offset = (page - 1) * PER_PAGE;\n\n  const results = db\n    .prepare(\n      `SELECT rowid AS id,\n              title,\n              snippet(notes_fts, -1, '<mark>', '</mark>', '...', 15) AS snippet,\n              bm25(notes_fts) AS rank\n       FROM notes_fts\n       WHERE notes_fts MATCH ?\n       ORDER BY rank\n       LIMIT ? OFFSET ?`\n    )\n    .all(match, PER_PAGE, offset) as SearchResult[];\n\n  const { total } = db\n    .prepare('SELECT COUNT(*) AS total FROM notes_fts WHERE notes_fts MATCH ?')\n    .get(match) as { total: number };\n\n  return { results, total };\n}\n\nexport function suggestNotes(db: Database.Database, q: string): SuggestResult[] {\n  const match = buildPrefixQuery(q);\n  if (match === '') {\n    return [];\n  }\n\n  return db\n    .prepare(\n      `SELECT rowid AS id, title\n       FROM notes_fts\n       WHERE notes_fts MATCH ?\n       ORDER BY bm25(notes_fts)\n       LIMIT ?`\n    )\n    .all(match, SUGGEST_LIMIT) as SuggestResult[];\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":1189,"cache_read_input_tokens":49771,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1189},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1c57d46e-c230-4db0-8b8d-e6345252f3e0","uuid":"540f0395-7032-447e-be58-e86f8769d318","request_id":"req_011CbVYRophFTds4Yzet3BK9"}
