+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from './index.js';
+
+function toGrid(s: string): string[][] {
+  return s
+    .trim()
+    .split('\n')
+    .map((line) => line.trim().split(/\s+/));
+}
+
+const EX1 = toGrid(`
+. S . . .
+. . . . .
+. ^ . . .
+. . . . .
+`);
+
+const EX2 = toGrid(`
+. S . . .
+. ^ . . .
+^ . ^ . .
+. . . . .
+`);
+
+describe('countBeamCells', () => {
+  it('counts cells for the single-splitter example', () => {
+    expect(countBeamCells(EX1)).toBe(5);
+  });
+
+  it('counts cells for the two-splitter example (overlap counts once)', () => {
+    expect(countBeamCells(EX2)).toBe(6);
+  });
+
+  it('counts a straight beam with no splitters', () => {
+    expect(countBeamCells(toGrid(`. S .\n. . .\n. . .`))).toBe(3);
+  });
+
+  it('handles a source with no rows below it', () => {
+    expect(countBeamCells([['S']])).toBe(1);
+  });
+
+  it('returns 0 when there is no source', () => {
+    expect(countBeamCells(toGrid(`. . .\n. ^ .`))).toBe(0);
+  });
+
+  it('counts diagonal beams that exit the side', () => {
+    // splitter on left edge: down-left immediately exits, down-right continues
+    expect(countBeamCells(toGrid(`S .\n^ .`))).toBe(2); // (0,0),(1,0); DR ->(2,1) out of rows
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('counts paths for the single-splitter example', () => {
+    expect(countBeamPaths(EX1)).toBe(2n);
+  });
+
+  it('counts paths for the two-splitter example', () => {
+    expect(countBeamPaths(EX2)).toBe(4n);
+  });
+
+  it('a beam with no splitter is a single path', () => {
+    expect(countBeamPaths(toGrid(`. S .\n. . .`))).toBe(1n);
+  });
+
+  it('returns 0 with no source', () => {
+    expect(countBeamPaths(toGrid(`. . .`))).toBe(0n);
+  });
+
+  it('source with immediate exit is one path', () => {
+    expect(countBeamPaths([['S']])).toBe(1n);
+  });
+
+  it('each splitter doubles a free-running beam (chain of splitters)', () => {
+    // Splitters stacked so every branch keeps hitting a splitter is hard to
+    // build trivially; instead verify a vertical line of splitters in one col
+    // where only the straight-down-equivalent keeps splitting is not possible.
+    // Use a wide grid with splitters arranged so paths = 2^k.
+    const grid = toGrid(`
+. . . S . . .
+. . . ^ . . .
+. . ^ . ^ . .
+. ^ . ^ . ^ .
+`);
+    // row1: split -> (2,2) and (2,4), both splitters
+    // (2,2)->(3,1),(3,3) both splitters; (2,4)->(3,3),(3,5) splitters
+    // every row-3 splitter emits 2 exits. 4 incoming beams * 2 = 8 paths.
+    expect(countBeamPaths(grid)).toBe(8n);
+  });
+
+  it('handles large grids within time budget and returns a bigint', () => {
+    const rows = 200;
+    const cols = 200;
+    const grid: string[][] = Array.from({ length: rows }, () => new Array(cols).fill('.'));
+    grid[0][100] = 'S';
+    // 50 splitters scattered down the middle region
+    let placed = 0;
+    for (let r = 1; r < rows && placed < 50; r += 4) {
+      grid[r][100] = '^';
+      placed++;
+    }
+    const start = performance.now();
+    const paths = countBeamPaths(grid);
+    const cells = countBeamCells(grid);
+    const elapsed = performance.now() - start;
+    expect(typeof paths).toBe('bigint');
+    expect(paths > 0n).toBe(true);
+    expect(cells).toBeGreaterThan(0);
+    expect(elapsed).toBeLessThan(5000);
+  });
+
+  it('produces astronomically large counts without overflow', () => {
+    // Build a triangle of splitters guaranteeing exponential growth.
+    const n = 60;
+    const cols = 2 * n + 3;
+    const grid: string[][] = Array.from({ length: n + 1 }, () => new Array(cols).fill('.'));
+    const mid = n + 1;
+    grid[0][mid] = 'S';
+    for (let r = 1; r <= n; r++) {
+      for (let c = mid - r; c <= mid + r; c += 2) {
+        if (c >= 0 && c < cols) grid[r][c] = '^';
+      }
+    }
+    const paths = countBeamPaths(grid);
+    // Bottom row of splitters: each emits 2 exits. Growth is exponential and
+    // far exceeds Number.MAX_SAFE_INTEGER, exercising bigint.
+    expect(paths > BigInt(Number.MAX_SAFE_INTEGER)).toBe(true);
+  });
+});
