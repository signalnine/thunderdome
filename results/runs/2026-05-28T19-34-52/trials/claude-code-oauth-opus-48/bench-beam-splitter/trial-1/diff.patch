+/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ *
+ * Grid cells:
+ *   'S' — beam source (top row), emits a beam straight down.
+ *   '^' — splitter, splits an incoming beam into down-left and down-right beams.
+ *   '.' — empty cell, beams pass through unchanged.
+ *
+ * A beam's direction is captured by its horizontal step `dc`:
+ *   -1 → down-left, 0 → straight down, +1 → down-right.
+ * Every beam always advances one row downward per step, so the simulation is a
+ * DAG over (row, col, dc) states and never loops.
+ */
+
+const SOURCE = 'S';
+const SPLITTER = '^';
+
+/** Map a horizontal step (-1, 0, +1) to a dense direction index (0, 1, 2). */
+function dirIndex(dc: number): number {
+  return dc + 1;
+}
+
+/** Locate every source cell. Sources are expected on the top row. */
+function findSources(grid: string[][]): Array<[number, number]> {
+  const sources: Array<[number, number]> = [];
+  for (let r = 0; r < grid.length; r++) {
+    const row = grid[r];
+    for (let c = 0; c < row.length; c++) {
+      if (row[c] === SOURCE) sources.push([r, c]);
+    }
+  }
+  return sources;
+}
+
+/**
+ * Count the number of distinct cells visited by any beam.
+ *
+ * States are deduplicated by (row, col, direction) so the work is bounded by
+ * rows * cols * 3 regardless of how many beams overlap.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+  if (cols === 0) return 0;
+
+  // seen[r][c] is a 3-bit mask of directions already processed at that cell.
+  const seen: Uint8Array[] = Array.from({ length: rows }, () => new Uint8Array(cols));
+  const visited: boolean[][] = Array.from({ length: rows }, () => new Array<boolean>(cols).fill(false));
+
+  // Stack of beams entering a (valid) cell: [row, col, horizontalStep].
+  const stack: Array<[number, number, number]> = [];
+  for (const [r, c] of findSources(grid)) {
+    stack.push([r, c, 0]); // source emits straight down
+  }
+
+  let count = 0;
+  while (stack.length > 0) {
+    const [r, c, dc] = stack.pop()!;
+    const bit = 1 << dirIndex(dc);
+    if (seen[r][c] & bit) continue;
+    seen[r][c] |= bit;
+
+    if (!visited[r][c]) {
+      visited[r][c] = true;
+      count++;
+    }
+
+    // Determine outgoing beams from this cell.
+    const steps = grid[r][c] === SPLITTER ? [-1, 1] : [dc];
+    for (const ndc of steps) {
+      const nr = r + 1;
+      const nc = c + ndc;
+      if (nr >= rows || nc < 0 || nc >= cols) continue; // absorbed
+      const nbit = 1 << dirIndex(ndc);
+      if (!(seen[nr][nc] & nbit)) stack.push([nr, nc, ndc]);
+    }
+  }
+
+  return count;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths.
+ *
+ * paths(r, c, dc) = number of exit paths produced by a beam currently at the
+ * valid cell (r, c) travelling with horizontal step dc. Memoized over
+ * (row, col, direction); each beam that steps off the grid contributes one path.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+  if (cols === 0) return 0n;
+
+  const ONE = 1n;
+  // memo[r][c][dirIndex]; undefined = not yet computed.
+  const memo: Array<Array<Array<bigint | undefined>>> = Array.from({ length: rows }, () =>
+    Array.from({ length: cols }, () => new Array<bigint | undefined>(3)),
+  );
+
+  // Iterative post-order over the DAG using an explicit stack to avoid deep
+  // recursion on tall grids.
+  function paths(sr: number, sc: number, sdc: number): bigint {
+    const stack: Array<[number, number, number]> = [[sr, sc, sdc]];
+    while (stack.length > 0) {
+      const [r, c, dc] = stack[stack.length - 1];
+      const di = dirIndex(dc);
+      if (memo[r][c][di] !== undefined) {
+        stack.pop();
+        continue;
+      }
+
+      const steps = grid[r][c] === SPLITTER ? [-1, 1] : [dc];
+      let total = 0n;
+      let ready = true;
+      for (const ndc of steps) {
+        const nr = r + 1;
+        const nc = c + ndc;
+        if (nr >= rows || nc < 0 || nc >= cols) {
+          total += ONE; // beam exits the grid: one path
+          continue;
+        }
+        const ndi = dirIndex(ndc);
+        const sub = memo[nr][nc][ndi];
+        if (sub === undefined) {
+          stack.push([nr, nc, ndc]);
+          ready = false;
+        } else if (ready) {
+          total += sub;
+        }
+      }
+
+      if (ready) {
+        memo[r][c][di] = total;
+        stack.pop();
+      }
+    }
+    return memo[sr][sc][dirIndex(sdc)]!;
+  }
+
+  let total = 0n;
+  for (const [r, c] of findSources(grid)) {
+    total += paths(r, c, 0);
+  }
+  return total;
+}
