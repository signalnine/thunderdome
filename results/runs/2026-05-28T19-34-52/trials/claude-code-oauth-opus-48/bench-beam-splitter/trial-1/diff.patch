 => {\n    expect(countBeamPaths(toGrid(`. . .`))).toBe(0n);\n  });\n\n  it('source with immediate exit is one path', () => {\n    expect(countBeamPaths([['S']])).toBe(1n);\n  });\n\n  it('each splitter doubles a free-running beam (chain of splitters)', () => {\n    // Splitters stacked so every branch keeps hitting a splitter is hard to\n    // build trivially; instead verify a vertical line of splitters in one col\n    // where only the straight-down-equivalent keeps splitting is not possible.\n    // Use a wide grid with splitters arranged so paths = 2^k.\n    const grid = toGrid(`\n. . . S . . .\n. . . ^ . . .\n. . ^ . ^ . .\n. ^ . ^ . ^ .\n`);\n    // row1: split -> (2,2) and (2,4), both splitters\n    // (2,2)->(3,1),(3,3) both splitters; (2,4)->(3,3),(3,5) splitters\n    // every row-3 splitter emits 2 exits. 4 incoming beams * 2 = 8 paths.\n    expect(countBeamPaths(grid)).toBe(8n);\n  });\n\n  it('handles large grids within time budget and returns a bigint', () => {\n    const rows = 200;\n    const cols = 200;\n    const grid: string[][] = Array.from({ length: rows }, () => new Array(cols).fill('.'));\n    grid[0][100] = 'S';\n    // 50 splitters scattered down the middle region\n    let placed = 0;\n    for (let r = 1; r < rows && placed < 50; r += 4) {\n      grid[r][100] = '^';\n      placed++;\n    }\n    const start = performance.now();\n    const paths = countBeamPaths(grid);\n    const cells = countBeamCells(grid);\n    const elapsed = performance.now() - start;\n    expect(typeof paths).toBe('bigint');\n    expect(paths > 0n).toBe(true);\n    expect(cells).toBeGreaterThan(0);\n    expect(elapsed).toBeLessThan(5000);\n  });\n\n  it('produces astronomically large counts without overflow', () => {\n    // Build a triangle of splitters guaranteeing exponential growth.\n    const n = 60;\n    const cols = 2 * n + 3;\n    const grid: string[][] = Array.from({ length: n + 1 }, () => new Array(cols).fill('.'));\n    const mid = n + 1;\n    grid[0][mid] = '