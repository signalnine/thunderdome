+// Beam propagation simulator for a 2D grid laboratory.
+//
+// A beam always advances exactly one row downward per step, so the state
+// space (row, col, direction) forms a DAG (row strictly increases). This lets
+// us traverse every reachable state once for cell counting, and memoize a DP
+// for path counting — both far cheaper than enumerating individual paths.
+
+// Direction encoding: column delta applied each step (row always +1).
+const DOWN = 0; // straight down
+const DOWN_LEFT = 1; // diagonally down-left
+const DOWN_RIGHT = 2; // diagonally down-right
+const COL_DELTA = [0, -1, 1] as const;
+
+const SOURCE = 'S';
+const SPLITTER = '^';
+
+interface Dims {
+  rows: number;
+  cols: number;
+}
+
+function dims(grid: string[][]): Dims {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  return { rows, cols };
+}
+
+function inBounds(r: number, c: number, d: Dims): boolean {
+  return r >= 0 && r < d.rows && c >= 0 && c < d.cols;
+}
+
+// Collect every source cell. Spec says a single source on the top row, but we
+// handle any sources defensively (a beam is emitted straight down from each).
+function findSources(grid: string[][], d: Dims): Array<[number, number]> {
+  const sources: Array<[number, number]> = [];
+  for (let r = 0; r < d.rows; r++) {
+    for (let c = 0; c < d.cols; c++) {
+      if (grid[r][c] === SOURCE) sources.push([r, c]);
+    }
+  }
+  return sources;
+}
+
+/**
+ * Count the number of distinct in-bounds cells visited by any beam.
+ * A cell counts once regardless of how many beams pass through it.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const d = dims(grid);
+  if (d.rows === 0 || d.cols === 0) return 0;
+
+  const stateSeen = new Uint8Array(d.rows * d.cols * 3);
+  const cellSeen = new Uint8Array(d.rows * d.cols);
+  let cellCount = 0;
+
+  // DFS over (row, col, dir) states. Only in-bounds states are pushed.
+  const stack: number[] = [];
+  for (const [sr, sc] of findSources(grid, d)) {
+    stack.push((sr * d.cols + sc) * 3 + DOWN);
+  }
+
+  while (stack.length > 0) {
+    const state = stack.pop()!;
+    if (stateSeen[state]) continue;
+    stateSeen[state] = 1;
+
+    const dir = state % 3;
+    const cell = (state - dir) / 3;
+    if (!cellSeen[cell]) {
+      cellSeen[cell] = 1;
+      cellCount++;
+    }
+
+    const r = Math.floor(cell / d.cols);
+    const c = cell % d.cols;
+
+    if (grid[r][c] === SPLITTER) {
+      // Splits into down-left and down-right; original beam is consumed.
+      const lr = r + 1;
+      if (inBounds(lr, c - 1, d)) stack.push(((lr) * d.cols + (c - 1)) * 3 + DOWN_LEFT);
+      if (inBounds(lr, c + 1, d)) stack.push(((lr) * d.cols + (c + 1)) * 3 + DOWN_RIGHT);
+    } else {
+      // Empty cell or source: continue in the current direction.
+      const nr = r + 1;
+      const nc = c + COL_DELTA[dir];
+      if (inBounds(nr, nc, d)) stack.push((nr * d.cols + nc) * 3 + dir);
+    }
+  }
+
+  return cellCount;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths through the grid.
+ * Each split at '^' produces two separate paths; a path ends when the beam
+ * exits the grid. Uses memoized DP, so the result is computed without
+ * enumerating individual paths (which may number up to 2^K).
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const d = dims(grid);
+  if (d.rows === 0 || d.cols === 0) return 0n;
+
+  // memo[state] = number of exit paths produced by a beam at that state.
+  // undefined = not yet computed.
+  const memo: Array<bigint | undefined> = new Array(d.rows * d.cols * 3);
+
+  // Iterative post-order DFS to avoid recursion depth limits on tall grids.
+  // We process states bottom-up: a state's value is the sum of its successors'.
+  function pathsFrom(startR: number, startC: number, startDir: number): bigint {
+    // Each frame: [r, c, dir, phase]. phase 0 = expand children, 1 = combine.
+    const stack: Array<[number, number, number, number]> = [[startR, startC, startDir, 0]];
+
+    while (stack.length > 0) {
+      const frame = stack[stack.length - 1];
+      const [r, c, dir, phase] = frame;
+      const state = (r * d.cols + c) * 3 + dir;
+
+      if (memo[state] !== undefined) {
+        stack.pop();
+        continue;
+      }
+
+      // Determine the beams this cell emits. A splitter emits two beams; any
+      // other cell emits one continuing beam. Each emitted beam is its own
+      // path: if it lands out of bounds it exits (contributing 1 path
+      // directly); if it lands in bounds its path count is that state's DP.
+      const branches: Array<[number, number, number]> = [];
+      if (grid[r][c] === SPLITTER) {
+        branches.push([r + 1, c - 1, DOWN_LEFT]);
+        branches.push([r + 1, c + 1, DOWN_RIGHT]);
+      } else {
+        branches.push([r + 1, c + COL_DELTA[dir], dir]);
+      }
+
+      if (phase === 0) {
+        frame[3] = 1; // revisit to combine once in-bounds children are computed.
+        for (const [nr, nc, nd] of branches) {
+          if (!inBounds(nr, nc, d)) continue; // exits immediately, no child state.
+          const ns = (nr * d.cols + nc) * 3 + nd;
+          if (memo[ns] === undefined) stack.push([nr, nc, nd, 0]);
+        }
+      } else {
+        let total = 0n;
+        for (const [nr, nc, nd] of branches) {
+          if (!inBounds(nr, nc, d)) {
+            total += 1n; // emitted beam exits the grid: one path.
+          } else {
+            total += memo[(nr * d.cols + nc) * 3 + nd]!;
+          }
+        }
+        memo[state] = total;
+        stack.pop();
+      }
+    }
+
+    return memo[(startR * d.cols + startC) * 3 + startDir]!;
+  }
+
+  let total = 0n;
+  for (const [sr, sc] of findSources(grid, d)) {
+    total += pathsFrom(sr, sc, DOWN);
+  }
+  return total;
+}
