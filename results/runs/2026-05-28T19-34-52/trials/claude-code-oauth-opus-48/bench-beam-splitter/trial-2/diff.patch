+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from './index.js';
+
+function toGrid(rows: string[]): string[][] {
+  return rows.map((r) => r.split(' '));
+}
+
+describe('countBeamCells', () => {
+  it('single splitter example', () => {
+    const g = toGrid(['. S . . .', '. . . . .', '. ^ . . .', '. . . . .']);
+    expect(countBeamCells(g)).toBe(5);
+  });
+
+  it('two splitters example', () => {
+    const g = toGrid(['. S . . .', '. ^ . . .', '^ . ^ . .', '. . . . .']);
+    expect(countBeamCells(g)).toBe(6);
+  });
+
+  it('no splitter, beam goes straight to bottom', () => {
+    const g = toGrid(['. S .', '. . .', '. . .']);
+    expect(countBeamCells(g)).toBe(3);
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('single splitter example', () => {
+    const g = toGrid(['. S . . .', '. . . . .', '. ^ . . .', '. . . . .']);
+    expect(countBeamPaths(g)).toBe(2n);
+  });
+
+  it('two splitters example', () => {
+    const g = toGrid(['. S . . .', '. ^ . . .', '^ . ^ . .', '. . . . .']);
+    expect(countBeamPaths(g)).toBe(4n);
+  });
+
+  it('no splitter, single path', () => {
+    const g = toGrid(['. S .', '. . .', '. . .']);
+    expect(countBeamPaths(g)).toBe(1n);
+  });
+});
+
+describe('edge cases', () => {
+  it('empty grid', () => {
+    expect(countBeamCells([])).toBe(0);
+    expect(countBeamPaths([])).toBe(0n);
+  });
+
+  it('source only, one row', () => {
+    const g = toGrid(['. S .']);
+    expect(countBeamCells(g)).toBe(1);
+    expect(countBeamPaths(g)).toBe(1n);
+  });
+
+  it('splitter immediately consumes both branches off-grid', () => {
+    // S at top, splitter directly below at left edge so down-left exits.
+    const g = toGrid(['S', '^']);
+    // (0,0) source -> (1,0) splitter. down-left (2,-1) off, down-right (2,1) off.
+    expect(countBeamCells(g)).toBe(2);
+    expect(countBeamPaths(g)).toBe(2n); // both branches exit = 2 paths
+  });
+});
+
+describe('performance', () => {
+  it('200x200 grid with 50 splitters under 5s', () => {
+    const N = 200;
+    const grid: string[][] = Array.from({ length: N }, () =>
+      Array.from({ length: N }, () => '.')
+    );
+    grid[0][100] = 'S';
+    // Place 50 splitters scattered down the middle region.
+    let placed = 0;
+    for (let r = 1; r < N && placed < 50; r += 4) {
+      grid[r][(r * 7) % N] = '^';
+      placed++;
+    }
+    const start = Date.now();
+    const cells = countBeamCells(grid);
+    const paths = countBeamPaths(grid);
+    const elapsed = Date.now() - start;
+    expect(cells).toBeGreaterThan(0);
+    expect(paths).toBeGreaterThan(0n);
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
