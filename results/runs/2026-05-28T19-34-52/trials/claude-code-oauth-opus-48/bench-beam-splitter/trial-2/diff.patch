nst stateSeen = new Uint8Array(d.rows * d.cols * 3);\n  const cellSeen = new Uint8Array(d.rows * d.cols);\n  let cellCount = 0;\n\n  // DFS over (row, col, dir) states. Only in-bounds states are pushed.\n  const stack: number[] = [];\n  for (const [sr, sc] of findSources(grid, d)) {\n    stack.push((sr * d.cols + sc) * 3 + DOWN);\n  }\n\n  while (stack.length > 0) {\n    const state = stack.pop()!;\n    if (stateSeen[state]) continue;\n    stateSeen[state] = 1;\n\n    const dir = state % 3;\n    const cell = (state - dir) / 3;\n    if (!cellSeen[cell]) {\n      cellSeen[cell] = 1;\n      cellCount++;\n    }\n\n    const r = Math.floor(cell / d.cols);\n    const c = cell % d.cols;\n\n    if (grid[r][c] === SPLITTER) {\n      // Splits into down-left and down-right; original beam is consumed.\n      const lr = r + 1;\n      if (inBounds(lr, c - 1, d)) stack.push(((lr) * d.cols + (c - 1)) * 3 + DOWN_LEFT);\n      if (inBounds(lr, c + 1, d)) stack.push(((lr) * d.cols + (c + 1)) * 3 + DOWN_RIGHT);\n    } else {\n      // Empty cell or source: continue in the current direction.\n      const nr = r + 1;\n      const nc = c + COL_DELTA[dir];\n      if (inBounds(nr, nc, d)) stack.push((nr * d.cols + nc) * 3 + dir);\n    }\n  }\n\n  return cellCount;\n}\n\n/**\n * Count the total number of distinct source-to-exit paths through the grid.\n * Each split at '^' produces two separate paths; a path ends when the beam\n * exits the grid. Uses memoized DP, so the result is computed without\n * enumerating individual paths (which may number up to 2^K).\n */\nexport function countBeamPaths(grid: string[][]): bigint {\n  const d = dims(grid);\n  if (d.rows === 0 || d.cols === 0) return 0n;\n\n  // memo[state] = number of exit paths produced by a beam at that state.\n  // undefined = not yet computed.\n  const memo: Array<bigint | undefined> = new Array(d.rows * d.cols * 3);\n\n  // Iterative post-order DFS to avoid recursion depth limits on tall grids.\n  // We process states bottom-up