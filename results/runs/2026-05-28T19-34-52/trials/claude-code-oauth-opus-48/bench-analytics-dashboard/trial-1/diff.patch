 patch = await request(app)\n      .patch(`/auth/users/${viewer.body.user.id}/role`)\n      .set('Authorization', `Bearer ${admin.token}`)\n      .send({ role: 'editor' });\n    expect(patch.status).toBe(200);\n    expect(patch.body.role).toBe('editor');\n\n    // viewer (now editor) cannot change roles\n    const forbidden = await request(app)\n      .patch(`/auth/users/${admin.user.id}/role`)\n      .set('Authorization', `Bearer ${viewer.body.token}`)\n      .send({ role: 'viewer' });\n    expect(forbidden.status).toBe(403);\n  });\n});\n\ndescribe('ingestion + query with tenant isolation', () => {\n  it('ingests events and isolates tenants', async () => {\n    const t1 = await registerTenant('t1@x.com');\n    const t2 = await registerTenant('t2@x.com');\n\n    await request(app)\n      .post('/events')\n      .set('Authorization', `Bearer ${t1.token}`)\n      .send({ name: 'page_view', properties: { url: '/home' }, timestamp: '2026-01-01 10:00:00' });\n\n    const batch = await request(app)\n      .post('/events/batch')\n      .set('Authorization', `Bearer ${t1.token}`)\n      .send({\n        events: [\n          { name: 'page_view', properties: { url: '/home' }, timestamp: '2026-01-02 10:00:00' },\n          { name: 'page_view', properties: { url: '/about' }, timestamp: '2026-01-02 11:00:00' },\n          { name: 'click', timestamp: '2026-01-02 12:00:00' },\n        ],\n      });\n    expect(batch.status).toBe(201);\n    expect(batch.body.ingested).toBe(3);\n\n    // t2 has its own event\n    await request(app)\n      .post('/events')\n      .set('Authorization', `Bearer ${t2.token}`)\n      .send({ name: 'page_view' });\n\n    // count: t1 has 3 page_views\n    const count = await request(app)\n      .post('/query/count')\n      .set('Authorization', `Bearer ${t1.token}`)\n      .send({ name: 'page_view' });\n    expect(count.body.count).toBe(3);\n\n    // t2 only sees its own single page_view\n    const count2 = await request(app)\n      .post('/query/count')\n      .set('Authorization', `Bearer ${t2.token}`)\n      .send({ name: 'page_view' });\n    expect(count2.body.count).toBe(1);\n\n    // timeseries daily\n    const ts = await request(app)\n      .post('/query/timeseries')\n      .set('Authorization', `Bearer ${t1.token}`)\n      .send({ name: 'page_view', interval: 'day' });\n    expect(ts.body.series).toEqual([\n      { bucket: '2026-01-01', count: 1 },\n      { bucket: '2026-01-02', count: 2 },\n    ]);\n\n    // breakdown by url\n    const bd = await request(app)\n      .post('/query/breakdown')\n      .set('Authorization', `Bearer ${t1.token}`)\n      .send({ property: 'url', name: 'page_view' });\n    const urls = Object.fromEntries(bd.body.breakdown.map((r: { value: string; count: number }) => [r.value, r.count]));\n    expect(urls['/home']).toBe(2);\n    expect(urls['/about']).toBe(1);\n  });\n});\n\ndescribe('dashboards', () => {\n  it('CRUD with tenant scoping', async () => {\n    const t1 = await registerTenant('d1@x.com');\n    const t2 = await registerTenant('d2@x.com');\n\n    const created = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${t1.token}`)\n      .send({ name: 'Main', config: { layout: 'grid' } });\n    expect(created.status).toBe(201);\n    const id = created.body.id;\n\n    const get = await request(app).get(`/dashboards/${id}`).set('Authorization', `Bearer ${t1.token}`);\n    expect(get.body.config.layout).toBe('grid');\n\n    // t2 cannot see t1's dashboard\n    const cross = await request(app).get(`/dashboards/${id}`).set('Authorization', `Bearer ${t2.token}`);\n    expect(cross.status).toBe(404);\n\n    const upd = await request(app)\n      .put(`/dashboards/${id}`)\n      .set('Authorization', `Bearer ${t1.token}`)\n      .send({ name: 'Renamed' });\n    expect(upd.body.name).toBe('Renamed');\n\n    const del = await request(app).delete(`/dashboards/${id}`).set('Authorization', `Bearer ${t1.token}`);\n    expect(del.status).toBe(204);\n    const gone = await request(app).get(`/dashboards/${id}`).set('Authorization', `Bearer ${t1.token}`);\n    expect(gone.status).toBe(404);\n  });\n});\n\ndescribe('export', () => {\n  it('exports events as json and csv', async () => {\n    const t1 = await registerTenant('e1@x.com');\n    await request(app)\n      .post('/events')\n      .set('Authorization', `Bearer ${t1.token}`)\n      .send({ name: 'page_view', properties: { url: '/home' } });\n\n    const json = await request(app).get('/export/events').set('Authorization', `Bearer ${t1.token}`);\n    expect(json.status).toBe(200);\n    expect(json.body.events.length).toBe(1);\n\n    const csv = await request(app)\n      .get('/export/events?format=csv')\n      .set('Authorization', `Bearer ${t1.token}`);\n    expect(csv.status).toBe(200);\n    expect(csv.headers['content-type']).toContain('text/csv');\n    expect(csv.text).toContain('page_view');\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":133,"cache_read_input_tokens":39954,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":133},"output_tokens":9,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2abb4a38-c9f4-490e-a0d0-2aae3e9212c0","uuid":"15a2c8d9-3e85-4791-962f-c3078562007c","request_id":"req_011CbVa5ztP8w5z5jdSiGLn6"}
