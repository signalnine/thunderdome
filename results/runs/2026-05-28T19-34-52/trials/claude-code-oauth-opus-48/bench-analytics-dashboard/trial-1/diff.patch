 id, ingested: 1 });\n  });\n\n  // Ingest a batch of events efficiently in a single transaction.\n  router.post('/batch', (req, res) => {\n    const body = req.body ?? {};\n    const list: unknown = Array.isArray(body) ? body : body.events;\n    if (!Array.isArray(list)) {\n      return res.status(400).json({ error: 'expected an array of events (or { events: [...] })' });\n    }\n    const normalized = list.map((e) => normalize(e as IncomingEvent));\n    if (normalized.some((n) => n === null)) {\n      return res.status(400).json({ error: 'every event must have a name' });\n    }\n    const ids: string[] = [];\n    const insertMany = db.transaction((events: NonNullable<ReturnType<typeof normalize>>[]) => {\n      for (const ev of events) {\n        const id = uuid();\n        ids.push(id);\n        insert.run({\n          id,\n          tenant_id: req.user!.tenantId,\n          name: ev.name,\n          properties: ev.properties,\n          timestamp: ev.timestamp,\n          user_id: req.user!.id,\n          session_id: ev.sessionId,\n        });\n      }\n    });\n    insertMany(normalized as NonNullable<ReturnType<typeof normalize>>[]);\n    return res.status(201).json({ ingested: ids.length, ids });\n  });\n\n  return router;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1720,"cache_read_input_tokens":31949,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1720},"output_tokens":73,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2abb4a38-c9f4-490e-a0d0-2aae3e9212c0","uuid":"1ef3c6d1-9096-43e3-915a-8dc5f6cb7997","request_id":"req_011CbVa1DhgDPCj7F66B9dfc"}
