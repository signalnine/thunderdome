diff --git a/src/query.ts b/src/query.ts
new file mode 100644
index 0000000..10289cf
--- /dev/null
+++ b/src/query.ts
@@ -0,0 +1,116 @@
+import type { DB } from './db.js';
+
+export interface EventFilter {
+  /** Event name to match exactly. */
+  name?: string;
+  /** ISO timestamp lower bound (inclusive). */
+  from?: string;
+  /** ISO timestamp upper bound (inclusive). */
+  to?: string;
+  /** Property equality filters: { url: '/home' } -> json_extract(properties,'$.url') = '/home'. */
+  properties?: Record<string, string | number | boolean>;
+}
+
+export type Interval = 'hour' | 'day' | 'week' | 'month';
+
+interface WhereClause {
+  sql: string;
+  params: unknown[];
+}
+
+/** Build a WHERE clause that always enforces tenant isolation. */
+function buildWhere(tenantId: string, filter: EventFilter = {}): WhereClause {
+  const clauses: string[] = ['tenant_id = ?'];
+  const params: unknown[] = [tenantId];
+
+  if (filter.name !== undefined) {
+    clauses.push('name = ?');
+    params.push(filter.name);
+  }
+  if (filter.from !== undefined) {
+    clauses.push('timestamp >= ?');
+    params.push(filter.from);
+  }
+  if (filter.to !== undefined) {
+    clauses.push('timestamp <= ?');
+    params.push(filter.to);
+  }
+  if (filter.properties) {
+    for (const [key, value] of Object.entries(filter.properties)) {
+      clauses.push('json_extract(properties, ?) = ?');
+      params.push(`$.${key}`, value);
+    }
+  }
+  return { sql: clauses.join(' AND '), params };
+}
+
+/** Count events matching the filter within a tenant. */
+export function count(db: DB, tenantId: string, filter: EventFilter = {}): number {
+  const where = buildWhere(tenantId, filter);
+  const row = db
+    .prepare(`SELECT COUNT(*) AS c FROM events WHERE ${where.sql}`)
+    .get(...where.params) as { c: number };
+  return row.c;
+}
+
+const INTERVAL_FORMATS: Record<Interval, string> = {
+  hour: '%Y-%m-%d %H:00:00',
+  day: '%Y-%m-%d',
+  week: '%Y-%W',
+  month: '%Y-%m',
+};
+
+export interface TimeseriesPoint {
+  bucket: string;
+  count: number;
+}
+
+/** Bucket event counts over time using the given interval. */
+export function timeseries(
+  db: DB,
+  tenantId: string,
+  interval: Interval,
+  filter: EventFilter = {},
+): TimeseriesPoint[] {
+  const fmt = INTERVAL_FORMATS[interval] ?? INTERVAL_FORMATS.day;
+  const where = buildWhere(tenantId, filter);
+  const rows = db
+    .prepare(
+      `SELECT strftime('${fmt}', timestamp) AS bucket, COUNT(*) AS count
+       FROM events WHERE ${where.sql}
+       GROUP BY bucket ORDER BY bucket ASC`,
+    )
+    .all(...where.params) as TimeseriesPoint[];
+  return rows;
+}
+
+export interface BreakdownRow {
+  value: string | null;
+  count: number;
+}
+
+/** Group event counts by the value of a property. */
+export function breakdown(
+  db: DB,
+  tenantId: string,
+  property: string,
+  filter: EventFilter = {},
+): BreakdownRow[] {
+  const where = buildWhere(tenantId, filter);
+  const rows = db
+    .prepare(
+      `SELECT json_extract(properties, ?) AS value, COUNT(*) AS count
+       FROM events WHERE ${where.sql}
+       GROUP BY value ORDER BY count DESC`,
+    )
+    .all(`$.${property}`, ...where.params) as BreakdownRow[];
+  return rows;
+}
+
+/** Raw event rows for a tenant (used by exports). */
+export function listEvents(db: DB, tenantId: string, filter: EventFilter = {}) {
+  const where = buildWhere(tenantId, filter);
+  return db
+    .prepare(`SELECT * FROM events WHERE ${where.sql} ORDER BY timestamp ASC`)
+    .all(...where.params);
+}
diff --git a/src/routes/auth.ts b/src/routes/auth.ts
new file mode 100644
index 0000000..ab66d13
--- /dev/null
+++ b/src/routes/auth.ts
@@ -0,0 +1,93 @@
+import { Router } from 'express';
+import { v4 as uuid } from 'uuid';
+import type { DB } from '../db.js';
+import type { Role, User } from '../types.js';
+import { authenticate, hashPassword, requireRole, signToken, verifyPassword } from '../auth.js';
+
+const VALID_ROLES: Role[] = ['admin', 'editor', 'viewer'];
+
+export function authRouter(db: DB): Router {
+  const router = Router();
+
+  // Register a new user. If no tenantId is supplied, a new tenant is created
+  // and the user becomes its admin.
+  router.post('/register', (req, res) => {
+    const { email, password, tenantId, role } = req.body ?? {};
+    if (typeof email !== 'string' || typeof password !== 'string' || !email || !password) {
+      return res.status(400).json({ error: 'email and password are required' });
+    }
+
+    const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(email);
+    if (existing) {
+      return res.status(409).json({ error: 'Email already registered' });
+    }
+
+    const id = uuid();
+    const tenant = typeof tenantId === 'string' && tenantId ? tenantId : uuid();
+    // First user of a brand-new tenant defaults to admin; otherwise viewer.
+    let resolvedRole: Role = 'viewer';
+    if (typeof role === 'string' && VALID_ROLES.includes(role as Role)) {
+      resolvedRole = role as Role;
+    } else if (!tenantId) {
+      resolvedRole = 'admin';
+    }
+
+    db.prepare(
+      `INSERT INTO users (id, email, password_hash, tenant_id, role)
+       VALUES (?, ?, ?, ?, ?)`,
+    ).run(id, email, hashPassword(password), tenant, resolvedRole);
+
+    const authUser = { id, email, tenantId: tenant, role: resolvedRole };
+    const token = signToken(authUser);
+    return res.status(201).json({ token, user: authUser });
+  });
+
+  // Log in and receive a JWT.
+  router.post('/login', (req, res) => {
+    const { email, password } = req.body ?? {};
+    if (typeof email !== 'string' || typeof password !== 'string') {
+      return res.status(400).json({ error: 'email and password are required' });
+    }
+    const user = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as User | undefined;
+    if (!user || !verifyPassword(password, user.password_hash)) {
+      return res.status(401).json({ error: 'Invalid credentials' });
+    }
+    const authUser = { id: user.id, email: user.email, tenantId: user.tenant_id, role: user.role };
+    return res.json({ token: signToken(authUser), user: authUser });
+  });
+
+  // View own profile.
+  router.get('/me', authenticate, (req, res) => {
+    const user = db
+      .prepare('SELECT id, email, tenant_id, role, created_at FROM users WHERE id = ?')
+      .get(req.user!.id) as Omit<User, 'password_hash'> | undefined;
+    if (!user) return res.status(404).json({ error: 'User not found' });
+    return res.json(user);
+  });
+
+  // List users in the caller's tenant (admin only).
+  router.get('/users', authenticate, requireRole('admin'), (req, res) => {
+    const users = db
+      .prepare('SELECT id, email, tenant_id, role, created_at FROM users WHERE tenant_id = ?')
+      .all(req.user!.tenantId);
+    return res.json(users);
+  });
+
+  // Admin changes another user's role within the same tenant.
+  router.patch('/users/:id/role', authenticate, requireRole('admin'), (req, res) => {
+    const { role } = req.body ?? {};
+    if (typeof role !== 'string' || !VALID_ROLES.includes(role as Role)) {
+      return res.status(400).json({ error: `role must be one of: ${VALID_ROLES.join(', ')}` });
+    }
+    const target = db
+      .prepare('SELECT * FROM users WHERE id = ?')
+      .get(req.params.id) as User | undefined;
+    if (!target || target.tenant_id !== req.user!.tenantId) {
+      return res.status(404).json({ error: 'User not found in your tenant' });
+    }
+    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);
+    return res.json({ id: target.id, role });
+  });
+
+  return router;
+}
diff --git a/src/routes/dashboards.ts b/src/routes/dashboards.ts
new file mode 100644
index 0000000..5b13eda
--- /dev/null
+++ b/src/routes/dashboards.ts
@@ -0,0 +1,96 @@
+import { Router } from 'express';
+import { v4 as uuid } from 'uuid';
+import type { DB } from '../db.js';
+import type { DashboardRow } from '../types.js';
+import { authenticate } from '../auth.js';
+
+export function dashboardsRouter(db: DB): Router {
+  const router = Router();
+  router.use(authenticate);
+
+  // Create a dashboard scoped to the caller's tenant.
+  router.post('/', (req, res) => {
+    const { name, config } = req.body ?? {};
+    if (typeof name !== 'string' || !name) {
+      return res.status(400).json({ error: 'name is required' });
+    }
+    const id = uuid();
+    const configStr = config && typeof config === 'object' ? JSON.stringify(config) : '{}';
+    db.prepare(
+      `INSERT INTO dashboards (id, tenant_id, name, owner_id, config)
+       VALUES (?, ?, ?, ?, ?)`,
+    ).run(id, req.user!.tenantId, name, req.user!.id, configStr);
+    return res.status(201).json(getDashboard(db, id, req.user!.tenantId));
+  });
+
+  // List dashboards in the tenant.
+  router.get('/', (req, res) => {
+    const rows = db
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC')
+      .all(req.user!.tenantId) as DashboardRow[];
+    return res.json(rows.map(serialize));
+  });
+
+  // Read a single dashboard (tenant-scoped).
+  router.get('/:id', (req, res) => {
+    const dash = getDashboard(db, req.params.id, req.user!.tenantId);
+    if (!dash) return res.status(404).json({ error: 'Dashboard not found' });
+    return res.json(dash);
+  });
+
+  // Update a dashboard's name and/or config.
+  router.put('/:id', (req, res) => {
+    const existing = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.user!.tenantId) as DashboardRow | undefined;
+    if (!existing) return res.status(404).json({ error: 'Dashboard not found' });
+
+    const { name, config } = req.body ?? {};
+    const newName = typeof name === 'string' && name ? name : existing.name;
+    const newConfig =
+      config && typeof config === 'object' ? JSON.stringify(config) : existing.config;
+    db.prepare(
+      `UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now')
+       WHERE id = ? AND tenant_id = ?`,
+    ).run(newName, newConfig, req.params.id, req.user!.tenantId);
+    return res.json(getDashboard(db, req.params.id, req.user!.tenantId));
+  });
+
+  // Delete a dashboard.
+  router.delete('/:id', (req, res) => {
+    const result = db
+      .prepare('DELETE FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .run(req.params.id, req.user!.tenantId);
+    if (result.changes === 0) return res.status(404).json({ error: 'Dashboard not found' });
+    return res.status(204).end();
+  });
+
+  return router;
+}
+
+function getDashboard(db: DB, id: string, tenantId: string) {
+  const row = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(id, tenantId) as DashboardRow | undefined;
+  return row ? serialize(row) : null;
+}
+
+function serialize(row: DashboardRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    owner_id: row.owner_id,
+    config: safeParse(row.config),
+    created_at: row.created_at,
+    updated_at: row.updated_at,
+  };
+}
+
+function safeParse(text: string): unknown {
+  try {
+    return JSON.parse(text);
+  } catch {
+    return {};
+  }
+}
diff --git a/src/routes/events.ts b/src/routes/events.ts
new file mode 100644
index 0000000..04cad0a
--- /dev/null
+++ b/src/routes/events.ts
@@ -0,0 +1,82 @@
+import { Router } from 'express';
+import { v4 as uuid } from 'uuid';
+import type { DB } from '../db.js';
+import { authenticate } from '../auth.js';
+
+interface IncomingEvent {
+  name?: unknown;
+  properties?: unknown;
+  timestamp?: unknown;
+  session_id?: unknown;
+}
+
+function normalize(ev: IncomingEvent): { name: string; properties: string; timestamp: string | null; sessionId: string | null } | null {
+  if (typeof ev.name !== 'string' || !ev.name) return null;
+  const properties =
+    ev.properties && typeof ev.properties === 'object'
+      ? JSON.stringify(ev.properties)
+      : '{}';
+  const timestamp = typeof ev.timestamp === 'string' && ev.timestamp ? ev.timestamp : null;
+  const sessionId = typeof ev.session_id === 'string' ? ev.session_id : null;
+  return { name: ev.name, properties, timestamp, sessionId };
+}
+
+export function eventsRouter(db: DB): Router {
+  const router = Router();
+  router.use(authenticate);
+
+  const insert = db.prepare(
+    `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+     VALUES (@id, @tenant_id, @name, @properties, COALESCE(@timestamp, datetime('now')), @user_id, @session_id)`,
+  );
+
+  // Ingest a single event.
+  router.post('/', (req, res) => {
+    const normalized = normalize(req.body ?? {});
+    if (!normalized) return res.status(400).json({ error: 'event name is required' });
+    const id = uuid();
+    insert.run({
+      id,
+      tenant_id: req.user!.tenantId,
+      name: normalized.name,
+      properties: normalized.properties,
+      timestamp: normalized.timestamp,
+      user_id: req.user!.id,
+      session_id: normalized.sessionId,
+    });
+    return res.status(201).json({ id, ingested: 1 });
+  });
+
+  // Ingest a batch of events efficiently in a single transaction.
+  router.post('/batch', (req, res) => {
+    const body = req.body ?? {};
+    const list: unknown = Array.isArray(body) ? body : body.events;
+    if (!Array.isArray(list)) {
+      return res.status(400).json({ error: 'expected an array of events (or { events: [...] })' });
+    }
+    const normalized = list.map((e) => normalize(e as IncomingEvent));
+    if (normalized.some((n) => n === null)) {
+      return res.status(400).json({ error: 'every event must have a name' });
+    }
+    const ids: string[] = [];
+    const insertMany = db.transaction((events: NonNullable<ReturnType<typeof normalize>>[]) => {
+      for (const ev of events) {
+        const id = uuid();
+        ids.push(id);
+        insert.run({
+          id,
+          tenant_id: req.user!.tenantId,
+          name: ev.name,
+          properties: ev.properties,
+          timestamp: ev.timestamp,
+          user_id: req.user!.id,
+          session_id: ev.sessionId,
+        });
+      }
+    });
+    insertMany(normalized as NonNullable<ReturnType<typeof normalize>>[]);
+    return res.status(201).json({ ingested: ids.length, ids });
+  });
+
+  return router;
+}
diff --git a/src/routes/export.ts b/src/routes/export.ts
new file mode 100644
index 0000000..a758db8
--- /dev/null
+++ b/src/routes/export.ts
@@ -0,0 +1,82 @@
+import { Router } from 'express';
+import type { DB } from '../db.js';
+import type { DashboardRow, EventRow } from '../types.js';
+import { authenticate } from '../auth.js';
+import { listEvents, type EventFilter } from '../query.js';
+
+function csvEscape(value: unknown): string {
+  const s = value === null || value === undefined ? '' : String(value);
+  if (/[",\n]/.test(s)) {
+    return `"${s.replace(/"/g, '""')}"`;
+  }
+  return s;
+}
+
+function toCsv(headers: string[], rows: Record<string, unknown>[]): string {
+  const lines = [headers.map(csvEscape).join(',')];
+  for (const row of rows) {
+    lines.push(headers.map((h) => csvEscape(row[h])).join(','));
+  }
+  return lines.join('\n');
+}
+
+function parseFilter(q: Record<string, unknown>): EventFilter {
+  const filter: EventFilter = {};
+  if (typeof q.name === 'string') filter.name = q.name;
+  if (typeof q.from === 'string') filter.from = q.from;
+  if (typeof q.to === 'string') filter.to = q.to;
+  return filter;
+}
+
+export function exportRouter(db: DB): Router {
+  const router = Router();
+  router.use(authenticate);
+
+  // Export tenant events as ?format=csv|json (default json).
+  router.get('/events', (req, res) => {
+    const format = (req.query.format as string) ?? 'json';
+    const filter = parseFilter(req.query as Record<string, unknown>);
+    const events = listEvents(db, req.user!.tenantId, filter) as EventRow[];
+
+    if (format === 'csv') {
+      const headers = ['id', 'tenant_id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'];
+      const csv = toCsv(headers, events as unknown as Record<string, unknown>[]);
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', 'attachment; filename="events.csv"');
+      return res.send(csv);
+    }
+    res.setHeader('Content-Type', 'application/json');
+    return res.json({
+      events: events.map((e) => ({ ...e, properties: safeParse(e.properties) })),
+    });
+  });
+
+  // Export a single dashboard's configuration as ?format=csv|json.
+  router.get('/dashboards/:id', (req, res) => {
+    const format = (req.query.format as string) ?? 'json';
+    const dash = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.user!.tenantId) as DashboardRow | undefined;
+    if (!dash) return res.status(404).json({ error: 'Dashboard not found' });
+
+    if (format === 'csv') {
+      const headers = ['id', 'tenant_id', 'name', 'owner_id', 'config', 'created_at', 'updated_at'];
+      const csv = toCsv(headers, [dash as unknown as Record<string, unknown>]);
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', `attachment; filename="dashboard-${dash.id}.csv"`);
+      return res.send(csv);
+    }
+    res.setHeader('Content-Type', 'application/json');
+    return res.json({ ...dash, config: safeParse(dash.config) });
+  });
+
+  return router;
+}
+
+function safeParse(text: string): unknown {
+  try {
+    return JSON.parse(text);
+  } catch {
+    return {};
+  }
+}
diff --git a/src/routes/query.ts b/src/routes/query.ts
new file mode 100644
index 0000000..c97692d
--- /dev/null
+++ b/src/routes/query.ts
@@ -0,0 +1,51 @@
+import { Router } from 'express';
+import type { DB } from '../db.js';
+import { authenticate } from '../auth.js';
+import { breakdown, count, timeseries, type EventFilter, type Interval } from '../query.js';
+
+const VALID_INTERVALS: Interval[] = ['hour', 'day', 'week', 'month'];
+
+function parseFilter(body: Record<string, unknown>): EventFilter {
+  const filter: EventFilter = {};
+  if (typeof body.name === 'string') filter.name = body.name;
+  if (typeof body.from === 'string') filter.from = body.from;
+  if (typeof body.to === 'string') filter.to = body.to;
+  if (body.properties && typeof body.properties === 'object') {
+    filter.properties = body.properties as Record<string, string | number | boolean>;
+  }
+  return filter;
+}
+
+export function queryRouter(db: DB): Router {
+  const router = Router();
+  router.use(authenticate);
+
+  // Count events matching a filter.
+  router.post('/count', (req, res) => {
+    const filter = parseFilter(req.body ?? {});
+    return res.json({ count: count(db, req.user!.tenantId, filter) });
+  });
+
+  // Timeseries: bucket counts over time.
+  router.post('/timeseries', (req, res) => {
+    const body = req.body ?? {};
+    const interval: Interval = VALID_INTERVALS.includes(body.interval) ? body.interval : 'day';
+    const filter = parseFilter(body);
+    return res.json({ interval, series: timeseries(db, req.user!.tenantId, interval, filter) });
+  });
+
+  // Breakdown: group counts by a property value.
+  router.post('/breakdown', (req, res) => {
+    const body = req.body ?? {};
+    if (typeof body.property !== 'string' || !body.property) {
+      return res.status(400).json({ error: 'property is required' });
+    }
+    const filter = parseFilter(body);
+    return res.json({
+      property: body.property,
+      breakdown: breakdown(db, req.user!.tenantId, body.property, filter),
+    });
+  });
+
+  return router;
+}
