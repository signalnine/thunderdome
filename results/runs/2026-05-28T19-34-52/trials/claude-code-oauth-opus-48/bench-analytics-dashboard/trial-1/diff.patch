+++ b/src/db.ts
@@ -0,0 +1,36 @@
+import Database from 'better-sqlite3';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+export type DB = Database.Database;
+
+/**
+ * Create and initialize a SQLite database using the provided schema.sql.
+ * Defaults to an in-memory database, which is convenient for tests.
+ */
+export function createDb(dbPath = ':memory:'): DB {
+  const db = new Database(dbPath);
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+
+  const schema = loadSchema();
+  db.exec(schema);
+  return db;
+}
+
+function loadSchema(): string {
+  // schema.sql lives at the project root. Try a couple of likely locations so
+  // this works both when running compiled code (dist/) and TS directly (tests).
+  const candidates = [
+    join(__dirname, '..', 'schema.sql'),
+    join(process.cwd(), 'schema.sql'),
+  ];
+  for (const path of candidates) {
+    try {
+      return readFileSync(path, 'utf-8');
+    } catch {
+      // try next candidate
+    }
+  }
+  throw new Error('Could not locate schema.sql');
+}
