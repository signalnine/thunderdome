+++ b/src/app.ts
@@ -0,0 +1,43 @@
+import express, { type Express, type NextFunction, type Request, type Response } from 'express';
+import { createDb, type DB } from './db.js';
+import { authRouter } from './routes/auth.js';
+import { eventsRouter } from './routes/events.js';
+import { queryRouter } from './routes/query.js';
+import { dashboardsRouter } from './routes/dashboards.js';
+import { exportRouter } from './routes/export.js';
+
+export interface AppOptions {
+  /** Provide an existing database, or a path. Defaults to a fresh in-memory DB. */
+  db?: DB;
+  dbPath?: string;
+}
+
+/** Create the Express application for the analytics dashboard API. */
+export function createApp(options: AppOptions = {}): Express {
+  const db = options.db ?? createDb(options.dbPath);
+  const app = express();
+  app.use(express.json({ limit: '10mb' }));
+
+  app.get('/health', (_req, res) => {
+    res.json({ status: 'ok' });
+  });
+
+  app.use('/auth', authRouter(db));
+  app.use('/events', eventsRouter(db));
+  app.use('/query', queryRouter(db));
+  app.use('/dashboards', dashboardsRouter(db));
+  app.use('/export', exportRouter(db));
+
+  // 404 fallback
+  app.use((_req, res) => {
+    res.status(404).json({ error: 'Not found' });
+  });
+
+  // Centralized error handler (e.g. malformed JSON bodies).
+  // eslint-disable-next-line @typescript-eslint/no-unused-vars
+  app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
+    res.status(400).json({ error: err.message || 'Bad request' });
+  });
+
+  return app;
+}
diff --git a/src/auth.ts b/src/auth.ts
new file mode 100644
index 0000000..87034e6
--- /dev/null
+++ b/src/auth.ts
@@ -0,0 +1,77 @@
+import { randomBytes, scryptSync, timingSafeEqual } from 'node:crypto';
+import jwt from 'jsonwebtoken';
+import type { NextFunction, Request, Response } from 'express';
+import type { AuthUser, Role } from './types.js';
+
+export const JWT_SECRET = process.env.JWT_SECRET ?? 'dev-secret-change-me';
+const TOKEN_TTL = '24h';
+
+/** Hash a password with a random salt using scrypt. Format: salt:hash (hex). */
+export function hashPassword(password: string): string {
+  const salt = randomBytes(16);
+  const derived = scryptSync(password, salt, 64);
+  return `${salt.toString('hex')}:${derived.toString('hex')}`;
+}
+
+export function verifyPassword(password: string, stored: string): boolean {
+  const [saltHex, hashHex] = stored.split(':');
+  if (!saltHex || !hashHex) return false;
+  const salt = Buffer.from(saltHex, 'hex');
+  const expected = Buffer.from(hashHex, 'hex');
+  const derived = scryptSync(password, salt, expected.length);
+  return expected.length === derived.length && timingSafeEqual(expected, derived);
+}
+
+export interface TokenPayload {
+  sub: string;
+  email: string;
+  tenantId: string;
+  role: Role;
+}
+
+export function signToken(user: AuthUser): string {
+  const payload: TokenPayload = {
+    sub: user.id,
+    email: user.email,
+    tenantId: user.tenantId,
+    role: user.role,
+  };
+  return jwt.sign(payload, JWT_SECRET, { expiresIn: TOKEN_TTL });
+}
+
+/** Express middleware: requires a valid Bearer token, attaches req.user. */
+export function authenticate(req: Request, res: Response, next: NextFunction): void {
+  const header = req.headers.authorization;
+  if (!header || !header.startsWith('Bearer ')) {
+    res.status(401).json({ error: 'Missing or invalid Authorization header' });
+    return;
+  }
+  const token = header.slice('Bearer '.length).trim();
+  try {
+    const decoded = jwt.verify(token, JWT_SECRET) as TokenPayload;
+    req.user = {
+      id: decoded.sub,
+      email: decoded.email,
+      tenantId: decoded.tenantId,
+      role: decoded.role,
+    };
+    next();
+  } catch {
+    res.status(401).json({ error: 'Invalid or expired token' });
+  }
+}
+
+/** Express middleware factory: requires the authenticated user to have one of the roles. */
+export function requireRole(...roles: Role[]) {
+  return (req: Request, res: Response, next: NextFunction): void => {
+    if (!req.user) {
+      res.status(401).json({ error: 'Unauthenticated' });
+      return;
+    }
+    if (!roles.includes(req.user.role)) {
+      res.status(403).json({ error: 'Insufficient permissions' });
+      return;
+    }
+    next();
+  };
+}
