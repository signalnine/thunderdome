diff --git a/src/queries.ts b/src/queries.ts
new file mode 100644
index 0000000..d02c27b
--- /dev/null
+++ b/src/queries.ts
@@ -0,0 +1,90 @@
+import type { DB } from './db.js';
+
+export interface QueryFilter {
+  name?: string;
+  from?: string;
+  to?: string;
+  // equality filters on event properties, e.g. { url: '/home' }
+  properties?: Record<string, string | number | boolean>;
+}
+
+interface BuiltWhere {
+  clause: string;
+  params: unknown[];
+}
+
+// Builds a WHERE clause that always scopes to a single tenant.
+function buildWhere(tenantId: string, filter: QueryFilter): BuiltWhere {
+  const parts: string[] = ['tenant_id = ?'];
+  const params: unknown[] = [tenantId];
+
+  if (filter.name) {
+    parts.push('name = ?');
+    params.push(filter.name);
+  }
+  if (filter.from) {
+    parts.push('timestamp >= ?');
+    params.push(filter.from);
+  }
+  if (filter.to) {
+    parts.push('timestamp <= ?');
+    params.push(filter.to);
+  }
+  if (filter.properties) {
+    for (const [key, value] of Object.entries(filter.properties)) {
+      parts.push(`json_extract(properties, '$.' || ?) = ?`);
+      params.push(key, value);
+    }
+  }
+  return { clause: parts.join(' AND '), params };
+}
+
+export function countEvents(db: DB, tenantId: string, filter: QueryFilter): number {
+  const { clause, params } = buildWhere(tenantId, filter);
+  const row = db
+    .prepare(`SELECT COUNT(*) AS count FROM events WHERE ${clause}`)
+    .get(...params) as { count: number };
+  return row.count;
+}
+
+export type Interval = 'hour' | 'day' | 'week' | 'month';
+
+const INTERVAL_FORMAT: Record<Interval, string> = {
+  hour: '%Y-%m-%dT%H:00',
+  day: '%Y-%m-%d',
+  week: '%Y-%W',
+  month: '%Y-%m',
+};
+
+export function timeseries(
+  db: DB,
+  tenantId: string,
+  interval: Interval,
+  filter: QueryFilter,
+): Array<{ bucket: string; count: number }> {
+  const fmt = INTERVAL_FORMAT[interval] ?? INTERVAL_FORMAT.day;
+  const { clause, params } = buildWhere(tenantId, filter);
+  return db
+    .prepare(
+      `SELECT strftime('${fmt}', timestamp) AS bucket, COUNT(*) AS count
+       FROM events WHERE ${clause}
+       GROUP BY bucket ORDER BY bucket ASC`,
+    )
+    .all(...params) as Array<{ bucket: string; count: number }>;
+}
+
+export function breakdown(
+  db: DB,
+  tenantId: string,
+  property: string,
+  filter: QueryFilter,
+): Array<{ value: string | null; count: number }> {
+  const { clause, params } = buildWhere(tenantId, filter);
+  return db
+    .prepare(
+      `SELECT json_extract(properties, '$.' || ?) AS value, COUNT(*) AS count
+       FROM events WHERE ${clause}
+       GROUP BY value ORDER BY count DESC`,
+    )
+    .all(property, ...params) as Array<{ value: string | null; count: number }>;
+}
