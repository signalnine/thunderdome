diff --git a/src/app.ts b/src/app.ts
new file mode 100644
index 0000000..f2e42df
--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,381 @@
+import express, { type Response } from 'express';
+import { v4 as uuid } from 'uuid';
+import { createDb, type DB } from './db.js';
+import {
+  authMiddleware,
+  hashPassword,
+  requireRole,
+  signToken,
+  verifyPassword,
+} from './auth.js';
+import {
+  breakdown,
+  countEvents,
+  timeseries,
+  type Interval,
+  type QueryFilter,
+} from './queries.js';
+import type {
+  AuthRequest,
+  DashboardRow,
+  EventRow,
+  Role,
+  UserRow,
+} from './types.js';
+
+const ROLES: Role[] = ['admin', 'editor', 'viewer'];
+
+export interface AppOptions {
+  db?: DB;
+  dbPath?: string;
+}
+
+function toCsv(rows: Array<Record<string, unknown>>): string {
+  if (rows.length === 0) return '';
+  const headers = Object.keys(rows[0]);
+  const escape = (val: unknown): string => {
+    if (val === null || val === undefined) return '';
+    const str = typeof val === 'object' ? JSON.stringify(val) : String(val);
+    if (/[",\n]/.test(str)) return `"${str.replace(/"/g, '""')}"`;
+    return str;
+  };
+  const lines = [headers.join(',')];
+  for (const row of rows) {
+    lines.push(headers.map((h) => escape(row[h])).join(','));
+  }
+  return lines.join('\n');
+}
+
+export function createApp(options: AppOptions = {}): express.Express {
+  const db = options.db ?? createDb(options.dbPath);
+  const app = express();
+  app.use(express.json({ limit: '10mb' }));
+
+  // ---- User Management ----------------------------------------------------
+
+  app.post('/auth/register', (req: AuthRequest, res: Response) => {
+    const { email, password } = req.body ?? {};
+    let { tenantId, role } = req.body ?? {};
+    if (typeof email !== 'string' || typeof password !== 'string' || !email || !password) {
+      return res.status(400).json({ error: 'email and password are required' });
+    }
+    // New tenant if none supplied -> first user becomes admin.
+    if (typeof tenantId !== 'string' || !tenantId) {
+      tenantId = uuid();
+      role = 'admin';
+    }
+    if (typeof role !== 'string' || !ROLES.includes(role as Role)) {
+      role = 'viewer';
+    }
+    const id = uuid();
+    try {
+      db.prepare(
+        `INSERT INTO users (id, email, password_hash, tenant_id, role)
+         VALUES (?, ?, ?, ?, ?)`,
+      ).run(id, email, hashPassword(password), tenantId, role);
+    } catch {
+      return res.status(409).json({ error: 'email already registered' });
+    }
+    const token = signToken({ userId: id, tenantId, role: role as Role, email });
+    return res.status(201).json({ token, user: { id, email, tenantId, role } });
+  });
+
+  app.post('/auth/login', (req: AuthRequest, res: Response) => {
+    const { email, password } = req.body ?? {};
+    if (typeof email !== 'string' || typeof password !== 'string') {
+      return res.status(400).json({ error: 'email and password are required' });
+    }
+    const user = db
+      .prepare('SELECT * FROM users WHERE email = ?')
+      .get(email) as UserRow | undefined;
+    if (!user || !verifyPassword(password, user.password_hash)) {
+      return res.status(401).json({ error: 'invalid credentials' });
+    }
+    const token = signToken({
+      userId: user.id,
+      tenantId: user.tenant_id,
+      role: user.role,
+      email: user.email,
+    });
+    return res.json({
+      token,
+      user: { id: user.id, email: user.email, tenantId: user.tenant_id, role: user.role },
+    });
+  });
+
+  // Everything below requires authentication.
+  app.use(authMiddleware);
+
+  app.get('/me', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const user = db
+      .prepare('SELECT id, email, tenant_id, role, created_at FROM users WHERE id = ?')
+      .get(auth.userId) as Omit<UserRow, 'password_hash'> | undefined;
+    if (!user) return res.status(404).json({ error: 'user not found' });
+    return res.json(user);
+  });
+
+  app.get('/users', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const users = db
+      .prepare(
+        'SELECT id, email, tenant_id, role, created_at FROM users WHERE tenant_id = ? ORDER BY created_at',
+      )
+      .all(auth.tenantId);
+    return res.json(users);
+  });
+
+  app.patch(
+    '/users/:id/role',
+    requireRole('admin'),
+    (req: AuthRequest, res: Response) => {
+      const auth = req.auth!;
+      const { role } = req.body ?? {};
+      if (typeof role !== 'string' || !ROLES.includes(role as Role)) {
+        return res.status(400).json({ error: 'valid role is required' });
+      }
+      const target = db
+        .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')
+        .get(req.params.id, auth.tenantId) as UserRow | undefined;
+      if (!target) return res.status(404).json({ error: 'user not found in tenant' });
+      db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);
+      return res.json({ id: target.id, role });
+    },
+  );
+
+  // ---- Data Ingestion -----------------------------------------------------
+
+  const insertEvent = db.prepare(
+    `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+     VALUES (@id, @tenant_id, @name, @properties, @timestamp, @user_id, @session_id)`,
+  );
+
+  function buildEventRow(
+    tenantId: string,
+    userId: string,
+    body: Record<string, unknown>,
+  ): EventRow {
+    if (typeof body.name !== 'string' || !body.name) {
+      throw new Error('event name is required');
+    }
+    return {
+      id: uuid(),
+      tenant_id: tenantId,
+      name: body.name,
+      properties: JSON.stringify(body.properties ?? {}),
+      timestamp:
+        typeof body.timestamp === 'string'
+          ? body.timestamp
+          : new Date().toISOString(),
+      user_id: userId,
+      session_id: typeof body.session_id === 'string' ? body.session_id : null,
+    };
+  }
+
+  app.post('/events', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    try {
+      const row = buildEventRow(auth.tenantId, auth.userId, req.body ?? {});
+      insertEvent.run(row);
+      return res.status(201).json({ id: row.id });
+    } catch (err) {
+      return res.status(400).json({ error: (err as Error).message });
+    }
+  });
+
+  app.post('/events/batch', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const events = (req.body ?? {}).events;
+    if (!Array.isArray(events)) {
+      return res.status(400).json({ error: 'events array is required' });
+    }
+    try {
+      const rows = events.map((e) =>
+        buildEventRow(auth.tenantId, auth.userId, e as Record<string, unknown>),
+      );
+      const insertMany = db.transaction((items: EventRow[]) => {
+        for (const row of items) insertEvent.run(row);
+      });
+      insertMany(rows);
+      return res.status(201).json({ inserted: rows.length });
+    } catch (err) {
+      return res.status(400).json({ error: (err as Error).message });
+    }
+  });
+
+  // ---- Query Engine -------------------------------------------------------
+
+  function parseFilter(body: Record<string, unknown>): QueryFilter {
+    return {
+      name: typeof body.name === 'string' ? body.name : undefined,
+      from: typeof body.from === 'string' ? body.from : undefined,
+      to: typeof body.to === 'string' ? body.to : undefined,
+      properties:
+        body.properties && typeof body.properties === 'object'
+          ? (body.properties as Record<string, string | number | boolean>)
+          : undefined,
+    };
+  }
+
+  app.post('/query/count', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const count = countEvents(db, auth.tenantId, parseFilter(req.body ?? {}));
+    return res.json({ count });
+  });
+
+  app.post('/query/timeseries', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const body = req.body ?? {};
+    const allowed: Interval[] = ['hour', 'day', 'week', 'month'];
+    const interval: Interval = allowed.includes(body.interval)
+      ? body.interval
+      : 'day';
+    const buckets = timeseries(db, auth.tenantId, interval, parseFilter(body));
+    return res.json({ interval, buckets });
+  });
+
+  app.post('/query/breakdown', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const body = req.body ?? {};
+    if (typeof body.property !== 'string' || !body.property) {
+      return res.status(400).json({ error: 'property is required' });
+    }
+    const groups = breakdown(db, auth.tenantId, body.property, parseFilter(body));
+    return res.json({ property: body.property, groups });
+  });
+
+  // ---- Dashboard Configuration --------------------------------------------
+
+  app.get('/dashboards', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const rows = db
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at')
+      .all(auth.tenantId) as DashboardRow[];
+    return res.json(rows.map(serializeDashboard));
+  });
+
+  app.post('/dashboards', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const { name, config } = req.body ?? {};
+    if (typeof name !== 'string' || !name) {
+      return res.status(400).json({ error: 'name is required' });
+    }
+    const id = uuid();
+    db.prepare(
+      `INSERT INTO dashboards (id, tenant_id, name, owner_id, config)
+       VALUES (?, ?, ?, ?, ?)`,
+    ).run(id, auth.tenantId, name, auth.userId, JSON.stringify(config ?? {}));
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+    return res.status(201).json(serializeDashboard(row));
+  });
+
+  function getOwnDashboard(tenantId: string, id: string): DashboardRow | undefined {
+    return db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(id, tenantId) as DashboardRow | undefined;
+  }
+
+  app.get('/dashboards/:id', (req: AuthRequest, res: Response) => {
+    const row = getOwnDashboard(req.auth!.tenantId, req.params.id);
+    if (!row) return res.status(404).json({ error: 'dashboard not found' });
+    return res.json(serializeDashboard(row));
+  });
+
+  app.put('/dashboards/:id', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const existing = getOwnDashboard(auth.tenantId, req.params.id);
+    if (!existing) return res.status(404).json({ error: 'dashboard not found' });
+    const { name, config } = req.body ?? {};
+    const newName = typeof name === 'string' && name ? name : existing.name;
+    const newConfig =
+      config !== undefined ? JSON.stringify(config) : existing.config;
+    db.prepare(
+      `UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?`,
+    ).run(newName, newConfig, existing.id);
+    const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(existing.id) as DashboardRow;
+    return res.json(serializeDashboard(row));
+  });
+
+  app.delete('/dashboards/:id', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const existing = getOwnDashboard(auth.tenantId, req.params.id);
+    if (!existing) return res.status(404).json({ error: 'dashboard not found' });
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(existing.id);
+    return res.status(204).end();
+  });
+
+  // ---- Data Export --------------------------------------------------------
+
+  app.get('/export/events', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const format = (req.query.format as string) ?? 'json';
+    const rows = db
+      .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp')
+      .all(auth.tenantId) as EventRow[];
+    const data = rows.map((r) => ({
+      id: r.id,
+      name: r.name,
+      properties: r.properties,
+      timestamp: r.timestamp,
+      user_id: r.user_id,
+      session_id: r.session_id,
+    }));
+    if (format === 'csv') {
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', 'attachment; filename="events.csv"');
+      return res.send(toCsv(data));
+    }
+    res.setHeader('Content-Type', 'application/json');
+    return res.json(data.map((d) => ({ ...d, properties: JSON.parse(d.properties) })));
+  });
+
+  app.get('/export/dashboards/:id', (req: AuthRequest, res: Response) => {
+    const auth = req.auth!;
+    const row = getOwnDashboard(auth.tenantId, req.params.id);
+    if (!row) return res.status(404).json({ error: 'dashboard not found' });
+    const format = (req.query.format as string) ?? 'json';
+    const dashboard = serializeDashboard(row);
+    if (format === 'csv') {
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', 'attachment; filename="dashboard.csv"');
+      return res.send(
+        toCsv([
+          {
+            id: dashboard.id,
+            name: dashboard.name,
+            owner_id: dashboard.owner_id,
+            config: JSON.stringify(dashboard.config),
+            created_at: dashboard.created_at,
+            updated_at: dashboard.updated_at,
+          },
+        ]),
+      );
+    }
+    res.setHeader('Content-Type', 'application/json');
+    return res.json(dashboard);
+  });
+
+  return app;
+}
+
+function serializeDashboard(row: DashboardRow): Omit<DashboardRow, 'config'> & {
+  config: unknown;
+} {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    owner_id: row.owner_id,
+    config: safeParse(row.config),
+    created_at: row.created_at,
+    updated_at: row.updated_at,
+  };
+}
+
+function safeParse(text: string): unknown {
+  try {
+    return JSON.parse(text);
+  } catch {
+    return {};
+  }
+}
