@@ -0,0 +1,172 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import request from 'supertest';
+import { createApp } from '../src/app.js';
+
+function makeApp() {
+  return createApp({ dbPath: ':memory:' });
+}
+
+async function registerAdmin(app: ReturnType<typeof makeApp>) {
+  const res = await request(app)
+    .post('/auth/register')
+    .send({ email: `a${Math.random()}@x.com`, password: 'pw' });
+  return res.body as { token: string; user: { tenantId: string; id: string } };
+}
+
+describe('auth & tenant isolation', () => {
+  let app: ReturnType<typeof makeApp>;
+  beforeEach(() => {
+    app = makeApp();
+  });
+
+  it('rejects unauthenticated access to protected routes with 401', async () => {
+    await request(app).get('/me').expect(401);
+    await request(app).post('/events').send({ name: 'x' }).expect(401);
+    await request(app).get('/dashboards').expect(401);
+  });
+
+  it('registers, logs in, and returns profile', async () => {
+    const { token, user } = await registerAdmin(app);
+    expect(token).toBeTruthy();
+    const me = await request(app)
+      .get('/me')
+      .set('Authorization', `Bearer ${token}`)
+      .expect(200);
+    expect(me.body.id).toBe(user.id);
+    expect(me.body.role).toBe('admin');
+  });
+
+  it('admin can change a user role within tenant', async () => {
+    const { token, user } = await registerAdmin(app);
+    const reg2 = await request(app)
+      .post('/auth/register')
+      .send({ email: 'b@x.com', password: 'pw', tenantId: user.tenantId });
+    const otherId = reg2.body.user.id;
+    const patch = await request(app)
+      .patch(`/users/${otherId}/role`)
+      .set('Authorization', `Bearer ${token}`)
+      .send({ role: 'editor' })
+      .expect(200);
+    expect(patch.body.role).toBe('editor');
+  });
+
+  it('non-admin cannot change roles', async () => {
+    const { user } = await registerAdmin(app);
+    const reg2 = await request(app)
+      .post('/auth/register')
+      .send({ email: 'c@x.com', password: 'pw', tenantId: user.tenantId, role: 'viewer' });
+    await request(app)
+      .patch(`/users/${user.id}/role`)
+      .set('Authorization', `Bearer ${reg2.body.token}`)
+      .send({ role: 'admin' })
+      .expect(403);
+  });
+});
+
+describe('ingestion & query engine', () => {
+  let app: ReturnType<typeof makeApp>;
+  let token: string;
+  beforeEach(async () => {
+    app = makeApp();
+    token = (await registerAdmin(app)).token;
+  });
+
+  const auth = () => ({ Authorization: `Bearer ${token}` });
+
+  it('ingests single and batch events and counts them', async () => {
+    await request(app).post('/events').set(auth()).send({ name: 'page_view', properties: { url: '/a' }, timestamp: '2026-01-01T10:00:00Z' }).expect(201);
+    await request(app)
+      .post('/events/batch')
+      .set(auth())
+      .send({
+        events: [
+          { name: 'page_view', properties: { url: '/b' }, timestamp: '2026-01-02T10:00:00Z' },
+          { name: 'click', properties: { url: '/a' }, timestamp: '2026-01-02T11:00:00Z' },
+        ],
+      })
+      .expect(201);
+
+    const count = await request(app).post('/query/count').set(auth()).send({ name: 'page_view' }).expect(200);
+    expect(count.body.count).toBe(2);
+  });
+
+  it('timeseries buckets by day', async () => {
+    await request(app).post('/events/batch').set(auth()).send({
+      events: [
+        { name: 'page_view', timestamp: '2026-01-01T10:00:00Z' },
+        { name: 'page_view', timestamp: '2026-01-01T12:00:00Z' },
+        { name: 'page_view', timestamp: '2026-01-02T10:00:00Z' },
+      ],
+    });
+    const ts = await request(app).post('/query/timeseries').set(auth()).send({ name: 'page_view', interval: 'day' }).expect(200);
+    expect(ts.body.buckets).toEqual([
+      { bucket: '2026-01-01', count: 2 },
+      { bucket: '2026-01-02', count: 1 },
+    ]);
+  });
+
+  it('breakdown groups by property', async () => {
+    await request(app).post('/events/batch').set(auth()).send({
+      events: [
+        { name: 'page_view', properties: { url: '/a' } },
+        { name: 'page_view', properties: { url: '/a' } },
+        { name: 'page_view', properties: { url: '/b' } },
+      ],
+    });
+    const bd = await request(app).post('/query/breakdown').set(auth()).send({ property: 'url', name: 'page_view' }).expect(200);
+    const map = Object.fromEntries(bd.body.groups.map((g: { value: string; count: number }) => [g.value, g.count]));
+    expect(map).toEqual({ '/a': 2, '/b': 1 });
+  });
+
+  it('enforces tenant isolation on queries', async () => {
+    await request(app).post('/events').set(auth()).send({ name: 'secret' });
+    const other = await registerAdmin(app); // different tenant
+    const count = await request(app)
+      .post('/query/count')
+      .set('Authorization', `Bearer ${other.token}`)
+      .send({ name: 'secret' })
+      .expect(200);
+    expect(count.body.count).toBe(0);
+  });
+});
+
+describe('dashboards & export', () => {
+  let app: ReturnType<typeof makeApp>;
+  let token: string;
+  beforeEach(async () => {
+    app = makeApp();
+    token = (await registerAdmin(app)).token;
+  });
+  const auth = () => ({ Authorization: `Bearer ${token}` });
+
+  it('CRUD on dashboards', async () => {
+    const created = await request(app).post('/dashboards').set(auth()).send({ name: 'D1', config: { x: 1 } }).expect(201);
+    const id = created.body.id;
+    expect(created.body.config).toEqual({ x: 1 });
+
+    await request(app).get(`/dashboards/${id}`).set(auth()).expect(200);
+    const upd = await request(app).put(`/dashboards/${id}`).set(auth()).send({ name: 'D2' }).expect(200);
+    expect(upd.body.name).toBe('D2');
+    await request(app).get('/dashboards').set(auth()).expect(200);
+    await request(app).delete(`/dashboards/${id}`).set(auth()).expect(204);
+    await request(app).get(`/dashboards/${id}`).set(auth()).expect(404);
+  });
+
+  it('dashboards are tenant scoped', async () => {
+    const created = await request(app).post('/dashboards').set(auth()).send({ name: 'D1' }).expect(201);
+    const other = await registerAdmin(app);
+    await request(app)
+      .get(`/dashboards/${created.body.id}`)
+      .set('Authorization', `Bearer ${other.token}`)
+      .expect(404);
+  });
+
+  it('exports events as json and csv', async () => {
+    await request(app).post('/events').set(auth()).send({ name: 'page_view', properties: { url: '/a' } });
+    const json = await request(app).get('/export/events?format=json').set(auth()).expect(200);
+    expect(json.body[0].properties).toEqual({ url: '/a' });
+    const csv = await request(app).get('/export/events?format=csv').set(auth()).expect(200);
+    expect(csv.text).toContain('page_view');
+    expect(csv.headers['content-type']).toContain('text/csv');
+  });
+});
