heet();\n    s.set('A1', 5);\n    s.set('B1', '=IF(A1>=5, 1, 0)');\n    s.set('B2', '=IF(A1<=4, 1, 0)');\n    s.set('B3', '=IF(A1=5, 1, 0)');\n    s.set('B4', '=IF(A1<>5, 1, 0)');\n    s.set('B5', '=IF(A1<10, 1, 0)');\n    expect(s.get('B1')).toBe(1);\n    expect(s.get('B2')).toBe(0);\n    expect(s.get('B3')).toBe(1);\n    expect(s.get('B4')).toBe(0);\n    expect(s.get('B5')).toBe(1);\n  });\n\n  it('compares strings', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 'apple');\n    s.set('B1', '=IF(A1=\"apple\", \"yes\", \"no\")');\n    expect(s.get('B1')).toBe('yes');\n  });\n\n  it('nests functions and IF', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 20);\n    s.set('A3', 30);\n    s.set('B1', '=IF(SUM(A1:A3)>50, MAX(A1:A3), MIN(A1:A3))');\n    expect(s.get('B1')).toBe(30);\n  });\n});\n\ndescribe('circular references', () => {\n  it('throws on a direct self reference', () => {\n    const s = new Spreadsheet();\n    expect(() => s.set('A1', '=A1')).toThrow(/circular/i);\n  });\n\n  it('throws on a two-cell cycle', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1');\n    expect(() => s.set('B1', '=A1')).toThrow(/circular/i);\n  });\n\n  it('throws on an indirect cycle', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1');\n    s.set('B1', '=C1');\n    expect(() => s.set('C1', '=A1')).toThrow(/circular/i);\n  });\n\n  it('does not mutate state when a cycle is rejected', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=A1');\n    expect(() => s.set('A1', '=B1')).toThrow();\n    // A1 keeps its old value and the graph still works.\n    expect(s.get('A1')).toBe(5);\n    expect(s.get('B1')).toBe(5);\n    s.set('A1', 9);\n    expect(s.get('B1')).toBe(9);\n  });\n\n  it('allows reusing a reference that is not part of a cycle', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('B1', '=A1');\n    s.set('C1', '=A1+B1');\n    expect(s.get('C1'))