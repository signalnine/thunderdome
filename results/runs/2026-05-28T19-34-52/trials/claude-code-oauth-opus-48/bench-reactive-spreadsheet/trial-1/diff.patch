inus', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('A2', 4);\n    s.set('B1', '=A1-A2');\n    s.set('B2', '=A1/A2');\n    s.set('B3', '=-A1+1');\n    expect(s.get('B1')).toBe(6);\n    expect(s.get('B2')).toBe(2.5);\n    expect(s.get('B3')).toBe(-9);\n  });\n\n  it('treats empty referenced cells as zero', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1+5');\n    expect(s.get('A1')).toBe(5);\n  });\n\n  it('reports division by zero', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=1/0');\n    expect(s.get('A1')).toBe('#DIV/0!');\n    expect(s.getDisplay('A1')).toBe('#DIV/0!');\n  });\n});\n\ndescribe('reactive updates', () => {\n  it('recomputes dependents when a value changes', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe(6);\n    s.set('A1', 10);\n    expect(s.get('B1')).toBe(11);\n  });\n\n  it('propagates through transitive chains', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', '=A1+1');\n    s.set('A3', '=A2+1');\n    s.set('A4', '=A3+1');\n    expect(s.get('A4')).toBe(4);\n    s.set('A1', 10);\n    expect(s.get('A2')).toBe(11);\n    expect(s.get('A3')).toBe(12);\n    expect(s.get('A4')).toBe(13);\n  });\n\n  it('updates when an empty dependency becomes populated', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1+5');\n    expect(s.get('A1')).toBe(5);\n    s.set('B1', 100);\n    expect(s.get('A1')).toBe(105);\n  });\n\n  it('recomputes a diamond dependency exactly once and correctly', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 2);\n    s.set('B1', '=A1*2');\n    s.set('C1', '=A1*3');\n    s.set('D1', '=B1+C1');\n    expect(s.get('D1')).toBe(10);\n    s.set('A1', 5);\n    expect(s.get('D1')).toBe(25);\n  });\n\n  it('drops a dependency when a formula is replaced', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('B1', '=A1+1');\n    expect(s.g