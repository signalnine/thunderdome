+import { describe, it, expect } from 'vitest';
+import { Spreadsheet } from './index.js';
+
+describe('basic values', () => {
+  it('stores and reads numbers, strings, booleans', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 42);
+    s.set('A2', 'hello');
+    s.set('A3', true);
+    expect(s.get('A1')).toBe(42);
+    expect(s.get('A2')).toBe('hello');
+    expect(s.get('A3')).toBe(true);
+  });
+
+  it('returns null for empty cells', () => {
+    const s = new Spreadsheet();
+    expect(s.get('Z9')).toBeNull();
+  });
+
+  it('renders display strings', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 3.14);
+    s.set('A2', true);
+    s.set('A3', 'text');
+    expect(s.getDisplay('A1')).toBe('3.14');
+    expect(s.getDisplay('A2')).toBe('TRUE');
+    expect(s.getDisplay('A3')).toBe('text');
+    expect(s.getDisplay('Z9')).toBe('');
+  });
+
+  it('is case-insensitive for references', () => {
+    const s = new Spreadsheet();
+    s.set('a1', 5);
+    expect(s.get('A1')).toBe(5);
+    s.set('A2', '=a1+1');
+    expect(s.get('a2')).toBe(6);
+  });
+});
+
+describe('arithmetic formulas', () => {
+  it('adds cell references', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 10);
+    s.set('A2', 20);
+    s.set('A3', '=A1+A2');
+    expect(s.get('A3')).toBe(30);
+    expect(s.getDisplay('A3')).toBe('30');
+  });
+
+  it('respects operator precedence and parentheses', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 2);
+    s.set('A2', 3);
+    s.set('A3', 4);
+    s.set('B1', '=A1+A2*A3');
+    s.set('B2', '=(A1+A2)*A3');
+    expect(s.get('B1')).toBe(14);
+    expect(s.get('B2')).toBe(20);
+  });
+
+  it('handles subtraction, division and unary minus', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 10);
+    s.set('A2', 4);
+    s.set('B1', '=A1-A2');
+    s.set('B2', '=A1/A2');
+    s.set('B3', '=-A1+1');
+    expect(s.get('B1')).toBe(6);
+    expect(s.get('B2')).toBe(2.5);
+    expect(s.get('B3')).toBe(-9);
+  });
+
+  it('treats empty referenced cells as zero', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=B1+5');
+    expect(s.get('A1')).toBe(5);
+  });
+
+  it('reports division by zero', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=1/0');
+    expect(s.get('A1')).toBe('#DIV/0!');
+    expect(s.getDisplay('A1')).toBe('#DIV/0!');
+  });
+});
+
+describe('reactive updates', () => {
+  it('recomputes dependents when a value changes', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 5);
+    s.set('B1', '=A1+1');
+    expect(s.get('B1')).toBe(6);
+    s.set('A1', 10);
+    expect(s.get('B1')).toBe(11);
+  });
+
+  it('propagates through transitive chains', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('A2', '=A1+1');
+    s.set('A3', '=A2+1');
+    s.set('A4', '=A3+1');
+    expect(s.get('A4')).toBe(4);
+    s.set('A1', 10);
+    expect(s.get('A2')).toBe(11);
+    expect(s.get('A3')).toBe(12);
+    expect(s.get('A4')).toBe(13);
+  });
+
+  it('updates when an empty dependency becomes populated', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=B1+5');
+    expect(s.get('A1')).toBe(5);
+    s.set('B1', 100);
+    expect(s.get('A1')).toBe(105);
+  });
+
+  it('recomputes a diamond dependency exactly once and correctly', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 2);
+    s.set('B1', '=A1*2');
+    s.set('C1', '=A1*3');
+    s.set('D1', '=B1+C1');
+    expect(s.get('D1')).toBe(10);
+    s.set('A1', 5);
+    expect(s.get('D1')).toBe(25);
+  });
+
+  it('drops a dependency when a formula is replaced', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('B1', '=A1+1');
+    expect(s.get('B1')).toBe(2);
+    s.set('B1', 100); // no longer depends on A1
+    s.set('A1', 50);
+    expect(s.get('B1')).toBe(100);
+  });
+});
+
+describe('functions', () => {
+  it('SUM over a column range', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 10);
+    s.set('A2', 20);
+    s.set('A3', 30);
+    s.set('B1', '=SUM(A1:A3)');
+    expect(s.get('B1')).toBe(60);
+  });
+
+  it('SUM over a block range', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('B1', 2);
+    s.set('A2', 3);
+    s.set('B2', 4);
+    s.set('C1', '=SUM(A1:B2)');
+    expect(s.get('C1')).toBe(10);
+  });
+
+  it('AVERAGE, MIN, MAX, COUNT ignore non-numeric cells', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 10);
+    s.set('A2', 'text');
+    s.set('A3', 20);
+    s.set('A4', 30);
+    expect(s.get('B1')).toBeNull();
+    s.set('B1', '=AVERAGE(A1:A4)');
+    s.set('B2', '=MIN(A1:A4)');
+    s.set('B3', '=MAX(A1:A4)');
+    s.set('B4', '=COUNT(A1:A4)');
+    expect(s.get('B1')).toBe(20);
+    expect(s.get('B2')).toBe(10);
+    expect(s.get('B3')).toBe(30);
+    expect(s.get('B4')).toBe(3);
+  });
+
+  it('aggregates react to changes inside the range', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('A2', 2);
+    s.set('A3', '=SUM(A1:A2)');
+    expect(s.get('A3')).toBe(3);
+    s.set('A2', 10);
+    expect(s.get('A3')).toBe(11);
+  });
+
+  it('AVERAGE of an empty range is a division error', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=AVERAGE(B1:B3)');
+    expect(s.get('A1')).toBe('#DIV/0!');
+  });
+});
+
+describe('IF and comparisons', () => {
+  it('chooses branches based on a numeric comparison', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 50);
+    s.set('C1', '=IF(A1>30, "big", "small")');
+    expect(s.get('C1')).toBe('big');
+    s.set('A1', 10);
+    expect(s.get('C1')).toBe('small');
+  });
+
+  it('supports all comparison operators', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 5);
+    s.set('B1', '=IF(A1>=5, 1, 0)');
+    s.set('B2', '=IF(A1<=4, 1, 0)');
+    s.set('B3', '=IF(A1=5, 1, 0)');
+    s.set('B4', '=IF(A1<>5, 1, 0)');
+    s.set('B5', '=IF(A1<10, 1, 0)');
+    expect(s.get('B1')).toBe(1);
+    expect(s.get('B2')).toBe(0);
+    expect(s.get('B3')).toBe(1);
+    expect(s.get('B4')).toBe(0);
+    expect(s.get('B5')).toBe(1);
+  });
+
+  it('compares strings', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 'apple');
+    s.set('B1', '=IF(A1="apple", "yes", "no")');
+    expect(s.get('B1')).toBe('yes');
+  });
+
+  it('nests functions and IF', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 10);
+    s.set('A2', 20);
+    s.set('A3', 30);
+    s.set('B1', '=IF(SUM(A1:A3)>50, MAX(A1:A3), MIN(A1:A3))');
+    expect(s.get('B1')).toBe(30);
+  });
+});
+
+describe('circular references', () => {
+  it('throws on a direct self reference', () => {
+    const s = new Spreadsheet();
+    expect(() => s.set('A1', '=A1')).toThrow(/circular/i);
+  });
+
+  it('throws on a two-cell cycle', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=B1');
+    expect(() => s.set('B1', '=A1')).toThrow(/circular/i);
+  });
+
+  it('throws on an indirect cycle', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=B1');
+    s.set('B1', '=C1');
+    expect(() => s.set('C1', '=A1')).toThrow(/circular/i);
+  });
+
+  it('does not mutate state when a cycle is rejected', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 5);
+    s.set('B1', '=A1');
+    expect(() => s.set('A1', '=B1')).toThrow();
+    // A1 keeps its old value and the graph still works.
+    expect(s.get('A1')).toBe(5);
+    expect(s.get('B1')).toBe(5);
+    s.set('A1', 9);
+    expect(s.get('B1')).toBe(9);
+  });
+
+  it('allows reusing a reference that is not part of a cycle', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('B1', '=A1');
+    s.set('C1', '=A1+B1');
+    expect(s.get('C1')).toBe(2);
+  });
+});
+
+describe('getCells and references', () => {
+  it('returns only non-empty cells', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('B2', '=A1+1');
+    s.get('Z99'); // touching an empty cell should not register it
+    const cells = s.getCells();
+    expect(cells.size).toBe(2);
+    expect(cells.get('A1')).toBe(1);
+    expect(cells.get('B2')).toBe(2);
+  });
+
+  it('handles multi-letter columns', () => {
+    const s = new Spreadsheet();
+    s.set('AA1', 7);
+    s.set('AB1', '=AA1*2');
+    expect(s.get('AB1')).toBe(14);
+  });
+
+  it('does not register empty cells referenced by formulas in getCells', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=B1+1');
+    const cells = s.getCells();
+    expect(cells.has('B1')).toBe(false);
+    expect(cells.has('A1')).toBe(true);
+  });
+});
+
+describe('error handling', () => {
+  it('throws on malformed formulas', () => {
+    const s = new Spreadsheet();
+    expect(() => s.set('A1', '=A1+')).toThrow();
+    expect(() => s.set('A2', '=(1+2')).toThrow();
+  });
+
+  it('propagates errors through dependents', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=1/0');
+    s.set('A2', '=A1+1');
+    expect(s.get('A2')).toBe('#DIV/0!');
+  });
+
+  it('produces a value error for non-numeric arithmetic', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 'text');
+    s.set('A2', '=A1+1');
+    expect(s.get('A2')).toBe('#VALUE!');
+  });
+});
