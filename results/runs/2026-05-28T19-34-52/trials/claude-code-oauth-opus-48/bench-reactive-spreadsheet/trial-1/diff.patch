+/** Recursive-descent parser turning tokens into a formula AST. */
+
+import { Node, BinaryOp } from './ast.js';
+import { Token, tokenize } from './tokenizer.js';
+import { isCellRef, normalizeCellRef } from './references.js';
+
+const COMPARISON_OPS = new Set(['>', '<', '>=', '<=', '=', '<>']);
+
+/**
+ * Parse a formula string. The leading "=" (if present) should already be
+ * stripped by the caller; this accepts the bare expression.
+ */
+export function parseFormula(expression: string): Node {
+  const tokens = tokenize(expression);
+  const parser = new Parser(tokens);
+  const node = parser.parseExpression();
+  parser.expectEnd();
+  return node;
+}
+
+class Parser {
+  private pos = 0;
+
+  constructor(private readonly tokens: Token[]) {}
+
+  parseExpression(): Node {
+    return this.parseComparison();
+  }
+
+  expectEnd(): void {
+    if (this.pos < this.tokens.length) {
+      throw new Error(`Unexpected token "${this.tokens[this.pos].value}" in formula`);
+    }
+  }
+
+  // comparison := additive ( compOp additive )?
+  private parseComparison(): Node {
+    let left = this.parseAdditive();
+    const tok = this.peek();
+    if (tok && tok.type === 'operator' && COMPARISON_OPS.has(tok.value)) {
+      this.advance();
+      const right = this.parseAdditive();
+      left = { type: 'binary', op: tok.value as BinaryOp, left, right };
+    }
+    return left;
+  }
+
+  // additive := multiplicative ( ("+"|"-") multiplicative )*
+  private parseAdditive(): Node {
+    let left = this.parseMultiplicative();
+    let tok = this.peek();
+    while (tok && tok.type === 'operator' && (tok.value === '+' || tok.value === '-')) {
+      this.advance();
+      const right = this.parseMultiplicative();
+      left = { type: 'binary', op: tok.value, left, right };
+      tok = this.peek();
+    }
+    return left;
+  }
+
+  // multiplicative := unary ( ("*"|"/") unary )*
+  private parseMultiplicative(): Node {
+    let left = this.parseUnary();
+    let tok = this.peek();
+    while (tok && tok.type === 'operator' && (tok.value === '*' || tok.value === '/')) {
+      this.advance();
+      const right = this.parseUnary();
+      left = { type: 'binary', op: tok.value, left, right };
+      tok = this.peek();
+    }
+    return left;
+  }
+
+  // unary := ("+"|"-") unary | primary
+  private parseUnary(): Node {
+    const tok = this.peek();
+    if (tok && tok.type === 'operator' && (tok.value === '+' || tok.value === '-')) {
+      this.advance();
+      return { type: 'unary', op: tok.value, operand: this.parseUnary() };
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): Node {
+    const tok = this.peek();
+    if (!tok) {
+      throw new Error('Unexpected end of formula');
+    }
+
+    if (tok.type === 'number') {
+      this.advance();
+      const value = Number(tok.value);
+      if (Number.isNaN(value)) {
+        throw new Error(`Invalid number literal "${tok.value}"`);
+      }
+      return { type: 'number', value };
+    }
+
+    if (tok.type === 'string') {
+      this.advance();
+      return { type: 'string', value: tok.value };
+    }
+
+    if (tok.type === 'lparen') {
+      this.advance();
+      const expr = this.parseExpression();
+      this.expect('rparen');
+      return expr;
+    }
+
+    if (tok.type === 'identifier') {
+      return this.parseIdentifier();
+    }
+
+    throw new Error(`Unexpected token "${tok.value}" in formula`);
+  }
+
+  private parseIdentifier(): Node {
+    const tok = this.advance();
+    const upper = tok.value.toUpperCase();
+
+    // Boolean literals
+    if (upper === 'TRUE') return { type: 'boolean', value: true };
+    if (upper === 'FALSE') return { type: 'boolean', value: false };
+
+    // Function call
+    if (this.peek()?.type === 'lparen') {
+      this.advance(); // consume "("
+      const args: Node[] = [];
+      if (this.peek()?.type !== 'rparen') {
+        args.push(this.parseArgument());
+        while (this.peek()?.type === 'comma') {
+          this.advance();
+          args.push(this.parseArgument());
+        }
+      }
+      this.expect('rparen');
+      return { type: 'call', name: upper, args };
+    }
+
+    // Cell reference, possibly the start of a range
+    if (!isCellRef(tok.value)) {
+      throw new Error(`Unknown identifier "${tok.value}" in formula`);
+    }
+    const startCell = normalizeCellRef(tok.value);
+
+    if (this.peek()?.type === 'colon') {
+      this.advance(); // consume ":"
+      const endTok = this.peek();
+      if (!endTok || endTok.type !== 'identifier' || !isCellRef(endTok.value)) {
+        throw new Error('Expected a cell reference after ":" in range');
+      }
+      this.advance();
+      return { type: 'range', start: startCell, end: normalizeCellRef(endTok.value) };
+    }
+
+    return { type: 'ref', cell: startCell };
+  }
+
+  /**
+   * Parse a single function argument. Arguments may be a bare range
+   * (e.g. SUM(A1:A5)) or any expression.
+   */
+  private parseArgument(): Node {
+    return this.parseExpression();
+  }
+
+  private peek(): Token | undefined {
+    return this.tokens[this.pos];
+  }
+
+  private advance(): Token {
+    return this.tokens[this.pos++];
+  }
+
+  private expect(type: Token['type']): Token {
+    const tok = this.peek();
+    if (!tok || tok.type !== type) {
+      throw new Error(`Expected ${type} but found "${tok ? tok.value : 'end of formula'}"`);
+    }
+    return this.advance();
+  }
+}
