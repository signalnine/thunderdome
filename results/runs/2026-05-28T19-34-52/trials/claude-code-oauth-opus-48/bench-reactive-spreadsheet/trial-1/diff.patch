+/**
+ * Utilities for parsing and manipulating cell references (e.g. "A1", "AA10")
+ * and ranges (e.g. "A1:B3").
+ */
+
+/** A parsed cell coordinate. `col` and `row` are zero-based. */
+export interface Coord {
+  col: number;
+  row: number;
+}
+
+const CELL_RE = /^([A-Z]+)([1-9][0-9]*)$/;
+
+/**
+ * Convert a column label ("A", "Z", "AA") into a zero-based column index.
+ * Uses bijective base-26: A=0, Z=25, AA=26, AB=27, ...
+ */
+export function columnLabelToIndex(label: string): number {
+  let index = 0;
+  for (let i = 0; i < label.length; i++) {
+    index = index * 26 + (label.charCodeAt(i) - 64); // 'A' is 65 -> 1
+  }
+  return index - 1;
+}
+
+/** Convert a zero-based column index back into its label ("A", "AA", ...). */
+export function columnIndexToLabel(index: number): string {
+  let label = '';
+  let n = index + 1;
+  while (n > 0) {
+    const rem = (n - 1) % 26;
+    label = String.fromCharCode(65 + rem) + label;
+    n = Math.floor((n - 1) / 26);
+  }
+  return label;
+}
+
+/**
+ * Parse a cell reference such as "A1" into a coordinate. The reference is
+ * case-insensitive. Throws if the reference is malformed.
+ */
+export function parseCellRef(ref: string): Coord {
+  const match = CELL_RE.exec(ref.trim().toUpperCase());
+  if (!match) {
+    throw new Error(`Invalid cell reference: "${ref}"`);
+  }
+  return {
+    col: columnLabelToIndex(match[1]),
+    row: parseInt(match[2], 10) - 1,
+  };
+}
+
+/** Return whether a string is a syntactically valid cell reference. */
+export function isCellRef(ref: string): boolean {
+  return CELL_RE.test(ref.trim().toUpperCase());
+}
+
+/** Build the canonical name ("A1") for a coordinate. */
+export function coordToName(coord: Coord): string {
+  return columnIndexToLabel(coord.col) + (coord.row + 1);
+}
+
+/** Normalize a reference to its canonical uppercase form ("a1" -> "A1"). */
+export function normalizeCellRef(ref: string): string {
+  return coordToName(parseCellRef(ref));
+}
+
+/**
+ * Expand a range delimited by two corner cells into the list of cell names it
+ * covers. Handles ranges given in any corner order (e.g. "B3:A1").
+ */
+export function expandRange(startRef: string, endRef: string): string[] {
+  const start = parseCellRef(startRef);
+  const end = parseCellRef(endRef);
+
+  const minCol = Math.min(start.col, end.col);
+  const maxCol = Math.max(start.col, end.col);
+  const minRow = Math.min(start.row, end.row);
+  const maxRow = Math.max(start.row, end.row);
+
+  const cells: string[] = [];
+  for (let row = minRow; row <= maxRow; row++) {
+    for (let col = minCol; col <= maxCol; col++) {
+      cells.push(coordToName({ col, row }));
+    }
+  }
+  return cells;
+}
