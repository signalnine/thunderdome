+/** Abstract syntax tree node definitions for parsed formulas. */
+
+export type BinaryOp = '+' | '-' | '*' | '/' | '>' | '<' | '>=' | '<=' | '=' | '<>';
+export type UnaryOp = '-' | '+';
+
+export interface NumberNode {
+  type: 'number';
+  value: number;
+}
+
+export interface StringNode {
+  type: 'string';
+  value: string;
+}
+
+export interface BooleanNode {
+  type: 'boolean';
+  value: boolean;
+}
+
+export interface RefNode {
+  type: 'ref';
+  /** Canonical cell name, e.g. "A1". */
+  cell: string;
+}
+
+export interface RangeNode {
+  type: 'range';
+  /** Canonical cell names of the range corners. */
+  start: string;
+  end: string;
+}
+
+export interface UnaryNode {
+  type: 'unary';
+  op: UnaryOp;
+  operand: Node;
+}
+
+export interface BinaryNode {
+  type: 'binary';
+  op: BinaryOp;
+  left: Node;
+  right: Node;
+}
+
+export interface CallNode {
+  type: 'call';
+  name: string;
+  args: Node[];
+}
+
+export type Node =
+  | NumberNode
+  | StringNode
+  | BooleanNode
+  | RefNode
+  | RangeNode
+  | UnaryNode
+  | BinaryNode
+  | CallNode;
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..8925d43
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,235 @@
+/** Evaluates a formula AST against a cell-value lookup. */
+
+import { Node, BinaryOp } from './ast.js';
+import { expandRange } from './references.js';
+import {
+  CellValue,
+  CellError,
+  EvalResult,
+  isError,
+  ERR_DIV0,
+  ERR_VALUE,
+  ERR_NAME,
+} from './values.js';
+
+/** Supplies the current computed value of a cell to the evaluator. */
+export type CellResolver = (cell: string) => EvalResult;
+
+/**
+ * Evaluate a parsed formula. Cell lookups go through `resolve`; ranges expand
+ * to lists of cells which are resolved individually.
+ */
+export function evaluate(node: Node, resolve: CellResolver): EvalResult {
+  switch (node.type) {
+    case 'number':
+      return node.value;
+    case 'string':
+      return node.value;
+    case 'boolean':
+      return node.value;
+    case 'ref':
+      return resolve(node.cell);
+    case 'range':
+      // A range used outside an aggregate function is meaningless as a scalar.
+      return ERR_VALUE;
+    case 'unary':
+      return evalUnary(node.op, evaluate(node.operand, resolve));
+    case 'binary':
+      return evalBinary(node.op, node.left, node.right, resolve);
+    case 'call':
+      return evalCall(node.name, node.args, resolve);
+  }
+}
+
+function evalUnary(op: '+' | '-', operand: EvalResult): EvalResult {
+  if (isError(operand)) return operand;
+  const num = toNumber(operand);
+  if (isError(num)) return num;
+  return op === '-' ? -num : num;
+}
+
+function evalBinary(
+  op: BinaryOp,
+  leftNode: Node,
+  rightNode: Node,
+  resolve: CellResolver,
+): EvalResult {
+  const left = evaluate(leftNode, resolve);
+  if (isError(left)) return left;
+  const right = evaluate(rightNode, resolve);
+  if (isError(right)) return right;
+
+  switch (op) {
+    case '+':
+    case '-':
+    case '*':
+    case '/':
+      return evalArithmetic(op, left, right);
+    default:
+      return evalComparison(op, left, right);
+  }
+}
+
+function evalArithmetic(
+  op: '+' | '-' | '*' | '/',
+  left: CellValue,
+  right: CellValue,
+): EvalResult {
+  const a = toNumber(left);
+  if (isError(a)) return a;
+  const b = toNumber(right);
+  if (isError(b)) return b;
+
+  switch (op) {
+    case '+':
+      return a + b;
+    case '-':
+      return a - b;
+    case '*':
+      return a * b;
+    case '/':
+      return b === 0 ? ERR_DIV0 : a / b;
+  }
+}
+
+function evalComparison(op: BinaryOp, left: CellValue, right: CellValue): EvalResult {
+  const cmp = compare(left, right);
+  if (isError(cmp)) return cmp;
+
+  switch (op) {
+    case '>':
+      return cmp > 0;
+    case '<':
+      return cmp < 0;
+    case '>=':
+      return cmp >= 0;
+    case '<=':
+      return cmp <= 0;
+    case '=':
+      return cmp === 0;
+    case '<>':
+      return cmp !== 0;
+    default:
+      return ERR_VALUE;
+  }
+}
+
+/**
+ * Three-way comparison returning a negative/zero/positive number. Numbers and
+ * booleans compare numerically; otherwise both sides compare as strings.
+ */
+function compare(left: CellValue, right: CellValue): number | CellError {
+  const ln = coerceComparable(left);
+  const rn = coerceComparable(right);
+
+  if (typeof ln === 'number' && typeof rn === 'number') {
+    return ln - rn;
+  }
+  const ls = String(ln);
+  const rs = String(rn);
+  if (ls < rs) return -1;
+  if (ls > rs) return 1;
+  return 0;
+}
+
+function coerceComparable(value: CellValue): number | string {
+  if (value === null) return 0;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+  return value;
+}
+
+function evalCall(name: string, args: Node[], resolve: CellResolver): EvalResult {
+  switch (name) {
+    case 'SUM':
+    case 'AVERAGE':
+    case 'MIN':
+    case 'MAX':
+    case 'COUNT':
+      return evalAggregate(name, args, resolve);
+    case 'IF':
+      return evalIf(args, resolve);
+    default:
+      return ERR_NAME;
+  }
+}
+
+function evalAggregate(name: string, args: Node[], resolve: CellResolver): EvalResult {
+  const numbers: number[] = [];
+  for (const arg of args) {
+    const collected = collectNumbers(arg, resolve);
+    if (collected instanceof CellError) return collected;
+    numbers.push(...collected);
+  }
+
+  switch (name) {
+    case 'COUNT':
+      return numbers.length;
+    case 'SUM':
+      return numbers.reduce((acc, n) => acc + n, 0);
+    case 'AVERAGE':
+      return numbers.length === 0 ? ERR_DIV0 : numbers.reduce((a, n) => a + n, 0) / numbers.length;
+    case 'MIN':
+      return numbers.length === 0 ? 0 : Math.min(...numbers);
+    case 'MAX':
+      return numbers.length === 0 ? 0 : Math.max(...numbers);
+    default:
+      return ERR_VALUE;
+  }
+}
+
+/**
+ * Collect numeric values contributed by a function argument. Ranges contribute
+ * every numeric cell they cover; non-numeric cells are ignored (matching
+ * conventional spreadsheet aggregate behavior). Scalar expression arguments
+ * contribute their numeric value, propagating any evaluation error.
+ */
+function collectNumbers(arg: Node, resolve: CellResolver): number[] | CellError {
+  if (arg.type === 'range') {
+    const cells = expandRange(arg.start, arg.end);
+    const out: number[] = [];
+    for (const cell of cells) {
+      const value = resolve(cell);
+      if (isError(value)) return value;
+      if (typeof value === 'number') out.push(value);
+    }
+    return out;
+  }
+
+  const value = evaluate(arg, resolve);
+  if (isError(value)) return value;
+  if (typeof value === 'number') return [value];
+  if (typeof value === 'boolean') return [value ? 1 : 0];
+  // Strings and empty cells contribute nothing.
+  return [];
+}
+
+function evalIf(args: Node[], resolve: CellResolver): EvalResult {
+  if (args.length < 2 || args.length > 3) return ERR_VALUE;
+  const condition = evaluate(args[0], resolve);
+  if (isError(condition)) return condition;
+
+  const truthy = toBoolean(condition);
+  if (truthy) {
+    return evaluate(args[1], resolve);
+  }
+  return args.length === 3 ? evaluate(args[2], resolve) : false;
+}
+
+function toBoolean(value: CellValue): boolean {
+  if (typeof value === 'boolean') return value;
+  if (typeof value === 'number') return value !== 0;
+  if (value === null) return false;
+  // Non-empty strings are truthy, matching JS semantics for IF conditions.
+  return value.length > 0;
+}
+
+function toNumber(value: CellValue): number | CellError {
+  if (value === null) return 0;
+  if (typeof value === 'number') return value;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+  // Numeric strings coerce; anything else is a value error.
+  const trimmed = value.trim();
+  if (trimmed === '') return 0;
+  const n = Number(trimmed);
+  return Number.isNaN(n) ? ERR_VALUE : n;
+}
