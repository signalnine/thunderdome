@@ -0,0 +1,40 @@
+/** Cell value types and the error representation used during evaluation. */
+
+/** A concrete value a cell can hold or compute to. */
+export type CellValue = number | string | boolean | null;
+
+/**
+ * Represents a computation error (e.g. division by zero). Errors propagate
+ * through formulas the way they do in conventional spreadsheets and surface as
+ * their code string (e.g. "#DIV/0!") when read.
+ */
+export class CellError {
+  constructor(public readonly code: string) {}
+}
+
+export const ERR_DIV0 = new CellError('#DIV/0!');
+export const ERR_VALUE = new CellError('#VALUE!');
+export const ERR_NAME = new CellError('#NAME?');
+export const ERR_ERROR = new CellError('#ERROR!');
+
+export type EvalResult = CellValue | CellError;
+
+export function isError(value: EvalResult): value is CellError {
+  return value instanceof CellError;
+}
+
+/** Format a computed value for display. Empty cells render as "". */
+export function formatValue(value: EvalResult): string {
+  if (value instanceof CellError) return value.code;
+  if (value === null) return '';
+  if (typeof value === 'boolean') return value ? 'TRUE' : 'FALSE';
+  if (typeof value === 'number') return formatNumber(value);
+  return value;
+}
+
+function formatNumber(n: number): string {
+  if (!Number.isFinite(n)) {
+    return n > 0 ? '#DIV/0!' : '#NUM!';
+  }
+  return String(n);
+}
