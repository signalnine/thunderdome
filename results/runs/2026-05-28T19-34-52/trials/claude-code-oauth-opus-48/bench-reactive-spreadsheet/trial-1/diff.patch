@@ -0,0 +1,257 @@
+/** The reactive spreadsheet engine. */
+
+import { Node } from './ast.js';
+import { parseFormula } from './parser.js';
+import { normalizeCellRef, expandRange } from './references.js';
+import { evaluate } from './evaluator.js';
+import { CellValue, EvalResult, CellError, formatValue, isError } from './values.js';
+
+/** Internal record for a single cell in the grid. */
+interface CellNode {
+  /** Canonical cell name, e.g. "A1". */
+  name: string;
+  /**
+   * The raw assigned content (formula string, number, string, or boolean).
+   * `undefined` means the cell is empty and exists only as a dependency target.
+   */
+  raw: string | number | boolean | undefined;
+  /** Parsed formula AST, or null for literal / empty cells. */
+  ast: Node | null;
+  /** Last computed value. */
+  value: EvalResult;
+  /** Cells this cell directly references. */
+  dependencies: Set<string>;
+  /** Cells that directly reference this cell. */
+  dependents: Set<string>;
+}
+
+export type { CellValue } from './values.js';
+
+export class Spreadsheet {
+  private readonly cells = new Map<string, CellNode>();
+
+  /**
+   * Set a cell's content. A string beginning with "=" is treated as a formula;
+   * any other value is stored literally. Throws if the assignment would create
+   * a circular dependency, or if the formula is syntactically invalid.
+   */
+  set(cell: string, value: string | number | boolean): void {
+    const name = normalizeCellRef(cell);
+
+    let ast: Node | null = null;
+    let dependencies: Set<string>;
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      ast = parseFormula(value.slice(1));
+      dependencies = collectDependencies(ast);
+    } else {
+      dependencies = new Set();
+    }
+
+    // Reject assignments that would introduce a cycle before mutating anything.
+    if (this.wouldCreateCycle(name, dependencies)) {
+      throw new Error(`Circular reference detected involving ${name}`);
+    }
+
+    const node = this.getOrCreateNode(name);
+    this.updateDependencyEdges(node, dependencies);
+    node.raw = value;
+    node.ast = ast;
+
+    this.recompute(name);
+  }
+
+  /** Get a cell's computed value. Empty cells return null. */
+  get(cell: string): CellValue {
+    const node = this.cells.get(normalizeCellRef(cell));
+    if (!node || node.raw === undefined) return null;
+    return toPublicValue(node.value);
+  }
+
+  /** Get the display string for a cell's computed value. */
+  getDisplay(cell: string): string {
+    const node = this.cells.get(normalizeCellRef(cell));
+    if (!node || node.raw === undefined) return '';
+    return formatValue(node.value);
+  }
+
+  /** Get all non-empty cells mapped from cell reference to computed value. */
+  getCells(): Map<string, CellValue> {
+    const result = new Map<string, CellValue>();
+    for (const [name, node] of this.cells) {
+      if (node.raw !== undefined) {
+        result.set(name, toPublicValue(node.value));
+      }
+    }
+    return result;
+  }
+
+  // --- internal helpers ---
+
+  private getOrCreateNode(name: string): CellNode {
+    let node = this.cells.get(name);
+    if (!node) {
+      node = {
+        name,
+        raw: undefined,
+        ast: null,
+        value: null,
+        dependencies: new Set(),
+        dependents: new Set(),
+      };
+      this.cells.set(name, node);
+    }
+    return node;
+  }
+
+  /** Replace a node's dependency edges with a new dependency set. */
+  private updateDependencyEdges(node: CellNode, newDeps: Set<string>): void {
+    // Remove stale back-edges.
+    for (const dep of node.dependencies) {
+      if (!newDeps.has(dep)) {
+        this.cells.get(dep)?.dependents.delete(node.name);
+      }
+    }
+    // Add new back-edges.
+    for (const dep of newDeps) {
+      if (!node.dependencies.has(dep)) {
+        this.getOrCreateNode(dep).dependents.add(node.name);
+      }
+    }
+    node.dependencies = newDeps;
+  }
+
+  /**
+   * Determine whether giving `name` the dependency set `newDeps` would create a
+   * cycle. Walks the dependency edges of the current graph, substituting
+   * `newDeps` for `name`'s own (not-yet-applied) dependencies.
+   */
+  private wouldCreateCycle(name: string, newDeps: Set<string>): boolean {
+    const visited = new Set<string>();
+    const stack = [...newDeps];
+    while (stack.length > 0) {
+      const current = stack.pop() as string;
+      if (current === name) return true;
+      if (visited.has(current)) continue;
+      visited.add(current);
+      const node = this.cells.get(current);
+      if (node) {
+        for (const dep of node.dependencies) stack.push(dep);
+      }
+    }
+    return false;
+  }
+
+  /**
+   * Recompute `start` and every cell that transitively depends on it, in
+   * dependency order so each cell sees up-to-date inputs.
+   */
+  private recompute(start: string): void {
+    const order = this.topologicalAffectedOrder(start);
+    for (const name of order) {
+      const node = this.cells.get(name);
+      if (!node) continue;
+      node.value = this.computeValue(node);
+    }
+  }
+
+  /** Compute a single node's value from its raw content / AST. */
+  private computeValue(node: CellNode): EvalResult {
+    if (node.raw === undefined) return null;
+    if (node.ast) {
+      return evaluate(node.ast, (cell) => this.cells.get(cell)?.value ?? null);
+    }
+    // Literal value.
+    return node.raw as CellValue;
+  }
+
+  /**
+   * Build the set of cells affected by a change to `start` (start plus all
+   * transitive dependents) and return them in topological order with respect to
+   * their dependency edges.
+   */
+  private topologicalAffectedOrder(start: string): string[] {
+    // Collect the affected set via the dependents edges.
+    const affected = new Set<string>();
+    const stack = [start];
+    while (stack.length > 0) {
+      const current = stack.pop() as string;
+      if (affected.has(current)) continue;
+      affected.add(current);
+      const node = this.cells.get(current);
+      if (node) {
+        for (const dep of node.dependents) stack.push(dep);
+      }
+    }
+
+    // Kahn's algorithm restricted to the affected subgraph.
+    const inDegree = new Map<string, number>();
+    for (const name of affected) {
+      const node = this.cells.get(name);
+      let degree = 0;
+      if (node) {
+        for (const dep of node.dependencies) {
+          if (affected.has(dep)) degree++;
+        }
+      }
+      inDegree.set(name, degree);
+    }
+
+    const queue: string[] = [];
+    for (const [name, degree] of inDegree) {
+      if (degree === 0) queue.push(name);
+    }
+
+    const order: string[] = [];
+    while (queue.length > 0) {
+      const name = queue.shift() as string;
+      order.push(name);
+      const node = this.cells.get(name);
+      if (!node) continue;
+      for (const dependent of node.dependents) {
+        if (!affected.has(dependent)) continue;
+        const degree = (inDegree.get(dependent) as number) - 1;
+        inDegree.set(dependent, degree);
+        if (degree === 0) queue.push(dependent);
+      }
+    }
+
+    return order;
+  }
+}
+
+/** Collect every cell a formula AST references, expanding ranges. */
+function collectDependencies(node: Node): Set<string> {
+  const deps = new Set<string>();
+  walk(node, deps);
+  return deps;
+}
+
+function walk(node: Node, deps: Set<string>): void {
+  switch (node.type) {
+    case 'ref':
+      deps.add(node.cell);
+      break;
+    case 'range':
+      for (const cell of expandRange(node.start, node.end)) deps.add(cell);
+      break;
+    case 'unary':
+      walk(node.operand, deps);
+      break;
+    case 'binary':
+      walk(node.left, deps);
+      walk(node.right, deps);
+      break;
+    case 'call':
+      for (const arg of node.args) walk(arg, deps);
+      break;
+    default:
+      break;
+  }
+}
+
+/** Convert an internal evaluation result to its public value form. */
+function toPublicValue(value: EvalResult): CellValue {
+  if (isError(value)) return (value as CellError).code;
+  return value;
+}
