--- /dev/null
+++ b/src/parser.test.ts
@@ -0,0 +1,94 @@
+import { describe, it, expect } from 'vitest';
+import { parseFormula, collectReferences } from './parser.js';
+
+function refs(formula: string): string[] {
+  const out = new Set<string>();
+  collectReferences(parseFormula(formula), out);
+  return [...out].sort();
+}
+
+describe('parseFormula', () => {
+  it('parses arithmetic with precedence', () => {
+    expect(parseFormula('1+2*3')).toEqual({
+      type: 'binary',
+      op: '+',
+      left: { type: 'number', value: 1 },
+      right: {
+        type: 'binary',
+        op: '*',
+        left: { type: 'number', value: 2 },
+        right: { type: 'number', value: 3 },
+      },
+    });
+  });
+
+  it('honours parentheses', () => {
+    const ast = parseFormula('(1+2)*3');
+    expect(ast).toMatchObject({ type: 'binary', op: '*' });
+  });
+
+  it('parses unary minus', () => {
+    expect(parseFormula('-A1')).toMatchObject({
+      type: 'unary',
+      op: '-',
+      operand: { type: 'cell', ref: 'A1' },
+    });
+  });
+
+  it('parses cell references case-insensitively', () => {
+    expect(parseFormula('a1')).toEqual({ type: 'cell', ref: 'A1' });
+  });
+
+  it('parses ranges', () => {
+    expect(parseFormula('A1:B2')).toEqual({
+      type: 'range',
+      start: 'A1',
+      end: 'B2',
+    });
+  });
+
+  it('parses function calls with multiple args', () => {
+    expect(parseFormula('IF(A1>1, 2, 3)')).toMatchObject({
+      type: 'function',
+      name: 'IF',
+      args: [{ type: 'binary', op: '>' }, { type: 'number' }, { type: 'number' }],
+    });
+  });
+
+  it('parses string literals', () => {
+    expect(parseFormula('"hello"')).toEqual({ type: 'string', value: 'hello' });
+  });
+
+  it('parses comparison operators', () => {
+    for (const op of ['>', '<', '>=', '<=', '=', '<>']) {
+      expect(parseFormula(`A1${op}B1`)).toMatchObject({ type: 'binary', op });
+    }
+  });
+
+  it('throws on malformed input', () => {
+    expect(() => parseFormula('1+')).toThrow();
+    expect(() => parseFormula('(1+2')).toThrow();
+    expect(() => parseFormula('SUM 1')).toThrow();
+    expect(() => parseFormula('1 2')).toThrow();
+  });
+});
+
+describe('collectReferences', () => {
+  it('collects plain cell references', () => {
