--- /dev/null
+++ b/src/reference.ts
@@ -0,0 +1,87 @@
+/**
+ * Utilities for parsing and manipulating cell references and ranges.
+ *
+ * A cell reference is one or more column letters (A-Z, AA, AB, ...) followed by
+ * a 1-based row number, e.g. `A1`, `B2`, `AA100`.
+ */
+
+/** A0-based column/row coordinate pair. */
+export interface Coord {
+  /** 0-based column index (A = 0, B = 1, ..., Z = 25, AA = 26, ...). */
+  col: number;
+  /** 0-based row index (row 1 = 0). */
+  row: number;
+}
+
+const CELL_RE = /^([A-Z]+)([1-9][0-9]*)$/;
+
+/** Convert column letters (e.g. "A", "AA") to a 0-based column index. */
+export function columnToIndex(letters: string): number {
+  let index = 0;
+  for (let i = 0; i < letters.length; i++) {
+    index = index * 26 + (letters.charCodeAt(i) - 64); // 'A' is 65
+  }
+  return index - 1;
+}
+
+/** Convert a 0-based column index back to column letters. */
+export function indexToColumn(index: number): string {
+  let result = '';
+  let n = index + 1;
+  while (n > 0) {
+    const rem = (n - 1) % 26;
+    result = String.fromCharCode(65 + rem) + result;
+    n = Math.floor((n - 1) / 26);
+  }
+  return result;
+}
+
+/**
+ * Parse a cell reference like "A1" into a coordinate. Returns null when the
+ * string is not a syntactically valid reference.
+ */
+export function parseCell(ref: string): Coord | null {
+  const match = CELL_RE.exec(ref);
+  if (!match) return null;
+  return {
+    col: columnToIndex(match[1]),
+    row: parseInt(match[2], 10) - 1,
+  };
+}
+
+/** Normalize a reference to canonical upper-case form, or null if invalid. */
+export function normalizeCell(ref: string): string | null {
+  const coord = parseCell(ref.toUpperCase());
+  if (!coord) return null;
+  return coordToRef(coord);
+}
+
+/** Convert a coordinate back to a canonical cell reference. */
+export function coordToRef(coord: Coord): string {
+  return indexToColumn(coord.col) + (coord.row + 1);
+}
+
+/**
+ * Expand a range defined by two corner references into the list of all cell
+ * references it covers. Handles column, row and block ranges, regardless of
+ * which corner is given first.
+ */
+export function expandRange(startRef: string, endRef: string): string[] {
+  const start = parseCell(startRef);
+  const end = parseCell(endRef);
+  if (!start || !end) {
+    throw new Error(`Invalid range: ${startRef}:${endRef}`);
+  }
+  const minCol = Math.min(start.col, end.col);
+  const maxCol = Math.max(start.col, end.col);
+  const minRow = Math.min(start.row, end.row);
+  const maxRow = Math.max(start.row, end.row);
+
+  const cells: string[] = [];
+  for (let row = minRow; row <= maxRow; row++) {
+    for (let col = minCol; col <= maxCol; col++) {
+      cells.push(coordToRef({ col, row }));
+    }
+  }
+  return cells;
+}
