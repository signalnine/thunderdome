 () => {\n    for (const op of ['>', '<', '>=', '<=', '=', '<>']) {\n      expect(parseFormula(`A1${op}B1`)).toMatchObject({ type: 'binary', op });\n    }\n  });\n\n  it('throws on malformed input', () => {\n    expect(() => parseFormula('1+')).toThrow();\n    expect(() => parseFormula('(1+2')).toThrow();\n    expect(() => parseFormula('SUM 1')).toThrow();\n    expect(() => parseFormula('1 2')).toThrow();\n  });\n});\n\ndescribe('collectReferences', () => {\n  it('collects plain cell references', () => {\n    expect(refs('A1+B2')).toEqual(['A1', 'B2']);\n  });\n\n  it('expands ranges into individual cells', () => {\n    expect(refs('SUM(A1:A3)')).toEqual(['A1', 'A2', 'A3']);\n  });\n\n  it('collects nested references', () => {\n    expect(refs('IF(A1>0, B1, C1) + SUM(D1:D2)')).toEqual([\n      'A1',\n      'B1',\n      'C1',\n      'D1',\n      'D2',\n    ]);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1172,"cache_read_input_tokens":47798,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1172},"output_tokens":59,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"84d49768-6c1f-4911-9518-05f19a8c09d8","uuid":"e36113ef-3a18-440f-9a30-ef910e926f22","request_id":"req_011CbVdZtfDJycXZ47u1GBpx"}
