+/** Computed cell value types and error handling. */
+
+/** Error raised during formula evaluation, carrying a spreadsheet error code. */
+export class EvalError extends Error {
+  constructor(public readonly code: string, message?: string) {
+    super(message ?? code);
+    this.name = 'EvalError';
+  }
+}
+
+/** A computed error result stored in a cell (e.g. after a division by zero). */
+export class CellError {
+  constructor(public readonly code: string) {}
+}
+
+/** The value a cell can compute to. `null` represents an empty cell. */
+export type CellValue = number | string | boolean | null | CellError;
+
+/** Common error codes, matching familiar spreadsheet conventions. */
+export const ErrorCode = {
+  DIV_ZERO: '#DIV/0!',
+  VALUE: '#VALUE!',
+  NAME: '#NAME?',
+  CIRCULAR: '#CIRC!',
+  ERROR: '#ERROR!',
+} as const;
+
+/** Render a computed value as its display string. */
+export function displayValue(value: CellValue): string {
+  if (value === null) return '';
+  if (value instanceof CellError) return value.code;
+  if (typeof value === 'boolean') return value ? 'TRUE' : 'FALSE';
+  return String(value);
+}
