+++ b/src/parser.ts
@@ -0,0 +1,221 @@
+/**
+ * Recursive-descent parser turning a token stream into an AST.
+ *
+ * Grammar (lowest to highest precedence):
+ *   expression  := comparison
+ *   comparison  := additive ( (">"|"<"|">="|"<="|"="|"<>") additive )?
+ *   additive    := multiplicative ( ("+"|"-") multiplicative )*
+ *   multiplicative := unary ( ("*"|"/") unary )*
+ *   unary       := ("-"|"+") unary | primary
+ *   primary     := NUMBER | STRING | BOOL | range | cell
+ *                | IDENT "(" args ")" | "(" expression ")"
+ *   range       := CELL ":" CELL
+ */
+
+import { Token, tokenize } from './tokenizer.js';
+import {
+  BinaryNode,
+  BinaryOperator,
+  Node,
+  UnaryOperator,
+} from './ast.js';
+import { expandRange } from './reference.js';
+
+const COMPARISON_OPS = new Set(['>', '<', '>=', '<=', '=', '<>']);
+
+class Parser {
+  private pos = 0;
+
+  constructor(private readonly tokens: Token[]) {}
+
+  parse(): Node {
+    const node = this.parseExpression();
+    if (this.pos < this.tokens.length) {
+      const tok = this.tokens[this.pos];
+      throw new Error(`Unexpected token '${tok.value}' at position ${tok.pos}`);
+    }
+    return node;
+  }
+
+  private peek(): Token | undefined {
+    return this.tokens[this.pos];
+  }
+
+  private next(): Token {
+    const tok = this.tokens[this.pos];
+    if (!tok) throw new Error('Unexpected end of formula');
+    this.pos++;
+    return tok;
+  }
+
+  private parseExpression(): Node {
+    return this.parseComparison();
+  }
+
+  private parseComparison(): Node {
+    let left = this.parseAdditive();
+    const tok = this.peek();
+    if (tok && tok.type === 'OP' && COMPARISON_OPS.has(tok.value)) {
+      this.next();
+      const right = this.parseAdditive();
+      left = {
+        type: 'binary',
+        op: tok.value as BinaryOperator,
+        left,
+        right,
+      } as BinaryNode;
+    }
+    return left;
+  }
+
+  private parseAdditive(): Node {
+    let left = this.parseMultiplicative();
+    for (;;) {
+      const tok = this.peek();
+      if (tok && tok.type === 'OP' && (tok.value === '+' || tok.value === '-')) {
+        this.next();
+        const right = this.parseMultiplicative();
+        left = { type: 'binary', op: tok.value as BinaryOperator, left, right };
+      } else {
+        break;
+      }
+    }
+    return left;
+  }
+
+  private parseMultiplicative(): Node {
+    let left = this.parseUnary();
+    for (;;) {
+      const tok = this.peek();
+      if (tok && tok.type === 'OP' && (tok.value === '*' || tok.value === '/')) {
+        this.next();
+        const right = this.parseUnary();
+        left = { type: 'binary', op: tok.value as BinaryOperator, left, right };
+      } else {
+        break;
+      }
+    }
+    return left;
+  }
+
+  private parseUnary(): Node {
+    const tok = this.peek();
+    if (tok && tok.type === 'OP' && (tok.value === '-' || tok.value === '+')) {
+      this.next();
+      return {
+        type: 'unary',
+        op: tok.value as UnaryOperator,
+        operand: this.parseUnary(),
+      };
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): Node {
+    const tok = this.peek();
+    if (!tok) throw new Error('Unexpected end of formula');
+
+    switch (tok.type) {
+      case 'NUMBER':
+        this.next();
+        return { type: 'number', value: parseFloat(tok.value) };
+
+      case 'STRING':
+        this.next();
+        return { type: 'string', value: tok.value };
+
+      case 'BOOL':
+        this.next();
+        return { type: 'bool', value: tok.value === 'TRUE' };
+
+      case 'CELL': {
+        this.next();
+        // Range?
+        const colon = this.peek();
+        if (colon && colon.type === 'COLON') {
+          this.next();
+          const endTok = this.next();
+          if (endTok.type !== 'CELL') {
+            throw new Error(`Expected cell reference after ':' at position ${endTok.pos}`);
+          }
+          return { type: 'range', start: tok.value, end: endTok.value };
+        }
+        return { type: 'cell', ref: tok.value };
+      }
+
+      case 'IDENT': {
+        this.next();
+        const lparen = this.peek();
+        if (!lparen || lparen.type !== 'LPAREN') {
+          throw new Error(`Expected '(' after function '${tok.value}' at position ${tok.pos}`);
+        }
+        this.next(); // consume '('
+        const args: Node[] = [];
+        if (this.peek()?.type !== 'RPAREN') {
+          args.push(this.parseExpression());
+          while (this.peek()?.type === 'COMMA') {
+            this.next();
+            args.push(this.parseExpression());
+          }
+        }
+        const close = this.next();
+        if (close.type !== 'RPAREN') {
+          throw new Error(`Expected ')' at position ${close.pos}`);
+        }
+        return { type: 'function', name: tok.value.toUpperCase(), args };
+      }
+
+      case 'LPAREN': {
+        this.next();
+        const expr = this.parseExpression();
+        const close = this.next();
+        if (close.type !== 'RPAREN') {
+          throw new Error(`Expected ')' at position ${close.pos}`);
+        }
+        return expr;
+      }
+
+      default:
+        throw new Error(`Unexpected token '${tok.value}' at position ${tok.pos}`);
+    }
+  }
+}
+
+/** Parse a formula body (the part after the leading '=') into an AST. */
+export function parseFormula(source: string): Node {
+  const tokens = tokenize(source);
+  if (tokens.length === 0) {
+    throw new Error('Empty formula');
+  }
+  return new Parser(tokens).parse();
+}
+
+/**
+ * Collect every cell reference an AST depends on, expanding ranges into their
+ * constituent cells. Returns canonical references.
+ */
+export function collectReferences(node: Node, out: Set<string>): void {
+  switch (node.type) {
+    case 'cell':
+      out.add(node.ref);
+      break;
+    case 'range': {
+      for (const ref of expandRange(node.start, node.end)) {
+        out.add(ref);
+      }
+      break;
+    }
+    case 'unary':
+      collectReferences(node.operand, out);
+      break;
+    case 'binary':
+      collectReferences(node.left, out);
+      collectReferences(node.right, out);
+      break;
+    case 'function':
+      for (const arg of node.args) collectReferences(arg, out);
+      break;
+    default:
+      break;
+  }
+}
