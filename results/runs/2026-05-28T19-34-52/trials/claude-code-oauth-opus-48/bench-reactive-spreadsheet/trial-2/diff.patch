+import { describe, it, expect } from 'vitest';
+import { Spreadsheet } from './spreadsheet.js';
+import { ErrorCode } from './value.js';
+
+describe('literal values', () => {
+  it('stores and retrieves numbers, strings and booleans', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 42);
+    s.set('A2', 'hello');
+    s.set('A3', true);
+    expect(s.get('A1')).toBe(42);
+    expect(s.get('A2')).toBe('hello');
+    expect(s.get('A3')).toBe(true);
+  });
+
+  it('returns null for empty cells', () => {
+    const s = new Spreadsheet();
+    expect(s.get('Z9')).toBeNull();
+    expect(s.getDisplay('Z9')).toBe('');
+  });
+
+  it('is case-insensitive in references', () => {
+    const s = new Spreadsheet();
+    s.set('a1', 5);
+    expect(s.get('A1')).toBe(5);
+  });
+});
+
+describe('formulas and arithmetic', () => {
+  it('computes the spec example', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 10);
+    s.set('A2', 20);
+    s.set('A3', '=A1+A2');
+    expect(s.get('A3')).toBe(30);
+    expect(s.getDisplay('A3')).toBe('30');
+  });
+
+  it('respects operator precedence and parentheses', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 2);
+    s.set('A2', 3);
+    s.set('B1', '=A1+A2*2');
+    s.set('B2', '=(A1+A2)*2');
+    expect(s.get('B1')).toBe(8);
+    expect(s.get('B2')).toBe(10);
+  });
+
+  it('handles subtraction, division and unary minus', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 10);
+    s.set('A2', 4);
+    s.set('B1', '=A1-A2');
+    s.set('B2', '=A1/A2');
+    s.set('B3', '=-A1');
+    expect(s.get('B1')).toBe(6);
+    expect(s.get('B2')).toBe(2.5);
+    expect(s.get('B3')).toBe(-10);
+  });
+
+  it('treats empty referenced cells as zero', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=B1+5');
+    expect(s.get('A1')).toBe(5);
+  });
+
+  it('reports division by zero', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=1/0');
+    expect(s.get('A1')).toBe(ErrorCode.DIV_ZERO);
+  });
+
+  it('reports a value error for non-numeric arithmetic', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 'text');
+    s.set('A2', '=A1+1');
+    expect(s.get('A2')).toBe(ErrorCode.VALUE);
+  });
+});
+
+describe('reactive updates', () => {
+  it('recomputes dependents when a source changes', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 5);
+    s.set('B1', '=A1+1');
+    expect(s.get('B1')).toBe(6);
+    s.set('A1', 10);
+    expect(s.get('B1')).toBe(11);
+  });
+
+  it('propagates through a chain transitively', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('A2', '=A1+1');
+    s.set('A3', '=A2+1');
+    s.set('A4', '=A3+1');
+    expect(s.get('A4')).toBe(4);
+    s.set('A1', 10);
+    expect(s.get('A2')).toBe(11);
+    expect(s.get('A3')).toBe(12);
+    expect(s.get('A4')).toBe(13);
+  });
+
+  it('updates a cell with multiple dependents', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 2);
+    s.set('B1', '=A1*10');
+    s.set('C1', '=A1*100');
+    s.set('A1', 3);
+    expect(s.get('B1')).toBe(30);
+    expect(s.get('C1')).toBe(300);
+  });
+
+  it('recomputes ranges when a member cell changes', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('A2', 2);
+    s.set('A3', 3);
+    s.set('B1', '=SUM(A1:A3)');
+    expect(s.get('B1')).toBe(6);
+    s.set('A2', 20);
+    expect(s.get('B1')).toBe(24);
+  });
+
+  it('updates dependents when a formula is replaced by a literal', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 5);
+    s.set('A2', '=A1*2');
+    s.set('B1', '=A2+1');
+    expect(s.get('B1')).toBe(11);
+    s.set('A2', 100);
+    expect(s.get('B1')).toBe(101);
+  });
+
+  it('drops stale dependencies when a formula changes', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('A2', 1);
+    s.set('B1', '=A1');
+    expect(s.get('B1')).toBe(1);
+    // Re-point B1 at A2; future changes to A1 must not affect B1.
+    s.set('B1', '=A2');
+    s.set('A1', 999);
+    expect(s.get('B1')).toBe(1);
+    s.set('A2', 7);
+    expect(s.get('B1')).toBe(7);
+  });
+});
+
+describe('built-in functions', () => {
+  const seed = () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('A2', 2);
+    s.set('A3', 3);
+    s.set('A4', 4);
+    return s;
+  };
+
+  it('SUM', () => {
+    expect(seed().get('A1') !== null).toBe(true);
+    const s = seed();
+    s.set('B1', '=SUM(A1:A4)');
+    expect(s.get('B1')).toBe(10);
+  });
+
+  it('AVERAGE', () => {
+    const s = seed();
+    s.set('B1', '=AVERAGE(A1:A4)');
+    expect(s.get('B1')).toBe(2.5);
+  });
+
+  it('MIN and MAX', () => {
+    const s = seed();
+    s.set('B1', '=MIN(A1:A4)');
+    s.set('B2', '=MAX(A1:A4)');
+    expect(s.get('B1')).toBe(1);
+    expect(s.get('B2')).toBe(4);
+  });
+
+  it('COUNT ignores empty and non-numeric cells', () => {
+    const s = seed();
+    s.set('A5', 'text');
+    s.set('A6', true);
+    s.set('B1', '=COUNT(A1:A6)');
+    expect(s.get('B1')).toBe(4);
+  });
+
+  it('SUM ignores text and booleans in a range', () => {
+    const s = seed();
+    s.set('A5', 'text');
+    s.set('A6', true);
+    s.set('B1', '=SUM(A1:A6)');
+    expect(s.get('B1')).toBe(10);
+  });
+
+  it('AVERAGE of an empty range errors', () => {
+    const s = new Spreadsheet();
+    s.set('B1', '=AVERAGE(A1:A4)');
+    expect(s.get('B1')).toBe(ErrorCode.DIV_ZERO);
+  });
+
+  it('supports a block range', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('B1', 2);
+    s.set('A2', 3);
+    s.set('B2', 4);
+    s.set('C1', '=SUM(A1:B2)');
+    expect(s.get('C1')).toBe(10);
+  });
+
+  it('nests functions and arithmetic', () => {
+    const s = seed();
+    s.set('B1', '=SUM(A1:A4) + MAX(A1:A4)');
+    expect(s.get('B1')).toBe(14);
+  });
+});
+
+describe('IF and comparisons', () => {
+  it('chooses branches by condition', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 50);
+    s.set('C1', '=IF(A1>30, "big", "small")');
+    expect(s.get('C1')).toBe('big');
+    s.set('A1', 10);
+    expect(s.get('C1')).toBe('small');
+  });
+
+  it('supports all comparison operators', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 5);
+    s.set('B1', '=IF(A1=5, 1, 0)');
+    s.set('B2', '=IF(A1<>5, 1, 0)');
+    s.set('B3', '=IF(A1>=5, 1, 0)');
+    s.set('B4', '=IF(A1<=4, 1, 0)');
+    expect(s.get('B1')).toBe(1);
+    expect(s.get('B2')).toBe(0);
+    expect(s.get('B3')).toBe(1);
+    expect(s.get('B4')).toBe(0);
+  });
+
+  it('compares strings', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 'apple');
+    s.set('B1', '=IF(A1="apple", "yes", "no")');
+    expect(s.get('B1')).toBe('yes');
+  });
+
+  it('evaluates only the chosen branch lazily for nested IFs', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 0);
+    // false branch divides by A1; condition picks the safe branch.
+    s.set('B1', '=IF(A1=0, 100, 1/A1)');
+    expect(s.get('B1')).toBe(100);
+  });
+});
+
+describe('circular reference detection', () => {
+  it('detects direct self-reference', () => {
+    const s = new Spreadsheet();
+    expect(() => s.set('A1', '=A1')).toThrow(/circular/i);
+  });
+
+  it('detects a two-cell cycle', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=B1');
+    expect(() => s.set('B1', '=A1')).toThrow(/circular/i);
+  });
+
+  it('detects an indirect cycle through intermediates', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=B1');
+    s.set('B1', '=C1');
+    expect(() => s.set('C1', '=A1')).toThrow(/circular/i);
+  });
+
+  it('detects a cycle through a range', () => {
+    const s = new Spreadsheet();
+    s.set('A2', '=SUM(B1:B2)');
+    expect(() => s.set('B1', '=A2')).toThrow(/circular/i);
+  });
+
+  it('leaves state unchanged after a rejected assignment', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=B1');
+    s.set('B1', 5);
+    expect(s.get('A1')).toBe(5);
+    expect(() => s.set('B1', '=A1')).toThrow();
+    // B1 keeps its previous value; A1 still resolves through it.
+    expect(s.get('B1')).toBe(5);
+    expect(s.get('A1')).toBe(5);
+    // The graph is still live afterwards.
+    s.set('B1', 9);
+    expect(s.get('A1')).toBe(9);
+  });
+
+  it('allows a diamond (non-circular shared dependency)', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 1);
+    s.set('B1', '=A1+1');
+    s.set('C1', '=A1+2');
+    s.set('D1', '=B1+C1');
+    expect(s.get('D1')).toBe(5);
+    s.set('A1', 10);
+    expect(s.get('D1')).toBe(23);
+  });
+});
+
+describe('error propagation', () => {
+  it('propagates errors to dependents', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=1/0');
+    s.set('B1', '=A1+1');
+    expect(s.get('B1')).toBe(ErrorCode.DIV_ZERO);
+  });
+
+  it('recovers when the upstream error is fixed', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=1/0');
+    s.set('B1', '=A1+1');
+    expect(s.get('B1')).toBe(ErrorCode.DIV_ZERO);
+    s.set('A1', 9);
+    expect(s.get('B1')).toBe(10);
+  });
+
+  it('reports unknown functions', () => {
+    const s = new Spreadsheet();
+    s.set('A1', '=BOGUS(1)');
+    expect(s.get('A1')).toBe(ErrorCode.NAME);
+  });
+});
+
+describe('display and enumeration', () => {
+  it('formats values for display', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 30);
+    s.set('A2', 'hi');
+    s.set('A3', true);
+    expect(s.getDisplay('A1')).toBe('30');
+    expect(s.getDisplay('A2')).toBe('hi');
+    expect(s.getDisplay('A3')).toBe('TRUE');
+  });
+
+  it('lists all non-empty cells', () => {
+    const s = new Spreadsheet();
+    s.set('A1', 10);
+    s.set('A2', 20);
+    s.set('A3', '=A1+A2');
+    const cells = s.getCells();
+    expect(cells.get('A1')).toBe(10);
+    expect(cells.get('A2')).toBe(20);
+    expect(cells.get('A3')).toBe(30);
+    expect(cells.size).toBe(3);
+  });
+});
+
+describe('invalid references', () => {
+  it('throws on malformed cell names', () => {
+    const s = new Spreadsheet();
+    expect(() => s.set('123', 1)).toThrow();
+    expect(() => s.get('not-a-cell')).toThrow();
+  });
+});
