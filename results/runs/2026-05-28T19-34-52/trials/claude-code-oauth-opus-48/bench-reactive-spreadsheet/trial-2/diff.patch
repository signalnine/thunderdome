new file mode 100644
index 0000000..e2b527d
--- /dev/null
+++ b/src/ast.ts
@@ -0,0 +1,72 @@
+/** Abstract syntax tree node definitions for parsed formulas. */
+
+export type Node =
+  | NumberNode
+  | StringNode
+  | BoolNode
+  | CellNode
+  | RangeNode
+  | UnaryNode
+  | BinaryNode
+  | FunctionNode;
+
+export interface NumberNode {
+  type: 'number';
+  value: number;
+}
+
+export interface StringNode {
+  type: 'string';
+  value: string;
+}
+
+export interface BoolNode {
+  type: 'bool';
+  value: boolean;
+}
+
+export interface CellNode {
+  type: 'cell';
+  /** Canonical (upper-case) reference, e.g. "A1". */
+  ref: string;
+}
+
+export interface RangeNode {
+  type: 'range';
+  start: string;
+  end: string;
+}
+
+export type UnaryOperator = '-' | '+';
+
+export interface UnaryNode {
+  type: 'unary';
+  op: UnaryOperator;
+  operand: Node;
+}
+
+export type BinaryOperator =
+  | '+'
+  | '-'
+  | '*'
+  | '/'
+  | '>'
+  | '<'
+  | '>='
+  | '<='
+  | '='
+  | '<>';
+
+export interface BinaryNode {
+  type: 'binary';
+  op: BinaryOperator;
+  left: Node;
+  right: Node;
+}
+
+export interface FunctionNode {
+  type: 'function';
+  /** Upper-cased function name, e.g. "SUM". */
+  name: string;
+  args: Node[];
+}
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..5a4e3be
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,222 @@
+/** Evaluates a parsed formula AST against the current spreadsheet state. */
+
+import { Node } from './ast.js';
+import { expandRange } from './reference.js';
+import { CellError, CellValue, ErrorCode, EvalError } from './value.js';
+
+/** Supplies computed cell values to the evaluator. */
+export interface EvalContext {
+  /** Return the already-computed value of a cell (null when empty). */
+  getValue(ref: string): CellValue;
+}
+
+/** Evaluate a formula AST to a single cell value. */
+export function evaluate(node: Node, ctx: EvalContext): CellValue {
+  switch (node.type) {
+    case 'number':
+      return node.value;
+    case 'string':
+      return node.value;
+    case 'bool':
+      return node.value;
+    case 'cell':
+      return resolveCell(node.ref, ctx);
+    case 'range':
+      throw new EvalError(ErrorCode.VALUE, 'A range cannot be used as a value here');
+    case 'unary':
+      return evalUnary(node.op, evaluate(node.operand, ctx));
+    case 'binary':
+      return evalBinary(node, ctx);
+    case 'function':
+      return evalFunction(node, ctx);
+    default: {
+      const _exhaustive: never = node;
+      return _exhaustive;
+    }
+  }
+}
+
+function resolveCell(ref: string, ctx: EvalContext): CellValue {
+  const value = ctx.getValue(ref);
+  if (value instanceof CellError) {
+    // Propagate an upstream error to dependents.
+    throw new EvalError(value.code);
+  }
+  return value;
+}
+
+/** Coerce a value to a number for arithmetic, applying spreadsheet rules. */
+function toNumber(value: CellValue): number {
+  if (typeof value === 'number') return value;
+  if (value === null) return 0; // empty cell behaves as 0
+  if (typeof value === 'boolean') return value ? 1 : 0;
+  if (value instanceof CellError) throw new EvalError(value.code);
+  // String: accept numeric strings, otherwise it's a value error.
+  const trimmed = value.trim();
+  if (trimmed !== '' && !Number.isNaN(Number(trimmed))) {
+    return Number(trimmed);
+  }
+  throw new EvalError(ErrorCode.VALUE, `Cannot treat "${value}" as a number`);
+}
+
+function evalUnary(op: '-' | '+', operand: CellValue): CellValue {
+  const n = toNumber(operand);
+  return op === '-' ? -n : n;
+}
+
+function evalBinary(
+  node: Extract<Node, { type: 'binary' }>,
+  ctx: EvalContext,
+): CellValue {
+  const op = node.op;
+  const left = evaluate(node.left, ctx);
+  const right = evaluate(node.right, ctx);
+
+  switch (op) {
+    case '+':
+      return toNumber(left) + toNumber(right);
+    case '-':
+      return toNumber(left) - toNumber(right);
+    case '*':
+      return toNumber(left) * toNumber(right);
+    case '/': {
+      const divisor = toNumber(right);
+      if (divisor === 0) throw new EvalError(ErrorCode.DIV_ZERO);
+      return toNumber(left) / divisor;
+    }
+    case '>':
+    case '<':
+    case '>=':
+    case '<=':
+    case '=':
+    case '<>':
+      return compare(op, left, right);
+    default: {
+      const _exhaustive: never = op;
+      return _exhaustive;
+    }
+  }
+}
+
+/** Compare two values, mirroring spreadsheet semantics. */
+function compare(
+  op: '>' | '<' | '>=' | '<=' | '=' | '<>',
+  left: CellValue,
+  right: CellValue,
+): boolean {
+  if (left instanceof CellError) throw new EvalError(left.code);
+  if (right instanceof CellError) throw new EvalError(right.code);
+
+  // Empty cells compare as 0 against numbers and as "" against strings.
+  let cmp: number;
+  if (isNumericLike(left) && isNumericLike(right)) {
+    cmp = numericValue(left) - numericValue(right);
+  } else {
+    const ls = comparableString(left);
+    const rs = comparableString(right);
+    cmp = ls < rs ? -1 : ls > rs ? 1 : 0;
+  }
+
+  switch (op) {
+    case '>':
+      return cmp > 0;
+    case '<':
+      return cmp < 0;
+    case '>=':
+      return cmp >= 0;
+    case '<=':
+      return cmp <= 0;
+    case '=':
+      return cmp === 0;
+    case '<>':
+      return cmp !== 0;
+  }
+}
+
+function isNumericLike(value: CellValue): boolean {
+  return typeof value === 'number' || typeof value === 'boolean' || value === null;
+}
+
+function numericValue(value: CellValue): number {
+  if (typeof value === 'number') return value;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+  return 0; // null
+}
+
+function comparableString(value: CellValue): string {
+  if (value === null) return '';
+  if (typeof value === 'boolean') return value ? 'TRUE' : 'FALSE';
+  return String(value);
+}
+
+/** Interpret a value as a boolean condition (for IF). */
+function toBoolean(value: CellValue): boolean {
+  if (typeof value === 'boolean') return value;
+  if (typeof value === 'number') return value !== 0;
+  if (value === null) return false;
+  if (value instanceof CellError) throw new EvalError(value.code);
+  throw new EvalError(ErrorCode.VALUE, `Cannot treat "${value}" as a condition`);
+}
+
+function evalFunction(
+  node: Extract<Node, { type: 'function' }>,
+  ctx: EvalContext,
+): CellValue {
+  const { name, args } = node;
+
+  switch (name) {
+    case 'IF': {
+      if (args.length !== 3) {
+        throw new EvalError(ErrorCode.VALUE, 'IF expects 3 arguments');
+      }
+      const condition = toBoolean(evaluate(args[0], ctx));
+      return evaluate(condition ? args[1] : args[2], ctx);
+    }
+    case 'SUM': {
+      const nums = gatherNumbers(args, ctx);
+      return nums.reduce((a, b) => a + b, 0);
+    }
+    case 'AVERAGE': {
+      const nums = gatherNumbers(args, ctx);
+      if (nums.length === 0) throw new EvalError(ErrorCode.DIV_ZERO);
+      return nums.reduce((a, b) => a + b, 0) / nums.length;
+    }
+    case 'MIN': {
+      const nums = gatherNumbers(args, ctx);
+      return nums.length === 0 ? 0 : Math.min(...nums);
+    }
+    case 'MAX': {
+      const nums = gatherNumbers(args, ctx);
+      return nums.length === 0 ? 0 : Math.max(...nums);
+    }
+    case 'COUNT': {
+      return gatherNumbers(args, ctx).length;
+    }
+    default:
+      throw new EvalError(ErrorCode.NAME, `Unknown function ${name}`);
+  }
+}
+
+/**
+ * Collect the numeric values from a list of function arguments. Range arguments
+ * are expanded; only genuine numbers contribute (text, booleans and empty cells
+ * are ignored, matching aggregate-function behaviour). Upstream errors
+ * propagate.
+ */
+function gatherNumbers(args: Node[], ctx: EvalContext): number[] {
+  const nums: number[] = [];
+  for (const arg of args) {
+    if (arg.type === 'range') {
+      for (const ref of expandRange(arg.start, arg.end)) {
+        const value = ctx.getValue(ref);
+        if (value instanceof CellError) throw new EvalError(value.code);
+        if (typeof value === 'number') nums.push(value);
+      }
+    } else {
+      const value = evaluate(arg, ctx);
+      if (value instanceof CellError) throw new EvalError(value.code);
+      if (typeof value === 'number') nums.push(value);
+    }
+  }
+  return nums;
+}
