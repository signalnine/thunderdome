@@ -0,0 +1,140 @@
+/** Lexical tokenizer for spreadsheet formula expressions. */
+
+export type TokenType =
+  | 'NUMBER'
+  | 'STRING'
+  | 'BOOL'
+  | 'CELL'
+  | 'IDENT'
+  | 'OP'
+  | 'LPAREN'
+  | 'RPAREN'
+  | 'COMMA'
+  | 'COLON';
+
+export interface Token {
+  type: TokenType;
+  value: string;
+  /** Position in the source string, for error messages. */
+  pos: number;
+}
+
+const CELL_RE = /^[A-Za-z]+[1-9][0-9]*/;
+const IDENT_RE = /^[A-Za-z]+/;
+const NUMBER_RE = /^[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?|^\.[0-9]+/;
+
+/** Multi-character operators must be tried before their single-char prefixes. */
+const MULTI_OPS = ['>=', '<=', '<>'];
+const SINGLE_OPS = ['+', '-', '*', '/', '>', '<', '='];
+
+export function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+
+  while (i < input.length) {
+    const ch = input[i];
+
+    // Skip whitespace.
+    if (ch === ' ' || ch === '\t' || ch === '\n' || ch === '\r') {
+      i++;
+      continue;
+    }
+
+    if (ch === '(') {
+      tokens.push({ type: 'LPAREN', value: ch, pos: i });
+      i++;
+      continue;
+    }
+    if (ch === ')') {
+      tokens.push({ type: 'RPAREN', value: ch, pos: i });
+      i++;
+      continue;
+    }
+    if (ch === ',') {
+      tokens.push({ type: 'COMMA', value: ch, pos: i });
+      i++;
+      continue;
+    }
+    if (ch === ':') {
+      tokens.push({ type: 'COLON', value: ch, pos: i });
+      i++;
+      continue;
+    }
+
+    // String literal (double-quoted, supports \" and \\ escapes).
+    if (ch === '"') {
+      let j = i + 1;
+      let str = '';
+      while (j < input.length && input[j] !== '"') {
+        if (input[j] === '\\' && j + 1 < input.length) {
+          str += input[j + 1];
+          j += 2;
+        } else {
+          str += input[j];
+          j++;
+        }
+      }
+      if (j >= input.length) {
+        throw new Error(`Unterminated string literal at position ${i}`);
+      }
+      tokens.push({ type: 'STRING', value: str, pos: i });
+      i = j + 1;
+      continue;
+    }
+
+    const rest = input.slice(i);
+
+    // Multi-character operators.
+    let matchedOp = false;
+    for (const op of MULTI_OPS) {
+      if (rest.startsWith(op)) {
+        tokens.push({ type: 'OP', value: op, pos: i });
+        i += op.length;
+        matchedOp = true;
+        break;
+      }
+    }
+    if (matchedOp) continue;
+
+    if (SINGLE_OPS.includes(ch)) {
+      tokens.push({ type: 'OP', value: ch, pos: i });
+      i++;
+      continue;
+    }
+
+    // Cell reference (letters followed by digits) — must be tried before plain
+    // identifiers and numbers.
+    const cellMatch = CELL_RE.exec(rest);
+    if (cellMatch) {
+      tokens.push({ type: 'CELL', value: cellMatch[0].toUpperCase(), pos: i });
+      i += cellMatch[0].length;
+      continue;
+    }
+
+    // Number literal.
+    const numMatch = NUMBER_RE.exec(rest);
+    if (numMatch) {
+      tokens.push({ type: 'NUMBER', value: numMatch[0], pos: i });
+      i += numMatch[0].length;
+      continue;
+    }
+
+    // Identifier — either a boolean keyword or a function name.
+    const identMatch = IDENT_RE.exec(rest);
+    if (identMatch) {
+      const word = identMatch[0];
+      const upper = word.toUpperCase();
+      if (upper === 'TRUE' || upper === 'FALSE') {
+        tokens.push({ type: 'BOOL', value: upper, pos: i });
+      } else {
+        tokens.push({ type: 'IDENT', value: word, pos: i });
+      }
+      i += word.length;
+      continue;
+    }
+
+    throw new Error(`Unexpected character '${ch}' at position ${i}`);
+  }
+
+  return tokens;
+}
