@@ -0,0 +1,212 @@
+/** The reactive spreadsheet engine. */
+
+import { Node } from './ast.js';
+import { evaluate } from './evaluator.js';
+import { collectReferences, parseFormula } from './parser.js';
+import { normalizeCell } from './reference.js';
+import {
+  CellError,
+  CellValue,
+  displayValue,
+  ErrorCode,
+  EvalError,
+} from './value.js';
+
+interface Cell {
+  /** Original input as provided to `set`. */
+  raw: string | number | boolean;
+  /** Whether the cell holds a formula or a literal value. */
+  kind: 'formula' | 'literal';
+  /** Parsed formula AST (formula cells only). */
+  ast?: Node;
+  /** Canonical references this cell reads from (formula cells only). */
+  dependencies: Set<string>;
+  /** Last computed value. */
+  value: CellValue;
+}
+
+/** Public value type returned to callers (errors surface as their code). */
+export type ExternalValue = string | number | boolean | null;
+
+const EMPTY: ReadonlySet<string> = new Set();
+
+export class Spreadsheet {
+  private readonly cells = new Map<string, Cell>();
+  /** Reverse edges: ref -> set of cells that depend on ref. */
+  private readonly dependents = new Map<string, Set<string>>();
+
+  /** Set a cell's value: a raw value, or a formula string starting with '='. */
+  set(cell: string, value: string | number | boolean): void {
+    const ref = normalizeCell(cell);
+    if (!ref) throw new Error(`Invalid cell reference: ${cell}`);
+
+    const isFormula = typeof value === 'string' && value.startsWith('=');
+
+    let ast: Node | undefined;
+    let newDeps: Set<string>;
+    if (isFormula) {
+      ast = parseFormula((value as string).slice(1));
+      newDeps = new Set();
+      collectReferences(ast, newDeps);
+      this.assertNoCycle(ref, newDeps);
+    } else {
+      newDeps = new Set();
+    }
+
+    // Detach the old dependency edges before installing new ones.
+    const existing = this.cells.get(ref);
+    if (existing) {
+      this.removeDependencyEdges(ref, existing.dependencies);
+    }
+
+    const newCell: Cell = {
+      raw: value,
+      kind: isFormula ? 'formula' : 'literal',
+      ast,
+      dependencies: newDeps,
+      value: null,
+    };
+    this.cells.set(ref, newCell);
+    this.addDependencyEdges(ref, newDeps);
+
+    this.recompute(ref);
+  }
+
+  /** Get a cell's computed value. Returns null for empty cells. */
+  get(cell: string): ExternalValue {
+    const ref = normalizeCell(cell);
+    if (!ref) throw new Error(`Invalid cell reference: ${cell}`);
+    const c = this.cells.get(ref);
+    if (!c) return null;
+    return toExternal(c.value);
+  }
+
+  /** Get the display string for a cell's computed value. */
+  getDisplay(cell: string): string {
+    const ref = normalizeCell(cell);
+    if (!ref) throw new Error(`Invalid cell reference: ${cell}`);
+    const c = this.cells.get(ref);
+    if (!c) return '';
+    return displayValue(c.value);
+  }
+
+  /** Get all non-empty cells as a Map from reference to computed value. */
+  getCells(): Map<string, ExternalValue> {
+    const result = new Map<string, ExternalValue>();
+    for (const [ref, cell] of this.cells) {
+      result.set(ref, toExternal(cell.value));
+    }
+    return result;
+  }
+
+  // ---- internals -----------------------------------------------------------
+
+  private addDependencyEdges(ref: string, deps: ReadonlySet<string>): void {
+    for (const dep of deps) {
+      let set = this.dependents.get(dep);
+      if (!set) {
+        set = new Set();
+        this.dependents.set(dep, set);
+      }
+      set.add(ref);
+    }
+  }
+
+  private removeDependencyEdges(ref: string, deps: ReadonlySet<string>): void {
+    for (const dep of deps) {
+      const set = this.dependents.get(dep);
+      if (set) {
+        set.delete(ref);
+        if (set.size === 0) this.dependents.delete(dep);
+      }
+    }
+  }
+
+  /**
+   * Throw if giving `target` the dependency set `newDeps` would create a cycle.
+   * Walks the dependency graph forward from the new dependencies; reaching
+   * `target` again means `target` would (transitively) depend on itself.
+   */
+  private assertNoCycle(target: string, newDeps: ReadonlySet<string>): void {
+    const seen = new Set<string>();
+    const stack = [...newDeps];
+    while (stack.length) {
+      const ref = stack.pop() as string;
+      if (ref === target) {
+        throw new Error(
+          `Circular reference detected involving ${target}`,
+        );
+      }
+      if (seen.has(ref)) continue;
+      seen.add(ref);
+      const deps = this.cells.get(ref)?.dependencies ?? EMPTY;
+      for (const d of deps) stack.push(d);
+    }
+  }
+
+  /**
+   * Recompute `start` and every cell that transitively depends on it, in
+   * dependency order so each cell sees up-to-date inputs.
+   */
+  private recompute(start: string): void {
+    const affected = new Set<string>();
+    const stack = [start];
+    while (stack.length) {
+      const ref = stack.pop() as string;
+      if (affected.has(ref)) continue;
+      affected.add(ref);
+      for (const dep of this.dependents.get(ref) ?? EMPTY) stack.push(dep);
+    }
+
+    for (const ref of this.topoSort(affected)) {
+      this.computeCell(ref);
+    }
+  }
+
+  /** Dependency-first ordering of the affected cells (DFS post-order). */
+  private topoSort(affected: Set<string>): string[] {
+    const order: string[] = [];
+    const visited = new Set<string>();
+
+    const visit = (ref: string): void => {
+      if (visited.has(ref)) return;
+      visited.add(ref);
+      const deps = this.cells.get(ref)?.dependencies ?? EMPTY;
+      for (const dep of deps) {
+        if (affected.has(dep)) visit(dep);
+      }
+      order.push(ref);
+    };
+
+    for (const ref of affected) visit(ref);
+    return order;
+  }
+
+  /** Compute and store a single cell's value from its current definition. */
+  private computeCell(ref: string): void {
+    const cell = this.cells.get(ref);
+    if (!cell) return;
+
+    if (cell.kind === 'literal') {
+      cell.value = cell.raw as CellValue;
+      return;
+    }
+
+    try {
+      cell.value = evaluate(cell.ast as Node, {
+        getValue: (r) => this.cells.get(r)?.value ?? null,
+      });
+    } catch (err) {
+      if (err instanceof EvalError) {
+        cell.value = new CellError(err.code);
+      } else {
+        cell.value = new CellError(ErrorCode.ERROR);
+      }
+    }
+  }
+}
+
+function toExternal(value: CellValue): ExternalValue {
+  if (value instanceof CellError) return value.code;
+  return value;
+}
