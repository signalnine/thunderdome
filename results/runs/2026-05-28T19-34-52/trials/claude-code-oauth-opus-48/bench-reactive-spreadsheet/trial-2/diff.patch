+import { describe, it, expect } from 'vitest';
+import {
+  columnToIndex,
+  indexToColumn,
+  parseCell,
+  normalizeCell,
+  coordToRef,
+  expandRange,
+} from './reference.js';
+
+describe('column <-> index conversion', () => {
+  it('maps single letters', () => {
+    expect(columnToIndex('A')).toBe(0);
+    expect(columnToIndex('Z')).toBe(25);
+  });
+
+  it('maps multi-letter columns', () => {
+    expect(columnToIndex('AA')).toBe(26);
+    expect(columnToIndex('AZ')).toBe(51);
+    expect(columnToIndex('BA')).toBe(52);
+  });
+
+  it('round-trips through indexToColumn', () => {
+    for (const i of [0, 1, 25, 26, 27, 51, 52, 701, 702]) {
+      expect(columnToIndex(indexToColumn(i))).toBe(i);
+    }
+  });
+});
+
+describe('parseCell', () => {
+  it('parses valid references', () => {
+    expect(parseCell('A1')).toEqual({ col: 0, row: 0 });
+    expect(parseCell('B2')).toEqual({ col: 1, row: 1 });
+    expect(parseCell('Z100')).toEqual({ col: 25, row: 99 });
+    expect(parseCell('AA1')).toEqual({ col: 26, row: 0 });
+  });
+
+  it('rejects invalid references', () => {
+    expect(parseCell('1A')).toBeNull();
+    expect(parseCell('A0')).toBeNull();
+    expect(parseCell('A')).toBeNull();
+    expect(parseCell('1')).toBeNull();
+    expect(parseCell('A1B')).toBeNull();
+  });
+});
+
+describe('normalizeCell', () => {
+  it('upper-cases and validates', () => {
+    expect(normalizeCell('a1')).toBe('A1');
+    expect(normalizeCell('aa10')).toBe('AA10');
+    expect(normalizeCell('bad')).toBeNull();
+  });
+});
+
+describe('coordToRef', () => {
+  it('round-trips', () => {
+    expect(coordToRef({ col: 0, row: 0 })).toBe('A1');
+    expect(coordToRef({ col: 26, row: 9 })).toBe('AA10');
+  });
+});
+
+describe('expandRange', () => {
+  it('expands a column range', () => {
+    expect(expandRange('A1', 'A3')).toEqual(['A1', 'A2', 'A3']);
+  });
+
+  it('expands a row range', () => {
+    expect(expandRange('A1', 'C1')).toEqual(['A1', 'B1', 'C1']);
+  });
+
+  it('expands a block range row-major', () => {
+    expect(expandRange('A1', 'B2')).toEqual(['A1', 'B1', 'A2', 'B2']);
+  });
+
+  it('normalizes reversed corners', () => {
+    expect(expandRange('C3', 'A1')).toEqual(expandRange('A1', 'C3'));
+  });
+});
