+/**
+ * Reactive spreadsheet engine.
+ *
+ * A grid of cells holding literal values or formulas. Setting a cell
+ * automatically recomputes every cell that depends on it, and circular
+ * dependencies are rejected at assignment time.
+ */
+
+export { Spreadsheet } from './spreadsheet.js';
+export type { ExternalValue } from './spreadsheet.js';
+export { CellError, ErrorCode } from './value.js';
+export type { CellValue } from './value.js';
