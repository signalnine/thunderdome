@@ -0,0 +1,124 @@
+import { randomUUID } from 'node:crypto';
+import type {
+  ActivityAction,
+  ActivityLogEntry,
+  Document,
+  Folder,
+  ResourceType,
+  Role,
+  Share,
+  User,
+} from './types.js';
+
+export class Store {
+  users = new Map<string, User>();
+  usersByName = new Map<string, User>();
+  tokens = new Map<string, string>(); // token -> userId
+  folders = new Map<string, Folder>();
+  documents = new Map<string, Document>();
+  shares = new Map<string, Share>();
+  activity: ActivityLogEntry[] = [];
+
+  now(): string {
+    return new Date().toISOString();
+  }
+
+  createUser(username: string, password: string): User {
+    const user: User = { id: randomUUID(), username, password };
+    this.users.set(user.id, user);
+    this.usersByName.set(username, user);
+    return user;
+  }
+
+  createToken(userId: string): string {
+    const token = randomUUID();
+    this.tokens.set(token, userId);
+    return token;
+  }
+
+  createFolder(name: string, parentId: string | null, ownerId: string): Folder {
+    const ts = this.now();
+    const folder: Folder = {
+      id: randomUUID(),
+      name,
+      parentId,
+      ownerId,
+      createdAt: ts,
+      updatedAt: ts,
+    };
+    this.folders.set(folder.id, folder);
+    return folder;
+  }
+
+  createDocument(
+    title: string,
+    content: string,
+    folderId: string,
+    ownerId: string,
+  ): Document {
+    const ts = this.now();
+    const doc: Document = {
+      id: randomUUID(),
+      title,
+      content,
+      folderId,
+      ownerId,
+      createdAt: ts,
+      updatedAt: ts,
+    };
+    this.documents.set(doc.id, doc);
+    return doc;
+  }
+
+  setShare(
+    resourceType: ResourceType,
+    resourceId: string,
+    userId: string,
+    role: Role,
+  ): Share {
+    // One share per (resource, user): update in place if it already exists.
+    for (const share of this.shares.values()) {
+      if (
+        share.resourceType === resourceType &&
+        share.resourceId === resourceId &&
+        share.userId === userId
+      ) {
+        share.role = role;
+        return share;
+      }
+    }
+    const share: Share = {
+      id: randomUUID(),
+      resourceType,
+      resourceId,
+      userId,
+      role,
+    };
+    this.shares.set(share.id, share);
+    return share;
+  }
+
+  sharesForResource(resourceType: ResourceType, resourceId: string): Share[] {
+    return [...this.shares.values()].filter(
+      (s) => s.resourceType === resourceType && s.resourceId === resourceId,
+    );
+  }
+
+  log(
+    action: ActivityAction,
+    userId: string,
+    resourceType: ResourceType,
+    resourceId: string,
+  ): ActivityLogEntry {
+    const entry: ActivityLogEntry = {
+      id: randomUUID(),
+      action,
+      userId,
+      resourceType,
+      resourceId,
+      timestamp: this.now(),
+    };
+    this.activity.push(entry);
+    return entry;
+  }
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..90ab27f
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,54 @@
+export type Role = 'viewer' | 'editor' | 'owner';
+
+export type ResourceType = 'folder' | 'document';
+
+export interface User {
+  id: string;
+  username: string;
+  password: string;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface Share {
+  id: string;
+  resourceType: ResourceType;
+  resourceId: string;
+  userId: string;
+  role: Role;
+}
+
+export type ActivityAction =
+  | 'folder.create'
+  | 'folder.update'
+  | 'folder.delete'
+  | 'document.create'
+  | 'document.update'
+  | 'document.delete'
+  | 'share';
+
+export interface ActivityLogEntry {
+  id: string;
+  action: ActivityAction;
+  userId: string;
+  resourceType: ResourceType;
+  resourceId: string;
+  timestamp: string;
+}
diff --git a/tests/api.test.ts b/tests/api.test.ts
new file mode 100644
index 0000000..365e609
--- /dev/null
+++ b/tests/api.test.ts
@@ -0,0 +1,179 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import request from 'supertest';
+import type { Express } from 'express';
+import { createApp } from '../src/app.js';
+
+let app: Express;
+
+async function register(username: string, password = 'pw') {
+  await request(app).post('/auth/register').send({ username, password }).expect(201);
+  const res = await request(app).post('/auth/login').send({ username, password }).expect(200);
+  return res.body.token as string;
+}
+
+const auth = (t: string) => ({ Authorization: `Bearer ${t}` });
+
+beforeEach(() => {
+  app = createApp();
+});
+
+describe('auth', () => {
+  it('registers and logs in', async () => {
+    await request(app).post('/auth/register').send({ username: 'a', password: 'p' }).expect(201);
+    const res = await request(app).post('/auth/login').send({ username: 'a', password: 'p' }).expect(200);
+    expect(res.body.token).toBeTruthy();
+  });
+
+  it('rejects duplicate username', async () => {
+    await request(app).post('/auth/register').send({ username: 'a', password: 'p' }).expect(201);
+    await request(app).post('/auth/register').send({ username: 'a', password: 'p' }).expect(409);
+  });
+
+  it('rejects bad credentials', async () => {
+    await request(app).post('/auth/register').send({ username: 'a', password: 'p' }).expect(201);
+    await request(app).post('/auth/login').send({ username: 'a', password: 'x' }).expect(401);
+  });
+
+  it('requires a token for protected routes', async () => {
+    await request(app).post('/folders').send({ name: 'f' }).expect(401);
+  });
+
+  it('rejects invalid token', async () => {
+    await request(app).post('/folders').set({ Authorization: 'Bearer nope' }).send({ name: 'f' }).expect(401);
+  });
+});
+
+describe('folders & documents', () => {
+  it('creates a folder and a document, owner can read', async () => {
+    const t = await register('owner');
+    const folder = (await request(app).post('/folders').set(auth(t)).send({ name: 'root' }).expect(201)).body;
+    const doc = (
+      await request(app).post('/documents').set(auth(t)).send({ title: 'doc', content: 'hi', folderId: folder.id }).expect(201)
+    ).body;
+    const got = await request(app).get(`/documents/${doc.id}`).set(auth(t)).expect(200);
+    expect(got.body.role).toBe('owner');
+    expect(got.body.content).toBe('hi');
+  });
+
+  it('nested folder creation requires modify on parent', async () => {
+    const t = await register('owner');
+    const root = (await request(app).post('/folders').set(auth(t)).send({ name: 'root' }).expect(201)).body;
+    const child = (await request(app).post('/folders').set(auth(t)).send({ name: 'child', parentId: root.id }).expect(201)).body;
+    expect(child.parentId).toBe(root.id);
+  });
+
+  it('supports nested document route', async () => {
+    const t = await register('owner');
+    const folder = (await request(app).post('/folders').set(auth(t)).send({ name: 'root' }).expect(201)).body;
+    const doc = await request(app)
+      .post(`/folders/${folder.id}/documents`)
+      .set(auth(t))
+      .send({ title: 'd', content: 'c' })
+      .expect(201);
+    expect(doc.body.folderId).toBe(folder.id);
+  });
+
+  it('deletes a folder subtree including documents', async () => {
+    const t = await register('owner');
+    const root = (await request(app).post('/folders').set(auth(t)).send({ name: 'root' }).expect(201)).body;
+    const child = (await request(app).post('/folders').set(auth(t)).send({ name: 'c', parentId: root.id }).expect(201)).body;
+    const doc = (await request(app).post('/documents').set(auth(t)).send({ title: 'd', folderId: child.id }).expect(201)).body;
+    await request(app).delete(`/folders/${root.id}`).set(auth(t)).expect(204);
+    await request(app).get(`/folders/${child.id}`).set(auth(t)).expect(404);
+    await request(app).get(`/documents/${doc.id}`).set(auth(t)).expect(404);
+  });
+});
+
+describe('permissions', () => {
+  it('viewer can read but not modify or delete', async () => {
+    const owner = await register('owner');
+    const viewerTok = await register('viewer');
+    const viewerId = (await request(app).post('/auth/login').send({ username: 'viewer', password: 'pw' })).body.userId;
+    const folder = (await request(app).post('/folders').set(auth(owner)).send({ name: 'f' })).body;
+    const doc = (await request(app).post('/documents').set(auth(owner)).send({ title: 'd', folderId: folder.id })).body;
+    await request(app).post(`/documents/${doc.id}/share`).set(auth(owner)).send({ userId: viewerId, role: 'viewer' }).expect(201);
+
+    await request(app).get(`/documents/${doc.id}`).set(auth(viewerTok)).expect(200);
+    await request(app).put(`/documents/${doc.id}`).set(auth(viewerTok)).send({ content: 'x' }).expect(403);
+    await request(app).delete(`/documents/${doc.id}`).set(auth(viewerTok)).expect(403);
+  });
+
+  it('editor can modify and share but not delete', async () => {
+    const owner = await register('owner');
+    const editor = await register('editor');
+    const editorId = (await request(app).post('/auth/login').send({ username: 'editor', password: 'pw' })).body.userId;
+    const third = await register('third');
+    const thirdId = (await request(app).post('/auth/login').send({ username: 'third', password: 'pw' })).body.userId;
+    const folder = (await request(app).post('/folders').set(auth(owner)).send({ name: 'f' })).body;
+    const doc = (await request(app).post('/documents').set(auth(owner)).send({ title: 'd', folderId: folder.id })).body;
+    await request(app).post(`/documents/${doc.id}/share`).set(auth(owner)).send({ userId: editorId, role: 'editor' }).expect(201);
+
+    await request(app).put(`/documents/${doc.id}`).set(auth(editor)).send({ content: 'x' }).expect(200);
+    await request(app).delete(`/documents/${doc.id}`).set(auth(editor)).expect(403);
+    // editor can share viewer access
+    await request(app).post(`/documents/${doc.id}/share`).set(auth(editor)).send({ userId: thirdId, role: 'viewer' }).expect(201);
+    // but cannot grant owner role
+    await request(app).post(`/documents/${doc.id}/share`).set(auth(editor)).send({ userId: thirdId, role: 'owner' }).expect(403);
+  });
+
+  it('unrelated user has no access', async () => {
+    const owner = await register('owner');
+    const stranger = await register('stranger');
+    const folder = (await request(app).post('/folders').set(auth(owner)).send({ name: 'f' })).body;
+    const doc = (await request(app).post('/documents').set(auth(owner)).send({ title: 'd', folderId: folder.id })).body;
+    await request(app).get(`/documents/${doc.id}`).set(auth(stranger)).expect(403);
+  });
+
+  it('inherits permission from folder share', async () => {
+    const owner = await register('owner');
+    const u = await register('u');
+    const uId = (await request(app).post('/auth/login').send({ username: 'u', password: 'pw' })).body.userId;
+    const root = (await request(app).post('/folders').set(auth(owner)).send({ name: 'root' })).body;
+    const child = (await request(app).post('/folders').set(auth(owner)).send({ name: 'child', parentId: root.id })).body;
+    const doc = (await request(app).post('/documents').set(auth(owner)).send({ title: 'd', folderId: child.id })).body;
+    // Share the root folder as editor; access should flow down to the doc.
+    await request(app).post(`/folders/${root.id}/share`).set(auth(owner)).send({ userId: uId, role: 'editor' }).expect(201);
+    const got = await request(app).get(`/documents/${doc.id}`).set(auth(u)).expect(200);
+    expect(got.body.role).toBe('editor');
+    await request(app).put(`/documents/${doc.id}`).set(auth(u)).send({ content: 'z' }).expect(200);
+  });
+
+  it('resolves to the most permissive role across multiple paths', async () => {
+    const owner = await register('owner');
+    const u = await register('u');
+    const uId = (await request(app).post('/auth/login').send({ username: 'u', password: 'pw' })).body.userId;
+    const folder = (await request(app).post('/folders').set(auth(owner)).send({ name: 'f' })).body;
+    const doc = (await request(app).post('/documents').set(auth(owner)).send({ title: 'd', folderId: folder.id })).body;
+    // Folder share = viewer, direct doc share = editor -> effective editor.
+    await request(app).post(`/folders/${folder.id}/share`).set(auth(owner)).send({ userId: uId, role: 'viewer' }).expect(201);
+    await request(app).post(`/documents/${doc.id}/share`).set(auth(owner)).send({ userId: uId, role: 'editor' }).expect(201);
+    const got = await request(app).get(`/documents/${doc.id}`).set(auth(u)).expect(200);
+    expect(got.body.role).toBe('editor');
+  });
+});
+
+describe('activity log', () => {
+  it('records create, update, delete and share', async () => {
+    const owner = await register('owner');
+    const u = await register('u');
+    const uId = (await request(app).post('/auth/login').send({ username: 'u', password: 'pw' })).body.userId;
+    const folder = (await request(app).post('/folders').set(auth(owner)).send({ name: 'f' })).body;
+    const doc = (await request(app).post('/documents').set(auth(owner)).send({ title: 'd', folderId: folder.id })).body;
+    await request(app).put(`/documents/${doc.id}`).set(auth(owner)).send({ content: 'x' }).expect(200);
+    await request(app).post(`/documents/${doc.id}/share`).set(auth(owner)).send({ userId: uId, role: 'viewer' }).expect(201);
+    await request(app).delete(`/documents/${doc.id}`).set(auth(owner)).expect(204);
+
+    const log = (await request(app).get('/activity').set(auth(owner)).expect(200)).body;
+    const actions = log.map((e: { action: string }) => e.action);
+    expect(actions).toContain('folder.create');
+    expect(actions).toContain('document.create');
+    expect(actions).toContain('document.update');
+    expect(actions).toContain('share');
+    expect(actions).toContain('document.delete');
+    for (const entry of log) {
+      expect(entry.userId).toBeTruthy();
+      expect(entry.timestamp).toBeTruthy();
+      expect(entry.resourceId).toBeTruthy();
+    }
+  });
+});
