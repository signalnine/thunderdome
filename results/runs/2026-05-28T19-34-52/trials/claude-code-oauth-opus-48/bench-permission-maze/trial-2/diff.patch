diff --git a/src/app.ts b/src/app.ts
new file mode 100644
index 0000000..c183d9f
--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,302 @@
+import express, {
+  type NextFunction,
+  type Request,
+  type Response,
+} from 'express';
+import { Store } from './store.js';
+import {
+  canDelete,
+  canManageRoles,
+  canModify,
+  canRead,
+  canShare,
+  effectiveRole,
+} from './permissions.js';
+import type { ResourceType, Role } from './types.js';
+
+const ROLES: Role[] = ['viewer', 'editor', 'owner'];
+
+interface AuthedRequest extends Request {
+  userId?: string;
+}
+
+export function createApp() {
+  const app = express();
+  app.use(express.json());
+  const store = new Store();
+
+  // --- Auth middleware --------------------------------------------------
+  const authenticate = (req: AuthedRequest, res: Response, next: NextFunction) => {
+    const header = req.headers.authorization ?? '';
+    const match = /^Bearer\s+(.+)$/i.exec(header);
+    const token = match ? match[1] : undefined;
+    const userId = token ? store.tokens.get(token) : undefined;
+    if (!userId) {
+      return res.status(401).json({ error: 'Unauthorized' });
+    }
+    req.userId = userId;
+    next();
+  };
+
+  // --- Users / Auth -----------------------------------------------------
+  const register = (req: Request, res: Response) => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+      return res.status(400).json({ error: 'username and password are required' });
+    }
+    if (store.usersByName.has(username)) {
+      return res.status(409).json({ error: 'username already taken' });
+    }
+    const user = store.createUser(username, password);
+    return res.status(201).json({ id: user.id, username: user.username });
+  };
+
+  const login = (req: Request, res: Response) => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || typeof password !== 'string') {
+      return res.status(400).json({ error: 'username and password are required' });
+    }
+    const user = store.usersByName.get(username);
+    if (!user || user.password !== password) {
+      return res.status(401).json({ error: 'invalid credentials' });
+    }
+    const token = store.createToken(user.id);
+    return res.status(200).json({ token, userId: user.id });
+  };
+
+  app.post('/auth/register', register);
+  app.post('/users', register);
+  app.post('/auth/login', login);
+  app.post('/login', login);
+
+  // Everything below requires authentication.
+  app.use(authenticate);
+
+  // --- Folders ----------------------------------------------------------
+  app.post('/folders', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId!;
+    const { name, parentId } = req.body ?? {};
+    if (typeof name !== 'string' || !name) {
+      return res.status(400).json({ error: 'name is required' });
+    }
+    let parent: string | null = null;
+    if (parentId !== undefined && parentId !== null) {
+      if (typeof parentId !== 'string' || !store.folders.has(parentId)) {
+        return res.status(400).json({ error: 'parent folder not found' });
+      }
+      // Must be able to modify the parent to add a child folder to it.
+      if (!canModify(effectiveRole(store, userId, 'folder', parentId))) {
+        return res.status(403).json({ error: 'Forbidden' });
+      }
+      parent = parentId;
+    }
+    const folder = store.createFolder(name, parent, userId);
+    store.log('folder.create', userId, 'folder', folder.id);
+    return res.status(201).json(folder);
+  });
+
+  app.get('/folders/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId!;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) return res.status(404).json({ error: 'not found' });
+    const role = effectiveRole(store, userId, 'folder', folder.id);
+    if (!canRead(role)) return res.status(403).json({ error: 'Forbidden' });
+    return res.status(200).json({ ...folder, role });
+  });
+
+  app.put('/folders/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId!;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) return res.status(404).json({ error: 'not found' });
+    if (!canModify(effectiveRole(store, userId, 'folder', folder.id))) {
+      return res.status(403).json({ error: 'Forbidden' });
+    }
+    const { name } = req.body ?? {};
+    if (name !== undefined) {
+      if (typeof name !== 'string' || !name) {
+        return res.status(400).json({ error: 'name must be a non-empty string' });
+      }
+      folder.name = name;
+    }
+    folder.updatedAt = store.now();
+    store.log('folder.update', userId, 'folder', folder.id);
+    return res.status(200).json(folder);
+  });
+
+  app.delete('/folders/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId!;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) return res.status(404).json({ error: 'not found' });
+    if (!canDelete(effectiveRole(store, userId, 'folder', folder.id))) {
+      return res.status(403).json({ error: 'Forbidden' });
+    }
+    // Recursively delete descendant folders and their documents.
+    const toDelete = collectFolderSubtree(store, folder.id);
+    for (const fid of toDelete) {
+      for (const doc of [...store.documents.values()]) {
+        if (doc.folderId === fid) store.documents.delete(doc.id);
+      }
+      store.folders.delete(fid);
+    }
+    store.log('folder.delete', userId, 'folder', folder.id);
+    return res.status(204).send();
+  });
+
+  // --- Documents --------------------------------------------------------
+  const createDocument = (req: AuthedRequest, res: Response) => {
+    const userId = req.userId!;
+    const body = req.body ?? {};
+    const folderId = req.params.folderId ?? body.folderId;
+    const { title, content } = body;
+    if (typeof title !== 'string' || !title) {
+      return res.status(400).json({ error: 'title is required' });
+    }
+    if (typeof folderId !== 'string' || !store.folders.has(folderId)) {
+      return res.status(400).json({ error: 'valid folderId is required' });
+    }
+    // Need modify rights on the folder to create a document in it.
+    if (!canModify(effectiveRole(store, userId, 'folder', folderId))) {
+      return res.status(403).json({ error: 'Forbidden' });
+    }
+    const doc = store.createDocument(title, typeof content === 'string' ? content : '', folderId, userId);
+    store.log('document.create', userId, 'document', doc.id);
+    return res.status(201).json(doc);
+  };
+
+  app.post('/documents', createDocument);
+  app.post('/folders/:folderId/documents', createDocument);
+
+  app.get('/documents/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId!;
+    const doc = store.documents.get(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'not found' });
+    const role = effectiveRole(store, userId, 'document', doc.id);
+    if (!canRead(role)) return res.status(403).json({ error: 'Forbidden' });
+    return res.status(200).json({ ...doc, role });
+  });
+
+  app.put('/documents/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId!;
+    const doc = store.documents.get(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'not found' });
+    if (!canModify(effectiveRole(store, userId, 'document', doc.id))) {
+      return res.status(403).json({ error: 'Forbidden' });
+    }
+    const { title, content } = req.body ?? {};
+    if (title !== undefined) {
+      if (typeof title !== 'string' || !title) {
+        return res.status(400).json({ error: 'title must be a non-empty string' });
+      }
+      doc.title = title;
+    }
+    if (content !== undefined) {
+      if (typeof content !== 'string') {
+        return res.status(400).json({ error: 'content must be a string' });
+      }
+      doc.content = content;
+    }
+    doc.updatedAt = store.now();
+    store.log('document.update', userId, 'document', doc.id);
+    return res.status(200).json(doc);
+  });
+
+  app.delete('/documents/:id', (req: AuthedRequest, res: Response) => {
+    const userId = req.userId!;
+    const doc = store.documents.get(req.params.id);
+    if (!doc) return res.status(404).json({ error: 'not found' });
+    if (!canDelete(effectiveRole(store, userId, 'document', doc.id))) {
+      return res.status(403).json({ error: 'Forbidden' });
+    }
+    store.documents.delete(doc.id);
+    store.log('document.delete', userId, 'document', doc.id);
+    return res.status(204).send();
+  });
+
+  // --- Sharing ----------------------------------------------------------
+  const shareHandler = (
+    resourceType: ResourceType,
+    resourceId: string,
+    req: AuthedRequest,
+    res: Response,
+  ) => {
+    const userId = req.userId!;
+    const body = req.body ?? {};
+    const targetUserId: unknown = body.userId ?? body.targetUserId;
+    const role: unknown = body.role;
+
+    const exists =
+      resourceType === 'folder'
+        ? store.folders.has(resourceId)
+        : store.documents.has(resourceId);
+    if (!exists) return res.status(404).json({ error: 'not found' });
+
+    if (typeof role !== 'string' || !ROLES.includes(role as Role)) {
+      return res.status(400).json({ error: 'valid role is required (viewer|editor|owner)' });
+    }
+    if (typeof targetUserId !== 'string' || !store.users.has(targetUserId)) {
+      return res.status(400).json({ error: 'valid userId is required' });
+    }
+
+    const myRole = effectiveRole(store, userId, resourceType, resourceId);
+    // Editors may share, but only owners may grant the owner role or otherwise
+    // manage owner-level access.
+    if (!canShare(myRole)) {
+      return res.status(403).json({ error: 'Forbidden' });
+    }
+    if (role === 'owner' && !canManageRoles(myRole)) {
+      return res.status(403).json({ error: 'only an owner can grant the owner role' });
+    }
+
+    const share = store.setShare(resourceType, resourceId, targetUserId, role as Role);
+    store.log('share', userId, resourceType, resourceId);
+    return res.status(201).json(share);
+  };
+
+  app.post('/folders/:id/share', (req: AuthedRequest, res: Response) =>
+    shareHandler('folder', req.params.id, req, res),
+  );
+  app.post('/documents/:id/share', (req: AuthedRequest, res: Response) =>
+    shareHandler('document', req.params.id, req, res),
+  );
+  // Generic share endpoint: { resourceType, resourceId, userId, role }
+  app.post('/share', (req: AuthedRequest, res: Response) => {
+    const { resourceType, resourceId } = req.body ?? {};
+    if (
+      (resourceType !== 'folder' && resourceType !== 'document') ||
+      typeof resourceId !== 'string'
+    ) {
+      return res.status(400).json({ error: 'resourceType and resourceId are required' });
+    }
+    return shareHandler(resourceType, resourceId, req, res);
+  });
+
+  // --- Activity log -----------------------------------------------------
+  app.get('/activity', (req: AuthedRequest, res: Response) => {
+    return res.status(200).json(store.activity);
+  });
+
+  // --- Fallthrough ------------------------------------------------------
+  app.use((_req: Request, res: Response) => {
+    res.status(404).json({ error: 'not found' });
+  });
+
+  return app;
+}
+
+function collectFolderSubtree(store: Store, rootId: string): string[] {
+  const result: string[] = [];
+  const stack = [rootId];
+  const seen = new Set<string>();
+  while (stack.length) {
+    const id = stack.pop()!;
+    if (seen.has(id)) continue;
+    seen.add(id);
+    result.push(id);
+    for (const f of store.folders.values()) {
+      if (f.parentId === id) stack.push(f.id);
+    }
+  }
+  return result;
+}
+
+export default createApp;
