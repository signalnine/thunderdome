    const myRole = effectiveRole(store, userId, resourceType, resourceId);\n    // Editors may share, but only owners may grant the owner role or otherwise\n    // manage owner-level access.\n    if (!canShare(myRole)) {\n      return res.status(403).json({ error: 'Forbidden' });\n    }\n    if (role === 'owner' && !canManageRoles(myRole)) {\n      return res.status(403).json({ error: 'only an owner can grant the owner role' });\n    }\n\n    const share = store.setShare(resourceType, resourceId, targetUserId, role as Role);\n    store.log('share', userId, resourceType, resourceId);\n    return res.status(201).json(share);\n  };\n\n  app.post('/folders/:id/share', (req: AuthedRequest, res: Response) =>\n    shareHandler('folder', req.params.id, req, res),\n  );\n  app.post('/documents/:id/share', (req: AuthedRequest, res: Response) =>\n    shareHandler('document', req.params.id, req, res),\n  );\n  // Generic share endpoint: { resourceType, resourceId, userId, role }\n  app.post('/share', (req: AuthedRequest, res: Response) => {\n    const { resourceType, resourceId } = req.body ?? {};\n    if (\n      (resourceType !== 'folder' && resourceType !== 'document') ||\n      typeof resourceId !== 'string'\n    ) {\n      return res.status(400).json({ error: 'resourceType and resourceId are required' });\n    }\n    return shareHandler(resourceType, resourceId, req, res);\n  });\n\n  // --- Activity log -----------------------------------------------------\n  app.get('/activity', (req: AuthedRequest, res: Response) => {\n    return res.status(200).json(store.activity);\n  });\n\n  // --- Fallthrough ------------------------------------------------------\n  app.use((_req: Request, res: Response) => {\n    res.status(404).json({ error: 'not found' });\n  });\n\n  return app;\n}\n\nfunction collectFolderSubtree(store: Store, rootId: string): string[] {\n  const result: string[] = [];\n  const stack = [rootId];\n  const seen = new Set<string>();\n  while (stack.length) {\n    const id = stack.pop()!;\n    if (seen.has(id)) continue;\n    seen.add(id);\n    result.push(id);\n    for (const f of store.folders.values()) {\n      if (f.parentId === id) stack.push(f.id);\n    }\n  }\n  return result;\n}\n\nexport default createApp;\n","structuredPatch":[],"originalFile":null,"userModified":false}}
