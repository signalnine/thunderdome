+  });
+}
diff --git a/src/permissions.ts b/src/permissions.ts
new file mode 100644
index 0000000..c105213
--- /dev/null
+++ b/src/permissions.ts
@@ -0,0 +1,100 @@
+import type { Store } from './store.js';
+import type { ResourceType, Role } from './types.js';
+
+const RANK: Record<Role, number> = { viewer: 1, editor: 2, owner: 3 };
+
+export function maxRole(a: Role | null, b: Role | null): Role | null {
+  if (a === null) return b;
+  if (b === null) return a;
+  return RANK[a] >= RANK[b] ? a : b;
+}
+
+/**
+ * Build the chain of folders to consider for a resource, from the resource's
+ * own folder up through all ancestors. Guards against cycles.
+ */
+function folderChain(store: Store, startFolderId: string | null): string[] {
+  const chain: string[] = [];
+  const seen = new Set<string>();
+  let current = startFolderId;
+  while (current && !seen.has(current)) {
+    seen.add(current);
+    chain.push(current);
+    const folder = store.folders.get(current);
+    current = folder ? folder.parentId : null;
+  }
+  return chain;
+}
+
+/**
+ * Compute a user's effective role on a resource, taking the most permissive
+ * role granted through any path: ownership, a direct share, or a share on any
+ * ancestor folder.
+ */
+export function effectiveRole(
+  store: Store,
+  userId: string,
+  resourceType: ResourceType,
+  resourceId: string,
+): Role | null {
+  let role: Role | null = null;
+
+  if (resourceType === 'document') {
+    const doc = store.documents.get(resourceId);
+    if (!doc) return null;
+    if (doc.ownerId === userId) role = maxRole(role, 'owner');
+    // Direct shares on the document.
+    for (const s of store.sharesForResource('document', resourceId)) {
+      if (s.userId === userId) role = maxRole(role, s.role);
+    }
+    // Inherited from the containing folder and its ancestors.
+    role = maxRole(role, folderRole(store, userId, doc.folderId));
+    return role;
+  }
+
+  // resourceType === 'folder'
+  const folder = store.folders.get(resourceId);
+  if (!folder) return null;
+  return maxRole(role, folderRole(store, userId, resourceId));
+}
+
+/**
+ * Effective role inherited via a folder and its ancestor chain (ownership of
+ * any folder in the chain or shares on any folder in the chain).
+ */
+function folderRole(
+  store: Store,
+  userId: string,
+  startFolderId: string | null,
+): Role | null {
+  let role: Role | null = null;
+  for (const folderId of folderChain(store, startFolderId)) {
+    const folder = store.folders.get(folderId);
+    if (!folder) continue;
+    if (folder.ownerId === userId) role = maxRole(role, 'owner');
+    for (const s of store.sharesForResource('folder', folderId)) {
+      if (s.userId === userId) role = maxRole(role, s.role);
+    }
+  }
+  return role;
+}
+
+export function canRead(role: Role | null): boolean {
+  return role !== null;
+}
+
+export function canModify(role: Role | null): boolean {
+  return role === 'editor' || role === 'owner';
+}
+
+export function canShare(role: Role | null): boolean {
+  return role === 'editor' || role === 'owner';
+}
+
+export function canDelete(role: Role | null): boolean {
+  return role === 'owner';
+}
+
+export function canManageRoles(role: Role | null): boolean {
+  return role === 'owner';
+}
