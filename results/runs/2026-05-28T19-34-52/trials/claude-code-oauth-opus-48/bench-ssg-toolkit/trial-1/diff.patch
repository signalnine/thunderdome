+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+interface Footnote {
+  id: string;
+  text: string;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        let src = file.content;
+
+        // 1. Extract footnote definitions: lines like `[^1]: text`
+        const footnotes: Footnote[] = [];
+        src = src.replace(/^\[\^([^\]]+)\]:[ \t]*(.*)$/gm, (_match, id: string, text: string) => {
+          footnotes.push({ id, text: text.trim() });
+          return '';
+        });
+
+        // 2. Replace footnote references `[^1]` with a superscript link
+        src = src.replace(
+          /\[\^([^\]]+)\]/g,
+          (_match, id: string) => `<sup><a href="#fn-${id}">${id}</a></sup>`
+        );
+
+        // 3. Convert admonition containers `:::type ... :::` into divs
+        src = src.replace(
+          /:::(\w+)\n([\s\S]*?)\n:::/g,
+          (_match, kind: string, body: string) =>
+            `<div class="admonition admonition-${kind}">\n${body}\n</div>`
+        );
+
+        // 4. Render markdown to HTML
+        let html = marked.parse(src, { async: false }) as string;
+
+        // 5. Append footnote section if any definitions were found
+        if (footnotes.length > 0) {
+          footnotes.sort((a, b) => collate(a.id, b.id));
+          const items = footnotes
+            .map((fn) => `<li id="fn-${fn.id}">${fn.text}</li>`)
+            .join('\n');
+          html += `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
+
+// Order footnotes numerically when possible, lexically otherwise.
+function collate(a: string, b: string): number {
+  const na = Number(a);
+  const nb = Number(b);
+  if (!Number.isNaN(na) && !Number.isNaN(nb)) {
+    return na - nb;
+  }
+  return a.localeCompare(b);
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
new file mode 100644
index 0000000..cd7bc85
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,56 @@
+import { BuildContext, Plugin } from '../core/types.js';
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const { baseUrl, title } = ctx.config;
+
+        const sorted = [...ctx.files].sort((a, b) => {
+          const ta = a.date ? Date.parse(a.date) : -Infinity;
+          const tb = b.date ? Date.parse(b.date) : -Infinity;
+          return tb - ta;
+        });
+
+        const items = sorted
+          .map((file) => {
+            const parts = [
+              `      <title>${escapeXml(file.title)}</title>`,
+              `      <link>${baseUrl}/${file.slug}.html</link>`,
+              `      <description><![CDATA[${file.content}]]></description>`,
+            ];
+            if (file.date) {
+              parts.push(`      <pubDate>${new Date(file.date).toUTCString()}</pubDate>`);
+            }
+            for (const tag of file.tags ?? []) {
+              parts.push(`      <category>${escapeXml(tag)}</category>`);
+            }
+            return `    <item>\n${parts.join('\n')}\n    </item>`;
+          })
+          .join('\n');
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(title)}</title>
+    <link>${baseUrl}</link>
+    <description>${escapeXml(title)}</description>
+${items}
+  </channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
+
+function escapeXml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;');
+}
diff --git a/src/plugins/search-index.ts b/src/plugins/search-index.ts
new file mode 100644
index 0000000..07212c5
--- /dev/null
+++ b/src/plugins/search-index.ts
@@ -0,0 +1,42 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface SearchEntry {
+  title: string;
+  slug: string;
+  content: string;
+  tags?: string[];
+}
+
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const index: SearchEntry[] = ctx.files.map((file: ContentFile) => {
+          const entry: SearchEntry = {
+            title: file.title,
+            slug: file.slug,
+            content: stripHtml(file.content),
+          };
+          if (file.tags) {
+            entry.tags = file.tags;
+          }
+          return entry;
+        });
+
+        ctx.output.set('search-index.json', JSON.stringify(index));
+      },
+    },
+  };
+}
+
+// Strip HTML tags while keeping the text (including code block contents) so it
+// remains searchable.
+function stripHtml(html: string): string {
+  return html
+    .replace(/<[^>]*>/g, '')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
