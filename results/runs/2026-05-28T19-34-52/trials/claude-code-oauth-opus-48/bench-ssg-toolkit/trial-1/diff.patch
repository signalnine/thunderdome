@@ -0,0 +1,22 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        // Only fenced code blocks (`<pre><code class="language-...">`) are
+        // highlighted; inline `<code>` and language-less blocks are untouched.
+        const content = file.content.replace(
+          /<pre><code class="language-(\w+)">([\s\S]*?)<\/code><\/pre>/g,
+          (_match, lang: string, code: string) =>
+            `<pre data-language="${lang}"><code class="language-${lang} highlighted">${code}</code></pre>`
+        );
+
+        return { ...file, content };
+      },
+    },
+  };
+}
diff --git a/src/plugins/taxonomy.ts b/src/plugins/taxonomy.ts
