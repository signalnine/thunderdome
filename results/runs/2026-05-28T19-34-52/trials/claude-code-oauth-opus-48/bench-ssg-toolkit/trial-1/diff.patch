@@ -0,0 +1,42 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+export function createSitemapPlugin(): Plugin {
+  return {
+    name: 'sitemap',
+    version: '1.0.0',
+    dependencies: ['taxonomy', 'rss-feed'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const { baseUrl } = ctx.config;
+        const paths = new Set<string>();
+
+        // All generated output pages (content, tag pages, feed, etc.).
+        for (const path of ctx.output.keys()) {
+          if (path === 'sitemap.xml') continue;
+          paths.add(path);
+        }
+
+        // Defensively include taxonomy tag pages even if not yet emitted.
+        const tagMap = ctx.data.get('taxonomy-tags') as
+          | Map<string, ContentFile[]>
+          | undefined;
+        if (tagMap) {
+          for (const tag of tagMap.keys()) {
+            paths.add(`tags/${tag}.html`);
+          }
+        }
+
+        const urls = [...paths]
+          .map((path) => `  <url>\n    <loc>${baseUrl}/${path}</loc>\n  </url>`)
+          .join('\n');
+
+        const sitemap = `<?xml version="1.0" encoding="UTF-8"?>
+<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
+${urls}
+</urlset>`;
+
+        ctx.output.set('sitemap.xml', sitemap);
+      },
+    },
+  };
+}
