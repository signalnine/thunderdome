--- /dev/null
+++ b/src/plugins/taxonomy.ts
@@ -0,0 +1,55 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild: (ctx: BuildContext): void => {
+        const tagMap = new Map<string, ContentFile[]>();
+        for (const file of ctx.files) {
+          if (!file.tags) continue;
+          for (const rawTag of file.tags) {
+            const tag = rawTag.toLowerCase();
+            const list = tagMap.get(tag);
+            if (list) {
+              list.push(file);
+            } else {
+              tagMap.set(tag, [file]);
+            }
+          }
+        }
+        ctx.data.set('taxonomy-tags', tagMap);
+      },
+      afterBuild: (ctx: BuildContext): void => {
+        const tagMap = ctx.data.get('taxonomy-tags') as
+          | Map<string, ContentFile[]>
+          | undefined;
+        if (!tagMap) return;
+
+        for (const [tag, files] of tagMap) {
+          const items = files
+            .map(
+              (f) => `    <li><a href="/${f.slug}.html">${f.title}</a></li>`
+            )
+            .join('\n');
+          const page = `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>Tag: ${tag} | ${ctx.config.title}</title>
+</head>
+<body>
+  <h1>Tag: ${tag}</h1>
+  <ul>
+${items}
+  </ul>
+</body>
+</html>`;
+          ctx.output.set(`tags/${tag}.html`, page);
+        }
+      },
+    },
+  };
+}
