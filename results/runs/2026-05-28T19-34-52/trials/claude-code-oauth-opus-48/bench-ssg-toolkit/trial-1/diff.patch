</section>`;\n        }\n\n        return { ...file, content: html };\n      },\n    },\n  };\n}\n\n// Order footnotes numerically when possible, lexically otherwise.\nfunction collate(a: string, b: string): number {\n  const na = Number(a);\n  const nb = Number(b);\n  if (!Number.isNaN(na) && !Number.isNaN(nb)) {\n    return na - nb;\n  }\n  return a.localeCompare(b);\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":11729,"cache_read_input_tokens":45415,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11729},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d4125481-720a-4ce7-9285-23f03893c246","uuid":"35e46000-4de8-44ee-96f6-5e75840deb24","request_id":"req_011CbVaXvNVdLuHHxjmoHb2e"}
