@@ -0,0 +1,50 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext): ContentFile => {
+        const manifest = getManifest(ctx);
+
+        const content = file.content.replace(
+          /(src|href)="([^"]+)"/g,
+          (match, attr: string, url: string) => {
+            if (!isRelativeAsset(url)) {
+              return match;
+            }
+            const relativePath = url.replace(/^\.\//, '');
+            const filename = relativePath.split('/').pop()!;
+            if (!manifest.assets.includes(filename)) {
+              manifest.assets.push(filename);
+            }
+            return `${attr}="/assets/${relativePath}"`;
+          }
+        );
+
+        return { ...file, content };
+      },
+    },
+  };
+}
+
+// A relative asset is referenced with a leading `./` and is therefore not an
+// absolute URL, a root-relative path, an anchor, or a protocol-relative URL.
+function isRelativeAsset(url: string): boolean {
+  return url.startsWith('./');
+}
+
+function getManifest(ctx: BuildContext): AssetManifest {
+  let manifest = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+  if (!manifest) {
+    manifest = { assets: [] };
+    ctx.data.set('asset-manifest', manifest);
+  }
+  return manifest;
+}
diff --git a/src/plugins/dev-server.ts b/src/plugins/dev-server.ts
