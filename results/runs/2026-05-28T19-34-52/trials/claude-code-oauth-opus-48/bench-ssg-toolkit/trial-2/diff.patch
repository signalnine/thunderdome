--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,50 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function timestamp(file: ContentFile): number {
+  if (!file.date) return -Infinity;
+  const parsed = new Date(file.date).getTime();
+  return Number.isNaN(parsed) ? -Infinity : parsed;
+}
+
+function renderItem(file: ContentFile, baseUrl: string): string {
+  const parts = [
+    `    <title>${file.title}</title>`,
+    `    <link>${baseUrl}/${file.slug}.html</link>`,
+  ];
+  if (file.date) {
+    parts.push(`    <pubDate>${new Date(file.date).toUTCString()}</pubDate>`);
+  }
+  for (const tag of file.tags ?? []) {
+    parts.push(`    <category>${tag}</category>`);
+  }
+  parts.push(`    <description><![CDATA[${file.content}]]></description>`);
+  return `  <item>\n${parts.join('\n')}\n  </item>`;
+}
+
+// Generate an RSS 2.0 feed from rendered content (HTML, newest first).
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const { title, baseUrl } = ctx.config;
+        const sorted = [...ctx.files].sort((a, b) => timestamp(b) - timestamp(a));
+        const items = sorted.map((file) => renderItem(file, baseUrl)).join('\n');
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+<channel>
+  <title>${title}</title>
+  <link>${baseUrl}</link>
+  <description>${title}</description>
+${items}
+</channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
