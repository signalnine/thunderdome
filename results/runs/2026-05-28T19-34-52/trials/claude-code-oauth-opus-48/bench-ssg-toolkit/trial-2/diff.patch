@@ -0,0 +1,41 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface SearchEntry {
+  title: string;
+  slug: string;
+  content: string;
+  tags?: string[];
+}
+
+function toPlainText(html: string): string {
+  return html
+    .replace(/<[^>]*>/g, '')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+// Generate a JSON search index of plain-text content for client-side search.
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const index: SearchEntry[] = ctx.files.map((file: ContentFile) => {
+          const entry: SearchEntry = {
+            title: file.title,
+            slug: file.slug,
+            content: toPlainText(file.content),
+          };
+          if (file.tags) {
+            entry.tags = file.tags;
+          }
+          return entry;
+        });
+
+        ctx.output.set('search-index.json', JSON.stringify(index, null, 2));
+      },
+    },
+  };
+}
