+import { ContentFile, Plugin } from '../core/types.js';
+
+// Annotate fenced code blocks with language metadata for client-side highlighting.
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        const content = file.content.replace(
+          /<pre><code class="language-([^"]+)">/g,
+          (_match, lang: string) =>
+            `<pre data-language="${lang}"><code class="language-${lang} highlighted">`,
+        );
+
+        return { ...file, content };
+      },
+    },
+  };
+}
