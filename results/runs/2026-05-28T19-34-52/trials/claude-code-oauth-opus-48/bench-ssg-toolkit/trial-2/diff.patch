+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,56 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+interface Footnote {
+  id: string;
+  text: string;
+}
+
+// Convert Markdown to HTML with footnote and admonition extensions.
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        let content = file.content;
+
+        // Extract footnote definitions: `[^id]: text`
+        const footnotes: Footnote[] = [];
+        content = content.replace(
+          /^\[\^([^\]]+)\]:\s*(.+)$/gm,
+          (_match, id: string, text: string) => {
+            footnotes.push({ id, text });
+            return '';
+          },
+        );
+
+        // Replace inline footnote references: `[^id]` -> superscript link
+        content = content.replace(
+          /\[\^([^\]]+)\]/g,
+          (_match, id: string) => `<sup><a href="#fn-${id}">${id}</a></sup>`,
+        );
+
+        // Convert admonition containers: `:::type ... :::`
+        content = content.replace(
+          /:::(\w+)\n([\s\S]*?)\n:::/g,
+          (_match, type: string, body: string) =>
+            `<div class="admonition admonition-${type}">\n${body}\n</div>`,
+        );
+
+        let html = marked.parse(content, { async: false }) as string;
+
+        // Append the footnote section at the bottom of the document.
+        if (footnotes.length > 0) {
+          const items = footnotes
+            .map((fn) => `<li id="fn-${fn.id}">${fn.text}</li>`)
+            .join('\n');
+          html += `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
