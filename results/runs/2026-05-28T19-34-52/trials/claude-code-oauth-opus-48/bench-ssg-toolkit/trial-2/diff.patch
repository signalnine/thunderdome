@@ -0,0 +1,73 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function indexBy(
+  files: ContentFile[],
+  keysFor: (file: ContentFile) => string[],
+): Map<string, ContentFile[]> {
+  const map = new Map<string, ContentFile[]>();
+  for (const file of files) {
+    for (const raw of keysFor(file)) {
+      const key = raw.toLowerCase();
+      const bucket = map.get(key);
+      if (bucket) {
+        bucket.push(file);
+      } else {
+        map.set(key, [file]);
+      }
+    }
+  }
+  return map;
+}
+
+function renderTagPage(tag: string, files: ContentFile[], siteTitle: string): string {
+  const items = files
+    .map((file) => `    <li><a href="/${file.slug}.html">${file.title}</a></li>`)
+    .join('\n');
+  return `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>${tag} | ${siteTitle}</title>
+</head>
+<body>
+  <h1>Tagged: ${tag}</h1>
+  <ul>
+${items}
+  </ul>
+</body>
+</html>`;
+}
+
+// Build tag/category indices and emit a listing page per tag.
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild: (ctx: BuildContext): void => {
+        const tagMap = indexBy(ctx.files, (file) => file.tags ?? []);
+        ctx.data.set('taxonomy-tags', tagMap);
+
+        const categoryMap = indexBy(ctx.files, (file) => {
+          const category = file.metadata.category;
+          return typeof category === 'string' ? [category] : [];
+        });
+        ctx.data.set('taxonomy-categories', categoryMap);
+      },
+      afterBuild: (ctx: BuildContext): void => {
+        const tagMap = ctx.data.get('taxonomy-tags') as
+          | Map<string, ContentFile[]>
+          | undefined;
+        if (!tagMap) return;
+
+        for (const [tag, files] of tagMap) {
+          ctx.output.set(
+            `tags/${tag}.html`,
+            renderTagPage(tag, files, ctx.config.title),
+          );
+        }
+      },
+    },
+  };
+}
