ts/bus.js';\nimport { ORDER_EVENTS, OrderCreatedEvent } from '../events/types.js';\nimport { OrderRepository, Order, OrderItem } from './repository.js';\nimport { BillingService } from '../billing/service.js';\n\nconst REFUND_WINDOW_DAYS = 30;\n\nexport class OrderService {\n  constructor(\n    private repo: OrderRepository,\n    private eventBus: EventBus,\n    private billingService: BillingService\n  ) {}\n\n  async createOrder(\n    id: string,\n    customerId: string,\n    items: OrderItem[],\n    discount: number = 0,\n    taxRate: number = 0.1\n  ): Promise<Order> {\n    this.repo.create({\n      id,\n      customerId,\n      items: [...items],\n      status: 'pending',\n      total: 0,\n      discount,\n      taxRate,\n      createdAt: Date.now(),\n      updatedAt: Date.now(),\n    });\n\n    const event: OrderCreatedEvent = {\n      orderId: id,\n      items: items.map((i) => ({\n        productId: i.productId,\n        quantity: i.quantity,\n        unitPrice: i.unitPrice,\n      })),\n      customerId,\n      timestamp: Date.now(),\n    };\n\n    await this.eventBus.emit(ORDER_EVENTS.CREATED, event);\n\n    // Charge payment and confirm\n    const payment = await this.billingService.chargePayment(\n      id,\n      items,\n      discount,\n      taxRate,\n      'card'\n    );\n\n    this.repo.update(id, {\n      status: 'confirmed',\n      total: payment.amount,\n    });\n\n    await this.eventBus.emit(ORDER_EVENTS.CONFIRMED, {\n      orderId: id,\n      timestamp: Date.now(),\n    });\n\n    return this.repo.findById(id)!;\n  }\n\n  async cancelOrder(id: string, reason: string): Promise<Order | undefined> {\n    const order = this.repo.findById(id);\n    if (!order) return undefined;\n    if (order.status !== 'confirmed') return undefined;\n\n    // Emit cancellation event, then update status\n    await this.eventBus.emit(ORDER_EVENTS.CANCELLED, {\n      orderId: id,\n      reason,\n      items: order.items.map((i) => ({\n        productId: i.productId,\