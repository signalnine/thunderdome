@@ -0,0 +1,66 @@
+import type { EventBus } from '../../bus.js';
+import type { InventoryService } from '../../types.js';
+import { Events } from '../../types.js';
+
+const DEFAULT_LOW_STOCK_THRESHOLD = 10;
+
+export function createInventoryService(bus: EventBus): InventoryService {
+  const stock = new Map<string, number>();
+  const thresholds = new Map<string, number>();
+
+  function getThreshold(productId: string): number {
+    return thresholds.get(productId) ?? DEFAULT_LOW_STOCK_THRESHOLD;
+  }
+
+  function emitUpdated(productId: string, quantity: number): void {
+    void bus.emit(Events.INVENTORY_UPDATED, { productId, quantity });
+  }
+
+  function checkLowStock(productId: string, quantity: number): void {
+    const threshold = getThreshold(productId);
+    if (quantity < threshold) {
+      void bus.emit(Events.LOW_STOCK_ALERT, {
+        productId,
+        currentQuantity: quantity,
+        threshold,
+      });
+    }
+  }
+
+  return {
+    setStock(productId, quantity) {
+      stock.set(productId, quantity);
+      emitUpdated(productId, quantity);
+      checkLowStock(productId, quantity);
+    },
+
+    getStock(productId) {
+      return stock.get(productId) ?? 0;
+    },
+
+    reserve(productId, quantity) {
+      const available = stock.get(productId) ?? 0;
+      if (available < quantity) return false;
+      const remaining = available - quantity;
+      stock.set(productId, remaining);
+      emitUpdated(productId, remaining);
+      checkLowStock(productId, remaining);
+      return true;
+    },
+
+    release(productId, quantity) {
+      const current = stock.get(productId) ?? 0;
+      const updated = current + quantity;
+      stock.set(productId, updated);
+      emitUpdated(productId, updated);
+      checkLowStock(productId, updated);
+    },
+
+    setLowStockThreshold(productId, threshold) {
+      thresholds.set(productId, threshold);
+      if (stock.has(productId)) {
+        checkLowStock(productId, stock.get(productId)!);
+      }
+    },
+  };
+}
