@@ -0,0 +1,65 @@
+import { randomUUID } from 'crypto';
+import type { EventBus } from '../../bus.js';
+import type { CatalogService } from '../../types.js';
+import { Events } from '../../types.js';
+
+type Product = { id: string; name: string; price: number; category: string };
+
+export function createCatalogService(bus: EventBus): CatalogService {
+  const products = new Map<string, Product>();
+
+  function emitCreated(product: Product): void {
+    void bus.emit(Events.PRODUCT_CREATED, {
+      productId: product.id,
+      name: product.name,
+      price: product.price,
+      category: product.category,
+    });
+  }
+
+  return {
+    createProduct(name, price, category) {
+      const product: Product = { id: randomUUID(), name, price, category };
+      products.set(product.id, product);
+      emitCreated(product);
+      return product.id;
+    },
+
+    getProduct(productId) {
+      const product = products.get(productId);
+      if (!product) return null;
+      return { ...product };
+    },
+
+    listProducts(category) {
+      const all = [...products.values()];
+      const filtered = category ? all.filter((p) => p.category === category) : all;
+      return filtered.map((p) => ({ ...p }));
+    },
+
+    searchProducts(query) {
+      const q = query.toLowerCase();
+      return products
+        .values()
+        .filter(
+          (p) =>
+            p.name.toLowerCase().includes(q) ||
+            p.category.toLowerCase().includes(q),
+        )
+        .map((p) => ({ ...p }))
+        .toArray();
+    },
+
+    updateProduct(productId, updates) {
+      const product = products.get(productId);
+      if (!product) return;
+      if (updates.name !== undefined) product.name = updates.name;
+      if (updates.price !== undefined) product.price = updates.price;
+      if (updates.category !== undefined) product.category = updates.category;
+    },
+
+    removeProduct(productId) {
+      return products.delete(productId);
+    },
+  };
+}
