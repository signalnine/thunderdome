@@ -0,0 +1,77 @@
+import { randomUUID } from 'crypto';
+import type { EventBus } from '../../bus.js';
+import type { CartService } from '../../types.js';
+import { Events } from '../../types.js';
+
+type CartItem = { productId: string; quantity: number };
+type Cart = { id: string; userId: string; items: Map<string, CartItem> };
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  function snapshotItems(cart: Cart): CartItem[] {
+    return [...cart.items.values()].map((item) => ({ ...item }));
+  }
+
+  function emitCartUpdated(cart: Cart): void {
+    void bus.emit(Events.CART_UPDATED, {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: snapshotItems(cart),
+    });
+  }
+
+  return {
+    createCart(userId) {
+      const cart: Cart = { id: randomUUID(), userId, items: new Map() };
+      carts.set(cart.id, cart);
+      return cart.id;
+    },
+
+    addItem(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const existing = cart.items.get(productId);
+      if (existing) {
+        existing.quantity += quantity;
+      } else {
+        cart.items.set(productId, { productId, quantity });
+      }
+      emitCartUpdated(cart);
+    },
+
+    removeItem(cartId, productId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      if (cart.items.delete(productId)) {
+        emitCartUpdated(cart);
+      }
+    },
+
+    getCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      return {
+        id: cart.id,
+        userId: cart.userId,
+        items: snapshotItems(cart),
+      };
+    },
+
+    clearCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items.clear();
+      emitCartUpdated(cart);
+    },
+
+    updateQuantity(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const item = cart.items.get(productId);
+      if (!item) return;
+      item.quantity = quantity;
+      emitCartUpdated(cart);
+    },
+  };
+}
