+import { randomUUID } from 'crypto';
+import type { EventBus } from '../../bus.js';
+import type { OrderService, OrderStatus } from '../../types.js';
+import { Events } from '../../types.js';
+
+type Order = { id: string; userId: string; status: OrderStatus; total: number };
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, Order>();
+
+  return {
+    createOrder(userId, cartId, total) {
+      const order: Order = {
+        id: randomUUID(),
+        userId,
+        status: OrderStatus.PENDING,
+        total,
+      };
+      void cartId;
+      orders.set(order.id, order);
+      void bus.emit(Events.ORDER_CREATED, {
+        orderId: order.id,
+        userId: order.userId,
+        cartId,
+        total: order.total,
+      });
+      return order.id;
+    },
+
+    getOrder(orderId) {
+      const order = orders.get(orderId);
+      if (!order) return null;
+      return { id: order.id, userId: order.userId, status: order.status, total: order.total };
+    },
+
+    updateStatus(orderId, status) {
+      const order = orders.get(orderId);
+      if (!order) return;
+      const previousStatus = order.status;
+      order.status = status;
+      void bus.emit(Events.ORDER_STATUS_CHANGED, {
+        orderId: order.id,
+        status,
+        previousStatus,
+      });
+    },
+
+    listOrders(userId) {
+      return [...orders.values()]
+        .filter((o) => o.userId === userId)
+        .map((o) => ({ id: o.id, status: o.status, total: o.total }));
+    },
+  };
+}
