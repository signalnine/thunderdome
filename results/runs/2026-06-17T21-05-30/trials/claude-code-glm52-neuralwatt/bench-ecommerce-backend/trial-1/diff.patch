4\t    expect(result.tax).toBe(10);\n125\t    expect(result.total).toBe(110);\n126\t  });\n127\t\n128\t  it('9. should apply discount code and compute correct total', () => {\n129\t    pricing.addDiscountCode('SAVE20', 20);\n130\t    const result = pricing.calculateTotal(\n131\t      [{ productId: 'p1', quantity: 1, price: 200 }],\n132\t      'SAVE20',\n133\t    );\n134\t    expect(result.subtotal).toBe(200);\n135\t    expect(result.discount).toBe(40);\n136\t    // After discount: 160, tax: 16, total: 176\n137\t    expect(result.tax).toBe(16);\n138\t    expect(result.total).toBe(176);\n139\t  });\n140\t\n141\t  // 10-12: Order creation and status transitions\n142\t  it('10. should create an order with PENDING status', () => {\n143\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n144\t    const order = orders.getOrder(orderId);\n145\t    expect(order!.status).toBe(OrderStatus.PENDING);\n146\t    expect(order!.total).toBe(150);\n147\t  });\n148\t\n149\t  it('11. should transition order through status states', () => {\n150\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n151\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n152\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.CONFIRMED);\n153\t\n154\t    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n155\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.SHIPPED);\n156\t\n157\t    orders.updateStatus(orderId, OrderStatus.DELIVERED);\n158\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.DELIVERED);\n159\t  });\n160\t\n161\t  it('12. should emit order:status_changed events with correct previous status', () => {\n162\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n163\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n164\t    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n165\t\n166\t    const log = bus.getLog();\n167\t    const statusEvents = log.filter(e => e.event === Events.ORDER_STATUS_CHANGED);\n168\t    expect(statusEvents).toHaveLength(2);\n169\t\n170\t    const first = statusEvents[0].payload as { previousStatus: string; status: string };\n171\t    expect(first.previousStatus).toBe(OrderStatus.PENDING);\n172\t    expect(first.status).toBe(OrderStatus.CONFIRMED);\n173\t\n174\t    const second = statusEvents[1].payload as { previousStatus: string; status: string };\n175\t    expect(second.previousStatus).toBe(OrderStatus.CONFIRMED);\n176\t    expect(second.status).toBe(OrderStatus.SHIPPED);\n177\t  });\n178\t\n179\t  // 13-14: Payment processing (success and failure)\n180\t  it('13. should process payment successfully and emit event', async () => {\n181\t    const result = await payment.processPayment('order1', 99.99);\n182\t    expect(result.status).toBe(PaymentStatus.SUCCESS);\n183\t    expect(result.transactionId).toBeDefined();\n184\t\n185\t    const log = bus.getLog();\n186\t    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n187\t    expect(payEvents).toHaveLength(1);\n188\t  });\n189\t\n190\t  it('14. should handle payment failure and emit failure event', async () => {\n191\t    const failPayment = createPaymentService(bus, { simulateFailure: true });\n192\t    const result = await failPayment.processPayment('order1', 99.99);\n193\t    expect(result.status).toBe(PaymentStatus.FAILED);\n194\t\n195\t    const log = bus.getLog();\n196\t    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n197\t    const failEvent = payEvents.find(e => (e.payload as { status: string }).status === PaymentStatus.FAILED);\n198\t    expect(failEvent).toBeDefined();\n199\t  });\n200\t\n201\t  // 15-16: Notifications generated for order events\n202\t  it('15. should send notification on order status change', async () => {\n203\t    notifications.subscribe('user1');\n204\t    const orderId = orders.createOrder('user1', 'cart1', 100);\n205\t\n206\t    // Wait for event propagation\n207\t    orders.updateStatus(orderId, OrderStatus.CO