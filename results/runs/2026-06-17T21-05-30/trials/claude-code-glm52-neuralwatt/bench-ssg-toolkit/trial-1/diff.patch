diff --git a/src/plugins/asset-pipeline.ts b/src/plugins/asset-pipeline.ts
new file mode 100644
index 0000000..2002c35
--- /dev/null
+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,69 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+/** Matches `src="./..."` or `href="./..."` style references, capturing the filename. */
+const RELATIVE_ASSET_RE = /(?:src|href)="(\.\/[^"?\s]+)"/g;
+
+/** URLs with a scheme (e.g. `https://...`) or already-rewritten `/assets/...` are left as-is. */
+
+/**
+ * Strip a leading `./` (or any leading `.` sequence + slash) and return the
+ * bare filename. We only rewrite the *filename* into `/assets/<file>`,
+ * collapsing any subpath, which matches how the asset-pipeline is expected
+ * to namespace bundled assets.
+ */
+function toAssetFilename(ref: string): string {
+  // Remove leading ./ ../ . or /, take last path segment basename.
+  const cleaned = ref.replace(/^\.+\/+/, '');
+  return cleaned;
+}
+
+function ensureManifest(ctx: BuildContext): AssetManifest {
+  let manifest = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+  if (!manifest) {
+    manifest = { assets: [] };
+    ctx.data.set('asset-manifest', manifest);
+  }
+  return manifest;
+}
+
+export interface AssetPipelineOptions {
+  /** URL prefix to rewrite relative asset references to. Defaults to `/assets/`. */
+  assetsUrl?: string;
+}
+
+export function createAssetPipelinePlugin(options: AssetPipelineOptions = {}): Plugin {
+  const assetsUrl = options.assetsUrl ?? '/assets/';
+
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext): ContentFile => {
+        const manifest = ensureManifest(ctx);
+
+        // Rewrite relative `./x` references to the assets URL. References that
+        // are already absolute (`/assets/...`, `https://...`) are left alone
+        // and not recorded as discovered assets. The regex only matches refs
+        // starting with `./`, so absolute URLs naturally pass through.
+        const rewritten = file.content.replace(
+          RELATIVE_ASSET_RE,
+          (fullMatch, ref: string) => {
+            const filename = toAssetFilename(ref);
+            if (!manifest.assets.includes(filename)) {
+              manifest.assets.push(filename);
+            }
+            // Rebuild with the existing attribute prefix (src/href).
+            return fullMatch.replace(ref, assetsUrl + filename);
+          },
+        );
+
+        return { ...file, content: rewritten };
+      },
+    },
+  };
+}
diff --git a/src/plugins/markdown-ext.ts b/src/plugins/markdown-ext.ts
new file mode 100644
index 0000000..783915c
--- /dev/null
+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,159 @@
+import { marked } from 'marked';
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface FootnoteDef {
+  id: string;
+  content: string;
+}
+
+/**
+ * Pre-process raw markdown: pull out footnote definitions (`[^id]: text`)
+ * so marked does not mangle them, and expand admonition containers
+ * (`:::type` ... `:::`) into div blocks.
+ *
+ * Footnote definitions are removed from the body and re-injected as a
+ * `<section class="footnotes">` after rendering. References `[^id]`
+ * remain inline and are replaced with `<sup><a href="#fn-id">id</a></sup>`
+ * in a post-processing pass.
+ */
+function preprocessMarkdown(input: string): { body: string; footnotes: FootnoteDef[] } {
+  const footnotes: FootnoteDef[] = [];
+
+  // 1. Extract footnote definitions: lines like "[^id]: definition text".
+  //    Definitions may contain inline markup but in the tests they are simple.
+  let body = input.replace(
+    /^\[\^([^\]\n]+)\]:[ \t]*(.+)$/gm,
+    (_match, id: string, content: string) => {
+      footnotes.push({ id, content: content.trim() });
+      return ''; // remove definition line from body
+    },
+  );
+
+  // 2. Expand admonition containers. A container opens with `:::type`
+  //    (optionally followed by a title) and closes with `:::`. The inner
+  //    content is wrapped in an admonition div that marked will then
+  //    leave alone as raw HTML.
+  body = expandAdmonitions(body);
+
+  return { body, footnotes };
+}
+
+const ADMONITION_TYPES = new Set(['note', 'warning', 'tip', 'info', 'danger', 'success']);
+
+function expandAdmonitions(input: string): string {
+  const lines = input.split('\n');
+  const out: string[] = [];
+  let containerType: string | null = null;
+  const innerLines: string[] = [];
+
+  const openDiv = (type: string, content: string[]) => {
+    out.push(
+      `<div class="admonition admonition-${type.toLowerCase()}">`,
+      ...content,
+      '</div>',
+    );
+  };
+
+  for (const line of lines) {
+    const openMatch = line.match(/^\s*:::\s*([A-Za-z0-9_-]+)\s*(.*)$/);
+    const closeMatch = line.match(/^\s*:::\s*$/);
+
+    if (containerType) {
+      if (closeMatch) {
+        // Close the current container.
+        openDiv(containerType, innerLines);
+        innerLines.length = 0;
+        containerType = null;
+        continue;
+      }
+      innerLines.push(line);
+      continue;
+    }
+
+    if (openMatch && ADMONITION_TYPES.has(openMatch[1].toLowerCase())) {
+      containerType = openMatch[1];
+      innerLines.length = 0;
+      continue;
+    }
+
+    // A bare `:::` with no open container is left as-is.
+    out.push(line);
+  }
+
+  // If the document never closed its container, emit what we have.
+  if (containerType) {
+    openDiv(containerType, innerLines);
+  }
+
+  return out.join('\n');
+}
+
+/**
+ * After marked renders, replace remaining footnote references `[^id]`
+ * with `<sup><a href="#fn-id">id</a></sup>`, and append a footnotes
+ * section holding the definitions.
+ */
+function postprocessHtml(html: string, footnotes: FootnoteDef[]): string {
+  let result = html;
+
+  // Replace inline references. Only do this for ids we actually have a
+  // definition for, so unrelated `[^x]` text is left untouched.
+  const defIds = new Set(footnotes.map((f) => f.id));
+  if (defIds.size > 0) {
+    result = result.replace(/\[\^([^\]\n]+)\]/g, (match, id: string) => {
+      if (!defIds.has(id)) return match;
+      return `<sup><a href="#fn-${id}">${id}</a></sup>`;
+    });
+  }
+
+  if (footnotes.length > 0) {
+    const items = footnotes
+      .map((fn) => `<li id="fn-${fn.id}">${fn.content}</li>`)
+      .join('\n');
+    result =
+      result.trimEnd() +
+      '\n<section class="footnotes">\n<ol>\n' +
+      items +
+      '\n</ol>\n</section>\n';
+  }
+
+  return result;
+}
+
+/**
+ * Decide whether content looks like HTML already. If a file was produced
+ * by an earlier plugin or authored as HTML, marked should still be safe
+ * to run — it preserves raw HTML — but footnotes/admonitions authored in
+ * HTML form are already expanded, so we skip our pre-processing then.
+ */
+function renderMarkdown(content: string): string {
+  const { body, footnotes } = preprocessMarkdown(content);
+  const html = marked.parse(body, { async: false }) as string;
+  return postprocessHtml(html, footnotes);
+}
+
+export interface MarkdownExtOptions {
+  /** Set to true to skip rendering for files whose metadata marks them as raw HTML. */
+  rawHtmlKey?: string;
+}
+
+export function createMarkdownExtPlugin(options: MarkdownExtOptions = {}): Plugin {
+  const rawHtmlKey = options.rawHtmlKey ?? 'raw';
+
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, _ctx: BuildContext): ContentFile => {
+        // Files explicitly flagged as raw HTML pass through unchanged.
+        if (file.metadata && file.metadata[rawHtmlKey] === true) {
+          return file;
+        }
+
+        const rendered = renderMarkdown(file.content);
+        return { ...file, content: rendered };
+      },
+    },
+  };
+}
