+++ b/src/plugins/syntax-highlight.ts
@@ -0,0 +1,74 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+/**
+ * Matches a fenced code block: `<pre ...><code ...>...</code></pre>`.
+ * We capture the pre's opening tag attrs, the code's opening tag attrs, the
+ * code content, and rely on the closing `</code></pre>`.
+ *
+ * The code tag's class attribute is inspected for a `language-<lang>` token.
+ */
+const CODE_BLOCK_RE =
+  /(<pre[^>]*>)\s*(<code[^>]*>)([\s\S]*?)<\/code>\s*<\/pre>/g;
+
+/** Extract the language from a class attribute like `language-javascript`. */
+function extractLanguage(classAttr: string | null): string | null {
+  if (!classAttr) return null;
+  const match = classAttr.match(/language-([\w-]+)/);
+  return match ? match[1] : null;
+}
+
+/**
+ * Rebuild a code opening tag with an updated class attribute. If the tag has
+ * no class attribute we leave it alone (the caller decides not to highlight).
+ */
+function setHighlightedClass(codeTag: string, lang: string): string {
+  if (/\sclass=/.test(codeTag)) {
+    // Replace the existing class value, appending ` highlighted`.
+    return codeTag.replace(
+      /class="([^"]*)"/,
+      (_m, existing: string) => `class="${existing} highlighted"`,
+    );
+  }
+  // No class attribute: synthesize one. (Includes the language too.)
+  return codeTag.replace(/<code/, `<code class="language-${lang} highlighted"`);
+}
+
+/**
+ * Add a `data-language="<lang>"` attribute to the pre opening tag if missing.
+ */
+function setDataLanguage(preTag: string, lang: string): string {
+  if (/\sdata-language=/.test(preTag)) {
+    return preTag.replace(/data-language="[^"]*"/, `data-language="${lang}"`);
+  }
+  return preTag.replace(/<pre/, `<pre data-language="${lang}"`);
+}
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, _ctx: BuildContext): ContentFile => {
+        const content = file.content.replace(
+          CODE_BLOCK_RE,
+          (_match, preTag: string, codeTag: string, codeContent: string) => {
+            const classMatch = codeTag.match(/class="([^"]*)"/);
+            const lang = extractLanguage(classMatch ? classMatch[1] : null);
+
+            if (!lang) {
+              // No language token: leave the block untouched and un-highlighted.
+              return _match;
+            }
+
+            const newPre = setDataLanguage(preTag, lang);
+            const newCode = setHighlightedClass(codeTag, lang);
+            return `${newPre}${newCode}${codeContent}</code></pre>`;
+          },
+        );
+
+        return { ...file, content };
+      },
+    },
+  };
+}
