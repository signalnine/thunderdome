l, footnotes);\n}\n\nexport interface MarkdownExtOptions {\n  /** Set to true to skip rendering for files whose metadata marks them as raw HTML. */\n  rawHtmlKey?: string;\n}\n\nexport function createMarkdownExtPlugin(options: MarkdownExtOptions = {}): Plugin {\n  const rawHtmlKey = options.rawHtmlKey ?? 'raw';\n\n  return {\n    name: 'markdown-ext',\n    version: '1.0.0',\n    dependencies: [],\n    hooks: {\n      transformContent: (file: ContentFile, _ctx: BuildContext): ContentFile => {\n        // Files explicitly flagged as raw HTML pass through unchanged.\n        if (file.metadata && file.metadata[rawHtmlKey] === true) {\n          return file;\n        }\n\n        const rendered = renderMarkdown(file.content);\n        return { ...file, content: rendered };\n      },\n    },\n  };\n}\n","structuredPatch":[{"oldStart":43,"oldLines":27,"newStart":43,"newLines":27,"lines":[" function expandAdmonitions(input: string): string {","   const lines = input.split('\\n');","   const out: string[] = [];","-  let inContainer: { type: string } | null = null;","+  let containerType: string | null = null;","   const innerLines: string[] = [];"," ","+  const openDiv = (type: string, content: string[]) => {","+    out.push(","+      `<div class=\"admonition admonition-${type.toLowerCase()}\">`,","+      ...content,","+      '</div>',","+    );","+  };","+","   for (const line of lines) {","     const openMatch = line.match(/^\\s*:::\\s*([A-Za-z0-9_-]+)\\s*(.*)$/);","     const closeMatch = line.match(/^\\s*:::\\s*$/);"," ","-    if (inContainer) {","+    if (containerType) {","       if (closeMatch) {","         // Close the current container.","-        const type = inContainer.type;","-        const normalizedType = ADMONITION_TYPES.has(type.toLowerCase())","-          ? type.toLowerCase()","-          : type.toLowerCase();","-        out.push(","-          `<div class=\"admonition admonition-${normalizedType}\">`,","-          ...innerLines,","-          '</div>',","-  