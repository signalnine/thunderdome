 Database.Database;\n\n  beforeEach(() => {\n    db = createTestDb();\n    setDb(db);\n    // Seed a user for foreign key\n    db.prepare(\n      \"INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES ('user1', 'u@t.com', 'hash', 'tenant1', 'viewer')\"\n    ).run();\n  });\n\n  afterEach(() => {\n    closeDb();\n  });\n\n  it('should create a dashboard', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const res = await request(app)\n      .post('/dashboards')\n      .send({ name: 'My Dashboard', config: { theme: 'dark' } });\n\n    expect(res.status).toBe(201);\n    expect(res.body).toHaveProperty('id');\n    expect(res.body.name).toBe('My Dashboard');\n    expect(res.body.tenant_id).toBe('tenant1');\n  });\n\n  it('should list dashboards for tenant', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    await request(app).post('/dashboards').send({ name: 'Dash 1' });\n    await request(app).post('/dashboards').send({ name: 'Dash 2' });\n\n    const res = await request(app).get('/dashboards');\n\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveLength(2);\n  });\n\n  it('should get dashboard by id with widgets', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const createRes = await request(app)\n      .post('/dashboards')\n      .send({ name: 'Dash' });\n    const dashId = createRes.body.id;\n\n    const res = await request(app).get(`/dashboards/${dashId}`);\n\n    expect(res.status).toBe(200);\n    expect(res.body.name).toBe('Dash');\n    expect(res.body.widgets).toBeInstanceOf(Array);\n  });\n\n  it('should update a dashboard', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const createRes = await request(app)\n      .post('/dashboards')\n      .send({ name: 'Old Name' });\n    const dashId = createRes.body.id;\n\n    const res = await request(app)\n      .patch(`/dashboards/${dashId}`)\n      .send({ name: 'New Name' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.name).toBe('New Name');\n  });\n\n  it('should delete a dashboard', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const createRes = await request(app)\n      .post('/dashboards')\n      .send({ name: 'To Delete' });\n    const dashId = createRes.body.id;\n\n    const res = await request(app).delete(`/dashboards/${dashId}`);\n    expect(res.status).toBe(204);\n\n    const getRes = await request(app).get(`/dashboards/${dashId}`);\n    expect(getRes.status).toBe(404);\n  });\n\n  it('should add a widget to a dashboard', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const createRes = await request(app)\n      .post('/dashboards')\n      .send({ name: 'Widget Dash' });\n    const dashId = createRes.body.id;\n\n    const res = await request(app)\n      .post(`/dashboards/${dashId}/widgets`)\n      .send({\n        type: 'counter',\n        config: { event_name: 'page_view' },\n        position_x: 0,\n        position_y: 0,\n        width: 2,\n        height: 1,\n      });\n\n    expect(res.status).toBe(201);\n    expect(res.body.type).toBe('counter');\n    expect(res.body.dashboard_id).toBe(dashId);\n  });\n});\n","numLines":131,"startLine":1,"totalLines":131}}}
