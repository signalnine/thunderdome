+++ b/src/index.ts
@@ -0,0 +1,93 @@
+import type Database from 'better-sqlite3';
+import { createRegistry } from './registry/index.js';
+import { createResolver } from './resolver/index.js';
+import { createRunner } from './runner/index.js';
+import { createReviewSystem } from './reviews/index.js';
+import { createDepsService } from './deps/index.js';
+import type {
+  PluginManifest,
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+  ResolvedVersion,
+  SandboxResult,
+} from './types.js';
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest): Promise<InstallResult>;
+}
+
+export interface InstallResult {
+  resolved: ResolvedVersion[];
+  sandboxResult: SandboxResult;
+}
+
+function isInvalidManifest(manifest: PluginManifest): string | null {
+  if (!manifest.name || !manifest.name.trim()) return 'name';
+  if (!manifest.version || !manifest.version.trim()) return 'version';
+  if (!manifest.entryPoint || !manifest.entryPoint.trim()) return 'entryPoint';
+  return null;
+}
+
+/**
+ * Compose all five marketplace modules against a shared (optional) database.
+ */
+export function createMarketplace(db?: Database.Database): Marketplace {
+  // Each DB-backed module receives the same in-memory database so the
+  // marketplace operates as one coherent unit. Pure modules need no DB.
+  const registry = createRegistry(db);
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviewSystem(db);
+  const deps = createDepsService();
+
+  async function installPlugin(manifest: PluginManifest): Promise<InstallResult> {
+    // 1. Validate manifest (name, version, entryPoint required)
+    const missing = isInvalidManifest(manifest);
+    if (missing) {
+      throw new Error(`Invalid manifest: missing required field "${missing}"`);
+    }
+
+    // 2. Register the plugin
+    registry.register(manifest);
+
+    // 3. Resolve dependency versions from registry
+    const constraints = Object.entries(manifest.dependencies ?? {}).map(
+      ([depName, range]) => ({ name: depName, range })
+    );
+    const available: Record<string, string[]> = {};
+    for (const c of constraints) {
+      available[c.name] = registry.listVersions(c.name);
+    }
+    const resolved = resolver.resolve(constraints, available);
+
+    // 4. Check for circular dependencies (including the plugin itself now registered)
+    if (deps.hasCircularDependency(manifest.name, registry)) {
+      throw new Error(
+        `Circular dependency detected while installing "${manifest.name}"`
+      );
+    }
+
+    // 5. Execute entry point in sandbox
+    const sandboxResult = await runner.execute(manifest.entryPoint);
+
+    // 6. Return resolved versions and sandbox result
+    return { resolved, sandboxResult };
+  }
+
+  return {
+    registry,
+    resolver,
+    runner,
+    reviews,
+    deps,
+    installPlugin,
+  };
+}
