+import * as semver from 'semver';
+import type {
+  DependencyNode,
+  RegistryService,
+  DepsService,
+} from '../types.js';
+
+/**
+ * Resolve the "best" registered version of a dependency manifest by matching
+ * the required semver range. Returns null when no registered version satisfies.
+ */
+function resolveDepVersion(
+  name: string,
+  range: string,
+  registry: RegistryService
+): string | null {
+  const versions = registry.listVersions(name);
+  if (versions.length === 0) return null;
+  return semver.maxSatisfying(versions, range);
+}
+
+/**
+ * Get the manifest used for a dependency edge: the highest registered version
+ * satisfying the range, falling back to the latest registered version so the
+ * graph can still be traversed when a range isn't pinned exactly.
+ */
+function getDepManifest(
+  name: string,
+  range: string,
+  registry: RegistryService
+): { name: string; version: string; manifest: ReturnType<RegistryService['get']> } {
+  const bestVersion = resolveDepVersion(name, range, registry);
+  if (bestVersion !== null) {
+    const manifest = registry.getVersion(name, bestVersion);
+    if (manifest) return { name, version: bestVersion, manifest };
+  }
+  const fallback = registry.get(name);
+  if (fallback) return { name, version: fallback.version, manifest: fallback };
+  return { name, version: '', manifest: null };
+}
+
+const MAX_DEPTH = 1000;
+
+/**
+ * Dependency graph algorithms (DFS-based). Pure logic that queries a registry
+ * for the manifests and version lists needed to walk the graph.
+ */
+export function createDepsService(): DepsService {
+  const service: DepsService = {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      const root = registry.get(name);
+      if (!root) {
+        return { name, version: '', dependencies: [] };
+      }
+      return buildNode(name, root.version, registry, new Set([name]), 0);
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const cycles: string[][] = [];
+      const visited = new Set<string>();
+      const stack: string[] = [];
+      const onStack = new Set<string>();
+
+      const dfs = (current: string): void => {
+        onStack.add(current);
+        stack.push(current);
+        const manifest = registry.get(current);
+        const deps = manifest?.dependencies ?? {};
+        for (const depName of Object.keys(deps)) {
+          const dep = getDepManifest(depName, deps[depName], registry);
+          if (!dep.manifest) continue;
+          if (onStack.has(depName)) {
+            const cycleStart = stack.indexOf(depName);
+            if (cycleStart !== -1) {
+              cycles.push(stack.slice(cycleStart).concat([depName]));
+            }
+          } else if (!visited.has(depName)) {
+            dfs(depName);
+          }
+        }
+        onStack.delete(current);
+        stack.pop();
+        visited.add(current);
+      };
+
+      try {
+        dfs(name);
+      } catch {
+        // Defensive: a runaway graph is treated as cyclic.
+        return [[name]];
+      }
+
+      return cycles.length > 0 ? cycles : null;
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const result: string[] = [];
+      const visited = new Set<string>();
+      const visiting = new Set<string>();
+
+      const visit = (current: string, depth: number): void => {
+        if (depth > MAX_DEPTH) {
+          throw new Error(
+            `Circular dependency or graph too deep near "${current}"`
+          );
+        }
+        if (visited.has(current)) return;
+        if (visiting.has(current)) {
+          throw new Error(
+            `Circular dependency detected involving "${current}"`
+          );
+        }
+        visiting.add(current);
+
+        const manifest = registry.get(current);
+        const deps = manifest?.dependencies ?? {};
+        for (const depName of Object.keys(deps)) {
+          const dep = getDepManifest(depName, deps[depName], registry);
+          if (!dep.manifest) continue;
+          visit(depName, depth + 1);
+        }
+
+        visiting.delete(current);
+        visited.add(current);
+        result.push(current);
+      };
+
+      visit(name, 0);
+      return result;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      // Topologically sorted dependencies of `name`, excluding `name` itself.
+      const sorted = service.topologicalSort(name, registry);
+      return sorted.filter((n) => n !== name);
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      const cycles = service.detectCycles(name, registry);
+      return cycles !== null && cycles.length > 0;
+    },
+  };
+
+  return service;
+}
+
+function buildNode(
+  name: string,
+  version: string,
+  registry: RegistryService,
+  path: Set<string>,
+  depth: number
+): DependencyNode {
+  const manifest = registry.getVersion(name, version) ?? registry.get(name);
+  const dependencies: DependencyNode[] = [];
+
+  if (manifest && depth < MAX_DEPTH) {
+    const deps = manifest.dependencies ?? {};
+    for (const depName of Object.keys(deps)) {
+      if (path.has(depName)) {
+        // Cycle: stop descending to avoid infinite recursion.
+        continue;
+      }
+      const dep = getDepManifest(depName, deps[depName], registry);
+      if (!dep.manifest) continue;
+      dependencies.push(
+        buildNode(
+          depName,
+          dep.manifest.version,
+          registry,
+          new Set(path).add(depName),
+          depth + 1
+        )
+      );
+    }
+  }
+
+  return { name, version, dependencies };
+}
