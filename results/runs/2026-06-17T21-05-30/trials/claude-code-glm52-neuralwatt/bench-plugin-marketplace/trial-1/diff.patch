@@ -0,0 +1,127 @@
+import Database from 'better-sqlite3';
+import type { Database as DB } from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  plugin_name: string;
+  plugin_version: string;
+  user_id: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  created_at: string;
+}
+
+function rowToReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.plugin_name,
+    pluginVersion: row.plugin_version,
+    userId: row.user_id,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged === 1,
+    createdAt: row.created_at,
+  };
+}
+
+/**
+ * SQLite-backed review system. Ratings, comments, and moderation flags.
+ * Average ratings exclude flagged reviews.
+ */
+export function createReviewSystem(db?: DB): ReviewService {
+  const database = db ?? new Database(':memory:');
+
+  database.exec(`
+    CREATE TABLE IF NOT EXISTS reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      plugin_name TEXT NOT NULL,
+      plugin_version TEXT NOT NULL,
+      user_id TEXT NOT NULL,
+      rating INTEGER NOT NULL CHECK (rating BETWEEN 1 AND 5),
+      comment TEXT NOT NULL,
+      flagged INTEGER NOT NULL DEFAULT 0,
+      created_at TEXT NOT NULL
+    );
+    CREATE INDEX IF NOT EXISTS idx_reviews_plugin_name ON reviews(plugin_name);
+    CREATE INDEX IF NOT EXISTS idx_reviews_user_id ON reviews(user_id);
+    CREATE INDEX IF NOT EXISTS idx_reviews_flagged ON reviews(flagged);
+  `);
+
+  const insertStmt = database.prepare(
+    `INSERT INTO reviews (plugin_name, plugin_version, user_id, rating, comment, flagged, created_at)
+     VALUES (?, ?, ?, ?, ?, 0, ?)`
+  );
+  const getByIdStmt = database.prepare('SELECT * FROM reviews WHERE id = ?');
+  const getByPluginStmt = database.prepare(
+    'SELECT * FROM reviews WHERE plugin_name = ? ORDER BY id'
+  );
+  const flagStmt = database.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');
+  const getFlaggedStmt = database.prepare(
+    'SELECT * FROM reviews WHERE flagged = 1 ORDER BY id'
+  );
+  const removeStmt = database.prepare('DELETE FROM reviews WHERE id = ?');
+  const getByUserStmt = database.prepare(
+    'SELECT * FROM reviews WHERE user_id = ? ORDER BY id'
+  );
+  const countByPluginStmt = database.prepare(
+    'SELECT COUNT(*) AS count FROM reviews WHERE plugin_name = ?'
+  );
+  const avgStmt = database.prepare(
+    `SELECT AVG(rating) AS avg FROM reviews WHERE plugin_name = ? AND flagged = 0`
+  );
+
+  function nowIso(): string {
+    return new Date().toISOString();
+  }
+
+  const service: ReviewService = {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      const info = insertStmt.run(
+        review.pluginName,
+        review.pluginVersion,
+        review.userId,
+        review.rating,
+        review.comment,
+        nowIso()
+      );
+      const row = getByIdStmt.get(info.lastInsertRowid) as ReviewRow;
+      return rowToReview(row);
+    },
+
+    getReviews(pluginName: string): Review[] {
+      return (getByPluginStmt.all(pluginName) as ReviewRow[]).map(rowToReview);
+    },
+
+    getAverageRating(pluginName: string): number {
+      const row = avgStmt.get(pluginName) as { avg: number | null };
+      if (row.avg == null) return 0;
+      return Number(row.avg);
+    },
+
+    flagReview(reviewId: number): void {
+      flagStmt.run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      return (getFlaggedStmt.all() as ReviewRow[]).map(rowToReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      const info = removeStmt.run(reviewId);
+      return info.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      return (getByUserStmt.all(userId) as ReviewRow[]).map(rowToReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = countByPluginStmt.get(pluginName) as { count: number };
+      return row.count;
+    },
+  };
+
+  return service;
+}
