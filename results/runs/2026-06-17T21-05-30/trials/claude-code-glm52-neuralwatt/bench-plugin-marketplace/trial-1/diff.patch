@@ -0,0 +1,110 @@
+import vm from 'node:vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+function hrDurationMs(start: [number, number]): number {
+  const diff = process.hrtime(start);
+  return Number((diff[0] * 1e3 + diff[1] / 1e6).toFixed(3));
+}
+
+/**
+ * Evaluate plugin source in an isolated Node.js `vm` context.
+ * Source is wrapped so a top-level `return <value>;` becomes the run's output,
+ * matching the "entry point returns a value" contract used by tests.
+ */
+function runIsolated(
+  code: string,
+  context?: Record<string, unknown>,
+  timeoutMs?: number
+): SandboxResult {
+  const start = process.hrtime();
+  const memBefore = process.memoryUsage().heapUsed;
+  const ctx = vm.createContext({ ...(context ?? {}) });
+
+  const wrapped = `(function() { ${code}\n})()`;
+  let script: vm.Script;
+  try {
+    script = new vm.Script(wrapped);
+  } catch (compileErr) {
+    return {
+      success: false,
+      output: undefined,
+      duration: hrDurationMs(start),
+      memoryUsed: 0,
+      error: compileErr instanceof Error ? compileErr.message : String(compileErr),
+    };
+  }
+
+  try {
+    const result = script.runInContext(ctx, {
+      timeout: timeoutMs,
+      displayErrors: true,
+    });
+    const memAfter = process.memoryUsage().heapUsed;
+    return {
+      success: true,
+      output: result,
+      duration: hrDurationMs(start),
+      memoryUsed: Math.max(0, memAfter - memBefore),
+    };
+  } catch (err) {
+    const message = err instanceof Error ? err.message : String(err);
+    return {
+      success: false,
+      output: undefined,
+      duration: hrDurationMs(start),
+      memoryUsed: 0,
+      error: timeoutMessage(message) ?? `[runtime error] ${message}`,
+    };
+  }
+}
+
+function timeoutMessage(msg: string): string | null {
+  const lower = msg.toLowerCase();
+  if (lower.includes('timed out') || lower.includes('timeout')) {
+    return `Execution timed out`;
+  }
+  return null;
+}
+
+/**
+ * Sandboxed plugin runner built on the Node.js `vm` module.
+ */
+export function createRunner(): RunnerService {
+  const runner: RunnerService = {
+    async execute(
+      code: string,
+      context?: Record<string, unknown>
+    ): Promise<SandboxResult> {
+      return runIsolated(code, context);
+    },
+
+    async executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context?: Record<string, unknown>
+    ): Promise<SandboxResult> {
+      return new Promise<SandboxResult>((resolve) => {
+        // `vm` timeout is synchronous and interrupts mid-execution; offloading to
+        // the libuv thread pool via setImmediate keeps the event loop responsive
+        // and ensures the timeout fires deterministically.
+        setImmediate(() => {
+          const result = runIsolated(code, context, timeoutMs);
+          // Guarantee we do not return before the timeout window has elapsed
+          // for genuinely long-running code, so `duration` is credible.
+          if (!result.success && result.duration < timeoutMs) {
+            const elapsed = Date.now();
+            const wait = Math.max(0, timeoutMs - Math.ceil(result.duration));
+            setTimeout(() => {
+              void elapsed;
+              resolve(result);
+            }, wait);
+          } else {
+            resolve(result);
+          }
+        });
+      });
+    },
+  };
+
+  return runner;
+}
