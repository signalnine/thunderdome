+++ b/src/registry/index.ts
@@ -0,0 +1,132 @@
+import Database from 'better-sqlite3';
+import type { Database as DB } from 'better-sqlite3';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+interface ManifestRow {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies_json: string;
+  entry_point: string;
+  permissions_json: string;
+}
+
+function rowToManifest(row: ManifestRow): PluginManifest {
+  return {
+    name: row.name,
+    version: row.version,
+    description: row.description,
+    author: row.author,
+    dependencies: JSON.parse(row.dependencies_json) as Record<string, string>,
+    entryPoint: row.entry_point,
+    permissions: JSON.parse(row.permissions_json) as string[],
+  };
+}
+
+/**
+ * SQLite-backed registry of plugin manifests, keyed by (name, version).
+ */
+export function createRegistry(db?: DB): RegistryService {
+  const database = db ?? new Database(':memory:');
+
+  database.exec(`
+    CREATE TABLE IF NOT EXISTS plugins (
+      name TEXT NOT NULL,
+      version TEXT NOT NULL,
+      description TEXT NOT NULL,
+      author TEXT NOT NULL,
+      dependencies_json TEXT NOT NULL,
+      entry_point TEXT NOT NULL,
+      permissions_json TEXT NOT NULL,
+      PRIMARY KEY (name, version)
+    );
+    CREATE INDEX IF NOT EXISTS idx_plugins_name ON plugins(name);
+  `);
+
+  const insertStmt = database.prepare(
+    'INSERT OR REPLACE INTO plugins (name, version, description, author, dependencies_json, entry_point, permissions_json) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  );
+  const getLatestStmt = database.prepare(
+    'SELECT * FROM plugins WHERE name = ? ORDER BY version DESC LIMIT 1'
+  );
+  const getVersionStmt = database.prepare(
+    'SELECT * FROM plugins WHERE name = ? AND version = ?'
+  );
+  const listStmt = database.prepare('SELECT * FROM plugins');
+  const listVersionsStmt = database.prepare(
+    'SELECT version FROM plugins WHERE name = ? ORDER BY version'
+  );
+  const removeStmt = database.prepare(
+    'DELETE FROM plugins WHERE name = ? AND version = ?'
+  );
+  const searchStmt = database.prepare(
+    'SELECT * FROM plugins WHERE name LIKE ? OR description LIKE ?'
+  );
+  const updateStmt = database.prepare(
+    `UPDATE plugins
+       SET description = COALESCE(?, description),
+           author = COALESCE(?, author),
+           dependencies_json = COALESCE(?, dependencies_json),
+           entry_point = COALESCE(?, entry_point),
+           permissions_json = COALESCE(?, permissions_json)
+     WHERE name = ? AND version = ?`
+  );
+
+  const registry: RegistryService = {
+    register(manifest: PluginManifest): void {
+      insertStmt.run(
+        manifest.name,
+        manifest.version,
+        manifest.description,
+        manifest.author,
+        JSON.stringify(manifest.dependencies ?? {}),
+        manifest.entryPoint,
+        JSON.stringify(manifest.permissions ?? [])
+      );
+    },
+
+    get(name: string): PluginManifest | null {
+      const row = getLatestStmt.get(name) as ManifestRow | undefined;
+      return row ? rowToManifest(row) : null;
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const row = getVersionStmt.get(name, version) as ManifestRow | undefined;
+      return row ? rowToManifest(row) : null;
+    },
+
+    list(): PluginManifest[] {
+      return (listStmt.all() as ManifestRow[]).map(rowToManifest);
+    },
+
+    search(query: string): PluginManifest[] {
+      const pattern = `%${query}%`;
+      return (searchStmt.all(pattern, pattern) as ManifestRow[]).map(rowToManifest);
+    },
+
+    remove(name: string, version: string): boolean {
+      const info = removeStmt.run(name, version);
+      return info.changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      const rows = listVersionsStmt.all(name) as { version: string }[];
+      return rows.map((r) => r.version);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      updateStmt.run(
+        updates.description ?? null,
+        updates.author ?? null,
+        updates.dependencies != null ? JSON.stringify(updates.dependencies) : null,
+        updates.entryPoint ?? null,
+        updates.permissions != null ? JSON.stringify(updates.permissions) : null,
+        name,
+        version
+      );
+    },
+  };
+
+  return registry;
+}
