+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_orig_mnqwy3c7muydqndgmi3dkzjtg4ytgobwmrrtszbugy4gezq","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach, afterEach } from 'vitest';\n2\timport request from 'supertest';\n3\timport jwt from 'jsonwebtoken';\n4\timport Database from 'better-sqlite3';\n5\timport { createApp } from '../src/app';\n6\timport { setDb, createTestDb, closeDb } from '../src/db';\n7\t\n8\tconst TENANT_A = 'tenant-a';\n9\tconst TENANT_B = 'tenant-b';\n10\t\n11\tdescribe('Integration Tests', () => {\n12\t  let app: ReturnType<typeof createApp>;\n13\t  let db: Database.Database;\n14\t\n15\t  beforeEach(() => {\n16\t    db = createTestDb();\n17\t    setDb(db);\n18\t    app = createApp();\n19\t  });\n20\t\n21\t  afterEach(() => {\n22\t    closeDb();\n23\t  });\n24\t\n25\t  // --- Register + Login Flow (2 tests) ---\n26\t\n27\t  it('should register a user and login successfully', async () => {\n28\t    const regRes = await request(app)\n29\t      .post('/users')\n30\t      .send({ email: 'alice@test.com', password: 'secret123', tenant_id: TENANT_A });\n31\t\n32\t    expect(regRes.status).toBe(201);\n33\t    expect(regRes.body.email).toBe('alice@test.com');\n34\t\n35\t    const loginRes = await request(app)\n36\t      .post('/users/login')\n37\t      .send({ email: 'alice@test.com', password: 'secret123' });\n38\t\n39\t    expect(loginRes.status).toBe(200);\n40\t    expect(loginRes.body).toHaveProperty('token');\n41\t    expect(loginRes.body.user.email).toBe('alice@test.com');\n42\t  });\n43\t\n44\t  it('should return JWT with correct shape {sub, tid, iat, exp}', async () => {\n45\t    await request(app)\n46\t      .post('/users')\n47\t      .send({ email: 'jwt@test.com', password: 'secret123', tenant_id: TENANT_A });\n48\t\n49\t    const loginRes = await request(app)\n50\t      .post('/users/login')\n51\t      .send({ email: 'jwt@test.com', password: 'secret123' });\n52\t\n53\t    const token = loginRes.body.token;\n54\t    const decoded = jwt.decode(token) as Record<string, unknown>;\n55\t\n56\t    expect(decoded).toHaveProperty('sub');\n57\t    expect(decoded).toHaveProperty('tid');\n58\t    expect(decoded).toHaveProperty('iat');\n59\t    expect(decoded).toHaveProperty('exp');\n60\t    expect(decoded.tid).toBe(TENANT_A);\n61\t  });\n62\t\n63\t  // --- Auth Error Format Consistency (2 tests) ---\n64\t\n65\t  it('should return consistent error format for missing auth', async () => {\n66\t    const endpoints = [\n67\t      { method: 'get' as const, url: '/users/me' },\n68\t      { method: 'post' as const, url: '/events' },\n69\t      { method: 'post' as const, url: '/query/count' },\n70\t      { method: 'get' as const, url: '/dashboards' },\n71\t      { method: 'get' as const, url: '/export/events?format=json' },\n72\t    ];\n73\t\n74\t    for (const ep of endpoints) {\n75\t      const res = await request(app)[ep.method](ep.url);\n76\t      expect(res.status).toBe(401);\n77\t      expect(res.body).toHaveProperty('error');\n78\t      expect(res.body).toHaveProperty('code');\n79\t      expect(typeof res.body.error).toBe('string');\n80\t      expect(typeof res.body.code).toBe('string');\n81\t    }\n82\t  });\n83\t\n84\t  it('should return consistent error format for invalid token', async () => {\n85\t    const endpoints = [\n86\t      { method: 'get' as const, url: '/users/me' },\n87\t      { method: 'post' as const, url: '/events' },\n88\t      { method: 'get' as const, url: '/dashboards' },\n89\t    ];\n90\t\n91\t    for (const ep of endpoints) {\n92\t      const res = await request(app)\n93\t        [ep.method](ep.url)\n94\t        .set('Authorization', 'Bearer invalid-token-here');\n95\t\n96\t      expect(res.status).toBe(401);\n97\t      expect(res.body).toHaveProperty('error');\n98\t      expect(res.body).toHaveProperty('code');\n99\t      expect(res.body.code).toBe('AUTH_ERROR');\n100\t    }\n101\t  });\n102\t\n103\t  // --- Ingest with Real Auth (2 tests) --