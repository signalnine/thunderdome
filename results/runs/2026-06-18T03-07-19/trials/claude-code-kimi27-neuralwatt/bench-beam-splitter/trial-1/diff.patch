+/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ */
+
+const DIRECTIONS = [-1, 0, 1] as const;
+type Dcol = typeof DIRECTIONS[number];
+
+function findSource(grid: string[][]): [number, number] | null {
+  if (grid.length === 0 || grid[0].length === 0) {
+    return null;
+  }
+  const cols = grid[0].length;
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') {
+      return [0, c];
+    }
+  }
+  return null;
+}
+
+/**
+ * Count the number of distinct cells visited by any beam.
+ */
+export function countBeamCells(grid: string[][]): number {
+  const source = findSource(grid);
+  if (!source) {
+    return 0;
+  }
+  const rows = grid.length;
+  const cols = grid[0].length;
+
+  const visitedCells = new Set<string>();
+  const visitedStates = new Set<string>();
+  const queue: Array<[number, number, Dcol]> = [[source[0], source[1], 0]];
+  visitedCells.add(`${source[0]},${source[1]}`);
+
+  while (queue.length > 0) {
+    const [r, c, dcol] = queue.pop()!;
+    const stateKey = `${r},${c},${dcol}`;
+    if (visitedStates.has(stateKey)) {
+      continue;
+    }
+    visitedStates.add(stateKey);
+
+    const nr = r + 1;
+    const nc = c + dcol;
+    if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
+      continue;
+    }
+
+    visitedCells.add(`${nr},${nc}`);
+
+    if (grid[nr][nc] === '^') {
+      for (const nd of [-1, 1] as const) {
+        const nextStateKey = `${nr},${nc},${nd}`;
+        if (!visitedStates.has(nextStateKey)) {
+          queue.push([nr, nc, nd]);
+        }
+      }
+    } else {
+      const nextStateKey = `${nr},${nc},${dcol}`;
+      if (!visitedStates.has(nextStateKey)) {
+        queue.push([nr, nc, dcol]);
+      }
+    }
+  }
+
+  return visitedCells.size;
+}
+
+/**
+ * Count the total number of distinct source-to-exit beam paths.
+ */
+export function countBeamPaths(grid: string[][]): bigint {
+  const source = findSource(grid);
+  if (!source) {
+    return 0n;
+  }
+  const rows = grid.length;
+  const cols = grid[0].length;
+
+  const memo = new Map<string, bigint>();
+
+  function solve(r: number, c: number, dcol: Dcol): bigint {
+    const key = `${r},${c},${dcol}`;
+    const cached = memo.get(key);
+    if (cached !== undefined) {
+      return cached;
+    }
+
+    const nr = r + 1;
+    const nc = c + dcol;
+    let result: bigint;
+
+    if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
+      result = 1n;
+    } else if (grid[nr][nc] === '^') {
+      result = solve(nr, nc, -1) + solve(nr, nc, 1);
+    } else {
+      result = solve(nr, nc, dcol);
+    }
+
+    memo.set(key, result);
+    return result;
+  }
+
+  return solve(source[0], source[1], 0);
+}
