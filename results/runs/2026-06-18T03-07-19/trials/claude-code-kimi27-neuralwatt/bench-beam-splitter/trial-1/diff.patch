+import { describe, expect, it } from 'vitest';
+import { countBeamCells, countBeamPaths } from './index.js';
+
+describe('beam splitter', () => {
+  it('counts cells for a single splitter', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(5);
+  });
+
+  it('counts paths for a single splitter', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('counts cells for two splitters with merging', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('counts paths for two splitters with merging', () => {
+    const grid = [
+      ['.', 'S', '.', '.', '.'],
+      ['.', '^', '.', '.', '.'],
+      ['^', '.', '^', '.', '.'],
+      ['.', '.', '.', '.', '.'],
+    ];
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('returns 0 for an empty grid', () => {
+    expect(countBeamCells([])).toBe(0);
+    expect(countBeamPaths([])).toBe(0n);
+  });
+
+  it('handles a source that exits without hitting a splitter', () => {
+    const grid = [
+      ['S', '.'],
+      ['.', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(2);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('handles beam absorption at side edges', () => {
+    const grid = [
+      ['.', 'S'],
+      ['^', '.'],
+    ];
+    expect(countBeamCells(grid)).toBe(2);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+});
