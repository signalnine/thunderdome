+{"type":"assistant","message":{"id":"chatcmpl-94f8ce76f199c654","type":"message","role":"assistant","model":"claude-opus-4-8","content":[{"type":"tool_use","id":"toolu_orig_mnqwy3c7ga4wgnddmrrdonrsgiydeyztmyydqodegvrwkni","name":"Write","input":{"file_path":"/workspace/tests/store.test.ts","content":"import { describe, expect, it, beforeEach } from 'vitest';\nimport { DocumentStore } from '../src/index.js';\n\ndescribe('DocumentStore', () => {\n  let store: DocumentStore;\n\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  describe('CRUD', () => {\n    it('creates, gets, updates and deletes a document', () => {\n      store.create('doc1', { a: 1 });\n      expect(store.get('doc1')).toEqual({ a: 1 });\n\n      store.update('doc1', { a: 2, b: 3 });\n      expect(store.get('doc1')).toEqual({ a: 2, b: 3 });\n\n      store.delete('doc1');\n      expect(() => store.get('doc1')).toThrow();\n    });\n\n    it('throws on duplicate create', () => {\n      store.create('doc1', {});\n      expect(() => store.create('doc1', {})).toThrow();\n    });\n\n    it('throws getting/updating/deleting missing document', () => {\n      expect(() => store.get('missing')).toThrow();\n      expect(() => store.update('missing', {})).toThrow();\n      expect(() => store.delete('missing')).toThrow();\n    });\n\n    it('clones content on storage and retrieval', () => {\n      const content = { nested: { value: 1 }, arr: [1, 2] };\n      store.create('doc1', content);\n      content.nested.value = 99;\n      content.arr.push(3);\n      expect(store.get('doc1')).toEqual({ nested: { value: 1 }, arr: [1, 2] });\n\n      const retrieved = store.get('doc1') as { nested: { value: number } };\n      retrieved.nested.value = 100;\n      expect(store.get('doc1')).toEqual({ nested: { value: 1 }, arr: [1, 2] });\n    });\n  });\n\n  describe('Version history', () => {\n    it('records a version for create and update', () => {\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { a: 2 });\n      store.update('doc1', { a: 3 });\n      const history = store.getHistory('doc1');\n      expect(history).toHaveLength(3);\n      expect(history[0].content).toEqual({ a: 1 });\n      expect(history[1].content).toEqual({ a: 2 });\n      expect(history[2].content).toEqual({ a: 3 });\n      expect(history[0].timestamp).toBeLessThanOrEqual(history[2].timestamp);\n    });\n\n    it('returns specific version content', () => {\n      store.create('doc1', { a: 1 });\n      store.update('doc1', { a: 2 });\n      const history = store.getHistory('doc1');\n      expect(store.getVersion('doc1', history[0].id)).toEqual({ a: 1 });\n      expect(store.getVersion('doc1', history[1].id)).toEqual({ a: 2 });\n    });\n\n    it('throws for missing history/version', () => {\n      expect(() => store.getHistory('missing')).toThrow();\n      store.create('doc1', {});\n      expect(() => store.getVersion('doc1', 'bad-id')).toThrow();\n    });\n  });\n\n  describe('Branching', () => {\n    it('starts on main and supports branch creation and switching', () => {\n      expect(store.getBranch()).toBe('main');\n      expect(store.listBranches()).toContain('main');\n\n      store.createBranch('feature');\n      expect(store.listBranches()).toContain('feature');\n\n      store.switchBranch('feature');\n      expect(store.getBranch()).toBe('feature');\n    });\n\n    it('branches inherit parent state and remain isolated', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n\n      expect(store.get('doc1')).toEqual({ a: 1 });\n      store.update('doc1', { a: 2 });\n\n      store.switchBranch('main');\n      expect(store.get('doc1')).toEqual({ a: 1 });\n    });\n\n    it('supports creating branch from another branch', () => {\n      store.create('doc1', { a: 1 });\n      store.createBranch('feature');\n      store.switchBranch('feature');\n      store.update('doc1', { a: 2 });\n\n      store.switchBranch('mai