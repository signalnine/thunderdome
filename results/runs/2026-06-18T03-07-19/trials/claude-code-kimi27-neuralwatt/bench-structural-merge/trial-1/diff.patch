on[]>(),\n      snapshots: [],\n      parentBranch: null,\n      parentSnapshotId: null,\n    };\n  }\n\n  private currentBranch(): Branch {\n    const branch = this.branches.get(this.currentBranchName);\n    assert(branch, `Current branch \"${this.currentBranchName}\" does not exist`);\n    return branch;\n  }\n\n  private snapshot(branch: Branch): void {\n    const docs: Record<string, object> = {};\n    for (const [id, content] of branch.docs) {\n      docs[id] = clone(content);\n    }\n    branch.snapshots.push({ id: this.nextSnapshotId++, docs });\n  }\n\n  private addVersion(branch: Branch, id: string, content: object): void {\n    const version: Version = {\n      id: newVersionId(),\n      timestamp: Date.now(),\n      content: clone(content),\n    };\n    const versions = branch.history.get(id) ?? [];\n    versions.push(version);\n    branch.history.set(id, versions);\n  }\n\n  private requireExisting(id: string): Branch {\n    const branch = this.currentBranch();\n    assert(branch.docs.has(id), `Document \"${id}\" does not exist on branch \"${this.currentBranchName}\"`);\n    return branch;\n  }\n\n  // Document CRUD -----------------------------------------------------------\n\n  create(id: string, content: object): void {\n    assert(typeof id === 'string' && id.length > 0, 'Document id must be a non-empty string');\n    const branch = this.currentBranch();\n    assert(!branch.docs.has(id), `Document \"${id}\" already exists on branch \"${this.currentBranchName}\"`);\n    branch.docs.set(id, clone(content));\n    this.addVersion(branch, id, content);\n    this.snapshot(branch);\n  }\n\n  get(id: string): object {\n    const branch = this.requireExisting(id);\n    return clone(branch.docs.get(id)!);\n  }\n\n  update(id: string, content: object): void {\n    const branch = this.requireExisting(id);\n    const cloned = clone(content);\n    branch.docs.set(id, cloned);\n    this.addVersion(branch, id, content);\n    this.snapshot(branch);\n  }\n\n  delete(id: string): void {\n    const branch = this.requireExisting(id);\n    branch.docs.delete(id);\n    // Keep history so getVersion/getHistory still work, but create/update would\n    // treat the document as absent on this branch going forward.\n    branch.history.delete(id);\n    this.snapshot(branch);\n  }\n\n  // Version history ---------------------------------------------------------\n\n  getHistory(id: string): Version[] {\n    const branch = this.currentBranch();\n    const versions = branch.history.get(id);\n    assert(versions && versions.length > 0, `No history found for document \"${id}\"`);\n    return clone(versions);\n  }\n\n  getVersion(id: string, versionId: string): object {\n    const history = this.getHistory(id);\n    const version = history.find((v) => v.id === versionId);\n    assert(version, `Version \"${versionId}\" not found for document \"${id}\"`);\n    return clone(version.content);\n  }\n\n  // Branching ---------------------------------------------------------------\n\n  createBranch(name: string, fromBranch?: string): void {\n    assert(!!name, 'Branch name must be non-empty');\n    assert(!this.branches.has(name), `Branch \"${name}\" already exists`);\n\n    const sourceName = fromBranch ?? this.currentBranchName;\n    const source = this.branches.get(sourceName);\n    assert(source, `Source branch \"${sourceName}\" does not exist`);\n\n    const branch: Branch = {\n      docs: new Map<string, object>(),\n      history: new Map<string, Version[]>(),\n      snapshots: [],\n      parentBranch: sourceName,\n      parentSnapshotId: source.snapshots.length > 0\n        ? source.snapshots[source.snapshots.length - 1].id\n        : null,\n    };\n\n    for (const [id, content] of source.docs) {\n      branch.docs.set(id, clone(content));\n    }\n    for (const [id, versions] of source.history) {\n      branch.history.set(id, clone(versions));\n    }\n\n    this.branches.set(name, branch);\n  }\n\n  switchBranch(name: string): void {\n    assert(this.branches.has(name), `Branch \"${name}\" does not exist`);\n    this.currentBranchName = name;\n  }\n\n  getBranch(): string {\n    return this.currentBranchName;\n  }\n\n  listBranches(): string[] {\n    return Array.from(this.branches.keys());\n  }\n\n  // Merging -----------------------------------------------------------------\n\n  merge(sourceBranchName: string): MergeResult {\n    assert(this.branches.has(sourceBranchName), `Source branch \"${sourceBranchName}\" does not exist`);\n    const sourceBranch = this.branches.get(sourceBranchName)!;\n    const targetBranch = this.currentBranch();\n\n    const baseDocs = this.findMergeBaseDocs(targetBranch, sourceBranch);\n\n    const ids = new Set([\n      ...Object.keys(baseDocs),\n      ...targetBranch.docs.keys(),\n      ...sourceBranch.docs.keys(),\n    ]);\n\n    const mergedDocs: Record<string, object> = {};\n    const allConflicts: Conflict[] = [];\n    let anyChange = false;\n\n    for (const id of ids) {\n      const base = baseDocs[id] ?? (Symbol('deleted') as unknown as object);\n      const ours = targetBranch.docs.get(id) ?? (Symbol('deleted') as unknown as object);\n      const theirs = sourceBranch.docs.get(id) ?? (Symbol('deleted') as unknown as object);\n\n      const baseEqualOurs = deepEqual(base, ours);\n      const baseEqualTheirs = deepEqual(base, theirs);\n\n      if (baseEqualOurs && baseEqualTheirs) continue;\n\n      anyChange = true;\n      const result = mergeDocument(base as MergeValue, ours as MergeValue, theirs as MergeValue, id);\n      allConflicts.push(...result.conflicts);\n\n      if (!isDeleted(result.content)) {\n        mergedDocs[id] = result.content;\n      }\n    }\n\n    if (!anyChange) {\n      return { merged: {}, conflicts: [], applied: true };\n    }\n\n    if (allConflicts.length > 0) {\n      return { merged: clone(mergedDocs), conflicts: allConflicts, applied: false };\n    }\n\n    // Apply the merge to the current branch.\n    for (const id of Object.keys(mergedDocs)) {\n      const content = mergedDocs[id];\n      const base = baseDocs[id];\n      const ours = targetBranch.docs.get(id);\n\n      // Did the document change in the merge?\n      if (!deepEqual(ours, content)) {\n        targetBranch.docs.set(id, clone(content));\n        this.addVersion(targetBranch, id, content);\n      }\n    }\n\n    // Detect deletions.\n    for (const id of Object.keys(baseDocs)) {\n      if (!Object.hasOwn(mergedDocs, id) && targetBranch.docs.has(id)) {\n        targetBranch.docs.delete(id);\n        targetBranch.history.delete(id);\n      }\n    }\n\n    this.snapshot(targetBranch);\n\n    return { merged: clone(mergedDocs), conflicts: [], applied: true };\n  }\n\n  private findMergeBaseDocs(ours: Branch, theirs: Branch): Record<string, object> {\n    // Locate the highest (most recent) common ancestor branch.\n    const ourAncestors = new Map<string, number | null>();\n    let current: Branch | undefined = ours;\n    let currentName = this.currentBranchName;\n    while (current) {\n      ourAncestors.set(currentName, current.snapshots.length > 0 ? current.snapshots[0].id : null);\n      currentName = current.parentBranch ?? '';\n      current = current.parentBranch ? this.branches.get(current.parentBranch) : undefined;\n    }\n\n    const theirAncestors: { name: string; branch: Branch }[] = [];\n    current = theirs;\n    currentName = this.getBranchNameFor(theirs);\n    while (current) {\n      theirAncestors.push({ name: currentName, branch: current });\n      currentName = current.parentBranch ?? '';\n      current = current.parentBranch ? this.branches.get(current.parentBranch) : undefined;\n    }\n\n    let commonAncestorName: string | null = null;\n    for (const entry of theirAncestors) {\n      if (ourAncestors.has(entry.name)) {\n        commonAncestorName = entry.name;\n        break;\n      }\n    }\n\n    assert(commonAncestorName, 'No common ancestor found between branches');\n\n    const commonAncestor = this.branches.get(commonAncestorName)!;\n\n    // Determine the snapshot id on the common ancestor where each side diverged.\n    const ourSnapshotIdOnAncestor = ourAncestors.get(commonAncestorName)!;\n    const theirSnapshotIdOnAncestor = this.findSnapshotIdFor(commonAncestorName, theirs);\n\n    const baseSnapshotId = ourSnapshotIdOnAncestor != null && theirSnapshotIdOnAncestor != null\n      ? Math.min(ourSnapshotIdOnAncestor, theirSnapshotIdOnAncestor)\n      : (ourSnapshotIdOnAncestor ?? theirSnapshotIdOnAncestor ?? null);\n\n    if (baseSnapshotId == null || commonAncestor.snapshots.length === 0) {\n      return {};\n    }\n\n    // Find the snapshot at or immediately before the base snapshot id.\n    let snapshot = commonAncestor.snapshots[0];\n    for (const s of commonAncestor.snapshots) {\n      if (s.id <= baseSnapshotId) {\n        snapshot = s;\n      } else {\n        break;\n      }\n    }\n\n    return clone(snapshot.docs);\n  }\n\n  private findSnapshotIdFor(ancestorName: string, branch: Branch): number | null {\n    let current: Branch | undefined = branch;\n    let currentName = this.getBranchNameFor(branch);\n    while (current) {\n      if (currentName === ancestorName) {\n        return current.snapshots.length > 0 ? current.snapshots[current.snapshots.length - 1].id : null;\n      }\n      currentName = current.parentBranch ?? '';\n      current = current.parentBranch ? this.branches.get(current.parentBranch) : undefined;\n    }\n    return null;\n  }\n\n  private getBranchNameFor(branch: Branch): string {\n    for (const [name, b] of this.branches) {\n      if (b === branch) return name;\n    }\n    throw new Error('Branch not found');\n  }\n}\n","structuredPatch":[{"oldStart":219,"oldLines":7,"newStart":219,"newLines":6,"lines":["     // Apply the merge to the current branch.","     for (const id of Object.keys(mergedDocs)) {","       const content = mergedDocs[id];","-      const base = baseDocs[id];","       const ours = targetBranch.docs.get(id);"," "