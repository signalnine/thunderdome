+import { describe, expect, it, beforeEach } from 'vitest';
+import { DocumentStore } from '../src/index.js';
+
+describe('DocumentStore', () => {
+  let store: DocumentStore;
+
+  beforeEach(() => {
+    store = new DocumentStore();
+  });
+
+  describe('CRUD', () => {
+    it('creates, gets, updates and deletes a document', () => {
+      store.create('doc1', { a: 1 });
+      expect(store.get('doc1')).toEqual({ a: 1 });
+
+      store.update('doc1', { a: 2, b: 3 });
+      expect(store.get('doc1')).toEqual({ a: 2, b: 3 });
+
+      store.delete('doc1');
+      expect(() => store.get('doc1')).toThrow();
+    });
+
+    it('throws on duplicate create', () => {
+      store.create('doc1', {});
+      expect(() => store.create('doc1', {})).toThrow();
+    });
+
+    it('throws getting/updating/deleting missing document', () => {
+      expect(() => store.get('missing')).toThrow();
+      expect(() => store.update('missing', {})).toThrow();
+      expect(() => store.delete('missing')).toThrow();
+    });
+
+    it('clones content on storage and retrieval', () => {
+      const content = { nested: { value: 1 }, arr: [1, 2] };
+      store.create('doc1', content);
+      content.nested.value = 99;
+      content.arr.push(3);
+      expect(store.get('doc1')).toEqual({ nested: { value: 1 }, arr: [1, 2] });
+
+      const retrieved = store.get('doc1') as { nested: { value: number } };
+      retrieved.nested.value = 100;
+      expect(store.get('doc1')).toEqual({ nested: { value: 1 }, arr: [1, 2] });
+    });
+  });
+
+  describe('Version history', () => {
+    it('records a version for create and update', () => {
+      store.create('doc1', { a: 1 });
+      store.update('doc1', { a: 2 });
+      store.update('doc1', { a: 3 });
+      const history = store.getHistory('doc1');
+      expect(history).toHaveLength(3);
+      expect(history[0].content).toEqual({ a: 1 });
+      expect(history[1].content).toEqual({ a: 2 });
+      expect(history[2].content).toEqual({ a: 3 });
+      expect(history[0].timestamp).toBeLessThanOrEqual(history[2].timestamp);
+    });
+
+    it('returns specific version content', () => {
+      store.create('doc1', { a: 1 });
+      store.update('doc1', { a: 2 });
+      const history = store.getHistory('doc1');
+      expect(store.getVersion('doc1', history[0].id)).toEqual({ a: 1 });
+      expect(store.getVersion('doc1', history[1].id)).toEqual({ a: 2 });
+    });
+
+    it('throws for missing history/version', () => {
+      expect(() => store.getHistory('missing')).toThrow();
+      store.create('doc1', {});
+      expect(() => store.getVersion('doc1', 'bad-id')).toThrow();
+    });
+  });
+
+  describe('Branching', () => {
+    it('starts on main and supports branch creation and switching', () => {
+      expect(store.getBranch()).toBe('main');
+      expect(store.listBranches()).toContain('main');
+
+      store.createBranch('feature');
+      expect(store.listBranches()).toContain('feature');
+
+      store.switchBranch('feature');
+      expect(store.getBranch()).toBe('feature');
+    });
+
+    it('branches inherit parent state and remain isolated', () => {
+      store.create('doc1', { a: 1 });
+      store.createBranch('feature');
+      store.switchBranch('feature');
+
+      expect(store.get('doc1')).toEqual({ a: 1 });
+      store.update('doc1', { a: 2 });
+
+      store.switchBranch('main');
+      expect(store.get('doc1')).toEqual({ a: 1 });
+    });
+
+    it('supports creating branch from another branch', () => {
+      store.create('doc1', { a: 1 });
+      store.createBranch('feature');
+      store.switchBranch('feature');
+      store.update('doc1', { a: 2 });
+
+      store.switchBranch('main');
+      store.createBranch('hotfix', 'feature');
+      store.switchBranch('hotfix');
+      expect(store.get('doc1')).toEqual({ a: 2 });
+    });
+  });
+
+  describe('Merging', () => {
+    it('applies non-conflicting changes from source branch', () => {
+      store.create('doc1', { a: 1, b: 2 });
+      store.createBranch('feature');
+      store.switchBranch('feature');
+      store.update('doc1', { a: 1, b: 3 });
+
+      store.switchBranch('main');
+      const result = store.merge('feature');
+      expect(result.applied).toBe(true);
+      expect(result.conflicts).toHaveLength(0);
+      expect(store.get('doc1')).toEqual({ a: 1, b: 3 });
+    });
+
+    it('merges independent field changes', () => {
+      store.create('doc1', { a: 1, b: 1 });
+      store.createBranch('feature');
+      store.switchBranch('feature');
+      store.update('doc1', { a: 2, b: 1 });
+
+      store.switchBranch('main');
+      store.update('doc1', { a: 1, b: 2 });
+
+      const result = store.merge('feature');
+      expect(result.applied).toBe(true);
+      expect(store.get('doc1')).toEqual({ a: 2, b: 2 });
+    });
+
+    it('detects and reports conflicts without applying', () => {
+      store.create('doc1', { a: 1 });
+      store.createBranch('feature');
+      store.switchBranch('feature');
+      store.update('doc1', { a: 2 });
+
+      store.switchBranch('main');
+      store.update('doc1', { a: 3 });
+
+      const result = store.merge('feature');
+      expect(result.applied).toBe(false);
+      expect(result.conflicts).toHaveLength(1);
+      expect(result.conflicts[0]).toMatchObject({
+        documentId: 'doc1',
+        path: 'a',
+        base: 1,
+        ours: 3,
+        theirs: 2,
+      });
+      expect(store.get('doc1')).toEqual({ a: 3 });
+    });
+
+    it('merges nested objects structurally', () => {
+      store.create('doc1', { x: { a: 1, b: 2 }, y: 0 });
+      store.createBranch('feature');
+      store.switchBranch('feature');
+      store.update('doc1', { x: { a: 10, b: 2 }, y: 0 });
+
+      store.switchBranch('main');
+      store.update('doc1', { x: { a: 1, b: 20 }, y: 0 });
+
+      const result = store.merge('feature');
+      expect(result.applied).toBe(true);
+      expect(store.get('doc1')).toEqual({ x: { a: 10, b: 20 }, y: 0 });
+    });
+
+    it('reports conflicts at correct nested paths', () => {
+      store.create('doc1', { x: { a: 1 } });
+      store.createBranch('feature');
+      store.switchBranch('feature');
+      store.update('doc1', { x: { a: 2 } });
+
+      store.switchBranch('main');
+      store.update('doc1', { x: { a: 3 } });
+
+      const result = store.merge('feature');
+      expect(result.conflicts[0].path).toBe('x.a');
+      expect(result.applied).toBe(false);
+    });
+
+    it('treats arrays as leaves', () => {
+      store.create('doc1', { items: [1, 2] });
+      store.createBranch('feature');
+      store.switchBranch('feature');
+      store.update('doc1', { items: [1, 2, 3] });
+
+      store.switchBranch('main');
+      store.update('doc1', { items: [1, 3] });
+
+      const result = store.merge('feature');
+      expect(result.applied).toBe(false);
+      expect(result.conflicts[0].path).toBe('items');
+      expect(result.conflicts[0].base).toEqual([1, 2]);
+    });
+
+    it('merges new and deleted documents', () => {
+      store.create('doc1', { a: 1 });
+      store.create('doc2', { b: 1 });
+      store.createBranch('feature');
+      store.switchBranch('feature');
+      store.delete('doc2');
+      store.create('doc3', { c: 1 });
+
+      store.switchBranch('main');
+      const result = store.merge('feature');
+      expect(result.applied).toBe(true);
+      expect(store.get('doc1')).toEqual({ a: 1 });
+      expect(() => store.get('doc2')).toThrow();
+      expect(store.get('doc3')).toEqual({ c: 1 });
+    });
+
+    it('merges multiple documents independently', () => {
+      store.create('doc1', { a: 1 });
+      store.create('doc2', { b: 1 });
+      store.createBranch('feature');
+      store.switchBranch('feature');
+      store.update('doc1', { a: 2 });
+
+      store.switchBranch('main');
+      store.update('doc2', { b: 2 });
+
+      const result = store.merge('feature');
+      expect(result.applied).toBe(true);
+      expect(store.get('doc1')).toEqual({ a: 2 });
+      expect(store.get('doc2')).toEqual({ b: 2 });
+    });
+
+    it('handles no-op merge', () => {
+      store.create('doc1', { a: 1 });
+      store.createBranch('feature');
+      const result = store.merge('feature');
+      expect(result.applied).toBe(true);
+      expect(result.merged).toEqual({});
+      expect(result.conflicts).toHaveLength(0);
+    });
+
+    it('returns merged preview with conflicts resolved to ours', () => {
+      store.create('doc1', { a: 1 });
+      store.createBranch('feature');
+      store.switchBranch('feature');
+      store.update('doc1', { a: 2 });
+
+      store.switchBranch('main');
+      store.update('doc1', { a: 3 });
+
+      const result = store.merge('feature');
+      expect(result.merged.doc1).toEqual({ a: 3 });
+    });
+
+    it('throws merging non-existent branch', () => {
+      expect(() => store.merge('missing')).toThrow();
+    });
+  });
+});
