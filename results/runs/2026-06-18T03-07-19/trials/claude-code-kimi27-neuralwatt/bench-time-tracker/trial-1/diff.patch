+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'fs';
+import { dirname } from 'path';
+
+export interface Entry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+export class TimeTracker {
+  private readonly filePath: string;
+
+  private entries: Entry[];
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = this.load();
+  }
+
+  private load(): Entry[] {
+    if (!existsSync(this.filePath)) {
+      return [];
+    }
+    const data = readFileSync(this.filePath, 'utf8');
+    const parsed = JSON.parse(data) as unknown;
+    if (!Array.isArray(parsed)) {
+      return [];
+    }
+    return parsed as Entry[];
+  }
+
+  private save(): void {
+    const dir = dirname(this.filePath);
+    if (!existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+    writeFileSync(this.filePath, JSON.stringify(this.entries, null, 2));
+  }
+
+  start(taskName: string): Entry {
+    if (taskName.length === 0) {
+      throw new Error('Task name cannot be empty');
+    }
+
+    this.stopActive();
+
+    const entry: Entry = {
+      taskName,
+      startTime: new Date().toISOString(),
+      endTime: null,
+    };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  stop(): Entry {
+    const active = this.getActiveTask();
+    if (active === null) {
+      throw new Error('No task is currently running');
+    }
+    active.endTime = new Date().toISOString();
+    this.save();
+    return active;
+  }
+
+  getActiveTask(): Entry | null {
+    for (let i = this.entries.length - 1; i >= 0; i -= 1) {
+      if (this.entries[i].endTime === null) {
+        return this.entries[i];
+      }
+    }
+    return null;
+  }
+
+  getLog(options?: { since?: Date }): Entry[] {
+    if (options?.since === undefined) {
+      return [...this.entries];
+    }
+
+    const since = options.since.getTime();
+    return this.entries.filter((entry) => {
+      const startTime = new Date(entry.startTime).getTime();
+      if (startTime >= since) {
+        return true;
+      }
+      if (entry.endTime === null) {
+        return true;
+      }
+      const endTime = new Date(entry.endTime).getTime();
+      return endTime >= since;
+    });
+  }
+
+  getSummary(): Record<string, number> {
+    const now = Date.now();
+    const summary: Record<string, number> = {};
+
+    for (const entry of this.entries) {
+      const start = new Date(entry.startTime).getTime();
+      const end = entry.endTime === null ? now : new Date(entry.endTime).getTime();
+      const duration = end - start;
+
+      const previous = summary[entry.taskName] ?? 0;
+      summary[entry.taskName] = previous + duration;
+    }
+
+    return summary;
+  }
+
+  private stopActive(): void {
+    const active = this.getActiveTask();
+    if (active !== null) {
+      active.endTime = new Date().toISOString();
+    }
+  }
+}
