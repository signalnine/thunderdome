id = ?\n60\t  `);\n61\t\n62\t  const invoices = stmt.all(customerId) as Invoice[];\n63\t\n64\t  const totalSpent = invoices.reduce((sum, inv) => sum + inv.total, 0);\n65\t\n66\t  return {\n67\t    customer_id: customerId,\n68\t    invoice_count: invoices.length,\n69\t    total_spent: Math.round(totalSpent * 100) / 100,\n70\t    average_invoice: invoices.length > 0\n71\t      ? Math.round((totalSpent / invoices.length) * 100) / 100\n72\t      : 0,\n73\t  };\n74\t}\n75\t\n76\t/**\n77\t * Get total revenue for a date period.\n78\t */\n79\texport function getRevenueByPeriod(\n80\t  db: Database.Database,\n81\t  start: string,\n82\t  end: string,\n83\t): { total: number; count: number } {\n84\t  const stmt = db.prepare(`\n85\t    SELECT COALESCE(SUM(total), 0) as total, COUNT(*) as count\n86\t    FROM invoices\n87\t    WHERE date >= ? AND date <= ?\n88\t  `);\n89\t\n90\t  const result = stmt.get(start, end) as { total: number; count: number };\n91\t  return {\n92\t    total: Math.round(result.total * 100) / 100,\n93\t    count: result.count,\n94\t  };\n95\t}\n96\t"}]},"parent_tool_use_id":null,"session_id":"4692e766-a30d-4a36-8570-c95f103fc1e9","uuid":"0747f4d5-1401-4977-b9bc-e58bf74e4365","timestamp":"2026-06-18T05:33:00.450Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/services/reporting.ts","content":"import type Database from 'better-sqlite3';\nimport type { Invoice, InvoiceSummary, CustomerReport } from '../models/invoice.js';\n\n/**\n * Generate a monthly revenue report for a given year.\n * Groups invoices by their UTC month and aggregates totals.\n */\nexport function getMonthlyReport(\n  db: Database.Database,\n  year: number,\n): InvoiceSummary[] {\n  const startDate = `${year}-01-01`;\n  const endDate = `${year}-12-31`;\n\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE date >= ? AND date <= ?\n    ORDER BY date ASC\n  `);\n\n  const invoices = stmt.all(startDate, endDate) as Invoice[];\n\n  // Group invoices by month