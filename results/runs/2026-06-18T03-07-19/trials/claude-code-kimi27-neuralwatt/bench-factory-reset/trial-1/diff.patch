+/**
+ * Factory Reset puzzle solvers.
+ *
+ * - solveToggle solves a binary toggle puzzle using Gaussian elimination over
+ *   GF(2).  It returns the lexicographically smallest solution with the
+ *   minimum number of button presses.
+ *
+ * - solveCounter solves a modular counter puzzle using Gaussian elimination over
+ *   GF(prime).  It returns the lexicographically smallest solution with the
+ *   minimum total number of presses.
+ */
+
+export interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+/**
+ * Solves a button-toggle puzzle.
+ *
+ * Returns a sorted list of button indices to press, or null if no solution
+ * exists.  If there are multiple candidates, returns the one with the fewest
+ * presses, and among those the lexicographically smallest list of indices.
+ */
+export function solveToggle(machine: Machine): number[] | null {
+  const n = machine.target.length;
+  const m = machine.buttons.length;
+
+  // Build augmented matrix [A | b] over GF(2).  Each column j represents button
+  // j; each row i represents light i.  The right-hand side is the target value.
+  const rows: BigIntBitset[] = [];
+  for (let i = 0; i < n; i++) {
+    let mask = 0n;
+    let rhs = false;
+    for (let j = 0; j < m; j++) {
+      if (machine.buttons[j].includes(i)) {
+        mask |= 1n << BigInt(j);
+      }
+    }
+    if (machine.target[i]) {
+      rhs = true;
+    }
+    rows.push(new BigIntBitset(mask, rhs));
+  }
+
+  // Perform Gaussian elimination while keeping track of which original columns
+  // each row represents.
+  const pivotCol: number[] = [];
+  let r = 0;
+  for (let c = 0; c < m && r < n; c++) {
+    let pivot = -1;
+    for (let i = r; i < n; i++) {
+      if (rows[i].get(c)) {
+        pivot = i;
+        break;
+      }
+    }
+    if (pivot === -1) {
+      continue;
+    }
+    [rows[r], rows[pivot]] = [rows[pivot], rows[r]];
+    pivotCol.push(c);
+    for (let i = 0; i < n; i++) {
+      if (i !== r && rows[i].get(c)) {
+        rows[i].xor(rows[r]);
+      }
+    }
+    r++;
+  }
+
+  // Check for inconsistency: a row with all-zero coefficients but rhs=1.
+  for (let i = r; i < n; i++) {
+    if (rows[i].isAllZero() && rows[i].rhs) {
+      return null;
+    }
+  }
+
+  // Now the matrix is in reduced row-echelon form.  Each pivot column has
+  // exactly one row with a 1.  We derive the free variables and pivot values
+  // expressed as a constant XOR combination of free variables.
+  const rank = r;
+  const isPivot = new Set<number>(pivotCol);
+  const freeCols: number[] = [];
+  for (let c = 0; c < m; c++) {
+    if (!isPivot.has(c)) {
+      freeCols.push(c);
+    }
+  }
+
+  // For each pivot row, rhs is constant plus XOR of free columns present.
+  // We enumerate assignments to free variables to find the minimum-weight
+  // lexicographically-smallest solution.
+  //
+  // Because m can be up to 40, we split free variables in half and use a
+  // meet-in-the-middle technique with weight tracking.  This gives an
+  // O(2^{m/2}) search.
+  const mid = Math.floor(freeCols.length / 2);
+  const freeA = freeCols.slice(0, mid);
+  const freeB = freeCols.slice(mid);
+
+  // Precompute per-row masks for the two halves of free columns.
+  const rowMaskA = rows.slice(0, rank).map((row) => computeMask(row, freeA));
+  const rowMaskB = rows.slice(0, rank).map((row) => computeMask(row, freeB));
+  const rowConst = rows.slice(0, rank).map((row) => (row.rhs ? 1 : 0));
+
+  // We need (rowConst[i] ^ parity(rowMaskA[i] & x) ^ parity(rowMaskB[i] & y))
+  // to equal 0 for every pivot row i (because pivot variable's final value is
+  // exactly this expression; it must be 0 or 1, which is always valid since
+  // we're over GF(2)).  Wait: over GF(2) any value is allowed, which is
+  // confirmed just by this expression.  So every (x, y) is a solution; we just
+  // need to find the one minimizing total weight and then lexicographic order.
+
+  // To prune, we group pivot rows by their rowMaskA to derive constraints on
+  // y for a given x:
+  //   parity(rowMaskB[i] & y) = rowConst[i] ^ parity(rowMaskA[i] & x).
+  // If we map rows by rowMaskB and store vectors of required rhs, we can look
+  // up compatible y's quickly.  Use a Map keyed by the required RHS pattern.
+  //
+  // Number of pivot rows = rank <= min(n, m) <= 40.  Represent the aggregated
+  // constraint as a BigInt as well.
+  //
+  // Constraint key for y: for rows with the same rowMaskB, the required
+  // parity of rowMaskA[x] XOR const must match.
+  //
+  // Actually, we iterate over all x (freeA assignments).  For each x, we
+  // compute the desired pattern d (length rank): d_i = const_i XOR parity(A_i & x).
+  // We need a y such that parity(B_i & y) = d_i for all i.  Build a map from
+  // B_i grouping to d, and look up y's.
+
+  // Map from y assignment (freeB mask) to the resulting parity vector of all
+  // pivot rows.
+  type YEntry = {
+    mask: number; // freeB bits
+    parityVec: BigInt;
+    weight: number;
+  };
+  const yEntries: YEntry[] = [];
+  const yMap = new Map<string, number[]>();
+  const totalB = 1 << freeB.length;
+  for (let y = 0; y < totalB; y++) {
+    let parity = 0n;
+    for (let i = 0; i < rank; i++) {
+      if (parityOf(rowMaskB[i] & y) !== 0) {
+        parity |= 1n << BigInt(i);
+      }
+    }
+    const key = parity.toString(2).padStart(rank, "0");
+    let list = yMap.get(key);
+    if (!list) {
+      list = [];
+      yMap.set(key, list);
+    }
+    list.push(y);
+  }
+
+  // For each x (freeA assignment), find the compatible y with minimal weight
+  // and lexicographically-smallest assignment.
+  let best: { buttons: number[]; weight: number } | null = null;
+  const totalA = 1 << freeA.length;
+  for (let x = 0; x < totalA; x++) {
+    let d = 0n;
+    for (let i = 0; i < rank; i++) {
+      const desired = rowConst[i] ^ parityOf(rowMaskA[i] & x);
+      if (desired !== 0) {
+        d |= 1n << BigInt(i);
+      }
+    }
+    const key = d.toString(2).padStart(rank, "0");
+    const candidates = yMap.get(key);
+    if (!candidates) {
+      continue;
+    }
+    const xWeight = popcount(x);
+    for (const y of candidates) {
+      const weight = xWeight + popcount(y);
+      const buttons = buildSolution(
+        m,
+        rank,
+        rows,
+        pivotCol,
+        freeA,
+        freeB,
+        x,
+        y
+      );
+      if (
+        !best ||
+        weight < best.weight ||
+        (weight === best.weight && lexLess(buttons, best.buttons))
+      ) {
+        best = { buttons, weight };
+      }
+    }
+  }
+
+  return best ? best.buttons : null;
+}
+
+function computeMask(row: BigIntBitset, cols: number[]): number {
+  let mask = 0;
+  cols.forEach((c, idx) => {
+    if (row.get(c)) {
+      mask |= 1 << idx;
+    }
+  });
+  return mask;
+}
+
+function parityOf(n: number): number {
+  n ^= n >>> 16;
+  n ^= n >>> 8;
+  n ^= n >>> 4;
+  n ^= n >>> 2;
+  n ^= n >>> 1;
+  return n & 1;
+}
+
+function popcount(n: number): number {
+  n = n - ((n >>> 1) & 0x55555555);
+  n = (n & 0x33333333) + ((n >>> 2) & 0x33333333);
+  return ((n + (n >>> 4) & 0x0f0f0f0f) * 0x01010101) >>> 24;
+}
+
+function lexLess(a: number[], b: number[]): boolean {
+  const len = Math.min(a.length, b.length);
+  for (let i = 0; i < len; i++) {
+    if (a[i] !== b[i]) {
+      return a[i] < b[i];
+    }
+  }
+  return a.length < b.length;
+}
+
+function buildSolution(
+  m: number,
+  rank: number,
+  rows: BigIntBitset[],
+  pivotCol: number[],
+  freeA: number[],
+  freeB: number[],
+  xMask: number,
+  yMask: number
+): number[] {
+  const pressed = new Set<number>();
+  for (let j = 0; j < freeA.length; j++) {
+    if ((xMask >>> j) & 1) {
+      pressed.add(freeA[j]);
+    }
+  }
+  for (let j = 0; j < freeB.length; j++) {
+    if ((yMask >>> j) & 1) {
+      pressed.add(freeB[j]);
+    }
+  }
+  for (let i = 0; i < rank; i++) {
+    let value = rows[i].rhs ? 1 : 0;
+    for (let j = 0; j < freeA.length; j++) {
+      if ((xMask >>> j) & 1) {
+        if (rows[i].get(freeA[j])) {
+          value ^= 1;
+        }
+      }
+    }
+    for (let j = 0; j < freeB.length; j++) {
+      if ((yMask >>> j) & 1) {
+        if (rows[i].get(freeB[j])) {
+          value ^= 1;
+        }
+      }
+    }
+    if (value === 1) {
+      pressed.add(pivotCol[i]);
+    }
+  }
+  return Array.from(pressed).sort((a, b) => a - b);
+}
+
+class BigIntBitset {
+  constructor(
+    public mask: bigint,
+    public rhs: boolean
+  ) {}
+
+  get(index: number): boolean {
+    return (this.mask >> BigInt(index)) !== 0n;
+  }
+
+  xor(other: BigIntBitset): void {
+    this.mask ^= other.mask;
+    this.rhs = this.rhs !== other.rhs;
+  }
+
+  isAllZero(): boolean {
+    return this.mask === 0n;
+  }
+}
+
+/**
+ * Solves a modular counter puzzle with a prime modulus.
+ *
+ * Returns an array of press counts (0..modulus-1) for each button, or null if
+ * no solution exists.  If multiple solutions exist, returns the one with the
+ * minimum total presses, breaking ties in lexicographic order.
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): number[] | null {
+  const n = lights.length;
+  const m = buttons.length;
+
+  // Build augmented matrix over GF(modulus).
+  const aug: number[][] = [];
+  for (let i = 0; i < n; i++) {
+    const row: number[] = [];
+    for (let j = 0; j < m; j++) {
+      row.push(mod(buttons[j].filter((idx) => idx === i).length, modulus));
+    }
+    row.push(mod(lights[i], modulus));
+    aug.push(row);
+  }
+
+  const { rank, pivotCols } = gaussPrime(aug, n, m, modulus);
+
+  // Check for inconsistency.
+  for (let i = rank; i < n; i++) {
+    let allZero = true;
+    for (let j = 0; j < m; j++) {
+      if (aug[i][j] !== 0) {
+        allZero = false;
+        break;
+      }
+    }
+    if (allZero && aug[i][m] !== 0) {
+      return null;
+    }
+  }
+
+  // Express pivot variables in terms of free variables:
+  //   x_pivot[i] = const[i] - sum_{k free} aug[i][k] * x_k   (mod modulus)
+  const isPivot = new Set<number>(pivotCols);
+  const freeCols: number[] = [];
+  for (let c = 0; c < m; c++) {
+    if (!isPivot.has(c)) {
+      freeCols.push(c);
+    }
+  }
+
+  const consts: number[] = [];
+  const coeffs: number[][] = [];
+  for (let i = 0; i < rank; i++) {
+    consts.push(aug[i][m]);
+    const coeff: number[] = [];
+    for (const f of freeCols) {
+      coeff.push(mod(-aug[i][f], modulus));
+    }
+    coeffs.push(coeff);
+  }
+
+  // If there are no free variables, there is a unique solution.
+  if (freeCols.length === 0) {
+    const sol = new Array<number>(m).fill(0);
+    for (let i = 0; i < rank; i++) {
+      sol[pivotCols[i]] = mod(consts[i], modulus);
+    }
+    if (valid(sol, lights, buttons, modulus)) {
+      return sol;
+    }
+    return null;
+  }
+
+  // Enumerate all assignments to free variables (m <= 40) with meet-in-the-
+  // middle.  For each pivot row i:
+  //   x_pivot[i] = consts[i] + sum_{free} coeffs[i][freeIndex] * x_free
+  // We need the resulting vector of x_pivot values and optimize total presses.
+
+  // Split free variables.
+  const mid = Math.floor(freeCols.length / 2);
+  const freeA = freeCols.slice(0, mid);
+  const freeB = freeCols.slice(mid);
+
+  // Evaluate an assignment to a group of free variables: returns for each pivot
+  // the contribution (mod modulus) and total press count.
+  function evaluatePart(freeList: number[], assignment: number): {
+    contr: number[];
+    presses: number;
+    values: number[];
+  } {
+    const contr = new Array<number>(rank).fill(0);
+    const values = new Array<number>(m).fill(-1);
+    let presses = 0;
+    for (let j = 0; j < freeList.length; j++) {
+      const v = Math.floor(assignment / Math.pow(modulus, j)) % modulus;
+      values[freeList[j]] = v;
+      presses += v;
+      for (let i = 0; i < rank; i++) {
+        const coeffIdx = freeCols.indexOf(freeList[j]);
+        contr[i] = mod(contr[i] + coeffs[i][coeffIdx] * v, modulus);
+      }
+    }
+    return { contr, presses, values };
+  }
+
+  // Enumerate assignments to freeB and organize by the resulting pivot-value
+  // contributions.
+  type Entry = { assignment: number; presses: number };
+  const bMap = new Map<string, Entry[]>();
+  const totalB = Math.pow(modulus, freeB.length);
+  for (let assign = 0; assign < totalB; assign++) {
+    const { contr, presses } = evaluatePart(freeB, assign);
+    const key = contr.join(",");
+    let list = bMap.get(key);
+    if (!list) {
+      list = [];
+      bMap.set(key, list);
+    }
+    list.push({ assignment: assign, presses });
+  }
+
+  // For each freeA assignment, compute required pivot contributions and search
+  // compatible freeB assignments.
+  let best: { sol: number[]; total: number } | null = null;
+  const totalA = Math.pow(modulus, freeA.length);
+  for (let assignA = 0; assignA < totalA; assignA++) {
+    const { contr: contrA, presses: pressesA, values: valuesA } = evaluatePart(
+      freeA,
+      assignA
+    );
+    const needed = contrA.map((v, i) => mod(consts[i] + v, modulus));
+    const list = bMap.get(needed.join(","));
+    if (!list) {
+      continue;
+    }
+    for (const { assignment: assignB, presses: pressesB } of list) {
+      const { values: valuesB } = evaluatePart(freeB, assignB);
+      const sol = new Array<number>(m).fill(0);
+      for (let c = 0; c < m; c++) {
+        if (valuesA[c] !== -1) {
+          sol[c] = valuesA[c];
+        } else if (valuesB[c] !== -1) {
+          sol[c] = valuesB[c];
+        }
+      }
+      for (let i = 0; i < rank; i++) {
+        let val = consts[i];
+        for (let k = 0; k < freeCols.length; k++) {
+          val = mod(val + coeffs[i][k] * sol[freeCols[k]], modulus);
+        }
+        sol[pivotCols[i]] = mod(val, modulus);
+      }
+      if (!valid(sol, lights, buttons, modulus)) {
+        continue;
+      }
+      const total = pressesA + pressesB + sol.reduce((a, b) => a + b, 0);
+      if (
+        !best ||
+        total < best.total ||
+        (total === best.total && lexArrayLess(sol, best.sol))
+      ) {
+        best = { sol, total };
+      }
+    }
+  }
+
+  return best ? best.sol : null;
+}
+
+function mod(a: number, p: number): number {
+  let r = a % p;
+  if (r < 0) r += p;
+  return r;
+}
+
+function gaussPrime(
+  aug: number[][],
+  n: number,
+  m: number,
+  p: number
+): { rank: number; pivotCols: number[] } {
+  const pivotCols: number[] = [];
+  let r = 0;
+  for (let c = 0; c < m && r < n; c++) {
+    let pivot = -1;
+    for (let i = r; i < n; i++) {
+      if (aug[i][c] !== 0) {
+        pivot = i;
+        break;
+      }
+    }
+    if (pivot === -1) {
+      continue;
+    }
+    const tmp = aug[r];
+    aug[r] = aug[pivot];
+    aug[pivot] = tmp;
+    const inv = modInverse(aug[r][c], p);
+    // Scale pivot row.
+    for (let j = c; j <= m; j++) {
+      aug[r][j] = mod(aug[r][j] * inv, p);
+    }
+    // Eliminate other rows.
+    for (let i = 0; i < n; i++) {
+      if (i !== r && aug[i][c] !== 0) {
+        const factor = aug[i][c];
+        for (let j = c; j <= m; j++) {
+          aug[i][j] = mod(aug[i][j] - factor * aug[r][j], p);
+        }
+      }
+    }
+    pivotCols.push(c);
+    r++;
+  }
+  return { rank: r, pivotCols };
+}
+
+function modInverse(a: number, p: number): number {
+  // Fermat's little theorem: a^(p-1) ≡ 1 (mod p) for prime p.
+  return modPow(a, p - 2, p);
+}
+
+function modPow(base: number, exp: number, p: number): number {
+  let result = 1;
+  let b = mod(base, p);
+  let e = exp;
+  while (e > 0) {
+    if (e & 1) {
+      result = mod(result * b, p);
+    }
+    b = mod(b * b, p);
+    e >>>= 1;
+  }
+  return result;
+}
+
+function valid(
+  sol: number[],
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): boolean {
+  const state = new Array<number>(lights.length).fill(0);
+  for (let i = 0; i < buttons.length; i++) {
+    for (const idx of buttons[i]) {
+      state[idx] = mod(state[idx] + sol[i], modulus);
+    }
+  }
+  for (let i = 0; i < lights.length; i++) {
+    if (mod(state[i], modulus) !== mod(lights[i], modulus)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+function lexArrayLess(a: number[], b: number[]): boolean {
+  const len = Math.min(a.length, b.length);
+  for (let i = 0; i < len; i++) {
+    if (a[i] !== b[i]) {
+      return a[i] < b[i];
+    }
+  }
+  return a.length < b.length;
+}
