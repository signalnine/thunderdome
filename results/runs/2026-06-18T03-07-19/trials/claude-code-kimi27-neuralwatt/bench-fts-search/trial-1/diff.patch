lt[];\n\n      res.json({ results });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  return router;\n}","newString":"  // DELETE /notes/:id - Delete note\n  router.delete('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      db.prepare('DELETE FROM notes WHERE id = ?').run(id);\n      res.status(204).send();\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  return router;\n}","originalFile":"import { Router, Request, Response, NextFunction } from 'express';\nimport Database from 'better-sqlite3';\nimport { Note, NoteInput, SearchResult, SuggestResult } from './models.js';\nimport { NotFoundError, ValidationError } from './errors.js';\n\nexport function createRoutes(db: Database.Database): Router {\n  const router = Router();\n\n  // GET /notes/search - Full-text search via SQLite FTS5\n  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const rawQuery = req.query.q as string | undefined;\n\n      if (!rawQuery || rawQuery.trim() === '') {\n        throw new ValidationError('Query parameter q is required');\n      }\n\n      // Strip surrounding whitespace and normalize internal whitespace.\n      const query = rawQuery.trim().replace(/\\s+/g, ' ');\n\n      const page = parseInt((req.query.page as string | undefined) ?? '1', 10);\n      const perPage = 20;\n      const offset = (page - 1) * perPage;\n\n      // Use the rank function for BM25 relevance scoring, and the snippet\n      // function for highlighted excerpts. The parameters are:\n      // snippet(table, start, end, ellipsis, N) where N is the number of\n      // tokens around each match to include.\n      const searchStatement = db.prepare(`\n        SELECT\n          notes.id,\n          notes.title,\n          snippet(notes_fts, 0, '<mark>', '</mark>', '…', 10) AS snippet,\n          rank\n        FROM notes_fts\n        JOIN notes ON notes.id = notes_fts.rowid\n        WHERE notes_fts MATCH ?\n        ORDER BY rank\n        LIMIT ? OFFSET ?\n      `);\n\n      const countStatement = db.prepare(`\n        SELECT COUNT(*) AS total\n        FROM notes_fts\n        WHERE notes_fts MATCH ?\n      `);\n\n      const results = searchStatement.all(query, perPage, offset) as SearchResult[];\n      const { total } = countStatement.get(query) as { total: number };\n\n      res.json({ results, total, page, perPage });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search/suggest - Autocomplete suggestions from note titles\n  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const rawQuery = req.query.q as string | undefined;\n\n      if (!rawQuery || rawQuery.trim() === '') {\n        throw new ValidationError('Query parameter q is required');\n      }\n\n      const prefix = rawQuery.trim().replace(/\\s+/g, ' ');\n      // Build a prefix pattern safe for LIKE matching: escape % and _.\n      const likePattern = prefix.replace(/%/g, '\\\\%').replace(/_/g, '\\\\_') + '%';\n\n      // Search both title and body with FTS first to find the most relevant\n      // notes, then filter for titles whose prefix matches.\n      const suggestStatement = db.prepare(`\n        SELECT DISTINCT notes.id, notes.title\n        FROM notes_fts\n        JOIN notes ON notes.id = notes_fts.rowid\n        WHERE notes_fts MATCH ?\n          AND lower(notes.title) LIKE lower(?) ESCAPE '\\\\'\n        ORDER BY rank\n        LIMIT 5\n      `);\n\n      // Treat the input as a prefix query: \"word*\" matches terms starting\n      // with \"word\" in FTS5.\n      const ftsQuery = prefix + '*';\n      const results = suggestStatement.all(ftsQuery, likePattern) as SuggestResult[];\n\n      res.j