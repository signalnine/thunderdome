n    BEGIN\n      UPDATE notes_fts\n      SET title = new.title, body = new.body\n      WHERE rowid = new.id;\n    END;\n\n    CREATE TRIGGER IF NOT EXISTS notes_fts_delete\n    AFTER DELETE ON notes\n    BEGIN\n      DELETE FROM notes_fts WHERE rowid = old.id;\n    END;\n  `);\n\n  return db;\n}"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":35279,"output_tokens":0,"cache_read_input_tokens":0,"cache_creation_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"26052f60-d5aa-4508-8ce2-59300754660f","uuid":"f3206255-7f99-4273-ba23-72c6b8308825"}
