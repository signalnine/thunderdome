ECT COUNT(*) AS total\n        FROM notes_fts\n        WHERE notes_fts MATCH ?\n      `);\n\n      const results = searchStatement.all(query, perPage, offset) as SearchResult[];\n      const { total } = countStatement.get(query) as { total: number };\n\n      res.json({ results, total, page, perPage });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search/suggest - Autocomplete suggestions from note titles\n  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const rawQuery = req.query.q as string | undefined;\n\n      if (!rawQuery || rawQuery.trim() === '') {\n        throw new ValidationError('Query parameter q is required');\n      }\n\n      const prefix = rawQuery.trim().replace(/\\s+/g, ' ');\n      // Build a prefix pattern safe for LIKE matching: escape % and _.\n      const likePattern = prefix.replace(/%/g, '\\\\%').replace(/_/g, '\\\\_') + '%';\n\n      // Search both title and body with FTS first to find the most relevant\n      // notes, then filter for titles whose prefix matches.\n      const suggestStatement = db.prepare(`\n        SELECT DISTINCT notes.id, notes.title\n        FROM notes_fts\n        JOIN notes ON notes.id = notes_fts.rowid\n        WHERE notes_fts MATCH ?\n          AND lower(notes.title) LIKE lower(?) ESCAPE '\\\\'\n        ORDER BY rank\n        LIMIT 5\n      `);\n\n      // Treat the input as a prefix query: \"word*\" matches terms starting\n      // with \"word\" in FTS5.\n      const ftsQuery = prefix + '*';\n      const results = suggestStatement.all(ftsQuery, likePattern) as SuggestResult[];\n\n      res.json({ results });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes - List all notes (with optional tag filter)\n  router.get('/notes', (req: Request, res: Response, next: NextFunction) => {","originalFile":"import { Router, Request, Response, NextFunction } from 'express';\nimport Database from 'better-sqlite3';\nimport { Note, NoteInput, SearchResult, SuggestResult } from './models.js';\nimport { NotFoundError, ValidationError } from './errors.js';\n\nexport function createRoutes(db: Database.Database): Router {\n  const router = Router();\n\n  // GET /notes - List all notes (with optional tag filter)\n  router.get('/notes', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const tag = req.query.tag as string | undefined;\n\n      let notes: Note[];\n      if (tag) {\n        // Use a join with json_each for tag filtering\n        const tagStmt = db.prepare(`\n          SELECT DISTINCT notes.* FROM notes, json_each(notes.tags)\n          WHERE json_each.value = ?\n          ORDER BY created_at DESC\n        `);\n        notes = tagStmt.all(tag) as Note[];\n      } else {\n        const stmt = db.prepare('SELECT * FROM notes ORDER BY created_at DESC');\n        notes = stmt.all() as Note[];\n      }\n\n      res.json({ notes });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/:id - Get single note\n  router.get('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const stmt = db.prepare('SELECT * FROM notes WHERE id = ?');\n      const note = stmt.get(id) as Note | undefined;\n\n      if (!note) {\n        throw new NotFoundError('Note not found');\n      }\n\n      res.json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // POST /notes - Create note\n  router.post('/notes', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const input = req.body as NoteInput;\n\n      if (!input.title || input.title.trim() === '') {\n        throw new ValidationError('Title is required');\n      }\n      if (!input.body || input.body.trim() === '') {\n        throw new ValidationError('Body is required');\n      }\n\n      const tags = input.tags ? JSON.stringify(input.tags) : '[]';\n      const stmt = db.prepare(`\n        INSERT INTO notes (title, body, tags) VALUES (?, ?, ?)\n      `);\n      const result = stmt.run(input.title, input.body, tags);\n\n      const note = db.prepare('SELECT * FROM notes WHERE id = ?').get(result.lastInsertRowid) as Note;\n      res.status(201).json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // PUT /notes/:id - Update note\n  router.put('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      const input = req.body as Partial<NoteInput>;\n      const title = input.title ?? existing.title;\n      const body = input.body ?? existing.body;\n      const tags = input.tags ? JSON.stringify(input.tags) : existing.tags;\n\n      const stmt = db.prepare(`\n        UPDATE notes SET title = ?, body = ?, tags = ?, updated_at = datetime('now')\n        WHERE id = ?\n      `);\n      stmt.run(title, body, tags, id);\n\n      const note = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note;\n      res.json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // DELETE /notes/:id - Delete note\n  router.delete('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      db.prepare('DELETE FROM notes WHERE id = ?').run(id);\n      res.status(204).send();\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search - Full-text search via SQLite FTS5\n  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const rawQuery = req.query.q as string | undefined;\n\n      if (!rawQuery || rawQuery.trim() === '') {\n        throw new ValidationError('Query parameter q is required');\n      }\n\n      // Strip surrounding whitespace and normalize internal whitespace.\n      const query = rawQuery.trim().replace(/\\s+/g, ' ');\n\n      const page = parseInt((req.query.page as string | undefined) ?? '1', 10);\n      const perPage = 20;\n      const offset = (page - 1) * perPage;\n\n      // Use the rank function for BM25 relevance scoring, and the snippet\n      // function for highlighted excerpts. The parameters are:\n      // snippet(table, start, end, ellipsis, N) where N is the number of\n      // tokens around each match to include.\n      const searchStatement = db.prepare(`\n        SELECT\n          notes.id,\n          notes.title,\n          snippet(notes_fts, 0, '<mark>', '</mark>', '…', 10) AS snippet,\n          rank\n        FROM notes_fts\n        JOIN notes ON notes.id = notes_fts.rowid\n        WHERE notes_fts MATCH ?\n        ORDER BY rank\n        LIMIT ? OFFSET ?\n      `);\n\n      const countStatement = db.prepare(`\n        SELECT COUNT(*) AS total\n        FROM notes_fts\n        WHERE notes_fts MATCH ?\n      `);\n\n      const results = searchStatement.all(query, perPage, offset) as SearchResult[];\n      const { total } = countStatement.get(query) as { total: number };\n\n      res.json({ results, total, page, perPage });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search/suggest - Autocomplete suggestions from note titles\n  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const rawQuery = req.query.q as string | undefined;\n\n      if (!rawQuery || rawQuery.trim() === '') {\n        throw new ValidationError('Query parameter q is required');\n      }\n\n      const prefix = rawQuery.trim().replace(/\\s+/g, ' ');\n      // Build a prefix pattern safe for LIKE matching: escape % and _.\n      const likePatt