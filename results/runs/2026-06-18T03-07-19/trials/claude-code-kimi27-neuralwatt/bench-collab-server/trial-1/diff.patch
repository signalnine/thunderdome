ntId, client);\n\n    db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(\n      clientId,\n      documentId\n    );\n\n    send<SyncMessage>(ws, { type: 'sync', content: room.content, version: room.version });\n\n    ws.on('message', (data: RawData) => {\n      let msg: IncomingMessage;\n      try {\n        msg = JSON.parse(data.toString()) as IncomingMessage;\n      } catch (err) {\n        send<ErrorMessage>(ws, { type: 'error', message: 'Malformed JSON message' });\n        return;\n      }\n\n      if (msg.type !== 'operation') {\n        send<ErrorMessage>(ws, { type: 'error', message: 'Unknown message type' });\n        return;\n      }\n\n      const operation = msg.operation as Operation;\n      try {\n        validateOperation(operation, room.content.length);\n      } catch (err) {\n        send<ErrorMessage>(ws, {\n          type: 'error',\n          message: err instanceof Error ? err.message : 'Invalid operation',\n        });\n        return;\n      }\n\n      // Transform against operations that the client has not yet seen.\n      let transformedOp = operation;\n      if (typeof msg.version === 'number' && msg.version < room.version) {\n        const missed = db\n          .prepare(\n            'SELECT operation FROM versions WHERE document_id = ? AND version > ? AND operation IS NOT NULL ORDER BY version ASC'\n          )\n          .all(documentId, msg.version) as { operation: string }[];\n\n        for (const row of missed) {\n          const missedOp = JSON.parse(row.operation) as Operation;\n          transformedOp = transformOperation(transformedOp, missedOp);\n        }\n      }\n\n      const version = applyAndStore(room, documentId, transformedOp);\n\n      send<AckMessage>(ws, { type: 'ack', version });\n      broadcast(room, clientId, { type: 'operation', operation: transformedOp, version });\n    });\n\n    ws.on('close', () => {\n      room.clients.delete(clientId);\n      db.prepare('DELETE FROM active_connections WHERE id = ?').run(clientId);\n      if (room.clients.size === 0) {\n        // Keep room metadata? Persisted in DB, so safe to remove from memory.\n        rooms.delete(documentId);\n      }\n    });\n\n    ws.on('error', () => {\n      room.clients.delete(clientId);\n      db.prepare('DELETE FROM active_connections WHERE id = ?').run(clientId);\n    });\n  });\n}\n\nexport type { Room };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":37237,"output_tokens":0,"cache_read_input_tokens":0,"cache_creation_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"ffa3793e-6398-489b-89d0-7fe4dbf59614","uuid":"516b743a-2640-4f66-8e6b-37b6d2070844"}
