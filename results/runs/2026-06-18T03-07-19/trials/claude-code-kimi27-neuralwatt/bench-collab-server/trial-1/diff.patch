st, socket, head, (ws: WebSocket) => {\n      wss.emit('connection', ws, request, { documentId });\n    });\n  });\n\n  return {\n    app,\n    server,\n    wss,\n    db,\n    start(port = 0): Promise<number> {\n      return new Promise((resolve) => {\n        server.listen(port, () => {\n          resolve((server.address() as AddressInfo).port);\n        });\n      });\n    },\n    stop(): Promise<void> {\n      return new Promise((resolve) => {\n        wss.clients.forEach((ws) => ws.close());\n        wss.close(() => {\n          server.close(() => {\n            db.close();\n            resolve();\n          });\n        });\n      });\n    },\n  };\n}\n","structuredPatch":[{"oldStart":2,"oldLines":7,"newStart":2,"newLines":7,"lines":[" import { createServer, type Server as HttpServer } from 'http';"," import { WebSocketServer, type WebSocket } from 'ws';"," import type { AddressInfo } from 'net';","-import type { Database } from 'better-sqlite3';","+import Database from 'better-sqlite3';"," import { createDatabase } from './db.js';"," import { createRoutes } from './routes.js';"," import { createWebSocketManager } from './ws.js';"]}],"userModified":false,"replaceAll":false}}
