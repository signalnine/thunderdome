@@ -0,0 +1,87 @@
+import type { Operation, InsertOperation, DeleteOperation } from './models.js';
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+export function validateOperation(op: Operation, contentLength: number): void {
+  if (op.type !== 'insert' && op.type !== 'delete') {
+    throw new Error(`Invalid operation type: ${(op as Operation).type}`);
+  }
+  if (typeof op.position !== 'number' || !Number.isInteger(op.position) || op.position < 0 || op.position > contentLength) {
+    throw new Error(`Invalid position: ${op.position}`);
+  }
+  if (op.type === 'insert') {
+    if (typeof op.text !== 'string') {
+      throw new Error('Insert operation requires text string');
+    }
+  } else {
+    const count = (op as DeleteOperation).count;
+    if (typeof count !== 'number' || !Number.isInteger(count) || count < 0 || op.position + count > contentLength) {
+      throw new Error(`Invalid delete count: ${count}`);
+    }
+  }
+}
+
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    // Both insert: if op1 is after op2, shift its position by op2's text length.
+    // If at the same position, maintain order by treating op1 as after op2
+    // (op2 is applied first, then op1).
+    if (op1.position > op2.position || (op1.position === op2.position)) {
+      return { ...op1, position: op1.position + op2.text.length };
+    }
+    return op1;
+  }
+
+  if (op1.type === 'delete' && op2.type === 'delete') {
+    // Both delete: shrink/adjust op1's range based on op2.
+    const op1End = op1.position + op1.count;
+    const op2End = op2.position + op2.count;
+
+    if (op1.position >= op2End) {
+      // op1 is entirely after op2, shift left by op2's deleted count.
+      return { ...op1, position: op1.position - op2.count };
+    }
+    if (op1End <= op2.position) {
+      // op1 is entirely before op2, unchanged.
+      return op1;
+    }
+
+    // Overlapping deletes: subtract the overlap from op1's count and adjust position.
+    const overlapStart = Math.max(op1.position, op2.position);
+    const overlapEnd = Math.min(op1End, op2End);
+    const overlapCount = overlapEnd - overlapStart;
+
+    let newPosition = op1.position;
+    if (op1.position > op2.position) {
+      newPosition = op2.position;
+    }
+
+    return { ...op1, position: newPosition, count: op1.count - overlapCount };
+  }
+
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    // If op1 inserts at or after the deleted range, shift left by the deleted count.
+    const op2End = op2.position + op2.count;
+    if (op1.position >= op2End) {
+      return { ...op1, position: op1.position - op2.count };
+    }
+    // If op1 inserts inside the deleted range, it gets pushed to the deletion start.
+    if (op1.position > op2.position) {
+      return { ...op1, position: op2.position };
+    }
+    return op1;
+  }
+
+  // op1.type === 'delete' && op2.type === 'insert'
+  // Shift op1's position right by the inserted text length.
+  const insertOp2 = op2 as InsertOperation;
+  if (op1.position >= insertOp2.position) {
+    return { ...op1, position: op1.position + insertOp2.text.length };
+  }
+  return op1;
+}
