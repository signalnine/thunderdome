ocumentId,\n        clients: new Map<string, Client>(),\n        version: maxVersion.version ?? 0,\n        content: row.content,\n      });\n    }\n    return rooms.get(documentId);\n  }\n\n  function send<T extends { type: string }>(ws: WebSocket, msg: T): void {\n    if (ws.readyState === WebSocket.OPEN) {\n      ws.send(JSON.stringify(msg));\n    }\n  }\n\n  function broadcast(room: Room, senderId: string, msg: OperationMessage): void {\n    for (const client of room.clients.values()) {\n      if (client.id !== senderId) {\n        send(client.ws, msg);\n      }\n    }\n  }\n\n  function ensureVersions(documentId: string, room: Room): void {\n    const dbVersion = db\n      .prepare('SELECT MAX(version) as version FROM versions WHERE document_id = ?')\n      .get(documentId) as { version: number | null };\n    room.version = dbVersion.version ?? 0;\n\n    const dbContent = db\n      .prepare('SELECT content FROM documents WHERE id = ?')\n      .get(documentId) as { content: string };\n    room.content = dbContent.content;\n  }\n\n  function applyAndStore(room: Room, documentId: string, operation: Operation): number {\n    const newContent = applyOperation(room.content, operation);\n    const nextVersion = room.version + 1;\n\n    db.prepare('UPDATE documents SET content = ?, updated_at = ? WHERE id = ?').run(\n      newContent,\n      new Date().toISOString(),\n      documentId\n    );\n    db.prepare(\n      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'\n    ).run(documentId, nextVersion, newContent, JSON.stringify(operation));\n\n    room.content = newContent;\n    room.version = nextVersion;\n    return nextVersion;\n  }\n\n  wss.on('connection', (ws: WebSocket, _req: Request, params?: { documentId: string }) => {\n    const documentId = params?.documentId;\n    if (!documentId) {\n      send<ErrorMessage>(ws, { type: 'error', message: 'Document id required' });\n      ws.close();\n      return;\n    }\n\n    const room = getRoom(documentId);\n    if (!room) {\n      send<ErrorMessage>(ws, { type: 'error', message: `Document ${documentId} not found` });\n      ws.close();\n      return;\n    }\n\n    ensureVersions(documentId, room);\n\n    const clientId = randomUUID();\n    const client: Client = { id: clientId, ws, documentId };\n    room.clients.set(clientId, client);\n\n    db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(\n      clientId,\n      documentId\n    );\n\n    send<SyncMessage>(ws, { type: 'sync', content: room.content, version: room.version });\n\n    ws.on('message', (data: RawData) => {\n      let msg: IncomingMessage;\n      try {\n        msg = JSON.parse(data.toString()) as IncomingMessage;\n      } catch (err) {\n        send<ErrorMessage>(ws, { type: 'error', message: 'Malformed JSON message' });\n        return;\n      }\n\n      if (msg.type !== 'operation') {\n        send<ErrorMessage>(ws, { type: 'error', message: 'Unknown message type' });\n        return;\n      }\n\n      const operation = msg.operation as Operation;\n      try {\n        validateOperation(operation, room.content.length);\n      } catch (err) {\n        send<ErrorMessage>(ws, {\n          type: 'error',\n          message: err instanceof Error ? err.message : 'Invalid operation',\n        });\n        return;\n      }\n\n      // Transform against operations that the client has not yet seen.\n      let transformedOp = operation;\n      if (typeof msg.version === 'number' && msg.version < room.version) {\n        const missed = db\n          .prepare(\n            'SELECT operation FROM versions WHERE document_id = ? AND version > ? AND operation IS NOT NULL ORDER BY version ASC'\n          )\n          .all(documentId, msg.version) as { operation: string }[];\n\n        for (const row of missed) {\n          const missedOp = JSON.parse(row.operation) as Operation;\n          transformedOp = transformOperation(transformedOp, missedOp);\n        }\n   