+import { randomUUID } from 'crypto';
+import { EventBus } from '../bus.js';
+import {
+  Events,
+  OrderService,
+  OrderStatus,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+} from '../types.js';
+
+interface Order {
+  id: string;
+  userId: string;
+  cartId: string;
+  status: OrderStatus;
+  total: number;
+}
+
+const validTransitions: Partial<Record<OrderStatus, OrderStatus[]>> = {
+  [OrderStatus.PENDING]: [OrderStatus.CONFIRMED, OrderStatus.CANCELLED],
+  [OrderStatus.CONFIRMED]: [OrderStatus.SHIPPED, OrderStatus.CANCELLED],
+  [OrderStatus.SHIPPED]: [OrderStatus.DELIVERED],
+};
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, Order>();
+
+  return {
+    createOrder(userId: string, cartId: string, total: number): string {
+      const id = randomUUID();
+      const order: Order = {
+        id,
+        userId,
+        cartId,
+        status: OrderStatus.PENDING,
+        total,
+      };
+      orders.set(id, order);
+
+      const event: OrderCreatedEvent = { orderId: id, userId, cartId, total };
+      bus.emit(Events.ORDER_CREATED, event).catch(() => {});
+
+      return id;
+    },
+
+    getOrder(orderId: string) {
+      const order = orders.get(orderId);
+      return order ? { id: order.id, userId: order.userId, status: order.status, total: order.total } : null;
+    },
+
+    updateStatus(orderId: string, status: OrderStatus): void {
+      const order = orders.get(orderId);
+      if (!order) return;
+
+      const allowed = validTransitions[order.status] ?? [];
+      if (!allowed.includes(status)) return;
+
+      const previousStatus = order.status;
+      order.status = status;
+
+      const event: OrderStatusChangedEvent = {
+        orderId,
+        status,
+        previousStatus,
+      };
+      bus.emit(Events.ORDER_STATUS_CHANGED, event).catch(() => {});
+    },
+
+    listOrders(userId: string) {
+      return Array.from(orders.values())
+        .filter(order => order.userId === userId)
+        .map(order => ({ id: order.id, status: order.status, total: order.total }));
+    },
+  };
+}
