+++ b/src/payment/index.ts
@@ -0,0 +1,70 @@
+import { randomUUID } from 'crypto';
+import { EventBus } from '../bus.js';
+import { Events, PaymentService, PaymentStatus, PaymentProcessedEvent, PaymentServiceOptions } from '../types.js';
+
+interface Transaction {
+  transactionId: string;
+  orderId: string;
+  amount: number;
+  status: PaymentStatus;
+}
+
+export function createPaymentService(
+  bus: EventBus,
+  options: PaymentServiceOptions = {}
+): PaymentService {
+  const transactions = new Map<string, Transaction>();
+  const { simulateFailure = false, simulateTimeout = false, delayMs = 100 } = options;
+
+  return {
+    async processPayment(orderId: string, amount: number) {
+      let status: PaymentStatus;
+      let transactionId: string | undefined;
+      let error: string | undefined;
+
+      if (simulateTimeout) {
+        await new Promise(resolve => setTimeout(resolve, delayMs));
+        status = PaymentStatus.TIMEOUT;
+        error = 'Payment gateway timeout';
+      } else if (simulateFailure) {
+        await new Promise(resolve => setTimeout(resolve, delayMs));
+        status = PaymentStatus.FAILED;
+        error = 'Payment declined';
+      } else {
+        await new Promise(resolve => setTimeout(resolve, delayMs));
+        status = PaymentStatus.SUCCESS;
+        transactionId = randomUUID();
+        transactions.set(transactionId, {
+          transactionId,
+          orderId,
+          amount,
+          status,
+        });
+      }
+
+      const event: PaymentProcessedEvent = { orderId, status, transactionId, error };
+      await bus.emit(Events.PAYMENT_PROCESSED, event);
+
+      return { status, transactionId, error };
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      const transaction = transactions.get(transactionId);
+      if (!transaction || transaction.status !== PaymentStatus.SUCCESS) {
+        return false;
+      }
+
+      transaction.status = PaymentStatus.FAILED;
+
+      const event: PaymentProcessedEvent = {
+        orderId: transaction.orderId,
+        status: PaymentStatus.FAILED,
+        transactionId,
+        error: 'Refund processed',
+      };
+      await bus.emit(Events.PAYMENT_PROCESSED, event);
+
+      return true;
+    },
+  };
+}
