@@ -0,0 +1,72 @@
+import { EventBus } from '../bus.js';
+import { Events, InventoryService, InventoryUpdatedEvent, LowStockAlertEvent } from '../types.js';
+
+export function createInventoryService(bus: EventBus): InventoryService {
+  const stock = new Map<string, number>();
+  const thresholds = new Map<string, number>();
+
+  function emitUpdate(productId: string, quantity: number) {
+    const event: InventoryUpdatedEvent = { productId, quantity };
+    bus.emit(Events.INVENTORY_UPDATED, event).catch(() => {});
+  }
+
+  function emitLowStock(productId: string, currentQuantity: number) {
+    const threshold = thresholds.get(productId);
+    if (threshold === undefined) return;
+    const event: LowStockAlertEvent = { productId, currentQuantity, threshold };
+    bus.emit(Events.LOW_STOCK_ALERT, event).catch(() => {});
+  }
+
+  return {
+    setStock(productId: string, quantity: number): void {
+      stock.set(productId, quantity);
+      emitUpdate(productId, quantity);
+
+      const threshold = thresholds.get(productId);
+      if (threshold !== undefined && quantity <= threshold) {
+        emitLowStock(productId, quantity);
+      }
+    },
+
+    getStock(productId: string): number {
+      return stock.get(productId) ?? 0;
+    },
+
+    reserve(productId: string, quantity: number): boolean {
+      const current = stock.get(productId) ?? 0;
+      if (current < quantity) return false;
+
+      const updated = current - quantity;
+      stock.set(productId, updated);
+      emitUpdate(productId, updated);
+
+      const threshold = thresholds.get(productId);
+      if (threshold !== undefined && updated <= threshold) {
+        emitLowStock(productId, updated);
+      }
+
+      return true;
+    },
+
+    release(productId: string, quantity: number): void {
+      const current = stock.get(productId) ?? 0;
+      const updated = current + quantity;
+      stock.set(productId, updated);
+      emitUpdate(productId, updated);
+
+      const threshold = thresholds.get(productId);
+      if (threshold !== undefined && updated <= threshold) {
+        emitLowStock(productId, updated);
+      }
+    },
+
+    setLowStockThreshold(productId: string, threshold: number): void {
+      thresholds.set(productId, threshold);
+
+      const current = stock.get(productId) ?? 0;
+      if (current <= threshold) {
+        emitLowStock(productId, current);
+      }
+    },
+  };
+}
