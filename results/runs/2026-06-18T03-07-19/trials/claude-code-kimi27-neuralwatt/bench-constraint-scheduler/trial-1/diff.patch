@@ -0,0 +1,369 @@
+export interface Event {
+  id: string;
+  name: string;
+  duration: number;
+  attendees?: number;
+  prerequisites?: string[];
+  preferredRoom?: string;
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number;
+}
+
+export interface ScheduleOptions {
+  startTime: number;
+  endTime: number;
+  gap?: number;
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[];
+}
+
+interface Candidate {
+  roomId: string;
+  startTime: number;
+}
+
+/**
+ * Schedules events into rooms while respecting capacity, time windows,
+ * prerequisite ordering, room gaps, and preferred rooms.
+ */
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  validateInputs(events, rooms, options);
+
+  const gap = options.gap ?? 15;
+  const windowDuration = options.endTime - options.startTime;
+
+  if (events.length === 0 || rooms.length === 0) {
+    return { assignments: [], unscheduled: [] };
+  }
+
+  const eventMap = new Map<string, Event>();
+  for (const event of events) {
+    eventMap.set(event.id, event);
+  }
+
+  if (hasPrerequisiteCycle(events, eventMap)) {
+    throw new Error('Prerequisite cycle detected');
+  }
+
+  const levels = computeTopoLevels(events, eventMap);
+
+  // Precompute feasible rooms per event (capacity-wise).
+  const eligibleRooms = new Map<string, Room[]>();
+  for (const event of events) {
+    const attendees = event.attendees ?? 1;
+    eligibleRooms.set(
+      event.id,
+      rooms.filter((room) => room.capacity >= attendees),
+    );
+  }
+
+  // Sort events so prerequisites are processed before dependents, and more
+  // constrained events are considered earlier within the same level.
+  const orderedEvents = events.slice().sort((a, b) => {
+    const levelDiff = (levels.get(a.id) ?? 0) - (levels.get(b.id) ?? 0);
+    if (levelDiff !== 0) return levelDiff;
+
+    const roomsA = eligibleRooms.get(a.id)?.length ?? 0;
+    const roomsB = eligibleRooms.get(b.id)?.length ?? 0;
+    if (roomsA !== roomsB) return roomsA - roomsB;
+
+    return b.duration - a.duration;
+  });
+
+  // Track the best complete assignment found.
+  let bestAssignments = new Map<string, Assignment>();
+
+  // Timelines per room, kept sorted by start time.
+  const roomTimelines = new Map<string, Assignment[]>();
+  for (const room of rooms) {
+    roomTimelines.set(room.id, []);
+  }
+
+  function backtrack(index: number, current: Map<string, Assignment>): void {
+    if (index === orderedEvents.length) {
+      if (current.size > bestAssignments.size) {
+        bestAssignments = new Map(current);
+      }
+      return;
+    }
+
+    // Branch-and-bound: even scheduling every remaining event cannot beat best.
+    const remaining = orderedEvents.length - index;
+    if (current.size + remaining <= bestAssignments.size) {
+      return;
+    }
+
+    const event = orderedEvents[index];
+
+    // Too long to ever fit in the time window.
+    if (event.duration > windowDuration) {
+      backtrack(index + 1, current);
+      return;
+    }
+
+    const earliestFromPrereqs = earliestPrerequisiteEnd(event, current, gap);
+    const earliestStart = Math.max(options.startTime, earliestFromPrereqs);
+    const latestStart = options.endTime - event.duration;
+
+    if (earliestStart > latestStart) {
+      // Prerequisite not scheduled or window too tight; skip this event.
+      backtrack(index + 1, current);
+      return;
+    }
+
+    const candidates = generateCandidates(
+      event,
+      eligibleRooms.get(event.id) ?? [],
+      roomTimelines,
+      earliestStart,
+      latestStart,
+      gap,
+    );
+
+    // Prefer the requested room, then earlier starts.
+    candidates.sort((a, b) => {
+      const aPref = a.roomId === event.preferredRoom ? 0 : 1;
+      const bPref = b.roomId === event.preferredRoom ? 0 : 1;
+      if (aPref !== bPref) return aPref - bPref;
+      return a.startTime - b.startTime;
+    });
+
+    for (const candidate of candidates) {
+      const assignment: Assignment = {
+        eventId: event.id,
+        roomId: candidate.roomId,
+        startTime: candidate.startTime,
+        endTime: candidate.startTime + event.duration,
+      };
+
+      current.set(event.id, assignment);
+      const timeline = roomTimelines.get(candidate.roomId)!;
+      insertSorted(timeline, assignment);
+
+      backtrack(index + 1, current);
+
+      removeFromTimeline(timeline, assignment);
+      current.delete(event.id);
+    }
+
+    // Also try leaving this event unscheduled.
+    backtrack(index + 1, current);
+  }
+
+  backtrack(0, new Map());
+
+  // Preserve the original event order in the output.
+  const assignments = events
+    .map((event) => bestAssignments.get(event.id))
+    .filter((a): a is Assignment => a !== undefined);
+
+  const scheduledIds = new Set(bestAssignments.keys());
+  const unscheduled = events
+    .map((event) => event.id)
+    .filter((id) => !scheduledIds.has(id));
+
+  return { assignments, unscheduled };
+}
+
+function validateInputs(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): void {
+  if (!Array.isArray(events) || !Array.isArray(rooms) || !options) {
+    throw new Error('Invalid input');
+  }
+  if (typeof options.startTime !== 'number' || typeof options.endTime !== 'number') {
+    throw new Error('startTime and endTime must be numbers');
+  }
+  if (options.startTime >= options.endTime) {
+    throw new Error('startTime must be before endTime');
+  }
+  if (options.gap !== undefined && options.gap < 0) {
+    throw new Error('gap must be non-negative');
+  }
+
+  const eventIds = new Set(events.map((e) => e.id));
+  for (const event of events) {
+    if (!event.id || typeof event.duration !== 'number') {
+      throw new Error('Each event must have an id and numeric duration');
+    }
+    if (event.duration <= 0) {
+      throw new Error(`Event ${event.id} must have a positive duration`);
+    }
+    for (const prereq of event.prerequisites ?? []) {
+      if (!eventIds.has(prereq)) {
+        throw new Error(`Event ${event.id} references unknown prerequisite ${prereq}`);
+      }
+    }
+  }
+
+  for (const room of rooms) {
+    if (!room.id || typeof room.capacity !== 'number') {
+      throw new Error('Each room must have an id and numeric capacity');
+    }
+    if (room.capacity < 0) {
+      throw new Error(`Room ${room.id} capacity must be non-negative`);
+    }
+  }
+}
+
+function hasPrerequisiteCycle(
+  events: Event[],
+  eventMap: Map<string, Event>,
+): boolean {
+  const state = new Map<string, number>(); // 0 = unvisited, 1 = visiting, 2 = done
+
+  function dfs(eventId: string): boolean {
+    const s = state.get(eventId) ?? 0;
+    if (s === 1) return true;
+    if (s === 2) return false;
+
+    state.set(eventId, 1);
+    const event = eventMap.get(eventId);
+    if (event) {
+      for (const prereq of event.prerequisites ?? []) {
+        if (dfs(prereq)) return true;
+      }
+    }
+    state.set(eventId, 2);
+    return false;
+  }
+
+  for (const event of events) {
+    if (dfs(event.id)) return true;
+  }
+  return false;
+}
+
+function computeTopoLevels(
+  events: Event[],
+  eventMap: Map<string, Event>,
+): Map<string, number> {
+  const memo = new Map<string, number>();
+  const visiting = new Set<string>();
+
+  function level(eventId: string): number {
+    const cached = memo.get(eventId);
+    if (cached !== undefined) return cached;
+    if (visiting.has(eventId)) throw new Error('Prerequisite cycle detected');
+
+    visiting.add(eventId);
+    const event = eventMap.get(eventId)!;
+    let maxLevel = 0;
+    for (const prereq of event.prerequisites ?? []) {
+      maxLevel = Math.max(maxLevel, level(prereq) + 1);
+    }
+    visiting.delete(eventId);
+    memo.set(eventId, maxLevel);
+    return maxLevel;
+  }
+
+  for (const event of events) {
+    level(event.id);
+  }
+
+  return memo;
+}
+
+function earliestPrerequisiteEnd(
+  event: Event,
+  current: Map<string, Assignment>,
+  gap: number,
+): number {
+  let earliest = Number.NEGATIVE_INFINITY;
+  for (const prereqId of event.prerequisites ?? []) {
+    const prereqAssignment = current.get(prereqId);
+    if (!prereqAssignment) {
+      return Number.POSITIVE_INFINITY;
+    }
+    earliest = Math.max(earliest, prereqAssignment.endTime + gap);
+  }
+  return earliest;
+}
+
+function generateCandidates(
+  event: Event,
+  eligibleRooms: Room[],
+  roomTimelines: Map<string, Assignment[]>,
+  earliestStart: number,
+  latestStart: number,
+  gap: number,
+): Candidate[] {
+  const candidates: Candidate[] = [];
+
+  for (const room of eligibleRooms) {
+    const timeline = roomTimelines.get(room.id) ?? [];
+    const starts = new Set<number>();
+
+    starts.add(earliestStart);
+    for (const assignment of timeline) {
+      starts.add(assignment.endTime + gap);
+      starts.add(assignment.startTime - event.duration - gap);
+    }
+
+    for (const start of starts) {
+      if (start < earliestStart || start > latestStart) continue;
+
+      const end = start + event.duration;
+      if (end > latestStart + event.duration) continue;
+
+      let fits = true;
+      for (const assignment of timeline) {
+        if (!separated(start, end, assignment.startTime, assignment.endTime, gap)) {
+          fits = false;
+          break;
+        }
+      }
+
+      if (fits) {
+        candidates.push({ roomId: room.id, startTime: start });
+      }
+    }
+  }
+
+  return candidates;
+}
+
+function separated(
+  startA: number,
+  endA: number,
+  startB: number,
+  endB: number,
+  gap: number,
+): boolean {
+  return endA + gap <= startB || endB + gap <= startA;
+}
+
+function insertSorted(timeline: Assignment[], assignment: Assignment): void {
+  let i = 0;
+  while (i < timeline.length && timeline[i].startTime < assignment.startTime) {
+    i++;
+  }
+  timeline.splice(i, 0, assignment);
+}
+
+function removeFromTimeline(timeline: Assignment[], assignment: Assignment): void {
+  const index = timeline.indexOf(assignment);
+  if (index !== -1) {
+    timeline.splice(index, 1);
+  }
+}
