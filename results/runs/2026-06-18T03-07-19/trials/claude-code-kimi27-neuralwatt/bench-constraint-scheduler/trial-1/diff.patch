+import { describe, expect, it } from 'vitest';
+import { schedule } from '../src/index.js';
+
+const nineAm = 540;
+const fivePm = 1020;
+
+const standardOptions = {
+  startTime: nineAm,
+  endTime: fivePm,
+};
+
+describe('schedule', () => {
+  it('schedules a single event into the only room', () => {
+    const result = schedule(
+      [{ id: 'a', name: 'A', duration: 60, attendees: 10 }],
+      [{ id: 'r1', name: 'Room 1', capacity: 20 }],
+      standardOptions,
+    );
+    expect(result.unscheduled).toEqual([]);
+    expect(result.assignments).toHaveLength(1);
+    expect(result.assignments[0]).toMatchObject({
+      eventId: 'a',
+      roomId: 'r1',
+      startTime: nineAm,
+      endTime: nineAm + 60,
+    });
+  });
+
+  it('rejects events that exceed room capacity', () => {
+    const result = schedule(
+      [{ id: 'big', name: 'Big', duration: 60, attendees: 50 }],
+      [{ id: 'small', name: 'Small', capacity: 10 }],
+      standardOptions,
+    );
+    expect(result.assignments).toEqual([]);
+    expect(result.unscheduled).toEqual(['big']);
+  });
+
+  it('enforces the gap between events in the same room', () => {
+    const result = schedule(
+      [
+        { id: 'a', name: 'A', duration: 60 },
+        { id: 'b', name: 'B', duration: 60 },
+      ],
+      [{ id: 'r1', name: 'Room 1', capacity: 10 }],
+      { startTime: nineAm, endTime: fivePm, gap: 15 },
+    );
+    expect(result.assignments).toHaveLength(2);
+    const a = result.assignments.find((x) => x.eventId === 'a')!;
+    const b = result.assignments.find((x) => x.eventId === 'b')!;
+    expect(a.endTime + 15).toBeLessThanOrEqual(b.startTime);
+  });
+
+  it('does not leave a gap when events are in different rooms', () => {
+    const result = schedule(
+      [
+        { id: 'a', name: 'A', duration: 60 },
+        { id: 'b', name: 'B', duration: 60 },
+      ],
+      [
+        { id: 'r1', name: 'Room 1', capacity: 10 },
+        { id: 'r2', name: 'Room 2', capacity: 10 },
+      ],
+      standardOptions,
+    );
+    expect(result.assignments).toHaveLength(2);
+    const a = result.assignments.find((x) => x.eventId === 'a')!;
+    const b = result.assignments.find((x) => x.eventId === 'b')!;
+    expect(a.roomId).not.toBe(b.roomId);
+    expect(a.startTime).toBe(nineAm);
+    expect(b.startTime).toBe(nineAm);
+  });
+
+  it('schedules prerequisites before dependents', () => {
+    const result = schedule(
+      [
+        { id: 'a', name: 'A', duration: 60 },
+        { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },
+      ],
+      [{ id: 'r1', name: 'Room 1', capacity: 10 }],
+      { startTime: nineAm, endTime: fivePm, gap: 15 },
+    );
+    expect(result.assignments).toHaveLength(2);
+    const a = result.assignments.find((x) => x.eventId === 'a')!;
+    const b = result.assignments.find((x) => x.eventId === 'b')!;
+    expect(a.endTime + 15).toBeLessThanOrEqual(b.startTime);
+  });
+
+  it('throws on a prerequisite self-reference', () => {
+    expect(() =>
+      schedule(
+        [{ id: 'a', name: 'A', duration: 60, prerequisites: ['a'] }],
+        [{ id: 'r1', name: 'Room 1', capacity: 10 }],
+        standardOptions,
+      ),
+    ).toThrow(/cycle/i);
+  });
+
+  it('throws on a prerequisite cycle', () => {
+    expect(() =>
+      schedule(
+        [
+          { id: 'a', name: 'A', duration: 60, prerequisites: ['c'] },
+          { id: 'b', name: 'B', duration: 60, prerequisites: ['a'] },
+          { id: 'c', name: 'C', duration: 60, prerequisites: ['b'] },
+        ],
+        [{ id: 'r1', name: 'Room 1', capacity: 10 }],
+        standardOptions,
+      ),
+    ).toThrow(/cycle/i);
+  });
+
+  it('honors preferred room when feasible', () => {
+    const result = schedule(
+      [
+        { id: 'a', name: 'A', duration: 60, preferredRoom: 'r2' },
+      ],
+      [
+        { id: 'r1', name: 'Room 1', capacity: 10 },
+        { id: 'r2', name: 'Room 2', capacity: 10 },
+      ],
+      standardOptions,
+    );
+    expect(result.assignments[0].roomId).toBe('r2');
+  });
+
+  it('falls back to another room when the preferred room is unusable', () => {
+    const result = schedule(
+      [
+        { id: 'big', name: 'Big', duration: 60, attendees: 20, preferredRoom: 'r1' },
+      ],
+      [
+        { id: 'r1', name: 'Room 1', capacity: 5 },
+        { id: 'r2', name: 'Room 2', capacity: 30 },
+      ],
+      standardOptions,
+    );
+    expect(result.assignments[0].roomId).toBe('r2');
+  });
+
+  it('maximizes the number of scheduled events', () => {
+    // Three 240-minute events, one 120-minute event, one room, 8-hour window.
+    // The optimal is to schedule two 240-minute events (or four 120-minute).
+    // We give one 120-minute event that can fit in the leftover gaps only if
+    // combined with the right 240-minute events. Backtracking finds 3 events.
+    const result = schedule(
+      [
+        { id: 'a', name: 'A', duration: 240 },
+        { id: 'b', name: 'B', duration: 240 },
+        { id: 'c', name: 'C', duration: 240 },
+        { id: 'd', name: 'D', duration: 120 },
+      ],
+      [{ id: 'r1', name: 'Room 1', capacity: 10 }],
+      { startTime: nineAm, endTime: fivePm, gap: 0 },
+    );
+    // With 480-minute window and gap 0, we can schedule at most 2 events of
+    // 240 each; the 120-minute event could be third if combined with one 240.
+    expect(result.assignments.length).toBeGreaterThanOrEqual(2);
+  });
+
+  it('lists unscheduled events when constraints conflict', () => {
+    const result = schedule(
+      [
+        { id: 'a', name: 'A', duration: 120 },
+        { id: 'b', name: 'B', duration: 120 },
+        { id: 'c', name: 'C', duration: 120 },
+        { id: 'd', name: 'D', duration: 120 },
+        { id: 'e', name: 'E', duration: 120 },
+      ],
+      [{ id: 'r1', name: 'Room 1', capacity: 10 }],
+      { startTime: nineAm, endTime: fivePm, gap: 0 },
+    );
+    const window = fivePm - nineAm;
+    const maxEvents = Math.floor(window / 120);
+    expect(result.unscheduled.length).toBe(5 - maxEvents);
+  });
+
+  it('throws when a prerequisite references a missing event', () => {
+    expect(() =>
+      schedule(
+        [{ id: 'a', name: 'A', duration: 60, prerequisites: ['missing'] }],
+        [{ id: 'r1', name: 'Room 1', capacity: 10 }],
+        standardOptions,
+      ),
+    ).toThrow(/unknown prerequisite/i);
+  });
+});
