+// Simple UUID v4 generator that does not require crypto import
+function generateUUID(): string {
+  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
+    const r = (Math.random() * 16) | 0;
+    const v = c === 'x' ? r : (r & 0x3) | 0x8;
+    return v.toString(16);
+  });
+}
+
+export interface Task {
+  id: string;
+  payload: unknown;
+  status: 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';
+  createdAt: Date;
+  priority: number;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  queueName: string;
+  failCount: number;
+  lastError?: string;
+  dependsOn: string[];
+  progress: ProgressInfo | null;
+  cancelled: boolean;
+}
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: string;
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export interface ProgressCallbackInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: unknown;
+  active: boolean;
+  lastRunAt?: Date;
+}
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+export type TaskHandler = (task: Task) => Promise<void> | void;
+export type ShutdownCallback = () => void | Promise<void>;
+
+class QueueState {
+  tasks: Map<string, Task> = new Map();
+  dlq: Task[] = [];
+  concurrencyLimit: number = Infinity;
+  middlewares: Middleware[] = [];
+}
+
+export class TaskQueue {
+  private queues: Map<string, QueueState> = new Map();
+  private allTasks: Map<string, Task> = new Map();
+  private schedules: Map<string, Schedule> = new Map();
+  private progressCallbacks: Map<string, Array<(info: ProgressCallbackInfo) => void>> = new Map();
+  private shutdownCallbacks: ShutdownCallback[] = [];
+  private shuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private processingTasks: Set<string> = new Set();
+  private shutdownResolve: ((summary: ShutdownSummary) => void) | null = null;
+  private shutdownStartTime = 0;
+  private shutdownTimeout = 0;
+  private shutdownSummary: ShutdownSummary = { completed: 0, cancelled: 0, elapsed: 0 };
+
+  private getQueue(name: string, create = false): QueueState | undefined {
+    let q = this.queues.get(name);
+    if (!q && create) {
+      q = new QueueState();
+      this.queues.set(name, q);
+    }
+    return q;
+  }
+
+  enqueue(queueName: string, payload: unknown): Task;
+  enqueue(queueName: string, payload: unknown, options: EnqueueOptions): Task;
+  enqueue(payload: unknown): Task;
+  enqueue(
+    queueNameOrPayload: string | unknown,
+    payloadOrOptions?: unknown,
+    options?: EnqueueOptions,
+  ): Task {
+    if (this.shuttingDown) {
+      throw new Error('Queue is shutting down');
+    }
+
+    let queueName: string;
+    let payload: unknown;
+    let opts: EnqueueOptions = {};
+
+    if (typeof queueNameOrPayload === 'string') {
+      queueName = queueNameOrPayload;
+      if (options !== undefined) {
+        payload = payloadOrOptions;
+        opts = options;
+      } else if (payloadOrOptions !== undefined && this.isOptions(payloadOrOptions)) {
+        payload = undefined;
+        opts = payloadOrOptions;
+      } else {
+        payload = payloadOrOptions;
+      }
+    } else {
+      queueName = 'default';
+      payload = queueNameOrPayload;
+    }
+
+    if (opts.priority !== undefined && (opts.priority < 1 || opts.priority > 10)) {
+      throw new Error('Priority must be between 1 and 10');
+    }
+
+    const now = new Date();
+    let availableAt = now;
+    if (opts.delay !== undefined) {
+      availableAt = new Date(now.getTime() + opts.delay);
+    } else if (opts.runAt !== undefined) {
+      availableAt = opts.runAt;
+    }
+
+    if (opts.dependsOn) {
+      for (const depId of opts.dependsOn) {
+        if (!this.allTasks.has(depId)) {
+          throw new Error(`Dependency ${depId} does not exist`);
+        }
+      }
+      // Check for circular dependencies
+      if (this.hasCircularDependency(opts.dependsOn)) {
+        throw new Error('Circular dependency detected');
+      }
+    }
+
+    const task: Task = {
+      id: generateUUID(),
+      payload,
+      status: 'pending',
+      createdAt: now,
+      priority: opts.priority ?? 5,
+      availableAt,
+      attempts: 0,
+      maxRetries: opts.maxRetries ?? 3,
+      backoffMs: opts.backoffMs ?? 1000,
+      queueName,
+      failCount: 0,
+      lastError: undefined,
+      dependsOn: opts.dependsOn ? [...opts.dependsOn] : [],
+      progress: null,
+      cancelled: false,
+    };
+
+    const q = this.getQueue(queueName, true) as QueueState;
+    q.tasks.set(task.id, task);
+    this.allTasks.set(task.id, task);
+
+    return task;
+  }
+
+  private isOptions(value: unknown): value is EnqueueOptions {
+    if (value === null || typeof value !== 'object') return false;
+    const keys = Object.keys(value as object);
+    const optionKeys = ['priority', 'delay', 'runAt', 'maxRetries', 'backoffMs', 'dependsOn'];
+    return keys.some((k) => optionKeys.includes(k));
+  }
+
+  private hasCircularDependency(dependencyIds: string[]): boolean {
+    const visited = new Set<string>();
+    const visiting = new Set<string>();
+
+    const visit = (id: string): boolean => {
+      if (visiting.has(id)) return true;
+      if (visited.has(id)) return false;
+      const task = this.allTasks.get(id);
+      if (!task) return false;
+      visiting.add(id);
+      for (const depId of task.dependsOn) {
+        if (visit(depId)) return true;
+      }
+      visiting.delete(id);
+      visited.add(id);
+      return false;
+    };
+
+    for (const id of dependencyIds) {
+      if (visit(id)) return true;
+    }
+    return false;
+  }
+
+  dequeue(queueName?: string): Task | null {
+    const name = queueName ?? 'default';
+    const q = this.getQueue(name);
+    if (!q) return null;
+
+    const now = new Date();
+    const limit = q.concurrencyLimit;
+    const processingCount = this.getProcessingCount(q);
+    if (limit !== Infinity && processingCount >= limit) {
+      return null;
+    }
+
+    const candidates: Task[] = [];
+    for (const task of q.tasks.values()) {
+      if (task.status !== 'pending') continue;
+      if (task.cancelled) continue;
+      if (task.availableAt.getTime() > now.getTime()) continue;
+      if (!this.dependenciesMet(task)) continue;
+      candidates.push(task);
+    }
+
+    if (candidates.length === 0) return null;
+
+    candidates.sort((a, b) => {
+      const priDiff = a.priority - b.priority;
+      if (priDiff !== 0) return priDiff;
+      const timeDiff = a.availableAt.getTime() - b.availableAt.getTime();
+      if (timeDiff !== 0) return timeDiff;
+      return a.createdAt.getTime() - b.createdAt.getTime();
+    });
+
+    const chosen = candidates[0];
+    chosen.status = 'processing';
+    chosen.attempts += 1;
+    this.processingTasks.add(chosen.id);
+    return chosen;
+  }
+
+  private dependenciesMet(task: Task): boolean {
+    for (const depId of task.dependsOn) {
+      const dep = this.allTasks.get(depId);
+      if (!dep || dep.status !== 'completed') {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  size(queueName?: string): number {
+    if (queueName !== undefined) {
+      const q = this.getQueue(queueName);
+      if (!q) return 0;
+      return this.countPending(q);
+    }
+    const q = this.getQueue('default');
+    return q ? this.countPending(q) : 0;
+  }
+
+  private countPending(q: QueueState): number {
+    let count = 0;
+    for (const task of q.tasks.values()) {
+      if (task.status === 'pending' && !task.cancelled) {
+        count += 1;
+      }
+    }
+    return count;
+  }
+
+  listQueues(): string[] {
+    return Array.from(this.queues.keys());
+  }
+
+  queueSize(queueName: string): number {
+    const q = this.getQueue(queueName);
+    return q ? this.countPending(q) : 0;
+  }
+
+  complete(taskId: string): void {
+    const task = this.allTasks.get(taskId);
+    if (!task) return;
+    task.status = 'completed';
+    this.processingTasks.delete(task.id);
+    if (this.shuttingDown && this.shutdownResolve) {
+      this.shutdownSummary.completed += 1;
+      this.checkShutdownComplete();
+    }
+    this.checkDependentTasks(task);
+  }
+
+  fail(taskId: string, error?: string | Error): void {
+    const task = this.allTasks.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    task.failCount += 1;
+    task.lastError = error instanceof Error ? error.message : String(error);
+    this.processingTasks.delete(task.id);
+
+    if (task.attempts <= task.maxRetries) {
+      // Retry available: re-enqueue with backoff delay
+      const delay = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + delay);
+    } else {
+      // Exhausted retries: move to DLQ
+      task.status = 'failed';
+      const q = this.getQueue(task.queueName, true) as QueueState;
+      q.dlq.push(task);
+    }
+  }
+
+  getDLQ(queueName: string): Task[] {
+    const q = this.getQueue(queueName);
+    return q ? [...q.dlq] : [];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    for (const q of this.queues.values()) {
+      const idx = q.dlq.findIndex((t) => t.id === taskId);
+      if (idx !== -1) {
+        const task = q.dlq.splice(idx, 1)[0];
+        task.status = 'pending';
+        task.attempts = 0;
+        task.failCount = 0;
+        task.maxRetries = task.maxRetries;
+        task.availableAt = new Date();
+        task.lastError = undefined;
+        const originalQueue = this.getQueue(task.queueName, true) as QueueState;
+        originalQueue.tasks.set(task.id, task);
+        return task;
+      }
+    }
+    return null;
+  }
+
+  clearDLQ(queueName: string): void {
+    const q = this.getQueue(queueName);
+    if (q) {
+      q.dlq.length = 0;
+    }
+  }
+
+  getDependencies(taskId: string): DependencyInfo[] {
+    const task = this.allTasks.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map((depId) => {
+      const dep = this.allTasks.get(depId);
+      return { taskId: depId, status: dep ? dep.status : 'unknown' };
+    });
+  }
+
+  private checkDependentTasks(completedTask: Task): void {
+    for (const q of this.queues.values()) {
+      for (const task of q.tasks.values()) {
+        if (task.status === 'pending' && task.dependsOn.includes(completedTask.id)) {
+          // Dependencies are checked at dequeue time
+        }
+      }
+    }
+  }
+
+  setConcurrency(queueName: string, limit: number): void {
+    const q = this.getQueue(queueName, true) as QueueState;
+    q.concurrencyLimit = limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const q = this.getQueue(queueName);
+    if (!q) return { current: 0, max: Infinity };
+    return {
+      current: this.getProcessingCount(q),
+      max: q.concurrencyLimit,
+    };
+  }
+
+  private getProcessingCount(q: QueueState): number {
+    let count = 0;
+    for (const task of q.tasks.values()) {
+      if (task.status === 'processing' && this.processingTasks.has(task.id)) {
+        count += 1;
+      }
+    }
+    return count;
+  }
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error('Progress percent must be between 0 and 100');
+    }
+    const task = this.allTasks.get(taskId);
+    if (!task) return;
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    task.progress = info;
+    const callbacks = this.progressCallbacks.get(taskId);
+    if (callbacks) {
+      for (const cb of callbacks) {
+        cb({ percent, message, updatedAt: info.updatedAt });
+      }
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    const task = this.allTasks.get(taskId);
+    if (!task || !task.progress) return null;
+    return task.progress;
+  }
+
+  onProgress(taskId: string, callback: (info: ProgressCallbackInfo) => void): () => void {
+    let callbacks = this.progressCallbacks.get(taskId);
+    if (!callbacks) {
+      callbacks = [];
+      this.progressCallbacks.set(taskId, callbacks);
+    }
+    callbacks.push(callback);
+    return () => {
+      const cbs = this.progressCallbacks.get(taskId);
+      if (cbs) {
+        const idx = cbs.indexOf(callback);
+        if (idx !== -1) cbs.splice(idx, 1);
+      }
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.allTasks.get(taskId);
+    if (!task) return;
+    task.cancelled = true;
+    task.status = 'cancelled';
+    this.processingTasks.delete(task.id);
+  }
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {
+    const schedule: Schedule = {
+      id: generateUUID(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+    };
+    this.schedules.set(schedule.id, schedule);
+    return schedule;
+  }
+
+  unschedule(scheduleId: string): void {
+    const schedule = this.schedules.get(scheduleId);
+    if (schedule) {
+      schedule.active = false;
+    }
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const result: Schedule[] = [];
+    for (const schedule of this.schedules.values()) {
+      if (!schedule.active) continue;
+      if (queueName === undefined || schedule.queueName === queueName) {
+        result.push(schedule);
+      }
+    }
+    return result;
+  }
+
+  tick(): void {
+    const now = new Date();
+    for (const schedule of this.schedules.values()) {
+      if (!schedule.active) continue;
+      if (this.isCronDue(schedule, now)) {
+        this.enqueue(schedule.queueName, schedule.taskTemplate);
+        schedule.lastRunAt = now;
+      }
+    }
+  }
+
+  private isCronDue(schedule: Schedule, now: Date): boolean {
+    const expr = schedule.cronExpression;
+    const currentMinute = now.getUTCMinutes();
+    const currentHour = now.getUTCHours();
+
+    if (expr === '0 0 * * *') {
+      // Every day at midnight UTC
+      return currentHour === 0 && currentMinute === 0 && this.minuteChanged(schedule, now);
+    }
+    if (expr === '0 * * * *') {
+      // Every hour on the hour
+      return currentMinute === 0 && this.minuteChanged(schedule, now);
+    }
+    const match = expr.match(/^\*\/(\d+) \* \* \* \*$/);
+    if (match) {
+      const interval = parseInt(match[1], 10);
+      return currentMinute % interval === 0 && this.minuteChanged(schedule, now);
+    }
+    return false;
+  }
+
+  private minuteChanged(schedule: Schedule, now: Date): boolean {
+    if (!schedule.lastRunAt) return true;
+    return schedule.lastRunAt.getUTCMinutes() !== now.getUTCMinutes();
+  }
+
+  use(queueName: string, middleware: Middleware): void {
+    const q = this.getQueue(queueName, true) as QueueState;
+    q.middlewares.push(middleware);
+  }
+
+  async process(queueName: string, handler: TaskHandler): Promise<void> {
+    const q = this.getQueue(queueName);
+    if (!q) return;
+
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const runMiddleware = async (index: number): Promise<void> => {
+      if (index >= q.middlewares.length) {
+        await handler(task);
+        return;
+      }
+      const middleware = q.middlewares[index];
+      let nextCalled = false;
+      await middleware(task, async () => {
+        nextCalled = true;
+        await runMiddleware(index + 1);
+      });
+      if (!nextCalled) {
+        // Middleware skipped further processing
+      }
+    };
+
+    try {
+      await runMiddleware(0);
+      if (task.status === 'processing') {
+        this.complete(task.id);
+      }
+    } catch (err) {
+      if (task.status !== 'cancelled') {
+        this.fail(task.id, err instanceof Error ? err.message : String(err));
+      }
+    }
+  }
+
+  onShutdown(callback: ShutdownCallback): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  shutdown(timeout?: number): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) {
+      return this.shutdownPromise;
+    }
+
+    this.shuttingDown = true;
+    this.shutdownStartTime = Date.now();
+    this.shutdownTimeout = timeout ?? 30000;
+    this.shutdownSummary = { completed: 0, cancelled: 0, elapsed: 0 };
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      this.shutdownResolve = resolve;
+      void this.startShutdown();
+    });
+
+    return this.shutdownPromise;
+  }
+
+  private async startShutdown(): Promise<void> {
+    for (const cb of this.shutdownCallbacks) {
+      try {
+        await cb();
+      } catch {
+        // ignore callback errors
+      }
+    }
+
+    this.checkShutdownComplete();
+
+    if (this.processingTasks.size > 0) {
+      // Set a force-cancel timer
+      const remaining = Math.max(0, this.shutdownTimeout - (Date.now() - this.shutdownStartTime));
+      setTimeout(() => {
+        this.forceCancelRemaining();
+      }, remaining);
+    }
+  }
+
+  private checkShutdownComplete(): void {
+    if (!this.shutdownResolve) return;
+
+    const elapsed = Date.now() - this.shutdownStartTime;
+    this.shutdownSummary.elapsed = elapsed;
+
+    if (this.processingTasks.size === 0) {
+      this.shutdownResolve(this.shutdownSummary);
+      this.shutdownResolve = null;
+      return;
+    }
+
+    if (elapsed >= this.shutdownTimeout) {
+      this.forceCancelRemaining();
+    }
+  }
+
+  private forceCancelRemaining(): void {
+    if (!this.shutdownResolve) return;
+
+    const elapsed = Date.now() - this.shutdownStartTime;
+    this.shutdownSummary.elapsed = elapsed;
+
+    for (const taskId of this.processingTasks) {
+      const task = this.allTasks.get(taskId);
+      if (task) {
+        task.status = 'cancelled';
+        task.cancelled = true;
+        this.shutdownSummary.cancelled += 1;
+      }
+    }
+    this.processingTasks.clear();
+    this.shutdownResolve(this.shutdownSummary);
+    this.shutdownResolve = null;
+  }
+}
