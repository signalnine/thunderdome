+// A reactive spreadsheet engine: cells hold raw values or formulas, formulas
+// are parsed into an AST, and a dependency graph drives automatic recomputation
+// whenever an upstream cell changes.
+
+import { isCellRef } from './cellRef.js';
+import { AstNode } from './ast.js';
+import { parseFormula } from './parser.js';
+import { CellValue, collectDependencies, evaluate } from './evaluator.js';
+
+interface CellData {
+  raw: string | number | boolean;
+  formula: AstNode | null;
+  value: CellValue;
+}
+
+function normalizeCellRef(ref: string): string {
+  const upper = ref.toUpperCase();
+  if (!isCellRef(upper)) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  return upper;
+}
+
+export class Spreadsheet {
+  private cells = new Map<string, CellData>();
+  // dependencies[cell] = set of cells that `cell`'s formula directly reads from.
+  private dependencies = new Map<string, Set<string>>();
+  // dependents[cell] = set of cells whose formulas directly read from `cell`.
+  private dependents = new Map<string, Set<string>>();
+
+  set(cell: string, value: string | number | boolean): void {
+    const ref = normalizeCellRef(cell);
+
+    const isFormula = typeof value === 'string' && value.startsWith('=');
+    let formula: AstNode | null = null;
+    let newDeps: Set<string> = new Set();
+
+    if (isFormula) {
+      formula = parseFormula(value.slice(1));
+      newDeps = new Set(collectDependencies(formula));
+      this.assertNoCycle(ref, newDeps);
+    }
+
+    // Evaluate before committing anything, so a failing formula leaves the
+    // spreadsheet's state untouched.
+    const newValue = formula ? evaluate(formula, (r) => this.readValue(r)) : value;
+
+    this.unlinkDependencies(ref);
+    if (formula) {
+      this.linkDependencies(ref, newDeps);
+    }
+    this.cells.set(ref, { raw: value, formula, value: newValue });
+
+    this.recomputeDependents(ref);
+  }
+
+  get(cell: string): CellValue {
+    const ref = normalizeCellRef(cell);
+    return this.readValue(ref);
+  }
+
+  getDisplay(cell: string): string {
+    const value = this.get(cell);
+    return formatValue(value);
+  }
+
+  getCells(): Map<string, CellValue> {
+    const result = new Map<string, CellValue>();
+    for (const [ref, data] of this.cells) {
+      result.set(ref, data.value);
+    }
+    return result;
+  }
+
+  private readValue(ref: string): CellValue {
+    return this.cells.get(ref)?.value ?? null;
+  }
+
+  private unlinkDependencies(ref: string): void {
+    const oldDeps = this.dependencies.get(ref);
+    if (!oldDeps) return;
+    for (const dep of oldDeps) {
+      this.dependents.get(dep)?.delete(ref);
+    }
+    this.dependencies.delete(ref);
+  }
+
+  private linkDependencies(ref: string, deps: Set<string>): void {
+    this.dependencies.set(ref, deps);
+    for (const dep of deps) {
+      if (!this.dependents.has(dep)) {
+        this.dependents.set(dep, new Set());
+      }
+      this.dependents.get(dep)!.add(ref);
+    }
+  }
+
+  // Throws if adding edges ref -> dep (for each dep in newDeps) would create a cycle,
+  // i.e. if any dep can already (transitively) reach ref via existing dependency edges.
+  private assertNoCycle(ref: string, newDeps: Set<string>): void {
+    for (const dep of newDeps) {
+      if (dep === ref || this.canReach(dep, ref)) {
+        throw new Error(`Circular reference detected: setting ${ref} would create a cycle involving ${dep}`);
+      }
+    }
+  }
+
+  private canReach(start: string, target: string): boolean {
+    const visited = new Set<string>();
+    const stack = [start];
+    while (stack.length > 0) {
+      const current = stack.pop()!;
+      if (current === target) return true;
+      if (visited.has(current)) continue;
+      visited.add(current);
+      const deps = this.dependencies.get(current);
+      if (deps) {
+        for (const dep of deps) {
+          stack.push(dep);
+        }
+      }
+    }
+    return false;
+  }
+
+  // Recomputes every cell downstream of `ref` (its dependents, transitively),
+  // in topological order so each cell sees up-to-date upstream values.
+  private recomputeDependents(ref: string): void {
+    const affected = this.collectAffected(ref);
+    if (affected.size === 0) return;
+
+    const order = this.topoSort(affected);
+    for (const cellRef of order) {
+      const data = this.cells.get(cellRef);
+      if (!data || !data.formula) continue;
+      data.value = evaluate(data.formula, (r) => this.readValue(r));
+    }
+  }
+
+  private collectAffected(ref: string): Set<string> {
+    const affected = new Set<string>();
+    const queue = [...(this.dependents.get(ref) ?? [])];
+    while (queue.length > 0) {
+      const current = queue.shift()!;
+      if (affected.has(current)) continue;
+      affected.add(current);
+      for (const next of this.dependents.get(current) ?? []) {
+        queue.push(next);
+      }
+    }
+    return affected;
+  }
+
+  private topoSort(affected: Set<string>): string[] {
+    const inDegree = new Map<string, number>();
+    for (const cell of affected) {
+      const deps = this.dependencies.get(cell) ?? new Set();
+      let count = 0;
+      for (const dep of deps) {
+        if (affected.has(dep)) count++;
+      }
+      inDegree.set(cell, count);
+    }
+
+    const queue = [...affected].filter((cell) => inDegree.get(cell) === 0);
+    const order: string[] = [];
+
+    while (queue.length > 0) {
+      const cell = queue.shift()!;
+      order.push(cell);
+      for (const dependent of this.dependents.get(cell) ?? []) {
+        if (!affected.has(dependent)) continue;
+        const remaining = (inDegree.get(dependent) ?? 0) - 1;
+        inDegree.set(dependent, remaining);
+        if (remaining === 0) queue.push(dependent);
+      }
+    }
+
+    return order;
+  }
+}
+
+function formatValue(value: CellValue): string {
+  if (value === null) return '';
+  if (typeof value === 'boolean') return value ? 'TRUE' : 'FALSE';
+  return String(value);
+}
+
+export type { CellValue };
