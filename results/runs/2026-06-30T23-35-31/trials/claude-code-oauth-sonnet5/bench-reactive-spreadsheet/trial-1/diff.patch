t('B1')).toBe(2);\n\n    // Changing A1 should no longer affect B1 since the dependency was dropped.\n    sheet.set('A1', 100);\n    expect(sheet.get('B1')).toBe(2);\n  });\n\n  it('replacing a formula with a raw value drops old dependencies', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1+1');\n    expect(sheet.get('B1')).toBe(2);\n\n    sheet.set('B1', 99);\n    sheet.set('A1', 1000);\n    expect(sheet.get('B1')).toBe(99);\n  });\n});\n\ndescribe('circular reference detection', () => {\n  it('detects a direct self-reference', () => {\n    const sheet = new Spreadsheet();\n    expect(() => sheet.set('A1', '=A1')).toThrow();\n  });\n\n  it('detects a direct two-cell cycle', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=B1+1');\n    expect(() => sheet.set('B1', '=A1+1')).toThrow();\n  });\n\n  it('detects an indirect cycle through several cells', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=B1');\n    sheet.set('B1', '=C1');\n    sheet.set('C1', '=D1');\n    expect(() => sheet.set('D1', '=A1')).toThrow();\n  });\n\n  it('does not corrupt state when a cycle is rejected', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 5);\n    sheet.set('B1', '=A1+1');\n    expect(() => sheet.set('A1', '=B1')).toThrow();\n\n    // A1 should still hold its original raw value.\n    expect(sheet.get('A1')).toBe(5);\n    expect(sheet.get('B1')).toBe(6);\n  });\n\n  it('detects a cycle through a range reference', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=SUM(B1:B3)');\n    expect(() => sheet.set('B2', '=A1')).toThrow();\n  });\n});\n\ndescribe('getCells', () => {\n  it('returns only non-empty cells with computed values', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('A2', 2);\n    sheet.set('A3', '=A1+A2');\n\n    const cells = sheet.getCells();\n    expect(cells.size).toBe(3);\n    expect(cells.get('A1')).toBe(1);\n    expect(cells.get('A2')).toBe(2);\n    expect(cells.get('A3')).toBe(3);\n  });\n\n  it('reflects reactive updates', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('A2', '=A1+1');\n    sheet.set('A1', 100);\n\n    expect(sheet.getCells().get('A2')).toBe(101);\n  });\n});\n\ndescribe('errors', () => {\n  it('throws for an invalid cell reference', () => {\n    const sheet = new Spreadsheet();\n    expect(() => sheet.set('1A', 5)).toThrow();\n    expect(() => sheet.get('not-a-cell')).toThrow();\n  });\n\n  it('throws for a malformed formula', () => {\n    const sheet = new Spreadsheet();\n    expect(() => sheet.set('A1', '=1+')).toThrow();\n    expect(() => sheet.set('A1', '=SUM(A1:A2')).toThrow();\n  });\n\n  it('throws for an unknown function', () => {\n    const sheet = new Spreadsheet();\n    expect(() => sheet.set('A1', '=FOO(1,2)')).toThrow();\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
