@@ -0,0 +1,368 @@
+import { describe, expect, it } from 'vitest';
+import { Spreadsheet } from './index.js';
+
+describe('raw values', () => {
+  it('stores and retrieves numbers, strings, and booleans', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 42);
+    sheet.set('A2', 'hello');
+    sheet.set('A3', true);
+
+    expect(sheet.get('A1')).toBe(42);
+    expect(sheet.get('A2')).toBe('hello');
+    expect(sheet.get('A3')).toBe(true);
+  });
+
+  it('returns null for empty cells', () => {
+    const sheet = new Spreadsheet();
+    expect(sheet.get('Z99')).toBeNull();
+  });
+
+  it('formats display strings', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 3.14);
+    sheet.set('A2', 'hello');
+    sheet.set('A3', true);
+    sheet.set('A4', false);
+
+    expect(sheet.getDisplay('A1')).toBe('3.14');
+    expect(sheet.getDisplay('A2')).toBe('hello');
+    expect(sheet.getDisplay('A3')).toBe('TRUE');
+    expect(sheet.getDisplay('A4')).toBe('FALSE');
+    expect(sheet.getDisplay('Z99')).toBe('');
+  });
+
+  it('supports multi-letter columns', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('AA1', 1);
+    sheet.set('AZ100', 2);
+    sheet.set('BA1', '=AA1+AZ100');
+
+    expect(sheet.get('BA1')).toBe(3);
+  });
+});
+
+describe('arithmetic formulas', () => {
+  it('evaluates basic arithmetic', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('A3', '=A1+A2');
+
+    expect(sheet.get('A3')).toBe(30);
+    expect(sheet.getDisplay('A3')).toBe('30');
+  });
+
+  it('respects operator precedence and parentheses', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 2);
+    sheet.set('A2', 3);
+    sheet.set('A3', 4);
+    sheet.set('B1', '=A1+A2*A3');
+    sheet.set('B2', '=(A1+A2)*A3');
+
+    expect(sheet.get('B1')).toBe(14);
+    expect(sheet.get('B2')).toBe(20);
+  });
+
+  it('supports subtraction, division, and unary minus', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 4);
+    sheet.set('B1', '=A1-A2');
+    sheet.set('B2', '=A1/A2');
+    sheet.set('B3', '=-A1+A2');
+
+    expect(sheet.get('B1')).toBe(6);
+    expect(sheet.get('B2')).toBe(2.5);
+    expect(sheet.get('B3')).toBe(-6);
+  });
+
+  it('throws on division by zero', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 0);
+    expect(() => sheet.set('A3', '=A1/A2')).toThrow();
+  });
+});
+
+describe('comparison operators', () => {
+  it('evaluates comparisons used directly', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+
+    sheet.set('B1', '=A1>A2');
+    sheet.set('B2', '=A1<A2');
+    sheet.set('B3', '=A1>=10');
+    sheet.set('B4', '=A1<=9');
+    sheet.set('B5', '=A1=10');
+    sheet.set('B6', '=A1<>A2');
+
+    expect(sheet.get('B1')).toBe(false);
+    expect(sheet.get('B2')).toBe(true);
+    expect(sheet.get('B3')).toBe(true);
+    expect(sheet.get('B4')).toBe(false);
+    expect(sheet.get('B5')).toBe(true);
+    expect(sheet.get('B6')).toBe(true);
+  });
+});
+
+describe('ranges and built-in functions', () => {
+  it('SUM over a column range', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('A2', 2);
+    sheet.set('A3', 3);
+    sheet.set('A4', 4);
+    sheet.set('A5', 5);
+    sheet.set('B1', '=SUM(A1:A5)');
+
+    expect(sheet.get('B1')).toBe(15);
+  });
+
+  it('SUM over a row range', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', 2);
+    sheet.set('C1', 3);
+    sheet.set('D1', '=SUM(A1:C1)');
+
+    expect(sheet.get('D1')).toBe(6);
+  });
+
+  it('SUM over a block range', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', 2);
+    sheet.set('A2', 3);
+    sheet.set('B2', 4);
+    sheet.set('A3', 5);
+    sheet.set('B3', 6);
+    sheet.set('C1', '=SUM(A1:B3)');
+
+    expect(sheet.get('C1')).toBe(21);
+  });
+
+  it('AVERAGE, MIN, MAX, COUNT', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 4);
+    sheet.set('A2', 8);
+    sheet.set('A3', 15);
+    sheet.set('A4', 16);
+
+    sheet.set('B1', '=AVERAGE(A1:A4)');
+    sheet.set('B2', '=MIN(A1:A4)');
+    sheet.set('B3', '=MAX(A1:A4)');
+    sheet.set('B4', '=COUNT(A1:A4)');
+
+    expect(sheet.get('B1')).toBe(10.75);
+    expect(sheet.get('B2')).toBe(4);
+    expect(sheet.get('B3')).toBe(16);
+    expect(sheet.get('B4')).toBe(4);
+  });
+
+  it('ignores non-numeric cells in ranges for aggregate functions', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 'skip me');
+    sheet.set('A3', 20);
+    sheet.set('B1', '=SUM(A1:A3)');
+    sheet.set('B2', '=COUNT(A1:A3)');
+
+    expect(sheet.get('B1')).toBe(30);
+    expect(sheet.get('B2')).toBe(2);
+  });
+
+  it('range reads reactively pick up newly-set cells', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('B1', '=SUM(A1:A3)');
+    expect(sheet.get('B1')).toBe(0);
+
+    sheet.set('A1', 5);
+    sheet.set('A2', 10);
+    expect(sheet.get('B1')).toBe(15);
+  });
+});
+
+describe('IF function', () => {
+  it('branches on a comparison condition', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 50);
+    sheet.set('C1', '=IF(A1>30, "big", "small")');
+
+    expect(sheet.get('C1')).toBe('big');
+
+    sheet.set('A1', 10);
+    expect(sheet.get('C1')).toBe('small');
+  });
+
+  it('supports nested IFs and numeric branches', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 5);
+    sheet.set('B1', '=IF(A1>10, 1, IF(A1>0, 0, -1))');
+
+    expect(sheet.get('B1')).toBe(0);
+  });
+
+  it('supports boolean literal conditions', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=IF(TRUE, "yes", "no")');
+    sheet.set('A2', '=IF(FALSE, "yes", "no")');
+
+    expect(sheet.get('A1')).toBe('yes');
+    expect(sheet.get('A2')).toBe('no');
+  });
+});
+
+describe('reactive updates', () => {
+  it('propagates a direct dependency change', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('A3', '=A1+A2');
+
+    expect(sheet.get('A3')).toBe(30);
+
+    sheet.set('A1', 50);
+    expect(sheet.get('A3')).toBe(70);
+  });
+
+  it('propagates transitively through chains', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1+1');
+    sheet.set('C1', '=B1+1');
+    sheet.set('D1', '=C1+1');
+
+    expect(sheet.get('D1')).toBe(4);
+
+    sheet.set('A1', 10);
+    expect(sheet.get('B1')).toBe(11);
+    expect(sheet.get('C1')).toBe(12);
+    expect(sheet.get('D1')).toBe(13);
+  });
+
+  it('propagates correctly through diamond-shaped dependencies', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 2);
+    sheet.set('B1', '=A1*2');
+    sheet.set('C1', '=A1*3');
+    sheet.set('D1', '=B1+C1');
+
+    expect(sheet.get('D1')).toBe(10);
+
+    sheet.set('A1', 5);
+    expect(sheet.get('B1')).toBe(10);
+    expect(sheet.get('C1')).toBe(15);
+    expect(sheet.get('D1')).toBe(25);
+  });
+
+  it('re-parses when a formula is replaced with a different formula', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('A2', 2);
+    sheet.set('B1', '=A1');
+
+    expect(sheet.get('B1')).toBe(1);
+
+    sheet.set('B1', '=A2');
+    expect(sheet.get('B1')).toBe(2);
+
+    // Changing A1 should no longer affect B1 since the dependency was dropped.
+    sheet.set('A1', 100);
+    expect(sheet.get('B1')).toBe(2);
+  });
+
+  it('replacing a formula with a raw value drops old dependencies', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1+1');
+    expect(sheet.get('B1')).toBe(2);
+
+    sheet.set('B1', 99);
+    sheet.set('A1', 1000);
+    expect(sheet.get('B1')).toBe(99);
+  });
+});
+
+describe('circular reference detection', () => {
+  it('detects a direct self-reference', () => {
+    const sheet = new Spreadsheet();
+    expect(() => sheet.set('A1', '=A1')).toThrow();
+  });
+
+  it('detects a direct two-cell cycle', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=B1+1');
+    expect(() => sheet.set('B1', '=A1+1')).toThrow();
+  });
+
+  it('detects an indirect cycle through several cells', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=B1');
+    sheet.set('B1', '=C1');
+    sheet.set('C1', '=D1');
+    expect(() => sheet.set('D1', '=A1')).toThrow();
+  });
+
+  it('does not corrupt state when a cycle is rejected', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 5);
+    sheet.set('B1', '=A1+1');
+    expect(() => sheet.set('A1', '=B1')).toThrow();
+
+    // A1 should still hold its original raw value.
+    expect(sheet.get('A1')).toBe(5);
+    expect(sheet.get('B1')).toBe(6);
+  });
+
+  it('detects a cycle through a range reference', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', '=SUM(B1:B3)');
+    expect(() => sheet.set('B2', '=A1')).toThrow();
+  });
+});
+
+describe('getCells', () => {
+  it('returns only non-empty cells with computed values', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('A2', 2);
+    sheet.set('A3', '=A1+A2');
+
+    const cells = sheet.getCells();
+    expect(cells.size).toBe(3);
+    expect(cells.get('A1')).toBe(1);
+    expect(cells.get('A2')).toBe(2);
+    expect(cells.get('A3')).toBe(3);
+  });
+
+  it('reflects reactive updates', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('A2', '=A1+1');
+    sheet.set('A1', 100);
+
+    expect(sheet.getCells().get('A2')).toBe(101);
+  });
+});
+
+describe('errors', () => {
+  it('throws for an invalid cell reference', () => {
+    const sheet = new Spreadsheet();
+    expect(() => sheet.set('1A', 5)).toThrow();
+    expect(() => sheet.get('not-a-cell')).toThrow();
+  });
+
+  it('throws for a malformed formula', () => {
+    const sheet = new Spreadsheet();
+    expect(() => sheet.set('A1', '=1+')).toThrow();
+    expect(() => sheet.set('A1', '=SUM(A1:A2')).toThrow();
+  });
+
+  it('throws for an unknown function', () => {
+    const sheet = new Spreadsheet();
+    expect(() => sheet.set('A1', '=FOO(1,2)')).toThrow();
+  });
+});
