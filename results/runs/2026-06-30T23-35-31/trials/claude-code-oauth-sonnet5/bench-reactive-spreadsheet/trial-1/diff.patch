+// Recursive-descent parser: token stream -> AST.
+//
+// Grammar (lowest to highest precedence):
+//   comparison  := additive (('>'|'<'|'>='|'<='|'='|'<>') additive)?
+//   additive    := multiplicative (('+'|'-') multiplicative)*
+//   multiplicative := unary (('*'|'/') unary)*
+//   unary       := ('-'|'+') unary | primary
+//   primary     := NUMBER | STRING | TRUE | FALSE | cellRef | range | functionCall | '(' comparison ')'
+
+import { AstNode, BinaryOperator } from './ast.js';
+import { isCellRef } from './cellRef.js';
+import { Token, tokenize } from './lexer.js';
+
+const COMPARISON_OPS = new Set(['>', '<', '>=', '<=', '=', '<>']);
+
+export function parseFormula(formula: string): AstNode {
+  const tokens = tokenize(formula);
+  const parser = new Parser(tokens);
+  const node = parser.parseComparison();
+  parser.expect('EOF');
+  return node;
+}
+
+class Parser {
+  private tokens: Token[];
+  private pos = 0;
+
+  constructor(tokens: Token[]) {
+    this.tokens = tokens;
+  }
+
+  private peek(): Token {
+    return this.tokens[this.pos];
+  }
+
+  private next(): Token {
+    return this.tokens[this.pos++];
+  }
+
+  expect(type: Token['type']): Token {
+    const tok = this.peek();
+    if (tok.type !== type) {
+      throw new Error(`Expected ${type} but found '${tok.value || tok.type}' at position ${tok.pos}`);
+    }
+    return this.next();
+  }
+
+  parseComparison(): AstNode {
+    let left = this.parseAdditive();
+    const tok = this.peek();
+    if (tok.type === 'OPERATOR' && COMPARISON_OPS.has(tok.value)) {
+      this.next();
+      const right = this.parseAdditive();
+      left = { kind: 'BinaryOp', op: tok.value as BinaryOperator, left, right };
+    }
+    return left;
+  }
+
+  private parseAdditive(): AstNode {
+    let left = this.parseMultiplicative();
+    let tok = this.peek();
+    while (tok.type === 'OPERATOR' && (tok.value === '+' || tok.value === '-')) {
+      this.next();
+      const right = this.parseMultiplicative();
+      left = { kind: 'BinaryOp', op: tok.value as BinaryOperator, left, right };
+      tok = this.peek();
+    }
+    return left;
+  }
+
+  private parseMultiplicative(): AstNode {
+    let left = this.parseUnary();
+    let tok = this.peek();
+    while (tok.type === 'OPERATOR' && (tok.value === '*' || tok.value === '/')) {
+      this.next();
+      const right = this.parseUnary();
+      left = { kind: 'BinaryOp', op: tok.value as BinaryOperator, left, right };
+      tok = this.peek();
+    }
+    return left;
+  }
+
+  private parseUnary(): AstNode {
+    const tok = this.peek();
+    if (tok.type === 'OPERATOR' && (tok.value === '-' || tok.value === '+')) {
+      this.next();
+      const operand = this.parseUnary();
+      return { kind: 'UnaryOp', op: tok.value, operand };
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): AstNode {
+    const tok = this.peek();
+
+    if (tok.type === 'NUMBER') {
+      this.next();
+      return { kind: 'Number', value: parseFloat(tok.value) };
+    }
+
+    if (tok.type === 'STRING') {
+      this.next();
+      return { kind: 'String', value: tok.value };
+    }
+
+    if (tok.type === 'LPAREN') {
+      this.next();
+      const node = this.parseComparison();
+      this.expect('RPAREN');
+      return node;
+    }
+
+    if (tok.type === 'IDENT') {
+      this.next();
+      const upper = tok.value.toUpperCase();
+
+      if (upper === 'TRUE' || upper === 'FALSE') {
+        return { kind: 'Boolean', value: upper === 'TRUE' };
+      }
+
+      // Function call: IDENT '(' args ')'
+      if (this.peek().type === 'LPAREN') {
+        this.next();
+        const args: AstNode[] = [];
+        if (this.peek().type !== 'RPAREN') {
+          args.push(this.parseComparison());
+          while (this.peek().type === 'COMMA') {
+            this.next();
+            args.push(this.parseComparison());
+          }
+        }
+        this.expect('RPAREN');
+        return { kind: 'FunctionCall', name: upper, args };
+      }
+
+      // Cell reference or range: IDENT (':' IDENT)?
+      if (isCellRef(upper)) {
+        if (this.peek().type === 'COLON') {
+          this.next();
+          const endTok = this.expect('IDENT');
+          const endUpper = endTok.value.toUpperCase();
+          if (!isCellRef(endUpper)) {
+            throw new Error(`Invalid range end reference '${endTok.value}' at position ${endTok.pos}`);
+          }
+          return { kind: 'Range', start: upper, end: endUpper };
+        }
+        return { kind: 'CellRef', ref: upper };
+      }
+
+      throw new Error(`Unknown identifier '${tok.value}' at position ${tok.pos}`);
+    }
+
+    throw new Error(`Unexpected token '${tok.value || tok.type}' at position ${tok.pos}`);
+  }
+}
