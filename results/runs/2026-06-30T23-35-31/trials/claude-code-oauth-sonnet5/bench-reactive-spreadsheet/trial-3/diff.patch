@@ -0,0 +1,372 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import { Spreadsheet } from './index.js';
+
+describe('basic values', () => {
+  let sheet: Spreadsheet;
+
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('stores and retrieves numbers', () => {
+    sheet.set('A1', 42);
+    expect(sheet.get('A1')).toBe(42);
+    expect(sheet.getDisplay('A1')).toBe('42');
+  });
+
+  it('stores and retrieves strings', () => {
+    sheet.set('A1', 'hello');
+    expect(sheet.get('A1')).toBe('hello');
+    expect(sheet.getDisplay('A1')).toBe('hello');
+  });
+
+  it('stores and retrieves booleans', () => {
+    sheet.set('A1', true);
+    expect(sheet.get('A1')).toBe(true);
+    sheet.set('A2', false);
+    expect(sheet.get('A2')).toBe(false);
+  });
+
+  it('returns null for empty cells', () => {
+    expect(sheet.get('Z99')).toBeNull();
+    expect(sheet.getDisplay('Z99')).toBe('');
+  });
+
+  it('handles floats', () => {
+    sheet.set('A1', 3.14);
+    expect(sheet.get('A1')).toBe(3.14);
+  });
+
+  it('is case-insensitive and normalizes cell refs', () => {
