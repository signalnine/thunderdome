ndles floats', () => {\n    sheet.set('A1', 3.14);\n    expect(sheet.get('A1')).toBe(3.14);\n  });\n\n  it('is case-insensitive and normalizes cell refs', () => {\n    sheet.set('a1', 5);\n    expect(sheet.get('A1')).toBe(5);\n    expect(sheet.get('a1')).toBe(5);\n  });\n\n  it('supports multi-letter columns', () => {\n    sheet.set('AA1', 7);\n    expect(sheet.get('AA1')).toBe(7);\n    sheet.set('AZ100', 9);\n    expect(sheet.get('AZ100')).toBe(9);\n  });\n});\n\ndescribe('arithmetic formulas', () => {\n  let sheet: Spreadsheet;\n\n  beforeEach(() => {\n    sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 20);\n  });\n\n  it('adds cell references', () => {\n    sheet.set('A3', '=A1+A2');\n    expect(sheet.get('A3')).toBe(30);\n    expect(sheet.getDisplay('A3')).toBe('30');\n  });\n\n  it('supports subtraction, multiplication, division', () => {\n    sheet.set('B1', '=A2-A1');\n    expect(sheet.get('B1')).toBe(10);\n    sheet.set('B2', '=A2*A1');\n    expect(sheet.get('B2')).toBe(200);\n    sheet.set('B3', '=A2/A1');\n    expect(sheet.get('B3')).toBe(2);\n  });\n\n  it('respects operator precedence and parentheses', () => {\n    sheet.set('B1', '=A1+A2*2');\n    expect(sheet.get('B1')).toBe(50);\n    sheet.set('B2', '=(A1+A2)*2');\n    expect(sheet.get('B2')).toBe(60);\n  });\n\n  it('supports unary minus', () => {\n    sheet.set('B1', '=-A1');\n    expect(sheet.get('B1')).toBe(-10);\n    sheet.set('B2', '=-(A1+A2)');\n    expect(sheet.get('B2')).toBe(-30);\n  });\n\n  it('supports numeric literals directly in formulas', () => {\n    sheet.set('B1', '=1+2*3');\n    expect(sheet.get('B1')).toBe(7);\n  });\n\n  it('throws on division by zero', () => {\n    sheet.set('A4', 0);\n    expect(() => sheet.set('B1', '=A1/A4')).toThrow();\n  });\n\n  it('treats empty referenced cells as 0', () => {\n    sheet.set('B1', '=A1+Z50');\n    expect(sheet.get('B1')).toBe(10);\n  });\n});\n\ndescribe('reactive updates', () => {\n  let sheet: Spreadsheet;\n\n  beforeEach(() => {\n    sheet = new Spreadsheet();\n  });\n\n  it('recomputes dependent cells when a dependency changes', () => {\n    sheet.set('A1', 5);\n    sheet.set('B1', '=A1+1');\n    expect(sheet.get('B1')).toBe(6);\n\n    sheet.set('A1', 10);\n    expect(sheet.get('B1')).toBe(11);\n  });\n\n  it('propagates through multiple levels of dependency', () => {\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1+1');\n    sheet.set('C1', '=B1+1');\n    sheet.set('D1', '=C1+1');\n    expect(sheet.get('D1')).toBe(4);\n\n    sheet.set('A1', 10);\n    expect(sheet.get('B1')).toBe(11);\n    expect(sheet.get('C1')).toBe(12);\n    expect(sheet.get('D1')).toBe(13);\n  });\n\n  it('propagates to multiple dependents of the same cell (diamond dependency)', () => {\n    sheet.set('A1', 2);\n    sheet.set('B1', '=A1*2');\n    sheet.set('C1', '=A1*3');\n    sheet.set('D1', '=B1+C1');\n    expect(sheet.get('D1')).toBe(10);\n\n    sheet.set('A1', 5);\n    expect(sheet.get('B1')).toBe(10);\n    expect(sheet.get('C1')).toBe(15);\n    expect(sheet.get('D1')).toBe(25);\n  });\n\n  it('updates correctly when a formula is replaced with a new formula', () => {\n    sheet.set('A1', 5);\n    sheet.set('A2', 100);\n    sheet.set('B1', '=A1+1');\n    expect(sheet.get('B1')).toBe(6);\n\n    sheet.set('B1', '=A2+1');\n    expect(sheet.get('B1')).toBe(101);\n\n    sheet.set('A1', 999);\n    expect(sheet.get('B1')).toBe(101);\n  });\n\n  it('updates correctly when a formula cell is replaced with a raw value', () => {\n    sheet.set('A1', 5);\n    sheet.set('B1', '=A1+1');\n    expect(sheet.get('B1')).toBe(6);\n\n    sheet.set('B1', 42);\n    sheet.set('A1', 999);\n    expect(sheet.get('B1')).toBe(42);\n  });\n});\n\ndescribe('functions', () => {\n  let sheet: Spreadsheet;\n\n  beforeEach(() => {\n    sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 20);\n    sheet.set('A3', 30);\n    sheet.set('A4', 40);\n    sheet.set('A5', 50);\n  });\n\n  it('SUM over a column range', () => {\n    sheet.set('B1', '=SUM(A1:A5)');\n    expect(sheet.get('B1')).toBe(150);\n  });\n\n  it('AVERAGE over a range', () => {\n    sheet.set('B1', '=AVERAGE(A1:A5)');\n    expect(sheet.get('B1')).toBe(30);\n  });\n\n  it('MIN and MAX over a range', () => {\n    sheet.set('B1', '=MIN(A1:A5)');\n    expect(sheet.get('B1')).toBe(10);\n    sheet.set('B2', '=MAX(A1:A5)');\n    expect(sheet.get('B2')).toBe(50);\n  });\n\n  it('COUNT counts only numeric values in a range', () => {\n    sheet.set('A6', 'text');\n    sheet.set('B1', '=COUNT(A1:A6)');\n    expect(sheet.get('B1')).toBe(5);\n  });\n\n  it('SUM ignores non-numeric values in a range', () => {\n    sheet.set('A6', 'text');\n    sheet.set('A7', true);\n    sheet.set('B1', '=SUM(A1:A7)');\n    expect(sheet.get('B1')).toBe(150);\n  });\n\n  it('supports row ranges', () => {\n    sheet.set('C1', 1);\n    sheet.set('D1', 2);\n    sheet.set('E1', 3);\n    sheet.set('F1', '=SUM(C1:E1)');\n    expect(sheet.get('F1')).toBe(6);\n  });\n\n  it('supports block (2D) ranges', () => {\n    sheet.set('C1', 1);\n    sheet.set('D1', 2);\n    sheet.set('C2', 3);\n    sheet.set('D2', 4);\n    sheet.set('E1', '=SUM(C1:D2)');\n    expect(sheet.get('E1')).toBe(10);\n  });\n\n  it('IF with a true condition', () => {\n    sheet.set('B1', '=IF(A1>5, \"big\", \"small\")');\n    expect(sheet.get('B1')).toBe('big');\n  });\n\n  it('IF with a false condition', () => {\n    sheet.set('B1', '=IF(A1>50, \"big\", \"small\")');\n    expect(sheet.get('B1')).toBe('small');\n  });\n\n  it('IF supports all comparison operators', () => {\n    sheet.set('B1', '=IF(A1=10, \"eq\", \"ne\")');\n    expect(sheet.get('B1')).toBe('eq');\n    sheet.set('B2', '=IF(A1<>10, \"ne\", \"eq\")');\n    expect(sheet.get('B2')).toBe('eq');\n    sheet.set('B3', '=IF(A1>=10, \"ge\", \"lt\")');\n    expect(sheet.get('B3')).toBe('ge');\n    sheet.set('B4', '=IF(A1<=9, \"le\", \"gt\")');\n    expect(sheet.get('B4')).toBe('gt');\n  });\n\n  it('IF can nest and return numbers', () => {\n    sheet.set('B1', '=IF(A1>5, A2, A3)');\n    expect(sheet.get('B1')).toBe(20);\n  });\n\n  it('functions reactively update with dependencies', () => {\n    sheet.set('B1', '=SUM(A1:A5)');\n    expect(sheet.get('B1')).toBe(150);\n    sheet.set('A1', 100);\n    expect(sheet.get('B1')).toBe(240);\n  });\n\n  it('function names are case-insensitive', () => {\n    sheet.set('B1', '=sum(A1:A5)');\n    expect(sheet.get('B1')).toBe(150);\n  });\n});\n\ndescribe('circular reference detection', () => {\n  let sheet: Spreadsheet;\n\n  beforeEach(() => {\n    sheet = new Spreadsheet();\n  });\n\n  it('detects direct self-reference', () => {\n    expect(() => sheet.set('A1', '=A1+1')).toThrow();\n  });\n\n  it('detects a simple two-cell cycle', () => {\n    sheet.set('A1', '=B1+1');\n    expect(() => sheet.set('B1', '=A1+1')).toThrow();\n  });\n\n  it('detects indirect cycles through multiple cells', () => {\n    sheet.set('A1', '=B1');\n    sheet.set('B1', '=C1');\n    expect(() => sheet.set('C1', '=A1')).toThrow();\n  });\n\n  it('does not corrupt state when a cycle is rejected', () => {\n    sheet.set('A1', 5);\n    sheet.set('B1', '=A1+1');\n    expect(sheet.get('B1')).toBe(6);\n\n    expect(() => sheet.set('A1', '=B1+1')).toThrow();\n\n    // A1 should remain unchanged since the cyclic set was rejected\n    expect(sheet.get('A1')).toBe(5);\n    expect(sheet.get('B1')).toBe(6);\n  });\n\n  it('allows re-setting a cell to break a would-be cycle path safely', () => {\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1+1');\n    sheet.set('C1', '=B1+1');\n    // Redirect C1 away from B1 - should not throw\n    expect(() => sheet.set('C1', '=A1+5')).not.toThrow();\n    expect(sheet.get('C1')).toBe(6);\n  });\n\n  it('detects cycles introduced via ranges', () => {\n    sheet.set('A1', 1);\n    sheet.set('A2', '=SUM(A1:A3)');\n    expect(() => sheet.set('A3', '=A2')).toThrow();\n  });\n});\n\ndescribe('getCells', () => {\n  it('returns all non-empty cells with computed values', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 20);\n    sheet.set('A3', '=A1+A2');\n\n    const cells = sheet.getCells();\n    expect(cells.get('A1')).toBe(10);\n    expect(cells.get('A2')).toBe(20);\n    expect(cells.get('A3')).toBe(30);\n    expect(cells.size).toBe(3);\n  });\n\n  it('reflects reactive updates', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('B1', '=A1*2');\n    sheet.set('A1', 5);\n\n    const cells = sheet.getCells();\n    expect(cells.get('B1')).toBe(10);\n  });\n});\n\ndescribe('full example from spec', () => {\n  it('matches the documented example usage', () => {\n    const sheet = new Spreadsheet();\n\n    sheet.set('A1', 10);\n    sheet.set('A2', 20);\n    sheet.set('A3', '=A1+A2');\n    expect(sheet.get('A3')).toBe(30);\n    expect(sheet.getDisplay('A3')).toBe('30');\n\n    sheet.set('A1', 50);\n    expect(sheet.get('A3')).toBe(70);\n\n    sheet.set('B1', '=SUM(A1:A2)');\n    expect(sheet.get('B1')).toBe(70);\n\n    sheet.set('C1', '=IF(A1>30, \"big\", \"small\")');\n    expect(sheet.get('C1')).toBe('big');\n  });\n});\n","structuredPatch":[{"oldStart":314,"oldLines":9,"newStart":314,"newLines":15,"lines":[" ","   it('detects cycles introduced via ranges', () => {","     sheet.set('A1', 1);","-    sheet.set('A2', '=SUM(A1:A3)');","-    expect(() => sheet.set('A3', '=A2')).toThrow();","+    sheet.set('A2', 2);","+    sheet.set('B1', '=SUM(A1:A2)');","+    expect(() => sheet.set('A2', '=B1')).toThrow();","   });","+","+  it('rejects a formula whose range includes itself', () => {","+    sheet.set('A1', 1);","+    expect(() => sheet.set('A2', '=SUM(A1:A3)')).toThrow();","+  });"," });"," "," describe('getCells', () => {"]}],"userModified":false,"replaceAll":false}}
