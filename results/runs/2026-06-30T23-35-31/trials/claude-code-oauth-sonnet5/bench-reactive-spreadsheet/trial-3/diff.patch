diff --git a/src/cellRef.ts b/src/cellRef.ts
new file mode 100644
index 0000000..69e4bee
--- /dev/null
+++ b/src/cellRef.ts
@@ -0,0 +1,67 @@
+export interface ParsedRef {
+  col: number;
+  row: number;
+}
+
+const CELL_REF_RE = /^([A-Za-z]+)([0-9]+)$/;
+
+export function isCellRef(token: string): boolean {
+  return CELL_REF_RE.test(token);
+}
+
+export function columnToIndex(letters: string): number {
+  let result = 0;
+  for (const ch of letters.toUpperCase()) {
+    result = result * 26 + (ch.charCodeAt(0) - 64);
+  }
+  return result;
+}
+
+export function indexToColumn(index: number): string {
+  let result = '';
+  let n = index;
+  while (n > 0) {
+    const rem = (n - 1) % 26;
+    result = String.fromCharCode(65 + rem) + result;
+    n = Math.floor((n - 1) / 26);
+  }
+  return result;
+}
+
+export function parseCellRef(ref: string): ParsedRef {
+  const match = CELL_REF_RE.exec(ref);
+  if (!match) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  const [, letters, digits] = match;
+  const row = parseInt(digits, 10);
+  if (row < 1) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  return { col: columnToIndex(letters), row };
+}
+
+export function makeCellRef(col: number, row: number): string {
+  return `${indexToColumn(col)}${row}`;
+}
+
+export function normalizeCellRef(ref: string): string {
+  const { col, row } = parseCellRef(ref);
+  return makeCellRef(col, row);
+}
+
+export function expandRange(start: string, end: string): string[] {
+  const a = parseCellRef(start);
+  const b = parseCellRef(end);
+  const minCol = Math.min(a.col, b.col);
+  const maxCol = Math.max(a.col, b.col);
+  const minRow = Math.min(a.row, b.row);
+  const maxRow = Math.max(a.row, b.row);
+  const cells: string[] = [];
+  for (let row = minRow; row <= maxRow; row++) {
+    for (let col = minCol; col <= maxCol; col++) {
+      cells.push(makeCellRef(col, row));
+    }
+  }
+  return cells;
+}
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..14431f1
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,119 @@
+import type { BinaryOp, Expr } from './parser.js';
+import { expandRange } from './cellRef.js';
+
+export type CellValue = number | string | boolean | null;
+
+export interface EvalContext {
+  getValue(ref: string): CellValue;
+}
+
+function toNumber(v: CellValue): number {
+  if (v === null || v === undefined) return 0;
+  if (typeof v === 'number') return v;
+  if (typeof v === 'boolean') return v ? 1 : 0;
+  const n = Number(v);
+  if (v.trim() !== '' && !Number.isNaN(n)) return n;
+  throw new Error(`Cannot convert '${v}' to a number`);
+}
+
+function isTruthy(v: CellValue): boolean {
+  if (typeof v === 'boolean') return v;
+  if (typeof v === 'number') return v !== 0;
+  if (typeof v === 'string') return v.length > 0;
+  return false;
+}
+
+function compare(op: BinaryOp, left: CellValue, right: CellValue): boolean {
+  if (typeof left === 'string' && typeof right === 'string') {
+    if (op === '=') return left === right;
+    if (op === '<>') return left !== right;
+    if (op === '>') return left > right;
+    if (op === '<') return left < right;
+    if (op === '>=') return left >= right;
+    return left <= right;
+  }
+  const l = toNumber(left);
+  const r = toNumber(right);
+  if (op === '=') return l === r;
+  if (op === '<>') return l !== r;
+  if (op === '>') return l > r;
+  if (op === '<') return l < r;
+  if (op === '>=') return l >= r;
+  return l <= r;
+}
+
+export function evaluate(expr: Expr, ctx: EvalContext): CellValue {
+  switch (expr.type) {
+    case 'number':
+      return expr.value;
+    case 'string':
+      return expr.value;
+    case 'boolean':
+      return expr.value;
+    case 'cell':
+      return ctx.getValue(expr.ref);
+    case 'range':
+      throw new Error('A range cannot be used outside of a function call');
+    case 'unary':
+      return -toNumber(evaluate(expr.operand, ctx));
+    case 'binary': {
+      const { op, left, right } = expr;
+      if (op === '+' || op === '-' || op === '*' || op === '/') {
+        const l = toNumber(evaluate(left, ctx));
+        const r = toNumber(evaluate(right, ctx));
+        if (op === '+') return l + r;
+        if (op === '-') return l - r;
+        if (op === '*') return l * r;
+        if (r === 0) throw new Error('Division by zero');
+        return l / r;
+      }
+      return compare(op, evaluate(left, ctx), evaluate(right, ctx));
+    }
+    case 'call':
+      return evaluateCall(expr.name, expr.args, ctx);
+  }
+}
+
+function resolveRangeValues(expr: Expr, ctx: EvalContext): CellValue[] {
+  if (expr.type === 'range') {
+    return expandRange(expr.start, expr.end).map((ref) => ctx.getValue(ref));
+  }
+  return [evaluate(expr, ctx)];
+}
+
+function numericValues(args: Expr[], ctx: EvalContext): number[] {
+  return args
+    .flatMap((a) => resolveRangeValues(a, ctx))
+    .filter((v): v is number => typeof v === 'number');
+}
+
+function evaluateCall(name: string, args: Expr[], ctx: EvalContext): CellValue {
+  switch (name) {
+    case 'SUM':
+      return numericValues(args, ctx).reduce((a, b) => a + b, 0);
+    case 'AVERAGE': {
+      const values = numericValues(args, ctx);
+      if (values.length === 0) throw new Error('AVERAGE requires at least one numeric value');
+      return values.reduce((a, b) => a + b, 0) / values.length;
+    }
+    case 'MIN': {
+      const values = numericValues(args, ctx);
+      if (values.length === 0) throw new Error('MIN requires at least one numeric value');
+      return Math.min(...values);
+    }
+    case 'MAX': {
+      const values = numericValues(args, ctx);
+      if (values.length === 0) throw new Error('MAX requires at least one numeric value');
+      return Math.max(...values);
+    }
+    case 'COUNT':
+      return numericValues(args, ctx).length;
+    case 'IF': {
+      if (args.length !== 3) throw new Error('IF requires exactly 3 arguments');
+      const cond = evaluate(args[0], ctx);
+      return isTruthy(cond) ? evaluate(args[1], ctx) : evaluate(args[2], ctx);
+    }
+    default:
+      throw new Error(`Unknown function: ${name}`);
+  }
+}
