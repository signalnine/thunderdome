+import { type Expr, parseFormula, collectDependencies } from './parser.js';
+import { evaluate, type CellValue, type EvalContext } from './evaluator.js';
+import { isCellRef, normalizeCellRef } from './cellRef.js';
+
+interface Cell {
+  raw: string | number | boolean;
+  formula: Expr | null;
+  deps: Set<string>;
+  value: CellValue;
+}
+
+export class Spreadsheet {
+  private cells = new Map<string, Cell>();
+  private dependents = new Map<string, Set<string>>();
+
+  set(cellRef: string, value: string | number | boolean): void {
+    const ref = this.normalize(cellRef);
+
+    let formula: Expr | null = null;
+    let deps: Set<string> = new Set();
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      formula = parseFormula(value.slice(1));
+      deps = collectDependencies(formula);
+    }
+
+    if (formula) {
+      this.checkForCycle(ref, deps);
+    }
+
+    const oldDeps = this.cells.get(ref)?.deps ?? new Set<string>();
+    for (const d of oldDeps) {
+      this.dependents.get(d)?.delete(ref);
+    }
+    for (const d of deps) {
+      if (!this.dependents.has(d)) this.dependents.set(d, new Set());
+      this.dependents.get(d)!.add(ref);
+    }
+
+    this.cells.set(ref, { raw: value, formula, deps, value: null });
+
+    this.recompute(ref);
+    this.propagate(ref);
+  }
+
+  get(cellRef: string): CellValue {
+    const ref = this.normalize(cellRef);
+    return this.cells.get(ref)?.value ?? null;
+  }
+
+  getDisplay(cellRef: string): string {
+    const value = this.get(cellRef);
+    if (value === null) return '';
+    return String(value);
+  }
+
+  getCells(): Map<string, CellValue> {
+    const result = new Map<string, CellValue>();
+    for (const [ref, cell] of this.cells) {
+      if (cell.value !== null) result.set(ref, cell.value);
+    }
+    return result;
+  }
+
+  private normalize(ref: string): string {
+    const upper = ref.toUpperCase();
+    if (!isCellRef(upper)) {
+      throw new Error(`Invalid cell reference: ${ref}`);
+    }
+    return normalizeCellRef(upper);
+  }
+
+  private checkForCycle(ref: string, deps: Set<string>): void {
+    const visited = new Set<string>();
+    const stack = [...deps];
+    while (stack.length > 0) {
+      const current = stack.pop()!;
+      if (current === ref) {
+        throw new Error(`Circular reference detected: setting ${ref} would create a cycle`);
+      }
+      if (visited.has(current)) continue;
+      visited.add(current);
+      const currentDeps = this.cells.get(current)?.deps;
+      if (currentDeps) {
+        for (const d of currentDeps) stack.push(d);
+      }
+    }
+  }
+
+  private recompute(ref: string): void {
+    const cell = this.cells.get(ref);
+    if (!cell) return;
+    if (cell.formula) {
+      const ctx: EvalContext = {
+        getValue: (r: string) => this.cells.get(r)?.value ?? 0,
+      };
+      cell.value = evaluate(cell.formula, ctx);
+    } else {
+      cell.value = cell.raw;
+    }
+  }
+
+  private propagate(startRef: string): void {
+    const affected = new Set<string>();
+    const queue = [startRef];
+    while (queue.length > 0) {
+      const current = queue.shift()!;
+      for (const dep of this.dependents.get(current) ?? []) {
+        if (!affected.has(dep)) {
+          affected.add(dep);
+          queue.push(dep);
+        }
+      }
+    }
+    if (affected.size === 0) return;
+
+    const inDegree = new Map<string, number>();
+    for (const node of affected) {
+      let count = 0;
+      for (const d of this.cells.get(node)?.deps ?? []) {
+        if (affected.has(d)) count++;
+      }
+      inDegree.set(node, count);
+    }
+
+    const ready = [...affected].filter((n) => inDegree.get(n) === 0);
+    const order: string[] = [];
+    while (ready.length > 0) {
+      const node = ready.shift()!;
+      order.push(node);
+      for (const dependent of this.dependents.get(node) ?? []) {
+        if (!affected.has(dependent)) continue;
+        const newDegree = (inDegree.get(dependent) ?? 0) - 1;
+        inDegree.set(dependent, newDegree);
+        if (newDegree === 0) ready.push(dependent);
+      }
+    }
+
+    for (const node of order) {
+      this.recompute(node);
+    }
+  }
+}
