new file mode 100644
index 0000000..2e738a6
--- /dev/null
+++ b/src/cellRef.ts
@@ -0,0 +1,71 @@
+// Utilities for converting between A1-style cell references and (row, col) coordinates.
+
+export interface CellCoord {
+  col: number; // 0-based
+  row: number; // 0-based
+}
+
+const CELL_REF_RE = /^([A-Za-z]+)(\d+)$/;
+
+export function isCellRef(ref: string): boolean {
+  return CELL_REF_RE.test(ref);
+}
+
+export function parseCellRef(ref: string): CellCoord {
+  const match = CELL_REF_RE.exec(ref);
+  if (!match) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  const [, colLetters, rowDigits] = match;
+  return {
+    col: columnLettersToIndex(colLetters.toUpperCase()),
+    row: parseInt(rowDigits, 10) - 1,
+  };
+}
+
+export function columnLettersToIndex(letters: string): number {
+  let index = 0;
+  for (let i = 0; i < letters.length; i++) {
+    index = index * 26 + (letters.charCodeAt(i) - 64);
+  }
+  return index - 1;
+}
+
+export function columnIndexToLetters(index: number): string {
+  let n = index + 1;
+  let letters = '';
+  while (n > 0) {
+    const remainder = (n - 1) % 26;
+    letters = String.fromCharCode(65 + remainder) + letters;
+    n = Math.floor((n - 1) / 26);
+  }
+  return letters;
+}
+
+export function coordToRef({ col, row }: CellCoord): string {
+  return `${columnIndexToLetters(col)}${row + 1}`;
+}
+
+// Normalizes a cell reference to a canonical uppercase form, e.g. "a1" -> "A1".
+export function normalizeCellRef(ref: string): string {
+  return coordToRef(parseCellRef(ref));
+}
+
+// Expands a range like "A1:C3" into an ordered list of canonical cell references.
+export function expandRange(startRef: string, endRef: string): string[] {
+  const start = parseCellRef(startRef);
+  const end = parseCellRef(endRef);
+
+  const minCol = Math.min(start.col, end.col);
+  const maxCol = Math.max(start.col, end.col);
+  const minRow = Math.min(start.row, end.row);
+  const maxRow = Math.max(start.row, end.row);
+
+  const cells: string[] = [];
+  for (let row = minRow; row <= maxRow; row++) {
+    for (let col = minCol; col <= maxCol; col++) {
+      cells.push(coordToRef({ col, row }));
+    }
+  }
+  return cells;
+}
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..2914a34
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,205 @@
+// Evaluates a formula AST against a set of resolved cell values.
+
+import { AstNode, ComparisonOp, ArithmeticOp } from './parser.js';
+import { expandRange } from './cellRef.js';
+
+export type CellValue = number | string | boolean | null;
+
+export class FormulaError extends Error {
+  code: string;
+
+  constructor(code: string, message?: string) {
+    super(message ?? code);
+    this.code = code;
+    this.name = 'FormulaError';
+  }
+}
+
+export interface EvalContext {
+  getCellValue(ref: string): CellValue;
+}
+
+function toNumber(value: CellValue): number {
+  if (typeof value === 'number') return value;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+  if (value === null) return 0;
+  if (typeof value === 'string') {
+    const parsed = parseFloat(value);
+    if (!Number.isNaN(parsed) && value.trim() !== '') return parsed;
+  }
+  throw new FormulaError('#VALUE!', `Cannot convert '${value}' to a number`);
+}
+
+function isNumeric(value: CellValue): value is number {
+  return typeof value === 'number';
+}
+
+function valuesEqual(a: CellValue, b: CellValue): boolean {
+  if (typeof a === 'number' && typeof b === 'number') return a === b;
+  if (typeof a === 'boolean' || typeof b === 'boolean') return a === b;
+  return String(a) === String(b);
+}
+
+function collectRangeValues(start: string, end: string, ctx: EvalContext): CellValue[] {
+  return expandRange(start, end).map((ref) => ctx.getCellValue(ref));
+}
+
+function applyArithmetic(op: ArithmeticOp, left: CellValue, right: CellValue): number {
+  const l = toNumber(left);
+  const r = toNumber(right);
+  switch (op) {
+    case '+':
+      return l + r;
+    case '-':
+      return l - r;
+    case '*':
+      return l * r;
+    case '/':
+      if (r === 0) throw new FormulaError('#DIV/0!', 'Division by zero');
+      return l / r;
+  }
+}
+
+function applyComparison(op: ComparisonOp, left: CellValue, right: CellValue): boolean {
+  if (typeof left === 'number' && typeof right === 'number') {
+    switch (op) {
+      case '>':
+        return left > right;
+      case '<':
+        return left < right;
+      case '>=':
+        return left >= right;
+      case '<=':
+        return left <= right;
+      case '=':
+        return left === right;
+      case '<>':
+        return left !== right;
+    }
+  }
+  switch (op) {
+    case '>':
+      return String(left) > String(right);
+    case '<':
+      return String(left) < String(right);
+    case '>=':
+      return String(left) >= String(right);
+    case '<=':
+      return String(left) <= String(right);
+    case '=':
+      return valuesEqual(left, right);
+    case '<>':
+      return !valuesEqual(left, right);
+  }
+}
+
+function callFunction(name: string, args: AstNode[], ctx: EvalContext): CellValue {
+  switch (name) {
+    case 'SUM': {
+      const values = flattenArgValues(args, ctx).filter(isNumeric);
+      return values.reduce((sum, v) => sum + v, 0);
+    }
+    case 'AVERAGE': {
+      const values = flattenArgValues(args, ctx).filter(isNumeric);
+      if (values.length === 0) throw new FormulaError('#DIV/0!', 'AVERAGE of empty range');
+      return values.reduce((sum, v) => sum + v, 0) / values.length;
+    }
+    case 'MIN': {
+      const values = flattenArgValues(args, ctx).filter(isNumeric);
+      if (values.length === 0) return 0;
+      return Math.min(...values);
+    }
+    case 'MAX': {
+      const values = flattenArgValues(args, ctx).filter(isNumeric);
+      if (values.length === 0) return 0;
+      return Math.max(...values);
+    }
+    case 'COUNT': {
+      const values = flattenArgValues(args, ctx).filter(isNumeric);
+      return values.length;
+    }
+    case 'IF': {
+      if (args.length !== 3) {
+        throw new FormulaError('#VALUE!', 'IF requires exactly 3 arguments');
+      }
+      const condition = evaluate(args[0], ctx);
+      return condition ? evaluate(args[1], ctx) : evaluate(args[2], ctx);
+    }
+    default:
+      throw new FormulaError('#NAME?', `Unknown function '${name}'`);
+  }
+}
+
+function flattenArgValues(args: AstNode[], ctx: EvalContext): CellValue[] {
+  const values: CellValue[] = [];
+  for (const arg of args) {
+    if (arg.type === 'range') {
+      values.push(...collectRangeValues(arg.start, arg.end, ctx));
+    } else {
+      values.push(evaluate(arg, ctx));
+    }
+  }
+  return values;
+}
+
+export function evaluate(node: AstNode, ctx: EvalContext): CellValue {
+  switch (node.type) {
+    case 'number':
+      return node.value;
+    case 'string':
+      return node.value;
+    case 'boolean':
+      return node.value;
+    case 'cellRef':
+      return ctx.getCellValue(node.ref);
+    case 'range':
+      throw new FormulaError('#VALUE!', 'A range cannot be used as a scalar value');
+    case 'unaryOp': {
+      const operand = toNumber(evaluate(node.operand, ctx));
+      return node.op === '-' ? -operand : operand;
+    }
+    case 'binaryOp': {
+      const comparisonOps = new Set(['>', '<', '>=', '<=', '=', '<>']);
+      const left = evaluate(node.left, ctx);
+      const right = evaluate(node.right, ctx);
+      if (comparisonOps.has(node.op)) {
+        return applyComparison(node.op as ComparisonOp, left, right);
+      }
+      return applyArithmetic(node.op as ArithmeticOp, left, right);
+    }
+    case 'functionCall':
+      return callFunction(node.name, node.args, ctx);
+  }
+}
+
+// Walks the AST to find every individual cell reference it depends on
+// (ranges are expanded into their constituent cells).
+export function collectDependencies(node: AstNode): Set<string> {
+  const deps = new Set<string>();
+
+  function visit(n: AstNode): void {
+    switch (n.type) {
+      case 'cellRef':
+        deps.add(n.ref);
+        break;
+      case 'range':
+        for (const ref of expandRange(n.start, n.end)) deps.add(ref);
+        break;
+      case 'unaryOp':
+        visit(n.operand);
+        break;
+      case 'binaryOp':
+        visit(n.left);
+        visit(n.right);
+        break;
+      case 'functionCall':
+        for (const arg of n.args) visit(arg);
+        break;
+      default:
+        break;
+    }
+  }
+
+  visit(node);
+  return deps;
+}
