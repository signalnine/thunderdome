+import { describe, it, expect, beforeEach } from 'vitest';
+import { Spreadsheet } from './index.js';
+
+describe('Spreadsheet - basic values', () => {
+  let sheet: Spreadsheet;
+
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('stores and retrieves numbers', () => {
+    sheet.set('A1', 42);
+    expect(sheet.get('A1')).toBe(42);
+    expect(sheet.getDisplay('A1')).toBe('42');
+  });
+
+  it('stores and retrieves strings', () => {
+    sheet.set('A1', 'hello');
+    expect(sheet.get('A1')).toBe('hello');
+    expect(sheet.getDisplay('A1')).toBe('hello');
+  });
+
+  it('stores and retrieves booleans', () => {
+    sheet.set('A1', true);
+    expect(sheet.get('A1')).toBe(true);
+    expect(sheet.getDisplay('A1')).toBe('TRUE');
+  });
+
+  it('returns null for empty cells', () => {
+    expect(sheet.get('Z99')).toBeNull();
+    expect(sheet.getDisplay('Z99')).toBe('');
+  });
+
+  it('is case-insensitive and normalizes cell references', () => {
+    sheet.set('a1', 5);
+    expect(sheet.get('A1')).toBe(5);
+    sheet.set('A1', 6);
+    expect(sheet.get('a1')).toBe(6);
+  });
+
+  it('supports multi-letter columns', () => {
+    sheet.set('AA1', 100);
+    expect(sheet.get('AA1')).toBe(100);
+  });
+});
+
+describe('Spreadsheet - formulas and arithmetic', () => {
+  let sheet: Spreadsheet;
+
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('evaluates simple arithmetic', () => {
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('A3', '=A1+A2');
+    expect(sheet.get('A3')).toBe(30);
+    expect(sheet.getDisplay('A3')).toBe('30');
+  });
+
+  it('supports all four arithmetic operators', () => {
+    sheet.set('A1', 10);
+    sheet.set('A2', 3);
+    sheet.set('B1', '=A1+A2');
+    sheet.set('B2', '=A1-A2');
+    sheet.set('B3', '=A1*A2');
+    sheet.set('B4', '=A1/A2');
+    expect(sheet.get('B1')).toBe(13);
+    expect(sheet.get('B2')).toBe(7);
+    expect(sheet.get('B3')).toBe(30);
+    expect(sheet.get('B4')).toBeCloseTo(3.3333, 3);
+  });
+
+  it('respects operator precedence and parentheses', () => {
+    sheet.set('A1', 2);
+    sheet.set('A2', 3);
+    sheet.set('A3', 4);
+    sheet.set('B1', '=A1+A2*A3');
+    sheet.set('B2', '=(A1+A2)*A3');
+    expect(sheet.get('B1')).toBe(14);
+    expect(sheet.get('B2')).toBe(20);
+  });
+
+  it('supports unary minus', () => {
+    sheet.set('A1', 5);
+    sheet.set('A2', '=-A1+10');
+    expect(sheet.get('A2')).toBe(5);
+  });
+
+  it('supports plain numeric literal formulas', () => {
+    sheet.set('A1', '=42');
+    expect(sheet.get('A1')).toBe(42);
+  });
+
+  it('returns #DIV/0! on division by zero', () => {
+    sheet.set('A1', 10);
+    sheet.set('A2', 0);
+    sheet.set('A3', '=A1/A2');
+    expect(sheet.get('A3')).toBe('#DIV/0!');
+  });
+});
+
+describe('Spreadsheet - reactive updates', () => {
+  let sheet: Spreadsheet;
+
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('recomputes dependents when a source cell changes', () => {
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('A3', '=A1+A2');
+    expect(sheet.get('A3')).toBe(30);
+
+    sheet.set('A1', 50);
+    expect(sheet.get('A3')).toBe(70);
+  });
+
+  it('propagates through multiple levels of dependency', () => {
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1*2');
+    sheet.set('C1', '=B1+1');
+    sheet.set('D1', '=C1*10');
+    expect(sheet.get('D1')).toBe(30);
+
+    sheet.set('A1', 5);
+    expect(sheet.get('B1')).toBe(10);
+    expect(sheet.get('C1')).toBe(11);
+    expect(sheet.get('D1')).toBe(110);
+  });
+
+  it('updates fan-out dependents that share a common source', () => {
+    sheet.set('A1', 10);
+    sheet.set('B1', '=A1+1');
+    sheet.set('C1', '=A1+2');
+    sheet.set('D1', '=B1+C1');
+    expect(sheet.get('D1')).toBe(23);
+
+    sheet.set('A1', 100);
+    expect(sheet.get('B1')).toBe(101);
+    expect(sheet.get('C1')).toBe(102);
+    expect(sheet.get('D1')).toBe(203);
+  });
+
+  it('allows redefining a formula cell to a raw value, dropping old deps', () => {
+    sheet.set('A1', 5);
+    sheet.set('B1', '=A1+1');
+    sheet.set('C1', '=B1+1');
+    expect(sheet.get('C1')).toBe(7);
+
+    sheet.set('B1', 100);
+    expect(sheet.get('C1')).toBe(101);
+
+    // A1 no longer affects B1/C1
+    sheet.set('A1', 999);
+    expect(sheet.get('B1')).toBe(100);
+    expect(sheet.get('C1')).toBe(101);
+  });
+});
+
+describe('Spreadsheet - functions', () => {
+  let sheet: Spreadsheet;
+
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('A3', 30);
+    sheet.set('A4', 40);
+    sheet.set('A5', 50);
+  });
+
+  it('SUM sums a column range', () => {
+    sheet.set('B1', '=SUM(A1:A5)');
+    expect(sheet.get('B1')).toBe(150);
+  });
+
+  it('AVERAGE computes the mean of a range', () => {
+    sheet.set('B1', '=AVERAGE(A1:A5)');
+    expect(sheet.get('B1')).toBe(30);
+  });
+
+  it('MIN and MAX find extremes of a range', () => {
+    sheet.set('B1', '=MIN(A1:A5)');
+    sheet.set('B2', '=MAX(A1:A5)');
+    expect(sheet.get('B1')).toBe(10);
+    expect(sheet.get('B2')).toBe(50);
+  });
+
+  it('COUNT counts numeric cells in a range', () => {
+    sheet.set('A6', 'not a number');
+    sheet.set('B1', '=COUNT(A1:A6)');
+    expect(sheet.get('B1')).toBe(5);
+  });
+
+  it('supports row ranges', () => {
+    sheet.set('C1', 1);
+    sheet.set('D1', 2);
+    sheet.set('E1', 3);
+    sheet.set('F1', '=SUM(C1:E1)');
+    expect(sheet.get('F1')).toBe(6);
+  });
+
+  it('supports block (2D) ranges', () => {
+    sheet.set('X1', 1);
+    sheet.set('Y1', 2);
+    sheet.set('X2', 3);
+    sheet.set('Y2', 4);
+    sheet.set('Z1', '=SUM(X1:Y2)');
+    expect(sheet.get('Z1')).toBe(10);
+  });
+
+  it('IF returns the true branch when the condition holds', () => {
+    sheet.set('C1', '=IF(A1>5, "big", "small")');
+    expect(sheet.get('C1')).toBe('big');
+  });
+
+  it('IF returns the false branch when the condition does not hold', () => {
+    sheet.set('C1', '=IF(A1>50, "big", "small")');
+    expect(sheet.get('C1')).toBe('small');
+  });
+
+  it('supports all comparison operators inside IF', () => {
+    sheet.set('C1', '=IF(A1>=10, 1, 0)');
+    sheet.set('C2', '=IF(A1<=9, 1, 0)');
+    sheet.set('C3', '=IF(A1=10, 1, 0)');
+    sheet.set('C4', '=IF(A1<>10, 1, 0)');
+    sheet.set('C5', '=IF(A1<20, 1, 0)');
+    expect(sheet.get('C1')).toBe(1);
+    expect(sheet.get('C2')).toBe(0);
+    expect(sheet.get('C3')).toBe(1);
+    expect(sheet.get('C4')).toBe(0);
+    expect(sheet.get('C5')).toBe(1);
+  });
+
+  it('supports nested function calls', () => {
+    sheet.set('B1', '=IF(SUM(A1:A5)>100, MAX(A1:A5), MIN(A1:A5))');
+    expect(sheet.get('B1')).toBe(50);
+  });
+
+  it('reactively recomputes SUM when a range member changes', () => {
+    sheet.set('B1', '=SUM(A1:A5)');
+    expect(sheet.get('B1')).toBe(150);
+    sheet.set('A3', 300);
+    expect(sheet.get('B1')).toBe(420);
+  });
+});
+
+describe('Spreadsheet - circular references', () => {
+  let sheet: Spreadsheet;
+
+  beforeEach(() => {
+    sheet = new Spreadsheet();
+  });
+
+  it('throws on a direct self-reference', () => {
+    expect(() => sheet.set('A1', '=A1+1')).toThrow();
+  });
+
+  it('throws on a two-cell cycle', () => {
+    sheet.set('A1', '=B1+1');
+    expect(() => sheet.set('B1', '=A1+1')).toThrow();
+  });
+
+  it('throws on an indirect multi-cell cycle', () => {
+    sheet.set('A1', '=B1');
+    sheet.set('B1', '=C1');
+    expect(() => sheet.set('C1', '=A1')).toThrow();
+  });
+
+  it('does not corrupt state when a cyclic set is rejected', () => {
+    sheet.set('A1', 5);
+    sheet.set('B1', '=A1+1');
+    expect(() => sheet.set('A1', '=B1+1')).toThrow();
+    // A1 should retain its previous value since the cyclic set was rejected
+    expect(sheet.get('A1')).toBe(5);
+    expect(sheet.get('B1')).toBe(6);
+  });
+
+  it('allows a range formula that does not include itself', () => {
+    sheet.set('A1', 1);
+    sheet.set('A2', 2);
+    expect(() => sheet.set('A3', '=SUM(A1:A2)')).not.toThrow();
+  });
+
+  it('throws when a range formula would include itself', () => {
+    sheet.set('A1', 1);
+    expect(() => sheet.set('A3', '=SUM(A1:A3)')).toThrow();
+  });
+});
+
+describe('Spreadsheet - getCells', () => {
+  it('returns all non-empty cells with computed values', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('A3', '=A1+A2');
+
+    const cells = sheet.getCells();
+    expect(cells.size).toBe(3);
+    expect(cells.get('A1')).toBe(10);
+    expect(cells.get('A2')).toBe(20);
+    expect(cells.get('A3')).toBe(30);
+  });
+
+  it('reflects reactive updates', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 1);
+    sheet.set('B1', '=A1+1');
+    sheet.set('A1', 9);
+    expect(sheet.getCells().get('B1')).toBe(10);
+  });
+});
