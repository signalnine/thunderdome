|| typeof b === 'boolean') return a === b;\n  return String(a) === String(b);\n}\n\nfunction collectRangeValues(start: string, end: string, ctx: EvalContext): CellValue[] {\n  return expandRange(start, end).map((ref) => ctx.getCellValue(ref));\n}\n\nfunction applyArithmetic(op: ArithmeticOp, left: CellValue, right: CellValue): number {\n  const l = toNumber(left);\n  const r = toNumber(right);\n  switch (op) {\n    case '+':\n      return l + r;\n    case '-':\n      return l - r;\n    case '*':\n      return l * r;\n    case '/':\n      if (r === 0) throw new FormulaError('#DIV/0!', 'Division by zero');\n      return l / r;\n  }\n}\n\nfunction applyComparison(op: ComparisonOp, left: CellValue, right: CellValue): boolean {\n  if (typeof left === 'number' && typeof right === 'number') {\n    switch (op) {\n      case '>':\n        return left > right;\n      case '<':\n        return left < right;\n      case '>=':\n        return left >= right;\n      case '<=':\n        return left <= right;\n      case '=':\n        return left === right;\n      case '<>':\n        return left !== right;\n    }\n  }\n  switch (op) {\n    case '>':\n      return String(left) > String(right);\n    case '<':\n      return String(left) < String(right);\n    case '>=':\n      return String(left) >= String(right);\n    case '<=':\n      return String(left) <= String(right);\n    case '=':\n      return valuesEqual(left, right);\n    case '<>':\n      return !valuesEqual(left, right);\n  }\n}\n\nfunction callFunction(name: string, args: AstNode[], ctx: EvalContext): CellValue {\n  switch (name) {\n    case 'SUM': {\n      const values = flattenArgValues(args, ctx).filter(isNumeric);\n      return values.reduce((sum, v) => sum + v, 0);\n    }\n    case 'AVERAGE': {\n      const values = flattenArgValues(args, ctx).filter(isNumeric);\n      if (values.length === 0) throw new FormulaError('#DIV/0!', 'AVERAGE of empty range');\n      return values.reduce((sum, v) => sum + v, 0) / values.leng