+// Tokenizer and recursive-descent parser for spreadsheet formulas.
+
+export type ComparisonOp = '>' | '<' | '>=' | '<=' | '=' | '<>';
+export type ArithmeticOp = '+' | '-' | '*' | '/';
+
+export type AstNode =
+  | { type: 'number'; value: number }
+  | { type: 'string'; value: string }
+  | { type: 'boolean'; value: boolean }
+  | { type: 'cellRef'; ref: string }
+  | { type: 'range'; start: string; end: string }
+  | { type: 'binaryOp'; op: ArithmeticOp | ComparisonOp; left: AstNode; right: AstNode }
+  | { type: 'unaryOp'; op: '+' | '-'; operand: AstNode }
+  | { type: 'functionCall'; name: string; args: AstNode[] };
+
+type TokenType = 'NUMBER' | 'STRING' | 'IDENT' | 'OP' | 'EOF';
+
+interface Token {
+  type: TokenType;
+  value: string;
+}
+
+const MULTI_CHAR_OPS = ['>=', '<=', '<>'];
+const SINGLE_CHAR_OPS = new Set(['+', '-', '*', '/', '(', ')', ',', ':', '>', '<', '=']);
+
+function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+
+  while (i < input.length) {
+    const ch = input[i];
+
+    if (/\s/.test(ch)) {
+      i++;
+      continue;
+    }
+
+    if (ch === '"') {
+      let j = i + 1;
+      let value = '';
+      while (j < input.length && input[j] !== '"') {
+        value += input[j];
+        j++;
+      }
+      if (j >= input.length) {
+        throw new Error(`Unterminated string literal in formula: ${input}`);
+      }
+      tokens.push({ type: 'STRING', value });
+      i = j + 1;
+      continue;
+    }
+
+    if (/[0-9]/.test(ch) || (ch === '.' && /[0-9]/.test(input[i + 1] ?? ''))) {
+      let j = i;
+      let value = '';
+      while (j < input.length && /[0-9.]/.test(input[j])) {
+        value += input[j];
+        j++;
+      }
+      tokens.push({ type: 'NUMBER', value });
+      i = j;
+      continue;
+    }
+
+    if (/[A-Za-z_]/.test(ch)) {
+      let j = i;
+      let value = '';
+      while (j < input.length && /[A-Za-z0-9_]/.test(input[j])) {
+        value += input[j];
+        j++;
+      }
+      tokens.push({ type: 'IDENT', value });
+      i = j;
+      continue;
+    }
+
+    const twoChar = input.slice(i, i + 2);
+    if (MULTI_CHAR_OPS.includes(twoChar)) {
+      tokens.push({ type: 'OP', value: twoChar });
+      i += 2;
+      continue;
+    }
+
+    if (SINGLE_CHAR_OPS.has(ch)) {
+      tokens.push({ type: 'OP', value: ch });
+      i++;
+      continue;
+    }
+
+    throw new Error(`Unexpected character '${ch}' in formula: ${input}`);
+  }
+
+  tokens.push({ type: 'EOF', value: '' });
+  return tokens;
+}
+
+const CELL_REF_RE = /^[A-Za-z]+[0-9]+$/;
+
+class Parser {
+  private tokens: Token[];
+  private pos = 0;
+
+  constructor(tokens: Token[]) {
+    this.tokens = tokens;
+  }
+
+  private peek(): Token {
+    return this.tokens[this.pos];
+  }
+
+  private next(): Token {
+    return this.tokens[this.pos++];
+  }
+
+  private expectOp(value: string): void {
+    const token = this.next();
+    if (token.type !== 'OP' || token.value !== value) {
+      throw new Error(`Expected '${value}' but found '${token.value || token.type}'`);
+    }
+  }
+
+  parseExpression(): AstNode {
+    const node = this.parseComparison();
+    if (this.peek().type !== 'EOF') {
+      throw new Error(`Unexpected token '${this.peek().value}' in formula`);
+    }
+    return node;
+  }
+
+  private parseComparison(): AstNode {
+    let left = this.parseAddition();
+    const comparisonOps = new Set(['>', '<', '>=', '<=', '=', '<>']);
+    while (this.peek().type === 'OP' && comparisonOps.has(this.peek().value)) {
+      const op = this.next().value as ComparisonOp;
+      const right = this.parseAddition();
+      left = { type: 'binaryOp', op, left, right };
+    }
+    return left;
+  }
+
+  private parseAddition(): AstNode {
+    let left = this.parseTerm();
+    while (this.peek().type === 'OP' && (this.peek().value === '+' || this.peek().value === '-')) {
+      const op = this.next().value as ArithmeticOp;
+      const right = this.parseTerm();
+      left = { type: 'binaryOp', op, left, right };
+    }
+    return left;
+  }
+
+  private parseTerm(): AstNode {
+    let left = this.parseUnary();
+    while (this.peek().type === 'OP' && (this.peek().value === '*' || this.peek().value === '/')) {
+      const op = this.next().value as ArithmeticOp;
+      const right = this.parseUnary();
+      left = { type: 'binaryOp', op, left, right };
+    }
+    return left;
+  }
+
+  private parseUnary(): AstNode {
+    if (this.peek().type === 'OP' && (this.peek().value === '+' || this.peek().value === '-')) {
+      const op = this.next().value as '+' | '-';
+      const operand = this.parseUnary();
+      return { type: 'unaryOp', op, operand };
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): AstNode {
+    const token = this.peek();
+
+    if (token.type === 'NUMBER') {
+      this.next();
+      return { type: 'number', value: parseFloat(token.value) };
+    }
+
+    if (token.type === 'STRING') {
+      this.next();
+      return { type: 'string', value: token.value };
+    }
+
+    if (token.type === 'OP' && token.value === '(') {
+      this.next();
+      const node = this.parseComparison();
+      this.expectOp(')');
+      return node;
+    }
+
+    if (token.type === 'IDENT') {
+      this.next();
+      const upper = token.value.toUpperCase();
+
+      if (upper === 'TRUE' || upper === 'FALSE') {
+        return { type: 'boolean', value: upper === 'TRUE' };
+      }
+
+      if (this.peek().type === 'OP' && this.peek().value === '(') {
+        this.next();
+        const args: AstNode[] = [];
+        if (!(this.peek().type === 'OP' && this.peek().value === ')')) {
+          args.push(this.parseComparison());
+          while (this.peek().type === 'OP' && this.peek().value === ',') {
+            this.next();
+            args.push(this.parseComparison());
+          }
+        }
+        this.expectOp(')');
+        return { type: 'functionCall', name: upper, args };
+      }
+
+      if (this.peek().type === 'OP' && this.peek().value === ':') {
+        if (!CELL_REF_RE.test(token.value)) {
+          throw new Error(`Invalid range start reference: ${token.value}`);
+        }
+        this.next();
+        const endToken = this.next();
+        if (endToken.type !== 'IDENT' || !CELL_REF_RE.test(endToken.value)) {
+          throw new Error(`Invalid range end reference: ${endToken.value}`);
+        }
+        return { type: 'range', start: token.value.toUpperCase(), end: endToken.value.toUpperCase() };
+      }
+
+      if (CELL_REF_RE.test(token.value)) {
+        return { type: 'cellRef', ref: token.value.toUpperCase() };
+      }
+
+      throw new Error(`Unrecognized identifier '${token.value}' in formula`);
+    }
+
+    throw new Error(`Unexpected token '${token.value || token.type}' in formula`);
+  }
+}
+
+export function parseFormula(formula: string): AstNode {
+  const tokens = tokenize(formula);
+  const parser = new Parser(tokens);
+  return parser.parseExpression();
+}
