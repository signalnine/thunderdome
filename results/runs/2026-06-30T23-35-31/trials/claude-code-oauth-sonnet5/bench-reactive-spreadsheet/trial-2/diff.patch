+// Reactive spreadsheet engine: stores raw cell values/formulas, tracks a
+// dependency graph between cells, and recomputes dependents automatically
+// whenever a cell changes.
+
+import { normalizeCellRef } from './cellRef.js';
+import { parseFormula, AstNode } from './parser.js';
+import { evaluate, collectDependencies, CellValue, FormulaError, EvalContext } from './evaluator.js';
+
+interface CellRecord {
+  raw: string | number | boolean;
+  ast: AstNode | null; // non-null when the cell holds a formula
+  value: CellValue;
+}
+
+export class Spreadsheet {
+  private cells = new Map<string, CellRecord>();
+  // dependencies.get(a) = set of cells that `a` reads from
+  private dependencies = new Map<string, Set<string>>();
+  // dependents.get(a) = set of cells that read from `a`
+  private dependents = new Map<string, Set<string>>();
+
+  set(cellRef: string, value: string | number | boolean): void {
+    const ref = normalizeCellRef(cellRef);
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      this.setFormula(ref, value);
+    } else {
+      this.setRawValue(ref, value);
+    }
+  }
+
+  get(cellRef: string): CellValue {
+    const ref = normalizeCellRef(cellRef);
+    const record = this.cells.get(ref);
+    return record ? record.value : null;
+  }
+
+  getDisplay(cellRef: string): string {
+    const value = this.get(cellRef);
+    if (value === null) return '';
+    if (typeof value === 'boolean') return value ? 'TRUE' : 'FALSE';
+    return String(value);
+  }
+
+  getCells(): Map<string, CellValue> {
+    const result = new Map<string, CellValue>();
+    for (const [ref, record] of this.cells) {
+      result.set(ref, record.value);
+    }
+    return result;
+  }
+
+  private setRawValue(ref: string, value: string | number | boolean): void {
+    this.clearDependencies(ref);
+    this.cells.set(ref, { raw: value, ast: null, value });
+    this.recomputeAffected(ref);
+  }
+
+  private setFormula(ref: string, formulaText: string): void {
+    const ast = parseFormula(formulaText.slice(1));
+    const newDeps = collectDependencies(ast);
+
+    if (this.wouldCreateCycle(ref, newDeps)) {
+      throw new Error(`Circular reference detected when setting ${ref}`);
+    }
+
+    this.clearDependencies(ref);
+    this.dependencies.set(ref, newDeps);
+    for (const dep of newDeps) {
+      this.addDependent(dep, ref);
+    }
+
+    this.cells.set(ref, { raw: formulaText, ast, value: null });
+    this.recomputeAffected(ref);
+  }
+
+  private clearDependencies(ref: string): void {
+    const oldDeps = this.dependencies.get(ref);
+    if (oldDeps) {
+      for (const dep of oldDeps) {
+        this.dependents.get(dep)?.delete(ref);
+      }
+    }
+    this.dependencies.delete(ref);
+  }
+
+  private addDependent(dep: string, dependent: string): void {
+    let set = this.dependents.get(dep);
+    if (!set) {
+      set = new Set();
+      this.dependents.set(dep, set);
+    }
+    set.add(dependent);
+  }
+
+  // Determines whether assigning `newDeps` as the dependency set of `ref`
+  // would introduce a cycle, without mutating any state.
+  private wouldCreateCycle(ref: string, newDeps: Set<string>): boolean {
+    if (newDeps.has(ref)) return true;
+
+    const visited = new Set<string>();
+    const stack = [...newDeps];
+
+    while (stack.length > 0) {
+      const node = stack.pop() as string;
+      if (node === ref) return true;
+      if (visited.has(node)) continue;
+      visited.add(node);
+
+      const deps = this.dependencies.get(node);
+      if (deps) {
+        for (const dep of deps) stack.push(dep);
+      }
+    }
+
+    return false;
+  }
+
+  // Recomputes `ref` (if it's a formula) and every cell that transitively
+  // depends on it, in dependency order.
+  private recomputeAffected(ref: string): void {
+    const affected = new Set<string>();
+    const queue = [ref];
+    while (queue.length > 0) {
+      const node = queue.shift() as string;
+      if (affected.has(node)) continue;
+      affected.add(node);
+      const deps = this.dependents.get(node);
+      if (deps) {
+        for (const dependent of deps) queue.push(dependent);
+      }
+    }
+
+    const order = this.topologicalOrder(affected);
+
+    const ctx: EvalContext = {
+      getCellValue: (cellRef: string): CellValue => {
+        const record = this.cells.get(normalizeCellRef(cellRef));
+        return record ? record.value : null;
+      },
+    };
+
+    for (const node of order) {
+      const record = this.cells.get(node);
+      if (!record || record.ast === null) continue;
+      try {
+        record.value = evaluate(record.ast, ctx);
+      } catch (err) {
+        record.value = err instanceof FormulaError ? err.code : '#ERROR!';
+      }
+    }
+  }
+
+  // Dependency-first ordering (DFS postorder) restricted to `affected`.
+  private topologicalOrder(affected: Set<string>): string[] {
+    const visited = new Set<string>();
+    const order: string[] = [];
+
+    const visit = (node: string): void => {
+      if (visited.has(node)) return;
+      visited.add(node);
+      const deps = this.dependencies.get(node);
+      if (deps) {
+        for (const dep of deps) {
+          if (affected.has(dep)) visit(dep);
+        }
+      }
+      order.push(node);
+    };
+
+    for (const node of affected) visit(node);
+    return order;
+  }
+}
+
+export type { CellValue } from './evaluator.js';
