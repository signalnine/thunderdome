+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HHnMR3rCSG3TCPFi28uu1Z","type":"tool_result","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/events/bus.js';\nimport { InventoryRepository } from '../src/inventory/repository.js';\nimport { InventoryService } from '../src/inventory/service.js';\nimport { ORDER_EVENTS } from '../src/events/types.js';\n\ndescribe('InventoryService', () => {\n  let bus: EventBus;\n  let repo: InventoryRepository;\n  let service: InventoryService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    repo = new InventoryRepository();\n    service = new InventoryService(repo, bus);\n    service.registerHandlers();\n  });\n\n  it('reserves stock on order.created', async () => {\n    service.setStock('SKU-1', 10);\n    await bus.emit(ORDER_EVENTS.CREATED, {\n      orderId: 'O1',\n      items: [{ productId: 'SKU-1', quantity: 3, unitPrice: 10 }],\n      customerId: 'C1',\n      timestamp: Date.now(),\n    });\n    const stock = service.getStock('SKU-1');\n    expect(stock?.available).toBe(7);\n    expect(stock?.reserved).toBe(3);\n  });\n\n  it('throws when stock is insufficient', async () => {\n    service.setStock('SKU-1', 2);\n    await expect(\n      bus.emit(ORDER_EVENTS.CREATED, {\n        orderId: 'O1',\n        items: [{ productId: 'SKU-1', quantity: 5, unitPrice: 10 }],\n        customerId: 'C1',\n        timestamp: Date.now(),\n      })\n    ).rejects.toThrow('Insufficient stock');\n  });\n\n  it('rolls back partial reservations on failure', async () => {\n    service.setStock('SKU-1', 10);\n    service.setStock('SKU-2', 1);\n    try {\n      await bus.emit(ORDER_EVENTS.CREATED, {\n        orderId: 'O1',\n        items: [\n          { productId: 'SKU-1', quantity: 3, unitPrice: 10 },\n          { productId: 'SKU-2', quantity: 5, unitPrice: 20 },\n        ],\n        customerId: 'C1',\n        timestamp: Date.now(),\n      });\n    } catch { /* expected */ }\n    const stock1 = service.getStock('SKU-1');\n    expect(stock1?.available).toBe(10);\n    expect(stock1?.reserved).toBe(0);\n  });\n\n  it('releases stock on order.cancelled', async () => {\n    service.setStock('SKU-1', 10);\n    // First reserve\n    await bus.emit(ORDER_EVENTS.CREATED, {\n      orderId: 'O1',\n      items: [{ productId: 'SKU-1', quantity: 3, unitPrice: 10 }],\n      customerId: 'C1',\n      timestamp: Date.now(),\n    });\n    // Then cancel\n    await bus.emit(ORDER_EVENTS.CANCELLED, {\n      orderId: 'O1',\n      reason: 'changed mind',\n      status: 'cancelled',\n      items: [{ productId: 'SKU-1', quantity: 3 }],\n      timestamp: Date.now(),\n    });\n    const stock = service.getStock('SKU-1');\n    expect(stock?.available).toBe(10);\n    expect(stock?.reserved).toBe(0);\n  });\n\n  it('reserves stock for concurrent orders independently', async () => {\n    service.setStock('SKU-1', 20);\n    await bus.emit(ORDER_EVENTS.CREATED, {\n      orderId: 'O1',\n      items: [{ productId: 'SKU-1', quantity: 5, unitPrice: 10 }],\n      customerId: 'C1',\n      timestamp: Date.now(),\n    });\n    await bus.emit(ORDER_EVENTS.CREATED, {\n      orderId: 'O2',\n      items: [{ productId: 'SKU-1', quantity: 3, unitPrice: 10 }],\n      customerId: 'C2',\n      timestamp: Date.now(),\n    });\n    const stock = service.getStock('SKU-1');\n    expect(stock?.available).toBe(12);\n    expect(stock?.reserved).toBe(8);\n  });\n});","is_error":false}]},"parent_tool_use_id":null,"session_id":"d4537666-429c-419d-b45e-da6e6ac4f28c","uuid":"af057339-489a-463a-89d9-4228ff9fa906","timestamp":"2026-07-01T00:00:26.814Z","tool_use_result":{"stdout":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/events/bus.js';\nimport { InventoryRepository } from '../src/inventory/repository.js';\nimport { InventoryService } from '../src/inventory/service.js';\nimport { ORDER_EVENTS } from '../src/events/types.js';\n\ndescribe('I