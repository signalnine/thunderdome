st latest = db\n      .prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?')\n      .get(docId) as { v: number | null };\n\n    const room: Room = {\n      docId,\n      content: doc.content,\n      version: latest.v ?? 0,\n      clients: new Set(),\n      opsLog: [],\n    };\n    rooms.set(docId, room);\n    return room;\n  }\n\n  function handleMessage(room: Room, ws: WebSocket, raw: string) {\n    let msg: Record<string, unknown>;\n    try {\n      msg = JSON.parse(raw);\n    } catch {\n      ws.send(JSON.stringify({ type: 'error', message: 'Invalid JSON' }));\n      return;\n    }\n\n    if (msg.type !== 'operation' || typeof msg.operation !== 'object' || msg.operation === null) {\n      ws.send(JSON.stringify({ type: 'error', message: 'Invalid message: expected an operation' }));\n      return;\n    }\n\n    const rawOp = msg.operation as Record<string, unknown>;\n    if (!isValidOpShape(rawOp)) {\n      ws.send(JSON.stringify({ type: 'error', message: 'Invalid operation type or shape' }));\n      return;\n    }\n\n    let op: Operation = rawOp;\n    const baseVersion = typeof msg.version === 'number' ? msg.version : room.version;\n    for (const logged of room.opsLog) {\n      if (logged.version > baseVersion) {\n        op = transformOperation(op, logged.operation);\n      }\n    }\n\n    if (!validateOperation(op, room.content.length)) {\n      ws.send(JSON.stringify({ type: 'error', message: 'Operation out of bounds' }));\n      return;\n    }\n\n    const newContent = applyOperation(room.content, op);\n    const newVersion = room.version + 1;\n\n    db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)').run(\n      room.docId,\n      newVersion,\n      newContent,\n      JSON.stringify(op)\n    );\n    db.prepare('UPDATE documents SET content = ?, updated_at = ? WHERE id = ?').run(\n      newContent,\n      new Date().toISOString(),\n      room.docId\n    );\n\n    room.content = newContent;\n    room.version = newVersion;\n    room.opsLog.push({ version: newVersion, operation: op });\n\n    ws.send(JSON.stringify({ type: 'ack', version: newVersion }));\n\n    for (const client of room.clients) {\n      if (client !== ws && client.readyState === WebSocket.OPEN) {\n        client.send(JSON.stringify({ type: 'operation', operation: op, version: newVersion }));\n      }\n    }\n  }\n\n  function handleConnection(ws: WebSocket, docId: string) {\n    const room = getOrCreateRoom(docId);\n    if (!room) {\n      ws.send(JSON.stringify({ type: 'error', message: 'Document not found' }));\n      ws.close();\n      return;\n    }\n\n    const connectionId = randomUUID();\n    db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(connectionId, docId);\n    room.clients.add(ws);\n\n    ws.send(JSON.stringify({ type: 'sync', content: room.content, version: room.version }));\n\n    ws.on('message', (data) => {\n      handleMessage(room, ws, data.toString());\n    });\n\n    ws.on('close', () => {\n      room.clients.delete(ws);\n      db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);\n      if (room.clients.size === 0) {\n        rooms.delete(docId);\n      }\n    });\n  }\n\n  server.on('upgrade', (req, socket, head) => {\n    const url = new URL(req.url ?? '/', 'http://localhost');\n    const docId = decodeURIComponent(url.pathname.slice(1));\n    wss.handleUpgrade(req, socket, head, (ws) => {\n      handleConnection(ws, docId);\n    });\n  });\n\n  return wss;\n}\n","structuredPatch":[{"oldStart":18,"oldLines":7,"newStart":18,"newLines":7,"lines":["   opsLog: LoggedOp[];"," }"," ","-function isValidOpShape(op: Record<string, unknown>): op is Operation {","+function isValidOpShape(op: Record<string, unknown>): boolean {","   if (op.type === 'insert') {","     return typeof op.position === 'number' && typeof op.text === 'string';","   }"]}],"userModified":false,"replaceAll":false}}
