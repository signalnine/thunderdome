@@ -0,0 +1,88 @@
+import type { Operation } from './models.js';
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+export function validateOperation(op: Operation, contentLength: number): boolean {
+  if (op.type === 'insert') {
+    return (
+      Number.isInteger(op.position) &&
+      op.position >= 0 &&
+      op.position <= contentLength &&
+      typeof op.text === 'string'
+    );
+  }
+  if (op.type === 'delete') {
+    return (
+      Number.isInteger(op.position) &&
+      Number.isInteger(op.count) &&
+      op.position >= 0 &&
+      op.count >= 0 &&
+      op.position + op.count <= contentLength
+    );
+  }
+  return false;
+}
+
+/**
+ * Transforms `op` so it can be applied after `against` has already been applied,
+ * preserving intent. Ties on equal insert positions resolve by placing `op` after `against`.
+ */
+export function transformOperation(op: Operation, against: Operation): Operation {
+  if (against.type === 'insert') {
+    return transformAgainstInsert(op, against.position, against.text.length);
+  }
+  return transformAgainstDelete(op, against.position, against.count);
+}
+
+function transformAgainstInsert(op: Operation, aPos: number, aLen: number): Operation {
+  if (op.type === 'insert') {
+    const newPos = op.position >= aPos ? op.position + aLen : op.position;
+    return { ...op, position: newPos };
+  }
+
+  // op is delete
+  const opEnd = op.position + op.count;
+  if (aPos <= op.position) {
+    return { ...op, position: op.position + aLen };
+  }
+  if (aPos >= opEnd) {
+    return op;
+  }
+  // insertion landed inside the delete range: extend the range to absorb it
+  return { ...op, count: op.count + aLen };
+}
+
+function transformAgainstDelete(op: Operation, aPos: number, aCount: number): Operation {
+  const aEnd = aPos + aCount;
+
+  if (op.type === 'insert') {
+    if (op.position <= aPos) {
+      return op;
+    }
+    if (op.position >= aEnd) {
+      return { ...op, position: op.position - aCount };
+    }
+    return { ...op, position: aPos };
+  }
+
+  // op is delete
+  const opEnd = op.position + op.count;
+  if (aEnd <= op.position) {
+    return { ...op, position: op.position - aCount };
+  }
+  if (aPos >= opEnd) {
+    return op;
+  }
+
+  const overlapStart = Math.max(op.position, aPos);
+  const overlapEnd = Math.min(opEnd, aEnd);
+  const overlapLen = Math.max(0, overlapEnd - overlapStart);
+  const newPosition = op.position <= aPos ? op.position : aPos;
+  const newCount = Math.max(0, op.count - overlapLen);
+  return { ...op, position: newPosition, count: newCount };
+}
