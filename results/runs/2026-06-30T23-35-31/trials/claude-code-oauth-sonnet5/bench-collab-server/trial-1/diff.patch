ody?.content === 'string' ? req.body.content : existing.content;\n\n    db.prepare(\n      \"UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?\"\n    ).run(title, content, req.params.id);\n\n    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id) as Document;\n    res.json(doc);\n  });\n\n  router.delete('/docs/:id', (req, res) => {\n    const existing = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id) as Document | undefined;\n    if (!existing) {\n      res.status(404).json({ message: 'Document not found' });\n      return;\n    }\n    db.prepare('DELETE FROM documents WHERE id = ?').run(req.params.id);\n    res.status(204).send();\n  });\n\n  router.get('/docs/:id/versions', (req, res) => {\n    const existing = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id);\n    if (!existing) {\n      res.status(404).json({ message: 'Document not found' });\n      return;\n    }\n    const versions = db\n      .prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC')\n      .all(req.params.id);\n    res.json(versions);\n  });\n\n  router.get('/docs/:id/versions/:version', (req, res) => {\n    const versionNum = Number(req.params.version);\n    if (!Number.isInteger(versionNum)) {\n      res.status(400).json({ message: 'Invalid version' });\n      return;\n    }\n    const row = db\n      .prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?')\n      .get(req.params.id, versionNum) as VersionRow | undefined;\n    if (!row) {\n      res.status(404).json({ message: 'Version not found' });\n      return;\n    }\n    res.json(row);\n  });\n\n  return router;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":384,"cache_read_input_tokens":59021,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":384},"output_token