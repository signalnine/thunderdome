+import type { Operation } from './models.js';
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+export function validateOperation(op: unknown, contentLength: number): op is Operation {
+  if (typeof op !== 'object' || op === null) return false;
+  const candidate = op as Record<string, unknown>;
+
+  if (candidate.type === 'insert') {
+    if (typeof candidate.position !== 'number' || !Number.isInteger(candidate.position)) return false;
+    if (typeof candidate.text !== 'string') return false;
+    if (candidate.position < 0 || candidate.position > contentLength) return false;
+    return true;
+  }
+
+  if (candidate.type === 'delete') {
+    if (typeof candidate.position !== 'number' || !Number.isInteger(candidate.position)) return false;
+    if (typeof candidate.count !== 'number' || !Number.isInteger(candidate.count)) return false;
+    if (candidate.position < 0 || candidate.count < 0) return false;
+    if (candidate.position + candidate.count > contentLength) return false;
+    return true;
+  }
+
+  return false;
+}
+
+/**
+ * Transforms op1 so it can be applied after op2, given op2 was already
+ * applied to the document op1 was originally computed against.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    if (op1.position < op2.position) {
+      return op1;
+    }
+    // Tie-break: when positions are equal, op1 (the later-arriving op) is
+    // ordered after op2 so both insertions are deterministically preserved.
+    return { ...op1, position: op1.position + op2.text.length };
+  }
+
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    if (op1.position <= op2.position) {
+      return op1;
+    }
+    if (op1.position > op2.position + op2.count) {
+      return { ...op1, position: op1.position - op2.count };
+    }
+    return { ...op1, position: op2.position };
+  }
+
+  if (op1.type === 'delete' && op2.type === 'insert') {
+    if (op2.position <= op1.position) {
+      return { ...op1, position: op1.position + op2.text.length };
+    }
+    if (op2.position >= op1.position + op1.count) {
+      return op1;
+    }
+    // Insertion landed inside the range op1 intends to delete; widen the
+    // delete to also cover the newly inserted text.
+    return { ...op1, count: op1.count + op2.text.length };
+  }
+
+  // delete vs delete
+  const del1 = op1 as Extract<Operation, { type: 'delete' }>;
+  const del2 = op2 as Extract<Operation, { type: 'delete' }>;
+  const start1 = del1.position;
+  const end1 = del1.position + del1.count;
+  const start2 = del2.position;
+  const end2 = del2.position + del2.count;
+
+  if (start1 >= end2) {
+    return { ...del1, position: start1 - del2.count };
+  }
+  if (end1 <= start2) {
+    return del1;
+  }
+
+  const overlapStart = Math.max(start1, start2);
+  const overlapEnd = Math.min(end1, end2);
+  const overlapLen = Math.max(0, overlapEnd - overlapStart);
+  const shift = Math.max(0, Math.min(start1, end2) - start2);
+
+  return {
+    ...del1,
+    position: start1 - shift,
+    count: Math.max(0, del1.count - overlapLen),
+  };
+}
