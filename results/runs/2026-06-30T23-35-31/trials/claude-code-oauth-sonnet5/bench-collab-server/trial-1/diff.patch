+import { WebSocketServer, WebSocket } from 'ws';
+import type { Server } from 'node:http';
+import type Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+import type { Document, Operation } from './models.js';
+
+interface Room {
+  content: string;
+  version: number;
+  history: { version: number; operation: Operation }[];
+  clients: Set<WebSocket>;
+}
+
+interface ClientMeta {
+  docId: string;
+  connectionId: string;
+}
+
+function parseRawOperation(raw: unknown): Operation | null {
+  if (typeof raw !== 'object' || raw === null) return null;
+  const o = raw as Record<string, unknown>;
+
+  if (o.type === 'insert' && typeof o.position === 'number' && Number.isInteger(o.position) && typeof o.text === 'string') {
+    return { type: 'insert', position: o.position, text: o.text };
+  }
+  if (
+    o.type === 'delete' &&
+    typeof o.position === 'number' &&
+    Number.isInteger(o.position) &&
+    typeof o.count === 'number' &&
+    Number.isInteger(o.count)
+  ) {
+    return { type: 'delete', position: o.position, count: o.count };
+  }
+  return null;
+}
+
+export function setupWebSocketServer(server: Server, db: Database.Database): WebSocketServer {
+  const wss = new WebSocketServer({ noServer: true });
+  const rooms = new Map<string, Room>();
+  const clientMeta = new WeakMap<WebSocket, ClientMeta>();
+
+  server.on('upgrade', (req, socket, head) => {
+    wss.handleUpgrade(req, socket, head, (ws) => {
+      wss.emit('connection', ws, req);
+    });
+  });
+
+  function getRoom(docId: string): Room {
+    let room = rooms.get(docId);
+    if (!room) {
+      const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(docId) as Document;
+      const latest = db
+        .prepare('SELECT MAX(version) as maxVersion FROM versions WHERE document_id = ?')
+        .get(docId) as { maxVersion: number | null };
+      room = {
+        content: doc.content,
+        version: latest.maxVersion ?? 0,
+        history: [],
+        clients: new Set(),
+      };
+      rooms.set(docId, room);
+    }
+    return room;
+  }
+
+  function send(ws: WebSocket, payload: Record<string, unknown>): void {
+    if (ws.readyState === WebSocket.OPEN) {
+      ws.send(JSON.stringify(payload));
+    }
+  }
+
+  wss.on('connection', (ws, req) => {
+    const url = new URL(req.url ?? '/', 'http://localhost');
+    const docId = decodeURIComponent(url.pathname.slice(1));
+
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(docId) as Document | undefined;
+    if (!doc) {
+      send(ws, { type: 'error', message: `Document not found: ${docId}` });
+      ws.close();
+      return;
+    }
+
+    const room = getRoom(docId);
+    room.clients.add(ws);
+
+    const connectionId = randomUUID();
+    clientMeta.set(ws, { docId, connectionId });
+    db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(connectionId, docId);
+
+    send(ws, { type: 'sync', content: room.content, version: room.version });
+
+    ws.on('message', (data) => {
+      let parsed: unknown;
+      try {
+        parsed = JSON.parse(data.toString());
+      } catch {
+        send(ws, { type: 'error', message: 'Invalid JSON' });
+        return;
+      }
+
+      if (typeof parsed !== 'object' || parsed === null) {
+        send(ws, { type: 'error', message: 'Invalid message' });
+        return;
+      }
+      const msg = parsed as Record<string, unknown>;
+
+      if (msg.type !== 'operation') {
+        send(ws, { type: 'error', message: 'Unsupported message type' });
+        return;
+      }
+
+      const rawOp = parseRawOperation(msg.operation);
+      if (!rawOp) {
+        send(ws, { type: 'error', message: 'Invalid operation type' });
+        return;
+      }
+
+      const baseVersion = typeof msg.version === 'number' ? msg.version : room.version;
+
+      let transformed: Operation = rawOp;
+      for (const entry of room.history) {
+        if (entry.version > baseVersion) {
+          transformed = transformOperation(transformed, entry.operation);
+        }
+      }
+
+      if (!validateOperation(transformed, room.content.length)) {
+        send(ws, { type: 'error', message: 'Operation out of bounds' });
+        return;
+      }
+
+      const newContent = applyOperation(room.content, transformed);
+      const newVersion = room.version + 1;
+
+      room.content = newContent;
+      room.version = newVersion;
+      room.history.push({ version: newVersion, operation: transformed });
+
+      db.prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?").run(
+        newContent,
+        docId
+      );
+      db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)').run(
+        docId,
+        newVersion,
+        newContent,
+        JSON.stringify(transformed)
+      );
+
+      send(ws, { type: 'ack', version: newVersion });
+
+      for (const client of room.clients) {
+        if (client !== ws) {
+          send(client, { type: 'operation', operation: transformed, version: newVersion });
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      const meta = clientMeta.get(ws);
+      if (meta) {
+        db.prepare('DELETE FROM active_connections WHERE id = ?').run(meta.connectionId);
+      }
+      if (room.clients.size === 0) {
+        rooms.delete(docId);
+      }
+    });
+  });
+
+  return wss;
+}
