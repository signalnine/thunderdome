@@ -0,0 +1,52 @@
+import express, { type Express } from 'express';
+import http from 'node:http';
+import { WebSocketServer } from 'ws';
+import type Database from 'better-sqlite3';
+import { createDb } from './db.js';
+import { createRouter } from './routes.js';
+import { setupWebSocket } from './ws.js';
+
+export interface AppInstance {
+  app: Express;
+  server: http.Server;
+  wss: WebSocketServer;
+  db: Database.Database;
+  start: (port?: number) => Promise<number>;
+  stop: () => Promise<void>;
+}
+
+export function createApp(dbPath?: string): AppInstance {
+  const db = createDb(dbPath);
+
+  const app = express();
+  app.use(express.json());
+  app.use('/docs', createRouter(db));
+
+  const server = http.createServer(app);
+  const wss = new WebSocketServer({ server });
+  setupWebSocket(wss, db);
+
+  const start = (port = 0): Promise<number> =>
+    new Promise((resolve) => {
+      server.listen(port, () => {
+        const addr = server.address();
+        const actualPort = typeof addr === 'object' && addr !== null ? addr.port : port;
+        resolve(actualPort);
+      });
+    });
+
+  const stop = (): Promise<void> =>
+    new Promise((resolve) => {
+      for (const client of wss.clients) {
+        client.terminate();
+      }
+      wss.close(() => {
+        server.close(() => {
+          db.close();
+          resolve();
+        });
+      });
+    });
+
+  return { app, server, wss, db, start, stop };
+}
diff --git a/src/ws.ts b/src/ws.ts
new file mode 100644
index 0000000..5afb3f7
--- /dev/null
+++ b/src/ws.ts
@@ -0,0 +1,131 @@
+import type { WebSocketServer, WebSocket } from 'ws';
+import type Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+import type { Operation } from './models.js';
+
+interface Room {
+  content: string;
+  version: number;
+  clients: Set<WebSocket>;
+  history: { version: number; operation: Operation }[];
+}
+
+function send(ws: WebSocket, message: Record<string, unknown>): void {
+  if (ws.readyState === ws.OPEN) {
+    ws.send(JSON.stringify(message));
+  }
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null;
+}
+
+function parseOperation(value: unknown): Operation | null {
+  if (!isPlainObject(value)) return null;
+  if (value.type === 'insert' || value.type === 'delete') {
+    return value as unknown as Operation;
+  }
+  return null;
+}
+
+export function setupWebSocket(wss: WebSocketServer, db: Database.Database): void {
+  const rooms = new Map<string, Room>();
+
+  wss.on('connection', (ws: WebSocket, req) => {
+    const url = new URL(req.url ?? '/', 'http://localhost');
+    const docId = decodeURIComponent(url.pathname.slice(1));
+
+    const docRow = db.prepare('SELECT content FROM documents WHERE id = ?').get(docId) as
+      | { content: string }
+      | undefined;
+
+    if (!docRow) {
+      send(ws, { type: 'error', message: 'Document not found' });
+      ws.close();
+      return;
+    }
+
+    let room = rooms.get(docId);
+    if (!room) {
+      const latest = db
+        .prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?')
+        .get(docId) as { v: number | null };
+      room = {
+        content: docRow.content,
+        version: latest.v ?? 0,
+        clients: new Set(),
+        history: [],
+      };
+      rooms.set(docId, room);
+    }
+
+    const connectionId = randomUUID();
+    room.clients.add(ws);
+    db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(connectionId, docId);
+
+    send(ws, { type: 'sync', content: room.content, version: room.version });
+
+    ws.on('message', (data) => {
+      const activeRoom = rooms.get(docId);
+      if (!activeRoom) return;
+
+      let parsed: unknown;
+      try {
+        parsed = JSON.parse(data.toString());
+      } catch {
+        send(ws, { type: 'error', message: 'Invalid JSON' });
+        return;
+      }
+
+      if (!isPlainObject(parsed) || parsed.type !== 'operation') {
+        send(ws, { type: 'error', message: 'Invalid message: expected an operation' });
+        return;
+      }
+
+      let op = parseOperation(parsed.operation);
+      if (!op || !validateOperation(op, activeRoom.content.length)) {
+        send(ws, { type: 'error', message: 'Invalid or out-of-bounds operation' });
+        return;
+      }
+
+      const baseVersion = typeof parsed.version === 'number' ? parsed.version : activeRoom.version;
+
+      for (const entry of activeRoom.history) {
+        if (entry.version > baseVersion) {
+          op = transformOperation(op, entry.operation);
+        }
+      }
+
+      if (!validateOperation(op, activeRoom.content.length)) {
+        send(ws, { type: 'error', message: 'Operation out of bounds after transform' });
+        return;
+      }
+
+      activeRoom.content = applyOperation(activeRoom.content, op);
+      activeRoom.version += 1;
+      activeRoom.history.push({ version: activeRoom.version, operation: op });
+
+      db.prepare(
+        'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+      ).run(docId, activeRoom.version, activeRoom.content, JSON.stringify(op));
+      db.prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?").run(
+        activeRoom.content,
+        docId
+      );
+
+      send(ws, { type: 'ack', version: activeRoom.version });
+
+      for (const client of activeRoom.clients) {
+        if (client !== ws) {
+          send(client, { type: 'operation', operation: op, version: activeRoom.version });
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      room?.clients.delete(ws);
+      db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);
+    });
+  });
+}
