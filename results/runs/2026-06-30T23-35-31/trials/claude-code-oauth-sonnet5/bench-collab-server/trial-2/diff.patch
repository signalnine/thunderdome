+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface VersionRow {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+export interface InsertOperation {
+  type: 'insert';
+  position: number;
+  text: string;
+}
+
+export interface DeleteOperation {
+  type: 'delete';
+  position: number;
+  count: number;
+}
+
+export type Operation = InsertOperation | DeleteOperation;
diff --git a/src/ot.ts b/src/ot.ts
new file mode 100644
index 0000000..5b30afa
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,98 @@
+import type { DeleteOperation, InsertOperation, Operation } from './models.js';
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+export function validateOperation(op: Operation, contentLength: number): boolean {
+  if (!op || typeof op !== 'object') return false;
+
+  if (op.type === 'insert') {
+    return (
+      typeof op.position === 'number' &&
+      Number.isInteger(op.position) &&
+      op.position >= 0 &&
+      op.position <= contentLength &&
+      typeof op.text === 'string' &&
+      op.text.length > 0
+    );
+  }
+
+  if (op.type === 'delete') {
+    return (
+      typeof op.position === 'number' &&
+      Number.isInteger(op.position) &&
+      op.position >= 0 &&
+      typeof op.count === 'number' &&
+      Number.isInteger(op.count) &&
+      op.count > 0 &&
+      op.position + op.count <= contentLength
+    );
+  }
+
+  return false;
+}
+
+function transformInsertInsert(op: InsertOperation, other: InsertOperation): InsertOperation {
+  if (other.position <= op.position) {
+    return { ...op, position: op.position + other.text.length };
+  }
+  return { ...op };
+}
+
+function transformInsertDelete(op: InsertOperation, other: DeleteOperation): InsertOperation {
+  const otherEnd = other.position + other.count;
+  if (otherEnd <= op.position) {
+    return { ...op, position: op.position - other.count };
+  }
+  if (other.position >= op.position) {
+    return { ...op };
+  }
+  return { ...op, position: other.position };
+}
+
+function transformDeleteInsert(op: DeleteOperation, other: InsertOperation): DeleteOperation {
+  const opEnd = op.position + op.count;
+  if (other.position <= op.position) {
+    return { ...op, position: op.position + other.text.length };
+  }
+  if (other.position >= opEnd) {
+    return { ...op };
+  }
+  return { ...op, count: op.count + other.text.length };
+}
+
+function transformDeleteDelete(op: DeleteOperation, other: DeleteOperation): DeleteOperation {
+  const opStart = op.position;
+  const opEnd = op.position + op.count;
+  const otherStart = other.position;
+  const otherEnd = other.position + other.count;
+
+  const beforeOverlap = Math.max(0, Math.min(otherEnd, opStart) - otherStart);
+  const overlapStart = Math.max(opStart, otherStart);
+  const overlapEnd = Math.min(opEnd, otherEnd);
+  const overlap = Math.max(0, overlapEnd - overlapStart);
+
+  return {
+    type: 'delete',
+    position: opStart - beforeOverlap,
+    count: Math.max(0, op.count - overlap),
+  };
+}
+
+/** Transforms `op` so it can be applied after `other` has already been applied. */
+export function transformOperation(op: Operation, other: Operation): Operation {
+  if (op.type === 'insert' && other.type === 'insert') {
+    return transformInsertInsert(op, other);
+  }
+  if (op.type === 'insert' && other.type === 'delete') {
+    return transformInsertDelete(op, other);
+  }
+  if (op.type === 'delete' && other.type === 'insert') {
+    return transformDeleteInsert(op, other);
+  }
+  return transformDeleteDelete(op as DeleteOperation, other as DeleteOperation);
+}
