+import { randomUUID } from 'node:crypto';
+
+export type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';
+
+export interface Task {
+  id: string;
+  queueName: string;
+  payload: unknown;
+  status: TaskStatus;
+  createdAt: Date;
+  priority: number;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  dependsOn: string[];
+  lastError?: unknown;
+  failCount: number;
+  seq: number;
+}
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: TaskStatus | 'unknown';
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type ProgressCallback = (info: ProgressInfo) => void;
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: unknown;
+  active: boolean;
+  nextRunAt: Date;
+}
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+export type ShutdownCallback = () => void;
+
+interface QueueState {
+  name: string;
+  tasks: Task[];
+  dlq: Task[];
+  concurrencyLimit: number;
+  processingCount: number;
+  middlewares: Middleware[];
+}
+
+export class TaskQueue {
+  private queues = new Map<string, QueueState>();
+  private tasksById = new Map<string, Task>();
+  private seqCounter = 0;
+
+  private progressMap = new Map<string, ProgressInfo>();
+  private progressCallbacks = new Map<string, Set<ProgressCallback>>();
+
+  private schedules = new Map<string, Schedule>();
+
+  private shuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private shutdownCallbacks: ShutdownCallback[] = [];
+  private shutdownStartTime = 0;
+  private shutdownCompletedCount = 0;
+  private shutdownCancelledCount = 0;
+  private shutdownFinished = false;
+  private shutdownResolveFn: ((summary: ShutdownSummary) => void) | null = null;
+  private shutdownTimeoutHandle: ReturnType<typeof setTimeout> | null = null;
+
+  private getOrCreateQueue(name: string): QueueState {
+    let q = this.queues.get(name);
+    if (!q) {
+      q = {
+        name,
+        tasks: [],
+        dlq: [],
+        concurrencyLimit: Infinity,
+        processingCount: 0,
+        middlewares: [],
+      };
+      this.queues.set(name, q);
+    }
+    return q;
+  }
+
+  private wouldCreateCycle(newTaskId: string, dependsOn: string[]): boolean {
+    const visited = new Set<string>();
+    const stack = [...dependsOn];
+    while (stack.length > 0) {
+      const id = stack.pop() as string;
+      if (id === newTaskId) return true;
+      if (visited.has(id)) continue;
+      visited.add(id);
+      const t = this.tasksById.get(id);
+      if (t) stack.push(...t.dependsOn);
+    }
+    return false;
+  }
+
+  enqueue(queueNameOrPayload: string | unknown, payloadMaybe?: unknown, optionsMaybe?: EnqueueOptions): Task {
+    if (this.shuttingDown) {
+      throw new Error('Cannot enqueue: queue is shutting down');
+    }
+
+    let queueName: string;
+    let payload: unknown;
+    let options: EnqueueOptions;
+
+    if (typeof queueNameOrPayload === 'string') {
+      queueName = queueNameOrPayload;
+      payload = payloadMaybe;
+      options = optionsMaybe ?? {};
+    } else {
+      queueName = 'default';
+      payload = queueNameOrPayload;
+      options = (payloadMaybe as EnqueueOptions | undefined) ?? {};
+    }
+
+    const priority = options.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error(`Priority must be between 1 and 10, got ${priority}`);
+    }
+
+    const dependsOn = options.dependsOn ?? [];
+    for (const depId of dependsOn) {
+      if (!this.tasksById.has(depId)) {
+        throw new Error(`Dependency task not found: ${depId}`);
+      }
+    }
+
+    const id = randomUUID();
+    if (dependsOn.length > 0 && this.wouldCreateCycle(id, dependsOn)) {
+      throw new Error('Circular dependency detected');
+    }
+
+    const now = new Date();
+    const availableAt = options.runAt
+      ? new Date(options.runAt)
+      : new Date(now.getTime() + (options.delay ?? 0));
+
+    const task: Task = {
+      id,
+      queueName,
+      payload,
+      status: 'pending',
+      createdAt: now,
+      priority,
+      availableAt,
+      attempts: 0,
+      maxRetries: options.maxRetries ?? 3,
+      backoffMs: options.backoffMs ?? 1000,
+      dependsOn,
+      failCount: 0,
+      seq: this.seqCounter++,
+    };
+
+    const q = this.getOrCreateQueue(queueName);
+    q.tasks.push(task);
+    this.tasksById.set(id, task);
+
+    return task;
+  }
+
+  private isUnblocked(task: Task): boolean {
+    if (task.dependsOn.length === 0) return true;
+    return task.dependsOn.every((depId) => this.tasksById.get(depId)?.status === 'completed');
+  }
+
+  private compareTasks(a: Task, b: Task): number {
+    if (a.priority !== b.priority) return a.priority - b.priority;
+    const at = a.availableAt.getTime();
+    const bt = b.availableAt.getTime();
+    if (at !== bt) return at - bt;
+    return a.seq - b.seq;
+  }
+
+  dequeue(queueName: string = 'default'): Task | null {
+    const q = this.queues.get(queueName);
+    if (!q) return null;
+    if (q.processingCount >= q.concurrencyLimit) return null;
+
+    const now = Date.now();
+    let bestIdx = -1;
+    let best: Task | null = null;
+
+    for (let i = 0; i < q.tasks.length; i++) {
+      const t = q.tasks[i];
+      if (t.availableAt.getTime() > now) continue;
+      if (!this.isUnblocked(t)) continue;
+      if (!best || this.compareTasks(t, best) < 0) {
+        best = t;
+        bestIdx = i;
+      }
+    }
+
+    if (bestIdx === -1 || !best) return null;
+
+    q.tasks.splice(bestIdx, 1);
+    best.status = 'processing';
+    best.attempts += 1;
+    q.processingCount += 1;
+
+    return best;
+  }
+
+  size(): number {
+    return this.queueSize('default');
+  }
+
+  listQueues(): string[] {
+    return Array.from(this.queues.keys());
+  }
+
+  queueSize(queueName: string): number {
+    const q = this.queues.get(queueName);
+    return q ? q.tasks.length : 0;
+  }
+
+  fail(taskId: string, error?: unknown): void {
+    const task = this.tasksById.get(taskId);
+    if (!task) return;
+    if (task.status !== 'processing') return;
+
+    const q = this.queues.get(task.queueName);
+    if (q) q.processingCount = Math.max(0, q.processingCount - 1);
+
+    task.lastError = error;
+    task.failCount += 1;
+
+    if (task.attempts < task.maxRetries + 1) {
+      const backoff = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + backoff);
+      if (q) q.tasks.push(task);
+    } else {
+      task.status = 'failed';
+      if (q) q.dlq.push(task);
+    }
+  }
+
+  complete(taskId: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task) return;
+    if (task.status !== 'processing') return;
+
+    const q = this.queues.get(task.queueName);
+    if (q) q.processingCount = Math.max(0, q.processingCount - 1);
+
+    task.status = 'completed';
+
+    if (this.shuttingDown && this.shutdownPromise && !this.shutdownFinished) {
+      this.shutdownCompletedCount += 1;
+      this.checkShutdownFinish();
+    }
+  }
+
+  getDLQ(queueName: string): Task[] {
+    const q = this.queues.get(queueName);
+    return q ? [...q.dlq] : [];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    for (const q of this.queues.values()) {
+      const idx = q.dlq.findIndex((t) => t.id === taskId);
+      if (idx !== -1) {
+        const task = q.dlq[idx];
+        q.dlq.splice(idx, 1);
+        task.status = 'pending';
+        task.attempts = 0;
+        task.failCount = 0;
+        task.lastError = undefined;
+        task.availableAt = new Date();
+        q.tasks.push(task);
+        return task;
+      }
+    }
+    return null;
+  }
+
+  clearDLQ(queueName: string): void {
+    const q = this.queues.get(queueName);
+    if (q) q.dlq = [];
+  }
+
+  getDependencies(taskId: string): DependencyInfo[] {
+    const task = this.tasksById.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map((depId) => ({
+      taskId: depId,
+      status: this.tasksById.get(depId)?.status ?? 'unknown',
+    }));
+  }
+
+  setConcurrency(queueName: string, limit: number): void {
+    this.getOrCreateQueue(queueName).concurrencyLimit = limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const q = this.queues.get(queueName);
+    if (!q) return { current: 0, max: Infinity };
+    return { current: q.processingCount, max: q.concurrencyLimit };
+  }
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error(`Progress percent must be between 0 and 100, got ${percent}`);
+    }
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    this.progressMap.set(taskId, info);
+
+    const callbacks = this.progressCallbacks.get(taskId);
+    if (callbacks) {
+      for (const cb of callbacks) cb({ ...info });
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progressMap.get(taskId) ?? null;
+  }
+
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    let callbacks = this.progressCallbacks.get(taskId);
+    if (!callbacks) {
+      callbacks = new Set();
+      this.progressCallbacks.set(taskId, callbacks);
+    }
+    callbacks.add(callback);
+    return () => {
+      callbacks?.delete(callback);
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task) return;
+
+    if (task.status === 'pending') {
+      const q = this.queues.get(task.queueName);
+      if (q) {
+        const idx = q.tasks.findIndex((t) => t.id === taskId);
+        if (idx !== -1) q.tasks.splice(idx, 1);
+      }
+      task.status = 'cancelled';
+    } else if (task.status === 'processing') {
+      const q = this.queues.get(task.queueName);
+      if (q) q.processingCount = Math.max(0, q.processingCount - 1);
+      task.status = 'cancelled';
+
+      if (this.shuttingDown && this.shutdownPromise && !this.shutdownFinished) {
+        this.shutdownCancelledCount += 1;
+        this.checkShutdownFinish();
+      }
+    }
+  }
+
+  private static matchesCronField(value: number, field: string): boolean {
+    if (field === '*') return true;
+    if (field.startsWith('*/')) {
+      const n = parseInt(field.slice(2), 10);
+      return n > 0 && value % n === 0;
+    }
+    return value === parseInt(field, 10);
+  }
+
+  private static cronMatches(date: Date, cronExpression: string): boolean {
+    const parts = cronExpression.trim().split(/\s+/);
+    const [minute, hour, dayOfMonth, month, dayOfWeek] = parts;
+    return (
+      TaskQueue.matchesCronField(date.getUTCMinutes(), minute) &&
+      TaskQueue.matchesCronField(date.getUTCHours(), hour) &&
+      TaskQueue.matchesCronField(date.getUTCDate(), dayOfMonth) &&
+      TaskQueue.matchesCronField(date.getUTCMonth() + 1, month) &&
+      TaskQueue.matchesCronField(date.getUTCDay(), dayOfWeek)
+    );
+  }
+
+  private static computeNextRun(cronExpression: string, after: Date): Date {
+    let t = new Date(after.getTime());
+    t.setUTCSeconds(0, 0);
+    t = new Date(t.getTime() + 60000);
+
+    for (let i = 0; i < 100000; i++) {
+      if (TaskQueue.cronMatches(t, cronExpression)) return t;
+      t = new Date(t.getTime() + 60000);
+    }
+    throw new Error(`Unable to compute next run for cron expression: ${cronExpression}`);
+  }
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {
+    const id = randomUUID();
+    const nextRunAt = TaskQueue.computeNextRun(cronExpression, new Date());
+    const sched: Schedule = {
+      id,
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+      nextRunAt,
+    };
+    this.schedules.set(id, sched);
+    return sched;
+  }
+
+  unschedule(scheduleId: string): void {
+    const sched = this.schedules.get(scheduleId);
+    if (sched) sched.active = false;
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const all = Array.from(this.schedules.values()).filter((s) => s.active);
+    return queueName ? all.filter((s) => s.queueName === queueName) : all;
+  }
+
+  tick(): void {
+    const now = new Date();
+    for (const sched of this.schedules.values()) {
+      if (!sched.active) continue;
+      if (sched.nextRunAt.getTime() <= now.getTime()) {
+        this.enqueue(sched.queueName, sched.taskTemplate);
+        sched.nextRunAt = TaskQueue.computeNextRun(sched.cronExpression, sched.nextRunAt);
+      }
+    }
+  }
+
+  use(queueName: string, middleware: Middleware): void {
+    this.getOrCreateQueue(queueName).middlewares.push(middleware);
+  }
+
+  async process(queueName: string, handler: (task: Task) => Promise<void>): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const q = this.getOrCreateQueue(queueName);
+    const middlewares = q.middlewares;
+
+    const runStage = async (i: number): Promise<void> => {
+      if (i < middlewares.length) {
+        await middlewares[i](task, () => runStage(i + 1));
+      } else {
+        await handler(task);
+      }
+    };
+
+    try {
+      await runStage(0);
+      this.complete(task.id);
+    } catch (err) {
+      this.fail(task.id, err instanceof Error ? err.message : String(err));
+    }
+  }
+
+  onShutdown(callback: ShutdownCallback): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  private countProcessing(): number {
+    let total = 0;
+    for (const q of this.queues.values()) total += q.processingCount;
+    return total;
+  }
+
+  private checkShutdownFinish(): void {
+    if (this.countProcessing() === 0) {
+      this.finishShutdown();
+    }
+  }
+
+  private forceCancelProcessingTasks(): void {
+    for (const task of this.tasksById.values()) {
+      if (task.status === 'processing') {
+        task.status = 'cancelled';
+        const q = this.queues.get(task.queueName);
+        if (q) q.processingCount = Math.max(0, q.processingCount - 1);
+        this.shutdownCancelledCount += 1;
+      }
+    }
+  }
+
+  private finishShutdown(): void {
+    if (this.shutdownFinished) return;
+    this.shutdownFinished = true;
+    if (this.shutdownTimeoutHandle) {
+      clearTimeout(this.shutdownTimeoutHandle);
+      this.shutdownTimeoutHandle = null;
+    }
+    const elapsed = Date.now() - this.shutdownStartTime;
+    this.shutdownResolveFn?.({
+      completed: this.shutdownCompletedCount,
+      cancelled: this.shutdownCancelledCount,
+      elapsed,
+    });
+  }
+
+  shutdown(timeout: number = 30000): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+
+    this.shuttingDown = true;
+    this.shutdownStartTime = Date.now();
+    this.shutdownCompletedCount = 0;
+    this.shutdownCancelledCount = 0;
+    this.shutdownFinished = false;
+
+    for (const cb of this.shutdownCallbacks) {
+      cb();
+    }
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      this.shutdownResolveFn = resolve;
+      this.shutdownTimeoutHandle = setTimeout(() => {
+        this.forceCancelProcessingTasks();
+        this.finishShutdown();
+      }, timeout);
+      this.checkShutdownFinish();
+    });
+
+    return this.shutdownPromise;
+  }
+}
