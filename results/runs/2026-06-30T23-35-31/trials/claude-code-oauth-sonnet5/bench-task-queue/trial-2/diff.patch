+    const promise = new Promise<ShutdownSummary>((resolve) => {
+      resolveFn = resolve;
+    });
+
+    const state: ShutdownState = {
+      remaining: processingIds,
+      completed: 0,
+      cancelled: 0,
+      startedAt,
+      timer: null,
+      resolve: resolveFn,
+      promise,
+      result: null,
