else {\n      task.status = 'failed';\n      qs.dlq.push(task);\n      this.settleDuringShutdown(task, 'other');\n    }\n  }\n\n  getDLQ(queueName: string): Task[] {\n    return (this.queues.get(queueName)?.dlq ?? []).slice();\n  }\n\n  retryDLQ(taskId: string): Task | null {\n    const task = this.tasksById.get(taskId);\n    if (!task) return null;\n    const qs = this.queues.get(task.queueName);\n    if (!qs) return null;\n    const idx = qs.dlq.findIndex((t) => t.id === taskId);\n    if (idx === -1) return null;\n    qs.dlq.splice(idx, 1);\n    task.attempts = 0;\n    task.status = 'pending';\n    task.availableAt = new Date();\n    qs.pending.push(task);\n    return task;\n  }\n\n  clearDLQ(queueName: string): void {\n    const qs = this.queues.get(queueName);\n    if (qs) qs.dlq = [];\n  }\n\n  getDependencies(taskId: string): DependencyInfo[] {\n    const task = this.tasksById.get(taskId);\n    if (!task) return [];\n    return task.dependsOn.map((id) => ({\n      taskId: id,\n      status: this.tasksById.get(id)?.status ?? 'failed',\n    }));\n  }\n\n  setConcurrency(queueName: string, limit: number): void {\n    const qs = this.getOrCreateQueue(queueName);\n    qs.concurrencyLimit = limit;\n  }\n\n  getConcurrency(queueName: string): ConcurrencyInfo {\n    const qs = this.queues.get(queueName);\n    if (!qs) return { current: 0, max: Infinity };\n    return {\n      current: qs.processing.size,\n      max: qs.concurrencyLimit === null ? Infinity : qs.concurrencyLimit,\n    };\n  }\n\n  updateProgress(taskId: string, percent: number, message?: string): void {\n    if (percent < 0 || percent > 100) {\n      throw new Error(`Progress percent must be between 0 and 100, got ${percent}`);\n    }\n    const info: ProgressInfo = { percent, message, updatedAt: new Date() };\n    this.progressById.set(taskId, info);\n    const callbacks = this.progressCallbacks.get(taskId);\n    if (callbacks) {\n      for (const cb of callbacks) cb(info);\n    }\n  }\n\n  getProgress