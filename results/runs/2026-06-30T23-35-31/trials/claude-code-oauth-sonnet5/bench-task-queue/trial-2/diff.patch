mber {\n  const everyN = cronExpression.match(/^\\*\\/(\\d+) \\* \\* \\* \\*$/);\n  if (everyN) {\n    return Number(everyN[1]) * 60 * 1000;\n  }\n  if (cronExpression === '0 * * * *') {\n    return 60 * 60 * 1000;\n  }\n  if (cronExpression === '0 0 * * *') {\n    return 24 * 60 * 60 * 1000;\n  }\n  throw new Error(`Unsupported cron expression: ${cronExpression}`);\n}\n\nexport class TaskQueue {\n  private queues = new Map<string, QueueState>();\n  private tasksById = new Map<string, Task>();\n  private progressById = new Map<string, ProgressInfo>();\n  private progressCallbacks = new Map<string, Array<(info: ProgressInfo) => void>>();\n  private schedules = new Map<string, Schedule>();\n  private scheduleNextRun = new Map<string, number>();\n  private shuttingDown = false;\n  private shutdownState: ShutdownState | null = null;\n  private shutdownCallbacks: Array<() => void> = [];\n\n  private getOrCreateQueue(queueName: string): QueueState {\n    let qs = this.queues.get(queueName);\n    if (!qs) {\n      qs = {\n        name: queueName,\n        pending: [],\n        processing: new Set(),\n        concurrencyLimit: null,\n        dlq: [],\n        middlewares: [],\n      };\n      this.queues.set(queueName, qs);\n    }\n    return qs;\n  }\n\n  enqueue(...args: any[]): Task {\n    if (this.shuttingDown) {\n      throw new Error('Cannot enqueue: queue is shutting down');\n    }\n\n    let queueName: string;\n    let payload: any;\n    let options: EnqueueOptions | undefined;\n\n    if (args.length <= 1) {\n      queueName = 'default';\n      payload = args[0];\n      options = undefined;\n    } else {\n      queueName = args[0];\n      payload = args[1];\n      options = args[2];\n    }\n\n    const priority = options?.priority ?? 5;\n    if (priority < 1 || priority > 10) {\n      throw new Error(`Priority must be between 1 and 10, got ${priority}`);\n    }\n\n    const dependsOn = options?.dependsOn ?? [];\n    for (const depId of dependsOn) {\n      if (!this.