+import { randomUUID } from 'node:crypto';
+
+export type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';
+
+export interface Task {
+  id: string;
+  payload: unknown;
+  status: TaskStatus;
+  createdAt: Date;
+  priority: number;
+  queueName: string;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  lastError?: unknown;
+  failCount: number;
+  dependsOn: string[];
+}
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: TaskStatus;
+}
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: unknown;
+  active: boolean;
+}
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+interface QueueState {
+  name: string;
+  pending: Task[];
+  processing: Set<string>;
+  concurrencyLimit: number | null;
+  dlq: Task[];
+  middlewares: Middleware[];
+}
+
+interface ShutdownState {
+  remaining: Set<string>;
+  completed: number;
+  cancelled: number;
+  startedAt: number;
+  timer: ReturnType<typeof setTimeout> | null;
+  resolve: (summary: ShutdownSummary) => void;
+  promise: Promise<ShutdownSummary>;
+  result: ShutdownSummary | null;
+}
+
+function parseCronIntervalMs(cronExpression: string): number {
+  const everyN = cronExpression.match(/^\*\/(\d+) \* \* \* \*$/);
+  if (everyN) {
+    return Number(everyN[1]) * 60 * 1000;
+  }
+  if (cronExpression === '0 * * * *') {
+    return 60 * 60 * 1000;
+  }
+  if (cronExpression === '0 0 * * *') {
+    return 24 * 60 * 60 * 1000;
+  }
+  throw new Error(`Unsupported cron expression: ${cronExpression}`);
+}
+
+export class TaskQueue {
+  private queues = new Map<string, QueueState>();
+  private tasksById = new Map<string, Task>();
+  private progressById = new Map<string, ProgressInfo>();
+  private progressCallbacks = new Map<string, Array<(info: ProgressInfo) => void>>();
+  private schedules = new Map<string, Schedule>();
+  private scheduleNextRun = new Map<string, number>();
+  private shuttingDown = false;
+  private shutdownState: ShutdownState | null = null;
+  private shutdownCallbacks: Array<() => void> = [];
+
+  private getOrCreateQueue(queueName: string): QueueState {
+    let qs = this.queues.get(queueName);
+    if (!qs) {
+      qs = {
+        name: queueName,
+        pending: [],
+        processing: new Set(),
+        concurrencyLimit: null,
+        dlq: [],
+        middlewares: [],
+      };
+      this.queues.set(queueName, qs);
+    }
+    return qs;
+  }
+
+  enqueue(...args: unknown[]): Task {
+    if (this.shuttingDown) {
+      throw new Error('Cannot enqueue: queue is shutting down');
+    }
+
+    let queueName: string;
+    let payload: unknown;
+    let options: EnqueueOptions | undefined;
+
+    if (args.length <= 1) {
+      queueName = 'default';
+      payload = args[0];
+      options = undefined;
+    } else {
+      queueName = args[0] as string;
+      payload = args[1];
+      options = args[2] as EnqueueOptions | undefined;
+    }
+
+    const priority = options?.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error(`Priority must be between 1 and 10, got ${priority}`);
+    }
+
+    const dependsOn = options?.dependsOn ?? [];
+    for (const depId of dependsOn) {
+      if (!this.tasksById.has(depId)) {
+        throw new Error(`Dependency task not found: ${depId}`);
+      }
+    }
+    const now = new Date();
+    let availableAt = now;
+    if (options?.runAt) {
+      availableAt = options.runAt;
+    } else if (options?.delay) {
+      availableAt = new Date(now.getTime() + options.delay);
+    }
+
+    const task: Task = {
+      id: randomUUID(),
+      payload,
+      status: 'pending',
+      createdAt: now,
+      priority,
+      queueName,
+      availableAt,
+      attempts: 0,
+      maxRetries: options?.maxRetries ?? 3,
+      backoffMs: options?.backoffMs ?? 1000,
+      lastError: undefined,
+      failCount: 0,
+      dependsOn,
+    };
+
+    const qs = this.getOrCreateQueue(queueName);
+    qs.pending.push(task);
+    this.tasksById.set(task.id, task);
+    return task;
+  }
+
+  private dependenciesSatisfied(task: Task): boolean {
+    return task.dependsOn.every((id) => this.tasksById.get(id)?.status === 'completed');
+  }
+
+  private compareTasks(a: Task, b: Task): number {
+    if (a.priority !== b.priority) return a.priority - b.priority;
+    return a.availableAt.getTime() - b.availableAt.getTime();
+  }
+
+  dequeue(queueName = 'default'): Task | null {
+    const qs = this.queues.get(queueName);
+    if (!qs) return null;
+    if (qs.concurrencyLimit !== null && qs.processing.size >= qs.concurrencyLimit) {
+      return null;
+    }
+
+    const now = Date.now();
+    let best: Task | null = null;
+    let bestIndex = -1;
+    for (let i = 0; i < qs.pending.length; i++) {
+      const t = qs.pending[i];
+      if (t.availableAt.getTime() > now) continue;
+      if (!this.dependenciesSatisfied(t)) continue;
+      if (best === null || this.compareTasks(t, best) < 0) {
+        best = t;
+        bestIndex = i;
+      }
+    }
+
+    if (!best) return null;
+    qs.pending.splice(bestIndex, 1);
+    best.status = 'processing';
+    best.attempts += 1;
+    qs.processing.add(best.id);
+    return best;
+  }
+
+  size(queueName = 'default'): number {
+    return this.queueSize(queueName);
+  }
+
+  queueSize(queueName: string): number {
+    return this.queues.get(queueName)?.pending.length ?? 0;
+  }
+
+  listQueues(): string[] {
+    return Array.from(this.queues.keys());
+  }
+
+  private releaseProcessingSlot(task: Task): void {
+    const qs = this.queues.get(task.queueName);
+    qs?.processing.delete(task.id);
+  }
+
+  private settleDuringShutdown(task: Task, outcome: 'completed' | 'cancelled' | 'other'): void {
+    const state = this.shutdownState;
+    if (!state || !state.remaining.has(task.id)) return;
+    state.remaining.delete(task.id);
+    if (outcome === 'completed') state.completed += 1;
+    if (outcome === 'cancelled') state.cancelled += 1;
+    if (state.remaining.size === 0) {
+      this.finishShutdown();
+    }
+  }
+
+  complete(taskId: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task || task.status !== 'processing') return;
+    task.status = 'completed';
+    this.releaseProcessingSlot(task);
+    this.settleDuringShutdown(task, 'completed');
+  }
+
+  fail(taskId: string, error?: unknown): void {
+    const task = this.tasksById.get(taskId);
+    if (!task || task.status !== 'processing') return;
+    this.releaseProcessingSlot(task);
+    task.lastError = error;
+    task.failCount += 1;
+
+    const qs = this.getOrCreateQueue(task.queueName);
+    if (task.attempts <= task.maxRetries) {
+      const backoff = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.availableAt = new Date(Date.now() + backoff);
+      task.status = 'pending';
+      qs.pending.push(task);
+      this.settleDuringShutdown(task, 'other');
+    } else {
+      task.status = 'failed';
+      qs.dlq.push(task);
+      this.settleDuringShutdown(task, 'other');
+    }
+  }
+
+  getDLQ(queueName: string): Task[] {
+    return (this.queues.get(queueName)?.dlq ?? []).slice();
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    const task = this.tasksById.get(taskId);
+    if (!task) return null;
+    const qs = this.queues.get(task.queueName);
+    if (!qs) return null;
+    const idx = qs.dlq.findIndex((t) => t.id === taskId);
+    if (idx === -1) return null;
+    qs.dlq.splice(idx, 1);
+    task.attempts = 0;
+    task.status = 'pending';
+    task.availableAt = new Date();
+    qs.pending.push(task);
+    return task;
+  }
+
+  clearDLQ(queueName: string): void {
+    const qs = this.queues.get(queueName);
+    if (qs) qs.dlq = [];
+  }
+
+  getDependencies(taskId: string): DependencyInfo[] {
+    const task = this.tasksById.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map((id) => ({
+      taskId: id,
+      status: this.tasksById.get(id)?.status ?? 'failed',
+    }));
+  }
+
+  setConcurrency(queueName: string, limit: number): void {
+    const qs = this.getOrCreateQueue(queueName);
+    qs.concurrencyLimit = limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const qs = this.queues.get(queueName);
+    if (!qs) return { current: 0, max: Infinity };
+    return {
+      current: qs.processing.size,
+      max: qs.concurrencyLimit === null ? Infinity : qs.concurrencyLimit,
+    };
+  }
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error(`Progress percent must be between 0 and 100, got ${percent}`);
+    }
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    this.progressById.set(taskId, info);
+    const callbacks = this.progressCallbacks.get(taskId);
+    if (callbacks) {
+      for (const cb of callbacks) cb(info);
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progressById.get(taskId) ?? null;
+  }
+
+  onProgress(taskId: string, callback: (info: ProgressInfo) => void): () => void {
+    let callbacks = this.progressCallbacks.get(taskId);
+    if (!callbacks) {
+      callbacks = [];
+      this.progressCallbacks.set(taskId, callbacks);
+    }
+    callbacks.push(callback);
+    return () => {
+      const list = this.progressCallbacks.get(taskId);
+      if (!list) return;
+      const idx = list.indexOf(callback);
+      if (idx !== -1) list.splice(idx, 1);
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task) return;
+
+    if (task.status === 'pending') {
+      const qs = this.queues.get(task.queueName);
+      if (qs) {
+        const idx = qs.pending.findIndex((t) => t.id === taskId);
+        if (idx !== -1) qs.pending.splice(idx, 1);
+      }
+      task.status = 'cancelled';
+    } else if (task.status === 'processing') {
+      this.releaseProcessingSlot(task);
+      task.status = 'cancelled';
+      this.settleDuringShutdown(task, 'cancelled');
+    }
+  }
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {
+    const intervalMs = parseCronIntervalMs(cronExpression);
+    const sched: Schedule = {
+      id: randomUUID(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+    };
+    this.schedules.set(sched.id, sched);
+    this.scheduleNextRun.set(sched.id, Date.now() + intervalMs);
+    return sched;
+  }
+
+  unschedule(scheduleId: string): void {
+    const sched = this.schedules.get(scheduleId);
+    if (sched) sched.active = false;
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const all = Array.from(this.schedules.values()).filter((s) => s.active);
+    return queueName ? all.filter((s) => s.queueName === queueName) : all;
+  }
+
+  tick(): void {
+    const now = Date.now();
+    for (const sched of this.schedules.values()) {
+      if (!sched.active) continue;
+      const intervalMs = parseCronIntervalMs(sched.cronExpression);
+      let nextRun = this.scheduleNextRun.get(sched.id) ?? now + intervalMs;
+      while (nextRun <= now) {
+        this.enqueue(sched.queueName, sched.taskTemplate);
+        nextRun += intervalMs;
+      }
+      this.scheduleNextRun.set(sched.id, nextRun);
+    }
+  }
+
+  use(queueName: string, middleware: Middleware): void {
+    const qs = this.getOrCreateQueue(queueName);
+    qs.middlewares.push(middleware);
+  }
+
+  async process(queueName: string, handler: (task: Task) => Promise<void>): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const qs = this.getOrCreateQueue(queueName);
+    const middlewares = qs.middlewares;
+    let handlerRan = false;
+    let callIndex = -1;
+
+    const runner = async (i: number): Promise<void> => {
+      if (i <= callIndex) {
+        throw new Error('next() called multiple times');
+      }
+      callIndex = i;
+      if (i < middlewares.length) {
+        await middlewares[i](task, () => runner(i + 1));
+      } else {
+        handlerRan = true;
+        await handler(task);
+      }
