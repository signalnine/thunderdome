+    if (handlerRan) {
+      this.complete(task.id);
+    }
+  }
+
+  onShutdown(callback: () => void): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  private finishShutdown(): void {
+    const state = this.shutdownState;
+    if (!state || state.result) return;
+    if (state.timer) {
+      clearTimeout(state.timer);
+      state.timer = null;
+    }
+    const summary: ShutdownSummary = {
+      completed: state.completed,
+      cancelled: state.cancelled,
+      elapsed: Date.now() - state.startedAt,
+    };
+    state.result = summary;
+    state.resolve(summary);
+  }
+
+  shutdown(timeout = 30000): Promise<ShutdownSummary> {
+    if (this.shutdownState) {
+      return this.shutdownState.promise;
+    }
+
+    this.shuttingDown = true;
+    const startedAt = Date.now();
+
+    for (const cb of this.shutdownCallbacks) {
+      cb();
+    }
+
+    const processingIds = new Set<string>();
+    for (const qs of this.queues.values()) {
+      for (const id of qs.processing) processingIds.add(id);
+    }
