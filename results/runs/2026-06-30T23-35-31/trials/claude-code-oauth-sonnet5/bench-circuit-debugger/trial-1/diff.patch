g, number> = { ...inputs };\n  const gateByOutput = new Map<string, Gate>();\n  for (const gate of gates) {\n    gateByOutput.set(gate.out, gate);\n  }\n\n  function resolve(wire: string): number {\n    if (wire in values) {\n      return values[wire];\n    }\n    const gate = gateByOutput.get(wire);\n    if (!gate) {\n      throw new Error(`No value or gate found for wire \"${wire}\"`);\n    }\n    const a = resolve(gate.in1);\n    const b = resolve(gate.in2);\n    const result = applyOp(gate.op, a, b);\n    values[wire] = result;\n    return result;\n  }\n\n  for (const gate of gates) {\n    resolve(gate.out);\n  }\n\n  return values;\n}\n\nconst isXY = (wire: string): boolean => wire.startsWith('x') || wire.startsWith('y');\n\nconst isBit0Input = (in1: string, in2: string): boolean =>\n  (in1 === 'x00' && in2 === 'y00') || (in1 === 'y00' && in2 === 'x00');\n\nexport function findSwappedWires(gates: Gate[]): string[] {\n  const zWires = gates.map((g) => g.out).filter((w) => w.startsWith('z'));\n  const maxZ = zWires.slice().sort().at(-1);\n\n  const xBitNumbers = gates\n    .flatMap((g) => [g.in1, g.in2])\n    .filter((w) => w.startsWith('x'))\n    .map((w) => Number(w.slice(1)));\n  const maxXBit = xBitNumbers.length > 0 ? Math.max(...xBitNumbers) : 0;\n\n  const producerByOutput = new Map<string, Gate>();\n  for (const gate of gates) {\n    producerByOutput.set(gate.out, gate);\n  }\n\n  const suspects = new Set<string>();\n\n  for (const gate of gates) {\n    const { op, in1, in2, out } = gate;\n\n    // Every z output (except the final carry-out bit) must come from an XOR gate.\n    if (out.startsWith('z') && op !== 'XOR' && out !== maxZ) {\n      suspects.add(out);\n    }\n\n    // The final carry-out bit must come from an OR gate (unless there's only one input bit,\n    // in which case it's the bit-0 carry directly, an AND gate).\n    if (out === maxZ && maxXBit > 0 && op !== 'OR') {\n      suspects.add(out);\n    }\n\n    // An XOR gate that doesn't output