me from an OR gate (unless there's only one input bit,\n    // in which case it's the bit-0 carry directly, an AND gate).\n    if (out === maxZ && maxXBit > 0 && op !== 'OR') {\n      suspects.add(out);\n    }","originalFile":"export interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string;\n  in2: string;\n  out: string;\n}\n\nfunction applyOp(op: Gate['op'], a: number, b: number): number {\n  switch (op) {\n    case 'AND':\n      return a & b;\n    case 'OR':\n      return a | b;\n    case 'XOR':\n      return a ^ b;\n  }\n}\n\nexport function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {\n  const values: Record<string, number> = { ...inputs };\n  const gateByOutput = new Map<string, Gate>();\n  for (const gate of gates) {\n    gateByOutput.set(gate.out, gate);\n  }\n\n  function resolve(wire: string): number {\n    if (wire in values) {\n      return values[wire];\n    }\n    const gate = gateByOutput.get(wire);\n    if (!gate) {\n      throw new Error(`No value or gate found for wire \"${wire}\"`);\n    }\n    const a = resolve(gate.in1);\n    const b = resolve(gate.in2);\n    const result = applyOp(gate.op, a, b);\n    values[wire] = result;\n    return result;\n  }\n\n  for (const gate of gates) {\n    resolve(gate.out);\n  }\n\n  return values;\n}\n\nconst isXY = (wire: string): boolean => wire.startsWith('x') || wire.startsWith('y');\n\nconst isBit0Input = (in1: string, in2: string): boolean =>\n  (in1 === 'x00' && in2 === 'y00') || (in1 === 'y00' && in2 === 'x00');\n\nexport function findSwappedWires(gates: Gate[]): string[] {\n  const zWires = gates.map((g) => g.out).filter((w) => w.startsWith('z'));\n  const maxZ = zWires.slice().sort().at(-1);\n\n  const producerByOutput = new Map<string, Gate>();\n  for (const gate of gates) {\n    producerByOutput.set(gate.out, gate);\n  }\n\n  const suspects = new Set<string>();\n\n  for (const gate of gates) {\n    const { op, in1, in2, out } = gate;\n\n    // Every z output (except the final carry-out bit) must come from an XOR gate.\n    if (out.startsWith('z') && op !== 'XOR' && out !== maxZ) {\n      suspects.add(out);\n    }\n\n    // An XOR gate that doesn't output to z must be a first-layer gate combining x/y directly.\n    if (op === 'XOR' && !out.startsWith('z') && !isXY(in1) && !isXY(in2)) {\n      suspects.add(out);\n    }\n\n    // A first-layer XOR gate (combining x/y directly) may only output to z for bit 0.\n    if (op === 'XOR' && isXY(in1) && isXY(in2) && out.startsWith('z') && !isBit0Input(in1, in2)) {\n      suspects.add(out);\n    }\n\n    // An AND gate's output (other than the bit-0 carry) must only feed into an OR gate.\n    if (op === 'AND' && !isBit0Input(in1, in2)) {\n      for (const other of gates) {\n        if ((other.in1 === out || other.in2 === out) && other.op !== 'OR') {\n          suspects.add(out);\n        }\n      }\n    }\n\n    // A first-layer XOR gate's output (other than bit-0's, which feeds z00 directly) must\n    // never feed into an OR gate.\n    if (op === 'XOR' && (isXY(in1) || isXY(in2)) && !isBit0Input(in1, in2)) {\n      for (const other of gates) {\n        if ((other.in1 === out || other.in2 === out) && other.op === 'OR') {\n          suspects.add(out);\n        }\n      }\n    }\n\n    // An OR gate's inputs must both be produced by AND gates (the generate/propagate signals).\n    if (op === 'OR') {\n      for (const inputWire of [in1, in2]) {\n        const producer = producerByOutput.get(inputWire);\n        if (producer && producer.op !== 'AND') {\n          suspects.add(inputWire);\n        }\n      }\n    }\n  }\n\n  return Array.from(suspects).sort();\n}\n","structuredPatch":[{"oldStart":54,"oldLines":6,"newStart":54,"newLines":12,"lines":["   const zWires = gates.map((g) => g.out).filter((w) => w.startsWith('z'));","   const maxZ = zWires.slice().sort().at(-1);"," ","+  const xBitNumbers = gates","+    .flatMap((g) => [g.in1, g.in2])","+    .filter((w) => w.startsWith('x'))","+