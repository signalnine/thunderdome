er {\n    const cached = values.get(wire);\n    if (cached !== undefined) return cached;\n\n    const gate = byOutput.get(wire);\n    if (!gate) {\n      throw new Error(`Unknown wire: ${wire}`);\n    }\n    if (inProgress.has(wire)) {\n      throw new Error(`Cycle detected involving wire: ${wire}`);\n    }\n    inProgress.add(wire);\n    const a = resolve(gate.in1);\n    const b = resolve(gate.in2);\n    const result = applyOp(gate.op, a, b);\n    inProgress.delete(wire);\n\n    values.set(wire, result);\n    return result;\n  }\n\n  for (const gate of gates) {\n    resolve(gate.out);\n  }\n\n  return Object.fromEntries(values);\n}\n\nfunction wireBitIndex(wire: string, prefix: string): number | null {\n  const m = new RegExp(`^${prefix}(\\\\d+)$`).exec(wire);\n  return m ? parseInt(m[1], 10) : null;\n}\n\n/**\n * Reads a register (x/y/z) out of a wire-value map as a number, given the bit width and\n * the zero-padded digit length used in wire names (e.g. \"05\" -> digitLen 2).\n */\nfunction registerValue(\n  values: Record<string, number>,\n  prefix: string,\n  bitCount: number,\n  digitLen: number,\n): number {\n  let result = 0;\n  for (let i = 0; i < bitCount; i++) {\n    const wire = prefix + String(i).padStart(digitLen, '0');\n    if (values[wire]) result += 2 ** i;\n  }\n  return result;\n}\n\n// Note: uses arithmetic (not JS bitwise operators, which coerce to 32-bit\n// integers) since circuits can have 40+ bits.\nfunction setRegister(\n  prefix: string,\n  value: number,\n  bitCount: number,\n  digitLen: number,\n  target: Record<string, number>,\n): void {\n  for (let i = 0; i < bitCount; i++) {\n    const wire = prefix + String(i).padStart(digitLen, '0');\n    target[wire] = Math.floor(value / 2 ** i) % 2;\n  }\n}\n\n/**\n * Enumerates every perfect matching (pairing) of an even-length array.\n */\nfunction* pairings<T>(items: T[]): Generator<Array<[T, T]>> {\n  if (items.length === 0) {\n    yield [];\n    return;\n  }\n  const [first, ...rest] = items;\n  for (let i = 0; i < rest.length; i++) {\n    const partner = rest[i];\n    const remaining = rest.filter((_, idx) => idx !== i);\n    for (const restPairing of pairings(remaining)) {\n      yield [[first, partner], ...restPairing];\n    }\n  }\n}\n\nfunction* combinations<T>(items: T[], k: number): Generator<T[]> {\n  if (k === 0) {\n    yield [];\n    return;\n  }\n  if (items.length < k) return;\n  const [first, ...rest] = items;\n  for (const combo of combinations(rest, k - 1)) {\n    yield [first, ...combo];\n  }\n  yield* combinations(rest, k);\n}\n\ninterface CircuitShape {\n  bitCount: number;\n  digitLen: number;\n  zMax: string;\n}\n\nfunction inferShape(gates: Gate[]): CircuitShape {\n  let maxX = -1;\n  let digitLen = 2;\n  for (const gate of gates) {\n    for (const wire of [gate.in1, gate.in2, gate.out]) {\n      const idx = wireBitIndex(wire, 'x');\n      if (idx !== null) {\n        if (idx > maxX) maxX = idx;\n        digitLen = wire.length - 1;\n      }\n    }\n  }\n  const bitCount = maxX + 1;\n  return { bitCount, digitLen, zMax: 'z' + String(bitCount).padStart(digitLen, '0') };\n}\n\n/**\n * Structural rules that hold for a correct ripple-carry adder built from\n * half-adder/full-adder gate clusters (x_i XOR y_i -> t_i, t_i XOR c_(i-1) -> z_i,\n * x_i AND y_i -> a_i, t_i AND c_(i-1) -> b_i, a_i OR b_i -> c_i). Flags any gate\n * output that violates its expected role. This catches swaps between wires of\n * different structural roles (e.g. a sum wire swapped with a carry-generate\n * wire), which covers the vast majority of possible swaps.\n */\nfunction structuralCandidates(gates: Gate[], shape: CircuitShape): Set<string> {\n  const { zMax, digitLen } = shape;\n  const x00 = 'x' + '0'.padStart(digitLen, '0');\n  const y00 = 'y' + '0'.padStart(digitLen, '0');\n\n  const consumers = new Map<string, Gate[]>();\n  for (const gate of gates) {\n    for (const wire of [gate.in1, gate.in2]) {\n      const list = consumers.get(wire);\n      if (list) list.push(gate);\n      else consumers.set(wire, [gate]);\n    }\n  }\n\n  const zWireRe = /^z\\d+$/;\n  const rawInputRe = /^[xy]\\d+$/;\n\n  const wrong = new Set<string>();\n\n  for (const gate of gates) {\n    const { in1: a, in2: b, op, out: c } = gate;\n    const isZOut = zWireRe.test(c);\n\n    if (isZOut && c !== zMax && op !== 'XOR') wrong.add(c);\n    if (c === zMax && op !== 'OR') wrong.add(c);\n\n    const aRaw = rawInputRe.test(a);\n    const bRaw = rawInputRe.test(b);\n    const isBit0Carry = (a === x00 && b === y00) || (a === y00 && b === x00);\n\n    if (op === 'XOR') {\n      if (!aRaw && !bRaw) {\n        if (!isZOut) wrong.add(c);\n      } else {\n        const cons = consumers.get(c) ?? [];\n        for (const consumer of cons) {\n          if (consumer.op === 'OR') wrong.add(c);\n        }\n      }\n    }\n\n    if (op === 'AND' && !isBit0Carry) {\n      const cons = consumers.get(c) ?? [];\n      for (const consumer of cons) {\n        if (consumer.op !== 'OR') wrong.add(c);\n      }\n    }\n  }\n\n  return wrong;\n}\n\n/**\n * Numeric probe for same-role swaps (e.g. two z-output wires swapped with\n * each other) that satisfy every local structural rule and are therefore\n * invisible to structuralCandidates. Only reports wires that show a clean,\n * isolated single-bit discrepancy, to avoid flagging unrelated wires caught\n * up in a carry-propagation cascade caused by some other (structural) bug.\n */\nfunction numericZSwapCandidates(gates: Gate[], shape: CircuitShape): Set<string> {\n  const { bitCount, digitLen } = shape;\n  const extra = new Set<string>();\n\n  for (let i = 0; i < bitCount; i++) {\n    const inputs: Record<string, number> = {};\n    setRegister('x', 2 ** i, bitCount, digitLen, inputs);\n    setRegister('y', 0, bitCount, digitLen, inputs);\n    let values: Record<string, number>;\n    try {\n      values = simulate(gates, inputs);\n    } catch {\n      continue;\n    }\n    const actual = registerValue(values, 'z', bitC