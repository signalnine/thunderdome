+import { describe, it, expect } from 'vitest';
+import { simulate, findSwappedWires, type Gate } from '../src/index.js';
+
+function nBitAdder(n: number): Gate[] {
+  const pad = (i: number) => String(i).padStart(2, '0');
+  const gates: Gate[] = [
+    { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+    { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+  ];
+  for (let i = 1; i < n; i++) {
+    const xi = 'x' + pad(i);
+    const yi = 'y' + pad(i);
+    const ti = 't' + pad(i);
+    const zi = 'z' + pad(i);
+    const ai = 'a' + pad(i);
+    const bi = 'b' + pad(i);
+    const cPrev = 'c' + pad(i - 1);
+    const ci = 'c' + pad(i);
+    gates.push({ op: 'XOR', in1: xi, in2: yi, out: ti });
+    gates.push({ op: 'XOR', in1: ti, in2: cPrev, out: zi });
+    gates.push({ op: 'AND', in1: xi, in2: yi, out: ai });
+    gates.push({ op: 'AND', in1: ti, in2: cPrev, out: bi });
+    gates.push({ op: 'OR', in1: ai, in2: bi, out: ci });
+  }
+  gates.push({ op: 'OR', in1: 'a' + pad(n - 1), in2: 'b' + pad(n - 1), out: 'z' + pad(n) });
+  return gates;
+}
+
+function swapOutputs(gates: Gate[], pairs: Array<[string, string]>): Gate[] {
+  const swapTo = new Map<string, string>();
+  for (const [u, v] of pairs) {
+    swapTo.set(u, v);
+    swapTo.set(v, u);
+  }
+  return gates.map((g) => {
+    const newOut = swapTo.get(g.out);
+    return newOut ? { ...g, out: newOut } : g;
+  });
+}
+
+function addBits(gates: Gate[], bitCount: number, x: number, y: number): number {
+  const pad = (i: number) => String(i).padStart(2, '0');
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < bitCount; i++) {
+    inputs['x' + pad(i)] = Math.floor(x / 2 ** i) % 2;
+    inputs['y' + pad(i)] = Math.floor(y / 2 ** i) % 2;
+  }
+  const values = simulate(gates, inputs);
+  let z = 0;
+  for (let i = 0; i <= bitCount; i++) {
+    if (values['z' + pad(i)]) z += 2 ** i;
+  }
+  return z;
+}
+
+describe('simulate', () => {
+  it('evaluates a single AND gate', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 }).c).toBe(1);
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(0);
+  });
+
+  it('evaluates a single OR gate', () => {
+    const gates: Gate[] = [{ op: 'OR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 0, b: 0 }).c).toBe(0);
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(1);
+  });
+
+  it('evaluates a single XOR gate', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 1 }).c).toBe(0);
+    expect(simulate(gates, { a: 1, b: 0 }).c).toBe(1);
+  });
+
+  it('resolves multi-level gate dependencies in any declaration order', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'w', in2: 'x', out: 'p' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'w' },
+      { op: 'OR', in1: 'p', in2: 'y', out: 'z' },
+    ];
+    const values = simulate(gates, { a: 1, b: 0, x: 1, y: 0 });
+    expect(values.w).toBe(1);
+    expect(values.p).toBe(1);
+    expect(values.z).toBe(1);
+  });
+
+  it('returns the value of every wire, including raw inputs', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    const values = simulate(gates, { a: 1, b: 0 });
+    expect(values).toEqual({ a: 1, b: 0, c: 0 });
+  });
+
+  it('correctly simulates the 4-bit adder example from the spec', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+      { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },
+      { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },
+      { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },
+      { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },
+      { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },
+      { op: 'XOR', in1: 'x02', in2: 'y02', out: 't02' },
+      { op: 'XOR', in1: 't02', in2: 'c01', out: 'z02' },
+      { op: 'AND', in1: 'x02', in2: 'y02', out: 'a02' },
+      { op: 'AND', in1: 't02', in2: 'c01', out: 'b02' },
+      { op: 'OR', in1: 'a02', in2: 'b02', out: 'c02' },
+      { op: 'XOR', in1: 'x03', in2: 'y03', out: 't03' },
+      { op: 'XOR', in1: 't03', in2: 'c02', out: 'z03' },
+      { op: 'AND', in1: 'x03', in2: 'y03', out: 'a03' },
+      { op: 'AND', in1: 't03', in2: 'c02', out: 'b03' },
+      { op: 'OR', in1: 'a03', in2: 'b03', out: 'c03' },
+      { op: 'OR', in1: 'a03', in2: 'b03', out: 'z04' },
+    ];
+    expect(addBits(gates, 4, 3, 5)).toBe(8);
+    expect(addBits(gates, 4, 15, 15)).toBe(30);
+    expect(addBits(gates, 4, 7, 1)).toBe(8);
+    expect(addBits(gates, 4, 0, 0)).toBe(0);
+  });
+});
+
+describe('findSwappedWires', () => {
+  it('returns an empty array for a correctly wired adder', () => {
+    const gates = nBitAdder(8);
+    expect(findSwappedWires(gates)).toEqual([]);
+  });
+
+  it('finds a single cross-role swapped pair (sum bit <-> carry-generate bit)', () => {
+    const base = nBitAdder(8);
+    const swapped = swapOutputs(base, [['z02', 'a02']]);
+    // Only a single pair swapped here (not the full 4-pair puzzle shape), but
+    // the underlying rule should still flag exactly this pair.
+    expect(findSwappedWires(swapped)).toEqual(['a02', 'z02']);
+  });
+
+  it('finds 4 swapped pairs (8 wires) in a larger adder, mixing cross-role and same-role z swaps', () => {
+    const base = nBitAdder(45);
+    const pairs: Array<[string, string]> = [
+      ['z10', 'a10'],
+      ['t20', 'b20'],
+      ['c05', 'z30'],
+      ['z15', 'z42'],
+    ];
+    const swapped = swapOutputs(base, pairs);
+    const expected = Array.from(new Set(pairs.flat())).sort();
+    expect(findSwappedWires(swapped)).toEqual(expected);
+  });
+
+  it('still computes correct sums once the identified swaps are undone', () => {
+    const base = nBitAdder(16);
+    const pairs: Array<[string, string]> = [
+      ['z03', 'a03'],
+      ['t08', 'b08'],
+      ['c02', 'z12'],
+    ];
+    const swapped = swapOutputs(base, pairs);
+    const found = findSwappedWires(swapped);
+    expect(found.length).toBeGreaterThan(0);
+
+    // Undo exactly the swaps we introduced and confirm the adder is fixed.
+    const fixed = swapOutputs(swapped, pairs);
+    expect(addBits(fixed, 16, 12345, 6789)).toBe(12345 + 6789);
+  });
+
+  it('completes well within the 5-second budget for a 45-bit (~220 gate) circuit', () => {
+    const base = nBitAdder(45);
+    const pairs: Array<[string, string]> = [
+      ['z12', 'a12'],
+      ['t25', 'b25'],
+      ['c08', 'z33'],
+      ['a40', 'z04'],
+    ];
+    const swapped = swapOutputs(base, pairs);
+    const start = Date.now();
+    const found = findSwappedWires(swapped);
+    const elapsed = Date.now() - start;
+    expect(elapsed).toBeLessThan(5000);
+    expect(found).toEqual(Array.from(new Set(pairs.flat())).sort());
+  });
+});
