hape.digitLen)) {\n        return candidate;\n      }\n    }\n  }\n\n  // Best effort: return whatever the structural pass found.","newString":"  // Try to find a self-consistent pairing among the structural candidates\n  // (one that eliminates all structural violations once applied) and repair\n  // the circuit with it. Any remaining same-role swap (invisible to the\n  // structural rules, e.g. two z-output wires swapped with each other) can\n  // then be found numerically without cascading noise from the bugs we've\n  // already identified. Pairing counts grow factorially, so bound this to\n  // keep worst-case runtime in check.\n  const MAX_PAIRING_SET_SIZE = 12;\n  let repaired = gates;\n  if (structural.length > 0 && structural.length % 2 === 0 && structural.length <= MAX_PAIRING_SET_SIZE) {\n    for (const pairing of pairings(structural)) {\n      const candidate = applyPairing(gates, pairing);\n      if (structuralCandidates(candidate, shape).size === 0) {\n        repaired = candidate;\n        break;\n      }\n    }\n  }\n\n  const numericExtra = Array.from(numericZSwapCandidates(repaired, shape)).filter(\n    (w) => !structural.includes(w),\n  );\n\n  const combined = Array.from(new Set([...structural, ...numericExtra])).sort();\n  if (combined.length === 8 && verifyPairingExists(gates, combined, shape.bitCount, shape.digitLen)) {\n    return combined;\n  }\n\n  // Fall back to searching subsets of the combined candidate pool for one\n  // that has a fully verified pairing. Both the subset search and the\n  // per-subset pairing search grow combinatorially, so cap total attempts.\n  const MAX_SUBSET_ATTEMPTS = 2000;\n  const need = 8 - structural.length;\n  const extraPool = numericExtra;\n  if (need >= 0 && need <= extraPool.length && need <= MAX_PAIRING_SET_SIZE) {\n    let attempts = 0;\n    for (const subset of combinations(extraPool, need)) {\n      if (++attempts > MAX_SUBSET_ATTEMPTS) break;\n      const candidate = [...structural, ...subset].sort();\n      if (verifyPairingExists(gates, candidate, shape.bitCount, shape.digitLen)) {\n        return candidate;\n      }\n    }\n  }\n\n  // Best effort: return whatever the structural pass found.","originalFile":"export interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string;\n  in2: string;\n  out: string;\n}\n\nfunction applyOp(op: Gate['op'], a: number, b: number): number {\n  switch (op) {\n    case 'AND':\n      return a & b;\n    case 'OR':\n      return a | b;\n    case 'XOR':\n      return a ^ b;\n  }\n}\n\n/**\n * Simulates the circuit and returns the final value of every wire (inputs and computed).\n */\nexport function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {\n  const values = new Map<string, number>(Object.entries(inputs));\n  const byOutput = new Map<string, Gate>();\n  for (const gate of gates) {\n    byOutput.set(gate.out, gate);\n  }\n\n  const inProgress = new Set<string>();\n\n  function resolve(wire: string): number {\n    const cached = values.get(wire);\n    if (cached !== undefined) return cached;\n\n    const gate = byOutput.get(wire);\n    if (!gate) {\n      throw new Error(`Unknown wire: ${wire}`);\n    }\n    if (inProgress.has(wire)) {\n      throw new Error(`Cycle detected involving wire: ${wire}`);\n    }\n    inProgress.add(wire);\n    const a = resolve(gate.in1);\n    const b = resolve(gate.in2);\n    const result = applyOp(gate.op, a, b);\n    inProgress.delete(wire);\n\n    values.set(wire, result);\n    return result;\n  }\n\n  for (const gate of gates) {\n    resolve(gate.out);\n  }\n\n  return Object.fromEntries(values);\n}\n\nfunction wireBitIndex(wire: string, prefix: string): number | null {\n  const m = new RegExp(`^${prefix}(\\\\d+)$`).exec(wire);\n  return m ? parseInt(m[1], 10) : null;\n}\n\n/**\n * Reads a register (x/y/z) out of a wire-value map as a number, given the bit width and\n * the zero-padded digit length used in wire names (e.g. \"05\" -> digitLen 2).\n */\nfunction registerValue(\n  values: Record<string, number>,\n  prefix: string,\n  bitCount: number,\n  digitLen: number,\n): number {\n  let result = 0;\n  for (let i = 0; i < bitCount; i++) {\n    const wire = prefix + String(i).padStart(digitLen, '0');\n    if (values[wire]) result += 2 ** i;\n  }\n  return result;\n}\n\n// Note: uses arithmetic (not JS bitwise operators, which coerce to 32-bit\n// integers) since circuits can have 40+ bits.\nfunction setRegister(\n  prefix: string,\n  value: number,\n  bitCount: number,\n  digitLen: number,\n  target: Record<string, number>,\n): void {\n  for (let i = 0; i < bitCount; i++) {\n    const wire = prefix + String(i).padStart(digitLen, '0');\n    target[wire] = Math.floor(value / 2 ** i) % 2;\n  }\n}\n\n/**\n * Enumerates every perfect matching (pairing) of an even-length array.\n */\nfunction* pairings<T>(items: T[]): Generator<Array<[T, T]>> {\n  if (items.length === 0) {\n    yield [];\n    return;\n  }\n  const [first, ...rest] = items;\n  for (let i = 0; i < rest.length; i++) {\n    const partner = rest[i];\n    const remaining = rest.filter((_, idx) => idx !== i);\n    for (const restPairing of pairings(remaining)) {\n      yield [[first, partner], ...restPairing];\n    }\n  }\n}\n\nfunction* combinations<T>(items: T[], k: number): Generator<T[]> {\n  if (k === 0) {\n    yield [];\n    return;\n  }\n  if (items.length < k) return;\n  const [first, ...rest] = items;\n  for (const combo of combinations(rest, k - 1)) {\n    yield [first, ...combo];\n  }\n  yield* combinations(rest, k);\n}\n\ninterface CircuitShape {\n  bitCount: number;\n  digitLen: number;\n  zMax: string;\n}\n\nfunction inferShape(gates: Gate[]): CircuitShape {\n  let maxX = -1;\n  let digitLen = 2;\n  for (const gate of gates) {\n    for (const wire of [gate.in1, gate.in2, gate.out]) {\n      const idx = wireBitIndex(wire, 'x');\n      if (idx !== null) {\n        if (idx > maxX) maxX = idx;\n        digitLen = wire.length - 1;\n      }\n    }\n  }\n  const bitCount = maxX + 1;\n  return { bitCount, digitLen, zMax: 'z' + String(bitCount).padStart(digitLen, '0') };\n}\n\n/**\n * For every wire, the highest bit index i such that x_i or y_i is a\n * transitive input to it (its \"cone of influence\"). This is a purely\n * structural/semantic property of the actual current wiring, so it is\n * unaffected by which arbitrary strings gate outputs happen to be named —\n * a swap renames outputs but never touches any gate's in1/in2, so support\n * always reflects real data flow correctly even in a broken circuit.\n */\nfunction computeSupport(gates: Gate[]): (wire: string) => number {\n  const byOutput = new Map<string, Gate>();\n  for (const gate of gates) byOutput.set(gate.out, gate);\n\n  const raw = new Map<string, number>();\n  for (const gate of gates) {\n    for (const wire of [gate.in1, gate.in2]) {\n      const idx = wireBitIndex(wire, 'x') ?? wireBitIndex(wire, 'y');\n      if (idx !== null) raw.set(wire, idx);\n    }\n  }\n\n  const memo = new Map<string, number>();\n  const inProgress = new Set<string>();\n  function support(wire: string): number {\n    const cached = memo.get(wire);\n    if (cached !== undefined) return cached;\n    const rawIdx = raw.get(wire);\n    if (rawIdx !== undefined) {\n      memo.set(wire, rawIdx);\n      return rawIdx;\n    }\n    const gate = byOutput.get(wire);\n    if (!gate || inProgress.has(wire)) {\n      memo.set(wire, -1);\n      return -1;\n    }\n    inProgress.add(wire);\n    const s = Math.max(support(gate.in1), support(gate.in2));\n    inProgress.delete(wire);\n    memo.set(wire, s);\n    return s;\n  }\n  return support;\n}\n\n/**\n * Structural rules that hold for a correct ripple-carry adder built from\n * half-adder/full-adder gate clusters (x_i XOR y_i -> t_i, t_i XOR c_(i-1) -> z_i,\n * x_i AND y_i -> a_i, t_i AND c_(i-1) -> b_i, a_i OR b_i -> c_i).\n *\n * Combines two kinds of checks:\n *  - Cone-of-influence (support) checks: every z_i must be produced by a gate\n *    whose inputs' supports are exactly {i, i-1} (or {0,0} for z_0), and the\n *    top carry-out bit must have support {N-1, N-1} via an OR gate. Because\n *    support reflects real data flow regardless of naming, this catches ANY\n *    swap that puts the wrong content at a z-name, or moves the true z_i\n *    computation to a non-z name — including same-role swaps at different\n *    bit positions (e.g. two z-wires, or two carry-wires, swapped with each\n *    other), not just cross-role swaps.\n *  - Consumer-shape checks: an AND gate combining two non-raw signals (a b_i\n *    \"propagate\" gate) must feed only OR gates; an XOR gate combining two raw\n *    x/y inputs (a t_i gate) must never feed an OR gate directly. These catch\n *    role swaps that support-matching alone can't see (e.g. a generate wire\n *    swapped with a propagate-consuming wire).\n */\nfunction structuralCandidates(gates: Gate[], shape: CircuitShape): Set<string> {\n  const { zMax, bitCount, digitLen } = shape;\n  const x00 = 'x' + '0'.padStart(digitLen, '0');\n  const y00 = 'y' + '0'.padStart(digitLen, '0');\n\n  const byOutput = new Map<string, Gate>();\n  for (const gate of gates) byOutput.set(gate.out, gate);\n\n  const consumers = new Map<string, Gate[]>();\n  for (const gate of gates) {\n    for (const wire of [gate.in1, gate.in2]) {\n      const list = consumers.get(wire);\n      if (list) list.push(gate);\n      else consumers.set(wire, [gate]);\n    }\n  }\n\n  const rawInputRe = /^[xy]\\d+$/;\n  const support = computeSupport(gates);\n  const wrong = new Set<string>();\n\n  // Support-based check on every z output (including the top carry bit).\n  for (let k = 0; k < bitCount; k++) {\n    const zName = 'z' + String(k).padStart(digitLen, '0');\n    const gate = byOutput.get(zName);\n    if (!gate) continue;\n    const s1 = support(gate.in1);\n    const s2 = support(gate.in2);\n    const ok =\n      gate.op === 'XOR' && (k === 0 ? s1 === 0 && s2 === 0 : Math.min(s1, s2) === k - 1 && Math.max(s1, s2) === k);\n    if (!ok) wrong.add(zName);\n  }\n  {\n    const gate = byOutput.get(zMax);\n    if (gate) {\n      const ok = gate.op === 'OR' && support(gate.in1) === bitCount - 1 && support(gate.in2) === bitCount - 1;\n      if (!ok) wrong.add(zMax);\n    }\n  }\n\n  // Reverse search: find the gate that actually computes each z_i's expected\n  // function (by input-support shape, independent of its current name) and\n  // flag it if it isn't sitting at the z_i name. This catches the other half\n  // of a same-role swap (e.g. the true z_i content parked under a non-z or\n  // differently-indexed z name).\n  const xorBySupportPair = new Map<string, Gate[]>();\n  for (const gate of gates) {\n    if (gate.op !== 'XOR') continue;\n    const s1 = support(gate.in1);\n    const s2 = support(gate.in2);\n    const key = `${Math.min(s1, s2)}-${Math.max(s1, s2)}`;\n    const list = xorBySupportPair.get(key);\n    if (list) list.push(gate);\n    else xorBySupportPair.set(key, [gate]);\n  }\n  for (let k = 0; k < bitCount; k++) {\n    const zName = 'z' + String(k).padStart(digitLen, '0');\n    const key = k === 0 ? '0-0' : `${k - 1}-${k}`;\n    const matches = xorBySupportPair.get(key) ?? [];\n    if (matches.length === 1 && matches[0].out !== zName) {\n      wrong.add(matches[0].out);\n    }\n  }\n  const orByEqualSupport = new Map<number, Gate[]>();\n  for (const gate of gates) {\n    if (gate.op !== 'OR') continue;\n    const s1 = support(gate.in1);\n    const s2 = support(gate.in2);\n    if (s1 !== s2) continue;\n    const list = orByEqualSupport.get(s1);\n    if (list) list.push(gate);\n    else orByEqualSupport.set(s1, [gate]);\n  }\n  {\n    const matches = orByEqualSupport.get(bitCount - 1) ?? [];\n    if (matches.length === 1 && matches[0].out !== zMax) {\n      wrong.add(matches[0].out);\n    }\n  }\n\n  // Consumer-shape checks (op-type based, independent of naming).\n  for (const gate of gates) {\n    const { in1: a, in2: b, op, out: c } = gate;\n    const aRaw = rawInputRe.test(a);\n    const bRaw = rawInputRe.test(b);\n    const isBit0Carry = (a === x00 && b === y00) || (a === y00 && b === x00);\n\n    if (op === 'XOR' && (aRaw || bRaw)) {\n      const cons = consumers.get(c) ?? [];\n      for (const consumer of cons) {\n        if (consumer.op === 'OR') wrong.add(c);\n      }\n    }\n\n    if (op === 'AND' && !isBit0Carry) {\n      const cons = consumers.get(c) ?? [];\n      for (const consumer of cons) {\n        if (consumer.op !== 'OR') wrong.add(c);\n      }\n    }\n  }\n\n  return wrong;\n}\n\n/**\n * Numeric probe for same-role swaps (e.g. two z-output wires swapped with\n * each other) that satisfy every local structural rule and are therefore\n * invisible to structuralCandidates. Only reports wires that show a clean,\n * isolated single-bit discrepancy, to avoid flagging unrelated wires caught\n * up in a carry-propagation cascade caused by some other (structural) bug.\n */\nfunction numericZSwapCandidates(gates: Gate[], shape: CircuitShape): Set<string> {\n  const { bitCount, digitLen } = shape;\n  const extra = new Set<string>();\n\n  for (let i = 0; i < bitCount; i++) {\n    const inputs: Record<string, number> = {};\n    setRegister('x', 2 ** i, bitCount, digitLen, inputs);\n    setRegister('y', 0, bitCount, digitLen, inputs);\n    let values: Record<string, number>;\n    try {\n      values = simulate(gates, inputs);\n    } catch {\n      continue;\n    }\n    const actual = registerValue(values, 'z', bitCount + 1, digitLen);\n    const expected = 2 ** i;\n    if (actual === expected) continue;\n\n    const diffBits: number[] = [];\n    for (let bit = 0; bit <= bitCount; bit++) {\n      const actualBit = Math.floor(actual / 2 ** bit) % 2;\n      const expectedBit = Math.floor(expected / 2 ** bit) % 2;\n      if (actualBit !== expectedBit) diffBits.push(bit);\n    }\n    // Only trust this as a clean two-wire swap, not a cascade.\n    if (diffBits.length === 2) {\n      for (const bit of