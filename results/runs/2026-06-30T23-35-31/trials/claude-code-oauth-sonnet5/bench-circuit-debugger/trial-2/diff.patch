+  if (k === 0) {
+    yield [];
+    return;
+  }
+  if (items.length < k) return;
+  const [first, ...rest] = items;
+  for (const combo of combinations(rest, k - 1)) {
+    yield [first, ...combo];
+  }
+  yield* combinations(rest, k);
+}
+
+interface CircuitShape {
+  bitCount: number;
+  digitLen: number;
+  zMax: string;
+}
+
+function inferShape(gates: Gate[]): CircuitShape {
+  let maxX = -1;
+  let digitLen = 2;
+  for (const gate of gates) {
+    for (const wire of [gate.in1, gate.in2, gate.out]) {
+      const idx = wireBitIndex(wire, 'x');
+      if (idx !== null) {
+        if (idx > maxX) maxX = idx;
+        digitLen = wire.length - 1;
+      }
+    }
+  }
+  const bitCount = maxX + 1;
+  return { bitCount, digitLen, zMax: 'z' + String(bitCount).padStart(digitLen, '0') };
+}
+
+/**
+ * Structural rules that hold for a correct ripple-carry adder built from
+ * half-adder/full-adder gate clusters (x_i XOR y_i -> t_i, t_i XOR c_(i-1) -> z_i,
+ * x_i AND y_i -> a_i, t_i AND c_(i-1) -> b_i, a_i OR b_i -> c_i). Flags any gate
+ * output that violates its expected role:
+ *  - a z-output (other than the top carry-out bit) must come from an XOR gate;
+ *    the top carry-out bit must come from an OR gate.
+ *  - an XOR gate combining two raw x/y inputs (a "partial sum" gate) must
+ *    never feed an OR gate directly.
+ *  - an AND gate combining two non-raw signals (a "propagate" gate) must feed
+ *    only OR gates.
+ *  - an OR gate (a "carry" gate, other than the top carry-out) must never feed
+ *    another OR gate directly — carries always flow into an XOR/AND pair next.
+ * These checks are purely op-type/consumer-shape based (not positional), so
+ * they catch swaps between wires of different structural roles — the vast
+ * majority of possible swaps — without being thrown off by carry-propagation
+ * cascades the way a value-based (numeric) check would be.
+ */
+function structuralCandidates(gates: Gate[], shape: CircuitShape): Set<string> {
+  const { zMax, digitLen } = shape;
+  const x00 = 'x' + '0'.padStart(digitLen, '0');
+  const y00 = 'y' + '0'.padStart(digitLen, '0');
+
+  const consumers = new Map<string, Gate[]>();
+  for (const gate of gates) {
+    for (const wire of [gate.in1, gate.in2]) {
+      const list = consumers.get(wire);
+      if (list) list.push(gate);
+      else consumers.set(wire, [gate]);
+    }
+  }
+
+  const zWireRe = /^z\d+$/;
+  const rawInputRe = /^[xy]\d+$/;
+  const wrong = new Set<string>();
+
+  for (const gate of gates) {
+    const { in1: a, in2: b, op, out: c } = gate;
+    const isZOut = zWireRe.test(c);
+
+    if (isZOut && c !== zMax && op !== 'XOR') wrong.add(c);
+    if (c === zMax && op !== 'OR') wrong.add(c);
+
+    const aRaw = rawInputRe.test(a);
+    const bRaw = rawInputRe.test(b);
+    const isBit0Carry = (a === x00 && b === y00) || (a === y00 && b === x00);
+
+    if (op === 'XOR') {
+      if (!aRaw && !bRaw) {
+        if (!isZOut) wrong.add(c);
+      } else {
+        const cons = consumers.get(c) ?? [];
+        for (const consumer of cons) {
+          if (consumer.op === 'OR') wrong.add(c);
+        }
+      }
+    }
+
+    if (op === 'AND' && !isBit0Carry) {
+      const cons = consumers.get(c) ?? [];
+      for (const consumer of cons) {
+        if (consumer.op !== 'OR') wrong.add(c);
+      }
+    }
+
+    if (op === 'OR' && c !== zMax) {
+      const cons = consumers.get(c) ?? [];
+      for (const consumer of cons) {
+        if (consumer.op === 'OR') wrong.add(c);
+      }
+    }
+  }
+
+  return wrong;
+}
+
+/**
+ * Numeric probe for same-role swaps (e.g. two z-output wires swapped with
+ * each other) that satisfy every local structural rule and are therefore
+ * invisible to structuralCandidates. Only reports wires that show a clean,
+ * isolated single-bit discrepancy, to avoid flagging unrelated wires caught
+ * up in a carry-propagation cascade caused by some other (structural) bug.
+ */
+function numericZSwapCandidates(gates: Gate[], shape: CircuitShape): Set<string> {
+  const { bitCount, digitLen } = shape;
+  const extra = new Set<string>();
+
+  for (let i = 0; i < bitCount; i++) {
+    const inputs: Record<string, number> = {};
+    setRegister('x', 2 ** i, bitCount, digitLen, inputs);
+    setRegister('y', 0, bitCount, digitLen, inputs);
+    let values: Record<string, number>;
+    try {
+      values = simulate(gates, inputs);
+    } catch {
+      continue;
+    }
+    const actual = registerValue(values, 'z', bitCount + 1, digitLen);
+    const expected = 2 ** i;
+    if (actual === expected) continue;
+
+    const diffBits: number[] = [];
+    for (let bit = 0; bit <= bitCount; bit++) {
+      const actualBit = Math.floor(actual / 2 ** bit) % 2;
+      const expectedBit = Math.floor(expected / 2 ** bit) % 2;
+      if (actualBit !== expectedBit) diffBits.push(bit);
+    }
+    // Only trust this as a clean two-wire swap, not a cascade.
+    if (diffBits.length === 2) {
+      for (const bit of diffBits) {
+        extra.add('z' + String(bit).padStart(digitLen, '0'));
+      }
+    }
+  }
+
+  return extra;
+}
+
+/**
+ * Finds the 8 wires involved in the 4 swapped output pairs in a broken binary adder circuit.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  const shape = inferShape(gates);
+  const structural = Array.from(structuralCandidates(gates, shape));
+
+  if (structural.length === 8) {
+    const sorted = [...structural].sort();
+    if (verifyPairingExists(gates, sorted, shape.bitCount, shape.digitLen)) {
+      return sorted;
+    }
+  }
+
+  // Try to find a self-consistent pairing among the structural candidates
+  // (one that eliminates all structural violations once applied) and repair
+  // the circuit with it. Any remaining same-role swap (invisible to the
+  // structural rules, e.g. two z-output wires swapped with each other) can
+  // then be found numerically without cascading noise from the bugs we've
+  // already identified. Pairing counts grow factorially, so bound this to
+  // keep worst-case runtime in check.
+  const MAX_PAIRING_SET_SIZE = 12;
+  let repaired = gates;
+  if (structural.length > 0 && structural.length % 2 === 0 && structural.length <= MAX_PAIRING_SET_SIZE) {
+    for (const pairing of pairings(structural)) {
+      const candidate = applyPairing(gates, pairing);
+      if (structuralCandidates(candidate, shape).size === 0) {
+        repaired = candidate;
+        break;
+      }
+    }
+  }
+
+  const numericExtra = Array.from(numericZSwapCandidates(repaired, shape)).filter(
+    (w) => !structural.includes(w),
+  );
+
+  const combined = Array.from(new Set([...structural, ...numericExtra])).sort();
+  if (combined.length === 8 && verifyPairingExists(gates, combined, shape.bitCount, shape.digitLen)) {
+    return combined;
+  }
+
+  // Fall back to searching subsets of the combined candidate pool for one
+  // that has a fully verified pairing. Both the subset search and the
+  // per-subset pairing search grow combinatorially, so cap total attempts.
+  const MAX_SUBSET_ATTEMPTS = 2000;
+  const need = 8 - structural.length;
+  const extraPool = numericExtra;
+  if (need >= 0 && need <= extraPool.length && need <= MAX_PAIRING_SET_SIZE) {
+    let attempts = 0;
+    for (const subset of combinations(extraPool, need)) {
+      if (++attempts > MAX_SUBSET_ATTEMPTS) break;
+      const candidate = [...structural, ...subset].sort();
+      if (verifyPairingExists(gates, candidate, shape.bitCount, shape.digitLen)) {
+        return candidate;
+      }
+    }
+  }
+
+  // Best effort: return whatever the structural pass found.
+  return structural.sort();
+}
+
+function verifyPairingExists(
+  gates: Gate[],
+  candidates: string[],
+  bitCount: number,
+  digitLen: number,
+): boolean {
+  const testVectors: Array<[number, number]> = [
+    [0, 0],
+    [2 ** bitCount - 1, 0],
+    [0, 2 ** bitCount - 1],
+    [2 ** bitCount - 1, 2 ** bitCount - 1],
+  ];
+  let seed = 12345;
+  const rand = (): number => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed / 0x7fffffff;
+  };
+  for (let i = 0; i < 8; i++) {
+    testVectors.push([Math.floor(rand() * 2 ** bitCount), Math.floor(rand() * 2 ** bitCount)]);
+  }
+
+  for (const pairing of pairings(candidates)) {
+    const swapped = applyPairing(gates, pairing);
+    if (checkAdderCorrect(swapped, bitCount, digitLen, testVectors)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+function applyPairing(gates: Gate[], pairing: Array<[string, string]>): Gate[] {
+  const swapTo = new Map<string, string>();
+  for (const [u, v] of pairing) {
+    swapTo.set(u, v);
+    swapTo.set(v, u);
+  }
+  return gates.map((gate) => {
+    const newOut = swapTo.get(gate.out);
+    return newOut ? { ...gate, out: newOut } : gate;
+  });
+}
+
+function checkAdderCorrect(
+  gates: Gate[],
+  bitCount: number,
+  digitLen: number,
+  testVectors: Array<[number, number]>,
+): boolean {
+  for (const [x, y] of testVectors) {
+    const inputs: Record<string, number> = {};
+    setRegister('x', x, bitCount, digitLen, inputs);
+    setRegister('y', y, bitCount, digitLen, inputs);
+    let values: Record<string, number>;
+    try {
+      values = simulate(gates, inputs);
+    } catch {
+      return false;
+    }
+    const z = registerValue(values, 'z', bitCount + 1, digitLen);
+    if (z !== x + y) return false;
+  }
+  return true;
+}
