ural, ...subset].sort();\n      if (verifyPairingExists(gates, candidate, shape.bitCount, shape.digitLen)) {\n        return candidate;\n      }\n    }\n  }\n\n  // Best effort: return whatever the structural pass found.\n  return structural.sort();\n}\n\nfunction verifyPairingExists(\n  gates: Gate[],\n  candidates: string[],\n  bitCount: number,\n  digitLen: number,\n): boolean {\n  const testVectors: Array<[number, number]> = [\n    [0, 0],\n    [2 ** bitCount - 1, 0],\n    [0, 2 ** bitCount - 1],\n    [2 ** bitCount - 1, 2 ** bitCount - 1],\n  ];\n  let seed = 12345;\n  const rand = (): number => {\n    seed = (seed * 1103515245 + 12345) & 0x7fffffff;\n    return seed / 0x7fffffff;\n  };\n  for (let i = 0; i < 8; i++) {\n    testVectors.push([Math.floor(rand() * 2 ** bitCount), Math.floor(rand() * 2 ** bitCount)]);\n  }\n\n  for (const pairing of pairings(candidates)) {\n    const swapped = applyPairing(gates, pairing);\n    if (checkAdderCorrect(swapped, bitCount, digitLen, testVectors)) {\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction applyPairing(gates: Gate[], pairing: Array<[string, string]>): Gate[] {\n  const swapTo = new Map<string, string>();\n  for (const [u, v] of pairing) {\n    swapTo.set(u, v);\n    swapTo.set(v, u);\n  }\n  return gates.map((gate) => {\n    const newOut = swapTo.get(gate.out);\n    return newOut ? { ...gate, out: newOut } : gate;\n  });\n}\n\nfunction checkAdderCorrect(\n  gates: Gate[],\n  bitCount: number,\n  digitLen: number,\n  testVectors: Array<[number, number]>,\n): boolean {\n  for (const [x, y] of testVectors) {\n    const inputs: Record<string, number> = {};\n    setRegister('x', x, bitCount, digitLen, inputs);\n    setRegister('y', y, bitCount, digitLen, inputs);\n    let values: Record<string, number>;\n    try {\n      values = simulate(gates, inputs);\n    } catch {\n      return false;\n    }\n    const z = registerValue(values, 'z', bitCount + 1, digitLen);\n    if (z !== x + y) return false;\n  }\n  return true;\n}\n","structuredPatch":[{"oldStart":377,"oldLines":9,"newStart":377,"newLines":11,"lines":["   // the circuit with it. Any remaining same-role swap (invisible to the","   // structural rules, e.g. two z-output wires swapped with each other) can","   // then be found numerically without cascading noise from the bugs we've","-  // already identified.","+  // already identified. Pairing counts grow factorially, so bound this to","+  // keep worst-case runtime in check.","+  const MAX_PAIRING_SET_SIZE = 12;","   let repaired = gates;","-  if (structural.length > 0 && structural.length % 2 === 0) {","+  if (structural.length > 0 && structural.length % 2 === 0 && structural.length <= MAX_PAIRING_SET_SIZE) {","     for (const pairing of pairings(structural)) {","       const candidate = applyPairing(gates, pairing);","       if (structuralCandidates(candidate, shape).size === 0) {"]},{"oldStart":399,"oldLines":11,"newStart":401,"newLines":15,"lines":["   }"," ","   // Fall back to searching subsets of the combined candidate pool for one","-  // that has a fully verified pairing.","+  // that has a fully verified pairing. Both the subset search and the","+  // per-subset pairing search grow combinatorially, so cap total attempts.","+  const MAX_SUBSET_ATTEMPTS = 2000;","   const need = 8 - structural.length;","   const extraPool = numericExtra;","-  if (need >= 0 && need <= extraPool.length) {","+  if (need >= 0 && need <= extraPool.length && need <= MAX_PAIRING_SET_SIZE) {","+    let attempts = 0;","     for (const subset of combinations(extraPool, need)) {","+      if (++attempts > MAX_SUBSET_ATTEMPTS) break;","       const candidate = [...structural, ...subset].sort();","       if (verifyPairingExists(gates, candidate, shape.bitCount, shape.digitLen)) {","         return candidate;"]}],"userModified":false,"replaceAll":false}}
