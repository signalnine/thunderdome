@@ -0,0 +1,80 @@
+type Direction = 'D' | 'DL' | 'DR';
+
+const COL_DELTA: Record<Direction, number> = {
+  D: 0,
+  DL: -1,
+  DR: 1,
+};
+
+interface SimulationResult {
+  visitedCells: number;
+  totalPaths: bigint;
+}
+
+function findSourceColumn(grid: string[][]): number {
+  const topRow = grid[0] ?? [];
+  const col = topRow.indexOf('S');
+  if (col === -1) {
+    throw new Error('Grid has no beam source (\'S\') on the top row');
+  }
+  return col;
+}
+
+function stateKey(col: number, dir: Direction): string {
+  return `${col}|${dir}`;
+}
+
+function simulate(grid: string[][]): SimulationResult {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  const sourceCol = findSourceColumn(grid);
+
+  const visited = new Set<string>();
+  let totalPaths = 0n;
+
+  let currentRow = new Map<string, bigint>([[stateKey(sourceCol, 'D'), 1n]]);
+
+  for (let row = 0; row < rows; row++) {
+    const nextRow = new Map<string, bigint>();
+    const colsAtRow = new Set<number>();
+
+    for (const [key, count] of currentRow) {
+      const [colStr, dir] = key.split('|');
+      const col = Number(colStr);
+      colsAtRow.add(col);
+
+      const outgoing: Array<[number, Direction]> =
+        grid[row][col] === '^'
+          ? [
+              [col - 1, 'DL'],
+              [col + 1, 'DR'],
+            ]
+          : [[col + COL_DELTA[dir as Direction], dir as Direction]];
+
+      for (const [nextCol, nextDir] of outgoing) {
+        if (row + 1 >= rows || nextCol < 0 || nextCol >= cols) {
+          totalPaths += count;
+          continue;
+        }
+        const nextKey = stateKey(nextCol, nextDir);
+        nextRow.set(nextKey, (nextRow.get(nextKey) ?? 0n) + count);
+      }
+    }
+
+    for (const col of colsAtRow) {
+      visited.add(`${row},${col}`);
+    }
+
+    currentRow = nextRow;
+  }
+
+  return { visitedCells: visited.size, totalPaths };
+}
+
+export function countBeamCells(grid: string[][]): number {
+  return simulate(grid).visitedCells;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  return simulate(grid).totalPaths;
+}
