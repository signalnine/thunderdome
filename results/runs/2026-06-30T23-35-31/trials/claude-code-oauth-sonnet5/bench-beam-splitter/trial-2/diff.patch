@@ -0,0 +1,85 @@
+type Direction = 'down' | 'down-left' | 'down-right';
+
+interface BeamState {
+  visitedCells: number;
+  totalPaths: bigint;
+}
+
+function colDelta(direction: Direction): number {
+  switch (direction) {
+    case 'down-left':
+      return -1;
+    case 'down-right':
+      return 1;
+    default:
+      return 0;
+  }
+}
+
+function findSourceCol(grid: string[][]): number {
+  const topRow = grid[0] ?? [];
+  const col = topRow.indexOf('S');
+  if (col === -1) {
+    throw new Error("Grid must contain a source 'S' on the top row");
+  }
+  return col;
+}
+
+function addToMap(map: Map<string, bigint>, col: number, direction: Direction, count: bigint): void {
+  const key = `${col}|${direction}`;
+  map.set(key, (map.get(key) ?? 0n) + count);
+}
+
+function simulate(grid: string[][]): BeamState {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  const sourceCol = findSourceCol(grid);
+
+  const visited = new Set<number>();
+  visited.add(0 * cols + sourceCol);
+
+  let currentRow = 0;
+  let currentBeams = new Map<string, bigint>();
+  currentBeams.set(`${sourceCol}|down`, 1n);
+
+  let totalPaths = 0n;
+
+  while (currentBeams.size > 0) {
+    const nextRow = currentRow + 1;
+    const nextBeams = new Map<string, bigint>();
+
+    for (const [key, count] of currentBeams) {
+      const [colStr, direction] = key.split('|') as [string, Direction];
+      const col = Number(colStr);
+      const nextCol = col + colDelta(direction);
+
+      if (nextRow >= rows || nextCol < 0 || nextCol >= cols) {
+        totalPaths += count;
+        continue;
+      }
+
+      visited.add(nextRow * cols + nextCol);
+      const cell = grid[nextRow][nextCol];
+
+      if (cell === '^') {
+        addToMap(nextBeams, nextCol, 'down-left', count);
+        addToMap(nextBeams, nextCol, 'down-right', count);
+      } else {
+        addToMap(nextBeams, nextCol, direction, count);
+      }
+    }
+
+    currentRow = nextRow;
+    currentBeams = nextBeams;
+  }
+
+  return { visitedCells: visited.size, totalPaths };
+}
+
+export function countBeamCells(grid: string[][]): number {
+  return simulate(grid).visitedCells;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  return simulate(grid).totalPaths;
+}
