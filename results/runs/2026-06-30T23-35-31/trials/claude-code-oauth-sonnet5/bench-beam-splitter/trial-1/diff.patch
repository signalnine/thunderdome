diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..b94222e
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,81 @@
+type DirCounts = [bigint, bigint, bigint];
+
+const DIR_COL_OFFSET: readonly number[] = [0, -1, 1];
+
+function findSourceCol(grid: string[][]): number {
+  const topRow = grid[0];
+  for (let c = 0; c < topRow.length; c++) {
+    if (topRow[c] === 'S') return c;
+  }
+  throw new Error('No source (S) found in top row of grid');
+}
+
+interface SimulationResult {
+  visitedCount: number;
+  totalPaths: bigint;
+}
+
+function simulate(grid: string[][]): SimulationResult {
+  const rows = grid.length;
+  const cols = grid[0].length;
+  const srcCol = findSourceCol(grid);
+
+  const visited = new Set<number>();
+  visited.add(srcCol);
+
+  let totalPaths = 0n;
+  let current = new Map<number, DirCounts>();
+  current.set(srcCol, [1n, 0n, 0n]);
+
+  const addBeam = (
+    target: Map<number, DirCounts>,
+    row: number,
+    col: number,
+    dir: number,
+    count: bigint,
+  ): void => {
+    if (count === 0n) return;
+    if (row >= rows || col < 0 || col >= cols) {
+      totalPaths += count;
+      return;
+    }
+    visited.add(row * cols + col);
+    const existing = target.get(col);
+    if (existing) {
+      existing[dir] += count;
+    } else {
+      const fresh: DirCounts = [0n, 0n, 0n];
+      fresh[dir] = count;
+      target.set(col, fresh);
+    }
+  };
+
+  for (let r = 0; r < rows && current.size > 0; r++) {
+    const next = new Map<number, DirCounts>();
+    for (const [c, counts] of current) {
+      const cell = grid[r][c];
+      if (cell === '^') {
+        const total = counts[0] + counts[1] + counts[2];
+        addBeam(next, r + 1, c - 1, 1, total);
+        addBeam(next, r + 1, c + 1, 2, total);
+      } else {
+        for (let d = 0; d < 3; d++) {
+          if (counts[d] > 0n) {
+            addBeam(next, r + 1, c + DIR_COL_OFFSET[d], d, counts[d]);
+          }
+        }
+      }
+    }
+    current = next;
+  }
+
+  return { visitedCount: visited.size, totalPaths };
+}
+
+export function countBeamCells(grid: string[][]): number {
+  return simulate(grid).visitedCount;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  return simulate(grid).totalPaths;
+}
