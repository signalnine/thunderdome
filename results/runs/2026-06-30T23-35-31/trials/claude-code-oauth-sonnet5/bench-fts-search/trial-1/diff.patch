+// Builds a safe FTS5 MATCH query from arbitrary user input.
+// Every token (and quoted phrase) is individually double-quoted so that
+// FTS5 operators/special characters in the raw input can never produce a
+// query syntax error - the worst case is a literal (and possibly
+// non-matching) phrase.
+export function buildMatchQuery(q: string): string {
+  const tokens: string[] = [];
+  const regex = /"([^"]*)"|(\S+)/g;
+  let match: RegExpExecArray | null;
+
+  while ((match = regex.exec(q)) !== null) {
+    const raw = match[1] !== undefined ? match[1] : match[2];
+    const escaped = raw.replace(/"/g, '""').trim();
+    if (escaped.length > 0) {
+      tokens.push(`"${escaped}"`);
+    }
+  }
+
+  return tokens.join(' ');
+}
+
+// Builds an FTS5 prefix-match query (e.g. "learn*") for autocomplete.
+// Strips characters that have special meaning to the FTS5 query parser
+// so the prefix query itself can never be malformed.
+export function buildPrefixQuery(q: string): string {
+  const cleaned = q.trim().replace(/["^*():-]/g, ' ').trim();
+  if (!cleaned) {
+    return '';
+  }
+  return cleaned
+    .split(/\s+/)
+    .map((word) => `${word}*`)
+    .join(' ');
+}
