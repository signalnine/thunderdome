new file mode 100644
index 0000000..7b601e7
--- /dev/null
+++ b/src/smoke.test.ts
@@ -0,0 +1,92 @@
+import { describe, it, expect } from 'vitest';
+import { DocumentStore } from './index.js';
+
+describe('smoke', () => {
+  it('crud + history', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    expect(store.get('doc1')).toEqual({ a: 1 });
+    store.update('doc1', { a: 2 });
+    expect(store.get('doc1')).toEqual({ a: 2 });
+    const history = store.getHistory('doc1');
+    expect(history.length).toBe(2);
+    expect(history[0].content).toEqual({ a: 1 });
+    expect(history[1].content).toEqual({ a: 2 });
+    expect(store.getVersion('doc1', history[0].id)).toEqual({ a: 1 });
+    store.delete('doc1');
+    expect(() => store.get('doc1')).toThrow();
+    expect(() => store.create('doc1', { a: 1 })).not.toThrow();
+  });
+
+  it('branch isolation', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 99 });
+    expect(store.get('doc1')).toEqual({ a: 99 });
+    store.switchBranch('main');
+    expect(store.get('doc1')).toEqual({ a: 1 });
+  });
+
+  it('merge without conflicts', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1, b: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 1, b: 2 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 5, b: 1 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged.doc1).toEqual({ a: 5, b: 2 });
+    expect(store.get('doc1')).toEqual({ a: 5, b: 2 });
+  });
+
+  it('merge with conflicts does not apply', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 2 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 3 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts.length).toBe(1);
+    expect(result.conflicts[0]).toMatchObject({ documentId: 'doc1', path: 'a', base: 1, ours: 3, theirs: 2 });
+    expect(store.get('doc1')).toEqual({ a: 3 });
+  });
+
+  it('nested field conflict path', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { nested: { x: 1, y: 1 } });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { nested: { x: 1, y: 2 } });
+    store.switchBranch('main');
+    store.update('doc1', { nested: { x: 1, y: 3 } });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts[0].path).toBe('nested.y');
+  });
+
+  it('independent doc merges cleanly', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.create('doc2', { x: 1 });
+    store.switchBranch('main');
+    store.create('doc3', { y: 1 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(store.get('doc2')).toEqual({ x: 1 });
+    expect(store.get('doc3')).toEqual({ y: 1 });
+  });
+});
diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..2758a22
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,284 @@
+import type { Conflict, DocumentStore as IDocumentStore, MergeResult, Version } from './types.js';
+import { deepClone, deepEqual } from './utils.js';
+import { mergeObjects } from './merge.js';
+
+interface VersionNode {
+  id: string;
+  documentId: string;
+  timestamp: number;
+  content: object;
+  parentId: string | null;
+}
+
+interface BranchDocEntry {
+  headVersionId: string;
+  deleted: boolean;
+}
+
+interface BranchState {
+  name: string;
+  docs: Map<string, BranchDocEntry>;
+}
+
+type MergeAction =
+  | { docId: string; action: 'create'; content: object }
+  | { docId: string; action: 'update'; content: object }
+  | { docId: string; action: 'delete' };
+
+export class DocumentStoreImpl implements IDocumentStore {
+  private branches = new Map<string, BranchState>();
+  private versions = new Map<string, VersionNode>();
+  private currentBranch = 'main';
+  private versionCounter = 0;
+
+  constructor() {
+    this.branches.set('main', { name: 'main', docs: new Map() });
+  }
+
+  create(id: string, content: object): void {
+    const branch = this.currentBranchState();
+    const existing = branch.docs.get(id);
+    if (existing && !existing.deleted) {
+      throw new Error(`Document "${id}" already exists`);
+    }
+    const version = this.createVersion(id, content, null);
+    branch.docs.set(id, { headVersionId: version.id, deleted: false });
+  }
+
+  get(id: string): object {
+    const branch = this.currentBranchState();
+    const entry = branch.docs.get(id);
+    if (!entry || entry.deleted) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    return deepClone(this.versions.get(entry.headVersionId)!.content);
+  }
+
+  update(id: string, content: object): void {
+    const branch = this.currentBranchState();
+    const entry = branch.docs.get(id);
+    if (!entry || entry.deleted) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    const version = this.createVersion(id, content, entry.headVersionId);
+    branch.docs.set(id, { headVersionId: version.id, deleted: false });
+  }
+
+  delete(id: string): void {
+    const branch = this.currentBranchState();
+    const entry = branch.docs.get(id);
+    if (!entry || entry.deleted) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    branch.docs.set(id, { ...entry, deleted: true });
+  }
+
+  getHistory(id: string): Version[] {
+    const branch = this.currentBranchState();
+    const entry = branch.docs.get(id);
+    if (!entry) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    return this.versionChain(entry.headVersionId)
+      .reverse()
+      .map((v) => ({ id: v.id, timestamp: v.timestamp, content: deepClone(v.content) }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const branch = this.currentBranchState();
+    const entry = branch.docs.get(id);
+    if (!entry) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    const found = this.versionChain(entry.headVersionId).find((v) => v.id === versionId);
+    if (!found) {
+      throw new Error(`Version "${versionId}" not found for document "${id}"`);
+    }
+    return deepClone(found.content);
+  }
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const source = this.requireBranch(fromBranch ?? this.currentBranch);
+    const docs = new Map<string, BranchDocEntry>();
+    for (const [docId, entry] of source.docs) {
+      docs.set(docId, { ...entry });
+    }
+    this.branches.set(name, { name, docs });
+  }
+
+  switchBranch(name: string): void {
+    this.requireBranch(name);
+    this.currentBranch = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return Array.from(this.branches.keys());
+  }
+
+  merge(sourceBranch: string): MergeResult {
+    const source = this.requireBranch(sourceBranch);
+    const current = this.currentBranchState();
+
+    const merged: Record<string, object> = {};
+    const conflicts: Conflict[] = [];
+    const actions: MergeAction[] = [];
+
+    const docIds = new Set<string>([...current.docs.keys(), ...source.docs.keys()]);
+
+    for (const docId of docIds) {
+      const oursEntry = current.docs.get(docId);
+      const theirsEntry = source.docs.get(docId);
+
+      if (oursEntry && !theirsEntry) {
+        if (!oursEntry.deleted) {
+          merged[docId] = deepClone(this.versions.get(oursEntry.headVersionId)!.content);
+        }
+        continue;
+      }
+
+      if (!oursEntry && theirsEntry) {
+        if (theirsEntry.deleted) continue;
+        const content = deepClone(this.versions.get(theirsEntry.headVersionId)!.content);
+        merged[docId] = content;
+        actions.push({ docId, action: 'create', content });
+        continue;
+      }
+
+      const ours = oursEntry!;
+      const theirs = theirsEntry!;
+      const lcaId = this.findAncestor(ours.headVersionId, theirs.headVersionId);
+      const baseContent = lcaId ? this.versions.get(lcaId)!.content : undefined;
+      const oursContent = ours.deleted ? undefined : this.versions.get(ours.headVersionId)!.content;
+      const theirsContent = theirs.deleted ? undefined : this.versions.get(theirs.headVersionId)!.content;
+
+      if (deepEqual(oursContent, theirsContent)) {
+        if (oursContent !== undefined) merged[docId] = deepClone(oursContent);
+        continue;
+      }
+
+      if (ours.deleted && !theirs.deleted) {
+        if (deepEqual(theirsContent, baseContent)) {
+          // theirs unchanged since divergence -> our deletion wins, no conflict
+          continue;
+        }
+        conflicts.push({
+          documentId: docId,
+          path: '',
+          base: deepClone(baseContent),
+          ours: undefined,
+          theirs: deepClone(theirsContent),
+        });
+        continue;
+      }
+
+      if (!ours.deleted && theirs.deleted) {
+        if (deepEqual(oursContent, baseContent)) {
+          actions.push({ docId, action: 'delete' });
+          continue;
+        }
+        conflicts.push({
+          documentId: docId,
+          path: '',
+          base: deepClone(baseContent),
+          ours: deepClone(oursContent),
+          theirs: undefined,
+        });
+        merged[docId] = deepClone(oursContent!);
+        continue;
+      }
+
+      // neither side deleted: field-level three-way merge
+      const mergedContent = mergeObjects(
+        (baseContent as Record<string, unknown>) ?? {},
+        oursContent as Record<string, unknown>,
+        theirsContent as Record<string, unknown>,
+        docId,
+        '',
+        conflicts,
+      );
+      merged[docId] = mergedContent;
+      if (!deepEqual(mergedContent, oursContent)) {
+        actions.push({ docId, action: 'update', content: mergedContent });
+      }
+    }
+
+    const applied = conflicts.length === 0;
+
+    if (applied) {
+      for (const action of actions) {
+        if (action.action === 'create') {
+          const version = this.createVersion(action.docId, action.content, null);
+          current.docs.set(action.docId, { headVersionId: version.id, deleted: false });
+        } else if (action.action === 'update') {
+          const entry = current.docs.get(action.docId)!;
+          const version = this.createVersion(action.docId, action.content, entry.headVersionId);
+          current.docs.set(action.docId, { headVersionId: version.id, deleted: false });
+        } else {
+          const entry = current.docs.get(action.docId)!;
+          current.docs.set(action.docId, { ...entry, deleted: true });
+        }
+      }
+    }
+
+    return { merged, conflicts, applied };
+  }
+
+  private currentBranchState(): BranchState {
+    return this.branches.get(this.currentBranch)!;
+  }
+
+  private requireBranch(name: string): BranchState {
+    const branch = this.branches.get(name);
+    if (!branch) {
+      throw new Error(`Branch "${name}" does not exist`);
+    }
+    return branch;
+  }
+
+  private createVersion(documentId: string, content: object, parentId: string | null): VersionNode {
+    const id = `v${++this.versionCounter}`;
+    const version: VersionNode = {
+      id,
+      documentId,
+      timestamp: Date.now(),
+      content: deepClone(content),
+      parentId,
+    };
+    this.versions.set(id, version);
+    return version;
+  }
+
+  private versionChain(headId: string): VersionNode[] {
+    const chain: VersionNode[] = [];
+    let current: string | null = headId;
+    while (current) {
+      const versionNode: VersionNode = this.versions.get(current)!;
+      chain.push(versionNode);
+      current = versionNode.parentId;
+    }
+    return chain;
+  }
+
+  private findAncestor(headA: string | undefined, headB: string | undefined): string | null {
+    if (!headA || !headB) return null;
+    const ancestorsA = new Set<string>();
+    let cur: string | null = headA;
+    while (cur) {
+      ancestorsA.add(cur);
+      cur = this.versions.get(cur)!.parentId;
+    }
+    cur = headB;
+    while (cur) {
+      if (ancestorsA.has(cur)) return cur;
+      cur = this.versions.get(cur)!.parentId;
+    }
+    return null;
+  }
+}
