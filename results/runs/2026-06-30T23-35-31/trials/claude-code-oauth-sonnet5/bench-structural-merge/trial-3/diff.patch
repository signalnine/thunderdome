!existing.deleted) {\n      throw new Error(`Document \"${id}\" already exists`);\n    }\n    const version = this.createVersion(id, content, null);\n    branch.docs.set(id, { headVersionId: version.id, deleted: false });\n  }\n\n  get(id: string): object {\n    const branch = this.currentBranchState();\n    const entry = branch.docs.get(id);\n    if (!entry || entry.deleted) {\n      throw new Error(`Document \"${id}\" not found`);\n    }\n    return deepClone(this.versions.get(entry.headVersionId)!.content);\n  }\n\n  update(id: string, content: object): void {\n    const branch = this.currentBranchState();\n    const entry = branch.docs.get(id);\n    if (!entry || entry.deleted) {\n      throw new Error(`Document \"${id}\" not found`);\n    }\n    const version = this.createVersion(id, content, entry.headVersionId);\n    branch.docs.set(id, { headVersionId: version.id, deleted: false });\n  }\n\n  delete(id: string): void {\n    const branch = this.currentBranchState();\n    const entry = branch.docs.get(id);\n    if (!entry || entry.deleted) {\n      throw new Error(`Document \"${id}\" not found`);\n    }\n    branch.docs.set(id, { ...entry, deleted: true });\n  }\n\n  getHistory(id: string): Version[] {\n    const branch = this.currentBranchState();\n    const entry = branch.docs.get(id);\n    if (!entry) {\n      throw new Error(`Document \"${id}\" not found`);\n    }\n    return this.versionChain(entry.headVersionId)\n      .reverse()\n      .map((v) => ({ id: v.id, timestamp: v.timestamp, content: deepClone(v.content) }));\n  }\n\n  getVersion(id: string, versionId: string): object {\n    const branch = this.currentBranchState();\n    const entry = branch.docs.get(id);\n    if (!entry) {\n      throw new Error(`Document \"${id}\" not found`);\n    }\n    const found = this.versionChain(entry.headVersionId).find((v) => v.id === versionId);\n    if (!found) {\n      throw new Error(`Version \"${versionId}\" not found for document \"${id}\"`);\n    }\n    return deepClone(found.content);\n  }\n\n  createBranch(name: string, fromBranch?: string): void {\n    if (this.branches.has(name)) {\n      throw new Error(`Branch \"${name}\" already exists`);\n    }\n    const source = this.requireBranch(fromBranch ?? this.currentBranch);\n    const docs = new Map<string, BranchDocEntry>();\n    for (const [docId, entry] of source.docs) {\n      docs.set(docId, { ...entry });\n    }\n    this.branches.set(name, { name, docs });\n  }\n\n  switchBranch(name: string): void {\n    this.requireBranch(name);\n    this.currentBranch = name;\n  }\n\n  getBranch(): string {\n    return this.currentBranch;\n  }\n\n  listBranches(): string[] {\n    return Array.from(this.branches.keys());\n  }\n\n  merge(sourceBranch: string): MergeResult {\n    const source = this.requireBranch(sourceBranch);\n    const current = this.currentBranchState();\n\n    const merged: Record<string, object> = {};\n    const conflicts: Conflict[] = [];\n    const actions: MergeAction[] = [];\n\n    const docIds = new Set<string>([...current.docs.keys(), ...source.docs.keys()]);\n\n    for (const docId of docIds) {\n      const oursEntry = current.docs.get(docId);\n      const theirsEntry = source.docs.get(docId);\n\n      if (oursEntry && !theirsEntry) {\n        if (!oursEntry.deleted) {\n          merged[docId] = deepClone(this.versions.get(oursEntry.headVersionId)!.content);\n        }\n        continue;\n      }\n\n      if (!oursEntry && theirsEntry) {\n        if (theirsEntry.deleted) continue;\n        const content = deepClone(this.versions.get(theirsEntry.headVersionId)!.content);\n        merged[docId] = content;\n        actions.push({ docId, action: 'create', content });\n        continue;\n      }\n\n      const ours = oursEntry!;\n      const theirs = theirsEntry!;\n      const lcaId = this.findAncestor(ours.headVersionId, theirs.headVersionId);\n      const baseContent = lcaId ? this.versions.get(lcaId)!.content : undefined;\n      const oursContent = ours.deleted ? undefined : this.versions.get(ours.headVersionId)!.content;\n      const theirsContent = theirs.deleted ? undefined : this.versions.get(theirs.headVersionId)!.content;\n\n      if (deepEqual(oursContent, theirsContent)) {\n        if (oursContent !== undefined) merged[docId] = deepClone(oursContent);\n        continue;\n      }\n\n      if (ours.deleted && !theirs.deleted) {\n        if (deepEqual(theirsContent, baseContent)) {\n          // theirs unchanged since divergence -> our deletion wins, no conflict\n          continue;\n        }\n        conflicts.push({\n          documentId: docId,\n          path: '',\n          base: deepClone(baseContent),\n          ours: undefined,\n          theirs: deepClone(theirsContent),\n        });\n        continue;\n      }\n\n      if (!ours.deleted && theirs.deleted) {\n        if (deepEqual(oursContent, baseContent)) {\n          actions.push({ docId, action: 'delete' });\n          continue;\n        }\n        conflicts.push({\n          documentId: docId,\n          path: '',\n          base: deepClone(baseContent),\n          ours: deepClone(oursContent),\n          theirs: undefined,\n        });\n        merged[docId] = deepClone(oursContent!);\n        continue;\n      }\n\n      // neither side deleted: field-level three-way merge\n      const mergedContent = mergeObjects(\n        (baseContent as Record<string, unknown>) ?? {},\n        oursContent as Record<string, unknown>,\n        theirsContent as Record<string, unknown>,\n        docId,\n        '',\n        conflicts,\n      );\n      merged[docId] = mergedContent;\n      if (!deepEqual(mergedContent, oursContent)) {\n        actions.push({ docId, action: 'update', content: mergedContent });\n      }\n    }\n\n    const applied = conflicts.length === 0;\n\n    if (applied) {\n      for (const action of actions) {\n        if (action.action === 'create') {\n          const version = this.createVersion(action.docId, action.content, null);\n    