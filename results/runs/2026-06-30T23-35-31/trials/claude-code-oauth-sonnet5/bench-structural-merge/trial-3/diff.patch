index 0000000..5d79793
--- /dev/null
+++ b/src/merge.ts
@@ -0,0 +1,66 @@
+import type { Conflict } from './types.js';
+import { deepClone, deepEqual, isPlainObject } from './utils.js';
+
+/**
+ * Recursive three-way merge over plain-object fields. Arrays and primitives
+ * are treated as atomic leaf values (never merged field-by-field).
+ */
+export function mergeObjects(
+  base: Record<string, unknown>,
+  ours: Record<string, unknown>,
+  theirs: Record<string, unknown>,
+  documentId: string,
+  pathPrefix: string,
+  conflicts: Conflict[],
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+  const keys = new Set([...Object.keys(base), ...Object.keys(ours), ...Object.keys(theirs)]);
+
+  for (const key of keys) {
+    const bVal = base[key];
+    const oVal = ours[key];
+    const tVal = theirs[key];
+    const path = pathPrefix ? `${pathPrefix}.${key}` : key;
+
+    if (deepEqual(oVal, tVal)) {
+      if (oVal !== undefined) result[key] = deepClone(oVal);
+      continue;
+    }
+
+    if (deepEqual(bVal, oVal)) {
+      // only theirs changed this field
+      if (tVal !== undefined) result[key] = deepClone(tVal);
+      continue;
+    }
+
+    if (deepEqual(bVal, tVal)) {
+      // only ours changed this field
+      if (oVal !== undefined) result[key] = deepClone(oVal);
+      continue;
+    }
+
+    // both sides changed this field, to different values
+    if (isPlainObject(oVal) && isPlainObject(tVal) && (bVal === undefined || isPlainObject(bVal))) {
+      result[key] = mergeObjects(
+        isPlainObject(bVal) ? bVal : {},
+        oVal,
+        tVal,
+        documentId,
+        path,
+        conflicts,
+      );
+    } else {
+      conflicts.push({
+        documentId,
+        path,
+        base: deepClone(bVal),
+        ours: deepClone(oVal),
+        theirs: deepClone(tVal),
+      });
+      // merged preview resolves conflicts in favor of "ours"
+      if (oVal !== undefined) result[key] = deepClone(oVal);
+    }
+  }
+
+  return result;
+}
