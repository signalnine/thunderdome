diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..a75d28d
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,228 @@
+import { deepEqual, isPlainObject, mergeValues } from './merge.js';
+import type { Conflict, MergeResult, Version } from './types.js';
+
+export type { Conflict, MergeResult, Version } from './types.js';
+
+interface VersionRecord {
+  id: string;
+  documentId: string;
+  timestamp: number;
+  parentId: string | null;
+  content: object;
+}
+
+interface DocPointer {
+  versionId: string;
+  deleted: boolean;
+}
+
+interface BranchState {
+  docs: Map<string, DocPointer>;
+}
+
+function assertDocumentContent(content: unknown): void {
+  if (!isPlainObject(content)) {
+    throw new Error('Document content must be a plain object');
+  }
+}
+
+export class DocumentStore {
+  private versions = new Map<string, VersionRecord>();
+  private branches = new Map<string, BranchState>();
+  private currentBranch = 'main';
+  private versionCounter = 0;
+
+  constructor() {
+    this.branches.set('main', { docs: new Map() });
+  }
+
+  create(id: string, content: object): void {
+    assertDocumentContent(content);
+    const branch = this.getBranchState(this.currentBranch);
+    const existing = branch.docs.get(id);
+    if (existing && !existing.deleted) {
+      throw new Error(`Document "${id}" already exists on branch "${this.currentBranch}"`);
+    }
+    const versionId = this.createVersion(id, content, existing ? existing.versionId : null);
+    branch.docs.set(id, { versionId, deleted: false });
+  }
+
+  get(id: string): object {
+    const branch = this.getBranchState(this.currentBranch);
+    const pointer = branch.docs.get(id);
+    if (!pointer || pointer.deleted) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    return structuredClone(this.versions.get(pointer.versionId)!.content);
+  }
+
+  update(id: string, content: object): void {
+    assertDocumentContent(content);
+    const branch = this.getBranchState(this.currentBranch);
+    const pointer = branch.docs.get(id);
+    if (!pointer || pointer.deleted) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    const versionId = this.createVersion(id, content, pointer.versionId);
+    branch.docs.set(id, { versionId, deleted: false });
+  }
+
+  delete(id: string): void {
+    const branch = this.getBranchState(this.currentBranch);
+    const pointer = branch.docs.get(id);
+    if (!pointer || pointer.deleted) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    branch.docs.set(id, { versionId: pointer.versionId, deleted: true });
+  }
+
+  getHistory(id: string): Version[] {
+    const branch = this.getBranchState(this.currentBranch);
+    const pointer = branch.docs.get(id);
+    if (!pointer) {
+      throw new Error(`Document "${id}" does not exist`);
+    }
+    const history: Version[] = [];
+    let cursor: string | null = pointer.versionId;
+    while (cursor) {
+      const version: VersionRecord = this.versions.get(cursor)!;
+      history.push({ id: version.id, timestamp: version.timestamp, content: structuredClone(version.content) });
+      cursor = version.parentId;
+    }
+    return history.reverse();
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const version = this.versions.get(versionId);
+    if (!version || version.documentId !== id) {
+      throw new Error(`Version "${versionId}" not found for document "${id}"`);
+    }
+    return structuredClone(version.content);
+  }
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const sourceName = fromBranch ?? this.currentBranch;
+    const source = this.branches.get(sourceName);
+    if (!source) {
+      throw new Error(`Branch "${sourceName}" does not exist`);
+    }
+    const docs = new Map<string, DocPointer>();
+    for (const [docId, pointer] of source.docs) {
+      docs.set(docId, { ...pointer });
+    }
+    this.branches.set(name, { docs });
+  }
+
+  switchBranch(name: string): void {
+    if (!this.branches.has(name)) {
+      throw new Error(`Branch "${name}" does not exist`);
+    }
+    this.currentBranch = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  merge(sourceBranch: string): MergeResult {
+    const ours = this.getBranchState(this.currentBranch);
+    const theirs = this.branches.get(sourceBranch);
+    if (!theirs) {
+      throw new Error(`Branch "${sourceBranch}" does not exist`);
+    }
+
+    const docIds = new Set([...ours.docs.keys(), ...theirs.docs.keys()]);
+    const merged: Record<string, object> = {};
+    const conflicts: Conflict[] = [];
+    const updates = new Map<string, { content: object | null; parentVersionId: string | null }>();
+
+    for (const docId of docIds) {
+      const oursPointer = ours.docs.get(docId) ?? null;
+      const theirsPointer = theirs.docs.get(docId) ?? null;
+      const oursVersionId = oursPointer?.versionId ?? null;
+      const theirsVersionId = theirsPointer?.versionId ?? null;
+
+      const baseVersionId =
+        oursVersionId && theirsVersionId ? this.findCommonAncestor(oursVersionId, theirsVersionId) : null;
+      const baseContent = baseVersionId ? this.versions.get(baseVersionId)!.content : undefined;
+      const oursContent =
+        oursPointer && !oursPointer.deleted ? this.versions.get(oursVersionId!)!.content : undefined;
+      const theirsContent =
+        theirsPointer && !theirsPointer.deleted ? this.versions.get(theirsVersionId!)!.content : undefined;
+
+      const result = mergeValues(docId, '', baseContent, oursContent, theirsContent);
+      conflicts.push(...result.conflicts);
+
+      if (isPlainObject(result.value)) {
+        merged[docId] = structuredClone(result.value) as object;
+      }
+
+      if (!deepEqual(result.value, oursContent)) {
+        updates.set(docId, {
+          content: isPlainObject(result.value) ? (result.value as object) : null,
+          parentVersionId: oursVersionId ?? theirsVersionId ?? null,
+        });
+      }
+    }
+
+    const applied = conflicts.length === 0;
+    if (applied) {
+      for (const [docId, update] of updates) {
+        if (update.content === null) {
+          const pointer = ours.docs.get(docId);
+          if (pointer) {
+            ours.docs.set(docId, { versionId: pointer.versionId, deleted: true });
+          }
+        } else {
+          const versionId = this.createVersion(docId, update.content, update.parentVersionId);
+          ours.docs.set(docId, { versionId, deleted: false });
+        }
+      }
+    }
+
+    return { merged, conflicts, applied };
+  }
+
+  private createVersion(documentId: string, content: object, parentId: string | null): string {
+    this.versionCounter += 1;
+    const versionId = `v${this.versionCounter}`;
+    this.versions.set(versionId, {
+      id: versionId,
+      documentId,
+      timestamp: Date.now(),
+      parentId,
+      content: structuredClone(content),
+    });
+    return versionId;
+  }
+
+  private getBranchState(name: string): BranchState {
+    const branch = this.branches.get(name);
+    if (!branch) {
+      throw new Error(`Branch "${name}" does not exist`);
+    }
+    return branch;
+  }
+
+  private findCommonAncestor(versionId1: string, versionId2: string): string | null {
+    const ancestors = new Set<string>();
+    let cursor: string | null = versionId1;
+    while (cursor) {
+      ancestors.add(cursor);
+      cursor = this.versions.get(cursor)!.parentId;
+    }
+    cursor = versionId2;
+    while (cursor) {
+      if (ancestors.has(cursor)) return cursor;
+      cursor = this.versions.get(cursor)!.parentId;
+    }
+    return null;
+  }
+}
diff --git a/src/merge.ts b/src/merge.ts
new file mode 100644
index 0000000..dd09e52
--- /dev/null
+++ b/src/merge.ts
@@ -0,0 +1,63 @@
+import type { Conflict } from './types.js';
+
+export function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+export function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (Number.isNaN(a as number) && Number.isNaN(b as number)) return true;
+  if (Array.isArray(a) && Array.isArray(b)) {
+    if (a.length !== b.length) return false;
+    return a.every((v, i) => deepEqual(v, b[i]));
+  }
+  if (isPlainObject(a) && isPlainObject(b)) {
+    const keys = new Set([...Object.keys(a), ...Object.keys(b)]);
+    for (const key of keys) {
+      if (!deepEqual(a[key], b[key])) return false;
+    }
+    return true;
+  }
+  return false;
+}
+
+export interface FieldMergeResult {
+  value: unknown;
+  conflicts: Conflict[];
+}
+
+/**
+ * Recursive three-way structural merge. Arrays and primitives are treated as
+ * atomic leaves; plain objects are merged field-by-field so that unrelated
+ * fields (or unrelated documents) never conflict with each other.
+ */
+export function mergeValues(
+  documentId: string,
+  path: string,
+  base: unknown,
+  ours: unknown,
+  theirs: unknown,
+): FieldMergeResult {
+  if (deepEqual(ours, theirs)) return { value: ours, conflicts: [] };
+  if (deepEqual(base, ours)) return { value: theirs, conflicts: [] };
+  if (deepEqual(base, theirs)) return { value: ours, conflicts: [] };
+
+  if (isPlainObject(ours) && isPlainObject(theirs)) {
+    const baseObj = isPlainObject(base) ? base : {};
+    const keys = new Set([...Object.keys(baseObj), ...Object.keys(ours), ...Object.keys(theirs)]);
+    const mergedObj: Record<string, unknown> = {};
+    const conflicts: Conflict[] = [];
+    for (const key of keys) {
+      const childPath = path ? `${path}.${key}` : key;
+      const result = mergeValues(documentId, childPath, baseObj[key], ours[key], theirs[key]);
+      if (result.value !== undefined) mergedObj[key] = result.value;
+      conflicts.push(...result.conflicts);
+    }
+    return { value: mergedObj, conflicts };
+  }
+
+  return {
+    value: ours,
+    conflicts: [{ documentId, path, base, ours, theirs }],
+  };
+}
