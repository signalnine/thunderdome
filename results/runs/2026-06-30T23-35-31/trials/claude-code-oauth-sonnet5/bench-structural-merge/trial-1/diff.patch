+import { describe, it, expect } from 'vitest';
+import { DocumentStore } from '../src/index.js';
+
+describe('CRUD', () => {
+  it('creates, gets, updates, deletes', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    expect(store.get('doc1')).toEqual({ a: 1 });
+    store.update('doc1', { a: 2 });
+    expect(store.get('doc1')).toEqual({ a: 2 });
+    store.delete('doc1');
+    expect(() => store.get('doc1')).toThrow();
+  });
+
+  it('throws on duplicate create', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    expect(() => store.create('doc1', { a: 2 })).toThrow();
+  });
+
+  it('throws on update/delete of missing doc', () => {
+    const store = new DocumentStore();
+    expect(() => store.update('nope', {})).toThrow();
+    expect(() => store.delete('nope')).toThrow();
+  });
+
+  it('deep clones on store/retrieve', () => {
+    const store = new DocumentStore();
+    const content = { a: { b: 1 } };
+    store.create('doc1', content);
+    content.a.b = 999;
+    expect(store.get('doc1')).toEqual({ a: { b: 1 } });
+    const got = store.get('doc1') as any;
+    got.a.b = 42;
+    expect(store.get('doc1')).toEqual({ a: { b: 1 } });
+  });
+});
+
+describe('history', () => {
+  it('tracks versions chronologically', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    store.update('doc1', { a: 2 });
+    store.update('doc1', { a: 3 });
+    const history = store.getHistory('doc1');
+    expect(history).toHaveLength(3);
+    expect(history.map((v) => v.content)).toEqual([{ a: 1 }, { a: 2 }, { a: 3 }]);
+    expect(store.getVersion('doc1', history[0].id)).toEqual({ a: 1 });
+  });
+});
+
+describe('branching', () => {
+  it('defaults to main and isolates changes', () => {
+    const store = new DocumentStore();
+    expect(store.getBranch()).toBe('main');
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 2 });
+    expect(store.get('doc1')).toEqual({ a: 2 });
+    store.switchBranch('main');
+    expect(store.get('doc1')).toEqual({ a: 1 });
+    expect(store.listBranches().sort()).toEqual(['feature', 'main']);
+  });
+
+  it('branches from a specified branch', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    store.createBranch('b1');
+    store.switchBranch('b1');
+    store.update('doc1', { a: 2 });
+    store.createBranch('b2', 'b1');
+    store.switchBranch('b2');
+    expect(store.get('doc1')).toEqual({ a: 2 });
+  });
+});
+
+describe('merge', () => {
+  it('auto-applies non-conflicting field changes', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1, b: 1, c: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 1, b: 2, c: 1 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 9, b: 1, c: 1 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged.doc1).toEqual({ a: 9, b: 2, c: 1 });
+    expect(store.get('doc1')).toEqual({ a: 9, b: 2, c: 1 });
+  });
+
+  it('detects conflicts and does not apply', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 2 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 3 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts).toEqual([
+      { documentId: 'doc1', path: 'a', base: 1, ours: 3, theirs: 2 },
+    ]);
+    expect(result.merged.doc1).toEqual({ a: 3 });
+    expect(store.get('doc1')).toEqual({ a: 3 });
+  });
+
+  it('same value change on both sides is not a conflict', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 5 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 5 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+  });
+
+  it('merges independent documents cleanly', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    store.create('doc2', { x: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc2', { x: 2 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 2 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.merged).toEqual({ doc1: { a: 2 }, doc2: { x: 2 } });
+  });
+
+  it('is a no-op fast-forward when nothing changed', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    const result = store.merge('feature');
+    expect(result).toEqual({ merged: {}, conflicts: [], applied: true });
+  });
+
+  it('handles nested object conflicts with dot paths', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: { b: { c: 1 } } });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: { b: { c: 2 } } });
+    store.switchBranch('main');
+    store.update('doc1', { a: { b: { c: 3 } } });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts[0].path).toBe('a.b.c');
+  });
+
+  it('takes a one-sided delete with no conflict', () => {
+    const store = new DocumentStore();
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.delete('doc1');
+    store.switchBranch('main');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(() => store.get('doc1')).toThrow();
+  });
+});
