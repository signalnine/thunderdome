+import type { Conflict, DocumentRecord } from './types.js';
+import { deepEqual, isPlainObject } from './utils.js';
+
+export interface FieldMergeResult {
+  merged: Record<string, unknown>;
+  conflicts: Conflict[];
+}
+
+/** Three-way structural merge of two objects against a common base, recursing into nested plain objects. */
+export function mergeObjects(
+  base: Record<string, unknown>,
+  ours: Record<string, unknown>,
+  theirs: Record<string, unknown>,
+  documentId: string,
+  path: string,
+): FieldMergeResult {
+  const conflicts: Conflict[] = [];
+  const merged: Record<string, unknown> = {};
+  const keys = new Set([...Object.keys(base), ...Object.keys(ours), ...Object.keys(theirs)]);
+
+  for (const key of keys) {
+    const baseVal = base[key];
+    const oursVal = ours[key];
+    const theirsVal = theirs[key];
+    const fullPath = path ? `${path}.${key}` : key;
+
+    const oursChanged = !deepEqual(oursVal, baseVal);
+    const theirsChanged = !deepEqual(theirsVal, baseVal);
+
+    if (!oursChanged && !theirsChanged) {
+      if (baseVal !== undefined) merged[key] = baseVal;
+      continue;
+    }
+    if (oursChanged && !theirsChanged) {
+      if (oursVal !== undefined) merged[key] = oursVal;
+      continue;
+    }
+    if (!oursChanged && theirsChanged) {
+      if (theirsVal !== undefined) merged[key] = theirsVal;
+      continue;
+    }
+
+    // Both sides changed this key.
+    if (deepEqual(oursVal, theirsVal)) {
+      if (oursVal !== undefined) merged[key] = oursVal;
+      continue;
+    }
+    if (isPlainObject(oursVal) && isPlainObject(theirsVal)) {
+      const nestedBase = isPlainObject(baseVal) ? baseVal : {};
+      const nested = mergeObjects(nestedBase, oursVal, theirsVal, documentId, fullPath);
+      merged[key] = nested.merged;
+      conflicts.push(...nested.conflicts);
+      continue;
+    }
+
+    conflicts.push({ documentId, path: fullPath, base: baseVal, ours: oursVal, theirs: theirsVal });
+    if (oursVal !== undefined) merged[key] = oursVal;
+  }
+
+  return { merged, conflicts };
+}
+
+/** Content of the latest version common to both histories (by version id), or undefined if none. */
+export function commonAncestorContent(
+  a: DocumentRecord | undefined,
+  b: DocumentRecord | undefined,
+): object | undefined {
+  if (!a || !b) return undefined;
+  let i = 0;
+  while (i < a.history.length && i < b.history.length && a.history[i].id === b.history[i].id) {
+    i++;
+  }
+  if (i === 0) return undefined;
+  return a.history[i - 1].content;
+}
+
+export interface CurrentState {
+  exists: boolean;
+  content?: object;
+}
+
+export function currentState(rec: DocumentRecord | undefined): CurrentState {
+  if (!rec || rec.deleted) return { exists: false };
+  return { exists: true, content: rec.history[rec.history.length - 1].content };
+}
