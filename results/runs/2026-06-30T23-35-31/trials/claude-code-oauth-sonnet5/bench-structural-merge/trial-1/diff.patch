@@ -0,0 +1,237 @@
+import type {
+  BranchState,
+  Conflict,
+  DocumentRecord,
+  DocumentStore as IDocumentStore,
+  MergeResult,
+  Version,
+} from './types.js';
+import { deepClone, deepEqual } from './utils.js';
+import { commonAncestorContent, currentState, mergeObjects } from './merge.js';
+
+const MAIN_BRANCH = 'main';
+
+type MergeAction =
+  | { id: string; type: 'set'; content: object }
+  | { id: string; type: 'delete' };
+
+export class DocumentStore implements IDocumentStore {
+  private branches = new Map<string, BranchState>();
+  private currentBranch = MAIN_BRANCH;
+  private versionCounter = 0;
+  private clock = Date.now();
+
+  constructor() {
+    this.branches.set(MAIN_BRANCH, { documents: new Map() });
+  }
+
+  create(id: string, content: object): void {
+    const branch = this.activeBranch();
+    const existing = branch.documents.get(id);
+    if (existing && !existing.deleted) {
+      throw new Error(`Document "${id}" already exists`);
+    }
+    const version = this.makeVersion(content);
+    if (existing) {
+      existing.history.push(version);
+      existing.deleted = false;
+    } else {
+      branch.documents.set(id, { history: [version], deleted: false });
+    }
+  }
+
+  get(id: string): object {
+    const doc = this.requireDocument(id);
+    return deepClone(this.latestContent(doc));
+  }
+
+  update(id: string, content: object): void {
+    const doc = this.requireDocument(id);
+    doc.history.push(this.makeVersion(content));
+  }
+
+  delete(id: string): void {
+    const doc = this.requireDocument(id);
+    doc.deleted = true;
+  }
+
+  getHistory(id: string): Version[] {
+    const doc = this.branch(this.currentBranch).documents.get(id);
+    if (!doc) throw new Error(`Document "${id}" not found`);
+    return doc.history.map((v) => ({ id: v.id, timestamp: v.timestamp, content: deepClone(v.content) }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const doc = this.branch(this.currentBranch).documents.get(id);
+    if (!doc) throw new Error(`Document "${id}" not found`);
+    const version = doc.history.find((v) => v.id === versionId);
+    if (!version) throw new Error(`Version "${versionId}" not found for document "${id}"`);
+    return deepClone(version.content);
+  }
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const sourceName = fromBranch ?? this.currentBranch;
+    const source = this.branch(sourceName);
+    this.branches.set(name, { documents: cloneDocuments(source.documents) });
+  }
+
+  switchBranch(name: string): void {
+    this.branch(name);
+    this.currentBranch = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return Array.from(this.branches.keys());
+  }
+
+  merge(sourceBranch: string): MergeResult {
+    const ours = this.branch(this.currentBranch);
+    const theirs = this.branch(sourceBranch);
+
+    const merged: Record<string, object> = {};
+    const conflicts: Conflict[] = [];
+    const actions: MergeAction[] = [];
+
+    const ids = new Set([...ours.documents.keys(), ...theirs.documents.keys()]);
+    for (const id of ids) {
+      this.mergeDocument(id, ours.documents.get(id), theirs.documents.get(id), merged, conflicts, actions);
+    }
+
+    const applied = conflicts.length === 0;
+    if (applied) {
+      for (const action of actions) {
+        this.applyMergeAction(ours, action);
+      }
+    }
+
+    return { merged, conflicts, applied };
+  }
+
+  private mergeDocument(
+    id: string,
+    oursRec: DocumentRecord | undefined,
+    theirsRec: DocumentRecord | undefined,
+    merged: Record<string, object>,
+    conflicts: Conflict[],
+    actions: MergeAction[],
+  ): void {
+    const oursCur = currentState(oursRec);
+    const theirsCur = currentState(theirsRec);
+    const baseContent = commonAncestorContent(oursRec, theirsRec);
+    const baseExists = baseContent !== undefined;
+
+    const oursChanged = baseExists
+      ? !oursCur.exists || !deepEqual(oursCur.content, baseContent)
+      : oursCur.exists;
+    const theirsChanged = baseExists
+      ? !theirsCur.exists || !deepEqual(theirsCur.content, baseContent)
+      : theirsCur.exists;
+
+    if (!oursChanged && !theirsChanged) return;
+
+    if (oursChanged && !theirsChanged) {
+      if (oursCur.exists) merged[id] = deepClone(oursCur.content as object);
+      return;
+    }
+
+    if (!oursChanged && theirsChanged) {
+      if (theirsCur.exists) {
+        merged[id] = deepClone(theirsCur.content as object);
+        actions.push({ id, type: 'set', content: theirsCur.content as object });
+      } else {
+        actions.push({ id, type: 'delete' });
+      }
+      return;
+    }
+
+    // Both sides changed this document.
+    if (oursCur.exists === theirsCur.exists && deepEqual(oursCur.content, theirsCur.content)) {
+      if (oursCur.exists) merged[id] = deepClone(oursCur.content as object);
+      return;
+    }
+
+    if (oursCur.exists && theirsCur.exists) {
+      const result = mergeObjects(
+        (baseExists ? baseContent : {}) as Record<string, unknown>,
+        oursCur.content as Record<string, unknown>,
+        theirsCur.content as Record<string, unknown>,
+        id,
+        '',
+      );
+      merged[id] = result.merged;
+      if (result.conflicts.length > 0) {
+        conflicts.push(...result.conflicts);
+      } else {
+        actions.push({ id, type: 'set', content: result.merged });
+      }
+      return;
+    }
+
+    // One side deleted the document while the other edited it.
+    conflicts.push({
+      documentId: id,
+      path: '',
+      base: baseContent,
+      ours: oursCur.exists ? oursCur.content : undefined,
+      theirs: theirsCur.exists ? theirsCur.content : undefined,
+    });
+    if (oursCur.exists) merged[id] = deepClone(oursCur.content as object);
+  }
+
+  private applyMergeAction(branch: BranchState, action: MergeAction): void {
+    const rec = branch.documents.get(action.id);
+    if (action.type === 'delete') {
+      if (rec) rec.deleted = true;
+      return;
+    }
+    const version = this.makeVersion(action.content);
+    if (rec) {
+      rec.history.push(version);
+      rec.deleted = false;
+    } else {
+      branch.documents.set(action.id, { history: [version], deleted: false });
+    }
+  }
+
+  private makeVersion(content: object) {
+    return { id: `v${++this.versionCounter}`, timestamp: ++this.clock, content: deepClone(content) };
+  }
+
+  private activeBranch(): BranchState {
+    return this.branch(this.currentBranch);
+  }
+
+  private branch(name: string): BranchState {
+    const branch = this.branches.get(name);
+    if (!branch) throw new Error(`Branch "${name}" not found`);
+    return branch;
+  }
+
+  private requireDocument(id: string): DocumentRecord {
+    const doc = this.activeBranch().documents.get(id);
+    if (!doc || doc.deleted) throw new Error(`Document "${id}" not found`);
+    return doc;
+  }
+
+  private latestContent(doc: DocumentRecord): object {
+    return doc.history[doc.history.length - 1].content;
+  }
+}
+
+function cloneDocuments(documents: Map<string, DocumentRecord>): Map<string, DocumentRecord> {
+  const out = new Map<string, DocumentRecord>();
+  for (const [id, rec] of documents) {
+    out.set(id, {
+      deleted: rec.deleted,
+      history: rec.history.map((v) => ({ id: v.id, timestamp: v.timestamp, content: deepClone(v.content) })),
+    });
+  }
+  return out;
+}
