epare('SELECT * FROM users WHERE id = ?').get(id) as UserRow;\n    res.status(201).json(toPublicUser(user));\n  })\n);\n\nrouter.post(\n  '/login',\n  asyncHandler(async (req: Request, res: Response) => {\n    const { email, password } = req.body as Record<string, unknown>;\n    if (typeof email !== 'string' || typeof password !== 'string') {\n      throw new ValidationError('email and password are required');\n    }\n\n    const db = getDb();\n    const user = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as\n      | UserRow\n      | undefined;\n    if (!user || !verifyPassword(password, user.password_hash)) {\n      throw new AuthError('Invalid email or password');\n    }\n\n    const token = signToken({ sub: user.id, tid: user.tenant_id });\n    res.status(200).json({ token, user: toPublicUser(user) });\n  })\n);\n\nrouter.get(\n  '/me',\n  authenticate,\n  asyncHandler<AuthenticatedRequest>(async (req, res) => {\n    const db = getDb();\n    const user = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as\n      | UserRow\n      | undefined;\n    if (!user) {\n      throw new NotFoundError('User not found');\n    }\n    res.status(200).json(toPublicUser(user));\n  })\n);\n\nrouter.patch(\n  '/:id/role',\n  authenticate,\n  asyncHandler<AuthenticatedRequest>(async (req, res) => {\n    const { role } = req.body as Record<string, unknown>;\n    if (typeof role !== 'string' || !ROLES.includes(role)) {\n      throw new ValidationError(`role must be one of ${ROLES.join(', ')}`);\n    }\n\n    const db = getDb();\n    const requester = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as\n      | UserRow\n      | undefined;\n    if (!requester || requester.role !== 'admin') {\n      throw new ForbiddenError('Only admins can change user roles');\n    }\n\n    const target = db\n      .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')\n      .get(req.params.id, req.user!.tenantId) as UserRow | undefined;\n    if (