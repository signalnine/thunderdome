+++ b/src/ingest/router.ts
@@ -0,0 +1,103 @@
+import { Router, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { asyncHandler, ValidationError } from '../errors';
+import { AuthenticatedRequest } from '../types';
+
+interface EventInput {
+  name?: unknown;
+  properties?: unknown;
+  timestamp?: unknown;
+  session_id?: unknown;
+}
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+const router = Router();
+
+function serializeEvent(row: EventRow) {
+  return {
+    ...row,
+    properties: JSON.parse(row.properties) as unknown,
+  };
+}
+
+function buildEventRow(input: EventInput, tenantId: string, userId: string): EventRow {
+  if (typeof input.name !== 'string' || input.name.length === 0) {
+    throw new ValidationError('name is required');
+  }
+  const properties = input.properties !== undefined ? input.properties : {};
+  const timestamp =
+    typeof input.timestamp === 'string' ? input.timestamp : new Date().toISOString();
+  const sessionId = typeof input.session_id === 'string' ? input.session_id : null;
+
+  return {
+    id: uuidv4(),
+    tenant_id: tenantId,
+    name: input.name,
+    properties: JSON.stringify(properties),
+    timestamp,
+    user_id: userId,
+    session_id: sessionId,
+  };
+}
+
+router.post(
+  '/',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { id, tenantId } = req.user!;
+    const row = buildEventRow(req.body as EventInput, tenantId, id);
+
+    const db = getDb();
+    db.prepare(
+      'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    ).run(row.id, row.tenant_id, row.name, row.properties, row.timestamp, row.user_id, row.session_id);
+
+    res.status(201).json(serializeEvent(row));
+  })
+);
+
+router.post(
+  '/batch',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { id, tenantId } = req.user!;
+    const { events } = req.body as { events?: unknown };
+
+    if (!Array.isArray(events) || events.length === 0) {
+      throw new ValidationError('events must be a non-empty array');
+    }
+
+    const rows = (events as EventInput[]).map((event) => buildEventRow(event, tenantId, id));
+
+    const db = getDb();
+    const insert = db.prepare(
+      'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    );
+    const insertMany = db.transaction((items: EventRow[]) => {
+      for (const item of items) {
+        insert.run(
+          item.id,
+          item.tenant_id,
+          item.name,
+          item.properties,
+          item.timestamp,
+          item.user_id,
+          item.session_id
+        );
+      }
+    });
+    insertMany(rows);
+
+    res.status(201).json({ inserted: rows.length, events: rows.map(serializeEvent) });
+  })
+);
+
+export default router;
