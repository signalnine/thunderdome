+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { hashPassword, verifyPassword } from '../auth/password';
+import { signToken } from '../auth/jwt';
+import { authenticate } from '../auth/middleware';
+import {
+  asyncHandler,
+  ValidationError,
+  ConflictError,
+  AuthError,
+  NotFoundError,
+  ForbiddenError,
+} from '../errors';
+import { AuthenticatedRequest } from '../types';
+
+interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: string;
+  created_at: string;
+}
+
+const ROLES = ['admin', 'viewer', 'editor'];
+
+const router = Router();
+
+function toPublicUser(user: UserRow) {
+  return {
+    id: user.id,
+    email: user.email,
+    tenant_id: user.tenant_id,
+    role: user.role,
+    created_at: user.created_at,
+  };
+}
+
+router.post(
+  '/',
+  asyncHandler(async (req: Request, res: Response) => {
+    const { email, password, tenant_id: tenantId } = req.body as Record<string, unknown>;
+    if (typeof email !== 'string' || typeof password !== 'string' || typeof tenantId !== 'string') {
+      throw new ValidationError('email, password, and tenant_id are required');
+    }
+
+    const db = getDb();
+    const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(email);
+    if (existing) {
+      throw new ConflictError('Email is already registered');
+    }
+
+    const id = uuidv4();
+    const passwordHash = hashPassword(password);
+    db.prepare(
+      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, email, passwordHash, tenantId, 'viewer');
+
+    const user = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow;
+    res.status(201).json(toPublicUser(user));
+  })
+);
+
+router.post(
+  '/login',
+  asyncHandler(async (req: Request, res: Response) => {
+    const { email, password } = req.body as Record<string, unknown>;
+    if (typeof email !== 'string' || typeof password !== 'string') {
+      throw new ValidationError('email and password are required');
+    }
+
+    const db = getDb();
+    const user = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as
+      | UserRow
+      | undefined;
+    if (!user || !verifyPassword(password, user.password_hash)) {
+      throw new AuthError('Invalid email or password');
+    }
+
+    const token = signToken({ sub: user.id, tid: user.tenant_id });
+    res.status(200).json({ token, user: toPublicUser(user) });
+  })
+);
+
+router.get(
+  '/me',
+  authenticate,
+  asyncHandler<AuthenticatedRequest>(async (req, res) => {
+    const db = getDb();
+    const user = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as
+      | UserRow
+      | undefined;
+    if (!user) {
+      throw new NotFoundError('User not found');
+    }
+    res.status(200).json(toPublicUser(user));
+  })
+);
+
+router.patch(
+  '/:id/role',
+  authenticate,
+  asyncHandler<AuthenticatedRequest>(async (req, res) => {
+    const { role } = req.body as Record<string, unknown>;
+    if (typeof role !== 'string' || !ROLES.includes(role)) {
+      throw new ValidationError(`role must be one of ${ROLES.join(', ')}`);
+    }
+
+    const db = getDb();
+    const requester = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as
+      | UserRow
+      | undefined;
+    if (!requester || requester.role !== 'admin') {
+      throw new ForbiddenError('Only admins can change user roles');
+    }
+
+    const target = db
+      .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, req.user!.tenantId) as UserRow | undefined;
+    if (!target) {
+      throw new NotFoundError('User not found');
+    }
+
+    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);
+    const updated = db.prepare('SELECT * FROM users WHERE id = ?').get(target.id) as UserRow;
+    res.status(200).json(toPublicUser(updated));
+  })
+);
+
+export default router;
